///| RFC 8216 + LL-HLS Master and Media Playlist parser and strict spec validator.

val struct PendingStreamInf {
  bandwidth : Int64
  average_bandwidth : Option[Int64]
  codecs : Option[String]
  resolution : Option[Resolution]
  frame_rate_mhz : Option[Int64]
  hdcp_level : Option[HdcpLevel]
  audio : Option[String]
  video : Option[String]
  subtitles : Option[String]
  closed_captions : Option[ClosedCaptionsRef]
  score_micros : Option[Int64]
  pathway_id : Option[String]
}

fn validate_limits(limits : HlsLimits) -> Result[Unit, HlsError] {
  if limits.max_input_bytes < 0 ||
  limits.max_lines < 0 ||
  limits.max_segments < 0 ||
  limits.max_variants < 0 ||
  limits.max_attributes < 0 ||
  limits.max_line_bytes < 0 ||
  limits.max_custom_tags < 0 {
    return Err(HlsError::LimitExceeded("negative HlsLimits field"))
  }
  Ok(())
}

fn parse_hdcp_val(v : String) -> HdcpLevel {
  if v == "NONE" {
    HdcpLevel::None
  } else if v == "TYPE-0" {
    HdcpLevel::Type0
  } else if v == "TYPE-1" {
    HdcpLevel::Type1
  } else {
    HdcpLevel::Other(v)
  }
}

fn parse_start_attrs(attrs : Array[RawAttr]) -> Result[StartTag, HlsError] {
  let mut to_us : Option[Int64] = None
  let mut precise = false
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "TIME-OFFSET" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("TIME-OFFSET must not be quoted"))
      }
      match parse_signed_us(a.value, 0, a.value.length()) {
        Ok(v) => to_us = Some(v)
        Err(e) => return Err(e)
      }
    } else if a.key == "PRECISE" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("PRECISE must not be quoted"))
      }
      match parse_yes_no(a.value, "PRECISE") {
        Ok(b) => precise = b
        Err(e) => return Err(e)
      }
    }
    k = k + 1
  }
  match to_us {
    Some(v) => Ok(StartTag::{ time_offset_us: v, precise: precise })
    None => Err(HlsError::MissingRequiredAttribute("TIME-OFFSET"))
  }
}

fn parse_define_attrs(
  attrs : Array[RawAttr],
  defines : Array[DefineTag],
) -> Result[DefineTag, HlsError] {
  let mut d_name : Option[String] = None
  let mut d_val : Option[String] = None
  let mut d_imp : Option[String] = None
  let mut d_qp : Option[String] = None
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "NAME" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("DEFINE NAME must be quoted"))
      }
      d_name = Some(a.value)
    } else if a.key == "VALUE" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("DEFINE VALUE must be quoted"))
      }
      d_val = Some(a.value)
    } else if a.key == "IMPORT" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("DEFINE IMPORT must be quoted"))
      }
      d_imp = Some(a.value)
    } else if a.key == "QUERYPARAM" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("DEFINE QUERYPARAM must be quoted"))
      }
      d_qp = Some(a.value)
    }
    k = k + 1
  }
  let entry = match (d_name, d_val, d_imp, d_qp) {
    (Some(nm), Some(vl), None, None) =>
    DefineTag::{ name: nm, kind: DefineKind::Value(vl) }
    (None, None, Some(im), None) =>
    DefineTag::{ name: im, kind: DefineKind::Import }
    (None, None, None, Some(qp)) =>
    DefineTag::{ name: qp, kind: DefineKind::QueryParam }
    _ =>
    return Err(HlsError::InvalidVariable("invalid #EXT-X-DEFINE attribute combination"))
  }
  if entry.name.length() == 0 {
    return Err(HlsError::InvalidVariable("empty variable name"))
  }
  let mut vn = 0
  while vn < entry.name.length() {
    if !is_var_name_char(entry.name.code_unit_at(vn)) {
      return Err(HlsError::InvalidVariable("invalid character in DEFINE name"))
    }
    vn = vn + 1
  }
  let mut ex = 0
  while ex < defines.length() {
    if defines[ex].name == entry.name {
      return Err(HlsError::InvalidVariable("duplicate #EXT-X-DEFINE: " + entry.name))
    }
    ex = ex + 1
  }
  Ok(entry)
}

fn parse_stream_inf_attrs(
  attrs : Array[RawAttr],
  defines : Array[DefineTag],
  max_line_bytes : Int,
) -> Result[PendingStreamInf, HlsError] {
  let mut bw : Option[Int64] = None
  let mut avg_bw : Option[Int64] = None
  let mut codecs : Option[String] = None
  let mut res : Option[Resolution] = None
  let mut fps : Option[Int64] = None
  let mut hdcp : Option[HdcpLevel] = None
  let mut audio : Option[String] = None
  let mut video : Option[String] = None
  let mut subs : Option[String] = None
  let mut cc : Option[ClosedCaptionsRef] = None
  let mut score : Option[Int64] = None
  let mut pathway : Option[String] = None

  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "BANDWIDTH" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("BANDWIDTH must not be quoted"))
      }
      let v = match parse_uint64_slice(a.value, 0, a.value.length()) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      if v <= 0L {
        return Err(HlsError::InvalidNumber("BANDWIDTH must be positive"))
      }
      bw = Some(v)
    } else if a.key == "AVERAGE-BANDWIDTH" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("AVERAGE-BANDWIDTH must not be quoted"))
      }
      let v = match parse_uint64_slice(a.value, 0, a.value.length()) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      if v <= 0L {
        return Err(HlsError::InvalidNumber("AVERAGE-BANDWIDTH must be positive"))
      }
      avg_bw = Some(v)
    } else if a.key == "CODECS" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("CODECS must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => codecs = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "RESOLUTION" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("RESOLUTION must not be quoted"))
      }
      match parse_resolution_str(a.value) {
        Ok(r) => res = Some(r)
        Err(e) => return Err(e)
      }
    } else if a.key == "FRAME-RATE" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("FRAME-RATE must not be quoted"))
      }
      let v = match parse_mhz(a.value, 0, a.value.length()) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      if v <= 0L {
        return Err(HlsError::InvalidNumber("FRAME-RATE must be positive"))
      }
      fps = Some(v)
    } else if a.key == "HDCP-LEVEL" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("HDCP-LEVEL must not be quoted"))
      }
      hdcp = Some(parse_hdcp_val(a.value))
    } else if a.key == "AUDIO" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("AUDIO must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => audio = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "VIDEO" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("VIDEO must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => video = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "SUBTITLES" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("SUBTITLES must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => subs = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "CLOSED-CAPTIONS" {
      if !a.quoted && a.value == "NONE" {
        cc = Some(ClosedCaptionsRef::None)
      } else if a.quoted {
        match substitute_vars(a.value, defines, max_line_bytes) {
          Ok(x) => cc = Some(ClosedCaptionsRef::GroupId(x))
          Err(e) => return Err(e)
        }
      } else {
        return Err(HlsError::InvalidAttribute("CLOSED-CAPTIONS must be NONE or quoted group-id"))
      }
    } else if a.key == "SCORE" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("SCORE must not be quoted"))
      }
      match parse_us(a.value, 0, a.value.length()) {
        Ok(x) => score = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "PATHWAY-ID" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("PATHWAY-ID must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => pathway = Some(x)
        Err(e) => return Err(e)
      }
    }
    k = k + 1
  }

  let bandwidth = match bw {
    Some(v) => v
    None => return Err(HlsError::MissingRequiredAttribute("BANDWIDTH"))
  }
  Ok(PendingStreamInf::{
    bandwidth: bandwidth,
    average_bandwidth: avg_bw,
    codecs: codecs,
    resolution: res,
    frame_rate_mhz: fps,
    hdcp_level: hdcp,
    audio: audio,
    video: video,
    subtitles: subs,
    closed_captions: cc,
    score_micros: score,
    pathway_id: pathway,
  })
}

fn parse_iframe_attrs(
  attrs : Array[RawAttr],
  defines : Array[DefineTag],
  max_line_bytes : Int,
) -> Result[IFrameStream, HlsError] {
  let mut bw : Option[Int64] = None
  let mut avg_bw : Option[Int64] = None
  let mut uri : Option[String] = None
  let mut codecs : Option[String] = None
  let mut res : Option[Resolution] = None
  let mut hdcp : Option[HdcpLevel] = None
  let mut video : Option[String] = None
  let mut score : Option[Int64] = None
  let mut pathway : Option[String] = None
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "BANDWIDTH" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("BANDWIDTH must not be quoted"))
      }
      let v = match parse_uint64_slice(a.value, 0, a.value.length()) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      if v <= 0L {
        return Err(HlsError::InvalidNumber("BANDWIDTH must be positive"))
      }
      bw = Some(v)
    } else if a.key == "AVERAGE-BANDWIDTH" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("AVERAGE-BANDWIDTH must not be quoted"))
      }
      match parse_uint64_slice(a.value, 0, a.value.length()) {
        Ok(x) => avg_bw = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "URI" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("I-FRAME URI must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => uri = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "CODECS" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("CODECS must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => codecs = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "RESOLUTION" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("RESOLUTION must not be quoted"))
      }
      match parse_resolution_str(a.value) {
        Ok(r) => res = Some(r)
        Err(e) => return Err(e)
      }
    } else if a.key == "HDCP-LEVEL" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("HDCP-LEVEL must not be quoted"))
      }
      hdcp = Some(parse_hdcp_val(a.value))
    } else if a.key == "VIDEO" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("VIDEO must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => video = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "SCORE" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("SCORE must not be quoted"))
      }
      match parse_us(a.value, 0, a.value.length()) {
        Ok(x) => score = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "PATHWAY-ID" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("PATHWAY-ID must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => pathway = Some(x)
        Err(e) => return Err(e)
      }
    }
    k = k + 1
  }
  let bandwidth = match bw {
    Some(v) => v
    None => return Err(HlsError::MissingRequiredAttribute("BANDWIDTH"))
  }
  let u = match uri {
    Some(x) => {
      if x.length() == 0 {
        return Err(HlsError::MissingRequiredAttribute("URI"))
      }
      x
    }
    None => return Err(HlsError::MissingRequiredAttribute("URI"))
  }
  Ok(IFrameStream::{
    uri: u,
    bandwidth: bandwidth,
    average_bandwidth: avg_bw,
    codecs: codecs,
    resolution: res,
    hdcp_level: hdcp,
    video: video,
    score_micros: score,
    pathway_id: pathway,
  })
}

fn parse_media_attrs(
  attrs : Array[RawAttr],
  defines : Array[DefineTag],
  max_line_bytes : Int,
) -> Result[MediaRendition, HlsError] {
  let mut mtype : Option[MediaType] = None
  let mut group_id : Option[String] = None
  let mut name : Option[String] = None
  let mut uri : Option[String] = None
  let mut lang : Option[String] = None
  let mut assoc_lang : Option[String] = None
  let mut is_def = false
  let mut has_autoselect = false
  let mut autoselect = false
  let mut forced = false
  let mut instream_id : Option[String] = None
  let mut chars : Option[String] = None
  let mut channels : Option[String] = None
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "TYPE" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("MEDIA TYPE must not be quoted"))
      }
      if a.value == "AUDIO" {
        mtype = Some(MediaType::Audio)
      } else if a.value == "VIDEO" {
        mtype = Some(MediaType::Video)
      } else if a.value == "SUBTITLES" {
        mtype = Some(MediaType::Subtitles)
      } else if a.value == "CLOSED-CAPTIONS" {
        mtype = Some(MediaType::ClosedCaptions)
      } else {
        return Err(HlsError::InvalidAttribute("unknown MEDIA TYPE: " + a.value))
      }
    } else if a.key == "GROUP-ID" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("GROUP-ID must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => group_id = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "NAME" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("NAME must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => name = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "URI" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("MEDIA URI must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => uri = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "LANGUAGE" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("LANGUAGE must be quoted"))
      }
      lang = Some(a.value)
    } else if a.key == "ASSOC-LANGUAGE" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("ASSOC-LANGUAGE must be quoted"))
      }
      assoc_lang = Some(a.value)
    } else if a.key == "DEFAULT" {
      match parse_yes_no(a.value, "DEFAULT") {
        Ok(b) => is_def = b
        Err(e) => return Err(e)
      }
    } else if a.key == "AUTOSELECT" {
      match parse_yes_no(a.value, "AUTOSELECT") {
        Ok(b) => {
          has_autoselect = true
          autoselect = b
        }
        Err(e) => return Err(e)
      }
    } else if a.key == "FORCED" {
      match parse_yes_no(a.value, "FORCED") {
        Ok(b) => forced = b
        Err(e) => return Err(e)
      }
    } else if a.key == "INSTREAM-ID" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("INSTREAM-ID must be quoted"))
      }
      instream_id = Some(a.value)
    } else if a.key == "CHARACTERISTICS" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("CHARACTERISTICS must be quoted"))
      }
      chars = Some(a.value)
    } else if a.key == "CHANNELS" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("CHANNELS must be quoted"))
      }
      channels = Some(a.value)
    }
    k = k + 1
  }
  let mt = match mtype {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("TYPE"))
  }
  let gid = match group_id {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("GROUP-ID"))
  }
  let nm = match name {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("NAME"))
  }
  if is_def && has_autoselect && !autoselect {
    return Err(HlsError::InvalidAttribute("DEFAULT=YES forbids AUTOSELECT=NO"))
  }
  match mt {
    MediaType::ClosedCaptions => {
      match uri {
        Some(_) => return Err(HlsError::InvalidAttribute("CLOSED-CAPTIONS must not have URI"))
        None => ()
      }
      match instream_id {
        Some(_) => ()
        None => return Err(HlsError::MissingRequiredAttribute("INSTREAM-ID"))
      }
    }
    _ => ()
  }
  Ok(MediaRendition::{
    media_type: mt,
    group_id: gid,
    name: nm,
    uri: uri,
    language: lang,
    assoc_language: assoc_lang,
    is_default: is_def,
    autoselect: autoselect,
    forced: forced,
    instream_id: instream_id,
    characteristics: chars,
    channels: channels,
  })
}

fn parse_session_data_attrs(
  attrs : Array[RawAttr],
  defines : Array[DefineTag],
  max_line_bytes : Int,
) -> Result[SessionData, HlsError] {
  let mut data_id : Option[String] = None
  let mut sdata_val : Option[String] = None
  let mut uri : Option[String] = None
  let mut lang : Option[String] = None
  let mut fmt : Option[String] = None
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "DATA-ID" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("DATA-ID must be quoted"))
      }
      data_id = Some(a.value)
    } else if a.key == "VALUE" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("SESSION-DATA VALUE must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => sdata_val = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "URI" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("SESSION-DATA URI must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => uri = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "LANGUAGE" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("LANGUAGE must be quoted"))
      }
      lang = Some(a.value)
    } else if a.key == "FORMAT" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("FORMAT must not be quoted"))
      }
      fmt = Some(a.value)
    }
    k = k + 1
  }
  let did = match data_id {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("DATA-ID"))
  }
  match (sdata_val, uri) {
    (Some(_), Some(_)) =>
    return Err(HlsError::InvalidAttribute("SESSION-DATA cannot have both VALUE and URI"))
    (None, None) =>
    return Err(HlsError::MissingRequiredAttribute("VALUE or URI"))
    _ => ()
  }
  Ok(SessionData::{
    data_id: did,
    value: sdata_val,
    uri: uri,
    language: lang,
    format: fmt,
  })
}

fn parse_map_attrs(
  attrs : Array[RawAttr],
  defines : Array[DefineTag],
  max_line_bytes : Int,
) -> Result[MediaMap, HlsError] {
  let mut uri : Option[String] = None
  let mut br : Option[ByteRange] = None
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "URI" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("MAP URI must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => uri = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "BYTERANGE" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("MAP BYTERANGE must be quoted"))
      }
      match parse_byterange_str(a.value) {
        Ok(x) => br = Some(x)
        Err(e) => return Err(e)
      }
    }
    k = k + 1
  }
  let u = match uri {
    Some(x) => {
      if x.length() == 0 {
        return Err(HlsError::MissingRequiredAttribute("URI"))
      }
      x
    }
    None => return Err(HlsError::MissingRequiredAttribute("URI"))
  }
  Ok(MediaMap::{ uri: u, byterange: br })
}

fn parse_daterange_attrs(attrs : Array[RawAttr]) -> Result[DateRange, HlsError] {
  let mut id : Option[String] = None
  let mut class_name : Option[String] = None
  let mut start_date : Option[String] = None
  let mut end_date : Option[String] = None
  let mut dur_us : Option[Int64] = None
  let mut planned_us : Option[Int64] = None
  let mut end_on_next = false
  let mut scte_cmd : Option[String] = None
  let mut scte_out : Option[String] = None
  let mut scte_in : Option[String] = None
  let client_attrs : Array[AttrPair] = []
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "ID" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("DATERANGE ID must be quoted"))
      }
      id = Some(a.value)
    } else if a.key == "CLASS" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("DATERANGE CLASS must be quoted"))
      }
      class_name = Some(a.value)
    } else if a.key == "START-DATE" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("START-DATE must be quoted"))
      }
      match validate_iso8601(a.value) {
        Ok(_) => start_date = Some(a.value)
        Err(e) => return Err(e)
      }
    } else if a.key == "END-DATE" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("END-DATE must be quoted"))
      }
      match validate_iso8601(a.value) {
        Ok(_) => end_date = Some(a.value)
        Err(e) => return Err(e)
      }
    } else if a.key == "DURATION" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("DURATION must not be quoted"))
      }
      match parse_us(a.value, 0, a.value.length()) {
        Ok(v) => dur_us = Some(v)
        Err(e) => return Err(e)
      }
    } else if a.key == "PLANNED-DURATION" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("PLANNED-DURATION must not be quoted"))
      }
      match parse_us(a.value, 0, a.value.length()) {
        Ok(v) => planned_us = Some(v)
        Err(e) => return Err(e)
      }
    } else if a.key == "END-ON-NEXT" {
      match parse_yes_no(a.value, "END-ON-NEXT") {
        Ok(b) => end_on_next = b
        Err(e) => return Err(e)
      }
    } else if a.key == "SCTE35-CMD" {
      match validate_hex_sequence(a.value, "SCTE35-CMD") {
        Ok(_) => scte_cmd = Some(a.value)
        Err(e) => return Err(e)
      }
    } else if a.key == "SCTE35-OUT" {
      match validate_hex_sequence(a.value, "SCTE35-OUT") {
        Ok(_) => scte_out = Some(a.value)
        Err(e) => return Err(e)
      }
    } else if a.key == "SCTE35-IN" {
      match validate_hex_sequence(a.value, "SCTE35-IN") {
        Ok(_) => scte_in = Some(a.value)
        Err(e) => return Err(e)
      }
    } else if a.key.length() >= 2 &&
    a.key.code_unit_at(0) == 88 &&
    a.key.code_unit_at(1) == 45 {
      client_attrs.push(AttrPair::{
        key: a.key,
        value: a.value,
        quoted: a.quoted,
      })
    }
    k = k + 1
  }
  let dr_id = match id {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("ID"))
  }
  let dr_sd = match start_date {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("START-DATE"))
  }
  if end_on_next {
    match class_name {
      Some(_) => ()
      None =>
      return Err(HlsError::MissingRequiredAttribute("CLASS required with END-ON-NEXT=YES"))
    }
  }
  Ok(DateRange::{
    id: dr_id,
    class_name: class_name,
    start_date: dr_sd,
    end_date: end_date,
    duration_us: dur_us,
    planned_duration_us: planned_us,
    end_on_next: end_on_next,
    scte35_cmd: scte_cmd,
    scte35_out: scte_out,
    scte35_in: scte_in,
    client_attributes: client_attrs,
  })
}

fn parse_server_control_attrs(
  attrs : Array[RawAttr],
) -> Result[ServerControl, HlsError] {
  let mut csu : Option[Int64] = None
  let mut csd = false
  let mut hb : Option[Int64] = None
  let mut phb : Option[Int64] = None
  let mut cbr = false
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "CAN-SKIP-UNTIL" {
      match parse_us(a.value, 0, a.value.length()) {
        Ok(v) => csu = Some(v)
        Err(e) => return Err(e)
      }
    } else if a.key == "CAN-SKIP-DATERANGES" {
      match parse_yes_no(a.value, "CAN-SKIP-DATERANGES") {
        Ok(b) => csd = b
        Err(e) => return Err(e)
      }
    } else if a.key == "HOLD-BACK" {
      match parse_us(a.value, 0, a.value.length()) {
        Ok(v) => hb = Some(v)
        Err(e) => return Err(e)
      }
    } else if a.key == "PART-HOLD-BACK" {
      match parse_us(a.value, 0, a.value.length()) {
        Ok(v) => phb = Some(v)
        Err(e) => return Err(e)
      }
    } else if a.key == "CAN-BLOCK-RELOAD" {
      match parse_yes_no(a.value, "CAN-BLOCK-RELOAD") {
        Ok(b) => cbr = b
        Err(e) => return Err(e)
      }
    }
    k = k + 1
  }
  Ok(ServerControl::{
    can_skip_until_us: csu,
    can_skip_dateranges: csd,
    hold_back_us: hb,
    part_hold_back_us: phb,
    can_block_reload: cbr,
  })
}

fn parse_part_attrs(
  attrs : Array[RawAttr],
  defines : Array[DefineTag],
  max_line_bytes : Int,
) -> Result[PartialSegment, HlsError] {
  let mut uri : Option[String] = None
  let mut dur_us : Option[Int64] = None
  let mut indep = false
  let mut br : Option[ByteRange] = None
  let mut gap = false
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "URI" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("PART URI must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => uri = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "DURATION" {
      match parse_us(a.value, 0, a.value.length()) {
        Ok(v) => dur_us = Some(v)
        Err(e) => return Err(e)
      }
    } else if a.key == "INDEPENDENT" {
      match parse_yes_no(a.value, "INDEPENDENT") {
        Ok(b) => indep = b
        Err(e) => return Err(e)
      }
    } else if a.key == "BYTERANGE" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("PART BYTERANGE must be quoted"))
      }
      match parse_byterange_str(a.value) {
        Ok(x) => br = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "GAP" {
      match parse_yes_no(a.value, "GAP") {
        Ok(b) => gap = b
        Err(e) => return Err(e)
      }
    }
    k = k + 1
  }
  let u = match uri {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("URI"))
  }
  let d = match dur_us {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("DURATION"))
  }
  Ok(PartialSegment::{
    uri: u,
    duration_us: d,
    independent: indep,
    byterange: br,
    gap: gap,
  })
}

fn parse_preload_hint_attrs(
  attrs : Array[RawAttr],
  defines : Array[DefineTag],
  max_line_bytes : Int,
) -> Result[PreloadHint, HlsError] {
  let mut htype : Option[PreloadHintType] = None
  let mut uri : Option[String] = None
  let mut bs : Option[Int64] = None
  let mut bl : Option[Int64] = None
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "TYPE" {
      if a.value == "PART" {
        htype = Some(PreloadHintType::Part)
      } else if a.value == "MAP" {
        htype = Some(PreloadHintType::Map)
      } else {
        return Err(HlsError::InvalidAttribute("PRELOAD-HINT TYPE must be PART or MAP"))
      }
    } else if a.key == "URI" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("PRELOAD-HINT URI must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => uri = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "BYTERANGE-START" {
      match parse_uint64_slice(a.value, 0, a.value.length()) {
        Ok(v) => bs = Some(v)
        Err(e) => return Err(e)
      }
    } else if a.key == "BYTERANGE-LENGTH" {
      match parse_uint64_slice(a.value, 0, a.value.length()) {
        Ok(v) => bl = Some(v)
        Err(e) => return Err(e)
      }
    }
    k = k + 1
  }
  let ht = match htype {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("TYPE"))
  }
  let u = match uri {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("URI"))
  }
  Ok(PreloadHint::{
    hint_type: ht,
    uri: u,
    byterange_start: bs,
    byterange_length: bl,
  })
}

fn parse_rendition_report_attrs(
  attrs : Array[RawAttr],
  defines : Array[DefineTag],
  max_line_bytes : Int,
) -> Result[RenditionReport, HlsError] {
  let mut uri : Option[String] = None
  let mut last_msn : Option[Int64] = None
  let mut last_part : Option[Int64] = None
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "URI" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("RENDITION-REPORT URI must be quoted"))
      }
      match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => uri = Some(x)
        Err(e) => return Err(e)
      }
    } else if a.key == "LAST-MSN" {
      match parse_uint64_slice(a.value, 0, a.value.length()) {
        Ok(v) => last_msn = Some(v)
        Err(e) => return Err(e)
      }
    } else if a.key == "LAST-PART" {
      match parse_uint64_slice(a.value, 0, a.value.length()) {
        Ok(v) => last_part = Some(v)
        Err(e) => return Err(e)
      }
    }
    k = k + 1
  }
  let u = match uri {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("URI"))
  }
  Ok(RenditionReport::{
    uri: u,
    last_msn: last_msn,
    last_part: last_part,
  })
}

fn parse_skip_attrs(attrs : Array[RawAttr]) -> Result[SkipTag, HlsError] {
  let mut skipped : Option[Int64] = None
  let mut removed : Option[String] = None
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "SKIPPED-SEGMENTS" {
      match parse_uint64_slice(a.value, 0, a.value.length()) {
        Ok(v) => skipped = Some(v)
        Err(e) => return Err(e)
      }
    } else if a.key == "RECENTLY-REMOVED-DATERANGES" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("RECENTLY-REMOVED-DATERANGES must be quoted"))
      }
      removed = Some(a.value)
    }
    k = k + 1
  }
  let sk = match skipped {
    Some(x) => x
    None => return Err(HlsError::MissingRequiredAttribute("SKIPPED-SEGMENTS"))
  }
  Ok(SkipTag::{
    skipped_segments: sk,
    recently_removed_dateranges: removed,
  })
}

fn parse_part_inf_attrs(attrs : Array[RawAttr]) -> Result[PartInf, HlsError] {
  let mut pt : Option[Int64] = None
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if a.key == "PART-TARGET" {
      let v = match parse_us(a.value, 0, a.value.length()) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      if v <= 0L {
        return Err(HlsError::InvalidNumber("PART-TARGET must be positive"))
      }
      pt = Some(v)
    }
    k = k + 1
  }
  match pt {
    Some(v) => Ok(PartInf::{ part_target_us: v })
    None => Err(HlsError::MissingRequiredAttribute("PART-TARGET"))
  }
}

struct ParserState {
  mut is_master : Bool
  mut is_media : Bool
  mut version : Option[Int]
  mut independent_segments : Bool
  mut start_tag : Option[StartTag]
  defines : Array[DefineTag]
  custom_tags : Array[CustomTag]
  variants : Array[VariantStream]
  iframe_streams : Array[IFrameStream]
  media_renditions : Array[MediaRendition]
  session_data : Array[SessionData]
  session_keys : Array[EncryptionKey]
  mut pending_stream_inf : Option[PendingStreamInf]
  mut target_duration : Option[Int64]
  mut media_sequence : Option[Int64]
  mut discontinuity_sequence : Option[Int64]
  mut playlist_type : Option[PlaylistType]
  mut end_list : Bool
  mut i_frames_only : Bool
  mut server_control : Option[ServerControl]
  mut part_inf : Option[PartInf]
  mut skip_tag : Option[SkipTag]
  segments : Array[MediaSegment]
  preload_hints : Array[PreloadHint]
  rendition_reports : Array[RenditionReport]
  dateranges : Array[DateRange]
  mut pending_extinf_us : Option[Int64]
  mut pending_extinf_title : Option[String]
  mut pending_byterange : Option[ByteRange]
  mut pending_discontinuity : Bool
  mut pending_gap : Bool
  mut pending_pdt : Option[String]
  mut pending_key : Option[EncryptionKey]
  mut pending_map : Option[MediaMap]
  mut pending_parts : Array[PartialSegment]
  mut prev_seg_uri : Option[String]
  mut prev_seg_br_end : Option[Int64]
}

fn new_parser_state() -> ParserState {
  ParserState::{
    is_master: false,
    is_media: false,
    version: None,
    independent_segments: false,
    start_tag: None,
    defines: [],
    custom_tags: [],
    variants: [],
    iframe_streams: [],
    media_renditions: [],
    session_data: [],
    session_keys: [],
    pending_stream_inf: None,
    target_duration: None,
    media_sequence: None,
    discontinuity_sequence: None,
    playlist_type: None,
    end_list: false,
    i_frames_only: false,
    server_control: None,
    part_inf: None,
    skip_tag: None,
    segments: [],
    preload_hints: [],
    rendition_reports: [],
    dateranges: [],
    pending_extinf_us: None,
    pending_extinf_title: None,
    pending_byterange: None,
    pending_discontinuity: false,
    pending_gap: false,
    pending_pdt: None,
    pending_key: None,
    pending_map: None,
    pending_parts: [],
    prev_seg_uri: None,
    prev_seg_br_end: None,
  }
}

fn handle_tag_line(
  st : ParserState,
  input : String,
  line_start : Int,
  line_end : Int,
  limits : HlsLimits,
) -> Result[Unit, HlsError] {
  let colon = find_byte_in(input, line_start, line_end, 58)
  let tag_end = if colon >= 0 { colon } else { line_end }
  let val_start = if colon >= 0 { colon + 1 } else { line_end }

  if slice_eq(input, line_start, tag_end, "#EXT-X-VERSION") {
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-VERSION requires value"))
    }
    match st.version {
      Some(_) => return Err(HlsError::InvalidTag("duplicate #EXT-X-VERSION"))
      None => ()
    }
    let v = match parse_uint64_slice(input, val_start, line_end) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    if v < 1L || v > 2147483647L {
      return Err(HlsError::InvalidNumber("invalid #EXT-X-VERSION"))
    }
    st.version = Some(v.to_int())
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-INDEPENDENT-SEGMENTS") {
    st.independent_segments = true
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-START") {
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-START requires attributes"))
    }
    match st.start_tag {
      Some(_) => return Err(HlsError::InvalidTag("duplicate #EXT-X-START"))
      None => ()
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_start_attrs(attrs) {
      Ok(s) => st.start_tag = Some(s)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-DEFINE") {
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-DEFINE requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_define_attrs(attrs, st.defines) {
      Ok(d) => st.defines.push(d)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  // Master-only tags
  if slice_eq(input, line_start, tag_end, "#EXT-X-STREAM-INF") {
    st.is_master = true
    if st.is_media {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-STREAM-INF in Media Playlist"))
    }
    match st.pending_stream_inf {
      Some(_) => return Err(HlsError::InvalidSyntax("dangling #EXT-X-STREAM-INF without URI"))
      None => ()
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-STREAM-INF requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_stream_inf_attrs(attrs, st.defines, limits.max_line_bytes) {
      Ok(si) => st.pending_stream_inf = Some(si)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-I-FRAME-STREAM-INF") {
    st.is_master = true
    if st.is_media {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-I-FRAME-STREAM-INF in Media Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-I-FRAME-STREAM-INF requires attributes"))
    }
    if st.iframe_streams.length() >= limits.max_variants {
      return Err(HlsError::LimitExceeded("max_variants exceeded"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_iframe_attrs(attrs, st.defines, limits.max_line_bytes) {
      Ok(ifr) => st.iframe_streams.push(ifr)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-MEDIA") {
    st.is_master = true
    if st.is_media {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-MEDIA in Media Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-MEDIA requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_media_attrs(attrs, st.defines, limits.max_line_bytes) {
      Ok(mr) => st.media_renditions.push(mr)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-SESSION-DATA") {
    st.is_master = true
    if st.is_media {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-SESSION-DATA in Media Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-SESSION-DATA requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_session_data_attrs(attrs, st.defines, limits.max_line_bytes) {
      Ok(sd) => st.session_data.push(sd)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-SESSION-KEY") {
    st.is_master = true
    if st.is_media {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-SESSION-KEY in Media Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-SESSION-KEY requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_key_attrs(attrs, st.defines, limits.max_line_bytes, true) {
      Ok(key) => st.session_keys.push(key)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  // Media-only tags
  if slice_eq(input, line_start, tag_end, "#EXT-X-TARGETDURATION") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-TARGETDURATION in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-TARGETDURATION requires value"))
    }
    match st.target_duration {
      Some(_) => return Err(HlsError::InvalidTag("duplicate #EXT-X-TARGETDURATION"))
      None => ()
    }
    let td = match parse_uint64_slice(input, val_start, line_end) {
      Ok(x) => x
      Err(e) => return Err(e)
    }
    if td <= 0L {
      return Err(HlsError::InvalidNumber("TARGETDURATION must be positive"))
    }
    st.target_duration = Some(td)
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-MEDIA-SEQUENCE") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-MEDIA-SEQUENCE in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-MEDIA-SEQUENCE requires value"))
    }
    match st.media_sequence {
      Some(_) => return Err(HlsError::InvalidTag("duplicate #EXT-X-MEDIA-SEQUENCE"))
      None => ()
    }
    match parse_uint64_slice(input, val_start, line_end) {
      Ok(x) => st.media_sequence = Some(x)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-DISCONTINUITY-SEQUENCE") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-DISCONTINUITY-SEQUENCE in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-DISCONTINUITY-SEQUENCE requires value"))
    }
    match st.discontinuity_sequence {
      Some(_) => return Err(HlsError::InvalidTag("duplicate #EXT-X-DISCONTINUITY-SEQUENCE"))
      None => ()
    }
    match parse_uint64_slice(input, val_start, line_end) {
      Ok(x) => st.discontinuity_sequence = Some(x)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-PLAYLIST-TYPE") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-PLAYLIST-TYPE in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-PLAYLIST-TYPE requires value"))
    }
    match st.playlist_type {
      Some(_) => return Err(HlsError::InvalidTag("duplicate #EXT-X-PLAYLIST-TYPE"))
      None => ()
    }
    if slice_eq(input, val_start, line_end, "EVENT") {
      st.playlist_type = Some(PlaylistType::Event)
    } else if slice_eq(input, val_start, line_end, "VOD") {
      st.playlist_type = Some(PlaylistType::Vod)
    } else {
      return Err(HlsError::InvalidTag("PLAYLIST-TYPE must be EVENT or VOD"))
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-ENDLIST") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-ENDLIST in Master Playlist"))
    }
    st.end_list = true
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-I-FRAMES-ONLY") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-I-FRAMES-ONLY in Master Playlist"))
    }
    st.i_frames_only = true
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXTINF") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXTINF in Master Playlist"))
    }
    match st.pending_extinf_us {
      Some(_) => return Err(HlsError::InvalidSyntax("dangling #EXTINF without URI"))
      None => ()
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXTINF requires duration"))
    }
    let comma = find_byte_in(input, val_start, line_end, 44)
    if comma < 0 {
      return Err(HlsError::InvalidTag("#EXTINF missing required comma"))
    }
    let dur_us = match parse_us(input, val_start, comma) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    st.pending_extinf_us = Some(dur_us)
    if comma + 1 < line_end {
      st.pending_extinf_title = Some(input.slice(comma + 1, line_end))
    } else {
      st.pending_extinf_title = None
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-BYTERANGE") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-BYTERANGE in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidByteRange("#EXT-X-BYTERANGE requires value"))
    }
    match parse_byterange_str(input.slice(val_start, line_end)) {
      Ok(br) => st.pending_byterange = Some(br)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-DISCONTINUITY") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-DISCONTINUITY in Master Playlist"))
    }
    st.pending_discontinuity = true
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-GAP") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-GAP in Master Playlist"))
    }
    st.pending_gap = true
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-PROGRAM-DATE-TIME") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-PROGRAM-DATE-TIME in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidDateTime("#EXT-X-PROGRAM-DATE-TIME requires value"))
    }
    let pdt = input.slice(val_start, line_end)
    match validate_iso8601(pdt) {
      Ok(_) => st.pending_pdt = Some(pdt)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-KEY") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-KEY in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-KEY requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_key_attrs(attrs, st.defines, limits.max_line_bytes, false) {
      Ok(key) => st.pending_key = Some(key)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-MAP") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-MAP in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-MAP requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_map_attrs(attrs, st.defines, limits.max_line_bytes) {
      Ok(mp) => st.pending_map = Some(mp)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-DATERANGE") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-DATERANGE in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-DATERANGE requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_daterange_attrs(attrs) {
      Ok(dr) => st.dateranges.push(dr)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  // LL-HLS tags
  if slice_eq(input, line_start, tag_end, "#EXT-X-SERVER-CONTROL") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-SERVER-CONTROL in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-SERVER-CONTROL requires attributes"))
    }
    match st.server_control {
      Some(_) => return Err(HlsError::InvalidTag("duplicate #EXT-X-SERVER-CONTROL"))
      None => ()
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_server_control_attrs(attrs) {
      Ok(sc) => st.server_control = Some(sc)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-PART-INF") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-PART-INF in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-PART-INF requires attributes"))
    }
    match st.part_inf {
      Some(_) => return Err(HlsError::InvalidTag("duplicate #EXT-X-PART-INF"))
      None => ()
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_part_inf_attrs(attrs) {
      Ok(pi) => st.part_inf = Some(pi)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-PART") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-PART in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-PART requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_part_attrs(attrs, st.defines, limits.max_line_bytes) {
      Ok(p) => st.pending_parts.push(p)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-PRELOAD-HINT") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-PRELOAD-HINT in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-PRELOAD-HINT requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_preload_hint_attrs(attrs, st.defines, limits.max_line_bytes) {
      Ok(ph) => st.preload_hints.push(ph)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-RENDITION-REPORT") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-RENDITION-REPORT in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-RENDITION-REPORT requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_rendition_report_attrs(attrs, st.defines, limits.max_line_bytes) {
      Ok(rr) => st.rendition_reports.push(rr)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  if slice_eq(input, line_start, tag_end, "#EXT-X-SKIP") {
    st.is_media = true
    if st.is_master {
      return Err(HlsError::MixedPlaylistTags("#EXT-X-SKIP in Master Playlist"))
    }
    if colon < 0 {
      return Err(HlsError::InvalidTag("#EXT-X-SKIP requires attributes"))
    }
    let attrs = match parse_attr_list(input, val_start, line_end, limits.max_attributes) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match parse_skip_attrs(attrs) {
      Ok(sk) => st.skip_tag = Some(sk)
      Err(e) => return Err(e)
    }
    return Ok(())
  }

  // Unknown #EXT-* custom tag
  if st.custom_tags.length() >= limits.max_custom_tags {
    return Err(HlsError::LimitExceeded("max_custom_tags exceeded"))
  }
  let cname = input.slice(line_start, tag_end)
  let cval = if colon >= 0 {
    Some(input.slice(val_start, line_end))
  } else {
    None
  }
  st.custom_tags.push(CustomTag::{ name: cname, value: cval })
  Ok(())
}

fn handle_uri_line(
  st : ParserState,
  raw_uri : String,
  limits : HlsLimits,
) -> Result[Unit, HlsError] {
  let uri = match substitute_vars(raw_uri, st.defines, limits.max_line_bytes) {
    Ok(u) => u
    Err(e) => return Err(e)
  }

  match st.pending_stream_inf {
    Some(si) => {
      if st.variants.length() >= limits.max_variants {
        return Err(HlsError::LimitExceeded("max_variants exceeded"))
      }
      st.variants.push(VariantStream::{
        uri: uri,
        bandwidth: si.bandwidth,
        average_bandwidth: si.average_bandwidth,
        codecs: si.codecs,
        resolution: si.resolution,
        frame_rate_mhz: si.frame_rate_mhz,
        hdcp_level: si.hdcp_level,
        audio: si.audio,
        video: si.video,
        subtitles: si.subtitles,
        closed_captions: si.closed_captions,
        score_micros: si.score_micros,
        pathway_id: si.pathway_id,
      })
      st.pending_stream_inf = None
      return Ok(())
    }
    None => ()
  }

  match st.pending_extinf_us {
    Some(dur_us) => {
      if st.segments.length() >= limits.max_segments {
        return Err(HlsError::LimitExceeded("max_segments exceeded"))
      }
      let resolved_br : Option[ByteRange] = match st.pending_byterange {
        None => {
          st.prev_seg_uri = Some(uri)
          st.prev_seg_br_end = None
          None
        }
        Some(br) => {
          let eff_off = match br.offset {
            Some(o) => o
            None => {
              match (st.prev_seg_uri, st.prev_seg_br_end) {
                (Some(pu), Some(pend)) => {
                  if pu != uri {
                    return Err(HlsError::InvalidByteRange("implicit BYTERANGE offset requires same URI as previous segment"))
                  }
                  pend
                }
                _ =>
                return Err(HlsError::InvalidByteRange("implicit BYTERANGE offset requires preceding byterange segment"))
              }
            }
          }
          if eff_off > 9223372036854775807L - br.length {
            return Err(HlsError::InvalidByteRange("BYTERANGE offset + length overflow"))
          }
          st.prev_seg_uri = Some(uri)
          st.prev_seg_br_end = Some(eff_off + br.length)
          Some(ByteRange::{ length: br.length, offset: Some(eff_off) })
        }
      }

      st.segments.push(MediaSegment::{
        uri: uri,
        duration_us: dur_us,
        title: st.pending_extinf_title,
        byterange: resolved_br,
        discontinuity: st.pending_discontinuity,
        gap: st.pending_gap,
        program_date_time: st.pending_pdt,
        key: st.pending_key,
        map: st.pending_map,
        parts: st.pending_parts,
      })
      st.pending_extinf_us = None
      st.pending_extinf_title = None
      st.pending_byterange = None
      st.pending_discontinuity = false
      st.pending_gap = false
      st.pending_pdt = None
      st.pending_key = None
      st.pending_map = None
      st.pending_parts = []
      Ok(())
    }
    None =>
    Err(HlsError::InvalidSyntax("unexpected URI without preceding #EXTINF or #EXT-X-STREAM-INF"))
  }
}

///| Parse an HLS Master or Media playlist with default `HlsLimits`.
pub fn parse_playlist(input : String) -> Result[Playlist, HlsError] {
  parse_playlist_with_limits(input, HlsLimits::default())
}

///| Parse an HLS Master or Media playlist with explicit `HlsLimits`.
pub fn parse_playlist_with_limits(
  input : String,
  limits : HlsLimits,
) -> Result[Playlist, HlsError] {
  match validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = input.length()
  if n > limits.max_input_bytes {
    return Err(HlsError::LimitExceeded("max_input_bytes exceeded"))
  }

  let mut pos = 0
  if n >= 3 &&
  input.code_unit_at(0) == 239 &&
  input.code_unit_at(1) == 187 &&
  input.code_unit_at(2) == 191 {
    pos = 3
  }
  if pos >= n {
    return Err(HlsError::MissingHeader("empty playlist"))
  }

  let st = new_parser_state()
  let mut line_count = 0

  while pos < n {
    line_count = line_count + 1
    if line_count > limits.max_lines {
      return Err(HlsError::LimitExceeded("max_lines exceeded"))
    }

    let line_start = pos
    let mut nl = pos
    while nl < n && input.code_unit_at(nl) != 10 {
      nl = nl + 1
    }
    let mut line_end = nl
    if line_end > line_start && input.code_unit_at(line_end - 1) == 13 {
      line_end = line_end - 1
    }
    pos = if nl < n { nl + 1 } else { n }

    let line_len = line_end - line_start
    if line_len > limits.max_line_bytes {
      return Err(HlsError::LimitExceeded("max_line_bytes exceeded"))
    }

    let mut scan = line_start
    while scan < line_end {
      let ch = input.code_unit_at(scan)
      if ch == 13 || ch == 0 {
        return Err(HlsError::InvalidSyntax("bare CR or NUL inside line"))
      }
      scan = scan + 1
    }

    if line_count == 1 {
      if !slice_eq(input, line_start, line_end, "#EXTM3U") {
        return Err(HlsError::MissingHeader("playlist must start with #EXTM3U"))
      }
      continue
    }

    if line_len == 0 {
      continue
    }

    if input.code_unit_at(line_start) == 35 {
      if !slice_starts_with(input, line_start, line_end, "#EXT") {
        continue
      }
      match handle_tag_line(st, input, line_start, line_end, limits) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      let raw_uri = input.slice(line_start, line_end)
      match handle_uri_line(st, raw_uri, limits) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
  }

  match st.pending_stream_inf {
    Some(_) => return Err(HlsError::InvalidSyntax("dangling #EXT-X-STREAM-INF at EOF"))
    None => ()
  }
  match st.pending_extinf_us {
    Some(_) => return Err(HlsError::InvalidSyntax("dangling #EXTINF at EOF"))
    None => ()
  }

  if st.is_master && st.is_media {
    return Err(HlsError::MixedPlaylistTags("mixed Master and Media tags"))
  }
  if st.is_master {
    return Ok(Playlist::Master(MasterPlaylist::{
      version: st.version,
      independent_segments: st.independent_segments,
      start: st.start_tag,
      defines: st.defines,
      variants: st.variants,
      iframe_streams: st.iframe_streams,
      media: st.media_renditions,
      session_data: st.session_data,
      session_keys: st.session_keys,
      custom_tags: st.custom_tags,
    }))
  }
  if st.is_media {
    let td = match st.target_duration {
      Some(v) => v
      None => return Err(HlsError::MissingRequiredTag("#EXT-X-TARGETDURATION"))
    }
    return Ok(Playlist::Media(MediaPlaylist::{
      version: st.version,
      target_duration: td,
      media_sequence: match st.media_sequence {
        Some(v) => v
        None => 0L
      },
      discontinuity_sequence: match st.discontinuity_sequence {
        Some(v) => v
        None => 0L
      },
      playlist_type: st.playlist_type,
      end_list: st.end_list,
      i_frames_only: st.i_frames_only,
      independent_segments: st.independent_segments,
      start: st.start_tag,
      defines: st.defines,
      server_control: st.server_control,
      part_inf: st.part_inf,
      skip: st.skip_tag,
      segments: st.segments,
      trailing_parts: st.pending_parts,
      preload_hints: st.preload_hints,
      rendition_reports: st.rendition_reports,
      dateranges: st.dateranges,
      custom_tags: st.custom_tags,
    }))
  }
  Err(HlsError::MissingRequiredTag("playlist contains neither Master nor Media tags"))
}
