///| Core data types, errors, and DoS limits for RFC 8216 + LL-HLS (`packages/hls`).

///| Structured error type for HLS playlist parsing, validation, and formatting.
pub enum HlsError {
  MissingHeader(String)
  InvalidSyntax(String)
  InvalidTag(String)
  InvalidAttribute(String)
  InvalidNumber(String)
  InvalidDateTime(String)
  InvalidByteRange(String)
  MixedPlaylistTags(String)
  MissingRequiredTag(String)
  MissingRequiredAttribute(String)
  InvalidVariable(String)
  LimitExceeded(String)
}

///| Format an `HlsError` as a deterministic human-readable string.
pub fn hls_error_to_string(e : HlsError) -> String {
  match e {
    HlsError::MissingHeader(m) => "MissingHeader: " + m
    HlsError::InvalidSyntax(m) => "InvalidSyntax: " + m
    HlsError::InvalidTag(m) => "InvalidTag: " + m
    HlsError::InvalidAttribute(m) => "InvalidAttribute: " + m
    HlsError::InvalidNumber(m) => "InvalidNumber: " + m
    HlsError::InvalidDateTime(m) => "InvalidDateTime: " + m
    HlsError::InvalidByteRange(m) => "InvalidByteRange: " + m
    HlsError::MixedPlaylistTags(m) => "MixedPlaylistTags: " + m
    HlsError::MissingRequiredTag(m) => "MissingRequiredTag: " + m
    HlsError::MissingRequiredAttribute(m) => "MissingRequiredAttribute: " + m
    HlsError::InvalidVariable(m) => "InvalidVariable: " + m
    HlsError::LimitExceeded(m) => "LimitExceeded: " + m
  }
}

///| Explicit resource and DoS limits for HLS playlist parsing.
///| Any negative field is rejected immediately with `HlsError::LimitExceeded`.
///| A value of `0` strictly permits zero items of that category.
pub val struct HlsLimits {
  max_input_bytes : Int
  max_lines : Int
  max_segments : Int
  max_variants : Int
  max_attributes : Int
  max_line_bytes : Int
  max_custom_tags : Int
  max_expanded_bytes : Int
  max_parts : Int
  max_defines : Int
  max_dateranges : Int
  max_preload_hints : Int
  max_rendition_reports : Int
  max_media : Int
}

///| Default `HlsLimits` suitable for production HLS players and CDN proxies.
pub fn HlsLimits::default() -> HlsLimits {
  HlsLimits::{
    max_input_bytes: 16777216,
    max_lines: 200000,
    max_segments: 100000,
    max_variants: 4096,
    max_attributes: 256,
    max_line_bytes: 65536,
    max_custom_tags: 4096,
    max_expanded_bytes: 16777216,
    max_parts: 65536,
    max_defines: 16384,
    max_dateranges: 16384,
    max_preload_hints: 4096,
    max_rendition_reports: 4096,
    max_media: 4096,
  }
}

///| Video resolution `WIDTHxHEIGHT`.
pub val struct Resolution {
  width : Int64
  height : Int64
}

///| Byte range `<length>[@<offset>]` (RFC 8216 §4.3.2.2).
///| For Media Segments where `@<offset>` was omitted, `offset` is resolved
///| to `Some(prev_offset + prev_length)` per RFC 8216 §4.3.2.2.
pub val struct ByteRange {
  length : Int64
  offset : Option[Int64]
}

///| `#EXT-X-START` preferred playback start point.
pub val struct StartTag {
  time_offset_us : Int64
  precise : Bool
}

///| Kind of `#EXT-X-DEFINE` variable declaration (RFC 8216bis §4.4.3.8).
pub enum DefineKind {
  Value(String)
  Import
  QueryParam
}

///| `#EXT-X-DEFINE` variable entry.
pub val struct DefineTag {
  name : String
  kind : DefineKind
}

///| Key-value attribute pair (used for `X-*` client attributes on `#EXT-X-DATERANGE`).
pub val struct AttrPair {
  key : String
  value : String
  quoted : Bool
}

///| Preserved unknown `#EXT-*` tag.
pub val struct CustomTag {
  name : String
  value : Option[String]
}

///| `HDCP-LEVEL` enumerated value on `#EXT-X-STREAM-INF` / `#EXT-X-I-FRAME-STREAM-INF`.
pub enum HdcpLevel {
  None
  Type0
  Type1
  Other(String)
}

///| `CLOSED-CAPTIONS` attribute value (`NONE` or quoted group id).
pub enum ClosedCaptionsRef {
  None
  GroupId(String)
}

///| Encryption method for `#EXT-X-KEY` / `#EXT-X-SESSION-KEY`.
pub enum KeyMethod {
  None
  Aes128
  SampleAes
  SampleAesCtr
}

///| `#EXT-X-KEY` or `#EXT-X-SESSION-KEY` encryption metadata.
pub val struct EncryptionKey {
  method : KeyMethod
  uri : Option[String]
  iv : Option[String]
  keyformat : Option[String]
  keyformat_versions : Option[String]
}

///| `#EXT-X-MAP` media initialization section.
pub val struct MediaMap {
  uri : String
  byterange : Option[ByteRange]
}

///| `TYPE` attribute of `#EXT-X-MEDIA`.
pub enum MediaType {
  Audio
  Video
  Subtitles
  ClosedCaptions
}

///| `#EXT-X-MEDIA` alternative rendition declaration.
pub val struct MediaRendition {
  media_type : MediaType
  group_id : String
  name : String
  uri : Option[String]
  language : Option[String]
  assoc_language : Option[String]
  is_default : Bool
  autoselect : Bool
  forced : Bool
  instream_id : Option[String]
  characteristics : Option[String]
  channels : Option[String]
}

///| `#EXT-X-STREAM-INF` variant stream plus its associated URI.
pub val struct VariantStream {
  uri : String
  bandwidth : Int64
  average_bandwidth : Option[Int64]
  codecs : Option[String]
  resolution : Option[Resolution]
  frame_rate_mhz : Option[Int64]
  hdcp_level : Option[HdcpLevel]
  audio : Option[String]
  video : Option[String]
  subtitles : Option[String]
  closed_captions : Option[ClosedCaptionsRef]
  score_micros : Option[Int64]
  pathway_id : Option[String]
}

///| `#EXT-X-I-FRAME-STREAM-INF` I-frame variant stream (self-contained with `URI` attribute).
pub val struct IFrameStream {
  uri : String
  bandwidth : Int64
  average_bandwidth : Option[Int64]
  codecs : Option[String]
  resolution : Option[Resolution]
  hdcp_level : Option[HdcpLevel]
  video : Option[String]
  score_micros : Option[Int64]
  pathway_id : Option[String]
}

///| `#EXT-X-SESSION-DATA` arbitrary session metadata.
pub val struct SessionData {
  data_id : String
  value : Option[String]
  uri : Option[String]
  language : Option[String]
  format : Option[String]
}

///| Parsed RFC 8216 Master (Multivariant) Playlist.
pub struct MasterPlaylist {
  version : Option[Int]
  independent_segments : Bool
  start : Option[StartTag]
  defines : Array[DefineTag]
  variants : Array[VariantStream]
  iframe_streams : Array[IFrameStream]
  media : Array[MediaRendition]
  session_data : Array[SessionData]
  session_keys : Array[EncryptionKey]
  custom_tags : Array[CustomTag]
}

///| `#EXT-X-PLAYLIST-TYPE` value (`EVENT` or `VOD`).
pub enum PlaylistType {
  Event
  Vod
}

///| LL-HLS `#EXT-X-SERVER-CONTROL` server delivery directives.
pub val struct ServerControl {
  can_skip_until_us : Option[Int64]
  can_skip_dateranges : Bool
  hold_back_us : Option[Int64]
  part_hold_back_us : Option[Int64]
  can_block_reload : Bool
}

///| LL-HLS `#EXT-X-PART-INF` partial segment target duration.
pub val struct PartInf {
  part_target_us : Int64
}

///| LL-HLS `#EXT-X-PART` partial segment.
pub val struct PartialSegment {
  uri : String
  duration_us : Int64
  independent : Bool
  byterange : Option[ByteRange]
  gap : Bool
}

///| LL-HLS `#EXT-X-PRELOAD-HINT` type (`PART` or `MAP`).
pub enum PreloadHintType {
  Part
  Map
}

///| LL-HLS `#EXT-X-PRELOAD-HINT` resource preload hint.
pub val struct PreloadHint {
  hint_type : PreloadHintType
  uri : String
  byterange_start : Option[Int64]
  byterange_length : Option[Int64]
}

///| LL-HLS `#EXT-X-RENDITION-REPORT` sibling rendition status.
pub val struct RenditionReport {
  uri : String
  last_msn : Option[Int64]
  last_part : Option[Int64]
}

///| LL-HLS `#EXT-X-SKIP` delta playlist skip summary.
pub val struct SkipTag {
  skipped_segments : Int64
  recently_removed_dateranges : Option[String]
}

///| `#EXT-X-DATERANGE` timed metadata range.
pub struct DateRange {
  id : String
  class_name : Option[String]
  start_date : String
  end_date : Option[String]
  duration_us : Option[Int64]
  planned_duration_us : Option[Int64]
  end_on_next : Bool
  scte35_cmd : Option[String]
  scte35_out : Option[String]
  scte35_in : Option[String]
  client_attributes : Array[AttrPair]
}

///| A single Media Segment inside a Media Playlist.
pub struct MediaSegment {
  uri : String
  duration_us : Int64
  title : Option[String]
  byterange : Option[ByteRange]
  discontinuity : Bool
  gap : Bool
  program_date_time : Option[String]
  key : Option[EncryptionKey]
  keys : Array[EncryptionKey]
  map : Option[MediaMap]
  key_before_map : Bool
  parts : Array[PartialSegment]
  custom_tags : Array[CustomTag]
}

///| Parsed RFC 8216 + LL-HLS Media Playlist.
pub struct MediaPlaylist {
  version : Option[Int]
  target_duration : Int64
  media_sequence : Int64
  discontinuity_sequence : Int64
  playlist_type : Option[PlaylistType]
  end_list : Bool
  i_frames_only : Bool
  independent_segments : Bool
  start : Option[StartTag]
  defines : Array[DefineTag]
  server_control : Option[ServerControl]
  part_inf : Option[PartInf]
  skip : Option[SkipTag]
  segments : Array[MediaSegment]
  trailing_parts : Array[PartialSegment]
  preload_hints : Array[PreloadHint]
  rendition_reports : Array[RenditionReport]
  dateranges : Array[DateRange]
  custom_tags : Array[CustomTag]
}

///| Top-level parsed HLS playlist (auto-classified as Master or Media).
pub enum Playlist {
  Master(MasterPlaylist)
  Media(MediaPlaylist)
}

///| Resolved Media Segment with computed sequence numbers, cumulative timeline, and inherited Key/Map.
pub val struct ResolvedSegment {
  media_sequence : Int64
  discontinuity_sequence : Int64
  start_us : Int64
  end_us : Int64
  duration_us : Int64
  uri : String
  byterange : Option[ByteRange]
  key : Option[EncryptionKey]
  map : Option[MediaMap]
  discontinuity : Bool
  gap : Bool
  program_date_time : Option[String]
}
