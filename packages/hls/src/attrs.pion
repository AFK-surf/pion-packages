///| Zero-allocation O(N) RFC 8216 attribute list cursor, variable substitution, and typed attribute decoders.

struct AttrCursor {
  mut pos : Int
  mut end : Int
  mut count : Int
  mut max_attrs : Int
  mut key_start : Int
  mut key_end : Int
  mut val_start : Int
  mut val_end : Int
  mut quoted : Bool
  unk_starts : Array[Int]
  unk_ends : Array[Int]
  mut unk_map : Option[Map[String, Bool]]
}

fn new_attr_cursor() -> AttrCursor {
  AttrCursor::{
    pos: 0,
    end: 0,
    count: 0,
    max_attrs: 0,
    key_start: 0,
    key_end: 0,
    val_start: 0,
    val_end: 0,
    quoted: false,
    unk_starts: [],
    unk_ends: [],
    unk_map: None,
  }
}

fn attr_cursor_reset(
  cur : AttrCursor,
  start : Int,
  end : Int,
  max_attrs : Int,
) -> Unit {
  cur.pos = start
  cur.end = end
  cur.count = 0
  cur.max_attrs = max_attrs
  while cur.unk_starts.length() > 0 {
    let _ = cur.unk_starts.pop()
  }
  while cur.unk_ends.length() > 0 {
    let _ = cur.unk_ends.pop()
  }
  cur.unk_map = None
}

fn is_attr_name_char(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 45
}

fn is_var_name_char(b : Int) -> Bool {
  (b >= 65 && b <= 90) ||
  (b >= 97 && b <= 122) ||
  (b >= 48 && b <= 57) ||
  b == 45 ||
  b == 95
}

///| Advance the cursor to the next attribute in `s[pos..end]` with zero heap allocations.
///| Returns `1` if an attribute was read, `0` at end of list, `-1` on error (recorded in `st.err`).
fn attr_next(cur : AttrCursor, s : String, st : ParserState) -> Int {
  let mut i = cur.pos
  let end = cur.end
  if i >= end {
    return 0
  }
  if cur.count >= cur.max_attrs {
    let _ = set_err(st, HlsError::LimitExceeded("max_attributes exceeded"))
    return -1
  }

  let key_start = i
  while i < end && is_attr_name_char(s.code_unit_at(i)) {
    i = i + 1
  }
  if i == key_start {
    let _ = set_err(st, HlsError::InvalidAttribute("empty or invalid attribute name"))
    return -1
  }
  if i >= end || s.code_unit_at(i) != 61 {
    let _ = set_err(st, HlsError::InvalidAttribute("expected '=' after attribute name"))
    return -1
  }
  let key_end = i

  i = i + 1 // skip '='
  if i >= end {
    let _ = set_err(st, HlsError::InvalidAttribute("missing value for attribute: " + s.slice(key_start, key_end)))
    return -1
  }

  let mut quoted = false
  let mut val_start = i
  let mut val_end = i
  if s.code_unit_at(i) == 34 {
    quoted = true
    i = i + 1
    val_start = i
    while i < end {
      let ch = s.code_unit_at(i)
      if ch == 34 {
        break
      }
      if ch == 10 || ch == 13 {
        let _ = set_err(st, HlsError::InvalidAttribute("CR/LF inside quoted string"))
        return -1
      }
      i = i + 1
    }
    if i >= end || s.code_unit_at(i) != 34 {
      let _ = set_err(st, HlsError::InvalidAttribute("unclosed quoted string"))
      return -1
    }
    val_end = i
    i = i + 1 // skip closing '"'
    if i < end && s.code_unit_at(i) != 44 {
      let _ = set_err(st, HlsError::InvalidAttribute("expected ',' after quoted value"))
      return -1
    }
  } else {
    val_start = i
    while i < end {
      let ch = s.code_unit_at(i)
      if ch == 44 {
        break
      }
      if ch == 34 || ch == 10 || ch == 13 {
        let _ = set_err(st, HlsError::InvalidAttribute("invalid character in unquoted value"))
        return -1
      }
      i = i + 1
    }
    val_end = i
    if val_end == val_start {
      let _ = set_err(st, HlsError::InvalidAttribute("empty unquoted value for: " + s.slice(key_start, key_end)))
      return -1
    }
  }

  if i < end {
    if s.code_unit_at(i) != 44 {
      let _ = set_err(st, HlsError::InvalidAttribute("expected ',' between attributes"))
      return -1
    }
    i = i + 1
    if i >= end {
      let _ = set_err(st, HlsError::InvalidAttribute("trailing comma in attribute list"))
      return -1
    }
  }

  cur.pos = i
  cur.count = cur.count + 1
  cur.key_start = key_start
  cur.key_end = key_end
  cur.val_start = val_start
  cur.val_end = val_end
  cur.quoted = quoted
  1
}

///| Check and record an unknown attribute key span for duplicate rejection (RFC 8216 §4.2).
///| Uses zero-allocation span scanning for <= 8 unknown attributes, and switches to an O(1)
///| hash map above 8 so 256-attribute lists stay strictly O(N).
fn attr_record_unknown(cur : AttrCursor, s : String, st : ParserState) -> Bool {
  let ks = cur.key_start
  let ke = cur.key_end
  match cur.unk_map {
    Some(m) => {
      let key_str = s.slice(ks, ke)
      match m.get(key_str) {
        Some(_) =>
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: " + key_str))
        None => {
          m.set(key_str, true)
          return true
        }
      }
    }
    None => ()
  }
  let n = cur.unk_starts.length()
  let mut k = 0
  while k < n {
    if slice_eq_range(s, cur.unk_starts[k], cur.unk_ends[k], ks, ke) {
      return set_err(st, HlsError::InvalidAttribute("duplicate attribute: " + s.slice(ks, ke)))
    }
    k = k + 1
  }
  if n >= 8 {
    let m : Map[String, Bool] = Map::new()
    let mut j = 0
    while j < n {
      m.set(s.slice(cur.unk_starts[j], cur.unk_ends[j]), true)
      j = j + 1
    }
    m.set(s.slice(ks, ke), true)
    cur.unk_map = Some(m)
  } else {
    cur.unk_starts.push(ks)
    cur.unk_ends.push(ke)
  }
  true
}

fn is_valid_enum_token_slice(s : String, start : Int, end : Int) -> Bool {
  if start >= end {
    return false
  }
  let mut i = start
  while i < end {
    if !is_attr_name_char(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

fn is_valid_enum_token(s : String) -> Bool {
  is_valid_enum_token_slice(s, 0, s.length())
}

fn is_valid_decimal_float_slice(s : String, start : Int, end : Int) -> Bool {
  if start >= end {
    return false
  }
  let mut i = start
  if s.code_unit_at(i) == 45 {
    i = i + 1
  }
  if i >= end || !is_ascii_digit(s.code_unit_at(i)) {
    return false
  }
  while i < end && is_ascii_digit(s.code_unit_at(i)) {
    i = i + 1
  }
  if i < end {
    if s.code_unit_at(i) != 46 {
      return false
    }
    i = i + 1
    if i >= end || !is_ascii_digit(s.code_unit_at(i)) {
      return false
    }
    while i < end && is_ascii_digit(s.code_unit_at(i)) {
      i = i + 1
    }
  }
  i == end
}

fn is_valid_decimal_float(s : String) -> Bool {
  is_valid_decimal_float_slice(s, 0, s.length())
}

fn contains_var_ref(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i + 3 < n {
    if s.code_unit_at(i) == 123 && s.code_unit_at(i + 1) == 36 {
      let mut j = i + 2
      while j < n && is_var_name_char(s.code_unit_at(j)) {
        j = j + 1
      }
      if j > i + 2 && j < n && s.code_unit_at(j) == 125 {
        return true
      }
    }
    i = i + 1
  }
  false
}

///| Substitute `{$name}` variable references in `s[start..end]` with zero `Result` allocation.
///| On error, sets `st.has_err = true` and `st.err = Some(...)` and returns `""`.
fn sub_slice(
  s : String,
  start : Int,
  end : Int,
  st : ParserState,
  limits : HlsLimits,
) -> String {
  if !st.line_has_lbrace {
    return s.slice(start, end)
  }
  let mut found = false
  let mut i = start
  while i + 1 < end {
    if s.code_unit_at(i) == 123 && s.code_unit_at(i + 1) == 36 {
      found = true
      break
    }
    i = i + 1
  }
  if !found {
    return s.slice(start, end)
  }

  let sb = StringBuilder::with_capacity(end - start + 16)
  let mut out_len = 0
  let mut did_sub = false
  i = start
  while i < end {
    if i + 1 < end && s.code_unit_at(i) == 123 && s.code_unit_at(i + 1) == 36 {
      let name_start = i + 2
      let mut j = name_start
      while j < end && is_var_name_char(s.code_unit_at(j)) {
        j = j + 1
      }
      if j > name_start && j < end && s.code_unit_at(j) == 125 {
        let var_name = s.slice(name_start, j)
        let resolved = match st.define_values {
          Some(m) => m.get(var_name)
          None => None
        }
        match resolved {
          Some(v) => {
            let vlen = v.length()
            if out_len > limits.max_line_bytes - vlen {
              let _ = set_err(st, HlsError::LimitExceeded("variable expansion exceeded max_line_bytes"))
              return ""
            }
            if st.expanded_bytes > limits.max_expanded_bytes - vlen {
              let _ = set_err(st, HlsError::LimitExceeded("variable expansion exceeded max_expanded_bytes"))
              return ""
            }
            st.expanded_bytes = st.expanded_bytes + vlen
            out_len = out_len + vlen
            sb.write_string(v)
            did_sub = true
          }
          None => {
            let _ = set_err(st, HlsError::InvalidVariable("undefined variable: " + var_name))
            return ""
          }
        }
        i = j + 1
      } else {
        out_len = out_len + 1
        if out_len > limits.max_line_bytes {
          let _ = set_err(st, HlsError::LimitExceeded("expanded line exceeded max_line_bytes"))
          return ""
        }
        sb.write_byte(s.code_unit_at(i).to_byte())
        i = i + 1
      }
    } else {
      out_len = out_len + 1
      if out_len > limits.max_line_bytes {
        let _ = set_err(st, HlsError::LimitExceeded("expanded line exceeded max_line_bytes"))
        return ""
      }
      sb.write_byte(s.code_unit_at(i).to_byte())
      i = i + 1
    }
  }
  if !did_sub {
    return s.slice(start, end)
  }
  sb.to_string()
}

///| Zero-allocation `YES`/`NO` parser: returns `1` for `YES`, `0` for `NO`, `-1` for invalid.
fn parse_yes_no_raw(s : String, start : Int, end : Int) -> Int {
  let len = end - start
  if len == 3 &&
  s.code_unit_at(start) == 89 &&
  s.code_unit_at(start + 1) == 69 &&
  s.code_unit_at(start + 2) == 83 {
    1
  } else if len == 2 &&
  s.code_unit_at(start) == 78 &&
  s.code_unit_at(start + 1) == 79 {
    0
  } else {
    -1
  }
}

///| Parse `<length>[@<offset>]` in a single pass directly into `st.tmp_br_*` with zero allocations.
fn parse_byterange_raw(
  s : String,
  start : Int,
  end : Int,
  st : ParserState,
) -> Bool {
  if start >= end {
    return set_err(st, HlsError::InvalidNumber("empty byterange"))
  }
  let mut i = start
  let mut len = 0L
  let max_div10 = 922337203685477580L
  while i < end {
    let b = s.code_unit_at(i)
    if b == 64 {
      break
    }
    let d = b - 48
    if d < 0 || d > 9 {
      return set_err(st, HlsError::InvalidNumber("invalid byterange length"))
    }
    let d64 = d.to_int64()
    if len > max_div10 || (len == max_div10 && d64 > 7L) {
      return set_err(st, HlsError::InvalidNumber("byterange length overflow"))
    }
    len = len * 10L + d64
    i = i + 1
  }
  if i == start {
    return set_err(st, HlsError::InvalidNumber("empty byterange length"))
  }
  st.tmp_br_len = len
  if i >= end {
    st.tmp_br_has_off = false
    st.tmp_br_off = 0L
    return true
  }
  // Skip '@'
  let off = parse_uint64_raw(s, i + 1, end)
  if off < 0L {
    return set_err(st, HlsError::InvalidNumber("invalid byterange offset"))
  }
  st.tmp_br_has_off = true
  st.tmp_br_off = off
  true
}

///| Zero-allocation 128-bit hexadecimal IV validator (`0x`/`0X` + 32 hex digits).
fn validate_iv_hex_ok(s : String, start : Int, end : Int) -> Bool {
  if end - start != 34 {
    return false
  }
  let b0 = s.code_unit_at(start)
  let b1 = s.code_unit_at(start + 1)
  if b0 != 48 || (b1 != 120 && b1 != 88) {
    return false
  }
  let mut i = start + 2
  while i < end {
    if !is_hex_digit(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Validate 128-bit hexadecimal IV (`0x` or `0X` followed by exactly 32 hex digits).
fn validate_iv_hex(s : String) -> Result[Unit, HlsError] {
  if validate_iv_hex_ok(s, 0, s.length()) {
    Ok(())
  } else {
    Err(HlsError::InvalidAttribute("IV must be 0x followed by 32 hex digits (128-bit)"))
  }
}

///| Zero-allocation arbitrary hexadecimal sequence validator (`0x`/`0X` + >= 1 hex digits).
fn validate_hex_sequence_ok(s : String, start : Int, end : Int) -> Bool {
  if end - start < 3 {
    return false
  }
  let b0 = s.code_unit_at(start)
  let b1 = s.code_unit_at(start + 1)
  if b0 != 48 || (b1 != 120 && b1 != 88) {
    return false
  }
  let mut i = start + 2
  while i < end {
    if !is_hex_digit(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Validate arbitrary hexadecimal sequence (`0x` or `0X` followed by >= 1 hex digits).
fn validate_hex_sequence(s : String, label : String) -> Result[Unit, HlsError] {
  if validate_hex_sequence_ok(s, 0, s.length()) {
    Ok(())
  } else {
    Err(HlsError::InvalidAttribute(label + " must be 0x followed by hex digits"))
  }
}

fn parse_key_attrs(
  input : String,
  val_start : Int,
  line_end : Int,
  st : ParserState,
  limits : HlsLimits,
  is_session_key : Bool,
) -> Bool {
  let cur = st.attr_cur
  attr_cursor_reset(cur, val_start, line_end, limits.max_attributes)
  let mut seen = 0
  let mut method : Option[KeyMethod] = None
  let mut uri : Option[String] = None
  let mut iv : Option[String] = None
  let mut keyformat : Option[String] = None
  let mut keyformat_versions : Option[String] = None

  while true {
    let rc = attr_next(cur, input, st)
    if rc == 0 {
      break
    }
    if rc < 0 {
      return false
    }
    let ks = cur.key_start
    let ke = cur.key_end
    let klen = ke - ks
    let vs = cur.val_start
    let ve = cur.val_end
    let b0 = input.code_unit_at(ks)

    if klen == 6 && b0 == 77 && slice_eq(input, ks, ke, "METHOD") {
      if (seen & 1) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: METHOD"))
      }
      seen = seen | 1
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("METHOD must not be quoted"))
      }
      if slice_eq(input, vs, ve, "NONE") {
        if is_session_key {
          return set_err(st, HlsError::InvalidAttribute("EXT-X-SESSION-KEY METHOD must not be NONE"))
        }
        method = Some(KeyMethod::None)
      } else if slice_eq(input, vs, ve, "AES-128") {
        method = Some(KeyMethod::Aes128)
      } else if slice_eq(input, vs, ve, "SAMPLE-AES") {
        method = Some(KeyMethod::SampleAes)
      } else if slice_eq(input, vs, ve, "SAMPLE-AES-CTR") {
        method = Some(KeyMethod::SampleAesCtr)
      } else {
        return set_err(st, HlsError::InvalidAttribute("unsupported KEY METHOD: " + input.slice(vs, ve)))
      }
    } else if klen == 3 && b0 == 85 && slice_eq(input, ks, ke, "URI") {
      if (seen & 2) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: URI"))
      }
      seen = seen | 2
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("KEY URI must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      uri = Some(x)
    } else if klen == 2 && b0 == 73 && slice_eq(input, ks, ke, "IV") {
      if (seen & 4) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: IV"))
      }
      seen = seen | 4
      if cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("IV must not be quoted"))
      }
      if !st.line_has_lbrace {
        if !validate_iv_hex_ok(input, vs, ve) {
          return set_err(st, HlsError::InvalidAttribute("IV must be 0x followed by 32 hex digits (128-bit)"))
        }
        iv = Some(input.slice(vs, ve))
      } else {
        let iv_sub = sub_slice(input, vs, ve, st, limits)
        if st.has_err {
          return false
        }
        if !validate_iv_hex_ok(iv_sub, 0, iv_sub.length()) {
          return set_err(st, HlsError::InvalidAttribute("IV must be 0x followed by 32 hex digits (128-bit)"))
        }
        iv = Some(iv_sub)
      }
    } else if klen == 9 && b0 == 75 && slice_eq(input, ks, ke, "KEYFORMAT") {
      if (seen & 8) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: KEYFORMAT"))
      }
      seen = seen | 8
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("KEYFORMAT must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      keyformat = Some(x)
    } else if klen == 17 && b0 == 75 && slice_eq(input, ks, ke, "KEYFORMATVERSIONS") {
      if (seen & 16) != 0 {
        return set_err(st, HlsError::InvalidAttribute("duplicate attribute: KEYFORMATVERSIONS"))
      }
      seen = seen | 16
      if !cur.quoted {
        return set_err(st, HlsError::InvalidAttribute("KEYFORMATVERSIONS must be quoted"))
      }
      let x = sub_slice(input, vs, ve, st, limits)
      if st.has_err {
        return false
      }
      keyformat_versions = Some(x)
    } else {
      if !attr_record_unknown(cur, input, st) {
        return false
      }
    }
  }

  let m = match method {
    Some(v) => v
    None => return set_err(st, HlsError::MissingRequiredAttribute("METHOD"))
  }
  match m {
    KeyMethod::None => {
      if cur.count > 1 {
        return set_err(st, HlsError::InvalidAttribute("METHOD=NONE forbids other attributes"))
      }
    }
    _ => {
      match uri {
        Some(u) => {
          if u.length() == 0 {
            return set_err(st, HlsError::MissingRequiredAttribute("URI"))
          }
        }
        None => return set_err(st, HlsError::MissingRequiredAttribute("URI"))
      }
    }
  }
  let key = EncryptionKey::{
    method: m,
    uri: uri,
    iv: iv,
    keyformat: keyformat,
    keyformat_versions: keyformat_versions,
  }
  if is_session_key {
    st.session_keys.push(key)
  } else {
    st.pending_key = Some(key)
    st.pending_keys.push(key)
  }
  true
}
