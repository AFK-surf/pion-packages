///| O(N) RFC 8216 attribute list parser, variable substitution, and typed attribute decoders.

val struct RawAttr {
  key : String
  value : String
  quoted : Bool
}

fn is_attr_name_char(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 45
}

fn is_var_name_char(b : Int) -> Bool {
  (b >= 65 && b <= 90) ||
  (b >= 97 && b <= 122) ||
  (b >= 48 && b <= 57) ||
  b == 45 ||
  b == 95
}

///| Parse an RFC 8216 attribute list in a single O(N) pass with zero backtracking.
///| Enforces `max_attributes`, rejects duplicate keys, unclosed quotes, and trailing commas.
fn parse_attr_list(
  s : String,
  start : Int,
  end : Int,
  max_attrs : Int,
) -> Result[Array[RawAttr], HlsError] {
  let attrs : Array[RawAttr] = []
  let mut i = start
  if i >= end {
    return Ok(attrs)
  }

  while i < end {
    if attrs.length() >= max_attrs {
      return Err(HlsError::LimitExceeded("max_attributes exceeded"))
    }
    let key_start = i
    while i < end && is_attr_name_char(s.code_unit_at(i)) {
      i = i + 1
    }
    if i == key_start {
      return Err(HlsError::InvalidAttribute("empty or invalid attribute name"))
    }
    if i >= end || s.code_unit_at(i) != 61 {
      return Err(HlsError::InvalidAttribute("expected '=' after attribute name"))
    }
    let key = s.slice(key_start, i)

    // Duplicate attribute check (RFC 8216 §4.2)
    let mut k = 0
    while k < attrs.length() {
      if attrs[k].key == key {
        return Err(HlsError::InvalidAttribute("duplicate attribute: " + key))
      }
      k = k + 1
    }

    i = i + 1 // skip '='
    if i >= end {
      return Err(HlsError::InvalidAttribute("missing value for attribute: " + key))
    }

    let mut quoted = false
    let mut val_start = i
    let mut val_end = i
    if s.code_unit_at(i) == 34 {
      quoted = true
      i = i + 1
      val_start = i
      while i < end && s.code_unit_at(i) != 34 {
        let ch = s.code_unit_at(i)
        if ch == 10 || ch == 13 {
          return Err(HlsError::InvalidAttribute("CR/LF inside quoted string"))
        }
        i = i + 1
      }
      if i >= end || s.code_unit_at(i) != 34 {
        return Err(HlsError::InvalidAttribute("unclosed quoted string"))
      }
      val_end = i
      i = i + 1 // skip closing '"'
      if i < end && s.code_unit_at(i) != 44 {
        return Err(HlsError::InvalidAttribute("expected ',' after quoted value"))
      }
    } else {
      val_start = i
      while i < end && s.code_unit_at(i) != 44 {
        let ch = s.code_unit_at(i)
        if ch == 34 || ch == 10 || ch == 13 {
          return Err(HlsError::InvalidAttribute("invalid character in unquoted value"))
        }
        i = i + 1
      }
      val_end = i
      if val_end == val_start {
        return Err(HlsError::InvalidAttribute("empty unquoted value for: " + key))
      }
    }

    attrs.push(RawAttr::{
      key: key,
      value: s.slice(val_start, val_end),
      quoted: quoted,
    })

    if i < end {
      if s.code_unit_at(i) != 44 {
        return Err(HlsError::InvalidAttribute("expected ',' between attributes"))
      }
      i = i + 1
      if i >= end {
        return Err(HlsError::InvalidAttribute("trailing comma in attribute list"))
      }
    }
  }
  Ok(attrs)
}

///| Substitute `{$name}` variable references using `#EXT-X-DEFINE` values.
///| Bounded by `max_line_bytes` to prevent expansion DoS.
fn substitute_vars(
  s : String,
  defines : Array[DefineTag],
  max_line_bytes : Int,
) -> Result[String, HlsError] {
  let n = s.length()
  if defines.length() == 0 {
    return Ok(s)
  }
  // Fast scan for "{$"
  let mut found = false
  let mut i = 0
  while i + 1 < n {
    if s.code_unit_at(i) == 123 && s.code_unit_at(i + 1) == 36 {
      found = true
      break
    }
    i = i + 1
  }
  if !found {
    return Ok(s)
  }

  let sb = StringBuilder::new()
  let mut out_len = 0
  i = 0
  while i < n {
    if i + 1 < n && s.code_unit_at(i) == 123 && s.code_unit_at(i + 1) == 36 {
      let name_start = i + 2
      let mut j = name_start
      while j < n && s.code_unit_at(j) != 125 {
        if !is_var_name_char(s.code_unit_at(j)) {
          return Err(HlsError::InvalidVariable("invalid character in variable reference"))
        }
        j = j + 1
      }
      if j >= n || j == name_start {
        return Err(HlsError::InvalidVariable("malformed variable reference"))
      }
      let var_name = s.slice(name_start, j)
      let mut resolved : Option[String] = None
      let mut d = 0
      while d < defines.length() {
        if defines[d].name == var_name {
          match defines[d].kind {
            DefineKind::Value(v) => {
              resolved = Some(v)
              break
            }
            _ => ()
          }
        }
        d = d + 1
      }
      match resolved {
        Some(v) => {
          out_len = out_len + v.length()
          if out_len > max_line_bytes {
            return Err(HlsError::LimitExceeded("variable expansion exceeded max_line_bytes"))
          }
          sb.write_string(v)
        }
        None =>
        return Err(HlsError::InvalidVariable("undefined variable: " + var_name))
      }
      i = j + 1
    } else {
      out_len = out_len + 1
      if out_len > max_line_bytes {
        return Err(HlsError::LimitExceeded("expanded line exceeded max_line_bytes"))
      }
      sb.write_byte(s.code_unit_at(i).to_byte())
      i = i + 1
    }
  }
  Ok(sb.to_string())
}

///| Parse `YES` or `NO` boolean attribute.
fn parse_yes_no(value : String, attr_name : String) -> Result[Bool, HlsError] {
  if value == "YES" {
    Ok(true)
  } else if value == "NO" {
    Ok(false)
  } else {
    Err(HlsError::InvalidAttribute(attr_name + " must be YES or NO"))
  }
}

///| Parse `<length>[@<offset>]` byte range string.
fn parse_byterange_str(s : String) -> Result[ByteRange, HlsError] {
  let n = s.length()
  let at_idx = find_byte_in(s, 0, n, 64)
  if at_idx < 0 {
    let len = match parse_uint64_slice(s, 0, n) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    Ok(ByteRange::{ length: len, offset: None })
  } else {
    let len = match parse_uint64_slice(s, 0, at_idx) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let off = match parse_uint64_slice(s, at_idx + 1, n) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    Ok(ByteRange::{ length: len, offset: Some(off) })
  }
}

///| Parse `<width>x<height>` resolution string.
fn parse_resolution_str(s : String) -> Result[Resolution, HlsError] {
  let n = s.length()
  let x_idx = find_byte_in(s, 0, n, 120)
  if x_idx <= 0 || x_idx + 1 >= n {
    return Err(HlsError::InvalidAttribute("RESOLUTION must be WxH"))
  }
  let w = match parse_uint64_slice(s, 0, x_idx) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let h = match parse_uint64_slice(s, x_idx + 1, n) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if w <= 0L || h <= 0L {
    return Err(HlsError::InvalidAttribute("RESOLUTION dimensions must be positive"))
  }
  Ok(Resolution::{ width: w, height: h })
}

///| Validate 128-bit hexadecimal IV (`0x` or `0X` followed by exactly 32 hex digits).
fn validate_iv_hex(s : String) -> Result[Unit, HlsError] {
  if s.length() != 34 {
    return Err(HlsError::InvalidAttribute("IV must be 0x followed by 32 hex digits (128-bit)"))
  }
  let b0 = s.code_unit_at(0)
  let b1 = s.code_unit_at(1)
  if b0 != 48 || (b1 != 120 && b1 != 88) {
    return Err(HlsError::InvalidAttribute("IV must start with 0x or 0X"))
  }
  let mut i = 2
  while i < 34 {
    if !is_hex_digit(s.code_unit_at(i)) {
      return Err(HlsError::InvalidAttribute("invalid hex digit in IV"))
    }
    i = i + 1
  }
  Ok(())
}

///| Validate arbitrary hexadecimal sequence (`0x` or `0X` followed by >= 1 hex digits).
fn validate_hex_sequence(s : String, label : String) -> Result[Unit, HlsError] {
  let n = s.length()
  if n < 3 {
    return Err(HlsError::InvalidAttribute(label + " must be 0x followed by hex digits"))
  }
  let b0 = s.code_unit_at(0)
  let b1 = s.code_unit_at(1)
  if b0 != 48 || (b1 != 120 && b1 != 88) {
    return Err(HlsError::InvalidAttribute(label + " must start with 0x or 0X"))
  }
  let mut i = 2
  while i < n {
    if !is_hex_digit(s.code_unit_at(i)) {
      return Err(HlsError::InvalidAttribute("invalid hex digit in " + label))
    }
    i = i + 1
  }
  Ok(())
}

fn parse_key_attrs(
  attrs : Array[RawAttr],
  defines : Array[DefineTag],
  max_line_bytes : Int,
  is_session_key : Bool,
) -> Result[EncryptionKey, HlsError] {
  let mut method : Option[KeyMethod] = None
  let mut uri : Option[String] = None
  let mut iv : Option[String] = None
  let mut keyformat : Option[String] = None
  let mut keyformat_versions : Option[String] = None

  let mut i = 0
  while i < attrs.length() {
    let a = attrs[i]
    if a.key == "METHOD" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("METHOD must not be quoted"))
      }
      if a.value == "NONE" {
        if is_session_key {
          return Err(HlsError::InvalidAttribute("EXT-X-SESSION-KEY METHOD must not be NONE"))
        }
        method = Some(KeyMethod::None)
      } else if a.value == "AES-128" {
        method = Some(KeyMethod::Aes128)
      } else if a.value == "SAMPLE-AES" {
        method = Some(KeyMethod::SampleAes)
      } else if a.value == "SAMPLE-AES-CTR" {
        method = Some(KeyMethod::SampleAesCtr)
      } else {
        return Err(HlsError::InvalidAttribute("unsupported KEY METHOD: " + a.value))
      }
    } else if a.key == "URI" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("KEY URI must be quoted"))
      }
      let v = match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      uri = Some(v)
    } else if a.key == "IV" {
      if a.quoted {
        return Err(HlsError::InvalidAttribute("IV must not be quoted"))
      }
      match validate_iv_hex(a.value) {
        Ok(_) => iv = Some(a.value)
        Err(e) => return Err(e)
      }
    } else if a.key == "KEYFORMAT" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("KEYFORMAT must be quoted"))
      }
      let v = match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      keyformat = Some(v)
    } else if a.key == "KEYFORMATVERSIONS" {
      if !a.quoted {
        return Err(HlsError::InvalidAttribute("KEYFORMATVERSIONS must be quoted"))
      }
      let v = match substitute_vars(a.value, defines, max_line_bytes) {
        Ok(x) => x
        Err(e) => return Err(e)
      }
      keyformat_versions = Some(v)
    }
    i = i + 1
  }

  let m = match method {
    Some(v) => v
    None => return Err(HlsError::MissingRequiredAttribute("METHOD"))
  }
  match m {
    KeyMethod::None => ()
    _ => {
      match uri {
        Some(u) => {
          if u.length() == 0 {
            return Err(HlsError::MissingRequiredAttribute("URI"))
          }
        }
        None => return Err(HlsError::MissingRequiredAttribute("URI"))
      }
    }
  }
  Ok(EncryptionKey::{
    method: m,
    uri: uri,
    iv: iv,
    keyformat: keyformat,
    keyformat_versions: keyformat_versions,
  })
}
