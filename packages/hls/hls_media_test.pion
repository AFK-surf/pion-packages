///| RFC 8216 Media Playlist, ByteRange inheritance, Key/Map scope, DateRange & timeline tests.

fn assert_opt_i64(got : Option[Int64], expected : Int64, label : String) -> Unit {
  match got {
    Some(v) => debug_assert(v == expected, label + ": expected " + expected.to_string() + ", got " + v.to_string())
    None => debug_assert(false, label + ": expected Some, got None")
  }
}

fn assert_opt_str(got : Option[String], expected : String, label : String) -> Unit {
  match got {
    Some(v) => debug_assert(v == expected, label + ": expected " + expected + ", got " + v)
    None => debug_assert(false, label + ": expected Some, got None")
  }
}

///|
test "media_full_vod_and_resolve_sequence" {
  let m3u8 =
  "#EXTM3U\n" +
  "#EXT-X-VERSION:7\n" +
  "#EXT-X-TARGETDURATION:6\n" +
  "#EXT-X-MEDIA-SEQUENCE:100\n" +
  "#EXT-X-DISCONTINUITY-SEQUENCE:2\n" +
  "#EXT-X-PLAYLIST-TYPE:VOD\n" +
  "#EXT-X-MAP:URI=\"init.mp4\",BYTERANGE=\"720@0\"\n" +
  "#EXT-X-KEY:METHOD=AES-128,URI=\"https://keys.example.com/k1\",IV=0x00000000000000000000000000000064\n" +
  "#EXT-X-PROGRAM-DATE-TIME:2026-11-24T08:00:00.000Z\n" +
  "#EXTINF:6.006,Segment One\n" +
  "#EXT-X-BYTERANGE:1000@720\n" +
  "media.mp4\n" +
  "#EXTINF:5.5,\n" +
  "#EXT-X-BYTERANGE:2000\n" +
  "media.mp4\n" +
  "#EXT-X-DISCONTINUITY\n" +
  "#EXT-X-KEY:METHOD=NONE\n" +
  "#EXT-X-GAP\n" +
  "#EXTINF:4.000,\n" +
  "gap.mp4\n" +
  "#EXT-X-DATERANGE:ID=\"ad-1\",CLASS=\"com.example.ad\",START-DATE=\"2026-11-24T08:00:11.506Z\",DURATION=30.0,PLANNED-DURATION=30.0,SCTE35-OUT=0xFC3020000000,X-CUSTOM=\"hello\",X-COUNT=42\n" +
  "#EXT-X-ENDLIST\n"

  match parse_playlist(m3u8) {
    Ok(Playlist::Media(m)) => {
      debug_assert(m.target_duration == 6L, "target_duration")
      debug_assert(m.media_sequence == 100L, "media_sequence")
      debug_assert(m.discontinuity_sequence == 2L, "discontinuity_sequence")
      match m.playlist_type {
        Some(PlaylistType::Vod) => ()
        _ => debug_assert(false, "expected VOD")
      }
      debug_assert(m.end_list, "end_list")
      debug_assert(m.segments.length() == 3, "segments len")

      // Segment 0 explicit byterange
      match m.segments[0].byterange {
        Some(br) => {
          debug_assert(br.length == 1000L, "seg0 br len")
          assert_opt_i64(br.offset, 720L, "seg0 br off")
        }
        None => debug_assert(false, "seg0 missing br")
      }
      // Segment 1 implicit byterange -> 720 + 1000 = 1720
      match m.segments[1].byterange {
        Some(br) => {
          debug_assert(br.length == 2000L, "seg1 br len")
          assert_opt_i64(br.offset, 1720L, "seg1 implicit br off must be 1720")
        }
        None => debug_assert(false, "seg1 missing br")
      }
      debug_assert(m.segments[0].duration_us == 6006000L, "seg0 dur us")
      debug_assert(m.segments[1].duration_us == 5500000L, "seg1 dur us")
      debug_assert(m.segments[2].duration_us == 4000000L, "seg2 dur us")
      assert_opt_str(m.segments[0].title, "Segment One", "seg0 title")
      debug_assert(m.segments[2].discontinuity, "seg2 discontinuity")
      debug_assert(m.segments[2].gap, "seg2 gap")

      // Total duration: 6.006 + 5.5 + 4.0 = 15.506s = 15506ms
      debug_assert(total_duration_us(m) == 15506000L, "total_duration_us")
      debug_assert(total_duration_ms(m) == 15506L, "total_duration_ms")

      // Resolve sequence & inherited key/map
      let resolved = resolve_media_sequence(m)
      debug_assert(resolved.length() == 3, "resolved len")
      debug_assert(resolved[0].media_sequence == 100L, "r0 msn")
      debug_assert(resolved[1].media_sequence == 101L, "r1 msn")
      debug_assert(resolved[2].media_sequence == 102L, "r2 msn")
      debug_assert(resolved[0].discontinuity_sequence == 2L, "r0 dsn")
      debug_assert(resolved[1].discontinuity_sequence == 2L, "r1 dsn")
      debug_assert(resolved[2].discontinuity_sequence == 3L, "r2 dsn incremented")
      debug_assert(resolved[0].start_us == 0L, "r0 start")
      debug_assert(resolved[0].end_us == 6006000L, "r0 end")
      debug_assert(resolved[1].start_us == 6006000L, "r1 start")
      debug_assert(resolved[1].end_us == 11506000L, "r1 end")
      debug_assert(resolved[2].start_us == 11506000L, "r2 start")
      debug_assert(resolved[2].end_us == 15506000L, "r2 end")

      // Seg 0 & 1 inherit AES-128 key and init.mp4 map; Seg 2 has METHOD=NONE -> key None, still inherits map
      match resolved[0].key {
        Some(k) => assert_opt_str(k.uri, "https://keys.example.com/k1", "r0 key uri")
        None => debug_assert(false, "r0 should have key")
      }
      match resolved[1].key {
        Some(k) => assert_opt_str(k.uri, "https://keys.example.com/k1", "r1 inherited key")
        None => debug_assert(false, "r1 should inherit key")
      }
      match resolved[2].key {
        None => ()
        Some(_) => debug_assert(false, "r2 METHOD=NONE should clear effective key")
      }
      match resolved[2].map {
        Some(mp) => debug_assert(mp.uri == "init.mp4", "r2 inherited map")
        None => debug_assert(false, "r2 should inherit map")
      }

      // DateRange checks
      debug_assert(m.dateranges.length() == 1, "dateranges len")
      debug_assert(m.dateranges[0].id == "ad-1", "dr id")
      assert_opt_i64(m.dateranges[0].duration_us, 30000000L, "dr dur")
      debug_assert(m.dateranges[0].client_attributes.length() == 2, "dr X-* attrs")
    }
    Ok(Playlist::Master(_)) => debug_assert(false, "expected Media")
    Err(e) => debug_assert(false, "parse failed: " + hls_error_to_string(e))
  }
}

///|
test "media_i_frames_only_and_event_type" {
  let m3u8 =
  "#EXTM3U\n" +
  "#EXT-X-VERSION:4\n" +
  "#EXT-X-TARGETDURATION:10\n" +
  "#EXT-X-PLAYLIST-TYPE:EVENT\n" +
  "#EXT-X-I-FRAMES-ONLY\n" +
  "#EXTINF:10,\n" +
  "#EXT-X-BYTERANGE:512@0\n" +
  "seg0.ts\n"

  match parse_playlist(m3u8) {
    Ok(Playlist::Media(m)) => {
      debug_assert(m.i_frames_only, "i_frames_only")
      debug_assert(!m.end_list, "not end_list")
      match m.playlist_type {
        Some(PlaylistType::Event) => ()
        _ => debug_assert(false, "expected EVENT")
      }
      debug_assert(m.segments.length() == 1, "1 segment")
      debug_assert(m.segments[0].duration_us == 10000000L, "integer 10s")
    }
    _ => debug_assert(false, "expected valid media playlist")
  }
}
