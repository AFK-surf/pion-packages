///| Deterministic formatter & parse -> format -> parse round-trip tests.

///|
test "roundtrip_master_playlist" {
  let src =
  "#EXTM3U\n" +
  "#EXT-X-VERSION:7\n" +
  "#EXT-X-INDEPENDENT-SEGMENTS\n" +
  "#EXT-X-START:TIME-OFFSET=2.5,PRECISE=YES\n" +
  "#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"a1\",NAME=\"Eng\",LANGUAGE=\"en\",DEFAULT=YES,AUTOSELECT=YES,URI=\"audio.m3u8\"\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=2000000,AVERAGE-BANDWIDTH=1800000,CODECS=\"avc1.640028,mp4a.40.2\",RESOLUTION=1280x720,FRAME-RATE=29.970,AUDIO=\"a1\",CLOSED-CAPTIONS=NONE\n" +
  "720p.m3u8\n" +
  "#EXT-X-I-FRAME-STREAM-INF:BANDWIDTH=300000,RESOLUTION=1280x720,URI=\"720p_i.m3u8\"\n"

  let p1 = match parse_playlist(src) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "p1 failed: " + hls_error_to_string(e))
      return
    }
  }
  let out1 = match format_playlist(p1) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "fmt1 failed: " + hls_error_to_string(e))
      return
    }
  }
  let p2 = match parse_playlist(out1) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "p2 failed: " + hls_error_to_string(e))
      return
    }
  }
  let out2 = match format_playlist(p2) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "fmt2 failed: " + hls_error_to_string(e))
      return
    }
  }
  debug_assert(out1 == out2, "master roundtrip must be byte-identical on second format")
}

///|
test "roundtrip_media_llhls_playlist" {
  let src =
  "#EXTM3U\n" +
  "#EXT-X-VERSION:9\n" +
  "#EXT-X-TARGETDURATION:6\n" +
  "#EXT-X-MEDIA-SEQUENCE:10\n" +
  "#EXT-X-PLAYLIST-TYPE:EVENT\n" +
  "#EXT-X-SERVER-CONTROL:CAN-SKIP-UNTIL=36,PART-HOLD-BACK=1.5,CAN-BLOCK-RELOAD=YES\n" +
  "#EXT-X-PART-INF:PART-TARGET=0.5\n" +
  "#EXT-X-MAP:URI=\"init.mp4\",BYTERANGE=\"500@0\"\n" +
  "#EXT-X-KEY:METHOD=AES-128,URI=\"key.bin\",IV=0x0000000000000000000000000000000a\n" +
  "#EXT-X-PART:DURATION=0.5,URI=\"p0.m4s\",INDEPENDENT=YES\n" +
  "#EXTINF:6.006,seg title\n" +
  "#EXT-X-BYTERANGE:1024@500\n" +
  "seg10.m4s\n" +
  "#EXT-X-PART:DURATION=0.5,URI=\"p1.m4s\"\n" +
  "#EXT-X-PRELOAD-HINT:TYPE=PART,URI=\"p2.m4s\"\n" +
  "#EXT-X-RENDITION-REPORT:URI=\"other.m3u8\",LAST-MSN=11,LAST-PART=0\n"

  let p1 = match parse_playlist(src) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "media p1 failed: " + hls_error_to_string(e))
      return
    }
  }
  let out1 = match format_playlist(p1) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "media fmt1 failed: " + hls_error_to_string(e))
      return
    }
  }
  let p2 = match parse_playlist(out1) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "media p2 failed: " + hls_error_to_string(e))
      return
    }
  }
  let out2 = match format_playlist(p2) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "media fmt2 failed: " + hls_error_to_string(e))
      return
    }
  }
  debug_assert(out1 == out2, "media roundtrip must be byte-identical on second format")
}
