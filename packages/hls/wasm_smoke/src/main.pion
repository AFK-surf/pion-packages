///| Native + Wasm32 4-mode deterministic smoke entry for `packages/hls`.

import "hls"

fn fnv1a_str(seed : Int64, s : String) -> Int64 {
  let mut h = seed
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ s.code_unit_at(i).to_int64()) * 1099511628211L
    i = i + 1
  }
  h
}

///|
pub fn main(world : World) -> Int {
  let master_src =
  "\xEF\xBB\xBF#EXTM3U\r\n" +
  "#EXT-X-VERSION:7\r\n" +
  "#EXT-X-INDEPENDENT-SEGMENTS\r\n" +
  "#EXT-X-START:TIME-OFFSET=-6.25,PRECISE=YES\r\n" +
  "#EXT-X-DEFINE:NAME=\"cdn\",VALUE=\"https://edge.example.org\"\r\n" +
  "#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"aac\",NAME=\"English\",LANGUAGE=\"en\",DEFAULT=YES,AUTOSELECT=YES,URI=\"{$cdn}/a.m3u8\"\r\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=1500000,AVERAGE-BANDWIDTH=1200000,CODECS=\"avc1.64001f,mp4a.40.2\",RESOLUTION=1280x720,FRAME-RATE=29.970,AUDIO=\"aac\",CLOSED-CAPTIONS=NONE\r\n" +
  "{$cdn}/720p.m3u8\r\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=4800000,CODECS=\"hvc1.1.6.L120.90,mp4a.40.2\",RESOLUTION=1920x1080,FRAME-RATE=59.940,AUDIO=\"aac\"\r\n" +
  "{$cdn}/1080p.m3u8\r\n" +
  "#EXT-X-I-FRAME-STREAM-INF:BANDWIDTH=240000,RESOLUTION=1280x720,URI=\"720p_i.m3u8\"\r\n"

  let media_src =
  "#EXTM3U\n" +
  "#EXT-X-VERSION:9\n" +
  "#EXT-X-TARGETDURATION:6\n" +
  "#EXT-X-MEDIA-SEQUENCE:42\n" +
  "#EXT-X-PLAYLIST-TYPE:VOD\n" +
  "#EXT-X-SERVER-CONTROL:CAN-SKIP-UNTIL=24.0,PART-HOLD-BACK=1.002,CAN-BLOCK-RELOAD=YES\n" +
  "#EXT-X-PART-INF:PART-TARGET=0.334\n" +
  "#EXT-X-MAP:URI=\"init.mp4\",BYTERANGE=\"720@0\"\n" +
  "#EXT-X-KEY:METHOD=AES-128,URI=\"key.bin\",IV=0x0000000000000000000000000000002a\n" +
  "#EXT-X-PART:DURATION=0.334,URI=\"seg42.0.m4s\",INDEPENDENT=YES\n" +
  "#EXTINF:6.006,First\n" +
  "#EXT-X-BYTERANGE:1024@720\n" +
  "stream.mp4\n" +
  "#EXTINF:5.5,\n" +
  "#EXT-X-BYTERANGE:2048\n" +
  "stream.mp4\n" +
  "#EXT-X-DISCONTINUITY\n" +
  "#EXT-X-KEY:METHOD=NONE\n" +
  "#EXTINF:4.0,\n" +
  "ad.mp4\n" +
  "#EXT-X-ENDLIST\n"

  let p_master = match hls::parse_playlist(master_src) {
    Ok(p) => p
    Err(e) => {
      io_println(world, "master_err=" + hls::hls_error_to_string(e))
      return 1
    }
  }
  let p_media = match hls::parse_playlist(media_src) {
    Ok(p) => p
    Err(e) => {
      io_println(world, "media_err=" + hls::hls_error_to_string(e))
      return 2
    }
  }

  let fmt_master = match hls::format_playlist(p_master) {
    Ok(s) => s
    Err(_) => return 3
  }
  let fmt_media = match hls::format_playlist(p_media) {
    Ok(s) => s
    Err(_) => return 4
  }

  let sel_uri = match p_master {
    hls::Playlist::Master(m) => {
      match hls::select_variant(m, 5000000L, ["hvc1"]) {
        Some(v) => v.uri
        None => "none"
      }
    }
    hls::Playlist::Media(_) => "wrong"
  }

  let (dur_ms, res_len, last_dsn) = match p_media {
    hls::Playlist::Media(m) => {
      let rs = hls::resolve_media_sequence(m)
      (hls::total_duration_ms(m), rs.length(), rs[rs.length() - 1].discontinuity_sequence)
    }
    hls::Playlist::Master(_) => (0L, 0, 0L)
  }

  let mut h = -3750763034362895579L
  h = fnv1a_str(h, fmt_master)
  h = fnv1a_str(h, fmt_media)

  io_println(world, "hls_wasm_smoke=ok")
  io_println(world, "selected=" + sel_uri)
  io_println(world, "dur_ms=" + dur_ms.to_string())
  io_println(world, "resolved=" + res_len.to_string())
  io_println(world, "last_dsn=" + last_dsn.to_string())
  io_println(world, "fnv64=" + h.to_string())
  0
}
