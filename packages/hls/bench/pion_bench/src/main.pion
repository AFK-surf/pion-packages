///| Pion native differential oracle & benchmark driver for `packages/hls`.

import "hls"

fn parse_int_arg(s : String) -> Int {
  let mut v = 0
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  v
}

fn split_cases(content : String) -> Array[String] {
  let sep = "\n===HLS_CASE_SEP===\n"
  let sep_len = sep.length()
  let n = content.length()
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i + sep_len <= n {
    let mut matched = true
    let mut k = 0
    while k < sep_len {
      if content.code_unit_at(i + k) != sep.code_unit_at(k) {
        matched = false
        break
      }
      k = k + 1
    }
    if matched {
      out.push(content.slice(start, i))
      start = i + sep_len
      i = start
    } else {
      i = i + 1
    }
  }
  if start < n {
    out.push(content.slice(start, n))
  }
  out
}

fn opt_str(o : Option[String]) -> String {
  match o {
    Some(s) => s
    None => "-"
  }
}

fn opt_i64(o : Option[Int64]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "-"
  }
}

fn opt_int(o : Option[Int]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "-"
  }
}

fn bool_bit(b : Bool) -> String {
  if b { "1" } else { "0" }
}

fn key_method_str(m : hls::KeyMethod) -> String {
  match m {
    hls::KeyMethod::None => "NONE"
    hls::KeyMethod::Aes128 => "AES-128"
    hls::KeyMethod::SampleAes => "SAMPLE-AES"
    hls::KeyMethod::SampleAesCtr => "SAMPLE-AES-CTR"
  }
}

fn media_type_str(t : hls::MediaType) -> String {
  match t {
    hls::MediaType::Audio => "AUDIO"
    hls::MediaType::Video => "VIDEO"
    hls::MediaType::Subtitles => "SUBTITLES"
    hls::MediaType::ClosedCaptions => "CLOSED-CAPTIONS"
  }
}

fn run_diff(world : World, corpus_path : String) -> Int {
  let content = match fs_read(world, corpus_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "ERR read corpus")
      return 1
    }
  }
  let cases = split_cases(content)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < cases.length() {
    match hls::parse_playlist(cases[i]) {
      Err(e) => {
        sb.write_string("ERR|")
        sb.write_string(hls::hls_error_to_string(e))
        sb.write_string("\n")
      }
      Ok(hls::Playlist::Master(m)) => {
        sb.write_string("MASTER|ver=")
        sb.write_string(opt_int(m.version))
        sb.write_string("|indep=")
        sb.write_string(bool_bit(m.independent_segments))
        sb.write_string("|variants=")
        sb.write_string(m.variants.length().to_string())
        sb.write_string("|iframes=")
        sb.write_string(m.iframe_streams.length().to_string())
        sb.write_string("|media=")
        sb.write_string(m.media.length().to_string())
        sb.write_string("|sdata=")
        sb.write_string(m.session_data.length().to_string())
        sb.write_string("|skeys=")
        sb.write_string(m.session_keys.length().to_string())
        sb.write_string("\n")

        let mut j = 0
        while j < m.variants.length() {
          let v = m.variants[j]
          let res_s = match v.resolution {
            Some(r) => r.width.to_string() + "x" + r.height.to_string()
            None => "-"
          }
          sb.write_string("V|")
          sb.write_string(v.uri)
          sb.write_string("|")
          sb.write_string(v.bandwidth.to_string())
          sb.write_string("|")
          sb.write_string(opt_i64(v.average_bandwidth))
          sb.write_string("|")
          sb.write_string(opt_str(v.codecs))
          sb.write_string("|")
          sb.write_string(res_s)
          sb.write_string("|")
          sb.write_string(opt_str(v.audio))
          sb.write_string("|")
          sb.write_string(opt_str(v.subtitles))
          sb.write_string("\n")
          j = j + 1
        }
        j = 0
        while j < m.media.length() {
          let md = m.media[j]
          sb.write_string("M|")
          sb.write_string(media_type_str(md.media_type))
          sb.write_string("|")
          sb.write_string(md.group_id)
          sb.write_string("|")
          sb.write_string(md.name)
          sb.write_string("|")
          sb.write_string(opt_str(md.language))
          sb.write_string("|")
          sb.write_string(bool_bit(md.is_default))
          sb.write_string("|")
          sb.write_string(bool_bit(md.autoselect))
          sb.write_string("|")
          sb.write_string(opt_str(md.uri))
          sb.write_string("\n")
          j = j + 1
        }
      }
      Ok(hls::Playlist::Media(m)) => {
        let pt_s = match m.playlist_type {
          Some(hls::PlaylistType::Event) => "EVENT"
          Some(hls::PlaylistType::Vod) => "VOD"
          None => "-"
        }
        sb.write_string("MEDIA|ver=")
        sb.write_string(opt_int(m.version))
        sb.write_string("|td=")
        sb.write_string(m.target_duration.to_string())
        sb.write_string("|msn=")
        sb.write_string(m.media_sequence.to_string())
        sb.write_string("|dsn=")
        sb.write_string(m.discontinuity_sequence.to_string())
        sb.write_string("|type=")
        sb.write_string(pt_s)
        sb.write_string("|end=")
        sb.write_string(bool_bit(m.end_list))
        sb.write_string("|segs=")
        sb.write_string(m.segments.length().to_string())
        sb.write_string("\n")

        let mut j = 0
        while j < m.segments.length() {
          let seg = m.segments[j]
          let dur_ms = (seg.duration_us + 500L) / 1000L
          let br_s = match seg.byterange {
            Some(br) => br.length.to_string() + "@" + opt_i64(br.offset)
            None => "-"
          }
          let (km_s, ku_s) = match seg.key {
            Some(k) => {
              match k.method {
                hls::KeyMethod::None => ("-", "-")
                _ => (key_method_str(k.method), opt_str(k.uri))
              }
            }
            None => ("-", "-")
          }
          let mu_s = match seg.map {
            Some(mp) => mp.uri
            None => "-"
          }
          sb.write_string("S|")
          sb.write_string(seg.uri)
          sb.write_string("|")
          sb.write_string(dur_ms.to_string())
          sb.write_string("|")
          sb.write_string(br_s)
          sb.write_string("|")
          sb.write_string(bool_bit(seg.discontinuity))
          sb.write_string("|")
          sb.write_string(km_s)
          sb.write_string("|")
          sb.write_string(ku_s)
          sb.write_string("|")
          sb.write_string(mu_s)
          sb.write_string("\n")
          j = j + 1
        }
      }
    }
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

fn run_bench(world : World, corpus_path : String, iters : Int) -> Int {
  let content = match fs_read(world, corpus_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "ERR read corpus")
      return 1
    }
  }
  let cases = split_cases(content)
  let mut total_playlists = 0L
  let mut total_variants = 0L
  let mut total_segments = 0L
  let mut total_dur_ms = 0L

  let mut it = 0
  while it < iters {
    let mut i = 0
    while i < cases.length() {
      match hls::parse_playlist(cases[i]) {
        Ok(hls::Playlist::Master(m)) => {
          total_playlists = total_playlists + 1L
          total_variants = total_variants + m.variants.length().to_int64()
        }
        Ok(hls::Playlist::Media(m)) => {
          total_playlists = total_playlists + 1L
          total_segments = total_segments + m.segments.length().to_int64()
          total_dur_ms = total_dur_ms + hls::total_duration_ms(m)
        }
        Err(_) => ()
      }
      i = i + 1
    }
    it = it + 1
  }
  io_println(
    world,
    "bench playlists=" +
    total_playlists.to_string() +
    " variants=" +
    total_variants.to_string() +
    " segments=" +
    total_segments.to_string() +
    " total_ms=" +
    total_dur_ms.to_string(),
  )
  0
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_hls <diff|bench> <corpus> [iters]")
    return 1
  }
  let cmd = args[1]
  if cmd == "diff" {
    run_diff(world, args[2])
  } else if cmd == "bench" && args.length() >= 4 {
    run_bench(world, args[2], parse_int_arg(args[3]))
  } else {
    io_println(world, "unknown command: " + cmd)
    1
  }
}
