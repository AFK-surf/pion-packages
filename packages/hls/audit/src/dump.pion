///| Canonical, field-complete dump of the `packages/hls` data model (one record per line).
///| The same format is produced by the independent Python reference model (../diff/model.py),
///| so the two outputs can be compared byte-for-byte. See ../REPORT.md, "Canonical dump".
///|
///| Strings are written as `"` + esc(s); `None` is `-`. esc() writes bytes outside 0x21..0x7E and
///| `% | \ " ,` as %XX, so every output line is printable ASCII.

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Decode a lowercase/uppercase hex string into a byte string.
pub fn unhex(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i + 1 < s.length() {
    sb.write_byte(
      ((hexval(s.code_unit_at(i)) << 4) | hexval(s.code_unit_at(i + 1))).to_byte(),
    )
    i = i + 2
  }
  sb.to_string()
}

///|
fn hexdigit(v : Int) -> Int {
  if v < 10 {
    48 + v
  } else {
    55 + v
  }
}

///| Escape a string so that the output is printable ASCII without `| % \ " ,`.
pub fn esc(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i) & 255
    if c > 32 &&
    c < 127 &&
    c != 37 &&
    c != 124 &&
    c != 92 &&
    c != 34 &&
    c != 44 {
      sb.write_byte(c.to_byte())
    } else {
      sb.write_byte(37.to_byte())
      sb.write_byte(hexdigit(c >> 4).to_byte())
      sb.write_byte(hexdigit(c & 15).to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn qs(s : String) -> String {
  "\"" + esc(s)
}

///|
pub fn os(o : Option[String]) -> String {
  match o {
    Some(s) => qs(s)
    None => "-"
  }
}

///|
pub fn oi(o : Option[Int64]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "-"
  }
}

///|
pub fn ov(o : Option[Int]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "-"
  }
}

///|
pub fn b01(b : Bool) -> String {
  if b {
    "1"
  } else {
    "0"
  }
}

///| Error variant name (messages are implementation detail and are not compared).
pub fn err_kind(e : hls::HlsError) -> String {
  let s = hls::hls_error_to_string(e)
  let mut i = 0
  while i < s.length() && s.code_unit_at(i) != 58 {
    i = i + 1
  }
  s.slice(0, i)
}

///|
fn br_s(o : Option[hls::ByteRange]) -> String {
  match o {
    Some(b) => b.length.to_string() + "@" + oi(b.offset)
    None => "-"
  }
}

///|
fn method_s(m : hls::KeyMethod) -> String {
  match m {
    hls::KeyMethod::None => "NONE"
    hls::KeyMethod::Aes128 => "AES-128"
    hls::KeyMethod::SampleAes => "SAMPLE-AES"
    hls::KeyMethod::SampleAesCtr => "SAMPLE-AES-CTR"
  }
}

///|
pub fn key_s(k : hls::EncryptionKey) -> String {
  method_s(k.method) +
  "," +
  os(k.uri) +
  "," +
  os(k.iv) +
  "," +
  os(k.keyformat) +
  "," +
  os(k.keyformat_versions)
}

///|
fn okey_s(o : Option[hls::EncryptionKey]) -> String {
  match o {
    Some(k) => key_s(k)
    None => "-"
  }
}

///|
fn map_s(o : Option[hls::MediaMap]) -> String {
  match o {
    Some(m) => qs(m.uri) + "," + br_s(m.byterange)
    None => "-"
  }
}

///|
fn res_s(o : Option[hls::Resolution]) -> String {
  match o {
    Some(r) => r.width.to_string() + "x" + r.height.to_string()
    None => "-"
  }
}

///|
fn hdcp_s(o : Option[hls::HdcpLevel]) -> String {
  match o {
    Some(hls::HdcpLevel::None) => "NONE"
    Some(hls::HdcpLevel::Type0) => "TYPE-0"
    Some(hls::HdcpLevel::Type1) => "TYPE-1"
    Some(hls::HdcpLevel::Other(s)) => qs(s)
    None => "-"
  }
}

///|
fn start_s(o : Option[hls::StartTag]) -> String {
  match o {
    Some(s) => s.time_offset_us.to_string() + "," + b01(s.precise)
    None => "-"
  }
}

///|
fn defines_s(sb : StringBuilder, defs : Array[hls::DefineTag]) -> Unit {
  let mut i = 0
  while i < defs.length() {
    let d = defs[i]
    let k = match d.kind {
      hls::DefineKind::Value(v) => "VALUE|" + qs(v)
      hls::DefineKind::Import => "IMPORT|-"
      hls::DefineKind::QueryParam => "QUERYPARAM|-"
    }
    sb.write_string("DEF|" + qs(d.name) + "|" + k + "\n")
    i = i + 1
  }
}

///|
fn custom_s(sb : StringBuilder, cts : Array[hls::CustomTag]) -> Unit {
  let mut i = 0
  while i < cts.length() {
    sb.write_string("CT|" + qs(cts[i].name) + "|" + os(cts[i].value) + "\n")
    i = i + 1
  }
}

///|
fn media_type_s(t : hls::MediaType) -> String {
  match t {
    hls::MediaType::Audio => "AUDIO"
    hls::MediaType::Video => "VIDEO"
    hls::MediaType::Subtitles => "SUBTITLES"
    hls::MediaType::ClosedCaptions => "CLOSED-CAPTIONS"
  }
}

///|
fn part_s(tag : String, p : hls::PartialSegment) -> String {
  tag +
  "|" +
  qs(p.uri) +
  "|" +
  p.duration_us.to_string() +
  "|" +
  b01(p.independent) +
  "|" +
  br_s(p.byterange) +
  "|" +
  b01(p.gap) +
  "\n"
}

///| Structural dump of a parsed playlist (everything except the formatter line).
pub fn dump_playlist(p : hls::Playlist) -> String {
  let sb = StringBuilder::new()
  match p {
    hls::Playlist::Master(m) => {
      sb.write_string(
        "MASTER|" +
        ov(m.version) +
        "|" +
        b01(m.independent_segments) +
        "|" +
        start_s(m.start) +
        "\n",
      )
      defines_s(sb, m.defines)
      let mut i = 0
      while i < m.variants.length() {
        let v = m.variants[i]
        let cc = match v.closed_captions {
          Some(hls::ClosedCaptionsRef::None) => "NONE"
          Some(hls::ClosedCaptionsRef::GroupId(g)) => qs(g)
          None => "-"
        }
        sb.write_string(
          "V|" +
          qs(v.uri) +
          "|" +
          v.bandwidth.to_string() +
          "|" +
          oi(v.average_bandwidth) +
          "|" +
          os(v.codecs) +
          "|" +
          res_s(v.resolution) +
          "|" +
          oi(v.frame_rate_mhz) +
          "|" +
          hdcp_s(v.hdcp_level) +
          "|" +
          os(v.audio) +
          "|" +
          os(v.video) +
          "|" +
          os(v.subtitles) +
          "|" +
          cc +
          "|" +
          oi(v.score_micros) +
          "|" +
          os(v.pathway_id) +
          "\n",
        )
        i = i + 1
      }
      i = 0
      while i < m.iframe_streams.length() {
        let v = m.iframe_streams[i]
        sb.write_string(
          "I|" +
          qs(v.uri) +
          "|" +
          v.bandwidth.to_string() +
          "|" +
          oi(v.average_bandwidth) +
          "|" +
          os(v.codecs) +
          "|" +
          res_s(v.resolution) +
          "|" +
          hdcp_s(v.hdcp_level) +
          "|" +
          os(v.video) +
          "|" +
          oi(v.score_micros) +
          "|" +
          os(v.pathway_id) +
          "\n",
        )
        i = i + 1
      }
      i = 0
      while i < m.media.length() {
        let r = m.media[i]
        sb.write_string(
          "M|" +
          media_type_s(r.media_type) +
          "|" +
          qs(r.group_id) +
          "|" +
          qs(r.name) +
          "|" +
          os(r.uri) +
          "|" +
          os(r.language) +
          "|" +
          os(r.assoc_language) +
          "|" +
          b01(r.is_default) +
          "|" +
          b01(r.autoselect) +
          "|" +
          b01(r.forced) +
          "|" +
          os(r.instream_id) +
          "|" +
          os(r.characteristics) +
          "|" +
          os(r.channels) +
          "\n",
        )
        i = i + 1
      }
      i = 0
      while i < m.session_data.length() {
        let d = m.session_data[i]
        sb.write_string(
          "SD|" +
          qs(d.data_id) +
          "|" +
          os(d.value) +
          "|" +
          os(d.uri) +
          "|" +
          os(d.language) +
          "|" +
          os(d.format) +
          "\n",
        )
        i = i + 1
      }
      i = 0
      while i < m.session_keys.length() {
        sb.write_string("SK|" + key_s(m.session_keys[i]) + "\n")
        i = i + 1
      }
      custom_s(sb, m.custom_tags)
    }
    hls::Playlist::Media(m) => {
      let pt = match m.playlist_type {
        Some(hls::PlaylistType::Event) => "EVENT"
        Some(hls::PlaylistType::Vod) => "VOD"
        None => "-"
      }
      sb.write_string(
        "MEDIA|" +
        ov(m.version) +
        "|" +
        m.target_duration.to_string() +
        "|" +
        m.media_sequence.to_string() +
        "|" +
        m.discontinuity_sequence.to_string() +
        "|" +
        pt +
        "|" +
        b01(m.end_list) +
        "|" +
        b01(m.i_frames_only) +
        "|" +
        b01(m.independent_segments) +
        "|" +
        start_s(m.start) +
        "\n",
      )
      defines_s(sb, m.defines)
      match m.server_control {
        Some(sc) =>
        sb.write_string(
          "SC|" +
          oi(sc.can_skip_until_us) +
          "|" +
          b01(sc.can_skip_dateranges) +
          "|" +
          oi(sc.hold_back_us) +
          "|" +
          oi(sc.part_hold_back_us) +
          "|" +
          b01(sc.can_block_reload) +
          "\n",
        )
        None => ()
      }
      match m.part_inf {
        Some(pi) => sb.write_string("PI|" + pi.part_target_us.to_string() + "\n")
        None => ()
      }
      match m.skip {
        Some(sk) =>
        sb.write_string(
          "SKIP|" +
          sk.skipped_segments.to_string() +
          "|" +
          os(sk.recently_removed_dateranges) +
          "\n",
        )
        None => ()
      }
      let mut i = 0
      while i < m.segments.length() {
        let s = m.segments[i]
        sb.write_string(
          "S|" +
          qs(s.uri) +
          "|" +
          s.duration_us.to_string() +
          "|" +
          os(s.title) +
          "|" +
          br_s(s.byterange) +
          "|" +
          b01(s.discontinuity) +
          "|" +
          b01(s.gap) +
          "|" +
          os(s.program_date_time) +
          "|" +
          okey_s(s.key) +
          "|" +
          map_s(s.map) +
          "\n",
        )
        let mut j = 0
        while j < s.parts.length() {
          sb.write_string(part_s("P", s.parts[j]))
          j = j + 1
        }
        i = i + 1
      }
      i = 0
      while i < m.trailing_parts.length() {
        sb.write_string(part_s("TP", m.trailing_parts[i]))
        i = i + 1
      }
      i = 0
      while i < m.preload_hints.length() {
        let h = m.preload_hints[i]
        let ht = match h.hint_type {
          hls::PreloadHintType::Part => "PART"
          hls::PreloadHintType::Map => "MAP"
        }
        sb.write_string(
          "PH|" +
          ht +
          "|" +
          qs(h.uri) +
          "|" +
          oi(h.byterange_start) +
          "|" +
          oi(h.byterange_length) +
          "\n",
        )
        i = i + 1
      }
      i = 0
      while i < m.rendition_reports.length() {
        let r = m.rendition_reports[i]
        sb.write_string(
          "RR|" + qs(r.uri) + "|" + oi(r.last_msn) + "|" + oi(r.last_part) + "\n",
        )
        i = i + 1
      }
      i = 0
      while i < m.dateranges.length() {
        let d = m.dateranges[i]
        let xs = StringBuilder::new()
        let mut j = 0
        while j < d.client_attributes.length() {
          let a = d.client_attributes[j]
          if j > 0 {
            xs.write_string(",")
          }
          xs.write_string(esc(a.key) + "=" + b01(a.quoted) + qs(a.value))
          j = j + 1
        }
        sb.write_string(
          "DR|" +
          qs(d.id) +
          "|" +
          os(d.class_name) +
          "|" +
          qs(d.start_date) +
          "|" +
          os(d.end_date) +
          "|" +
          oi(d.duration_us) +
          "|" +
          oi(d.planned_duration_us) +
          "|" +
          b01(d.end_on_next) +
          "|" +
          os(d.scte35_cmd) +
          "|" +
          os(d.scte35_out) +
          "|" +
          os(d.scte35_in) +
          "|" +
          xs.to_string() +
          "\n",
        )
        i = i + 1
      }
      custom_s(sb, m.custom_tags)
      let rs = hls::resolve_media_sequence(m)
      i = 0
      while i < rs.length() {
        let r = rs[i]
        sb.write_string(
          "R|" +
          r.media_sequence.to_string() +
          "|" +
          r.discontinuity_sequence.to_string() +
          "|" +
          r.start_us.to_string() +
          "|" +
          r.end_us.to_string() +
          "|" +
          okey_s(r.key) +
          "|" +
          map_s(r.map) +
          "\n",
        )
        i = i + 1
      }
      sb.write_string(
        "TOT|" +
        hls::total_duration_us(m).to_string() +
        "|" +
        hls::total_duration_ms(m).to_string() +
        "\n",
      )
    }
  }
  sb.to_string()
}

///| Parse `input`, dump it, format it and check that the formatted text re-parses to the same dump.
pub fn dump_case(input : String) -> String {
  match hls::parse_playlist(input) {
    Err(e) => "ERR|" + err_kind(e) + "\n"
    Ok(p) => {
      let d = dump_playlist(p)
      let f = match hls::format_playlist(p) {
        Err(e) => "FMT|ERR " + err_kind(e)
        Ok(text) =>
        match hls::parse_playlist(text) {
          Err(e) => "FMT|ok|REPARSE ERR " + err_kind(e)
          Ok(p2) =>
          if dump_playlist(p2) == d {
            "FMT|ok|same"
          } else {
            "FMT|ok|differs"
          }
        }
      }
      d + f + "\n"
    }
  }
}
