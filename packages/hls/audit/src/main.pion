///| Red-team CLI for `packages/hls` (native + wasm32, see ../REPORT.md).
///|   dump <file>   -> one block per corpus line `<name>\t<hex>`: `=<name>` then the canonical dump (src/dump.pion)
///|   bomb <file>   -> parse the whole file once, print a one-line summary (DoS bombs, ../diff/dos.py)
///|   time <file> <iters> -> parse the whole file <iters> times, print `<us> <fnv>`
///|   api           -> extreme-value sweep of the public API (limits, select_variant, formatter)
///|   list | case <name> -> red-team / control cases (src/cases.pion)

import "hls"

///|
pub fn split_lines(data : String) -> Array[String] {
  let out : Array[String] = []
  let n = data.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if data.code_unit_at(i) == 10 {
      out.push(data.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(data.slice(start, n))
  }
  out
}

///|
pub fn run_dump(text : String) -> String {
  let lines = split_lines(text)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let l = lines[i]
    let mut t = 0
    while t < l.length() && l.code_unit_at(t) != 9 {
      t = t + 1
    }
    if t < l.length() {
      sb.write_string("=" + l.slice(0, t) + "\n")
      sb.write_string(dump_case(unhex(l.slice(t + 1, l.length()))))
    }
    i = i + 1
  }
  sb.to_string()
}

///| One-line summary of a parse (sizes of everything retained), used for DoS bombs.
pub fn bomb_summary(text : String) -> String {
  match hls::parse_playlist(text) {
    Err(e) => "ERR " + err_kind(e)
    Ok(hls::Playlist::Master(m)) => {
      let mut bytes = 0L
      let mut i = 0
      while i < m.variants.length() {
        bytes = bytes + m.variants[i].uri.length().to_int64()
        i = i + 1
      }
      "OK master variants=" +
      m.variants.length().to_string() +
      " defines=" +
      m.defines.length().to_string() +
      " uri_bytes=" +
      bytes.to_string()
    }
    Ok(hls::Playlist::Media(m)) => {
      let mut bytes = 0L
      let mut parts = m.trailing_parts.length()
      let mut i = 0
      while i < m.segments.length() {
        bytes = bytes + m.segments[i].uri.length().to_int64()
        parts = parts + m.segments[i].parts.length()
        let mut j = 0
        while j < m.segments[i].parts.length() {
          bytes = bytes + m.segments[i].parts[j].uri.length().to_int64()
          j = j + 1
        }
        i = i + 1
      }
      i = 0
      while i < m.trailing_parts.length() {
        bytes = bytes + m.trailing_parts[i].uri.length().to_int64()
        i = i + 1
      }
      "OK media segments=" +
      m.segments.length().to_string() +
      " parts=" +
      parts.to_string() +
      " dateranges=" +
      m.dateranges.length().to_string() +
      " defines=" +
      m.defines.length().to_string() +
      " uri_bytes=" +
      bytes.to_string()
    }
  }
}

///|
pub fn fnv(h : UInt64, s : String) -> UInt64 {
  let mut x = h
  let mut i = 0
  while i < s.length() {
    x = (x ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  x
}

///|
fn parse_uint(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  v
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: hls_audit dump|bomb <file> | time <file> <iters> | api | list | case <name>")
    return 2
  }
  let mode = args[1]
  if (mode == "dump" || mode == "bomb") && args.length() >= 3 {
    let text = match fs_read_bytes(world, args[2]) {
      Ok(b) => b.to_string()
      Err(_) => {
        io_eprintln(world, "cannot read " + args[2])
        return 2
      }
    }
    if mode == "dump" {
      io_print(world, run_dump(text))
    } else {
      io_println(world, bomb_summary(text))
    }
    return 0
  }
  if mode == "time" && args.length() >= 4 {
    let text = match fs_read_bytes(world, args[2]) {
      Ok(b) => b.to_string()
      Err(_) => return 2
    }
    let iters = parse_uint(args[3])
    let t0 = clock_monotonic_us()
    let mut h = 14695981039346656037UL
    let mut k = 0
    while k < iters {
      h = fnv(h, bomb_summary(text))
      k = k + 1
    }
    let t1 = clock_monotonic_us()
    io_println(world, (t1 - t0).to_string() + " " + h.to_string())
    return 0
  }
  if mode == "api" {
    io_print(world, run_api())
    return 0
  }
  if mode == "list" {
    io_println(world, case_names().join(" "))
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = run_case(args[2])
    io_println(world, (if r == "" { "PASS " } else { "FAIL " }) + args[2] + (if r == "" { "" } else { " :: " + r }))
    return 0
  }
  io_println(world, "bad arguments")
  2
}
