///| Red-team (`redteam_p<sev>_<n>_*`) and control (`control_*`) cases. Each returns "" on PASS, else the reason.
///|
///| Red-team cases assert the conforming behaviour and FAIL while the finding of the same id in REPORT.md is open.
///| They test behaviour only through the public API, accept every reasonable fix (reject the input, or produce a
///| correct value), and build values with record-update syntax from parsed playlists, so a fix that adds fields
///| to the public types does not break them. Control cases must PASS before and after any fix; the bug-injection
///| gate of run_audit.sh relies on them.

///|
fn H() -> String {
  "#EXTM3U\n"
}

///|
fn MH() -> String {
  "#EXTM3U\n#EXT-X-TARGETDURATION:10\n"
}

///|
fn SEG() -> String {
  "#EXTINF:4,\na.ts\n"
}

///|
fn rep(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn media_of(src : String) -> Option[hls::MediaPlaylist] {
  match hls::parse_playlist(src) {
    Ok(hls::Playlist::Media(m)) => Some(m)
    _ => None
  }
}

///|
fn master_of(src : String) -> Option[hls::MasterPlaylist] {
  match hls::parse_playlist(src) {
    Ok(hls::Playlist::Master(m)) => Some(m)
    _ => None
  }
}

///|
fn accepted(src : String) -> Bool {
  match hls::parse_playlist(src) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn short(s : String) -> String {
  esc(if s.length() > 60 { s.slice(0, 60) } else { s })
}

///|
fn contains(hay : String, needle : String) -> Bool {
  index_of(hay, needle) >= 0
}

///|
fn index_of(hay : String, needle : String) -> Int {
  let n = hay.length()
  let m = needle.length()
  let mut i = 0
  while i + m <= n {
    let mut k = 0
    while k < m && hay.code_unit_at(i + k) == needle.code_unit_at(k) {
      k = k + 1
    }
    if k == m {
      return i
    }
    i = i + 1
  }
  -1
}

///| Re-parse the formatter output of `p`; returns the dump or an error marker.
fn reformat(p : hls::Playlist) -> String {
  match hls::format_playlist(p) {
    Err(_) => "FMTERR"
    Ok(t) =>
    match hls::parse_playlist(t) {
      Err(e) => "REPARSE_ERR " + err_kind(e)
      Ok(p2) => dump_playlist(p2)
    }
  }
}

///|
fn fmt_text(p : hls::Playlist) -> String {
  match hls::format_playlist(p) {
    Err(_) => "FMTERR"
    Ok(t) => t
  }
}

// ---------------------------------------------------------------- P1

///| P1-1: decimal-floating-point values above Int64 microseconds wrap around (negative durations, sign flips).
fn p1_1() -> String {
  let big = "9223372036854.999999"
  let mut bad = ""
  match media_of(MH() + "#EXTINF:" + big + ",\na.ts\n") {
    Some(m) =>
    if m.segments[0].duration_us < 0L {
      bad = bad + " EXTINF=" + m.segments[0].duration_us.to_string()
    }
    None => ()
  }
  match master_of(H() + "#EXT-X-START:TIME-OFFSET=-" + big + "\n#EXT-X-STREAM-INF:BANDWIDTH=1\nv\n") {
    Some(m) =>
    match m.start {
      Some(s) =>
      if s.time_offset_us >= 0L {
        bad = bad + " TIME-OFFSET=" + s.time_offset_us.to_string()
      }
      None => ()
    }
    None => ()
  }
  match media_of(MH() + "#EXT-X-SERVER-CONTROL:HOLD-BACK=" + big + "\n" + SEG()) {
    Some(m) =>
    match m.server_control {
      Some(sc) =>
      match sc.hold_back_us {
        Some(v) => if v < 0L { bad = bad + " HOLD-BACK=" + v.to_string() }
        None => ()
      }
      None => ()
    }
    None => ()
  }
  match media_of(
    MH() +
    "#EXT-X-PART-INF:PART-TARGET=1\n#EXT-X-PART:DURATION=" +
    big +
    ",URI=\"p\"\n" +
    SEG(),
  ) {
    Some(m) =>
    if m.segments[0].parts.length() > 0 &&
    m.segments[0].parts[0].duration_us < 0L {
      bad = bad + " PART=" + m.segments[0].parts[0].duration_us.to_string()
    }
    None => ()
  }
  if bad == "" {
    ""
  } else {
    "accepted with wrapped value:" + bad
  }
}

///| P1-2: media sequence / timeline arithmetic wraps around Int64.
fn p1_2() -> String {
  let mut bad = ""
  match media_of(MH() + "#EXT-X-MEDIA-SEQUENCE:9223372036854775807\n" + SEG() + SEG()) {
    Some(m) => {
      let rs = hls::resolve_media_sequence(m)
      if rs.length() == 2 &&
      rs[1].media_sequence < rs[0].media_sequence {
        bad = bad + " msn " + rs[0].media_sequence.to_string() + " -> " + rs[1].media_sequence.to_string()
      }
    }
    None => ()
  }
  match media_of(
    H() + "#EXT-X-TARGETDURATION:9000000000000\n" + rep("#EXTINF:9000000000000,\na.ts\n", 2),
  ) {
    Some(m) => {
      let t = hls::total_duration_us(m)
      if t < 0L {
        bad = bad + " total_duration_us=" + t.to_string()
      }
      let rs = hls::resolve_media_sequence(m)
      if rs.length() == 2 && rs[1].end_us < rs[1].start_us {
        bad = bad + " end_us<start_us"
      }
    }
    None => ()
  }
  bad
}

///| P0-1: no aggregate bound on variable expansion: a ~80 KB playlist retains > 64 MiB (scales to GBs).
fn p0_1() -> String {
  let def = "#EXT-X-DEFINE:NAME=\"a\",VALUE=\"" + rep("x", 65000) + "\"\n"
  let mut bad = ""
  let srcs = [
    MH() + def + rep("#EXTINF:1,\n{$a}\n", 1100),
    MH() + "#EXT-X-PART-INF:PART-TARGET=1\n" + def + rep("#EXT-X-PART:DURATION=1,URI=\"{$a}\"\n", 1100),
  ]
  let mut k = 0
  while k < srcs.length() {
    let s = srcs[k]
    match media_of(s) {
      Some(m) => {
        let mut bytes = 0L
        let mut i = 0
        while i < m.segments.length() {
          bytes = bytes + m.segments[i].uri.length().to_int64()
          i = i + 1
        }
        i = 0
        while i < m.trailing_parts.length() {
          bytes = bytes + m.trailing_parts[i].uri.length().to_int64()
          i = i + 1
        }
        if bytes > 67108864L {
          bad = bad +
          " input " +
          s.length().to_string() +
          " B retained " +
          bytes.to_string() +
          " B;"
        }
      }
      None => ()
    }
    k = k + 1
  }
  bad
}

///| Parse time (best of 3, microseconds).
fn best_us(src : String) -> Int64 {
  let mut best = 9223372036854775807L
  let mut r = 0
  while r < 3 {
    let t0 = clock_monotonic_us()
    let _ = hls::parse_playlist(src)
    let t1 = clock_monotonic_us()
    if t1 - t0 < best {
      best = t1 - t0
    }
    r = r + 1
  }
  if best < 1L {
    1L
  } else {
    best
  }
}

///|
fn defines_input(n : Int) -> String {
  let sb = StringBuilder::new()
  sb.write_string(H())
  let mut i = 0
  while i < n {
    sb.write_string("#EXT-X-DEFINE:NAME=\"v" + i.to_string() + "\",VALUE=\"x\"\n")
    i = i + 1
  }
  let last = "{$v" + (n - 1).to_string() + "}"
  i = 0
  while i < n / 400 {
    sb.write_string("#EXT-X-STREAM-INF:BANDWIDTH=1\n" + rep(last, 400) + "\n")
    i = i + 1
  }
  sb.to_string()
}

///| P1-3: EXT-X-DEFINE declaration and lookup are linear scans: parse time grows quadratically with the number of
///| variables (13 MB / 7 MB inputs take 39 s / 24 s natively). Scale-free check: 4x the input must not cost > 8x
///| (and > 50 ms; a linear parser needs ~2 ms here natively).
fn p1_3() -> String {
  let a = best_us(defines_input(2000))
  let b = best_us(defines_input(8000))
  let ratio = b / a
  if ratio > 8L && b > 50000L {
    "4x variables cost " + ratio.to_string() + "x time (" + a.to_string() + " us -> " + b.to_string() + " us)"
  } else {
    ""
  }
}

///| P1-4: several EXT-X-KEY tags with different KEYFORMATs (multi-DRM) before one segment: all but the last are lost.
fn p1_4() -> String {
  let src = MH() +
  "#EXT-X-KEY:METHOD=SAMPLE-AES,URI=\"skd://fp\",KEYFORMAT=\"com.apple.streamingkeydelivery\"\n" +
  "#EXT-X-KEY:METHOD=SAMPLE-AES,URI=\"data:wv\",KEYFORMAT=\"urn:uuid:edef8ba9-79d6-4ace-a3c8-27dcd51d21ed\"\n" +
  SEG()
  match hls::parse_playlist(src) {
    Err(e) => "valid multi-KEYFORMAT playlist rejected: " + err_kind(e)
    Ok(p) => {
      let t = fmt_text(p)
      if contains(t, "skd://fp") && contains(t, "urn:uuid:edef8ba9") {
        ""
      } else {
        "keys retained: " + short(t)
      }
    }
  }
}

///| P1-5: EXT-X-SKIP is ignored when numbering segments (RFC 8216bis §4.4.5.2, §6.2.5.1).
fn p1_5() -> String {
  let src = H() +
  "#EXT-X-VERSION:9\n#EXT-X-TARGETDURATION:4\n#EXT-X-SERVER-CONTROL:CAN-SKIP-UNTIL=24\n" +
  "#EXT-X-MEDIA-SEQUENCE:100\n#EXT-X-SKIP:SKIPPED-SEGMENTS=10\n#EXTINF:4,\nx110.ts\n"
  match media_of(src) {
    None => "delta update rejected"
    Some(m) => {
      let rs = hls::resolve_media_sequence(m)
      if rs.length() == 1 && rs[0].media_sequence == 110L {
        ""
      } else {
        "first segment after SKIP numbered " + rs[0].media_sequence.to_string() + ", expected 110"
      }
    }
  }
}

///| Re-parse summary used by P1-6.
fn shape(p : hls::Playlist) -> String {
  match p {
    hls::Playlist::Master(m) =>
    "variants=" +
    m.variants.length().to_string() +
    " iframes=" +
    m.iframe_streams.length().to_string() +
    " media=" +
    m.media.length().to_string() +
    " session_keys=" +
    m.session_keys.length().to_string() +
    " session_data=" +
    m.session_data.length().to_string()
    hls::Playlist::Media(m) => {
      let mut ends = 0
      let mut i = 0
      while i < m.dateranges.length() {
        match m.dateranges[i].end_date {
          Some(_) => ends = ends + 1
          None => ()
        }
        i = i + 1
      }
      "segments=" +
      m.segments.length().to_string() +
      " endlist=" +
      b01(m.end_list) +
      " keys=" +
      (match m.segments[0].key {
        Some(_) => "1"
        None => "0"
      }) +
      " daterange_end_dates=" +
      ends.to_string()
    }
  }
}

///| `p` formats to text that re-parses into a structure different from `want` (tag / attribute injection).
fn injected(label : String, p : hls::Playlist, want : String) -> String {
  match hls::format_playlist(p) {
    Err(_) => ""
    Ok(t) =>
    match hls::parse_playlist(t) {
      Err(_) => ""
      Ok(p2) => {
        let got = shape(p2)
        if got == want {
          ""
        } else {
          " " + label + " -> " + got + ";"
        }
      }
    }
  }
}

///| P1-6: format_playlist writes CustomTag names/values and DATERANGE client-attribute names verbatim.
fn p1_6() -> String {
  let mut bad = ""
  let master = match master_of(H() + "#EXT-X-FOO:bar\n#EXT-X-STREAM-INF:BANDWIDTH=1\nv.m3u8\n") {
    Some(m) => m
    None => return "seed rejected"
  }
  let ct = master.custom_tags[0]
  let want_m = "variants=1 iframes=0 media=0 session_keys=0 session_data=0"
  let vs = [
    ("#EXT-X-I-FRAME-STREAM-INF", Some("BANDWIDTH=1,URI=\"https://evil.test/i.m3u8\"")),
    ("#EXT-X-SESSION-KEY:METHOD=AES-128,URI=\"https://evil.test/k\"", None),
    ("#EXT-X-MEDIA", Some("TYPE=AUDIO,GROUP-ID=\"g\",NAME=\"x\",URI=\"https://evil.test/a.m3u8\"")),
    ("#EXT-X-SESSION-DATA", Some("DATA-ID=\"com.evil\",VALUE=\"1\"")),
  ]
  let mut i = 0
  while i < vs.length() {
    let (n, v) = vs[i]
    let m2 = hls::MasterPlaylist::{
      ..master,
      custom_tags: [hls::CustomTag::{ ..ct, name: n, value: v }],
    }
    bad = bad + injected("custom tag " + n, hls::Playlist::Master(m2), want_m)
    i = i + 1
  }
  let media = match media_of(
    MH() +
    "#EXT-X-FOO\n#EXT-X-DATERANGE:ID=\"ad\",START-DATE=\"2026-01-01T00:00:00Z\",X-A=\"1\"\n" +
    SEG(),
  ) {
    Some(m) => m
    None => return "seed rejected"
  }
  let want_media = "segments=1 endlist=0 keys=0 daterange_end_dates=0"
  let mct = media.custom_tags[0]
  let m3 = hls::MediaPlaylist::{
    ..media,
    custom_tags: [hls::CustomTag::{ ..mct, name: "#EXT-X-ENDLIST", value: None }],
  }
  bad = bad + injected("custom tag #EXT-X-ENDLIST", hls::Playlist::Media(m3), want_media)
  let dr = media.dateranges[0]
  let x = dr.client_attributes[0]
  let dr2 = hls::DateRange::{
    ..dr,
    client_attributes: [
      hls::AttrPair::{ ..x, key: "END-DATE", value: "2030-01-01T00:00:00Z", quoted: true },
    ],
  }
  let m4 = hls::MediaPlaylist::{ ..media, dateranges: [dr2] }
  bad = bad + injected("DATERANGE client attribute END-DATE", hls::Playlist::Media(m4), want_media)
  bad
}

// ---------------------------------------------------------------- P2

///| P2-1: Variable Reference recognition (§4.3, §6.3.1).
fn p2_1() -> String {
  let mut bad = ""
  if accepted(H() + "#EXT-X-STREAM-INF:BANDWIDTH=1\n{$undef}.m3u8\n") {
    bad = bad + " undefined {$undef} accepted when the playlist has no EXT-X-DEFINE;"
  }
  if !accepted(
    H() +
    "#EXT-X-DEFINE:NAME=\"a\",VALUE=\"x\"\n#EXT-X-STREAM-INF:BANDWIDTH=1\nv.m3u8?q={$}\n",
  ) {
    bad = bad + " '{$}' (not a Variable Reference) rejected;"
  }
  bad
}

///| P2-2: quoted-string / hexadecimal-sequence values outside the package's list are not substituted.
fn p2_2() -> String {
  let src = H() +
  "#EXT-X-DEFINE:NAME=\"l\",VALUE=\"en\"\n" +
  "#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"a\",NAME=\"n\",LANGUAGE=\"{$l}\"\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=1,AUDIO=\"a\"\nv\n"
  match master_of(src) {
    None => "rejected"
    Some(m) =>
    match m.media[0].language {
      Some(l) => if l == "en" { "" } else { "LANGUAGE=" + esc(l) }
      None => "LANGUAGE missing"
    }
  }
}

///| P2-3: IMPORT is accepted in a Multivariant Playlist (MUST NOT occur there, §4.4.2.3).
fn p2_3() -> String {
  if accepted(H() + "#EXT-X-DEFINE:IMPORT=\"token\"\n#EXT-X-STREAM-INF:BANDWIDTH=1\nv\n") {
    "IMPORT accepted in a Multivariant Playlist"
  } else {
    ""
  }
}

///| P2-4: formatter output re-expands variable values on re-parse.
fn p2_4() -> String {
  let src = H() +
  "#EXT-X-DEFINE:NAME=\"b\",VALUE=\"evil\"\n#EXT-X-DEFINE:NAME=\"a\",VALUE=\"{$b}\"\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=1\n{$a}.m3u8\n"
  match hls::parse_playlist(src) {
    Err(_) => "rejected"
    Ok(p) => {
      let d = core_lines(dump_playlist(p))
      let r = reformat(p)
      if core_lines(r) == d || r == "FMTERR" {
        ""
      } else {
        "variant URI changes on re-parse: " + short(r)
      }
    }
  }
}

///| P2-5: format_playlist returns Ok for text it cannot parse back.
fn p2_5() -> String {
  let mut bad = ""
  match media_of(MH() + SEG()) {
    Some(m) => {
      let s = m.segments[0]
      let m1 = hls::MediaPlaylist::{
        ..m,
        segments: [hls::MediaSegment::{ ..s, uri: "#EXT-X-ENDLIST" }],
      }
      let r1 = reformat(hls::Playlist::Media(m1))
      if contains(r1, "REPARSE_ERR") {
        bad = bad + " URI '#EXT-X-ENDLIST';"
      }
      let m2 = hls::MediaPlaylist::{ ..m, media_sequence: -5L }
      if contains(reformat(hls::Playlist::Media(m2)), "REPARSE_ERR") {
        bad = bad + " MEDIA-SEQUENCE -5;"
      }
      let m3 = hls::MediaPlaylist::{
        ..m,
        segments: [hls::MediaSegment::{ ..s, duration_us: -1L }],
      }
      if contains(reformat(hls::Playlist::Media(m3)), "REPARSE_ERR") {
        bad = bad + " EXTINF -1 us;"
      }
    }
    None => bad = "seed rejected"
  }
  bad
}

///| P2-6: positional information is lost: unknown tags move after the last segment, KEY/MAP order is inverted.
fn p2_6() -> String {
  let mut bad = ""
  match hls::parse_playlist(
    MH() + SEG() + "#EXT-X-CUE-OUT:30\n#EXTINF:4,\nb.ts\n#EXT-X-CUE-IN\n#EXTINF:4,\nc.ts\n",
  ) {
    Ok(p) => {
      let t = fmt_text(p)
      let cue = index_of(t, "#EXT-X-CUE-OUT")
      if cue < 0 || cue > index_of(t, "\nb.ts") {
        bad = bad + " #EXT-X-CUE-OUT no longer precedes b.ts;"
      }
    }
    Err(_) => bad = bad + " cue playlist rejected;"
  }
  match hls::parse_playlist(
    MH() + "#EXT-X-KEY:METHOD=AES-128,URI=\"k\"\n#EXT-X-MAP:URI=\"init.mp4\"\n" + SEG(),
  ) {
    Ok(p) => {
      let t = fmt_text(p)
      if index_of(t, "#EXT-X-KEY") > index_of(t, "#EXT-X-MAP") {
        bad = bad + " EXT-X-MAP (encrypted by the KEY before it) is written before the KEY;"
      }
    }
    Err(_) => bad = bad + " key/map playlist rejected;"
  }
  // re-audit of 58a5430b: an unknown tag before the *first* segment must keep its position too
  match hls::parse_playlist(
    MH() + "#EXT-X-CUE-OUT:30\n" + SEG() + "#EXTINF:4,\nb.ts\n#EXT-X-CUE-IN\n#EXTINF:4,\nc.ts\n",
  ) {
    Ok(p) => {
      let t = fmt_text(p)
      if t != "FMTERR" {
        let cue = index_of(t, "#EXT-X-CUE-OUT")
        if cue < 0 || cue > index_of(t, "\na.ts") {
          bad = bad + " #EXT-X-CUE-OUT before the first segment moved after it;"
        }
      }
    }
    Err(_) => bad = bad + " cue-first playlist rejected;"
  }
  // KEY k1, MAP, KEY k2: the MAP is encrypted with k1 only, so k2 must stay after the MAP
  match hls::parse_playlist(
    MH() +
    "#EXT-X-KEY:METHOD=AES-128,URI=\"k1\"\n#EXT-X-MAP:URI=\"init.mp4\"\n#EXT-X-KEY:METHOD=AES-128,URI=\"k2\"\n" +
    SEG(),
  ) {
    Ok(p) => {
      let t = fmt_text(p)
      if t != "FMTERR" &&
      index_of(t, "URI=\"k2\"") >= 0 &&
      index_of(t, "URI=\"k2\"") < index_of(t, "#EXT-X-MAP") {
        bad = bad + " KEY k2 (after the MAP) is written before the MAP;"
      }
    }
    Err(_) => bad = bad + " key/map/key playlist rejected;"
  }
  bad
}

///| P2-7: MUST-level cross-tag constraints and singleton rules are not validated.
fn p2_7() -> String {
  let ll = H() + "#EXT-X-TARGETDURATION:4\n#EXT-X-PART-INF:PART-TARGET=0.5\n"
  let srcs = [
    ("EXTINF > TARGETDURATION", MH() + "#EXTINF:12.5,\na.ts\n"),
    ("duplicate EXT-X-ENDLIST", MH() + SEG() + "#EXT-X-ENDLIST\n#EXT-X-ENDLIST\n"),
    ("duplicate EXT-X-SKIP", MH() + "#EXT-X-SKIP:SKIPPED-SEGMENTS=1\n#EXT-X-SKIP:SKIPPED-SEGMENTS=2\n" + SEG()),
    (
      "duplicate EXT-X-INDEPENDENT-SEGMENTS",
      H() + "#EXT-X-INDEPENDENT-SEGMENTS\n#EXT-X-INDEPENDENT-SEGMENTS\n#EXT-X-STREAM-INF:BANDWIDTH=1\nv\n",
    ),
    ("MEDIA-SEQUENCE after a segment", MH() + SEG() + "#EXT-X-MEDIA-SEQUENCE:5\n" + SEG()),
    ("AUDIO group without EXT-X-MEDIA", H() + "#EXT-X-STREAM-INF:BANDWIDTH=1,AUDIO=\"nope\"\nv\n"),
    ("PART-INF without PART-HOLD-BACK", ll + "#EXTINF:1,\na.ts\n"),
    (
      "FORCED on an AUDIO rendition",
      H() +
      "#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"a\",NAME=\"n\",FORCED=NO\n#EXT-X-STREAM-INF:BANDWIDTH=1,AUDIO=\"a\"\nv\n",
    ),
    (
      "END-ON-NEXT with DURATION",
      MH() +
      "#EXT-X-DATERANGE:ID=\"a\",CLASS=\"c\",START-DATE=\"2026-01-01T00:00:00Z\",END-ON-NEXT=YES,DURATION=1\n" +
      SEG(),
    ),
  ]
  let mut bad = ""
  let mut i = 0
  while i < srcs.length() {
    let (label, s) = srcs[i]
    if accepted(s) {
      bad = bad + " " + label + ";"
    }
    i = i + 1
  }
  if bad == "" {
    ""
  } else {
    "accepted:" + bad
  }
}

///| P2-8: METHOD=NONE with other attributes, EXT-X-MAP BYTERANGE without the REQUIRED offset.
fn p2_8() -> String {
  let mut bad = ""
  if accepted(MH() + "#EXT-X-KEY:METHOD=NONE,URI=\"k\"\n" + SEG()) {
    bad = bad + " METHOD=NONE,URI accepted;"
  }
  if accepted(MH() + "#EXT-X-MAP:URI=\"init.mp4\",BYTERANGE=\"720\"\n" + SEG()) {
    bad = bad + " MAP BYTERANGE without offset accepted;"
  }
  bad
}

///| P2-9: ISO 8601 date-times without a zone designator or with a basic-format offset fail the whole playlist.
fn p2_9() -> String {
  let mut bad = ""
  let vs = ["2010-02-19T14:54:23.031", "2010-02-19T14:54:23.031+0000"]
  let mut i = 0
  while i < vs.length() {
    if !accepted(MH() + "#EXT-X-PROGRAM-DATE-TIME:" + vs[i] + "\n" + SEG()) {
      bad = bad + " " + vs[i] + " rejected;"
    }
    i = i + 1
  }
  bad
}

///| P2-10: lexical / value-type rules of §4.1-§4.2 only partly enforced.
fn p2_10() -> String {
  let mut bad = ""
  if accepted(MH() + "#EXTINF:4,a\x1b[31m\na.ts\n") {
    bad = bad + " ESC control character accepted;"
  }
  if accepted(MH() + "#EXTINF:4,\na.ts\r") {
    bad = bad + " CR without LF at EOF accepted;"
  }
  if accepted(
    H() +
    "#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"a\",NAME=\"n\",DEFAULT=\"YES\"\n#EXT-X-STREAM-INF:BANDWIDTH=1,AUDIO=\"a\"\nv\n",
  ) {
    bad = bad + " quoted enumerated-string DEFAULT=\"YES\" accepted;"
  }
  match hls::parse_playlist(H() + "#EXT-X-STREAM-INF:BANDWIDTH=1,HDCP-LEVEL=A=B\nv\n") {
    Ok(p) =>
    if reformat(p) == "FMTERR" {
      bad = bad + " HDCP-LEVEL=A=B accepted but cannot be formatted;"
    }
    Err(_) => ()
  }
  bad
}

///| P2-11: an EXT-X-PART BYTERANGE without offset is not resolved (§4.4.4.9).
fn p2_11() -> String {
  let src = H() +
  "#EXT-X-TARGETDURATION:4\n#EXT-X-SERVER-CONTROL:PART-HOLD-BACK=1\n#EXT-X-PART-INF:PART-TARGET=0.5\n" +
  "#EXT-X-PART:DURATION=0.5,URI=\"s.mp4\",BYTERANGE=\"100@0\"\n#EXT-X-PART:DURATION=0.5,URI=\"s.mp4\",BYTERANGE=\"100\"\n" +
  "#EXTINF:1,\ns.mp4\n"
  let first = match media_of(src) {
    None => "rejected"
    Some(m) =>
    match m.segments[0].parts[1].byterange {
      Some(b) =>
      match b.offset {
        Some(o) => if o == 100L { "" } else { "offset " + o.to_string() }
        None => "second part offset left unresolved (None), expected 100"
      }
      None => "byterange lost"
    }
  }
  // re-audit of 58a5430b: the chain is per Parent Segment, so the first part of the next segment has no
  // previous part to continue from and must not inherit the previous segment's last part offset
  let cross = H() +
  "#EXT-X-TARGETDURATION:4\n#EXT-X-SERVER-CONTROL:PART-HOLD-BACK=1\n#EXT-X-PART-INF:PART-TARGET=0.5\n" +
  "#EXT-X-PART:DURATION=0.5,URI=\"s.mp4\",BYTERANGE=\"100@0\"\n#EXTINF:1,\ns1.mp4\n" +
  "#EXT-X-PART:DURATION=0.5,URI=\"s.mp4\",BYTERANGE=\"100\"\n#EXTINF:1,\ns2.mp4\n"
  let second = if accepted(cross) {
    " first part of a new Parent Segment chained to the previous segment's part;"
  } else {
    ""
  }
  first + second
}

///| P2-14 (re-audit of 58a5430b): parse_playlist_with_context does not validate IMPORT / QUERYPARAM values;
///| bis §4.4.2.3: the decoded value MUST NOT contain characters disallowed in quoted-strings (LF, CR, '"').
fn p2_14() -> String {
  let mut bad = ""
  match hls::parse_playlist_with_context(
    MH() + "#EXT-X-DEFINE:QUERYPARAM=\"t\"\n#EXTINF:4,\na.ts?t={$t}\n",
    hls::HlsLimits::default(),
    [],
    [("t", "x\n#EXT-X-ENDLIST")],
  ) {
    Ok(_) => bad = bad + " QUERYPARAM value with LF accepted into a segment URI;"
    Err(_) => ()
  }
  match hls::parse_playlist_with_context(
    MH() + "#EXT-X-DEFINE:IMPORT=\"t\"\n#EXT-X-KEY:METHOD=AES-128,URI=\"{$t}\"\n" + SEG(),
    hls::HlsLimits::default(),
    [("t", "k\",IV=0x1")],
    [],
  ) {
    Ok(_) => bad = bad + " IMPORT value with '\"' accepted into a quoted KEY URI;"
    Err(_) => ()
  }
  bad
}

// ---------------------------------------------------------------- controls

///|
fn control_dup_attr() -> String {
  if accepted(H() + "#EXT-X-STREAM-INF:BANDWIDTH=1,BANDWIDTH=2\nv\n") {
    "duplicate AttributeName accepted"
  } else if accepted(MH() + "#EXT-X-KEY:METHOD=AES-128,URI=\"a\",URI=\"b\"\n" + SEG()) {
    "duplicate URI accepted"
  } else {
    ""
  }
}

///|
fn control_byterange() -> String {
  let chain = MH() +
  "#EXTINF:4,\n#EXT-X-BYTERANGE:100@50\nb.mp4\n#EXTINF:4,\n#EXT-X-BYTERANGE:200\nb.mp4\n#EXTINF:4,\n#EXT-X-BYTERANGE:300\nb.mp4\n"
  let mut bad = ""
  match media_of(chain) {
    Some(m) => {
      let mut offs = ""
      let mut i = 0
      while i < m.segments.length() {
        offs = offs +
        (match m.segments[i].byterange {
          Some(b) => oi(b.offset)
          None => "x"
        }) +
        " "
        i = i + 1
      }
      if offs != "50 150 350 " {
        bad = bad + " implicit chain offsets " + offs + ";"
      }
    }
    None => bad = bad + " implicit chain rejected;"
  }
  if accepted(
    MH() +
    "#EXTINF:4,\n#EXT-X-BYTERANGE:100@0\na.mp4\n#EXTINF:4,\n#EXT-X-BYTERANGE:100@0\nb.mp4\n#EXTINF:4,\n#EXT-X-BYTERANGE:100\na.mp4\n",
  ) {
    bad = bad + " implicit offset after a different URI accepted;"
  }
  if accepted(MH() + "#EXTINF:4,\n#EXT-X-BYTERANGE:100\nb.mp4\n") {
    bad = bad + " implicit offset on the first segment accepted;"
  }
  if accepted(MH() + "#EXTINF:4,\n#EXT-X-BYTERANGE:2@9223372036854775806\nb.mp4\n") {
    bad = bad + " offset+length overflow accepted;"
  }
  bad
}

///|
fn control_format_guards() -> String {
  let mut bad = ""
  match media_of(MH() + "#EXT-X-KEY:METHOD=AES-128,URI=\"k\"\n" + SEG()) {
    Some(m) => {
      let s = m.segments[0]
      let k = match s.key {
        Some(k) => k
        None => return "key lost"
      }
      let vs = [
        hls::MediaSegment::{ ..s, title: Some("x\n#EXT-X-ENDLIST") },
        hls::MediaSegment::{ ..s, uri: "a.ts\r\n#EXT-X-ENDLIST" },
        hls::MediaSegment::{ ..s, key: Some(hls::EncryptionKey::{ ..k, uri: Some("k\",IV=0x1") }) },
        hls::MediaSegment::{ ..s, key: Some(hls::EncryptionKey::{ ..k, uri: Some("k\nx") }) },
        hls::MediaSegment::{ ..s, uri: "a\x00.ts" },
      ]
      let mut i = 0
      while i < vs.length() {
        match hls::format_playlist(hls::Playlist::Media(hls::MediaPlaylist::{ ..m, segments: [vs[i]] })) {
          Ok(t) => bad = bad + " vector " + i.to_string() + " formatted: " + short(t) + ";"
          Err(_) => ()
        }
        i = i + 1
      }
    }
    None => bad = "seed rejected"
  }
  bad
}

///|
fn control_dates() -> String {
  let ok = ["2000-02-29T00:00:00Z", "2024-02-29T00:00:00.5+08:00", "2016-12-31T23:59:60Z"]
  let ko = [
    "1900-02-29T00:00:00Z", "2025-02-29T00:00:00Z", "2026-13-01T00:00:00Z", "2026-01-01T24:00:00Z",
    "2026-01-01T00:00:00+25:00", "2026-04-31T00:00:00Z",
  ]
  let mut bad = ""
  let mut i = 0
  while i < ok.length() {
    if !accepted(MH() + "#EXT-X-PROGRAM-DATE-TIME:" + ok[i] + "\n" + SEG()) {
      bad = bad + " rejected " + ok[i] + ";"
    }
    i = i + 1
  }
  i = 0
  while i < ko.length() {
    if accepted(MH() + "#EXT-X-PROGRAM-DATE-TIME:" + ko[i] + "\n" + SEG()) {
      bad = bad + " accepted " + ko[i] + ";"
    }
    i = i + 1
  }
  bad
}

///|
fn control_select_variant() -> String {
  let src = H() +
  "#EXT-X-STREAM-INF:BANDWIDTH=1000,CODECS=\"avc1.64001f,mp4a.40.2\"\nlow\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=5000,CODECS=\"hvc1.1.6.L120.90,mp4a.40.2\"\nhigh\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=3000,CODECS=\"avc1.640028\"\nmid\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=3000,CODECS=\"avc1.640028\",SCORE=2\nmid2\n"
  let m = match master_of(src) {
    Some(m) => m
    None => return "seed rejected"
  }
  let pick = fn(bw : Int64, pref : Array[String]) -> String {
    match hls::select_variant(m, bw, pref) {
      Some(v) => v.uri
      None => "none"
    }
  }
  let mut bad = ""
  let checks = [
    (pick(10000L, ["avc"]), "high"),
    (pick(10000L, ["avc1"]), "mid2"),
    (pick(10000L, ["hvc1"]), "high"),
    (pick(2000L, ["mp4a"]), "low"),
    (pick(10000L, ["avc1.640028"]), "mid2"),
    (pick(500L, []), "none"),
    (pick(-1L, []), "none"),
    (pick(4000L, []), "mid2"),
  ]
  let mut i = 0
  while i < checks.length() {
    let (got, want) = checks[i]
    if got != want {
      bad = bad + " check " + i.to_string() + " got " + got + " want " + want + ";"
    }
    i = i + 1
  }
  bad
}

///|
fn control_structure() -> String {
  let mut bad = ""
  if accepted(H() + "#EXT-X-STREAM-INF:BANDWIDTH=1\nv\n#EXT-X-TARGETDURATION:10\n") {
    bad = bad + " mixed master/media accepted;"
  }
  if accepted(MH() + SEG() + "#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"a\",NAME=\"n\"\n") {
    bad = bad + " EXT-X-MEDIA in media playlist accepted;"
  }
  match master_of(H() + "#EXT-X-I-FRAME-STREAM-INF:BANDWIDTH=1,URI=\"i.m3u8\"\n#EXT-X-STREAM-INF:BANDWIDTH=2\nv.m3u8\n") {
    Some(m) =>
    if m.variants.length() != 1 ||
    m.iframe_streams.length() != 1 ||
    m.variants[0].uri != "v.m3u8" {
      bad = bad + " I-FRAME-STREAM-INF consumed a line;"
    }
    None => bad = bad + " iframe playlist rejected;"
  }
  if accepted(H() + "#EXT-X-STREAM-INF:BANDWIDTH=1\n") {
    bad = bad + " dangling STREAM-INF accepted;"
  }
  if accepted(MH() + "#EXTINF:4,\n") {
    bad = bad + " dangling EXTINF accepted;"
  }
  if accepted("#EXT-X-TARGETDURATION:10\n" + SEG()) {
    bad = bad + " missing #EXTM3U accepted;"
  }
  if accepted(MH() + "#EXTINF:4,\ra.ts\n") || accepted(MH() + "#EXTINF:4,\na\x00.ts\n") {
    bad = bad + " bare CR / NUL accepted;"
  }
  if !accepted("\xEF\xBB\xBF#EXTM3U\r\n#EXT-X-TARGETDURATION:10\r\n#EXTINF:4,\r\na.ts\r\n") {
    bad = bad + " BOM + CRLF playlist rejected;"
  }
  if accepted(MH() + "#EXTINF:-1,\na.ts\n") || accepted(MH() + "#EXTINF:NaN,\na.ts\n") {
    bad = bad + " negative / NaN EXTINF accepted;"
  }
  bad
}

///|
fn control_resolve() -> String {
  let src = MH() +
  "#EXT-X-MEDIA-SEQUENCE:7\n#EXT-X-DISCONTINUITY-SEQUENCE:3\n#EXT-X-MAP:URI=\"i1\"\n" +
  "#EXT-X-KEY:METHOD=AES-128,URI=\"k1\"\n#EXTINF:4,\na\n#EXT-X-DISCONTINUITY\n#EXTINF:4.5,\nb\n" +
  "#EXT-X-KEY:METHOD=NONE\n#EXT-X-MAP:URI=\"i2\"\n#EXTINF:1.25,\nc\n"
  match media_of(src) {
    None => "rejected"
    Some(m) => {
      let rs = hls::resolve_media_sequence(m)
      let sb = StringBuilder::new()
      let mut i = 0
      while i < rs.length() {
        let r = rs[i]
        sb.write_string(
          r.media_sequence.to_string() +
          "/" +
          r.discontinuity_sequence.to_string() +
          "/" +
          r.start_us.to_string() +
          "/" +
          r.end_us.to_string() +
          "/" +
          (match r.key {
            Some(k) => os(k.uri)
            None => "-"
          }) +
          "/" +
          (match r.map {
            Some(mp) => mp.uri
            None => "-"
          }) +
          " ",
        )
        i = i + 1
      }
      let got = sb.to_string() + hls::total_duration_ms(m).to_string()
      let want = "7/3/0/4000000/\"k1/i1 8/4/4000000/8500000/\"k1/i1 9/4/8500000/9750000/-/i2 9750"
      if got == want {
        ""
      } else {
        got
      }
    }
  }
}

///|
fn control_limits() -> String {
  let d = hls::HlsLimits::default()
  let mut bad = ""
  let neg = [
    hls::HlsLimits::{ ..d, max_input_bytes: -1 },
    hls::HlsLimits::{ ..d, max_lines: -1 },
    hls::HlsLimits::{ ..d, max_segments: -1 },
    hls::HlsLimits::{ ..d, max_variants: -1 },
    hls::HlsLimits::{ ..d, max_attributes: -1 },
    hls::HlsLimits::{ ..d, max_line_bytes: -1 },
    hls::HlsLimits::{ ..d, max_custom_tags: -1 },
  ]
  let mut i = 0
  while i < neg.length() {
    match hls::parse_playlist_with_limits(MH() + SEG(), neg[i]) {
      Ok(_) => bad = bad + " negative limit " + i.to_string() + " accepted;"
      Err(_) => ()
    }
    i = i + 1
  }
  let zero = [
    hls::HlsLimits::{ ..d, max_segments: 0 },
    hls::HlsLimits::{ ..d, max_custom_tags: 0 },
    hls::HlsLimits::{ ..d, max_lines: 2 },
    hls::HlsLimits::{ ..d, max_input_bytes: 10 },
    hls::HlsLimits::{ ..d, max_line_bytes: 8 },
  ]
  i = 0
  while i < zero.length() {
    match hls::parse_playlist_with_limits(MH() + "#EXT-X-FOO\n" + SEG(), zero[i]) {
      Ok(_) => bad = bad + " limit " + i.to_string() + " not enforced;"
      Err(_) => ()
    }
    i = i + 1
  }
  match hls::parse_playlist_with_limits(
    H() + "#EXT-X-STREAM-INF:BANDWIDTH=1\nv\n",
    hls::HlsLimits::{ ..d, max_variants: 0 },
  ) {
    Ok(_) => bad = bad + " max_variants=0 not enforced;"
    Err(_) => ()
  }
  match hls::parse_playlist_with_limits(
    H() + "#EXT-X-STREAM-INF:BANDWIDTH=1,CODECS=\"a\"\nv\n",
    hls::HlsLimits::{ ..d, max_attributes: 1 },
  ) {
    Ok(_) => bad = bad + " max_attributes=1 not enforced;"
    Err(_) => ()
  }
  bad
}

///| The dump without its DEF and CT lines.
fn core_lines(d : String) -> String {
  let sb = StringBuilder::new()
  let ls = split_lines(d)
  let mut i = 0
  while i < ls.length() {
    let l = ls[i]
    if !(l.length() >= 4 && (l.slice(0, 4) == "DEF|" || l.slice(0, 3) == "CT|")) {
      sb.write_string(l + "\n")
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn control_roundtrip() -> String {
  let srcs = [
    H() +
    "#EXT-X-VERSION:7\n#EXT-X-INDEPENDENT-SEGMENTS\n#EXT-X-START:TIME-OFFSET=-6.25,PRECISE=YES\n" +
    "#EXT-X-DEFINE:NAME=\"cdn\",VALUE=\"https://edge.example.org\"\n" +
    "#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"aac\",NAME=\"English\",LANGUAGE=\"en\",DEFAULT=YES,AUTOSELECT=YES,URI=\"{$cdn}/a.m3u8\"\n" +
    "#EXT-X-STREAM-INF:BANDWIDTH=1500000,AVERAGE-BANDWIDTH=1200000,CODECS=\"avc1.64001f,mp4a.40.2\",RESOLUTION=1280x720,FRAME-RATE=29.970,AUDIO=\"aac\",CLOSED-CAPTIONS=NONE\n" +
    "{$cdn}/720p.m3u8\n" +
    "#EXT-X-I-FRAME-STREAM-INF:BANDWIDTH=240000,RESOLUTION=1280x720,URI=\"720p_i.m3u8\"\n" +
    "#EXT-X-SESSION-DATA:DATA-ID=\"com.example.title\",VALUE=\"Movie\",LANGUAGE=\"en\"\n" +
    "#EXT-X-SESSION-KEY:METHOD=SAMPLE-AES,URI=\"skd://k\",KEYFORMAT=\"com.apple.streamingkeydelivery\"\n",
    H() +
    "#EXT-X-VERSION:9\n#EXT-X-TARGETDURATION:6\n#EXT-X-MEDIA-SEQUENCE:42\n#EXT-X-DISCONTINUITY-SEQUENCE:2\n" +
    "#EXT-X-SERVER-CONTROL:CAN-SKIP-UNTIL=36.0,PART-HOLD-BACK=1.002,CAN-BLOCK-RELOAD=YES\n#EXT-X-PART-INF:PART-TARGET=0.334\n" +
    "#EXT-X-MAP:URI=\"init.mp4\",BYTERANGE=\"720@0\"\n#EXT-X-KEY:METHOD=AES-128,URI=\"key.bin\",IV=0x0000000000000000000000000000002a\n" +
    "#EXT-X-PROGRAM-DATE-TIME:2026-11-24T08:00:00.000Z\n#EXT-X-PART:DURATION=0.334,URI=\"seg42.0.m4s\",INDEPENDENT=YES\n" +
    "#EXTINF:6.006,First\n#EXT-X-BYTERANGE:1024@720\nstream.mp4\n#EXTINF:5.5,\n#EXT-X-BYTERANGE:2048\nstream.mp4\n" +
    "#EXT-X-DISCONTINUITY\n#EXT-X-KEY:METHOD=NONE\n#EXT-X-GAP\n#EXTINF:4.0,\nad.mp4\n" +
    "#EXT-X-PART:DURATION=0.334,URI=\"next.0.m4s\"\n#EXT-X-PRELOAD-HINT:TYPE=PART,URI=\"next.1.m4s\"\n" +
    "#EXT-X-RENDITION-REPORT:URI=\"../alt.m3u8\",LAST-MSN=44,LAST-PART=1\n" +
    "#EXT-X-DATERANGE:ID=\"ad\",CLASS=\"c\",START-DATE=\"2026-11-24T08:00:00Z\",DURATION=30,X-AD=\"1\",SCTE35-OUT=0xFC30\n" +
    "#EXT-X-FOO:bar\n",
  ]
  let mut bad = ""
  let mut i = 0
  while i < srcs.length() {
    match hls::parse_playlist(srcs[i]) {
      Ok(p) => {
        // DEF / CT lines are left out: fixes of P2-4 (DEFINEs next to expanded values) and P2-6 (unknown tags
        // kept per segment) may legitimately change them
        let d = core_lines(dump_playlist(p))
        let r = core_lines(reformat(p))
        if r != d {
          bad = bad + " playlist " + i.to_string() + " round trip: " + short(r) + ";"
        }
      }
      Err(e) => bad = bad + " playlist " + i.to_string() + " rejected: " + err_kind(e) + ";"
    }
    i = i + 1
  }
  bad
}

///|
pub fn case_names() -> Array[String] {
  [
    "redteam_p1_1_decimal_wrap", "redteam_p1_2_sequence_timeline_wrap", "redteam_p0_1_expansion_amplification",
    "redteam_p1_3_define_quadratic", "redteam_p1_4_multi_keyformat", "redteam_p1_5_skip_msn", "redteam_p1_6_format_injection",
    "redteam_p2_1_varref_recognition", "redteam_p2_2_substitution_scope", "redteam_p2_3_import_multivariant",
    "redteam_p2_4_format_reexpands", "redteam_p2_5_format_ok_unparsable", "redteam_p2_6_position_lost",
    "redteam_p2_7_cross_tag_constraints", "redteam_p2_8_none_attrs_map_offset", "redteam_p2_9_iso8601_zone",
    "redteam_p2_10_lexical_types", "redteam_p2_11_part_implicit_offset", "redteam_p2_14_context_values", "control_dup_attr", "control_byterange",
    "control_format_guards", "control_dates", "control_select_variant", "control_structure", "control_resolve",
    "control_limits", "control_roundtrip",
  ]
}

///|
pub fn run_case(name : String) -> String {
  if name == "redteam_p1_1_decimal_wrap" {
    p1_1()
  } else if name == "redteam_p1_2_sequence_timeline_wrap" {
    p1_2()
  } else if name == "redteam_p0_1_expansion_amplification" {
    p0_1()
  } else if name == "redteam_p1_3_define_quadratic" {
    p1_3()
  } else if name == "redteam_p1_4_multi_keyformat" {
    p1_4()
  } else if name == "redteam_p1_5_skip_msn" {
    p1_5()
  } else if name == "redteam_p1_6_format_injection" {
    p1_6()
  } else if name == "redteam_p2_1_varref_recognition" {
    p2_1()
  } else if name == "redteam_p2_2_substitution_scope" {
    p2_2()
  } else if name == "redteam_p2_3_import_multivariant" {
    p2_3()
  } else if name == "redteam_p2_4_format_reexpands" {
    p2_4()
  } else if name == "redteam_p2_5_format_ok_unparsable" {
    p2_5()
  } else if name == "redteam_p2_6_position_lost" {
    p2_6()
  } else if name == "redteam_p2_7_cross_tag_constraints" {
    p2_7()
  } else if name == "redteam_p2_8_none_attrs_map_offset" {
    p2_8()
  } else if name == "redteam_p2_9_iso8601_zone" {
    p2_9()
  } else if name == "redteam_p2_10_lexical_types" {
    p2_10()
  } else if name == "redteam_p2_11_part_implicit_offset" {
    p2_11()
  } else if name == "redteam_p2_14_context_values" {
    p2_14()
  } else if name == "control_dup_attr" {
    control_dup_attr()
  } else if name == "control_byterange" {
    control_byterange()
  } else if name == "control_format_guards" {
    control_format_guards()
  } else if name == "control_dates" {
    control_dates()
  } else if name == "control_select_variant" {
    control_select_variant()
  } else if name == "control_structure" {
    control_structure()
  } else if name == "control_resolve" {
    control_resolve()
  } else if name == "control_limits" {
    control_limits()
  } else if name == "control_roundtrip" {
    control_roundtrip()
  } else {
    "unknown case " + name
  }
}

///| Extreme-value sweep of the public API; output must be byte-identical in all 4 build modes.
pub fn run_api() -> String {
  let sb = StringBuilder::new()
  let d = hls::HlsLimits::default()
  let lims = [
    ("default", d),
    ("zero_all", hls::HlsLimits::{ ..d, max_input_bytes: 0, max_lines: 0, max_segments: 0, max_variants: 0, max_attributes: 0, max_line_bytes: 0, max_custom_tags: 0 }),
    ("i32max", hls::HlsLimits::{ ..d, max_input_bytes: 2147483647, max_lines: 2147483647, max_segments: 2147483647, max_variants: 2147483647, max_attributes: 2147483647, max_line_bytes: 2147483647, max_custom_tags: 2147483647 }),
    ("i32min", hls::HlsLimits::{ ..d, max_lines: -2147483648 }),
  ]
  let inputs = [
    MH() + SEG(),
    H() + "#EXT-X-STREAM-INF:BANDWIDTH=1\nv\n",
    "",
    "\xEF\xBB\xBF",
    H(),
  ]
  let mut i = 0
  while i < lims.length() {
    let (n, l) = lims[i]
    let mut j = 0
    while j < inputs.length() {
      let r = match hls::parse_playlist_with_limits(inputs[j], l) {
        Ok(p) => "ok " + fnv(14695981039346656037UL, dump_playlist(p)).to_string()
        Err(e) => "err " + hls::hls_error_to_string(e)
      }
      sb.write_string("limits " + n + " input " + j.to_string() + ": " + r + "\n")
      j = j + 1
    }
    i = i + 1
  }
  let m = match master_of(
    H() +
    "#EXT-X-STREAM-INF:BANDWIDTH=9223372036854775807,CODECS=\" avc1 , mp4a.40.2 \"\nmax\n#EXT-X-STREAM-INF:BANDWIDTH=1\nmin\n",
  ) {
    Some(m) => m
    None => return "seed rejected\n"
  }
  let bws = [-9223372036854775808L, -1L, 0L, 1L, 9223372036854775806L, 9223372036854775807L]
  let prefs = [[], ["avc1"], [""], ["mp4a.40.2"], ["avc1 "], ["mp4a.40"]]
  i = 0
  while i < bws.length() {
    let mut j = 0
    while j < prefs.length() {
      let r = match hls::select_variant(m, bws[i], prefs[j]) {
        Some(v) => v.uri
        None => "none"
      }
      sb.write_string("select " + bws[i].to_string() + " pref" + j.to_string() + ": " + r + "\n")
      j = j + 1
    }
    i = i + 1
  }
  match media_of(MH() + "#EXTINF:0.0000005,\na\n#EXTINF:0.0000004999,\nb\n#EXTINF:0.9999995,\nc\n") {
    Some(md) => {
      let mut k = 0
      while k < md.segments.length() {
        sb.write_string("round " + md.segments[k].duration_us.to_string() + "\n")
        k = k + 1
      }
      let ex = [0L, 1L, -1L, 999999L, -9223372036854775808L, 9223372036854775807L]
      let s0 = md.segments[0]
      k = 0
      while k < ex.length() {
        let m2 = hls::MediaPlaylist::{ ..md, segments: [hls::MediaSegment::{ ..s0, duration_us: ex[k] }] }
        sb.write_string(
          "fmt extinf " +
          ex[k].to_string() +
          ": " +
          esc(fmt_text(hls::Playlist::Media(m2))) +
          "\n",
        )
        k = k + 1
      }
      let empty = hls::MediaPlaylist::{ ..md, segments: [] }
      sb.write_string(
        "empty total " +
        hls::total_duration_ms(empty).to_string() +
        " resolved " +
        hls::resolve_media_sequence(empty).length().to_string() +
        "\n",
      )
    }
    None => sb.write_string("round seed rejected\n")
  }
  sb.to_string()
}
