///| RFC 8216 Master (Multivariant) Playlist & ABR variant selection tests.

fn assert_str(got : String, expected : String, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected \"" + expected + "\", got \"" + got + "\"",
  )
}

fn assert_i64(got : Int64, expected : Int64, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected " + expected.to_string() + ", got " + got.to_string(),
  )
}

fn assert_int(got : Int, expected : Int, label : String) -> Unit {
  debug_assert(
    got == expected,
    label + ": expected " + expected.to_string() + ", got " + got.to_string(),
  )
}

///|
test "master_full_multivariant_tags" {
  let m3u8 =
  "\xEF\xBB\xBF#EXTM3U\r\n" +
  "#EXT-X-VERSION:7\r\n" +
  "#EXT-X-INDEPENDENT-SEGMENTS\r\n" +
  "#EXT-X-START:TIME-OFFSET=-12.5,PRECISE=YES\r\n" +
  "#EXT-X-DEFINE:NAME=\"base\",VALUE=\"https://cdn.example.com/hls\"\r\n" +
  "#EXT-X-SESSION-DATA:DATA-ID=\"com.example.title\",VALUE=\"Demo Stream\",LANGUAGE=\"en\"\r\n" +
  "#EXT-X-SESSION-KEY:METHOD=AES-128,URI=\"{$base}/key.bin\",IV=0x00112233445566778899aabbccddeeff,KEYFORMAT=\"identity\",KEYFORMATVERSIONS=\"1\"\r\n" +
  "#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"aac\",NAME=\"English\",LANGUAGE=\"en\",ASSOC-LANGUAGE=\"en-US\",DEFAULT=YES,AUTOSELECT=YES,FORCED=NO,CHANNELS=\"2\",URI=\"{$base}/audio_en.m3u8\"\r\n" +
  "#EXT-X-MEDIA:TYPE=SUBTITLES,GROUP-ID=\"subs\",NAME=\"English CC\",LANGUAGE=\"en\",DEFAULT=NO,AUTOSELECT=YES,FORCED=NO,CHARACTERISTICS=\"public.accessibility.transcribes-spoken-dialog\",URI=\"subs_en.m3u8\"\r\n" +
  "#EXT-X-MEDIA:TYPE=CLOSED-CAPTIONS,GROUP-ID=\"cc\",NAME=\"CC1\",LANGUAGE=\"en\",INSTREAM-ID=\"CC1\"\r\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=1280000,AVERAGE-BANDWIDTH=1000000,CODECS=\"avc1.4d401f,mp4a.40.2\",RESOLUTION=640x360,FRAME-RATE=29.970,HDCP-LEVEL=NONE,AUDIO=\"aac\",SUBTITLES=\"subs\",CLOSED-CAPTIONS=\"cc\",SCORE=1.5,PATHWAY-ID=\"CDN-A\"\r\n" +
  "{$base}/low.m3u8\r\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=5500000,AVERAGE-BANDWIDTH=4800000,CODECS=\"hvc1.1.6.L120.90,mp4a.40.2\",RESOLUTION=1920x1080,FRAME-RATE=59.940,HDCP-LEVEL=TYPE-1,AUDIO=\"aac\",CLOSED-CAPTIONS=NONE,SCORE=2.75\r\n" +
  "high/index.m3u8\r\n" +
  "#EXT-X-I-FRAME-STREAM-INF:BANDWIDTH=256000,AVERAGE-BANDWIDTH=200000,CODECS=\"avc1.4d401f\",RESOLUTION=640x360,HDCP-LEVEL=TYPE-0,URI=\"iframes_low.m3u8\"\r\n"

  match parse_playlist(m3u8) {
    Ok(Playlist::Master(m)) => {
      match m.version {
        Some(v) => assert_int(v, 7, "version")
        None => debug_assert(false, "missing version")
      }
      debug_assert(m.independent_segments, "independent_segments")
      match m.start {
        Some(st) => {
          assert_i64(st.time_offset_us, -12500000L, "start time_offset_us")
          debug_assert(st.precise, "start precise")
        }
        None => debug_assert(false, "missing start")
      }
      assert_int(m.defines.length(), 1, "defines len")
      assert_str(m.defines[0].name, "base", "define name")
      assert_int(m.session_data.length(), 1, "session_data len")
      assert_str(m.session_data[0].data_id, "com.example.title", "data_id")
      assert_int(m.session_keys.length(), 1, "session_keys len")
      match m.session_keys[0].uri {
        Some(u) => assert_str(u, "https://cdn.example.com/hls/key.bin", "session key uri var sub")
        None => debug_assert(false, "missing session key uri")
      }
      assert_int(m.media.length(), 3, "media len")
      match m.media[0].uri {
        Some(u) => assert_str(u, "https://cdn.example.com/hls/audio_en.m3u8", "media[0] uri var sub")
        None => debug_assert(false, "missing media[0] uri")
      }
      debug_assert(m.media[0].is_default, "media[0] default")
      debug_assert(m.media[0].autoselect, "media[0] autoselect")
      match m.media[2].instream_id {
        Some(id) => assert_str(id, "CC1", "cc instream id")
        None => debug_assert(false, "missing cc instream id")
      }
      assert_int(m.variants.length(), 2, "variants len")
      assert_str(m.variants[0].uri, "https://cdn.example.com/hls/low.m3u8", "variant[0] uri")
      assert_i64(m.variants[0].bandwidth, 1280000L, "variant[0] bw")
      match m.variants[0].resolution {
        Some(r) => {
          assert_i64(r.width, 640L, "v0 width")
          assert_i64(r.height, 360L, "v0 height")
        }
        None => debug_assert(false, "missing v0 res")
      }
      match m.variants[0].frame_rate_mhz {
        Some(fr) => assert_i64(fr, 29970L, "v0 fps mhz")
        None => debug_assert(false, "missing v0 fps")
      }
      match m.variants[0].score_micros {
        Some(sc) => assert_i64(sc, 1500000L, "v0 score")
        None => debug_assert(false, "missing v0 score")
      }
      match m.variants[0].pathway_id {
        Some(pid) => assert_str(pid, "CDN-A", "v0 pathway")
        None => debug_assert(false, "missing v0 pathway")
      }
      match m.variants[1].closed_captions {
        Some(ClosedCaptionsRef::None) => ()
        _ => debug_assert(false, "v1 closed_captions should be NONE")
      }
      assert_int(m.iframe_streams.length(), 1, "iframe_streams len")
      assert_str(m.iframe_streams[0].uri, "iframes_low.m3u8", "iframe uri")
      assert_i64(m.iframe_streams[0].bandwidth, 256000L, "iframe bw")
    }
    Ok(Playlist::Media(_)) => debug_assert(false, "expected Master, got Media")
    Err(e) => debug_assert(false, "parse failed: " + hls_error_to_string(e))
  }
}

///|
test "master_iframe_does_not_consume_next_line" {
  let m3u8 =
  "#EXTM3U\n" +
  "#EXT-X-I-FRAME-STREAM-INF:BANDWIDTH=100000,URI=\"iframe.m3u8\"\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=800000,CODECS=\"avc1.42e01e\"\n" +
  "stream.m3u8\n"

  match parse_playlist(m3u8) {
    Ok(Playlist::Master(m)) => {
      assert_int(m.iframe_streams.length(), 1, "iframe count")
      assert_int(m.variants.length(), 1, "variant count")
      assert_str(m.iframe_streams[0].uri, "iframe.m3u8", "iframe uri")
      assert_str(m.variants[0].uri, "stream.m3u8", "variant uri")
    }
    _ => debug_assert(false, "expected valid master playlist")
  }
}

///|
test "master_abr_select_variant" {
  let m3u8 =
  "#EXTM3U\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=800000,CODECS=\"avc1.4d401e,mp4a.40.2\"\n" +
  "480p_avc.m3u8\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=2500000,CODECS=\"avc1.640028,mp4a.40.2\"\n" +
  "1080p_avc.m3u8\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=2400000,CODECS=\"hvc1.1.6.L120.90,mp4a.40.2\"\n" +
  "1080p_hevc.m3u8\n" +
  "#EXT-X-STREAM-INF:BANDWIDTH=6000000,CODECS=\"hvc1.1.6.L150.90,mp4a.40.2\"\n" +
  "4k_hevc.m3u8\n"

  match parse_playlist(m3u8) {
    Ok(Playlist::Master(m)) => {
      // Highest <= 3Mbps with HEVC preferred
      match select_variant(m, 3000000L, ["hvc1"]) {
        Some(v) => assert_str(v.uri, "1080p_hevc.m3u8", "prefer hevc <= 3M")
        None => debug_assert(false, "expected 1080p_hevc")
      }
      // Highest <= 3Mbps with no codec preference -> 1080p_avc (2.5M > 2.4M)
      match select_variant(m, 3000000L, []) {
        Some(v) => assert_str(v.uri, "1080p_avc.m3u8", "max bw <= 3M")
        None => debug_assert(false, "expected 1080p_avc")
      }
      // Preferred codec unavailable -> fallback to highest <= 3Mbps
      match select_variant(m, 3000000L, ["av01"]) {
        Some(v) => assert_str(v.uri, "1080p_avc.m3u8", "fallback when codec absent")
        None => debug_assert(false, "expected fallback variant")
      }
      // Budget too low -> None
      match select_variant(m, 500000L, []) {
        None => ()
        Some(_) => debug_assert(false, "expected None when max_bw < min variant")
      }
    }
    _ => debug_assert(false, "expected master")
  }
}
