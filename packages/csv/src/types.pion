///| Convenience preset for ASCII delimited text (`\x1F` unit separator, `\x1E` record separator).
pub fn CsvConfig::ascii(self : CsvConfig) -> CsvConfig {
  self.with_delimiter((0x1F).to_byte()).with_terminator(Terminator::Any((0x1E).to_byte()))
}

///| Position of a CSV record in the input stream.
pub val struct Position {
  pub byte : Int64
  pub line : Int
  pub record : Int
}

///|
pub fn Position::new(byte : Int64, line : Int, record : Int) -> Position {
  Position::{ byte: byte, line: line, record: record }
}

///|
pub fn Position::start() -> Position {
  Position::{ byte: 0L, line: 1, record: 0 }
}

///|
pub fn Position::eq(self : Position, other : Position) -> Bool {
  self.byte == other.byte && self.line == other.line && self.record == other.record
}

///| Error kind variants for CSV reading and writing.
pub enum CsvErrorKind {
  UnclosedQuote
  UnequalLengths(Int, Int)
  InvalidUtf8(Int, Int)
  RecordTooLarge(Int)
  TooManyFields(Int)
  TooManyRecords(Int)
  Unimplemented
}

///| Structured CSV error with optional 1-based line and 0-based byte offset.
pub struct CsvError {
  pub kind : CsvErrorKind
  pub position : Option[Position]
  pub message : String
}

///|
pub fn CsvError::new(
  kind : CsvErrorKind,
  position : Option[Position],
  message : String,
) -> CsvError {
  CsvError::{ kind: kind, position: position, message: message }
}

///|
pub fn CsvError::unimplemented() -> CsvError {
  CsvError::{
    kind: CsvErrorKind::Unimplemented,
    position: Option::None,
    message: "csv: unimplemented",
  }
}

///|
pub fn CsvError::to_string(self : CsvError) -> String {
  self.message
}

///| Return 1-based line number of the error, or 0 if unavailable.
pub fn CsvError::line(self : CsvError) -> Int {
  match self.position {
    Some(p) => p.line
    None => 0
  }
}

///| Return 0-based byte offset of the error, or -1 if unavailable.
pub fn CsvError::byte_offset(self : CsvError) -> Int64 {
  match self.position {
    Some(p) => p.byte
    None => -1L
  }
}

///| A single parsed CSV record storing fields in a contiguous backing buffer with byte spans.
pub struct Record {
  mut buf : String
  mut spans : FixedArray[Int]
  mut nfields : Int
  mut pos_byte : Int64
  mut pos_line : Int
  mut pos_record : Int
}

///| Create an empty record.
pub fn Record::new() -> Record {
  Record::{
    buf: "",
    spans: FixedArray::make(32, 0),
    nfields: 0,
    pos_byte: 0L,
    pos_line: 1,
    pos_record: 0,
  }
}

///| Create an empty record with pre-allocated span capacity (internal).
fn Record::with_span_capacity(cap : Int) -> Record {
  let c = if cap < 2 { 2 } else { cap }
  Record::{
    buf: "",
    spans: FixedArray::make(c, 0),
    nfields: 0,
    pos_byte: 0L,
    pos_line: 1,
    pos_record: 0,
  }
}

///| Grow `rec.spans` to hold at least `min_cap` ints (internal).
fn Record::grow_spans(self : Record, min_cap : Int) -> FixedArray[Int] {
  let old = self.spans
  let old_len = old.length()
  let mut new_cap = if old_len < 16 { 32 } else { old_len << 1 }
  while new_cap < min_cap {
    new_cap = new_cap << 1
  }
  let next : FixedArray[Int] = FixedArray::make(new_cap, 0)
  let mut k = 0
  while k < old_len {
    next[k] = old[k]
    k = k + 1
  }
  self.spans = next
  next
}

///| Create a record from an array of field strings.
pub fn Record::from_fields(fields : Array[String]) -> Record {
  let mut total = 0
  let mut i = 0
  let n = fields.length()
  while i < n {
    total = total + fields[i].length()
    i = i + 1
  }
  let sb = StringBuilder::with_capacity(total)
  let spans : FixedArray[Int] = FixedArray::make(if n == 0 { 2 } else { n << 1 }, 0)
  let mut off = 0
  i = 0
  while i < n {
    let f = fields[i]
    let flen = f.length()
    sb.write_string(f)
    let base = i << 1
    spans[base] = off
    off = off + flen
    spans[base + 1] = off
    i = i + 1
  }
  Record::{
    buf: sb.to_string(),
    spans: spans,
    nfields: n,
    pos_byte: 0L,
    pos_line: 1,
    pos_record: 0,
  }
}

///| Number of fields in this record.
pub fn Record::len(self : Record) -> Int {
  self.nfields
}

///| Whether this record has zero fields.
pub fn Record::is_empty(self : Record) -> Bool {
  self.nfields == 0
}

///| Get field at `idx` as `Option[String]`.
pub fn Record::get(self : Record, idx : Int) -> Option[String] {
  if idx < 0 || idx >= self.nfields {
    return Option::None
  }
  let base = idx << 1
  Option::Some(self.buf.slice(self.spans[base], self.spans[base + 1]))
}

///| Get field at `idx`, or `""` if out of bounds.
pub fn Record::field(self : Record, idx : Int) -> String {
  match self.get(idx) {
    Some(s) => s
    None => ""
  }
}

///| Return `(start, end)` byte span of field `idx` inside `backing_string()`.
pub fn Record::field_span(self : Record, idx : Int) -> (Int, Int) {
  if idx < 0 || idx >= self.nfields {
    return (0, 0)
  }
  let base = idx << 1
  (self.spans[base], self.spans[base + 1])
}

///| Return start byte offset of field `idx` inside `backing_string()`.
pub fn Record::field_start(self : Record, idx : Int) -> Int {
  if idx < 0 || idx >= self.nfields {
    return 0
  }
  self.spans[idx << 1]
}

///| Return end byte offset of field `idx` inside `backing_string()`.
pub fn Record::field_end(self : Record, idx : Int) -> Int {
  if idx < 0 || idx >= self.nfields {
    return 0
  }
  self.spans[(idx << 1) + 1]
}

///| Return the backing string referenced by `field_span`.
pub fn Record::backing_string(self : Record) -> String {
  self.buf
}

///| Return all fields as a freshly allocated `Array[String]`.
pub fn Record::fields(self : Record) -> Array[String] {
  let n = self.nfields
  let out : Array[String] = Array::with_capacity(n)
  let buf = self.buf
  let spans = self.spans
  let mut i = 0
  while i < n {
    let base = i << 1
    out.push(buf.slice(spans[base], spans[base + 1]))
    i = i + 1
  }
  out
}

///| Return the starting position (byte offset, 1-based line, 0-based record index) of this record.
pub fn Record::position(self : Record) -> Position {
  Position::new(self.pos_byte, self.pos_line, self.pos_record)
}

///| Return the 1-based starting line number of this record.
pub fn Record::line(self : Record) -> Int {
  self.pos_line
}

///| Return the 0-based starting byte offset of this record.
pub fn Record::byte_offset(self : Record) -> Int64 {
  self.pos_byte
}

///| Compare two records by field contents.
pub fn Record::eq(self : Record, other : Record) -> Bool {
  let n = self.len()
  if n != other.len() {
    return false
  }
  let mut i = 0
  while i < n {
    if self.field(i) != other.field(i) {
      return false
    }
    i = i + 1
  }
  true
}
