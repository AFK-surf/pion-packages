///| Core types, configuration, limits, positions, records, and errors for `csv`.

///| Whitespace trimming mode for CSV fields and headers.
pub enum Trim {
  None
  Headers
  Fields
  All
}

///| Record terminator specification.
pub enum Terminator {
  CRLF
  LF
  Any(Byte)
}

///| Quoting policy for CSV serialization.
pub enum QuoteStyle {
  Necessary
  Always
  NonNumeric
  Never
}

///| Security and resource limits for CSV parsing (Day-1 DoS / OOM defense).
pub val struct Limits {
  pub max_record_bytes : Int
  pub max_fields_per_record : Int
  pub max_records : Int
}

///| Default limits: unlimited (0 for all fields, matching Rust `csv` and Go `encoding/csv`).
///| Use `Limits::strict()` for untrusted inputs.
pub fn Limits::default() -> Limits {
  Limits::{
    max_record_bytes: 0,
    max_fields_per_record: 0,
    max_records: 0,
  }
}

///| Strict resource limits for untrusted inputs: 16 MiB per record, 65,536 fields per record, 10,000,000 records.
pub fn Limits::strict() -> Limits {
  Limits::{
    max_record_bytes: 16777216,
    max_fields_per_record: 65536,
    max_records: 10000000,
  }
}

///| Unlimited resource limits (alias for `Limits::default()`).
pub fn Limits::unlimited() -> Limits {
  Limits::default()
}

///| Create custom limits (0 for any field means unlimited).
pub fn Limits::new(
  max_record_bytes : Int,
  max_fields_per_record : Int,
  max_records : Int,
) -> Limits {
  Limits::{
    max_record_bytes: max_record_bytes,
    max_fields_per_record: max_fields_per_record,
    max_records: max_records,
  }
}

///|
pub fn Limits::with_max_record_bytes(self : Limits, n : Int) -> Limits {
  Limits::{
    max_record_bytes: n,
    max_fields_per_record: self.max_fields_per_record,
    max_records: self.max_records,
  }
}

///|
pub fn Limits::with_max_fields_per_record(self : Limits, n : Int) -> Limits {
  Limits::{
    max_record_bytes: self.max_record_bytes,
    max_fields_per_record: n,
    max_records: self.max_records,
  }
}

///|
pub fn Limits::with_max_records(self : Limits, n : Int) -> Limits {
  Limits::{
    max_record_bytes: self.max_record_bytes,
    max_fields_per_record: self.max_fields_per_record,
    max_records: n,
  }
}

///| Configuration shared by CSV `Reader` and `Writer` (aligned with `BurntSushi/rust-csv`).
pub struct CsvConfig {
  pub delimiter : Byte
  pub quote : Byte
  pub double_quote : Bool
  pub escape : Option[Byte]
  pub comment : Option[Byte]
  pub has_headers : Bool
  pub flexible : Bool
  pub trim : Trim
  pub terminator : Terminator
  pub quoting : Bool
  pub quote_style : QuoteStyle
  pub strip_bom : Bool
  pub allow_unclosed_quotes : Bool
  pub limits : Limits
}

///| Default CSV configuration (RFC 4180 delimiter `,`, quote `"`, double-quote escaping, `has_headers = true`, `terminator = LF`).
pub fn CsvConfig::default() -> CsvConfig {
  CsvConfig::{
    delimiter: (44).to_byte(),
    quote: (34).to_byte(),
    double_quote: true,
    escape: Option::None,
    comment: Option::None,
    has_headers: true,
    flexible: false,
    trim: Trim::None,
    terminator: Terminator::LF,
    quoting: true,
    quote_style: QuoteStyle::Necessary,
    strip_bom: true,
    allow_unclosed_quotes: false,
    limits: Limits::default(),
  }
}

///|
pub fn CsvConfig::with_delimiter(self : CsvConfig, delimiter : Byte) -> CsvConfig {
  CsvConfig::{
    delimiter: delimiter,
    quote: self.quote,
    double_quote: self.double_quote,
    escape: self.escape,
    comment: self.comment,
    has_headers: self.has_headers,
    flexible: self.flexible,
    trim: self.trim,
    terminator: self.terminator,
    quoting: self.quoting,
    quote_style: self.quote_style,
    strip_bom: self.strip_bom,
    allow_unclosed_quotes: self.allow_unclosed_quotes,
    limits: self.limits,
  }
}

///|
pub fn CsvConfig::with_quote(self : CsvConfig, quote : Byte) -> CsvConfig {
  CsvConfig::{
    delimiter: self.delimiter,
    quote: quote,
    double_quote: self.double_quote,
    escape: self.escape,
    comment: self.comment,
    has_headers: self.has_headers,
    flexible: self.flexible,
    trim: self.trim,
    terminator: self.terminator,
    quoting: self.quoting,
    quote_style: self.quote_style,
    strip_bom: self.strip_bom,
    allow_unclosed_quotes: self.allow_unclosed_quotes,
    limits: self.limits,
