///| High-performance RFC 4180 + flexible CSV Writer.
///| Uses 256B `FixedArray` LUTs, 4-byte unrolled `needs_quotes` scanning, and `StringBuilder::write_substring`.

///| Top-level read-only 256B LUT for default writer config (`,`, `"`, `\r`, `\n`).
fn build_default_write_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  lut[44] = 1
  lut[34] = 1
  lut[10] = 1
  lut[13] = 1
  lut
}

let default_write_lut : FixedArray[Int] = build_default_write_lut()

///| Build a 256B `requires_quotes` LUT for a writer configuration.
fn build_write_lut(cfg : CsvConfig) -> FixedArray[Int] {
  let is_default_term = match cfg.terminator {
    Terminator::LF => true
    Terminator::CRLF => true
    Terminator::Any(_) => false
  }
  let no_comment = match cfg.comment {
    None => true
    Some(_) => false
  }
  if cfg.delimiter.to_int() == 44 &&
  cfg.quote.to_int() == 34 &&
  cfg.double_quote &&
  is_default_term &&
  no_comment {
    return default_write_lut
  }
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  lut[cfg.delimiter.to_int() & 0xFF] = 1
  lut[cfg.quote.to_int() & 0xFF] = 1
  if !cfg.double_quote {
    let esc = match cfg.escape {
      Some(b) => b.to_int() & 0xFF
      None => 92
    }
    lut[esc] = 1
  }
  match cfg.terminator {
    Terminator::CRLF => {
      lut[10] = 1
      lut[13] = 1
    }
    Terminator::LF => {
      lut[10] = 1
      lut[13] = 1
    }
    Terminator::Any(tb) => {
      let t = tb.to_int() & 0xFF
      if t == 10 || t == 13 {
        lut[10] = 1
        lut[13] = 1
      } else {
        lut[t] = 1
      }
    }
  }
  match cfg.comment {
    Some(cb) => lut[cb.to_int() & 0xFF] = 1
    None => ()
  }
  lut
}

///| Fast 4-byte unrolled check whether `s[start..end]` contains any byte needing quotes.
fn span_needs_quotes(lut : FixedArray[Int], s : String, start : Int, end : Int) -> Bool {
  let mut i = start
  let end4 = end - 4
  while i <= end4 {
    if (lut[s.code_unit_at(i)] |
      lut[s.code_unit_at(i + 1)] |
      lut[s.code_unit_at(i + 2)] |
      lut[s.code_unit_at(i + 3)]) != 0 {
      return true
    }
    i = i + 4
  }
  while i < end {
    if lut[s.code_unit_at(i)] != 0 {
      return true
    }
    i = i + 1
  }
  false
}

///| Check whether `s[start..end]` is a valid numeric literal (for `QuoteStyle::NonNumeric`).
fn span_is_numeric(s : String, start : Int, end : Int) -> Bool {
  if start >= end {
    return false
  }
  let mut i = start
  let first = s.code_unit_at(i)
  if first == 43 || first == 45 {
    // '+' or '-'
    i = i + 1
    if i >= end {
      return false
    }
  }
  let mut digits = 0
  while i < end {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      digits = digits + 1
      i = i + 1
    } else {
      break
    }
  }
  if i < end && s.code_unit_at(i) == 46 {
    // '.'
    i = i + 1
    while i < end {
      let b = s.code_unit_at(i)
      if b >= 48 && b <= 57 {
        digits = digits + 1
        i = i + 1
      } else {
        break
      }
    }
  }
  if digits == 0 {
    return false
  }
  if i < end {
    let e = s.code_unit_at(i)
    if e == 101 || e == 69 {
      // 'e' or 'E'
      i = i + 1
      if i < end {
        let sign = s.code_unit_at(i)
        if sign == 43 || sign == 45 {
          i = i + 1
        }
      }
      let mut exp_digits = 0
      while i < end {
        let b = s.code_unit_at(i)
        if b >= 48 && b <= 57 {
          exp_digits = exp_digits + 1
          i = i + 1
        } else {
          break
        }
      }
      if exp_digits == 0 {
        return false
      }
    }
  }
  i == end
}

///| Write a quoted field `s[start..end]` into `sb`, escaping internal quotes.
fn write_quoted_span(
  sb : StringBuilder,
  s : String,
  start : Int,
  end : Int,
  quote_byte : Byte,
  quote_int : Int,
  escape_byte : Byte,
  double_quote : Bool,
) -> Unit {
  sb.write_byte(quote_byte)
  let mut i = start
  let mut run_start = start
  while i < end {
    if s.code_unit_at(i) == quote_int {
      if i > run_start {
        sb.write_substring(s, run_start, i)
      }
      if double_quote {
        sb.write_byte(quote_byte)
        sb.write_byte(quote_byte)
      } else {
        sb.write_byte(escape_byte)
        sb.write_byte(quote_byte)
      }
      run_start = i + 1
    }
    i = i + 1
  }
  if run_start < end {
    sb.write_substring(s, run_start, end)
  }
  sb.write_byte(quote_byte)
}

///| Streaming CSV writer.
pub struct Writer {
  config : CsvConfig
  lut : FixedArray[Int]
  sb : StringBuilder
  delim_byte : Byte
  quote_byte : Byte
  quote_int : Int
  escape_byte : Byte
  double_quote : Bool
  mut expected_len : Int
  mut has_expected_len : Bool
}

///| Create a writer with default configuration.
pub fn Writer::new() -> Writer {
  Writer::with_config(CsvConfig::default())
}

///| Create a writer with custom configuration.
pub fn Writer::with_config(config : CsvConfig) -> Writer {
  Writer::with_capacity(config, 256)
}

///| Create a writer with custom configuration and initial buffer capacity.
pub fn Writer::with_capacity(config : CsvConfig, capacity : Int) -> Writer {
  let esc_byte = match config.escape {
    Some(b) => b
    None => (92).to_byte()
  }
  Writer::{
    config: config,
    lut: build_write_lut(config),
    sb: StringBuilder::with_capacity(capacity),
    delim_byte: config.delimiter,
    quote_byte: config.quote,
    quote_int: config.quote.to_int() & 0xFF,
    escape_byte: esc_byte,
    double_quote: config.double_quote,
    expected_len: 0,
    has_expected_len: false,
  }
}

///| Write record terminator into `sb`.
fn Writer::write_terminator(self : Writer) -> Unit {
  match self.config.terminator {
    Terminator::LF => self.sb.write_byte((10).to_byte())
    Terminator::CRLF => {
      self.sb.write_byte((13).to_byte())
      self.sb.write_byte((10).to_byte())
    }
    Terminator::Any(b) => self.sb.write_byte(b)
  }
}

///| Write a single field span `s[start..end]` according to `quote_style`.
fn Writer::write_field_span(self : Writer, s : String, start : Int, end : Int) -> Unit {
  let should_q = match self.config.quote_style {
    QuoteStyle::Always => true
    QuoteStyle::Never => false
    QuoteStyle::NonNumeric => !span_is_numeric(s, start, end)
    QuoteStyle::Necessary => span_needs_quotes(self.lut, s, start, end)
  }
  if should_q {
    write_quoted_span(
      self.sb,
      s,
      start,
      end,
      self.quote_byte,
      self.quote_int,
      self.escape_byte,
      self.double_quote,
    )
  } else if start < end {
    self.sb.write_substring(s, start, end)
  }
}

///| Write a single record of string fields.
pub fn Writer::write_record(self : Writer, fields : Array[String]) -> Result[Unit, CsvError] {
  let n = fields.length()
  if !self.config.flexible {
    if !self.has_expected_len {
      self.expected_len = n
      self.has_expected_len = true
    } else if n != self.expected_len {
      return Err(
        CsvError::new(
          CsvErrorKind::UnequalLengths(self.expected_len, n),
          Option::None,
          "csv: expected " + self.expected_len.to_string() + " fields, got " + n.to_string(),
        ),
      )
    }
  }
  if n == 1 && fields[0].length() == 0 {
    // Single empty field must be quoted as "" unless QuoteStyle::Never
    match self.config.quote_style {
      QuoteStyle::Never => ()
      _ => {
        self.sb.write_byte(self.quote_byte)
        self.sb.write_byte(self.quote_byte)
      }
    }
    self.write_terminator()
    return Ok(())
  }
  let mut i = 0
  while i < n {
    if i > 0 {
      self.sb.write_byte(self.delim_byte)
    }
    let f = fields[i]
    self.write_field_span(f, 0, f.length())
    i = i + 1
  }
  self.write_terminator()
  Ok(())
}

///| Write a single `Record` directly from its backing buffer (zero intermediate field allocation).
pub fn Writer::write_csv_record(self : Writer, rec : Record) -> Result[Unit, CsvError] {
  let n = rec.len()
  if !self.config.flexible {
    if !self.has_expected_len {
      self.expected_len = n
      self.has_expected_len = true
    } else if n != self.expected_len {
      return Err(
        CsvError::new(
          CsvErrorKind::UnequalLengths(self.expected_len, n),
          Option::None,
          "csv: expected " + self.expected_len.to_string() + " fields, got " + n.to_string(),
        ),
      )
    }
  }
  let s = rec.buf
  let spans = rec.spans
  if n == 1 && spans[0] == spans[1] {
    match self.config.quote_style {
      QuoteStyle::Never => ()
      _ => {
        self.sb.write_byte(self.quote_byte)
        self.sb.write_byte(self.quote_byte)
      }
    }
    self.write_terminator()
    return Ok(())
  }
  let mut i = 0
  while i < n {
    if i > 0 {
      self.sb.write_byte(self.delim_byte)
    }
    let base = i << 1
    self.write_field_span(s, spans[base], spans[base + 1])
    i = i + 1
  }
  self.write_terminator()
  Ok(())
}

///| Write multiple records.
pub fn Writer::write_all(self : Writer, records : Array[Array[String]]) -> Result[Unit, CsvError] {
  let mut i = 0
  let n = records.length()
  while i < n {
    match self.write_record(records[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  Ok(())
}

///| Finalize and return the serialized CSV string.
pub fn Writer::finish(self : Writer) -> String {
  self.sb.to_string()
}

///| Finalize and return the serialized CSV bytes.
pub fn Writer::finish_bytes(self : Writer) -> Bytes {
  self.sb.to_string().to_bytes()
}
