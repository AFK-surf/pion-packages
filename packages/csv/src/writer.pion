///| High-performance RFC 4180 + flexible CSV Writer (stub for Red phase).

///| Streaming CSV writer.
pub struct Writer {
  config : CsvConfig
  sb : StringBuilder
}

///| Create a writer with default configuration.
pub fn Writer::new() -> Writer {
  Writer::with_config(CsvConfig::default())
}

///| Create a writer with custom configuration.
pub fn Writer::with_config(config : CsvConfig) -> Writer {
  Writer::with_capacity(config, 256)
}

///| Create a writer with custom configuration and initial buffer capacity.
pub fn Writer::with_capacity(config : CsvConfig, capacity : Int) -> Writer {
  Writer::{ config: config, sb: StringBuilder::with_capacity(capacity) }
}

///| Write a single record of string fields.
pub fn Writer::write_record(self : Writer, fields : Array[String]) -> Result[Unit, CsvError] {
  let _ = self
  let _ = fields
  Err(CsvError::unimplemented())
}

///| Write a single `Record`.
pub fn Writer::write_csv_record(self : Writer, rec : Record) -> Result[Unit, CsvError] {
  let _ = self
  let _ = rec
  Err(CsvError::unimplemented())
}

///| Write multiple records.
pub fn Writer::write_all(self : Writer, records : Array[Array[String]]) -> Result[Unit, CsvError] {
  let _ = self
  let _ = records
  Err(CsvError::unimplemented())
}

///| Finalize and return the serialized CSV string.
pub fn Writer::finish(self : Writer) -> String {
  self.sb.to_string()
}

///| Finalize and return the serialized CSV bytes.
pub fn Writer::finish_bytes(self : Writer) -> Bytes {
  self.sb.to_string().to_bytes()
}
