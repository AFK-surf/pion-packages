///| Ported official writer test suite from `BurntSushi/rust-csv` (`csv-core/src/writer.rs` + `src/writer.rs`).

///|
test "rust_csv_writer_basic_records" {
  let w = Writer::new()
  match w.write_record(["a", "b", "c"]) {
    Ok(_) => ()
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(w.finish() == "a,b,c\n", "one_record")

  let w2 = Writer::new()
  match w2.write_csv_record(Record::from_fields(["a", "b", "c"])) {
    Ok(_) => ()
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(w2.finish() == "a,b,c\n", "one_csv_record")

  // Single empty field must be quoted as ""\n so it is not confused with an empty line
  let w3 = Writer::new()
  match w3.write_record([""]) {
    Ok(_) => ()
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(w3.finish() == "\"\"\n", "one_empty_record")

  let w4 = Writer::new()
  let _ = w4.write_record([""])
  let _ = w4.write_record([""])
  debug_assert(w4.finish() == "\"\"\n\"\"\n", "two_empty_records")

  // Two empty fields -> ",\n"
  let w5 = Writer::new()
  let _ = w5.write_record(["", ""])
  debug_assert(w5.finish() == ",\n", "two_empty_fields")
}

///|
test "rust_csv_writer_quoting_necessary" {
  let w = Writer::new()
  let _ = w.write_record(["a,bc", "\nz"])
  let _ = w.write_record(["f\"oo", "quux,"])
  let _ = w.write_record(["line\r\nbreak", "lone\rcr"])
  debug_assert(
    w.finish() == "\"a,bc\",\"\nz\"\n\"f\"\"oo\",\"quux,\"\n\"line\r\nbreak\",\"lone\rcr\"\n",
    "necessary quoting",
  )
}

///|
test "rust_csv_writer_quote_styles" {
  // Always
  let wa = Writer::with_config(CsvConfig::default().with_quote_style(QuoteStyle::Always))
  let _ = wa.write_record(["abc", "123", "a\"b"])
  debug_assert(wa.finish() == "\"abc\",\"123\",\"a\"\"b\"\n", "QuoteStyle::Always")

  // NonNumeric
  let wn = Writer::with_config(CsvConfig::default().with_quote_style(QuoteStyle::NonNumeric))
  let _ = wn.write_record(["abc", "5.2", "98", "-42", "1e10", ""])
  debug_assert(wn.finish() == "\"abc\",5.2,98,-42,1e10,\"\"\n", "QuoteStyle::NonNumeric")

  // Never
  let wv = Writer::with_config(CsvConfig::default().with_quote_style(QuoteStyle::Never))
  let _ = wv.write_record(["a,b", "c\"d", ""])
  debug_assert(wv.finish() == "a,b,c\"d,\n", "QuoteStyle::Never")
}

///|
test "rust_csv_writer_escapes_and_custom_config" {
  // double_quote = false with escape = '\'
  let cfg_esc = CsvConfig::default()
  .with_double_quote(false)
  .with_escape(Option::Some((92).to_byte()))
  let w = Writer::with_config(cfg_esc)
  let _ = w.write_record(["a\"b", "c\\d", "plain"])
  debug_assert(w.finish() == "\"a\\\"b\",\"c\\d\",plain\n", "escape quote mode")

  // CRLF terminator
  let wcrlf = Writer::with_config(CsvConfig::default().with_terminator(Terminator::CRLF))
  let _ = wcrlf.write_all([["a", "b"], ["c", "d"]])
  debug_assert(wcrlf.finish() == "a,b\r\nc,d\r\n", "CRLF terminator")

  // Tab delimiter
  let wtab = Writer::with_config(CsvConfig::default().with_delimiter((9).to_byte()))
  let _ = wtab.write_record(["a", "b\tc", "d,e"])
  debug_assert(wtab.finish() == "a\t\"b\tc\"\td,e\n", "tab delimiter")

  // Comment char auto-quoted
  let wcmt = Writer::with_config(CsvConfig::default().with_comment(Option::Some((35).to_byte())))
  let _ = wcmt.write_record(["# comment", "another"])
  debug_assert(wcmt.finish() == "\"# comment\",another\n", "comment auto-quoted")
}

///|
test "rust_csv_writer_unequal_lengths_and_flexible" {
  let w = Writer::new()
  match w.write_record(["a", "b", "c"]) {
    Ok(_) => ()
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  match w.write_record(["a"]) {
    Err(e) => {
      match e.kind {
        CsvErrorKind::UnequalLengths(exp, got) => {
          debug_assert(exp == 3 && got == 1, "expected 3, got 1")
        }
        _ => debug_assert(false, "expected UnequalLengths")
      }
    }
    Ok(_) => debug_assert(false, "expected error on unequal lengths")
  }

  let wf = Writer::with_config(CsvConfig::default().with_flexible(true))
  let _ = wf.write_record(["a", "b", "c"])
  let _ = wf.write_record(["a"])
  debug_assert(wf.finish() == "a,b,c\na\n", "flexible writer")
}

///|
test "csv_round_trip_rfc4180" {
  let rows : Array[Array[String]] = [
    ["id", "name", "bio", "score"],
    ["1", "Alice, \"The Ace\"", "Line 1\nLine 2\r\nLine 3", "99.5"],
    ["2", "Bob", "", "-0.25"],
    ["3", "陈明 🚀", "引号\"\"与,逗号", "100"],
  ]
  let w = Writer::with_config(CsvConfig::default().with_terminator(Terminator::CRLF))
  match w.write_all(rows) {
    Ok(_) => ()
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  let encoded = w.finish()
  let rdr = Reader::from_string_with_config(encoded, CsvConfig::default().with_has_headers(false))
  let decoded = match rdr.read_all() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(decoded.length() == rows.length(), "round-trip row count")
  let mut i = 0
  while i < rows.length() {
    assert_fields_eq(decoded[i].fields(), rows[i], "round-trip row " + i.to_string())
    i = i + 1
  }
}
