///| Day-1 red-team security, UTF-8 validation, and O(N) DoS defense tests for `csv`.

fn make_bytes(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
test "redteam_giant_unclosed_quote_record_bytes_limit" {
  // Simulate a 100 KB unclosed quoted field with a 4096-byte record limit.
  let sb = StringBuilder::with_capacity(100010)
  sb.write_byte((34).to_byte())
  let mut i = 0
  while i < 100000 {
    sb.write_byte((65).to_byte())
    i = i + 1
  }
  let cfg = CsvConfig::default()
  .with_has_headers(false)
  .with_limits(Limits::default().with_max_record_bytes(4096))
  let rdr = Reader::from_string_with_config(sb.to_string(), cfg)
  match rdr.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::RecordTooLarge(lim) => debug_assert(lim == 4096, "limit 4096")
        _ => debug_assert(false, "expected RecordTooLarge, got: " + e.to_string())
      }
      debug_assert(e.line() == 1, "line 1")
      debug_assert(e.byte_offset() == 0L, "byte 0")
    }
    _ => debug_assert(false, "expected RecordTooLarge error")
  }
}

///|
test "redteam_max_fields_per_record_limit" {
  let sb = StringBuilder::with_capacity(2000)
  let mut i = 0
  while i < 500 {
    if i > 0 {
      sb.write_byte((44).to_byte())
    }
    sb.write_byte((97).to_byte())
    i = i + 1
  }
  let cfg = CsvConfig::default()
  .with_has_headers(false)
  .with_limits(Limits::default().with_max_fields_per_record(100))
  let rdr = Reader::from_string_with_config(sb.to_string(), cfg)
  match rdr.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::TooManyFields(lim) => debug_assert(lim == 100, "limit 100")
        _ => debug_assert(false, "expected TooManyFields")
      }
    }
    _ => debug_assert(false, "expected TooManyFields error")
  }
}

///|
test "redteam_max_records_limit" {
  let sb = StringBuilder::with_capacity(600)
  let mut i = 0
  while i < 200 {
    sb.write_string("a,b\n")
    i = i + 1
  }
  let cfg = CsvConfig::default()
  .with_has_headers(false)
  .with_limits(Limits::default().with_max_records(50))
  let rdr = Reader::from_string_with_config(sb.to_string(), cfg)
  match rdr.read_all() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::TooManyRecords(lim) => debug_assert(lim == 50, "limit 50")
        _ => debug_assert(false, "expected TooManyRecords")
      }
    }
    _ => debug_assert(false, "expected TooManyRecords error")
  }
}

///|
test "redteam_linear_pathological_inputs" {
  // 1) 50,000 commas in one record
  let sb1 = StringBuilder::with_capacity(50002)
  let mut i = 0
  while i < 50000 {
    sb1.write_byte((44).to_byte())
    i = i + 1
  }
  let r1 = Reader::from_string_with_config(sb1.to_string(), CsvConfig::default().with_has_headers(false))
  let rec1 = match r1.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "50k commas failed")
      return ()
    }
  }
  debug_assert(rec1.len() == 50001, "50001 empty fields")

  // 2) 20,000 doubled quotes inside a quoted field
  let sb2 = StringBuilder::with_capacity(40004)
  sb2.write_byte((34).to_byte())
  i = 0
  while i < 20000 {
    sb2.write_string("\"\"")
    i = i + 1
  }
  sb2.write_byte((34).to_byte())
  let r2 = Reader::from_string_with_config(sb2.to_string(), CsvConfig::default().with_has_headers(false))
  let rec2 = match r2.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "20k doubled quotes failed")
      return ()
    }
  }
  debug_assert(rec2.field(0).length() == 20000, "unescaped to 20000 quotes")

  // 3) 50,000 empty lines before a single record
  let sb3 = StringBuilder::with_capacity(50010)
  i = 0
  while i < 50000 {
    sb3.write_byte((10).to_byte())
    i = i + 1
  }
  sb3.write_string("ok,1\n")
  let r3 = Reader::from_string_with_config(sb3.to_string(), CsvConfig::default().with_has_headers(false))
  let rec3 = match r3.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "50k blank lines failed")
      return ()
    }
  }
  assert_fields_eq(rec3.fields(), ["ok", "1"], "record after blank lines")
  debug_assert(rec3.line() == 50001, "exact line 50001")
}

///|
test "redteam_invalid_utf8_bytes_exact_reporting" {
  // "foo,b\xFFar,baz\na,b,c" (from BurntSushi/rust-csv read_record_headers_invalid_utf8)
  let raw = make_bytes([
    102, 111, 111, 44, // foo,
    98, 255, 97, 114, 44, // b\xFFar,
    98, 97, 122, 10, // baz\n
    97, 44, 98, 44, 99, // a,b,c
  ])
  let rdr = Reader::from_bytes_with_config(raw, CsvConfig::default().with_has_headers(false))
  match rdr.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::InvalidUtf8(field_idx, valid_up_to) => {
          debug_assert(field_idx == 1, "field 1 has invalid utf8")
          debug_assert(valid_up_to == 1, "valid_up_to == 1")
        }
        _ => debug_assert(false, "expected InvalidUtf8, got: " + e.to_string())
      }
      debug_assert(e.line() == 1, "line 1")
      debug_assert(e.byte_offset() == 0L, "byte 0")
    }
    _ => debug_assert(false, "expected InvalidUtf8 error")
  }

  // Overlong 2-byte UTF-8 (0xC0 0xAF) on line 2
  let raw2 = make_bytes([
    97, 44, 98, 10, // a,b\n
    99, 44, 192, 175, // c,\xC0\xAF
  ])
  let rdr2 = Reader::from_bytes_with_config(raw2, CsvConfig::default().with_has_headers(false))
  let ok0 = match rdr2.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "row 0 should succeed")
      return ()
    }
  }
  assert_fields_eq(ok0.fields(), ["a", "b"], "row 0 ok")
  match rdr2.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::InvalidUtf8(field_idx, valid_up_to) => {
          debug_assert(field_idx == 1 && valid_up_to == 0, "overlong at field 1 offset 0")
        }
        _ => debug_assert(false, "expected InvalidUtf8")
      }
      debug_assert(e.line() == 2, "line 2")
      debug_assert(e.byte_offset() == 4L, "byte 4")
    }
    _ => debug_assert(false, "expected InvalidUtf8 on overlong")
  }

  // UTF-16 surrogate half in UTF-8 (0xED 0xA0 0x80)
  let raw3 = make_bytes([237, 160, 128])
  let rdr3 = Reader::from_bytes_with_config(raw3, CsvConfig::default().with_has_headers(false))
  match rdr3.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::InvalidUtf8(field_idx, valid_up_to) => {
          debug_assert(field_idx == 0 && valid_up_to == 0, "surrogate rejected")
        }
        _ => debug_assert(false, "expected InvalidUtf8 on surrogate")
      }
    }
    _ => debug_assert(false, "expected InvalidUtf8 on surrogate")
  }
}

///|
test "redteam_bytes_bom_stripping" {
  // UTF-8 BOM (0xEF 0xBB 0xBF) + "a,b\n1,2\n"
  let raw = make_bytes([239, 187, 191, 97, 44, 98, 10, 49, 44, 50, 10])
  let rdr = Reader::from_bytes_with_config(raw, CsvConfig::default().with_has_headers(false))
  let rows = match rdr.read_all() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(rows.length() == 2, "2 rows")
  assert_fields_eq(rows[0].fields(), ["a", "b"], "BOM stripped")
  assert_fields_eq(rows[1].fields(), ["1", "2"], "row 1")
}

///|
test "regression_f1_f9_header_utf8_errors" {
  // F1: has_headers=false -> headers() error on row 1 must be re-yielded by read_record()
  let raw1 = make_bytes([255, 44, 98, 10, 97, 44, 98, 10]) // \xFF,b\na,b\n
  let r1 = Reader::from_bytes_with_config(raw1, CsvConfig::default().with_has_headers(false).with_flexible(true))
  match r1.headers() {
    Err(e) => match e.kind {
      CsvErrorKind::InvalidUtf8(0, 0) => ()
      _ => debug_assert(false, "F1: expected InvalidUtf8(0, 0) from headers()")
    }
    Ok(_) => debug_assert(false, "F1: headers() should fail")
  }
  let rec1 = Record::new()
  match r1.read_record(rec1) {
    Err(e) => match e.kind {
      CsvErrorKind::InvalidUtf8(0, 0) => ()
      _ => debug_assert(false, "F1: expected InvalidUtf8(0, 0) from first read_record()")
    }
    _ => debug_assert(false, "F1: first read_record() must not drop row 1 error")
  }
  match r1.read_record(rec1) {
    Ok(true) => assert_fields_eq(rec1.fields(), ["a", "b"], "F1: row 2 intact")
    _ => debug_assert(false, "F1: expected row 2")
  }

  // F9: has_headers=true -> header UTF-8 error still locks expected_len to header's field count
  let raw2 = make_bytes([255, 44, 98, 10, 120, 10]) // \xFF,b\nx\n
  let r2 = Reader::from_bytes_with_config(raw2, CsvConfig::default())
  let _ = r2.headers()
  match r2.next_record() {
    Err(e) => match e.kind {
      CsvErrorKind::UnequalLengths(exp, got) => {
        debug_assert(exp == 2 && got == 1, "F9: expected UnequalLengths(2, 1)")
      }
      _ => debug_assert(false, "F9: expected UnequalLengths")
    }
    _ => debug_assert(false, "F9: 1-field row must fail after 2-field bad-UTF8 header")
  }
}

///|
test "regression_f2_limit_errors_advance_both_paths" {
  // RecordTooLarge advances past bad record in String and Bytes paths (including quoted)
  let cfg_sz = CsvConfig::default()
  .with_has_headers(false)
  .with_flexible(true)
  .with_limits(Limits::default().with_max_record_bytes(8))
  let s_data = "0123456789abcdef\nok1\n\"0123456789\nabc\"\nok2\n"
  let rs = Reader::from_string_with_config(s_data, cfg_sz)
  let rb = Reader::from_bytes_with_config(s_data.to_bytes(), cfg_sz)
  let rec = Record::new()
  match rs.read_record(rec) {
    Err(e) => match e.kind {
      CsvErrorKind::RecordTooLarge(8) => ()
      _ => debug_assert(false, "F2 string: expected RecordTooLarge")
    }
    _ => debug_assert(false, "F2 string: expected error")
  }
  match rs.read_record(rec) {
    Ok(true) => assert_fields_eq(rec.fields(), ["ok1"], "F2 string: reached ok1")
    _ => debug_assert(false, "F2 string: failed to reach ok1")
  }
  match rs.read_record(rec) {
    Err(e) => match e.kind {
      CsvErrorKind::RecordTooLarge(8) => ()
      _ => debug_assert(false, "F2 string quoted: expected RecordTooLarge")
    }
    _ => debug_assert(false, "F2 string quoted: expected error")
  }
  match rs.read_record(rec) {
    Ok(true) => assert_fields_eq(rec.fields(), ["ok2"], "F2 string: reached ok2")
    _ => debug_assert(false, "F2 string: failed to reach ok2")
  }

  match rb.read_record(rec) {
    Err(e) => match e.kind {
      CsvErrorKind::RecordTooLarge(8) => ()
      _ => debug_assert(false, "F2 bytes: expected RecordTooLarge")
    }
    _ => debug_assert(false, "F2 bytes: expected error")
  }
  match rb.read_record(rec) {
    Ok(true) => assert_fields_eq(rec.fields(), ["ok1"], "F2 bytes: reached ok1")
    _ => debug_assert(false, "F2 bytes: failed to reach ok1")
  }

  // TooManyFields advances past bad record
  let cfg_f = CsvConfig::default()
  .with_has_headers(false)
  .with_flexible(true)
  .with_limits(Limits::default().with_max_fields_per_record(2))
  let rf = Reader::from_string_with_config("a,b,\"c\nd\",e\nok\n", cfg_f)
  match rf.read_record(rec) {
    Err(e) => match e.kind {
      CsvErrorKind::TooManyFields(2) => ()
      _ => debug_assert(false, "F2 fields: expected TooManyFields")
    }
    _ => debug_assert(false, "F2 fields: expected error")
  }
  match rf.read_record(rec) {
    Ok(true) => assert_fields_eq(rec.fields(), ["ok"], "F2 fields: reached ok after multiline quoted skip")
    _ => debug_assert(false, "F2 fields: failed to reach ok")
  }
}

///|
test "regression_f3_limits_presets_and_f4_f5_f6_f7_f8" {
  // F3: default is unlimited, strict() retains safe bounds
  let def = Limits::default()
  debug_assert(def.max_record_bytes == 0 && def.max_fields_per_record == 0 && def.max_records == 0, "F3 default unlimited")
  let st = Limits::strict()
  debug_assert(st.max_record_bytes == 16777216 && st.max_fields_per_record == 65536 && st.max_records == 10000000, "F3 strict preset")

  // F4 + F8: zero-field record and QuoteStyle::Never single empty field write ""
  let w4 = Writer::new()
  let _ = w4.write_record(["a"])
  let _ = w4.write_record([])
  let _ = w4.write_record(["b"])
  debug_assert(w4.finish() == "a\n\"\"\nb\n", "F4 zero-field record")
  let w8 = Writer::with_config(CsvConfig::default().with_quote_style(QuoteStyle::Never))
  let _ = w8.write_record(["x"])
  let _ = w8.write_record([""])
  debug_assert(w8.finish() == "x\n\"\"\n", "F8 Never single empty field")

  // F5: Terminator::Any line numbers match between from_string and from_bytes
  let cfg5 = CsvConfig::default().with_has_headers(false).with_terminator(Terminator::Any((0x1E).to_byte()))
  let in5 = "\"abc\ndefghijk\"\u{1E}c\u{1E}"
  let rs5 = Reader::from_string_with_config(in5, cfg5)
  let rb5 = Reader::from_bytes_with_config(in5.to_bytes(), cfg5)
  let _ = rs5.next_record()
  let _ = rb5.next_record()
  match (rs5.next_record(), rb5.next_record()) {
    (Ok(Some(a)), Ok(Some(b))) => debug_assert(a.line() == 2 && b.line() == 2, "F5 line 2 on both paths")
    _ => debug_assert(false, "F5 read failed")
  }

  // F6: Unicode White_Space trimming
  let r6 = Reader::from_string_with_config(
    "\u{0B}a\u{0B},\u{A0}b\u{A0},\u{3000}c\u{3000},\u{85}d\u{2028},\u{2003}e\u{202F}\n",
    CsvConfig::default().with_has_headers(false).with_trim(Trim::All),
  )
  match r6.next_record() {
    Ok(Some(rec)) => assert_fields_eq(rec.fields(), ["a", "b", "c", "d", "e"], "F6 Unicode whitespace")
    _ => debug_assert(false, "F6 read failed")
  }

  // F7: NonNumeric special floats (case-insensitive, optional sign)
  let w7 = Writer::with_config(CsvConfig::default().with_quote_style(QuoteStyle::NonNumeric))
  let _ = w7.write_record(["NaN", "-nan", "+NaN", "inf", "-INF", "+Infinity", "infinity", "0x10"])
  debug_assert(w7.finish() == "NaN,-nan,+NaN,inf,-INF,+Infinity,infinity,\"0x10\"\n", "F7 NonNumeric floats")

  // Non-default delimiter fast path (semicolon + doubled quotes)
  let r_semi = Reader::from_string_with_config(
    "h1;h2\n\"a;\"\"b\"\"\";c\nd;e\n",
    CsvConfig::default().with_delimiter((59).to_byte()),
  )
  match r_semi.read_all() {
    Ok(rows) => {
      debug_assert(rows.length() == 2, "semi 2 data rows")
      assert_fields_eq(rows[0].fields(), ["a;\"b\"", "c"], "semi row 0")
      assert_fields_eq(rows[1].fields(), ["d", "e"], "semi row 1")
    }
    Err(e) => debug_assert(false, "semi err: " + e.to_string())
  }
}
