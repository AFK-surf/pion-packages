///| Day-1 red-team security, UTF-8 validation, and O(N) DoS defense tests for `csv`.

fn make_bytes(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
test "redteam_giant_unclosed_quote_record_bytes_limit" {
  // Simulate a 100 KB unclosed quoted field with a 4096-byte record limit.
  let sb = StringBuilder::with_capacity(100010)
  sb.write_byte((34).to_byte())
  let mut i = 0
  while i < 100000 {
    sb.write_byte((65).to_byte())
    i = i + 1
  }
  let cfg = CsvConfig::default()
  .with_has_headers(false)
  .with_limits(Limits::default().with_max_record_bytes(4096))
  let rdr = Reader::from_string_with_config(sb.to_string(), cfg)
  match rdr.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::RecordTooLarge(lim) => debug_assert(lim == 4096, "limit 4096")
        _ => debug_assert(false, "expected RecordTooLarge, got: " + e.to_string())
      }
      debug_assert(e.line() == 1, "line 1")
      debug_assert(e.byte_offset() == 0L, "byte 0")
    }
    _ => debug_assert(false, "expected RecordTooLarge error")
  }
}

///|
test "redteam_max_fields_per_record_limit" {
  let sb = StringBuilder::with_capacity(2000)
  let mut i = 0
  while i < 500 {
    if i > 0 {
      sb.write_byte((44).to_byte())
    }
    sb.write_byte((97).to_byte())
    i = i + 1
  }
  let cfg = CsvConfig::default()
  .with_has_headers(false)
  .with_limits(Limits::default().with_max_fields_per_record(100))
  let rdr = Reader::from_string_with_config(sb.to_string(), cfg)
  match rdr.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::TooManyFields(lim) => debug_assert(lim == 100, "limit 100")
        _ => debug_assert(false, "expected TooManyFields")
      }
    }
    _ => debug_assert(false, "expected TooManyFields error")
  }
}

///|
test "redteam_max_records_limit" {
  let sb = StringBuilder::with_capacity(600)
  let mut i = 0
  while i < 200 {
    sb.write_string("a,b\n")
    i = i + 1
  }
  let cfg = CsvConfig::default()
  .with_has_headers(false)
  .with_limits(Limits::default().with_max_records(50))
  let rdr = Reader::from_string_with_config(sb.to_string(), cfg)
  match rdr.read_all() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::TooManyRecords(lim) => debug_assert(lim == 50, "limit 50")
        _ => debug_assert(false, "expected TooManyRecords")
      }
    }
    _ => debug_assert(false, "expected TooManyRecords error")
  }
}

///|
test "redteam_linear_pathological_inputs" {
  // 1) 50,000 commas in one record
  let sb1 = StringBuilder::with_capacity(50002)
  let mut i = 0
  while i < 50000 {
    sb1.write_byte((44).to_byte())
    i = i + 1
  }
  let r1 = Reader::from_string_with_config(sb1.to_string(), CsvConfig::default().with_has_headers(false))
  let rec1 = match r1.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "50k commas failed")
      return ()
    }
  }
  debug_assert(rec1.len() == 50001, "50001 empty fields")

  // 2) 20,000 doubled quotes inside a quoted field
  let sb2 = StringBuilder::with_capacity(40004)
  sb2.write_byte((34).to_byte())
  i = 0
  while i < 20000 {
    sb2.write_string("\"\"")
    i = i + 1
  }
  sb2.write_byte((34).to_byte())
  let r2 = Reader::from_string_with_config(sb2.to_string(), CsvConfig::default().with_has_headers(false))
  let rec2 = match r2.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "20k doubled quotes failed")
      return ()
    }
  }
  debug_assert(rec2.field(0).length() == 20000, "unescaped to 20000 quotes")

  // 3) 50,000 empty lines before a single record
  let sb3 = StringBuilder::with_capacity(50010)
  i = 0
  while i < 50000 {
    sb3.write_byte((10).to_byte())
    i = i + 1
  }
  sb3.write_string("ok,1\n")
  let r3 = Reader::from_string_with_config(sb3.to_string(), CsvConfig::default().with_has_headers(false))
  let rec3 = match r3.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "50k blank lines failed")
      return ()
    }
  }
  assert_fields_eq(rec3.fields(), ["ok", "1"], "record after blank lines")
  debug_assert(rec3.line() == 50001, "exact line 50001")
}

///|
test "redteam_invalid_utf8_bytes_exact_reporting" {
  // "foo,b\xFFar,baz\na,b,c" (from BurntSushi/rust-csv read_record_headers_invalid_utf8)
  let raw = make_bytes([
    102, 111, 111, 44, // foo,
    98, 255, 97, 114, 44, // b\xFFar,
    98, 97, 122, 10, // baz\n
    97, 44, 98, 44, 99, // a,b,c
  ])
  let rdr = Reader::from_bytes_with_config(raw, CsvConfig::default().with_has_headers(false))
  match rdr.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::InvalidUtf8(field_idx, valid_up_to) => {
          debug_assert(field_idx == 1, "field 1 has invalid utf8")
          debug_assert(valid_up_to == 1, "valid_up_to == 1")
        }
        _ => debug_assert(false, "expected InvalidUtf8, got: " + e.to_string())
      }
      debug_assert(e.line() == 1, "line 1")
      debug_assert(e.byte_offset() == 0L, "byte 0")
    }
    _ => debug_assert(false, "expected InvalidUtf8 error")
  }

  // Overlong 2-byte UTF-8 (0xC0 0xAF) on line 2
  let raw2 = make_bytes([
    97, 44, 98, 10, // a,b\n
    99, 44, 192, 175, // c,\xC0\xAF
  ])
  let rdr2 = Reader::from_bytes_with_config(raw2, CsvConfig::default().with_has_headers(false))
  let ok0 = match rdr2.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "row 0 should succeed")
      return ()
    }
  }
  assert_fields_eq(ok0.fields(), ["a", "b"], "row 0 ok")
  match rdr2.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::InvalidUtf8(field_idx, valid_up_to) => {
          debug_assert(field_idx == 1 && valid_up_to == 0, "overlong at field 1 offset 0")
        }
        _ => debug_assert(false, "expected InvalidUtf8")
      }
      debug_assert(e.line() == 2, "line 2")
      debug_assert(e.byte_offset() == 4L, "byte 4")
    }
    _ => debug_assert(false, "expected InvalidUtf8 on overlong")
  }

  // UTF-16 surrogate half in UTF-8 (0xED 0xA0 0x80)
  let raw3 = make_bytes([237, 160, 128])
  let rdr3 = Reader::from_bytes_with_config(raw3, CsvConfig::default().with_has_headers(false))
  match rdr3.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::InvalidUtf8(field_idx, valid_up_to) => {
          debug_assert(field_idx == 0 && valid_up_to == 0, "surrogate rejected")
        }
        _ => debug_assert(false, "expected InvalidUtf8 on surrogate")
      }
    }
    _ => debug_assert(false, "expected InvalidUtf8 on surrogate")
  }
}

///|
test "redteam_bytes_bom_stripping" {
  // UTF-8 BOM (0xEF 0xBB 0xBF) + "a,b\n1,2\n"
  let raw = make_bytes([239, 187, 191, 97, 44, 98, 10, 49, 44, 50, 10])
  let rdr = Reader::from_bytes_with_config(raw, CsvConfig::default().with_has_headers(false))
  let rows = match rdr.read_all() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(rows.length() == 2, "2 rows")
  assert_fields_eq(rows[0].fields(), ["a", "b"], "BOM stripped")
  assert_fields_eq(rows[1].fields(), ["1", "2"], "row 1")
}
