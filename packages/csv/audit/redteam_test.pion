///| Red-team prosecution tests for `packages/csv`.
///|
///| Every `fN_*` test asserts the behaviour of the upstream reference (Rust `csv =1.4.0`, reproduced
///| byte for byte by `tools/rust_ref` + `diff/probes.py`) or the property a correct reader/writer must
///| have. A FAILING `fN_*` test is the evidence; it passes once the defect is fixed. IDs match REPORT.md.
///| `control_*` / `dN_*` tests pin behaviour that is already correct, or a documented divergence
///| where Pion is at least as good as Rust; they pass today and must keep passing.

import "csv"

fn make_bytes(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

fn ascii(s : String) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < s.length() {
    out.push(s.code_unit_at(i))
    i = i + 1
  }
  out
}

fn cat(parts : Array[Array[Int]]) -> Bytes {
  let all : Array[Int] = []
  let mut i = 0
  while i < parts.length() {
    let p = parts[i]
    let mut j = 0
    while j < p.length() {
      all.push(p[j])
      j = j + 1
    }
    i = i + 1
  }
  make_bytes(all)
}

fn show(fields : Array[String]) -> String {
  let sb = StringBuilder::new()
  sb.write_string("[")
  let mut i = 0
  while i < fields.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string("\"" + fields[i] + "\"")
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

fn same(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn kind_name(e : csv::CsvError) -> String {
  match e.kind {
    csv::CsvErrorKind::UnclosedQuote => "UnclosedQuote"
    csv::CsvErrorKind::UnequalLengths(_, _) => "UnequalLengths"
    csv::CsvErrorKind::InvalidUtf8(_, _) => "InvalidUtf8"
    csv::CsvErrorKind::RecordTooLarge(_) => "RecordTooLarge"
    csv::CsvErrorKind::TooManyFields(_) => "TooManyFields"
    csv::CsvErrorKind::TooManyRecords(_) => "TooManyRecords"
    csv::CsvErrorKind::Unimplemented => "Unimplemented"
  }
}

fn no_hdr() -> csv::CsvConfig {
  csv::CsvConfig::default().with_has_headers(false).with_flexible(true)
}

fn write_one(cfg : csv::CsvConfig, fields : Array[String]) -> String {
  let w = csv::Writer::with_config(cfg)
  match w.write_record(fields) {
    Ok(_) => w.finish()
    Err(e) => "ERR " + e.to_string()
  }
}

fn count_records(s : String, cfg : csv::CsvConfig) -> Int {
  let rdr = csv::Reader::from_string_with_config(s, cfg)
  match rdr.read_all() {
    Ok(v) => v.length()
    Err(_) => -1
  }
}

// ---------------------------------------------------------------------------------------------
// P1
// ---------------------------------------------------------------------------------------------

///| F1 (P1, silent data loss): with `has_headers = false` the first row is data. If `headers()`
///| fails on it (invalid UTF-8), Rust re-reports that row from `read_record` (`E U8 0 0`, then the
///| next rows). Pion caches the error in `headers()` and then silently skips row 1 in `read_record`.
///| Rust csv 1.4.0 on `"\xff,b\na,b\n"`: HE U8 | E U8 | R [a, b].
test "f1_has_headers_false_first_row_error_is_not_silently_dropped" {
  let raw = cat([[255], ascii(",b\na,b\n")])
  let rdr = csv::Reader::from_bytes_with_config(raw, no_hdr())
  match rdr.headers() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "[F1] headers() should fail on invalid UTF-8 in row 1")
  }
  let rec = csv::Record::new()
  match rdr.read_record(rec) {
    Err(e) =>
    debug_assert(kind_name(e) == "InvalidUtf8", "[F1] expected InvalidUtf8 for row 1, got " + kind_name(e))
    Ok(true) =>
    debug_assert(
      false,
      "[F1] row 1 (invalid UTF-8) was silently dropped: read_record returned " + show(rec.fields()) + " (row 2) as the first data record",
    )
    Ok(false) => debug_assert(false, "[F1] unexpected EOF")
  }
}

///| F2 (P1, infinite loop): a reader that skips bad rows (`Err(_) => continue`, the documented
///| recovery pattern for `UnequalLengths`) never terminates on `RecordTooLarge` / `TooManyFields`:
///| the offset is not advanced, so every call returns the same error at the same byte. Every Rust /
///| Go CSV error consumes the bad record. Expected: the next call makes progress.
test "f2_limit_errors_advance_past_the_bad_record" {
  let cfg = no_hdr().with_limits(csv::Limits::default().with_max_record_bytes(8))
  let rdr = csv::Reader::from_string_with_config("0123456789abcdef\nok\n", cfg)
  let rec = csv::Record::new()
  let mut same_error = 0
  let mut got_ok = false
  let mut calls = 0
  while calls < 5 {
    match rdr.read_record(rec) {
      Err(e) => if kind_name(e) == "RecordTooLarge" && e.byte_offset() == 0L {
        same_error = same_error + 1
      }
      Ok(true) => {
        got_ok = rec.field(0) == "ok"
        break
      }
      Ok(false) => break
    }
    calls = calls + 1
  }
  debug_assert(
    same_error <= 1 && got_ok,
    "[F2] RecordTooLarge returned " + same_error.to_string() + "x at byte 0 and never reached row 2 (error-skipping loop never terminates)",
  )
}

///| F2b: same for `TooManyFields`.
test "f2b_too_many_fields_error_advances_past_the_bad_record" {
  let rec = csv::Record::new()
  let mut calls = 0
  let cfg2 = no_hdr().with_limits(csv::Limits::default().with_max_fields_per_record(3))
  let rdr2 = csv::Reader::from_string_with_config("a,b,c,d,e\nok\n", cfg2)
  let mut same2 = 0
  let mut ok2 = false
  calls = 0
  while calls < 5 {
    match rdr2.read_record(rec) {
      Err(e) => if kind_name(e) == "TooManyFields" && e.byte_offset() == 0L {
        same2 = same2 + 1
      }
      Ok(true) => {
        ok2 = rec.field(0) == "ok"
        break
      }
      Ok(false) => break
    }
    calls = calls + 1
  }
  debug_assert(
    same2 <= 1 && ok2,
    "[F2] TooManyFields returned " + same2.to_string() + "x at byte 0 and never reached row 2",
  )
}

///| F3 (P1, functional regression): `CsvConfig::default()` silently imposes
///| `max_records = 10,000,000`. A 20 MB file of 10,000,001 one-column rows (any mid-size log /
///| export) fails with `TooManyRecords`; Rust csv and Go encoding/csv read it. Expected: default
///| config reads every row (limits should be opt-in, or at least not reject ordinary files).
test "f3_default_config_reads_ten_million_and_one_rows" {
  let n = 10000001
  let sb = StringBuilder::with_capacity(n * 2)
  let mut i = 0
  while i < n {
    sb.write_string("a\n")
    i = i + 1
  }
  let rdr = csv::Reader::from_string_with_config(sb.to_string(), no_hdr())
  let rec = csv::Record::new()
  let mut count = 0
  let mut err = ""
  while true {
    match rdr.read_record(rec) {
      Ok(true) => count = count + 1
      Ok(false) => break
      Err(e) => {
        err = e.to_string()
        break
      }
    }
  }
  debug_assert(
    count == n && err == "",
    "[F3] default config read " + count.to_string() + " of " + n.to_string() + " rows, then: " + err,
  )
}

///| F3b: default `max_fields_per_record = 65,536` rejects a 70,000-column row (wide genomics /
///| sensor matrices); Rust and Go read it.
test "f3b_default_config_reads_seventy_thousand_columns" {
  let n = 70000
  let sb = StringBuilder::with_capacity(n * 2)
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("1")
    i = i + 1
  }
  let rdr = csv::Reader::from_string_with_config(sb.to_string(), no_hdr())
  match rdr.next_record() {
    Ok(Some(r)) => debug_assert(r.len() == n, "[F3b] wrong field count")
    Ok(None) => debug_assert(false, "[F3b] unexpected EOF")
    Err(e) => debug_assert(false, "[F3b] default config rejects a 70,000-column row: " + e.to_string())
  }
}

///| F4 (P1, silent data loss on round trip): writing a record with zero fields emits a bare
///| terminator; every CSV reader (Pion's included) skips blank lines, so the record vanishes and
///| row numbering shifts. Rust csv 1.4.0 writes `""\n` (csv-core `terminator()`, record_bytes == 0).
test "f4_writer_zero_field_record_survives_round_trip" {
  let w = csv::Writer::new()
  let _ = w.write_record(["a"])
  let _ = w.write_record([])
  let _ = w.write_record(["b"])
  let out = w.finish()
  debug_assert(out == "a\n\"\"\nb\n", "[F4] expected Rust output a\\n\"\"\\nb\\n, got [" + out + "]")
  let n = count_records(out, no_hdr())
  debug_assert(n == 3, "[F4] wrote 3 records, read back " + n.to_string())
}

// ---------------------------------------------------------------------------------------------
// P2
// ---------------------------------------------------------------------------------------------

///| F5 (P2): `Position.line` depends on the input type. With `Terminator::Any`, newlines inside a
///| quoted field are counted by `from_bytes` but skipped by the 4-byte window of the `from_string`
///| path (the LUT has no LF/CR class for custom terminators). Pion counts every line break, so the
///| second record starts on line 2. (Rust csv 1.4.0 reports 1 here: its `scan_and_copy` shortcut has
///| the same blind spot, so Rust is no reference for this case; the defect is Pion's inconsistency.)
test "f5_line_numbers_agree_between_from_string_and_from_bytes" {
  let cfg = no_hdr().with_terminator(csv::Terminator::Any((0x1E).to_byte()))
  let input = "\"abc\ndefghijk\"\u{1E}c\u{1E}"
  let rs = csv::Reader::from_string_with_config(input, cfg)
  let rb = csv::Reader::from_bytes_with_config(input.to_bytes(), cfg)
  let _ = rs.next_record()
  let _ = rb.next_record()
  let ls = match rs.next_record() {
    Ok(Some(r)) => r.line()
    _ => -1
  }
  let lb = match rb.next_record() {
    Ok(Some(r)) => r.line()
    _ => -1
  }
  debug_assert(
    ls == lb && ls == 2,
    "[F5] record 2 line: from_string=" + ls.to_string() + " from_bytes=" + lb.to_string() + " (expected 2 from both)",
  )
}

///| F6 (P2): `Trim` only strips ASCII ` \t\n\x0C\r`. Pion returns `String` fields, whose Rust
///| analogue `StringRecord::trim` uses `str::trim` (Unicode White_Space): `\x0B`, U+0085, U+00A0,
///| U+2028, U+3000 are all trimmed by Rust csv 1.4.0 with `Trim::All` (verified by rust_ref).
test "f6_trim_all_strips_unicode_whitespace_like_string_record" {
  let cfg = no_hdr().with_trim(csv::Trim::All)
  let input = "\u{0B}a\u{0B},\u{A0}b\u{A0},\u{3000}c\u{3000},\u{85}d\u{2028}\n"
  let rdr = csv::Reader::from_string_with_config(input, cfg)
  match rdr.next_record() {
    Ok(Some(r)) =>
    debug_assert(same(r.fields(), ["a", "b", "c", "d"]), "[F6] Trim::All left Unicode whitespace: " + show(r.fields()))
    _ => debug_assert(false, "[F6] read failed")
  }
}

///| F7 (P2): `QuoteStyle::NonNumeric` decides "numeric" with a hand-written grammar; Rust uses
///| `s.parse::<f64>()` / `parse::<i128>()`, which accept `NaN`, `inf`, `-inf`, `Infinity`. Rust
///| writes them bare; Pion quotes them (output differs byte-for-byte from Rust).
test "f7_nonnumeric_matches_rust_numeric_parsing" {
  let cfg = csv::CsvConfig::default().with_quote_style(csv::QuoteStyle::NonNumeric)
  let out = write_one(cfg, ["NaN", "inf", "-inf", "Infinity", "1e5", "-0.5", ".5", "5.", "+7", "0x10", "", " 123"])
  let rust = "NaN,inf,-inf,Infinity,1e5,-0.5,.5,5.,+7,\"0x10\",\"\",\" 123\"\n"
  debug_assert(out == rust, "[F7] got [" + out + "], Rust csv 1.4.0 writes [" + rust + "]")
}

///| F8 (P2): `QuoteStyle::Never` with a single empty field writes a blank line, which every reader
///| skips (the row disappears). Rust csv 1.4.0 still writes `""` here (csv-core `terminator()`).
test "f8_never_single_empty_field_round_trips" {
  let cfg = csv::CsvConfig::default().with_quote_style(csv::QuoteStyle::Never)
  let w = csv::Writer::with_config(cfg)
  let _ = w.write_record(["x"])
  let _ = w.write_record([""])
  let out = w.finish()
  debug_assert(out == "x\n\"\"\n", "[F8] got [" + out + "], Rust writes [x\\n\"\"\\n]")
}

///| F9 (P2): with `has_headers = true, flexible = false`, a header row with invalid UTF-8 makes
///| `headers()` fail, and Pion then forgets the header's field count: data rows are length-checked
///| against the first data row instead. Rust keeps the byte header's length (2) and reports
///| `UnequalLengths(2, 1)` for row `x`.
test "f9_header_utf8_error_keeps_header_length_for_unequal_check" {
  let raw = cat([[255], ascii(",b\nx\n")])
  let rdr = csv::Reader::from_bytes_with_config(raw, csv::CsvConfig::default())
  let _ = rdr.headers()
  let rec = csv::Record::new()
  match rdr.read_record(rec) {
    Err(e) =>
    debug_assert(kind_name(e) == "UnequalLengths", "[F9] expected UnequalLengths(2, 1), got " + kind_name(e))
    Ok(true) =>
    debug_assert(false, "[F9] 1-field row accepted after a 2-field header: " + show(rec.fields()) + " (Rust: UnequalLengths(2, 1))")
    Ok(false) => debug_assert(false, "[F9] unexpected EOF")
  }
}

// ---------------------------------------------------------------------------------------------
// Controls: behaviour verified identical to Rust csv 1.4.0 (or a documented divergence where Pion
// is at least as good). These pass today.
// ---------------------------------------------------------------------------------------------

fn parse_all(input : String, cfg : csv::CsvConfig) -> Array[Array[String]] {
  let rdr = csv::Reader::from_string_with_config(input, cfg)
  let out : Array[Array[String]] = []
  let rec = csv::Record::new()
  while true {
    match rdr.read_record(rec) {
      Ok(true) => out.push(rec.fields())
      Ok(false) => break
      Err(e) => {
        out.push(["ERR " + kind_name(e)])
        if out.length() > 50 {
          break
        }
      }
    }
  }
  out
}

fn expect_rows(id : String, input : String, cfg : csv::CsvConfig, want : Array[Array[String]]) -> Unit {
  let got = parse_all(input, cfg)
  let mut ok = got.length() == want.length()
  let mut i = 0
  while ok && i < want.length() {
    ok = same(got[i], want[i])
    i = i + 1
  }
  if !ok {
    let sb = StringBuilder::new()
    let mut k = 0
    while k < got.length() {
      sb.write_string(show(got[k]))
      k = k + 1
    }
    debug_assert(false, "[" + id + "] got " + sb.to_string())
  }
}

///| Quote state machine edges (all identical to Rust csv 1.4.0, checked by diff/probes.py).
test "control_quote_state_machine_matches_rust" {
  let c = no_hdr()
  expect_rows("mid-field quote", "a\"b,c\n", c, [["a\"b", "c"]])
  expect_rows("text after closing quote", "\"abc\"def,g\n", c, [["abcdef", "g"]])
  expect_rows("quotes inside unquoted", "foo \"bar\" baz,x\n", c, [["foo \"bar\" baz", "x"]])
  expect_rows("a\"b\"c after quote", "\"a\"b\"c\",d\n", c, [["ab\"c\"", "d"]])
  expect_rows("only doubled", "\"\"\"\"\n", c, [["\""]])
  expect_rows("double_quote=false", "\"a\"\"b\",c\n", c.with_double_quote(false), [["a\"b\"", "c"]])
  expect_rows(
    "escape + dq",
    "\"a\\\"b\"\"c\",d\n",
    c.with_escape(Option::Some((92).to_byte())),
    [["a\"b\"c", "d"]],
  )
  expect_rows("escape outside quotes is literal", "a\\,b\n", c.with_escape(Option::Some((92).to_byte())), [["a\\", "b"]])
  expect_rows("escaped newline", "\"a\\\nb\",c\n", c.with_escape(Option::Some((92).to_byte())), [["a\nb", "c"]])
  expect_rows("quoting=false", "\"a,b\",c\n", c.with_quoting(false), [["\"a", "b\"", "c"]])
  expect_rows("trim keeps quotes after leading space", " \"hello\" ,x\n", c.with_trim(csv::Trim::All), [["\"hello\"", "x"]])
  expect_rows("trim does not touch quoted content", "\" hello \",x\n", c.with_trim(csv::Trim::All), [["hello", "x"]])
}

///| Record reuse: longer -> error -> shorter -> quoted -> unquoted, no stale fields or spans.
test "control_record_reuse_after_errors_has_no_stale_data" {
  let cfg = csv::CsvConfig::default().with_has_headers(false)
  let rdr = csv::Reader::from_string_with_config("aaaa,bbbb,cccc\nx\n\"q\"\"q\",y,z\nu,v,w\n", cfg)
  let rec = csv::Record::new()
  let got : Array[String] = []
  while true {
    match rdr.read_record(rec) {
      Ok(true) => got.push(show(rec.fields()))
      Ok(false) => break
      Err(e) => got.push("ERR " + kind_name(e) + " " + show(rec.fields()))
    }
  }
  let want = [
    "[\"aaaa\", \"bbbb\", \"cccc\"]", "ERR UnequalLengths [\"x\"]", "[\"q\"q\", \"y\", \"z\"]", "[\"u\", \"v\", \"w\"]",
  ]
  debug_assert(same(got, want), "[reuse] got " + show(got))
}

///| BOM handling: stripped once at the start (also before a quote), kept elsewhere. Same as csv-core.
test "control_bom_handling_matches_rust" {
  let bom = [0xEF, 0xBB, 0xBF]
  let r1 = csv::Reader::from_bytes_with_config(cat([bom, ascii("\"a\",b\n")]), no_hdr())
  match r1.next_record() {
    Ok(Some(r)) => debug_assert(same(r.fields(), ["a", "b"]), "[bom] BOM before quote: " + show(r.fields()))
    _ => debug_assert(false, "[bom] read failed")
  }
  let r2 = csv::Reader::from_bytes_with_config(make_bytes(bom), no_hdr())
  match r2.next_record() {
    Ok(None) => ()
    _ => debug_assert(false, "[bom] BOM-only file must have no records")
  }
  let r3 = csv::Reader::from_bytes_with_config(cat([ascii("a"), bom]), no_hdr())
  match r3.next_record() {
    Ok(Some(r)) => debug_assert(r.field(0).length() == 4, "[bom] BOM inside a field is data")
    _ => debug_assert(false, "[bom] read failed")
  }
}

///| UTF-8 validation of `from_bytes` matches Rust `StringRecord` (field index, valid_up_to) for
///| the 4-byte window edge, > U+10FFFF, overlong, surrogate, lone continuation and truncation.
test "control_utf8_validation_matches_rust" {
  let vecs : Array[Array[Int]] = [
    [0x61, 0x62, 0x63, 0xF4, 0x90, 0x80, 0x80], // > U+10FFFF after 3 ASCII bytes
    [0x61, 0x62, 0x63, 0x64, 0xE0, 0x80, 0xAF], // overlong 3-byte at the 4-byte window edge
    [0x61, 0xED, 0xBF, 0xBF], // surrogate
    [0x61, 0x62, 0x80], // lone continuation
    [0x61, 0x62, 0x63, 0x64, 0x65, 0xF0, 0x9F, 0x98], // truncated 4-byte at EOF
  ]
  let want_up_to = [3, 4, 1, 2, 5]
  let mut i = 0
  while i < vecs.length() {
    let raw = cat([ascii("ok,"), vecs[i], ascii("\n")])
    let rdr = csv::Reader::from_bytes_with_config(raw, no_hdr())
    match rdr.next_record() {
      Err(e) =>
      match e.kind {
        csv::CsvErrorKind::InvalidUtf8(f, v) =>
        debug_assert(f == 1 && v == want_up_to[i], "[utf8 " + i.to_string() + "] field " + f.to_string() + " up_to " + v.to_string())
        _ => debug_assert(false, "[utf8 " + i.to_string() + "] wrong kind")
      }
      _ => debug_assert(false, "[utf8 " + i.to_string() + "] accepted invalid UTF-8")
    }
    i = i + 1
  }
}

///| D1: Position semantics differ from Rust by design: Pion's record position is the first byte of
///| the record itself (Rust: where the previous record ended, i.e. before skipped blank/comment lines
///| and the BOM), and Pion counts `\r`, `\n` and `\r\n` as one line each (Rust counts `\n` only).
///| Pion's choice is self-consistent; this pins it so it does not drift silently.
test "d1_position_semantics_are_self_consistent" {
  let input = "\"a\"\r\n\"b\r\nc\"\r\n\r\n#x\r\nd\re\n"
  let cfg = no_hdr().with_comment(Option::Some((35).to_byte()))
  let rdr = csv::Reader::from_string_with_config(input, cfg)
  let got : Array[String] = []
  while true {
    match rdr.next_record() {
      Ok(Some(r)) =>
      got.push(r.field(0) + "@" + r.byte_offset().to_string() + ":" + r.line().to_string() + ":" + r.position().record.to_string())
      Ok(None) => break
      Err(_) => break
    }
  }
  // Rust csv 1.4.0: a@0:1:0, b\r\nc@4:1:1, d@12:3:2, e@16:5:3  (positions only; same fields)
  let want = ["a@0:1:0", "b\r\nc@5:2:1", "d@19:6:2", "e@21:7:3"]
  debug_assert(same(got, want), "[D1] got " + show(got))
}

///| D3: a comment line ends at the record terminator (`\r`, `\n`, `\r\n`, or `Terminator::Any`).
///| Rust csv 1.4.0 ends comments only at `\n`, which makes it yield a phantom `[""]` record for a
///| trailing `#` without newline and garbage with `Any(0x1E)` + comment. Pion is the sane one.
test "d3_comment_lines_end_at_the_terminator" {
  let c = no_hdr().with_comment(Option::Some((35).to_byte()))
  expect_rows("comment at EOF", "#", c, [])
  expect_rows("comment then record", " #x\n#y\na#b,c\n\"#q\",z\n", c, [[" #x"], ["a#b", "c"], ["#q", "z"]])
  expect_rows(
    "comment + Any(0x1E)",
    "#x\u{1E}a\nb\u{1E}c\u{1E}",
    c.with_terminator(csv::Terminator::Any((0x1E).to_byte())),
    [["a\nb"], ["c"]],
  )
}

///| Writer quoting identical to Rust: comment char anywhere, Necessary specials, custom escape.
test "control_writer_quoting_matches_rust" {
  let c = csv::CsvConfig::default()
  debug_assert(write_one(c.with_comment(Option::Some((35).to_byte())), ["a#b", "c"]) == "\"a#b\",c\n", "[w] comment quoting")
  debug_assert(write_one(c.with_double_quote(false), ["a\"b\\c"]) == "\"a\\\"b\\c\"\n", "[w] escape, escape char itself not escaped (same as Rust)")
  debug_assert(write_one(c.with_terminator(csv::Terminator::Any((0x1E).to_byte())), ["a\nb"]) == "a\nb\u{1E}", "[w] Any(0x1E) does not quote LF (same as Rust)")
  debug_assert(write_one(c, [""]) == "\"\"\n", "[w] single empty field")
}
