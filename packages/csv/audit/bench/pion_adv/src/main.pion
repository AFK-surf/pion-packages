///| Adversarial read benchmark (Pion side). Usage: pion_adv <mode> FILE
///|   default      CsvConfig::default(), from_string, field spans (same access as packages/csv/bench)
///|   bytes        CsvConfig::default(), from_bytes (UTF-8 validated, like Rust StringRecord)
///|   fields       CsvConfig::default(), from_string, materialize every field via Record::fields()
///|   semicolon    delimiter ';'
///|   trim_comment Trim::All + comment '#'
///|   escape       escape '\\' + double_quote = false
///|   nolimit      CsvConfig::default() with max_record_bytes = 0 (the fast path is then used on any input size)
///|   read_all     CsvConfig::default(), Reader::read_all() (all records kept alive), then walk them
///| Output: records / fields / bytes / hash (identical across pion / rust / go).

import "csv"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: pion_adv <mode> FILE")
    return 2
  }
  let mode = args[1]
  let mut cfg = csv::CsvConfig::default()
  if mode == "semicolon" {
    cfg = cfg.with_delimiter((59).to_byte())
  } else if mode == "trim_comment" {
    cfg = cfg.with_trim(csv::Trim::All).with_comment(Option::Some((35).to_byte()))
  } else if mode == "nolimit" {
    cfg = cfg.with_limits(csv::Limits::default().with_max_record_bytes(0))
  } else if mode == "escape" {
    cfg = cfg.with_escape(Option::Some((92).to_byte())).with_double_quote(false)
  }
  let rdr = if mode == "bytes" {
    let raw = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 2
    }
    csv::Reader::from_bytes_with_config(raw, cfg)
  } else {
    let content = match fs_read(world, args[2]) {
      Ok(s) => s
      Err(_) => return 2
    }
    csv::Reader::from_string_with_config(content, cfg)
  }
  let mut records : Int64 = 0L
  let mut fields : Int64 = 0L
  let mut total : Int64 = 0L
  let mut hash : Int64 = 0L
  if mode == "read_all" {
    let all = match rdr.read_all() {
      Ok(v) => v
      Err(e) => {
        io_println(world, "parse error: " + e.to_string())
        return 1
      }
    }
    let mut r = 0
    while r < all.length() {
      let rec = all[r]
      let nf = rec.len()
      records = records + 1L
      fields = fields + nf.to_int64()
      let back = rec.backing_string()
      let mut f = 0
      while f < nf {
        let (a, b) = rec.field_span(f)
        total = total + (b - a).to_int64()
        let mut j = a
        while j < b {
          hash = (hash * 131L + back.code_unit_at(j).to_int64()) & 0x7FFFFFFFL
          j = j + 1
        }
        f = f + 1
      }
      r = r + 1
    }
    io_println(world, "records=" + records.to_string())
    io_println(world, "fields=" + fields.to_string())
    io_println(world, "bytes=" + total.to_string())
    io_println(world, "hash=" + hash.to_string())
    return 0
  }
  let rec = csv::Record::new()
  while true {
    match rdr.read_record(rec) {
      Ok(true) => {
        let nf = rec.len()
        records = records + 1L
        fields = fields + nf.to_int64()
        if mode == "fields" {
          let fs = rec.fields()
          let mut f = 0
          while f < nf {
            let s = fs[f]
            let n = s.length()
            total = total + n.to_int64()
            let mut j = 0
            while j < n {
              hash = (hash * 131L + s.code_unit_at(j).to_int64()) & 0x7FFFFFFFL
              j = j + 1
            }
            f = f + 1
          }
        } else {
          let back = rec.backing_string()
          let mut f = 0
          while f < nf {
            let (a, b) = rec.field_span(f)
            total = total + (b - a).to_int64()
            let mut j = a
            while j < b {
              hash = (hash * 131L + back.code_unit_at(j).to_int64()) & 0x7FFFFFFFL
              j = j + 1
            }
            f = f + 1
          }
        }
      }
      Ok(false) => break
      Err(e) => {
        io_println(world, "parse error: " + e.to_string())
        return 1
      }
    }
  }
  io_println(world, "records=" + records.to_string())
  io_println(world, "fields=" + fields.to_string())
  io_println(world, "bytes=" + total.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}
