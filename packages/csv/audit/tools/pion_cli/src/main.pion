///| Red-team audit CLI for `packages/csv` (Pion side of the differential, see `diff/fuzz_diff.py`).
///|
///| Usage: pion_cli <variant> CASEFILE
///|   read-string : Reader::from_string_with_config + read_record into one reused Record
///|   read-bytes  : Reader::from_bytes_with_config  + read_record into one reused Record
///|   read-fresh  : Reader::from_string_with_config + next_record (fresh Record each time)
///|   write       : Writer::write_record(Array[String])
///|   write-rec   : Writer::write_csv_record(Record::from_fields(..))
///| Output format is identical to `tools/rust_ref` (`#id`, `H`/`HE`, `R`, `P`, `E`, `W`/`WE`, `Z`).

import "csv"

let hexdig : String = "0123456789abcdef"

fn hex_of_span(sb : StringBuilder, s : String, a : Int, b : Int) -> Unit {
  let mut i = a
  while i < b {
    let c = s.code_unit_at(i)
    sb.write_byte(hexdig.code_unit_at((c >> 4) & 15).to_byte())
    sb.write_byte(hexdig.code_unit_at(c & 15).to_byte())
    i = i + 1
  }
}

fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

fn unhex_bytes(s : String, a : Int, b : Int) -> Bytes {
  let n = (b - a) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let h = hexval(s.code_unit_at(a + 2 * i))
    let l = hexval(s.code_unit_at(a + 2 * i + 1))
    out[i] = (h * 16 + l).to_byte()
    i = i + 1
  }
  out
}

fn unhex_string(s : String, a : Int, b : Int) -> String {
  unhex_bytes(s, a, b).to_string()
}

fn write_fields(sb : StringBuilder, rec : csv::Record) -> Unit {
  let n = rec.len()
  if n == 0 {
    sb.write_string("~")
    return ()
  }
  let back = rec.backing_string()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(".")
    }
    sb.write_string("x")
    // Use both accessors: `field()` (allocating) must agree with `field_span()` (zero-copy).
    let (a, b) = rec.field_span(i)
    let f = rec.field(i)
    if f.length() != b - a {
      sb.write_string("SPANMISMATCH")
    }
    hex_of_span(sb, f, 0, f.length())
    i = i + 1
  }
  if back.length() < 0 {
    sb.write_string("?")
  }
}

fn err_str(e : csv::CsvError) -> String {
  let pos = match e.position {
    Some(p) => " @ " + p.byte.to_string() + " " + p.line.to_string() + " " + p.record.to_string()
    None => ""
  }
  let k = match e.kind {
    csv::CsvErrorKind::UnclosedQuote => "UQ"
    csv::CsvErrorKind::UnequalLengths(a, b) => "UL " + a.to_string() + " " + b.to_string()
    csv::CsvErrorKind::InvalidUtf8(f, v) => "U8 " + f.to_string() + " " + v.to_string()
    csv::CsvErrorKind::RecordTooLarge(l) => "TOO_LARGE " + l.to_string()
    csv::CsvErrorKind::TooManyFields(l) => "TOO_MANY_FIELDS " + l.to_string()
    csv::CsvErrorKind::TooManyRecords(l) => "TOO_MANY_RECORDS " + l.to_string()
    csv::CsvErrorKind::Unimplemented => "UNIMPLEMENTED"
  }
  k + pos
}

// Tokenizer over one case line.
struct Tok {
  s : String
  mut i : Int
  end : Int
}

fn Tok::next(self : Tok) -> (Int, Int) {
  let a = self.i
  let mut j = a
  while j < self.end && self.s.code_unit_at(j) != 32 {
    j = j + 1
  }
  self.i = j + 1
  (a, j)
}

fn parse_int(s : String, a : Int, b : Int) -> Int {
  let mut i = a
  let mut neg = false
  if i < b && s.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
  }
  let mut v = 0
  while i < b {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  if neg {
    0 - v
  } else {
    v
  }
}

fn opt_byte(v : Int) -> Option[Byte] {
  if v < 0 {
    Option::None
  } else {
    Option::Some(v.to_byte())
  }
}

fn parse_cfg(t : Tok) -> csv::CsvConfig {
  let v : Array[Int] = []
  let mut k = 0
  while k < 11 {
    let (a, b) = t.next()
    v.push(parse_int(t.s, a, b))
    k = k + 1
  }
  let trim = if v[6] == 0 {
    csv::Trim::None
  } else if v[6] == 1 {
    csv::Trim::Headers
  } else if v[6] == 2 {
    csv::Trim::Fields
  } else {
    csv::Trim::All
  }
  let term = if v[7] == -1 {
    csv::Terminator::CRLF
  } else if v[7] == -2 {
    csv::Terminator::LF
  } else {
    csv::Terminator::Any(v[7].to_byte())
  }
  let style = if v[10] == 0 {
    csv::QuoteStyle::Necessary
  } else if v[10] == 1 {
    csv::QuoteStyle::Always
  } else if v[10] == 2 {
    csv::QuoteStyle::NonNumeric
  } else {
    csv::QuoteStyle::Never
  }
  // Rust csv never errors on an unclosed quote: compare like with like (the default
  // `allow_unclosed_quotes = false` is audited separately in redteam_test.pion).
  csv::CsvConfig::default()
  .with_delimiter(v[0].to_byte())
  .with_quote(v[1].to_byte())
  .with_double_quote(v[2] != 0)
  .with_escape(opt_byte(v[3]))
  .with_comment(opt_byte(v[4]))
  .with_quoting(v[5] != 0)
  .with_trim(trim)
  .with_terminator(term)
  .with_has_headers(v[8] != 0)
  .with_flexible(v[9] != 0)
  .with_quote_style(style)
  .with_allow_unclosed_quotes(true)
}

fn run_read(sb : StringBuilder, variant : String, cfg : csv::CsvConfig, input : Bytes) -> Unit {
  let rdr = if variant == "read-bytes" {
    csv::Reader::from_bytes_with_config(input, cfg)
  } else {
    csv::Reader::from_string_with_config(input.to_string(), cfg)
  }
  match rdr.headers() {
    Ok(h) => {
      sb.write_string("H ")
      write_fields(sb, h)
      sb.write_string("\n")
    }
    Err(e) => sb.write_string("HE " + err_str(e) + "\n")
  }
  let rec = csv::Record::new()
  let mut errs = 0
  let mut n = 0
  while true {
    let res = if variant == "read-fresh" {
      match rdr.next_record() {
        Ok(Some(r)) => {
          sb.write_string("R ")
          write_fields(sb, r)
          sb.write_string("\n")
          let p = r.position()
          sb.write_string("P " + p.byte.to_string() + " " + p.line.to_string() + " " + p.record.to_string() + "\n")
          Ok(true)
        }
        Ok(None) => Ok(false)
        Err(e) => Err(e)
      }
    } else {
      match rdr.read_record(rec) {
        Ok(true) => {
          sb.write_string("R ")
          write_fields(sb, rec)
          sb.write_string("\n")
          let p = rec.position()
          sb.write_string("P " + p.byte.to_string() + " " + p.line.to_string() + " " + p.record.to_string() + "\n")
          Ok(true)
        }
        Ok(false) => Ok(false)
        Err(e) => Err(e)
      }
    }
    match res {
      Ok(true) => {
        n = n + 1
        if n > 100000 {
          break
        }
      }
      Ok(false) => break
      Err(e) => {
        sb.write_string("E " + err_str(e) + "\n")
        errs = errs + 1
        if errs >= 64 {
          break
        }
      }
    }
  }
}

fn run_write(sb : StringBuilder, variant : String, cfg : csv::CsvConfig, s : String, a : Int, b : Int) -> Unit {
  let w = csv::Writer::with_config(cfg)
  let mut i = a
  while i < b {
    let mut j = i
    while j < b && s.code_unit_at(j) != 47 {
      j = j + 1
    }
    let fields : Array[String] = []
    if !(j - i == 1 && s.code_unit_at(i) == 126) {
      let mut p = i
      while p < j {
        let mut q = p
        while q < j && s.code_unit_at(q) != 46 {
          q = q + 1
        }
        fields.push(unhex_string(s, p + 1, q))
        p = q + 1
        if q == j - 1 && s.code_unit_at(q) == 46 {
          // trailing '.' cannot happen (every field has an 'x' prefix)
          ()
        }
      }
    }
    let r = if variant == "write-rec" {
      w.write_csv_record(csv::Record::from_fields(fields))
    } else {
      w.write_record(fields)
    }
    match r {
      Ok(_) => ()
      Err(e) => {
        sb.write_string("WE " + err_str(e) + "\n")
        return ()
      }
    }
    i = j + 1
  }
  let out = w.finish()
  sb.write_string("W ")
  hex_of_span(sb, out, 0, out.length())
  sb.write_string("\n")
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: pion_cli <read-string|read-bytes|read-fresh|write|write-rec> CASEFILE")
    return 2
  }
  let variant = args[1]
  let data = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "error: cannot read " + args[2])
      return 2
    }
  }
  let sb = StringBuilder::with_capacity(1 << 20)
  let n = data.length()
  let mut ls = 0
  while ls < n {
    let mut le = ls
    while le < n && data.code_unit_at(le) != 10 {
      le = le + 1
    }
    if le > ls {
      let t = Tok::{ s: data, i: ls, end: le }
      let (ia, ib) = t.next()
      sb.write_string("#")
      sb.write_substring(data, ia, ib)
      sb.write_string("\n")
      let (oa, _) = t.next()
      let op = data.code_unit_at(oa)
      let cfg = parse_cfg(t)
      let (pa, pb) = t.next()
      if op == 114 {
        let input = if pb - pa == 1 && data.code_unit_at(pa) == 45 {
          Bytes::new(0)
        } else {
          unhex_bytes(data, pa, pb)
        }
        run_read(sb, variant, cfg, input)
      } else {
        run_write(sb, variant, cfg, data, pa, pb)
      }
      sb.write_string("Z\n")
    }
    ls = le + 1
  }
  io_print(world, sb.to_string())
  0
}
