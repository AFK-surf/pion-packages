///| Ported official test suite from `BurntSushi/rust-csv` (`csv-core/src/reader.rs` + `src/reader.rs`).

fn assert_fields_eq(
  got : Array[String],
  expected : Array[String],
  label : String,
) -> Unit {
  debug_assert(
    got.length() == expected.length(),
    label + ": field count mismatch: got " + got.length().to_string() + ", expected " + expected.length().to_string(),
  )
  let mut i = 0
  while i < expected.length() {
    debug_assert(
      got[i] == expected[i],
      label + " col " + i.to_string() + ": got [" + got[i] + "], expected [" + expected[i] + "]",
    )
    i = i + 1
  }
}

fn assert_parses_to(
  label : String,
  data : String,
  expected : Array[Array[String]],
  config : CsvConfig,
) -> Unit {
  let rdr = Reader::from_string_with_config(data, config)
  let rows = match rdr.read_all() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, label + ": unexpected error: " + e.to_string())
      return ()
    }
  }
  debug_assert(
    rows.length() == expected.length(),
    label + ": row count mismatch: got " + rows.length().to_string() + ", expected " + expected.length().to_string(),
  )
  let mut r = 0
  while r < expected.length() {
    let got_fields = rows[r].fields()
    let exp_fields = expected[r]
    debug_assert(
      got_fields.length() == exp_fields.length(),
      label + " row " + r.to_string() + ": field count mismatch",
    )
    let mut c = 0
    while c < exp_fields.length() {
      debug_assert(
        got_fields[c] == exp_fields[c],
        label + " row " + r.to_string() + " col " + c.to_string() + ": got [" + got_fields[c] + "], expected [" + exp_fields[c] + "]",
      )
      c = c + 1
    }
    r = r + 1
  }
}

fn core_cfg() -> CsvConfig {
  CsvConfig::default().with_has_headers(false).with_flexible(true)
}

///|
test "rust_csv_core_basic_rows_and_line_endings" {
  let cfg = core_cfg()
  assert_parses_to("one_row_one_field", "a", [["a"]], cfg)
  assert_parses_to("one_row_many_fields", "a,b,c", [["a", "b", "c"]], cfg)
  assert_parses_to("one_row_trailing_comma", "a,b,", [["a", "b", ""]], cfg)
  assert_parses_to("one_row_one_field_lf", "a\n", [["a"]], cfg)
  assert_parses_to("one_row_many_fields_lf", "a,b,c\n", [["a", "b", "c"]], cfg)
  assert_parses_to("one_row_trailing_comma_lf", "a,b,\n", [["a", "b", ""]], cfg)
  assert_parses_to("one_row_one_field_crlf", "a\r\n", [["a"]], cfg)
  assert_parses_to("one_row_many_fields_crlf", "a,b,c\r\n", [["a", "b", "c"]], cfg)
  assert_parses_to("one_row_trailing_comma_crlf", "a,b,\r\n", [["a", "b", ""]], cfg)
  assert_parses_to("one_row_one_field_cr", "a\r", [["a"]], cfg)
  assert_parses_to("one_row_many_fields_cr", "a,b,c\r", [["a", "b", "c"]], cfg)
  assert_parses_to("one_row_trailing_comma_cr", "a,b,\r", [["a", "b", ""]], cfg)

  assert_parses_to("many_rows_one_field", "a\nb", [["a"], ["b"]], cfg)
  assert_parses_to("many_rows_many_fields", "a,b,c\nx,y,z", [["a", "b", "c"], ["x", "y", "z"]], cfg)
  assert_parses_to("many_rows_trailing_comma", "a,b,\nx,y,", [["a", "b", ""], ["x", "y", ""]], cfg)
  assert_parses_to("many_rows_one_field_lf", "a\nb\n", [["a"], ["b"]], cfg)
  assert_parses_to("many_rows_many_fields_lf", "a,b,c\nx,y,z\n", [["a", "b", "c"], ["x", "y", "z"]], cfg)
  assert_parses_to("many_rows_trailing_comma_lf", "a,b,\nx,y,\n", [["a", "b", ""], ["x", "y", ""]], cfg)
  assert_parses_to("many_rows_one_field_crlf", "a\r\nb\r\n", [["a"], ["b"]], cfg)
  assert_parses_to("many_rows_many_fields_crlf", "a,b,c\r\nx,y,z\r\n", [["a", "b", "c"], ["x", "y", "z"]], cfg)
  assert_parses_to("many_rows_trailing_comma_crlf", "a,b,\r\nx,y,\r\n", [["a", "b", ""], ["x", "y", ""]], cfg)
  assert_parses_to("many_rows_one_field_cr", "a\rb\r", [["a"], ["b"]], cfg)
  assert_parses_to("many_rows_many_fields_cr", "a,b,c\rx,y,z\r", [["a", "b", "c"], ["x", "y", "z"]], cfg)
  assert_parses_to("many_rows_trailing_comma_cr", "a,b,\rx,y,\r", [["a", "b", ""], ["x", "y", ""]], cfg)
  assert_parses_to("extra_record_crlf_1", "foo\n1\n", [["foo"], ["1"]], cfg)
  assert_parses_to("extra_record_crlf_2", "foo\r\n1\r\n", [["foo"], ["1"]], cfg)
}

///|
test "rust_csv_core_empty_lines_and_trailing_lines" {
  let cfg = core_cfg()
  assert_parses_to("trailing_lines_no_record", "\n\n\na,b,c\nx,y,z\n\n\n", [["a", "b", "c"], ["x", "y", "z"]], cfg)
  assert_parses_to("trailing_lines_no_record_cr", "\r\r\ra,b,c\rx,y,z\r\r\r", [["a", "b", "c"], ["x", "y", "z"]], cfg)
  assert_parses_to("trailing_lines_no_record_crlf", "\r\n\r\n\r\na,b,c\r\nx,y,z\r\n\r\n\r\n", [["a", "b", "c"], ["x", "y", "z"]], cfg)
  assert_parses_to("empty", "", [], cfg)
  assert_parses_to("empty_lines", "\n\n\n\n", [], cfg)
  assert_parses_to("empty_lines_interspersed", "\n\na,b\n\n\nx,y\n\n\nm,n\n", [["a", "b"], ["x", "y"], ["m", "n"]], cfg)
  assert_parses_to("empty_lines_crlf", "\r\n\r\n\r\n\r\n", [], cfg)
  assert_parses_to("empty_lines_interspersed_crlf", "\r\n\r\na,b\r\n\r\n\r\nx,y\r\n\r\n\r\nm,n\r\n", [["a", "b"], ["x", "y"], ["m", "n"]], cfg)
  assert_parses_to("empty_lines_mixed", "\r\n\n\r\n\n", [], cfg)
  assert_parses_to("empty_lines_interspersed_mixed", "\n\r\na,b\r\n\n\r\nx,y\r\n\n\r\nm,n\r\n", [["a", "b"], ["x", "y"], ["m", "n"]], cfg)
  assert_parses_to("empty_lines_cr", "\r\r\r\r", [], cfg)
  assert_parses_to("empty_lines_interspersed_cr", "\r\ra,b\r\r\rx,y\r\r\rm,n\r", [["a", "b"], ["x", "y"], ["m", "n"]], cfg)
  assert_parses_to("single_space", " ", [[" "]], cfg)
  assert_parses_to("single_comma", ",", [["", ""]], cfg)
}

///|
test "rust_csv_core_custom_terminators_and_delimiters" {
  assert_parses_to(
    "term_weird",
    "zza,bzc,dzz",
    [["a", "b"], ["c", "d"]],
    core_cfg().with_terminator(Terminator::Any((122).to_byte())),
  )
  assert_parses_to(
    "ascii_delimited",
    "a\x1fb\x1ec\x1fd",
    [["a", "b"], ["c", "d"]],
    core_cfg().ascii(),
  )
  assert_parses_to(
    "delimiter_tabs",
    "a\tb",
    [["a", "b"]],
    core_cfg().with_delimiter((9).to_byte()),
  )
  assert_parses_to(
    "delimiter_weird",
    "azb",
    [["a", "b"]],
    core_cfg().with_delimiter((122).to_byte()),
  )
}

///|
test "rust_csv_core_bom_handling" {
  let cfg = core_cfg()
  assert_parses_to("bom_at_start", "\u{feff}a", [["a"]], cfg)
  assert_parses_to("bom_in_field", "a\u{feff}", [["a\u{feff}"]], cfg)
  assert_parses_to("bom_at_field_start", "a,\u{feff}b", [["a", "\u{feff}b"]], cfg)
  // BOM disabled preserves leading BOM
  assert_parses_to("bom_not_stripped", "\u{feff}a", [["\u{feff}a"]], cfg.with_strip_bom(false))
}

///|
test "rust_csv_core_quoting_and_escaping" {
  let cfg = core_cfg()
  assert_parses_to("quote_empty", "\"\"", [[""]], cfg)
  assert_parses_to("quote_lf", "\"\"\n", [[""]], cfg)
  assert_parses_to("quote_space", "\" \"", [[" "]], cfg)
  assert_parses_to("quote_inner_space", "\" a \"", [[" a "]], cfg)
  assert_parses_to("quote_outer_space", "  \"a\"  ", [["  \"a\"  "]], cfg)
  assert_parses_to("quote_doubled", "\"a\"\"b\"", [["a\"b"]], cfg)
  assert_parses_to("quote_embedded_newline_lf", "\"a\nb\",c", [["a\nb", "c"]], cfg)
  assert_parses_to("quote_embedded_newline_crlf", "\"a\r\nb\",c\r\nd,e", [["a\r\nb", "c"], ["d", "e"]], cfg)
  assert_parses_to(
    "quote_change",
    "zaz",
    [["a"]],
    cfg.with_quote((122).to_byte()),
  )
  assert_parses_to(
    "quote_delimiter_lenient",
    ",a,,b",
    [["a,b"]],
    cfg.with_quote((44).to_byte()).with_allow_unclosed_quotes(true),
  )
  assert_parses_to("quote_no_escapes", "\"a\\\"b\"", [["a\\b\""]], cfg)
  assert_parses_to(
    "quote_escapes_no_double",
    "\"a\"\"b\"",
    [["a\"b\""]],
    cfg.with_double_quote(false),
  )
  assert_parses_to(
    "quote_escapes",
    "\"a\\\"b\"",
    [["a\"b"]],
    cfg.with_escape(Option::Some((92).to_byte())),
  )
  assert_parses_to(
    "quote_escapes_change",
    "\"az\"b\"",
    [["a\"b"]],
    cfg.with_escape(Option::Some((122).to_byte())),
  )
  assert_parses_to(
    "quote_escapes_with_comma",
    "\"\\\"A,B\\\"\"",
    [["\"A,B\""]],
    cfg.with_escape(Option::Some((92).to_byte())).with_double_quote(false),
  )
  assert_parses_to(
    "quoting_disabled",
    "\"abc,foo\"",
    [["\"abc", "foo\""]],
    cfg.with_quoting(false),
  )
}

///|
test "rust_csv_core_comments" {
  let cfg_hash = core_cfg().with_comment(Option::Some((35).to_byte()))
  assert_parses_to("comment_1", "foo\n# hi\nbar\n", [["foo"], ["bar"]], cfg_hash)
  assert_parses_to("comment_2", "foo\n # hi\nbar\n", [["foo"], [" # hi"], ["bar"]], cfg_hash)
  assert_parses_to(
    "comment_3",
    "foo\n# hi\nbar\n",
    [["foo"], ["# hi"], ["bar"]],
    core_cfg().with_comment(Option::Some((10).to_byte())),
  )
  assert_parses_to("comment_4", "foo,b#ar,baz", [["foo", "b#ar", "baz"]], cfg_hash)
  assert_parses_to("comment_5", "foo,#bar,baz", [["foo", "#bar", "baz"]], cfg_hash)
}

///|
test "rust_csv_strange_fixture" {
  let strange = "\"\\\"Hacksaw\\\" Jim Duggan\";1987\n\"Bret \\\"Hit Man\\\" Hart\";1984\n# We're not sure when Rafael started, so omit the year.\nRafael Halperin\n\"\\\"Big Cat\\\" Ernie Ladd\";1964\n\"\\\"Macho Man\\\" Randy Savage\";1985\n\"Jake \\\"The Snake\\\" Roberts\";1986\n"
  let cfg = CsvConfig::default()
  .with_has_headers(false)
  .with_delimiter((59).to_byte())
  .with_escape(Option::Some((92).to_byte()))
  .with_flexible(true)
  .with_comment(Option::Some((35).to_byte()))
  assert_parses_to(
    "strange.csv",
    strange,
    [
      ["\"Hacksaw\" Jim Duggan", "1987"],
      ["Bret \"Hit Man\" Hart", "1984"],
      ["Rafael Halperin"],
      ["\"Big Cat\" Ernie Ladd", "1964"],
      ["\"Macho Man\" Randy Savage", "1985"],
      ["Jake \"The Snake\" Roberts", "1986"],
    ],
    cfg,
  )
}

///|
test "rust_csv_trim_modes" {
  let data = "foo,  bar,\tbaz\n  1,  2,  3\n1\t,\t,3\t\t"

  // Trim::All
  let r1 = Reader::from_string_with_config(data, CsvConfig::default().with_trim(Trim::All))
  let h1 = match r1.headers() {
    Ok(h) => h
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  assert_fields_eq(h1.fields(), ["foo", "bar", "baz"], "Trim::All headers")
  let rows1 = match r1.read_all() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(rows1.length() == 2, "Trim::All count")
  assert_fields_eq(rows1[0].fields(), ["1", "2", "3"], "Trim::All row 0")
  assert_fields_eq(rows1[1].fields(), ["1", "", "3"], "Trim::All row 1")

  // Trim::Headers
  let r2 = Reader::from_string_with_config(data, CsvConfig::default().with_trim(Trim::Headers))
  let rows2 = match r2.read_all() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  assert_fields_eq(rows2[0].fields(), ["  1", "  2", "  3"], "Trim::Headers row 0")
  let h2 = match r2.headers() {
    Ok(h) => h
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  assert_fields_eq(h2.fields(), ["foo", "bar", "baz"], "Trim::Headers headers")

  // Trim::Fields
  let r3 = Reader::from_string_with_config(data, CsvConfig::default().with_trim(Trim::Fields))
  let rows3 = match r3.read_all() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  assert_fields_eq(rows3[0].fields(), ["1", "2", "3"], "Trim::Fields row 0")
  let h3 = match r3.headers() {
    Ok(h) => h
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  assert_fields_eq(h3.fields(), ["foo", "  bar", "\tbaz"], "Trim::Fields headers")

  // Trim::All without headers
  let r4 = Reader::from_string_with_config(
    "a1, b1\t,\t c1\t\n",
    CsvConfig::default().with_has_headers(false).with_trim(Trim::All),
  )
  let rows4 = match r4.read_all() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(rows4.length() == 1, "Trim::All no headers count")
  assert_fields_eq(rows4[0].fields(), ["a1", "b1", "c1"], "Trim::All no headers")
}

///|
test "rust_csv_headers_and_positions" {
  let data = "foo,bar,baz\na,b,c\nd,e,f"

  // With headers
  let r1 = Reader::from_string(data)
  let rec0 = match r1.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "expected first data record")
      return ()
    }
  }
  assert_fields_eq(rec0.fields(), ["a", "b", "c"], "rec0 fields")
  debug_assert(rec0.position().eq(Position::new(12L, 2, 1)), "rec0 position")
  let rec1 = match r1.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "expected second data record")
      return ()
    }
  }
  assert_fields_eq(rec1.fields(), ["d", "e", "f"], "rec1 fields")
  debug_assert(rec1.position().eq(Position::new(18L, 3, 2)), "rec1 position")
  match r1.next_record() {
    Ok(None) => ()
    _ => debug_assert(false, "expected EOF")
  }
  let h1 = match r1.headers() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  assert_fields_eq(h1.fields(), ["foo", "bar", "baz"], "cached headers")

  // No headers, calling headers() before next_record()
  let r2 = Reader::from_string_with_config(data, CsvConfig::default().with_has_headers(false))
  let h2 = match r2.headers() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  assert_fields_eq(h2.fields(), ["foo", "bar", "baz"], "no-headers before")
  let all2 = match r2.read_all() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(all2.length() == 3, "no-headers still yields all 3 records")
  debug_assert(all2[0].position().eq(Position::new(0L, 1, 0)), "row 0 pos")
  debug_assert(all2[1].position().eq(Position::new(12L, 2, 1)), "row 1 pos")

  // No headers, calling headers() after reading all
  let r3 = Reader::from_string_with_config(data, CsvConfig::default().with_has_headers(false))
  let all3 = match r3.read_all() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(all3.length() == 3, "all3 length")
  let h3 = match r3.headers() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  assert_fields_eq(h3.fields(), ["foo", "bar", "baz"], "no-headers after")

  // Empty data with and without headers
  let r4 = Reader::from_string("")
  let h4 = match r4.headers() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(h4.len() == 0, "empty headers len 0")
  let r5 = Reader::from_string_with_config("", CsvConfig::default().with_has_headers(false))
  let h5 = match r5.headers() {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, e.to_string())
      return ()
    }
  }
  debug_assert(h5.len() == 0, "empty no-headers len 0")
  match r5.next_record() {
    Ok(None) => ()
    _ => debug_assert(false, "empty EOF")
  }
}

///|
test "rust_csv_unequal_lengths_and_continue" {
  let data = "foo\nbar,baz\nquux"
  let rdr = Reader::from_string_with_config(data, CsvConfig::default().with_has_headers(false))
  let r0 = match rdr.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "expected row 0")
      return ()
    }
  }
  assert_fields_eq(r0.fields(), ["foo"], "row 0 foo")

  match rdr.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::UnequalLengths(exp, got) => {
          debug_assert(exp == 1 && got == 2, "expected 1, got 2")
        }
        _ => debug_assert(false, "expected UnequalLengths")
      }
      debug_assert(e.line() == 2, "error line 2")
      debug_assert(e.byte_offset() == 4L, "error byte offset 4")
    }
    _ => debug_assert(false, "expected UnequalLengths error")
  }

  // Continue reading after unequal length error
  let r2 = match rdr.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "expected row 2 after error")
      return ()
    }
  }
  assert_fields_eq(r2.fields(), ["quux"], "row 2 quux")
  match rdr.next_record() {
    Ok(None) => ()
    _ => debug_assert(false, "expected EOF")
  }

  // Flexible mode succeeds
  assert_parses_to("unequal_ok", "foo\nbar,baz", [["foo"], ["bar", "baz"]], core_cfg())
}

///|
test "rfc4180_unclosed_quote_error_with_position" {
  let data = "a,b\n\"unclosed,field\nstill open"
  let rdr = Reader::from_string_with_config(data, CsvConfig::default().with_has_headers(false))
  let r0 = match rdr.next_record() {
    Ok(Some(v)) => v
    _ => {
      debug_assert(false, "expected row 0")
      return ()
    }
  }
  assert_fields_eq(r0.fields(), ["a", "b"], "row 0 ok")
  match rdr.next_record() {
    Err(e) => {
      match e.kind {
        CsvErrorKind::UnclosedQuote => ()
        _ => debug_assert(false, "expected UnclosedQuote")
      }
      debug_assert(e.line() == 2, "unclosed quote starts on line 2")
      debug_assert(e.byte_offset() == 4L, "unclosed quote starts at byte 4")
    }
    _ => debug_assert(false, "expected UnclosedQuote error")
  }
}

///|
test "read_record_reusable_buffer" {
  let data = "a,b,c\n\"d,e\",\"f\"\"g\",h\nx,y,z\n"
  let rdr = Reader::from_string_with_config(data, CsvConfig::default().with_has_headers(false))
  let rec = Record::new()
  let mut count = 0
  let collected : Array[Array[String]] = []
  while true {
    match rdr.read_record(rec) {
      Ok(true) => {
        collected.push(rec.fields())
        count = count + 1
      }
      Ok(false) => break
      Err(e) => {
        debug_assert(false, "unexpected err: " + e.to_string())
        return ()
      }
    }
  }
  debug_assert(count == 3, "3 records")
  assert_fields_eq(collected[0], ["a", "b", "c"], "rec 0")
  assert_fields_eq(collected[1], ["d,e", "f\"g", "h"], "rec 1")
  assert_fields_eq(collected[2], ["x", "y", "z"], "rec 2")
}
