///| Benchmark 1 (Read): Parse 200,000-row mixed CSV x 2 steady-state rounds.

import "csv"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 {
    args[1]
  } else {
    "/tmp/pion-csv-bench/mixed_200k.csv"
  }
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input file")
      return 1
    }
  }
  let mut total_records : Int64 = 0L
  let mut total_fields : Int64 = 0L
  let mut total_bytes : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut first_sample = ""
  let mut last_sample = ""

  let rec = csv::Record::new()
  let mut round = 0
  while round < 2 {
    let rdr = csv::Reader::from_string(content)
    while true {
      match rdr.read_record(rec) {
        Ok(true) => {
          let nf = rec.len()
          total_records = total_records + 1L
          total_fields = total_fields + nf.to_int64()
          let backing = rec.backing_string()
          let mut f = 0
          while f < nf {
            let s0 = rec.field_start(f)
            let e0 = rec.field_end(f)
            total_bytes = total_bytes + (e0 - s0).to_int64()
            let mut j = s0
            while j < e0 {
              hash = (hash * 131L + backing.code_unit_at(j).to_int64()) & 0x7FFFFFFFL
              j = j + 1
            }
            f = f + 1
          }
          if total_records == 1L {
            first_sample = rec.field(0) + "|" + rec.field(3) + "|" + rec.field(7)
          }
          if total_records == 400000L {
            last_sample = rec.field(0) + "|" + rec.field(3) + "|" + rec.field(7)
          }
        }
        Ok(false) => break
        Err(e) => {
          io_println(world, "parse error: " + e.to_string())
          return 1
        }
      }
    }
    round = round + 1
  }
  io_println(world, "records=" + total_records.to_string())
  io_println(world, "fields=" + total_fields.to_string())
  io_println(world, "bytes=" + total_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  io_println(world, "first=" + first_sample)
  io_println(world, "last=" + last_sample)
  0
}
