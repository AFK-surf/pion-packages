///| Benchmark 2 (Write): Serialize 200,000 structured mixed records x 2 steady-state rounds.

import "csv"

///|
fn build_template_rows() -> Array[Array[String]] {
  let cities = [
    "Tokyo", "San Francisco", "New York", "London", "Paris",
    "Berlin", "Shanghai", "Zürich", "São Paulo", "München",
  ]
  let depts = [
    "Engineering", "Research & Dev", "Sales, EMEA", "Product \"Core\"",
    "Operations", "Finance", "Security", "Design",
  ]
  let notes = [
    "Active account",
    "VIP, priority support",
    "Quoted \"nickname\" inside",
    "Multi-line\naddress note",
    "UTF-8 备注：东京分部",
    "Standard tier 2026",
    "Needs review, Q4",
    "OK",
  ]
  let rows : Array[Array[String]] = []
  let mut i = 0
  while i < 2000 {
    let city = cities[i % cities.length()]
    let dept = depts[(i * 3) % depts.length()]
    let note = notes[(i * 7) % notes.length()]
    let salary = (65000 + (i * 37) % 140000).to_string()
    let score = ((i * 13) % 100).to_string() + ".50"
    let active = if i % 3 != 0 { "true" } else { "false" }
    let id = (i + 1).to_string()
    let name = "User_" + id
    rows.push([id, name, city, dept, salary, score, active, note])
    i = i + 1
  }
  rows
}

///|
pub fn main(world : World) -> Int {
  let rows = build_template_rows()
  let nrows = rows.length()
  let cfg = csv::CsvConfig::default()
  let mut total_bytes : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut first_line = ""
  let mut round = 0
  while round < 2 {
    let wtr = csv::Writer::with_capacity(cfg, 18000000)
    match wtr.write_record(["id", "name", "city", "department", "salary", "score", "active", "note"]) {
      Ok(_) => ()
      Err(_) => return 1
    }
    let mut rep = 0
    while rep < 100 {
      let mut i = 0
      while i < nrows {
        match wtr.write_record(rows[i]) {
          Ok(_) => ()
          Err(_) => return 1
        }
        i = i + 1
      }
      rep = rep + 1
    }
    let out = wtr.finish()
    let n = out.length()
    total_bytes = total_bytes + n.to_int64()
    if round == 0 {
      first_line = out.slice(0, 80)
    }
    let mut j = 0
    while j < n {
      hash = (hash * 131L + out.code_unit_at(j).to_int64()) & 0x7FFFFFFFL
      j = j + 1
    }
    round = round + 1
  }
  io_println(world, "bytes=" + total_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  io_println(world, "head=" + first_line)
  0
}
