///| Wasm32 smoke entry for the `csv` package.

import "csv"

///|
pub fn smoke() -> Int {
  let input = "id,name,note\r\n1,\"Alice, \"\"Ace\"\"\",\"line1\nline2\"\r\n2,Bob,plain\r\n"
  let rdr = csv::Reader::from_string(input)
  let hdr = match rdr.headers() {
    Ok(h) => h
    Err(_) => return -1
  }
  if hdr.len() != 3 || hdr.field(1) != "name" {
    return -2
  }
  let rows = match rdr.read_all() {
    Ok(r) => r
    Err(_) => return -3
  }
  if rows.length() != 2 || rows[0].field(1) != "Alice, \"Ace\"" || rows[0].field(2) != "line1\nline2" {
    return -4
  }
  let wtr = csv::Writer::new()
  match wtr.write_csv_record(hdr) {
    Ok(_) => ()
    Err(_) => return -5
  }
  let mut i = 0
  while i < rows.length() {
    match wtr.write_csv_record(rows[i]) {
      Ok(_) => ()
      Err(_) => return -6
    }
    i = i + 1
  }
  let out = wtr.finish()
  out.length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
