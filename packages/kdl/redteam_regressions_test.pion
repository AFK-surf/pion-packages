///| Regression tests for all red-team audit findings (P0-1, P1-1..P1-4, P2-1..P2-10).

///|
test "rt_p0_1_query_dedup_and_no_combinatorial_explosion" {
  let doc = must_parse("a 0 { a 1 { a 2 { b 3 } } }\nb 4\n")

  // `>> a >> b` must return `b` once, not 3 times
  let r1 = match query(doc, ">> a >> b") {
    Ok(v) => v
    Err(e) => panic("query failed: " + e.message)
  }
  assert_eq_int(r1.length(), 1)
  assert_eq_str(r1[0].name, "b")
  assert_eq_i64(u_i64(u_val(r1[0].arg(0)).as_int()), 3L)

  // `>> a a` must return 2 nodes (a:1, a:2), not 3
  let r2 = match query(doc, ">> a a") {
    Ok(v) => v
    Err(e) => panic("query failed: " + e.message)
  }
  assert_eq_int(r2.length(), 2)
  assert_eq_i64(u_i64(u_val(r2[0].arg(0)).as_int()), 1L)
  assert_eq_i64(u_i64(u_val(r2[1].arg(0)).as_int()), 2L)

  // 48-deep chain with 8-step descendant selector: must return 41 nodes in O(nodes * steps)
  let depth = 48
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_string("a { ")
    i = i + 1
  }
  i = 0
  while i < depth {
    sb.write_string("}")
    i = i + 1
  }
  let deep = must_parse(sb.to_string())
  let r3 = match query(deep, "a a a a a a a a") {
    Ok(v) => v
    Err(e) => panic("deep query failed: " + e.message)
  }
  assert_eq_int(r3.length(), depth - 7)

  // Backtracking edge case: `c > a b` on `c { a { x { a { b } } } }`
  let tricky = must_parse("c { a { x { a { b 9 } } } }\n")
  let r4 = match query(tricky, "c > a b") {
    Ok(v) => v
    Err(e) => panic("tricky query failed: " + e.message)
  }
  assert_eq_int(r4.length(), 1)
  assert_eq_i64(u_i64(u_val(r4[0].arg(0)).as_int()), 9L)

  // >64 steps exercises the general vector DP path
  let sb70 = StringBuilder::new()
  i = 0
  while i < 70 {
    sb70.write_string("a { ")
    i = i + 1
  }
  i = 0
  while i < 70 {
    sb70.write_string("}")
    i = i + 1
  }
  let deep70 = must_parse(sb70.to_string())
  let qsb = StringBuilder::new()
  i = 0
  while i < 66 {
    if i > 0 {
      qsb.write_string(" ")
    }
    qsb.write_string("a")
    i = i + 1
  }
  let r5 = match query(deep70, qsb.to_string()) {
    Ok(v) => v
    Err(e) => panic("66-step query failed: " + e.message)
  }
  assert_eq_int(r5.length(), 5)
}

///|
test "rt_p1_1_multiline_ws_escapes_before_dedent" {
  // Spec example: whitespace escape joins a less-indented line and appears in closing line
  let d1 = must_parse("n \"\"\"\n  foo \\\nbar\n  baz\n  \\   \"\"\"\n")
  assert_eq_str(u_str(u_val(d1.nodes[0].arg(0)).as_str()), "foo bar\nbaz")

  // Whitespace escape eats final newlines and determines closing prefix
  let d2 = must_parse("n \"\"\"\n    a\n   \\\n\r\n\"\"\"\n")
  assert_eq_str(u_str(u_val(d2.nodes[0].arg(0)).as_str()), " a")

  // Whitespace escape joins shallow line
  let d3 = must_parse("n \"\"\"\n    hey\n   x\\\n\t   how\n  \"\"\"\n")
  assert_eq_str(u_str(u_val(d3.nodes[0].arg(0)).as_str()), "  hey\n xhow")

  // Escaped space `\s` at line start counts as content, not indentation
  let d4 = must_parse("n \"\"\"\n  \\s a\n  \"\"\"\n")
  assert_eq_str(u_str(u_val(d4.nodes[0].arg(0)).as_str()), "  a")

  // Escaping final newline onto content line before closing `"""` must be rejected
  assert_parse_err("n \"\"\"\n  foo\n  bar\\\n  \"\"\"\n", "ws escape into closing quotes")
}

///|
test "rt_p1_2_and_p2_8_wide_props_and_last_wins_position" {
  // Small node (< 8 props): duplicate property moves to last occurrence's position
  let d1 = must_parse("n a=(t)1 b=2 a=3\n")
  assert_eq_str(format(d1), "n b=2 a=3\n")
  assert_true(is_none_str(u_entry(d1.nodes[0].prop_entry("a")).ty), "last prop clears old type")

  // Wide node (> 8 props, promotes to Map): 200 distinct + duplicate properties
  let sb = StringBuilder::new()
  sb.write_string("wide")
  let mut i = 0
  while i < 200 {
    sb.write_string(" k" + i.to_string() + "=" + i.to_string())
    i = i + 1
  }
  // Overwrite k0 at the end; it must move to the last slot
  sb.write_string(" k0=999\n")
  let d2 = must_parse(sb.to_string())
  let nd = d2.nodes[0]
  assert_eq_int(nd.entries.length(), 200)
  assert_eq_i64(u_i64(u_val(nd.prop("k0")).as_int()), 999L)
  // Last entry must be k0=999
  let last = nd.entries[199]
  assert_eq_str(u_str(last.name), "k0")
  assert_eq_i64(u_i64(last.value.as_int()), 999L)
}

///|
test "rt_p1_3_and_p2_6_query_numeric_filters_union_and_quoted_key" {
  let doc = must_parse(
    "n x=1.5 y=16 z=1000.0 w=-2.5e-1 b=5 o=15 \"0\"=5\n" +
    "m x=2.0 \"0\"=9\n",
  )
  assert_eq_int(match query(doc, "n[x=1.5]") { Ok(v) => v.length(); Err(_) => -1 }, 1)
  assert_eq_int(match query(doc, "n[y=0x10]") { Ok(v) => v.length(); Err(_) => -1 }, 1)
  assert_eq_int(match query(doc, "n[z=1e3]") { Ok(v) => v.length(); Err(_) => -1 }, 1)
  assert_eq_int(match query(doc, "n[z=1e+3]") { Ok(v) => v.length(); Err(_) => -1 }, 1)
  assert_eq_int(match query(doc, "n[w=-0.25]") { Ok(v) => v.length(); Err(_) => -1 }, 1)
  assert_eq_int(match query(doc, "n[b=0b101]") { Ok(v) => v.length(); Err(_) => -1 }, 1)
  assert_eq_int(match query(doc, "n[o=0o17]") { Ok(v) => v.length(); Err(_) => -1 }, 1)

  // Quoted numeric property name `["0"=5]` filters property "0", not positional arg 0
  let q0 = match query(doc, "*[\"0\"=5]") {
    Ok(v) => v
    Err(e) => panic("quoted numeric prop query failed: " + e.message)
  }
  assert_eq_int(q0.length(), 1)
  assert_eq_str(q0[0].name, "n")

  // Union deduplication and selector order
  let u1 = match query(doc, "n, n") {
    Ok(v) => v
    Err(e) => panic("union dedup failed: " + e.message)
  }
  assert_eq_int(u1.length(), 1)
  let u2 = match query(doc, "m, n") {
    Ok(v) => v
    Err(e) => panic("union order failed: " + e.message)
  }
  assert_eq_int(u2.length(), 2)
  assert_eq_str(u2[0].name, "m")
  assert_eq_str(u2[1].name, "n")
}

///|
test "rt_p2_2_to_p2_9_grammar_format_v1_and_limits" {
  // P2-2: VT (U+000B) is unicode-space per official suite
  let vt_doc = must_parse("node\u{000B}arg\n")
  assert_eq_int(vt_doc.nodes.length(), 1)
  assert_eq_str(u_str(u_val(vt_doc.nodes[0].arg(0)).as_str()), "arg")

  // P2-3: escline in node-space positions (type annotation, around '=', after type)
  let esc_doc = must_parse("n ( \\\n u8 )1 a \\\n = \\\n 2 (i32)\\\n 3\n")
  let en = esc_doc.nodes[0]
  assert_eq_str(u_str(u_entry(en.arg_entry(0)).ty), "u8")
  assert_eq_i64(u_i64(u_val(en.arg(0)).as_int()), 1L)
  assert_eq_i64(u_i64(u_val(en.prop("a")).as_int()), 2L)
  assert_eq_str(u_str(u_entry(en.arg_entry(1)).ty), "i32")
  assert_eq_i64(u_i64(u_val(en.arg(1)).as_int()), 3L)

  // P2-4a: stray semicolons rejected, slashdashed node with `;` inside block accepted
  assert_parse_err("n;;\n", "double semicolon")
  assert_parse_err(";n\n", "leading semicolon")
  assert_parse_err("n 1\n;\n", "semicolon on own line")
  assert_parse_err("n {\n  a\n;}\n", "semicolon after newline in block")
  let sd_semi = must_parse("n {\n  /- a;\n  b\n}\n")
  assert_eq_int(sd_semi.nodes[0].children().length(), 1)
  assert_eq_str(sd_semi.nodes[0].children()[0].name, "b")

  // P2-4a: format_compact keeps space before `{`
  let fc_doc = must_parse("n 1 {\n  a\n}\n")
  assert_eq_str(format_compact(fc_doc), "n 1 {a}")

  // P2-5: KDL v1 identifiers allow `#`
  let v1_doc = match parse_v1("a#b 1\n") {
    Ok(d) => d
    Err(e) => panic("v1 hash ident failed: " + e.message)
  }
  assert_eq_str(v1_doc.nodes[0].name, "a#b")
  assert_eq_i64(u_i64(u_val(v1_doc.nodes[0].arg(0)).as_int()), 1L)

  // P2-7: explicit empty children block `node {}` preserved across format & format_compact
  let empty_ch = must_parse("node {}\n")
  assert_true(empty_ch.nodes[0].has_children_block, "has_children_block true")
  assert_eq_str(format(empty_ch), "node {}\n")
  assert_eq_str(format_compact(empty_ch), "node {}")
  let empty_after_sd = must_parse("node /-{ a } {}\n")
  assert_eq_str(format(empty_after_sd), "node {}\n")
  assert_eq_str(format_compact(empty_after_sd), "node {}")
  let no_ch = must_parse("node\n")
  assert_true(!no_ch.nodes[0].has_children_block, "has_children_block false")
  assert_eq_str(format(no_ch), "node\n")

  // P2-9: negative KdlLimits rejected; 0 remains unlimited
  match parse_with_limits("a { b }", KdlLimits::new(-1, -1, -1)) {
    Ok(_) => panic("expected LimitExceeded for negative limits")
    Err(e) => assert_true(e.is_kind(KdlErrorKind::LimitExceeded), "negative limits kind")
  }
  match parse_with_limits("a { b }", KdlLimits::new(0, 0, 0)) {
    Ok(d) => assert_eq_int(d.nodes.length(), 1)
    Err(e) => panic("zero limits should be unlimited: " + e.message)
  }

  // P2-1: out-of-Int64 integers explicitly return NumberOverflow (never wrap)
  assert_parse_err_kind("n 9223372036854775808\n", KdlErrorKind::NumberOverflow, "i64 max + 1")
  assert_parse_err_kind("n -9223372036854775809\n", KdlErrorKind::NumberOverflow, "i64 min - 1")
  assert_parse_err_kind("n 0xffffffffffffffff\n", KdlErrorKind::NumberOverflow, "u64 max hex")
}
