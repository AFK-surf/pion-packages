///| Steady-state head-to-head KDL v2 benchmark driver (Pion Native).

import "kdl"

let mod_v : Int64 = 1000000007L

fn poly_hash(s : String) -> Int64 {
  let mut h : Int64 = 17L
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h * 131L + s.code_unit_at(i).to_int64()) % mod_v
    i = i + 1
  }
  h
}

struct Stats {
  mut nodes : Int64
  mut args : Int64
  mut props : Int64
  mut strings : Int64
  mut ints : Int64
  mut floats : Int64
  mut bools : Int64
  mut nulls : Int64
  mut int_sum : Int64
  mut str_bytes : Int64
  mut hash : Int64
}

fn walk_doc(st : Stats, doc : kdl::KdlDocument) -> Unit {
  let stack : Array[kdl::KdlNode] = []
  let mut r = doc.nodes.length() - 1
  while r >= 0 {
    stack.push(doc.nodes[r])
    r = r - 1
  }
  while stack.length() > 0 {
    let node = match stack.pop() {
      Some(n) => n
      None => break
    }
    st.nodes = st.nodes + 1L
    st.hash = (st.hash + poly_hash(node.name)) % mod_v
    match node.ty {
      Some(t) => st.hash = (st.hash + poly_hash(t)) % mod_v
      None => ()
    }
    let en = node.entries.length()
    let mut i = 0
    while i < en {
      let entry = node.entries[i]
      match entry.name {
        Some(k) => {
          st.props = st.props + 1L
          st.hash = (st.hash + poly_hash(k)) % mod_v
        }
        None => st.args = st.args + 1L
      }
      match entry.ty {
        Some(t) => st.hash = (st.hash + poly_hash(t)) % mod_v
        None => ()
      }
      match entry.value {
        kdl::KdlValue::Str(s) => {
          st.strings = st.strings + 1L
          st.str_bytes = st.str_bytes + s.length().to_int64()
          st.hash = (st.hash + poly_hash(s)) % mod_v
        }
        kdl::KdlValue::Int(n) => {
          st.ints = st.ints + 1L
          let m = ((n % mod_v) + mod_v) % mod_v
          st.int_sum = (st.int_sum + m) % mod_v
        }
        kdl::KdlValue::Float(f) => {
          st.floats = st.floats + 1L
          let tag : Int64 = if f != f {
            3L
          } else if f == (1.0 / 0.0) {
            1L
          } else if f == (-1.0 / 0.0) {
            2L
          } else {
            let scaled = f * 1000.0
            let rounded = if scaled >= 0.0 {
              (scaled + 0.5).to_int64()
            } else {
              (scaled - 0.5).to_int64()
            }
            ((rounded % mod_v) + mod_v) % mod_v
          }
          st.hash = (st.hash + tag) % mod_v
        }
        kdl::KdlValue::Bool(b) => {
          st.bools = st.bools + 1L
          st.hash = (st.hash + (if b { 1L } else { 0L })) % mod_v
        }
        kdl::KdlValue::Null => st.nulls = st.nulls + 1L
      }
      i = i + 1
    }
    let cn = node.child_nodes.length()
    let mut j = cn - 1
    while j >= 0 {
      stack.push(node.child_nodes[j])
      j = j - 1
    }
  }
}

fn print_stats(world : World, mode : String, iters : Int, st : Stats) -> Unit {
  io_println(world, "mode=" + mode)
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "nodes=" + st.nodes.to_string())
  io_println(world, "args=" + st.args.to_string())
  io_println(world, "props=" + st.props.to_string())
  io_println(world, "strings=" + st.strings.to_string())
  io_println(world, "ints=" + st.ints.to_string())
  io_println(world, "floats=" + st.floats.to_string())
  io_println(world, "bools=" + st.bools.to_string())
  io_println(world, "nulls=" + st.nulls.to_string())
  io_println(world, "int_sum=" + st.int_sum.to_string())
  io_println(world, "str_bytes=" + st.str_bytes.to_string())
  io_println(world, "hash=" + st.hash.to_string())
}

fn parse_pos_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      acc = acc * 10 + (b - 48)
    }
    i = i + 1
  }
  acc
}

fn run_w1(world : World, path : String, iters : Int) -> Int {
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read w1 input")
      return 1
    }
  }
  let st = Stats::{
    nodes: 0L,
    args: 0L,
    props: 0L,
    strings: 0L,
    ints: 0L,
    floats: 0L,
    bools: 0L,
    nulls: 0L,
    int_sum: 0L,
    str_bytes: 0L,
    hash: 0L,
  }
  let mut i = 0
  while i < iters {
    match kdl::parse(src) {
      Ok(doc) => walk_doc(st, doc)
      Err(e) => {
        io_println(world, "parse w1 error: " + e.message)
        return 1
      }
    }
    i = i + 1
  }
  print_stats(world, "w1_parse", iters, st)
  0
}

fn run_w2(world : World, path : String, iters : Int) -> Int {
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read w2 input")
      return 1
    }
  }
  let st = Stats::{
    nodes: 0L,
    args: 0L,
    props: 0L,
    strings: 0L,
    ints: 0L,
    floats: 0L,
    bools: 0L,
    nulls: 0L,
    int_sum: 0L,
    str_bytes: 0L,
    hash: 0L,
  }
  let mut i = 0
  while i < iters {
    let doc = match kdl::parse(src) {
      Ok(d) => d
      Err(e) => {
        io_println(world, "parse w2 error: " + e.message)
        return 1
      }
    }
    let formatted = kdl::format(doc)
    let doc2 = match kdl::parse(formatted) {
      Ok(d) => d
      Err(e) => {
        io_println(world, "reparse w2 error: " + e.message)
        return 1
      }
    }
    walk_doc(st, doc2)
    i = i + 1
  }
  print_stats(world, "w2_roundtrip", iters, st)
  0
}

fn run_w3(world : World, path : String, iters : Int) -> Int {
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read w3 input")
      return 1
    }
  }
  let mut matched_routes : Int64 = 0L
  let mut total_rate : Int64 = 0L
  let mut total_weight : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut i = 0
  while i < iters {
    let doc = match kdl::parse(src) {
      Ok(d) => d
      Err(e) => {
        io_println(world, "parse w3 error: " + e.message)
        return 1
      }
    }
    match doc.get("service") {
      Some(svc) => {
        match svc.arg(0) {
          Some(kdl::KdlValue::Str(nm)) => hash = (hash + poly_hash(nm)) % mod_v
          _ => ()
        }
        let kids = svc.children()
        let mut j = 0
        while j < kids.length() {
          let c = kids[j]
          if c.name == "route" {
            let auth = match c.prop("auth") {
              Some(kdl::KdlValue::Bool(b)) => b
              _ => false
            }
            if auth {
              matched_routes = matched_routes + 1L
              match c.prop("rate-limit") {
                Some(kdl::KdlValue::Int(rl)) => total_rate = total_rate + rl
                _ => ()
              }
              match c.arg(0) {
                Some(kdl::KdlValue::Str(pa)) => hash = (hash + poly_hash(pa)) % mod_v
                _ => ()
              }
            }
          } else if c.name == "upstream" {
            match c.prop("weight") {
              Some(kdl::KdlValue::Int(w)) => total_weight = total_weight + w
              _ => ()
            }
          }
          j = j + 1
        }
      }
      None => ()
    }
    i = i + 1
  }
  io_println(world, "mode=w3_query")
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "matched_routes=" + matched_routes.to_string())
  io_println(world, "total_rate=" + total_rate.to_string())
  io_println(world, "total_weight=" + total_weight.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: kdl_bench_pion <w1|w2|w3> <file> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_pos_int(args[3])
  if mode == "w1" {
    run_w1(world, path, iters)
  } else if mode == "w2" {
    run_w2(world, path, iters)
  } else if mode == "w3" {
    run_w3(world, path, iters)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
