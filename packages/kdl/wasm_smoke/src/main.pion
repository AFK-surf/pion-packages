///| Wasm32 + Native 4-mode smoke entry for `packages/kdl`.

import "kdl"

fn smoke() -> Int {
  // 1. KDL v2 parse: multiline, raw, types, slashdash, numbers, duplicate props
  let src =
  "(app)service \"gateway\" port=8080 port=9090 tls=#true ratio=-0.0 limit=#inf {\n" +
  "    /- disabled #true\n" +
  "    banner \"\"\"\n" +
  "        hello\n" +
  "          world\n" +
  "        \"\"\"\n" +
  "    raw #\"a\\nb\"#\n" +
  "    (u8)worker 1 role=\"http\"\n" +
  "    (u8)worker 2 role=\"grpc\"\n" +
  "}\n"
  let doc = match kdl::parse(src) {
    Ok(d) => d
    Err(_) => return -1
  }
  let svc = match doc.get("service") {
    Some(n) => n
    None => return -2
  }
  match svc.prop("port") {
    Some(v) => {
      match v.as_int() {
        Some(p) => {
          if p != 9090L {
            return -3
          }
        }
        None => return -4
      }
    }
    None => return -5
  }
  match svc.child("banner") {
    Some(b) => {
      match b.arg(0) {
        Some(v) => {
          match v.as_str() {
            Some(s) => {
              if s != "hello\n  world" {
                return -6
              }
            }
            None => return -7
          }
        }
        None => return -8
      }
    }
    None => return -9
  }

  // 2. Canonical & compact format roundtrip + idempotency
  let fmt1 = kdl::format(doc)
  let doc2 = match kdl::parse(fmt1) {
    Ok(d) => d
    Err(_) => return -10
  }
  if !doc.equals(doc2) {
    return -11
  }
  if kdl::format(doc2) != fmt1 {
    return -12
  }
  let compact = kdl::format_compact(doc)
  let doc3 = match kdl::parse(compact) {
    Ok(d) => d
    Err(_) => return -13
  }
  if !doc.equals(doc3) {
    return -14
  }

  // 3. Query engine
  match kdl::query(doc, "service > (u8)worker[role=\"grpc\"]") {
    Ok(res) => {
      if res.length() != 1 {
        return -15
      }
    }
    Err(_) => return -16
  }

  // 4. KDL v1 compat mode
  let v1_doc = match kdl::parse_v1("cfg true false null r#\"a\\/b\"#") {
    Ok(d) => d
    Err(_) => return -17
  }
  if v1_doc.nodes.length() != 1 {
    return -18
  }

  // 5. Iterative deep nesting + KdlLimits enforcement (0 traps on Wasm32)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 200 {
    sb.write_string("n { ")
    i = i + 1
  }
  sb.write_string("leaf 1")
  i = 0
  while i < 200 {
    sb.write_string(" }")
    i = i + 1
  }
  let deep = sb.to_string()
  match kdl::parse_with_limits(deep, kdl::KdlLimits::new(32, 10000, 100000)) {
    Ok(_) => return -19
    Err(e) => {
      if !e.is_kind(kdl::KdlErrorKind::LimitExceeded) {
        return -20
      }
    }
  }
  match kdl::parse_with_limits(deep, kdl::KdlLimits::new(300, 10000, 100000)) {
    Ok(d) => {
      match kdl::query(d, ">> leaf") {
        Ok(ls) => {
          if ls.length() != 1 {
            return -21
          }
        }
        Err(_) => return -22
      }
    }
    Err(_) => return -23
  }
  5
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "kdl_wasm_smoke: OK checks=" + r.to_string())
    0
  } else {
    io_println(world, "kdl_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
