///| Core public types, AST, error diagnostics, limits, and accessors for `kdl`.

///| 1-based line/column and 0-based byte offset in source text.
pub struct Pos {
  pub line : Int
  pub column : Int
  pub offset : Int
}

///| Construct a `Pos`.
pub fn Pos::new(line : Int, column : Int, offset : Int) -> Pos {
  Pos::{ line: line, column: column, offset: offset }
}

///| Starting position `(line=1, column=1, offset=0)`.
pub fn Pos::zero() -> Pos {
  Pos::{ line: 1, column: 1, offset: 0 }
}

///| Half-open source span `[start, end)`.
pub struct Span {
  pub start : Pos
  pub end : Pos
}

///| Construct a `Span`.
pub fn Span::new(start : Pos, end : Pos) -> Span {
  Span::{ start: start, end: end }
}

///| Zero span at document start.
pub fn Span::zero() -> Span {
  Span::{ start: Pos::zero(), end: Pos::zero() }
}

///| Categorized KDL error kinds.
pub enum KdlErrorKind {
  InvalidUtf8
  DisallowedCodePoint
  SyntaxError
  InvalidEscape
  InvalidNumber
  NumberOverflow
  InvalidString
  InvalidIndentation
  UnterminatedComment
  UnterminatedString
  UnterminatedBlock
  InvalidSlashdash
  InvalidQuery
  LimitExceeded
  Unimplemented
}

///| Return the canonical name of a `KdlErrorKind`.
pub fn error_kind_as_str(kind : KdlErrorKind) -> String {
  match kind {
    KdlErrorKind::InvalidUtf8 => "InvalidUtf8"
    KdlErrorKind::DisallowedCodePoint => "DisallowedCodePoint"
    KdlErrorKind::SyntaxError => "SyntaxError"
    KdlErrorKind::InvalidEscape => "InvalidEscape"
    KdlErrorKind::InvalidNumber => "InvalidNumber"
    KdlErrorKind::NumberOverflow => "NumberOverflow"
    KdlErrorKind::InvalidString => "InvalidString"
    KdlErrorKind::InvalidIndentation => "InvalidIndentation"
    KdlErrorKind::UnterminatedComment => "UnterminatedComment"
    KdlErrorKind::UnterminatedString => "UnterminatedString"
    KdlErrorKind::UnterminatedBlock => "UnterminatedBlock"
    KdlErrorKind::InvalidSlashdash => "InvalidSlashdash"
    KdlErrorKind::InvalidQuery => "InvalidQuery"
    KdlErrorKind::LimitExceeded => "LimitExceeded"
    KdlErrorKind::Unimplemented => "Unimplemented"
  }
}

///| Compare two `KdlErrorKind` values for equality.
pub fn error_kind_eq(a : KdlErrorKind, b : KdlErrorKind) -> Bool {
  error_kind_as_str(a) == error_kind_as_str(b)
}

///| Structured KDL diagnostic with kind, message, and source position.
pub struct KdlError {
  pub kind : KdlErrorKind
  pub message : String
  pub line : Int
  pub column : Int
  pub offset : Int
}

///| Construct a `KdlError`.
pub fn KdlError::new(
  kind : KdlErrorKind,
  message : String,
  line : Int,
  column : Int,
  offset : Int,
) -> KdlError {
  KdlError::{
    kind: kind,
    message: message,
    line: line,
    column: column,
    offset: offset,
  }
}

///| Construct an `Unimplemented` error.
pub fn KdlError::unimplemented(message : String) -> KdlError {
  KdlError::new(KdlErrorKind::Unimplemented, message, 1, 1, 0)
}

///| Check whether this error matches `kind`.
pub fn KdlError::is_kind(self : KdlError, kind : KdlErrorKind) -> Bool {
  error_kind_eq(self.kind, kind)
}

///| Safety budget limits for parsing KDL documents.
///| Protects both Native and Wasm32 targets against pathological inputs.
///| `0` disables the corresponding limit; negative values are rejected with `LimitExceeded`.
pub struct KdlLimits {
  pub max_depth : Int
  pub max_nodes : Int
  pub max_tokens : Int
}

///| Construct a `KdlLimits`.
pub fn KdlLimits::new(
  max_depth : Int,
  max_nodes : Int,
  max_tokens : Int,
) -> KdlLimits {
  KdlLimits::{
    max_depth: max_depth,
    max_nodes: max_nodes,
    max_tokens: max_tokens,
  }
}

///| Default safety limits (`max_depth=128`, `max_nodes=1_000_000`, `max_tokens=5_000_000`).
pub fn KdlLimits::default() -> KdlLimits {
  KdlLimits::{
    max_depth: 128,
    max_nodes: 1000000,
    max_tokens: 5000000,
  }
}

///| KDL scalar value.
pub enum KdlValue {
  Str(String)
  Int(Int64)
  Float(Double)
  Bool(Bool)
  Null
}

///| Extract string value if `KdlValue::Str`.
pub fn KdlValue::as_str(self : KdlValue) -> Option[String] {
  match self {
    KdlValue::Str(s) => Some(s)
    _ => None
  }
}

///| Extract integer value if `KdlValue::Int`.
pub fn KdlValue::as_int(self : KdlValue) -> Option[Int64] {
  match self {
    KdlValue::Int(n) => Some(n)
    _ => None
  }
}

///| Extract floating-point value if `KdlValue::Float`.
pub fn KdlValue::as_float(self : KdlValue) -> Option[Double] {
  match self {
    KdlValue::Float(f) => Some(f)
    _ => None
  }
}

///| Extract boolean value if `KdlValue::Bool`.
pub fn KdlValue::as_bool(self : KdlValue) -> Option[Bool] {
  match self {
    KdlValue::Bool(b) => Some(b)
    _ => None
  }
}

///| Return `true` if `KdlValue::Null`.
pub fn KdlValue::is_null(self : KdlValue) -> Bool {
  match self {
    KdlValue::Null => true
    _ => false
  }
}

///| Return `true` if `KdlValue::Float(f)` and `f` is NaN.
pub fn KdlValue::is_nan(self : KdlValue) -> Bool {
  match self {
    KdlValue::Float(f) => f != f
    _ => false
  }
}

///| Bit-accurate equality on `KdlValue` (treats NaN == NaN, distinguishes +0.0 vs -0.0).
pub fn KdlValue::equals(self : KdlValue, other : KdlValue) -> Bool {
  match self {
    KdlValue::Str(a) => {
      match other {
        KdlValue::Str(b) => a == b
        _ => false
      }
    }
    KdlValue::Int(a) => {
      match other {
        KdlValue::Int(b) => a == b
        _ => false
      }
    }
    KdlValue::Bool(a) => {
      match other {
        KdlValue::Bool(b) => a == b
        _ => false
      }
    }
    KdlValue::Null => {
      match other {
        KdlValue::Null => true
        _ => false
      }
    }
    KdlValue::Float(a) => {
      match other {
        KdlValue::Float(b) => {
          if a != a && b != b {
            true
          } else {
            a.to_bits() == b.to_bits()
          }
        }
        _ => false
      }
    }
  }
}

///| A single entry on a KDL node: either a positional argument (`name == None`)
///| or a named property (`name == Some(key)`), with an optional type annotation.
pub struct KdlEntry {
  pub name : Option[String]
  pub ty : Option[String]
  pub value : KdlValue
}

///| Construct a positional argument entry.
pub fn KdlEntry::arg(value : KdlValue, ty : Option[String]) -> KdlEntry {
  KdlEntry::{ name: None, ty: ty, value: value }
}

///| Construct a named property entry.
pub fn KdlEntry::prop(
  name : String,
  value : KdlValue,
  ty : Option[String],
) -> KdlEntry {
  KdlEntry::{ name: Some(name), ty: ty, value: value }
}

///| Return `true` if this entry is a positional argument.
pub fn KdlEntry::is_arg(self : KdlEntry) -> Bool {
  match self.name {
    None => true
    Some(_) => false
  }
}

///| Return `true` if this entry is a named property.
pub fn KdlEntry::is_prop(self : KdlEntry) -> Bool {
  match self.name {
    Some(_) => true
    None => false
  }
}

fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match a {
    None => {
      match b {
        None => true
        Some(_) => false
      }
    }
    Some(sa) => {
      match b {
        None => false
        Some(sb) => sa == sb
      }
    }
  }
}

///| Compare two `KdlEntry` values for structural equality.
pub fn KdlEntry::equals(self : KdlEntry, other : KdlEntry) -> Bool {
  if !opt_str_eq(self.name, other.name) {
    return false
  }
  if !opt_str_eq(self.ty, other.ty) {
    return false
  }
  self.value.equals(other.value)
}

///| A KDL node with name, optional type annotation, entries (args & props),
///| child nodes, and whether an explicit `{ ... }` children block was present.
pub struct KdlNode {
  pub name : String
  pub ty : Option[String]
  pub entries : Array[KdlEntry]
  pub child_nodes : Array[KdlNode]
  pub has_children_block : Bool
}

///| Construct a `KdlNode`.
pub fn KdlNode::new(
  name : String,
  ty : Option[String],
  entries : Array[KdlEntry],
  child_nodes : Array[KdlNode],
) -> KdlNode {
  KdlNode::{
    name: name,
    ty: ty,
    entries: entries,
    child_nodes: child_nodes,
    has_children_block: child_nodes.length() > 0,
  }
}

///| Construct a `KdlNode` with explicit `has_children_block` flag (preserving `node {}`).
pub fn KdlNode::with_children_block(
  name : String,
  ty : Option[String],
  entries : Array[KdlEntry],
  child_nodes : Array[KdlNode],
  has_children_block : Bool,
) -> KdlNode {
  KdlNode::{
    name: name,
    ty: ty,
    entries: entries,
    child_nodes: child_nodes,
    has_children_block: has_children_block || child_nodes.length() > 0,
  }
}

///| Return the child nodes of this node.
pub fn KdlNode::children(self : KdlNode) -> Array[KdlNode] {
  self.child_nodes
}

///| Return the `index`-th positional argument value (0-based), if present.
pub fn KdlNode::arg(self : KdlNode, index : Int) -> Option[KdlValue] {
  if index < 0 {
    return None
  }
  let mut seen = 0
  let n = self.entries.length()
  let mut i = 0
  while i < n {
    let e = self.entries[i]
    if e.is_arg() {
      if seen == index {
        return Some(e.value)
      }
      seen = seen + 1
    }
    i = i + 1
  }
  None
}

///| Return the `index`-th positional argument entry (including type annotation), if present.
pub fn KdlNode::arg_entry(self : KdlNode, index : Int) -> Option[KdlEntry] {
  if index < 0 {
    return None
  }
  let mut seen = 0
  let n = self.entries.length()
  let mut i = 0
  while i < n {
    let e = self.entries[i]
    if e.is_arg() {
      if seen == index {
        return Some(e)
      }
      seen = seen + 1
    }
    i = i + 1
  }
  None
}

///| Return all positional argument values in order.
pub fn KdlNode::args(self : KdlNode) -> Array[KdlValue] {
  let out : Array[KdlValue] = []
  let n = self.entries.length()
  let mut i = 0
  while i < n {
    let e = self.entries[i]
    if e.is_arg() {
      out.push(e.value)
    }
    i = i + 1
  }
  out
}

///| Look up a property value by key (last-wins semantics).
pub fn KdlNode::prop(self : KdlNode, key : String) -> Option[KdlValue] {
  let mut i = self.entries.length() - 1
  while i >= 0 {
    let e = self.entries[i]
    match e.name {
      Some(k) => {
        if k == key {
          return Some(e.value)
        }
      }
      None => ()
    }
    i = i - 1
  }
  None
}

///| Look up a property entry (including type annotation) by key (last-wins).
pub fn KdlNode::prop_entry(self : KdlNode, key : String) -> Option[KdlEntry] {
  let mut i = self.entries.length() - 1
  while i >= 0 {
    let e = self.entries[i]
    match e.name {
      Some(k) => {
        if k == key {
          return Some(e)
        }
      }
      None => ()
    }
    i = i - 1
  }
  None
}

///| Return all named properties as `(key, value)` pairs.
pub fn KdlNode::props(self : KdlNode) -> Array[(String, KdlValue)] {
  let out : Array[(String, KdlValue)] = []
  let n = self.entries.length()
  let mut i = 0
  while i < n {
    let e = self.entries[i]
    match e.name {
      Some(k) => out.push((k, e.value))
      None => ()
    }
    i = i + 1
  }
  out
}

///| Find the first direct child node with the given name.
pub fn KdlNode::child(self : KdlNode, name : String) -> Option[KdlNode] {
  let n = self.child_nodes.length()
  let mut i = 0
  while i < n {
    let c = self.child_nodes[i]
    if c.name == name {
      return Some(c)
    }
    i = i + 1
  }
  None
}

///| Find all direct child nodes with the given name.
pub fn KdlNode::children_named(self : KdlNode, name : String) -> Array[KdlNode] {
  let out : Array[KdlNode] = []
  let n = self.child_nodes.length()
  let mut i = 0
  while i < n {
    let c = self.child_nodes[i]
    if c.name == name {
      out.push(c)
    }
    i = i + 1
  }
  out
}

///| Top-level KDL document containing root nodes.
pub struct KdlDocument {
  pub nodes : Array[KdlNode]
}

///| Construct a `KdlDocument`.
pub fn KdlDocument::new(nodes : Array[KdlNode]) -> KdlDocument {
  KdlDocument::{ nodes: nodes }
}

///| Return an empty `KdlDocument`.
pub fn KdlDocument::empty() -> KdlDocument {
  KdlDocument::{ nodes: [] }
}

///| Return the first top-level node with the given name.
pub fn KdlDocument::get(self : KdlDocument, name : String) -> Option[KdlNode] {
  let n = self.nodes.length()
  let mut i = 0
  while i < n {
    let nd = self.nodes[i]
    if nd.name == name {
      return Some(nd)
    }
    i = i + 1
  }
  None
}

///| Return all top-level nodes with the given name.
pub fn KdlDocument::get_all(self : KdlDocument, name : String) -> Array[KdlNode] {
  let out : Array[KdlNode] = []
  let n = self.nodes.length()
  let mut i = 0
  while i < n {
    let nd = self.nodes[i]
    if nd.name == name {
      out.push(nd)
    }
    i = i + 1
  }
  out
}

///| Return the first positional argument of the first top-level node named `name`.
pub fn KdlDocument::get_arg(
  self : KdlDocument,
  name : String,
) -> Option[KdlValue] {
  match self.get(name) {
    Some(nd) => nd.arg(0)
    None => None
  }
}

///| Iterative structural equality for two `KdlDocument`s (stack-safe).
pub fn KdlDocument::equals(self : KdlDocument, other : KdlDocument) -> Bool {
  if self.nodes.length() != other.nodes.length() {
    return false
  }
  let stack : Array[(KdlNode, KdlNode)] = []
  let mut i = 0
  while i < self.nodes.length() {
    stack.push((self.nodes[i], other.nodes[i]))
    i = i + 1
  }
  while stack.length() > 0 {
    let pair = match stack.pop() {
      Some(p) => p
      None => break
    }
    let (a, b) = pair
    if a.name != b.name {
      return false
    }
    if !opt_str_eq(a.ty, b.ty) {
      return false
    }
    if a.entries.length() != b.entries.length() {
      return false
    }
    let mut j = 0
    while j < a.entries.length() {
      if !a.entries[j].equals(b.entries[j]) {
        return false
      }
      j = j + 1
    }
    if a.child_nodes.length() != b.child_nodes.length() {
      return false
    }
    let mut k = 0
    while k < a.child_nodes.length() {
      stack.push((a.child_nodes[k], b.child_nodes[k]))
      k = k + 1
    }
  }
  true
}
