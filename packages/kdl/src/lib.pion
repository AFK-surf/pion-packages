///| Pure Pion KDL v2.0.0 (and v1.0.0 compatibility mode) parser, AST, formatter, and query engine.

///| Parse a KDL v2.0.0 document from a UTF-8 `String` with default limits.
pub fn parse(src : String) -> Result[KdlDocument, KdlError] {
  parse_with_limits(src, KdlLimits::default())
}

///| Parse a KDL v2.0.0 document from a UTF-8 `String` with explicit `KdlLimits`.
pub fn parse_with_limits(
  src : String,
  limits : KdlLimits,
) -> Result[KdlDocument, KdlError] {
  parse_kdl_impl(src, limits, false)
}

///| Parse a KDL v2.0.0 document from raw `Bytes` (strict UTF-8 validation).
pub fn parse_bytes(src : Bytes) -> Result[KdlDocument, KdlError] {
  parse_bytes_with_limits(src, KdlLimits::default())
}

///| Parse a KDL v2.0.0 document from raw `Bytes` with explicit `KdlLimits`.
pub fn parse_bytes_with_limits(
  src : Bytes,
  limits : KdlLimits,
) -> Result[KdlDocument, KdlError] {
  match validate_utf8_bytes(src) {
    Ok(s) => parse_kdl_impl(s, limits, false)
    Err(e) => Err(e)
  }
}

///| Parse a KDL v1.0.0 compatibility-mode document from a UTF-8 `String`.
pub fn parse_v1(src : String) -> Result[KdlDocument, KdlError] {
  parse_v1_with_limits(src, KdlLimits::default())
}

///| Parse a KDL v1.0.0 compatibility-mode document with explicit `KdlLimits`.
pub fn parse_v1_with_limits(
  src : String,
  limits : KdlLimits,
) -> Result[KdlDocument, KdlError] {
  parse_kdl_impl(src, limits, true)
}

///| Format a `KdlDocument` into canonical, lossless KDL v2.0.0 text (4-space indent).
pub fn format(doc : KdlDocument) -> String {
  format_doc_impl(doc)
}

///| Format a `KdlDocument` into compact single-line KDL v2.0.0 text.
pub fn format_compact(doc : KdlDocument) -> String {
  format_compact_impl(doc)
}

///| Query nodes in `doc` matching a KDL selector expression.
pub fn query(
  doc : KdlDocument,
  selector : String,
) -> Result[Array[KdlNode], KdlError] {
  query_impl(doc, selector)
}
