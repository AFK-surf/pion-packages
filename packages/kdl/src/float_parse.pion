///| Count leading zero bits of a non-zero `UInt64`.
fn clz_u64(x : UInt64) -> Int {
  let mut v = x
  let mut n = 0
  if (v & 0xFFFFFFFF00000000UL) == 0UL {
    n = n + 32
    v = v << 32UL
  }
  if (v & 0xFFFF000000000000UL) == 0UL {
    n = n + 16
    v = v << 16UL
  }
  if (v & 0xFF00000000000000UL) == 0UL {
    n = n + 8
    v = v << 8UL
  }
  if (v & 0xF000000000000000UL) == 0UL {
    n = n + 4
    v = v << 4UL
  }
  if (v & 0xC000000000000000UL) == 0UL {
    n = n + 2
    v = v << 2UL
  }
  if (v & 0x8000000000000000UL) == 0UL {
    n = n + 1
  }
  n
}

///| Eisel-Lemire fast exact conversion of `w * 10^q` to IEEE-754 `Double`.
///| Returns `None` on ambiguous rounding boundaries or subnormals (caller falls back to `to_double()`).
fn eisel_lemire_f64(w_in : UInt64, q : Int) -> Option[Double] {
  if w_in == 0UL || q < -342 || q > 308 {
    return None
  }
  let lz = clz_u64(w_in)
  let w = w_in << lz.to_int64().reinterpret_as_uint64()
  let idx = q + 342
  let p_hi = el_pow5_hi[idx]
  let (lo1, hi1) = ryu_umul128(w, p_hi)
  let ub1 = (hi1 >> 63UL).to_int()
  let sh1 = (ub1 + 9).to_int64().reinterpret_as_uint64()
  let rm1 = (1UL << sh1) - 1UL
  let r1 = hi1 & rm1
  let upper = if r1 >= 1UL && r1 <= rm1 - 2UL {
    hi1
  } else {
    let (_, hi2) = ryu_umul128(w, el_pow5_lo[idx])
    let mid = lo1 + hi2
    let carry : UInt64 = if mid < lo1 { 1UL } else { 0UL }
    hi1 + carry
  }
  let upper_bit = (upper >> 63UL).to_int()
  let shift = upper_bit + 9
  let shift_u = shift.to_int64().reinterpret_as_uint64()
  let rem_mask = (1UL << shift_u) - 1UL
  let rem = upper & rem_mask
  if rem == 0UL || rem == rem_mask {
    return None
  }
  let z = upper >> shift_u
  let mut sig = (z >> 1UL) + (z & 1UL)
  let log2_10 = if q >= 0 {
    (q * 217706) >> 16
  } else {
    -(((-q) * 217706 + 65535) >> 16)
  }
  let mut exp2 = log2_10 + 63 - lz + upper_bit
  if sig == (1UL << 53UL) {
    sig = sig >> 1UL
    exp2 = exp2 + 1
  }
  if exp2 < -1022 {
    return None
  }
  if exp2 > 1023 {
    return Some(1.0 / 0.0)
  }
  let ieee_exp = (exp2 + 1023).to_int64().reinterpret_as_uint64()
  let bits = (ieee_exp << 52UL) | (sig & 0x000FFFFFFFFFFFFFUL)
  Some(Double::from_bits(bits.reinterpret_as_int64()))
}

///| Bit length of a non-zero hex nibble (1..15).
fn hex_nibble_bits(hv : Int) -> Int {
  if hv >= 8 {
    4
  } else if hv >= 4 {
    3
  } else if hv >= 2 {
    2
  } else {
    1
  }
}

///| Single-rounding conversion of `(mant + eps) * 2^exp` to IEEE-754 binary64.
///| `mant` has `bits` significant bits (1 <= bits <= 63); `sticky` is true iff dropped lower bits are non-zero.
fn hex_mant_to_double(mant : UInt64, bits : Int, exp : Int, sticky : Bool) -> Double {
  if bits == 0 {
    return 0.0
  }
  let mut msb_exp = bits - 1 + exp
  if msb_exp > 1023 {
    return 1.0 / 0.0
  }
  if bits <= 53 {
    let sh = (53 - bits).to_int64().reinterpret_as_uint64()
    let sig = mant << sh
    let ieee_exp = (msb_exp + 1023).to_int64().reinterpret_as_uint64()
    let ieee_bits = (ieee_exp << 52UL) | (sig & 0x000FFFFFFFFFFFFFUL)
    return Double::from_bits(ieee_bits.reinterpret_as_int64())
  }
  let shift = bits - 53
  let shift_u = shift.to_int64().reinterpret_as_uint64()
  let mut sig = mant >> shift_u
  let rem_mask = (1UL << shift_u) - 1UL
  let rem = mant & rem_mask
  let half = 1UL << (shift - 1).to_int64().reinterpret_as_uint64()
  let round_up = rem > half || (rem == half && (sticky || (sig & 1UL) != 0UL))
  if round_up {
    sig = sig + 1UL
    if sig == (1UL << 53UL) {
      sig = sig >> 1UL
      msb_exp = msb_exp + 1
    }
  }
  if msb_exp > 1023 {
    return 1.0 / 0.0
  }
  let ieee_exp = (msb_exp + 1023).to_int64().reinterpret_as_uint64()
  let ieee_bits = (ieee_exp << 52UL) | (sig & 0x000FFFFFFFFFFFFFUL)
  Double::from_bits(ieee_bits.reinterpret_as_int64())
}
