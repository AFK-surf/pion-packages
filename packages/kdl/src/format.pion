///| Iterative canonical and compact KDL v2.0.0 formatter (lossless round-trip).

fn write_hex_cp(sb : StringBuilder, cp : Int) -> Unit {
  let digits = "0123456789abcdef"
  let buf : Array[Int] = []
  let mut v = cp
  if v == 0 {
    buf.push(0)
  } else {
    while v > 0 {
      buf.push(v & 15)
      v = v >> 4
    }
  }
  let mut i = buf.length() - 1
  while i >= 0 {
    sb.write_byte(digits.code_unit_at(buf[i]).to_byte())
    i = i - 1
  }
}

fn write_kdl_quoted_string(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      if b0 == 34 {
        sb.write_string("\\\"")
      } else if b0 == 92 {
        sb.write_string("\\\\")
      } else if b0 == 10 {
        sb.write_string("\\n")
      } else if b0 == 13 {
        sb.write_string("\\r")
      } else if b0 == 9 {
        sb.write_string("\\t")
      } else if b0 == 8 {
        sb.write_string("\\b")
      } else if b0 == 12 {
        sb.write_string("\\f")
      } else if is_disallowed_ascii(b0) || b0 == 11 {
        sb.write_string("\\u{")
        write_hex_cp(sb, b0)
        sb.write_byte((125).to_byte())
      } else {
        sb.write_byte(b0.to_byte())
      }
      i = i + 1
    } else {
      let (cp, len) = decode_utf8_at(s, i)
      if is_disallowed_non_ascii(cp, false) || is_newline_cp(cp) {
        sb.write_string("\\u{")
        write_hex_cp(sb, cp)
        sb.write_byte((125).to_byte())
      } else {
        let mut k = 0
        while k < len {
          sb.write_byte(s.code_unit_at(i + k).to_byte())
          k = k + 1
        }
      }
      i = i + len
    }
  }
  sb.write_byte((34).to_byte())
}

fn write_kdl_ident_or_quoted(sb : StringBuilder, s : String) -> Unit {
  if is_valid_v2_bare_ident(s) {
    sb.write_string(s)
  } else {
    write_kdl_quoted_string(sb, s)
  }
}

fn write_kdl_value(sb : StringBuilder, v : KdlValue) -> Unit {
  match v {
    KdlValue::Str(s) => write_kdl_quoted_string(sb, s)
    KdlValue::Int(n) => sb.write_string(n.to_string())
    KdlValue::Float(f) => write_float_exact(sb, f, true)
    KdlValue::Bool(b) => {
      if b {
        sb.write_string("#true")
      } else {
        sb.write_string("#false")
      }
    }
    KdlValue::Null => sb.write_string("#null")
  }
}

fn write_indent(sb : StringBuilder, depth : Int) -> Unit {
  let mut i = 0
  while i < depth {
    sb.write_string("    ")
    i = i + 1
  }
}

fn write_node_header(sb : StringBuilder, nd : KdlNode) -> Unit {
  match nd.ty {
    Some(t) => {
      sb.write_byte((40).to_byte())
      write_kdl_ident_or_quoted(sb, t)
      sb.write_byte((41).to_byte())
    }
    None => ()
  }
  write_kdl_ident_or_quoted(sb, nd.name)
  let en = nd.entries.length()
  let mut i = 0
  while i < en {
    let e = nd.entries[i]
    sb.write_byte((32).to_byte())
    match e.name {
      Some(k) => {
        write_kdl_ident_or_quoted(sb, k)
        sb.write_byte((61).to_byte())
      }
      None => ()
    }
    match e.ty {
      Some(t) => {
        sb.write_byte((40).to_byte())
        write_kdl_ident_or_quoted(sb, t)
        sb.write_byte((41).to_byte())
      }
      None => ()
    }
    write_kdl_value(sb, e.value)
    i = i + 1
  }
}

struct FmtFrame {
  nodes : Array[KdlNode]
  mut idx : Int
  depth : Int
}

fn format_doc_impl(doc : KdlDocument) -> String {
  let sb = StringBuilder::new()
  let stack : Array[FmtFrame] = [FmtFrame::{ nodes: doc.nodes, idx: 0, depth: 0 }]
  while stack.length() > 0 {
    let top_idx = stack.length() - 1
    let frame = stack[top_idx]
    if frame.idx >= frame.nodes.length() {
      let _ = stack.pop()
      if frame.depth > 0 {
        write_indent(sb, frame.depth - 1)
        sb.write_string("}\n")
      }
      continue
    }
    let nd = frame.nodes[frame.idx]
    frame.idx = frame.idx + 1
    write_indent(sb, frame.depth)
    write_node_header(sb, nd)
    if nd.child_nodes.length() > 0 {
      sb.write_string(" {\n")
      stack.push(FmtFrame::{
        nodes: nd.child_nodes,
        idx: 0,
        depth: frame.depth + 1,
      })
    } else {
      sb.write_byte((10).to_byte())
    }
  }
  sb.to_string()
}

fn format_compact_impl(doc : KdlDocument) -> String {
  let sb = StringBuilder::new()
  let stack : Array[FmtFrame] = [FmtFrame::{ nodes: doc.nodes, idx: 0, depth: 0 }]
  while stack.length() > 0 {
    let top_idx = stack.length() - 1
    let frame = stack[top_idx]
    if frame.idx >= frame.nodes.length() {
      let _ = stack.pop()
      if frame.depth > 0 {
        sb.write_byte((125).to_byte())
      }
      continue
    }
    if frame.idx > 0 {
      sb.write_byte((59).to_byte())
    }
    let nd = frame.nodes[frame.idx]
    frame.idx = frame.idx + 1
    write_node_header(sb, nd)
    if nd.child_nodes.length() > 0 {
      sb.write_byte((123).to_byte())
      stack.push(FmtFrame::{
        nodes: nd.child_nodes,
        idx: 0,
        depth: frame.depth + 1,
      })
    }
  }
  sb.to_string()
}
