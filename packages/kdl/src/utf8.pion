///| UTF-8 validation, scalar decoding, and KDL v2.0.0 / v1.0.0 character classification.

///| Validate raw UTF-8 bytes and convert to `String`, returning `KdlError(InvalidUtf8)` on error.
fn validate_utf8_bytes(data : Bytes) -> Result[String, KdlError] {
  let n = data.length()
  let mut i = 0
  let mut line = 1
  let mut col = 1
  while i < n {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      if b0 == 10 {
        line = line + 1
        col = 1
      } else {
        col = col + 1
      }
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "truncated 2-byte UTF-8 sequence", line, col, i))
      }
      let b1 = data[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "invalid UTF-8 continuation byte", line, col, i))
      }
      i = i + 2
      col = col + 1
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "truncated 3-byte UTF-8 sequence", line, col, i))
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "invalid UTF-8 continuation byte", line, col, i))
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "overlong 3-byte UTF-8 sequence", line, col, i))
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "UTF-8 surrogate code point", line, col, i))
      }
      i = i + 3
      col = col + 1
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "truncated 4-byte UTF-8 sequence", line, col, i))
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "invalid UTF-8 continuation byte", line, col, i))
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "overlong 4-byte UTF-8 sequence", line, col, i))
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "UTF-8 code point above U+10FFFF", line, col, i))
      }
      i = i + 4
      col = col + 1
    } else {
      return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "invalid UTF-8 leading byte", line, col, i))
    }
  }
  let sb = StringBuilder::new()
  let mut k = 0
  while k < n {
    sb.write_byte(data[k])
    k = k + 1
  }
  Ok(sb.to_string())
}

///| Validate a `String`'s UTF-8 encoding and reject disallowed literal code points
///| (allowing a single leading U+FEFF BOM at byte offset 0).
fn validate_kdl_source(s : String, v1 : Bool) -> Result[Int, KdlError] {
  let n = s.length()
  let mut i = 0
  let mut line = 1
  let mut col = 1
  let mut start_offset = 0
  // Optional leading UTF-8 BOM (EF BB BF)
  if n >= 3 && s.code_unit_at(0) == 0xEF && s.code_unit_at(1) == 0xBB && s.code_unit_at(2) == 0xBF {
    i = 3
    start_offset = 3
  }
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      if is_disallowed_ascii(b0) {
        return Err(KdlError::new(KdlErrorKind::DisallowedCodePoint, "disallowed literal control code point", line, col, i))
      }
      if b0 == 10 {
        line = line + 1
        col = 1
      } else {
        col = col + 1
      }
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "truncated 2-byte UTF-8 sequence", line, col, i))
      }
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) != 0x80 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "invalid UTF-8 continuation byte", line, col, i))
      }
      i = i + 2
      col = col + 1
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "truncated 3-byte UTF-8 sequence", line, col, i))
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "invalid UTF-8 continuation byte", line, col, i))
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "overlong 3-byte UTF-8 sequence", line, col, i))
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "UTF-8 surrogate code point", line, col, i))
      }
      let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
      if is_disallowed_non_ascii(cp, v1) {
        return Err(KdlError::new(KdlErrorKind::DisallowedCodePoint, "disallowed literal Unicode code point", line, col, i))
      }
      if cp == 0x2028 || cp == 0x2029 {
        line = line + 1
        col = 1
      } else {
        col = col + 1
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "truncated 4-byte UTF-8 sequence", line, col, i))
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "invalid UTF-8 continuation byte", line, col, i))
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "overlong 4-byte UTF-8 sequence", line, col, i))
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "UTF-8 code point above U+10FFFF", line, col, i))
      }
      i = i + 4
      col = col + 1
    } else {
      return Err(KdlError::new(KdlErrorKind::InvalidUtf8, "invalid UTF-8 leading byte", line, col, i))
    }
  }
  Ok(start_offset)
}

fn is_disallowed_ascii(b : Int) -> Bool {
  (b >= 0x00 && b <= 0x08) || (b >= 0x0E && b <= 0x1F) || b == 0x7F
}

fn is_disallowed_non_ascii(cp : Int, v1 : Bool) -> Bool {
  if cp == 0x200E || cp == 0x200F {
    return true
  }
  if cp >= 0x202A && cp <= 0x202E {
    return true
  }
  if cp >= 0x2066 && cp <= 0x2069 {
    return true
  }
  if !v1 && cp == 0xFEFF {
    return true
  }
  false
}

///| Decode a single valid UTF-8 code point at `pos` in `s`, returning `(codepoint, byte_len)`.
fn decode_utf8_at(s : String, pos : Int) -> (Int, Int) {
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    (b0, 1)
  } else if b0 < 0xE0 {
    let b1 = s.code_unit_at(pos + 1)
    (((b0 & 0x1F) << 6) | (b1 & 0x3F), 2)
  } else if b0 < 0xF0 {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), 3)
  } else {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F), 4)
  }
}

///| Encode a valid Unicode scalar value as UTF-8 into `sb`.
fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| KDL v2.0.0 `unicode-space` predicate (plus VT U+000B per official test suite, and U+FEFF in v1 mode).
fn is_unicode_space(cp : Int, v1 : Bool) -> Bool {
  if cp == 0x20 || cp == 0x09 || cp == 0x0B {
    return true
  }
  if cp < 0x80 {
    return false
  }
  if cp == 0x00A0 || cp == 0x1680 || cp == 0x202F || cp == 0x205F || cp == 0x3000 {
    return true
  }
  if cp >= 0x2000 && cp <= 0x200A {
    return true
  }
  if v1 && cp == 0xFEFF {
    return true
  }
  false
}

///| KDL v2.0.0 `newline` predicate (single codepoint; caller handles CRLF pair).
fn is_newline_cp(cp : Int) -> Bool {
  cp == 0x0A || cp == 0x0D || cp == 0x0C || cp == 0x85 || cp == 0x2028 || cp == 0x2029
}

///| Check if `s` at `pos` starts with a KDL newline; returns byte length (1, 2, or 3) or 0.
fn match_newline_len(s : String, pos : Int, n : Int) -> Int {
  if pos >= n {
    return 0
  }
  let b0 = s.code_unit_at(pos)
  if b0 == 0x0D {
    if pos + 1 < n && s.code_unit_at(pos + 1) == 0x0A {
      return 2
    }
    return 1
  }
  if b0 == 0x0A || b0 == 0x0C {
    return 1
  }
  if b0 >= 0x80 {
    let (cp, len) = decode_utf8_at(s, pos)
    if cp == 0x85 || cp == 0x2028 || cp == 0x2029 {
      return len
    }
  }
  0
}

///| KDL v2.0.0 / v1.0.0 `identifier-char` predicate.
fn is_kdl_ident_char(cp : Int, v1 : Bool) -> Bool {
  if is_unicode_space(cp, v1) || is_newline_cp(cp) {
    return false
  }
  if cp < 0x80 {
    if is_disallowed_ascii(cp) {
      return false
    }
    // Disallowed identifier characters in both KDL v1 and v2:
    // / \ ( ) { } ; " =
    if cp == 47 || cp == 92 || cp == 40 || cp == 41 || cp == 123 || cp == 125 || cp == 59 || cp == 34 || cp == 61 {
      return false
    }
    // Disallowed in KDL v2 only: [ ] #
    if !v1 && (cp == 91 || cp == 93 || cp == 35) {
      return false
    }
    // Disallowed in KDL v1 only: < > ,
    if v1 && (cp == 60 || cp == 62 || cp == 44) {
      return false
    }
    return true
  }
  !is_disallowed_non_ascii(cp, v1)
}

///| Check whether `s` is a valid KDL v2 bare `identifier-string`.
fn is_valid_v2_bare_ident(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  // Disallowed bare keywords in KDL v2
  if s == "true" || s == "false" || s == "null" || s == "inf" || s == "-inf" || s == "nan" {
    return false
  }
  // Cannot start with digit, or +/- followed by digit, or . followed by digit, or +/- . followed by digit
  let b0 = s.code_unit_at(0)
  if b0 >= 48 && b0 <= 57 {
    return false
  }
  if b0 == 43 || b0 == 45 {
    if n >= 2 {
      let b1 = s.code_unit_at(1)
      if b1 >= 48 && b1 <= 57 {
        return false
      }
      if b1 == 46 && n >= 3 {
        let b2 = s.code_unit_at(2)
        if b2 >= 48 && b2 <= 57 {
          return false
        }
      }
    }
  } else if b0 == 46 {
    if n >= 2 {
      let b1 = s.code_unit_at(1)
      if b1 >= 48 && b1 <= 57 {
        return false
      }
    }
  }
  let mut i = 0
  while i < n {
    let (cp, len) = decode_utf8_at(s, i)
    if !is_kdl_ident_char(cp, false) {
      return false
    }
    i = i + len
  }
  true
}

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}
