///| Iterative KDL query selector parser and evaluator.
///|
///| Supported selector grammar:
///| - Comma-separated union: `sel1, sel2`
///| - Combinators:
///|   - `>` or `/` : direct child
///|   - `>>` or whitespace : descendant (at any depth)
///|   - leading `>>` : match at any depth from document root
///| - Node matcher:
///|   - optional type annotation: `(type)`
///|   - optional name or wildcard `*` (if omitted with `(type)` or `[...]`, matches any name)
///|   - zero or more filters:
///|     - `[key]` : node has property `key`
///|     - `[key=val]` / `[key!=val]` : property equals / not-equals value
///|     - `[0=val]` / `[0!=val]` : positional argument at index `0` equals / not-equals value

enum QCombinator {
  Root
  Child
  Descendant
}

enum QFilterOp {
  Exists
  Eq
  Neq
}

struct QFilter {
  arg_index : Option[Int]
  prop_key : String
  op : QFilterOp
  fval : Option[KdlValue]
}

struct QStep {
  comb : QCombinator
  ty : Option[String]
  name : Option[String] // None means wildcard `*`
  filters : Array[QFilter]
}

struct QParser {
  src : String
  len : Int
  mut pos : Int
}

fn QParser::new(src : String) -> QParser {
  QParser::{ src: src, len: src.length(), pos: 0 }
}

fn QParser::err(self : QParser, msg : String) -> KdlError {
  KdlError::new(KdlErrorKind::InvalidQuery, msg, 1, self.pos + 1, self.pos)
}

fn QParser::skip_ws(self : QParser) -> Unit {
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
}

fn is_q_ident_char(b : Int) -> Bool {
  if b >= 0x80 {
    return true
  }
  (b >= 97 && b <= 122) ||
  (b >= 65 && b <= 90) ||
  (b >= 48 && b <= 57) ||
  b == 95 ||
  b == 45 ||
  b == 46 ||
  b == 58
}

fn QParser::parse_quoted(self : QParser) -> Result[String, KdlError] {
  if self.pos >= self.len || self.src.code_unit_at(self.pos) != 34 {
    return Err(self.err("expected '\"'"))
  }
  self.pos = self.pos + 1
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 34 {
      self.pos = self.pos + 1
      return Ok(sb.to_string())
    }
    if b == 92 {
      self.pos = self.pos + 1
      if self.pos >= self.len {
        return Err(self.err("unterminated escape in query string"))
      }
      let esc = self.src.code_unit_at(self.pos)
      self.pos = self.pos + 1
      if esc == 34 {
        sb.write_byte((34).to_byte())
      } else if esc == 92 {
        sb.write_byte((92).to_byte())
      } else if esc == 110 {
        sb.write_byte((10).to_byte())
      } else if esc == 114 {
        sb.write_byte((13).to_byte())
      } else if esc == 116 {
        sb.write_byte((9).to_byte())
      } else {
        return Err(self.err("unsupported escape in query string"))
      }
    } else {
      sb.write_byte(b.to_byte())
      self.pos = self.pos + 1
    }
  }
  Err(self.err("unterminated string in query"))
}

fn QParser::parse_ident_or_quoted(self : QParser) -> Result[String, KdlError] {
  if self.pos >= self.len {
    return Err(self.err("expected identifier or string"))
  }
  if self.src.code_unit_at(self.pos) == 34 {
    return self.parse_quoted()
  }
  let start = self.pos
  while self.pos < self.len && is_q_ident_char(self.src.code_unit_at(self.pos)) {
    self.pos = self.pos + 1
  }
  if self.pos == start {
    return Err(self.err("expected identifier in query"))
  }
  Ok(self.src.slice(start, self.pos))
}

fn QParser::parse_value(self : QParser) -> Result[KdlValue, KdlError] {
  self.skip_ws()
  if self.pos >= self.len {
    return Err(self.err("expected filter value"))
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 34 {
    match self.parse_quoted() {
      Ok(s) => return Ok(KdlValue::Str(s))
      Err(e) => return Err(e)
    }
  }
  if b == 35 {
    // #true, #false, #null, #inf, #-inf, #nan
    let start = self.pos
    self.pos = self.pos + 1
    while self.pos < self.len && is_q_ident_char(self.src.code_unit_at(self.pos)) {
      self.pos = self.pos + 1
    }
    let kw = self.src.slice(start, self.pos)
    if kw == "#true" {
      return Ok(KdlValue::Bool(true))
    } else if kw == "#false" {
      return Ok(KdlValue::Bool(false))
    } else if kw == "#null" {
      return Ok(KdlValue::Null)
    } else if kw == "#inf" {
      return Ok(KdlValue::Float(1.0 / 0.0))
    } else if kw == "#-inf" {
      return Ok(KdlValue::Float(-1.0 / 0.0))
    } else if kw == "#nan" {
      return Ok(KdlValue::Float(0.0 / 0.0))
    }
    return Err(self.err("unknown keyword in query: " + kw))
  }
  // Parse bare token: check KDL number (int/radix/float/exp) or bare string
  let start = self.pos
  if b == 45 || b == 43 {
    self.pos = self.pos + 1
  }
  while self.pos < self.len {
    let cb = self.src.code_unit_at(self.pos)
    if is_q_ident_char(cb) {
      self.pos = self.pos + 1
    } else if cb == 43 && self.pos > start {
      let prev = self.src.code_unit_at(self.pos - 1)
      if prev == 101 || prev == 69 {
        self.pos = self.pos + 1
      } else {
        break
      }
    } else {
      break
    }
  }
  if self.pos == start {
    return Err(self.err("expected value in query filter"))
  }
  let tok = self.src.slice(start, self.pos)
  let t0 = tok.code_unit_at(0)
  let is_num_start = is_ascii_digit(t0) || ((t0 == 43 || t0 == 45) && tok.length() >= 2 && is_ascii_digit(tok.code_unit_at(1)))
  if is_num_start {
    let np = Parser::new(tok, 0, KdlLimits::default(), false)
    match np.parse_number_token(tok) {
      Ok(v) => return Ok(v)
      Err(e) => return Err(self.err("invalid number in query filter: " + e.message))
    }
  }
  Ok(KdlValue::Str(tok))
}

fn parse_q_nonneg_int(s : String) -> Option[Int] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    if acc > 100000000 {
      return None
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  Some(acc)
}

fn QParser::parse_filter(self : QParser) -> Result[QFilter, KdlError] {
  // Consumes `[ ... ]`
  self.pos = self.pos + 1 // skip '['
  self.skip_ws()
  let is_quoted = self.pos < self.len && self.src.code_unit_at(self.pos) == 34
  let key = match self.parse_ident_or_quoted() {
    Ok(k) => k
    Err(e) => return Err(e)
  }
  let arg_index = if is_quoted { None } else { parse_q_nonneg_int(key) }
  self.skip_ws()
  if self.pos >= self.len {
    return Err(self.err("unclosed '[' in query filter"))
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 93 {
    self.pos = self.pos + 1
    return Ok(QFilter::{
      arg_index: arg_index,
      prop_key: key,
      op: QFilterOp::Exists,
      fval: None,
    })
  }
  let op = if b == 61 {
    self.pos = self.pos + 1
    QFilterOp::Eq
  } else if b == 33 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 61 {
    self.pos = self.pos + 2
    QFilterOp::Neq
  } else {
    return Err(self.err("expected '=', '!=', or ']' in query filter"))
  }
  let fv = match self.parse_value() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  self.skip_ws()
  if self.pos >= self.len || self.src.code_unit_at(self.pos) != 93 {
    return Err(self.err("expected ']' to close query filter"))
  }
  self.pos = self.pos + 1
  Ok(QFilter::{
    arg_index: arg_index,
    prop_key: key,
    op: op,
    fval: Some(fv),
  })
}

fn QParser::parse_step(
  self : QParser,
  comb : QCombinator,
) -> Result[QStep, KdlError] {
  self.skip_ws()
  let mut ty : Option[String] = None
  let mut name : Option[String] = None
  let mut matched_any = false
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 40 {
    self.pos = self.pos + 1
    self.skip_ws()
    let t = match self.parse_ident_or_quoted() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    self.skip_ws()
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 41 {
      return Err(self.err("expected ')' after type annotation in query"))
    }
    self.pos = self.pos + 1
    ty = Some(t)
    matched_any = true
  }
  if self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 42 {
      self.pos = self.pos + 1
      name = None
      matched_any = true
    } else if b == 34 || is_q_ident_char(b) {
      let nm = match self.parse_ident_or_quoted() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      name = Some(nm)
      matched_any = true
    }
  }
  let filters : Array[QFilter] = []
  while self.pos < self.len && self.src.code_unit_at(self.pos) == 91 {
    let f = match self.parse_filter() {
      Ok(fl) => fl
      Err(e) => return Err(e)
    }
    filters.push(f)
    matched_any = true
  }
  if !matched_any {
    return Err(self.err("expected node selector"))
  }
  Ok(QStep::{ comb: comb, ty: ty, name: name, filters: filters })
}

fn QParser::parse_chain(self : QParser) -> Result[Array[QStep], KdlError] {
  self.skip_ws()
  let steps : Array[QStep] = []
  let first_comb = if self.pos + 1 < self.len && self.src.code_unit_at(self.pos) == 62 && self.src.code_unit_at(self.pos + 1) == 62 {
    self.pos = self.pos + 2
    QCombinator::Descendant
  } else {
    QCombinator::Root
  }
  let s0 = match self.parse_step(first_comb) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  steps.push(s0)
  while self.pos < self.len {
    let before_ws = self.pos
    self.skip_ws()
    if self.pos >= self.len {
      break
    }
    let b = self.src.code_unit_at(self.pos)
    if b == 44 {
      break
    }
    let comb = if b == 62 {
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 62 {
        self.pos = self.pos + 2
        QCombinator::Descendant
      } else {
        self.pos = self.pos + 1
        QCombinator::Child
      }
    } else if b == 47 {
      self.pos = self.pos + 1
      QCombinator::Child
    } else if self.pos > before_ws {
      QCombinator::Descendant
    } else {
      return Err(self.err("unexpected character in query selector"))
    }
    let st = match self.parse_step(comb) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    steps.push(st)
  }
  Ok(steps)
}

fn QParser::parse_all(self : QParser) -> Result[Array[Array[QStep]], KdlError] {
  self.skip_ws()
  if self.pos >= self.len {
    return Err(self.err("empty query selector"))
  }
  let chains : Array[Array[QStep]] = []
  while true {
    let ch = match self.parse_chain() {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    chains.push(ch)
    self.skip_ws()
    if self.pos >= self.len {
      break
    }
    if self.src.code_unit_at(self.pos) == 44 {
      self.pos = self.pos + 1
      self.skip_ws()
      if self.pos >= self.len {
        return Err(self.err("trailing comma in query selector"))
      }
    } else {
      return Err(self.err("unexpected trailing input in query selector"))
    }
  }
  Ok(chains)
}

fn node_matches_step(nd : KdlNode, step : QStep) -> Bool {
  match step.ty {
    Some(t) => {
      match nd.ty {
        Some(nt) => {
          if nt != t {
            return false
          }
        }
        None => return false
      }
    }
    None => ()
  }
  match step.name {
    Some(nm) => {
      if nd.name != nm {
        return false
      }
    }
    None => ()
  }
  let fn_len = step.filters.length()
  let mut i = 0
  while i < fn_len {
    let fl = step.filters[i]
    let actual : Option[KdlValue] = match fl.arg_index {
      Some(idx) => nd.arg(idx)
      None => nd.prop(fl.prop_key)
    }
    match fl.op {
      QFilterOp::Exists => {
        match actual {
          None => return false
          Some(_) => ()
        }
      }
      QFilterOp::Eq => {
        match actual {
          None => return false
          Some(av) => {
            match fl.fval {
              Some(ev) => {
                if !av.equals(ev) {
                  return false
                }
              }
              None => return false
            }
          }
        }
      }
      QFilterOp::Neq => {
        match actual {
          None => return false
          Some(av) => {
            match fl.fval {
              Some(ev) => {
                if av.equals(ev) {
                  return false
                }
              }
              None => return false
            }
          }
        }
      }
    }
    i = i + 1
  }
  true
}

struct QFrame64 {
  nodes : Array[KdlNode]
  mut idx : Int
  depth : Int
  parent_here : UInt64
  parent_sub : UInt64
}

struct QFrameVec {
  nodes : Array[KdlNode]
  mut idx : Int
  depth : Int
  parent_here : Array[Bool]
  parent_sub : Array[Bool]
}

fn emit_unique(
  out : Array[KdlNode],
  seen : Array[Bool],
  use_seen : Bool,
  node_id : Int,
  nd : KdlNode,
) -> Unit {
  if !use_seen {
    out.push(nd)
    return
  }
  while seen.length() <= node_id {
    seen.push(false)
  }
  if !seen[node_id] {
    seen[node_id] = true
    out.push(nd)
  }
}

///| Evaluate a selector chain in O(nodes * steps) via iterative pre-order DP (stack-safe, deduplicated, document order).
fn eval_query_chain(
  doc : KdlDocument,
  steps : Array[QStep],
  out : Array[KdlNode],
  seen : Array[Bool],
  use_seen : Bool,
) -> Unit {
  let n = steps.length()
  if n == 0 || doc.nodes.length() == 0 {
    return
  }
  let mut node_id = 0
  if n <= 64 {
    let last_bit : UInt64 = 1UL << (n - 1).to_int64().reinterpret_as_uint64()
    let stack : Array[QFrame64] = [
      QFrame64::{
        nodes: doc.nodes,
        idx: 0,
        depth: 0,
        parent_here: 0UL,
        parent_sub: 0UL,
      },
    ]
    while stack.length() > 0 {
      let fr = stack[stack.length() - 1]
      if fr.idx >= fr.nodes.length() {
        let _ = stack.pop()
        continue
      }
      let nd = fr.nodes[fr.idx]
      fr.idx = fr.idx + 1
      let cur_id = node_id
      node_id = node_id + 1
      let depth = fr.depth
      let ph = fr.parent_here
      let ps = fr.parent_sub
      let mut here : UInt64 = 0UL
      let mut k = 0
      while k < n {
        let st = steps[k]
        let eligible = if k == 0 {
          match st.comb {
            QCombinator::Descendant => true
            _ => depth == 0
          }
        } else {
          let prev_bit : UInt64 = 1UL << (k - 1).to_int64().reinterpret_as_uint64()
          match st.comb {
            QCombinator::Child => depth > 0 && (ph & prev_bit) != 0UL
            QCombinator::Descendant => depth > 0 && (ps & prev_bit) != 0UL
            QCombinator::Root => depth == 0
          }
        }
        if eligible && node_matches_step(nd, st) {
          here = here | (1UL << k.to_int64().reinterpret_as_uint64())
        }
        k = k + 1
      }
      if (here & last_bit) != 0UL {
        emit_unique(out, seen, use_seen, cur_id, nd)
      }
      if nd.child_nodes.length() > 0 {
        let sub = here | (if depth > 0 { ps } else { 0UL })
        stack.push(QFrame64::{
          nodes: nd.child_nodes,
          idx: 0,
          depth: depth + 1,
          parent_here: here,
          parent_sub: sub,
        })
      }
    }
    return
  }
  // General path for chains longer than 64 steps
  let empty_flags : Array[Bool] = []
  let mut z = 0
  while z < n {
    empty_flags.push(false)
    z = z + 1
  }
  let stack : Array[QFrameVec] = [
    QFrameVec::{
      nodes: doc.nodes,
      idx: 0,
      depth: 0,
      parent_here: empty_flags,
      parent_sub: empty_flags,
    },
  ]
  while stack.length() > 0 {
    let fr = stack[stack.length() - 1]
    if fr.idx >= fr.nodes.length() {
      let _ = stack.pop()
      continue
    }
    let nd = fr.nodes[fr.idx]
    fr.idx = fr.idx + 1
    let cur_id = node_id
    node_id = node_id + 1
    let depth = fr.depth
    let ph = fr.parent_here
    let ps = fr.parent_sub
    let here : Array[Bool] = []
    let sub : Array[Bool] = []
    let mut k = 0
    while k < n {
      let st = steps[k]
      let eligible = if k == 0 {
        match st.comb {
          QCombinator::Descendant => true
          _ => depth == 0
        }
      } else {
        match st.comb {
          QCombinator::Child => depth > 0 && ph[k - 1]
          QCombinator::Descendant => depth > 0 && ps[k - 1]
          QCombinator::Root => depth == 0
        }
      }
      let m = eligible && node_matches_step(nd, st)
      here.push(m)
      sub.push(m || (depth > 0 && ps[k]))
      k = k + 1
    }
    if here[n - 1] {
      emit_unique(out, seen, use_seen, cur_id, nd)
    }
    if nd.child_nodes.length() > 0 {
      stack.push(QFrameVec::{
        nodes: nd.child_nodes,
        idx: 0,
        depth: depth + 1,
        parent_here: here,
        parent_sub: sub,
      })
    }
  }
}

fn query_impl(
  doc : KdlDocument,
  selector : String,
) -> Result[Array[KdlNode], KdlError] {
  let qp = QParser::new(selector)
  let chains = match qp.parse_all() {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let out : Array[KdlNode] = []
  let seen : Array[Bool] = []
  let use_seen = chains.length() > 1
  let mut i = 0
  while i < chains.length() {
    eval_query_chain(doc, chains[i], out, seen, use_seen)
    i = i + 1
  }
  Ok(out)
}
