///| Iterative KDL query selector parser and evaluator.
///|
///| Supported selector grammar:
///| - Comma-separated union: `sel1, sel2`
///| - Combinators:
///|   - `>` or `/` : direct child
///|   - `>>` or whitespace : descendant (at any depth)
///|   - leading `>>` : match at any depth from document root
///| - Node matcher:
///|   - optional type annotation: `(type)`
///|   - optional name or wildcard `*` (if omitted with `(type)` or `[...]`, matches any name)
///|   - zero or more filters:
///|     - `[key]` : node has property `key`
///|     - `[key=val]` / `[key!=val]` : property equals / not-equals value
///|     - `[0=val]` / `[0!=val]` : positional argument at index `0` equals / not-equals value

enum QCombinator {
  Root
  Child
  Descendant
}

enum QFilterOp {
  Exists
  Eq
  Neq
}

struct QFilter {
  arg_index : Option[Int]
  prop_key : String
  op : QFilterOp
  fval : Option[KdlValue]
}

struct QStep {
  comb : QCombinator
  ty : Option[String]
  name : Option[String] // None means wildcard `*`
  filters : Array[QFilter]
}

struct QParser {
  src : String
  len : Int
  mut pos : Int
}

fn QParser::new(src : String) -> QParser {
  QParser::{ src: src, len: src.length(), pos: 0 }
}

fn QParser::err(self : QParser, msg : String) -> KdlError {
  KdlError::new(KdlErrorKind::InvalidQuery, msg, 1, self.pos + 1, self.pos)
}

fn QParser::skip_ws(self : QParser) -> Unit {
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
}

fn is_q_ident_char(b : Int) -> Bool {
  if b >= 0x80 {
    return true
  }
  (b >= 97 && b <= 122) ||
  (b >= 65 && b <= 90) ||
  (b >= 48 && b <= 57) ||
  b == 95 ||
  b == 45 ||
  b == 46 ||
  b == 58
}

fn QParser::parse_quoted(self : QParser) -> Result[String, KdlError] {
  if self.pos >= self.len || self.src.code_unit_at(self.pos) != 34 {
    return Err(self.err("expected '\"'"))
  }
  self.pos = self.pos + 1
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 34 {
      self.pos = self.pos + 1
      return Ok(sb.to_string())
    }
    if b == 92 {
      self.pos = self.pos + 1
      if self.pos >= self.len {
        return Err(self.err("unterminated escape in query string"))
      }
      let esc = self.src.code_unit_at(self.pos)
      self.pos = self.pos + 1
      if esc == 34 {
        sb.write_byte((34).to_byte())
      } else if esc == 92 {
        sb.write_byte((92).to_byte())
      } else if esc == 110 {
        sb.write_byte((10).to_byte())
      } else if esc == 114 {
        sb.write_byte((13).to_byte())
      } else if esc == 116 {
        sb.write_byte((9).to_byte())
      } else {
        return Err(self.err("unsupported escape in query string"))
      }
    } else {
      sb.write_byte(b.to_byte())
      self.pos = self.pos + 1
    }
  }
  Err(self.err("unterminated string in query"))
}

fn QParser::parse_ident_or_quoted(self : QParser) -> Result[String, KdlError] {
  if self.pos >= self.len {
    return Err(self.err("expected identifier or string"))
  }
  if self.src.code_unit_at(self.pos) == 34 {
    return self.parse_quoted()
  }
  let start = self.pos
  while self.pos < self.len && is_q_ident_char(self.src.code_unit_at(self.pos)) {
    self.pos = self.pos + 1
  }
  if self.pos == start {
    return Err(self.err("expected identifier in query"))
  }
  Ok(self.src.slice(start, self.pos))
}

fn QParser::parse_value(self : QParser) -> Result[KdlValue, KdlError] {
  self.skip_ws()
  if self.pos >= self.len {
    return Err(self.err("expected filter value"))
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 34 {
    match self.parse_quoted() {
      Ok(s) => return Ok(KdlValue::Str(s))
      Err(e) => return Err(e)
    }
  }
  if b == 35 {
    // #true, #false, #null, #inf, #-inf, #nan
    let start = self.pos
    self.pos = self.pos + 1
    while self.pos < self.len && is_q_ident_char(self.src.code_unit_at(self.pos)) {
      self.pos = self.pos + 1
    }
    let kw = self.src.slice(start, self.pos)
    if kw == "#true" {
      return Ok(KdlValue::Bool(true))
    } else if kw == "#false" {
      return Ok(KdlValue::Bool(false))
    } else if kw == "#null" {
      return Ok(KdlValue::Null)
    } else if kw == "#inf" {
      return Ok(KdlValue::Float(1.0 / 0.0))
    } else if kw == "#-inf" {
      return Ok(KdlValue::Float(-1.0 / 0.0))
    } else if kw == "#nan" {
      return Ok(KdlValue::Float(0.0 / 0.0))
    }
    return Err(self.err("unknown keyword in query: " + kw))
  }
  // Parse bare token: check int/float/string
  let start = self.pos
  if b == 45 || b == 43 {
    self.pos = self.pos + 1
  }
  while self.pos < self.len && is_q_ident_char(self.src.code_unit_at(self.pos)) {
    self.pos = self.pos + 1
  }
  if self.pos == start {
    return Err(self.err("expected value in query filter"))
  }
  let tok = self.src.slice(start, self.pos)
  // Try integer
  match parse_q_i64(tok) {
    Some(n) => return Ok(KdlValue::Int(n))
    None => ()
  }
  Ok(KdlValue::Str(tok))
}

fn parse_q_i64(s : String) -> Option[Int64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  let b0 = s.code_unit_at(0)
  if b0 == 45 {
    neg = true
    i = 1
  } else if b0 == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut acc : UInt64 = 0UL
  let limit : UInt64 = if neg { 9223372036854775808UL } else { 9223372036854775807UL }
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    let d = (b - 48).to_int64().reinterpret_as_uint64()
    if acc > (limit - d) / 10UL {
      return None
    }
    acc = acc * 10UL + d
    i = i + 1
  }
  if neg {
    if acc == 9223372036854775808UL {
      Some(-9223372036854775807L - 1L)
    } else {
      Some(-acc.reinterpret_as_int64())
    }
  } else {
    Some(acc.reinterpret_as_int64())
  }
}

fn parse_q_nonneg_int(s : String) -> Option[Int] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    if acc > 100000000 {
      return None
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  Some(acc)
}

fn QParser::parse_filter(self : QParser) -> Result[QFilter, KdlError] {
  // Consumes `[ ... ]`
  self.pos = self.pos + 1 // skip '['
  self.skip_ws()
  let key = match self.parse_ident_or_quoted() {
    Ok(k) => k
    Err(e) => return Err(e)
  }
  let arg_index = parse_q_nonneg_int(key)
  self.skip_ws()
  if self.pos >= self.len {
    return Err(self.err("unclosed '[' in query filter"))
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 93 {
    self.pos = self.pos + 1
    return Ok(QFilter::{
      arg_index: arg_index,
      prop_key: key,
      op: QFilterOp::Exists,
      fval: None,
    })
  }
  let op = if b == 61 {
    self.pos = self.pos + 1
    QFilterOp::Eq
  } else if b == 33 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 61 {
    self.pos = self.pos + 2
    QFilterOp::Neq
  } else {
    return Err(self.err("expected '=', '!=', or ']' in query filter"))
  }
  let fv = match self.parse_value() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  self.skip_ws()
  if self.pos >= self.len || self.src.code_unit_at(self.pos) != 93 {
    return Err(self.err("expected ']' to close query filter"))
  }
  self.pos = self.pos + 1
  Ok(QFilter::{
    arg_index: arg_index,
    prop_key: key,
    op: op,
    fval: Some(fv),
  })
}

fn QParser::parse_step(
  self : QParser,
  comb : QCombinator,
) -> Result[QStep, KdlError] {
  self.skip_ws()
  let mut ty : Option[String] = None
  let mut name : Option[String] = None
  let mut matched_any = false
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 40 {
    self.pos = self.pos + 1
    self.skip_ws()
    let t = match self.parse_ident_or_quoted() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    self.skip_ws()
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 41 {
      return Err(self.err("expected ')' after type annotation in query"))
    }
    self.pos = self.pos + 1
    ty = Some(t)
    matched_any = true
  }
  if self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 42 {
      self.pos = self.pos + 1
      name = None
      matched_any = true
    } else if b == 34 || is_q_ident_char(b) {
      let nm = match self.parse_ident_or_quoted() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      name = Some(nm)
      matched_any = true
    }
  }
  let filters : Array[QFilter] = []
  while self.pos < self.len && self.src.code_unit_at(self.pos) == 91 {
    let f = match self.parse_filter() {
      Ok(fl) => fl
      Err(e) => return Err(e)
    }
    filters.push(f)
    matched_any = true
  }
  if !matched_any {
    return Err(self.err("expected node selector"))
  }
  Ok(QStep::{ comb: comb, ty: ty, name: name, filters: filters })
}

fn QParser::parse_chain(self : QParser) -> Result[Array[QStep], KdlError] {
  self.skip_ws()
  let steps : Array[QStep] = []
  let first_comb = if self.pos + 1 < self.len && self.src.code_unit_at(self.pos) == 62 && self.src.code_unit_at(self.pos + 1) == 62 {
    self.pos = self.pos + 2
    QCombinator::Descendant
  } else {
    QCombinator::Root
  }
  let s0 = match self.parse_step(first_comb) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  steps.push(s0)
  while self.pos < self.len {
    let before_ws = self.pos
    self.skip_ws()
    if self.pos >= self.len {
      break
    }
    let b = self.src.code_unit_at(self.pos)
    if b == 44 {
      break
    }
    let comb = if b == 62 {
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 62 {
        self.pos = self.pos + 2
        QCombinator::Descendant
      } else {
        self.pos = self.pos + 1
        QCombinator::Child
      }
    } else if b == 47 {
      self.pos = self.pos + 1
      QCombinator::Child
    } else if self.pos > before_ws {
      QCombinator::Descendant
    } else {
      return Err(self.err("unexpected character in query selector"))
    }
    let st = match self.parse_step(comb) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    steps.push(st)
  }
  Ok(steps)
}

fn QParser::parse_all(self : QParser) -> Result[Array[Array[QStep]], KdlError] {
  self.skip_ws()
  if self.pos >= self.len {
    return Err(self.err("empty query selector"))
  }
  let chains : Array[Array[QStep]] = []
  while true {
    let ch = match self.parse_chain() {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    chains.push(ch)
    self.skip_ws()
    if self.pos >= self.len {
      break
    }
    if self.src.code_unit_at(self.pos) == 44 {
      self.pos = self.pos + 1
      self.skip_ws()
      if self.pos >= self.len {
        return Err(self.err("trailing comma in query selector"))
      }
    } else {
      return Err(self.err("unexpected trailing input in query selector"))
    }
  }
  Ok(chains)
}

fn node_matches_step(nd : KdlNode, step : QStep) -> Bool {
  match step.ty {
    Some(t) => {
      match nd.ty {
        Some(nt) => {
          if nt != t {
            return false
          }
        }
        None => return false
      }
    }
    None => ()
  }
  match step.name {
    Some(nm) => {
      if nd.name != nm {
        return false
      }
    }
    None => ()
  }
  let fn_len = step.filters.length()
  let mut i = 0
  while i < fn_len {
    let fl = step.filters[i]
    let actual : Option[KdlValue] = match fl.arg_index {
      Some(idx) => nd.arg(idx)
      None => nd.prop(fl.prop_key)
    }
    match fl.op {
      QFilterOp::Exists => {
        match actual {
          None => return false
          Some(_) => ()
        }
      }
      QFilterOp::Eq => {
        match actual {
          None => return false
          Some(av) => {
            match fl.fval {
              Some(ev) => {
                if !av.equals(ev) {
                  return false
                }
              }
              None => return false
            }
          }
        }
      }
      QFilterOp::Neq => {
        match actual {
          None => return false
          Some(av) => {
            match fl.fval {
              Some(ev) => {
                if av.equals(ev) {
                  return false
                }
              }
              None => return false
            }
          }
        }
      }
    }
    i = i + 1
  }
  true
}

///| Collect all descendants of `roots` in pre-order using an iterative stack.
fn collect_descendants(roots : Array[KdlNode], include_roots : Bool) -> Array[KdlNode] {
  let out : Array[KdlNode] = []
  let stack : Array[KdlNode] = []
  let mut i = roots.length() - 1
  while i >= 0 {
    stack.push(roots[i])
    i = i - 1
  }
  if include_roots {
    while stack.length() > 0 {
      let cur = match stack.pop() {
        Some(n) => n
        None => break
      }
      out.push(cur)
      let mut j = cur.child_nodes.length() - 1
      while j >= 0 {
        stack.push(cur.child_nodes[j])
        j = j - 1
      }
    }
  } else {
    // Only descendants strictly below roots
    let init_stack : Array[KdlNode] = []
    let mut r = roots.length() - 1
    while r >= 0 {
      let c = roots[r].child_nodes
      let mut j = c.length() - 1
      while j >= 0 {
        init_stack.push(c[j])
        j = j - 1
      }
      r = r - 1
    }
    while init_stack.length() > 0 {
      let cur = match init_stack.pop() {
        Some(n) => n
        None => break
      }
      out.push(cur)
      let mut j = cur.child_nodes.length() - 1
      while j >= 0 {
        init_stack.push(cur.child_nodes[j])
        j = j - 1
      }
    }
  }
  out
}

fn eval_query_chain(doc : KdlDocument, steps : Array[QStep]) -> Array[KdlNode] {
  let mut current : Array[KdlNode] = []
  let n = steps.length()
  let mut i = 0
  while i < n {
    let st = steps[i]
    let candidates : Array[KdlNode] = if i == 0 {
      match st.comb {
        QCombinator::Descendant => collect_descendants(doc.nodes, true)
        _ => doc.nodes
      }
    } else {
      match st.comb {
        QCombinator::Child => {
          let kids : Array[KdlNode] = []
          let mut j = 0
          while j < current.length() {
            let cs = current[j].child_nodes
            let mut k = 0
            while k < cs.length() {
              kids.push(cs[k])
              k = k + 1
            }
            j = j + 1
          }
          kids
        }
        QCombinator::Descendant => collect_descendants(current, false)
        QCombinator::Root => doc.nodes
      }
    }
    let next : Array[KdlNode] = []
    let mut j = 0
    while j < candidates.length() {
      let nd = candidates[j]
      if node_matches_step(nd, st) {
        next.push(nd)
      }
      j = j + 1
    }
    current = next
    i = i + 1
  }
  current
}

fn query_impl(
  doc : KdlDocument,
  selector : String,
) -> Result[Array[KdlNode], KdlError] {
  let qp = QParser::new(selector)
  let chains = match qp.parse_all() {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let out : Array[KdlNode] = []
  let mut i = 0
  while i < chains.length() {
    let res = eval_query_chain(doc, chains[i])
    let mut j = 0
    while j < res.length() {
      out.push(res[j])
      j = j + 1
    }
    i = i + 1
  }
  Ok(out)
}
