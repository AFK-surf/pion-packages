///| Iterative-stack KDL v2.0.0 and v1.0.0 parser with `KdlLimits`.

struct Parser {
  src : String
  len : Int
  v1 : Bool
  limits : KdlLimits
  mut pos : Int
  mut line : Int
  mut col : Int
  mut node_count : Int
  mut token_count : Int
}

fn Parser::new(src : String, start : Int, limits : KdlLimits, v1 : Bool) -> Parser {
  Parser::{
    src: src,
    len: src.length(),
    v1: v1,
    limits: limits,
    pos: start,
    line: 1,
    col: 1,
    node_count: 0,
    token_count: 0,
  }
}

fn Parser::err(self : Parser, kind : KdlErrorKind, msg : String) -> KdlError {
  KdlError::new(kind, msg, self.line, self.col, self.pos)
}

fn Parser::bump_token(self : Parser) -> Result[Unit, KdlError] {
  self.token_count = self.token_count + 1
  if self.limits.max_tokens > 0 && self.token_count > self.limits.max_tokens {
    return Err(self.err(KdlErrorKind::LimitExceeded, "max_tokens limit exceeded"))
  }
  Ok(())
}

fn Parser::bump_node(self : Parser) -> Result[Unit, KdlError] {
  self.node_count = self.node_count + 1
  if self.limits.max_nodes > 0 && self.node_count > self.limits.max_nodes {
    return Err(self.err(KdlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
  }
  Ok(())
}

///| Advance past a newline if present; returns true if a newline was consumed.
fn Parser::try_consume_newline(self : Parser) -> Bool {
  let nl = match_newline_len(self.src, self.pos, self.len)
  if nl > 0 {
    self.pos = self.pos + nl
    self.line = self.line + 1
    self.col = 1
    true
  } else {
    false
  }
}

///| Skip single-line `//...` comment (not consuming the trailing newline).
fn Parser::skip_line_comment(self : Parser) -> Unit {
  self.pos = self.pos + 2
  self.col = self.col + 2
  while self.pos < self.len {
    if match_newline_len(self.src, self.pos, self.len) > 0 {
      break
    }
    let b0 = self.src.code_unit_at(self.pos)
    if b0 < 0x80 {
      self.pos = self.pos + 1
    } else {
      let (_, clen) = decode_utf8_at(self.src, self.pos)
      self.pos = self.pos + clen
    }
    self.col = self.col + 1
  }
}

///| Skip nested multi-line `/* ... */` comment.
fn Parser::skip_block_comment(self : Parser) -> Result[Unit, KdlError] {
  let start_line = self.line
  let start_col = self.col
  let start_pos = self.pos
  self.pos = self.pos + 2
  self.col = self.col + 2
  let mut depth = 1
  while self.pos < self.len && depth > 0 {
    let b0 = self.src.code_unit_at(self.pos)
    if b0 == 47 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 42 {
      depth = depth + 1
      self.pos = self.pos + 2
      self.col = self.col + 2
    } else if b0 == 42 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 47 {
      depth = depth - 1
      self.pos = self.pos + 2
      self.col = self.col + 2
    } else if self.try_consume_newline() {
      ()
    } else if b0 < 0x80 {
      self.pos = self.pos + 1
      self.col = self.col + 1
    } else {
      let (_, clen) = decode_utf8_at(self.src, self.pos)
      self.pos = self.pos + clen
      self.col = self.col + 1
    }
  }
  if depth > 0 {
    return Err(KdlError::new(KdlErrorKind::UnterminatedComment, "unterminated multi-line comment", start_line, start_col, start_pos))
  }
  Ok(())
}

///| Skip `ws*` (`unicode-space` or `/* ... */`). Returns `true` if anything was consumed.
fn Parser::skip_ws(self : Parser) -> Result[Bool, KdlError] {
  let mut consumed = false
  while self.pos < self.len {
    let b0 = self.src.code_unit_at(self.pos)
    if b0 == 32 || b0 == 9 {
      self.pos = self.pos + 1
      self.col = self.col + 1
      consumed = true
    } else if b0 == 47 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 42 {
      match self.skip_block_comment() {
        Ok(_) => consumed = true
        Err(e) => return Err(e)
      }
    } else if b0 >= 0x80 {
      let (cp, clen) = decode_utf8_at(self.src, self.pos)
      if is_unicode_space(cp, self.v1) {
        self.pos = self.pos + clen
        self.col = self.col + 1
        consumed = true
      } else {
        break
      }
    } else {
      break
    }
  }
  Ok(consumed)
}

///| Try to consume an `escline`: `\` `ws*` (`//...`? `newline` | `eof`).
fn Parser::consume_escline(self : Parser) -> Result[Unit, KdlError] {
  // Caller verified self.src[self.pos] == '\\' (92)
  self.pos = self.pos + 1
  self.col = self.col + 1
  match self.skip_ws() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.pos >= self.len {
    return Ok(())
  }
  if self.src.code_unit_at(self.pos) == 47 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 47 {
    self.skip_line_comment()
    let _ = self.try_consume_newline()
    return Ok(())
  }
  if self.try_consume_newline() {
    return Ok(())
  }
  Err(self.err(KdlErrorKind::SyntaxError, "expected newline or comment after line continuation '\\'"))
}

///| Skip `node-space*`: any mix of `ws` and `escline`. Returns `true` if at least one `node-space` was consumed.
fn Parser::skip_node_space(self : Parser) -> Result[Bool, KdlError] {
  let mut consumed = false
  while self.pos < self.len {
    match self.skip_ws() {
      Ok(c) => {
        if c {
          consumed = true
        }
      }
      Err(e) => return Err(e)
    }
    if self.pos < self.len && self.src.code_unit_at(self.pos) == 92 {
      match self.consume_escline() {
        Ok(_) => consumed = true
        Err(e) => return Err(e)
      }
    } else {
      break
    }
  }
  Ok(consumed)
}

///| Skip `line-space*`: `node-space`, `newline`, `single-line-comment`.
fn Parser::skip_line_space(self : Parser) -> Result[Unit, KdlError] {
  while self.pos < self.len {
    match self.skip_node_space() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.pos >= self.len {
      break
    }
    if self.try_consume_newline() {
      continue
    }
    if self.src.code_unit_at(self.pos) == 47 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 47 {
      self.skip_line_comment()
      continue
    }
    break
  }
  Ok(())
}

///| Skip `linespace` + empty `;` terminators between nodes.
fn Parser::skip_between_nodes(self : Parser) -> Result[Unit, KdlError] {
  while self.pos < self.len {
    match self.skip_line_space() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.pos < self.len && self.src.code_unit_at(self.pos) == 59 {
      self.pos = self.pos + 1
      self.col = self.col + 1
      continue
    }
    break
  }
  Ok(())
}

///| Check if current position starts with `/-`.
fn Parser::is_slashdash(self : Parser) -> Bool {
  self.pos + 1 < self.len &&
  self.src.code_unit_at(self.pos) == 47 &&
  self.src.code_unit_at(self.pos + 1) == 45
}

///| Consume `/-` and following `line-space*` (v2) or `node-space*` (v1).
fn Parser::consume_slashdash(self : Parser) -> Result[Unit, KdlError] {
  self.pos = self.pos + 2
  self.col = self.col + 2
  if self.v1 {
    match self.skip_node_space() {
      Ok(_) => Ok(())
      Err(e) => Err(e)
    }
  } else {
    self.skip_line_space()
  }
}

///| Parse escape sequence after `\` inside a quoted string.
///| Writes decoded UTF-8 bytes into `sb`.
fn Parser::parse_escape(self : Parser, sb : StringBuilder) -> Result[Unit, KdlError] {
  if self.pos >= self.len {
    return Err(self.err(KdlErrorKind::UnterminatedString, "unterminated escape sequence"))
  }
  let b0 = self.src.code_unit_at(self.pos)
  if b0 == 110 {
    // \n
    sb.write_byte((10).to_byte())
    self.pos = self.pos + 1
    self.col = self.col + 1
    return Ok(())
  }
  if b0 == 114 {
    // \r
    sb.write_byte((13).to_byte())
    self.pos = self.pos + 1
    self.col = self.col + 1
    return Ok(())
  }
  if b0 == 116 {
    // \t
    sb.write_byte((9).to_byte())
    self.pos = self.pos + 1
    self.col = self.col + 1
    return Ok(())
  }
  if b0 == 92 {
    // \\
    sb.write_byte((92).to_byte())
    self.pos = self.pos + 1
    self.col = self.col + 1
    return Ok(())
  }
  if b0 == 34 {
    // \"
    sb.write_byte((34).to_byte())
    self.pos = self.pos + 1
    self.col = self.col + 1
    return Ok(())
  }
  if b0 == 98 {
    // \b
    sb.write_byte((8).to_byte())
    self.pos = self.pos + 1
    self.col = self.col + 1
    return Ok(())
  }
  if b0 == 102 {
    // \f
    sb.write_byte((12).to_byte())
    self.pos = self.pos + 1
    self.col = self.col + 1
    return Ok(())
  }
  if b0 == 115 && !self.v1 {
    // \s (KDL v2 space)
    sb.write_byte((32).to_byte())
    self.pos = self.pos + 1
    self.col = self.col + 1
    return Ok(())
  }
  if b0 == 47 && self.v1 {
    // \/ (KDL v1 only)
    sb.write_byte((47).to_byte())
    self.pos = self.pos + 1
    self.col = self.col + 1
    return Ok(())
  }
  if b0 == 117 {
    // \u{...}
    self.pos = self.pos + 1
    self.col = self.col + 1
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 123 {
      return Err(self.err(KdlErrorKind::InvalidEscape, "expected '{' after \\u"))
    }
    self.pos = self.pos + 1
    self.col = self.col + 1
    let mut cp = 0
    let mut digits = 0
    while self.pos < self.len && self.src.code_unit_at(self.pos) != 125 {
      let hv = hex_val(self.src.code_unit_at(self.pos))
      if hv < 0 {
        return Err(self.err(KdlErrorKind::InvalidEscape, "invalid hex digit in \\u{...}"))
      }
      digits = digits + 1
      if digits > 6 {
        return Err(self.err(KdlErrorKind::InvalidEscape, "too many hex digits in \\u{...}"))
      }
      cp = (cp << 4) | hv
      self.pos = self.pos + 1
      self.col = self.col + 1
    }
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 125 {
      return Err(self.err(KdlErrorKind::InvalidEscape, "unterminated \\u{...} escape"))
    }
    if digits == 0 {
      return Err(self.err(KdlErrorKind::InvalidEscape, "empty \\u{} escape"))
    }
    if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
      return Err(self.err(KdlErrorKind::InvalidEscape, "invalid Unicode scalar value in \\u{...}"))
    }
    self.pos = self.pos + 1
    self.col = self.col + 1
    write_utf8_cp(sb, cp)
    return Ok(())
  }
  // KDL v2 whitespace escape: `\` followed by 1+ unicode-space or newline
  if !self.v1 {
    let mut skipped_any = false
    while self.pos < self.len {
      if self.try_consume_newline() {
        skipped_any = true
        continue
      }
      let cb = self.src.code_unit_at(self.pos)
      if cb == 32 || cb == 9 {
        self.pos = self.pos + 1
        self.col = self.col + 1
        skipped_any = true
      } else if cb >= 0x80 {
        let (cp, clen) = decode_utf8_at(self.src, self.pos)
        if is_unicode_space(cp, false) {
          self.pos = self.pos + clen
          self.col = self.col + 1
          skipped_any = true
        } else {
          break
        }
      } else {
        break
      }
    }
    if skipped_any {
      return Ok(())
    }
  }
  Err(self.err(KdlErrorKind::InvalidEscape, "invalid escape sequence"))
}

///| Parse a single-line quoted string `"..."` (caller verified `"` at `self.pos`).
fn Parser::parse_single_quoted_string(self : Parser) -> Result[String, KdlError] {
  self.pos = self.pos + 1
  self.col = self.col + 1
  let sb = StringBuilder::new()
  while self.pos < self.len {
    let b0 = self.src.code_unit_at(self.pos)
    if b0 == 34 {
      self.pos = self.pos + 1
      self.col = self.col + 1
      return Ok(sb.to_string())
    }
    if b0 == 92 {
      self.pos = self.pos + 1
      self.col = self.col + 1
      match self.parse_escape(sb) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      continue
    }
    if !self.v1 && match_newline_len(self.src, self.pos, self.len) > 0 {
      return Err(self.err(KdlErrorKind::InvalidString, "unescaped newline in single-line string"))
    }
    if b0 < 0x80 {
      if b0 == 10 {
        self.line = self.line + 1
        self.col = 1
      } else {
        self.col = self.col + 1
      }
      sb.write_byte(b0.to_byte())
      self.pos = self.pos + 1
    } else {
      let (cp, clen) = decode_utf8_at(self.src, self.pos)
      let mut k = 0
      while k < clen {
        sb.write_byte(self.src.code_unit_at(self.pos + k).to_byte())
        k = k + 1
      }
      self.pos = self.pos + clen
      if is_newline_cp(cp) {
        self.line = self.line + 1
        self.col = 1
      } else {
        self.col = self.col + 1
      }
    }
  }
  Err(self.err(KdlErrorKind::UnterminatedString, "unterminated quoted string"))
}

///| Check whether `s` consists solely of `unicode-space` characters.
fn is_all_unicode_space(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 == 32 || b0 == 9 {
      i = i + 1
    } else if b0 >= 0x80 {
      let (cp, clen) = decode_utf8_at(s, i)
      if is_unicode_space(cp, false) {
        i = i + clen
      } else {
        return false
      }
    } else {
      return false
    }
  }
  true
}

///| Check whether `line` starts with exact byte prefix `prefix`.
fn starts_with_bytes(line : String, prefix : String) -> Bool {
  let pn = prefix.length()
  if line.length() < pn {
    return false
  }
  let mut i = 0
  while i < pn {
    if line.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Dedent collected physical lines of a KDL v2 multi-line string using `prefix`.
fn dedent_lines(
  lines : Array[String],
  prefix : String,
  err_line : Int,
  err_col : Int,
  err_pos : Int,
) -> Result[String, KdlError] {
  let sb = StringBuilder::new()
  let pn = prefix.length()
  let n = lines.length()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_byte((10).to_byte())
    }
    let ln = lines[i]
    if is_all_unicode_space(ln) {
      // Whitespace-only line becomes empty
      ()
    } else {
      if !starts_with_bytes(ln, prefix) {
        return Err(KdlError::new(KdlErrorKind::InvalidIndentation, "multi-line string line does not match closing indentation prefix", err_line, err_col, err_pos))
      }
      sb.write_string(ln.slice(pn, ln.length()))
    }
    i = i + 1
  }
  Ok(sb.to_string())
}

///| Check if `self.src` at `pos` has `"""` followed by `hashes` `#` chars.
fn Parser::matches_multiline_close(self : Parser, pos : Int, hashes : Int) -> Bool {
  if pos + 3 + hashes > self.len {
    return false
  }
  if self.src.code_unit_at(pos) != 34 || self.src.code_unit_at(pos + 1) != 34 || self.src.code_unit_at(pos + 2) != 34 {
    return false
  }
  let mut k = 0
  while k < hashes {
    if self.src.code_unit_at(pos + 3 + k) != 35 {
      return false
    }
    k = k + 1
  }
  true
}

///| Parse a KDL v2 multi-line string (either quoted with `hashes == 0` or raw with `hashes >= 1`).
///| Caller already consumed leading `#*` and verified `"""` at `self.pos`.
fn Parser::parse_multiline_string(
  self : Parser,
  hashes : Int,
) -> Result[String, KdlError] {
  let start_line = self.line
  let start_col = self.col
  let start_pos = self.pos
  self.pos = self.pos + 3
  self.col = self.col + 3
  if !self.try_consume_newline() {
    return Err(self.err(KdlErrorKind::InvalidString, "multi-line string must start with a newline after opening '\"\"\"'"))
  }
  let lines : Array[String] = []
  let mut closing_prefix = ""
  let mut found_close = false
  while self.pos < self.len {
    let line_start = self.pos
    // Scan leading unicode-space on this line
    let mut ws_end = self.pos
    while ws_end < self.len {
      let b0 = self.src.code_unit_at(ws_end)
      if b0 == 32 || b0 == 9 {
        ws_end = ws_end + 1
      } else if b0 >= 0x80 {
        let (cp, clen) = decode_utf8_at(self.src, ws_end)
        if is_unicode_space(cp, false) {
          ws_end = ws_end + clen
        } else {
          break
        }
      } else {
        break
      }
    }
    // Check if this line is the closing delimiter line
    if self.matches_multiline_close(ws_end, hashes) {
      closing_prefix = self.src.slice(line_start, ws_end)
      self.pos = ws_end + 3 + hashes
      self.col = self.col + (ws_end - line_start) + 3 + hashes
      found_close = true
      break
    }
    // Otherwise scan to end of physical line
    let mut p = line_start
    let mut escaped = false
    while p < self.len {
      let nl = match_newline_len(self.src, p, self.len)
      if nl > 0 {
        break
      }
      let b0 = self.src.code_unit_at(p)
      if hashes == 0 {
        if escaped {
          escaped = false
        } else if b0 == 92 {
          escaped = true
        } else if b0 == 34 && self.matches_multiline_close(p, 0) {
          return Err(self.err(KdlErrorKind::InvalidString, "closing '\"\"\"' must appear on its own line"))
        }
      } else if b0 == 34 && self.matches_multiline_close(p, hashes) {
        return Err(self.err(KdlErrorKind::InvalidString, "closing raw multi-line delimiter must appear on its own line"))
      }
      if b0 < 0x80 {
        p = p + 1
      } else {
        let (_, clen) = decode_utf8_at(self.src, p)
        p = p + clen
      }
    }
    lines.push(self.src.slice(line_start, p))
    self.pos = p
    if !self.try_consume_newline() {
      break
    }
  }
  if !found_close {
    return Err(KdlError::new(KdlErrorKind::UnterminatedString, "unterminated multi-line string", start_line, start_col, start_pos))
  }
  let dedented = match dedent_lines(lines, closing_prefix, start_line, start_col, start_pos) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if hashes > 0 {
    return Ok(dedented)
  }
  // Unescape quoted multi-line string content
  let sub = Parser::new(dedented, 0, self.limits, false)
  let sb = StringBuilder::new()
  while sub.pos < sub.len {
    let b0 = sub.src.code_unit_at(sub.pos)
    if b0 == 92 {
      sub.pos = sub.pos + 1
      sub.col = sub.col + 1
      match sub.parse_escape(sb) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      sb.write_byte(b0.to_byte())
      sub.pos = sub.pos + 1
    }
  }
  Ok(sb.to_string())
}

///| Parse a single-line raw string (caller consumed leading `#*` or `r#*` and verified `"` at `self.pos`).
fn Parser::parse_single_raw_string(
  self : Parser,
  hashes : Int,
) -> Result[String, KdlError] {
  let start_line = self.line
  let start_col = self.col
  let start_pos = self.pos
  self.pos = self.pos + 1
  self.col = self.col + 1
  let content_start = self.pos
  while self.pos < self.len {
    let b0 = self.src.code_unit_at(self.pos)
    if b0 == 34 {
      let mut ok = true
      if self.pos + 1 + hashes > self.len {
        ok = false
      } else {
        let mut k = 0
        while k < hashes {
          if self.src.code_unit_at(self.pos + 1 + k) != 35 {
            ok = false
            break
          }
          k = k + 1
        }
      }
      if ok {
        let res = self.src.slice(content_start, self.pos)
        self.pos = self.pos + 1 + hashes
        self.col = self.col + 1 + hashes
        return Ok(res)
      }
    }
    if !self.v1 && match_newline_len(self.src, self.pos, self.len) > 0 {
      return Err(self.err(KdlErrorKind::InvalidString, "literal newline in single-line raw string"))
    }
    if self.try_consume_newline() {
      continue
    }
    if b0 < 0x80 {
      self.pos = self.pos + 1
      self.col = self.col + 1
    } else {
      let (_, clen) = decode_utf8_at(self.src, self.pos)
      self.pos = self.pos + clen
      self.col = self.col + 1
    }
  }
  Err(KdlError::new(KdlErrorKind::UnterminatedString, "unterminated raw string", start_line, start_col, start_pos))
}

///| Parse a KDL string (quoted, multiline, raw, or bare identifier).
///| Used for node names, property keys, and type annotations.
fn Parser::parse_string(self : Parser) -> Result[String, KdlError] {
  match self.bump_token() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.pos >= self.len {
    return Err(self.err(KdlErrorKind::SyntaxError, "expected string or identifier"))
  }
  let b0 = self.src.code_unit_at(self.pos)
  if b0 == 34 {
    if !self.v1 && self.pos + 2 < self.len && self.src.code_unit_at(self.pos + 1) == 34 && self.src.code_unit_at(self.pos + 2) == 34 {
      return self.parse_multiline_string(0)
    }
    return self.parse_single_quoted_string()
  }
  if b0 == 35 && !self.v1 {
    // Raw string #"..."# or #"""..."""#
    let mut hashes = 0
    let mut p = self.pos
    while p < self.len && self.src.code_unit_at(p) == 35 {
      hashes = hashes + 1
      p = p + 1
    }
    if p < self.len && self.src.code_unit_at(p) == 34 {
      self.pos = p
      self.col = self.col + hashes
      if self.pos + 2 < self.len && self.src.code_unit_at(self.pos + 1) == 34 && self.src.code_unit_at(self.pos + 2) == 34 {
        return self.parse_multiline_string(hashes)
      }
      return self.parse_single_raw_string(hashes)
    }
    return Err(self.err(KdlErrorKind::SyntaxError, "unexpected '#' where string was expected"))
  }
  if self.v1 && b0 == 114 {
    // KDL v1 raw string: r"..." or r#"..."#
    let mut p = self.pos + 1
    let mut hashes = 0
    while p < self.len && self.src.code_unit_at(p) == 35 {
      hashes = hashes + 1
      p = p + 1
    }
    if p < self.len && self.src.code_unit_at(p) == 34 {
      self.pos = p
      self.col = self.col + 1 + hashes
      return self.parse_single_raw_string(hashes)
    }
  }
  // Bare identifier
  let start = self.pos
  while self.pos < self.len {
    let cb = self.src.code_unit_at(self.pos)
    if cb < 0x80 {
      if is_kdl_ident_char(cb, self.v1) {
        self.pos = self.pos + 1
        self.col = self.col + 1
      } else {
        break
      }
    } else {
      let (cp, clen) = decode_utf8_at(self.src, self.pos)
      if is_kdl_ident_char(cp, self.v1) {
        self.pos = self.pos + clen
        self.col = self.col + 1
      } else {
        break
      }
    }
  }
  if self.pos == start {
    return Err(self.err(KdlErrorKind::SyntaxError, "expected identifier or string"))
  }
  let ident = self.src.slice(start, self.pos)
  if !self.v1 {
    if !is_valid_v2_bare_ident(ident) {
      return Err(self.err(KdlErrorKind::SyntaxError, "invalid bare identifier in KDL v2: " + ident))
    }
  } else {
    if ident == "true" || ident == "false" || ident == "null" {
      return Err(self.err(KdlErrorKind::SyntaxError, "keyword cannot be used as bare identifier: " + ident))
    }
    let fb = ident.code_unit_at(0)
    if is_ascii_digit(fb) {
      return Err(self.err(KdlErrorKind::SyntaxError, "identifier cannot start with digit: " + ident))
    }
    if (fb == 43 || fb == 45) && ident.length() >= 2 && is_ascii_digit(ident.code_unit_at(1)) {
      return Err(self.err(KdlErrorKind::SyntaxError, "identifier cannot start with sign + digit: " + ident))
    }
  }
  Ok(ident)
}

///| Parse a number token (already known to start with digit or `+/-` + digit).
fn Parser::parse_number_token(self : Parser, raw : String) -> Result[KdlValue, KdlError] {
  let n = raw.length()
  let mut i = 0
  let mut neg = false
  let b0 = raw.code_unit_at(0)
  if b0 == 45 {
    neg = true
    i = 1
  } else if b0 == 43 {
    i = 1
  }
  if i >= n {
    return Err(self.err(KdlErrorKind::InvalidNumber, "empty number"))
  }
  // Check radix prefix: 0x, 0o, 0b (lowercase only!)
  if raw.code_unit_at(i) == 48 && i + 1 < n {
    let b1 = raw.code_unit_at(i + 1)
    if b1 == 120 || b1 == 111 || b1 == 98 {
      let radix : UInt64 = if b1 == 120 { 16UL } else if b1 == 111 { 8UL } else { 2UL }
      i = i + 2
      if i >= n || raw.code_unit_at(i) == 95 {
        return Err(self.err(KdlErrorKind::InvalidNumber, "expected digit after radix prefix"))
      }
      let limit : UInt64 = if neg { 9223372036854775808UL } else { 9223372036854775807UL }
      let mut acc : UInt64 = 0UL
      let mut has_digit = false
      while i < n {
        let c = raw.code_unit_at(i)
        if c == 95 {
          i = i + 1
          continue
        }
        let d = hex_val(c)
        if d < 0 || d.to_int64().reinterpret_as_uint64() >= radix {
          return Err(self.err(KdlErrorKind::InvalidNumber, "invalid digit in radix integer"))
        }
        has_digit = true
        let du = d.to_int64().reinterpret_as_uint64()
        if acc > (limit - du) / radix {
          return Err(self.err(KdlErrorKind::NumberOverflow, "integer literal overflows Int64"))
        }
        acc = acc * radix + du
        i = i + 1
      }
      if !has_digit {
        return Err(self.err(KdlErrorKind::InvalidNumber, "missing digits in radix integer"))
      }
      let iv = if neg {
        if acc == 9223372036854775808UL {
          -9223372036854775807L - 1L
        } else {
          -acc.reinterpret_as_int64()
        }
      } else {
        acc.reinterpret_as_int64()
      }
      return Ok(KdlValue::Int(iv))
    }
    if b1 == 88 || b1 == 79 || b1 == 66 {
      return Err(self.err(KdlErrorKind::InvalidNumber, "uppercase radix prefix is not allowed"))
    }
  }

  // Decimal integer or float
  if !is_ascii_digit(raw.code_unit_at(i)) {
    return Err(self.err(KdlErrorKind::InvalidNumber, "expected decimal digit"))
  }
  let int_start = i
  let mut has_dot = false
  let mut has_exp = false
  let mut has_underscore = false
  let mut mant : UInt64 = 0UL
  let mut mant_digits = 0
  let mut mant_overflow = false
  let mut frac_digits = 0
  let mut exp_sign = 1
  let mut exp_val = 0

  // Integer digits
  while i < n {
    let c = raw.code_unit_at(i)
    if is_ascii_digit(c) {
      let d = c - 48
      if mant != 0UL || d != 0 {
        if mant_digits < 19 {
          mant = mant * 10UL + d.to_int64().reinterpret_as_uint64()
          mant_digits = mant_digits + 1
        } else {
          mant_overflow = true
          exp_val = exp_val + 1
        }
      }
      i = i + 1
    } else if c == 95 {
      has_underscore = true
      i = i + 1
    } else {
      break
    }
  }

  // Fractional part
  if i < n && raw.code_unit_at(i) == 46 {
    has_dot = true
    i = i + 1
    if i >= n || !is_ascii_digit(raw.code_unit_at(i)) {
      return Err(self.err(KdlErrorKind::InvalidNumber, "expected digit after decimal point"))
    }
    while i < n {
      let c = raw.code_unit_at(i)
      if is_ascii_digit(c) {
        let d = c - 48
        if mant != 0UL || d != 0 {
          if mant_digits < 19 {
            mant = mant * 10UL + d.to_int64().reinterpret_as_uint64()
            mant_digits = mant_digits + 1
            frac_digits = frac_digits + 1
          } else {
            mant_overflow = true
          }
        } else {
          frac_digits = frac_digits + 1
        }
        i = i + 1
      } else if c == 95 {
        has_underscore = true
        i = i + 1
      } else {
        break
      }
    }
  }

  // Exponent part
  if i < n && (raw.code_unit_at(i) == 101 || raw.code_unit_at(i) == 69) {
    has_exp = true
    i = i + 1
    if i < n && (raw.code_unit_at(i) == 43 || raw.code_unit_at(i) == 45) {
      if raw.code_unit_at(i) == 45 {
        exp_sign = -1
      }
      i = i + 1
    }
    if i >= n || !is_ascii_digit(raw.code_unit_at(i)) {
      return Err(self.err(KdlErrorKind::InvalidNumber, "expected digit in exponent"))
    }
    let mut e_acc = 0
    while i < n {
      let c = raw.code_unit_at(i)
      if is_ascii_digit(c) {
        if e_acc < 1000000 {
          e_acc = e_acc * 10 + (c - 48)
        }
        i = i + 1
      } else if c == 95 {
        has_underscore = true
        i = i + 1
      } else {
        break
      }
    }
    exp_val = exp_val + exp_sign * e_acc
  }

  if i != n {
    return Err(self.err(KdlErrorKind::InvalidNumber, "unexpected trailing character in number: " + raw))
  }

  if !has_dot && !has_exp {
    // Parse exact Int64
    let limit : UInt64 = if neg { 9223372036854775808UL } else { 9223372036854775807UL }
    let mut acc : UInt64 = 0UL
    let mut k = int_start
    while k < n {
      let c = raw.code_unit_at(k)
      if c != 95 {
        let d = (c - 48).to_int64().reinterpret_as_uint64()
        if acc > (limit - d) / 10UL {
          return Err(self.err(KdlErrorKind::NumberOverflow, "decimal integer literal overflows Int64"))
        }
        acc = acc * 10UL + d
      }
      k = k + 1
    }
    let iv = if neg {
      if acc == 9223372036854775808UL {
        -9223372036854775807L - 1L
      } else {
        -acc.reinterpret_as_int64()
      }
    } else {
      acc.reinterpret_as_int64()
    }
    return Ok(KdlValue::Int(iv))
  }

  // Float fast path 1: exact zero
  if !mant_overflow && mant == 0UL {
    return Ok(KdlValue::Float(if neg { -0.0 } else { 0.0 }))
  }
  // Float fast path 2: Eisel-Lemire 128-bit exact conversion
  if !mant_overflow {
    let q = exp_val - frac_digits
    match eisel_lemire_f64(mant, q) {
      Some(v) => {
        let signed = if neg { if v == 0.0 { -0.0 } else { -v } } else { v }
        return Ok(KdlValue::Float(signed))
      }
      None => ()
    }
  }
  // Fallback: strip underscores and leading '+' for exact `to_double()`
  let clean = if !has_underscore && b0 != 43 {
    raw
  } else {
    let sb = StringBuilder::new()
    let mut k = if b0 == 43 { 1 } else { 0 }
    while k < n {
      let c = raw.code_unit_at(k)
      if c != 95 {
        sb.write_byte(c.to_byte())
      }
      k = k + 1
    }
    sb.to_string()
  }
  match clean.to_double() {
    Some(fv) => Ok(KdlValue::Float(fv))
    None => Err(self.err(KdlErrorKind::InvalidNumber, "invalid floating-point number: " + raw))
  }
}

///| Parse a KDL value (string, number, keyword `#true`/`#false`/`#null`/`#inf`/`#-inf`/`#nan`, or bare identifier string).
fn Parser::parse_value(self : Parser) -> Result[KdlValue, KdlError] {
  match self.bump_token() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.pos >= self.len {
    return Err(self.err(KdlErrorKind::SyntaxError, "expected value"))
  }
  let b0 = self.src.code_unit_at(self.pos)
  if b0 == 34 {
    if !self.v1 && self.pos + 2 < self.len && self.src.code_unit_at(self.pos + 1) == 34 && self.src.code_unit_at(self.pos + 2) == 34 {
      match self.parse_multiline_string(0) {
        Ok(s) => return Ok(KdlValue::Str(s))
        Err(e) => return Err(e)
      }
    }
    match self.parse_single_quoted_string() {
      Ok(s) => return Ok(KdlValue::Str(s))
      Err(e) => return Err(e)
    }
  }
  if b0 == 35 && !self.v1 {
    // Either raw string #+"..."#+ or keyword #true/#false/#null/#inf/#-inf/#nan
    let mut p = self.pos
    let mut hashes = 0
    while p < self.len && self.src.code_unit_at(p) == 35 {
      hashes = hashes + 1
      p = p + 1
    }
    if p < self.len && self.src.code_unit_at(p) == 34 {
      self.pos = p
      self.col = self.col + hashes
      if self.pos + 2 < self.len && self.src.code_unit_at(self.pos + 1) == 34 && self.src.code_unit_at(self.pos + 2) == 34 {
        match self.parse_multiline_string(hashes) {
          Ok(s) => return Ok(KdlValue::Str(s))
          Err(e) => return Err(e)
        }
      }
      match self.parse_single_raw_string(hashes) {
        Ok(s) => return Ok(KdlValue::Str(s))
        Err(e) => return Err(e)
      }
    }
    if hashes == 1 {
      let start = self.pos
      self.pos = self.pos + 1
      self.col = self.col + 1
      while self.pos < self.len {
        let cb = self.src.code_unit_at(self.pos)
        if cb < 0x80 && is_kdl_ident_char(cb, false) {
          self.pos = self.pos + 1
          self.col = self.col + 1
        } else {
          break
        }
      }
      let kw = self.src.slice(start, self.pos)
      if kw == "#true" {
        return Ok(KdlValue::Bool(true))
      } else if kw == "#false" {
        return Ok(KdlValue::Bool(false))
      } else if kw == "#null" {
        return Ok(KdlValue::Null)
      } else if kw == "#inf" {
        return Ok(KdlValue::Float(1.0 / 0.0))
      } else if kw == "#-inf" {
        return Ok(KdlValue::Float(-1.0 / 0.0))
      } else if kw == "#nan" {
        return Ok(KdlValue::Float(0.0 / 0.0))
      }
      return Err(self.err(KdlErrorKind::SyntaxError, "unknown '#' keyword: " + kw))
    }
    return Err(self.err(KdlErrorKind::SyntaxError, "invalid '#' token"))
  }
  if self.v1 && b0 == 114 {
    // KDL v1 raw string
    let mut p = self.pos + 1
    let mut hashes = 0
    while p < self.len && self.src.code_unit_at(p) == 35 {
      hashes = hashes + 1
      p = p + 1
    }
    if p < self.len && self.src.code_unit_at(p) == 34 {
      self.pos = p
      self.col = self.col + 1 + hashes
      match self.parse_single_raw_string(hashes) {
        Ok(s) => return Ok(KdlValue::Str(s))
        Err(e) => return Err(e)
      }
    }
  }
  // Scan bare token (number, v1 keyword, or v2 bare identifier string)
  let start = self.pos
  while self.pos < self.len {
    let cb = self.src.code_unit_at(self.pos)
    if cb < 0x80 {
      if is_kdl_ident_char(cb, self.v1) {
        self.pos = self.pos + 1
        self.col = self.col + 1
      } else {
        break
      }
    } else {
      let (cp, clen) = decode_utf8_at(self.src, self.pos)
      if is_kdl_ident_char(cp, self.v1) {
        self.pos = self.pos + clen
        self.col = self.col + 1
      } else {
        break
      }
    }
  }
  if self.pos == start {
    return Err(self.err(KdlErrorKind::SyntaxError, "expected value"))
  }
  let tok = self.src.slice(start, self.pos)
  // Check if it looks like a number: starts with digit or (+/- followed by digit)
  let t0 = tok.code_unit_at(0)
  let is_num_start = is_ascii_digit(t0) || ((t0 == 43 || t0 == 45) && tok.length() >= 2 && is_ascii_digit(tok.code_unit_at(1)))
  if is_num_start {
    return self.parse_number_token(tok)
  }
  // Leading dot + digit (e.g. `.5`, `-.5`) is always an invalid number
  if t0 == 46 && tok.length() >= 2 && is_ascii_digit(tok.code_unit_at(1)) {
    return Err(self.err(KdlErrorKind::InvalidNumber, "numbers cannot start with '.'"))
  }
  if (t0 == 43 || t0 == 45) && tok.length() >= 3 && tok.code_unit_at(1) == 46 && is_ascii_digit(tok.code_unit_at(2)) {
    return Err(self.err(KdlErrorKind::InvalidNumber, "numbers cannot start with sign + '.'"))
  }
  if self.v1 {
    if tok == "true" {
      return Ok(KdlValue::Bool(true))
    } else if tok == "false" {
      return Ok(KdlValue::Bool(false))
    } else if tok == "null" {
      return Ok(KdlValue::Null)
    }
    return Err(self.err(KdlErrorKind::SyntaxError, "bare identifier strings are not allowed as values in KDL v1: " + tok))
  }
  // KDL v2 bare identifier string value
  if !is_valid_v2_bare_ident(tok) {
    return Err(self.err(KdlErrorKind::SyntaxError, "disallowed bare keyword in KDL v2 (use '#' prefix or quotes): " + tok))
  }
  Ok(KdlValue::Str(tok))
}

///| Parse optional `(type)` annotation. Returns `Some(type_name)` if `(` was present.
fn Parser::try_parse_type(self : Parser) -> Result[Option[String], KdlError] {
  if self.pos >= self.len || self.src.code_unit_at(self.pos) != 40 {
    return Ok(None)
  }
  self.pos = self.pos + 1
  self.col = self.col + 1
  if !self.v1 {
    match self.skip_ws() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let ty = match self.parse_string() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if !self.v1 {
    match self.skip_ws() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  if self.pos >= self.len || self.src.code_unit_at(self.pos) != 41 {
    return Err(self.err(KdlErrorKind::SyntaxError, "expected ')' to close type annotation"))
  }
  self.pos = self.pos + 1
  self.col = self.col + 1
  if !self.v1 {
    match self.skip_ws() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  Ok(Some(ty))
}

///| Add a property to `entries` using last-wins semantics (replacing any earlier entry with same key).
fn add_prop_last_wins(entries : Array[KdlEntry], entry : KdlEntry, key : String) -> Unit {
  let n = entries.length()
  let mut i = 0
  while i < n {
    match entries[i].name {
      Some(k) => {
        if k == key {
          entries[i] = entry
          return
        }
      }
      None => ()
    }
    i = i + 1
  }
  entries.push(entry)
}

///| Check if current position is a node terminator (`;`, newline, `}`, `//`, or EOF).
fn Parser::at_node_terminator(self : Parser) -> Bool {
  if self.pos >= self.len {
    return true
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 59 || b == 125 {
    return true
  }
  if b == 47 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 47 {
    return true
  }
  match_newline_len(self.src, self.pos, self.len) > 0
}

///| Consume a node terminator (`;`, newline, `//` + newline, or leave `}` / EOF for enclosing frame).
fn Parser::consume_node_terminator(self : Parser) -> Result[Unit, KdlError] {
  if self.pos >= self.len {
    return Ok(())
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 125 {
    // Closing brace belongs to enclosing block
    return Ok(())
  }
  if b == 59 {
    self.pos = self.pos + 1
    self.col = self.col + 1
    return Ok(())
  }
  if b == 47 && self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 47 {
    self.skip_line_comment()
    let _ = self.try_consume_newline()
    return Ok(())
  }
  if self.try_consume_newline() {
    return Ok(())
  }
  Err(self.err(KdlErrorKind::SyntaxError, "expected node terminator (newline, ';', or '}')"))
}

struct PendingNode {
  node : KdlNode
  node_slashdashed : Bool
  mut has_children : Bool
}

struct BlockFrame {
  nodes : Array[KdlNode]
  block_slashdashed : Bool
  parent : Option[PendingNode]
}

fn parse_kdl_impl(
  src : String,
  limits : KdlLimits,
  v1 : Bool,
) -> Result[KdlDocument, KdlError] {
  let start = match validate_kdl_source(src, v1) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let p = Parser::new(src, start, limits, v1)
  let root_nodes : Array[KdlNode] = []
  let stack : Array[BlockFrame] = [
    BlockFrame::{
      nodes: root_nodes,
      block_slashdashed: false,
      parent: None,
    },
  ]

  // Active node currently being finished after returning from a children block, if any.
  let mut active_parent : Option[PendingNode] = None

  while true {
    // Phase A: If we just popped out of a children block, finish the parent node's post-children loop.
    match active_parent {
      Some(pn) => {
        let mut entered_child = false
        while true {
          match p.skip_node_space() {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          if p.at_node_terminator() {
            match p.consume_node_terminator() {
              Ok(_) => break
              Err(e) => return Err(e)
            }
          }
          if p.is_slashdash() {
            match p.consume_slashdash() {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            if p.pos < p.len && p.src.code_unit_at(p.pos) == 123 {
              // Slashdashed children block after a children block
              let depth = stack.length()
              if p.limits.max_depth > 0 && depth > p.limits.max_depth {
                return Err(p.err(KdlErrorKind::LimitExceeded, "max_depth limit exceeded"))
              }
              p.pos = p.pos + 1
              p.col = p.col + 1
              active_parent = None
              stack.push(BlockFrame::{
                nodes: [],
                block_slashdashed: true,
                parent: Some(pn),
              })
              entered_child = true
              break
            }
            return Err(p.err(KdlErrorKind::InvalidSlashdash, "only slashdashed children blocks may follow a children block"))
          }
          if p.pos < p.len && p.src.code_unit_at(p.pos) == 123 {
            if pn.has_children {
              return Err(p.err(KdlErrorKind::SyntaxError, "node cannot have multiple children blocks"))
            }
            pn.has_children = true
            let depth = stack.length()
            if p.limits.max_depth > 0 && depth > p.limits.max_depth {
              return Err(p.err(KdlErrorKind::LimitExceeded, "max_depth limit exceeded"))
            }
            p.pos = p.pos + 1
            p.col = p.col + 1
            active_parent = None
            let cur_frame = stack[stack.length() - 1]
            let is_sd = cur_frame.block_slashdashed || pn.node_slashdashed
            stack.push(BlockFrame::{
              nodes: pn.node.child_nodes,
              block_slashdashed: is_sd,
              parent: Some(pn),
            })
            entered_child = true
            break
          }
          return Err(p.err(KdlErrorKind::SyntaxError, "unexpected token after children block"))
        }
        if entered_child {
          continue
        }
        // Finished parent node; push to current frame if not slashdashed
        let cur_frame = stack[stack.length() - 1]
        if !cur_frame.block_slashdashed && !pn.node_slashdashed {
          cur_frame.nodes.push(pn.node)
        }
        active_parent = None
        continue
      }
      None => ()
    }

    // Phase B: Parse next node or closing `}` in current BlockFrame
    match p.skip_between_nodes() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if p.pos >= p.len {
      if stack.length() > 1 {
        return Err(p.err(KdlErrorKind::UnterminatedBlock, "unterminated children block '{'"))
      }
      break
    }
    if p.src.code_unit_at(p.pos) == 125 {
      if stack.length() <= 1 {
        return Err(p.err(KdlErrorKind::SyntaxError, "unexpected '}' at top level"))
      }
      p.pos = p.pos + 1
      p.col = p.col + 1
      let popped = match stack.pop() {
        Some(f) => f
        None => break
      }
      active_parent = popped.parent
      continue
    }

    // Optional slashdash before node
    let mut node_sd = false
    if p.is_slashdash() {
      node_sd = true
      match p.consume_slashdash() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if p.pos >= p.len || p.src.code_unit_at(p.pos) == 125 || p.src.code_unit_at(p.pos) == 59 {
        return Err(p.err(KdlErrorKind::InvalidSlashdash, "dangling slashdash without a following node"))
      }
    }

    // Parse node type + name
    let node_ty = match p.try_parse_type() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let node_name = match p.parse_string() {
      Ok(nm) => nm
      Err(e) => return Err(e)
    }
    match p.bump_node() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let entries : Array[KdlEntry] = []
    let children : Array[KdlNode] = []
    let cur_frame = stack[stack.length() - 1]
    let discard_node = cur_frame.block_slashdashed || node_sd

    // Parse node entries (args, props, slashdashed entries) until `{` or terminator
    let mut entered_child_block = false
    let mut has_real_children = false
    while true {
      let had_space = match p.skip_node_space() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      if p.at_node_terminator() {
        match p.consume_node_terminator() {
          Ok(_) => break
          Err(e) => return Err(e)
        }
      }
      if p.pos < p.len && p.src.code_unit_at(p.pos) == 123 {
        // Real children block (space not required before `{`)
        has_real_children = true
        let depth = stack.length()
        if p.limits.max_depth > 0 && depth > p.limits.max_depth {
          return Err(p.err(KdlErrorKind::LimitExceeded, "max_depth limit exceeded"))
        }
        p.pos = p.pos + 1
        p.col = p.col + 1
        let pn = PendingNode::{
          node: KdlNode::new(node_name, node_ty, entries, children),
          node_slashdashed: node_sd,
          has_children: true,
        }
        stack.push(BlockFrame::{
          nodes: pn.node.child_nodes,
          block_slashdashed: discard_node,
          parent: Some(pn),
        })
        entered_child_block = true
        break
      }
      // Anything else (entry or slashdash) requires node-space after previous item
      if !had_space {
        return Err(p.err(KdlErrorKind::SyntaxError, "expected whitespace before node argument or property"))
      }
      let mut entry_sd = false
      if p.is_slashdash() {
        entry_sd = true
        match p.consume_slashdash() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        if p.at_node_terminator() {
          return Err(p.err(KdlErrorKind::InvalidSlashdash, "dangling slashdash inside node"))
        }
        if p.pos < p.len && p.src.code_unit_at(p.pos) == 123 {
          // Slashdashed children block
          let depth = stack.length()
          if p.limits.max_depth > 0 && depth > p.limits.max_depth {
            return Err(p.err(KdlErrorKind::LimitExceeded, "max_depth limit exceeded"))
          }
          p.pos = p.pos + 1
          p.col = p.col + 1
          let pn = PendingNode::{
            node: KdlNode::new(node_name, node_ty, entries, children),
            node_slashdashed: node_sd,
            has_children: has_real_children,
          }
          stack.push(BlockFrame::{
            nodes: [],
            block_slashdashed: true,
            parent: Some(pn),
          })
          entered_child_block = true
          break
        }
      }

      // Parse entry: either `(type)value` (positional arg) OR `key=val` (prop) OR `value` (positional arg)
      if p.pos < p.len && p.src.code_unit_at(p.pos) == 40 {
        let ety = match p.try_parse_type() {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        let v = match p.parse_value() {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        // Check that `=` does not immediately follow (property keys cannot have type annotations!)
        let save_pos = p.pos
        let save_line = p.line
        let save_col = p.col
        if !p.v1 {
          let _ = p.skip_ws()
        }
        if p.pos < p.len && p.src.code_unit_at(p.pos) == 61 {
          return Err(p.err(KdlErrorKind::SyntaxError, "property keys cannot have type annotations"))
        }
        p.pos = save_pos
        p.line = save_line
        p.col = save_col
        if !discard_node && !entry_sd {
          entries.push(KdlEntry::arg(v, ety))
        }
      } else {
        // Could be `prop_key = [type] val` or positional `val`
        let save_pos = p.pos
        let save_line = p.line
        let save_col = p.col
        let save_tok = p.token_count
        let mut is_prop = false
        let mut prop_key = ""
        // Try parsing as string to see if `=` follows
        match p.parse_string() {
          Ok(k) => {
            let after_k_pos = p.pos
            let after_k_line = p.line
            let after_k_col = p.col
            if !p.v1 {
              match p.skip_ws() {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
            }
            if p.pos < p.len && p.src.code_unit_at(p.pos) == 61 {
              is_prop = true
              prop_key = k
              p.pos = p.pos + 1
              p.col = p.col + 1
              if !p.v1 {
                match p.skip_ws() {
                  Ok(_) => ()
                  Err(e) => return Err(e)
                }
              }
            } else {
              // Not a property; rewind to parse as value
              let _ = after_k_pos
              let _ = after_k_line
              let _ = after_k_col
              p.pos = save_pos
              p.line = save_line
              p.col = save_col
              p.token_count = save_tok
            }
          }
          Err(_) => {
            // Rewind and parse as value (e.g., number or #keyword)
            p.pos = save_pos
            p.line = save_line
            p.col = save_col
            p.token_count = save_tok
          }
        }
        if is_prop {
          let vty = match p.try_parse_type() {
            Ok(t) => t
            Err(e) => return Err(e)
          }
          let v = match p.parse_value() {
            Ok(x) => x
            Err(e) => return Err(e)
          }
          if !discard_node && !entry_sd {
            add_prop_last_wins(entries, KdlEntry::prop(prop_key, v, vty), prop_key)
          }
        } else {
          let v = match p.parse_value() {
            Ok(x) => x
            Err(e) => return Err(e)
          }
          if !discard_node && !entry_sd {
            entries.push(KdlEntry::arg(v, None))
          }
        }
      }
    }

    if !entered_child_block && !discard_node {
      cur_frame.nodes.push(KdlNode::new(node_name, node_ty, entries, children))
    }
  }

  Ok(KdlDocument::new(root_nodes))
}
