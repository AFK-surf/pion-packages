///| KDL v1.0.0 compatibility mode, formatting roundtrip, AST navigation, query engine, and deep nesting tests.

///|
test "v1_compat_mode_basics" {
  let src =
  "// KDL v1 document\n" +
  "flags true false null ok=true empty=null\n" +
  "raw r\"hello\\nworld\" r#\"has \"quotes\" inside\"#\n" +
  "esc \"a\\/b\\nc\"\n" +
  "(u8)typed (str)\"val\" k=(i32)42\n" +
  "/- skipped 1 2\n" +
  "parent {\n" +
  "    child 1_000 0xff 3.14\n" +
  "}\n"
  let doc = match parse_v1(src) {
    Ok(d) => d
    Err(e) => panic("parse_v1 failed: " + e.message)
  }
  assert_eq_int(doc.nodes.length(), 5)
  let flags = u_node(doc.get("flags"))
  assert_true(u_bool(u_val(flags.arg(0)).as_bool()) == true, "v1 true")
  assert_true(u_bool(u_val(flags.arg(1)).as_bool()) == false, "v1 false")
  assert_true(u_val(flags.arg(2)).is_null(), "v1 null")
  assert_true(u_bool(u_val(flags.prop("ok")).as_bool()) == true, "v1 prop true")
  assert_true(u_val(flags.prop("empty")).is_null(), "v1 prop null")

  let raw = u_node(doc.get("raw"))
  assert_eq_str(u_str(u_val(raw.arg(0)).as_str()), "hello\\nworld")
  assert_eq_str(u_str(u_val(raw.arg(1)).as_str()), "has \"quotes\" inside")

  let esc = u_node(doc.get("esc"))
  assert_eq_str(u_str(u_val(esc.arg(0)).as_str()), "a/b\nc")

  let typed = u_node(doc.get("typed"))
  assert_eq_str(u_str(typed.ty), "u8")
  assert_eq_str(u_str(u_entry(typed.arg_entry(0)).ty), "str")
  assert_eq_str(u_str(u_entry(typed.prop_entry("k")).ty), "i32")
  assert_eq_i64(u_i64(u_val(typed.prop("k")).as_int()), 42L)
}

///|
test "format_and_compact_lossless_roundtrip" {
  let src =
  "(app)service \"api-gateway\" port=8080 tls=#true ratio=-0.0 limit=#inf bad=#nan {\n" +
  "    \"route /v1\" \"/users\" (u16)200\n" +
  "    \"true\" \"false\" key=\"line1\\nline2\\t\\\"q\\\"\"\n" +
  "    nested {\n" +
  "        leaf #null -42 3.141592653589793\n" +
  "    }\n" +
  "}\n"
  let doc1 = must_parse(src)
  let formatted = format(doc1)
  let doc2 = must_parse(formatted)
  assert_true(doc1.equals(doc2), "format roundtrip equality")

  // Idempotency
  let formatted2 = format(doc2)
  assert_eq_str(formatted, formatted2)

  // Compact format roundtrip
  let compact = format_compact(doc1)
  let doc3 = must_parse(compact)
  assert_true(doc1.equals(doc3), "format_compact roundtrip equality")
}

///|
test "ast_navigation_helpers" {
  let src =
  "server \"primary\" host=\"127.0.0.1\" port=8080 {\n" +
  "    worker 1 role=\"http\"\n" +
  "    worker 2 role=\"grpc\"\n" +
  "    metrics #true\n" +
  "}\n" +
  "server \"replica\" host=\"127.0.0.2\" port=8081\n"
  let doc = must_parse(src)
  assert_eq_int(doc.get_all("server").length(), 2)
  assert_eq_str(u_str(u_val(doc.get_arg("server")).as_str()), "primary")

  let primary = u_node(doc.get("server"))
  assert_eq_str(u_str(u_val(primary.prop("host")).as_str()), "127.0.0.1")
  assert_eq_i64(u_i64(u_val(primary.prop("port")).as_int()), 8080L)
  assert_eq_int(primary.children_named("worker").length(), 2)
  assert_true(u_bool(u_val(u_node(primary.child("metrics")).arg(0)).as_bool()) == true, "metrics child")
  assert_true(is_none_node(primary.child("missing")), "missing child")
}

///|
test "query_engine_selectors" {
  let src =
  "package \"demo\" version=\"1.0.0\" {\n" +
  "    (dep)dependency \"serde\" version=\"1.0\" optional=#false\n" +
  "    (dep)dependency \"tokio\" version=\"1.40\" optional=#true\n" +
  "    targets {\n" +
  "        bin \"app\" {\n" +
  "            env \"prod\" debug=#false\n" +
  "        }\n" +
  "        lib \"core\" {\n" +
  "            env \"dev\" debug=#true\n" +
  "        }\n" +
  "    }\n" +
  "}\n"
  let doc = must_parse(src)

  // Direct child path
  let r1 = match query(doc, "package > dependency") {
    Ok(v) => v
    Err(e) => panic("query failed: " + e.message)
  }
  assert_eq_int(r1.length(), 2)

  // Slash path shorthand
  let r2 = match query(doc, "package/targets/bin/env") {
    Ok(v) => v
    Err(e) => panic("query failed: " + e.message)
  }
  assert_eq_int(r2.length(), 1)
  assert_eq_str(u_str(u_val(r2[0].arg(0)).as_str()), "prod")

  // Descendant combinator
  let r3 = match query(doc, "package >> env") {
    Ok(v) => v
    Err(e) => panic("query failed: " + e.message)
  }
  assert_eq_int(r3.length(), 2)

  // Global descendant search
  let r4 = match query(doc, ">> env[debug=#true]") {
    Ok(v) => v
    Err(e) => panic("query failed: " + e.message)
  }
  assert_eq_int(r4.length(), 1)
  assert_eq_str(u_str(u_val(r4[0].arg(0)).as_str()), "dev")

  // Type annotation + property filter
  let r5 = match query(doc, "package > (dep)dependency[optional=#true]") {
    Ok(v) => v
    Err(e) => panic("query failed: " + e.message)
  }
  assert_eq_int(r5.length(), 1)
  assert_eq_str(u_str(u_val(r5[0].arg(0)).as_str()), "tokio")

  // Positional arg filter
  let r6 = match query(doc, "package > dependency[0=\"serde\"]") {
    Ok(v) => v
    Err(e) => panic("query failed: " + e.message)
  }
  assert_eq_int(r6.length(), 1)
  assert_eq_str(u_str(u_val(r6[0].prop("version")).as_str()), "1.0")

  // Wildcard + union
  let r7 = match query(doc, "package > targets > *") {
    Ok(v) => v
    Err(e) => panic("query failed: " + e.message)
  }
  assert_eq_int(r7.length(), 2)

  let r8 = match query(doc, ">> bin, >> lib") {
    Ok(v) => v
    Err(e) => panic("query failed: " + e.message)
  }
  assert_eq_int(r8.length(), 2)

  // Invalid query rejected
  match query(doc, "package > [unclosed") {
    Ok(_) => panic("expected InvalidQuery")
    Err(e) => {
      if !e.is_kind(KdlErrorKind::InvalidQuery) {
        panic("expected InvalidQuery, got " + error_kind_as_str(e.kind))
      }
    }
  }
}

///|
test "deep_nesting_iterative_stack_safety" {
  // Depth 400 must parse, format, and query without stack overflow
  let depth = 400
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_string("n {\n")
    i = i + 1
  }
  sb.write_string("leaf 42\n")
  i = 0
  while i < depth {
    sb.write_string("}\n")
    i = i + 1
  }
  let doc = match parse_with_limits(sb.to_string(), KdlLimits::new(500, 10000, 100000)) {
    Ok(d) => d
    Err(e) => panic("deep nesting parse failed: " + e.message)
  }
  let leaves = match query(doc, ">> leaf") {
    Ok(v) => v
    Err(e) => panic("deep nesting query failed: " + e.message)
  }
  assert_eq_int(leaves.length(), 1)
  assert_eq_i64(u_i64(u_val(leaves[0].arg(0)).as_int()), 42L)

  let formatted = format(doc)
  let doc2 = match parse_with_limits(formatted, KdlLimits::new(500, 10000, 100000)) {
    Ok(d) => d
    Err(e) => panic("deep nesting format roundtrip failed: " + e.message)
  }
  assert_true(doc.equals(doc2), "deep nesting roundtrip equality")
}
