///| Official KDL v2.0.0 valid compliance test suite.

fn must_parse(src : String) -> KdlDocument {
  match parse(src) {
    Ok(doc) => doc
    Err(e) => {
      panic("expected valid KDL v2, got error (" + error_kind_as_str(e.kind) + " at " + e.line.to_string() + ":" + e.column.to_string() + "): " + e.message)
    }
  }
}

fn u_node(opt : Option[KdlNode]) -> KdlNode {
  match opt {
    Some(v) => v
    None => panic("expected Some(KdlNode), got None")
  }
}

fn u_val(opt : Option[KdlValue]) -> KdlValue {
  match opt {
    Some(v) => v
    None => panic("expected Some(KdlValue), got None")
  }
}

fn u_entry(opt : Option[KdlEntry]) -> KdlEntry {
  match opt {
    Some(v) => v
    None => panic("expected Some(KdlEntry), got None")
  }
}

fn u_str(opt : Option[String]) -> String {
  match opt {
    Some(v) => v
    None => panic("expected Some(String), got None")
  }
}

fn u_i64(opt : Option[Int64]) -> Int64 {
  match opt {
    Some(v) => v
    None => panic("expected Some(Int64), got None")
  }
}

fn u_f64(opt : Option[Double]) -> Double {
  match opt {
    Some(v) => v
    None => panic("expected Some(Double), got None")
  }
}

fn u_bool(opt : Option[Bool]) -> Bool {
  match opt {
    Some(v) => v
    None => panic("expected Some(Bool), got None")
  }
}

fn is_none_str(opt : Option[String]) -> Bool {
  match opt {
    None => true
    Some(_) => false
  }
}

fn is_none_node(opt : Option[KdlNode]) -> Bool {
  match opt {
    None => true
    Some(_) => false
  }
}

fn assert_eq_str(actual : String, expected : String) -> Unit {
  if actual != expected {
    panic("string mismatch:\n  actual:   " + actual + "\n  expected: " + expected)
  }
}

fn assert_eq_int(actual : Int, expected : Int) -> Unit {
  if actual != expected {
    panic("int mismatch: actual=" + actual.to_string() + " expected=" + expected.to_string())
  }
}

fn assert_eq_i64(actual : Int64, expected : Int64) -> Unit {
  if actual != expected {
    panic("i64 mismatch: actual=" + actual.to_string() + " expected=" + expected.to_string())
  }
}

fn assert_true(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic("assertion failed: " + msg)
  }
}

///|
test "v2_valid_empty_and_whitespace" {
  assert_eq_int(must_parse("").nodes.length(), 0)
  assert_eq_int(must_parse("   \t\n\r\n  ").nodes.length(), 0)
  assert_eq_int(must_parse("// just a comment\n/* block */\n").nodes.length(), 0)
  // Leading UTF-8 BOM
  let bom_doc = must_parse("\u{FEFF}node 1\n")
  assert_eq_int(bom_doc.nodes.length(), 1)
  assert_eq_str(bom_doc.nodes[0].name, "node")
  assert_eq_i64(u_i64(u_val(bom_doc.nodes[0].arg(0)).as_int()), 1L)
}

///|
test "v2_valid_identifiers_and_unicode" {
  let doc = must_parse(
    "foo\n" +
    "foo-bar_baz.qux\n" +
    "+foo\n" +
    "-bar\n" +
    ".baz\n" +
    "+.qux\n" +
    "-.quux\n" +
    "+\n" +
    "-\n" +
    ".\n" +
    "日本語ノード 値=こんにちは\n" +
    "🚀 \"rocket\"\n",
  )
  assert_eq_int(doc.nodes.length(), 12)
  assert_eq_str(doc.nodes[0].name, "foo")
  assert_eq_str(doc.nodes[1].name, "foo-bar_baz.qux")
  assert_eq_str(doc.nodes[2].name, "+foo")
  assert_eq_str(doc.nodes[3].name, "-bar")
  assert_eq_str(doc.nodes[4].name, ".baz")
  assert_eq_str(doc.nodes[5].name, "+.qux")
  assert_eq_str(doc.nodes[6].name, "-.quux")
  assert_eq_str(doc.nodes[7].name, "+")
  assert_eq_str(doc.nodes[8].name, "-")
  assert_eq_str(doc.nodes[9].name, ".")
  assert_eq_str(doc.nodes[10].name, "日本語ノード")
  assert_eq_str(u_str(u_val(doc.nodes[10].prop("値")).as_str()), "こんにちは")
  assert_eq_str(doc.nodes[11].name, "🚀")
  assert_eq_str(u_str(u_val(doc.nodes[11].arg(0)).as_str()), "rocket")
}

///|
test "v2_valid_quoted_strings_and_escapes" {
  let doc = must_parse(
    "s \"hello\\nworld\\r\\t\\\\\\\"\\b\\f\\s!\"\n" +
    "u \"\\u{0}\\u{41}\\u{1F600}\\u{10FFFF}\"\n" +
    "ws \"foo\\   \n\t   bar\"\n" +
    "kw \"true\" \"false\" \"null\" \"inf\" \"-inf\" \"nan\"\n",
  )
  assert_eq_str(
    u_str(u_val(doc.nodes[0].arg(0)).as_str()),
    "hello\nworld\r\t\\\"\u{08}\u{0C} !",
  )
  assert_eq_str(
    u_str(u_val(doc.nodes[1].arg(0)).as_str()),
    "\u{00}A\u{1F600}\u{10FFFF}",
  )
  assert_eq_str(u_str(u_val(doc.nodes[2].arg(0)).as_str()), "foobar")
  assert_eq_str(u_str(u_val(doc.nodes[3].arg(0)).as_str()), "true")
  assert_eq_str(u_str(u_val(doc.nodes[3].arg(1)).as_str()), "false")
  assert_eq_str(u_str(u_val(doc.nodes[3].arg(2)).as_str()), "null")
  assert_eq_str(u_str(u_val(doc.nodes[3].arg(3)).as_str()), "inf")
  assert_eq_str(u_str(u_val(doc.nodes[3].arg(4)).as_str()), "-inf")
  assert_eq_str(u_str(u_val(doc.nodes[3].arg(5)).as_str()), "nan")
}

///|
test "v2_valid_multiline_strings_dedent" {
  let src =
  "ml \"\"\"\n" +
  "    line1\n" +
  "      indented\n" +
  "\n" +
  "  \n" +
  "    line4\n" +
  "    \"\"\"\n"
  let doc = must_parse(src)
  assert_eq_str(
    u_str(u_val(doc.nodes[0].arg(0)).as_str()),
    "line1\n  indented\n\n\nline4",
  )

  // CRLF normalized to LF inside multiline strings
  let crlf = "ml \"\"\"\r\n  a\r\n  b\r\n  \"\"\"\r\n"
  let doc2 = must_parse(crlf)
  assert_eq_str(u_str(u_val(doc2.nodes[0].arg(0)).as_str()), "a\nb")

  // Empty multiline string
  let empty_ml = "ml \"\"\"\n    \"\"\"\n"
  let doc3 = must_parse(empty_ml)
  assert_eq_str(u_str(u_val(doc3.nodes[0].arg(0)).as_str()), "")

  // Multiline string with whitespace escape
  let ws_ml = "ml \"\"\"\n  hello\\ \n  world\n  \"\"\"\n"
  let doc4 = must_parse(ws_ml)
  assert_eq_str(u_str(u_val(doc4.nodes[0].arg(0)).as_str()), "helloworld")
}

///|
test "v2_valid_raw_strings_single_and_multiline" {
  let src =
  "r1 #\"hello\\n\"world\"\"#\n" +
  "r2 ##\"has \"# inside\"##\n" +
  "r3 #\"\"\"\n" +
  "    raw \\n \\u{41} \"quotes\"\n" +
  "      more\n" +
  "    \"\"\"#\n" +
  "r4 ##\"\"\"\n" +
  "  has \"\"\"# inside\n" +
  "  \"\"\"##\n"
  let doc = must_parse(src)
  assert_eq_str(u_str(u_val(doc.nodes[0].arg(0)).as_str()), "hello\\n\"world\"")
  assert_eq_str(u_str(u_val(doc.nodes[1].arg(0)).as_str()), "has \"# inside")
  assert_eq_str(
    u_str(u_val(doc.nodes[2].arg(0)).as_str()),
    "raw \\n \\u{41} \"quotes\"\n  more",
  )
  assert_eq_str(u_str(u_val(doc.nodes[3].arg(0)).as_str()), "has \"\"\"# inside")
}

///|
test "v2_valid_numbers_all_radices_and_floats" {
  let src =
  "ints 0 -0 +42 -42 1_000_000 1_000_ 9223372036854775807 -9223372036854775808\n" +
  "hex 0x0 0xdead_beef -0xff +0x1_0_\n" +
  "oct 0o0 0o755 -0o10 +0o7_7\n" +
  "bin 0b0 0b1010_0101 -0b11 +0b1_0\n" +
  "flt 0.0 -0.0 3.141592653589793 -1.5e-3 +1_0.2_5e+2 1e10 2E-5\n" +
  "special #inf #-inf #nan\n"
  let doc = must_parse(src)

  // Decimal ints
  let ints = doc.nodes[0]
  assert_eq_i64(u_i64(u_val(ints.arg(0)).as_int()), 0L)
  assert_eq_i64(u_i64(u_val(ints.arg(1)).as_int()), 0L)
  assert_eq_i64(u_i64(u_val(ints.arg(2)).as_int()), 42L)
  assert_eq_i64(u_i64(u_val(ints.arg(3)).as_int()), -42L)
  assert_eq_i64(u_i64(u_val(ints.arg(4)).as_int()), 1000000L)
  assert_eq_i64(u_i64(u_val(ints.arg(5)).as_int()), 1000L)
  assert_eq_i64(u_i64(u_val(ints.arg(6)).as_int()), 9223372036854775807L)
  assert_eq_i64(u_i64(u_val(ints.arg(7)).as_int()), -9223372036854775807L - 1L)

  // Hex
  let hex = doc.nodes[1]
  assert_eq_i64(u_i64(u_val(hex.arg(0)).as_int()), 0L)
  assert_eq_i64(u_i64(u_val(hex.arg(1)).as_int()), 0xdeadbeefL)
  assert_eq_i64(u_i64(u_val(hex.arg(2)).as_int()), -255L)
  assert_eq_i64(u_i64(u_val(hex.arg(3)).as_int()), 16L)

  // Octal
  let oct = doc.nodes[2]
  assert_eq_i64(u_i64(u_val(oct.arg(0)).as_int()), 0L)
  assert_eq_i64(u_i64(u_val(oct.arg(1)).as_int()), 493L)
  assert_eq_i64(u_i64(u_val(oct.arg(2)).as_int()), -8L)
  assert_eq_i64(u_i64(u_val(oct.arg(3)).as_int()), 63L)

  // Binary
  let bin = doc.nodes[3]
  assert_eq_i64(u_i64(u_val(bin.arg(0)).as_int()), 0L)
  assert_eq_i64(u_i64(u_val(bin.arg(1)).as_int()), 165L)
  assert_eq_i64(u_i64(u_val(bin.arg(2)).as_int()), -3L)
  assert_eq_i64(u_i64(u_val(bin.arg(3)).as_int()), 2L)

  // Floats
  let flt = doc.nodes[4]
  assert_true(u_f64(u_val(flt.arg(0)).as_float()).to_bits() == 0.0.to_bits(), "+0.0 bits")
  assert_true(u_f64(u_val(flt.arg(1)).as_float()).to_bits() == (-0.0).to_bits(), "-0.0 bits")
  assert_true(u_f64(u_val(flt.arg(2)).as_float()) == 3.141592653589793, "pi")
  assert_true(u_f64(u_val(flt.arg(3)).as_float()) == -0.0015, "-1.5e-3")
  assert_true(u_f64(u_val(flt.arg(4)).as_float()) == 1025.0, "+1_0.2_5e+2")
  assert_true(u_f64(u_val(flt.arg(5)).as_float()) == 10000000000.0, "1e10")
  assert_true(u_f64(u_val(flt.arg(6)).as_float()) == 0.00002, "2E-5")

  // Special floats
  let sp = doc.nodes[5]
  assert_true(u_f64(u_val(sp.arg(0)).as_float()) == (1.0 / 0.0), "#inf")
  assert_true(u_f64(u_val(sp.arg(1)).as_float()) == (-1.0 / 0.0), "#-inf")
  assert_true(u_val(sp.arg(2)).is_nan(), "#nan")
}

///|
test "v2_valid_keywords_booleans_null" {
  let doc = must_parse("flags #true #false #null ok=#true nil=#null\n")
  let n = doc.nodes[0]
  assert_true(u_bool(u_val(n.arg(0)).as_bool()) == true, "#true")
  assert_true(u_bool(u_val(n.arg(1)).as_bool()) == false, "#false")
  assert_true(u_val(n.arg(2)).is_null(), "#null")
  assert_true(u_bool(u_val(n.prop("ok")).as_bool()) == true, "prop #true")
  assert_true(u_val(n.prop("nil")).is_null(), "prop #null")
}

///|
test "v2_valid_unicode_whitespace_and_newlines" {
  // NBSP, ideographic space, thin space, VT (whitespace per official suite); NEL, FF, LS, PS
  let src = "a\u{00A0}1\u{3000}k\u{2009}=\u{202F}2\u{0085}b\u{2028}c\u{2029}d\u{000B}e\u{000C}f"
  let doc = must_parse(src)
  assert_eq_int(doc.nodes.length(), 5)
  assert_eq_str(doc.nodes[0].name, "a")
  assert_eq_i64(u_i64(u_val(doc.nodes[0].arg(0)).as_int()), 1L)
  assert_eq_i64(u_i64(u_val(doc.nodes[0].prop("k")).as_int()), 2L)
  assert_eq_str(doc.nodes[1].name, "b")
  assert_eq_str(doc.nodes[2].name, "c")
  assert_eq_str(doc.nodes[3].name, "d")
  assert_eq_str(u_str(u_val(doc.nodes[3].arg(0)).as_str()), "e")
  assert_eq_str(doc.nodes[4].name, "f")
}

///|
test "v2_valid_comments_nested_and_inline" {
  let src =
  "// top comment\n" +
  "/* outer /* inner /* deep */ still inner */ still outer */ node/*sep*/1 /*a*/ k/*b*/=/*c*/2 // eol\n" +
  "node2 /* comment */ { /* inside */ child 3 }\n"
  let doc = must_parse(src)
  assert_eq_int(doc.nodes.length(), 2)
  assert_eq_str(doc.nodes[0].name, "node")
  assert_eq_i64(u_i64(u_val(doc.nodes[0].arg(0)).as_int()), 1L)
  assert_eq_i64(u_i64(u_val(doc.nodes[0].prop("k")).as_int()), 2L)
  assert_eq_str(doc.nodes[1].name, "node2")
  assert_eq_int(doc.nodes[1].children().length(), 1)
  assert_eq_str(doc.nodes[1].children()[0].name, "child")
}

///|
test "v2_valid_slashdash_nodes_entries_children" {
  let src =
  "/- commented_node 1 2 { a; b }\n" +
  "/- \n // newline after slashdash\n commented_node2\n" +
  "real_node /- 1 2 /- k=10 k=20 /- \"skip\" \"keep\" /- { ignored } { child1; /- child2; child3 } /- { ignored2 }\n"
  let doc = must_parse(src)
  assert_eq_int(doc.nodes.length(), 1)
  let n = doc.nodes[0]
  assert_eq_str(n.name, "real_node")
  assert_eq_int(n.args().length(), 2)
  assert_eq_i64(u_i64(u_val(n.arg(0)).as_int()), 2L)
  assert_eq_str(u_str(u_val(n.arg(1)).as_str()), "keep")
  assert_eq_i64(u_i64(u_val(n.prop("k")).as_int()), 20L)
  assert_eq_int(n.children().length(), 2)
  assert_eq_str(n.children()[0].name, "child1")
  assert_eq_str(n.children()[1].name, "child3")
}

///|
test "v2_valid_type_annotations" {
  let src =
  "(my-type)node (u8)42 ( date ) \"2026-11-23\" k=(f64) 3.5 (#\"raw-t\"#)#true\n" +
  "(\"quoted type\") n2\n"
  let doc = must_parse(src)
  assert_eq_int(doc.nodes.length(), 2)
  let n = doc.nodes[0]
  assert_eq_str(u_str(n.ty), "my-type")
  assert_eq_str(n.name, "node")
  assert_eq_str(u_str(u_entry(n.arg_entry(0)).ty), "u8")
  assert_eq_i64(u_i64(u_val(n.arg(0)).as_int()), 42L)
  assert_eq_str(u_str(u_entry(n.arg_entry(1)).ty), "date")
  assert_eq_str(u_str(u_val(n.arg(1)).as_str()), "2026-11-23")
  assert_eq_str(u_str(u_entry(n.prop_entry("k")).ty), "f64")
  assert_true(u_f64(u_val(n.prop("k")).as_float()) == 3.5, "prop f64")
  assert_eq_str(u_str(u_entry(n.arg_entry(2)).ty), "raw-t")
  assert_true(u_bool(u_val(n.arg(2)).as_bool()) == true, "arg #true")

  assert_eq_str(u_str(doc.nodes[1].ty), "quoted type")
  assert_eq_str(doc.nodes[1].name, "n2")
}

///|
test "v2_valid_duplicate_properties_last_wins" {
  let doc = must_parse("node a=1 b=2 a=(u16)3 b=\"two\" a=4\n")
  let n = doc.nodes[0]
  assert_eq_i64(u_i64(u_val(n.prop("a")).as_int()), 4L)
  assert_true(is_none_str(u_entry(n.prop_entry("a")).ty), "last prop has no type")
  assert_eq_str(u_str(u_val(n.prop("b")).as_str()), "two")
}

///|
test "v2_valid_semicolons_and_escline" {
  let src =
  "a 1; b 2; c 3\n" +
  "multi \\\n" +
  "  arg1 \\ // comment on escline\n" +
  "  k = 10 \\ /* block */ \n" +
  "  arg2\n" +
  "eof_esc 1 \\"
  let doc = must_parse(src)
  assert_eq_int(doc.nodes.length(), 5)
  assert_eq_str(doc.nodes[0].name, "a")
  assert_eq_str(doc.nodes[1].name, "b")
  assert_eq_str(doc.nodes[2].name, "c")
  let m = doc.nodes[3]
  assert_eq_str(m.name, "multi")
  assert_eq_str(u_str(u_val(m.arg(0)).as_str()), "arg1")
  assert_eq_str(u_str(u_val(m.arg(1)).as_str()), "arg2")
  assert_eq_i64(u_i64(u_val(m.prop("k")).as_int()), 10L)
  assert_eq_str(doc.nodes[4].name, "eof_esc")
  assert_eq_i64(u_i64(u_val(doc.nodes[4].arg(0)).as_int()), 1L)
}

///|
test "v2_valid_nested_children_and_inline_blocks" {
  let doc = must_parse("a{b{c 1; d 2}}; e {}\n")
  assert_eq_int(doc.nodes.length(), 2)
  assert_eq_str(doc.nodes[0].name, "a")
  let b = u_node(doc.nodes[0].child("b"))
  assert_eq_int(b.children().length(), 2)
  assert_eq_i64(u_i64(u_val(b.children()[0].arg(0)).as_int()), 1L)
  assert_eq_i64(u_i64(u_val(b.children()[1].arg(0)).as_int()), 2L)
  assert_eq_str(doc.nodes[1].name, "e")
  assert_eq_int(doc.nodes[1].children().length(), 0)
}
