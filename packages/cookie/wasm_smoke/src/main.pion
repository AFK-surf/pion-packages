///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/cookie`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "cookie"

fn fnv1a_64_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

pub fn main(world : World) -> Int {
  // 1. RFC 6265 §5.1.1 date roundtrip
  let ts = match cookie::parse_cookie_date("Sun, 06 Nov 1994 08:49:37 GMT") {
    Ok(v) => v
    Err(_) => return 1
  }
  let fmt_date = cookie::format_cookie_date(ts)

  // 2. Mozilla PSL (ICANN, Private, wildcard, exception, IDN Unicode + Punycode)
  let r1 = match cookie::registrable_domain("www.city.kobe.jp") {
    Some(s) => s
    None => return 2
  }
  let r2 = match cookie::registrable_domain("www.ck") {
    Some(s) => s
    None => return 3
  }
  let r3 = match cookie::registrable_domain("www.食狮.公司.cn") {
    Some(s) => s
    None => return 4
  }
  let r4 = match cookie::registrable_domain("a.b.github.io") {
    Some(s) => s
    None => return 5
  }
  if cookie::is_public_suffix("example.co.uk") || !cookie::is_public_suffix("co.uk") {
    return 6
  }

  // 3. Set-Cookie parse + format + CookieJar + CHIPS + SameSite + prefix
  let jar = cookie::CookieJar::new()
  let t0 = 1700000000L
  let ctx_a = cookie::RequestContext::new(
    "https://embed.example.co.uk/app/view",
    Some("https://top-a.example"),
    true,
    false,
    t0,
  )
  let ctx_b = cookie::RequestContext::new(
    "https://embed.example.co.uk/app/view",
    Some("https://top-b.example"),
    true,
    false,
    t0 + 1L,
  )
  match jar.store_set_cookie("__Host-part=valA; Secure; Path=/; SameSite=None; Partitioned", ctx_a) {
    Ok(true) => ()
    _ => return 7
  }
  match jar.store_set_cookie("__Host-part=valB; Secure; Path=/; SameSite=None; Partitioned", ctx_b) {
    Ok(true) => ()
    _ => return 8
  }
  match jar.store_set_cookie("shared=ok; Domain=example.co.uk; Path=/app; Secure; SameSite=None", ctx_a) {
    Ok(true) => ()
    _ => return 9
  }
  let hdr_a = match jar.cookie_header(ctx_a) {
    Ok(Some(h)) => h
    _ => return 10
  }
  let hdr_b = match jar.cookie_header(ctx_b) {
    Ok(Some(h)) => h
    _ => return 11
  }
  let exported = jar.export_text()
  let jar2 = cookie::CookieJar::new()
  let imported = match jar2.import_text(exported) {
    Ok(n) => n
    Err(_) => return 12
  }

  let summary = fmt_date + "|" + r1 + "|" + r2 + "|" + r3 + "|" + r4 + "|" + hdr_a + "|" + hdr_b + "|" + imported.to_string()
  io_println(world, "cookie_wasm_smoke:ok")
  io_println(world, "summary=" + summary + " fnv64=" + hex_u64(fnv1a_64_str(summary)))
  0
}
