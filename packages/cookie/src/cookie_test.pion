///| Comprehensive RFC 6265bis, CHIPS, WPT cookies, and Mozilla PSL test suite.

fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn opt_i64_eq(a : Option[Int64], b : Option[Int64]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn opt_ss_eq(a : Option[SameSite], b : Option[SameSite]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => same_site_eq(x, y)
    _ => false
  }
}

fn check_psl(input : String, expected : Option[String]) -> Unit {
  let got = registrable_domain(input)
  let got_s = match got {
    Some(s) => s
    None => "<none>"
  }
  let exp_s = match expected {
    Some(s) => s
    None => "<none>"
  }
  debug_assert(
    opt_str_eq(got, expected),
    "PSL mismatch for '" + input + "': got=" + got_s + " expected=" + exp_s,
  )
}

// ---------------------------------------------------------------------------
// 1. Official Mozilla Public Suffix List test_psl.txt vectors
// ---------------------------------------------------------------------------

test "mozilla_psl_official_vectors" {
  // Empty / null equivalent
  check_psl("", None)
  // Mixed case
  check_psl("COM", None)
  check_psl("example.COM", Some("example.com"))
  check_psl("WwW.example.COM", Some("example.com"))
  // Leading dot
  check_psl(".com", None)
  check_psl(".example", None)
  check_psl(".example.com", None)
  check_psl(".example.example", None)
  // Unlisted TLD
  check_psl("example", None)
  check_psl("example.example", Some("example.example"))
  check_psl("b.example.example", Some("example.example"))
  check_psl("a.b.example.example", Some("example.example"))
  // TLD with only 1 rule
  check_psl("biz", None)
  check_psl("domain.biz", Some("domain.biz"))
  check_psl("b.domain.biz", Some("domain.biz"))
  check_psl("a.b.domain.biz", Some("domain.biz"))
  // TLD with some 2-level rules
  check_psl("com", None)
  check_psl("example.com", Some("example.com"))
  check_psl("b.example.com", Some("example.com"))
  check_psl("a.b.example.com", Some("example.com"))
  check_psl("uk.com", None)
  check_psl("example.uk.com", Some("example.uk.com"))
  check_psl("b.example.uk.com", Some("example.uk.com"))
  check_psl("a.b.example.uk.com", Some("example.uk.com"))
  check_psl("test.ac", Some("test.ac"))
  // TLD with only 1 (wildcard) rule
  check_psl("mm", None)
  check_psl("c.mm", None)
  check_psl("b.c.mm", Some("b.c.mm"))
  check_psl("a.b.c.mm", Some("b.c.mm"))
  // More complex TLD (jp)
  check_psl("jp", None)
  check_psl("test.jp", Some("test.jp"))
  check_psl("www.test.jp", Some("test.jp"))
  check_psl("ac.jp", None)
  check_psl("test.ac.jp", Some("test.ac.jp"))
  check_psl("www.test.ac.jp", Some("test.ac.jp"))
  check_psl("kyoto.jp", None)
  check_psl("test.kyoto.jp", Some("test.kyoto.jp"))
  check_psl("ide.kyoto.jp", None)
  check_psl("b.ide.kyoto.jp", Some("b.ide.kyoto.jp"))
  check_psl("a.b.ide.kyoto.jp", Some("b.ide.kyoto.jp"))
  check_psl("c.kobe.jp", None)
  check_psl("b.c.kobe.jp", Some("b.c.kobe.jp"))
  check_psl("a.b.c.kobe.jp", Some("b.c.kobe.jp"))
  check_psl("city.kobe.jp", Some("city.kobe.jp"))
  check_psl("www.city.kobe.jp", Some("city.kobe.jp"))
  // TLD with a wildcard rule and exceptions (ck)
  check_psl("ck", None)
  check_psl("test.ck", None)
  check_psl("b.test.ck", Some("b.test.ck"))
  check_psl("a.b.test.ck", Some("b.test.ck"))
  check_psl("www.ck", Some("www.ck"))
  check_psl("www.www.ck", Some("www.ck"))
  // US K12
  check_psl("us", None)
  check_psl("test.us", Some("test.us"))
  check_psl("www.test.us", Some("test.us"))
  check_psl("ak.us", None)
  check_psl("test.ak.us", Some("test.ak.us"))
  check_psl("www.test.ak.us", Some("test.ak.us"))
  check_psl("k12.ak.us", None)
  check_psl("test.k12.ak.us", Some("test.k12.ak.us"))
  check_psl("www.test.k12.ak.us", Some("test.k12.ak.us"))
  // IDN labels (Unicode)
  check_psl("食狮.com.cn", Some("食狮.com.cn"))
  check_psl("食狮.公司.cn", Some("食狮.公司.cn"))
  check_psl("www.食狮.公司.cn", Some("食狮.公司.cn"))
  check_psl("shishi.公司.cn", Some("shishi.公司.cn"))
  check_psl("公司.cn", None)
  check_psl("食狮.中国", Some("食狮.中国"))
  check_psl("www.食狮.中国", Some("食狮.中国"))
  check_psl("shishi.中国", Some("shishi.中国"))
  check_psl("中国", None)
  // IDN labels (Punycode)
  check_psl("xn--85x722f.com.cn", Some("xn--85x722f.com.cn"))
  check_psl("xn--85x722f.xn--55qx5d.cn", Some("xn--85x722f.xn--55qx5d.cn"))
  check_psl("www.xn--85x722f.xn--55qx5d.cn", Some("xn--85x722f.xn--55qx5d.cn"))
  check_psl("shishi.xn--55qx5d.cn", Some("shishi.xn--55qx5d.cn"))
  check_psl("xn--55qx5d.cn", None)
  check_psl("xn--85x722f.xn--fiqs8s", Some("xn--85x722f.xn--fiqs8s"))
  check_psl("www.xn--85x722f.xn--fiqs8s", Some("xn--85x722f.xn--fiqs8s"))
  check_psl("shishi.xn--fiqs8s", Some("shishi.xn--fiqs8s"))
  check_psl("xn--fiqs8s", None)
}

test "psl_icann_vs_private_and_ip" {
  // ICANN vs Private: github.io is a private suffix
  debug_assert(is_public_suffix("github.io"), "github.io is public suffix (with private)")
  debug_assert(!is_public_suffix_icann("github.io"), "github.io is not ICANN suffix")
  debug_assert(opt_str_eq(public_suffix("foo.github.io"), Some("github.io")), "public_suffix private")
  debug_assert(opt_str_eq(public_suffix_icann("foo.github.io"), Some("io")), "public_suffix icann")
  debug_assert(
    opt_str_eq(registrable_domain("a.b.github.io"), Some("b.github.io")),
    "registrable_domain private",
  )
  debug_assert(
    opt_str_eq(registrable_domain_icann("a.b.github.io"), Some("github.io")),
    "registrable_domain icann",
  )

  // ICANN co.uk
  debug_assert(is_public_suffix("co.uk"), "co.uk is public suffix")
  debug_assert(is_public_suffix_icann("co.uk"), "co.uk is ICANN suffix")
  debug_assert(!is_public_suffix("example.co.uk"), "example.co.uk is registrable")

  // IP literals are never public suffixes and have no registrable domain
  debug_assert(is_ip_address("127.0.0.1"), "ipv4 127.0.0.1")
  debug_assert(is_ip_address("192.168.0.255"), "ipv4 192.168.0.255")
  debug_assert(!is_ip_address("256.0.0.1"), "invalid ipv4")
  debug_assert(is_ip_address("[::1]"), "bracketed ipv6")
  debug_assert(is_ip_address("::1"), "bare ipv6")
  debug_assert(!is_ip_address("example.com"), "hostname not ip")
  debug_assert(opt_str_eq(registrable_domain("127.0.0.1"), None), "ipv4 no registrable domain")
  debug_assert(opt_str_eq(registrable_domain("[::1]"), None), "ipv6 no registrable domain")
}

// ---------------------------------------------------------------------------
// 2. RFC 6265 §5.1.1 Cookie-Date parsing & IMF-fixdate formatting
// ---------------------------------------------------------------------------

test "rfc6265_cookie_date_parsing_and_formatting" {
  // Canonical RFC 6265 / RFC 9110 example
  match parse_cookie_date("Sun, 06 Nov 1994 08:49:37 GMT") {
    Ok(ts) => {
      debug_assert(ts == 784111777L, "1994-11-06 timestamp")
      debug_assert(
        format_cookie_date(ts) == "Sun, 06 Nov 1994 08:49:37 GMT",
        "format_cookie_date roundtrip",
      )
    }
    Err(e) => debug_assert(false, "failed valid date: " + cookie_error_message(e))
  }
  // RFC 850 two-digit year: 94 -> 1994, 00..69 -> 2000..2069
  match parse_cookie_date("Sunday, 06-Nov-94 08:49:37 GMT") {
    Ok(ts) => debug_assert(ts == 784111777L, "2-digit 94 -> 1994")
    Err(_) => debug_assert(false, "failed rfc850 date")
  }
  match parse_cookie_date("Wed, 01-Jan-25 00:00:00 GMT") {
    Ok(ts) => debug_assert(format_cookie_date(ts) == "Wed, 01 Jan 2025 00:00:00 GMT", "2-digit 25 -> 2025")
    Err(_) => debug_assert(false, "failed 2-digit 2025")
  }
  match parse_cookie_date("01 Jan 69 00:00:00") {
    Ok(ts) => debug_assert(format_cookie_date(ts) == "Tue, 01 Jan 2069 00:00:00 GMT", "2-digit 69 -> 2069")
    Err(_) => debug_assert(false, "failed 2-digit 2069")
  }
  match parse_cookie_date("01 Jan 70 00:00:00") {
    Ok(ts) => debug_assert(ts == 0L, "2-digit 70 -> 1970 epoch 0")
    Err(_) => debug_assert(false, "failed 2-digit 1970")
  }
  // ANSI C asctime format
  match parse_cookie_date("Sun Nov  6 08:49:37 1994") {
    Ok(ts) => debug_assert(ts == 784111777L, "asctime date")
    Err(_) => debug_assert(false, "failed asctime date")
  }
  // RFC 6265 §5.1.1 arbitrary order & delimiters & single-digit time/day
  match parse_cookie_date("9:5:3;29;feb;2024") {
    Ok(ts) => debug_assert(format_cookie_date(ts) == "Thu, 29 Feb 2024 09:05:03 GMT", "flexible delimiters + leap 2024")
    Err(_) => debug_assert(false, "failed flexible RFC 6265 date")
  }
  // Century leap year 2000 & year 1601 boundary
  match parse_cookie_date("29 Feb 2000 12:00:00 GMT") {
    Ok(ts) => debug_assert(ts == 951825600L, "leap year 2000")
    Err(_) => debug_assert(false, "failed leap 2000")
  }
  match parse_cookie_date("01 Jan 1601 00:00:00 GMT") {
    Ok(ts) => debug_assert(ts == -11644473600L, "year 1601 boundary")
    Err(_) => debug_assert(false, "failed 1601 boundary")
  }
  // Year 9999 upper bound (no 32-bit overflow)
  match parse_cookie_date("Fri, 31 Dec 9999 23:59:59 GMT") {
    Ok(ts) => debug_assert(ts == 253402300799L, "year 9999 boundary")
    Err(_) => debug_assert(false, "failed year 9999")
  }
}

test "rfc6265_cookie_date_rejects_invalid" {
  // Year < 1601
  match parse_cookie_date("31 Dec 1600 23:59:59 GMT") {
    Err(CookieError::InvalidDate(_)) => ()
    _ => debug_assert(false, "should reject year 1600")
  }
  // Non-leap Feb 29
  match parse_cookie_date("29 Feb 2023 00:00:00 GMT") {
    Err(CookieError::InvalidDate(_)) => ()
    _ => debug_assert(false, "should reject non-leap 2023-02-29")
  }
  match parse_cookie_date("29 Feb 1900 00:00:00 GMT") {
    Err(CookieError::InvalidDate(_)) => ()
    _ => debug_assert(false, "should reject non-leap 1900-02-29")
  }
  // April 31, day 0, hour 24, minute 60, second 60
  match parse_cookie_date("31 Apr 2024 00:00:00 GMT") {
    Err(CookieError::InvalidDate(_)) => ()
    _ => debug_assert(false, "should reject Apr 31")
  }
  match parse_cookie_date("00 Jan 2024 00:00:00 GMT") {
    Err(CookieError::InvalidDate(_)) => ()
    _ => debug_assert(false, "should reject day 0")
  }
  match parse_cookie_date("01 Jan 2024 24:00:00 GMT") {
    Err(CookieError::InvalidDate(_)) => ()
    _ => debug_assert(false, "should reject hour 24")
  }
  match parse_cookie_date("01 Jan 2024 00:60:00 GMT") {
    Err(CookieError::InvalidDate(_)) => ()
    _ => debug_assert(false, "should reject minute 60")
  }
  match parse_cookie_date("01 Jan 2024 00:00:60 GMT") {
    Err(CookieError::InvalidDate(_)) => ()
    _ => debug_assert(false, "should reject second 60")
  }
  // Missing components / empty
  match parse_cookie_date("") {
    Err(CookieError::InvalidDate(_)) => ()
    _ => debug_assert(false, "should reject empty")
  }
  match parse_cookie_date("06 Nov 1994 GMT") {
    Err(CookieError::InvalidDate(_)) => ()
    _ => debug_assert(false, "should reject missing time")
  }
}

// ---------------------------------------------------------------------------
// 3. RFC 6265bis §5.6 Set-Cookie parsing, attributes, prefixes, & limits
// ---------------------------------------------------------------------------

test "rfc6265bis_set_cookie_attributes_and_edge_cases" {
  let hdr = "session_id=abc123; Expires=Sun, 06 Nov 1994 08:49:37 GMT; Max-Age=3600; Domain=.Example.COM; Path=/app; Secure; HttpOnly; SameSite=Strict; Partitioned"
  match parse_set_cookie(hdr) {
    Ok(c) => {
      debug_assert(c.name == "session_id", "name")
      debug_assert(c.value == "abc123", "value")
      debug_assert(opt_i64_eq(c.expires, Some(784111777L)), "expires")
      debug_assert(opt_i64_eq(c.max_age, Some(3600L)), "max_age")
      debug_assert(opt_str_eq(c.domain, Some("example.com")), "domain lowercased & dot stripped")
      debug_assert(opt_str_eq(c.path, Some("/app")), "path")
      debug_assert(c.secure, "secure")
      debug_assert(c.http_only, "http_only")
      debug_assert(opt_ss_eq(c.same_site, Some(SameSite::Strict)), "same_site")
      debug_assert(c.partitioned, "partitioned")
    }
    Err(e) => debug_assert(false, "parse_set_cookie failed: " + cookie_error_message(e))
  }

  // Duplicate attributes: last wins
  match parse_set_cookie("a=1; Path=/first; Path=/second; Domain=a.example.com; Domain=.b.example.com; SameSite=Strict; SameSite=None") {
    Ok(c) => {
      debug_assert(opt_str_eq(c.path, Some("/second")), "last Path wins")
      debug_assert(opt_str_eq(c.domain, Some("b.example.com")), "last Domain wins")
      debug_assert(opt_ss_eq(c.same_site, Some(SameSite::None)), "last SameSite wins")
    }
    Err(e) => debug_assert(false, "duplicate attrs failed: " + cookie_error_message(e))
  }

  // Nameless cookie (RFC 6265bis §5.6: no '=' -> name="", value=pair)
  match parse_set_cookie("justvalue; Path=/") {
    Ok(c) => {
      debug_assert(c.name == "", "nameless cookie has empty name")
      debug_assert(c.value == "justvalue", "nameless cookie value")
    }
    Err(e) => debug_assert(false, "nameless cookie failed: " + cookie_error_message(e))
  }

  // Empty name AND empty value rejected
  match parse_set_cookie("=; Path=/") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "empty name and value must be rejected")
  }
  match parse_set_cookie("   ; Path=/") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "whitespace-only pair must be rejected")
  }

  // Quoted-string value preserved
  match parse_set_cookie("tok=\"hello world\"; Path=/") {
    Ok(c) => debug_assert(c.value == "\"hello world\"", "quoted value preserved")
    Err(_) => debug_assert(false, "quoted value failed")
  }

  // Max-Age overflow clamping & negative/invalid handling
  match parse_set_cookie("big=1; Max-Age=99999999999999999999999999") {
    Ok(c) => match c.max_age {
      Some(v) => debug_assert(v > 0L, "huge positive Max-Age clamped positively")
      None => debug_assert(false, "expected clamped positive Max-Age")
    }
    Err(_) => debug_assert(false, "huge Max-Age should clamp, not crash")
  }
  match parse_set_cookie("neg=1; Max-Age=-99999999999999999999999999") {
    Ok(c) => match c.max_age {
      Some(v) => debug_assert(v <= 0L, "huge negative Max-Age clamped non-positively")
      None => debug_assert(false, "expected clamped negative Max-Age")
    }
    Err(_) => debug_assert(false, "huge negative Max-Age failed")
  }
  // Invalid Max-Age (non-digit) is ignored per RFC 6265bis §5.6.2
  match parse_set_cookie("badma=1; Max-Age=12abc") {
    Ok(c) => debug_assert(opt_i64_eq(c.max_age, None), "invalid Max-Age ignored")
    Err(_) => debug_assert(false, "invalid Max-Age should be ignored")
  }
  // Path not starting with '/' is ignored per RFC 6265bis §5.6.4
  match parse_set_cookie("badp=1; Path=relative/path") {
    Ok(c) => debug_assert(opt_str_eq(c.path, None), "non-leading-slash Path ignored")
    Err(_) => debug_assert(false, "relative Path should be ignored")
  }
  // Invalid SameSite value is ignored
  match parse_set_cookie("badss=1; SameSite=Bogus") {
    Ok(c) => debug_assert(opt_ss_eq(c.same_site, None), "invalid SameSite ignored")
    Err(_) => debug_assert(false, "invalid SameSite should be ignored")
  }
}

test "rfc6265bis_size_limits_and_ctl_rejection" {
  // Control chars 0x00..=0x08, 0x0A..=0x1F, 0x7F rejected
  match parse_set_cookie("a=b\u{0000}c") {
    Err(CookieError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "NUL byte must be rejected")
  }
  match parse_set_cookie("a=b\nc") {
    Err(CookieError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "LF must be rejected")
  }
  match parse_set_cookie("a=b\rc") {
    Err(CookieError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "CR must be rejected")
  }
  match parse_set_cookie("a=b\u{007f}c") {
    Err(CookieError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "DEL 0x7F must be rejected")
  }
  // HTAB (0x09) is allowed in whitespace around tokens
  match parse_set_cookie("\ta=b\t;\tPath=/\t") {
    Ok(c) => {
      debug_assert(c.name == "a" && c.value == "b", "HTAB trimmed")
      debug_assert(opt_str_eq(c.path, Some("/")), "HTAB around Path")
    }
    Err(e) => debug_assert(false, "HTAB should be allowed: " + cookie_error_message(e))
  }
  // 4096-byte name+value limit
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 4096 {
    sb.write_string("x")
    i = i + 1
  }
  let v4096 = sb.to_string()
  match parse_set_cookie("a=" + v4096) {
    Err(CookieError::SizeExceeded(_)) => ()
    _ => debug_assert(false, "4097 bytes name+value must exceed 4096 limit")
  }
  let sb2 = StringBuilder::new()
  let mut j = 0
  while j < 4095 {
    sb2.write_string("x")
    j = j + 1
  }
  match parse_set_cookie("a=" + sb2.to_string()) {
    Ok(c) => debug_assert(c.name.length() + c.value.length() == 4096, "exact 4096 bytes allowed")
    Err(e) => debug_assert(false, "exact 4096 bytes failed: " + cookie_error_message(e))
  }
}

test "rfc6265bis_cookie_prefixes" {
  // __Secure- requires Secure + secure origin
  let sec_ok = Cookie::new("__Secure-sid", "1").with_secure(true)
  match validate_cookie_prefixes(sec_ok, true) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "__Secure- valid on https")
  }
  match validate_cookie_prefixes(sec_ok, false) {
    Err(CookieError::PrefixViolation(_)) => ()
    _ => debug_assert(false, "__Secure- must fail on http")
  }
  let sec_no_flag = Cookie::new("__secure-sid", "1")
  match validate_cookie_prefixes(sec_no_flag, true) {
    Err(CookieError::PrefixViolation(_)) => ()
    _ => debug_assert(false, "case-insensitive __secure- without Secure must fail")
  }

  // __Host- requires Secure + secure origin + no Domain + Path=/
  let host_ok = Cookie::new("__Host-id", "1").with_secure(true).with_path("/")
  match validate_cookie_prefixes(host_ok, true) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "__Host- valid")
  }
  let host_with_domain = host_ok.with_domain("example.com")
  match validate_cookie_prefixes(host_with_domain, true) {
    Err(CookieError::PrefixViolation(_)) => ()
    _ => debug_assert(false, "__Host- with Domain must fail")
  }
  let host_bad_path = Cookie::new("__Host-id", "1").with_secure(true).with_path("/sub")
  match validate_cookie_prefixes(host_bad_path, true) {
    Err(CookieError::PrefixViolation(_)) => ()
    _ => debug_assert(false, "__Host- with Path=/sub must fail")
  }
  let host_no_path = Cookie::new("__Host-id", "1").with_secure(true)
  match validate_cookie_prefixes(host_no_path, true) {
    Err(CookieError::PrefixViolation(_)) => ()
    _ => debug_assert(false, "__Host- without Path=/ must fail")
  }

  // __Http- and __Host-Http-
  let http_ok = Cookie::new("__Http-tok", "1").with_secure(true).with_http_only(true)
  match validate_cookie_prefixes(http_ok, true) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "__Http- valid")
  }
  let http_no_ho = Cookie::new("__Http-tok", "1").with_secure(true)
  match validate_cookie_prefixes(http_no_ho, true) {
    Err(CookieError::PrefixViolation(_)) => ()
    _ => debug_assert(false, "__Http- without HttpOnly must fail")
  }
  let host_http_ok = Cookie::new("__Host-Http-tok", "1").with_secure(true).with_http_only(true).with_path("/")
  match validate_cookie_prefixes(host_http_ok, true) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "__Host-Http- valid")
  }
  match validate_cookie_prefixes(host_http_ok.with_domain("example.com"), true) {
    Err(CookieError::PrefixViolation(_)) => ()
    _ => debug_assert(false, "__Host-Http- with Domain must fail")
  }
}

// ---------------------------------------------------------------------------
// 4. Domain matching, Path matching, default_path, and formatting
// ---------------------------------------------------------------------------

test "rfc6265_domain_and_path_matching" {
  debug_assert(default_path("") == "/", "empty -> /")
  debug_assert(default_path("abc") == "/", "no leading slash -> /")
  debug_assert(default_path("/") == "/", "/ -> /")
  debug_assert(default_path("/foo") == "/", "/foo -> /")
  debug_assert(default_path("/foo/bar") == "/foo", "/foo/bar -> /foo")
  debug_assert(default_path("/foo/bar/") == "/foo/bar", "/foo/bar/ -> /foo/bar")

  debug_assert(domain_matches("example.com", "example.com"), "exact match")
  debug_assert(domain_matches("sub.example.com", "example.com"), "subdomain match")
  debug_assert(domain_matches("a.b.example.com", "example.com"), "deep subdomain match")
  debug_assert(!domain_matches("badexample.com", "example.com"), "suffix without dot must not match")
  debug_assert(!domain_matches("example.com", "sub.example.com"), "parent does not match child")
  debug_assert(!domain_matches("127.0.0.1", "0.0.1"), "IP literal must not suffix-match")
  debug_assert(domain_matches("127.0.0.1", "127.0.0.1"), "IP literal exact match")

  debug_assert(path_matches("/", "/"), "/ matches /")
  debug_assert(path_matches("/a/b", "/"), "/a/b matches /")
  debug_assert(path_matches("/a/b", "/a"), "/a/b matches /a")
  debug_assert(path_matches("/a/b", "/a/"), "/a/b matches /a/")
  debug_assert(!path_matches("/ab", "/a"), "/ab does not match /a")
  debug_assert(!path_matches("/", "/a"), "/ does not match /a")
}

test "format_set_cookie_and_cookie_header" {
  let c = Cookie::new("sid", "xyz")
  .with_max_age(3600L)
  .with_domain("example.com")
  .with_path("/")
  .with_secure(true)
  .with_http_only(true)
  .with_same_site(SameSite::Lax)
  .with_partitioned(true)
  match format_set_cookie(c) {
    Ok(s) => debug_assert(
      s == "sid=xyz; Max-Age=3600; Domain=example.com; Path=/; Secure; HttpOnly; SameSite=Lax; Partitioned",
      "formatted Set-Cookie mismatch: " + s,
    )
    Err(e) => debug_assert(false, "format_set_cookie failed: " + cookie_error_message(e))
  }
  // Injection guard
  match format_set_cookie(Cookie::new("a;b", "1")) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "semicolon in name must fail")
  }
  match format_set_cookie(Cookie::new("a", "1\r\nSet-Cookie: evil=1")) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "CRLF in value must fail")
  }

  // Cookie request header parsing & formatting
  match parse_cookie_header("a=1; b=two; empty=; spaces = val ") {
    Ok(pairs) => {
      debug_assert(pairs.length() == 4, "4 pairs")
      debug_assert(pairs[0].name == "a" && pairs[0].value == "1", "pair 0")
      debug_assert(pairs[1].name == "b" && pairs[1].value == "two", "pair 1")
      debug_assert(pairs[2].name == "empty" && pairs[2].value == "", "pair 2")
      debug_assert(pairs[3].name == "spaces" && pairs[3].value == "val", "pair 3")
      match format_cookie_header(pairs) {
        Ok(h) => debug_assert(h == "a=1; b=two; empty=; spaces=val", "format_cookie_header: " + h)
        Err(_) => debug_assert(false, "format_cookie_header failed")
      }
    }
    Err(e) => debug_assert(false, "parse_cookie_header failed: " + cookie_error_message(e))
  }
}

// ---------------------------------------------------------------------------
// 5. RFC 6265bis CookieJar + CHIPS + SameSite + PSL + Eviction + Serialization
// ---------------------------------------------------------------------------

test "jar_psl_domain_isolation_and_ordering" {
  let jar = CookieJar::new()
  let t0 = 1700000000L
  let ctx = RequestContext::http("https://app.example.co.uk/a/b/page", t0)

  // Reject public suffixes (ICANN and Private)
  match jar.store_set_cookie("evil=1; Domain=co.uk", ctx) {
    Err(CookieError::PublicSuffixRejected(_)) => ()
    _ => debug_assert(false, "co.uk public suffix must be rejected")
  }
  match jar.store_set_cookie("evil=1; Domain=uk", ctx) {
    Err(CookieError::PublicSuffixRejected(_)) => ()
    _ => debug_assert(false, "uk TLD must be rejected")
  }
  let gh_ctx = RequestContext::http("https://user.github.io/", t0)
  match jar.store_set_cookie("evil=1; Domain=github.io", gh_ctx) {
    Err(CookieError::PublicSuffixRejected(_)) => ()
    _ => debug_assert(false, "private suffix github.io must be rejected")
  }

  // Domain mismatch rejected
  match jar.store_set_cookie("x=1; Domain=other.co.uk", ctx) {
    Err(CookieError::DomainMismatch(_)) => ()
    _ => debug_assert(false, "unrelated domain must be rejected")
  }

  // Valid domain + path ordering (longest path first, then earliest creation_time)
  let _ = jar.store_set_cookie("root=1; Path=/", RequestContext::http("https://app.example.co.uk/a/b/page", t0))
  let _ = jar.store_set_cookie("deep=2; Path=/a/b", RequestContext::http("https://app.example.co.uk/a/b/page", t0 + 1L))
  let _ = jar.store_set_cookie("mid=3; Path=/a", RequestContext::http("https://app.example.co.uk/a/b/page", t0 + 2L))
  let _ = jar.store_set_cookie("root2=4; Path=/", RequestContext::http("https://app.example.co.uk/a/b/page", t0 + 3L))

  match jar.cookie_header(RequestContext::http("https://app.example.co.uk/a/b/page", t0 + 10L)) {
    Ok(Some(h)) => debug_assert(
      h == "deep=2; mid=3; root=1; root2=4",
      "RFC 6265bis §5.8.3 ordering mismatch: " + h,
    )
    _ => debug_assert(false, "expected Cookie header")
  }

  // Update preserves creation_time so root stays before root2
  let _ = jar.store_set_cookie("root=1_updated; Path=/", RequestContext::http("https://app.example.co.uk/a/b/page", t0 + 20L))
  match jar.cookie_header(RequestContext::http("https://app.example.co.uk/a/b/page", t0 + 25L)) {
    Ok(Some(h)) => debug_assert(
      h == "deep=2; mid=3; root=1_updated; root2=4",
      "creation_time preservation mismatch: " + h,
    )
    _ => debug_assert(false, "expected updated Cookie header")
  }
}

test "jar_chips_partitioned_isolation" {
  let jar = CookieJar::new()
  let t0 = 1700000000L

  // Partitioned without Secure MUST be rejected
  let ctx_a = RequestContext::new(
    "https://embed.cdn.example/widget",
    Some("https://site-a.example"),
    true,
    false,
    t0,
  )
  match jar.store_set_cookie("p=1; Partitioned; SameSite=None", ctx_a) {
    Err(CookieError::PartitionedRequiresSecure(_)) => ()
    _ => debug_assert(false, "Partitioned without Secure must fail")
  }

  // Store same cookie name in two different top-level partitions + unpartitioned
  let r1 = jar.store_set_cookie("tok=from_a; Secure; SameSite=None; Partitioned; Path=/", ctx_a)
  let ctx_b = RequestContext::new(
    "https://embed.cdn.example/widget",
    Some("https://site-b.example"),
    true,
    false,
    t0 + 1L,
  )
  let r2 = jar.store_set_cookie("tok=from_b; Secure; SameSite=None; Partitioned; Path=/", ctx_b)
  let ctx_unpart = RequestContext::new(
    "https://embed.cdn.example/widget",
    None,
    true,
    false,
    t0 + 2L,
  )
  let r3 = jar.store_set_cookie("tok=unpart; Secure; SameSite=None; Path=/", ctx_unpart)
  match (r1, r2, r3) {
    (Ok(true), Ok(true), Ok(true)) => ()
    _ => debug_assert(false, "failed to store CHIPS cookies")
  }
  debug_assert(jar.len() == 3, "3 isolated cookies stored")

  // Reading from site-a sees tok=from_a + tok=unpart (not from_b)
  match jar.cookie_header(ctx_a) {
    Ok(Some(h)) => debug_assert(h == "tok=from_a; tok=unpart", "site-a CHIPS view: " + h)
    _ => debug_assert(false, "site-a read failed")
  }
  // Reading from site-b sees tok=from_b + tok=unpart (not from_a)
  match jar.cookie_header(ctx_b) {
    Ok(Some(h)) => debug_assert(h == "tok=from_b; tok=unpart", "site-b CHIPS view: " + h)
    _ => debug_assert(false, "site-b read failed")
  }
  // Reading from site-c sees only unpartitioned
  let ctx_c = RequestContext::new(
    "https://embed.cdn.example/widget",
    Some("https://site-c.example"),
    true,
    false,
    t0 + 3L,
  )
  match jar.cookie_header(ctx_c) {
    Ok(Some(h)) => debug_assert(h == "tok=unpart", "site-c CHIPS view: " + h)
    _ => debug_assert(false, "site-c read failed")
  }
}

test "jar_security_samesite_httponly_secure_and_expiry" {
  let jar = CookieJar::new()
  let t0 = 1700000000L
  let https_same = RequestContext::http("https://example.com/", t0)
  let http_same = RequestContext::http("http://example.com/", t0)
  let js_https = RequestContext::new("https://example.com/", None, false, true, t0)

  // Non-secure origin cannot set Secure cookie
  match jar.store_set_cookie("s=1; Secure", http_same) {
    Err(CookieError::SecureOriginRequired(_)) => ()
    _ => debug_assert(false, "http origin must not set Secure cookie")
  }

  // Non-HTTP API cannot set HttpOnly cookie
  match jar.store_set_cookie("h=1; HttpOnly", js_https) {
    Err(CookieError::HttpOnlyViolation(_)) => ()
    _ => debug_assert(false, "non-HTTP API must not set HttpOnly cookie")
  }

  // Store Strict, Lax, None+Secure, HttpOnly
  let _ = jar.store_set_cookie("st=1; SameSite=Strict; Secure", https_same)
  let _ = jar.store_set_cookie("lx=2; SameSite=Lax", https_same)
  let _ = jar.store_set_cookie("nn=3; SameSite=None; Secure", https_same)
  let _ = jar.store_set_cookie("ho=4; HttpOnly; SameSite=None; Secure", https_same)

  // Non-HTTP API cannot read or overwrite HttpOnly cookie
  match jar.store_set_cookie("ho=evil", js_https) {
    Err(CookieError::HttpOnlyViolation(_)) => ()
    _ => debug_assert(false, "non-HTTP API must not overwrite HttpOnly cookie")
  }
  match jar.cookie_header(js_https) {
    Ok(Some(h)) => debug_assert(h == "st=1; lx=2; nn=3", "JS excludes HttpOnly: " + h)
    _ => debug_assert(false, "JS read failed")
  }

  // Cross-site subresource request only gets SameSite=None
  let cross_sub = RequestContext::new("https://example.com/", None, true, false, t0 + 1L)
  .with_navigation(false, true)
  match jar.cookie_header(cross_sub) {
    Ok(Some(h)) => debug_assert(h == "nn=3; ho=4", "cross-site subresource: " + h)
    _ => debug_assert(false, "cross-site subresource failed")
  }

  // Cross-site top-level safe GET navigation gets Lax + None
  let cross_nav_get = RequestContext::new("https://example.com/", None, true, false, t0 + 1L)
  .with_navigation(true, true)
  match jar.cookie_header(cross_nav_get) {
    Ok(Some(h)) => debug_assert(h == "lx=2; nn=3; ho=4", "cross-site top-level GET: " + h)
    _ => debug_assert(false, "cross-site top-level GET failed")
  }

  // HTTP request does not receive Secure cookies
  match jar.cookie_header(http_same) {
    Ok(Some(h)) => debug_assert(h == "lx=2", "http excludes Secure cookies: " + h)
    _ => debug_assert(false, "http read failed")
  }

  // Max-Age=0 immediately deletes existing cookie
  let _ = jar.store_set_cookie("lx=gone; Max-Age=0", https_same)
  match jar.cookie_header(http_same) {
    Ok(None) => ()
    _ => debug_assert(false, "Max-Age=0 must delete cookie")
  }
}

test "jar_eviction_and_serialization_roundtrip" {
  let limits = JarLimits::new(3, 3, 4096, 1024, SameSite::Lax, Some(34560000L), true)
  let jar = CookieJar::with_limits(limits)
  let t0 = 1700000000L

  // 1 expired (at t0+5), 1 non-secure, 1 secure
  let _ = jar.store_set_cookie("exp=1; Max-Age=2", RequestContext::http("https://example.com/", t0))
  let _ = jar.store_set_cookie("plain=2", RequestContext::http("https://example.com/", t0 + 1L))
  let _ = jar.store_set_cookie("sec=3; Secure", RequestContext::http("https://example.com/", t0 + 2L))
  debug_assert(jar.len() == 3, "jar full at 3")

  // Insert 4th at t0+5 -> expired `exp` evicted first
  let _ = jar.store_set_cookie("sec2=4; Secure", RequestContext::http("https://example.com/", t0 + 5L))
  debug_assert(jar.len() == 3, "still 3 after evicting expired")

  // Insert 5th at t0+6 -> non-secure `plain` evicted before secure cookies
  let _ = jar.store_set_cookie("sec3=5; Secure", RequestContext::http("https://example.com/", t0 + 6L))
  debug_assert(jar.len() == 3, "still 3 after evicting non-secure")
  match jar.cookie_header(RequestContext::http("https://example.com/", t0 + 7L)) {
    Ok(Some(h)) => debug_assert(h == "sec=3; sec2=4; sec3=5", "eviction kept secure cookies: " + h)
    _ => debug_assert(false, "eviction check failed")
  }

  // Export & import roundtrip
  let exported = jar.export_text()
  let jar2 = CookieJar::new()
  match jar2.import_text(exported) {
    Ok(n) => debug_assert(n == 3, "imported 3 cookies")
    Err(e) => debug_assert(false, "import_text failed: " + cookie_error_message(e))
  }
  match jar2.cookie_header(RequestContext::http("https://example.com/", t0 + 8L)) {
    Ok(Some(h)) => debug_assert(h == "sec=3; sec2=4; sec3=5", "roundtrip header: " + h)
    _ => debug_assert(false, "roundtrip read failed")
  }
}

// ---------------------------------------------------------------------------
// 6. WPT cookies core vectors & DoS / malformed resilience
// ---------------------------------------------------------------------------

test "wpt_cookies_parsing_and_storage_vectors" {
  // WPT name-value-pair: multiple '=' in value preserved
  match parse_set_cookie("foo=bar=baz=qux; Path=/") {
    Ok(c) => {
      debug_assert(c.name == "foo", "wpt multi-eq name")
      debug_assert(c.value == "bar=baz=qux", "wpt multi-eq value")
    }
    Err(_) => debug_assert(false, "wpt multi-eq failed")
  }
  // WPT empty value with '='
  match parse_set_cookie("foo=; Path=/") {
    Ok(c) => {
      debug_assert(c.name == "foo", "wpt empty value name")
      debug_assert(c.value == "", "wpt empty value")
    }
    Err(_) => debug_assert(false, "wpt empty value failed")
  }
  // WPT nameless cookie with leading/trailing spaces
  match parse_set_cookie("  barevalue  ; Secure") {
    Ok(c) => {
      debug_assert(c.name == "", "wpt bare name")
      debug_assert(c.value == "barevalue", "wpt bare value")
      debug_assert(c.secure, "wpt bare secure")
    }
    Err(_) => debug_assert(false, "wpt bare value failed")
  }
  // WPT Max-Age overrides Expires even when Expires is in the future
  let jar = CookieJar::new()
  let t0 = 1700000000L
  let ctx = RequestContext::http("https://wpt.example.org/dir/page", t0)
  let _ = jar.store_set_cookie("k=1; Max-Age=100", ctx)
  let _ = jar.store_set_cookie("k=2; Expires=Fri, 31 Dec 2099 23:59:59 GMT; Max-Age=-1", ctx)
  match jar.cookie_header(ctx) {
    Ok(None) => ()
    _ => debug_assert(false, "Max-Age=-1 must override future Expires and delete cookie")
  }
  // WPT default-path from /dir/page is /dir (matches /dir and /dir/sub, not /dir2)
  let _ = jar.store_set_cookie("dp=yes", ctx)
  match jar.cookie_header(RequestContext::http("https://wpt.example.org/dir/other", t0 + 1L)) {
    Ok(Some(h)) => debug_assert(h == "dp=yes", "default path /dir matches /dir/other")
    _ => debug_assert(false, "default path match failed")
  }
  match jar.cookie_header(RequestContext::http("https://wpt.example.org/dir2/other", t0 + 1L)) {
    Ok(None) => ()
    _ => debug_assert(false, "default path /dir must not match /dir2/other")
  }
  // WPT host-only cookie does not match subdomain
  match jar.cookie_header(RequestContext::http("https://sub.wpt.example.org/dir/other", t0 + 1L)) {
    Ok(None) => ()
    _ => debug_assert(false, "host-only cookie must not match subdomain")
  }
  // WPT SameSite=None without Secure rejected in jar
  match jar.store_set_cookie("bad=1; SameSite=None", ctx) {
    Err(CookieError::SecureOriginRequired(_)) => ()
    _ => debug_assert(false, "SameSite=None without Secure must be rejected")
  }
  // WPT non-secure origin cannot overwrite existing Secure cookie
  let _ = jar.store_set_cookie("sec=orig; Secure; Path=/", ctx)
  match jar.store_set_cookie("sec=hijack; Path=/", RequestContext::http("http://wpt.example.org/", t0 + 2L)) {
    Err(CookieError::SecureOriginRequired(_)) => ()
    _ => debug_assert(false, "http must not overwrite Secure cookie")
  }
}

test "dos_and_malformed_resilience" {
  // 1000 empty attributes (semicolon bomb)
  let sb = StringBuilder::new()
  sb.write_string("a=1")
  let mut i = 0
  while i < 1000 {
    sb.write_string(";")
    i = i + 1
  }
  match parse_set_cookie(sb.to_string()) {
    Ok(c) => debug_assert(c.name == "a" && c.value == "1", "semicolon bomb parsed cleanly")
    Err(e) => debug_assert(false, "semicolon bomb failed: " + cookie_error_message(e))
  }

  // Huge attribute value (> 1024 bytes) ignored without panic
  let sb2 = StringBuilder::new()
  sb2.write_string("a=1; Path=/")
  let mut j = 0
  while j < 1500 {
    sb2.write_string("x")
    j = j + 1
  }
  match parse_set_cookie(sb2.to_string()) {
    Ok(c) => debug_assert(opt_str_eq(c.path, None), "oversized attribute ignored")
    Err(e) => debug_assert(false, "oversized attribute should be ignored: " + cookie_error_message(e))
  }

  // Clear domain & purge expired & clear
  let jar = CookieJar::new()
  let t0 = 1700000000L
  let _ = jar.store_set_cookie("a=1; Max-Age=10", RequestContext::http("https://a.example.com/", t0))
  let _ = jar.store_set_cookie("b=2; Max-Age=100", RequestContext::http("https://b.example.com/", t0))
  let _ = jar.store_set_cookie("c=3; Max-Age=100", RequestContext::http("https://a.example.com/", t0))
  debug_assert(jar.purge_expired(t0 + 20L) == 1, "purged 1 expired cookie")
  debug_assert(jar.clear_domain("a.example.com") == 1, "cleared 1 cookie for a.example.com")
  debug_assert(jar.len() == 1, "1 cookie remaining")
  jar.clear()
  debug_assert(jar.len() == 0, "jar empty after clear")
}
