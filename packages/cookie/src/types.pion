///| Core RFC 6265bis, CHIPS (Cookies Having Independent Partitioned State),
///| and Mozilla Public Suffix List (PSL) types and explicit error definitions.

///| RFC 6265bis `SameSite` attribute values.
pub enum SameSite {
  Strict
  Lax
  None
}

///| Compare two `SameSite` values for equality.
pub fn same_site_eq(a : SameSite, b : SameSite) -> Bool {
  match (a, b) {
    (SameSite::Strict, SameSite::Strict) => true
    (SameSite::Lax, SameSite::Lax) => true
    (SameSite::None, SameSite::None) => true
    _ => false
  }
}

///| Format a `SameSite` value in canonical HTTP title case.
pub fn same_site_to_string(s : SameSite) -> String {
  match s {
    SameSite::Strict => "Strict"
    SameSite::Lax => "Lax"
    SameSite::None => "None"
  }
}

///| Public Suffix List rule section.
pub enum PslSection {
  Icann
  Private
  Unlisted
}

///| Compare two `PslSection` values for equality.
pub fn psl_section_eq(a : PslSection, b : PslSection) -> Bool {
  match (a, b) {
    (PslSection::Icann, PslSection::Icann) => true
    (PslSection::Private, PslSection::Private) => true
    (PslSection::Unlisted, PslSection::Unlisted) => true
    _ => false
  }
}

///| Detailed result of a Public Suffix List match.
pub val struct PslMatch {
  pub suffix : String
  pub section : PslSection
  pub is_exception : Bool
  pub is_wildcard : Bool
}

///| Explicit errors returned by `cookie` operations.
pub enum CookieError {
  InvalidName(String)
  InvalidValue(String)
  InvalidHeader(String)
  InvalidDate(String)
  InvalidUrl(String)
  SizeExceeded(String)
  PrefixViolation(String)
  PartitionedRequiresSecure(String)
  PublicSuffixRejected(String)
  DomainMismatch(String)
  SecureOriginRequired(String)
  HttpOnlyViolation(String)
  InvalidFormat(String)
}

///| Human-readable message for a `CookieError`.
pub fn cookie_error_message(err : CookieError) -> String {
  match err {
    CookieError::InvalidName(msg) => "invalid cookie name: " + msg
    CookieError::InvalidValue(msg) => "invalid cookie value: " + msg
    CookieError::InvalidHeader(msg) => "invalid cookie header: " + msg
    CookieError::InvalidDate(msg) => "invalid cookie date: " + msg
    CookieError::InvalidUrl(msg) => "invalid url: " + msg
    CookieError::SizeExceeded(msg) => "cookie size exceeded: " + msg
    CookieError::PrefixViolation(msg) => "cookie prefix violation: " + msg
    CookieError::PartitionedRequiresSecure(msg) => "partitioned requires Secure: " + msg
    CookieError::PublicSuffixRejected(msg) => "public suffix rejected: " + msg
    CookieError::DomainMismatch(msg) => "domain mismatch: " + msg
    CookieError::SecureOriginRequired(msg) => "secure origin required: " + msg
    CookieError::HttpOnlyViolation(msg) => "HttpOnly violation: " + msg
    CookieError::InvalidFormat(msg) => "invalid format: " + msg
  }
}

///| Parsed or constructed RFC 6265bis `Set-Cookie` value.
pub val struct Cookie {
  pub name : String
  pub value : String
  pub expires : Option[Int64]
  pub max_age : Option[Int64]
  pub domain : Option[String]
  pub path : Option[String]
  pub secure : Bool
  pub http_only : Bool
  pub same_site : Option[SameSite]
  pub partitioned : Bool
}

///| Create a minimal `Cookie` with the given name and value.
pub fn Cookie::new(name : String, value : String) -> Cookie {
  Cookie::{
    name: name,
    value: value,
    expires: None,
    max_age: None,
    domain: None,
    path: None,
    secure: false,
    http_only: false,
    same_site: None,
    partitioned: false,
  }
}

///| Return a copy of `Cookie` with `expires` set.
pub fn Cookie::with_expires(self : Cookie, unix_secs : Int64) -> Cookie {
  Cookie::{
    name: self.name,
    value: self.value,
    expires: Some(unix_secs),
    max_age: self.max_age,
    domain: self.domain,
    path: self.path,
    secure: self.secure,
    http_only: self.http_only,
    same_site: self.same_site,
    partitioned: self.partitioned,
  }
}

///| Return a copy of `Cookie` with `max_age` set.
pub fn Cookie::with_max_age(self : Cookie, secs : Int64) -> Cookie {
  Cookie::{
    name: self.name,
    value: self.value,
    expires: self.expires,
    max_age: Some(secs),
    domain: self.domain,
    path: self.path,
    secure: self.secure,
    http_only: self.http_only,
    same_site: self.same_site,
    partitioned: self.partitioned,
  }
}

///| Return a copy of `Cookie` with `domain` set.
pub fn Cookie::with_domain(self : Cookie, domain : String) -> Cookie {
  Cookie::{
    name: self.name,
    value: self.value,
    expires: self.expires,
    max_age: self.max_age,
    domain: Some(domain),
    path: self.path,
    secure: self.secure,
    http_only: self.http_only,
    same_site: self.same_site,
    partitioned: self.partitioned,
  }
}

///| Return a copy of `Cookie` with `path` set.
pub fn Cookie::with_path(self : Cookie, path : String) -> Cookie {
  Cookie::{
    name: self.name,
    value: self.value,
    expires: self.expires,
    max_age: self.max_age,
    domain: self.domain,
    path: Some(path),
    secure: self.secure,
    http_only: self.http_only,
    same_site: self.same_site,
    partitioned: self.partitioned,
  }
}

///| Return a copy of `Cookie` with `secure` set.
pub fn Cookie::with_secure(self : Cookie, secure : Bool) -> Cookie {
  Cookie::{
    name: self.name,
    value: self.value,
    expires: self.expires,
    max_age: self.max_age,
    domain: self.domain,
    path: self.path,
    secure: secure,
    http_only: self.http_only,
    same_site: self.same_site,
    partitioned: self.partitioned,
  }
}

///| Return a copy of `Cookie` with `http_only` set.
pub fn Cookie::with_http_only(self : Cookie, http_only : Bool) -> Cookie {
  Cookie::{
    name: self.name,
    value: self.value,
    expires: self.expires,
    max_age: self.max_age,
    domain: self.domain,
    path: self.path,
    secure: self.secure,
    http_only: http_only,
    same_site: self.same_site,
    partitioned: self.partitioned,
  }
}

///| Return a copy of `Cookie` with `same_site` set.
pub fn Cookie::with_same_site(self : Cookie, same_site : SameSite) -> Cookie {
  Cookie::{
    name: self.name,
    value: self.value,
    expires: self.expires,
    max_age: self.max_age,
    domain: self.domain,
    path: self.path,
    secure: self.secure,
    http_only: self.http_only,
    same_site: Some(same_site),
    partitioned: self.partitioned,
  }
}

///| Return a copy of `Cookie` with `partitioned` set.
pub fn Cookie::with_partitioned(self : Cookie, partitioned : Bool) -> Cookie {
  Cookie::{
    name: self.name,
    value: self.value,
    expires: self.expires,
    max_age: self.max_age,
    domain: self.domain,
    path: self.path,
    secure: self.secure,
    http_only: self.http_only,
    same_site: self.same_site,
    partitioned: partitioned,
  }
}

///| Name-value pair from a `Cookie:` HTTP request header.
pub val struct CookiePair {
  pub name : String
  pub value : String
}

///| Construct a `CookiePair`.
pub fn CookiePair::new(name : String, value : String) -> CookiePair {
  CookiePair::{ name: name, value: value }
}

///| Configurable options for `Set-Cookie` parsing.
pub val struct ParseOptions {
  pub max_cookie_bytes : Int
  pub max_attribute_bytes : Int
  pub default_same_site : SameSite
}

///| Default RFC 6265bis parse options (4096 B name+value, 1024 B attribute, Lax default).
pub fn ParseOptions::default() -> ParseOptions {
  ParseOptions::{
    max_cookie_bytes: 4096,
    max_attribute_bytes: 1024,
    default_same_site: SameSite::Lax,
  }
}

///| Construct custom `ParseOptions`.
pub fn ParseOptions::new(
  max_cookie_bytes : Int,
  max_attribute_bytes : Int,
  default_same_site : SameSite,
) -> ParseOptions {
  ParseOptions::{
    max_cookie_bytes: max_cookie_bytes,
    max_attribute_bytes: max_attribute_bytes,
    default_same_site: default_same_site,
  }
}

///| Minimal parsed URL components needed for RFC 6265bis cookie scoping.
pub val struct ParsedUrl {
  pub scheme : String
  pub host : String
  pub path : String
  pub is_secure : Bool
}

///| Request context for `CookieJar` storage and retrieval.
pub val struct RequestContext {
  pub url : String
  pub top_level_site : Option[String]
  pub is_http_api : Bool
  pub is_same_site : Bool
  pub is_top_level_navigation : Bool
  pub is_safe_method : Bool
  pub now_unix_secs : Int64
}

///| Construct a full `RequestContext`.
pub fn RequestContext::new(
  url : String,
  top_level_site : Option[String],
  is_http_api : Bool,
  is_same_site : Bool,
  now_unix_secs : Int64,
) -> RequestContext {
  RequestContext::{
    url: url,
    top_level_site: top_level_site,
    is_http_api: is_http_api,
    is_same_site: is_same_site,
    is_top_level_navigation: false,
    is_safe_method: true,
    now_unix_secs: now_unix_secs,
  }
}

///| Convenience constructor for a same-site HTTP request context.
pub fn RequestContext::http(url : String, now_unix_secs : Int64) -> RequestContext {
  RequestContext::{
    url: url,
    top_level_site: None,
    is_http_api: true,
    is_same_site: true,
    is_top_level_navigation: true,
    is_safe_method: true,
    now_unix_secs: now_unix_secs,
  }
}

///| Return a copy of `RequestContext` with `is_top_level_navigation` and `is_safe_method`.
pub fn RequestContext::with_navigation(
  self : RequestContext,
  is_top_level_navigation : Bool,
  is_safe_method : Bool,
) -> RequestContext {
  RequestContext::{
    url: self.url,
    top_level_site: self.top_level_site,
    is_http_api: self.is_http_api,
    is_same_site: self.is_same_site,
    is_top_level_navigation: is_top_level_navigation,
    is_safe_method: is_safe_method,
    now_unix_secs: self.now_unix_secs,
  }
}

///| Stored cookie record inside a `CookieJar` (RFC 6265bis §5.3 + CHIPS).
pub val struct StoredCookie {
  pub name : String
  pub value : String
  pub domain : String
  pub host_only : Bool
  pub path : String
  pub secure : Bool
  pub http_only : Bool
  pub same_site : SameSite
  pub partitioned : Bool
  pub partition_key : Option[String]
  pub creation_time : Int64
  pub last_access_time : Int64
  pub expiry_time : Option[Int64]
  pub persistent : Bool
}

///| Configurable limits and policies for `CookieJar`.
pub val struct JarLimits {
  pub max_cookies : Int
  pub max_cookies_per_domain : Int
  pub max_cookie_bytes : Int
  pub max_attribute_bytes : Int
  pub default_same_site : SameSite
  pub max_lifetime_secs : Option[Int64]
  pub include_private_psl : Bool
}

///| Default RFC 6265bis `CookieJar` limits (3000 global, 180/domain, 4096 B, 400-day cap).
pub fn JarLimits::default() -> JarLimits {
  JarLimits::{
    max_cookies: 3000,
    max_cookies_per_domain: 180,
    max_cookie_bytes: 4096,
    max_attribute_bytes: 1024,
    default_same_site: SameSite::Lax,
    max_lifetime_secs: Some(34560000L),
    include_private_psl: true,
  }
}

///| Construct custom `JarLimits`.
pub fn JarLimits::new(
  max_cookies : Int,
  max_cookies_per_domain : Int,
  max_cookie_bytes : Int,
  max_attribute_bytes : Int,
  default_same_site : SameSite,
  max_lifetime_secs : Option[Int64],
  include_private_psl : Bool,
) -> JarLimits {
  JarLimits::{
    max_cookies: max_cookies,
    max_cookies_per_domain: max_cookies_per_domain,
    max_cookie_bytes: max_cookie_bytes,
    max_attribute_bytes: max_attribute_bytes,
    default_same_site: default_same_site,
    max_lifetime_secs: max_lifetime_secs,
    include_private_psl: include_private_psl,
  }
}
