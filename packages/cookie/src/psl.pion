///| Embedded read-only Mozilla Public Suffix List (PSL) engine with RFC 3492
///| Punycode support, UTS #46 canonicalization, IP literal detection, and
///| O(log N) zero-allocation node-flag lookup.

fn psl_ascii_lower_byte(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

fn is_ipv4_slice(host : String, n : Int) -> Bool {
  // Strict IPv4 dotted-quad check: 4 octets in 0..255
  let mut parts = 0
  let mut pos = 0
  while pos < n {
    if parts >= 4 {
      return false
    }
    let start = pos
    let mut octet = 0
    let mut digits = 0
    while pos < n {
      let c = host.code_unit_at(pos)
      if c == 46 {
        break
      }
      if c < 48 || c > 57 {
        return false
      }
      octet = octet * 10 + (c - 48)
      digits = digits + 1
      if digits > 3 || octet > 255 {
        return false
      }
      pos = pos + 1
    }
    if digits == 0 {
      return false
    }
    if digits > 1 && host.code_unit_at(start) == 48 {
      return false
    }
    parts = parts + 1
    if pos < n {
      pos = pos + 1
      if pos == n {
        return false
      }
    }
  }
  parts == 4
}

fn is_ip_address_slice(host : String, n : Int) -> Bool {
  if n == 0 {
    return false
  }
  // Bracketed IPv6 or bare IPv6 containing ':'
  let first = host.code_unit_at(0)
  let last = host.code_unit_at(n - 1)
  if first == 91 && last == 93 {
    return true
  }
  let mut i = 0
  while i < n {
    if host.code_unit_at(i) == 58 {
      return true
    }
    i = i + 1
  }
  // Fast exit: IPv4 must end with an ASCII digit
  if last < 48 || last > 57 {
    return false
  }
  is_ipv4_slice(host, n)
}

///| Check whether `host` is an IPv4 dotted-quad or IPv6 address literal.
pub fn is_ip_address(host : String) -> Bool {
  is_ip_address_slice(host, host.length())
}

///| UTS #46 codepoint folding for common scripts + fullwidth ASCII.
///| Returns `-1` (fail-closed reject) for unmapped compatibility/fullwidth forms.
fn uts46_fold_codepoint(cp : Int) -> Int {
  // ASCII uppercase A..Z
  if cp >= 65 && cp <= 90 {
    return cp + 32
  }
  // Latin-1 Supplement uppercase À..Ö (0xC0..0xD6) and Ø..Þ (0xD8..0xDE)
  if (cp >= 192 && cp <= 214) || (cp >= 216 && cp <= 222) {
    return cp + 32
  }
  // Greek uppercase Α..Ρ (0x0391..0x03A1) and Σ..Ϋ (0x03A3..0x03AB)
  if (cp >= 913 && cp <= 929) || (cp >= 931 && cp <= 939) {
    return cp + 32
  }
  // Cyrillic uppercase А..Я (0x0410..0x042F) and Ѐ..Џ (0x0400..0x040F)
  if cp >= 1040 && cp <= 1071 {
    return cp + 32
  }
  if cp >= 1024 && cp <= 1039 {
    return cp + 80
  }
  // Ideographic / fullwidth / halfwidth label separators -> '.'
  if cp == 12290 || cp == 65294 || cp == 65377 {
    return 46
  }
  // Fullwidth ASCII letters, digits, and hyphen (UTS #46 NFKC + lowercase)
  if cp >= 65313 && cp <= 65338 {
    // ０xFF21..0xFF3A (Ａ..Ｚ) -> a..z
    return cp - 65313 + 97
  }
  if cp >= 65345 && cp <= 65370 {
    // 0xFF41..0xFF5A (ａ..ｚ) -> a..z
    return cp - 65345 + 97
  }
  if cp >= 65296 && cp <= 65305 {
    // 0xFF10..0xFF19 (０..９) -> 0..9
    return cp - 65296 + 48
  }
  if cp == 65293 {
    // 0xFF0D (－) -> '-'
    return 45
  }
  // Fail-closed on other unmapped halfwidth/fullwidth compatibility forms (0xFF00..0xFFEF)
  if cp >= 65280 && cp <= 65519 {
    return -1
  }
  cp
}

fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 128 {
    sb.write_byte(cp.to_byte())
  } else if cp < 2048 {
    sb.write_byte((192 | (cp >> 6)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  } else if cp < 65536 {
    sb.write_byte((224 | (cp >> 12)).to_byte())
    sb.write_byte((128 | ((cp >> 6) & 63)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  } else {
    sb.write_byte((240 | (cp >> 18)).to_byte())
    sb.write_byte((128 | ((cp >> 12) & 63)).to_byte())
    sb.write_byte((128 | ((cp >> 6) & 63)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  }
}

fn read_u24(s : String, byte_off : Int) -> Int {
  let b0 = dec6(s.code_unit_at(byte_off))
  let b1 = dec6(s.code_unit_at(byte_off + 1))
  let b2 = dec6(s.code_unit_at(byte_off + 2))
  let b3 = dec6(s.code_unit_at(byte_off + 3))
  (b0 << 18) | (b1 << 12) | (b2 << 6) | b3
}

///| Binary-search the `unicodedata`-generated sorted range table to reject any
///| non-ASCII code point that is not stable under NFKC + lowercase or is an NFD
///| combining mark (fail-closed UTS #46 guard).
fn is_unicode_noncanonical(cp : Int) -> Bool {
  if cp < 128 {
    return false
  }
  let tbl = unicode_noncanon_ranges()
  let mut lo = 0
  let mut hi = unicode_noncanon_range_count()
  while lo < hi {
    let mid = lo + ((hi - lo) >> 1)
    let off = mid * 8
    let r_lo = read_u24(tbl, off)
    let r_hi = read_u24(tbl, off + 4)
    if cp < r_lo {
      hi = mid
    } else if cp > r_hi {
      lo = mid + 1
    } else {
      return true
    }
  }
  false
}

///| Decode a UTF-8 `String` into Unicode scalar values, applying UTS #46 folding
///| for common scripts/fullwidth ASCII and failing closed (`None`) on any other
///| NFKC/lowercase-unstable code point or NFD combining mark.
fn utf8_decode_and_canonicalize(s : String) -> Option[Array[Int]] {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i) & 255
    if b0 < 128 {
      out.push(psl_ascii_lower_byte(b0))
      i = i + 1
    } else if (b0 & 224) == 192 {
      if i + 1 >= n {
        return None
      }
      let b1 = s.code_unit_at(i + 1) & 255
      if (b1 & 192) != 128 {
        return None
      }
      let cp = ((b0 & 31) << 6) | (b1 & 63)
      if cp < 128 {
        return None
      }
      let folded = uts46_fold_codepoint(cp)
      if folded < 0 || is_unicode_noncanonical(folded) {
        return None
      }
      out.push(folded)
      i = i + 2
    } else if (b0 & 240) == 224 {
      if i + 2 >= n {
        return None
      }
      let b1 = s.code_unit_at(i + 1) & 255
      let b2 = s.code_unit_at(i + 2) & 255
      if (b1 & 192) != 128 || (b2 & 192) != 128 {
        return None
      }
      let cp = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
      if cp < 2048 || (cp >= 55296 && cp <= 57343) {
        return None
      }
      let folded = uts46_fold_codepoint(cp)
      if folded < 0 || is_unicode_noncanonical(folded) {
        return None
      }
      out.push(folded)
      i = i + 3
    } else if (b0 & 248) == 240 {
      if i + 3 >= n {
        return None
      }
      let b1 = s.code_unit_at(i + 1) & 255
      let b2 = s.code_unit_at(i + 2) & 255
      let b3 = s.code_unit_at(i + 3) & 255
      if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128 {
        return None
      }
      let cp = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
      if cp < 65536 || cp > 1114111 {
        return None
      }
      if is_unicode_noncanonical(cp) {
        return None
      }
      out.push(cp)
      i = i + 4
    } else {
      return None
    }
  }
  Some(out)
}

fn punycode_digit(d : Int) -> Int {
  if d < 26 {
    97 + d
  } else {
    48 + (d - 26)
  }
}

fn punycode_adapt(delta_in : Int, num_points : Int, first_time : Bool) -> Int {
  let mut delta = if first_time { delta_in / 700 } else { delta_in / 2 }
  delta = delta + delta / num_points
  let mut k = 0
  while delta > 455 {
    delta = delta / 35
    k = k + 36
  }
  k + (36 * delta) / (delta + 38)
}

///| RFC 3492 Punycode encoder for a single non-ASCII label (prefixed with `xn--`).
///| Bounded to RFC 1035 max 63 ASCII octets.
fn encode_punycode_cps(cps : Array[Int], start : Int, end : Int) -> Option[String] {
  let total = end - start
  if total <= 0 || total > 63 {
    return None
  }
  let out = StringBuilder::new()
  out.write_string("xn--")
  let mut out_len = 4
  let mut b = 0
  let mut i = start
  while i < end {
    let cp = cps[i]
    if cp < 128 {
      out.write_byte(cp.to_byte())
      out_len = out_len + 1
      if out_len > 63 {
        return None
      }
      b = b + 1
    }
    i = i + 1
  }
  let mut h = b
  if b > 0 {
    out.write_byte(45.to_byte())
    out_len = out_len + 1
    if out_len > 63 {
      return None
    }
  }
  let mut n = 128
  let mut delta = 0
  let mut bias = 72
  while h < total {
    let mut m = 2147483647
    let mut j = start
    while j < end {
      let c = cps[j]
      if c >= n && c < m {
        m = c
      }
      j = j + 1
    }
    if m - n > (2147483647 - delta) / (h + 1) {
      return None
    }
    delta = delta + (m - n) * (h + 1)
    n = m
    let mut j2 = start
    while j2 < end {
      let c = cps[j2]
      if c < n {
        delta = delta + 1
        if delta < 0 {
          return None
        }
      } else if c == n {
        let mut q = delta
        let mut k = 36
        while true {
          let t = if k <= bias {
            1
          } else if k >= bias + 26 {
            26
          } else {
            k - bias
          }
          if q < t {
            break
          }
          let digit = t + (q - t) % (36 - t)
          out.write_byte(punycode_digit(digit).to_byte())
          out_len = out_len + 1
          if out_len > 63 {
            return None
          }
          q = (q - t) / (36 - t)
          k = k + 36
        }
        out.write_byte(punycode_digit(q).to_byte())
        out_len = out_len + 1
        if out_len > 63 {
          return None
        }
        bias = punycode_adapt(delta, h + 1, h == b)
        delta = 0
        h = h + 1
      }
      j2 = j2 + 1
    }
    delta = delta + 1
    n = n + 1
  }
  Some(out.to_string())
}

fn dec6(c : Int) -> Int {
  if c > 92 {
    c - 49
  } else {
    c - 48
  }
}

fn section_from_code(code : Int) -> PslSection {
  if code == 1 {
    PslSection::Icann
  } else if code == 2 {
    PslSection::Private
  } else {
    PslSection::Unlisted
  }
}

fn psl_slice_eq_upper(asc : String, start : Int, len : Int, blob : String, off : Int) -> Bool {
  let mut k = 0
  while k < len {
    let c = asc.code_unit_at(start + k)
    let lc = if c >= 65 && c <= 90 { c + 32 } else { c }
    if lc != blob.code_unit_at(off + k) {
      return false
    }
    k = k + 1
  }
  true
}

///| Single-pass right-to-left ASCII validation + O(1) hash-trie PSL match.
///| Returns:
///|   `0`  if invalid (empty, leading dot, empty/long label, >253 B, or IP literal)
///|   `-1` if non-ASCII (caller must use IDN slow path)
///|   `>0` packed 28-bit result:
///|     bits  0..6  (7b): best_labels (1..127)
///|     bits  7..14 (8b): best_start (0..253)
///|     bits 15..22 (8b): eff_len (1..253)
///|     bits 23..24 (2b): section code (0=Unlisted, 1=Icann, 2=Private)
///|     bit  25     (1b): is_exception
///|     bit  26     (1b): is_wildcard
///|     bit  27     (1b): has_upper
fn psl_scan_and_match(domain : String, include_private : Bool) -> Int {
  let n = domain.length()
  if n == 0 {
    return 0
  }
  let first = domain.code_unit_at(0)
  if first == 46 {
    return 0
  }
  let last_raw = domain.code_unit_at(n - 1)
  let eff_len = if last_raw == 46 { n - 1 } else { n }
  if eff_len == 0 {
    return 0
  }
  let last = if last_raw == 46 { domain.code_unit_at(eff_len - 1) } else { last_raw }
  if first == 91 && last == 93 {
    return 0
  }

  // Single flat blob: cc[0..1352), tld[1352..9544), edge[9544..75080), meta[75080..), pool
  let blob = psl_node_data()

  // Scan TLD (rightmost label) right-to-left: validate + lowercase + hash in ONE pass
  let mut pos = eff_len
  let mut label_start = pos
  let mut h = 5381
  let mut has_upper = 0
  while label_start > 0 {
    let c = domain.code_unit_at(label_start - 1)
    if c >= 97 {
      if c >= 128 {
        return -1
      }
      h = (h * 33) ^ c
    } else if c == 46 {
      break
    } else if c == 58 {
      return 0
    } else if c >= 65 && c <= 90 {
      has_upper = 1
      h = (h * 33) ^ (c + 32)
    } else {
      h = (h * 33) ^ c
    }
    label_start = label_start - 1
  }

  let tld_len = pos - label_start
  if tld_len == 0 || tld_len > 63 {
    let mut rem = label_start
    while rem > 0 {
      rem = rem - 1
      if domain.code_unit_at(rem) >= 128 {
        return -1
      }
    }
    return 0
  }

  let mut best_labels = 1
  let mut best_start = label_start
  let mut best_sec = 0
  let mut best_ex = 0
  let mut best_wc = 0

  // O(1) TLD lookup: 26x26 ccTLD direct table or 4096-slot hash table
  let mut nid = 0
  let mut cc_checked = false
  if tld_len == 2 {
    let raw0 = domain.code_unit_at(label_start)
    let raw1 = domain.code_unit_at(label_start + 1)
    let c0 = if raw0 >= 65 && raw0 <= 90 { raw0 + 32 } else { raw0 }
    let c1 = if raw1 >= 65 && raw1 <= 90 { raw1 + 32 } else { raw1 }
    if c0 >= 97 && c0 <= 122 && c1 >= 97 && c1 <= 122 {
      cc_checked = true
      let p = ((c0 - 97) * 26 + (c1 - 97)) << 1
      nid = (blob.code_unit_at(p) << 7) | blob.code_unit_at(p + 1)
    }
  }
  if !cc_checked {
    let hm = h & 2147483647
    let mut slot = (hm ^ (hm >> 12)) & 4095
    while true {
      let sp = 1352 + (slot << 1)
      let cand = (blob.code_unit_at(sp) << 7) | blob.code_unit_at(sp + 1)
      if cand == 0 {
        break
      }
      let m = 75080 + (cand << 3)
      if blob.code_unit_at(m + 1) == tld_len {
        let off = (blob.code_unit_at(m + 2) << 14) |
        (blob.code_unit_at(m + 3) << 7) |
        blob.code_unit_at(m + 4)
        let mut eq = true
        if has_upper == 0 {
          let mut k2 = 0
          while k2 < tld_len {
            if domain.code_unit_at(label_start + k2) != blob.code_unit_at(off + k2) {
              eq = false
              break
            }
            k2 = k2 + 1
          }
        } else {
          eq = psl_slice_eq_upper(domain, label_start, tld_len, blob, off)
        }
        if eq {
          nid = cand
          break
        }
      }
      slot = (slot + 1) & 4095
    }
  }

  let mut cur_flags = 0
  let mut stopped = true
  if nid != 0 {
    cur_flags = blob.code_unit_at(75080 + (nid << 3))
    let exact1 = if (cur_flags & 1) != 0 {
      1
    } else if include_private && (cur_flags & 2) != 0 {
      2
    } else {
      0
    }
    if exact1 != 0 {
      best_sec = exact1
    }
    if (cur_flags & 76) != 0 && label_start > 0 {
      stopped = false
    }
  }

  let mut prev_start = label_start
  let mut k = 1
  pos = if label_start > 0 { label_start - 1 } else { 0 }

  if !stopped {
    while pos > 0 {
      let mut ls = pos
      let mut eh = nid * 40503 + 5381
      while ls > 0 {
        let c = domain.code_unit_at(ls - 1)
        if c >= 97 {
          if c >= 128 {
            return -1
          }
          eh = (eh * 33) ^ c
        } else if c == 46 {
          break
        } else if c == 58 {
          return 0
        } else if c >= 65 && c <= 90 {
          has_upper = 1
          eh = (eh * 33) ^ (c + 32)
        } else {
          eh = (eh * 33) ^ c
        }
        ls = ls - 1
      }
      let key_len = pos - ls
      if key_len == 0 || key_len > 63 {
        let mut rem = ls
        while rem > 0 {
          rem = rem - 1
          if domain.code_unit_at(rem) >= 128 {
            return -1
          }
        }
        return 0
      }
      k = k + 1

      let prev_wild_code = if (cur_flags & 4) != 0 {
        1
      } else if include_private && (cur_flags & 8) != 0 {
        2
      } else {
        0
      }

      let mut child_id = 0
      if (cur_flags & 64) != 0 {
        let ehm = eh & 2147483647
        let mut slot = (ehm ^ (ehm >> 15)) & 32767
        while true {
          let sp = 9544 + (slot << 1)
          let cand = (blob.code_unit_at(sp) << 7) | blob.code_unit_at(sp + 1)
          if cand == 0 {
            break
          }
          let m = 75080 + (cand << 3)
          if blob.code_unit_at(m + 1) == key_len {
            let pid = (blob.code_unit_at(m + 5) << 7) | blob.code_unit_at(m + 6)
            if pid == nid {
              let off = (blob.code_unit_at(m + 2) << 14) |
              (blob.code_unit_at(m + 3) << 7) |
              blob.code_unit_at(m + 4)
              let mut eq = true
              if has_upper == 0 {
                let mut k2 = 0
                while k2 < key_len {
                  if domain.code_unit_at(ls + k2) != blob.code_unit_at(off + k2) {
                    eq = false
                    break
                  }
                  k2 = k2 + 1
                }
              } else {
                eq = psl_slice_eq_upper(domain, ls, key_len, blob, off)
              }
              if eq {
                child_id = cand
                break
              }
            }
          }
          slot = (slot + 1) & 32767
        }
      }

      if child_id != 0 {
        let cflags = blob.code_unit_at(75080 + (child_id << 3))
        let ex_code = if (cflags & 16) != 0 {
          1
        } else if include_private && (cflags & 32) != 0 {
          2
        } else {
          0
        }
        if ex_code != 0 {
          best_labels = k - 1
          best_start = prev_start
          best_sec = ex_code
          best_ex = 1
          best_wc = 0
          pos = if ls > 0 { ls - 1 } else { 0 }
          break
        }

        let exact_code = if (cflags & 1) != 0 {
          1
        } else if include_private && (cflags & 2) != 0 {
          2
        } else {
          0
        }
        if exact_code != 0 {
          best_labels = k
          best_start = ls
          best_sec = exact_code
          best_ex = 0
          best_wc = 0
        } else if prev_wild_code != 0 {
          best_labels = k
          best_start = ls
          best_sec = prev_wild_code
          best_ex = 0
          best_wc = 1
        }

        nid = child_id
        cur_flags = cflags
        prev_start = ls
        pos = if ls > 0 { ls - 1 } else { 0 }
        if (cflags & 76) == 0 {
          break
        }
      } else {
        if prev_wild_code != 0 {
          best_labels = k
          best_start = ls
          best_sec = prev_wild_code
          best_ex = 0
          best_wc = 1
        }
        pos = if ls > 0 { ls - 1 } else { 0 }
        break
      }
    }
  }

  // Validate any remaining prefix bytes [0..pos) (no hashing, no trie lookups)
  if pos > 0 {
    let mut lbl_len = 0
    let mut r = pos
    while r > 0 {
      r = r - 1
      let c = domain.code_unit_at(r)
      if c >= 97 {
        if c >= 128 {
          return -1
        }
        lbl_len = lbl_len + 1
      } else if c == 46 {
        if lbl_len == 0 || lbl_len > 63 {
          let mut r2 = r
          while r2 > 0 {
            r2 = r2 - 1
            if domain.code_unit_at(r2) >= 128 {
              return -1
            }
          }
          return 0
        }
        lbl_len = 0
      } else if c == 58 {
        return 0
      } else {
        if c >= 65 && c <= 90 {
          has_upper = 1
        }
        lbl_len = lbl_len + 1
      }
    }
    if lbl_len == 0 || lbl_len > 63 {
      return 0
    }
  }

  if eff_len > 253 {
    return 0
  }
  if last >= 48 && last <= 57 && is_ipv4_slice(domain, eff_len) {
    return 0
  }

  best_labels |
  (best_start << 7) |
  (eff_len << 15) |
  (best_sec << 23) |
  (best_ex << 25) |
  (best_wc << 26) |
  (has_upper << 27)
}

fn psl_extract_slice(domain : String, start : Int, end : Int, has_upper : Int) -> String {
  if has_upper == 0 {
    if start == 0 && end == domain.length() {
      return domain
    }
    return domain.slice(start, end)
  }
  let len = end - start
  let out = Bytes::new(len)
  let mut j = 0
  while j < len {
    let c = domain.code_unit_at(start + j)
    out[j] = (if c >= 65 && c <= 90 { c + 32 } else { c }).to_byte()
    j = j + 1
  }
  out.to_string()
}

fn find_reg_start(asc : String, suffix_start : Int) -> Int {
  if suffix_start <= 1 {
    return -1
  }
  let mut p = suffix_start - 1
  while p > 0 && asc.code_unit_at(p - 1) != 46 {
    p = p - 1
  }
  p
}

fn join_tail(labels : Array[String], from_idx : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = from_idx
  while i < labels.length() {
    if i > from_idx {
      sb.write_string(".")
    }
    sb.write_string(labels[i])
    i = i + 1
  }
  sb.to_string()
}

///| IDN / UTS #46 slow path: decodes UTF-8, maps ideographic dots and Latin-1 uppercase,
///| Punycode-encodes non-ASCII labels, enforces RFC 1035 limits, and matches PSL.
fn match_idn_psl(
  domain : String,
  include_private : Bool,
) -> Option[(Array[String], Int, PslSection, Bool, Bool)] {
  // Reject huge inputs before decoding (RFC 1035: <= 253 octets)
  if domain.length() > 254 {
    return None
  }
  let cps = match utf8_decode_and_canonicalize(domain) {
    Some(v) => v
    None => return None
  }
  let n = cps.length()
  if n == 0 || cps[0] == 46 {
    return None
  }
  let eff_len = if cps[n - 1] == 46 { n - 1 } else { n }
  if eff_len == 0 {
    return None
  }
  // Rebuild canonical UTF-8 string to check byte length <= 253 and IP literal
  let full_sb = StringBuilder::new()
  let mut idx = 0
  while idx < eff_len {
    write_utf8_cp(full_sb, cps[idx])
    idx = idx + 1
  }
  let canon = full_sb.to_string()
  if canon.length() > 253 || is_ip_address_slice(canon, canon.length()) {
    return None
  }

  let display : Array[String] = []
  let asc_sb = StringBuilder::new()
  let mut asc_total = 0
  let mut start = 0
  let mut i = 0
  while i <= eff_len {
    if i == eff_len || cps[i] == 46 {
      if i == start {
        return None
      }
      let lab_sb = StringBuilder::new()
      let mut is_asc = true
      let mut k = start
      while k < i {
        let cp = cps[k]
        if cp >= 128 {
          is_asc = false
        }
        write_utf8_cp(lab_sb, cp)
        k = k + 1
      }
      let disp_lab = lab_sb.to_string()
      display.push(disp_lab)
      let asc_lab = if is_asc {
        if disp_lab.length() > 63 {
          return None
        }
        disp_lab
      } else {
        match encode_punycode_cps(cps, start, i) {
          Some(p) => p
          None => return None
        }
      }
      if asc_total > 0 {
        asc_sb.write_byte(46.to_byte())
        asc_total = asc_total + 1
      }
      asc_sb.write_string(asc_lab)
      asc_total = asc_total + asc_lab.length()
      if asc_total > 253 {
        return None
      }
      start = i + 1
    }
    i = i + 1
  }
  let asc_str = asc_sb.to_string()
  let packed = psl_scan_and_match(asc_str, include_private)
  if packed <= 0 {
    return None
  }
  let suffix_labels = packed & 127
  let section = section_from_code((packed >> 23) & 3)
  let is_ex = ((packed >> 25) & 1) != 0
  let is_wc = ((packed >> 26) & 1) != 0
  Some((display, suffix_labels, section, is_ex, is_wc))
}

///| Detailed Public Suffix List match information for `domain`.
pub fn public_suffix_info(domain : String, include_private : Bool) -> Option[PslMatch] {
  let packed = psl_scan_and_match(domain, include_private)
  if packed == 0 {
    return None
  }
  if packed > 0 {
    let suffix_start = (packed >> 7) & 255
    let eff_len = (packed >> 15) & 255
    let has_upper = (packed >> 27) & 1
    return Some(PslMatch::{
      suffix: psl_extract_slice(domain, suffix_start, eff_len, has_upper),
      section: section_from_code((packed >> 23) & 3),
      is_exception: ((packed >> 25) & 1) != 0,
      is_wildcard: ((packed >> 26) & 1) != 0,
    })
  }
  match match_idn_psl(domain, include_private) {
    None => None
    Some((display, suffix_labels, section, is_ex, is_wc)) => {
      let start = display.length() - suffix_labels
      Some(PslMatch::{
        suffix: join_tail(display, start),
        section: section,
        is_exception: is_ex,
        is_wildcard: is_wc,
      })
    }
  }
}

///| Ultra-lean specialized `include_private = true` single-pass PSL scanner & matcher
///| for `public_suffix`, `registrable_domain`, and `is_public_suffix`.
///| Returns:
///|   `0`  if invalid
///|   `-1` if non-ASCII
///|   `>0` packed `best_start | (eff_len << 8) | (has_upper << 16)`
fn psl_scan_and_match_fast(domain : String) -> Int {
  let n = domain.length()
  if n == 0 {
    return 0
  }
  let first = domain.code_unit_at(0)
  if first == 46 {
    return 0
  }
  let last_raw = domain.code_unit_at(n - 1)
  let eff_len = if last_raw == 46 { n - 1 } else { n }
  if eff_len == 0 {
    return 0
  }
  let last = if last_raw == 46 { domain.code_unit_at(eff_len - 1) } else { last_raw }
  if first == 91 && last == 93 {
    return 0
  }

  let blob = psl_node_data()
  let mut pos = eff_len
  let mut label_start = pos
  let mut has_upper = 0
  let mut nid = 0

  // Fast path: 2-letter lowercase ASCII ccTLD (skip TLD scan & hashing completely!)
  if (eff_len == 2 || (eff_len > 2 && domain.code_unit_at(eff_len - 3) == 46)) &&
  last >= 97 && last <= 122 {
    let c0 = domain.code_unit_at(eff_len - 2)
    if c0 >= 97 && c0 <= 122 {
      label_start = eff_len - 2
      let p = ((c0 - 97) * 26 + (last - 97)) << 1
      nid = (blob.code_unit_at(p) << 7) | blob.code_unit_at(p + 1)
    }
  }

  if label_start == pos {
    let mut h = 5381
    while label_start > 0 {
      let c = domain.code_unit_at(label_start - 1)
      if c >= 97 {
        if c >= 128 {
          return -1
        }
        h = (h * 33) ^ c
      } else if c == 46 {
        break
      } else if c == 58 {
        return 0
      } else if c >= 65 && c <= 90 {
        has_upper = 1
        h = (h * 33) ^ (c + 32)
      } else {
        h = (h * 33) ^ c
      }
      label_start = label_start - 1
    }
    let tld_len = pos - label_start
    if tld_len == 0 || tld_len > 63 {
      let mut rem = label_start
      while rem > 0 {
        rem = rem - 1
        if domain.code_unit_at(rem) >= 128 {
          return -1
        }
      }
      return 0
    }
    let mut cc_checked = false
    if tld_len == 2 {
      let raw0 = domain.code_unit_at(label_start)
      let raw1 = domain.code_unit_at(label_start + 1)
      let c0 = if raw0 >= 65 && raw0 <= 90 { raw0 + 32 } else { raw0 }
      let c1 = if raw1 >= 65 && raw1 <= 90 { raw1 + 32 } else { raw1 }
      if c0 >= 97 && c0 <= 122 && c1 >= 97 && c1 <= 122 {
        cc_checked = true
        let p = ((c0 - 97) * 26 + (c1 - 97)) << 1
        nid = (blob.code_unit_at(p) << 7) | blob.code_unit_at(p + 1)
      }
    }
    if !cc_checked {
      let hm = h & 2147483647
      let mut slot = (hm ^ (hm >> 12)) & 4095
      while true {
        let sp = 1352 + (slot << 1)
        let cand = (blob.code_unit_at(sp) << 7) | blob.code_unit_at(sp + 1)
        if cand == 0 {
          break
        }
        let m = 75080 + (cand << 3)
        if blob.code_unit_at(m + 1) == tld_len {
          let off = (blob.code_unit_at(m + 2) << 14) |
          (blob.code_unit_at(m + 3) << 7) |
          blob.code_unit_at(m + 4)
          let mut eq = true
          if has_upper == 0 {
            let mut k2 = 0
            while k2 < tld_len {
              if domain.code_unit_at(label_start + k2) != blob.code_unit_at(off + k2) {
                eq = false
                break
              }
              k2 = k2 + 1
            }
          } else {
            eq = psl_slice_eq_upper(domain, label_start, tld_len, blob, off)
          }
          if eq {
            nid = cand
            break
          }
        }
        slot = (slot + 1) & 4095
      }
    }
  }

  let mut best_start = label_start
  let mut prev_start = label_start
  pos = if label_start > 0 { label_start - 1 } else { 0 }

  if nid != 0 && pos > 0 {
    let mut cur_flags = blob.code_unit_at(75080 + (nid << 3))
    if (cur_flags & 76) != 0 {
      while pos > 0 {
        let mut ls = pos
        let mut eh = nid * 40503 + 5381
        while ls > 0 {
          let c = domain.code_unit_at(ls - 1)
          if c >= 97 {
            if c >= 128 {
              return -1
            }
            eh = (eh * 33) ^ c
          } else if c == 46 {
            break
          } else if c == 58 {
            return 0
          } else if c >= 65 && c <= 90 {
            has_upper = 1
            eh = (eh * 33) ^ (c + 32)
          } else {
            eh = (eh * 33) ^ c
          }
          ls = ls - 1
        }
        let key_len = pos - ls
        if key_len == 0 || key_len > 63 {
          let mut rem = ls
          while rem > 0 {
            rem = rem - 1
            if domain.code_unit_at(rem) >= 128 {
              return -1
            }
          }
          return 0
        }

        let mut child_id = 0
        if (cur_flags & 64) != 0 {
          let ehm = eh & 2147483647
          let mut slot = (ehm ^ (ehm >> 15)) & 32767
          while true {
            let sp = 9544 + (slot << 1)
            let cand = (blob.code_unit_at(sp) << 7) | blob.code_unit_at(sp + 1)
            if cand == 0 {
              break
            }
            let m = 75080 + (cand << 3)
            if blob.code_unit_at(m + 1) == key_len {
              let pid = (blob.code_unit_at(m + 5) << 7) | blob.code_unit_at(m + 6)
              if pid == nid {
                let off = (blob.code_unit_at(m + 2) << 14) |
                (blob.code_unit_at(m + 3) << 7) |
                blob.code_unit_at(m + 4)
                let mut eq = true
                if has_upper == 0 {
                  let mut k2 = 0
                  while k2 < key_len {
                    if domain.code_unit_at(ls + k2) != blob.code_unit_at(off + k2) {
                      eq = false
                      break
                    }
                    k2 = k2 + 1
                  }
                } else {
                  eq = psl_slice_eq_upper(domain, ls, key_len, blob, off)
                }
                if eq {
                  child_id = cand
                  break
                }
              }
            }
            slot = (slot + 1) & 32767
          }
        }

        if child_id != 0 {
          let cflags = blob.code_unit_at(75080 + (child_id << 3))
          if (cflags & 48) != 0 {
            best_start = prev_start
            pos = if ls > 0 { ls - 1 } else { 0 }
            break
          }
          if (cflags & 3) != 0 || (cur_flags & 12) != 0 {
            best_start = ls
          }
          nid = child_id
          cur_flags = cflags
          prev_start = ls
          pos = if ls > 0 { ls - 1 } else { 0 }
          if (cflags & 76) == 0 {
            break
          }
        } else {
          if (cur_flags & 12) != 0 {
            best_start = ls
          }
          pos = if ls > 0 { ls - 1 } else { 0 }
          break
        }
      }
    }
  }

  // Validate any remaining prefix bytes [0..pos)
  if pos > 0 {
    let mut lbl_len = 0
    let mut r = pos
    while r > 0 {
      r = r - 1
      let c = domain.code_unit_at(r)
      if c >= 97 {
        if c >= 128 {
          return -1
        }
        lbl_len = lbl_len + 1
      } else if c == 46 {
        if lbl_len == 0 || lbl_len > 63 {
          let mut r2 = r
          while r2 > 0 {
            r2 = r2 - 1
            if domain.code_unit_at(r2) >= 128 {
              return -1
            }
          }
          return 0
        }
        lbl_len = 0
      } else if c == 58 {
        return 0
      } else {
        if c >= 65 && c <= 90 {
          has_upper = 1
        }
        lbl_len = lbl_len + 1
      }
    }
    if lbl_len == 0 || lbl_len > 63 {
      return 0
    }
  }

  if eff_len > 253 {
    return 0
  }
  if last >= 48 && last <= 57 && is_ipv4_slice(domain, eff_len) {
    return 0
  }

  best_start | (eff_len << 8) | (has_upper << 16)
}

///| Return the public suffix of `domain` (including Private PSL rules).
pub fn public_suffix(domain : String) -> Option[String] {
  let packed = psl_scan_and_match_fast(domain)
  if packed == 0 {
    return None
  }
  if packed > 0 {
    let suffix_start = packed & 255
    let eff_len = (packed >> 8) & 255
    if (packed & 65536) == 0 {
      if suffix_start == 0 && eff_len == domain.length() {
        return Some(domain)
      }
      return Some(domain.slice(suffix_start, eff_len))
    }
    return Some(psl_extract_slice(domain, suffix_start, eff_len, 1))
  }
  match match_idn_psl(domain, true) {
    None => None
    Some((display, suffix_labels, _, _, _)) => Some(join_tail(display, display.length() - suffix_labels))
  }
}

///| Return the ICANN-only public suffix of `domain`.
pub fn public_suffix_icann(domain : String) -> Option[String] {
  let packed = psl_scan_and_match(domain, false)
  if packed == 0 {
    return None
  }
  if packed > 0 {
    let suffix_start = (packed >> 7) & 255
    let eff_len = (packed >> 15) & 255
    if (packed & 134217728) == 0 {
      if suffix_start == 0 && eff_len == domain.length() {
        return Some(domain)
      }
      return Some(domain.slice(suffix_start, eff_len))
    }
    return Some(psl_extract_slice(domain, suffix_start, eff_len, 1))
  }
  match match_idn_psl(domain, false) {
    None => None
    Some((display, suffix_labels, _, _, _)) => Some(join_tail(display, display.length() - suffix_labels))
  }
}

///| Return the registrable domain (eTLD+1) of `domain` (including Private PSL rules).
pub fn registrable_domain(domain : String) -> Option[String] {
  let packed = psl_scan_and_match_fast(domain)
  if packed == 0 {
    return None
  }
  if packed > 0 {
    let suffix_start = packed & 255
    if suffix_start <= 1 {
      return None
    }
    let mut reg_start = suffix_start - 1
    while reg_start > 0 && domain.code_unit_at(reg_start - 1) != 46 {
      reg_start = reg_start - 1
    }
    let eff_len = (packed >> 8) & 255
    if (packed & 65536) == 0 {
      if reg_start == 0 && eff_len == domain.length() {
        return Some(domain)
      }
      return Some(domain.slice(reg_start, eff_len))
    }
    return Some(psl_extract_slice(domain, reg_start, eff_len, 1))
  }
  match match_idn_psl(domain, true) {
    None => None
    Some((display, suffix_labels, _, _, _)) => {
      let n = display.length()
      if n <= suffix_labels {
        None
      } else {
        Some(join_tail(display, n - suffix_labels - 1))
      }
    }
  }
}

///| Return the ICANN-only registrable domain (eTLD+1) of `domain`.
pub fn registrable_domain_icann(domain : String) -> Option[String] {
  let packed = psl_scan_and_match(domain, false)
  if packed == 0 {
    return None
  }
  if packed > 0 {
    let suffix_start = (packed >> 7) & 255
    if suffix_start <= 1 {
      return None
    }
    let mut reg_start = suffix_start - 1
    while reg_start > 0 && domain.code_unit_at(reg_start - 1) != 46 {
      reg_start = reg_start - 1
    }
    let eff_len = (packed >> 15) & 255
    if (packed & 134217728) == 0 {
      if reg_start == 0 && eff_len == domain.length() {
        return Some(domain)
      }
      return Some(domain.slice(reg_start, eff_len))
    }
    return Some(psl_extract_slice(domain, reg_start, eff_len, 1))
  }
  match match_idn_psl(domain, false) {
    None => None
    Some((display, suffix_labels, _, _, _)) => {
      let n = display.length()
      if n <= suffix_labels {
        None
      } else {
        Some(join_tail(display, n - suffix_labels - 1))
      }
    }
  }
}

///| Return `true` if `domain` itself is a public suffix (ICANN + Private).
pub fn is_public_suffix(domain : String) -> Bool {
  let packed = psl_scan_and_match_fast(domain)
  if packed == 0 {
    return false
  }
  if packed > 0 {
    return (packed & 255) == 0
  }
  match match_idn_psl(domain, true) {
    None => false
    Some((display, suffix_labels, _, _, _)) => display.length() <= suffix_labels
  }
}

///| Return `true` if `domain` itself is an ICANN public suffix.
pub fn is_public_suffix_icann(domain : String) -> Bool {
  let packed = psl_scan_and_match(domain, false)
  if packed == 0 {
    return false
  }
  if packed > 0 {
    return ((packed >> 7) & 255) == 0
  }
  match match_idn_psl(domain, false) {
    None => false
    Some((display, suffix_labels, _, _, _)) => display.length() <= suffix_labels
  }
}
