///| Embedded read-only Mozilla Public Suffix List (PSL) engine with RFC 3492
///| Punycode support, UTS #46 canonicalization, IP literal detection, and
///| O(log N) zero-allocation node-flag lookup.

fn psl_ascii_lower_byte(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

fn is_ip_address_slice(host : String, n : Int) -> Bool {
  if n == 0 {
    return false
  }
  // Bracketed IPv6 or bare IPv6 containing ':'
  if host.code_unit_at(0) == 91 && host.code_unit_at(n - 1) == 93 {
    return true
  }
  let mut i = 0
  while i < n {
    if host.code_unit_at(i) == 58 {
      return true
    }
    i = i + 1
  }
  // Fast exit: IPv4 must end with an ASCII digit
  let last = host.code_unit_at(n - 1)
  if last < 48 || last > 57 {
    return false
  }
  // Strict IPv4 dotted-quad check: 4 octets in 0..255
  let mut parts = 0
  let mut pos = 0
  while pos < n {
    if parts >= 4 {
      return false
    }
    let start = pos
    let mut octet = 0
    let mut digits = 0
    while pos < n && host.code_unit_at(pos) != 46 {
      let c = host.code_unit_at(pos)
      if c < 48 || c > 57 {
        return false
      }
      octet = octet * 10 + (c - 48)
      digits = digits + 1
      if digits > 3 || octet > 255 {
        return false
      }
      pos = pos + 1
    }
    if digits == 0 {
      return false
    }
    if digits > 1 && host.code_unit_at(start) == 48 {
      return false
    }
    parts = parts + 1
    if pos < n {
      pos = pos + 1
      if pos == n {
        return false
      }
    }
  }
  parts == 4
}

///| Check whether `host` is an IPv4 dotted-quad or IPv6 address literal.
pub fn is_ip_address(host : String) -> Bool {
  is_ip_address_slice(host, host.length())
}

///| UTS #46 codepoint folding for common scripts + fullwidth ASCII.
///| Returns `-1` (fail-closed reject) for unmapped compatibility/fullwidth forms.
fn uts46_fold_codepoint(cp : Int) -> Int {
  // ASCII uppercase A..Z
  if cp >= 65 && cp <= 90 {
    return cp + 32
  }
  // Latin-1 Supplement uppercase À..Ö (0xC0..0xD6) and Ø..Þ (0xD8..0xDE)
  if (cp >= 192 && cp <= 214) || (cp >= 216 && cp <= 222) {
    return cp + 32
  }
  // Greek uppercase Α..Ρ (0x0391..0x03A1) and Σ..Ϋ (0x03A3..0x03AB)
  if (cp >= 913 && cp <= 929) || (cp >= 931 && cp <= 939) {
    return cp + 32
  }
  // Cyrillic uppercase А..Я (0x0410..0x042F) and Ѐ..Џ (0x0400..0x040F)
  if cp >= 1040 && cp <= 1071 {
    return cp + 32
  }
  if cp >= 1024 && cp <= 1039 {
    return cp + 80
  }
  // Ideographic / fullwidth / halfwidth label separators -> '.'
  if cp == 12290 || cp == 65294 || cp == 65377 {
    return 46
  }
  // Fullwidth ASCII letters, digits, and hyphen (UTS #46 NFKC + lowercase)
  if cp >= 65313 && cp <= 65338 {
    // ０xFF21..0xFF3A (Ａ..Ｚ) -> a..z
    return cp - 65313 + 97
  }
  if cp >= 65345 && cp <= 65370 {
    // 0xFF41..0xFF5A (ａ..ｚ) -> a..z
    return cp - 65345 + 97
  }
  if cp >= 65296 && cp <= 65305 {
    // 0xFF10..0xFF19 (０..９) -> 0..9
    return cp - 65296 + 48
  }
  if cp == 65293 {
    // 0xFF0D (－) -> '-'
    return 45
  }
  // Fail-closed on other unmapped halfwidth/fullwidth compatibility forms (0xFF00..0xFFEF)
  if cp >= 65280 && cp <= 65519 {
    return -1
  }
  cp
}

fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 128 {
    sb.write_byte(cp.to_byte())
  } else if cp < 2048 {
    sb.write_byte((192 | (cp >> 6)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  } else if cp < 65536 {
    sb.write_byte((224 | (cp >> 12)).to_byte())
    sb.write_byte((128 | ((cp >> 6) & 63)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  } else {
    sb.write_byte((240 | (cp >> 18)).to_byte())
    sb.write_byte((128 | ((cp >> 12) & 63)).to_byte())
    sb.write_byte((128 | ((cp >> 6) & 63)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  }
}

fn read_u24(s : String, byte_off : Int) -> Int {
  let b0 = dec6(s.code_unit_at(byte_off))
  let b1 = dec6(s.code_unit_at(byte_off + 1))
  let b2 = dec6(s.code_unit_at(byte_off + 2))
  let b3 = dec6(s.code_unit_at(byte_off + 3))
  (b0 << 18) | (b1 << 12) | (b2 << 6) | b3
}

///| Binary-search the `unicodedata`-generated sorted range table to reject any
///| non-ASCII code point that is not stable under NFKC + lowercase or is an NFD
///| combining mark (fail-closed UTS #46 guard).
fn is_unicode_noncanonical(cp : Int) -> Bool {
  if cp < 128 {
    return false
  }
  let tbl = unicode_noncanon_ranges()
  let mut lo = 0
  let mut hi = unicode_noncanon_range_count()
  while lo < hi {
    let mid = lo + ((hi - lo) >> 1)
    let off = mid * 8
    let r_lo = read_u24(tbl, off)
    let r_hi = read_u24(tbl, off + 4)
    if cp < r_lo {
      hi = mid
    } else if cp > r_hi {
      lo = mid + 1
    } else {
      return true
    }
  }
  false
}

///| Decode a UTF-8 `String` into Unicode scalar values, applying UTS #46 folding
///| for common scripts/fullwidth ASCII and failing closed (`None`) on any other
///| NFKC/lowercase-unstable code point or NFD combining mark.
fn utf8_decode_and_canonicalize(s : String) -> Option[Array[Int]] {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i) & 255
    if b0 < 128 {
      out.push(psl_ascii_lower_byte(b0))
      i = i + 1
    } else if (b0 & 224) == 192 {
      if i + 1 >= n {
        return None
      }
      let b1 = s.code_unit_at(i + 1) & 255
      if (b1 & 192) != 128 {
        return None
      }
      let cp = ((b0 & 31) << 6) | (b1 & 63)
      if cp < 128 {
        return None
      }
      let folded = uts46_fold_codepoint(cp)
      if folded < 0 || is_unicode_noncanonical(folded) {
        return None
      }
      out.push(folded)
      i = i + 2
    } else if (b0 & 240) == 224 {
      if i + 2 >= n {
        return None
      }
      let b1 = s.code_unit_at(i + 1) & 255
      let b2 = s.code_unit_at(i + 2) & 255
      if (b1 & 192) != 128 || (b2 & 192) != 128 {
        return None
      }
      let cp = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
      if cp < 2048 || (cp >= 55296 && cp <= 57343) {
        return None
      }
      let folded = uts46_fold_codepoint(cp)
      if folded < 0 || is_unicode_noncanonical(folded) {
        return None
      }
      out.push(folded)
      i = i + 3
    } else if (b0 & 248) == 240 {
      if i + 3 >= n {
        return None
      }
      let b1 = s.code_unit_at(i + 1) & 255
      let b2 = s.code_unit_at(i + 2) & 255
      let b3 = s.code_unit_at(i + 3) & 255
      if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128 {
        return None
      }
      let cp = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
      if cp < 65536 || cp > 1114111 {
        return None
      }
      if is_unicode_noncanonical(cp) {
        return None
      }
      out.push(cp)
      i = i + 4
    } else {
      return None
    }
  }
  Some(out)
}

fn punycode_digit(d : Int) -> Int {
  if d < 26 {
    97 + d
  } else {
    48 + (d - 26)
  }
}

fn punycode_adapt(delta_in : Int, num_points : Int, first_time : Bool) -> Int {
  let mut delta = if first_time { delta_in / 700 } else { delta_in / 2 }
  delta = delta + delta / num_points
  let mut k = 0
  while delta > 455 {
    delta = delta / 35
    k = k + 36
  }
  k + (36 * delta) / (delta + 38)
}

///| RFC 3492 Punycode encoder for a single non-ASCII label (prefixed with `xn--`).
///| Bounded to RFC 1035 max 63 ASCII octets.
fn encode_punycode_cps(cps : Array[Int], start : Int, end : Int) -> Option[String] {
  let total = end - start
  if total <= 0 || total > 63 {
    return None
  }
  let out = StringBuilder::new()
  out.write_string("xn--")
  let mut out_len = 4
  let mut b = 0
  let mut i = start
  while i < end {
    let cp = cps[i]
    if cp < 128 {
      out.write_byte(cp.to_byte())
      out_len = out_len + 1
      if out_len > 63 {
        return None
      }
      b = b + 1
    }
    i = i + 1
  }
  let mut h = b
  if b > 0 {
    out.write_byte(45.to_byte())
    out_len = out_len + 1
    if out_len > 63 {
      return None
    }
  }
  let mut n = 128
  let mut delta = 0
  let mut bias = 72
  while h < total {
    let mut m = 2147483647
    let mut j = start
    while j < end {
      let c = cps[j]
      if c >= n && c < m {
        m = c
      }
      j = j + 1
    }
    if m - n > (2147483647 - delta) / (h + 1) {
      return None
    }
    delta = delta + (m - n) * (h + 1)
    n = m
    let mut j2 = start
    while j2 < end {
      let c = cps[j2]
      if c < n {
        delta = delta + 1
        if delta < 0 {
          return None
        }
      } else if c == n {
        let mut q = delta
        let mut k = 36
        while true {
          let t = if k <= bias {
            1
          } else if k >= bias + 26 {
            26
          } else {
            k - bias
          }
          if q < t {
            break
          }
          let digit = t + (q - t) % (36 - t)
          out.write_byte(punycode_digit(digit).to_byte())
          out_len = out_len + 1
          if out_len > 63 {
            return None
          }
          q = (q - t) / (36 - t)
          k = k + 36
        }
        out.write_byte(punycode_digit(q).to_byte())
        out_len = out_len + 1
        if out_len > 63 {
          return None
        }
        bias = punycode_adapt(delta, h + 1, h == b)
        delta = 0
        h = h + 1
      }
      j2 = j2 + 1
    }
    delta = delta + 1
    n = n + 1
  }
  Some(out.to_string())
}

///| Binary search `key` in the sorted `\n`-delimited `psl_table()`.
///| Returns `0` if not found, `1` if ICANN, `2` if Private.
fn psl_lookup_raw(key : String) -> Int {
  let tbl = psl_table()
  let len = tbl.length()
  let key_len = key.length()
  let mut lo = 1
  let mut hi = len - 1
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let mut line_start = mid
    while line_start > 0 && tbl.code_unit_at(line_start - 1) != 10 {
      line_start = line_start - 1
    }
    if line_start >= len - 1 {
      break
    }
    let mut line_end = mid
    while line_end < len && tbl.code_unit_at(line_end) != 10 {
      line_end = line_end + 1
    }
    // Line format: "<rule>\t<I|P>"
    let rule_end = line_end - 2
    if rule_end < line_start {
      break
    }
    let rule_len = rule_end - line_start
    let min_len = if key_len < rule_len { key_len } else { rule_len }
    let mut cmp = 0
    let mut k = 0
    while k < min_len {
      let a = key.code_unit_at(k) & 255
      let b = tbl.code_unit_at(line_start + k) & 255
      if a != b {
        cmp = if a < b { -1 } else { 1 }
        break
      }
      k = k + 1
    }
    if cmp == 0 {
      if key_len == rule_len {
        let tag = tbl.code_unit_at(line_end - 1)
        return if tag == 73 { 1 } else { 2 }
      }
      cmp = if key_len < rule_len { -1 } else { 1 }
    }
    if cmp < 0 {
      if line_start <= lo {
        break
      }
      hi = line_start - 1
    } else {
      lo = line_end + 1
    }
  }
  0
}

fn psl_lookup(key : String, include_private : Bool) -> Int {
  let r = psl_lookup_raw(key)
  if r == 2 && !include_private {
    0
  } else {
    r
  }
}

fn dec6(c : Int) -> Int {
  if c > 92 {
    c - 49
  } else {
    c - 48
  }
}

fn read_u18(s : String, idx : Int) -> Int {
  let p = idx * 3
  let b0 = dec6(s.code_unit_at(p))
  let b1 = dec6(s.code_unit_at(p + 1))
  let b2 = dec6(s.code_unit_at(p + 2))
  (b0 << 12) | (b1 << 6) | b2
}

///| O(log N) zero-allocation lookup of `s[key_start..key_end)` in the compact
///| node-flag index (`psl_index.pion`). Returns `-1` if not found, or the 6-bit
///| node flag mask (`0..63`) if found.
fn psl_node_lookup_slice(s : String, key_start : Int, key_end : Int) -> Int {
  let key_len = key_end - key_start
  if key_len <= 0 {
    return -1
  }
  let first = s.code_unit_at(key_start) & 255
  if first >= 128 {
    return -1
  }
  let bkts = psl_node_buckets()
  let mut lo = read_u18(bkts, first)
  let mut hi = read_u18(bkts, first + 1)
  if lo >= hi {
    return -1
  }
  let data = psl_node_data()
  let offs = psl_node_offsets()
  while lo < hi {
    let mid = lo + ((hi - lo) >> 1)
    let entry_start = read_u18(offs, mid)
    let entry_end = read_u18(offs, mid + 1)
    let node_len = entry_end - entry_start - 1
    let min_len = if key_len < node_len { key_len } else { node_len }
    let mut cmp = 0
    let mut k = 0
    while k < min_len {
      let a = s.code_unit_at(key_start + k) & 255
      let b = data.code_unit_at(entry_start + k) & 255
      if a != b {
        cmp = if a < b { -1 } else { 1 }
        break
      }
      k = k + 1
    }
    if cmp == 0 {
      if key_len == node_len {
        return dec6(data.code_unit_at(entry_end - 1))
      }
      cmp = if key_len < node_len { -1 } else { 1 }
    }
    if cmp < 0 {
      hi = mid
    } else {
      lo = mid + 1
    }
  }
  -1
}

fn section_from_code(code : Int) -> PslSection {
  if code == 1 {
    PslSection::Icann
  } else if code == 2 {
    PslSection::Private
  } else {
    PslSection::Unlisted
  }
}

///| Match an already-validated lowercase ASCII/Punycode domain `asc[0..asc_len)`
///| using the compact node-flag table.
///| Returns `(suffix_label_count, total_labels, suffix_byte_start, reg_byte_start, section, is_exception, is_wildcard)`.
fn match_ascii_psl(
  asc : String,
  asc_len : Int,
  include_private : Bool,
) -> (Int, Int, Int, Int, PslSection, Bool, Bool) {
  let mut best_labels = 1
  let mut best_section = PslSection::Unlisted
  let mut best_exception = false
  let mut best_wildcard = false
  let mut best_start = 0

  let mut prev_flags = 0
  let mut prev_start = asc_len
  let mut k = 0
  let mut pos = asc_len
  let mut stopped = false

  // Walk labels right-to-left without allocating
  while pos > 0 {
    let mut label_start = pos
    while label_start > 0 && asc.code_unit_at(label_start - 1) != 46 {
      label_start = label_start - 1
    }
    k = k + 1
    if k == 1 {
      best_start = label_start
    }

    if !stopped {
      // 1. Check exception rule if previous node has HAS_EXCEPTION_CHILD (0x20)
      if k >= 2 && (prev_flags & 32) != 0 {
        let ex_code = psl_lookup("!" + asc.slice(label_start, asc_len), include_private)
        if ex_code != 0 {
          best_labels = k - 1
          best_start = prev_start
          best_section = section_from_code(ex_code)
          best_exception = true
          best_wildcard = false
          stopped = true
        }
      }

      if !stopped {
        // Check if previous node has matching wildcard rule (*.prev_suffix)
        let prev_wild_code = if k >= 2 {
          if (prev_flags & 4) != 0 {
            1
          } else if include_private && (prev_flags & 8) != 0 {
            2
          } else {
            0
          }
        } else {
          0
        }

        // Only probe node table if k == 1 or previous node has HAS_CHILDREN (0x10)
        let cur_flags = if k == 1 || (prev_flags & 16) != 0 {
          psl_node_lookup_slice(asc, label_start, asc_len)
        } else {
          -1
        }

        if cur_flags >= 0 {
          let exact_code = if (cur_flags & 1) != 0 {
            1
          } else if include_private && (cur_flags & 2) != 0 {
            2
          } else {
            0
          }
          if exact_code != 0 {
            best_labels = k
            best_start = label_start
            best_section = section_from_code(exact_code)
            best_exception = false
            best_wildcard = false
          } else if prev_wild_code != 0 {
            best_labels = k
            best_start = label_start
            best_section = section_from_code(prev_wild_code)
            best_exception = false
            best_wildcard = true
          }
          prev_flags = cur_flags
          if (cur_flags & 60) == 0 {
            // No wildcard, no children, no exception child
            stopped = true
          }
        } else {
          if prev_wild_code != 0 {
            best_labels = k
            best_start = label_start
            best_section = section_from_code(prev_wild_code)
            best_exception = false
            best_wildcard = true
          }
          stopped = true
        }
      }
    }

    prev_start = label_start
    pos = if label_start > 0 { label_start - 1 } else { 0 }
  }

  // Compute reg_byte_start (one label left of best_start, or -1 if none)
  let mut reg_start = -1
  if k > best_labels && best_start > 1 {
    let mut p = best_start - 1
    while p > 0 && asc.code_unit_at(p - 1) != 46 {
      p = p - 1
    }
    reg_start = p
  }

  (best_labels, k, best_start, reg_start, best_section, best_exception, best_wildcard)
}

///| Fast-path ASCII domain check + lowercase normalization.
///| Returns `0` if invalid, `1` if valid ASCII (with `lowered` string and `eff_len`),
///| `2` if non-ASCII (caller must use IDN path).
fn ascii_fast_prepare(domain : String) -> (Int, String, Int) {
  let n = domain.length()
  if n == 0 {
    return (0, "", 0)
  }
  if domain.code_unit_at(0) == 46 {
    return (0, "", 0)
  }
  let eff_len = if domain.code_unit_at(n - 1) == 46 { n - 1 } else { n }
  if eff_len == 0 {
    return (0, "", 0)
  }
  // Quick scan for ASCII, uppercase, empty labels, and RFC 1035 length limits
  let mut has_upper = false
  let mut has_non_ascii = false
  let mut label_len = 0
  let mut i = 0
  while i < eff_len {
    let c = domain.code_unit_at(i) & 255
    if c >= 128 {
      has_non_ascii = true
      break
    }
    if c == 46 {
      if label_len == 0 || label_len > 63 {
        return (0, "", 0)
      }
      label_len = 0
    } else {
      if c >= 65 && c <= 90 {
        has_upper = true
      }
      label_len = label_len + 1
    }
    i = i + 1
  }
  if has_non_ascii {
    return (2, domain, n)
  }
  if eff_len > 253 || label_len == 0 || label_len > 63 {
    return (0, "", 0)
  }
  if is_ip_address_slice(domain, eff_len) {
    return (0, "", 0)
  }
  if !has_upper {
    return (1, domain, eff_len)
  }
  let out = Bytes::new(eff_len)
  let mut j = 0
  while j < eff_len {
    let c = domain.code_unit_at(j) & 255
    out[j] = (if c >= 65 && c <= 90 { c + 32 } else { c }).to_byte()
    j = j + 1
  }
  (1, out.to_string(), eff_len)
}

fn join_tail(labels : Array[String], from_idx : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = from_idx
  while i < labels.length() {
    if i > from_idx {
      sb.write_string(".")
    }
    sb.write_string(labels[i])
    i = i + 1
  }
  sb.to_string()
}

///| IDN / UTS #46 slow path: decodes UTF-8, maps ideographic dots and Latin-1 uppercase,
///| Punycode-encodes non-ASCII labels, enforces RFC 1035 limits, and matches PSL.
fn match_idn_psl(
  domain : String,
  include_private : Bool,
) -> Option[(Array[String], Int, PslSection, Bool, Bool)] {
  // Reject huge inputs before decoding (RFC 1035: <= 253 octets)
  if domain.length() > 254 {
    return None
  }
  let cps = match utf8_decode_and_canonicalize(domain) {
    Some(v) => v
    None => return None
  }
  let n = cps.length()
  if n == 0 || cps[0] == 46 {
    return None
  }
  let eff_len = if cps[n - 1] == 46 { n - 1 } else { n }
  if eff_len == 0 {
    return None
  }
  // Rebuild canonical UTF-8 string to check byte length <= 253 and IP literal
  let full_sb = StringBuilder::new()
  let mut idx = 0
  while idx < eff_len {
    write_utf8_cp(full_sb, cps[idx])
    idx = idx + 1
  }
  let canon = full_sb.to_string()
  if canon.length() > 253 || is_ip_address_slice(canon, canon.length()) {
    return None
  }

  let display : Array[String] = []
  let asc_sb = StringBuilder::new()
  let mut asc_total = 0
  let mut start = 0
  let mut i = 0
  while i <= eff_len {
    if i == eff_len || cps[i] == 46 {
      if i == start {
        return None
      }
      let lab_sb = StringBuilder::new()
      let mut is_asc = true
      let mut k = start
      while k < i {
        let cp = cps[k]
        if cp >= 128 {
          is_asc = false
        }
        write_utf8_cp(lab_sb, cp)
        k = k + 1
      }
      let disp_lab = lab_sb.to_string()
      display.push(disp_lab)
      let asc_lab = if is_asc {
        if disp_lab.length() > 63 {
          return None
        }
        disp_lab
      } else {
        match encode_punycode_cps(cps, start, i) {
          Some(p) => p
          None => return None
        }
      }
      if asc_total > 0 {
        asc_sb.write_byte(46.to_byte())
        asc_total = asc_total + 1
      }
      asc_sb.write_string(asc_lab)
      asc_total = asc_total + asc_lab.length()
      if asc_total > 253 {
        return None
      }
      start = i + 1
    }
    i = i + 1
  }
  let asc_str = asc_sb.to_string()
  let (suffix_labels, _, _, _, section, is_ex, is_wc) = match_ascii_psl(
    asc_str,
    asc_str.length(),
    include_private,
  )
  Some((display, suffix_labels, section, is_ex, is_wc))
}

///| Detailed Public Suffix List match information for `domain`.
pub fn public_suffix_info(domain : String, include_private : Bool) -> Option[PslMatch] {
  let (kind, s, eff_len) = ascii_fast_prepare(domain)
  if kind == 0 {
    return None
  }
  if kind == 1 {
    let (_, _, suffix_start, _, section, is_ex, is_wc) = match_ascii_psl(s, eff_len, include_private)
    return Some(PslMatch::{
      suffix: s.slice(suffix_start, eff_len),
      section: section,
      is_exception: is_ex,
      is_wildcard: is_wc,
    })
  }
  match match_idn_psl(domain, include_private) {
    None => None
    Some((display, suffix_labels, section, is_ex, is_wc)) => {
      let start = display.length() - suffix_labels
      Some(PslMatch::{
        suffix: join_tail(display, start),
        section: section,
        is_exception: is_ex,
        is_wildcard: is_wc,
      })
    }
  }
}

///| Return the public suffix of `domain` (including Private PSL rules).
pub fn public_suffix(domain : String) -> Option[String] {
  let (kind, s, eff_len) = ascii_fast_prepare(domain)
  if kind == 0 {
    return None
  }
  if kind == 1 {
    let (_, _, suffix_start, _, _, _, _) = match_ascii_psl(s, eff_len, true)
    return Some(s.slice(suffix_start, eff_len))
  }
  match match_idn_psl(domain, true) {
    None => None
    Some((display, suffix_labels, _, _, _)) => Some(join_tail(display, display.length() - suffix_labels))
  }
}

///| Return the ICANN-only public suffix of `domain`.
pub fn public_suffix_icann(domain : String) -> Option[String] {
  let (kind, s, eff_len) = ascii_fast_prepare(domain)
  if kind == 0 {
    return None
  }
  if kind == 1 {
    let (_, _, suffix_start, _, _, _, _) = match_ascii_psl(s, eff_len, false)
    return Some(s.slice(suffix_start, eff_len))
  }
  match match_idn_psl(domain, false) {
    None => None
    Some((display, suffix_labels, _, _, _)) => Some(join_tail(display, display.length() - suffix_labels))
  }
}

///| Return the registrable domain (eTLD+1) of `domain` (including Private PSL rules).
pub fn registrable_domain(domain : String) -> Option[String] {
  let (kind, s, eff_len) = ascii_fast_prepare(domain)
  if kind == 0 {
    return None
  }
  if kind == 1 {
    let (_, _, _, reg_start, _, _, _) = match_ascii_psl(s, eff_len, true)
    if reg_start < 0 {
      return None
    }
    return Some(s.slice(reg_start, eff_len))
  }
  match match_idn_psl(domain, true) {
    None => None
    Some((display, suffix_labels, _, _, _)) => {
      let n = display.length()
      if n <= suffix_labels {
        None
      } else {
        Some(join_tail(display, n - suffix_labels - 1))
      }
    }
  }
}

///| Return the ICANN-only registrable domain (eTLD+1) of `domain`.
pub fn registrable_domain_icann(domain : String) -> Option[String] {
  let (kind, s, eff_len) = ascii_fast_prepare(domain)
  if kind == 0 {
    return None
  }
  if kind == 1 {
    let (_, _, _, reg_start, _, _, _) = match_ascii_psl(s, eff_len, false)
    if reg_start < 0 {
      return None
    }
    return Some(s.slice(reg_start, eff_len))
  }
  match match_idn_psl(domain, false) {
    None => None
    Some((display, suffix_labels, _, _, _)) => {
      let n = display.length()
      if n <= suffix_labels {
        None
      } else {
        Some(join_tail(display, n - suffix_labels - 1))
      }
    }
  }
}

///| Return `true` if `domain` itself is a public suffix (ICANN + Private).
pub fn is_public_suffix(domain : String) -> Bool {
  let (kind, s, eff_len) = ascii_fast_prepare(domain)
  if kind == 0 {
    return false
  }
  if kind == 1 {
    let (suffix_labels, total_labels, _, _, _, _, _) = match_ascii_psl(s, eff_len, true)
    return total_labels <= suffix_labels
  }
  match match_idn_psl(domain, true) {
    None => false
    Some((display, suffix_labels, _, _, _)) => display.length() <= suffix_labels
  }
}

///| Return `true` if `domain` itself is an ICANN public suffix.
pub fn is_public_suffix_icann(domain : String) -> Bool {
  let (kind, s, eff_len) = ascii_fast_prepare(domain)
  if kind == 0 {
    return false
  }
  if kind == 1 {
    let (suffix_labels, total_labels, _, _, _, _, _) = match_ascii_psl(s, eff_len, false)
    return total_labels <= suffix_labels
  }
  match match_idn_psl(domain, false) {
    None => false
    Some((display, suffix_labels, _, _, _)) => display.length() <= suffix_labels
  }
}
