///| Embedded read-only Mozilla Public Suffix List (PSL) engine with RFC 3492
///| Punycode support, IP literal detection, and O(log N) zero-allocation lookup.

fn psl_ascii_lower_byte(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

///| Check whether `host` is an IPv4 dotted-quad or IPv6 address literal.
pub fn is_ip_address(host : String) -> Bool {
  let n = host.length()
  if n == 0 {
    return false
  }
  // Bracketed IPv6 or bare IPv6 containing ':'
  if host.code_unit_at(0) == 91 && host.code_unit_at(n - 1) == 93 {
    return true
  }
  let mut i = 0
  while i < n {
    if host.code_unit_at(i) == 58 {
      return true
    }
    i = i + 1
  }
  // Strict IPv4 dotted-quad check: 4 octets in 0..255
  let mut parts = 0
  let mut pos = 0
  while pos < n {
    if parts >= 4 {
      return false
    }
    let start = pos
    let mut octet = 0
    let mut digits = 0
    while pos < n && host.code_unit_at(pos) != 46 {
      let c = host.code_unit_at(pos)
      if c < 48 || c > 57 {
        return false
      }
      octet = octet * 10 + (c - 48)
      digits = digits + 1
      if digits > 3 || octet > 255 {
        return false
      }
      pos = pos + 1
    }
    if digits == 0 {
      return false
    }
    if digits > 1 && host.code_unit_at(start) == 48 {
      return false
    }
    parts = parts + 1
    if pos < n {
      pos = pos + 1
      if pos == n {
        return false
      }
    }
  }
  parts == 4
}

///| Decode a UTF-8 `String` label into Unicode scalar values.
fn utf8_to_codepoints(s : String) -> Option[Array[Int]] {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i) & 255
    if b0 < 128 {
      out.push(psl_ascii_lower_byte(b0))
      i = i + 1
    } else if (b0 & 224) == 192 {
      if i + 1 >= n {
        return None
      }
      let b1 = s.code_unit_at(i + 1) & 255
      if (b1 & 192) != 128 {
        return None
      }
      let cp = ((b0 & 31) << 6) | (b1 & 63)
      if cp < 128 {
        return None
      }
      out.push(cp)
      i = i + 2
    } else if (b0 & 240) == 224 {
      if i + 2 >= n {
        return None
      }
      let b1 = s.code_unit_at(i + 1) & 255
      let b2 = s.code_unit_at(i + 2) & 255
      if (b1 & 192) != 128 || (b2 & 192) != 128 {
        return None
      }
      let cp = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
      if cp < 2048 || (cp >= 55296 && cp <= 57343) {
        return None
      }
      out.push(cp)
      i = i + 3
    } else if (b0 & 248) == 240 {
      if i + 3 >= n {
        return None
      }
      let b1 = s.code_unit_at(i + 1) & 255
      let b2 = s.code_unit_at(i + 2) & 255
      let b3 = s.code_unit_at(i + 3) & 255
      if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128 {
        return None
      }
      let cp = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
      if cp < 65536 || cp > 1114111 {
        return None
      }
      out.push(cp)
      i = i + 4
    } else {
      return None
    }
  }
  Some(out)
}

fn punycode_digit(d : Int) -> Int {
  if d < 26 {
    97 + d
  } else {
    48 + (d - 26)
  }
}

fn punycode_adapt(delta_in : Int, num_points : Int, first_time : Bool) -> Int {
  let mut delta = if first_time { delta_in / 700 } else { delta_in / 2 }
  delta = delta + delta / num_points
  let mut k = 0
  while delta > 455 {
    delta = delta / 35
    k = k + 36
  }
  k + (36 * delta) / (delta + 38)
}

///| RFC 3492 Punycode encoder for a single non-ASCII label (prefixed with `xn--`).
fn encode_punycode_label(label : String) -> Option[String] {
  let cps = match utf8_to_codepoints(label) {
    Some(v) => v
    None => return None
  }
  let out = StringBuilder::new()
  out.write_string("xn--")
  let mut b = 0
  let mut i = 0
  while i < cps.length() {
    let cp = cps[i]
    if cp < 128 {
      let ch = Bytes::new(1)
      ch[0] = cp.to_byte()
      out.write_string(ch.to_string())
      b = b + 1
    }
    i = i + 1
  }
  let mut h = b
  if b > 0 {
    out.write_string("-")
  }
  let mut n = 128
  let mut delta = 0
  let mut bias = 72
  let total = cps.length()
  while h < total {
    let mut m = 2147483647
    let mut j = 0
    while j < total {
      let c = cps[j]
      if c >= n && c < m {
        m = c
      }
      j = j + 1
    }
    if m - n > (2147483647 - delta) / (h + 1) {
      return None
    }
    delta = delta + (m - n) * (h + 1)
    n = m
    let mut j2 = 0
    while j2 < total {
      let c = cps[j2]
      if c < n {
        delta = delta + 1
        if delta < 0 {
          return None
        }
      } else if c == n {
        let mut q = delta
        let mut k = 36
        while true {
          let t = if k <= bias {
            1
          } else if k >= bias + 26 {
            26
          } else {
            k - bias
          }
          if q < t {
            break
          }
          let digit = t + (q - t) % (36 - t)
          let ch = Bytes::new(1)
          ch[0] = punycode_digit(digit).to_byte()
          out.write_string(ch.to_string())
          q = (q - t) / (36 - t)
          k = k + 36
        }
        let ch = Bytes::new(1)
        ch[0] = punycode_digit(q).to_byte()
        out.write_string(ch.to_string())
        bias = punycode_adapt(delta, h + 1, h == b)
        delta = 0
        h = h + 1
      }
      j2 = j2 + 1
    }
    delta = delta + 1
    n = n + 1
  }
  Some(out.to_string())
}

fn label_lower_ascii_only(label : String) -> (String, Bool) {
  let n = label.length()
  let mut is_ascii = true
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = label.code_unit_at(i) & 255
    if c >= 128 {
      is_ascii = false
    } else if c >= 65 && c <= 90 {
      has_upper = true
    }
    i = i + 1
  }
  if !has_upper {
    return (label, is_ascii)
  }
  let out = Bytes::new(n)
  let mut j = 0
  while j < n {
    let c = label.code_unit_at(j) & 255
    out[j] = (if c >= 65 && c <= 90 { c + 32 } else { c }).to_byte()
    j = j + 1
  }
  (out.to_string(), is_ascii)
}

///| Binary search `key` in the sorted `\n`-delimited `psl_table()`.
///| Returns `0` if not found, `1` if ICANN, `2` if Private.
fn psl_lookup_raw(key : String) -> Int {
  let tbl = psl_table()
  let len = tbl.length()
  let key_len = key.length()
  let mut lo = 1
  let mut hi = len - 1
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let mut line_start = mid
    while line_start > 0 && tbl.code_unit_at(line_start - 1) != 10 {
      line_start = line_start - 1
    }
    if line_start >= len - 1 {
      break
    }
    let mut line_end = mid
    while line_end < len && tbl.code_unit_at(line_end) != 10 {
      line_end = line_end + 1
    }
    // Line format: "<rule>\t<I|P>"
    let rule_end = line_end - 2
    if rule_end < line_start {
      break
    }
    let rule_len = rule_end - line_start
    let min_len = if key_len < rule_len { key_len } else { rule_len }
    let mut cmp = 0
    let mut k = 0
    while k < min_len {
      let a = key.code_unit_at(k) & 255
      let b = tbl.code_unit_at(line_start + k) & 255
      if a != b {
        cmp = if a < b { -1 } else { 1 }
        break
      }
      k = k + 1
    }
    if cmp == 0 {
      if key_len == rule_len {
        let tag = tbl.code_unit_at(line_end - 1)
        return if tag == 73 { 1 } else { 2 }
      }
      cmp = if key_len < rule_len { -1 } else { 1 }
    }
    if cmp < 0 {
      if line_start <= lo {
        break
      }
      hi = line_start - 1
    } else {
      lo = line_end + 1
    }
  }
  0
}

fn psl_lookup(key : String, include_private : Bool) -> Int {
  let r = psl_lookup_raw(key)
  if r == 2 && !include_private {
    0
  } else {
    r
  }
}

fn join_tail(labels : Array[String], from_idx : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = from_idx
  while i < labels.length() {
    if i > from_idx {
      sb.write_string(".")
    }
    sb.write_string(labels[i])
    i = i + 1
  }
  sb.to_string()
}

fn split_and_normalize_labels(domain : String) -> Option[(Array[String], Array[String])] {
  let n = domain.length()
  if n == 0 {
    return None
  }
  // Leading dot is invalid per Mozilla PSL spec
  if domain.code_unit_at(0) == 46 {
    return None
  }
  // Strip single trailing dot if present
  let eff_len = if domain.code_unit_at(n - 1) == 46 { n - 1 } else { n }
  if eff_len == 0 {
    return None
  }
  if is_ip_address(domain) {
    return None
  }

  let display : Array[String] = []
  let ascii : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i <= eff_len {
    if i == eff_len || domain.code_unit_at(i) == 46 {
      if i == start {
        // Empty label (e.g. "a..b")
        return None
      }
      let raw = domain.slice(start, i)
      let (lowered, is_asc) = label_lower_ascii_only(raw)
      display.push(lowered)
      if is_asc {
        ascii.push(lowered)
      } else {
        match encode_punycode_label(lowered) {
          Some(puny) => ascii.push(puny)
          None => return None
        }
      }
      start = i + 1
    }
    i = i + 1
  }
  Some((display, ascii))
}

fn section_from_code(code : Int) -> PslSection {
  if code == 1 {
    PslSection::Icann
  } else if code == 2 {
    PslSection::Private
  } else {
    PslSection::Unlisted
  }
}

fn match_psl_internal(
  domain : String,
  include_private : Bool,
) -> Option[(Array[String], Int, PslSection, Bool, Bool)] {
  let (display, ascii) = match split_and_normalize_labels(domain) {
    Some(v) => v
    None => return None
  }
  let n = ascii.length()
  // Prevailing rule: exception rule beats everything; otherwise longest match wins.
  // Default implicit rule is "*" (1 label, Unlisted).
  let mut best_labels = 1
  let mut best_section = PslSection::Unlisted
  let mut best_exception = false
  let mut best_wildcard = false

  // Build suffix strings from right to left and probe exact, wildcard, exception
  let mut suffix = ""
  let mut k = 1
  while k <= n {
    let idx = n - k
    let prev_suffix = suffix
    suffix = if k == 1 { ascii[idx] } else { ascii[idx] + "." + suffix }

    // 1. Exception rule "!suffix" (highest precedence)
    let ex_code = psl_lookup("!" + suffix, include_private)
    if ex_code != 0 {
      best_labels = k - 1
      best_section = section_from_code(ex_code)
      best_exception = true
      best_wildcard = false
      // Exception rules always take priority over all other rules
      return Some((display, best_labels, best_section, best_exception, best_wildcard))
    }

    // 2. Exact rule "suffix"
    let exact_code = psl_lookup(suffix, include_private)
    if exact_code != 0 {
      best_labels = k
      best_section = section_from_code(exact_code)
      best_exception = false
      best_wildcard = false
    }

    // 3. Wildcard rule "*.prev_suffix" (matches k labels)
    if k >= 2 {
      let wild_code = psl_lookup("*." + prev_suffix, include_private)
      if wild_code != 0 && k > best_labels {
        best_labels = k
        best_section = section_from_code(wild_code)
        best_exception = false
        best_wildcard = true
      } else if wild_code != 0 && exact_code == 0 {
        best_labels = k
        best_section = section_from_code(wild_code)
        best_exception = false
        best_wildcard = true
      }
    }
    k = k + 1
  }

  Some((display, best_labels, best_section, best_exception, best_wildcard))
}

///| Detailed Public Suffix List match information for `domain`.
pub fn public_suffix_info(domain : String, include_private : Bool) -> Option[PslMatch] {
  match match_psl_internal(domain, include_private) {
    None => None
    Some((display, suffix_labels, section, is_ex, is_wc)) => {
      let start = display.length() - suffix_labels
      Some(PslMatch::{
        suffix: join_tail(display, start),
        section: section,
        is_exception: is_ex,
        is_wildcard: is_wc,
      })
    }
  }
}

///| Return the public suffix of `domain` (including Private PSL rules).
pub fn public_suffix(domain : String) -> Option[String] {
  match public_suffix_info(domain, true) {
    Some(m) => Some(m.suffix)
    None => None
  }
}

///| Return the ICANN-only public suffix of `domain`.
pub fn public_suffix_icann(domain : String) -> Option[String] {
  match public_suffix_info(domain, false) {
    Some(m) => Some(m.suffix)
    None => None
  }
}

///| Return the registrable domain (eTLD+1) of `domain` (including Private PSL rules).
pub fn registrable_domain(domain : String) -> Option[String] {
  match match_psl_internal(domain, true) {
    None => None
    Some((display, suffix_labels, _, _, _)) => {
      let n = display.length()
      if n <= suffix_labels {
        None
      } else {
        Some(join_tail(display, n - suffix_labels - 1))
      }
    }
  }
}

///| Return the ICANN-only registrable domain (eTLD+1) of `domain`.
pub fn registrable_domain_icann(domain : String) -> Option[String] {
  match match_psl_internal(domain, false) {
    None => None
    Some((display, suffix_labels, _, _, _)) => {
      let n = display.length()
      if n <= suffix_labels {
        None
      } else {
        Some(join_tail(display, n - suffix_labels - 1))
      }
    }
  }
}

///| Return `true` if `domain` itself is a public suffix (ICANN + Private).
pub fn is_public_suffix(domain : String) -> Bool {
  match match_psl_internal(domain, true) {
    None => false
    Some((display, suffix_labels, _, _, _)) => display.length() <= suffix_labels
  }
}

///| Return `true` if `domain` itself is an ICANN public suffix.
pub fn is_public_suffix_icann(domain : String) -> Bool {
  match match_psl_internal(domain, false) {
    None => false
    Some((display, suffix_labels, _, _, _)) => display.length() <= suffix_labels
  }
}
