///| RFC 6265 §5.1.1 cookie-date parser and canonical IMF-fixdate formatter.
///| Pure Int64 O(1) civil calendar arithmetic (Howard Hinnant algorithm).

fn is_date_delimiter(c : Int) -> Bool {
  c == 9 ||
  (c >= 32 && c <= 47) ||
  (c >= 59 && c <= 64) ||
  (c >= 91 && c <= 96) ||
  (c >= 123 && c <= 126)
}

fn date_is_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn date_ascii_lower(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

fn date_is_leap_year(year : Int) -> Bool {
  (year % 4 == 0) && ((year % 100 != 0) || (year % 400 == 0))
}

fn date_days_in_month(year : Int, month : Int) -> Int {
  if month == 2 {
    if date_is_leap_year(year) { 29 } else { 28 }
  } else if month == 4 || month == 6 || month == 9 || month == 11 {
    30
  } else {
    31
  }
}

///| Howard Hinnant's O(1) days since 1970-01-01.
fn days_from_civil(year : Int, month : Int, day : Int) -> Int64 {
  let y = if month <= 2 { year.to_int64() - 1L } else { year.to_int64() }
  let era = if y >= 0L { y / 400L } else { (y - 399L) / 400L }
  let yoe = y - era * 400L
  let m = month.to_int64()
  let d = day.to_int64()
  let mp = if m > 2L { m - 3L } else { m + 9L }
  let doy = (153L * mp + 2L) / 5L + d - 1L
  let doe = yoe * 365L + yoe / 4L - yoe / 100L + doy
  era * 146097L + doe - 719468L
}

fn try_parse_time_packed(s : String, start : Int, end : Int) -> Int {
  let mut p = start
  let mut h = 0
  let mut hd = 0
  while p < end && hd < 2 {
    let c = s.code_unit_at(p)
    if c < 48 || c > 57 {
      break
    }
    h = h * 10 + (c - 48)
    p = p + 1
    hd = hd + 1
  }
  if hd == 0 || p >= end || s.code_unit_at(p) != 58 {
    return -1
  }
  p = p + 1
  let mut m = 0
  let mut md = 0
  while p < end && md < 2 {
    let c = s.code_unit_at(p)
    if c < 48 || c > 57 {
      break
    }
    m = m * 10 + (c - 48)
    p = p + 1
    md = md + 1
  }
  if md == 0 || p >= end || s.code_unit_at(p) != 58 {
    return -1
  }
  p = p + 1
  let mut sec = 0
  let mut sd = 0
  while p < end && sd < 2 {
    let c = s.code_unit_at(p)
    if c < 48 || c > 57 {
      break
    }
    sec = sec * 10 + (c - 48)
    p = p + 1
    sd = sd + 1
  }
  if sd == 0 {
    return -1
  }
  if p < end && date_is_digit(s.code_unit_at(p)) {
    return -1
  }
  (h << 16) | (m << 8) | sec
}

fn try_parse_digits_unboxed(s : String, start : Int, end : Int, min_d : Int, max_d : Int) -> Int {
  let mut p = start
  let mut v = 0
  let mut count = 0
  while p < end && count < max_d {
    let c = s.code_unit_at(p)
    if c < 48 || c > 57 {
      break
    }
    v = v * 10 + (c - 48)
    p = p + 1
    count = count + 1
  }
  if count < min_d {
    return -1
  }
  if p < end && date_is_digit(s.code_unit_at(p)) {
    return -1
  }
  v
}

fn try_parse_month_unboxed(s : String, start : Int, end : Int) -> Int {
  if end - start < 3 {
    return 0
  }
  let c0 = date_ascii_lower(s.code_unit_at(start))
  let c1 = date_ascii_lower(s.code_unit_at(start + 1))
  let c2 = date_ascii_lower(s.code_unit_at(start + 2))
  if c0 == 106 {
    if c1 == 97 && c2 == 110 {
      return 1 // jan
    }
    if c1 == 117 {
      if c2 == 110 {
        return 6 // jun
      }
      if c2 == 108 {
        return 7 // jul
      }
    }
    return 0
  }
  if c0 == 109 {
    if c1 == 97 {
      if c2 == 114 {
        return 3 // mar
      }
      if c2 == 121 {
        return 5 // may
      }
    }
    return 0
  }
  if c0 == 97 {
    if c1 == 112 && c2 == 114 {
      return 4 // apr
    }
    if c1 == 117 && c2 == 103 {
      return 8 // aug
    }
    return 0
  }
  if c0 == 102 {
    return if c1 == 101 && c2 == 98 { 2 } else { 0 } // feb
  }
  if c0 == 115 {
    return if c1 == 101 && c2 == 112 { 9 } else { 0 } // sep
  }
  if c0 == 111 {
    return if c1 == 99 && c2 == 116 { 10 } else { 0 } // oct
  }
  if c0 == 110 {
    return if c1 == 111 && c2 == 118 { 11 } else { 0 } // nov
  }
  if c0 == 100 {
    return if c1 == 101 && c2 == 99 { 12 } else { 0 } // dec
  }
  0
}

///| Sentinel returned by `parse_cookie_date_slice` on invalid date.
///| Strictly below the minimum valid RFC 6265 date (1601-01-01 = -11644473600).
fn date_invalid_sentinel() -> Int64 {
  -20000000000L
}

///| Zero-allocation RFC 6265 §5.1.1 cookie-date parser over `input[start..end)`.
///| Returns `date_invalid_sentinel()` on error.
fn parse_cookie_date_slice(input : String, start : Int, end : Int) -> Int64 {
  let len = end - start
  if len <= 0 {
    return date_invalid_sentinel()
  }
  // Fast path: canonical IMF-fixdate "Sun, 06 Nov 1994 08:49:37 GMT" (29 bytes)
  if len == 29 &&
  input.code_unit_at(start + 3) == 44 &&
  input.code_unit_at(start + 4) == 32 &&
  input.code_unit_at(start + 7) == 32 &&
  input.code_unit_at(start + 11) == 32 &&
  input.code_unit_at(start + 16) == 32 &&
  input.code_unit_at(start + 19) == 58 &&
  input.code_unit_at(start + 22) == 58 &&
  input.code_unit_at(start + 25) == 32 {
    let w0 = input.code_unit_at(start)
    let w1 = input.code_unit_at(start + 1)
    let w2 = input.code_unit_at(start + 2)
    if !is_date_delimiter(w0) &&
    !is_date_delimiter(w1) &&
    !is_date_delimiter(w2) &&
    !date_is_digit(w0) &&
    try_parse_month_unboxed(input, start, start + 3) == 0 {
      let d0 = input.code_unit_at(start + 5) - 48
      let d1 = input.code_unit_at(start + 6) - 48
      let mo = try_parse_month_unboxed(input, start + 8, start + 11)
      let y0 = input.code_unit_at(start + 12) - 48
      let y1 = input.code_unit_at(start + 13) - 48
      let y2 = input.code_unit_at(start + 14) - 48
      let y3 = input.code_unit_at(start + 15) - 48
      let h0 = input.code_unit_at(start + 17) - 48
      let h1 = input.code_unit_at(start + 18) - 48
      let m0 = input.code_unit_at(start + 20) - 48
      let m1 = input.code_unit_at(start + 21) - 48
      let s0 = input.code_unit_at(start + 23) - 48
      let s1 = input.code_unit_at(start + 24) - 48
      if d0 >= 0 && d0 <= 9 && d1 >= 0 && d1 <= 9 && mo > 0 &&
      y0 >= 0 && y0 <= 9 && y1 >= 0 && y1 <= 9 && y2 >= 0 && y2 <= 9 && y3 >= 0 && y3 <= 9 &&
      h0 >= 0 && h0 <= 9 && h1 >= 0 && h1 <= 9 &&
      m0 >= 0 && m0 <= 9 && m1 >= 0 && m1 <= 9 &&
      s0 >= 0 && s0 <= 9 && s1 >= 0 && s1 <= 9 {
        let day = d0 * 10 + d1
        let year = y0 * 1000 + y1 * 100 + y2 * 10 + y3
        let hour = h0 * 10 + h1
        let minute = m0 * 10 + m1
        let second = s0 * 10 + s1
        if year < 1601 || day < 1 || day > date_days_in_month(year, mo) || hour > 23 || minute > 59 || second > 59 {
          return date_invalid_sentinel()
        }
        let days = days_from_civil(year, mo, day)
        return days * 86400L + hour.to_int64() * 3600L + minute.to_int64() * 60L + second.to_int64()
      }
    }
  }

  let mut found_time = false
  let mut found_day = false
  let mut found_month = false
  let mut found_year = false
  let mut hour = 0
  let mut minute = 0
  let mut second = 0
  let mut day = 0
  let mut month = 0
  let mut year = 0

  let mut i = start
  while i < end {
    while i < end && is_date_delimiter(input.code_unit_at(i)) {
      i = i + 1
    }
    if i >= end {
      break
    }
    let tok_start = i
    while i < end && !is_date_delimiter(input.code_unit_at(i)) {
      i = i + 1
    }
    let tok_end = i

    if !found_time {
      let packed = try_parse_time_packed(input, tok_start, tok_end)
      if packed >= 0 {
        hour = packed >> 16
        minute = (packed >> 8) & 255
        second = packed & 255
        found_time = true
        continue
      }
    }
    if !found_day {
      let d = try_parse_digits_unboxed(input, tok_start, tok_end, 1, 2)
      if d >= 0 {
        day = d
        found_day = true
        continue
      }
    }
    if !found_month {
      let mo = try_parse_month_unboxed(input, tok_start, tok_end)
      if mo > 0 {
        month = mo
        found_month = true
        continue
      }
    }
    if !found_year {
      let y = try_parse_digits_unboxed(input, tok_start, tok_end, 2, 4)
      if y >= 0 {
        year = y
        found_year = true
        continue
      }
    }
  }

  if !found_time || !found_day || !found_month || !found_year {
    return date_invalid_sentinel()
  }
  if year >= 70 && year <= 99 {
    year = year + 1900
  } else if year >= 0 && year <= 69 {
    year = year + 2000
  }
  if year < 1601 {
    return date_invalid_sentinel()
  }
  if day < 1 || day > date_days_in_month(year, month) {
    return date_invalid_sentinel()
  }
  if hour > 23 || minute > 59 || second > 59 {
    return date_invalid_sentinel()
  }

  let days = days_from_civil(year, month, day)
  days * 86400L + hour.to_int64() * 3600L + minute.to_int64() * 60L + second.to_int64()
}

///| Parse an RFC 6265 §5.1.1 cookie-date string into UTC Unix seconds (`Int64`).
pub fn parse_cookie_date(input : String) -> Result[Int64, CookieError] {
  let n = input.length()
  if n == 0 {
    return Err(CookieError::InvalidDate("empty date"))
  }
  let secs = parse_cookie_date_slice(input, 0, n)
  if secs == date_invalid_sentinel() {
    Err(CookieError::InvalidDate("invalid cookie date"))
  } else {
    Ok(secs)
  }
}

fn weekday_name(dow : Int) -> String {
  if dow == 0 {
    "Sun"
  } else if dow == 1 {
    "Mon"
  } else if dow == 2 {
    "Tue"
  } else if dow == 3 {
    "Wed"
  } else if dow == 4 {
    "Thu"
  } else if dow == 5 {
    "Fri"
  } else {
    "Sat"
  }
}

fn month_name(month : Int) -> String {
  if month == 1 {
    "Jan"
  } else if month == 2 {
    "Feb"
  } else if month == 3 {
    "Mar"
  } else if month == 4 {
    "Apr"
  } else if month == 5 {
    "May"
  } else if month == 6 {
    "Jun"
  } else if month == 7 {
    "Jul"
  } else if month == 8 {
    "Aug"
  } else if month == 9 {
    "Sep"
  } else if month == 10 {
    "Oct"
  } else if month == 11 {
    "Nov"
  } else {
    "Dec"
  }
}

fn write_2d(sb : StringBuilder, v : Int) -> Unit {
  let d0 = (v / 10) % 10
  let d1 = v % 10
  let b = Bytes::new(2)
  b[0] = (48 + d0).to_byte()
  b[1] = (48 + d1).to_byte()
  sb.write_string(b.to_string())
}

fn write_4d(sb : StringBuilder, v : Int) -> Unit {
  let b = Bytes::new(4)
  b[0] = (48 + (v / 1000) % 10).to_byte()
  b[1] = (48 + (v / 100) % 10).to_byte()
  b[2] = (48 + (v / 10) % 10).to_byte()
  b[3] = (48 + v % 10).to_byte()
  sb.write_string(b.to_string())
}

///| Format a UTC Unix timestamp (`Int64` seconds) as canonical IMF-fixdate
///| (e.g. `Sun, 06 Nov 1994 08:49:37 GMT`). Clamps to the RFC 6265bis §5.6.1
///| representable range `1601-01-01 00:00:00 GMT`..`9999-12-31 23:59:59 GMT`.
pub fn format_cookie_date(unix_secs : Int64) -> String {
  let lo = -11644473600L
  let hi = 253402300799L
  let clamped = if unix_secs < lo { lo } else if unix_secs > hi { hi } else { unix_secs }
  let mut days = clamped / 86400L
  let mut rem = clamped % 86400L
  if rem < 0L {
    rem = rem + 86400L
    days = days - 1L
  }
  let hour = (rem / 3600L).to_int()
  let minute = ((rem % 3600L) / 60L).to_int()
  let second = (rem % 60L).to_int()

  // Howard Hinnant's O(1) civil_from_days
  let z = days + 719468L
  let era = if z >= 0L { z / 146097L } else { (z - 146096L) / 146097L }
  let doe = z - era * 146097L
  let yoe = (doe - doe / 1460L + doe / 36524L - doe / 146096L) / 365L
  let y0 = yoe + era * 400L
  let doy = doe - (365L * yoe + yoe / 4L - yoe / 100L)
  let mp = (5L * doy + 2L) / 153L
  let d = (doy - (153L * mp + 2L) / 5L + 1L).to_int()
  let m = (if mp < 10L { mp + 3L } else { mp - 9L }).to_int()
  let y = (if m <= 2 { y0 + 1L } else { y0 }).to_int()

  // 1970-01-01 was Thursday (4)
  let dow = (((days + 4L) % 7L + 7L) % 7L).to_int()

  let sb = StringBuilder::new()
  sb.write_string(weekday_name(dow))
  sb.write_string(", ")
  write_2d(sb, d)
  sb.write_string(" ")
  sb.write_string(month_name(m))
  sb.write_string(" ")
  write_4d(sb, y)
  sb.write_string(" ")
  write_2d(sb, hour)
  sb.write_string(":")
  write_2d(sb, minute)
  sb.write_string(":")
  write_2d(sb, second)
  sb.write_string(" GMT")
  sb.to_string()
}
