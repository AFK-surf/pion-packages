///| RFC 6265 §5.1.1 cookie-date parser and canonical IMF-fixdate formatter.
///| Pure Int64 O(1) civil calendar arithmetic (Howard Hinnant algorithm).

fn is_date_delimiter(c : Int) -> Bool {
  c == 9 ||
  (c >= 32 && c <= 47) ||
  (c >= 59 && c <= 64) ||
  (c >= 91 && c <= 96) ||
  (c >= 123 && c <= 126)
}

fn date_is_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn date_ascii_lower(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

fn date_is_leap_year(year : Int) -> Bool {
  (year % 4 == 0) && ((year % 100 != 0) || (year % 400 == 0))
}

fn date_days_in_month(year : Int, month : Int) -> Int {
  if month == 2 {
    if date_is_leap_year(year) { 29 } else { 28 }
  } else if month == 4 || month == 6 || month == 9 || month == 11 {
    30
  } else {
    31
  }
}

///| Howard Hinnant's O(1) days since 1970-01-01.
fn days_from_civil(year : Int, month : Int, day : Int) -> Int64 {
  let y = if month <= 2 { year.to_int64() - 1L } else { year.to_int64() }
  let era = if y >= 0L { y / 400L } else { (y - 399L) / 400L }
  let yoe = y - era * 400L
  let m = month.to_int64()
  let d = day.to_int64()
  let mp = if m > 2L { m - 3L } else { m + 9L }
  let doy = (153L * mp + 2L) / 5L + d - 1L
  let doe = yoe * 365L + yoe / 4L - yoe / 100L + doy
  era * 146097L + doe - 719468L
}

fn try_parse_time_token(s : String, start : Int, end : Int) -> Option[(Int, Int, Int)] {
  let mut p = start
  let mut h = 0
  let mut hd = 0
  while p < end && date_is_digit(s.code_unit_at(p)) && hd < 2 {
    h = h * 10 + (s.code_unit_at(p) - 48)
    p = p + 1
    hd = hd + 1
  }
  if hd == 0 || p >= end || s.code_unit_at(p) != 58 {
    return None
  }
  p = p + 1
  let mut m = 0
  let mut md = 0
  while p < end && date_is_digit(s.code_unit_at(p)) && md < 2 {
    m = m * 10 + (s.code_unit_at(p) - 48)
    p = p + 1
    md = md + 1
  }
  if md == 0 || p >= end || s.code_unit_at(p) != 58 {
    return None
  }
  p = p + 1
  let mut sec = 0
  let mut sd = 0
  while p < end && date_is_digit(s.code_unit_at(p)) && sd < 2 {
    sec = sec * 10 + (s.code_unit_at(p) - 48)
    p = p + 1
    sd = sd + 1
  }
  if sd == 0 {
    return None
  }
  if p < end && date_is_digit(s.code_unit_at(p)) {
    return None
  }
  Some((h, m, sec))
}

fn try_parse_digits_token(s : String, start : Int, end : Int, min_d : Int, max_d : Int) -> Option[Int] {
  let mut p = start
  let mut v = 0
  let mut count = 0
  while p < end && date_is_digit(s.code_unit_at(p)) && count < max_d {
    v = v * 10 + (s.code_unit_at(p) - 48)
    p = p + 1
    count = count + 1
  }
  if count < min_d {
    return None
  }
  if p < end && date_is_digit(s.code_unit_at(p)) {
    return None
  }
  Some(v)
}

fn try_parse_month_token(s : String, start : Int, end : Int) -> Option[Int] {
  if end - start < 3 {
    return None
  }
  let c0 = date_ascii_lower(s.code_unit_at(start))
  let c1 = date_ascii_lower(s.code_unit_at(start + 1))
  let c2 = date_ascii_lower(s.code_unit_at(start + 2))
  if c0 == 106 && c1 == 97 && c2 == 110 {
    return Some(1) // jan
  }
  if c0 == 102 && c1 == 101 && c2 == 98 {
    return Some(2) // feb
  }
  if c0 == 109 && c1 == 97 && c2 == 114 {
    return Some(3) // mar
  }
  if c0 == 97 && c1 == 112 && c2 == 114 {
    return Some(4) // apr
  }
  if c0 == 109 && c1 == 97 && c2 == 121 {
    return Some(5) // may
  }
  if c0 == 106 && c1 == 117 && c2 == 110 {
    return Some(6) // jun
  }
  if c0 == 106 && c1 == 117 && c2 == 108 {
    return Some(7) // jul
  }
  if c0 == 97 && c1 == 117 && c2 == 103 {
    return Some(8) // aug
  }
  if c0 == 115 && c1 == 101 && c2 == 112 {
    return Some(9) // sep
  }
  if c0 == 111 && c1 == 99 && c2 == 116 {
    return Some(10) // oct
  }
  if c0 == 110 && c1 == 111 && c2 == 118 {
    return Some(11) // nov
  }
  if c0 == 100 && c1 == 101 && c2 == 99 {
    return Some(12) // dec
  }
  None
}

///| Parse an RFC 6265 §5.1.1 cookie-date string into UTC Unix seconds (`Int64`).
pub fn parse_cookie_date(input : String) -> Result[Int64, CookieError] {
  let n = input.length()
  if n == 0 {
    return Err(CookieError::InvalidDate("empty date"))
  }
  let mut found_time = false
  let mut found_day = false
  let mut found_month = false
  let mut found_year = false
  let mut hour = 0
  let mut minute = 0
  let mut second = 0
  let mut day = 0
  let mut month = 0
  let mut year = 0

  let mut i = 0
  while i < n {
    while i < n && is_date_delimiter(input.code_unit_at(i)) {
      i = i + 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && !is_date_delimiter(input.code_unit_at(i)) {
      i = i + 1
    }
    let end = i

    if !found_time {
      match try_parse_time_token(input, start, end) {
        Some((h, m, sec)) => {
          hour = h
          minute = m
          second = sec
          found_time = true
          continue
        }
        None => ()
      }
    }
    if !found_day {
      match try_parse_digits_token(input, start, end, 1, 2) {
        Some(d) => {
          day = d
          found_day = true
          continue
        }
        None => ()
      }
    }
    if !found_month {
      match try_parse_month_token(input, start, end) {
        Some(mo) => {
          month = mo
          found_month = true
          continue
        }
        None => ()
      }
    }
    if !found_year {
      match try_parse_digits_token(input, start, end, 2, 4) {
        Some(y) => {
          year = y
          found_year = true
          continue
        }
        None => ()
      }
    }
  }

  if !found_time || !found_day || !found_month || !found_year {
    return Err(CookieError::InvalidDate("missing date component"))
  }
  if year >= 70 && year <= 99 {
    year = year + 1900
  } else if year >= 0 && year <= 69 {
    year = year + 2000
  }
  if year < 1601 {
    return Err(CookieError::InvalidDate("year before 1601"))
  }
  if day < 1 || day > date_days_in_month(year, month) {
    return Err(CookieError::InvalidDate("day out of range"))
  }
  if hour > 23 || minute > 59 || second > 59 {
    return Err(CookieError::InvalidDate("time out of range"))
  }

  let days = days_from_civil(year, month, day)
  let secs = days * 86400L + hour.to_int64() * 3600L + minute.to_int64() * 60L + second.to_int64()
  Ok(secs)
}

fn weekday_name(dow : Int) -> String {
  if dow == 0 {
    "Sun"
  } else if dow == 1 {
    "Mon"
  } else if dow == 2 {
    "Tue"
  } else if dow == 3 {
    "Wed"
  } else if dow == 4 {
    "Thu"
  } else if dow == 5 {
    "Fri"
  } else {
    "Sat"
  }
}

fn month_name(month : Int) -> String {
  if month == 1 {
    "Jan"
  } else if month == 2 {
    "Feb"
  } else if month == 3 {
    "Mar"
  } else if month == 4 {
    "Apr"
  } else if month == 5 {
    "May"
  } else if month == 6 {
    "Jun"
  } else if month == 7 {
    "Jul"
  } else if month == 8 {
    "Aug"
  } else if month == 9 {
    "Sep"
  } else if month == 10 {
    "Oct"
  } else if month == 11 {
    "Nov"
  } else {
    "Dec"
  }
}

fn write_2d(sb : StringBuilder, v : Int) -> Unit {
  let d0 = (v / 10) % 10
  let d1 = v % 10
  let b = Bytes::new(2)
  b[0] = (48 + d0).to_byte()
  b[1] = (48 + d1).to_byte()
  sb.write_string(b.to_string())
}

fn write_4d(sb : StringBuilder, v : Int) -> Unit {
  let b = Bytes::new(4)
  b[0] = (48 + (v / 1000) % 10).to_byte()
  b[1] = (48 + (v / 100) % 10).to_byte()
  b[2] = (48 + (v / 10) % 10).to_byte()
  b[3] = (48 + v % 10).to_byte()
  sb.write_string(b.to_string())
}

///| Format a UTC Unix timestamp (`Int64` seconds) as canonical IMF-fixdate
///| (e.g. `Sun, 06 Nov 1994 08:49:37 GMT`).
pub fn format_cookie_date(unix_secs : Int64) -> String {
  let mut days = unix_secs / 86400L
  let mut rem = unix_secs % 86400L
  if rem < 0L {
    rem = rem + 86400L
    days = days - 1L
  }
  let hour = (rem / 3600L).to_int()
  let minute = ((rem % 3600L) / 60L).to_int()
  let second = (rem % 60L).to_int()

  // Howard Hinnant's O(1) civil_from_days
  let z = days + 719468L
  let era = if z >= 0L { z / 146097L } else { (z - 146096L) / 146097L }
  let doe = z - era * 146097L
  let yoe = (doe - doe / 1460L + doe / 36524L - doe / 146096L) / 365L
  let y0 = yoe + era * 400L
  let doy = doe - (365L * yoe + yoe / 4L - yoe / 100L)
  let mp = (5L * doy + 2L) / 153L
  let d = (doy - (153L * mp + 2L) / 5L + 1L).to_int()
  let m = (if mp < 10L { mp + 3L } else { mp - 9L }).to_int()
  let y = (if m <= 2 { y0 + 1L } else { y0 }).to_int()

  // 1970-01-01 was Thursday (4)
  let dow = (((days + 4L) % 7L + 7L) % 7L).to_int()

  let sb = StringBuilder::new()
  sb.write_string(weekday_name(dow))
  sb.write_string(", ")
  write_2d(sb, d)
  sb.write_string(" ")
  sb.write_string(month_name(m))
  sb.write_string(" ")
  write_4d(sb, y)
  sb.write_string(" ")
  write_2d(sb, hour)
  sb.write_string(":")
  write_2d(sb, minute)
  sb.write_string(":")
  write_2d(sb, second)
  sb.write_string(" GMT")
  sb.to_string()
}
