///| RFC 6265bis CookieJar with CHIPS partitioning, Mozilla PSL guards, SameSite,
///| HttpOnly/Secure isolation, per-site eviction, and atomic text export/import.

pub struct CookieJar {
  limits : JarLimits
  cookies : Array[StoredCookie]
  site_keys : Array[String]
  mut next_seq : Int64
}

///| Create a `CookieJar` with custom limits and policies.
pub fn CookieJar::with_limits(limits : JarLimits) -> CookieJar {
  CookieJar::{ limits: limits, cookies: [], site_keys: [], next_seq: 1L }
}

///| Create a `CookieJar` with default RFC 6265bis limits.
pub fn CookieJar::new() -> CookieJar {
  CookieJar::with_limits(JarLimits::default())
}

///| Number of cookies currently stored in the jar.
pub fn CookieJar::len(self : CookieJar) -> Int {
  self.cookies.length()
}

///| Return a snapshot array of all stored cookies.
pub fn CookieJar::all_cookies(self : CookieJar) -> Array[StoredCookie] {
  let out : Array[StoredCookie] = []
  let mut i = 0
  while i < self.cookies.length() {
    out.push(self.cookies[i])
    i = i + 1
  }
  out
}

fn opt_string_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn is_cookie_expired(c : StoredCookie, now : Int64) -> Bool {
  match c.expiry_time {
    Some(exp) => exp <= now
    None => false
  }
}

fn has_edge_wsp(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  is_wsp(s.code_unit_at(0) & 255) || is_wsp(s.code_unit_at(n - 1) & 255)
}

fn validate_cookie_name_value(
  name : String,
  value : String,
  max_cookie_bytes : Int,
) -> Result[Unit, CookieError] {
  if name.length() == 0 && value.length() == 0 {
    return Err(CookieError::InvalidHeader("empty cookie name and value"))
  }
  if name.length() + value.length() > max_cookie_bytes {
    return Err(CookieError::SizeExceeded("cookie exceeds jar max_cookie_bytes"))
  }
  if has_forbidden_ctl(name) || contains_byte(name, 59) || contains_byte(name, 61) || has_edge_wsp(name) {
    return Err(CookieError::InvalidName("forbidden character or padding in cookie name"))
  }
  if has_forbidden_ctl(value) || contains_byte(value, 59) || has_edge_wsp(value) {
    return Err(CookieError::InvalidValue("forbidden character or padding in cookie value"))
  }
  Ok(())
}

fn compute_site_key(domain : String, include_private : Bool) -> String {
  let reg = if include_private {
    registrable_domain(domain)
  } else {
    registrable_domain_icann(domain)
  }
  match reg {
    Some(r) => r
    None => domain
  }
}

fn normalize_partition_site(site : String, include_private : Bool) -> String {
  match parse_request_url(site) {
    Ok(u) => {
      let site_host = compute_site_key(u.host, include_private)
      u.scheme + "://" + site_host
    }
    Err(_) => ascii_lower_str(site)
  }
}

fn compute_partition_key(ctx : RequestContext, parsed : ParsedUrl, include_private : Bool) -> String {
  match ctx.top_level_site {
    Some(s) => normalize_partition_site(s, include_private)
    None => {
      let site_host = compute_site_key(parsed.host, include_private)
      parsed.scheme + "://" + site_host
    }
  }
}

fn saturating_add_i64(a : Int64, b : Int64) -> Int64 {
  if b > 0L && a > 9223372036854775807L - b {
    9223372036854775807L
  } else if b < 0L && a < -9223372036854775807L - b {
    -9223372036854775807L
  } else {
    a + b
  }
}

fn saturating_sub_1_i64(a : Int64) -> Int64 {
  let min_i64 = -9223372036854775807L - 1L
  if a == min_i64 {
    min_i64
  } else {
    a - 1L
  }
}

fn is_psl_with_mode(host : String, include_private : Bool) -> Bool {
  if include_private {
    is_public_suffix(host)
  } else {
    is_public_suffix_icann(host)
  }
}

///| Pick the best eviction victim index among indices matching `site_filter`
///| (`None` = global eviction).
///| RFC 6265bis §5.7 priority: expired > non-Secure > oldest last_access_time.
fn pick_eviction_victim(
  cookies : Array[StoredCookie],
  site_keys : Array[String],
  site_filter : Option[String],
  now : Int64,
) -> Int {
  let mut best = -1
  let mut best_expired = false
  let mut best_non_secure = false
  let mut best_access = 0L
  let mut best_creation = 0L

  let mut i = 0
  while i < cookies.length() {
    let matches_site = match site_filter {
      Some(s) => site_keys[i] == s
      None => true
    }
    if !matches_site {
      i = i + 1
      continue
    }
    let c = cookies[i]
    let exp = is_cookie_expired(c, now)
    let non_sec = !c.secure
    if best == -1 {
      best = i
      best_expired = exp
      best_non_secure = non_sec
      best_access = c.last_access_time
      best_creation = c.creation_time
    } else {
      let better = if exp != best_expired {
        exp
      } else if non_sec != best_non_secure {
        non_sec
      } else if c.last_access_time != best_access {
        c.last_access_time < best_access
      } else {
        c.creation_time < best_creation
      }
      if better {
        best = i
        best_expired = exp
        best_non_secure = non_sec
        best_access = c.last_access_time
        best_creation = c.creation_time
      }
    }
    i = i + 1
  }
  best
}

fn remove_cookie_at(cookies : Array[StoredCookie], site_keys : Array[String], idx : Int) -> Unit {
  let n = cookies.length()
  let mut i = idx
  while i + 1 < n {
    cookies[i] = cookies[i + 1]
    site_keys[i] = site_keys[i + 1]
    i = i + 1
  }
  let _ = cookies.pop()
  let _ = site_keys.pop()
}

fn count_site_cookies(site_keys : Array[String], site : String) -> Int {
  let mut cnt = 0
  let mut i = 0
  while i < site_keys.length() {
    if site_keys[i] == site {
      cnt = cnt + 1
    }
    i = i + 1
  }
  cnt
}

///| Store a parsed `Cookie` in the jar under `ctx`.
///| Returns `Ok(true)` if stored/updated, `Ok(false)` if expired/deleted, or `Err` on policy violation.
pub fn CookieJar::store_cookie(
  self : CookieJar,
  cookie : Cookie,
  ctx : RequestContext,
) -> Result[Bool, CookieError] {
  let parsed = match parse_request_url(ctx.url) {
    Ok(u) => u
    Err(e) => return Err(e)
  }
  match validate_cookie_name_value(cookie.name, cookie.value, self.limits.max_cookie_bytes) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match cookie.domain {
    Some(d) =>
    if has_forbidden_ctl(d) || contains_byte(d, 59) {
      return Err(CookieError::InvalidFormat("forbidden character in Domain"))
    }
    None => ()
  }
  match cookie.path {
    Some(p) =>
    if has_forbidden_ctl(p) || contains_byte(p, 59) {
      return Err(CookieError::InvalidFormat("forbidden character in Path"))
    }
    None => ()
  }
  if cookie.http_only && !ctx.is_http_api {
    return Err(CookieError::HttpOnlyViolation("non-HTTP API cannot set HttpOnly cookie"))
  }
  if cookie.secure && !parsed.is_secure {
    return Err(CookieError::SecureOriginRequired("non-secure origin cannot set Secure cookie"))
  }
  if cookie.partitioned && !cookie.secure {
    return Err(CookieError::PartitionedRequiresSecure("Partitioned attribute requires Secure"))
  }
  // __Http- and __Host-Http- also require HTTP API
  if (starts_with_ascii_icase(cookie.name, "__http-") || starts_with_ascii_icase(cookie.name, "__host-http-")) &&
  !ctx.is_http_api {
    return Err(CookieError::HttpOnlyViolation("Http prefix requires HTTP API"))
  }
  match validate_cookie_prefixes(cookie, parsed.is_secure) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  let effective_ss = match cookie.same_site {
    Some(ss) => ss
    None => self.limits.default_same_site
  }
  if same_site_eq(effective_ss, SameSite::None) && !cookie.secure {
    return Err(CookieError::SecureOriginRequired("SameSite=None requires Secure"))
  }
  // RFC 6265bis §5.7 step 18: reject cross-site sets for SameSite != None
  // unless from an HTTP top-level navigation.
  if !same_site_eq(effective_ss, SameSite::None) &&
  !ctx.is_same_site &&
  (!ctx.is_http_api || !ctx.is_top_level_navigation) {
    return Err(CookieError::InvalidHeader("cross-site context cannot set SameSite cookie"))
  }

  // Domain validation & PSL check (RFC 6265bis §5.7 steps 7-10)
  // Note: parse_set_cookie already strips at most one leading '.'; do not strip a second one here.
  let (domain, host_only) = match cookie.domain {
    Some(raw_d) => {
      let d = ascii_lower_str(raw_d)
      if d.length() == 0 {
        (parsed.host, true)
      } else if !is_ip_address(d) && public_suffix_info(d, self.limits.include_private_psl) is None {
        return Err(CookieError::PublicSuffixRejected(d))
      } else if is_psl_with_mode(d, self.limits.include_private_psl) {
        if d == parsed.host {
          (parsed.host, true)
        } else {
          return Err(CookieError::PublicSuffixRejected(d))
        }
      } else if !domain_matches(parsed.host, d) {
        return Err(CookieError::DomainMismatch(d))
      } else {
        (d, false)
      }
    }
    None => (parsed.host, true)
  }

  let path = match cookie.path {
    Some(p) => p
    None => default_path(parsed.path)
  }

  let partition_key : Option[String] = if cookie.partitioned {
    Some(compute_partition_key(ctx, parsed, self.limits.include_private_psl))
  } else {
    None
  }

  // Expiry computation: Max-Age takes precedence over Expires
  let (persistent, expiry_time) : (Bool, Option[Int64]) = match cookie.max_age {
    Some(ma) =>
    if ma <= 0L {
      (true, Some(saturating_sub_1_i64(ctx.now_unix_secs)))
    } else {
      let capped = match self.limits.max_lifetime_secs {
        Some(cap) => if ma > cap { cap } else { ma }
        None => ma
      }
      (true, Some(saturating_add_i64(ctx.now_unix_secs, capped)))
    }
    None =>
    match cookie.expires {
      Some(exp) => {
        let capped = match self.limits.max_lifetime_secs {
          Some(cap) => {
            let max_exp = saturating_add_i64(ctx.now_unix_secs, cap)
            if exp > max_exp { max_exp } else { exp }
          }
          None => exp
        }
        (true, Some(capped))
      }
      None => (false, None)
    }
  }

  // RFC 6265bis §5.7 step 16 ("leave secure cookies alone"):
  // A non-secure origin cannot shadow an existing Secure cookie with the same name
  // whose domain domain-matches either way and whose path is path-matched by the new path.
  if !cookie.secure && !parsed.is_secure {
    let mut si = 0
    while si < self.cookies.length() {
      let old = self.cookies[si]
      if old.name == cookie.name &&
      old.secure &&
      (domain_matches(old.domain, domain) || domain_matches(domain, old.domain)) &&
      path_matches(path, old.path) {
        return Err(CookieError::SecureOriginRequired("non-secure origin cannot shadow Secure cookie"))
      }
      si = si + 1
    }
  }

  // RFC 6265bis §5.7 step 23: identity is (name, domain, host_only, path, partition_key)
  let mut existing_idx = -1
  let mut i = 0
  while i < self.cookies.length() {
    let c = self.cookies[i]
    if c.name == cookie.name &&
    c.domain == domain &&
    c.host_only == host_only &&
    c.path == path &&
    opt_string_eq(c.partition_key, partition_key) {
      existing_idx = i
      break
    }
    i = i + 1
  }

  let mut creation_time = ctx.now_unix_secs
  if existing_idx >= 0 {
    let old = self.cookies[existing_idx]
    if old.http_only && !ctx.is_http_api {
      return Err(CookieError::HttpOnlyViolation("non-HTTP API cannot overwrite HttpOnly cookie"))
    }
    if old.secure && !parsed.is_secure {
      return Err(CookieError::SecureOriginRequired("non-secure origin cannot overwrite Secure cookie"))
    }
    creation_time = old.creation_time
    remove_cookie_at(self.cookies, self.site_keys, existing_idx)
  }

  // If already expired, do not store (any prior cookie with the same key was deleted above)
  match expiry_time {
    Some(exp) =>
    if exp <= ctx.now_unix_secs {
      return Ok(false)
    }
    None => ()
  }

  // Enforce per-site (eTLD+1) limit and global limit
  if self.limits.max_cookies_per_domain <= 0 || self.limits.max_cookies <= 0 {
    return Ok(false)
  }
  let site_key = compute_site_key(domain, self.limits.include_private_psl)
  while count_site_cookies(self.site_keys, site_key) >= self.limits.max_cookies_per_domain {
    let victim = pick_eviction_victim(self.cookies, self.site_keys, Some(site_key), ctx.now_unix_secs)
    if victim < 0 {
      break
    }
    remove_cookie_at(self.cookies, self.site_keys, victim)
  }
  while self.cookies.length() >= self.limits.max_cookies {
    let victim = pick_eviction_victim(self.cookies, self.site_keys, None, ctx.now_unix_secs)
    if victim < 0 {
      break
    }
    remove_cookie_at(self.cookies, self.site_keys, victim)
  }

  let stored = StoredCookie::{
    name: cookie.name,
    value: cookie.value,
    domain: domain,
    host_only: host_only,
    path: path,
    secure: cookie.secure,
    http_only: cookie.http_only,
    same_site: effective_ss,
    partitioned: cookie.partitioned,
    partition_key: partition_key,
    creation_time: creation_time,
    last_access_time: ctx.now_unix_secs,
    expiry_time: expiry_time,
    persistent: persistent,
  }
  self.cookies.push(stored)
  self.site_keys.push(site_key)
  self.next_seq = self.next_seq + 1L
  Ok(true)
}

///| Parse and store a raw `Set-Cookie` header value under `ctx`.
pub fn CookieJar::store_set_cookie(
  self : CookieJar,
  header : String,
  ctx : RequestContext,
) -> Result[Bool, CookieError] {
  let opts = ParseOptions::new(
    self.limits.max_cookie_bytes,
    self.limits.max_attribute_bytes,
    self.limits.default_same_site,
  )
  let cookie = match parse_set_cookie_with_options(header, opts) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  self.store_cookie(cookie, ctx)
}

fn cookie_should_send_samesite(c : StoredCookie, ctx : RequestContext) -> Bool {
  if ctx.is_same_site {
    return true
  }
  match c.same_site {
    SameSite::None => true
    SameSite::Lax => ctx.is_http_api && ctx.is_top_level_navigation && ctx.is_safe_method
    SameSite::Strict => false
  }
}

///| Retrieve all cookies matching `ctx`, ordered per RFC 6265bis §5.8.3
///| (longest path first, then earliest `creation_time`), updating `last_access_time`.
pub fn CookieJar::matching_cookies(
  self : CookieJar,
  ctx : RequestContext,
) -> Result[Array[StoredCookie], CookieError] {
  let parsed = match parse_request_url(ctx.url) {
    Ok(u) => u
    Err(e) => return Err(e)
  }
  let mut req_pkey_cache : Option[String] = None

  let matched : Array[StoredCookie] = []
  let mut i = 0
  while i < self.cookies.length() {
    let c = self.cookies[i]
    if is_cookie_expired(c, ctx.now_unix_secs) {
      i = i + 1
      continue
    }
    let dom_ok = if c.host_only {
      parsed.host == c.domain
    } else {
      domain_matches(parsed.host, c.domain) && !is_psl_with_mode(c.domain, self.limits.include_private_psl)
    }
    if !dom_ok {
      i = i + 1
      continue
    }
    if !path_matches(parsed.path, c.path) {
      i = i + 1
      continue
    }
    if c.secure && !parsed.is_secure {
      i = i + 1
      continue
    }
    if c.http_only && !ctx.is_http_api {
      i = i + 1
      continue
    }
    if !cookie_should_send_samesite(c, ctx) {
      i = i + 1
      continue
    }
    // CHIPS partition isolation (lazy partition key computation)
    match c.partition_key {
      Some(pk) => {
        let rpk = match req_pkey_cache {
          Some(v) => v
          None => {
            let v = compute_partition_key(ctx, parsed, self.limits.include_private_psl)
            req_pkey_cache = Some(v)
            v
          }
        }
        if pk != rpk {
          i = i + 1
          continue
        }
      }
      None => ()
    }
    let updated = StoredCookie::{
      name: c.name,
      value: c.value,
      domain: c.domain,
      host_only: c.host_only,
      path: c.path,
      secure: c.secure,
      http_only: c.http_only,
      same_site: c.same_site,
      partitioned: c.partitioned,
      partition_key: c.partition_key,
      creation_time: c.creation_time,
      last_access_time: ctx.now_unix_secs,
      expiry_time: c.expiry_time,
      persistent: c.persistent,
    }
    self.cookies[i] = updated
    matched.push(updated)
    i = i + 1
  }

  // Insertion sort (stable): longest path first, then earliest creation_time
  let mut a = 1
  while a < matched.length() {
    let key = matched[a]
    let mut b = a - 1
    while b >= 0 {
      let cur = matched[b]
      let swap = if key.path.length() != cur.path.length() {
        key.path.length() > cur.path.length()
      } else {
        key.creation_time < cur.creation_time
      }
      if swap {
        matched[b + 1] = cur
        b = b - 1
      } else {
        break
      }
    }
    matched[b + 1] = key
    a = a + 1
  }

  Ok(matched)
}

///| Build the `Cookie` request header string for `ctx`, or `None` if no cookies match.
pub fn CookieJar::cookie_header(
  self : CookieJar,
  ctx : RequestContext,
) -> Result[Option[String], CookieError] {
  let list = match self.matching_cookies(ctx) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if list.length() == 0 {
    return Ok(None)
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < list.length() {
    if i > 0 {
      sb.write_string("; ")
    }
    let c = list[i]
    if c.name.length() > 0 {
      sb.write_string(c.name)
      sb.write_string("=")
      sb.write_string(c.value)
    } else {
      sb.write_string(c.value)
    }
    i = i + 1
  }
  Ok(Some(sb.to_string()))
}

///| Remove all cookies from the jar.
pub fn CookieJar::clear(self : CookieJar) -> Unit {
  while self.cookies.length() > 0 {
    let _ = self.cookies.pop()
    let _ = self.site_keys.pop()
  }
}

///| Remove all cookies belonging to `domain` (case-insensitive exact domain match) in O(N).
///| Returns the number of cookies removed.
pub fn CookieJar::clear_domain(self : CookieJar, domain : String) -> Int {
  let target = ascii_lower_str(domain)
  let n = self.cookies.length()
  let mut w = 0
  let mut i = 0
  while i < n {
    if self.cookies[i].domain != target {
      if w != i {
        self.cookies[w] = self.cookies[i]
        self.site_keys[w] = self.site_keys[i]
      }
      w = w + 1
    }
    i = i + 1
  }
  let removed = n - w
  while self.cookies.length() > w {
    let _ = self.cookies.pop()
    let _ = self.site_keys.pop()
  }
  removed
}

///| Remove all cookies expired at or before `now_unix_secs` in O(N).
///| Returns the number of cookies removed.
pub fn CookieJar::purge_expired(self : CookieJar, now_unix_secs : Int64) -> Int {
  let n = self.cookies.length()
  let mut w = 0
  let mut i = 0
  while i < n {
    if !is_cookie_expired(self.cookies[i], now_unix_secs) {
      if w != i {
        self.cookies[w] = self.cookies[i]
        self.site_keys[w] = self.site_keys[i]
      }
      w = w + 1
    }
    i = i + 1
  }
  let removed = n - w
  while self.cookies.length() > w {
    let _ = self.cookies.pop()
    let _ = self.site_keys.pop()
  }
  removed
}

fn escape_field(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i) & 255
    if c == 92 {
      sb.write_string("\\\\")
    } else if c == 9 {
      sb.write_string("\\t")
    } else if c == 10 {
      sb.write_string("\\n")
    } else if c == 13 {
      sb.write_string("\\r")
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn unescape_field(s : String) -> Result[String, CookieError] {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i) & 255
    if c == 92 {
      if i + 1 >= n {
        return Err(CookieError::InvalidFormat("dangling escape"))
      }
      let next = s.code_unit_at(i + 1) & 255
      if next == 92 {
        sb.write_string("\\")
      } else if next == 116 {
        sb.write_string("\t")
      } else if next == 110 {
        sb.write_string("\n")
      } else if next == 114 {
        sb.write_string("\r")
      } else if next == 45 {
        sb.write_string("-")
      } else {
        return Err(CookieError::InvalidFormat("unknown escape sequence"))
      }
      i = i + 2
    } else {
      sb.write_byte(c.to_byte())
      i = i + 1
    }
  }
  Ok(sb.to_string())
}

///| Serialize the jar to a deterministic tab-separated text format (version 1).
pub fn CookieJar::export_text(self : CookieJar) -> String {
  let sb = StringBuilder::new()
  sb.write_string("# pion-cookie-jar v1\n")
  let mut i = 0
  while i < self.cookies.length() {
    let c = self.cookies[i]
    sb.write_string(escape_field(c.name))
    sb.write_string("\t")
    sb.write_string(escape_field(c.value))
    sb.write_string("\t")
    sb.write_string(escape_field(c.domain))
    sb.write_string("\t")
    sb.write_string(if c.host_only { "1" } else { "0" })
    sb.write_string("\t")
    sb.write_string(escape_field(c.path))
    sb.write_string("\t")
    sb.write_string(if c.secure { "1" } else { "0" })
    sb.write_string("\t")
    sb.write_string(if c.http_only { "1" } else { "0" })
    sb.write_string("\t")
    sb.write_string(same_site_to_string(c.same_site))
    sb.write_string("\t")
    sb.write_string(if c.partitioned { "1" } else { "0" })
    sb.write_string("\t")
    match c.partition_key {
      Some(pk) =>
      if pk == "-" {
        sb.write_string("\\-")
      } else {
        sb.write_string(escape_field(pk))
      }
      None => sb.write_string("-")
    }
    sb.write_string("\t")
    sb.write_string(i64_to_decimal(c.creation_time))
    sb.write_string("\t")
    sb.write_string(i64_to_decimal(c.last_access_time))
    sb.write_string("\t")
    match c.expiry_time {
      Some(exp) => sb.write_string(i64_to_decimal(exp))
      None => sb.write_string("-")
    }
    sb.write_string("\n")
    i = i + 1
  }
  sb.to_string()
}

fn split_tabs(line : String) -> Array[String] {
  let parts : Array[String] = []
  let n = line.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || line.code_unit_at(i) == 9 {
      parts.push(line.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  parts
}

fn parse_bool_strict(s : String, field : String) -> Result[Bool, CookieError] {
  if s == "1" {
    Ok(true)
  } else if s == "0" {
    Ok(false)
  } else {
    Err(CookieError::InvalidFormat("invalid boolean for " + field + ": " + s))
  }
}

fn parse_i64_strict(s : String) -> Result[Int64, CookieError] {
  match parse_max_age_value(s, 0, s.length()) {
    Some(v) => Ok(v)
    None => Err(CookieError::InvalidFormat("invalid integer: " + s))
  }
}

fn fnv1a_hash_str(h0 : UInt64, s : String) -> UInt64 {
  let mut h = h0
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  (h ^ 255UL) * 1099511628211UL
}

fn cookie_identity_hash(c : StoredCookie) -> UInt64 {
  let mut h = 14695981039346656037UL
  h = fnv1a_hash_str(h, c.name)
  h = fnv1a_hash_str(h, c.domain)
  h = (h ^ (if c.host_only { 1UL } else { 0UL })) * 1099511628211UL
  h = fnv1a_hash_str(h, c.path)
  match c.partition_key {
    Some(pk) => fnv1a_hash_str(h, pk)
    None => (h ^ 17UL) * 1099511628211UL
  }
}

fn cookie_same_identity(a : StoredCookie, b : StoredCookie) -> Bool {
  a.name == b.name &&
  a.domain == b.domain &&
  a.host_only == b.host_only &&
  a.path == b.path &&
  opt_string_eq(a.partition_key, b.partition_key)
}

fn next_pow2(n : Int) -> Int {
  let mut cap = 16
  while cap < n {
    cap = cap * 2
  }
  cap
}

///| Import cookies from `export_text()` output atomically (all-or-nothing),
///| enforcing field validation, identity deduplication, and `JarLimits` in O(N).
///| Returns number of cookies parsed and accepted.
pub fn CookieJar::import_text(self : CookieJar, data : String) -> Result[Int, CookieError] {
  let incoming : Array[StoredCookie] = []
  let incoming_sites : Array[String] = []
  let n = data.length()
  let mut pos = 0
  let mut last_domain = ""
  let mut last_site = ""
  while pos < n {
    let start = pos
    while pos < n && data.code_unit_at(pos) != 10 {
      pos = pos + 1
    }
    let mut end = pos
    if end > start && data.code_unit_at(end - 1) == 13 {
      end = end - 1
    }
    if pos < n {
      pos = pos + 1
    }
    if start >= end || data.code_unit_at(start) == 35 {
      continue
    }
    let cols = split_tabs(data.slice(start, end))
    if cols.length() != 13 {
      return Err(CookieError::InvalidFormat("expected 13 columns in jar export"))
    }
    let name = match unescape_field(cols[0]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let value = match unescape_field(cols[1]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match validate_cookie_name_value(name, value, self.limits.max_cookie_bytes) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if name.length() == 0 {
      if starts_with_ascii_icase(value, "__secure-") ||
      starts_with_ascii_icase(value, "__host-") ||
      starts_with_ascii_icase(value, "__http-") ||
      starts_with_ascii_icase(value, "__host-http-") {
        return Err(CookieError::PrefixViolation("nameless cookie value cannot begin with reserved prefix"))
      }
    }
    let domain = match unescape_field(cols[2]) {
      Ok(v) => ascii_lower_str(v)
      Err(e) => return Err(e)
    }
    if domain.length() == 0 || has_forbidden_ctl(domain) || contains_byte(domain, 59) {
      return Err(CookieError::InvalidFormat("invalid domain in jar export"))
    }
    let host_only = match parse_bool_strict(cols[3], "host_only") {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !host_only &&
    (is_psl_with_mode(domain, self.limits.include_private_psl) ||
      (!is_ip_address(domain) && public_suffix_info(domain, self.limits.include_private_psl) is None)) {
      return Err(CookieError::PublicSuffixRejected(domain))
    }
    let path = match unescape_field(cols[4]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if path.length() == 0 || path.code_unit_at(0) != 47 || has_forbidden_ctl(path) || contains_byte(path, 59) {
      return Err(CookieError::InvalidFormat("invalid path in jar export"))
    }
    let secure = match parse_bool_strict(cols[5], "secure") {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let http_only = match parse_bool_strict(cols[6], "http_only") {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let same_site = if cols[7] == "Strict" {
      SameSite::Strict
    } else if cols[7] == "Lax" {
      SameSite::Lax
    } else if cols[7] == "None" {
      SameSite::None
    } else {
      return Err(CookieError::InvalidFormat("invalid SameSite: " + cols[7]))
    }
    if same_site_eq(same_site, SameSite::None) && !secure {
      return Err(CookieError::SecureOriginRequired("SameSite=None requires Secure"))
    }
    let partitioned = match parse_bool_strict(cols[8], "partitioned") {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if partitioned && !secure {
      return Err(CookieError::PartitionedRequiresSecure("Partitioned requires Secure"))
    }
    let partition_key : Option[String] = if cols[9] == "-" {
      if partitioned {
        return Err(CookieError::InvalidFormat("partitioned cookie missing partition_key"))
      }
      None
    } else {
      if !partitioned {
        return Err(CookieError::InvalidFormat("unpartitioned cookie has partition_key"))
      }
      match unescape_field(cols[9]) {
        Ok(v) => {
          if has_forbidden_ctl(v) {
            return Err(CookieError::InvalidFormat("forbidden character in partition_key"))
          }
          Some(v)
        }
        Err(e) => return Err(e)
      }
    }
    let creation_time = match parse_i64_strict(cols[10]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let last_access_time = match parse_i64_strict(cols[11]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (persistent, expiry_time) : (Bool, Option[Int64]) = if cols[12] == "-" {
      (false, None)
    } else {
      match parse_i64_strict(cols[12]) {
        Ok(v) => (true, Some(v))
        Err(e) => return Err(e)
      }
    }
    let sk = if domain == last_domain && last_site.length() > 0 {
      last_site
    } else {
      let s = compute_site_key(domain, self.limits.include_private_psl)
      last_domain = domain
      last_site = s
      s
    }
    incoming.push(StoredCookie::{
      name: name,
      value: value,
      domain: domain,
      host_only: host_only,
      path: path,
      secure: secure,
      http_only: http_only,
      same_site: same_site,
      partitioned: partitioned,
      partition_key: partition_key,
      creation_time: creation_time,
      last_access_time: last_access_time,
      expiry_time: expiry_time,
      persistent: persistent,
    })
    incoming_sites.push(sk)
  }

  let parsed_count = incoming.length()
  if parsed_count == 0 {
    return Ok(0)
  }
  if self.limits.max_cookies_per_domain <= 0 || self.limits.max_cookies <= 0 {
    self.clear()
    return Ok(0)
  }

  // Combine existing + incoming, deduplicating by identity in O(N) (later wins)
  let combined : Array[StoredCookie] = []
  let combined_sites : Array[String] = []
  let total_raw = self.cookies.length() + parsed_count
  let cap = next_pow2(total_raw * 2 + 1)
  let mask = cap - 1
  let slots : Array[Int] = []
  let mut si = 0
  while si < cap {
    slots.push(-1)
    si = si + 1
  }

  let mut idx_existing = 0
  while idx_existing < self.cookies.length() {
    let c = self.cookies[idx_existing]
    let sk = self.site_keys[idx_existing]
    let mut h = (cookie_identity_hash(c) & mask.to_int64().to_uint64()).to_int()
    let mut found = -1
    while slots[h] != -1 {
      let pos_c = slots[h]
      if cookie_same_identity(combined[pos_c], c) {
        found = pos_c
        break
      }
      h = (h + 1) & mask
    }
    if found >= 0 {
      combined[found] = c
      combined_sites[found] = sk
    } else {
      slots[h] = combined.length()
      combined.push(c)
      combined_sites.push(sk)
    }
    idx_existing = idx_existing + 1
  }

  let mut idx_inc = 0
  while idx_inc < parsed_count {
    let c = incoming[idx_inc]
    let sk = incoming_sites[idx_inc]
    let mut h = (cookie_identity_hash(c) & mask.to_int64().to_uint64()).to_int()
    let mut found = -1
    while slots[h] != -1 {
      let pos_c = slots[h]
      if cookie_same_identity(combined[pos_c], c) {
        found = pos_c
        break
      }
      h = (h + 1) & mask
    }
    if found >= 0 {
      combined[found] = c
      combined_sites[found] = sk
    } else {
      slots[h] = combined.length()
      combined.push(c)
      combined_sites.push(sk)
    }
    idx_inc = idx_inc + 1
  }

  // Enforce per-site limit in O(N) by walking backwards (keeping newest entries per site)
  let max_per = self.limits.max_cookies_per_domain
  let max_glob = self.limits.max_cookies
  let m = combined.length()
  let keep : Array[Bool] = []
  let mut ki = 0
  while ki < m {
    keep.push(false)
    ki = ki + 1
  }

  // Hash table for per-site counts
  let sc_cap = next_pow2(m * 2 + 1)
  let sc_mask = sc_cap - 1
  let sc_keys : Array[String] = []
  let sc_vals : Array[Int] = []
  let mut sci = 0
  while sci < sc_cap {
    sc_keys.push("")
    sc_vals.push(0)
    sci = sci + 1
  }

  let mut kept_total = 0
  let mut rev = m - 1
  while rev >= 0 && kept_total < max_glob {
    let sk = combined_sites[rev]
    let mut h = (fnv1a_hash_str(14695981039346656037UL, sk) & sc_mask.to_int64().to_uint64()).to_int()
    while sc_vals[h] > 0 && sc_keys[h] != sk {
      h = (h + 1) & sc_mask
    }
    if sc_vals[h] < max_per {
      sc_keys[h] = sk
      sc_vals[h] = sc_vals[h] + 1
      keep[rev] = true
      kept_total = kept_total + 1
    }
    rev = rev - 1
  }

  // Commit atomically into self.cookies and self.site_keys
  self.clear()
  let mut fi = 0
  while fi < m {
    if keep[fi] {
      self.cookies.push(combined[fi])
      self.site_keys.push(combined_sites[fi])
    }
    fi = fi + 1
  }
  Ok(parsed_count)
}
