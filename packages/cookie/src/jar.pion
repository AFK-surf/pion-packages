///| RFC 6265bis CookieJar with CHIPS partitioning, Mozilla PSL guards, SameSite,
///| HttpOnly/Secure isolation, deterministic eviction, and text export/import.

pub struct CookieJar {
  limits : JarLimits
  cookies : Array[StoredCookie]
  mut next_seq : Int64
}

///| Create a `CookieJar` with custom limits and policies.
pub fn CookieJar::with_limits(limits : JarLimits) -> CookieJar {
  CookieJar::{ limits: limits, cookies: [], next_seq: 1L }
}

///| Create a `CookieJar` with default RFC 6265bis limits.
pub fn CookieJar::new() -> CookieJar {
  CookieJar::with_limits(JarLimits::default())
}

///| Number of cookies currently stored in the jar.
pub fn CookieJar::len(self : CookieJar) -> Int {
  self.cookies.length()
}

///| Return a snapshot array of all stored cookies.
pub fn CookieJar::all_cookies(self : CookieJar) -> Array[StoredCookie] {
  let out : Array[StoredCookie] = []
  let mut i = 0
  while i < self.cookies.length() {
    out.push(self.cookies[i])
    i = i + 1
  }
  out
}

fn opt_string_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn is_cookie_expired(c : StoredCookie, now : Int64) -> Bool {
  match c.expiry_time {
    Some(exp) => exp <= now
    None => false
  }
}

fn normalize_partition_site(site : String, include_private : Bool) -> String {
  match parse_request_url(site) {
    Ok(u) => {
      let reg = if include_private {
        registrable_domain(u.host)
      } else {
        registrable_domain_icann(u.host)
      }
      let site_host = match reg {
        Some(r) => r
        None => u.host
      }
      u.scheme + "://" + site_host
    }
    Err(_) => ascii_lower_str(site)
  }
}

fn compute_partition_key(ctx : RequestContext, parsed : ParsedUrl, include_private : Bool) -> String {
  match ctx.top_level_site {
    Some(s) => normalize_partition_site(s, include_private)
    None => {
      let reg = if include_private {
        registrable_domain(parsed.host)
      } else {
        registrable_domain_icann(parsed.host)
      }
      let site_host = match reg {
        Some(r) => r
        None => parsed.host
      }
      parsed.scheme + "://" + site_host
    }
  }
}

fn saturating_add_i64(a : Int64, b : Int64) -> Int64 {
  if b > 0L && a > 9223372036854775807L - b {
    9223372036854775807L
  } else if b < 0L && a < -9223372036854775807L - b {
    -9223372036854775807L
  } else {
    a + b
  }
}

fn is_psl_with_mode(host : String, include_private : Bool) -> Bool {
  if include_private {
    is_public_suffix(host)
  } else {
    is_public_suffix_icann(host)
  }
}

///| Pick the best eviction victim index among indices matching `domain_filter`
///| (`None` = global eviction).
///| RFC 6265bis §5.7 priority: expired > non-Secure > oldest last_access_time.
fn pick_eviction_victim(
  cookies : Array[StoredCookie],
  domain_filter : Option[String],
  now : Int64,
) -> Int {
  let mut best = -1
  let mut best_expired = false
  let mut best_non_secure = false
  let mut best_access = 0L
  let mut best_creation = 0L

  let mut i = 0
  while i < cookies.length() {
    let c = cookies[i]
    let matches_dom = match domain_filter {
      Some(d) => c.domain == d
      None => true
    }
    if !matches_dom {
      i = i + 1
      continue
    }
    let exp = is_cookie_expired(c, now)
    let non_sec = !c.secure
    if best == -1 {
      best = i
      best_expired = exp
      best_non_secure = non_sec
      best_access = c.last_access_time
      best_creation = c.creation_time
    } else {
      let better = if exp != best_expired {
        exp
      } else if non_sec != best_non_secure {
        non_sec
      } else if c.last_access_time != best_access {
        c.last_access_time < best_access
      } else {
        c.creation_time < best_creation
      }
      if better {
        best = i
        best_expired = exp
        best_non_secure = non_sec
        best_access = c.last_access_time
        best_creation = c.creation_time
      }
    }
    i = i + 1
  }
  best
}

fn remove_at(cookies : Array[StoredCookie], idx : Int) -> Unit {
  let n = cookies.length()
  let mut i = idx
  while i + 1 < n {
    cookies[i] = cookies[i + 1]
    i = i + 1
  }
  let _ = cookies.pop()
}

fn count_domain_cookies(cookies : Array[StoredCookie], domain : String) -> Int {
  let mut cnt = 0
  let mut i = 0
  while i < cookies.length() {
    if cookies[i].domain == domain {
      cnt = cnt + 1
    }
    i = i + 1
  }
  cnt
}

///| Store a parsed `Cookie` in the jar under `ctx`.
///| Returns `Ok(true)` if stored/updated, `Ok(false)` if expired/deleted, or `Err` on policy violation.
pub fn CookieJar::store_cookie(
  self : CookieJar,
  cookie : Cookie,
  ctx : RequestContext,
) -> Result[Bool, CookieError] {
  let parsed = match parse_request_url(ctx.url) {
    Ok(u) => u
    Err(e) => return Err(e)
  }
  if cookie.name.length() == 0 && cookie.value.length() == 0 {
    return Err(CookieError::InvalidHeader("empty cookie name and value"))
  }
  if cookie.name.length() + cookie.value.length() > self.limits.max_cookie_bytes {
    return Err(CookieError::SizeExceeded("cookie exceeds jar max_cookie_bytes"))
  }
  if cookie.http_only && !ctx.is_http_api {
    return Err(CookieError::HttpOnlyViolation("non-HTTP API cannot set HttpOnly cookie"))
  }
  if cookie.secure && !parsed.is_secure {
    return Err(CookieError::SecureOriginRequired("non-secure origin cannot set Secure cookie"))
  }
  if cookie.partitioned && !cookie.secure {
    return Err(CookieError::PartitionedRequiresSecure("Partitioned attribute requires Secure"))
  }
  // __Http- and __Host-Http- also require HTTP API
  if (starts_with_ascii_icase(cookie.name, "__http-") || starts_with_ascii_icase(cookie.name, "__host-http-")) &&
  !ctx.is_http_api {
    return Err(CookieError::HttpOnlyViolation("Http prefix requires HTTP API"))
  }
  match validate_cookie_prefixes(cookie, parsed.is_secure) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  let effective_ss = match cookie.same_site {
    Some(ss) => ss
    None => self.limits.default_same_site
  }
  if same_site_eq(effective_ss, SameSite::None) && !cookie.secure {
    return Err(CookieError::SecureOriginRequired("SameSite=None requires Secure"))
  }

  // Domain validation & PSL check (RFC 6265bis §5.7)
  let (domain, host_only) = match cookie.domain {
    Some(raw_d) => {
      let mut d = ascii_lower_str(raw_d)
      if d.length() > 0 && d.code_unit_at(0) == 46 {
        d = d.slice(1, d.length())
      }
      if d.length() == 0 {
        (parsed.host, true)
      } else if is_psl_with_mode(d, self.limits.include_private_psl) {
        if d == parsed.host {
          (parsed.host, true)
        } else {
          return Err(CookieError::PublicSuffixRejected(d))
        }
      } else if !domain_matches(parsed.host, d) {
        return Err(CookieError::DomainMismatch(d))
      } else {
        (d, false)
      }
    }
    None => (parsed.host, true)
  }

  let path = match cookie.path {
    Some(p) => p
    None => default_path(parsed.path)
  }

  let partition_key : Option[String] = if cookie.partitioned {
    Some(compute_partition_key(ctx, parsed, self.limits.include_private_psl))
  } else {
    None
  }

  // Expiry computation: Max-Age takes precedence over Expires
  let (persistent, expiry_time) : (Bool, Option[Int64]) = match cookie.max_age {
    Some(ma) =>
    if ma <= 0L {
      (true, Some(ctx.now_unix_secs - 1L))
    } else {
      let capped = match self.limits.max_lifetime_secs {
        Some(cap) => if ma > cap { cap } else { ma }
        None => ma
      }
      (true, Some(saturating_add_i64(ctx.now_unix_secs, capped)))
    }
    None =>
    match cookie.expires {
      Some(exp) => {
        let capped = match self.limits.max_lifetime_secs {
          Some(cap) => {
            let max_exp = saturating_add_i64(ctx.now_unix_secs, cap)
            if exp > max_exp { max_exp } else { exp }
          }
          None => exp
        }
        (true, Some(capped))
      }
      None => (false, None)
    }
  }

  // Find existing cookie with identical (name, domain, path, partition_key)
  let mut existing_idx = -1
  let mut i = 0
  while i < self.cookies.length() {
    let c = self.cookies[i]
    if c.name == cookie.name &&
    c.domain == domain &&
    c.path == path &&
    opt_string_eq(c.partition_key, partition_key) {
      existing_idx = i
      break
    }
    i = i + 1
  }

  let mut creation_time = ctx.now_unix_secs
  if existing_idx >= 0 {
    let old = self.cookies[existing_idx]
    if old.http_only && !ctx.is_http_api {
      return Err(CookieError::HttpOnlyViolation("non-HTTP API cannot overwrite HttpOnly cookie"))
    }
    if old.secure && !parsed.is_secure {
      return Err(CookieError::SecureOriginRequired("non-secure origin cannot overwrite Secure cookie"))
    }
    creation_time = old.creation_time
    remove_at(self.cookies, existing_idx)
  }

  // If already expired, do not store (any prior cookie with the same key was deleted above)
  match expiry_time {
    Some(exp) =>
    if exp <= ctx.now_unix_secs {
      return Ok(false)
    }
    None => ()
  }

  // Enforce per-domain limit
  if self.limits.max_cookies_per_domain <= 0 || self.limits.max_cookies <= 0 {
    return Ok(false)
  }
  while count_domain_cookies(self.cookies, domain) >= self.limits.max_cookies_per_domain {
    let victim = pick_eviction_victim(self.cookies, Some(domain), ctx.now_unix_secs)
    if victim < 0 {
      break
    }
    remove_at(self.cookies, victim)
  }
  // Enforce global limit
  while self.cookies.length() >= self.limits.max_cookies {
    let victim = pick_eviction_victim(self.cookies, None, ctx.now_unix_secs)
    if victim < 0 {
      break
    }
    remove_at(self.cookies, victim)
  }

  let stored = StoredCookie::{
    name: cookie.name,
    value: cookie.value,
    domain: domain,
    host_only: host_only,
    path: path,
    secure: cookie.secure,
    http_only: cookie.http_only,
    same_site: effective_ss,
    partitioned: cookie.partitioned,
    partition_key: partition_key,
    creation_time: creation_time,
    last_access_time: ctx.now_unix_secs,
    expiry_time: expiry_time,
    persistent: persistent,
  }
  self.cookies.push(stored)
  self.next_seq = self.next_seq + 1L
  Ok(true)
}

///| Parse and store a raw `Set-Cookie` header value under `ctx`.
pub fn CookieJar::store_set_cookie(
  self : CookieJar,
  header : String,
  ctx : RequestContext,
) -> Result[Bool, CookieError] {
  let opts = ParseOptions::new(
    self.limits.max_cookie_bytes,
    self.limits.max_attribute_bytes,
    self.limits.default_same_site,
  )
  let cookie = match parse_set_cookie_with_options(header, opts) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  self.store_cookie(cookie, ctx)
}

fn cookie_should_send_samesite(c : StoredCookie, ctx : RequestContext) -> Bool {
  if ctx.is_same_site {
    return true
  }
  match c.same_site {
    SameSite::None => true
    SameSite::Lax => ctx.is_top_level_navigation && ctx.is_safe_method
    SameSite::Strict => false
  }
}

///| Retrieve all cookies matching `ctx`, ordered per RFC 6265bis §5.8.3
///| (longest path first, then earliest `creation_time`), updating `last_access_time`.
pub fn CookieJar::matching_cookies(
  self : CookieJar,
  ctx : RequestContext,
) -> Result[Array[StoredCookie], CookieError] {
  let parsed = match parse_request_url(ctx.url) {
    Ok(u) => u
    Err(e) => return Err(e)
  }
  let req_pkey = compute_partition_key(ctx, parsed, self.limits.include_private_psl)

  let matched : Array[StoredCookie] = []
  let mut i = 0
  while i < self.cookies.length() {
    let c = self.cookies[i]
    if is_cookie_expired(c, ctx.now_unix_secs) {
      i = i + 1
      continue
    }
    let dom_ok = if c.host_only {
      parsed.host == c.domain
    } else {
      domain_matches(parsed.host, c.domain)
    }
    if !dom_ok {
      i = i + 1
      continue
    }
    if !path_matches(parsed.path, c.path) {
      i = i + 1
      continue
    }
    if c.secure && !parsed.is_secure {
      i = i + 1
      continue
    }
    if c.http_only && !ctx.is_http_api {
      i = i + 1
      continue
    }
    if !cookie_should_send_samesite(c, ctx) {
      i = i + 1
      continue
    }
    // CHIPS partition isolation:
    // Partitioned cookies only match when their partition_key equals the request's top-level site.
    // Unpartitioned cookies (partition_key == None) match any top-level site.
    match c.partition_key {
      Some(pk) =>
      if pk != req_pkey {
        i = i + 1
        continue
      }
      None => ()
    }
    let updated = StoredCookie::{
      name: c.name,
      value: c.value,
      domain: c.domain,
      host_only: c.host_only,
      path: c.path,
      secure: c.secure,
      http_only: c.http_only,
      same_site: c.same_site,
      partitioned: c.partitioned,
      partition_key: c.partition_key,
      creation_time: c.creation_time,
      last_access_time: ctx.now_unix_secs,
      expiry_time: c.expiry_time,
      persistent: c.persistent,
    }
    self.cookies[i] = updated
    matched.push(updated)
    i = i + 1
  }

  // Insertion sort (stable): longest path first, then earliest creation_time
  let mut a = 1
  while a < matched.length() {
    let key = matched[a]
    let mut b = a - 1
    while b >= 0 {
      let cur = matched[b]
      let swap = if key.path.length() != cur.path.length() {
        key.path.length() > cur.path.length()
      } else {
        key.creation_time < cur.creation_time
      }
      if swap {
        matched[b + 1] = cur
        b = b - 1
      } else {
        break
      }
    }
    matched[b + 1] = key
    a = a + 1
  }

  Ok(matched)
}

///| Build the `Cookie` request header string for `ctx`, or `None` if no cookies match.
pub fn CookieJar::cookie_header(
  self : CookieJar,
  ctx : RequestContext,
) -> Result[Option[String], CookieError] {
  let list = match self.matching_cookies(ctx) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if list.length() == 0 {
    return Ok(None)
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < list.length() {
    if i > 0 {
      sb.write_string("; ")
    }
    let c = list[i]
    if c.name.length() > 0 {
      sb.write_string(c.name)
      sb.write_string("=")
      sb.write_string(c.value)
    } else {
      sb.write_string(c.value)
    }
    i = i + 1
  }
  Ok(Some(sb.to_string()))
}

///| Remove all cookies from the jar.
pub fn CookieJar::clear(self : CookieJar) -> Unit {
  while self.cookies.length() > 0 {
    let _ = self.cookies.pop()
  }
}

///| Remove all cookies belonging to `domain` (case-insensitive exact domain match).
///| Returns the number of cookies removed.
pub fn CookieJar::clear_domain(self : CookieJar, domain : String) -> Int {
  let target = ascii_lower_str(domain)
  let mut removed = 0
  let mut i = 0
  while i < self.cookies.length() {
    if self.cookies[i].domain == target {
      remove_at(self.cookies, i)
      removed = removed + 1
    } else {
      i = i + 1
    }
  }
  removed
}

///| Remove all cookies expired at or before `now_unix_secs`.
///| Returns the number of cookies removed.
pub fn CookieJar::purge_expired(self : CookieJar, now_unix_secs : Int64) -> Int {
  let mut removed = 0
  let mut i = 0
  while i < self.cookies.length() {
    if is_cookie_expired(self.cookies[i], now_unix_secs) {
      remove_at(self.cookies, i)
      removed = removed + 1
    } else {
      i = i + 1
    }
  }
  removed
}

fn escape_field(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i) & 255
    if c == 92 {
      sb.write_string("\\\\")
    } else if c == 9 {
      sb.write_string("\\t")
    } else if c == 10 {
      sb.write_string("\\n")
    } else if c == 13 {
      sb.write_string("\\r")
    } else {
      let b = Bytes::new(1)
      b[0] = c.to_byte()
      sb.write_string(b.to_string())
    }
    i = i + 1
  }
  sb.to_string()
}

fn unescape_field(s : String) -> Result[String, CookieError] {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i) & 255
    if c == 92 {
      if i + 1 >= n {
        return Err(CookieError::InvalidFormat("dangling escape"))
      }
      let next = s.code_unit_at(i + 1) & 255
      if next == 92 {
        sb.write_string("\\")
      } else if next == 116 {
        sb.write_string("\t")
      } else if next == 110 {
        sb.write_string("\n")
      } else if next == 114 {
        sb.write_string("\r")
      } else {
        return Err(CookieError::InvalidFormat("unknown escape sequence"))
      }
      i = i + 2
    } else {
      let b = Bytes::new(1)
      b[0] = c.to_byte()
      sb.write_string(b.to_string())
      i = i + 1
    }
  }
  Ok(sb.to_string())
}

///| Serialize the jar to a deterministic tab-separated text format (version 1).
pub fn CookieJar::export_text(self : CookieJar) -> String {
  let sb = StringBuilder::new()
  sb.write_string("# pion-cookie-jar v1\n")
  let mut i = 0
  while i < self.cookies.length() {
    let c = self.cookies[i]
    sb.write_string(escape_field(c.name))
    sb.write_string("\t")
    sb.write_string(escape_field(c.value))
    sb.write_string("\t")
    sb.write_string(escape_field(c.domain))
    sb.write_string("\t")
    sb.write_string(if c.host_only { "1" } else { "0" })
    sb.write_string("\t")
    sb.write_string(escape_field(c.path))
    sb.write_string("\t")
    sb.write_string(if c.secure { "1" } else { "0" })
    sb.write_string("\t")
    sb.write_string(if c.http_only { "1" } else { "0" })
    sb.write_string("\t")
    sb.write_string(same_site_to_string(c.same_site))
    sb.write_string("\t")
    sb.write_string(if c.partitioned { "1" } else { "0" })
    sb.write_string("\t")
    match c.partition_key {
      Some(pk) => sb.write_string(escape_field(pk))
      None => sb.write_string("-")
    }
    sb.write_string("\t")
    sb.write_string(i64_to_decimal(c.creation_time))
    sb.write_string("\t")
    sb.write_string(i64_to_decimal(c.last_access_time))
    sb.write_string("\t")
    match c.expiry_time {
      Some(exp) => sb.write_string(i64_to_decimal(exp))
      None => sb.write_string("-")
    }
    sb.write_string("\n")
    i = i + 1
  }
  sb.to_string()
}

fn split_tabs(line : String) -> Array[String] {
  let parts : Array[String] = []
  let n = line.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || line.code_unit_at(i) == 9 {
      parts.push(line.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  parts
}

fn parse_i64_strict(s : String) -> Result[Int64, CookieError] {
  match parse_max_age_value(s, 0, s.length()) {
    Some(v) => Ok(v)
    None => Err(CookieError::InvalidFormat("invalid integer: " + s))
  }
}

///| Import cookies from `export_text()` output. Returns number of imported cookies.
pub fn CookieJar::import_text(self : CookieJar, data : String) -> Result[Int, CookieError] {
  let n = data.length()
  let mut pos = 0
  let mut count = 0
  while pos < n {
    let start = pos
    while pos < n && data.code_unit_at(pos) != 10 {
      pos = pos + 1
    }
    let mut end = pos
    if end > start && data.code_unit_at(end - 1) == 13 {
      end = end - 1
    }
    if pos < n {
      pos = pos + 1
    }
    if start >= end || data.code_unit_at(start) == 35 {
      continue
    }
    let cols = split_tabs(data.slice(start, end))
    if cols.length() != 13 {
      return Err(CookieError::InvalidFormat("expected 13 columns in jar export"))
    }
    let name = match unescape_field(cols[0]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let value = match unescape_field(cols[1]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let domain = match unescape_field(cols[2]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let host_only = cols[3] == "1"
    let path = match unescape_field(cols[4]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let secure = cols[5] == "1"
    let http_only = cols[6] == "1"
    let same_site = if cols[7] == "Strict" {
      SameSite::Strict
    } else if cols[7] == "None" {
      SameSite::None
    } else {
      SameSite::Lax
    }
    let partitioned = cols[8] == "1"
    let partition_key : Option[String] = if cols[9] == "-" {
      None
    } else {
      match unescape_field(cols[9]) {
        Ok(v) => Some(v)
        Err(e) => return Err(e)
      }
    }
    let creation_time = match parse_i64_strict(cols[10]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let last_access_time = match parse_i64_strict(cols[11]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (persistent, expiry_time) : (Bool, Option[Int64]) = if cols[12] == "-" {
      (false, None)
    } else {
      match parse_i64_strict(cols[12]) {
        Ok(v) => (true, Some(v))
        Err(e) => return Err(e)
      }
    }
    self.cookies.push(StoredCookie::{
      name: name,
      value: value,
      domain: domain,
      host_only: host_only,
      path: path,
      secure: secure,
      http_only: http_only,
      same_site: same_site,
      partitioned: partitioned,
      partition_key: partition_key,
      creation_time: creation_time,
      last_access_time: last_access_time,
      expiry_time: expiry_time,
      persistent: persistent,
    })
    count = count + 1
  }
  Ok(count)
}
