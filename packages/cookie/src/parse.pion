///| RFC 6265bis Set-Cookie / Cookie parsing, formatting, domain/path matching,
///| URL scoping, and cookie prefix validation.

fn is_wsp(c : Int) -> Bool {
  c == 32 || c == 9
}

fn is_forbidden_ctl(c : Int) -> Bool {
  (c >= 0 && c <= 8) || (c >= 10 && c <= 31) || c == 127
}

fn has_forbidden_ctl(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i) & 255
    if is_forbidden_ctl(c) {
      return true
    }
    i = i + 1
  }
  false
}

fn trim_wsp_bounds(s : String, start : Int, end : Int) -> (Int, Int) {
  let mut a = start
  let mut b = end
  while a < b && is_wsp(s.code_unit_at(a) & 255) {
    a = a + 1
  }
  while b > a && is_wsp(s.code_unit_at(b - 1) & 255) {
    b = b - 1
  }
  (a, b)
}

fn ascii_lower_str(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i) & 255
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let b = Bytes::new(n)
  let mut j = 0
  while j < n {
    let c = s.code_unit_at(j) & 255
    b[j] = (if c >= 65 && c <= 90 { c + 32 } else { c }).to_byte()
    j = j + 1
  }
  b.to_string()
}

fn eq_ascii_icase(s : String, start : Int, end : Int, lower_lit : String) -> Bool {
  let len = end - start
  if len != lower_lit.length() {
    return false
  }
  let mut i = 0
  while i < len {
    let mut c = s.code_unit_at(start + i) & 255
    if c >= 65 && c <= 90 {
      c = c + 32
    }
    if c != (lower_lit.code_unit_at(i) & 255) {
      return false
    }
    i = i + 1
  }
  true
}

fn starts_with_ascii_icase(s : String, lower_prefix : String) -> Bool {
  let plen = lower_prefix.length()
  if s.length() < plen {
    return false
  }
  eq_ascii_icase(s, 0, plen, lower_prefix)
}

fn strip_url_tabs_newlines(s : String) -> String {
  let n = s.length()
  let mut has_ignorable = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 9 || c == 10 || c == 13 {
      has_ignorable = true
      break
    }
    i = i + 1
  }
  if !has_ignorable {
    return s
  }
  let sb = StringBuilder::new()
  let mut j = 0
  while j < n {
    let c = s.code_unit_at(j)
    if c != 9 && c != 10 && c != 13 {
      sb.write_byte((c & 255).to_byte())
    }
    j = j + 1
  }
  sb.to_string()
}

fn replace_backslashes_with_slashes(s : String) -> String {
  let n = s.length()
  let mut has_bs = false
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 92 {
      has_bs = true
      break
    }
    i = i + 1
  }
  if !has_bs {
    return s
  }
  let b = Bytes::new(n)
  let mut j = 0
  while j < n {
    let c = s.code_unit_at(j) & 255
    b[j] = (if c == 92 { 47 } else { c }).to_byte()
    j = j + 1
  }
  b.to_string()
}

///| Parse a request URL into scheme, lowercased host, path, and secure-scheme flag.
pub fn parse_request_url(raw_url : String) -> Result[ParsedUrl, CookieError] {
  let url = strip_url_tabs_newlines(raw_url)
  let n = url.length()
  if n == 0 {
    return Err(CookieError::InvalidUrl("empty url"))
  }
  // Find "://"
  let mut sep = -1
  let mut i = 0
  while i + 2 < n {
    if url.code_unit_at(i) == 58 && url.code_unit_at(i + 1) == 47 && url.code_unit_at(i + 2) == 47 {
      sep = i
      break
    }
    i = i + 1
  }
  if sep <= 0 {
    return Err(CookieError::InvalidUrl("missing scheme"))
  }
  let scheme = ascii_lower_str(url.slice(0, sep))
  let is_secure = scheme == "https" || scheme == "wss"
  let is_special = scheme == "http" || scheme == "https" || scheme == "ws" || scheme == "wss" || scheme == "ftp"

  let auth_start = sep + 3
  // Authority ends at '/', '?', '#', or '\' (for WHATWG special schemes), or end of string
  let mut auth_end = auth_start
  while auth_end < n {
    let c = url.code_unit_at(auth_end)
    if c == 47 || c == 63 || c == 35 || (is_special && c == 92) {
      break
    }
    auth_end = auth_end + 1
  }
  if auth_end == auth_start {
    return Err(CookieError::InvalidUrl("empty host"))
  }
  // Strip optional userinfo '@'
  let mut host_start = auth_start
  let mut k = auth_start
  while k < auth_end {
    if url.code_unit_at(k) == 64 {
      host_start = k + 1
    }
    k = k + 1
  }
  if host_start >= auth_end {
    return Err(CookieError::InvalidUrl("empty host after userinfo"))
  }

  let mut host_end = auth_end
  if url.code_unit_at(host_start) == 91 {
    // IPv6 literal [...]
    let mut rb = host_start + 1
    while rb < auth_end && url.code_unit_at(rb) != 93 {
      rb = rb + 1
    }
    if rb >= auth_end {
      return Err(CookieError::InvalidUrl("unterminated IPv6 host"))
    }
    host_end = rb + 1
  } else {
    // Strip optional :port
    let mut p = host_start
    while p < auth_end {
      if url.code_unit_at(p) == 58 {
        host_end = p
        break
      }
      p = p + 1
    }
  }
  if host_end <= host_start {
    return Err(CookieError::InvalidUrl("empty host"))
  }
  let mut host = ascii_lower_str(url.slice(host_start, host_end))
  // Strip single trailing dot on host
  if host.length() > 1 && host.code_unit_at(host.length() - 1) == 46 {
    host = host.slice(0, host.length() - 1)
  }

  // Extract path up to '?' or '#'
  let path = if auth_end < n && (url.code_unit_at(auth_end) == 47 || (is_special && url.code_unit_at(auth_end) == 92)) {
    let mut path_end = auth_end
    while path_end < n {
      let c = url.code_unit_at(path_end)
      if c == 63 || c == 35 {
        break
      }
      path_end = path_end + 1
    }
    let raw_path = url.slice(auth_end, path_end)
    if is_special {
      replace_backslashes_with_slashes(raw_path)
    } else {
      raw_path
    }
  } else {
    "/"
  }

  Ok(ParsedUrl::{ scheme: scheme, host: host, path: path, is_secure: is_secure })
}

///| RFC 6265 §5.1.4 default-path algorithm.
pub fn default_path(request_path : String) -> String {
  let n = request_path.length()
  if n == 0 || request_path.code_unit_at(0) != 47 {
    return "/"
  }
  let mut last_slash = -1
  let mut i = 1
  while i < n {
    if request_path.code_unit_at(i) == 47 {
      last_slash = i
    }
    i = i + 1
  }
  if last_slash <= 0 {
    "/"
  } else {
    request_path.slice(0, last_slash)
  }
}

///| RFC 6265 §5.1.3 domain-match algorithm.
pub fn domain_matches(host : String, domain : String) -> Bool {
  let h = ascii_lower_str(host)
  let d = ascii_lower_str(domain)
  if h == d {
    return true
  }
  if is_ip_address(h) || is_ip_address(d) {
    return false
  }
  let hlen = h.length()
  let dlen = d.length()
  if hlen <= dlen {
    return false
  }
  let diff = hlen - dlen
  if h.code_unit_at(diff - 1) != 46 {
    return false
  }
  let mut i = 0
  while i < dlen {
    if h.code_unit_at(diff + i) != d.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| RFC 6265 §5.1.4 path-match algorithm.
pub fn path_matches(request_path : String, cookie_path : String) -> Bool {
  if request_path == cookie_path {
    return true
  }
  let rlen = request_path.length()
  let clen = cookie_path.length()
  if clen == 0 || rlen < clen {
    return false
  }
  let mut i = 0
  while i < clen {
    if request_path.code_unit_at(i) != cookie_path.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  cookie_path.code_unit_at(clen - 1) == 47 || request_path.code_unit_at(clen) == 47
}

///| Validate RFC 6265bis §4.1.3 / §5.6 / §5.7 step 22 cookie name prefixes:
///| `__Secure-`, `__Host-`, `__Http-`, and `__Host-Http-` (case-insensitive).
pub fn validate_cookie_prefixes(cookie : Cookie, is_secure_origin : Bool) -> Result[Unit, CookieError] {
  if cookie.name.length() == 0 {
    if starts_with_ascii_icase(cookie.value, "__secure-") ||
    starts_with_ascii_icase(cookie.value, "__host-") ||
    starts_with_ascii_icase(cookie.value, "__http-") ||
    starts_with_ascii_icase(cookie.value, "__host-http-") {
      return Err(
        CookieError::PrefixViolation("nameless cookie value cannot begin with reserved prefix"),
      )
    }
    return Ok(())
  }
  let has_domain = match cookie.domain {
    Some(d) => d.length() > 0
    None => false
  }
  let is_root_path = match cookie.path {
    Some(p) => p == "/"
    None => false
  }
  if starts_with_ascii_icase(cookie.name, "__host-http-") {
    if !cookie.secure || !is_secure_origin || !cookie.http_only || has_domain || !is_root_path {
      return Err(
        CookieError::PrefixViolation(
          "__Host-Http- requires Secure, secure origin, HttpOnly, no Domain, and Path=/",
        ),
      )
    }
    return Ok(())
  }
  if starts_with_ascii_icase(cookie.name, "__http-") {
    if !cookie.secure || !is_secure_origin || !cookie.http_only {
      return Err(CookieError::PrefixViolation("__Http- requires Secure, secure origin, and HttpOnly"))
    }
    return Ok(())
  }
  if starts_with_ascii_icase(cookie.name, "__host-") {
    if !cookie.secure || !is_secure_origin || has_domain || !is_root_path {
      return Err(
        CookieError::PrefixViolation("__Host- requires Secure, secure origin, no Domain, and Path=/"),
      )
    }
    return Ok(())
  }
  if starts_with_ascii_icase(cookie.name, "__secure-") {
    if !cookie.secure || !is_secure_origin {
      return Err(CookieError::PrefixViolation("__Secure- requires Secure and secure origin"))
    }
    return Ok(())
  }
  Ok(())
}

///| Parse RFC 6265bis §5.6.2 Max-Age integer with overflow clamping.
fn parse_max_age_value(s : String, start : Int, end : Int) -> Option[Int64] {
  if start >= end {
    return None
  }
  let mut i = start
  let mut neg = false
  if s.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
  }
  if i >= end {
    return None
  }
  let mut acc : Int64 = 0L
  let limit : Int64 = 922337203685477580L // (2^63 - 1) / 10
  let mut clamped = false
  while i < end {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    if !clamped {
      let d = (c - 48).to_int64()
      if acc > limit || (acc == limit && d > 7L) {
        acc = 9223372036854775807L
        clamped = true
      } else {
        acc = acc * 10L + d
      }
    }
    i = i + 1
  }
  if neg {
    if acc == 0L {
      Some(0L)
    } else {
      Some(0L - acc)
    }
  } else {
    Some(acc)
  }
}

///| Parse an RFC 6265bis §5.6 `Set-Cookie` header value with custom options.
pub fn parse_set_cookie_with_options(header : String, opts : ParseOptions) -> Result[Cookie, CookieError] {
  if has_forbidden_ctl(header) {
    return Err(CookieError::InvalidHeader("control character in Set-Cookie"))
  }
  let n = header.length()
  // Find first ';'
  let mut semi = n
  let mut i = 0
  while i < n {
    if header.code_unit_at(i) == 59 {
      semi = i
      break
    }
    i = i + 1
  }

  // Find first '=' inside [0, semi)
  let mut eq = -1
  let mut j = 0
  while j < semi {
    if header.code_unit_at(j) == 61 {
      eq = j
      break
    }
    j = j + 1
  }

  let (name, value) = if eq < 0 {
    let (vs, ve) = trim_wsp_bounds(header, 0, semi)
    ("", header.slice(vs, ve))
  } else {
    let (ns, ne) = trim_wsp_bounds(header, 0, eq)
    let (vs, ve) = trim_wsp_bounds(header, eq + 1, semi)
    (header.slice(ns, ne), header.slice(vs, ve))
  }

  if name.length() == 0 && value.length() == 0 {
    return Err(CookieError::InvalidHeader("empty cookie name and value"))
  }
  if name.length() + value.length() > opts.max_cookie_bytes {
    return Err(CookieError::SizeExceeded("cookie name+value exceeds max_cookie_bytes"))
  }

  let mut expires : Option[Int64] = None
  let mut max_age : Option[Int64] = None
  let mut domain : Option[String] = None
  let mut path : Option[String] = None
  let mut secure = false
  let mut http_only = false
  let mut same_site : Option[SameSite] = None
  let mut partitioned = false

  let mut pos = semi
  while pos < n {
    // Skip ';'
    pos = pos + 1
    let attr_start = pos
    while pos < n && header.code_unit_at(pos) != 59 {
      pos = pos + 1
    }
    let attr_end = pos
    if attr_start >= attr_end {
      continue
    }

    let mut aeq = -1
    let mut k = attr_start
    while k < attr_end {
      if header.code_unit_at(k) == 61 {
        aeq = k
        break
      }
      k = k + 1
    }
    let (ans, ane) = if aeq < 0 {
      trim_wsp_bounds(header, attr_start, attr_end)
    } else {
      trim_wsp_bounds(header, attr_start, aeq)
    }
    let (avs, ave) = if aeq < 0 {
      (attr_end, attr_end)
    } else {
      trim_wsp_bounds(header, aeq + 1, attr_end)
    }
    if ans >= ane {
      continue
    }
    if ave - avs > opts.max_attribute_bytes {
      continue
    }

    if eq_ascii_icase(header, ans, ane, "expires") {
      match parse_cookie_date(header.slice(avs, ave)) {
        Ok(ts) => expires = Some(ts)
        Err(_) => ()
      }
    } else if eq_ascii_icase(header, ans, ane, "max-age") {
      match parse_max_age_value(header, avs, ave) {
        Some(v) => max_age = Some(v)
        None => ()
      }
    } else if eq_ascii_icase(header, ans, ane, "domain") {
      if avs < ave {
        let ds = if header.code_unit_at(avs) == 46 { avs + 1 } else { avs }
        if ds < ave {
          domain = Some(ascii_lower_str(header.slice(ds, ave)))
        }
      }
    } else if eq_ascii_icase(header, ans, ane, "path") {
      if avs < ave && header.code_unit_at(avs) == 47 {
        path = Some(header.slice(avs, ave))
      } else {
        path = None
      }
    } else if eq_ascii_icase(header, ans, ane, "secure") {
      secure = true
    } else if eq_ascii_icase(header, ans, ane, "httponly") {
      http_only = true
    } else if eq_ascii_icase(header, ans, ane, "samesite") {
      if eq_ascii_icase(header, avs, ave, "strict") {
        same_site = Some(SameSite::Strict)
      } else if eq_ascii_icase(header, avs, ave, "lax") {
        same_site = Some(SameSite::Lax)
      } else if eq_ascii_icase(header, avs, ave, "none") {
        same_site = Some(SameSite::None)
      } else {
        same_site = None
      }
    } else if eq_ascii_icase(header, ans, ane, "partitioned") {
      partitioned = true
    }
  }

  Ok(Cookie::{
    name: name,
    value: value,
    expires: expires,
    max_age: max_age,
    domain: domain,
    path: path,
    secure: secure,
    http_only: http_only,
    same_site: same_site,
    partitioned: partitioned,
  })
}

///| Parse an RFC 6265bis §5.6 `Set-Cookie` header value with default options.
pub fn parse_set_cookie(header : String) -> Result[Cookie, CookieError] {
  parse_set_cookie_with_options(header, ParseOptions::default())
}

fn contains_byte(s : String, target : Int) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if (s.code_unit_at(i) & 255) == target {
      return true
    }
    i = i + 1
  }
  false
}

///| Deterministic `Int64` to decimal string formatter.
fn i64_to_decimal(v : Int64) -> String {
  if v == 0L {
    return "0"
  }
  let mut neg = false
  let mut n = v
  let buf = Bytes::new(21)
  let mut pos = 20
  if n < 0L {
    neg = true
    // Handle Int64::MIN safely
    let last = -(n % 10L)
    buf[pos] = (48 + last.to_int()).to_byte()
    pos = pos - 1
    n = -(n / 10L)
  }
  while n > 0L {
    let d = (n % 10L).to_int()
    buf[pos] = (48 + d).to_byte()
    pos = pos - 1
    n = n / 10L
  }
  if neg {
    buf[pos] = 45.to_byte()
    pos = pos - 1
  }
  let start = pos + 1
  let out = Bytes::new(21 - start)
  let mut i = 0
  while start + i < 21 {
    out[i] = buf[start + i]
    i = i + 1
  }
  out.to_string()
}

///| Format a `Cookie` into a valid `Set-Cookie` header value, rejecting injection chars.
pub fn format_set_cookie(cookie : Cookie) -> Result[String, CookieError] {
  if cookie.name.length() == 0 && cookie.value.length() == 0 {
    return Err(CookieError::InvalidName("empty name and value"))
  }
  if has_forbidden_ctl(cookie.name) || contains_byte(cookie.name, 59) || contains_byte(cookie.name, 61) {
    return Err(CookieError::InvalidName("forbidden character in cookie name"))
  }
  if has_forbidden_ctl(cookie.value) || contains_byte(cookie.value, 59) {
    return Err(CookieError::InvalidValue("forbidden character in cookie value"))
  }
  let sb = StringBuilder::new()
  if cookie.name.length() > 0 {
    sb.write_string(cookie.name)
    sb.write_string("=")
    sb.write_string(cookie.value)
  } else {
    if contains_byte(cookie.value, 61) {
      sb.write_string("=")
    }
    sb.write_string(cookie.value)
  }
  match cookie.expires {
    Some(ts) => {
      sb.write_string("; Expires=")
      sb.write_string(format_cookie_date(ts))
    }
    None => ()
  }
  match cookie.max_age {
    Some(ma) => {
      sb.write_string("; Max-Age=")
      sb.write_string(i64_to_decimal(ma))
    }
    None => ()
  }
  match cookie.domain {
    Some(d) => {
      if has_forbidden_ctl(d) || contains_byte(d, 59) {
        return Err(CookieError::InvalidFormat("forbidden character in Domain"))
      }
      sb.write_string("; Domain=")
      sb.write_string(d)
    }
    None => ()
  }
  match cookie.path {
    Some(p) => {
      if has_forbidden_ctl(p) || contains_byte(p, 59) {
        return Err(CookieError::InvalidFormat("forbidden character in Path"))
      }
      sb.write_string("; Path=")
      sb.write_string(p)
    }
    None => ()
  }
  if cookie.secure {
    sb.write_string("; Secure")
  }
  if cookie.http_only {
    sb.write_string("; HttpOnly")
  }
  match cookie.same_site {
    Some(ss) => {
      sb.write_string("; SameSite=")
      sb.write_string(same_site_to_string(ss))
    }
    None => ()
  }
  if cookie.partitioned {
    sb.write_string("; Partitioned")
  }
  Ok(sb.to_string())
}

///| Parse an HTTP `Cookie` request header into name-value pairs.
pub fn parse_cookie_header(header : String) -> Result[Array[CookiePair], CookieError] {
  if has_forbidden_ctl(header) {
    return Err(CookieError::InvalidHeader("control character in Cookie header"))
  }
  let out : Array[CookiePair] = []
  let n = header.length()
  let mut pos = 0
  while pos < n {
    let start = pos
    while pos < n && header.code_unit_at(pos) != 59 {
      pos = pos + 1
    }
    let end = pos
    if pos < n {
      pos = pos + 1
    }
    let (ps, pe) = trim_wsp_bounds(header, start, end)
    if ps >= pe {
      continue
    }
    let mut eq = -1
    let mut k = ps
    while k < pe {
      if header.code_unit_at(k) == 61 {
        eq = k
        break
      }
      k = k + 1
    }
    if eq < 0 {
      out.push(CookiePair::new("", header.slice(ps, pe)))
    } else {
      let (ns, ne) = trim_wsp_bounds(header, ps, eq)
      let (vs, ve) = trim_wsp_bounds(header, eq + 1, pe)
      out.push(CookiePair::new(header.slice(ns, ne), header.slice(vs, ve)))
    }
  }
  Ok(out)
}

///| Format `CookiePair` entries into a `Cookie:` request header value.
pub fn format_cookie_header(pairs : Array[CookiePair]) -> Result[String, CookieError] {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < pairs.length() {
    let p = pairs[i]
    if has_forbidden_ctl(p.name) || contains_byte(p.name, 59) || contains_byte(p.name, 61) {
      return Err(CookieError::InvalidName("forbidden character in CookiePair name"))
    }
    if has_forbidden_ctl(p.value) || contains_byte(p.value, 59) {
      return Err(CookieError::InvalidValue("forbidden character in CookiePair value"))
    }
    if i > 0 {
      sb.write_string("; ")
    }
    if p.name.length() > 0 {
      sb.write_string(p.name)
      sb.write_string("=")
      sb.write_string(p.value)
    } else {
      sb.write_string(p.value)
    }
    i = i + 1
  }
  Ok(sb.to_string())
}
