///| Extreme-value sweep of the public API (`cookie_audit api`). Every line must be identical in the 4 build modes and
///| no call may trap. Lines starting with `!` are invariant violations (counted in the last line).

import "cookie"

///|
fn date_chars_ok(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 32 || c == 44 || c == 58
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

///|
pub fn run_api() -> String {
  let sb = StringBuilder::new()
  let mut bad = 0
  let ts : Array[Int64] = [
    0L, -1L, 1L, 86399L, 86400L, -86400L, 951782400L, 951868799L, 4107542400L, -2208988800L, -11644473600L, -11644473601L,
    253402300799L, 253402300800L, 9223372036854775807L, -9223372036854775807L - 1L, 1700000000L, -62135596800L,
  ]
  let mut i = 0
  while i < ts.length() {
    let f = cookie::format_cookie_date(ts[i])
    let back = match cookie::parse_cookie_date(f) {
      Ok(v) => v.to_string()
      Err(_) => "ERR"
    }
    let inv = ts[i] >= -11644473600L && ts[i] <= 253402300799L
    let ok = date_chars_ok(f) && (!inv || back == ts[i].to_string())
    if !ok {
      bad = bad + 1
    }
    sb.write_string((if ok { "" } else { "!" }) + "date " + ts[i].to_string() + " -> " + esc(f) + " -> " + back + "\n")
    i = i + 1
  }
  let mas = [
    "0", "-0", "1", "-1", "+1", "9223372036854775807", "9223372036854775808", "-9223372036854775808", "99999999999999999999",
    "-99999999999999999999", "00000000000000000000000000001", "1e3", " 7 ", "0x10", "",
  ]
  let mut j = 0
  while j < mas.length() {
    let r = match cookie::parse_set_cookie("a=b; Max-Age=" + mas[j]) {
      Ok(c) => opt_i(c.max_age)
      Err(e) => "ERR:" + err_name(e)
    }
    sb.write_string("max-age " + esc(mas[j]) + " -> " + r + "\n")
    j = j + 1
  }
  // CookieJar at extreme clocks: saturating expiry arithmetic must not trap or wrap
  let nows : Array[Int64] = [0L, 9223372036854775807L, -9223372036854775807L - 1L, 9223372036854775000L]
  let hdrs = ["a=1; Max-Age=0", "b=2; Max-Age=99999999999999999999", "c=3; Expires=Fri, 31 Dec 9999 23:59:59 GMT", "d=4"]
  let mut k = 0
  while k < nows.length() {
    let jar = cookie::CookieJar::with_limits(
      cookie::JarLimits::new(10, 10, 4096, 1024, cookie::SameSite::Lax, None, true),
    )
    let mut m = 0
    let row = StringBuilder::new()
    while m < hdrs.length() {
      let r = match jar.store_set_cookie(hdrs[m], cookie::RequestContext::http("https://e.com/", nows[k])) {
        Ok(true) => "1"
        Ok(false) => "0"
        Err(_) => "E"
      }
      row.write_string(r)
      m = m + 1
    }
    let all = jar.all_cookies()
    let mut q = 0
    while q < all.length() {
      row.write_string(" " + all[q].name + ":" + opt_i(all[q].expiry_time))
      q = q + 1
    }
    sb.write_string("jar now=" + nows[k].to_string() + " " + row.to_string() + "\n")
    k = k + 1
  }
  // format_set_cookie with extreme Max-Age / Expires values
  let c0 = cookie::Cookie::new("a", "b")
  let fs = [
    cookie::format_set_cookie(c0.with_max_age(-9223372036854775807L - 1L)),
    cookie::format_set_cookie(c0.with_max_age(9223372036854775807L)),
    cookie::format_set_cookie(c0.with_expires(253402300800L)),
    cookie::format_set_cookie(c0.with_expires(-9223372036854775807L - 1L)),
  ]
  let mut z = 0
  while z < fs.length() {
    let r = match fs[z] {
      Ok(s) => esc(s)
      Err(e) => "ERR:" + err_name(e)
    }
    sb.write_string("format " + z.to_string() + " " + r + "\n")
    z = z + 1
  }
  sb.write_string("violations=" + bad.to_string() + "\n")
  sb.to_string()
}
