///| Red-team CLI for `packages/cookie` (native + wasm32, see ../REPORT.md).
///|   parse <file>  -> one line per Set-Cookie input: parse_set_cookie + format_set_cookie + re-parse
///|   date <file>   -> parse_cookie_date + format_cookie_date
///|   psl <file>    -> public_suffix / registrable_domain / is_public_suffix (+ ICANN-only) / public_suffix_info
///|   match <file>  -> `dm\t<host>\t<domain>`, `pm\t<request-path>\t<cookie-path>`, `url\t<url>`, `chdr\t<header>`
///|   jar <file>    -> CookieJar scenarios (protocol in ../diff/gen.py), one output line per operation
///|   time <mode> <file> <iters> -> run <mode> over <file> <iters> times, print `<us> <lines> <fnv>`
///|   api           -> extreme-value sweep of the public API (dates, Max-Age, sizes)
///|   list | case <name> -> red-team / control cases (src/cases.pion)
///| Inputs that start with `hex:` are given as hex bytes. Output strings are escaped with `esc` (bytes outside
///| 0x21..0x7E, and `%`, `|`, `\`, are written as %XX), so every output line is ASCII.

import "cookie"

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Decode the `hex:` form of an input; other inputs are returned as they are.
pub fn decode_input(s : String) -> String {
  if s.length() < 4 || s.slice(0, 4) != "hex:" {
    return s
  }
  let sb = StringBuilder::new()
  let mut i = 4
  while i + 1 < s.length() {
    sb.write_byte(((hexval(s.code_unit_at(i)) << 4) | hexval(s.code_unit_at(i + 1))).to_byte())
    i = i + 2
  }
  sb.to_string()
}

///|
fn hexdigit(v : Int) -> Int {
  if v < 10 {
    48 + v
  } else {
    55 + v
  }
}

///| Escape a string so that the output is printable ASCII without `|`, `%`, `\` or space.
pub fn esc(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i) & 255
    if c > 32 && c < 127 && c != 37 && c != 124 && c != 92 {
      sb.write_byte(c.to_byte())
    } else {
      sb.write_byte(37.to_byte())
      sb.write_byte(hexdigit(c >> 4).to_byte())
      sb.write_byte(hexdigit(c & 15).to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn err_name(e : cookie::CookieError) -> String {
  match e {
    cookie::CookieError::InvalidName(_) => "InvalidName"
    cookie::CookieError::InvalidValue(_) => "InvalidValue"
    cookie::CookieError::InvalidHeader(_) => "InvalidHeader"
    cookie::CookieError::InvalidDate(_) => "InvalidDate"
    cookie::CookieError::InvalidUrl(_) => "InvalidUrl"
    cookie::CookieError::SizeExceeded(_) => "SizeExceeded"
    cookie::CookieError::PrefixViolation(_) => "PrefixViolation"
    cookie::CookieError::PartitionedRequiresSecure(_) => "PartitionedRequiresSecure"
    cookie::CookieError::PublicSuffixRejected(_) => "PublicSuffixRejected"
    cookie::CookieError::DomainMismatch(_) => "DomainMismatch"
    cookie::CookieError::SecureOriginRequired(_) => "SecureOriginRequired"
    cookie::CookieError::HttpOnlyViolation(_) => "HttpOnlyViolation"
    cookie::CookieError::InvalidFormat(_) => "InvalidFormat"
  }
}

///|
pub fn b01(b : Bool) -> String {
  if b {
    "1"
  } else {
    "0"
  }
}

///|
pub fn opt_s(o : Option[String]) -> String {
  match o {
    Some(s) => esc(s)
    None => "-"
  }
}

///|
pub fn opt_i(o : Option[Int64]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "-"
  }
}

///|
pub fn ss_s(o : Option[cookie::SameSite]) -> String {
  match o {
    Some(s) => cookie::same_site_to_string(s)
    None => "-"
  }
}

///| Canonical one-line description of a parsed `Cookie` (no format / re-parse).
pub fn cookie_line(c : cookie::Cookie) -> String {
  "n=" +
  esc(c.name) +
  " v=" +
  esc(c.value) +
  " e=" +
  opt_i(c.expires) +
  " m=" +
  opt_i(c.max_age) +
  " d=" +
  opt_s(c.domain) +
  " p=" +
  opt_s(c.path) +
  " s=" +
  b01(c.secure) +
  " h=" +
  b01(c.http_only) +
  " ss=" +
  ss_s(c.same_site) +
  " pt=" +
  b01(c.partitioned)
}

///| `parse` protocol: `ERR <variant>` or `OK <cookie_line> F=<format_set_cookie> R=<1 if re-parse is identical>`.
pub fn parse_line(input : String) -> String {
  match cookie::parse_set_cookie(input) {
    Err(e) => "ERR " + err_name(e)
    Ok(c) => {
      let base = cookie_line(c)
      match cookie::format_set_cookie(c) {
        Err(e) => "OK " + base + " F=ERR:" + err_name(e) + " R=-"
        Ok(f) => {
          let r = match cookie::parse_set_cookie(f) {
            Ok(c2) => b01(cookie_line(c2) == base)
            Err(_) => "E"
          }
          "OK " + base + " F=" + esc(f) + " R=" + r
        }
      }
    }
  }
}

///| `date` protocol: `OK <unix secs> <format_cookie_date>` or `ERR`.
pub fn date_line(input : String) -> String {
  match cookie::parse_cookie_date(input) {
    Ok(t) => "OK " + t.to_string() + " " + esc(cookie::format_cookie_date(t))
    Err(_) => "ERR"
  }
}

///|
fn sec_s(s : cookie::PslSection) -> String {
  match s {
    cookie::PslSection::Icann => "I"
    cookie::PslSection::Private => "P"
    cookie::PslSection::Unlisted => "U"
  }
}

///|
fn info_s(o : Option[cookie::PslMatch]) -> String {
  match o {
    Some(m) => esc(m.suffix) + "," + sec_s(m.section) + b01(m.is_exception) + b01(m.is_wildcard)
    None => "-"
  }
}

///| `psl` protocol: `ps|psi|rd|rdi|is_ps is_ps_icann|info(all)|info(icann)`.
pub fn psl_line(d : String) -> String {
  opt_s(cookie::public_suffix(d)) +
  "|" +
  opt_s(cookie::public_suffix_icann(d)) +
  "|" +
  opt_s(cookie::registrable_domain(d)) +
  "|" +
  opt_s(cookie::registrable_domain_icann(d)) +
  "|" +
  b01(cookie::is_public_suffix(d)) +
  b01(cookie::is_public_suffix_icann(d)) +
  "|" +
  info_s(cookie::public_suffix_info(d, true)) +
  "|" +
  info_s(cookie::public_suffix_info(d, false))
}

///|
pub fn split_tabs(line : String) -> Array[String] {
  let parts : Array[String] = []
  let n = line.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || line.code_unit_at(i) == 9 {
      parts.push(decode_input(line.slice(start, i)))
      start = i + 1
    }
    i = i + 1
  }
  parts
}

///| `match` protocol (domain_matches, path_matches, parse_request_url + default_path, Cookie header round trip).
pub fn match_line(line : String) -> String {
  let f = split_tabs(line)
  if f.length() >= 3 && f[0] == "dm" {
    return "dm " + b01(cookie::domain_matches(f[1], f[2]))
  }
  if f.length() >= 3 && f[0] == "pm" {
    return "pm " + b01(cookie::path_matches(f[1], f[2]))
  }
  if f.length() >= 2 && f[0] == "url" {
    return match cookie::parse_request_url(f[1]) {
      Ok(u) =>
      "url " +
      esc(u.scheme) +
      " " +
      esc(u.host) +
      " " +
      esc(u.path) +
      " " +
      b01(u.is_secure) +
      " dp=" +
      esc(cookie::default_path(u.path))
      Err(e) => "url ERR " + err_name(e)
    }
  }
  if f.length() >= 2 && f[0] == "chdr" {
    return match cookie::parse_cookie_header(f[1]) {
      Ok(pairs) => {
        let sb = StringBuilder::new()
        sb.write_string("chdr OK " + pairs.length().to_string())
        let mut i = 0
        while i < pairs.length() {
          sb.write_string(" " + esc(pairs[i].name) + "=" + esc(pairs[i].value))
          i = i + 1
        }
        match cookie::format_cookie_header(pairs) {
          Ok(h) => sb.write_string(" F=" + esc(h))
          Err(e) => sb.write_string(" F=ERR:" + err_name(e))
        }
        sb.to_string()
      }
      Err(e) => "chdr ERR " + err_name(e)
    }
  }
  "bad"
}

///|
pub fn parse_i64(s : String) -> Int64 {
  let mut acc = 0L
  let mut neg = false
  let mut i = 0
  if s.length() > 0 && s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10L + (c - 48).to_int64()
    }
    i = i + 1
  }
  if neg {
    0L - acc
  } else {
    acc
  }
}

///|
pub fn parse_uint(s : String) -> Int {
  parse_i64(s).to_int()
}

///| Build a `RequestContext` from jar protocol fields `now url top http same nav safe` starting at `k`.
pub fn ctx_of(f : Array[String], k : Int) -> cookie::RequestContext {
  let top = if f[k + 2] == "-" { None } else { Some(f[k + 2]) }
  cookie::RequestContext::new(f[k + 1], top, f[k + 3] == "1", f[k + 4] == "1", parse_i64(f[k])).with_navigation(
    f[k + 5] == "1",
    f[k + 6] == "1",
  )
}

///|
pub fn stored_line(c : cookie::StoredCookie) -> String {
  "c " +
  esc(c.name) +
  " " +
  esc(c.value) +
  " " +
  esc(c.domain) +
  " ho=" +
  b01(c.host_only) +
  " " +
  esc(c.path) +
  " s=" +
  b01(c.secure) +
  " h=" +
  b01(c.http_only) +
  " ss=" +
  cookie::same_site_to_string(c.same_site) +
  " pt=" +
  b01(c.partitioned) +
  " pk=" +
  opt_s(c.partition_key) +
  " ct=" +
  c.creation_time.to_string() +
  " la=" +
  c.last_access_time.to_string() +
  " ex=" +
  opt_i(c.expiry_time) +
  " pe=" +
  b01(c.persistent)
}

///|
fn limits_of(f : Array[String]) -> cookie::JarLimits {
  let d = cookie::JarLimits::default()
  cookie::JarLimits::new(
    parse_uint(f[1]),
    parse_uint(f[2]),
    d.max_cookie_bytes,
    d.max_attribute_bytes,
    d.default_same_site,
    if f[3] == "-" { None } else { Some(parse_i64(f[3])) },
    f[4] == "1",
  )
}

///| Run a jar scenario file. Lines (tab separated, any field may use `hex:`):
///|   `=== <name>` new default jar | `limits max per_domain lifetime|- private(0/1)` new jar with limits
///|   `set now url top|- http same nav safe <Set-Cookie>` | `get now url top|- http same nav safe`
///|   `dump` | `rt` (export -> import -> export) | `purge now` | `cleardom domain` | `bulkimport n domain`
pub fn run_jar(text : String) -> String {
  let out = StringBuilder::new()
  let mut jar = cookie::CookieJar::new()
  let lines = split_lines(text)
  let mut li = 0
  while li < lines.length() {
    let line = lines[li]
    li = li + 1
    if line.length() >= 3 && line.slice(0, 3) == "===" {
      jar = cookie::CookieJar::new()
      out.write_string(line + "\n")
      continue
    }
    let f = split_tabs(line)
    let op = f[0]
    if op == "limits" && f.length() >= 5 {
      jar = cookie::CookieJar::with_limits(limits_of(f))
      out.write_string("limits\n")
    } else if op == "set" && f.length() >= 9 {
      let r = match jar.store_set_cookie(f[8], ctx_of(f, 1)) {
        Ok(true) => "OK1"
        Ok(false) => "OK0"
        Err(e) => "ERR:" + err_name(e)
      }
      out.write_string("set " + r + "\n")
    } else if op == "get" && f.length() >= 8 {
      let r = match jar.cookie_header(ctx_of(f, 1)) {
        Ok(Some(h)) => esc(h)
        Ok(None) => "<none>"
        Err(e) => "ERR:" + err_name(e)
      }
      out.write_string("get " + r + "\n")
    } else if op == "dump" {
      let all = jar.all_cookies()
      out.write_string("dump " + all.length().to_string() + "\n")
      let mut i = 0
      while i < all.length() {
        out.write_string(stored_line(all[i]) + "\n")
        i = i + 1
      }
    } else if op == "rt" {
      let e1 = jar.export_text()
      let j2 = cookie::CookieJar::new()
      let r = match j2.import_text(e1) {
        Ok(n) => n.to_string() + " " + b01(j2.export_text() == e1)
        Err(e) => "ERR:" + err_name(e)
      }
      out.write_string("rt " + r + "\n")
    } else if op == "purge" && f.length() >= 2 {
      out.write_string("purge " + jar.purge_expired(parse_i64(f[1])).to_string() + "\n")
    } else if op == "bulkimport" && f.length() >= 3 {
      // `bulkimport n domain`: import n distinct host-only cookies for `domain` through import_text
      let n = parse_uint(f[1])
      let sb = StringBuilder::new()
      sb.write_string("# pion-cookie-jar v1\n")
      let mut k = 0
      while k < n {
        sb.write_string("c" + k.to_string() + "\t1\t" + f[2] + "\t1\t/\t0\t0\tLax\t0\t-\t1700000000\t1700000000\t-\n")
        k = k + 1
      }
      let r = match jar.import_text(sb.to_string()) {
        Ok(c) => c.to_string()
        Err(e) => "ERR:" + err_name(e)
      }
      out.write_string("bulkimport " + r + "\n")
    } else if op == "cleardom" && f.length() >= 2 {
      out.write_string("cleardom " + jar.clear_domain(f[1]).to_string() + "\n")
    } else {
      out.write_string("bad\n")
    }
  }
  out.to_string()
}

///|
pub fn split_lines(data : String) -> Array[String] {
  let out : Array[String] = []
  let n = data.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if data.code_unit_at(i) == 10 {
      out.push(data.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(data.slice(start, n))
  }
  out
}

///| Run line mode `mode` over `text`.
pub fn run_mode(mode : String, text : String) -> String {
  if mode == "jar" {
    return run_jar(text)
  }
  let lines = split_lines(text)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let input = decode_input(lines[i])
    let r = if mode == "parse" {
      parse_line(input)
    } else if mode == "date" {
      date_line(input)
    } else if mode == "psl" {
      psl_line(input)
    } else {
      match_line(lines[i])
    }
    sb.write_string(r)
    sb.write_byte(10.to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn fnv(h : UInt64, s : String) -> UInt64 {
  let mut x = h
  let mut i = 0
  while i < s.length() {
    x = (x ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  x
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: cookie_audit parse|date|psl|match|jar <file> | time <mode> <file> <iters> | api | list | case <name>")
    return 2
  }
  let mode = args[1]
  if (mode == "parse" || mode == "date" || mode == "psl" || mode == "match" || mode == "jar") && args.length() >= 3 {
    let text = match fs_read_bytes(world, args[2]) {
      Ok(b) => b.to_string()
      Err(_) => {
        io_eprintln(world, "cannot read " + args[2])
        return 2
      }
    }
    io_print(world, run_mode(mode, text))
    return 0
  }
  if mode == "time" && args.length() >= 5 {
    let text = match fs_read_bytes(world, args[3]) {
      Ok(b) => b.to_string()
      Err(_) => return 2
    }
    let iters = parse_uint(args[4])
    let t0 = clock_monotonic_us()
    let mut h = 14695981039346656037UL
    let mut k = 0
    while k < iters {
      h = fnv(h, run_mode(args[2], text))
      k = k + 1
    }
    let t1 = clock_monotonic_us()
    io_println(world, (t1 - t0).to_string() + " " + split_lines(text).length().to_string() + " " + h.to_string())
    return 0
  }
  if mode == "api" {
    io_print(world, run_api())
    return 0
  }
  if mode == "list" {
    io_println(world, case_names().join(" "))
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = run_case(args[2])
    io_println(world, (if r == "" { "PASS " } else { "FAIL " }) + args[2] + (if r == "" { "" } else { " :: " + r }))
    return 0
  }
  io_println(world, "bad arguments")
  2
}
