///| Red-team and control cases for `packages/cookie` (see ../REPORT.md). Every case returns "" on PASS or a failure
///| reason. `redteam_p<sev>_<n>_*` cases assert what a conforming implementation must do (draft-ietf-httpbis-
///| rfc6265bis-22, CHIPS, the WHATWG URL Standard, cited per case) and FAIL while finding P<sev>-<n> is open; they
///| accept every conforming outcome (a rejected cookie may surface as `Err` or as `Ok(false)`), so a fixed tree passes
///| without touching this file. `control_*` cases pin attacks and edge cases the package already handles.
///| The same functions run under `pionc test` (control_test.pion / redteam_test.pion) and, one process per case, under
///| `cookie_audit case <name>` in native debug/release and wasm32 debug/release (run_audit.sh).

import "cookie"

///|
let t0 : Int64 = 1700000000L

///|
fn https(url : String) -> cookie::RequestContext {
  cookie::RequestContext::http(url, t0)
}

///|
fn ctx(
  url : String,
  top : Option[String],
  http : Bool,
  same : Bool,
  nav : Bool,
  safe : Bool,
  now : Int64,
) -> cookie::RequestContext {
  cookie::RequestContext::new(url, top, http, same, now).with_navigation(nav, safe)
}

///| Store a Set-Cookie header; true when the jar reports it stored.
fn put(jar : cookie::CookieJar, h : String, c : cookie::RequestContext) -> Bool {
  match jar.store_set_cookie(h, c) {
    Ok(b) => b
    Err(_) => false
  }
}

///|
fn hdr(jar : cookie::CookieJar, c : cookie::RequestContext) -> String {
  match jar.cookie_header(c) {
    Ok(Some(h)) => h
    Ok(None) => ""
    Err(e) => "ERR:" + err_name(e)
  }
}

///|
fn contains(hay : String, needle : String) -> Bool {
  let n = hay.length()
  let m = needle.length()
  if m == 0 {
    return true
  }
  let mut i = 0
  while i + m <= n {
    if hay.slice(i, i + m) == needle {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn has_ctl(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c < 32 || c == 127 {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn p(h : String) -> Result[cookie::Cookie, String] {
  match cookie::parse_set_cookie(h) {
    Ok(c) => Ok(c)
    Err(e) => Err(esc(h) + " -> Err(" + err_name(e) + ")")
  }
}

///| Expect `jar.cookie_header(c)` == `want`.
fn want_hdr(jar : cookie::CookieJar, c : cookie::RequestContext, want : String, what : String) -> String {
  let got = hdr(jar, c)
  if got == want {
    ""
  } else {
    what + ": Cookie header for " + esc(c.url) + " is `" + esc(got) + "`, want `" + esc(want) + "`"
  }
}

///|
fn first_fail(rs : Array[String]) -> String {
  let mut i = 0
  while i < rs.length() {
    if rs[i] != "" {
      return rs[i]
    }
    i = i + 1
  }
  ""
}

///|
fn expect_stored(jar : cookie::CookieJar, h : String, c : cookie::RequestContext, want : Bool, what : String) -> String {
  let got = put(jar, h, c)
  if got == want {
    ""
  } else {
    what + ": `" + esc(h) + "` from " + esc(c.url) + (if want { " was rejected" } else { " was stored" })
  }
}

// ---------------------------------------------------------------------------------------------------------------
// Red-team cases (FAIL while the finding is open)
// ---------------------------------------------------------------------------------------------------------------

///| P1-1 — draft-22 §5.7 step 22: a nameless cookie whose value starts with `__Secure-` / `__Host-` (any case) must
///| be ignored; otherwise `Set-Cookie: =__Host-sid=evil` from http:// or a sibling subdomain reaches the server as
///| `Cookie: __Host-sid=evil` (§5.8.3 step 6 serialises a nameless cookie as its bare value).
fn redteam_p1_1_nameless_prefix() -> String {
  let jar = cookie::CookieJar::new()
  let rs = [
    expect_stored(jar, "=__Host-sid=evil", https("http://example.com/"), false, "nameless __Host- from http"),
    expect_stored(jar, "__Secure-sid=evil", https("http://example.com/"), false, "nameless __Secure- (no '=')"),
    expect_stored(jar, "=__sEcUrE-sid=evil; Path=/", https("https://example.com/"), false, "nameless __sEcUrE- (no Secure)"),
    expect_stored(jar, "=__HOST-sid=evil; Secure; Path=/", https("https://example.com/"), false, "nameless __HOST- with Secure"),
    expect_stored(
      jar, "=__Host-sid=evil; Domain=example.com; Path=/", https("https://sub.example.com/"), false, "nameless __Host- from a subdomain",
    ),
  ]
  let f = first_fail(rs)
  if f != "" {
    return f
  }
  let h = hdr(jar, https("https://example.com/"))
  if contains(h, "__") {
    return "server would read a prefixed cookie: Cookie: " + esc(h)
  }
  // a nameless cookie without a prefix stays legal
  expect_stored(jar, "=plain", https("https://example.com/"), true, "nameless non-prefixed cookie")
}

///| P1-2 — draft-22 §5.7 step 16 ("leave secure cookies alone"): a non-secure origin must not create a cookie whose
///| name matches an existing Secure cookie when the domains domain-match either way and the new path path-matches the
///| existing one. Without it http://example.com/ shadows `sid` (longer path is sent first, §5.8.3) or plants one on a
///| subdomain.
fn redteam_p1_2_leave_secure_alone() -> String {
  let jar = cookie::CookieJar::new()
  let r0 = expect_stored(jar, "sid=good; Secure; Path=/", https("https://example.com/"), true, "secure cookie")
  if r0 != "" {
    return r0
  }
  let rs = [
    expect_stored(jar, "sid=evil; Path=/app", https("http://example.com/"), false, "insecure shadow with a longer path"),
    expect_stored(jar, "sid=evil; Path=/", https("http://a.example.com/"), false, "insecure host-only shadow on a subdomain"),
    want_hdr(jar, https("https://example.com/app/x"), "sid=good", "secure cookie shadowed"),
  ]
  let f = first_fail(rs)
  if f != "" {
    return f
  }
  // the step's own example: an insecure 'a' may still be set for a path that does not path-match '/login'
  let j2 = cookie::CookieJar::new()
  let _ = put(j2, "a=1; Secure; Path=/login", https("https://example.com/"))
  expect_stored(j2, "a=2; Path=/foo", https("http://example.com/"), true, "insecure cookie outside the secure path")
}

///| P1-3 — draft-22 §5.7 step 23: cookies are identified by (name, domain, host-only-flag, path). Ignoring the
///| host-only-flag lets any sibling subdomain replace or delete the parent's host-only (even HttpOnly) cookie with
///| `Domain=example.com`, instead of only adding a second cookie.
fn redteam_p1_3_host_only_identity() -> String {
  let jar = cookie::CookieJar::new()
  let r0 = expect_stored(jar, "sid=victim; HttpOnly; Secure; Path=/", https("https://example.com/"), true, "victim")
  if r0 != "" {
    return r0
  }
  let _ = put(jar, "sid=attacker; Domain=example.com; Secure; Path=/", https("https://evil.example.com/"))
  let h = hdr(jar, https("https://example.com/"))
  if !contains(h, "sid=victim") {
    return "host-only cookie replaced by a sibling's Domain cookie: Cookie: " + esc(h)
  }
  let _ = put(jar, "sid=; Domain=example.com; Secure; Path=/; Max-Age=0", https("https://evil.example.com/"))
  let h2 = hdr(jar, https("https://example.com/"))
  if !contains(h2, "sid=victim") {
    return "host-only cookie deleted by a sibling's Domain cookie: Cookie: " + esc(h2)
  }
  ""
}

///| P1-4 — draft-22 §5.7 step 18: a cookie whose same-site-flag is not "None" (Strict, Lax, or Default when the
///| attribute is missing) must be ignored when it comes from a cross-site request that is not a top-level navigation,
///| or from a non-HTTP API in a cross-site context.
fn redteam_p1_4_cross_site_set() -> String {
  let jar = cookie::CookieJar::new()
  let xs = ctx("https://victim.com/api", Some("https://evil.com"), true, false, false, true, t0)
  let nav = ctx("https://victim.com/", Some("https://evil.com"), true, false, true, true, t0)
  let doc = ctx("https://victim.com/", Some("https://evil.com"), false, false, false, true, t0)
  first_fail([
    expect_stored(jar, "csrf=attacker; Path=/", xs, false, "cross-site subresource, SameSite missing (Default)"),
    expect_stored(jar, "s=attacker; SameSite=Strict; Path=/", xs, false, "cross-site subresource, Strict"),
    expect_stored(jar, "l=attacker; SameSite=Lax; Path=/", xs, false, "cross-site subresource, Lax"),
    expect_stored(jar, "d=attacker; Path=/", doc, false, "non-HTTP API in a cross-site context"),
    expect_stored(jar, "n=ok; SameSite=None; Secure; Path=/", xs, true, "cross-site SameSite=None; Secure"),
    expect_stored(jar, "t=ok; SameSite=Strict; Path=/", nav, true, "cross-site top-level navigation"),
  ])
}

///| P1-5 — `CookieJar::store_cookie` and `import_text` are public entry points; they must apply the §5.6/§5.7 checks
///| (CTL bytes, empty name+value; `;` and a leading/trailing space cannot come out of the parser either) or
///| `cookie_header` emits CR/LF or extra cookie-pairs into the request header.
fn redteam_p1_5_store_injection() -> String {
  let jar = cookie::CookieJar::new()
  let c = https("https://e.com/")
  let evil = [
    cookie::Cookie::new("a", "b\r\nX-Injected: 1"),
    cookie::Cookie::new("a2", "b; __Host-sid=evil"),
    cookie::Cookie::new("__Host-sid=evil; a3", "x"),
    cookie::Cookie::new(" __Host-sid", "evil").with_path("/"),
    cookie::Cookie::new("a4", "nul\u{0}byte"),
  ]
  let mut i = 0
  while i < evil.length() {
    let _ = jar.store_cookie(evil[i], c)
    i = i + 1
  }
  let _ = put(jar, "ok=1", c)
  let imp = "# pion-cookie-jar v1\ninj\tv\\r\\nX-Injected: 2\te.com\t1\t/\t0\t0\tLax\t0\t-\t1700000000\t1700000000\t-\n"
  let _ = jar.import_text(imp)
  let h = hdr(jar, c)
  if has_ctl(h) {
    return "control bytes in the Cookie header: " + esc(h)
  }
  match cookie::parse_cookie_header(h) {
    Err(e) => "Cookie header does not parse (" + err_name(e) + "): " + esc(h)
    Ok(pairs) => {
      let mut k = 0
      while k < pairs.length() {
        if contains(pairs[k].name, "__Host-") || contains(pairs[k].name, "__host-") {
          return "a server would read " + esc(pairs[k].name) + "=" + esc(pairs[k].value) + " from: " + esc(h)
        }
        k = k + 1
      }
      if !contains(h, "ok=1") {
        "the legitimate cookie is missing: " + esc(h)
      } else {
        ""
      }
    }
  }
}

///| P1-6 — the WHATWG URL Standard (what browsers, `fetch` and the repository's `url` package use) treats `\` as a
///| path separator in special URLs, so `https://evil.com\@good.com/` is a request to evil.com. `parse_request_url`
///| reads the host as good.com, so good.com's cookies are sent to (and settable by) evil.com.
fn redteam_p1_6_url_host_confusion() -> String {
  match cookie::parse_request_url("https://evil.com\\@good.com/") {
    Ok(u) =>
    if u.host == "good.com" {
      return "parse_request_url(\"https://evil.com\\\\@good.com/\").host == good.com (WHATWG: evil.com)"
    }
    Err(_) => ()
  }
  let jar = cookie::CookieJar::new()
  let _ = put(jar, "sid=secret; Secure; Path=/", https("https://good.com/"))
  let h = hdr(jar, https("https://evil.com\\@good.com/"))
  if contains(h, "secret") {
    return "good.com's cookie sent to https://evil.com\\@good.com/: " + esc(h)
  }
  if put(jar, "sid=fixed; Path=/", https("https://evil.com\\@good.com/x")) &&
  contains(hdr(jar, https("https://good.com/")), "fixed") {
    return "https://evil.com\\@good.com/ set a cookie for good.com"
  }
  ""
}

///| P2-1 — draft-22 §5.6.7: an unknown SameSite value appends (SameSite, "Default"), and §5.7 step 17 takes the last
///| SameSite attribute, so `SameSite=None; SameSite=Bogus` is Default (Lax-by-default), not None. §5.8.3: the Lax
///| cross-site exemption applies only to retrievals of type "HTTP".
fn redteam_p2_1_samesite_default() -> String {
  let cases = ["a=b; SameSite=None; SameSite=Bogus", "a=b; SameSite=Strict; SameSite=", "a=b; SameSite=Lax; samesite=nonee"]
  let mut i = 0
  while i < cases.length() {
    match p(cases[i]) {
      Err(e) => return e
      Ok(c) =>
      match c.same_site {
        Some(s) => return esc(cases[i]) + " -> SameSite=" + cookie::same_site_to_string(s) + ", want Default (None)"
        None => ()
      }
    }
    i = i + 1
  }
  let jar = cookie::CookieJar::new()
  let _ = put(jar, "l=1; SameSite=Lax; Path=/", https("https://victim.com/"))
  let doc = ctx("https://victim.com/", Some("https://evil.com"), false, false, true, true, t0)
  want_hdr(jar, doc, "", "Lax cookie read by a cross-site non-HTTP retrieval")
}

///| P2-2 — draft-22 §5.6.4 + §5.7 step 11: an empty or non-`/` Path value sets the cookie-path to the default-path and
///| the last Path attribute wins, so a later invalid Path must not leave an earlier valid one in force.
fn redteam_p2_2_path_override() -> String {
  let cases = ["a=b; Path=/; Path=foo", "a=b; Path=/x; Path=", "a=b; Path=/admin; Path=admin"]
  let mut i = 0
  while i < cases.length() {
    match p(cases[i]) {
      Err(e) => return e
      Ok(c) =>
      match c.path {
        Some(s) => return esc(cases[i]) + " -> Path=" + esc(s) + ", want the default-path (None)"
        None => ()
      }
    }
    i = i + 1
  }
  ""
}

///| P2-3 — draft-22 §5.6.3 removes one leading "." of the Domain value. `parse_set_cookie` strips one and
///| `store_cookie` strips another, so `Domain=..example.com` (domain ".example.com", which no host domain-matches)
///| is accepted as example.com.
fn redteam_p2_3_domain_multidot() -> String {
  let jar = cookie::CookieJar::new()
  first_fail([
    expect_stored(jar, "a=1; Domain=..example.com", https("https://www.example.com/"), false, "Domain=..example.com"),
    expect_stored(jar, "b=1; Domain=...com", https("https://www.example.com/"), false, "Domain=...com"),
  ])
}

///| P2-4 — `format_cookie_date` / `format_set_cookie` must not produce output that re-parses to something else: years
///| outside 1601..9999 must be clamped (draft-22 §5.6.1 clamps to the representable range) or refused, and a nameless
///| cookie whose value contains '=' must not come back as a named cookie.
fn redteam_p2_4_format_date_range() -> String {
  let ts : Array[Int64] = [253402300800L, 9223372036854775807L, -9223372036854775807L - 1L, -11644473601L, -62135596800L]
  let mut i = 0
  while i < ts.length() {
    let t = ts[i]
    let f = cookie::format_cookie_date(t)
    match cookie::parse_cookie_date(f) {
      Err(_) => return "format_cookie_date(" + t.to_string() + ") = `" + esc(f) + "` does not parse back"
      Ok(back) => {
        let lo = -11644473600L
        let hi = 253402300799L
        let want = if t < lo { lo } else if t > hi { hi } else { t }
        if back != want {
          return "format_cookie_date(" +
          t.to_string() +
          ") = `" +
          esc(f) +
          "` parses back as " +
          back.to_string() +
          ", want " +
          want.to_string()
        }
      }
    }
    i = i + 1
  }
  // a nameless cookie whose value contains '=' must not be formatted as a named cookie (§5.6 step 3 on re-parse)
  match cookie::format_set_cookie(cookie::Cookie::new("", "__Host-sid=evil")) {
    Err(_) => ()
    Ok(s) =>
    match p(s) {
      Err(_) => ()
      Ok(c) =>
      if c.name != "" || c.value != "__Host-sid=evil" {
        return "format_set_cookie(name \"\", value \"__Host-sid=evil\") = `" + esc(s) + "` re-parses as name " + esc(c.name)
      }
    }
  }
  match cookie::format_set_cookie(cookie::Cookie::new("a", "b").with_expires(253402300800L)) {
    Err(_) => ""
    Ok(s) =>
    match p(s) {
      Err(e) => e
      Ok(c) =>
      match c.expires {
        Some(e) => if e < 253402300799L { "far-future Expires re-parses as " + e.to_string() + ": " + esc(s) } else { "" }
        None => "far-future Expires dropped: " + esc(s)
      }
    }
  }
}

///| P2-5 — `export_text` / `import_text` are documented as lossless; import must not turn a partitioned cookie into an
///| unpartitioned one, must reject malformed records instead of defaulting them, and must keep the jar's invariants
///| (one cookie per identity, limits, no domain cookie on a public suffix) and be all-or-nothing.
fn redteam_p2_5_export_import() -> String {
  let jar = cookie::CookieJar::new()
  let c8 = ctx("https://e.com/", Some("-"), true, false, false, true, t0)
  let _ = put(jar, "p=1; Secure; SameSite=None; Partitioned; Path=/", c8)
  let j2 = cookie::CookieJar::new()
  let _ = j2.import_text(jar.export_text())
  let other = ctx("https://e.com/", Some("https://other.example"), true, false, false, true, t0)
  if hdr(j2, other) != "" {
    return "partitioned cookie (top_level_site \"-\") leaks to another top-level site after export/import"
  }
  let hdr_line = "# pion-cookie-jar v1\n"
  let good = "a\t1\te.com\t1\t/\t0\t0\tLax\t0\t-\t1700000000\t1700000000\t-\n"
  let bads = [
    "bad\t1\te.com\t2\t/\t0\t0\tLax\t0\t-\t1700000000\t1700000000\t-\n", "bad\t1\te.com\t1\t/\t0\t0\tBogus\t0\t-\t1700000000\t1700000000\t-\n",
    "bad\t1\te.com\t1\t/\tyes\t0\tLax\t0\t-\t1700000000\t1700000000\t-\n", "bad\t1\te.com\t1\t/\t1\t0\tNone\t1\t-\t1700000000\t1700000000\t-\n",
  ]
  let mut i = 0
  while i < bads.length() {
    let j = cookie::CookieJar::new()
    match j.import_text(hdr_line + good + bads[i]) {
      // skipping a malformed record is fine, importing it is not
      Ok(_) => {
        let all = j.all_cookies()
        let mut k = 0
        while k < all.length() {
          if all[k].name == "bad" {
            return "malformed record imported: " + esc(bads[i])
          }
          k = k + 1
        }
      }
      // refusing the input is fine too, but then nothing may be kept
      Err(_) => if j.len() != 0 { return "import_text is not all-or-nothing (" + j.len().to_string() + " kept)" }
    }
    i = i + 1
  }
  // a domain cookie on a public suffix cannot be created by §5.7 step 9 and must not be sent (§5.8.3 step 3);
  // importing one would plant it on every site under the suffix
  let jp = cookie::CookieJar::new()
  let _ = jp.import_text(hdr_line + "sid\tevil\tco.uk\t0\t/\t1\t0\tNone\t0\t-\t1700000000\t1700000000\t-\n")
  if contains(hdr(jp, https("https://victim.co.uk/")), "sid=evil") {
    return "imported Domain=co.uk cookie is sent to https://victim.co.uk/"
  }
  let j3 = cookie::CookieJar::new()
  let _ = j3.import_text(hdr_line + good)
  let _ = j3.import_text(hdr_line + good)
  if j3.len() != 1 {
    return "importing the same cookie twice leaves " + j3.len().to_string() + " cookies with one identity"
  }
  let j4 = cookie::CookieJar::with_limits(cookie::JarLimits::new(2, 2, 4096, 1024, cookie::SameSite::Lax, None, true))
  let many = hdr_line +
  "a\t1\te.com\t1\t/\t0\t0\tLax\t0\t-\t1700000000\t1700000000\t-\nb\t1\te.com\t1\t/\t0\t0\tLax\t0\t-\t1700000000\t1700000000\t-\n" +
  "c\t1\te.com\t1\t/\t0\t0\tLax\t0\t-\t1700000000\t1700000000\t-\n"
  let _ = j4.import_text(many)
  if j4.len() > 2 {
    return "import_text ignores JarLimits (" + j4.len().to_string() + " cookies, max 2)"
  }
  ""
}

///| P2-7 — per-domain limits keyed by the exact domain field let one site with many host names fill the global limit
///| and evict every other site's cookies (Chrome and Firefox count per registrable domain).
fn redteam_p2_7_eviction_per_site() -> String {
  let jar = cookie::CookieJar::with_limits(cookie::JarLimits::new(40, 10, 4096, 1024, cookie::SameSite::Lax, None, true))
  let mut i = 0
  while i < 5 {
    let _ = put(jar, "v" + i.to_string() + "=1; Path=/", https("https://victim.example/"))
    i = i + 1
  }
  let mut k = 0
  while k < 60 {
    let h = "https://h" + k.to_string() + ".attacker.example/"
    let _ = put(jar, "x=1; Path=/", cookie::RequestContext::http(h, t0 + 1L + k.to_int64()))
    k = k + 1
  }
  let h = hdr(jar, https("https://victim.example/"))
  if !contains(h, "v0=1") {
    "attacker.example with 60 host names evicted victim.example's cookies (Cookie: `" + esc(h) + "`)"
  } else {
    ""
  }
}

///| P2-8 — hosts are not canonicalised (draft-22 §5.1.2 / UTS #46): a trailing-dot IPv4 literal is treated as a domain
///| name, and non-ASCII upper case / ideographic full stops are not mapped before the PSL lookup. A conforming
///| implementation either maps the host (UTS #46: NFKC + lower case, e.g. éxample.com / example.com / čáhcesuolo.no) or
///| refuses it (None); it must not return a registrable domain built from unmapped labels, which also lets an upper-case
///| or decomposed spelling of a public suffix pass the jar's PSL check.
fn redteam_p2_8_host_canonicalization() -> String {
  let rs = [
    if opt_s(cookie::public_suffix("127.0.0.1.")) != "-" { "public_suffix(\"127.0.0.1.\") is not None (IP literal)" } else { "" },
    match cookie::registrable_domain("www.Éxample.com") {
      Some(r) => if r != "éxample.com" { "registrable_domain(\"www.Éxample.com\") = " + esc(r) + ", want éxample.com or None" } else { "" }
      None => ""
    },
    match cookie::registrable_domain("x.ПР.СРБ") {
      Some(r) => if r != "x.пр.срб" { "registrable_domain(\"x.ПР.СРБ\") = " + esc(r) + ", want x.пр.срб or None" } else { "" }
      None => ""
    },
    match cookie::registrable_domain("www.\u{FF25}\u{FF38}\u{FF21}\u{FF2D}\u{FF30}\u{FF2C}\u{FF25}.com") {
      Some(r) => if r != "example.com" { "registrable_domain(\"www.ＥＸＡＭＰＬＥ.com\") = " + esc(r) + ", want example.com or None" } else { "" }
      None => ""
    },
    match cookie::registrable_domain("x.ČÁHCESUOLO.NO") {
      Some(r) => if r != "x.čáhcesuolo.no" { "registrable_domain(\"x.ČÁHCESUOLO.NO\") = " + esc(r) + ", want x.čáhcesuolo.no or None" } else { "" }
      None => ""
    },
    match cookie::registrable_domain("x.c\u{30C}a\u{301}hcesuolo.no") {
      Some(r) => if r != "x.čáhcesuolo.no" { "registrable_domain(NFD \"x.čáhcesuolo.no\") = " + esc(r) + ", want x.čáhcesuolo.no or None" } else { "" }
      None => ""
    },
    match cookie::registrable_domain("x.\u{1D41E}xample.com") {
      Some(r) => if r != "example.com" { "registrable_domain(\"x.𝐞xample.com\") = " + esc(r) + ", want example.com or None" } else { "" }
      None => ""
    },
    {
      // a PSL bypass through a non-canonical spelling of a public suffix (čáhcesuolo.no is one)
      let j = cookie::CookieJar::new()
      match j.store_set_cookie("a=1; Domain=ČÁHCESUOLO.NO", https("https://x.ČÁHCESUOLO.NO/")) {
        Ok(true) => "Domain=ČÁHCESUOLO.NO (upper-case spelling of the public suffix čáhcesuolo.no) was stored"
        _ => ""
      }
    },
    match cookie::registrable_domain("www.example\u{3002}com") {
      Some(r) => if r != "example.com" { "registrable_domain(\"www.example。com\") = " + esc(r) + ", want example.com or None" } else { "" }
      None => ""
    },
  ]
  first_fail(rs)
}

///| P2-12 — regression of the P2-8 fix (feat/pkg-cookie-fix @ 755d2d7f): refusing every combining mark also refuses
///| canonical IDN labels whose marks never compose under NFC (Thai / Lao tone marks, …). `ร้าน.ไทย` is NFC/NFKC-stable
///| and IDNA2008-valid; v0.1.0 resolved it. Only marks that take part in some canonical composition (and NFKC /
///| lower-case unstable code points) need refusing; refusing such a mark everywhere (e.g. U+093C) stays acceptable.
fn redteam_p2_12_canonical_combining_marks() -> String {
  let rs = [
    match cookie::registrable_domain("www.\u{0E23}\u{0E49}\u{0E32}\u{0E19}.\u{0E44}\u{0E17}\u{0E22}") {
      Some(r) => if r != "\u{0E23}\u{0E49}\u{0E32}\u{0E19}.\u{0E44}\u{0E17}\u{0E22}" { "registrable_domain(\"www.ร้าน.ไทย\") = " + esc(r) } else { "" }
      None => "registrable_domain(\"www.ร้าน.ไทย\") = None (canonical label refused)"
    },
    {
      let j = cookie::CookieJar::new()
      match j.store_set_cookie("a=1; Domain=\u{0E23}\u{0E49}\u{0E32}\u{0E19}.\u{0E44}\u{0E17}\u{0E22}", https("https://www.\u{0E23}\u{0E49}\u{0E32}\u{0E19}.\u{0E44}\u{0E17}\u{0E22}/")) {
        Ok(true) => ""
        Ok(false) => "Domain=ร้าน.ไทย from www.ร้าน.ไทย not stored"
        Err(e) => "Domain=ร้าน.ไทย from www.ร้าน.ไทย refused: " + err_name(e)
      }
    },
  ]
  first_fail(rs)
}

// ---------------------------------------------------------------------------------------------------------------
// Control cases (attacks / edge cases that are handled)
// ---------------------------------------------------------------------------------------------------------------

///| PSL: Domain attributes naming public suffixes (ICANN, Private, wildcard, upper case, trailing dot) are rejected;
///| exceptions and the host-equals-suffix rule (§5.7 step 9) work.
fn control_psl_domain_rejection() -> String {
  let jar = cookie::CookieJar::new()
  first_fail([
    expect_stored(jar, "a=1; Domain=co.uk", https("https://example.co.uk/"), false, "Domain=co.uk"),
    expect_stored(jar, "a=1; Domain=CO.UK", https("https://example.co.uk/"), false, "Domain=CO.UK"),
    expect_stored(jar, "a=1; Domain=co.uk.", https("https://example.co.uk/"), false, "Domain=co.uk."),
    expect_stored(jar, "a=1; Domain=.co.uk", https("https://example.co.uk/"), false, "Domain=.co.uk"),
    expect_stored(jar, "a=1; Domain=com", https("https://example.com/"), false, "Domain=com"),
    expect_stored(jar, "a=1; Domain=github.io", https("https://a.github.io/"), false, "Domain=github.io (Private)"),
    expect_stored(jar, "a=1; Domain=foo.ck", https("https://a.foo.ck/"), false, "Domain=foo.ck (*.ck)"),
    expect_stored(jar, "a=1; Domain=www.ck", https("https://a.www.ck/"), true, "Domain=www.ck (!www.ck)"),
    expect_stored(jar, "a=1; Domain=x.kawasaki.jp", https("https://a.x.kawasaki.jp/"), false, "Domain=x.kawasaki.jp"),
    expect_stored(jar, "a=1; Domain=city.kawasaki.jp", https("https://a.city.kawasaki.jp/"), true, "!city.kawasaki.jp"),
    expect_stored(jar, "b=1; Domain=co.uk", https("https://co.uk/"), true, "host == public suffix (host-only)"),
    expect_stored(jar, "a=1; Domain=example.com", https("https://example.com.evil.com/"), false, "foreign Domain"),
    expect_stored(jar, "a=1; Domain=ample.com", https("https://example.com/"), false, "partial-label Domain"),
    want_hdr(jar, https("https://www.co.uk/"), "", "host-only cookie on co.uk leaked to www.co.uk"),
  ])
}

///| IP literals: a Domain attribute must equal the IP; IPs never domain-match a suffix (1.0.0.1 vs 0.0.1).
fn control_ip_literals() -> String {
  let jar = cookie::CookieJar::new()
  first_fail([
    expect_stored(jar, "a=1; Domain=0.0.1", https("https://127.0.0.1/"), false, "Domain=0.0.1 from 127.0.0.1"),
    expect_stored(jar, "a=1; Domain=0.1", https("https://127.0.0.1/"), false, "Domain=0.1 from 127.0.0.1"),
    expect_stored(jar, "b=1; Domain=127.0.0.1", https("https://127.0.0.1/"), true, "Domain=127.0.0.1 from 127.0.0.1"),
    expect_stored(jar, "c=1", https("https://[::1]:8443/"), true, "IPv6 host-only"),
    want_hdr(jar, https("https://[::1]/"), "c=1", "IPv6 host"),
    want_hdr(jar, https("https://1.127.0.0.1/"), "", "IP cookie sent to a pseudo subdomain"),
    if cookie::domain_matches("1.0.0.1", "0.0.1") { "domain_matches(1.0.0.1, 0.0.1)" } else { "" },
    if cookie::domain_matches("127.0.0.1", "0.0.1") { "domain_matches(127.0.0.1, 0.0.1)" } else { "" },
    if opt_s(cookie::registrable_domain("127.0.0.1")) != "-" { "registrable_domain(127.0.0.1) is not None" } else { "" },
  ])
}

///| Cookie prefixes (case-insensitive since draft-14), whitespace trimming, Domain / Path / Secure / origin rules.
fn control_prefixes() -> String {
  let jar = cookie::CookieJar::new()
  let s = https("https://example.com/a/b")
  first_fail([
    expect_stored(jar, "__Host-a=1; Secure; Path=/", s, true, "valid __Host-"),
    expect_stored(jar, "__HOST-b=1; Secure", s, false, "__HOST- without Path"),
    expect_stored(jar, "__host-c=1; Secure; Path=/foo", s, false, "__host- with Path=/foo"),
    expect_stored(jar, "__Host-d=1; Secure; Path=/; Domain=example.com", s, false, "__Host- with Domain"),
    expect_stored(jar, " __Host-e=1; Path=/", s, false, "whitespace-padded __Host- without Secure"),
    expect_stored(jar, "__Host-f=1; Secure; Path=/", https("http://example.com/"), false, "__Host- from http"),
    expect_stored(jar, "__sEcUrE-g=1", s, false, "__sEcUrE- without Secure"),
    expect_stored(jar, "__Secure-h=1; Secure", s, true, "valid __Secure-"),
    expect_stored(jar, "__Secure-i=1; Secure", https("http://example.com/"), false, "__Secure- from http"),
    expect_stored(jar, "__Http-j=1; Secure", s, false, "__Http- without HttpOnly"),
    expect_stored(
      jar, "__Http-k=1; Secure; HttpOnly", ctx("https://example.com/", None, false, true, true, true, t0), false, "__Http- via non-HTTP API",
    ),
    expect_stored(jar, "__Host-Http-l=1; Secure; Path=/", s, false, "__Host-Http- without HttpOnly"),
    expect_stored(jar, "__Host-Http-m=1; Secure; HttpOnly; Path=/", s, true, "valid __Host-Http-"),
  ])
}

///| CTL / `;` / CRLF injection through the parsers and formatters.
fn control_ctl_injection() -> String {
  let bad = ["a=b\r\nSet-Cookie: x=y", "a=b\nc", "a=\u{0}b", "a=b; Path=/\r", "a=b\u{7f}", "a\u{1}=b", "a=b; Domain=e.com\u{0}.evil"]
  let mut i = 0
  while i < bad.length() {
    match cookie::parse_set_cookie(bad[i]) {
      Ok(_) => return "accepted CTL: " + esc(bad[i])
      Err(_) => ()
    }
    i = i + 1
  }
  match cookie::parse_set_cookie("a=b\tc; Path=/") {
    Ok(c) => if c.value != "b\tc" { return "HTAB not kept inside the value" }
    Err(_) => return "HTAB rejected"
  }
  let fails = [
    cookie::format_set_cookie(cookie::Cookie::new("a", "b\r\nX: 1")),
    cookie::format_set_cookie(cookie::Cookie::new("a", "b; c=d")),
    cookie::format_set_cookie(cookie::Cookie::new("a=b", "c")),
    cookie::format_set_cookie(cookie::Cookie::new("a", "b").with_path("/;x")),
    cookie::format_set_cookie(cookie::Cookie::new("a", "b").with_domain("e.com\r\n")),
    cookie::format_cookie_header([cookie::CookiePair::new("a", "b\n")]),
    cookie::format_cookie_header([cookie::CookiePair::new("a;b", "c")]),
  ]
  let mut k = 0
  while k < fails.length() {
    match fails[k] {
      Ok(s) => return "formatter accepted injection #" + k.to_string() + ": " + esc(s)
      Err(_) => ()
    }
    k = k + 1
  }
  match cookie::parse_cookie_header("a=1; b=2\r\nX: y") {
    Ok(_) => "parse_cookie_header accepted CRLF"
    Err(_) => ""
  }
}

///| CHIPS: Partitioned requires Secure; partition key = schemeful site of the top-level (port / subdomain ignored).
fn control_chips() -> String {
  let jar = cookie::CookieJar::new()
  let a = ctx("https://embed.example/", Some("https://a.com"), true, false, false, true, t0)
  let a_sub = ctx("https://embed.example/", Some("https://www.a.com:8443/x"), true, false, false, true, t0)
  let a_http = ctx("https://embed.example/", Some("http://a.com"), true, false, false, true, t0)
  let b = ctx("https://embed.example/", Some("https://b.com"), true, false, false, true, t0)
  first_fail([
    expect_stored(jar, "p=0; Partitioned; SameSite=None", a, false, "Partitioned without Secure"),
    expect_stored(jar, "p=1; Secure; Partitioned; SameSite=None; Path=/", a, true, "partitioned under a.com"),
    want_hdr(jar, a_sub, "p=1", "same site, other subdomain / port"),
    want_hdr(jar, b, "", "other top-level site"),
    want_hdr(jar, a_http, "", "other scheme"),
    expect_stored(jar, "p=2; Secure; Partitioned; SameSite=None; Path=/", b, true, "same name under b.com"),
    want_hdr(jar, a, "p=1", "a.com partition overwritten from b.com"),
    want_hdr(jar, b, "p=2", "b.com partition"),
  ])
}

///| SameSite enforcement at retrieval; SameSite=None requires Secure.
fn control_samesite() -> String {
  let jar = cookie::CookieJar::new()
  let _ = put(jar, "st=1; SameSite=Strict; Path=/", https("https://v.com/"))
  let _ = put(jar, "lx=1; SameSite=Lax; Path=/", https("https://v.com/"))
  let _ = put(jar, "nn=1; SameSite=None; Secure; Path=/", https("https://v.com/"))
  let sub = ctx("https://v.com/", Some("https://e.com"), true, false, false, true, t0)
  let navg = ctx("https://v.com/", Some("https://e.com"), true, false, true, true, t0)
  let navp = ctx("https://v.com/", Some("https://e.com"), true, false, true, false, t0)
  first_fail([
    expect_stored(jar, "x=1; SameSite=None", https("https://v.com/"), false, "SameSite=None without Secure"),
    want_hdr(jar, sub, "nn=1", "cross-site subresource"),
    want_hdr(jar, navg, "lx=1; nn=1", "cross-site top-level GET"),
    want_hdr(jar, navp, "nn=1", "cross-site top-level POST"),
    want_hdr(jar, https("https://v.com/"), "st=1; lx=1; nn=1", "same-site"),
  ])
}

///| HttpOnly and Secure isolation.
fn control_httponly_secure() -> String {
  let jar = cookie::CookieJar::new()
  let doc = ctx("https://v.com/", None, false, true, true, true, t0)
  let _ = put(jar, "h=1; HttpOnly; Path=/", https("https://v.com/"))
  let _ = put(jar, "s=1; Secure; Path=/", https("https://v.com/"))
  first_fail([
    expect_stored(jar, "x=1; HttpOnly", doc, false, "non-HTTP API sets HttpOnly"),
    expect_stored(jar, "h=2; Path=/", doc, false, "non-HTTP API overwrites HttpOnly"),
    expect_stored(jar, "s2=1; Secure", https("http://v.com/"), false, "http sets Secure"),
    expect_stored(jar, "s=2; Path=/", https("http://v.com/"), false, "http overwrites Secure"),
    want_hdr(jar, doc, "s=1", "non-HTTP read"),
    want_hdr(jar, https("http://v.com/"), "h=1", "http read"),
  ])
}

///| RFC 6265bis §5.1.1 dates: 2-digit years, leap years, < 1601, 24:00:00, alternative formats, no overflow.
fn control_dates() -> String {
  let ok = [
    ("Sun, 06 Nov 1994 08:49:37 GMT", 784111777L), ("Sunday, 06-Nov-94 08:49:37 GMT", 784111777L), ("Sun Nov  6 08:49:37 1994", 784111777L),
    ("Thu, 01 Jan 70 00:00:00 GMT", 0L), ("Sat, 01 Jan 00 00:00:00 GMT", 946684800L), ("01 Jan 69 00:00:00", 3124224000L),
    ("29 Feb 2000 12:00:00", 951825600L), ("29 Feb 2024 00:00:00", 1709164800L), ("1 jan 1601 0:0:0", -11644473600L),
    ("31 Dec 9999 23:59:59", 253402300799L), ("Wed, 09 Jun 2021 10:18:14 GMT-0000 junk", 1623233894L),
  ]
  let mut i = 0
  while i < ok.length() {
    let (s, want) = ok[i]
    match cookie::parse_cookie_date(s) {
      Ok(v) => if v != want { return esc(s) + " -> " + v.to_string() + ", want " + want.to_string() }
      Err(_) => return esc(s) + " rejected"
    }
    i = i + 1
  }
  let bad = [
    "29 Feb 1900 00:00:00", "30 Feb 2024 00:00:00", "31 Apr 2024 00:00:00", "31 Dec 1600 23:59:59", "01 Jan 2024 24:00:00",
    "01 Jan 2024 23:60:00", "01 Jan 2024 23:59:60", "01 Jan 12345 00:00:00", "Jan 2024 00:00:00", "01 2024 00:00:00",
    "01 Jan 2024", "0 Jan 2024 00:00:00", "001 Jan 2024 00:00:00", "01 Jan 2024 000:00:00",
  ]
  let mut k = 0
  while k < bad.length() {
    match cookie::parse_cookie_date(bad[k]) {
      Ok(v) => return esc(bad[k]) + " accepted as " + v.to_string()
      Err(_) => ()
    }
    k = k + 1
  }
  ""
}

///| Max-Age (§5.6.2): only `-`? DIGIT+, precedence over Expires, <= 0 expires, overflow clamps, 400-day cap.
fn control_max_age() -> String {
  let cases = [
    ("a=b; Max-Age=+5", "-"), ("a=b; Max-Age=5x", "-"), ("a=b; Max-Age= 7 ", "7"), ("a=b; Max-Age=-", "-"),
    ("a=b; Max-Age=-5", "-5"), ("a=b; Max-Age=99999999999999999999", "9223372036854775807"),
    ("a=b; Max-Age=-99999999999999999999", "-9223372036854775807"), ("a=b; Max-Age=1; Max-Age=bogus", "1"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (h, want) = cases[i]
    match p(h) {
      Err(e) => return e
      Ok(c) => if opt_i(c.max_age) != want { return esc(h) + " -> Max-Age " + opt_i(c.max_age) + ", want " + want }
    }
    i = i + 1
  }
  let jar = cookie::CookieJar::new()
  let _ = put(jar, "a=1; Max-Age=60; Expires=Thu, 01 Jan 1970 00:00:00 GMT", https("https://e.com/"))
  let _ = put(jar, "b=1; Max-Age=99999999999999999999", https("https://e.com/"))
  let _ = put(jar, "c=1; Expires=Fri, 31 Dec 9999 23:59:59 GMT", https("https://e.com/"))
  let all = jar.all_cookies()
  if all.length() != 3 {
    return "expected 3 cookies, got " + all.length().to_string()
  }
  let cap = t0 + 34560000L
  if opt_i(all[0].expiry_time) != (t0 + 60L).to_string() || opt_i(all[1].expiry_time) != cap.to_string() ||
  opt_i(all[2].expiry_time) != cap.to_string() {
    return "expiry " + opt_i(all[0].expiry_time) + " " + opt_i(all[1].expiry_time) + " " + opt_i(all[2].expiry_time)
  }
  let _ = put(jar, "a=; Max-Age=0", https("https://e.com/"))
  if jar.len() != 2 {
    "Max-Age=0 did not delete"
  } else {
    ""
  }
}

///| Size limits (4096 name+value, 1024 per attribute value), empty name+value, quoted values, last attribute wins.
fn control_limits_and_attributes() -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 4095 {
    sb.write_string("v")
    i = i + 1
  }
  let v4095 = sb.to_string()
  let pathb = StringBuilder::new()
  pathb.write_string("/")
  let mut k = 0
  while k < 1023 {
    pathb.write_string("p")
    k = k + 1
  }
  let p1024 = pathb.to_string()
  let rs = [
    match cookie::parse_set_cookie("a=" + v4095) { Ok(_) => "" Err(_) => "4096 B name+value rejected" },
    match cookie::parse_set_cookie("ab=" + v4095) { Ok(_) => "4097 B name+value accepted" Err(_) => "" },
    match cookie::parse_set_cookie("a=b; Path=" + p1024) {
      Ok(c) => if opt_s(c.path) != esc(p1024) { "1024 B Path ignored" } else { "" }
      Err(_) => "1024 B Path rejected"
    },
    match cookie::parse_set_cookie("a=b; Path=/x; Path=" + p1024 + "q") {
      Ok(c) => if opt_s(c.path) != "/x" { "1025 B Path not ignored" } else { "" }
      Err(_) => "1025 B Path rejected the cookie"
    },
    match cookie::parse_set_cookie("=") { Ok(_) => "`=` accepted" Err(_) => "" },
    match cookie::parse_set_cookie("; Secure") { Ok(_) => "`; Secure` accepted" Err(_) => "" },
    match cookie::parse_set_cookie(" = ; Path=/") { Ok(_) => "` = ` accepted" Err(_) => "" },
    match cookie::parse_set_cookie("a=\"q v\"; Path=/") {
      Ok(c) => if c.value != "\"q v\"" { "quoted value altered: " + esc(c.value) } else { "" }
      Err(_) => "quoted value rejected"
    },
    match cookie::parse_set_cookie("a=b=c; DOMAIN=.A.com; domain=B.com; Expires=bogus; SAMESITE=strict; SameSite=lax; pArTiTiOnEd") {
      Ok(c) =>
      if c.value != "b=c" || opt_s(c.domain) != "b.com" || opt_i(c.expires) != "-" || ss_s(c.same_site) != "Lax" || !c.partitioned {
        "attribute handling: " + cookie_line(c)
      } else {
        ""
      }
      Err(_) => "rejected"
    },
  ]
  first_fail(rs)
}

///| §5.8.3 ordering (longer path first, then earlier creation-time); an update keeps creation-time.
fn control_ordering_and_update() -> String {
  let jar = cookie::CookieJar::new()
  let at = fn(n : Int64) -> cookie::RequestContext { cookie::RequestContext::http("https://e.com/a/b/c", t0 + n) }
  let _ = put(jar, "a=1; Path=/", at(0L))
  let _ = put(jar, "b=1; Path=/a/b", at(1L))
  let _ = put(jar, "c=1; Path=/", at(2L))
  let _ = put(jar, "d=1; Path=/a", at(3L))
  let _ = put(jar, "a=2; Path=/", at(4L))
  let r = want_hdr(jar, at(5L), "b=1; d=1; a=2; c=1", "ordering")
  if r != "" {
    return r
  }
  let all = jar.all_cookies()
  let mut i = 0
  while i < all.length() {
    if all[i].name == "a" && all[i].creation_time != t0 {
      return "update did not keep creation_time"
    }
    i = i + 1
  }
  ""
}

///| Per-domain eviction: expired first, then non-Secure, then least recently accessed.
fn control_eviction() -> String {
  let jar = cookie::CookieJar::with_limits(cookie::JarLimits::new(100, 3, 4096, 1024, cookie::SameSite::Lax, None, true))
  let at = fn(n : Int64) -> cookie::RequestContext { cookie::RequestContext::http("https://e.com/", t0 + n) }
  let _ = put(jar, "s=1; Secure", at(0L))
  let _ = put(jar, "n1=1", at(1L))
  let _ = put(jar, "n2=1", at(2L))
  let _ = hdr(jar, at(3L)) // touches all three
  let _ = put(jar, "x=1", at(4L)) // evicts the LRU non-Secure cookie (n1, by creation order)
  let r1 = want_hdr(jar, at(5L), "s=1; n2=1; x=1", "first eviction")
  if r1 != "" {
    return r1
  }
  let _ = put(jar, "e=1; Max-Age=1", at(6L))
  let _ = put(jar, "y=1", at(10L)) // the expired cookie goes first
  want_hdr(jar, at(11L), "s=1; x=1; y=1", "expired-first eviction")
}

///| export_text / import_text round trip of tabs, newlines, backslashes, non-ASCII and partitioned cookies.
fn control_export_roundtrip() -> String {
  let jar = cookie::CookieJar::new()
  let _ = jar.store_cookie(cookie::Cookie::new("t", "a\tb\\c"), https("https://e.com/"))
  let _ = put(jar, "名=值č; Path=/", https("https://e.com/"))
  let _ = put(jar, "p=1; Secure; Partitioned; SameSite=None; Path=/", ctx("https://e.com/", Some("https://top.example"), true, false, false, true, t0))
  let e1 = jar.export_text()
  let j2 = cookie::CookieJar::new()
  match j2.import_text(e1) {
    Err(e) => "import failed: " + err_name(e)
    Ok(n) => if n != 3 || j2.export_text() != e1 { "round trip changed the jar" } else { "" }
  }
}

///| Mozilla test_psl.txt vectors (subset; the full file runs in run_audit.sh) including IDN and mixed case.
fn control_psl_vectors() -> String {
  let v = [
    ("COM", ""), ("example.COM", "example.com"), ("WwW.example.COM", "example.com"), (".com", ""), ("example", ""),
    ("b.example.example", "example.example"), ("www.ck", "www.ck"), ("www.www.ck", "www.ck"), ("test.ck", ""),
    ("b.test.ck", "b.test.ck"), ("city.kobe.jp", "city.kobe.jp"), ("www.city.kobe.jp", "city.kobe.jp"), ("食狮.com.cn", "食狮.com.cn"),
    ("www.食狮.公司.cn", "食狮.公司.cn"), ("xn--85x722f.xn--55qx5d.cn", "xn--85x722f.xn--55qx5d.cn"), ("shishi.中国", "shishi.中国"),
    ("中国", ""), ("a.b.c.mm", "b.c.mm"), ("us", ""), ("k12.ak.us", ""), ("test.k12.ak.us", "test.k12.ak.us"),
  ]
  let mut i = 0
  while i < v.length() {
    let (d, want) = v[i]
    let got = match cookie::registrable_domain(d) {
      Some(s) => s
      None => ""
    }
    if got != want {
      return "registrable_domain(" + esc(d) + ") = `" + esc(got) + "`, want `" + esc(want) + "`"
    }
    i = i + 1
  }
  ""
}

///|
pub fn case_names() -> Array[String] {
  [
    "redteam_p1_1_nameless_prefix", "redteam_p1_2_leave_secure_alone", "redteam_p1_3_host_only_identity", "redteam_p1_4_cross_site_set",
    "redteam_p1_5_store_injection", "redteam_p1_6_url_host_confusion", "redteam_p2_1_samesite_default", "redteam_p2_2_path_override",
    "redteam_p2_3_domain_multidot", "redteam_p2_4_format_date_range", "redteam_p2_5_export_import", "redteam_p2_7_eviction_per_site",
    "redteam_p2_8_host_canonicalization", "redteam_p2_12_canonical_combining_marks", "control_psl_domain_rejection", "control_ip_literals", "control_prefixes",
    "control_ctl_injection", "control_chips", "control_samesite", "control_httponly_secure", "control_dates", "control_max_age",
    "control_limits_and_attributes", "control_ordering_and_update", "control_eviction", "control_export_roundtrip",
    "control_psl_vectors",
  ]
}

///|
pub fn run_case(name : String) -> String {
  match name {
    "redteam_p1_1_nameless_prefix" => redteam_p1_1_nameless_prefix()
    "redteam_p1_2_leave_secure_alone" => redteam_p1_2_leave_secure_alone()
    "redteam_p1_3_host_only_identity" => redteam_p1_3_host_only_identity()
    "redteam_p1_4_cross_site_set" => redteam_p1_4_cross_site_set()
    "redteam_p1_5_store_injection" => redteam_p1_5_store_injection()
    "redteam_p1_6_url_host_confusion" => redteam_p1_6_url_host_confusion()
    "redteam_p2_1_samesite_default" => redteam_p2_1_samesite_default()
    "redteam_p2_2_path_override" => redteam_p2_2_path_override()
    "redteam_p2_3_domain_multidot" => redteam_p2_3_domain_multidot()
    "redteam_p2_4_format_date_range" => redteam_p2_4_format_date_range()
    "redteam_p2_5_export_import" => redteam_p2_5_export_import()
    "redteam_p2_7_eviction_per_site" => redteam_p2_7_eviction_per_site()
    "redteam_p2_8_host_canonicalization" => redteam_p2_8_host_canonicalization()
    "redteam_p2_12_canonical_combining_marks" => redteam_p2_12_canonical_combining_marks()
    "control_psl_domain_rejection" => control_psl_domain_rejection()
    "control_ip_literals" => control_ip_literals()
    "control_prefixes" => control_prefixes()
    "control_ctl_injection" => control_ctl_injection()
    "control_chips" => control_chips()
    "control_samesite" => control_samesite()
    "control_httponly_secure" => control_httponly_secure()
    "control_dates" => control_dates()
    "control_max_age" => control_max_age()
    "control_limits_and_attributes" => control_limits_and_attributes()
    "control_ordering_and_update" => control_ordering_and_update()
    "control_eviction" => control_eviction()
    "control_export_roundtrip" => control_export_roundtrip()
    "control_psl_vectors" => control_psl_vectors()
    _ => "unknown case " + name
  }
}
