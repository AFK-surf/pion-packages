///| Pion Native head-to-head benchmark & differential oracle runner for `packages/cookie`.
///| Usage: pion_cookie_bench <parse|psl> <corpus_file> <iters>
///| When <iters> == 0, prints canonical line-by-line output for differential comparison.

import "cookie"

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn split_lines(data : String) -> Array[String] {
  let out : Array[String] = []
  let n = data.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if data.code_unit_at(i) == 10 {
      let mut end = i
      if end > start && data.code_unit_at(end - 1) == 13 {
        end = end - 1
      }
      if end > start {
        out.push(data.slice(start, end))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(data.slice(start, n))
  }
  out
}

fn fnv1a_64_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

fn eval_parse_once(lines : Array[String]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    match cookie::parse_set_cookie(lines[i]) {
      Ok(c) => {
        sb.write_string("OK|")
        sb.write_string(c.name)
        sb.write_string("|")
        sb.write_string(c.value)
        sb.write_string("|E=")
        match c.expires {
          Some(ts) => sb.write_string(ts.to_string())
          None => sb.write_string("-")
        }
        sb.write_string("|M=")
        match c.max_age {
          Some(ma) => sb.write_string((if ma < 0L { 0L } else { ma }).to_string())
          None => sb.write_string("-")
        }
        sb.write_string("|D=")
        match c.domain {
          Some(d) => sb.write_string(d)
          None => sb.write_string("-")
        }
        sb.write_string("|P=")
        match c.path {
          Some(p) => sb.write_string(p)
          None => sb.write_string("-")
        }
        sb.write_string("|S=")
        sb.write_string(if c.secure { "1" } else { "0" })
        sb.write_string("|H=")
        sb.write_string(if c.http_only { "1" } else { "0" })
        sb.write_string("|SS=")
        match c.same_site {
          Some(ss) => sb.write_string(cookie::same_site_to_string(ss))
          None => sb.write_string("-")
        }
        sb.write_string("|PT=")
        sb.write_string(if c.partitioned { "1" } else { "0" })
        sb.write_string("\n")
      }
      Err(_) => sb.write_string("ERR\n")
    }
    i = i + 1
  }
  sb.to_string()
}

fn eval_psl_once(lines : Array[String]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let d = lines[i]
    sb.write_string(d)
    sb.write_string("|")
    match cookie::registrable_domain(d) {
      Some(r) => sb.write_string(r)
      None => sb.write_string("-")
    }
    sb.write_string("|")
    match cookie::public_suffix(d) {
      Some(s) => sb.write_string(s)
      None => sb.write_string("-")
    }
    sb.write_string("\n")
    i = i + 1
  }
  sb.to_string()
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_cookie_bench <parse|psl> <corpus_file> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_int(args[3])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b.to_string()
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }
  let lines = split_lines(data)
  if iters == 0 {
    let out = if mode == "parse" { eval_parse_once(lines) } else { eval_psl_once(lines) }
    io_println(world, out)
    return 0
  }
  let mut last = ""
  let mut i = 0
  while i < iters {
    last = if mode == "parse" { eval_parse_once(lines) } else { eval_psl_once(lines) }
    i = i + 1
  }
  io_println(
    world,
    "mode=" + mode +
    " cases=" + lines.length().to_string() +
    " iters=" + iters.to_string() +
    " bytes=" + last.length().to_string() +
    " fnv64=" + hex_u64(fnv1a_64_str(last)),
  )
  0
}
