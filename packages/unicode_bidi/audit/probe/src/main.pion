///| Red-team differential probe for `packages/unicode_bidi` (batch, length-framed I/O).
///|
///| Input records: `<len>\n<bytes>` repeated. Output records: `<len>\n<bytes>` repeated.
///|   info <in> <out> : record = `<dir><text>` (`-` auto, `0` LTR, `1` RTL default level).
///|                     Dumps paragraphs, per-byte original classes + levels, has_rtl, base
///|                     direction (first/full), and for every line (whole paragraph + a split at
///|                     the first char boundary >= midpoint): L1 levels, L2 visual runs,
///|                     per-char levels, reorder_line, paragraph direction.
///|   cls  <any> <out> : one byte `A+tag` per scalar value 0..=0x10FFFF (surrogates skipped).
///|   tab  <any> <out> : `cp open/close skeleton` bracket rows + `cp mirror` rows.
///|   one  <in> <sub> [reps] : run `sub` (`new`, `lines`, `l1`) on the whole file `reps` times.
///|        subs: `new` (BidiInfo::new), `lines` (+ visual_runs + reorder_line per paragraph),
///|        `l1` (+ reordered_levels per paragraph), `line_levels` (bidi_line_levels(src, -1)),
///|        `vis` (src = comma-separated ints -> bidi_visual_order).

import "unicode_bidi"

///|
fn parse_dec(s : String, start : Int, end : Int) -> Int {
  let mut v = 0
  let mut i = start
  while i < end {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
fn read_records(src : String) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut i = 0
  while i < n {
    let ls = i
    while i < n && src.code_unit_at(i) != 10 {
      i = i + 1
    }
    let len = parse_dec(src, ls, i)
    i = i + 1
    out.push(src.slice(i, i + len))
    i = i + len
  }
  out
}

///|
fn emit(sb : StringBuilder, h : String) -> Unit {
  sb.write_string(h.length().to_string())
  sb.write_byte((10).to_byte())
  sb.write_string(h)
}

///|
fn dir_str(d : unicode_bidi::Direction) -> String {
  unicode_bidi::direction_to_string(d)
}

///|
fn levels_str(sb : StringBuilder, lv : Array[unicode_bidi::Level], s : Int, e : Int) -> Unit {
  let mut i = s
  while i < e {
    if i > s {
      sb.write_byte((44).to_byte())
    }
    sb.write_string(lv[i].number().to_string())
    i = i + 1
  }
}

///|
fn is_boundary(t : String, i : Int) -> Bool {
  i >= t.length() || (t.code_unit_at(i) & 0xC0) != 0x80
}

///|
fn dump_info(info : unicode_bidi::BidiInfo, text : String) -> String {
  let sb = StringBuilder::new()
  let n = text.length()
  sb.write_string("base=" + dir_str(unicode_bidi::get_base_direction(text)))
  sb.write_string(" full=" + dir_str(unicode_bidi::get_base_direction_full(text)))
  sb.write_string(" has_rtl=" + (if info.has_rtl() { "1" } else { "0" }) + "\nC ")
  let mut i = 0
  while i < info.original_classes.length() {
    sb.write_byte((65 + unicode_bidi::bidi_class_to_int(info.original_classes[i])).to_byte())
    i = i + 1
  }
  sb.write_string("\nV ")
  levels_str(sb, info.levels, 0, info.levels.length())
  sb.write_string("\n")
  let mut p = 0
  while p < info.paragraphs.length() {
    let para = info.paragraphs[p]
    let ps = para.range.start
    let pe = para.range.end
    sb.write_string(
      "P " + ps.to_string() + " " + pe.to_string() + " " + para.level.number().to_string() +
      " dir=" +
      dir_str(info.paragraph_direction(para)) +
      "\n",
    )
    let lines : Array[unicode_bidi::TextRange] = [para.range]
    let mut mid = (ps + pe) / 2
    while mid < pe && !is_boundary(text, mid) {
      mid = mid + 1
    }
    if mid > ps && mid < pe {
      lines.push(unicode_bidi::TextRange::new(ps, mid))
      lines.push(unicode_bidi::TextRange::new(mid, pe))
    }
    let mut li = 0
    while li < lines.length() {
      let line = lines[li]
      let (lv, runs) = info.visual_runs(para, line)
      sb.write_string(" line " + line.start.to_string() + "-" + line.end.to_string() + "\n  L1 ")
      levels_str(sb, lv, 0, lv.length())
      sb.write_string("\n  runs")
      let mut r = 0
      while r < runs.length() {
        sb.write_string(" " + runs[r].start.to_string() + ".." + runs[r].end.to_string())
        r = r + 1
      }
      sb.write_string("\n  pc ")
      let pc = info.reordered_levels_per_char(para, line)
      levels_str(sb, pc, 0, pc.length())
      let out = info.reorder_line(para, line)
      sb.write_string("\n  out " + out.length().to_string() + ":")
      sb.write_string(out)
      sb.write_string("\n")
      li = li + 1
    }
    p = p + 1
  }
  let _ = n
  sb.to_string()
}

///|
fn default_of(rec : String) -> Option[unicode_bidi::Level] {
  if rec.length() == 0 {
    return None
  }
  let c = rec.code_unit_at(0)
  if c == 48 {
    Some(unicode_bidi::Level::ltr())
  } else if c == 49 {
    Some(unicode_bidi::Level::rtl())
  } else {
    None
  }
}

///|
fn run_info(rec : String) -> String {
  let text = if rec.length() > 0 { rec.slice(1, rec.length()) } else { rec }
  let info = unicode_bidi::BidiInfo::new(text, default_of(rec))
  dump_info(info, text)
}

///| `pcl`: first paragraph level, then per-char L1 levels (each paragraph reordered as one line).
fn run_pcl(rec : String) -> String {
  let text = if rec.length() > 0 { rec.slice(1, rec.length()) } else { rec }
  let info = unicode_bidi::BidiInfo::new(text, default_of(rec))
  let sb = StringBuilder::new()
  if info.paragraphs.length() > 0 {
    sb.write_string(info.paragraphs[0].level.number().to_string())
  }
  sb.write_string(";")
  let mut p = 0
  let mut first = true
  while p < info.paragraphs.length() {
    let para = info.paragraphs[p]
    let lv = info.reordered_levels(para, para.range)
    let mut i = para.range.start
    while i < para.range.end {
      if is_boundary(text, i) {
        if !first {
          sb.write_byte((44).to_byte())
        }
        first = false
        sb.write_string(lv[i].number().to_string())
      }
      i = i + 1
    }
    p = p + 1
  }
  sb.to_string()
}

///|
fn run_cls() -> String {
  let sb = StringBuilder::with_capacity(0x110000)
  let mut cp = 0
  while cp <= 0x10FFFF {
    if cp < 0xD800 || cp > 0xDFFF {
      sb.write_byte((65 + unicode_bidi::bidi_class_to_int(unicode_bidi::bidi_class(cp))).to_byte())
    }
    cp = cp + 1
  }
  sb.to_string()
}

///|
fn run_tab() -> String {
  let sb = StringBuilder::new()
  let mut cp = 0
  while cp <= 0x10FFFF {
    match unicode_bidi::bidi_matched_opening_bracket(cp) {
      Some((sk, op)) =>
      sb.write_string(
        "B " + cp.to_string() + " " + (if op { "o" } else { "c" }) + " " + sk.to_string() + "\n",
      )
      None => ()
    }
    match unicode_bidi::bidi_mirroring_glyph(cp) {
      Some(m) => sb.write_string("M " + cp.to_string() + " " + m.to_string() + "\n")
      None => ()
    }
    cp = cp + 1
  }
  sb.to_string()
}

///|
fn run_sub(sub : String, src : String) -> Int {
  if sub == "vis" {
    let parts = src.split(",")
    let lv : Array[Int] = []
    let mut i = 0
    while i < parts.length() {
      let t = parts[i]
      if t.length() > 0 && t.code_unit_at(0) == 45 {
        lv.push(-parse_dec(t, 1, t.length()))
      } else {
        lv.push(parse_dec(t, 0, t.length()))
      }
      i = i + 1
    }
    return unicode_bidi::bidi_visual_order(lv).length()
  }
  if sub == "line_levels" {
    return unicode_bidi::bidi_line_levels(src, -1).length()
  }
  let info = unicode_bidi::BidiInfo::new(src, None)
  let mut total = info.levels.length()
  if sub == "lines" || sub == "l1" {
    let mut p = 0
    while p < info.paragraphs.length() {
      let para = info.paragraphs[p]
      if sub == "lines" {
        let (_, runs) = info.visual_runs(para, para.range)
        total = total + runs.length()
        total = total + info.reorder_line(para, para.range).length()
      } else {
        total = total + info.reordered_levels(para, para.range).length()
      }
      p = p + 1
    }
  }
  total
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: probe info|cls|tab|one <in> ...")
    return 2
  }
  let mode = args[1]
  let src = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "read failed")
      return 1
    }
  }
  if mode == "one" {
    let sub = args[3]
    let reps = if args.length() > 4 {
      parse_dec(args[4], 0, args[4].length())
    } else {
      1
    }
    let mut total = 0
    let mut r = 0
    while r < reps {
      total = total + run_sub(sub, src)
      r = r + 1
    }
    io_println(world, "ok " + total.to_string())
    return 0
  }
  let out_path = args[3]
  let out = StringBuilder::new()
  if mode == "cls" {
    out.write_string(run_cls())
  } else if mode == "tab" {
    out.write_string(run_tab())
  } else {
    let recs = read_records(src)
    let mut i = 0
    while i < recs.length() {
      emit(out, if mode == "pcl" { run_pcl(recs[i]) } else { run_info(recs[i]) })
      i = i + 1
    }
  }
  match fs_write(world, out_path, out.to_string()) {
    Ok(_) => 0
    Err(_) => {
      io_eprintln(world, "write failed")
      1
    }
  }
}
