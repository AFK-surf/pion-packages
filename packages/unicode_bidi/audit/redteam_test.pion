///| Red-team regression tests for packages/unicode_bidi @ a14e5a742d (branch feat/pkg-unicode-bidi).
///
/// `p0_*` / `p1_*` / `p2_*` tests assert what UAX #9 (Unicode 16.0.0, tr9-50) / the Unicode 16.0.0 UCD
/// say, cross-checked against Rust `unicode-bidi =0.3.18` (audit/rust) and ICU4C `ubidi`
/// (scripts/icu_oracle.py) — a FAILURE (or panic) here is the evidence.
/// `control_*` tests are attacks Pion survived, including places where Pion is MORE correct than the
/// Rust oracle (the differential mismatches explained in REPORT.md); they must keep passing.
/// Timing / memory findings are reproduced by run_audit.sh (scripts/dos.py).

import "unicode_bidi"

///|
fn repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::with_capacity(s.length() * n + 1)
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn bytes_str(bs : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < bs.length() {
    sb.write_byte(bs[i].to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn lv_at(info : unicode_bidi::BidiInfo, i : Int) -> Int {
  info.levels[i].number()
}

///|
fn ltr() -> Option[unicode_bidi::Level] {
  Some(unicode_bidi::Level::ltr())
}

///|
fn rtl() -> Option[unicode_bidi::Level] {
  Some(unicode_bidi::Level::rtl())
}

///|
fn exercise_all_line_apis(info : unicode_bidi::BidiInfo, line : unicode_bidi::TextRange) -> Int {
  let mut acc = 0
  let mut p = 0
  while p < info.paragraphs.length() {
    let para = info.paragraphs[p]
    acc = acc + info.reordered_levels(para, line).length()
    acc = acc + info.reordered_levels_per_char(para, line).length()
    let (lv, runs) = info.visual_runs(para, line)
    acc = acc + lv.length() + runs.length()
    acc = acc + info.reorder_line(para, line).length()
    acc = acc + info.reorder_line_with_mirroring(para, line).length()
    let _ = info.paragraph_direction(para)
    p = p + 1
  }
  acc
}

// ---------------------------------------------------------------------------------------------
// P1 — UAX #9 spec violations
// ---------------------------------------------------------------------------------------------

///| BD16 (tr9-50): "If an opening paired bracket is found and there is no room in the stack, stop
///| processing BD16 for the remainder of the isolating run sequence and return an EMPTY LIST."
///| Pion keeps the pairs found before the overflow, so N0 still resolves `(ב)` to R and the `)`
///| ends up at level 1. With the empty list, N1 resolves `)` (between R and eos=L) to e=L -> level 0.
///| (Rust unicode-bidi 0.3.18 has the same defect, so the differential cannot see it.)
test "p1_bd16_stack_overflow_must_return_empty_pair_list" {
  let text = "א(ב)" + repeat("(", 64)
  let info = unicode_bidi::BidiInfo::new(text, ltr())
  // bytes: א=0..2 (=2 ב=3..5 )=5
  debug_assert(lv_at(info, 5) == 0, "`)` must be level 0 once BD16 overflowed, got " + lv_at(info, 5).to_string())
  debug_assert(lv_at(info, 2) == 1, "`(` between R and R stays R via N1")
}

///| Same defect, overflow reached in a LATER level run of the same isolating run sequence.
test "p1_bd16_overflow_after_isolate_must_drop_pairs_of_first_run" {
  let text = "א(ב)" + "⁦x⁩" + repeat("(", 64)
  let info = unicode_bidi::BidiInfo::new(text, ltr())
  debug_assert(lv_at(info, 5) == 0, "`)` must be level 0, got " + lv_at(info, 5).to_string())
}

// ---------------------------------------------------------------------------------------------
// P2 — table / API / robustness defects
// ---------------------------------------------------------------------------------------------

///| Unicode 16.0.0 DerivedBidiClass.txt lists noncharacters and default-ignorable unassigned code
///| points as BN (U+2065, U+FDD0..FDEF, U+FFF0..FFF8, U+nFFFE/F, U+E0000, U+E0080..E00FF, ...);
///| Pion (like Rust 0.3.18) returns L — 3,970 scalars disagree with the UCD it claims to embed.
test "p2_bidi_class_noncharacters_and_default_ignorables_are_bn" {
  let cps = [0x2065, 0xFDD0, 0xFDEF, 0xFFF0, 0xFFFE, 0xFFFF, 0x1FFFE, 0x10FFFF, 0xE0000, 0xE0080, 0xE0FFF]
  let mut i = 0
  while i < cps.length() {
    let got = unicode_bidi::bidi_class_to_string(unicode_bidi::bidi_class(cps[i]))
    debug_assert(got == "BN", "cp " + cps[i].to_string() + " expected BN (UCD 16), got " + got)
    i = i + 1
  }
}

///| Unassigned code points in Arabic-letter default blocks are AL per the @missing lines of
///| DerivedBidiClass-16.0.0 (0860..08FF, 10D00..10D3F, 10EC0..10EFF, 10F30..10F6F, 1EC70..1ECBF,
///| 1ED00..1ED4F); Pion says R (W2/W3 then treat a following EN differently).
test "p2_bidi_class_unassigned_arabic_default_ranges_are_al" {
  let cps = [0x086B, 0x088F, 0x0892, 0x10D28, 0x10EC0, 0x10F5A, 0x1EC70, 0x1ED3E]
  let mut i = 0
  while i < cps.length() {
    let got = unicode_bidi::bidi_class_to_string(unicode_bidi::bidi_class(cps[i]))
    debug_assert(got == "AL", "cp " + cps[i].to_string() + " expected AL (UCD 16 @missing), got " + got)
    i = i + 1
  }
}

///| Visible consequence of the BN/L table bug: a leading U+FEFF-like noncharacter must be skipped by
///| P2, so the paragraph is RTL from the following Hebrew letter.
test "p2_noncharacter_prefix_flips_paragraph_direction" {
  let info = unicode_bidi::BidiInfo::new("￿אב", None)
  debug_assert(info.paragraphs[0].level.number() == 1, "P2 must skip BN U+FFFF; paragraph should be RTL")
}

///| `Level::new` accepts 126 and `BidiInfo::new` accepts it as the paragraph level, after which I1/I2
///| produce levels 127 and 128 — out of the `Level` invariant (0..=126). Rust panics
///| ("Level number error"); Pion silently returns invalid `Level`s.
test "p2_default_level_126_yields_out_of_range_levels" {
  let lv = match unicode_bidi::Level::new(126) {
    Ok(l) => l
    Err(_) => unicode_bidi::Level::ltr()
  }
  let info = unicode_bidi::BidiInfo::new("aא1", Some(lv))
  let mut i = 0
  while i < info.levels.length() {
    debug_assert(info.levels[i].number() <= 126, "level " + info.levels[i].number().to_string() + " > 126 at byte " + i.to_string())
    i = i + 1
  }
}

///| `BidiInfo::new` swallows `InputTooLong` and returns an info with EMPTY `levels`/`paragraphs` for a
///| non-empty text (> 16 MiB). Every caller that indexes `levels[byte]` (a layout engine's
///| `bidi_line_levels` returns `[]`) then reads out of bounds or renders unshaped.
test "p2_new_silently_drops_levels_over_default_limit" {
  let text = repeat("a", 16 * 1024 * 1024 + 1)
  let info = unicode_bidi::BidiInfo::new(text, None)
  debug_assert(info.levels.length() == text.length(), "levels.length()=" + info.levels.length().to_string() + " for " + text.length().to_string() + " bytes")
}

///| `bidi_line_levels` (convenience helper) applies L1 with paragraph 0's level to the WHOLE text: a
///| trailing space in a second (RTL) paragraph is reset to level 0 instead of its paragraph level 1.
test "p2_bidi_line_levels_uses_first_paragraph_level_for_all_paragraphs" {
  let lv = unicode_bidi::bidi_line_levels("a\nא ", -1)
  // chars: a \n א ' '
  debug_assert(lv.length() == 4, "4 chars")
  debug_assert(lv[3] == 1, "trailing WS of the RTL paragraph must reset to 1 (L1), got " + lv[3].to_string())
}

///| A line range that starts inside a multi-byte character is accepted (Rust panics); the RTL path
///| re-encodes each stray continuation byte as U+FFFD (3 bytes), so the "reordered" line is longer
///| than the input range and no longer a permutation of it.
test "p2_reorder_line_mid_char_range_corrupts_output" {
  let text = "אבג"
  let info = unicode_bidi::BidiInfo::new(text, None)
  let para = info.paragraphs[0]
  let out = info.reorder_line(para, unicode_bidi::TextRange::new(1, 5))
  debug_assert(out.length() == 4, "reorder_line(1..5) returned " + out.length().to_string() + " bytes for a 4-byte range")
}

///| Invalid UTF-8 (reachable via `fs_read` / `StringBuilder::write_byte`): a lone 0xE0 lead byte right
///| before RLE must not swallow the embedding (pass 1 and X1–X8 use different UTF-8 helpers).
test "control_invalid_utf8_lead_byte_keeps_following_rle" {
  let text = bytes_str([0xE0, 0xE2, 0x80, 0xAB, 0x61]) // E0, RLE (E2 80 AB), 'a'
  let info = unicode_bidi::BidiInfo::new(text, ltr())
  debug_assert(unicode_bidi::bidi_class_to_string(info.original_classes[1]) == "RLE", "pass 1 sees RLE at byte 1")
  debug_assert(lv_at(info, 4) == 2, "'a' inside RLE must be level 2, got " + lv_at(info, 4).to_string())
}

// ---------------------------------------------------------------------------------------------
// control — attacks Pion survived / places where Pion beats the Rust oracle
// ---------------------------------------------------------------------------------------------

///| Rust 0.3.18 `IsolatingRunSequence::iter_backwards_from` walks earlier level runs FORWARDS, so
///| N0's "first strong type before the opening bracket" finds `a` instead of `א` once an isolate
///| splits the sequence. Pion (and ICU4C) resolve the brackets to R -> level 1; Rust gives 0.
test "control_n0_previous_strong_across_level_runs_beats_rust" {
  let info = unicode_bidi::BidiInfo::new("aא⁦x⁩(ב)", ltr())
  // a=0 א=1..3 LRI=3..6 x=6 PDI=7..10 (=10 ב=11..13 )=13
  debug_assert(lv_at(info, 10) == 1, "( must be R")
  debug_assert(lv_at(info, 13) == 1, ") must be R")
  debug_assert(lv_at(info, 3) == 1 && lv_at(info, 7) == 1, "LRI/PDI between R and R -> R")
}

///| Rust breaks only the CURRENT level run on bracket-stack overflow and keeps pairing in the next
///| run of the same IRS; Pion stops for the whole sequence (closer to BD16).
test "control_bd16_overflow_not_resumed_in_next_level_run" {
  let text = "a" + repeat("(", 64) + "⁦x⁩b" + repeat(")", 64) + "א"
  let info = unicode_bidi::BidiInfo::new(text, rtl())
  let first_close = 1 + 64 + 3 + 1 + 3 + 1
  debug_assert(lv_at(info, first_close) == 1, "closers stay R (no pairs), got " + lv_at(info, first_close).to_string())
}

///| BD16 canonical equivalence: U+2329 pairs with U+3009 and U+3008 with U+232A.
test "control_bd16_canonical_equivalent_brackets" {
  let a = unicode_bidi::BidiInfo::new("א〈ב〉a", ltr())
  let b = unicode_bidi::BidiInfo::new("א〈ב〉a", ltr())
  // ⟨ at 2..5, ב 5..7, 〉 at 7..10 -> both brackets R (level 1)
  debug_assert(lv_at(a, 7) == 1 && lv_at(b, 7) == 1, "closing bracket paired via canonical equivalent")
}

///| Depth 125: the 126th embedding overflows, PDF/PDI bookkeeping must not underflow.
test "control_depth_125_overflow_and_unbalanced_terminators" {
  let text = repeat("‫‪", 70) + "a" + repeat("⁩‬", 200) + repeat("⁧", 130) + "b"
  let info = unicode_bidi::BidiInfo::new(text, None)
  let mut i = 0
  let mut mx = 0
  while i < info.levels.length() {
    if info.levels[i].number() > mx {
      mx = info.levels[i].number()
    }
    i = i + 1
  }
  debug_assert(mx <= 126, "max level " + mx.to_string())
  let _ = exercise_all_line_apis(info, info.paragraphs[0].range)
}

///| Hostile ranges never panic: negative, reversed, past the end, inside a character, empty.
test "control_hostile_text_ranges_do_not_panic" {
  let info = unicode_bidi::BidiInfo::new("aא(ב)⁧x⁩ 1\nג b", None)
  let n = info.text.length()
  let ranges = [(-5, 3), (4, 2), (0, n + 10), (n + 3, n + 9), (1, 2), (2, 2), (-10, -1), (3, n), (0, 0)]
  let mut k = 0
  while k < ranges.length() {
    let (s, e) = ranges[k]
    let _ = exercise_all_line_apis(info, unicode_bidi::TextRange::new(s, e))
    k = k + 1
  }
}

///| Random invalid UTF-8 byte soup (truncated / overlong / surrogate / > U+10FFFF sequences).
test "control_invalid_utf8_byte_soup_does_not_panic" {
  let mut seed = 12345
  let mut round = 0
  while round < 300 {
    let bs : Array[Int] = []
    let len = round % 40
    let mut i = 0
    while i < len {
      seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
      let r = (seed >> 8) & 0xFF
      // bias towards lead / continuation bytes and bidi-relevant ASCII
      bs.push(if r < 64 { 0x80 + (r & 0x3F) } else if r < 96 { 0xE2 } else { r })
      i = i + 1
    }
    let text = bytes_str(bs)
    let info = unicode_bidi::BidiInfo::new(text, None)
    debug_assert(info.levels.length() == text.length(), "levels per byte")
    let _ = exercise_all_line_apis(info, unicode_bidi::TextRange::new(0, text.length()))
    let _ = unicode_bidi::bidi_line_levels(text, -1)
    round = round + 1
  }
}

///| Empty, single byte, lone separators.
test "control_tiny_inputs" {
  let xs = ["", "a", "א", "\n", "\r\n", " ", "⁩", "‬", "⁨", " ", "­", "1"]
  let mut i = 0
  while i < xs.length() {
    let info = unicode_bidi::BidiInfo::new(xs[i], None)
    let _ = exercise_all_line_apis(info, unicode_bidi::TextRange::new(0, xs[i].length()))
    let _ = unicode_bidi::bidi_line_levels(xs[i], 1)
    i = i + 1
  }
  let e = unicode_bidi::BidiInfo::new("", None)
  debug_assert(e.paragraphs.length() == 0, "no paragraph for empty text")
}

///| `Limits` edge values are clamped instead of panicking.
test "control_limits_edge_values" {
  let cases = [(0, 125, 63), (100, -5, -1), (100, 1000, 0), (100, 0, 1000)]
  let mut i = 0
  while i < cases.length() {
    let (mb, md, mbd) = cases[i]
    let lim = unicode_bidi::Limits::{ max_input_bytes: mb, max_depth: md, max_bracket_depth: mbd }
    match unicode_bidi::BidiInfo::new_with_limits("ב(a‫[b]⁧c)", None, lim) {
      Ok(info) => {
        let _ = exercise_all_line_apis(info, info.paragraphs[0].range)
      }
      Err(_) => ()
    }
    i = i + 1
  }
}
