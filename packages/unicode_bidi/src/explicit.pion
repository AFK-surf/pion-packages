///| UAX #9 §3.3.2 Explicit Levels and Directions (Rules X1–X8) + BD7 Level Runs.

// Directional status stack override states:
//   0 = Neutral, 1 = RTL, 2 = LTR, 3 = Isolate

///| Compute explicit embedding levels for paragraph `[para_start, para_end)`
///| and append BD7 level runs (paragraph-relative `[start, end)`) into `run_starts`/`run_ends`.
fn explicit_compute(
  text : String,
  para_start : Int,
  para_end : Int,
  para_level : Int,
  max_depth : Int,
  orig_tags : Bytes,
  levels : Bytes,
  proc_tags : Bytes,
  run_starts : Array[Int],
  run_ends : Array[Int],
  stack_level : Array[Int],
  stack_status : Array[Int],
) -> Unit {
  let para_len = para_end - para_start
  if para_len <= 0 {
    return
  }

  stack_level.clear()
  stack_status.clear()
  stack_level.push(para_level)
  stack_status.push(0)

  let mut overflow_isolate_count = 0
  let mut overflow_embedding_count = 0
  let mut valid_isolate_count = 0

  let mut current_run_level = 0
  let mut current_run_start = 0

  let mut rel = 0
  while rel < para_len {
    let abs_i = para_start + rel
    let char_len = utf8_char_len_at(text, abs_i)
    let step = if char_len > 0 { char_len } else { 1 }

    let top_idx = stack_level.length() - 1
    let last_level = stack_level[top_idx]
    let last_status = stack_status[top_idx]
    let orig = orig_tags[abs_i].to_int()

    if orig == tag_rle || orig == tag_lre || orig == tag_rlo || orig == tag_lro ||
    orig == tag_rli || orig == tag_lri || orig == tag_fsi {
      levels[abs_i] = last_level.to_byte()
      let is_isolate = is_isolate_initiator_tag(orig)
      if is_isolate {
        if last_status == 1 {
          proc_tags[abs_i] = tag_r.to_byte()
        } else if last_status == 2 {
          proc_tags[abs_i] = tag_l.to_byte()
        }
      }

      let next_lv = if is_rtl_initiator_tag(orig) {
        (last_level + 1) | 1
      } else {
        (last_level + 2) & -2
      }

      if next_lv <= max_depth && overflow_isolate_count == 0 && overflow_embedding_count == 0 {
        let new_status = if orig == tag_rlo {
          1
        } else if orig == tag_lro {
          2
        } else if is_isolate {
          3
        } else {
          0
        }
        stack_level.push(next_lv)
        stack_status.push(new_status)
        if is_isolate {
          valid_isolate_count = valid_isolate_count + 1
        } else {
          levels[abs_i] = next_lv.to_byte()
        }
      } else if is_isolate {
        overflow_isolate_count = overflow_isolate_count + 1
      } else if overflow_isolate_count == 0 {
        overflow_embedding_count = overflow_embedding_count + 1
      }

      if !is_isolate {
        proc_tags[abs_i] = tag_bn.to_byte()
      }
    } else if orig == tag_pdi {
      if overflow_isolate_count > 0 {
        overflow_isolate_count = overflow_isolate_count - 1
      } else if valid_isolate_count > 0 {
        overflow_embedding_count = 0
        let mut popping = true
        while popping && stack_level.length() > 0 {
          let st = stack_status[stack_status.length() - 1]
          let _ = stack_level.pop()
          let _ = stack_status.pop()
          if st == 3 {
            popping = false
          }
        }
        valid_isolate_count = valid_isolate_count - 1
      }
      let cur_top = stack_level.length() - 1
      let cur_lv = stack_level[cur_top]
      let cur_st = stack_status[cur_top]
      levels[abs_i] = cur_lv.to_byte()
      if cur_st == 1 {
        proc_tags[abs_i] = tag_r.to_byte()
      } else if cur_st == 2 {
        proc_tags[abs_i] = tag_l.to_byte()
      }
    } else if orig == tag_pdf {
      if overflow_isolate_count > 0 {
        ()
      } else if overflow_embedding_count > 0 {
        overflow_embedding_count = overflow_embedding_count - 1
      } else if last_status != 3 && stack_level.length() >= 2 {
        let _ = stack_level.pop()
        let _ = stack_status.pop()
      }
      levels[abs_i] = stack_level[stack_level.length() - 1].to_byte()
      proc_tags[abs_i] = tag_bn.to_byte()
    } else if orig == tag_b {
      ()
    } else {
      levels[abs_i] = last_level.to_byte()
      if orig != tag_bn {
        if last_status == 1 {
          proc_tags[abs_i] = tag_r.to_byte()
        } else if last_status == 2 {
          proc_tags[abs_i] = tag_l.to_byte()
        }
      }
    }

    // Propagate level and processing class to multi-byte continuation bytes.
    let lv_byte = levels[abs_i]
    let pt_byte = proc_tags[abs_i]
    let mut j = 1
    while j < step && abs_i + j < para_end {
      levels[abs_i + j] = lv_byte
      proc_tags[abs_i + j] = pt_byte
      j = j + 1
    }

    // Identify BD7 level runs.
    let lv_val = lv_byte.to_int()
    if rel == 0 {
      current_run_level = lv_val
    } else if !removed_by_x9_tag(orig) && lv_val != current_run_level {
      run_starts.push(current_run_start)
      run_ends.push(rel)
      current_run_level = lv_val
      current_run_start = rel
    }

    rel = rel + step
  }

  if para_len > current_run_start {
    run_starts.push(current_run_start)
    run_ends.push(para_len)
  }
}
