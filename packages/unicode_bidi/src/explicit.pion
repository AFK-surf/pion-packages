///| UAX #9 §3.3.2 Explicit Levels and Directions (Rules X1–X8) + BD7 Level Runs.

// Directional status stack override states:
//   0 = Neutral, 1 = RTL, 2 = LTR, 3 = Isolate

///| Compute explicit embedding levels for paragraph `[para_start, para_end)`
///| and append BD7 level runs (paragraph-relative `[start, end)`) into `run_starts`/`run_ends`.
///| Writes every byte of `levels[para_start..para_end)` and `proc_tags[para_start..para_end)` directly.
fn explicit_compute(
  text : String,
  para_start : Int,
  para_end : Int,
  para_level : Int,
  max_depth : Int,
  orig_tags : FixedArray[Byte],
  levels : FixedArray[Byte],
  proc_tags : FixedArray[Byte],
  run_starts : Array[Int],
  run_ends : Array[Int],
  exp_stack : FixedArray[Byte],
) -> Unit {
  let para_len = para_end - para_start
  if para_len <= 0 {
    return
  }

  let text_len = text.length()
  let para_level_b = para_level.to_byte()
  exp_stack[0] = para_level_b
  exp_stack[128] = (0).to_byte()
  let mut sp = 1

  let mut last_level = para_level
  let mut last_level_b = para_level_b
  let mut last_status = 0
  let tag_r_b = tag_r.to_byte()
  let tag_l_b = tag_l.to_byte()
  let tag_bn_b = tag_bn.to_byte()

  let mut overflow_isolate_count = 0
  let mut overflow_embedding_count = 0
  let mut valid_isolate_count = 0

  let mut current_run_level = 0
  let mut current_run_start = 0

  let mut rel = 0
  while rel < para_len {
    let abs_i = para_start + rel
    let b0 = text.code_unit_at(abs_i)
    let step = if b0 < 0x80 {
      1
    } else if (b0 & 0xE0) == 0xC0 && abs_i + 1 < text_len {
      2
    } else if (b0 & 0xF0) == 0xE0 && abs_i + 2 < text_len {
      3
    } else if (b0 & 0xF8) == 0xF0 && abs_i + 3 < text_len {
      4
    } else {
      1
    }

    let orig_b = orig_tags[abs_i]
    let orig = orig_b.to_int()

    let mut lv_byte = last_level_b
    let mut pt_byte = orig_b

    if !is_explicit_or_b_tag(orig) {
      if orig != tag_bn {
        if last_status == 1 {
          pt_byte = tag_r_b
        } else if last_status == 2 {
          pt_byte = tag_l_b
        }
      }
    } else if orig == tag_b {
      lv_byte = para_level_b
      pt_byte = orig_b
    } else if orig == tag_pdi {
      if overflow_isolate_count > 0 {
        overflow_isolate_count = overflow_isolate_count - 1
      } else if valid_isolate_count > 0 {
        overflow_embedding_count = 0
        while sp > 0 {
          sp = sp - 1
          if exp_stack[128 + sp].to_int() == 3 {
            break
          }
        }
        valid_isolate_count = valid_isolate_count - 1
      }
      let cur_top = sp - 1
      last_level_b = exp_stack[cur_top]
      last_level = last_level_b.to_int()
      last_status = exp_stack[128 + cur_top].to_int()
      lv_byte = last_level_b
      if last_status == 1 {
        pt_byte = tag_r_b
      } else if last_status == 2 {
        pt_byte = tag_l_b
      }
    } else if orig == tag_pdf {
      if overflow_isolate_count > 0 {
        ()
      } else if overflow_embedding_count > 0 {
        overflow_embedding_count = overflow_embedding_count - 1
      } else if last_status != 3 && sp >= 2 {
        sp = sp - 1
        let cur_top = sp - 1
        last_level_b = exp_stack[cur_top]
        last_level = last_level_b.to_int()
        last_status = exp_stack[128 + cur_top].to_int()
      }
      lv_byte = last_level_b
      pt_byte = tag_bn_b
    } else {
      // RLE, LRE, RLO, LRO, RLI, LRI, FSI
      let is_isolate = is_isolate_initiator_tag(orig)
      if is_isolate {
        if last_status == 1 {
          pt_byte = tag_r_b
        } else if last_status == 2 {
          pt_byte = tag_l_b
        }
      } else {
        pt_byte = tag_bn_b
      }

      let next_lv = if is_rtl_initiator_tag(orig) {
        (last_level + 1) | 1
      } else {
        (last_level + 2) & -2
      }

      if next_lv <= max_depth && overflow_isolate_count == 0 && overflow_embedding_count == 0 {
        let new_status = if orig == tag_rlo {
          1
        } else if orig == tag_lro {
          2
        } else if is_isolate {
          3
        } else {
          0
        }
        let next_lv_b = next_lv.to_byte()
        exp_stack[sp] = next_lv_b
        exp_stack[128 + sp] = new_status.to_byte()
        sp = sp + 1
        last_level = next_lv
        last_level_b = next_lv_b
        last_status = new_status
        if is_isolate {
          valid_isolate_count = valid_isolate_count + 1
        } else {
          lv_byte = next_lv_b
        }
      } else if is_isolate {
        overflow_isolate_count = overflow_isolate_count + 1
      } else if overflow_isolate_count == 0 {
        overflow_embedding_count = overflow_embedding_count + 1
      }
    }

    levels[abs_i] = lv_byte
    proc_tags[abs_i] = pt_byte
    if step > 1 {
      let mut j = 1
      while j < step && abs_i + j < para_end {
        levels[abs_i + j] = lv_byte
        proc_tags[abs_i + j] = pt_byte
        j = j + 1
      }
    }

    // Identify BD7 level runs.
    let lv_val = lv_byte.to_int()
    if rel == 0 {
      current_run_level = lv_val
    } else if lv_val != current_run_level && !removed_by_x9_tag(orig) {
      run_starts.push(current_run_start)
      run_ends.push(rel)
      current_run_level = lv_val
      current_run_start = rel
    }

    rel = rel + step
  }

  if para_len > current_run_start {
    run_starts.push(current_run_start)
    run_ends.push(para_len)
  }
}
