///| Internal BidiClass integer tags and zero-allocation UTF-8 helpers.

let tag_al : Int = 0
let tag_an : Int = 1
let tag_b : Int = 2
let tag_bn : Int = 3
let tag_cs : Int = 4
let tag_en : Int = 5
let tag_es : Int = 6
let tag_et : Int = 7
let tag_fsi : Int = 8
let tag_l : Int = 9
let tag_lre : Int = 10
let tag_lri : Int = 11
let tag_lro : Int = 12
let tag_nsm : Int = 13
let tag_on : Int = 14
let tag_pdf : Int = 15
let tag_pdi : Int = 16
let tag_r : Int = 17
let tag_rle : Int = 18
let tag_rli : Int = 19
let tag_rlo : Int = 20
let tag_s : Int = 21
let tag_ws : Int = 22

///| Decode the UTF-8 scalar value at byte offset `pos`, returning packed `(codepoint << 3) | byte_len` (zero allocation).
fn utf8_decode_packed(text : String, pos : Int) -> Int {
  let n = text.length()
  if pos >= n {
    return 0
  }
  let b0 = text.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0 << 3) | 1
  }
  if (b0 & 0xE0) == 0xC0 && pos + 1 < n {
    let b1 = text.code_unit_at(pos + 1)
    if (b1 & 0xC0) == 0x80 {
      return ((((b0 & 0x1F) << 6) | (b1 & 0x3F)) << 3) | 2
    }
  } else if (b0 & 0xF0) == 0xE0 && pos + 2 < n {
    let b1 = text.code_unit_at(pos + 1)
    let b2 = text.code_unit_at(pos + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      return ((((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)) << 3) | 3
    }
  } else if (b0 & 0xF8) == 0xF0 && pos + 3 < n {
    let b1 = text.code_unit_at(pos + 1)
    let b2 = text.code_unit_at(pos + 2)
    let b3 = text.code_unit_at(pos + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      return (
        (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)) << 3
      ) | 4
    }
  }
  (0xFFFD << 3) | 1
}

///| Decode the UTF-8 scalar value at byte offset `pos`, returning `(codepoint, byte_len)`.
fn utf8_decode_at(text : String, pos : Int) -> (Int, Int) {
  let packed = utf8_decode_packed(text, pos)
  (packed >> 3, packed & 7)
}

///| Return the UTF-8 byte length of the character starting at `pos` (1..4), or 0 if continuation/OOB.
fn utf8_char_len_at(text : String, pos : Int) -> Int {
  let n = text.length()
  if pos < 0 || pos >= n {
    return 0
  }
  let b0 = text.code_unit_at(pos)
  if b0 < 0x80 {
    return 1
  }
  if (b0 & 0xC0) == 0x80 {
    return 0
  }
  if (b0 & 0xE0) == 0xC0 && pos + 1 < n {
    return 2
  }
  if (b0 & 0xF0) == 0xE0 && pos + 2 < n {
    return 3
  }
  if (b0 & 0xF8) == 0xF0 && pos + 3 < n {
    return 4
  }
  1
}

///| Return valid complete UTF-8 sequence length within `[pos, end)` (1..4), or `0` if invalid/truncated.
fn utf8_valid_len_in(text : String, pos : Int, end : Int) -> Int {
  if pos < 0 || pos >= end {
    return 0
  }
  let b0 = text.code_unit_at(pos)
  if b0 < 0x80 {
    return 1
  }
  if (b0 & 0xE0) == 0xC0 && pos + 1 < end {
    let b1 = text.code_unit_at(pos + 1)
    if (b1 & 0xC0) == 0x80 {
      return 2
    }
  } else if (b0 & 0xF0) == 0xE0 && pos + 2 < end {
    let b1 = text.code_unit_at(pos + 1)
    let b2 = text.code_unit_at(pos + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      return 3
    }
  } else if (b0 & 0xF8) == 0xF0 && pos + 3 < end {
    let b1 = text.code_unit_at(pos + 1)
    let b2 = text.code_unit_at(pos + 2)
    let b3 = text.code_unit_at(pos + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      return 4
    }
  }
  0
}

///| Encode a Unicode scalar value `cp` as UTF-8 bytes into `sb`.
fn utf8_write_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Write raw byte range `text[start..end)` into `sb`.
fn write_text_slice(sb : StringBuilder, text : String, start : Int, end : Int) -> Unit {
  let mut i = start
  while i < end {
    sb.write_byte(text.code_unit_at(i).to_byte())
    i = i + 1
  }
}

///| True if `tag` is removed by UAX #9 Rule X9 (RLE, LRE, RLO, LRO, PDF, BN).
fn removed_by_x9_tag(tag : Int) -> Bool {
  // Bitmask for tags: BN(3), LRE(10), LRO(12), PDF(15), RLE(18), RLO(20)
  ((1348616 >> tag) & 1) != 0
}

///| True if `tag` is an RTL explicit initiator (RLE, RLO, RLI).
fn is_rtl_initiator_tag(tag : Int) -> Bool {
  // Bitmask for tags: RLE(18), RLI(19), RLO(20)
  ((1835008 >> tag) & 1) != 0
}

///| True if `tag` is an isolate initiator (RLI, LRI, FSI).
fn is_isolate_initiator_tag(tag : Int) -> Bool {
  // Bitmask for tags: FSI(8), LRI(11), RLI(19)
  ((526592 >> tag) & 1) != 0
}

///| True if `tag` is Neutral or Isolate (NI): B, S, WS, ON, FSI, LRI, RLI, PDI.
fn is_ni_tag(tag : Int) -> Bool {
  // Bitmask for tags: B(2), FSI(8), LRI(11), ON(14), PDI(16), RLI(19), S(21), WS(22)
  ((6899972 >> tag) & 1) != 0
}

///| True if `tag` is Neutral/Isolate (NI) or BN.
fn is_ni_or_bn_tag(tag : Int) -> Bool {
  // Bitmask for NI | BN(3)
  ((6899980 >> tag) & 1) != 0
}

///| True if `tag` is an explicit/isolate/paragraph-separator control in X1-X8.
fn is_explicit_or_b_tag(tag : Int) -> Bool {
  // Bitmask for tags: B(2), FSI(8), LRE(10), LRI(11), LRO(12), PDF(15), PDI(16), RLE(18), RLI(19), RLO(20)
  ((1940740 >> tag) & 1) != 0
}

///| True if `tag` requires state updates in Pass 1 (all non-L tags that affect P1-P3/X5c/flags).
fn is_pass1_special_tag(tag : Int) -> Bool {
  // Bitmask for tags: AL(0), AN(1), B(2), BN(3), FSI(8), LRE(10), LRI(11), LRO(12), PDF(15), PDI(16), R(17), RLE(18), RLI(19), RLO(20)
  ((2071823 >> tag) & 1) != 0
}

///| True if `tag` breaks out of the single-paragraph pure-LTR fast path.
fn is_pure_ltr_breaker_tag(tag : Int) -> Bool {
  // Bitmask for tags: AL(0), AN(1), B(2), FSI(8), LRE(10), LRI(11), LRO(12), R(17), RLE(18), RLI(19), RLO(20)
  ((1973511 >> tag) & 1) != 0
}

///| Return strong class tag (`tag_r` or `tag_l`) for an integer embedding level.
fn level_to_bidi_tag(lv : Int) -> Int {
  if (lv & 1) == 1 {
    tag_r
  } else {
    tag_l
  }
}
