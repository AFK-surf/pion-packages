///| Top-level UAX #9 Bidirectional Algorithm entrypoints (P1–P3, BidiInfo, compatibility helpers).

///| Unicode version of the embedded UAX #9 tables (`16.0.0`).
pub fn unicode_version() -> (Int, Int, Int) {
  (16, 0, 0)
}

fn get_base_direction_impl(text : String, use_full_text : Bool) -> Direction {
  let n = text.length()
  let bmp_idx = bmp_page_idx
  let bmp_data = bmp_page_data
  let mut isolate_level = 0
  let mut pos = 0
  while pos < n {
    let b0 = text.code_unit_at(pos)
    let mut tag = 9
    let mut step = 1
    if b0 < 0x80 {
      tag = bmp_data.code_unit_at(b0) - 65
    } else if (b0 & 0xE0) == 0xC0 && pos + 1 < n {
      let b1 = text.code_unit_at(pos + 1)
      if (b1 & 0xC0) == 0x80 {
        let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
        step = 2
        tag = bmp_data.code_unit_at((bmp_idx[cp >> 8] << 8) | (cp & 0xFF)) - 65
      } else {
        tag = tag_on
      }
    } else {
      let dec = utf8_decode_packed(text, pos)
      let cp = dec >> 3
      let len = dec & 7
      step = if len > 0 { len } else { 1 }
      tag = if cp < 0x10000 {
        bmp_data.code_unit_at((bmp_idx[cp >> 8] << 8) | (cp & 0xFF)) - 65
      } else {
        bidi_class_tag(cp)
      }
    }
    if tag == tag_l {
      if isolate_level == 0 {
        return Direction::Ltr
      }
    } else if tag == tag_r || tag == tag_al {
      if isolate_level == 0 {
        return Direction::Rtl
      }
    } else if tag == tag_lri || tag == tag_rli || tag == tag_fsi {
      isolate_level = isolate_level + 1
    } else if tag == tag_pdi {
      if isolate_level > 0 {
        isolate_level = isolate_level - 1
      }
    } else if tag == tag_b {
      if !use_full_text {
        break
      } else {
        isolate_level = 0
      }
    }
    pos = pos + step
  }
  Direction::Mixed
}

///| Determine base direction of the first paragraph per UAX #9 P2–P3 (`Mixed` if all-neutral).
pub fn get_base_direction(text : String) -> Direction {
  get_base_direction_impl(text, false)
}

///| Determine base direction across paragraphs per UAX #9 P2–P3 (`Mixed` if all-neutral).
pub fn get_base_direction_full(text : String) -> Direction {
  get_base_direction_impl(text, true)
}

// Per-paragraph flag bits packed into a single Int:
//   bit 0 (1): pure_ltr
//   bit 1 (2): has_iso
//   bit 2 (4): has_x9
//   bit 3 (8): has_explicit

///| Pass 2 fast path when no non-LTR paragraph has explicit controls, isolates, or X9/BN chars.
///| Overwrites `orig_tags` in place with resolved level bytes and returns `(levels, level_bytes)`.
fn pass2_flat_nox9(
  text : String,
  n : Int,
  paragraphs : Array[ParagraphInfo],
  para_flags : Array[Int],
  original_classes : Array[BidiClass],
  orig_tags : FixedArray[Byte],
  max_bracket_depth : Int,
) -> (Array[Level], FixedArray[Byte]) {
  let lv_lut = level_lut
  let n_paras = paragraphs.length()
  let first_lv = if n_paras > 0 { paragraphs[0].level.number() } else { 0 }
  let levels : Array[Level] = Array::make(n, lv_lut[first_lv])

  let mut pi = 0
  while pi < n_paras {
    let para = paragraphs[pi]
    let p_start = para.range.start
    let p_end = para.range.end
    let p_lv = para.level.number()
    let flags = para_flags[pi]

    if p_lv == 0 && (flags & 1) != 0 {
      let zero_b = (0).to_byte()
      let zero_lv = lv_lut[0]
      let need_write = first_lv != 0
      let mut i = p_start
      while i < p_end {
        orig_tags[i] = zero_b
        if need_write {
          levels[i] = zero_lv
        }
        i = i + 1
      }
      pi = pi + 1
      continue
    }

    let sos = level_to_bidi_tag(p_lv)
    let has_on = resolve_weak_single_nox9(text, p_start, p_end, sos, sos, orig_tags)
    resolve_neutral_flat_nox9(
      text,
      p_start,
      p_end,
      p_lv,
      sos,
      sos,
      original_classes,
      orig_tags,
      max_bracket_depth,
      has_on,
    )

    let base_lv = lv_lut[p_lv]
    let base_b = p_lv.to_byte()
    let need_base_write = p_lv != first_lv
    if (p_lv & 1) == 0 {
      let n1 = if p_lv + 1 > 126 { 126 } else { p_lv + 1 }
      let n2 = if p_lv + 2 > 126 { 126 } else { p_lv + 2 }
      let lv1 = lv_lut[n1]
      let lv2 = lv_lut[n2]
      let b1 = n1.to_byte()
      let b2 = n2.to_byte()
      let mut i = p_start
      while i < p_end {
        let pt = orig_tags[i].to_int()
        if pt == tag_r {
          orig_tags[i] = b1
          levels[i] = lv1
        } else if pt == tag_an || pt == tag_en {
          orig_tags[i] = b2
          levels[i] = lv2
        } else {
          orig_tags[i] = base_b
          if need_base_write {
            levels[i] = base_lv
          }
        }
        i = i + 1
      }
    } else {
      let n1 = if p_lv + 1 > 126 { 126 } else { p_lv + 1 }
      let lv1 = lv_lut[n1]
      let b1 = n1.to_byte()
      let mut i = p_start
      while i < p_end {
        let pt = orig_tags[i].to_int()
        if pt == tag_l || pt == tag_en || pt == tag_an {
          orig_tags[i] = b1
          levels[i] = lv1
        } else {
          orig_tags[i] = base_b
          if need_base_write {
            levels[i] = base_lv
          }
        }
        i = i + 1
      }
    }

    pi = pi + 1
  }

  (levels, orig_tags)
}

///| General Pass 2 for paragraphs with explicit embeddings, isolates, or X9/BN chars.
fn pass2_general(
  text : String,
  n : Int,
  paragraphs : Array[ParagraphInfo],
  para_flags : Array[Int],
  orig_tags : FixedArray[Byte],
  max_depth : Int,
  max_bracket_depth : Int,
) -> (Array[Level], FixedArray[Byte]) {
  let lv_lut = level_lut
  let n_paras = paragraphs.length()
  let level_bytes : FixedArray[Byte] = FixedArray::make(n, (0).to_byte())
  let proc_tags : FixedArray[Byte] = FixedArray::make(n, (0).to_byte())
  let scratch = bidi_scratch_new(n, max_bracket_depth)

  let mut pi = 0
  while pi < n_paras {
    let para = paragraphs[pi]
    let p_start = para.range.start
    let p_end = para.range.end
    let p_lv = para.level.number()
    let flags = para_flags[pi]

    if p_lv == 0 && (flags & 1) != 0 {
      pi = pi + 1
      continue
    }

    let p_has_iso = (flags & 2) != 0
    let p_has_x9 = (flags & 4) != 0

    scratch.run_starts.clear()
    scratch.run_ends.clear()
    explicit_compute(
      text,
      p_start,
      p_end,
      p_lv,
      max_depth,
      orig_tags,
      level_bytes,
      proc_tags,
      scratch.run_starts,
      scratch.run_ends,
      scratch.exp_stack,
    )

    if !p_has_iso {
      let n_runs = scratch.run_starts.length()
      let mut r = 0
      while r < n_runs {
        let rs = scratch.run_starts[r]
        let re = scratch.run_ends[r]
        let (sos, eos) = compute_single_run_sos_eos(
          p_start,
          p_end - p_start,
          p_lv,
          orig_tags,
          level_bytes,
          rs,
          re,
          p_has_x9,
        )
        if !p_has_x9 {
          let has_on = resolve_weak_single_nox9(
            text,
            p_start + rs,
            p_start + re,
            sos,
            eos,
            proc_tags,
          )
          resolve_neutral_single_nox9(
            text,
            p_start + rs,
            p_start + re,
            level_bytes[p_start + rs].to_int(),
            sos,
            eos,
            orig_tags,
            proc_tags,
            max_bracket_depth,
            has_on,
            scratch,
          )
        } else {
          scratch.seq_s.clear()
          scratch.seq_e.clear()
          scratch.seq_s.push(rs)
          scratch.seq_e.push(re)
          let seq = IsoRunSeq::{
            run_starts: scratch.seq_s,
            run_ends: scratch.seq_e,
            sos: sos,
            eos: eos,
          }
          let has_on = resolve_weak(text, p_start, seq, proc_tags, scratch)
          resolve_neutral(
            text,
            p_start,
            seq,
            level_bytes,
            orig_tags,
            proc_tags,
            max_bracket_depth,
            has_on,
            scratch,
          )
        }
        r = r + 1
      }
    } else {
      process_isolating_run_sequences(
        text,
        p_start,
        p_end - p_start,
        p_lv,
        orig_tags,
        level_bytes,
        proc_tags,
        scratch.run_starts,
        scratch.run_ends,
        max_bracket_depth,
        p_has_x9,
        scratch,
      )
    }

    resolve_implicit_and_x9(
      p_start,
      p_end,
      p_lv,
      p_has_x9,
      orig_tags,
      proc_tags,
      level_bytes,
    )

    pi = pi + 1
  }

  let first_lv = if n_paras > 0 { paragraphs[0].level.number() } else { 0 }
  let levels : Array[Level] = Array::make(n, lv_lut[first_lv])
  let mut idx = 0
  while idx < n {
    let b = level_bytes[idx].to_int()
    if b != first_lv {
      levels[idx] = lv_lut[b]
    }
    idx = idx + 1
  }
  (levels, level_bytes)
}

///| General Pass 1 + Pass 2 continuation when text is not a single pure-LTR paragraph.
///| Resumes from `resume_pos` where `original_classes[0..resume_pos)` is already populated.
fn compute_bidi_general_from(
  text : String,
  n : Int,
  default_lv : Int,
  max_depth : Int,
  max_bracket_depth : Int,
  original_classes : Array[BidiClass],
  resume_pos : Int,
  init_para_level : Int,
  init_has_x9 : Bool,
  init_has_explicit : Bool,
  init_has_l1_non_ws : Bool,
) -> BidiInfo {
  let bmp_idx = bmp_page_idx
  let bmp_data = bmp_page_data
  let class_lut = bidi_class_lut
  let lv_lut = level_lut

  let mut orig_tags_init = default_lv > 0
  let mut orig_tags : FixedArray[Byte] = if orig_tags_init {
    FixedArray::make(n, (9).to_byte())
  } else {
    FixedArray::make(0, (0).to_byte())
  }

  let paragraphs : Array[ParagraphInfo] = Array::with_capacity(1)
  let para_flags : Array[Int] = Array::with_capacity(1)

  let mut iso_stack_init = false
  let mut isolate_stack : Array[Int] = Array::new()
  let mut iso_depth = 0
  let mut para_start = 0
  let mut para_level = init_para_level
  let mut is_pure_ltr = true
  let mut has_iso = false
  let mut has_x9 = init_has_x9
  let mut has_explicit = init_has_explicit
  let mut any_non_pure_ltr = default_lv > 0
  let mut any_needs_general = false
  let mut has_l1_non_ws = init_has_x9 || init_has_explicit || init_has_l1_non_ws

  let mut pos = resume_pos
  while pos < n {
    let b0 = text.code_unit_at(pos)
    let mut tag = 9
    let mut step = 1
    if b0 < 0x80 {
      let c = b0 | 32
      if c >= 97 && c <= 122 {
        if iso_depth > 0 {
          let iso_start = isolate_stack[iso_depth - 1]
          if orig_tags[iso_start].to_int() == tag_fsi {
            let repl = tag_lri.to_byte()
            orig_tags[iso_start] = repl
            original_classes[iso_start] = BidiClass::LRI
            if iso_start + 1 < n {
              orig_tags[iso_start + 1] = repl
              original_classes[iso_start + 1] = BidiClass::LRI
            }
            if iso_start + 2 < n {
              orig_tags[iso_start + 2] = repl
              original_classes[iso_start + 2] = BidiClass::LRI
            }
          }
        } else if para_level < 0 {
          para_level = 0
        }
        pos = pos + 1
        continue
      }
      tag = bmp_data.code_unit_at(b0) - 65
    } else if (b0 & 0xE0) == 0xC0 && pos + 1 < n {
      let b1 = text.code_unit_at(pos + 1)
      if (b1 & 0xC0) == 0x80 {
        let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
        step = 2
        tag = bmp_data.code_unit_at((bmp_idx[cp >> 8] << 8) | (cp & 0xFF)) - 65
      } else {
        tag = tag_on
      }
    } else {
      let dec = utf8_decode_packed(text, pos)
      let cp = dec >> 3
      let d_len = dec & 7
      step = if d_len > 0 { d_len } else { 1 }
      tag = if cp < 0x10000 {
        bmp_data.code_unit_at((bmp_idx[cp >> 8] << 8) | (cp & 0xFF)) - 65
      } else {
        bidi_class_tag(cp)
      }
    }

    if tag == tag_l {
      if iso_depth > 0 {
        let iso_start = isolate_stack[iso_depth - 1]
        if orig_tags[iso_start].to_int() == tag_fsi {
          let repl = tag_lri.to_byte()
          orig_tags[iso_start] = repl
          original_classes[iso_start] = BidiClass::LRI
          if iso_start + 1 < n {
            orig_tags[iso_start + 1] = repl
            original_classes[iso_start + 1] = BidiClass::LRI
          }
          if iso_start + 2 < n {
            orig_tags[iso_start + 2] = repl
            original_classes[iso_start + 2] = BidiClass::LRI
          }
        }
      } else if para_level < 0 {
        para_level = 0
      }
      pos = pos + step
      continue
    }

    let cls = class_lut[tag]
    original_classes[pos] = cls
    if step > 1 {
      let mut k = 1
      while k < step && pos + k < n {
        original_classes[pos + k] = cls
        k = k + 1
      }
    }
    if orig_tags_init {
      let tag_b_val = tag.to_byte()
      orig_tags[pos] = tag_b_val
      if step > 1 {
        let mut k = 1
        while k < step && pos + k < n {
          orig_tags[pos + k] = tag_b_val
          k = k + 1
        }
      }
    }

    if !is_pass1_special_tag(tag) {
      if tag == tag_s {
        has_l1_non_ws = true
      }
      pos = pos + step
      continue
    }

    if tag == tag_r || tag == tag_al {
      is_pure_ltr = false
      any_non_pure_ltr = true
      if !orig_tags_init {
        orig_tags = FixedArray::make(n, (9).to_byte())
        orig_tags_init = true
        let mut bi = para_start
        while bi < pos + step && bi < n {
          orig_tags[bi] = bidi_class_to_int(original_classes[bi]).to_byte()
          bi = bi + 1
        }
      }
      if iso_depth > 0 {
        let iso_start = isolate_stack[iso_depth - 1]
        if orig_tags[iso_start].to_int() == tag_fsi {
          let repl = tag_rli.to_byte()
          orig_tags[iso_start] = repl
          original_classes[iso_start] = BidiClass::RLI
          if iso_start + 1 < n {
            orig_tags[iso_start + 1] = repl
            original_classes[iso_start + 1] = BidiClass::RLI
          }
          if iso_start + 2 < n {
            orig_tags[iso_start + 2] = repl
            original_classes[iso_start + 2] = BidiClass::RLI
          }
        }
      } else if para_level < 0 {
        para_level = 1
      }
    } else if tag == tag_b {
      has_l1_non_ws = true
      let para_end = pos + step
      let resolved_lv = if para_level >= 0 { para_level } else { 0 }
      paragraphs.push(
        ParagraphInfo::{
          range: TextRange::{ start: para_start, end: para_end },
          level: lv_lut[resolved_lv],
        },
      )
      let flags = (if is_pure_ltr { 1 } else { 0 }) |
      (if has_iso { 2 } else { 0 }) |
      (if has_x9 { 4 } else { 0 }) |
      (if has_explicit { 8 } else { 0 })
      para_flags.push(flags)
      if resolved_lv != 0 || !is_pure_ltr {
        any_non_pure_ltr = true
        if has_iso || has_x9 || has_explicit {
          any_needs_general = true
        }
      }
      para_start = para_end
      para_level = default_lv
      is_pure_ltr = true
      has_iso = false
      has_x9 = false
      has_explicit = false
      if iso_depth > 0 {
        isolate_stack.clear()
        iso_depth = 0
      }
    } else if tag == tag_rli || tag == tag_lri || tag == tag_fsi {
      has_l1_non_ws = true
      is_pure_ltr = false
      has_iso = true
      any_non_pure_ltr = true
      if !orig_tags_init {
        orig_tags = FixedArray::make(n, (9).to_byte())
        orig_tags_init = true
        let mut bi = para_start
        while bi < pos + step && bi < n {
          orig_tags[bi] = bidi_class_to_int(original_classes[bi]).to_byte()
          bi = bi + 1
        }
      }
      if !iso_stack_init {
        isolate_stack = Array::with_capacity(8)
        iso_stack_init = true
      }
      isolate_stack.push(pos)
      iso_depth = iso_depth + 1
    } else if tag == tag_pdi {
      has_l1_non_ws = true
      if iso_depth > 0 {
        let _ = isolate_stack.pop()
        iso_depth = iso_depth - 1
      }
    } else if tag == tag_an || tag == tag_lre || tag == tag_rle || tag == tag_lro ||
    tag == tag_rlo {
      is_pure_ltr = false
      any_non_pure_ltr = true
      if tag != tag_an {
        has_x9 = true
        has_explicit = true
        has_l1_non_ws = true
      }
      if !orig_tags_init {
        orig_tags = FixedArray::make(n, (9).to_byte())
        orig_tags_init = true
        let mut bi = para_start
        while bi < pos + step && bi < n {
          orig_tags[bi] = bidi_class_to_int(original_classes[bi]).to_byte()
          bi = bi + 1
        }
      }
    } else {
      // tag_bn or tag_pdf
      has_x9 = true
      has_l1_non_ws = true
      if tag == tag_pdf {
        has_explicit = true
      }
    }

    pos = pos + step
  }

  if para_start < n {
    let resolved_lv = if para_level >= 0 { para_level } else { 0 }
    paragraphs.push(
      ParagraphInfo::{
        range: TextRange::{ start: para_start, end: n },
        level: lv_lut[resolved_lv],
      },
    )
    let flags = (if is_pure_ltr { 1 } else { 0 }) |
    (if has_iso { 2 } else { 0 }) |
    (if has_x9 { 4 } else { 0 }) |
    (if has_explicit { 8 } else { 0 })
    para_flags.push(flags)
    if resolved_lv != 0 || !is_pure_ltr {
      any_non_pure_ltr = true
      if has_iso || has_x9 || has_explicit {
        any_needs_general = true
      }
    }
  }

  if !any_non_pure_ltr {
    return BidiInfo::{
      text: text,
      original_classes: original_classes,
      levels: Array::make(n, lv_lut[0]),
      paragraphs: paragraphs,
      level_bytes: FixedArray::make(0, (0).to_byte()),
      l1_only_ws: !has_l1_non_ws,
    }
  }

  let (levels, level_bytes) = if !any_needs_general {
    pass2_flat_nox9(text, n, paragraphs, para_flags, original_classes, orig_tags, max_bracket_depth)
  } else {
    pass2_general(text, n, paragraphs, para_flags, orig_tags, max_depth, max_bracket_depth)
  }

  BidiInfo::{
    text: text,
    original_classes: original_classes,
    levels: levels,
    paragraphs: paragraphs,
    level_bytes: level_bytes,
    l1_only_ws: !has_l1_non_ws,
  }
}

///| Core UAX #9 `BidiInfo` builder (after limit & level validation, zero `Result` boxing).
fn compute_bidi_checked(
  text : String,
  n : Int,
  default_lv : Int,
  max_depth : Int,
  max_bracket_depth : Int,
) -> BidiInfo {
  if n == 0 {
    return BidiInfo::{
      text: text,
      original_classes: [],
      levels: [],
      paragraphs: [],
      level_bytes: FixedArray::make(0, (0).to_byte()),
      l1_only_ws: true,
    }
  }

  let original_classes : Array[BidiClass] = Array::make(n, BidiClass::L)

  // Fast path: single-paragraph pure-LTR scan with minimal locals (fits in CPU registers, zero extra allocs).
  if default_lv <= 0 {
    let bmp_idx = bmp_page_idx
    let bmp_data = bmp_page_data
    let class_lut = bidi_class_lut
    let mut para_level = default_lv
    let mut has_x9 = false
    let mut has_explicit = false
    let mut has_l1_non_ws = false
    let mut pos = 0

    while pos < n {
      let b0 = text.code_unit_at(pos)
      if b0 < 0x80 {
        let c = b0 | 32
        if c >= 97 && c <= 122 {
          if para_level < 0 {
            para_level = 0
          }
          pos = pos + 1
          continue
        }
        let tag = bmp_data.code_unit_at(b0) - 65
        if tag == tag_l {
          if para_level < 0 {
            para_level = 0
          }
          pos = pos + 1
          continue
        }
        if is_pure_ltr_breaker_tag(tag) {
          return compute_bidi_general_from(
            text,
            n,
            default_lv,
            max_depth,
            max_bracket_depth,
            original_classes,
            pos,
            para_level,
            has_x9,
            has_explicit,
            has_l1_non_ws,
          )
        }
        original_classes[pos] = class_lut[tag]
        if tag == tag_bn {
          has_x9 = true
          has_l1_non_ws = true
        } else if tag == tag_s {
          has_l1_non_ws = true
        }
        pos = pos + 1
        continue
      }

      let mut tag = 9
      let mut step = 1
      if (b0 & 0xE0) == 0xC0 && pos + 1 < n {
        let b1 = text.code_unit_at(pos + 1)
        if (b1 & 0xC0) == 0x80 {
          let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
          step = 2
          tag = bmp_data.code_unit_at((bmp_idx[cp >> 8] << 8) | (cp & 0xFF)) - 65
        } else {
          tag = tag_on
        }
      } else {
        let dec = utf8_decode_packed(text, pos)
        let cp = dec >> 3
        let d_len = dec & 7
        step = if d_len > 0 { d_len } else { 1 }
        tag = if cp < 0x10000 {
          bmp_data.code_unit_at((bmp_idx[cp >> 8] << 8) | (cp & 0xFF)) - 65
        } else {
          bidi_class_tag(cp)
        }
      }

      if tag == tag_l {
        if para_level < 0 {
          para_level = 0
        }
        pos = pos + step
        continue
      }

      if is_pure_ltr_breaker_tag(tag) {
        return compute_bidi_general_from(
          text,
          n,
          default_lv,
          max_depth,
          max_bracket_depth,
          original_classes,
          pos,
          para_level,
          has_x9,
          has_explicit,
          has_l1_non_ws,
        )
      }

      let cls = class_lut[tag]
      original_classes[pos] = cls
      if step > 1 {
        let mut k = 1
        while k < step && pos + k < n {
          original_classes[pos + k] = cls
          k = k + 1
        }
      }
      if tag == tag_bn || tag == tag_pdf {
        has_x9 = true
        has_l1_non_ws = true
        if tag == tag_pdf {
          has_explicit = true
        }
      } else if tag == tag_s || tag == tag_pdi {
        has_l1_non_ws = true
      }
      pos = pos + step
    }

    let lv0 = level_lut[0]
    return BidiInfo::{
      text: text,
      original_classes: original_classes,
      levels: Array::make(n, lv0),
      paragraphs: [
        ParagraphInfo::{
          range: TextRange::{ start: 0, end: n },
          level: lv0,
        },
      ],
      level_bytes: FixedArray::make(0, (0).to_byte()),
      l1_only_ws: false,
    }
  }

  compute_bidi_general_from(
    text,
    n,
    default_lv,
    max_depth,
    max_bracket_depth,
    original_classes,
    0,
    default_lv,
    false,
    false,
    false,
  )
}

///| Compute UAX #9 `BidiInfo` with explicit resource limits.
pub fn BidiInfo::new_with_limits(
  text : String,
  default_level : Option[Level],
  limits : Limits,
) -> Result[BidiInfo, BidiError] {
  let n = text.length()
  if n > limits.max_input_bytes {
    return Err(BidiError::InputTooLong(n, limits.max_input_bytes))
  }
  let max_depth = if limits.max_depth > 125 {
    125
  } else if limits.max_depth < 0 {
    0
  } else {
    limits.max_depth
  }
  let max_bracket_depth = if limits.max_bracket_depth < 0 {
    0
  } else {
    limits.max_bracket_depth
  }

  let default_lv = match default_level {
    Some(l) => {
      let lv = l.number()
      if lv > 125 {
        return Err(BidiError::OutOfRangeLevel(lv))
      }
      lv
    }
    None => -1
  }

  Ok(compute_bidi_checked(text, n, default_lv, max_depth, max_bracket_depth))
}

///| Compute UAX #9 `BidiInfo` with default limits.
///| Total API: clamps `default_level > 125` to `124` (even explicit max) and falls back to
///| uniform LTR/default levels if input exceeds the 16 MiB default limit.
pub fn BidiInfo::new(text : String, default_level : Option[Level]) -> BidiInfo {
  let n = text.length()
  let default_lv = match default_level {
    Some(l) => {
      let lv = l.number()
      if lv > 125 { 124 } else { lv }
    }
    None => -1
  }
  if n <= 16 * 1024 * 1024 {
    return compute_bidi_checked(text, n, default_lv, 125, 63)
  }
  let fallback_lv = if default_lv >= 0 { level_lut[default_lv] } else { Level::ltr() }
  let paragraphs : Array[ParagraphInfo] = if n > 0 {
    [
      ParagraphInfo::{
        range: TextRange::{ start: 0, end: n },
        level: fallback_lv,
      },
    ]
  } else {
    []
  }
  let lb : FixedArray[Byte] = if fallback_lv.number() == 0 {
    FixedArray::make(0, (0).to_byte())
  } else {
    FixedArray::make(n, fallback_lv.value)
  }
  BidiInfo::{
    text: text,
    original_classes: Array::make(n, BidiClass::L),
    levels: Array::make(n, fallback_lv),
    paragraphs: paragraphs,
    level_bytes: lb,
    l1_only_ws: true,
  }
}

///| True if any byte in `self.levels` has an odd (RTL) embedding level.
pub fn BidiInfo::has_rtl(self : BidiInfo) -> Bool {
  let lb = self.level_bytes
  let n = lb.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    if (lb[i].to_int() & 1) == 1 {
      return true
    }
    i = i + 1
  }
  false
}

///| Directionality of a resolved paragraph (`Ltr`, `Rtl`, or `Mixed`).
pub fn BidiInfo::paragraph_direction(self : BidiInfo, para : ParagraphInfo) -> Direction {
  let lb = self.level_bytes
  let n = self.levels.length()
  let start = para.range.start
  let end = if para.range.end > n { n } else { para.range.end }
  if lb.length() == 0 {
    return if start < end { Direction::Ltr } else { Direction::Rtl }
  }
  let mut has_ltr = false
  let mut has_rtl = false
  let mut i = start
  while i < end {
    if (lb[i].to_int() & 1) == 1 {
      has_rtl = true
      if has_ltr {
        return Direction::Mixed
      }
    } else {
      has_ltr = true
      if has_rtl {
        return Direction::Mixed
      }
    }
    i = i + 1
  }
  if has_ltr {
    Direction::Ltr
  } else {
    Direction::Rtl
  }
}

///| O(1) fast L1 check when `self.l1_only_ws` is true (only trailing `WS` at `end` can change).
fn l1_trailing_ws_needs_change(
  orig_classes : Array[BidiClass],
  lb : FixedArray[Byte],
  start : Int,
  end : Int,
  para_v : Byte,
) -> Bool {
  let mut k = end - 1
  while k >= start {
    match orig_classes[k] {
      BidiClass::WS => {
        if lb[k] != para_v {
          return true
        }
        k = k - 1
      }
      _ => return false
    }
  }
  false
}

///| Apply UAX #9 Rule L1 to produce per-byte reordered levels for `line`.
pub fn BidiInfo::reordered_levels(
  self : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> Array[Level] {
  let n = self.levels.length()
  let start = if line.start < 0 { 0 } else if line.start > n { n } else { line.start }
  let end = if line.end < start { start } else if line.end > n { n } else { line.end }
  let lb = self.level_bytes
  if lb.length() == 0 && para.level.number() == 0 {
    return self.levels
  }
  let changed = if lb.length() == n {
    if self.l1_only_ws {
      l1_trailing_ws_needs_change(self.original_classes, lb, start, end, para.level.value)
    } else {
      l1_needs_change_bytes(self.original_classes, lb, start, end, para.level.value)
    }
  } else {
    l1_needs_change(self.original_classes, self.levels, start, end, para.level)
  }
  if !changed {
    return self.levels
  }
  let out = self.levels.copy()
  reorder_levels_l1(self.text, self.original_classes, out, start, end, para.level)
  out
}

///| Apply UAX #9 Rule L1 and sample one `Level` per Unicode scalar value in `self.text`.
pub fn BidiInfo::reordered_levels_per_char(
  self : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> Array[Level] {
  let n = self.levels.length()
  let start = if line.start < 0 { 0 } else if line.start > n { n } else { line.start }
  let end = if line.end < start { start } else if line.end > n { n } else { line.end }
  let lv_lut = level_lut
  let local_l1 = reorder_levels_l1_local(
    self.text,
    self.original_classes,
    self.levels,
    start,
    end,
    para.level,
  )
  let out : Array[Level] = Array::new()
  let mut pos = 0
  while pos < n {
    if pos >= start && pos < end {
      out.push(lv_lut[local_l1[pos - start].to_int()])
    } else {
      out.push(self.levels[pos])
    }
    let len = utf8_char_len_at(self.text, pos)
    pos = pos + (if len > 0 { len } else { 1 })
  }
  out
}

///| Compute L1 levels and L2 visual runs for `line`.
pub fn BidiInfo::visual_runs(
  self : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> (Array[Level], Array[TextRange]) {
  let n = self.levels.length()
  let start = if line.start < 0 { 0 } else if line.start > n { n } else { line.start }
  let end = if line.end < start { start } else if line.end > n { n } else { line.end }
  let lb = self.level_bytes
  if lb.length() == 0 && para.level.number() == 0 {
    let runs : Array[TextRange] = if start < end {
      [TextRange::{ start: start, end: end }]
    } else {
      []
    }
    return (self.levels, runs)
  }
  if lb.length() == n {
    let changed = if self.l1_only_ws {
      l1_trailing_ws_needs_change(self.original_classes, lb, start, end, para.level.value)
    } else {
      l1_needs_change_bytes(self.original_classes, lb, start, end, para.level.value)
    }
    if !changed {
      let runs = visual_runs_from_bytes(lb, start, end)
      return (self.levels, runs)
    }
  } else if !l1_needs_change(self.original_classes, self.levels, start, end, para.level) {
    let runs = visual_runs_for_line(self.levels, start, end)
    return (self.levels, runs)
  }
  let out = self.levels.copy()
  reorder_levels_l1(self.text, self.original_classes, out, start, end, para.level)
  let runs = visual_runs_for_line(out, start, end)
  (out, runs)
}

///| Reorder `line` into visual display order (L1 + L2, without L4 mirroring).
///| Runs in O(line) time and memory without copying the full document's levels.
pub fn BidiInfo::reorder_line(
  self : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> String {
  let n = self.levels.length()
  let start = if line.start < 0 { 0 } else if line.start > n { n } else { line.start }
  let end = if line.end < start { start } else if line.end > n { n } else { line.end }
  if start >= end {
    return ""
  }
  let lb = self.level_bytes
  if lb.length() == 0 {
    return self.text.slice(start, end)
  }
  if lb.length() == n {
    let mut any_rtl = false
    let mut i = start
    while i < end {
      if (lb[i].to_int() & 1) == 1 {
        any_rtl = true
        break
      }
      i = i + 1
    }
    if !any_rtl {
      return self.text.slice(start, end)
    }
    let changed = if self.l1_only_ws {
      l1_trailing_ws_needs_change(self.original_classes, lb, start, end, para.level.value)
    } else {
      l1_needs_change_bytes(self.original_classes, lb, start, end, para.level.value)
    }
    if !changed {
      let runs = visual_runs_from_bytes(lb, start, end)
      return reorder_line_from_bytes(self.text, start, end, lb, runs, false)
    }
  } else {
    let mut any_rtl = false
    let mut i = start
    while i < end {
      if self.levels[i].is_rtl() {
        any_rtl = true
        break
      }
      i = i + 1
    }
    if !any_rtl {
      return self.text.slice(start, end)
    }
    if !l1_needs_change(self.original_classes, self.levels, start, end, para.level) {
      let runs = visual_runs_for_line(self.levels, start, end)
      return reorder_line_from_levels(self.text, start, end, self.levels, runs, false)
    }
  }
  let local_l1 = reorder_levels_l1_local(
    self.text,
    self.original_classes,
    self.levels,
    start,
    end,
    para.level,
  )
  let runs = visual_runs_for_local_line(local_l1, start, end)
  reorder_line_from_local(self.text, start, end, local_l1, runs, false)
}

///| Reorder `line` into visual display order with UAX #9 Rule L4 mirroring for RTL runs.
///| Runs in O(line) time and memory without copying the full document's levels.
pub fn BidiInfo::reorder_line_with_mirroring(
  self : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> String {
  let n = self.levels.length()
  let start = if line.start < 0 { 0 } else if line.start > n { n } else { line.start }
  let end = if line.end < start { start } else if line.end > n { n } else { line.end }
  if start >= end {
    return ""
  }
  let lb = self.level_bytes
  if lb.length() == 0 {
    return self.text.slice(start, end)
  }
  if lb.length() == n {
    let mut any_rtl = false
    let mut i = start
    while i < end {
      if (lb[i].to_int() & 1) == 1 {
        any_rtl = true
        break
      }
      i = i + 1
    }
    if !any_rtl {
      return self.text.slice(start, end)
    }
    let changed = if self.l1_only_ws {
      l1_trailing_ws_needs_change(self.original_classes, lb, start, end, para.level.value)
    } else {
      l1_needs_change_bytes(self.original_classes, lb, start, end, para.level.value)
    }
    if !changed {
      let runs = visual_runs_from_bytes(lb, start, end)
      return reorder_line_from_bytes(self.text, start, end, lb, runs, true)
    }
  } else {
    let mut any_rtl = false
    let mut i = start
    while i < end {
      if self.levels[i].is_rtl() {
        any_rtl = true
        break
      }
      i = i + 1
    }
    if !any_rtl {
      return self.text.slice(start, end)
    }
    if !l1_needs_change(self.original_classes, self.levels, start, end, para.level) {
      let runs = visual_runs_for_line(self.levels, start, end)
      return reorder_line_from_levels(self.text, start, end, self.levels, runs, true)
    }
  }
  let local_l1 = reorder_levels_l1_local(
    self.text,
    self.original_classes,
    self.levels,
    start,
    end,
    para.level,
  )
  let runs = visual_runs_for_local_line(local_l1, start, end)
  reorder_line_from_local(self.text, start, end, local_l1, runs, true)
}

///| Reorder pre-calculated per-character levels via UAX #9 Rule L2 (`visual_idx -> logical_idx`).
pub fn BidiInfo::reorder_visual(levels : Array[Level]) -> Array[Int] {
  let ints : Array[Int] = Array::with_capacity(levels.length())
  let mut i = 0
  while i < levels.length() {
    ints.push(levels[i].number())
    i = i + 1
  }
  reorder_visual_ints(ints)
}

///| Top-level wrapper for `BidiInfo::visual_runs`.
pub fn visual_runs(
  info : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> (Array[Level], Array[TextRange]) {
  info.visual_runs(para, line)
}

///| Top-level wrapper for `BidiInfo::reorder_line`.
pub fn reorder_line(info : BidiInfo, para : ParagraphInfo, line : TextRange) -> String {
  info.reorder_line(para, line)
}

///| Top-level wrapper for `BidiInfo::reorder_line_with_mirroring`.
pub fn reorder_line_with_mirroring(
  info : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> String {
  info.reorder_line_with_mirroring(para, line)
}

///| Convenience helper: compute per-codepoint UAX #9 levels across all paragraphs.
///| Each paragraph runs Rule L1 with its own `para.level` in O(para) time.
///| `base_dir`: `0` = LTR, `1` = RTL, `< 0` = auto-detect (P2–P3).
pub fn bidi_line_levels(text : String, base_dir : Int) -> Array[Int] {
  let n = text.length()
  if n == 0 {
    return []
  }
  let default_lv : Option[Level] = if base_dir == 1 {
    Some(Level::rtl())
  } else if base_dir == 0 {
    Some(Level::ltr())
  } else {
    None
  }
  let info = BidiInfo::new(text, default_lv)
  if info.paragraphs.length() == 0 {
    return []
  }
  let out : Array[Int] = Array::new()
  let mut pi = 0
  while pi < info.paragraphs.length() {
    let para = info.paragraphs[pi]
    let ps = para.range.start
    let pe = para.range.end
    let local_l1 = reorder_levels_l1_local(
      info.text,
      info.original_classes,
      info.levels,
      ps,
      pe,
      para.level,
    )
    let mut pos = ps
    while pos < pe {
      out.push(local_l1[pos - ps].to_int())
      let len = utf8_char_len_at(info.text, pos)
      pos = pos + (if len > 0 { len } else { 1 })
    }
    pi = pi + 1
  }
  out
}

///| Convenience helper: L2 visual index mapping (`visual_idx -> logical_idx`).
pub fn bidi_visual_order(levels : Array[Int]) -> Array[Int] {
  reorder_visual_ints(levels)
}
