///| Top-level UAX #9 Bidirectional Algorithm entrypoints (P1–P3, BidiInfo, Farview compat).

///| Unicode version of the embedded UAX #9 tables (`16.0.0`).
pub fn unicode_version() -> (Int, Int, Int) {
  (16, 0, 0)
}

fn get_base_direction_impl(text : String, use_full_text : Bool) -> Direction {
  let n = text.length()
  let mut isolate_level = 0
  let mut pos = 0
  while pos < n {
    let dec = utf8_decode_packed(text, pos)
    let cp = dec >> 3
    let len = dec & 7
    let step = if len > 0 { len } else { 1 }
    let tag = bidi_class_tag(cp)
    if tag == tag_lri || tag == tag_rli || tag == tag_fsi {
      isolate_level = isolate_level + 1
    } else if tag == tag_pdi {
      if isolate_level > 0 {
        isolate_level = isolate_level - 1
      }
    } else if tag == tag_l {
      if isolate_level == 0 {
        return Direction::Ltr
      }
    } else if tag == tag_r || tag == tag_al {
      if isolate_level == 0 {
        return Direction::Rtl
      }
    } else if tag == tag_b {
      if !use_full_text {
        break
      } else {
        isolate_level = 0
      }
    }
    pos = pos + step
  }
  Direction::Mixed
}

///| Determine base direction of the first paragraph per UAX #9 P2–P3 (`Mixed` if all-neutral).
pub fn get_base_direction(text : String) -> Direction {
  get_base_direction_impl(text, false)
}

///| Determine base direction across paragraphs per UAX #9 P2–P3 (`Mixed` if all-neutral).
pub fn get_base_direction_full(text : String) -> Direction {
  get_base_direction_impl(text, true)
}

///| Compute UAX #9 `BidiInfo` with explicit resource limits.
pub fn BidiInfo::new_with_limits(
  text : String,
  default_level : Option[Level],
  limits : Limits,
) -> Result[BidiInfo, BidiError] {
  let n = text.length()
  if n > limits.max_input_bytes {
    return Err(BidiError::InputTooLong(n, limits.max_input_bytes))
  }
  let max_depth = if limits.max_depth > 125 {
    125
  } else if limits.max_depth < 0 {
    0
  } else {
    limits.max_depth
  }
  let max_bracket_depth = if limits.max_bracket_depth < 0 {
    0
  } else {
    limits.max_bracket_depth
  }

  let default_lv = match default_level {
    Some(l) => {
      let lv = l.number()
      if lv > 125 {
        return Err(BidiError::OutOfRangeLevel(lv))
      }
      lv
    }
    None => -1
  }

  // Pass 1: P1–P3 initial scan + FSI resolution (X5c) + pure-LTR detection.
  let orig_tags = Bytes::new(n)
  let paragraphs : Array[ParagraphInfo] = Array::new()
  let para_pure_ltr : Array[Bool] = Array::new()
  let para_has_iso : Array[Bool] = Array::new()

  let isolate_stack : Array[Int] = Array::new()
  let mut para_start = 0
  let mut para_level = default_lv
  let mut is_pure_ltr = true
  let mut has_iso = false

  let mut pos = 0
  while pos < n {
    let b0 = text.code_unit_at(pos)
    let mut cp = b0
    let mut step = 1
    if b0 >= 0x80 {
      let dec = utf8_decode_packed(text, pos)
      cp = dec >> 3
      let d_len = dec & 7
      step = if d_len > 0 { d_len } else { 1 }
    }
    let tag = bidi_class_tag(cp)
    let tag_b_val = tag.to_byte()

    orig_tags[pos] = tag_b_val
    if step > 1 {
      let mut k = 1
      while k < step && pos + k < n {
        orig_tags[pos + k] = tag_b_val
        k = k + 1
      }
    }

    if tag == tag_b {
      let para_end = pos + step
      let resolved_lv = if para_level >= 0 { para_level } else { 0 }
      paragraphs.push(
        ParagraphInfo::{
          range: TextRange::{ start: para_start, end: para_end },
          level: Level::{ value: resolved_lv.to_byte() },
        },
      )
      para_pure_ltr.push(is_pure_ltr)
      para_has_iso.push(has_iso)
      para_start = para_end
      para_level = default_lv
      is_pure_ltr = true
      has_iso = false
      isolate_stack.clear()
    } else if tag == tag_l || tag == tag_r || tag == tag_al {
      if tag != tag_l {
        is_pure_ltr = false
      }
      if isolate_stack.length() > 0 {
        let iso_start = isolate_stack[isolate_stack.length() - 1]
        if orig_tags[iso_start].to_int() == tag_fsi {
          // X5c: FSI (U+2068, 3 UTF-8 bytes) becomes LRI or RLI.
          let repl = (if tag == tag_l { tag_lri } else { tag_rli }).to_byte()
          orig_tags[iso_start] = repl
          if iso_start + 1 < n {
            orig_tags[iso_start + 1] = repl
          }
          if iso_start + 2 < n {
            orig_tags[iso_start + 2] = repl
          }
        }
      } else if para_level < 0 {
        // P2: First strong character outside isolates determines paragraph level.
        para_level = if tag != tag_l { 1 } else { 0 }
      }
    } else if tag == tag_an || tag == tag_lre || tag == tag_rle || tag == tag_lro ||
    tag == tag_rlo {
      is_pure_ltr = false
    } else if tag == tag_rli || tag == tag_lri || tag == tag_fsi {
      is_pure_ltr = false
      has_iso = true
      isolate_stack.push(pos)
    } else if tag == tag_pdi {
      let _ = isolate_stack.pop()
    }

    pos = pos + step
  }

  if para_start < n {
    let resolved_lv = if para_level >= 0 { para_level } else { 0 }
    paragraphs.push(
      ParagraphInfo::{
        range: TextRange::{ start: para_start, end: n },
        level: Level::{ value: resolved_lv.to_byte() },
      },
    )
    para_pure_ltr.push(is_pure_ltr)
    para_has_iso.push(has_iso)
  }

  // Pass 2: Per-paragraph UAX #9 resolution using compact 1-byte Bytes buffers.
  let mut level_bytes = Bytes::new(0)
  let mut proc_tags = Bytes::new(0)
  let mut proc_initialized = false
  let mut scratch = bidi_scratch_new()

  let mut pi = 0
  while pi < paragraphs.length() {
    let para = paragraphs[pi]
    let p_start = para.range.start
    let p_end = para.range.end
    let p_lv = para.level.number()

    if p_lv == 0 && para_pure_ltr[pi] {
      // Pure LTR fast path: level is 0 everywhere.
      pi = pi + 1
      continue
    }

    // Lazily allocate level_bytes and proc_tags only when at least one paragraph needs full UAX #9.
    if !proc_initialized {
      level_bytes = Bytes::new(n)
      proc_tags = Bytes::new(n)
      proc_initialized = true
    }

    let p_lv_b = p_lv.to_byte()
    if p_lv != 0 {
      let mut i = p_start
      while i < p_end {
        level_bytes[i] = p_lv_b
        i = i + 1
      }
    }

    // Copy only this paragraph's slice into proc_tags.
    let mut ci = p_start
    while ci < p_end {
      proc_tags[ci] = orig_tags[ci]
      ci = ci + 1
    }

    scratch.run_starts.clear()
    scratch.run_ends.clear()
    explicit_compute(
      text,
      p_start,
      p_end,
      p_lv,
      max_depth,
      orig_tags,
      level_bytes,
      proc_tags,
      scratch.run_starts,
      scratch.run_ends,
      scratch.stack_level,
      scratch.stack_status,
    )

    if !para_has_iso[pi] {
      // Zero-allocation fast path: each level run is its own isolating run sequence.
      let n_runs = scratch.run_starts.length()
      let mut r = 0
      while r < n_runs {
        let rs = scratch.run_starts[r]
        let re = scratch.run_ends[r]
        let (sos, eos) = compute_single_run_sos_eos(
          p_start,
          p_end - p_start,
          p_lv,
          orig_tags,
          level_bytes,
          rs,
          re,
        )
        scratch.single_s[0] = rs
        scratch.single_e[0] = re
        let seq = IsoRunSeq::{
          run_starts: scratch.single_s,
          run_ends: scratch.single_e,
          sos: sos,
          eos: eos,
        }
        resolve_weak(text, p_start, seq, proc_tags, scratch)
        resolve_neutral(
          text,
          p_start,
          seq,
          level_bytes,
          orig_tags,
          proc_tags,
          max_bracket_depth,
          scratch,
        )
        r = r + 1
      }
    } else {
      let sequences = build_isolating_run_sequences(
        p_start,
        p_end - p_start,
        p_lv,
        orig_tags,
        level_bytes,
        scratch.run_starts,
        scratch.run_ends,
      )
      let mut si = 0
      while si < sequences.length() {
        let seq = sequences[si]
        resolve_weak(text, p_start, seq, proc_tags, scratch)
        resolve_neutral(
          text,
          p_start,
          seq,
          level_bytes,
          orig_tags,
          proc_tags,
          max_bracket_depth,
          scratch,
        )
        si = si + 1
      }
    }

    resolve_implicit_levels(p_start, p_end, proc_tags, level_bytes)
    assign_levels_to_removed_chars(p_start, p_end, p_lv, orig_tags, level_bytes)

    pi = pi + 1
  }

  // Materialize public typed arrays with exact capacity (no growth reallocations).
  let original_classes : Array[BidiClass] = Array::with_capacity(n)
  let levels : Array[Level] = if !proc_initialized {
    let mut idx = 0
    while idx < n {
      original_classes.push(bidi_class_lut[orig_tags[idx].to_int()])
      idx = idx + 1
    }
    Array::make(n, level_lut[0])
  } else {
    let lv : Array[Level] = Array::with_capacity(n)
    let mut idx = 0
    while idx < n {
      original_classes.push(bidi_class_lut[orig_tags[idx].to_int()])
      lv.push(level_lut[level_bytes[idx].to_int()])
      idx = idx + 1
    }
    lv
  }

  Ok(
    BidiInfo::{
      text: text,
      original_classes: original_classes,
      levels: levels,
      paragraphs: paragraphs,
    },
  )
}

///| Compute UAX #9 `BidiInfo` with default limits.
///| Total API: clamps `default_level > 125` to `124` (even explicit max) and falls back to
///| uniform LTR/default levels if input exceeds the 16 MiB default limit.
pub fn BidiInfo::new(text : String, default_level : Option[Level]) -> BidiInfo {
  let clamped_default : Option[Level] = match default_level {
    Some(l) =>
    if l.number() > 125 {
      Some(Level::{ value: (124).to_byte() })
    } else {
      Some(l)
    }
    None => None
  }
  match BidiInfo::new_with_limits(text, clamped_default, Limits::default()) {
    Ok(info) => info
    Err(_) => {
      let n = text.length()
      let fallback_lv = match clamped_default {
        Some(l) => l
        None => Level::ltr()
      }
      let paragraphs : Array[ParagraphInfo] = if n > 0 {
        [
          ParagraphInfo::{
            range: TextRange::{ start: 0, end: n },
            level: fallback_lv,
          },
        ]
      } else {
        []
      }
      BidiInfo::{
        text: text,
        original_classes: Array::make(n, BidiClass::L),
        levels: Array::make(n, fallback_lv),
        paragraphs: paragraphs,
      }
    }
  }
}

///| True if any byte in `self.levels` has an odd (RTL) embedding level.
pub fn BidiInfo::has_rtl(self : BidiInfo) -> Bool {
  let mut i = 0
  let n = self.levels.length()
  while i < n {
    if self.levels[i].is_rtl() {
      return true
    }
    i = i + 1
  }
  false
}

///| Directionality of a resolved paragraph (`Ltr`, `Rtl`, or `Mixed`).
pub fn BidiInfo::paragraph_direction(self : BidiInfo, para : ParagraphInfo) -> Direction {
  let mut has_ltr = false
  let mut has_rtl = false
  let mut i = para.range.start
  let end = para.range.end
  while i < end && i < self.levels.length() {
    if self.levels[i].is_rtl() {
      has_rtl = true
      if has_ltr {
        return Direction::Mixed
      }
    } else {
      has_ltr = true
      if has_rtl {
        return Direction::Mixed
      }
    }
    i = i + 1
  }
  if has_ltr {
    Direction::Ltr
  } else {
    Direction::Rtl
  }
}

///| Apply UAX #9 Rule L1 to produce per-byte reordered levels for `line`.
pub fn BidiInfo::reordered_levels(
  self : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> Array[Level] {
  let n = self.levels.length()
  let out = self.levels.copy()
  let start = if line.start < 0 { 0 } else if line.start > n { n } else { line.start }
  let end = if line.end < start { start } else if line.end > n { n } else { line.end }
  reorder_levels_l1(self.text, self.original_classes, out, start, end, para.level)
  out
}

///| Apply UAX #9 Rule L1 and sample one `Level` per Unicode scalar value in `self.text`.
pub fn BidiInfo::reordered_levels_per_char(
  self : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> Array[Level] {
  let n = self.levels.length()
  let start = if line.start < 0 { 0 } else if line.start > n { n } else { line.start }
  let end = if line.end < start { start } else if line.end > n { n } else { line.end }
  let local_l1 = reorder_levels_l1_local(
    self.text,
    self.original_classes,
    self.levels,
    start,
    end,
    para.level,
  )
  let out : Array[Level] = Array::new()
  let mut pos = 0
  while pos < n {
    if pos >= start && pos < end {
      out.push(level_lut[local_l1[pos - start].to_int()])
    } else {
      out.push(self.levels[pos])
    }
    let len = utf8_char_len_at(self.text, pos)
    pos = pos + (if len > 0 { len } else { 1 })
  }
  out
}

///| Compute L1 levels and L2 visual runs for `line`.
pub fn BidiInfo::visual_runs(
  self : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> (Array[Level], Array[TextRange]) {
  let levels = self.reordered_levels(para, line)
  let runs = visual_runs_for_line(levels, line.start, line.end)
  (levels, runs)
}

///| Reorder `line` into visual display order (L1 + L2, without L4 mirroring).
///| Runs in O(line) time and memory without copying the full document's levels.
pub fn BidiInfo::reorder_line(
  self : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> String {
  let n = self.levels.length()
  let start = if line.start < 0 { 0 } else if line.start > n { n } else { line.start }
  let end = if line.end < start { start } else if line.end > n { n } else { line.end }
  if start >= end {
    return ""
  }
  let mut any_rtl = false
  let mut i = start
  while i < end {
    if self.levels[i].is_rtl() {
      any_rtl = true
      break
    }
    i = i + 1
  }
  if !any_rtl {
    let sb = StringBuilder::with_capacity(end - start)
    write_text_slice(sb, self.text, start, end)
    return sb.to_string()
  }
  let local_l1 = reorder_levels_l1_local(
    self.text,
    self.original_classes,
    self.levels,
    start,
    end,
    para.level,
  )
  let runs = visual_runs_for_local_line(local_l1, start, end)
  reorder_line_from_local(self.text, start, end, local_l1, runs, false)
}

///| Reorder `line` into visual display order with UAX #9 Rule L4 mirroring for RTL runs.
///| Runs in O(line) time and memory without copying the full document's levels.
pub fn BidiInfo::reorder_line_with_mirroring(
  self : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> String {
  let n = self.levels.length()
  let start = if line.start < 0 { 0 } else if line.start > n { n } else { line.start }
  let end = if line.end < start { start } else if line.end > n { n } else { line.end }
  if start >= end {
    return ""
  }
  let mut any_rtl = false
  let mut i = start
  while i < end {
    if self.levels[i].is_rtl() {
      any_rtl = true
      break
    }
    i = i + 1
  }
  if !any_rtl {
    let sb = StringBuilder::with_capacity(end - start)
    write_text_slice(sb, self.text, start, end)
    return sb.to_string()
  }
  let local_l1 = reorder_levels_l1_local(
    self.text,
    self.original_classes,
    self.levels,
    start,
    end,
    para.level,
  )
  let runs = visual_runs_for_local_line(local_l1, start, end)
  reorder_line_from_local(self.text, start, end, local_l1, runs, true)
}

///| Reorder pre-calculated per-character levels via UAX #9 Rule L2 (`visual_idx -> logical_idx`).
pub fn BidiInfo::reorder_visual(levels : Array[Level]) -> Array[Int] {
  let ints : Array[Int] = Array::with_capacity(levels.length())
  let mut i = 0
  while i < levels.length() {
    ints.push(levels[i].number())
    i = i + 1
  }
  reorder_visual_ints(ints)
}

///| Top-level wrapper for `BidiInfo::visual_runs`.
pub fn visual_runs(
  info : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> (Array[Level], Array[TextRange]) {
  info.visual_runs(para, line)
}

///| Top-level wrapper for `BidiInfo::reorder_line`.
pub fn reorder_line(info : BidiInfo, para : ParagraphInfo, line : TextRange) -> String {
  info.reorder_line(para, line)
}

///| Top-level wrapper for `BidiInfo::reorder_line_with_mirroring`.
pub fn reorder_line_with_mirroring(
  info : BidiInfo,
  para : ParagraphInfo,
  line : TextRange,
) -> String {
  info.reorder_line_with_mirroring(para, line)
}

///| Farview compatibility helper: compute per-codepoint UAX #9 levels across all paragraphs.
///| Each paragraph runs Rule L1 with its own `para.level` in O(para) time.
///| `base_dir`: `0` = LTR, `1` = RTL, `< 0` = auto-detect (P2–P3).
pub fn bidi_line_levels(text : String, base_dir : Int) -> Array[Int] {
  let n = text.length()
  if n == 0 {
    return []
  }
  let default_lv : Option[Level] = if base_dir == 1 {
    Some(Level::rtl())
  } else if base_dir == 0 {
    Some(Level::ltr())
  } else {
    None
  }
  let info = BidiInfo::new(text, default_lv)
  if info.paragraphs.length() == 0 {
    return []
  }
  let out : Array[Int] = Array::new()
  let mut pi = 0
  while pi < info.paragraphs.length() {
    let para = info.paragraphs[pi]
    let ps = para.range.start
    let pe = para.range.end
    let local_l1 = reorder_levels_l1_local(
      info.text,
      info.original_classes,
      info.levels,
      ps,
      pe,
      para.level,
    )
    let mut pos = ps
    while pos < pe {
      out.push(local_l1[pos - ps].to_int())
      let len = utf8_char_len_at(info.text, pos)
      pos = pos + (if len > 0 { len } else { 1 })
    }
    pi = pi + 1
  }
  out
}

///| Farview compatibility helper: L2 visual index mapping (`visual_idx -> logical_idx`).
pub fn bidi_visual_order(levels : Array[Int]) -> Array[Int] {
  reorder_visual_ints(levels)
}
