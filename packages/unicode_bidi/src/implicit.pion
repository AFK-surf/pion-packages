///| UAX #9 §3.3.4–§3.3.6 Weak Types (W1–W7), Neutral Types (N0–N2), and Implicit Levels (I1–I2).

///| Reusable scratch buffers across paragraphs and isolating run sequences to avoid allocation churn.
struct BidiScratch {
  exp_stack : FixedArray[Byte]
  run_starts : Array[Int]
  run_ends : Array[Int]
  seq_s : Array[Int]
  seq_e : Array[Int]
  et_run_indices : Array[Int]
  bn_run_indices : Array[Int]
  bstack : FixedArray[Int]
  bstack_cap : Int
  bp_start : Array[Int]
  bp_end : Array[Int]
  bp_srun : Array[Int]
  bp_erun : Array[Int]
}

fn bidi_scratch_new(n : Int, max_bracket_depth : Int) -> BidiScratch {
  let raw_cap = if n < max_bracket_depth { n } else { max_bracket_depth }
  let bcap = if raw_cap < 4 { 4 } else { raw_cap }
  BidiScratch::{
    exp_stack: FixedArray::make(256, (0).to_byte()),
    run_starts: Array::with_capacity(16),
    run_ends: Array::with_capacity(16),
    seq_s: Array::with_capacity(8),
    seq_e: Array::with_capacity(8),
    et_run_indices: Array::new(),
    bn_run_indices: Array::new(),
    bstack: FixedArray::make(bcap * 3, 0),
    bstack_cap: bcap,
    bp_start: Array::new(),
    bp_end: Array::new(),
    bp_srun: Array::new(),
    bp_erun: Array::new(),
  }
}

///| Fast zero-allocation W1–W7 for a single contiguous run `[abs_start, abs_end)` with NO X9/BN chars.
///| Returns `true` if any `tag_on` exists in the run after W1–W7.
fn resolve_weak_single_nox9(
  text : String,
  abs_start : Int,
  abs_end : Int,
  sos : Int,
  eos : Int,
  proc_tags : FixedArray[Byte],
) -> Bool {
  let mut prev_class_before_w4 = sos
  let mut prev_class_before_w5 = sos
  let mut prev_class_before_w1 = sos
  let mut last_strong_is_al = false

  let mut et_start = -1
  let mut has_en = false
  let mut has_on = false

  let en_b = tag_en.to_byte()
  let an_b = tag_an.to_byte()
  let r_b = tag_r.to_byte()
  let on_b = tag_on.to_byte()
  let text_len = text.length()

  let mut abs_i = abs_start
  while abs_i < abs_end {
    let mut cur = proc_tags[abs_i].to_int()

    // W1: NSM takes type of previous character (or ON after isolate initiator/PDI).
    if cur == tag_nsm {
      let repl = if is_isolate_initiator_tag(prev_class_before_w1) ||
      prev_class_before_w1 == tag_pdi {
        tag_on
      } else {
        prev_class_before_w1
      }
      proc_tags[abs_i] = repl.to_byte()
      cur = repl
    }

    let w2_class = cur
    prev_class_before_w1 = cur

    // W2 & W3
    if cur == tag_en {
      if last_strong_is_al {
        proc_tags[abs_i] = an_b
        cur = tag_an
      }
    } else if cur == tag_al {
      proc_tags[abs_i] = r_b
      cur = tag_r
    }

    if w2_class == tag_l || w2_class == tag_r {
      last_strong_is_al = false
    } else if w2_class == tag_al {
      last_strong_is_al = true
    }

    let class_before_w456 = cur

    // W4, W5, W6 (separators)
    if cur == tag_en {
      has_en = true
      if et_start >= 0 {
        let mut k = et_start
        while k < abs_i {
          proc_tags[k] = en_b
          k = k + 1
        }
        et_start = -1
      }
    } else if cur == tag_es || cur == tag_cs {
      let b0 = text.code_unit_at(abs_i)
      let char_len = if b0 < 0x80 {
        1
      } else if (b0 & 0xC0) == 0x80 {
        0
      } else if (b0 & 0xE0) == 0xC0 && abs_i + 1 < text_len {
        2
      } else if (b0 & 0xF0) == 0xE0 && abs_i + 2 < text_len {
        3
      } else if (b0 & 0xF8) == 0xF0 && abs_i + 3 < text_len {
        4
      } else {
        1
      }
      if char_len > 0 {
        let next_pos = abs_i + char_len
        let mut next_class = if next_pos < abs_end {
          proc_tags[next_pos].to_int()
        } else {
          eos
        }
        if next_class == tag_en && last_strong_is_al {
          next_class = tag_an
        }
        let resolved = if prev_class_before_w4 == tag_en && next_class == tag_en {
          has_en = true
          tag_en
        } else if prev_class_before_w4 == tag_an && class_before_w456 == tag_cs &&
        next_class == tag_an {
          tag_an
        } else {
          has_on = true
          tag_on
        }
        proc_tags[abs_i] = resolved.to_byte()
        cur = resolved
      } else {
        let prev_b = proc_tags[abs_i - 1]
        proc_tags[abs_i] = prev_b
        cur = prev_b.to_int()
        if cur == tag_on {
          has_on = true
        } else if cur == tag_en {
          has_en = true
        }
      }
    } else if cur == tag_et {
      if prev_class_before_w5 == tag_en {
        proc_tags[abs_i] = en_b
        cur = tag_en
        has_en = true
      } else if et_start < 0 {
        et_start = abs_i
      }
    } else if cur == tag_on {
      has_on = true
    }

    prev_class_before_w5 = cur

    if et_start >= 0 && cur != tag_et {
      let mut k = et_start
      while k < abs_i {
        proc_tags[k] = on_b
        k = k + 1
      }
      et_start = -1
      has_on = true
    }

    prev_class_before_w4 = class_before_w456
    abs_i = abs_i + 1
  }

  // Remaining ETs at end of sequence become ON (W6).
  if et_start >= 0 {
    let mut k = et_start
    while k < abs_end {
      proc_tags[k] = on_b
      k = k + 1
    }
    has_on = true
  }

  // W7: If previous strong char was L, change EN to L.
  if has_en {
    let mut last_strong_is_l = sos == tag_l
    let l_b = tag_l.to_byte()
    let mut i = abs_start
    while i < abs_end {
      let t = proc_tags[i].to_int()
      if t == tag_en {
        if last_strong_is_l {
          proc_tags[i] = l_b
        }
      } else if t == tag_l {
        last_strong_is_l = true
      } else if t == tag_r || t == tag_al {
        last_strong_is_l = false
      }
      i = i + 1
    }
  }

  has_on
}

///| Resolve paired brackets for a flat no-X9 run starting from the first opening bracket at `first_open`.
fn resolve_brackets_flat_nox9(
  text : String,
  abs_start : Int,
  abs_end : Int,
  first_open : Int,
  first_skel : Int,
  first_step : Int,
  e : Int,
  not_e : Int,
  sos : Int,
  original_classes : Array[BidiClass],
  proc_tags : FixedArray[Byte],
  max_bracket_depth : Int,
) -> Unit {
  if max_bracket_depth <= 0 {
    return
  }
  let rem = abs_end - first_open
  let cap = if rem < max_bracket_depth { rem } else { max_bracket_depth }
  let stack_skel : FixedArray[Int] = FixedArray::make(cap, 0)
  let stack_pos : FixedArray[Int] = FixedArray::make(cap, 0)
  let bp_start : Array[Int] = Array::with_capacity(4)
  let bp_end : Array[Int] = Array::with_capacity(4)

  stack_skel[0] = first_skel
  stack_pos[0] = first_open
  let mut sp = 1
  let mut n_bp = 0
  let mut overflowed = false

  let mut abs_i = first_open + first_step
  while abs_i < abs_end {
    if proc_tags[abs_i].to_int() != tag_on {
      abs_i = abs_i + 1
      continue
    }
    let b0 = text.code_unit_at(abs_i)
    let mut cp = b0
    let mut step = 1
    if b0 >= 0x80 {
      let dec = utf8_decode_packed(text, abs_i)
      cp = dec >> 3
      let d_len = dec & 7
      step = if d_len > 0 { d_len } else { 1 }
    }
    let packed = bidi_bracket_packed(cp)
    if packed >= 0 {
      let skel = packed >> 1
      if (packed & 1) == 1 {
        if sp >= max_bracket_depth {
          overflowed = true
          n_bp = 0
          break
        }
        stack_skel[sp] = skel
        stack_pos[sp] = abs_i
        sp = sp + 1
      } else if sp > 0 {
        let mut si = sp - 1
        while si >= 0 {
          if stack_skel[si] == skel {
            bp_start.push(stack_pos[si])
            bp_end.push(abs_i)
            n_bp = n_bp + 1
            sp = si
            break
          }
          si = si - 1
        }
      }
    }
    abs_i = abs_i + step
  }

  if overflowed || n_bp == 0 {
    return
  }

  if n_bp > 1 {
    let mut i = 1
    while i < n_bp {
      let ks = bp_start[i]
      let ke = bp_end[i]
      let mut j = i - 1
      while j >= 0 && bp_start[j] > ks {
        bp_start[j + 1] = bp_start[j]
        bp_end[j + 1] = bp_end[j]
        j = j - 1
      }
      bp_start[j + 1] = ks
      bp_end[j + 1] = ke
      i = i + 1
    }
  }

  let mut p = 0
  while p < n_bp {
    let p_start = bp_start[p]
    let p_end = bp_end[p]
    let start_char_len = utf8_char_len_at(text, p_start)
    let start_step = if start_char_len > 0 { start_char_len } else { 1 }

    let mut found_e = false
    let mut found_not_e = false
    let mut pos = p_start + start_step
    while pos < p_end {
      let cls = proc_tags[pos].to_int()
      if cls == e {
        found_e = true
        break
      } else if cls == not_e {
        found_not_e = true
      } else if cls == tag_en || cls == tag_an {
        if e == tag_l {
          found_not_e = true
        } else {
          found_e = true
          break
        }
      }
      pos = pos + 1
    }

    let mut class_to_set = -1
    if found_e {
      class_to_set = e
    } else if found_not_e {
      let mut prev_strong = sos
      let mut bpos = p_start - 1
      while bpos >= abs_start {
        let cls = proc_tags[bpos].to_int()
        if cls == tag_l || cls == tag_r || cls == tag_en || cls == tag_an {
          prev_strong = if cls == tag_en || cls == tag_an { tag_r } else { cls }
          break
        }
        bpos = bpos - 1
      }
      class_to_set = prev_strong
    }

    if class_to_set >= 0 {
      let cts_b = class_to_set.to_byte()
      let end_char_len = utf8_char_len_at(text, p_end)
      let end_step = if end_char_len > 0 { end_char_len } else { 1 }

      let mut k = 0
      while k < start_step {
        proc_tags[p_start + k] = cts_b
        k = k + 1
      }
      let mut k2 = 0
      while k2 < end_step {
        proc_tags[p_end + k2] = cts_b
        k2 = k + 1
      }

      let mut npos = p_start + start_step
      while npos < abs_end {
        match original_classes[npos] {
          BidiClass::NSM => {
            proc_tags[npos] = cts_b
            npos = npos + 1
          }
          _ => break
        }
      }
      let mut epos = p_end + end_step
      while epos < abs_end {
        match original_classes[epos] {
          BidiClass::NSM => {
            proc_tags[epos] = cts_b
            epos = epos + 1
          }
          _ => break
        }
      }
    }
    p = p + 1
  }
}

///| Fast N0–N2 for a single contiguous run `[abs_start, abs_end)` with NO X9/BN chars.
fn resolve_neutral_flat_nox9(
  text : String,
  abs_start : Int,
  abs_end : Int,
  run_level : Int,
  sos : Int,
  eos : Int,
  original_classes : Array[BidiClass],
  proc_tags : FixedArray[Byte],
  max_bracket_depth : Int,
  has_on : Bool,
) -> Unit {
  let e = level_to_bidi_tag(run_level)
  let not_e = if e == tag_l { tag_r } else { tag_l }

  // N0: Scan for first opening bracket with zero heap allocations; only allocate if found!
  if has_on {
    let mut abs_i = abs_start
    while abs_i < abs_end {
      if proc_tags[abs_i].to_int() != tag_on {
        abs_i = abs_i + 1
        continue
      }
      let b0 = text.code_unit_at(abs_i)
      let mut cp = b0
      let mut step = 1
      if b0 >= 0x80 {
        let dec = utf8_decode_packed(text, abs_i)
        cp = dec >> 3
        let d_len = dec & 7
        step = if d_len > 0 { d_len } else { 1 }
      }
      let packed = bidi_bracket_packed(cp)
      if packed >= 0 && (packed & 1) == 1 {
        resolve_brackets_flat_nox9(
          text,
          abs_start,
          abs_end,
          abs_i,
          packed >> 1,
          step,
          e,
          not_e,
          sos,
          original_classes,
          proc_tags,
          max_bracket_depth,
        )
        break
      }
      abs_i = abs_i + step
    }
  }

  // N1 and N2: Zero-allocation single-run pass (no BN present).
  let mut prev_class = sos
  let mut abs_i = abs_start
  while abs_i < abs_end {
    let cur_cls = proc_tags[abs_i].to_int()
    if is_ni_tag(cur_cls) {
      let ni_start = abs_i
      abs_i = abs_i + 1
      let mut next_class = eos
      while abs_i < abs_end {
        let jc = proc_tags[abs_i].to_int()
        if !is_ni_tag(jc) {
          next_class = jc
          break
        }
        abs_i = abs_i + 1
      }
      let new_class = if prev_class == tag_l && next_class == tag_l {
        tag_l
      } else if (prev_class == tag_r || prev_class == tag_an || prev_class == tag_en) &&
      (next_class == tag_r || next_class == tag_an || next_class == tag_en) {
        tag_r
      } else {
        e
      }
      let nc_b = new_class.to_byte()
      let mut k = ni_start
      while k < abs_i {
        proc_tags[k] = nc_b
        k = k + 1
      }
      if abs_i < abs_end {
        prev_class = next_class
        abs_i = abs_i + 1
      }
    } else {
      prev_class = cur_cls
      abs_i = abs_i + 1
    }
  }
}

///| Fast N0–N2 for a single contiguous run `[abs_start, abs_end)` with NO X9/BN chars, using `orig_tags` + `scratch`.
fn resolve_neutral_single_nox9(
  text : String,
  abs_start : Int,
  abs_end : Int,
  run_level : Int,
  sos : Int,
  eos : Int,
  orig_tags : FixedArray[Byte],
  proc_tags : FixedArray[Byte],
  max_bracket_depth : Int,
  has_on : Bool,
  scratch : BidiScratch,
) -> Unit {
  let e = level_to_bidi_tag(run_level)
  let not_e = if e == tag_l { tag_r } else { tag_l }

  if has_on {
    let bp_start = scratch.bp_start
    let bp_end = scratch.bp_end
    let bstack = scratch.bstack
    let bcap = scratch.bstack_cap
    if bp_start.length() > 0 {
      bp_start.clear()
      bp_end.clear()
    }
    let mut sp = 0

    let mut overflowed = false
    let mut abs_i = abs_start
    while abs_i < abs_end {
      if proc_tags[abs_i].to_int() != tag_on {
        abs_i = abs_i + 1
        continue
      }
      let b0 = text.code_unit_at(abs_i)
      let mut cp = b0
      let mut step = 1
      if b0 >= 0x80 {
        let dec = utf8_decode_packed(text, abs_i)
        cp = dec >> 3
        let d_len = dec & 7
        step = if d_len > 0 { d_len } else { 1 }
      }
      let packed = bidi_bracket_packed(cp)
      if packed >= 0 {
        let skel = packed >> 1
        if (packed & 1) == 1 {
          if sp >= max_bracket_depth {
            overflowed = true
            bp_start.clear()
            bp_end.clear()
            break
          }
          bstack[sp] = skel
          bstack[bcap + sp] = abs_i
          sp = sp + 1
        } else if sp > 0 {
          let mut si = sp - 1
          while si >= 0 {
            if bstack[si] == skel {
              bp_start.push(bstack[bcap + si])
              bp_end.push(abs_i)
              sp = si
              break
            }
            si = si - 1
          }
        }
      }
      abs_i = abs_i + step
    }

    let n_bp = bp_start.length()
    if !overflowed && n_bp > 1 {
      let mut i = 1
      while i < n_bp {
        let ks = bp_start[i]
        let ke = bp_end[i]
        let mut j = i - 1
        while j >= 0 && bp_start[j] > ks {
          bp_start[j + 1] = bp_start[j]
          bp_end[j + 1] = bp_end[j]
          j = j - 1
        }
        bp_start[j + 1] = ks
        bp_end[j + 1] = ke
        i = i + 1
      }
    }

    let mut p = 0
    while p < n_bp {
      let p_start = bp_start[p]
      let p_end = bp_end[p]
      let start_char_len = utf8_char_len_at(text, p_start)
      let start_step = if start_char_len > 0 { start_char_len } else { 1 }

      let mut found_e = false
      let mut found_not_e = false
      let mut pos = p_start + start_step
      while pos < p_end {
        let cls = proc_tags[pos].to_int()
        if cls == e {
          found_e = true
          break
        } else if cls == not_e {
          found_not_e = true
        } else if cls == tag_en || cls == tag_an {
          if e == tag_l {
            found_not_e = true
          } else {
            found_e = true
            break
          }
        }
        pos = pos + 1
      }

      let mut class_to_set = -1
      if found_e {
        class_to_set = e
      } else if found_not_e {
        let mut prev_strong = sos
        let mut bpos = p_start - 1
        while bpos >= abs_start {
          let cls = proc_tags[bpos].to_int()
          if cls == tag_l || cls == tag_r || cls == tag_en || cls == tag_an {
            prev_strong = if cls == tag_en || cls == tag_an { tag_r } else { cls }
            break
          }
          bpos = bpos - 1
        }
        class_to_set = prev_strong
      }

      if class_to_set >= 0 {
        let cts_b = class_to_set.to_byte()
        let end_char_len = utf8_char_len_at(text, p_end)
        let end_step = if end_char_len > 0 { end_char_len } else { 1 }

        let mut k = 0
        while k < start_step {
          proc_tags[p_start + k] = cts_b
          k = k + 1
        }
        let mut k2 = 0
        while k2 < end_step {
          proc_tags[p_end + k2] = cts_b
          k2 = k + 1
        }

        let mut npos = p_start + start_step
        while npos < abs_end && orig_tags[npos].to_int() == tag_nsm {
          proc_tags[npos] = cts_b
          npos = npos + 1
        }
        let mut epos = p_end + end_step
        while epos < abs_end && orig_tags[epos].to_int() == tag_nsm {
          proc_tags[epos] = cts_b
          epos = epos + 1
        }
      }
      p = p + 1
    }
  }

  let mut prev_class = sos
  let mut abs_i = abs_start
  while abs_i < abs_end {
    let cur_cls = proc_tags[abs_i].to_int()
    if is_ni_tag(cur_cls) {
      let ni_start = abs_i
      abs_i = abs_i + 1
      let mut next_class = eos
      while abs_i < abs_end {
        let jc = proc_tags[abs_i].to_int()
        if !is_ni_tag(jc) {
          next_class = jc
          break
        }
        abs_i = abs_i + 1
      }
      let new_class = if prev_class == tag_l && next_class == tag_l {
        tag_l
      } else if (prev_class == tag_r || prev_class == tag_an || prev_class == tag_en) &&
      (next_class == tag_r || next_class == tag_an || next_class == tag_en) {
        tag_r
      } else {
        e
      }
      let nc_b = new_class.to_byte()
      let mut k = ni_start
      while k < abs_i {
        proc_tags[k] = nc_b
        k = k + 1
      }
      if abs_i < abs_end {
        prev_class = next_class
        abs_i = abs_i + 1
      }
    } else {
      prev_class = cur_cls
      abs_i = abs_i + 1
    }
  }
}

///| Find next non-X9 processing tag in `seq` starting at `(run_idx, start_rel)`.
fn seq_next_not_x9_tag(
  seq : IsoRunSeq,
  para_start : Int,
  proc_tags : FixedArray[Byte],
  run_idx : Int,
  start_rel : Int,
) -> Int {
  let n_runs = seq.run_starts.length()
  let mut r = run_idx
  let mut pos = start_rel
  while r < n_runs {
    let re = seq.run_ends[r]
    while pos < re {
      let t = proc_tags[para_start + pos].to_int()
      if !removed_by_x9_tag(t) {
        return t
      }
      pos = pos + 1
    }
    r = r + 1
    if r < n_runs {
      pos = seq.run_starts[r]
    }
  }
  seq.eos
}

///| Set consecutive BN entries immediately before `(run_idx, pos_rel)` in `seq` to `new_tag`.
fn seq_set_prev_bns(
  seq : IsoRunSeq,
  para_start : Int,
  proc_tags : FixedArray[Byte],
  run_idx : Int,
  pos_rel : Int,
  new_tag : Int,
) -> Unit {
  let nb = new_tag.to_byte()
  let mut r = run_idx
  let mut pos = pos_rel - 1
  while r >= 0 {
    let rs = seq.run_starts[r]
    while pos >= rs {
      if proc_tags[para_start + pos].to_int() != tag_bn {
        return
      }
      proc_tags[para_start + pos] = nb
      pos = pos - 1
    }
    r = r - 1
    if r >= 0 {
      pos = seq.run_ends[r] - 1
    }
  }
}

///| Set consecutive BN entries immediately at/after `(run_idx, pos_rel)` in `seq` to `new_tag`.
fn seq_set_next_bns(
  seq : IsoRunSeq,
  para_start : Int,
  proc_tags : FixedArray[Byte],
  run_idx : Int,
  pos_rel : Int,
  new_tag : Int,
) -> Unit {
  let nb = new_tag.to_byte()
  let n_runs = seq.run_starts.length()
  let mut r = run_idx
  let mut pos = pos_rel
  while r < n_runs {
    let re = seq.run_ends[r]
    while pos < re {
      if proc_tags[para_start + pos].to_int() != tag_bn {
        return
      }
      proc_tags[para_start + pos] = nb
      pos = pos + 1
    }
    r = r + 1
    if r < n_runs {
      pos = seq.run_starts[r]
    }
  }
}

///| UAX #9 §3.3.4 Resolving Weak Types (W1–W7) for one `IsoRunSeq`.
///| Returns `true` if any `tag_on` exists in `seq` after W1–W7 (used to skip BD16 when false).
fn resolve_weak(
  text : String,
  para_start : Int,
  seq : IsoRunSeq,
  proc_tags : FixedArray[Byte],
  scratch : BidiScratch,
) -> Bool {
  let mut prev_class_before_w4 = seq.sos
  let mut prev_class_before_w5 = seq.sos
  let mut prev_class_before_w1 = seq.sos
  let mut last_strong_is_al = false

  let et_run_indices = scratch.et_run_indices
  let bn_run_indices = scratch.bn_run_indices
  if et_run_indices.length() > 0 {
    et_run_indices.clear()
  }
  if bn_run_indices.length() > 0 {
    bn_run_indices.clear()
  }
  let mut has_et = false
  let mut has_bn = false
  let mut has_en = false
  let mut has_on = false

  let en_b = tag_en.to_byte()
  let an_b = tag_an.to_byte()
  let r_b = tag_r.to_byte()
  let on_b = tag_on.to_byte()

  let n_runs = seq.run_starts.length()
  let mut run_index = 0
  while run_index < n_runs {
    let rs = seq.run_starts[run_index]
    let re = seq.run_ends[run_index]
    let mut i = rs
    while i < re {
      let abs_i = para_start + i
      let cur0 = proc_tags[abs_i].to_int()
      if cur0 == tag_bn {
        bn_run_indices.push(abs_i)
        has_bn = true
        i = i + 1
        continue
      }

      let mut cur = cur0

      // W1: NSM takes type of previous character (or ON after isolate initiator/PDI).
      if cur == tag_nsm {
        let repl = if is_isolate_initiator_tag(prev_class_before_w1) ||
        prev_class_before_w1 == tag_pdi {
          tag_on
        } else {
          prev_class_before_w1
        }
        proc_tags[abs_i] = repl.to_byte()
        cur = repl
      }

      let w2_class = cur
      prev_class_before_w1 = cur

      // W2 & W3
      if cur == tag_en {
        if last_strong_is_al {
          proc_tags[abs_i] = an_b
          cur = tag_an
        }
      } else if cur == tag_al {
        proc_tags[abs_i] = r_b
        cur = tag_r
      }

      if w2_class == tag_l || w2_class == tag_r {
        last_strong_is_al = false
      } else if w2_class == tag_al {
        last_strong_is_al = true
      }

      let class_before_w456 = cur

      // W4, W5, W6 (separators)
      if cur == tag_en {
        has_en = true
        if has_et {
          let mut k = 0
          let et_len = et_run_indices.length()
          while k < et_len {
            proc_tags[et_run_indices[k]] = en_b
            k = k + 1
          }
          et_run_indices.clear()
          has_et = false
        }
      } else if cur == tag_es || cur == tag_cs {
        let char_len = utf8_char_len_at(text, abs_i)
        if char_len > 0 {
          let mut next_class = seq_next_not_x9_tag(seq, para_start, proc_tags, run_index, i + char_len)
          if next_class == tag_en && last_strong_is_al {
            next_class = tag_an
          }
          let resolved = if prev_class_before_w4 == tag_en && next_class == tag_en {
            has_en = true
            tag_en
          } else if prev_class_before_w4 == tag_an && class_before_w456 == tag_cs &&
          next_class == tag_an {
            tag_an
          } else {
            has_on = true
            tag_on
          }
          proc_tags[abs_i] = resolved.to_byte()
          cur = resolved
          if resolved == tag_on {
            seq_set_prev_bns(seq, para_start, proc_tags, run_index, i, tag_on)
            seq_set_next_bns(seq, para_start, proc_tags, run_index, i + char_len, tag_on)
          }
        } else {
          // Continuation byte of a multi-byte ES/CS character.
          let prev_b = proc_tags[abs_i - 1]
          proc_tags[abs_i] = prev_b
          cur = prev_b.to_int()
          if cur == tag_on {
            has_on = true
          } else if cur == tag_en {
            has_en = true
          }
        }
      } else if cur == tag_et {
        if prev_class_before_w5 == tag_en {
          proc_tags[abs_i] = en_b
          cur = tag_en
          has_en = true
        } else {
          if has_bn {
            let mut k = 0
            let bn_len = bn_run_indices.length()
            while k < bn_len {
              et_run_indices.push(bn_run_indices[k])
              k = k + 1
            }
          }
          et_run_indices.push(abs_i)
          has_et = true
        }
      } else if cur == tag_on {
        has_on = true
      }

      if has_bn {
        bn_run_indices.clear()
        has_bn = false
      }
      prev_class_before_w5 = cur

      if has_et && cur != tag_et {
        let mut k = 0
        let et_len = et_run_indices.length()
        while k < et_len {
          proc_tags[et_run_indices[k]] = on_b
          k = k + 1
        }
        et_run_indices.clear()
        has_et = false
        has_on = true
      }

      prev_class_before_w4 = class_before_w456
      i = i + 1
    }
    run_index = run_index + 1
  }

  // Remaining ETs at end of sequence become ON (W6).
  if has_et {
    let mut k = 0
    let et_len = et_run_indices.length()
    while k < et_len {
      proc_tags[et_run_indices[k]] = on_b
      k = k + 1
    }
    has_on = true
  }

  // W7: If previous strong char was L, change EN to L.
  if has_en {
    let mut last_strong_is_l = seq.sos == tag_l
    let l_b = tag_l.to_byte()
    let mut r = 0
    while r < n_runs {
      let rs = seq.run_starts[r]
      let re = seq.run_ends[r]
      let mut i = rs
      while i < re {
        let abs_i = para_start + i
        let t = proc_tags[abs_i].to_int()
        if t == tag_en {
          if last_strong_is_l {
            proc_tags[abs_i] = l_b
          }
        } else if t == tag_l {
          last_strong_is_l = true
        } else if t == tag_r || t == tag_al {
          last_strong_is_l = false
        }
        i = i + 1
      }
      r = r + 1
    }
  }

  has_on
}

///| Sort parallel bracket-pair arrays by `bp_start` ascending (insertion sort, iterative).
fn sort_bracket_pairs(
  bp_start : Array[Int],
  bp_end : Array[Int],
  bp_srun : Array[Int],
  bp_erun : Array[Int],
) -> Unit {
  let n = bp_start.length()
  let mut i = 1
  while i < n {
    let ks = bp_start[i]
    let ke = bp_end[i]
    let ksr = bp_srun[i]
    let ker = bp_erun[i]
    let mut j = i - 1
    while j >= 0 && bp_start[j] > ks {
      bp_start[j + 1] = bp_start[j]
      bp_end[j + 1] = bp_end[j]
      bp_srun[j + 1] = bp_srun[j]
      bp_erun[j + 1] = bp_erun[j]
      j = j - 1
    }
    bp_start[j + 1] = ks
    bp_end[j + 1] = ke
    bp_srun[j + 1] = ksr
    bp_erun[j + 1] = ker
    i = i + 1
  }
}

///| BD16: Identify bracket pairs in `seq` with stack cap `max_bracket_depth` (63).
///| Per UAX #9 rev 50 BD16, if the stack overflows, stops processing and returns an empty list.
fn identify_bracket_pairs(
  text : String,
  para_start : Int,
  seq : IsoRunSeq,
  proc_tags : FixedArray[Byte],
  max_bracket_depth : Int,
  scratch : BidiScratch,
) -> Unit {
  let bp_start = scratch.bp_start
  let bp_end = scratch.bp_end
  let bp_srun = scratch.bp_srun
  let bp_erun = scratch.bp_erun
  let bstack = scratch.bstack
  let bcap = scratch.bstack_cap
  let off_pos = bcap
  let off_run = bcap * 2

  if bp_start.length() > 0 {
    bp_start.clear()
    bp_end.clear()
    bp_srun.clear()
    bp_erun.clear()
  }
  let mut sp = 0

  let n_runs = seq.run_starts.length()
  let mut run_index = 0
  let mut overflowed = false
  while run_index < n_runs && !overflowed {
    let rs = seq.run_starts[run_index]
    let re = seq.run_ends[run_index]
    let mut rel = rs
    while rel < re {
      let abs_i = para_start + rel
      if proc_tags[abs_i].to_int() != tag_on {
        rel = rel + 1
        continue
      }
      let b0 = text.code_unit_at(abs_i)
      let mut cp = b0
      let mut step = 1
      if b0 >= 0x80 {
        let dec = utf8_decode_packed(text, abs_i)
        cp = dec >> 3
        let d_len = dec & 7
        step = if d_len > 0 { d_len } else { 1 }
      }

      let packed = bidi_bracket_packed(cp)
      if packed >= 0 {
        let skel = packed >> 1
        let is_open = (packed & 1) == 1
        if is_open {
          if sp >= max_bracket_depth {
            overflowed = true
            bp_start.clear()
            bp_end.clear()
            bp_srun.clear()
            bp_erun.clear()
            break
          }
          bstack[sp] = skel
          bstack[off_pos + sp] = rel
          bstack[off_run + sp] = run_index
          sp = sp + 1
        } else if sp > 0 {
          let mut si = sp - 1
          while si >= 0 {
            if bstack[si] == skel {
              bp_start.push(bstack[off_pos + si])
              bp_end.push(rel)
              bp_srun.push(bstack[off_run + si])
              bp_erun.push(run_index)
              sp = si
              break
            }
            si = si - 1
          }
        }
      }
      rel = rel + step
    }
    run_index = run_index + 1
  }

  if !overflowed && bp_start.length() > 1 {
    sort_bracket_pairs(bp_start, bp_end, bp_srun, bp_erun)
  }
}

///| UAX #9 §3.3.5 Resolving Neutral and Isolate Formatting Types (N0, N1, N2).
fn resolve_neutral(
  text : String,
  para_start : Int,
  seq : IsoRunSeq,
  levels : FixedArray[Byte],
  orig_tags : FixedArray[Byte],
  proc_tags : FixedArray[Byte],
  max_bracket_depth : Int,
  has_on : Bool,
  scratch : BidiScratch,
) -> Unit {
  let e = level_to_bidi_tag(levels[para_start + seq.run_starts[0]].to_int())
  let not_e = if e == tag_l { tag_r } else { tag_l }
  let n_runs = seq.run_starts.length()

  // N0: Process paired brackets (skipped when seq contains no ON).
  if has_on {
    identify_bracket_pairs(text, para_start, seq, proc_tags, max_bracket_depth, scratch)

    let bp_start = scratch.bp_start
    let bp_end = scratch.bp_end
    let bp_srun = scratch.bp_srun
    let bp_erun = scratch.bp_erun

    let mut p = 0
    while p < bp_start.length() {
      let p_start = bp_start[p]
      let p_end = bp_end[p]
      let p_srun = bp_srun[p]
      let p_erun = bp_erun[p]

      let start_char_len = utf8_char_len_at(text, para_start + p_start)
      let start_step = if start_char_len > 0 { start_char_len } else { 1 }

      // Inspect enclosed characters in (p_start + start_step .. p_end) along seq.
      let mut found_e = false
      let mut found_not_e = false
      let mut r = p_srun
      let mut pos = p_start + start_step
      while r < n_runs && !found_e {
        let re = seq.run_ends[r]
        let mut stop = false
        while pos < re {
          if pos >= p_end {
            stop = true
            break
          }
          let cls = proc_tags[para_start + pos].to_int()
          if cls == e {
            found_e = true
            break
          } else if cls == not_e {
            found_not_e = true
          } else if cls == tag_en || cls == tag_an {
            if e == tag_l {
              found_not_e = true
            } else {
              found_e = true
              break
            }
          }
          pos = pos + 1
        }
        if stop || found_e {
          break
        }
        r = r + 1
        if r < n_runs {
          pos = seq.run_starts[r]
        }
      }

      let mut class_to_set = -1
      if found_e {
        class_to_set = e
      } else if found_not_e {
        // Scan backwards before opening bracket for first strong type (L, R, EN, AN, or sos).
        let mut prev_strong = seq.sos
        let mut br = p_srun
        let mut bpos = p_start - 1
        let mut found_prev = false
        while br >= 0 && !found_prev {
          let brs = seq.run_starts[br]
          while bpos >= brs {
            let cls = proc_tags[para_start + bpos].to_int()
            if cls == tag_l || cls == tag_r || cls == tag_en || cls == tag_an {
              prev_strong = if cls == tag_en || cls == tag_an { tag_r } else { cls }
              found_prev = true
              break
            }
            bpos = bpos - 1
          }
          br = br - 1
          if br >= 0 {
            bpos = seq.run_ends[br] - 1
          }
        }
        class_to_set = prev_strong
      }

      if class_to_set >= 0 {
        let cts_b = class_to_set.to_byte()
        let end_char_len = utf8_char_len_at(text, para_start + p_end)
        let end_step = if end_char_len > 0 { end_char_len } else { 1 }

        let mut k = 0
        while k < start_step {
          proc_tags[para_start + p_start + k] = cts_b
          k = k + 1
        }
        let mut k2 = 0
        while k2 < end_step {
          proc_tags[para_start + p_end + k2] = cts_b
          k2 = k + 1
        }

        // Retaining explicit formatting characters: preceding BNs before opening bracket.
        seq_set_prev_bns(seq, para_start, proc_tags, p_srun, p_start, class_to_set)

        // Trailing NSMs (and BNs) immediately after opening bracket.
        let mut nr = p_srun
        let mut npos = p_start + start_step
        let mut cont_open = true
        while nr < n_runs && cont_open {
          let nre = seq.run_ends[nr]
          while npos < nre {
            if orig_tags[para_start + npos].to_int() == tag_nsm ||
            proc_tags[para_start + npos].to_int() == tag_bn {
              proc_tags[para_start + npos] = cts_b
            } else {
              cont_open = false
              break
            }
            npos = npos + 1
          }
          nr = nr + 1
          if nr < n_runs {
            npos = seq.run_starts[nr]
          }
        }

        // Trailing NSMs (and BNs) immediately after closing bracket.
        let mut er = p_erun
        let mut epos = p_end + end_step
        let mut cont_close = true
        while er < n_runs && cont_close {
          let ere = seq.run_ends[er]
          while epos < ere {
            if orig_tags[para_start + epos].to_int() == tag_nsm ||
            proc_tags[para_start + epos].to_int() == tag_bn {
              proc_tags[para_start + epos] = cts_b
            } else {
              cont_close = false
              break
            }
            epos = epos + 1
          }
          er = er + 1
          if er < n_runs {
            epos = seq.run_starts[er]
          }
        }
      }

      p = p + 1
    }
  }

  // N1 and N2: Fast zero-allocation path for single-run sequences.
  if n_runs == 1 {
    let mut prev_class = seq.sos
    let mut abs_i = para_start + seq.run_starts[0]
    let abs_end = para_start + seq.run_ends[0]
    while abs_i < abs_end {
      let cur_cls = proc_tags[abs_i].to_int()
      if is_ni_or_bn_tag(cur_cls) {
        let ni_start = abs_i
        abs_i = abs_i + 1
        let mut next_class = seq.eos
        while abs_i < abs_end {
          let jc = proc_tags[abs_i].to_int()
          if !is_ni_or_bn_tag(jc) {
            next_class = jc
            break
          }
          abs_i = abs_i + 1
        }
        let new_class = if prev_class == tag_l && next_class == tag_l {
          tag_l
        } else if (prev_class == tag_r || prev_class == tag_an || prev_class == tag_en) &&
        (next_class == tag_r || next_class == tag_an || next_class == tag_en) {
          tag_r
        } else {
          e
        }
        let nc_b = new_class.to_byte()
        let mut k = ni_start
        while k < abs_i {
          proc_tags[k] = nc_b
          k = k + 1
        }
        if abs_i < abs_end {
          prev_class = next_class
          abs_i = abs_i + 1
        }
      } else {
        prev_class = cur_cls
        abs_i = abs_i + 1
      }
    }
    return
  }

  // N1 and N2: Zero-allocation multi-run sequence path (fills directly across runs without `ni_run`).
  let mut prev_class = seq.sos
  let mut r = 0
  let mut pos = seq.run_starts[0]
  let mut has_cur = n_runs > 0 && seq.run_starts[0] < seq.run_ends[0]
  while has_cur {
    let abs_i = para_start + pos
    let cur_cls = proc_tags[abs_i].to_int()
    if is_ni_or_bn_tag(cur_cls) {
      let start_r = r
      let start_pos = pos
      let mut next_class = seq.eos
      let mut scanning = true
      while scanning {
        pos = pos + 1
        while r < n_runs && pos >= seq.run_ends[r] {
          r = r + 1
          if r < n_runs {
            pos = seq.run_starts[r]
          }
        }
        if r >= n_runs {
          has_cur = false
          next_class = seq.eos
          scanning = false
        } else {
          let jc = proc_tags[para_start + pos].to_int()
          if !is_ni_or_bn_tag(jc) {
            next_class = jc
            scanning = false
          }
        }
      }

      let new_class = if prev_class == tag_l && next_class == tag_l {
        tag_l
      } else if (prev_class == tag_r || prev_class == tag_an || prev_class == tag_en) &&
      (next_class == tag_r || next_class == tag_an || next_class == tag_en) {
        tag_r
      } else {
        e
      }
      let nc_b = new_class.to_byte()
      let mut fr = start_r
      let mut fp = start_pos
      while fr < n_runs {
        let fend = if fr == r && has_cur { pos } else { seq.run_ends[fr] }
        let mut abs_k = para_start + fp
        let abs_fend = para_start + fend
        while abs_k < abs_fend {
          proc_tags[abs_k] = nc_b
          abs_k = abs_k + 1
        }
        if fr == r {
          break
        }
        fr = fr + 1
        if fr < n_runs {
          fp = seq.run_starts[fr]
        }
      }
      if has_cur {
        prev_class = next_class
        pos = pos + 1
        while r < n_runs && pos >= seq.run_ends[r] {
          r = r + 1
          if r < n_runs {
            pos = seq.run_starts[r]
          }
        }
        if r >= n_runs {
          has_cur = false
        }
      }
    } else {
      prev_class = cur_cls
      pos = pos + 1
      while r < n_runs && pos >= seq.run_ends[r] {
        r = r + 1
        if r < n_runs {
          pos = seq.run_starts[r]
        }
      }
      if r >= n_runs {
        has_cur = false
      }
    }
  }
}

///| UAX #9 §3.3.6 Resolving Implicit Levels (I1, I2) + X9 removed-char level assignment for `[para_start, para_end)`.
fn resolve_implicit_and_x9(
  para_start : Int,
  para_end : Int,
  para_level : Int,
  has_x9 : Bool,
  orig_tags : FixedArray[Byte],
  proc_tags : FixedArray[Byte],
  levels : FixedArray[Byte],
) -> Unit {
  if !has_x9 {
    let mut i = para_start
    while i < para_end {
      let lv = levels[i].to_int()
      let pt = proc_tags[i].to_int()
      if (lv & 1) == 0 {
        if pt == tag_r {
          let next = lv + 1
          levels[i] = (if next > 126 { 126 } else { next }).to_byte()
        } else if pt == tag_an || pt == tag_en {
          let next = lv + 2
          levels[i] = (if next > 126 { 126 } else { next }).to_byte()
        }
      } else {
        if pt == tag_l || pt == tag_en || pt == tag_an {
          let next = lv + 1
          levels[i] = (if next > 126 { 126 } else { next }).to_byte()
        }
      }
      i = i + 1
    }
  } else {
    let mut prev_lv_b = para_level.to_byte()
    let mut i = para_start
    while i < para_end {
      if removed_by_x9_tag(orig_tags[i].to_int()) {
        levels[i] = prev_lv_b
      } else {
        let lv = levels[i].to_int()
        let pt = proc_tags[i].to_int()
        let mut out_b = levels[i]
        if (lv & 1) == 0 {
          if pt == tag_r {
            let next = lv + 1
            out_b = (if next > 126 { 126 } else { next }).to_byte()
            levels[i] = out_b
          } else if pt == tag_an || pt == tag_en {
            let next = lv + 2
            out_b = (if next > 126 { 126 } else { next }).to_byte()
            levels[i] = out_b
          }
        } else {
          if pt == tag_l || pt == tag_en || pt == tag_an {
            let next = lv + 1
            out_b = (if next > 126 { 126 } else { next }).to_byte()
            levels[i] = out_b
          }
        }
        prev_lv_b = out_b
      }
      i = i + 1
    }
  }
}
