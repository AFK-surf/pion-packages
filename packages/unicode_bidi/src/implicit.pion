///| UAX #9 §3.3.4–§3.3.6 Weak Types (W1–W7), Neutral Types (N0–N2), and Implicit Levels (I1–I2).

///| Reusable scratch buffers across paragraphs and isolating run sequences to avoid allocation churn.
struct BidiScratch {
  stack_level : Array[Int]
  stack_status : Array[Int]
  run_starts : Array[Int]
  run_ends : Array[Int]
  single_s : Array[Int]
  single_e : Array[Int]
  et_run_indices : Array[Int]
  bn_run_indices : Array[Int]
  bp_start : Array[Int]
  bp_end : Array[Int]
  bp_srun : Array[Int]
  bp_erun : Array[Int]
  bstack_skel : Array[Int]
  bstack_pos : Array[Int]
  bstack_run : Array[Int]
  ni_run : Array[Int]
}

fn bidi_scratch_new() -> BidiScratch {
  BidiScratch::{
    stack_level: Array::new(),
    stack_status: Array::new(),
    run_starts: Array::new(),
    run_ends: Array::new(),
    single_s: [0],
    single_e: [0],
    et_run_indices: Array::new(),
    bn_run_indices: Array::new(),
    bp_start: Array::new(),
    bp_end: Array::new(),
    bp_srun: Array::new(),
    bp_erun: Array::new(),
    bstack_skel: Array::new(),
    bstack_pos: Array::new(),
    bstack_run: Array::new(),
    ni_run: Array::new(),
  }
}

///| Find next non-X9 processing tag in `seq` starting at `(run_idx, start_rel)`.
fn seq_next_not_x9_tag(
  seq : IsoRunSeq,
  para_start : Int,
  proc_tags : Bytes,
  run_idx : Int,
  start_rel : Int,
) -> Int {
  let n_runs = seq.run_starts.length()
  let mut r = run_idx
  let mut pos = start_rel
  while r < n_runs {
    let re = seq.run_ends[r]
    while pos < re {
      let t = proc_tags[para_start + pos].to_int()
      if !removed_by_x9_tag(t) {
        return t
      }
      pos = pos + 1
    }
    r = r + 1
    if r < n_runs {
      pos = seq.run_starts[r]
    }
  }
  seq.eos
}

///| Set consecutive BN entries immediately before `(run_idx, pos_rel)` in `seq` to `new_tag`.
fn seq_set_prev_bns(
  seq : IsoRunSeq,
  para_start : Int,
  proc_tags : Bytes,
  run_idx : Int,
  pos_rel : Int,
  new_tag : Int,
) -> Unit {
  let nb = new_tag.to_byte()
  let mut r = run_idx
  let mut pos = pos_rel - 1
  while r >= 0 {
    let rs = seq.run_starts[r]
    while pos >= rs {
      if proc_tags[para_start + pos].to_int() != tag_bn {
        return
      }
      proc_tags[para_start + pos] = nb
      pos = pos - 1
    }
    r = r - 1
    if r >= 0 {
      pos = seq.run_ends[r] - 1
    }
  }
}

///| Set consecutive BN entries immediately at/after `(run_idx, pos_rel)` in `seq` to `new_tag`.
fn seq_set_next_bns(
  seq : IsoRunSeq,
  para_start : Int,
  proc_tags : Bytes,
  run_idx : Int,
  pos_rel : Int,
  new_tag : Int,
) -> Unit {
  let nb = new_tag.to_byte()
  let n_runs = seq.run_starts.length()
  let mut r = run_idx
  let mut pos = pos_rel
  while r < n_runs {
    let re = seq.run_ends[r]
    while pos < re {
      if proc_tags[para_start + pos].to_int() != tag_bn {
        return
      }
      proc_tags[para_start + pos] = nb
      pos = pos + 1
    }
    r = r + 1
    if r < n_runs {
      pos = seq.run_starts[r]
    }
  }
}

///| UAX #9 §3.3.4 Resolving Weak Types (W1–W7) for one `IsoRunSeq`.
fn resolve_weak(
  text : String,
  para_start : Int,
  seq : IsoRunSeq,
  proc_tags : Bytes,
  scratch : BidiScratch,
) -> Unit {
  let mut prev_class_before_w4 = seq.sos
  let mut prev_class_before_w5 = seq.sos
  let mut prev_class_before_w1 = seq.sos
  let mut last_strong_is_al = false

  let et_run_indices = scratch.et_run_indices
  let bn_run_indices = scratch.bn_run_indices
  et_run_indices.clear()
  bn_run_indices.clear()

  let n_runs = seq.run_starts.length()
  let mut run_index = 0
  while run_index < n_runs {
    let rs = seq.run_starts[run_index]
    let re = seq.run_ends[run_index]
    let mut i = rs
    while i < re {
      let abs_i = para_start + i
      let cur0 = proc_tags[abs_i].to_int()
      if cur0 == tag_bn {
        bn_run_indices.push(abs_i)
        i = i + 1
        continue
      }

      let mut w2_class = cur0

      // W1: NSM takes type of previous character (or ON after isolate initiator/PDI).
      if cur0 == tag_nsm {
        let repl = if is_isolate_initiator_tag(prev_class_before_w1) ||
        prev_class_before_w1 == tag_pdi {
          tag_on
        } else {
          prev_class_before_w1
        }
        proc_tags[abs_i] = repl.to_byte()
        w2_class = repl
      }

      prev_class_before_w1 = proc_tags[abs_i].to_int()

      // W2 & W3
      let cur1 = prev_class_before_w1
      if cur1 == tag_en {
        if last_strong_is_al {
          proc_tags[abs_i] = tag_an.to_byte()
        }
      } else if cur1 == tag_al {
        proc_tags[abs_i] = tag_r.to_byte()
      }

      if w2_class == tag_l || w2_class == tag_r {
        last_strong_is_al = false
      } else if w2_class == tag_al {
        last_strong_is_al = true
      }

      let class_before_w456 = proc_tags[abs_i].to_int()

      // W4, W5, W6 (separators)
      if class_before_w456 == tag_en {
        let mut k = 0
        let en_b = tag_en.to_byte()
        while k < et_run_indices.length() {
          proc_tags[et_run_indices[k]] = en_b
          k = k + 1
        }
        et_run_indices.clear()
      } else if class_before_w456 == tag_es || class_before_w456 == tag_cs {
        let char_len = utf8_char_len_at(text, abs_i)
        if char_len > 0 {
          let mut next_class = seq_next_not_x9_tag(seq, para_start, proc_tags, run_index, i + char_len)
          if next_class == tag_en && last_strong_is_al {
            next_class = tag_an
          }
          let resolved = if prev_class_before_w4 == tag_en && next_class == tag_en {
            tag_en
          } else if prev_class_before_w4 == tag_an && class_before_w456 == tag_cs &&
          next_class == tag_an {
            tag_an
          } else {
            tag_on
          }
          proc_tags[abs_i] = resolved.to_byte()
          if resolved == tag_on {
            seq_set_prev_bns(seq, para_start, proc_tags, run_index, i, tag_on)
            seq_set_next_bns(seq, para_start, proc_tags, run_index, i + char_len, tag_on)
          }
        } else {
          // Continuation byte of a multi-byte ES/CS character.
          proc_tags[abs_i] = proc_tags[abs_i - 1]
        }
      } else if class_before_w456 == tag_et {
        if prev_class_before_w5 == tag_en {
          proc_tags[abs_i] = tag_en.to_byte()
        } else {
          let mut k = 0
          while k < bn_run_indices.length() {
            et_run_indices.push(bn_run_indices[k])
            k = k + 1
          }
          et_run_indices.push(abs_i)
        }
      }

      bn_run_indices.clear()
      prev_class_before_w5 = proc_tags[abs_i].to_int()

      if prev_class_before_w5 != tag_et {
        let mut k = 0
        let on_b = tag_on.to_byte()
        while k < et_run_indices.length() {
          proc_tags[et_run_indices[k]] = on_b
          k = k + 1
        }
        et_run_indices.clear()
      }

      prev_class_before_w4 = class_before_w456
      i = i + 1
    }
    run_index = run_index + 1
  }

  // Remaining ETs at end of sequence become ON (W6).
  let mut k = 0
  let on_b = tag_on.to_byte()
  while k < et_run_indices.length() {
    proc_tags[et_run_indices[k]] = on_b
    k = k + 1
  }

  // W7: If previous strong char was L, change EN to L.
  let mut last_strong_is_l = seq.sos == tag_l
  let l_b = tag_l.to_byte()
  let mut r = 0
  while r < n_runs {
    let rs = seq.run_starts[r]
    let re = seq.run_ends[r]
    let mut i = rs
    while i < re {
      let abs_i = para_start + i
      let t = proc_tags[abs_i].to_int()
      if t == tag_en {
        if last_strong_is_l {
          proc_tags[abs_i] = l_b
        }
      } else if t == tag_l {
        last_strong_is_l = true
      } else if t == tag_r || t == tag_al {
        last_strong_is_l = false
      }
      i = i + 1
    }
    r = r + 1
  }
}

///| Sort parallel bracket-pair arrays by `bp_start` ascending (insertion sort, iterative).
fn sort_bracket_pairs(
  bp_start : Array[Int],
  bp_end : Array[Int],
  bp_srun : Array[Int],
  bp_erun : Array[Int],
) -> Unit {
  let n = bp_start.length()
  let mut i = 1
  while i < n {
    let ks = bp_start[i]
    let ke = bp_end[i]
    let ksr = bp_srun[i]
    let ker = bp_erun[i]
    let mut j = i - 1
    while j >= 0 && bp_start[j] > ks {
      bp_start[j + 1] = bp_start[j]
      bp_end[j + 1] = bp_end[j]
      bp_srun[j + 1] = bp_srun[j]
      bp_erun[j + 1] = bp_erun[j]
      j = j - 1
    }
    bp_start[j + 1] = ks
    bp_end[j + 1] = ke
    bp_srun[j + 1] = ksr
    bp_erun[j + 1] = ker
    i = i + 1
  }
}

///| BD16: Identify bracket pairs in `seq` with stack cap `max_bracket_depth` (63).
///| Per UAX #9 rev 50 BD16, if the stack overflows, stops processing and returns an empty list.
fn identify_bracket_pairs(
  text : String,
  para_start : Int,
  seq : IsoRunSeq,
  proc_tags : Bytes,
  max_bracket_depth : Int,
  scratch : BidiScratch,
) -> Unit {
  let bp_start = scratch.bp_start
  let bp_end = scratch.bp_end
  let bp_srun = scratch.bp_srun
  let bp_erun = scratch.bp_erun
  let stack_skel = scratch.bstack_skel
  let stack_pos = scratch.bstack_pos
  let stack_run = scratch.bstack_run

  bp_start.clear()
  bp_end.clear()
  bp_srun.clear()
  bp_erun.clear()
  stack_skel.clear()
  stack_pos.clear()
  stack_run.clear()

  let n_runs = seq.run_starts.length()
  let mut run_index = 0
  let mut overflowed = false
  while run_index < n_runs && !overflowed {
    let rs = seq.run_starts[run_index]
    let re = seq.run_ends[run_index]
    let mut rel = rs
    while rel < re {
      let abs_i = para_start + rel
      let b0 = text.code_unit_at(abs_i)
      let mut cp = b0
      let mut step = 1
      if b0 >= 0x80 {
        let dec = utf8_decode_packed(text, abs_i)
        cp = dec >> 3
        let d_len = dec & 7
        step = if d_len > 0 { d_len } else { 1 }
      }

      if proc_tags[abs_i].to_int() == tag_on {
        let packed = bidi_bracket_packed(cp)
        if packed >= 0 {
          let skel = packed >> 1
          let is_open = (packed & 1) == 1
          if is_open {
            if stack_skel.length() >= max_bracket_depth {
              overflowed = true
              bp_start.clear()
              bp_end.clear()
              bp_srun.clear()
              bp_erun.clear()
              break
            }
            stack_skel.push(skel)
            stack_pos.push(rel)
            stack_run.push(run_index)
          } else {
            let mut si = stack_skel.length() - 1
            while si >= 0 {
              if stack_skel[si] == skel {
                bp_start.push(stack_pos[si])
                bp_end.push(rel)
                bp_srun.push(stack_run[si])
                bp_erun.push(run_index)
                while stack_skel.length() > si {
                  let _ = stack_skel.pop()
                  let _ = stack_pos.pop()
                  let _ = stack_run.pop()
                }
                break
              }
              si = si - 1
            }
          }
        }
      }
      rel = rel + step
    }
    run_index = run_index + 1
  }

  if !overflowed && bp_start.length() > 1 {
    sort_bracket_pairs(bp_start, bp_end, bp_srun, bp_erun)
  }
}

///| UAX #9 §3.3.5 Resolving Neutral and Isolate Formatting Types (N0, N1, N2).
fn resolve_neutral(
  text : String,
  para_start : Int,
  seq : IsoRunSeq,
  levels : Bytes,
  orig_tags : Bytes,
  proc_tags : Bytes,
  max_bracket_depth : Int,
  scratch : BidiScratch,
) -> Unit {
  let e = level_to_bidi_tag(levels[para_start + seq.run_starts[0]].to_int())
  let not_e = if e == tag_l { tag_r } else { tag_l }

  // N0: Process paired brackets.
  identify_bracket_pairs(text, para_start, seq, proc_tags, max_bracket_depth, scratch)

  let bp_start = scratch.bp_start
  let bp_end = scratch.bp_end
  let bp_srun = scratch.bp_srun
  let bp_erun = scratch.bp_erun

  let n_runs = seq.run_starts.length()
  let mut p = 0
  while p < bp_start.length() {
    let p_start = bp_start[p]
    let p_end = bp_end[p]
    let p_srun = bp_srun[p]
    let p_erun = bp_erun[p]

    let start_char_len = utf8_char_len_at(text, para_start + p_start)
    let start_step = if start_char_len > 0 { start_char_len } else { 1 }

    // Inspect enclosed characters in (p_start + start_step .. p_end) along seq.
    let mut found_e = false
    let mut found_not_e = false
    let mut r = p_srun
    let mut pos = p_start + start_step
    while r < n_runs && !found_e {
      let re = seq.run_ends[r]
      let mut stop = false
      while pos < re {
        if pos >= p_end {
          stop = true
          break
        }
        let cls = proc_tags[para_start + pos].to_int()
        if cls == e {
          found_e = true
          break
        } else if cls == not_e {
          found_not_e = true
        } else if cls == tag_en || cls == tag_an {
          if e == tag_l {
            found_not_e = true
          } else {
            found_e = true
            break
          }
        }
        pos = pos + 1
      }
      if stop || found_e {
        break
      }
      r = r + 1
      if r < n_runs {
        pos = seq.run_starts[r]
      }
    }

    let mut class_to_set = -1
    if found_e {
      class_to_set = e
    } else if found_not_e {
      // Scan backwards before opening bracket for first strong type (L, R, EN, AN, or sos).
      let mut prev_strong = seq.sos
      let mut br = p_srun
      let mut bpos = p_start - 1
      let mut found_prev = false
      while br >= 0 && !found_prev {
        let brs = seq.run_starts[br]
        while bpos >= brs {
          let cls = proc_tags[para_start + bpos].to_int()
          if cls == tag_l || cls == tag_r || cls == tag_en || cls == tag_an {
            prev_strong = if cls == tag_en || cls == tag_an { tag_r } else { cls }
            found_prev = true
            break
          }
          bpos = bpos - 1
        }
        br = br - 1
        if br >= 0 {
          bpos = seq.run_ends[br] - 1
        }
      }
      class_to_set = prev_strong
    }

    if class_to_set >= 0 {
      let cts_b = class_to_set.to_byte()
      let end_char_len = utf8_char_len_at(text, para_start + p_end)
      let end_step = if end_char_len > 0 { end_char_len } else { 1 }

      let mut k = 0
      while k < start_step {
        proc_tags[para_start + p_start + k] = cts_b
        k = k + 1
      }
      let mut k2 = 0
      while k2 < end_step {
        proc_tags[para_start + p_end + k2] = cts_b
        k2 = k2 + 1
      }

      // Retaining explicit formatting characters: preceding BNs before opening bracket.
      seq_set_prev_bns(seq, para_start, proc_tags, p_srun, p_start, class_to_set)

      // Trailing NSMs (and BNs) immediately after opening bracket.
      let mut nr = p_srun
      let mut npos = p_start + start_step
      let mut cont_open = true
      while nr < n_runs && cont_open {
        let nre = seq.run_ends[nr]
        while npos < nre {
          if orig_tags[para_start + npos].to_int() == tag_nsm ||
          proc_tags[para_start + npos].to_int() == tag_bn {
            proc_tags[para_start + npos] = cts_b
          } else {
            cont_open = false
            break
          }
          npos = npos + 1
        }
        nr = nr + 1
        if nr < n_runs {
          npos = seq.run_starts[nr]
        }
      }

      // Trailing NSMs (and BNs) immediately after closing bracket.
      let mut er = p_erun
      let mut epos = p_end + end_step
      let mut cont_close = true
      while er < n_runs && cont_close {
        let ere = seq.run_ends[er]
        while epos < ere {
          if orig_tags[para_start + epos].to_int() == tag_nsm ||
          proc_tags[para_start + epos].to_int() == tag_bn {
            proc_tags[para_start + epos] = cts_b
          } else {
            cont_close = false
            break
          }
          epos = epos + 1
        }
        er = er + 1
        if er < n_runs {
          epos = seq.run_starts[er]
        }
      }
    }

    p = p + 1
  }

  // N1 and N2: Resolve runs of NI (and BN) characters.
  let ni_run = scratch.ni_run
  let mut prev_class = seq.sos
  let mut r = 0
  let mut pos = seq.run_starts[0]
  let mut has_cur = n_runs > 0 && seq.run_starts[0] < seq.run_ends[0]
  while has_cur {
    let abs_i = para_start + pos
    let cur_cls = proc_tags[abs_i].to_int()
    if is_ni_tag(cur_cls) || cur_cls == tag_bn {
      ni_run.clear()
      ni_run.push(abs_i)
      let mut next_class = seq.eos
      let mut last_abs = abs_i
      let mut scanning = true
      while scanning {
        // Advance cursor
        pos = pos + 1
        while r < n_runs && pos >= seq.run_ends[r] {
          r = r + 1
          if r < n_runs {
            pos = seq.run_starts[r]
          }
        }
        if r >= n_runs {
          has_cur = false
          next_class = seq.eos
          scanning = false
        } else {
          let j_abs = para_start + pos
          let jc = proc_tags[j_abs].to_int()
          last_abs = j_abs
          if is_ni_tag(jc) || jc == tag_bn {
            ni_run.push(j_abs)
          } else {
            next_class = jc
            scanning = false
          }
        }
      }

      let new_class = if prev_class == tag_l && next_class == tag_l {
        tag_l
      } else if (prev_class == tag_r || prev_class == tag_an || prev_class == tag_en) &&
      (next_class == tag_r || next_class == tag_an || next_class == tag_en) {
        tag_r
      } else {
        e
      }
      let nc_b = new_class.to_byte()
      let mut k = 0
      while k < ni_run.length() {
        proc_tags[ni_run[k]] = nc_b
        k = k + 1
      }
      prev_class = proc_tags[last_abs].to_int()
      if has_cur {
        // Advance past the non-NI element we just stopped on
        pos = pos + 1
        while r < n_runs && pos >= seq.run_ends[r] {
          r = r + 1
          if r < n_runs {
            pos = seq.run_starts[r]
          }
        }
        if r >= n_runs {
          has_cur = false
        }
      }
    } else {
      prev_class = cur_cls
      pos = pos + 1
      while r < n_runs && pos >= seq.run_ends[r] {
        r = r + 1
        if r < n_runs {
          pos = seq.run_starts[r]
        }
      }
      if r >= n_runs {
        has_cur = false
      }
    }
  }
}

///| UAX #9 §3.3.6 Resolving Implicit Levels (I1, I2) for `[para_start, para_end)`.
fn resolve_implicit_levels(
  para_start : Int,
  para_end : Int,
  proc_tags : Bytes,
  levels : Bytes,
) -> Unit {
  let mut i = para_start
  while i < para_end {
    let lv = levels[i].to_int()
    let pt = proc_tags[i].to_int()
    if (lv & 1) == 0 {
      // Even (LTR): I1
      if pt == tag_r {
        let next = lv + 1
        levels[i] = (if next > 126 { 126 } else { next }).to_byte()
      } else if pt == tag_an || pt == tag_en {
        let next = lv + 2
        levels[i] = (if next > 126 { 126 } else { next }).to_byte()
      }
    } else {
      // Odd (RTL): I2
      if pt == tag_l || pt == tag_en || pt == tag_an {
        let next = lv + 1
        levels[i] = (if next > 126 { 126 } else { next }).to_byte()
      }
    }
    i = i + 1
  }
}

///| Assign levels to X9-removed characters (matches `unicode-bidi::assign_levels_to_removed_chars`).
fn assign_levels_to_removed_chars(
  para_start : Int,
  para_end : Int,
  para_level : Int,
  orig_tags : Bytes,
  levels : Bytes,
) -> Unit {
  let para_lv_b = para_level.to_byte()
  let mut i = para_start
  while i < para_end {
    if removed_by_x9_tag(orig_tags[i].to_int()) {
      levels[i] = if i > para_start { levels[i - 1] } else { para_lv_b }
    }
    i = i + 1
  }
}
