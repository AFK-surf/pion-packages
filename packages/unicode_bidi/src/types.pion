///| Core public types for `unicode_bidi` (Unicode UAX #9 Bidirectional Algorithm, Unicode 16.0.0).

///| Unicode `Bidi_Class` property values (UAX #9 §3.2).
pub enum BidiClass {
  AL
  AN
  B
  BN
  CS
  EN
  ES
  ET
  FSI
  L
  LRE
  LRI
  LRO
  NSM
  ON
  PDF
  PDI
  R
  RLE
  RLI
  RLO
  S
  WS
}

///| Convert a `BidiClass` to its compact integer tag (0..22).
pub fn bidi_class_to_int(c : BidiClass) -> Int {
  match c {
    AL => 0
    AN => 1
    B => 2
    BN => 3
    CS => 4
    EN => 5
    ES => 6
    ET => 7
    FSI => 8
    L => 9
    LRE => 10
    LRI => 11
    LRO => 12
    NSM => 13
    ON => 14
    PDF => 15
    PDI => 16
    R => 17
    RLE => 18
    RLI => 19
    RLO => 20
    S => 21
    WS => 22
  }
}

///| Reconstruct a `BidiClass` from its compact integer tag (0..22).
pub fn bidi_class_from_int(tag : Int) -> BidiClass {
  match tag {
    0 => BidiClass::AL
    1 => BidiClass::AN
    2 => BidiClass::B
    3 => BidiClass::BN
    4 => BidiClass::CS
    5 => BidiClass::EN
    6 => BidiClass::ES
    7 => BidiClass::ET
    8 => BidiClass::FSI
    9 => BidiClass::L
    10 => BidiClass::LRE
    11 => BidiClass::LRI
    12 => BidiClass::LRO
    13 => BidiClass::NSM
    14 => BidiClass::ON
    15 => BidiClass::PDF
    16 => BidiClass::PDI
    17 => BidiClass::R
    18 => BidiClass::RLE
    19 => BidiClass::RLI
    20 => BidiClass::RLO
    21 => BidiClass::S
    22 => BidiClass::WS
    _ => BidiClass::L
  }
}

///|
pub fn bidi_class_eq(a : BidiClass, b : BidiClass) -> Bool {
  bidi_class_to_int(a) == bidi_class_to_int(b)
}

///|
pub fn bidi_class_to_string(c : BidiClass) -> String {
  match c {
    AL => "AL"
    AN => "AN"
    B => "B"
    BN => "BN"
    CS => "CS"
    EN => "EN"
    ES => "ES"
    ET => "ET"
    FSI => "FSI"
    L => "L"
    LRE => "LRE"
    LRI => "LRI"
    LRO => "LRO"
    NSM => "NSM"
    ON => "ON"
    PDF => "PDF"
    PDI => "PDI"
    R => "R"
    RLE => "RLE"
    RLI => "RLI"
    RLO => "RLO"
    S => "S"
    WS => "WS"
  }
}

///| Structured error returned by fallible `unicode_bidi` APIs.
pub enum BidiError {
  OutOfRangeLevel(Int)
  InputTooLong(Int, Int)
  InvalidLineRange(Int, Int, Int)
}

///|
pub fn bidi_error_to_string(err : BidiError) -> String {
  match err {
    OutOfRangeLevel(n) => "embedding level out of range: " + n.to_string()
    InputTooLong(actual, max) =>
    "input byte length " + actual.to_string() + " exceeds limit " + max.to_string()
    InvalidLineRange(start, end, len) =>
    "invalid line range [" + start.to_string() + ", " + end.to_string() + ") for text length " + len.to_string()
  }
}

///| Explicit resource and UAX #9 depth limits.
pub val struct Limits {
  pub max_input_bytes : Int
  pub max_depth : Int
  pub max_bracket_depth : Int
}

///| Default UAX #9 limits (`max_input_bytes = 16 MiB`, `max_depth = 125`, `max_bracket_depth = 63`).
pub fn Limits::default() -> Limits {
  Limits::{
    max_input_bytes: 16 * 1024 * 1024,
    max_depth: 125,
    max_bracket_depth: 63,
  }
}

///| Bidi embedding level (0..=126; even = LTR, odd = RTL).
pub val struct Level {
  value : Int
}

///| Maximum explicit embedding depth per UAX #9 BD2 (`125`).
pub fn Level::max_explicit_depth() -> Int {
  125
}

///| Maximum implicit embedding depth per UAX #9 (`126`).
pub fn Level::max_implicit_depth() -> Int {
  126
}

///| Lowest LTR level (`0`).
pub fn Level::ltr() -> Level {
  Level::{ value: 0 }
}

///| Lowest RTL level (`1`).
pub fn Level::rtl() -> Level {
  Level::{ value: 1 }
}

///| Construct a `Level` in `0..=126`.
pub fn Level::new(number : Int) -> Result[Level, BidiError] {
  if number >= 0 && number <= 126 {
    Ok(Level::{ value: number })
  } else {
    Err(BidiError::OutOfRangeLevel(number))
  }
}

///| Construct an explicit `Level` in `0..=125`.
pub fn Level::new_explicit(number : Int) -> Result[Level, BidiError] {
  if number >= 0 && number <= 125 {
    Ok(Level::{ value: number })
  } else {
    Err(BidiError::OutOfRangeLevel(number))
  }
}

///| Numeric embedding level (`0..=126`).
pub fn Level::number(self : Level) -> Int {
  self.value
}

///| True if even (LTR).
pub fn Level::is_ltr(self : Level) -> Bool {
  (self.value & 1) == 0
}

///| True if odd (RTL).
pub fn Level::is_rtl(self : Level) -> Bool {
  (self.value & 1) == 1
}

///|
pub fn Level::eq(self : Level, other : Level) -> Bool {
  self.value == other.value
}

///| Next greater LTR (even) explicit level, or `Err` if > 125.
pub fn Level::new_explicit_next_ltr(self : Level) -> Result[Level, BidiError] {
  let next = (self.value + 2) & -2
  Level::new_explicit(next)
}

///| Next greater RTL (odd) explicit level, or `Err` if > 125.
pub fn Level::new_explicit_next_rtl(self : Level) -> Result[Level, BidiError] {
  let next = (self.value + 1) | 1
  Level::new_explicit(next)
}

///| Lowest RTL (odd) level >= self, or `Err` if > 126.
pub fn Level::new_lowest_ge_rtl(self : Level) -> Result[Level, BidiError] {
  Level::new(self.value | 1)
}

///| Strong directional class corresponding to this level (`L` or `R`).
pub fn Level::bidi_class(self : Level) -> BidiClass {
  if self.is_rtl() {
    BidiClass::R
  } else {
    BidiClass::L
  }
}

///| Paragraph or base directionality.
pub enum Direction {
  Ltr
  Rtl
  Mixed
}

///|
pub fn direction_eq(a : Direction, b : Direction) -> Bool {
  match (a, b) {
    (Direction::Ltr, Direction::Ltr) => true
    (Direction::Rtl, Direction::Rtl) => true
    (Direction::Mixed, Direction::Mixed) => true
    _ => false
  }
}

///|
pub fn direction_to_string(d : Direction) -> String {
  match d {
    Direction::Ltr => "Ltr"
    Direction::Rtl => "Rtl"
    Direction::Mixed => "Mixed"
  }
}

///| Half-open UTF-8 byte range `[start, end)`.
pub val struct TextRange {
  pub start : Int
  pub end : Int
}

///|
pub fn TextRange::new(start : Int, end : Int) -> TextRange {
  TextRange::{ start: start, end: end }
}

///|
pub fn TextRange::len(self : TextRange) -> Int {
  self.end - self.start
}

///|
pub fn TextRange::is_empty(self : TextRange) -> Bool {
  self.end <= self.start
}

///|
pub fn TextRange::eq(self : TextRange, other : TextRange) -> Bool {
  self.start == other.start && self.end == other.end
}

///| Paragraph boundaries (UTF-8 byte range) and base embedding level.
pub val struct ParagraphInfo {
  pub range : TextRange
  pub level : Level
}

///|
pub fn ParagraphInfo::len(self : ParagraphInfo) -> Int {
  self.range.len()
}

///| Full resolved UAX #9 bidirectional analysis for a UTF-8 string.
///| `original_classes` and `levels` are indexed by UTF-8 byte offset
///| (multi-byte code points repeat their class/level across all of their bytes,
///| matching Rust `unicode-bidi`).
pub struct BidiInfo {
  pub text : String
  pub original_classes : Array[BidiClass]
  pub levels : Array[Level]
  pub paragraphs : Array[ParagraphInfo]
}
