///| UAX #9 §3.4 Reordering Resolved Levels (Rules L1, L2, L4).

///| Zero-allocation check whether Rule L1 modifies any level in `[line_start, line_end)` using compact `level_bytes`.
fn l1_needs_change_bytes(
  orig_classes : Array[BidiClass],
  level_bytes : FixedArray[Byte],
  line_start : Int,
  line_end : Int,
  para_v : Byte,
) -> Bool {
  let mut reset_from = line_start
  let mut has_reset_from = true
  let mut reset_to = -1
  let mut prev_v = para_v

  let mut i = line_start
  while i < line_end {
    match orig_classes[i] {
      BidiClass::B | BidiClass::S => {
        reset_to = i + 1
        if !has_reset_from {
          reset_from = i
          has_reset_from = true
        }
      }
      BidiClass::WS | BidiClass::FSI | BidiClass::LRI | BidiClass::RLI | BidiClass::PDI => {
        if !has_reset_from {
          reset_from = i
          has_reset_from = true
        }
      }
      BidiClass::BN | BidiClass::LRE | BidiClass::LRO | BidiClass::PDF | BidiClass::RLE |
      BidiClass::RLO => {
        if !has_reset_from {
          reset_from = i
          has_reset_from = true
        }
        if level_bytes[i] != prev_v {
          return true
        }
      }
      _ => has_reset_from = false
    }

    if has_reset_from && reset_to >= 0 {
      let mut k = reset_from
      while k < reset_to {
        if level_bytes[k] != para_v {
          return true
        }
        k = k + 1
      }
      has_reset_from = false
      reset_to = -1
    }

    prev_v = level_bytes[i]
    i = i + 1
  }

  if has_reset_from {
    let mut k = reset_from
    while k < line_end {
      if level_bytes[k] != para_v {
        return true
      }
      k = k + 1
    }
  }
  false
}

///| Compute L2 visual runs for `line = [line_start, line_end)` directly from full `level_bytes` (zero RC overhead).
fn visual_runs_from_bytes(
  level_bytes : FixedArray[Byte],
  line_start : Int,
  line_end : Int,
) -> Array[TextRange] {
  if line_start >= line_end || line_start < 0 || line_end > level_bytes.length() {
    return Array::new()
  }
  let runs : Array[TextRange] = Array::with_capacity(8)

  let mut start = line_start
  let mut run_level = level_bytes[start].to_int()
  let mut min_level = run_level
  let mut max_level = run_level

  let mut i = start + 1
  while i < line_end {
    let nl = level_bytes[i].to_int()
    if nl != run_level {
      runs.push(TextRange::{ start: start, end: i })
      start = i
      run_level = nl
      if run_level < min_level {
        min_level = run_level
      }
      if run_level > max_level {
        max_level = run_level
      }
    }
    i = i + 1
  }
  runs.push(TextRange::{ start: start, end: line_end })

  let run_count = runs.length()
  let min_odd = min_level | 1
  let mut cur_max = max_level
  while cur_max >= min_odd {
    let mut seq_start = 0
    while seq_start < run_count {
      if level_bytes[runs[seq_start].start].to_int() < cur_max {
        seq_start = seq_start + 1
        continue
      }
      let mut seq_end = seq_start + 1
      while seq_end < run_count {
        if level_bytes[runs[seq_end].start].to_int() < cur_max {
          break
        }
        seq_end = seq_end + 1
      }
      let mut lo = seq_start
      let mut hi = seq_end - 1
      while lo < hi {
        let tmp = runs[lo]
        runs[lo] = runs[hi]
        runs[hi] = tmp
        lo = lo + 1
        hi = hi - 1
      }
      seq_start = seq_end
    }
    cur_max = cur_max - 1
  }

  runs
}

///| Write reversed RTL run `text[run_start..run_end)` into `out` starting at `out_pos` (no mirroring).
///| Returns the updated `out_pos`. Zero C runtime calls!
fn write_reversed_rtl_run_bytes(
  out : Bytes,
  out_pos : Int,
  text : String,
  run_start : Int,
  run_end : Int,
) -> Int {
  let mut dst = out_pos
  let mut end = run_end
  while end > run_start {
    let b_last = text.code_unit_at(end - 1)
    if b_last < 0x80 {
      out[dst] = b_last.to_byte()
      dst = dst + 1
      end = end - 1
    } else if (b_last & 0xC0) == 0x80 {
      if end - 2 >= run_start {
        let b0 = text.code_unit_at(end - 2)
        if (b0 & 0xE0) == 0xC0 {
          out[dst] = b0.to_byte()
          out[dst + 1] = b_last.to_byte()
          dst = dst + 2
          end = end - 2
          continue
        }
        if (b0 & 0xC0) == 0x80 && end - 3 >= run_start {
          let bm2 = text.code_unit_at(end - 3)
          if (bm2 & 0xF0) == 0xE0 {
            out[dst] = bm2.to_byte()
            out[dst + 1] = b0.to_byte()
            out[dst + 2] = b_last.to_byte()
            dst = dst + 3
            end = end - 3
            continue
          }
          if (bm2 & 0xC0) == 0x80 && end - 4 >= run_start {
            let bm3 = text.code_unit_at(end - 4)
            if (bm3 & 0xF8) == 0xF0 {
              out[dst] = bm3.to_byte()
              out[dst + 1] = bm2.to_byte()
              out[dst + 2] = b0.to_byte()
              out[dst + 3] = b_last.to_byte()
              dst = dst + 4
              end = end - 4
              continue
            }
          }
        }
      }
      out[dst] = b_last.to_byte()
      dst = dst + 1
      end = end - 1
    } else {
      out[dst] = b_last.to_byte()
      dst = dst + 1
      end = end - 1
    }
  }
  dst
}

///| Reorder `text[line_start..line_end)` directly using full `level_bytes` and L2 `runs` (zero L1 copy, zero RC).
fn reorder_line_from_bytes(
  text : String,
  line_start : Int,
  line_end : Int,
  level_bytes : FixedArray[Byte],
  runs : Array[TextRange],
  apply_mirroring : Bool,
) -> String {
  let n_runs = runs.length()
  if !apply_mirroring {
    let out = Bytes::new(line_end - line_start)
    let mut dst = 0
    let mut ri = 0
    while ri < n_runs {
      let run = runs[ri]
      if (level_bytes[run.start].to_int() & 1) == 1 {
        dst = write_reversed_rtl_run_bytes(out, dst, text, run.start, run.end)
      } else {
        let mut s = run.start
        let e = run.end
        while s < e {
          out[dst] = text.code_unit_at(s).to_byte()
          dst = dst + 1
          s = s + 1
        }
      }
      ri = ri + 1
    }
    return out.to_string()
  }
  let sb = StringBuilder::with_capacity(line_end - line_start)
  let mut ri = 0
  while ri < n_runs {
    let run = runs[ri]
    if (level_bytes[run.start].to_int() & 1) == 1 {
      write_reversed_rtl_run(sb, text, run.start, run.end, true)
    } else {
      write_text_slice(sb, text, run.start, run.end)
    }
    ri = ri + 1
  }
  sb.to_string()
}

///| Zero-allocation check whether Rule L1 modifies any level in `[line_start, line_end)`.
fn l1_needs_change(
  orig_classes : Array[BidiClass],
  levels : Array[Level],
  line_start : Int,
  line_end : Int,
  para_level : Level,
) -> Bool {
  let para_v = para_level.value
  let mut reset_from = line_start
  let mut has_reset_from = true
  let mut reset_to = -1
  let mut prev_v = para_v

  let mut i = line_start
  while i < line_end {
    match orig_classes[i] {
      BidiClass::B | BidiClass::S => {
        reset_to = i + 1
        if !has_reset_from {
          reset_from = i
          has_reset_from = true
        }
      }
      BidiClass::WS | BidiClass::FSI | BidiClass::LRI | BidiClass::RLI | BidiClass::PDI => {
        if !has_reset_from {
          reset_from = i
          has_reset_from = true
        }
      }
      BidiClass::BN | BidiClass::LRE | BidiClass::LRO | BidiClass::PDF | BidiClass::RLE |
      BidiClass::RLO => {
        if !has_reset_from {
          reset_from = i
          has_reset_from = true
        }
        if levels[i].value != prev_v {
          return true
        }
      }
      _ => has_reset_from = false
    }

    if has_reset_from && reset_to >= 0 {
      let mut k = reset_from
      while k < reset_to {
        if levels[k].value != para_v {
          return true
        }
        k = k + 1
      }
      has_reset_from = false
      reset_to = -1
    }

    prev_v = levels[i].value
    i = i + 1
  }

  if has_reset_from {
    let mut k = reset_from
    while k < line_end {
      if levels[k].value != para_v {
        return true
      }
      k = k + 1
    }
  }
  false
}

///| Apply Rule L1 to `out_levels[line_start..line_end)` in place.
fn reorder_levels_l1(
  text : String,
  orig_classes : Array[BidiClass],
  out_levels : Array[Level],
  line_start : Int,
  line_end : Int,
  para_level : Level,
) -> Unit {
  let text_len = text.length()
  let mut reset_from = line_start
  let mut has_reset_from = true
  let mut reset_to = -1
  let mut prev_level = para_level

  let mut i = line_start
  while i < line_end {
    let b0 = text.code_unit_at(i)
    let step = if b0 < 0x80 {
      1
    } else if (b0 & 0xE0) == 0xC0 && i + 1 < text_len {
      2
    } else if (b0 & 0xF0) == 0xE0 && i + 2 < text_len {
      3
    } else if (b0 & 0xF8) == 0xF0 && i + 3 < text_len {
      4
    } else {
      1
    }
    let tag = bidi_class_to_int(orig_classes[i])

    if tag == tag_b || tag == tag_s {
      reset_to = i + step
      if !has_reset_from {
        reset_from = i
        has_reset_from = true
      }
    } else if tag == tag_ws || tag == tag_fsi || tag == tag_lri || tag == tag_rli ||
    tag == tag_pdi {
      if !has_reset_from {
        reset_from = i
        has_reset_from = true
      }
    } else if removed_by_x9_tag(tag) {
      if !has_reset_from {
        reset_from = i
        has_reset_from = true
      }
      let mut k = 0
      while k < step && i + k < line_end {
        out_levels[i + k] = prev_level
        k = k + 1
      }
    } else {
      has_reset_from = false
    }

    if has_reset_from && reset_to >= 0 {
      let mut k = reset_from
      while k < reset_to && k < line_end {
        out_levels[k] = para_level
        k = k + 1
      }
      has_reset_from = false
      reset_to = -1
    }

    prev_level = out_levels[i]
    i = i + step
  }

  if has_reset_from {
    let mut k = reset_from
    while k < line_end {
      out_levels[k] = para_level
      k = k + 1
    }
  }
}

///| Apply Rule L1 for `[line_start, line_end)` into a line-local `FixedArray[Byte]` of length `line_end - line_start`.
fn reorder_levels_l1_local(
  text : String,
  orig_classes : Array[BidiClass],
  base_levels : Array[Level],
  line_start : Int,
  line_end : Int,
  para_level : Level,
) -> FixedArray[Byte] {
  let len = line_end - line_start
  let out : FixedArray[Byte] = FixedArray::make(len, (0).to_byte())
  let mut ci = 0
  while ci < len {
    out[ci] = base_levels[line_start + ci].value
    ci = ci + 1
  }

  let text_len = text.length()
  let para_b = para_level.value
  let mut reset_from = 0
  let mut has_reset_from = true
  let mut reset_to = -1
  let mut prev_b = para_b

  let mut rel = 0
  while rel < len {
    let abs_i = line_start + rel
    let b0 = text.code_unit_at(abs_i)
    let step = if b0 < 0x80 {
      1
    } else if (b0 & 0xE0) == 0xC0 && abs_i + 1 < text_len {
      2
    } else if (b0 & 0xF0) == 0xE0 && abs_i + 2 < text_len {
      3
    } else if (b0 & 0xF8) == 0xF0 && abs_i + 3 < text_len {
      4
    } else {
      1
    }
    let tag = bidi_class_to_int(orig_classes[abs_i])

    if tag == tag_b || tag == tag_s {
      reset_to = rel + step
      if !has_reset_from {
        reset_from = rel
        has_reset_from = true
      }
    } else if tag == tag_ws || tag == tag_fsi || tag == tag_lri || tag == tag_rli ||
    tag == tag_pdi {
      if !has_reset_from {
        reset_from = rel
        has_reset_from = true
      }
    } else if removed_by_x9_tag(tag) {
      if !has_reset_from {
        reset_from = rel
        has_reset_from = true
      }
      let mut k = 0
      while k < step && rel + k < len {
        out[rel + k] = prev_b
        k = k + 1
      }
    } else {
      has_reset_from = false
    }

    if has_reset_from && reset_to >= 0 {
      let mut k = reset_from
      while k < reset_to && k < len {
        out[k] = para_b
        k = k + 1
      }
      has_reset_from = false
      reset_to = -1
    }

    prev_b = out[rel]
    rel = rel + step
  }

  if has_reset_from {
    let mut k = reset_from
    while k < len {
      out[k] = para_b
      k = k + 1
    }
  }
  out
}

///| Compute L2 visual runs for `line = [line_start, line_end)` given L1-adjusted `levels`.
fn visual_runs_for_line(
  levels : Array[Level],
  line_start : Int,
  line_end : Int,
) -> Array[TextRange] {
  if line_start >= line_end || line_start < 0 || line_end > levels.length() {
    return Array::new()
  }
  let runs : Array[TextRange] = Array::with_capacity(8)

  let mut start = line_start
  let mut run_level = levels[start].number()
  let mut min_level = run_level
  let mut max_level = run_level

  let mut i = start + 1
  while i < line_end {
    let nl = levels[i].number()
    if nl != run_level {
      runs.push(TextRange::{ start: start, end: i })
      start = i
      run_level = nl
      if run_level < min_level {
        min_level = run_level
      }
      if run_level > max_level {
        max_level = run_level
      }
    }
    i = i + 1
  }
  runs.push(TextRange::{ start: start, end: line_end })

  let run_count = runs.length()
  // L2: Stop at lowest odd level.
  let min_odd = min_level | 1
  let mut cur_max = max_level
  while cur_max >= min_odd {
    let mut seq_start = 0
    while seq_start < run_count {
      if levels[runs[seq_start].start].number() < cur_max {
        seq_start = seq_start + 1
        continue
      }
      let mut seq_end = seq_start + 1
      while seq_end < run_count {
        if levels[runs[seq_end].start].number() < cur_max {
          break
        }
        seq_end = seq_end + 1
      }
      // Reverse runs[seq_start..seq_end)
      let mut lo = seq_start
      let mut hi = seq_end - 1
      while lo < hi {
        let tmp = runs[lo]
        runs[lo] = runs[hi]
        runs[hi] = tmp
        lo = lo + 1
        hi = hi - 1
      }
      seq_start = seq_end
    }
    cur_max = cur_max - 1
  }

  runs
}

///| Compute L2 visual runs for `line = [line_start, line_end)` from a line-local `FixedArray[Byte]`.
fn visual_runs_for_local_line(
  local_levels : FixedArray[Byte],
  line_start : Int,
  line_end : Int,
) -> Array[TextRange] {
  let runs : Array[TextRange] = Array::new()
  let len = line_end - line_start
  if len <= 0 {
    return runs
  }

  let mut start = 0
  let mut run_level = local_levels[0].to_int()
  let mut min_level = run_level
  let mut max_level = run_level

  let mut i = 1
  while i < len {
    let nl = local_levels[i].to_int()
    if nl != run_level {
      runs.push(TextRange::{ start: line_start + start, end: line_start + i })
      start = i
      run_level = nl
      if run_level < min_level {
        min_level = run_level
      }
      if run_level > max_level {
        max_level = run_level
      }
    }
    i = i + 1
  }
  runs.push(TextRange::{ start: line_start + start, end: line_end })

  let run_count = runs.length()
  let min_odd = min_level | 1
  let mut cur_max = max_level
  while cur_max >= min_odd {
    let mut seq_start = 0
    while seq_start < run_count {
      if local_levels[runs[seq_start].start - line_start].to_int() < cur_max {
        seq_start = seq_start + 1
        continue
      }
      let mut seq_end = seq_start + 1
      while seq_end < run_count {
        if local_levels[runs[seq_end].start - line_start].to_int() < cur_max {
          break
        }
        seq_end = seq_end + 1
      }
      let mut lo = seq_start
      let mut hi = seq_end - 1
      while lo < hi {
        let tmp = runs[lo]
        runs[lo] = runs[hi]
        runs[hi] = tmp
        lo = lo + 1
        hi = hi - 1
      }
      seq_start = seq_end
    }
    cur_max = cur_max - 1
  }

  runs
}

///| Reorder pre-calculated per-character integer levels via UAX #9 Rule L2.
///| Clamps input levels to `0..=126` to prevent DoS on hostile inputs.
///| Returns `order` where `order[visual_idx] == logical_idx`.
fn reorder_visual_ints(levels : Array[Int]) -> Array[Int] {
  let n = levels.length()
  let order : Array[Int] = Array::with_capacity(n)
  if n == 0 {
    return order
  }

  let clamped : FixedArray[Byte] = FixedArray::make(n, (0).to_byte())
  let mut min_lv = 126
  let mut max_lv = 0
  let mut i = 0
  while i < n {
    order.push(i)
    let raw = levels[i]
    let lv = if raw < 0 { 0 } else if raw > 126 { 126 } else { raw }
    clamped[i] = lv.to_byte()
    if lv < min_lv {
      min_lv = lv
    }
    if lv > max_lv {
      max_lv = lv
    }
    i = i + 1
  }

  if min_lv == max_lv && (min_lv & 1) == 0 {
    return order
  }

  let min_odd = min_lv | 1
  let mut cur_max = max_lv
  while cur_max >= min_odd {
    let mut s = 0
    while s < n {
      if clamped[s].to_int() < cur_max {
        s = s + 1
        continue
      }
      let mut e = s + 1
      while e < n && clamped[e].to_int() >= cur_max {
        e = e + 1
      }
      let mut lo = s
      let mut hi = e - 1
      while lo < hi {
        let tmp = order[lo]
        order[lo] = order[hi]
        order[hi] = tmp
        lo = lo + 1
        hi = hi - 1
      }
      s = e
    }
    cur_max = cur_max - 1
  }

  order
}

///| Emit an RTL run `text[run_start..run_end)` reversed by UTF-8 char boundaries without heap allocations.
fn write_reversed_rtl_run(
  sb : StringBuilder,
  text : String,
  run_start : Int,
  run_end : Int,
  apply_mirroring : Bool,
) -> Unit {
  let mut end = run_end
  while end > run_start {
    let b_last = text.code_unit_at(end - 1)
    if b_last < 0x80 {
      if apply_mirroring && b_last >= 0x28 {
        match bidi_mirroring_glyph(b_last) {
          Some(m) => utf8_write_cp(sb, m)
          None => sb.write_byte(b_last.to_byte())
        }
      } else {
        sb.write_byte(b_last.to_byte())
      }
      end = end - 1
    } else if (b_last & 0xC0) == 0x80 {
      // Try 2-byte UTF-8 first (Hebrew/Arabic common case)
      if end - 2 >= run_start {
        let b0 = text.code_unit_at(end - 2)
        if (b0 & 0xE0) == 0xC0 {
          if apply_mirroring {
            let cp = ((b0 & 0x1F) << 6) | (b_last & 0x3F)
            match bidi_mirroring_glyph(cp) {
              Some(m) => utf8_write_cp(sb, m)
              None => {
                sb.write_byte(b0.to_byte())
                sb.write_byte(b_last.to_byte())
              }
            }
          } else {
            sb.write_byte(b0.to_byte())
            sb.write_byte(b_last.to_byte())
          }
          end = end - 2
          continue
        }
        // Try 3-byte UTF-8
        if (b0 & 0xC0) == 0x80 && end - 3 >= run_start {
          let bm2 = text.code_unit_at(end - 3)
          if (bm2 & 0xF0) == 0xE0 {
            if apply_mirroring {
              let cp = ((bm2 & 0x0F) << 12) | ((b0 & 0x3F) << 6) | (b_last & 0x3F)
              match bidi_mirroring_glyph(cp) {
                Some(m) => utf8_write_cp(sb, m)
                None => {
                  sb.write_byte(bm2.to_byte())
                  sb.write_byte(b0.to_byte())
                  sb.write_byte(b_last.to_byte())
                }
              }
            } else {
              sb.write_byte(bm2.to_byte())
              sb.write_byte(b0.to_byte())
              sb.write_byte(b_last.to_byte())
            }
            end = end - 3
            continue
          }
          // Try 4-byte UTF-8
          if (bm2 & 0xC0) == 0x80 && end - 4 >= run_start {
            let bm3 = text.code_unit_at(end - 4)
            if (bm3 & 0xF8) == 0xF0 {
              if apply_mirroring {
                let cp = ((bm3 & 0x07) << 18) | ((bm2 & 0x3F) << 12) | ((b0 & 0x3F) << 6) | (b_last & 0x3F)
                match bidi_mirroring_glyph(cp) {
                  Some(m) => utf8_write_cp(sb, m)
                  None => {
                    sb.write_byte(bm3.to_byte())
                    sb.write_byte(bm2.to_byte())
                    sb.write_byte(b0.to_byte())
                    sb.write_byte(b_last.to_byte())
                  }
                }
              } else {
                sb.write_byte(bm3.to_byte())
                sb.write_byte(bm2.to_byte())
                sb.write_byte(b0.to_byte())
                sb.write_byte(b_last.to_byte())
              }
              end = end - 4
              continue
            }
          }
        }
      }
      // Stray/invalid continuation byte: preserve exact byte length.
      sb.write_byte(b_last.to_byte())
      end = end - 1
    } else {
      // Stray invalid lead byte at end of run.
      sb.write_byte(b_last.to_byte())
      end = end - 1
    }
  }
}

///| Reorder `text[line_start..line_end)` using line-local L1 `local_levels` and L2 `runs`.
fn reorder_line_from_local(
  text : String,
  line_start : Int,
  line_end : Int,
  local_levels : FixedArray[Byte],
  runs : Array[TextRange],
  apply_mirroring : Bool,
) -> String {
  let n_runs = runs.length()
  let mut any_rtl = false
  let mut r = 0
  while r < n_runs {
    if (local_levels[runs[r].start - line_start].to_int() & 1) == 1 {
      any_rtl = true
      break
    }
    r = r + 1
  }
  if !any_rtl {
    return text.slice(line_start, line_end)
  }

  let sb = StringBuilder::with_capacity(line_end - line_start)
  let mut ri = 0
  while ri < n_runs {
    let run = runs[ri]
    if (local_levels[run.start - line_start].to_int() & 1) == 1 {
      write_reversed_rtl_run(sb, text, run.start, run.end, apply_mirroring)
    } else {
      write_text_slice(sb, text, run.start, run.end)
    }
    ri = ri + 1
  }
  sb.to_string()
}

///| Reorder `text[line_start..line_end)` directly using full `levels` and L2 `runs` (zero L1 copy).
///| Caller guarantees at least one RTL byte exists in `levels[line_start..line_end)`.
fn reorder_line_from_levels(
  text : String,
  line_start : Int,
  line_end : Int,
  levels : Array[Level],
  runs : Array[TextRange],
  apply_mirroring : Bool,
) -> String {
  let n_runs = runs.length()
  let sb = StringBuilder::with_capacity(line_end - line_start)
  let mut ri = 0
  while ri < n_runs {
    let run = runs[ri]
    if levels[run.start].is_rtl() {
      write_reversed_rtl_run(sb, text, run.start, run.end, apply_mirroring)
    } else {
      write_text_slice(sb, text, run.start, run.end)
    }
    ri = ri + 1
  }
  sb.to_string()
}
