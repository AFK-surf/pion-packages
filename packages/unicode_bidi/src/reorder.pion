///| UAX #9 §3.4 Reordering Resolved Levels (Rules L1, L2, L4).

///| Apply Rule L1 to `out_levels[line_start..line_end)` in place.
fn reorder_levels_l1(
  text : String,
  orig_classes : Array[BidiClass],
  out_levels : Array[Level],
  line_start : Int,
  line_end : Int,
  para_level : Level,
) -> Unit {
  let mut reset_from = line_start
  let mut has_reset_from = true
  let mut reset_to = -1
  let mut prev_level = para_level

  let mut i = line_start
  while i < line_end {
    let char_len = utf8_char_len_at(text, i)
    let step = if char_len > 0 { char_len } else { 1 }
    let tag = bidi_class_to_int(orig_classes[i])

    if tag == tag_b || tag == tag_s {
      reset_to = i + step
      if !has_reset_from {
        reset_from = i
        has_reset_from = true
      }
    } else if tag == tag_ws || tag == tag_fsi || tag == tag_lri || tag == tag_rli ||
    tag == tag_pdi {
      if !has_reset_from {
        reset_from = i
        has_reset_from = true
      }
    } else if removed_by_x9_tag(tag) {
      if !has_reset_from {
        reset_from = i
        has_reset_from = true
      }
      let mut k = 0
      while k < step && i + k < line_end {
        out_levels[i + k] = prev_level
        k = k + 1
      }
    } else {
      has_reset_from = false
    }

    if has_reset_from && reset_to >= 0 {
      let mut k = reset_from
      while k < reset_to && k < line_end {
        out_levels[k] = para_level
        k = k + 1
      }
      has_reset_from = false
      reset_to = -1
    }

    prev_level = out_levels[i]
    i = i + step
  }

  if has_reset_from {
    let mut k = reset_from
    while k < line_end {
      out_levels[k] = para_level
      k = k + 1
    }
  }
}

///| Apply Rule L1 for `[line_start, line_end)` into a line-local `Bytes` of length `line_end - line_start`.
fn reorder_levels_l1_local(
  text : String,
  orig_classes : Array[BidiClass],
  base_levels : Array[Level],
  line_start : Int,
  line_end : Int,
  para_level : Level,
) -> Bytes {
  let len = line_end - line_start
  let out = Bytes::new(len)
  let mut ci = 0
  while ci < len {
    out[ci] = base_levels[line_start + ci].value
    ci = ci + 1
  }

  let para_b = para_level.value
  let mut reset_from = 0
  let mut has_reset_from = true
  let mut reset_to = -1
  let mut prev_b = para_b

  let mut rel = 0
  while rel < len {
    let abs_i = line_start + rel
    let char_len = utf8_char_len_at(text, abs_i)
    let step = if char_len > 0 { char_len } else { 1 }
    let tag = bidi_class_to_int(orig_classes[abs_i])

    if tag == tag_b || tag == tag_s {
      reset_to = rel + step
      if !has_reset_from {
        reset_from = rel
        has_reset_from = true
      }
    } else if tag == tag_ws || tag == tag_fsi || tag == tag_lri || tag == tag_rli ||
    tag == tag_pdi {
      if !has_reset_from {
        reset_from = rel
        has_reset_from = true
      }
    } else if removed_by_x9_tag(tag) {
      if !has_reset_from {
        reset_from = rel
        has_reset_from = true
      }
      let mut k = 0
      while k < step && rel + k < len {
        out[rel + k] = prev_b
        k = k + 1
      }
    } else {
      has_reset_from = false
    }

    if has_reset_from && reset_to >= 0 {
      let mut k = reset_from
      while k < reset_to && k < len {
        out[k] = para_b
        k = k + 1
      }
      has_reset_from = false
      reset_to = -1
    }

    prev_b = out[rel]
    rel = rel + step
  }

  if has_reset_from {
    let mut k = reset_from
    while k < len {
      out[k] = para_b
      k = k + 1
    }
  }
  out
}

///| Compute L2 visual runs for `line = [line_start, line_end)` given L1-adjusted `levels`.
fn visual_runs_for_line(
  levels : Array[Level],
  line_start : Int,
  line_end : Int,
) -> Array[TextRange] {
  let runs : Array[TextRange] = Array::new()
  if line_start >= line_end || line_start < 0 || line_end > levels.length() {
    return runs
  }

  let mut start = line_start
  let mut run_level = levels[start].number()
  let mut min_level = run_level
  let mut max_level = run_level

  let mut i = start + 1
  while i < line_end {
    let nl = levels[i].number()
    if nl != run_level {
      runs.push(TextRange::{ start: start, end: i })
      start = i
      run_level = nl
      if run_level < min_level {
        min_level = run_level
      }
      if run_level > max_level {
        max_level = run_level
      }
    }
    i = i + 1
  }
  runs.push(TextRange::{ start: start, end: line_end })

  let run_count = runs.length()
  // L2: Stop at lowest odd level.
  let min_odd = min_level | 1
  let mut cur_max = max_level
  while cur_max >= min_odd {
    let mut seq_start = 0
    while seq_start < run_count {
      if levels[runs[seq_start].start].number() < cur_max {
        seq_start = seq_start + 1
        continue
      }
      let mut seq_end = seq_start + 1
      while seq_end < run_count {
        if levels[runs[seq_end].start].number() < cur_max {
          break
        }
        seq_end = seq_end + 1
      }
      // Reverse runs[seq_start..seq_end)
      let mut lo = seq_start
      let mut hi = seq_end - 1
      while lo < hi {
        let tmp = runs[lo]
        runs[lo] = runs[hi]
        runs[hi] = tmp
        lo = lo + 1
        hi = hi - 1
      }
      seq_start = seq_end
    }
    cur_max = cur_max - 1
  }

  runs
}

///| Compute L2 visual runs for `line = [line_start, line_end)` from a line-local `Bytes`.
fn visual_runs_for_local_line(
  local_levels : Bytes,
  line_start : Int,
  line_end : Int,
) -> Array[TextRange] {
  let runs : Array[TextRange] = Array::new()
  let len = line_end - line_start
  if len <= 0 {
    return runs
  }

  let mut start = 0
  let mut run_level = local_levels[0].to_int()
  let mut min_level = run_level
  let mut max_level = run_level

  let mut i = 1
  while i < len {
    let nl = local_levels[i].to_int()
    if nl != run_level {
      runs.push(TextRange::{ start: line_start + start, end: line_start + i })
      start = i
      run_level = nl
      if run_level < min_level {
        min_level = run_level
      }
      if run_level > max_level {
        max_level = run_level
      }
    }
    i = i + 1
  }
  runs.push(TextRange::{ start: line_start + start, end: line_end })

  let run_count = runs.length()
  let min_odd = min_level | 1
  let mut cur_max = max_level
  while cur_max >= min_odd {
    let mut seq_start = 0
    while seq_start < run_count {
      if local_levels[runs[seq_start].start - line_start].to_int() < cur_max {
        seq_start = seq_start + 1
        continue
      }
      let mut seq_end = seq_start + 1
      while seq_end < run_count {
        if local_levels[runs[seq_end].start - line_start].to_int() < cur_max {
          break
        }
        seq_end = seq_end + 1
      }
      let mut lo = seq_start
      let mut hi = seq_end - 1
      while lo < hi {
        let tmp = runs[lo]
        runs[lo] = runs[hi]
        runs[hi] = tmp
        lo = lo + 1
        hi = hi - 1
      }
      seq_start = seq_end
    }
    cur_max = cur_max - 1
  }

  runs
}

///| Reorder pre-calculated per-character integer levels via UAX #9 Rule L2.
///| Clamps input levels to `0..=126` to prevent DoS on hostile inputs.
///| Returns `order` where `order[visual_idx] == logical_idx`.
fn reorder_visual_ints(levels : Array[Int]) -> Array[Int] {
  let n = levels.length()
  let order : Array[Int] = Array::with_capacity(n)
  if n == 0 {
    return order
  }

  let clamped = Bytes::new(n)
  let mut min_lv = 126
  let mut max_lv = 0
  let mut i = 0
  while i < n {
    order.push(i)
    let raw = levels[i]
    let lv = if raw < 0 { 0 } else if raw > 126 { 126 } else { raw }
    clamped[i] = lv.to_byte()
    if lv < min_lv {
      min_lv = lv
    }
    if lv > max_lv {
      max_lv = lv
    }
    i = i + 1
  }

  if min_lv == max_lv && (min_lv & 1) == 0 {
    return order
  }

  let min_odd = min_lv | 1
  let mut cur_max = max_lv
  while cur_max >= min_odd {
    let mut s = 0
    while s < n {
      if clamped[s].to_int() < cur_max {
        s = s + 1
        continue
      }
      let mut e = s + 1
      while e < n && clamped[e].to_int() >= cur_max {
        e = e + 1
      }
      let mut lo = s
      let mut hi = e - 1
      while lo < hi {
        let tmp = order[lo]
        order[lo] = order[hi]
        order[hi] = tmp
        lo = lo + 1
        hi = hi - 1
      }
      s = e
    }
    cur_max = cur_max - 1
  }

  order
}

///| Reorder `text[line_start..line_end)` using line-local L1 `local_levels` and L2 `runs`.
///| Reverses RTL runs by UTF-8 char boundaries via direct byte copies (no decode/re-encode overhead,
///| and preserves exact byte length for mid-char ranges).
fn reorder_line_from_local(
  text : String,
  line_start : Int,
  line_end : Int,
  local_levels : Bytes,
  runs : Array[TextRange],
  apply_mirroring : Bool,
) -> String {
  let mut any_rtl = false
  let mut r = 0
  while r < runs.length() {
    if (local_levels[runs[r].start - line_start].to_int() & 1) == 1 {
      any_rtl = true
      break
    }
    r = r + 1
  }
  if !any_rtl {
    let sb = StringBuilder::with_capacity(line_end - line_start)
    write_text_slice(sb, text, line_start, line_end)
    return sb.to_string()
  }

  let sb = StringBuilder::with_capacity(line_end - line_start)
  let char_starts : Array[Int] = Array::new()
  let mut ri = 0
  while ri < runs.length() {
    let run = runs[ri]
    if (local_levels[run.start - line_start].to_int() & 1) == 1 {
      char_starts.clear()
      let mut pos = run.start
      while pos < run.end {
        char_starts.push(pos)
        let vlen = utf8_valid_len_in(text, pos, run.end)
        pos = pos + (if vlen > 0 { vlen } else { 1 })
      }
      let mut k = char_starts.length() - 1
      while k >= 0 {
        let cs = char_starts[k]
        let ce = if k + 1 < char_starts.length() { char_starts[k + 1] } else { run.end }
        if apply_mirroring && utf8_valid_len_in(text, cs, ce) == ce - cs {
          let (cp, _) = utf8_decode_at(text, cs)
          match bidi_mirroring_glyph(cp) {
            Some(m) => utf8_write_cp(sb, m)
            None => write_text_slice(sb, text, cs, ce)
          }
        } else {
          write_text_slice(sb, text, cs, ce)
        }
        k = k - 1
      }
    } else {
      write_text_slice(sb, text, run.start, run.end)
    }
    ri = ri + 1
  }
  sb.to_string()
}
