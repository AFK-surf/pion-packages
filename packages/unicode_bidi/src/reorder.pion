///| UAX #9 §3.4 Reordering Resolved Levels (Rules L1, L2, L4).

///| Apply Rule L1 to `out_levels[line_start..line_end)` in place.
fn reorder_levels_l1(
  text : String,
  orig_classes : Array[BidiClass],
  out_levels : Array[Level],
  line_start : Int,
  line_end : Int,
  para_level : Level,
) -> Unit {
  let mut reset_from = line_start
  let mut has_reset_from = true
  let mut reset_to = -1
  let mut prev_level = para_level

  let mut i = line_start
  while i < line_end {
    let char_len = utf8_char_len_at(text, i)
    let step = if char_len > 0 { char_len } else { 1 }
    let tag = bidi_class_to_int(orig_classes[i])

    if tag == tag_b || tag == tag_s {
      reset_to = i + step
      if !has_reset_from {
        reset_from = i
        has_reset_from = true
      }
    } else if tag == tag_ws || tag == tag_fsi || tag == tag_lri || tag == tag_rli ||
    tag == tag_pdi {
      if !has_reset_from {
        reset_from = i
        has_reset_from = true
      }
    } else if removed_by_x9_tag(tag) {
      if !has_reset_from {
        reset_from = i
        has_reset_from = true
      }
      let mut k = 0
      while k < step && i + k < line_end {
        out_levels[i + k] = prev_level
        k = k + 1
      }
    } else {
      has_reset_from = false
    }

    if has_reset_from && reset_to >= 0 {
      let mut k = reset_from
      while k < reset_to && k < line_end {
        out_levels[k] = para_level
        k = k + 1
      }
      has_reset_from = false
      reset_to = -1
    }

    prev_level = out_levels[i]
    i = i + step
  }

  if has_reset_from {
    let mut k = reset_from
    while k < line_end {
      out_levels[k] = para_level
      k = k + 1
    }
  }
}

///| Compute L2 visual runs for `line = [line_start, line_end)` given L1-adjusted `levels`.
fn visual_runs_for_line(
  levels : Array[Level],
  line_start : Int,
  line_end : Int,
) -> Array[TextRange] {
  let runs : Array[TextRange] = Array::new()
  if line_start >= line_end || line_start < 0 || line_end > levels.length() {
    return runs
  }

  let mut start = line_start
  let mut run_level = levels[start].number()
  let mut min_level = run_level
  let mut max_level = run_level

  let mut i = start + 1
  while i < line_end {
    let nl = levels[i].number()
    if nl != run_level {
      runs.push(TextRange::{ start: start, end: i })
      start = i
      run_level = nl
      if run_level < min_level {
        min_level = run_level
      }
      if run_level > max_level {
        max_level = run_level
      }
    }
    i = i + 1
  }
  runs.push(TextRange::{ start: start, end: line_end })

  let run_count = runs.length()
  // L2: Stop at lowest odd level.
  let min_odd = min_level | 1
  let mut cur_max = max_level
  while cur_max >= min_odd {
    let mut seq_start = 0
    while seq_start < run_count {
      if levels[runs[seq_start].start].number() < cur_max {
        seq_start = seq_start + 1
        continue
      }
      let mut seq_end = seq_start + 1
      while seq_end < run_count {
        if levels[runs[seq_end].start].number() < cur_max {
          break
        }
        seq_end = seq_end + 1
      }
      // Reverse runs[seq_start..seq_end)
      let mut lo = seq_start
      let mut hi = seq_end - 1
      while lo < hi {
        let tmp = runs[lo]
        runs[lo] = runs[hi]
        runs[hi] = tmp
        lo = lo + 1
        hi = hi - 1
      }
      seq_start = seq_end
    }
    cur_max = cur_max - 1
  }

  runs
}

///| Reorder pre-calculated per-character integer levels via UAX #9 Rule L2.
///| Returns `order` where `order[visual_idx] == logical_idx`.
fn reorder_visual_ints(levels : Array[Int]) -> Array[Int] {
  let n = levels.length()
  let order : Array[Int] = Array::new()
  if n == 0 {
    return order
  }

  let mut min_lv = levels[0]
  let mut max_lv = levels[0]
  let mut i = 0
  while i < n {
    order.push(i)
    let lv = levels[i]
    if lv < min_lv {
      min_lv = lv
    }
    if lv > max_lv {
      max_lv = lv
    }
    i = i + 1
  }

  if min_lv == max_lv && (min_lv & 1) == 0 {
    return order
  }

  let min_odd = min_lv | 1
  let mut cur_max = max_lv
  while cur_max >= min_odd {
    let mut s = 0
    while s < n {
      if levels[s] < cur_max {
        s = s + 1
        continue
      }
      let mut e = s + 1
      while e < n && levels[e] >= cur_max {
        e = e + 1
      }
      let mut lo = s
      let mut hi = e - 1
      while lo < hi {
        let tmp = order[lo]
        order[lo] = order[hi]
        order[hi] = tmp
        lo = lo + 1
        hi = hi - 1
      }
      s = e
    }
    cur_max = cur_max - 1
  }

  order
}

///| Reorder `text[line_start..line_end)` using L1 `levels` and L2 `runs`.
///| When `apply_mirroring` is true, applies UAX #9 Rule L4 (`bidi_mirroring_glyph`) to RTL runs.
fn reorder_line_from_runs(
  text : String,
  line_start : Int,
  line_end : Int,
  levels : Array[Level],
  runs : Array[TextRange],
  apply_mirroring : Bool,
) -> String {
  let mut any_rtl = false
  let mut r = 0
  while r < runs.length() {
    if levels[runs[r].start].is_rtl() {
      any_rtl = true
      break
    }
    r = r + 1
  }
  if !any_rtl {
    let sb = StringBuilder::with_capacity(line_end - line_start)
    write_text_slice(sb, text, line_start, line_end)
    return sb.to_string()
  }

  let sb = StringBuilder::with_capacity(line_end - line_start)
  let cps : Array[Int] = Array::new()
  let mut ri = 0
  while ri < runs.length() {
    let run = runs[ri]
    if levels[run.start].is_rtl() {
      cps.clear()
      let mut pos = run.start
      while pos < run.end {
        let (cp, len) = utf8_decode_at(text, pos)
        let step = if len > 0 { len } else { 1 }
        cps.push(cp)
        pos = pos + step
      }
      let mut k = cps.length() - 1
      while k >= 0 {
        let cp = cps[k]
        if apply_mirroring {
          match bidi_mirroring_glyph(cp) {
            Some(m) => utf8_write_cp(sb, m)
            None => utf8_write_cp(sb, cp)
          }
        } else {
          utf8_write_cp(sb, cp)
        }
        k = k - 1
      }
    } else {
      write_text_slice(sb, text, run.start, run.end)
    }
    ri = ri + 1
  }
  sb.to_string()
}
