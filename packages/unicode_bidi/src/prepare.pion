///| UAX #9 §3.3.3 Preparations for Implicit Processing (Rules X9–X10, BD13).

///| An Isolating Run Sequence: parallel arrays of paragraph-relative level run bounds + sos/eos tags.
struct IsoRunSeq {
  run_starts : Array[Int]
  run_ends : Array[Int]
  sos : Int
  eos : Int
}

fn find_first_not_x9(
  orig_tags : Array[Int],
  para_start : Int,
  rel_start : Int,
  rel_end : Int,
) -> Int {
  let mut i = rel_start
  while i < rel_end {
    if !removed_by_x9_tag(orig_tags[para_start + i]) {
      return i
    }
    i = i + 1
  }
  -1
}

fn find_last_not_x9(
  orig_tags : Array[Int],
  para_start : Int,
  rel_start : Int,
  rel_end : Int,
) -> Int {
  let mut i = rel_end - 1
  while i >= rel_start {
    if !removed_by_x9_tag(orig_tags[para_start + i]) {
      return i
    }
    i = i - 1
  }
  -1
}

fn max_int(a : Int, b : Int) -> Int {
  if a > b { a } else { b }
}

///| Compute the set of isolating run sequences for paragraph `[para_start, para_end)`.
fn build_isolating_run_sequences(
  para_start : Int,
  para_len : Int,
  para_level : Int,
  orig_tags : Array[Int],
  levels : Array[Int],
  run_starts : Array[Int],
  run_ends : Array[Int],
  has_isolate_controls : Bool,
) -> Array[IsoRunSeq] {
  let out : Array[IsoRunSeq] = Array::new()
  let n_runs = run_starts.length()
  if n_runs == 0 {
    return out
  }

  // Fast path: no isolate controls in paragraph -> each level run is its own IRS.
  if !has_isolate_controls {
    let mut r = 0
    while r < n_runs {
      let rs = run_starts[r]
      let re = run_ends[r]
      let first_idx = find_first_not_x9(orig_tags, para_start, rs, re)
      let seq_level = if first_idx >= 0 {
        levels[para_start + first_idx]
      } else {
        levels[para_start + rs]
      }
      let last_idx = find_last_not_x9(orig_tags, para_start, rs, re)
      let end_level = if last_idx >= 0 {
        levels[para_start + last_idx]
      } else {
        levels[para_start + re - 1]
      }
      let pred_idx = find_last_not_x9(orig_tags, para_start, 0, rs)
      let pred_level = if pred_idx >= 0 {
        levels[para_start + pred_idx]
      } else {
        para_level
      }
      let succ_idx = find_first_not_x9(orig_tags, para_start, re, para_len)
      let succ_level = if succ_idx >= 0 {
        levels[para_start + succ_idx]
      } else {
        para_level
      }
      let s_arr : Array[Int] = [rs]
      let e_arr : Array[Int] = [re]
      out.push(
        IsoRunSeq::{
          run_starts: s_arr,
          run_ends: e_arr,
          sos: level_to_bidi_tag(max_int(seq_level, pred_level)),
          eos: level_to_bidi_tag(max_int(end_level, succ_level)),
        },
      )
      r = r + 1
    }
    return out
  }

  // General BD13 path with isolate controls.
  let finished_starts : Array[Array[Int]] = Array::new()
  let finished_ends : Array[Array[Int]] = Array::new()

  let stack_starts : Array[Array[Int]] = Array::new()
  let stack_ends : Array[Array[Int]] = Array::new()
  stack_starts.push(Array::new())
  stack_ends.push(Array::new())

  let mut r = 0
  while r < n_runs {
    let rs = run_starts[r]
    let re = run_ends[r]
    let start_class = orig_tags[para_start + rs]
    let end_idx = find_last_not_x9(orig_tags, para_start, rs, re)
    let end_class = if end_idx >= 0 { orig_tags[para_start + end_idx] } else { start_class }

    let mut cur_s : Array[Int] = Array::new()
    let mut cur_e : Array[Int] = Array::new()
    if start_class == tag_pdi && stack_starts.length() > 1 {
      match stack_starts.pop() {
        Some(a) => cur_s = a
        None => ()
      }
      match stack_ends.pop() {
        Some(a) => cur_e = a
        None => ()
      }
    }

    cur_s.push(rs)
    cur_e.push(re)

    if is_isolate_initiator_tag(end_class) {
      stack_starts.push(cur_s)
      stack_ends.push(cur_e)
    } else {
      finished_starts.push(cur_s)
      finished_ends.push(cur_e)
    }
    r = r + 1
  }

  // Pop remaining sequences from stack in reverse order.
  let mut si = stack_starts.length() - 1
  while si >= 0 {
    if stack_starts[si].length() > 0 {
      finished_starts.push(stack_starts[si])
      finished_ends.push(stack_ends[si])
    }
    si = si - 1
  }

  // Compute sos & eos for each sequence (X10).
  let mut q = 0
  while q < finished_starts.length() {
    let seq_s = finished_starts[q]
    let seq_e = finished_ends[q]
    let k = seq_s.length()
    let start_of_seq = seq_s[0]
    let end_of_seq = seq_e[k - 1]

    // First non-X9 index in sequence.
    let mut seq_level = levels[para_start + start_of_seq]
    let mut found_first = false
    let mut ri = 0
    while ri < k && !found_first {
      let fi = find_first_not_x9(orig_tags, para_start, seq_s[ri], seq_e[ri])
      if fi >= 0 {
        seq_level = levels[para_start + fi]
        found_first = true
      }
      ri = ri + 1
    }

    // Last non-X9 index in sequence.
    let mut end_level = levels[para_start + end_of_seq - 1]
    let mut found_last = false
    let mut rj = k - 1
    while rj >= 0 && !found_last {
      let li = find_last_not_x9(orig_tags, para_start, seq_s[rj], seq_e[rj])
      if li >= 0 {
        end_level = levels[para_start + li]
        found_last = true
      }
      rj = rj - 1
    }

    let pred_idx = find_last_not_x9(orig_tags, para_start, 0, start_of_seq)
    let pred_level = if pred_idx >= 0 {
      levels[para_start + pred_idx]
    } else {
      para_level
    }

    let last_nr_idx = find_last_not_x9(orig_tags, para_start, 0, end_of_seq)
    let last_non_removed = if last_nr_idx >= 0 {
      orig_tags[para_start + last_nr_idx]
    } else {
      tag_bn
    }

    let succ_level = if is_isolate_initiator_tag(last_non_removed) {
      para_level
    } else {
      let succ_idx = find_first_not_x9(orig_tags, para_start, end_of_seq, para_len)
      if succ_idx >= 0 {
        levels[para_start + succ_idx]
      } else {
        para_level
      }
    }

    out.push(
      IsoRunSeq::{
        run_starts: seq_s,
        run_ends: seq_e,
        sos: level_to_bidi_tag(max_int(seq_level, pred_level)),
        eos: level_to_bidi_tag(max_int(end_level, succ_level)),
      },
    )
    q = q + 1
  }

  out
}
