///| UAX #9 §3.3.3 Preparations for Implicit Processing (Rules X9–X10, BD13).

///| An Isolating Run Sequence: parallel arrays of paragraph-relative level run bounds + sos/eos tags.
struct IsoRunSeq {
  run_starts : Array[Int]
  run_ends : Array[Int]
  sos : Int
  eos : Int
}

fn find_first_not_x9(
  orig_tags : FixedArray[Byte],
  para_start : Int,
  rel_start : Int,
  rel_end : Int,
) -> Int {
  let mut i = rel_start
  while i < rel_end {
    if !removed_by_x9_tag(orig_tags[para_start + i].to_int()) {
      return i
    }
    i = i + 1
  }
  -1
}

fn find_last_not_x9(
  orig_tags : FixedArray[Byte],
  para_start : Int,
  rel_start : Int,
  rel_end : Int,
) -> Int {
  let mut i = rel_end - 1
  while i >= rel_start {
    if !removed_by_x9_tag(orig_tags[para_start + i].to_int()) {
      return i
    }
    i = i - 1
  }
  -1
}

fn max_int(a : Int, b : Int) -> Int {
  if a > b { a } else { b }
}

///| Compute `(sos, eos)` for a single level run `[rs, re)` when the paragraph has no isolate controls.
fn compute_single_run_sos_eos(
  para_start : Int,
  para_len : Int,
  para_level : Int,
  orig_tags : FixedArray[Byte],
  levels : FixedArray[Byte],
  rs : Int,
  re : Int,
  has_x9 : Bool,
) -> (Int, Int) {
  if !has_x9 {
    let seq_level = levels[para_start + rs].to_int()
    let end_level = levels[para_start + re - 1].to_int()
    let pred_level = if rs > 0 { levels[para_start + rs - 1].to_int() } else { para_level }
    let succ_level = if re < para_len { levels[para_start + re].to_int() } else { para_level }
    return (
      level_to_bidi_tag(max_int(seq_level, pred_level)),
      level_to_bidi_tag(max_int(end_level, succ_level)),
    )
  }
  let first_idx = find_first_not_x9(orig_tags, para_start, rs, re)
  let seq_level = if first_idx >= 0 {
    levels[para_start + first_idx].to_int()
  } else {
    levels[para_start + rs].to_int()
  }
  let last_idx = find_last_not_x9(orig_tags, para_start, rs, re)
  let end_level = if last_idx >= 0 {
    levels[para_start + last_idx].to_int()
  } else {
    levels[para_start + re - 1].to_int()
  }
  let pred_idx = find_last_not_x9(orig_tags, para_start, 0, rs)
  let pred_level = if pred_idx >= 0 {
    levels[para_start + pred_idx].to_int()
  } else {
    para_level
  }
  let succ_idx = find_first_not_x9(orig_tags, para_start, re, para_len)
  let succ_level = if succ_idx >= 0 {
    levels[para_start + succ_idx].to_int()
  } else {
    para_level
  }
  (
    level_to_bidi_tag(max_int(seq_level, pred_level)),
    level_to_bidi_tag(max_int(end_level, succ_level)),
  )
}

///| Resolve all isolating run sequences (BD13 + X10 + W1-W7 + N0-N2) for a paragraph with isolates,
///| using a single flat `FixedArray[Int]` for run chains, finished lists, and isolate stack.
fn process_isolating_run_sequences(
  text : String,
  para_start : Int,
  para_len : Int,
  para_level : Int,
  orig_tags : FixedArray[Byte],
  levels : FixedArray[Byte],
  proc_tags : FixedArray[Byte],
  run_starts : Array[Int],
  run_ends : Array[Int],
  max_bracket_depth : Int,
  has_x9 : Bool,
  scratch : BidiScratch,
) -> Unit {
  let n_runs = run_starts.length()
  if n_runs == 0 {
    return
  }

  // Single flat buffer split into 5 slices:
  //   [0 .. n_runs)                : seq_next
  //   [n_runs .. 2*n_runs)         : fin_heads
  //   [2*n_runs .. 3*n_runs)       : fin_tails
  //   [3*n_runs .. 4*n_runs + 1)   : st_head
  //   [4*n_runs + 1 .. 5*n_runs+2) : st_tail
  let off_fh = n_runs
  let off_ft = n_runs * 2
  let off_sh = n_runs * 3
  let off_st = n_runs * 4 + 1
  let buf : FixedArray[Int] = FixedArray::make(n_runs * 5 + 2, -1)

  let mut n_fin = 0
  let mut st_len = 1

  let mut r = 0
  while r < n_runs {
    let rs = run_starts[r]
    let re = run_ends[r]
    let start_class = orig_tags[para_start + rs].to_int()
    let end_class = if !has_x9 {
      orig_tags[para_start + re - 1].to_int()
    } else {
      let end_idx = find_last_not_x9(orig_tags, para_start, rs, re)
      if end_idx >= 0 { orig_tags[para_start + end_idx].to_int() } else { start_class }
    }

    let mut cur_head = r
    if start_class == tag_pdi && st_len > 1 {
      st_len = st_len - 1
      let prev_head = buf[off_sh + st_len]
      let prev_tail = buf[off_st + st_len]
      if prev_head >= 0 {
        buf[prev_tail] = r
        cur_head = prev_head
      }
    }

    if is_isolate_initiator_tag(end_class) {
      buf[off_sh + st_len] = cur_head
      buf[off_st + st_len] = r
      st_len = st_len + 1
    } else {
      buf[off_fh + n_fin] = cur_head
      buf[off_ft + n_fin] = r
      n_fin = n_fin + 1
    }
    r = r + 1
  }

  // Pop remaining sequences from stack in reverse order.
  let mut si = st_len - 1
  while si >= 0 {
    let sh = buf[off_sh + si]
    if sh >= 0 {
      buf[off_fh + n_fin] = sh
      buf[off_ft + n_fin] = buf[off_st + si]
      n_fin = n_fin + 1
    }
    si = si - 1
  }

  // Reusable arrays for multi-run sequences.
  let seq_s = scratch.seq_s
  let seq_e = scratch.seq_e

  // Compute sos & eos (X10) and run W1-W7 + N0-N2 for each sequence.
  let mut q = 0
  while q < n_fin {
    let head_r = buf[off_fh + q]
    let tail_r = buf[off_ft + q]
    let start_of_seq = run_starts[head_r]
    let end_of_seq = run_ends[tail_r]

    let pred_level = if !has_x9 {
      if start_of_seq > 0 { levels[para_start + start_of_seq - 1].to_int() } else { para_level }
    } else {
      let pred_idx = find_last_not_x9(orig_tags, para_start, 0, start_of_seq)
      if pred_idx >= 0 { levels[para_start + pred_idx].to_int() } else { para_level }
    }

    let last_non_removed = if !has_x9 {
      if end_of_seq > 0 { orig_tags[para_start + end_of_seq - 1].to_int() } else { tag_bn }
    } else {
      let last_nr_idx = find_last_not_x9(orig_tags, para_start, 0, end_of_seq)
      if last_nr_idx >= 0 { orig_tags[para_start + last_nr_idx].to_int() } else { tag_bn }
    }

    let succ_level = if is_isolate_initiator_tag(last_non_removed) {
      para_level
    } else if !has_x9 {
      if end_of_seq < para_len { levels[para_start + end_of_seq].to_int() } else { para_level }
    } else {
      let succ_idx = find_first_not_x9(orig_tags, para_start, end_of_seq, para_len)
      if succ_idx >= 0 { levels[para_start + succ_idx].to_int() } else { para_level }
    }

    if buf[head_r] < 0 {
      // Single-run isolating run sequence: zero-allocation fast path!
      let seq_level = if !has_x9 {
        levels[para_start + start_of_seq].to_int()
      } else {
        let fi = find_first_not_x9(orig_tags, para_start, start_of_seq, end_of_seq)
        if fi >= 0 { levels[para_start + fi].to_int() } else { levels[para_start + start_of_seq].to_int() }
      }
      let end_level = if !has_x9 {
        levels[para_start + end_of_seq - 1].to_int()
      } else {
        let li = find_last_not_x9(orig_tags, para_start, start_of_seq, end_of_seq)
        if li >= 0 { levels[para_start + li].to_int() } else { levels[para_start + end_of_seq - 1].to_int() }
      }
      let sos = level_to_bidi_tag(max_int(seq_level, pred_level))
      let eos = level_to_bidi_tag(max_int(end_level, succ_level))
      if !has_x9 {
        let has_on = resolve_weak_single_nox9(
          text,
          para_start + start_of_seq,
          para_start + end_of_seq,
          sos,
          eos,
          proc_tags,
        )
        resolve_neutral_single_nox9(
          text,
          para_start + start_of_seq,
          para_start + end_of_seq,
          seq_level,
          sos,
          eos,
          orig_tags,
          proc_tags,
          max_bracket_depth,
          has_on,
          scratch,
        )
      } else {
        seq_s.clear()
        seq_e.clear()
        seq_s.push(start_of_seq)
        seq_e.push(end_of_seq)
        let seq = IsoRunSeq::{ run_starts: seq_s, run_ends: seq_e, sos: sos, eos: eos }
        let has_on = resolve_weak(text, para_start, seq, proc_tags, scratch)
        resolve_neutral(
          text,
          para_start,
          seq,
          levels,
          orig_tags,
          proc_tags,
          max_bracket_depth,
          has_on,
          scratch,
        )
      }
    } else {
      // Multi-run isolating run sequence: populate reusable seq_s/seq_e.
      seq_s.clear()
      seq_e.clear()
      let mut cur = head_r
      while cur >= 0 {
        seq_s.push(run_starts[cur])
        seq_e.push(run_ends[cur])
        cur = buf[cur]
      }
      let k = seq_s.length()

      let seq_level = if !has_x9 {
        levels[para_start + start_of_seq].to_int()
      } else {
        let mut sl = levels[para_start + start_of_seq].to_int()
        let mut ri = 0
        while ri < k {
          let fi = find_first_not_x9(orig_tags, para_start, seq_s[ri], seq_e[ri])
          if fi >= 0 {
            sl = levels[para_start + fi].to_int()
            break
          }
          ri = ri + 1
        }
        sl
      }

      let end_level = if !has_x9 {
        levels[para_start + end_of_seq - 1].to_int()
      } else {
        let mut el = levels[para_start + end_of_seq - 1].to_int()
        let mut rj = k - 1
        while rj >= 0 {
          let li = find_last_not_x9(orig_tags, para_start, seq_s[rj], seq_e[rj])
          if li >= 0 {
            el = levels[para_start + li].to_int()
            break
          }
          rj = rj - 1
        }
        el
      }

      let seq = IsoRunSeq::{
        run_starts: seq_s,
        run_ends: seq_e,
        sos: level_to_bidi_tag(max_int(seq_level, pred_level)),
        eos: level_to_bidi_tag(max_int(end_level, succ_level)),
      }
      let has_on = resolve_weak(text, para_start, seq, proc_tags, scratch)
      resolve_neutral(
        text,
        para_start,
        seq,
        levels,
        orig_tags,
        proc_tags,
        max_bracket_depth,
        has_on,
        scratch,
      )
    }

    q = q + 1
  }
}
