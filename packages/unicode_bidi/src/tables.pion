///| Internal fast BidiClass integer tag lookup (0..22) for any Unicode scalar value.
fn bidi_class_tag(cp : Int) -> Int {
  if cp < 0 {
    return 9
  }
  if cp < 0x10000 {
    let page = bmp_page_idx[cp >> 8]
    return bmp_page_data.code_unit_at((page << 8) | (cp & 0xFF)) - 65
  }
  if cp > 0x10FFFF {
    return 9
  }
  let mut lo = 0
  let mut hi = smp_range_lo.length() - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    let start = smp_range_lo[mid]
    if cp < start {
      hi = mid - 1
    } else {
      let packed = smp_range_hi_tag[mid]
      let end = packed >> 5
      if cp > end {
        lo = mid + 1
      } else {
        return packed & 31
      }
    }
  }
  9
}

///| Look up the Unicode 16.0.0 `Bidi_Class` of scalar value `cp`.
pub fn bidi_class(cp : Int) -> BidiClass {
  bidi_class_from_int(bidi_class_tag(cp))
}

///| Internal BD16 bracket lookup: returns `(skeleton << 1) | (is_open ? 1 : 0)` or `-1`.
fn bidi_bracket_packed(cp : Int) -> Int {
  if cp < 0x28 {
    return -1
  }
  if cp < 0x80 {
    if cp == 0x28 {
      return (0x28 << 1) | 1
    }
    if cp == 0x29 {
      return 0x28 << 1
    }
    if cp == 0x5B {
      return (0x5B << 1) | 1
    }
    if cp == 0x5D {
      return 0x5B << 1
    }
    if cp == 0x7B {
      return (0x7B << 1) | 1
    }
    if cp == 0x7D {
      return 0x7B << 1
    }
    return -1
  }
  let mut lo = 0
  let mut hi = bracket_cps.length() - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    let c = bracket_cps[mid]
    if cp < c {
      hi = mid - 1
    } else if cp > c {
      lo = mid + 1
    } else {
      return bracket_packed[mid]
    }
  }
  -1
}

///| Look up BD16 paired bracket info for `cp`, returning `Some((opening_skeleton, is_open))`.
pub fn bidi_matched_opening_bracket(cp : Int) -> Option[(Int, Bool)] {
  let p = bidi_bracket_packed(cp)
  if p < 0 {
    None
  } else {
    Some((p >> 1, (p & 1) == 1))
  }
}

///| Look up UAX #9 Rule L4 `Bidi_Mirroring_Glyph` for `cp`.
pub fn bidi_mirroring_glyph(cp : Int) -> Option[Int] {
  if cp < 0x28 {
    return None
  }
  let mut lo = 0
  let mut hi = mirror_src.length() - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    let c = mirror_src[mid]
    if cp < c {
      hi = mid - 1
    } else if cp > c {
      lo = mid + 1
    } else {
      return Some(mirror_dst[mid])
    }
  }
  None
}
