///| Fast internal lookup returning the compact `BidiClass` integer tag (0..22).
fn bidi_class_tag(cp : Int) -> Int {
  if cp >= 0 && cp < 128 {
    return ascii_bidi_tags[cp]
  }
  if cp < 0 || cp > 0x10FFFF {
    return 9
  }
  let mut lo = 0
  let mut hi = bidi_range_lo.length() - 1
  while lo <= hi {
    let mid = lo + ((hi - lo) >> 1)
    let r_lo = bidi_range_lo[mid]
    if cp < r_lo {
      hi = mid - 1
    } else {
      let packed = bidi_range_hi_tag[mid]
      let r_hi = packed >> 5
      if cp > r_hi {
        lo = mid + 1
      } else {
        return packed & 31
      }
    }
  }
  // UCD DerivedBidiClass.txt: unlisted code points default to L (9).
  9
}

///| Look up the Unicode `Bidi_Class` for a scalar value `cp`.
pub fn bidi_class(cp : Int) -> BidiClass {
  bidi_class_from_int(bidi_class_tag(cp))
}

///| Fast internal bracket lookup: returns `(skeleton_cp << 1) | is_open`, or `-1` if not a bracket.
fn bidi_bracket_packed(cp : Int) -> Int {
  if cp < 0x0028 || cp > 0xFF63 {
    return -1
  }
  let mut lo = 0
  let mut hi = bracket_cp.length() - 1
  while lo <= hi {
    let mid = lo + ((hi - lo) >> 1)
    let v = bracket_cp[mid]
    if cp == v {
      return bracket_skel_open[mid]
    } else if cp < v {
      hi = mid - 1
    } else {
      lo = mid + 1
    }
  }
  -1
}

///| Look up BD16 `BidiBrackets` entry: `Some((canonical_opening_cp, is_open))` or `None`.
pub fn bidi_matched_opening_bracket(cp : Int) -> Option[(Int, Bool)] {
  let packed = bidi_bracket_packed(cp)
  if packed < 0 {
    None
  } else {
    Some((packed >> 1, (packed & 1) == 1))
  }
}

///| Look up the Unicode `Bidi_Mirroring_Glyph` for a scalar value `cp` (UAX #9 L4).
pub fn bidi_mirroring_glyph(cp : Int) -> Option[Int] {
  if cp < 0x0028 || cp > 0xFF63 {
    return None
  }
  let mut lo = 0
  let mut hi = mirror_from.length() - 1
  while lo <= hi {
    let mid = lo + ((hi - lo) >> 1)
    let v = mirror_from[mid]
    if cp == v {
      return Some(mirror_to[mid])
    } else if cp < v {
      hi = mid - 1
    } else {
      lo = mid + 1
    }
  }
  None
}
