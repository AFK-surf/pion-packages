///| Unicode UAX #9 Bidirectional Algorithm compliance & unit test suite.
///| Ported from Unicode UAX #9 / `servo/unicode-bidi` / `unicode-bidi-mirroring`.

fn assert_int_eq(actual : Int, expected : Int, ctx : String) -> Unit {
  debug_assert(
    actual == expected,
    ctx + ": expected " + expected.to_string() + ", got " + actual.to_string(),
  )
}

fn assert_str_eq(actual : String, expected : String, ctx : String) -> Unit {
  debug_assert(
    actual == expected,
    ctx + ": expected '" + expected + "', got '" + actual + "'",
  )
}

fn assert_class_eq(actual : BidiClass, expected : BidiClass, ctx : String) -> Unit {
  debug_assert(
    bidi_class_eq(actual, expected),
    ctx + ": expected " + bidi_class_to_string(expected) + ", got " + bidi_class_to_string(actual),
  )
}

fn assert_dir_eq(actual : Direction, expected : Direction, ctx : String) -> Unit {
  debug_assert(
    direction_eq(actual, expected),
    ctx + ": expected " + direction_to_string(expected) + ", got " + direction_to_string(actual),
  )
}

fn assert_levels_eq(actual : Array[Level], expected : Array[Int], ctx : String) -> Unit {
  assert_int_eq(actual.length(), expected.length(), ctx + " length")
  let mut i = 0
  while i < expected.length() {
    assert_int_eq(actual[i].number(), expected[i], ctx + "[" + i.to_string() + "]")
    i = i + 1
  }
}

fn assert_ints_eq(actual : Array[Int], expected : Array[Int], ctx : String) -> Unit {
  assert_int_eq(actual.length(), expected.length(), ctx + " length")
  let mut i = 0
  while i < expected.length() {
    assert_int_eq(actual[i], expected[i], ctx + "[" + i.to_string() + "]")
    i = i + 1
  }
}

test "bidi_class_ascii_bmp_smp_controls" {
  // ASCII
  assert_class_eq(bidi_class(0x0000), BidiClass::BN, "NUL")
  assert_class_eq(bidi_class(0x0009), BidiClass::S, "TAB")
  assert_class_eq(bidi_class(0x000A), BidiClass::B, "LF")
  assert_class_eq(bidi_class(0x000D), BidiClass::B, "CR")
  assert_class_eq(bidi_class(0x0020), BidiClass::WS, "SPACE")
  assert_class_eq(bidi_class(0x0023), BidiClass::ET, "HASH")
  assert_class_eq(bidi_class(0x002B), BidiClass::ES, "PLUS")
  assert_class_eq(bidi_class(0x002C), BidiClass::CS, "COMMA")
  assert_class_eq(bidi_class(0x0030), BidiClass::EN, "DIGIT0")
  assert_class_eq(bidi_class(0x0040), BidiClass::ON, "AT")
  assert_class_eq(bidi_class(0x0041), BidiClass::L, "A")
  assert_class_eq(bidi_class(0x0062), BidiClass::L, "b")
  assert_class_eq(bidi_class(0x007F), BidiClass::BN, "DEL")

  // Hebrew (R)
  assert_class_eq(bidi_class(0x0590), BidiClass::R, "U+0590")
  assert_class_eq(bidi_class(0x05D0), BidiClass::R, "Alef")
  assert_class_eq(bidi_class(0x05FF), BidiClass::R, "U+05FF")

  // Arabic (AL, AN, NSM)
  assert_class_eq(bidi_class(0x0600), BidiClass::AN, "U+0600")
  assert_class_eq(bidi_class(0x0627), BidiClass::AL, "Arabic Alef")
  assert_class_eq(bidi_class(0x0660), BidiClass::AN, "Arabic-Indic 0")
  assert_class_eq(bidi_class(0x06F0), BidiClass::EN, "Extended Arabic-Indic 0")
  assert_class_eq(bidi_class(0x089F), BidiClass::NSM, "U+089F")

  // Explicit formatting controls
  assert_class_eq(bidi_class(0x202A), BidiClass::LRE, "LRE")
  assert_class_eq(bidi_class(0x202B), BidiClass::RLE, "RLE")
  assert_class_eq(bidi_class(0x202C), BidiClass::PDF, "PDF")
  assert_class_eq(bidi_class(0x202D), BidiClass::LRO, "LRO")
  assert_class_eq(bidi_class(0x202E), BidiClass::RLO, "RLO")
  assert_class_eq(bidi_class(0x2066), BidiClass::LRI, "LRI")
  assert_class_eq(bidi_class(0x2067), BidiClass::RLI, "RLI")
  assert_class_eq(bidi_class(0x2068), BidiClass::FSI, "FSI")
  assert_class_eq(bidi_class(0x2069), BidiClass::PDI, "PDI")

  // CJK (L) & SMP (Kharoshthi R, Cuneiform L, Adlam R)
  assert_class_eq(bidi_class(0x4E2D), BidiClass::L, "CJK")
  assert_class_eq(bidi_class(0x10A00), BidiClass::R, "Kharoshthi")
  assert_class_eq(bidi_class(0x12000), BidiClass::L, "Cuneiform")
  assert_class_eq(bidi_class(0x1E900), BidiClass::R, "Adlam")
}

test "bidi_brackets_and_mirroring_tables" {
  // BD16 BidiBrackets
  match bidi_matched_opening_bracket(0x0028) {
    Some((open, is_open)) => {
      assert_int_eq(open, 0x0028, "'(' skeleton")
      debug_assert(is_open, "'(' should be open")
    }
    None => debug_assert(false, "'(' must be a bracket")
  }
  match bidi_matched_opening_bracket(0x0029) {
    Some((open, is_open)) => {
      assert_int_eq(open, 0x0028, "')' skeleton")
      debug_assert(!is_open, "')' should be close")
    }
    None => debug_assert(false, "')' must be a bracket")
  }
  // Canonical equivalence: U+2329 <-> U+3008, U+232A <-> U+3009
  match bidi_matched_opening_bracket(0x2329) {
    Some((open, is_open)) => {
      assert_int_eq(open, 0x3008, "U+2329 canonical skeleton")
      debug_assert(is_open, "U+2329 should be open")
    }
    None => debug_assert(false, "U+2329 must be a bracket")
  }
  match bidi_matched_opening_bracket(0x3009) {
    Some((open, is_open)) => {
      assert_int_eq(open, 0x3008, "U+3009 canonical skeleton")
      debug_assert(!is_open, "U+3009 should be close")
    }
    None => debug_assert(false, "U+3009 must be a bracket")
  }
  match bidi_matched_opening_bracket(0x0041) {
    Some(_) => debug_assert(false, "'A' must not be a bracket")
    None => ()
  }

  // L4 BidiMirroring
  match bidi_mirroring_glyph(0x0028) {
    Some(m) => assert_int_eq(m, 0x0029, "mirror '('")
    None => debug_assert(false, "'(' must mirror")
  }
  match bidi_mirroring_glyph(0x0029) {
    Some(m) => assert_int_eq(m, 0x0028, "mirror ')'")
    None => debug_assert(false, "')' must mirror")
  }
  match bidi_mirroring_glyph(0x003C) {
    Some(m) => assert_int_eq(m, 0x003E, "mirror '<'")
    None => debug_assert(false, "'<' must mirror")
  }
  match bidi_mirroring_glyph(0x2039) {
    Some(m) => assert_int_eq(m, 0x203A, "mirror U+2039")
    None => debug_assert(false, "U+2039 must mirror")
  }
  match bidi_mirroring_glyph(0x0041) {
    Some(_) => debug_assert(false, "'A' must not mirror")
    None => ()
  }
}

test "level_bounds_and_limits" {
  assert_int_eq(Level::max_explicit_depth(), 125, "max explicit")
  assert_int_eq(Level::max_implicit_depth(), 126, "max implicit")
  match Level::new(126) {
    Ok(l) => assert_int_eq(l.number(), 126, "level 126")
    Err(_) => debug_assert(false, "126 should be valid")
  }
  match Level::new(127) {
    Ok(_) => debug_assert(false, "127 should fail")
    Err(_) => ()
  }
  match Level::new_explicit(125) {
    Ok(l) => assert_int_eq(l.number(), 125, "explicit 125")
    Err(_) => debug_assert(false, "explicit 125 should be valid")
  }
  match Level::new_explicit(126) {
    Ok(_) => debug_assert(false, "explicit 126 should fail")
    Err(_) => ()
  }
  let tight = Limits::{ max_input_bytes: 4, max_depth: 125, max_bracket_depth: 63 }
  match BidiInfo::new_with_limits("hello", None, tight) {
    Ok(_) => debug_assert(false, "expected InputTooLong")
    Err(BidiError::InputTooLong(actual, max)) => {
      assert_int_eq(actual, 5, "actual len")
      assert_int_eq(max, 4, "max len")
    }
    Err(_) => debug_assert(false, "wrong error variant")
  }
}

test "p1_p2_p3_paragraphs_and_base_direction" {
  assert_dir_eq(get_base_direction("abc"), Direction::Ltr, "base ltr")
  assert_dir_eq(get_base_direction("\u{05D0}abc"), Direction::Rtl, "base rtl hebrew")
  assert_dir_eq(get_base_direction("\u{0627}abc"), Direction::Rtl, "base rtl arabic")
  assert_dir_eq(get_base_direction("123 !@#"), Direction::Mixed, "base neutral")
  // P2 skips characters inside isolate initiator .. PDI
  assert_dir_eq(
    get_base_direction("\u{2067}\u{05D0}\u{2069}abc"),
    Direction::Ltr,
    "P2 skip RLI isolate",
  )
  assert_dir_eq(
    get_base_direction("\u{2068}\u{05D0}\u{2069}a"),
    Direction::Ltr,
    "P2 skip FSI isolate",
  )
  assert_dir_eq(
    get_base_direction("123\n\u{05D0}"),
    Direction::Mixed,
    "base stops at B",
  )
  assert_dir_eq(
    get_base_direction_full("123\n\u{05D0}"),
    Direction::Rtl,
    "base_full continues past B",
  )

  // Paragraph splitting (P1)
  let info = BidiInfo::new("abc\n\u{05D0}\u{05D1}\u{2029}123", None)
  assert_int_eq(info.paragraphs.length(), 3, "3 paragraphs")
  assert_int_eq(info.paragraphs[0].range.start, 0, "p0 start")
  assert_int_eq(info.paragraphs[0].range.end, 4, "p0 end")
  assert_int_eq(info.paragraphs[0].level.number(), 0, "p0 level")
  assert_int_eq(info.paragraphs[1].range.start, 4, "p1 start")
  assert_int_eq(info.paragraphs[1].range.end, 11, "p1 end")
  assert_int_eq(info.paragraphs[1].level.number(), 1, "p1 level")
  assert_int_eq(info.paragraphs[2].range.start, 11, "p2 start")
  assert_int_eq(info.paragraphs[2].range.end, 14, "p2 end")
  assert_int_eq(info.paragraphs[2].level.number(), 0, "p2 level (P3 default 0)")
}

test "basic_ltr_rtl_mixed_and_reorder" {
  // Pure LTR
  let info0 = BidiInfo::new("abc123", Some(Level::ltr()))
  assert_levels_eq(info0.levels, [0, 0, 0, 0, 0, 0], "pure ltr levels")
  debug_assert(!info0.has_rtl(), "pure ltr has_rtl == false")
  assert_str_eq(
    info0.reorder_line(info0.paragraphs[0], info0.paragraphs[0].range),
    "abc123",
    "pure ltr reorder",
  )

  // Hebrew + Latin (auto RTL paragraph)
  let text = "\u{05D0}\u{05D1}\u{05D2}abc"
  let info1 = BidiInfo::new(text, None)
  assert_int_eq(info1.paragraphs.length(), 1, "1 para")
  assert_int_eq(info1.paragraphs[0].level.number(), 1, "auto rtl para level")
  assert_levels_eq(
    info1.reordered_levels_per_char(info1.paragraphs[0], info1.paragraphs[0].range),
    [1, 1, 1, 2, 2, 2],
    "hebrew+latin per-char levels",
  )
  assert_str_eq(
    info1.reorder_line(info1.paragraphs[0], info1.paragraphs[0].range),
    "abc\u{05D2}\u{05D1}\u{05D0}",
    "hebrew+latin visual order",
  )

  // Latin + Hebrew in LTR paragraph
  let text2 = "abc \u{05D0}\u{05D1}\u{05D2}"
  let info2 = BidiInfo::new(text2, Some(Level::ltr()))
  assert_levels_eq(
    info2.reordered_levels_per_char(info2.paragraphs[0], info2.paragraphs[0].range),
    [0, 0, 0, 0, 1, 1, 1],
    "ltr para latin+hebrew",
  )
  assert_str_eq(
    info2.reorder_line(info2.paragraphs[0], info2.paragraphs[0].range),
    "abc \u{05D2}\u{05D1}\u{05D0}",
    "ltr para reorder",
  )

  // Same text in RTL paragraph
  let info3 = BidiInfo::new(text2, Some(Level::rtl()))
  assert_levels_eq(
    info3.reordered_levels_per_char(info3.paragraphs[0], info3.paragraphs[0].range),
    [2, 2, 2, 1, 1, 1, 1],
    "rtl para latin+hebrew",
  )
  assert_str_eq(
    info3.reorder_line(info3.paragraphs[0], info3.paragraphs[0].range),
    "\u{05D2}\u{05D1}\u{05D0} abc",
    "rtl para reorder",
  )
}

test "w1_to_w7_weak_types" {
  // W2 + W3: Arabic letter (AL) followed by European Number (EN) -> AN -> level 2 in RTL
  // "\u{0627}123" -> AL EN EN EN -> R AN AN AN -> levels [1, 2, 2, 2]
  let info_ar = BidiInfo::new("\u{0627}123", None)
  assert_levels_eq(
    info_ar.reordered_levels_per_char(info_ar.paragraphs[0], info_ar.paragraphs[0].range),
    [1, 2, 2, 2],
    "W2/W3 Arabic + EN",
  )
  assert_str_eq(
    info_ar.reorder_line(info_ar.paragraphs[0], info_ar.paragraphs[0].range),
    "123\u{0627}",
    "Arabic + EN visual",
  )

  // W4 + W5: EN ES EN and ET adjacent to EN in RTL paragraph
  // "\u{05D0} $12+34" -> Hebrew R, WS, ET($)->EN, EN, EN, ES(+)->EN, EN, EN
  let info_num = BidiInfo::new("\u{05D0} $12+34", Some(Level::rtl()))
  assert_levels_eq(
    info_num.reordered_levels_per_char(info_num.paragraphs[0], info_num.paragraphs[0].range),
    [1, 1, 2, 2, 2, 2, 2, 2],
    "W4/W5 $12+34 in RTL",
  )
  assert_str_eq(
    info_num.reorder_line(info_num.paragraphs[0], info_num.paragraphs[0].range),
    "$12+34 \u{05D0}",
    "W4/W5 visual",
  )

  // W7: L followed by EN in RTL paragraph -> EN becomes L (level 2)
  let info_w7 = BidiInfo::new("a1", Some(Level::rtl()))
  assert_levels_eq(
    info_w7.reordered_levels_per_char(info_w7.paragraphs[0], info_w7.paragraphs[0].range),
    [2, 2],
    "W7 L+EN in RTL",
  )

  // W1: NSM takes previous class; after isolate initiator becomes ON
  let info_nsm = BidiInfo::new("\u{05D0}\u{0300}a", Some(Level::ltr()))
  assert_levels_eq(
    info_nsm.reordered_levels_per_char(info_nsm.paragraphs[0], info_nsm.paragraphs[0].range),
    [1, 1, 0],
    "W1 NSM after R",
  )
}

test "x1_to_x10_explicit_embeddings_overrides_isolates_and_depth_125" {
  // RLO override: forces LTR chars to RTL; trailing PDF resets to para level (0) under L1
  let rlo = "\u{202E}abc\u{202C}"
  let info_rlo = BidiInfo::new(rlo, Some(Level::ltr()))
  assert_levels_eq(
    info_rlo.reordered_levels_per_char(info_rlo.paragraphs[0], info_rlo.paragraphs[0].range),
    [0, 1, 1, 1, 0],
    "RLO levels",
  )

  // LRO override inside RTL paragraph; trailing PDF resets to para level (1) under L1
  let lro = "\u{202D}\u{05D0}\u{05D1}\u{202C}"
  let info_lro = BidiInfo::new(lro, Some(Level::rtl()))
  assert_levels_eq(
    info_lro.reordered_levels_per_char(info_lro.paragraphs[0], info_lro.paragraphs[0].range),
    [1, 2, 2, 1],
    "LRO levels in RTL",
  )

  // FSI resolves to RLI when first strong inside is RTL
  let fsi_rtl = "a \u{2068}\u{05D0} 1\u{2069} b"
  let info_fsi = BidiInfo::new(fsi_rtl, Some(Level::ltr()))
  assert_levels_eq(
    info_fsi.reordered_levels_per_char(info_fsi.paragraphs[0], info_fsi.paragraphs[0].range),
    [0, 0, 0, 1, 1, 2, 0, 0, 0],
    "FSI->RLI nested isolate",
  )

  // Nested isolates (BD13 Example 2 style): "a" + RLI + "b" + PDI + RLI + "c" + PDI + "d"
  let nested = "a\u{2067}\u{05D0}\u{2069}\u{2067}\u{05D1}\u{2069}d"
  let info_nested = BidiInfo::new(nested, Some(Level::ltr()))
  assert_levels_eq(
    info_nested.reordered_levels_per_char(
      info_nested.paragraphs[0],
      info_nested.paragraphs[0].range,
    ),
    [0, 0, 1, 0, 0, 1, 0, 0],
    "BD13 nested isolates",
  )

  // Depth 125 overflow & stack-bomb safety: 160 nested RLE/LRE alternating
  let sb = StringBuilder::new()
  let mut k = 0
  while k < 80 {
    sb.write_string("\u{202B}\u{202A}")
    k = k + 1
  }
  sb.write_string("A")
  let mut m = 0
  while m < 160 {
    sb.write_string("\u{202C}")
    m = m + 1
  }
  let deep_text = sb.to_string()
  let info_deep = BidiInfo::new(deep_text, Some(Level::ltr()))
  let mut max_lv = 0
  let mut idx = 0
  while idx < info_deep.levels.length() {
    if info_deep.levels[idx].number() > max_lv {
      max_lv = info_deep.levels[idx].number()
    }
    idx = idx + 1
  }
  debug_assert(max_lv <= 126, "max level must never exceed 126")
  debug_assert(max_lv >= 124, "deep alternating embeddings must reach near MAX_DEPTH")
}

test "n0_paired_brackets_and_63_stack_cap" {
  // N0: In LTR paragraph, "(\u{05D0})" has opposite strong inside and no preceding R -> brackets stay L (0)
  let info_b1 = BidiInfo::new("(\u{05D0})", Some(Level::ltr()))
  assert_levels_eq(
    info_b1.reordered_levels_per_char(info_b1.paragraphs[0], info_b1.paragraphs[0].range),
    [0, 1, 0],
    "N0 LTR para (R) without preceding R",
  )

  // N0: In LTR paragraph, "\u{05D0} (\u{05D1})" has preceding R and R inside -> brackets become R (1)
  let info_b2 = BidiInfo::new("\u{05D0} (\u{05D1})", Some(Level::ltr()))
  assert_levels_eq(
    info_b2.reordered_levels_per_char(info_b2.paragraphs[0], info_b2.paragraphs[0].range),
    [1, 1, 1, 1, 1],
    "N0 LTR para R (R) establishes R context",
  )

  // N0: In RTL paragraph, "(abc)" with preceding L -> brackets become L (2)
  let info_b3 = BidiInfo::new("x (abc)", Some(Level::rtl()))
  assert_levels_eq(
    info_b3.reordered_levels_per_char(info_b3.paragraphs[0], info_b3.paragraphs[0].range),
    [2, 2, 2, 2, 2, 2, 2],
    "N0 RTL para L (L)",
  )

  // N0: 63-deep bracket stack cap (BD16): 70 nested '(' + Hebrew + 70 ')' must not crash
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 70 {
    sb.write_byte((40).to_byte())
    i = i + 1
  }
  sb.write_string("\u{05D0}")
  let mut j = 0
  while j < 70 {
    sb.write_byte((41).to_byte())
    j = j + 1
  }
  let info_b70 = BidiInfo::new(sb.to_string(), Some(Level::ltr()))
  assert_int_eq(info_b70.paragraphs.length(), 1, "70 nested brackets single para")
}

test "l1_l2_l4_trailing_ws_visual_and_mirroring" {
  // L1: trailing spaces reset to paragraph level (LTR = 0)
  let info_ws = BidiInfo::new("\u{05D0}\u{05D1}  ", Some(Level::ltr()))
  assert_levels_eq(
    info_ws.reordered_levels_per_char(info_ws.paragraphs[0], info_ws.paragraphs[0].range),
    [1, 1, 0, 0],
    "L1 trailing spaces reset to LTR para level",
  )
  assert_str_eq(
    info_ws.reorder_line(info_ws.paragraphs[0], info_ws.paragraphs[0].range),
    "\u{05D1}\u{05D0}  ",
    "L1+L2 trailing spaces stay on right in LTR",
  )

  // L2: BidiInfo::reorder_visual
  let lv = [
    Level::ltr(),
    Level::ltr(),
    Level::ltr(),
    Level::rtl(),
    Level::rtl(),
    Level::rtl(),
    Level::new(2).unwrap_or(Level::ltr()),
    Level::new(2).unwrap_or(Level::ltr()),
  ]
  assert_ints_eq(BidiInfo::reorder_visual(lv), [0, 1, 2, 6, 7, 5, 4, 3], "reorder_visual")

  // L4: Mirroring in RTL run: "\u{05D0}(\u{05D1})" in RTL para -> all level 1
  // Logical: Alef ( Bet ) -> Reversed: ) Bet ( Alef -> Mirrored: ( Bet ) Alef
  let info_m = BidiInfo::new("\u{05D0}(\u{05D1})", Some(Level::rtl()))
  assert_str_eq(
    info_m.reorder_line(info_m.paragraphs[0], info_m.paragraphs[0].range),
    ")\u{05D1}(\u{05D0}",
    "reorder_line without mirroring",
  )
  assert_str_eq(
    info_m.reorder_line_with_mirroring(info_m.paragraphs[0], info_m.paragraphs[0].range),
    "(\u{05D1})\u{05D0}",
    "reorder_line_with_mirroring applies L4",
  )

  // Mixed Arabic + Hebrew + Latin + CJK
  let mixed = "\u{4E2D}\u{6587} \u{0645}\u{0631}\u{062D}\u{0628}\u{0627} hello \u{05E9}\u{05DC}\u{05D5}\u{05DD}"
  let info_mix = BidiInfo::new(mixed, Some(Level::ltr()))
  assert_int_eq(info_mix.paragraphs.length(), 1, "mixed single para")
  debug_assert(info_mix.has_rtl(), "mixed has rtl")
  assert_dir_eq(
    info_mix.paragraph_direction(info_mix.paragraphs[0]),
    Direction::Mixed,
    "mixed direction",
  )
}

test "compat_bidi_line_levels_and_visual_order" {
  // base_dir = 0 (LTR)
  let lv0 = bidi_line_levels("abc \u{05D0}\u{05D1}\u{05D2}", 0)
  assert_ints_eq(lv0, [0, 0, 0, 0, 1, 1, 1], "bidi_line_levels LTR")
  assert_ints_eq(bidi_visual_order(lv0), [0, 1, 2, 3, 6, 5, 4], "bidi_visual_order LTR")

  // base_dir = 1 (RTL)
  let lv1 = bidi_line_levels("abc \u{05D0}\u{05D1}\u{05D2}", 1)
  assert_ints_eq(lv1, [2, 2, 2, 1, 1, 1, 1], "bidi_line_levels RTL")
  assert_ints_eq(bidi_visual_order(lv1), [6, 5, 4, 3, 0, 1, 2], "bidi_visual_order RTL")

  // Multi-paragraph L1 reset uses each paragraph's own base level
  let lv_multi = bidi_line_levels("a\n\u{05D0} ", -1)
  assert_ints_eq(lv_multi, [0, 0, 1, 1], "bidi_line_levels multi-paragraph L1")

  // Hostile out-of-range integer levels are clamped to 0..=126 (no DoS)
  assert_ints_eq(bidi_visual_order([0, 2000000000]), [0, 1], "bidi_visual_order huge int")
  assert_ints_eq(bidi_visual_order([-2000000000, 1]), [0, 1], "bidi_visual_order neg huge int")
}

test "uax9_ucd16_conformance_and_redteam_regressions" {
  // UCD 16.0.0 DerivedBidiClass @missing defaults & noncharacters
  assert_class_eq(bidi_class(0x2065), BidiClass::BN, "U+2065 BN")
  assert_class_eq(bidi_class(0xFDD0), BidiClass::BN, "U+FDD0 BN")
  assert_class_eq(bidi_class(0xFFFF), BidiClass::BN, "U+FFFF BN")
  assert_class_eq(bidi_class(0x10FFFF), BidiClass::BN, "U+10FFFF BN")
  assert_class_eq(bidi_class(0xE0000), BidiClass::BN, "U+E0000 BN")
  assert_class_eq(bidi_class(0x086B), BidiClass::AL, "U+086B AL @missing")
  assert_class_eq(bidi_class(0x10EC0), BidiClass::AL, "U+10EC0 AL @missing")
  assert_class_eq(bidi_class(0x1EC70), BidiClass::AL, "U+1EC70 AL @missing")

  // P2 skips leading BN noncharacter U+FFFF
  let info_nc = BidiInfo::new("\u{FFFF}\u{05D0}\u{05D1}", None)
  assert_int_eq(info_nc.paragraphs[0].level.number(), 1, "U+FFFF skipped by P2")

  // BD16 rev 50: stack overflow (>63 opens) must discard ALL earlier pairs in the IRS
  let sb = StringBuilder::new()
  sb.write_string("\u{05D0}(\u{05D1})")
  let mut k = 0
  while k < 64 {
    sb.write_string("(")
    k = k + 1
  }
  let info_bd16 = BidiInfo::new(sb.to_string(), Some(Level::ltr()))
  assert_int_eq(info_bd16.levels[2].number(), 1, "open paren between R and R stays R")
  assert_int_eq(info_bd16.levels[5].number(), 0, "close paren drops to 0 after BD16 overflow")

  // N0 previous-strong scan across isolate-split level runs (matches ICU4C & UAX #9)
  let info_n0 = BidiInfo::new("a\u{05D0}\u{2066}x\u{2069}(\u{05D1})", Some(Level::ltr()))
  assert_int_eq(info_n0.levels[10].number(), 1, "N0 open paren across isolate run")
  assert_int_eq(info_n0.levels[13].number(), 1, "N0 close paren across isolate run")

  // Level 126 rejected by new_with_limits and safely clamped by total BidiInfo::new
  let lv126 = Level::new(126).unwrap_or(Level::ltr())
  match BidiInfo::new_with_limits("a\u{05D0}1", Some(lv126), Limits::default()) {
    Ok(_) => debug_assert(false, "new_with_limits must reject default_level 126")
    Err(_) => ()
  }
  let info_126 = BidiInfo::new("a\u{05D0}1", Some(lv126))
  let mut i = 0
  while i < info_126.levels.length() {
    debug_assert(info_126.levels[i].number() <= 126, "level <= 126 invariant")
    i = i + 1
  }

  // Mid-char TextRange in reorder_line preserves exact byte length without U+FFFD inflation
  let info_mid = BidiInfo::new("\u{05D0}\u{05D1}\u{05D2}", None)
  let out_mid = info_mid.reorder_line(info_mid.paragraphs[0], TextRange::new(1, 5))
  assert_int_eq(out_mid.length(), 4, "mid-char range preserves exact byte length")

  // Representative BidiCharacterTest.txt conformance vectors (Unicode 16.0.0)
  // Vector 1: 05D0 0020 0031 002E 0032 0020 05D1 (RTL para: R WS EN CS EN WS R)
  let ct1 = BidiInfo::new("\u{05D0} 1.2 \u{05D1}", Some(Level::rtl()))
  assert_levels_eq(
    ct1.reordered_levels_per_char(ct1.paragraphs[0], ct1.paragraphs[0].range),
    [1, 1, 2, 2, 2, 1, 1],
    "BidiCharacterTest R WS EN CS EN WS R",
  )

  // Vector 2: 0627 0020 0031 002C 0032 0020 0628 (AL WS EN CS EN WS AL -> W2/W4 AN CS AN)
  let ct2 = BidiInfo::new("\u{0627} 1,2 \u{0628}", None)
  assert_levels_eq(
    ct2.reordered_levels_per_char(ct2.paragraphs[0], ct2.paragraphs[0].range),
    [1, 1, 2, 2, 2, 1, 1],
    "BidiCharacterTest AL WS EN CS EN WS AL",
  )

  // Vector 3: Nested RLI inside LRI inside RTL paragraph (X5a/X5b/X6a/X10)
  let ct3 = BidiInfo::new("\u{05D0}\u{2066}a\u{2067}\u{05D1}\u{2069}b\u{2069}\u{05D2}", Some(Level::rtl()))
  assert_levels_eq(
    ct3.reordered_levels_per_char(ct3.paragraphs[0], ct3.paragraphs[0].range),
    [1, 1, 2, 2, 3, 2, 2, 1, 1],
    "BidiCharacterTest nested LRI/RLI in RTL",
  )

  // Vector 4: Canonical equivalent brackets U+2329 / U+3009 (BD16)
  let ct4 = BidiInfo::new("\u{05D0}\u{2329}\u{05D1}\u{3009}a", Some(Level::ltr()))
  assert_levels_eq(
    ct4.reordered_levels_per_char(ct4.paragraphs[0], ct4.paragraphs[0].range),
    [1, 1, 1, 1, 0],
    "BidiCharacterTest canonical brackets",
  )
}
