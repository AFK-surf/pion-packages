///| Head-to-head Unicode BiDi benchmark (Pion Native).
///|   mode `levels`:  BidiInfo::new(line, None) over N lines x iters
///|   mode `reorder`: BidiInfo::new + visual_runs + reorder_line over N lines x iters

import "unicode_bidi"

fn parse_pos_int(s : String, fallback : Int) -> Int {
  if s.length() == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  if acc <= 0 { fallback } else { acc }
}

fn read_lines(world : World, path : String) -> Result[Array[String], String] {
  let raw = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return Err("failed to read " + path)
  }
  let parts = raw.split("\n")
  let out : Array[String] = Array::new()
  let mut i = 0
  while i < parts.length() {
    if parts[i].length() > 0 {
      out.push(parts[i])
    }
    i = i + 1
  }
  Ok(out)
}

fn fnv1a_byte(h : UInt64, b : Int) -> UInt64 {
  let x = h ^ b.to_int64().to_uint64()
  x * 1099511628211UL
}

fn run_levels(world : World, path : String, iters : Int) -> Int {
  let lines = match read_lines(world, path) {
    Ok(ls) => ls
    Err(e) => {
      io_println(world, e)
      return 1
    }
  }
  let n = lines.length()
  let mut total_paras : UInt64 = 0UL
  let mut rtl_paras : UInt64 = 0UL
  let mut level_sum : UInt64 = 0UL
  let mut hash : UInt64 = 14695981039346656037UL

  let mut it = 0
  while it < iters {
    let mut i = 0
    while i < n {
      let info = unicode_bidi::BidiInfo::new(lines[i], None)
      total_paras = total_paras + info.paragraphs.length().to_int64().to_uint64()
      let mut p = 0
      while p < info.paragraphs.length() {
        if info.paragraphs[p].level.is_rtl() {
          rtl_paras = rtl_paras + 1UL
        }
        p = p + 1
      }
      let mut k = 0
      let lv_len = info.levels.length()
      while k < lv_len {
        let lv = info.levels[k].number()
        level_sum = level_sum + lv.to_int64().to_uint64()
        hash = fnv1a_byte(hash, lv)
        k = k + 1
      }
      i = i + 1
    }
    it = it + 1
  }

  io_println(world, "mode=levels")
  io_println(world, "lines=" + n.to_string())
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "total_paras=" + total_paras.to_string())
  io_println(world, "rtl_paras=" + rtl_paras.to_string())
  io_println(world, "level_sum=" + level_sum.to_string())
  io_println(world, "levels_fnv=" + hash.to_string())
  0
}

fn run_reorder(world : World, path : String, iters : Int) -> Int {
  let lines = match read_lines(world, path) {
    Ok(ls) => ls
    Err(e) => {
      io_println(world, e)
      return 1
    }
  }
  let n = lines.length()
  let mut total_runs : UInt64 = 0UL
  let mut total_bytes : UInt64 = 0UL
  let mut hash : UInt64 = 14695981039346656037UL

  let mut it = 0
  while it < iters {
    let mut i = 0
    while i < n {
      let info = unicode_bidi::BidiInfo::new(lines[i], None)
      let mut p = 0
      while p < info.paragraphs.length() {
        let para = info.paragraphs[p]
        let (_, runs) = info.visual_runs(para, para.range)
        total_runs = total_runs + runs.length().to_int64().to_uint64()
        let out = info.reorder_line(para, para.range)
        let m = out.length()
        total_bytes = total_bytes + m.to_int64().to_uint64()
        let mut k = 0
        while k < m {
          hash = fnv1a_byte(hash, out.code_unit_at(k))
          k = k + 1
        }
        p = p + 1
      }
      i = i + 1
    }
    it = it + 1
  }

  io_println(world, "mode=reorder")
  io_println(world, "lines=" + n.to_string())
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "total_runs=" + total_runs.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "out_fnv=" + hash.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_bidi <levels|reorder> <file> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_pos_int(args[3], 1)
  if mode == "levels" {
    run_levels(world, path, iters)
  } else if mode == "reorder" {
    run_reorder(world, path, iters)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
