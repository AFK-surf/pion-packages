///| Native + Wasm32 four-mode smoke binary for `unicode_bidi`.
///| Exercises P1-P3, X1-X10, W1-W7, N0-N2, I1-I2, L1-L4 and prints deterministic stdout.

import "unicode_bidi"

///|
pub fn smoke_report() -> String {
  let sb = StringBuilder::new()

  // 1. Mixed Hebrew + Latin (auto RTL)
  let s1 = "\u{05D0}\u{05D1}\u{05D2}abc"
  let i1 = unicode_bidi::BidiInfo::new(s1, None)
  let r1 = i1.reorder_line(i1.paragraphs[0], i1.paragraphs[0].range)
  sb.write_string("case1=")
  sb.write_string(r1)
  sb.write_string("\n")

  // 2. Arabic + numbers + currency (W2/W3/W4/W5)
  let s2 = "\u{0627} $12+34"
  let i2 = unicode_bidi::BidiInfo::new(s2, Some(unicode_bidi::Level::rtl()))
  let r2 = i2.reorder_line(i2.paragraphs[0], i2.paragraphs[0].range)
  sb.write_string("case2=")
  sb.write_string(r2)
  sb.write_string("\n")

  // 3. FSI + nested isolates + paired brackets + L4 mirroring
  let s3 = "\u{05D0}(\u{05D1}) \u{2068}\u{0645}\u{0631}\u{062D}\u{0628}\u{0627} 2026\u{2069} (hi)"
  let i3 = unicode_bidi::BidiInfo::new(s3, Some(unicode_bidi::Level::rtl()))
  let r3 = i3.reorder_line_with_mirroring(i3.paragraphs[0], i3.paragraphs[0].range)
  sb.write_string("case3=")
  sb.write_string(r3)
  sb.write_string("\n")

  // 4. Compatibility helpers
  let lv = unicode_bidi::bidi_line_levels("abc \u{05D0}\u{05D1}\u{05D2}", 0)
  let ord = unicode_bidi::bidi_visual_order(lv)
  sb.write_string("case4_order=")
  let mut k = 0
  while k < ord.length() {
    if k > 0 {
      sb.write_string(",")
    }
    sb.write_string(ord[k].to_string())
    k = k + 1
  }
  sb.write_string("\n")

  // 5. Paragraph count + base direction
  let s5 = "hello\n\u{05D0}\u{05D1}\u{2029}123"
  let i5 = unicode_bidi::BidiInfo::new(s5, None)
  sb.write_string("case5_paras=")
  sb.write_string(i5.paragraphs.length().to_string())
  sb.write_string(",base=")
  sb.write_string(unicode_bidi::direction_to_string(unicode_bidi::get_base_direction(s5)))
  sb.write_string("\n")

  sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let report = smoke_report()
  io_println(world, report)
  0
}
