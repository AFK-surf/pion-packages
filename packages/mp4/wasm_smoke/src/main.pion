///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/mp4`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "mp4"

///|
fn push_u16(out : Array[Byte], v : Int) -> Unit {
  out.push(((v >> 8) & 255).to_byte())
  out.push((v & 255).to_byte())
}

///|
fn push_u32(out : Array[Byte], v : Int) -> Unit {
  out.push(((v >> 24) & 255).to_byte())
  out.push(((v >> 16) & 255).to_byte())
  out.push(((v >> 8) & 255).to_byte())
  out.push((v & 255).to_byte())
}

///|
fn push_u64(out : Array[Byte], v : Int64) -> Unit {
  out.push(((v >> 56) & 255L).to_int().to_byte())
  out.push(((v >> 48) & 255L).to_int().to_byte())
  out.push(((v >> 40) & 255L).to_int().to_byte())
  out.push(((v >> 32) & 255L).to_int().to_byte())
  out.push(((v >> 24) & 255L).to_int().to_byte())
  out.push(((v >> 16) & 255L).to_int().to_byte())
  out.push(((v >> 8) & 255L).to_int().to_byte())
  out.push((v & 255L).to_int().to_byte())
}

///|
fn push_str(out : Array[Byte], s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    out.push((s.code_unit_at(i) & 255).to_byte())
    i = i + 1
  }
}

///|
fn push_arr(out : Array[Byte], src : Array[Byte]) -> Unit {
  let mut i = 0
  while i < src.length() {
    out.push(src[i])
    i = i + 1
  }
}

///|
fn to_bytes(arr : Array[Byte]) -> Bytes {
  let b = Bytes::new(arr.length())
  let mut i = 0
  while i < arr.length() {
    b[i] = arr[i]
    i = i + 1
  }
  b
}

///|
fn make_box(fourcc : String, payload : Array[Byte]) -> Array[Byte] {
  let out : Array[Byte] = []
  push_u32(out, 8 + payload.length())
  push_str(out, fourcc)
  push_arr(out, payload)
  out
}

///|
fn make_full_box(fourcc : String, ver : Int, flags : Int, body : Array[Byte]) -> Array[Byte] {
  let p : Array[Byte] = []
  p.push((ver & 255).to_byte())
  p.push(((flags >> 16) & 255).to_byte())
  p.push(((flags >> 8) & 255).to_byte())
  p.push((flags & 255).to_byte())
  push_arr(p, body)
  make_box(fourcc, p)
}

///|
fn build_smoke_init() -> Bytes {
  let ftyp_p : Array[Byte] = []
  push_str(ftyp_p, "isom")
  push_u32(ftyp_p, 512)
  push_str(ftyp_p, "iso6")
  push_str(ftyp_p, "mp41")

  // mvhd v0
  let mvhd_b : Array[Byte] = []
  push_u32(mvhd_b, 0)
  push_u32(mvhd_b, 0)
  push_u32(mvhd_b, 1000)
  push_u32(mvhd_b, 0)
  push_u32(mvhd_b, 65536)
  push_u16(mvhd_b, 256)
  push_u16(mvhd_b, 0)
  push_u32(mvhd_b, 0)
  push_u32(mvhd_b, 0)
  push_u32(mvhd_b, 65536)
  push_u32(mvhd_b, 0)
  push_u32(mvhd_b, 0)
  push_u32(mvhd_b, 0)
  push_u32(mvhd_b, 65536)
  push_u32(mvhd_b, 0)
  push_u32(mvhd_b, 0)
  push_u32(mvhd_b, 0)
  push_u32(mvhd_b, 1073741824)
  let mut i = 0
  while i < 6 {
    push_u32(mvhd_b, 0)
    i = i + 1
  }
  push_u32(mvhd_b, 2)

  // tkhd v0
  let tkhd_b : Array[Byte] = []
  push_u32(tkhd_b, 0)
  push_u32(tkhd_b, 0)
  push_u32(tkhd_b, 1)
  push_u32(tkhd_b, 0)
  push_u32(tkhd_b, 0)
  push_u32(tkhd_b, 0)
  push_u32(tkhd_b, 0)
  push_u16(tkhd_b, 0)
  push_u16(tkhd_b, 0)
  push_u16(tkhd_b, 0)
  push_u16(tkhd_b, 0)
  push_u32(tkhd_b, 65536)
  push_u32(tkhd_b, 0)
  push_u32(tkhd_b, 0)
  push_u32(tkhd_b, 0)
  push_u32(tkhd_b, 65536)
  push_u32(tkhd_b, 0)
  push_u32(tkhd_b, 0)
  push_u32(tkhd_b, 0)
  push_u32(tkhd_b, 1073741824)
  push_u32(tkhd_b, 1280 << 16)
  push_u32(tkhd_b, 720 << 16)

  // mdhd v0
  let mdhd_b : Array[Byte] = []
  push_u32(mdhd_b, 0)
  push_u32(mdhd_b, 0)
  push_u32(mdhd_b, 90000)
  push_u32(mdhd_b, 0)
  push_u16(mdhd_b, 21956) // "und"
  push_u16(mdhd_b, 0)

  // hdlr
  let hdlr_b : Array[Byte] = []
  push_u32(hdlr_b, 0)
  push_str(hdlr_b, "vide")
  push_u32(hdlr_b, 0)
  push_u32(hdlr_b, 0)
  push_u32(hdlr_b, 0)
  hdlr_b.push(0.to_byte())

  // stsd with avc1 + avcC
  let entry : Array[Byte] = []
  i = 0
  while i < 6 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, 1)
  i = 0
  while i < 16 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, 1280)
  push_u16(entry, 720)
  push_u32(entry, 4718592)
  push_u32(entry, 4718592)
  push_u32(entry, 0)
  push_u16(entry, 1)
  i = 0
  while i < 32 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, 24)
  push_u16(entry, 65535)
  push_arr(entry, make_box("avcC", [1.to_byte(), 100.to_byte(), 0.to_byte(), 31.to_byte()]))

  let stsd_b : Array[Byte] = []
  push_u32(stsd_b, 1)
  push_arr(stsd_b, make_box("avc1", entry))

  let empty4 : Array[Byte] = []
  push_u32(empty4, 0)
  let stsz0 : Array[Byte] = []
  push_u32(stsz0, 0)
  push_u32(stsz0, 0)

  let stbl_b : Array[Byte] = []
  push_arr(stbl_b, make_full_box("stsd", 0, 0, stsd_b))
  push_arr(stbl_b, make_full_box("stts", 0, 0, empty4))
  push_arr(stbl_b, make_full_box("stsc", 0, 0, empty4))
  push_arr(stbl_b, make_full_box("stsz", 0, 0, stsz0))
  push_arr(stbl_b, make_full_box("stco", 0, 0, empty4))

  let mdia_b : Array[Byte] = []
  push_arr(mdia_b, make_full_box("mdhd", 0, 0, mdhd_b))
  push_arr(mdia_b, make_full_box("hdlr", 0, 0, hdlr_b))
  push_arr(mdia_b, make_box("minf", make_box("stbl", stbl_b)))

  let trak_b : Array[Byte] = []
  push_arr(trak_b, make_full_box("tkhd", 0, 3, tkhd_b))
  push_arr(trak_b, make_box("mdia", mdia_b))

  let trex_b : Array[Byte] = []
  push_u32(trex_b, 1)
  push_u32(trex_b, 1)
  push_u32(trex_b, 3000)
  push_u32(trex_b, 0)
  push_u32(trex_b, 16842752)

  let moov_b : Array[Byte] = []
  push_arr(moov_b, make_full_box("mvhd", 0, 0, mvhd_b))
  push_arr(moov_b, make_box("trak", trak_b))
  push_arr(moov_b, make_box("mvex", make_full_box("trex", 0, 0, trex_b)))

  let out : Array[Byte] = []
  push_arr(out, make_box("ftyp", ftyp_p))
  push_arr(out, make_box("moov", moov_b))
  to_bytes(out)
}

///|
fn build_smoke_media() -> Bytes {
  let mfhd_b : Array[Byte] = []
  push_u32(mfhd_b, 7)
  let mfhd = make_full_box("mfhd", 0, 0, mfhd_b)

  let tfhd_b : Array[Byte] = []
  push_u32(tfhd_b, 1)
  let tfhd = make_full_box("tfhd", 0, 131072, tfhd_b)

  let tfdt_b : Array[Byte] = []
  push_u64(tfdt_b, 180000L)
  let tfdt = make_full_box("tfdt", 1, 0, tfdt_b)

  let trun_box_len = 12 + 4 + 4 + 4 + 3 * 4
  let traf_box_len = 8 + tfhd.length() + tfdt.length() + trun_box_len
  let moof_box_len = 8 + mfhd.length() + traf_box_len
  let data_off = moof_box_len + 8

  let trun_b : Array[Byte] = []
  push_u32(trun_b, 3)
  push_u32(trun_b, data_off)
  push_u32(trun_b, 33554432) // sync
  push_u32(trun_b, 20)
  push_u32(trun_b, 15)
  push_u32(trun_b, 10)
  let trun = make_full_box("trun", 0, 517, trun_b) // 0x205

  let traf_b : Array[Byte] = []
  push_arr(traf_b, tfhd)
  push_arr(traf_b, tfdt)
  push_arr(traf_b, trun)

  let moof_b : Array[Byte] = []
  push_arr(moof_b, mfhd)
  push_arr(moof_b, make_box("traf", traf_b))

  let mdat_p : Array[Byte] = []
  let mut i = 0
  while i < 45 {
    mdat_p.push((i + 1).to_byte())
    i = i + 1
  }

  let out : Array[Byte] = []
  push_arr(out, make_box("moof", moof_b))
  push_arr(out, make_box("mdat", mdat_p))
  to_bytes(out)
}

///|
pub fn main(world : World) -> Int {
  let init_bytes = build_smoke_init()
  let init = match mp4::parse_init_segment(init_bytes, mp4::DecodeLimits::default()) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "ERR init: " + mp4::mp4_error_message(e))
      return 1
    }
  }
  let media_bytes = build_smoke_media()
  let seg = match mp4::parse_media_segment(init, media_bytes, mp4::DecodeLimits::default()) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "ERR media: " + mp4::mp4_error_message(e))
      return 2
    }
  }

  let t = init.tracks[0]
  let f = seg.fragments[0]
  let seek_idx = match mp4::find_sync_sample_at(f.samples, 185000L) {
    Some(idx) => idx
    None => -1
  }

  // Verify limit rejection deterministically
  let bomb_ok = match mp4::parse_init_segment(init_bytes, mp4::DecodeLimits::new(2, 32, 64, 1000, 100)) {
    Err(mp4::Mp4Error::LimitExceeded(_)) => true
    _ => false
  }
  if !bomb_ok {
    return 3
  }

  io_println(world, "mp4_wasm_smoke:ok")
  io_println(
    world,
    "init brand=" + init.ftyp.major_brand +
    " tracks=" + init.tracks.length().to_string() +
    " codec=" + mp4::probe_codec_string(t) +
    " dim=" + t.width.to_string() + "x" + t.height.to_string(),
  )
  io_println(
    world,
    "media seq=" + f.sequence_number.to_string() +
    " samples=" + f.samples.length().to_string() +
    " ms=" + seg.start_pts_ms.to_string() + ".." + seg.end_pts_ms.to_string() +
    " seek=" + seek_idx.to_string(),
  )
  let mut i = 0
  while i < f.samples.length() {
    let s = f.samples[i]
    io_println(
      world,
      "s" + i.to_string() +
      " off=" + s.offset.to_string() +
      " sz=" + s.size.to_string() +
      " dts=" + s.dts.to_string() +
      " pts=" + s.pts.to_string() +
      " dur=" + s.duration.to_string() +
      " sync=" + (if s.is_sync { "1" } else { "0" }),
    )
    i = i + 1
  }
  0
}
