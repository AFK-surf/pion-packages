///| ISO/IEC 14496-12 & W3C MSE ISO BMFF compliance, edge-case, and security test suite.

///| Helper: push big-endian u16 to byte array.
fn push_u16(out : Array[Byte], v : Int) -> Unit {
  out.push(((v >> 8) & 255).to_byte())
  out.push((v & 255).to_byte())
}

///| Helper: push big-endian u32 to byte array.
fn push_u32(out : Array[Byte], v : Int) -> Unit {
  out.push(((v >> 24) & 255).to_byte())
  out.push(((v >> 16) & 255).to_byte())
  out.push(((v >> 8) & 255).to_byte())
  out.push((v & 255).to_byte())
}

///| Helper: push big-endian u32 from UInt.
fn push_u32u(out : Array[Byte], v : UInt) -> Unit {
  out.push(((v >> 24) & 255U).to_int().to_byte())
  out.push(((v >> 16) & 255U).to_int().to_byte())
  out.push(((v >> 8) & 255U).to_int().to_byte())
  out.push((v & 255U).to_int().to_byte())
}

///| Helper: push big-endian u64 from Int64.
fn push_u64(out : Array[Byte], v : Int64) -> Unit {
  out.push(((v >> 56) & 255L).to_int().to_byte())
  out.push(((v >> 48) & 255L).to_int().to_byte())
  out.push(((v >> 40) & 255L).to_int().to_byte())
  out.push(((v >> 32) & 255L).to_int().to_byte())
  out.push(((v >> 24) & 255L).to_int().to_byte())
  out.push(((v >> 16) & 255L).to_int().to_byte())
  out.push(((v >> 8) & 255L).to_int().to_byte())
  out.push((v & 255L).to_int().to_byte())
}

///| Helper: push ASCII string bytes.
fn push_str(out : Array[Byte], s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    out.push((s.code_unit_at(i) & 255).to_byte())
    i = i + 1
  }
}

///| Helper: push raw byte slice from Array[Byte].
fn push_arr(out : Array[Byte], src : Array[Byte]) -> Unit {
  let n = src.length()
  let mut i = 0
  while i < n {
    out.push(src[i])
    i = i + 1
  }
}

///| Helper: convert Array[Byte] to Bytes.
fn to_bytes(arr : Array[Byte]) -> Bytes {
  let n = arr.length()
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = arr[i]
    i = i + 1
  }
  b
}

///| Helper: wrap payload in a standard 8-byte header ISO BMFF box.
fn make_box(fourcc : String, payload : Array[Byte]) -> Array[Byte] {
  let out : Array[Byte] = []
  push_u32(out, 8 + payload.length())
  push_str(out, fourcc)
  push_arr(out, payload)
  out
}

///| Helper: wrap payload in a FullBox (version + 24-bit flags).
fn make_full_box(
  fourcc : String,
  version : Int,
  flags : Int,
  body : Array[Byte],
) -> Array[Byte] {
  let payload : Array[Byte] = []
  payload.push((version & 255).to_byte())
  payload.push(((flags >> 16) & 255).to_byte())
  payload.push(((flags >> 8) & 255).to_byte())
  payload.push((flags & 255).to_byte())
  push_arr(payload, body)
  make_box(fourcc, payload)
}

///| Helper: build `ftyp` box.
fn build_ftyp(major : String, minor : Int, compat : Array[String]) -> Array[Byte] {
  let p : Array[Byte] = []
  push_str(p, major)
  push_u32(p, minor)
  let mut i = 0
  while i < compat.length() {
    push_str(p, compat[i])
    i = i + 1
  }
  make_box("ftyp", p)
}

///| Helper: build `mvhd` v0 box.
fn build_mvhd_v0(timescale : Int, duration : Int) -> Array[Byte] {
  let b : Array[Byte] = []
  push_u32(b, 0) // creation_time
  push_u32(b, 0) // modification_time
  push_u32(b, timescale)
  push_u32(b, duration)
  push_u32(b, 65536) // rate 1.0
  push_u16(b, 256) // volume 1.0
  push_u16(b, 0) // reserved
  push_u32(b, 0)
  push_u32(b, 0)
  // identity matrix (9 x u32)
  push_u32(b, 65536)
  push_u32(b, 0)
  push_u32(b, 0)
  push_u32(b, 0)
  push_u32(b, 65536)
  push_u32(b, 0)
  push_u32(b, 0)
  push_u32(b, 0)
  push_u32(b, 1073741824)
  // pre_defined (6 x u32)
  let mut i = 0
  while i < 6 {
    push_u32(b, 0)
    i = i + 1
  }
  push_u32(b, 3) // next_track_ID
  make_full_box("mvhd", 0, 0, b)
}

///| Helper: build `tkhd` v0 box.
fn build_tkhd_v0(track_id : Int, duration : Int, width : Int, height : Int) -> Array[Byte] {
  let b : Array[Byte] = []
  push_u32(b, 0) // creation
  push_u32(b, 0) // modification
  push_u32(b, track_id)
  push_u32(b, 0) // reserved
  push_u32(b, duration)
  push_u32(b, 0)
  push_u32(b, 0)
  push_u16(b, 0) // layer
  push_u16(b, 0) // alternate_group
  push_u16(b, 0) // volume
  push_u16(b, 0) // reserved
  // matrix (9 x u32)
  push_u32(b, 65536)
  push_u32(b, 0)
  push_u32(b, 0)
  push_u32(b, 0)
  push_u32(b, 65536)
  push_u32(b, 0)
  push_u32(b, 0)
  push_u32(b, 0)
  push_u32(b, 1073741824)
  push_u32(b, width << 16)
  push_u32(b, height << 16)
  make_full_box("tkhd", 0, 3, b)
}

///| Helper: encode 3-char ISO-639-2 language into packed u16.
fn encode_lang(lang : String) -> Int {
  let c0 = lang.code_unit_at(0) - 96
  let c1 = lang.code_unit_at(1) - 96
  let c2 = lang.code_unit_at(2) - 96
  ((c0 & 31) << 10) | ((c1 & 31) << 5) | (c2 & 31)
}

///| Helper: build `mdhd` v0 box.
fn build_mdhd_v0(timescale : Int, duration : Int, lang : String) -> Array[Byte] {
  let b : Array[Byte] = []
  push_u32(b, 0)
  push_u32(b, 0)
  push_u32(b, timescale)
  push_u32(b, duration)
  push_u16(b, encode_lang(lang))
  push_u16(b, 0)
  make_full_box("mdhd", 0, 0, b)
}

///| Helper: build `hdlr` box.
fn build_hdlr(handler_type : String) -> Array[Byte] {
  let b : Array[Byte] = []
  push_u32(b, 0) // pre_defined
  push_str(b, handler_type)
  push_u32(b, 0)
  push_u32(b, 0)
  push_u32(b, 0)
  b.push(0.to_byte()) // empty null-terminated name
  make_full_box("hdlr", 0, 0, b)
}

///| Helper: build `avc1` visual sample entry with `avcC`.
fn build_avc1_stsd(width : Int, height : Int, avcc_bytes : Array[Byte]) -> Array[Byte] {
  let entry : Array[Byte] = []
  // 6 reserved + 2 data_ref_idx
  let mut i = 0
  while i < 6 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, 1)
  // 16 pre_defined/reserved
  i = 0
  while i < 16 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, width)
  push_u16(entry, height)
  push_u32(entry, 4718592) // 72 dpi
  push_u32(entry, 4718592)
  push_u32(entry, 0)
  push_u16(entry, 1) // frame_count
  // 32 bytes compressorname
  i = 0
  while i < 32 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, 24) // depth
  push_u16(entry, 65535) // -1
  push_arr(entry, make_box("avcC", avcc_bytes))

  let stsd_body : Array[Byte] = []
  push_u32(stsd_body, 1)
  push_arr(stsd_body, make_box("avc1", entry))
  make_full_box("stsd", 0, 0, stsd_body)
}

///| Helper: build `mp4a` audio sample entry with `esds` (AAC-LC).
fn build_mp4a_stsd(channels : Int, sample_rate : Int) -> Array[Byte] {
  // AudioSpecificConfig for AAC-LC (2), 48000 Hz (index 3), stereo (2): 0x11 0x90
  let esds_body : Array[Byte] = [
    3.to_byte(), 25.to_byte(), // ES_DescrTag, len=25
    0.to_byte(), 1.to_byte(), 0.to_byte(), // ES_ID=1, flags=0
    4.to_byte(), 17.to_byte(), // DecoderConfigDescrTag, len=17
    64.to_byte(), // objectTypeIndication = 0x40 (MPEG-4 Audio)
    21.to_byte(), // streamType = audio
    0.to_byte(), 0.to_byte(), 0.to_byte(), // bufferSizeDB
    0.to_byte(), 1.to_byte(), 244.to_byte(), 0.to_byte(), // maxBitrate
    0.to_byte(), 1.to_byte(), 244.to_byte(), 0.to_byte(), // avgBitrate
    5.to_byte(), 2.to_byte(), // DecSpecificInfoTag, len=2
    17.to_byte(), 144.to_byte(), // AudioSpecificConfig: 0x11 0x90
    6.to_byte(), 1.to_byte(), 2.to_byte(), // SLConfigDescrTag
  ]
  let entry : Array[Byte] = []
  let mut i = 0
  while i < 6 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, 1)
  push_u32(entry, 0)
  push_u32(entry, 0)
  push_u16(entry, channels)
  push_u16(entry, 16)
  push_u16(entry, 0)
  push_u16(entry, 0)
  push_u32(entry, sample_rate << 16)
  push_arr(entry, make_full_box("esds", 0, 0, esds_body))

  let stsd_body : Array[Byte] = []
  push_u32(stsd_body, 1)
  push_arr(stsd_body, make_box("mp4a", entry))
  make_full_box("stsd", 0, 0, stsd_body)
}

///| Helper: build `vp09` visual sample entry with `vpcC`.
fn build_vp09_stsd(width : Int, height : Int) -> Array[Byte] {
  let entry : Array[Byte] = []
  let mut i = 0
  while i < 6 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, 1)
  i = 0
  while i < 16 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, width)
  push_u16(entry, height)
  push_u32(entry, 4718592)
  push_u32(entry, 4718592)
  push_u32(entry, 0)
  push_u16(entry, 1)
  i = 0
  while i < 32 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, 24)
  push_u16(entry, 65535)
  // vpcC v1: profile=0, level=10, bitDepth=8 (0x80), colourPrimaries=1, transfer=1, matrix=1, codecInitSize=0
  let vpcc_body : Array[Byte] = [
    0.to_byte(), 10.to_byte(), 128.to_byte(), 1.to_byte(), 1.to_byte(), 1.to_byte(),
    0.to_byte(), 0.to_byte(),
  ]
  push_arr(entry, make_full_box("vpcC", 1, 0, vpcc_body))

  let stsd_body : Array[Byte] = []
  push_u32(stsd_body, 1)
  push_arr(stsd_body, make_box("vp09", entry))
  make_full_box("stsd", 0, 0, stsd_body)
}

///| Helper: build `av01` visual sample entry with `av1C`.
fn build_av01_stsd(width : Int, height : Int) -> Array[Byte] {
  let entry : Array[Byte] = []
  let mut i = 0
  while i < 6 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, 1)
  i = 0
  while i < 16 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, width)
  push_u16(entry, height)
  push_u32(entry, 4718592)
  push_u32(entry, 4718592)
  push_u32(entry, 0)
  push_u16(entry, 1)
  i = 0
  while i < 32 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, 24)
  push_u16(entry, 65535)
  // av1C: marker=1, version=1 (0x81); seq_profile=0, seq_level_idx_0=4 (0x04); tier=0, high_bitdepth=0 (0x0C); 0x00
  let av1c_bytes : Array[Byte] = [129.to_byte(), 4.to_byte(), 12.to_byte(), 0.to_byte()]
  push_arr(entry, make_box("av1C", av1c_bytes))

  let stsd_body : Array[Byte] = []
  push_u32(stsd_body, 1)
  push_arr(stsd_body, make_box("av01", entry))
  make_full_box("stsd", 0, 0, stsd_body)
}

///| Helper: build `Opus` audio sample entry with `dOps`.
fn build_opus_stsd(channels : Int, sample_rate : Int) -> Array[Byte] {
  let entry : Array[Byte] = []
  let mut i = 0
  while i < 6 {
    entry.push(0.to_byte())
    i = i + 1
  }
  push_u16(entry, 1)
  push_u32(entry, 0)
  push_u32(entry, 0)
  push_u16(entry, channels)
  push_u16(entry, 16)
  push_u16(entry, 0)
  push_u16(entry, 0)
  push_u32(entry, sample_rate << 16)
  // dOps: version=0, channels=2, pre_skip=312 (0x0138), input_sr=48000, output_gain=0, mapping=0
  let dops : Array[Byte] = []
  dops.push(0.to_byte())
  dops.push(channels.to_byte())
  push_u16(dops, 312)
  push_u32(dops, sample_rate)
  push_u16(dops, 0)
  dops.push(0.to_byte())
  push_arr(entry, make_box("dOps", dops))

  let stsd_body : Array[Byte] = []
  push_u32(stsd_body, 1)
  push_arr(stsd_body, make_box("Opus", entry))
  make_full_box("stsd", 0, 0, stsd_body)
}

///| Helper: build empty `stbl` for fMP4 init segment.
fn build_empty_stbl(stsd : Array[Byte]) -> Array[Byte] {
  let empty4 : Array[Byte] = []
  push_u32(empty4, 0)
  let stsz_empty : Array[Byte] = []
  push_u32(stsz_empty, 0)
  push_u32(stsz_empty, 0)
  let body : Array[Byte] = []
  push_arr(body, stsd)
  push_arr(body, make_full_box("stts", 0, 0, empty4))
  push_arr(body, make_full_box("stsc", 0, 0, empty4))
  push_arr(body, make_full_box("stsz", 0, 0, stsz_empty))
  push_arr(body, make_full_box("stco", 0, 0, empty4))
  make_box("stbl", body)
}

///| Helper: build `trex` box.
fn build_trex(
  track_id : Int,
  desc_idx : Int,
  dur : Int,
  size : Int,
  flags : Int,
) -> Array[Byte] {
  let b : Array[Byte] = []
  push_u32(b, track_id)
  push_u32(b, desc_idx)
  push_u32(b, dur)
  push_u32(b, size)
  push_u32(b, flags)
  make_full_box("trex", 0, 0, b)
}

///| Helper: build a complete fMP4 init segment with 1 video (avc1) + 1 audio (mp4a) track.
fn build_test_fmp4_init() -> Bytes {
  let out : Array[Byte] = []
  push_arr(out, build_ftyp("isom", 512, ["isom", "iso6", "mp41"]))

  // Video trak (track_id=1, 1280x720, timescale=90000)
  let avcc : Array[Byte] = [
    1.to_byte(), 100.to_byte(), 0.to_byte(), 31.to_byte(), 255.to_byte(), 225.to_byte(),
    0.to_byte(), 4.to_byte(), 103.to_byte(), 100.to_byte(), 0.to_byte(), 31.to_byte(),
    1.to_byte(), 0.to_byte(), 2.to_byte(), 104.to_byte(), 238.to_byte(),
  ]
  let v_minf = make_box("minf", build_empty_stbl(build_avc1_stsd(1280, 720, avcc)))
  let v_mdia_body : Array[Byte] = []
  push_arr(v_mdia_body, build_mdhd_v0(90000, 0, "und"))
  push_arr(v_mdia_body, build_hdlr("vide"))
  push_arr(v_mdia_body, v_minf)
  let v_trak_body : Array[Byte] = []
  push_arr(v_trak_body, build_tkhd_v0(1, 0, 1280, 720))
  push_arr(v_trak_body, make_box("mdia", v_mdia_body))

  // Audio trak (track_id=2, 48000 Hz, stereo)
  let a_minf = make_box("minf", build_empty_stbl(build_mp4a_stsd(2, 48000)))
  let a_mdia_body : Array[Byte] = []
  push_arr(a_mdia_body, build_mdhd_v0(48000, 0, "eng"))
  push_arr(a_mdia_body, build_hdlr("soun"))
  push_arr(a_mdia_body, a_minf)
  let a_trak_body : Array[Byte] = []
  push_arr(a_trak_body, build_tkhd_v0(2, 0, 0, 0))
  push_arr(a_trak_body, make_box("mdia", a_mdia_body))

  // mvex
  let mvex_body : Array[Byte] = []
  push_arr(mvex_body, build_trex(1, 1, 3000, 0, 16842752)) // 0x01010000 (non-sync default)
  push_arr(mvex_body, build_trex(2, 1, 1024, 0, 33554432)) // 0x02000000 (sync default)

  let moov_body : Array[Byte] = []
  push_arr(moov_body, build_mvhd_v0(1000, 0))
  push_arr(moov_body, make_box("trak", v_trak_body))
  push_arr(moov_body, make_box("trak", a_trak_body))
  push_arr(moov_body, make_box("mvex", mvex_body))
  push_arr(out, make_box("moov", moov_body))
  to_bytes(out)
}

test "box_header: standard, largesize 64-bit, size=0 to EOF, and uuid" {
  // 1. Standard 8-byte box + size=0 to EOF box
  let arr : Array[Byte] = []
  push_u32(arr, 12)
  push_str(arr, "free")
  push_u32(arr, 0)
  // size == 0 box extending to EOF (10 bytes total)
  push_u32(arr, 0)
  push_str(arr, "mdat")
  arr.push(1.to_byte())
  arr.push(2.to_byte())
  let data = to_bytes(arr)
  match parse_top_level_boxes(data, DecodeLimits::default()) {
    Ok(boxes) => {
      debug_assert(boxes.length() == 2, "expected 2 boxes")
      debug_assert(boxes[0].box_type == "free", "first box free")
      debug_assert(boxes[0].size == 12L, "first box size 12")
      debug_assert(boxes[1].box_type == "mdat", "second box mdat")
      debug_assert(boxes[1].size == 10L, "size=0 extends to EOF (10)")
      debug_assert(boxes[1].payload_size == 2L, "mdat payload 2 bytes")
    }
    Err(e) => debug_assert(false, "box_header failed: " + mp4_error_message(e))
  }

  // 2. 64-bit largesize box
  let arr64 : Array[Byte] = []
  push_u32(arr64, 1)
  push_str(arr64, "mdat")
  push_u64(arr64, 20L)
  push_u32(arr64, 305419896)
  match read_box_header(to_bytes(arr64), 0L, 20L) {
    Ok(h) => {
      debug_assert(h.box_type == "mdat", "largesize type")
      debug_assert(h.header_size == 16, "largesize header_size 16")
      debug_assert(h.size == 20L, "largesize total 20")
      debug_assert(h.payload_size == 4L, "largesize payload 4")
    }
    Err(e) => debug_assert(false, "largesize failed: " + mp4_error_message(e))
  }

  // 3. uuid extended box
  let arr_uuid : Array[Byte] = []
  push_u32(arr_uuid, 28)
  push_str(arr_uuid, "uuid")
  let mut i = 0
  while i < 16 {
    arr_uuid.push((i + 1).to_byte())
    i = i + 1
  }
  push_u32(arr_uuid, 42)
  match read_box_header(to_bytes(arr_uuid), 0L, 28L) {
    Ok(h) => {
      debug_assert(h.box_type == "uuid", "uuid type")
      debug_assert(h.header_size == 24, "uuid header_size 24")
      debug_assert(h.uuid.length() == 16, "uuid len 16")
      debug_assert(h.uuid[0].to_int() == 1 && h.uuid[15].to_int() == 16, "uuid bytes")
      debug_assert(h.payload_size == 4L, "uuid payload 4")
    }
    Err(e) => debug_assert(false, "uuid failed: " + mp4_error_message(e))
  }
}

test "security: invalid box sizes, largesize underflow, truncation, and limits" {
  // largesize < 16 integer underflow guard
  let underflow : Array[Byte] = []
  push_u32(underflow, 1)
  push_str(underflow, "free")
  push_u64(underflow, 12L)
  match read_box_header(to_bytes(underflow), 0L, 16L) {
    Err(Mp4Error::InvalidBoxSize(_)) => ()
    _ => debug_assert(false, "largesize < 16 must fail with InvalidBoxSize")
  }

  // size in 2..7 invalid
  let small : Array[Byte] = []
  push_u32(small, 5)
  push_str(small, "free")
  match read_box_header(to_bytes(small), 0L, 8L) {
    Err(Mp4Error::InvalidBoxSize(_)) => ()
    _ => debug_assert(false, "size=5 must fail with InvalidBoxSize")
  }

  // truncated box exceeding buffer
  let trunc : Array[Byte] = []
  push_u32(trunc, 100)
  push_str(trunc, "free")
  match read_box_header(to_bytes(trunc), 0L, 8L) {
    Err(Mp4Error::Truncated(_)) => ()
    _ => debug_assert(false, "truncated box must fail with Truncated")
  }

  // negative limit rejected immediately
  let bad_lim = DecodeLimits::new(-1, 32, 64, 1000, 100)
  let free_box = to_bytes(make_box("free", []))
  match parse_top_level_boxes(free_box, bad_lim) {
    Err(Mp4Error::LimitExceeded(_)) => ()
    _ => debug_assert(false, "negative max_boxes must fail with LimitExceeded")
  }

  // max_boxes == 0 rejects 1 box
  let zero_lim = DecodeLimits::new(0, 32, 64, 1000, 100)
  match parse_top_level_boxes(free_box, zero_lim) {
    Err(Mp4Error::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_boxes=0 must reject 1 box")
  }
}

test "traditional mp4: moov + stbl (stts/ctts/stsc/stsz/stco/stss) + extract_samples" {
  // Build a valid MP4 with 1 video track (3 samples, B-frame ctts v1 signed, 2 chunks) + mdat
  let ftyp = build_ftyp("isom", 512, ["isom", "mp41"])
  let mdat_payload : Array[Byte] = []
  // 3 samples of sizes 10, 12, 8 = 30 bytes
  let mut i = 0
  while i < 30 {
    mdat_payload.push((i + 1).to_byte())
    i = i + 1
  }
  let mdat = make_box("mdat", mdat_payload)
  // mdat starts right after ftyp; payload starts at ftyp.length() + 8
  let mdat_data_off = ftyp.length() + 8

  let avcc : Array[Byte] = [
    1.to_byte(), 100.to_byte(), 0.to_byte(), 31.to_byte(), 255.to_byte(), 225.to_byte(),
    0.to_byte(), 2.to_byte(), 103.to_byte(), 100.to_byte(),
    1.to_byte(), 0.to_byte(), 2.to_byte(), 104.to_byte(), 238.to_byte(),
  ]
  // stts: 3 samples, delta=3000
  let stts_b : Array[Byte] = []
  push_u32(stts_b, 1)
  push_u32(stts_b, 3)
  push_u32(stts_b, 3000)

  // ctts v1 (signed): [1:+3000, 1:-3000, 1:0]
  let ctts_b : Array[Byte] = []
  push_u32(ctts_b, 3)
  push_u32(ctts_b, 1)
  push_u32(ctts_b, 3000)
  push_u32(ctts_b, 1)
  push_u32u(ctts_b, 4294964296U) // -3000 as i32
  push_u32(ctts_b, 1)
  push_u32(ctts_b, 0)

  // stsc: chunk 1 has 2 samples, chunk 2 has 1 sample
  let stsc_b : Array[Byte] = []
  push_u32(stsc_b, 2)
  push_u32(stsc_b, 1)
  push_u32(stsc_b, 2)
  push_u32(stsc_b, 1)
  push_u32(stsc_b, 2)
  push_u32(stsc_b, 1)
  push_u32(stsc_b, 1)

  // stsz: sizes 10, 12, 8
  let stsz_b : Array[Byte] = []
  push_u32(stsz_b, 0)
  push_u32(stsz_b, 3)
  push_u32(stsz_b, 10)
  push_u32(stsz_b, 12)
  push_u32(stsz_b, 8)

  // stco: chunk 1 at mdat_data_off, chunk 2 at mdat_data_off + 22
  let stco_b : Array[Byte] = []
  push_u32(stco_b, 2)
  push_u32(stco_b, mdat_data_off)
  push_u32(stco_b, mdat_data_off + 22)

  // stss: sample 1 and sample 3 are sync
  let stss_b : Array[Byte] = []
  push_u32(stss_b, 2)
  push_u32(stss_b, 1)
  push_u32(stss_b, 3)

  let stbl_b : Array[Byte] = []
  push_arr(stbl_b, build_avc1_stsd(640, 360, avcc))
  push_arr(stbl_b, make_full_box("stts", 0, 0, stts_b))
  push_arr(stbl_b, make_full_box("ctts", 1, 0, ctts_b))
  push_arr(stbl_b, make_full_box("stsc", 0, 0, stsc_b))
  push_arr(stbl_b, make_full_box("stsz", 0, 0, stsz_b))
  push_arr(stbl_b, make_full_box("stco", 0, 0, stco_b))
  push_arr(stbl_b, make_full_box("stss", 0, 0, stss_b))

  let mdia_b : Array[Byte] = []
  push_arr(mdia_b, build_mdhd_v0(90000, 9000, "eng"))
  push_arr(mdia_b, build_hdlr("vide"))
  push_arr(mdia_b, make_box("minf", make_box("stbl", stbl_b)))

  let trak_b : Array[Byte] = []
  push_arr(trak_b, build_tkhd_v0(1, 100, 640, 360))
  push_arr(trak_b, make_box("mdia", mdia_b))

  let moov_b : Array[Byte] = []
  push_arr(moov_b, build_mvhd_v0(1000, 100))
  push_arr(moov_b, make_box("trak", trak_b))

  let file_arr : Array[Byte] = []
  push_arr(file_arr, ftyp)
  push_arr(file_arr, mdat)
  push_arr(file_arr, make_box("moov", moov_b))
  let file_bytes = to_bytes(file_arr)

  match parse_mp4(file_bytes) {
    Ok(mp4) => {
      debug_assert(mp4.mvhd.timescale == 1000U, "mvhd timescale")
      debug_assert(mp4.tracks.length() == 1, "1 track")
      let t = mp4.tracks[0]
      debug_assert(t.track_id == 1U, "track_id=1")
      debug_assert(t.width == 640 && t.height == 360, "dimensions")
      debug_assert(t.language == "eng", "language eng")
      debug_assert(probe_codec_string(t) == "avc1.64001f", "codec string avc1.64001f")
      match mp4.extract_samples(1U) {
        Ok(samples) => {
          debug_assert(samples.length() == 3, "3 samples")
          debug_assert(
            samples[0].offset == mdat_data_off.to_int64() && samples[0].size == 10,
            "s0 offset/size",
          )
          debug_assert(samples[0].dts == 0L && samples[0].pts == 3000L, "s0 dts/pts")
          debug_assert(samples[0].is_sync, "s0 sync")
          debug_assert(
            samples[1].offset == (mdat_data_off + 10).to_int64() && samples[1].size == 12,
            "s1 offset/size",
          )
          debug_assert(samples[1].dts == 3000L && samples[1].pts == 0L, "s1 signed cto")
          debug_assert(!samples[1].is_sync, "s1 non-sync")
          debug_assert(
            samples[2].offset == (mdat_data_off + 22).to_int64() && samples[2].size == 8,
            "s2 offset/size",
          )
          debug_assert(samples[2].dts == 6000L && samples[2].pts == 6000L, "s2 dts/pts")
          debug_assert(samples[2].is_sync, "s2 sync")
        }
        Err(e) => debug_assert(false, "extract_samples failed: " + mp4_error_message(e))
      }
    }
    Err(e) => debug_assert(false, "parse_mp4 failed: " + mp4_error_message(e))
  }
}

test "fmp4 mse: parse_init_segment + parse_media_segment (styp/sidx/moof/mdat)" {
  let init_bytes = build_test_fmp4_init()
  let init = match parse_init_segment(init_bytes, DecodeLimits::default()) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse_init_segment failed: " + mp4_error_message(e))
      return ()
    }
  }
  debug_assert(init.ftyp.major_brand == "isom", "init major brand")
  debug_assert(init.tracks.length() == 2, "2 tracks in init")
  debug_assert(init.trex.length() == 2, "2 trex in init")
  debug_assert(probe_codec_string(init.tracks[0]) == "avc1.64001f", "video codec")
  debug_assert(probe_codec_string(init.tracks[1]) == "mp4a.40.2", "audio codec")

  // Build media segment: styp + sidx + moof(mfhd + traf(tfhd + tfdt + trun)) + mdat
  let styp = make_box("styp", {
    let p : Array[Byte] = []
    push_str(p, "msdh")
    push_u32(p, 0)
    push_str(p, "msdh")
    push_str(p, "msix")
    p
  })
  // sidx v0: ref_id=1, timescale=90000, earliest_pts=90000, first_offset=0, 1 ref
  let sidx_b : Array[Byte] = []
  push_u32(sidx_b, 1)
  push_u32(sidx_b, 90000)
  push_u32(sidx_b, 90000)
  push_u32(sidx_b, 0)
  push_u16(sidx_b, 0)
  push_u16(sidx_b, 1)
  push_u32(sidx_b, 200) // ref_type=0, size=200
  push_u32(sidx_b, 6000) // subsegment_duration
  push_u32u(sidx_b, 2415919104U) // starts_with_sap=1, sap_type=1, delta=0
  let sidx = make_full_box("sidx", 0, 0, sidx_b)

  // mfhd: seq=1
  let mfhd_b : Array[Byte] = []
  push_u32(mfhd_b, 1)
  let mfhd = make_full_box("mfhd", 0, 0, mfhd_b)

  // tfhd: flags = default_base_is_moof (0x020000)
  let tfhd_b : Array[Byte] = []
  push_u32(tfhd_b, 1) // track_id=1
  let tfhd = make_full_box("tfhd", 0, 131072, tfhd_b)

  // tfdt v1: baseMediaDecodeTime = 90000
  let tfdt_b : Array[Byte] = []
  push_u64(tfdt_b, 90000L)
  let tfdt = make_full_box("tfdt", 1, 0, tfdt_b)

  // trun v1: flags = data_offset (0x1) | first_sample_flags (0x4) | sample_size (0x200) | cto (0x800) = 0xA05
  // 2 samples: s0 size=16 (keyframe via first_sample_flags=0x02000000, cto=0), s1 size=12 (default non-sync from trex, cto=3000)
  // First build placeholder trun to measure moof size so data_offset points to mdat payload
  let trun_body_len = 4 + 4 + 4 + 2 * 8 // sample_count + data_offset + first_sample_flags + 2*(size+cto)
  let trun_box_len = 12 + trun_body_len
  let traf_box_len = 8 + tfhd.length() + tfdt.length() + trun_box_len
  let moof_box_len = 8 + mfhd.length() + traf_box_len
  let data_offset = moof_box_len + 8 // right after mdat 8-byte header

  let trun_b : Array[Byte] = []
  push_u32(trun_b, 2)
  push_u32(trun_b, data_offset)
  push_u32(trun_b, 33554432) // 0x02000000 = sync sample
  push_u32(trun_b, 16)
  push_u32(trun_b, 0)
  push_u32(trun_b, 12)
  push_u32(trun_b, 3000)
  let trun = make_full_box("trun", 1, 2565, trun_b)

  let traf_b : Array[Byte] = []
  push_arr(traf_b, tfhd)
  push_arr(traf_b, tfdt)
  push_arr(traf_b, trun)
  let moof_b : Array[Byte] = []
  push_arr(moof_b, mfhd)
  push_arr(moof_b, make_box("traf", traf_b))
  let moof = make_box("moof", moof_b)

  let mdat_payload : Array[Byte] = []
  let mut i = 0
  while i < 28 {
    mdat_payload.push((i + 10).to_byte())
    i = i + 1
  }
  let mdat = make_box("mdat", mdat_payload)

  let seg_arr : Array[Byte] = []
  push_arr(seg_arr, styp)
  push_arr(seg_arr, sidx)
  let moof_off = seg_arr.length()
  push_arr(seg_arr, moof)
  push_arr(seg_arr, mdat)
  let seg_bytes = to_bytes(seg_arr)

  match parse_media_segment(init, seg_bytes, DecodeLimits::default()) {
    Ok(seg) => {
      debug_assert(seg.sidx.length() == 1, "1 sidx")
      debug_assert(seg.sidx[0].earliest_presentation_time == 90000L, "sidx earliest pts")
      debug_assert(seg.sidx[0].references.length() == 1, "1 sidx ref")
      debug_assert(seg.sidx[0].references[0].starts_with_sap, "sidx sap")
      debug_assert(seg.fragments.length() == 1, "1 fragment")
      let f = seg.fragments[0]
      debug_assert(f.sequence_number == 1U && f.track_id == 1U, "frag seq/track")
      debug_assert(f.base_decode_time == 90000L, "tfdt base time")
      debug_assert(f.samples.length() == 2, "2 frag samples")
      debug_assert(
        f.samples[0].offset == (moof_off + data_offset).to_int64() && f.samples[0].size == 16,
        "frag s0 offset/size",
      )
      debug_assert(f.samples[0].dts == 90000L && f.samples[0].pts == 90000L, "frag s0 timing")
      debug_assert(f.samples[0].is_sync, "frag s0 keyframe")
      debug_assert(
        f.samples[1].offset == (moof_off + data_offset + 16).to_int64() && f.samples[1].size == 12,
        "frag s1 offset/size",
      )
      debug_assert(f.samples[1].dts == 93000L && f.samples[1].pts == 96000L, "frag s1 timing")
      debug_assert(!f.samples[1].is_sync, "frag s1 non-sync")
      debug_assert(seg.start_pts_ms == 1000L && seg.end_pts_ms == 1100L, "segment ms range")
    }
    Err(e) => debug_assert(false, "parse_media_segment failed: " + mp4_error_message(e))
  }
}

test "codec strings: vp09, av01, opus" {
  let out : Array[Byte] = []
  push_arr(out, build_ftyp("iso6", 0, ["iso6", "mp41"]))

  // Track 1: vp09
  let t1_mdia : Array[Byte] = []
  push_arr(t1_mdia, build_mdhd_v0(90000, 0, "und"))
  push_arr(t1_mdia, build_hdlr("vide"))
  push_arr(t1_mdia, make_box("minf", build_empty_stbl(build_vp09_stsd(1920, 1080))))
  let t1_trak : Array[Byte] = []
  push_arr(t1_trak, build_tkhd_v0(1, 0, 1920, 1080))
  push_arr(t1_trak, make_box("mdia", t1_mdia))

  // Track 2: av01
  let t2_mdia : Array[Byte] = []
  push_arr(t2_mdia, build_mdhd_v0(90000, 0, "und"))
  push_arr(t2_mdia, build_hdlr("vide"))
  push_arr(t2_mdia, make_box("minf", build_empty_stbl(build_av01_stsd(1920, 1080))))
  let t2_trak : Array[Byte] = []
  push_arr(t2_trak, build_tkhd_v0(2, 0, 1920, 1080))
  push_arr(t2_trak, make_box("mdia", t2_mdia))

  // Track 3: Opus
  let t3_mdia : Array[Byte] = []
  push_arr(t3_mdia, build_mdhd_v0(48000, 0, "und"))
  push_arr(t3_mdia, build_hdlr("soun"))
  push_arr(t3_mdia, make_box("minf", build_empty_stbl(build_opus_stsd(2, 48000))))
  let t3_trak : Array[Byte] = []
  push_arr(t3_trak, build_tkhd_v0(3, 0, 0, 0))
  push_arr(t3_trak, make_box("mdia", t3_mdia))

  let moov_b : Array[Byte] = []
  push_arr(moov_b, build_mvhd_v0(1000, 0))
  push_arr(moov_b, make_box("trak", t1_trak))
  push_arr(moov_b, make_box("trak", t2_trak))
  push_arr(moov_b, make_box("trak", t3_trak))
  push_arr(out, make_box("moov", moov_b))

  match parse_init_segment(to_bytes(out), DecodeLimits::default()) {
    Ok(init) => {
      debug_assert(init.tracks.length() == 3, "3 tracks")
      debug_assert(probe_codec_string(init.tracks[0]) == "vp09.00.10.08", "vp09 codec string")
      debug_assert(probe_codec_string(init.tracks[1]) == "av01.0.04M.08", "av01 codec string")
      debug_assert(probe_codec_string(init.tracks[2]) == "opus", "opus codec string")
    }
    Err(e) => debug_assert(false, "codec init failed: " + mp4_error_message(e))
  }
}

test "seek: find_sync_sample_at binary search" {
  let samples : Array[Sample] = [
    Sample::{ offset: 0L, size: 100, dts: 0L, pts: 0L, duration: 1000, is_sync: true },
    Sample::{ offset: 100L, size: 50, dts: 1000L, pts: 1000L, duration: 1000, is_sync: false },
    Sample::{ offset: 150L, size: 50, dts: 2000L, pts: 2000L, duration: 1000, is_sync: false },
    Sample::{ offset: 200L, size: 120, dts: 3000L, pts: 3000L, duration: 1000, is_sync: true },
    Sample::{ offset: 320L, size: 60, dts: 4000L, pts: 4000L, duration: 1000, is_sync: false },
    Sample::{ offset: 380L, size: 110, dts: 5000L, pts: 5000L, duration: 1000, is_sync: true },
  ]
  match find_sync_sample_at(samples, -1L) {
    None => ()
    Some(_) => debug_assert(false, "before start should be None")
  }
  match find_sync_sample_at(samples, 0L) {
    Some(idx) => debug_assert(idx == 0, "at 0 -> 0")
    None => debug_assert(false, "at 0 should be Some(0)")
  }
  match find_sync_sample_at(samples, 2500L) {
    Some(idx) => debug_assert(idx == 0, "at 2500 -> 0")
    None => debug_assert(false, "at 2500 should be Some(0)")
  }
  match find_sync_sample_at(samples, 3000L) {
    Some(idx) => debug_assert(idx == 3, "at 3000 -> 3")
    None => debug_assert(false, "at 3000 should be Some(3)")
  }
  match find_sync_sample_at(samples, 4999L) {
    Some(idx) => debug_assert(idx == 3, "at 4999 -> 3")
    None => debug_assert(false, "at 4999 should be Some(3)")
  }
  match find_sync_sample_at(samples, 99999L) {
    Some(idx) => debug_assert(idx == 5, "past end -> 5")
    None => debug_assert(false, "past end should be Some(5)")
  }
}

test "v1 64-bit boxes, co64, stz2, constant stsz, and stss-absent audio" {
  // Build MP4 with mvhd v1, tkhd v1, mdhd v1, co64, stz2 (8-bit), no stss (all sync)
  let ftyp = build_ftyp("isom", 0, ["isom"])
  let mdat_payload : Array[Byte] = []
  let mut i = 0
  while i < 15 {
    mdat_payload.push((i + 1).to_byte())
    i = i + 1
  }
  let mdat = make_box("mdat", mdat_payload)
  let data_off = (ftyp.length() + 8).to_int64()

  // mvhd v1
  let mvhd1 : Array[Byte] = []
  push_u64(mvhd1, 0L)
  push_u64(mvhd1, 0L)
  push_u32(mvhd1, 1000)
  push_u64(mvhd1, 5000000000L) // > 32-bit duration
  push_u32(mvhd1, 65536)
  push_u16(mvhd1, 256)
  push_u16(mvhd1, 0)
  push_u32(mvhd1, 0)
  push_u32(mvhd1, 0)
  push_u32(mvhd1, 65536)
  push_u32(mvhd1, 0)
  push_u32(mvhd1, 0)
  push_u32(mvhd1, 0)
  push_u32(mvhd1, 65536)
  push_u32(mvhd1, 0)
  push_u32(mvhd1, 0)
  push_u32(mvhd1, 0)
  push_u32(mvhd1, 1073741824)
  i = 0
  while i < 6 {
    push_u32(mvhd1, 0)
    i = i + 1
  }
  push_u32(mvhd1, 2)

  // tkhd v1
  let tkhd1 : Array[Byte] = []
  push_u64(tkhd1, 0L)
  push_u64(tkhd1, 0L)
  push_u32(tkhd1, 1)
  push_u32(tkhd1, 0)
  push_u64(tkhd1, 5000000000L)
  push_u32(tkhd1, 0)
  push_u32(tkhd1, 0)
  push_u16(tkhd1, 0)
  push_u16(tkhd1, 0)
  push_u16(tkhd1, 0)
  push_u16(tkhd1, 0)
  push_u32(tkhd1, 65536)
  push_u32(tkhd1, 0)
  push_u32(tkhd1, 0)
  push_u32(tkhd1, 0)
  push_u32(tkhd1, 65536)
  push_u32(tkhd1, 0)
  push_u32(tkhd1, 0)
  push_u32(tkhd1, 0)
  push_u32(tkhd1, 1073741824)
  push_u32(tkhd1, 0)
  push_u32(tkhd1, 0)

  // mdhd v1
  let mdhd1 : Array[Byte] = []
  push_u64(mdhd1, 0L)
  push_u64(mdhd1, 0L)
  push_u32(mdhd1, 48000)
  push_u64(mdhd1, 6000000000L)
  push_u16(mdhd1, encode_lang("jpn"))
  push_u16(mdhd1, 0)

  // stts: 3 samples, delta=1024
  let stts_b : Array[Byte] = []
  push_u32(stts_b, 1)
  push_u32(stts_b, 3)
  push_u32(stts_b, 1024)

  // stsc: 1 chunk of 3 samples
  let stsc_b : Array[Byte] = []
  push_u32(stsc_b, 1)
  push_u32(stsc_b, 1)
  push_u32(stsc_b, 3)
  push_u32(stsc_b, 1)

  // stz2: 8-bit sizes [4, 5, 6]
  let stz2_b : Array[Byte] = []
  stz2_b.push(0.to_byte())
  stz2_b.push(0.to_byte())
  stz2_b.push(0.to_byte())
  stz2_b.push(8.to_byte())
  push_u32(stz2_b, 3)
  stz2_b.push(4.to_byte())
  stz2_b.push(5.to_byte())
  stz2_b.push(6.to_byte())

  // co64: 1 chunk at data_off
  let co64_b : Array[Byte] = []
  push_u32(co64_b, 1)
  push_u64(co64_b, data_off)

  let stbl_b : Array[Byte] = []
  push_arr(stbl_b, build_mp4a_stsd(2, 48000))
  push_arr(stbl_b, make_full_box("stts", 0, 0, stts_b))
  push_arr(stbl_b, make_full_box("stsc", 0, 0, stsc_b))
  push_arr(stbl_b, make_full_box("stz2", 0, 0, stz2_b))
  push_arr(stbl_b, make_full_box("co64", 0, 0, co64_b))

  let mdia_b : Array[Byte] = []
  push_arr(mdia_b, make_full_box("mdhd", 1, 0, mdhd1))
  push_arr(mdia_b, build_hdlr("soun"))
  push_arr(mdia_b, make_box("minf", make_box("stbl", stbl_b)))

  let trak_b : Array[Byte] = []
  push_arr(trak_b, make_full_box("tkhd", 1, 3, tkhd1))
  push_arr(trak_b, make_box("mdia", mdia_b))

  let moov_b : Array[Byte] = []
  push_arr(moov_b, make_full_box("mvhd", 1, 0, mvhd1))
  push_arr(moov_b, make_box("trak", trak_b))

  let file_arr : Array[Byte] = []
  push_arr(file_arr, ftyp)
  push_arr(file_arr, mdat)
  push_arr(file_arr, make_box("moov", moov_b))

  match parse_mp4(to_bytes(file_arr)) {
    Ok(mp4) => {
      debug_assert(mp4.mvhd.version == 1 && mp4.mvhd.duration == 5000000000L, "mvhd v1")
      let t = mp4.tracks[0]
      debug_assert(t.duration == 6000000000L && t.language == "jpn", "mdhd v1")
      debug_assert(t.sample_rate == 48000 && t.channels == 2, "audio sr/ch")
      debug_assert(t.samples.length() == 3, "stz2 3 samples")
      debug_assert(t.samples[0].size == 4 && t.samples[1].size == 5 && t.samples[2].size == 6, "stz2 sizes")
      debug_assert(t.samples[0].is_sync && t.samples[1].is_sync && t.samples[2].is_sync, "no stss => all sync")
    }
    Err(e) => debug_assert(false, "v1/co64/stz2 failed: " + mp4_error_message(e))
  }
}

test "fmp4: multi-traf chaining, trun v1 negative CTO, and limit bombs" {
  let init = match parse_init_segment(build_test_fmp4_init(), DecodeLimits::default()) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "init failed: " + mp4_error_message(e))
      return ()
    }
  }

  // Test 1: multi-traf in one moof (traf1 video with data_offset, traf2 audio chained without default_base_is_moof)
  let mfhd_b : Array[Byte] = []
  push_u32(mfhd_b, 2)
  let mfhd = make_full_box("mfhd", 0, 0, mfhd_b)

  // traf1: track 1, default_base_is_moof=1 (0x020000), tfdt v0=0, trun v1 with negative CTO (-1500)
  let tfhd1_b : Array[Byte] = []
  push_u32(tfhd1_b, 1)
  let tfhd1 = make_full_box("tfhd", 0, 131072, tfhd1_b)
  let tfdt1_b : Array[Byte] = []
  push_u32(tfdt1_b, 3000)
  let tfdt1 = make_full_box("tfdt", 0, 0, tfdt1_b)

  // traf2: track 2, flags=0 (inherits end of traf1!), tfdt v0=1024, trun v0 with sample_size only (no data_offset)
  let tfhd2_b : Array[Byte] = []
  push_u32(tfhd2_b, 2)
  let tfhd2 = make_full_box("tfhd", 0, 0, tfhd2_b)
  let tfdt2_b : Array[Byte] = []
  push_u32(tfdt2_b, 1024)
  let tfdt2 = make_full_box("tfdt", 0, 0, tfdt2_b)
  let trun2_b : Array[Byte] = []
  push_u32(trun2_b, 1)
  push_u32(trun2_b, 14) // size=14
  let trun2 = make_full_box("trun", 0, 512, trun2_b)
  let traf2_b : Array[Byte] = []
  push_arr(traf2_b, tfhd2)
  push_arr(traf2_b, tfdt2)
  push_arr(traf2_b, trun2)
  let traf2 = make_box("traf", traf2_b)

  // trun1: data_offset (0x1) | sample_size (0x200) | cto (0x800) = 0xA01 (2561), 1 sample
  let trun1_len = 12 + 4 + 4 + 8
  let traf1_len = 8 + tfhd1.length() + tfdt1.length() + trun1_len
  let moof_len = 8 + mfhd.length() + traf1_len + traf2.length()
  let data_off = moof_len + 8

  let trun1_b : Array[Byte] = []
  push_u32(trun1_b, 1)
  push_u32(trun1_b, data_off)
  push_u32(trun1_b, 20)
  push_u32u(trun1_b, 4294965796U) // -1500 as i32
  let trun1 = make_full_box("trun", 1, 2561, trun1_b)
  let traf1_b : Array[Byte] = []
  push_arr(traf1_b, tfhd1)
  push_arr(traf1_b, tfdt1)
  push_arr(traf1_b, trun1)
  let traf1 = make_box("traf", traf1_b)

  let moof_b : Array[Byte] = []
  push_arr(moof_b, mfhd)
  push_arr(moof_b, traf1)
  push_arr(moof_b, traf2)

  let mdat_p : Array[Byte] = []
  let mut i = 0
  while i < 34 {
    mdat_p.push(7.to_byte())
    i = i + 1
  }
  let seg_arr : Array[Byte] = []
  push_arr(seg_arr, make_box("moof", moof_b))
  push_arr(seg_arr, make_box("mdat", mdat_p))
  let seg_bytes = to_bytes(seg_arr)

  match parse_media_segment(init, seg_bytes, DecodeLimits::default()) {
    Ok(seg) => {
      debug_assert(seg.fragments.length() == 2, "2 trafs")
      let f1 = seg.fragments[0]
      let f2 = seg.fragments[1]
      debug_assert(f1.samples[0].dts == 3000L && f1.samples[0].pts == 1500L, "trun v1 negative cto")
      debug_assert(f2.samples[0].offset == (data_off + 20).to_int64(), "traf2 chained offset")
      debug_assert(f2.samples[0].size == 14 && f2.samples[0].is_sync, "traf2 audio sample")
    }
    Err(e) => debug_assert(false, "multi-traf failed: " + mp4_error_message(e))
  }

  // Test 2: max_moof_fragments == 0 rejects 1 moof
  match parse_media_segment(init, seg_bytes, DecodeLimits::new(1000, 32, 64, 1000, 0)) {
    Err(Mp4Error::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_moof_fragments=0 must reject")
  }

  // Test 3: max_depth == 2 rejects moov -> trak -> mdia -> minf -> stbl
  match parse_init_segment(build_test_fmp4_init(), DecodeLimits::new(1000, 2, 64, 1000, 100)) {
    Err(Mp4Error::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_depth=2 must reject")
  }

  // Test 4: max_tracks == 1 rejects 2-track init
  match parse_init_segment(build_test_fmp4_init(), DecodeLimits::new(1000, 32, 1, 1000, 100)) {
    Err(Mp4Error::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_tracks=1 must reject 2 tracks")
  }

  // Test 5: trun allocation bomb (declares 0x7fffffff samples in tiny box)
  let bomb_trun_b : Array[Byte] = []
  push_u32(bomb_trun_b, 2147483647)
  let bomb_traf_b : Array[Byte] = []
  push_arr(bomb_traf_b, tfhd1)
  push_arr(bomb_traf_b, make_full_box("trun", 0, 512, bomb_trun_b))
  let bomb_moof_b : Array[Byte] = []
  push_arr(bomb_moof_b, mfhd)
  push_arr(bomb_moof_b, make_box("traf", bomb_traf_b))
  match parse_media_segment(init, to_bytes(make_box("moof", bomb_moof_b)), DecodeLimits::default()) {
    Err(Mp4Error::LimitExceeded(_)) => ()
    _ => debug_assert(false, "trun 0x7fffffff bomb must fail with LimitExceeded")
  }
}
