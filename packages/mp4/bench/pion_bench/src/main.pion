///| Pion Native head-to-head benchmark for `packages/mp4`.
///| Modes:
///|   mp4       <file.mp4> <iters>
///|   fmp4      <init_file> <media_file> <iters>
///|   dump-mp4  <file.mp4>                 (full sample table for ffprobe oracle check)
///|   dump-fmp4 <init_file> <media_file>   (full sample table for ffprobe oracle check)

import "mp4"

///|
fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn write_full_samples(sb : StringBuilder, tid : UInt, samples : Array[mp4::Sample]) -> Unit {
  let mut i = 0
  while i < samples.length() {
    let s = samples[i]
    sb.write_string("s ")
    sb.write_string(tid.to_string())
    sb.write_string(" ")
    sb.write_string(s.offset.to_string())
    sb.write_string(" ")
    sb.write_string(s.size.to_string())
    sb.write_string(" ")
    sb.write_string(s.dts.to_string())
    sb.write_string(" ")
    sb.write_string(s.pts.to_string())
    sb.write_string(" ")
    sb.write_string(s.duration.to_string())
    sb.write_string(if s.is_sync { " 1\n" } else { " 0\n" })
    i = i + 1
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: mp4_bench <mp4|fmp4|dump-mp4|dump-fmp4> ...")
    return 1
  }
  let mode = args[1]

  if mode == "dump-mp4" {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 1
    }
    match mp4::parse_mp4(data) {
      Ok(f) => {
        let sb = StringBuilder::new()
        let mut ti = 0
        while ti < f.tracks.length() {
          write_full_samples(sb, f.tracks[ti].track_id, f.tracks[ti].samples)
          ti = ti + 1
        }
        io_print(world, sb.to_string())
        return 0
      }
      Err(e) => {
        io_println(world, "ERR " + mp4::mp4_error_message(e))
        return 1
      }
    }
  }

  if mode == "dump-fmp4" {
    let init_data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 1
    }
    let media_data = match fs_read_bytes(world, args[3]) {
      Ok(b) => b
      Err(_) => return 1
    }
    let lim = mp4::DecodeLimits::default()
    let init = match mp4::parse_init_segment(init_data, lim) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "ERR init " + mp4::mp4_error_message(e))
        return 1
      }
    }
    let seg = match mp4::parse_media_segment(init, media_data, lim) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "ERR media " + mp4::mp4_error_message(e))
        return 1
      }
    }
    let sb = StringBuilder::new()
    let mut fi = 0
    while fi < seg.fragments.length() {
      write_full_samples(sb, seg.fragments[fi].track_id, seg.fragments[fi].samples)
      fi = fi + 1
    }
    io_print(world, sb.to_string())
    return 0
  }

  if mode == "mp4" {
    let path = args[2]
    let iters = parse_int(args[3])
    let data = match fs_read_bytes(world, path) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read " + path)
        return 1
      }
    }
    let mut last_opt : Option[mp4::Mp4File] = None
    let mut total_samples : Int64 = 0L
    let mut r = 0
    while r < iters {
      match mp4::parse_mp4(data) {
        Ok(f) => {
          let mut ti = 0
          while ti < f.tracks.length() {
            total_samples = total_samples + f.tracks[ti].samples.length().to_int64()
            ti = ti + 1
          }
          if r == iters - 1 {
            last_opt = Some(f)
          }
        }
        Err(e) => {
          io_println(world, "parse_mp4 error: " + mp4::mp4_error_message(e))
          return 1
        }
      }
      r = r + 1
    }
    let f = match last_opt {
      Some(v) => v
      None => return 1
    }
    let sb = StringBuilder::new()
    sb.write_string("mode=mp4 iters=")
    sb.write_string(iters.to_string())
    sb.write_string(" total_samples=")
    sb.write_string(total_samples.to_string())
    sb.write_string(" tracks=")
    sb.write_string(f.tracks.length().to_string())
    sb.write_string("\n")
    let mut idx = 0
    let mut ti = 0
    while ti < f.tracks.length() {
      let t = f.tracks[ti]
      let mut si = 0
      while si < t.samples.length() {
        let s = t.samples[si]
        sb.write_string("p ")
        sb.write_string(idx.to_string())
        sb.write_string(" tid=")
        sb.write_string(t.track_id.to_string())
        sb.write_string(" sz=")
        sb.write_string(s.size.to_string())
        sb.write_string(" dur=")
        sb.write_string(s.duration.to_string())
        sb.write_string("\n")
        idx = idx + 1
        si = si + 1
      }
      ti = ti + 1
    }
    io_print(world, sb.to_string())
    return 0
  }

  if mode == "fmp4" {
    if args.length() < 5 {
      io_println(world, "usage: mp4_bench fmp4 <init_file> <media_file> <iters>")
      return 1
    }
    let init_path = args[2]
    let media_path = args[3]
    let iters = parse_int(args[4])
    let init_data = match fs_read_bytes(world, init_path) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read " + init_path)
        return 1
      }
    }
    let media_data = match fs_read_bytes(world, media_path) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read " + media_path)
        return 1
      }
    }
    let lim = mp4::DecodeLimits::default()
    let mut last_init : Option[mp4::InitSegment] = None
    let mut last_seg : Option[mp4::MediaSegment] = None
    let mut total_samples : Int64 = 0L
    let mut r = 0
    while r < iters {
      let init = match mp4::parse_init_segment(init_data, lim) {
        Ok(v) => v
        Err(e) => {
          io_println(world, "parse_init_segment error: " + mp4::mp4_error_message(e))
          return 1
        }
      }
      let seg = match mp4::parse_media_segment(init, media_data, lim) {
        Ok(v) => v
        Err(e) => {
          io_println(world, "parse_media_segment error: " + mp4::mp4_error_message(e))
          return 1
        }
      }
      let mut fi = 0
      while fi < seg.fragments.length() {
        total_samples = total_samples + seg.fragments[fi].samples.length().to_int64()
        fi = fi + 1
      }
      if r == iters - 1 {
        last_init = Some(init)
        last_seg = Some(seg)
      }
      r = r + 1
    }
    let init = match last_init {
      Some(v) => v
      None => return 1
    }
    let seg = match last_seg {
      Some(v) => v
      None => return 1
    }
    let sb = StringBuilder::new()
    sb.write_string("mode=fmp4 iters=")
    sb.write_string(iters.to_string())
    sb.write_string(" total_samples=")
    sb.write_string(total_samples.to_string())
    sb.write_string(" tracks=")
    sb.write_string(init.tracks.length().to_string())
    sb.write_string("\n")
    let mut idx = 0
    let mut fi = 0
    while fi < seg.fragments.length() {
      let f = seg.fragments[fi]
      let mut si = 0
      while si < f.samples.length() {
        let s = f.samples[si]
        sb.write_string("p ")
        sb.write_string(idx.to_string())
        sb.write_string(" tid=")
        sb.write_string(f.track_id.to_string())
        sb.write_string(" sz=")
        sb.write_string(s.size.to_string())
        sb.write_string(" dur=")
        sb.write_string(s.duration.to_string())
        sb.write_string("\n")
        idx = idx + 1
        si = si + 1
      }
      fi = fi + 1
    }
    io_print(world, sb.to_string())
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
