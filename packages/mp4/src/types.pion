///| Public types, errors, and resource limits for `packages/mp4`.
///| Pure Pion implementation of ISO/IEC 14496-12 (ISO BMFF / MP4 / fMP4)
///| and W3C MSE ISO BMFF Byte Stream Format.

///| Default maximum total boxes parsed in a single call.
pub let default_max_boxes : Int = 65536

///| Default maximum box nesting depth.
pub let default_max_depth : Int = 32

///| Default maximum number of tracks in a movie/init segment.
pub let default_max_tracks : Int = 64

///| Default maximum total samples extracted across all tracks/fragments.
pub let default_max_samples : Int = 4194304

///| Default maximum number of `moof` fragments in a media segment.
pub let default_max_moof_fragments : Int = 65536

///| Resource limits to defend against malicious/crafted MP4 files.
///| Any negative value is immediately rejected with `LimitExceeded`.
///| A value of `0` allows zero items of that category (never unlimited).
pub val struct DecodeLimits {
  pub max_boxes : Int
  pub max_depth : Int
  pub max_tracks : Int
  pub max_samples : Int
  pub max_moof_fragments : Int
}

///| Default safe decoding limits.
pub fn DecodeLimits::default() -> DecodeLimits {
  DecodeLimits::{
    max_boxes: default_max_boxes,
    max_depth: default_max_depth,
    max_tracks: default_max_tracks,
    max_samples: default_max_samples,
    max_moof_fragments: default_max_moof_fragments,
  }
}

///| Create custom decoding limits.
pub fn DecodeLimits::new(
  max_boxes : Int,
  max_depth : Int,
  max_tracks : Int,
  max_samples : Int,
  max_moof_fragments : Int,
) -> DecodeLimits {
  DecodeLimits::{
    max_boxes: max_boxes,
    max_depth: max_depth,
    max_tracks: max_tracks,
    max_samples: max_samples,
    max_moof_fragments: max_moof_fragments,
  }
}

///| Error returned by MP4 / fMP4 parsing and demuxing.
pub enum Mp4Error {
  Truncated(String)
  InvalidBoxSize(String)
  InvalidSyntax(String)
  LimitExceeded(String)
  Unsupported(String)
}

///| Human-readable description of an `Mp4Error`.
pub fn mp4_error_message(err : Mp4Error) -> String {
  match err {
    Truncated(msg) => "truncated: " + msg
    InvalidBoxSize(msg) => "invalid box size: " + msg
    InvalidSyntax(msg) => "invalid syntax: " + msg
    LimitExceeded(msg) => "limit exceeded: " + msg
    Unsupported(msg) => "unsupported: " + msg
  }
}

///|
pub fn Mp4Error::to_string(self : Mp4Error) -> String {
  mp4_error_message(self)
}

///| Parsed ISO BMFF box header.
pub struct BoxHeader {
  pub box_type : String
  pub box_type_u32 : UInt
  pub offset : Int64
  pub size : Int64
  pub header_size : Int
  pub payload_offset : Int64
  pub payload_size : Int64
  pub uuid : Bytes
}

///| `ftyp` / `styp` file or segment type box.
pub struct FtypBox {
  pub major_brand : String
  pub minor_version : UInt
  pub compatible_brands : Array[String]
}

///| `mvhd` movie header box (v0/v1).
pub val struct MovieHeader {
  pub version : Int
  pub timescale : UInt
  pub duration : Int64
}

///| `trex` track extends box (fMP4 default sample parameters).
pub val struct TrexBox {
  pub track_id : UInt
  pub default_sample_description_index : UInt
  pub default_sample_duration : UInt
  pub default_sample_size : UInt
  pub default_sample_flags : UInt
}

///| High-level track media kind derived from `hdlr`.
pub enum TrackKind {
  Video
  Audio
  Subtitle
  Other(String)
}

///| Codec-specific configuration extracted from `stsd` child boxes.
pub enum CodecConfig {
  ///| `avcC` raw bytes, profile_idc, profile_compatibility, level_idc
  Avc(Bytes, Int, Int, Int)
  ///| `hvcC` raw bytes, general_profile_idc, general_tier_flag, general_level_idc
  Hevc(Bytes, Int, Int, Int)
  ///| `av1C` raw bytes, seq_profile, seq_level_idx_0, seq_tier_0, bit_depth
  Av1(Bytes, Int, Int, Int, Int)
  ///| `vpcC` raw bytes, profile, level, bit_depth
  Vp9(Bytes, Int, Int, Int)
  ///| `vpcC` raw bytes
  Vp8(Bytes)
  ///| `AudioSpecificConfig` raw bytes, object_type_indication, audio_object_type
  Aac(Bytes, Int, Int)
  ///| `dOps` raw bytes, output_channel_count, pre_skip
  Opus(Bytes, Int, Int)
  ///| `dfLa` raw bytes
  Flac(Bytes)
  ///| MP3 object_type_indication (0x6B / 0x69 / 0)
  Mp3(Int)
  ///| Unrecognized codec FourCC + raw bytes
  Unknown(String, Bytes)
}

///| A single media sample with byte range and timing in track timescale units.
pub val struct Sample {
  pub offset : Int64
  pub size : Int
  pub dts : Int64
  pub pts : Int64
  pub duration : Int64
  pub is_sync : Bool
}

///| Single entry in a track's `edts`/`elst` edit list box.
pub val struct EditEntry {
  pub segment_duration : Int64
  pub media_time : Int64
  pub media_rate_integer : Int
  pub media_rate_fraction : Int
}

///| Parsed track metadata and (for non-fragmented MP4) sample table.
pub struct Track {
  pub track_id : UInt
  pub kind : TrackKind
  pub handler_type : String
  pub timescale : UInt
  pub duration : Int64
  pub tkhd_duration : Int64
  pub language : String
  pub width : Int
  pub height : Int
  pub sample_rate : Int
  pub channels : Int
  pub codec_fourcc : String
  pub codec_config : CodecConfig
  pub edit_list : Array[EditEntry]
  pub samples : Array[Sample]
}

///| Return the sample table of a track.
pub fn Track::samples(self : Track) -> Array[Sample] {
  self.samples
}

///| Parsed traditional MP4 file (`ftyp` + `moov`).
pub struct Mp4File {
  pub ftyp : Option[FtypBox]
  pub mvhd : MovieHeader
  pub tracks : Array[Track]
  pub trex : Array[TrexBox]
}

///| Parsed MSE / fMP4 initialization segment (`ftyp` + `moov` + `mvex`/`trex`).
pub struct InitSegment {
  pub ftyp : FtypBox
  pub mvhd : MovieHeader
  pub tracks : Array[Track]
  pub trex : Array[TrexBox]
}

///| Single subsegment entry inside a `sidx` box.
pub val struct SidxReference {
  pub reference_type : Int
  pub referenced_size : UInt
  pub subsegment_duration : UInt
  pub starts_with_sap : Bool
  pub sap_type : Int
  pub sap_delta_time : UInt
}

///| `sidx` segment index box (v0/v1).
pub struct SidxBox {
  pub version : Int
  pub reference_id : UInt
  pub timescale : UInt
  pub earliest_presentation_time : Int64
  pub first_offset : Int64
  pub references : Array[SidxReference]
}

///| Single track fragment (`traf`) parsed from a `moof` box.
pub struct Fragment {
  pub sequence_number : UInt
  pub track_id : UInt
  pub base_decode_time : Int64
  pub samples : Array[Sample]
}

///| Parsed MSE / fMP4 media segment (`styp` / `sidx` / `moof` + `mdat`).
pub struct MediaSegment {
  pub styp : Option[FtypBox]
  pub sidx : Array[SidxBox]
  pub fragments : Array[Fragment]
  pub start_pts_ms : Int64
  pub end_pts_ms : Int64
}
