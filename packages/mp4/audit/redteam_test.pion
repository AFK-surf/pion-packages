///| Red-team unit tests for `packages/mp4` (RT-mp4 audit, base `feat/pkg-mp4` @ a0084452).
///| Convention (same as the other `packages/*/audit` suites): a `redteam_*` test encodes the *expected
///| correct* behaviour, so it FAILS while the defect exists and PASSES once fixed; `control_*` tests pin
///| behaviour that is already correct and must PASS.  Vectors are generated by `vectors.py` (block
///| between the BEGIN/END markers, `python3 vectors.py pion`); FFmpeg/ffprobe evidence is in REPORT.md.

import "mp4"

///|
fn hexv(c : Int) -> Int {
  if c >= 97 {
    c - 87
  } else {
    c - 48
  }
}

///|
fn hexb(s : String) -> Bytes {
  let n = s.length() / 2
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = ((hexv(s.code_unit_at(2 * i)) << 4) | hexv(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  b
}

///|
fn lim() -> mp4::DecodeLimits {
  mp4::DecodeLimits::default()
}

///|
fn mp4_samples(data : Bytes) -> Option[Array[mp4::Sample]] {
  match mp4::parse_mp4(data) {
    Ok(f) => if f.tracks.length() > 0 { Some(f.tracks[0].samples) } else { None }
    Err(_) => None
  }
}

///|
fn segment(init_b : Bytes, media_b : Bytes) -> Option[mp4::MediaSegment] {
  match mp4::parse_init_segment(init_b, lim()) {
    Ok(init) =>
    match mp4::parse_media_segment(init, media_b, lim()) {
      Ok(s) => Some(s)
      Err(_) => None
    }
    Err(_) => None
  }
}

///|
fn seg_samples(s : mp4::MediaSegment) -> Int {
  let mut n = 0
  let mut i = 0
  while i < s.fragments.length() {
    n = n + s.fragments[i].samples.length()
    i = i + 1
  }
  n
}

// ---------------------------------------------------------------------------------------------
// P1: resource amplification within the default limits

///| P1-1: a 679-byte init+media pair yields 4,194,304 samples (~195 MB native / ~435 MB wasm32 RSS):
///| a `trun` with no per-sample fields costs 0 table bytes per sample and trex default size 0 keeps
///| every sample in bounds.  Expected: samples bounded by the input size (or `LimitExceeded`).
test "redteam_p1_trun_zero_byte_samples_amplification_bounded_by_input" {
  let a = v_dos_trun_zero_byte_samples()
  let b = v_dos_trun_zero_byte_samples_media()
  let budget = 2 * (a.length() + b.length())
  match segment(a, b) {
    Some(s) => debug_assert(seg_samples(s) <= budget, "samples " + seg_samples(s).to_string() + " > 2 x input bytes")
    None => ()
  }
}

///| P1-2: 8.7 KB MP4: 1024 `stco` chunks at the same offset x `stsc` 4096 samples/chunk x constant
///| `stsz` 1 -> 4,194,304 samples (~200 MB RSS).  Expected: bounded by input size (or an error).
test "redteam_p1_overlapping_chunks_amplification_bounded_by_input" {
  let a = v_dos_overlapping_chunks()
  match mp4_samples(a) {
    Some(s) => debug_assert(s.length() <= 2 * a.length(), "samples " + s.length().to_string() + " > 2 x input bytes")
    None => ()
  }
}

// ---------------------------------------------------------------------------------------------
// P1: wrong timestamps on input FFmpeg / browsers accept

///| P1-3: `ctts` v0 offset 0xFFFFFFD8 must be read as -40 (ffprobe pts 40; FFmpeg, Chromium, GPAC
///| read the field as signed for both versions).  Pion: pts = 4294967336.
test "redteam_p1_ctts_v0_offset_is_signed" {
  match mp4_samples(v_ctts_v0_negative()) {
    Some(s) => debug_assert(s[2].pts == 40L, "sample 2 pts " + s[2].pts.to_string() + " (ffprobe 40)")
    None => debug_assert(false, "parse failed")
  }
}

///| P1-4: `trun` v0 composition offset 0xFFFFFC00 must be -1024 (ffprobe: pts == dts - 1024 + shift).
///| Pion: pts = dts + 4294966272, MSE range ~4.29e9 ms.
test "redteam_p1_trun_v0_cto_is_signed" {
  match segment(v_trun_v0_negative_cto(), v_trun_v0_negative_cto_media()) {
    Some(s) => {
      let sm = s.fragments[0].samples[0]
      debug_assert(sm.pts == sm.dts - 1024L, "pts-dts = " + (sm.pts - sm.dts).to_string())
    }
    None => debug_assert(false, "parse failed")
  }
}

// ---------------------------------------------------------------------------------------------
// P2: correctness / spec deviations

///| P2-1: `tfdt` v1 = 2^62 at timescale 1000: `pts * 1000L` wraps Int64 to 0 -> range 0..40 ms.
test "redteam_p2_mse_range_ms_overflow" {
  match segment(v_tfdt_huge_ms_overflow(), v_tfdt_huge_ms_overflow_media()) {
    Some(s) => debug_assert(s.start_pts_ms == 4611686018427387904L, "start_pts_ms " + s.start_pts_ms.to_string())
    None => debug_assert(false, "parse failed")
  }
}

///| P2-2: `tfdt` v1 >= 2^63 becomes a negative base_decode_time; must be rejected (ffprobe: N/A + discard).
test "redteam_p2_tfdt_sign_bit_rejected" {
  match segment(v_tfdt_sign_bit(), v_tfdt_sign_bit_media()) {
    Some(s) => debug_assert(s.fragments[0].base_decode_time >= 0L, "negative base_decode_time accepted")
    None => ()
  }
}

///| P2-3: `trun` sample_duration 0x80000000 is a legal u32 (ffprobe duration 2147483648); rejected.
test "redteam_p2_trun_duration_ge_2p31_accepted" {
  debug_assert(segment(v_trun_duration_2p31(), v_trun_duration_2p31_media()) is Some(_), "rejected legal u32 duration")
}

///| P2-4: `stts` sample_delta 0x80000000 is a legal u32 (ffprobe parses); whole file rejected.
test "redteam_p2_stts_delta_ge_2p31_accepted" {
  debug_assert(mp4_samples(v_stts_delta_2p31()) is Some(_), "rejected legal u32 stts delta")
}

///| P2-5: `traf` for a track_id absent from the init segment is accepted with the movie timescale and
///| no `trex` defaults (FFmpeg: "trun track id unknown"; MSE: decode error).  Expected: Err or skipped.
test "redteam_p2_unknown_track_fragment_rejected" {
  match segment(v_unknown_track_fragment(), v_unknown_track_fragment_media()) {
    Some(s) => debug_assert(s.fragments.length() == 0, "fragment for undeclared track 7 accepted")
    None => ()
  }
}

///| P2-6: `find_sync_sample_at` binary-searches decode-order samples by pts, which is not monotonic
///| with B-frames / ctts; target 200 must give sample 3 (pts 180), not sample 0 (pts 40).
test "redteam_p2_seek_nonmonotonic_pts" {
  match mp4_samples(v_seek_nonmonotonic_pts()) {
    Some(s) =>
    match mp4::find_sync_sample_at(s, 200L) {
      Some(i) => debug_assert(i == 3, "got sample " + i.to_string())
      None => debug_assert(false, "none")
    }
    None => debug_assert(false, "parse failed")
  }
}

///| P2-7: `edts`/`elst` ignored: with media_time 80 the first sample presents at 0 (ffprobe pts 0);
///| Pion reports 80 for every FFmpeg/x264 B-frame or AAC-priming file (ffprobe shift -1024 ticks).
test "redteam_p2_edit_list_media_time_applied" {
  match mp4_samples(v_edit_list_media_time()) {
    Some(s) => debug_assert(s[0].pts == 0L, "first pts " + s[0].pts.to_string() + " (elst media_time 80)")
    None => debug_assert(false, "parse failed")
  }
}

///| P2-8: `hvcC` general_profile_space 1 must prefix the profile with 'A' (ISO 14496-15 Annex E).
test "redteam_p2_hevc_codec_string_profile_space" {
  match mp4::parse_mp4(v_hevc_profile_space()) {
    Ok(f) => {
      let c = mp4::probe_codec_string(f.tracks[0])
      debug_assert(c == "hvc1.A1.6.L93.90", "codec " + c)
    }
    Err(_) => debug_assert(false, "parse failed")
  }
}

///| P2-9: a sample presented at -1/90000 s must floor to -1 ms; truncating division yields 0.
test "redteam_p2_mse_range_negative_pts_floor" {
  match segment(v_negative_pts_ms_trunc(), v_negative_pts_ms_trunc_media()) {
    Some(s) => debug_assert(s.start_pts_ms == -1L, "start_pts_ms " + s.start_pts_ms.to_string())
    None => debug_assert(false, "parse failed")
  }
}

// ---------------------------------------------------------------------------------------------
// Controls: hostile inputs already handled correctly

///|
test "control_largesize_sign_bit_rejected" {
  debug_assert(mp4::parse_top_level_boxes(v_ctrl_largesize_sign(), lim()) is Err(mp4::Mp4Error::InvalidBoxSize(_)), "largesize 2^64-1")
}

///|
test "control_trun_negative_data_offset_rejected" {
  debug_assert(segment(v_ctrl_trun_negative_data_offset(), v_ctrl_trun_negative_data_offset_media()) is None, "data_offset -2^31")
}

///|
test "control_tfhd_base_data_offset_sign_bit_rejected" {
  debug_assert(segment(v_ctrl_bdo_sign_bit(), v_ctrl_bdo_sign_bit_media()) is None, "bdo 0xFFFFFFFFFFFFFFF0")
}

///|
test "control_timescale_zero_no_division" {
  match segment(v_ctrl_timescale_zero(), v_ctrl_timescale_zero_media()) {
    Some(s) => debug_assert(s.start_pts_ms == 0L && s.end_pts_ms == 0L, "range")
    None => debug_assert(false, "parse failed")
  }
}

///|
test "control_stsc_samples_per_chunk_zero_skips_chunk" {
  match mp4_samples(v_ctrl_stsc_spc_zero()) {
    Some(s) => debug_assert(s.length() == 2 && s[1].offset == s[0].offset + 8L, "samples")
    None => debug_assert(false, "parse failed")
  }
}

///|
test "control_stz2_4bit_odd_count" {
  match mp4_samples(v_ctrl_stz2_4bit_odd()) {
    Some(s) => debug_assert(s.length() == 3 && s[0].size == 1 && s[1].size == 2 && s[2].size == 3, "sizes")
    None => debug_assert(false, "parse failed")
  }
}

///|
test "control_stsz_count_without_chunks_rejected" {
  debug_assert(mp4::parse_mp4(v_dos_stsz_prealloc()) is Err(_), "stsz 4M without stco")
}

///|
test "control_max_samples_limit_enforced" {
  let small = mp4::DecodeLimits::new(65536, 32, 64, 1000, 65536)
  match mp4::parse_init_segment(v_dos_trun_zero_byte_samples(), small) {
    Ok(init) =>
    debug_assert(
      mp4::parse_media_segment(init, v_dos_trun_zero_byte_samples_media(), small) is Err(mp4::Mp4Error::LimitExceeded(_)),
      "max_samples 1000",
    )
    Err(_) => debug_assert(false, "init failed")
  }
}

///|
test "control_seek_monotonic_pts" {
  match mp4_samples(v_ctrl_stz2_4bit_odd()) {
    Some(s) =>
    match mp4::find_sync_sample_at(s, 50L) {
      Some(i) => debug_assert(i == 1, "got " + i.to_string())
      None => debug_assert(false, "none")
    }
    None => debug_assert(false, "parse failed")
  }
}

