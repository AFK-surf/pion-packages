///| Pion Native differential oracle & head-to-head benchmark for `packages/opentype`.
///| Usage:
///|   opentype_pion_bench diff  <font_path> <face_index>
///|   opentype_pion_bench bench <font_path> <face_index> <iters>

import "opentype"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn fnv1a_i64(h : UInt64, v : Int64) -> UInt64 {
  let x = h ^ v.to_uint64()
  x * 1099511628211UL
}

fn q4(v : Double) -> Int64 {
  if v >= 0.0 {
    (v * 16.0 + 0.5).to_int64()
  } else {
    (v * 16.0 - 0.5).to_int64()
  }
}

fn hash_outline(h_in : UInt64, ob : opentype::OutlineBuilder) -> UInt64 {
  let mut h = h_in
  let n = ob.commands.length()
  let mut i = 0
  while i < n {
    match ob.commands[i] {
      opentype::PathCommand::MoveTo(x, y) => {
        h = fnv1a_i64(h, 1L)
        h = fnv1a_i64(h, q4(x))
        h = fnv1a_i64(h, q4(y))
      }
      opentype::PathCommand::LineTo(x, y) => {
        h = fnv1a_i64(h, 2L)
        h = fnv1a_i64(h, q4(x))
        h = fnv1a_i64(h, q4(y))
      }
      opentype::PathCommand::QuadTo(cx, cy, x, y) => {
        h = fnv1a_i64(h, 3L)
        h = fnv1a_i64(h, q4(cx))
        h = fnv1a_i64(h, q4(cy))
        h = fnv1a_i64(h, q4(x))
        h = fnv1a_i64(h, q4(y))
      }
      opentype::PathCommand::Close => {
        h = fnv1a_i64(h, 4L)
      }
    }
    i = i + 1
  }
  h
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: opentype_pion_bench <diff|bench> <font_path> <face_index> [iters]")
    return 1
  }
  let mode = args[1]
  let font_bytes = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read font")
      return 1
    }
  }
  let face_idx = parse_int(args[3])

  if mode == "diff" {
    let ttc_cnt = match opentype::fonts_in_collection(font_bytes) {
      Some(c) => c
      None => 0
    }
    let face = match opentype::Face::parse(font_bytes, face_idx) {
      Ok(f) => f
      Err(e) => {
        io_println(world, "PARSE_ERR " + e.to_string())
        return 1
      }
    }
    let ng = face.number_of_glyphs()
    let bb = face.global_bounding_box()
    let (h_asc, h_desc, h_gap) = match face.hhea() {
      Some(h) => (h.ascender, h.descender, h.line_gap)
      None => (0, 0, 0)
    }
    let (w_cls, wd_cls, t_asc, t_desc, t_gap, xh, ch) = match face.os2() {
      Some(o) => {
        let xhv = match o.x_height {
          Some(v) => v
          None => -99999
        }
        let chv = match o.cap_height {
          Some(v) => v
          None => -99999
        }
        (o.weight_class, o.width_class, o.typo_ascender, o.typo_descender, o.typo_line_gap, xhv, chv)
      }
      None => (0, 0, 0, 0, 0, -99999, -99999)
    }
    let (u_pos, u_thick, fixed_p) = match face.post() {
      Some(p) => (p.underline_position, p.underline_thickness, if p.is_fixed_pitch { 1 } else { 0 })
      None => (0, 0, 0)
    }

    // 1. Full Unicode cmap sweep (0..=0x10FFFF skipping surrogates)
    let mut cmap_h : UInt64 = 14695981039346656037UL
    let mut cmap_cnt = 0
    let mut cp = 0
    while cp <= 0x10FFFF {
      if cp == 0xD800 {
        cp = 0xE000
      }
      match face.glyph_index(cp) {
        Some(gid) => {
          cmap_cnt = cmap_cnt + 1
          cmap_h = fnv1a_i64(cmap_h, cp.to_int64())
          cmap_h = fnv1a_i64(cmap_h, gid.to_int64())
        }
        None => ()
      }
      cp = cp + 1
    }

    // 2. Full hmtx sweep
    let mut hmtx_h : UInt64 = 14695981039346656037UL
    let mut gid = 0
    while gid < ng {
      let adv = match face.glyph_hor_advance(gid) {
        Some(v) => v
        None => -1
      }
      let lsb = match face.glyph_hor_side_bearing(gid) {
        Some(v) => v
        None => -99999
      }
      hmtx_h = fnv1a_i64(hmtx_h, adv.to_int64())
      hmtx_h = fnv1a_i64(hmtx_h, lsb.to_int64())
      gid = gid + 1
    }

    // 3. kern sweep (0..min(ng, 256) x 0..min(ng, 256))
    let kern_lim = if ng < 256 { ng } else { 256 }
    let mut kern_h : UInt64 = 14695981039346656037UL
    let mut kern_nz = 0
    let mut l = 0
    while l < kern_lim {
      let mut r = 0
      while r < kern_lim {
        let kv = face.kerning(l, r)
        if kv != 0 {
          kern_nz = kern_nz + 1
          kern_h = fnv1a_i64(kern_h, l.to_int64())
          kern_h = fnv1a_i64(kern_h, r.to_int64())
          kern_h = fnv1a_i64(kern_h, kv.to_int64())
        }
        r = r + 1
      }
      l = l + 1
    }

    // 4. Full glyf bbox sweep + outline sweep (0..min(ng, 512))
    let mut bbox_h : UInt64 = 14695981039346656037UL
    let mut bbox_cnt = 0
    let mut out_h : UInt64 = 14695981039346656037UL
    let mut out_cmds = 0
    let out_lim = if ng < 512 { ng } else { 512 }
    let ob = opentype::OutlineBuilder::new()
    gid = 0
    while gid < ng {
      match face.glyph_bounding_box(gid) {
        Ok(Some(r)) => {
          bbox_cnt = bbox_cnt + 1
          bbox_h = fnv1a_i64(bbox_h, gid.to_int64())
          bbox_h = fnv1a_i64(bbox_h, r.x_min.to_int64())
          bbox_h = fnv1a_i64(bbox_h, r.y_min.to_int64())
          bbox_h = fnv1a_i64(bbox_h, r.x_max.to_int64())
          bbox_h = fnv1a_i64(bbox_h, r.y_max.to_int64())
        }
        _ => ()
      }
      if gid < out_lim {
        ob.clear()
        match face.outline_glyph(gid, ob) {
          Ok(Some(_)) => {
            out_cmds = out_cmds + ob.len()
            out_h = fnv1a_i64(out_h, gid.to_int64())
            out_h = hash_outline(out_h, ob)
          }
          _ => ()
        }
      }
      gid = gid + 1
    }

    // 5. fvar axes hash
    let axes = face.variation_axes()
    let mut fvar_h : UInt64 = 14695981039346656037UL
    let mut ai = 0
    while ai < axes.length() {
      let ax = axes[ai]
      fvar_h = fnv1a_i64(fvar_h, ax.tag.value)
      fvar_h = fnv1a_i64(fvar_h, ax.min_fixed)
      fvar_h = fnv1a_i64(fvar_h, ax.default_fixed)
      fvar_h = fnv1a_i64(fvar_h, ax.max_fixed)
      fvar_h = fnv1a_i64(fvar_h, ax.name_id.to_int64())
      ai = ai + 1
    }

    io_println(
      world,
      "ttc=" + ttc_cnt.to_string() +
      " upem=" + face.units_per_em().to_string() +
      " ng=" + ng.to_string() +
      " bbox=" + bb.x_min.to_string() + "," + bb.y_min.to_string() + "," + bb.x_max.to_string() + "," + bb.y_max.to_string(),
    )
    io_println(
      world,
      "hhea=" + h_asc.to_string() + "," + h_desc.to_string() + "," + h_gap.to_string() +
      " os2=" + w_cls.to_string() + "," + wd_cls.to_string() + "," + t_asc.to_string() + "," + t_desc.to_string() + "," + t_gap.to_string() + "," + xh.to_string() + "," + ch.to_string() +
      " post=" + u_pos.to_string() + "," + u_thick.to_string() + "," + fixed_p.to_string(),
    )
    io_println(
      world,
      "cmap_cnt=" + cmap_cnt.to_string() + " cmap_h=" + cmap_h.to_string() +
      " hmtx_h=" + hmtx_h.to_string() +
      " kern_nz=" + kern_nz.to_string() + " kern_h=" + kern_h.to_string(),
    )
    io_println(
      world,
      "bbox_cnt=" + bbox_cnt.to_string() + " bbox_h=" + bbox_h.to_string() +
      " out_cmds=" + out_cmds.to_string() + " out_h=" + out_h.to_string() +
      " fvar_n=" + axes.length().to_string() + " fvar_h=" + fvar_h.to_string(),
    )
    return 0
  }

  if mode == "bench" {
    if args.length() < 5 {
      io_println(world, "usage: opentype_pion_bench bench <font_path> <face_index> <iters>")
      return 1
    }
    let iters = parse_int(args[4])
    let mut h : UInt64 = 14695981039346656037UL
    let ob = opentype::OutlineBuilder::new()
    let mut it = 0
    while it < iters {
      let face = match opentype::Face::parse(font_bytes, face_idx) {
        Ok(f) => f
        Err(_) => return 1
      }
      let ng = face.number_of_glyphs()
      h = fnv1a_i64(h, face.units_per_em().to_int64())
      // 256 cmap + hmtx lookups
      let mut cp = 32
      while cp < 288 {
        match face.glyph_index(cp) {
          Some(gid) => {
            h = fnv1a_i64(h, gid.to_int64())
            match face.glyph_hor_advance(gid) {
              Some(adv) => h = fnv1a_i64(h, adv.to_int64())
              None => ()
            }
          }
          None => ()
        }
        cp = cp + 1
      }
      // 64 glyph outlines
      let out_lim = if ng < 64 { ng } else { 64 }
      let mut g = 0
      while g < out_lim {
        ob.clear()
        match face.outline_glyph(g, ob) {
          Ok(Some(_)) => h = hash_outline(h, ob)
          _ => ()
        }
        g = g + 1
      }
      it = it + 1
    }
    io_println(world, "BENCH_OK iters=" + iters.to_string() + " hash=" + h.to_string())
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
