}

fn decode_mac_roman(data : Bytes, start : Int, len : Int) -> Option[String] {
  if len < 0 || len > max_name_bytes || start < 0 || start + len > data.length() {
    return None
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    let b = read_u8(data, start + i)
    if b < 0x80 {
      sb.write_byte(b.to_byte())
    } else {
      write_utf8_codepoint(sb, mac_roman_high_to_unicode(b))
    }
    i = i + 1
  }
  Some(sb.to_string())
}
