///| Big-endian binary reading helpers, bounds checks, and UTF-16BE / Mac Roman decoders.

fn check_range(data_len : Int, offset : Int64, length : Int64) -> Bool {
  if offset < 0L || length < 0L {
    return false
  }
  let dl = data_len.to_int64()
  offset <= dl && length <= dl - offset
}

fn read_u8(data : Bytes, pos : Int) -> Int {
  data[pos].to_int()
}

fn read_i8(data : Bytes, pos : Int) -> Int {
  let v = data[pos].to_int()
  (v ^ 128) - 128
}

fn read_u16_be(data : Bytes, pos : Int) -> Int {
  (data[pos].to_int() << 8) | data[pos + 1].to_int()
}

fn read_i16_be(data : Bytes, pos : Int) -> Int {
  let u = (data[pos].to_int() << 8) | data[pos + 1].to_int()
  (u ^ 32768) - 32768
}

fn read_u24_be(data : Bytes, pos : Int) -> Int {
  (data[pos].to_int() << 16) |
  (data[pos + 1].to_int() << 8) |
  data[pos + 2].to_int()
}

fn read_u32_be(data : Bytes, pos : Int) -> Int64 {
  (data[pos].to_int().to_int64() << 24) |
  (data[pos + 1].to_int().to_int64() << 16) |
  (data[pos + 2].to_int().to_int64() << 8) |
  data[pos + 3].to_int().to_int64()
}

fn read_i32_be(data : Bytes, pos : Int) -> Int64 {
  let u = read_u32_be(data, pos)
  if u >= 0x80000000L { u - 0x100000000L } else { u }
}

fn f2dot14_to_double(v : Int) -> Double {
  v.to_double() / 16384.0
}

fn write_utf8_codepoint(sb : StringBuilder, cp : Int) -> Unit {
  if cp >= 0 && cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0x10FFFF {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte(0xEF.to_byte())
    sb.write_byte(0xBF.to_byte())
    sb.write_byte(0xBD.to_byte())
  }
}

fn decode_utf16be(data : Bytes, start : Int, len : Int) -> Option[String] {
  if len < 0 || len > max_name_bytes || start < 0 || start + len > data.length() {
    return None
  }
  let sb = StringBuilder::new()
  let end = start + (len & -2)
  let mut i = start
  while i < end {
    let cu = read_u16_be(data, i)
    i = i + 2
    if cu >= 0xD800 && cu <= 0xDBFF {
      if i + 2 <= end {
        let low = read_u16_be(data, i)
        if low >= 0xDC00 && low <= 0xDFFF {
          i = i + 2
          let cp = 0x10000 + ((cu - 0xD800) << 10) + (low - 0xDC00)
          write_utf8_codepoint(sb, cp)
        } else {
          write_utf8_codepoint(sb, 0xFFFD)
        }
      } else {
        write_utf8_codepoint(sb, 0xFFFD)
      }
    } else if cu >= 0xDC00 && cu <= 0xDFFF {
      write_utf8_codepoint(sb, 0xFFFD)
    } else {
      write_utf8_codepoint(sb, cu)
    }
  }
  Some(sb.to_string())
}

