    0xC7 => 0x00AB
    0xC8 => 0x00BB
    0xC9 => 0x2026
    0xCA => 0x00A0
    0xCB => 0x00C0
    0xCC => 0x00C3
    0xCD => 0x00D5
    0xCE => 0x0152
    0xCF => 0x0153
    0xD0 => 0x2013
    0xD1 => 0x2014
    0xD2 => 0x201C
    0xD3 => 0x201D
    0xD4 => 0x2018
    0xD5 => 0x2019
    0xD6 => 0x00F7
    0xD7 => 0x25CA
    0xD8 => 0x00FF
    0xD9 => 0x0178
    0xDA => 0x2044
    0xDB => 0x20AC
    0xDC => 0x2039
    0xDD => 0x203A
    0xDE => 0xFB01
    0xDF => 0xFB02
    0xE0 => 0x2021
    0xE1 => 0x00B7
    0xE2 => 0x201A
    0xE3 => 0x201E
    0xE4 => 0x2030
    0xE5 => 0x00C2
    0xE6 => 0x00CA
    0xE7 => 0x00C1
    0xE8 => 0x00CB
    0xE9 => 0x00C8
    0xEA => 0x00CD
    0xEB => 0x00CE
    0xEC => 0x00CF
    0xED => 0x00CC
    0xEE => 0x00D3
    0xEF => 0x00D4
    0xF0 => 0xF8FF
    0xF1 => 0x00D2
    0xF2 => 0x00DA
    0xF3 => 0x00DB
    0xF4 => 0x00D9
    0xF5 => 0x0131
    0xF6 => 0x02C6
    0xF7 => 0x02DC
    0xF8 => 0x00AF
