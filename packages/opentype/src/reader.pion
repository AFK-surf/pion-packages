    0x9F => 0x00FC
    0xA0 => 0x2020
    0xA1 => 0x00B0
    0xA2 => 0x00A2
    0xA3 => 0x00A3
    0xA4 => 0x00A7
    0xA5 => 0x2022
    0xA6 => 0x00B6
    0xA7 => 0x00DF
    0xA8 => 0x00AE
    0xA9 => 0x00A9
    0xAA => 0x2122
    0xAB => 0x00B4
    0xAC => 0x00A8
    0xAD => 0x2260
    0xAE => 0x00C6
    0xAF => 0x00D8
    0xB0 => 0x221E
    0xB1 => 0x00B1
    0xB2 => 0x2264
    0xB3 => 0x2265
    0xB4 => 0x00A5
    0xB5 => 0x00B5
    0xB6 => 0x2202
    0xB7 => 0x2211
    0xB8 => 0x220F
    0xB9 => 0x03C0
    0xBA => 0x222B
    0xBB => 0x00AA
    0xBC => 0x00BA
    0xBD => 0x03A9
    0xBE => 0x00E6
    0xBF => 0x00F8
    0xC0 => 0x00BF
    0xC1 => 0x00A1
