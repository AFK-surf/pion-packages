///| Core OpenType metadata and metrics table parsers:
///| `head`, `maxp`, `hhea`, `vhea`, `hmtx`, `vmtx`, `OS/2`, `post`, and `name`.

fn parse_head_table(data : Bytes, off : Int, len : Int) -> Result[HeadTable, OpenTypeError] {
  if len < 54 {
    return Err(OpenTypeError::InvalidTable("head table shorter than 54 bytes"))
  }
  let magic = read_u32_be(data, off + 12)
  if magic != 0x5F0F3CF5L {
    return Err(OpenTypeError::InvalidTable("head magicNumber mismatch"))
  }
  let flags = read_u16_be(data, off + 16)
  let units_per_em = read_u16_be(data, off + 18)
  if units_per_em < 16 || units_per_em > 16384 {
    return Err(OpenTypeError::InvalidTable("head unitsPerEm out of range [16, 16384]"))
  }
  let x_min = read_i16_be(data, off + 36)
  let y_min = read_i16_be(data, off + 38)
  let x_max = read_i16_be(data, off + 40)
  let y_max = read_i16_be(data, off + 42)
  let mac_style = read_u16_be(data, off + 44)
  let lowest_rec_ppem = read_u16_be(data, off + 46)
  let index_to_loc_format = read_i16_be(data, off + 50)
  if index_to_loc_format != 0 && index_to_loc_format != 1 {
    return Err(OpenTypeError::InvalidTable("head indexToLocFormat must be 0 or 1"))
  }
  Ok(
    HeadTable::{
      flags: flags,
      units_per_em: units_per_em,
      x_min: x_min,
      y_min: y_min,
      x_max: x_max,
      y_max: y_max,
      mac_style: mac_style,
      lowest_rec_ppem: lowest_rec_ppem,
      index_to_loc_format: index_to_loc_format,
    },
  )
}

fn parse_maxp_table(data : Bytes, off : Int, len : Int) -> Result[MaxpTable, OpenTypeError] {
  if len < 6 {
    return Err(OpenTypeError::InvalidTable("maxp table shorter than 6 bytes"))
  }
  let version = read_u32_be(data, off)
  if version != 0x00005000L && version != 0x00010000L {
    return Err(OpenTypeError::InvalidTable("unsupported maxp version"))
  }
  let num_glyphs = read_u16_be(data, off + 4)
  if num_glyphs == 0 {
    return Err(OpenTypeError::InvalidTable("maxp numGlyphs is 0"))
  }
  Ok(MaxpTable::{ version: version, num_glyphs: num_glyphs })
}

fn parse_hhea_table(data : Bytes, off : Int, len : Int) -> Option[HheaTable] {
  if len < 36 {
    return None
  }
  Some(
    HheaTable::{
      ascender: read_i16_be(data, off + 4),
      descender: read_i16_be(data, off + 6),
      line_gap: read_i16_be(data, off + 8),
      advance_width_max: read_u16_be(data, off + 10),
      min_left_side_bearing: read_i16_be(data, off + 12),
      min_right_side_bearing: read_i16_be(data, off + 14),
      x_max_extent: read_i16_be(data, off + 16),
      caret_slope_rise: read_i16_be(data, off + 18),
      caret_slope_run: read_i16_be(data, off + 20),
      caret_offset: read_i16_be(data, off + 22),
      number_of_h_metrics: read_u16_be(data, off + 34),
    },
  )
}

fn parse_vhea_table(data : Bytes, off : Int, len : Int) -> Option[VheaTable] {
  if len < 36 {
    return None
  }
  Some(
    VheaTable::{
      ascender: read_i16_be(data, off + 4),
      descender: read_i16_be(data, off + 6),
      line_gap: read_i16_be(data, off + 8),
      advance_height_max: read_u16_be(data, off + 10),
      number_of_v_metrics: read_u16_be(data, off + 34),
    },
  )
}

fn parse_os2_table(data : Bytes, off : Int, len : Int) -> Option[Os2Table] {
  if len < 78 {
    return None
  }
  let version = read_u16_be(data, off)
  let panose = Bytes::new(10)
  let mut i = 0
  while i < 10 {
    panose[i] = data[off + 32 + i]
    i = i + 1
  }
  let x_height = if version >= 2 && len >= 96 {
    Some(read_i16_be(data, off + 86))
  } else {
    None
  }
  let cap_height = if version >= 2 && len >= 96 {
    Some(read_i16_be(data, off + 88))
  } else {
    None
  }
  Some(
    Os2Table::{
      version: version,
      x_avg_char_width: read_i16_be(data, off + 2),
      weight_class: read_u16_be(data, off + 4),
      width_class: read_u16_be(data, off + 6),
      fs_type: read_u16_be(data, off + 8),
      y_subscript_x_size: read_i16_be(data, off + 10),
      y_subscript_y_size: read_i16_be(data, off + 12),
      y_subscript_x_offset: read_i16_be(data, off + 14),
      y_subscript_y_offset: read_i16_be(data, off + 16),
      y_superscript_x_size: read_i16_be(data, off + 18),
      y_superscript_y_size: read_i16_be(data, off + 20),
      y_superscript_x_offset: read_i16_be(data, off + 22),
      y_superscript_y_offset: read_i16_be(data, off + 24),
      y_strikeout_size: read_i16_be(data, off + 26),
      y_strikeout_position: read_i16_be(data, off + 28),
      s_family_class: read_i16_be(data, off + 30),
      panose: panose,
      fs_selection: read_u16_be(data, off + 62),
      first_char_index: read_u16_be(data, off + 64),
      last_char_index: read_u16_be(data, off + 66),
      typo_ascender: read_i16_be(data, off + 68),
      typo_descender: read_i16_be(data, off + 70),
      typo_line_gap: read_i16_be(data, off + 72),
      win_ascent: read_u16_be(data, off + 74),
      win_descent: read_u16_be(data, off + 76),
      x_height: x_height,
      cap_height: cap_height,
    },
  )
}

fn parse_post_table(data : Bytes, off : Int, len : Int) -> Option[PostTable] {
  if len < 32 {
    return None
  }
  Some(
    PostTable::{
      version: read_u32_be(data, off),
      italic_angle_fixed: read_i32_be(data, off + 4),
      underline_position: read_i16_be(data, off + 8),
      underline_thickness: read_i16_be(data, off + 10),
      is_fixed_pitch: read_u32_be(data, off + 12) != 0L,
    },
  )
}

fn lookup_metric_advance(
  data : Bytes,
  table_off : Int,
  table_len : Int,
  num_metrics : Int,
  num_glyphs : Int,
  gid : Int,
) -> Option[Int] {
  if gid < 0 || gid >= num_glyphs || num_metrics <= 0 {
    return None
  }
  let idx = if gid < num_metrics { gid } else { num_metrics - 1 }
  let rel = idx << 2
  if rel + 2 > table_len {
    return None
  }
  Some(read_u16_be(data, table_off + rel))
}

fn lookup_metric_side_bearing(
  data : Bytes,
  table_off : Int,
  table_len : Int,
  num_metrics : Int,
  num_glyphs : Int,
  gid : Int,
) -> Option[Int] {
  if gid < 0 || gid >= num_glyphs || num_metrics <= 0 {
    return None
  }
  let rel = if gid < num_metrics {
    (gid << 2) + 2
  } else {
    (num_metrics << 2) + ((gid - num_metrics) << 1)
  }
  if rel + 2 > table_len {
    return None
  }
  Some(read_i16_be(data, table_off + rel))
}

fn decode_name_value(
  data : Bytes,
  str_start : Int,
  str_len : Int,
  platform_id : Int,
  encoding_id : Int,
) -> Option[String] {
  if platform_id == 0 {
    return decode_utf16be(data, str_start, str_len)
  }
  if platform_id == 3 && (encoding_id == 0 || encoding_id == 1 || encoding_id == 10) {
    return decode_utf16be(data, str_start, str_len)
  }
  if platform_id == 1 && encoding_id == 0 {
    return decode_mac_roman(data, str_start, str_len)
  }
  None
}

fn parse_name_records(data : Bytes, off : Int, len : Int) -> Array[NameRecord] {
  let out : Array[NameRecord] = []
  if len < 6 {
    return out
  }
  let count = read_u16_be(data, off + 2)
  let string_offset = read_u16_be(data, off + 4)
  if count == 0 || count > max_name_records {
    return out
  }
  if 6L + count.to_int64() * 12L > len.to_int64() || string_offset > len {
    return out
  }
  let storage_start = off + string_offset
  let storage_len = len - string_offset
  let mut i = 0
  while i < count {
    let rec = off + 6 + i * 12
    let platform_id = read_u16_be(data, rec)
    let encoding_id = read_u16_be(data, rec + 2)
    let language_id = read_u16_be(data, rec + 4)
    let name_id = read_u16_be(data, rec + 6)
    let str_len = read_u16_be(data, rec + 8)
    let str_off = read_u16_be(data, rec + 10)
    let value = if str_off + str_len <= storage_len {
      decode_name_value(data, storage_start + str_off, str_len, platform_id, encoding_id)
    } else {
      None
    }
    out.push(
      NameRecord::{
        platform_id: platform_id,
        encoding_id: encoding_id,
        language_id: language_id,
        name_id: name_id,
        offset: str_off,
        length: str_len,
        value: value,
      },
    )
    i = i + 1
  }
  out
}

fn name_record_priority(platform_id : Int, encoding_id : Int, language_id : Int) -> Int {
  // Higher is better.
  if platform_id == 3 && (encoding_id == 1 || encoding_id == 10) && language_id == 0x0409 {
    return 100
  }
  if platform_id == 0 {
    return 80
  }
  if platform_id == 3 && (encoding_id == 0 || encoding_id == 1 || encoding_id == 10) {
    return 60
  }
  if platform_id == 1 && encoding_id == 0 && language_id == 0 {
    return 40
  }
  if platform_id == 1 && encoding_id == 0 {
    return 20
  }
  0
}

fn find_preferred_name(data : Bytes, off : Int, len : Int, target_name_id : Int) -> Option[String] {
  if len < 6 {
    return None
  }
  let count = read_u16_be(data, off + 2)
  let string_offset = read_u16_be(data, off + 4)
  if count == 0 || count > max_name_records {
    return None
  }
  if 6L + count.to_int64() * 12L > len.to_int64() || string_offset > len {
    return None
  }
  let storage_start = off + string_offset
  let storage_len = len - string_offset
  let mut best_prio = 0
  let mut best_str : Option[String] = None
  let mut i = 0
  while i < count {
    let rec = off + 6 + i * 12
    let name_id = read_u16_be(data, rec + 6)
    if name_id == target_name_id {
      let platform_id = read_u16_be(data, rec)
      let encoding_id = read_u16_be(data, rec + 2)
      let language_id = read_u16_be(data, rec + 4)
      let prio = name_record_priority(platform_id, encoding_id, language_id)
      if prio > best_prio {
        let str_len = read_u16_be(data, rec + 8)
        let str_off = read_u16_be(data, rec + 10)
        if str_off + str_len <= storage_len {
          match decode_name_value(data, storage_start + str_off, str_len, platform_id, encoding_id) {
            Some(s) => {
              best_prio = prio
              best_str = Some(s)
            }
            None => ()
          }
        }
      }
    }
    i = i + 1
  }
  best_str
}
