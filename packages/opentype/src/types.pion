///| Public types, errors, DoS guard limits, and geometry primitives for `packages/opentype`.
///| 100% pure Pion OpenType / TrueType (SFNT + TTC) binary parser with zero external dependencies,
///| zero `extern "C"`, zero `World`, and zero mutable module globals.

///| Maximum number of SFNT tables accepted in a single font face (DoS guard).
pub let max_num_tables : Int = 4096

///| Maximum number of font faces accepted in a TrueType Collection (`ttcf`).
pub let max_ttc_fonts : Int = 4096

///| Maximum number of records accepted in a `name` table.
pub let max_name_records : Int = 4096

///| Maximum byte length accepted when decoding a single `name` record string.
pub let max_name_bytes : Int = 65536

///| Maximum recursion depth for compound (`glyf`) glyphs (cycle / DoS guard).
pub let max_compound_depth : Int = 16

///| Maximum total components expanded across a compound glyph tree.
pub let max_compound_components : Int = 1024

///| Maximum total contour points decoded in a single glyph outline.
pub let max_glyph_points : Int = 65536

///| Maximum number of contours decoded in a single simple glyph.
pub let max_glyph_contours : Int = 8192

///| Maximum number of variation axes in `fvar` / `avar`.
pub let max_fvar_axes : Int = 256

///| Maximum number of named instances in `fvar`.
pub let max_fvar_instances : Int = 4096

///| Maximum number of value maps per axis in `avar`.
pub let max_avar_pairs : Int = 4096

///| Error returned when parsing OpenType / TrueType containers, tables, or glyph outlines.
pub enum OpenTypeError {
  UnexpectedEof(String)
  InvalidMagic(String)
  InvalidIndex(String)
  InvalidTableDirectory(String)
  MissingRequiredTable(String)
  InvalidTable(String)
  InvalidGlyph(String)
  LimitExceeded(String)
}

///| Human-readable description of `OpenTypeError`.
pub fn opentype_error_message(err : OpenTypeError) -> String {
  match err {
    OpenTypeError::UnexpectedEof(msg) => "unexpected EOF: " + msg
    OpenTypeError::InvalidMagic(msg) => "invalid magic: " + msg
    OpenTypeError::InvalidIndex(msg) => "invalid index: " + msg
    OpenTypeError::InvalidTableDirectory(msg) => "invalid table directory: " + msg
    OpenTypeError::MissingRequiredTable(msg) => "missing required table: " + msg
    OpenTypeError::InvalidTable(msg) => "invalid table: " + msg
    OpenTypeError::InvalidGlyph(msg) => "invalid glyph: " + msg
    OpenTypeError::LimitExceeded(msg) => "limit exceeded: " + msg
  }
}

///|
pub fn OpenTypeError::to_string(self : OpenTypeError) -> String {
  opentype_error_message(self)
}

///| 4-byte OpenType tag stored as unsigned 32-bit value inside `Int64`.
pub val struct Tag {
  pub value : Int64
}

///| Construct a `Tag` from 4 raw byte values.
pub fn Tag::from_bytes(b0 : Int, b1 : Int, b2 : Int, b3 : Int) -> Tag {
  let v = ((b0 & 0xFF).to_int64() << 24) |
  ((b1 & 0xFF).to_int64() << 16) |
  ((b2 & 0xFF).to_int64() << 8) |
  (b3 & 0xFF).to_int64()
  Tag::{ value: v }
}

///| Construct a `Tag` from a 4-byte ASCII string.
pub fn Tag::from_string(s : String) -> Option[Tag] {
  if s.length() != 4 {
    return None
  }
  let b0 = s.code_unit_at(0)
  let b1 = s.code_unit_at(1)
  let b2 = s.code_unit_at(2)
  let b3 = s.code_unit_at(3)
  if b0 > 0xFF || b1 > 0xFF || b2 > 0xFF || b3 > 0xFF {
    return None
  }
  Some(Tag::from_bytes(b0, b1, b2, b3))
}

///| Format a `Tag` as a 4-character string.
pub fn Tag::to_string(self : Tag) -> String {
  let sb = StringBuilder::new()
  sb.write_byte(((self.value >> 24) & 0xFFL).to_int().to_byte())
  sb.write_byte(((self.value >> 16) & 0xFFL).to_int().to_byte())
  sb.write_byte(((self.value >> 8) & 0xFFL).to_int().to_byte())
  sb.write_byte((self.value & 0xFFL).to_int().to_byte())
  sb.to_string()
}

///|
pub fn Tag::eq(self : Tag, other : Tag) -> Bool {
  self.value == other.value
}

///| SFNT container outline flavor.
pub enum SfntKind {
  TrueType
  OpenTypeCff
  AppleTrueType
}

///|
pub fn SfntKind::to_string(self : SfntKind) -> String {
  match self {
    SfntKind::TrueType => "TrueType"
    SfntKind::OpenTypeCff => "OpenTypeCff"
    SfntKind::AppleTrueType => "AppleTrueType"
  }
}

///| Table directory entry inside an SFNT font.
pub val struct TableRecord {
  pub tag : Tag
  pub checksum : Int64
  pub offset : Int64
  pub length : Int64
}

///| Integer bounding box in font design units.
pub val struct Rect {
  pub x_min : Int
  pub y_min : Int
  pub x_max : Int
  pub y_max : Int
}

///|
pub fn Rect::width(self : Rect) -> Int {
  self.x_max - self.x_min
}

///|
pub fn Rect::height(self : Rect) -> Int {
  self.y_max - self.y_min
}

///| Parsed `head` table.
pub val struct HeadTable {
  pub flags : Int
  pub units_per_em : Int
  pub x_min : Int
  pub y_min : Int
  pub x_max : Int
  pub y_max : Int
  pub mac_style : Int
  pub lowest_rec_ppem : Int
  pub index_to_loc_format : Int
}

///| Parsed `maxp` table (v0.5 CFF or v1.0 TrueType).
pub val struct MaxpTable {
  pub version : Int64
  pub num_glyphs : Int
}

///| Parsed `hhea` horizontal header table.
pub val struct HheaTable {
  pub ascender : Int
  pub descender : Int
  pub line_gap : Int
  pub advance_width_max : Int
  pub min_left_side_bearing : Int
  pub min_right_side_bearing : Int
  pub x_max_extent : Int
  pub caret_slope_rise : Int
  pub caret_slope_run : Int
  pub caret_offset : Int
  pub number_of_h_metrics : Int
}

///| Parsed `vhea` vertical header table.
pub val struct VheaTable {
  pub ascender : Int
  pub descender : Int
  pub line_gap : Int
  pub advance_height_max : Int
  pub number_of_v_metrics : Int
}

///| Parsed `OS/2` metrics and classification table.
pub struct Os2Table {
  pub version : Int
  pub x_avg_char_width : Int
  pub weight_class : Int
  pub width_class : Int
  pub fs_type : Int
  pub y_subscript_x_size : Int
  pub y_subscript_y_size : Int
  pub y_subscript_x_offset : Int
  pub y_subscript_y_offset : Int
  pub y_superscript_x_size : Int
  pub y_superscript_y_size : Int
  pub y_superscript_x_offset : Int
  pub y_superscript_y_offset : Int
  pub y_strikeout_size : Int
  pub y_strikeout_position : Int
  pub s_family_class : Int
  pub panose : Bytes
  pub fs_selection : Int
  pub first_char_index : Int
  pub last_char_index : Int
  pub typo_ascender : Int
  pub typo_descender : Int
  pub typo_line_gap : Int
  pub win_ascent : Int
  pub win_descent : Int
  pub x_height : Option[Int]
  pub cap_height : Option[Int]
}

///| Parsed `post` PostScript table.
pub val struct PostTable {
  pub version : Int64
  pub italic_angle_fixed : Int64
  pub underline_position : Int
  pub underline_thickness : Int
  pub is_fixed_pitch : Bool
}

///| Convert `post.italic_angle_fixed` (Fixed 16.16) to `Double`.
pub fn PostTable::italic_angle(self : PostTable) -> Double {
  self.italic_angle_fixed.to_double() / 65536.0
}

///| A single entry in the `name` table.
pub val struct NameRecord {
  pub platform_id : Int
  pub encoding_id : Int
  pub language_id : Int
  pub name_id : Int
  pub offset : Int
  pub length : Int
  pub value : Option[String]
}

///| Result of a `cmap` Format 14 Unicode Variation Sequence lookup.
pub enum VariationGlyph {
  UseDefault
  Found(Int)
}

///| A variation axis from the `fvar` table.
pub val struct VariationAxis {
  pub tag : Tag
  pub min_fixed : Int64
  pub default_fixed : Int64
  pub max_fixed : Int64
  pub min_value : Double
  pub default_value : Double
  pub max_value : Double
  pub flags : Int
  pub hidden : Bool
  pub name_id : Int
}

///| A named instance from the `fvar` table.
pub struct NamedInstance {
  pub subfamily_name_id : Int
  pub flags : Int
  pub coordinates_fixed : Array[Int64]
  pub coordinates : Array[Double]
  pub postscript_name_id : Option[Int]
}

///| A single F2Dot14 axis mapping pair from the `avar` table.
pub val struct AvarValueMap {
  pub from_coordinate : Int
  pub to_coordinate : Int
}

///| 2D path command emitted by `Face::outline_glyph`.
pub enum PathCommand {
  MoveTo(Double, Double)
  LineTo(Double, Double)
  QuadTo(Double, Double, Double, Double)
  Close
}

///| Collector for glyph outline commands.
pub struct OutlineBuilder {
  pub commands : Array[PathCommand]
}

///| Create an empty `OutlineBuilder`.
pub fn OutlineBuilder::new() -> OutlineBuilder {
  OutlineBuilder::{ commands: [] }
}

///|
pub fn OutlineBuilder::move_to(self : OutlineBuilder, x : Double, y : Double) -> Unit {
  self.commands.push(PathCommand::MoveTo(x, y))
}

///|
pub fn OutlineBuilder::line_to(self : OutlineBuilder, x : Double, y : Double) -> Unit {
  self.commands.push(PathCommand::LineTo(x, y))
}

///|
pub fn OutlineBuilder::quad_to(
  self : OutlineBuilder,
  cx : Double,
  cy : Double,
  x : Double,
  y : Double,
) -> Unit {
  self.commands.push(PathCommand::QuadTo(cx, cy, x, y))
}

///|
pub fn OutlineBuilder::close(self : OutlineBuilder) -> Unit {
  self.commands.push(PathCommand::Close)
}

///|
pub fn OutlineBuilder::len(self : OutlineBuilder) -> Int {
  self.commands.length()
}

///|
pub fn OutlineBuilder::clear(self : OutlineBuilder) -> Unit {
  self.commands.clear()
}
