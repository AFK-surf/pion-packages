///| TrueType `loca` + `glyf` bounding box and outline decoder (simple + compound glyphs).
///| Enforces strict cycle detection, max recursion depth, max component count, and max point limits.

struct OutlineState {
  mut total_components : Int
  mut total_points : Int
  stack : Array[Int]
}

struct GlyphPoints {
  xs : Array[Double]
  ys : Array[Double]
  on_curve : Array[Bool]
  contour_starts : Array[Int]
  contour_ends : Array[Int]
}

fn loca_glyph_packed(
  data : Bytes,
  loca_off : Int,
  loca_len : Int,
  glyf_len : Int,
  index_to_loc_format : Int,
  num_glyphs : Int,
  gid : Int,
) -> Int64 {
  if gid < 0 || gid >= num_glyphs {
    return -2L
  }
  if index_to_loc_format == 0 {
    let req = (gid + 2) << 1
    if req > loca_len {
      return -3L
    }
    let p = loca_off + (gid << 1)
    let start = read_u16_be(data, p) << 1
    let end = read_u16_be(data, p + 2) << 1
    if start == end {
      return -1L
    }
    if start > end || end > glyf_len {
      return -4L
    }
    (start.to_int64() << 32) | ((end - start).to_int64() & 0xFFFFFFFFL)
  } else {
    let req = (gid.to_int64() + 2L) << 2
    if req > loca_len.to_int64() {
      return -5L
    }
    let p = loca_off + (gid << 2)
    let start64 = read_u32_be(data, p)
    let end64 = read_u32_be(data, p + 4)
    if start64 == end64 {
      return -1L
    }
    if start64 > end64 || end64 > glyf_len.to_int64() {
      return -6L
    }
    (start64 << 32) | ((end64 - start64) & 0xFFFFFFFFL)
  }
}

fn loca_error(code : Int64) -> OpenTypeError {
  if code == -2L {
    OpenTypeError::InvalidIndex("glyph ID out of range")
  } else if code == -3L {
    OpenTypeError::InvalidTable("loca (short) truncated")
  } else if code == -4L {
    OpenTypeError::InvalidGlyph("loca (short) offset out of glyf bounds")
  } else if code == -5L {
    OpenTypeError::InvalidTable("loca (long) truncated")
  } else {
    OpenTypeError::InvalidGlyph("loca (long) offset out of glyf bounds")
  }
}

fn glyf_bounding_box_impl(
  data : Bytes,
  loca_off : Int,
  loca_len : Int,
  glyf_off : Int,
  glyf_len : Int,
  index_to_loc_format : Int,
  num_glyphs : Int,
  gid : Int,
) -> Result[Option[Rect], OpenTypeError] {
  let packed = loca_glyph_packed(
    data,
    loca_off,
    loca_len,
    glyf_len,
    index_to_loc_format,
    num_glyphs,
    gid,
  )
  if packed < 0L {
    return if packed == -1L { Ok(None) } else { Err(loca_error(packed)) }
  }
  let rel_off = (packed >> 32).to_int()
  let rel_len = (packed & 0xFFFFFFFFL).to_int()
  if rel_len < 10 {
    return Err(OpenTypeError::InvalidGlyph("glyf entry shorter than 10 bytes"))
  }
  let g_off = glyf_off + rel_off
  let x_min = read_i16_be(data, g_off + 2)
  let y_min = read_i16_be(data, g_off + 4)
  let x_max = read_i16_be(data, g_off + 6)
  let y_max = read_i16_be(data, g_off + 8)
  Ok(Some(Rect::{ x_min: x_min, y_min: y_min, x_max: x_max, y_max: y_max }))
}

fn outline_simple_glyph_direct(
  data : Bytes,
  g_off : Int,
  g_len : Int,
  num_contours : Int,
  bbox : Rect,
  builder : OutlineBuilder,
) -> Result[Option[Rect], OpenTypeError] {
  if num_contours > max_glyph_contours {
    return Err(OpenTypeError::LimitExceeded("glyf contour count exceeds limit"))
  }
  let end_pts_end = 10 + (num_contours << 1)
  if end_pts_end + 2 > g_len {
    return Err(OpenTypeError::InvalidGlyph("simple glyph endPtsOfContours truncated"))
  }
  let mut prev_end = -1
  let mut c = 0
  while c < num_contours {
    let ep = read_u16_be(data, g_off + 10 + (c << 1))
    if ep < prev_end {
      return Err(OpenTypeError::InvalidGlyph("endPtsOfContours not monotonic"))
    }
    prev_end = ep
    c = c + 1
  }
  let num_points = prev_end + 1
  if num_points <= 0 {
    return Ok(None)
  }
  if num_points > max_glyph_points {
    return Err(OpenTypeError::LimitExceeded("glyph total point count exceeds limit"))
  }
  let instr_len = read_u16_be(data, g_off + end_pts_end)
  let flags_start = end_pts_end + 2 + instr_len
  if flags_start > g_len {
    return Err(OpenTypeError::InvalidGlyph("simple glyph instructions out of bounds"))
  }

  // Pass 1: validate flags & REPEAT_FLAG and compute exact x/y stream byte lengths.
  let mut pos = flags_start
  let mut count = 0
  let mut x_bytes = 0
  let mut y_bytes = 0
  while count < num_points {
    if pos >= g_len {
      return Err(OpenTypeError::InvalidGlyph("simple glyph flags truncated"))
    }
    let fl = read_u8(data, g_off + pos)
    pos = pos + 1
    let mut n = 1
    if (fl & 0x08) != 0 {
      if pos >= g_len {
        return Err(OpenTypeError::InvalidGlyph("simple glyph repeat count truncated"))
      }
      let rep = read_u8(data, g_off + pos)
      pos = pos + 1
      if count + 1 + rep > num_points {
        return Err(OpenTypeError::InvalidGlyph("simple glyph REPEAT_FLAG overflows point count"))
      }
      n = 1 + rep
    }
    count = count + n
    if (fl & 0x02) != 0 {
      x_bytes = x_bytes + n
    } else if (fl & 0x10) == 0 {
      x_bytes = x_bytes + (n << 1)
    }
    if (fl & 0x04) != 0 {
      y_bytes = y_bytes + n
    } else if (fl & 0x20) == 0 {
      y_bytes = y_bytes + (n << 1)
    }
  }
  let x_start = pos
  let y_start = x_start + x_bytes
  if y_start > g_len {
    return Err(OpenTypeError::InvalidGlyph("simple glyph x coordinates truncated"))
  }
  if y_start + y_bytes > g_len {
    return Err(OpenTypeError::InvalidGlyph("simple glyph y coordinates truncated"))
  }

  // Pass 2: zero-allocation streaming decode directly into builder.
  let before = builder.commands.length()
  let mut f_pos = g_off + flags_start
  let mut x_pos = g_off + x_start
  let mut y_pos = g_off + y_start
  let mut cur_fl = 0
  let mut fl_rem = 0
  let mut x = 0
  let mut y = 0
  let mut pt_idx = 0
  c = 0
  while c < num_contours {
    let c_end = read_u16_be(data, g_off + 10 + (c << 1))
    if pt_idx <= c_end {
      let mut has_first_on = false
      let mut first_on_x = 0.0
      let mut first_on_y = 0.0
      let mut has_first_off = false
      let mut first_off_x = 0.0
      let mut first_off_y = 0.0
      let mut has_last_off = false
      let mut last_off_x = 0.0
      let mut last_off_y = 0.0

      while pt_idx <= c_end {
        if fl_rem == 0 {
          cur_fl = read_u8(data, f_pos)
          f_pos = f_pos + 1
          if (cur_fl & 0x08) != 0 {
            fl_rem = read_u8(data, f_pos)
            f_pos = f_pos + 1
          }
        } else {
          fl_rem = fl_rem - 1
        }
        let x_same_or_pos = (cur_fl & 0x10) != 0
        if (cur_fl & 0x02) != 0 {
          let dx = read_u8(data, x_pos)
          x_pos = x_pos + 1
          x = if x_same_or_pos { x + dx } else { x - dx }
        } else if !x_same_or_pos {
          let dx = read_i16_be(data, x_pos)
          x_pos = x_pos + 2
          x = x + dx
        }
        let y_same_or_pos = (cur_fl & 0x20) != 0
        if (cur_fl & 0x04) != 0 {
          let dy = read_u8(data, y_pos)
          y_pos = y_pos + 1
          y = if y_same_or_pos { y + dy } else { y - dy }
        } else if !y_same_or_pos {
          let dy = read_i16_be(data, y_pos)
          y_pos = y_pos + 2
          y = y + dy
        }
        let px = x.to_double()
        let py = y.to_double()
        let on = (cur_fl & 0x01) != 0
        if !has_first_on {
          if on {
            has_first_on = true
            first_on_x = px
            first_on_y = py
            builder.move_to(px, py)
          } else if has_first_off {
            let mx = (first_off_x + px) * 0.5
            let my = (first_off_y + py) * 0.5
            has_first_on = true
            first_on_x = mx
            first_on_y = my
            has_last_off = true
            last_off_x = px
            last_off_y = py
            builder.move_to(mx, my)
          } else {
            has_first_off = true
            first_off_x = px
            first_off_y = py
          }
        } else if has_last_off {
          if on {
            has_last_off = false
            builder.quad_to(last_off_x, last_off_y, px, py)
          } else {
            let mx = (last_off_x + px) * 0.5
            let my = (last_off_y + py) * 0.5
            builder.quad_to(last_off_x, last_off_y, mx, my)
            last_off_x = px
            last_off_y = py
          }
        } else if on {
          builder.line_to(px, py)
        } else {
          has_last_off = true
          last_off_x = px
          last_off_y = py
        }
        pt_idx = pt_idx + 1
      }

      if has_first_off && has_last_off {
        has_last_off = false
        let mx = (last_off_x + first_off_x) * 0.5
        let my = (last_off_y + first_off_y) * 0.5
        builder.quad_to(last_off_x, last_off_y, mx, my)
      }
      if has_first_on && has_first_off {
        builder.quad_to(first_off_x, first_off_y, first_on_x, first_on_y)
      } else if has_first_on && has_last_off {
        builder.quad_to(last_off_x, last_off_y, first_on_x, first_on_y)
      } else if has_first_on {
        builder.line_to(first_on_x, first_on_y)
      }
      if has_first_on {
        builder.close()
      }
    }
    c = c + 1
  }
  if builder.commands.length() == before { Ok(None) } else { Ok(Some(bbox)) }
}

fn emit_contour_direct(
  xs : Array[Double],
  ys : Array[Double],
  on_curve : Array[Bool],
  start : Int,
  end : Int,
  builder : OutlineBuilder,
) -> Unit {
  if end < start {
    return ()
  }
  let mut has_first_on = false
  let mut first_on_x = 0.0
  let mut first_on_y = 0.0

  let mut has_first_off = false
  let mut first_off_x = 0.0
  let mut first_off_y = 0.0

  let mut has_last_off = false
  let mut last_off_x = 0.0
  let mut last_off_y = 0.0

  let mut idx = start
  while idx <= end {
    let px = xs[idx]
    let py = ys[idx]
    let on = on_curve[idx]
    if !has_first_on {
      if on {
        has_first_on = true
        first_on_x = px
        first_on_y = py
        builder.move_to(px, py)
      } else if has_first_off {
        let mx = (first_off_x + px) * 0.5
        let my = (first_off_y + py) * 0.5
        has_first_on = true
        first_on_x = mx
        first_on_y = my
        has_last_off = true
        last_off_x = px
        last_off_y = py
        builder.move_to(mx, my)
      } else {
        has_first_off = true
        first_off_x = px
        first_off_y = py
      }
    } else if has_last_off {
      if on {
        has_last_off = false
        builder.quad_to(last_off_x, last_off_y, px, py)
      } else {
        let mx = (last_off_x + px) * 0.5
        let my = (last_off_y + py) * 0.5
        builder.quad_to(last_off_x, last_off_y, mx, my)
        last_off_x = px
        last_off_y = py
      }
    } else if on {
      builder.line_to(px, py)
    } else {
      has_last_off = true
      last_off_x = px
      last_off_y = py
    }
    idx = idx + 1
  }

  if has_first_off && has_last_off {
    has_last_off = false
    let mx = (last_off_x + first_off_x) * 0.5
    let my = (last_off_y + first_off_y) * 0.5
    builder.quad_to(last_off_x, last_off_y, mx, my)
  }
  if has_first_on && has_first_off {
    builder.quad_to(first_off_x, first_off_y, first_on_x, first_on_y)
  } else if has_first_on && has_last_off {
    builder.quad_to(last_off_x, last_off_y, first_on_x, first_on_y)
  } else if has_first_on {
    builder.line_to(first_on_x, first_on_y)
  }
  if has_first_on {
    builder.close()
  }
}

fn decode_simple_glyph_points(
  data : Bytes,
  g_off : Int,
  g_len : Int,
  num_contours : Int,
  state : OutlineState,
  pts : GlyphPoints,
) -> Result[Unit, OpenTypeError] {
  if num_contours == 0 {
    return Ok(())
  }
  if num_contours > max_glyph_contours {
    return Err(OpenTypeError::LimitExceeded("glyf contour count exceeds limit"))
  }
  let end_pts_end = 10 + (num_contours << 1)
  if end_pts_end + 2 > g_len {
    return Err(OpenTypeError::InvalidGlyph("simple glyph endPtsOfContours truncated"))
  }
  let mut prev_end = -1
  let mut c = 0
  while c < num_contours {
    let ep = read_u16_be(data, g_off + 10 + (c << 1))
    if ep < prev_end {
      return Err(OpenTypeError::InvalidGlyph("endPtsOfContours not monotonic"))
    }
    prev_end = ep
    c = c + 1
  }
  let num_points = prev_end + 1
  if num_points <= 0 {
    return Ok(())
  }
  if state.total_points + num_points > max_glyph_points {
    return Err(OpenTypeError::LimitExceeded("glyph total point count exceeds limit"))
  }
  state.total_points = state.total_points + num_points

  let instr_len = read_u16_be(data, g_off + end_pts_end)
  let flags_start = end_pts_end + 2 + instr_len
  if flags_start > g_len {
    return Err(OpenTypeError::InvalidGlyph("simple glyph instructions out of bounds"))
  }

  let mut pos = flags_start
  let mut count = 0
  let mut x_bytes = 0
  let mut y_bytes = 0
  while count < num_points {
    if pos >= g_len {
      return Err(OpenTypeError::InvalidGlyph("simple glyph flags truncated"))
    }
    let fl = read_u8(data, g_off + pos)
    pos = pos + 1
    let mut n = 1
    if (fl & 0x08) != 0 {
      if pos >= g_len {
        return Err(OpenTypeError::InvalidGlyph("simple glyph repeat count truncated"))
      }
      let rep = read_u8(data, g_off + pos)
      pos = pos + 1
      if count + 1 + rep > num_points {
        return Err(OpenTypeError::InvalidGlyph("simple glyph REPEAT_FLAG overflows point count"))
      }
      n = 1 + rep
    }
    count = count + n
    if (fl & 0x02) != 0 {
      x_bytes = x_bytes + n
    } else if (fl & 0x10) == 0 {
      x_bytes = x_bytes + (n << 1)
    }
    if (fl & 0x04) != 0 {
      y_bytes = y_bytes + n
    } else if (fl & 0x20) == 0 {
      y_bytes = y_bytes + (n << 1)
    }
  }
  let x_start = pos
  let y_start = x_start + x_bytes
  if y_start > g_len {
    return Err(OpenTypeError::InvalidGlyph("simple glyph x coordinates truncated"))
  }
  if y_start + y_bytes > g_len {
    return Err(OpenTypeError::InvalidGlyph("simple glyph y coordinates truncated"))
  }

  let base = pts.xs.length()
  let mut f_pos = g_off + flags_start
  let mut x_pos = g_off + x_start
  let mut y_pos = g_off + y_start
  let mut cur_fl = 0
  let mut fl_rem = 0
  let mut x = 0
  let mut y = 0
  let mut i = 0
  while i < num_points {
    if fl_rem == 0 {
      cur_fl = read_u8(data, f_pos)
      f_pos = f_pos + 1
      if (cur_fl & 0x08) != 0 {
        fl_rem = read_u8(data, f_pos)
        f_pos = f_pos + 1
      }
    } else {
      fl_rem = fl_rem - 1
    }
    pts.on_curve.push((cur_fl & 0x01) != 0)
    let x_same_or_pos = (cur_fl & 0x10) != 0
    if (cur_fl & 0x02) != 0 {
      let dx = read_u8(data, x_pos)
      x_pos = x_pos + 1
      x = if x_same_or_pos { x + dx } else { x - dx }
    } else if !x_same_or_pos {
      let dx = read_i16_be(data, x_pos)
      x_pos = x_pos + 2
      x = x + dx
    }
    pts.xs.push(x.to_double())
    let y_same_or_pos = (cur_fl & 0x20) != 0
    if (cur_fl & 0x04) != 0 {
      let dy = read_u8(data, y_pos)
      y_pos = y_pos + 1
      y = if y_same_or_pos { y + dy } else { y - dy }
    } else if !y_same_or_pos {
      let dy = read_i16_be(data, y_pos)
      y_pos = y_pos + 2
      y = y + dy
    }
    pts.ys.push(y.to_double())
    i = i + 1
  }

  let mut start = 0
  c = 0
  while c < num_contours {
    let end = read_u16_be(data, g_off + 10 + (c << 1))
    pts.contour_starts.push(base + start)
    pts.contour_ends.push(base + end)
    start = end + 1
    c = c + 1
  }
  Ok(())
}

fn collect_glyph_points_rec(
  data : Bytes,
  loca_off : Int,
  loca_len : Int,
  glyf_off : Int,
  glyf_len : Int,
  index_to_loc_format : Int,
  num_glyphs : Int,
  gid : Int,
  depth : Int,
  state : OutlineState,
  pts : GlyphPoints,
) -> Result[Option[Rect], OpenTypeError] {
  if depth > max_compound_depth {
    return Err(OpenTypeError::LimitExceeded("compound glyph recursion depth exceeded"))
  }
  // Cycle detection on ancestor stack
  let mut s = 0
  while s < state.stack.length() {
    if state.stack[s] == gid {
      return Err(OpenTypeError::InvalidGlyph("compound glyph cycle detected"))
    }
    s = s + 1
  }

  let packed = loca_glyph_packed(
    data,
    loca_off,
    loca_len,
    glyf_len,
    index_to_loc_format,
    num_glyphs,
    gid,
  )
  if packed < 0L {
    return if packed == -1L { Ok(None) } else { Err(loca_error(packed)) }
  }
  let rel_off = (packed >> 32).to_int()
  let rel_len = (packed & 0xFFFFFFFFL).to_int()
  if rel_len < 10 {
    return Err(OpenTypeError::InvalidGlyph("glyf entry shorter than 10 bytes"))
  }
  let g_off = glyf_off + rel_off
  let num_contours = read_i16_be(data, g_off)
  let bbox = Rect::{
    x_min: read_i16_be(data, g_off + 2),
    y_min: read_i16_be(data, g_off + 4),
    x_max: read_i16_be(data, g_off + 6),
    y_max: read_i16_be(data, g_off + 8),
  }
  if num_contours >= 0 {
    match decode_simple_glyph_points(data, g_off, rel_len, num_contours, state, pts) {
      Err(e) => return Err(e)
      Ok(_) => return Ok(Some(bbox))
    }
  }

  // Compound glyph (num_contours < 0)
  let parent_base = pts.xs.length()
  state.stack.push(gid)
  let mut pos = 10
  let mut more = true
  while more {
    if state.total_components >= max_compound_components {
      let _ = state.stack.pop()
      return Err(OpenTypeError::LimitExceeded("compound glyph component count exceeded"))
    }
    state.total_components = state.total_components + 1

    if pos + 4 > rel_len {
      let _ = state.stack.pop()
      return Err(OpenTypeError::InvalidGlyph("compound glyph component header truncated"))
    }
    let flags = read_u16_be(data, g_off + pos)
    let comp_gid = read_u16_be(data, g_off + pos + 2)
    pos = pos + 4

    let args_are_words = (flags & 0x0001) != 0
    let args_are_xy = (flags & 0x0002) != 0
    let have_scale = (flags & 0x0008) != 0
    more = (flags & 0x0020) != 0
    let have_xy_scale = (flags & 0x0040) != 0
    let have_two_by_two = (flags & 0x0080) != 0

    let mut tx = 0.0
    let mut ty = 0.0
    let mut parent_pt = 0
    let mut child_pt = 0
    if args_are_words {
      if pos + 4 > rel_len {
        let _ = state.stack.pop()
        return Err(OpenTypeError::InvalidGlyph("compound glyph word args truncated"))
      }
      if args_are_xy {
        tx = read_i16_be(data, g_off + pos).to_double()
        ty = read_i16_be(data, g_off + pos + 2).to_double()
      } else {
        parent_pt = read_u16_be(data, g_off + pos)
        child_pt = read_u16_be(data, g_off + pos + 2)
      }
      pos = pos + 4
    } else {
      if pos + 2 > rel_len {
        let _ = state.stack.pop()
        return Err(OpenTypeError::InvalidGlyph("compound glyph byte args truncated"))
      }
      if args_are_xy {
        tx = read_i8(data, g_off + pos).to_double()
        ty = read_i8(data, g_off + pos + 1).to_double()
      } else {
        parent_pt = read_u8(data, g_off + pos)
        child_pt = read_u8(data, g_off + pos + 1)
      }
      pos = pos + 2
    }

    let mut ma = 1.0
    let mut mb = 0.0
    let mut mc = 0.0
    let mut md = 1.0
    let have_xform = have_scale || have_xy_scale || have_two_by_two
    if have_scale {
      if pos + 2 > rel_len {
        let _ = state.stack.pop()
        return Err(OpenTypeError::InvalidGlyph("compound glyph scale truncated"))
      }
      let sc = f2dot14_to_double(read_i16_be(data, g_off + pos))
      ma = sc
      md = sc
      pos = pos + 2
    } else if have_xy_scale {
      if pos + 4 > rel_len {
        let _ = state.stack.pop()
        return Err(OpenTypeError::InvalidGlyph("compound glyph xy scale truncated"))
      }
      ma = f2dot14_to_double(read_i16_be(data, g_off + pos))
      md = f2dot14_to_double(read_i16_be(data, g_off + pos + 2))
      pos = pos + 4
    } else if have_two_by_two {
      if pos + 8 > rel_len {
        let _ = state.stack.pop()
        return Err(OpenTypeError::InvalidGlyph("compound glyph 2x2 matrix truncated"))
      }
      ma = f2dot14_to_double(read_i16_be(data, g_off + pos))
      mb = f2dot14_to_double(read_i16_be(data, g_off + pos + 2))
      mc = f2dot14_to_double(read_i16_be(data, g_off + pos + 4))
      md = f2dot14_to_double(read_i16_be(data, g_off + pos + 6))
      pos = pos + 8
    }

    let child_start = pts.xs.length()
    match collect_glyph_points_rec(
      data,
      loca_off,
      loca_len,
      glyf_off,
      glyf_len,
      index_to_loc_format,
      num_glyphs,
      comp_gid,
      depth + 1,
      state,
      pts,
    ) {
      Err(e) => {
        let _ = state.stack.pop()
        return Err(e)
      }
      Ok(_) => ()
    }
    let child_end = pts.xs.length()

    if have_xform {
      let mut k = child_start
      while k < child_end {
        let px = pts.xs[k]
        let py = pts.ys[k]
        pts.xs[k] = ma * px + mc * py
        pts.ys[k] = mb * px + md * py
        k = k + 1
      }
    }

    let mut dx = 0.0
    let mut dy = 0.0
    if args_are_xy {
      dx = tx
      dy = ty
      // SCALED_COMPONENT_OFFSET (0x0800) without UNSCALED_COMPONENT_OFFSET (0x1000)
      if have_xform && (flags & 0x1800) == 0x0800 {
        dx = dx * (ma * ma + mc * mc).sqrt()
        dy = dy * (mb * mb + md * md).sqrt()
      }
    } else {
      let p_idx = parent_base + parent_pt
      let c_idx = child_start + child_pt
      if p_idx < child_start && c_idx < child_end {
        dx = pts.xs[p_idx] - pts.xs[c_idx]
        dy = pts.ys[p_idx] - pts.ys[c_idx]
      }
    }

    if dx != 0.0 || dy != 0.0 {
      let mut k = child_start
      while k < child_end {
        pts.xs[k] = pts.xs[k] + dx
        pts.ys[k] = pts.ys[k] + dy
        k = k + 1
      }
    }
  }
  let _ = state.stack.pop()
  Ok(Some(bbox))
}

fn outline_glyph_impl(
  data : Bytes,
  loca_off : Int,
  loca_len : Int,
  glyf_off : Int,
  glyf_len : Int,
  index_to_loc_format : Int,
  num_glyphs : Int,
  gid : Int,
  builder : OutlineBuilder,
) -> Result[Option[Rect], OpenTypeError] {
  let packed = loca_glyph_packed(
    data,
    loca_off,
    loca_len,
    glyf_len,
    index_to_loc_format,
    num_glyphs,
    gid,
  )
  if packed < 0L {
    return if packed == -1L { Ok(None) } else { Err(loca_error(packed)) }
  }
  let rel_off = (packed >> 32).to_int()
  let rel_len = (packed & 0xFFFFFFFFL).to_int()
  if rel_len < 10 {
    return Err(OpenTypeError::InvalidGlyph("glyf entry shorter than 10 bytes"))
  }
  let g_off = glyf_off + rel_off
  let num_contours = read_i16_be(data, g_off)
  if num_contours == 0 {
    return Ok(None)
  }
  let bbox = Rect::{
    x_min: read_i16_be(data, g_off + 2),
    y_min: read_i16_be(data, g_off + 4),
    x_max: read_i16_be(data, g_off + 6),
    y_max: read_i16_be(data, g_off + 8),
  }
  if num_contours > 0 {
    return outline_simple_glyph_direct(data, g_off, rel_len, num_contours, bbox, builder)
  }

  // Compound glyph fallback
  let state = OutlineState::{ total_components: 0, total_points: 0, stack: [] }
  let pts = GlyphPoints::{
    xs: [],
    ys: [],
    on_curve: [],
    contour_starts: [],
    contour_ends: [],
  }
  let before = builder.len()
  match collect_glyph_points_rec(
    data,
    loca_off,
    loca_len,
    glyf_off,
    glyf_len,
    index_to_loc_format,
    num_glyphs,
    gid,
    0,
    state,
    pts,
  ) {
    Err(e) => {
      while builder.commands.length() > before {
        let _ = builder.commands.pop()
      }
      Err(e)
    }
    Ok(None) => Ok(None)
    Ok(Some(cbbox)) => {
      let n_contours = pts.contour_starts.length()
      let mut c = 0
      while c < n_contours {
        emit_contour_direct(pts.xs, pts.ys, pts.on_curve, pts.contour_starts[c], pts.contour_ends[c], builder)
        c = c + 1
      }
      if builder.len() == before { Ok(None) } else { Ok(Some(cbbox)) }
    }
  }
}
