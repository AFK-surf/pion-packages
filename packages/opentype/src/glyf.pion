///| TrueType `loca` + `glyf` bounding box and outline decoder (simple + compound glyphs).
///| Enforces strict cycle detection, max recursion depth, max component count, and max point limits.

val struct Affine2D {
  a : Double
  b : Double
  c : Double
  d : Double
  e : Double
  f : Double
}

fn affine_identity() -> Affine2D {
  Affine2D::{ a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }
}

fn affine_combine(p : Affine2D, q : Affine2D) -> Affine2D {
  Affine2D::{
    a: p.a * q.a + p.c * q.b,
    b: p.b * q.a + p.d * q.b,
    c: p.a * q.c + p.c * q.d,
    d: p.b * q.c + p.d * q.d,
    e: p.a * q.e + p.c * q.f + p.e,
    f: p.b * q.e + p.d * q.f + p.f,
  }
}

fn affine_x(t : Affine2D, x : Double, y : Double) -> Double {
  t.a * x + t.c * y + t.e
}

fn affine_y(t : Affine2D, x : Double, y : Double) -> Double {
  t.b * x + t.d * y + t.f
}

struct OutlineState {
  mut total_components : Int
  mut total_points : Int
  stack : Array[Int]
}

fn loca_glyph_range(
  data : Bytes,
  loca_off : Int,
  loca_len : Int,
  glyf_len : Int,
  index_to_loc_format : Int,
  num_glyphs : Int,
  gid : Int,
) -> Result[Option[(Int, Int)], OpenTypeError] {
  if gid < 0 || gid >= num_glyphs {
    return Err(OpenTypeError::InvalidIndex("glyph ID out of range"))
  }
  if index_to_loc_format == 0 {
    let req = (gid.to_int64() + 2L) * 2L
    if req > loca_len.to_int64() {
      return Err(OpenTypeError::InvalidTable("loca (short) truncated"))
    }
    let start = read_u16_be(data, loca_off + gid * 2) * 2
    let end = read_u16_be(data, loca_off + (gid + 1) * 2) * 2
    if start == end {
      return Ok(None)
    }
    if start > end || end > glyf_len {
      return Err(OpenTypeError::InvalidGlyph("loca (short) offset out of glyf bounds"))
    }
    Ok(Some((start, end - start)))
  } else {
    let req = (gid.to_int64() + 2L) * 4L
    if req > loca_len.to_int64() {
      return Err(OpenTypeError::InvalidTable("loca (long) truncated"))
    }
    let start64 = read_u32_be(data, loca_off + gid * 4)
    let end64 = read_u32_be(data, loca_off + (gid + 1) * 4)
    if start64 == end64 {
      return Ok(None)
    }
    if start64 > end64 || end64 > glyf_len.to_int64() {
      return Err(OpenTypeError::InvalidGlyph("loca (long) offset out of glyf bounds"))
    }
    Ok(Some((start64.to_int(), (end64 - start64).to_int())))
  }
}

fn glyf_bounding_box_impl(
  data : Bytes,
  loca_off : Int,
  loca_len : Int,
  glyf_off : Int,
  glyf_len : Int,
  index_to_loc_format : Int,
  num_glyphs : Int,
  gid : Int,
) -> Result[Option[Rect], OpenTypeError] {
  match loca_glyph_range(data, loca_off, loca_len, glyf_len, index_to_loc_format, num_glyphs, gid) {
    Err(e) => Err(e)
    Ok(None) => Ok(None)
    Ok(Some((rel_off, rel_len))) => {
      if rel_len < 10 {
        return Err(OpenTypeError::InvalidGlyph("glyf entry shorter than 10 bytes"))
      }
      let g_off = glyf_off + rel_off
      let x_min = read_i16_be(data, g_off + 2)
      let y_min = read_i16_be(data, g_off + 4)
      let x_max = read_i16_be(data, g_off + 6)
      let y_max = read_i16_be(data, g_off + 8)
      Ok(Some(Rect::{ x_min: x_min, y_min: y_min, x_max: x_max, y_max: y_max }))
    }
  }
}

fn emit_contour(
  xs : Array[Double],
  ys : Array[Double],
  on_curve : Array[Bool],
  start : Int,
  end : Int,
  tf : Affine2D,
  builder : OutlineBuilder,
) -> Unit {
  if end < start {
    return ()
  }
  let mut has_first_on = false
  let mut first_on_x = 0.0
  let mut first_on_y = 0.0

  let mut has_first_off = false
  let mut first_off_x = 0.0
  let mut first_off_y = 0.0

  let mut has_last_off = false
  let mut last_off_x = 0.0
  let mut last_off_y = 0.0

  let mut idx = start
  while idx <= end {
    let px = xs[idx]
    let py = ys[idx]
    let on = on_curve[idx]
    if !has_first_on {
      if on {
        has_first_on = true
        first_on_x = px
        first_on_y = py
        builder.move_to(affine_x(tf, px, py), affine_y(tf, px, py))
      } else if has_first_off {
        let mx = (first_off_x + px) * 0.5
        let my = (first_off_y + py) * 0.5
        has_first_on = true
        first_on_x = mx
        first_on_y = my
        has_last_off = true
        last_off_x = px
        last_off_y = py
        builder.move_to(affine_x(tf, mx, my), affine_y(tf, mx, my))
      } else {
        has_first_off = true
        first_off_x = px
        first_off_y = py
      }
    } else if has_last_off {
      if on {
        has_last_off = false
        builder.quad_to(
          affine_x(tf, last_off_x, last_off_y),
          affine_y(tf, last_off_x, last_off_y),
          affine_x(tf, px, py),
          affine_y(tf, px, py),
        )
      } else {
        let mx = (last_off_x + px) * 0.5
        let my = (last_off_y + py) * 0.5
        builder.quad_to(
          affine_x(tf, last_off_x, last_off_y),
          affine_y(tf, last_off_x, last_off_y),
          affine_x(tf, mx, my),
          affine_y(tf, mx, my),
        )
        last_off_x = px
        last_off_y = py
      }
    } else if on {
      builder.line_to(affine_x(tf, px, py), affine_y(tf, px, py))
    } else {
      has_last_off = true
      last_off_x = px
      last_off_y = py
    }
    idx = idx + 1
  }

  if has_first_off && has_last_off {
    has_last_off = false
    let mx = (last_off_x + first_off_x) * 0.5
    let my = (last_off_y + first_off_y) * 0.5
    builder.quad_to(
      affine_x(tf, last_off_x, last_off_y),
      affine_y(tf, last_off_x, last_off_y),
      affine_x(tf, mx, my),
      affine_y(tf, mx, my),
    )
  }
  if has_first_on && has_first_off {
    builder.quad_to(
      affine_x(tf, first_off_x, first_off_y),
      affine_y(tf, first_off_x, first_off_y),
      affine_x(tf, first_on_x, first_on_y),
      affine_y(tf, first_on_x, first_on_y),
    )
  } else if has_first_on && has_last_off {
    builder.quad_to(
      affine_x(tf, last_off_x, last_off_y),
      affine_y(tf, last_off_x, last_off_y),
      affine_x(tf, first_on_x, first_on_y),
      affine_y(tf, first_on_x, first_on_y),
    )
  } else if has_first_on {
    builder.line_to(affine_x(tf, first_on_x, first_on_y), affine_y(tf, first_on_x, first_on_y))
  }
  if has_first_on {
    builder.close()
  }
}

fn outline_simple_glyph(
  data : Bytes,
  g_off : Int,
  g_len : Int,
  num_contours : Int,
  tf : Affine2D,
  state : OutlineState,
  builder : OutlineBuilder,
) -> Result[Unit, OpenTypeError] {
  if num_contours == 0 {
    return Ok(())
  }
  if num_contours > max_glyph_contours {
    return Err(OpenTypeError::LimitExceeded("glyf contour count exceeds limit"))
  }
  let end_pts_end = 10 + num_contours * 2
  if end_pts_end + 2 > g_len {
    return Err(OpenTypeError::InvalidGlyph("simple glyph endPtsOfContours truncated"))
  }
  let end_pts : Array[Int] = []
  let mut prev_end = -1
  let mut c = 0
  while c < num_contours {
    let ep = read_u16_be(data, g_off + 10 + c * 2)
    if ep < prev_end {
      return Err(OpenTypeError::InvalidGlyph("endPtsOfContours not monotonic"))
    }
    end_pts.push(ep)
    prev_end = ep
    c = c + 1
  }
  let num_points = prev_end + 1
  if num_points <= 0 {
    return Ok(())
  }
  if state.total_points + num_points > max_glyph_points {
    return Err(OpenTypeError::LimitExceeded("glyph total point count exceeds limit"))
  }
  state.total_points = state.total_points + num_points

  let instr_len = read_u16_be(data, g_off + end_pts_end)
  let mut pos = end_pts_end + 2 + instr_len
  if pos > g_len {
    return Err(OpenTypeError::InvalidGlyph("simple glyph instructions out of bounds"))
  }

  // Decode flags with REPEAT_FLAG (0x08) guard
  let flags : Array[Int] = []
  let on_curve : Array[Bool] = []
  while flags.length() < num_points {
    if pos >= g_len {
      return Err(OpenTypeError::InvalidGlyph("simple glyph flags truncated"))
    }
    let fl = read_u8(data, g_off + pos)
    pos = pos + 1
    flags.push(fl)
    on_curve.push((fl & 0x01) != 0)
    if (fl & 0x08) != 0 {
      if pos >= g_len {
        return Err(OpenTypeError::InvalidGlyph("simple glyph repeat count truncated"))
      }
      let repeat_count = read_u8(data, g_off + pos)
      pos = pos + 1
      if flags.length() + repeat_count > num_points {
        return Err(OpenTypeError::InvalidGlyph("simple glyph REPEAT_FLAG overflows point count"))
      }
      let mut r = 0
      while r < repeat_count {
        flags.push(fl)
        on_curve.push((fl & 0x01) != 0)
        r = r + 1
      }
    }
  }

  // Decode x coordinates
  let xs : Array[Double] = []
  let mut x = 0
  let mut i = 0
  while i < num_points {
    let fl = flags[i]
    let x_short = (fl & 0x02) != 0
    let x_same_or_pos = (fl & 0x10) != 0
    if x_short {
      if pos >= g_len {
        return Err(OpenTypeError::InvalidGlyph("simple glyph x coordinates truncated"))
      }
      let dx = read_u8(data, g_off + pos)
      pos = pos + 1
      x = if x_same_or_pos { x + dx } else { x - dx }
    } else if !x_same_or_pos {
      if pos + 2 > g_len {
        return Err(OpenTypeError::InvalidGlyph("simple glyph x coordinates truncated"))
      }
      let dx = read_i16_be(data, g_off + pos)
      pos = pos + 2
      x = x + dx
    }
    xs.push(x.to_double())
    i = i + 1
  }

  // Decode y coordinates
  let ys : Array[Double] = []
  let mut y = 0
  i = 0
  while i < num_points {
    let fl = flags[i]
    let y_short = (fl & 0x04) != 0
    let y_same_or_pos = (fl & 0x20) != 0
    if y_short {
      if pos >= g_len {
        return Err(OpenTypeError::InvalidGlyph("simple glyph y coordinates truncated"))
      }
      let dy = read_u8(data, g_off + pos)
      pos = pos + 1
      y = if y_same_or_pos { y + dy } else { y - dy }
    } else if !y_same_or_pos {
      if pos + 2 > g_len {
        return Err(OpenTypeError::InvalidGlyph("simple glyph y coordinates truncated"))
      }
      let dy = read_i16_be(data, g_off + pos)
      pos = pos + 2
      y = y + dy
    }
    ys.push(y.to_double())
    i = i + 1
  }

  // Emit contours
  let mut start = 0
  c = 0
  while c < num_contours {
    let end = end_pts[c]
    emit_contour(xs, ys, on_curve, start, end, tf, builder)
    start = end + 1
    c = c + 1
  }
  Ok(())
}

fn outline_glyph_rec(
  data : Bytes,
  loca_off : Int,
  loca_len : Int,
  glyf_off : Int,
  glyf_len : Int,
  index_to_loc_format : Int,
  num_glyphs : Int,
  gid : Int,
  tf : Affine2D,
  depth : Int,
  state : OutlineState,
  builder : OutlineBuilder,
) -> Result[Option[Rect], OpenTypeError] {
  if depth > max_compound_depth {
    return Err(OpenTypeError::LimitExceeded("compound glyph recursion depth exceeded"))
  }
  // Cycle detection on ancestor stack
  let mut s = 0
  while s < state.stack.length() {
    if state.stack[s] == gid {
      return Err(OpenTypeError::InvalidGlyph("compound glyph cycle detected"))
    }
    s = s + 1
  }

  match loca_glyph_range(data, loca_off, loca_len, glyf_len, index_to_loc_format, num_glyphs, gid) {
    Err(e) => Err(e)
    Ok(None) => Ok(None)
    Ok(Some((rel_off, rel_len))) => {
      if rel_len < 10 {
        return Err(OpenTypeError::InvalidGlyph("glyf entry shorter than 10 bytes"))
      }
      let g_off = glyf_off + rel_off
      let num_contours = read_i16_be(data, g_off)
      let bbox = Rect::{
        x_min: read_i16_be(data, g_off + 2),
        y_min: read_i16_be(data, g_off + 4),
        x_max: read_i16_be(data, g_off + 6),
        y_max: read_i16_be(data, g_off + 8),
      }
      if num_contours >= 0 {
        match outline_simple_glyph(data, g_off, rel_len, num_contours, tf, state, builder) {
          Err(e) => return Err(e)
          Ok(_) => return Ok(Some(bbox))
        }
      }

      // Compound glyph (num_contours < 0)
      state.stack.push(gid)
      let mut pos = 10
      let mut more = true
      while more {
        if state.total_components >= max_compound_components {
          let _ = state.stack.pop()
          return Err(OpenTypeError::LimitExceeded("compound glyph component count exceeded"))
        }
        state.total_components = state.total_components + 1

        if pos + 4 > rel_len {
          let _ = state.stack.pop()
          return Err(OpenTypeError::InvalidGlyph("compound glyph component header truncated"))
        }
        let flags = read_u16_be(data, g_off + pos)
        let comp_gid = read_u16_be(data, g_off + pos + 2)
        pos = pos + 4

        let args_are_words = (flags & 0x0001) != 0
        let args_are_xy = (flags & 0x0002) != 0
        let have_scale = (flags & 0x0008) != 0
        more = (flags & 0x0020) != 0
        let have_xy_scale = (flags & 0x0040) != 0
        let have_two_by_two = (flags & 0x0080) != 0

        let mut tx = 0.0
        let mut ty = 0.0
        if args_are_words {
          if pos + 4 > rel_len {
            let _ = state.stack.pop()
            return Err(OpenTypeError::InvalidGlyph("compound glyph word args truncated"))
          }
          if args_are_xy {
            tx = read_i16_be(data, g_off + pos).to_double()
            ty = read_i16_be(data, g_off + pos + 2).to_double()
          }
          pos = pos + 4
        } else {
          if pos + 2 > rel_len {
            let _ = state.stack.pop()
            return Err(OpenTypeError::InvalidGlyph("compound glyph byte args truncated"))
          }
          if args_are_xy {
            tx = read_i8(data, g_off + pos).to_double()
            ty = read_i8(data, g_off + pos + 1).to_double()
          }
          pos = pos + 2
        }

        let mut ma = 1.0
        let mut mb = 0.0
        let mut mc = 0.0
        let mut md = 1.0
        if have_scale {
          if pos + 2 > rel_len {
            let _ = state.stack.pop()
            return Err(OpenTypeError::InvalidGlyph("compound glyph scale truncated"))
          }
          let sc = f2dot14_to_double(read_i16_be(data, g_off + pos))
          ma = sc
          md = sc
          pos = pos + 2
        } else if have_xy_scale {
          if pos + 4 > rel_len {
            let _ = state.stack.pop()
            return Err(OpenTypeError::InvalidGlyph("compound glyph xy scale truncated"))
          }
          ma = f2dot14_to_double(read_i16_be(data, g_off + pos))
          md = f2dot14_to_double(read_i16_be(data, g_off + pos + 2))
          pos = pos + 4
        } else if have_two_by_two {
          if pos + 8 > rel_len {
            let _ = state.stack.pop()
            return Err(OpenTypeError::InvalidGlyph("compound glyph 2x2 matrix truncated"))
          }
          ma = f2dot14_to_double(read_i16_be(data, g_off + pos))
          mb = f2dot14_to_double(read_i16_be(data, g_off + pos + 2))
          mc = f2dot14_to_double(read_i16_be(data, g_off + pos + 4))
          md = f2dot14_to_double(read_i16_be(data, g_off + pos + 6))
          pos = pos + 8
        }

        let comp_tf = Affine2D::{ a: ma, b: mb, c: mc, d: md, e: tx, f: ty }
        let combined = affine_combine(tf, comp_tf)
        match outline_glyph_rec(
          data,
          loca_off,
          loca_len,
          glyf_off,
          glyf_len,
          index_to_loc_format,
          num_glyphs,
          comp_gid,
          combined,
          depth + 1,
          state,
          builder,
        ) {
          Err(e) => {
            let _ = state.stack.pop()
            return Err(e)
          }
          Ok(_) => ()
        }
      }
      let _ = state.stack.pop()
      Ok(Some(bbox))
    }
  }
}

fn outline_glyph_impl(
  data : Bytes,
  loca_off : Int,
  loca_len : Int,
  glyf_off : Int,
  glyf_len : Int,
  index_to_loc_format : Int,
  num_glyphs : Int,
  gid : Int,
  builder : OutlineBuilder,
) -> Result[Option[Rect], OpenTypeError] {
  let state = OutlineState::{ total_components: 0, total_points: 0, stack: [] }
  let before = builder.len()
  match outline_glyph_rec(
    data,
    loca_off,
    loca_len,
    glyf_off,
    glyf_len,
    index_to_loc_format,
    num_glyphs,
    gid,
    affine_identity(),
    0,
    state,
    builder,
  ) {
    Err(e) => Err(e)
    Ok(None) => Ok(None)
    Ok(Some(bbox)) => if builder.len() == before { Ok(None) } else { Ok(Some(bbox)) }
  }
}
