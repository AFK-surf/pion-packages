///| `cmap` character-to-glyph mapping engine supporting Formats 0, 4, 6, 10, 12, 13, and 14 (UVS).
///| Strictly zero-allocation O(log N) binary search with full bounds & overflow protection.

val struct CmapSubtable {
  off : Int
  len : Int
  fmt : Int
  is_symbol : Bool
  prio : Int
}

val struct CmapUvsSubtable {
  off : Int
  len : Int
}

fn cmap_is_unicode_encoding(platform_id : Int, encoding_id : Int) -> Bool {
  if platform_id == 0 {
    return encoding_id <= 6 && encoding_id != 5
  }
  if platform_id == 3 {
    return encoding_id == 1 || encoding_id == 10
  }
  false
}

fn cmap_is_symbol_encoding(platform_id : Int, encoding_id : Int) -> Bool {
  platform_id == 3 && encoding_id == 0
}

fn cmap_subtable_priority(platform_id : Int, encoding_id : Int, format : Int) -> Int {
  // Prefer Unicode full repertoire (fmt 12/13/10) > Unicode BMP (fmt 4) > fmt 6/0 > Windows Symbol (3,0).
  // Legacy Mac Roman (1,0) subtables map Mac Roman bytes, not Unicode scalar values, and are not used.
  if cmap_is_unicode_encoding(platform_id, encoding_id) {
    if format == 12 || format == 13 {
      return 100
    }
    if format == 10 {
      return 90
    }
    if format == 4 {
      return 80
    }
    if format == 6 {
      return 60
    }
    if format == 0 {
      return 40
    }
  }
  if cmap_is_symbol_encoding(platform_id, encoding_id) {
    // Windows Symbol (3,0)
    if format == 4 {
      return 30
    }
    if format == 6 {
      return 25
    }
    if format == 0 {
      return 20
    }
  }
  0
}

fn cmap_parse_subtables(
  data : Bytes,
  cmap_off : Int,
  cmap_len : Int,
) -> (Array[CmapSubtable], Array[CmapUvsSubtable]) {
  let subs : Array[CmapSubtable] = []
  let uvs : Array[CmapUvsSubtable] = []
  if cmap_off < 0 || cmap_len < 4 {
    return (subs, uvs)
  }
  let num_tables = read_u16_be(data, cmap_off + 2)
  if num_tables == 0 || 4L + num_tables.to_int64() * 8L > cmap_len.to_int64() {
    return (subs, uvs)
  }
  // Single O(n) pass: retain at most 1 best subtable per category (<= 4 total)
  // and at most 1 Format 14 UVS subtable, keeping Face::parse O(n) and lookups O(1).
  let mut best_full : Option[CmapSubtable] = None
  let mut best_bmp : Option[CmapSubtable] = None
  let mut best_other : Option[CmapSubtable] = None
  let mut best_sym : Option[CmapSubtable] = None
  let mut best_uvs : Option[CmapUvsSubtable] = None
  let mut best_uvs_prio = 0

  let mut i = 0
  while i < num_tables {
    let rec = cmap_off + 4 + i * 8
    let pid = read_u16_be(data, rec)
    let eid = read_u16_be(data, rec + 2)
    let rel = read_u32_be(data, rec + 4)
    if rel >= 4L && rel + 2L <= cmap_len.to_int64() {
      let s_off = cmap_off + rel.to_int()
      let s_len = cmap_len - rel.to_int()
      let fmt = read_u16_be(data, s_off)
      if fmt == 14 {
        let uprio = if pid == 0 && eid == 5 { 2 } else { 1 }
        if uprio > best_uvs_prio {
          best_uvs_prio = uprio
          best_uvs = Some(CmapUvsSubtable::{ off: s_off, len: s_len })
        }
      } else {
        let prio = cmap_subtable_priority(pid, eid, fmt)
        if prio > 0 {
          let is_sym = cmap_is_symbol_encoding(pid, eid)
          let cand = CmapSubtable::{ off: s_off, len: s_len, fmt: fmt, is_symbol: is_sym, prio: prio }
          if is_sym {
            match best_sym {
              None => best_sym = Some(cand)
              Some(cur) => if prio > cur.prio { best_sym = Some(cand) }
            }
          } else if fmt == 12 || fmt == 13 || fmt == 10 {
            match best_full {
              None => best_full = Some(cand)
              Some(cur) => if prio > cur.prio { best_full = Some(cand) }
            }
          } else if fmt == 4 {
            match best_bmp {
              None => best_bmp = Some(cand)
              Some(cur) => if prio > cur.prio { best_bmp = Some(cand) }
            }
          } else {
            match best_other {
              None => best_other = Some(cand)
              Some(cur) => if prio > cur.prio { best_other = Some(cand) }
            }
          }
        }
      }
    }
    i = i + 1
  }

  match best_full {
    Some(s) => subs.push(s)
    None => ()
  }
  match best_bmp {
    Some(s) => subs.push(s)
    None => ()
  }
  match best_other {
    Some(s) => subs.push(s)
    None => ()
  }
  match best_sym {
    Some(s) => subs.push(s)
    None => ()
  }
  match best_uvs {
    Some(u) => uvs.push(u)
    None => ()
  }
  (subs, uvs)
}

fn cmap_lookup_fmt0(data : Bytes, sub_off : Int, sub_len : Int, cp : Int) -> Option[Int] {
  if cp < 0 || cp >= 256 || sub_len < 262 {
    return None
  }
  let gid = read_u8(data, sub_off + 6 + cp)
  if gid == 0 { None } else { Some(gid) }
}

fn cmap_lookup_fmt4(data : Bytes, sub_off : Int, sub_len : Int, cp : Int) -> Option[Int] {
  if cp < 0 || cp > 0xFFFF || sub_len < 16 {
    return None
  }
  let seg_count_x2 = read_u16_be(data, sub_off + 6)
  if seg_count_x2 == 0 || (seg_count_x2 & 1) != 0 {
    return None
  }
  let seg_count = seg_count_x2 / 2
  // Layout: 14 header + endCode[seg_count*2] + 2 pad + startCode[seg_count*2] + idDelta[seg_count*2] + idRangeOffset[seg_count*2]
  let arrays_end = 16L + seg_count.to_int64() * 8L
  if arrays_end > sub_len.to_int64() {
    return None
  }
  let end_codes_off = sub_off + 14
  let start_codes_off = end_codes_off + seg_count_x2 + 2
  let id_delta_off = start_codes_off + seg_count_x2
  let id_range_off = id_delta_off + seg_count_x2

  // Binary search for smallest index i with endCode[i] >= cp
  let mut lo = 0
  let mut hi = seg_count - 1
  let mut found = -1
  while lo <= hi {
    let mid = lo + (hi - lo) / 2
    let ec = read_u16_be(data, end_codes_off + mid * 2)
    if cp <= ec {
      found = mid
      hi = mid - 1
    } else {
      lo = mid + 1
    }
  }
  if found < 0 {
    return None
  }
  let sc = read_u16_be(data, start_codes_off + found * 2)
  if cp < sc {
    return None
  }
  let id_delta = read_i16_be(data, id_delta_off + found * 2)
  let id_range_pos = id_range_off + found * 2
  let id_range_val = read_u16_be(data, id_range_pos)
  if id_range_val == 0 {
    let gid = (cp + id_delta) & 0xFFFF
    return if gid == 0 { None } else { Some(gid) }
  }
  // Offset relative to id_range_pos
  let glyph_rel = (id_range_pos - sub_off).to_int64() + id_range_val.to_int64() + (cp - sc).to_int64() * 2L
  if glyph_rel < 0L || glyph_rel + 2L > sub_len.to_int64() {
    return None
  }
  let raw_gid = read_u16_be(data, sub_off + glyph_rel.to_int())
  if raw_gid == 0 {
    return None
  }
  let gid = (raw_gid + id_delta) & 0xFFFF
  if gid == 0 { None } else { Some(gid) }
}

fn cmap_lookup_fmt6(data : Bytes, sub_off : Int, sub_len : Int, cp : Int) -> Option[Int] {
  if cp < 0 || cp > 0xFFFF || sub_len < 10 {
    return None
  }
  let first_code = read_u16_be(data, sub_off + 6)
  let entry_count = read_u16_be(data, sub_off + 8)
  if 10L + entry_count.to_int64() * 2L > sub_len.to_int64() {
    return None
  }
  if cp < first_code || cp >= first_code + entry_count {
    return None
  }
  let gid = read_u16_be(data, sub_off + 10 + (cp - first_code) * 2)
  if gid == 0 { None } else { Some(gid) }
}

fn cmap_lookup_fmt10(data : Bytes, sub_off : Int, sub_len : Int, cp : Int) -> Option[Int] {
  if cp < 0 || sub_len < 20 {
    return None
  }
  let start_char = read_u32_be(data, sub_off + 12)
  let num_chars = read_u32_be(data, sub_off + 16)
  if num_chars < 0L || 20L + num_chars * 2L > sub_len.to_int64() {
    return None
  }
  let cp64 = cp.to_int64()
  if cp64 < start_char || cp64 >= start_char + num_chars {
    return None
  }
  let idx = (cp64 - start_char).to_int()
  let gid = read_u16_be(data, sub_off + 20 + idx * 2)
  if gid == 0 { None } else { Some(gid) }
}

fn cmap_lookup_fmt12_or_13(
  data : Bytes,
  sub_off : Int,
  sub_len : Int,
  cp : Int,
  is_fmt13 : Bool,
) -> Option[Int] {
  if cp < 0 || sub_len < 16 {
    return None
  }
  let num_groups = read_u32_be(data, sub_off + 12)
  let max_groups = (sub_len.to_int64() - 16L) / 12L
  if num_groups <= 0L || num_groups > max_groups {
    return None
  }
  let cp64 = cp.to_int64()
  let mut lo = 0L
  let mut hi = num_groups - 1L
  while lo <= hi {
    let mid = lo + (hi - lo) / 2L
    let g_off = sub_off + 16 + (mid * 12L).to_int()
    let start_c = read_u32_be(data, g_off)
    let end_c = read_u32_be(data, g_off + 4)
    if cp64 < start_c {
      hi = mid - 1L
    } else if cp64 > end_c {
      lo = mid + 1L
    } else {
      let start_gid = read_u32_be(data, g_off + 8)
      let gid64 = if is_fmt13 { start_gid } else { start_gid + (cp64 - start_c) }
      if gid64 <= 0L || gid64 > 65535L {
        return None
      }
      return Some(gid64.to_int())
    }
  }
  None
}

fn cmap_lookup_subtable(data : Bytes, sub : CmapSubtable, cp : Int) -> Option[Int] {
  let fmt = sub.fmt
  if fmt == 4 {
    cmap_lookup_fmt4(data, sub.off, sub.len, cp)
  } else if fmt == 12 {
    cmap_lookup_fmt12_or_13(data, sub.off, sub.len, cp, false)
  } else if fmt == 13 {
    cmap_lookup_fmt12_or_13(data, sub.off, sub.len, cp, true)
  } else if fmt == 6 {
    cmap_lookup_fmt6(data, sub.off, sub.len, cp)
  } else if fmt == 10 {
    cmap_lookup_fmt10(data, sub.off, sub.len, cp)
  } else if fmt == 0 {
    cmap_lookup_fmt0(data, sub.off, sub.len, cp)
  } else {
    None
  }
}

fn cmap_glyph_index_cached(data : Bytes, subs : Array[CmapSubtable], cp : Int) -> Option[Int] {
  if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    return None
  }
  let n = subs.length()
  let mut i = 0
  while i < n {
    let sub = subs[i]
    match cmap_lookup_subtable(data, sub, cp) {
      Some(gid) => return Some(gid)
      None => ()
    }
    if sub.is_symbol && cp <= 0x00FF {
      match cmap_lookup_subtable(data, sub, cp + 0xF000) {
        Some(gid) => return Some(gid)
        None => ()
      }
    }
    i = i + 1
  }
  None
}

fn cmap_lookup_fmt14(
  data : Bytes,
  sub_off : Int,
  sub_len : Int,
  cp : Int,
  vs : Int,
) -> Option[VariationGlyph] {
  if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) || vs < 0 || vs > 0xFFFFFF ||
  (vs >= 0xD800 && vs <= 0xDFFF) || sub_len < 10 {
    return None
  }
  let num_recs = read_u32_be(data, sub_off + 6)
  let max_recs = (sub_len.to_int64() - 10L) / 11L
  if num_recs <= 0L || num_recs > max_recs {
    return None
  }
  // Binary search varSelectorRecords (11 bytes each)
  let mut lo = 0L
  let mut hi = num_recs - 1L
  let mut found_rec = -1
  while lo <= hi {
    let mid = lo + (hi - lo) / 2L
    let r_off = sub_off + 10 + (mid * 11L).to_int()
    let rec_vs = read_u24_be(data, r_off)
    if vs < rec_vs {
      hi = mid - 1L
    } else if vs > rec_vs {
      lo = mid + 1L
    } else {
      found_rec = r_off
      break
    }
  }
  if found_rec < 0 {
    return None
  }
  let default_off = read_u32_be(data, found_rec + 3)
  let non_default_off = read_u32_be(data, found_rec + 7)

  // 1. Check Default UVS Table (4-byte ranges: u24 startUnicodeValue, u8 additionalCount)
  if default_off > 0L && default_off + 4L <= sub_len.to_int64() {
    let d_off = sub_off + default_off.to_int()
    let num_ranges = read_u32_be(data, d_off)
    let max_ranges = (sub_len.to_int64() - default_off - 4L) / 4L
    if num_ranges > 0L && num_ranges <= max_ranges {
      let mut rlo = 0L
      let mut rhi = num_ranges - 1L
      while rlo <= rhi {
        let rmid = rlo + (rhi - rlo) / 2L
        let p = d_off + 4 + (rmid * 4L).to_int()
        let start_u = read_u24_be(data, p)
        let add_cnt = read_u8(data, p + 3)
        if cp < start_u {
          rhi = rmid - 1L
        } else if cp > start_u + add_cnt {
          rlo = rmid + 1L
        } else {
          return Some(VariationGlyph::UseDefault)
        }
      }
    }
  }

  // 2. Check Non-Default UVS Table (5-byte mappings: u24 unicodeValue, u16 glyphID)
  if non_default_off > 0L && non_default_off + 4L <= sub_len.to_int64() {
    let nd_off = sub_off + non_default_off.to_int()
    let num_maps = read_u32_be(data, nd_off)
    let max_maps = (sub_len.to_int64() - non_default_off - 4L) / 5L
    if num_maps > 0L && num_maps <= max_maps {
      let mut mlo = 0L
      let mut mhi = num_maps - 1L
      while mlo <= mhi {
        let mmid = mlo + (mhi - mlo) / 2L
        let p = nd_off + 4 + (mmid * 5L).to_int()
        let u = read_u24_be(data, p)
        if cp < u {
          mhi = mmid - 1L
        } else if cp > u {
          mlo = mmid + 1L
        } else {
          let gid = read_u16_be(data, p + 3)
          return Some(VariationGlyph::Found(gid))
        }
      }
    }
  }
  None
}

fn cmap_glyph_variation_index_cached(
  data : Bytes,
  uvs : Array[CmapUvsSubtable],
  cp : Int,
  vs : Int,
) -> Option[VariationGlyph] {
  let n = uvs.length()
  let mut i = 0
  while i < n {
    let sub = uvs[i]
    match cmap_lookup_fmt14(data, sub.off, sub.len, cp, vs) {
      Some(res) => return Some(res)
      None => ()
    }
    i = i + 1
  }
  None
}
