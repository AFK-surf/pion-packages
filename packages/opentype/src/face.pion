///| SFNT & TTC container parser and public `Face` API for `packages/opentype`.

///| Parsed OpenType / TrueType font face.
pub struct Face {
  data : Bytes
  kind : SfntKind
  sfnt_off : Int
  num_tables : Int
  tables_fast_sorted : Bool
  head : HeadTable
  maxp : MaxpTable
  num_glyphs : Int
  index_to_loc_format : Int
  hhea_off : Int
  hhea_len : Int
  num_h_metrics : Int
  vhea_off : Int
  vhea_len : Int
  os2_off : Int
  os2_len : Int
  post_off : Int
  post_len : Int
  hmtx_off : Int
  hmtx_len : Int
  loca_off : Int
  loca_len : Int
  glyf_off : Int
  glyf_len : Int
  cmap0_off : Int
  cmap0_len : Int
  cmap0_fmt : Int
  cmap0_sym : Bool
  cmap0_aux : Int
  cmap1_off : Int
  cmap1_len : Int
  cmap1_fmt : Int
  cmap1_sym : Bool
  cmap1_aux : Int
  cmap2_off : Int
  cmap2_len : Int
  cmap2_fmt : Int
  cmap2_sym : Bool
  cmap2_aux : Int
  cmap3_off : Int
  cmap3_len : Int
  cmap3_fmt : Int
  cmap3_sym : Bool
  cmap3_aux : Int
  cmap_uvs_off : Int
  cmap_uvs_len : Int
}

///| Return the number of font faces in a TrueType Collection (`ttcf`), or `None` if not a valid TTC.
pub fn fonts_in_collection(data : Bytes) -> Option[Int] {
  if data.length() < 12 {
    return None
  }
  let magic = read_u32_be(data, 0)
  if magic != 0x74746366L {
    return None
  }
  let version = read_u32_be(data, 4)
  if version != 0x00010000L && version != 0x00020000L {
    return None
  }
  let num_fonts = read_u32_be(data, 8)
  if num_fonts <= 0L || num_fonts > max_ttc_fonts.to_int64() {
    return None
  }
  if !check_range(data.length(), 12L, num_fonts * 4L) {
    return None
  }
  Some(num_fonts.to_int())
}

fn find_table_packed(
  data : Bytes,
  sfnt_off : Int,
  num_tables : Int,
  fast_sorted : Bool,
  tag_val : Int64,
) -> Int64 {
  let dir_off = sfnt_off + 12
  if fast_sorted {
    let mut lo = 0
    let mut hi = num_tables - 1
    while lo <= hi {
      let mid = lo + ((hi - lo) >> 1)
      let rec_pos = dir_off + (mid << 4)
      let t = read_u32_be(data, rec_pos)
      if tag_val < t {
        hi = mid - 1
      } else if tag_val > t {
        lo = mid + 1
      } else {
        let tbl_off = read_u32_be(data, rec_pos + 8)
        let tbl_len = read_u32_be(data, rec_pos + 12)
        return (tbl_off << 32) | (tbl_len & 0xFFFFFFFFL)
      }
    }
    return -1L
  }
  let data_len = data.length()
  let mut i = 0
  while i < num_tables {
    let rec_pos = dir_off + (i << 4)
    if read_u32_be(data, rec_pos) == tag_val {
      let tbl_off = read_u32_be(data, rec_pos + 8)
      let tbl_len = read_u32_be(data, rec_pos + 12)
      if check_range(data_len, tbl_off, tbl_len) {
        return (tbl_off << 32) | (tbl_len & 0xFFFFFFFFL)
      }
    }
    i = i + 1
  }
  -1L
}

fn sort_table_records(tables : Array[TableRecord]) -> Unit {
  let n = tables.length()
  let mut i = 1
  while i < n {
    let key = tables[i]
    let mut j = i - 1
    while j >= 0 && tables[j].tag.value > key.tag.value {
      tables[j + 1] = tables[j]
      j = j - 1
    }
    tables[j + 1] = key
    i = i + 1
  }
}

///| Parse a font face from SFNT or TTC bytes at `face_index`.
pub fn Face::parse(data : Bytes, face_index : Int) -> Result[Face, OpenTypeError] {
  let data_len = data.length()
  if data_len < 12 {
    return Err(OpenTypeError::UnexpectedEof("font data shorter than 12 bytes"))
  }
  if face_index < 0 {
    return Err(OpenTypeError::InvalidIndex("negative face_index"))
  }

  let magic = read_u32_be(data, 0)
  let mut sfnt_offset = 0L
  if magic == 0x74746366L {
    // TrueType Collection (ttcf)
    let ttc_ver = read_u32_be(data, 4)
    if ttc_ver != 0x00010000L && ttc_ver != 0x00020000L {
      return Err(OpenTypeError::InvalidMagic("unsupported ttcf version"))
    }
    let num_fonts = read_u32_be(data, 8)
    if num_fonts <= 0L || num_fonts > max_ttc_fonts.to_int64() {
      return Err(OpenTypeError::LimitExceeded("ttcf numFonts out of range"))
    }
    if !check_range(data_len, 12L, num_fonts * 4L) {
      return Err(OpenTypeError::UnexpectedEof("ttcf offset table truncated"))
    }
    if face_index.to_int64() >= num_fonts {
      return Err(OpenTypeError::InvalidIndex("face_index out of ttcf range"))
    }
    sfnt_offset = read_u32_be(data, 12 + face_index * 4)
    if !check_range(data_len, sfnt_offset, 12L) {
      return Err(OpenTypeError::InvalidTableDirectory("ttcf face offset out of bounds"))
    }
  } else if face_index != 0 {
    return Err(OpenTypeError::InvalidIndex("face_index must be 0 for non-TTC font"))
  }

  let off = sfnt_offset.to_int()
  let sfnt_ver = read_u32_be(data, off)
  let kind = if sfnt_ver == 0x00010000L {
    SfntKind::TrueType
  } else if sfnt_ver == 0x4F54544FL {
    SfntKind::OpenTypeCff
  } else if sfnt_ver == 0x74727565L {
    SfntKind::AppleTrueType
  } else {
    return Err(OpenTypeError::InvalidMagic("unrecognized SFNT version"))
  }

  let num_tables = read_u16_be(data, off + 4)
  if num_tables == 0 || num_tables > max_num_tables {
    return Err(OpenTypeError::InvalidTableDirectory("numTables out of valid range"))
  }
  if !check_range(data_len, sfnt_offset + 12L, num_tables.to_int64() * 16L) {
    return Err(OpenTypeError::UnexpectedEof("SFNT table directory truncated"))
  }

  // Single zero-allocation pass over the SFNT table directory.
  let mut fast_sorted = true
  let mut prev_tag = -1L
  let mut head_off = -1
  let mut head_len = 0
  let mut maxp_off = -1
  let mut maxp_len = 0
  let mut hhea_off = -1
  let mut hhea_len = 0
  let mut vhea_off = -1
  let mut vhea_len = 0
  let mut os2_off = -1
  let mut os2_len = 0
  let mut post_off = -1
  let mut post_len = 0
  let mut cmap_off = -1
  let mut cmap_len = 0
  let mut hmtx_off = -1
  let mut hmtx_len = 0
  let mut loca_off = -1
  let mut loca_len = 0
  let mut glyf_off = -1
  let mut glyf_len = 0

  let dl64 = data_len.to_int64()
  let dir_base = off + 12
  let mut i = 0
  while i < num_tables {
    let rec_pos = dir_base + (i << 4)
    let tag_val = read_u32_be(data, rec_pos)
    let tbl_off = read_u32_be(data, rec_pos + 8)
    let tbl_len = read_u32_be(data, rec_pos + 12)
    // Skip out-of-bounds or u32-wrapping records instead of rejecting the whole face;
    // required tables (head/maxp) will fail below if missing or invalid.
    if tbl_off >= 0L && tbl_len >= 0L && tbl_off <= dl64 && tbl_len <= dl64 - tbl_off {
      if tag_val < prev_tag {
        fast_sorted = false
      }
      prev_tag = tag_val
      if tag_val == 0x68656164L {
        head_off = tbl_off.to_int()
        head_len = tbl_len.to_int()
      } else if tag_val == 0x6D617870L {
        maxp_off = tbl_off.to_int()
        maxp_len = tbl_len.to_int()
      } else if tag_val == 0x68686561L {
        hhea_off = tbl_off.to_int()
        hhea_len = tbl_len.to_int()
      } else if tag_val == 0x76686561L {
        vhea_off = tbl_off.to_int()
        vhea_len = tbl_len.to_int()
      } else if tag_val == 0x4F532F32L {
        os2_off = tbl_off.to_int()
        os2_len = tbl_len.to_int()
      } else if tag_val == 0x706F7374L {
        post_off = tbl_off.to_int()
        post_len = tbl_len.to_int()
      } else if tag_val == 0x636D6170L {
        cmap_off = tbl_off.to_int()
        cmap_len = tbl_len.to_int()
      } else if tag_val == 0x686D7478L {
        hmtx_off = tbl_off.to_int()
        hmtx_len = tbl_len.to_int()
      } else if tag_val == 0x6C6F6361L {
        loca_off = tbl_off.to_int()
        loca_len = tbl_len.to_int()
      } else if tag_val == 0x676C7966L {
        glyf_off = tbl_off.to_int()
        glyf_len = tbl_len.to_int()
      }
    } else {
      fast_sorted = false
    }
    i = i + 1
  }

  // Required: head
  if head_off < 0 {
    return Err(OpenTypeError::MissingRequiredTable("head"))
  }
  let head = match parse_head_table(data, head_off, head_len) {
    Ok(h) => h
    Err(e) => return Err(e)
  }

  // Required: maxp
  if maxp_off < 0 {
    return Err(OpenTypeError::MissingRequiredTable("maxp"))
  }
  let maxp = match parse_maxp_table(data, maxp_off, maxp_len) {
    Ok(m) => m
    Err(e) => return Err(e)
  }

  let num_h_metrics = if hhea_off >= 0 && hhea_len >= 36 {
    read_u16_be(data, hhea_off + 34)
  } else {
    -1
  }

  // Single O(n) zero-allocation pass over cmap encoding records:
  // retain at most 1 best subtable per category (full, bmp, other, sym) + 1 UVS.
  let mut bf_off = -1
  let mut bf_len = 0
  let mut bf_fmt = 0
  let mut bf_prio = 0

  let mut bb_off = -1
  let mut bb_len = 0
  let mut bb_fmt = 0
  let mut bb_prio = 0

  let mut bo_off = -1
  let mut bo_len = 0
  let mut bo_fmt = 0
  let mut bo_prio = 0

  let mut bs_off = -1
  let mut bs_len = 0
  let mut bs_fmt = 0
  let mut bs_prio = 0

  let mut uvs_off = -1
  let mut uvs_len = 0
  let mut uvs_prio = 0

  if cmap_off >= 0 && cmap_len >= 4 {
    let cmap_num = read_u16_be(data, cmap_off + 2)
    if cmap_num > 0 && 4L + cmap_num.to_int64() * 8L <= cmap_len.to_int64() {
      let cmap_len64 = cmap_len.to_int64()
      let mut ci = 0
      while ci < cmap_num {
        let rec = cmap_off + 4 + (ci << 3)
        let pid = read_u16_be(data, rec)
        let eid = read_u16_be(data, rec + 2)
        let rel = read_u32_be(data, rec + 4)
        if rel >= 4L && rel + 2L <= cmap_len64 {
          let rel_i = rel.to_int()
          let s_off = cmap_off + rel_i
          let s_len = cmap_len - rel_i
          let fmt = read_u16_be(data, s_off)
          if fmt == 14 {
            let uprio = if pid == 0 && eid == 5 { 2 } else { 1 }
            if uprio > uvs_prio {
              uvs_prio = uprio
              uvs_off = s_off
              uvs_len = s_len
            }
          } else {
            let prio = cmap_subtable_priority(pid, eid, fmt)
            if prio > 0 {
              if pid == 3 && eid == 0 {
                if prio > bs_prio {
                  bs_prio = prio
                  bs_off = s_off
                  bs_len = s_len
                  bs_fmt = fmt
                }
              } else if fmt == 12 || fmt == 13 || fmt == 10 {
                if prio > bf_prio {
                  bf_prio = prio
                  bf_off = s_off
                  bf_len = s_len
                  bf_fmt = fmt
                }
              } else if fmt == 4 {
                if prio > bb_prio {
                  bb_prio = prio
                  bb_off = s_off
                  bb_len = s_len
                  bb_fmt = fmt
                }
              } else if prio > bo_prio {
                bo_prio = prio
                bo_off = s_off
                bo_len = s_len
                bo_fmt = fmt
              }
            }
          }
        }
        ci = ci + 1
      }
    }
  }

  // Pack non-empty cmap slots densely in priority order: full -> bmp -> other -> sym
  let mut c0_off = -1
  let mut c0_len = 0
  let mut c0_fmt = 0
  let mut c0_sym = false
  let mut c1_off = -1
  let mut c1_len = 0
  let mut c1_fmt = 0
  let mut c1_sym = false
  let mut c2_off = -1
  let mut c2_len = 0
  let mut c2_fmt = 0
  let mut c2_sym = false
  let mut c3_off = -1
  let mut c3_len = 0
  let mut c3_fmt = 0
  let mut c3_sym = false

  if bf_off >= 0 {
    c0_off = bf_off
    c0_len = bf_len
    c0_fmt = bf_fmt
  }
  if bb_off >= 0 {
    if c0_off < 0 {
      c0_off = bb_off
      c0_len = bb_len
      c0_fmt = bb_fmt
    } else {
      c1_off = bb_off
      c1_len = bb_len
      c1_fmt = bb_fmt
    }
  }
  if bo_off >= 0 {
    if c0_off < 0 {
      c0_off = bo_off
      c0_len = bo_len
      c0_fmt = bo_fmt
    } else if c1_off < 0 {
      c1_off = bo_off
      c1_len = bo_len
      c1_fmt = bo_fmt
    } else {
      c2_off = bo_off
      c2_len = bo_len
      c2_fmt = bo_fmt
    }
  }
  if bs_off >= 0 {
    if c0_off < 0 {
      c0_off = bs_off
      c0_len = bs_len
      c0_fmt = bs_fmt
      c0_sym = true
    } else if c1_off < 0 {
      c1_off = bs_off
      c1_len = bs_len
      c1_fmt = bs_fmt
      c1_sym = true
    } else if c2_off < 0 {
      c2_off = bs_off
      c2_len = bs_len
      c2_fmt = bs_fmt
      c2_sym = true
    } else {
      c3_off = bs_off
      c3_len = bs_len
      c3_fmt = bs_fmt
      c3_sym = true
    }
  }

  let c0_aux = cmap_precompute_aux(data, c0_off, c0_len, c0_fmt)
  let c1_aux = if c1_off >= 0 { cmap_precompute_aux(data, c1_off, c1_len, c1_fmt) } else { 0 }
  let c2_aux = if c2_off >= 0 { cmap_precompute_aux(data, c2_off, c2_len, c2_fmt) } else { 0 }
  let c3_aux = if c3_off >= 0 { cmap_precompute_aux(data, c3_off, c3_len, c3_fmt) } else { 0 }

  Ok(
    Face::{
      data: data,
      kind: kind,
      sfnt_off: off,
      num_tables: num_tables,
      tables_fast_sorted: fast_sorted,
      head: head,
      maxp: maxp,
      num_glyphs: maxp.num_glyphs,
      index_to_loc_format: head.index_to_loc_format,
      hhea_off: hhea_off,
      hhea_len: hhea_len,
      num_h_metrics: num_h_metrics,
      vhea_off: vhea_off,
      vhea_len: vhea_len,
      os2_off: os2_off,
      os2_len: os2_len,
      post_off: post_off,
      post_len: post_len,
      hmtx_off: hmtx_off,
      hmtx_len: hmtx_len,
      loca_off: loca_off,
      loca_len: loca_len,
      glyf_off: glyf_off,
      glyf_len: glyf_len,
      cmap0_off: c0_off,
      cmap0_len: c0_len,
      cmap0_fmt: c0_fmt,
      cmap0_sym: c0_sym,
      cmap0_aux: c0_aux,
      cmap1_off: c1_off,
      cmap1_len: c1_len,
      cmap1_fmt: c1_fmt,
      cmap1_sym: c1_sym,
      cmap1_aux: c1_aux,
      cmap2_off: c2_off,
      cmap2_len: c2_len,
      cmap2_fmt: c2_fmt,
      cmap2_sym: c2_sym,
      cmap2_aux: c2_aux,
      cmap3_off: c3_off,
      cmap3_len: c3_len,
      cmap3_fmt: c3_fmt,
      cmap3_sym: c3_sym,
      cmap3_aux: c3_aux,
      cmap_uvs_off: uvs_off,
      cmap_uvs_len: uvs_len,
    },
  )
}

///| SFNT flavor (`TrueType`, `OpenTypeCff`, or `AppleTrueType`).
pub fn Face::kind(self : Face) -> SfntKind {
  self.kind
}

///| Table directory entries sorted by tag (returned as an independent copy).
pub fn Face::tables(self : Face) -> Array[TableRecord] {
  let out : Array[TableRecord] = []
  let data = self.data
  let data_len = data.length()
  let dir_base = self.sfnt_off + 12
  let mut i = 0
  while i < self.num_tables {
    let rec_pos = dir_base + (i << 4)
    let tag_val = read_u32_be(data, rec_pos)
    let checksum = read_u32_be(data, rec_pos + 4)
    let tbl_off = read_u32_be(data, rec_pos + 8)
    let tbl_len = read_u32_be(data, rec_pos + 12)
    if check_range(data_len, tbl_off, tbl_len) {
      out.push(
        TableRecord::{
          tag: Tag::{ value: tag_val },
          checksum: checksum,
          offset: tbl_off,
          length: tbl_len,
        },
      )
    }
    i = i + 1
  }
  if !self.tables_fast_sorted {
    sort_table_records(out)
  }
  out
}

///| Zero-copy lookup of a raw table slice by 4-byte tag.
pub fn Face::table_data(self : Face, tag : Tag) -> Option[Bytes] {
  let packed = find_table_packed(
    self.data,
    self.sfnt_off,
    self.num_tables,
    self.tables_fast_sorted,
    tag.value,
  )
  if packed < 0L {
    return None
  }
  let start = (packed >> 32).to_int()
  let len = (packed & 0xFFFFFFFFL).to_int()
  Some(self.data.slice(start, start + len))
}

///| Zero-copy lookup of a raw table slice by 4-character ASCII tag name.
pub fn Face::table_data_by_name(self : Face, name : String) -> Option[Bytes] {
  match Tag::from_string(name) {
    Some(t) => self.table_data(t)
    None => None
  }
}

///| Parsed `head` table.
pub fn Face::head(self : Face) -> HeadTable {
  self.head
}

///| Parsed `maxp` table.
pub fn Face::maxp(self : Face) -> MaxpTable {
  self.maxp
}

///| Units per EM from `head`.
pub fn Face::units_per_em(self : Face) -> Int {
  self.head.units_per_em
}

///| Global font bounding box from `head`.
pub fn Face::global_bounding_box(self : Face) -> Rect {
  Rect::{
    x_min: self.head.x_min,
    y_min: self.head.y_min,
    x_max: self.head.x_max,
    y_max: self.head.y_max,
  }
}

///| Total number of glyphs from `maxp`.
pub fn Face::number_of_glyphs(self : Face) -> Int {
  self.num_glyphs
}

///| Parsed `hhea` table, if present.
pub fn Face::hhea(self : Face) -> Option[HheaTable] {
  if self.hhea_off < 0 {
    return None
  }
  parse_hhea_table(self.data, self.hhea_off, self.hhea_len)
}

///| Parsed `vhea` table, if present.
pub fn Face::vhea(self : Face) -> Option[VheaTable] {
  if self.vhea_off < 0 {
    return None
  }
  parse_vhea_table(self.data, self.vhea_off, self.vhea_len)
}

///| Parsed `OS/2` table, if present.
pub fn Face::os2(self : Face) -> Option[Os2Table] {
  if self.os2_off < 0 {
    return None
  }
  parse_os2_table(self.data, self.os2_off, self.os2_len)
}

///| Parsed `post` table, if present.
pub fn Face::post(self : Face) -> Option[PostTable] {
  if self.post_off < 0 {
    return None
  }
  parse_post_table(self.data, self.post_off, self.post_len)
}

///| Horizontal advance width for `gid` from `hmtx`.
pub fn Face::glyph_hor_advance(self : Face, gid : Int) -> Option[Int] {
  if self.hmtx_off < 0 || self.num_h_metrics <= 0 {
    return None
  }
  lookup_metric_advance(
    self.data,
    self.hmtx_off,
    self.hmtx_len,
    self.num_h_metrics,
    self.num_glyphs,
    gid,
  )
}

///| Horizontal left side bearing for `gid` from `hmtx`.
pub fn Face::glyph_hor_side_bearing(self : Face, gid : Int) -> Option[Int] {
  if self.hmtx_off < 0 || self.num_h_metrics <= 0 {
    return None
  }
  lookup_metric_side_bearing(
    self.data,
    self.hmtx_off,
    self.hmtx_len,
    self.num_h_metrics,
    self.num_glyphs,
    gid,
  )
}

///| Vertical advance height for `gid` from `vmtx`.
pub fn Face::glyph_ver_advance(self : Face, gid : Int) -> Option[Int] {
  if self.vhea_off < 0 || self.vhea_len < 36 {
    return None
  }
  let packed = find_table_packed(
    self.data,
    self.sfnt_off,
    self.num_tables,
    self.tables_fast_sorted,
    0x766D7478L,
  )
  if packed < 0L {
    return None
  }
  let num_v_metrics = read_u16_be(self.data, self.vhea_off + 34)
  lookup_metric_advance(
    self.data,
    (packed >> 32).to_int(),
    (packed & 0xFFFFFFFFL).to_int(),
    num_v_metrics,
    self.maxp.num_glyphs,
    gid,
  )
}

///| Vertical top side bearing for `gid` from `vmtx`.
pub fn Face::glyph_ver_side_bearing(self : Face, gid : Int) -> Option[Int] {
  if self.vhea_off < 0 || self.vhea_len < 36 {
    return None
  }
  let packed = find_table_packed(
    self.data,
    self.sfnt_off,
    self.num_tables,
    self.tables_fast_sorted,
    0x766D7478L,
  )
  if packed < 0L {
    return None
  }
  let num_v_metrics = read_u16_be(self.data, self.vhea_off + 34)
  lookup_metric_side_bearing(
    self.data,
    (packed >> 32).to_int(),
    (packed & 0xFFFFFFFFL).to_int(),
    num_v_metrics,
    self.maxp.num_glyphs,
    gid,
  )
}

///| All records in the `name` table (safely bounded).
pub fn Face::name_records(self : Face) -> Array[NameRecord] {
  let packed = find_table_packed(
    self.data,
    self.sfnt_off,
    self.num_tables,
    self.tables_fast_sorted,
    0x6E616D65L,
  )
  if packed < 0L {
    return []
  }
  parse_name_records(
    self.data,
    (packed >> 32).to_int(),
    (packed & 0xFFFFFFFFL).to_int(),
  )
}

///| Look up preferred decoded string for a `name` table `name_id`.
pub fn Face::name_by_id(self : Face, name_id : Int) -> Option[String] {
  let packed = find_table_packed(
    self.data,
    self.sfnt_off,
    self.num_tables,
    self.tables_fast_sorted,
    0x6E616D65L,
  )
  if packed < 0L {
    return None
  }
  find_preferred_name(
    self.data,
    (packed >> 32).to_int(),
    (packed & 0xFFFFFFFFL).to_int(),
    name_id,
  )
}

///| Font family name (nameID 1).
pub fn Face::family_name(self : Face) -> Option[String] {
  self.name_by_id(1)
}

///| Font subfamily name (nameID 2).
pub fn Face::subfamily_name(self : Face) -> Option[String] {
  self.name_by_id(2)
}

///| Full font name (nameID 4).
pub fn Face::full_name(self : Face) -> Option[String] {
  self.name_by_id(4)
}

///| PostScript name (nameID 6).
pub fn Face::postscript_name(self : Face) -> Option[String] {
  self.name_by_id(6)
}

///| Typographic family name (nameID 16).
pub fn Face::typographic_family(self : Face) -> Option[String] {
  self.name_by_id(16)
}

///| Typographic subfamily name (nameID 17).
pub fn Face::typographic_subfamily(self : Face) -> Option[String] {
  self.name_by_id(17)
}

///| Map a Unicode scalar value (`codepoint`) to a glyph ID via `cmap`.
pub fn Face::glyph_index(self : Face, codepoint : Int) -> Option[Int] {
  if codepoint < 0 || codepoint > 0x10FFFF || (codepoint >= 0xD800 && codepoint <= 0xDFFF) ||
  self.cmap0_off < 0 {
    return None
  }
  let g0 = if self.cmap0_fmt == 4 && !self.cmap0_sym {
    cmap_lookup_fmt4(self.data, self.cmap0_off, self.cmap0_len, self.cmap0_aux, codepoint)
  } else if self.cmap0_fmt == 12 && !self.cmap0_sym {
    cmap_lookup_fmt12_or_13(self.data, self.cmap0_off, self.cmap0_aux, codepoint, false)
  } else {
    cmap_lookup_slot(
      self.data,
      self.cmap0_off,
      self.cmap0_len,
      self.cmap0_fmt,
      self.cmap0_aux,
      self.cmap0_sym,
      codepoint,
    )
  }
  if g0 != 0 {
    return Some(g0)
  }
  if self.cmap1_off >= 0 {
    let g1 = cmap_lookup_slot(
      self.data,
      self.cmap1_off,
      self.cmap1_len,
      self.cmap1_fmt,
      self.cmap1_aux,
      self.cmap1_sym,
      codepoint,
    )
    if g1 != 0 {
      return Some(g1)
    }
    if self.cmap2_off >= 0 {
      let g2 = cmap_lookup_slot(
        self.data,
        self.cmap2_off,
        self.cmap2_len,
        self.cmap2_fmt,
        self.cmap2_aux,
        self.cmap2_sym,
        codepoint,
      )
      if g2 != 0 {
        return Some(g2)
      }
      if self.cmap3_off >= 0 {
        let g3 = cmap_lookup_slot(
          self.data,
          self.cmap3_off,
          self.cmap3_len,
          self.cmap3_fmt,
          self.cmap3_aux,
          self.cmap3_sym,
          codepoint,
        )
        if g3 != 0 {
          return Some(g3)
        }
      }
    }
  }
  None
}

///| Map a Unicode Variation Sequence `(codepoint, variation_selector)` via `cmap` Format 14.
pub fn Face::glyph_variation_index(
  self : Face,
  codepoint : Int,
  variation_selector : Int,
) -> Option[VariationGlyph] {
  if self.cmap_uvs_off < 0 {
    return None
  }
  cmap_lookup_fmt14(self.data, self.cmap_uvs_off, self.cmap_uvs_len, codepoint, variation_selector)
}

///| Look up horizontal kerning adjustment between `(left_gid, right_gid)` via `kern` Format 0.
pub fn Face::kerning(self : Face, left_gid : Int, right_gid : Int) -> Int {
  let packed = find_table_packed(
    self.data,
    self.sfnt_off,
    self.num_tables,
    self.tables_fast_sorted,
    0x6B65726EL,
  )
  if packed < 0L {
    return 0
  }
  kern_lookup_pair(
    self.data,
    (packed >> 32).to_int(),
    (packed & 0xFFFFFFFFL).to_int(),
    left_gid,
    right_gid,
  )
}

///| Return all variation axes from `fvar`.
pub fn Face::variation_axes(self : Face) -> Array[VariationAxis] {
  let packed = find_table_packed(
    self.data,
    self.sfnt_off,
    self.num_tables,
    self.tables_fast_sorted,
    0x66766172L,
  )
  if packed < 0L {
    return []
  }
  parse_fvar_axes(
    self.data,
    (packed >> 32).to_int(),
    (packed & 0xFFFFFFFFL).to_int(),
  )
}

///| Return all named instances from `fvar`.
pub fn Face::named_instances(self : Face) -> Array[NamedInstance] {
  let packed = find_table_packed(
    self.data,
    self.sfnt_off,
    self.num_tables,
    self.tables_fast_sorted,
    0x66766172L,
  )
  if packed < 0L {
    return []
  }
  parse_fvar_instances(
    self.data,
    (packed >> 32).to_int(),
    (packed & 0xFFFFFFFFL).to_int(),
  )
}

///| Return `avar` axis segment maps (one array of `AvarValueMap` per axis).
pub fn Face::avar_segments(self : Face) -> Array[Array[AvarValueMap]] {
  let packed = find_table_packed(
    self.data,
    self.sfnt_off,
    self.num_tables,
    self.tables_fast_sorted,
    0x61766172L,
  )
  if packed < 0L {
    return []
  }
  parse_avar_segments(
    self.data,
    (packed >> 32).to_int(),
    (packed & 0xFFFFFFFFL).to_int(),
  )
}

///| Normalize user-space variation coordinates to F2Dot14 integers in `[-16384, 16384]`.
pub fn Face::normalize_variation_coords(self : Face, coords : Array[Double]) -> Array[Int] {
  let axes = self.variation_axes()
  let avar = self.avar_segments()
  normalize_variation_coords_impl(axes, avar, coords)
}

///| Bounding box of glyph `gid` from `loca` + `glyf`.
pub fn Face::glyph_bounding_box(self : Face, gid : Int) -> Result[Option[Rect], OpenTypeError] {
  if self.loca_off < 0 || self.glyf_off < 0 {
    return Ok(None)
  }
  glyf_bounding_box_impl(
    self.data,
    self.loca_off,
    self.loca_len,
    self.glyf_off,
    self.glyf_len,
    self.index_to_loc_format,
    self.num_glyphs,
    gid,
  )
}

///| Outline glyph `gid` from `loca` + `glyf` into `builder`, returning its bounding box.
pub fn Face::outline_glyph(
  self : Face,
  gid : Int,
  builder : OutlineBuilder,
) -> Result[Option[Rect], OpenTypeError] {
  if self.loca_off < 0 || self.glyf_off < 0 {
    return Ok(None)
  }
  outline_glyph_impl(
    self.data,
    self.loca_off,
    self.loca_len,
    self.glyf_off,
    self.glyf_len,
    self.index_to_loc_format,
    self.num_glyphs,
    gid,
    builder,
  )
}
