///| `kern` (Format 0, OpenType v0 + Apple AAT v1.0) and variable font `fvar` / `avar` tables.

fn kern_fmt0_lookup(data : Bytes, sub_body_off : Int, sub_body_len : Int, target_key : Int64) -> Int {
  if sub_body_len < 8 {
    return 0
  }
  let n_pairs = read_u16_be(data, sub_body_off)
  let max_pairs = (sub_body_len - 8) / 6
  let count = if n_pairs < max_pairs { n_pairs } else { max_pairs }
  if count <= 0 {
    return 0
  }
  let pairs_off = sub_body_off + 8
  let mut lo = 0
  let mut hi = count - 1
  while lo <= hi {
    let mid = lo + (hi - lo) / 2
    let p = pairs_off + mid * 6
    let k = read_u32_be(data, p)
    if target_key < k {
      hi = mid - 1
    } else if target_key > k {
      lo = mid + 1
    } else {
      return read_i16_be(data, p + 4)
    }
  }
  0
}

fn kern_lookup_pair(
  data : Bytes,
  kern_off : Int,
  kern_len : Int,
  left_gid : Int,
  right_gid : Int,
) -> Int {
  if left_gid < 0 || left_gid > 65535 || right_gid < 0 || right_gid > 65535 || kern_len < 4 {
    return 0
  }
  let target_key = (left_gid.to_int64() << 16) | right_gid.to_int64()
  let version_u16 = read_u16_be(data, kern_off)
  if version_u16 == 0 {
    // OpenType kern v0: u16 version, u16 nTables
    let n_tables = read_u16_be(data, kern_off + 2)
    let mut pos = 4
    let mut i = 0
    let mut total = 0
    while i < n_tables && pos + 6 <= kern_len {
      let sub_len = read_u16_be(data, kern_off + pos + 2)
      let coverage = read_u16_be(data, kern_off + pos + 4)
      let effective_len = if sub_len < 6 || pos + sub_len > kern_len {
        kern_len - pos
      } else {
        sub_len
      }
      let format = (coverage >> 8) & 0xFF
      let is_horizontal = (coverage & 0x0001) != 0
      let is_minimum = (coverage & 0x0002) != 0
      let is_cross_stream = (coverage & 0x0004) != 0
      let is_override = (coverage & 0x0008) != 0
      if format == 0 && is_horizontal && !is_minimum && !is_cross_stream {
        let v = kern_fmt0_lookup(data, kern_off + pos + 6, effective_len - 6, target_key)
        if is_override {
          if v != 0 {
            total = v
          }
        } else {
          total = total + v
        }
      }
      if sub_len < 6 {
        break
      }
      pos = pos + sub_len
      i = i + 1
    }
    return total
  }
  // Apple AAT kern v1.0: u32 version == 0x00010000, u32 nTables
  if kern_len >= 8 && read_u32_be(data, kern_off) == 0x00010000L {
    let n_tables = read_u32_be(data, kern_off + 4)
    let mut pos = 8L
    let mut i = 0L
    let mut total = 0
    let limit = if n_tables > 64L { 64L } else { n_tables }
    while i < limit && pos + 8L <= kern_len.to_int64() {
      let sub_len = read_u32_be(data, kern_off + pos.to_int())
      let coverage = read_u16_be(data, kern_off + pos.to_int() + 4)
      if sub_len < 8L || pos + sub_len > kern_len.to_int64() {
        break
      }
      let format = coverage & 0x00FF
      let is_vertical = (coverage & 0x8000) != 0
      let is_cross_stream = (coverage & 0x4000) != 0
      let is_variation = (coverage & 0x2000) != 0
      if format == 0 && !is_vertical && !is_cross_stream && !is_variation {
        let v = kern_fmt0_lookup(
          data,
          kern_off + pos.to_int() + 8,
          (sub_len - 8L).to_int(),
          target_key,
        )
        total = total + v
      }
      pos = pos + sub_len
      i = i + 1L
    }
    return total
  }
  0
}

fn parse_fvar_axes(data : Bytes, off : Int, len : Int) -> Array[VariationAxis] {
  let out : Array[VariationAxis] = []
  if len < 16 {
    return out
  }
  let major = read_u16_be(data, off)
  let minor = read_u16_be(data, off + 2)
  if major != 1 || minor != 0 {
    return out
  }
  let axes_off = read_u16_be(data, off + 4)
  let axis_count = read_u16_be(data, off + 8)
  let axis_size = read_u16_be(data, off + 10)
  if axis_count == 0 || axis_count > max_fvar_axes || axis_size < 20 {
    return out
  }
  if axes_off.to_int64() + axis_count.to_int64() * axis_size.to_int64() > len.to_int64() {
    return out
  }
  let mut i = 0
  while i < axis_count {
    let p = off + axes_off + i * axis_size
    let tag_val = read_u32_be(data, p)
    let min_f = read_i32_be(data, p + 4)
    let def_f = read_i32_be(data, p + 8)
    let max_f = read_i32_be(data, p + 12)
    let flags = read_u16_be(data, p + 16)
    let name_id = read_u16_be(data, p + 18)
    out.push(
      VariationAxis::{
        tag: Tag::{ value: tag_val },
        min_fixed: min_f,
        default_fixed: def_f,
        max_fixed: max_f,
        min_value: min_f.to_double() / 65536.0,
        default_value: def_f.to_double() / 65536.0,
        max_value: max_f.to_double() / 65536.0,
        flags: flags,
        hidden: (flags & 0x0001) != 0,
        name_id: name_id,
      },
    )
    i = i + 1
  }
  out
}

fn parse_fvar_instances(data : Bytes, off : Int, len : Int) -> Array[NamedInstance] {
  let out : Array[NamedInstance] = []
  if len < 16 {
    return out
  }
  let major = read_u16_be(data, off)
  let minor = read_u16_be(data, off + 2)
  if major != 1 || minor != 0 {
    return out
  }
  let axes_off = read_u16_be(data, off + 4)
  let axis_count = read_u16_be(data, off + 8)
  let axis_size = read_u16_be(data, off + 10)
  let inst_count = read_u16_be(data, off + 12)
  let inst_size = read_u16_be(data, off + 14)
  if axis_count > max_fvar_axes || inst_count == 0 || inst_count > max_fvar_instances {
    return out
  }
  let min_inst_size = 4 + axis_count * 4
  if inst_size < min_inst_size {
    return out
  }
  let inst_start = axes_off.to_int64() + axis_count.to_int64() * axis_size.to_int64()
  if inst_start + inst_count.to_int64() * inst_size.to_int64() > len.to_int64() {
    return out
  }
  let has_ps_name = inst_size >= min_inst_size + 2
  let mut i = 0
  while i < inst_count {
    let p = off + inst_start.to_int() + i * inst_size
    let subfam_id = read_u16_be(data, p)
    let flags = read_u16_be(data, p + 2)
    let coords_fixed : Array[Int64] = []
    let coords : Array[Double] = []
    let mut a = 0
    while a < axis_count {
      let cf = read_i32_be(data, p + 4 + a * 4)
      coords_fixed.push(cf)
      coords.push(cf.to_double() / 65536.0)
      a = a + 1
    }
    let ps_id = if has_ps_name {
      Some(read_u16_be(data, p + 4 + axis_count * 4))
    } else {
      None
    }
    out.push(
      NamedInstance::{
        subfamily_name_id: subfam_id,
        flags: flags,
        coordinates_fixed: coords_fixed,
        coordinates: coords,
        postscript_name_id: ps_id,
      },
    )
    i = i + 1
  }
  out
}

fn parse_avar_segments(data : Bytes, off : Int, len : Int) -> Array[Array[AvarValueMap]] {
  let out : Array[Array[AvarValueMap]] = []
  if len < 8 {
    return out
  }
  let major = read_u16_be(data, off)
  let minor = read_u16_be(data, off + 2)
  if major != 1 || minor != 0 {
    return out
  }
  let axis_count = read_u16_be(data, off + 6)
  if axis_count == 0 || axis_count > max_fvar_axes {
    return out
  }
  let mut pos = 8
  let mut a = 0
  while a < axis_count {
    if pos + 2 > len {
      return []
    }
    let pair_count = read_u16_be(data, off + pos)
    pos = pos + 2
    if pair_count > max_avar_pairs || pos.to_int64() + pair_count.to_int64() * 4L > len.to_int64() {
      return []
    }
    let seg : Array[AvarValueMap] = []
    let mut k = 0
    while k < pair_count {
      let from_c = read_i16_be(data, off + pos)
      let to_c = read_i16_be(data, off + pos + 2)
      seg.push(AvarValueMap::{ from_coordinate: from_c, to_coordinate: to_c })
      pos = pos + 4
      k = k + 1
    }
    out.push(seg)
    a = a + 1
  }
  out
}

fn apply_avar_segment(seg : Array[AvarValueMap], v : Double) -> Double {
  let n = seg.length()
  if n < 2 {
    return v
  }
  let first_from = f2dot14_to_double(seg[0].from_coordinate)
  if v <= first_from {
    return f2dot14_to_double(seg[0].to_coordinate)
  }
  let last_from = f2dot14_to_double(seg[n - 1].from_coordinate)
  if v >= last_from {
    return f2dot14_to_double(seg[n - 1].to_coordinate)
  }
  let mut i = 1
  while i < n {
    let f1 = f2dot14_to_double(seg[i].from_coordinate)
    if v <= f1 {
      let f0 = f2dot14_to_double(seg[i - 1].from_coordinate)
      let t0 = f2dot14_to_double(seg[i - 1].to_coordinate)
      let t1 = f2dot14_to_double(seg[i].to_coordinate)
      let denom = f1 - f0
      if denom == 0.0 {
        return t1
      }
      return t0 + ((v - f0) / denom) * (t1 - t0)
    }
    i = i + 1
  }
  v
}

fn normalize_variation_coords_impl(
  axes : Array[VariationAxis],
  avar : Array[Array[AvarValueMap]],
  coords : Array[Double],
) -> Array[Int] {
  let out : Array[Int] = []
  let n = axes.length()
  let mut i = 0
  while i < n {
    let ax = axes[i]
    let raw = if i < coords.length() { coords[i] } else { ax.default_value }
    let clamped = if raw < ax.min_value {
      ax.min_value
    } else if raw > ax.max_value {
      ax.max_value
    } else {
      raw
    }
    let mut norm = if clamped < ax.default_value {
      let denom = ax.default_value - ax.min_value
      if denom > 0.0 { (clamped - ax.default_value) / denom } else { 0.0 }
    } else if clamped > ax.default_value {
      let denom = ax.max_value - ax.default_value
      if denom > 0.0 { (clamped - ax.default_value) / denom } else { 0.0 }
    } else {
      0.0
    }
    if i < avar.length() && avar[i].length() >= 2 {
      norm = apply_avar_segment(avar[i], norm)
    }
    let scaled = if norm >= 0.0 {
      (norm * 16384.0 + 0.5).to_int()
    } else {
      (norm * 16384.0 - 0.5).to_int()
    }
    let f2d14 = if scaled < -16384 {
      -16384
    } else if scaled > 16384 {
      16384
    } else {
      scaled
    }
    out.push(f2d14)
    i = i + 1
  }
  out
}
