///| `kern` (Format 0, OpenType v0 + Apple AAT v1.0) and variable font `fvar` / `avar` tables.

fn kern_fmt0_lookup(data : Bytes, sub_body_off : Int, sub_body_len : Int, target_key : Int64) -> Int {
  if sub_body_len < 8 {
    return 0
  }
  let n_pairs = read_u16_be(data, sub_body_off)
  let max_pairs = (sub_body_len - 8) / 6
  let count = if n_pairs < max_pairs { n_pairs } else { max_pairs }
  if count <= 0 {
    return 0
  }
  let pairs_off = sub_body_off + 8
  let mut lo = 0
  let mut hi = count - 1
  while lo <= hi {
    let mid = lo + (hi - lo) / 2
    let p = pairs_off + mid * 6
    let k = read_u32_be(data, p)
    if target_key < k {
      hi = mid - 1
    } else if target_key > k {
      lo = mid + 1
    } else {
      return read_i16_be(data, p + 4)
    }
  }
  0
}

fn kern_lookup_pair(
  data : Bytes,
  kern_off : Int,
  kern_len : Int,
  left_gid : Int,
  right_gid : Int,
) -> Int {
  if left_gid < 0 || left_gid > 65535 || right_gid < 0 || right_gid > 65535 || kern_len < 4 {
    return 0
  }
  let target_key = (left_gid.to_int64() << 16) | right_gid.to_int64()
  let version_u16 = read_u16_be(data, kern_off)
  if version_u16 == 0 {
    // OpenType kern v0: u16 version, u16 nTables
    let n_tables = read_u16_be(data, kern_off + 2)
    let mut pos = 4
    let mut i = 0
    let mut total = 0
    while i < n_tables && pos + 6 <= kern_len {
      let sub_len = read_u16_be(data, kern_off + pos + 2)
      let coverage = read_u16_be(data, kern_off + pos + 4)
      let is_last = i + 1 == n_tables
      let effective_len = if is_last || sub_len < 6 || pos + sub_len > kern_len {
        kern_len - pos
      } else {
        sub_len
      }
      let format = (coverage >> 8) & 0xFF
      let is_horizontal = (coverage & 0x0001) != 0
      let is_minimum = (coverage & 0x0002) != 0
      let is_cross_stream = (coverage & 0x0004) != 0
      let is_override = (coverage & 0x0008) != 0
      if format == 0 && is_horizontal && !is_minimum && !is_cross_stream {
        let v = kern_fmt0_lookup(data, kern_off + pos + 6, effective_len - 6, target_key)
        if is_override {
          if v != 0 {
            total = v
          }
        } else {
          total = total + v
        }
      }
      if sub_len < 6 {
        break
      }
      pos = pos + sub_len
      i = i + 1
    }
    return total
  }
  // Apple AAT kern v1.0: u32 version == 0x00010000, u32 nTables
  if kern_len >= 8 && read_u32_be(data, kern_off) == 0x00010000L {
    let n_tables = read_u32_be(data, kern_off + 4)
    let mut pos = 8L
    let mut i = 0L
    let mut total = 0
    let limit = if n_tables > 64L { 64L } else { n_tables }
    while i < limit && pos + 8L <= kern_len.to_int64() {
      let sub_len = read_u32_be(data, kern_off + pos.to_int())
      let coverage = read_u16_be(data, kern_off + pos.to_int() + 4)
      if sub_len < 8L || pos + sub_len > kern_len.to_int64() {
        break
      }
      let format = coverage & 0x00FF
      let is_vertical = (coverage & 0x8000) != 0
      let is_cross_stream = (coverage & 0x4000) != 0
      let is_variation = (coverage & 0x2000) != 0
      if format == 0 && !is_vertical && !is_cross_stream && !is_variation {
        let v = kern_fmt0_lookup(
          data,
          kern_off + pos.to_int() + 8,
          (sub_len - 8L).to_int(),
          target_key,
        )
        total = total + v
      }
      pos = pos + sub_len
      i = i + 1L
    }
    return total
  }
  0
}

fn parse_fvar_axes(data : Bytes, off : Int, len : Int) -> Array[VariationAxis] {
  let out : Array[VariationAxis] = []
  if len < 16 {
    return out
  }
  let major = read_u16_be(data, off)
  let minor = read_u16_be(data, off + 2)
  if major != 1 || minor != 0 {
    return out
  }
  let axes_off = read_u16_be(data, off + 4)
  let axis_count = read_u16_be(data, off + 8)
  let axis_size = read_u16_be(data, off + 10)
  if axis_count == 0 || axis_count > max_fvar_axes || axis_size < 20 {
    return out
  }
  if axes_off.to_int64() + axis_count.to_int64() * axis_size.to_int64() > len.to_int64() {
    return out
  }
  let mut i = 0
  while i < axis_count {
    let p = off + axes_off + i * axis_size
    let tag_val = read_u32_be(data, p)
    let min_f = read_i32_be(data, p + 4)
    let def_f = read_i32_be(data, p + 8)
    let max_f = read_i32_be(data, p + 12)
    let flags = read_u16_be(data, p + 16)
    let name_id = read_u16_be(data, p + 18)
    out.push(
      VariationAxis::{
        tag: Tag::{ value: tag_val },
        min_fixed: min_f,
        default_fixed: def_f,
        max_fixed: max_f,
        min_value: min_f.to_double() / 65536.0,
        default_value: def_f.to_double() / 65536.0,
        max_value: max_f.to_double() / 65536.0,
        flags: flags,
        hidden: (flags & 0x0001) != 0,
        name_id: name_id,
      },
    )
    i = i + 1
  }
  out
}

fn parse_fvar_instances(data : Bytes, off : Int, len : Int) -> Array[NamedInstance] {
  let out : Array[NamedInstance] = []
  if len < 16 {
    return out
  }
  let major = read_u16_be(data, off)
  let minor = read_u16_be(data, off + 2)
  if major != 1 || minor != 0 {
    return out
  }
  let axes_off = read_u16_be(data, off + 4)
  let axis_count = read_u16_be(data, off + 8)
  let axis_size = read_u16_be(data, off + 10)
  let inst_count = read_u16_be(data, off + 12)
  let inst_size = read_u16_be(data, off + 14)
  if axis_count > max_fvar_axes || inst_count == 0 || inst_count > max_fvar_instances {
    return out
  }
  let min_inst_size = 4 + axis_count * 4
  if inst_size < min_inst_size {
    return out
  }
  let inst_start = axes_off.to_int64() + axis_count.to_int64() * axis_size.to_int64()
  if inst_start + inst_count.to_int64() * inst_size.to_int64() > len.to_int64() {
    return out
  }
  let has_ps_name = inst_size >= min_inst_size + 2
  let mut i = 0
  while i < inst_count {
    let p = off + inst_start.to_int() + i * inst_size
    let subfam_id = read_u16_be(data, p)
    let flags = read_u16_be(data, p + 2)
    let coords_fixed : Array[Int64] = []
    let coords : Array[Double] = []
    let mut a = 0
    while a < axis_count {
      let cf = read_i32_be(data, p + 4 + a * 4)
      coords_fixed.push(cf)
      coords.push(cf.to_double() / 65536.0)
      a = a + 1
    }
    let ps_id = if has_ps_name {
      let raw_ps = read_u16_be(data, p + 4 + axis_count * 4)
      if raw_ps == 0xFFFF { None } else { Some(raw_ps) }
    } else {
      None
    }
    out.push(
      NamedInstance::{
        subfamily_name_id: subfam_id,
        flags: flags,
        coordinates_fixed: coords_fixed,
        coordinates: coords,
        postscript_name_id: ps_id,
      },
    )
    i = i + 1
  }
  out
}

fn parse_avar_segments(data : Bytes, off : Int, len : Int) -> Array[Array[AvarValueMap]] {
  let out : Array[Array[AvarValueMap]] = []
  if len < 8 {
    return out
  }
  let major = read_u16_be(data, off)
  let minor = read_u16_be(data, off + 2)
  if major != 1 || minor != 0 {
    return out
  }
  let axis_count = read_u16_be(data, off + 6)
  if axis_count == 0 || axis_count > max_fvar_axes {
    return out
  }
  let mut pos = 8
  let mut a = 0
  while a < axis_count {
    if pos + 2 > len {
      return []
    }
    let pair_count = read_u16_be(data, off + pos)
    pos = pos + 2
    if pair_count > max_avar_pairs || pos.to_int64() + pair_count.to_int64() * 4L > len.to_int64() {
      return []
    }
    let seg : Array[AvarValueMap] = []
    let mut k = 0
    while k < pair_count {
      let from_c = read_i16_be(data, off + pos)
      let to_c = read_i16_be(data, off + pos + 2)
      seg.push(AvarValueMap::{ from_coordinate: from_c, to_coordinate: to_c })
      pos = pos + 4
      k = k + 1
    }
    out.push(seg)
    a = a + 1
  }
  out
}

fn fixed_clamp_i32(v : Int64) -> Int64 {
  if v < -0x80000000L {
    -0x80000000L
  } else if v > 0x7FFFFFFFL {
    0x7FFFFFFFL
  } else {
    v
  }
}

fn fixed_sub_sat(a : Int64, b : Int64) -> Int64 {
  fixed_clamp_i32(a - b)
}

fn double_to_fixed16(v : Double) -> Int64 {
  if v >= 32767.999992370605 {
    return 0x7FFFFFFFL
  }
  if v <= -32768.0 {
    return -0x80000000L
  }
  let s = v * 65536.0
  let r = if s >= 0.0 {
    (s + 0.5).to_int64()
  } else {
    (s - 0.5).to_int64()
  }
  fixed_clamp_i32(r)
}

fn fixed_div(a : Int64, b : Int64) -> Int64 {
  let neg = (a < 0L) != (b < 0L)
  let au = if a < 0L { -a } else { a }
  let bu = if b < 0L { -b } else { b }
  let q = if bu == 0L {
    0x7FFFFFFFL
  } else {
    ((au << 16) + (bu >> 1)) / bu
  }
  if neg { -q } else { q }
}

fn fixed_mul_div(s : Int64, a : Int64, b : Int64) -> Int64 {
  let mut neg = false
  let mut su = s
  let mut au = a
  let mut bu = b
  if su < 0L {
    su = -su
    neg = !neg
  }
  if au < 0L {
    au = -au
    neg = !neg
  }
  if bu < 0L {
    bu = -bu
    neg = !neg
  }
  let res = if bu > 0L {
    (su * au + (bu >> 1)) / bu
  } else {
    0x7FFFFFFFL
  }
  if neg { -res } else { res }
}

fn fixed_to_f2dot14(v : Int64) -> Int {
  // OpenType spec: add 0x00000002 and sign-extend shift right by 2.
  let shifted = ((v + 2L) >> 2).to_int()
  if shifted < -16384 {
    -16384
  } else if shifted > 16384 {
    16384
  } else {
    shifted
  }
}

fn apply_avar_segment_fixed(seg : Array[AvarValueMap], coord : Int64) -> Int64 {
  let len = seg.length()
  if len == 0 {
    return coord
  }
  if len == 1 {
    let f0 = seg[0].from_coordinate.to_int64() << 2
    let t0 = seg[0].to_coordinate.to_int64() << 2
    return coord - f0 + t0
  }
  let neg1 = -65536L
  let pos1 = 65536L
  let mut start = 0
  let mut end = len
  if (seg[start].from_coordinate.to_int64() << 2) == neg1 &&
  (seg[start].to_coordinate.to_int64() << 2) == neg1 &&
  (seg[start + 1].from_coordinate.to_int64() << 2) == neg1 {
    start = start + 1
  }
  if (seg[end - 1].from_coordinate.to_int64() << 2) == pos1 &&
  (seg[end - 1].to_coordinate.to_int64() << 2) == pos1 &&
  (seg[end - 2].from_coordinate.to_int64() << 2) == pos1 {
    end = end - 1
  }

  let mut i = start
  while i < end {
    if coord == (seg[i].from_coordinate.to_int64() << 2) {
      break
    }
    i = i + 1
  }
  if i < end {
    let mut j = i
    while j + 1 < end && coord == (seg[j + 1].from_coordinate.to_int64() << 2) {
      j = j + 1
    }
    if i == j {
      return seg[i].to_coordinate.to_int64() << 2
    }
    if i + 2 == j {
      return seg[i + 1].to_coordinate.to_int64() << 2
    }
    if coord < 0L {
      return seg[j].to_coordinate.to_int64() << 2
    }
    if coord > 0L {
      return seg[i].to_coordinate.to_int64() << 2
    }
    let ti = seg[i].to_coordinate.to_int64() << 2
    let tj = seg[j].to_coordinate.to_int64() << 2
    let ai = if ti < 0L { -ti } else { ti }
    let aj = if tj < 0L { -tj } else { tj }
    return if ai < aj { ti } else { tj }
  }

  let mut k = start
  while k < end {
    if coord < (seg[k].from_coordinate.to_int64() << 2) {
      break
    }
    k = k + 1
  }
  if k == 0 {
    let f0 = seg[0].from_coordinate.to_int64() << 2
    let t0 = seg[0].to_coordinate.to_int64() << 2
    return coord - f0 + t0
  }
  if k == end {
    let fl = seg[end - 1].from_coordinate.to_int64() << 2
    let tl = seg[end - 1].to_coordinate.to_int64() << 2
    return coord - fl + tl
  }
  let bf = seg[k - 1].from_coordinate.to_int64() << 2
  let bt = seg[k - 1].to_coordinate.to_int64() << 2
  let af = seg[k].from_coordinate.to_int64() << 2
  let at = seg[k].to_coordinate.to_int64() << 2
  let denom = af - bf
  bt + fixed_mul_div(at - bt, coord - bf, denom)
}

fn normalize_variation_coords_impl(
  axes : Array[VariationAxis],
  avar : Array[Array[AvarValueMap]],
  coords : Array[Double],
) -> Array[Int] {
  let out : Array[Int] = []
  let n = axes.length()
  let mut i = 0
  while i < n {
    let ax = axes[i]
    let min_f = ax.min_fixed
    let def_f = ax.default_fixed
    let max_f = if ax.max_fixed < min_f { min_f } else { ax.max_fixed }
    let mut val_f = if i < coords.length() { double_to_fixed16(coords[i]) } else { def_f }
    if val_f < min_f {
      val_f = min_f
    } else if val_f > max_f {
      val_f = max_f
    }
    let mut norm_f = if val_f < def_f {
      -fixed_div(fixed_sub_sat(def_f, val_f), fixed_sub_sat(def_f, min_f))
    } else if val_f > def_f {
      fixed_div(fixed_sub_sat(val_f, def_f), fixed_sub_sat(max_f, def_f))
    } else {
      0L
    }
    if norm_f < -65536L {
      norm_f = -65536L
    } else if norm_f > 65536L {
      norm_f = 65536L
    }
    if i < avar.length() && avar[i].length() > 0 {
      norm_f = apply_avar_segment_fixed(avar[i], norm_f)
    }
    out.push(fixed_to_f2dot14(norm_f))
    i = i + 1
  }
  out
}
