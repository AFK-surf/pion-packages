///| Comprehensive unit, OpenType spec compliance, and red-team adversarial test suite
///| for `packages/opentype`.
///| Zero third-party binary font files are committed: all fixtures are synthesized in-memory.

fn assert_eq_int(a : Int, b : Int, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got " + a.to_string() + ", expected " + b.to_string())
}

fn assert_eq_i64(a : Int64, b : Int64, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got " + a.to_string() + ", expected " + b.to_string())
}

fn assert_eq_str(a : String, b : String, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got '" + a + "', expected '" + b + "'")
}

fn assert_eq_bool(a : Bool, b : Bool, msg : String) -> Unit {
  debug_assert(a == b, msg)
}

fn assert_near(a : Double, b : Double, eps : Double, msg : String) -> Unit {
  let diff = if a >= b { a - b } else { b - a }
  debug_assert(diff <= eps, msg)
}

fn tag_val(s : String) -> Int64 {
  match Tag::from_string(s) {
    Some(t) => t.value
    None => {
      debug_assert(false, "invalid tag: " + s)
      0L
    }
  }
}

fn expect_face(r : Result[Face, OpenTypeError], msg : String) -> Face {
  match r {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, msg + ": " + e.to_string())
      abort(msg)
    }
  }
}

fn expect_int(o : Option[Int], msg : String) -> Int {
  match o {
    Some(v) => v
    None => {
      debug_assert(false, msg + ": expected Some(Int)")
      0
    }
  }
}

fn expect_str(o : Option[String], msg : String) -> String {
  match o {
    Some(s) => s
    None => {
      debug_assert(false, msg + ": expected Some(String)")
      ""
    }
  }
}

fn is_none_int(o : Option[Int]) -> Bool {
  match o {
    None => true
    Some(_) => false
  }
}

fn is_none_var(o : Option[VariationGlyph]) -> Bool {
  match o {
    None => true
    Some(_) => false
  }
}

fn is_err_face(r : Result[Face, OpenTypeError]) -> Bool {
  match r {
    Err(_) => true
    Ok(_) => false
  }
}

fn is_err_rect(r : Result[Option[Rect], OpenTypeError]) -> Bool {
  match r {
    Err(_) => true
    Ok(_) => false
  }
}

fn push_u8(buf : Array[Int], v : Int) -> Unit {
  buf.push(v & 0xFF)
}

fn push_u16_be(buf : Array[Int], v : Int) -> Unit {
  buf.push((v >> 8) & 0xFF)
  buf.push(v & 0xFF)
}

fn push_i16_be(buf : Array[Int], v : Int) -> Unit {
  let u = if v < 0 { v + 65536 } else { v }
  push_u16_be(buf, u)
}

fn push_u24_be(buf : Array[Int], v : Int) -> Unit {
  buf.push((v >> 16) & 0xFF)
  buf.push((v >> 8) & 0xFF)
  buf.push(v & 0xFF)
}

fn push_u32_be(buf : Array[Int], v : Int64) -> Unit {
  buf.push(((v >> 24) & 0xFFL).to_int())
  buf.push(((v >> 16) & 0xFFL).to_int())
  buf.push(((v >> 8) & 0xFFL).to_int())
  buf.push((v & 0xFFL).to_int())
}

fn push_fixed16_16(buf : Array[Int], v : Double) -> Unit {
  let scaled = if v >= 0.0 {
    (v * 65536.0 + 0.5).to_int64()
  } else {
    (v * 65536.0 - 0.5).to_int64()
  }
  let u = if scaled < 0L { scaled + 0x100000000L } else { scaled }
  push_u32_be(buf, u)
}

fn push_tag(buf : Array[Int], s : String) -> Unit {
  let mut i = 0
  while i < 4 {
    buf.push(s.code_unit_at(i) & 0xFF)
    i = i + 1
  }
}

fn push_utf16be(buf : Array[Int], s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    let cu = s.code_unit_at(i)
    push_u16_be(buf, cu)
    i = i + 1
  }
}

fn push_zeros(buf : Array[Int], count : Int) -> Unit {
  let mut i = 0
  while i < count {
    buf.push(0)
    i = i + 1
  }
}

fn to_bytes(arr : Array[Int]) -> Bytes {
  let n = arr.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = arr[i].to_byte()
    i = i + 1
  }
  out
}

///| Synthesize a valid SFNT font from (tag, payload) pairs.
fn build_sfnt(sfnt_version : Int64, raw_tables : Array[(String, Array[Int])]) -> Array[Int] {
  // Sort tables by 4-byte tag ascending.
  let n = raw_tables.length()
  let tables : Array[(String, Array[Int])] = []
  let mut i = 0
  while i < n {
    tables.push(raw_tables[i])
    i = i + 1
  }
  // Insertion sort
  let mut a = 1
  while a < n {
    let key = tables[a]
    let key_tag = tag_val(key.0)
    let mut b = a - 1
    while b >= 0 && tag_val(tables[b].0) > key_tag {
      tables[b + 1] = tables[b]
      b = b - 1
    }
    tables[b + 1] = key
    a = a + 1
  }

  let buf : Array[Int] = []
  push_u32_be(buf, sfnt_version)
  push_u16_be(buf, n)
  push_u16_be(buf, 0) // searchRange
  push_u16_be(buf, 0) // entrySelector
  push_u16_be(buf, 0) // rangeShift

  let mut offset = 12 + n * 16
  let offsets : Array[Int] = []
  i = 0
  while i < n {
    let (tag, data) = tables[i]
    offsets.push(offset)
    push_tag(buf, tag)
    push_u32_be(buf, 0L) // checksum
    push_u32_be(buf, offset.to_int64())
    push_u32_be(buf, data.length().to_int64())
    offset = offset + data.length()
    while offset % 4 != 0 {
      offset = offset + 1
    }
    i = i + 1
  }

  i = 0
  while i < n {
    let (_, data) = tables[i]
    while buf.length() < offsets[i] {
      buf.push(0)
    }
    let mut k = 0
    while k < data.length() {
      buf.push(data[k])
      k = k + 1
    }
    i = i + 1
  }
  while buf.length() < offset {
    buf.push(0)
  }
  buf
}

fn build_head(upem : Int, loc_fmt : Int) -> Array[Int] {
  let b : Array[Int] = []
  push_u32_be(b, 0x00010000L) // version
  push_u32_be(b, 0x00010000L) // fontRevision
  push_u32_be(b, 0L) // checksumAdjustment
  push_u32_be(b, 0x5F0F3CF5L) // magicNumber
  push_u16_be(b, 0x000B) // flags
  push_u16_be(b, upem) // unitsPerEm
  push_zeros(b, 16) // created, modified
  push_i16_be(b, -50) // xMin
  push_i16_be(b, -200) // yMin
  push_i16_be(b, 1050) // xMax
  push_i16_be(b, 900) // yMax
  push_u16_be(b, 0x0001) // macStyle (bold)
  push_u16_be(b, 8) // lowestRecPPEM
  push_i16_be(b, 2) // fontDirectionHint
  push_i16_be(b, loc_fmt) // indexToLocFormat
  push_i16_be(b, 0) // glyphDataFormat
  b
}

fn build_maxp_v1(num_glyphs : Int) -> Array[Int] {
  let b : Array[Int] = []
  push_u32_be(b, 0x00010000L)
  push_u16_be(b, num_glyphs)
  push_zeros(b, 26)
  b
}

fn build_maxp_v05(num_glyphs : Int) -> Array[Int] {
  let b : Array[Int] = []
  push_u32_be(b, 0x00005000L)
  push_u16_be(b, num_glyphs)
  b
}

fn build_hhea(asc : Int, desc : Int, gap : Int, num_h_metrics : Int) -> Array[Int] {
  let b : Array[Int] = []
  push_u32_be(b, 0x00010000L) // version
  push_i16_be(b, asc)
  push_i16_be(b, desc)
  push_i16_be(b, gap)
  push_u16_be(b, 1000) // advanceWidthMax
  push_i16_be(b, -20) // minLeftSideBearing
  push_i16_be(b, 0) // minRightSideBearing
  push_i16_be(b, 980) // xMaxExtent
  push_i16_be(b, 1) // caretSlopeRise
  push_i16_be(b, 0) // caretSlopeRun
  push_i16_be(b, 0) // caretOffset
  push_zeros(b, 8) // reserved
  push_i16_be(b, 0) // metricDataFormat
  push_u16_be(b, num_h_metrics)
  b
}

fn build_hmtx(metrics : Array[(Int, Int)], extra_lsbs : Array[Int]) -> Array[Int] {
  let b : Array[Int] = []
  let mut i = 0
  while i < metrics.length() {
    let (adv, lsb) = metrics[i]
    push_u16_be(b, adv)
    push_i16_be(b, lsb)
    i = i + 1
  }
  i = 0
  while i < extra_lsbs.length() {
    push_i16_be(b, extra_lsbs[i])
    i = i + 1
  }
  b
}

fn build_vhea(asc : Int, desc : Int, gap : Int, num_v_metrics : Int) -> Array[Int] {
  let b : Array[Int] = []
  push_u32_be(b, 0x00010000L)
  push_i16_be(b, asc)
  push_i16_be(b, desc)
  push_i16_be(b, gap)
  push_u16_be(b, 1000)
  push_zeros(b, 22)
  push_u16_be(b, num_v_metrics)
  b
}

fn build_os2_v4() -> Array[Int] {
  let b : Array[Int] = []
  push_u16_be(b, 4) // version
  push_i16_be(b, 512) // xAvgCharWidth
  push_u16_be(b, 700) // usWeightClass (Bold)
  push_u16_be(b, 5) // usWidthClass (Normal)
  push_u16_be(b, 0) // fsType
  push_i16_be(b, 650) // ySubscriptXSize
  push_i16_be(b, 600) // ySubscriptYSize
  push_i16_be(b, 0) // ySubscriptXOffset
  push_i16_be(b, 75) // ySubscriptYOffset
  push_i16_be(b, 650) // ySuperscriptXSize
  push_i16_be(b, 600) // ySuperscriptYSize
  push_i16_be(b, 0) // ySuperscriptXOffset
  push_i16_be(b, 350) // ySuperscriptYOffset
  push_i16_be(b, 50) // yStrikeoutSize
  push_i16_be(b, 260) // yStrikeoutPosition
  push_i16_be(b, 0) // sFamilyClass
  // panose (10 bytes)
  let mut p = 0
  while p < 10 {
    push_u8(b, p + 1)
    p = p + 1
  }
  push_zeros(b, 16) // ulUnicodeRange1..4
  push_tag(b, "PION") // achVendID
  push_u16_be(b, 0x0020) // fsSelection (BOLD)
  push_u16_be(b, 0x0020) // usFirstCharIndex
  push_u16_be(b, 0x007E) // usLastCharIndex
  push_i16_be(b, 800) // sTypoAscender
  push_i16_be(b, -200) // sTypoDescender
  push_i16_be(b, 90) // sTypoLineGap
  push_u16_be(b, 900) // usWinAscent
  push_u16_be(b, 250) // usWinDescent
  push_zeros(b, 8) // ulCodePageRange1..2
  push_i16_be(b, 520) // sxHeight
  push_i16_be(b, 710) // sCapHeight
  push_u16_be(b, 0) // usDefaultChar
  push_u16_be(b, 0x0020) // usBreakChar
  push_u16_be(b, 2) // usMaxContext
  b
}

fn build_post() -> Array[Int] {
  let b : Array[Int] = []
  push_u32_be(b, 0x00020000L) // version 2.0
  push_fixed16_16(b, -12.5) // italicAngle
  push_i16_be(b, -100) // underlinePosition
  push_i16_be(b, 50) // underlineThickness
  push_u32_be(b, 1L) // isFixedPitch = true
  push_zeros(b, 16) // min/maxMem
  b
}

fn build_name_table() -> Array[Int] {
  // Records:
  // (3, 1, 0x0409, 1) -> "Pion Sans"
  // (3, 1, 0x0409, 2) -> "Bold"
  // (3, 1, 0x0409, 4) -> "Pion Sans Bold"
  // (3, 1, 0x0409, 6) -> "PionSans-Bold"
  // (3, 1, 0x0409, 16) -> "Pion Sans Pro"
  // (3, 1, 0x0409, 17) -> "Display Bold"
  // (1, 0, 0, 1) -> Mac Roman "Caf\x8E" ("Café")
  let str_buf : Array[Int] = []
  let recs : Array[(Int, Int, Int, Int, Int, Int)] = []

  let items : Array[(Int, String)] = [
    (1, "Pion Sans"),
    (2, "Bold"),
    (4, "Pion Sans Bold"),
    (6, "PionSans-Bold"),
    (16, "Pion Sans Pro"),
    (17, "Display Bold"),
  ]
  let mut i = 0
  while i < items.length() {
    let (nid, s) = items[i]
    let off = str_buf.length()
    push_utf16be(str_buf, s)
    let len = str_buf.length() - off
    recs.push((3, 1, 0x0409, nid, len, off))
    i = i + 1
  }
  // Mac Roman record for nameID 9 (Designer): "Caf" + 0x8E ('é' in Mac Roman)
  let mac_off = str_buf.length()
  str_buf.push(0x43) // 'C'
  str_buf.push(0x61) // 'a'
  str_buf.push(0x66) // 'f'
  str_buf.push(0x8E) // 'é' (U+00E9) in Mac Roman
  recs.push((1, 0, 0, 9, 4, mac_off))

  let b : Array[Int] = []
  push_u16_be(b, 0) // format
  push_u16_be(b, recs.length())
  let string_offset = 6 + recs.length() * 12
  push_u16_be(b, string_offset)
  i = 0
  while i < recs.length() {
    let (pid, eid, lid, nid, len, off) = recs[i]
    push_u16_be(b, pid)
    push_u16_be(b, eid)
    push_u16_be(b, lid)
    push_u16_be(b, nid)
    push_u16_be(b, len)
    push_u16_be(b, off)
    i = i + 1
  }
  i = 0
  while i < str_buf.length() {
    b.push(str_buf[i])
    i = i + 1
  }
  b
}

///| Build a `cmap` table with Format 4 (BMP), Format 12 (full Unicode), and Format 14 (UVS).
fn build_cmap_multi() -> Array[Int] {
  // Format 4: maps 'A' (0x41) -> 1, 'B' (0x42) -> 2, 'C' (0x43) -> 3 (via idRangeOffset)
  let fmt4 : Array[Int] = []
  let seg_count = 3 // [0x41..0x42], [0x43..0x43], [0xFFFF..0xFFFF]
  push_u16_be(fmt4, 4) // format
  push_u16_be(fmt4, 16 + seg_count * 8 + 2) // length (+2 for 1 glyphIdArray entry)
  push_u16_be(fmt4, 0) // language
  push_u16_be(fmt4, seg_count * 2) // segCountX2
  push_u16_be(fmt4, 4) // searchRange
  push_u16_be(fmt4, 1) // entrySelector
  push_u16_be(fmt4, 2) // rangeShift
  // endCode
  push_u16_be(fmt4, 0x0042)
  push_u16_be(fmt4, 0x0043)
  push_u16_be(fmt4, 0xFFFF)
  push_u16_be(fmt4, 0) // reservedPad
  // startCode
  push_u16_be(fmt4, 0x0041)
  push_u16_be(fmt4, 0x0043)
  push_u16_be(fmt4, 0xFFFF)
  // idDelta
  push_i16_be(fmt4, 1 - 0x41) // 0x41->1, 0x42->2
  push_i16_be(fmt4, 0)
  push_i16_be(fmt4, 1) // 0xFFFF + 1 = 0
  // idRangeOffset
  push_u16_be(fmt4, 0)
  push_u16_be(fmt4, 4) // points 4 bytes forward (skip own 2 bytes + 0xFFFF entry's 2 bytes) -> glyphIdArray[0]
  push_u16_be(fmt4, 0)
  // glyphIdArray
  push_u16_be(fmt4, 3)

  // Format 12: maps 'A'..'C' -> 1..3, and U+1F600 -> 4
  let fmt12 : Array[Int] = []
  push_u16_be(fmt12, 12)
  push_u16_be(fmt12, 0)
  push_u32_be(fmt12, 16L + 2L * 12L) // length
  push_u32_be(fmt12, 0L) // language
  push_u32_be(fmt12, 2L) // numGroups
  // group 0: 0x41..0x43 -> 1
  push_u32_be(fmt12, 0x41L)
  push_u32_be(fmt12, 0x43L)
  push_u32_be(fmt12, 1L)
  // group 1: 0x1F600..0x1F600 -> 4
  push_u32_be(fmt12, 0x1F600L)
  push_u32_be(fmt12, 0x1F600L)
  push_u32_be(fmt12, 4L)

  // Format 14: VS U+FE0E -> default for U+0041; VS U+FE0F -> non-default U+0041 -> gid 4
  let fmt14 : Array[Int] = []
  push_u16_be(fmt14, 14)
  // Header 10 + 2*11 = 32; defaultUVS at 32 (size 8); nonDefaultUVS at 40 (size 9) => total 49
  push_u32_be(fmt14, 49L)
  push_u32_be(fmt14, 2L) // numVarSelectorRecords
  // rec 0: U+FE0E, defaultUVSOffset=32, nonDefaultUVSOffset=0
  push_u24_be(fmt14, 0xFE0E)
  push_u32_be(fmt14, 32L)
  push_u32_be(fmt14, 0L)
  // rec 1: U+FE0F, defaultUVSOffset=0, nonDefaultUVSOffset=40
  push_u24_be(fmt14, 0xFE0F)
  push_u32_be(fmt14, 0L)
  push_u32_be(fmt14, 40L)
  // defaultUVS at 32: 1 range [0x0041, +0]
  push_u32_be(fmt14, 1L)
  push_u24_be(fmt14, 0x0041)
  push_u8(fmt14, 0)
  // nonDefaultUVS at 40: 1 mapping (0x0041 -> gid 4)
  push_u32_be(fmt14, 1L)
  push_u24_be(fmt14, 0x0041)
  push_u16_be(fmt14, 4)

  let b : Array[Int] = []
  push_u16_be(b, 0) // version
  push_u16_be(b, 3) // numTables
  let off4 = 4 + 3 * 8
  let off12 = off4 + fmt4.length()
  let off14 = off12 + fmt12.length()
  // (3, 1) -> fmt4
  push_u16_be(b, 3)
  push_u16_be(b, 1)
  push_u32_be(b, off4.to_int64())
  // (3, 10) -> fmt12
  push_u16_be(b, 3)
  push_u16_be(b, 10)
  push_u32_be(b, off12.to_int64())
  // (0, 5) -> fmt14
  push_u16_be(b, 0)
  push_u16_be(b, 5)
  push_u32_be(b, off14.to_int64())

  let mut i = 0
  while i < fmt4.length() {
    b.push(fmt4[i])
    i = i + 1
  }
  i = 0
  while i < fmt12.length() {
    b.push(fmt12[i])
    i = i + 1
  }
  i = 0
  while i < fmt14.length() {
    b.push(fmt14[i])
    i = i + 1
  }
  b
}

///| Build `kern` Format 0 table with pairs: (1, 2) -> -40, (2, 3) -> 15.
fn build_kern_fmt0() -> Array[Int] {
  let b : Array[Int] = []
  push_u16_be(b, 0) // version
  push_u16_be(b, 1) // nTables
  // Subtable header (6 bytes) + fmt0 header (8 bytes) + 2 pairs * 6 = 26 bytes
  push_u16_be(b, 0) // subtable version
  push_u16_be(b, 26) // length
  push_u16_be(b, 0x0001) // coverage: horizontal, format 0
  push_u16_be(b, 2) // nPairs
  push_u16_be(b, 12) // searchRange
  push_u16_be(b, 1) // entrySelector
  push_u16_be(b, 0) // rangeShift
  // Pair 0: (1, 2) -> -40
  push_u16_be(b, 1)
  push_u16_be(b, 2)
  push_i16_be(b, -40)
  // Pair 1: (2, 3) -> 15
  push_u16_be(b, 2)
  push_u16_be(b, 3)
  push_i16_be(b, 15)
  b
}

///| Build `fvar` with 1 axis (`wght`: 100..400..900) and 2 named instances (Regular=400, Bold=700).
fn build_fvar() -> Array[Int] {
  let b : Array[Int] = []
  push_u16_be(b, 1) // majorVersion
  push_u16_be(b, 0) // minorVersion
  push_u16_be(b, 16) // axesArrayOffset
  push_u16_be(b, 2) // reserved
  push_u16_be(b, 1) // axisCount
  push_u16_be(b, 20) // axisSize
  push_u16_be(b, 2) // instanceCount
  push_u16_be(b, 10) // instanceSize (4 + 1*4 + 2 postScriptNameID)
  // Axis 0: wght [100, 400, 900], flags=0, nameID=256
  push_tag(b, "wght")
  push_fixed16_16(b, 100.0)
  push_fixed16_16(b, 400.0)
  push_fixed16_16(b, 900.0)
  push_u16_be(b, 0)
  push_u16_be(b, 256)
  // Instance 0: Regular (400.0)
  push_u16_be(b, 257)
  push_u16_be(b, 0)
  push_fixed16_16(b, 400.0)
  push_u16_be(b, 258)
  // Instance 1: Bold (700.0)
  push_u16_be(b, 259)
  push_u16_be(b, 0)
  push_fixed16_16(b, 700.0)
  push_u16_be(b, 260)
  b
}

///| Build `avar` mapping 0.5 -> 0.75 on axis 0 (in F2Dot14: 8192 -> 12288).
fn build_avar() -> Array[Int] {
  let b : Array[Int] = []
  push_u16_be(b, 1) // majorVersion
  push_u16_be(b, 0) // minorVersion
  push_u16_be(b, 0) // reserved
  push_u16_be(b, 1) // axisCount
  // Segment map 0: 4 pairs
  push_u16_be(b, 4)
  push_i16_be(b, -16384)
  push_i16_be(b, -16384)
  push_i16_be(b, 0)
  push_i16_be(b, 0)
  push_i16_be(b, 8192) // 0.5
  push_i16_be(b, 12288) // 0.75
  push_i16_be(b, 16384)
  push_i16_be(b, 16384)
  b
}

///| Build simple glyph: triangle (0,0) -> (100,0) -> (50,200) (all on-curve).
fn build_simple_triangle_glyph() -> Array[Int] {
  let b : Array[Int] = []
  push_i16_be(b, 1) // numberOfContours
  push_i16_be(b, 0) // xMin
  push_i16_be(b, 0) // yMin
  push_i16_be(b, 100) // xMax
  push_i16_be(b, 200) // yMax
  push_u16_be(b, 2) // endPtsOfContours[0] = 2 (3 points)
  push_u16_be(b, 0) // instructionLength = 0
  // Flags: 3 on-curve points using 16-bit signed deltas (0x01)
  push_u8(b, 0x01)
  push_u8(b, 0x01)
  push_u8(b, 0x01)
  // x deltas: 0, +100, -50
  push_i16_be(b, 0)
  push_i16_be(b, 100)
  push_i16_be(b, -50)
  // y deltas: 0, 0, +200
  push_i16_be(b, 0)
  push_i16_be(b, 0)
  push_i16_be(b, 200)
  // Pad to even length
  while b.length() % 4 != 0 {
    b.push(0)
  }
  b
}

///| Build simple glyph with off-curve points: (0,0) on, (50,100) off, (100,100) off, (150,0) on.
fn build_simple_curve_glyph() -> Array[Int] {
  let b : Array[Int] = []
  push_i16_be(b, 1) // numberOfContours
  push_i16_be(b, 0) // xMin
  push_i16_be(b, 0) // yMin
  push_i16_be(b, 150) // xMax
  push_i16_be(b, 100) // yMax
  push_u16_be(b, 3) // endPtsOfContours[0] = 3 (4 points)
  push_u16_be(b, 0) // instructionLength
  // Flags: on, off, off, on
  push_u8(b, 0x01)
  push_u8(b, 0x00)
  push_u8(b, 0x00)
  push_u8(b, 0x01)
  // x deltas: 0, +50, +50, +50
  push_i16_be(b, 0)
  push_i16_be(b, 50)
  push_i16_be(b, 50)
  push_i16_be(b, 50)
  // y deltas: 0, +100, 0, -100
  push_i16_be(b, 0)
  push_i16_be(b, 100)
  push_i16_be(b, 0)
  push_i16_be(b, -100)
  while b.length() % 4 != 0 {
    b.push(0)
  }
  b
}

///| Build compound glyph referencing `comp_gid` with translation (dx, dy) and 2x2 matrix (a,b,c,d in F2Dot14).
fn build_compound_glyph(
  comp_gid : Int,
  dx : Int,
  dy : Int,
  a : Int,
  b_mat : Int,
  c : Int,
  d : Int,
) -> Array[Int] {
  let buf : Array[Int] = []
  push_i16_be(buf, -1) // compound
  push_i16_be(buf, 0)
  push_i16_be(buf, 0)
  push_i16_be(buf, 500)
  push_i16_be(buf, 500)
  // flags: ARG_1_AND_2_ARE_WORDS (0x01) | ARGS_ARE_XY_VALUES (0x02) | WE_HAVE_A_TWO_BY_TWO (0x80)
  push_u16_be(buf, 0x0083)
  push_u16_be(buf, comp_gid)
  push_i16_be(buf, dx)
  push_i16_be(buf, dy)
  push_i16_be(buf, a)
  push_i16_be(buf, b_mat)
  push_i16_be(buf, c)
  push_i16_be(buf, d)
  while buf.length() % 4 != 0 {
    buf.push(0)
  }
  buf
}

fn build_loca_and_glyf(glyphs : Array[Array[Int]], long_loca : Bool) -> (Array[Int], Array[Int]) {
  let loca : Array[Int] = []
  let glyf : Array[Int] = []
  let mut i = 0
  while i < glyphs.length() {
    let off = glyf.length()
    if long_loca {
      push_u32_be(loca, off.to_int64())
    } else {
      push_u16_be(loca, off / 2)
    }
    let g = glyphs[i]
    let mut k = 0
    while k < g.length() {
      glyf.push(g[k])
      k = k + 1
    }
    i = i + 1
  }
  let end_off = glyf.length()
  if long_loca {
    push_u32_be(loca, end_off.to_int64())
  } else {
    push_u16_be(loca, end_off / 2)
  }
  (loca, glyf)
}

fn build_full_test_font() -> Bytes {
  // 5 glyphs:
  // gid 0: empty (.notdef)
  // gid 1: triangle (0,0)-(100,0)-(50,200)
  // gid 2: curve with 2 consecutive off-curve points
  // gid 3: compound referencing gid 1 with scale 2x in X, 0.5x in Y, translate (+10, +20)
  // gid 4: empty
  let g0 : Array[Int] = []
  let g1 = build_simple_triangle_glyph()
  let g2 = build_simple_curve_glyph()
  let g3 = build_compound_glyph(1, 10, 20, 32767, 0, 0, 8192) // ~2.0 in X, 0.5 in Y
  let g4 : Array[Int] = []
  let (loca, glyf) = build_loca_and_glyf([g0, g1, g2, g3, g4], true)

  let tables : Array[(String, Array[Int])] = [
    ("head", build_head(1000, 1)),
    ("maxp", build_maxp_v1(5)),
    ("hhea", build_hhea(800, -200, 90, 3)),
    ("hmtx", build_hmtx([(500, 10), (600, 20), (700, -15)], [5, 8])),
    ("vhea", build_vhea(500, -500, 0, 2)),
    ("vmtx", build_hmtx([(1000, 50), (950, 40)], [30, 25, 20])),
    ("OS/2", build_os2_v4()),
    ("post", build_post()),
    ("name", build_name_table()),
    ("cmap", build_cmap_multi()),
    ("kern", build_kern_fmt0()),
    ("fvar", build_fvar()),
    ("avar", build_avar()),
    ("loca", loca),
    ("glyf", glyf),
  ]
  to_bytes(build_sfnt(0x00010000L, tables))
}

test "parse full synthesized TrueType font: metadata, metrics, names, cmap, kern, fvar/avar, glyf" {
  let bytes = build_full_test_font()
  assert_eq_bool(is_none_int(fonts_in_collection(bytes)), true, "not a TTC")
  let face = expect_face(Face::parse(bytes, 0), "parse full")
  assert_eq_str(face.kind().to_string(), "TrueType", "SFNT kind")
  assert_eq_int(face.units_per_em(), 1000, "units_per_em")
  assert_eq_int(face.number_of_glyphs(), 5, "num_glyphs")

  let bbox = face.global_bounding_box()
  assert_eq_int(bbox.x_min, -50, "head.x_min")
  assert_eq_int(bbox.y_min, -200, "head.y_min")
  assert_eq_int(bbox.x_max, 1050, "head.x_max")
  assert_eq_int(bbox.y_max, 900, "head.y_max")

  // hhea & hmtx (including reusing last advance for gid >= number_of_h_metrics)
  match face.hhea() {
    Some(hhea) => {
      assert_eq_int(hhea.ascender, 800, "hhea.ascender")
      assert_eq_int(hhea.descender, -200, "hhea.descender")
      assert_eq_int(hhea.line_gap, 90, "hhea.line_gap")
    }
    None => debug_assert(false, "expected hhea")
  }
  assert_eq_int(expect_int(face.glyph_hor_advance(0), "hmtx adv 0"), 500, "hmtx adv 0")
  assert_eq_int(expect_int(face.glyph_hor_advance(2), "hmtx adv 2"), 700, "hmtx adv 2")
  assert_eq_int(expect_int(face.glyph_hor_advance(3), "hmtx adv 3"), 700, "hmtx adv 3 reuses last")
  assert_eq_int(expect_int(face.glyph_hor_advance(4), "hmtx adv 4"), 700, "hmtx adv 4 reuses last")
  assert_eq_int(expect_int(face.glyph_hor_side_bearing(2), "hmtx lsb 2"), -15, "hmtx lsb 2")
  assert_eq_int(expect_int(face.glyph_hor_side_bearing(3), "hmtx lsb 3"), 5, "hmtx lsb 3")
  assert_eq_int(expect_int(face.glyph_hor_side_bearing(4), "hmtx lsb 4"), 8, "hmtx lsb 4")
  assert_eq_bool(is_none_int(face.glyph_hor_advance(5)), true, "hmtx oob")

  // vhea & vmtx
  assert_eq_int(expect_int(face.glyph_ver_advance(0), "vmtx adv 0"), 1000, "vmtx adv 0")
  assert_eq_int(expect_int(face.glyph_ver_advance(4), "vmtx adv 4"), 950, "vmtx adv 4 reuses last")
  assert_eq_int(expect_int(face.glyph_ver_side_bearing(3), "vmtx tsb 3"), 25, "vmtx tsb 3")

  // OS/2
  match face.os2() {
    Some(os2) => {
      assert_eq_int(os2.weight_class, 700, "os2.weight_class")
      assert_eq_int(os2.width_class, 5, "os2.width_class")
      assert_eq_int(os2.typo_ascender, 800, "os2.typo_ascender")
      assert_eq_int(os2.typo_descender, -200, "os2.typo_descender")
      assert_eq_int(expect_int(os2.x_height, "x_height"), 520, "os2.x_height")
      assert_eq_int(expect_int(os2.cap_height, "cap_height"), 710, "os2.cap_height")
      assert_eq_int(os2.panose.length(), 10, "os2.panose len")
      assert_eq_int(os2.panose[9].to_int(), 10, "os2.panose[9]")
    }
    None => debug_assert(false, "expected os2")
  }

  // post
  match face.post() {
    Some(post) => {
      assert_near(post.italic_angle(), -12.5, 0.001, "post.italic_angle")
      assert_eq_int(post.underline_position, -100, "post.underline_position")
      assert_eq_int(post.underline_thickness, 50, "post.underline_thickness")
      assert_eq_bool(post.is_fixed_pitch, true, "post.is_fixed_pitch")
    }
    None => debug_assert(false, "expected post")
  }

  // name
  assert_eq_str(expect_str(face.family_name(), "family_name"), "Pion Sans", "family_name")
  assert_eq_str(expect_str(face.subfamily_name(), "subfamily_name"), "Bold", "subfamily_name")
  assert_eq_str(expect_str(face.full_name(), "full_name"), "Pion Sans Bold", "full_name")
  assert_eq_str(expect_str(face.postscript_name(), "postscript_name"), "PionSans-Bold", "postscript_name")
  assert_eq_str(expect_str(face.typographic_family(), "typographic_family"), "Pion Sans Pro", "typographic_family")
  assert_eq_str(expect_str(face.typographic_subfamily(), "typographic_subfamily"), "Display Bold", "typographic_subfamily")
  assert_eq_str(expect_str(face.name_by_id(9), "Mac Roman"), "Café", "Mac Roman decode")
  assert_eq_int(face.name_records().length(), 7, "name_records count")

  // cmap fmt 4 + fmt 12 + fmt 14
  assert_eq_int(expect_int(face.glyph_index(0x41), "A"), 1, "cmap 'A'")
  assert_eq_int(expect_int(face.glyph_index(0x42), "B"), 2, "cmap 'B'")
  assert_eq_int(expect_int(face.glyph_index(0x43), "C"), 3, "cmap 'C'")
  assert_eq_int(expect_int(face.glyph_index(0x1F600), "emoji"), 4, "cmap U+1F600")
  assert_eq_bool(is_none_int(face.glyph_index(0x44)), true, "cmap unmapped")

  match face.glyph_variation_index(0x41, 0xFE0E) {
    Some(v) => match v {
      VariationGlyph::UseDefault => ()
      VariationGlyph::Found(_) => debug_assert(false, "expected UseDefault")
    }
    None => debug_assert(false, "expected UseDefault for U+0041 + U+FE0E")
  }
  match face.glyph_variation_index(0x41, 0xFE0F) {
    Some(v) => match v {
      VariationGlyph::Found(gid) => assert_eq_int(gid, 4, "UVS Found(4)")
      VariationGlyph::UseDefault => debug_assert(false, "expected Found(4)")
    }
    None => debug_assert(false, "expected Found(4) for U+0041 + U+FE0F")
  }
  assert_eq_bool(is_none_var(face.glyph_variation_index(0x42, 0xFE0F)), true, "UVS unmapped")

  // kern
  assert_eq_int(face.kerning(1, 2), -40, "kern(1,2)")
  assert_eq_int(face.kerning(2, 3), 15, "kern(2,3)")
  assert_eq_int(face.kerning(1, 3), 0, "kern(1,3) missing")

  // fvar & avar
  let axes = face.variation_axes()
  assert_eq_int(axes.length(), 1, "fvar axes len")
  assert_eq_str(axes[0].tag.to_string(), "wght", "fvar axis tag")
  assert_near(axes[0].min_value, 100.0, 0.001, "fvar min")
  assert_near(axes[0].default_value, 400.0, 0.001, "fvar default")
  assert_near(axes[0].max_value, 900.0, 0.001, "fvar max")
  let instances = face.named_instances()
  assert_eq_int(instances.length(), 2, "fvar instances len")
  assert_near(instances[1].coordinates[0], 700.0, 0.001, "instance Bold wght")
  assert_eq_int(expect_int(instances[1].postscript_name_id, "ps name id"), 260, "instance ps name id")
  // wght=650 => linear (650-400)/(900-400) = 0.5 => avar maps 0.5 -> 0.75 => F2Dot14 12288
  let norm = face.normalize_variation_coords([650.0])
  assert_eq_int(norm.length(), 1, "norm len")
  assert_eq_int(norm[0], 12288, "avar mapped 0.5 -> 0.75 (12288)")

  // glyf bbox & outline
  match face.glyph_bounding_box(0) {
    Ok(None) => ()
    _ => debug_assert(false, "empty gid 0")
  }
  match face.glyph_bounding_box(1) {
    Ok(Some(b1)) => {
      assert_eq_int(b1.x_max, 100, "gid 1 x_max")
      assert_eq_int(b1.y_max, 200, "gid 1 y_max")
    }
    _ => debug_assert(false, "expected bbox for gid 1")
  }

  let ob1 = OutlineBuilder::new()
  match face.outline_glyph(1, ob1) {
    Ok(Some(_)) => ()
    _ => debug_assert(false, "expected outline gid 1")
  }
  // Triangle: MoveTo, LineTo, LineTo, LineTo (back to start), Close => 5 commands
  assert_eq_int(ob1.len(), 5, "triangle command count")

  let ob2 = OutlineBuilder::new()
  match face.outline_glyph(2, ob2) {
    Ok(Some(_)) => ()
    _ => debug_assert(false, "expected outline gid 2")
  }
  // 2 consecutive off-curve points expand an implicit midpoint at (75, 100)
  // MoveTo(0,0), QuadTo(50,100, 75,100), QuadTo(100,100, 150,0), LineTo(0,0), Close => 5 commands
  assert_eq_int(ob2.len(), 5, "curve command count")

  let ob3 = OutlineBuilder::new()
  match face.outline_glyph(3, ob3) {
    Ok(Some(_)) => ()
    _ => debug_assert(false, "expected outline gid 3")
  }
  assert_eq_int(ob3.len(), 5, "compound command count")
}

test "parse CFF OpenType (OTTO) and TTC collection (v1 and v2)" {
  let cff_sfnt = build_sfnt(
    0x4F54544FL, // OTTO
    [("head", build_head(1000, 0)), ("maxp", build_maxp_v05(12))],
  )
  let cff_face = expect_face(Face::parse(to_bytes(cff_sfnt), 0), "parse OTTO")
  assert_eq_str(cff_face.kind().to_string(), "OpenTypeCff", "OTTO kind")
  assert_eq_int(cff_face.number_of_glyphs(), 12, "OTTO maxp v0.5 num_glyphs")

  // Build a 2-face TTC sharing tables
  let ttc : Array[Int] = []
  push_tag(ttc, "ttcf")
  push_u32_be(ttc, 0x00010000L) // v1.0
  push_u32_be(ttc, 2L) // numFonts
  let face0_off = 20
  let face1_off = face0_off + 12 + 2 * 16
  let head0_off = face1_off + 12 + 2 * 16
  let head0 = build_head(1000, 0)
  let head1_off = head0_off + head0.length()
  let head1 = build_head(2048, 0)
  let maxp_off = head1_off + head1.length()
  let maxp = build_maxp_v1(10)

  push_u32_be(ttc, face0_off.to_int64())
  push_u32_be(ttc, face1_off.to_int64())

  // Face 0 offset table
  push_u32_be(ttc, 0x00010000L)
  push_u16_be(ttc, 2)
  push_u16_be(ttc, 0)
  push_u16_be(ttc, 0)
  push_u16_be(ttc, 0)
  push_tag(ttc, "head")
  push_u32_be(ttc, 0L)
  push_u32_be(ttc, head0_off.to_int64())
  push_u32_be(ttc, head0.length().to_int64())
  push_tag(ttc, "maxp")
  push_u32_be(ttc, 0L)
  push_u32_be(ttc, maxp_off.to_int64())
  push_u32_be(ttc, maxp.length().to_int64())

  // Face 1 offset table (shares maxp!)
  push_u32_be(ttc, 0x74727565L) // 'true'
  push_u16_be(ttc, 2)
  push_u16_be(ttc, 0)
  push_u16_be(ttc, 0)
  push_u16_be(ttc, 0)
  push_tag(ttc, "head")
  push_u32_be(ttc, 0L)
  push_u32_be(ttc, head1_off.to_int64())
  push_u32_be(ttc, head1.length().to_int64())
  push_tag(ttc, "maxp")
  push_u32_be(ttc, 0L)
  push_u32_be(ttc, maxp_off.to_int64())
  push_u32_be(ttc, maxp.length().to_int64())

  let mut i = 0
  while i < head0.length() {
    ttc.push(head0[i])
    i = i + 1
  }
  i = 0
  while i < head1.length() {
    ttc.push(head1[i])
    i = i + 1
  }
  i = 0
  while i < maxp.length() {
    ttc.push(maxp[i])
    i = i + 1
  }

  let ttc_bytes = to_bytes(ttc)
  assert_eq_int(expect_int(fonts_in_collection(ttc_bytes), "TTC count"), 2, "TTC count")
  let f0 = expect_face(Face::parse(ttc_bytes, 0), "TTC face 0")
  let f1 = expect_face(Face::parse(ttc_bytes, 1), "TTC face 1")
  assert_eq_int(f0.units_per_em(), 1000, "TTC face 0 upem")
  assert_eq_int(f1.units_per_em(), 2048, "TTC face 1 upem")
  assert_eq_str(f1.kind().to_string(), "AppleTrueType", "TTC face 1 kind")
  assert_eq_bool(is_err_face(Face::parse(ttc_bytes, 2)), true, "TTC oob index")
}

test "cmap formats 0, 6, 10, 13" {
  // Format 0
  let fmt0 : Array[Int] = []
  push_u16_be(fmt0, 0)
  push_u16_be(fmt0, 262)
  push_u16_be(fmt0, 0)
  let mut i = 0
  while i < 256 {
    push_u8(fmt0, if i == 0x41 { 7 } else { 0 })
    i = i + 1
  }
  let cmap0 : Array[Int] = []
  push_u16_be(cmap0, 0)
  push_u16_be(cmap0, 1)
  push_u16_be(cmap0, 1) // Mac
  push_u16_be(cmap0, 0) // Roman
  push_u32_be(cmap0, 12L)
  i = 0
  while i < fmt0.length() {
    cmap0.push(fmt0[i])
    i = i + 1
  }
  let f0 = expect_face(
    Face::parse(
      to_bytes(build_sfnt(0x00010000L, [("head", build_head(1000, 0)), ("maxp", build_maxp_v1(20)), ("cmap", cmap0)])),
      0,
    ),
    "parse fmt0",
  )
  assert_eq_int(expect_int(f0.glyph_index(0x41), "fmt0"), 7, "cmap fmt 0")

  // Format 6
  let fmt6 : Array[Int] = []
  push_u16_be(fmt6, 6)
  push_u16_be(fmt6, 14)
  push_u16_be(fmt6, 0)
  push_u16_be(fmt6, 0x41) // firstCode
  push_u16_be(fmt6, 2) // entryCount
  push_u16_be(fmt6, 9)
  push_u16_be(fmt6, 10)
  let cmap6 : Array[Int] = []
  push_u16_be(cmap6, 0)
  push_u16_be(cmap6, 1)
  push_u16_be(cmap6, 0)
  push_u16_be(cmap6, 3)
  push_u32_be(cmap6, 12L)
  i = 0
  while i < fmt6.length() {
    cmap6.push(fmt6[i])
    i = i + 1
  }
  let f6 = expect_face(
    Face::parse(
      to_bytes(build_sfnt(0x00010000L, [("head", build_head(1000, 0)), ("maxp", build_maxp_v1(20)), ("cmap", cmap6)])),
      0,
    ),
    "parse fmt6",
  )
  assert_eq_int(expect_int(f6.glyph_index(0x42), "fmt6"), 10, "cmap fmt 6")

  // Format 10
  let fmt10 : Array[Int] = []
  push_u16_be(fmt10, 10)
  push_u16_be(fmt10, 0)
  push_u32_be(fmt10, 24L)
  push_u32_be(fmt10, 0L)
  push_u32_be(fmt10, 0x10000L) // startCharCode
  push_u32_be(fmt10, 2L) // numChars
  push_u16_be(fmt10, 11)
  push_u16_be(fmt10, 12)
  let cmap10 : Array[Int] = []
  push_u16_be(cmap10, 0)
  push_u16_be(cmap10, 1)
  push_u16_be(cmap10, 0)
  push_u16_be(cmap10, 4)
  push_u32_be(cmap10, 12L)
  i = 0
  while i < fmt10.length() {
    cmap10.push(fmt10[i])
    i = i + 1
  }
  let f10 = expect_face(
    Face::parse(
      to_bytes(build_sfnt(0x00010000L, [("head", build_head(1000, 0)), ("maxp", build_maxp_v1(20)), ("cmap", cmap10)])),
      0,
    ),
    "parse fmt10",
  )
  assert_eq_int(expect_int(f10.glyph_index(0x10001), "fmt10"), 12, "cmap fmt 10")

  // Format 13 (many-to-one)
  let fmt13 : Array[Int] = []
  push_u16_be(fmt13, 13)
  push_u16_be(fmt13, 0)
  push_u32_be(fmt13, 28L)
  push_u32_be(fmt13, 0L)
  push_u32_be(fmt13, 1L) // numGroups
  push_u32_be(fmt13, 0x20000L)
  push_u32_be(fmt13, 0x20010L)
  push_u32_be(fmt13, 15L) // all map to gid 15
  let cmap13 : Array[Int] = []
  push_u16_be(cmap13, 0)
  push_u16_be(cmap13, 1)
  push_u16_be(cmap13, 0)
  push_u16_be(cmap13, 4)
  push_u32_be(cmap13, 12L)
  i = 0
  while i < fmt13.length() {
    cmap13.push(fmt13[i])
    i = i + 1
  }
  let f13 = expect_face(
    Face::parse(
      to_bytes(build_sfnt(0x00010000L, [("head", build_head(1000, 0)), ("maxp", build_maxp_v1(20)), ("cmap", cmap13)])),
      0,
    ),
    "parse fmt13",
  )
  assert_eq_int(expect_int(f13.glyph_index(0x20000), "fmt13 start"), 15, "cmap fmt 13 start")
  assert_eq_int(expect_int(f13.glyph_index(0x20010), "fmt13 end"), 15, "cmap fmt 13 end")
}

test "adversarial security: compound glyph cycle A->B->A and self-loop DoS" {
  // gid 0: empty
  // gid 1: compound referencing gid 2
  // gid 2: compound referencing gid 1 (mutual cycle!)
  // gid 3: compound referencing gid 3 (self-loop!)
  let g0 : Array[Int] = []
  let g1 = build_compound_glyph(2, 0, 0, 16384, 0, 0, 16384)
  let g2 = build_compound_glyph(1, 0, 0, 16384, 0, 0, 16384)
  let g3 = build_compound_glyph(3, 0, 0, 16384, 0, 0, 16384)
  let (loca, glyf) = build_loca_and_glyf([g0, g1, g2, g3], true)
  let bytes = to_bytes(
    build_sfnt(
      0x00010000L,
      [
        ("head", build_head(1000, 1)),
        ("maxp", build_maxp_v1(4)),
        ("loca", loca),
        ("glyf", glyf),
      ],
    ),
  )
  let face = expect_face(Face::parse(bytes, 0), "parse cyclic font")
  let ob = OutlineBuilder::new()
  assert_eq_bool(is_err_rect(face.outline_glyph(1, ob)), true, "A->B->A cycle must Err")
  assert_eq_bool(is_err_rect(face.outline_glyph(3, ob)), true, "self-loop must Err")
}

test "adversarial security: truncated, bad magic, u32 overflow, huge num_tables, REPEAT overflow" {
  // Empty and short inputs
  assert_eq_bool(is_err_face(Face::parse(Bytes::new(0), 0)), true, "empty")
  assert_eq_bool(is_err_face(Face::parse(Bytes::new(8), 0)), true, "8 bytes")
  assert_eq_bool(is_err_face(Face::parse(to_bytes([0xDE, 0xAD, 0xBE, 0xEF, 0, 1, 0, 0, 0, 0, 0, 0]), 0)), true, "bad magic")

  // Huge num_tables > max_num_tables
  let huge_tables : Array[Int] = []
  push_u32_be(huge_tables, 0x00010000L)
  push_u16_be(huge_tables, 5000)
  push_zeros(huge_tables, 6)
  assert_eq_bool(is_err_face(Face::parse(to_bytes(huge_tables), 0)), true, "huge num_tables")

  // Table record with 32-bit offset + length overflow (0xFFFFFFF0 + 0x100)
  let ovf : Array[Int] = []
  push_u32_be(ovf, 0x00010000L)
  push_u16_be(ovf, 1)
  push_zeros(ovf, 6)
  push_tag(ovf, "head")
  push_u32_be(ovf, 0L)
  push_u32_be(ovf, 0xFFFFFFF0L)
  push_u32_be(ovf, 0x00000100L)
  assert_eq_bool(is_err_face(Face::parse(to_bytes(ovf), 0)), true, "u32 offset+len overflow")

  // glyf REPEAT flag overflow DoS (claims 255 repeats for a 2-point glyph)
  let bad_glyf : Array[Int] = []
  push_i16_be(bad_glyf, 1) // 1 contour
  push_i16_be(bad_glyf, 0)
  push_i16_be(bad_glyf, 0)
  push_i16_be(bad_glyf, 10)
  push_i16_be(bad_glyf, 10)
  push_u16_be(bad_glyf, 1) // 2 points
  push_u16_be(bad_glyf, 0) // 0 instructions
  push_u8(bad_glyf, 0x09) // ON_CURVE | REPEAT_FLAG
  push_u8(bad_glyf, 255) // repeat 255 times -> 256 points > 2!
  let (loca, glyf) = build_loca_and_glyf([bad_glyf], true)
  let f = expect_face(
    Face::parse(
      to_bytes(build_sfnt(0x00010000L, [("head", build_head(1000, 1)), ("maxp", build_maxp_v1(1)), ("loca", loca), ("glyf", glyf)])),
      0,
    ),
    "parse REPEAT font",
  )
  let ob = OutlineBuilder::new()
  assert_eq_bool(is_err_rect(f.outline_glyph(0, ob)), true, "REPEAT overflow must Err")
}

test "glyf all-off-curve contour, short loca format 0, and exact compound 2x2 coordinates" {
  // All-off-curve square: (0,0), (100,0), (100,100), (0,100) all off-curve -> 4 QuadTo + Close
  let all_off : Array[Int] = []
  push_i16_be(all_off, 1) // 1 contour
  push_i16_be(all_off, 0)
  push_i16_be(all_off, 0)
  push_i16_be(all_off, 100)
  push_i16_be(all_off, 100)
  push_u16_be(all_off, 3) // 4 points
  push_u16_be(all_off, 0)
  push_u8(all_off, 0x08) // REPEAT_FLAG, off-curve
  push_u8(all_off, 3) // repeat 3 -> total 4 off-curve points
  // x deltas: 0, +100, 0, -100
  push_i16_be(all_off, 0)
  push_i16_be(all_off, 100)
  push_i16_be(all_off, 0)
  push_i16_be(all_off, -100)
  // y deltas: 0, 0, +100, 0
  push_i16_be(all_off, 0)
  push_i16_be(all_off, 0)
  push_i16_be(all_off, 100)
  push_i16_be(all_off, 0)
  while all_off.length() % 4 != 0 {
    all_off.push(0)
  }

  let (loca, glyf) = build_loca_and_glyf([all_off], false) // short loca!
  let face = expect_face(
    Face::parse(
      to_bytes(
        build_sfnt(
          0x00010000L,
          [("head", build_head(1000, 0)), ("maxp", build_maxp_v1(1)), ("loca", loca), ("glyf", glyf)],
        ),
      ),
      0,
    ),
    "parse short loca",
  )
  let ob = OutlineBuilder::new()
  match face.outline_glyph(0, ob) {
    Ok(Some(r)) => assert_eq_int(r.width(), 100, "short loca bbox width")
    _ => debug_assert(false, "expected Some(Rect)")
  }
  // Start at midpoint of (0,0) and (100,0) = (50,0), then 4 QuadTo, then Close => 6 commands
  assert_eq_int(ob.len(), 6, "all-off-curve command count")
  match ob.commands[0] {
    PathCommand::MoveTo(x, y) => {
      assert_near(x, 50.0, 0.001, "start x")
      assert_near(y, 0.0, 0.001, "start y")
    }
    _ => debug_assert(false, "expected MoveTo(50, 0)")
  }
}

test "adversarial security: cmap DoS (huge segCount, oob idRangeOffset, huge nGroups) and deep compound chain > 16" {
  // 1. cmap fmt 4 with huge segCountX2 = 60000 in 20-byte subtable
  let bad_cmap : Array[Int] = []
  push_u16_be(bad_cmap, 0)
  push_u16_be(bad_cmap, 2)
  push_u16_be(bad_cmap, 3)
  push_u16_be(bad_cmap, 1)
  push_u32_be(bad_cmap, 20L)
  push_u16_be(bad_cmap, 3)
  push_u16_be(bad_cmap, 10)
  push_u32_be(bad_cmap, 36L)
  // fmt 4 claiming segCountX2 = 60000
  push_u16_be(bad_cmap, 4)
  push_u16_be(bad_cmap, 16)
  push_u16_be(bad_cmap, 0)
  push_u16_be(bad_cmap, 60000)
  push_zeros(bad_cmap, 8)
  // fmt 12 claiming numGroups = 0x7FFFFFFF
  push_u16_be(bad_cmap, 12)
  push_u16_be(bad_cmap, 0)
  push_u32_be(bad_cmap, 16L)
  push_u32_be(bad_cmap, 0L)
  push_u32_be(bad_cmap, 0x7FFFFFFFL)

  let f = expect_face(
    Face::parse(
      to_bytes(build_sfnt(0x00010000L, [("head", build_head(1000, 0)), ("maxp", build_maxp_v1(10)), ("cmap", bad_cmap)])),
      0,
    ),
    "parse bad cmap",
  )
  assert_eq_bool(is_none_int(f.glyph_index(0x41)), true, "DoS cmap safely returns None")

  // 2. Deep acyclic compound chain of depth 20 (> max_compound_depth = 16)
  let glyphs : Array[Array[Int]] = []
  let mut g = 0
  while g < 20 {
    glyphs.push(build_compound_glyph(g + 1, 1, 0, 16384, 0, 0, 16384))
    g = g + 1
  }
  glyphs.push(build_simple_triangle_glyph())
  let (loca, glyf) = build_loca_and_glyf(glyphs, true)
  let deep_face = expect_face(
    Face::parse(
      to_bytes(
        build_sfnt(
          0x00010000L,
          [("head", build_head(1000, 1)), ("maxp", build_maxp_v1(21)), ("loca", loca), ("glyf", glyf)],
        ),
      ),
      0,
    ),
    "parse deep compound",
  )
  let ob = OutlineBuilder::new()
  assert_eq_bool(is_err_rect(deep_face.outline_glyph(0, ob)), true, "depth 20 must hit LimitExceeded")
  // Depth 5 (starting at gid 15) must succeed!
  let ob_ok = OutlineBuilder::new()
  match deep_face.outline_glyph(15, ob_ok) {
    Ok(Some(_)) => assert_eq_int(ob_ok.len(), 5, "depth 5 succeeds")
    _ => debug_assert(false, "depth 5 should succeed")
  }
}

test "name UTF-16BE surrogate pair and Apple AAT kern v1.0" {
  // Name table with UTF-16BE surrogate pair for U+1F600 (0xD83D 0xDE00)
  let name_tbl : Array[Int] = []
  push_u16_be(name_tbl, 0) // format
  push_u16_be(name_tbl, 1) // count
  push_u16_be(name_tbl, 18) // stringOffset
  push_u16_be(name_tbl, 0) // Unicode
  push_u16_be(name_tbl, 4) // Unicode full
  push_u16_be(name_tbl, 0)
  push_u16_be(name_tbl, 1) // family_name
  push_u16_be(name_tbl, 4) // 4 bytes
  push_u16_be(name_tbl, 0)
  push_u16_be(name_tbl, 0xD83D)
  push_u16_be(name_tbl, 0xDE00)

  // Apple AAT kern v1.0 (0x00010000)
  let aat_kern : Array[Int] = []
  push_u32_be(aat_kern, 0x00010000L) // version 1.0
  push_u32_be(aat_kern, 1L) // nTables
  push_u32_be(aat_kern, 22L) // subtable length: 8 + 8 + 6
  push_u16_be(aat_kern, 0x0000) // coverage: horizontal, format 0
  push_u16_be(aat_kern, 0) // tupleIndex
  push_u16_be(aat_kern, 1) // nPairs
  push_u16_be(aat_kern, 6)
  push_u16_be(aat_kern, 0)
  push_u16_be(aat_kern, 0)
  push_u16_be(aat_kern, 3)
  push_u16_be(aat_kern, 4)
  push_i16_be(aat_kern, -55)

  let face = expect_face(
    Face::parse(
      to_bytes(
        build_sfnt(
          0x00010000L,
          [
            ("head", build_head(1000, 0)),
            ("maxp", build_maxp_v1(10)),
            ("name", name_tbl),
            ("kern", aat_kern),
          ],
        ),
      ),
      0,
    ),
    "parse AAT kern + surrogate name",
  )
  assert_eq_str(expect_str(face.family_name(), "emoji family"), "😀", "UTF-16BE surrogate pair")
  assert_eq_int(face.kerning(3, 4), -55, "AAT kern(3,4)")
}
