///| Wasm32 + Native 4-mode deterministic smoke entry for `packages/opentype`.
///| Uses integer-only / fixed-point formatting (never `Double::to_string`) to guarantee
///| byte-identical stdout across Native Debug, Native Release, Wasm32 Debug, and Wasm32 Release.

import "opentype"

fn push_u8(buf : Array[Int], v : Int) -> Unit {
  buf.push(v & 0xFF)
}

fn push_u16_be(buf : Array[Int], v : Int) -> Unit {
  buf.push((v >> 8) & 0xFF)
  buf.push(v & 0xFF)
}

fn push_i16_be(buf : Array[Int], v : Int) -> Unit {
  let u = if v < 0 { v + 65536 } else { v }
  push_u16_be(buf, u)
}

fn push_u32_be(buf : Array[Int], v : Int64) -> Unit {
  buf.push(((v >> 24) & 0xFFL).to_int())
  buf.push(((v >> 16) & 0xFFL).to_int())
  buf.push(((v >> 8) & 0xFFL).to_int())
  buf.push((v & 0xFFL).to_int())
}

fn push_tag(buf : Array[Int], s : String) -> Unit {
  let mut i = 0
  while i < 4 {
    buf.push(s.code_unit_at(i) & 0xFF)
    i = i + 1
  }
}

fn push_zeros(buf : Array[Int], n : Int) -> Unit {
  let mut i = 0
  while i < n {
    buf.push(0)
    i = i + 1
  }
}

fn to_bytes(arr : Array[Int]) -> Bytes {
  let n = arr.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = arr[i].to_byte()
    i = i + 1
  }
  out
}

fn build_smoke_font() -> Bytes {
  // Minimal valid SFNT with head, maxp, hhea, hmtx, cmap (fmt 12), kern (fmt 0), fvar, avar, loca, glyf
  let head : Array[Int] = []
  push_u32_be(head, 0x00010000L)
  push_u32_be(head, 0x00010000L)
  push_u32_be(head, 0L)
  push_u32_be(head, 0x5F0F3CF5L)
  push_u16_be(head, 0)
  push_u16_be(head, 1000)
  push_zeros(head, 16)
  push_i16_be(head, 0)
  push_i16_be(head, -200)
  push_i16_be(head, 800)
  push_i16_be(head, 800)
  push_u16_be(head, 0)
  push_u16_be(head, 8)
  push_i16_be(head, 2)
  push_i16_be(head, 1) // long loca
  push_i16_be(head, 0)

  let maxp : Array[Int] = []
  push_u32_be(maxp, 0x00010000L)
  push_u16_be(maxp, 3)
  push_zeros(maxp, 26)

  let hhea : Array[Int] = []
  push_u32_be(hhea, 0x00010000L)
  push_i16_be(hhea, 800)
  push_i16_be(hhea, -200)
  push_i16_be(hhea, 100)
  push_u16_be(hhea, 600)
  push_zeros(hhea, 24)
  push_u16_be(hhea, 2)

  let hmtx : Array[Int] = []
  push_u16_be(hmtx, 500)
  push_i16_be(hmtx, 0)
  push_u16_be(hmtx, 600)
  push_i16_be(hmtx, 25)
  push_i16_be(hmtx, 10)

  let cmap : Array[Int] = []
  push_u16_be(cmap, 0)
  push_u16_be(cmap, 1)
  push_u16_be(cmap, 3)
  push_u16_be(cmap, 10)
  push_u32_be(cmap, 12L)
  // fmt 12
  push_u16_be(cmap, 12)
  push_u16_be(cmap, 0)
  push_u32_be(cmap, 28L)
  push_u32_be(cmap, 0L)
  push_u32_be(cmap, 1L)
  push_u32_be(cmap, 0x41L)
  push_u32_be(cmap, 0x42L)
  push_u32_be(cmap, 1L)

  let kern : Array[Int] = []
  push_u16_be(kern, 0)
  push_u16_be(kern, 1)
  push_u16_be(kern, 0)
  push_u16_be(kern, 20)
  push_u16_be(kern, 1)
  push_u16_be(kern, 1)
  push_u16_be(kern, 6)
  push_u16_be(kern, 0)
  push_u16_be(kern, 0)
  push_u16_be(kern, 1)
  push_u16_be(kern, 2)
  push_i16_be(kern, -35)

  // Simple glyph 1 (curve) + compound glyph 2 (ref glyph 1)
  let g1 : Array[Int] = []
  push_i16_be(g1, 1)
  push_i16_be(g1, 0)
  push_i16_be(g1, 0)
  push_i16_be(g1, 100)
  push_i16_be(g1, 100)
  push_u16_be(g1, 2)
  push_u16_be(g1, 0)
  push_u8(g1, 0x01)
  push_u8(g1, 0x00)
  push_u8(g1, 0x01)
  push_i16_be(g1, 0)
  push_i16_be(g1, 50)
  push_i16_be(g1, 50)
  push_i16_be(g1, 0)
  push_i16_be(g1, 100)
  push_i16_be(g1, -100)
  while g1.length() % 4 != 0 {
    g1.push(0)
  }

  let g2 : Array[Int] = []
  push_i16_be(g2, -1)
  push_i16_be(g2, 20)
  push_i16_be(g2, 10)
  push_i16_be(g2, 120)
  push_i16_be(g2, 110)
  push_u16_be(g2, 0x0003) // words + xy
  push_u16_be(g2, 1)
  push_i16_be(g2, 20)
  push_i16_be(g2, 10)
  while g2.length() % 4 != 0 {
    g2.push(0)
  }

  let loca : Array[Int] = []
  push_u32_be(loca, 0L)
  push_u32_be(loca, 0L)
  push_u32_be(loca, g1.length().to_int64())
  push_u32_be(loca, (g1.length() + g2.length()).to_int64())

  let glyf : Array[Int] = []
  let mut i = 0
  while i < g1.length() {
    glyf.push(g1[i])
    i = i + 1
  }
  i = 0
  while i < g2.length() {
    glyf.push(g2[i])
    i = i + 1
  }

  let tables : Array[(String, Array[Int])] = [
    ("cmap", cmap),
    ("glyf", glyf),
    ("head", head),
    ("hhea", hhea),
    ("hmtx", hmtx),
    ("kern", kern),
    ("loca", loca),
    ("maxp", maxp),
  ]
  let n = tables.length()
  let buf : Array[Int] = []
  push_u32_be(buf, 0x00010000L)
  push_u16_be(buf, n)
  push_zeros(buf, 6)
  let mut off = 12 + n * 16
  let offs : Array[Int] = []
  i = 0
  while i < n {
    let (tag, payload) = tables[i]
    offs.push(off)
    push_tag(buf, tag)
    push_u32_be(buf, 0L)
    push_u32_be(buf, off.to_int64())
    push_u32_be(buf, payload.length().to_int64())
    off = off + payload.length()
    while off % 4 != 0 {
      off = off + 1
    }
    i = i + 1
  }
  i = 0
  while i < n {
    let (_, payload) = tables[i]
    while buf.length() < offs[i] {
      buf.push(0)
    }
    let mut k = 0
    while k < payload.length() {
      buf.push(payload[k])
      k = k + 1
    }
    i = i + 1
  }
  while buf.length() < off {
    buf.push(0)
  }
  to_bytes(buf)
}

fn fnv1a_step(h : UInt64, v : Int64) -> UInt64 {
  let x = h ^ v.to_uint64()
  x * 1099511628211UL
}

fn q8(v : Double) -> Int64 {
  if v >= 0.0 {
    (v * 256.0 + 0.5).to_int64()
  } else {
    (v * 256.0 - 0.5).to_int64()
  }
}

pub fn main(world : World) -> Int {
  let bytes = build_smoke_font()
  let face = match opentype::Face::parse(bytes, 0) {
    Ok(f) => f
    Err(e) => {
      io_println(world, "opentype_wasm_smoke: FAIL " + e.to_string())
      return 1
    }
  }
  let mut h : UInt64 = 14695981039346656037UL
  h = fnv1a_step(h, face.units_per_em().to_int64())
  h = fnv1a_step(h, face.number_of_glyphs().to_int64())
  let gid_a = match face.glyph_index(0x41) {
    Some(g) => g
    None => -1
  }
  let gid_b = match face.glyph_index(0x42) {
    Some(g) => g
    None => -1
  }
  h = fnv1a_step(h, gid_a.to_int64())
  h = fnv1a_step(h, gid_b.to_int64())
  let adv = match face.glyph_hor_advance(2) {
    Some(v) => v
    None => -1
  }
  h = fnv1a_step(h, adv.to_int64())
  h = fnv1a_step(h, face.kerning(1, 2).to_int64())

  let ob = opentype::OutlineBuilder::new()
  let _ = face.outline_glyph(2, ob)
  let mut i = 0
  while i < ob.commands.length() {
    match ob.commands[i] {
      opentype::PathCommand::MoveTo(x, y) => {
        h = fnv1a_step(h, 1L)
        h = fnv1a_step(h, q8(x))
        h = fnv1a_step(h, q8(y))
      }
      opentype::PathCommand::LineTo(x, y) => {
        h = fnv1a_step(h, 2L)
        h = fnv1a_step(h, q8(x))
        h = fnv1a_step(h, q8(y))
      }
      opentype::PathCommand::QuadTo(cx, cy, x, y) => {
        h = fnv1a_step(h, 3L)
        h = fnv1a_step(h, q8(cx))
        h = fnv1a_step(h, q8(cy))
        h = fnv1a_step(h, q8(x))
        h = fnv1a_step(h, q8(y))
      }
      opentype::PathCommand::Close => {
        h = fnv1a_step(h, 4L)
      }
    }
    i = i + 1
  }
  io_println(
    world,
    "opentype_wasm_smoke: OK glyphs=" +
    face.number_of_glyphs().to_string() +
    " cmds=" +
    ob.len().to_string() +
    " fnv64=" +
    h.to_string(),
  )
  0
}
