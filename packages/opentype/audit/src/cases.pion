///| Red-team / control cases. Fixtures are the fonts written by diff/gen.py into `<corpus>/synth/`.
///| A case returns "" on PASS, otherwise the reason. `redteam_*` cases reproduce open findings of
///| REPORT.md and PASS once the finding is fixed; `control_*` cases pin behaviour that must not regress.
///| Assertions are on observable results only (no source text), so any correct fix turns them green.

import "opentype"

///|
fn load_face(world : World, corpus : String, name : String, idx : Int) -> Result[opentype::Face, String] {
  match fs_read_bytes(world, corpus + "/synth/" + name + ".ttf") {
    Err(_) => Err("missing fixture " + name)
    Ok(b) => match opentype::Face::parse(b, idx) {
      Ok(f) => Ok(f)
      Err(e) => Err(name + ": parse failed: " + e.to_string())
    }
  }
}

///|
fn load_bytes(world : World, corpus : String, name : String) -> Bytes {
  match fs_read_bytes(world, corpus + "/synth/" + name + ".ttf") {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///|
fn same(a : Option[Int], b : Option[Int]) -> Bool {
  match (a, b) {
    (Some(x), Some(y)) => x == y
    (None, None) => true
    _ => false
  }
}

///|
fn show(v : Option[Int]) -> String {
  match v {
    Some(x) => "Some(" + x.to_string() + ")"
    None => "None"
  }
}

///|
fn first_move(ob : opentype::OutlineBuilder, k : Int) -> (Double, Double) {
  let mut seen = 0
  let mut i = 0
  while i < ob.commands.length() {
    match ob.commands[i] {
      opentype::PathCommand::MoveTo(x, y) => {
        if seen == k {
          return (x, y)
        }
        seen = seen + 1
      }
      _ => ()
    }
    i = i + 1
  }
  (-99999.0, -99999.0)
}

///| P1-1: a single (or last) OpenType kern subtable longer than 65535 bytes stores its u16 length
///| modulo 65536; FreeType, HarfBuzz, ttf-parser and read-fonts ignore the length of the last subtable.
fn redteam_p1_1_kern_u16_length_overflow(world : World, corpus : String) -> String {
  let face = match load_face(world, corpus, "kern_v0_u16_length_overflow", 0) {
    Ok(f) => f
    Err(e) => return e
  }
  let mut bad = 0
  let mut first = ""
  let mut l = 1
  while l < 140 {
    let mut r = 1
    while r < 90 {
      let v0 = (l * 7 + r) % 200 - 100
      let want = if v0 == 0 { 1 } else { v0 }
      let got = face.kerning(l, r)
      if got != want {
        if bad == 0 {
          first = "kerning(" + l.to_string() + ", " + r.to_string() + ") = " + got.to_string() + ", want " +
          want.to_string()
        }
        bad = bad + 1
      }
      r = r + 1
    }
    l = l + 1
  }
  if bad == 0 {
    ""
  } else {
    bad.to_string() + "/12371 pairs lost, e.g. " + first
  }
}

///| P1-2: a Mac Roman (1,0) subtable is a byte -> glyph table; `glyph_index` takes Unicode scalars.
///| Indexing it with the raw code point returns the glyph of a different character for U+0080..U+00FF.
fn redteam_p1_2_mac_roman_cmap_unicode(world : World, corpus : String) -> String {
  let face = match load_face(world, corpus, "cmap_mac_roman_only", 0) {
    Ok(f) => f
    Err(e) => return e
  }
  // (Unicode code point, glyph of the Mac Roman byte that encodes it): Some(gid) or None are both fine
  let right = [(0x41, 4), (0xC4, 10), (0xE9, 11), (0x2020, 12), (0xC8, 13), (0x20AC, 14)]
  // (Unicode code point, glyph it must NOT get: the glyph of byte == code point)
  let wrong = [(0x80, 10), (0x8E, 11), (0xA0, 12), (0xE9, 13), (0xDB, 14)]
  let sb = StringBuilder::new()
  let mut i = 0
  while i < wrong.length() {
    let (cp, g) = wrong[i]
    match face.glyph_index(cp) {
      Some(x) =>
      if x == g {
        sb.write_string("U+" + hex(cp) + " -> " + g.to_string() + " (glyph of Mac byte " + hex(cp) + "); ")
      }
      None => ()
    }
    i = i + 1
  }
  i = 0
  while i < right.length() {
    let (cp, g) = right[i]
    match face.glyph_index(cp) {
      Some(x) =>
      if x != g {
        sb.write_string("U+" + hex(cp) + " -> " + x.to_string() + " want " + g.to_string() + " or None; ")
      }
      None => ()
    }
    i = i + 1
  }
  sb.to_string()
}

///| P2-1: one table record outside the file (here an unused `DSIG`) rejects the whole face, although
///| FreeType, ttf-parser and read-fonts skip just that record.
fn redteam_p2_1_oob_table_rejects_face(world : World, corpus : String) -> String {
  let names = ["sfnt_oob_unused_table", "sfnt_u32_wrap_record"]
  let sb = StringBuilder::new()
  let mut i = 0
  while i < names.length() {
    match load_face(world, corpus, names[i], 0) {
      Ok(f) => {
        if !same(f.glyph_index(0x41), Some(1)) {
          sb.write_string(names[i] + ": glyph_index('A') = " + show(f.glyph_index(0x41)) + "; ")
        }
        match f.table_data_by_name("DSIG") {
          Some(b) =>
          if b.length() > 0 {
            sb.write_string(names[i] + ": DSIG slice outside the file; ")
          }
          None => ()
        }
      }
      Err(e) => sb.write_string(e + "; ")
    }
    i = i + 1
  }
  sb.to_string()
}

///| P2-2: `normalize_variation_coords` rounds a double instead of following the spec's 16.16
///| fixed-point normalization and "+2 >> 2" F2Dot14 conversion (skrifa, FreeType and HarfBuzz agree).
fn redteam_p2_2_norm_not_spec_fixed_point(world : World, corpus : String) -> String {
  let sb = StringBuilder::new()
  match load_face(world, corpus, "var_round_neg_half", 0) {
    Ok(f) => {
      let a = f.normalize_variation_coords([-0.000030517578125])
      if a.length() != 1 || a[0] != 0 {
        sb.write_string("user -2^-15 on [-1, 0, 1] -> " + a[0].to_string() + " (spec 0); ")
      }
      let b = f.normalize_variation_coords([0.000030517578125])
      if b.length() != 1 || b[0] != 1 {
        sb.write_string("user +2^-15 -> " + b[0].to_string() + " (spec 1); ")
      }
    }
    Err(e) => sb.write_string(e + "; ")
  }
  match load_face(world, corpus, "var_axis_size_24", 0) {
    Ok(f) => {
      let a = f.normalize_variation_coords([1.0])
      if a.length() != 1 || a[0] != -14745 {
        sb.write_string("user 1 on [0, 10, 5] -> " + (if a.length() > 0 { a[0].to_string() } else { "-" }) +
          " (spec -14745); ")
      }
    }
    Err(e) => sb.write_string(e + "; ")
  }
  sb.to_string()
}

///| P2-3: `glyph_index` maps surrogate code points (U+D800..U+DFFF are not Unicode scalar values).
fn redteam_p2_3_surrogates_mapped(world : World, corpus : String) -> String {
  let face = match load_face(world, corpus, "cmap_fmt12_surrogates", 0) {
    Ok(f) => f
    Err(e) => return e
  }
  let sb = StringBuilder::new()
  let probes = [0xD800, 0xDBFF, 0xDC00, 0xDFFF]
  let mut i = 0
  while i < probes.length() {
    match face.glyph_index(probes[i]) {
      Some(g) => sb.write_string("U+" + hex(probes[i]) + " -> " + g.to_string() + "; ")
      None => ()
    }
    i = i + 1
  }
  if same(face.glyph_index(0xD7FF), None) || same(face.glyph_index(0xE000), None) {
    sb.write_string("neighbours U+D7FF/U+E000 must stay mapped; ")
  }
  sb.to_string()
}

///| P2-4: `glyph_index` returns Some(0) for format 4 idDelta segments (every font's U+FFFF sentinel)
///| although formats 0/4-glyphIdArray/6/10/12/13 return None for glyph 0.
fn redteam_p2_4_notdef_some0(world : World, corpus : String) -> String {
  let face = match load_face(world, corpus, "ctl_base", 0) {
    Ok(f) => f
    Err(e) => return e
  }
  let sb = StringBuilder::new()
  match face.glyph_index(0xFFFF) {
    Some(0) => sb.write_string("U+FFFF (fmt 4 sentinel, idDelta 1) -> Some(0); ")
    _ => ()
  }
  sb.to_string()
}

///| P2-5: composite flags that move components are ignored: anchor-point matching
///| (ARGS_ARE_XY_VALUES clear) places the component at (0, 0), SCALED_COMPONENT_OFFSET is not applied.
fn redteam_p2_5_compound_point_matching(world : World, corpus : String) -> String {
  let sb = StringBuilder::new()
  match load_face(world, corpus, "glyf_cmp_point_match", 0) {
    Ok(f) => {
      let ob = opentype::OutlineBuilder::new()
      let _ = f.outline_glyph(1, ob)
      let (x, y) = first_move(ob, 1)
      if x != 600.0 || y != 0.0 {
        sb.write_string(
          "point-matched component (parent pt 3 = (600,0), child pt 0) starts at (" + q4(x).to_string() + "/16, " +
          q4(y).to_string() + "/16), want (600, 0); ",
        )
      }
    }
    Err(e) => sb.write_string(e + "; ")
  }
  match load_face(world, corpus, "glyf_cmp_scaled_offset", 0) {
    Ok(f) => {
      let ob = opentype::OutlineBuilder::new()
      let _ = f.outline_glyph(1, ob)
      let (x, y) = first_move(ob, 0)
      if x != 50.0 || y != 50.0 {
        sb.write_string(
          "SCALED_COMPONENT_OFFSET (100,100) x 0.5 starts at (" + q4(x).to_string() + "/16, " + q4(y).to_string() +
          "/16), want (50, 50); ",
        )
      }
    }
    Err(e) => sb.write_string(e + "; ")
  }
  sb.to_string()
}

///| P2-6: on Err, `outline_glyph` leaves the commands of the components decoded so far in the builder.
fn redteam_p2_6_outline_partial_on_error(world : World, corpus : String) -> String {
  let sb = StringBuilder::new()
  let cases = [("glyf_cycle_after_leaf", 1), ("glyf_diamond_2e14", 1)]
  let mut i = 0
  while i < cases.length() {
    let (n, g) = cases[i]
    match load_face(world, corpus, n, 0) {
      Ok(f) => {
        let ob = opentype::OutlineBuilder::new()
        ob.move_to(1.0, 2.0)
        match f.outline_glyph(g, ob) {
          Err(_) =>
          if ob.len() != 1 {
            sb.write_string(n + ": Err left " + (ob.len() - 1).to_string() + " partial commands; ")
          }
          Ok(_) => ()
        }
      }
      Err(e) => sb.write_string(e + "; ")
    }
    i = i + 1
  }
  sb.to_string()
}

///| P2-7: `Face::tables()` returns the face's own table directory array: mutating the result changes
///| every later lookup of that (supposedly immutable) face.
fn redteam_p2_7_tables_alias(world : World, corpus : String) -> String {
  let face = match load_face(world, corpus, "ctl_base", 0) {
    Ok(f) => f
    Err(e) => return e
  }
  let t = face.tables()
  t.clear()
  match face.table_data_by_name("head") {
    Some(_) => ""
    None => "after face.tables().clear(), face.table_data_by_name(\"head\") is None"
  }
}

///| P2-8: fvar postScriptNameID 0xFFFF means "no PostScript name" (OpenType fvar spec).
fn redteam_p2_8_fvar_ps_name_ffff(world : World, corpus : String) -> String {
  let face = match load_face(world, corpus, "var_fvar_avar", 0) {
    Ok(f) => f
    Err(e) => return e
  }
  let insts = face.named_instances()
  if insts.length() != 2 {
    return "named_instances().length() = " + insts.length().to_string()
  }
  match insts[1].postscript_name_id {
    Some(0xFFFF) => "instance 1 postscript_name_id = Some(65535), want None"
    _ => ""
  }
}

///| P2-11: Windows Symbol (3,0) subtables are addressed at U+F020..U+F0FF; HarfBuzz, FreeType-compatible
///| skrifa and browsers also map U+0020..U+00FF onto them (Wingdings 'A').
fn redteam_p2_11_symbol_cmap_remap(world : World, corpus : String) -> String {
  let face = match load_face(world, corpus, "cmap_symbol_only", 0) {
    Ok(f) => f
    Err(e) => return e
  }
  let sb = StringBuilder::new()
  if !same(face.glyph_index(0xF041), Some(4)) {
    sb.write_string("U+F041 -> " + show(face.glyph_index(0xF041)) + " want Some(4); ")
  }
  if !same(face.glyph_index(0x41), Some(4)) {
    sb.write_string("U+0041 -> " + show(face.glyph_index(0x41)) + " want Some(4) (U+F041 remap); ")
  }
  if !same(face.glyph_index(0x20), Some(3)) {
    sb.write_string("U+0020 -> " + show(face.glyph_index(0x20)) + " want Some(3); ")
  }
  sb.to_string()
}

///| Controls -------------------------------------------------------------------------------------------

///|
fn control_compound_cycles_and_bombs(world : World, corpus : String) -> String {
  let sb = StringBuilder::new()
  let cases = [
    ("glyf_self_loop", 1),
    ("glyf_mutual_loop", 1),
    ("glyf_long_cycle", 3),
    ("glyf_diamond_2e14", 1),
    ("glyf_chain_depth_17", 1),
    ("glyf_repeat_overflow", 1),
    ("glyf_endpts_non_monotonic", 1),
    ("glyf_instr_oob", 1),
  ]
  let mut i = 0
  while i < cases.length() {
    let (n, g) = cases[i]
    match load_face(world, corpus, n, 0) {
      Ok(f) => {
        let ob = opentype::OutlineBuilder::new()
        match f.outline_glyph(g, ob) {
          Err(_) => ()
          Ok(_) => sb.write_string(n + ": outline_glyph must be Err; ")
        }
      }
      Err(e) => sb.write_string(e + "; ")
    }
    i = i + 1
  }
  match load_face(world, corpus, "glyf_chain_depth_16", 0) {
    Ok(f) =>
    match f.outline_glyph(1, opentype::OutlineBuilder::new()) {
      Ok(Some(_)) => ()
      _ => sb.write_string("depth-16 chain must outline; ")
    }
    Err(e) => sb.write_string(e + "; ")
  }
  sb.to_string()
}

///|
fn control_container_bounds(world : World, corpus : String) -> String {
  let sb = StringBuilder::new()
  let errs = [
    ("ttc_face_oob", 2),
    ("ttc_numfonts_ffffffff", 0),
    ("ttc_numfonts_0", 0),
    ("ttc_offset_oob", 0),
    ("sfnt_num_tables_0", 0),
    ("sfnt_num_tables_65535", 0),
    ("sfnt_truncated_dir", 0),
    ("sfnt_bad_version", 0),
    ("sfnt_ttcf_in_ttcf", 0),
    ("sfnt_tiny_11", 0),
    ("sfnt_empty", 0),
    ("maxp_zero_glyphs", 0),
    ("head_short_53", 0),
  ]
  let mut i = 0
  while i < errs.length() {
    let (n, idx) = errs[i]
    match opentype::Face::parse(load_bytes(world, corpus, n), idx) {
      Ok(_) => sb.write_string(n + " must be Err; ")
      Err(_) => ()
    }
    i = i + 1
  }
  match opentype::Face::parse(load_bytes(world, corpus, "ctl_ttc_v1_face1"), -1) {
    Ok(_) => sb.write_string("face_index -1 must be Err; ")
    Err(_) => ()
  }
  match load_face(world, corpus, "sfnt_unsorted_dir", 0) {
    Ok(f) =>
    if !same(f.glyph_index(0x41), Some(1)) || !same(f.glyph_hor_advance(1), Some(510)) {
      sb.write_string("unsorted directory must still find cmap/hmtx; ")
    }
    Err(e) => sb.write_string(e + "; ")
  }
  sb.to_string()
}

///|
fn control_cmap_formats(world : World, corpus : String) -> String {
  let sb = StringBuilder::new()
  // (fixture, code point, expected)
  let pins : Array[(String, Int, Option[Int])] = [
    ("cmap_fmt4_delta_wrap", 0xFFF0, Some(0x10)),
    ("cmap_fmt4_delta_wrap", 0xFFFE, Some(0x1E)),
    ("cmap_fmt4_neg_delta", 0x39, Some(10)),
    ("cmap_fmt4_range_offset", 0x61, Some(10)),
    ("cmap_fmt4_range_offset", 0x62, None),
    ("cmap_fmt4_range_offset", 0x65, Some(14)),
    ("cmap_fmt4_range_offset_delta", 0x62, Some(3)),
    ("cmap_fmt4_range_gid_high", 0x61, Some(0x8001)),
    ("cmap_fmt4_range_offset_oob", 0x61, None),
    ("cmap_fmt4_segx2_zero", 0x41, None),
    ("cmap_fmt6", 0x33, Some(7)),
    ("cmap_fmt6", 0x32, None),
    ("cmap_fmt10", 0x1F602, Some(12)),
    ("cmap_fmt12", 0x1F601, Some(21)),
    ("cmap_fmt12_gid_overflow", 0x48, Some(0xFFFF)),
    ("cmap_fmt12_gid_overflow", 0x49, None),
    ("cmap_fmt12_beyond_10ffff", 0x10FFFF, Some(11)),
    ("cmap_fmt12_ngroups_huge", 0x41, None),
    ("cmap_fmt13", 0x5A, Some(7)),
    ("cmap_fmt13", 0x1F0FF, Some(8)),
    ("cmap_mac_plus_unicode", 0xC4, Some(10)),
    ("cmap_unsupported_fmt8", 0x41, Some(4)),
  ]
  let mut i = 0
  while i < pins.length() {
    let (n, cp, want) = pins[i]
    match load_face(world, corpus, n, 0) {
      Ok(f) => {
        let got = f.glyph_index(cp)
        if !same(got, want) {
          sb.write_string(n + " U+" + hex(cp) + " -> " + show(got) + " want " + show(want) + "; ")
        }
      }
      Err(e) => sb.write_string(e + "; ")
    }
    i = i + 1
  }
  match load_face(world, corpus, "cmap_fmt14", 0) {
    Ok(f) => {
      let uvs : Array[(Int, Int, String)] = [
        (0x41, 0xFE00, "D"),
        (0x42, 0xFE00, "30"),
        (0x4E02, 0xFE00, "D"),
        (0x4E03, 0xFE00, "N"),
        (0x2764, 0xFE0F, "32"),
        (0x41, 0xFE01, "N"),
        (0x10FFFF, 0xE0100, "D"),
      ]
      let mut k = 0
      while k < uvs.length() {
        let (c, vs, want) = uvs[k]
        let got = match f.glyph_variation_index(c, vs) {
          Some(opentype::VariationGlyph::UseDefault) => "D"
          Some(opentype::VariationGlyph::Found(g)) => g.to_string()
          None => "N"
        }
        if got != want {
          sb.write_string("uvs U+" + hex(c) + " " + hex(vs) + " -> " + got + " want " + want + "; ")
        }
        k = k + 1
      }
    }
    Err(e) => sb.write_string(e + "; ")
  }
  sb.to_string()
}

///| name: Mac Roman bytes 0x80..0xFF against Python's mac_roman codec (corpus/macroman.tsv), and
///| UTF-16BE lone surrogates -> U+FFFD.
fn control_name_decoding(world : World, corpus : String) -> String {
  let face = match load_face(world, corpus, "name_edge", 0) {
    Ok(f) => f
    Err(e) => return e
  }
  let table = match fs_read_bytes(world, corpus + "/macroman.tsv") {
    Ok(b) => split_lines(b)
    Err(_) => return "missing macroman.tsv"
  }
  let want = StringBuilder::new()
  let mut i = 0x80
  while i < 0x100 {
    let cols = split_on(table[i], 9)
    want.write_string(hex_str(utf8_of(parse_hex(cols[1]))))
    i = i + 1
  }
  let sb = StringBuilder::new()
  let recs = face.name_records()
  let mut k = 0
  while k < recs.length() {
    let r = recs[k]
    let got = match r.value {
      Some(s) => hex_str(s)
      None => "none"
    }
    if r.name_id == 11 && got != want.to_string() {
      sb.write_string("Mac Roman 0x80..0xFF decode differs from mac_roman: " + got + "; ")
    }
    if r.name_id == 2 && got != "efbfbd41" {
      sb.write_string("lone high surrogate + 'A' -> " + got + "; ")
    }
    if r.name_id == 3 && got != "41efbfbd" {
      sb.write_string("lone low surrogate -> " + got + "; ")
    }
    if r.name_id == 1 && got != "46616df09f9880696c79" {
      sb.write_string("surrogate pair -> " + got + "; ")
    }
    k = k + 1
  }
  match load_face(world, corpus, "name_format1", 0) {
    Ok(f) =>
    match f.family_name() {
      Some(s) => if s != "Format1" { sb.write_string("name format 1 family = " + s + "; ") }
      None => sb.write_string("name format 1 family missing; ")
    }
    Err(e) => sb.write_string(e + "; ")
  }
  sb.to_string()
}

///|
fn utf8_of(cp : Int) -> String {
  let sb = StringBuilder::new()
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
  sb.to_string()
}

///|
fn control_metrics_kern_var(world : World, corpus : String) -> String {
  let sb = StringBuilder::new()
  match load_face(world, corpus, "ctl_hmtx_reuse_last", 0) {
    Ok(f) =>
    if !same(f.glyph_hor_advance(4), Some(510)) || !same(f.glyph_hor_side_bearing(4), Some(14)) ||
    !same(f.glyph_hor_advance(5), None) {
      sb.write_string(
        "hmtx reuse: adv(4) " + show(f.glyph_hor_advance(4)) + " lsb(4) " + show(f.glyph_hor_side_bearing(4)) + "; ",
      )
    }
    Err(e) => sb.write_string(e + "; ")
  }
  match load_face(world, corpus, "ctl_vmtx_reuse_last", 0) {
    Ok(f) =>
    if !same(f.glyph_ver_advance(4), Some(1200)) || !same(f.glyph_ver_side_bearing(4), Some(140)) {
      sb.write_string("vmtx reuse: adv(4) " + show(f.glyph_ver_advance(4)) + "; ")
    }
    Err(e) => sb.write_string(e + "; ")
  }
  let kerns : Array[(String, Int, Int, Int)] = [
    ("kern_v0_basic", 1, 2, -50),
    ("kern_v0_basic", 4, 1, 7),
    ("kern_v0_basic", 1, 1, 0),
    ("kern_v0_multi_sum", 1, 2, -55),
    ("kern_v0_cross_vertical", 1, 2, 0),
    ("kern_aat", 1, 2, -49),
    ("kern_aat", 2, 1, 30),
  ]
  let mut i = 0
  while i < kerns.length() {
    let (n, l, r, want) = kerns[i]
    match load_face(world, corpus, n, 0) {
      Ok(f) => {
        let got = f.kerning(l, r)
        if got != want {
          sb.write_string(n + " (" + l.to_string() + "," + r.to_string() + ") = " + got.to_string() + "; ")
        }
      }
      Err(e) => sb.write_string(e + "; ")
    }
    i = i + 1
  }
  match load_face(world, corpus, "var_fvar_avar", 0) {
    Ok(f) => {
      let n = f.normalize_variation_coords([650.0, 50.0, 72.0, -15.0, 1000.25])
      // wght 650 -> 0.5 -> avar knee 0.8; wdth min; opsz max (default == min); slnt min (default == max)
      if n.length() != 5 || n[0] != 13107 || n[1] != -16384 || n[2] != 16384 || n[3] != -16384 || n[4] != 0 {
        sb.write_string("normalize knee/min/max; ")
      }
      let d = f.normalize_variation_coords([])
      if d.length() != 5 || d[0] != 0 || d[4] != 0 {
        sb.write_string("normalize defaults; ")
      }
    }
    Err(e) => sb.write_string(e + "; ")
  }
  sb.to_string()
}

///|
pub fn rt_all_cases() -> Array[String] {
  [
    "control_compound_cycles_and_bombs", "control_container_bounds", "control_cmap_formats", "control_name_decoding",
    "control_metrics_kern_var", "redteam_p1_1_kern_u16_length_overflow", "redteam_p1_2_mac_roman_cmap_unicode",
    "redteam_p2_1_oob_table_rejects_face", "redteam_p2_2_norm_not_spec_fixed_point", "redteam_p2_3_surrogates_mapped",
    "redteam_p2_4_notdef_some0", "redteam_p2_5_compound_point_matching", "redteam_p2_6_outline_partial_on_error",
    "redteam_p2_7_tables_alias", "redteam_p2_8_fvar_ps_name_ffff", "redteam_p2_11_symbol_cmap_remap",
  ]
}

///|
pub fn rt_run_case(world : World, name : String, corpus : String) -> String {
  if name == "control_compound_cycles_and_bombs" {
    control_compound_cycles_and_bombs(world, corpus)
  } else if name == "control_container_bounds" {
    control_container_bounds(world, corpus)
  } else if name == "control_cmap_formats" {
    control_cmap_formats(world, corpus)
  } else if name == "control_name_decoding" {
    control_name_decoding(world, corpus)
  } else if name == "control_metrics_kern_var" {
    control_metrics_kern_var(world, corpus)
  } else if name == "redteam_p1_1_kern_u16_length_overflow" {
    redteam_p1_1_kern_u16_length_overflow(world, corpus)
  } else if name == "redteam_p1_2_mac_roman_cmap_unicode" {
    redteam_p1_2_mac_roman_cmap_unicode(world, corpus)
  } else if name == "redteam_p2_1_oob_table_rejects_face" {
    redteam_p2_1_oob_table_rejects_face(world, corpus)
  } else if name == "redteam_p2_2_norm_not_spec_fixed_point" {
    redteam_p2_2_norm_not_spec_fixed_point(world, corpus)
  } else if name == "redteam_p2_3_surrogates_mapped" {
    redteam_p2_3_surrogates_mapped(world, corpus)
  } else if name == "redteam_p2_4_notdef_some0" {
    redteam_p2_4_notdef_some0(world, corpus)
  } else if name == "redteam_p2_5_compound_point_matching" {
    redteam_p2_5_compound_point_matching(world, corpus)
  } else if name == "redteam_p2_6_outline_partial_on_error" {
    redteam_p2_6_outline_partial_on_error(world, corpus)
  } else if name == "redteam_p2_7_tables_alias" {
    redteam_p2_7_tables_alias(world, corpus)
  } else if name == "redteam_p2_8_fvar_ps_name_ffff" {
    redteam_p2_8_fvar_ps_name_ffff(world, corpus)
  } else if name == "redteam_p2_11_symbol_cmap_remap" {
    redteam_p2_11_symbol_cmap_remap(world, corpus)
  } else {
    "unknown case " + name
  }
}
