///| Red-team CLI for `packages/opentype` (native + wasm32). Every line it prints is `key = value`;
///| lines starting with `#` are pion-only diagnostics that the comparer ignores.
///|   dump <font> <face> <queries|-> <full 0|1>  -> canonical dump (same protocol as diff/oracle)
///|   stress <font> <face>                       -> exercise every public API, `ms=<t> digest=<h>`
///|   fuzz <listfile>                            -> one `<file> <digest>` line per font (crash/hang/determinism)
///|   list | case <name> <corpus_dir>            -> red-team / control cases (src/cases.pion)

import "opentype"

///|
pub fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut neg = false
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 45 && i == 0 {
      neg = true
    } else if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  if neg {
    -acc
  } else {
    acc
  }
}

///|
pub fn parse_hex(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    let v = if c >= 48 && c <= 57 {
      c - 48
    } else if c >= 97 && c <= 102 {
      c - 87
    } else if c >= 65 && c <= 70 {
      c - 55
    } else {
      0
    }
    acc = acc * 16 + v
    i = i + 1
  }
  acc
}

///| Decimal string -> Double: one correctly rounded division of two exact integers (<= 15 digits).
pub fn parse_decimal(s : String) -> Double {
  let mut num = 0L
  let mut den = 1.0
  let mut neg = false
  let mut frac = false
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 45 {
      neg = true
    } else if c == 46 {
      frac = true
    } else if c >= 48 && c <= 57 {
      num = num * 10L + (c - 48).to_int64()
      if frac {
        den = den * 10.0
      }
    }
    i = i + 1
  }
  let v = num.to_double() / den
  if neg {
    -v
  } else {
    v
  }
}

///|
pub fn split_on(s : String, sep : Int) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == sep {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(start, s.length()))
  out
}

///|
pub fn split_lines(b : Bytes) -> Array[String] {
  let out : Array[String] = []
  let n = b.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || b[i].to_int() == 10 {
      if i > start {
        out.push(b.slice(start, i).to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  out
}

///|
fn hexdigit(v : Int) -> Byte {
  if v < 10 {
    (v + 48).to_byte()
  } else {
    (v + 87).to_byte()
  }
}

///| Lower-case hex of a non-negative Int64, no leading zeros.
pub fn hex64(v : Int64) -> String {
  if v == 0L {
    return "0"
  }
  let digits : Array[Byte] = []
  let mut x = v
  while x > 0L {
    digits.push(hexdigit((x & 15L).to_int()))
    x = x >> 4
  }
  let sb = StringBuilder::new()
  let mut i = digits.length() - 1
  while i >= 0 {
    sb.write_byte(digits[i])
    i = i - 1
  }
  sb.to_string()
}

///|
pub fn hex(v : Int) -> String {
  hex64(v.to_int64())
}

///| Hex of the UTF-8 code units of `s` (`-` for the empty string).
pub fn hex_str(s : String) -> String {
  if s.length() == 0 {
    return "-"
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let v = s.code_unit_at(i) & 0xFF
    sb.write_byte(hexdigit(v >> 4))
    sb.write_byte(hexdigit(v & 15))
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn hex_bytes(b : Bytes) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int() & 0xFF
    sb.write_byte(hexdigit(v >> 4))
    sb.write_byte(hexdigit(v & 15))
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn fnv(h : UInt64, v : Int64) -> UInt64 {
  (h ^ v.to_uint64()) * 1099511628211UL
}

///|
pub let fnv_offset : UInt64 = 14695981039346656037UL

///| Quantize to 1/16 font unit, rounding half away from zero (same as the oracle).
pub fn q4(v : Double) -> Int64 {
  if v >= 0.0 {
    (v * 16.0 + 0.5).to_int64()
  } else {
    (v * 16.0 - 0.5).to_int64()
  }
}

///|
fn opt(v : Option[Int]) -> String {
  match v {
    Some(x) => x.to_string()
    None => "-"
  }
}

///|
fn is_some(v : Option[Int]) -> Bool {
  match v {
    Some(_) => true
    None => false
  }
}

///|
fn kv(sb : StringBuilder, k : String, v : String) -> Unit {
  sb.write_string(k)
  sb.write_string(" = ")
  sb.write_string(v)
  sb.write_string("\n")
}

///| Outline commands as text (full mode) or a count + FNV hash.
pub fn outline_text(ob : opentype::OutlineBuilder, full : Bool) -> String {
  let sb = StringBuilder::new()
  let mut h = fnv_offset
  let mut i = 0
  while i < ob.commands.length() {
    match ob.commands[i] {
      opentype::PathCommand::MoveTo(x, y) => {
        h = fnv(fnv(fnv(h, 1L), q4(x)), q4(y))
        if full {
          sb.write_string(" M " + q4(x).to_string() + " " + q4(y).to_string())
        }
      }
      opentype::PathCommand::LineTo(x, y) => {
        h = fnv(fnv(fnv(h, 2L), q4(x)), q4(y))
        if full {
          sb.write_string(" L " + q4(x).to_string() + " " + q4(y).to_string())
        }
      }
      opentype::PathCommand::QuadTo(cx, cy, x, y) => {
        h = fnv(fnv(fnv(fnv(fnv(h, 3L), q4(cx)), q4(cy)), q4(x)), q4(y))
        if full {
          sb.write_string(
            " Q " + q4(cx).to_string() + " " + q4(cy).to_string() + " " + q4(x).to_string() + " " +
            q4(y).to_string(),
          )
        }
      }
      opentype::PathCommand::Close => {
        h = fnv(h, 4L)
        if full {
          sb.write_string(" Z")
        }
      }
    }
    i = i + 1
  }
  if full {
    "n=" + ob.commands.length().to_string() + sb.to_string()
  } else {
    "n=" + ob.commands.length().to_string() + " h=" + h.to_string()
  }
}

///| Start-point / closing-segment independent outline signature (contours + sorted set of points).
pub fn outline_geom(ob : opentype::OutlineBuilder) -> String {
  let keys : Array[Int64] = []
  let mut moves = 0
  let mut i = 0
  while i < ob.commands.length() {
    match ob.commands[i] {
      opentype::PathCommand::MoveTo(x, y) => {
        moves = moves + 1
        keys.push(q4(x) * 4294967296L + (q4(y) + 2147483648L))
      }
      opentype::PathCommand::LineTo(x, y) => keys.push(q4(x) * 4294967296L + (q4(y) + 2147483648L))
      opentype::PathCommand::QuadTo(cx, cy, x, y) => {
        keys.push(q4(cx) * 4294967296L + (q4(cy) + 2147483648L))
        keys.push(q4(x) * 4294967296L + (q4(y) + 2147483648L))
      }
      opentype::PathCommand::Close => ()
    }
    i = i + 1
  }
  keys.sort()
  let mut h = fnv_offset
  let mut n = 0
  i = 0
  while i < keys.length() {
    if i == 0 || keys[i] != keys[i - 1] {
      let k = keys[i]
      let lo = ((k % 4294967296L) + 4294967296L) % 4294967296L
      let x = (k - lo) / 4294967296L
      h = fnv(fnv(h, x), lo - 2147483648L)
      n = n + 1
    }
    i = i + 1
  }
  "c=" + moves.to_string() + " p=" + n.to_string() + " h=" + h.to_string()
}

///|
fn err_kind(e : opentype::OpenTypeError) -> String {
  match e {
    opentype::OpenTypeError::UnexpectedEof(_) => "eof"
    opentype::OpenTypeError::InvalidMagic(_) => "magic"
    opentype::OpenTypeError::InvalidIndex(_) => "index"
    opentype::OpenTypeError::InvalidTableDirectory(_) => "directory"
    opentype::OpenTypeError::MissingRequiredTable(_) => "missing"
    opentype::OpenTypeError::InvalidTable(_) => "table"
    opentype::OpenTypeError::InvalidGlyph(_) => "glyph"
    opentype::OpenTypeError::LimitExceeded(_) => "limit"
  }
}

///| Canonical dump (protocol shared with diff/oracle/src/main.rs).
pub fn dump(sb : StringBuilder, data : Bytes, face_idx : Int, queries : Array[String], full : Bool) -> Unit {
  match opentype::fonts_in_collection(data) {
    Some(n) => kv(sb, "ttc", n.to_string())
    None => kv(sb, "ttc", "none")
  }
  let face = match opentype::Face::parse(data, face_idx) {
    Ok(f) => f
    Err(e) => {
      kv(sb, "parse", "err")
      sb.write_string("# " + err_kind(e) + ": " + e.to_string() + "\n")
      return ()
    }
  }
  kv(sb, "parse", "ok")
  sb.write_string("# kind " + face.kind().to_string() + "\n")
  let hd = face.head()
  kv(
    sb,
    "head",
    hd.units_per_em.to_string() + " " + hd.x_min.to_string() + " " + hd.y_min.to_string() + " " +
    hd.x_max.to_string() + " " + hd.y_max.to_string() + " " + hd.index_to_loc_format.to_string(),
  )
  let ng = face.number_of_glyphs()
  kv(sb, "maxp", ng.to_string())
  match face.hhea() {
    Some(h) => kv(
      sb,
      "hhea",
      h.ascender.to_string() + " " + h.descender.to_string() + " " + h.line_gap.to_string() + " " +
      h.number_of_h_metrics.to_string(),
    )
    None => kv(sb, "hhea", "none")
  }
  match face.vhea() {
    Some(h) => kv(
      sb,
      "vhea",
      h.ascender.to_string() + " " + h.descender.to_string() + " " + h.line_gap.to_string() + " " +
      h.number_of_v_metrics.to_string(),
    )
    None => kv(sb, "vhea", "none")
  }
  match face.os2() {
    Some(o) => {
      kv(sb, "os2a", o.version.to_string() + " " + o.weight_class.to_string() + " " + o.width_class.to_string())
      kv(
        sb,
        "os2t",
        o.typo_ascender.to_string() + " " + o.typo_descender.to_string() + " " + o.typo_line_gap.to_string() +
        " " + o.win_ascent.to_string() + " " + o.win_descent.to_string(),
      )
      kv(
        sb,
        "os2s",
        o.y_subscript_x_size.to_string() + " " + o.y_subscript_y_size.to_string() + " " +
        o.y_subscript_x_offset.to_string() + " " + o.y_subscript_y_offset.to_string() + " " +
        o.y_superscript_x_size.to_string() + " " + o.y_superscript_y_size.to_string() + " " +
        o.y_superscript_x_offset.to_string() + " " + o.y_superscript_y_offset.to_string() + " " +
        o.y_strikeout_size.to_string() + " " + o.y_strikeout_position.to_string(),
      )
      kv(sb, "os2x", opt(o.x_height) + " " + opt(o.cap_height))
      kv(sb, "os2f", o.fs_selection.to_string() + " " + hex_bytes(o.panose))
    }
    None => kv(sb, "os2a", "none")
  }
  match face.post() {
    Some(p) => kv(
      sb,
      "post",
      p.italic_angle_fixed.to_string() + " " + p.underline_position.to_string() + " " +
      p.underline_thickness.to_string() + " " + (if p.is_fixed_pitch { "1" } else { "0" }),
    )
    None => kv(sb, "post", "none")
  }
  // cmap: full Unicode scalar sweep, mapped code points only
  let mut cp = 0
  while cp <= 0x10FFFF {
    if cp == 0xD800 {
      cp = 0xE000
    }
    match face.glyph_index(cp) {
      Some(g) => kv(sb, "cmap " + hex(cp), g.to_string())
      None => ()
    }
    cp = cp + 1
  }
  let mut s = 0xD800
  while s <= 0xDFFF {
    match face.glyph_index(s) {
      Some(g) => sb.write_string("# surrogate " + hex(s) + " -> " + g.to_string() + "\n")
      None => ()
    }
    s = s + 1
  }
  let mut g = 0
  while g < ng {
    let a = face.glyph_hor_advance(g)
    let b = face.glyph_hor_side_bearing(g)
    if is_some(a) || is_some(b) {
      kv(sb, "hmtx " + g.to_string(), opt(a) + " " + opt(b))
    }
    let va = face.glyph_ver_advance(g)
    let vb = face.glyph_ver_side_bearing(g)
    if is_some(va) || is_some(vb) {
      kv(sb, "vmtx " + g.to_string(), opt(va) + " " + opt(vb))
    }
    g = g + 1
  }
  let ob = opentype::OutlineBuilder::new()
  g = 0
  while g < ng {
    match face.glyph_bounding_box(g) {
      Ok(Some(r)) => kv(
        sb,
        "gbox " + g.to_string(),
        r.x_min.to_string() + " " + r.y_min.to_string() + " " + r.x_max.to_string() + " " + r.y_max.to_string(),
      )
      Ok(None) => ()
      Err(e) => sb.write_string("# gbox " + g.to_string() + " " + err_kind(e) + "\n")
    }
    ob.clear()
    match face.outline_glyph(g, ob) {
      Ok(Some(_)) => {
        kv(sb, "outl " + g.to_string(), outline_text(ob, full))
        kv(sb, "geom " + g.to_string(), outline_geom(ob))
      }
      Ok(None) => ()
      Err(e) => sb.write_string(
        "# outl " + g.to_string() + " " + err_kind(e) + " partial=" + ob.len().to_string() + "\n",
      )
    }
    g = g + 1
  }
  let names = face.name_records()
  let mut i = 0
  while i < names.length() {
    let r = names[i]
    let v = match r.value {
      Some(x) => hex_str(x)
      None => "none"
    }
    kv(
      sb,
      "name " + i.to_string(),
      r.platform_id.to_string() + " " + r.encoding_id.to_string() + " " + r.language_id.to_string() + " " +
      r.name_id.to_string() + " " + v,
    )
    i = i + 1
  }
  let axes = face.variation_axes()
  i = 0
  while i < axes.length() {
    let ax = axes[i]
    kv(
      sb,
      "axis " + i.to_string(),
      hex64(ax.tag.value) + " " + ax.min_fixed.to_string() + " " + ax.default_fixed.to_string() + " " +
      ax.max_fixed.to_string() + " " + (if ax.hidden { "1" } else { "0" }) + " " + ax.name_id.to_string(),
    )
    i = i + 1
  }
  let insts = face.named_instances()
  i = 0
  while i < insts.length() {
    let it = insts[i]
    let cs = StringBuilder::new()
    let mut k = 0
    while k < it.coordinates_fixed.length() {
      if k > 0 {
        cs.write_string(",")
      }
      cs.write_string(it.coordinates_fixed[k].to_string())
      k = k + 1
    }
    let ps = match it.postscript_name_id {
      Some(x) => x.to_string()
      None => "none"
    }
    kv(sb, "inst " + i.to_string(), it.subfamily_name_id.to_string() + " " + ps + " " + cs.to_string())
    i = i + 1
  }
  // queries
  i = 0
  while i < queries.length() {
    let p = split_on(queries[i], 32)
    if p[0] == "kern" && p.length() >= 3 {
      let l = parse_int(p[1])
      let r = parse_int(p[2])
      kv(sb, "kern " + l.to_string() + " " + r.to_string(), face.kerning(l, r).to_string())
    } else if p[0] == "uvs" && p.length() >= 3 {
      let c = parse_hex(p[1])
      let vs = parse_hex(p[2])
      let v = match face.glyph_variation_index(c, vs) {
        Some(opentype::VariationGlyph::UseDefault) => "default"
        Some(opentype::VariationGlyph::Found(x)) => x.to_string()
        None => "none"
      }
      kv(sb, "uvs " + hex(c) + " " + hex(vs), v)
    } else if p[0] == "glyph" && p.length() >= 2 {
      let gid = parse_int(p[1])
      let gb = opentype::OutlineBuilder::new()
      match face.outline_glyph(gid, gb) {
        Ok(Some(_)) => kv(sb, "ofull " + gid.to_string(), outline_text(gb, true))
        _ => kv(sb, "ofull " + gid.to_string(), "none")
      }
    } else if p[0] == "norm" && p.length() >= 2 {
      let coords : Array[Double] = []
      if p[1] != "-" {
        let parts = split_on(p[1], 44)
        let mut k = 0
        while k < parts.length() {
          coords.push(parse_decimal(parts[k]))
          k = k + 1
        }
      }
      let out = face.normalize_variation_coords(coords)
      let os = StringBuilder::new()
      let mut k = 0
      while k < out.length() {
        if k > 0 {
          os.write_string(",")
        }
        os.write_string(out[k].to_string())
        k = k + 1
      }
      kv(sb, "norm " + p[1], if out.length() == 0 { "-" } else { os.to_string() })
    }
    i = i + 1
  }
}

///| Exercise every public API on one face; returns a digest (for DoS timing and the fuzz corpus).
pub fn stress(data : Bytes, face_idx : Int, light : Bool) -> UInt64 {
  let mut h = fnv_offset
  match opentype::fonts_in_collection(data) {
    Some(n) => h = fnv(h, n.to_int64())
    None => h = fnv(h, -1L)
  }
  let face = match opentype::Face::parse(data, face_idx) {
    Ok(f) => f
    Err(e) => return fnv(h, err_kind(e).length().to_int64() + 1000L)
  }
  h = fnv(h, face.units_per_em().to_int64())
  let ng = face.number_of_glyphs()
  let tables = face.tables()
  let mut i = 0
  while i < tables.length() {
    match face.table_data(tables[i].tag) {
      Some(b) => h = fnv(h, b.length().to_int64())
      None => h = fnv(h, -2L)
    }
    i = i + 1
  }
  let mut cp = 0
  while cp <= 0x10FFFF {
    if light && cp == 0x400 {
      cp = 0xFFF0
    }
    if light && cp == 0x10010 {
      cp = 0x1F5F0
    }
    if light && cp == 0x1F610 {
      cp = 0x10FFF0
    }
    match face.glyph_index(cp) {
      Some(g) => h = fnv(fnv(h, cp.to_int64()), g.to_int64())
      None => ()
    }
    cp = cp + 1
  }
  let ob = opentype::OutlineBuilder::new()
  let lim = if light && ng > 2000 { 2000 } else { ng }
  let mut g = 0
  while g < lim {
    h = fnv(h, opt(face.glyph_hor_advance(g)).length().to_int64())
    match face.glyph_hor_side_bearing(g) {
      Some(v) => h = fnv(h, v.to_int64())
      None => ()
    }
    match face.glyph_ver_advance(g) {
      Some(v) => h = fnv(h, v.to_int64())
      None => ()
    }
    match face.glyph_ver_side_bearing(g) {
      Some(v) => h = fnv(h, v.to_int64())
      None => ()
    }
    match face.glyph_bounding_box(g) {
      Ok(Some(r)) => h = fnv(fnv(h, r.x_min.to_int64()), r.y_max.to_int64())
      Ok(None) => h = fnv(h, 7L)
      Err(_) => h = fnv(h, 8L)
    }
    ob.clear()
    match face.outline_glyph(g, ob) {
      Ok(Some(r)) => h = fnv(fnv(h, ob.len().to_int64()), r.width().to_int64())
      Ok(None) => h = fnv(h, 9L)
      Err(_) => h = fnv(fnv(h, 10L), ob.len().to_int64())
    }
    let mut j = 0
    while j < ob.commands.length() {
      match ob.commands[j] {
        opentype::PathCommand::MoveTo(x, y) => h = fnv(fnv(h, q4(x)), q4(y))
        opentype::PathCommand::LineTo(x, y) => h = fnv(fnv(h, q4(x)), q4(y))
        opentype::PathCommand::QuadTo(_, _, x, y) => h = fnv(fnv(h, q4(x)), q4(y))
        opentype::PathCommand::Close => h = fnv(h, 4L)
      }
      j = j + 1
    }
    g = g + 1
  }
  let kl = if light { 16 } else { 64 }
  let mut l = 0
  while l < kl {
    let mut r = 0
    while r < kl {
      h = fnv(h, face.kerning(l, r).to_int64())
      r = r + 1
    }
    l = l + 1
  }
  let names = face.name_records()
  i = 0
  while i < names.length() {
    match names[i].value {
      Some(s) => h = fnv(h, s.length().to_int64())
      None => h = fnv(h, -3L)
    }
    i = i + 1
  }
  let mut nid = 0
  while nid < 26 {
    match face.name_by_id(nid) {
      Some(s) => h = fnv(h, s.length().to_int64())
      None => ()
    }
    nid = nid + 1
  }
  let vss = [0xFE00, 0xFE0F, 0xE0100, 0x180B]
  let mut vi = 0
  while vi < vss.length() {
    let mut c = 0
    while c < (if light { 64 } else { 0x3000 }) {
      match face.glyph_variation_index(c * 7 + 0x20, vss[vi]) {
        Some(opentype::VariationGlyph::UseDefault) => h = fnv(h, 11L)
        Some(opentype::VariationGlyph::Found(x)) => h = fnv(h, x.to_int64())
        None => ()
      }
      c = c + 1
    }
    vi = vi + 1
  }
  let axes = face.variation_axes()
  h = fnv(h, axes.length().to_int64())
  h = fnv(h, face.named_instances().length().to_int64())
  h = fnv(h, face.avar_segments().length().to_int64())
  let coords : Array[Double] = []
  i = 0
  while i < axes.length() {
    coords.push(axes[i].max_value * 0.37 + axes[i].min_value * 0.63)
    i = i + 1
  }
  let norm = face.normalize_variation_coords(coords)
  i = 0
  while i < norm.length() {
    h = fnv(h, norm[i].to_int64())
    i = i + 1
  }
  h
}

///| Deterministic in-memory mutation fuzzing of one seed font (xorshift64*; identical in all 4 modes).
pub fn fuzz_mutate(world : World, seed_font : Bytes, iters : Int, seed : Int64) -> Unit {
  let mut st = seed.to_uint64() * 2685821657736338717UL + 1UL
  let n = seed_font.length()
  if n < 16 {
    return ()
  }
  let mut it = 0
  while it < iters {
    st = st ^ (st >> 12)
    st = st ^ (st << 25)
    st = st ^ (st >> 27)
    let r = st * 2685821657736338717UL
    let op = (r >> 61).to_int()
    let pos = ((r >> 20) % n.to_int64().to_uint64()).to_int()
    let len = if op == 0 { pos + 1 } else { n }
    let d = Bytes::new(len)
    let mut i = 0
    while i < len {
      d[i] = seed_font[i]
      i = i + 1
    }
    if op == 1 || op == 2 {
      // flip 1..8 bits around pos
      let k = ((r >> 8) & 7UL).to_int() + 1
      let mut j = 0
      while j < k {
        let p = (pos + j * 37) % len
        d[p] = (d[p].to_int() ^ (1 << ((j + (r & 7UL).to_int()) & 7))).to_byte()
        j = j + 1
      }
    } else if op == 3 && pos + 2 <= len {
      let vals = [0, 1, 0x7FFF, 0x8000, 0xFFFF, 0xFFFE, 0x100]
      let v = vals[((r >> 3) % 7UL).to_int()]
      let p = pos - pos % 2
      d[p] = (v >> 8).to_byte()
      d[p + 1] = (v & 0xFF).to_byte()
    } else if op == 4 && pos + 4 <= len {
      let p = pos - pos % 2
      let v = if (r & 1UL) == 0UL { 0xFF } else { 0 }
      d[p] = v.to_byte()
      d[p + 1] = v.to_byte()
      d[p + 2] = v.to_byte()
      d[p + 3] = (r & 0xFFUL).to_int().to_byte()
    } else if op >= 5 {
      // table directory record: offset / length / checksum fields
      let recs = (n - 12) / 16
      let rec = 12 + 16 * ((r >> 30) % (if recs > 40 { 40UL } else if recs > 0 { recs.to_int64().to_uint64() } else { 1UL })).to_int()
      let fld = rec + 4 + 4 * ((r >> 5) % 3UL).to_int()
      if fld + 4 <= len {
        let v = (r >> 32).to_int() & 0x7FFFFFFF
        let w = if (r & 3UL) == 0UL { 0 } else if (r & 3UL) == 1UL { 0x7FFFFFFF } else { v % (n + 64) }
        d[fld] = ((w >> 24) & 0xFF).to_byte()
        d[fld + 1] = ((w >> 16) & 0xFF).to_byte()
        d[fld + 2] = ((w >> 8) & 0xFF).to_byte()
        d[fld + 3] = (w & 0xFF).to_byte()
      }
    }
    io_println(world, it.to_string() + " " + stress(d, 0, true).to_string())
    it = it + 1
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: opentype_audit dump|stress|fuzz|list|case ...")
    return 2
  }
  let mode = args[1]
  if mode == "dump" && args.length() >= 6 {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 3
    }
    let queries = if args[4] == "-" {
      []
    } else {
      match fs_read_bytes(world, args[4]) {
        Ok(b) => split_lines(b)
        Err(_) => return 3
      }
    }
    let sb = StringBuilder::new()
    dump(sb, data, parse_int(args[3]), queries, args[5] == "1")
    io_print(world, sb.to_string())
    return 0
  }
  if mode == "stress" && args.length() >= 4 {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 3
    }
    let t0 = clock_monotonic_us()
    let h = stress(data, parse_int(args[3]), false)
    let t1 = clock_monotonic_us()
    io_println(world, "ms=" + ((t1 - t0) / 1000L).to_string() + " digest=" + h.to_string())
    return 0
  }
  if mode == "fuzz" && args.length() >= 3 {
    let files = match fs_read_bytes(world, args[2]) {
      Ok(b) => split_lines(b)
      Err(_) => return 3
    }
    let mut i = 0
    while i < files.length() {
      match fs_read_bytes(world, files[i]) {
        Ok(b) => {
          let h0 = stress(b, 0, true)
          let h1 = stress(b, 1, true)
          io_println(world, files[i] + " " + h0.to_string() + " " + h1.to_string())
        }
        Err(_) => io_println(world, files[i] + " unreadable")
      }
      i = i + 1
    }
    return 0
  }
  if mode == "fuzzmut" && args.length() >= 5 {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 3
    }
    fuzz_mutate(world, data, parse_int(args[3]), parse_int(args[4]).to_int64())
    return 0
  }
  if mode == "cost" && args.length() >= 4 {
    // parse once, then n glyph_index + n glyph_variation_index lookups: `parse_ms=<t> lookup_ms=<t> hits=<k>`
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 3
    }
    let n = parse_int(args[3])
    let t0 = clock_monotonic_us()
    let face = match opentype::Face::parse(data, 0) {
      Ok(f) => f
      Err(e) => {
        io_println(world, "parse_ms=" + ((clock_monotonic_us() - t0) / 1000L).to_string() + " lookup_ms=0 err=" + err_kind(e))
        return 0
      }
    }
    let t1 = clock_monotonic_us()
    let mut hits = 0
    let mut i = 0
    while i < n {
      match face.glyph_index(0x100 + i % 0xD000) {
        Some(_) => hits = hits + 1
        None => ()
      }
      match face.glyph_variation_index(0x41 + i % 0x5000, 0xFE00) {
        Some(_) => hits = hits + 1
        None => ()
      }
      i = i + 1
    }
    let t2 = clock_monotonic_us()
    io_println(
      world,
      "parse_ms=" + ((t1 - t0) / 1000L).to_string() + " lookup_ms=" + ((t2 - t1) / 1000L).to_string() + " hits=" +
      hits.to_string(),
    )
    return 0
  }
  if mode == "list" {
    let names = rt_all_cases()
    let mut i = 0
    while i < names.length() {
      io_println(world, names[i])
      i = i + 1
    }
    return 0
  }
  if mode == "case" && args.length() >= 4 {
    let r = rt_run_case(world, args[2], args[3])
    if r == "" {
      io_println(world, "PASS " + args[2])
    } else {
      io_println(world, "FAIL " + args[2] + " :: " + r)
    }
    return 0
  }
  io_println(world, "bad arguments")
  2
}
