///| Public types, errors, and resource limits for `packages/brotli`.
///| Pure Pion implementation of RFC 7932 (Brotli Compressed Data Format).

///| Default decompression output limit (256 MiB) to defend against decompression bombs.
pub let default_max_output_bytes : Int = 268435456

///| Default maximum LZ77 sliding window bits (RFC 7932 standard maximum = 24).
pub let default_max_window_bits : Int = 24

///| Decompression resource limits.
pub val struct DecodeLimits {
  pub max_output_bytes : Int
  pub max_window_bits : Int
}

///| Default decompression limits (256 MiB output, 24 window bits).
pub fn DecodeLimits::default() -> DecodeLimits {
  DecodeLimits::{
    max_output_bytes: default_max_output_bytes,
    max_window_bits: default_max_window_bits,
  }
}

///| Create custom decompression limits.
pub fn DecodeLimits::new(max_output_bytes : Int, max_window_bits : Int) -> DecodeLimits {
  DecodeLimits::{
    max_output_bytes: max_output_bytes,
    max_window_bits: max_window_bits,
  }
}

///| Error returned by Brotli decompression.
pub enum BrotliError {
  UnexpectedEof(String)
  InvalidWindowBits(Int)
  WindowLimitExceeded(Int)
  InvalidMetaBlock(String)
  InvalidPrefixCode(String)
  InvalidContextMap(String)
  InvalidDistance(String)
  InvalidDictionaryRef(String)
  InvalidTrailingBits(String)
  TrailingData(Int)
  OutputLimitExceeded(Int)
}

///| Human-readable description of a `BrotliError`.
pub fn brotli_error_message(err : BrotliError) -> String {
  match err {
    UnexpectedEof(msg) => "unexpected EOF: " + msg
    InvalidWindowBits(w) => "invalid window bits: " + w.to_string()
    WindowLimitExceeded(w) => "window bits exceeded limit: " + w.to_string()
    InvalidMetaBlock(msg) => "invalid meta-block: " + msg
    InvalidPrefixCode(msg) => "invalid prefix code: " + msg
    InvalidContextMap(msg) => "invalid context map: " + msg
    InvalidDistance(msg) => "invalid distance: " + msg
    InvalidDictionaryRef(msg) => "invalid dictionary reference: " + msg
    InvalidTrailingBits(msg) => "invalid trailing bits: " + msg
    TrailingData(n) => "trailing data after stream end: " + n.to_string() + " bytes"
    OutputLimitExceeded(limit) =>
    "decompressed output exceeded limit: " + limit.to_string()
  }
}

///|
pub fn BrotliError::to_string(self : BrotliError) -> String {
  brotli_error_message(self)
}
