///| Pure Pion Brotli (RFC 7932) decoder — Red-phase API stub.

///| Decode a complete Brotli (RFC 7932) stream with default resource limits.
pub fn decode(data : Bytes) -> Result[Bytes, BrotliError] {
  decode_with_limits(data, DecodeLimits::default())
}

///| Decode a complete Brotli (RFC 7932) stream with explicit resource limits.
pub fn decode_with_limits(
  data : Bytes,
  limits : DecodeLimits,
) -> Result[Bytes, BrotliError] {
  let _ = data
  let _ = limits
  Err(BrotliError::InvalidMetaBlock("unimplemented"))
}
