///| Red-team unit tests for `packages/brotli`.
///| Assertions encode the *expected correct* behaviour: a `redteam_` test FAILS (or panics) while the defect
///| exists and PASSES once fixed.  Tests prefixed `control_` document behaviour that is already correct.
///| Cross-implementation evidence (C libbrotlidec / Rust brotli) lives in `difftest.py`, `dos_gen.py`, `REPORT.md`.

import "brotli"

///| LSB-first bit writer used to build bombs and edge streams in-test (RFC 7932 §2).
struct RtBits {
  out : Array[Int]
  mut acc : Int
  mut n : Int
}

///|
fn RtBits::new() -> RtBits {
  RtBits::{ out: [], acc: 0, n: 0 }
}

///|
fn RtBits::put(self : RtBits, v : Int, k : Int) -> Unit {
  let mut i = 0
  while i < k {
    self.acc = self.acc | (((v >> i) & 1) << self.n)
    self.n = self.n + 1
    if self.n == 8 {
      self.out.push(self.acc)
      self.acc = 0
      self.n = 0
    }
    i = i + 1
  }
}

///|
fn RtBits::finish(self : RtBits) -> Bytes {
  if self.n > 0 {
    self.out.push(self.acc)
    self.acc = 0
    self.n = 0
  }
  let b = Bytes::new(self.out.length())
  let mut i = 0
  while i < self.out.length() {
    b[i] = self.out[i].to_byte()
    i = i + 1
  }
  b
}

///| One meta-block (MLEN = insert + copy) made of single-symbol prefix codes: `insert` literal zero bytes, then
///| a copy of `copy` bytes at distance 1 (code 16, NPOSTFIX = NDIRECT = 0).  `copy` must be in 2118 .. 2118 + 2^24 - 1.
fn rt_copy_block(w : RtBits, insert : Int, copy : Int) -> Unit {
  w.put(0, 1) // ISLAST
  w.put(2, 2) // MNIBBLES = 6
  w.put(insert + copy - 1, 24) // MLEN - 1
  w.put(0, 1) // ISUNCOMPRESSED
  w.put(0, 3) // NBLTYPESL/I/D = 1
  w.put(0, 6) // NPOSTFIX, NDIRECT
  w.put(0, 2) // CMODE
  w.put(0, 2) // NTREESL = NTREESD = 1
  w.put(1, 2) // literal code: simple, NSYM = 1, symbol 0
  w.put(0, 2)
  w.put(0, 8)
  w.put(1, 2) // command code: simple, NSYM = 1
  w.put(0, 2)
  w.put(384 + (insert << 3) + 7, 10) // cell 6: insert code `insert`, copy code 23
  w.put(1, 2) // distance code: simple, NSYM = 1, symbol 16 (distance 1)
  w.put(0, 2)
  w.put(16, 6)
  w.put(copy - 2118, 24) // copy extra bits
  w.put(0, 1) // distance extra bit
}

///| `blocks` x 16 MiB of zeros from ~13 bytes per meta-block.
fn rt_bomb(blocks : Int) -> Bytes {
  let w = RtBits::new()
  w.put(1, 1) // WBITS = 24
  w.put(7, 3)
  rt_copy_block(w, 1, 16777215)
  let mut i = 1
  while i < blocks {
    rt_copy_block(w, 0, 16777216)
    i = i + 1
  }
  w.put(3, 2) // ISLAST, ISLASTEMPTY
  w.finish()
}

///|
fn rt_bytes(vals : Array[Int]) -> Bytes {
  let b = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn rt_kind(r : Result[Bytes, brotli::BrotliError]) -> String {
  match r {
    Ok(out) => "Ok(" + out.length().to_string() + ")"
    Err(UnexpectedEof(_)) => "UnexpectedEof"
    Err(InvalidWindowBits(_)) => "InvalidWindowBits"
    Err(WindowLimitExceeded(_)) => "WindowLimitExceeded"
    Err(InvalidMetaBlock(_)) => "InvalidMetaBlock"
    Err(InvalidPrefixCode(_)) => "InvalidPrefixCode"
    Err(InvalidContextMap(_)) => "InvalidContextMap"
    Err(InvalidDistance(_)) => "InvalidDistance"
    Err(InvalidDictionaryRef(_)) => "InvalidDictionaryRef"
    Err(InvalidTrailingBits(_)) => "InvalidTrailingBits"
    Err(TrailingData(_)) => "TrailingData"
    Err(OutputLimitExceeded(_)) => "OutputLimitExceeded"
  }
}

///|
fn rt_expect(r : Result[Bytes, brotli::BrotliError], want : String, label : String) -> Unit {
  let got = rt_kind(r)
  debug_assert(got == want, label + ": expected " + want + ", got " + got)
}

// ---------------------------------------------------------------------------------------------------------------
// P1 findings (crash / abort on attacker-reachable input)
// ---------------------------------------------------------------------------------------------------------------

///| P1-1: `decode_with_limits` computes `data.length() * 4 + 256` in 32-bit `Int`; any input of
///| 536,870,848 .. 1,073,741,759 bytes wraps negative and `Bytes::new(negative)` aborts the process
///| ("negative bytes length") before a single meta-block is parsed.  C / Rust decode the same stream fine.
test "redteam_p1_input_over_512mib_does_not_abort" {
  let big = Bytes::new(536870912) // byte 0 = 0x00: WBITS 16, then an (invalid) compressed meta-block
  let r = brotli::decode(big)
  debug_assert(
    match r {
      Ok(_) => true
      Err(_) => true
    },
    "decode returned",
  )
}

///| P1-2: `max_output_bytes` in 2,147,483,632 .. 2,147,483,647 (e.g. `Int` max as "no limit") lets `OutBuf`
///| grow its capacity to `max_output_bytes`, above the runtime container maximum (2^31 - 17) -> abort
///| "container length exceeds maximum" on a 1.6 KB input.  Expected: `OutputLimitExceeded` (or a clean Err).
test "redteam_p1_int_max_output_limit_does_not_abort" {
  let bomb = rt_bomb(128) // 2 GiB of zeros
  let r = brotli::decode_with_limits(bomb, brotli::DecodeLimits::new(2147483647, 24))
  rt_expect(r, "OutputLimitExceeded", "2 GiB bomb at Int max limit")
}

// ---------------------------------------------------------------------------------------------------------------
// Controls: limits API and bomb handling that is already correct
// ---------------------------------------------------------------------------------------------------------------

///|
test "control_limits_api_validation" {
  let empty = rt_bytes([6])
  rt_expect(brotli::decode_with_limits(empty, brotli::DecodeLimits::new(-1, 24)), "OutputLimitExceeded", "max_output -1")
  rt_expect(brotli::decode_with_limits(empty, brotli::DecodeLimits::new(0, 24)), "Ok(0)", "max_output 0, empty stream")
  rt_expect(brotli::decode_with_limits(rt_bytes([11, 0, 128, 97, 3]), brotli::DecodeLimits::new(0, 24)), "OutputLimitExceeded", "max_output 0, 1 byte")
  rt_expect(brotli::decode_with_limits(rt_bytes([11, 0, 128, 97, 3]), brotli::DecodeLimits::new(1, 24)), "Ok(1)", "max_output 1, 1 byte")
  rt_expect(brotli::decode_with_limits(empty, brotli::DecodeLimits::new(100, 9)), "InvalidWindowBits", "max_window_bits 9")
  rt_expect(brotli::decode_with_limits(empty, brotli::DecodeLimits::new(100, 25)), "InvalidWindowBits", "max_window_bits 25")
  rt_expect(brotli::decode_with_limits(empty, brotli::DecodeLimits::new(100, -5)), "InvalidWindowBits", "max_window_bits -5")
  // WBITS 24 stream ("0f00806103" = 'a') vs max_window_bits 23 / 24
  let w24 = rt_bytes([15, 0, 128, 97, 3])
  rt_expect(brotli::decode_with_limits(w24, brotli::DecodeLimits::new(100, 23)), "WindowLimitExceeded", "WBITS 24 > max 23")
  rt_expect(brotli::decode_with_limits(w24, brotli::DecodeLimits::new(100, 24)), "Ok(1)", "WBITS 24 = max 24")
  // WBITS 10 stream ("210000046103") vs max_window_bits 10
  let w10 = rt_bytes([33, 0, 0, 4, 97, 3])
  rt_expect(brotli::decode_with_limits(w10, brotli::DecodeLimits::new(100, 10)), "Ok(1)", "WBITS 10 = max 10")
  // large-window marker (WBITS bits 1,000,001) is not RFC 7932
  rt_expect(brotli::decode(rt_bytes([17, 3])), "InvalidWindowBits", "large-window marker")
}

///|
test "control_bomb_1gib_rejected_before_allocation" {
  let bomb = rt_bomb(64) // ~0.8 KB -> 1 GiB
  rt_expect(brotli::decode_with_limits(bomb, brotli::DecodeLimits::new(1048576, 24)), "OutputLimitExceeded", "1 MiB limit")
  rt_expect(brotli::decode_with_limits(bomb, brotli::DecodeLimits::new(0, 24)), "OutputLimitExceeded", "0 limit")
  rt_expect(brotli::decode(bomb), "OutputLimitExceeded", "default 256 MiB limit")
  // exactly one meta-block (16 MiB) fits a 16 MiB limit; the second block's copy is refused
  rt_expect(brotli::decode_with_limits(rt_bomb(1), brotli::DecodeLimits::new(16777216, 24)), "Ok(16777216)", "16 MiB fits")
  rt_expect(brotli::decode_with_limits(rt_bomb(2), brotli::DecodeLimits::new(16777216, 24)), "OutputLimitExceeded", "32 MiB > 16 MiB")
}

///|
test "control_metadata_flood_100k" {
  let b = Bytes::new(100001)
  b[0] = (12).to_byte() // WBITS 16 + first empty metadata block
  let mut i = 1
  while i < 100000 {
    b[i] = (6).to_byte() // empty metadata block
    i = i + 1
  }
  b[100000] = (3).to_byte() // ISLAST + ISLASTEMPTY
  rt_expect(brotli::decode(b), "Ok(0)", "100k metadata blocks")
}

///|
test "control_stream_termination_strictness" {
  rt_expect(brotli::decode(rt_bytes([6, 0])), "TrailingData", "trailing zero byte")
  rt_expect(brotli::decode(rt_bytes([134])), "InvalidTrailingBits", "non-zero final padding")
  rt_expect(brotli::decode(rt_bytes([])), "UnexpectedEof", "empty input")
  rt_expect(brotli::decode(rt_bytes([11, 0, 128, 97])), "UnexpectedEof", "truncated before ISLAST")
}
