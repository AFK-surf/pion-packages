///| Red-team differential harness CLI for `packages/brotli`.
///| Batch file format: repeated `[u32 LE length][payload]` records.
///| Modes:
///|   batch <cases.bin> <limit> [max_wbits]   -> one line per case: `OK <len> <fnv64>` | `ERR <Variant>`
///|   file <in> <limit> [max_wbits] [out]     -> single-file decode (bombs / DoS probes)
///|   bench <in> <iters>                      -> timed loop for bench_compare.py

import "brotli"

///|
fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut neg = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 45 && i == 0 {
      neg = true
    } else if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  if neg {
    0 - acc
  } else {
    acc
  }
}

///|
fn err_name(e : brotli::BrotliError) -> String {
  match e {
    UnexpectedEof(_) => "UnexpectedEof"
    InvalidWindowBits(_) => "InvalidWindowBits"
    WindowLimitExceeded(_) => "WindowLimitExceeded"
    InvalidMetaBlock(_) => "InvalidMetaBlock"
    InvalidPrefixCode(_) => "InvalidPrefixCode"
    InvalidContextMap(_) => "InvalidContextMap"
    InvalidDistance(_) => "InvalidDistance"
    InvalidDictionaryRef(_) => "InvalidDictionaryRef"
    InvalidTrailingBits(_) => "InvalidTrailingBits"
    TrailingData(_) => "TrailingData"
    OutputLimitExceeded(_) => "OutputLimitExceeded"
  }
}

///|
fn fnv64(b : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = b.length()
  let mut i = 0
  while i < n {
    h = (h ^ b[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn read_u32le(b : Bytes, p : Int) -> Int {
  b[p].to_int() |
  (b[p + 1].to_int() << 8) |
  (b[p + 2].to_int() << 16) |
  (b[p + 3].to_int() << 24)
}

///|
fn result_line(r : Result[Bytes, brotli::BrotliError]) -> String {
  match r {
    Ok(out) => "OK " + out.length().to_string() + " " + fnv64(out).to_string()
    Err(e) => "ERR " + err_name(e)
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: brotli_audit <batch|file|bench> ...")
    return 2
  }
  let mode = args[1]
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => return 3
  }
  let limit = if args.length() >= 4 {
    parse_int(args[3])
  } else {
    brotli::default_max_output_bytes
  }
  let wbits = if args.length() >= 5 { parse_int(args[4]) } else { 24 }
  let lim = brotli::DecodeLimits::new(limit, wbits)
  if mode == "batch" {
    let sb = StringBuilder::new()
    let n = data.length()
    let mut p = 0
    while p + 4 <= n {
      let len = read_u32le(data, p)
      p = p + 4
      sb.write_string(result_line(brotli::decode_with_limits(data.slice(p, p + len), lim)))
      sb.write_string("\n")
      p = p + len
    }
    io_print(world, sb.to_string())
    return 0
  }
  if mode == "file" {
    let r = brotli::decode_with_limits(data, lim)
    io_println(world, result_line(r))
    if args.length() >= 6 {
      match r {
        Ok(out) => {
          let _ = fs_write_bytes(world, args[5], out)
        }
        Err(_) => ()
      }
    }
    return 0
  }
  if mode == "bench" {
    let iters = if args.length() >= 4 { parse_int(args[3]) } else { 1 }
    let mut last = Bytes::new(0)
    let mut i = 0
    while i < iters {
      match brotli::decode_with_limits(data, brotli::DecodeLimits::new(1073741824, 24)) {
        Ok(out) => last = out
        Err(e) => {
          io_println(world, "ERR " + err_name(e))
          return 1
        }
      }
      i = i + 1
    }
    io_println(world, "OK " + last.length().to_string() + " " + fnv64(last).to_string())
    return 0
  }
  2
}
