///| Pion Native head-to-head benchmark for `packages/brotli`.
///| Modes:
///|   decode <br_file> <iters> [dump_path]
///|   batch  <batch_file> <iters>

import "brotli"

///|
fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn fnv1a_64_update(h0 : UInt64, data : Bytes) -> UInt64 {
  let mut h = h0
  let n = data.length()
  let mut i = 0
  while i < n {
    h = (h ^ data[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

///|
fn read_u32_le(b : Bytes, off : Int) -> Int {
  b[off].to_int() |
  (b[off + 1].to_int() << 8) |
  (b[off + 2].to_int() << 16) |
  (b[off + 3].to_int() << 24)
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: brotli_bench <decode|batch> <file> <iters> [dump_path]")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_int(args[3])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }

  if mode == "decode" {
    let mut last_out = Bytes::new(0)
    let mut total_bytes : Int64 = 0L
    let mut i = 0
    while i < iters {
      match brotli::decode(data) {
        Ok(out) => {
          total_bytes = total_bytes + out.length().to_int64()
          last_out = out
        }
        Err(e) => {
          io_println(world, "decode error: " + brotli::brotli_error_message(e))
          return 1
        }
      }
      i = i + 1
    }
    if args.length() >= 5 {
      let _ = fs_write_bytes(world, args[4], last_out)
    }
    let h = fnv1a_64_update(14695981039346656037UL, last_out)
    io_println(
      world,
      "mode=decode iters=" + iters.to_string() +
      " total_bytes=" + total_bytes.to_string() +
      " last_len=" + last_out.length().to_string() +
      " fnv64=" + hex_u64(h),
    )
    return 0
  }

  if mode == "batch" {
    let count = read_u32_le(data, 0)
    let packets : Array[Bytes] = []
    let mut off = 4
    let mut p = 0
    while p < count {
      let plen = read_u32_le(data, off)
      off = off + 4
      packets.push(data.slice(off, off + plen))
      off = off + plen
      p = p + 1
    }
    let mut total_bytes : Int64 = 0L
    let mut total_packets : Int64 = 0L
    let mut last_hash : UInt64 = 14695981039346656037UL
    let mut r = 0
    while r < iters {
      let mut h : UInt64 = 14695981039346656037UL
      let mut idx = 0
      while idx < count {
        match brotli::decode(packets[idx]) {
          Ok(out) => {
            total_bytes = total_bytes + out.length().to_int64()
            total_packets = total_packets + 1L
            if r == iters - 1 {
              h = fnv1a_64_update(h, out)
            }
          }
          Err(e) => {
            io_println(world, "batch decode error: " + brotli::brotli_error_message(e))
            return 1
          }
        }
        idx = idx + 1
      }
      if r == iters - 1 {
        last_hash = h
      }
      r = r + 1
    }
    io_println(
      world,
      "mode=batch iters=" + iters.to_string() +
      " packets=" + total_packets.to_string() +
      " total_bytes=" + total_bytes.to_string() +
      " fnv64=" + hex_u64(last_hash),
    )
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
