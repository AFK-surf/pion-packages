///| RFC 7932 & Google Brotli compliance, edge-case, and security test suite.

///|
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn from_hex(s : String) -> Bytes {
  let n = s.length() / 2
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nibble(s.code_unit_at(i * 2))
    let lo = hex_nibble(s.code_unit_at(i * 2 + 1))
    b[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  b
}

///|
fn assert_decode_str(hex : String, expected : String, label : String) -> Unit {
  match decode(from_hex(hex)) {
    Ok(out) => {
      debug_assert(out.to_string() == expected, label + " content mismatch")
    }
    Err(e) => debug_assert(false, label + " failed: " + brotli_error_message(e))
  }
}

///|
fn assert_decode_err(data : Bytes, label : String) -> Unit {
  match decode(data) {
    Ok(_) => debug_assert(false, label + " unexpectedly succeeded")
    Err(e) => debug_assert(brotli_error_message(e).length() > 0, label + " empty error msg")
  }
}

test "rfc7932: empty streams" {
  // Minimal WBITS=16 empty stream (0x06) and Google brotli default empty stream (0x3b)
  assert_decode_str("06", "", "empty 0x06")
  assert_decode_str("3b", "", "empty 0x3b")
}

test "rfc7932: single byte and hello world" {
  assert_decode_str("0b00806103", "a", "single_a")
  assert_decode_str("8b058068656c6c6f20776f726c640a03", "hello world\n", "hello")
}

test "rfc7932: rle and overlapping back-references" {
  // 1024 zero bytes (dist=1 RLE)
  match decode(from_hex("1bff03f82700a2b1402037")) {
    Ok(out) => {
      debug_assert(out.length() == 1024, "zeros_1024 len")
      let mut i = 0
      while i < 1024 {
        debug_assert(out[i].to_int() == 0, "zeros_1024 byte")
        i = i + 1
      }
    }
    Err(e) => debug_assert(false, "zeros_1024: " + brotli_error_message(e))
  }

  // "ab" * 1000 (dist=2 overlapping copy)
  match decode(from_hex("1bcf07f8a5c2c4c2b230007101")) {
    Ok(out) => {
      debug_assert(out.length() == 2000, "repeat_ab len")
      let mut i = 0
      while i < 2000 {
        let want = if i % 2 == 0 { 97 } else { 98 }
        debug_assert(out[i].to_int() == want, "repeat_ab byte")
        i = i + 1
      }
    }
    Err(e) => debug_assert(false, "repeat_ab: " + brotli_error_message(e))
  }

  // "abc" * 1000 (dist=3 overlapping copy)
  match decode(from_hex("1bb70bf825c3c4c6e2b320e06d004003")) {
    Ok(out) => {
      debug_assert(out.length() == 3000, "repeat_abc len")
      let mut i = 0
      while i < 3000 {
        let m = i % 3
        let want = if m == 0 { 97 } else if m == 1 { 98 } else { 99 }
        debug_assert(out[i].to_int() == want, "repeat_abc byte")
        i = i + 1
      }
    }
    Err(e) => debug_assert(false, "repeat_abc: " + brotli_error_message(e))
  }
}

test "rfc7932: static dictionary and transforms (html + english + url)" {
  let html_hex = "1b5b0140ad0e6cf71664a4e32b9c863d0af456cb4cedf5e9a130333a450557203cf98686573b3e3ab7903b07828ee49cc9d419148c3637759b474fcf6b828e61a521a502161c2c3df41211f8f2c94ba5f712c22fb5e6a31a6f2d02b5e422ccfd5124a0bc9f85636e9da25458b2a836a2c3318ca211b58fee90c3d7d65c0ab7ca0db1fe503ee8cd45d10750a4c16563389707ae05"
  let html_expected = "<!DOCTYPE html><html><head><title>The quick brown fox</title><meta charset=\"UTF-8\"></head><body><div class=\"container\"><h1>Welcome to the website</h1><p>This is a simple example of HTML content with common English words, JavaScript function() { return true; }, and CSS background-color: #ffffff; margin: 10px; padding: 20px;</p></div></body></html>"
  assert_decode_str(html_hex, html_expected, "dict_html")

  let tr_hex = "1b6c01681421c9ec9bc3d68cc28d463159c450840d9646b43a606fe740c228e0805e3f34046d6e1a25449ee783b0e596d8d3a099773f0173f69f178ad772a01a98a01d0d0e13422f50e8cc0b63b061283d448088402c110f29c2924574c048c219b97023257564868f0218a40e14298748aa0293e2ac4f94dd0be72f6666f3c69bd1d5874f57998ce71671b96a920eb1a8c169b413"
  let tr_expected = "The TIME and the Time of Life, first video light world media white close black right small books place music field order point value level table board house group works years state today water start style death power phone night error input about terms title tools event local times. ENGLISH SPANISH FRENCH GERMAN. https://www.example.com/index.html?id=12345&page=1"
  assert_decode_str(tr_hex, tr_expected, "dict_transforms")
}

test "rfc7932: utf8 multibyte and emoji" {
  let utf8_hex = "1b3e02e88cd4510ddbddb476a41b90a5b97db6b42f6a5dbf3b8ffbdeb2727958490a87ac2451ca8107dc4ad1e74688093d661f6cc04964eb3c0cf4b67f3ef5271cff41824d84d051344535eb4bfcd85b5d07c797ce62c719b8de2dc4242d0d891a2475f88644a5d02a99bea2d800"
  let unit = "你好世界！こんにちは世界！안녕하세요! Привет мир! مرحبا بالعالم! 🚀🎉✨"
  let expected = unit + unit + unit + unit + unit
  assert_decode_str(utf8_hex, expected, "utf8_multi")
}

test "rfc7932: uncompressed, metadata, and multi meta-block streams" {
  // Metadata meta-block skipping 4 bytes "META" then empty last meta-block
  assert_decode_str("ac014d45544103", "", "metadata block")

  // Single uncompressed meta-block "HELLO"
  assert_decode_str("40001048454c4c4f03", "HELLO", "uncompressed block")

  // Chained uncompressed meta-blocks "HELLO" + ", WORLD!"
  assert_decode_str(
    "40001048454c4c4f3800082c20574f524c442103",
    "HELLO, WORLD!",
    "multi uncompressed blocks",
  )

  // q=0 incompressible 128-byte sequence
  let q0_hex = "8b3f80135ca5ee3780c9125ba4ed367fc8115aa3ec357ec71059a2eb347dc60f58a1ea337cc50e57a0e9327bc40d569fe8317ac30c559ee73079c20b549de62f78c10a539ce52e77c009529be42d76bf08519ae32c75be075099e22b74bd064f98e12a73bc054e97e02972bb044d96df2871ba034c95de2770b9024b94dd266fb8014a03"
  match decode(from_hex(q0_hex)) {
    Ok(out) => {
      debug_assert(out.length() == 128, "q0_incomp len")
      let mut i = 0
      while i < 128 {
        debug_assert(out[i].to_int() == ((i * 73 + 19) & 255), "q0_incomp byte")
        i = i + 1
      }
    }
    Err(e) => debug_assert(false, "q0_incomp: " + brotli_error_message(e))
  }
}

test "rfc7932: quality levels json and css" {
  let json_hex = "8bfb000080aaaaaaeaff74e7b35eccec263733bb1c0dec20a6260626006a660022aa761150a8c92df8a59ed3e163186080181884ba619e6314f13ed05ccc415b404fd090f0f22320cc45b3208173d55f40d59af4146530522fdfd1e55c5c3c1413adf5662b7ab0f2de3f781903"
  let j = "{\"users\":[{\"id\":1,\"name\":\"Alice\",\"active\":true},{\"id\":2,\"name\":\"Bob\",\"active\":false},{\"id\":3,\"name\":\"Charlie\",\"active\":true}]}"
  assert_decode_str(json_hex, j + j + j + j, "q1_json")

  let css_hex = "1b9d0400c4d0b9fc8cba4c03b9d68d211ee1095f1e017bfa425de781069458c2a381ec6e32011cd40ded76cae7b28985fa68dff89e1a18041223e02dc6c0ab263ef9c0415ba77d09abe650c6d53af61b0736ef86a343e9b2b6c98efab81d1c980b8a563c5455a5f833427ddbf145a54e0045e5fbb57b5100a7fc83a54c26a3d0ed12e4d71df27e2520ed4fc69f1102"
  let c = "body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; color: #333; }\n.btn { display: inline-flex; align-items: center; border-radius: 8px; }\n"
  assert_decode_str(css_hex, c + c + c + c + c + c, "q6_css")
}

test "rfc7932: window sizes w10/w16/w17/w24 and max_window_bits limit" {
  let mut s10 = ""
  let mut s16 = ""
  let mut s17 = ""
  let mut s24 = ""
  let mut i = 0
  while i < 40 {
    s10 = s10 + "window 10 test "
    s16 = s16 + "window 16 test "
    s17 = s17 + "window 17 test "
    s24 = s24 + "window 24 test "
    i = i + 1
  }
  assert_decode_str("a1b8120020b001471ae02b0c7455486f25a4c28007d0e02e00", s10, "w10")
  assert_decode_str("e24a0080c0061c69a0cb68035d15d25b09a930e001a4b80b", s16, "w16")
  assert_decode_str("81b8120020b001471ae834d2405785f456422a0c780029ee02", s17, "w17")
  let w24_bytes = from_hex("1f570200041c72a4076ea106d4ab90de4a4885010f20c55d00")
  match decode(w24_bytes) {
    Ok(out) => debug_assert(out.to_string() == s24, "w24 content")
    Err(e) => debug_assert(false, "w24 failed: " + brotli_error_message(e))
  }
  // Enforce max_window_bits = 20 rejects wbits = 24
  match decode_with_limits(w24_bytes, DecodeLimits::new(1048576, 20)) {
    Err(BrotliError::WindowLimitExceeded(w)) => debug_assert(w == 24, "expected w=24")
    Ok(_) => debug_assert(false, "w24 should exceed max_window_bits=20")
    Err(e) => debug_assert(false, "unexpected error variant: " + brotli_error_message(e))
  }
}

test "security: decompression bomb guard (OutputLimitExceeded)" {
  // 1 MiB of 'A' compressed to 14 bytes
  let bomb = from_hex("5bffff8f5f22281e0b0472ef1f00")
  match decode_with_limits(bomb, DecodeLimits::new(4096, 24)) {
    Err(BrotliError::OutputLimitExceeded(lim)) => debug_assert(lim == 4096, "limit 4096")
    Ok(_) => debug_assert(false, "bomb should have been rejected")
    Err(e) => debug_assert(false, "expected OutputLimitExceeded, got: " + brotli_error_message(e))
  }
  // Exact limit 1048576 succeeds
  match decode_with_limits(bomb, DecodeLimits::new(1048576, 24)) {
    Ok(out) => {
      debug_assert(out.length() == 1048576, "bomb exact len")
      debug_assert(out[0].to_int() == 65 && out[1048575].to_int() == 65, "bomb bytes")
    }
    Err(e) => debug_assert(false, "bomb exact limit failed: " + brotli_error_message(e))
  }
  // Negative limit rejected immediately
  match decode_with_limits(from_hex("06"), DecodeLimits::new(-1, 24)) {
    Err(BrotliError::OutputLimitExceeded(_)) => ()
    _ => debug_assert(false, "negative limit must fail")
  }
}

test "security: malformed, truncated, and trailing bit/byte rejection" {
  // Empty input
  assert_decode_err(Bytes::new(0), "empty input")
  // Non-zero trailing padding bits on empty stream
  match decode(from_hex("86")) {
    Err(BrotliError::InvalidTrailingBits(_)) => ()
    Ok(_) => debug_assert(false, "0x86 must fail")
    Err(e) => debug_assert(false, "0x86 wrong err: " + brotli_error_message(e))
  }
  match decode(from_hex("fb")) {
    Err(BrotliError::InvalidTrailingBits(_)) => ()
    Ok(_) => debug_assert(false, "0xfb must fail")
    Err(e) => debug_assert(false, "0xfb wrong err: " + brotli_error_message(e))
  }
  // Trailing extra byte after stream end
  match decode(from_hex("0600")) {
    Err(BrotliError::TrailingData(n)) => debug_assert(n == 1, "trailing 1 byte")
    Ok(_) => debug_assert(false, "0600 must fail")
    Err(e) => debug_assert(false, "0600 wrong err: " + brotli_error_message(e))
  }
  match decode(from_hex("3b00")) {
    Err(BrotliError::TrailingData(n)) => debug_assert(n == 1, "trailing 1 byte")
    Ok(_) => debug_assert(false, "3b00 must fail")
    Err(e) => debug_assert(false, "3b00 wrong err: " + brotli_error_message(e))
  }
  // Non-zero pad bit before uncompressed meta-block
  assert_decode_err(from_hex("40003048454c4c4f03"), "uncomp non-zero pad")
  // Reserved large window WBITS (1 + 000 + 001 = 0b001_000_1 = 0x11)
  match decode(from_hex("11")) {
    Err(BrotliError::InvalidWindowBits(_)) => ()
    Ok(_) => debug_assert(false, "large window must fail")
    Err(e) => debug_assert(false, "large window wrong err: " + brotli_error_message(e))
  }
  // Truncated hello stream at every prefix
  let hello = from_hex("8b058068656c6c6f20776f726c640a03")
  let mut k = 0
  while k < hello.length() {
    assert_decode_err(hello.slice(0, k), "truncated hello prefix")
    k = k + 1
  }
}
