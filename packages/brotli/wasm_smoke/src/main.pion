///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/brotli`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "brotli"

///|
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn from_hex(s : String) -> Bytes {
  let n = s.length() / 2
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nibble(s.code_unit_at(i * 2))
    let lo = hex_nibble(s.code_unit_at(i * 2 + 1))
    b[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  b
}

///|
fn fnv1a_32(data : Bytes) -> UInt {
  let mut h : UInt = 2166136261U
  let mut i = 0
  let n = data.length()
  while i < n {
    h = (h ^ data[i].to_int().to_uint()) * 16777619U
    i = i + 1
  }
  h
}

///|
pub fn main(world : World) -> Int {
  // 1. Empty stream
  let out_empty = match brotli::decode(from_hex("3b")) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR empty: " + brotli::brotli_error_message(e))
      return 1
    }
  }
  if out_empty.length() != 0 {
    return 2
  }

  // 2. Hello world
  let out_hello = match brotli::decode(from_hex("8b058068656c6c6f20776f726c640a03")) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR hello: " + brotli::brotli_error_message(e))
      return 3
    }
  }

  // 3. Static dictionary + transforms HTML vector
  let html_hex = "1b5b0140ad0e6cf71664a4e32b9c863d0af456cb4cedf5e9a130333a450557203cf98686573b3e3ab7903b07828ee49cc9d419148c3637759b474fcf6b828e61a521a502161c2c3df41211f8f2c94ba5f712c22fb5e6a31a6f2d02b5e422ccfd5124a0bc9f85636e9da25458b2a836a2c3318ca211b58fee90c3d7d65c0ab7ca0db1fe503ee8cd45d10750a4c16563389707ae05"
  let out_html = match brotli::decode(from_hex(html_hex)) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR html: " + brotli::brotli_error_message(e))
      return 4
    }
  }

  // 4. RLE + overlapping copy (3000 bytes "abc" * 1000)
  let out_abc = match brotli::decode(from_hex("1bb70bf825c3c4c6e2b320e06d004003")) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR abc: " + brotli::brotli_error_message(e))
      return 5
    }
  }

  // 5. Multi uncompressed meta-block
  let out_multi = match brotli::decode(from_hex("40001048454c4c4f3800082c20574f524c442103")) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR multi: " + brotli::brotli_error_message(e))
      return 6
    }
  }

  // 6. Bomb guard rejection check
  let bomb_rejected = match brotli::decode_with_limits(
    from_hex("5bffff8f5f22281e0b0472ef1f00"),
    brotli::DecodeLimits::new(4096, 24),
  ) {
    Err(brotli::BrotliError::OutputLimitExceeded(4096)) => true
    _ => false
  }
  if !bomb_rejected {
    return 7
  }

  // 7. Trailing bit rejection check
  let trailing_rejected = match brotli::decode(from_hex("86")) {
    Err(brotli::BrotliError::InvalidTrailingBits(_)) => true
    _ => false
  }
  if !trailing_rejected {
    return 8
  }

  io_println(world, "brotli_wasm_smoke:ok")
  io_println(world, "hello=" + out_hello.to_string())
  io_println(world, "multi=" + out_multi.to_string())
  io_println(
    world,
    "html_len=" + out_html.length().to_string() +
    " html_fnv=" + fnv1a_32(out_html).to_int64().to_string(),
  )
  io_println(
    world,
    "abc_len=" + out_abc.length().to_string() +
    " abc_fnv=" + fnv1a_32(out_abc).to_int64().to_string(),
  )
  0
}
