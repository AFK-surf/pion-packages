///| Pion Native head-to-head benchmark for `packages/rtp`.
///| Modes:
///|   rtp      <iters>
///|   rtcp     <iters>
///|   srtp_cm  <iters>
///|   srtp_gcm <iters>

import "rtp"
import "crypto"

///|
fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn must_hex(s : String) -> Bytes {
  match crypto::hex_to_bytes(s) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///|
fn make_payload(len : Int) -> Bytes {
  let b = Bytes::new(len)
  let mut i = 0
  while i < len {
    b[i] = ((i * 31 + 17) & 0xFF).to_byte()
    i = i + 1
  }
  b
}

///|
fn slice_bytes(b : Bytes, start : Int, end : Int) -> Bytes {
  let n = end - start
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = b[start + i]
    i = i + 1
  }
  out
}

///|
fn bench_rtp(world : World, iters : Int) -> Int {
  let pkt = rtp::RtpPacket::{
    header: rtp::RtpHeader::{
      version: 2,
      padding: false,
      extension: true,
      marker: true,
      payload_type: 96,
      sequence_number: 1000,
      timestamp: 90000U,
      ssrc: 0x11223344U,
      csrcs: [],
      extension_profile: 0xBEDE,
      extensions: [
        rtp::HeaderExtension::{ id: 1, payload: must_hex("30") },
        rtp::HeaderExtension::{ id: 2, payload: must_hex("123456") },
        rtp::HeaderExtension::{ id: 3, payload: must_hex("0042") },
      ],
      raw_extension_payload: Bytes::new(0),
    },
    payload: make_payload(1172),
    padding_size: 0,
  }
  let wire = match rtp::marshal_rtp(pkt) {
    Ok(b) => b
    Err(_) => return 1
  }
  let mut acc : UInt64 = 0UL
  let mut last_wire = wire
  let mut i = 0
  while i < iters {
    let dec = match rtp::parse_rtp(wire) {
      Ok(p) => p
      Err(_) => return 2
    }
    acc = acc +
    dec.header.sequence_number.to_int64().to_uint64() +
    dec.header.timestamp.to_uint64() +
    dec.header.ssrc.to_uint64() +
    dec.header.extensions.length().to_int64().to_uint64() +
    dec.payload.length().to_int64().to_uint64() +
    dec.payload[0].to_int().to_int64().to_uint64() +
    dec.payload[dec.payload.length() - 1].to_int().to_int64().to_uint64()
    let enc = match rtp::marshal_rtp(dec) {
      Ok(b) => b
      Err(_) => return 3
    }
    acc = acc +
    enc.length().to_int64().to_uint64() +
    enc[2].to_int().to_int64().to_uint64() +
    enc[enc.length() - 1].to_int().to_int64().to_uint64()
    last_wire = enc
    i = i + 1
  }
  io_println(
    world,
    "rtp iters=" + iters.to_string() +
    " acc=" + acc.to_string() +
    " head=" + crypto::bytes_to_hex(slice_bytes(last_wire, 0, 32)),
  )
  0
}

///|
fn bench_rtcp(world : World, iters : Int) -> Int {
  let compound = [
    rtp::RtcpPacket::Sr(rtp::SenderReport::{
      ssrc: 0x11223344U,
      ntp_time: 0xE5A1B2C300001234UL,
      rtp_time: 90000U,
      packet_count: 1500U,
      octet_count: 1800000U,
      reports: [
        rtp::ReceptionReport::{
          ssrc: 0x55667788U,
          fraction_lost: 12,
          total_lost: 3,
          last_seq: 65541U,
          jitter: 42U,
          last_sr: 0xAABBCCDDU,
          delay_since_last_sr: 65536U,
        },
      ],
      profile_extensions: Bytes::new(0),
    }),
    rtp::RtcpPacket::Pli(rtp::PictureLossIndication::{
      sender_ssrc: 0x55667788U,
      media_ssrc: 0x11223344U,
    }),
    rtp::RtcpPacket::Nack(rtp::TransportLayerNack::{
      sender_ssrc: 0x55667788U,
      media_ssrc: 0x11223344U,
      nacks: [rtp::NackPair::{ packet_id: 1000, lost_packets: 0x0005 }],
    }),
  ]
  let wire = match rtp::marshal_rtcp(compound) {
    Ok(b) => b
    Err(_) => return 1
  }
  let mut acc : UInt64 = 0UL
  let mut last_wire = wire
  let mut i = 0
  while i < iters {
    let dec = match rtp::parse_rtcp(wire) {
      Ok(ps) => ps
      Err(_) => return 2
    }
    let enc = match rtp::marshal_rtcp(dec) {
      Ok(b) => b
      Err(_) => return 3
    }
    acc = acc +
    dec.length().to_int64().to_uint64() +
    enc.length().to_int64().to_uint64() +
    enc[0].to_int().to_int64().to_uint64() +
    enc[enc.length() - 1].to_int().to_int64().to_uint64()
    last_wire = enc
    i = i + 1
  }
  io_println(
    world,
    "rtcp iters=" + iters.to_string() +
    " acc=" + acc.to_string() +
    " wire=" + crypto::bytes_to_hex(last_wire),
  )
  0
}

///|
fn bench_srtp(world : World, profile : rtp::ProtectionProfile, label : String, iters : Int) -> Int {
  let mk = must_hex("e1f97a0d3e018be0d64fa32c06de4139")
  let ms = match profile {
    rtp::ProtectionProfile::AeadAes128Gcm => must_hex("517569642070726f2071756f")
    _ => must_hex("0ec675ad498afeebb6960b3aabe6")
  }
  let tx = match rtp::SrtpContext::new(profile, mk, ms) {
    Ok(c) => c
    Err(_) => return 1
  }
  let rx = match rtp::SrtpContext::new(profile, mk, ms) {
    Ok(c) => c
    Err(_) => return 2
  }
  let base_pkt = Bytes::new(1200)
  base_pkt[0] = 0x80.to_byte()
  base_pkt[1] = 0x60.to_byte()
  base_pkt[4] = 0x00.to_byte()
  base_pkt[5] = 0x01.to_byte()
  base_pkt[6] = 0x5F.to_byte()
  base_pkt[7] = 0x90.to_byte()
  base_pkt[8] = 0x11.to_byte()
  base_pkt[9] = 0x22.to_byte()
  base_pkt[10] = 0x33.to_byte()
  base_pkt[11] = 0x44.to_byte()
  let mut k = 12
  while k < 1200 {
    base_pkt[k] = (((k - 12) * 31 + 17) & 0xFF).to_byte()
    k = k + 1
  }

  let mut acc : UInt64 = 0UL
  let mut last_enc = Bytes::new(0)
  let mut i = 0
  while i < iters {
    let seq = (i + 1) & 0xFFFF
    base_pkt[2] = ((seq >> 8) & 0xFF).to_byte()
    base_pkt[3] = (seq & 0xFF).to_byte()
    let enc = match tx.encrypt_rtp(base_pkt) {
      Ok(b) => b
      Err(_) => return 3
    }
    let dec = match rx.decrypt_rtp(enc) {
      Ok(b) => b
      Err(_) => return 4
    }
    acc = acc +
    enc.length().to_int64().to_uint64() +
    dec.length().to_int64().to_uint64() +
    dec[12].to_int().to_int64().to_uint64() +
    dec[dec.length() - 1].to_int().to_int64().to_uint64()
    last_enc = enc
    i = i + 1
  }
  let tail = slice_bytes(last_enc, last_enc.length() - 24, last_enc.length())
  io_println(
    world,
    label + " iters=" + iters.to_string() +
    " acc=" + acc.to_string() +
    " tail=" + crypto::bytes_to_hex(tail),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: rtp_bench <rtp|rtcp|srtp_cm|srtp_gcm> <iters>")
    return 1
  }
  let mode = args[1]
  let iters = parse_int(args[2])
  if mode == "rtp" {
    bench_rtp(world, iters)
  } else if mode == "rtcp" {
    bench_rtcp(world, iters)
  } else if mode == "srtp_cm" {
    bench_srtp(world, rtp::ProtectionProfile::Aes128CmHmacSha1_80, "srtp_cm", iters)
  } else if mode == "srtp_gcm" {
    bench_srtp(world, rtp::ProtectionProfile::AeadAes128Gcm, "srtp_gcm", iters)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
