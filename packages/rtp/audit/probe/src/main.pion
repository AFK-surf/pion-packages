///| Pion-side driver of the packages/rtp red-team audit (Native and wasm32).
///|   probe gen                  -> interop cases encrypted by packages/rtp (stdout)
///|   probe verify <cases.txt>   -> decrypt webrtc-rs cases, re-encrypt + byte-compare, codec check
///|   probe fuzz <corpus.txt>    -> one verdict line per corpus line (same format as rtp_oracle)
///|   probe dos-ssrc <n>         -> n forged SRTP packets with distinct SSRCs, then 10k genuine
///|   probe dos-rtcp <n>         -> parse a maximal 256 KiB compound RTCP n times
///|   probe dos-ext <n>          -> parse a maximal 256 KiB header-extension RTP packet n times

import "rtp"
import "crypto"
import "rtp_audit"

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///|
fn unhex_range(d : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(if n < 0 { 0 } else { n })
  let mut i = 0
  while i < n {
    out[i] = ((hexval(d[start + 2 * i].to_int() & 0xFF) << 4) | hexval(d[start + 2 * i + 1].to_int() & 0xFF)).to_byte()
    i = i + 1
  }
  out
}

///|
fn str_range(d : Bytes, start : Int, end : Int) -> String {
  let out = Bytes::new(end - start)
  let mut i = start
  while i < end {
    out[i - start] = d[i]
    i = i + 1
  }
  out.to_string()
}

///| Split a line [start,end) on spaces into (start,end) field ranges.
fn fields(d : Bytes, start : Int, end : Int) -> Array[(Int, Int)] {
  let out : Array[(Int, Int)] = []
  let mut s = start
  let mut i = start
  while i <= end {
    if i == end || d[i].to_int() == 32 {
      if i > s {
        out.push((s, i))
      }
      s = i + 1
    }
    i = i + 1
  }
  out
}

///|
fn lines(d : Bytes) -> Array[(Int, Int)] {
  let out : Array[(Int, Int)] = []
  let mut s = 0
  let mut i = 0
  let n = d.length()
  while i <= n {
    if i == n || d[i].to_int() == 10 {
      if i > s {
        out.push((s, i))
      }
      s = i + 1
    }
    i = i + 1
  }
  out
}

///|
fn prof(name : String) -> rtp::ProtectionProfile {
  if name == "cm80" {
    rtp::ProtectionProfile::Aes128CmHmacSha1_80
  } else if name == "cm32" {
    rtp::ProtectionProfile::Aes128CmHmacSha1_32
  } else {
    rtp::ProtectionProfile::AeadAes128Gcm
  }
}

///|
fn ctx(name : String) -> rtp::SrtpContext {
  rtp_audit::new_ctx(prof(name))
}

///|
fn ext_pkt(seq : Int, ssrc : UInt, profile : Int, exts : Array[rtp::HeaderExtension], payload : Bytes, csrcs : Array[UInt], pad : Int) -> Bytes {
  let h = rtp::RtpHeader::{
    ..rtp_audit::rtp_hdr(seq, ssrc),
    timestamp: (90000 + seq).to_uint(),
    marker: true,
    padding: pad > 0,
    csrcs: csrcs,
    extension: true,
    extension_profile: profile,
    extensions: exts,
  }
  match rtp::marshal_rtp(rtp::RtpPacket::{ header: h, payload: payload, padding_size: pad }) {
    Ok(b) => b
    Err(e) => abort(rtp::rtp_error_message(e))
  }
}

///|
fn plain_rtp(seq : Int, ssrc : UInt, payload : Bytes) -> Bytes {
  let h = rtp::RtpHeader::{ ..rtp_audit::rtp_hdr(seq, ssrc), timestamp: (90000 + seq).to_uint() }
  match rtp::marshal_rtp(rtp::RtpPacket::{ header: h, payload: payload, padding_size: 0 }) {
    Ok(b) => b
    Err(e) => abort(rtp::rtp_error_message(e))
  }
}

///|
fn rtcp_of(pkts : Array[rtp::RtcpPacket]) -> Bytes {
  match rtp::marshal_rtcp(pkts) {
    Ok(b) => b
    Err(e) => abort(rtp::rtp_error_message(e))
  }
}

///| (case, profile, kind, plaintext)
fn pion_cases() -> Array[(String, String, String, Bytes)] {
  let out : Array[(String, String, String, Bytes)] = []
  let ps = ["cm80", "cm32", "gcm"]
  let mut pi = 0
  while pi < ps.length() {
    let p = ps[pi]
    let mut s = 1
    while s <= 5 {
      out.push(("pn_simple_" + p, p, "rtp", plain_rtp(s, 0x11111111U, rtp_audit::filled(160, s))))
      s = s + 1
    }
    out.push(
      (
        "pn_ext1_" + p,
        p,
        "rtp",
        ext_pkt(
          100,
          0x22222222U,
          0xBEDE,
          [
            rtp::HeaderExtension::{ id: 1, payload: rtp_audit::hx("30") },
            rtp::HeaderExtension::{ id: 3, payload: rtp_audit::hx("010203") },
            rtp::HeaderExtension::{ id: 14, payload: rtp_audit::filled(16, 9) },
          ],
          rtp_audit::filled(300, 3),
          [0x01020304U, 0x05060708U],
          0,
        ),
      ),
    )
    out.push(
      (
        "pn_ext2_" + p,
        p,
        "rtp",
        ext_pkt(
          101,
          0x22222222U,
          0x1000,
          [
            rtp::HeaderExtension::{ id: 200, payload: rtp_audit::filled(40, 1) },
            rtp::HeaderExtension::{ id: 2, payload: Bytes::new(0) },
            rtp::HeaderExtension::{ id: 7, payload: rtp_audit::filled(255, 2) },
          ],
          rtp_audit::filled(50, 4),
          [],
          0,
        ),
      ),
    )
    // padding (RFC 3550 §5.1) + 15 CSRCs
    let cs : Array[UInt] = []
    let mut ci = 0
    while ci < 15 {
      cs.push((0x10000000 + ci).to_uint())
      ci = ci + 1
    }
    out.push(("pn_pad_csrc15_" + p, p, "rtp", ext_pkt(102, 0x22222222U, 0xBEDE, [rtp::HeaderExtension::{ id: 5, payload: rtp_audit::hx("aabb") }], rtp_audit::filled(77, 5), cs, 3)))
    let seqs = [65530, 65531, 65532, 65533, 65534, 65535, 1, 0, 2, 3, 4, 5]
    let mut si = 0
    while si < seqs.length() {
      out.push(("pn_rocwrap_" + p, p, "rtp", plain_rtp(seqs[si], 0x33333333U, rtp_audit::filled(100, seqs[si]))))
      si = si + 1
    }
    out.push(("pn_big_" + p, p, "rtp", plain_rtp(7, 0x44444444U, rtp_audit::filled(5000, 1))))
    out.push(("pn_empty_" + p, p, "rtp", plain_rtp(8, 0x44444444U, Bytes::new(0))))
    let rr = rtp::ReceptionReport::{
      ssrc: 0xabcdef01U,
      fraction_lost: 25,
      total_lost: -16,
      last_seq: 0x10001U,
      jitter: 77U,
      last_sr: 5U,
      delay_since_last_sr: 6U,
    }
    out.push(
      (
        "pn_rtcp_sr_sdes_bye_" + p,
        p,
        "rtcp",
        rtcp_of([
          rtp::RtcpPacket::Sr(rtp::SenderReport::{
            ssrc: 0x55555555U,
            ntp_time: 0x0102030405060708UL,
            rtp_time: 9U,
            packet_count: 10U,
            octet_count: 11U,
            reports: [rr],
            profile_extensions: Bytes::new(0),
          }),
          rtp::RtcpPacket::Sdes(rtp::SourceDescription::{
            chunks: [rtp::SdesChunk::{ ssrc: 0x55555555U, items: [rtp::SdesItem::{ item_type: 1, text: rtp_audit::hx("61756469744070696f6e") }] }],
          }),
          rtp::RtcpPacket::Bye(rtp::Goodbye::{ sources: [0x55555555U], reason: rtp_audit::hx("627965") }),
        ]),
      ),
    )
    out.push(
      (
        "pn_rtcp_rr_fb_" + p,
        p,
        "rtcp",
        rtcp_of([
          rtp::RtcpPacket::Rr(rtp::ReceiverReport::{ ssrc: 0x55555555U, reports: [rr, rr], profile_extensions: Bytes::new(0) }),
          rtp::RtcpPacket::Nack(rtp::TransportLayerNack::{
            sender_ssrc: 0x55555555U,
            media_ssrc: 0x11111111U,
            nacks: [rtp::NackPair::{ packet_id: 65535, lost_packets: 0x8001 }],
          }),
          rtp::RtcpPacket::Pli(rtp::PictureLossIndication::{ sender_ssrc: 0x55555555U, media_ssrc: 0x11111111U }),
          rtp::RtcpPacket::Fir(rtp::FullIntraRequest::{
            sender_ssrc: 0x55555555U,
            media_ssrc: 0U,
            entries: [rtp::FirEntry::{ ssrc: 0x11111111U, sequence_number: 42 }],
          }),
          rtp::RtcpPacket::Remb(rtp::ReceiverEstimatedMaximumBitrate::{
            sender_ssrc: 0x55555555U,
            media_ssrc: 0U,
            bitrate: 2500000UL,
            ssrcs: [0x11111111U, 0x22222222U],
          }),
        ]),
      ),
    )
    let mut i = 0
    while i < 70 {
      out.push(
        (
          "pn_rtcp_many_" + p,
          p,
          "rtcp",
          rtcp_of([rtp::RtcpPacket::Pli(rtp::PictureLossIndication::{ sender_ssrc: 0x66666666U, media_ssrc: i.to_uint() })]),
        ),
      )
      i = i + 1
    }
    pi = pi + 1
  }
  out
}

///|
fn find_ctx(names : Array[String], ctxs : Array[rtp::SrtpContext], name : String, p : String) -> rtp::SrtpContext {
  let mut i = 0
  while i < names.length() {
    if names[i] == name {
      return ctxs[i]
    }
    i = i + 1
  }
  let c = ctx(p)
  names.push(name)
  ctxs.push(c)
  c
}

///|
fn gen(world : World) -> Int {
  let cs = pion_cases()
  let names : Array[String] = []
  let ctxs : Array[rtp::SrtpContext] = []
  let sb = StringBuilder::new()
  let mut i = 0
  while i < cs.length() {
    let (case, p, kind, plain) = cs[i]
    let c = find_ctx(names, ctxs, case, p)
    let r = if kind == "rtp" { c.encrypt_rtp(plain) } else { c.encrypt_rtcp(plain) }
    let w = match r {
      Ok(b) => b
      Err(e) => abort(rtp::rtp_error_message(e))
    }
    sb.write_string(case + " " + p + " " + kind + " " + rtp_audit::to_hex(plain) + " " + rtp_audit::to_hex(w) + "\n")
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

///|
fn codec_check(kind : String, plain : Bytes) -> String {
  if kind == "rtp" {
    match rtp::parse_rtp(plain) {
      Ok(p) =>
      match rtp::marshal_rtp(p) {
        Ok(m) => if rtp_audit::to_hex(m) == rtp_audit::to_hex(plain) { "CODEC_OK" } else { "CODEC_DIFF" }
        Err(_) => "CODEC_DIFF"
      }
      Err(_) => "CODEC_REJECT"
    }
  } else {
    match rtp::parse_rtcp(plain) {
      Ok(v) =>
      match rtp::marshal_rtcp(v) {
        Ok(m) => if rtp_audit::to_hex(m) == rtp_audit::to_hex(plain) { "CODEC_OK" } else { "CODEC_DIFF" }
        Err(_) => "CODEC_DIFF"
      }
      Err(_) => "CODEC_REJECT"
    }
  }
}

///|
fn sanitize(s : String) -> String {
  let out = Bytes::new(s.length())
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    out[i] = (if c == 32 { 95 } else { c & 0x7F }).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
fn verify(world : World, path : String) -> Int {
  let d = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => return 1
  }
  let dn : Array[String] = []
  let dc : Array[rtp::SrtpContext] = []
  let en : Array[String] = []
  let ec : Array[rtp::SrtpContext] = []
  let cn : Array[String] = []
  let cnt : Array[Int] = []
  let sb = StringBuilder::new()
  let ls = lines(d)
  let mut li = 0
  while li < ls.length() {
    let (ls0, ls1) = ls[li]
    let f = fields(d, ls0, ls1)
    li = li + 1
    if f.length() != 5 {
      continue
    }
    let case = str_range(d, f[0].0, f[0].1)
    let p = str_range(d, f[1].0, f[1].1)
    let kind = str_range(d, f[2].0, f[2].1)
    let plain = unhex_range(d, f[3].0, f[3].1)
    let wire = unhex_range(d, f[4].0, f[4].1)
    let mut idx = 0
    let mut found = -1
    let mut k = 0
    while k < cn.length() {
      if cn[k] == case {
        found = k
      }
      k = k + 1
    }
    if found < 0 {
      cn.push(case)
      cnt.push(0)
      found = cn.length() - 1
    }
    idx = cnt[found]
    cnt[found] = idx + 1
    let dctx = find_ctx(dn, dc, case, p)
    let r = if kind == "rtp" { dctx.decrypt_rtp(wire) } else { dctx.decrypt_rtcp(wire) }
    let dv = match r {
      Ok(b) => if rtp_audit::to_hex(b) == rtp_audit::to_hex(plain) { "DEC_OK" } else { "DEC_WRONG_PLAINTEXT" }
      Err(e) => "DEC_FAIL(" + sanitize(rtp::rtp_error_message(e)) + ")"
    }
    let ectx = find_ctx(en, ec, case, p)
    let r2 = if kind == "rtp" { ectx.encrypt_rtp(plain) } else { ectx.encrypt_rtcp(plain) }
    let ev = match r2 {
      Ok(b) => if rtp_audit::to_hex(b) == rtp_audit::to_hex(wire) { "ENC_EQ" } else { "ENC_DIFF" }
      Err(_) => "ENC_ERR"
    }
    sb.write_string(case + " " + idx.to_string() + " " + kind + " " + dv + " " + ev + " " + codec_check(kind, plain) + "\n")
  }
  io_print(world, sb.to_string())
  0
}

///|
fn verdict(kind : String, data : Bytes) -> String {
  if kind == "rtp" {
    match rtp::parse_rtp(data) {
      Ok(p) => {
        let h = p.header
        let ne = if h.extension && h.extension_profile != 0xBEDE && (h.extension_profile & 0xFFF0) != 0x1000 {
          1
        } else {
          h.extensions.length()
        }
        "OK seq=" + h.sequence_number.to_string() + " ts=" + h.timestamp.to_string() + " ssrc=" +
        h.ssrc.to_string() + " pt=" + h.payload_type.to_string() + " m=" + (if h.marker { "1" } else { "0" }) +
        " cc=" + h.csrcs.length().to_string() + " x=" + (if h.extension { "1" } else { "0" }) + " prof=" +
        h.extension_profile.to_string() + " ne=" + ne.to_string() + " pl=" + p.payload.length().to_string()
      }
      Err(_) => "ERR"
    }
  } else if kind == "rtcp" {
    match rtp::parse_rtcp(data) {
      Ok(v) => {
        let sb = StringBuilder::new()
        sb.write_string("OK ")
        let mut i = 0
        while i < v.length() {
          if i > 0 {
            sb.write_string(",")
          }
          let pc = match v[i] {
            rtp::RtcpPacket::Sr(x) => "200/" + x.reports.length().to_string()
            rtp::RtcpPacket::Rr(x) => "201/" + x.reports.length().to_string()
            rtp::RtcpPacket::Sdes(x) => "202/" + x.chunks.length().to_string()
            rtp::RtcpPacket::Bye(x) => "203/" + x.sources.length().to_string()
            rtp::RtcpPacket::Nack(_) => "205/1"
            rtp::RtcpPacket::Twcc(_) => "205/15"
            rtp::RtcpPacket::Pli(_) => "206/1"
            rtp::RtcpPacket::Fir(_) => "206/4"
            rtp::RtcpPacket::Remb(_) => "206/15"
            rtp::RtcpPacket::Unknown(x) => x.packet_type.to_string() + "/" + x.count.to_string()
          }
          sb.write_string(pc)
          i = i + 1
        }
        sb.to_string()
      }
      Err(_) => "ERR"
    }
  } else {
    let ps = ["cm80", "gcm"]
    let sb = StringBuilder::new()
    let mut i = 0
    while i < ps.length() {
      if i > 0 {
        sb.write_string(" ")
      }
      let c = ctx(ps[i])
      let r = if kind == "srtp" { c.decrypt_rtp(data) } else { c.decrypt_rtcp(data) }
      match r {
        Ok(b) => sb.write_string(ps[i] + ":OK:" + rtp_audit::to_hex(b))
        Err(_) => sb.write_string(ps[i] + ":ERR")
      }
      i = i + 1
    }
    sb.to_string()
  }
}

///|
fn fuzz(world : World, path : String) -> Int {
  let d = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => return 1
  }
  let sb = StringBuilder::new()
  let ls = lines(d)
  let mut li = 0
  while li < ls.length() {
    let (s, e) = ls[li]
    let mut sp = s
    while sp < e && d[sp].to_int() != 32 {
      sp = sp + 1
    }
    let kind = str_range(d, s, sp)
    let data = unhex_range(d, if sp < e { sp + 1 } else { e }, e)
    sb.write_string(kind + " " + verdict(kind, data) + "\n")
    li = li + 1
  }
  io_print(world, sb.to_string())
  0
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i).to_int() - 48)
    i = i + 1
  }
  v
}

///|
fn dos_ssrc(world : World, n : Int) -> Int {
  let tx = ctx("cm80")
  let rx = ctx("cm80")
  let mut i = 0
  while i < n {
    let f = plain_rtp(i & 0xFFFF, (0x01000000 + i).to_uint(), rtp_audit::filled(32, 1))
    let g = Bytes::new(f.length() + 10)
    let mut j = 0
    while j < f.length() {
      g[j] = f[j]
      j = j + 1
    }
    let _ = rx.decrypt_rtp(g)
    i = i + 1
  }
  let mut ok = 0
  let mut s = 0
  while s < 10000 {
    match tx.encrypt_rtp(plain_rtp(s & 0xFFFF, 0x00ABCDEFU, rtp_audit::filled(32, 2))) {
      Ok(w) => if rtp_audit::is_ok(rx.decrypt_rtp(w)) { ok = ok + 1 }
      Err(_) => ()
    }
    s = s + 1
  }
  io_println(world, "pion forged=" + n.to_string() + " genuine_ok=" + ok.to_string())
  0
}

///| Maximal compound: 64 FIR packets (max_rtcp_packets default) totalling ~256 KiB, i.e. the
///| largest input DecodeLimits::default() lets through (FIR entries are not bounded by any limit).
fn dos_rtcp(world : World, n : Int) -> Int {
  let entries : Array[rtp::FirEntry] = []
  let mut i = 0
  while i < 510 {
    entries.push(rtp::FirEntry::{ ssrc: i.to_uint(), sequence_number: i & 0xFF })
    i = i + 1
  }
  let pkts : Array[rtp::RtcpPacket] = []
  i = 0
  while i < 64 {
    pkts.push(rtp::RtcpPacket::Fir(rtp::FullIntraRequest::{ sender_ssrc: 1U, media_ssrc: 2U, entries: entries }))
    i = i + 1
  }
  let wire = rtcp_of(pkts)
  let mut total = 0
  let mut r = 0
  while r < n {
    match rtp::parse_rtcp(wire) {
      Ok(v) => {
        let mut k = 0
        while k < v.length() {
          match v[k] {
            rtp::RtcpPacket::Fir(f) => total = total + f.entries.length()
            _ => ()
          }
          k = k + 1
        }
      }
      Err(e) => abort(rtp::rtp_error_message(e))
    }
    r = r + 1
  }
  io_println(world, "pion rtcp_bytes=" + wire.length().to_string() + " iters=" + n.to_string() + " fir_entries=" + total.to_string())
  0
}

///| Largest header-extension block parse_rtp's limits can be opened to (raised limits):
///| 65535-word one-byte block made of 1-byte elements.
fn dos_ext(world : World, n : Int) -> Int {
  let p = Bytes::new(12 + 4 + 65535 * 4 + 4)
  p[0] = 0x90.to_byte()
  p[1] = 0x60.to_byte()
  p[12] = 0xBE.to_byte()
  p[13] = 0xDE.to_byte()
  p[14] = 0xFF.to_byte()
  p[15] = 0xFF.to_byte()
  let mut i = 16
  while i < 16 + 65535 * 4 {
    p[i] = 0x10.to_byte() // id 1, len 1
    i = i + 1
  }
  let lim = rtp::DecodeLimits::{
    ..rtp::DecodeLimits::default(),
    max_extensions: 1000000,
    max_extension_bytes: 1000000,
  }
  let mut total = 0
  let mut r = 0
  while r < n {
    match rtp::parse_rtp_with_limits(p, lim) {
      Ok(pk) => total = total + pk.header.extensions.length()
      Err(e) => abort(rtp::rtp_error_message(e))
    }
    r = r + 1
  }
  let dflt = match rtp::parse_rtp(p) {
    Ok(_) => "accepted"
    Err(e) => "rejected(" + sanitize(rtp::rtp_error_message(e)) + ")"
  }
  io_println(world, "pion ext_bytes=" + (65535 * 4).to_string() + " iters=" + n.to_string() + " extensions=" + total.to_string() + " default_limits=" + dflt)
  0
}

///|
pub fn main(world : World) -> Int {
  let a = world_args(world)
  if a.length() < 2 {
    io_eprintln(world, "usage: probe gen|verify <f>|fuzz <f>|dos-ssrc <n>|dos-rtcp <n>|dos-ext <n>")
    return 2
  }
  let m = a[1]
  if m == "gen" {
    gen(world)
  } else if m == "verify" {
    verify(world, a[2])
  } else if m == "fuzz" {
    fuzz(world, a[2])
  } else if m == "dos-ssrc" {
    dos_ssrc(world, parse_int(a[2]))
  } else if m == "dos-rtcp" {
    dos_rtcp(world, parse_int(a[2]))
  } else if m == "dos-ext" {
    dos_ext(world, parse_int(a[2]))
  } else {
    2
  }
}
