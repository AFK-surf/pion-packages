///| White-box audit tests for packages/rtp. run_audit.sh copies ../../src/*.pion together with this
///| file into a throw-away package under $WORK (the audited sources are never modified) so the
///| tests can reach private primitives (aes128_*, ghash) and private SrtpContext state.
///| `wb_control_*` MUST PASS; `wb_redteam_*` assert the secure behaviour and are expected to FAIL
///| on dfd410cd (each failure = confirmed finding, see ../README.md).

import "crypto"

///|
fn wck(cond : Bool, msg : String) -> Unit {
  debug_assert(cond, msg)
}

///|
fn whx(s : String) -> Bytes {
  match crypto::hex_to_bytes(s) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///|
fn arr12(b : Bytes) -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(12, 0)
  let mut i = 0
  while i < 12 {
    a[i] = b[i].to_int() & 0xFF
    i = i + 1
  }
  a
}

///|
fn gcm_encrypt(key : Bytes, iv : Bytes, aad : Bytes, pt : Bytes) -> String {
  let k = aes128_expand_key(key)
  let tbl = ghash_table_new(k)
  let iv12 = arr12(iv)
  let ct = Bytes::new(pt.length())
  aes128_gcm_crypt_into(k, iv12, pt, 0, pt.length(), ct, 0)
  let tag = aes128_gcm_tag(k, tbl, iv12, aad, 0, aad.length(), ct, 0, ct.length())
  crypto::bytes_to_hex(ct) + ":" + crypto::bytes_to_hex(tag)
}

///|
fn wctx(profile : ProtectionProfile) -> SrtpContext {
  let salt = match profile {
    ProtectionProfile::AeadAes128Gcm => whx("517569642070726f2071756f")
    _ => whx("0ec675ad498afeebb6960b3aabe6")
  }
  match SrtpContext::new(profile, whx("e1f97a0d3e018be0d64fa32c06de4139"), salt) {
    Ok(c) => c
    Err(_) => abort("ctx")
  }
}

///|
fn wrtp(seq : Int, ssrc : UInt, fill : Int) -> Bytes {
  let p = Bytes::new(12 + 32)
  p[0] = 0x80.to_byte()
  p[1] = 0x60.to_byte()
  p[2] = ((seq >> 8) & 0xFF).to_byte()
  p[3] = (seq & 0xFF).to_byte()
  p[8] = ((ssrc >> 24U) & 0xFFU).to_int().to_byte()
  p[9] = ((ssrc >> 16U) & 0xFFU).to_int().to_byte()
  p[10] = ((ssrc >> 8U) & 0xFFU).to_int().to_byte()
  p[11] = (ssrc & 0xFFU).to_int().to_byte()
  let mut i = 12
  while i < p.length() {
    p[i] = ((fill + i) & 0xFF).to_byte()
    i = i + 1
  }
  p
}

///| FIPS 197 Appendix C.1 AES-128 and Appendix B (key expansion example) vectors.
test "wb_control_fips197_aes128_vectors" {
  let k = aes128_expand_key(whx("000102030405060708090a0b0c0d0e0f"))
  let src : FixedArray[Int] = FixedArray::make(16, 0)
  let dst : FixedArray[Int] = FixedArray::make(16, 0)
  let pt = whx("00112233445566778899aabbccddeeff")
  let mut i = 0
  while i < 16 {
    src[i] = pt[i].to_int() & 0xFF
    i = i + 1
  }
  aes128_encrypt_block_arr(k, src, dst)
  let out = Bytes::new(16)
  i = 0
  while i < 16 {
    out[i] = dst[i].to_byte()
    i = i + 1
  }
  wck(crypto::bytes_to_hex(out) == "69c4e0d86a7b0430d8cdb78070b4c55a", "FIPS-197 C.1")
  let k2 = aes128_expand_key(whx("2b7e151628aed2a6abf7158809cf4f3c"))
  wck(k2.rk[43] == 0xb6630ca6U && k2.rk[4] == 0xa0fafe17U, "FIPS-197 A.1 key expansion w[4], w[43]")
  let pt2 = whx("3243f6a8885a308d313198a2e0370734")
  i = 0
  while i < 16 {
    src[i] = pt2[i].to_int() & 0xFF
    i = i + 1
  }
  aes128_encrypt_block_arr(k2, src, dst)
  i = 0
  while i < 16 {
    out[i] = dst[i].to_byte()
    i = i + 1
  }
  wck(crypto::bytes_to_hex(out) == "3925841d02dc09fbdc118597196a0b32", "FIPS-197 Appendix B")
}

///| NIST SP 800-38D (GCM spec, McGrew-Viega) AES-128 test cases 1-4: empty P / empty AAD,
///| one zero block, 64-byte P, 60-byte P (non-aligned) + 20-byte AAD (non-aligned).
test "wb_control_sp800_38d_gcm_test_cases_1_to_4" {
  let z = whx("00000000000000000000000000000000")
  let ziv = whx("000000000000000000000000")
  wck(gcm_encrypt(z, ziv, Bytes::new(0), Bytes::new(0)) == ":58e2fccefa7e3061367f1d57a4e7455a", "TC1")
  wck(
    gcm_encrypt(z, ziv, Bytes::new(0), z) == "0388dace60b6a392f328c2b971b2fe78:ab6e47d42cec13bdf53a67b21257bddf",
    "TC2",
  )
  let k = whx("feffe9928665731c6d6a8f9467308308")
  let iv = whx("cafebabefacedbaddecaf888")
  let p = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255"
  let c = "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f5985"
  wck(gcm_encrypt(k, iv, Bytes::new(0), whx(p)) == c + ":4d5c2af327cd64a62cf35abd2ba6fab4", "TC3")
  let p60 = p.slice(0, 120)
  let c60 = c.slice(0, 120)
  wck(
    gcm_encrypt(k, iv, whx("feedfacedeadbeeffeedfacedeadbeefabaddad2"), whx(p60)) ==
    c60 + ":5bc94fbc3221a5db94fae95ae7121a47",
    "TC4",
  )
}

///| RFC 7714 §9 / §10 SRTCP AEAD with E=0 (unencrypted, authenticated): built with the private
///| GCM primitive the way RFC 7714 §9.2 specifies (AAD = whole RTCP || E||index), accepted by
///| decrypt_rtcp; a forged E=0 packet is rejected.
test "wb_control_srtcp_gcm_e0_unencrypted" {
  let keys = match derive_srtcp_keys(
    ProtectionProfile::AeadAes128Gcm,
    whx("e1f97a0d3e018be0d64fa32c06de4139"),
    whx("517569642070726f2071756f"),
  ) {
    Ok(k) => k
    Err(_) => abort("kdf")
  }
  let rx = wctx(ProtectionProfile::AeadAes128Gcm)
  let plain = whx("81ce00021122334455667788")
  let ssrc = 0x11223344U
  let idx = 5U
  let aad = Bytes::new(plain.length() + 4)
  let mut i = 0
  while i < plain.length() {
    aad[i] = plain[i]
    i = i + 1
  }
  aad[plain.length() + 3] = 5.to_byte()
  let k = aes128_expand_key(keys.enc_key)
  let tbl = ghash_table_new(k)
  let iv = build_srtcp_gcm_iv(keys.salt, ssrc, idx)
  let tag = aes128_gcm_tag(k, tbl, iv, aad, 0, aad.length(), Bytes::new(0), 0, 0)
  let w = Bytes::new(plain.length() + 20)
  i = 0
  while i < plain.length() {
    w[i] = plain[i]
    i = i + 1
  }
  i = 0
  while i < 16 {
    w[plain.length() + i] = tag[i]
    i = i + 1
  }
  w[plain.length() + 19] = 5.to_byte()
  let forged = Bytes::new(w.length())
  i = 0
  while i < w.length() {
    forged[i] = w[i]
    i = i + 1
  }
  forged[8] = (forged[8].to_int() ^ 1).to_byte()
  let forged_ok = match rx.decrypt_rtcp(forged) {
    Ok(_) => true
    Err(_) => false
  }
  wck(!forged_ok, "forged E=0 GCM rejected")
  match rx.decrypt_rtcp(w) {
    Ok(d) => wck(crypto::bytes_to_hex(d) == crypto::bytes_to_hex(plain), "E=0 GCM passthrough")
    Err(e) => wck(false, "E=0 GCM: " + rtp_error_message(e))
  }
}

///| Forged packets (garbage tag) never mutate an EXISTING SSRC state (roc / s_l / mask).
test "wb_control_forged_packets_do_not_mutate_existing_state" {
  let tx = wctx(ProtectionProfile::Aes128CmHmacSha1_80)
  let rx = wctx(ProtectionProfile::Aes128CmHmacSha1_80)
  let ssrc = 0xDEADBEEFU
  let w = match tx.encrypt_rtp(wrtp(40000, ssrc, 1)) {
    Ok(b) => b
    Err(_) => abort("enc")
  }
  match rx.decrypt_rtp(w) {
    Ok(_) => ()
    Err(_) => abort("dec")
  }
  let st = rx.ssrc_states[0]
  let snap = st.roc.to_string() + "/" + st.s_l.to_string() + "/" + st.replay_mask.to_string()
  let mut s = 0
  while s < 65536 {
    let f = wrtp(s, ssrc, 3)
    let g = Bytes::new(f.length() + 10)
    let mut i = 0
    while i < f.length() {
      g[i] = f[i]
      i = i + 1
    }
    let _ = rx.decrypt_rtp(g)
    s = s + 97
  }
  let st2 = rx.ssrc_states[0]
  wck(st2.roc.to_string() + "/" + st2.s_l.to_string() + "/" + st2.replay_mask.to_string() == snap, "state unchanged")
}

///| P1-1: decrypt_rtp calls get_or_create_ssrc_state() BEFORE authentication, so every forged
///| packet with a fresh SSRC permanently appends a SsrcState to an unbounded Array that is then
///| searched linearly on every packet. No key needed: remote, unauthenticated memory growth plus
///| O(#forged SSRCs) CPU per genuine packet (quadratic overall). Expected: forged packets leave
///| no state behind (or the table is bounded).
test "wb_redteam_P1_1_forged_ssrcs_grow_state_table_unbounded" {
  let rx = wctx(ProtectionProfile::AeadAes128Gcm)
  let mut i = 0
  while i < 5000 {
    let f = wrtp(i & 0xFFFF, (0x01000000 + i).to_uint(), 7)
    let g = Bytes::new(f.length() + 16)
    let mut j = 0
    while j < f.length() {
      g[j] = f[j]
      j = j + 1
    }
    let _ = rx.decrypt_rtp(g)
    i = i + 1
  }
  wck(
    rx.ssrc_states.length() == 0,
    "P1-1: 5000 forged (unauthenticated) packets left " + rx.ssrc_states.length().to_string() +
    " SsrcState entries behind",
  )
}

///| P2-6: encrypt_rtcp wraps the 31-bit SRTCP index (0x7FFFFFFF -> 0) and encrypt_rtp wraps the
///| 32-bit ROC (0xFFFFFFFF -> 0) silently: the next packet re-uses index 0's keystream / GCM nonce.
///| RFC 3711 §3.3.1 / §9.2: the sender MUST re-key (or stop) before the index space wraps.
test "wb_redteam_P2_6_srtcp_index_and_roc_wrap_reuse_nonce" {
  let plain = whx("81ce00021122334455667788")
  let fresh = wctx(ProtectionProfile::AeadAes128Gcm)
  let first = match fresh.encrypt_rtcp(plain) {
    Ok(b) => crypto::bytes_to_hex(b)
    Err(_) => ""
  }
  let tx = wctx(ProtectionProfile::AeadAes128Gcm)
  tx.srtcp_index = 0x7FFFFFFFU
  let _ = tx.encrypt_rtcp(plain)
  let wrapped = match tx.encrypt_rtcp(plain) {
    Ok(b) => crypto::bytes_to_hex(b)
    Err(_) => "refused"
  }
  wck(wrapped != first, "P2-6: SRTCP index wrapped 0x7FFFFFFF -> 0 (identical nonce/ciphertext as index 0)")
  let tx2 = wctx(ProtectionProfile::Aes128CmHmacSha1_80)
  tx2.set_roc(0x42U, 0xFFFFFFFFU)
  let _ = tx2.encrypt_rtp(wrtp(65535, 0x42U, 1))
  let after_wrap = match tx2.encrypt_rtp(wrtp(0, 0x42U, 1)) {
    Ok(b) => crypto::bytes_to_hex(b)
    Err(_) => "refused"
  }
  let fresh2 = wctx(ProtectionProfile::Aes128CmHmacSha1_80)
  let idx0 = match fresh2.encrypt_rtp(wrtp(0, 0x42U, 1)) {
    Ok(b) => crypto::bytes_to_hex(b)
    Err(_) => ""
  }
  wck(after_wrap != idx0, "P2-6: ROC 0xFFFFFFFF + seq wrap encrypts with ROC 0 (packet index 0 keystream reused)")
}
