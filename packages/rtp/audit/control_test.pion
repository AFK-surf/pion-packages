///| Control tests for the packages/rtp red-team audit: every test here MUST PASS on the audited
///| commit. They pin the defences that were verified to hold (so a fix for a red-team finding
///| cannot silently regress them). Black-box: only the public `rtp` API is used.

import "rtp"
import "crypto"

///|
fn ck(cond : Bool, msg : String) -> Unit {
  debug_assert(cond, msg)
}

///|
fn profiles() -> Array[rtp::ProtectionProfile] {
  [
    rtp::ProtectionProfile::Aes128CmHmacSha1_80,
    rtp::ProtectionProfile::Aes128CmHmacSha1_32,
    rtp::ProtectionProfile::AeadAes128Gcm,
  ]
}

///|
fn enc(ctx : rtp::SrtpContext, p : Bytes) -> Bytes {
  match ctx.encrypt_rtp(p) {
    Ok(b) => b
    Err(e) => abort("encrypt_rtp: " + rtp::rtp_error_message(e))
  }
}

///|
fn enc_rtcp(ctx : rtp::SrtpContext, p : Bytes) -> Bytes {
  match ctx.encrypt_rtcp(p) {
    Ok(b) => b
    Err(e) => abort("encrypt_rtcp: " + rtp::rtp_error_message(e))
  }
}

///|
fn is_auth_fail(r : Result[Bytes, rtp::RtpError]) -> Bool {
  match r {
    Err(rtp::RtpError::AuthenticationFailed(_)) => true
    _ => false
  }
}

///|
fn is_replay(r : Result[Bytes, rtp::RtpError]) -> Bool {
  match r {
    Err(rtp::RtpError::ReplayDetected(_)) => true
    _ => false
  }
}

///|
fn dec_eq(ctx : rtp::SrtpContext, wire : Bytes, plain : Bytes) -> Bool {
  match ctx.decrypt_rtp(wire) {
    Ok(d) => to_hex(d) == to_hex(plain)
    Err(_) => false
  }
}

///|
fn hmac_sha1(key : Bytes, data : Bytes) -> Bytes {
  let ipad = Bytes::new(64)
  let opad = Bytes::new(64)
  let mut i = 0
  while i < 64 {
    let kb = if i < key.length() { key[i].to_int() } else { 0 }
    ipad[i] = (kb ^ 0x36).to_byte()
    opad[i] = (kb ^ 0x5C).to_byte()
    i = i + 1
  }
  let inner = crypto::Sha1::new()
  inner.update(ipad)
  inner.update(data)
  let ih = inner.finalize()
  let outer = crypto::Sha1::new()
  outer.update(opad)
  outer.update(ih)
  outer.finalize()
}

///| A.2 verify-then-decrypt: every single-bit flip anywhere in an SRTP packet (header, CSRC,
///| extension, ciphertext, tag) is rejected for all three profiles, and none of the forged
///| packets moves ROC / s_l / the replay window: the genuine packet is still accepted afterwards.
test "control_srtp_every_bitflip_rejected_and_state_untouched" {
  let ps = profiles()
  let mut pi = 0
  while pi < ps.length() {
    let tx = new_ctx(ps[pi])
    let rx = new_ctx(ps[pi])
    let h0 = rtp_hdr(100, 0xA1A2A3A4U)
    let h = rtp::RtpHeader::{
      ..h0,
      extension: true,
      extension_profile: 0xBEDE,
      csrcs: [0x01020304U],
      extensions: [rtp::HeaderExtension::{ id: 1, payload: hx("30") }, rtp::HeaderExtension::{ id: 3, payload: hx("112233") }],
    }
    let plain = match rtp::marshal_rtp(rtp::RtpPacket::{ header: h, payload: filled(37, 5), padding_size: 0 }) {
      Ok(b) => b
      Err(_) => Bytes::new(0)
    }
    let first = enc(tx, mk_rtp(99, 0xA1A2A3A4U, filled(10, 1)))
    ck(is_ok(rx.decrypt_rtp(first)), "seed packet accepted")
    let wire = enc(tx, plain)
    let mut pos = 0
    while pos < wire.length() {
      let mut bit = 0
      while bit < 8 {
        let r = rx.decrypt_rtp(flip(wire, pos, 1 << bit))
        ck(!is_ok(r), "bit flip accepted at byte " + pos.to_string())
        bit = bit + 1
      }
      pos = pos + 1
    }
    ck(rx.get_roc(0xA1A2A3A4U) == 0U, "ROC untouched by forged packets")
    ck(dec_eq(rx, wire, plain), "genuine packet still accepted after 8*N forgeries")
    pi = pi + 1
  }
}

///| A.2 state-pollution attack: forged packets whose sequence numbers would push s_l / ROC
///| forward (seq + 30000, wrap 65535 -> 0) must not be committed.
test "control_forged_high_seq_cannot_advance_roc_or_window" {
  let ps = profiles()
  let mut pi = 0
  while pi < ps.length() {
    let tx = new_ctx(ps[pi])
    let rx = new_ctx(ps[pi])
    let ssrc = 0x0BADF00DU
    let e1 = enc(tx, mk_rtp(65000, ssrc, filled(20, 1)))
    ck(is_ok(rx.decrypt_rtp(e1)), "seed 65000")
    // Forge: take a real ciphertext and rewrite its sequence number to 1 (would imply ROC=1)
    // and to 65000+32767; garbage tags.
    let seqs = [1, 2, 300, 32000, 64999, 65535]
    let mut si = 0
    while si < seqs.length() {
      let f = copy_bytes(e1)
      f[2] = ((seqs[si] >> 8) & 0xFF).to_byte()
      f[3] = (seqs[si] & 0xFF).to_byte()
      ck(is_auth_fail(rx.decrypt_rtp(f)), "forged seq rejected as auth failure")
      si = si + 1
    }
    ck(rx.get_roc(ssrc) == 0U, "ROC not advanced by forgeries")
    let p2 = mk_rtp(65001, ssrc, filled(20, 2))
    ck(dec_eq(rx, enc(tx, p2), p2), "next genuine packet accepted")
    pi = pi + 1
  }
}

///| A.3 RFC 3711 Appendix A ROC estimation edges: wrap 65535 -> 0, late pre-wrap packet,
///| ROC = 0 with a +32768-ahead packet (must NOT underflow to 0xFFFFFFFF), exact 32767/32768 jumps.
test "control_roc_estimation_edges" {
  let ps = profiles()
  let mut pi = 0
  while pi < ps.length() {
    let prof = ps[pi]
    // (a) ROC = 0, s_l = 10, then genuine seq 65535 (sender also at ROC 0): accepted, ROC stays 0.
    let tx = new_ctx(prof)
    let rx = new_ctx(prof)
    let ssrc = 0x10101010U
    let a = mk_rtp(10, ssrc, filled(8, 1))
    let b = mk_rtp(65535, ssrc, filled(8, 2))
    let c = mk_rtp(0, ssrc, filled(8, 3))
    ck(dec_eq(rx, enc(tx, a), a), "seq 10")
    ck(dec_eq(rx, enc(tx, b), b), "seq 65535 at ROC 0")
    ck(rx.get_roc(ssrc) == 0U, "no ROC underflow to 0xFFFFFFFF")
    ck(dec_eq(rx, enc(tx, c), c), "seq 0 after 65535 -> ROC 1")
    ck(rx.get_roc(ssrc) == 1U && tx.get_roc(ssrc) == 1U, "ROC 1 on both sides")
    // (b) jumps of exactly 32767 and 32768 forward from s_l = 0.
    let tx2 = new_ctx(prof)
    let rx2 = new_ctx(prof)
    let s2 = 0x20202020U
    let q0 = mk_rtp(0, s2, filled(8, 4))
    let q1 = mk_rtp(32767, s2, filled(8, 5))
    let q2 = mk_rtp(65535, s2, filled(8, 6))
    let q3 = mk_rtp(1, s2, filled(8, 7))
    ck(dec_eq(rx2, enc(tx2, q0), q0), "s_l=0")
    ck(dec_eq(rx2, enc(tx2, q1), q1), "+32767")
    ck(dec_eq(rx2, enc(tx2, q2), q2), "+32768 more (65535)")
    ck(dec_eq(rx2, enc(tx2, q3), q3), "wrap to 1")
    ck(rx2.get_roc(s2) == 1U, "ROC 1 after wrap")
    pi = pi + 1
  }
}

///| A.3 64-packet replay window: delta 0 (duplicate), 63 (accepted), 64, 65 (rejected) for all
///| profiles, and per-SSRC isolation of SRTP replay state.
test "control_srtp_replay_window_edges_and_ssrc_isolation" {
  let ps = profiles()
  let mut pi = 0
  while pi < ps.length() {
    let tx = new_ctx(ps[pi])
    let rx = new_ctx(ps[pi])
    let ssrc = 0x55667788U
    let wires : Array[Bytes] = []
    let mut s = 0
    while s <= 200 {
      wires.push(enc(tx, mk_rtp(1000 + s, ssrc, filled(4, s))))
      s = s + 1
    }
    ck(is_ok(rx.decrypt_rtp(wires[200])), "top=1200")
    ck(is_replay(rx.decrypt_rtp(wires[200])), "delta 0 duplicate")
    ck(is_ok(rx.decrypt_rtp(wires[137])), "age 63 accepted")
    ck(is_replay(rx.decrypt_rtp(wires[137])), "age 63 duplicate")
    ck(is_replay(rx.decrypt_rtp(wires[136])), "age 64 rejected")
    ck(is_replay(rx.decrypt_rtp(wires[135])), "age 65 rejected")
    // Other SSRC with identical sequence numbers is independent.
    let tx_b = new_ctx(ps[pi])
    let other = enc(tx_b, mk_rtp(1000, 0x99999999U, filled(4, 0)))
    ck(is_ok(rx.decrypt_rtp(other)), "SSRC B seq 1000 accepted despite SSRC A top=1200")
    ck(rx.get_roc(0x99999999U) == 0U && rx.get_roc(ssrc) == 0U, "independent ROC")
    pi = pi + 1
  }
}

///| A.4 SRTCP: E-flag and index are authenticated (flip -> reject); truncated packets of every
///| length below the minimum are rejected without trapping; replay of the same index rejected.
test "control_srtcp_eflag_index_auth_truncation_replay" {
  let ps = profiles()
  let mut pi = 0
  while pi < ps.length() {
    let prof = ps[pi]
    let tx = new_ctx(prof)
    let rx = new_ctx(prof)
    let plain = mk_pli(0x31313131U)
    let w = enc_rtcp(tx, plain)
    let tag_len = match prof {
      rtp::ProtectionProfile::AeadAes128Gcm => 16
      _ => 10
    }
    let eidx_off = match prof {
      rtp::ProtectionProfile::AeadAes128Gcm => w.length() - 4
      _ => w.length() - tag_len - 4
    }
    ck(is_auth_fail(rx.decrypt_rtcp(flip(w, eidx_off, 0x80))), "E flag flip rejected")
    ck(is_auth_fail(rx.decrypt_rtcp(flip(w, eidx_off + 3, 0x01))), "index flip rejected")
    let mut cut = 0
    while cut < w.length() {
      let t = Bytes::new(cut)
      let mut i = 0
      while i < cut {
        t[i] = w[i]
        i = i + 1
      }
      ck(!is_ok(rx.decrypt_rtcp(t)), "truncated SRTCP len " + cut.to_string() + " rejected")
      cut = cut + 1
    }
    match rx.decrypt_rtcp(w) {
      Ok(d) => ck(to_hex(d) == to_hex(plain), "SRTCP roundtrip")
      Err(e) => ck(false, "SRTCP decrypt " + rtp::rtp_error_message(e))
    }
    ck(is_replay(rx.decrypt_rtcp(w)), "SRTCP replay rejected")
    pi = pi + 1
  }
}

///| A.4 RFC 3711 §3.4 E=0 (unencrypted but authenticated) SRTCP for AES-CM profiles: built
///| independently with an audit-side HMAC-SHA1, accepted as plaintext; forged E=0 rejected.
test "control_srtcp_unencrypted_e0_cm_profiles" {
  let cm = [rtp::ProtectionProfile::Aes128CmHmacSha1_80, rtp::ProtectionProfile::Aes128CmHmacSha1_32]
  let mut pi = 0
  while pi < cm.length() {
    let prof = cm[pi]
    let keys = match rtp::derive_srtcp_keys(prof, master_key(), salt_for(prof)) {
      Ok(k) => k
      Err(_) => abort("kdf")
    }
    let rx = new_ctx(prof)
    let plain = mk_pli(0x41414141U)
    let n = plain.length()
    let body = Bytes::new(n + 4)
    let mut i = 0
    while i < n {
      body[i] = plain[i]
      i = i + 1
    }
    body[n + 3] = 7.to_byte() // E=0, index=7
    let mac = hmac_sha1(keys.auth_key, body)
    let w = Bytes::new(n + 4 + 10)
    i = 0
    while i < n + 4 {
      w[i] = body[i]
      i = i + 1
    }
    i = 0
    while i < 10 {
      w[n + 4 + i] = mac[i]
      i = i + 1
    }
    ck(is_auth_fail(rx.decrypt_rtcp(flip(w, 9, 0x01))), "forged E=0 payload rejected")
    match rx.decrypt_rtcp(w) {
      Ok(d) => ck(to_hex(d) == to_hex(plain), "E=0 plaintext passthrough")
      Err(e) => ck(false, "E=0 decrypt: " + rtp::rtp_error_message(e))
    }
    pi = pi + 1
  }
}

///| A.5 master key / salt length validation for every profile.
test "control_master_key_salt_lengths" {
  let ps = profiles()
  let mut pi = 0
  while pi < ps.length() {
    let prof = ps[pi]
    let good_salt = salt_for(prof).length()
    let mut kl = 0
    while kl <= 33 {
      let r = rtp::SrtpContext::new(prof, filled(kl, 1), salt_for(prof))
      let ok = match r {
        Ok(_) => true
        Err(_) => false
      }
      ck(ok == (kl == 16), "key length " + kl.to_string())
      kl = kl + 1
    }
    let mut sl = 0
    while sl <= 20 {
      let r = rtp::SrtpContext::new(prof, master_key(), filled(sl, 3))
      let ok = match r {
        Ok(_) => true
        Err(_) => false
      }
      ck(ok == (sl == good_salt), "salt length " + sl.to_string())
      sl = sl + 1
    }
    pi = pi + 1
  }
}

///| B. RTP malformed input: padding 0 / > payload, CSRC / extension overruns, one-byte ID 15
///| terminator, two-byte length overrun, marshal rejection of illegal IDs / lengths.
test "control_rtp_malformed_rejected" {
  let bad = [
    "a0600001000000000000000100", // P=1, pad_len 0
    "a06000010000000000000001aabb05", // P=1, pad_len 5 > 3
    "a0600001000000000000000102", // P=1, pad_len 2 > 1 byte
    "8f600001000000000000000100000000", // CC=15 truncated
    "906000010000000000000001bede0002000000", // ext 2 words truncated
    "906000010000000000000001bede0001130000", // one-byte len 2 overruns 4-byte block? (0x13 = id1 len4)
    "9060000100000000000000011000000101ff0000", // two-byte len 255 overrun
    "9060000100000000000000011000000101", // ext body truncated
    "40600001000000000000000100", // version 1
  ]
  let mut i = 0
  while i < bad.length() {
    let r = match rtp::parse_rtp(hx(bad[i])) {
      Ok(_) => true
      Err(_) => false
    }
    ck(!r, "malformed RTP accepted: " + bad[i])
    i = i + 1
  }
  // ID 15 terminates parsing; following bytes ignored.
  match rtp::parse_rtp(hx("906000010000000000000001bede0002100fff1122334455")) {
    Ok(p) => ck(p.header.extensions.length() == 1, "ID15 terminator")
    Err(e) => ck(false, "ID15: " + rtp::rtp_error_message(e))
  }
  // Marshal rejects one-byte id 0 / 15, len 0 / 17; two-byte id 0 / 256, len 256.
  let cases : Array[(Int, Int, Int)] = [
    (0xBEDE, 0, 1),
    (0xBEDE, 15, 1),
    (0xBEDE, 1, 0),
    (0xBEDE, 1, 17),
    (0x1000, 0, 1),
    (0x1000, 256, 1),
    (0x1000, 1, 256),
  ]
  let mut ci = 0
  while ci < cases.length() {
    let (prof, id, len) = cases[ci]
    let h = rtp::RtpHeader::{
      ..rtp_hdr(1, 1U),
      extension: true,
      extension_profile: prof,
      extensions: [rtp::HeaderExtension::{ id: id, payload: filled(len, 0) }],
    }
    let ok = match rtp::marshal_rtp(rtp::RtpPacket::{ header: h, payload: Bytes::new(0), padding_size: 0 }) {
      Ok(_) => true
      Err(_) => false
    }
    ck(!ok, "marshal accepted illegal extension case " + ci.to_string())
    ci = ci + 1
  }
}

///| B. RTCP malformed input and DecodeLimits semantics (negative -> LimitExceeded, 0 -> 0 items).
test "control_rtcp_malformed_and_limits" {
  let bad = [
    "80c9ffff00000001", // length 0xFFFF
    "80c90001000000", // truncated
    "81ca0003000000010105616263", // SDES missing END
    "81c90007000000010000000200000000000000000000000000000000", // RR count 1 truncated block
    "80cd0003000000010000000200010", // NACK odd length (truncated)
    "8fce000400000001000000025245", // REMB FCI truncated
    "a0c900010000000100", // padding with length mismatch
    "00c9000100000001", // version 0
  ]
  let mut i = 0
  while i < bad.length() {
    let ok = match rtp::parse_rtcp(hx(bad[i])) {
      Ok(_) => true
      Err(_) => false
    }
    ck(!ok, "malformed RTCP accepted: " + bad[i])
    i = i + 1
  }
  let d = rtp::DecodeLimits::default()
  let neg = rtp::DecodeLimits::{ ..d, max_nacks: -1 }
  let neg_rejected = match rtp::parse_rtcp_with_limits(hx("80c9000100000001"), neg) {
    Err(rtp::RtpError::LimitExceeded(_)) => true
    _ => false
  }
  ck(neg_rejected, "negative limit rejected")
  let zero = rtp::DecodeLimits::{ ..d, max_nacks: 0 }
  let one_nack = hx("81cd0003000000010000000200050001")
  ck(
    match rtp::parse_rtcp_with_limits(one_nack, zero) {
      Ok(_) => false
      Err(_) => true
    },
    "max_nacks 0 rejects one NACK",
  )
  ck(
    match rtp::parse_rtcp_with_limits(one_nack, d) {
      Ok(v) => v.length() == 1
      Err(_) => false
    },
    "default limits accept one NACK",
  )
  let zero_pk = rtp::DecodeLimits::{ ..d, max_rtcp_packets: 0 }
  ck(
    match rtp::parse_rtcp_with_limits(hx("80c9000100000001"), zero_pk) {
      Ok(_) => false
      Err(_) => true
    },
    "max_rtcp_packets 0 rejects one packet",
  )
}

///| B. RFC 7983 demux: first byte boundaries 0..3 STUN, 20..63 DTLS, 127/128/191/192;
///| second byte RTCP PT 192..223 (64..95 with marker) vs RTP.
test "control_rfc7983_demux_boundaries" {
  let mut b0 = 0
  while b0 < 256 {
    let p = Bytes::new(12)
    p[0] = b0.to_byte()
    p[1] = 0x60.to_byte()
    let in_range = b0 >= 128 && b0 <= 191
    ck(rtp::is_rtp_packet(p) == in_range, "rtp demux b0=" + b0.to_string())
    ck(!rtp::is_rtcp_packet(p), "PT 96 is not rtcp b0=" + b0.to_string())
    b0 = b0 + 1
  }
  let mut b1 = 0
  while b1 < 256 {
    let p = Bytes::new(12)
    p[0] = 0x80.to_byte()
    p[1] = b1.to_byte()
    let pt = b1 & 0x7F
    let rtcp_range = pt >= 64 && pt <= 95
    ck(rtp::is_rtcp_packet(p) == rtcp_range, "rtcp demux b1=" + b1.to_string())
    ck(rtp::is_rtp_packet(p) == !rtcp_range, "rtp demux b1=" + b1.to_string())
    b1 = b1 + 1
  }
}
