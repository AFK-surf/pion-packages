///| Red-team reproductions for packages/rtp @ dfd410cd. Each test asserts the SECURE / RFC-correct
///| behaviour, so on the audited commit every `redteam_*` test is expected to FAIL; each failure is a
///| confirmed finding (ID in the test name, details in ../README.md). After a fix the test turns
///| green and stays as the regression test. Black-box: only the public `rtp` API is used
///| (white-box reproductions that need private state live in whitebox/).

import "rtp"
import "crypto"

///|
fn rt(cond : Bool, msg : String) -> Unit {
  debug_assert(cond, msg)
}

///|
fn enc1(ctx : rtp::SrtpContext, p : Bytes) -> Bytes {
  match ctx.encrypt_rtp(p) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///|
fn xor_prefix(a : Bytes, b : Bytes, start : Int, len : Int) -> String {
  let out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = (a[start + i].to_int() ^ b[start + i].to_int()).to_byte()
    i = i + 1
  }
  to_hex(out)
}

///| P1-2: SRTCP replay state (index high-water mark + 64-bit mask) is ONE per SrtpContext instead of
///| one per SSRC (RFC 3711 §3.2.3 / §3.4: the SRTCP index is per crypto context = per SSRC).
///| A remote peer with two RTCP senders (e.g. audio + video SSRC, each with its own index counter,
///| exactly what libsrtp / webrtc-rs / Chrome emit) gets every RTCP packet of the lagging SSRC
///| rejected as "older than the replay window" -> NACK/PLI/REMB/SR of that SSRC are dropped.
test "redteam_P1_2_srtcp_replay_window_shared_across_ssrcs" {
  let profs = [
    rtp::ProtectionProfile::Aes128CmHmacSha1_80,
    rtp::ProtectionProfile::Aes128CmHmacSha1_32,
    rtp::ProtectionProfile::AeadAes128Gcm,
  ]
  let mut pi = 0
  while pi < profs.length() {
    // Two independent RFC-conformant sender crypto contexts (per-SSRC index), same master key.
    let tx_audio = new_ctx(profs[pi])
    let tx_video = new_ctx(profs[pi])
    let rx = new_ctx(profs[pi])
    let mut i = 0
    while i < 100 {
      let w = match tx_audio.encrypt_rtcp(mk_pli(0xAAAA0001U)) {
        Ok(b) => b
        Err(_) => Bytes::new(0)
      }
      rt(is_ok(rx.decrypt_rtcp(w)), "audio SRTCP accepted")
      i = i + 1
    }
    let v = match tx_video.encrypt_rtcp(mk_pli(0xBBBB0002U)) {
      Ok(b) => b
      Err(_) => Bytes::new(0)
    }
    let r = rx.decrypt_rtcp(v)
    rt(is_ok(r), "P1-2: first genuine SRTCP of 2nd SSRC (index 0) rejected: " + err_name(r))
    pi = pi + 1
  }
}

///| P2-1: encrypt_rtp never refuses an already-used packet index (SSRC, ROC, SEQ). Encrypting a
///| different payload under a repeated index re-uses the AES-CM keystream / AES-GCM nonce:
///| C1 xor C2 == P1 xor P2 (confidentiality loss) and for GCM the GHASH key H becomes recoverable
///| (universal forgery). libsrtp refuses this (srtp_err_status_replay_fail unless allow_repeat_tx).
test "redteam_P2_1_encrypt_rtp_reuses_keystream_on_repeated_index" {
  let profs = [rtp::ProtectionProfile::Aes128CmHmacSha1_80, rtp::ProtectionProfile::AeadAes128Gcm]
  let mut pi = 0
  while pi < profs.length() {
    let tx = new_ctx(profs[pi])
    let p1 = mk_rtp(5000, 0x77777777U, filled(32, 0x11))
    let p2 = mk_rtp(5000, 0x77777777U, filled(32, 0x5A))
    let c1 = enc1(tx, p1)
    let r2 = tx.encrypt_rtp(p2)
    match r2 {
      Ok(c2) => {
        let leaked = xor_prefix(c1, c2, 12, 32) == xor_prefix(p1, p2, 12, 32)
        rt(!leaked, "P2-1: same (SSRC,ROC,SEQ) re-encrypted -> C1^C2 == P1^P2 (keystream reuse)")
      }
      Err(_) => () // secure: refused
    }
    pi = pi + 1
  }
}

///| P2-2: SrtpContext::from_session_keys does not validate auth_key for the HMAC-SHA1 profiles.
///| An empty (or 1-byte) auth key is accepted, making the "authenticated" stream forgeable by
///| anyone (HMAC with a known/empty key). It must be exactly 20 bytes (RFC 3711 §8.2 n_a = 160).
test "redteam_P2_2_from_session_keys_accepts_empty_hmac_key" {
  let keys = rtp::SrtpSessionKeys::{ enc_key: filled(16, 1), auth_key: Bytes::new(0), salt: filled(14, 2) }
  let r = rtp::SrtpContext::from_session_keys(rtp::ProtectionProfile::Aes128CmHmacSha1_80, keys, keys)
  let accepted = match r {
    Ok(_) => true
    Err(_) => false
  }
  rt(!accepted, "P2-2: HMAC-SHA1 profile accepted a 0-byte auth key")
  let keys1 = rtp::SrtpSessionKeys::{ ..keys, auth_key: filled(1, 9) }
  let accepted1 = match rtp::SrtpContext::from_session_keys(rtp::ProtectionProfile::Aes128CmHmacSha1_32, keys1, keys1) {
    Ok(_) => true
    Err(_) => false
  }
  rt(!accepted1, "P2-2: HMAC-SHA1 profile accepted a 1-byte auth key")
}

///| P2-3: marshal_rtp writes the extension length as `ext_words & 0xFFFF` without checking
///| ext_words <= 65535. A two-byte-header extension block larger than 262140 bytes is marshalled
///| with a truncated length: the receiver re-parses the tail of the extension block as payload
///| (header/payload desync, smuggling attacker-chosen "payload" bytes from extension data).
test "redteam_P2_3_marshal_rtp_extension_length_truncated" {
  let exts : Array[rtp::HeaderExtension] = []
  let mut i = 0
  while i < 1100 {
    exts.push(rtp::HeaderExtension::{ id: 1 + (i % 200), payload: filled(255, i) })
    i = i + 1
  }
  let h = rtp::RtpHeader::{ ..rtp_hdr(1, 0x1234U), extension: true, extension_profile: 0x1000, extensions: exts }
  let payload = hx("cafebabe")
  match rtp::marshal_rtp(rtp::RtpPacket::{ header: h, payload: payload, padding_size: 0 }) {
    Err(_) => () // secure: refused
    Ok(wire) => {
      let big = rtp::DecodeLimits::{
        ..rtp::DecodeLimits::default(),
        max_extensions: 100000,
        max_extension_bytes: 1000000,
        max_payload_bytes: 10000000,
      }
      let ok = match rtp::parse_rtp_with_limits(wire, big) {
        Ok(p) => to_hex(p.payload) == to_hex(payload) && p.header.extensions.length() == 1100
        Err(_) => false
      }
      rt(ok, "P2-3: marshal_rtp produced a packet whose re-parse differs (len " + wire.length().to_string() + ")")
    }
  }
}

///| P2-4: marshal_rtp / marshal_rtcp silently truncate out-of-range header fields instead of
///| rejecting them (payload_type IS range-checked, the others are not): sequence_number 65536+7,
///| extension_profile 0x1BEDE, NACK packet_id 70000, Unknown packet_type 456.
test "redteam_P2_4_marshal_silently_truncates_out_of_range_fields" {
  let r1 = rtp::marshal_rtp(rtp::RtpPacket::{ header: rtp_hdr(65536 + 7, 1U), payload: Bytes::new(0), padding_size: 0 })
  rt(!is_ok(r1), "P2-4: sequence_number 65543 marshalled (wire seq " + (match r1 { Ok(b) => (((b[2].to_int() & 0xFF) << 8) | (b[3].to_int() & 0xFF)).to_string(); Err(_) => "-" }) + ")")
  let h2 = rtp::RtpHeader::{ ..rtp_hdr(1, 1U), extension: true, extension_profile: 0x1BEDE, raw_extension_payload: Bytes::new(4) }
  rt(!is_ok(rtp::marshal_rtp(rtp::RtpPacket::{ header: h2, payload: Bytes::new(0), padding_size: 0 })), "P2-4: extension_profile 0x1BEDE marshalled")
  let nack = rtp::RtcpPacket::Nack(rtp::TransportLayerNack::{ sender_ssrc: 1U, media_ssrc: 2U, nacks: [rtp::NackPair::{ packet_id: 70000, lost_packets: 0 }] })
  rt(!is_ok(rtp::marshal_rtcp([nack])), "P2-4: NACK packet_id 70000 marshalled")
  let unk = rtp::RtcpPacket::Unknown(rtp::UnknownRtcp::{ packet_type: 456, count: 0, payload: Bytes::new(4) })
  rt(!is_ok(rtp::marshal_rtcp([unk])), "P2-4: RTCP packet_type 456 marshalled (becomes PT 200 = SR)")
}

///| P2-5: REMB decode computes `mantissa << exp` in UInt64 with exp up to 63: for exp >= 47 the
///| result overflows. A REMB announcing 2^17 * 2^47 = 2^64 bps decodes as 0 bps; exp=63 with
///| mantissa 0x3FFFF decodes as 2^63. webrtc-rs decodes to f32 (saturating, never 0).
test "redteam_P2_5_remb_exponent_shift_overflow" {
  // PSFB FMT=15, sender 1, media 0, "REMB", num=0, exp=47, mantissa=0x20000
  let w = hx("8fce000400000001000000005245" + "4d42" + "00" + "be" + "0000")
  match rtp::parse_rtcp(w) {
    Ok(pkts) =>
    match pkts[0] {
      rtp::RtcpPacket::Remb(r) => rt(r.bitrate != 0UL, "P2-5: REMB exp=47 mantissa=2^17 decoded as 0 bps")
      _ => rt(false, "not REMB")
    }
    Err(_) => () // rejecting is also acceptable
  }
}
