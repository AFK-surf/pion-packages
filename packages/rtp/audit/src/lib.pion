///| Red-team audit helpers for packages/rtp (audit-only code; see ../README.md).

import "rtp"
import "crypto"

///|
pub fn hx(s : String) -> Bytes {
  match crypto::hex_to_bytes(s) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///|
pub fn to_hex(b : Bytes) -> String {
  crypto::bytes_to_hex(b)
}

///|
pub fn copy_bytes(b : Bytes) -> Bytes {
  let out = Bytes::new(b.length())
  let mut i = 0
  while i < b.length() {
    out[i] = b[i]
    i = i + 1
  }
  out
}

///|
pub fn flip(b : Bytes, idx : Int, mask : Int) -> Bytes {
  let out = copy_bytes(b)
  out[idx] = ((out[idx].to_int() ^ mask) & 0xFF).to_byte()
  out
}

///|
pub fn master_key() -> Bytes {
  hx("e1f97a0d3e018be0d64fa32c06de4139")
}

///|
pub fn salt_for(profile : rtp::ProtectionProfile) -> Bytes {
  match profile {
    rtp::ProtectionProfile::AeadAes128Gcm => hx("517569642070726f2071756f")
    _ => hx("0ec675ad498afeebb6960b3aabe6")
  }
}

///|
pub fn new_ctx(profile : rtp::ProtectionProfile) -> rtp::SrtpContext {
  match rtp::SrtpContext::new(profile, master_key(), salt_for(profile)) {
    Ok(c) => c
    Err(e) => abort("SrtpContext::new failed: " + rtp::rtp_error_message(e))
  }
}

///|
pub fn rtp_hdr(seq : Int, ssrc : UInt) -> rtp::RtpHeader {
  rtp::RtpHeader::{
    version: 2,
    padding: false,
    extension: false,
    marker: false,
    payload_type: 96,
    sequence_number: seq,
    timestamp: 90000U,
    ssrc: ssrc,
    csrcs: [],
    extension_profile: 0,
    extensions: [],
    raw_extension_payload: Bytes::new(0),
  }
}

///|
pub fn mk_rtp(seq : Int, ssrc : UInt, payload : Bytes) -> Bytes {
  match rtp::marshal_rtp(rtp::RtpPacket::{ header: rtp_hdr(seq, ssrc), payload: payload, padding_size: 0 }) {
    Ok(b) => b
    Err(e) => abort("marshal_rtp failed: " + rtp::rtp_error_message(e))
  }
}

///|
pub fn filled(n : Int, v : Int) -> Bytes {
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = ((v + i * 7) & 0xFF).to_byte()
    i = i + 1
  }
  b
}

///| A minimal RTCP PLI (12 bytes) whose SSRC-of-sender field is `ssrc`.
pub fn mk_pli(ssrc : UInt) -> Bytes {
  match rtp::marshal_rtcp([rtp::RtcpPacket::Pli(rtp::PictureLossIndication::{ sender_ssrc: ssrc, media_ssrc: 0x11223344U })]) {
    Ok(b) => b
    Err(e) => abort("marshal_rtcp failed: " + rtp::rtp_error_message(e))
  }
}

///|
pub fn is_ok(r : Result[Bytes, rtp::RtpError]) -> Bool {
  match r {
    Ok(_) => true
    Err(_) => false
  }
}

///|
pub fn err_name(r : Result[Bytes, rtp::RtpError]) -> String {
  match r {
    Ok(_) => "Ok"
    Err(e) => rtp::rtp_error_message(e)
  }
}

///| Deterministic xorshift64* PRNG shared by fuzz/DoS harnesses.
pub struct Rng {
  mut s : UInt64
}

///|
pub fn Rng::new(seed : UInt64) -> Rng {
  Rng::{ s: if seed == 0UL { 0x9E3779B97F4A7C15UL } else { seed } }
}

///|
pub fn Rng::next(self : Rng) -> UInt64 {
  let mut x = self.s
  x = x ^ (x >> 12)
  x = x ^ (x << 25)
  x = x ^ (x >> 27)
  self.s = x
  x * 0x2545F4914F6CDD1DUL
}

///|
pub fn Rng::below(self : Rng, n : Int) -> Int {
  ((self.next() >> 33) % n.to_int64().to_uint64()).to_int()
}
