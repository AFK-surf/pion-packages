///| RFC 3550 + RFC 4585 + RFC 5104 + REMB RTCP compound packet codec.

///|
fn push_u16_be(out : Array[Byte], v : Int) -> Unit {
  out.push(((v >> 8) & 0xFF).to_byte())
  out.push((v & 0xFF).to_byte())
}

///|
fn push_u32_be(out : Array[Byte], v : UInt) -> Unit {
  out.push(((v >> 24U) & 0xFFU).to_int().to_byte())
  out.push(((v >> 16U) & 0xFFU).to_int().to_byte())
  out.push(((v >> 8U) & 0xFFU).to_int().to_byte())
  out.push((v & 0xFFU).to_int().to_byte())
}

///|
fn push_u64_be(out : Array[Byte], v : UInt64) -> Unit {
  out.push(((v >> 56) & 0xFFUL).to_int().to_byte())
  out.push(((v >> 48) & 0xFFUL).to_int().to_byte())
  out.push(((v >> 40) & 0xFFUL).to_int().to_byte())
  out.push(((v >> 32) & 0xFFUL).to_int().to_byte())
  out.push(((v >> 24) & 0xFFUL).to_int().to_byte())
  out.push(((v >> 16) & 0xFFUL).to_int().to_byte())
  out.push(((v >> 8) & 0xFFUL).to_int().to_byte())
  out.push((v & 0xFFUL).to_int().to_byte())
}

///|
fn push_bytes(out : Array[Byte], src : Bytes) -> Unit {
  let mut i = 0
  while i < src.length() {
    out.push(src[i])
    i = i + 1
  }
}

///|
fn arr_to_bytes(arr : Array[Byte]) -> Bytes {
  let n = arr.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = arr[i]
    i = i + 1
  }
  out
}

///| Expand RFC 4585 NACK pair (`packet_id` + 16-bit `lost_packets` BLP) with u16 wraparound.
pub fn NackPair::packet_list(self : NackPair) -> Array[Int] {
  let out : Array[Int] = [self.packet_id & 0xFFFF]
  let mut bit = 0
  while bit < 16 {
    if ((self.lost_packets >> bit) & 1) != 0 {
      out.push((self.packet_id + 1 + bit) & 0xFFFF)
    }
    bit = bit + 1
  }
  out
}

///|
fn parse_reception_reports(
  data : Bytes,
  start : Int,
  end : Int,
  count : Int,
  limits : DecodeLimits,
) -> Result[(Array[ReceptionReport], Int), RtpError] {
  if count > limits.max_report_blocks {
    return Err(RtpError::LimitExceeded("RTCP reception report count exceeds max_report_blocks"))
  }
  let need = count * 24
  if start + need > end {
    return Err(RtpError::Truncated("RTCP reception report block truncated"))
  }
  let reports : Array[ReceptionReport] = []
  let mut pos = start
  let mut i = 0
  while i < count {
    let ssrc = read_u32_be(data, pos)
    let fraction_lost = data[pos + 4].to_int() & 0xFF
    let lost_u = ((data[pos + 5].to_int() & 0xFF) << 16) |
    ((data[pos + 6].to_int() & 0xFF) << 8) |
    (data[pos + 7].to_int() & 0xFF)
    let total_lost = if (lost_u & 0x800000) != 0 { lost_u - 0x1000000 } else { lost_u }
    let last_seq = read_u32_be(data, pos + 8)
    let jitter = read_u32_be(data, pos + 12)
    let last_sr = read_u32_be(data, pos + 16)
    let delay = read_u32_be(data, pos + 20)
    reports.push(ReceptionReport::{
      ssrc: ssrc,
      fraction_lost: fraction_lost,
      total_lost: total_lost,
      last_seq: last_seq,
      jitter: jitter,
      last_sr: last_sr,
      delay_since_last_sr: delay,
    })
    pos = pos + 24
    i = i + 1
  }
  Ok((reports, pos))
}

///|
pub fn parse_rtcp(data : Bytes) -> Result[Array[RtcpPacket], RtpError] {
  parse_rtcp_with_limits(data, DecodeLimits::default())
}

///|
pub fn parse_rtcp_with_limits(
  data : Bytes,
  limits : DecodeLimits,
) -> Result[Array[RtcpPacket], RtpError] {
  match validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = data.length()
  if n < 4 {
    return Err(RtpError::Truncated("RTCP packet shorter than 4 bytes"))
  }
  let out : Array[RtcpPacket] = []
  let mut off = 0
  while off < n {
    if out.length() >= limits.max_rtcp_packets {
      return Err(RtpError::LimitExceeded("RTCP compound packet count exceeds max_rtcp_packets"))
    }
    if off + 4 > n {
      return Err(RtpError::Truncated("RTCP common header truncated"))
    }
    let b0 = data[off].to_int() & 0xFF
    let version = (b0 >> 6) & 0x03
    if version != 2 {
      return Err(RtpError::InvalidVersion(version))
    }
    let padding = (b0 & 0x20) != 0
    let count = b0 & 0x1F
    let pt = data[off + 1].to_int() & 0xFF
    let words = read_u16_be(data, off + 2)
    let pkt_len = (words + 1) * 4
    let pkt_end = off + pkt_len
    if pkt_end > n {
      return Err(RtpError::Truncated("RTCP packet length exceeds buffer"))
    }

    let mut body_end = pkt_end
    if padding {
      if pkt_len <= 4 {
        return Err(RtpError::InvalidPadding("RTCP padding bit set with empty body"))
      }
      let pad_len = data[pkt_end - 1].to_int() & 0xFF
      if pad_len == 0 || pad_len > pkt_len - 4 {
        return Err(RtpError::InvalidPadding("invalid RTCP padding length"))
      }
      body_end = pkt_end - pad_len
    }

    let body_start = off + 4
    if pt == 200 {
      // Sender Report (SR)
      if body_start + 24 > body_end {
        return Err(RtpError::Truncated("RTCP SR truncated"))
      }
      let ssrc = read_u32_be(data, body_start)
      let ntp_hi = read_u32_be(data, body_start + 4).to_uint64()
      let ntp_lo = read_u32_be(data, body_start + 8).to_uint64()
      let ntp_time = (ntp_hi << 32) | ntp_lo
      let rtp_time = read_u32_be(data, body_start + 12)
      let packet_count = read_u32_be(data, body_start + 16)
      let octet_count = read_u32_be(data, body_start + 20)
      let (reports, next_pos) = match
      parse_reception_reports(data, body_start + 24, body_end, count, limits) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let ext = slice_bytes(data, next_pos, body_end)
      out.push(
        RtcpPacket::Sr(SenderReport::{
          ssrc: ssrc,
          ntp_time: ntp_time,
          rtp_time: rtp_time,
          packet_count: packet_count,
          octet_count: octet_count,
          reports: reports,
          profile_extensions: ext,
        }),
      )
    } else if pt == 201 {
      // Receiver Report (RR)
      if body_start + 4 > body_end {
        return Err(RtpError::Truncated("RTCP RR truncated"))
      }
      let ssrc = read_u32_be(data, body_start)
      let (reports, next_pos) = match
      parse_reception_reports(data, body_start + 4, body_end, count, limits) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let ext = slice_bytes(data, next_pos, body_end)
      out.push(
        RtcpPacket::Rr(ReceiverReport::{
          ssrc: ssrc,
          reports: reports,
          profile_extensions: ext,
        }),
      )
    } else if pt == 202 {
      // Source Description (SDES)
      if count > limits.max_sdes_chunks {
        return Err(RtpError::LimitExceeded("SDES chunk count exceeds max_sdes_chunks"))
      }
      let chunks : Array[SdesChunk] = []
      let mut pos = body_start
      let mut ci = 0
      while ci < count {
        if pos + 4 > body_end {
          return Err(RtpError::Truncated("RTCP SDES chunk truncated"))
        }
        let chunk_start = pos
        let ssrc = read_u32_be(data, pos)
        pos = pos + 4
        let items : Array[SdesItem] = []
        let mut ended = false
        while pos < body_end {
          let itype = data[pos].to_int() & 0xFF
          if itype == 0 {
            pos = pos + 1
            ended = true
            break
          }
          if pos + 2 > body_end {
            return Err(RtpError::Truncated("RTCP SDES item header truncated"))
          }
          let ilen = data[pos + 1].to_int() & 0xFF
          if pos + 2 + ilen > body_end {
            return Err(RtpError::Truncated("RTCP SDES item text truncated"))
          }
          if items.length() >= limits.max_sdes_items {
            return Err(RtpError::LimitExceeded("SDES item count exceeds max_sdes_items"))
          }
          items.push(SdesItem::{ item_type: itype, text: slice_bytes(data, pos + 2, pos + 2 + ilen) })
          pos = pos + 2 + ilen
        }
        if !ended {
          return Err(RtpError::InvalidRtcp("RTCP SDES chunk missing NUL terminator"))
        }
        // Align to 32-bit boundary relative to chunk_start
        let rem = (pos - chunk_start) & 3
        if rem != 0 {
          let pad = 4 - rem
          if pos + pad > body_end {
            return Err(RtpError::Truncated("RTCP SDES chunk padding truncated"))
          }
          pos = pos + pad
        }
        chunks.push(SdesChunk::{ ssrc: ssrc, items: items })
        ci = ci + 1
      }
      out.push(RtcpPacket::Sdes(SourceDescription::{ chunks: chunks }))
    } else if pt == 203 {
      // Goodbye (BYE)
      if body_start + count * 4 > body_end {
        return Err(RtpError::Truncated("RTCP BYE SSRC list truncated"))
      }
      let sources : Array[UInt] = []
      let mut pos = body_start
      let mut si = 0
      while si < count {
        sources.push(read_u32_be(data, pos))
        pos = pos + 4
        si = si + 1
      }
      let mut reason = Bytes::new(0)
      if pos < body_end {
        let rlen = data[pos].to_int() & 0xFF
        if pos + 1 + rlen > body_end {
          return Err(RtpError::Truncated("RTCP BYE reason truncated"))
        }
        reason = slice_bytes(data, pos + 1, pos + 1 + rlen)
      }
      out.push(RtcpPacket::Bye(Goodbye::{ sources: sources, reason: reason }))
    } else if pt == 205 {
      // Transport-Layer Feedback (RTPFB)
      if body_start + 8 > body_end {
        return Err(RtpError::Truncated("RTCP RTPFB header truncated"))
      }
      let sender_ssrc = read_u32_be(data, body_start)
      let media_ssrc = read_u32_be(data, body_start + 4)
      let fci_start = body_start + 8
      if count == 1 {
        // Generic NACK (FMT=1)
        let fci_len = body_end - fci_start
        if (fci_len & 3) != 0 {
          return Err(RtpError::InvalidRtcp("RTCP NACK FCI not 32-bit aligned"))
        }
        let n_pairs = fci_len >> 2
        if n_pairs > limits.max_nacks {
          return Err(RtpError::LimitExceeded("RTCP NACK pair count exceeds max_nacks"))
        }
        let nacks : Array[NackPair] = []
        let mut pos = fci_start
        while pos < body_end {
          let pid = read_u16_be(data, pos)
          let blp = read_u16_be(data, pos + 2)
          nacks.push(NackPair::{ packet_id: pid, lost_packets: blp })
          pos = pos + 4
        }
        out.push(
          RtcpPacket::Nack(TransportLayerNack::{
            sender_ssrc: sender_ssrc,
            media_ssrc: media_ssrc,
            nacks: nacks,
          }),
        )
      } else if count == 15 {
        // Transport-Wide CC (FMT=15)
        out.push(
          RtcpPacket::Twcc(TransportWideCc::{
            sender_ssrc: sender_ssrc,
            media_ssrc: media_ssrc,
            payload: slice_bytes(data, fci_start, body_end),
          }),
        )
      } else {
        out.push(
          RtcpPacket::Unknown(UnknownRtcp::{
            packet_type: pt,
            count: count,
            payload: slice_bytes(data, body_start, body_end),
          }),
        )
      }
    } else if pt == 206 {
      // Payload-Specific Feedback (PSFB)
      if body_start + 8 > body_end {
        return Err(RtpError::Truncated("RTCP PSFB header truncated"))
      }
      let sender_ssrc = read_u32_be(data, body_start)
      let media_ssrc = read_u32_be(data, body_start + 4)
      let fci_start = body_start + 8
      if count == 1 {
        // PLI (FMT=1)
        out.push(
          RtcpPacket::Pli(PictureLossIndication::{
            sender_ssrc: sender_ssrc,
            media_ssrc: media_ssrc,
          }),
        )
      } else if count == 4 {
        // FIR (FMT=4)
        let fci_len = body_end - fci_start
        if (fci_len & 7) != 0 {
          return Err(RtpError::InvalidRtcp("RTCP FIR FCI must be a multiple of 8 bytes"))
        }
        let entries : Array[FirEntry] = []
        let mut pos = fci_start
        while pos < body_end {
          let essrc = read_u32_be(data, pos)
          let seq_nr = data[pos + 4].to_int() & 0xFF
          entries.push(FirEntry::{ ssrc: essrc, sequence_number: seq_nr })
          pos = pos + 8
        }
        out.push(
          RtcpPacket::Fir(FullIntraRequest::{
            sender_ssrc: sender_ssrc,
            media_ssrc: media_ssrc,
            entries: entries,
          }),
        )
      } else if count == 15 {
        // AFB -> REMB (FMT=15)
        if fci_start + 8 > body_end {
          return Err(RtpError::Truncated("RTCP REMB FCI truncated"))
        }
        let is_remb = data[fci_start].to_int() == 0x52 &&
        data[fci_start + 1].to_int() == 0x45 &&
        data[fci_start + 2].to_int() == 0x4D &&
        data[fci_start + 3].to_int() == 0x42
        if !is_remb {
          out.push(
            RtcpPacket::Unknown(UnknownRtcp::{
              packet_type: pt,
              count: count,
              payload: slice_bytes(data, body_start, body_end),
            }),
          )
        } else {
          let num_ssrcs = data[fci_start + 4].to_int() & 0xFF
          let b5 = data[fci_start + 5].to_int() & 0xFF
          let b6 = data[fci_start + 6].to_int() & 0xFF
          let b7 = data[fci_start + 7].to_int() & 0xFF
          let exp = (b5 >> 2) & 0x3F
          let mantissa : UInt64 = (((b5 & 0x03) << 16) | (b6 << 8) | b7).to_int64().to_uint64()
          let bitrate = mantissa << exp
          let ssrc_start = fci_start + 8
          if ssrc_start + num_ssrcs * 4 > body_end {
            return Err(RtpError::Truncated("RTCP REMB SSRC list truncated"))
          }
          let ssrcs : Array[UInt] = []
          let mut si = 0
          while si < num_ssrcs {
            ssrcs.push(read_u32_be(data, ssrc_start + si * 4))
            si = si + 1
          }
          out.push(
            RtcpPacket::Remb(ReceiverEstimatedMaximumBitrate::{
              sender_ssrc: sender_ssrc,
              media_ssrc: media_ssrc,
              bitrate: bitrate,
              ssrcs: ssrcs,
            }),
          )
        }
      } else {
        out.push(
          RtcpPacket::Unknown(UnknownRtcp::{
            packet_type: pt,
            count: count,
            payload: slice_bytes(data, body_start, body_end),
          }),
        )
      }
    } else {
      out.push(
        RtcpPacket::Unknown(UnknownRtcp::{
          packet_type: pt,
          count: count,
          payload: slice_bytes(data, body_start, body_end),
        }),
      )
    }

    off = pkt_end
  }
  Ok(out)
}

///|
fn write_reception_report(out : Array[Byte], r : ReceptionReport) -> Unit {
  push_u32_be(out, r.ssrc)
  out.push((r.fraction_lost & 0xFF).to_byte())
  let lost_u = r.total_lost & 0xFFFFFF
  out.push(((lost_u >> 16) & 0xFF).to_byte())
  out.push(((lost_u >> 8) & 0xFF).to_byte())
  out.push((lost_u & 0xFF).to_byte())
  push_u32_be(out, r.last_seq)
  push_u32_be(out, r.jitter)
  push_u32_be(out, r.last_sr)
  push_u32_be(out, r.delay_since_last_sr)
}

///|
fn wrap_rtcp_header(count : Int, pt : Int, body : Array[Byte]) -> Result[Bytes, RtpError] {
  if count < 0 || count > 31 {
    return Err(RtpError::InvalidRtcp("RTCP RC/FMT must be in 0..31"))
  }
  while (body.length() & 3) != 0 {
    body.push(0.to_byte())
  }
  let words = body.length() >> 2
  if words > 65535 {
    return Err(RtpError::LimitExceeded("RTCP packet exceeds 16-bit word length"))
  }
  let out = Bytes::new(4 + body.length())
  out[0] = ((2 << 6) | (count & 0x1F)).to_byte()
  out[1] = (pt & 0xFF).to_byte()
  out[2] = ((words >> 8) & 0xFF).to_byte()
  out[3] = (words & 0xFF).to_byte()
  let mut i = 0
  while i < body.length() {
    out[4 + i] = body[i]
    i = i + 1
  }
  Ok(out)
}

///|
pub fn marshal_rtcp_packet(pkt : RtcpPacket) -> Result[Bytes, RtpError] {
  let body : Array[Byte] = []
  match pkt {
    RtcpPacket::Sr(sr) => {
      if sr.reports.length() > 31 {
        return Err(RtpError::LimitExceeded("RTCP SR supports at most 31 reception reports"))
      }
      push_u32_be(body, sr.ssrc)
      push_u64_be(body, sr.ntp_time)
      push_u32_be(body, sr.rtp_time)
      push_u32_be(body, sr.packet_count)
      push_u32_be(body, sr.octet_count)
      let mut i = 0
      while i < sr.reports.length() {
        write_reception_report(body, sr.reports[i])
        i = i + 1
      }
      push_bytes(body, sr.profile_extensions)
      wrap_rtcp_header(sr.reports.length(), 200, body)
    }
    RtcpPacket::Rr(rr) => {
      if rr.reports.length() > 31 {
        return Err(RtpError::LimitExceeded("RTCP RR supports at most 31 reception reports"))
      }
      push_u32_be(body, rr.ssrc)
      let mut i = 0
      while i < rr.reports.length() {
        write_reception_report(body, rr.reports[i])
        i = i + 1
      }
      push_bytes(body, rr.profile_extensions)
      wrap_rtcp_header(rr.reports.length(), 201, body)
    }
    RtcpPacket::Sdes(sdes) => {
      if sdes.chunks.length() > 31 {
        return Err(RtpError::LimitExceeded("RTCP SDES supports at most 31 chunks"))
      }
      let mut ci = 0
      while ci < sdes.chunks.length() {
        let ch = sdes.chunks[ci]
        let start = body.length()
        push_u32_be(body, ch.ssrc)
        let mut ii = 0
        while ii < ch.items.length() {
          let it = ch.items[ii]
          if it.item_type <= 0 || it.item_type > 255 {
            return Err(RtpError::InvalidRtcp("SDES item_type must be 1..255"))
          }
          if it.text.length() > 255 {
            return Err(RtpError::LimitExceeded("SDES item text exceeds 255 bytes"))
          }
          body.push((it.item_type & 0xFF).to_byte())
          body.push((it.text.length() & 0xFF).to_byte())
          push_bytes(body, it.text)
          ii = ii + 1
        }
        // End-of-list NUL + pad to 32-bit boundary
        body.push(0.to_byte())
        while ((body.length() - start) & 3) != 0 {
          body.push(0.to_byte())
        }
        ci = ci + 1
      }
      wrap_rtcp_header(sdes.chunks.length(), 202, body)
    }
    RtcpPacket::Bye(bye) => {
      if bye.sources.length() > 31 {
        return Err(RtpError::LimitExceeded("RTCP BYE supports at most 31 sources"))
      }
      let mut si = 0
      while si < bye.sources.length() {
        push_u32_be(body, bye.sources[si])
        si = si + 1
      }
      if bye.reason.length() > 0 {
        if bye.reason.length() > 255 {
          return Err(RtpError::LimitExceeded("RTCP BYE reason exceeds 255 bytes"))
        }
        body.push((bye.reason.length() & 0xFF).to_byte())
        push_bytes(body, bye.reason)
      }
      wrap_rtcp_header(bye.sources.length(), 203, body)
    }
    RtcpPacket::Nack(nack) => {
      push_u32_be(body, nack.sender_ssrc)
      push_u32_be(body, nack.media_ssrc)
      let mut i = 0
      while i < nack.nacks.length() {
        push_u16_be(body, nack.nacks[i].packet_id)
        push_u16_be(body, nack.nacks[i].lost_packets)
        i = i + 1
      }
      wrap_rtcp_header(1, 205, body)
    }
    RtcpPacket::Twcc(twcc) => {
      push_u32_be(body, twcc.sender_ssrc)
      push_u32_be(body, twcc.media_ssrc)
      push_bytes(body, twcc.payload)
      wrap_rtcp_header(15, 205, body)
    }
    RtcpPacket::Pli(pli) => {
      push_u32_be(body, pli.sender_ssrc)
      push_u32_be(body, pli.media_ssrc)
      wrap_rtcp_header(1, 206, body)
    }
    RtcpPacket::Fir(fir) => {
      push_u32_be(body, fir.sender_ssrc)
      push_u32_be(body, fir.media_ssrc)
      let mut i = 0
      while i < fir.entries.length() {
        push_u32_be(body, fir.entries[i].ssrc)
        body.push((fir.entries[i].sequence_number & 0xFF).to_byte())
        body.push(0.to_byte())
        body.push(0.to_byte())
        body.push(0.to_byte())
        i = i + 1
      }
      wrap_rtcp_header(4, 206, body)
    }
    RtcpPacket::Remb(remb) => {
      if remb.ssrcs.length() > 255 {
        return Err(RtpError::LimitExceeded("RTCP REMB supports at most 255 SSRCs"))
      }
      push_u32_be(body, remb.sender_ssrc)
      push_u32_be(body, remb.media_ssrc)
      // "REMB"
      body.push(0x52.to_byte())
      body.push(0x45.to_byte())
      body.push(0x4D.to_byte())
      body.push(0x42.to_byte())
      body.push((remb.ssrcs.length() & 0xFF).to_byte())
      let mut mantissa = remb.bitrate
      let mut exp = 0
      while mantissa > 0x3FFFFUL && exp < 63 {
        mantissa = mantissa >> 1
        exp = exp + 1
      }
      let m_int = (mantissa & 0x3FFFFUL).to_int()
      body.push((((exp & 0x3F) << 2) | ((m_int >> 16) & 0x03)).to_byte())
      body.push(((m_int >> 8) & 0xFF).to_byte())
      body.push((m_int & 0xFF).to_byte())
      let mut i = 0
      while i < remb.ssrcs.length() {
        push_u32_be(body, remb.ssrcs[i])
        i = i + 1
      }
      wrap_rtcp_header(15, 206, body)
    }
    RtcpPacket::Unknown(u) => {
      push_bytes(body, u.payload)
      wrap_rtcp_header(u.count, u.packet_type, body)
    }
  }
}

///|
pub fn marshal_rtcp(packets : Array[RtcpPacket]) -> Result[Bytes, RtpError] {
  if packets.length() == 0 {
    return Err(RtpError::InvalidRtcp("RTCP compound packet must contain at least one packet"))
  }
  let out : Array[Byte] = []
  let mut i = 0
  while i < packets.length() {
    let encoded = match marshal_rtcp_packet(packets[i]) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    push_bytes(out, encoded)
    i = i + 1
  }
  Ok(arr_to_bytes(out))
}
