///| RFC 3550 + RFC 4585 + RFC 5104 + REMB RTCP compound packet codec.

///|
fn write_u16_be(out : Bytes, off : Int, v : Int) -> Unit {
  out[off] = ((v >> 8) & 0xFF).to_byte()
  out[off + 1] = (v & 0xFF).to_byte()
}

///|
fn write_u32_be(out : Bytes, off : Int, v : UInt) -> Unit {
  out[off] = ((v >> 24U) & 0xFFU).to_int().to_byte()
  out[off + 1] = ((v >> 16U) & 0xFFU).to_int().to_byte()
  out[off + 2] = ((v >> 8U) & 0xFFU).to_int().to_byte()
  out[off + 3] = (v & 0xFFU).to_int().to_byte()
}

///|
fn write_u64_be(out : Bytes, off : Int, v : UInt64) -> Unit {
  out[off] = ((v >> 56) & 0xFFUL).to_int().to_byte()
  out[off + 1] = ((v >> 48) & 0xFFUL).to_int().to_byte()
  out[off + 2] = ((v >> 40) & 0xFFUL).to_int().to_byte()
  out[off + 3] = ((v >> 32) & 0xFFUL).to_int().to_byte()
  out[off + 4] = ((v >> 24) & 0xFFUL).to_int().to_byte()
  out[off + 5] = ((v >> 16) & 0xFFUL).to_int().to_byte()
  out[off + 6] = ((v >> 8) & 0xFFUL).to_int().to_byte()
  out[off + 7] = (v & 0xFFUL).to_int().to_byte()
}

///|
fn write_bytes_into(out : Bytes, off : Int, src : Bytes) -> Int {
  let n = src.length()
  let mut i = 0
  while i < n {
    out[off + i] = src[i]
    i = i + 1
  }
  off + n
}

///|
fn align4(n : Int) -> Int {
  let rem = n & 3
  if rem == 0 {
    n
  } else {
    n + (4 - rem)
  }
}

///| Expand RFC 4585 NACK pair (`packet_id` + 16-bit `lost_packets` BLP) with u16 wraparound.
pub fn NackPair::packet_list(self : NackPair) -> Array[Int] {
  let out : Array[Int] = [self.packet_id & 0xFFFF]
  let mut bit = 0
  while bit < 16 {
    if ((self.lost_packets >> bit) & 1) != 0 {
      out.push((self.packet_id + 1 + bit) & 0xFFFF)
    }
    bit = bit + 1
  }
  out
}

///|
fn parse_reception_reports(
  data : Bytes,
  start : Int,
  end : Int,
  count : Int,
  limits : DecodeLimits,
) -> Result[(Array[ReceptionReport], Int), RtpError] {
  if count > limits.max_report_blocks {
    return Err(RtpError::LimitExceeded("RTCP reception report count exceeds max_report_blocks"))
  }
  let need = count * 24
  if start + need > end {
    return Err(RtpError::Truncated("RTCP reception report block truncated"))
  }
  let reports : Array[ReceptionReport] = if count > 0 { Array::with_capacity(count) } else { [] }
  let mut pos = start
  let mut i = 0
  while i < count {
    let ssrc = read_u32_be(data, pos)
    let fraction_lost = data[pos + 4].to_int()
    let lost_u = (data[pos + 5].to_int() << 16) |
    (data[pos + 6].to_int() << 8) |
    data[pos + 7].to_int()
    let total_lost = if (lost_u & 0x800000) != 0 { lost_u - 0x1000000 } else { lost_u }
    let last_seq = read_u32_be(data, pos + 8)
    let jitter = read_u32_be(data, pos + 12)
    let last_sr = read_u32_be(data, pos + 16)
    let delay = read_u32_be(data, pos + 20)
    reports.push(ReceptionReport::{
      ssrc: ssrc,
      fraction_lost: fraction_lost,
      total_lost: total_lost,
      last_seq: last_seq,
      jitter: jitter,
      last_sr: last_sr,
      delay_since_last_sr: delay,
    })
    pos = pos + 24
    i = i + 1
  }
  Ok((reports, pos))
}

///|
pub fn parse_rtcp(data : Bytes) -> Result[Array[RtcpPacket], RtpError] {
  parse_rtcp_inner(data, default_decode_limits)
}

///|
pub fn parse_rtcp_with_limits(
  data : Bytes,
  limits : DecodeLimits,
) -> Result[Array[RtcpPacket], RtpError] {
  match validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  parse_rtcp_inner(data, limits)
}

///|
fn parse_rtcp_inner(
  data : Bytes,
  limits : DecodeLimits,
) -> Result[Array[RtcpPacket], RtpError] {
  let n = data.length()
  if n < 4 {
    return Err(RtpError::Truncated("RTCP packet shorter than 4 bytes"))
  }
  let out : Array[RtcpPacket] = Array::with_capacity(4)
  let max_pkts = limits.max_rtcp_packets
  let mut pkt_count = 0
  let mut off = 0
  while off < n {
    if pkt_count >= max_pkts {
      return Err(RtpError::LimitExceeded("RTCP compound packet count exceeds max_rtcp_packets"))
    }
    if off + 4 > n {
      return Err(RtpError::Truncated("RTCP common header truncated"))
    }
    let b0 = data[off].to_int()
    let version = (b0 >> 6) & 0x03
    if version != 2 {
      return Err(RtpError::InvalidVersion(version))
    }
    let padding = (b0 & 0x20) != 0
    let count = b0 & 0x1F
    let pt = data[off + 1].to_int()
    let words = (data[off + 2].to_int() << 8) | data[off + 3].to_int()
    let pkt_len = (words + 1) << 2
    let pkt_end = off + pkt_len
    if pkt_end > n {
      return Err(RtpError::Truncated("RTCP packet length exceeds buffer"))
    }

    let mut body_end = pkt_end
    if padding {
      if pkt_len <= 4 {
        return Err(RtpError::InvalidPadding("RTCP padding bit set with empty body"))
      }
      let pad_len = data[pkt_end - 1].to_int()
      if pad_len == 0 || pad_len > pkt_len - 4 {
        return Err(RtpError::InvalidPadding("invalid RTCP padding length"))
      }
      body_end = pkt_end - pad_len
    }

    let body_start = off + 4
    if pt == 200 {
      // Sender Report (SR)
      if body_start + 24 > body_end {
        return Err(RtpError::Truncated("RTCP SR truncated"))
      }
      let ssrc = read_u32_be(data, body_start)
      let ntp_hi = read_u32_be(data, body_start + 4).to_uint64()
      let ntp_lo = read_u32_be(data, body_start + 8).to_uint64()
      let ntp_time = (ntp_hi << 32) | ntp_lo
      let rtp_time = read_u32_be(data, body_start + 12)
      let packet_count = read_u32_be(data, body_start + 16)
      let octet_count = read_u32_be(data, body_start + 20)
      let (reports, next_pos) = match
      parse_reception_reports(data, body_start + 24, body_end, count, limits) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let ext = slice_bytes(data, next_pos, body_end)
      out.push(
        RtcpPacket::Sr(SenderReport::{
          ssrc: ssrc,
          ntp_time: ntp_time,
          rtp_time: rtp_time,
          packet_count: packet_count,
          octet_count: octet_count,
          reports: reports,
          profile_extensions: ext,
        }),
      )
    } else if pt == 201 {
      // Receiver Report (RR)
      if body_start + 4 > body_end {
        return Err(RtpError::Truncated("RTCP RR truncated"))
      }
      let ssrc = read_u32_be(data, body_start)
      let (reports, next_pos) = match
      parse_reception_reports(data, body_start + 4, body_end, count, limits) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let ext = slice_bytes(data, next_pos, body_end)
      out.push(
        RtcpPacket::Rr(ReceiverReport::{
          ssrc: ssrc,
          reports: reports,
          profile_extensions: ext,
        }),
      )
    } else if pt == 202 {
      // Source Description (SDES)
      if count > limits.max_sdes_chunks {
        return Err(RtpError::LimitExceeded("SDES chunk count exceeds max_sdes_chunks"))
      }
      let chunks : Array[SdesChunk] = []
      let mut pos = body_start
      let mut ci = 0
      while ci < count {
        if pos + 4 > body_end {
          return Err(RtpError::Truncated("RTCP SDES chunk truncated"))
        }
        let chunk_start = pos
        let ssrc = read_u32_be(data, pos)
        pos = pos + 4
        let items : Array[SdesItem] = []
        let mut ended = false
        while pos < body_end {
          let itype = data[pos].to_int()
          if itype == 0 {
            pos = pos + 1
            ended = true
            break
          }
          if pos + 2 > body_end {
            return Err(RtpError::Truncated("RTCP SDES item header truncated"))
          }
          let ilen = data[pos + 1].to_int()
          if pos + 2 + ilen > body_end {
            return Err(RtpError::Truncated("RTCP SDES item text truncated"))
          }
          if items.length() >= limits.max_sdes_items {
            return Err(RtpError::LimitExceeded("SDES item count exceeds max_sdes_items"))
          }
          items.push(SdesItem::{ item_type: itype, text: slice_bytes(data, pos + 2, pos + 2 + ilen) })
          pos = pos + 2 + ilen
        }
        if !ended {
          return Err(RtpError::InvalidRtcp("RTCP SDES chunk missing NUL terminator"))
        }
        // Align to 32-bit boundary relative to chunk_start
        let rem = (pos - chunk_start) & 3
        if rem != 0 {
          let pad = 4 - rem
          if pos + pad > body_end {
            return Err(RtpError::Truncated("RTCP SDES chunk padding truncated"))
          }
          pos = pos + pad
        }
        chunks.push(SdesChunk::{ ssrc: ssrc, items: items })
        ci = ci + 1
      }
      out.push(RtcpPacket::Sdes(SourceDescription::{ chunks: chunks }))
    } else if pt == 203 {
      // Goodbye (BYE)
      if body_start + (count << 2) > body_end {
        return Err(RtpError::Truncated("RTCP BYE SSRC list truncated"))
      }
      let sources : Array[UInt] = []
      let mut pos = body_start
      let mut si = 0
      while si < count {
        sources.push(read_u32_be(data, pos))
        pos = pos + 4
        si = si + 1
      }
      let mut reason = empty_bytes
      if pos < body_end {
        let rlen = data[pos].to_int()
        if pos + 1 + rlen > body_end {
          return Err(RtpError::Truncated("RTCP BYE reason truncated"))
        }
        reason = slice_bytes(data, pos + 1, pos + 1 + rlen)
      }
      out.push(RtcpPacket::Bye(Goodbye::{ sources: sources, reason: reason }))
    } else if pt == 205 {
      // Transport-Layer Feedback (RTPFB)
      if body_start + 8 > body_end {
        return Err(RtpError::Truncated("RTCP RTPFB header truncated"))
      }
      let sender_ssrc = read_u32_be(data, body_start)
      let media_ssrc = read_u32_be(data, body_start + 4)
      let fci_start = body_start + 8
      if count == 1 {
        // Generic NACK (FMT=1)
        let fci_len = body_end - fci_start
        if (fci_len & 3) != 0 {
          return Err(RtpError::InvalidRtcp("RTCP NACK FCI not 32-bit aligned"))
        }
        let n_pairs = fci_len >> 2
        if n_pairs > limits.max_nacks {
          return Err(RtpError::LimitExceeded("RTCP NACK pair count exceeds max_nacks"))
        }
        let nacks : Array[NackPair] = if n_pairs > 0 { Array::with_capacity(n_pairs) } else { [] }
        let mut pos = fci_start
        while pos < body_end {
          let pid = (data[pos].to_int() << 8) | data[pos + 1].to_int()
          let blp = (data[pos + 2].to_int() << 8) | data[pos + 3].to_int()
          nacks.push(NackPair::{ packet_id: pid, lost_packets: blp })
          pos = pos + 4
        }
        out.push(
          RtcpPacket::Nack(TransportLayerNack::{
            sender_ssrc: sender_ssrc,
            media_ssrc: media_ssrc,
            nacks: nacks,
          }),
        )
      } else if count == 15 {
        // Transport-Wide CC (FMT=15)
        out.push(
          RtcpPacket::Twcc(TransportWideCc::{
            sender_ssrc: sender_ssrc,
            media_ssrc: media_ssrc,
            payload: slice_bytes(data, fci_start, body_end),
          }),
        )
      } else {
        out.push(
          RtcpPacket::Unknown(UnknownRtcp::{
            packet_type: pt,
            count: count,
            payload: slice_bytes(data, body_start, body_end),
          }),
        )
      }
    } else if pt == 206 {
      // Payload-Specific Feedback (PSFB)
      if body_start + 8 > body_end {
        return Err(RtpError::Truncated("RTCP PSFB header truncated"))
      }
      let sender_ssrc = read_u32_be(data, body_start)
      let media_ssrc = read_u32_be(data, body_start + 4)
      let fci_start = body_start + 8
      if count == 1 {
        // PLI (FMT=1)
        out.push(
          RtcpPacket::Pli(PictureLossIndication::{
            sender_ssrc: sender_ssrc,
            media_ssrc: media_ssrc,
          }),
        )
      } else if count == 4 {
        // FIR (FMT=4)
        let fci_len = body_end - fci_start
        if (fci_len & 7) != 0 {
          return Err(RtpError::InvalidRtcp("RTCP FIR FCI must be a multiple of 8 bytes"))
        }
        let entries : Array[FirEntry] = []
        let mut pos = fci_start
        while pos < body_end {
          let essrc = read_u32_be(data, pos)
          let seq_nr = data[pos + 4].to_int()
          entries.push(FirEntry::{ ssrc: essrc, sequence_number: seq_nr })
          pos = pos + 8
        }
        out.push(
          RtcpPacket::Fir(FullIntraRequest::{
            sender_ssrc: sender_ssrc,
            media_ssrc: media_ssrc,
            entries: entries,
          }),
        )
      } else if count == 15 {
        // AFB -> REMB (FMT=15)
        if fci_start + 8 > body_end {
          return Err(RtpError::Truncated("RTCP REMB FCI truncated"))
        }
        let is_remb = data[fci_start].to_int() == 0x52 &&
        data[fci_start + 1].to_int() == 0x45 &&
        data[fci_start + 2].to_int() == 0x4D &&
        data[fci_start + 3].to_int() == 0x42
        if !is_remb {
          out.push(
            RtcpPacket::Unknown(UnknownRtcp::{
              packet_type: pt,
              count: count,
              payload: slice_bytes(data, body_start, body_end),
            }),
          )
        } else {
          let num_ssrcs = data[fci_start + 4].to_int()
          let b5 = data[fci_start + 5].to_int()
          let b6 = data[fci_start + 6].to_int()
          let b7 = data[fci_start + 7].to_int()
          let exp = (b5 >> 2) & 0x3F
          let mantissa : UInt64 = (((b5 & 0x03) << 16) | (b6 << 8) | b7).to_int64().to_uint64()
          let bitrate = if mantissa == 0UL {
            0UL
          } else if exp >= 64 || mantissa > (0xFFFFFFFFFFFFFFFFUL >> exp) {
            0xFFFFFFFFFFFFFFFFUL
          } else {
            mantissa << exp
          }
          let ssrc_start = fci_start + 8
          if ssrc_start + (num_ssrcs << 2) > body_end {
            return Err(RtpError::Truncated("RTCP REMB SSRC list truncated"))
          }
          let ssrcs : Array[UInt] = []
          let mut si = 0
          while si < num_ssrcs {
            ssrcs.push(read_u32_be(data, ssrc_start + (si << 2)))
            si = si + 1
          }
          out.push(
            RtcpPacket::Remb(ReceiverEstimatedMaximumBitrate::{
              sender_ssrc: sender_ssrc,
              media_ssrc: media_ssrc,
              bitrate: bitrate,
              ssrcs: ssrcs,
            }),
          )
        }
      } else {
        out.push(
          RtcpPacket::Unknown(UnknownRtcp::{
            packet_type: pt,
            count: count,
            payload: slice_bytes(data, body_start, body_end),
          }),
        )
      }
    } else {
      out.push(
        RtcpPacket::Unknown(UnknownRtcp::{
          packet_type: pt,
          count: count,
          payload: slice_bytes(data, body_start, body_end),
        }),
      )
    }

    pkt_count = pkt_count + 1
    off = pkt_end
  }
  Ok(out)
}

///|
fn validate_reception_reports(reports : Array[ReceptionReport]) -> Result[Unit, RtpError] {
  let n = reports.length()
  let mut i = 0
  while i < n {
    let r = reports[i]
    if r.fraction_lost < 0 || r.fraction_lost > 255 {
      return Err(RtpError::InvalidArgument("RTCP fraction_lost must be in 0..255"))
    }
    if r.total_lost < -8388608 || r.total_lost > 8388607 {
      return Err(RtpError::InvalidArgument("RTCP total_lost must be signed 24-bit"))
    }
    i = i + 1
  }
  Ok(())
}

///|
fn write_reception_report_into(out : Bytes, off : Int, r : ReceptionReport) -> Int {
  write_u32_be(out, off, r.ssrc)
  out[off + 4] = (r.fraction_lost & 0xFF).to_byte()
  let lost_u = r.total_lost & 0xFFFFFF
  out[off + 5] = ((lost_u >> 16) & 0xFF).to_byte()
  out[off + 6] = ((lost_u >> 8) & 0xFF).to_byte()
  out[off + 7] = (lost_u & 0xFF).to_byte()
  write_u32_be(out, off + 8, r.last_seq)
  write_u32_be(out, off + 12, r.jitter)
  write_u32_be(out, off + 16, r.last_sr)
  write_u32_be(out, off + 20, r.delay_since_last_sr)
  off + 24
}

///| Validate an RTCP packet and compute its exact wire byte length (4-byte header + aligned body).
fn rtcp_packet_wire_len(pkt : RtcpPacket) -> Result[Int, RtpError] {
  let body_len = match pkt {
    RtcpPacket::Sr(sr) => {
      if sr.reports.length() > 31 {
        return Err(RtpError::LimitExceeded("RTCP SR supports at most 31 reception reports"))
      }
      match validate_reception_reports(sr.reports) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      align4(24 + sr.reports.length() * 24 + sr.profile_extensions.length())
    }
    RtcpPacket::Rr(rr) => {
      if rr.reports.length() > 31 {
        return Err(RtpError::LimitExceeded("RTCP RR supports at most 31 reception reports"))
      }
      match validate_reception_reports(rr.reports) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      align4(4 + rr.reports.length() * 24 + rr.profile_extensions.length())
    }
    RtcpPacket::Sdes(sdes) => {
      if sdes.chunks.length() > 31 {
        return Err(RtpError::LimitExceeded("RTCP SDES supports at most 31 chunks"))
      }
      let mut total = 0
      let mut ci = 0
      while ci < sdes.chunks.length() {
        let ch = sdes.chunks[ci]
        let mut clen = 4
        let mut ii = 0
        while ii < ch.items.length() {
          let it = ch.items[ii]
          if it.item_type <= 0 || it.item_type > 255 {
            return Err(RtpError::InvalidRtcp("SDES item_type must be 1..255"))
          }
          if it.text.length() > 255 {
            return Err(RtpError::LimitExceeded("SDES item text exceeds 255 bytes"))
          }
          clen = clen + 2 + it.text.length()
          ii = ii + 1
        }
        total = total + align4(clen + 1)
        ci = ci + 1
      }
      total
    }
    RtcpPacket::Bye(bye) => {
      if bye.sources.length() > 31 {
        return Err(RtpError::LimitExceeded("RTCP BYE supports at most 31 sources"))
      }
      let rlen = bye.reason.length()
      if rlen > 255 {
        return Err(RtpError::LimitExceeded("RTCP BYE reason exceeds 255 bytes"))
      }
      align4((bye.sources.length() << 2) + (if rlen > 0 { 1 + rlen } else { 0 }))
    }
    RtcpPacket::Nack(nack) => {
      let mut i = 0
      while i < nack.nacks.length() {
        let np = nack.nacks[i]
        if np.packet_id < 0 || np.packet_id > 65535 {
          return Err(RtpError::InvalidArgument("NACK packet_id must be in 0..65535"))
        }
        if np.lost_packets < 0 || np.lost_packets > 65535 {
          return Err(RtpError::InvalidArgument("NACK lost_packets must be in 0..65535"))
        }
        i = i + 1
      }
      8 + (nack.nacks.length() << 2)
    }
    RtcpPacket::Twcc(twcc) => align4(8 + twcc.payload.length())
    RtcpPacket::Pli(_) => 8
    RtcpPacket::Fir(fir) => {
      let mut i = 0
      while i < fir.entries.length() {
        if fir.entries[i].sequence_number < 0 || fir.entries[i].sequence_number > 255 {
          return Err(RtpError::InvalidArgument("FIR sequence_number must be in 0..255"))
        }
        i = i + 1
      }
      8 + (fir.entries.length() << 3)
    }
    RtcpPacket::Remb(remb) => {
      if remb.ssrcs.length() > 255 {
        return Err(RtpError::LimitExceeded("RTCP REMB supports at most 255 SSRCs"))
      }
      16 + (remb.ssrcs.length() << 2)
    }
    RtcpPacket::Unknown(u) => {
      if u.count < 0 || u.count > 31 {
        return Err(RtpError::InvalidRtcp("RTCP RC/FMT must be in 0..31"))
      }
      if u.packet_type < 0 || u.packet_type > 255 {
        return Err(RtpError::InvalidArgument("RTCP packet_type must be in 0..255"))
      }
      align4(u.payload.length())
    }
  }
  let words = body_len >> 2
  if words > 65535 {
    return Err(RtpError::LimitExceeded("RTCP packet exceeds 16-bit word length"))
  }
  Ok(4 + body_len)
}

///| Write a pre-validated RTCP packet directly into `out[start .. start + pkt_len]`.
fn write_rtcp_packet_into(out : Bytes, start : Int, pkt : RtcpPacket, pkt_len : Int) -> Unit {
  let words = (pkt_len - 4) >> 2
  match pkt {
    RtcpPacket::Sr(sr) => {
      out[start] = (0x80 | (sr.reports.length() & 0x1F)).to_byte()
      out[start + 1] = 200.to_byte()
      write_u16_be(out, start + 2, words)
      write_u32_be(out, start + 4, sr.ssrc)
      write_u64_be(out, start + 8, sr.ntp_time)
      write_u32_be(out, start + 16, sr.rtp_time)
      write_u32_be(out, start + 20, sr.packet_count)
      write_u32_be(out, start + 24, sr.octet_count)
      let mut pos = start + 28
      let mut i = 0
      while i < sr.reports.length() {
        pos = write_reception_report_into(out, pos, sr.reports[i])
        i = i + 1
      }
      if sr.profile_extensions.length() > 0 {
        let _ = write_bytes_into(out, pos, sr.profile_extensions)
      }
    }
    RtcpPacket::Rr(rr) => {
      out[start] = (0x80 | (rr.reports.length() & 0x1F)).to_byte()
      out[start + 1] = 201.to_byte()
      write_u16_be(out, start + 2, words)
      write_u32_be(out, start + 4, rr.ssrc)
      let mut pos = start + 8
      let mut i = 0
      while i < rr.reports.length() {
        pos = write_reception_report_into(out, pos, rr.reports[i])
        i = i + 1
      }
      if rr.profile_extensions.length() > 0 {
        let _ = write_bytes_into(out, pos, rr.profile_extensions)
      }
    }
    RtcpPacket::Sdes(sdes) => {
      out[start] = (0x80 | (sdes.chunks.length() & 0x1F)).to_byte()
      out[start + 1] = 202.to_byte()
      write_u16_be(out, start + 2, words)
      let mut pos = start + 4
      let mut ci = 0
      while ci < sdes.chunks.length() {
        let ch = sdes.chunks[ci]
        let cstart = pos
        write_u32_be(out, pos, ch.ssrc)
        pos = pos + 4
        let mut ii = 0
        while ii < ch.items.length() {
          let it = ch.items[ii]
          out[pos] = (it.item_type & 0xFF).to_byte()
          out[pos + 1] = (it.text.length() & 0xFF).to_byte()
          pos = write_bytes_into(out, pos + 2, it.text)
          ii = ii + 1
        }
        // End-of-list NUL + 32-bit zero padding (already 0-initialized by Bytes::new)
        pos = cstart + align4(pos - cstart + 1)
        ci = ci + 1
      }
    }
    RtcpPacket::Bye(bye) => {
      out[start] = (0x80 | (bye.sources.length() & 0x1F)).to_byte()
      out[start + 1] = 203.to_byte()
      write_u16_be(out, start + 2, words)
      let mut pos = start + 4
      let mut si = 0
      while si < bye.sources.length() {
        write_u32_be(out, pos, bye.sources[si])
        pos = pos + 4
        si = si + 1
      }
      if bye.reason.length() > 0 {
        out[pos] = (bye.reason.length() & 0xFF).to_byte()
        let _ = write_bytes_into(out, pos + 1, bye.reason)
      }
    }
    RtcpPacket::Nack(nack) => {
      out[start] = 0x81.to_byte()
      out[start + 1] = 205.to_byte()
      write_u16_be(out, start + 2, words)
      write_u32_be(out, start + 4, nack.sender_ssrc)
      write_u32_be(out, start + 8, nack.media_ssrc)
      let mut pos = start + 12
      let mut i = 0
      while i < nack.nacks.length() {
        let np = nack.nacks[i]
        write_u16_be(out, pos, np.packet_id)
        write_u16_be(out, pos + 2, np.lost_packets)
        pos = pos + 4
        i = i + 1
      }
    }
    RtcpPacket::Twcc(twcc) => {
      out[start] = 0x8F.to_byte()
      out[start + 1] = 205.to_byte()
      write_u16_be(out, start + 2, words)
      write_u32_be(out, start + 4, twcc.sender_ssrc)
      write_u32_be(out, start + 8, twcc.media_ssrc)
      if twcc.payload.length() > 0 {
        let _ = write_bytes_into(out, start + 12, twcc.payload)
      }
    }
    RtcpPacket::Pli(pli) => {
      out[start] = 0x81.to_byte()
      out[start + 1] = 206.to_byte()
      write_u16_be(out, start + 2, 2)
      write_u32_be(out, start + 4, pli.sender_ssrc)
      write_u32_be(out, start + 8, pli.media_ssrc)
    }
    RtcpPacket::Fir(fir) => {
      out[start] = 0x84.to_byte()
      out[start + 1] = 206.to_byte()
      write_u16_be(out, start + 2, words)
      write_u32_be(out, start + 4, fir.sender_ssrc)
      write_u32_be(out, start + 8, fir.media_ssrc)
      let mut pos = start + 12
      let mut i = 0
      while i < fir.entries.length() {
        write_u32_be(out, pos, fir.entries[i].ssrc)
        out[pos + 4] = (fir.entries[i].sequence_number & 0xFF).to_byte()
        pos = pos + 8
        i = i + 1
      }
    }
    RtcpPacket::Remb(remb) => {
      out[start] = 0x8F.to_byte()
      out[start + 1] = 206.to_byte()
      write_u16_be(out, start + 2, words)
      write_u32_be(out, start + 4, remb.sender_ssrc)
      write_u32_be(out, start + 8, remb.media_ssrc)
      out[start + 12] = 0x52.to_byte()
      out[start + 13] = 0x45.to_byte()
      out[start + 14] = 0x4D.to_byte()
      out[start + 15] = 0x42.to_byte()
      out[start + 16] = (remb.ssrcs.length() & 0xFF).to_byte()
      let mut mantissa = remb.bitrate
      let mut exp = 0
      while mantissa > 0x3FFFFUL && exp < 63 {
        mantissa = mantissa >> 1
        exp = exp + 1
      }
      let m_int = (mantissa & 0x3FFFFUL).to_int()
      out[start + 17] = (((exp & 0x3F) << 2) | ((m_int >> 16) & 0x03)).to_byte()
      out[start + 18] = ((m_int >> 8) & 0xFF).to_byte()
      out[start + 19] = (m_int & 0xFF).to_byte()
      let mut pos = start + 20
      let mut i = 0
      while i < remb.ssrcs.length() {
        write_u32_be(out, pos, remb.ssrcs[i])
        pos = pos + 4
        i = i + 1
      }
    }
    RtcpPacket::Unknown(u) => {
      out[start] = (0x80 | (u.count & 0x1F)).to_byte()
      out[start + 1] = (u.packet_type & 0xFF).to_byte()
      write_u16_be(out, start + 2, words)
      if u.payload.length() > 0 {
        let _ = write_bytes_into(out, start + 4, u.payload)
      }
    }
  }
}

///|
pub fn marshal_rtcp_packet(pkt : RtcpPacket) -> Result[Bytes, RtpError] {
  let pkt_len = match rtcp_packet_wire_len(pkt) {
    Ok(l) => l
    Err(e) => return Err(e)
  }
  let out = Bytes::new(pkt_len)
  write_rtcp_packet_into(out, 0, pkt, pkt_len)
  Ok(out)
}

///|
pub fn marshal_rtcp(packets : Array[RtcpPacket]) -> Result[Bytes, RtpError] {
  let n = packets.length()
  if n == 0 {
    return Err(RtpError::InvalidRtcp("RTCP compound packet must contain at least one packet"))
  }
  if n == 1 {
    return marshal_rtcp_packet(packets[0])
  }
  let lens : FixedArray[Int] = FixedArray::make(n, 0)
  let mut total_len = 0
  let mut i = 0
  while i < n {
    let l = match rtcp_packet_wire_len(packets[i]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    lens[i] = l
    total_len = total_len + l
    i = i + 1
  }
  let out = Bytes::new(total_len)
  let mut off = 0
  let mut j = 0
  while j < n {
    let l = lens[j]
    write_rtcp_packet_into(out, off, packets[j], l)
    off = off + l
    j = j + 1
  }
  Ok(out)
}
