///| RFC 3550 RTP + RFC 5285 Header Extensions + RFC 7983 Demux.

///|
let empty_bytes : Bytes = Bytes::new(0)

///|
let default_decode_limits : DecodeLimits = DecodeLimits::default()

///|
fn read_u16_be(data : Bytes, off : Int) -> Int {
  (data[off].to_int() << 8) | data[off + 1].to_int()
}

///|
fn read_u32_be(data : Bytes, off : Int) -> UInt {
  (data[off].to_int().to_uint() << 24U) |
  (data[off + 1].to_int().to_uint() << 16U) |
  (data[off + 2].to_int().to_uint() << 8U) |
  data[off + 3].to_int().to_uint()
}

///|
fn slice_bytes(data : Bytes, start : Int, end : Int) -> Bytes {
  if end <= start {
    return empty_bytes
  }
  data.slice(start, end)
}

///| RFC 7983 §7 + RFC 5761 §4: returns true if `data` is an RTCP packet.
pub fn is_rtcp_packet(data : Bytes) -> Bool {
  if data.length() < 8 {
    return false
  }
  let b0 = data[0].to_int()
  if b0 < 128 || b0 > 191 {
    return false
  }
  let pt = data[1].to_int() & 0x7F
  pt >= 64 && pt <= 95
}

///| RFC 7983 §7 + RFC 5761 §4: returns true if `data` is an RTP packet (not RTCP, STUN, or DTLS).
pub fn is_rtp_packet(data : Bytes) -> Bool {
  if data.length() < 12 {
    return false
  }
  let b0 = data[0].to_int()
  if b0 < 128 || b0 > 191 {
    return false
  }
  let pt = data[1].to_int() & 0x7F
  !(pt >= 64 && pt <= 95)
}

///| Compute the byte length of the RTP header (fixed 12B + CSRCs + optional extension block).
pub fn rtp_header_len(data : Bytes) -> Result[Int, RtpError] {
  let n = data.length()
  if n < 12 {
    return Err(RtpError::Truncated("RTP packet shorter than 12-byte fixed header"))
  }
  let b0 = data[0].to_int()
  let version = (b0 >> 6) & 0x03
  if version != 2 {
    return Err(RtpError::InvalidVersion(version))
  }
  let has_ext = (b0 & 0x10) != 0
  let cc = b0 & 0x0F
  let mut off = 12 + (cc << 2)
  if off > n {
    return Err(RtpError::Truncated("RTP CSRC list truncated"))
  }
  if has_ext {
    if off + 4 > n {
      return Err(RtpError::Truncated("RTP header extension prefix truncated"))
    }
    let ext_words = read_u16_be(data, off + 2)
    off = off + 4 + (ext_words << 2)
    if off > n {
      return Err(RtpError::Truncated("RTP header extension body truncated"))
    }
  }
  Ok(off)
}

///|
pub fn parse_rtp(data : Bytes) -> Result[RtpPacket, RtpError] {
  parse_rtp_inner(data, default_decode_limits)
}

///|
pub fn parse_rtp_with_limits(data : Bytes, limits : DecodeLimits) -> Result[RtpPacket, RtpError] {
  match validate_limits(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  parse_rtp_inner(data, limits)
}

///|
fn parse_rtp_inner(data : Bytes, limits : DecodeLimits) -> Result[RtpPacket, RtpError] {
  let n = data.length()
  if n < 12 {
    return Err(RtpError::Truncated("RTP packet shorter than 12 bytes"))
  }
  let b0 = data[0].to_int()
  let b1 = data[1].to_int()
  let version = (b0 >> 6) & 0x03
  if version != 2 {
    return Err(RtpError::InvalidVersion(version))
  }
  let padding = (b0 & 0x20) != 0
  let extension = (b0 & 0x10) != 0
  let cc = b0 & 0x0F
  if cc > limits.max_csrcs {
    return Err(RtpError::LimitExceeded("CSRC count exceeds max_csrcs"))
  }
  let marker = (b1 & 0x80) != 0
  let payload_type = b1 & 0x7F
  let sequence_number = (data[2].to_int() << 8) | data[3].to_int()
  let timestamp = read_u32_be(data, 4)
  let ssrc = read_u32_be(data, 8)

  let mut off = 12
  let csrc_bytes = cc << 2
  if off + csrc_bytes > n {
    return Err(RtpError::Truncated("RTP CSRC list exceeds packet length"))
  }
  let csrcs : Array[UInt] = if cc > 0 { Array::with_capacity(cc) } else { [] }
  if cc > 0 {
    let mut ci = 0
    while ci < cc {
      csrcs.push(read_u32_be(data, off))
      off = off + 4
      ci = ci + 1
    }
  }

  let mut extension_profile = 0
  let mut extensions : Array[HeaderExtension] = []
  let mut raw_extension_payload = empty_bytes

  if extension {
    if off + 4 > n {
      return Err(RtpError::Truncated("RTP extension header truncated"))
    }
    extension_profile = (data[off].to_int() << 8) | data[off + 1].to_int()
    let ext_words = (data[off + 2].to_int() << 8) | data[off + 3].to_int()
    let ext_len = ext_words << 2
    if ext_len > limits.max_extension_bytes {
      return Err(RtpError::LimitExceeded("extension size exceeds max_extension_bytes"))
    }
    off = off + 4
    let ext_end = off + ext_len
    if ext_end > n {
      return Err(RtpError::Truncated("RTP extension payload exceeds packet length"))
    }
    if extension_profile == 0xBEDE {
      // RFC 5285 §4.2 One-Byte Header
      if ext_len > 0 {
        extensions = Array::with_capacity(4)
      }
      let max_exts = limits.max_extensions
      let mut ext_count = 0
      let mut pos = off
      while pos < ext_end {
        let hdr = data[pos].to_int()
        if hdr == 0 {
          pos = pos + 1
          continue
        }
        let id = (hdr >> 4) & 0x0F
        if id == 15 {
          break
        }
        let elen = (hdr & 0x0F) + 1
        let val_start = pos + 1
        let val_end = val_start + elen
        if val_end > ext_end {
          return Err(RtpError::InvalidExtension("one-byte extension overflows extension block"))
        }
        if ext_count >= max_exts {
          return Err(RtpError::LimitExceeded("extension count exceeds max_extensions"))
        }
        extensions.push(HeaderExtension::{ id: id, payload: data.slice(val_start, val_end) })
        ext_count = ext_count + 1
        pos = val_end
      }
    } else if (extension_profile & 0xFFF0) == 0x1000 {
      // RFC 5285 §4.3 Two-Byte Header
      let max_exts = limits.max_extensions
      let mut ext_count = 0
      let mut pos = off
      while pos < ext_end {
        let id = data[pos].to_int()
        if id == 0 {
          pos = pos + 1
          continue
        }
        if pos + 2 > ext_end {
          return Err(RtpError::InvalidExtension("two-byte extension header truncated"))
        }
        let elen = data[pos + 1].to_int()
        let val_start = pos + 2
        let val_end = val_start + elen
        if val_end > ext_end {
          return Err(RtpError::InvalidExtension("two-byte extension overflows extension block"))
        }
        if ext_count >= max_exts {
          return Err(RtpError::LimitExceeded("extension count exceeds max_extensions"))
        }
        let ep = if elen == 0 { empty_bytes } else { data.slice(val_start, val_end) }
        extensions.push(HeaderExtension::{ id: id, payload: ep })
        ext_count = ext_count + 1
        pos = val_end
      }
    } else if ext_len > 0 {
      raw_extension_payload = data.slice(off, ext_end)
    }
    off = ext_end
  }

  let mut payload_end = n
  let mut padding_size = 0
  if padding {
    if payload_end <= off {
      return Err(RtpError::InvalidPadding("padding bit set on empty payload"))
    }
    let pad_len = data[n - 1].to_int()
    if pad_len == 0 || pad_len > payload_end - off {
      return Err(RtpError::InvalidPadding("invalid RTP padding length"))
    }
    padding_size = pad_len
    payload_end = payload_end - pad_len
  }

  let payload_len = payload_end - off
  if payload_len > limits.max_payload_bytes {
    return Err(RtpError::LimitExceeded("payload exceeds max_payload_bytes"))
  }

  let payload = if payload_len > 0 { data.slice(off, payload_end) } else { empty_bytes }

  Ok(RtpPacket::{
    header: RtpHeader::{
      version: version,
      padding: padding,
      extension: extension,
      marker: marker,
      payload_type: payload_type,
      sequence_number: sequence_number,
      timestamp: timestamp,
      ssrc: ssrc,
      csrcs: csrcs,
      extension_profile: extension_profile,
      extensions: extensions,
      raw_extension_payload: raw_extension_payload,
    },
    payload: payload,
    padding_size: padding_size,
  })
}

///|
pub fn marshal_rtp(pkt : RtpPacket) -> Result[Bytes, RtpError] {
  let h = pkt.header
  if h.version != 2 {
    return Err(RtpError::InvalidVersion(h.version))
  }
  if h.payload_type < 0 || h.payload_type > 127 {
    return Err(RtpError::InvalidPayloadType(h.payload_type))
  }
  if h.sequence_number < 0 || h.sequence_number > 65535 {
    return Err(RtpError::InvalidArgument("sequence_number must be in 0..65535"))
  }
  if h.extension && (h.extension_profile < 0 || h.extension_profile > 65535) {
    return Err(RtpError::InvalidArgument("extension_profile must be in 0..65535"))
  }
  let cc = h.csrcs.length()
  if cc > 15 {
    return Err(RtpError::LimitExceeded("RTP header supports at most 15 CSRCs"))
  }
  if h.padding && (pkt.padding_size < 1 || pkt.padding_size > 255) {
    return Err(RtpError::InvalidPadding("padding_size must be in 1..255 when padding=true"))
  }
  if !h.padding && pkt.padding_size != 0 {
    return Err(RtpError::InvalidPadding("padding_size must be 0 when padding=false"))
  }

  // Pass 1: validate extensions and compute exact padded extension body length without allocation.
  let has_ext = h.extension
  let mut ext_kind = 0
  let mut ext_body_len = 0
  if has_ext {
    if h.extension_profile == 0xBEDE {
      ext_kind = 1
      let exts = h.extensions
      let n_exts = exts.length()
      let mut unpadded = 0
      let mut i = 0
      while i < n_exts {
        let e = exts[i]
        let elen = e.payload.length()
        if e.id < 1 || e.id > 14 {
          return Err(RtpError::InvalidExtension("one-byte extension id must be 1..14"))
        }
        if elen < 1 || elen > 16 {
          return Err(RtpError::InvalidExtension("one-byte extension length must be 1..16"))
        }
        unpadded = unpadded + 1 + elen
        i = i + 1
      }
      let rem = unpadded & 3
      ext_body_len = if rem == 0 { unpadded } else { unpadded + (4 - rem) }
    } else if (h.extension_profile & 0xFFF0) == 0x1000 {
      ext_kind = 2
      let exts = h.extensions
      let n_exts = exts.length()
      let mut unpadded = 0
      let mut i = 0
      while i < n_exts {
        let e = exts[i]
        let elen = e.payload.length()
        if e.id < 1 || e.id > 255 {
          return Err(RtpError::InvalidExtension("two-byte extension id must be 1..255"))
        }
        if elen > 255 {
          return Err(RtpError::InvalidExtension("two-byte extension length must be <= 255"))
        }
        unpadded = unpadded + 2 + elen
        i = i + 1
      }
      let rem = unpadded & 3
      ext_body_len = if rem == 0 { unpadded } else { unpadded + (4 - rem) }
    } else {
      ext_kind = 3
      let rlen = h.raw_extension_payload.length()
      if (rlen & 3) != 0 {
        return Err(RtpError::InvalidExtension("raw extension payload must be 32-bit aligned"))
      }
      ext_body_len = rlen
    }
    if ext_body_len > 65535 * 4 {
      return Err(RtpError::LimitExceeded("RTP header extension exceeds 16-bit word length"))
    }
  }

  let fixed_hdr_len = 12 + (cc << 2)
  let hdr_alloc_len = if !has_ext {
    fixed_hdr_len
  } else if ext_kind == 3 {
    fixed_hdr_len + 4
  } else {
    fixed_hdr_len + 4 + ext_body_len
  }

  let hdr = Bytes::new(hdr_alloc_len)
  let b0 = 0x80 |
  (if h.padding { 0x20 } else { 0 }) |
  (if has_ext { 0x10 } else { 0 }) |
  (cc & 0x0F)
  let b1 = (if h.marker { 0x80 } else { 0 }) | (h.payload_type & 0x7F)
  hdr[0] = b0.to_byte()
  hdr[1] = b1.to_byte()
  hdr[2] = ((h.sequence_number >> 8) & 0xFF).to_byte()
  hdr[3] = (h.sequence_number & 0xFF).to_byte()
  hdr[4] = ((h.timestamp >> 24U) & 0xFFU).to_int().to_byte()
  hdr[5] = ((h.timestamp >> 16U) & 0xFFU).to_int().to_byte()
  hdr[6] = ((h.timestamp >> 8U) & 0xFFU).to_int().to_byte()
  hdr[7] = (h.timestamp & 0xFFU).to_int().to_byte()
  hdr[8] = ((h.ssrc >> 24U) & 0xFFU).to_int().to_byte()
  hdr[9] = ((h.ssrc >> 16U) & 0xFFU).to_int().to_byte()
  hdr[10] = ((h.ssrc >> 8U) & 0xFFU).to_int().to_byte()
  hdr[11] = (h.ssrc & 0xFFU).to_int().to_byte()

  let mut off = 12
  if cc > 0 {
    let mut ci = 0
    while ci < cc {
      let c = h.csrcs[ci]
      hdr[off] = ((c >> 24U) & 0xFFU).to_int().to_byte()
      hdr[off + 1] = ((c >> 16U) & 0xFFU).to_int().to_byte()
      hdr[off + 2] = ((c >> 8U) & 0xFFU).to_int().to_byte()
      hdr[off + 3] = (c & 0xFFU).to_int().to_byte()
      off = off + 4
      ci = ci + 1
    }
  }

  let mut full_hdr = hdr
  if has_ext {
    let ext_words = ext_body_len >> 2
    hdr[off] = ((h.extension_profile >> 8) & 0xFF).to_byte()
    hdr[off + 1] = (h.extension_profile & 0xFF).to_byte()
    hdr[off + 2] = ((ext_words >> 8) & 0xFF).to_byte()
    hdr[off + 3] = (ext_words & 0xFF).to_byte()
    off = off + 4
    if ext_kind == 1 {
      let exts = h.extensions
      let n_exts = exts.length()
      let mut i = 0
      while i < n_exts {
        let e = exts[i]
        let ep = e.payload
        let elen = ep.length()
        hdr[off] = (((e.id & 0x0F) << 4) | ((elen - 1) & 0x0F)).to_byte()
        off = off + 1
        let mut j = 0
        while j < elen {
          hdr[off + j] = ep[j]
          j = j + 1
        }
        off = off + elen
        i = i + 1
      }
    } else if ext_kind == 2 {
      let exts = h.extensions
      let n_exts = exts.length()
      let mut i = 0
      while i < n_exts {
        let e = exts[i]
        let ep = e.payload
        let elen = ep.length()
        hdr[off] = (e.id & 0xFF).to_byte()
        hdr[off + 1] = (elen & 0xFF).to_byte()
        off = off + 2
        let mut j = 0
        while j < elen {
          hdr[off + j] = ep[j]
          j = j + 1
        }
        off = off + elen
        i = i + 1
      }
    } else if ext_body_len > 0 {
      full_hdr = hdr.concat(h.raw_extension_payload)
    }
  }

  let with_payload = if pkt.payload.length() > 0 {
    full_hdr.concat(pkt.payload)
  } else {
    full_hdr
  }
  if pkt.padding_size > 0 {
    let pad = Bytes::new(pkt.padding_size)
    pad[pkt.padding_size - 1] = (pkt.padding_size & 0xFF).to_byte()
    return Ok(with_payload.concat(pad))
  }
  Ok(with_payload)
}
