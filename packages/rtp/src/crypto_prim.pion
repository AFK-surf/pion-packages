///| Pure-Pion cryptographic primitives complementing `packages/crypto` for SRTP/SRTCP:
///| - FIPS 197 AES-128 block cipher
///| - AES-128-CTR (RFC 3711 §4.1.1 CM mode)
///| - NIST SP 800-38D / RFC 7714 AEAD-AES-128-GCM (12-byte IV, 16-byte tag)
///| - RFC 2104 HMAC-SHA1 (built on `crypto::Sha1` + `crypto::constant_time_eq`)

import "crypto"

///|
fn aes_sbox() -> FixedArray[Int] {
  [
    0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
    0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
    0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
    0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
    0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
    0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
    0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
    0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
    0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
    0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
    0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
    0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
    0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
    0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
    0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
    0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
  ]
}

///|
fn xtime(x : Int) -> Int {
  let hi = (x >> 7) & 1
  ((x << 1) ^ (hi * 0x1b)) & 0xFF
}

///| Expanded AES-128 encryption key (44 32-bit round-key words + precomputed S-box).
struct Aes128Key {
  rk : FixedArray[UInt]
  sbox : FixedArray[Int]
}

///|
fn aes128_expand_key(key : Bytes) -> Aes128Key {
  let sbox = aes_sbox()
  let rk : FixedArray[UInt] = FixedArray::make(44, 0U)
  let rcon : FixedArray[UInt] = [
    0x01000000U, 0x02000000U, 0x04000000U, 0x08000000U, 0x10000000U, 0x20000000U, 0x40000000U,
    0x80000000U, 0x1b000000U, 0x36000000U,
  ]
  let mut i = 0
  while i < 4 {
    let p = i << 2
    rk[i] = (key[p].to_int().to_uint() << 24U) |
    (key[p + 1].to_int().to_uint() << 16U) |
    (key[p + 2].to_int().to_uint() << 8U) |
    key[p + 3].to_int().to_uint()
    i = i + 1
  }
  while i < 44 {
    let mut tmp = rk[i - 1]
    if (i & 3) == 0 {
      let b0 = sbox[((tmp >> 16U) & 0xFFU).to_int()]
      let b1 = sbox[((tmp >> 8U) & 0xFFU).to_int()]
      let b2 = sbox[(tmp & 0xFFU).to_int()]
      let b3 = sbox[((tmp >> 24U) & 0xFFU).to_int()]
      tmp = (b0.to_uint() << 24U) |
      (b1.to_uint() << 16U) |
      (b2.to_uint() << 8U) |
      b3.to_uint()
      tmp = tmp ^ rcon[(i >> 2) - 1]
    }
    rk[i] = rk[i - 4] ^ tmp
    i = i + 1
  }
  Aes128Key::{ rk: rk, sbox: sbox }
}

///| Encrypt a single 16-byte block in place (src[0..16] -> dst[0..16]).
fn aes128_encrypt_block_arr(
  k : Aes128Key,
  src : FixedArray[Int],
  dst : FixedArray[Int],
) -> Unit {
  let rk = k.rk
  let sb = k.sbox
  let mut s0 = ((src[0].to_uint() << 24U) |
    (src[1].to_uint() << 16U) |
    (src[2].to_uint() << 8U) |
    src[3].to_uint()) ^
  rk[0]
  let mut s1 = ((src[4].to_uint() << 24U) |
    (src[5].to_uint() << 16U) |
    (src[6].to_uint() << 8U) |
    src[7].to_uint()) ^
  rk[1]
  let mut s2 = ((src[8].to_uint() << 24U) |
    (src[9].to_uint() << 16U) |
    (src[10].to_uint() << 8U) |
    src[11].to_uint()) ^
  rk[2]
  let mut s3 = ((src[12].to_uint() << 24U) |
    (src[13].to_uint() << 16U) |
    (src[14].to_uint() << 8U) |
    src[15].to_uint()) ^
  rk[3]

  let mut r = 1
  while r < 10 {
    // SubBytes + ShiftRows
    let a0 = sb[((s0 >> 24U) & 0xFFU).to_int()]
    let a1 = sb[((s1 >> 16U) & 0xFFU).to_int()]
    let a2 = sb[((s2 >> 8U) & 0xFFU).to_int()]
    let a3 = sb[(s3 & 0xFFU).to_int()]

    let b0 = sb[((s1 >> 24U) & 0xFFU).to_int()]
    let b1 = sb[((s2 >> 16U) & 0xFFU).to_int()]
    let b2 = sb[((s3 >> 8U) & 0xFFU).to_int()]
    let b3 = sb[(s0 & 0xFFU).to_int()]

    let c0 = sb[((s2 >> 24U) & 0xFFU).to_int()]
    let c1 = sb[((s3 >> 16U) & 0xFFU).to_int()]
    let c2 = sb[((s0 >> 8U) & 0xFFU).to_int()]
    let c3 = sb[(s1 & 0xFFU).to_int()]

    let d0 = sb[((s3 >> 24U) & 0xFFU).to_int()]
    let d1 = sb[((s0 >> 16U) & 0xFFU).to_int()]
    let d2 = sb[((s1 >> 8U) & 0xFFU).to_int()]
    let d3 = sb[(s2 & 0xFFU).to_int()]

    // MixColumns + AddRoundKey
    let ro = r << 2
    let ta = a0 ^ a1 ^ a2 ^ a3
    let na0 = a0 ^ ta ^ xtime(a0 ^ a1)
    let na1 = a1 ^ ta ^ xtime(a1 ^ a2)
    let na2 = a2 ^ ta ^ xtime(a2 ^ a3)
    let na3 = a3 ^ ta ^ xtime(a3 ^ a0)
    s0 = ((na0.to_uint() << 24U) |
      (na1.to_uint() << 16U) |
      (na2.to_uint() << 8U) |
      na3.to_uint()) ^
    rk[ro]

    let tb = b0 ^ b1 ^ b2 ^ b3
    let nb0 = b0 ^ tb ^ xtime(b0 ^ b1)
    let nb1 = b1 ^ tb ^ xtime(b1 ^ b2)
    let nb2 = b2 ^ tb ^ xtime(b2 ^ b3)
    let nb3 = b3 ^ tb ^ xtime(b3 ^ b0)
    s1 = ((nb0.to_uint() << 24U) |
      (nb1.to_uint() << 16U) |
      (nb2.to_uint() << 8U) |
      nb3.to_uint()) ^
    rk[ro + 1]

    let tc = c0 ^ c1 ^ c2 ^ c3
    let nc0 = c0 ^ tc ^ xtime(c0 ^ c1)
    let nc1 = c1 ^ tc ^ xtime(c1 ^ c2)
    let nc2 = c2 ^ tc ^ xtime(c2 ^ c3)
    let nc3 = c3 ^ tc ^ xtime(c3 ^ c0)
    s2 = ((nc0.to_uint() << 24U) |
      (nc1.to_uint() << 16U) |
      (nc2.to_uint() << 8U) |
      nc3.to_uint()) ^
    rk[ro + 2]

    let td = d0 ^ d1 ^ d2 ^ d3
    let nd0 = d0 ^ td ^ xtime(d0 ^ d1)
    let nd1 = d1 ^ td ^ xtime(d1 ^ d2)
    let nd2 = d2 ^ td ^ xtime(d2 ^ d3)
    let nd3 = d3 ^ td ^ xtime(d3 ^ d0)
    s3 = ((nd0.to_uint() << 24U) |
      (nd1.to_uint() << 16U) |
      (nd2.to_uint() << 8U) |
      nd3.to_uint()) ^
    rk[ro + 3]

    r = r + 1
  }

  // Final round (SubBytes + ShiftRows + AddRoundKey, no MixColumns)
  let f0 = ((sb[((s0 >> 24U) & 0xFFU).to_int()].to_uint() << 24U) |
    (sb[((s1 >> 16U) & 0xFFU).to_int()].to_uint() << 16U) |
    (sb[((s2 >> 8U) & 0xFFU).to_int()].to_uint() << 8U) |
    sb[(s3 & 0xFFU).to_int()].to_uint()) ^
  rk[40]
  let f1 = ((sb[((s1 >> 24U) & 0xFFU).to_int()].to_uint() << 24U) |
    (sb[((s2 >> 16U) & 0xFFU).to_int()].to_uint() << 16U) |
    (sb[((s3 >> 8U) & 0xFFU).to_int()].to_uint() << 8U) |
    sb[(s0 & 0xFFU).to_int()].to_uint()) ^
  rk[41]
  let f2 = ((sb[((s2 >> 24U) & 0xFFU).to_int()].to_uint() << 24U) |
    (sb[((s3 >> 16U) & 0xFFU).to_int()].to_uint() << 16U) |
    (sb[((s0 >> 8U) & 0xFFU).to_int()].to_uint() << 8U) |
    sb[(s1 & 0xFFU).to_int()].to_uint()) ^
  rk[42]
  let f3 = ((sb[((s3 >> 24U) & 0xFFU).to_int()].to_uint() << 24U) |
    (sb[((s0 >> 16U) & 0xFFU).to_int()].to_uint() << 16U) |
    (sb[((s1 >> 8U) & 0xFFU).to_int()].to_uint() << 8U) |
    sb[(s2 & 0xFFU).to_int()].to_uint()) ^
  rk[43]

  dst[0] = ((f0 >> 24U) & 0xFFU).to_int()
  dst[1] = ((f0 >> 16U) & 0xFFU).to_int()
  dst[2] = ((f0 >> 8U) & 0xFFU).to_int()
  dst[3] = (f0 & 0xFFU).to_int()
  dst[4] = ((f1 >> 24U) & 0xFFU).to_int()
  dst[5] = ((f1 >> 16U) & 0xFFU).to_int()
  dst[6] = ((f1 >> 8U) & 0xFFU).to_int()
  dst[7] = (f1 & 0xFFU).to_int()
  dst[8] = ((f2 >> 24U) & 0xFFU).to_int()
  dst[9] = ((f2 >> 16U) & 0xFFU).to_int()
  dst[10] = ((f2 >> 8U) & 0xFFU).to_int()
  dst[11] = (f2 & 0xFFU).to_int()
  dst[12] = ((f3 >> 24U) & 0xFFU).to_int()
  dst[13] = ((f3 >> 16U) & 0xFFU).to_int()
  dst[14] = ((f3 >> 8U) & 0xFFU).to_int()
  dst[15] = (f3 & 0xFFU).to_int()
}

///| Increment 128-bit big-endian counter in-place.
fn ctr_inc128(ctr : FixedArray[Int]) -> Unit {
  let mut i = 15
  while i >= 0 {
    let v = (ctr[i] + 1) & 0xFF
    ctr[i] = v
    if v != 0 {
      return
    }
    i = i - 1
  }
}

///| Increment 32-bit big-endian counter (bytes 12..15) in-place (NIST SP 800-38D inc_32).
fn ctr_inc32(ctr : FixedArray[Int]) -> Unit {
  let mut i = 15
  while i >= 12 {
    let v = (ctr[i] + 1) & 0xFF
    ctr[i] = v
    if v != 0 {
      return
    }
    i = i - 1
  }
}

///| AES-128-CTR XOR `src[src_off .. src_off + len]` into `dst[dst_off .. dst_off + len]`.
fn aes128_ctr_xor_into(
  k : Aes128Key,
  iv16 : FixedArray[Int],
  src : Bytes,
  src_off : Int,
  len : Int,
  dst : Bytes,
  dst_off : Int,
) -> Unit {
  let ctr : FixedArray[Int] = FixedArray::make(16, 0)
  let ks : FixedArray[Int] = FixedArray::make(16, 0)
  let mut i = 0
  while i < 16 {
    ctr[i] = iv16[i]
    i = i + 1
  }
  let mut off = 0
  while off < len {
    aes128_encrypt_block_arr(k, ctr, ks)
    ctr_inc128(ctr)
    let rem = len - off
    let take = if rem < 16 { rem } else { 16 }
    let mut j = 0
    while j < take {
      dst[dst_off + off + j] = (src[src_off + off + j].to_int() ^ ks[j]).to_byte()
      j = j + 1
    }
    off = off + take
  }
}

///| AES-128-CTR keystream generation (for RFC 3711 KDF).
fn aes128_ctr_keystream(k : Aes128Key, iv16 : FixedArray[Int], out_len : Int) -> Bytes {
  let out = Bytes::new(out_len)
  let ctr : FixedArray[Int] = FixedArray::make(16, 0)
  let ks : FixedArray[Int] = FixedArray::make(16, 0)
  let mut i = 0
  while i < 16 {
    ctr[i] = iv16[i]
    i = i + 1
  }
  let mut off = 0
  while off < out_len {
    aes128_encrypt_block_arr(k, ctr, ks)
    ctr_inc128(ctr)
    let rem = out_len - off
    let take = if rem < 16 { rem } else { 16 }
    let mut j = 0
    while j < take {
      out[off + j] = ks[j].to_byte()
      j = j + 1
    }
    off = off + take
  }
  out
}

///| Precomputed 4-bit Shoup table for fast GF(2^128) GHASH multiplication.
struct GhashTable {
  m_hi : FixedArray[UInt64]
  m_lo : FixedArray[UInt64]
  red : FixedArray[UInt64]
}

///|
fn ghash_table_new(k : Aes128Key) -> GhashTable {
  let zero : FixedArray[Int] = FixedArray::make(16, 0)
  let h_blk : FixedArray[Int] = FixedArray::make(16, 0)
  aes128_encrypt_block_arr(k, zero, h_blk)
  let h_hi = read_be_u64_arr(h_blk, 0)
  let h_lo = read_be_u64_arr(h_blk, 8)

  let m_hi : FixedArray[UInt64] = FixedArray::make(16, 0UL)
  let m_lo : FixedArray[UInt64] = FixedArray::make(16, 0UL)
  m_hi[8] = h_hi
  m_lo[8] = h_lo

  let mut cur_hi = h_hi
  let mut cur_lo = h_lo
  let mut bit = 4
  while bit >= 1 {
    let lsb = cur_lo & 1UL
    cur_lo = (cur_lo >> 1) | ((cur_hi & 1UL) << 63)
    cur_hi = cur_hi >> 1
    if lsb != 0UL {
      cur_hi = cur_hi ^ 0xE100000000000000UL
    }
    m_hi[bit] = cur_hi
    m_lo[bit] = cur_lo
    bit = bit >> 1
  }

  let mut i = 1
  while i < 16 {
    let mut hi = 0UL
    let mut lo = 0UL
    if (i & 8) != 0 {
      hi = hi ^ m_hi[8]
      lo = lo ^ m_lo[8]
    }
    if (i & 4) != 0 {
      hi = hi ^ m_hi[4]
      lo = lo ^ m_lo[4]
    }
    if (i & 2) != 0 {
      hi = hi ^ m_hi[2]
      lo = lo ^ m_lo[2]
    }
    if (i & 1) != 0 {
      hi = hi ^ m_hi[1]
      lo = lo ^ m_lo[1]
    }
    m_hi[i] = hi
    m_lo[i] = lo
    i = i + 1
  }

  let red : FixedArray[UInt64] = FixedArray::make(16, 0UL)
  let mut r = 0
  while r < 16 {
    let mut v = 0UL
    if (r & 1) != 0 {
      v = v ^ 0x1C20000000000000UL
    }
    if (r & 2) != 0 {
      v = v ^ 0x3840000000000000UL
    }
    if (r & 4) != 0 {
      v = v ^ 0x7080000000000000UL
    }
    if (r & 8) != 0 {
      v = v ^ 0xE100000000000000UL
    }
    red[r] = v
    r = r + 1
  }

  GhashTable::{ m_hi: m_hi, m_lo: m_lo, red: red }
}

///| Fast 4-bit windowed GF(2^128) multiplication Z = X * H.
fn ghash_mul_tbl(x_hi : UInt64, x_lo : UInt64, tbl : GhashTable) -> (UInt64, UInt64) {
  let m_hi = tbl.m_hi
  let m_lo = tbl.m_lo
  let red = tbl.red
  let mut z_hi = 0UL
  let mut z_lo = 0UL
  let mut i = 0
  while i < 16 {
    let sh = i << 2
    let nib = ((x_lo >> sh) & 0xFUL).to_int()
    let rem = (z_lo & 0xFUL).to_int()
    z_lo = (z_lo >> 4) | ((z_hi & 0xFUL) << 60)
    z_hi = (z_hi >> 4) ^ red[rem]
    z_hi = z_hi ^ m_hi[nib]
    z_lo = z_lo ^ m_lo[nib]
    i = i + 1
  }
  let mut j = 0
  while j < 16 {
    let sh = j << 2
    let nib = ((x_hi >> sh) & 0xFUL).to_int()
    let rem = (z_lo & 0xFUL).to_int()
    z_lo = (z_lo >> 4) | ((z_hi & 0xFUL) << 60)
    z_hi = (z_hi >> 4) ^ red[rem]
    z_hi = z_hi ^ m_hi[nib]
    z_lo = z_lo ^ m_lo[nib]
    j = j + 1
  }
  (z_hi, z_lo)
}

///|
fn read_be_u64_bytes(b : Bytes, off : Int) -> UInt64 {
  (b[off].to_int().to_int64().to_uint64() << 56) |
  (b[off + 1].to_int().to_int64().to_uint64() << 48) |
  (b[off + 2].to_int().to_int64().to_uint64() << 40) |
  (b[off + 3].to_int().to_int64().to_uint64() << 32) |
  (b[off + 4].to_int().to_int64().to_uint64() << 24) |
  (b[off + 5].to_int().to_int64().to_uint64() << 16) |
  (b[off + 6].to_int().to_int64().to_uint64() << 8) |
  b[off + 7].to_int().to_int64().to_uint64()
}

///|
fn read_be_u64_arr(a : FixedArray[Int], off : Int) -> UInt64 {
  (a[off].to_int64().to_uint64() << 56) |
  (a[off + 1].to_int64().to_uint64() << 48) |
  (a[off + 2].to_int64().to_uint64() << 40) |
  (a[off + 3].to_int64().to_uint64() << 32) |
  (a[off + 4].to_int64().to_uint64() << 24) |
  (a[off + 5].to_int64().to_uint64() << 16) |
  (a[off + 6].to_int64().to_uint64() << 8) |
  a[off + 7].to_int64().to_uint64()
}

///|
fn ghash_update_slice(
  y_hi : UInt64,
  y_lo : UInt64,
  tbl : GhashTable,
  data : Bytes,
  start : Int,
  len : Int,
) -> (UInt64, UInt64) {
  let mut cur_hi = y_hi
  let mut cur_lo = y_lo
  let mut off = 0
  while off + 16 <= len {
    let b_hi = read_be_u64_bytes(data, start + off)
    let b_lo = read_be_u64_bytes(data, start + off + 8)
    let (nh, nl) = ghash_mul_tbl(cur_hi ^ b_hi, cur_lo ^ b_lo, tbl)
    cur_hi = nh
    cur_lo = nl
    off = off + 16
  }
  let rem = len - off
  if rem > 0 {
    let pad : FixedArray[Int] = FixedArray::make(16, 0)
    let mut j = 0
    while j < rem {
      pad[j] = data[start + off + j].to_int()
      j = j + 1
    }
    let b_hi = read_be_u64_arr(pad, 0)
    let b_lo = read_be_u64_arr(pad, 8)
    let (nh, nl) = ghash_mul_tbl(cur_hi ^ b_hi, cur_lo ^ b_lo, tbl)
    cur_hi = nh
    cur_lo = nl
  }
  (cur_hi, cur_lo)
}

///| Compute 16-byte GCM authentication tag for (aad, ct) with 12-byte IV using cached `GhashTable`.
fn aes128_gcm_tag(
  k : Aes128Key,
  tbl : GhashTable,
  iv12 : FixedArray[Int],
  aad : Bytes,
  aad_start : Int,
  aad_len : Int,
  ct : Bytes,
  ct_start : Int,
  ct_len : Int,
) -> Bytes {
  let (y1_hi, y1_lo) = ghash_update_slice(0UL, 0UL, tbl, aad, aad_start, aad_len)
  let (y2_hi, y2_lo) = ghash_update_slice(y1_hi, y1_lo, tbl, ct, ct_start, ct_len)
  let len_hi : UInt64 = aad_len.to_int64().to_uint64() << 3
  let len_lo : UInt64 = ct_len.to_int64().to_uint64() << 3
  let (s_hi, s_lo) = ghash_mul_tbl(y2_hi ^ len_hi, y2_lo ^ len_lo, tbl)

  let j0 : FixedArray[Int] = FixedArray::make(16, 0)
  let mut i = 0
  while i < 12 {
    j0[i] = iv12[i]
    i = i + 1
  }
  j0[15] = 1
  let ej0 : FixedArray[Int] = FixedArray::make(16, 0)
  aes128_encrypt_block_arr(k, j0, ej0)
  let ej0_hi = read_be_u64_arr(ej0, 0)
  let ej0_lo = read_be_u64_arr(ej0, 8)

  let t_hi = s_hi ^ ej0_hi
  let t_lo = s_lo ^ ej0_lo
  let tag = Bytes::new(16)
  tag[0] = ((t_hi >> 56) & 0xFFUL).to_int().to_byte()
  tag[1] = ((t_hi >> 48) & 0xFFUL).to_int().to_byte()
  tag[2] = ((t_hi >> 40) & 0xFFUL).to_int().to_byte()
  tag[3] = ((t_hi >> 32) & 0xFFUL).to_int().to_byte()
  tag[4] = ((t_hi >> 24) & 0xFFUL).to_int().to_byte()
  tag[5] = ((t_hi >> 16) & 0xFFUL).to_int().to_byte()
  tag[6] = ((t_hi >> 8) & 0xFFUL).to_int().to_byte()
  tag[7] = (t_hi & 0xFFUL).to_int().to_byte()
  tag[8] = ((t_lo >> 56) & 0xFFUL).to_int().to_byte()
  tag[9] = ((t_lo >> 48) & 0xFFUL).to_int().to_byte()
  tag[10] = ((t_lo >> 40) & 0xFFUL).to_int().to_byte()
  tag[11] = ((t_lo >> 32) & 0xFFUL).to_int().to_byte()
  tag[12] = ((t_lo >> 24) & 0xFFUL).to_int().to_byte()
  tag[13] = ((t_lo >> 16) & 0xFFUL).to_int().to_byte()
  tag[14] = ((t_lo >> 8) & 0xFFUL).to_int().to_byte()
  tag[15] = (t_lo & 0xFFUL).to_int().to_byte()
  tag
}

///| GCTR for AES-128-GCM starting at inc_32(J0) = iv12 || 0x00000002.
fn aes128_gcm_crypt_into(
  k : Aes128Key,
  iv12 : FixedArray[Int],
  src : Bytes,
  src_off : Int,
  len : Int,
  dst : Bytes,
  dst_off : Int,
) -> Unit {
  let ctr : FixedArray[Int] = FixedArray::make(16, 0)
  let ks : FixedArray[Int] = FixedArray::make(16, 0)
  let mut i = 0
  while i < 12 {
    ctr[i] = iv12[i]
    i = i + 1
  }
  ctr[15] = 2
  let mut off = 0
  while off < len {
    aes128_encrypt_block_arr(k, ctr, ks)
    ctr_inc32(ctr)
    let rem = len - off
    let take = if rem < 16 { rem } else { 16 }
    let mut j = 0
    while j < take {
      dst[dst_off + off + j] = (src[src_off + off + j].to_int() ^ ks[j]).to_byte()
      j = j + 1
    }
    off = off + take
  }
}

///| Precompute 64-byte HMAC-SHA1 ipad and opad blocks.
fn hmac_sha1_pads(key : Bytes) -> (Bytes, Bytes) {
  let k = if key.length() > 64 { crypto::sha1(key) } else { key }
  let klen = k.length()
  let ipad = Bytes::new(64)
  let opad = Bytes::new(64)
  let mut i = 0
  while i < 64 {
    let kb = if i < klen { k[i].to_int() } else { 0 }
    ipad[i] = (kb ^ 0x36).to_byte()
    opad[i] = (kb ^ 0x5C).to_byte()
    i = i + 1
  }
  (ipad, opad)
}

///| RFC 2104 HMAC-SHA1 over a slice + optional 4-byte suffix using precomputed pads.
fn hmac_sha1_pads_with_suffix(
  ipad : Bytes,
  opad : Bytes,
  data : Bytes,
  start : Int,
  end : Int,
  suffix : Bytes,
) -> Bytes {
  let inner = crypto::Sha1::new()
  inner.update(ipad)
  inner.update_slice(data, start, end)
  if suffix.length() > 0 {
    inner.update(suffix)
  }
  let inner_hash = inner.finalize()

  let outer = crypto::Sha1::new()
  outer.update(opad)
  outer.update(inner_hash)
  outer.finalize()
}
