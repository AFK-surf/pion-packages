///| Pure-Pion cryptographic primitives complementing `packages/crypto` for SRTP/SRTCP:
///| - FIPS 197 AES-128 block cipher (T-table accelerated)
///| - AES-128-CTR (RFC 3711 §4.1.1 CM mode)
///| - NIST SP 800-38D / RFC 7714 AEAD-AES-128-GCM (12-byte IV, 16-byte tag, 8-bit Shoup GHASH)
///| - RFC 2104 HMAC-SHA1 (built on `crypto::Sha1` + `crypto::constant_time_eq`)

import "crypto"

///|
let aes_sbox_tbl : FixedArray[Int] = [
  0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
  0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
  0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
  0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
  0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
  0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
  0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
  0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
  0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
  0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
  0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
  0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
  0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
  0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
  0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
  0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
]

///|
let aes_rcon : FixedArray[UInt] = [
  0x01000000U, 0x02000000U, 0x04000000U, 0x08000000U, 0x10000000U, 0x20000000U, 0x40000000U,
  0x80000000U, 0x1b000000U, 0x36000000U,
]

///|
fn xtime(x : Int) -> Int {
  let hi = (x >> 7) & 1
  ((x << 1) ^ (hi * 0x1b)) & 0xFF
}

///|
fn build_aes_te(rot : Int) -> FixedArray[UInt] {
  let tbl : FixedArray[UInt] = FixedArray::make(256, 0U)
  let mut i = 0
  while i < 256 {
    let s = aes_sbox_tbl[i]
    let s2 = xtime(s)
    let s3 = s2 ^ s
    let w = (s2.to_uint() << 24U) | (s.to_uint() << 16U) | (s.to_uint() << 8U) | s3.to_uint()
    tbl[i] = if rot == 0 {
      w
    } else {
      (w >> rot.to_uint()) | (w << (32 - rot).to_uint())
    }
    i = i + 1
  }
  tbl
}

///|
let aes_te0 : FixedArray[UInt] = build_aes_te(0)

///|
let aes_te1 : FixedArray[UInt] = build_aes_te(8)

///|
let aes_te2 : FixedArray[UInt] = build_aes_te(16)

///|
let aes_te3 : FixedArray[UInt] = build_aes_te(24)

///|
fn build_ghash_red256() -> FixedArray[UInt64] {
  let red : FixedArray[UInt64] = FixedArray::make(256, 0UL)
  let mut r = 0
  while r < 256 {
    let mut v = 0UL
    let mut b = 0
    while b < 8 {
      if ((r >> b) & 1) != 0 {
        v = v ^ (0xE100000000000000UL >> (7 - b))
      }
      b = b + 1
    }
    red[r] = v
    r = r + 1
  }
  red
}

///|
let ghash_red256 : FixedArray[UInt64] = build_ghash_red256()

///| Expanded AES-128 encryption key (44 32-bit round-key words).
struct Aes128Key {
  rk : FixedArray[UInt]
}

///|
fn aes128_expand_key(key : Bytes) -> Aes128Key {
  let rk : FixedArray[UInt] = FixedArray::make(44, 0U)
  let mut i = 0
  while i < 4 {
    let p = i << 2
    rk[i] = (key[p].to_int().to_uint() << 24U) |
    (key[p + 1].to_int().to_uint() << 16U) |
    (key[p + 2].to_int().to_uint() << 8U) |
    key[p + 3].to_int().to_uint()
    i = i + 1
  }
  while i < 44 {
    let mut tmp = rk[i - 1]
    if (i & 3) == 0 {
      let b0 = aes_sbox_tbl[((tmp >> 16U) & 0xFFU).to_int()]
      let b1 = aes_sbox_tbl[((tmp >> 8U) & 0xFFU).to_int()]
      let b2 = aes_sbox_tbl[(tmp & 0xFFU).to_int()]
      let b3 = aes_sbox_tbl[((tmp >> 24U) & 0xFFU).to_int()]
      tmp = (b0.to_uint() << 24U) |
      (b1.to_uint() << 16U) |
      (b2.to_uint() << 8U) |
      b3.to_uint()
      tmp = tmp ^ aes_rcon[(i >> 2) - 1]
    }
    rk[i] = rk[i - 4] ^ tmp
    i = i + 1
  }
  Aes128Key::{ rk: rk }
}

///| Encrypt a single 128-bit block given as 4 big-endian UInt words using T-tables.
fn aes128_encrypt_words(
  rk : FixedArray[UInt],
  w0 : UInt,
  w1 : UInt,
  w2 : UInt,
  w3 : UInt,
) -> (UInt, UInt, UInt, UInt) {
  let te0 = aes_te0
  let te1 = aes_te1
  let te2 = aes_te2
  let te3 = aes_te3
  let sb = aes_sbox_tbl

  let mut s0 = w0 ^ rk[0]
  let mut s1 = w1 ^ rk[1]
  let mut s2 = w2 ^ rk[2]
  let mut s3 = w3 ^ rk[3]

  let mut r = 1
  while r < 9 {
    let ro = r << 2
    let t0 = te0[((s0 >> 24U) & 0xFFU).to_int()] ^
    te1[((s1 >> 16U) & 0xFFU).to_int()] ^
    te2[((s2 >> 8U) & 0xFFU).to_int()] ^
    te3[(s3 & 0xFFU).to_int()] ^
    rk[ro]
    let t1 = te0[((s1 >> 24U) & 0xFFU).to_int()] ^
    te1[((s2 >> 16U) & 0xFFU).to_int()] ^
    te2[((s3 >> 8U) & 0xFFU).to_int()] ^
    te3[(s0 & 0xFFU).to_int()] ^
    rk[ro + 1]
    let t2 = te0[((s2 >> 24U) & 0xFFU).to_int()] ^
    te1[((s3 >> 16U) & 0xFFU).to_int()] ^
    te2[((s0 >> 8U) & 0xFFU).to_int()] ^
    te3[(s1 & 0xFFU).to_int()] ^
    rk[ro + 2]
    let t3 = te0[((s3 >> 24U) & 0xFFU).to_int()] ^
    te1[((s0 >> 16U) & 0xFFU).to_int()] ^
    te2[((s1 >> 8U) & 0xFFU).to_int()] ^
    te3[(s2 & 0xFFU).to_int()] ^
    rk[ro + 3]

    let ro2 = ro + 4
    s0 = te0[((t0 >> 24U) & 0xFFU).to_int()] ^
    te1[((t1 >> 16U) & 0xFFU).to_int()] ^
    te2[((t2 >> 8U) & 0xFFU).to_int()] ^
    te3[(t3 & 0xFFU).to_int()] ^
    rk[ro2]
    s1 = te0[((t1 >> 24U) & 0xFFU).to_int()] ^
    te1[((t2 >> 16U) & 0xFFU).to_int()] ^
    te2[((t3 >> 8U) & 0xFFU).to_int()] ^
    te3[(t0 & 0xFFU).to_int()] ^
    rk[ro2 + 1]
    s2 = te0[((t2 >> 24U) & 0xFFU).to_int()] ^
    te1[((t3 >> 16U) & 0xFFU).to_int()] ^
    te2[((t0 >> 8U) & 0xFFU).to_int()] ^
    te3[(t1 & 0xFFU).to_int()] ^
    rk[ro2 + 2]
    s3 = te0[((t3 >> 24U) & 0xFFU).to_int()] ^
    te1[((t0 >> 16U) & 0xFFU).to_int()] ^
    te2[((t1 >> 8U) & 0xFFU).to_int()] ^
    te3[(t2 & 0xFFU).to_int()] ^
    rk[ro2 + 3]
    r = r + 2
  }

  // Round 9
  let t0 = te0[((s0 >> 24U) & 0xFFU).to_int()] ^
  te1[((s1 >> 16U) & 0xFFU).to_int()] ^
  te2[((s2 >> 8U) & 0xFFU).to_int()] ^
  te3[(s3 & 0xFFU).to_int()] ^
  rk[36]
  let t1 = te0[((s1 >> 24U) & 0xFFU).to_int()] ^
  te1[((s2 >> 16U) & 0xFFU).to_int()] ^
  te2[((s3 >> 8U) & 0xFFU).to_int()] ^
  te3[(s0 & 0xFFU).to_int()] ^
  rk[37]
  let t2 = te0[((s2 >> 24U) & 0xFFU).to_int()] ^
  te1[((s3 >> 16U) & 0xFFU).to_int()] ^
  te2[((s0 >> 8U) & 0xFFU).to_int()] ^
  te3[(s1 & 0xFFU).to_int()] ^
  rk[38]
  let t3 = te0[((s3 >> 24U) & 0xFFU).to_int()] ^
  te1[((s0 >> 16U) & 0xFFU).to_int()] ^
  te2[((s1 >> 8U) & 0xFFU).to_int()] ^
  te3[(s2 & 0xFFU).to_int()] ^
  rk[39]

  let f0 = ((sb[((t0 >> 24U) & 0xFFU).to_int()].to_uint() << 24U) |
    (sb[((t1 >> 16U) & 0xFFU).to_int()].to_uint() << 16U) |
    (sb[((t2 >> 8U) & 0xFFU).to_int()].to_uint() << 8U) |
    sb[(t3 & 0xFFU).to_int()].to_uint()) ^
  rk[40]
  let f1 = ((sb[((t1 >> 24U) & 0xFFU).to_int()].to_uint() << 24U) |
    (sb[((t2 >> 16U) & 0xFFU).to_int()].to_uint() << 16U) |
    (sb[((t3 >> 8U) & 0xFFU).to_int()].to_uint() << 8U) |
    sb[(t0 & 0xFFU).to_int()].to_uint()) ^
  rk[41]
  let f2 = ((sb[((t2 >> 24U) & 0xFFU).to_int()].to_uint() << 24U) |
    (sb[((t3 >> 16U) & 0xFFU).to_int()].to_uint() << 16U) |
    (sb[((t0 >> 8U) & 0xFFU).to_int()].to_uint() << 8U) |
    sb[(t1 & 0xFFU).to_int()].to_uint()) ^
  rk[42]
  let f3 = ((sb[((t3 >> 24U) & 0xFFU).to_int()].to_uint() << 24U) |
    (sb[((t0 >> 16U) & 0xFFU).to_int()].to_uint() << 16U) |
    (sb[((t1 >> 8U) & 0xFFU).to_int()].to_uint() << 8U) |
    sb[(t2 & 0xFFU).to_int()].to_uint()) ^
  rk[43]
  (f0, f1, f2, f3)
}

///| Encrypt a single 16-byte block in place (src[0..16] -> dst[0..16]).
fn aes128_encrypt_block_arr(
  k : Aes128Key,
  src : FixedArray[Int],
  dst : FixedArray[Int],
) -> Unit {
  let (w0, w1, w2, w3) = iv16_to_words(src)
  let (f0, f1, f2, f3) = aes128_encrypt_words(k.rk, w0, w1, w2, w3)
  dst[0] = ((f0 >> 24U) & 0xFFU).to_int()
  dst[1] = ((f0 >> 16U) & 0xFFU).to_int()
  dst[2] = ((f0 >> 8U) & 0xFFU).to_int()
  dst[3] = (f0 & 0xFFU).to_int()
  dst[4] = ((f1 >> 24U) & 0xFFU).to_int()
  dst[5] = ((f1 >> 16U) & 0xFFU).to_int()
  dst[6] = ((f1 >> 8U) & 0xFFU).to_int()
  dst[7] = (f1 & 0xFFU).to_int()
  dst[8] = ((f2 >> 24U) & 0xFFU).to_int()
  dst[9] = ((f2 >> 16U) & 0xFFU).to_int()
  dst[10] = ((f2 >> 8U) & 0xFFU).to_int()
  dst[11] = (f2 & 0xFFU).to_int()
  dst[12] = ((f3 >> 24U) & 0xFFU).to_int()
  dst[13] = ((f3 >> 16U) & 0xFFU).to_int()
  dst[14] = ((f3 >> 8U) & 0xFFU).to_int()
  dst[15] = (f3 & 0xFFU).to_int()
}

///|
fn iv16_to_words(iv : FixedArray[Int]) -> (UInt, UInt, UInt, UInt) {
  let w0 = (iv[0].to_uint() << 24U) |
  (iv[1].to_uint() << 16U) |
  (iv[2].to_uint() << 8U) |
  iv[3].to_uint()
  let w1 = (iv[4].to_uint() << 24U) |
  (iv[5].to_uint() << 16U) |
  (iv[6].to_uint() << 8U) |
  iv[7].to_uint()
  let w2 = (iv[8].to_uint() << 24U) |
  (iv[9].to_uint() << 16U) |
  (iv[10].to_uint() << 8U) |
  iv[11].to_uint()
  let w3 = (iv[12].to_uint() << 24U) |
  (iv[13].to_uint() << 16U) |
  (iv[14].to_uint() << 8U) |
  iv[15].to_uint()
  (w0, w1, w2, w3)
}

///|
fn xor_word_into(dst : Bytes, doff : Int, src : Bytes, soff : Int, w : UInt) -> Unit {
  dst[doff] = (src[soff].to_int() ^ ((w >> 24U) & 0xFFU).to_int()).to_byte()
  dst[doff + 1] = (src[soff + 1].to_int() ^ ((w >> 16U) & 0xFFU).to_int()).to_byte()
  dst[doff + 2] = (src[soff + 2].to_int() ^ ((w >> 8U) & 0xFFU).to_int()).to_byte()
  dst[doff + 3] = (src[soff + 3].to_int() ^ (w & 0xFFU).to_int()).to_byte()
}

///|
fn xor_tail_into(
  dst : Bytes,
  doff : Int,
  src : Bytes,
  soff : Int,
  take : Int,
  f0 : UInt,
  f1 : UInt,
  f2 : UInt,
  f3 : UInt,
) -> Unit {
  let mut j = 0
  while j < take {
    let w = if j < 4 { f0 } else if j < 8 { f1 } else if j < 12 { f2 } else { f3 }
    let sh = ((3 - (j & 3)) << 3).to_uint()
    dst[doff + j] = (src[soff + j].to_int() ^ ((w >> sh) & 0xFFU).to_int()).to_byte()
    j = j + 1
  }
}

///| AES-128-CTR XOR `src[src_off .. src_off + len]` into `dst[dst_off .. dst_off + len]`.
fn aes128_ctr_xor_into(
  k : Aes128Key,
  iv16 : FixedArray[Int],
  src : Bytes,
  src_off : Int,
  len : Int,
  dst : Bytes,
  dst_off : Int,
) -> Unit {
  let rk = k.rk
  let (iw0, iw1, iw2, iw3) = iv16_to_words(iv16)
  let mut c0 = iw0
  let mut c1 = iw1
  let mut c2 = iw2
  let mut c3 = iw3
  let mut off = 0
  while off + 16 <= len {
    let (f0, f1, f2, f3) = aes128_encrypt_words(rk, c0, c1, c2, c3)
    c3 = c3 + 1U
    if c3 == 0U {
      c2 = c2 + 1U
      if c2 == 0U {
        c1 = c1 + 1U
        if c1 == 0U {
          c0 = c0 + 1U
        }
      }
    }
    let s = src_off + off
    let d = dst_off + off
    xor_word_into(dst, d, src, s, f0)
    xor_word_into(dst, d + 4, src, s + 4, f1)
    xor_word_into(dst, d + 8, src, s + 8, f2)
    xor_word_into(dst, d + 12, src, s + 12, f3)
    off = off + 16
  }
  let rem = len - off
  if rem > 0 {
    let (f0, f1, f2, f3) = aes128_encrypt_words(rk, c0, c1, c2, c3)
    xor_tail_into(dst, dst_off + off, src, src_off + off, rem, f0, f1, f2, f3)
  }
}

///| AES-128-CTR keystream generation (for RFC 3711 KDF).
fn aes128_ctr_keystream(k : Aes128Key, iv16 : FixedArray[Int], out_len : Int) -> Bytes {
  let out = Bytes::new(out_len)
  let rk = k.rk
  let (iw0, iw1, iw2, iw3) = iv16_to_words(iv16)
  let mut c0 = iw0
  let mut c1 = iw1
  let mut c2 = iw2
  let mut c3 = iw3
  let mut off = 0
  while off < out_len {
    let (f0, f1, f2, f3) = aes128_encrypt_words(rk, c0, c1, c2, c3)
    c3 = c3 + 1U
    if c3 == 0U {
      c2 = c2 + 1U
      if c2 == 0U {
        c1 = c1 + 1U
        if c1 == 0U {
          c0 = c0 + 1U
        }
      }
    }
    let rem = out_len - off
    let take = if rem < 16 { rem } else { 16 }
    let mut j = 0
    while j < take {
      let w = if j < 4 { f0 } else if j < 8 { f1 } else if j < 12 { f2 } else { f3 }
      let sh = ((3 - (j & 3)) << 3).to_uint()
      out[off + j] = ((w >> sh) & 0xFFU).to_int().to_byte()
      j = j + 1
    }
    off = off + take
  }
  out
}

///| Precomputed 8-bit Shoup table for fast GF(2^128) GHASH multiplication.
struct GhashTable {
  m_hi : FixedArray[UInt64]
  m_lo : FixedArray[UInt64]
}

///|
let empty_ghash_table : GhashTable = GhashTable::{
  m_hi: FixedArray::make(1, 0UL),
  m_lo: FixedArray::make(1, 0UL),
}

///|
fn ghash_table_new(k : Aes128Key) -> GhashTable {
  let (f0, f1, f2, f3) = aes128_encrypt_words(k.rk, 0U, 0U, 0U, 0U)
  let h_hi = (f0.to_uint64() << 32) | f1.to_uint64()
  let h_lo = (f2.to_uint64() << 32) | f3.to_uint64()

  let m_hi : FixedArray[UInt64] = FixedArray::make(256, 0UL)
  let m_lo : FixedArray[UInt64] = FixedArray::make(256, 0UL)
  m_hi[128] = h_hi
  m_lo[128] = h_lo

  let mut cur_hi = h_hi
  let mut cur_lo = h_lo
  let mut bit = 64
  while bit >= 1 {
    let lsb = cur_lo & 1UL
    cur_lo = (cur_lo >> 1) | ((cur_hi & 1UL) << 63)
    cur_hi = cur_hi >> 1
    if lsb != 0UL {
      cur_hi = cur_hi ^ 0xE100000000000000UL
    }
    m_hi[bit] = cur_hi
    m_lo[bit] = cur_lo
    bit = bit >> 1
  }

  let mut p = 2
  while p < 256 {
    let mut q = 1
    while q < p {
      m_hi[p + q] = m_hi[p] ^ m_hi[q]
      m_lo[p + q] = m_lo[p] ^ m_lo[q]
      q = q + 1
    }
    p = p << 1
  }

  GhashTable::{ m_hi: m_hi, m_lo: m_lo }
}

///| Fast 8-bit windowed GF(2^128) multiplication Z = X * H (16 iterations per 128-bit block).
fn ghash_mul_tbl(x_hi : UInt64, x_lo : UInt64, tbl : GhashTable) -> (UInt64, UInt64) {
  let m_hi = tbl.m_hi
  let m_lo = tbl.m_lo
  let red = ghash_red256
  let mut z_hi = 0UL
  let mut z_lo = 0UL
  let mut i = 0
  while i < 8 {
    let sh = i << 3
    let b = ((x_lo >> sh) & 0xFFUL).to_int()
    let rem = (z_lo & 0xFFUL).to_int()
    z_lo = (z_lo >> 8) | ((z_hi & 0xFFUL) << 56)
    z_hi = (z_hi >> 8) ^ red[rem] ^ m_hi[b]
    z_lo = z_lo ^ m_lo[b]
    i = i + 1
  }
  let mut j = 0
  while j < 8 {
    let sh = j << 3
    let b = ((x_hi >> sh) & 0xFFUL).to_int()
    let rem = (z_lo & 0xFFUL).to_int()
    z_lo = (z_lo >> 8) | ((z_hi & 0xFFUL) << 56)
    z_hi = (z_hi >> 8) ^ red[rem] ^ m_hi[b]
    z_lo = z_lo ^ m_lo[b]
    j = j + 1
  }
  (z_hi, z_lo)
}

///|
fn read_be_u64_bytes(b : Bytes, off : Int) -> UInt64 {
  (b[off].to_int().to_int64().to_uint64() << 56) |
  (b[off + 1].to_int().to_int64().to_uint64() << 48) |
  (b[off + 2].to_int().to_int64().to_uint64() << 40) |
  (b[off + 3].to_int().to_int64().to_uint64() << 32) |
  (b[off + 4].to_int().to_int64().to_uint64() << 24) |
  (b[off + 5].to_int().to_int64().to_uint64() << 16) |
  (b[off + 6].to_int().to_int64().to_uint64() << 8) |
  b[off + 7].to_int().to_int64().to_uint64()
}

///|
fn ghash_update_slice(
  y_hi : UInt64,
  y_lo : UInt64,
  tbl : GhashTable,
  data : Bytes,
  start : Int,
  len : Int,
) -> (UInt64, UInt64) {
  let mut cur_hi = y_hi
  let mut cur_lo = y_lo
  let mut off = 0
  while off + 16 <= len {
    let b_hi = read_be_u64_bytes(data, start + off)
    let b_lo = read_be_u64_bytes(data, start + off + 8)
    let (nh, nl) = ghash_mul_tbl(cur_hi ^ b_hi, cur_lo ^ b_lo, tbl)
    cur_hi = nh
    cur_lo = nl
    off = off + 16
  }
  let rem = len - off
  if rem > 0 {
    let mut b_hi = 0UL
    let mut b_lo = 0UL
    let mut j = 0
    while j < rem {
      let bv = data[start + off + j].to_int().to_int64().to_uint64()
      if j < 8 {
        b_hi = b_hi | (bv << ((7 - j) << 3))
      } else {
        b_lo = b_lo | (bv << ((15 - j) << 3))
      }
      j = j + 1
    }
    let (nh, nl) = ghash_mul_tbl(cur_hi ^ b_hi, cur_lo ^ b_lo, tbl)
    cur_hi = nh
    cur_lo = nl
  }
  (cur_hi, cur_lo)
}

///| Compute 16-byte GCM authentication tag for (aad, ct) with 12-byte IV using cached `GhashTable`.
fn aes128_gcm_tag(
  k : Aes128Key,
  tbl : GhashTable,
  iv12 : FixedArray[Int],
  aad : Bytes,
  aad_start : Int,
  aad_len : Int,
  ct : Bytes,
  ct_start : Int,
  ct_len : Int,
) -> Bytes {
  let (y1_hi, y1_lo) = ghash_update_slice(0UL, 0UL, tbl, aad, aad_start, aad_len)
  let (y2_hi, y2_lo) = ghash_update_slice(y1_hi, y1_lo, tbl, ct, ct_start, ct_len)
  let len_hi : UInt64 = aad_len.to_int64().to_uint64() << 3
  let len_lo : UInt64 = ct_len.to_int64().to_uint64() << 3
  let (s_hi, s_lo) = ghash_mul_tbl(y2_hi ^ len_hi, y2_lo ^ len_lo, tbl)

  let w0 = (iv12[0].to_uint() << 24U) |
  (iv12[1].to_uint() << 16U) |
  (iv12[2].to_uint() << 8U) |
  iv12[3].to_uint()
  let w1 = (iv12[4].to_uint() << 24U) |
  (iv12[5].to_uint() << 16U) |
  (iv12[6].to_uint() << 8U) |
  iv12[7].to_uint()
  let w2 = (iv12[8].to_uint() << 24U) |
  (iv12[9].to_uint() << 16U) |
  (iv12[10].to_uint() << 8U) |
  iv12[11].to_uint()
  let (e0, e1, e2, e3) = aes128_encrypt_words(k.rk, w0, w1, w2, 1U)
  let ej0_hi = (e0.to_uint64() << 32) | e1.to_uint64()
  let ej0_lo = (e2.to_uint64() << 32) | e3.to_uint64()

  let t_hi = s_hi ^ ej0_hi
  let t_lo = s_lo ^ ej0_lo
  let tag = Bytes::new(16)
  tag[0] = ((t_hi >> 56) & 0xFFUL).to_int().to_byte()
  tag[1] = ((t_hi >> 48) & 0xFFUL).to_int().to_byte()
  tag[2] = ((t_hi >> 40) & 0xFFUL).to_int().to_byte()
  tag[3] = ((t_hi >> 32) & 0xFFUL).to_int().to_byte()
  tag[4] = ((t_hi >> 24) & 0xFFUL).to_int().to_byte()
  tag[5] = ((t_hi >> 16) & 0xFFUL).to_int().to_byte()
  tag[6] = ((t_hi >> 8) & 0xFFUL).to_int().to_byte()
  tag[7] = (t_hi & 0xFFUL).to_int().to_byte()
  tag[8] = ((t_lo >> 56) & 0xFFUL).to_int().to_byte()
  tag[9] = ((t_lo >> 48) & 0xFFUL).to_int().to_byte()
  tag[10] = ((t_lo >> 40) & 0xFFUL).to_int().to_byte()
  tag[11] = ((t_lo >> 32) & 0xFFUL).to_int().to_byte()
  tag[12] = ((t_lo >> 24) & 0xFFUL).to_int().to_byte()
  tag[13] = ((t_lo >> 16) & 0xFFUL).to_int().to_byte()
  tag[14] = ((t_lo >> 8) & 0xFFUL).to_int().to_byte()
  tag[15] = (t_lo & 0xFFUL).to_int().to_byte()
  tag
}

///| GCTR for AES-128-GCM starting at inc_32(J0) = iv12 || 0x00000002.
fn aes128_gcm_crypt_into(
  k : Aes128Key,
  iv12 : FixedArray[Int],
  src : Bytes,
  src_off : Int,
  len : Int,
  dst : Bytes,
  dst_off : Int,
) -> Unit {
  let rk = k.rk
  let c0 = (iv12[0].to_uint() << 24U) |
  (iv12[1].to_uint() << 16U) |
  (iv12[2].to_uint() << 8U) |
  iv12[3].to_uint()
  let c1 = (iv12[4].to_uint() << 24U) |
  (iv12[5].to_uint() << 16U) |
  (iv12[6].to_uint() << 8U) |
  iv12[7].to_uint()
  let c2 = (iv12[8].to_uint() << 24U) |
  (iv12[9].to_uint() << 16U) |
  (iv12[10].to_uint() << 8U) |
  iv12[11].to_uint()
  let mut c3 = 2U
  let mut off = 0
  while off + 16 <= len {
    let (f0, f1, f2, f3) = aes128_encrypt_words(rk, c0, c1, c2, c3)
    c3 = c3 + 1U
    let s = src_off + off
    let d = dst_off + off
    xor_word_into(dst, d, src, s, f0)
    xor_word_into(dst, d + 4, src, s + 4, f1)
    xor_word_into(dst, d + 8, src, s + 8, f2)
    xor_word_into(dst, d + 12, src, s + 12, f3)
    off = off + 16
  }
  let rem = len - off
  if rem > 0 {
    let (f0, f1, f2, f3) = aes128_encrypt_words(rk, c0, c1, c2, c3)
    xor_tail_into(dst, dst_off + off, src, src_off + off, rem, f0, f1, f2, f3)
  }
}

///| Precompute 64-byte HMAC-SHA1 ipad and opad blocks.
fn hmac_sha1_pads(key : Bytes) -> (Bytes, Bytes) {
  let k = if key.length() > 64 { crypto::sha1(key) } else { key }
  let klen = k.length()
  let ipad = Bytes::new(64)
  let opad = Bytes::new(64)
  let mut i = 0
  while i < 64 {
    let kb = if i < klen { k[i].to_int() } else { 0 }
    ipad[i] = (kb ^ 0x36).to_byte()
    opad[i] = (kb ^ 0x5C).to_byte()
    i = i + 1
  }
  (ipad, opad)
}

///| RFC 2104 HMAC-SHA1 over a slice + optional 4-byte suffix using precomputed pads.
fn hmac_sha1_pads_with_suffix(
  ipad : Bytes,
  opad : Bytes,
  data : Bytes,
  start : Int,
  end : Int,
  suffix : Bytes,
) -> Bytes {
  let inner = crypto::Sha1::new()
  inner.update(ipad)
  inner.update_slice(data, start, end)
  if suffix.length() > 0 {
    inner.update(suffix)
  }
  let inner_hash = inner.finalize()

  let outer = crypto::Sha1::new()
  outer.update(opad)
  outer.update(inner_hash)
  outer.finalize()
}
