///| Public types, errors, and decode limits for `packages/rtp`.
///| Covers RFC 3550 (RTP/RTCP), RFC 5285 (RTP Header Extensions),
///| RFC 4585 / RFC 5104 (RTCP Feedback), RFC 3711 (SRTP/SRTCP),
///| RFC 7714 (AEAD-AES-128-GCM), and RFC 7983 (RTP/RTCP Demux).

///|
pub enum RtpError {
  Truncated(String)
  InvalidVersion(Int)
  InvalidPadding(String)
  InvalidExtension(String)
  InvalidPayloadType(Int)
  InvalidRtcp(String)
  LimitExceeded(String)
  InvalidKeyLength(String)
  InvalidSaltLength(String)
  UnsupportedProfile(String)
  AuthenticationFailed(String)
  ReplayDetected(String)
  SsrcNotFound(UInt)
  InvalidArgument(String)
}

///|
pub fn rtp_error_message(err : RtpError) -> String {
  match err {
    RtpError::Truncated(m) => "truncated: " + m
    RtpError::InvalidVersion(v) => "invalid RTP/RTCP version: " + v.to_string()
    RtpError::InvalidPadding(m) => "invalid padding: " + m
    RtpError::InvalidExtension(m) => "invalid header extension: " + m
    RtpError::InvalidPayloadType(pt) => "invalid payload type: " + pt.to_string()
    RtpError::InvalidRtcp(m) => "invalid RTCP: " + m
    RtpError::LimitExceeded(m) => "limit exceeded: " + m
    RtpError::InvalidKeyLength(m) => "invalid key length: " + m
    RtpError::InvalidSaltLength(m) => "invalid salt length: " + m
    RtpError::UnsupportedProfile(m) => "unsupported SRTP profile: " + m
    RtpError::AuthenticationFailed(m) => "authentication failed: " + m
    RtpError::ReplayDetected(m) => "replay detected: " + m
    RtpError::SsrcNotFound(s) => "SSRC not found: " + s.to_string()
    RtpError::InvalidArgument(m) => "invalid argument: " + m
  }
}

///|
pub val struct DecodeLimits {
  pub max_csrcs : Int
  pub max_extensions : Int
  pub max_extension_bytes : Int
  pub max_rtcp_packets : Int
  pub max_report_blocks : Int
  pub max_sdes_chunks : Int
  pub max_sdes_items : Int
  pub max_nacks : Int
  pub max_payload_bytes : Int
}

///|
pub fn DecodeLimits::default() -> DecodeLimits {
  DecodeLimits::{
    max_csrcs: 15,
    max_extensions: 64,
    max_extension_bytes: 1024,
    max_rtcp_packets: 64,
    max_report_blocks: 31,
    max_sdes_chunks: 31,
    max_sdes_items: 64,
    max_nacks: 256,
    max_payload_bytes: 65536,
  }
}

///|
pub fn DecodeLimits::new(
  max_csrcs : Int,
  max_extensions : Int,
  max_extension_bytes : Int,
  max_rtcp_packets : Int,
  max_report_blocks : Int,
  max_sdes_chunks : Int,
  max_sdes_items : Int,
  max_nacks : Int,
  max_payload_bytes : Int,
) -> DecodeLimits {
  DecodeLimits::{
    max_csrcs: max_csrcs,
    max_extensions: max_extensions,
    max_extension_bytes: max_extension_bytes,
    max_rtcp_packets: max_rtcp_packets,
    max_report_blocks: max_report_blocks,
    max_sdes_chunks: max_sdes_chunks,
    max_sdes_items: max_sdes_items,
    max_nacks: max_nacks,
    max_payload_bytes: max_payload_bytes,
  }
}

///|
fn validate_limits(limits : DecodeLimits) -> Result[Unit, RtpError] {
  if limits.max_csrcs < 0 {
    return Err(RtpError::LimitExceeded("max_csrcs must be >= 0"))
  }
  if limits.max_extensions < 0 {
    return Err(RtpError::LimitExceeded("max_extensions must be >= 0"))
  }
  if limits.max_extension_bytes < 0 {
    return Err(RtpError::LimitExceeded("max_extension_bytes must be >= 0"))
  }
  if limits.max_rtcp_packets < 0 {
    return Err(RtpError::LimitExceeded("max_rtcp_packets must be >= 0"))
  }
  if limits.max_report_blocks < 0 {
    return Err(RtpError::LimitExceeded("max_report_blocks must be >= 0"))
  }
  if limits.max_sdes_chunks < 0 {
    return Err(RtpError::LimitExceeded("max_sdes_chunks must be >= 0"))
  }
  if limits.max_sdes_items < 0 {
    return Err(RtpError::LimitExceeded("max_sdes_items must be >= 0"))
  }
  if limits.max_nacks < 0 {
    return Err(RtpError::LimitExceeded("max_nacks must be >= 0"))
  }
  if limits.max_payload_bytes < 0 {
    return Err(RtpError::LimitExceeded("max_payload_bytes must be >= 0"))
  }
  Ok(())
}

///| RFC 5285 header extension entry.
pub struct HeaderExtension {
  pub id : Int
  pub payload : Bytes
}

///| RFC 3550 + RFC 5285 RTP header.
pub struct RtpHeader {
  pub version : Int
  pub padding : Bool
  pub extension : Bool
  pub marker : Bool
  pub payload_type : Int
  pub sequence_number : Int
  pub timestamp : UInt
  pub ssrc : UInt
  pub csrcs : Array[UInt]
  pub extension_profile : Int
  pub extensions : Array[HeaderExtension]
  pub raw_extension_payload : Bytes
}

///|
pub fn RtpHeader::get_extension(self : RtpHeader, id : Int) -> Option[Bytes] {
  let mut i = 0
  while i < self.extensions.length() {
    if self.extensions[i].id == id {
      return Some(self.extensions[i].payload)
    }
    i = i + 1
  }
  None
}

///| RFC 3550 RTP packet.
pub struct RtpPacket {
  pub header : RtpHeader
  pub payload : Bytes
  pub padding_size : Int
}

///| RFC 3550 §6.4.1 Reception Report block (24 bytes).
pub val struct ReceptionReport {
  pub ssrc : UInt
  pub fraction_lost : Int
  pub total_lost : Int
  pub last_seq : UInt
  pub jitter : UInt
  pub last_sr : UInt
  pub delay_since_last_sr : UInt
}

///| RTCP Sender Report (PT=200).
pub struct SenderReport {
  pub ssrc : UInt
  pub ntp_time : UInt64
  pub rtp_time : UInt
  pub packet_count : UInt
  pub octet_count : UInt
  pub reports : Array[ReceptionReport]
  pub profile_extensions : Bytes
}

///| RTCP Receiver Report (PT=201).
pub struct ReceiverReport {
  pub ssrc : UInt
  pub reports : Array[ReceptionReport]
  pub profile_extensions : Bytes
}

///| RTCP SDES item (RFC 3550 §6.5).
pub struct SdesItem {
  pub item_type : Int
  pub text : Bytes
}

///| RTCP SDES chunk.
pub struct SdesChunk {
  pub ssrc : UInt
  pub items : Array[SdesItem]
}

///| RTCP Source Description (PT=202).
pub struct SourceDescription {
  pub chunks : Array[SdesChunk]
}

///| RTCP Goodbye (PT=203).
pub struct Goodbye {
  pub sources : Array[UInt]
  pub reason : Bytes
}

///| RFC 4585 Generic NACK FCI pair.
pub val struct NackPair {
  pub packet_id : Int
  pub lost_packets : Int
}

///| RFC 4585 Transport-Layer NACK (PT=205, FMT=1).
pub struct TransportLayerNack {
  pub sender_ssrc : UInt
  pub media_ssrc : UInt
  pub nacks : Array[NackPair]
}

///| Transport-Wide Congestion Control feedback (PT=205, FMT=15) raw payload passthrough.
pub struct TransportWideCc {
  pub sender_ssrc : UInt
  pub media_ssrc : UInt
  pub payload : Bytes
}

///| RFC 4585 Picture Loss Indication (PT=206, FMT=1).
pub val struct PictureLossIndication {
  pub sender_ssrc : UInt
  pub media_ssrc : UInt
}

///| RFC 5104 FIR entry.
pub val struct FirEntry {
  pub ssrc : UInt
  pub sequence_number : Int
}

///| RFC 5104 Full Intra Request (PT=206, FMT=4).
pub struct FullIntraRequest {
  pub sender_ssrc : UInt
  pub media_ssrc : UInt
  pub entries : Array[FirEntry]
}

///| draft-alvestrand-rmcat-remb Receiver Estimated Maximum Bitrate (PT=206, FMT=15).
pub struct ReceiverEstimatedMaximumBitrate {
  pub sender_ssrc : UInt
  pub media_ssrc : UInt
  pub bitrate : UInt64
  pub ssrcs : Array[UInt]
}

///| Unrecognized RTCP packet passthrough.
pub struct UnknownRtcp {
  pub packet_type : Int
  pub count : Int
  pub payload : Bytes
}

///| Decoded RTCP packet variant.
pub enum RtcpPacket {
  Sr(SenderReport)
  Rr(ReceiverReport)
  Sdes(SourceDescription)
  Bye(Goodbye)
  Nack(TransportLayerNack)
  Twcc(TransportWideCc)
  Pli(PictureLossIndication)
  Fir(FullIntraRequest)
  Remb(ReceiverEstimatedMaximumBitrate)
  Unknown(UnknownRtcp)
}

///| SRTP / SRTCP protection profiles (RFC 3711 + RFC 7714).
pub enum ProtectionProfile {
  Aes128CmHmacSha1_80
  Aes128CmHmacSha1_32
  AeadAes128Gcm
}

///| Derived session keys for SRTP or SRTCP.
pub struct SrtpSessionKeys {
  pub enc_key : Bytes
  pub auth_key : Bytes
  pub salt : Bytes
}

///| Per-SSRC ROC and 64-packet replay window state.
pub struct SsrcState {
  ssrc : UInt
  mut roc : UInt
  mut s_l : Int
  mut has_seq : Bool
  mut replay_mask : UInt64
}

///| Stateful SRTP/SRTCP protection context (one direction: send or receive).
pub struct SrtpContext {
  profile : ProtectionProfile
  srtp_keys : SrtpSessionKeys
  srtcp_keys : SrtpSessionKeys
  srtp_aes : Aes128Key
  srtcp_aes : Aes128Key
  srtp_ghash : GhashTable
  srtcp_ghash : GhashTable
  srtp_hmac_ipad : Bytes
  srtp_hmac_opad : Bytes
  srtcp_hmac_ipad : Bytes
  srtcp_hmac_opad : Bytes
  ssrc_states : Array[SsrcState]
  mut srtcp_index : UInt
  mut srtcp_max_index : UInt
  mut srtcp_has_index : Bool
  mut srtcp_replay_mask : UInt64
}
