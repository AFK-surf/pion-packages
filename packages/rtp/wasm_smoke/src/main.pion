///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/rtp`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "rtp"
import "crypto"

///|
fn must_hex(s : String) -> Bytes {
  match crypto::hex_to_bytes(s) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///|
pub fn main(world : World) -> Int {
  // 1. RTP with RFC 5285 One-Byte extensions
  let rtp_pkt = rtp::RtpPacket::{
    header: rtp::RtpHeader::{
      version: 2,
      padding: false,
      extension: true,
      marker: true,
      payload_type: 96,
      sequence_number: 65535,
      timestamp: 90000U,
      ssrc: 0x5501A0B2U,
      csrcs: [0x11223344U],
      extension_profile: 0xBEDE,
      extensions: [
        rtp::HeaderExtension::{ id: 1, payload: must_hex("30") },
        rtp::HeaderExtension::{ id: 2, payload: must_hex("123456") },
        rtp::HeaderExtension::{ id: 3, payload: must_hex("0042") },
      ],
      raw_extension_payload: Bytes::new(0),
    },
    payload: must_hex("47616c6c696120657374206f6d6e6973"),
    padding_size: 0,
  }
  let rtp_wire = match rtp::marshal_rtp(rtp_pkt) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR rtp marshal: " + rtp::rtp_error_message(e))
      return 1
    }
  }
  let rtp_dec = match rtp::parse_rtp(rtp_wire) {
    Ok(p) => p
    Err(e) => {
      io_println(world, "ERR rtp parse: " + rtp::rtp_error_message(e))
      return 2
    }
  }

  // 2. RTCP compound (SR + PLI + NACK)
  let rtcp_wire = match rtp::marshal_rtcp([
    rtp::RtcpPacket::Sr(rtp::SenderReport::{
      ssrc: 0x5501A0B2U,
      ntp_time: 0xE5A1B2C300001234UL,
      rtp_time: 90000U,
      packet_count: 100U,
      octet_count: 120000U,
      reports: [],
      profile_extensions: Bytes::new(0),
    }),
    rtp::RtcpPacket::Pli(rtp::PictureLossIndication::{
      sender_ssrc: 0x11223344U,
      media_ssrc: 0x5501A0B2U,
    }),
    rtp::RtcpPacket::Nack(rtp::TransportLayerNack::{
      sender_ssrc: 0x11223344U,
      media_ssrc: 0x5501A0B2U,
      nacks: [rtp::NackPair::{ packet_id: 65535, lost_packets: 0x0003 }],
    }),
  ]) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR rtcp marshal: " + rtp::rtp_error_message(e))
      return 3
    }
  }
  let rtcp_dec = match rtp::parse_rtcp(rtcp_wire) {
    Ok(ps) => ps
    Err(e) => {
      io_println(world, "ERR rtcp parse: " + rtp::rtp_error_message(e))
      return 4
    }
  }

  // 3. RFC 3711 Appendix B.3 KDF + SRTP AES128_CM_HMAC_SHA1_80
  let mk = must_hex("e1f97a0d3e018be0d64fa32c06de4139")
  let ms14 = must_hex("0ec675ad498afeebb6960b3aabe6")
  let kdf = match rtp::derive_srtp_keys(rtp::ProtectionProfile::Aes128CmHmacSha1_80, mk, ms14) {
    Ok(k) => k
    Err(e) => {
      io_println(world, "ERR kdf: " + rtp::rtp_error_message(e))
      return 5
    }
  }
  let tx_cm = match rtp::SrtpContext::new(rtp::ProtectionProfile::Aes128CmHmacSha1_80, mk, ms14) {
    Ok(c) => c
    Err(_) => return 6
  }
  let rx_cm = match rtp::SrtpContext::new(rtp::ProtectionProfile::Aes128CmHmacSha1_80, mk, ms14) {
    Ok(c) => c
    Err(_) => return 6
  }
  let srtp_cm = match tx_cm.encrypt_rtp(rtp_wire) {
    Ok(b) => b
    Err(_) => return 7
  }
  let plain_cm = match rx_cm.decrypt_rtp(srtp_cm) {
    Ok(b) => b
    Err(_) => return 8
  }

  // 4. RFC 7714 AEAD_AES_128_GCM
  let ms12 = must_hex("517569642070726f2071756f")
  let tx_gcm = match rtp::SrtpContext::new(rtp::ProtectionProfile::AeadAes128Gcm, mk, ms12) {
    Ok(c) => c
    Err(_) => return 9
  }
  let rx_gcm = match rtp::SrtpContext::new(rtp::ProtectionProfile::AeadAes128Gcm, mk, ms12) {
    Ok(c) => c
    Err(_) => return 9
  }
  let srtp_gcm = match tx_gcm.encrypt_rtp(rtp_wire) {
    Ok(b) => b
    Err(_) => return 10
  }
  let plain_gcm = match rx_gcm.decrypt_rtp(srtp_gcm) {
    Ok(b) => b
    Err(_) => return 11
  }
  let srtcp_gcm = match tx_gcm.encrypt_rtcp(rtcp_wire) {
    Ok(b) => b
    Err(_) => return 12
  }
  let plain_rtcp = match rx_gcm.decrypt_rtcp(srtcp_gcm) {
    Ok(b) => b
    Err(_) => return 13
  }

  io_println(world, "rtp_wasm_smoke:ok")
  io_println(
    world,
    "rtp seq=" + rtp_dec.header.sequence_number.to_string() +
    " exts=" + rtp_dec.header.extensions.length().to_string() +
    " wire=" + rtp_wire.length().to_string(),
  )
  io_println(
    world,
    "rtcp count=" + rtcp_dec.length().to_string() + " wire=" + rtcp_wire.length().to_string(),
  )
  io_println(world, "kdf_enc=" + crypto::bytes_to_hex(kdf.enc_key))
  io_println(world, "srtp_cm=" + crypto::bytes_to_hex(srtp_cm))
  io_println(world, "srtp_gcm=" + crypto::bytes_to_hex(srtp_gcm))
  io_println(world, "srtcp_gcm=" + crypto::bytes_to_hex(srtcp_gcm))
  io_println(
    world,
    "roundtrip=" + (if crypto::constant_time_eq(plain_cm, rtp_wire) &&
      crypto::constant_time_eq(plain_gcm, rtp_wire) &&
      crypto::constant_time_eq(plain_rtcp, rtcp_wire) {
        "exact"
      } else {
        "mismatch"
    }),
  )
  0
}
