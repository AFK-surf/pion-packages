///| Comprehensive RFC 3550 / RFC 5285 / RFC 4585 / RFC 5104 / RFC 3711 / RFC 7714 / RFC 7983 test suite.

import "crypto"

///|
fn t_assert(cond : Bool, msg : String) -> Unit {
  debug_assert(cond, msg)
}

///|
fn must_hex(s : String) -> Bytes {
  match crypto::hex_to_bytes(s) {
    Some(b) => b
    None => Bytes::new(0)
  }
}

///|
fn make_rtp_bytes(seq : Int, ts : UInt, ssrc : UInt, payload : Bytes) -> Bytes {
  let pkt = RtpPacket::{
    header: RtpHeader::{
      version: 2,
      padding: false,
      extension: false,
      marker: false,
      payload_type: 96,
      sequence_number: seq,
      timestamp: ts,
      ssrc: ssrc,
      csrcs: [],
      extension_profile: 0,
      extensions: [],
      raw_extension_payload: Bytes::new(0),
    },
    payload: payload,
    padding_size: 0,
  }
  match marshal_rtp(pkt) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///|
test "rfc7983_demux_rtp_vs_rtcp_vs_stun_dtls" {
  let rtp_pkt = must_hex("80600001000000a012345678deadbeef")
  t_assert(is_rtp_packet(rtp_pkt), "valid rtp")
  t_assert(!is_rtcp_packet(rtp_pkt), "rtp not rtcp")

  let rtp_m = must_hex("80ef00020000014012345678cafebabe")
  t_assert(is_rtp_packet(rtp_m), "rtp with marker")
  t_assert(!is_rtcp_packet(rtp_m), "rtp marker not rtcp")

  let rtcp_sr = must_hex("80c80006123456780000000000000000000000000000000000000000")
  t_assert(is_rtcp_packet(rtcp_sr), "valid rtcp sr")
  t_assert(!is_rtp_packet(rtcp_sr), "rtcp sr not rtp")

  let rtcp_pli = must_hex("81ce00021122334455667788")
  t_assert(is_rtcp_packet(rtcp_pli), "valid rtcp pli")
  t_assert(!is_rtp_packet(rtcp_pli), "rtcp pli not rtp")

  let stun_pkt = must_hex("000100002112a442000102030405060708090a0b")
  t_assert(!is_rtp_packet(stun_pkt), "stun not rtp")
  t_assert(!is_rtcp_packet(stun_pkt), "stun not rtcp")

  let dtls_pkt = must_hex("16fefd0000000000000001000c01020304")
  t_assert(!is_rtp_packet(dtls_pkt), "dtls not rtp")
  t_assert(!is_rtcp_packet(dtls_pkt), "dtls not rtcp")

  let short_pkt = must_hex("80600001")
  t_assert(!is_rtp_packet(short_pkt), "short not rtp")
  t_assert(!is_rtcp_packet(short_pkt), "short not rtcp")
}

///|
test "rfc3550_rtp_roundtrip_csrc_and_padding" {
  let payload = must_hex("0102030405060708")
  let pkt = RtpPacket::{
    header: RtpHeader::{
      version: 2,
      padding: true,
      extension: false,
      marker: true,
      payload_type: 111,
      sequence_number: 42319,
      timestamp: 0x11223344U,
      ssrc: 0xAABBCCDDU,
      csrcs: [0x10203040U, 0x50607080U],
      extension_profile: 0,
      extensions: [],
      raw_extension_payload: Bytes::new(0),
    },
    payload: payload,
    padding_size: 4,
  }
  let wire = match marshal_rtp(pkt) {
    Ok(b) => b
    Err(e) => {
      t_assert(false, "marshal_rtp failed: " + rtp_error_message(e))
      Bytes::new(0)
    }
  }
  t_assert(wire.length() == 32, "wire length 32")
  t_assert(wire[31].to_int() == 4, "padding len byte")
  t_assert(wire[0].to_int() == 0xA2, "byte0 V=2 P=1 CC=2")
  t_assert(wire[1].to_int() == 0xEF, "byte1 M=1 PT=111")

  let decoded = match parse_rtp(wire) {
    Ok(p) => p
    Err(e) => {
      t_assert(false, "parse_rtp failed: " + rtp_error_message(e))
      pkt
    }
  }
  t_assert(decoded.header.version == 2, "version 2")
  t_assert(decoded.header.padding, "padding flag")
  t_assert(decoded.header.marker, "marker flag")
  t_assert(decoded.header.payload_type == 111, "pt 111")
  t_assert(decoded.header.sequence_number == 42319, "seq 42319")
  t_assert(decoded.header.timestamp == 0x11223344U, "ts")
  t_assert(decoded.header.ssrc == 0xAABBCCDDU, "ssrc")
  t_assert(decoded.header.csrcs.length() == 2, "csrc count 2")
  t_assert(decoded.header.csrcs[0] == 0x10203040U, "csrc 0")
  t_assert(decoded.header.csrcs[1] == 0x50607080U, "csrc 1")
  t_assert(decoded.padding_size == 4, "padding_size 4")
  t_assert(crypto::bytes_to_hex(decoded.payload) == "0102030405060708", "payload")
}

///|
test "rfc5285_one_byte_and_two_byte_extensions" {
  let ext_one = RtpPacket::{
    header: RtpHeader::{
      version: 2,
      padding: false,
      extension: true,
      marker: true,
      payload_type: 96,
      sequence_number: 1001,
      timestamp: 90000U,
      ssrc: 0x01020304U,
      csrcs: [],
      extension_profile: 0xBEDE,
      extensions: [
        HeaderExtension::{ id: 1, payload: must_hex("30") },
        HeaderExtension::{ id: 2, payload: must_hex("123456") },
        HeaderExtension::{ id: 3, payload: must_hex("00ff") },
        HeaderExtension::{ id: 10, payload: must_hex("80") },
      ],
      raw_extension_payload: Bytes::new(0),
    },
    payload: must_hex("aabbccdd"),
    padding_size: 0,
  }
  let wire1 = match marshal_rtp(ext_one) {
    Ok(b) => b
    Err(e) => {
      t_assert(false, "marshal one-byte ext: " + rtp_error_message(e))
      Bytes::new(0)
    }
  }
  t_assert(wire1.length() > 16, "one-byte wire len")
  let dec1 = match parse_rtp(wire1) {
    Ok(p) => p
    Err(e) => {
      t_assert(false, "parse one-byte ext: " + rtp_error_message(e))
      ext_one
    }
  }
  t_assert(dec1.header.extension, "ext flag")
  t_assert(dec1.header.extension_profile == 0xBEDE, "profile 0xBEDE")
  t_assert(dec1.header.extensions.length() == 4, "4 extensions")
  match dec1.header.get_extension(2) {
    Some(v) => t_assert(crypto::bytes_to_hex(v) == "123456", "abs-send-time")
    None => t_assert(false, "missing ext 2")
  }
  match dec1.header.get_extension(3) {
    Some(v) => t_assert(crypto::bytes_to_hex(v) == "00ff", "twcc")
    None => t_assert(false, "missing ext 3")
  }
  t_assert(crypto::bytes_to_hex(dec1.payload) == "aabbccdd", "payload1")

  let ext_two = RtpPacket::{
    header: RtpHeader::{
      version: 2,
      padding: false,
      extension: true,
      marker: false,
      payload_type: 98,
      sequence_number: 2002,
      timestamp: 180000U,
      ssrc: 0x05060708U,
      csrcs: [],
      extension_profile: 0x1000,
      extensions: [
        HeaderExtension::{ id: 20, payload: must_hex("41424344") },
        HeaderExtension::{ id: 21, payload: Bytes::new(0) },
      ],
      raw_extension_payload: Bytes::new(0),
    },
    payload: must_hex("eeff"),
    padding_size: 0,
  }
  let wire2 = match marshal_rtp(ext_two) {
    Ok(b) => b
    Err(e) => {
      t_assert(false, "marshal two-byte ext: " + rtp_error_message(e))
      Bytes::new(0)
    }
  }
  let dec2 = match parse_rtp(wire2) {
    Ok(p) => p
    Err(e) => {
      t_assert(false, "parse two-byte ext: " + rtp_error_message(e))
      ext_two
    }
  }
  t_assert(dec2.header.extension_profile == 0x1000, "profile 0x1000")
  t_assert(dec2.header.extensions.length() == 2, "2 two-byte exts")
  match dec2.header.get_extension(20) {
    Some(v) => t_assert(crypto::bytes_to_hex(v) == "41424344", "ext 20")
    None => t_assert(false, "missing ext 20")
  }
  match dec2.header.get_extension(21) {
    Some(v) => t_assert(v.length() == 0, "ext 21 empty")
    None => t_assert(false, "missing ext 21")
  }
}

///|
test "rfc3550_malformed_and_limits_rejected" {
  let bad_ver = must_hex("406000010000000012345678")
  let ver_err = match parse_rtp(bad_ver) {
    Err(RtpError::InvalidVersion(1)) => true
    _ => false
  }
  t_assert(ver_err, "reject version 1")

  let bad_pad0 = must_hex("a06000010000000012345678dead00")
  let pad0_err = match parse_rtp(bad_pad0) {
    Err(RtpError::InvalidPadding(_)) => true
    _ => false
  }
  t_assert(pad0_err, "reject padding 0")

  let bad_pad_big = must_hex("a06000010000000012345678dead05")
  let pad_big_err = match parse_rtp(bad_pad_big) {
    Err(RtpError::InvalidPadding(_)) => true
    _ => false
  }
  t_assert(pad_big_err, "reject oversized padding")

  let valid = must_hex("806000010000000012345678aa")
  let neg_lim = DecodeLimits::new(-1, 64, 1024, 64, 31, 31, 64, 256, 65536)
  let neg_err = match parse_rtp_with_limits(valid, neg_lim) {
    Err(RtpError::LimitExceeded(_)) => true
    _ => false
  }
  t_assert(neg_err, "reject negative limit")

  let with_csrc = must_hex("81600001000000001234567811111111aa")
  let zero_csrc = DecodeLimits::new(0, 64, 1024, 64, 31, 31, 64, 256, 65536)
  let csrc_err = match parse_rtp_with_limits(with_csrc, zero_csrc) {
    Err(RtpError::LimitExceeded(_)) => true
    _ => false
  }
  t_assert(csrc_err, "zero limit strictly rejects 1 CSRC")
}

///|
test "rfc3550_rfc4585_rfc5104_rtcp_compound_roundtrip" {
  let sr = RtcpPacket::Sr(SenderReport::{
    ssrc: 0x11223344U,
    ntp_time: 0xE5A1B2C300001234UL,
    rtp_time: 90000U,
    packet_count: 1500U,
    octet_count: 1800000U,
    reports: [
      ReceptionReport::{
        ssrc: 0x55667788U,
        fraction_lost: 12,
        total_lost: -3,
        last_seq: 0x00010005U,
        jitter: 42U,
        last_sr: 0xAABBCCDDU,
        delay_since_last_sr: 65536U,
      },
    ],
    profile_extensions: Bytes::new(0),
  })
  let sdes = RtcpPacket::Sdes(SourceDescription::{
    chunks: [
      SdesChunk::{
        ssrc: 0x11223344U,
        items: [SdesItem::{ item_type: 1, text: must_hex("70696f6e406d656574") }],
      },
    ],
  })
  let pli = RtcpPacket::Pli(PictureLossIndication::{
    sender_ssrc: 0x55667788U,
    media_ssrc: 0x11223344U,
  })
  let nack = RtcpPacket::Nack(TransportLayerNack::{
    sender_ssrc: 0x55667788U,
    media_ssrc: 0x11223344U,
    nacks: [NackPair::{ packet_id: 65535, lost_packets: 0x0005 }],
  })
  let fir = RtcpPacket::Fir(FullIntraRequest::{
    sender_ssrc: 0x55667788U,
    media_ssrc: 0U,
    entries: [FirEntry::{ ssrc: 0x11223344U, sequence_number: 7 }],
  })
  let remb = RtcpPacket::Remb(ReceiverEstimatedMaximumBitrate::{
    sender_ssrc: 0x55667788U,
    media_ssrc: 0U,
    bitrate: 2500000UL,
    ssrcs: [0x11223344U, 0x99AABBCCU],
  })
  let twcc = RtcpPacket::Twcc(TransportWideCc::{
    sender_ssrc: 0x55667788U,
    media_ssrc: 0x11223344U,
    payload: must_hex("0001000200030405"),
  })
  let bye = RtcpPacket::Bye(Goodbye::{
    sources: [0x11223344U],
    reason: must_hex("627965"),
  })

  let compound = [sr, sdes, pli, nack, fir, remb, twcc, bye]
  let wire = match marshal_rtcp(compound) {
    Ok(b) => b
    Err(e) => {
      t_assert(false, "marshal_rtcp: " + rtp_error_message(e))
      Bytes::new(0)
    }
  }
  t_assert(is_rtcp_packet(wire), "compound is rtcp")
  let decoded = match parse_rtcp(wire) {
    Ok(ps) => ps
    Err(e) => {
      t_assert(false, "parse_rtcp: " + rtp_error_message(e))
      []
    }
  }
  t_assert(decoded.length() == 8, "8 compound packets")

  match decoded[0] {
    RtcpPacket::Sr(v) => {
      t_assert(v.ssrc == 0x11223344U, "sr ssrc")
      t_assert(v.ntp_time == 0xE5A1B2C300001234UL, "sr ntp")
      t_assert(v.reports.length() == 1, "sr 1 report")
      t_assert(v.reports[0].total_lost == -3, "sr signed total_lost -3")
    }
    _ => t_assert(false, "expected SR")
  }

  match decoded[3] {
    RtcpPacket::Nack(v) => {
      t_assert(v.nacks.length() == 1, "1 nack pair")
      let lost = v.nacks[0].packet_list()
      t_assert(lost.length() == 3, "3 lost seqs")
      t_assert(lost[0] == 65535, "lost 0")
      t_assert(lost[1] == 0, "lost 1")
      t_assert(lost[2] == 2, "lost 2")
    }
    _ => t_assert(false, "expected NACK")
  }

  match decoded[5] {
    RtcpPacket::Remb(v) => {
      t_assert(v.bitrate == 2500000UL, "remb bitrate")
      t_assert(v.ssrcs.length() == 2, "remb 2 ssrcs")
      t_assert(v.ssrcs[1] == 0x99AABBCCU, "remb ssrc 1")
    }
    _ => t_assert(false, "expected REMB")
  }
}

///|
test "rfc3711_appendix_b3_key_derivation_vector" {
  let master_key = must_hex("e1f97a0d3e018be0d64fa32c06de4139")
  let master_salt = must_hex("0ec675ad498afeebb6960b3aabe6")
  let keys = match derive_srtp_keys(ProtectionProfile::Aes128CmHmacSha1_80, master_key, master_salt) {
    Ok(k) => k
    Err(e) => {
      t_assert(false, "derive_srtp_keys: " + rtp_error_message(e))
      SrtpSessionKeys::{ enc_key: Bytes::new(0), auth_key: Bytes::new(0), salt: Bytes::new(0) }
    }
  }
  t_assert(
    crypto::bytes_to_hex(keys.enc_key) == "c61e7a93744f39ee10734afe3ff7a087",
    "RFC 3711 B.3 cipher key",
  )
  t_assert(
    crypto::bytes_to_hex(keys.salt) == "30cbbc08863d8c85d49db34a9ae1",
    "RFC 3711 B.3 cipher salt",
  )
  t_assert(
    crypto::bytes_to_hex(keys.auth_key) == "cebe321f6ff7716b6fd4ab49af256a156d38baa4",
    "RFC 3711 B.3 auth key",
  )
}

///|
test "rfc7714_section_16_1_1_aead_aes_128_gcm_vector" {
  let session_key = must_hex("000102030405060708090a0b0c0d0e0f")
  let session_salt = must_hex("517569642070726f2071756f")
  let srtp_keys = SrtpSessionKeys::{
    enc_key: session_key,
    auth_key: Bytes::new(0),
    salt: session_salt,
  }
  let sender = match SrtpContext::from_session_keys(
    ProtectionProfile::AeadAes128Gcm,
    srtp_keys,
    srtp_keys,
  ) {
    Ok(c) => c
    Err(e) => {
      t_assert(false, "from_session_keys sender: " + rtp_error_message(e))
      return
    }
  }
  let receiver = match SrtpContext::from_session_keys(
    ProtectionProfile::AeadAes128Gcm,
    srtp_keys,
    srtp_keys,
  ) {
    Ok(c) => c
    Err(_) => return
  }

  let plaintext_rtp = must_hex(
    "8040f17b8041f8d35501a0b247616c6c696120657374206f6d6e69732064697669736120696e207061727465732074726573",
  )
  let expected_srtp = "8040f17b8041f8d35501a0b2f24de3a3fb34de6cacba861c9d7e4bcabe633bd50d294e6f42a5f47a51c7d19b36de3adf8833899d7f27beb16a9152cf765ee4390cce"

  let encrypted = match sender.encrypt_rtp(plaintext_rtp) {
    Ok(b) => b
    Err(e) => {
      t_assert(false, "gcm encrypt: " + rtp_error_message(e))
      Bytes::new(0)
    }
  }
  t_assert(crypto::bytes_to_hex(encrypted) == expected_srtp, "RFC 7714 16.1.1 ciphertext+tag")

  let decrypted = match receiver.decrypt_rtp(encrypted) {
    Ok(b) => b
    Err(e) => {
      t_assert(false, "gcm decrypt: " + rtp_error_message(e))
      Bytes::new(0)
    }
  }
  t_assert(
    crypto::bytes_to_hex(decrypted) == crypto::bytes_to_hex(plaintext_rtp),
    "RFC 7714 16.1.1 decrypt",
  )
}

///|
test "srtp_cm_hmac_sha1_80_and_32_and_gcm_roundtrip_roc_replay_tamper" {
  let master_key = must_hex("e1f97a0d3e018be0d64fa32c06de4139")
  let master_salt_14 = must_hex("0ec675ad498afeebb6960b3aabe6")
  let master_salt_12 = must_hex("517569642070726f2071756f")
  let ssrc = 0xCAFEBABEU

  let tx80 = match SrtpContext::new(ProtectionProfile::Aes128CmHmacSha1_80, master_key, master_salt_14) {
    Ok(c) => c
    Err(e) => {
      t_assert(false, "tx80 new: " + rtp_error_message(e))
      return
    }
  }
  let rx80 = match SrtpContext::new(ProtectionProfile::Aes128CmHmacSha1_80, master_key, master_salt_14) {
    Ok(c) => c
    Err(_) => return
  }

  let p65534 = make_rtp_bytes(65534, 1000U, ssrc, must_hex("1122334455667788"))
  let p65535 = make_rtp_bytes(65535, 2000U, ssrc, must_hex("2233445566778899"))
  let p0 = make_rtp_bytes(0, 3000U, ssrc, must_hex("33445566778899aa"))
  let p1 = make_rtp_bytes(1, 4000U, ssrc, must_hex("445566778899aabb"))

  let e65534 = match tx80.encrypt_rtp(p65534) { Ok(b) => b; Err(_) => Bytes::new(0) }
  let e65535 = match tx80.encrypt_rtp(p65535) { Ok(b) => b; Err(_) => Bytes::new(0) }
  let e0 = match tx80.encrypt_rtp(p0) { Ok(b) => b; Err(_) => Bytes::new(0) }
  let e1 = match tx80.encrypt_rtp(p1) { Ok(b) => b; Err(_) => Bytes::new(0) }
  t_assert(tx80.get_roc(ssrc) == 1U, "tx ROC wrapped to 1")

  match rx80.decrypt_rtp(e65534) {
    Ok(d) => t_assert(crypto::bytes_to_hex(d) == crypto::bytes_to_hex(p65534), "rx 65534")
    Err(_) => t_assert(false, "rx 65534 failed")
  }
  match rx80.decrypt_rtp(e0) {
    Ok(d) => t_assert(crypto::bytes_to_hex(d) == crypto::bytes_to_hex(p0), "rx 0")
    Err(_) => t_assert(false, "rx 0 failed")
  }
  t_assert(rx80.get_roc(ssrc) == 1U, "rx ROC wrapped to 1")
  match rx80.decrypt_rtp(e65535) {
    Ok(d) => t_assert(crypto::bytes_to_hex(d) == crypto::bytes_to_hex(p65535), "rx late 65535")
    Err(_) => t_assert(false, "rx late 65535 failed")
  }
  match rx80.decrypt_rtp(e1) {
    Ok(d) => t_assert(crypto::bytes_to_hex(d) == crypto::bytes_to_hex(p1), "rx 1")
    Err(_) => t_assert(false, "rx 1 failed")
  }

  let replay_blocked = match rx80.decrypt_rtp(e0) {
    Err(RtpError::ReplayDetected(_)) => true
    _ => false
  }
  t_assert(replay_blocked, "replay blocked")

  let p2 = make_rtp_bytes(2, 5000U, ssrc, must_hex("5566778899aabbcc"))
  let e2 = match tx80.encrypt_rtp(p2) { Ok(b) => b; Err(_) => Bytes::new(0) }
  let tampered = Bytes::new(e2.length())
  let mut i = 0
  while i < e2.length() {
    tampered[i] = e2[i]
    i = i + 1
  }
  tampered[12] = (tampered[12].to_int() ^ 0x01).to_byte()
  let tamper_blocked = match rx80.decrypt_rtp(tampered) {
    Err(RtpError::AuthenticationFailed(_)) => true
    _ => false
  }
  t_assert(tamper_blocked, "tamper blocked")

  let tx32 = match SrtpContext::new(ProtectionProfile::Aes128CmHmacSha1_32, master_key, master_salt_14) {
    Ok(c) => c
    Err(_) => return
  }
  let rx32 = match SrtpContext::new(ProtectionProfile::Aes128CmHmacSha1_32, master_key, master_salt_14) {
    Ok(c) => c
    Err(_) => return
  }
  let e32 = match tx32.encrypt_rtp(p65534) { Ok(b) => b; Err(_) => Bytes::new(0) }
  t_assert(e32.length() == p65534.length() + 4, "32-bit tag len")
  match rx32.decrypt_rtp(e32) {
    Ok(d) => t_assert(crypto::bytes_to_hex(d) == crypto::bytes_to_hex(p65534), "rx32 ok")
    Err(_) => t_assert(false, "rx32 failed")
  }

  let rtcp_wire = match marshal_rtcp([
    RtcpPacket::Pli(PictureLossIndication::{ sender_ssrc: ssrc, media_ssrc: 0x11223344U }),
  ]) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let srtcp_cm = match tx80.encrypt_rtcp(rtcp_wire) { Ok(b) => b; Err(_) => Bytes::new(0) }
  match rx80.decrypt_rtcp(srtcp_cm) {
    Ok(d) => t_assert(crypto::bytes_to_hex(d) == crypto::bytes_to_hex(rtcp_wire), "srtcp cm ok")
    Err(_) => t_assert(false, "srtcp cm failed")
  }
  let srtcp_replay = match rx80.decrypt_rtcp(srtcp_cm) {
    Err(RtpError::ReplayDetected(_)) => true
    _ => false
  }
  t_assert(srtcp_replay, "srtcp replay blocked")

  let tx_gcm = match SrtpContext::new(ProtectionProfile::AeadAes128Gcm, master_key, master_salt_12) {
    Ok(c) => c
    Err(_) => return
  }
  let rx_gcm = match SrtpContext::new(ProtectionProfile::AeadAes128Gcm, master_key, master_salt_12) {
    Ok(c) => c
    Err(_) => return
  }
  let srtcp_gcm = match tx_gcm.encrypt_rtcp(rtcp_wire) { Ok(b) => b; Err(_) => Bytes::new(0) }
  match rx_gcm.decrypt_rtcp(srtcp_gcm) {
    Ok(d) => t_assert(crypto::bytes_to_hex(d) == crypto::bytes_to_hex(rtcp_wire), "srtcp gcm ok")
    Err(_) => t_assert(false, "srtcp gcm failed")
  }
}

///|
test "srtp_64_packet_replay_window_boundary_and_gcm_tamper" {
  let master_key = must_hex("e1f97a0d3e018be0d64fa32c06de4139")
  let master_salt_12 = must_hex("517569642070726f2071756f")
  let ssrc = 0x13579BDFU

  let tx = match SrtpContext::new(ProtectionProfile::AeadAes128Gcm, master_key, master_salt_12) {
    Ok(c) => c
    Err(_) => {
      t_assert(false, "tx gcm new")
      return
    }
  }
  let rx = match SrtpContext::new(ProtectionProfile::AeadAes128Gcm, master_key, master_salt_12) {
    Ok(c) => c
    Err(_) => return
  }

  let p0 = make_rtp_bytes(0, 100U, ssrc, must_hex("aa00"))
  let p1 = make_rtp_bytes(1, 200U, ssrc, must_hex("aa01"))
  let p64 = make_rtp_bytes(64, 6500U, ssrc, must_hex("aa40"))

  let e0 = match tx.encrypt_rtp(p0) { Ok(b) => b; Err(_) => Bytes::new(0) }
  let e1 = match tx.encrypt_rtp(p1) { Ok(b) => b; Err(_) => Bytes::new(0) }
  let e64 = match tx.encrypt_rtp(p64) { Ok(b) => b; Err(_) => Bytes::new(0) }

  // Receive seq 64 first -> window covers 1..64
  match rx.decrypt_rtp(e64) {
    Ok(d) => t_assert(crypto::bytes_to_hex(d) == crypto::bytes_to_hex(p64), "rx 64")
    Err(_) => t_assert(false, "rx 64 failed")
  }
  // seq 1 (age 63) is inside the 64-packet window -> accepted
  match rx.decrypt_rtp(e1) {
    Ok(d) => t_assert(crypto::bytes_to_hex(d) == crypto::bytes_to_hex(p1), "rx 1 age 63")
    Err(_) => t_assert(false, "rx 1 age 63 failed")
  }
  // seq 0 (age 64) is outside the 64-packet window -> rejected with ReplayDetected
  let too_old = match rx.decrypt_rtp(e0) {
    Err(RtpError::ReplayDetected(_)) => true
    _ => false
  }
  t_assert(too_old, "seq 0 age 64 rejected")

  // Tamper AAD (RTP header timestamp byte) in GCM -> rejected with AuthenticationFailed
  let p65 = make_rtp_bytes(65, 6600U, ssrc, must_hex("aa41"))
  let e65 = match tx.encrypt_rtp(p65) { Ok(b) => b; Err(_) => Bytes::new(0) }
  let bad_aad = Bytes::new(e65.length())
  let mut i = 0
  while i < e65.length() {
    bad_aad[i] = e65[i]
    i = i + 1
  }
  bad_aad[7] = (bad_aad[7].to_int() ^ 0x80).to_byte()
  let aad_rejected = match rx.decrypt_rtp(bad_aad) {
    Err(RtpError::AuthenticationFailed(_)) => true
    _ => false
  }
  t_assert(aad_rejected, "gcm AAD tamper rejected")
}

///|
test "rtcp_rr_and_limits_and_rfc5285_id15_terminator" {
  // RTCP RR roundtrip
  let rr = RtcpPacket::Rr(ReceiverReport::{
    ssrc: 0x0A0B0C0DU,
    reports: [
      ReceptionReport::{
        ssrc: 0x11112222U,
        fraction_lost: 0,
        total_lost: 5,
        last_seq: 12345U,
        jitter: 10U,
        last_sr: 0U,
        delay_since_last_sr: 0U,
      },
    ],
    profile_extensions: Bytes::new(0),
  })
  let rr_wire = match marshal_rtcp([rr]) { Ok(b) => b; Err(_) => Bytes::new(0) }
  match parse_rtcp(rr_wire) {
    Ok(ps) => {
      t_assert(ps.length() == 1, "1 rr")
      match ps[0] {
        RtcpPacket::Rr(v) => {
          t_assert(v.ssrc == 0x0A0B0C0DU, "rr ssrc")
          t_assert(v.reports.length() == 1, "rr 1 block")
          t_assert(v.reports[0].total_lost == 5, "rr total_lost")
        }
        _ => t_assert(false, "expected RR")
      }
    }
    Err(_) => t_assert(false, "parse rr failed")
  }

  // Zero limit on max_report_blocks strictly rejects 1 report block
  let zero_rb = DecodeLimits::new(15, 64, 1024, 64, 0, 31, 64, 256, 65536)
  let rb_err = match parse_rtcp_with_limits(rr_wire, zero_rb) {
    Err(RtpError::LimitExceeded(_)) => true
    _ => false
  }
  t_assert(rb_err, "max_report_blocks=0 rejects 1 block")

  // RFC 5285 One-Byte ID=15 early terminator: ext id=1 (val 0xAA), then 0xF0 (id=15), then id=2 (must be ignored)
  let pkt_id15 = must_hex("906000010000000012345678bede000210aaf020bb000000dead")
  match parse_rtp(pkt_id15) {
    Ok(p) => {
      t_assert(p.header.extensions.length() == 1, "id=15 terminates parsing")
      match p.header.get_extension(1) {
        Some(v) => t_assert(crypto::bytes_to_hex(v) == "aa", "ext 1")
        None => t_assert(false, "missing ext 1")
      }
      t_assert(crypto::bytes_to_hex(p.payload) == "dead", "payload after ext")
    }
    Err(e) => t_assert(false, "id15 parse: " + rtp_error_message(e))
  }
}
