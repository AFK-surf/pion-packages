///| Red-team differential / DoS / 4-mode probe for packages/sse (see ../../REPORT.md).
///
///   sse_audit_probe corpus <cases.hex>   one hex-encoded stream per line; prints every case under
///                                        whole / 1B / 2B / 3B / 7B / random chunking (Replace mode)
///                                        and whole / 1B (Strict mode)
///   sse_audit_probe misc                 deterministic reconnect / cursor URL / encoder dump
///   sse_audit_probe dos <kind> <n>       DoS probes (see `run_dos`)

import "sse"

///|
fn nib(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn unhex_range(b : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = (nib(b[start + 2 * i].to_int()) * 16 +
      nib(b[start + 2 * i + 1].to_int())).to_byte()
    i = i + 1
  }
  out
}

///|
fn hex_str(s : String) -> String {
  let b = s.to_bytes()
  let d = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_string(d.slice(v >> 4, (v >> 4) + 1))
    sb.write_string(d.slice(v & 15, (v & 15) + 1))
    i = i + 1
  }
  sb.to_string()
}

///|
fn err_kind(e : sse::SseError) -> String {
  match e {
    sse::SseError::LineTooLarge(_, _) => "LineTooLarge"
    sse::SseError::EventTooLarge(_, _) => "EventTooLarge"
    sse::SseError::TooManyDataLines(_, _) => "TooManyDataLines"
    sse::SseError::InvalidLimits(_) => "InvalidLimits"
    sse::SseError::InvalidFieldValue(_) => "InvalidFieldValue"
    sse::SseError::InvalidUtf8(_) => "InvalidUtf8"
    sse::SseError::Unimplemented => "Unimplemented"
  }
}

///|
fn opt_str(r : Option[Int64]) -> String {
  match r {
    Some(v) => v.to_string()
    None => "-"
  }
}

///|
fn dump_event(sb : StringBuilder, ev : sse::SseEvent) -> Unit {
  sb.write_string("[t=")
  sb.write_string(hex_str(ev.event_type))
  sb.write_string(",d=")
  sb.write_string(hex_str(ev.data))
  sb.write_string(",i=")
  sb.write_string(hex_str(ev.id))
  sb.write_string(",r=")
  sb.write_string(opt_str(ev.retry))
  sb.write_string("]")
}

///| Next chunk length: `step > 0` fixed, `step == 0` whole buffer, `step < 0` LCG random 1..=17.
fn next_len(step : Int, rng : Array[Int64], remaining : Int) -> Int {
  if step == 0 {
    remaining
  } else if step > 0 {
    step
  } else {
    rng[0] = rng[0] * 6364136223846793005L + 1442695040888963407L
    (((rng[0] >> 33) & 0x7FFFFFFFL) % 17L).to_int() + 1
  }
}

///| Feed `input` with the given chunking; returns `events... (!ERR:kind | last=.. sretry=..)`.
fn run_stream(input : Bytes, step : Int, seed : Int, strict : Bool) -> String {
  let p = if strict {
    sse::SseParser::with_options(sse::SseLimits::default(), sse::Utf8Mode::Strict)
  } else {
    sse::SseParser::new()
  }
  let sb = StringBuilder::new()
  let rng : Array[Int64] = [seed.to_int64() * 2654435761L + 1L]
  let n = input.length()
  let mut pos = 0
  while pos < n {
    let mut len = next_len(step, rng, n - pos)
    if pos + len > n {
      len = n - pos
    }
    match p.feed_bytes(input.slice(pos, pos + len)) {
      Ok(evs) => {
        let mut j = 0
        while j < evs.length() {
          dump_event(sb, evs[j])
          j = j + 1
        }
      }
      Err(e) => {
        sb.write_string("!ERR:")
        sb.write_string(err_kind(e))
        return sb.to_string()
      }
    }
    pos = pos + len
  }
  match p.finish() {
    Ok(evs) => {
      let mut j = 0
      while j < evs.length() {
        dump_event(sb, evs[j])
        j = j + 1
      }
    }
    Err(e) => {
      sb.write_string("!ERR:")
      sb.write_string(err_kind(e))
      return sb.to_string()
    }
  }
  sb.write_string(" last=")
  sb.write_string(hex_str(p.last_event_id()))
  sb.write_string(" sretry=")
  sb.write_string(opt_str(p.retry_ms()))
  sb.to_string()
}

///|
fn run_corpus(world : World, path : String) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "error: cannot read " + path)
      return 2
    }
  }
  let n = raw.length()
  let mut start = 0
  let mut idx = 0
  let names = ["whole", "b1", "b2", "b3", "b7", "rnd"]
  let steps = [0, 1, 2, 3, 7, -1]
  while start < n {
    let mut end = start
    while end < n && raw[end].to_int() != 10 {
      end = end + 1
    }
    let input = unhex_range(raw, start, end)
    let mut k = 0
    while k < names.length() {
      io_println(
        world,
        idx.to_string() +
        " " +
        names[k] +
        " " +
        run_stream(input, steps[k], idx, false),
      )
      k = k + 1
    }
    io_println(
      world,
      idx.to_string() + " strict_whole " + run_stream(input, 0, idx, true),
    )
    io_println(
      world,
      idx.to_string() + " strict_b1 " + run_stream(input, 1, idx, true),
    )
    idx = idx + 1
    start = end + 1
  }
  0
}

// ---------------------------------------------------------------------------
// misc: reconnect / cursor / encoder deterministic dump (4-mode digest input)
// ---------------------------------------------------------------------------

///|
fn backoff_line(
  label : String,
  cfg : sse::SseReconnectConfig,
  server_retry : Int64,
  n : Int,
) -> String {
  let sb = StringBuilder::new()
  sb.write_string("backoff " + label + ":")
  match sse::SseReconnectState::with_config(cfg) {
    Ok(st) => {
      if server_retry >= 0L {
        st.on_retry(server_retry)
      }
      let mut i = 0
      let mut neg = 0
      while i < n {
        let d = st.next_backoff_ms()
        if d < 0L {
          neg = neg + 1
        }
        sb.write_string(" ")
        sb.write_string(d.to_string())
        i = i + 1
      }
      sb.write_string(" | negative=" + neg.to_string())
    }
    Err(e) => sb.write_string(" config-err " + err_kind(e))
  }
  sb.to_string()
}

///|
fn cfg(
  base : Int64,
  max : Int64,
  jitter : Int64,
  seed : Int64,
) -> sse::SseReconnectConfig {
  sse::SseReconnectConfig::{
    base_backoff_ms: base,
    max_backoff_ms: max,
    jitter_ratio_bps: jitter,
    seed,
    cursor_param: Some("since"),
  }
}

///|
fn lcg_next(s : Array[Int64]) -> Int {
  s[0] = s[0] * 6364136223846793005L + 1442695040888963407L
  ((s[0] >> 33) & 0x7FFFFFFFL).to_int()
}

///| Random string over an adversarial alphabet (CR, LF, CRLF, NUL, spaces, colons, field look-alikes, UTF-8).
fn rand_payload(s : Array[Int64], allow_cr : Bool) -> String {
  let alpha = [
    "a", "b", " ", "  ", ":", "\n", "\n\n", "id: evil", "event: x", "retry: 1",
    "data: y", "\u{4F60}", "\u{1F680}", "\u{FEFF}", "\u{0000}", "\t", "\r", "\r\n",
  ]
  let lim = if allow_cr { alpha.length() } else { alpha.length() - 2 }
  let n = lcg_next(s) % 9
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(alpha[lcg_next(s) % lim])
    i = i + 1
  }
  sb.to_string()
}

///|
fn rand_field(s : Array[Int64]) -> String {
  let alpha = ["", "a", "x.y", " lead", "trail ", "\u{4F60}", ":", "message", "\u{FEFF}"]
  alpha[lcg_next(s) % alpha.length()]
}

///| Encoder fuzz: format_event -> parse_str must reproduce event_type/data/id/retry byte-for-byte.
fn encoder_fuzz(world : World, n : Int, allow_cr : Bool) -> Unit {
  let s : Array[Int64] = [if allow_cr { 77L } else { 99L }]
  let mut ok = 0
  let mut mismatch = 0
  let mut rejected = 0
  let mut first = ""
  let mut i = 0
  while i < n {
    let retry = if lcg_next(s) % 3 == 0 {
      Some((lcg_next(s) % 100000).to_int64())
    } else {
      None
    }
    let ev = sse::SseEvent::{
      event_type: rand_field(s),
      data: rand_payload(s, allow_cr),
      id: rand_field(s),
      retry,
    }
    match sse::format_event(ev) {
      Ok(wire) =>
      match sse::parse_str(wire) {
        Ok(evs) => {
          let want_type = if ev.event_type.length() == 0 {
            "message"
          } else {
            ev.event_type
          }
          if evs.length() == 1 &&
          evs[0].event_type == want_type &&
          evs[0].data == ev.data &&
          evs[0].id == ev.id &&
          sse::opt_i64_eq(evs[0].retry, ev.retry) {
            ok = ok + 1
          } else {
            mismatch = mismatch + 1
            if first.length() == 0 {
              first = "data=" +
              hex_str(ev.data) +
              " wire=" +
              hex_str(wire) +
              " got_events=" +
              evs.length().to_string() +
              (if evs.length() > 0 {
                " got_data=" + hex_str(evs[0].data)
              } else {
                ""
              })
            }
          }
        }
        Err(e) => {
          mismatch = mismatch + 1
          if first.length() == 0 {
            first = "parse error " + err_kind(e)
          }
        }
      }
      Err(_) => rejected = rejected + 1
    }
    i = i + 1
  }
  io_println(
    world,
    "encoder_fuzz " +
    (if allow_cr { "with_cr" } else { "no_cr" }) +
    ": n=" +
    n.to_string() +
    " roundtrip_ok=" +
    ok.to_string() +
    " mismatch=" +
    mismatch.to_string() +
    " rejected=" +
    rejected.to_string(),
  )
  if first.length() > 0 {
    io_println(world, "  first_mismatch " + first)
  }
}

///|
fn run_misc(world : World) -> Int {
  let max64 = 9223372036854775807L
  io_println(world, backoff_line("default", sse::SseReconnectConfig::default(), -1L, 12))
  io_println(world, backoff_line("seed42", cfg(1000L, 30000L, 2000L, 42L), -1L, 12))
  io_println(world, backoff_line("server_retry0", cfg(1000L, 30000L, 2000L, 42L), 0L, 12))
  io_println(world, backoff_line("server_retry1", cfg(1000L, 30000L, 2000L, 42L), 1L, 12))
  io_println(world, backoff_line("server_retry_huge", cfg(1000L, 30000L, 2000L, 42L), max64, 4))
  io_println(world, backoff_line("base0", cfg(0L, 30000L, 2000L, 42L), -1L, 12))
  io_println(world, backoff_line("max_i64", cfg(max64, max64, 10000L, 42L), -1L, 4))
  io_println(world, backoff_line("max_i64_base1", cfg(1L, max64, 10000L, 42L), -1L, 70))
  io_println(world, backoff_line("jitter0", cfg(1000L, 30000L, 0L, 42L), -1L, 8))
  io_println(world, backoff_line("jitter_full", cfg(1000L, 30000L, 10000L, 42L), -1L, 12))
  io_println(world, backoff_line("bad_neg_base", cfg(-1L, 30000L, 0L, 42L), -1L, 1))
  io_println(world, backoff_line("bad_jitter", cfg(1L, 30000L, 10001L, 42L), -1L, 1))
  // 1000 consecutive failures: attempt counter, no overflow, no negative delay
  match sse::SseReconnectState::with_config(cfg(1000L, 30000L, 2000L, 7L)) {
    Ok(st) => {
      let mut i = 0
      let mut minv = max64
      let mut maxv = -1L
      while i < 1000 {
        let d = st.next_backoff_ms()
        if d < minv {
          minv = d
        }
        if d > maxv {
          maxv = d
        }
        i = i + 1
      }
      io_println(
        world,
        "backoff 1000-failures: attempt=" +
        st.attempt().to_string() +
        " min=" +
        minv.to_string() +
        " max=" +
        maxv.to_string(),
      )
    }
    Err(_) => io_println(world, "backoff 1000-failures: config error")
  }
  // Cursor URL helper
  let urls = [
    "https://h/e", "https://h/e?foo=1", "https://h/e#frag", "https://h/e?a=1#f?g",
    "https://h/e?since=0", "https://h/e?", "https://h/e?a=1&", "https://h/e#",
  ]
  let ids = ["42", "a b&c=d%e#f?g/\u{4F60}", ""]
  let mut ui = 0
  while ui < urls.length() {
    let mut ii = 0
    while ii < ids.length() {
      let st = sse::SseReconnectState::new()
      st.set_last_event_id(ids[ii])
      io_println(
        world,
        "cursor " +
        urls[ui] +
        " id=" +
        hex_str(ids[ii]) +
        " -> " +
        st.append_cursor_query_with(urls[ui], "since"),
      )
      ii = ii + 1
    }
    ui = ui + 1
  }
  let st = sse::SseReconnectState::new()
  st.set_last_event_id("1")
  io_println(world, "cursor param-injection -> " + st.append_cursor_query_with("https://h/e", "since&admin=1"))
  st.set_last_event_id("1\r\nX-Injected: yes")
  match st.last_event_id_header() {
    Some(h) => io_println(world, "header " + h.name + ": " + hex_str(h.value))
    None => io_println(world, "header none")
  }
  // Encoder fixed vectors
  let evs = [
    sse::SseEvent::{ event_type: "", data: " foo", id: "", retry: None },
    sse::SseEvent::{ event_type: "x", data: "a\nid: evil\n\nevent: e", id: "7", retry: Some(0L) },
    sse::SseEvent::{ event_type: "", data: "a\r\nb\rc\n", id: "", retry: None },
    sse::SseEvent::{ event_type: "", data: "", id: " sp", retry: None },
    sse::SseEvent::{ event_type: "e\r", data: "", id: "", retry: None },
    sse::SseEvent::{ event_type: "", data: "", id: "a\u{0000}", retry: None },
    sse::SseEvent::{ event_type: "", data: "", id: "", retry: Some(-1L) },
    sse::SseEvent::{ event_type: "message", data: "\u{0000}\u{FEFF}", id: "", retry: None },
  ]
  let mut ei = 0
  while ei < evs.length() {
    match sse::format_event(evs[ei]) {
      Ok(w) => {
        let sb = StringBuilder::new()
        match sse::parse_str(w) {
          Ok(back) => {
            let mut j = 0
            while j < back.length() {
              dump_event(sb, back[j])
              j = j + 1
            }
          }
          Err(e) => sb.write_string("!ERR:" + err_kind(e))
        }
        io_println(world, "encode " + ei.to_string() + " wire=" + hex_str(w) + " back=" + sb.to_string())
      }
      Err(e) => io_println(world, "encode " + ei.to_string() + " rejected " + err_kind(e))
    }
    ei = ei + 1
  }
  let comments = ["", "a\nid: evil", "x\r\ny\r", "\n"]
  let mut ci = 0
  while ci < comments.length() {
    match sse::format_comment(comments[ci]) {
      Ok(w) => {
        let back = match sse::parse_str(w + "data: z\n\n") {
          Ok(b) => b.length().to_string() + " events, id=" + (if b.length() > 0 { hex_str(b[0].id) } else { "" })
          Err(e) => "!ERR:" + err_kind(e)
        }
        io_println(world, "comment " + ci.to_string() + " wire=" + hex_str(w) + " back=" + back)
      }
      Err(e) => io_println(world, "comment " + ci.to_string() + " rejected " + err_kind(e))
    }
    ci = ci + 1
  }
  encoder_fuzz(world, 3000, false)
  encoder_fuzz(world, 3000, true)
  0
}

// ---------------------------------------------------------------------------
// dos
// ---------------------------------------------------------------------------

///|
fn fill(prefix : String, n : Int, byte : Int, suffix : String) -> Bytes {
  let p = prefix.to_bytes()
  let s = suffix.to_bytes()
  let out = Bytes::new(p.length() + n + s.length())
  let mut i = 0
  while i < p.length() {
    out[i] = p[i]
    i = i + 1
  }
  let b = byte.to_byte()
  let mut j = 0
  while j < n {
    out[p.length() + j] = b
    j = j + 1
  }
  let mut k = 0
  while k < s.length() {
    out[p.length() + n + k] = s[k]
    k = k + 1
  }
  out
}

///| Repeat `unit` `n` times.
fn repeat(unit : String, n : Int) -> Bytes {
  let u = unit.to_bytes()
  let out = Bytes::new(u.length() * n)
  let mut i = 0
  while i < n {
    let mut j = 0
    while j < u.length() {
      out[i * u.length() + j] = u[j]
      j = j + 1
    }
    i = i + 1
  }
  out
}

///| Feed in `chunk`-byte pieces, count events/errors, keep the first error kind; returns summary.
fn feed_all(p : sse::SseParser, input : Bytes, chunk : Int) -> String {
  let n = input.length()
  let mut pos = 0
  let mut events = 0
  let mut errors = 0
  let mut first_err = "-"
  let mut max_data = 0
  while pos < n {
    let end = if pos + chunk < n { pos + chunk } else { n }
    match p.feed_bytes(input.slice(pos, end)) {
      Ok(evs) => {
        events = events + evs.length()
        let mut j = 0
        while j < evs.length() {
          let l = evs[j].data.to_bytes().length()
          if l > max_data {
            max_data = l
          }
          j = j + 1
        }
      }
      Err(e) => {
        errors = errors + 1
        if first_err == "-" {
          first_err = err_kind(e)
        }
      }
    }
    pos = end
  }
  "events=" +
  events.to_string() +
  " errors=" +
  errors.to_string() +
  " first_err=" +
  first_err +
  " max_data_utf8_bytes=" +
  max_data.to_string()
}

///|
fn run_dos(world : World, kind : String, n : Int) -> Int {
  let p = sse::SseParser::new()
  let out = if kind == "longline_whole" {
    feed_all(p, fill("data: ", n, 65, ""), n + 16)
  } else if kind == "longline_4k" {
    feed_all(p, fill("data: ", n, 65, ""), 4096)
  } else if kind == "blank" {
    feed_all(p, fill("", n, 10, ""), 65536)
  } else if kind == "comment" {
    feed_all(p, repeat(":keepalive\n", n), 65536)
  } else if kind == "tiny" {
    feed_all(p, repeat("data\n\n", n), 65536)
  } else if kind == "datalines" {
    feed_all(p, repeat("data\n", n), 65536)
  } else if kind == "ff" {
    // 0xFF payload: 1 raw byte -> 3 UTF-8 bytes (U+FFFD) after Replace decoding
    feed_all(p, fill("data: ", n, 255, "\n\n"), 65536)
  } else if kind == "drip" {
    // n bytes of a normal event stream fed 1 byte per call
    let unit = "id: 1\nevent: e\ndata: hello world\n\n"
    let reps = n / unit.to_bytes().length() + 1
    feed_all(p, repeat(unit, reps), 1)
  } else {
    "unknown kind"
  }
  io_println(world, kind + " n=" + n.to_string() + " " + out)
  0
}

///|
fn parse_int(s : String) -> Int {
  let b = s.to_bytes()
  let mut acc = 0
  let mut i = 0
  while i < b.length() {
    acc = acc * 10 + (b[i].to_int() - 48)
    i = i + 1
  }
  acc
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() >= 3 && args[1] == "corpus" {
    run_corpus(world, args[2])
  } else if args.length() >= 2 && args[1] == "misc" {
    run_misc(world)
  } else if args.length() >= 4 && args[1] == "dos" {
    run_dos(world, args[2], parse_int(args[3]))
  } else {
    io_println(world, "usage: sse_audit_probe corpus <file> | misc | dos <kind> <n>")
    2
  }
}
