///| Red-team regression tests for packages/sse @ 5a09109 (branch feat/pkg-sse).
///
/// Every `redteam_*` test asserts behaviour required by WHATWG HTML §9.2 or by the package's own
/// documented contract -- a FAILURE here is the evidence of a finding (see REPORT.md, F-xx).
/// `control_*` tests are attacks packages/sse survived; they must keep passing.
/// Each redteam assertion accepts every reasonable fix (e.g. "return the events or do not commit
/// their id"), so a fix branch can re-run this file unchanged.

import "sse"

///|
fn b(vals : Array[Int]) -> Bytes {
  let out = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    out[i] = vals[i].to_byte()
    i = i + 1
  }
  out
}

///|
fn cat(x : Bytes, y : Bytes) -> Bytes {
  let out = Bytes::new(x.length() + y.length())
  let mut i = 0
  while i < x.length() {
    out[i] = x[i]
    i = i + 1
  }
  let mut j = 0
  while j < y.length() {
    out[x.length() + j] = y[j]
    j = j + 1
  }
  out
}

///|
fn rep(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///| Feed `chunks` in order; collect every returned event; stop recording at the first Err
///| (but keep feeding, like a caller that logs and continues). Returns (events, error_count).
fn feed_seq(p : sse::SseParser, chunks : Array[Bytes]) -> (Array[sse::SseEvent], Int) {
  let out : Array[sse::SseEvent] = []
  let mut errs = 0
  let mut i = 0
  while i < chunks.length() {
    match p.feed_bytes(chunks[i]) {
      Ok(evs) => {
        let mut j = 0
        while j < evs.length() {
          out.push(evs[j])
          j = j + 1
        }
      }
      Err(_) => errs = errs + 1
    }
    i = i + 1
  }
  (out, errs)
}

///|
fn feed_1b(p : sse::SseParser, input : Bytes) -> Array[sse::SseEvent] {
  let out : Array[sse::SseEvent] = []
  let mut i = 0
  while i < input.length() {
    match p.feed_bytes(input.slice(i, i + 1)) {
      Ok(evs) => {
        let mut j = 0
        while j < evs.length() {
          out.push(evs[j])
          j = j + 1
        }
      }
      Err(_) => return out
    }
    i = i + 1
  }
  out
}

///|
fn limits(line : Int64, event : Int64, lines : Int) -> sse::SseLimits {
  match sse::SseLimits::new(line, event, lines) {
    Ok(l) => l
    Err(_) => sse::SseLimits::default()
  }
}

///|
fn contains(hay : String, needle : String) -> Bool {
  let h = hay.to_bytes()
  let n = needle.to_bytes()
  let mut i = 0
  while i + n.length() <= h.length() {
    let mut j = 0
    while j < n.length() && h[i + j] == n[j] {
      j = j + 1
    }
    if j == n.length() {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn count(hay : String, needle : String) -> Int {
  let h = hay.to_bytes()
  let n = needle.to_bytes()
  let mut c = 0
  let mut i = 0
  while i + n.length() <= h.length() {
    let mut j = 0
    while j < n.length() && h[i + j] == n[j] {
      j = j + 1
    }
    if j == n.length() {
      c = c + 1
    }
    i = i + 1
  }
  c
}

// ---------------------------------------------------------------------------
// F-01 (P1) An Err from feed_bytes discards the events already dispatched earlier in the same
// chunk, although their id has been committed to last_event_id(). parser.pion:567-705 returns
// `Err(e)` and drops `out`. A caller that resumes from parser.last_event_id() (the documented
// cursor) skips those events forever; 1-byte feeding delivers them, whole-chunk feeding does not.
// ---------------------------------------------------------------------------

///|
test "redteam_error_does_not_drop_committed_events_line_limit" {
  let p = sse::SseParser::with_limits(limits(16L, 4194304L, 65536))
  let input = ("id: 1\ndata: a\n\ndata: " + rep("x", 32) + "\n").to_bytes()
  let delivered = match p.feed_bytes(input) {
    Ok(evs) => evs.length()
    Err(_) => 0
  }
  debug_assert(
    delivered == 1 || p.last_event_id() != "1",
    "event id=1 was committed to last_event_id() but never returned (delivered=" +
    delivered.to_string() +
    ")",
  )
}

///|
test "redteam_error_does_not_drop_committed_events_strict_utf8" {
  let p = sse::SseParser::with_options(
    sse::SseLimits::default(),
    sse::Utf8Mode::Strict,
  )
  let input = cat("id: 7\ndata: ok\n\ndata: ".to_bytes(), b([0xFF, 10, 10]))
  let delivered = match p.feed_bytes(input) {
    Ok(evs) => evs.length()
    Err(_) => 0
  }
  debug_assert(
    delivered == 1 || p.last_event_id() != "7",
    "Strict: event id=7 committed but dropped together with the InvalidUtf8 error",
  )
}

///|
test "control_error_prefix_events_delivered_under_1byte_feeding" {
  let p = sse::SseParser::with_limits(limits(16L, 4194304L, 65536))
  let evs = feed_1b(p, ("id: 1\ndata: a\n\ndata: " + rep("x", 32) + "\n").to_bytes())
  debug_assert(evs.length() == 1 && evs[0].id == "1", "1B feeding returns the prefix event")
}

// ---------------------------------------------------------------------------
// F-02 (P2) Errors are not sticky and the parser re-synchronises at an arbitrary byte: the tail
// of a rejected over-long line is parsed as a fresh line (field injection from inside a data
// payload), and bytes of a rejected chunk are silently cut out of a line that is later delivered.
// parser.pion append_line_slice / feed_bytes early returns leave line_len / position unchanged.
// ---------------------------------------------------------------------------

///|
test "redteam_after_line_too_large_tail_is_not_parsed_as_fields" {
  let p = sse::SseParser::with_limits(limits(32L, 4194304L, 65536))
  // one logical line: "data: AAAA...(40)id: evil" -- arrives in two network chunks
  let (evs, errs) = feed_seq(p, [
    ("data: " + rep("A", 40)).to_bytes(),
    "id: evil\ndata: next\n\n".to_bytes(),
  ])
  let mut injected = p.last_event_id() == "evil"
  let mut i = 0
  while i < evs.length() {
    if evs[i].id == "evil" {
      injected = true
    }
    i = i + 1
  }
  debug_assert(errs >= 1, "over-long line must be rejected")
  debug_assert(
    !injected,
    "payload bytes after the rejected prefix became an `id:` field (cursor poisoned to \"evil\")",
  )
}

///|
test "redteam_after_line_too_large_no_silently_truncated_event" {
  let p = sse::SseParser::with_limits(limits(32L, 4194304L, 65536))
  let (evs, errs) = feed_seq(p, [
    ("data: " + rep("A", 20)).to_bytes(),
    rep("B", 10).to_bytes(),
    "C\n\n".to_bytes(),
  ])
  let mut truncated = false
  let mut i = 0
  while i < evs.length() {
    if evs[i].data == rep("A", 20) + "C" {
      truncated = true
    }
    i = i + 1
  }
  debug_assert(errs >= 1, "the 37-byte line must be rejected")
  debug_assert(
    !truncated,
    "event delivered with the rejected middle chunk (10 x 'B') silently cut out",
  )
}

///|
test "redteam_after_too_many_data_lines_no_truncated_dispatch" {
  let p = sse::SseParser::with_limits(limits(1048576L, 4194304L, 2))
  let (evs, errs) = feed_seq(p, ["data: a\ndata: b\ndata: c\n".to_bytes(), "\n".to_bytes()])
  let mut truncated = false
  let mut i = 0
  while i < evs.length() {
    if evs[i].data == "a\nb" {
      truncated = true
    }
    i = i + 1
  }
  debug_assert(errs >= 1, "3rd data line must be rejected")
  debug_assert(
    !truncated,
    "the rejected 3-line event was later dispatched as \"a\\nb\" (3rd line silently lost)",
  )
}

// ---------------------------------------------------------------------------
// F-03 (P1) A server `retry: 0` (or retry: 1..) disables exponential backoff: base = retry_ms,
// doubling 0 stays 0 and jitter span is 0 -> every client reconnects with 0 ms forever.
// reconnect.pion:108-146.
// ---------------------------------------------------------------------------

///|
test "redteam_backoff_server_retry_zero_still_backs_off" {
  let st = sse::SseReconnectState::new()
  st.on_retry(0L)
  let mut last = 0L
  let mut i = 0
  while i < 10 {
    last = st.next_backoff_ms()
    i = i + 1
  }
  debug_assert(
    last > 0L,
    "10 consecutive failures after server `retry: 0` still back off 0 ms (reconnect storm)",
  )
}

// ---------------------------------------------------------------------------
// F-04 (P1) Jitter is only added and then clipped to max_backoff_ms, so once the delay reaches the
// cap every client waits exactly max_backoff_ms (zero jitter in the steady state that matters for
// a thundering herd). reconnect.pion:127-136.
// ---------------------------------------------------------------------------

///|
test "redteam_jitter_survives_at_cap" {
  let st = sse::SseReconnectState::new()
  let seen : Array[Int64] = []
  let mut i = 0
  while i < 30 {
    let d = st.next_backoff_ms()
    if i >= 10 {
      seen.push(d)
    }
    i = i + 1
  }
  let mut distinct = false
  let mut j = 1
  while j < seen.length() {
    if seen[j] != seen[0] {
      distinct = true
    }
    j = j + 1
  }
  debug_assert(
    distinct,
    "attempts 11..30 all return exactly " +
    seen[0].to_string() +
    " ms: jitter is clipped away at the cap",
  )
}

///|
test "control_backoff_no_overflow_or_negative_after_1000_failures" {
  let cfg = sse::SseReconnectConfig::{
    base_backoff_ms: 1L,
    max_backoff_ms: 9223372036854775807L,
    jitter_ratio_bps: 10000L,
    seed: 3L,
    cursor_param: None,
  }
  match sse::SseReconnectState::with_config(cfg) {
    Ok(st) => {
      let mut i = 0
      while i < 1000 {
        let d = st.next_backoff_ms()
        debug_assert(d >= 0L, "negative delay at attempt " + i.to_string())
        i = i + 1
      }
    }
    Err(_) => debug_assert(false, "config must be valid")
  }
  let st2 = sse::SseReconnectState::new()
  st2.on_retry(9223372036854775807L)
  debug_assert(st2.next_backoff_ms() == 30000L, "huge server retry is capped")
}

// ---------------------------------------------------------------------------
// F-05 (P2) Reusing a parser for the next response after finish() (the only way to keep
// last_event_id across a reconnect -- reset() wipes it, and a new parser cannot be seeded) does not
// re-arm BOM stripping, and a partial BOM left over from the previous response is prepended to the
// next response's first line. Either way the first event after the reconnect is silently dropped.
// parser.pion finish() does not touch bom_state.
// ---------------------------------------------------------------------------

///|
test "redteam_finish_then_next_response_bom_stripped" {
  let p = sse::SseParser::new()
  let _ = feed_seq(p, ["id: 5\ndata: a\n\n".to_bytes()])
  let _ = p.finish()
  let (evs, _) = feed_seq(p, [cat(b([0xEF, 0xBB, 0xBF]), "data: b\n\n".to_bytes())])
  debug_assert(
    evs.length() == 1 && evs[0].data == "b" && evs[0].id == "5",
    "first event of the reconnected response (starting with a BOM) was dropped",
  )
}

///|
test "redteam_finish_discards_partial_bom" {
  let p = sse::SseParser::new()
  let _ = feed_seq(p, [b([0xEF, 0xBB])])
  let _ = p.finish()
  let (evs, _) = feed_seq(p, ["data: x\n\n".to_bytes()])
  debug_assert(
    evs.length() == 1 && evs[0].data == "x",
    "bytes EF BB of a truncated previous response leaked into the next stream's first line",
  )
}

///|
test "control_finish_reuse_keeps_last_event_id" {
  let p = sse::SseParser::new()
  let _ = feed_seq(p, ["id: 5\ndata: a\n\ndata: partial".to_bytes()])
  let _ = p.finish()
  let (evs, _) = feed_seq(p, ["data: b\n\n".to_bytes()])
  debug_assert(evs.length() == 1 && evs[0].id == "5" && evs[0].data == "b", "id persists")
}

// ---------------------------------------------------------------------------
// F-06 (P2) Cursor URL helper appends a duplicate parameter instead of replacing it and does not
// encode the parameter name. reconnect.pion:244-279.
// ---------------------------------------------------------------------------

///|
test "redteam_cursor_query_replaces_existing_param" {
  let st = sse::SseReconnectState::new()
  st.set_last_event_id("42")
  let u = st.append_cursor_query_with("https://h/e?since=0&x=1", "since")
  debug_assert(
    count(u, "since=") == 1 && contains(u, "since=42"),
    "existing since=0 kept next to the new cursor: " + u,
  )
}

///|
test "redteam_cursor_query_param_name_encoded" {
  let st = sse::SseReconnectState::new()
  st.set_last_event_id("1")
  let u = st.append_cursor_query_with("https://h/e", "since&admin=1")
  debug_assert(!contains(u, "&admin=1"), "raw `&` in param name smuggles a parameter: " + u)
}

///|
test "control_cursor_query_fragment_and_value_encoding" {
  let st = sse::SseReconnectState::new()
  st.set_last_event_id("a&b=c#d%")
  debug_assert(
    st.append_cursor_query_with("https://h/e?q=1#frag", "since") ==
    "https://h/e?q=1&since=a%26b%3Dc%23d%25#frag",
    "value encoded, inserted before #fragment",
  )
}

// ---------------------------------------------------------------------------
// F-07 (P2) last_event_id_header() returns CR/LF/NUL verbatim from set_last_event_id (persisted
// storage) -> HTTP request header injection in any client that does not re-validate.
// ---------------------------------------------------------------------------

///|
test "redteam_last_event_id_header_rejects_crlf" {
  let st = sse::SseReconnectState::new()
  st.set_last_event_id("1\r\nX-Injected: yes")
  match st.last_event_id_header() {
    Some(h) =>
    debug_assert(
      !contains(h.value, "\r") && !contains(h.value, "\n"),
      "Last-Event-ID header value carries CRLF",
    )
    None => ()
  }
}

// ---------------------------------------------------------------------------
// F-08 (P2) max_event_bytes counts raw bytes before U+FFFD replacement: a 0xFF payload grows 3x
// past the limit (parser.pion:404-417 vs decode_utf8_lossy).
// ---------------------------------------------------------------------------

///|
test "redteam_max_event_bytes_bounds_decoded_data" {
  let p = sse::SseParser::with_limits(limits(1048576L, 1024L, 65536))
  let ff = Bytes::new(1000)
  let mut i = 0
  while i < 1000 {
    ff[i] = (0xFF).to_byte()
    i = i + 1
  }
  match p.feed_bytes(cat(cat("data: ".to_bytes(), ff), "\n\n".to_bytes())) {
    Ok(evs) => {
      let mut k = 0
      while k < evs.length() {
        let n = evs[k].data.to_bytes().length()
        debug_assert(
          n <= 1024,
          "event data is " + n.to_string() + " UTF-8 bytes with max_event_bytes=1024",
        )
        k = k + 1
      }
    }
    Err(_) => ()
  }
}

// ---------------------------------------------------------------------------
// Controls: WHATWG §9.2 edge cases the parser gets right (also covered by the 3,087-case
// differential in run_audit.sh)
// ---------------------------------------------------------------------------

///|
test "control_bom_split_1byte_and_later_feff_kept" {
  let input = cat(
    b([0xEF, 0xBB, 0xBF]),
    cat(
      "data: a\n\n".to_bytes(),
      cat(b([0xEF, 0xBB, 0xBF]), "data: b\n\ndata: \u{FEFF}c\n\n".to_bytes()),
    ),
  )
  let evs = feed_1b(sse::SseParser::new(), input)
  debug_assert(
    evs.length() == 2 && evs[0].data == "a" && evs[1].data == "\u{FEFF}c",
    "BOM stripped once; U+FEFF later is kept (field name \\uFEFFdata ignored)",
  )
}

///|
test "control_line_endings_matrix" {
  let p = sse::SseParser::new()
  let (e1, _) = feed_seq(p, ["data: a\r".to_bytes(), "\r\n".to_bytes()])
  debug_assert(e1.length() == 1 && e1[0].data == "a", "data: a CR CR LF dispatches")
  let (e2, _) = feed_seq(sse::SseParser::new(), ["data: a\r".to_bytes(), "\n".to_bytes(), "\r\n".to_bytes()])
  debug_assert(e2.length() == 1, "CRLF split across chunks is one terminator")
  let q = sse::SseParser::new()
  let (e3, _) = feed_seq(q, ["data: hi".to_bytes()])
  let fin = match q.finish() {
    Ok(f) => f.length()
    Err(_) => -1
  }
  debug_assert(e3.length() == 0 && fin == 0, "unterminated event is not dispatched at EOF")
}

///|
test "control_field_rules" {
  match sse::parse_str("data\n\nid: 1\ndata: x\n\nid: a\u{0000}b\ndata: y\n\nid\ndata: z\n\nevent: e\n\ndata: w\n\nretry: +1\nretry: -1\nretry: 1ms\nretry:  2\nretry: 99999999999999999999\ndata: r\n\n") {
    Ok(evs) => {
      debug_assert(evs.length() == 6, "six events")
      debug_assert(evs[0].data == "" && evs[0].event_type == "message", "bare data -> \"\"")
      debug_assert(evs[1].id == "1" && evs[2].id == "1", "id with NUL ignored")
      debug_assert(evs[3].id == "", "bare id clears")
      debug_assert(evs[4].event_type == "message", "event reset by data-less block")
      debug_assert(evs[5].retry is None, "all malformed retry values ignored")
    }
    Err(_) => debug_assert(false, "parse")
  }
}

///|
test "control_encoder_leading_space_and_injection" {
  let ev = sse::SseEvent::{
    event_type: "",
    data: " foo\nid: evil\n\nevent: x",
    id: "",
    retry: None,
  }
  match sse::format_event(ev) {
    Ok(w) =>
    match sse::parse_str(w) {
      Ok(evs) => {
        debug_assert(evs.length() == 1 && evs[0].data == ev.data, "data round-trips")
        debug_assert(evs[0].id == "" && evs[0].event_type == "message", "no injection")
      }
      Err(_) => debug_assert(false, "parse")
    }
    Err(_) => debug_assert(false, "format")
  }
  let bad = sse::SseEvent::{ event_type: "", data: "", id: "a\nb", retry: None }
  debug_assert(sse::format_event(bad) is Err(_), "id with LF rejected")
}

///|
test "control_limits_zero_and_negative" {
  debug_assert(sse::SseLimits::new(-1L, 1L, 1) is Err(_), "negative rejected")
  let p = sse::SseParser::with_limits(limits(0L, 0L, 0))
  debug_assert(p.feed_str("\n\n\n") is Ok(_), "blank lines fine with 0 limits")
  debug_assert(p.feed_str("d\n") is Err(_), "0-byte line limit rejects any line")
  let forged = sse::SseLimits::{ max_line_bytes: -5L, max_event_bytes: 1L, max_data_lines: 1 }
  let q = sse::SseParser::with_limits(forged)
  debug_assert(q.feed_str("data: x\n\n") is Err(_), "struct-literal negative limits re-validated")
}
