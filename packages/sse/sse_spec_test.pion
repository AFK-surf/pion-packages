///| WHATWG HTML §9.2 Server-Sent Events (EventSource) compliance, streaming, encoding,
///| reconnect backoff, and DoS protection test suite.

///| Helper: build `Bytes` from an array of integer byte values (0..255).
fn bytes_from_ints(vals : Array[Int]) -> Bytes {
  let mut b = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///| Helper: concatenate two `Bytes` buffers.
fn concat_bytes(a : Bytes, b : Bytes) -> Bytes {
  let mut out = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    out[a.length() + j] = b[j]
    j = j + 1
  }
  out
}

///| Helper: split `Bytes` into chunks of `step` bytes.
fn split_bytes(src : Bytes, step : Int) -> Array[Bytes] {
  let out : Array[Bytes] = []
  let mut pos = 0
  while pos < src.length() {
    let end = if pos + step < src.length() { pos + step } else { src.length() }
    out.push(src.slice(pos, end))
    pos = end
  }
  out
}

///| Helper: feed all chunks into a fresh parser and call `finish()`.
fn feed_all_chunks(chunks : Array[Bytes]) -> Result[Array[SseEvent], SseError] {
  let p = SseParser::new()
  let all : Array[SseEvent] = []
  let mut i = 0
  while i < chunks.length() {
    match p.feed_bytes(chunks[i]) {
      Ok(evts) => {
        let mut j = 0
        while j < evts.length() {
          all.push(evts[j])
          j = j + 1
        }
      }
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  match p.finish() {
    Ok(evts) => {
      let mut j = 0
      while j < evts.length() {
        all.push(evts[j])
        j = j + 1
      }
    }
    Err(e) => return Err(e)
  }
  Ok(all)
}

///| Helper: compare two arrays of `SseEvent`.
fn events_eq(a : Array[SseEvent], b : Array[SseEvent]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if !a[i].equals(b[i]) {
      return false
    }
    i = i + 1
  }
  true
}

// ============================================================================
// 1. WHATWG §9.2.6 Core Event Stream Parsing
// ============================================================================

///|
test "whatwg_basic_and_multiline_data" {
  let raw = "data: YHOO\ndata: +2\ndata: 10\n\n"
  match parse_str(raw) {
    Ok(evts) => {
      debug_assert(evts.length() == 1, "expected 1 event")
      debug_assert(evts[0].event_type == "message", "default event type must be message")
      debug_assert(evts[0].data == "YHOO\n+2\n10", "multiline data joined with LF")
      debug_assert(evts[0].id == "", "default id must be empty")
      debug_assert(opt_i64_eq(evts[0].retry, None), "default retry must be None")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
}

///|
test "whatwg_empty_data_and_bare_field_names" {
  // WHATWG §9.2.6 example:
  // `data\n\ndata\ndata\n\ndata:` -> 2 events: "" and "\n"; 3rd has no blank line.
  let raw = "data\n\ndata\ndata\n\ndata:"
  match parse_str(raw) {
    Ok(evts) => {
      debug_assert(evts.length() == 2, "expected 2 events")
      debug_assert(evts[0].data == "", "first event data must be empty string")
      debug_assert(evts[1].data == "\n", "second event data must be single LF")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
}

///|
test "whatwg_colon_single_leading_space_rule" {
  // Colon strips AT MOST one U+0020 space; second space, tab, or no-space preserved.
  let raw =
  "event:  custom\ndata:  two spaces\ndata:\ttab\ndata:no-space\ndata: \n\n"
  match parse_str(raw) {
    Ok(evts) => {
      debug_assert(evts.length() == 1, "expected 1 event")
      debug_assert(evts[0].event_type == " custom", "only 1 leading space stripped from event")
      debug_assert(
        evts[0].data == " two spaces\n\ttab\nno-space\n",
        "only 1 leading 0x20 stripped per data line",
      )
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
}

///|
test "whatwg_comments_unknown_fields_and_no_data_dispatch_suppression" {
  let raw =
  ": leading comment\n" +
  ":another comment\n" +
  "event: custom_dropped\n" +
  "unknown_field: ignored\n" +
  "bare_unknown_field\n" +
  "\n" +
  "data: ok\n" +
  ": mid-event comment\n" +
  "DATA: case-sensitive-ignored\n" +
  "\n"
  match parse_str(raw) {
    Ok(evts) => {
      debug_assert(evts.length() == 1, "only event with data is dispatched")
      debug_assert(
        evts[0].event_type == "message",
        "event type must reset to default after empty-data blank line",
      )
      debug_assert(evts[0].data == "ok", "data ok")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
}

///|
test "whatwg_event_type_resets_after_dispatch_and_bare_event_clears" {
  let raw =
  "event: ping\ndata: 1\n\n" +
  "data: 2\n\n" +
  "event: foo\nevent\ndata: 3\n\n"
  match parse_str(raw) {
    Ok(evts) => {
      debug_assert(evts.length() == 3, "expected 3 events")
      debug_assert(evts[0].event_type == "ping", "e0 ping")
      debug_assert(evts[1].event_type == "message", "e1 reset to message")
      debug_assert(evts[2].event_type == "message", "e2 bare event clears to message")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
}

///|
test "whatwg_id_persistence_nul_ignored_clear_and_commit_on_dispatch" {
  // Event 0 sets id=42; Event 1 inherits 42; Event 2 has NUL in id -> ignored (keeps 42);
  // Block with only `id: 99\n\n` (no data) still commits last_event_id=99 per §9.2.6 Step 1!
  // Event 3 inherits 99; Event 4 bare `id` clears to "";
  // Trailing unterminated `id: 777\ndata: unfinished\n` must NOT commit 777!
  let part1 = "id: 42\ndata: a\n\ndata: b\n\nid: bad".to_bytes()
  let nul = bytes_from_ints([0])
  let part2 =
  "value\ndata: c\n\nid: 99\n\ndata: d\n\nid\ndata: e\n\nid: 777\ndata: unfinished\n"
  .to_bytes()
  let p = SseParser::new()
  let all : Array[SseEvent] = []
  let chunks = [part1, nul, part2]
  let mut i = 0
  while i < chunks.length() {
    match p.feed_bytes(chunks[i]) {
      Ok(evts) => {
        let mut j = 0
        while j < evts.length() {
          all.push(evts[j])
          j = j + 1
        }
      }
      Err(e) => debug_assert(false, "feed error: " + e.message())
    }
    i = i + 1
  }
  match p.finish() {
    Ok(evts) => debug_assert(evts.length() == 0, "finish must not dispatch incomplete event")
    Err(e) => debug_assert(false, "finish error: " + e.message())
  }
  debug_assert(all.length() == 5, "expected 5 events")
  debug_assert(all[0].id == "42", "e0 id 42")
  debug_assert(all[1].id == "42", "e1 inherits 42")
  debug_assert(all[2].id == "42", "e2 NUL id ignored")
  debug_assert(all[3].id == "99", "e3 inherits id committed by data-less block")
  debug_assert(all[4].id == "", "e4 bare id clears to empty")
  debug_assert(p.last_event_id() == "", "uncommitted id 777 must not overwrite last_event_id")
}

///|
test "whatwg_retry_strict_ascii_digits_and_overflow" {
  let raw =
  "retry: 3000\ndata: a\n\n" +
  "retry: 1500ms\ndata: b\n\n" +
  "retry: -100\ndata: c\n\n" +
  "retry: +100\ndata: d\n\n" +
  "retry:  200\ndata: e\n\n" +
  "retry: \ndata: f\n\n" +
  "retry: 99999999999999999999999999\ndata: g\n\n" +
  "retry: 0\ndata: h\n\n" +
  "data: i\n\n"
  let p = SseParser::new()
  match p.feed_str(raw) {
    Ok(evts) => {
      debug_assert(evts.length() == 9, "expected 9 events")
      debug_assert(opt_i64_eq(evts[0].retry, Some(3000L)), "valid retry 3000")
      debug_assert(opt_i64_eq(evts[1].retry, None), "non-digit suffix ignored")
      debug_assert(opt_i64_eq(evts[2].retry, None), "negative retry ignored")
      debug_assert(opt_i64_eq(evts[3].retry, None), "leading plus ignored")
      debug_assert(opt_i64_eq(evts[4].retry, None), "leading extra space ignored")
      debug_assert(opt_i64_eq(evts[5].retry, None), "empty retry ignored")
      debug_assert(opt_i64_eq(evts[6].retry, None), "overflow retry ignored")
      debug_assert(opt_i64_eq(evts[7].retry, Some(0L)), "retry 0 is valid")
      debug_assert(opt_i64_eq(evts[8].retry, None), "event without retry has None")
      debug_assert(opt_i64_eq(p.retry_ms(), Some(0L)), "parser retains latest valid retry 0")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
}

// ============================================================================
// 2. Line Endings, BOM, Streaming Arbitrary Chunk Splits & UTF-8
// ============================================================================

///|
test "whatwg_mixed_line_endings_and_cross_chunk_crlf" {
  let raw = "data: a\r\n\r\ndata: b\r\rdata: c\n\ndata: d\r\n\ndata: e\n\r\n"
  match parse_str(raw) {
    Ok(evts) => {
      debug_assert(evts.length() == 5, "expected 5 events")
      debug_assert(evts[0].data == "a", "a")
      debug_assert(evts[1].data == "b", "b")
      debug_assert(evts[2].data == "c", "c")
      debug_assert(evts[3].data == "d", "d")
      debug_assert(evts[4].data == "e", "e")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
  // Cross-chunk CR + LF must merge into ONE line break, not two!
  let chunks = [
    "data: first\r".to_bytes(),
    "\ndata: second\r".to_bytes(),
    "\n\r".to_bytes(),
    "\ndata: third\r".to_bytes(),
    "\n\n".to_bytes(),
  ]
  match feed_all_chunks(chunks) {
    Ok(evts) => {
      debug_assert(evts.length() == 2, "expected 2 events")
      debug_assert(evts[0].data == "first\nsecond", "split CRLF merged")
      debug_assert(evts[1].data == "third", "third")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
}

///|
test "whatwg_utf8_bom_strip_only_first_whole_and_split" {
  let bom = bytes_from_ints([0xEF, 0xBB, 0xBF])
  let body = "data: hello\n\n".to_bytes()
  // Whole single BOM stripped
  match parse_bytes(concat_bytes(bom, body)) {
    Ok(evts) => {
      debug_assert(evts.length() == 1 && evts[0].data == "hello", "single BOM stripped")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
  // Single BOM split 1 byte per chunk stripped
  match
  feed_all_chunks([
    bytes_from_ints([0xEF]),
    bytes_from_ints([0xBB]),
    bytes_from_ints([0xBF]),
    body,
  ])
  {
    Ok(evts) => {
      debug_assert(evts.length() == 1 && evts[0].data == "hello", "split BOM stripped")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
  // Double BOM: only first is stripped; second remains as "\u{FEFF}data" (unknown field)
  match parse_bytes(concat_bytes(concat_bytes(bom, bom), body)) {
    Ok(evts) => {
      debug_assert(evts.length() == 0, "second BOM must not be stripped")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
  // False BOM prefix (EF BB 00) is NOT stripped
  let false_bom = concat_bytes(bytes_from_ints([0xEF, 0xBB, 0x00]), "data: x\n\n".to_bytes())
  match parse_bytes(false_bom) {
    Ok(evts) => debug_assert(evts.length() == 0, "false BOM prefix not stripped")
    Err(e) => debug_assert(false, "unexpected error: " + e.message())
  }
}

///|
test "streaming_1byte_and_multibyte_utf8_chunk_equivalence" {
  // Contains BOM, 3-byte CJK ("\u{4F60}\u{597D}"), 4-byte emoji ("\u{1F680}"),
  // mixed CRLF/CR/LF, comments, retry, id, and trailing unterminated line.
  let bom = bytes_from_ints([0xEF, 0xBB, 0xBF])
  let text =
  ": sync stream\r\n" +
  "event: sync.delta\r\n" +
  "id: cur-001\r\n" +
  "retry: 2500\r\n" +
  "data: {\"msg\":\"\u{4F60}\u{597D}\u{1F680}\"}\r\n" +
  "data:  indented \u{1F30D}\r\n" +
  "\r\n" +
  "data: cr-only\r" +
  "data: second\r\r" +
  "id: cur-002\n" +
  "data: final\n\n" +
  "data: trailing-no-newline"
  let full = concat_bytes(bom, text.to_bytes())
  let whole = match parse_bytes(full) {
    Ok(evts) => evts
    Err(e) => {
      debug_assert(false, "whole parse failed: " + e.message())
      []
    }
  }
  debug_assert(whole.length() == 3, "expected 3 events")
  debug_assert(whole[0].event_type == "sync.delta", "e0 type")
  debug_assert(whole[0].id == "cur-001", "e0 id")
  debug_assert(opt_i64_eq(whole[0].retry, Some(2500L)), "e0 retry")
  debug_assert(
    whole[0].data == "{\"msg\":\"\u{4F60}\u{597D}\u{1F680}\"}\n indented \u{1F30D}",
    "e0 UTF-8 data",
  )
  debug_assert(whole[1].data == "cr-only\nsecond", "e1 CR data")
  debug_assert(whole[1].id == "cur-001", "e1 inherited id")
  debug_assert(whole[2].id == "cur-002", "e2 id")
  debug_assert(whole[2].data == "final", "e2 data")

  // Verify exact equivalence across 1, 2, 3, 4, 7, 13 byte splits (splitting 3-4 byte UTF-8 & CRLF)
  let steps = [1, 2, 3, 4, 7, 13]
  let mut si = 0
  while si < steps.length() {
    match feed_all_chunks(split_bytes(full, steps[si])) {
      Ok(evts) =>
      debug_assert(
        events_eq(evts, whole),
        "chunked parse mismatch for step=" + steps[si].to_string(),
      )
      Err(e) =>
      debug_assert(
        false,
        "chunked parse failed for step=" + steps[si].to_string() + ": " + e.message(),
      )
    }
    si = si + 1
  }
}

///|
test "utf8_replace_vs_strict_mode" {
  // Lone 0xFF and truncated 3-byte sequence (0xE2 0x82 followed by 'x')
  let bad = bytes_from_ints([
    100, 97, 116, 97, 58, 32, 97, 0xFF, 98, 0xE2, 0x82, 120, 10, 10,
  ])
  // Replace mode (default): WHATWG maximal-subpart U+FFFD replacement
  match parse_bytes(bad) {
    Ok(evts) => {
      debug_assert(evts.length() == 1, "expected 1 event")
      debug_assert(
        evts[0].data == "a\u{FFFD}b\u{FFFD}x",
        "maximal subpart U+FFFD replacement",
      )
    }
    Err(e) => debug_assert(false, "replace mode failed: " + e.message())
  }
  // Strict mode: rejects invalid UTF-8
  let strict = SseParser::with_options(SseLimits::default(), Utf8Mode::Strict)
  match strict.feed_bytes(bad) {
    Err(SseError::InvalidUtf8(_)) => ()
    _ => debug_assert(false, "strict mode must reject invalid UTF-8")
  }
}

// ============================================================================
// 3. Encoder & CR/LF/NUL Injection Prevention
// ============================================================================

///|
test "encoder_roundtrip_multiline_leading_space_and_unicode" {
  let evts = [
    SseEvent::{
      event_type: "sync.patch",
      data: "line1\n leading space\n\u{4F60}\u{597D}\u{1F680}",
      id: "seq-100",
      retry: Some(5000L),
    },
    SseEvent::{ event_type: "message", data: "", id: "seq-101", retry: None },
    SseEvent::{ event_type: "message", data: "\n", id: "seq-101", retry: None },
  ]
  let sb = StringBuilder::new()
  let mut i = 0
  while i < evts.length() {
    match format_event(evts[i]) {
      Ok(frame) => sb.write_string(frame)
      Err(e) => debug_assert(false, "encode failed: " + e.message())
    }
    i = i + 1
  }
  match parse_str(sb.to_string()) {
    Ok(decoded) => debug_assert(events_eq(decoded, evts), "encode->decode roundtrip mismatch")
    Err(e) => debug_assert(false, "decode failed: " + e.message())
  }
  // CRLF and CR inside data are split into separate data: lines
  let crlf_ev = SseEvent::new("a\r\nb\rc")
  match format_event(crlf_ev) {
    Ok(frame) => {
      debug_assert(frame == "data: a\ndata: b\ndata: c\n\n", "CRLF/CR normalized into data lines")
    }
    Err(e) => debug_assert(false, "encode crlf failed: " + e.message())
  }
}

///|
test "encoder_rejects_crlf_nul_injection_and_negative_retry" {
  let bad_event_lf = SseEvent::{
    event_type: "ok\ndata: injected",
    data: "x",
    id: "",
    retry: None,
  }
  match format_event(bad_event_lf) {
    Err(SseError::InvalidFieldValue(_)) => ()
    _ => debug_assert(false, "LF in event_type must be rejected")
  }
  let bad_event_cr = SseEvent::{
    event_type: "ok\rdata: injected",
    data: "x",
    id: "",
    retry: None,
  }
  match format_event(bad_event_cr) {
    Err(SseError::InvalidFieldValue(_)) => ()
    _ => debug_assert(false, "CR in event_type must be rejected")
  }
  let bad_event_nul = SseEvent::{
    event_type: "ok\u{0000}x",
    data: "x",
    id: "",
    retry: None,
  }
  match format_event(bad_event_nul) {
    Err(SseError::InvalidFieldValue(_)) => ()
    _ => debug_assert(false, "NUL in event_type must be rejected")
  }
  let bad_id_lf = SseEvent::{
    event_type: "message",
    data: "x",
    id: "1\ndata: forged",
    retry: None,
  }
  match format_event(bad_id_lf) {
    Err(SseError::InvalidFieldValue(_)) => ()
    _ => debug_assert(false, "LF in id must be rejected")
  }
  let bad_id_nul = SseEvent::{
    event_type: "message",
    data: "x",
    id: "1\u{0000}2",
    retry: None,
  }
  match format_event(bad_id_nul) {
    Err(SseError::InvalidFieldValue(_)) => ()
    _ => debug_assert(false, "NUL in id must be rejected")
  }
  let bad_retry = SseEvent::{
    event_type: "message",
    data: "x",
    id: "",
    retry: Some(-1L),
  }
  match format_event(bad_retry) {
    Err(SseError::InvalidFieldValue(_)) => ()
    _ => debug_assert(false, "negative retry must be rejected")
  }
  // Multiline comment safely prefixed with `:` on every line
  match format_comment("keepalive\nline2\r\nline3") {
    Ok(c) => debug_assert(c == ": keepalive\n: line2\n: line3\n", "multiline comment safe")
    Err(e) => debug_assert(false, "comment encode failed: " + e.message())
  }
}

// ============================================================================
// 4. Sans-IO Reconnect & Deterministic Backoff State Machine
// ============================================================================

///|
test "reconnect_backoff_exponential_cap_jitter_and_reset" {
  // Deterministic without jitter first
  let cfg_no_jitter = SseReconnectConfig::{
    base_backoff_ms: 500L,
    max_backoff_ms: 4000L,
    jitter_ratio_bps: 0L,
    seed: 12345L,
    cursor_param: Some("since"),
  }
  let st = match SseReconnectState::with_config(cfg_no_jitter) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "valid config failed: " + e.message())
      SseReconnectState::new()
    }
  }
  debug_assert(st.next_backoff_ms() == 500L, "attempt 1 = 500ms")
  debug_assert(st.attempt() == 1, "attempt 1")
  debug_assert(st.next_backoff_ms() == 1000L, "attempt 2 = 1000ms")
  debug_assert(st.next_backoff_ms() == 2000L, "attempt 3 = 2000ms")
  debug_assert(st.next_backoff_ms() == 4000L, "attempt 4 = 4000ms capped")
  debug_assert(st.next_backoff_ms() == 4000L, "attempt 5 stays capped at 4000ms")

  // Valid event updates last_event_id, server_retry_ms, and resets attempt to 0!
  st.on_event(
    SseEvent::{
      event_type: "message",
      data: "ok",
      id: "evt/42?a=1&b=2",
      retry: Some(1200L),
    },
  )
  debug_assert(st.attempt() == 0, "attempt reset on valid event")
  debug_assert(st.last_event_id() == "evt/42?a=1&b=2", "id updated")
  debug_assert(opt_i64_eq(st.server_retry_ms(), Some(1200L)), "server retry updated")
  debug_assert(st.next_backoff_ms() == 1200L, "uses server retry 1200ms as base")
  debug_assert(st.next_backoff_ms() == 2400L, "exponential from server retry")
  debug_assert(st.next_backoff_ms() == 4000L, "capped at max_backoff_ms")

  // Standard Last-Event-ID header and percent-encoded ?since= cursor helper
  match st.last_event_id_header() {
    Some(h) => {
      debug_assert(h.name == "Last-Event-ID", "header name")
      debug_assert(h.value == "evt/42?a=1&b=2", "header value")
    }
    None => debug_assert(false, "expected Last-Event-ID header")
  }
  debug_assert(
    st.append_cursor_query("https://sync.example/events") ==
    "https://sync.example/events?since=evt%2F42%3Fa%3D1%26b%3D2",
    "query appended with ?",
  )
  debug_assert(
    st.append_cursor_query("https://sync.example/events?room=1#top") ==
    "https://sync.example/events?room=1&since=evt%2F42%3Fa%3D1%26b%3D2#top",
    "query appended with & preserving fragment",
  )

  // Deterministic jitter reproducibility with identical seed
  let cfg_j = SseReconnectConfig::{
    base_backoff_ms: 1000L,
    max_backoff_ms: 10000L,
    jitter_ratio_bps: 2000L,
    seed: 987654321L,
    cursor_param: None,
  }
  let s1 = match SseReconnectState::with_config(cfg_j) {
    Ok(s) => s
    Err(_) => SseReconnectState::new()
  }
  let s2 = match SseReconnectState::with_config(cfg_j) {
    Ok(s) => s
    Err(_) => SseReconnectState::new()
  }
  let mut k = 0
  while k < 6 {
    let d1 = s1.next_backoff_ms()
    let d2 = s2.next_backoff_ms()
    debug_assert(d1 == d2, "same seed must yield identical jitter sequence")
    debug_assert(d1 >= 0L && d1 <= 10000L, "jittered delay within [0, max_backoff_ms]")
    k = k + 1
  }
}

// ============================================================================
// 5. DoS Limits Protection
// ============================================================================

///|
test "dos_limits_enforced_and_negative_rejected" {
  // Negative limits rejected both via SseLimits::new and SseParser::with_limits
  match SseLimits::new(-1L, 100L, 10) {
    Err(SseError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "negative max_line_bytes must fail")
  }
  let bad_p = SseParser::with_limits(
    SseLimits::{ max_line_bytes: 100L, max_event_bytes: -5L, max_data_lines: 10 },
  )
  match bad_p.feed_str("data: ok\n\n") {
    Err(SseError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "parser with negative limits must reject feed")
  }

  let lim = SseLimits::{
    max_line_bytes: 16L,
    max_event_bytes: 20L,
    max_data_lines: 3,
  }
  // 1. Line too large (both single chunk and fragmented across chunks)
  let p1 = SseParser::with_limits(lim)
  match p1.feed_str("data: 12345678901234567\n\n") {
    Err(SseError::LineTooLarge(_, _)) => ()
    _ => debug_assert(false, "expected LineTooLarge")
  }
  let p1b = SseParser::with_limits(lim)
  let _ = p1b.feed_str("data: 12345")
  match p1b.feed_str("678901234567890") {
    Err(SseError::LineTooLarge(_, _)) => ()
    _ => debug_assert(false, "expected LineTooLarge across chunks")
  }

  // 2. Event bytes too large (each line is 16 B <= max_line_bytes, total data is 10+1+10=21 B > 20 B)
  let p2 = SseParser::with_limits(lim)
  match p2.feed_str("data: 1234567890\ndata: 1234567890\n\n") {
    Err(SseError::EventTooLarge(_, _)) => ()
    _ => debug_assert(false, "expected EventTooLarge")
  }

  // 3. Too many data lines
  let p3 = SseParser::with_limits(lim)
  match p3.feed_str("data: a\ndata: b\ndata: c\ndata: d\n\n") {
    Err(SseError::TooManyDataLines(_, _)) => ()
    _ => debug_assert(false, "expected TooManyDataLines")
  }

  // 4. Massive blank-line flood must stay O(1) memory and emit 0 events
  let p4 = SseParser::with_limits(lim)
  let blanks = Bytes::new(4096)
  let mut bi = 0
  while bi < 4096 {
    blanks[bi] = (10).to_byte()
    bi = bi + 1
  }
  match p4.feed_bytes(blanks) {
    Ok(evts) => debug_assert(evts.length() == 0, "blank lines emit 0 events")
    Err(e) => debug_assert(false, "blank lines failed: " + e.message())
  }
}
