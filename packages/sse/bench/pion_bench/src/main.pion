///| Steady-state head-to-head SSE benchmark driver (Pion Native).

import "sse"

let mod_v : Int64 = 1000000007L

fn hash_bytes(h0 : Int64, s : String) -> Int64 {
  let b = s.to_bytes()
  let n = b.length()
  let mut h = h0
  let mut i = 0
  while i < n {
    h = (h * 131L + b[i].to_int().to_int64()) % mod_v
    i = i + 1
  }
  h
}

struct Stats {
  mut events : Int64
  mut data_bytes : Int64
  mut id_bytes : Int64
  mut retry_sum : Int64
  mut hash : Int64
}

fn record_events(st : Stats, evts : Array[sse::SseEvent]) -> Unit {
  let n = evts.length()
  let mut i = 0
  while i < n {
    let ev = evts[i]
    st.events = st.events + 1L
    st.data_bytes = st.data_bytes + ev.data.to_bytes().length().to_int64()
    st.id_bytes = st.id_bytes + ev.id.to_bytes().length().to_int64()
    match ev.retry {
      Some(ms) => st.retry_sum = st.retry_sum + ms
      None => ()
    }
    st.hash = hash_bytes(st.hash, ev.event_type)
    st.hash = hash_bytes(st.hash, ev.data)
    st.hash = hash_bytes(st.hash, ev.id)
    i = i + 1
  }
}

fn parse_pos_int(s : String) -> Int {
  let b = s.to_bytes()
  let mut acc = 0
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int()
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn print_stats(world : World, mode : String, iters : Int, st : Stats) -> Unit {
  io_println(world, "mode=" + mode)
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "events=" + st.events.to_string())
  io_println(world, "data_bytes=" + st.data_bytes.to_string())
  io_println(world, "id_bytes=" + st.id_bytes.to_string())
  io_println(world, "retry_sum=" + st.retry_sum.to_string())
  io_println(world, "hash=" + st.hash.to_string())
}

fn run_chunked(
  world : World,
  mode_name : String,
  raw : Bytes,
  chunk_size : Int,
  iters : Int,
) -> Int {
  let st = Stats::{
    events: 0L,
    data_bytes: 0L,
    id_bytes: 0L,
    retry_sum: 0L,
    hash: 17L,
  }
  let len = raw.length()
  let mut it = 0
  while it < iters {
    let p = sse::SseParser::new()
    let mut pos = 0
    while pos < len {
      let end = if pos + chunk_size < len { pos + chunk_size } else { len }
      match p.feed_bytes(raw.slice(pos, end)) {
        Ok(evts) => record_events(st, evts)
        Err(e) => {
          io_println(world, "error: " + e.message())
          return 1
        }
      }
      pos = end
    }
    match p.finish() {
      Ok(evts) => record_events(st, evts)
      Err(e) => {
        io_println(world, "error: " + e.message())
        return 1
      }
    }
    it = it + 1
  }
  print_stats(world, mode_name, iters, st)
  0
}

fn run_w3_roundtrip(world : World, raw : Bytes, iters : Int) -> Int {
  let initial = match sse::parse_bytes(raw) {
    Ok(evts) => evts
    Err(e) => {
      io_println(world, "error: " + e.message())
      return 1
    }
  }
  let st = Stats::{
    events: 0L,
    data_bytes: 0L,
    id_bytes: 0L,
    retry_sum: 0L,
    hash: 17L,
  }
  let mut it = 0
  while it < iters {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < initial.length() {
      match sse::format_event(initial[i]) {
        Ok(frame) => sb.write_string(frame)
        Err(e) => {
          io_println(world, "error: " + e.message())
          return 1
        }
      }
      i = i + 1
    }
    let encoded = sb.to_string().to_bytes()
    let elen = encoded.length()
    let p = sse::SseParser::new()
    let mut pos = 0
    while pos < elen {
      let end = if pos + 4096 < elen { pos + 4096 } else { elen }
      match p.feed_bytes(encoded.slice(pos, end)) {
        Ok(evts) => record_events(st, evts)
        Err(e) => {
          io_println(world, "error: " + e.message())
          return 1
        }
      }
      pos = end
    }
    match p.finish() {
      Ok(evts) => record_events(st, evts)
      Err(e) => {
        io_println(world, "error: " + e.message())
        return 1
      }
    }
    it = it + 1
  }
  print_stats(world, "w3_roundtrip", iters, st)
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: sse_bench_pion <w1|w2|w3> <file> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_pos_int(args[3])
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input file")
      return 1
    }
  }
  let raw = src.to_bytes()
  if mode == "w1" {
    run_chunked(world, "w1_stream_4k", raw, 4096, iters)
  } else if mode == "w2" {
    run_chunked(world, "w2_chunked_64b", raw, 64, iters)
  } else if mode == "w3" {
    run_w3_roundtrip(world, raw, iters)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
