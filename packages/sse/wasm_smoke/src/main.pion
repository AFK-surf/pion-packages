///| Wasm32 + Native 4-mode smoke entry for `packages/sse`.

import "sse"

fn bytes_from_ints(vals : Array[Int]) -> Bytes {
  let mut b = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

fn smoke() -> Int {
  // 1. 1-byte streaming parse with BOM, CRLF/CR/LF, 3-4 byte UTF-8, id/retry
  let body =
  ": smoke\r\n" +
  "event: sync.delta\r\n" +
  "id: cur-7\r\n" +
  "retry: 1500\r\n" +
  "data: \u{4F60}\u{597D}\u{1F680}\r\n" +
  "data:  line2\r\n" +
  "\r\n" +
  "data: tail\n\n"
  let body_bytes = body.to_bytes()
  let mut full = Bytes::new(3 + body_bytes.length())
  full[0] = (0xEF).to_byte()
  full[1] = (0xBB).to_byte()
  full[2] = (0xBF).to_byte()
  let mut i = 0
  while i < body_bytes.length() {
    full[3 + i] = body_bytes[i]
    i = i + 1
  }
  let p = sse::SseParser::new()
  let evts : Array[sse::SseEvent] = []
  let mut pos = 0
  while pos < full.length() {
    match p.feed_bytes(full.slice(pos, pos + 1)) {
      Ok(batch) => {
        let mut j = 0
        while j < batch.length() {
          evts.push(batch[j])
          j = j + 1
        }
      }
      Err(_) => return -1
    }
    pos = pos + 1
  }
  match p.finish() {
    Ok(_) => ()
    Err(_) => return -2
  }
  if evts.length() != 2 {
    return -3
  }
  if evts[0].event_type != "sync.delta" ||
  evts[0].id != "cur-7" ||
  evts[0].data != "\u{4F60}\u{597D}\u{1F680}\n line2" {
    return -4
  }
  if !sse::opt_i64_eq(evts[0].retry, Some(1500L)) {
    return -5
  }
  if evts[1].event_type != "message" ||
  evts[1].id != "cur-7" ||
  evts[1].data != "tail" {
    return -6
  }

  // 2. Encoder roundtrip + injection rejection
  let encoded = match sse::format_event(evts[0]) {
    Ok(s) => s
    Err(_) => return -7
  }
  match sse::parse_str(encoded) {
    Ok(rt) => {
      if rt.length() != 1 || !rt[0].equals(evts[0]) {
        return -8
      }
    }
    Err(_) => return -9
  }
  let forged = sse::SseEvent::{
    event_type: "bad\ndata: x",
    data: "ok",
    id: "",
    retry: None,
  }
  match sse::format_event(forged) {
    Err(sse::SseError::InvalidFieldValue(_)) => ()
    _ => return -10
  }

  // 3. Reconnect backoff + deterministic jitter + cursor helpers
  let cfg = sse::SseReconnectConfig::{
    base_backoff_ms: 500L,
    max_backoff_ms: 4000L,
    jitter_ratio_bps: 2000L,
    seed: 42L,
    cursor_param: Some("since"),
  }
  let r1 = match sse::SseReconnectState::with_config(cfg) {
    Ok(s) => s
    Err(_) => return -11
  }
  let r2 = match sse::SseReconnectState::with_config(cfg) {
    Ok(s) => s
    Err(_) => return -12
  }
  let b1 = r1.next_backoff_ms()
  let b2 = r2.next_backoff_ms()
  if b1 != b2 || b1 < 500L || b1 > 4000L {
    return -13
  }
  r1.on_event(evts[0])
  if r1.attempt() != 0 || r1.last_event_id() != "cur-7" {
    return -14
  }
  if r1.append_cursor_query("https://s.example/sse") !=
  "https://s.example/sse?since=cur-7" {
    return -15
  }

  // 4. UTF-8 Replace vs Strict
  let bad_utf8 = bytes_from_ints([100, 97, 116, 97, 58, 32, 0xFF, 10, 10])
  match sse::parse_bytes(bad_utf8) {
    Ok(es) => {
      if es.length() != 1 || es[0].data != "\u{FFFD}" {
        return -16
      }
    }
    Err(_) => return -17
  }
  let strict = sse::SseParser::with_options(
    sse::SseLimits::default(),
    sse::Utf8Mode::Strict,
  )
  match strict.feed_bytes(bad_utf8) {
    Err(sse::SseError::InvalidUtf8(_)) => ()
    _ => return -18
  }

  // 5. DoS limits enforcement (0 traps on Wasm32)
  let lim = sse::SseLimits::{
    max_line_bytes: 16L,
    max_event_bytes: 20L,
    max_data_lines: 2,
  }
  let lp = sse::SseParser::with_limits(lim)
  match lp.feed_str("data: 12345678901234567\n\n") {
    Err(sse::SseError::LineTooLarge(_, _)) => ()
    _ => return -19
  }
  let dp = sse::SseParser::with_limits(lim)
  match dp.feed_str("data: a\ndata: b\ndata: c\n\n") {
    Err(sse::SseError::TooManyDataLines(_, _)) => ()
    _ => return -20
  }
  5
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "sse_wasm_smoke: OK checks=" + r.to_string())
    0
  } else {
    io_println(world, "sse_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
