///| Streaming WHATWG HTML §9.2 Server-Sent Events parser (Red-phase stub).

///| Streaming incremental SSE parser.
pub struct SseParser {
  pub limits : SseLimits
  pub utf8_mode : Utf8Mode
}

///| Create a new `SseParser` with default limits and WHATWG U+FFFD replacement UTF-8 mode.
pub fn SseParser::new() -> SseParser {
  SseParser::with_options(SseLimits::default(), Utf8Mode::Replace)
}

///| Create a new `SseParser` with custom DoS limits.
pub fn SseParser::with_limits(limits : SseLimits) -> SseParser {
  SseParser::with_options(limits, Utf8Mode::Replace)
}

///| Create a new `SseParser` with custom DoS limits and UTF-8 mode.
pub fn SseParser::with_options(
  limits : SseLimits,
  utf8_mode : Utf8Mode,
) -> SseParser {
  SseParser::{ limits: limits, utf8_mode: utf8_mode }
}

///| Feed a chunk of raw bytes into the streaming parser.
pub fn SseParser::feed_bytes(
  self : SseParser,
  chunk : Bytes,
) -> Result[Array[SseEvent], SseError] {
  let _ = self
  let _ = chunk
  Err(SseError::Unimplemented)
}

///| Feed a UTF-8 string chunk into the streaming parser.
pub fn SseParser::feed_str(
  self : SseParser,
  chunk : String,
) -> Result[Array[SseEvent], SseError] {
  let _ = self
  let _ = chunk
  Err(SseError::Unimplemented)
}

///| Signal end-of-stream and discard any incomplete trailing event per WHATWG §9.2.6.
pub fn SseParser::finish(self : SseParser) -> Result[Array[SseEvent], SseError] {
  let _ = self
  Err(SseError::Unimplemented)
}

///| Return the last committed event ID string.
pub fn SseParser::last_event_id(self : SseParser) -> String {
  let _ = self
  ""
}

///| Return the stream's latest valid server-specified reconnection time in milliseconds.
pub fn SseParser::retry_ms(self : SseParser) -> Option[Int64] {
  let _ = self
  None
}

///| Reset parser state to initial stream start.
pub fn SseParser::reset(self : SseParser) -> Unit {
  let _ = self
}

///| Convenience one-shot parser for a complete byte buffer.
pub fn parse_bytes(input : Bytes) -> Result[Array[SseEvent], SseError] {
  let p = SseParser::new()
  let _ = p
  let _ = input
  Err(SseError::Unimplemented)
}

///| Convenience one-shot parser for a complete UTF-8 string.
pub fn parse_str(input : String) -> Result[Array[SseEvent], SseError] {
  let _ = input
  Err(SseError::Unimplemented)
}
