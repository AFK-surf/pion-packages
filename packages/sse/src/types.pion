///| Core public types, limits, and errors for WHATWG Server-Sent Events (`packages/sse`).

///| UTF-8 decoding mode for `SseParser`.
pub enum Utf8Mode {
  ///| WHATWG Encoding Standard compliant replacement of ill-formed maximal subparts with U+FFFD (default).
  Replace
  ///| Reject any ill-formed UTF-8 byte sequence with `SseError::InvalidUtf8`.
  Strict
}

///| Structured errors returned by SSE parsing, encoding, and configuration.
pub enum SseError {
  LineTooLarge(Int64, Int64)
  EventTooLarge(Int64, Int64)
  TooManyDataLines(Int, Int)
  InvalidLimits(String)
  InvalidFieldValue(String)
  InvalidUtf8(Int)
  Unimplemented
}

///| Format a human-readable message for an `SseError`.
pub fn SseError::message(self : SseError) -> String {
  match self {
    SseError::LineTooLarge(actual, limit) =>
    "SSE line too large: " + actual.to_string() + " > " + limit.to_string()
    SseError::EventTooLarge(actual, limit) =>
    "SSE event data too large: " + actual.to_string() + " > " + limit.to_string()
    SseError::TooManyDataLines(actual, limit) =>
    "SSE event has too many data lines: " +
    actual.to_string() +
    " > " +
    limit.to_string()
    SseError::InvalidLimits(msg) => "invalid SSE limits: " + msg
    SseError::InvalidFieldValue(msg) => "invalid SSE field value: " + msg
    SseError::InvalidUtf8(offset) =>
    "invalid UTF-8 byte sequence at offset " + offset.to_string()
    SseError::Unimplemented => "unimplemented"
  }
}

///| DoS protection limits for `SseParser`.
pub val struct SseLimits {
  ///| Maximum bytes in a single SSE line excluding line terminator (default: 1 MiB).
  pub max_line_bytes : Int64
  ///| Maximum accumulated bytes in a single event's data payload (default: 4 MiB).
  pub max_event_bytes : Int64
  ///| Maximum number of `data:` lines in a single event (default: 65,536).
  pub max_data_lines : Int
}

///| Return production default DoS limits: 1 MiB line, 4 MiB event, 65,536 data lines.
pub fn SseLimits::default() -> SseLimits {
  SseLimits::{
    max_line_bytes: 1048576L,
    max_event_bytes: 4194304L,
    max_data_lines: 65536,
  }
}

///| Validate limits, rejecting negative values.
pub fn SseLimits::validate(self : SseLimits) -> Result[Unit, SseError] {
  if self.max_line_bytes < 0L {
    return Err(SseError::InvalidLimits("max_line_bytes must be >= 0"))
  }
  if self.max_event_bytes < 0L {
    return Err(SseError::InvalidLimits("max_event_bytes must be >= 0"))
  }
  if self.max_data_lines < 0 {
    return Err(SseError::InvalidLimits("max_data_lines must be >= 0"))
  }
  Ok(())
}

///| Construct validated `SseLimits`.
pub fn SseLimits::new(
  max_line_bytes : Int64,
  max_event_bytes : Int64,
  max_data_lines : Int,
) -> Result[SseLimits, SseError] {
  let lim = SseLimits::{
    max_line_bytes: max_line_bytes,
    max_event_bytes: max_event_bytes,
    max_data_lines: max_data_lines,
  }
  match lim.validate() {
    Ok(_) => Ok(lim)
    Err(e) => Err(e)
  }
}

///| A single dispatched WHATWG Server-Sent Event.
pub val struct SseEvent {
  ///| Event type (`"message"` by default when omitted or empty).
  pub event_type : String
  ///| Event payload joined with `\n` across `data:` lines.
  pub data : String
  ///| Last event ID committed at dispatch time (`""` if unset or cleared).
  pub id : String
  ///| Reconnection delay in milliseconds if set by a valid `retry:` field in this event block.
  pub retry : Option[Int64]
}

///| Construct a default `"message"` event with empty `id` and `retry: None`.
pub fn SseEvent::new(data : String) -> SseEvent {
  SseEvent::{ event_type: "message", data: data, id: "", retry: None }
}

///| Compare two `Option[Int64]` values for equality.
pub fn opt_i64_eq(a : Option[Int64], b : Option[Int64]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///| Structural equality comparison between two `SseEvent` values.
pub fn SseEvent::equals(self : SseEvent, other : SseEvent) -> Bool {
  self.event_type == other.event_type &&
  self.data == other.data &&
  self.id == other.id &&
  opt_i64_eq(self.retry, other.retry)
}

///| An HTTP header name/value pair returned by reconnect helpers.
pub val struct SseHeader {
  pub name : String
  pub value : String
}

///| Configuration for `SseReconnectState` exponential backoff and cursor helpers.
pub val struct SseReconnectConfig {
  ///| Initial backoff delay in milliseconds when server has not sent `retry:` (default: 1000 ms).
  pub base_backoff_ms : Int64
  ///| Maximum capped backoff delay in milliseconds (default: 30000 ms).
  pub max_backoff_ms : Int64
  ///| Deterministic jitter ratio in basis points (0..=10000, default: 2000 = up to +20%).
  pub jitter_ratio_bps : Int64
  ///| Deterministic PRNG seed (World-free).
  pub seed : Int64
  ///| Optional query parameter name for cursor resumption (e.g. `Some("since")`).
  pub cursor_param : Option[String]
}

///| Default reconnect config: base 1000ms, max 30000ms, jitter 2000 bps (20%), fixed seed, no cursor param.
pub fn SseReconnectConfig::default() -> SseReconnectConfig {
  SseReconnectConfig::{
    base_backoff_ms: 1000L,
    max_backoff_ms: 30000L,
    jitter_ratio_bps: 2000L,
    seed: 0x517CC1B727220A95L,
    cursor_param: None,
  }
}

///| Validate reconnect configuration.
pub fn SseReconnectConfig::validate(
  self : SseReconnectConfig,
) -> Result[Unit, SseError] {
  if self.base_backoff_ms < 0L {
    return Err(SseError::InvalidLimits("base_backoff_ms must be >= 0"))
  }
  if self.max_backoff_ms < 0L {
    return Err(SseError::InvalidLimits("max_backoff_ms must be >= 0"))
  }
  if self.max_backoff_ms < self.base_backoff_ms {
    return Err(
      SseError::InvalidLimits("max_backoff_ms must be >= base_backoff_ms"),
    )
  }
  if self.jitter_ratio_bps < 0L || self.jitter_ratio_bps > 10000L {
    return Err(
      SseError::InvalidLimits("jitter_ratio_bps must be in 0..=10000"),
    )
  }
  Ok(())
}
