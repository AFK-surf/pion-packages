///| Injection-safe WHATWG Server-Sent Events encoder.

///| Check whether a string contains CR (`\r`), LF (`\n`), or NUL (`\0`).
fn has_forbidden_field_byte(s : String) -> Bool {
  let b = s.to_bytes()
  let len = b.length()
  let mut i = 0
  while i < len {
    let c = b[i].to_int()
    if c == 10 || c == 13 || c == 0 {
      return true
    }
    i = i + 1
  }
  false
}

///| Check whether a byte buffer contains CR (`\r`) or LF (`\n`).
fn has_newline_byte(b : Bytes) -> Bool {
  let len = b.length()
  let mut i = 0
  while i <= len - 4 {
    let c0 = b[i].to_int()
    let c1 = b[i + 1].to_int()
    let c2 = b[i + 2].to_int()
    let c3 = b[i + 3].to_int()
    if c0 == 10 ||
    c0 == 13 ||
    c1 == 10 ||
    c1 == 13 ||
    c2 == 10 ||
    c2 == 13 ||
    c3 == 10 ||
    c3 == 13 {
      return true
    }
    i = i + 4
  }
  while i < len {
    let c = b[i].to_int()
    if c == 10 || c == 13 {
      return true
    }
    i = i + 1
  }
  false
}

///| Write a potentially multiline payload with a fixed line prefix (e.g. `"data: "` or `": "`).
///| Splits on `\r\n`, `\n`, and `\r` so no embedded line break can inject a new SSE field.
fn write_prefixed_lines(
  sb : StringBuilder,
  prefix : String,
  payload : String,
) -> Unit {
  let b = payload.to_bytes()
  if !has_newline_byte(b) {
    sb.write_string(prefix)
    sb.write_string(payload)
    sb.write_string("\n")
    return ()
  }
  let len = b.length()
  let mut line_start = 0
  let mut i = 0
  while i < len {
    let c = b[i].to_int()
    if c == 10 || c == 13 {
      sb.write_string(prefix)
      if i > line_start {
        sb.write_string(b.slice(line_start, i).to_string())
      }
      sb.write_string("\n")
      if c == 13 && i + 1 < len && b[i + 1].to_int() == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
      line_start = i
    } else {
      i = i + 1
    }
  }
  // Emit trailing segment (including empty segment after trailing newline)
  sb.write_string(prefix)
  if len > line_start {
    sb.write_string(b.slice(line_start, len).to_string())
  }
  sb.write_string("\n")
}

///| Encode an `SseEvent` into a wire-format SSE frame string.
///| Rejects CR, LF, or NUL in `event_type` or `id`, and negative `retry`.
pub fn format_event(event : SseEvent) -> Result[String, SseError] {
  if has_forbidden_field_byte(event.event_type) {
    return Err(
      SseError::InvalidFieldValue("event_type must not contain CR, LF, or NUL"),
    )
  }
  if has_forbidden_field_byte(event.id) {
    return Err(
      SseError::InvalidFieldValue("id must not contain CR, LF, or NUL"),
    )
  }
  match event.retry {
    Some(ms) => {
      if ms < 0L {
        return Err(SseError::InvalidFieldValue("retry must be >= 0"))
      }
    }
    None => ()
  }
  let sb = StringBuilder::new()
  if event.event_type.length() > 0 && event.event_type != "message" {
    sb.write_string("event: ")
    sb.write_string(event.event_type)
    sb.write_string("\n")
  }
  if event.id.length() > 0 {
    sb.write_string("id: ")
    sb.write_string(event.id)
    sb.write_string("\n")
  }
  match event.retry {
    Some(ms) => {
      sb.write_string("retry: ")
      sb.write_string(ms.to_string())
      sb.write_string("\n")
    }
    None => ()
  }
  write_prefixed_lines(sb, "data: ", event.data)
  sb.write_string("\n")
  Ok(sb.to_string())
}

///| Encode an `SseEvent` into wire-format UTF-8 bytes.
pub fn format_event_bytes(event : SseEvent) -> Result[Bytes, SseError] {
  match format_event(event) {
    Ok(s) => Ok(s.to_bytes())
    Err(e) => Err(e)
  }
}

///| Encode an SSE comment (splitting multiline comments into `: line\n` lines).
pub fn format_comment(comment : String) -> Result[String, SseError] {
  let sb = StringBuilder::new()
  if comment.length() == 0 {
    sb.write_string(":\n")
  } else {
    write_prefixed_lines(sb, ": ", comment)
  }
  Ok(sb.to_string())
}
