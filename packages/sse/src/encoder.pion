///| Rejects CR, LF, or NUL in `event_type` or `id`, and negative `retry`.
pub fn format_event(event : SseEvent) -> Result[String, SseError] {
  let _ = event
  Err(SseError::Unimplemented)
}

///| Encode an `SseEvent` into wire-format UTF-8 bytes.
pub fn format_event_bytes(event : SseEvent) -> Result[Bytes, SseError] {
  let _ = event
  Err(SseError::Unimplemented)
}

///| Encode an SSE comment (splitting multiline comments into `: line\n` lines).
pub fn format_comment(comment : String) -> Result[String, SseError] {
  let _ = comment
  Err(SseError::Unimplemented)
}
