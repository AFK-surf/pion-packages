///| Sans-IO, World-free SSE reconnection and deterministic exponential backoff state machine.

///| Tracks `last_event_id`, server `retry_ms`, consecutive failure count, and deterministic jittered backoff.
pub struct SseReconnectState {
  pub config : SseReconnectConfig
  mut last_id : String
  mut retry_ms : Option[Int64]
  mut fail_attempt : Int
  mut rng_state : Int64
}

///| Create a new `SseReconnectState` with default configuration.
pub fn SseReconnectState::new() -> SseReconnectState {
  let cfg = SseReconnectConfig::default()
  SseReconnectState::{
    config: cfg,
    last_id: "",
    retry_ms: None,
    fail_attempt: 0,
    rng_state: if cfg.seed == 0L { 0x9E3779B97F4A7C15L } else { cfg.seed },
  }
}

///| Create a new `SseReconnectState` with validated custom configuration.
pub fn SseReconnectState::with_config(
  config : SseReconnectConfig,
) -> Result[SseReconnectState, SseError] {
  match config.validate() {
    Ok(_) =>
    Ok(
      SseReconnectState::{
        config: config,
        last_id: "",
        retry_ms: None,
        fail_attempt: 0,
        rng_state: if config.seed == 0L {
          0x9E3779B97F4A7C15L
        } else {
          config.seed
        },
      },
    )
    Err(e) => Err(e)
  }
}

///| Record receipt of a valid dispatched event (updates cursor/retry and resets attempt counter).
pub fn SseReconnectState::on_event(
  self : SseReconnectState,
  event : SseEvent,
) -> Unit {
  self.last_id = event.id
  match event.retry {
    Some(ms) => {
      if ms >= 0L {
        self.retry_ms = Some(ms)
      }
    }
    None => ()
  }
  self.fail_attempt = 0
}

///| Record a server-supplied `retry:` directive (ms) without waiting for an event dispatch.
pub fn SseReconnectState::on_retry(
  self : SseReconnectState,
  retry_ms : Int64,
) -> Unit {
  if retry_ms >= 0L {
    self.retry_ms = Some(retry_ms)
  }
}

///| Record a successful connection establishment (resets consecutive failure counter).
pub fn SseReconnectState::on_connect_success(self : SseReconnectState) -> Unit {
  self.fail_attempt = 0
}

///| Deterministic 63-bit non-negative PRNG step (LCG mod 2^63, identical on Native and Wasm32).
fn SseReconnectState::next_rand_nonneg(self : SseReconnectState) -> Int64 {
  let mask = 0x7FFFFFFFFFFFFFFFL
  let next = (self.rng_state * 6364136223846793005L + 1442695040888963407L) &
  mask
  self.rng_state = if next == 0L { 1L } else { next }
  // Mix upper bits down for better low-bit quality
  let mixed = (self.rng_state >> 16) ^ self.rng_state
  mixed & mask
}

///| Record a disconnect/failure and compute the next deterministic jittered backoff delay in ms.
pub fn SseReconnectState::next_backoff_ms(self : SseReconnectState) -> Int64 {
  self.fail_attempt = self.fail_attempt + 1
  let base = match self.retry_ms {
    Some(r) => r
    None => self.config.base_backoff_ms
  }
  let cap = self.config.max_backoff_ms
  let mut delay = if base >= cap { cap } else { base }
  let shifts = if self.fail_attempt <= 1 {
    0
  } else if self.fail_attempt - 1 > 30 {
    30
  } else {
    self.fail_attempt - 1
  }
  let mut i = 0
  while i < shifts && delay < cap {
    if delay >= cap / 2L {
      delay = cap
      break
    }
    delay = delay * 2L
    i = i + 1
  }
  if self.config.jitter_ratio_bps > 0L && delay > 0L {
    let bps = self.config.jitter_ratio_bps
    let span = (delay / 10000L) * bps + ((delay % 10000L) * bps) / 10000L
    if span > 0L {
      let delta = self.next_rand_nonneg() % (span + 1L)
      if delta >= cap - delay {
        delay = cap
      } else {
        delay = delay + delta
      }
    }
  }
  if delay < 0L {
    0L
  } else if delay > cap {
    cap
  } else {
    delay
  }
}

///| Current consecutive failure attempt count.
pub fn SseReconnectState::attempt(self : SseReconnectState) -> Int {
  self.fail_attempt
}

///| Current tracked `last_event_id`.
pub fn SseReconnectState::last_event_id(self : SseReconnectState) -> String {
  self.last_id
}

///| Explicitly seed or override `last_event_id` (e.g. from persisted storage).
pub fn SseReconnectState::set_last_event_id(
  self : SseReconnectState,
  id : String,
) -> Unit {
  self.last_id = id
}

///| Current server-specified `retry_ms`, if any.
pub fn SseReconnectState::server_retry_ms(
  self : SseReconnectState,
) -> Option[Int64] {
  self.retry_ms
}

///| Build the standard `Last-Event-ID` HTTP request header if a non-empty cursor is tracked.
pub fn SseReconnectState::last_event_id_header(
  self : SseReconnectState,
) -> Option[SseHeader] {
  if self.last_id.length() == 0 {
    None
  } else {
    Some(SseHeader::{ name: "Last-Event-ID", value: self.last_id })
  }
}

///| Return uppercase hex character string for a nibble (0..15).
fn hex_digit_upper(n : Int) -> String {
  if n == 0 {
    "0"
  } else if n == 1 {
    "1"
  } else if n == 2 {
    "2"
  } else if n == 3 {
    "3"
  } else if n == 4 {
    "4"
  } else if n == 5 {
    "5"
  } else if n == 6 {
    "6"
  } else if n == 7 {
    "7"
  } else if n == 8 {
    "8"
  } else if n == 9 {
    "9"
  } else if n == 10 {
    "A"
  } else if n == 11 {
    "B"
  } else if n == 12 {
    "C"
  } else if n == 13 {
    "D"
  } else if n == 14 {
    "E"
  } else {
    "F"
  }
}

///| RFC 3986 percent-encode a query parameter value (unreserved: A-Z a-z 0-9 - _ . ~).
fn percent_encode_query_value(s : String) -> String {
  let b = s.to_bytes()
  let len = b.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    let c = b[i].to_int()
    let unreserved = (c >= 65 && c <= 90) ||
    (c >= 97 && c <= 122) ||
    (c >= 48 && c <= 57) ||
    c == 45 ||
    c == 95 ||
    c == 46 ||
    c == 126
    if unreserved {
      sb.write_string(b.slice(i, i + 1).to_string())
    } else {
      sb.write_string("%")
      sb.write_string(hex_digit_upper((c >> 4) & 15))
      sb.write_string(hex_digit_upper(c & 15))
    }
    i = i + 1
  }
  sb.to_string()
}

///| Append an explicit query parameter `param=<encoded_cursor>` to `base_url` if cursor is non-empty.
pub fn SseReconnectState::append_cursor_query_with(
  self : SseReconnectState,
  base_url : String,
  param : String,
) -> String {
  if self.last_id.length() == 0 || param.length() == 0 {
    return base_url
  }
  let ub = base_url.to_bytes()
  let ulen = ub.length()
  let mut hash_pos = ulen
  let mut has_q = false
  let mut i = 0
  while i < ulen {
    let c = ub[i].to_int()
    if c == 35 {
      // '#'
      hash_pos = i
      break
    }
    if c == 63 {
      // '?'
      has_q = true
    }
    i = i + 1
  }
  let sep = if has_q { "&" } else { "?" }
  let encoded = percent_encode_query_value(self.last_id)
  let sb = StringBuilder::new()
  sb.write_string(ub.slice(0, hash_pos).to_string())
  sb.write_string(sep)
  sb.write_string(param)
  sb.write_string("=")
  sb.write_string(encoded)
  if hash_pos < ulen {
    sb.write_string(ub.slice(hash_pos, ulen).to_string())
  }
  sb.to_string()
}

///| Append the configured `cursor_param` query parameter (percent-encoded) to `base_url` if cursor is non-empty.
pub fn SseReconnectState::append_cursor_query(
  self : SseReconnectState,
  base_url : String,
) -> String {
  match self.config.cursor_param {
    Some(param) => self.append_cursor_query_with(base_url, param)
    None => base_url
  }
}
