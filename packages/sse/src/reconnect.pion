///| Sans-IO, World-free SSE reconnection and deterministic exponential backoff state machine (Red-phase stub).

///| Tracks `last_event_id`, server `retry_ms`, consecutive failure count, and deterministic jittered backoff.
pub struct SseReconnectState {
  pub config : SseReconnectConfig
}

///| Create a new `SseReconnectState` with default configuration.
pub fn SseReconnectState::new() -> SseReconnectState {
  SseReconnectState::{ config: SseReconnectConfig::default() }
}

///| Create a new `SseReconnectState` with validated custom configuration.
pub fn SseReconnectState::with_config(
  config : SseReconnectConfig,
) -> Result[SseReconnectState, SseError] {
  let _ = config
  Err(SseError::Unimplemented)
}

///| Record receipt of a valid dispatched event (updates cursor/retry and resets attempt counter).
pub fn SseReconnectState::on_event(
  self : SseReconnectState,
  event : SseEvent,
) -> Unit {
  let _ = self
  let _ = event
}

///| Record a server-supplied `retry:` directive (ms) without waiting for an event dispatch.
pub fn SseReconnectState::on_retry(
  self : SseReconnectState,
  retry_ms : Int64,
) -> Unit {
  let _ = self
  let _ = retry_ms
}

///| Record a successful connection establishment (resets consecutive failure counter).
pub fn SseReconnectState::on_connect_success(self : SseReconnectState) -> Unit {
  let _ = self
}

///| Record a disconnect/failure and compute the next deterministic jittered backoff delay in ms.
pub fn SseReconnectState::next_backoff_ms(self : SseReconnectState) -> Int64 {
  let _ = self
  -1L
}

///| Current consecutive failure attempt count.
pub fn SseReconnectState::attempt(self : SseReconnectState) -> Int {
  let _ = self
  0
}

///| Current tracked `last_event_id`.
pub fn SseReconnectState::last_event_id(self : SseReconnectState) -> String {
  let _ = self
  ""
}

///| Explicitly seed or override `last_event_id` (e.g. from persisted storage).
pub fn SseReconnectState::set_last_event_id(
  self : SseReconnectState,
  id : String,
) -> Unit {
  let _ = self
  let _ = id
}

///| Current server-specified `retry_ms`, if any.
pub fn SseReconnectState::server_retry_ms(
  self : SseReconnectState,
) -> Option[Int64] {
  let _ = self
  None
}

///| Build the standard `Last-Event-ID` HTTP request header if a non-empty cursor is tracked.
pub fn SseReconnectState::last_event_id_header(
  self : SseReconnectState,
) -> Option[SseHeader] {
  let _ = self
  None
}

///| Append the configured `cursor_param` query parameter (percent-encoded) to `base_url` if cursor is non-empty.
pub fn SseReconnectState::append_cursor_query(
  self : SseReconnectState,
  base_url : String,
) -> String {
  let _ = self
  base_url
}

///| Append an explicit query parameter `param=<encoded_cursor>` to `base_url` if cursor is non-empty.
pub fn SseReconnectState::append_cursor_query_with(
  self : SseReconnectState,
  base_url : String,
  param : String,
) -> String {
  let _ = self
  let _ = param
  base_url
}
