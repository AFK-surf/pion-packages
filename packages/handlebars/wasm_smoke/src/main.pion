///| 4-mode (native_dbg, native_rel, wasm_dbg, wasm_rel) smoke test for `packages/handlebars`.

import "handlebars"

///|
pub fn smoke() -> Result[String, Int] {
  let reg = handlebars::Registry::new()
  match reg.register_partial("layout", "<section>{{> @partial-block}}</section>") {
    Ok(()) => ()
    Err(_) => return Err(-1)
  }
  reg.register_helper(
    "eq",
    fn(ctx : handlebars::HelperContext) -> Result[handlebars::Value, handlebars::HandlebarsError] {
      match (ctx.param(0), ctx.param(1)) {
        (Some(handlebars::Value::Int(a)), Some(handlebars::Value::Int(b))) =>
        Ok(handlebars::Value::bool(a == b))
        _ => Ok(handlebars::Value::bool(false))
      }
    },
  )
  reg.register_helper(
    "len",
    fn(ctx : handlebars::HelperContext) -> Result[handlebars::Value, handlebars::HandlebarsError] {
      match ctx.param(0) {
        Some(handlebars::Value::Array(xs)) =>
        Ok(handlebars::Value::int(xs.length()))
        _ => Ok(handlebars::Value::int(0))
      }
    },
  )

  let tmpl = "{{#*inline \"row\"}}<li>{{idx}}:{{name}}</li>{{/inline}}{{#> layout}}<h1>{{~title~}}</h1>{{#if (eq (len items) 2)}}<ul>{{~#each items as |it i|~}}{{> row idx=i name=it.name}}{{~/each~}}</ul>{{/if}}{{raw_safe}}{{/layout}}"
  let data = handlebars::Value::object([
    ("title", handlebars::Value::string("  <Pion & \"HBS\" '1' `2` =3>  ")),
    (
      "items",
      handlebars::Value::array([
        handlebars::Value::object([("name", handlebars::Value::string("A&B"))]),
        handlebars::Value::object([("name", handlebars::Value::string("C<D"))]),
      ]),
    ),
    ("raw_safe", handlebars::Value::safe_string("<b>OK</b>")),
  ])

  let out = match reg.render_template(tmpl, data) {
    Ok(s) => s
    Err(_) => return Err(-2)
  }
  let expected = "<section><h1>  &lt;Pion &amp; &quot;HBS&quot; &#x27;1&#x27; &#x60;2&#x60; &#x3D;3&gt;  </h1><ul><li>0:A&amp;B</li><li>1:C&lt;D</li></ul><b>OK</b></section>"
  if out != expected {
    return Err(-3)
  }

  // Mustache custom delimiters
  match handlebars::render("{{=<% %>=}}<%msg%>", handlebars::Value::object([("msg", handlebars::Value::string("delim-ok"))])) {
    Ok(s) =>
    if s != "delim-ok" {
      return Err(-4)
    }
    Err(_) => return Err(-5)
  }

  // Recursive partial DoS protection (must not trap on Wasm32)
  let dos_reg = handlebars::Registry::with_limits(
    handlebars::HandlebarsLimits::{
      max_depth: 32,
      max_partial_depth: 6,
      max_steps: 10000L,
      max_output_bytes: 4096,
      max_template_bytes: 4096,
    },
  )
  match dos_reg.register_partial("loop", "x{{> loop}}") {
    Ok(()) => ()
    Err(_) => return Err(-6)
  }
  match dos_reg.render_template("{{> loop}}", handlebars::Value::object([])) {
    Ok(_) => return Err(-7)
    Err(e) =>
    if !e.is_kind(handlebars::ErrorKind::PartialDepthLimitExceeded) {
      return Err(-8)
    }
  }

  Ok(out)
}

///|
pub fn main(world : World) -> Int {
  match smoke() {
    Ok(out) => {
      io_println(world, "handlebars_wasm_smoke: OK len=" + out.length().to_string())
      io_println(world, out)
      0
    }
    Err(code) => {
      io_println(world, "handlebars_wasm_smoke: FAIL code=" + code.to_string())
      1
    }
  }
}
