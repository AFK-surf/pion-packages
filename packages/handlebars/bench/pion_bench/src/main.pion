///| Head-to-head benchmark driver for `packages/handlebars` (W1, W2, W3).

import "handlebars"

fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn fnv1a_str(seed : Int64, s : String) -> Int64 {
  let mut h = seed
  let n = s.length()
  let mut i = 0
  while i < n {
    h = ((h ^ s.code_unit_at(i).to_int64()) * 16777619L) & 0xFFFFFFFFL
    i = i + 1
  }
  h
}

fn run_w1(world : World, dir : String, iters : Int) -> Int {
  let badge = match fs_read(world, dir + "/w1_badge.hbs") {
    Ok(s) => s
    Err(_) => return 1
  }
  let card = match fs_read(world, dir + "/w1_card.hbs") {
    Ok(s) => s
    Err(_) => return 1
  }
  let page = match fs_read(world, dir + "/w1_page.hbs") {
    Ok(s) => s
    Err(_) => return 1
  }
  let data_src = match fs_read(world, dir + "/w1_data.json") {
    Ok(s) => s
    Err(_) => return 1
  }
  let data = match handlebars::Value::from_json(data_src) {
    Ok(v) => v
    Err(_) => return 1
  }
  let reg = handlebars::Registry::new()
  match reg.register_partial("badge", badge) {
    Ok(()) => ()
    Err(_) => return 1
  }
  match reg.register_partial("card", card) {
    Ok(()) => ()
    Err(_) => return 1
  }
  match reg.register_template("page", page) {
    Ok(()) => ()
    Err(_) => return 1
  }

  let mut total_bytes = 0L
  let mut checksum = 2166136261L
  let mut first_out = ""
  let mut i = 0
  while i < iters {
    let out = match reg.render("page", data) {
      Ok(s) => s
      Err(_) => return 1
    }
    if i == 0 {
      first_out = out
    }
    total_bytes = total_bytes + out.length().to_int64()
    checksum = fnv1a_str(checksum, out)
    i = i + 1
  }
  io_println(world, first_out)
  io_println(
    world,
    "W1 iters=" +
    iters.to_string() +
    " total_bytes=" +
    total_bytes.to_string() +
    " checksum=" +
    checksum.to_string(),
  )
  0
}

fn run_w2(world : World, dir : String, iters : Int) -> Int {
  let tmpl_src = match fs_read(world, dir + "/w2_tmpl.hbs") {
    Ok(s) => s
    Err(_) => return 1
  }
  let data_src = match fs_read(world, dir + "/w2_data.json") {
    Ok(s) => s
    Err(_) => return 1
  }
  let data = match handlebars::Value::from_json(data_src) {
    Ok(v) => v
    Err(_) => return 1
  }
  let reg = handlebars::Registry::new()
  reg.register_helper(
    "eq",
    fn(ctx : handlebars::HelperContext) -> Result[handlebars::Value, handlebars::HandlebarsError] {
      match (ctx.param(0), ctx.param(1)) {
        (Some(handlebars::Value::Str(a)), Some(handlebars::Value::Str(b))) =>
        Ok(handlebars::Value::bool(a == b))
        _ => Ok(handlebars::Value::bool(false))
      }
    },
  )

  let mut total_bytes = 0L
  let mut checksum = 2166136261L
  let mut first_out = ""
  let mut i = 0
  while i < iters {
    let out = match reg.render_template(tmpl_src, data) {
      Ok(s) => s
      Err(_) => return 1
    }
    if i == 0 {
      first_out = out
    }
    total_bytes = total_bytes + out.length().to_int64()
    checksum = fnv1a_str(checksum, out)
    i = i + 1
  }
  io_println(world, first_out)
  io_println(
    world,
    "W2 iters=" +
    iters.to_string() +
    " total_bytes=" +
    total_bytes.to_string() +
    " checksum=" +
    checksum.to_string(),
  )
  0
}

fn run_w3(world : World, dir : String, iters : Int) -> Int {
  let tmpl_src = match fs_read(world, dir + "/w3_tmpl.hbs") {
    Ok(s) => s
    Err(_) => return 1
  }
  let data_src = match fs_read(world, dir + "/w3_data.json") {
    Ok(s) => s
    Err(_) => return 1
  }
  let data = match handlebars::Value::from_json(data_src) {
    Ok(v) => v
    Err(_) => return 1
  }
  let reg = handlebars::Registry::new()
  match reg.register_template("table", tmpl_src) {
    Ok(()) => ()
    Err(_) => return 1
  }

  let mut total_bytes = 0L
  let mut checksum = 2166136261L
  let mut first_out = ""
  let mut i = 0
  while i < iters {
    let out = match reg.render("table", data) {
      Ok(s) => s
      Err(_) => return 1
    }
    if i == 0 {
      first_out = out
    }
    total_bytes = total_bytes + out.length().to_int64()
    checksum = fnv1a_str(checksum, out)
    i = i + 1
  }
  io_println(world, first_out)
  io_println(
    world,
    "W3 iters=" +
    iters.to_string() +
    " total_bytes=" +
    total_bytes.to_string() +
    " checksum=" +
    checksum.to_string(),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: handlebars_bench_pion <w1|w2|w3> <data_dir> <iters>")
    return 1
  }
  let mode = args[1]
  let dir = args[2]
  let iters = parse_int_arg(args[3], 100)
  if mode == "w1" {
    run_w1(world, dir, iters)
  } else if mode == "w2" {
    run_w2(world, dir, iters)
  } else if mode == "w3" {
    run_w3(world, dir, iters)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
