///| Pure-Pion Handlebars 4.x + Mustache 1.4.2 template engine.
///| Zero C/FFI dependencies, `World`-free, Native + Wasm32 compatible.

///| Create a new `Registry` with default limits and options.
pub fn Registry::new() -> Registry {
  Registry::with_limits(HandlebarsLimits::default())
}

///| Create a new `Registry` with explicit resource limits.
pub fn Registry::with_limits(limits : HandlebarsLimits) -> Registry {
  Registry::{
    strict_mode: false,
    no_escape: false,
    limits: limits,
    templates: [],
    partials: [],
    helpers: [],
  }
}

///| Enable or disable strict mode (undefined paths return `ErrorKind::StrictUndefined`).
pub fn Registry::set_strict_mode(self : Registry, strict : Bool) -> Unit {
  self.strict_mode = strict
}

///| Enable or disable automatic HTML escaping for `{{...}}` expressions.
pub fn Registry::set_no_escape(self : Registry, no_escape : Bool) -> Unit {
  self.no_escape = no_escape
}

///| Update resource limits on this registry.
pub fn Registry::set_limits(self : Registry, limits : HandlebarsLimits) -> Unit {
  self.limits = limits
}

///| Read the current resource limits.
pub fn Registry::limits(self : Registry) -> HandlebarsLimits {
  self.limits
}

///| Compile and register a named template.
pub fn Registry::register_template(
  self : Registry,
  name : String,
  source : String,
) -> Result[Unit, HandlebarsError] {
  let _ = self
  let _ = name
  let _ = source
  Err(
    HandlebarsError::new(
      ErrorKind::SyntaxError,
      "not implemented",
      Some(name),
      0,
      0,
    ),
  )
}

///| Compile and register a named partial.
pub fn Registry::register_partial(
  self : Registry,
  name : String,
  source : String,
) -> Result[Unit, HandlebarsError] {
  let _ = self
  let _ = name
  let _ = source
  Err(
    HandlebarsError::new(
      ErrorKind::SyntaxError,
      "not implemented",
      Some(name),
      0,
      0,
    ),
  )
}

///| Register a custom inline or block helper.
pub fn Registry::register_helper(
  self : Registry,
  name : String,
  f : (HelperContext) -> Result[Value, HandlebarsError],
) -> Unit {
  let mut i = 0
  while i < self.helpers.length() {
    let (k, _) = self.helpers[i]
    if k == name {
      self.helpers[i] = (name, f)
      return
    }
    i = i + 1
  }
  self.helpers.push((name, f))
}

///| Return true if a named template is registered.
pub fn Registry::has_template(self : Registry, name : String) -> Bool {
  let mut i = 0
  while i < self.templates.length() {
    let (k, _) = self.templates[i]
    if k == name {
      return true
    }
    i = i + 1
  }
  false
}

///| Return true if a named partial is registered.
pub fn Registry::has_partial(self : Registry, name : String) -> Bool {
  let mut i = 0
  while i < self.partials.length() {
    let (k, _) = self.partials[i]
    if k == name {
      return true
    }
    i = i + 1
  }
  false
}

///| Return true if a custom helper is registered.
pub fn Registry::has_helper(self : Registry, name : String) -> Bool {
  let mut i = 0
  while i < self.helpers.length() {
    let (k, _) = self.helpers[i]
    if k == name {
      return true
    }
    i = i + 1
  }
  false
}

///| Remove a registered template if present.
pub fn Registry::unregister_template(self : Registry, name : String) -> Unit {
  let n = self.templates.length()
  let mut i = 0
  while i < n {
    let (k, _) = self.templates[i]
    if k == name {
      let mut j = i
      while j + 1 < n {
        self.templates[j] = self.templates[j + 1]
        j = j + 1
      }
      let _ = self.templates.pop()
      return
    }
    i = i + 1
  }
}

///| Remove a registered partial if present.
pub fn Registry::unregister_partial(self : Registry, name : String) -> Unit {
  let n = self.partials.length()
  let mut i = 0
  while i < n {
    let (k, _) = self.partials[i]
    if k == name {
      let mut j = i
      while j + 1 < n {
        self.partials[j] = self.partials[j + 1]
        j = j + 1
      }
      let _ = self.partials.pop()
      return
    }
    i = i + 1
  }
}

///| Remove a registered custom helper if present.
pub fn Registry::unregister_helper(self : Registry, name : String) -> Unit {
  let n = self.helpers.length()
  let mut i = 0
  while i < n {
    let (k, _) = self.helpers[i]
    if k == name {
      let mut j = i
      while j + 1 < n {
        self.helpers[j] = self.helpers[j + 1]
        j = j + 1
      }
      let _ = self.helpers.pop()
      return
    }
    i = i + 1
  }
}

///| Pre-compile a template string using this registry's limits.
pub fn Registry::compile(
  self : Registry,
  source : String,
) -> Result[Template, HandlebarsError] {
  let _ = self
  let _ = source
  Err(
    HandlebarsError::new(
      ErrorKind::SyntaxError,
      "not implemented",
      None,
      0,
      0,
    ),
  )
}

///| Render a registered template by name.
pub fn Registry::render(
  self : Registry,
  name : String,
  data : Value,
) -> Result[String, HandlebarsError] {
  let _ = self
  let _ = data
  Err(
    HandlebarsError::new(
      ErrorKind::TemplateNotFound,
      "not implemented",
      Some(name),
      0,
      0,
    ),
  )
}

///| Compile and render a template string in one step.
pub fn Registry::render_template(
  self : Registry,
  source : String,
  data : Value,
) -> Result[String, HandlebarsError] {
  let _ = self
  let _ = source
  let _ = data
  Err(
    HandlebarsError::new(
      ErrorKind::SyntaxError,
      "not implemented",
      None,
      0,
      0,
    ),
  )
}

///| Render a pre-compiled `Template` handle.
pub fn Registry::render_compiled(
  self : Registry,
  tmpl : Template,
  data : Value,
) -> Result[String, HandlebarsError] {
  let _ = self
  let _ = tmpl
  let _ = data
  Err(
    HandlebarsError::new(
      ErrorKind::SyntaxError,
      "not implemented",
      tmpl.name,
      0,
      0,
    ),
  )
}

///| Render a registered template with a JSON/JSON5 string as data.
pub fn Registry::render_json(
  self : Registry,
  name : String,
  json_src : String,
) -> Result[String, HandlebarsError] {
  match Value::from_json(json_src) {
    Ok(v) => self.render(name, v)
    Err(e) => Err(e)
  }
}

///| Compile and render a template string with a JSON/JSON5 string as data.
pub fn Registry::render_template_json(
  self : Registry,
  source : String,
  json_src : String,
) -> Result[String, HandlebarsError] {
  match Value::from_json(json_src) {
    Ok(v) => self.render_template(source, v)
    Err(e) => Err(e)
  }
}

///| Standalone convenience: compile a template string with default limits.
pub fn compile(source : String) -> Result[Template, HandlebarsError] {
  Registry::new().compile(source)
}

///| Standalone convenience: compile and render a template string with default registry.
pub fn render(source : String, data : Value) -> Result[String, HandlebarsError] {
  Registry::new().render_template(source, data)
}

///| Standalone convenience: compile and render a template string with JSON/JSON5 data.
pub fn render_json(
  source : String,
  json_src : String,
) -> Result[String, HandlebarsError] {
  Registry::new().render_template_json(source, json_src)
}

///| Escape HTML special characters matching Handlebars.js `escapeExpression`:
///| `&`, `<`, `>`, `"`, `'`, `` ` ``, `=`.
pub fn escape_html(s : String) -> String {
  s
}
