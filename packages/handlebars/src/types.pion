///| Core public types for `handlebars` (Handlebars 4.x + Mustache 1.4.2 engine).

import "json5"

///| Categorized error kinds for compilation, rendering, and security limits.
pub enum ErrorKind {
  SyntaxError
  UnclosedTag
  UnclosedBlock
  MismatchedBlock
  InvalidPath
  InvalidDelimiter
  TemplateNotFound
  PartialNotFound
  HelperNotFound
  HelperError
  StrictUndefined
  DepthLimitExceeded
  PartialDepthLimitExceeded
  StepLimitExceeded
  OutputLimitExceeded
  TemplateSizeLimitExceeded
  JsonError
}

///| Convert an `ErrorKind` to a stable string name.
pub fn error_kind_as_str(kind : ErrorKind) -> String {
  match kind {
    ErrorKind::SyntaxError => "SyntaxError"
    ErrorKind::UnclosedTag => "UnclosedTag"
    ErrorKind::UnclosedBlock => "UnclosedBlock"
    ErrorKind::MismatchedBlock => "MismatchedBlock"
    ErrorKind::InvalidPath => "InvalidPath"
    ErrorKind::InvalidDelimiter => "InvalidDelimiter"
    ErrorKind::TemplateNotFound => "TemplateNotFound"
    ErrorKind::PartialNotFound => "PartialNotFound"
    ErrorKind::HelperNotFound => "HelperNotFound"
    ErrorKind::HelperError => "HelperError"
    ErrorKind::StrictUndefined => "StrictUndefined"
    ErrorKind::DepthLimitExceeded => "DepthLimitExceeded"
    ErrorKind::PartialDepthLimitExceeded => "PartialDepthLimitExceeded"
    ErrorKind::StepLimitExceeded => "StepLimitExceeded"
    ErrorKind::OutputLimitExceeded => "OutputLimitExceeded"
    ErrorKind::TemplateSizeLimitExceeded => "TemplateSizeLimitExceeded"
    ErrorKind::JsonError => "JsonError"
  }
}

///| Compare two `ErrorKind` values for equality.
pub fn error_kind_eq(a : ErrorKind, b : ErrorKind) -> Bool {
  error_kind_as_str(a) == error_kind_as_str(b)
}

///| Structured error with optional template name and 1-based line/column location.
pub struct HandlebarsError {
  pub kind : ErrorKind
  pub message : String
  pub template_name : Option[String]
  pub line : Int
  pub col : Int
}

///| Construct a `HandlebarsError`.
pub fn HandlebarsError::new(
  kind : ErrorKind,
  message : String,
  template_name : Option[String],
  line : Int,
  col : Int,
) -> HandlebarsError {
  HandlebarsError::{
    kind: kind,
    message: message,
    template_name: template_name,
    line: line,
    col: col,
  }
}

///| Return true if this error has the expected `ErrorKind`.
pub fn HandlebarsError::is_kind(
  self : HandlebarsError,
  expected : ErrorKind,
) -> Bool {
  error_kind_eq(self.kind, expected)
}

///| Format the error for display.
pub fn HandlebarsError::to_string(self : HandlebarsError) -> String {
  let sb = StringBuilder::new()
  sb.write_string(error_kind_as_str(self.kind))
  match self.template_name {
    Some(name) => {
      sb.write_string(" in ")
      sb.write_string(name)
    }
    None => ()
  }
  if self.line > 0 {
    sb.write_string(" (line ")
    sb.write_string(self.line.to_string())
    if self.col > 0 {
      sb.write_string(", col ")
      sb.write_string(self.col.to_string())
    }
    sb.write_string(")")
  }
  sb.write_string(": ")
  sb.write_string(self.message)
  sb.to_string()
}

///| Explicit resource and DoS protection limits for compilation and rendering.
pub struct HandlebarsLimits {
  pub max_depth : Int
  pub max_partial_depth : Int
  pub max_steps : Int64
  pub max_output_bytes : Int
  pub max_template_bytes : Int
}

///| Default security limits safe for untrusted templates on Native and Wasm32.
pub fn HandlebarsLimits::default() -> HandlebarsLimits {
  HandlebarsLimits::{
    max_depth: 64,
    max_partial_depth: 32,
    max_steps: 10000000L,
    max_output_bytes: 16777216,
    max_template_bytes: 4194304,
  }
}

///| Dynamic template data value.
///| `Object` preserves key insertion order for deterministic `{{#each}}` iteration.
pub enum Value {
  Null
  Bool(Bool)
  Int(Int64)
  Float(Double)
  Str(String)
  SafeStr(String)
  Array(Array[Value])
  Object(Array[(String, Value)])
}

///| Construct `Value::Null`.
pub fn Value::null() -> Value {
  Value::Null
}

///| Construct `Value::Bool`.
pub fn Value::bool(b : Bool) -> Value {
  Value::Bool(b)
}

///| Construct `Value::Int` from `Int`.
pub fn Value::int(n : Int) -> Value {
  Value::Int(n.to_int64())
}

///| Construct `Value::Int` from `Int64`.
pub fn Value::i64(n : Int64) -> Value {
  Value::Int(n)
}

///| Construct `Value::Float`.
pub fn Value::float(f : Double) -> Value {
  Value::Float(f)
}

///| Construct `Value::Str`.
pub fn Value::string(s : String) -> Value {
  Value::Str(s)
}

///| Construct `Value::SafeStr` (bypasses HTML escaping in `{{...}}`).
pub fn Value::safe_string(s : String) -> Value {
  Value::SafeStr(s)
}

///| Construct `Value::Array`.
pub fn Value::array(items : Array[Value]) -> Value {
  Value::Array(items)
}

///| Construct `Value::Object`.
pub fn Value::object(entries : Array[(String, Value)]) -> Value {
  Value::Object(entries)
}

///| Convert a `json5::Json5Value` into a `Value`.
pub fn Value::from_json5(v : json5::Json5Value) -> Value {
  match v {
    json5::Json5Value::Null => Value::Null
    json5::Json5Value::Bool(b) => Value::Bool(b)
    json5::Json5Value::Number(f) => {
      // Preserve integer JSON numbers as Value::Int for clean rendering (`3` not `3.0`).
      if f == f && (f - f) == 0.0 && f >= -9007199254740992.0 && f <= 9007199254740992.0 {
        let i = f.to_int64()
        if i.to_double() == f {
          // Avoid converting -0.0 to Int if needed; 0.0 -> 0
          return Value::Int(i)
        }
      }
      Value::Float(f)
    }
    json5::Json5Value::Str(s) => Value::Str(s)
    json5::Json5Value::Array(items) => {
      let out : Array[Value] = []
      let mut i = 0
      while i < items.length() {
        out.push(Value::from_json5(items[i]))
        i = i + 1
      }
      Value::Array(out)
    }
    json5::Json5Value::Object(entries) => {
      let out : Array[(String, Value)] = []
      let mut i = 0
      while i < entries.length() {
        let (k, entry_v) = entries[i]
        out.push((k, Value::from_json5(entry_v)))
        i = i + 1
      }
      Value::Object(out)
    }
  }
}

///| Parse a JSON/JSON5 string into a `Value`.
pub fn Value::from_json(src : String) -> Result[Value, HandlebarsError] {
  match json5::parse(src) {
    Ok(v) => Ok(Value::from_json5(v))
    Err(e) =>
    Err(
      HandlebarsError::new(
        ErrorKind::JsonError,
        e.message,
        None,
        e.line,
        e.col,
      ),
    )
  }
}

///| Context passed to a custom helper callback.
pub struct HelperContext {
  pub name : String
  pub params : Array[Value]
  pub hash : Array[(String, Value)]
  pub this_val : Value
  pub root : Value
  pub is_block : Bool
  pub has_inverse : Bool
  render_fn : (Value) -> Result[String, HandlebarsError]
  render_inverse : (Value) -> Result[String, HandlebarsError]
  data_lookup : (String) -> Option[Value]
}

///| Get positional parameter by 0-based index.
pub fn HelperContext::param(self : HelperContext, idx : Int) -> Option[Value] {
  if idx >= 0 && idx < self.params.length() {
    Some(self.params[idx])
  } else {
    None
  }
}

///| Get named hash parameter by key.
pub fn HelperContext::hash_get(
  self : HelperContext,
  key : String,
) -> Option[Value] {
  let mut i = self.hash.length() - 1
  while i >= 0 {
    let (k, v) = self.hash[i]
    if k == key {
      return Some(v)
    }
    i = i - 1
  }
  None
}

///| Look up a `@data` variable from the active data frame stack.
pub fn HelperContext::data_get(
  self : HelperContext,
  key : String,
) -> Option[Value] {
  let f = self.data_lookup
  f(key)
}

///| Render the primary block body with the given context value.
pub fn HelperContext::fn_render(
  self : HelperContext,
  ctx : Value,
) -> Result[String, HandlebarsError] {
  let f = self.render_fn
  f(ctx)
}

///| Render the `{{else}}` / inverse block body with the given context value.
pub fn HelperContext::inverse_render(
  self : HelperContext,
  ctx : Value,
) -> Result[String, HandlebarsError] {
  let f = self.render_inverse
  f(ctx)
}

///| Pre-compiled template AST handle.
pub struct Template {
  pub name : Option[String]
  nodes : Array[Node]
}

///| Handlebars + Mustache template registry holding compiled templates, partials, helpers, and options.
pub struct Registry {
  mut strict_mode : Bool
  mut no_escape : Bool
  mut limits : HandlebarsLimits
  templates : Array[(String, Template)]
  partials : Array[(String, Template)]
  helpers : Array[(String, (HelperContext) -> Result[Value, HandlebarsError])]
}
