///| Lexer, whitespace processor (Mustache standalone + Handlebars `~`),
///| expression parser, and AST builder for Handlebars 4.x + Mustache 1.4.2.

fn str_slice(s : String, start : Int, end : Int) -> String {
  if start >= end {
    return ""
  }
  if start == 0 && end == s.length() {
    return s
  }
  let sb = StringBuilder::with_capacity(end - start)
  sb.write_substring(s, start, end)
  sb.to_string()
}

fn is_ascii_ws(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 13
}

fn is_hws(b : Int) -> Bool {
  b == 32 || b == 9
}

fn is_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn trim_ws(s : String) -> String {
  let n = s.length()
  let mut a = 0
  while a < n && is_ascii_ws(s.code_unit_at(a)) {
    a = a + 1
  }
  let mut b = n
  while b > a && is_ascii_ws(s.code_unit_at(b - 1)) {
    b = b - 1
  }
  str_slice(s, a, b)
}

fn trim_right_ws(s : String) -> String {
  let mut b = s.length()
  while b > 0 && is_ascii_ws(s.code_unit_at(b - 1)) {
    b = b - 1
  }
  str_slice(s, 0, b)
}

fn trim_left_ws(s : String) -> String {
  let n = s.length()
  let mut a = 0
  while a < n && is_ascii_ws(s.code_unit_at(a)) {
    a = a + 1
  }
  str_slice(s, a, n)
}

fn matches_at(s : String, pos : Int, pat : String) -> Bool {
  let plen = pat.length()
  if pos + plen > s.length() {
    return false
  }
  let mut i = 0
  while i < plen {
    if s.code_unit_at(pos + i) != pat.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn starts_with(s : String, pat : String) -> Bool {
  matches_at(s, 0, pat)
}

enum RawTokKind {
  Text(String)
  Mustache(String, Bool) // content, escaped
  BlockOpen(String, Bool) // content, inverted
  InlinePartialOpen(String)
  PartialBlockOpen(String)
  BlockClose(String)
  Else(String) // "" for plain else, or "if ..." for chained else-if
  Partial(String)
  Comment
  DelimChange
  RawBlock(String)
}

struct RawToken {
  mut kind : RawTokKind
  start : Int
  end : Int
  line : Int
  col : Int
  strip_left : Bool
  strip_right : Bool
  standalone_eligible : Bool
  mut indent : String
}

fn find_tag_close(
  src : String,
  from : Int,
  close_delim : String,
  allow_quotes : Bool,
) -> Int {
  let n = src.length()
  let mut i = from
  while i < n {
    if allow_quotes {
      let b = src.code_unit_at(i)
      if b == 34 || b == 39 {
        // String literal "..." or '...'
        let quote = b
        i = i + 1
        while i < n {
          let c = src.code_unit_at(i)
          if c == 92 && i + 1 < n {
            i = i + 2
            continue
          }
          if c == quote {
            i = i + 1
            break
          }
          i = i + 1
        }
        continue
      }
      if b == 91 {
        // Bracket path segment [...]
        i = i + 1
        while i < n {
          let c = src.code_unit_at(i)
          if c == 92 && i + 1 < n {
            i = i + 2
            continue
          }
          if c == 93 {
            i = i + 1
            break
          }
          i = i + 1
        }
        continue
      }
    }
    if matches_at(src, i, close_delim) {
      return i
    }
    i = i + 1
  }
  -1
}

fn flush_text(
  tokens : Array[RawToken],
  src : String,
  t_start : Int,
  t_end : Int,
  t_line : Int,
  t_col : Int,
) -> Unit {
  if t_end > t_start {
    tokens.push(
      RawToken::{
        kind: RawTokKind::Text(str_slice(src, t_start, t_end)),
        start: t_start,
        end: t_end,
        line: t_line,
        col: t_col,
        strip_left: false,
        strip_right: false,
        standalone_eligible: false,
        indent: "",
      },
    )
  }
}

fn advance_pos(
  src : String,
  from : Int,
  to : Int,
  cur_line : Int,
  cur_col : Int,
) -> (Int, Int) {
  let mut l = cur_line
  let mut c = cur_col
  let mut k = from
  while k < to {
    if src.code_unit_at(k) == 10 {
      l = l + 1
      c = 1
    } else {
      c = c + 1
    }
    k = k + 1
  }
  (l, c)
}

fn tokenize(
  src : String,
  tmpl_name : Option[String],
) -> Result[Array[RawToken], HandlebarsError] {
  let tokens : Array[RawToken] = []
  let n = src.length()
  let mut open_delim = "{{"
  let mut close_delim = "}}"
  let mut i = 0
  let mut line = 1
  let mut col = 1
  let mut text_start = 0
  let mut text_line = 1
  let mut text_col = 1

  while i < n {
    let is_default = open_delim == "{{" && close_delim == "}}"
    // Handle escaped mustaches `\{{` and `\\{{` when using default delimiters
    if is_default && src.code_unit_at(i) == 92 {
      if matches_at(src, i + 1, "{{") {
        flush_text(tokens, src, text_start, i, text_line, text_col)
        tokens.push(
          RawToken::{
            kind: RawTokKind::Text("{{"),
            start: i,
            end: i + 3,
            line: line,
            col: col,
            strip_left: false,
            strip_right: false,
            standalone_eligible: false,
            indent: "",
          },
        )
        let (nl, nc) = advance_pos(src, i, i + 3, line, col)
        line = nl
        col = nc
        i = i + 3
        text_start = i
        text_line = line
        text_col = col
        continue
      }
      if i + 1 < n && src.code_unit_at(i + 1) == 92 && matches_at(src, i + 2, "{{") {
        flush_text(tokens, src, text_start, i, text_line, text_col)
        tokens.push(
          RawToken::{
            kind: RawTokKind::Text("\\"),
            start: i,
            end: i + 2,
            line: line,
            col: col,
            strip_left: false,
            strip_right: false,
            standalone_eligible: false,
            indent: "",
          },
        )
        let (nl, nc) = advance_pos(src, i, i + 2, line, col)
        line = nl
        col = nc
        i = i + 2
        text_start = i
        text_line = line
        text_col = col
        continue
      }
    }

    // Raw block `{{{{name}}}}...{{{{/name}}}}`
    if is_default && matches_at(src, i, "{{{{") {
      flush_text(tokens, src, text_start, i, text_line, text_col)
      let tag_start = i
      let tag_line = line
      let tag_col = col
      let open_end = find_tag_close(src, i + 4, "}}}}", false)
      if open_end < 0 {
        return Err(
          HandlebarsError::new(
            ErrorKind::UnclosedTag,
            "unclosed raw block open tag `{{{{`",
            tmpl_name,
            tag_line,
            tag_col,
          ),
        )
      }
      let raw_name = trim_ws(str_slice(src, i + 4, open_end))
      if raw_name.length() == 0 {
        return Err(
          HandlebarsError::new(
            ErrorKind::SyntaxError,
            "empty raw block name",
            tmpl_name,
            tag_line,
            tag_col,
          ),
        )
      }
      let body_start = open_end + 4
      let close_pat = "{{{{/" + raw_name + "}}}}"
      let close_pos = find_tag_close(src, body_start, close_pat, false)
      if close_pos < 0 {
        return Err(
          HandlebarsError::new(
            ErrorKind::UnclosedBlock,
            "unclosed raw block `{{{{" + raw_name + "}}}}`",
            tmpl_name,
            tag_line,
            tag_col,
          ),
        )
      }
      let body_str = str_slice(src, body_start, close_pos)
      let tag_end = close_pos + close_pat.length()
      tokens.push(
        RawToken::{
          kind: RawTokKind::RawBlock(body_str),
          start: tag_start,
          end: tag_end,
          line: tag_line,
          col: tag_col,
          strip_left: false,
          strip_right: false,
          standalone_eligible: false,
          indent: "",
        },
      )
      let (nl, nc) = advance_pos(src, i, tag_end, line, col)
      line = nl
      col = nc
      i = tag_end
      text_start = i
      text_line = line
      text_col = col
      continue
    }

    // Check open delimiter
    if matches_at(src, i, open_delim) {
      flush_text(tokens, src, text_start, i, text_line, text_col)
      let tag_start = i
      let tag_line = line
      let tag_col = col
      let after_open = i + open_delim.length()

      // Triple mustache `{{{...}}}` when default delimiters
      if is_default && after_open < n && src.code_unit_at(after_open) == 123 {
        let mut content_start = after_open + 1
        let mut strip_l = false
        if content_start < n && src.code_unit_at(content_start) == 126 {
          strip_l = true
          content_start = content_start + 1
        }
        let close_pos = find_tag_close(src, content_start, "}}}", true)
        if close_pos < 0 {
          return Err(
            HandlebarsError::new(
              ErrorKind::UnclosedTag,
              "unclosed triple mustache `{{{`",
              tmpl_name,
              tag_line,
              tag_col,
            ),
          )
        }
        let mut content_end = close_pos
        let mut strip_r = false
        if content_end > content_start && src.code_unit_at(content_end - 1) == 126 {
          strip_r = true
          content_end = content_end - 1
        }
        let inner = trim_ws(str_slice(src, content_start, content_end))
        let tag_end = close_pos + 3
        tokens.push(
          RawToken::{
            kind: RawTokKind::Mustache(inner, false),
            start: tag_start,
            end: tag_end,
            line: tag_line,
            col: tag_col,
            strip_left: strip_l,
            strip_right: strip_r,
            standalone_eligible: false,
            indent: "",
          },
        )
        let (nl, nc) = advance_pos(src, i, tag_end, line, col)
        line = nl
        col = nc
        i = tag_end
        text_start = i
        text_line = line
        text_col = col
        continue
      }

      // Check optional leading `~`
      let mut content_start = after_open
      let mut strip_l = false
      if content_start < n && src.code_unit_at(content_start) == 126 {
        strip_l = true
        content_start = content_start + 1
      }

      // Block comment `{{!-- ... --}}`
      if matches_at(src, content_start, "!--") {
        let mut scan = content_start + 3
        let mut found_end = -1
        let mut strip_r = false
        while scan < n {
          if matches_at(src, scan, "--") {
            let after_dash = scan + 2
            if after_dash < n &&
            src.code_unit_at(after_dash) == 126 &&
            matches_at(src, after_dash + 1, close_delim) {
              strip_r = true
              found_end = after_dash + 1 + close_delim.length()
              break
            }
            if matches_at(src, after_dash, close_delim) {
              found_end = after_dash + close_delim.length()
              break
            }
          }
          scan = scan + 1
        }
        if found_end < 0 {
          return Err(
            HandlebarsError::new(
              ErrorKind::UnclosedTag,
              "unclosed block comment `{{!--`",
              tmpl_name,
              tag_line,
              tag_col,
            ),
          )
        }
        tokens.push(
          RawToken::{
            kind: RawTokKind::Comment,
            start: tag_start,
            end: found_end,
            line: tag_line,
            col: tag_col,
            strip_left: strip_l,
            strip_right: strip_r,
            standalone_eligible: true,
            indent: "",
          },
        )
        let (nl, nc) = advance_pos(src, i, found_end, line, col)
        line = nl
        col = nc
        i = found_end
        text_start = i
        text_line = line
        text_col = col
        continue
      }

      // Regular comment `{{! ... }}`
      if content_start < n && src.code_unit_at(content_start) == 33 {
        let close_pos = find_tag_close(src, content_start + 1, close_delim, false)
        if close_pos < 0 {
          return Err(
            HandlebarsError::new(
              ErrorKind::UnclosedTag,
              "unclosed comment tag",
              tmpl_name,
              tag_line,
              tag_col,
            ),
          )
        }
        let strip_r = close_pos > content_start + 1 &&
        src.code_unit_at(close_pos - 1) == 126
        let tag_end = close_pos + close_delim.length()
        tokens.push(
          RawToken::{
            kind: RawTokKind::Comment,
            start: tag_start,
            end: tag_end,
            line: tag_line,
            col: tag_col,
            strip_left: strip_l,
            strip_right: strip_r,
            standalone_eligible: true,
            indent: "",
          },
        )
        let (nl, nc) = advance_pos(src, i, tag_end, line, col)
        line = nl
        col = nc
        i = tag_end
        text_start = i
        text_line = line
        text_col = col
        continue
      }

      // Mustache delimiter change `{{=<% %>=}}`
      if !strip_l && content_start < n && src.code_unit_at(content_start) == 61 {
        let close_pat = "=" + close_delim
        let close_pos = find_tag_close(src, content_start + 1, close_pat, false)
        if close_pos < 0 {
          return Err(
            HandlebarsError::new(
              ErrorKind::InvalidDelimiter,
              "unclosed delimiter change tag",
              tmpl_name,
              tag_line,
              tag_col,
            ),
          )
        }
        let body = trim_ws(str_slice(src, content_start + 1, close_pos))
        // Split body into exactly two whitespace-separated non-empty tokens with no `=`
        let parts : Array[String] = []
        let mut p = 0
        let blen = body.length()
        while p < blen {
          while p < blen && is_ascii_ws(body.code_unit_at(p)) {
            p = p + 1
          }
          if p >= blen {
            break
          }
          let s0 = p
          while p < blen && !is_ascii_ws(body.code_unit_at(p)) {
            if body.code_unit_at(p) == 61 {
              return Err(
                HandlebarsError::new(
                  ErrorKind::InvalidDelimiter,
                  "delimiter cannot contain `=`",
                  tmpl_name,
                  tag_line,
                  tag_col,
                ),
              )
            }
            p = p + 1
          }
          parts.push(str_slice(body, s0, p))
        }
        if parts.length() != 2 {
          return Err(
            HandlebarsError::new(
              ErrorKind::InvalidDelimiter,
              "delimiter tag must specify exactly two delimiters",
              tmpl_name,
              tag_line,
              tag_col,
            ),
          )
        }
        open_delim = parts[0]
        close_delim = parts[1]
        let tag_end = close_pos + close_pat.length()
        tokens.push(
          RawToken::{
            kind: RawTokKind::DelimChange,
            start: tag_start,
            end: tag_end,
            line: tag_line,
            col: tag_col,
            strip_left: false,
            strip_right: false,
            standalone_eligible: true,
            indent: "",
          },
        )
        let (nl, nc) = advance_pos(src, i, tag_end, line, col)
        line = nl
        col = nc
        i = tag_end
        text_start = i
        text_line = line
        text_col = col
        continue
      }

      // Standard tag `{{...}}`
      let close_pos = find_tag_close(src, content_start, close_delim, true)
      if close_pos < 0 {
        return Err(
          HandlebarsError::new(
            ErrorKind::UnclosedTag,
            "unclosed tag `" + open_delim + "`",
            tmpl_name,
            tag_line,
            tag_col,
          ),
        )
      }
      let mut content_end = close_pos
      let mut strip_r = false
      if content_end > content_start && src.code_unit_at(content_end - 1) == 126 {
        strip_r = true
        content_end = content_end - 1
      }
      let inner = trim_ws(str_slice(src, content_start, content_end))
      let tag_end = close_pos + close_delim.length()
      if inner.length() == 0 {
        return Err(
          HandlebarsError::new(
            ErrorKind::SyntaxError,
            "empty mustache tag",
            tmpl_name,
            tag_line,
            tag_col,
          ),
        )
      }
      let first_b = inner.code_unit_at(0)
      let (tok_kind, eligible) = if first_b == 38 {
        // `&` unescaped
        (RawTokKind::Mustache(trim_ws(str_slice(inner, 1, inner.length())), false), false)
      } else if starts_with(inner, "#*") {
        (RawTokKind::InlinePartialOpen(trim_ws(str_slice(inner, 2, inner.length()))), true)
      } else if starts_with(inner, "#>") {
        (RawTokKind::PartialBlockOpen(trim_ws(str_slice(inner, 2, inner.length()))), true)
      } else if first_b == 35 {
        // `#` block open
        (RawTokKind::BlockOpen(trim_ws(str_slice(inner, 1, inner.length())), false), true)
      } else if first_b == 94 {
        // `^` inverted block or else shorthand
        let rest = trim_ws(str_slice(inner, 1, inner.length()))
        if rest.length() == 0 {
          (RawTokKind::Else(""), true)
        } else {
          (RawTokKind::BlockOpen(rest, true), true)
        }
      } else if first_b == 47 {
        // `/` block close
        (RawTokKind::BlockClose(trim_ws(str_slice(inner, 1, inner.length()))), true)
      } else if first_b == 62 {
        // `>` partial
        (RawTokKind::Partial(trim_ws(str_slice(inner, 1, inner.length()))), true)
      } else if inner == "else" {
        (RawTokKind::Else(""), true)
      } else if starts_with(inner, "else") &&
      inner.length() > 4 &&
      is_ascii_ws(inner.code_unit_at(4)) {
        (RawTokKind::Else(trim_ws(str_slice(inner, 4, inner.length()))), true)
      } else {
        (RawTokKind::Mustache(inner, true), false)
      }
      tokens.push(
        RawToken::{
          kind: tok_kind,
          start: tag_start,
          end: tag_end,
          line: tag_line,
          col: tag_col,
          strip_left: strip_l,
          strip_right: strip_r,
          standalone_eligible: eligible,
          indent: "",
        },
      )
      let (nl, nc) = advance_pos(src, i, tag_end, line, col)
      line = nl
      col = nc
      i = tag_end
      text_start = i
      text_line = line
      text_col = col
      continue
    }

    if src.code_unit_at(i) == 10 {
      line = line + 1
      col = 1
    } else {
      col = col + 1
    }
    i = i + 1
  }

  flush_text(tokens, src, text_start, n, text_line, text_col)
  Ok(tokens)
}

///| Apply Mustache standalone-line stripping and Handlebars `~` whitespace control.
fn apply_whitespace_control(src : String, tokens : Array[RawToken]) -> Unit {
  let n = src.length()
  let tlen = tokens.length()

  // Pass 1: Mustache standalone lines
  let mut i = 0
  while i < tlen {
    let tok = tokens[i]
    if tok.standalone_eligible {
      // Check backwards from tok.start to start of line (previous `\n` or 0)
      let mut ls = tok.start
      let mut left_ok = true
      while ls > 0 {
        let b = src.code_unit_at(ls - 1)
        if b == 10 {
          break
        }
        if !is_hws(b) {
          left_ok = false
          break
        }
        ls = ls - 1
      }
      // Check forwards from tok.end to `\r\n`, `\n`, or EOF
      let mut re = tok.end
      let mut right_ok = true
      let mut nl_len = 0
      while re < n {
        let b = src.code_unit_at(re)
        if b == 10 {
          nl_len = 1
          break
        }
        if b == 13 && re + 1 < n && src.code_unit_at(re + 1) == 10 {
          nl_len = 2
          break
        }
        if !is_hws(b) {
          right_ok = false
          break
        }
        re = re + 1
      }
      if left_ok && right_ok {
        let lead_len = tok.start - ls
        let trail_len = (re - tok.end) + nl_len
        // Capture indentation for standalone partials
        match tok.kind {
          RawTokKind::Partial(_) =>
          if lead_len > 0 {
            tok.indent = str_slice(src, ls, tok.start)
          }
          _ => ()
        }
        // Trim leading horizontal whitespace from previous Text token
        if lead_len > 0 && i > 0 {
          match tokens[i - 1].kind {
            RawTokKind::Text(prev_s) => {
              let plen = prev_s.length()
              let cut = if lead_len <= plen { plen - lead_len } else { 0 }
              tokens[i - 1].kind = RawTokKind::Text(str_slice(prev_s, 0, cut))
            }
            _ => ()
          }
        }
        // Trim trailing horizontal whitespace + newline from next Text token
        if trail_len > 0 && i + 1 < tlen {
          match tokens[i + 1].kind {
            RawTokKind::Text(next_s) => {
              let nlen = next_s.length()
              let cut = if trail_len <= nlen { trail_len } else { nlen }
              tokens[i + 1].kind = RawTokKind::Text(str_slice(next_s, cut, nlen))
            }
            _ => ()
          }
        }
      }
    }
    i = i + 1
  }

  // Pass 2: Handlebars tilde (`~`) whitespace stripping
  i = 0
  while i < tlen {
    let tok = tokens[i]
    if tok.strip_left && i > 0 {
      match tokens[i - 1].kind {
        RawTokKind::Text(prev_s) =>
        tokens[i - 1].kind = RawTokKind::Text(trim_right_ws(prev_s))
        _ => ()
      }
    }
    if tok.strip_right && i + 1 < tlen {
      match tokens[i + 1].kind {
        RawTokKind::Text(next_s) =>
        tokens[i + 1].kind = RawTokKind::Text(trim_left_ws(next_s))
        _ => ()
      }
    }
    i = i + 1
  }
}

///| Cursor for parsing expressions inside a tag.
struct ExprCursor {
  src : String
  mut pos : Int
  tmpl_name : Option[String]
  line : Int
  col : Int
  max_depth : Int
}

fn ExprCursor::skip_ws(self : ExprCursor) -> Unit {
  let n = self.src.length()
  while self.pos < n && is_ascii_ws(self.src.code_unit_at(self.pos)) {
    self.pos = self.pos + 1
  }
}

fn ExprCursor::eof(self : ExprCursor) -> Bool {
  self.skip_ws()
  self.pos >= self.src.length()
}

fn ExprCursor::peek(self : ExprCursor) -> Int {
  if self.pos < self.src.length() {
    self.src.code_unit_at(self.pos)
  } else {
    -1
  }
}

fn ExprCursor::err(
  self : ExprCursor,
  kind : ErrorKind,
  msg : String,
) -> HandlebarsError {
  HandlebarsError::new(kind, msg, self.tmpl_name, self.line, self.col)
}

fn parse_string_lit(cur : ExprCursor) -> Result[String, HandlebarsError] {
  let quote = cur.peek()
  cur.pos = cur.pos + 1
  let n = cur.src.length()
  let sb = StringBuilder::new()
  while cur.pos < n {
    let b = cur.src.code_unit_at(cur.pos)
    if b == 92 && cur.pos + 1 < n {
      let next = cur.src.code_unit_at(cur.pos + 1)
      if next == 110 {
        sb.write_byte((10).to_byte())
      } else if next == 114 {
        sb.write_byte((13).to_byte())
      } else if next == 116 {
        sb.write_byte((9).to_byte())
      } else {
        sb.write_byte(next.to_byte())
      }
      cur.pos = cur.pos + 2
      continue
    }
    if b == quote {
      cur.pos = cur.pos + 1
      return Ok(sb.to_string())
    }
    sb.write_byte(b.to_byte())
    cur.pos = cur.pos + 1
  }
  Err(cur.err(ErrorKind::SyntaxError, "unterminated string literal"))
}

fn is_path_term(b : Int) -> Bool {
  b < 0 ||
  is_ascii_ws(b) ||
  b == 41 || // )
  b == 40 || // (
  b == 61 || // =
  b == 124 // |
}

fn parse_bracket_segment(cur : ExprCursor) -> Result[String, HandlebarsError] {
  // Consumes `[` ... `]`
  cur.pos = cur.pos + 1
  let n = cur.src.length()
  let sb = StringBuilder::new()
  while cur.pos < n {
    let b = cur.src.code_unit_at(cur.pos)
    if b == 92 && cur.pos + 1 < n {
      sb.write_byte(cur.src.code_unit_at(cur.pos + 1).to_byte())
      cur.pos = cur.pos + 2
      continue
    }
    if b == 93 {
      cur.pos = cur.pos + 1
      return Ok(sb.to_string())
    }
    sb.write_byte(b.to_byte())
    cur.pos = cur.pos + 1
  }
  Err(cur.err(ErrorKind::InvalidPath, "unterminated `[` path segment"))
}

fn parse_number_or_path(cur : ExprCursor) -> Result[Expr, HandlebarsError] {
  let start = cur.pos
  let n = cur.src.length()
  // Check number literal: optional `-`, digits, optional `.digits`
  let mut p = start
  if p < n && cur.src.code_unit_at(p) == 45 {
    p = p + 1
  }
  if p < n && is_digit(cur.src.code_unit_at(p)) {
    let mut is_float = false
    while p < n && is_digit(cur.src.code_unit_at(p)) {
      p = p + 1
    }
    if p < n && cur.src.code_unit_at(p) == 46 && p + 1 < n && is_digit(cur.src.code_unit_at(p + 1)) {
      is_float = true
      p = p + 1
      while p < n && is_digit(cur.src.code_unit_at(p)) {
        p = p + 1
      }
    }
    if p >= n || is_path_term(cur.src.code_unit_at(p)) {
      let num_str = str_slice(cur.src, start, p)
      cur.pos = p
      if is_float {
        match json5::parse(num_str) {
          Ok(json5::Json5Value::Number(f)) => return Ok(Expr::FloatLit(f))
          _ =>
          return Err(cur.err(ErrorKind::SyntaxError, "invalid float literal"))
        }
      } else {
        match parse_i64_decimal(num_str) {
          Some(v) => return Ok(Expr::IntLit(v))
          None =>
          return Err(cur.err(ErrorKind::SyntaxError, "invalid integer literal"))
        }
      }
    }
  }
  parse_path_expr(cur)
}

fn parse_i64_decimal(s : String) -> Option[Int64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  if i >= n {
    return None
  }
  let mut acc = 0L
  while i < n {
    let b = s.code_unit_at(i)
    if !is_digit(b) {
      return None
    }
    acc = acc * 10L + (b - 48).to_int64()
    i = i + 1
  }
  Some(if neg { -acc } else { acc })
}

fn parse_path_expr(cur : ExprCursor) -> Result[Expr, HandlebarsError] {
  let n = cur.src.length()
  let start = cur.pos
  let mut is_data = false
  if cur.pos < n && cur.src.code_unit_at(cur.pos) == 64 {
    is_data = true
    cur.pos = cur.pos + 1
  }
  let mut up_levels = 0
  let mut local_only = false
  // Parse leading `../` and `./`
  while cur.pos < n {
    if matches_at(cur.src, cur.pos, "../") {
      up_levels = up_levels + 1
      cur.pos = cur.pos + 3
    } else if matches_at(cur.src, cur.pos, "./") {
      local_only = true
      cur.pos = cur.pos + 2
    } else {
      break
    }
  }
  // Bare `.`
  if !is_data &&
  up_levels == 0 &&
  cur.pos < n &&
  cur.src.code_unit_at(cur.pos) == 46 &&
  (cur.pos + 1 >= n || is_path_term(cur.src.code_unit_at(cur.pos + 1))) {
    cur.pos = cur.pos + 1
    return Ok(
      Expr::Path(
        PathExpr::{
          is_data: false,
          up_levels: 0,
          local_only: true,
          segments: [],
        },
      ),
    )
  }
  // Bare `..`
  if !is_data &&
  matches_at(cur.src, cur.pos, "..") &&
  (cur.pos + 2 >= n || is_path_term(cur.src.code_unit_at(cur.pos + 2))) {
    cur.pos = cur.pos + 2
    return Ok(
      Expr::Path(
        PathExpr::{
          is_data: false,
          up_levels: up_levels + 1,
          local_only: false,
          segments: [],
        },
      ),
    )
  }

  let segments : Array[String] = []
  let mut first_seg = true
  while cur.pos < n && !is_path_term(cur.src.code_unit_at(cur.pos)) {
    let b = cur.src.code_unit_at(cur.pos)
    if b == 91 {
      match parse_bracket_segment(cur) {
        Ok(seg) => segments.push(seg)
        Err(e) => return Err(e)
      }
    } else {
      let s0 = cur.pos
      while cur.pos < n {
        let c = cur.src.code_unit_at(cur.pos)
        if is_path_term(c) || c == 46 || c == 47 || c == 91 {
          break
        }
        cur.pos = cur.pos + 1
      }
      let seg = str_slice(cur.src, s0, cur.pos)
      if seg.length() == 0 {
        break
      }
      if first_seg && !is_data && up_levels == 0 && seg == "this" {
        local_only = true
      } else {
        segments.push(seg)
      }
    }
    first_seg = false
    if cur.pos < n {
      let sep = cur.src.code_unit_at(cur.pos)
      if sep == 46 || sep == 47 {
        cur.pos = cur.pos + 1
      }
    }
  }

  if !is_data && up_levels == 0 && !local_only && segments.length() == 1 {
    let seg = segments[0]
    // Check boolean / null / undefined literals (only if not bracketed)
    if cur.src.code_unit_at(start) != 91 {
      if seg == "true" {
        return Ok(Expr::BoolLit(true))
      }
      if seg == "false" {
        return Ok(Expr::BoolLit(false))
      }
      if seg == "null" || seg == "undefined" {
        return Ok(Expr::NullLit)
      }
    }
  }

  if !is_data && up_levels == 0 && !local_only && segments.length() == 0 {
    return Err(cur.err(ErrorKind::InvalidPath, "expected expression or path"))
  }

  Ok(
    Expr::Path(
      PathExpr::{
        is_data: is_data,
        up_levels: up_levels,
        local_only: local_only,
        segments: segments,
      },
    ),
  )
}

fn parse_expr(cur : ExprCursor, depth : Int) -> Result[Expr, HandlebarsError] {
  if depth > cur.max_depth {
    return Err(
      cur.err(
        ErrorKind::DepthLimitExceeded,
        "expression nesting depth limit exceeded",
      ),
    )
  }
  cur.skip_ws()
  let b = cur.peek()
  if b < 0 {
    return Err(cur.err(ErrorKind::SyntaxError, "unexpected end of expression"))
  }
  if b == 40 {
    // Subexpression `(...)`
    cur.pos = cur.pos + 1
    match parse_call_args(cur, depth + 1, true) {
      Ok((call, _)) => {
        cur.skip_ws()
        if cur.peek() != 41 {
          return Err(cur.err(ErrorKind::SyntaxError, "expected `)` to close subexpression"))
        }
        cur.pos = cur.pos + 1
        Ok(Expr::SubExpr(call))
      }
      Err(e) => Err(e)
    }
  } else if b == 34 || b == 39 {
    match parse_string_lit(cur) {
      Ok(s) => Ok(Expr::StrLit(s))
      Err(e) => Err(e)
    }
  } else {
    parse_number_or_path(cur)
  }
}

///| Check if cursor is positioned at a hash key `ident=` (without consuming if not).
fn try_parse_hash_key(cur : ExprCursor) -> Option[String] {
  let saved = cur.pos
  let n = cur.src.length()
  let mut p = saved
  while p < n {
    let b = cur.src.code_unit_at(p)
    if b == 61 {
      if p > saved {
        let key = str_slice(cur.src, saved, p)
        cur.pos = p + 1
        return Some(key)
      }
      return None
    }
    if is_ascii_ws(b) || b == 40 || b == 41 || b == 34 || b == 39 || b == 124 {
      return None
    }
    p = p + 1
  }
  None
}

///| Parse `head arg1 arg2 k=v ... [as |p1 p2|]`.
fn parse_call_args(
  cur : ExprCursor,
  depth : Int,
  stop_at_rparen : Bool,
) -> Result[(CallExpr, Array[String]), HandlebarsError] {
  let head = match parse_expr(cur, depth) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  let params : Array[Expr] = []
  let hash : Array[(String, Expr)] = []
  let block_params : Array[String] = []

  while true {
    cur.skip_ws()
    let b = cur.peek()
    if b < 0 || (stop_at_rparen && b == 41) {
      break
    }
    // Check for block params `as |a b|`
    if !stop_at_rparen &&
    matches_at(cur.src, cur.pos, "as") &&
    cur.pos + 2 < cur.src.length() &&
    is_ascii_ws(cur.src.code_unit_at(cur.pos + 2)) {
      let saved = cur.pos
      cur.pos = cur.pos + 2
      cur.skip_ws()
      if cur.peek() == 124 {
        cur.pos = cur.pos + 1
        while true {
          cur.skip_ws()
          if cur.peek() == 124 {
            cur.pos = cur.pos + 1
            break
          }
          if cur.peek() < 0 {
            return Err(cur.err(ErrorKind::SyntaxError, "unclosed block params `as |...|`"))
          }
          let p0 = cur.pos
          while cur.pos < cur.src.length() {
            let c = cur.src.code_unit_at(cur.pos)
            if is_ascii_ws(c) || c == 124 {
              break
            }
            cur.pos = cur.pos + 1
          }
          block_params.push(str_slice(cur.src, p0, cur.pos))
        }
        break
      } else {
        cur.pos = saved
      }
    }
    // Check for hash parameter `key=expr`
    match try_parse_hash_key(cur) {
      Some(k) =>
      match parse_expr(cur, depth) {
        Ok(v) => hash.push((k, v))
        Err(e) => return Err(e)
      }
      None =>
      match parse_expr(cur, depth) {
        Ok(v) => params.push(v)
        Err(e) => return Err(e)
      }
    }
  }

  Ok((CallExpr::{ head: head, params: params, hash: hash }, block_params))
}

fn parse_tag_call(
  content : String,
  tmpl_name : Option[String],
  line : Int,
  col : Int,
  max_depth : Int,
) -> Result[(CallExpr, Array[String]), HandlebarsError] {
  let cur = ExprCursor::{
    src: content,
    pos: 0,
    tmpl_name: tmpl_name,
    line: line,
    col: col,
    max_depth: max_depth,
  }
  parse_call_args(cur, 0, false)
}

fn expr_block_name(e : Expr) -> String {
  match e {
    Expr::Path(p) =>
    if p.segments.length() == 1 && !p.is_data && p.up_levels == 0 && !p.local_only {
      p.segments[0]
    } else {
      let sb = StringBuilder::new()
      if p.is_data {
        sb.write_string("@")
      }
      let mut u = 0
      while u < p.up_levels {
        sb.write_string("../")
        u = u + 1
      }
      let mut i = 0
      while i < p.segments.length() {
        if i > 0 {
          sb.write_string(".")
        }
        sb.write_string(p.segments[i])
        i = i + 1
      }
      sb.to_string()
    }
    Expr::StrLit(s) => s
    _ => ""
  }
}

struct ParseState {
  tokens : Array[RawToken]
  mut pos : Int
  tmpl_name : Option[String]
  max_depth : Int
}

fn parse_block_body(
  st : ParseState,
  stop_at_else : Bool,
  open_name : Option[String],
  depth : Int,
) -> Result[Array[Node], HandlebarsError] {
  if depth > st.max_depth {
    let (l, c) = if st.pos < st.tokens.length() {
      (st.tokens[st.pos].line, st.tokens[st.pos].col)
    } else {
      (0, 0)
    }
    return Err(
      HandlebarsError::new(
        ErrorKind::DepthLimitExceeded,
        "block nesting depth limit exceeded",
        st.tmpl_name,
        l,
        c,
      ),
    )
  }
  let nodes : Array[Node] = []
  let tlen = st.tokens.length()
  while st.pos < tlen {
    let tok = st.tokens[st.pos]
    match tok.kind {
      RawTokKind::Text(s) => {
        if s.length() > 0 {
          nodes.push(Node::Text(s))
        }
        st.pos = st.pos + 1
      }
      RawTokKind::RawBlock(s) => {
        if s.length() > 0 {
          nodes.push(Node::Text(s))
        }
        st.pos = st.pos + 1
      }
      RawTokKind::Comment => st.pos = st.pos + 1
      RawTokKind::DelimChange => st.pos = st.pos + 1
      RawTokKind::Mustache(content, escaped) => {
        st.pos = st.pos + 1
        match parse_tag_call(content, st.tmpl_name, tok.line, tok.col, st.max_depth) {
          Ok((call, _)) => nodes.push(Node::Mustache(call, escaped, tok.line, tok.col))
          Err(e) => return Err(e)
        }
      }
      RawTokKind::Partial(content) => {
        st.pos = st.pos + 1
        match parse_tag_call(content, st.tmpl_name, tok.line, tok.col, st.max_depth) {
          Ok((call, _)) => {
            let ctx_expr = if call.params.length() > 0 {
              Some(call.params[0])
            } else {
              None
            }
            nodes.push(
              Node::Partial(
                PartialNode::{
                  name_expr: call.head,
                  ctx_expr: ctx_expr,
                  hash: call.hash,
                  indent: tok.indent,
                  fallback: None,
                  line: tok.line,
                  col: tok.col,
                },
              ),
            )
          }
          Err(e) => return Err(e)
        }
      }
      RawTokKind::InlinePartialOpen(content) => {
        st.pos = st.pos + 1
        let (call, _) = match
        parse_tag_call(content, st.tmpl_name, tok.line, tok.col, st.max_depth) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        let decorator_name = expr_block_name(call.head)
        if decorator_name != "inline" || call.params.length() < 1 {
          return Err(
            HandlebarsError::new(
              ErrorKind::SyntaxError,
              "expected `{{#*inline \"name\"}}`",
              st.tmpl_name,
              tok.line,
              tok.col,
            ),
          )
        }
        let partial_name = match call.params[0] {
          Expr::StrLit(s) => s
          other => expr_block_name(other)
        }
        let body = match parse_block_body(st, false, Some("inline"), depth + 1) {
          Ok(b) => b
          Err(e) => return Err(e)
        }
        if st.pos >= tlen {
          return Err(
            HandlebarsError::new(
              ErrorKind::UnclosedBlock,
              "unclosed `{{#*inline}}` block",
              st.tmpl_name,
              tok.line,
              tok.col,
            ),
          )
        }
        match st.tokens[st.pos].kind {
          RawTokKind::BlockClose(close_name) => {
            if close_name != "inline" {
              return Err(
                HandlebarsError::new(
                  ErrorKind::MismatchedBlock,
                  "expected `{{/inline}}`, found `{{/" + close_name + "}}`",
                  st.tmpl_name,
                  st.tokens[st.pos].line,
                  st.tokens[st.pos].col,
                ),
              )
            }
            st.pos = st.pos + 1
          }
          _ =>
          return Err(
            HandlebarsError::new(
              ErrorKind::UnclosedBlock,
              "unclosed `{{#*inline}}` block",
              st.tmpl_name,
              tok.line,
              tok.col,
            ),
          )
        }
        nodes.push(Node::InlinePartial(partial_name, body, tok.line, tok.col))
      }
      RawTokKind::PartialBlockOpen(content) => {
        st.pos = st.pos + 1
        let (call, _) = match
        parse_tag_call(content, st.tmpl_name, tok.line, tok.col, st.max_depth) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        let pname = expr_block_name(call.head)
        let body = match parse_block_body(st, false, Some(pname), depth + 1) {
          Ok(b) => b
          Err(e) => return Err(e)
        }
        if st.pos >= tlen {
          return Err(
            HandlebarsError::new(
              ErrorKind::UnclosedBlock,
              "unclosed partial block `{{#> " + pname + "}}`",
              st.tmpl_name,
              tok.line,
              tok.col,
            ),
          )
        }
        match st.tokens[st.pos].kind {
          RawTokKind::BlockClose(close_name) => {
            if pname.length() > 0 && close_name != pname {
              return Err(
                HandlebarsError::new(
                  ErrorKind::MismatchedBlock,
                  "expected `{{/" + pname + "}}`, found `{{/" + close_name + "}}`",
                  st.tmpl_name,
                  st.tokens[st.pos].line,
                  st.tokens[st.pos].col,
                ),
              )
            }
            st.pos = st.pos + 1
          }
          _ =>
          return Err(
            HandlebarsError::new(
              ErrorKind::UnclosedBlock,
              "unclosed partial block",
              st.tmpl_name,
              tok.line,
              tok.col,
            ),
          )
        }
        let ctx_expr = if call.params.length() > 0 {
          Some(call.params[0])
        } else {
          None
        }
        nodes.push(
          Node::Partial(
            PartialNode::{
              name_expr: call.head,
              ctx_expr: ctx_expr,
              hash: call.hash,
              indent: tok.indent,
              fallback: Some(body),
              line: tok.line,
              col: tok.col,
            },
          ),
        )
      }
      RawTokKind::BlockOpen(content, inverted) => {
        st.pos = st.pos + 1
        match parse_block_node(st, content, inverted, tok.line, tok.col, depth + 1) {
          Ok(node) => nodes.push(node)
          Err(e) => return Err(e)
        }
      }
      RawTokKind::Else(_) =>
      if stop_at_else {
        return Ok(nodes)
      } else {
        return Err(
          HandlebarsError::new(
            ErrorKind::SyntaxError,
            "unexpected `{{else}}` outside block",
            st.tmpl_name,
            tok.line,
            tok.col,
          ),
        )
      }
      RawTokKind::BlockClose(close_name) =>
      match open_name {
        Some(_) => return Ok(nodes)
        None =>
        return Err(
          HandlebarsError::new(
            ErrorKind::MismatchedBlock,
            "unexpected closing tag `{{/" + close_name + "}}`",
            st.tmpl_name,
            tok.line,
            tok.col,
          ),
        )
      }
    }
  }
  Ok(nodes)
}

fn parse_block_node(
  st : ParseState,
  content : String,
  inverted : Bool,
  line : Int,
  col : Int,
  depth : Int,
) -> Result[Node, HandlebarsError] {
  if depth > st.max_depth {
    return Err(
      HandlebarsError::new(
        ErrorKind::DepthLimitExceeded,
        "block nesting depth limit exceeded",
        st.tmpl_name,
        line,
        col,
      ),
    )
  }
  let (call, block_params) = match
  parse_tag_call(content, st.tmpl_name, line, col, st.max_depth) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let bname = expr_block_name(call.head)
  let body = match parse_block_body(st, true, Some(bname), depth) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let tlen = st.tokens.length()
  if st.pos >= tlen {
    return Err(
      HandlebarsError::new(
        ErrorKind::UnclosedBlock,
        "unclosed block `{{#" + bname + "}}`",
        st.tmpl_name,
        line,
        col,
      ),
    )
  }
  let mut inverse : Array[Node] = []
  match st.tokens[st.pos].kind {
    RawTokKind::Else(else_rest) => {
      let else_tok = st.tokens[st.pos]
      st.pos = st.pos + 1
      if else_rest.length() > 0 {
        // Chained `{{else if ...}}` or `{{else unless ...}}`
        match
        parse_block_node(
          st,
          else_rest,
          false,
          else_tok.line,
          else_tok.col,
          depth + 1,
        ) {
          Ok(chained) => {
            inverse = [chained]
            return Ok(
              Node::Block(
                BlockNode::{
                  name: bname,
                  head: call.head,
                  params: call.params,
                  hash: call.hash,
                  block_params: block_params,
                  inverted: inverted,
                  body: body,
                  inverse: inverse,
                  line: line,
                  col: col,
                },
              ),
            )
          }
          Err(e) => return Err(e)
        }
      } else {
        inverse = match parse_block_body(st, false, Some(bname), depth) {
          Ok(inv) => inv
          Err(e) => return Err(e)
        }
      }
    }
    _ => ()
  }
  if st.pos >= tlen {
    return Err(
      HandlebarsError::new(
        ErrorKind::UnclosedBlock,
        "unclosed block `{{#" + bname + "}}`",
        st.tmpl_name,
        line,
        col,
      ),
    )
  }
  match st.tokens[st.pos].kind {
    RawTokKind::BlockClose(close_name) => {
      if bname.length() > 0 && close_name != bname {
        return Err(
          HandlebarsError::new(
            ErrorKind::MismatchedBlock,
            "expected `{{/" + bname + "}}`, found `{{/" + close_name + "}}`",
            st.tmpl_name,
            st.tokens[st.pos].line,
            st.tokens[st.pos].col,
          ),
        )
      }
      st.pos = st.pos + 1
    }
    _ =>
    return Err(
      HandlebarsError::new(
        ErrorKind::UnclosedBlock,
        "unclosed block `{{#" + bname + "}}`",
        st.tmpl_name,
        line,
        col,
      ),
    )
  }
  Ok(
    Node::Block(
      BlockNode::{
        name: bname,
        head: call.head,
        params: call.params,
        hash: call.hash,
        block_params: block_params,
        inverted: inverted,
        body: body,
        inverse: inverse,
        line: line,
        col: col,
      },
    ),
  )
}

///| Compile a Handlebars/Mustache template string into a pre-compiled `Template`.
fn compile_template(
  source : String,
  name : Option[String],
  limits : HandlebarsLimits,
) -> Result[Template, HandlebarsError] {
  if source.length() > limits.max_template_bytes {
    return Err(
      HandlebarsError::new(
        ErrorKind::TemplateSizeLimitExceeded,
        "template size exceeds max_template_bytes",
        name,
        1,
        1,
      ),
    )
  }
  let tokens = match tokenize(source, name) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  apply_whitespace_control(source, tokens)
  let st = ParseState::{
    tokens: tokens,
    pos: 0,
    tmpl_name: name,
    max_depth: limits.max_depth,
  }
  let nodes = match parse_block_body(st, false, None, 0) {
    Ok(ns) => ns
    Err(e) => return Err(e)
  }
  Ok(Template::{ name: name, nodes: nodes })
}
