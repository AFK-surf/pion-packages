///| Fast HTML escaping matching Handlebars.js `escapeExpression`.
///| Escapes: `&`, `<`, `>`, `"`, `'`, `` ` ``, `=`.

///| Write HTML-escaped `s` into `sb` using fast-path substring copies.
fn write_escaped_html(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut mark = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    // & (38), < (60), > (62), " (34), ' (39), ` (96), = (61)
    if b == 38 ||
    b == 60 ||
    b == 62 ||
    b == 34 ||
    b == 39 ||
    b == 96 ||
    b == 61 {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      if b == 38 {
        sb.write_string("&amp;")
      } else if b == 60 {
        sb.write_string("&lt;")
      } else if b == 62 {
        sb.write_string("&gt;")
      } else if b == 34 {
        sb.write_string("&quot;")
      } else if b == 39 {
        sb.write_string("&#x27;")
      } else if b == 96 {
        sb.write_string("&#x60;")
      } else {
        sb.write_string("&#x3D;")
      }
      mark = i + 1
    }
    i = i + 1
  }
  if mark < n {
    if mark == 0 {
      sb.write_string(s)
    } else {
      sb.write_substring(s, mark, n)
    }
  }
}

///| Compute exact HTML-escaped byte length without allocating.
fn escaped_html_len(s : String) -> Int {
  let n = s.length()
  let mut total = n
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 38 {
      total = total + 4 // & -> &amp;
    } else if b == 60 || b == 62 {
      total = total + 3 // < -> &lt;, > -> &gt;
    } else if b == 34 || b == 39 || b == 96 || b == 61 {
      total = total + 5 // &quot; &#x27; &#x60; &#x3D;
    }
    i = i + 1
  }
  total
}

///| Escape HTML special characters matching Handlebars.js `escapeExpression`:
///| `&`, `<`, `>`, `"`, `'`, `` ` ``, `=`.
pub fn escape_html(s : String) -> String {
  let n = s.length()
  let mut needs_escape = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 38 ||
    b == 60 ||
    b == 62 ||
    b == 34 ||
    b == 39 ||
    b == 96 ||
    b == 61 {
      needs_escape = true
      break
    }
    i = i + 1
  }
  if !needs_escape {
    return s
  }
  let sb = StringBuilder::with_capacity(n + 16)
  write_escaped_html(sb, s)
  sb.to_string()
}
