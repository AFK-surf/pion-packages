///| Compact pre-compiled AST representation for Handlebars 4.x + Mustache 1.4.2.

///| Parsed path expression (e.g. `a.b.c`, `../parent`, `./local`, `this`, `@root.title`, `@../index`).
struct PathExpr {
  is_data : Bool
  up_levels : Int
  local_only : Bool
  segments : Array[String]
}

///| Expression node used inside tags, subexpressions, and hash arguments.
enum Expr {
  Path(PathExpr)
  StrLit(String)
  IntLit(Int64)
  FloatLit(Double)
  BoolLit(Bool)
  NullLit
  SubExpr(CallExpr)
}

///| Helper call or mustache expression with positional params and named hash args.
struct CallExpr {
  head : Expr
  params : Array[Expr]
  hash : Array[(String, Expr)]
}

///| Block node (`{{#if}}`, `{{#each}}`, `{{#section}}`, `{{^inverted}}`, custom block helpers).
struct BlockNode {
  name : String
  head : Expr
  params : Array[Expr]
  hash : Array[(String, Expr)]
  block_params : Array[String]
  inverted : Bool
  body : Array[Node]
  inverse : Array[Node]
  line : Int
  col : Int
}

///| Partial invocation (`{{> p}}`, `{{> (dyn) ctx k=v}}`, `{{#> p}}fallback{{/p}}`).
struct PartialNode {
  name_expr : Expr
  ctx_expr : Option[Expr]
  hash : Array[(String, Expr)]
  indent : String
  fallback : Option[Array[Node]]
  line : Int
  col : Int
}

///| Compiled template AST node.
enum Node {
  Text(String)
  Mustache(CallExpr, Bool, Int, Int)
  Block(BlockNode)
  Partial(PartialNode)
  InlinePartial(String, Array[Node], Int, Int)
}
