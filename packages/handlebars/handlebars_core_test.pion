///| Handlebars 4.x compliance tests:
///| paths, @data variables, built-in helpers, subexpressions, block params,
///| whitespace control, raw blocks, inline partials, partial blocks, dynamic partials,
///| HTML escaping, SafeString, strict mode, custom helpers, JSON binding.

fn h_assert_render(
  tmpl : String,
  data : Value,
  expected : String,
  label : String,
) -> Unit {
  match render(tmpl, data) {
    Ok(actual) =>
    debug_assert(
      actual == expected,
      label + ": expected `" + expected + "`, got `" + actual + "`",
    )
    Err(e) =>
    debug_assert(false, label + ": unexpected error: " + e.to_string())
  }
}

fn h_assert_reg(
  reg : Registry,
  tmpl : String,
  data : Value,
  expected : String,
  label : String,
) -> Unit {
  match reg.render_template(tmpl, data) {
    Ok(actual) =>
    debug_assert(
      actual == expected,
      label + ": expected `" + expected + "`, got `" + actual + "`",
    )
    Err(e) =>
    debug_assert(false, label + ": unexpected error: " + e.to_string())
  }
}

///|
test "hbs_html_escape_all_seven_chars_and_safestring" {
  // Official Handlebars.js escapeExpression escapes: & < > " ' ` =
  let raw = "& < > \" ' ` ="
  let expected = "&amp; &lt; &gt; &quot; &#x27; &#x60; &#x3D;"
  debug_assert(escape_html(raw) == expected, "escape_html direct")
  h_assert_render(
    "{{x}}|{{{x}}}|{{& x}}|{{safe}}",
    Value::object([
      ("x", Value::string(raw)),
      ("safe", Value::safe_string("<b>trusted</b>")),
    ]),
    expected + "|" + raw + "|" + raw + "|<b>trusted</b>",
    "escaped vs triple vs amp vs safe_string",
  )
  // no_escape mode disables HTML escaping on {{...}}
  let reg = Registry::new()
  reg.set_no_escape(true)
  h_assert_reg(
    reg,
    "{{x}}",
    Value::object([("x", Value::string("<script>&\"'`="))]),
    "<script>&\"'`=",
    "no_escape mode",
  )
}

///|
test "hbs_paths_parent_this_literal_and_data_vars" {
  let data = Value::object([
    ("title", Value::string("RootTitle")),
    (
      "user",
      Value::object([
        ("name", Value::string("Alice")),
        ("a.b", Value::string("dotted-key")),
        ("with space", Value::string("spaced-key")),
      ]),
    ),
    (
      "groups",
      Value::array([
        Value::object([
          ("gname", Value::string("G1")),
          (
            "items",
            Value::array([Value::string("x"), Value::string("y")]),
          ),
        ]),
      ]),
    ),
  ])
  h_assert_render(
    "{{user.name}}|{{user/name}}|{{user.[a.b]}}|{{user.[with space]}}",
    data,
    "Alice|Alice|dotted-key|spaced-key",
    "dot, slash, and bracket segment literals",
  )
  h_assert_render(
    "{{#with user}}{{this.name}}|{{./name}}|{{../title}}|{{@root.title}}{{/with}}",
    data,
    "Alice|Alice|RootTitle|RootTitle",
    "this, ./, ../, @root",
  )
  // Nested @../index access
  h_assert_render(
    "{{#each groups}}{{#each items}}{{@../index}}:{{@index}}={{this}}({{../gname}}/{{../../title}});{{/each}}{{/each}}",
    data,
    "0:0=x(G1/RootTitle);0:1=y(G1/RootTitle);",
    "nested @../index and ../../",
  )
}

///|
test "hbs_builtin_if_else_if_unless_include_zero" {
  let data = Value::object([
    ("a", Value::bool(false)),
    ("b", Value::bool(true)),
    ("zero", Value::int(0)),
    ("empty_str", Value::string("")),
    ("empty_arr", Value::array([])),
    ("empty_obj", Value::object([])),
  ])
  h_assert_render(
    "{{#if a}}A{{else if b}}B{{else}}C{{/if}}",
    data,
    "B",
    "if / else if / else",
  )
  h_assert_render(
    "{{#if a}}A{{else if zero}}Z{{else}}NONE{{/if}}",
    data,
    "NONE",
    "if else-if fallthrough to else",
  )
  h_assert_render(
    "{{#if zero}}Y{{else}}N{{/if}}|{{#if zero includeZero=true}}Y{{else}}N{{/if}}",
    data,
    "N|Y",
    "if includeZero",
  )
  h_assert_render(
    "{{#unless zero}}U{{else}}E{{/unless}}|{{#unless zero includeZero=true}}U{{else}}E{{/unless}}",
    data,
    "U|E",
    "unless includeZero",
  )
  h_assert_render(
    "{{#if empty_str}}Y{{else}}N{{/if}}|{{#if empty_arr}}Y{{else}}N{{/if}}|{{#if empty_obj}}Y{{else}}N{{/if}}",
    data,
    "N|N|Y",
    "handlebars truthiness empty_str/empty_arr/empty_obj",
  )
  // {{^}} shorthand for {{else}}
  h_assert_render(
    "{{#if a}}YES{{^}}NO{{/if}}",
    data,
    "NO",
    "caret else shorthand",
  )
}

///|
test "hbs_builtin_each_array_object_and_else" {
  let data = Value::object([
    (
      "arr",
      Value::array([Value::string("p"), Value::string("q"), Value::string("r")]),
    ),
    (
      "obj",
      Value::object([
        ("k1", Value::int(10)),
        ("k2", Value::int(20)),
      ]),
    ),
    ("empty", Value::array([])),
  ])
  h_assert_render(
    "{{#each arr}}{{@index}}:{{this}}{{#if @first}}(F){{/if}}{{#if @last}}(L){{/if}};{{/each}}",
    data,
    "0:p(F);1:q;2:r(L);",
    "each array with @index/@first/@last",
  )
  h_assert_render(
    "{{#each obj}}{{@index}}:{{@key}}={{this}}{{#if @first}}[F]{{/if}}{{#if @last}}[L]{{/if}};{{/each}}",
    data,
    "0:k1=10[F];1:k2=20[L];",
    "each object with @key/@index/@first/@last",
  )
  h_assert_render(
    "{{#each empty}}X{{else}}EMPTY{{/each}}",
    data,
    "EMPTY",
    "each empty else branch",
  )
}

///|
test "hbs_builtin_with_lookup_and_log" {
  let data = Value::object([
    ("user", Value::object([("name", Value::string("Bob"))])),
    ("none", Value::null()),
    ("keys", Value::array([Value::string("b"), Value::string("a")])),
    (
      "map",
      Value::object([
        ("a", Value::string("Alpha")),
        ("b", Value::string("Beta")),
      ]),
    ),
    ("nums", Value::array([Value::int(100), Value::int(200)])),
  ])
  h_assert_render(
    "{{#with user}}{{name}}{{/with}}|{{#with none}}X{{else}}NOUSER{{/with}}",
    data,
    "Bob|NOUSER",
    "with and else",
  )
  h_assert_render(
    "{{#each keys}}{{lookup ../map this}},{{/each}}{{lookup nums 1}}",
    data,
    "Beta,Alpha,200",
    "lookup on object and array",
  )
  h_assert_render(
    "A{{log \"debug\" user.name}}B",
    data,
    "AB",
    "log helper is pure no-op",
  )
}

///|
test "hbs_block_params_as_pipes" {
  let data = Value::object([
    (
      "users",
      Value::array([
        Value::object([("name", Value::string("Ada"))]),
        Value::object([("name", Value::string("Linus"))]),
      ]),
    ),
    (
      "scores",
      Value::object([
        ("math", Value::int(95)),
        ("cs", Value::int(100)),
      ]),
    ),
    ("profile", Value::object([("role", Value::string("admin"))])),
  ])
  h_assert_render(
    "{{#each users as |u i|}}{{i}}:{{u.name}};{{/each}}",
    data,
    "0:Ada;1:Linus;",
    "each array block params",
  )
  h_assert_render(
    "{{#each scores as |val key|}}{{key}}={{val}};{{/each}}",
    data,
    "math=95;cs=100;",
    "each object block params",
  )
  h_assert_render(
    "{{#with profile as |p|}}role={{p.role}}{{/with}}",
    data,
    "role=admin",
    "with block params",
  )
}

///|
test "hbs_custom_helpers_and_subexpressions" {
  let reg = Registry::new()
  reg.register_helper(
    "eq",
    fn(ctx : HelperContext) -> Result[Value, HandlebarsError] {
      match (ctx.param(0), ctx.param(1)) {
        (Some(Value::Int(a)), Some(Value::Int(b))) => Ok(Value::bool(a == b))
        (Some(Value::Str(a)), Some(Value::Str(b))) => Ok(Value::bool(a == b))
        (Some(Value::Bool(a)), Some(Value::Bool(b))) => Ok(Value::bool(a == b))
        _ => Ok(Value::bool(false))
      }
    },
  )
  reg.register_helper(
    "len",
    fn(ctx : HelperContext) -> Result[Value, HandlebarsError] {
      match ctx.param(0) {
        Some(Value::Array(xs)) => Ok(Value::int(xs.length()))
        Some(Value::Str(s)) => Ok(Value::int(s.length()))
        _ => Ok(Value::int(0))
      }
    },
  )
  reg.register_helper(
    "tag",
    fn(ctx : HelperContext) -> Result[Value, HandlebarsError] {
      let name = match ctx.hash_get("name") {
        Some(Value::Str(s)) => s
        _ => "div"
      }
      match ctx.fn_render(ctx.this_val) {
        Ok(inner) =>
        Ok(Value::safe_string("<" + name + ">" + inner + "</" + name + ">"))
        Err(e) => Err(e)
      }
    },
  )
  let data = Value::object([
    ("items", Value::array([])),
    ("nonempty", Value::array([Value::int(1), Value::int(2)])),
    ("label", Value::string("Hi <you>")),
  ])
  h_assert_reg(
    reg,
    "{{#if (eq (len items) 0)}}EMPTY{{else}}HAS{{/if}}|{{#if (eq (len nonempty) 2)}}TWO{{/if}}",
    data,
    "EMPTY|TWO",
    "nested subexpressions (eq (len items) 0)",
  )
  h_assert_reg(
    reg,
    "{{#tag name=\"span\"}}{{label}}{{/tag}}",
    data,
    "<span>Hi &lt;you&gt;</span>",
    "custom block helper with hash and SafeString return",
  )
}

///|
test "hbs_whitespace_control_raw_blocks_and_escaped_mustaches" {
  let data = Value::object([
    ("x", Value::string("OK")),
    ("items", Value::array([Value::int(1), Value::int(2), Value::int(3)])),
  ])
  h_assert_render("a   {{~x~}}   b", data, "aOKb", "tilde both sides")
  h_assert_render("a\n  {{~x}}  b", data, "aOK  b", "tilde left")
  h_assert_render("a  {{x~}}\n  b", data, "a  OKb", "tilde right")
  h_assert_render(
    "[\n  {{~#each items~}}\n    {{this}}\n  {{~/each~}}\n]",
    data,
    "[123]",
    "tilde on block tags",
  )
  h_assert_render(
    "a  {{{~x~}}}  b",
    Value::object([("x", Value::string("<b>"))]),
    "a<b>b",
    "tilde on triple mustache",
  )
  // Raw blocks
  h_assert_render(
    "{{{{raw}}}}{{x}} {{#if x}}literal{{/if}}{{{{/raw}}}}",
    data,
    "{{x}} {{#if x}}literal{{/if}}",
    "raw block",
  )
  // Escaped mustaches
  h_assert_render(
    "\\{{x}} and \\\\{{x}}",
    data,
    "{{x}} and \\OK",
    "escaped mustache and double backslash",
  )
}

///|
test "hbs_partials_dynamic_params_blocks_and_inline" {
  let reg = Registry::new()
  debug_assert(
    reg.register_partial("greet", "Hello {{name}} ({{role}})!").is_ok(),
    "reg greet",
  )
  debug_assert(
    reg.register_partial("layout", "<main>{{> @partial-block}}</main>").is_ok(),
    "reg layout",
  )
  reg.register_helper(
    "pick",
    fn(ctx : HelperContext) -> Result[Value, HandlebarsError] {
      match ctx.param(0) {
        Some(Value::Bool(true)) => Ok(Value::string("greet"))
        _ => Ok(Value::string("missing"))
      }
    },
  )
  let data = Value::object([
    ("use_greet", Value::bool(true)),
    ("person", Value::object([("name", Value::string("Sam"))])),
  ])
  // Partial with context + hash
  h_assert_reg(
    reg,
    "{{> greet person role=\"dev\"}}",
    data,
    "Hello Sam (dev)!",
    "partial with context and hash",
  )
  // Dynamic partial via subexpression
  h_assert_reg(
    reg,
    "{{> (pick use_greet) person role=\"ops\"}}",
    data,
    "Hello Sam (ops)!",
    "dynamic partial",
  )
  // Partial block with registered layout
  h_assert_reg(
    reg,
    "{{#> layout}}Hi {{person.name}}{{/layout}}",
    data,
    "<main>Hi Sam</main>",
    "partial block with registered partial",
  )
  // Partial block fallback when partial does not exist
  h_assert_reg(
    reg,
    "{{#> nonexistent}}Fallback {{person.name}}{{/nonexistent}}",
    data,
    "Fallback Sam",
    "partial block fallback",
  )
  // Inline partial {{#*inline "name"}}...{{/inline}}
  h_assert_reg(
    reg,
    "{{#*inline \"badge\"}}[{{label}}]{{/inline}}{{> badge label=\"v1\"}}{{> badge label=\"v2\"}}",
    data,
    "[v1][v2]",
    "inline partial",
  )
}

///|
test "hbs_strict_mode_and_json_binding" {
  let reg = Registry::new()
  reg.set_strict_mode(true)
  let data = Value::object([
    ("present", Value::string("yes")),
    ("nullable", Value::null()),
  ])
  h_assert_reg(reg, "{{present}}|{{nullable}}", data, "yes|", "strict mode existing keys")
  match reg.render_template("{{missing}}", data) {
    Ok(s) => debug_assert(false, "expected StrictUndefined, got: " + s)
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::StrictUndefined),
      "expected StrictUndefined, got: " + e.to_string(),
    )
  }
  // JSON / JSON5 data binding
  let json_src = "{\"user\": {\"name\": \"Pion\", \"tags\": [\"fast\", \"safe\"]}, \"count\": 3}"
  match render_json("{{user.name}}({{count}}):{{#each user.tags}}[{{this}}]{{/each}}", json_src) {
    Ok(out) =>
    debug_assert(
      out == "Pion(3):[fast][safe]",
      "render_json mismatch: " + out,
    )
    Err(e) => debug_assert(false, "render_json failed: " + e.to_string())
  }
}
