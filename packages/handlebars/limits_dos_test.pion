///| Security limits (DoS protection) and syntax diagnostic tests for `handlebars`.

///|
test "dos_template_size_limit" {
  let limits = HandlebarsLimits::{
    max_depth: 64,
    max_partial_depth: 32,
    max_steps: 100000L,
    max_output_bytes: 1024,
    max_template_bytes: 32,
  }
  let reg = Registry::with_limits(limits)
  let big = "0123456789012345678901234567890123456789"
  match reg.compile(big) {
    Ok(_) => debug_assert(false, "expected TemplateSizeLimitExceeded")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::TemplateSizeLimitExceeded),
      "expected TemplateSizeLimitExceeded, got: " + e.to_string(),
    )
  }
}

///|
test "dos_block_depth_limit" {
  let limits = HandlebarsLimits::{
    max_depth: 4,
    max_partial_depth: 16,
    max_steps: 100000L,
    max_output_bytes: 65536,
    max_template_bytes: 65536,
  }
  let reg = Registry::with_limits(limits)
  let deep = "{{#if a}}{{#if a}}{{#if a}}{{#if a}}{{#if a}}X{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}"
  match reg.render_template(deep, Value::object([("a", Value::bool(true))])) {
    Ok(_) => debug_assert(false, "expected DepthLimitExceeded")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::DepthLimitExceeded),
      "expected DepthLimitExceeded, got: " + e.to_string(),
    )
  }
}

///|
test "dos_recursive_partial_bomb" {
  let limits = HandlebarsLimits::{
    max_depth: 64,
    max_partial_depth: 5,
    max_steps: 100000L,
    max_output_bytes: 65536,
    max_template_bytes: 65536,
  }
  let reg = Registry::with_limits(limits)
  debug_assert(reg.register_partial("self", "x{{> self}}").is_ok(), "reg self")
  match reg.render_template("{{> self}}", Value::object([])) {
    Ok(_) => debug_assert(false, "expected PartialDepthLimitExceeded")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::PartialDepthLimitExceeded),
      "expected PartialDepthLimitExceeded, got: " + e.to_string(),
    )
  }
}

///|
test "dos_step_limit_large_loop" {
  let limits = HandlebarsLimits::{
    max_depth: 64,
    max_partial_depth: 16,
    max_steps: 50L,
    max_output_bytes: 65536,
    max_template_bytes: 65536,
  }
  let reg = Registry::with_limits(limits)
  let items : Array[Value] = []
  let mut i = 0
  while i < 200 {
    items.push(Value::int(i))
    i = i + 1
  }
  match
  reg.render_template(
    "{{#each items}}{{this}}{{/each}}",
    Value::object([("items", Value::array(items))]),
  ) {
    Ok(_) => debug_assert(false, "expected StepLimitExceeded")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::StepLimitExceeded),
      "expected StepLimitExceeded, got: " + e.to_string(),
    )
  }
}

///|
test "dos_output_bytes_amplification_limit" {
  let limits = HandlebarsLimits::{
    max_depth: 64,
    max_partial_depth: 16,
    max_steps: 100000L,
    max_output_bytes: 128,
    max_template_bytes: 65536,
  }
  let reg = Registry::with_limits(limits)
  debug_assert(reg.register_partial("p0", "0123456789ABCDEF").is_ok(), "p0")
  debug_assert(reg.register_partial("p1", "{{> p0}}{{> p0}}{{> p0}}{{> p0}}").is_ok(), "p1")
  debug_assert(reg.register_partial("p2", "{{> p1}}{{> p1}}{{> p1}}{{> p1}}").is_ok(), "p2")
  match reg.render_template("{{> p2}}", Value::object([])) {
    Ok(_) => debug_assert(false, "expected OutputLimitExceeded")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::OutputLimitExceeded),
      "expected OutputLimitExceeded, got: " + e.to_string(),
    )
  }
}

///|
test "syntax_errors_unclosed_and_mismatched" {
  match compile("hello {{unclosed") {
    Ok(_) => debug_assert(false, "expected UnclosedTag")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::UnclosedTag) && e.line == 1,
      "expected UnclosedTag at line 1, got: " + e.to_string(),
    )
  }
  match compile("line1\n{{#if a}}open") {
    Ok(_) => debug_assert(false, "expected UnclosedBlock")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::UnclosedBlock),
      "expected UnclosedBlock, got: " + e.to_string(),
    )
  }
  match compile("{{#if a}}hi{{/each}}") {
    Ok(_) => debug_assert(false, "expected MismatchedBlock")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::MismatchedBlock),
      "expected MismatchedBlock, got: " + e.to_string(),
    )
  }
  match compile("{{=bad=}}") {
    Ok(_) => debug_assert(false, "expected InvalidDelimiter")
    Err(e) =>
    debug_assert(
      e.is_kind(ErrorKind::InvalidDelimiter),
      "expected InvalidDelimiter, got: " + e.to_string(),
    )
  }
}
