///| Red-team regression tests for packages/handlebars @ 4ab06f4 (branch feat/pkg-handlebars).
///
/// Every `p0_` / `p1_` / `p2_` test asserts the behaviour required by Handlebars.js 4.7.8 (the reference
/// implementation), the Mustache Spec v1.4.2 or Rust `handlebars` =6.4.4, as named in its comment.
/// A FAILURE of a p*_ test is the evidence for the REPORT.md finding of the same number.
/// `control_` tests are attacks the engine survived; they must keep passing.
///
/// `p0_partial_block_self_recursion_is_bounded` overflows the native stack (SIGSEGV) on 4ab06f4; the
/// Pion test runner isolates each test, so it is reported as failed and the run continues.

import "handlebars"

///|
fn obj(entries : Array[(String, handlebars::Value)]) -> handlebars::Value {
  handlebars::Value::object(entries)
}

///|
fn s(v : String) -> handlebars::Value {
  handlebars::Value::string(v)
}

///|
fn show(r : Result[String, handlebars::HandlebarsError]) -> String {
  match r {
    Ok(out) => "Ok(`" + out + "`)"
    Err(e) => "Err(" + e.to_string() + ")"
  }
}

///|
fn expect_out(
  r : Result[String, handlebars::HandlebarsError],
  want : String,
  label : String,
) -> Unit {
  let ok = match r {
    Ok(out) => out == want
    Err(_) => false
  }
  debug_assert(ok, label + ": want Ok(`" + want + "`), got " + show(r))
}

///|
fn expect_kind(
  r : Result[String, handlebars::HandlebarsError],
  kind : handlebars::ErrorKind,
  label : String,
) -> Unit {
  let ok = match r {
    Ok(_) => false
    Err(e) => e.is_kind(kind)
  }
  debug_assert(
    ok,
    label + ": want Err(" + handlebars::error_kind_as_str(kind) + "), got " + show(r),
  )
}

///|
fn wrap_registry() -> handlebars::Registry {
  let reg = handlebars::Registry::new()
  // The canonical Handlebars.js block helper: `return "<b>" + options.fn(this) + "</b>"`.
  reg.register_helper(
    "wrap",
    fn(h : handlebars::HelperContext) -> Result[handlebars::Value, handlebars::HandlebarsError] {
      match h.fn_render(h.this_val) {
        Ok(inner) => Ok(handlebars::Value::string("<b>" + inner + "</b>"))
        Err(e) => Err(e)
      }
    },
  )
  reg
}

// ---------------------------------------------------------------------------------------------
// P0
// ---------------------------------------------------------------------------------------------

///| P0-1: `{{> @partial-block}}` inside the partial-block body re-enters the same block forever:
///| no tick of max_partial_depth / max_depth applies, the native stack overflows (SIGSEGV).
///| Handlebars.js: "The partial @partial-block could not be found"; Rust: "Partial block cound not
///| be found". Any graceful result passes (an error, or an empty rendering of the missing inner
///| @partial-block, which is how Pion treats a missing partial); only returning at all is tested.
///| (Natively only a max_steps far below the default stops it first; on Wasm32 not even max_steps=1000.)
test "p0_partial_block_self_recursion_is_bounded" {
  // Default limits (max_partial_depth 32, max_depth 64, max_steps 10M): one untrusted template
  // string, no registered partial or helper needed.
  let r = handlebars::render(
    "{{#*inline \"l\"}}<{{> @partial-block}}>{{/inline}}{{#> l}}{{> @partial-block}}{{/l}}",
    obj([]),
  )
  let _ = show(r)
}

// ---------------------------------------------------------------------------------------------
// P1
// ---------------------------------------------------------------------------------------------

///| P1-1: a block helper's string result is HTML-escaped again, so the already-escaped body is
///| double-escaped and the helper's own markup is destroyed. Handlebars.js and Rust: `<b>&lt;i&gt;</b>`.
test "p1_block_helper_output_is_not_escaped_again" {
  let reg = wrap_registry()
  expect_out(
    reg.render_template("{{#wrap}}{{x}}{{/wrap}}", obj([("x", s("<i>"))])),
    "<b>&lt;i&gt;</b>",
    "block helper",
  )
}

///| P1-2: `{{~{x}~}}` is the Handlebars.js / Rust spelling of a whitespace-stripping triple-stash
///| (lexer: OPEN_UNESCAPED = "{{" "~"? "{"). Pion parses it as an escaped path named `{x}` and the
///| value vanishes. Handlebars.js and Rust: `a<i>b`.
test "p1_tilde_triple_stash_renders_value" {
  expect_out(
    handlebars::render("a {{~{x}~}} b", obj([("x", s("<i>"))])),
    "a<i>b",
    "{{~{x}~}}",
  )
}

///| P1-3: calling a helper that does not exist with arguments silently evaluates the helper name as
///| a data path. `{{#unless (isBanned user)}}` therefore always renders (fail-open), and
///| `{{nohelper 1}}` prints a data field. Handlebars.js: "Missing helper"; Rust: "Helper not found".
test "p1_unknown_helper_with_arguments_is_an_error" {
  let data = obj([("user", s("mallory")), ("nohelper", s("LEAK"))])
  expect_kind(
    handlebars::render("{{nohelper 1}}", data),
    handlebars::ErrorKind::HelperNotFound,
    "inline call",
  )
  expect_kind(
    handlebars::render(
      "{{#unless (isBanned user)}}secret{{/unless}}",
      data,
    ),
    handlebars::ErrorKind::HelperNotFound,
    "subexpression in unless",
  )
  expect_kind(
    handlebars::render("{{#nohelper 1}}x{{/nohelper}}", data),
    handlebars::ErrorKind::HelperNotFound,
    "block call with params",
  )
}

///| P1-4: a section over a non-list truthy scalar must push that value as the context.
///| Mustache Spec v1.4.2 sections.yml "Variable test": `{{#foo}}{{.}} is {{foo}}{{/foo}}`,
///| foo = "bar" -> `bar is bar` (Pion: `[object Object] is bar`). Handlebars.js pushes it too.
test "p1_section_over_scalar_pushes_it_as_context" {
  expect_out(
    handlebars::render("{{#foo}}{{.}} is {{foo}}{{/foo}}", obj([("foo", s("bar"))])),
    "bar is bar",
    "spec Variable test",
  )
  expect_out(
    handlebars::render("{{#n}}[{{.}}]{{/n}}", obj([("n", handlebars::Value::int(5))])),
    "[5]",
    "number section",
  )
}

///| P1-6: the documented Handlebars.js layout pattern - inline partials declared inside a partial
///| block body are visible to the layout - renders nothing. Handlebars.js and Rust: `[S]`.
test "p1_inline_partial_in_partial_block_is_visible_to_layout" {
  let reg = handlebars::Registry::new()
  match reg.register_partial("layout", "[{{> slot}}]") {
    Ok(()) => ()
    Err(e) => debug_assert(false, e.to_string())
  }
  expect_out(
    reg.render_template(
      "{{#> layout}}{{#*inline \"slot\"}}S{{/inline}}{{/layout}}",
      obj([]),
    ),
    "[S]",
    "layout slot",
  )
}

// ---------------------------------------------------------------------------------------------
// P2
// ---------------------------------------------------------------------------------------------

///| P2-1: standalone-partial indentation is applied to the rendered output instead of the partial's
///| template lines: interpolated data containing newlines gets indented (Mustache Spec partials.yml
///| "Standalone Indentation"), and empty template lines are left unindented (Handlebars.js and Rust
///| both indent them: `  x\n  \n  y\n`).
test "p2_partial_indentation_applies_to_template_lines" {
  let reg = handlebars::Registry::new()
  match reg.register_partial("partial", "|\n{{{content}}}\n|\n") {
    Ok(()) => ()
    Err(e) => debug_assert(false, e.to_string())
  }
  match reg.register_partial("gap", "x\n\ny\n") {
    Ok(()) => ()
    Err(e) => debug_assert(false, e.to_string())
  }
  expect_out(
    reg.render_template("\\\n {{>partial}}\n/\n", obj([("content", s("<\n->"))])),
    "\\\n |\n <\n->\n |\n/\n",
    "spec Standalone Indentation",
  )
  expect_out(reg.render_template("  {{> gap}}\n", obj([])), "  x\n  \n  y\n", "empty line")
}

///| P2-2: an inline partial declared inside a block is scoped to that block in Handlebars.js
///| (`{{> p}}` outside it: "The partial p could not be found"; an empty rendering, Pion's behaviour
///| for missing partials, is accepted too), and inline partials are hoisted to the start of their
///| block (usable before the declaration: `[IN]`).
test "p2_inline_partial_scoping_and_hoisting" {
  let data = obj([("t", handlebars::Value::bool(true))])
  let leaked = handlebars::render(
    "{{#if t}}{{#*inline \"p\"}}IN{{/inline}}{{/if}}[{{> p}}]",
    data,
  )
  let scoped = match leaked {
    Ok(out) => out == "[]"
    Err(_) => true
  }
  debug_assert(scoped, "inline partial leaks out of {{#if}}: got " + show(leaked))
  expect_out(
    handlebars::render("[{{> p}}]{{#*inline \"p\"}}IN{{/inline}}", data),
    "[IN]",
    "hoisting",
  )
}

///| P2-3: `@partial-block` is lost in a partial that the layout calls (Handlebars.js: `[PB]`,
///| Pion: `[]` with no error).
test "p2_partial_block_reaches_nested_partials" {
  let reg = handlebars::Registry::new()
  match reg.register_partial("layout", "{{> inner}}") {
    Ok(()) => ()
    Err(e) => debug_assert(false, e.to_string())
  }
  match reg.register_partial("inner", "[{{> @partial-block}}]") {
    Ok(()) => ()
    Err(e) => debug_assert(false, e.to_string())
  }
  expect_out(reg.render_template("{{#> layout}}PB{{/layout}}", obj([])), "[PB]", "nested")
}

///| P2-4: strict mode also rejects missing values tested by `{{#if}}` / `{{#unless}}`, so the
///| guard idiom `{{#if x}}{{x}}{{/if}}` cannot be written. Handlebars.js and Rust strict modes
///| render `` for `{{#if nope}}x{{/if}}` and still reject `{{nope}}`.
test "p2_strict_mode_allows_if_guards" {
  let reg = handlebars::Registry::new()
  reg.set_strict_mode(true)
  expect_out(reg.render_template("{{#if nope}}x{{/if}}", obj([])), "", "if guard")
  expect_kind(
    reg.render_template("{{nope}}", obj([])),
    handlebars::ErrorKind::StrictUndefined,
    "plain lookup",
  )
}

///| P2-5: a raw block `{{{{wrap}}}}...{{{{/wrap}}}}` must invoke helper `wrap` with the raw body
///| (Handlebars.js and Rust: `<b>{{x}}</b>`); Pion drops the helper and emits the body.
test "p2_raw_block_invokes_its_helper" {
  let reg = wrap_registry()
  expect_out(
    reg.render_template("{{{{wrap}}}}{{x}}{{{{/wrap}}}}", obj([("x", s("V"))])),
    "<b>{{x}}</b>",
    "raw block helper",
  )
}

///| P2-6: Double formatting follows neither JavaScript (Handlebars.js) nor Rust: `1e-07`, `1e-06`,
///| `4.94065645841247e-324`. Both references print `1e-7` and `5e-324` (shortest round-trip).
test "p2_float_formatting_is_shortest_round_trip" {
  expect_out(
    handlebars::render_json("{{a}} {{b}}", "{\"a\":1e-7,\"b\":5e-324}"),
    "1e-7 5e-324",
    "floats",
  )
}

///| P2-8: array indices are parsed with a wrapping Int64 accumulator and then truncated to Int, so
///| out-of-range indices alias in-range elements: 2^32 -> [0], 2^64+1 -> [1]. Handlebars.js and Rust:
///| all four lookups are undefined (empty).
test "p2_out_of_range_index_does_not_alias" {
  let data = obj([("a", handlebars::Value::array([s("SECRET0"), s("S1")]))])
  expect_out(
    handlebars::render(
      "[{{lookup a '4294967296'}}][{{lookup a '18446744073709551617'}}][{{lookup a 4294967297}}][{{a.[4294967296]}}]",
      data,
    ),
    "[][][][]",
    "wrapped indices",
  )
}

// ---------------------------------------------------------------------------------------------
// Controls (must keep passing)
// ---------------------------------------------------------------------------------------------

///| All 7 Handlebars.js escapeExpression characters, in every escaped position; UTF-8, NUL and
///| control characters survive byte-for-byte.
test "control_escaping_everywhere" {
  let reg = handlebars::Registry::new()
  reg.register_helper(
    "echo",
    fn(h : handlebars::HelperContext) -> Result[handlebars::Value, handlebars::HandlebarsError] {
      match h.param(0) {
        Some(v) => Ok(v)
        None => Ok(handlebars::Value::null())
      }
    },
  )
  match reg.register_partial("p", "{{v}}|{{{v}}}") {
    Ok(()) => ()
    Err(e) => debug_assert(false, e.to_string())
  }
  let x = "&<>\"'`= 日本é\u{0}\u{1}"
  let esc = "&amp;&lt;&gt;&quot;&#x27;&#x60;&#x3D; 日本é\u{0}\u{1}"
  let data = obj([("x", s(x)), ("a", handlebars::Value::array([s(x)]))])
  expect_out(reg.render_template("{{x}}", data), esc, "mustache")
  expect_out(reg.render_template("{{echo x}}", data), esc, "helper result")
  expect_out(reg.render_template("{{echo (echo x)}}", data), esc, "subexpression")
  expect_out(reg.render_template("{{lookup . 'x'}}", data), esc, "lookup")
  expect_out(reg.render_template("{{lookup a 0}}", data), esc, "lookup array")
  expect_out(reg.render_template("{{a}}", data), esc, "array to string")
  expect_out(reg.render_template("{{> p v=x}}", data), esc + "|" + x, "partial hash")
  expect_out(reg.render_template("{{#each a}}{{this}}{{/each}}", data), esc, "each this")
  expect_out(reg.render_template("{{{x}}}|{{& x}}", data), x + "|" + x, "raw forms")
  expect_out(
    reg.render_template("<a title={{x}}>", obj([("x", s("a onmouseover=alert(1)"))])),
    "<a title=a onmouseover&#x3D;alert(1)>",
    "unquoted attribute",
  )
}

///| Limits set to zero or negative values fail closed instead of disabling the limit.
test "control_limits_fail_closed" {
  let d = handlebars::HandlebarsLimits::default()
  let mk = fn(l : handlebars::HandlebarsLimits) -> Result[String, handlebars::HandlebarsError] {
    let reg = handlebars::Registry::with_limits(l)
    match reg.register_partial("p", "c") {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    reg.render_template("a{{x}}{{> p}}", obj([("x", s("b"))]))
  }
  expect_kind(
    mk(handlebars::HandlebarsLimits::{ ..d, max_output_bytes: 0 }),
    handlebars::ErrorKind::OutputLimitExceeded,
    "max_output_bytes=0",
  )
  expect_kind(
    mk(handlebars::HandlebarsLimits::{ ..d, max_output_bytes: -1 }),
    handlebars::ErrorKind::OutputLimitExceeded,
    "max_output_bytes=-1",
  )
  expect_kind(
    mk(handlebars::HandlebarsLimits::{ ..d, max_steps: -1L }),
    handlebars::ErrorKind::StepLimitExceeded,
    "max_steps=-1",
  )
  expect_kind(
    mk(handlebars::HandlebarsLimits::{ ..d, max_partial_depth: 0 }),
    handlebars::ErrorKind::PartialDepthLimitExceeded,
    "max_partial_depth=0",
  )
  expect_kind(
    mk(handlebars::HandlebarsLimits::{ ..d, max_depth: -1 }),
    handlebars::ErrorKind::DepthLimitExceeded,
    "max_depth=-1",
  )
}

///| Recursive and exponential partials are bounded by the documented limits.
test "control_partial_recursion_and_bombs" {
  let reg = handlebars::Registry::new()
  let names = ["p0", "p1", "p2", "p3", "p4", "p5", "p6", "p7", "p8", "p9", "p10"]
  let mut i = 0
  while i < 10 {
    match
    reg.register_partial(names[i], "{{> " + names[i + 1] + "}}{{> " + names[i + 1] + "}}") {
      Ok(()) => ()
      Err(e) => debug_assert(false, e.to_string())
    }
    i = i + 1
  }
  match reg.register_partial("p10", "x") {
    Ok(()) => ()
    Err(e) => debug_assert(false, e.to_string())
  }
  match reg.render_template("{{> p0}}", obj([])) {
    Ok(out) => debug_assert(out.length() == 1024, "2^10 bomb renders 1024 bytes")
    Err(e) => debug_assert(false, e.to_string())
  }
  match reg.register_partial("self", "x{{> self}}") {
    Ok(()) => ()
    Err(e) => debug_assert(false, e.to_string())
  }
  expect_kind(
    reg.render_template("{{> self}}", obj([])),
    handlebars::ErrorKind::PartialDepthLimitExceeded,
    "self",
  )
  expect_kind(
    reg.render_template("{{#*inline \"q\"}}{{> q}}{{/inline}}{{> q}}", obj([])),
    handlebars::ErrorKind::PartialDepthLimitExceeded,
    "inline self",
  )
}

///| Handlebars.js truthiness of if / unless / includeZero, each metadata and parent data frames.
test "control_truthiness_and_iteration_metadata" {
  let data = obj([
    ("f", handlebars::Value::bool(false)),
    ("z", handlebars::Value::int(0)),
    ("e", s("")),
    ("ea", handlebars::Value::array([])),
    ("n", handlebars::Value::null()),
    ("eo", obj([])),
    (
      "a",
      handlebars::Value::array([
        handlebars::Value::array([handlebars::Value::int(1), handlebars::Value::int(2)]),
        handlebars::Value::array([handlebars::Value::int(3)]),
      ]),
    ),
  ])
  expect_out(
    handlebars::render(
      "{{#if f}}1{{/if}}{{#if z}}2{{/if}}{{#if e}}3{{/if}}{{#if ea}}4{{/if}}{{#if n}}5{{/if}}{{#if eo}}6{{/if}}{{#if z includeZero=true}}7{{/if}}{{#unless z}}8{{/unless}}",
      data,
    ),
    "678",
    "truthiness",
  )
  expect_out(
    handlebars::render(
      "{{#each a}}{{#each this}}{{@../index}}.{{@index}}{{#if @first}}F{{/if}}{{#if @last}}L{{/if}} {{/each}}{{/each}}",
      data,
    ),
    "0.0F 0.1L 1.0FL ",
    "nested each",
  )
}
