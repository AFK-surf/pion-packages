///| Blind-spot workloads B1/B2/B3 (see audit/bench/gen_blind.py); output format of bench/pion_bench.

import "handlebars"

///|
fn fnv1a_str(seed : Int64, s : String) -> Int64 {
  let mut h = seed
  let n = s.length()
  let mut i = 0
  while i < n {
    h = ((h ^ s.code_unit_at(i).to_int64()) * 16777619L) & 0xFFFFFFFFL
    i = i + 1
  }
  h
}

///|
fn rd(world : World, dir : String, f : String) -> String {
  match fs_read(world, dir + "/" + f) {
    Ok(s) => s
    Err(_) => ""
  }
}

///|
fn data(world : World, dir : String, f : String) -> handlebars::Value {
  match handlebars::Value::from_json(rd(world, dir, f)) {
    Ok(v) => v
    Err(_) => handlebars::Value::null()
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mode = args[1]
  let dir = args[2]
  let mut iters = 0
  let a = args[3]
  let mut k = 0
  while k < a.length() {
    iters = iters * 10 + (a.code_unit_at(k) - 48)
    k = k + 1
  }
  let reg = handlebars::Registry::new()
  let mut v = handlebars::Value::null()
  let mut src = ""
  let mut tag = ""
  if mode == "b1" {
    tag = "B1"
    match reg.register_template("t", rd(world, dir, "b1_tmpl.hbs")) {
      Ok(()) => ()
      Err(_) => return 1
    }
    v = data(world, dir, "b1_data.json")
  } else if mode == "b2" {
    tag = "B2"
    let mut i = 0
    while i < 13 {
      match
      reg.register_partial(
        "p" + i.to_string(),
        rd(world, dir, "b2_p" + i.to_string() + ".hbs"),
      ) {
        Ok(()) => ()
        Err(_) => return 1
      }
      i = i + 1
    }
    match reg.register_template("t", "{{> p0}}") {
      Ok(()) => ()
      Err(_) => return 1
    }
    v = data(world, dir, "b2_data.json")
  } else {
    tag = "B3"
    src = rd(world, dir, "b3_tmpl.hbs")
    v = data(world, dir, "b3_data.json")
  }
  let mut total = 0L
  let mut ck = 2166136261L
  let mut first = ""
  let mut i = 0
  while i < iters {
    let r = if mode == "b3" {
      reg.render_template(src, v)
    } else {
      reg.render("t", v)
    }
    let out = match r {
      Ok(s) => s
      Err(_) => return 1
    }
    if i == 0 {
      first = out
    }
    total = total + out.length().to_int64()
    ck = fnv1a_str(ck, out)
    i = i + 1
  }
  io_println(world, first)
  io_println(
    world,
    tag +
    " iters=" +
    iters.to_string() +
    " total_bytes=" +
    total.to_string() +
    " checksum=" +
    ck.to_string(),
  )
  0
}
