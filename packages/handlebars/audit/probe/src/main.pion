///| Red-team differential / DoS probe for packages/handlebars.
/// usage: handlebars_audit_probe <cases.jsonl>
///   one JSON object per input line:
///     {"id", "tmpl", "data" (JSON text), "partials" {name: src}?, "strict"?, "no_escape"?, "limits"?}
///   one JSON object per output line:
///     {"id", "ok": true, "out"} | {"id", "ok": false, "kind", "msg"}
/// Helpers registered on every registry (mirrored by the Rust and Handlebars.js oracles):
///   `wrap` (block): returns the plain string "<b>" + fn(this) + "</b>"
///   `echo` (inline): returns its first parameter unchanged
///   `safe` (inline): returns its first parameter as a SafeString

import "handlebars"
import "json5"

///|
fn json_quote(sb : StringBuilder, s : String) -> Unit {
  sb.write_string("\"")
  let n = s.length()
  let mut mark = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 34 || c == 92 || c < 32 {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      if c == 34 {
        sb.write_string("\\\"")
      } else if c == 92 {
        sb.write_string("\\\\")
      } else if c == 10 {
        sb.write_string("\\n")
      } else if c == 13 {
        sb.write_string("\\r")
      } else if c == 9 {
        sb.write_string("\\t")
      } else {
        let hex = "0123456789abcdef"
        sb.write_string("\\u00")
        sb.write_substring(hex, c >> 4, (c >> 4) + 1)
        sb.write_substring(hex, c & 15, (c & 15) + 1)
      }
      mark = i + 1
    }
    i = i + 1
  }
  if mark < n {
    sb.write_substring(s, mark, n)
  }
  sb.write_string("\"")
}

///|
fn field(obj : json5::Json5Value, key : String) -> Option[json5::Json5Value] {
  json5::get(obj, key)
}

///|
fn str_field(obj : json5::Json5Value, key : String, dflt : String) -> String {
  match field(obj, key) {
    Some(json5::Json5Value::Str(s)) => s
    _ => dflt
  }
}

///|
fn bool_field(obj : json5::Json5Value, key : String) -> Bool {
  match field(obj, key) {
    Some(json5::Json5Value::Bool(b)) => b
    _ => false
  }
}

///|
fn num_field(obj : json5::Json5Value, key : String, dflt : Double) -> Double {
  match field(obj, key) {
    Some(json5::Json5Value::Number(f)) => f
    _ => dflt
  }
}

///|
fn make_registry(case : json5::Json5Value) -> handlebars::Registry {
  let d = handlebars::HandlebarsLimits::default()
  let limits = match field(case, "limits") {
    Some(l) =>
    handlebars::HandlebarsLimits::{
      max_depth: num_field(l, "max_depth", d.max_depth.to_double()).to_int(),
      max_partial_depth: num_field(
        l,
        "max_partial_depth",
        d.max_partial_depth.to_double(),
      ).to_int(),
      max_steps: num_field(l, "max_steps", d.max_steps.to_double()).to_int64(),
      max_output_bytes: num_field(
        l,
        "max_output_bytes",
        d.max_output_bytes.to_double(),
      ).to_int(),
      max_template_bytes: num_field(
        l,
        "max_template_bytes",
        d.max_template_bytes.to_double(),
      ).to_int(),
    }
    None => d
  }
  let reg = handlebars::Registry::with_limits(limits)
  reg.set_strict_mode(bool_field(case, "strict"))
  reg.set_no_escape(bool_field(case, "no_escape"))
  reg.register_helper(
    "wrap",
    fn(h : handlebars::HelperContext) -> Result[handlebars::Value, handlebars::HandlebarsError] {
      match h.fn_render(h.this_val) {
        Ok(s) => Ok(handlebars::Value::string("<b>" + s + "</b>"))
        Err(e) => Err(e)
      }
    },
  )
  reg.register_helper(
    "echo",
    fn(h : handlebars::HelperContext) -> Result[handlebars::Value, handlebars::HandlebarsError] {
      match h.param(0) {
        Some(v) => Ok(v)
        None => Ok(handlebars::Value::null())
      }
    },
  )
  reg.register_helper(
    "safe",
    fn(h : handlebars::HelperContext) -> Result[handlebars::Value, handlebars::HandlebarsError] {
      match h.param(0) {
        Some(handlebars::Value::Str(s)) => Ok(handlebars::Value::safe_string(s))
        Some(handlebars::Value::SafeStr(s)) => Ok(handlebars::Value::safe_string(s))
        _ => Ok(handlebars::Value::safe_string(""))
      }
    },
  )
  reg
}

///|
fn run_case(case : json5::Json5Value) -> Result[String, handlebars::HandlebarsError] {
  let reg = make_registry(case)
  match field(case, "partials") {
    Some(json5::Json5Value::Object(ps)) => {
      let mut i = 0
      while i < ps.length() {
        let (name, src) = ps[i]
        match src {
          json5::Json5Value::Str(s) =>
          match reg.register_partial(name, s) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
          _ => ()
        }
        i = i + 1
      }
    }
    _ => ()
  }
  let data = match handlebars::Value::from_json(str_field(case, "data", "{}")) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  reg.render_template(str_field(case, "tmpl", ""), data)
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: handlebars_audit_probe <cases.jsonl>")
    return 2
  }
  let src = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "cannot read " + args[1])
      return 2
    }
  }
  let n = src.length()
  let mut start = 0
  while start < n {
    let mut end = start
    while end < n && src.code_unit_at(end) != 10 {
      end = end + 1
    }
    if end > start {
      let lsb = StringBuilder::new()
      lsb.write_substring(src, start, end)
      let line = lsb.to_string()
      let sb = StringBuilder::new()
      match json5::parse(line) {
        Ok(case) => {
          sb.write_string("{\"id\":")
          json_quote(sb, str_field(case, "id", "?"))
          match run_case(case) {
            Ok(out) => {
              sb.write_string(",\"ok\":true,\"out\":")
              json_quote(sb, out)
            }
            Err(e) => {
              sb.write_string(",\"ok\":false,\"kind\":")
              json_quote(sb, handlebars::error_kind_as_str(e.kind))
              sb.write_string(",\"msg\":")
              json_quote(sb, e.to_string())
            }
          }
          sb.write_string("}")
        }
        Err(_) => sb.write_string("{\"id\":\"?\",\"ok\":false,\"kind\":\"CaseParse\",\"msg\":\"\"}")
      }
      io_println(world, sb.to_string())
    }
    start = end + 1
  }
  0
}
