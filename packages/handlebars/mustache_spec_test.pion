///| Mustache Spec v1.4.2 compliance tests:
///| interpolation, sections, inverted sections, comments, partials, delimiters, standalone whitespace.

fn m_assert_render(
  tmpl : String,
  data : Value,
  expected : String,
  label : String,
) -> Unit {
  match render(tmpl, data) {
    Ok(actual) =>
    debug_assert(
      actual == expected,
      label + ": expected `" + expected + "`, got `" + actual + "`",
    )
    Err(e) =>
    debug_assert(false, label + ": unexpected error: " + e.to_string())
  }
}

fn m_assert_reg_render(
  reg : Registry,
  tmpl : String,
  data : Value,
  expected : String,
  label : String,
) -> Unit {
  match reg.render_template(tmpl, data) {
    Ok(actual) =>
    debug_assert(
      actual == expected,
      label + ": expected `" + expected + "`, got `" + actual + "`",
    )
    Err(e) =>
    debug_assert(false, label + ": unexpected error: " + e.to_string())
  }
}

fn m_empty() -> Value {
  Value::object([])
}

///|
test "mustache_interpolation_basic_and_escaping" {
  m_assert_render(
    "Hello from {Mustache}!",
    m_empty(),
    "Hello from {Mustache}!",
    "no interpolation",
  )
  m_assert_render(
    "Hello, {{subject}}!",
    Value::object([("subject", Value::string("world"))]),
    "Hello, world!",
    "basic interpolation",
  )
  m_assert_render(
    "These characters should be HTML escaped: {{forbidden}}\n",
    Value::object([("forbidden", Value::string("& \" < >"))]),
    "These characters should be HTML escaped: &amp; &quot; &lt; &gt;\n",
    "html escaping",
  )
  m_assert_render(
    "These characters should not be HTML escaped: {{{forbidden}}}\n",
    Value::object([("forbidden", Value::string("& \" < >"))]),
    "These characters should not be HTML escaped: & \" < >\n",
    "triple mustache",
  )
  m_assert_render(
    "These characters should not be HTML escaped: {{&forbidden}}\n",
    Value::object([("forbidden", Value::string("& \" < >"))]),
    "These characters should not be HTML escaped: & \" < >\n",
    "ampersand unescaped",
  )
}

///|
test "mustache_interpolation_types_and_missing" {
  m_assert_render(
    "\"{{mph}} miles an hour!\"",
    Value::object([("mph", Value::int(85))]),
    "\"85 miles an hour!\"",
    "integer interpolation",
  )
  m_assert_render(
    "\"{{power}} jiggawatts!\"",
    Value::object([("power", Value::float(1.21))]),
    "\"1.21 jiggawatts!\"",
    "decimal interpolation",
  )
  m_assert_render(
    "I ({{cannot}}) be seen!",
    m_empty(),
    "I () be seen!",
    "context miss interpolation",
  )
  m_assert_render(
    "I ({{{cannot}}}) be seen!",
    m_empty(),
    "I () be seen!",
    "triple mustache context miss",
  )
  m_assert_render(
    "I ({{&cannot}}) be seen!",
    m_empty(),
    "I () be seen!",
    "ampersand context miss",
  )
  m_assert_render(
    "|{{   string   }}|",
    Value::object([("string", Value::string("---"))]),
    "|---|",
    "interpolation surrounding whitespace",
  )
  m_assert_render(
    "|{{{   string   }}}|",
    Value::object([("string", Value::string("---"))]),
    "|---|",
    "triple mustache surrounding whitespace",
  )
  m_assert_render(
    "|{{&   string   }}|",
    Value::object([("string", Value::string("---"))]),
    "|---|",
    "ampersand surrounding whitespace",
  )
}

///|
test "mustache_dotted_names_and_context_precedence" {
  let data = Value::object([
    ("client", Value::object([("name", Value::string("Joe"))])),
  ])
  m_assert_render(
    "\"{{client.name}}\" == \"{{#client}}{{name}}{{/client}}\"",
    data,
    "\"Joe\" == \"Joe\"",
    "dotted names basic",
  )
  // Dotted names - broken chains must NOT fall back to parent scope
  let broken = Value::object([
    ("a", Value::object([])),
    ("b", Value::object([("c", Value::string("ERROR"))])),
  ])
  m_assert_render(
    "\"{{a.b.c}}\" == \"\"",
    broken,
    "\"\" == \"\"",
    "dotted names broken chains",
  )
  // Dotted names - initial resolution finds nearest ancestor with first segment,
  // then resolves remaining segments strictly on that object
  let initial = Value::object([
    (
      "a",
      Value::object([
        ("b", Value::object([("c", Value::object([("d", Value::object([("e", Value::object([("name", Value::string("Phil"))]))]))]))])),
      ]),
    ),
    (
      "b",
      Value::object([
        ("c", Value::object([("d", Value::object([("e", Value::object([("name", Value::string("Wrong"))]))]))])),
      ]),
    ),
  ])
  m_assert_render(
    "{{#a}}{{b.c.d.e.name}}{{/a}}",
    initial,
    "Phil",
    "dotted names initial resolution",
  )
  // Context precedence: inner `a: {}` shadows outer `a: { b: "X" }`
  let prec = Value::object([
    ("a", Value::object([("b", Value::object([]))])),
    ("b", Value::object([("c", Value::string("ERROR"))])),
  ])
  m_assert_render(
    "{{#a}}{{b.c}}{{/a}}",
    prec,
    "",
    "dotted names context precedence",
  )
}

///|
test "mustache_sections_truthy_falsy_and_lists" {
  m_assert_render(
    "\"{{#boolean}}This should be rendered.{{/boolean}}\"",
    Value::object([("boolean", Value::bool(true))]),
    "\"This should be rendered.\"",
    "section truthy",
  )
  m_assert_render(
    "\"{{#boolean}}This should not be rendered.{{/boolean}}\"",
    Value::object([("boolean", Value::bool(false))]),
    "\"\"",
    "section falsy",
  )
  m_assert_render(
    "\"{{#context}}Hi {{name}}.{{/context}}\"",
    Value::object([
      ("context", Value::object([("name", Value::string("Joe"))])),
    ]),
    "\"Hi Joe.\"",
    "section object context",
  )
  m_assert_render(
    "\"{{#list}}{{item}}{{/list}}\"",
    Value::object([
      (
        "list",
        Value::array([
          Value::object([("item", Value::int(1))]),
          Value::object([("item", Value::int(2))]),
          Value::object([("item", Value::int(3))]),
        ]),
      ),
    ]),
    "\"123\"",
    "section list",
  )
  m_assert_render(
    "\"{{#list}}Yay lists!{{/list}}\"",
    Value::object([("list", Value::array([]))]),
    "\"\"",
    "section empty list",
  )
  m_assert_render(
    "\"{{#list}}({{.}}){{/list}}\"",
    Value::object([
      (
        "list",
        Value::array([
          Value::string("a"),
          Value::string("b"),
          Value::string("c"),
        ]),
      ),
    ]),
    "\"(a)(b)(c)\"",
    "implicit iterator string",
  )
  m_assert_render(
    "{{#bool}}first{{/bool}}\n* {{two}}\n{{#bool}}third{{/bool}}\n",
    Value::object([
      ("bool", Value::bool(true)),
      ("two", Value::string("second")),
    ]),
    "first\n* second\nthird\n",
    "doubled sections",
  )
}

///|
test "mustache_sections_deeply_nested_and_standalone" {
  let nested = Value::object([
    ("a", Value::object([("one", Value::int(1))])),
    ("b", Value::object([("two", Value::int(2))])),
    ("c", Value::object([("three", Value::int(3))])),
  ])
  m_assert_render(
    "{{#a}}{{one}}{{#b}}{{one}}{{two}}{{#c}}{{one}}{{two}}{{three}}{{/c}}{{/b}}{{/a}}",
    nested,
    "112123",
    "deeply nested contexts",
  )
  // Standalone lines for section open/close
  m_assert_render(
    "| This Is\n{{#boolean}}\n|\n{{/boolean}}\n| A Line\n",
    Value::object([("boolean", Value::bool(true))]),
    "| This Is\n|\n| A Line\n",
    "section standalone lines",
  )
  // Standalone indented lines
  m_assert_render(
    "| This Is\n  {{#boolean}}\n|\n  {{/boolean}}\n| A Line\n",
    Value::object([("boolean", Value::bool(true))]),
    "| This Is\n|\n| A Line\n",
    "section indented standalone lines",
  )
  // Standalone CRLF line endings
  m_assert_render(
    "|\r\n{{#boolean}}\r\n{{/boolean}}\r\n|",
    Value::object([("boolean", Value::bool(true))]),
    "|\r\n|",
    "section standalone crlf",
  )
  // Standalone without previous line / without trailing newline
  m_assert_render(
    "  {{#boolean}}\n#{{/boolean}}\n/",
    Value::object([("boolean", Value::bool(true))]),
    "#\n/",
    "section standalone without previous line",
  )
  m_assert_render(
    "#{{#boolean}}\n/\n  {{/boolean}}",
    Value::object([("boolean", Value::bool(true))]),
    "#\n/\n",
    "section standalone without newline",
  )
}

///|
test "mustache_inverted_sections" {
  m_assert_render(
    "\"{{^boolean}}This should be rendered.{{/boolean}}\"",
    Value::object([("boolean", Value::bool(false))]),
    "\"This should be rendered.\"",
    "inverted false",
  )
  m_assert_render(
    "\"{{^boolean}}This should not be rendered.{{/boolean}}\"",
    Value::object([("boolean", Value::bool(true))]),
    "\"\"",
    "inverted true",
  )
  m_assert_render(
    "\"{{^missing}}Rendered{{/missing}}\"",
    m_empty(),
    "\"Rendered\"",
    "inverted missing",
  )
  m_assert_render(
    "\"{{^list}}Yay lists!{{/list}}\"",
    Value::object([("list", Value::array([]))]),
    "\"Yay lists!\"",
    "inverted empty list",
  )
  m_assert_render(
    "\"{{^list}}{{n}}{{/list}}\"",
    Value::object([
      (
        "list",
        Value::array([Value::object([("n", Value::int(1))])]),
      ),
    ]),
    "\"\"",
    "inverted non-empty list",
  )
  m_assert_render(
    "| This Is\n{{^boolean}}\n|\n{{/boolean}}\n| A Line\n",
    Value::object([("boolean", Value::bool(false))]),
    "| This Is\n|\n| A Line\n",
    "inverted standalone lines",
  )
}

///|
test "mustache_comments_and_standalone" {
  m_assert_render(
    "12345{{! Comment Block! }}67890",
    m_empty(),
    "1234567890",
    "inline comment",
  )
  m_assert_render(
    "12345{{!\n  This is a\n  multi-line comment...\n}}67890\n",
    m_empty(),
    "1234567890\n",
    "multiline comment",
  )
  m_assert_render(
    "Begin.\n{{! Comment Block! }}\nEnd.\n",
    m_empty(),
    "Begin.\nEnd.\n",
    "standalone comment",
  )
  m_assert_render(
    "Begin.\n  {{! Indented Comment Block! }}\nEnd.\n",
    m_empty(),
    "Begin.\nEnd.\n",
    "indented standalone comment",
  )
  m_assert_render(
    "Begin.\n{{!\nSomething's going on here...\n}}\nEnd.\n",
    m_empty(),
    "Begin.\nEnd.\n",
    "multiline standalone comment",
  )
  m_assert_render(
    "12345{{!-- block {{comment}} with }} inside --}}67890",
    m_empty(),
    "1234567890",
    "handlebars block comment",
  )
  m_assert_render(
    "Begin.\n  {{!-- block\n  comment --}}\nEnd.\n",
    m_empty(),
    "Begin.\nEnd.\n",
    "standalone block comment",
  )
}

///|
test "mustache_partials_and_indentation" {
  let reg = Registry::new()
  debug_assert(reg.register_partial("text", "from partial").is_ok(), "reg text")
  m_assert_reg_render(reg, "\"{{>text}}\"", m_empty(), "\"from partial\"", "basic partial")

  // Context passed to partial
  debug_assert(reg.register_partial("partial", "*{{text}}*").is_ok(), "reg ctx partial")
  m_assert_reg_render(
    reg,
    "\"{{>partial}}\"",
    Value::object([("text", Value::string("content"))]),
    "\"*content*\"",
    "partial context",
  )

  // Standalone partial indentation
  let reg2 = Registry::new()
  debug_assert(
    reg2.register_partial("p", "|\n{{{content}}}\n|\n").is_ok(),
    "reg p",
  )
  m_assert_reg_render(
    reg2,
    "\\\n {{>p}}\n/\n",
    Value::object([("content", Value::string("<\n->"))]),
    "\\\n |\n <\n ->\n |\n/\n",
    "standalone partial indentation",
  )

  // Inline partial (not standalone) does NOT indent
  m_assert_reg_render(
    reg2,
    "  {{data}}  {{> p}}\n",
    Value::object([
      ("data", Value::string("|")),
      ("content", Value::string("x\ny")),
    ]),
    "  |  |\nx\ny\n|\n\n",
    "inline partial no indent",
  )

  // Recursion via partial with data termination
  let reg3 = Registry::new()
  debug_assert(
    reg3.register_partial("node", "{{content}}<{{#nodes}}{{>node}}{{/nodes}}>").is_ok(),
    "reg node",
  )
  let tree = Value::object([
    ("content", Value::string("X")),
    (
      "nodes",
      Value::array([
        Value::object([
          ("content", Value::string("Y")),
          ("nodes", Value::array([])),
        ]),
      ]),
    ),
  ])
  m_assert_reg_render(reg3, "{{>node}}", tree, "X<Y<>>", "recursive partial")
}

///|
test "mustache_delimiters" {
  m_assert_render(
    "{{=<% %>=}}(<%text%>)",
    Value::object([("text", Value::string("Hey!"))]),
    "(Hey!)",
    "pair behavior",
  )
  m_assert_render(
    "({{=[ ]=}}[text])",
    Value::object([("text", Value::string("It worked!"))]),
    "(It worked!)",
    "special characters",
  )
  // Delimiter change inside section persists after section
  m_assert_render(
    "[\n{{#section}}\n  {{data}}\n  |data|\n{{/section}}\n\n{{= | | =}}\n|#section|\n  {{data}}\n  |data|\n|/section|\n]\n",
    Value::object([
      ("section", Value::bool(true)),
      ("data", Value::string("I got interpolated.")),
    ]),
    "[\n  I got interpolated.\n  |data|\n\n  {{data}}\n  I got interpolated.\n]\n",
    "sections with delimiter change",
  )
  // Standalone delimiter tag
  m_assert_render(
    "Begin.\n{{=@ @=}}\nEnd.\n",
    m_empty(),
    "Begin.\nEnd.\n",
    "standalone delimiter tag",
  )
  // Delimiter change in partial does not leak to parent
  let reg = Registry::new()
  debug_assert(
    reg.register_partial("include", ".{{value}}.").is_ok(),
    "reg include",
  )
  m_assert_reg_render(
    reg,
    "[ {{>include}} ]\n[ {{= | | =}}|>include| ]\n",
    Value::object([("value", Value::string("yes"))]),
    "[ .yes. ]\n[ .yes. ]\n",
    "partial inherit default delimiters",
  )
  // Custom delimiter with unescaped ampersand and comment
  m_assert_render(
    "{{=<% %>=}}<%! ignore me %><%& html %>|<% html %>",
    Value::object([("html", Value::string("<b>"))]),
    "<b>|&lt;b&gt;",
    "custom delimiter unescaped and comment",
  )
}
