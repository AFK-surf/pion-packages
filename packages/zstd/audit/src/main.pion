///| RT-zstd red-team harness for `packages/zstd` (native + wasm32, see ../REPORT.md).
///|   dec <container> [max_in max_out max_window max_frames]  one line per record: `OK <len> <fnv64>` / `ERR <variant>`
///|   enc <level> <checksum 0|1> <container> <out_container>   compress every record, `OK <len>` / `ERR <variant>`
///|   xxh <container> <seed>                                  `xxhash64` of every record (16 hex digits)
///|   bomb <file> [limits x4] | cbomb <level> <file>           one input, summary + in-process microseconds
///|   list | case <name>                                       red-team / control cases (src/cases.pion)
///| A container is a sequence of records `u32 little-endian length` + bytes (written by diff/*.py).

import "zstd"

///|
pub fn parse_i64(s : String) -> Int64 {
  let n = s.length()
  let mut acc = 0L
  let mut neg = false
  let mut i = 0
  if n > 0 && s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10L + (c - 48).to_int64()
    }
    i = i + 1
  }
  if neg {
    0L - acc
  } else {
    acc
  }
}

///|
pub fn parse_int(s : String) -> Int {
  parse_i64(s).to_int()
}

///|
pub fn fnv64(data : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = data.length()
  let mut i = 0
  while i < n {
    h = (h ^ data[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

///|
pub fn hex64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    let nib = ((v >> (60 - 4 * i)) & 15UL).to_int()
    out[i] = (if nib < 10 { 48 + nib } else { 87 + nib }).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
pub fn err_name(e : zstd::ZstdError) -> String {
  match e {
    UnexpectedEof(_) => "UnexpectedEof"
    InvalidMagic(_) => "InvalidMagic"
    InvalidFrameHeader(_) => "InvalidFrameHeader"
    UnsupportedDictionary(_) => "UnsupportedDictionary"
    InvalidBlockHeader(_) => "InvalidBlockHeader"
    InvalidLiteralsHeader(_) => "InvalidLiteralsHeader"
    InvalidHuffmanTable(_) => "InvalidHuffmanTable"
    InvalidFseTable(_) => "InvalidFseTable"
    InvalidSequences(_) => "InvalidSequences"
    InvalidOffset(_) => "InvalidOffset"
    InvalidBitstream(_) => "InvalidBitstream"
    ChecksumMismatch(_) => "ChecksumMismatch"
    ContentSizeMismatch(_) => "ContentSizeMismatch"
    LimitExceeded(_) => "LimitExceeded"
    InvalidLevel(_) => "InvalidLevel"
  }
}

///| `OK <len> <fnv64>` or `ERR <variant>`.
pub fn dec_line(r : Result[Bytes, zstd::ZstdError]) -> String {
  match r {
    Ok(b) => "OK " + b.length().to_string() + " " + hex64(fnv64(b))
    Err(e) => "ERR " + err_name(e)
  }
}

///|
fn records(data : Bytes) -> Array[Bytes] {
  let out : Array[Bytes] = []
  let mut p = 0
  let n = data.length()
  while p + 4 <= n {
    let len = data[p].to_int() |
    (data[p + 1].to_int() << 8) |
    (data[p + 2].to_int() << 16) |
    (data[p + 3].to_int() << 24)
    p = p + 4
    if len < 0 || p + len > n {
      break
    }
    out.push(data.slice(p, p + len))
    p = p + len
  }
  out
}

///|
fn limits_of(args : Array[String], at : Int) -> zstd::ZstdLimits {
  if args.length() >= at + 4 {
    zstd::ZstdLimits::new(
      parse_int(args[at]),
      parse_int(args[at + 1]),
      parse_int(args[at + 2]),
      parse_int(args[at + 3]),
    )
  } else {
    zstd::ZstdLimits::default()
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: zstd_audit dec|enc|xxh|bomb|cbomb|list|case ...")
    return 2
  }
  let mode = args[1]
  if mode == "dec" && args.length() >= 3 {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 2
    }
    let lim = limits_of(args, 3)
    let recs = records(data)
    let sb = StringBuilder::new()
    let mut i = 0
    while i < recs.length() {
      sb.write_string(dec_line(zstd::decompress_with_limits(recs[i], lim)))
      sb.write_string("\n")
      i = i + 1
    }
    io_print(world, sb.to_string())
    return 0
  }
  if mode == "enc" && args.length() >= 6 {
    let level = parse_int(args[2])
    let chk = args[3] == "1"
    let data = match fs_read_bytes(world, args[4]) {
      Ok(b) => b
      Err(_) => return 2
    }
    let recs = records(data)
    let outs : Array[Bytes] = []
    let mut total = 0
    let sb = StringBuilder::new()
    let mut i = 0
    while i < recs.length() {
      let r = if chk {
        zstd::compress_with_checksum(recs[i], level)
      } else {
        zstd::compress_with_level(recs[i], level)
      }
      match r {
        Ok(b) => {
          outs.push(b)
          total = total + 4 + b.length()
          sb.write_string("OK " + b.length().to_string() + "\n")
        }
        Err(e) => {
          outs.push(Bytes::new(0))
          total = total + 4
          sb.write_string("ERR " + err_name(e) + "\n")
        }
      }
      i = i + 1
    }
    let buf = Bytes::new(total)
    let mut p = 0
    i = 0
    while i < outs.length() {
      let b = outs[i]
      let n = b.length()
      buf[p] = (n & 255).to_byte()
      buf[p + 1] = ((n >> 8) & 255).to_byte()
      buf[p + 2] = ((n >> 16) & 255).to_byte()
      buf[p + 3] = ((n >> 24) & 255).to_byte()
      p = p + 4
      let mut k = 0
      while k < n {
        buf[p + k] = b[k]
        k = k + 1
      }
      p = p + n
      i = i + 1
    }
    let _ = fs_write_bytes(world, args[5], buf)
    io_print(world, sb.to_string())
    return 0
  }
  if mode == "xxh" && args.length() >= 4 {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 2
    }
    let seed = parse_i64(args[3])
    let recs = records(data)
    let sb = StringBuilder::new()
    let mut i = 0
    while i < recs.length() {
      sb.write_string(hex64(zstd::xxhash64(recs[i], seed).to_uint64()) + "\n")
      i = i + 1
    }
    io_print(world, sb.to_string())
    return 0
  }
  if mode == "bomb" && args.length() >= 3 {
    let data = match fs_read_bytes(world, args[2]) {
      Ok(b) => b
      Err(_) => return 2
    }
    let lim = limits_of(args, 3)
    let t0 = clock_monotonic_us()
    let r = zstd::decompress_with_limits(data, lim)
    let t1 = clock_monotonic_us()
    io_println(world, dec_line(r) + " us=" + (t1 - t0).to_string())
    return 0
  }
  if mode == "cbomb" && args.length() >= 4 {
    let level = parse_int(args[2])
    let data = match fs_read_bytes(world, args[3]) {
      Ok(b) => b
      Err(_) => return 2
    }
    let t0 = clock_monotonic_us()
    let r = zstd::compress_with_level(data, level)
    let t1 = clock_monotonic_us()
    let s = match r {
      Ok(c) =>
      "OK " +
      c.length().to_string() +
      " roundtrip=" +
      (match zstd::decompress(c) {
        Ok(d) => if fnv64(d) == fnv64(data) && d.length() == data.length() { "ok" } else { "MISMATCH" }
        Err(e) => "ERR_" + err_name(e)
      })
      Err(e) => "ERR " + err_name(e)
    }
    io_println(world, s + " us=" + (t1 - t0).to_string())
    return 0
  }
  if mode == "list" {
    io_println(world, case_names().join(" "))
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = run_case(args[2])
    io_println(
      world,
      (if r == "" { "PASS " } else { "FAIL " }) +
      args[2] +
      (if r == "" { "" } else { " :: " + r }),
    )
    return 0
  }
  io_println(world, "bad arguments")
  2
}
