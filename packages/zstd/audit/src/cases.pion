///| Control (`control_*`) cases of the RT-zstd audit. Each returns "" on PASS, else the reasons.
///|
///| Control cases pin behaviour the package gets right (RFC 8878 expectations, official zstd frames, xxHash64 vectors,
///| compressor round trips); they must PASS before and after any fix, and the bug-injection gate of run_audit.sh
///| (diff/inject.py) relies on them. Red-team cases (`redteam_p<sev>_<n>_*`) would assert the RFC behaviour of an
///| open finding; this audit has none (see REPORT.md).

import "zstd"

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
pub fn unhex(s : String) -> Bytes {
  let n = s.length() / 2
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = (hexval(s.code_unit_at(2 * i)) * 16 + hexval(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  b
}

///|
fn split_commas(s : String) -> Array[String] {
  let out : Array[String] = []
  if s.length() == 0 {
    return out
  }
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == 44 {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(start, s.length()))
  out
}

///| Run every vector `[name, hex, want, limits]`; `want == "ERR"` accepts any error.
fn run_vectors(vs : Array[Array[String]]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < vs.length() {
    let v = vs[i]
    let lim = split_commas(v[3])
    let limits = if lim.length() == 4 {
      zstd::ZstdLimits::new(
        parse_int(lim[0]),
        parse_int(lim[1]),
        parse_int(lim[2]),
        parse_int(lim[3]),
      )
    } else {
      zstd::ZstdLimits::default()
    }
    let got = dec_line(zstd::decompress_with_limits(unhex(v[1]), limits))
    let fine = if v[2] == "ERR" {
      got.length() >= 3 && got.slice(0, 3) == "ERR"
    } else {
      got == v[2]
    }
    if !fine {
      sb.write_string(v[0] + ": got `" + got + "`, want `" + v[2] + "`; ")
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn xxh_input(n : Int, pat : Int) -> Bytes {
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = (if pat == 0 { (i * 167 + 13) & 255 } else { 255 }).to_byte()
    i = i + 1
  }
  b
}

///| xxHash64 against the specification model (lengths 0..1024, both stripe paths and every tail, sign-bit seeds).
fn case_xxhash() -> String {
  let vs = vectors_xxhash()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < vs.length() {
    let v = vs[i]
    let h = hex64(
      zstd::xxhash64(xxh_input(parse_int(v[0]), parse_int(v[1])), parse_i64(v[2])).to_uint64(),
    )
    if h != v[3] {
      sb.write_string(
        "len " + v[0] + " pat " + v[1] + " seed " + v[2] + ": " + h + " != " + v[3] + "; ",
      )
    }
    i = i + 1
  }
  sb.to_string()
}

///| Deterministic compressible input: words from a small vocabulary chosen by an LCG, plus runs and noise.
fn sample(n : Int, seed : Int) -> Bytes {
  let words = [
    "zstd ", "frame ", "block ", "literal ", "sequence ", "offset ", "window ", "huffman ",
    "entropy ", "the ", "of ", "and ", "\n",
  ]
  let b = Bytes::new(n)
  let mut x : UInt = seed.to_uint()
  let mut p = 0
  while p < n {
    x = x * 1103515245U + 12345U
    let r = ((x >> 16) & 0x7FFFU).to_int()
    if r % 29 == 0 {
      // a run
      let len = r % 50 + 4
      let mut k = 0
      while k < len && p < n {
        b[p] = (r & 255).to_byte()
        p = p + 1
        k = k + 1
      }
    } else if r % 31 == 0 {
      b[p] = (r * 7 & 255).to_byte()
      p = p + 1
    } else {
      let w = words[r % words.length()]
      let mut k = 0
      while k < w.length() && p < n {
        b[p] = w.code_unit_at(k).to_byte()
        p = p + 1
        k = k + 1
      }
    }
  }
  b
}

///| Compressor: levels 0..9 with and without checksum round-trip, frame header fields, invalid levels rejected.
fn case_compressor() -> String {
  let sb = StringBuilder::new()
  let inputs = [
    sample(0, 1),
    sample(1, 2),
    sample(100, 3),
    sample(5000, 4),
    sample(140000, 5),
    sample(300000, 6),
  ]
  let mut i = 0
  while i < inputs.length() {
    let d = inputs[i]
    let want = "OK " + d.length().to_string() + " " + hex64(fnv64(d))
    let mut lv = 0
    while lv <= 9 {
      let mut chk = 0
      while chk <= 1 {
        let r = if chk == 1 {
          zstd::compress_with_checksum(d, lv)
        } else {
          zstd::compress_with_level(d, lv)
        }
        match r {
          Ok(c) => {
            let got = dec_line(zstd::decompress(c))
            if got != want {
              sb.write_string(
                "input " + i.to_string() + " L" + lv.to_string() + " chk " + chk.to_string() +
                ": " + got + "; ",
              )
            }
            // checksum flag (FHD bit 2) set iff requested, reserved / unused / dictionary bits clear
            let fhd = c[4].to_int()
            if ((fhd >> 2) & 1) != chk || (fhd & 0x1B) != 0 {
              sb.write_string("input " + i.to_string() + " L" + lv.to_string() + ": FHD " + fhd.to_string() + "; ")
            }
            // a corrupted payload byte must be detected when the checksum is on
            if chk == 1 && d.length() > 0 {
              let bad = Bytes::new(c.length())
              let mut k = 0
              while k < c.length() {
                bad[k] = c[k]
                k = k + 1
              }
              bad[c.length() - 1] = (bad[c.length() - 1].to_int() ^ 1).to_byte()
              match zstd::decompress(bad) {
                Ok(_) => sb.write_string("input " + i.to_string() + " L" + lv.to_string() + ": corrupted checksum accepted; ")
                Err(_) => ()
              }
            }
          }
          Err(e) => sb.write_string("L" + lv.to_string() + ": " + err_name(e) + "; ")
        }
        chk = chk + 1
      }
      lv = lv + 1
    }
    i = i + 1
  }
  let levels = [-1, 10, 22, 2147483647]
  let mut k = 0
  while k < levels.length() {
    match zstd::compress_with_level(sample(10, 1), levels[k]) {
      Ok(_) => sb.write_string("level " + levels[k].to_string() + " accepted; ")
      Err(InvalidLevel(_)) => ()
      Err(e) => sb.write_string("level " + levels[k].to_string() + ": " + err_name(e) + "; ")
    }
    k = k + 1
  }
  // compress() is level 3
  match (zstd::compress(sample(5000, 4)), zstd::compress_with_level(sample(5000, 4), 3)) {
    (Ok(a), Ok(b)) => if fnv64(a) != fnv64(b) { sb.write_string("compress() != level 3; ") }
    _ => sb.write_string("compress() failed; ")
  }
  sb.to_string()
}

///|
pub fn case_names() -> Array[String] {
  [
    "control_frame_header", "control_skippable", "control_content_size", "control_checksum",
    "control_truncation", "control_blocks", "control_literals_raw_rle", "control_huffman",
    "control_treeless", "control_sequence_modes", "control_repeat_offsets", "control_offsets_window",
    "control_limits", "control_official_frames", "control_xxhash", "control_compressor",
  ]
}

///|
pub fn run_case(name : String) -> String {
  if name == "control_frame_header" {
    run_vectors(vectors_frame_header())
  } else if name == "control_skippable" {
    run_vectors(vectors_skippable())
  } else if name == "control_content_size" {
    run_vectors(vectors_content_size())
  } else if name == "control_checksum" {
    run_vectors(vectors_checksum())
  } else if name == "control_truncation" {
    run_vectors(vectors_truncation())
  } else if name == "control_blocks" {
    run_vectors(vectors_blocks())
  } else if name == "control_literals_raw_rle" {
    run_vectors(vectors_literals_raw_rle())
  } else if name == "control_huffman" {
    run_vectors(vectors_huffman())
  } else if name == "control_treeless" {
    run_vectors(vectors_treeless())
  } else if name == "control_sequence_modes" {
    run_vectors(vectors_sequence_modes())
  } else if name == "control_repeat_offsets" {
    run_vectors(vectors_repeat_offsets())
  } else if name == "control_offsets_window" {
    run_vectors(vectors_offsets_window())
  } else if name == "control_limits" {
    run_vectors(vectors_limits())
  } else if name == "control_official_frames" {
    run_vectors(vectors_official_frames())
  } else if name == "control_xxhash" {
    case_xxhash()
  } else if name == "control_compressor" {
    case_compressor()
  } else {
    "unknown case " + name
  }
}
