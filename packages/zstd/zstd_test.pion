///| RFC 8878 Zstandard compliance, roundtrip, xxHash64, and security DoS test suite.

///|
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn from_hex(s : String) -> Bytes {
  let n = s.length() / 2
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nibble(s.code_unit_at(i * 2))
    let lo = hex_nibble(s.code_unit_at(i * 2 + 1))
    b[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  b
}

///|
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  let n = a.length()
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn bytes_concat(a : Bytes, b : Bytes) -> Bytes {
  let out = Bytes::new(a.length() + b.length())
  let mut i = 0
  while i < a.length() {
    out[i] = a[i]
    i = i + 1
  }
  let mut j = 0
  while j < b.length() {
    out[a.length() + j] = b[j]
    j = j + 1
  }
  out
}

///|
fn make_json_fixture() -> Bytes {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 60 {
    sb.write_string("{\"id\":")
    sb.write_string(i.to_string())
    sb.write_string(",\"name\":\"item_")
    sb.write_string((i % 17).to_string())
    sb.write_string("\",\"val\":")
    sb.write_string((i * 37 + 13).to_string())
    sb.write_string(",\"msg\":\"hello zstd world ")
    sb.write_string(i.to_string())
    sb.write_string(" abcdefghijklmnopqrstuvwxyz\"}\n")
    i = i + 1
  }
  sb.to_string().to_bytes()
}

///|
fn assert_decompress_eq(
  compressed : Bytes,
  expected : Bytes,
  label : String,
) -> Unit {
  match decompress(compressed) {
    Ok(out) =>
    debug_assert(bytes_eq(out, expected), label + " output mismatch")
    Err(e) =>
    debug_assert(false, label + " failed: " + zstd_error_to_string(e))
  }
}

test "xxhash64: RFC / official reference vectors" {
  // xxHash64("", 0) == 0xEF46DB3751D8E999
  let h_empty = xxhash64(Bytes::new(0), 0L).to_uint64()
  debug_assert(h_empty == 0xEF46DB3751D8E999UL, "xxh64 empty seed=0")

  // xxHash64("", PRIME32_1 = 2654435761) == 0xAC75FDA2929B17EF (official Cyan4973 vector)
  let h_empty_s = xxhash64(Bytes::new(0), 2654435761L).to_uint64()
  debug_assert(h_empty_s == 0xAC75FDA2929B17EFUL, "xxh64 empty seed=PRIME32_1")

  // xxHash64("a", 0) == 0xD24EC4F1A98C6E5B
  let h_a = xxhash64("a".to_bytes(), 0L).to_uint64()
  debug_assert(h_a == 0xD24EC4F1A98C6E5BUL, "xxh64 'a' seed=0")

  // xxHash64("The quick brown fox jumps over the lazy dog", 0) == 0x0B242D361FDA71BC (43B, exercises 32B stripe + 8B + 1B tail)
  let h_fox = xxhash64(
    "The quick brown fox jumps over the lazy dog".to_bytes(),
    0L,
  ).to_uint64()
  debug_assert(h_fox == 0x0B242D361FDA71BCUL, "xxh64 fox 43B seed=0")

  // xxHash64("hello world\n", 0) low 32 bits == 0x207d6d8c
  let h_hw = xxhash64("hello world\n".to_bytes(), 0L).to_uint64()
  debug_assert((h_hw & 0xFFFFFFFFUL) == 0x207D6D8CUL, "xxh64 hello world low32")

  // 101-byte buffer cross-checked against zstd --check (low 32 bits == 0x2D4B183B)
  let buf = Bytes::new(101)
  let mut byte_gen : UInt = 2654435761U
  let mut i = 0
  while i < 101 {
    buf[i] = ((byte_gen >> 24) & 0xFFU).to_int().to_byte()
    byte_gen = byte_gen * 2654435761U
    i = i + 1
  }
  let h101_0 = xxhash64(buf, 0L).to_uint64()
  debug_assert((h101_0 & 0xFFFFFFFFUL) == 0x2D4B183BUL, "xxh64 101B low32 matches zstd")
}

test "rfc8878: golden empty, single-byte, hello, and raw block" {
  assert_decompress_eq(
    from_hex("28b52ffd240001000099e9d851"),
    Bytes::new(0),
    "empty",
  )
  assert_decompress_eq(
    from_hex("28b52ffd0458090000615b6e8ca9"),
    "a".to_bytes(),
    "single_a",
  )
  assert_decompress_eq(
    from_hex("28b52ffd045861000068656c6c6f20776f726c640a8c6d7d20"),
    "hello world\n".to_bytes(),
    "hello",
  )
  let incomp = Bytes::new(64)
  let mut i = 0
  while i < 64 {
    incomp[i] = ((i * 73 + 41) & 0xFF).to_byte()
    i = i + 1
  }
  assert_decompress_eq(
    from_hex(
      "28b52ffd04580102002972bb044d96df2871ba034c95de2770b9024b94dd266fb8014a93dc256eb7004992db246db6ff4891da236cb5fe4790d9226bb4fd468fd8216ab3fc458ed7201281ccb2",
    ),
    incomp,
    "raw_block_64",
  )
}

test "rfc8878: golden RLE, overlapping match, and levels -1/-9/-19" {
  let rle_exp = Bytes::new(1000)
  let mut i = 0
  while i < 1000 {
    rle_exp[i] = b'Z'
    i = i + 1
  }
  assert_decompress_eq(
    from_hex("28b52ffd04584d0000105a5a0100e32b80051a490214"),
    rle_exp,
    "rle_1000",
  )

  let ab_exp = Bytes::new(1000)
  i = 0
  while i < 1000 {
    ab_exp[i] = if (i & 1) == 0 { b'a' } else { b'b' }
    i = i + 1
  }
  assert_decompress_eq(
    from_hex("28b52ffd04584d00001061620100e3ab1c1695ed709d"),
    ab_exp,
    "ab_repeat_overlap",
  )

  let abc_exp = Bytes::new(1200)
  i = 0
  while i < 1200 {
    let m = i % 3
    abc_exp[i] = if m == 0 { b'a' } else if m == 1 { b'b' } else { b'c' }
    i = i + 1
  }
  assert_decompress_eq(
    from_hex("28b52ffd0460550000186162630100aaf8bb21eb9f0da0"),
    abc_exp,
    "abc_repeat_overlap",
  )

  let line = "The quick brown fox jumps over the lazy dog. 0123456789!\n"
  let sb = StringBuilder::new()
  i = 0
  while i < 40 {
    sb.write_string(line)
    i = i + 1
  }
  let text_exp = sb.to_string().to_bytes()
  assert_decompress_eq(
    from_hex(
      "28b52ffd0448150200940354686520717569636b2062726f776e20666f78206a756d7073206f76657220746865206c617a7920646f672e2030313233343536373839210a0100c90aee2b28dd6a3cff",
    ),
    text_exp,
    "text_l1",
  )
  assert_decompress_eq(
    from_hex(
      "28b52ffd0468150200940354686520717569636b2062726f776e20666f78206a756d7073206f76657220746865206c617a7920646f672e2030313233343536373839210a0100c90aee2b28dd6a3cff",
    ),
    text_exp,
    "text_l19",
  )
}

test "rfc8878: golden 4-stream Huffman, FSE weights, and FSE sequences" {
  let json_exp = make_json_fixture()
  let z_json_l3 = from_hex(
    "",
  )
  assert_decompress_eq(z_json_l3, json_exp, "json_l3")

  let z_json_l19 = from_hex(
    "",
  )
  assert_decompress_eq(z_json_l19, json_exp, "json_l19")
}

test "rfc8878: multi-frame concatenation with skippable frames" {
  let f1 = from_hex("28b52ffd045861000068656c6c6f20776f726c640a8c6d7d20")
  // Skippable frame magic 0x184D2A55 (LE: 55 2a 4d 18), size = 4 (04 00 00 00), payload = deadbeef
  let skip = from_hex("552a4d1804000000deadbeef")
  let f2 = from_hex("28b52ffd0458090000615b6e8ca9")
  let combined = bytes_concat(bytes_concat(f1, skip), f2)
  assert_decompress_eq(combined, "hello world\na".to_bytes(), "multi_frame_skip")
}

test "rfc8878: strict error handling & DoS limits" {
  // 1. Checksum 1-bit flip must fail with ChecksumMismatch
  let hello = from_hex("28b52ffd045861000068656c6c6f20776f726c640a8c6d7d20")
  let bad_chk = Bytes::new(hello.length())
  let mut i = 0
  while i < hello.length() {
    bad_chk[i] = hello[i]
    i = i + 1
  }
  bad_chk[bad_chk.length() - 1] =
  (bad_chk[bad_chk.length() - 1].to_int() ^ 1).to_byte()
  match decompress(bad_chk) {
    Err(ChecksumMismatch(_)) => ()
    _ => debug_assert(false, "expected ChecksumMismatch on 1-bit flip")
  }

  // 2. Truncated checksum must fail with UnexpectedEof
  match decompress(hello.slice(0, hello.length() - 1)) {
    Err(UnexpectedEof(_)) => ()
    _ => debug_assert(false, "expected UnexpectedEof on truncated checksum")
  }

  // 3. Reserved_bit (bit 3 of FHD) != 0 must fail with InvalidFrameHeader
  let bad_fhd = from_hex("28b52ffd2c00010000")
  match decompress(bad_fhd) {
    Err(InvalidFrameHeader(_)) => ()
    _ => debug_assert(false, "expected InvalidFrameHeader on reserved bit")
  }

  // 4. Reserved block type (type 3) must fail with InvalidBlockHeader
  // Frame magic + single_segment FHD (0x20) + FCS=0 (0x00) + block header (Last=1, Type=3, Size=0 => 0x07 0x00 0x00)
  let bad_blk = from_hex("28b52ffd2000070000")
  match decompress(bad_blk) {
    Err(InvalidBlockHeader(_)) => ()
    _ => debug_assert(false, "expected InvalidBlockHeader on reserved block type")
  }

  // 5. Non-zero Dictionary ID must fail with UnsupportedDictionary
  // FHD = 0x21 (single_segment=1, did_flag=1 => 1 byte DID), DID=0x42, FCS=0x00
  let dict_frame = from_hex("28b52ffd214200010000")
  match decompress(dict_frame) {
    Err(UnsupportedDictionary(_)) => ()
    _ => debug_assert(false, "expected UnsupportedDictionary")
  }

  // 6. Malicious 100 GB Frame_Content_Size Zip Bomb must fail with LimitExceeded without OOM
  // FHD = 0xE0 (FCS_flag=3 => 8 bytes, single_segment=1), FCS = 100 GiB (0x0000001900000000 LE)
  let bomb_fcs = from_hex("28b52ffde00000000019000000010000")
  match decompress(bomb_fcs) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded on 100 GB FCS")
  }

  // 7. Negative limits must fail with LimitExceeded
  let neg_lim = ZstdLimits::new(-1, 1024, 1024, 10)
  match decompress_with_limits(hello, neg_lim) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded on negative limit")
  }

  // 8. Zero max_output_bytes allows empty frame, rejects non-empty
  let zero_out = ZstdLimits::new(1024, 0, 1024, 10)
  let empty_f = from_hex("28b52ffd240001000099e9d851")
  match decompress_with_limits(empty_f, zero_out) {
    Ok(out) => debug_assert(out.length() == 0, "zero limit empty ok")
    Err(e) => debug_assert(false, "zero limit empty err: " + zstd_error_to_string(e))
  }
  match decompress_with_limits(hello, zero_out) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded on zero max_output_bytes")
  }

  // 9. Zero max_frames rejects any frame
  let zero_frames = ZstdLimits::new(1024, 1024, 1024, 0)
  match decompress_with_limits(empty_f, zero_frames) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded on zero max_frames")
  }

  // 10. ContentSizeMismatch: FCS says 5, actual block outputs 1
  // FHD=0x20 (single_segment=1, FCS 1B), FCS=5, Raw block Last=1 size=1 (0x09 0x00 0x00) + 'a'
  let fcs_mismatch = from_hex("28b52ffd200509000061")
  match decompress(fcs_mismatch) {
    Err(ContentSizeMismatch(_)) => ()
    _ => debug_assert(false, "expected ContentSizeMismatch")
  }

  // 11. Reserved sequence mode bits (low 2 bits != 0) must fail with InvalidSequences
  // FHD=0x20, FCS=10, Compressed block Last=1 size=4 (0x25 0x00 0x00):
  //   Raw lits 0 (0x00), num_seq=1 (0x01), modes=0x01 (reserved bit 0 set!), dummy byte 0x01
  let bad_seq_mode = from_hex("28b52ffd200a25000000010101")
  match decompress(bad_seq_mode) {
    Err(InvalidSequences(_)) => ()
    _ => debug_assert(false, "expected InvalidSequences on reserved mode bits")
  }

  // 12. Treeless literals without prior Huffman table must fail with InvalidLiteralsHeader
  // FHD=0x20, FCS=4, Compressed block Last=1 size=4 (0x25 0x00 0x00):
  //   Treeless lits (type=3, size_fmt=0 -> 3B header: 0x03 | (4<<4) | (1<<14) = 0x43 0x40 0x00) + 1B 0x80
  let bad_treeless = from_hex("28b52ffd200425000043400080")
  match decompress(bad_treeless) {
    Err(InvalidLiteralsHeader(_)) => ()
    _ => debug_assert(false, "expected InvalidLiteralsHeader on treeless without prior table")
  }

  // 13. Repeat sequence mode without prior FSE table must fail with InvalidSequences
  // FHD=0x20, FCS=4, Compressed block Last=1 size=4 (0x25 0x00 0x00):
  //   Raw lits 0 (0x00), num_seq=1 (0x01), modes=0xC0 (LL=Repeat(3)), dummy 0x80
  let bad_repeat_seq = from_hex("28b52ffd20042500000001c080")
  match decompress(bad_repeat_seq) {
    Err(InvalidSequences(_)) => ()
    _ => debug_assert(false, "expected InvalidSequences on repeat mode without prior table")
  }

  // 14. Window size exceeding max_window_bytes must fail with LimitExceeded
  let small_win = ZstdLimits::new(65536, 65536, 1024, 16)
  // hello frame has Window_Descriptor 0x58 -> 2 MiB window
  match decompress_with_limits(hello, small_win) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded on window > max_window_bytes")
  }

  // 15. RLE block bomb (100 KiB RLE) rejected when max_output_bytes = 1024
  // FHD=0x00 (single_seg=0), WD=0x50 (1 MiB), RLE block Last=1, Type=1, Size=102400 (0x019000 << 3 | 3 = 0x0C8003 => 03 80 0c), byte=0x41
  let rle_bomb = from_hex("28b52ffd005003800c41")
  let tiny_out = ZstdLimits::new(65536, 1024, 2097152, 16)
  match decompress_with_limits(rle_bomb, tiny_out) {
    Err(LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded on RLE block bomb")
  }
}

test "compressor: multi-block (>128 KiB) and RLE block roundtrips" {
  // 1. 180 KiB RLE payload (spans 2 blocks > 128 KiB)
  let rle_big = Bytes::new(180000)
  let mut i = 0
  while i < 180000 {
    rle_big[i] = b'Q'
    i = i + 1
  }
  match compress_with_checksum(rle_big, 3) {
    Ok(c) => {
      debug_assert(c.length() < 64, "RLE 180 KiB should compress to < 64 bytes")
      assert_decompress_eq(c, rle_big, "rle_180k")
    }
    Err(e) => debug_assert(false, "rle_180k compress: " + zstd_error_to_string(e))
  }

  // 2. 160 KiB structured text (spans 2 blocks > 128 KiB, exercises cross-block window & repeat offsets)
  let sb = StringBuilder::new()
  i = 0
  while i < 1800 {
    sb.write_string("{\"seq\":")
    sb.write_string(i.to_string())
    sb.write_string(",\"path\":\"/v1/items/")
    sb.write_string((i % 29).to_string())
    sb.write_string("\",\"ok\":true,\"note\":\"zstd multi-block test payload\"}\n")
    i = i + 1
  }
  let big_text = sb.to_string().to_bytes()
  debug_assert(big_text.length() > 131072, "big_text > 128 KiB")
  match compress_with_checksum(big_text, 3) {
    Ok(c) => {
      debug_assert(c.length() < big_text.length() / 4, "big_text good compression ratio")
      assert_decompress_eq(c, big_text, "big_text_160k_L3")
    }
    Err(e) => debug_assert(false, "big_text compress: " + zstd_error_to_string(e))
  }
}

test "compressor: roundtrip levels 0, 1, 3, 6, 9 with and without checksum" {
  let payload = make_json_fixture()
  let levels = [0, 1, 3, 6, 9]
  let mut idx = 0
  while idx < levels.length() {
    let lvl = levels[idx]
    match compress_with_level(payload, lvl) {
      Ok(c) => assert_decompress_eq(c, payload, "roundtrip L" + lvl.to_string())
      Err(e) => debug_assert(false, "compress L" + lvl.to_string() + ": " + zstd_error_to_string(e))
    }
    match compress_with_checksum(payload, lvl) {
      Ok(c) => {
        assert_decompress_eq(c, payload, "roundtrip chk L" + lvl.to_string())
        // Flip last byte to verify checksum is present and checked
        let bad = Bytes::new(c.length())
        let mut j = 0
        while j < c.length() {
          bad[j] = c[j]
          j = j + 1
        }
        bad[bad.length() - 1] = (bad[bad.length() - 1].to_int() ^ 1).to_byte()
        match decompress(bad) {
          Err(ChecksumMismatch(_)) => ()
          _ => debug_assert(false, "expected ChecksumMismatch for L" + lvl.to_string())
        }
      }
      Err(e) => debug_assert(false, "compress_chk L" + lvl.to_string() + ": " + zstd_error_to_string(e))
    }
    idx = idx + 1
  }

  // Invalid compression levels rejected
  match compress_with_level(payload, -1) {
    Err(InvalidLevel(_)) => ()
    _ => debug_assert(false, "expected InvalidLevel(-1)")
  }
  match compress_with_level(payload, 10) {
    Err(InvalidLevel(_)) => ()
    _ => debug_assert(false, "expected InvalidLevel(10)")
  }
}
