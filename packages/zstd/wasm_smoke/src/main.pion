///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/zstd`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "zstd"

///|
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn from_hex(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nibble(s.code_unit_at(i * 2))
    let lo = hex_nibble(s.code_unit_at(i * 2 + 1))
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  let n = a.length()
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

///|
fn make_payload(len : Int) -> Bytes {
  let out = Bytes::new(len)
  let mut s : UInt = 0x12345678U
  let mut i = 0
  while i < len {
    let mod16 = i & 15
    if mod16 < 10 {
      out[i] = (97 + ((i / 16 + mod16) % 26)).to_byte()
    } else if mod16 == 10 {
      out[i] = b' '
    } else if mod16 == 15 {
      out[i] = b'\n'
    } else {
      s = s * 1664525U + 1013904223U
      out[i] = (48 + ((s >> 24).to_int() % 10)).to_byte()
    }
    i = i + 1
  }
  out
}

///|
pub fn main(world : World) -> Int {
  // 1. xxHash64 golden vector
  let xxh_fox = zstd::xxhash64(
    "The quick brown fox jumps over the lazy dog".to_bytes(),
    0L,
  ).to_uint64()
  if xxh_fox != 0x0B242D361FDA71BCUL {
    io_println(world, "ERR xxh64 mismatch")
    return 1
  }

  // 2. Empty stream roundtrip with checksum
  let empty = Bytes::new(0)
  let z_empty = match zstd::compress_with_checksum(empty, 3) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR empty compress: " + zstd::zstd_error_to_string(e))
      return 2
    }
  }
  match zstd::decompress(z_empty) {
    Ok(d) => if d.length() != 0 { return 3 }
    Err(e) => {
      io_println(world, "ERR empty decompress: " + zstd::zstd_error_to_string(e))
      return 4
    }
  }

  // 3. Official zstd CLI golden stream (4-stream Huffman + FSE + checksum)
  let golden_hello = from_hex(
    "28b52ffd045861000068656c6c6f20776f726c640a8c6d7d20",
  )
  let dec_hello = match zstd::decompress(golden_hello) {
    Ok(d) => d
    Err(e) => {
      io_println(world, "ERR golden hello: " + zstd::zstd_error_to_string(e))
      return 5
    }
  }
  if !bytes_eq(dec_hello, "hello world\n".to_bytes()) {
    return 6
  }

  // 3b. Official zstd -19 golden stream (4-stream Huffman + FSE weights + FSE sequences + checksum)
  let golden_json = from_hex(
    "",
  )
  let dec_json = match zstd::decompress(golden_json) {
    Ok(d) => d
    Err(e) => {
      io_println(world, "ERR golden json: " + zstd::zstd_error_to_string(e))
      return 23
    }
  }
  if dec_json.length() != 5491 {
    return 24
  }

  // 4. Multi-level compress + decompress (L0, L1, L3, L6)
  let single = make_payload(8192)
  let c0 = match zstd::compress_with_level(single, 0) {
    Ok(b) => b
    Err(_) => return 7
  }
  let c1 = match zstd::compress_with_level(single, 1) {
    Ok(b) => b
    Err(_) => return 8
  }
  let c3 = match zstd::compress_with_checksum(single, 3) {
    Ok(b) => b
    Err(_) => return 9
  }
  let c6 = match zstd::compress_with_checksum(single, 6) {
    Ok(b) => b
    Err(_) => return 10
  }
  match zstd::decompress(c0) {
    Ok(d) => if !bytes_eq(d, single) { return 11 }
    Err(_) => return 12
  }
  match zstd::decompress(c1) {
    Ok(d) => if !bytes_eq(d, single) { return 13 }
    Err(e) => {
      io_println(
        world,
        "ERR L1 decompress: " + zstd::zstd_error_to_string(e) +
        " c1_len=" + c1.length().to_string() +
        " c1_xxh=" + hex_u64(zstd::xxhash64(c1, 0L).to_uint64()) +
        " single_xxh=" + hex_u64(zstd::xxhash64(single, 0L).to_uint64()),
      )
      return 14
    }
  }
  match zstd::decompress(c3) {
    Ok(d) => if !bytes_eq(d, single) { return 15 }
    Err(_) => return 16
  }
  match zstd::decompress(c6) {
    Ok(d) => if !bytes_eq(d, single) { return 17 }
    Err(_) => return 18
  }

  // 5. Multi-block (> 128 KiB) roundtrip
  let multi = make_payload(150000)
  let c_multi = match zstd::compress_with_checksum(multi, 3) {
    Ok(b) => b
    Err(_) => return 19
  }
  match zstd::decompress(c_multi) {
    Ok(d) => if !bytes_eq(d, multi) { return 20 }
    Err(_) => return 21
  }

  // 6. DoS limits check: 100 GB FCS rejected without OOM
  let bomb_fcs = from_hex("28b52ffde00000000019000000010000")
  match zstd::decompress(bomb_fcs) {
    Err(LimitExceeded(_)) => ()
    _ => return 22
  }

  io_println(world, "zstd_wasm_smoke:ok")
  io_println(world, "xxh64_fox=" + hex_u64(xxh_fox))
  io_println(
    world,
    "empty=" + z_empty.length().to_string() +
    " l0=" + c0.length().to_string() +
    " l1=" + c1.length().to_string() +
    " l3=" + c3.length().to_string() +
    " l6=" + c6.length().to_string(),
  )
  io_println(
    world,
    "multi_in=" + multi.length().to_string() +
    " multi_out=" + c_multi.length().to_string() +
    " multi_xxh=" + hex_u64(zstd::xxhash64(c_multi, 0L).to_uint64()),
  )
  0
}
