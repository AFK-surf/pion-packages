///| Public entry points for `packages/zstd`.
///| Pure Pion zero-dependency RFC 8878 Zstandard decompressor, compressor, and xxHash64.

///| Decompress a Zstandard stream using default `ZstdLimits`
///| (64 MiB input, 64 MiB output, 8 MiB window, 1024 frames).
pub fn decompress(data : Bytes) -> Result[Bytes, ZstdError] {
  decompress_with_limits(data, ZstdLimits::default())
}

///| Compress `data` using the default compression level (level 3, no content checksum).
pub fn compress(data : Bytes) -> Result[Bytes, ZstdError] {
  compress_internal(data, 3, false)
}

///| Compress `data` at `level` (0..=9, without content checksum).
pub fn compress_with_level(
  data : Bytes,
  level : Int,
) -> Result[Bytes, ZstdError] {
  compress_internal(data, level, false)
}

///| Compress `data` at `level` (0..=9) with an RFC 8878 xxHash64 content checksum.
pub fn compress_with_checksum(
  data : Bytes,
  level : Int,
) -> Result[Bytes, ZstdError] {
  compress_internal(data, level, true)
}
