///| Pure-Pion RFC 8878 Zstandard compressor (levels 0..9, optional xxHash64 checksum).
///| Produces 100% standard-compliant Zstandard frames verified against official `zstd -d`
///| and Rust `ruzstd`.

///| Simple growable byte writer for encoding frames and blocks.
struct ByteVec {
  mut buf : Bytes
  mut len : Int
}

///|
fn ByteVec::new(cap : Int) -> ByteVec {
  let c = if cap < 64 { 64 } else { cap }
  ByteVec::{ buf: Bytes::new(c), len: 0 }
}

///|
fn ByteVec::ensure(self : ByteVec, extra : Int) -> Unit {
  if self.len + extra <= self.buf.length() {
    return
  }
  let mut new_cap = self.buf.length() * 2
  while new_cap < self.len + extra {
    new_cap = new_cap * 2
  }
  let nb = Bytes::new(new_cap)
  let mut i = 0
  while i < self.len {
    nb[i] = self.buf[i]
    i = i + 1
  }
  self.buf = nb
}

///|
fn ByteVec::push_byte(self : ByteVec, b : Byte) -> Unit {
  self.ensure(1)
  self.buf[self.len] = b
  self.len = self.len + 1
}

///|
fn ByteVec::push_u16_le(self : ByteVec, v : Int) -> Unit {
  self.ensure(2)
  self.buf[self.len] = (v & 255).to_byte()
  self.buf[self.len + 1] = ((v >> 8) & 255).to_byte()
  self.len = self.len + 2
}

///|
fn ByteVec::push_u24_le(self : ByteVec, v : Int) -> Unit {
  self.ensure(3)
  self.buf[self.len] = (v & 255).to_byte()
  self.buf[self.len + 1] = ((v >> 8) & 255).to_byte()
  self.buf[self.len + 2] = ((v >> 16) & 255).to_byte()
  self.len = self.len + 3
}

///|
fn ByteVec::push_u32_le(self : ByteVec, v : UInt) -> Unit {
  self.ensure(4)
  self.buf[self.len] = (v & 255U).to_int().to_byte()
  self.buf[self.len + 1] = ((v >> 8) & 255U).to_int().to_byte()
  self.buf[self.len + 2] = ((v >> 16) & 255U).to_int().to_byte()
  self.buf[self.len + 3] = ((v >> 24) & 255U).to_int().to_byte()
  self.len = self.len + 4
}

///|
fn ByteVec::push_slice(
  self : ByteVec,
  src : Bytes,
  start : Int,
  count : Int,
) -> Unit {
  if count <= 0 {
    return
  }
  self.ensure(count)
  let dst = self.buf
  let mut dp = self.len
  let mut sp = start
  let end = start + count
  while sp + 4 <= end {
    dst[dp] = src[sp]
    dst[dp + 1] = src[sp + 1]
    dst[dp + 2] = src[sp + 2]
    dst[dp + 3] = src[sp + 3]
    dp = dp + 4
    sp = sp + 4
  }
  while sp < end {
    dst[dp] = src[sp]
    dp = dp + 1
    sp = sp + 1
  }
  self.len = dp
}

///|
fn ByteVec::push_fixed_slice(
  self : ByteVec,
  src : FixedArray[Byte],
  start : Int,
  count : Int,
) -> Unit {
  if count <= 0 {
    return
  }
  self.ensure(count)
  let dst = self.buf
  let mut dp = self.len
  let mut sp = start
  let end = start + count
  while sp + 4 <= end {
    dst[dp] = src[sp]
    dst[dp + 1] = src[sp + 1]
    dst[dp + 2] = src[sp + 2]
    dst[dp + 3] = src[sp + 3]
    dp = dp + 4
    sp = sp + 4
  }
  while sp < end {
    dst[dp] = src[sp]
    dp = dp + 1
    sp = sp + 1
  }
  self.len = dp
}

///|
fn ByteVec::to_bytes(self : ByteVec) -> Bytes {
  if self.len == self.buf.length() {
    self.buf
  } else {
    self.buf.slice(0, self.len)
  }
}

///|
fn is_all_same_byte(data : Bytes, start : Int, len : Int) -> Bool {
  if len <= 1 {
    return false
  }
  let first = data[start]
  let mut i = start + 1
  let end = start + len
  while i < end {
    if data[i] != first {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn is_all_same_byte_arr(data : FixedArray[Byte], start : Int, len : Int) -> Bool {
  if len <= 1 {
    return false
  }
  let first = data[start]
  let mut i = start + 1
  let end = start + len
  while i < end {
    if data[i] != first {
      return false
    }
    i = i + 1
  }
  true
}

///| Count matching bytes starting at `p1` and `p2` (already matched 4 bytes), up to `blk_end`.
fn count_match_len(data : Bytes, p1 : Int, p2 : Int, blk_end : Int) -> Int {
  let mut a = p1 + 4
  let mut b = p2 + 4
  while b + 4 <= blk_end &&
  data[a] == data[b] &&
  data[a + 1] == data[b + 1] &&
  data[a + 2] == data[b + 2] &&
  data[a + 3] == data[b + 3] {
    a = a + 4
    b = b + 4
  }
  while b < blk_end && data[a] == data[b] {
    a = a + 1
    b = b + 1
  }
  b - p2
}

///| Reusable scratch buffers and repeat offsets across blocks of a single compression call.
struct CompScratch {
  lit_buf : FixedArray[Byte]
  seq_ll : FixedArray[Int]
  seq_ml : FixedArray[Int]
  seq_ov : FixedArray[Int]
  ll_codes : FixedArray[Int]
  of_codes : FixedArray[Int]
  ml_codes : FixedArray[Int]
  blk_buf : ByteVec
  bw_buf : FixedArray[Byte]
  mut lit_len : Int
  mut num_seq : Int
  mut rep1 : Int
  mut rep2 : Int
  mut rep3 : Int
  mut next_rep1 : Int
  mut next_rep2 : Int
  mut next_rep3 : Int
}

///| Initialize FSE encoder state for symbol `s` (FSE_initCState2).
fn fse_init_cstate(tbl : FseEncTable, s : Int) -> Int {
  let nb_bits_out = (tbl.delta_nb_bits[s] + 32768) >> 16
  let init_val = (nb_bits_out << 16) - tbl.delta_nb_bits[s]
  tbl.state_table[(init_val >> nb_bits_out) + tbl.delta_find_state[s]]
}

///| Encode literals section (Raw, RLE, or Huffman) into `blk`.
fn write_literals_section(
  blk : ByteVec,
  lits : FixedArray[Byte],
  lit_len : Int,
) -> Unit {
  if lit_len == 0 {
    // Raw literals, size=0 (1-byte header: 0x00)
    blk.push_byte((0).to_byte())
    return
  }
  if is_all_same_byte_arr(lits, 0, lit_len) {
    // RLE_Literals_Block (type 1)
    if lit_len < 32 {
      blk.push_byte(((lit_len << 3) | 1).to_byte())
    } else if lit_len < 4096 {
      let h = (lit_len << 4) | 5
      blk.push_u16_le(h)
    } else {
      let h = (lit_len << 4) | 13
      blk.push_u24_le(h)
    }
    blk.push_byte(lits[0])
    return
  }

  // Try Huffman compression if literals are large enough
  match huff_try_encode_literals(lits, lit_len) {
    Some((huf_payload, four_streams)) => {
      let comp_len = huf_payload.length()
      if !four_streams && lit_len < 1024 && comp_len < 1024 {
        let h = 2 | (lit_len << 4) | (comp_len << 14)
        blk.push_u24_le(h)
      } else if four_streams && lit_len < 1024 && comp_len < 1024 {
        let h = 2 | (1 << 2) | (lit_len << 4) | (comp_len << 14)
        blk.push_u24_le(h)
      } else if four_streams && lit_len < 16384 && comp_len < 16384 {
        let h = (2 | (2 << 2) | (lit_len << 4) | (comp_len << 18)).to_uint()
        blk.push_u32_le(h)
      } else {
        // 5-byte header (size_fmt = 3, 18-bit regen & comp sizes)
        let v : UInt64 = 2UL | (3UL << 2) |
        (lit_len.to_int64().to_uint64() << 4) |
        (comp_len.to_int64().to_uint64() << 22)
        blk.push_u32_le((v & 0xFFFFFFFFUL).to_int().to_uint())
        blk.push_byte(((v >> 32) & 255UL).to_int().to_byte())
      }
      blk.push_slice(huf_payload, 0, comp_len)
      return
    }
    None => ()
  }

  // Fallback: Raw_Literals_Block (type 0)
  if lit_len < 32 {
    blk.push_byte((lit_len << 3).to_byte())
  } else if lit_len < 4096 {
    blk.push_u16_le((lit_len << 4) | 4)
  } else {
    blk.push_u24_le((lit_len << 4) | 12)
  }
  blk.push_fixed_slice(lits, 0, lit_len)
}

///| Record one LZ77 match (copy literals + append sequence) into `scratch`.
///| Kept out of `lz77_find_sequences` so `lit_buf`/`seq_*` pointers don't spill registers in the per-byte loop.
fn emit_lz77_match(
  data : Bytes,
  anchor : Int,
  ll : Int,
  best_len : Int,
  offset_val : Int,
  scratch : CompScratch,
) -> Unit {
  if ll > 0 {
    let lit_buf = scratch.lit_buf
    let mut lit_len = scratch.lit_len
    let mut sp = anchor
    let end_sp = anchor + ll
    while sp + 4 <= end_sp {
      lit_buf[lit_len] = data[sp]
      lit_buf[lit_len + 1] = data[sp + 1]
      lit_buf[lit_len + 2] = data[sp + 2]
      lit_buf[lit_len + 3] = data[sp + 3]
      lit_len = lit_len + 4
      sp = sp + 4
    }
    while sp < end_sp {
      lit_buf[lit_len] = data[sp]
      lit_len = lit_len + 1
      sp = sp + 1
    }
    scratch.lit_len = lit_len
  }
  let idx = scratch.num_seq
  scratch.seq_ll[idx] = ll
  scratch.seq_ml[idx] = best_len
  scratch.seq_ov[idx] = offset_val
  scratch.num_seq = idx + 1
}

///| Phase 1 of block compression: LZ77 hash-chain match finding.
///| Split from FSE sequence encoding and match emission to minimize QBE register spilling.
fn lz77_find_sequences(
  data : Bytes,
  blk_start : Int,
  blk_len : Int,
  max_window : Int,
  chain_limit : Int,
  hash_shift : Int,
  head : FixedArray[Int],
  prev : FixedArray[Int],
  prev_mask : Int,
  scratch : CompScratch,
) -> (Int, Int) {
  let blk_end = blk_start + blk_len
  scratch.lit_len = 0
  scratch.num_seq = 0

  let mut rep1 = scratch.rep1
  let mut rep2 = scratch.rep2
  let mut rep3 = scratch.rep3
  let mut anchor = blk_start
  let mut pos = blk_start
  let match_limit = blk_end - 4

  while pos <= match_limit {
    // Load 4 bytes once and insert current position into hash chain
    let b0 = data[pos]
    let b1 = data[pos + 1]
    let b2 = data[pos + 2]
    let b3 = data[pos + 3]
    let v4 = b0.to_int().to_uint() |
    (b1.to_int().to_uint() << 8) |
    (b2.to_int().to_uint() << 16) |
    (b3.to_int().to_uint() << 24)
    let h = ((v4 * 2654435761U) >> hash_shift).to_int()
    let mut cand = head[h]
    prev[pos & prev_mask] = cand
    head[h] = pos

    let mut best_len = 3
    let mut best_off = 0
    let mut best_is_rep = false

    // 1. Check repeat offsets first (high value: tiny offset encoding!)
    let cur_ll = pos - anchor
    let try_rep = if cur_ll == 0 { rep2 } else { rep1 }
    if try_rep > 0 && try_rep <= pos && try_rep <= max_window {
      let rp = pos - try_rep
      if data[rp] == b0 &&
      data[rp + 1] == b1 &&
      data[rp + 2] == b2 &&
      data[rp + 3] == b3 {
        best_len = count_match_len(data, rp, pos, blk_end)
        best_off = try_rep
        best_is_rep = true
      }
    }

    // 2. Search hash chain inline (zero tuple heap allocation)
    if best_len < 64 && pos + best_len < blk_end {
      let min_pos = if pos > max_window { pos - max_window } else { 0 }
      let mut end_b = data[pos + best_len]
      let mut steps = 0
      while cand >= min_pos && steps < chain_limit {
        let off = pos - cand
        if off > 0 && off <= max_window {
          if data[cand + best_len] == end_b &&
          data[cand] == b0 &&
          data[cand + 1] == b1 &&
          data[cand + 2] == b2 &&
          data[cand + 3] == b3 {
            let m = count_match_len(data, cand, pos, blk_end)
            if m > best_len + (if best_is_rep { 1 } else { 0 }) {
              best_len = m
              best_off = off
              best_is_rep = false
              if best_len >= 128 || pos + best_len >= blk_end {
                break
              }
              end_b = data[pos + best_len]
            }
          }
        }
        let next_cand = prev[cand & prev_mask]
        if next_cand >= cand {
          break
        }
        cand = next_cand
        steps = steps + 1
      }
    }

    if best_off > 0 && best_len >= 4 {
      let ll = pos - anchor

      // Compute RFC 8878 offset_value and update repeat offsets
      let offset_val = if ll == 0 {
        if best_off == rep2 {
          rep2 = rep1
          rep1 = best_off
          1
        } else if best_off == rep3 {
          rep3 = rep2
          rep2 = rep1
          rep1 = best_off
          2
        } else if best_off == rep1 - 1 && best_off > 0 {
          rep3 = rep2
          rep2 = rep1
          rep1 = best_off
          3
        } else {
          rep3 = rep2
          rep2 = rep1
          rep1 = best_off
          best_off + 3
        }
      } else if best_off == rep1 {
        1
      } else if best_off == rep2 {
        rep2 = rep1
        rep1 = best_off
        2
      } else if best_off == rep3 {
        rep3 = rep2
        rep2 = rep1
        rep1 = best_off
        3
      } else {
        rep3 = rep2
        rep2 = rep1
        rep1 = best_off
        best_off + 3
      }

      emit_lz77_match(data, anchor, ll, best_len, offset_val, scratch)

      // Insert skipped positions into hash table (up to a cap for speed)
      let next_pos = pos + best_len
      let insert_end = if next_pos - 1 < match_limit {
        next_pos - 1
      } else {
        match_limit
      }
      let mut ip = pos + 1
      let mut inserted = 0
      while ip <= insert_end && inserted < 16 {
        let iv = data[ip].to_int().to_uint() |
        (data[ip + 1].to_int().to_uint() << 8) |
        (data[ip + 2].to_int().to_uint() << 16) |
        (data[ip + 3].to_int().to_uint() << 24)
        let ih = ((iv * 2654435761U) >> hash_shift).to_int()
        prev[ip & prev_mask] = head[ih]
        head[ih] = ip
        ip = ip + 1
        inserted = inserted + 1
      }
      pos = next_pos
      anchor = next_pos
    } else {
      pos = pos + 1
    }
  }

  // Trailing literals
  if anchor < blk_end {
    let lit_buf = scratch.lit_buf
    let mut lit_len = scratch.lit_len
    let mut sp = anchor
    while sp + 4 <= blk_end {
      lit_buf[lit_len] = data[sp]
      lit_buf[lit_len + 1] = data[sp + 1]
      lit_buf[lit_len + 2] = data[sp + 2]
      lit_buf[lit_len + 3] = data[sp + 3]
      lit_len = lit_len + 4
      sp = sp + 4
    }
    while sp < blk_end {
      lit_buf[lit_len] = data[sp]
      lit_len = lit_len + 1
      sp = sp + 1
    }
    scratch.lit_len = lit_len
  }

  scratch.next_rep1 = rep1
  scratch.next_rep2 = rep2
  scratch.next_rep3 = rep3
  (scratch.lit_len, scratch.num_seq)
}

///| Phase 2 of block compression: encode literals + FSE/Predefined/RLE sequences into `scratch.blk_buf`.
fn encode_sequences_fse(
  blk_len : Int,
  lit_len : Int,
  num_seq : Int,
  scratch : CompScratch,
  ll_base : FixedArray[Int],
  ll_bits : FixedArray[Int],
  ml_base : FixedArray[Int],
  ml_bits : FixedArray[Int],
  enc_ll : FseEncTable,
  enc_of : FseEncTable,
  enc_ml : FseEncTable,
) -> Int {
  let blk = scratch.blk_buf
  blk.len = 0
  write_literals_section(blk, scratch.lit_buf, lit_len)

  // Sequences header
  if num_seq == 0 {
    blk.push_byte((0).to_byte())
    if blk.len < blk_len {
      scratch.rep1 = scratch.next_rep1
      scratch.rep2 = scratch.next_rep2
      scratch.rep3 = scratch.next_rep3
      return blk.len
    }
    return -1
  }

  if num_seq < 128 {
    blk.push_byte(num_seq.to_byte())
  } else if num_seq < 0x7F00 {
    blk.push_byte(((num_seq >> 8) + 128).to_byte())
    blk.push_byte((num_seq & 255).to_byte())
  } else {
    let rem = num_seq - 0x7F00
    blk.push_byte(255.to_byte())
    blk.push_u16_le(rem)
  }

  let seq_ll = scratch.seq_ll
  let seq_ml = scratch.seq_ml
  let seq_ov = scratch.seq_ov
  let ll_codes = scratch.ll_codes
  let of_codes = scratch.of_codes
  let ml_codes = scratch.ml_codes
  let mut ll_const = true
  let mut of_const = true
  let mut ml_const = true
  let mut i = 0
  while i < num_seq {
    let lc = ll_to_code(seq_ll[i])
    let oc = high_bit(seq_ov[i])
    let mc = ml_to_code(seq_ml[i])
    ll_codes[i] = lc
    of_codes[i] = oc
    ml_codes[i] = mc
    if i > 0 {
      if lc != ll_codes[0] {
        ll_const = false
      }
      if oc != of_codes[0] {
        of_const = false
      }
      if mc != ml_codes[0] {
        ml_const = false
      }
    }
    i = i + 1
  }

  let ll_mode = if ll_const { 1 } else { 0 }
  let of_mode = if of_const { 1 } else { 0 }
  let ml_mode = if ml_const { 1 } else { 0 }
  let modes_byte = (ll_mode << 6) | (of_mode << 4) | (ml_mode << 2)
  blk.push_byte(modes_byte.to_byte())
  if ll_mode == 1 {
    blk.push_byte(ll_codes[0].to_byte())
  }
  if of_mode == 1 {
    blk.push_byte(of_codes[0].to_byte())
  }
  if ml_mode == 1 {
    blk.push_byte(ml_codes[0].to_byte())
  }

  // Encode sequences in reverse order directly into scratch.bw_buf using local bit buffer
  let bw_buf = scratch.bw_buf
  let mut bw_len = 0
  let mut bit_buf : UInt64 = 0UL
  let mut bit_cnt = 0

  let last = num_seq - 1
  let mut st_ll = if ll_mode == 0 {
    fse_init_cstate(enc_ll, ll_codes[last])
  } else {
    0
  }
  let mut st_of = if of_mode == 0 {
    fse_init_cstate(enc_of, of_codes[last])
  } else {
    0
  }
  let mut st_ml = if ml_mode == 0 {
    fse_init_cstate(enc_ml, ml_codes[last])
  } else {
    0
  }

  // Extra bits for last sequence: LL, ML, OF
  let lc_last = ll_codes[last]
  let mc_last = ml_codes[last]
  let oc_last = of_codes[last]
  let lnb_last = ll_bits[lc_last]
  if lnb_last > 0 {
    let lv = (seq_ll[last] - ll_base[lc_last]).to_int64().to_uint64()
    bit_buf = bit_buf | ((lv & ((1UL << lnb_last) - 1UL)) << bit_cnt)
    bit_cnt = bit_cnt + lnb_last
  }
  let mnb_last = ml_bits[mc_last]
  if mnb_last > 0 {
    let mv = (seq_ml[last] - ml_base[mc_last]).to_int64().to_uint64()
    bit_buf = bit_buf | ((mv & ((1UL << mnb_last) - 1UL)) << bit_cnt)
    bit_cnt = bit_cnt + mnb_last
  }
  if bit_cnt >= 32 {
    bw_buf[bw_len] = (bit_buf & 255UL).to_int().to_byte()
    bw_buf[bw_len + 1] = ((bit_buf >> 8) & 255UL).to_int().to_byte()
    bw_buf[bw_len + 2] = ((bit_buf >> 16) & 255UL).to_int().to_byte()
    bw_buf[bw_len + 3] = ((bit_buf >> 24) & 255UL).to_int().to_byte()
    bw_len = bw_len + 4
    bit_buf = bit_buf >> 32
    bit_cnt = bit_cnt - 32
  }
  if oc_last > 0 {
    let ov = (seq_ov[last] - (1 << oc_last)).to_int64().to_uint64()
    bit_buf = bit_buf | ((ov & ((1UL << oc_last) - 1UL)) << bit_cnt)
    bit_cnt = bit_cnt + oc_last
  }
  if bit_cnt >= 32 {
    bw_buf[bw_len] = (bit_buf & 255UL).to_int().to_byte()
    bw_buf[bw_len + 1] = ((bit_buf >> 8) & 255UL).to_int().to_byte()
    bw_buf[bw_len + 2] = ((bit_buf >> 16) & 255UL).to_int().to_byte()
    bw_buf[bw_len + 3] = ((bit_buf >> 24) & 255UL).to_int().to_byte()
    bw_len = bw_len + 4
    bit_buf = bit_buf >> 32
    bit_cnt = bit_cnt - 32
  }

  let of_dnb = enc_of.delta_nb_bits
  let of_dfs = enc_of.delta_find_state
  let of_st = enc_of.state_table
  let ml_dnb = enc_ml.delta_nb_bits
  let ml_dfs = enc_ml.delta_find_state
  let ml_st = enc_ml.state_table
  let ll_dnb = enc_ll.delta_nb_bits
  let ll_dfs = enc_ll.delta_find_state
  let ll_st = enc_ll.state_table

  let mut idx = last - 1
  while idx >= 0 {
    let lc = ll_codes[idx]
    let mc = ml_codes[idx]
    let oc = of_codes[idx]

    // State transitions in reverse of decoder order: OF, ML, LL
    if of_mode == 0 {
      let nb = (st_of + of_dnb[oc]) >> 16
      if nb > 0 {
        bit_buf = bit_buf |
        ((st_of.to_int64().to_uint64() & ((1UL << nb) - 1UL)) << bit_cnt)
        bit_cnt = bit_cnt + nb
      }
      st_of = of_st[(st_of >> nb) + of_dfs[oc]]
    }
    if ml_mode == 0 {
      let nb = (st_ml + ml_dnb[mc]) >> 16
      if nb > 0 {
        bit_buf = bit_buf |
        ((st_ml.to_int64().to_uint64() & ((1UL << nb) - 1UL)) << bit_cnt)
        bit_cnt = bit_cnt + nb
      }
      st_ml = ml_st[(st_ml >> nb) + ml_dfs[mc]]
    }
    if ll_mode == 0 {
      let nb = (st_ll + ll_dnb[lc]) >> 16
      if nb > 0 {
        bit_buf = bit_buf |
        ((st_ll.to_int64().to_uint64() & ((1UL << nb) - 1UL)) << bit_cnt)
        bit_cnt = bit_cnt + nb
      }
      st_ll = ll_st[(st_ll >> nb) + ll_dfs[lc]]
    }
    if bit_cnt >= 32 {
      bw_buf[bw_len] = (bit_buf & 255UL).to_int().to_byte()
      bw_buf[bw_len + 1] = ((bit_buf >> 8) & 255UL).to_int().to_byte()
      bw_buf[bw_len + 2] = ((bit_buf >> 16) & 255UL).to_int().to_byte()
      bw_buf[bw_len + 3] = ((bit_buf >> 24) & 255UL).to_int().to_byte()
      bw_len = bw_len + 4
      bit_buf = bit_buf >> 32
      bit_cnt = bit_cnt - 32
    }

    // Extra bits in reverse of decoder order: LL, ML, OF
    let lnb = ll_bits[lc]
    if lnb > 0 {
      let lv = (seq_ll[idx] - ll_base[lc]).to_int64().to_uint64()
      bit_buf = bit_buf | ((lv & ((1UL << lnb) - 1UL)) << bit_cnt)
      bit_cnt = bit_cnt + lnb
    }
    let mnb = ml_bits[mc]
    if mnb > 0 {
      let mv = (seq_ml[idx] - ml_base[mc]).to_int64().to_uint64()
      bit_buf = bit_buf | ((mv & ((1UL << mnb) - 1UL)) << bit_cnt)
      bit_cnt = bit_cnt + mnb
    }
    if bit_cnt >= 32 {
      bw_buf[bw_len] = (bit_buf & 255UL).to_int().to_byte()
      bw_buf[bw_len + 1] = ((bit_buf >> 8) & 255UL).to_int().to_byte()
      bw_buf[bw_len + 2] = ((bit_buf >> 16) & 255UL).to_int().to_byte()
      bw_buf[bw_len + 3] = ((bit_buf >> 24) & 255UL).to_int().to_byte()
      bw_len = bw_len + 4
      bit_buf = bit_buf >> 32
      bit_cnt = bit_cnt - 32
    }
    if oc > 0 {
      let ov = (seq_ov[idx] - (1 << oc)).to_int64().to_uint64()
      bit_buf = bit_buf | ((ov & ((1UL << oc) - 1UL)) << bit_cnt)
      bit_cnt = bit_cnt + oc
      if bit_cnt >= 32 {
        bw_buf[bw_len] = (bit_buf & 255UL).to_int().to_byte()
        bw_buf[bw_len + 1] = ((bit_buf >> 8) & 255UL).to_int().to_byte()
        bw_buf[bw_len + 2] = ((bit_buf >> 16) & 255UL).to_int().to_byte()
        bw_buf[bw_len + 3] = ((bit_buf >> 24) & 255UL).to_int().to_byte()
        bw_len = bw_len + 4
        bit_buf = bit_buf >> 32
        bit_cnt = bit_cnt - 32
      }
    }

    idx = idx - 1
  }

  // Final states in reverse of decoder initial read order: ML, OF, LL
  if ml_mode == 0 {
    let al = enc_ml.accuracy_log
    let v = (st_ml - (1 << al)).to_int64().to_uint64()
    bit_buf = bit_buf | ((v & ((1UL << al) - 1UL)) << bit_cnt)
    bit_cnt = bit_cnt + al
  }
  if of_mode == 0 {
    let al = enc_of.accuracy_log
    let v = (st_of - (1 << al)).to_int64().to_uint64()
    bit_buf = bit_buf | ((v & ((1UL << al) - 1UL)) << bit_cnt)
    bit_cnt = bit_cnt + al
  }
  if ll_mode == 0 {
    let al = enc_ll.accuracy_log
    let v = (st_ll - (1 << al)).to_int64().to_uint64()
    bit_buf = bit_buf | ((v & ((1UL << al) - 1UL)) << bit_cnt)
    bit_cnt = bit_cnt + al
  }
  if bit_cnt >= 32 {
    bw_buf[bw_len] = (bit_buf & 255UL).to_int().to_byte()
    bw_buf[bw_len + 1] = ((bit_buf >> 8) & 255UL).to_int().to_byte()
    bw_buf[bw_len + 2] = ((bit_buf >> 16) & 255UL).to_int().to_byte()
    bw_buf[bw_len + 3] = ((bit_buf >> 24) & 255UL).to_int().to_byte()
    bw_len = bw_len + 4
    bit_buf = bit_buf >> 32
    bit_cnt = bit_cnt - 32
  }
  // Sentinel 1-bit + flush remaining bytes
  bit_buf = bit_buf | (1UL << bit_cnt)
  bit_cnt = bit_cnt + 1
  while bit_cnt > 0 {
    bw_buf[bw_len] = (bit_buf & 255UL).to_int().to_byte()
    bw_len = bw_len + 1
    bit_buf = bit_buf >> 8
    bit_cnt = if bit_cnt >= 8 { bit_cnt - 8 } else { 0 }
  }

  blk.push_fixed_slice(bw_buf, 0, bw_len)

  if blk.len < blk_len {
    scratch.rep1 = scratch.next_rep1
    scratch.rep2 = scratch.next_rep2
    scratch.rep3 = scratch.next_rep3
    blk.len
  } else {
    -1
  }
}

///| Compress a single block `data[blk_start .. blk_start + blk_len]` using LZ77 + FSE/Predefined/RLE.
///| Writes result into `scratch.blk_buf` and returns its length (or `-1` if not smaller than `blk_len`).
fn compress_block_lz77(
  data : Bytes,
  blk_start : Int,
  blk_len : Int,
  max_window : Int,
  chain_limit : Int,
  hash_bits : Int,
  head : FixedArray[Int],
  prev : FixedArray[Int],
  prev_mask : Int,
  scratch : CompScratch,
  ll_base : FixedArray[Int],
  ll_bits : FixedArray[Int],
  ml_base : FixedArray[Int],
  ml_bits : FixedArray[Int],
  enc_ll : FseEncTable,
  enc_of : FseEncTable,
  enc_ml : FseEncTable,
) -> Int {
  let (lit_len, num_seq) = lz77_find_sequences(
    data,
    blk_start,
    blk_len,
    max_window,
    chain_limit,
    32 - hash_bits,
    head,
    prev,
    prev_mask,
    scratch,
  )
  encode_sequences_fse(
    blk_len,
    lit_len,
    num_seq,
    scratch,
    ll_base,
    ll_bits,
    ml_base,
    ml_bits,
    enc_ll,
    enc_of,
    enc_ml,
  )
}

///| Internal compression entry point.
fn compress_internal(
  data : Bytes,
  level : Int,
  with_checksum : Bool,
) -> Result[Bytes, ZstdError] {
  if level < 0 || level > 9 {
    return Err(ZstdError::InvalidLevel(level))
  }
  let n = data.length()
  let out = ByteVec::new(n + 32)

  // Magic number
  out.push_u32_le(zstd_magic)

  // Frame Header Descriptor: Single_Segment=1 when n <= 128 KiB, else Window_Descriptor (1 MiB window)
  let use_single_seg = n <= 131072
  let chk_bit = if with_checksum { 4 } else { 0 }
  if use_single_seg {
    if n < 256 {
      // fcs_flag=0, single_segment=1 => 1-byte FCS
      out.push_byte((0x20 | chk_bit).to_byte())
      out.push_byte(n.to_byte())
    } else if n < 65792 {
      // fcs_flag=1, single_segment=1 => 2-byte FCS (n - 256)
      out.push_byte((0x60 | chk_bit).to_byte())
      out.push_u16_le(n - 256)
    } else {
      // fcs_flag=2, single_segment=1 => 4-byte FCS
      out.push_byte((0xA0 | chk_bit).to_byte())
      out.push_u32_le(n.to_uint())
    }
  } else {
    // Window_Descriptor = 1 MiB (exponent = 10 => 1 << 20 = 1048576, mantissa = 0 => 0x50)
    // fcs_flag=2 (4-byte FCS), single_segment=0
    out.push_byte((0x80 | chk_bit).to_byte())
    out.push_byte(0x50.to_byte())
    out.push_u32_le(n.to_uint())
  }

  // Empty input: emit 1 empty Raw_Block with Last_Block=1
  if n == 0 {
    out.push_u24_le(1)
    if with_checksum {
      let chk = (xxhash64_slice(data, 0, 0, 0UL) & 0xFFFFFFFFUL).to_int().to_uint()
      out.push_u32_le(chk)
    }
    return Ok(out.to_bytes())
  }

  // Level parameters
  let max_window = if use_single_seg { n } else { 1048576 }
  let chain_limit = if level == 0 {
    0
  } else if level == 1 {
    1
  } else if level == 2 {
    2
  } else if level == 3 {
    4
  } else if level == 4 {
    8
  } else if level == 5 {
    16
  } else if level == 6 {
    32
  } else if level == 7 {
    64
  } else if level == 8 {
    128
  } else {
    256
  }

  let ll_base = build_ll_base()
  let ll_bits = build_ll_bits()
  let ml_base = build_ml_base()
  let ml_bits = build_ml_bits()
  let enc_ll = fse_build_enc_table(build_predef_ll_norm(), 35, 6)
  let enc_of = fse_build_enc_table(build_predef_of_norm(), 28, 5)
  let enc_ml = fse_build_enc_table(build_predef_ml_norm(), 52, 6)

  let hash_bits = if level <= 2 { 13 } else { 15 }
  let hash_size = 1 << hash_bits
  let head : FixedArray[Int] = if level > 0 {
    FixedArray::make(hash_size, -1)
  } else {
    FixedArray::make(1, -1)
  }
  let prev_size = if level > 0 {
    if n < 65536 { 65536 } else { 131072 }
  } else {
    1
  }
  let prev_mask = prev_size - 1
  let prev : FixedArray[Int] = FixedArray::make(prev_size, -1)

  let max_blk = if n > max_block_size_limit { max_block_size_limit } else { n }
  let max_seqs = if level > 0 { max_blk / 4 + 1 } else { 1 }
  let scratch = CompScratch::{
    lit_buf: FixedArray::make(if level > 0 { max_blk } else { 0 }, (0).to_byte()),
    seq_ll: FixedArray::make(max_seqs, 0),
    seq_ml: FixedArray::make(max_seqs, 0),
    seq_ov: FixedArray::make(max_seqs, 0),
    ll_codes: FixedArray::make(max_seqs, 0),
    of_codes: FixedArray::make(max_seqs, 0),
    ml_codes: FixedArray::make(max_seqs, 0),
    blk_buf: if level > 0 { ByteVec::new(max_blk + 64) } else { ByteVec::new(1) },
    bw_buf: FixedArray::make(
      if level > 0 { max_seqs * 12 + 64 } else { 0 },
      (0).to_byte(),
    ),
    lit_len: 0,
    num_seq: 0,
    rep1: 1,
    rep2: 4,
    rep3: 8,
    next_rep1: 1,
    next_rep2: 4,
    next_rep3: 8,
  }
  let mut pos = 0

  while pos < n {
    let rem = n - pos
    let blk_len = if rem > max_block_size_limit {
      max_block_size_limit
    } else {
      rem
    }
    let last_flag = if pos + blk_len == n { 1 } else { 0 }

    if is_all_same_byte(data, pos, blk_len) {
      // RLE_Block (type 1): 3-byte header + 1 byte
      let bh = last_flag | (1 << 1) | (blk_len << 3)
      out.push_u24_le(bh)
      out.push_byte(data[pos])
    } else if level == 0 || blk_len < 16 {
      // Raw_Block (type 0)
      let bh = last_flag | (blk_len << 3)
      out.push_u24_le(bh)
      out.push_slice(data, pos, blk_len)
    } else {
      let cblk_len = compress_block_lz77(
        data,
        pos,
        blk_len,
        max_window,
        chain_limit,
        hash_bits,
        head,
        prev,
        prev_mask,
        scratch,
        ll_base,
        ll_bits,
        ml_base,
        ml_bits,
        enc_ll,
        enc_of,
        enc_ml,
      )
      if cblk_len >= 0 {
        let bh = last_flag | (2 << 1) | (cblk_len << 3)
        out.push_u24_le(bh)
        out.push_slice(scratch.blk_buf.buf, 0, cblk_len)
      } else {
        // Fallback to Raw_Block (repeat offsets unchanged!)
        let bh = last_flag | (blk_len << 3)
        out.push_u24_le(bh)
        out.push_slice(data, pos, blk_len)
      }
    }

    pos = pos + blk_len
  }

  if with_checksum {
    let chk = (xxhash64_slice(data, 0, n, 0UL) & 0xFFFFFFFFUL).to_int().to_uint()
    out.push_u32_le(chk)
  }

  Ok(out.to_bytes())
}
