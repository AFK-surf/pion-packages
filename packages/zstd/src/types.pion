///| Public types, error variants, and DoS limits for `packages/zstd`.
///| Pure Pion implementation of RFC 8878 (Zstandard Compression and the
///| 'application/zstd' Media Type) and xxHash64.

///| Default maximum compressed input bytes accepted by `decompress` (64 MiB).
pub let default_max_input_bytes : Int = 67108864

///| Default maximum decompressed output bytes accepted by `decompress` (64 MiB).
pub let default_max_output_bytes : Int = 67108864

///| Default maximum sliding window size accepted by `decompress` (8 MiB).
pub let default_max_window_bytes : Int = 8388608

///| Default maximum number of frames (standard + skippable) per stream.
pub let default_max_frames : Int = 1024

///| Runtime maximum `Bytes` container length (2^31 - 17).
let max_container_bytes : Int = 2147483631

///| Decompression resource limits to defend against Zip Bombs and memory exhaustion.
///| Any negative limit is rejected with `ZstdError::LimitExceeded`.
///| A limit of `0` is strictly enforced.
pub val struct ZstdLimits {
  pub max_input_bytes : Int
  pub max_output_bytes : Int
  pub max_window_bytes : Int
  pub max_frames : Int
}

///| Default decompression limits (64 MiB input, 64 MiB output, 8 MiB window, 1024 frames).
pub fn ZstdLimits::default() -> ZstdLimits {
  ZstdLimits::{
    max_input_bytes: default_max_input_bytes,
    max_output_bytes: default_max_output_bytes,
    max_window_bytes: default_max_window_bytes,
    max_frames: default_max_frames,
  }
}

///| Construct custom decompression limits.
pub fn ZstdLimits::new(
  max_input_bytes : Int,
  max_output_bytes : Int,
  max_window_bytes : Int,
  max_frames : Int,
) -> ZstdLimits {
  ZstdLimits::{
    max_input_bytes: max_input_bytes,
    max_output_bytes: max_output_bytes,
    max_window_bytes: max_window_bytes,
    max_frames: max_frames,
  }
}

///| Error returned by Zstandard decompression or compression.
pub enum ZstdError {
  UnexpectedEof(String)
  InvalidMagic(UInt)
  InvalidFrameHeader(String)
  UnsupportedDictionary(UInt)
  InvalidBlockHeader(String)
  InvalidLiteralsHeader(String)
  InvalidHuffmanTable(String)
  InvalidFseTable(String)
  InvalidSequences(String)
  InvalidOffset(String)
  InvalidBitstream(String)
  ChecksumMismatch(String)
  ContentSizeMismatch(String)
  LimitExceeded(String)
  InvalidLevel(Int)
}

///| Format a `ZstdError` as a human-readable diagnostic string.
pub fn zstd_error_to_string(err : ZstdError) -> String {
  match err {
    UnexpectedEof(msg) => "unexpected EOF: " + msg
    InvalidMagic(magic) => "invalid zstd magic: " + magic.to_int64().to_string()
    InvalidFrameHeader(msg) => "invalid frame header: " + msg
    UnsupportedDictionary(id) =>
    "unsupported dictionary id: " + id.to_int64().to_string()
    InvalidBlockHeader(msg) => "invalid block header: " + msg
    InvalidLiteralsHeader(msg) => "invalid literals header: " + msg
    InvalidHuffmanTable(msg) => "invalid Huffman table: " + msg
    InvalidFseTable(msg) => "invalid FSE table: " + msg
    InvalidSequences(msg) => "invalid sequences: " + msg
    InvalidOffset(msg) => "invalid match offset: " + msg
    InvalidBitstream(msg) => "invalid bitstream: " + msg
    ChecksumMismatch(msg) => "checksum mismatch: " + msg
    ContentSizeMismatch(msg) => "content size mismatch: " + msg
    LimitExceeded(msg) => "limit exceeded: " + msg
    InvalidLevel(lvl) =>
    "invalid compression level (expected 0..9): " + lvl.to_string()
  }
}

///|
pub fn ZstdError::to_string(self : ZstdError) -> String {
  zstd_error_to_string(self)
}
