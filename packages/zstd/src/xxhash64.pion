///| Pure-Pion integer xxHash64 implementation (RFC 8878 §3.1.1 content checksum).
///| Zero floating-point arithmetic, zero module-level mutable state.

let xxh_prime1 : UInt64 = 0x9E3779B185EBCA87UL
let xxh_prime2 : UInt64 = 0xC2B2AE3D27D4EB4FUL
let xxh_prime3 : UInt64 = 0x165667B19E3779F9UL
let xxh_prime4 : UInt64 = 0x85EBCA77C2B2AE63UL
let xxh_prime5 : UInt64 = 0x27D4EB2F165667C5UL

///|
fn rotl64(x : UInt64, r : Int) -> UInt64 {
  (x << r) | (x >> (64 - r))
}

///|
fn read_u32_le_u64(data : Bytes, pos : Int) -> UInt64 {
  let b0 = data[pos].to_int().to_int64().to_uint64()
  let b1 = data[pos + 1].to_int().to_int64().to_uint64()
  let b2 = data[pos + 2].to_int().to_int64().to_uint64()
  let b3 = data[pos + 3].to_int().to_int64().to_uint64()
  b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

///|
fn read_u64_le(data : Bytes, pos : Int) -> UInt64 {
  let lo = read_u32_le_u64(data, pos)
  let hi = read_u32_le_u64(data, pos + 4)
  lo | (hi << 32)
}

///|
fn xxh_round(acc : UInt64, input : UInt64) -> UInt64 {
  rotl64(acc + input * xxh_prime2, 31) * xxh_prime1
}

///|
fn xxh_merge_round(acc : UInt64, lane : UInt64) -> UInt64 {
  let v = xxh_round(0UL, lane)
  (acc ^ v) * xxh_prime1 + xxh_prime4
}

///| Compute 64-bit xxHash64 of `data` with `seed`.
pub fn xxhash64(data : Bytes, seed : Int64) -> Int64 {
  xxhash64_slice(data, 0, data.length(), seed.to_uint64()).to_int64()
}

///| Internal slice-based xxHash64 returning `UInt64` (used by frame checksum verification).
fn xxhash64_slice(data : Bytes, start : Int, len : Int, seed : UInt64) -> UInt64 {
  let end = start + len
  let mut p = start
  let mut h64 : UInt64 = 0UL
  if len >= 32 {
    let limit = end - 32
    let mut v1 = seed + xxh_prime1 + xxh_prime2
    let mut v2 = seed + xxh_prime2
    let mut v3 = seed
    let mut v4 = seed - xxh_prime1
    while p <= limit {
      let mut k1 = data[p + 7].to_int().to_int64().to_uint64()
      k1 = (k1 << 8) | data[p + 6].to_int().to_int64().to_uint64()
      k1 = (k1 << 8) | data[p + 5].to_int().to_int64().to_uint64()
      k1 = (k1 << 8) | data[p + 4].to_int().to_int64().to_uint64()
      k1 = (k1 << 8) | data[p + 3].to_int().to_int64().to_uint64()
      k1 = (k1 << 8) | data[p + 2].to_int().to_int64().to_uint64()
      k1 = (k1 << 8) | data[p + 1].to_int().to_int64().to_uint64()
      k1 = (k1 << 8) | data[p].to_int().to_int64().to_uint64()
      let t1 = v1 + k1 * xxh_prime2
      v1 = ((t1 << 31) | (t1 >> 33)) * xxh_prime1

      let mut k2 = data[p + 15].to_int().to_int64().to_uint64()
      k2 = (k2 << 8) | data[p + 14].to_int().to_int64().to_uint64()
      k2 = (k2 << 8) | data[p + 13].to_int().to_int64().to_uint64()
      k2 = (k2 << 8) | data[p + 12].to_int().to_int64().to_uint64()
      k2 = (k2 << 8) | data[p + 11].to_int().to_int64().to_uint64()
      k2 = (k2 << 8) | data[p + 10].to_int().to_int64().to_uint64()
      k2 = (k2 << 8) | data[p + 9].to_int().to_int64().to_uint64()
      k2 = (k2 << 8) | data[p + 8].to_int().to_int64().to_uint64()
      let t2 = v2 + k2 * xxh_prime2
      v2 = ((t2 << 31) | (t2 >> 33)) * xxh_prime1

      let mut k3 = data[p + 23].to_int().to_int64().to_uint64()
      k3 = (k3 << 8) | data[p + 22].to_int().to_int64().to_uint64()
      k3 = (k3 << 8) | data[p + 21].to_int().to_int64().to_uint64()
      k3 = (k3 << 8) | data[p + 20].to_int().to_int64().to_uint64()
      k3 = (k3 << 8) | data[p + 19].to_int().to_int64().to_uint64()
      k3 = (k3 << 8) | data[p + 18].to_int().to_int64().to_uint64()
      k3 = (k3 << 8) | data[p + 17].to_int().to_int64().to_uint64()
      k3 = (k3 << 8) | data[p + 16].to_int().to_int64().to_uint64()
      let t3 = v3 + k3 * xxh_prime2
      v3 = ((t3 << 31) | (t3 >> 33)) * xxh_prime1

      let mut k4 = data[p + 31].to_int().to_int64().to_uint64()
      k4 = (k4 << 8) | data[p + 30].to_int().to_int64().to_uint64()
      k4 = (k4 << 8) | data[p + 29].to_int().to_int64().to_uint64()
      k4 = (k4 << 8) | data[p + 28].to_int().to_int64().to_uint64()
      k4 = (k4 << 8) | data[p + 27].to_int().to_int64().to_uint64()
      k4 = (k4 << 8) | data[p + 26].to_int().to_int64().to_uint64()
      k4 = (k4 << 8) | data[p + 25].to_int().to_int64().to_uint64()
      k4 = (k4 << 8) | data[p + 24].to_int().to_int64().to_uint64()
      let t4 = v4 + k4 * xxh_prime2
      v4 = ((t4 << 31) | (t4 >> 33)) * xxh_prime1

      p = p + 32
    }
    h64 = rotl64(v1, 1) + rotl64(v2, 7) + rotl64(v3, 12) + rotl64(v4, 18)
    h64 = xxh_merge_round(h64, v1)
    h64 = xxh_merge_round(h64, v2)
    h64 = xxh_merge_round(h64, v3)
    h64 = xxh_merge_round(h64, v4)
  } else {
    h64 = seed + xxh_prime5
  }
  h64 = h64 + len.to_int64().to_uint64()
  while p + 8 <= end {
    let k1 = xxh_round(0UL, read_u64_le(data, p))
    h64 = rotl64(h64 ^ k1, 27) * xxh_prime1 + xxh_prime4
    p = p + 8
  }
  if p + 4 <= end {
    h64 = rotl64(h64 ^ (read_u32_le_u64(data, p) * xxh_prime1), 23) * xxh_prime2 +
    xxh_prime3
    p = p + 4
  }
  while p < end {
    h64 = rotl64(h64 ^ (data[p].to_int().to_int64().to_uint64() * xxh_prime5), 11) *
    xxh_prime1
    p = p + 1
  }
  h64 = (h64 ^ (h64 >> 33)) * xxh_prime2
  h64 = (h64 ^ (h64 >> 29)) * xxh_prime3
  h64 = h64 ^ (h64 >> 32)
  h64
}
