///| RFC 8878 §4.2 Huffman table decoding (FSE-compressed and Direct 4-bit weights),
///| 1-stream and 4-stream backward bitstream literal decoding, and Huffman literal encoding.

///| Flat canonical Huffman decode table (`entries` has length `1 << max_bits`, `max_bits <= 11`).
///| Each entry packs `sym | (nb_bits << 8)`.
struct HuffTable {
  entries : FixedArray[Int]
  max_bits : Int
}

///| Fill `span` consecutive entries in a canonical Huffman decode table.
fn fill_huff_span(
  table_entries : FixedArray[Int],
  idx : Int,
  span : Int,
  entry : Int,
) -> Unit {
  let mut k = 0
  while k < span {
    table_entries[idx + k] = entry
    k = k + 1
  }
}

///| Fill all symbols of weight `w` into the canonical Huffman decode table and return new `idx`.
fn fill_huff_weight(
  all_w : FixedArray[Int],
  total_syms : Int,
  w : Int,
  nb : Int,
  span : Int,
  table_entries : FixedArray[Int],
  start_idx : Int,
  total : Int,
) -> Result[Int, ZstdError] {
  let mut idx = start_idx
  let mut s = 0
  let nb_shifted = nb << 8
  while s < total_syms {
    if all_w[s] == w {
      if idx + span > total {
        return Err(ZstdError::InvalidHuffmanTable("table overflow"))
      }
      fill_huff_span(table_entries, idx, span, s | nb_shifted)
      idx = idx + span
    }
    s = s + 1
  }
  Ok(idx)
}

///| Assign canonical Huffman encode codes for weight `w` and return new `idx`.
fn assign_huff_codes_weight(
  weights : FixedArray[Int],
  max_sym : Int,
  w : Int,
  nb : Int,
  span : Int,
  code_val : FixedArray[Int],
  code_len : FixedArray[Int],
  start_idx : Int,
) -> Int {
  let mut idx = start_idx
  let mut s = 0
  while s <= max_sym {
    if weights[s] == w {
      code_val[s] = idx >> (w - 1)
      code_len[s] = nb
      idx = idx + span
    }
    s = s + 1
  }
  idx
}

///| Build a canonical Huffman decode table from symbol weights `weights[0..num_weights]`.
///| Automatically reconstructs the implicit last symbol's weight per RFC 8878 §4.2.1.
fn huff_build_table_from_weights(
  weights : FixedArray[Int],
  num_weights : Int,
) -> Result[HuffTable, ZstdError] {
  if num_weights <= 0 || num_weights > 255 {
    return Err(ZstdError::InvalidHuffmanTable("invalid weight count"))
  }
  let mut weight_sum = 0
  let mut i = 0
  while i < num_weights {
    let w = weights[i]
    if w < 0 || w > 11 {
      return Err(ZstdError::InvalidHuffmanTable("weight out of range 0..11"))
    }
    if w > 0 {
      weight_sum = weight_sum + (1 << (w - 1))
    }
    i = i + 1
  }
  if weight_sum <= 0 {
    return Err(ZstdError::InvalidHuffmanTable("zero weight sum"))
  }

  let max_bits = high_bit(weight_sum) + 1
  if max_bits < 1 || max_bits > 11 {
    return Err(ZstdError::InvalidHuffmanTable("max_bits out of range 1..11"))
  }
  let total = 1 << max_bits
  let leftover = total - weight_sum
  if leftover <= 0 || (leftover & (leftover - 1)) != 0 {
    return Err(ZstdError::InvalidHuffmanTable("leftover is not a power of 2"))
  }
  let last_weight = trailing_zeros(leftover) + 1
  if last_weight > max_bits {
    return Err(ZstdError::InvalidHuffmanTable("last_weight exceeds max_bits"))
  }

  let total_syms = num_weights + 1
  let all_w : FixedArray[Int] = FixedArray::make(total_syms, 0)
  i = 0
  while i < num_weights {
    all_w[i] = weights[i]
    i = i + 1
  }
  all_w[num_weights] = last_weight

  let table_entries : FixedArray[Int] = FixedArray::make(total, 0)
  let mut idx = 0
  let mut w = 1
  while w <= max_bits {
    let nb = max_bits + 1 - w
    let span = 1 << (w - 1)
    idx = match
    fill_huff_weight(
      all_w, total_syms, w, nb, span, table_entries, idx, total,
    ) {
      Ok(ni) => ni
      Err(e) => return Err(e)
    }
    w = w + 1
  }
  if idx != total {
    return Err(ZstdError::InvalidHuffmanTable("incomplete Huffman table"))
  }
  Ok(HuffTable::{ entries: table_entries, max_bits: max_bits })
}

///| Parse RFC 8878 §4.2.1 Huffman Tree Description at `data[start..end]`.
///| Returns `(HuffTable, next_byte_pos)`.
fn huff_read_table(
  data : Bytes,
  start : Int,
  end : Int,
) -> Result[(HuffTable, Int), ZstdError] {
  if start >= end {
    return Err(ZstdError::UnexpectedEof("empty Huffman header"))
  }
  let hdr = data[start].to_int()
  let weights : FixedArray[Int] = FixedArray::make(256, 0)
  if hdr >= 128 {
    // Direct 4-bit representation
    let num_weights = hdr - 127
    let num_bytes = (num_weights + 1) >> 1
    if start + 1 + num_bytes > end {
      return Err(ZstdError::UnexpectedEof("truncated direct Huffman weights"))
    }
    let mut i = 0
    let mut p = start + 1
    while i < num_weights {
      let b = data[p].to_int()
      p = p + 1
      weights[i] = (b >> 4) & 15
      i = i + 1
      if i < num_weights {
        weights[i] = b & 15
        i = i + 1
      }
    }
    match huff_build_table_from_weights(weights, num_weights) {
      Ok(tbl) => Ok((tbl, start + 1 + num_bytes))
      Err(e) => Err(e)
    }
  } else {
    // FSE-compressed weights
    let comp_size = hdr
    let comp_start = start + 1
    let comp_end = comp_start + comp_size
    if comp_size == 0 || comp_end > end {
      return Err(ZstdError::UnexpectedEof("truncated FSE Huffman weights"))
    }
    let (fse_tbl, stream_start) = match
    fse_read_distribution(data, comp_start, comp_end, 12, 6) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    if stream_start >= comp_end {
      return Err(ZstdError::InvalidHuffmanTable("empty FSE weights bitstream"))
    }
    let br = match BackBitReader::init(data, stream_start, comp_end) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let alog = fse_tbl.accuracy_log
    let mut state1 = match br.read_bits(alog) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let mut state2 = match br.read_bits(alog) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let fse_entries = fse_tbl.entries
    let mut count = 0
    while true {
      if count >= 255 {
        return Err(ZstdError::InvalidHuffmanTable("more than 255 weights"))
      }
      let e1 = fse_entries[state1]
      weights[count] = e1 & 255
      count = count + 1
      let nb1 = (e1 >> 8) & 255
      if br.remaining_bits() < nb1 {
        if count >= 255 {
          return Err(ZstdError::InvalidHuffmanTable("more than 255 weights"))
        }
        weights[count] = fse_tbl.sym[state2]
        count = count + 1
        break
      }
      let bits1 = match br.read_bits(nb1) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      state1 = (e1 >> 16) + bits1

      if count >= 255 {
        return Err(ZstdError::InvalidHuffmanTable("more than 255 weights"))
      }
      let e2 = fse_entries[state2]
      weights[count] = e2 & 255
      count = count + 1
      let nb2 = (e2 >> 8) & 255
      if br.remaining_bits() < nb2 {
        if count >= 255 {
          return Err(ZstdError::InvalidHuffmanTable("more than 255 weights"))
        }
        weights[count] = fse_entries[state1] & 255
        count = count + 1
        break
      }
      let bits2 = match br.read_bits(nb2) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      state2 = (e2 >> 16) + bits2
    }
    match huff_build_table_from_weights(weights, count) {
      Ok(tbl) => Ok((tbl, comp_end))
      Err(e) => Err(e)
    }
  }
}

///| Register-frugal 4x unrolled Huffman fast loop (`avail_m = bits_avail - max_bits`).
///| Writes into `FixedArray[Byte]` (zero COW checks, zero register spills on `e0..e3`).
fn huff_decode_fast(
  entries : FixedArray[Int],
  mask : UInt64,
  data : Bytes,
  dst : FixedArray[Byte],
  init_p : Int,
  fast_p_limit : Int,
  init_byte_pos : Int,
  fast_byte_min : Int,
  init_bit_buf : UInt64,
  init_avail_m : Int,
) -> (Int, Int, UInt64, Int) {
  let mut p = init_p
  let mut byte_pos = init_byte_pos
  let mut bit_buf = init_bit_buf
  let mut avail_m = init_avail_m

  while p < fast_p_limit && byte_pos >= fast_byte_min {
    if avail_m < 33 {
      if avail_m <= 21 {
        byte_pos = byte_pos - 4
        bit_buf = (bit_buf << 8) |
        data[byte_pos + 3].to_int().to_int64().to_uint64()
        bit_buf = (bit_buf << 8) |
        data[byte_pos + 2].to_int().to_int64().to_uint64()
        bit_buf = (bit_buf << 8) |
        data[byte_pos + 1].to_int().to_int64().to_uint64()
        bit_buf = (bit_buf << 8) |
        data[byte_pos].to_int().to_int64().to_uint64()
        avail_m = avail_m + 32
      }
      if avail_m <= 37 {
        byte_pos = byte_pos - 2
        bit_buf = (bit_buf << 8) |
        data[byte_pos + 1].to_int().to_int64().to_uint64()
        bit_buf = (bit_buf << 8) |
        data[byte_pos].to_int().to_int64().to_uint64()
        avail_m = avail_m + 16
      }
    }
    let e0 = entries[((bit_buf >> avail_m) & mask).to_int()]
    avail_m = avail_m - (e0 >> 8)
    dst[p] = e0.to_byte()

    let e1 = entries[((bit_buf >> avail_m) & mask).to_int()]
    avail_m = avail_m - (e1 >> 8)
    dst[p + 1] = e1.to_byte()

    let e2 = entries[((bit_buf >> avail_m) & mask).to_int()]
    avail_m = avail_m - (e2 >> 8)
    dst[p + 2] = e2.to_byte()

    let e3 = entries[((bit_buf >> avail_m) & mask).to_int()]
    avail_m = avail_m - (e3 >> 8)
    dst[p + 3] = e3.to_byte()

    p = p + 4
  }
  (p, byte_pos, bit_buf, avail_m)
}

///| Decode a single Huffman backward bitstream `data[start..end]` of `out_len` symbols
///| into `dst[dst_pos .. dst_pos + out_len]`.
fn huff_decode_stream(
  tbl : HuffTable,
  data : Bytes,
  start : Int,
  end : Int,
  dst : FixedArray[Byte],
  dst_pos : Int,
  out_len : Int,
) -> Result[Unit, ZstdError] {
  if end <= start || start < 0 || end > data.length() {
    return Err(ZstdError::InvalidBitstream("empty backward bitstream"))
  }
  let last = data[end - 1].to_int()
  if last == 0 {
    return Err(ZstdError::InvalidBitstream("missing sentinel 1-bit"))
  }
  let hb = high_bit(last)
  let mut byte_pos = end - 1
  let mut bit_buf : UInt64 = (last & ((1 << hb) - 1)).to_int64().to_uint64()
  let mut bits_avail = hb
  while bits_avail <= 56 && byte_pos > start {
    byte_pos = byte_pos - 1
    bit_buf = (bit_buf << 8) | data[byte_pos].to_int().to_int64().to_uint64()
    bits_avail = bits_avail + 8
  }

  let max_bits = tbl.max_bits
  let mask = (1UL << max_bits) - 1UL
  let entries = tbl.entries
  let mut p = dst_pos
  let limit = dst_pos + out_len
  let fast_p_limit = limit - 3
  let fast_byte_min = start + 6

  if p < fast_p_limit && byte_pos >= fast_byte_min {
    let (np, nbp, nbb, navm) = huff_decode_fast(
      entries,
      mask,
      data,
      dst,
      p,
      fast_p_limit,
      byte_pos,
      fast_byte_min,
      bit_buf,
      bits_avail - max_bits,
    )
    p = np
    byte_pos = nbp
    bit_buf = nbb
    bits_avail = navm + max_bits
  }

  // Safe tail loop for final bytes or near stream start
  while p < limit {
    if bits_avail < max_bits {
      while bits_avail <= 56 && byte_pos > start {
        byte_pos = byte_pos - 1
        bit_buf = (bit_buf << 8) |
        data[byte_pos].to_int().to_int64().to_uint64()
        bits_avail = bits_avail + 8
      }
    }
    let idx = if bits_avail >= max_bits {
      ((bit_buf >> (bits_avail - max_bits)) & mask).to_int()
    } else {
      ((bit_buf << (max_bits - bits_avail)) & mask).to_int()
    }
    let e = entries[idx]
    let nb = e >> 8
    if nb > bits_avail {
      return Err(ZstdError::InvalidBitstream("Huffman stream underflow"))
    }
    bits_avail = bits_avail - nb
    dst[p] = e.to_byte()
    p = p + 1
  }

  let br = BackBitReader::{
    data: data,
    start: start,
    byte_pos: byte_pos,
    bit_buf: bit_buf,
    bits_avail: bits_avail,
  }
  if br.bits_avail != 0 || br.byte_pos != start {
    return Err(
      ZstdError::InvalidBitstream("Huffman stream did not exhaust cleanly"),
    )
  }
  Ok(())
}

///| Decode a 1-stream or 4-stream Huffman literals payload into caller-provided `out[0..regen_size]`.
fn huff_decode_literals(
  tbl : HuffTable,
  data : Bytes,
  start : Int,
  end : Int,
  out : FixedArray[Byte],
  regen_size : Int,
  four_streams : Bool,
) -> Result[Unit, ZstdError] {
  if !four_streams {
    huff_decode_stream(tbl, data, start, end, out, 0, regen_size)
  } else {
    if end - start < 6 {
      return Err(
        ZstdError::UnexpectedEof("truncated 4-stream Huffman jump table"),
      )
    }
    let s1 = data[start].to_int() | (data[start + 1].to_int() << 8)
    let s2 = data[start + 2].to_int() | (data[start + 3].to_int() << 8)
    let s3 = data[start + 4].to_int() | (data[start + 5].to_int() << 8)
    let p1 = start + 6
    let p2 = p1 + s1
    let p3 = p2 + s2
    let p4 = p3 + s3
    if p4 > end {
      return Err(
        ZstdError::InvalidLiteralsHeader("4-stream Huffman jump table overflow"),
      )
    }
    let seg = (regen_size + 3) >> 2
    let rem = regen_size - seg * 3
    if rem < 0 {
      return Err(
        ZstdError::InvalidLiteralsHeader("4-stream regen_size too small"),
      )
    }
    match huff_decode_stream(tbl, data, p1, p2, out, 0, seg) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match huff_decode_stream(tbl, data, p2, p3, out, seg, seg) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match huff_decode_stream(tbl, data, p3, p4, out, seg * 2, seg) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    huff_decode_stream(tbl, data, p4, end, out, seg * 3, rem)
  }
}

///| Encode one Huffman segment `lits[seg_start .. seg_start + seg_len]` in reverse into `buf`.
///| Returns the number of bytes written.
fn huff_encode_seg(
  lits : FixedArray[Byte],
  seg_start : Int,
  seg_len : Int,
  code_tbl : FixedArray[Int],
  buf : FixedArray[Byte],
) -> Int {
  let mut out_len = 0
  let mut bit_buf : UInt64 = 0UL
  let mut bit_cnt = 0
  let mut k = seg_start + seg_len - 1
  while k >= seg_start {
    let c = code_tbl[lits[k].to_int()]
    let nb = c >> 16
    bit_buf = bit_buf | ((c & 0xFFFF).to_int64().to_uint64() << bit_cnt)
    bit_cnt = bit_cnt + nb
    if bit_cnt >= 32 {
      buf[out_len] = (bit_buf & 255UL).to_int().to_byte()
      buf[out_len + 1] = ((bit_buf >> 8) & 255UL).to_int().to_byte()
      buf[out_len + 2] = ((bit_buf >> 16) & 255UL).to_int().to_byte()
      buf[out_len + 3] = ((bit_buf >> 24) & 255UL).to_int().to_byte()
      out_len = out_len + 4
      bit_buf = bit_buf >> 32
      bit_cnt = bit_cnt - 32
    }
    k = k - 1
  }
  bit_buf = bit_buf | (1UL << bit_cnt)
  bit_cnt = bit_cnt + 1
  while bit_cnt > 0 {
    buf[out_len] = (bit_buf & 255UL).to_int().to_byte()
    out_len = out_len + 1
    bit_buf = bit_buf >> 8
    bit_cnt = if bit_cnt >= 8 { bit_cnt - 8 } else { 0 }
  }
  out_len
}

///| Encode literals with a Direct-weight Huffman table (1-stream or 4-stream) if it saves space.
///| Returns `Some((header_and_payload, is_four_streams))` or `None` if raw is better.
fn huff_try_encode_literals(
  lits : FixedArray[Byte],
  len : Int,
) -> Option[(Bytes, Bool)] {
  if len < 48 {
    return None
  }
  // Count byte frequencies
  let freq : FixedArray[Int] = FixedArray::make(256, 0)
  let mut max_sym = 0
  let mut unique = 0
  let mut i = 0
  while i < len {
    let b = lits[i].to_int()
    if freq[b] == 0 {
      unique = unique + 1
      if b > max_sym {
        max_sym = b
      }
    }
    freq[b] = freq[b] + 1
    i = i + 1
  }
  // Direct 4-bit weights supports up to 128 weights (max_sym <= 128)
  if unique < 2 || max_sym > 128 {
    return None
  }

  // Build length-limited Huffman code lengths (max_bits <= 11) via simple Kraft-normalized weights.
  // Compute bit lengths from log2(len / freq[s]), then adjust to exact Kraft sum == 1 << max_bits.
  let max_bits = 11
  let target = 1 << max_bits
  let weights : FixedArray[Int] = FixedArray::make(max_sym + 1, 0)
  let mut kraft = 0
  let mut s = 0
  while s <= max_sym {
    let f = freq[s]
    if f > 0 {
      // Initial weight estimate: w = max_bits + 1 - ceil(log2(len / f))
      let mut ratio = (len + f - 1) / f
      if ratio < 1 {
        ratio = 1
      }
      let mut bl = high_bit(ratio)
      if (1 << bl) < ratio {
        bl = bl + 1
      }
      if bl < 1 {
        bl = 1
      }
      if bl > max_bits {
        bl = max_bits
      }
      let w = max_bits + 1 - bl
      weights[s] = w
      kraft = kraft + (1 << (w - 1))
    }
    s = s + 1
  }

  // Reduce kraft if > target by decrementing lowest-frequency symbols with w > 1
  let mut iter_guard = 0
  while kraft > target && iter_guard < 2048 {
    iter_guard = iter_guard + 1
    let mut best_s = -1
    let mut best_f = 2147483647
    s = 0
    while s <= max_sym {
      if weights[s] > 1 && freq[s] < best_f {
        best_f = freq[s]
        best_s = s
      }
      s = s + 1
    }
    if best_s < 0 {
      return None
    }
    let old_w = weights[best_s]
    weights[best_s] = old_w - 1
    kraft = kraft - (1 << (old_w - 2))
  }

  // Increase kraft if < target by incrementing highest-frequency symbols that fit
  iter_guard = 0
  while kraft < target && iter_guard < 2048 {
    iter_guard = iter_guard + 1
    let rem = target - kraft
    let mut best_s = -1
    let mut best_f = -1
    s = 0
    while s <= max_sym {
      let w = weights[s]
      if w > 0 && w < max_bits {
        let delta = 1 << (w - 1)
        if delta <= rem && freq[s] > best_f {
          best_f = freq[s]
          best_s = s
        }
      }
      s = s + 1
    }
    if best_s < 0 {
      return None
    }
    let old_w = weights[best_s]
    weights[best_s] = old_w + 1
    kraft = kraft + (1 << (old_w - 1))
  }
  if kraft != target {
    return None
  }

  // Normalize weights down if all non-zero weights are > 1 (tightens max_bits)
  let mut min_w = max_bits
  s = 0
  while s <= max_sym {
    if weights[s] > 0 && weights[s] < min_w {
      min_w = weights[s]
    }
    s = s + 1
  }
  let shift = min_w - 1
  let eff_max_bits = max_bits - shift
  if shift > 0 {
    s = 0
    while s <= max_sym {
      if weights[s] > 0 {
        weights[s] = weights[s] - shift
      }
      s = s + 1
    }
  }

  // Assign canonical Huffman codes matching RFC 8878 §4.2.2
  let code_val : FixedArray[Int] = FixedArray::make(max_sym + 1, 0)
  let code_len : FixedArray[Int] = FixedArray::make(max_sym + 1, 0)
  let mut idx = 0
  let mut w = 1
  while w <= eff_max_bits {
    let nb = eff_max_bits + 1 - w
    let span = 1 << (w - 1)
    idx = assign_huff_codes_weight(
      weights, max_sym, w, nb, span, code_val, code_len, idx,
    )
    w = w + 1
  }

  // Pack code_val and code_len into a single lookup table: code_val | (code_len << 16)
  let code_tbl : FixedArray[Int] = FixedArray::make(max_sym + 1, 0)
  s = 0
  while s <= max_sym {
    code_tbl[s] = code_val[s] | (code_len[s] << 16)
    s = s + 1
  }

  // Direct 4-bit weight header: num_weights = max_sym (last symbol max_sym is implicit)
  let num_weights = max_sym
  let hdr_bytes = 1 + ((num_weights + 1) >> 1)
  let four_streams = len >= 1024

  if !four_streams {
    let stream_buf : FixedArray[Byte] = FixedArray::make(
      len * 2 + 16,
      (0).to_byte(),
    )
    let stream_len = huff_encode_seg(lits, 0, len, code_tbl, stream_buf)
    let total_comp = hdr_bytes + stream_len
    if total_comp + 4 >= len {
      return None
    }
    let out = Bytes::new(total_comp)
    out[0] = (127 + num_weights).to_byte()
    let mut p = 1
    let mut wi = 0
    while wi < num_weights {
      let hi = weights[wi] & 15
      let lo = if wi + 1 < num_weights { weights[wi + 1] & 15 } else { 0 }
      out[p] = ((hi << 4) | lo).to_byte()
      p = p + 1
      wi = wi + 2
    }
    let mut j = 0
    while j < stream_len {
      out[p + j] = stream_buf[j]
      j = j + 1
    }
    Some((out, false))
  } else {
    let seg = (len + 3) >> 2
    let rem = len - seg * 3
    let seg_cap = seg * 2 + 16
    let b1 : FixedArray[Byte] = FixedArray::make(seg_cap, (0).to_byte())
    let b2 : FixedArray[Byte] = FixedArray::make(seg_cap, (0).to_byte())
    let b3 : FixedArray[Byte] = FixedArray::make(seg_cap, (0).to_byte())
    let b4 : FixedArray[Byte] = FixedArray::make(rem * 2 + 16, (0).to_byte())
    let n1 = huff_encode_seg(lits, 0, seg, code_tbl, b1)
    let n2 = huff_encode_seg(lits, seg, seg, code_tbl, b2)
    let n3 = huff_encode_seg(lits, seg * 2, seg, code_tbl, b3)
    let n4 = huff_encode_seg(lits, seg * 3, rem, code_tbl, b4)
    if n1 > 65535 || n2 > 65535 || n3 > 65535 {
      return None
    }
    let total_comp = hdr_bytes + 6 + n1 + n2 + n3 + n4
    if total_comp + 6 >= len {
      return None
    }
    let out = Bytes::new(total_comp)
    out[0] = (127 + num_weights).to_byte()
    let mut p = 1
    let mut wi = 0
    while wi < num_weights {
      let hi = weights[wi] & 15
      let lo = if wi + 1 < num_weights { weights[wi + 1] & 15 } else { 0 }
      out[p] = ((hi << 4) | lo).to_byte()
      p = p + 1
      wi = wi + 2
    }
    out[p] = (n1 & 255).to_byte()
    out[p + 1] = ((n1 >> 8) & 255).to_byte()
    out[p + 2] = (n2 & 255).to_byte()
    out[p + 3] = ((n2 >> 8) & 255).to_byte()
    out[p + 4] = (n3 & 255).to_byte()
    out[p + 5] = ((n3 >> 8) & 255).to_byte()
    p = p + 6
    let mut j = 0
    while j < n1 {
      out[p + j] = b1[j]
      j = j + 1
    }
    p = p + n1
    j = 0
    while j < n2 {
      out[p + j] = b2[j]
      j = j + 1
    }
    p = p + n2
    j = 0
    while j < n3 {
      out[p + j] = b3[j]
      j = j + 1
    }
    p = p + n3
    j = 0
    while j < n4 {
      out[p + j] = b4[j]
      j = j + 1
    }
    Some((out, true))
  }
}
