///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/jq`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "jq"
import "json5"

///|
pub fn main(world : World) -> Int {
  // 1. Limits validation
  match jq::compile_with_limits(".", jq::JqLimits::new(0, 100, 100, 100)) {
    Err(jq::JqError::InvalidLimits(_)) => ()
    _ => return 1
  }
  match jq::eval_json_with_limits("\"abc\" * 10000", "null", jq::JqLimits::new(64, 100000, 100, 512)) {
    Err(jq::JqError::LimitExceeded(_)) => ()
    _ => return 2
  }

  // 2. K8s-style aggregation pipeline
  let doc1 = "[{\"ns\":\"prod\",\"ms\":45,\"ok\":true},{\"ns\":\"dev\",\"ms\":12,\"ok\":true},{\"ns\":\"prod\",\"ms\":15,\"ok\":true},{\"ns\":\"prod\",\"ms\":99,\"ok\":false}]"
  let q1 = "[.[] | select(.ok)] | group_by(.ns) | map({ns: .[0].ns, count: length, total: (map(.ms) | add)}) | sort_by(-.total)"
  let r1 = match jq::eval_json(q1, doc1) {
    Ok(xs) => if xs.length() == 1 { xs[0] } else { return 3 }
    Err(_) => return 4
  }

  // 3. Deep recursive update + extract
  let doc2 = "{\"a\":{\"score\":10,\"nested\":{\"score\":20}},\"b\":[{\"score\":30}]}"
  let q2 = "(.. | objects | select(has(\"score\")) | .score) |= . * 2 | [.. | objects | select(has(\"score\")) | .score] | add"
  let r2 = match jq::eval_json(q2, doc2) {
    Ok(xs) => if xs.length() == 1 { xs[0] } else { return 5 }
    Err(_) => return 6
  }

  // 4. User-defined recursion, label/break, regex, formatters
  let q3 = "def fact: if . <= 1 then 1 else . * ((. - 1) | fact) end; 6 | fact"
  let r3 = match jq::eval_json(q3, "null") {
    Ok(xs) => if xs.length() == 1 { xs[0] } else { return 7 }
    Err(_) => return 8
  }
  let q4 = "\"2026-11-23\" | sub(\"(?<y>[0-9]{4})-(?<m>[0-9]{2})-(?<d>[0-9]{2})\"; \"\\(.d)/\\(.m)/\\(.y)\")"
  let r4 = match jq::eval_json(q4, "null") {
    Ok(xs) => if xs.length() == 1 { xs[0] } else { return 9 }
    Err(_) => return 10
  }
  let q5 = "[\"a\",\"b,c\",42] | @csv | @base64 | @base64d"
  let r5 = match jq::eval_json(q5, "null") {
    Ok(xs) => if xs.length() == 1 { xs[0] } else { return 11 }
    Err(_) => return 12
  }
  let q6 = "[label $out | foreach .[] as $x (0; if $x == 4 then break $out else . + $x end)]"
  let r6 = match jq::eval_json(q6, "[1,2,3,4,5]") {
    Ok(xs) => if xs.length() == 1 { xs[0] } else { return 13 }
    Err(_) => return 14
  }

  io_println(world, "jq_wasm_smoke:ok")
  io_println(world, "agg=" + r1)
  io_println(world, "tree=" + r2)
  io_println(world, "fact=" + r3)
  io_println(world, "regex=" + r4)
  io_println(world, "fmt=" + r5)
  io_println(world, "break=" + r6)
  0
}
