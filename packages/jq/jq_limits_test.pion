///| Safety, DoS, and JqLimits tests for `packages/jq`.

test "invalid_limits_rejected" {
  match compile_with_limits(".", JqLimits::new(0, 100, 100, 100)) {
    Err(JqError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "expected InvalidLimits for max_depth=0")
  }
  match compile_with_limits(".", JqLimits::new(10, -1, 100, 100)) {
    Err(JqError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "expected InvalidLimits for max_steps=-1")
  }
  match compile_with_limits(".", JqLimits::new(10, 100, 0, 100)) {
    Err(JqError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "expected InvalidLimits for max_outputs=0")
  }
  match compile_with_limits(".", JqLimits::new(10, 100, 100, -5)) {
    Err(JqError::InvalidLimits(_)) => ()
    _ => debug_assert(false, "expected InvalidLimits for max_output_bytes=-5")
  }
}

test "max_depth_parse_and_eval_enforced" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 40 {
    sb.write_string("[")
    i = i + 1
  }
  sb.write_string("1")
  i = 0
  while i < 40 {
    sb.write_string("]")
    i = i + 1
  }
  match compile_with_limits(sb.to_string(), JqLimits::new(16, 10000, 100, 65536)) {
    Err(JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for deep parse nesting")
  }
  match eval_json_with_limits("def loop: loop; loop", "null", JqLimits::new(16, 100000, 100, 65536)) {
    Err(JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for infinite recursion")
  }
}

test "max_steps_and_max_outputs_enforced" {
  match eval_json_with_limits("[range(10000)]", "null", JqLimits::new(64, 200, 10000, 65536)) {
    Err(JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_steps")
  }
  match eval_json_with_limits("range(100)", "null", JqLimits::new(64, 100000, 10, 65536)) {
    Err(JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_outputs")
  }
}

test "max_output_bytes_prevents_string_and_array_bomb" {
  match eval_json_with_limits("\"abcdefghij\" * 10000", "null", JqLimits::new(64, 100000, 100, 4096)) {
    Err(JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for string multiplication bomb")
  }
  match eval_json_with_limits("reduce range(30) as $i (\"x\"; . + .)", "null", JqLimits::new(64, 100000, 100, 4096)) {
    Err(JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for exponential string concat")
  }
}

test "try_catch_cannot_swallow_limit_exceeded" {
  match eval_json_with_limits("try (range(1000)) catch \"swallowed\"", "null", JqLimits::new(64, 100, 1000, 65536)) {
    Err(JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "try/catch must not swallow LimitExceeded")
  }
}

test "syntax_and_invalid_json_errors" {
  match compile("if true then 1") {
    Err(JqError::SyntaxError(_, _)) => ()
    _ => debug_assert(false, "expected SyntaxError for unclosed if")
  }
  match eval_json(".", "{bad json") {
    Err(JqError::InvalidJson(_)) => ()
    _ => debug_assert(false, "expected InvalidJson")
  }
}
