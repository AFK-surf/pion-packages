///| Compliance tests for jq variables, destructuring, reduce, foreach,
///| user-defined functions (def), label/break, and path/update operators.

import "json5"

test "variable_binding_and_destructuring" {
  assert_jq(". as $x | $x + $x", "5", ["10"])
  assert_jq("(1, 2) as $x | (10, 20) as $y | $x + $y", "null", ["11", "21", "12", "22"])
  assert_jq(". as [$a, $b] | $a * 10 + $b", "[3, 7]", ["37"])
  assert_jq(". as {a: $x, b: $y} | $x + $y", "{\"a\":4,\"b\":6}", ["10"])
  assert_jq(". as {$a, $b} | $a - $b", "{\"a\":10,\"b\":3}", ["7"])
  assert_jq(". as {a: [$x, {b: $y}]} | $x + $y", "{\"a\":[2,{\"b\":8}]}", ["10"])
  assert_jq("[1,2,3] as $arr | 99 | $arr[1]", "null", ["2"])
}

test "reduce_and_foreach" {
  assert_jq("reduce .[] as $x (0; . + $x)", "[1,2,3,4,5]", ["15"])
  assert_jq("reduce .[] as $x ({}; .[$x] += 1)", "[\"a\",\"b\",\"a\",\"c\",\"a\"]", ["{\"a\":3,\"b\":1,\"c\":1}"])
  assert_jq("[foreach .[] as $x (0; . + $x)]", "[1,2,3,4]", ["[1,3,6,10]"])
  assert_jq("[foreach .[] as $x (0; . + $x; [., $x])]", "[1,2,3]", ["[[1,1],[3,2],[6,3]]"])
}

test "user_defined_functions_closures_and_recursion" {
  assert_jq("def double: . * 2; [1,2,3] | map(double)", "null", ["[2,4,6]"])
  assert_jq("def addvalue(f): . + [f]; [1,2] | addvalue(3)", "null", ["[1,2,3]"])
  assert_jq("def apply2(f; g): (f, g); 5 | [apply2(. + 1; . * 2)]", "null", ["[6,10]"])
  assert_jq("def fact: if . <= 1 then 1 else . * ((. - 1) | fact) end; 6 | fact", "null", ["720"])
  assert_jq("10 as $k | def addk: . + $k; 5 | addk", "null", ["15"])
  assert_jq("def f(x): def g: x; g; f(42)", "null", ["42"])
  assert_jq("def dup: ., .; [1 | dup]", "null", ["[1,1]"])
}

test "label_and_break" {
  assert_jq("[label $out | foreach .[] as $item (null; if $item == 3 then break $out else $item end)]", "[1,2,3,4,5]", ["[1,2]"])
  assert_jq("[label $out | (1, 2, 3, 4) | if . == 3 then break $out else . end]", "null", ["[1,2]"])
}

test "path_getpath_setpath_delpaths_del" {
  assert_jq("[path(.a.b[1])]", "{\"a\":{\"b\":[10,20]}}", ["[[\"a\",\"b\",1]]"])
  assert_jq("[path(.a, .b[0])]", "{\"a\":1,\"b\":[2]}", ["[[\"a\"],[\"b\",0]]"])
  assert_jq("[path(.[] | select(. > 2))]", "[1,3,2,4]", ["[[1],[3]]"])
  assert_jq("getpath([\"a\",\"b\",1])", "{\"a\":{\"b\":[10,20]}}", ["20"])
  assert_jq("setpath([\"a\",\"b\"]; 42)", "{}", ["{\"a\":{\"b\":42}}"])
  assert_jq("setpath([2]; 9)", "[1]", ["[1,null,9]"])
  assert_jq("delpaths([[\"a\"],[\"c\"]])", "{\"a\":1,\"b\":2,\"c\":3}", ["{\"b\":2}"])
  assert_jq("delpaths([[0],[2]])", "[10,20,30,40]", ["[20,40]"])
  assert_jq("del(.b)", "{\"a\":1,\"b\":2,\"c\":3}", ["{\"a\":1,\"c\":3}"])
  assert_jq("del(.[1])", "[10,20,30]", ["[10,30]"])
  assert_jq("del(.[] | select(. < 3))", "[1,2,3,4]", ["[3,4]"])
}

test "update_assignment_operators" {
  assert_jq(".a |= . + 1", "{\"a\":1,\"b\":2}", ["{\"a\":2,\"b\":2}"])
  assert_jq(".[] |= . * 10", "[1,2,3]", ["[10,20,30]"])
  assert_jq(".a = 99", "{\"a\":1,\"b\":2}", ["{\"a\":99,\"b\":2}"])
  assert_jq(".a += 5", "{\"a\":10}", ["{\"a\":15}"])
  assert_jq(".a -= 3", "{\"a\":10}", ["{\"a\":7}"])
  assert_jq(".a *= 4", "{\"a\":3}", ["{\"a\":12}"])
  assert_jq(".a /= 2", "{\"a\":10}", ["{\"a\":5}"])
  assert_jq(".a %= 3", "{\"a\":10}", ["{\"a\":1}"])
  assert_jq(".a //= 42", "{\"a\":null}", ["{\"a\":42}"])
  assert_jq(".a //= 42", "{\"a\":7}", ["{\"a\":7}"])
  assert_jq("(.[] | select(. % 2 == 0)) |= . * 100", "[1,2,3,4]", ["[1,200,3,400]"])
  assert_jq("(.[] | select(. == 2)) |= empty", "[1,2,3,2]", ["[1,3]"])
  assert_jq("(.. | numbers) |= . + 1", "{\"a\":1,\"b\":[2,{\"c\":3}]}", ["{\"a\":2,\"b\":[3,{\"c\":4}]}"])
}

test "external_vars_via_run_with_vars" {
  let q = match compile("$prefix + \":\" + .name") {
    Ok(q) => q
    Err(e) => {
      debug_assert(false, "compile failed: " + error_message(e))
      return
    }
  }
  let inp = match parse_json("{\"name\":\"world\"}") {
    Ok(v) => v
    Err(_) => return
  }
  let res = match run_with_vars(q, inp, [("prefix", json5::Json5Value::Str("hi"))], JqLimits::default()) {
    Ok(xs) => xs
    Err(e) => {
      debug_assert(false, "run_with_vars failed: " + error_message(e))
      return
    }
  }
  debug_assert(res.length() == 1, "expected 1 output")
  debug_assert(json5::value_eq(res[0], json5::Json5Value::Str("hi:world")), "expected hi:world")
}
