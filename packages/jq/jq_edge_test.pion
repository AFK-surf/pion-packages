///| Additional jq 1.7 / gojq compliance & edge-case tests:
///| complex pipelines, nested closures, unicode, sorted JSON, path edge cases.

test "complex_k8s_style_aggregation_pipeline" {
  let doc = "[{\"ns\":\"prod\",\"kind\":\"Pod\",\"ms\":45,\"ok\":true},{\"ns\":\"dev\",\"kind\":\"Pod\",\"ms\":12,\"ok\":true},{\"ns\":\"prod\",\"kind\":\"Job\",\"ms\":120,\"ok\":false},{\"ns\":\"prod\",\"kind\":\"Pod\",\"ms\":15,\"ok\":true},{\"ns\":\"staging\",\"kind\":\"Pod\",\"ms\":30,\"ok\":true}]"
  let q = "[.[] | select(.ok)] | group_by(.ns) | map({ns: .[0].ns, count: length, total_ms: (map(.ms) | add)}) | sort_by(-.total_ms)"
  assert_jq(
    q,
    doc,
    ["[{\"ns\":\"prod\",\"count\":2,\"total_ms\":60},{\"ns\":\"staging\",\"count\":1,\"total_ms\":30},{\"ns\":\"dev\",\"count\":1,\"total_ms\":12}]"],
  )
}

test "deep_tree_recursive_update_and_extract" {
  let doc = "{\"a\":{\"score\":10,\"nested\":{\"score\":20,\"tags\":[\"x\",\"y\"]}},\"b\":[{\"score\":30},{\"other\":1}]}"
  assert_jq(
    "[.. | objects | select(has(\"score\")) | .score] | add",
    doc,
    ["60"],
  )
  assert_jq(
    "(.. | objects | select(has(\"score\")) | .score) |= . * 2 | [.. | objects | select(has(\"score\")) | .score] | add",
    doc,
    ["120"],
  )
}

test "to_json_sorted_deterministic_keys" {
  let v = match parse_json("{\"z\":1,\"a\":{\"d\":4,\"b\":2},\"m\":[{\"y\":9,\"x\":8}]}") {
    Ok(x) => x
    Err(_) => {
      debug_assert(false, "parse_json failed")
      return
    }
  }
  let s = match to_json_sorted(v) {
    Ok(x) => x
    Err(_) => {
      debug_assert(false, "to_json_sorted failed")
      return
    }
  }
  debug_assert(s == "{\"a\":{\"b\":2,\"d\":4},\"m\":[{\"x\":8,\"y\":9}],\"z\":1}", "unexpected sorted json: " + s)
}

test "nested_closures_and_value_params" {
  assert_jq("def addn($n): . + $n; [1,2,3] | map(addn(10))", "null", ["[11,12,13]"])
  assert_jq("def fib: if . <= 1 then . else ((. - 1) | fib) + ((. - 2) | fib) end; 8 | fib", "null", ["21"])
  assert_jq("def mymap(f): [.[] | f]; [1,2,3] | mymap(. * .)", "null", ["[1,4,9]"])
}

test "unicode_and_escape_handling" {
  assert_jq("\"\\u0041\\u03B1\\uD83D\\uDE00\" | length", "null", ["3"])
  assert_jq("\"\\u0041\\u03B1\\uD83D\\uDE00\" | utf8bytelength", "null", ["7"])
  assert_jq("\"héllo wörld\" | .[1:5]", "null", ["\"éllo\""])
  assert_jq("\"a/b c\" | @uri", "null", ["\"a%2Fb%20c\""])
  assert_jq("\"héllo\" | @base64 | @base64d", "null", ["\"héllo\""])
}

test "object_key_order_and_dedup" {
  assert_jq("{\"a\":1,\"b\":2,\"a\":3}", "null", ["{\"a\":3,\"b\":2}"])
  assert_jq("{\"b\":1,\"a\":2} | keys", "null", ["[\"a\",\"b\"]"])
  assert_jq("{\"b\":1,\"a\":2} | keys_unsorted", "null", ["[\"b\",\"a\"]"])
}

test "regex_capture_and_sub_with_filter" {
  assert_jq(
    "\"2026-11-23\" | sub(\"(?<y>[0-9]{4})-(?<m>[0-9]{2})-(?<d>[0-9]{2})\"; \"\\(.d)/\\(.m)/\\(.y)\")",
    "null",
    ["\"23/11/2026\""],
  )
  assert_jq(
    "\"a1 b2 c3\" | gsub(\"(?<k>[a-z])(?<v>[0-9])\"; \"\\(.k)=\\(.v)\")",
    "null",
    ["\"a=1 b=2 c=3\""],
  )
}

test "null_and_empty_edge_cases" {
  assert_jq("[] | min", "null", ["null"])
  assert_jq("[] | max", "null", ["null"])
  assert_jq("[] | min_by(.x)", "null", ["null"])
  assert_jq("[] | max_by(.x)", "null", ["null"])
  assert_jq("[] | group_by(.x)", "null", ["[]"])
  assert_jq("[] | sort_by(.x)", "null", ["[]"])
  assert_jq("[] | unique_by(.x)", "null", ["[]"])
  assert_jq("null | length", "null", ["0"])
  assert_jq("null | .a.b.c", "null", ["null"])
  assert_jq("null | .[0]", "null", ["null"])
}

test "redteam_p0_p1_p2_regressions" {
  // P0-1: regex anchors are string-anchored by default (no newline bypass)
  assert_jq("test(\"^[a-z]+$\")", "\"ok\\n; rm -rf /\"", ["false"])
  // P0-2 / P0-3: exact >2^53 integers and exact modulo
  assert_jq_exact(".", "9007199254740993", ["9007199254740993"])
  assert_jq_exact(".id", "{\"id\":12345678901234567890}", ["12345678901234567890"])
  assert_jq("1e17 % 7", "null", ["5"])
  // P0-4: streaming limit preserves emitted outputs before break/error
  assert_jq("[label $f | limit(3; 1, break $f)]", "null", ["[1]"])
  assert_jq("try limit(5; 1, 2, error(\"x\")) catch .", "null", ["1", "2", "\"x\""])
  // P0-5: implode surrogate replaced with U+FFFD
  assert_jq("[55296] | implode | @base64", "null", ["\"77+9\""])
  // P0-6: shared structure doubling bounded by max_output_bytes
  let lim = JqLimits::new(64, 100000, 1000, 4096)
  match eval_json_with_limits("reduce range(18) as $i ([1]; [., .]) | tojson | length", "null", lim) {
    Err(JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "shared structure tojson must hit LimitExceeded")
  }
  match eval_json_with_limits("reduce range(18) as $i ([1]; [., .])", "null", lim) {
    Err(JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "shared structure output must hit LimitExceeded")
  }
  // P1/P2: user def path, slice update, compile-time unknown fn, core builtins, tail recursion
  assert_jq("def f: .a; f |= 1", "{\"a\":5}", ["{\"a\":1}"])
  assert_jq(".[1:3] |= map(. * 10)", "[1,2,3,4]", ["[1,20,30,4]"])
  assert_jq("first(.b[]) |= 9", "{\"b\":[1,2,3]}", ["{\"b\":[9,2,3]}"])
  assert_jq("sub(\"a\"; \"1\", \"2\")", "\"abc\"", ["\"1bc\"", "\"2bc\""])
  assert_jq("{\"a\":1,\"b\":2} | add", "null", ["3"])
  assert_jq("[while(. < 10; . + 3)]", "1", ["[1,4,7]"])
  assert_jq("until(. > 10; . * 2)", "1", ["16"])
  assert_jq("pow(2; 10)", "null", ["1024"])
  assert_jq("sqrt", "16", ["4"])
  assert_jq("def f: if . < 1000 then . + 1 | f else . end; 0 | f", "null", ["1000"])
  match compile("nosuchfn") {
    Err(JqError::CompileError(_)) => ()
    _ => debug_assert(false, "unknown function must be compile error")
  }
  match compile(". a") {
    Err(JqError::SyntaxError(_, _)) => ()
    _ => debug_assert(false, "whitespace between dot and field must be syntax error")
  }
}
