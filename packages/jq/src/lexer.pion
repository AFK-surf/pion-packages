///| Lexer for the jq query language, including nested string interpolation `\(...)`.

enum TokKind {
  Eof
  Dot
  DotDot
  Pipe
  Comma
  Semicolon
  Colon
  Question
  AltPat
  LParen
  RParen
  LBracket
  RBracket
  LBrace
  RBrace
  Plus
  Minus
  Star
  Slash
  Percent
  EqEq
  NotEq
  Lt
  Le
  Gt
  Ge
  Alt
  Assign
  Update
  AddAssign
  SubAssign
  MulAssign
  DivAssign
  ModAssign
  AltAssign
  KwAnd
  KwOr
  KwAs
  KwIf
  KwThen
  KwElif
  KwElse
  KwEnd
  KwTry
  KwCatch
  KwReduce
  KwForeach
  KwDef
  KwLabel
  KwBreak
  KwNull
  KwTrue
  KwFalse
  Num(JqVal)
  Str(String)
  StrStart(String)
  StrMid(String)
  StrEnd(String)
  Ident(String)
  Var(String)
  Format(String)
}

struct Token {
  kind : TokKind
  pos : Int
}

pub fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

pub fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

pub fn is_ident_char(b : Int) -> Bool {
  is_ascii_alpha(b) || is_ascii_digit(b)
}

#verify
pub fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

///| Sanitize a Unicode code point to a valid Unicode scalar value (RFC 3629),
///| replacing out-of-range or UTF-16 surrogate values with U+FFFD.
#verify
pub fn sanitize_utf8_cp(cp : Int) -> Int {
  if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    0xFFFD
  } else {
    cp
  }
}

///| Check whether a 16-bit code unit is a UTF-16 high surrogate (0xD800..0xDBFF).
#verify
pub fn is_high_surrogate(u : Int) -> Bool {
  u >= 0xD800 && u <= 0xDBFF
}

///| Check whether a 16-bit code unit is a UTF-16 low surrogate (0xDC00..0xDFFF).
#verify
pub fn is_low_surrogate(u : Int) -> Bool {
  u >= 0xDC00 && u <= 0xDFFF
}

///| Combine a valid UTF-16 surrogate pair `(hi, lo)` into a supplementary Unicode scalar value.
#verify
pub fn decode_surrogate_pair(hi : Int, lo : Int) -> Int {
  0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
}

fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  let safe_cp = sanitize_utf8_cp(cp)
  if safe_cp < 0x80 {
    sb.write_byte(safe_cp.to_byte())
  } else if safe_cp < 0x800 {
    sb.write_byte((0xC0 | (safe_cp >> 6)).to_byte())
    sb.write_byte((0x80 | (safe_cp & 0x3F)).to_byte())
  } else if safe_cp < 0x10000 {
    sb.write_byte((0xE0 | (safe_cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((safe_cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (safe_cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (safe_cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((safe_cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((safe_cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (safe_cp & 0x3F)).to_byte())
  }
}

fn scan_hex4(src : String, pos : Int) -> Result[Int, JqError] {
  if pos + 4 > src.length() {
    return Err(JqError::SyntaxError(pos, "incomplete \\uXXXX escape"))
  }
  let mut v = 0
  let mut i = 0
  while i < 4 {
    let d = hex_val(src.code_unit_at(pos + i))
    if d < 0 {
      return Err(JqError::SyntaxError(pos + i, "invalid hex digit in \\uXXXX escape"))
    }
    v = (v << 4) | d
    i = i + 1
  }
  Ok(v)
}

///| Scan a string body starting at `pos` (right after opening `"` or right after `)` of `\(...)`).
///| Returns `(text, next_pos, hit_interp)`.
fn scan_string_part(
  src : String,
  start_pos : Int,
) -> Result[(String, Int, Bool), JqError] {
  let n = src.length()
  let sb = StringBuilder::new()
  let mut i = start_pos
  while i < n {
    let b = src.code_unit_at(i)
    if b == 34 {
      // '"'
      return Ok((sb.to_string(), i + 1, false))
    }
    if b == 92 {
      // '\'
      if i + 1 >= n {
        return Err(JqError::SyntaxError(i, "unterminated escape in string"))
      }
      let esc = src.code_unit_at(i + 1)
      if esc == 40 {
        // '\(' interpolation start
        return Ok((sb.to_string(), i + 2, true))
      }
      if esc == 34 {
        sb.write_byte(34.to_byte())
        i = i + 2
      } else if esc == 92 {
        sb.write_byte(92.to_byte())
        i = i + 2
      } else if esc == 47 {
        sb.write_byte(47.to_byte())
        i = i + 2
      } else if esc == 98 {
        sb.write_byte(8.to_byte())
        i = i + 2
      } else if esc == 102 {
        sb.write_byte(12.to_byte())
        i = i + 2
      } else if esc == 110 {
        sb.write_byte(10.to_byte())
        i = i + 2
      } else if esc == 114 {
        sb.write_byte(13.to_byte())
        i = i + 2
      } else if esc == 116 {
        sb.write_byte(9.to_byte())
        i = i + 2
      } else if esc == 117 {
        let u1 = match scan_hex4(src, i + 2) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        i = i + 6
        if is_high_surrogate(u1) {
          if i + 6 <= n && src.code_unit_at(i) == 92 && src.code_unit_at(i + 1) == 117 {
            let u2 = match scan_hex4(src, i + 2) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            if is_low_surrogate(u2) {
              let cp = decode_surrogate_pair(u1, u2)
              write_utf8_cp(sb, cp)
              i = i + 6
            } else {
              write_utf8_cp(sb, 0xFFFD)
            }
          } else {
            write_utf8_cp(sb, 0xFFFD)
          }
        } else if u1 >= 0xDC00 && u1 <= 0xDFFF {
          write_utf8_cp(sb, 0xFFFD)
        } else {
          write_utf8_cp(sb, u1)
        }
      } else {
        return Err(JqError::SyntaxError(i, "invalid escape sequence in string"))
      }
    } else if b < 0x20 {
      return Err(JqError::SyntaxError(i, "unescaped control character in string"))
    } else {
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  Err(JqError::SyntaxError(start_pos, "unterminated string literal"))
}

fn parse_num_str(s : String, pos : Int) -> Result[JqVal, JqError] {
  match parse_jq_number_str(s, true) {
    Some(v) => Ok(v)
    None => Err(JqError::SyntaxError(pos, "invalid number literal: " + s))
  }
}

fn keyword_or_ident(s : String) -> TokKind {
  if s == "and" {
    TokKind::KwAnd
  } else if s == "or" {
    TokKind::KwOr
  } else if s == "as" {
    TokKind::KwAs
  } else if s == "if" {
    TokKind::KwIf
  } else if s == "then" {
    TokKind::KwThen
  } else if s == "elif" {
    TokKind::KwElif
  } else if s == "else" {
    TokKind::KwElse
  } else if s == "end" {
    TokKind::KwEnd
  } else if s == "try" {
    TokKind::KwTry
  } else if s == "catch" {
    TokKind::KwCatch
  } else if s == "reduce" {
    TokKind::KwReduce
  } else if s == "foreach" {
    TokKind::KwForeach
  } else if s == "def" {
    TokKind::KwDef
  } else if s == "label" {
    TokKind::KwLabel
  } else if s == "break" {
    TokKind::KwBreak
  } else if s == "null" {
    TokKind::KwNull
  } else if s == "true" {
    TokKind::KwTrue
  } else if s == "false" {
    TokKind::KwFalse
  } else {
    TokKind::Ident(s)
  }
}

fn tokenize(src : String, max_depth : Int) -> Result[Array[Token], JqError] {
  let tokens : Array[Token] = []
  let interp_stack : Array[Int] = []
  let n = src.length()
  let mut i = 0
  while i < n {
    let b = src.code_unit_at(i)
    // Skip whitespace
    if b == 32 || b == 9 || b == 10 || b == 13 {
      i = i + 1
      continue
    }
    // Skip # comments
    if b == 35 {
      i = i + 1
      while i < n && src.code_unit_at(i) != 10 {
        i = i + 1
      }
      continue
    }
    let start = i
    // String literal
    if b == 34 {
      let (text, next_i, hit_interp) = match scan_string_part(src, i + 1) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      if hit_interp {
        if interp_stack.length() >= max_depth {
          return Err(JqError::LimitExceeded("max string interpolation depth exceeded"))
        }
        tokens.push(Token::{ kind: TokKind::StrStart(text), pos: start })
        interp_stack.push(0)
      } else {
        tokens.push(Token::{ kind: TokKind::Str(text), pos: start })
      }
      i = next_i
      continue
    }
    // Closing paren might end an active string interpolation
    if b == 41 {
      let slen = interp_stack.length()
      if slen > 0 {
        let depth = interp_stack[slen - 1]
        if depth == 0 {
          let _ = interp_stack.pop()
          let (text, next_i, hit_interp) = match scan_string_part(src, i + 1) {
            Ok(r) => r
            Err(e) => return Err(e)
          }
          if hit_interp {
            tokens.push(Token::{ kind: TokKind::StrMid(text), pos: start })
            interp_stack.push(0)
          } else {
            tokens.push(Token::{ kind: TokKind::StrEnd(text), pos: start })
          }
          i = next_i
          continue
        } else {
          interp_stack[slen - 1] = depth - 1
        }
      }
      tokens.push(Token::{ kind: TokKind::RParen, pos: start })
      i = i + 1
      continue
    }
    if b == 40 {
      let slen = interp_stack.length()
      if slen > 0 {
        interp_stack[slen - 1] = interp_stack[slen - 1] + 1
      }
      tokens.push(Token::{ kind: TokKind::LParen, pos: start })
      i = i + 1
      continue
    }
    // Numbers (digits, or '.' followed by digit)
    if is_ascii_digit(b) || (b == 46 && i + 1 < n && is_ascii_digit(src.code_unit_at(i + 1))) {
      let mut j = i
      while j < n && is_ascii_digit(src.code_unit_at(j)) {
        j = j + 1
      }
      if j < n && src.code_unit_at(j) == 46 {
        j = j + 1
        while j < n && is_ascii_digit(src.code_unit_at(j)) {
          j = j + 1
        }
      }
      if j < n && (src.code_unit_at(j) == 101 || src.code_unit_at(j) == 69) {
        j = j + 1
        if j < n && (src.code_unit_at(j) == 43 || src.code_unit_at(j) == 45) {
          j = j + 1
        }
        let exp_start = j
        while j < n && is_ascii_digit(src.code_unit_at(j)) {
          j = j + 1
        }
        if j == exp_start {
          return Err(JqError::SyntaxError(start, "invalid exponent in number literal"))
        }
      }
      let num_s = src.slice(start, j)
      let num_v = match parse_num_str(num_s, start) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      tokens.push(Token::{ kind: TokKind::Num(num_v), pos: start })
      i = j
      continue
    }
    // Variable: $ident
    if b == 36 {
      let mut j = i + 1
      if j >= n || !is_ascii_alpha(src.code_unit_at(j)) {
        return Err(JqError::SyntaxError(start, "expected variable name after '$'"))
      }
      while j < n && is_ident_char(src.code_unit_at(j)) {
        j = j + 1
      }
      tokens.push(Token::{ kind: TokKind::Var(src.slice(i + 1, j)), pos: start })
      i = j
      continue
    }
    // Format: @ident
    if b == 64 {
      let mut j = i + 1
      if j >= n || !is_ascii_alpha(src.code_unit_at(j)) {
        return Err(JqError::SyntaxError(start, "expected format name after '@'"))
      }
      while j < n && is_ident_char(src.code_unit_at(j)) {
        j = j + 1
      }
      tokens.push(Token::{ kind: TokKind::Format(src.slice(i + 1, j)), pos: start })
      i = j
      continue
    }
    // Identifiers / keywords
    if is_ascii_alpha(b) {
      let mut j = i + 1
      while j < n && is_ident_char(src.code_unit_at(j)) {
        j = j + 1
      }
      let word = src.slice(start, j)
      tokens.push(Token::{ kind: keyword_or_ident(word), pos: start })
      i = j
      continue
    }
    // Operators & punctuation
    let b1 = if i + 1 < n { src.code_unit_at(i + 1) } else { 0 }
    let b2 = if i + 2 < n { src.code_unit_at(i + 2) } else { 0 }
    if b == 46 {
      if b1 == 46 {
        tokens.push(Token::{ kind: TokKind::DotDot, pos: start })
        i = i + 2
      } else {
        tokens.push(Token::{ kind: TokKind::Dot, pos: start })
        i = i + 1
      }
    } else if b == 124 {
      if b1 == 61 {
        tokens.push(Token::{ kind: TokKind::Update, pos: start })
        i = i + 2
      } else {
        tokens.push(Token::{ kind: TokKind::Pipe, pos: start })
        i = i + 1
      }
    } else if b == 47 {
      if b1 == 47 {
        if b2 == 61 {
          tokens.push(Token::{ kind: TokKind::AltAssign, pos: start })
          i = i + 3
        } else {
          tokens.push(Token::{ kind: TokKind::Alt, pos: start })
          i = i + 2
        }
      } else if b1 == 61 {
        tokens.push(Token::{ kind: TokKind::DivAssign, pos: start })
        i = i + 2
      } else {
        tokens.push(Token::{ kind: TokKind::Slash, pos: start })
        i = i + 1
      }
    } else if b == 61 {
      if b1 == 61 {
        tokens.push(Token::{ kind: TokKind::EqEq, pos: start })
        i = i + 2
      } else {
        tokens.push(Token::{ kind: TokKind::Assign, pos: start })
        i = i + 1
      }
    } else if b == 33 {
      if b1 == 61 {
        tokens.push(Token::{ kind: TokKind::NotEq, pos: start })
        i = i + 2
      } else {
        return Err(JqError::SyntaxError(start, "unexpected '!'"))
      }
    } else if b == 60 {
      if b1 == 61 {
        tokens.push(Token::{ kind: TokKind::Le, pos: start })
        i = i + 2
      } else {
        tokens.push(Token::{ kind: TokKind::Lt, pos: start })
        i = i + 1
      }
    } else if b == 62 {
      if b1 == 61 {
        tokens.push(Token::{ kind: TokKind::Ge, pos: start })
        i = i + 2
      } else {
        tokens.push(Token::{ kind: TokKind::Gt, pos: start })
        i = i + 1
      }
    } else if b == 43 {
      if b1 == 61 {
        tokens.push(Token::{ kind: TokKind::AddAssign, pos: start })
        i = i + 2
      } else {
        tokens.push(Token::{ kind: TokKind::Plus, pos: start })
        i = i + 1
      }
    } else if b == 45 {
      if b1 == 61 {
        tokens.push(Token::{ kind: TokKind::SubAssign, pos: start })
        i = i + 2
      } else {
        tokens.push(Token::{ kind: TokKind::Minus, pos: start })
        i = i + 1
      }
    } else if b == 42 {
      if b1 == 61 {
        tokens.push(Token::{ kind: TokKind::MulAssign, pos: start })
        i = i + 2
      } else {
        tokens.push(Token::{ kind: TokKind::Star, pos: start })
        i = i + 1
      }
    } else if b == 37 {
      if b1 == 61 {
        tokens.push(Token::{ kind: TokKind::ModAssign, pos: start })
        i = i + 2
      } else {
        tokens.push(Token::{ kind: TokKind::Percent, pos: start })
        i = i + 1
      }
    } else if b == 44 {
      tokens.push(Token::{ kind: TokKind::Comma, pos: start })
      i = i + 1
    } else if b == 59 {
      tokens.push(Token::{ kind: TokKind::Semicolon, pos: start })
      i = i + 1
    } else if b == 58 {
      tokens.push(Token::{ kind: TokKind::Colon, pos: start })
      i = i + 1
    } else if b == 63 {
      if b1 == 47 && b2 == 47 {
        tokens.push(Token::{ kind: TokKind::AltPat, pos: start })
        i = i + 3
      } else {
        tokens.push(Token::{ kind: TokKind::Question, pos: start })
        i = i + 1
      }
    } else if b == 91 {
      tokens.push(Token::{ kind: TokKind::LBracket, pos: start })
      i = i + 1
    } else if b == 93 {
      tokens.push(Token::{ kind: TokKind::RBracket, pos: start })
      i = i + 1
    } else if b == 123 {
      tokens.push(Token::{ kind: TokKind::LBrace, pos: start })
      i = i + 1
    } else if b == 125 {
      tokens.push(Token::{ kind: TokKind::RBrace, pos: start })
      i = i + 1
    } else {
      return Err(JqError::SyntaxError(start, "unexpected character"))
    }
  }
  if interp_stack.length() > 0 {
    return Err(JqError::SyntaxError(n, "unterminated string interpolation"))
  }
  tokens.push(Token::{ kind: TokKind::Eof, pos: n })
  Ok(tokens)
}
