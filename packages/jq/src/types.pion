///| Public types, limits, and error definitions for `packages/jq`.

import "json5"

///| Error returned when compiling or evaluating a jq query fails.
pub enum JqError {
  SyntaxError(Int, String)
  CompileError(String)
  RuntimeError(String)
  UserError(json5::Json5Value)
  InvalidJson(String)
  LimitExceeded(String)
  InvalidLimits(String)
}

///| Format a `JqError` as a human-readable string.
pub fn error_message(err : JqError) -> String {
  match err {
    JqError::SyntaxError(pos, msg) =>
    "syntax error at offset " + pos.to_string() + ": " + msg
    JqError::CompileError(msg) => "compile error: " + msg
    JqError::RuntimeError(msg) => "runtime error: " + msg
    JqError::UserError(v) =>
    match json5::to_json_string(v) {
      Ok(s) => "user error: " + s
      Err(_) => "user error"
    }
    JqError::InvalidJson(msg) => "invalid json: " + msg
    JqError::LimitExceeded(msg) => "limit exceeded: " + msg
    JqError::InvalidLimits(msg) => "invalid limits: " + msg
  }
}

///| Configurable safety limits to prevent stack overflow, infinite loops, and memory exhaustion.
pub val struct JqLimits {
  pub max_depth : Int
  pub max_steps : Int
  pub max_outputs : Int
  pub max_output_bytes : Int
}

///| Default safety limits.
pub fn JqLimits::default() -> JqLimits {
  JqLimits::{
    max_depth: 256,
    max_steps: 2000000,
    max_outputs: 100000,
    max_output_bytes: 16777216,
  }
}

///| Construct custom `JqLimits`.
pub fn JqLimits::new(
  max_depth : Int,
  max_steps : Int,
  max_outputs : Int,
  max_output_bytes : Int,
) -> JqLimits {
  JqLimits::{
    max_depth: max_depth,
    max_steps: max_steps,
    max_outputs: max_outputs,
    max_output_bytes: max_output_bytes,
  }
}

///| Validate that all limits are strictly positive.
pub fn validate_limits(limits : JqLimits) -> Result[Unit, JqError] {
  if limits.max_depth <= 0 {
    return Err(JqError::InvalidLimits("max_depth must be positive"))
  }
  if limits.max_steps <= 0 {
    return Err(JqError::InvalidLimits("max_steps must be positive"))
  }
  if limits.max_outputs <= 0 {
    return Err(JqError::InvalidLimits("max_outputs must be positive"))
  }
  if limits.max_output_bytes <= 0 {
    return Err(JqError::InvalidLimits("max_output_bytes must be positive"))
  }
  Ok(())
}

///| Compiled jq query ready for repeated evaluation against JSON inputs.
pub struct Query {
  pub source : String
  exprs : Array[Expr]
  root : Int
}
