///| Seeded open-addressing hash index for O(1) object key lookups, `from_entries`,
///| `with_entries`, object merges, and batched structural updates in `packages/jq`.

struct JqSeedState {
  mut counter : UInt64
}

let jq_seed_state : JqSeedState = JqSeedState::{ counter: 0x9E3779B97F4A7C15UL }

fn jq_splitmix64(x : UInt64) -> UInt64 {
  let mut z = x + 0x9E3779B97F4A7C15UL
  z = (z ^ (z >> 30UL)) * 0xBF58476D1CE4E5B9UL
  z = (z ^ (z >> 27UL)) * 0x94D049BB133111EBUL
  z ^ (z >> 31UL)
}

fn jq_next_seed() -> UInt64 {
  jq_seed_state.counter = jq_seed_state.counter + 0x9E3779B97F4A7C15UL
  jq_splitmix64(jq_seed_state.counter)
}

fn jq_hash_str(s : String, seed : UInt64) -> UInt64 {
  let n = s.length()
  let mut h = seed ^ (n.to_int64().reinterpret_as_uint64() * 0x9E3779B97F4A7C15UL)
  let mut i = 0
  while i + 4 <= n {
    let w = s.code_unit_at(i).to_int64().reinterpret_as_uint64() |
    (s.code_unit_at(i + 1).to_int64().reinterpret_as_uint64() << 8UL) |
    (s.code_unit_at(i + 2).to_int64().reinterpret_as_uint64() << 16UL) |
    (s.code_unit_at(i + 3).to_int64().reinterpret_as_uint64() << 24UL)
    h = (h ^ w) * 0xBF58476D1CE4E5B9UL
    h = h ^ (h >> 27UL)
    i = i + 4
  }
  while i < n {
    h = (h ^ s.code_unit_at(i).to_int64().reinterpret_as_uint64()) * 0x94D049BB133111EBUL
    h = h ^ (h >> 31UL)
    i = i + 1
  }
  h = (h ^ (h >> 30UL)) * 0xBF58476D1CE4E5B9UL
  h = (h ^ (h >> 27UL)) * 0x94D049BB133111EBUL
  h = h ^ (h >> 31UL)
  if h == 0UL { 1UL } else { h }
}

struct ObjHashIndex {
  seed : UInt64
  mut cap : Int
  mut len : Int
  mut keys : FixedArray[String]
  mut hashes : FixedArray[UInt64]
  ///| entry_idx + 1 (0 means empty slot)
  mut vals : FixedArray[Int]
}

fn ObjHashIndex::new(initial_cap : Int) -> ObjHashIndex {
  let mut c = 16
  while c < initial_cap {
    c = c << 1
  }
  ObjHashIndex::{
    seed: jq_next_seed(),
    cap: c,
    len: 0,
    keys: FixedArray::make(c, ""),
    hashes: FixedArray::make(c, 0UL),
    vals: FixedArray::make(c, 0),
  }
}

fn ObjHashIndex::grow(self : ObjHashIndex) -> Unit {
  let old_cap = self.cap
  let old_keys = self.keys
  let old_hashes = self.hashes
  let old_vals = self.vals
  let new_cap = old_cap << 1
  let new_mask = (new_cap - 1).to_int64().reinterpret_as_uint64()
  let new_keys = FixedArray::make(new_cap, "")
  let new_hashes = FixedArray::make(new_cap, 0UL)
  let new_vals = FixedArray::make(new_cap, 0)
  let mut i = 0
  while i < old_cap {
    let v = old_vals[i]
    if v != 0 {
      let h = old_hashes[i]
      let mut slot = (h & new_mask).to_int()
      while new_vals[slot] != 0 {
        slot = (slot + 1) & (new_cap - 1)
      }
      new_keys[slot] = old_keys[i]
      new_hashes[slot] = h
      new_vals[slot] = v
    }
    i = i + 1
  }
  self.cap = new_cap
  self.keys = new_keys
  self.hashes = new_hashes
  self.vals = new_vals
}

fn ObjHashIndex::get(self : ObjHashIndex, key : String) -> Int {
  let h = jq_hash_str(key, self.seed)
  let mask = self.cap - 1
  let mut slot = (h & mask.to_int64().reinterpret_as_uint64()).to_int()
  while true {
    let v = self.vals[slot]
    if v == 0 {
      return -1
    }
    if self.hashes[slot] == h && self.keys[slot] == key {
      return v - 1
    }
    slot = (slot + 1) & mask
  }
  -1
}

///| Insert or overwrite `key -> entry_idx`. Returns previous `entry_idx` or `-1`.
fn ObjHashIndex::upsert(self : ObjHashIndex, key : String, entry_idx : Int) -> Int {
  if self.len * 8 >= self.cap * 5 {
    self.grow()
  }
  let h = jq_hash_str(key, self.seed)
  let mask = self.cap - 1
  let mut slot = (h & mask.to_int64().reinterpret_as_uint64()).to_int()
  while true {
    let v = self.vals[slot]
    if v == 0 {
      self.keys[slot] = key
      self.hashes[slot] = h
      self.vals[slot] = entry_idx + 1
      self.len = self.len + 1
      return -1
    }
    if self.hashes[slot] == h && self.keys[slot] == key {
      self.vals[slot] = entry_idx + 1
      return v - 1
    }
    slot = (slot + 1) & mask
  }
  -1
}
