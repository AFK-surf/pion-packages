///| Standard library built-in helpers and formatters (`@text`, `@json`, `@html`,
///| `@uri`, `@csv`, `@tsv`, `@sh`, `@base64`, `@base64d`, regex, string & collection ops).

import "json5"
import "regex"
import "base64"

fn bytes_to_string_lossy(bs : Bytes) -> String {
  let sb = StringBuilder::new()
  let n = bs.length()
  let mut i = 0
  while i < n {
    sb.write_byte(bs[i])
    i = i + 1
  }
  sb.to_string()
}

fn format_html(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 38 {
      sb.write_string("&amp;")
    } else if b == 60 {
      sb.write_string("&lt;")
    } else if b == 62 {
      sb.write_string("&gt;")
    } else if b == 39 {
      sb.write_string("&apos;")
    } else if b == 34 {
      sb.write_string("&quot;")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn format_uri(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    let unreserved = (b >= 65 && b <= 90) ||
    (b >= 97 && b <= 122) ||
    (b >= 48 && b <= 57) ||
    b == 45 ||
    b == 95 ||
    b == 46 ||
    b == 126
    if unreserved {
      sb.write_byte(b.to_byte())
    } else {
      sb.write_byte(37.to_byte())
      let hi = (b >> 4) & 0xF
      let lo = b & 0xF
      sb.write_byte((if hi < 10 { 48 + hi } else { 55 + hi }).to_byte())
      sb.write_byte((if lo < 10 { 48 + lo } else { 55 + lo }).to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn format_sh_one(s : String) -> String {
  let sb = StringBuilder::new()
  sb.write_byte(39.to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 39 {
      sb.write_string("'\\''")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte(39.to_byte())
  sb.to_string()
}

fn format_csv(v : json5::Json5Value) -> Result[String, JqError] {
  let items = match v {
    json5::Json5Value::Array(xs) => xs
    _ => return Err(JqError::RuntimeError("@csv requires an array"))
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < items.length() {
    if i > 0 {
      sb.write_byte(44.to_byte())
    }
    match items[i] {
      json5::Json5Value::Null => ()
      json5::Json5Value::Bool(b) => sb.write_string(if b { "true" } else { "false" })
      json5::Json5Value::Number(_) => {
        match serialize_jq_json(items[i], false) {
          Ok(s) => sb.write_string(s)
          Err(e) => return Err(e)
        }
      }
      json5::Json5Value::Str(s) => {
        sb.write_byte(34.to_byte())
        let mut j = 0
        while j < s.length() {
          let b = s.code_unit_at(j)
          if b == 34 {
            sb.write_string("\"\"")
          } else {
            sb.write_byte(b.to_byte())
          }
          j = j + 1
        }
        sb.write_byte(34.to_byte())
      }
      other =>
      return Err(
        JqError::RuntimeError(jq_type_name(other) + " is not valid in a csv row"),
      )
    }
    i = i + 1
  }
  Ok(sb.to_string())
}

fn format_tsv(v : json5::Json5Value) -> Result[String, JqError] {
  let items = match v {
    json5::Json5Value::Array(xs) => xs
    _ => return Err(JqError::RuntimeError("@tsv requires an array"))
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < items.length() {
    if i > 0 {
      sb.write_byte(9.to_byte())
    }
    match items[i] {
      json5::Json5Value::Null => ()
      json5::Json5Value::Bool(b) => sb.write_string(if b { "true" } else { "false" })
      json5::Json5Value::Number(_) => {
        match serialize_jq_json(items[i], false) {
          Ok(s) => sb.write_string(s)
          Err(e) => return Err(e)
        }
      }
      json5::Json5Value::Str(s) => {
        let mut j = 0
        while j < s.length() {
          let b = s.code_unit_at(j)
          if b == 9 {
            sb.write_string("\\t")
          } else if b == 10 {
            sb.write_string("\\n")
          } else if b == 13 {
            sb.write_string("\\r")
          } else if b == 92 {
            sb.write_string("\\\\")
          } else {
            sb.write_byte(b.to_byte())
          }
          j = j + 1
        }
      }
      other =>
      return Err(
        JqError::RuntimeError(jq_type_name(other) + " is not valid in a tsv row"),
      )
    }
    i = i + 1
  }
  Ok(sb.to_string())
}

fn apply_format(fmt : String, v : json5::Json5Value) -> Result[String, JqError] {
  if fmt == "text" || fmt == "" {
    jq_tostring_val(v)
  } else if fmt == "json" {
    serialize_jq_json(v, false)
  } else if fmt == "html" {
    match jq_tostring_val(v) {
      Ok(s) => Ok(format_html(s))
      Err(e) => Err(e)
    }
  } else if fmt == "uri" {
    match jq_tostring_val(v) {
      Ok(s) => Ok(format_uri(s))
      Err(e) => Err(e)
    }
  } else if fmt == "csv" {
    format_csv(v)
  } else if fmt == "tsv" {
    format_tsv(v)
  } else if fmt == "sh" {
    match v {
      json5::Json5Value::Array(items) => {
        let sb = StringBuilder::new()
        let mut i = 0
        while i < items.length() {
          if i > 0 {
            sb.write_byte(32.to_byte())
          }
          let s = match jq_tostring_val(items[i]) {
            Ok(x) => x
            Err(e) => return Err(e)
          }
          sb.write_string(format_sh_one(s))
          i = i + 1
        }
        Ok(sb.to_string())
      }
      _ =>
      match jq_tostring_val(v) {
        Ok(s) => Ok(format_sh_one(s))
        Err(e) => Err(e)
      }
    }
  } else if fmt == "base64" {
    match jq_tostring_val(v) {
      Ok(s) => Ok(base64::encode(s.to_bytes()))
      Err(e) => Err(e)
    }
  } else if fmt == "base64d" {
    match v {
      json5::Json5Value::Str(s) =>
      match base64::decode(s) {
        Ok(bs) => Ok(bytes_to_string_lossy(bs))
        Err(e) => Err(JqError::RuntimeError("invalid base64: " + base64::error_message(e)))
      }
      _ => Err(JqError::RuntimeError("@base64d requires a string"))
    }
  } else {
    Err(JqError::RuntimeError("unknown format @" + fmt))
  }
}

fn str_ascii_downcase(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn str_ascii_upcase(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 97 && b <= 122 {
      sb.write_byte((b - 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn str_starts_with(s : String, prefix : String) -> Bool {
  let n = s.length()
  let m = prefix.length()
  if m > n {
    return false
  }
  let mut i = 0
  while i < m {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn str_ends_with(s : String, suffix : String) -> Bool {
  let n = s.length()
  let m = suffix.length()
  if m > n {
    return false
  }
  let off = n - m
  let mut i = 0
  while i < m {
    if s.code_unit_at(off + i) != suffix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn str_contains_sub(hay : String, needle : String) -> Bool {
  let n = hay.length()
  let m = needle.length()
  if m == 0 {
    return true
  }
  if m > n {
    return false
  }
  let mut i = 0
  while i + m <= n {
    let mut ok = true
    let mut k = 0
    while k < m {
      if hay.code_unit_at(i + k) != needle.code_unit_at(k) {
        ok = false
        break
      }
      k = k + 1
    }
    if ok {
      return true
    }
    i = i + 1
  }
  false
}

fn jq_contains(a : json5::Json5Value, b : json5::Json5Value) -> Result[Bool, JqError] {
  match (a, b) {
    (json5::Json5Value::Str(sa), json5::Json5Value::Str(sb)) =>
    Ok(str_contains_sub(sa, sb))
    (json5::Json5Value::Array(xa), json5::Json5Value::Array(xb)) => {
      let mut i = 0
      while i < xb.length() {
        let mut found = false
        let mut j = 0
        while j < xa.length() {
          match jq_contains(xa[j], xb[i]) {
            Ok(true) => {
              found = true
              break
            }
            _ => ()
          }
          j = j + 1
        }
        if !found {
          return Ok(false)
        }
        i = i + 1
      }
      Ok(true)
    }
    (json5::Json5Value::Object(oa), json5::Json5Value::Object(ob)) => {
      let mut i = 0
      while i < ob.length() {
        let (kb, vb) = ob[i]
        match obj_get_last(oa, kb) {
          None => return Ok(false)
          Some(va) =>
          match jq_contains(va, vb) {
            Ok(true) => ()
            Ok(false) => return Ok(false)
            Err(e) => return Err(e)
          }
        }
        i = i + 1
      }
      Ok(true)
    }
    _ => {
      if jq_type_name(a) != jq_type_name(b) {
        return Err(
          JqError::RuntimeError(
            jq_type_name(a) + " and " + jq_type_name(b) + " cannot have their containment checked",
          ),
        )
      }
      Ok(jq_eq(a, b))
    }
  }
}

fn jq_indices(
  target : json5::Json5Value,
  needle : json5::Json5Value,
) -> Result[Array[json5::Json5Value], JqError] {
  let out : Array[json5::Json5Value] = []
  match target {
    json5::Json5Value::Null => Ok(out)
    json5::Json5Value::Str(s) => {
      let pat = match needle {
        json5::Json5Value::Str(p) => p
        _ => return Err(JqError::RuntimeError("indices on string requires string argument"))
      }
      let n = s.length()
      let m = pat.length()
      if m == 0 || m > n {
        return Ok(out)
      }
      let mut i = 0
      while i + m <= n {
        let mut ok = true
        let mut k = 0
        while k < m {
          if s.code_unit_at(i + k) != pat.code_unit_at(k) {
            ok = false
            break
          }
          k = k + 1
        }
        if ok {
          out.push(json5::Json5Value::Number(utf8_byte_to_cp(s, i).to_double()))
        }
        i = i + 1
      }
      Ok(out)
    }
    json5::Json5Value::Array(items) => {
      match needle {
        json5::Json5Value::Array(sub) => {
          let n = items.length()
          let m = sub.length()
          if m == 0 || m > n {
            return Ok(out)
          }
          let mut i = 0
          while i + m <= n {
            let mut ok = true
            let mut k = 0
            while k < m {
              if !jq_eq(items[i + k], sub[k]) {
                ok = false
                break
              }
              k = k + 1
            }
            if ok {
              out.push(json5::Json5Value::Number(i.to_double()))
            }
            i = i + 1
          }
          Ok(out)
        }
        _ => {
          let mut i = 0
          while i < items.length() {
            if jq_eq(items[i], needle) {
              out.push(json5::Json5Value::Number(i.to_double()))
            }
            i = i + 1
          }
          Ok(out)
        }
      }
    }
    _ => Err(JqError::RuntimeError("cannot find indices in " + jq_type_name(target)))
  }
}

fn compile_jq_regex(
  pattern : String,
  flags : String,
) -> Result[(regex::Regex, Bool, Bool), JqError] {
  let mut ci = false
  let mut dot_nl = false
  let mut multi_line = true
  let mut ignore_ws = false
  let mut is_global = false
  let mut ignore_empty = false
  let mut i = 0
  while i < flags.length() {
    let b = flags.code_unit_at(i)
    if b == 105 {
      // 'i'
      ci = true
    } else if b == 103 {
      // 'g'
      is_global = true
    } else if b == 109 || b == 115 {
      // 'm' or 's'
      dot_nl = true
    } else if b == 112 {
      // 'p'
      dot_nl = true
      multi_line = true
    } else if b == 120 {
      // 'x'
      ignore_ws = true
    } else if b == 110 {
      // 'n'
      ignore_empty = true
    } else if b == 108 {
      // 'l'
      ()
    } else {
      return Err(JqError::RuntimeError("unsupported regex flag"))
    }
    i = i + 1
  }
  let opts = regex::RegexOptions::{
    case_insensitive: ci,
    multi_line: multi_line,
    dot_matches_new_line: dot_nl,
    swap_greed: false,
    ignore_whitespace: ignore_ws,
    unicode: true,
    nest_limit: 250,
    size_limit: 1000000,
  }
  match regex::compile_with(pattern, opts) {
    Ok(re) => Ok((re, is_global, ignore_empty))
    Err(e) => Err(JqError::RuntimeError("invalid regex: " + e.message))
  }
}

fn captures_to_match_obj(
  text : String,
  re : regex::Regex,
  caps : regex::Captures,
) -> json5::Json5Value {
  let full = match caps.get(0) {
    Some(m) => m
    None => return json5::Json5Value::Null
  }
  let cp_off = utf8_byte_to_cp(text, full.start)
  let cp_len = utf8_char_len(full.text)
  let names = re.capture_names()
  let cap_arr : Array[json5::Json5Value] = []
  let mut i = 1
  while i < caps.len() {
    let cname = if i < names.length() {
      match names[i] {
        Some(nm) => json5::Json5Value::Str(nm)
        None => json5::Json5Value::Null
      }
    } else {
      json5::Json5Value::Null
    }
    match caps.get(i) {
      Some(cm) => {
        let coff = utf8_byte_to_cp(text, cm.start)
        let clen = utf8_char_len(cm.text)
        cap_arr.push(
          json5::Json5Value::Object([
            ("offset", json5::Json5Value::Number(coff.to_double())),
            ("length", json5::Json5Value::Number(clen.to_double())),
            ("string", json5::Json5Value::Str(cm.text)),
            ("name", cname),
          ]),
        )
      }
      None =>
      cap_arr.push(
        json5::Json5Value::Object([
          ("offset", json5::Json5Value::Number(-1.0)),
          ("length", json5::Json5Value::Number(0.0)),
          ("string", json5::Json5Value::Null),
          ("name", cname),
        ]),
      )
    }
    i = i + 1
  }
  json5::Json5Value::Object([
    ("offset", json5::Json5Value::Number(cp_off.to_double())),
    ("length", json5::Json5Value::Number(cp_len.to_double())),
    ("string", json5::Json5Value::Str(full.text)),
    ("captures", json5::Json5Value::Array(cap_arr)),
  ])
}

fn captures_to_named_obj(
  re : regex::Regex,
  caps : regex::Captures,
) -> json5::Json5Value {
  let names = re.capture_names()
  let entries : Array[(String, json5::Json5Value)] = []
  let mut i = 1
  while i < names.length() {
    match names[i] {
      Some(nm) =>
      match caps.get(i) {
        Some(cm) => entries.push((nm, json5::Json5Value::Str(cm.text)))
        None => entries.push((nm, json5::Json5Value::Null))
      }
      None => ()
    }
    i = i + 1
  }
  json5::Json5Value::Object(entries)
}
