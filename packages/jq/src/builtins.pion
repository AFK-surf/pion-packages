///| Standard library built-in helpers and formatters (`@text`, `@json`, `@html`,
///| `@uri`, `@csv`, `@tsv`, `@sh`, `@base64`, `@base64d`, regex with cache,
///| UTF-8 lossy decoding, KMP linear `indices`, and collection ops).

import "regex"
import "base64"

///| Proper RFC 3629 UTF-8 lossy decoder: replaces any invalid byte sequence,
///| overlong encoding, surrogate (U+D800..U+DFFF), or >U+10FFFF with U+FFFD (EF BF BD).
fn bytes_to_string_lossy(bs : Bytes) -> String {
  let sb = StringBuilder::new()
  let n = bs.length()
  let mut i = 0
  while i < n {
    let b0 = bs[i].to_int()
    if b0 < 0x80 {
      sb.write_byte(b0.to_byte())
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 < n {
        let b1 = bs[i + 1].to_int()
        if (b1 & 0xC0) == 0x80 {
          sb.write_byte(b0.to_byte())
          sb.write_byte(b1.to_byte())
          i = i + 2
          continue
        }
      }
      write_utf8_cp(sb, 0xFFFD)
      i = i + 1
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 < n {
        let b1 = bs[i + 1].to_int()
        let b2 = bs[i + 2].to_int()
        let ok_b1 = if b0 == 0xE0 {
          b1 >= 0xA0 && b1 <= 0xBF
        } else if b0 == 0xED {
          b1 >= 0x80 && b1 <= 0x9F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if ok_b1 && (b2 & 0xC0) == 0x80 {
          sb.write_byte(b0.to_byte())
          sb.write_byte(b1.to_byte())
          sb.write_byte(b2.to_byte())
          i = i + 3
          continue
        }
        // Maximal subpart: if b1 is valid continuation, consume 2 bytes
        if ok_b1 {
          write_utf8_cp(sb, 0xFFFD)
          i = i + 2
          continue
        }
      } else if i + 1 < n {
        let b1 = bs[i + 1].to_int()
        let ok_b1 = if b0 == 0xE0 {
          b1 >= 0xA0 && b1 <= 0xBF
        } else if b0 == 0xED {
          b1 >= 0x80 && b1 <= 0x9F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if ok_b1 {
          write_utf8_cp(sb, 0xFFFD)
          i = i + 2
          continue
        }
      }
      write_utf8_cp(sb, 0xFFFD)
      i = i + 1
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 < n {
        let b1 = bs[i + 1].to_int()
        let b2 = bs[i + 2].to_int()
        let b3 = bs[i + 3].to_int()
        let ok_b1 = if b0 == 0xF0 {
          b1 >= 0x90 && b1 <= 0xBF
        } else if b0 == 0xF4 {
          b1 >= 0x80 && b1 <= 0x8F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if ok_b1 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
          sb.write_byte(b0.to_byte())
          sb.write_byte(b1.to_byte())
          sb.write_byte(b2.to_byte())
          sb.write_byte(b3.to_byte())
          i = i + 4
          continue
        }
        if ok_b1 && (b2 & 0xC0) == 0x80 {
          write_utf8_cp(sb, 0xFFFD)
          i = i + 3
          continue
        }
        if ok_b1 {
          write_utf8_cp(sb, 0xFFFD)
          i = i + 2
          continue
        }
      }
      write_utf8_cp(sb, 0xFFFD)
      i = i + 1
    } else {
      write_utf8_cp(sb, 0xFFFD)
      i = i + 1
    }
  }
  sb.to_string()
}

fn format_html(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 38 {
      sb.write_string("&amp;")
    } else if b == 60 {
      sb.write_string("&lt;")
    } else if b == 62 {
      sb.write_string("&gt;")
    } else if b == 39 {
      sb.write_string("&apos;")
    } else if b == 34 {
      sb.write_string("&quot;")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn format_uri(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    let unreserved = (b >= 65 && b <= 90) ||
    (b >= 97 && b <= 122) ||
    (b >= 48 && b <= 57) ||
    b == 45 ||
    b == 95 ||
    b == 46 ||
    b == 126
    if unreserved {
      sb.write_byte(b.to_byte())
    } else {
      sb.write_byte(37.to_byte())
      let hi = (b >> 4) & 0xF
      let lo = b & 0xF
      sb.write_byte((if hi < 10 { 48 + hi } else { 55 + hi }).to_byte())
      sb.write_byte((if lo < 10 { 48 + lo } else { 55 + lo }).to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn format_sh_str(s : String) -> String {
  let sb = StringBuilder::new()
  sb.write_byte(39.to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 39 {
      sb.write_string("'\\''")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte(39.to_byte())
  sb.to_string()
}

fn format_sh_scalar(v : JqVal, max_bytes : Int) -> Result[String, JqError] {
  match v {
    JqVal::Null => Ok("null")
    JqVal::Bool(b) => Ok(if b { "true" } else { "false" })
    JqVal::Int(i) => Ok(i.to_string())
    JqVal::BigInt(s) => Ok(s)
    JqVal::Float(x) => Ok(format_jq_float(x))
    JqVal::Str(s) => {
      if s.length() > max_bytes {
        return Err(JqError::LimitExceeded("@sh exceeds max_output_bytes"))
      }
      Ok(format_sh_str(s))
    }
    other => Err(JqError::RuntimeError(jq_type_name(other) + " cannot be escaped for shell"))
  }
}

fn format_csv(v : JqVal, max_bytes : Int) -> Result[String, JqError] {
  let items = match v {
    JqVal::Array(xs) => xs
    _ => return Err(JqError::RuntimeError("@csv requires an array"))
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < items.length() {
    if i > 0 {
      sb.write_byte(44.to_byte())
    }
    match items[i] {
      JqVal::Null => ()
      JqVal::Bool(b) => sb.write_string(if b { "true" } else { "false" })
      JqVal::Int(n) => sb.write_string(n.to_string())
      JqVal::BigInt(s) => sb.write_string(s)
      JqVal::Float(x) =>
      if !is_nan_f64(x) {
        sb.write_string(format_jq_float(x))
      }
      JqVal::Str(s) => {
        sb.write_byte(34.to_byte())
        let mut j = 0
        while j < s.length() {
          let b = s.code_unit_at(j)
          if b == 34 {
            sb.write_string("\"\"")
          } else {
            sb.write_byte(b.to_byte())
          }
          j = j + 1
        }
        sb.write_byte(34.to_byte())
      }
      other =>
      return Err(
        JqError::RuntimeError(jq_type_name(other) + " is not valid in a csv row"),
      )
    }
    if sb.length() > max_bytes {
      return Err(JqError::LimitExceeded("@csv exceeds max_output_bytes"))
    }
    i = i + 1
  }
  Ok(sb.to_string())
}

fn format_tsv(v : JqVal, max_bytes : Int) -> Result[String, JqError] {
  let items = match v {
    JqVal::Array(xs) => xs
    _ => return Err(JqError::RuntimeError("@tsv requires an array"))
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < items.length() {
    if i > 0 {
      sb.write_byte(9.to_byte())
    }
    match items[i] {
      JqVal::Null => ()
      JqVal::Bool(b) => sb.write_string(if b { "true" } else { "false" })
      JqVal::Int(n) => sb.write_string(n.to_string())
      JqVal::BigInt(s) => sb.write_string(s)
      JqVal::Float(x) =>
      if !is_nan_f64(x) {
        sb.write_string(format_jq_float(x))
      }
      JqVal::Str(s) => {
        let mut j = 0
        while j < s.length() {
          let b = s.code_unit_at(j)
          if b == 9 {
            sb.write_string("\\t")
          } else if b == 10 {
            sb.write_string("\\n")
          } else if b == 13 {
            sb.write_string("\\r")
          } else if b == 92 {
            sb.write_string("\\\\")
          } else {
            sb.write_byte(b.to_byte())
          }
          j = j + 1
        }
      }
      other =>
      return Err(
        JqError::RuntimeError(jq_type_name(other) + " is not valid in a tsv row"),
      )
    }
    if sb.length() > max_bytes {
      return Err(JqError::LimitExceeded("@tsv exceeds max_output_bytes"))
    }
    i = i + 1
  }
  Ok(sb.to_string())
}

fn apply_format(fmt : String, v : JqVal, max_bytes : Int) -> Result[String, JqError] {
  if fmt == "text" || fmt == "" {
    jq_tostring_val(v, max_bytes)
  } else if fmt == "json" {
    serialize_jq_val(v, false, max_bytes)
  } else if fmt == "html" {
    match jq_tostring_val(v, max_bytes) {
      Ok(s) => Ok(format_html(s))
      Err(e) => Err(e)
    }
  } else if fmt == "uri" {
    match jq_tostring_val(v, max_bytes) {
      Ok(s) => Ok(format_uri(s))
      Err(e) => Err(e)
    }
  } else if fmt == "csv" {
    format_csv(v, max_bytes)
  } else if fmt == "tsv" {
    format_tsv(v, max_bytes)
  } else if fmt == "sh" {
    match v {
      JqVal::Array(items) => {
        let sb = StringBuilder::new()
        let mut i = 0
        while i < items.length() {
          if i > 0 {
            sb.write_byte(32.to_byte())
          }
          let s = match format_sh_scalar(items[i], max_bytes) {
            Ok(x) => x
            Err(e) => return Err(e)
          }
          sb.write_string(s)
          if sb.length() > max_bytes {
            return Err(JqError::LimitExceeded("@sh exceeds max_output_bytes"))
          }
          i = i + 1
        }
        Ok(sb.to_string())
      }
      _ => format_sh_scalar(v, max_bytes)
    }
  } else if fmt == "base64" {
    match jq_tostring_val(v, max_bytes) {
      Ok(s) => {
        let enc = base64::encode(s.to_bytes())
        if enc.length() > max_bytes {
          return Err(JqError::LimitExceeded("@base64 exceeds max_output_bytes"))
        }
        Ok(enc)
      }
      Err(e) => Err(e)
    }
  } else if fmt == "base64d" {
    match v {
      JqVal::Str(s) =>
      match base64::decode(s) {
        Ok(bs) => Ok(bytes_to_string_lossy(bs))
        Err(e) => Err(JqError::RuntimeError("invalid base64: " + base64::error_message(e)))
      }
      _ => Err(JqError::RuntimeError("@base64d requires a string"))
    }
  } else {
    Err(JqError::CompileError("unknown format @" + fmt))
  }
}

fn str_ascii_downcase(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn str_ascii_upcase(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 97 && b <= 122 {
      sb.write_byte((b - 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn str_starts_with(s : String, prefix : String) -> Bool {
  let n = s.length()
  let m = prefix.length()
  if m > n {
    return false
  }
  let mut i = 0
  while i < m {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn str_ends_with(s : String, suffix : String) -> Bool {
  let n = s.length()
  let m = suffix.length()
  if m > n {
    return false
  }
  let off = n - m
  let mut i = 0
  while i < m {
    if s.code_unit_at(off + i) != suffix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn str_contains_sub(hay : String, needle : String) -> Bool {
  let n = hay.length()
  let m = needle.length()
  if m == 0 {
    return true
  }
  if m > n {
    return false
  }
  let n0 = needle.code_unit_at(0)
  let mut i = 0
  while i + m <= n {
    if hay.code_unit_at(i) == n0 {
      let mut ok = true
      let mut k = 1
      while k < m {
        if hay.code_unit_at(i + k) != needle.code_unit_at(k) {
          ok = false
          break
        }
        k = k + 1
      }
      if ok {
        return true
      }
    }
    i = i + 1
  }
  false
}

fn jq_contains(a : JqVal, b : JqVal) -> Result[Bool, JqError] {
  match (a, b) {
    (JqVal::Str(sa), JqVal::Str(sb)) => Ok(str_contains_sub(sa, sb))
    (JqVal::Array(xa), JqVal::Array(xb)) => {
      let mut i = 0
      while i < xb.length() {
        let mut found = false
        let mut j = 0
        while j < xa.length() {
          match jq_contains(xa[j], xb[i]) {
            Ok(true) => {
              found = true
              break
            }
            _ => ()
          }
          j = j + 1
        }
        if !found {
          return Ok(false)
        }
        i = i + 1
      }
      Ok(true)
    }
    (JqVal::Object(oa), JqVal::Object(ob)) => {
      let eb = ob.entries
      let mut i = 0
      while i < eb.length() {
        let (kb, vb) = eb[i]
        match jq_obj_get(oa, kb) {
          None => return Ok(false)
          Some(va) =>
          match jq_contains(va, vb) {
            Ok(true) => ()
            Ok(false) => return Ok(false)
            Err(e) => return Err(e)
          }
        }
        i = i + 1
      }
      Ok(true)
    }
    _ => {
      if jq_type_name(a) != jq_type_name(b) {
        return Err(
          JqError::RuntimeError(
            jq_type_name(a) + " and " + jq_type_name(b) + " cannot have their containment checked",
          ),
        )
      }
      Ok(jq_eq(a, b))
    }
  }
}

///| O(n + m) KMP substring indices with incremental UTF-8 codepoint tracking.
fn str_indices_kmp(s : String, pat : String) -> Array[JqVal] {
  let out : Array[JqVal] = []
  let n = s.length()
  let m = pat.length()
  if m == 0 || m > n {
    return out
  }
  // Build KMP prefix function
  let pi = FixedArray::make(m, 0)
  let mut k = 0
  let mut q = 1
  while q < m {
    let pq = pat.code_unit_at(q)
    while k > 0 && pat.code_unit_at(k) != pq {
      k = pi[k - 1]
    }
    if pat.code_unit_at(k) == pq {
      k = k + 1
    }
    pi[q] = k
    q = q + 1
  }
  // Precompute codepoint length of pattern (for O(1) start cp calculation)
  let pat_cps = utf8_char_len(pat)
  let mut cp_pos = 0
  let mut matched = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    while matched > 0 && pat.code_unit_at(matched) != b {
      matched = pi[matched - 1]
    }
    if pat.code_unit_at(matched) == b {
      matched = matched + 1
    }
    if (b & 0xC0) != 0x80 {
      cp_pos = cp_pos + 1
    }
    if matched == m {
      // Match ends at byte `i` (inclusive), which is at codepoint `cp_pos - 1`
      // Start codepoint is `cp_pos - pat_cps`
      out.push(JqVal::Int((cp_pos - pat_cps).to_int64()))
      matched = pi[matched - 1]
    }
    i = i + 1
  }
  out
}

fn jq_indices(target : JqVal, needle : JqVal) -> Result[Array[JqVal], JqError] {
  let out : Array[JqVal] = []
  match target {
    JqVal::Str(s) => {
      let pat = match needle {
        JqVal::Str(p) => p
        _ => return Err(JqError::RuntimeError("indices on string requires string argument"))
      }
      Ok(str_indices_kmp(s, pat))
    }
    JqVal::Array(items) => {
      match needle {
        JqVal::Array(sub) => {
          let n = items.length()
          let m = sub.length()
          if m == 0 || m > n {
            return Ok(out)
          }
          let mut i = 0
          while i + m <= n {
            let mut ok = true
            let mut k = 0
            while k < m {
              if !jq_eq(items[i + k], sub[k]) {
                ok = false
                break
              }
              k = k + 1
            }
            if ok {
              out.push(JqVal::Int(i.to_int64()))
            }
            i = i + 1
          }
          Ok(out)
        }
        _ => {
          let mut i = 0
          while i < items.length() {
            if jq_eq(items[i], needle) {
              out.push(JqVal::Int(i.to_int64()))
            }
            i = i + 1
          }
          Ok(out)
        }
      }
    }
    _ => Err(JqError::RuntimeError("cannot find indices in " + jq_type_name(target)))
  }
}

// ---------------------------------------------------------------------------
// Regex compilation with P0-1 fix (`multi_line = false` by default) + cache
// ---------------------------------------------------------------------------

struct RegexCache {
  entries : Map[String, (regex::Regex, Bool, Bool)]
  mut count : Int
}

let jq_regex_cache : RegexCache = RegexCache::{ entries: Map::new(), count: 0 }

fn compile_jq_regex(
  pattern : String,
  flags : String,
) -> Result[(regex::Regex, Bool, Bool), JqError] {
  let cache_key = pattern + "\u{0000}" + flags
  match jq_regex_cache.entries.get(cache_key) {
    Some(hit) => return Ok(hit)
    None => ()
  }
  let mut ci = false
  let mut dot_nl = false
  let multi_line = false
  let mut ignore_ws = false
  let mut is_global = false
  let mut ignore_empty = false
  let mut i = 0
  while i < flags.length() {
    let b = flags.code_unit_at(i)
    if b == 105 {
      // 'i'
      ci = true
    } else if b == 103 {
      // 'g'
      is_global = true
    } else if b == 109 || b == 112 {
      // 'm' or 'p': Oniguruma multiline ('.' matches '\n'; '^'/'$' remain string-anchored)
      dot_nl = true
    } else if b == 115 {
      // 's': single-line
      dot_nl = false
    } else if b == 120 {
      // 'x'
      ignore_ws = true
    } else if b == 110 {
      // 'n'
      ignore_empty = true
    } else if b == 108 {
      // 'l'
      ()
    } else {
      return Err(JqError::RuntimeError("unsupported regex flag"))
    }
    i = i + 1
  }
  let opts = regex::RegexOptions::{
    case_insensitive: ci,
    multi_line: multi_line,
    dot_matches_new_line: dot_nl,
    swap_greed: false,
    ignore_whitespace: ignore_ws,
    unicode: true,
    nest_limit: 250,
    size_limit: 1000000,
  }
  match regex::compile_with(pattern, opts) {
    Ok(re) => {
      let entry = (re, is_global, ignore_empty)
      if jq_regex_cache.count < 256 {
        jq_regex_cache.entries.set(cache_key, entry)
        jq_regex_cache.count = jq_regex_cache.count + 1
      }
      Ok(entry)
    }
    Err(e) => Err(JqError::RuntimeError("invalid regex: " + e.message))
  }
}

fn captures_to_match_obj(
  text : String,
  re : regex::Regex,
  caps : regex::Captures,
) -> JqVal {
  let full = match caps.get(0) {
    Some(m) => m
    None => return JqVal::Null
  }
  let cp_off = utf8_byte_to_cp(text, full.start)
  let cp_len = utf8_char_len(full.text)
  let names = re.capture_names()
  let cap_arr : Array[JqVal] = []
  let mut i = 1
  while i < caps.len() {
    let cname = if i < names.length() {
      match names[i] {
        Some(nm) => JqVal::Str(nm)
        None => JqVal::Null
      }
    } else {
      JqVal::Null
    }
    match caps.get(i) {
      Some(cm) => {
        let coff = utf8_byte_to_cp(text, cm.start)
        let clen = utf8_char_len(cm.text)
        cap_arr.push(
          JqVal::Object(
            jq_obj_from_entries([
              ("offset", JqVal::Int(coff.to_int64())),
              ("length", JqVal::Int(clen.to_int64())),
              ("string", JqVal::Str(cm.text)),
              ("name", cname),
            ]),
          ),
        )
      }
      None =>
      cap_arr.push(
        JqVal::Object(
          jq_obj_from_entries([
            ("offset", JqVal::Int(-1L)),
            ("length", JqVal::Int(0L)),
            ("string", JqVal::Null),
            ("name", cname),
          ]),
        ),
      )
    }
    i = i + 1
  }
  JqVal::Object(
    jq_obj_from_entries([
      ("offset", JqVal::Int(cp_off.to_int64())),
      ("length", JqVal::Int(cp_len.to_int64())),
      ("string", JqVal::Str(full.text)),
      ("captures", JqVal::Array(cap_arr)),
    ]),
  )
}

fn captures_to_named_obj(re : regex::Regex, caps : regex::Captures) -> JqVal {
  let names = re.capture_names()
  let entries : Array[(String, JqVal)] = []
  let mut i = 1
  while i < names.length() {
    match names[i] {
      Some(nm) =>
      match caps.get(i) {
        Some(cm) => entries.push((nm, JqVal::Str(cm.text)))
        None => entries.push((nm, JqVal::Null))
      }
      None => ()
    }
    i = i + 1
  }
  JqVal::Object(jq_obj_from_entries(entries))
}
