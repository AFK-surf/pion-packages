///| Public entry points for `packages/jq`.

import "json5"

///| Compile a jq query string with default limits.
pub fn compile(src : String) -> Result[Query, JqError] {
  compile_with_limits(src, JqLimits::default())
}

///| Compile a jq query string with explicit limits.
pub fn compile_with_limits(
  src : String,
  limits : JqLimits,
) -> Result[Query, JqError] {
  match validate_limits(limits) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  parse_query(src, limits)
}

///| Execute a compiled query against a JSON value with default limits.
pub fn run(
  query : Query,
  input : json5::Json5Value,
) -> Result[Array[json5::Json5Value], JqError] {
  run_with_limits(query, input, JqLimits::default())
}

///| Execute a compiled query against a JSON value with explicit limits.
pub fn run_with_limits(
  query : Query,
  input : json5::Json5Value,
  limits : JqLimits,
) -> Result[Array[json5::Json5Value], JqError] {
  run_with_vars(query, input, [], limits)
}

///| Execute a compiled query with externally bound `$var` variables and explicit limits.
pub fn run_with_vars(
  query : Query,
  input : json5::Json5Value,
  vars : Array[(String, json5::Json5Value)],
  limits : JqLimits,
) -> Result[Array[json5::Json5Value], JqError] {
  match validate_limits(limits) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let jq_input = from_json5(input)
  let ctx = EvalCtx::new(query.exprs, limits)
  let mut venv = ctx.push_var(-1, "ENV", JqVal::Object(jq_obj_from_entries([])))
  let mut i = 0
  while i < vars.length() {
    let (k, v) = vars[i]
    venv = ctx.push_var(venv, k, from_json5(v))
    i = i + 1
  }
  let sink = Sink::{ out: [], is_top_level: true, cap_remaining: -1, skip_remaining: 0 }
  match ctx.eval(query.root, jq_input, venv, -1, sink) {
    Ok(_) | Err(EvalSignal::CapReached) => {
      let res : Array[json5::Json5Value] = []
      let mut j = 0
      while j < sink.out.length() {
        match to_json5_bounded(sink.out[j], limits.max_output_bytes) {
          Ok(v) => res.push(v)
          Err(e) => return Err(e)
        }
        j = j + 1
      }
      Ok(res)
    }
    Err(EvalSignal::Error(e)) => Err(e)
    Err(EvalSignal::Break(lbl)) =>
    Err(JqError::RuntimeError("break $" + lbl + " outside matching label"))
  }
}

///| Compile and execute a jq query string against a JSON value.
pub fn eval(
  src : String,
  input : json5::Json5Value,
) -> Result[Array[json5::Json5Value], JqError] {
  match compile(src) {
    Ok(q) => run(q, input)
    Err(e) => Err(e)
  }
}

///| Parse a strict RFC 8259 JSON string into a `json5::Json5Value` (iterative, lossless >2^53 ints).
pub fn parse_json(src : String) -> Result[json5::Json5Value, JqError] {
  parse_json_to_json5(src, 10000)
}

///| Serialize a `json5::Json5Value` to compact standard JSON (jq semantics, bounded by default max_output_bytes).
pub fn to_json(value : json5::Json5Value) -> Result[String, JqError] {
  serialize_jq_val(from_json5(value), false, JqLimits::default().max_output_bytes)
}

///| Serialize a `json5::Json5Value` to compact JSON with object keys sorted lexicographically.
pub fn to_json_sorted(value : json5::Json5Value) -> Result[String, JqError] {
  serialize_jq_val(from_json5(value), true, JqLimits::default().max_output_bytes)
}

///| Compile and run a jq query against a JSON string, returning compact JSON strings.
pub fn eval_json(src : String, json_input : String) -> Result[Array[String], JqError] {
  eval_json_with_limits(src, json_input, JqLimits::default())
}

///| Compile and run a jq query against a JSON string with explicit limits.
pub fn eval_json_with_limits(
  src : String,
  json_input : String,
  limits : JqLimits,
) -> Result[Array[String], JqError] {
  let q = match compile_with_limits(src, limits) {
    Ok(q) => q
    Err(e) => return Err(e)
  }
  let json_depth = if limits.max_depth > 10000 { limits.max_depth } else { 10000 }
  let input = match parse_json_to_jqval(json_input, json_depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let ctx = EvalCtx::new(q.exprs, limits)
  let venv = ctx.push_var(-1, "ENV", JqVal::Object(jq_obj_from_entries([])))
  let sink = Sink::{ out: [], is_top_level: true, cap_remaining: -1, skip_remaining: 0 }
  match ctx.eval(q.root, input, venv, -1, sink) {
    Ok(_) | Err(EvalSignal::CapReached) => ()
    Err(EvalSignal::Error(e)) => return Err(e)
    Err(EvalSignal::Break(lbl)) =>
    return Err(JqError::RuntimeError("break $" + lbl + " outside matching label"))
  }
  let out : Array[String] = []
  let mut total_bytes = 0
  let mut i = 0
  while i < sink.out.length() {
    match serialize_jq_val(sink.out[i], false, limits.max_output_bytes - total_bytes) {
      Ok(s) => {
        total_bytes = total_bytes + s.length()
        if total_bytes > limits.max_output_bytes {
          return Err(JqError::LimitExceeded("total serialized output exceeds max_output_bytes"))
        }
        out.push(s)
      }
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  Ok(out)
}
