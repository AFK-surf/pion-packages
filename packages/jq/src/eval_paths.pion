///| Path-mode evaluator (P1-1 user defs, P1-2 slices, P1-3 first/last/limit/nth/
///| getpath/alt/reduce/foreach/try/as/recurse/label) and O(n) structural update
///| operators (`|=`, `=`, `+=`, `del`) eliminating P0-7 quadratic cliffs.

fn clone_path_with(base : Array[JqVal], seg : JqVal) -> Array[JqVal] {
  let out : Array[JqVal] = []
  let mut i = 0
  while i < base.length() {
    out.push(base[i])
    i = i + 1
  }
  out.push(seg)
  out
}

fn concat_paths(a : Array[JqVal], b : Array[JqVal]) -> Array[JqVal] {
  let out : Array[JqVal] = []
  let mut i = 0
  while i < a.length() {
    out.push(a[i])
    i = i + 1
  }
  i = 0
  while i < b.length() {
    out.push(b[i])
    i = i + 1
  }
  out
}

fn EvalCtx::eval_paths(
  self : EvalCtx,
  expr_id : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  prefix : Array[JqVal],
  out : Array[(Array[JqVal], JqVal)],
) -> Result[Unit, EvalSignal] {
  match self.step() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  match self.enter() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let res = self.eval_paths_inner(expr_id, input, venv, fenv, prefix, out)
  self.leave()
  res
}

fn EvalCtx::eval_paths_recurse(
  self : EvalCtx,
  root : JqVal,
  root_prefix : Array[JqVal],
  out : Array[(Array[JqVal], JqVal)],
) -> Result[Unit, EvalSignal] {
  let stack : Array[(Array[JqVal], JqVal)] = [(root_prefix, root)]
  while stack.length() > 0 {
    let (p, v) = match stack.pop() {
      Some(x) => x
      None => break
    }
    match self.step() {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    out.push((p, v))
    match v {
      JqVal::Array(items) => {
        let mut i = items.length() - 1
        while i >= 0 {
          stack.push((clone_path_with(p, JqVal::Int(i.to_int64())), items[i]))
          i = i - 1
        }
      }
      JqVal::Object(obj) => {
        let es = obj.entries
        let mut i = es.length() - 1
        while i >= 0 {
          let (k, ev) = es[i]
          stack.push((clone_path_with(p, JqVal::Str(k)), ev))
          i = i - 1
        }
      }
      _ => ()
    }
  }
  Ok(())
}

fn EvalCtx::eval_paths_inner(
  self : EvalCtx,
  expr_id : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  prefix : Array[JqVal],
  out : Array[(Array[JqVal], JqVal)],
) -> Result[Unit, EvalSignal] {
  match self.exprs[expr_id] {
    Expr::Identity => {
      out.push((prefix, input))
      Ok(())
    }
    Expr::Recurse => self.eval_paths_recurse(input, prefix, out)
    Expr::Field(target, key, opt) => {
      let parents : Array[(Array[JqVal], JqVal)] = []
      match self.eval_paths(target, input, venv, fenv, prefix, parents) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let mut i = 0
      while i < parents.length() {
        let (pp, pv) = parents[i]
        match jq_index_val(pv, JqVal::Str(key)) {
          Ok(cv) => out.push((clone_path_with(pp, JqVal::Str(key)), cv))
          Err(e) => if !opt { return Err(EvalSignal::Error(e)) }
        }
        i = i + 1
      }
      Ok(())
    }
    Expr::FieldChain(target, fields) => {
      let parents : Array[(Array[JqVal], JqVal)] = []
      match self.eval_paths(target, input, venv, fenv, prefix, parents) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let mut i = 0
      while i < parents.length() {
        let (pp, pv) = parents[i]
        let mut cur_p = pp
        let mut cur_v = pv
        let mut skipped = false
        let mut fi = 0
        while fi < fields.length() {
          let (fk, fopt) = fields[fi]
          match jq_index_val(cur_v, JqVal::Str(fk)) {
            Ok(cv) => {
              cur_p = clone_path_with(cur_p, JqVal::Str(fk))
              cur_v = cv
            }
            Err(e) =>
            if fopt {
              skipped = true
              break
            } else {
              return Err(EvalSignal::Error(e))
            }
          }
          fi = fi + 1
        }
        if !skipped {
          out.push((cur_p, cur_v))
        }
        i = i + 1
      }
      Ok(())
    }
    Expr::Index(target, idx_e, opt) => {
      let parents : Array[(Array[JqVal], JqVal)] = []
      match self.eval_paths(target, input, venv, fenv, prefix, parents) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let idxs = match self.eval_collect(idx_e, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut j = 0
      while j < idxs.length() {
        let mut i = 0
        while i < parents.length() {
          let (pp, pv) = parents[i]
          match jq_index_val(pv, idxs[j]) {
            Ok(cv) => out.push((clone_path_with(pp, idxs[j]), cv))
            Err(e) => if !opt { return Err(EvalSignal::Error(e)) }
          }
          i = i + 1
        }
        j = j + 1
      }
      Ok(())
    }
    Expr::Slice(target, s_e, e_e, opt) => {
      let parents : Array[(Array[JqVal], JqVal)] = []
      match self.eval_paths(target, input, venv, fenv, prefix, parents) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let starts : Array[Option[JqVal]] = if s_e < 0 {
        [None]
      } else {
        let xs = match self.eval_collect(s_e, input, venv, fenv) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        let arr : Array[Option[JqVal]] = []
        let mut k = 0
        while k < xs.length() {
          arr.push(Some(xs[k]))
          k = k + 1
        }
        arr
      }
      let ends : Array[Option[JqVal]] = if e_e < 0 {
        [None]
      } else {
        let xs = match self.eval_collect(e_e, input, venv, fenv) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        let arr : Array[Option[JqVal]] = []
        let mut k = 0
        while k < xs.length() {
          arr.push(Some(xs[k]))
          k = k + 1
        }
        arr
      }
      let mut pi = 0
      while pi < parents.length() {
        let (pp, pv) = parents[pi]
        let mut si = 0
        while si < starts.length() {
          let mut ei = 0
          while ei < ends.length() {
            match jq_slice_val(pv, starts[si], ends[ei]) {
              Ok(cv) => {
                let s_val = match starts[si] { Some(v) => v None => JqVal::Null }
                let e_val = match ends[ei] { Some(v) => v None => JqVal::Null }
                let seg = JqVal::Object(jq_obj_from_entries([("start", s_val), ("end", e_val)]))
                out.push((clone_path_with(pp, seg), cv))
              }
              Err(e) => if !opt { return Err(EvalSignal::Error(e)) }
            }
            ei = ei + 1
          }
          si = si + 1
        }
        pi = pi + 1
      }
      Ok(())
    }
    Expr::Iter(target, opt) => {
      let parents : Array[(Array[JqVal], JqVal)] = []
      match self.eval_paths(target, input, venv, fenv, prefix, parents) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let mut i = 0
      while i < parents.length() {
        let (pp, pv) = parents[i]
        match pv {
          JqVal::Array(items) => {
            let mut k = 0
            while k < items.length() {
              out.push((clone_path_with(pp, JqVal::Int(k.to_int64())), items[k]))
              k = k + 1
            }
          }
          JqVal::Object(obj) => {
            let es = obj.entries
            let mut k = 0
            while k < es.length() {
              let (key, ev) = es[k]
              out.push((clone_path_with(pp, JqVal::Str(key)), ev))
              k = k + 1
            }
          }
          other =>
          if !opt {
            return Err(
              EvalSignal::Error(
                JqError::RuntimeError("cannot iterate over " + jq_type_name(other)),
              ),
            )
          }
        }
        i = i + 1
      }
      Ok(())
    }
    Expr::Optional(inner) =>
    match self.eval_paths(inner, input, venv, fenv, prefix, out) {
      Ok(_) => Ok(())
      Err(EvalSignal::Error(JqError::LimitExceeded(m))) =>
      Err(EvalSignal::Error(JqError::LimitExceeded(m)))
      Err(EvalSignal::Error(JqError::InvalidLimits(m))) =>
      Err(EvalSignal::Error(JqError::InvalidLimits(m)))
      Err(EvalSignal::Break(b)) => Err(EvalSignal::Break(b))
      Err(EvalSignal::CapReached) => Err(EvalSignal::CapReached)
      Err(EvalSignal::Error(_)) => Ok(())
    }
    Expr::Try(body, catch_e) =>
    match self.eval_paths(body, input, venv, fenv, prefix, out) {
      Ok(_) => Ok(())
      Err(EvalSignal::Error(JqError::LimitExceeded(m))) =>
      Err(EvalSignal::Error(JqError::LimitExceeded(m)))
      Err(EvalSignal::Error(JqError::InvalidLimits(m))) =>
      Err(EvalSignal::Error(JqError::InvalidLimits(m)))
      Err(EvalSignal::Break(b)) => Err(EvalSignal::Break(b))
      Err(EvalSignal::CapReached) => Err(EvalSignal::CapReached)
      Err(EvalSignal::Error(_)) =>
      if catch_e >= 0 {
        self.eval_paths(catch_e, input, venv, fenv, prefix, out)
      } else {
        Ok(())
      }
    }
    Expr::Bin(BinOp::Comma, lhs, rhs) => {
      match self.eval_paths(lhs, input, venv, fenv, prefix, out) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      self.eval_paths(rhs, input, venv, fenv, prefix, out)
    }
    Expr::CommaChain(items) => {
      let mut i = 0
      while i < items.length() {
        match self.eval_paths(items[i], input, venv, fenv, prefix, out) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        i = i + 1
      }
      Ok(())
    }
    Expr::Bin(BinOp::Pipe, lhs, rhs) => {
      let mid : Array[(Array[JqVal], JqVal)] = []
      match self.eval_paths(lhs, input, venv, fenv, prefix, mid) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let mut i = 0
      while i < mid.length() {
        let (mp, mv) = mid[i]
        match self.eval_paths(rhs, mv, venv, fenv, mp, out) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        i = i + 1
      }
      Ok(())
    }
    Expr::PipeChain(stages) => {
      let mut cur : Array[(Array[JqVal], JqVal)] = [(prefix, input)]
      let mut si = 0
      while si < stages.length() {
        let next : Array[(Array[JqVal], JqVal)] = []
        let mut i = 0
        while i < cur.length() {
          let (mp, mv) = cur[i]
          match self.eval_paths(stages[si], mv, venv, fenv, mp, next) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          i = i + 1
        }
        cur = next
        si = si + 1
      }
      let mut i = 0
      while i < cur.length() {
        out.push(cur[i])
        i = i + 1
      }
      Ok(())
    }
    Expr::Bin(BinOp::Alt, lhs, rhs) => {
      let lp : Array[(Array[JqVal], JqVal)] = []
      match self.eval_paths(lhs, input, venv, fenv, prefix, lp) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let mut emitted = false
      let mut i = 0
      while i < lp.length() {
        let (_, lv) = lp[i]
        if jq_truthy(lv) {
          emitted = true
          out.push(lp[i])
        }
        i = i + 1
      }
      if !emitted {
        self.eval_paths(rhs, input, venv, fenv, prefix, out)
      } else {
        Ok(())
      }
    }
    Expr::As(val_e, pat, body_e) => {
      let vs = match self.eval_collect(val_e, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut i = 0
      while i < vs.length() {
        let new_envs = match self.bind_pattern_all(pat, vs[i], input, venv, fenv) {
          Ok(ne) => ne
          Err(e) => return Err(e)
        }
        let mut ei = 0
        while ei < new_envs.length() {
          match self.eval_paths(body_e, input, new_envs[ei], fenv, prefix, out) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          ei = ei + 1
        }
        i = i + 1
      }
      Ok(())
    }
    Expr::Def(name, params, body, next) => {
      let new_fenv = self.push_func(fenv, name, params, body, venv)
      self.eval_paths(next, input, venv, new_fenv, prefix, out)
    }
    Expr::Label(name, body) =>
    match self.eval_paths(body, input, venv, fenv, prefix, out) {
      Ok(_) => Ok(())
      Err(EvalSignal::Break(bname)) =>
      if bname == name {
        Ok(())
      } else {
        Err(EvalSignal::Break(bname))
      }
      Err(e) => Err(e)
    }
    Expr::Break(name) => Err(EvalSignal::Break(name))
    Expr::Reduce(src_e, pat, init_e, upd_e) => {
      let init_ps : Array[(Array[JqVal], JqVal)] = []
      match self.eval_paths(init_e, input, venv, fenv, prefix, init_ps) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let items = match self.eval_collect(src_e, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut ii = 0
      while ii < init_ps.length() {
        let (ip, iv) = init_ps[ii]
        let mut acc_p = ip
        let mut acc_v = iv
        let mut j = 0
        while j < items.length() {
          let new_envs = match self.bind_pattern_all(pat, items[j], input, venv, fenv) {
            Ok(ne) => ne
            Err(e) => return Err(e)
          }
          let mut ei = 0
          while ei < new_envs.length() {
            let next_ps : Array[(Array[JqVal], JqVal)] = []
            match self.eval_paths(upd_e, acc_v, new_envs[ei], fenv, prefix, next_ps) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            if next_ps.length() > 0 {
              let (np, nv) = next_ps[next_ps.length() - 1]
              acc_p = np
              acc_v = nv
            }
            ei = ei + 1
          }
          j = j + 1
        }
        out.push((acc_p, acc_v))
        ii = ii + 1
      }
      Ok(())
    }
    Expr::Foreach(src_e, pat, init_e, upd_e, ext_e) => {
      let init_ps : Array[(Array[JqVal], JqVal)] = []
      match self.eval_paths(init_e, input, venv, fenv, prefix, init_ps) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let items = match self.eval_collect(src_e, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut ii = 0
      while ii < init_ps.length() {
        let (ip, iv) = init_ps[ii]
        let mut acc_p = ip
        let mut acc_v = iv
        let mut j = 0
        while j < items.length() {
          let new_envs = match self.bind_pattern_all(pat, items[j], input, venv, fenv) {
            Ok(ne) => ne
            Err(e) => return Err(e)
          }
          let mut ei = 0
          while ei < new_envs.length() {
            let next_ps : Array[(Array[JqVal], JqVal)] = []
            match self.eval_paths(upd_e, acc_v, new_envs[ei], fenv, prefix, next_ps) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            let mut k = 0
            while k < next_ps.length() {
              let (np, nv) = next_ps[k]
              acc_p = np
              acc_v = nv
              if ext_e >= 0 {
                match self.eval_paths(ext_e, acc_v, new_envs[ei], fenv, acc_p, out) {
                  Err(e) => return Err(e)
                  Ok(_) => ()
                }
              } else {
                out.push((acc_p, acc_v))
              }
              k = k + 1
            }
            ei = ei + 1
          }
          j = j + 1
        }
        ii = ii + 1
      }
      Ok(())
    }
    Expr::Call(name, args) => {
      // P1-1: Resolve user-defined functions in path mode first!
      match self.lookup_func(fenv, name, args.length()) {
        Some(def_id) => {
          let fdef = self.func_defs[def_id]
          let mut call_fenv = fdef.func_env
          let mut i = 0
          while i < fdef.params.length() {
            let arg_def_id = self.func_defs.length()
            let arg_node_id = self.func_nodes.length()
            self.func_defs.push(
              FuncDef::{
                name: fdef.params[i],
                params: [],
                body: args[i],
                var_env: venv,
                func_env: fenv,
              },
            )
            self.func_nodes.push(
              FuncNode::{
                name: fdef.params[i],
                arity: 0,
                def_id: arg_def_id,
                prev: call_fenv,
              },
            )
            call_fenv = arg_node_id
            i = i + 1
          }
          return self.eval_paths(fdef.body, input, fdef.var_env, call_fenv, prefix, out)
        }
        None => ()
      }
      let arity = args.length()
      if name == "select" && arity == 1 {
        let cs = match self.eval_collect(args[0], input, venv, fenv) {
          Ok(xs) => xs
          Err(e) => return Err(e)
        }
        let mut i = 0
        while i < cs.length() {
          if jq_truthy(cs[i]) {
            out.push((prefix, input))
          }
          i = i + 1
        }
        Ok(())
      } else if name == "empty" && arity == 0 {
        Ok(())
      } else if name == "values" && arity == 0 {
        match input {
          JqVal::Null => Ok(())
          _ => {
            out.push((prefix, input))
            Ok(())
          }
        }
      } else if name == "numbers" && arity == 0 {
        match input {
          JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => {
            out.push((prefix, input))
            Ok(())
          }
          _ => Ok(())
        }
      } else if name == "strings" && arity == 0 {
        match input {
          JqVal::Str(_) => {
            out.push((prefix, input))
            Ok(())
          }
          _ => Ok(())
        }
      } else if name == "arrays" && arity == 0 {
        match input {
          JqVal::Array(_) => {
            out.push((prefix, input))
            Ok(())
          }
          _ => Ok(())
        }
      } else if name == "objects" && arity == 0 {
        match input {
          JqVal::Object(_) => {
            out.push((prefix, input))
            Ok(())
          }
          _ => Ok(())
        }
      } else if name == "booleans" && arity == 0 {
        match input {
          JqVal::Bool(_) => {
            out.push((prefix, input))
            Ok(())
          }
          _ => Ok(())
        }
      } else if name == "nulls" && arity == 0 {
        match input {
          JqVal::Null => {
            out.push((prefix, input))
            Ok(())
          }
          _ => Ok(())
        }
      } else if name == "iterables" && arity == 0 {
        match input {
          JqVal::Array(_) | JqVal::Object(_) => {
            out.push((prefix, input))
            Ok(())
          }
          _ => Ok(())
        }
      } else if name == "scalars" && arity == 0 {
        match input {
          JqVal::Array(_) | JqVal::Object(_) => Ok(())
          _ => {
            out.push((prefix, input))
            Ok(())
          }
        }
      } else if name == "first" && arity == 1 {
        let sub : Array[(Array[JqVal], JqVal)] = []
        match self.eval_paths(args[0], input, venv, fenv, prefix, sub) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        if sub.length() > 0 {
          out.push(sub[0])
        }
        Ok(())
      } else if name == "last" && arity == 1 {
        let sub : Array[(Array[JqVal], JqVal)] = []
        match self.eval_paths(args[0], input, venv, fenv, prefix, sub) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        if sub.length() > 0 {
          out.push(sub[sub.length() - 1])
        }
        Ok(())
      } else if name == "limit" && arity == 2 {
        let ns = match self.eval_collect(args[0], input, venv, fenv) {
          Ok(xs) => xs
          Err(e) => return Err(e)
        }
        let mut i = 0
        while i < ns.length() {
          let n = match jq_val_to_int_index(ns[i]) {
            Some(k) => k
            None => 0
          }
          if n > 0 {
            let sub : Array[(Array[JqVal], JqVal)] = []
            match self.eval_paths(args[1], input, venv, fenv, prefix, sub) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            let take = if n < sub.length() { n } else { sub.length() }
            let mut j = 0
            while j < take {
              out.push(sub[j])
              j = j + 1
            }
          }
          i = i + 1
        }
        Ok(())
      } else if name == "nth" && arity == 2 {
        let ns = match self.eval_collect(args[0], input, venv, fenv) {
          Ok(xs) => xs
          Err(e) => return Err(e)
        }
        let mut i = 0
        while i < ns.length() {
          let n = match jq_val_to_int_index(ns[i]) {
            Some(k) => k
            None => return Err(EvalSignal::Error(JqError::RuntimeError("invalid nth index")))
          }
          if n >= 0 {
            let sub : Array[(Array[JqVal], JqVal)] = []
            match self.eval_paths(args[1], input, venv, fenv, prefix, sub) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            if n < sub.length() {
              out.push(sub[n])
            }
          }
          i = i + 1
        }
        Ok(())
      } else if name == "getpath" && arity == 1 {
        let ps = match self.eval_collect(args[0], input, venv, fenv) {
          Ok(xs) => xs
          Err(e) => return Err(e)
        }
        let mut i = 0
        while i < ps.length() {
          match ps[i] {
            JqVal::Array(p) =>
            match jq_getpath(input, p) {
              Ok(v) => out.push((concat_paths(prefix, p), v))
              Err(e) => return Err(EvalSignal::Error(e))
            }
            _ => return Err(EvalSignal::Error(JqError::RuntimeError("getpath requires array path")))
          }
          i = i + 1
        }
        Ok(())
      } else if name == "recurse" && arity == 0 {
        self.eval_paths_recurse(input, prefix, out)
      } else if name == "recurse" && arity == 1 {
        let stack : Array[(Array[JqVal], JqVal)] = [(prefix, input)]
        while stack.length() > 0 {
          let (p, v) = match stack.pop() {
            Some(x) => x
            None => break
          }
          match self.step() {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          out.push((p, v))
          let next_ps : Array[(Array[JqVal], JqVal)] = []
          match self.eval_paths(args[0], v, venv, fenv, p, next_ps) {
            Ok(_) => {
              let mut k = next_ps.length() - 1
              while k >= 0 {
                stack.push(next_ps[k])
                k = k - 1
              }
            }
            Err(EvalSignal::Error(JqError::LimitExceeded(m))) =>
            return Err(EvalSignal::Error(JqError::LimitExceeded(m)))
            Err(_) => ()
          }
        }
        Ok(())
      } else {
        Err(EvalSignal::Error(JqError::RuntimeError("invalid path expression: " + name)))
      }
    }
    Expr::If(cond, then_e, elifs, else_e) => {
      let cs = match self.eval_collect(cond, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut i = 0
      while i < cs.length() {
        if jq_truthy(cs[i]) {
          match self.eval_paths(then_e, input, venv, fenv, prefix, out) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
        } else if elifs.length() > 0 {
          let mut matched = false
          let mut ei = 0
          while ei < elifs.length() {
            let ecs = match self.eval_collect(elifs[ei].cond, input, venv, fenv) {
              Ok(xs) => xs
              Err(e) => return Err(e)
            }
            if ecs.length() > 0 && jq_truthy(ecs[0]) {
              match self.eval_paths(elifs[ei].body, input, venv, fenv, prefix, out) {
                Err(e) => return Err(e)
                Ok(_) => ()
              }
              matched = true
              break
            }
            ei = ei + 1
          }
          if !matched {
            if else_e >= 0 {
              match self.eval_paths(else_e, input, venv, fenv, prefix, out) {
                Err(e) => return Err(e)
                Ok(_) => ()
              }
            } else {
              out.push((prefix, input))
            }
          }
        } else if else_e >= 0 {
          match self.eval_paths(else_e, input, venv, fenv, prefix, out) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
        } else {
          out.push((prefix, input))
        }
        i = i + 1
      }
      Ok(())
    }
    _ => Err(EvalSignal::Error(JqError::RuntimeError("invalid path expression")))
  }
}

// ---------------------------------------------------------------------------
// O(n) Structural Update & Assignment Operators (P0-7 fix)
// ---------------------------------------------------------------------------

///| Fast single-pass structural update for `.[] |= f`, `(.[] | select(p)) |= f`,
///| and `(.. | pred) |= f` — avoids collecting paths or quadratic container copying!
fn EvalCtx::try_fast_update_iter(
  self : EvalCtx,
  input : JqVal,
  select_pred : Int,
  rhs : Int,
  venv : Int,
  fenv : Int,
  opt : Bool,
) -> Result[JqVal, EvalSignal] {
  match input {
    JqVal::Array(items) => {
      let out : Array[JqVal] = []
      let mut i = 0
      while i < items.length() {
        match self.step() {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        let elem = items[i]
        let mut do_upd = true
        if select_pred >= 0 {
          let cs = match self.eval_collect(select_pred, elem, venv, fenv) {
            Ok(xs) => xs
            Err(e) => return Err(e)
          }
          do_upd = cs.length() > 0 && jq_truthy(cs[0])
        }
        if do_upd {
          let nvs = match self.eval_collect_cap(rhs, elem, venv, fenv, 1) {
            Ok(xs) => xs
            Err(e) => return Err(e)
          }
          if nvs.length() > 0 {
            out.push(nvs[0])
          }
        } else {
          out.push(elem)
        }
        i = i + 1
      }
      Ok(JqVal::Array(out))
    }
    JqVal::Object(obj) => {
      let es = obj.entries
      let out : Array[(String, JqVal)] = []
      let mut i = 0
      while i < es.length() {
        match self.step() {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        let (k, elem) = es[i]
        let mut do_upd = true
        if select_pred >= 0 {
          let cs = match self.eval_collect(select_pred, elem, venv, fenv) {
            Ok(xs) => xs
            Err(e) => return Err(e)
          }
          do_upd = cs.length() > 0 && jq_truthy(cs[0])
        }
        if do_upd {
          let nvs = match self.eval_collect_cap(rhs, elem, venv, fenv, 1) {
            Ok(xs) => xs
            Err(e) => return Err(e)
          }
          if nvs.length() > 0 {
            out.push((k, nvs[0]))
          }
        } else {
          out.push((k, elem))
        }
        i = i + 1
      }
      Ok(JqVal::Object(jq_obj_from_entries(out)))
    }
    other =>
    if opt {
      Ok(input)
    } else {
      Err(EvalSignal::Error(JqError::RuntimeError("cannot iterate over " + jq_type_name(other))))
    }
  }
}

///| Single-pass structural recursive update for `(.. | numbers) |= rhs` etc.
fn EvalCtx::fast_update_recurse_type(
  self : EvalCtx,
  v : JqVal,
  type_filter : String,
  rhs : Int,
  venv : Int,
  fenv : Int,
) -> Result[Option[JqVal], EvalSignal] {
  match self.step() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let matches_type = if type_filter == "numbers" {
    match v { JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => true _ => false }
  } else if type_filter == "strings" {
    match v { JqVal::Str(_) => true _ => false }
  } else if type_filter == "booleans" {
    match v { JqVal::Bool(_) => true _ => false }
  } else if type_filter == "nulls" {
    match v { JqVal::Null => true _ => false }
  } else if type_filter == "scalars" {
    match v { JqVal::Array(_) | JqVal::Object(_) => false _ => true }
  } else {
    false
  }
  if matches_type {
    let nvs = match self.eval_collect_cap(rhs, v, venv, fenv, 1) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    return if nvs.length() > 0 { Ok(Some(nvs[0])) } else { Ok(None) }
  }
  match v {
    JqVal::Array(items) => {
      let out : Array[JqVal] = []
      let mut i = 0
      while i < items.length() {
        match self.fast_update_recurse_type(items[i], type_filter, rhs, venv, fenv) {
          Ok(Some(nv)) => out.push(nv)
          Ok(None) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      Ok(Some(JqVal::Array(out)))
    }
    JqVal::Object(obj) => {
      let es = obj.entries
      let out : Array[(String, JqVal)] = []
      let mut i = 0
      while i < es.length() {
        let (k, ev) = es[i]
        match self.fast_update_recurse_type(ev, type_filter, rhs, venv, fenv) {
          Ok(Some(nv)) => out.push((k, nv))
          Ok(None) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      Ok(Some(JqVal::Object(jq_obj_from_entries(out))))
    }
    _ => Ok(Some(v))
  }
}

fn EvalCtx::eval_assign(
  self : EvalCtx,
  lhs : Int,
  rhs : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let rvals = match self.eval_collect(rhs, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  // Fast O(n) path for `.[] = rval`
  match self.exprs[lhs] {
    Expr::Iter(t, opt) =>
    match self.exprs[t] {
      Expr::Identity => {
        let mut ri = 0
        while ri < rvals.length() {
          let rv = rvals[ri]
          let res_v = match input {
            JqVal::Array(items) => {
              let out : Array[JqVal] = []
              let mut i = 0
              while i < items.length() {
                match self.step() {
                  Err(e) => return Err(e)
                  Ok(_) => ()
                }
                out.push(rv)
                i = i + 1
              }
              JqVal::Array(out)
            }
            JqVal::Object(obj) => {
              let es = obj.entries
              let out : Array[(String, JqVal)] = []
              let mut i = 0
              while i < es.length() {
                match self.step() {
                  Err(e) => return Err(e)
                  Ok(_) => ()
                }
                let (k, _) = es[i]
                out.push((k, rv))
                i = i + 1
              }
              JqVal::Object(jq_obj_from_entries(out))
            }
            other =>
            if opt {
              input
            } else {
              return Err(EvalSignal::Error(JqError::RuntimeError("cannot iterate over " + jq_type_name(other))))
            }
          }
          match self.emit(sink, res_v) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          ri = ri + 1
        }
        return Ok(())
      }
      _ => ()
    }
    _ => ()
  }
  let paths : Array[(Array[JqVal], JqVal)] = []
  match self.eval_paths(lhs, input, venv, fenv, [], paths) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let mut ri = 0
  while ri < rvals.length() {
    let updates : Array[(Array[JqVal], JqVal)] = []
    let mut pi = 0
    while pi < paths.length() {
      let (p, _) = paths[pi]
      updates.push((p, rvals[ri]))
      pi = pi + 1
    }
    let cur = match jq_batch_setpaths(input, updates, self.limits.max_output_bytes) {
      Ok(v) => v
      Err(e) => return Err(EvalSignal::Error(e))
    }
    match self.emit(sink, cur) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    ri = ri + 1
  }
  Ok(())
}

fn EvalCtx::eval_update(
  self : EvalCtx,
  lhs : Int,
  rhs : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  // Fast O(n) structural update for `.[] |= rhs`, `(.[] | select(p)) |= rhs`, `(.. | numbers) |= rhs`
  match self.exprs[lhs] {
    Expr::Iter(t, opt) =>
    match self.exprs[t] {
      Expr::Identity => {
        match self.try_fast_update_iter(input, -1, rhs, venv, fenv, opt) {
          Ok(v) => return self.emit(sink, v)
          Err(e) => return Err(e)
        }
      }
      _ => ()
    }
    Expr::Bin(BinOp::Pipe, l_id, r_id) => {
      match (self.exprs[l_id], self.exprs[r_id]) {
        (Expr::Iter(t, opt), Expr::Call(fnm, fargs)) =>
        if fnm == "select" && fargs.length() == 1 {
          match self.exprs[t] {
            Expr::Identity => {
              match self.try_fast_update_iter(input, fargs[0], rhs, venv, fenv, opt) {
                Ok(v) => return self.emit(sink, v)
                Err(e) => return Err(e)
              }
            }
            _ => ()
          }
        }
        (Expr::Recurse, Expr::Call(fnm, fargs)) =>
        if fargs.length() == 0 &&
        (fnm == "numbers" || fnm == "strings" || fnm == "booleans" || fnm == "nulls" || fnm == "scalars") {
          match self.fast_update_recurse_type(input, fnm, rhs, venv, fenv) {
            Ok(Some(v)) => return self.emit(sink, v)
            Ok(None) => return self.emit(sink, JqVal::Null)
            Err(e) => return Err(e)
          }
        }
        _ => ()
      }
    }
    _ => ()
  }
  let paths : Array[(Array[JqVal], JqVal)] = []
  match self.eval_paths(lhs, input, venv, fenv, [], paths) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  // Check if all paths are distinct depth-1 paths so we can batch in O(n)
  let updates : Array[(Array[JqVal], JqVal)] = []
  let to_delete : Array[Array[JqVal]] = []
  let mut all_depth1 = true
  let mut pi = 0
  while pi < paths.length() {
    let (p, _) = paths[pi]
    if p.length() != 1 {
      all_depth1 = false
      break
    }
    match is_slice_seg(p[0]) {
      Some(_) => {
        all_depth1 = false
        break
      }
      None => ()
    }
    pi = pi + 1
  }
  if all_depth1 && paths.length() > 1 {
    pi = 0
    while pi < paths.length() {
      let (p, old_v) = paths[pi]
      let new_vs = match self.eval_collect_cap(rhs, old_v, venv, fenv, 1) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      if new_vs.length() == 0 {
        to_delete.push(p)
      } else {
        updates.push((p, new_vs[0]))
      }
      pi = pi + 1
    }
    let mut cur = match jq_batch_setpaths(input, updates, self.limits.max_output_bytes) {
      Ok(v) => v
      Err(e) => return Err(EvalSignal::Error(e))
    }
    if to_delete.length() > 0 {
      cur = match jq_delpaths(cur, to_delete) {
        Ok(v) => v
        Err(e) => return Err(EvalSignal::Error(e))
      }
    }
    return self.emit(sink, cur)
  }
  let mut cur = input
  pi = 0
  while pi < paths.length() {
    let (p, _) = paths[pi]
    let old_v = match jq_getpath(cur, p) {
      Ok(v) => v
      Err(e) => return Err(EvalSignal::Error(e))
    }
    let new_vs = match self.eval_collect_cap(rhs, old_v, venv, fenv, 1) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    if new_vs.length() == 0 {
      to_delete.push(p)
    } else {
      cur = match jq_setpath(cur, p, 0, new_vs[0], self.limits.max_output_bytes) {
        Ok(v) => v
        Err(e) => return Err(EvalSignal::Error(e))
      }
    }
    pi = pi + 1
  }
  if to_delete.length() > 0 {
    cur = match jq_delpaths(cur, to_delete) {
      Ok(v) => v
      Err(e) => return Err(EvalSignal::Error(e))
    }
  }
  self.emit(sink, cur)
}

fn EvalCtx::eval_compound_assign(
  self : EvalCtx,
  op : BinOp,
  lhs : Int,
  rhs : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let rvals = match self.eval_collect(rhs, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let paths : Array[(Array[JqVal], JqVal)] = []
  match self.eval_paths(lhs, input, venv, fenv, [], paths) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let mut ri = 0
  while ri < rvals.length() {
    let mut cur = input
    let mut pi = 0
    while pi < paths.length() {
      let (p, _) = paths[pi]
      let old_v = match jq_getpath(cur, p) {
        Ok(v) => v
        Err(e) => return Err(EvalSignal::Error(e))
      }
      let nv = match op {
        BinOp::AddAssign => jq_add(old_v, rvals[ri], self.limits.max_output_bytes)
        BinOp::SubAssign => jq_sub(old_v, rvals[ri])
        BinOp::MulAssign => jq_mul(old_v, rvals[ri], self.limits)
        BinOp::DivAssign => jq_div(old_v, rvals[ri])
        BinOp::ModAssign => jq_mod(old_v, rvals[ri])
        BinOp::AltAssign => Ok(if jq_truthy(old_v) { old_v } else { rvals[ri] })
        _ => Err(JqError::RuntimeError("unexpected compound assign"))
      }
      let new_val = match nv {
        Ok(v) => v
        Err(e) => return Err(EvalSignal::Error(e))
      }
      cur = match jq_setpath(cur, p, 0, new_val, self.limits.max_output_bytes) {
        Ok(v) => v
        Err(e) => return Err(EvalSignal::Error(e))
      }
      pi = pi + 1
    }
    match self.emit(sink, cur) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    ri = ri + 1
  }
  Ok(())
}
