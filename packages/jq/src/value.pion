///| jq value semantics: total ordering, equality, arithmetic, indexing, slicing,
///| path operations (`getpath`, `setpath`, `delpaths`), and JSON serialization.

import "json5"

fn is_nan_f64(x : Double) -> Bool {
  x != x
}

fn is_inf_f64(x : Double) -> Bool {
  x == 1.0 / 0.0 || x == -1.0 / 0.0
}

fn is_finite_f64(x : Double) -> Bool {
  x == x && x != 1.0 / 0.0 && x != -1.0 / 0.0
}

fn is_normal_f64(x : Double) -> Bool {
  if !is_finite_f64(x) || x == 0.0 {
    return false
  }
  let ax = if x < 0.0 { -x } else { x }
  ax >= 2.2250738585072014e-308
}

fn f64_floor(x : Double) -> Double {
  if !is_finite_f64(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  let i = x.to_int64()
  let d = i.to_double()
  if x < d {
    d - 1.0
  } else {
    d
  }
}

fn f64_ceil(x : Double) -> Double {
  if !is_finite_f64(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  let i = x.to_int64()
  let d = i.to_double()
  if x > d {
    d + 1.0
  } else {
    d
  }
}

fn f64_trunc(x : Double) -> Double {
  if !is_finite_f64(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  x.to_int64().to_double()
}

fn f64_to_int_index(x : Double) -> Option[Int] {
  if !is_finite_f64(x) {
    return None
  }
  if x < -2147483648.0 || x > 2147483647.0 {
    return None
  }
  Some(f64_floor(x).to_int64().to_int())
}

fn jq_type_name(v : json5::Json5Value) -> String {
  match v {
    json5::Json5Value::Null => "null"
    json5::Json5Value::Bool(_) => "boolean"
    json5::Json5Value::Number(_) => "number"
    json5::Json5Value::Str(_) => "string"
    json5::Json5Value::Array(_) => "array"
    json5::Json5Value::Object(_) => "object"
  }
}

fn jq_truthy(v : json5::Json5Value) -> Bool {
  match v {
    json5::Json5Value::Null => false
    json5::Json5Value::Bool(b) => b
    _ => true
  }
}

fn jq_type_rank(v : json5::Json5Value) -> Int {
  match v {
    json5::Json5Value::Null => 0
    json5::Json5Value::Bool(false) => 1
    json5::Json5Value::Bool(true) => 2
    json5::Json5Value::Number(_) => 3
    json5::Json5Value::Str(_) => 4
    json5::Json5Value::Array(_) => 5
    json5::Json5Value::Object(_) => 6
  }
}

fn cmp_str(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let m = if na < nb { na } else { nb }
  let mut i = 0
  while i < m {
    let ca = a.code_unit_at(i)
    let cb = b.code_unit_at(i)
    if ca != cb {
      return if ca < cb { -1 } else { 1 }
    }
    i = i + 1
  }
  if na < nb {
    -1
  } else if na > nb {
    1
  } else {
    0
  }
}

///| Sort an array of `(String, Json5Value)` entries by key (mergesort, stable).
fn sort_obj_entries(
  entries : Array[(String, json5::Json5Value)],
) -> Array[(String, json5::Json5Value)] {
  // Deduplicate LastWins first, then sort
  let n = entries.length()
  if n <= 1 {
    return entries
  }
  let dedup : Array[(String, json5::Json5Value)] = []
  let seen : Map[String, Int] = Map::new()
  let mut i = 0
  while i < n {
    let (k, v) = entries[i]
    match seen.get(k) {
      Some(idx) => dedup[idx] = (k, v)
      None => {
        seen.set(k, dedup.length())
        dedup.push((k, v))
      }
    }
    i = i + 1
  }
  sort_entries_slice(dedup)
}

fn sort_entries_slice(
  arr : Array[(String, json5::Json5Value)],
) -> Array[(String, json5::Json5Value)] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  let mid = n / 2
  let left : Array[(String, json5::Json5Value)] = []
  let right : Array[(String, json5::Json5Value)] = []
  let mut i = 0
  while i < mid {
    left.push(arr[i])
    i = i + 1
  }
  while i < n {
    right.push(arr[i])
    i = i + 1
  }
  let sl = sort_entries_slice(left)
  let sr = sort_entries_slice(right)
  let out : Array[(String, json5::Json5Value)] = []
  let mut li = 0
  let mut ri = 0
  while li < sl.length() && ri < sr.length() {
    let (lk, _) = sl[li]
    let (rk, _) = sr[ri]
    if cmp_str(lk, rk) <= 0 {
      out.push(sl[li])
      li = li + 1
    } else {
      out.push(sr[ri])
      ri = ri + 1
    }
  }
  while li < sl.length() {
    out.push(sl[li])
    li = li + 1
  }
  while ri < sr.length() {
    out.push(sr[ri])
    ri = ri + 1
  }
  out
}

///| Strict jq total order: `null < false < true < number < string < array < object`.
fn jq_cmp(a : json5::Json5Value, b : json5::Json5Value) -> Int {
  let ra = jq_type_rank(a)
  let rb = jq_type_rank(b)
  if ra != rb {
    return if ra < rb { -1 } else { 1 }
  }
  match (a, b) {
    (json5::Json5Value::Number(x), json5::Json5Value::Number(y)) => {
      let xnan = is_nan_f64(x)
      let ynan = is_nan_f64(y)
      if xnan && ynan {
        0
      } else if xnan {
        -1
      } else if ynan {
        1
      } else if x < y {
        -1
      } else if x > y {
        1
      } else {
        0
      }
    }
    (json5::Json5Value::Str(x), json5::Json5Value::Str(y)) => cmp_str(x, y)
    (json5::Json5Value::Array(xa), json5::Json5Value::Array(xb)) => {
      let na = xa.length()
      let nb = xb.length()
      let m = if na < nb { na } else { nb }
      let mut i = 0
      while i < m {
        let c = jq_cmp(xa[i], xb[i])
        if c != 0 {
          return c
        }
        i = i + 1
      }
      if na < nb {
        -1
      } else if na > nb {
        1
      } else {
        0
      }
    }
    (json5::Json5Value::Object(ea), json5::Json5Value::Object(eb)) => {
      let sa = sort_obj_entries(ea)
      let sb = sort_obj_entries(eb)
      let na = sa.length()
      let nb = sb.length()
      let m = if na < nb { na } else { nb }
      // Compare sorted key lists first
      let mut i = 0
      while i < m {
        let (ka, _) = sa[i]
        let (kb, _) = sb[i]
        let c = cmp_str(ka, kb)
        if c != 0 {
          return c
        }
        i = i + 1
      }
      if na != nb {
        return if na < nb { -1 } else { 1 }
      }
      // Keys equal: compare values in sorted key order
      i = 0
      while i < na {
        let (_, va) = sa[i]
        let (_, vb) = sb[i]
        let c = jq_cmp(va, vb)
        if c != 0 {
          return c
        }
        i = i + 1
      }
      0
    }
    _ => 0
  }
}

fn jq_eq(a : json5::Json5Value, b : json5::Json5Value) -> Bool {
  match (a, b) {
    (json5::Json5Value::Number(x), json5::Json5Value::Number(y)) => x == y
    _ => json5::value_eq(a, b)
  }
}

///| Count UTF-8 Unicode codepoints in `s`.
fn utf8_char_len(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  let mut count = 0
  while i < n {
    let b = s.code_unit_at(i)
    if (b & 0xC0) != 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

///| Convert codepoint index `cp_idx` (0..=char_len) to byte offset in UTF-8 string `s`.
fn utf8_cp_to_byte(s : String, cp_idx : Int) -> Int {
  let n = s.length()
  if cp_idx <= 0 {
    return 0
  }
  let mut i = 0
  let mut count = 0
  while i < n {
    let b = s.code_unit_at(i)
    if (b & 0xC0) != 0x80 {
      if count == cp_idx {
        return i
      }
      count = count + 1
    }
    i = i + 1
  }
  n
}

///| Convert byte offset to UTF-8 codepoint index.
fn utf8_byte_to_cp(s : String, byte_off : Int) -> Int {
  let n = if byte_off < s.length() { byte_off } else { s.length() }
  let mut i = 0
  let mut count = 0
  while i < n {
    let b = s.code_unit_at(i)
    if (b & 0xC0) != 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

///| Decode UTF-8 string into array of Unicode codepoints.
fn utf8_explode(s : String) -> Array[Int] {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      out.push(b0)
      i = i + 1
    } else if (b0 & 0xE0) == 0xC0 && i + 1 < n {
      let b1 = s.code_unit_at(i + 1)
      out.push(((b0 & 0x1F) << 6) | (b1 & 0x3F))
      i = i + 2
    } else if (b0 & 0xF0) == 0xE0 && i + 2 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      out.push(((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F))
      i = i + 3
    } else if (b0 & 0xF8) == 0xF0 && i + 3 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      out.push(
        ((b0 & 0x07) << 18) |
        ((b1 & 0x3F) << 12) |
        ((b2 & 0x3F) << 6) |
        (b3 & 0x3F),
      )
      i = i + 4
    } else {
      out.push(0xFFFD)
      i = i + 1
    }
  }
  out
}

fn obj_get_last(
  entries : Array[(String, json5::Json5Value)],
  key : String,
) -> Option[json5::Json5Value] {
  let mut i = entries.length() - 1
  while i >= 0 {
    let (k, v) = entries[i]
    if k == key {
      return Some(v)
    }
    i = i - 1
  }
  None
}

fn obj_set_entry(
  entries : Array[(String, json5::Json5Value)],
  key : String,
  v : json5::Json5Value,
) -> Array[(String, json5::Json5Value)] {
  let out : Array[(String, json5::Json5Value)] = []
  let mut found = false
  let mut i = 0
  while i < entries.length() {
    let (k, ev) = entries[i]
    if k == key {
      if !found {
        out.push((key, v))
        found = true
      }
    } else {
      out.push((k, ev))
    }
    i = i + 1
  }
  if !found {
    out.push((key, v))
  }
  out
}

fn obj_del_entry(
  entries : Array[(String, json5::Json5Value)],
  key : String,
) -> Array[(String, json5::Json5Value)] {
  let out : Array[(String, json5::Json5Value)] = []
  let mut i = 0
  while i < entries.length() {
    let (k, ev) = entries[i]
    if k != key {
      out.push((k, ev))
    }
    i = i + 1
  }
  out
}

fn obj_merge_shallow(
  a : Array[(String, json5::Json5Value)],
  b : Array[(String, json5::Json5Value)],
) -> Array[(String, json5::Json5Value)] {
  let out : Array[(String, json5::Json5Value)] = []
  let idx_map : Map[String, Int] = Map::new()
  let mut i = 0
  while i < a.length() {
    let (k, v) = a[i]
    match idx_map.get(k) {
      Some(idx) => out[idx] = (k, v)
      None => {
        idx_map.set(k, out.length())
        out.push((k, v))
      }
    }
    i = i + 1
  }
  i = 0
  while i < b.length() {
    let (k, v) = b[i]
    match idx_map.get(k) {
      Some(idx) => out[idx] = (k, v)
      None => {
        idx_map.set(k, out.length())
        out.push((k, v))
      }
    }
    i = i + 1
  }
  out
}

fn obj_merge_deep(
  a : Array[(String, json5::Json5Value)],
  b : Array[(String, json5::Json5Value)],
  depth : Int,
  max_depth : Int,
) -> Result[Array[(String, json5::Json5Value)], JqError] {
  if depth > max_depth {
    return Err(JqError::LimitExceeded("max recursion depth exceeded in object merge"))
  }
  let out : Array[(String, json5::Json5Value)] = []
  let idx_map : Map[String, Int] = Map::new()
  let mut i = 0
  while i < a.length() {
    let (k, v) = a[i]
    match idx_map.get(k) {
      Some(idx) => out[idx] = (k, v)
      None => {
        idx_map.set(k, out.length())
        out.push((k, v))
      }
    }
    i = i + 1
  }
  i = 0
  while i < b.length() {
    let (k, bv) = b[i]
    match idx_map.get(k) {
      Some(idx) => {
        let (_, av) = out[idx]
        match (av, bv) {
          (json5::Json5Value::Object(ao), json5::Json5Value::Object(bo)) => {
            let merged = match obj_merge_deep(ao, bo, depth + 1, max_depth) {
              Ok(m) => m
              Err(e) => return Err(e)
            }
            out[idx] = (k, json5::Json5Value::Object(merged))
          }
          _ => out[idx] = (k, bv)
        }
      }
      None => {
        idx_map.set(k, out.length())
        out.push((k, bv))
      }
    }
    i = i + 1
  }
  Ok(out)
}

fn str_split_literal(s : String, sep : String) -> Array[json5::Json5Value] {
  let out : Array[json5::Json5Value] = []
  let n = s.length()
  let m = sep.length()
  if m == 0 {
    let cps = utf8_explode(s)
    let mut i = 0
    while i < cps.length() {
      let sb = StringBuilder::new()
      write_utf8_cp(sb, cps[i])
      out.push(json5::Json5Value::Str(sb.to_string()))
      i = i + 1
    }
    return out
  }
  let mut start = 0
  let mut i = 0
  while i + m <= n {
    let mut matched = true
    let mut k = 0
    while k < m {
      if s.code_unit_at(i + k) != sep.code_unit_at(k) {
        matched = false
        break
      }
      k = k + 1
    }
    if matched {
      out.push(json5::Json5Value::Str(s.slice(start, i)))
      i = i + m
      start = i
    } else {
      i = i + 1
    }
  }
  out.push(json5::Json5Value::Str(s.slice(start, n)))
  out
}

fn jq_add(
  a : json5::Json5Value,
  b : json5::Json5Value,
  max_bytes : Int,
) -> Result[json5::Json5Value, JqError] {
  match (a, b) {
    (json5::Json5Value::Null, x) => Ok(x)
    (x, json5::Json5Value::Null) => Ok(x)
    (json5::Json5Value::Number(x), json5::Json5Value::Number(y)) =>
    Ok(json5::Json5Value::Number(x + y))
    (json5::Json5Value::Str(x), json5::Json5Value::Str(y)) => {
      if x.length() + y.length() > max_bytes {
        return Err(JqError::LimitExceeded("string concatenation exceeds max_output_bytes"))
      }
      Ok(json5::Json5Value::Str(x + y))
    }
    (json5::Json5Value::Array(xa), json5::Json5Value::Array(xb)) => {
      if xa.length() + xb.length() > max_bytes {
        return Err(JqError::LimitExceeded("array concatenation exceeds max_output_bytes"))
      }
      let out : Array[json5::Json5Value] = []
      let mut i = 0
      while i < xa.length() {
        out.push(xa[i])
        i = i + 1
      }
      i = 0
      while i < xb.length() {
        out.push(xb[i])
        i = i + 1
      }
      Ok(json5::Json5Value::Array(out))
    }
    (json5::Json5Value::Object(oa), json5::Json5Value::Object(ob)) =>
    Ok(json5::Json5Value::Object(obj_merge_shallow(oa, ob)))
    _ =>
    Err(
      JqError::RuntimeError(
        jq_type_name(a) + " and " + jq_type_name(b) + " cannot be added",
      ),
    )
  }
}

fn jq_sub(
  a : json5::Json5Value,
  b : json5::Json5Value,
) -> Result[json5::Json5Value, JqError] {
  match (a, b) {
    (json5::Json5Value::Number(x), json5::Json5Value::Number(y)) =>
    Ok(json5::Json5Value::Number(x - y))
    (json5::Json5Value::Array(xa), json5::Json5Value::Array(xb)) => {
      let out : Array[json5::Json5Value] = []
      let mut i = 0
      while i < xa.length() {
        let mut drop = false
        let mut j = 0
        while j < xb.length() {
          if jq_eq(xa[i], xb[j]) {
            drop = true
            break
          }
          j = j + 1
        }
        if !drop {
          out.push(xa[i])
        }
        i = i + 1
      }
      Ok(json5::Json5Value::Array(out))
    }
    _ =>
    Err(
      JqError::RuntimeError(
        jq_type_name(a) + " and " + jq_type_name(b) + " cannot be subtracted",
      ),
    )
  }
}

fn jq_str_repeat(s : String, times : Double, max_bytes : Int) -> Result[json5::Json5Value, JqError] {
  if is_nan_f64(times) || times <= 0.0 {
    return Ok(json5::Json5Value::Null)
  }
  if is_inf_f64(times) {
    return Err(JqError::LimitExceeded("string repetition exceeds max_output_bytes"))
  }
  let n_f = f64_trunc(times)
  if n_f <= 0.0 {
    return Ok(json5::Json5Value::Null)
  }
  if s.length() == 0 {
    return Ok(json5::Json5Value::Str(""))
  }
  if n_f > max_bytes.to_double() {
    return Err(JqError::LimitExceeded("string repetition exceeds max_output_bytes"))
  }
  let count = n_f.to_int64().to_int()
  if count > max_bytes / s.length() {
    return Err(JqError::LimitExceeded("string repetition exceeds max_output_bytes"))
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < count {
    sb.write_string(s)
    i = i + 1
  }
  Ok(json5::Json5Value::Str(sb.to_string()))
}

fn jq_mul(
  a : json5::Json5Value,
  b : json5::Json5Value,
  limits : JqLimits,
) -> Result[json5::Json5Value, JqError] {
  match (a, b) {
    (json5::Json5Value::Number(x), json5::Json5Value::Number(y)) =>
    Ok(json5::Json5Value::Number(x * y))
    (json5::Json5Value::Str(s), json5::Json5Value::Number(n)) =>
    jq_str_repeat(s, n, limits.max_output_bytes)
    (json5::Json5Value::Number(n), json5::Json5Value::Str(s)) =>
    jq_str_repeat(s, n, limits.max_output_bytes)
    (json5::Json5Value::Object(oa), json5::Json5Value::Object(ob)) =>
    match obj_merge_deep(oa, ob, 0, limits.max_depth) {
      Ok(m) => Ok(json5::Json5Value::Object(m))
      Err(e) => Err(e)
    }
    _ =>
    Err(
      JqError::RuntimeError(
        jq_type_name(a) + " and " + jq_type_name(b) + " cannot be multiplied",
      ),
    )
  }
}

fn jq_div(
  a : json5::Json5Value,
  b : json5::Json5Value,
) -> Result[json5::Json5Value, JqError] {
  match (a, b) {
    (json5::Json5Value::Number(x), json5::Json5Value::Number(y)) => {
      if y == 0.0 {
        return Err(JqError::RuntimeError("number cannot be divided by zero"))
      }
      Ok(json5::Json5Value::Number(x / y))
    }
    (json5::Json5Value::Str(s), json5::Json5Value::Str(sep)) =>
    Ok(json5::Json5Value::Array(str_split_literal(s, sep)))
    _ =>
    Err(
      JqError::RuntimeError(
        jq_type_name(a) + " and " + jq_type_name(b) + " cannot be divided",
      ),
    )
  }
}

fn jq_mod(
  a : json5::Json5Value,
  b : json5::Json5Value,
) -> Result[json5::Json5Value, JqError] {
  match (a, b) {
    (json5::Json5Value::Number(x), json5::Json5Value::Number(y)) => {
      if is_nan_f64(x) || is_nan_f64(y) {
        return Ok(json5::Json5Value::Number(0.0 / 0.0))
      }
      let yi = f64_trunc(y)
      if yi == 0.0 {
        return Err(JqError::RuntimeError("number cannot be divided (remainder) by zero"))
      }
      let xi = f64_trunc(x)
      let q = f64_trunc(xi / yi)
      Ok(json5::Json5Value::Number(xi - q * yi))
    }
    _ =>
    Err(
      JqError::RuntimeError(
        jq_type_name(a) + " and " + jq_type_name(b) + " cannot be divided (remainder)",
      ),
    )
  }
}

fn jq_index_val(
  target : json5::Json5Value,
  idx : json5::Json5Value,
) -> Result[json5::Json5Value, JqError] {
  match target {
    json5::Json5Value::Null => Ok(json5::Json5Value::Null)
    json5::Json5Value::Object(entries) =>
    match idx {
      json5::Json5Value::Str(k) =>
      match obj_get_last(entries, k) {
        Some(v) => Ok(v)
        None => Ok(json5::Json5Value::Null)
      }
      _ => Err(JqError::RuntimeError("cannot index object with " + jq_type_name(idx)))
    }
    json5::Json5Value::Array(items) =>
    match idx {
      json5::Json5Value::Number(x) => {
        if is_nan_f64(x) {
          return Ok(json5::Json5Value::Null)
        }
        match f64_to_int_index(x) {
          Some(raw_i) => {
            let i = if raw_i < 0 { items.length() + raw_i } else { raw_i }
            if i >= 0 && i < items.length() {
              Ok(items[i])
            } else {
              Ok(json5::Json5Value::Null)
            }
          }
          None => Ok(json5::Json5Value::Null)
        }
      }
      _ => Err(JqError::RuntimeError("cannot index array with " + jq_type_name(idx)))
    }
    _ => Err(JqError::RuntimeError("cannot index " + jq_type_name(target)))
  }
}

fn normalize_slice_bound(raw : Option[json5::Json5Value], len : Int, is_start : Bool) -> Result[Int, JqError] {
  match raw {
    None => Ok(if is_start { 0 } else { len })
    Some(json5::Json5Value::Null) => Ok(if is_start { 0 } else { len })
    Some(json5::Json5Value::Number(x)) => {
      if is_nan_f64(x) {
        return Ok(if is_start { 0 } else { len })
      }
      let f = if is_start { f64_floor(x) } else { f64_ceil(x) }
      let mut idx = if f < -2147483648.0 {
        -len - 1
      } else if f > 2147483647.0 {
        len + 1
      } else {
        f.to_int64().to_int()
      }
      if idx < 0 {
        idx = len + idx
      }
      if idx < 0 {
        idx = 0
      }
      if idx > len {
        idx = len
      }
      Ok(idx)
    }
    Some(other) =>
    Err(JqError::RuntimeError("slice index must be number, got " + jq_type_name(other)))
  }
}

fn jq_slice_val(
  target : json5::Json5Value,
  start_v : Option[json5::Json5Value],
  end_v : Option[json5::Json5Value],
) -> Result[json5::Json5Value, JqError] {
  match target {
    json5::Json5Value::Null => Ok(json5::Json5Value::Null)
    json5::Json5Value::Array(items) => {
      let n = items.length()
      let s = match normalize_slice_bound(start_v, n, true) {
        Ok(i) => i
        Err(e) => return Err(e)
      }
      let e = match normalize_slice_bound(end_v, n, false) {
        Ok(i) => i
        Err(e) => return Err(e)
      }
      let out : Array[json5::Json5Value] = []
      let mut i = s
      while i < e {
        out.push(items[i])
        i = i + 1
      }
      Ok(json5::Json5Value::Array(out))
    }
    json5::Json5Value::Str(str) => {
      let n = utf8_char_len(str)
      let s = match normalize_slice_bound(start_v, n, true) {
        Ok(i) => i
        Err(e) => return Err(e)
      }
      let e = match normalize_slice_bound(end_v, n, false) {
        Ok(i) => i
        Err(e) => return Err(e)
      }
      if s >= e {
        return Ok(json5::Json5Value::Str(""))
      }
      let bs = utf8_cp_to_byte(str, s)
      let be = utf8_cp_to_byte(str, e)
      Ok(json5::Json5Value::Str(str.slice(bs, be)))
    }
    _ => Err(JqError::RuntimeError("cannot slice " + jq_type_name(target)))
  }
}

fn jq_getpath(
  root : json5::Json5Value,
  path : Array[json5::Json5Value],
) -> Result[json5::Json5Value, JqError] {
  let mut cur = root
  let mut i = 0
  while i < path.length() {
    cur = match jq_index_val(cur, path[i]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  Ok(cur)
}

fn jq_setpath(
  root : json5::Json5Value,
  path : Array[json5::Json5Value],
  idx : Int,
  new_val : json5::Json5Value,
  max_bytes : Int,
) -> Result[json5::Json5Value, JqError] {
  if idx >= path.length() {
    return Ok(new_val)
  }
  let seg = path[idx]
  match seg {
    json5::Json5Value::Str(key) =>
    match root {
      json5::Json5Value::Null => {
        let sub = match jq_setpath(json5::Json5Value::Null, path, idx + 1, new_val, max_bytes) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        Ok(json5::Json5Value::Object([(key, sub)]))
      }
      json5::Json5Value::Object(entries) => {
        let cur_child = match obj_get_last(entries, key) {
          Some(v) => v
          None => json5::Json5Value::Null
        }
        let sub = match jq_setpath(cur_child, path, idx + 1, new_val, max_bytes) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        Ok(json5::Json5Value::Object(obj_set_entry(entries, key, sub)))
      }
      _ => Err(JqError::RuntimeError("cannot index " + jq_type_name(root) + " with string"))
    }
    json5::Json5Value::Number(x) => {
      let raw_i = match f64_to_int_index(x) {
        Some(n) => n
        None => return Err(JqError::RuntimeError("invalid array index in setpath"))
      }
      match root {
        json5::Json5Value::Null => {
          if raw_i < 0 {
            return Err(JqError::RuntimeError("out of bounds negative array index"))
          }
          if raw_i > max_bytes {
            return Err(JqError::LimitExceeded("array allocation in setpath exceeds max_output_bytes"))
          }
          let sub = match jq_setpath(json5::Json5Value::Null, path, idx + 1, new_val, max_bytes) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          let out : Array[json5::Json5Value] = []
          let mut k = 0
          while k < raw_i {
            out.push(json5::Json5Value::Null)
            k = k + 1
          }
          out.push(sub)
          Ok(json5::Json5Value::Array(out))
        }
        json5::Json5Value::Array(items) => {
          let i = if raw_i < 0 { items.length() + raw_i } else { raw_i }
          if i < 0 {
            return Err(JqError::RuntimeError("out of bounds negative array index"))
          }
          if i > max_bytes {
            return Err(JqError::LimitExceeded("array allocation in setpath exceeds max_output_bytes"))
          }
          let cur_child = if i < items.length() {
            items[i]
          } else {
            json5::Json5Value::Null
          }
          let sub = match jq_setpath(cur_child, path, idx + 1, new_val, max_bytes) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          let out : Array[json5::Json5Value] = []
          let new_len = if i >= items.length() { i + 1 } else { items.length() }
          let mut k = 0
          while k < new_len {
            if k == i {
              out.push(sub)
            } else if k < items.length() {
              out.push(items[k])
            } else {
              out.push(json5::Json5Value::Null)
            }
            k = k + 1
          }
          Ok(json5::Json5Value::Array(out))
        }
        _ => Err(JqError::RuntimeError("cannot index " + jq_type_name(root) + " with number"))
      }
    }
    _ => Err(JqError::RuntimeError("invalid path segment type: " + jq_type_name(seg)))
  }
}

fn jq_delpath_one(
  root : json5::Json5Value,
  path : Array[json5::Json5Value],
  idx : Int,
) -> Result[json5::Json5Value, JqError] {
  if idx >= path.length() {
    return Ok(json5::Json5Value::Null)
  }
  let seg = path[idx]
  let is_last = idx + 1 == path.length()
  match seg {
    json5::Json5Value::Str(key) =>
    match root {
      json5::Json5Value::Null => Ok(json5::Json5Value::Null)
      json5::Json5Value::Object(entries) => {
        if is_last {
          Ok(json5::Json5Value::Object(obj_del_entry(entries, key)))
        } else {
          match obj_get_last(entries, key) {
            None => Ok(root)
            Some(child) => {
              let sub = match jq_delpath_one(child, path, idx + 1) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              Ok(json5::Json5Value::Object(obj_set_entry(entries, key, sub)))
            }
          }
        }
      }
      _ => Err(JqError::RuntimeError("cannot delete string field from " + jq_type_name(root)))
    }
    json5::Json5Value::Number(x) => {
      let raw_i = match f64_to_int_index(x) {
        Some(n) => n
        None => return Ok(root)
      }
      match root {
        json5::Json5Value::Null => Ok(json5::Json5Value::Null)
        json5::Json5Value::Array(items) => {
          let i = if raw_i < 0 { items.length() + raw_i } else { raw_i }
          if i < 0 || i >= items.length() {
            return Ok(root)
          }
          if is_last {
            let out : Array[json5::Json5Value] = []
            let mut k = 0
            while k < items.length() {
              if k != i {
                out.push(items[k])
              }
              k = k + 1
            }
            Ok(json5::Json5Value::Array(out))
          } else {
            let sub = match jq_delpath_one(items[i], path, idx + 1) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            let out : Array[json5::Json5Value] = []
            let mut k = 0
            while k < items.length() {
              if k == i {
                out.push(sub)
              } else {
                out.push(items[k])
              }
              k = k + 1
            }
            Ok(json5::Json5Value::Array(out))
          }
        }
        _ => Err(JqError::RuntimeError("cannot delete index from " + jq_type_name(root)))
      }
    }
    _ => Err(JqError::RuntimeError("invalid path segment in delpaths"))
  }
}

fn jq_delpaths(
  root : json5::Json5Value,
  paths : Array[Array[json5::Json5Value]],
) -> Result[json5::Json5Value, JqError] {
  // Sort paths in reverse jq order so higher array indices are deleted before lower ones
  let n = paths.length()
  if n == 0 {
    return Ok(root)
  }
  let wrapped : Array[json5::Json5Value] = []
  let mut i = 0
  while i < n {
    wrapped.push(json5::Json5Value::Array(paths[i]))
    i = i + 1
  }
  let sorted = sort_values(wrapped)
  let mut cur = root
  let mut j = sorted.length() - 1
  while j >= 0 {
    // Skip duplicate paths
    if j + 1 < sorted.length() && jq_eq(sorted[j], sorted[j + 1]) {
      j = j - 1
      continue
    }
    match sorted[j] {
      json5::Json5Value::Array(p) => {
        if p.length() == 0 {
          return Ok(json5::Json5Value::Null)
        }
        cur = match jq_delpath_one(cur, p, 0) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
      }
      _ => ()
    }
    j = j - 1
  }
  Ok(cur)
}

///| Stable mergesort of `Array[Json5Value]` using strict jq total order.
fn sort_values(arr : Array[json5::Json5Value]) -> Array[json5::Json5Value] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  let mid = n / 2
  let left : Array[json5::Json5Value] = []
  let right : Array[json5::Json5Value] = []
  let mut i = 0
  while i < mid {
    left.push(arr[i])
    i = i + 1
  }
  while i < n {
    right.push(arr[i])
    i = i + 1
  }
  let sl = sort_values(left)
  let sr = sort_values(right)
  let out : Array[json5::Json5Value] = []
  let mut li = 0
  let mut ri = 0
  while li < sl.length() && ri < sr.length() {
    if jq_cmp(sl[li], sr[ri]) <= 0 {
      out.push(sl[li])
      li = li + 1
    } else {
      out.push(sr[ri])
      ri = ri + 1
    }
  }
  while li < sl.length() {
    out.push(sl[li])
    li = li + 1
  }
  while ri < sr.length() {
    out.push(sr[ri])
    ri = ri + 1
  }
  out
}

///| Stable mergesort of `(key, value)` pairs by key using strict jq total order.
fn sort_keyed_values(
  arr : Array[(json5::Json5Value, json5::Json5Value)],
) -> Array[(json5::Json5Value, json5::Json5Value)] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  let mid = n / 2
  let left : Array[(json5::Json5Value, json5::Json5Value)] = []
  let right : Array[(json5::Json5Value, json5::Json5Value)] = []
  let mut i = 0
  while i < mid {
    left.push(arr[i])
    i = i + 1
  }
  while i < n {
    right.push(arr[i])
    i = i + 1
  }
  let sl = sort_keyed_values(left)
  let sr = sort_keyed_values(right)
  let out : Array[(json5::Json5Value, json5::Json5Value)] = []
  let mut li = 0
  let mut ri = 0
  while li < sl.length() && ri < sr.length() {
    let (lk, _) = sl[li]
    let (rk, _) = sr[ri]
    if jq_cmp(lk, rk) <= 0 {
      out.push(sl[li])
      li = li + 1
    } else {
      out.push(sr[ri])
      ri = ri + 1
    }
  }
  while li < sl.length() {
    out.push(sl[li])
    li = li + 1
  }
  while ri < sr.length() {
    out.push(sr[ri])
    ri = ri + 1
  }
  out
}

///| Serialize a `Json5Value` to compact JSON (jq semantics: NaN->null, ±Inf->±DBL_MAX).
fn serialize_jq_json(
  v : json5::Json5Value,
  sorted_keys : Bool,
) -> Result[String, JqError] {
  let sb = StringBuilder::new()
  serialize_jq_json_into(sb, v, sorted_keys)
  Ok(sb.to_string())
}

fn write_json_escaped_str(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte(34.to_byte())
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 {
      sb.write_string("\\\"")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 8 {
      sb.write_string("\\b")
    } else if b == 12 {
      sb.write_string("\\f")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 9 {
      sb.write_string("\\t")
    } else if b < 0x20 {
      sb.write_string("\\u00")
      let hi = (b >> 4) & 0xF
      let lo = b & 0xF
      sb.write_byte((if hi < 10 { 48 + hi } else { 87 + hi }).to_byte())
      sb.write_byte((if lo < 10 { 48 + lo } else { 87 + lo }).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.write_byte(34.to_byte())
}

fn serialize_jq_json_into(
  sb : StringBuilder,
  v : json5::Json5Value,
  sorted_keys : Bool,
) -> Unit {
  match v {
    json5::Json5Value::Null => sb.write_string("null")
    json5::Json5Value::Bool(b) => sb.write_string(if b { "true" } else { "false" })
    json5::Json5Value::Number(x) => {
      if is_nan_f64(x) {
        sb.write_string("null")
      } else if x == 1.0 / 0.0 {
        sb.write_string("1.7976931348623157e+308")
      } else if x == -1.0 / 0.0 {
        sb.write_string("-1.7976931348623157e+308")
      } else {
        match json5::to_json_string(v) {
          Ok(s) => sb.write_string(s)
          Err(_) => sb.write_string("null")
        }
      }
    }
    json5::Json5Value::Str(s) => write_json_escaped_str(sb, s)
    json5::Json5Value::Array(items) => {
      sb.write_byte(91.to_byte())
      let mut i = 0
      while i < items.length() {
        if i > 0 {
          sb.write_byte(44.to_byte())
        }
        serialize_jq_json_into(sb, items[i], sorted_keys)
        i = i + 1
      }
      sb.write_byte(93.to_byte())
    }
    json5::Json5Value::Object(entries) => {
      sb.write_byte(123.to_byte())
      let list = if sorted_keys { sort_obj_entries(entries) } else { entries }
      let mut i = 0
      while i < list.length() {
        if i > 0 {
          sb.write_byte(44.to_byte())
        }
        let (k, ev) = list[i]
        write_json_escaped_str(sb, k)
        sb.write_byte(58.to_byte())
        serialize_jq_json_into(sb, ev, sorted_keys)
        i = i + 1
      }
      sb.write_byte(125.to_byte())
    }
  }
}

fn jq_tostring_val(v : json5::Json5Value) -> Result[String, JqError] {
  match v {
    json5::Json5Value::Str(s) => Ok(s)
    _ => serialize_jq_json(v, false)
  }
}
