///| jq value semantics on `JqVal`: exact integer & float arithmetic, iterative total
///| ordering & equality, O(1) indexed object operations, O(n) batched structural
///| path updates (including slices), and iterative `max_output_bytes`-enforced JSON serialization.

import "json5"

fn is_nan_f64(x : Double) -> Bool {
  x != x
}

fn is_inf_f64(x : Double) -> Bool {
  x == 1.0 / 0.0 || x == -1.0 / 0.0
}

fn is_finite_f64(x : Double) -> Bool {
  x == x && x != 1.0 / 0.0 && x != -1.0 / 0.0
}

fn is_normal_f64(x : Double) -> Bool {
  if !is_finite_f64(x) || x == 0.0 {
    return false
  }
  let ax = if x < 0.0 { -x } else { x }
  ax >= 2.2250738585072014e-308
}

fn f64_floor(x : Double) -> Double {
  if !is_finite_f64(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  let i = x.to_int64()
  let d = i.to_double()
  if x < d {
    d - 1.0
  } else {
    d
  }
}

fn f64_ceil(x : Double) -> Double {
  if !is_finite_f64(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  let i = x.to_int64()
  let d = i.to_double()
  if x > d {
    d + 1.0
  } else {
    d
  }
}

fn f64_trunc(x : Double) -> Double {
  if !is_finite_f64(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  x.to_int64().to_double()
}

fn f64_to_int_index(x : Double) -> Option[Int] {
  if !is_finite_f64(x) {
    return None
  }
  if x < -2147483648.0 || x > 2147483647.0 {
    return None
  }
  Some(f64_floor(x).to_int64().to_int())
}

fn jq_val_to_int_index(v : JqVal) -> Option[Int] {
  match v {
    JqVal::Int(i) =>
    if i >= -2147483648L && i <= 2147483647L {
      Some(i.to_int())
    } else {
      None
    }
    JqVal::Float(x) => f64_to_int_index(x)
    JqVal::BigInt(_) => None
    _ => None
  }
}

fn jq_type_name(v : JqVal) -> String {
  match v {
    JqVal::Null => "null"
    JqVal::Bool(_) => "boolean"
    JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => "number"
    JqVal::Str(_) => "string"
    JqVal::Array(_) => "array"
    JqVal::Object(_) => "object"
  }
}

fn jq_truthy(v : JqVal) -> Bool {
  match v {
    JqVal::Null => false
    JqVal::Bool(b) => b
    _ => true
  }
}

fn jq_type_rank(v : JqVal) -> Int {
  match v {
    JqVal::Null => 0
    JqVal::Bool(false) => 1
    JqVal::Bool(true) => 2
    JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => 3
    JqVal::Str(_) => 4
    JqVal::Array(_) => 5
    JqVal::Object(_) => 6
  }
}

fn cmp_str(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let m = if na < nb { na } else { nb }
  let mut i = 0
  while i < m {
    let ca = a.code_unit_at(i)
    let cb = b.code_unit_at(i)
    if ca != cb {
      return if ca < cb { -1 } else { 1 }
    }
    i = i + 1
  }
  if na < nb {
    -1
  } else if na > nb {
    1
  } else {
    0
  }
}

fn sort_entries_slice(arr : Array[(String, JqVal)]) -> Array[(String, JqVal)] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  let mid = n / 2
  let left : Array[(String, JqVal)] = []
  let right : Array[(String, JqVal)] = []
  let mut i = 0
  while i < mid {
    left.push(arr[i])
    i = i + 1
  }
  while i < n {
    right.push(arr[i])
    i = i + 1
  }
  let sl = sort_entries_slice(left)
  let sr = sort_entries_slice(right)
  let out : Array[(String, JqVal)] = []
  let mut li = 0
  let mut ri = 0
  while li < sl.length() && ri < sr.length() {
    let (lk, _) = sl[li]
    let (rk, _) = sr[ri]
    if cmp_str(lk, rk) <= 0 {
      out.push(sl[li])
      li = li + 1
    } else {
      out.push(sr[ri])
      ri = ri + 1
    }
  }
  while li < sl.length() {
    out.push(sl[li])
    li = li + 1
  }
  while ri < sr.length() {
    out.push(sr[ri])
    ri = ri + 1
  }
  out
}

fn sort_obj_entries(entries : Array[(String, JqVal)]) -> Array[(String, JqVal)] {
  let n = entries.length()
  if n <= 1 {
    return entries
  }
  let dedup = jq_obj_dedup_entries(entries).entries
  sort_entries_slice(dedup)
}

fn jq_is_nan_val(v : JqVal) -> Bool {
  match v {
    JqVal::Float(x) => is_nan_f64(x)
    _ => false
  }
}

fn jq_num_cmp(a : JqVal, b : JqVal) -> Int {
  match (a, b) {
    (JqVal::Int(x), JqVal::Int(y)) =>
    if x < y { -1 } else if x > y { 1 } else { 0 }
    (JqVal::BigInt(x), JqVal::BigInt(y)) => bigint_cmp(x, y)
    (JqVal::Int(x), JqVal::BigInt(y)) => bigint_cmp(x.to_string(), y)
    (JqVal::BigInt(x), JqVal::Int(y)) => bigint_cmp(x, y.to_string())
    _ => {
      let x = match jq_val_to_double(a) {
        Some(d) => d
        None => 0.0
      }
      let y = match jq_val_to_double(b) {
        Some(d) => d
        None => 0.0
      }
      let xnan = is_nan_f64(x)
      let ynan = is_nan_f64(y)
      if xnan && ynan {
        0
      } else if xnan {
        -1
      } else if ynan {
        1
      } else if x < y {
        -1
      } else if x > y {
        1
      } else {
        // Tie-break Int vs Float when Double rounded equal (e.g. 9007199254740993 vs 9007199254740992.0)
        match (a, b) {
          (JqVal::Int(xi), JqVal::Float(yf)) =>
          if is_finite_f64(yf) && yf >= -9223372036854775808.0 && yf < 9223372036854775808.0 {
            let yi = yf.to_int64()
            if xi < yi { -1 } else if xi > yi { 1 } else { 0 }
          } else {
            0
          }
          (JqVal::Float(xf), JqVal::Int(yi)) =>
          if is_finite_f64(xf) && xf >= -9223372036854775808.0 && xf < 9223372036854775808.0 {
            let xi = xf.to_int64()
            if xi < yi { -1 } else if xi > yi { 1 } else { 0 }
          } else {
            0
          }
          _ => 0
        }
      }
    }
  }
}

///| Iterative strict jq total order: `null < false < true < number < string < array < object`.
fn jq_cmp(root_a : JqVal, root_b : JqVal) -> Int {
  // Zero-allocation fast path for scalars (Int, Str, Float, Bool, Null, mismatched types)
  match (root_a, root_b) {
    (JqVal::Int(x), JqVal::Int(y)) =>
    return if x < y { -1 } else if x > y { 1 } else { 0 }
    (JqVal::Str(x), JqVal::Str(y)) => return cmp_str(x, y)
    (JqVal::Null, JqVal::Null) => return 0
    (JqVal::Bool(x), JqVal::Bool(y)) =>
    return if x == y { 0 } else if !x { -1 } else { 1 }
    (JqVal::Array(_), JqVal::Array(_)) => ()
    (JqVal::Object(_), JqVal::Object(_)) => ()
    _ => {
      let ra = jq_type_rank(root_a)
      let rb = jq_type_rank(root_b)
      if ra != rb {
        return if ra < rb { -1 } else { 1 }
      }
      if is_jq_num(root_a) && is_jq_num(root_b) {
        return jq_num_cmp(root_a, root_b)
      }
      return 0
    }
  }
  let stack : Array[(JqVal, JqVal)] = [(root_a, root_b)]
  while stack.length() > 0 {
    let (a, b) = match stack.pop() {
      Some(p) => p
      None => break
    }
    let ra = jq_type_rank(a)
    let rb = jq_type_rank(b)
    if ra != rb {
      return if ra < rb { -1 } else { 1 }
    }
    if is_jq_num(a) && is_jq_num(b) {
      let c = jq_num_cmp(a, b)
      if c != 0 {
        return c
      }
      continue
    }
    match (a, b) {
      (JqVal::Str(x), JqVal::Str(y)) => {
        let c = cmp_str(x, y)
        if c != 0 {
          return c
        }
      }
      (JqVal::Array(xa), JqVal::Array(xb)) => {
        let na = xa.length()
        let nb = xb.length()
        let m = if na < nb { na } else { nb }
        // Push length tie-breaker if lengths differ (runs after all prefix elements)
        if na != nb {
          let la = JqVal::Int(na.to_int64())
          let lb = JqVal::Int(nb.to_int64())
          stack.push((la, lb))
        }
        let mut i = m - 1
        while i >= 0 {
          stack.push((xa[i], xb[i]))
          i = i - 1
        }
      }
      (JqVal::Object(oa), JqVal::Object(ob)) => {
        let sa = sort_obj_entries(oa.entries)
        let sb = sort_obj_entries(ob.entries)
        let na = sa.length()
        let nb = sb.length()
        let m = if na < nb { na } else { nb }
        // Compare sorted key lists first
        let mut i = 0
        while i < m {
          let (ka, _) = sa[i]
          let (kb, _) = sb[i]
          let c = cmp_str(ka, kb)
          if c != 0 {
            return c
          }
          i = i + 1
        }
        if na != nb {
          return if na < nb { -1 } else { 1 }
        }
        // Push values in reverse sorted key order
        let mut j = na - 1
        while j >= 0 {
          let (_, va) = sa[j]
          let (_, vb) = sb[j]
          stack.push((va, vb))
          j = j - 1
        }
      }
      _ => ()
    }
  }
  0
}

///| Iterative jq equality (`nan == nan` is `false`).
fn jq_eq(root_a : JqVal, root_b : JqVal) -> Bool {
  // Zero-allocation fast path for scalars
  match (root_a, root_b) {
    (JqVal::Int(x), JqVal::Int(y)) => return x == y
    (JqVal::Str(x), JqVal::Str(y)) => return x == y
    (JqVal::Null, JqVal::Null) => return true
    (JqVal::Bool(x), JqVal::Bool(y)) => return x == y
    (JqVal::Array(_), JqVal::Array(_)) => ()
    (JqVal::Object(_), JqVal::Object(_)) => ()
    _ => {
      let ra = jq_type_rank(root_a)
      let rb = jq_type_rank(root_b)
      if ra != rb {
        return false
      }
      if is_jq_num(root_a) && is_jq_num(root_b) {
        if jq_is_nan_val(root_a) || jq_is_nan_val(root_b) {
          return false
        }
        return jq_num_cmp(root_a, root_b) == 0
      }
      return false
    }
  }
  let stack : Array[(JqVal, JqVal)] = [(root_a, root_b)]
  while stack.length() > 0 {
    let (a, b) = match stack.pop() {
      Some(p) => p
      None => break
    }
    let ra = jq_type_rank(a)
    let rb = jq_type_rank(b)
    if ra != rb {
      return false
    }
    if is_jq_num(a) && is_jq_num(b) {
      if jq_is_nan_val(a) || jq_is_nan_val(b) {
        return false
      }
      if jq_num_cmp(a, b) != 0 {
        return false
      }
      continue
    }
    match (a, b) {
      (JqVal::Null, JqVal::Null) => ()
      (JqVal::Bool(x), JqVal::Bool(y)) => if x != y { return false }
      (JqVal::Str(x), JqVal::Str(y)) => if x != y { return false }
      (JqVal::Array(xa), JqVal::Array(xb)) => {
        if xa.length() != xb.length() {
          return false
        }
        let mut i = xa.length() - 1
        while i >= 0 {
          stack.push((xa[i], xb[i]))
          i = i - 1
        }
      }
      (JqVal::Object(oa), JqVal::Object(ob)) => {
        let sa = sort_obj_entries(oa.entries)
        let sb = sort_obj_entries(ob.entries)
        if sa.length() != sb.length() {
          return false
        }
        let mut i = sa.length() - 1
        while i >= 0 {
          let (ka, va) = sa[i]
          let (kb, vb) = sb[i]
          if ka != kb {
            return false
          }
          stack.push((va, vb))
          i = i - 1
        }
      }
      _ => return false
    }
  }
  true
}

///| Relational `<` with jq NaN semantics (`nan < nan` is `true`, `nan < x` is `true` for numbers).
fn jq_lt(a : JqVal, b : JqVal) -> Bool {
  if jq_is_nan_val(a) && jq_is_nan_val(b) {
    return true
  }
  jq_cmp(a, b) < 0
}

fn jq_le(a : JqVal, b : JqVal) -> Bool {
  if jq_is_nan_val(a) && jq_is_nan_val(b) {
    return true
  }
  jq_cmp(a, b) <= 0
}

fn jq_gt(a : JqVal, b : JqVal) -> Bool {
  if jq_is_nan_val(a) && jq_is_nan_val(b) {
    return false
  }
  jq_cmp(a, b) > 0
}

fn jq_ge(a : JqVal, b : JqVal) -> Bool {
  if jq_is_nan_val(a) && jq_is_nan_val(b) {
    return false
  }
  jq_cmp(a, b) >= 0
}

///| Count UTF-8 Unicode codepoints in `s`.
fn utf8_char_len(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  let mut count = 0
  while i < n {
    let b = s.code_unit_at(i)
    if (b & 0xC0) != 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

fn utf8_cp_to_byte(s : String, cp_idx : Int) -> Int {
  let n = s.length()
  if cp_idx <= 0 {
    return 0
  }
  let mut i = 0
  let mut count = 0
  while i < n {
    let b = s.code_unit_at(i)
    if (b & 0xC0) != 0x80 {
      if count == cp_idx {
        return i
      }
      count = count + 1
    }
    i = i + 1
  }
  n
}

fn utf8_byte_to_cp(s : String, byte_off : Int) -> Int {
  let n = if byte_off < s.length() { byte_off } else { s.length() }
  let mut i = 0
  let mut count = 0
  while i < n {
    let b = s.code_unit_at(i)
    if (b & 0xC0) != 0x80 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

fn utf8_explode(s : String) -> Array[Int] {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      out.push(b0)
      i = i + 1
    } else if (b0 & 0xE0) == 0xC0 && i + 1 < n {
      let b1 = s.code_unit_at(i + 1)
      out.push(((b0 & 0x1F) << 6) | (b1 & 0x3F))
      i = i + 2
    } else if (b0 & 0xF0) == 0xE0 && i + 2 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      out.push(((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F))
      i = i + 3
    } else if (b0 & 0xF8) == 0xF0 && i + 3 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      out.push(
        ((b0 & 0x07) << 18) |
        ((b1 & 0x3F) << 12) |
        ((b2 & 0x3F) << 6) |
        (b3 & 0x3F),
      )
      i = i + 4
    } else {
      out.push(0xFFFD)
      i = i + 1
    }
  }
  out
}

fn obj_set_entry_fast(obj : JqObj, key : String, v : JqVal) -> JqObj {
  let entries = obj.entries
  let n = entries.length()
  if n < 16 {
    let out : Array[(String, JqVal)] = []
    let mut found = false
    let mut i = 0
    while i < n {
      let (k, ev) = entries[i]
      if k == key {
        if !found {
          out.push((key, v))
          found = true
        }
      } else {
        out.push((k, ev))
      }
      i = i + 1
    }
    if !found {
      out.push((key, v))
    }
    return jq_obj_from_entries(out)
  }
  let hi = jq_obj_ensure_index(obj)
  let existing = hi.get(key)
  let out : Array[(String, JqVal)] = []
  let mut i = 0
  while i < n {
    out.push(entries[i])
    i = i + 1
  }
  if existing >= 0 {
    out[existing] = (key, v)
  } else {
    out.push((key, v))
  }
  jq_obj_from_entries(out)
}

fn obj_del_entry_fast(obj : JqObj, key : String) -> JqObj {
  let entries = obj.entries
  let out : Array[(String, JqVal)] = []
  let mut i = 0
  while i < entries.length() {
    let (k, ev) = entries[i]
    if k != key {
      out.push((k, ev))
    }
    i = i + 1
  }
  jq_obj_from_entries(out)
}

fn obj_merge_shallow(a : JqObj, b : JqObj) -> JqObj {
  let ea = a.entries
  let eb = b.entries
  let out : Array[(String, JqVal)] = []
  let hi = ObjHashIndex::new_for_count(ea.length() + eb.length())
  let mut i = 0
  while i < ea.length() {
    let (k, v) = ea[i]
    let existing = hi.get_or_insert(k, out.length())
    if existing >= 0 {
      out[existing] = (k, v)
    } else {
      out.push((k, v))
    }
    i = i + 1
  }
  i = 0
  while i < eb.length() {
    let (k, v) = eb[i]
    let existing = hi.get_or_insert(k, out.length())
    if existing >= 0 {
      out[existing] = (k, v)
    } else {
      out.push((k, v))
    }
    i = i + 1
  }
  JqObj::{ entries: out, index: Some(hi) }
}

fn obj_merge_deep(
  a : JqObj,
  b : JqObj,
  depth : Int,
  max_depth : Int,
) -> Result[JqObj, JqError] {
  if depth > max_depth {
    return Err(JqError::LimitExceeded("max recursion depth exceeded in object merge"))
  }
  let ea = a.entries
  let eb = b.entries
  let out : Array[(String, JqVal)] = []
  let hi = ObjHashIndex::new_for_count(ea.length() + eb.length())
  let mut i = 0
  while i < ea.length() {
    let (k, v) = ea[i]
    let existing = hi.get_or_insert(k, out.length())
    if existing >= 0 {
      out[existing] = (k, v)
    } else {
      out.push((k, v))
    }
    i = i + 1
  }
  i = 0
  while i < eb.length() {
    let (k, bv) = eb[i]
    let existing = hi.get_or_insert(k, out.length())
    if existing >= 0 {
      let (_, av) = out[existing]
      match (av, bv) {
        (JqVal::Object(ao), JqVal::Object(bo)) => {
          let merged = match obj_merge_deep(ao, bo, depth + 1, max_depth) {
            Ok(m) => m
            Err(e) => return Err(e)
          }
          out[existing] = (k, JqVal::Object(merged))
        }
        _ => out[existing] = (k, bv)
      }
    } else {
      out.push((k, bv))
    }
    i = i + 1
  }
  Ok(JqObj::{ entries: out, index: Some(hi) })
}

fn str_split_literal(s : String, sep : String) -> Array[JqVal] {
  let out : Array[JqVal] = []
  let n = s.length()
  let m = sep.length()
  if m == 0 {
    let cps = utf8_explode(s)
    let mut i = 0
    while i < cps.length() {
      let sb = StringBuilder::new()
      write_utf8_cp(sb, cps[i])
      out.push(JqVal::Str(sb.to_string()))
      i = i + 1
    }
    return out
  }
  let mut start = 0
  let mut i = 0
  let sep0 = sep.code_unit_at(0)
  while i + m <= n {
    if s.code_unit_at(i) == sep0 {
      let mut matched = true
      let mut k = 1
      while k < m {
        if s.code_unit_at(i + k) != sep.code_unit_at(k) {
          matched = false
          break
        }
        k = k + 1
      }
      if matched {
        out.push(JqVal::Str(s.slice(start, i)))
        i = i + m
        start = i
        continue
      }
    }
    i = i + 1
  }
  out.push(JqVal::Str(s.slice(start, n)))
  out
}

fn jq_add_i64(x : Int64, y : Int64) -> JqVal {
  let sum = x + y
  // Check signed overflow: same signs for x, y and opposite sign for sum
  if (x > 0L && y > 0L && sum < 0L) || (x < 0L && y < 0L && sum > 0L) {
    jq_int_from_decimal(bigint_add(x.to_string(), y.to_string()))
  } else {
    JqVal::Int(sum)
  }
}

fn jq_sub_i64(x : Int64, y : Int64) -> JqVal {
  let diff = x - y
  if (x >= 0L && y < 0L && diff < 0L) || (x < 0L && y > 0L && diff > 0L) {
    jq_int_from_decimal(bigint_sub(x.to_string(), y.to_string()))
  } else {
    JqVal::Int(diff)
  }
}

fn jq_mul_i64(x : Int64, y : Int64) -> JqVal {
  if x == 0L || y == 0L {
    return JqVal::Int(0L)
  }
  let prod = x * y
  if (x == -9223372036854775807L - 1L && y == -1L) || (prod / x != y) {
    jq_int_from_decimal(bigint_mul(x.to_string(), y.to_string()))
  } else {
    JqVal::Int(prod)
  }
}

fn jq_add(a : JqVal, b : JqVal, max_bytes : Int) -> Result[JqVal, JqError] {
  match (a, b) {
    (JqVal::Null, x) => Ok(x)
    (x, JqVal::Null) => Ok(x)
    (JqVal::Int(x), JqVal::Int(y)) => Ok(jq_add_i64(x, y))
    (JqVal::BigInt(x), JqVal::BigInt(y)) => Ok(jq_int_from_decimal(bigint_add(x, y)))
    (JqVal::Int(x), JqVal::BigInt(y)) => Ok(jq_int_from_decimal(bigint_add(x.to_string(), y)))
    (JqVal::BigInt(x), JqVal::Int(y)) => Ok(jq_int_from_decimal(bigint_add(x, y.to_string())))
    (JqVal::Str(x), JqVal::Str(y)) => {
      if x.length() + y.length() > max_bytes {
        return Err(JqError::LimitExceeded("string concatenation exceeds max_output_bytes"))
      }
      Ok(JqVal::Str(x + y))
    }
    (JqVal::Array(xa), JqVal::Array(xb)) => {
      if xa.length() + xb.length() > max_bytes {
        return Err(JqError::LimitExceeded("array concatenation exceeds max_output_bytes"))
      }
      let out : Array[JqVal] = []
      let mut i = 0
      while i < xa.length() {
        out.push(xa[i])
        i = i + 1
      }
      i = 0
      while i < xb.length() {
        out.push(xb[i])
        i = i + 1
      }
      Ok(JqVal::Array(out))
    }
    (JqVal::Object(oa), JqVal::Object(ob)) =>
    Ok(JqVal::Object(obj_merge_shallow(oa, ob)))
    _ =>
    if is_jq_num(a) && is_jq_num(b) {
      let dx = match jq_val_to_double(a) { Some(v) => v None => 0.0 }
      let dy = match jq_val_to_double(b) { Some(v) => v None => 0.0 }
      Ok(JqVal::Float(dx + dy))
    } else {
      Err(
        JqError::RuntimeError(
          jq_type_name(a) + " and " + jq_type_name(b) + " cannot be added",
        ),
      )
    }
  }
}

fn jq_sub(a : JqVal, b : JqVal) -> Result[JqVal, JqError] {
  match (a, b) {
    (JqVal::Int(x), JqVal::Int(y)) => Ok(jq_sub_i64(x, y))
    (JqVal::BigInt(x), JqVal::BigInt(y)) => Ok(jq_int_from_decimal(bigint_sub(x, y)))
    (JqVal::Int(x), JqVal::BigInt(y)) => Ok(jq_int_from_decimal(bigint_sub(x.to_string(), y)))
    (JqVal::BigInt(x), JqVal::Int(y)) => Ok(jq_int_from_decimal(bigint_sub(x, y.to_string())))
    (JqVal::Array(xa), JqVal::Array(xb)) => {
      let out : Array[JqVal] = []
      let mut i = 0
      while i < xa.length() {
        let mut drop = false
        let mut j = 0
        while j < xb.length() {
          if jq_eq(xa[i], xb[j]) {
            drop = true
            break
          }
          j = j + 1
        }
        if !drop {
          out.push(xa[i])
        }
        i = i + 1
      }
      Ok(JqVal::Array(out))
    }
    _ =>
    if is_jq_num(a) && is_jq_num(b) {
      let dx = match jq_val_to_double(a) { Some(v) => v None => 0.0 }
      let dy = match jq_val_to_double(b) { Some(v) => v None => 0.0 }
      Ok(JqVal::Float(dx - dy))
    } else {
      Err(
        JqError::RuntimeError(
          jq_type_name(a) + " and " + jq_type_name(b) + " cannot be subtracted",
        ),
      )
    }
  }
}

fn jq_str_repeat(s : String, times : Double, max_bytes : Int) -> Result[JqVal, JqError] {
  if is_nan_f64(times) || times < 0.0 {
    return Ok(JqVal::Null)
  }
  if is_inf_f64(times) {
    return Err(JqError::LimitExceeded("string repetition exceeds max_output_bytes"))
  }
  let n_f = f64_floor(times)
  if n_f <= 0.0 {
    // 0 <= times < 1 (e.g., "ab" * 0 -> "", "ab" * 0.5 -> "" in jq 1.7.1 & gojq)
    return Ok(JqVal::Str(""))
  }
  if s.length() == 0 {
    return Ok(JqVal::Str(""))
  }
  if n_f > max_bytes.to_double() {
    return Err(JqError::LimitExceeded("string repetition exceeds max_output_bytes"))
  }
  let count = n_f.to_int64().to_int()
  if count > max_bytes / s.length() {
    return Err(JqError::LimitExceeded("string repetition exceeds max_output_bytes"))
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < count {
    sb.write_string(s)
    i = i + 1
  }
  Ok(JqVal::Str(sb.to_string()))
}

fn jq_mul(a : JqVal, b : JqVal, limits : JqLimits) -> Result[JqVal, JqError] {
  match (a, b) {
    (JqVal::Int(x), JqVal::Int(y)) => Ok(jq_mul_i64(x, y))
    (JqVal::BigInt(x), JqVal::BigInt(y)) => Ok(jq_int_from_decimal(bigint_mul(x, y)))
    (JqVal::Int(x), JqVal::BigInt(y)) => Ok(jq_int_from_decimal(bigint_mul(x.to_string(), y)))
    (JqVal::BigInt(x), JqVal::Int(y)) => Ok(jq_int_from_decimal(bigint_mul(x, y.to_string())))
    (JqVal::Object(oa), JqVal::Object(ob)) =>
    match obj_merge_deep(oa, ob, 0, limits.max_depth) {
      Ok(m) => Ok(JqVal::Object(m))
      Err(e) => Err(e)
    }
    _ =>
    if is_jq_num(a) && is_jq_num(b) {
      let dx = match jq_val_to_double(a) { Some(v) => v None => 0.0 }
      let dy = match jq_val_to_double(b) { Some(v) => v None => 0.0 }
      Ok(JqVal::Float(dx * dy))
    } else {
      match a {
        JqVal::Str(s) =>
        if is_jq_num(b) {
          let d = match jq_val_to_double(b) { Some(v) => v None => -1.0 }
          jq_str_repeat(s, d, limits.max_output_bytes)
        } else {
          Err(JqError::RuntimeError(jq_type_name(a) + " and " + jq_type_name(b) + " cannot be multiplied"))
        }
        _ =>
        match b {
          JqVal::Str(s) =>
          if is_jq_num(a) {
            let d = match jq_val_to_double(a) { Some(v) => v None => -1.0 }
            jq_str_repeat(s, d, limits.max_output_bytes)
          } else {
            Err(JqError::RuntimeError(jq_type_name(a) + " and " + jq_type_name(b) + " cannot be multiplied"))
          }
          _ => Err(JqError::RuntimeError(jq_type_name(a) + " and " + jq_type_name(b) + " cannot be multiplied"))
        }
      }
    }
  }
}

fn jq_div(a : JqVal, b : JqVal) -> Result[JqVal, JqError] {
  if is_jq_num(a) && is_jq_num(b) {
    let dx = match jq_val_to_double(a) { Some(v) => v None => 0.0 }
    let dy = match jq_val_to_double(b) { Some(v) => v None => 0.0 }
    if dy == 0.0 {
      return Err(JqError::RuntimeError("number cannot be divided by zero"))
    }
    return Ok(JqVal::Float(dx / dy))
  }
  match (a, b) {
    (JqVal::Str(s), JqVal::Str(sep)) =>
    Ok(JqVal::Array(str_split_literal(s, sep)))
    _ =>
    Err(
      JqError::RuntimeError(
        jq_type_name(a) + " and " + jq_type_name(b) + " cannot be divided",
      ),
    )
  }
}

fn jq_mod(a : JqVal, b : JqVal) -> Result[JqVal, JqError] {
  match (a, b) {
    (JqVal::Int(x), JqVal::Int(y)) => {
      if y == 0L {
        return Err(JqError::RuntimeError("number cannot be divided (remainder) by zero"))
      }
      if x == -9223372036854775807L - 1L && y == -1L {
        return Ok(JqVal::Int(0L))
      }
      Ok(JqVal::Int(x % y))
    }
    (JqVal::BigInt(x), JqVal::BigInt(y)) => {
      if y == "0" {
        return Err(JqError::RuntimeError("number cannot be divided (remainder) by zero"))
      }
      Ok(jq_int_from_decimal(bigint_rem(x, y)))
    }
    (JqVal::Int(x), JqVal::BigInt(y)) => {
      if y == "0" {
        return Err(JqError::RuntimeError("number cannot be divided (remainder) by zero"))
      }
      Ok(jq_int_from_decimal(bigint_rem(x.to_string(), y)))
    }
    (JqVal::BigInt(x), JqVal::Int(y)) => {
      if y == 0L {
        return Err(JqError::RuntimeError("number cannot be divided (remainder) by zero"))
      }
      Ok(jq_int_from_decimal(bigint_rem(x, y.to_string())))
    }
    _ =>
    if is_jq_num(a) && is_jq_num(b) {
      let x = match jq_val_to_double(a) { Some(v) => v None => 0.0 }
      let y = match jq_val_to_double(b) { Some(v) => v None => 0.0 }
      if is_nan_f64(x) || is_nan_f64(y) {
        return Ok(JqVal::Float(0.0 / 0.0))
      }
      let yi = f64_trunc(y)
      if yi == 0.0 {
        return Err(JqError::RuntimeError("number cannot be divided (remainder) by zero"))
      }
      let xi = f64_trunc(x)
      // Use exact Int64 remainder whenever both operands fit in Int64 (fixes `1e17 % 7 == 5`)
      if is_finite_f64(xi) && is_finite_f64(yi) &&
      xi >= -9223372036854775808.0 && xi < 9223372036854775808.0 &&
      yi >= -9223372036854775808.0 && yi < 9223372036854775808.0 {
        let ix = xi.to_int64()
        let iy = yi.to_int64()
        if iy == 0L {
          return Err(JqError::RuntimeError("number cannot be divided (remainder) by zero"))
        }
        if ix == -9223372036854775807L - 1L && iy == -1L {
          return Ok(JqVal::Int(0L))
        }
        return Ok(JqVal::Int(ix % iy))
      }
      let q = f64_trunc(xi / yi)
      Ok(JqVal::Float(xi - q * yi))
    } else {
      Err(
        JqError::RuntimeError(
          jq_type_name(a) + " and " + jq_type_name(b) + " cannot be divided (remainder)",
        ),
      )
    }
  }
}

fn jq_index_field(target : JqVal, key : String) -> Result[JqVal, JqError] {
  match target {
    JqVal::Null => Ok(JqVal::Null)
    JqVal::Object(obj) =>
    match jq_obj_get(obj, key) {
      Some(v) => Ok(v)
      None => Ok(JqVal::Null)
    }
    JqVal::Array(_) => Err(JqError::RuntimeError("cannot index array with string"))
    _ => Err(JqError::RuntimeError("cannot index " + jq_type_name(target)))
  }
}

fn jq_index_val(target : JqVal, idx : JqVal) -> Result[JqVal, JqError] {
  match target {
    JqVal::Null => Ok(JqVal::Null)
    JqVal::Object(obj) =>
    match idx {
      JqVal::Str(k) =>
      match jq_obj_get(obj, k) {
        Some(v) => Ok(v)
        None => Ok(JqVal::Null)
      }
      _ => Err(JqError::RuntimeError("cannot index object with " + jq_type_name(idx)))
    }
    JqVal::Array(items) =>
    match idx {
      JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => {
        if jq_is_nan_val(idx) {
          return Ok(JqVal::Null)
        }
        match jq_val_to_int_index(idx) {
          Some(raw_i) => {
            let i = if raw_i < 0 { items.length() + raw_i } else { raw_i }
            if i >= 0 && i < items.length() {
              Ok(items[i])
            } else {
              Ok(JqVal::Null)
            }
          }
          None => Ok(JqVal::Null)
        }
      }
      JqVal::Array(_) =>
      // Array indexed by array: `.[[1]]` returns indices of sub-array (P2-5)
      match jq_indices(target, idx) {
        Ok(arr) => Ok(JqVal::Array(arr))
        Err(e) => Err(e)
      }
      _ => Err(JqError::RuntimeError("cannot index array with " + jq_type_name(idx)))
    }
    _ => Err(JqError::RuntimeError("cannot index " + jq_type_name(target)))
  }
}

///| Clamp a signed 32-bit slice index into `[0, len]` with jq negative-offset semantics.
#verify
pub fn clamp_slice_idx(idx : Int, len : Int) -> Int {
  let mut i = idx
  if i < 0 {
    i = len + i
  }
  if i < 0 {
    i = 0
  }
  if i > len {
    i = len
  }
  i
}

///| Clamp a signed 64-bit integer slice index into `[0, len]` without 32-bit overflow.
#verify
pub fn clamp_slice_i64(i : Int64, len : Int) -> Int {
  if i < -2147483648L {
    0
  } else if i > 2147483647L {
    len
  } else {
    clamp_slice_idx(i.to_int(), len)
  }
}

fn normalize_slice_bound(raw : Option[JqVal], len : Int, is_start : Bool) -> Result[Int, JqError] {
  match raw {
    None => Ok(if is_start { 0 } else { len })
    Some(JqVal::Null) => Ok(if is_start { 0 } else { len })
    Some(JqVal::Int(i)) => Ok(clamp_slice_i64(i, len))
    Some(JqVal::Float(x)) => {
      if is_nan_f64(x) {
        return Ok(if is_start { 0 } else { len })
      }
      let f = if is_start { f64_floor(x) } else { f64_ceil(x) }
      if f < -2147483648.0 {
        Ok(0)
      } else if f > 2147483647.0 {
        Ok(len)
      } else {
        Ok(clamp_slice_idx(f.to_int64().to_int(), len))
      }
    }
    Some(JqVal::BigInt(s)) => {
      if bigint_is_neg(s) { Ok(0) } else { Ok(len) }
    }
    Some(other) =>
    Err(JqError::RuntimeError("slice index must be number, got " + jq_type_name(other)))
  }
}

fn jq_slice_val(
  target : JqVal,
  start_v : Option[JqVal],
  end_v : Option[JqVal],
) -> Result[JqVal, JqError] {
  match target {
    JqVal::Null => Ok(JqVal::Null)
    JqVal::Array(items) => {
      let n = items.length()
      let s = match normalize_slice_bound(start_v, n, true) {
        Ok(i) => i
        Err(e) => return Err(e)
      }
      let e = match normalize_slice_bound(end_v, n, false) {
        Ok(i) => i
        Err(e) => return Err(e)
      }
      let out : Array[JqVal] = []
      let mut i = s
      while i < e {
        out.push(items[i])
        i = i + 1
      }
      Ok(JqVal::Array(out))
    }
    JqVal::Str(str) => {
      let n = utf8_char_len(str)
      let s = match normalize_slice_bound(start_v, n, true) {
        Ok(i) => i
        Err(e) => return Err(e)
      }
      let e = match normalize_slice_bound(end_v, n, false) {
        Ok(i) => i
        Err(e) => return Err(e)
      }
      if s >= e {
        return Ok(JqVal::Str(""))
      }
      let bs = utf8_cp_to_byte(str, s)
      let be = utf8_cp_to_byte(str, e)
      Ok(JqVal::Str(str.slice(bs, be)))
    }
    _ => Err(JqError::RuntimeError("cannot slice " + jq_type_name(target)))
  }
}

fn is_slice_seg(seg : JqVal) -> Option[(Option[JqVal], Option[JqVal])] {
  match seg {
    JqVal::Object(obj) => {
      let s = jq_obj_get(obj, "start")
      let e = jq_obj_get(obj, "end")
      match (s, e) {
        (None, None) => None
        _ => Some((s, e))
      }
    }
    _ => None
  }
}

fn jq_getpath(root : JqVal, path : Array[JqVal]) -> Result[JqVal, JqError] {
  let mut cur = root
  let mut i = 0
  while i < path.length() {
    match is_slice_seg(path[i]) {
      Some((sv, ev)) =>
      cur = match jq_slice_val(cur, sv, ev) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      None =>
      cur = match jq_index_val(cur, path[i]) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
    }
    i = i + 1
  }
  Ok(cur)
}

fn jq_setpath(
  root : JqVal,
  path : Array[JqVal],
  idx : Int,
  new_val : JqVal,
  max_bytes : Int,
) -> Result[JqVal, JqError] {
  if idx >= path.length() {
    return Ok(new_val)
  }
  let seg = path[idx]
  match is_slice_seg(seg) {
    Some((sv, ev)) => {
      if idx + 1 != path.length() {
        return Err(JqError::RuntimeError("cannot update nested path inside slice"))
      }
      let replacement = match new_val {
        JqVal::Array(xs) => xs
        _ => return Err(JqError::RuntimeError("a slice of an array can only be assigned another array"))
      }
      match root {
        JqVal::Null => return Ok(JqVal::Array(replacement))
        JqVal::Array(items) => {
          let n = items.length()
          let s = match normalize_slice_bound(sv, n, true) {
            Ok(k) => k
            Err(e) => return Err(e)
          }
          let e = match normalize_slice_bound(ev, n, false) {
            Ok(k) => k
            Err(e) => return Err(e)
          }
          let e2 = if e < s { s } else { e }
          let out : Array[JqVal] = []
          let mut k = 0
          while k < s {
            out.push(items[k])
            k = k + 1
          }
          k = 0
          while k < replacement.length() {
            out.push(replacement[k])
            k = k + 1
          }
          k = e2
          while k < n {
            out.push(items[k])
            k = k + 1
          }
          return Ok(JqVal::Array(out))
        }
        _ => return Err(JqError::RuntimeError("cannot slice " + jq_type_name(root)))
      }
    }
    None => ()
  }
  match seg {
    JqVal::Str(key) =>
    match root {
      JqVal::Null => {
        let sub = match jq_setpath(JqVal::Null, path, idx + 1, new_val, max_bytes) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        Ok(JqVal::Object(jq_obj_from_entries([(key, sub)])))
      }
      JqVal::Object(obj) => {
        let cur_child = match jq_obj_get(obj, key) {
          Some(v) => v
          None => JqVal::Null
        }
        let sub = match jq_setpath(cur_child, path, idx + 1, new_val, max_bytes) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        Ok(JqVal::Object(obj_set_entry_fast(obj, key, sub)))
      }
      _ => Err(JqError::RuntimeError("cannot index " + jq_type_name(root) + " with string"))
    }
    JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => {
      let raw_i = match jq_val_to_int_index(seg) {
        Some(n) => n
        None => return Err(JqError::RuntimeError("invalid array index in setpath"))
      }
      match root {
        JqVal::Null => {
          if raw_i < 0 {
            return Err(JqError::RuntimeError("out of bounds negative array index"))
          }
          if raw_i > max_bytes {
            return Err(JqError::LimitExceeded("array allocation in setpath exceeds max_output_bytes"))
          }
          let sub = match jq_setpath(JqVal::Null, path, idx + 1, new_val, max_bytes) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          let out : Array[JqVal] = []
          let mut k = 0
          while k < raw_i {
            out.push(JqVal::Null)
            k = k + 1
          }
          out.push(sub)
          Ok(JqVal::Array(out))
        }
        JqVal::Array(items) => {
          let i = if raw_i < 0 { items.length() + raw_i } else { raw_i }
          if i < 0 {
            return Err(JqError::RuntimeError("out of bounds negative array index"))
          }
          if i > max_bytes {
            return Err(JqError::LimitExceeded("array allocation in setpath exceeds max_output_bytes"))
          }
          let cur_child = if i < items.length() { items[i] } else { JqVal::Null }
          let sub = match jq_setpath(cur_child, path, idx + 1, new_val, max_bytes) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          let out : Array[JqVal] = []
          let new_len = if i >= items.length() { i + 1 } else { items.length() }
          let mut k = 0
          while k < new_len {
            if k == i {
              out.push(sub)
            } else if k < items.length() {
              out.push(items[k])
            } else {
              out.push(JqVal::Null)
            }
            k = k + 1
          }
          Ok(JqVal::Array(out))
        }
        _ => Err(JqError::RuntimeError("cannot index " + jq_type_name(root) + " with number"))
      }
    }
    _ => Err(JqError::RuntimeError("invalid path segment type: " + jq_type_name(seg)))
  }
}

fn jq_delpath_one(
  root : JqVal,
  path : Array[JqVal],
  idx : Int,
) -> Result[JqVal, JqError] {
  if idx >= path.length() {
    return Ok(JqVal::Null)
  }
  let seg = path[idx]
  let is_last = idx + 1 == path.length()
  match is_slice_seg(seg) {
    Some((sv, ev)) => {
      if !is_last {
        return Err(JqError::RuntimeError("cannot delete nested path inside slice"))
      }
      match root {
        JqVal::Null => return Ok(JqVal::Null)
        JqVal::Array(items) => {
          let n = items.length()
          let s = match normalize_slice_bound(sv, n, true) {
            Ok(k) => k
            Err(e) => return Err(e)
          }
          let e = match normalize_slice_bound(ev, n, false) {
            Ok(k) => k
            Err(e) => return Err(e)
          }
          let e2 = if e < s { s } else { e }
          let out : Array[JqVal] = []
          let mut k = 0
          while k < s {
            out.push(items[k])
            k = k + 1
          }
          k = e2
          while k < n {
            out.push(items[k])
            k = k + 1
          }
          return Ok(JqVal::Array(out))
        }
        _ => return Err(JqError::RuntimeError("cannot delete slice from " + jq_type_name(root)))
      }
    }
    None => ()
  }
  match seg {
    JqVal::Str(key) =>
    match root {
      JqVal::Null => Ok(JqVal::Null)
      JqVal::Object(obj) => {
        if is_last {
          Ok(JqVal::Object(obj_del_entry_fast(obj, key)))
        } else {
          match jq_obj_get(obj, key) {
            None => Ok(root)
            Some(child) => {
              let sub = match jq_delpath_one(child, path, idx + 1) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              Ok(JqVal::Object(obj_set_entry_fast(obj, key, sub)))
            }
          }
        }
      }
      _ => Err(JqError::RuntimeError("cannot delete string field from " + jq_type_name(root)))
    }
    JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => {
      let raw_i = match jq_val_to_int_index(seg) {
        Some(n) => n
        None => return Ok(root)
      }
      match root {
        JqVal::Null => Ok(JqVal::Null)
        JqVal::Array(items) => {
          let i = if raw_i < 0 { items.length() + raw_i } else { raw_i }
          if i < 0 || i >= items.length() {
            return Ok(root)
          }
          if is_last {
            let out : Array[JqVal] = []
            let mut k = 0
            while k < items.length() {
              if k != i {
                out.push(items[k])
              }
              k = k + 1
            }
            Ok(JqVal::Array(out))
          } else {
            let sub = match jq_delpath_one(items[i], path, idx + 1) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            let out : Array[JqVal] = []
            let mut k = 0
            while k < items.length() {
              if k == i {
                out.push(sub)
              } else {
                out.push(items[k])
              }
              k = k + 1
            }
            Ok(JqVal::Array(out))
          }
        }
        _ => Err(JqError::RuntimeError("cannot delete index from " + jq_type_name(root)))
      }
    }
    _ => Err(JqError::RuntimeError("invalid path segment in delpaths"))
  }
}

///| O(n) batched path deletion for flat array/object deletions, falling back to
///| sorted reverse deletion for complex nested/slice paths.
fn jq_delpaths(root : JqVal, paths : Array[Array[JqVal]]) -> Result[JqVal, JqError] {
  let n = paths.length()
  if n == 0 {
    return Ok(root)
  }
  // Fast O(n) path when all paths are depth-1 indices on an Array or keys on an Object
  match root {
    JqVal::Array(items) => {
      let mut all_flat_idx = true
      let mut i = 0
      while i < n {
        if paths[i].length() != 1 {
          all_flat_idx = false
          break
        }
        match paths[i][0] {
          JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => ()
          _ => {
            all_flat_idx = false
            break
          }
        }
        i = i + 1
      }
      if all_flat_idx {
        let len = items.length()
        let del_mask = FixedArray::make(len, false)
        i = 0
        while i < n {
          match jq_val_to_int_index(paths[i][0]) {
            Some(raw_i) => {
              let idx = if raw_i < 0 { len + raw_i } else { raw_i }
              if idx >= 0 && idx < len {
                del_mask[idx] = true
              }
            }
            None => ()
          }
          i = i + 1
        }
        let out : Array[JqVal] = []
        i = 0
        while i < len {
          if !del_mask[i] {
            out.push(items[i])
          }
          i = i + 1
        }
        return Ok(JqVal::Array(out))
      }
    }
    JqVal::Object(obj) => {
      let mut all_flat_key = true
      let mut i = 0
      while i < n {
        if paths[i].length() != 1 {
          all_flat_key = false
          break
        }
        match paths[i][0] {
          JqVal::Str(_) => ()
          _ => {
            all_flat_key = false
            break
          }
        }
        i = i + 1
      }
      if all_flat_key {
        let del_set = ObjHashIndex::new(if n * 2 < 16 { 16 } else { n * 2 })
        i = 0
        while i < n {
          match paths[i][0] {
            JqVal::Str(k) => {
              let _ = del_set.upsert(k, 1)
            }
            _ => ()
          }
          i = i + 1
        }
        let out : Array[(String, JqVal)] = []
        let es = obj.entries
        i = 0
        while i < es.length() {
          let (k, v) = es[i]
          if del_set.get(k) < 0 {
            out.push((k, v))
          }
          i = i + 1
        }
        return Ok(JqVal::Object(jq_obj_from_entries(out)))
      }
    }
    _ => ()
  }
  // General path deletion: sort in reverse jq order
  let wrapped : Array[JqVal] = []
  let mut i = 0
  while i < n {
    wrapped.push(JqVal::Array(paths[i]))
    i = i + 1
  }
  let sorted = sort_values(wrapped)
  let mut cur = root
  let mut j = sorted.length() - 1
  while j >= 0 {
    if j + 1 < sorted.length() && jq_eq(sorted[j], sorted[j + 1]) {
      j = j - 1
      continue
    }
    match sorted[j] {
      JqVal::Array(p) => {
        if p.length() == 0 {
          return Ok(JqVal::Null)
        }
        cur = match jq_delpath_one(cur, p, 0) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
      }
      _ => ()
    }
    j = j - 1
  }
  Ok(cur)
}

///| O(n) batched setpath for flat index/key updates (e.g. `.[range(length)] = 1`, `.[] = v`).
fn jq_batch_setpaths(
  root : JqVal,
  updates : Array[(Array[JqVal], JqVal)],
  max_bytes : Int,
) -> Result[JqVal, JqError] {
  let n = updates.length()
  if n == 0 {
    return Ok(root)
  }
  // Fast O(n) path for flat depth-1 array index updates
  match root {
    JqVal::Array(items) => {
      let mut all_flat = true
      let mut max_idx = items.length() - 1
      let mut i = 0
      while i < n {
        let (p, _) = updates[i]
        if p.length() != 1 {
          all_flat = false
          break
        }
        match p[0] {
          JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) =>
          match jq_val_to_int_index(p[0]) {
            Some(raw_i) => {
              let idx = if raw_i < 0 { items.length() + raw_i } else { raw_i }
              if idx < 0 {
                return Err(JqError::RuntimeError("out of bounds negative array index"))
              }
              if idx > max_bytes {
                return Err(JqError::LimitExceeded("array allocation in setpath exceeds max_output_bytes"))
              }
              if idx > max_idx {
                max_idx = idx
              }
            }
            None => {
              all_flat = false
              break
            }
          }
          _ => {
            all_flat = false
            break
          }
        }
        i = i + 1
      }
      if all_flat {
        let out : Array[JqVal] = []
        let new_len = max_idx + 1
        i = 0
        while i < items.length() {
          out.push(items[i])
          i = i + 1
        }
        while out.length() < new_len {
          out.push(JqVal::Null)
        }
        i = 0
        while i < n {
          let (p, v) = updates[i]
          match jq_val_to_int_index(p[0]) {
            Some(raw_i) => {
              let idx = if raw_i < 0 { items.length() + raw_i } else { raw_i }
              out[idx] = v
            }
            None => ()
          }
          i = i + 1
        }
        return Ok(JqVal::Array(out))
      }
    }
    JqVal::Object(obj) => {
      let mut all_flat = true
      let mut i = 0
      while i < n {
        let (p, _) = updates[i]
        if p.length() != 1 {
          all_flat = false
          break
        }
        match p[0] {
          JqVal::Str(_) => ()
          _ => {
            all_flat = false
            break
          }
        }
        i = i + 1
      }
      if all_flat {
        let es = obj.entries
        let out : Array[(String, JqVal)] = []
        let hi = ObjHashIndex::new_for_count(es.length() + n)
        i = 0
        while i < es.length() {
          let (k, v) = es[i]
          let existing = hi.get_or_insert(k, out.length())
          if existing >= 0 {
            out[existing] = (k, v)
          } else {
            out.push((k, v))
          }
          i = i + 1
        }
        i = 0
        while i < n {
          let (p, v) = updates[i]
          match p[0] {
            JqVal::Str(k) => {
              let existing = hi.get_or_insert(k, out.length())
              if existing >= 0 {
                out[existing] = (k, v)
              } else {
                out.push((k, v))
              }
            }
            _ => ()
          }
          i = i + 1
        }
        return Ok(JqVal::Object(JqObj::{ entries: out, index: Some(hi) }))
      }
    }
    _ => ()
  }
  // General fallback
  let mut cur = root
  let mut i = 0
  while i < n {
    let (p, v) = updates[i]
    cur = match jq_setpath(cur, p, 0, v, max_bytes) {
      Ok(nv) => nv
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  Ok(cur)
}

///| Stable bottom-up mergesort of `Array[JqVal]` using a single scratch buffer.
fn sort_values(arr : Array[JqVal]) -> Array[JqVal] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  let mut src = FixedArray::make(n, arr[0])
  let mut i = 1
  while i < n {
    src[i] = arr[i]
    i = i + 1
  }
  // Insertion sort on runs of size 16
  let run = 16
  let mut start = 0
  while start < n {
    let end = if start + run < n { start + run } else { n }
    let mut k = start + 1
    while k < end {
      let cur = src[k]
      let mut j = k - 1
      while j >= start && jq_cmp(src[j], cur) > 0 {
        src[j + 1] = src[j]
        j = j - 1
      }
      src[j + 1] = cur
      k = k + 1
    }
    start = end
  }
  if n <= run {
    let out : Array[JqVal] = []
    i = 0
    while i < n {
      out.push(src[i])
      i = i + 1
    }
    return out
  }
  let mut dst = FixedArray::make(n, src[0])
  let mut width = run
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut li = left
      let mut ri = mid
      let mut out_i = left
      while li < mid && ri < right {
        if jq_cmp(src[li], src[ri]) <= 0 {
          dst[out_i] = src[li]
          li = li + 1
        } else {
          dst[out_i] = src[ri]
          ri = ri + 1
        }
        out_i = out_i + 1
      }
      while li < mid {
        dst[out_i] = src[li]
        li = li + 1
        out_i = out_i + 1
      }
      while ri < right {
        dst[out_i] = src[ri]
        ri = ri + 1
        out_i = out_i + 1
      }
      left = right
    }
    let tmp = src
    src = dst
    dst = tmp
    width = width * 2
  }
  let out : Array[JqVal] = []
  i = 0
  while i < n {
    out.push(src[i])
    i = i + 1
  }
  out
}

///| Stable bottom-up mergesort of `(key, value)` pairs by key using a single scratch buffer.
fn sort_keyed_values(arr : Array[(JqVal, JqVal)]) -> Array[(JqVal, JqVal)] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  let mut src = FixedArray::make(n, arr[0])
  let mut i = 1
  while i < n {
    src[i] = arr[i]
    i = i + 1
  }
  let run = 16
  let mut start = 0
  while start < n {
    let end = if start + run < n { start + run } else { n }
    let mut k = start + 1
    while k < end {
      let cur = src[k]
      let (cur_k, _) = cur
      let mut j = k - 1
      while j >= start {
        let (jk, _) = src[j]
        if jq_cmp(jk, cur_k) > 0 {
          src[j + 1] = src[j]
          j = j - 1
        } else {
          break
        }
      }
      src[j + 1] = cur
      k = k + 1
    }
    start = end
  }
  if n <= run {
    let out : Array[(JqVal, JqVal)] = []
    i = 0
    while i < n {
      out.push(src[i])
      i = i + 1
    }
    return out
  }
  let mut dst = FixedArray::make(n, src[0])
  let mut width = run
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut li = left
      let mut ri = mid
      let mut out_i = left
      while li < mid && ri < right {
        let (lk, _) = src[li]
        let (rk, _) = src[ri]
        if jq_cmp(lk, rk) <= 0 {
          dst[out_i] = src[li]
          li = li + 1
        } else {
          dst[out_i] = src[ri]
          ri = ri + 1
        }
        out_i = out_i + 1
      }
      while li < mid {
        dst[out_i] = src[li]
        li = li + 1
        out_i = out_i + 1
      }
      while ri < right {
        dst[out_i] = src[ri]
        ri = ri + 1
        out_i = out_i + 1
      }
      left = right
    }
    let tmp = src
    src = dst
    dst = tmp
    width = width * 2
  }
  let out : Array[(JqVal, JqVal)] = []
  i = 0
  while i < n {
    out.push(src[i])
    i = i + 1
  }
  out
}

///| Sort `(key_str, group_items)` buckets by string key (used by `group_by` string fast path).
fn sort_string_groups(arr : Array[(String, Array[JqVal])]) -> Array[(String, Array[JqVal])] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  let mut src = FixedArray::make(n, arr[0])
  let mut i = 1
  while i < n {
    src[i] = arr[i]
    i = i + 1
  }
  let run = 16
  let mut start = 0
  while start < n {
    let end = if start + run < n { start + run } else { n }
    let mut k = start + 1
    while k < end {
      let cur = src[k]
      let (cur_k, _) = cur
      let mut j = k - 1
      while j >= start {
        let (jk, _) = src[j]
        if cmp_str(jk, cur_k) > 0 {
          src[j + 1] = src[j]
          j = j - 1
        } else {
          break
        }
      }
      src[j + 1] = cur
      k = k + 1
    }
    start = end
  }
  if n <= run {
    let out : Array[(String, Array[JqVal])] = []
    i = 0
    while i < n {
      out.push(src[i])
      i = i + 1
    }
    return out
  }
  let mut dst = FixedArray::make(n, src[0])
  let mut width = run
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut li = left
      let mut ri = mid
      let mut out_i = left
      while li < mid && ri < right {
        let (lk, _) = src[li]
        let (rk, _) = src[ri]
        if cmp_str(lk, rk) <= 0 {
          dst[out_i] = src[li]
          li = li + 1
        } else {
          dst[out_i] = src[ri]
          ri = ri + 1
        }
        out_i = out_i + 1
      }
      while li < mid {
        dst[out_i] = src[li]
        li = li + 1
        out_i = out_i + 1
      }
      while ri < right {
        dst[out_i] = src[ri]
        ri = ri + 1
        out_i = out_i + 1
      }
      left = right
    }
    let tmp = src
    src = dst
    dst = tmp
    width = width * 2
  }
  let out : Array[(String, Array[JqVal])] = []
  i = 0
  while i < n {
    out.push(src[i])
    i = i + 1
  }
  out
}

// ---------------------------------------------------------------------------
// Iterative JSON Serializer with `max_output_bytes` enforcement (P0-6, P0-8)
// ---------------------------------------------------------------------------

enum SerFrame {
  Arr(Array[JqVal], Int)
  Obj(Array[(String, JqVal)], Int)
}

fn write_json_escaped_str_bounded(
  sb : StringBuilder,
  s : String,
  max_bytes : Int,
) -> Result[Unit, JqError] {
  sb.write_byte(34.to_byte())
  let n = s.length()
  if sb.length() + n + 1 > max_bytes {
    return Err(JqError::LimitExceeded("serialized JSON exceeds max_output_bytes"))
  }
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 {
      sb.write_string("\\\"")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 8 {
      sb.write_string("\\b")
    } else if b == 12 {
      sb.write_string("\\f")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 9 {
      sb.write_string("\\t")
    } else if b < 0x20 {
      sb.write_string("\\u00")
      let hi = (b >> 4) & 0xF
      let lo = b & 0xF
      sb.write_byte((if hi < 10 { 48 + hi } else { 87 + hi }).to_byte())
      sb.write_byte((if lo < 10 { 48 + lo } else { 87 + lo }).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    if sb.length() > max_bytes {
      return Err(JqError::LimitExceeded("serialized JSON exceeds max_output_bytes"))
    }
    i = i + 1
  }
  sb.write_byte(34.to_byte())
  if sb.length() > max_bytes {
    return Err(JqError::LimitExceeded("serialized JSON exceeds max_output_bytes"))
  }
  Ok(())
}

fn format_jq_float(x : Double) -> String {
  if is_nan_f64(x) {
    "null"
  } else if x == 1.0 / 0.0 {
    "1.7976931348623157e+308"
  } else if x == -1.0 / 0.0 {
    "-1.7976931348623157e+308"
  } else if x == 0.0 {
    // Normalize both +0.0 and -0.0 to "0" (matches gojq; avoids "-0.0")
    "0"
  } else {
    match json5::to_json_string(json5::Json5Value::Number(x)) {
      Ok(s) => s
      Err(_) => "null"
    }
  }
}

///| Iteratively serialize `JqVal` to compact JSON, enforcing `max_bytes`.
fn serialize_jq_val(
  root : JqVal,
  sorted_keys : Bool,
  max_bytes : Int,
) -> Result[String, JqError] {
  let sb = StringBuilder::new()
  let stack : Array[SerFrame] = []
  let mut cur = root
  while true {
    if sb.length() > max_bytes {
      return Err(JqError::LimitExceeded("serialized JSON exceeds max_output_bytes"))
    }
    let mut descended = false
    match cur {
      JqVal::Null => sb.write_string("null")
      JqVal::Bool(b) => sb.write_string(if b { "true" } else { "false" })
      JqVal::Int(i) => sb.write_string(i.to_string())
      JqVal::BigInt(s) => sb.write_string(s)
      JqVal::Float(x) => sb.write_string(format_jq_float(x))
      JqVal::Str(s) =>
      match write_json_escaped_str_bounded(sb, s, max_bytes) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      JqVal::Array(items) => {
        sb.write_byte(91.to_byte())
        if items.length() == 0 {
          sb.write_byte(93.to_byte())
        } else {
          stack.push(SerFrame::Arr(items, 1))
          cur = items[0]
          descended = true
        }
      }
      JqVal::Object(obj) => {
        sb.write_byte(123.to_byte())
        let list = if sorted_keys { sort_obj_entries(obj.entries) } else { obj.entries }
        if list.length() == 0 {
          sb.write_byte(125.to_byte())
        } else {
          let (k0, v0) = list[0]
          match write_json_escaped_str_bounded(sb, k0, max_bytes) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          sb.write_byte(58.to_byte())
          stack.push(SerFrame::Obj(list, 1))
          cur = v0
          descended = true
        }
      }
    }
    if sb.length() > max_bytes {
      return Err(JqError::LimitExceeded("serialized JSON exceeds max_output_bytes"))
    }
    if descended {
      continue
    }
    let mut next_descend = false
    while stack.length() > 0 {
      let top = match stack.pop() {
        Some(f) => f
        None => break
      }
      match top {
        SerFrame::Arr(items, idx) => {
          if idx < items.length() {
            sb.write_byte(44.to_byte())
            if sb.length() > max_bytes {
              return Err(JqError::LimitExceeded("serialized JSON exceeds max_output_bytes"))
            }
            stack.push(SerFrame::Arr(items, idx + 1))
            cur = items[idx]
            next_descend = true
            break
          } else {
            sb.write_byte(93.to_byte())
            if sb.length() > max_bytes {
              return Err(JqError::LimitExceeded("serialized JSON exceeds max_output_bytes"))
            }
          }
        }
        SerFrame::Obj(list, idx) => {
          if idx < list.length() {
            sb.write_byte(44.to_byte())
            let (k, ev) = list[idx]
            match write_json_escaped_str_bounded(sb, k, max_bytes) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            sb.write_byte(58.to_byte())
            if sb.length() > max_bytes {
              return Err(JqError::LimitExceeded("serialized JSON exceeds max_output_bytes"))
            }
            stack.push(SerFrame::Obj(list, idx + 1))
            cur = ev
            next_descend = true
            break
          } else {
            sb.write_byte(125.to_byte())
            if sb.length() > max_bytes {
              return Err(JqError::LimitExceeded("serialized JSON exceeds max_output_bytes"))
            }
          }
        }
      }
    }
    if !next_descend {
      break
    }
  }
  if sb.length() > max_bytes {
    return Err(JqError::LimitExceeded("serialized JSON exceeds max_output_bytes"))
  }
  Ok(sb.to_string())
}

fn jq_tostring_val(v : JqVal, max_bytes : Int) -> Result[String, JqError] {
  match v {
    JqVal::Str(s) => Ok(s)
    JqVal::Int(i) => Ok(i.to_string())
    JqVal::Null => Ok("null")
    JqVal::Bool(b) => Ok(if b { "true" } else { "false" })
    JqVal::BigInt(s) =>
    if s.length() > max_bytes {
      Err(JqError::LimitExceeded("serialized JSON exceeds max_output_bytes"))
    } else {
      Ok(s)
    }
    JqVal::Float(x) => Ok(format_jq_float(x))
    _ => serialize_jq_val(v, false, max_bytes)
  }
}
