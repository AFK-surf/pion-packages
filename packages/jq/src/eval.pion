///| Core jq evaluator with tail-call trampoline (O(1) stack on Wasm32 for recursive defs),
///| streaming `Sink` with cap/skip (P0-4), per-query `max_outputs` (P1-11),
///| multi-key & `?//` pattern destructuring (P2-5), and right-outer stream order (P2-2).

import "json5"
import "regex"

enum EvalSignal {
  Error(JqError)
  Break(String)
  CapReached
}

struct VarNode {
  name : String
  value : JqVal
  prev : Int
}

struct FuncDef {
  name : String
  params : Array[String]
  body : Int
  var_env : Int
  mut func_env : Int
}

struct FuncNode {
  name : String
  arity : Int
  def_id : Int
  prev : Int
}

struct Sink {
  out : Array[JqVal]
  is_top_level : Bool
  mut cap_remaining : Int
  mut skip_remaining : Int
}

struct EvalCtx {
  exprs : Array[Expr]
  limits : JqLimits
  mut steps : Int
  mut depth : Int
  mut top_outputs : Int
  var_nodes : Array[VarNode]
  func_defs : Array[FuncDef]
  func_nodes : Array[FuncNode]
}

fn EvalCtx::new(exprs : Array[Expr], limits : JqLimits) -> EvalCtx {
  EvalCtx::{
    exprs: exprs,
    limits: limits,
    steps: 0,
    depth: 0,
    top_outputs: 0,
    var_nodes: [],
    func_defs: [],
    func_nodes: [],
  }
}

fn EvalCtx::step(self : EvalCtx) -> Result[Unit, EvalSignal] {
  self.steps = self.steps + 1
  if self.steps > self.limits.max_steps {
    return Err(EvalSignal::Error(JqError::LimitExceeded("max_steps exceeded")))
  }
  Ok(())
}

fn EvalCtx::step_n(self : EvalCtx, cost : Int) -> Result[Unit, EvalSignal] {
  self.steps = self.steps + cost
  if self.steps > self.limits.max_steps {
    return Err(EvalSignal::Error(JqError::LimitExceeded("max_steps exceeded")))
  }
  Ok(())
}

fn EvalCtx::enter(self : EvalCtx) -> Result[Unit, EvalSignal] {
  self.depth = self.depth + 1
  if self.depth > self.limits.max_depth {
    return Err(EvalSignal::Error(JqError::LimitExceeded("max_depth exceeded")))
  }
  Ok(())
}

fn EvalCtx::leave(self : EvalCtx) -> Unit {
  self.depth = self.depth - 1
}

fn EvalCtx::push_var(self : EvalCtx, env : Int, name : String, value : JqVal) -> Int {
  let id = self.var_nodes.length()
  self.var_nodes.push(VarNode::{ name: name, value: value, prev: env })
  id
}

fn EvalCtx::lookup_var(self : EvalCtx, env : Int, name : String) -> Option[JqVal] {
  let mut cur = env
  while cur >= 0 {
    let node = self.var_nodes[cur]
    if node.name == name {
      return Some(node.value)
    }
    cur = node.prev
  }
  None
}

fn EvalCtx::push_func(
  self : EvalCtx,
  fenv : Int,
  name : String,
  params : Array[String],
  body : Int,
  venv : Int,
) -> Int {
  let def_id = self.func_defs.length()
  let node_id = self.func_nodes.length()
  self.func_defs.push(
    FuncDef::{
      name: name,
      params: params,
      body: body,
      var_env: venv,
      func_env: node_id,
    },
  )
  self.func_nodes.push(
    FuncNode::{ name: name, arity: params.length(), def_id: def_id, prev: fenv },
  )
  node_id
}

fn EvalCtx::lookup_func(self : EvalCtx, fenv : Int, name : String, arity : Int) -> Option[Int] {
  let mut cur = fenv
  while cur >= 0 {
    let node = self.func_nodes[cur]
    if node.name == name && node.arity == arity {
      return Some(node.def_id)
    }
    cur = node.prev
  }
  None
}

fn EvalCtx::emit(self : EvalCtx, sink : Sink, v : JqVal) -> Result[Unit, EvalSignal] {
  if sink.skip_remaining > 0 {
    sink.skip_remaining = sink.skip_remaining - 1
    return Ok(())
  }
  if sink.is_top_level {
    self.top_outputs = self.top_outputs + 1
    if self.top_outputs > self.limits.max_outputs {
      return Err(EvalSignal::Error(JqError::LimitExceeded("max_outputs exceeded")))
    }
  }
  sink.out.push(v)
  if sink.cap_remaining >= 0 {
    sink.cap_remaining = sink.cap_remaining - 1
    if sink.cap_remaining <= 0 {
      return Err(EvalSignal::CapReached)
    }
  }
  Ok(())
}

enum SingleRes {
  Val(JqVal)
  Empty
  Slow
}

fn jq_neg_val(v : JqVal) -> Result[JqVal, EvalSignal] {
  match v {
    JqVal::Int(n) =>
    if n == -9223372036854775807L - 1L {
      Ok(JqVal::BigInt("9223372036854775808"))
    } else {
      Ok(JqVal::Int(-n))
    }
    JqVal::BigInt(s) => Ok(jq_int_from_decimal(bigint_neg_str(s)))
    JqVal::Float(x) => Ok(JqVal::Float(-x))
    other =>
    Err(
      EvalSignal::Error(
        JqError::RuntimeError(jq_type_name(other) + " cannot be negated"),
      ),
    )
  }
}

///| Zero-allocation fast path for simple single-value expressions (Identity, literals,
///| VarRef, `.field`, `.a.b`, `.[i]`, `-.field`). Returns `Slow` for general expressions.
fn EvalCtx::eval_one(
  self : EvalCtx,
  expr_id : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
) -> Result[SingleRes, EvalSignal] {
  match self.exprs[expr_id] {
    Expr::Identity => {
      match self.step() {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      Ok(SingleRes::Val(input))
    }
    Expr::NullLit => {
      match self.step() {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      Ok(SingleRes::Val(JqVal::Null))
    }
    Expr::BoolLit(b) => {
      match self.step() {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      Ok(SingleRes::Val(JqVal::Bool(b)))
    }
    Expr::NumLit(v) => {
      match self.step() {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      Ok(SingleRes::Val(v))
    }
    Expr::StrLit(s) => {
      match self.step() {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      Ok(SingleRes::Val(JqVal::Str(s)))
    }
    Expr::VarRef(name) => {
      match self.step() {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      match self.lookup_var(venv, name) {
        Some(v) => Ok(SingleRes::Val(v))
        None => Err(EvalSignal::Error(JqError::CompileError("undefined variable $" + name)))
      }
    }
    Expr::Field(target, key, opt) => {
      let base = match self.exprs[target] {
        Expr::Identity => {
          match self.step_n(2) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          input
        }
        Expr::VarRef(name) => {
          match self.step_n(2) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          match self.lookup_var(venv, name) {
            Some(v) => v
            None => return Err(EvalSignal::Error(JqError::CompileError("undefined variable $" + name)))
          }
        }
        _ => return Ok(SingleRes::Slow)
      }
      match jq_index_field(base, key) {
        Ok(v) => Ok(SingleRes::Val(v))
        Err(e) => if opt { Ok(SingleRes::Empty) } else { Err(EvalSignal::Error(e)) }
      }
    }
    Expr::FieldChain(target, fields) => {
      let mut v = match self.exprs[target] {
        Expr::Identity => {
          match self.step_n(2) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          input
        }
        Expr::VarRef(name) => {
          match self.step_n(2) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          match self.lookup_var(venv, name) {
            Some(x) => x
            None => return Err(EvalSignal::Error(JqError::CompileError("undefined variable $" + name)))
          }
        }
        _ => return Ok(SingleRes::Slow)
      }
      let mut fi = 0
      while fi < fields.length() {
        let (fk, fopt) = fields[fi]
        match jq_index_field(v, fk) {
          Ok(nv) => v = nv
          Err(e) =>
          if fopt {
            return Ok(SingleRes::Empty)
          } else {
            return Err(EvalSignal::Error(e))
          }
        }
        fi = fi + 1
      }
      Ok(SingleRes::Val(v))
    }
    Expr::Index(target, idx_expr, opt) => {
      let is_id_target = match self.exprs[target] {
        Expr::Identity => true
        _ => false
      }
      if !is_id_target {
        return Ok(SingleRes::Slow)
      }
      let idx_v = match self.exprs[idx_expr] {
        Expr::NumLit(v) => v
        Expr::StrLit(s) => JqVal::Str(s)
        Expr::VarRef(name) =>
        match self.lookup_var(venv, name) {
          Some(v) => v
          None => return Err(EvalSignal::Error(JqError::CompileError("undefined variable $" + name)))
        }
        _ => return Ok(SingleRes::Slow)
      }
      match self.step_n(2) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      match jq_index_val(input, idx_v) {
        Ok(v) => Ok(SingleRes::Val(v))
        Err(e) => if opt { Ok(SingleRes::Empty) } else { Err(EvalSignal::Error(e)) }
      }
    }
    Expr::Neg(inner) => {
      match self.eval_one(inner, input, venv, fenv) {
        Ok(SingleRes::Val(v)) =>
        match jq_neg_val(v) {
          Ok(nv) => Ok(SingleRes::Val(nv))
          Err(e) => Err(e)
        }
        Ok(SingleRes::Empty) => Ok(SingleRes::Empty)
        Ok(SingleRes::Slow) => Ok(SingleRes::Slow)
        Err(e) => Err(e)
      }
    }
    Expr::Pos(inner) => self.eval_one(inner, input, venv, fenv)
    _ => Ok(SingleRes::Slow)
  }
}

fn EvalCtx::eval_collect(
  self : EvalCtx,
  expr_id : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
) -> Result[Array[JqVal], EvalSignal] {
  let sink = Sink::{ out: [], is_top_level: false, cap_remaining: -1, skip_remaining: 0 }
  match self.eval(expr_id, input, venv, fenv, sink) {
    Ok(_) | Err(EvalSignal::CapReached) => Ok(sink.out)
    Err(e) => Err(e)
  }
}

fn EvalCtx::eval_collect_cap(
  self : EvalCtx,
  expr_id : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  cap : Int,
) -> Result[Array[JqVal], EvalSignal] {
  if cap <= 0 {
    return Ok([])
  }
  let sink = Sink::{ out: [], is_top_level: false, cap_remaining: cap, skip_remaining: 0 }
  match self.eval(expr_id, input, venv, fenv, sink) {
    Ok(_) | Err(EvalSignal::CapReached) => Ok(sink.out)
    Err(e) => Err(e)
  }
}

///| Bind a pattern (supporting `?//` alternatives and multi-key `{("a","b"):$v}`),
///| returning all resulting lexical variable environments.
fn EvalCtx::bind_pattern_all(
  self : EvalCtx,
  pat : Pattern,
  v : JqVal,
  input : JqVal,
  venv : Int,
  fenv : Int,
) -> Result[Array[Int], EvalSignal] {
  match pat {
    Pattern::Var(name) => Ok([self.push_var(venv, name, v)])
    Pattern::AltPat(alts) => {
      let mut i = 0
      while i < alts.length() {
        match self.bind_pattern_all(alts[i], v, input, venv, fenv) {
          Ok(envs) => return Ok(envs)
          Err(EvalSignal::Error(JqError::LimitExceeded(m))) =>
          return Err(EvalSignal::Error(JqError::LimitExceeded(m)))
          Err(EvalSignal::Error(JqError::InvalidLimits(m))) =>
          return Err(EvalSignal::Error(JqError::InvalidLimits(m)))
          Err(EvalSignal::Break(b)) => return Err(EvalSignal::Break(b))
          Err(EvalSignal::CapReached) => return Err(EvalSignal::CapReached)
          Err(EvalSignal::Error(e)) =>
          if i + 1 == alts.length() {
            return Err(EvalSignal::Error(e))
          }
        }
        i = i + 1
      }
      Ok([venv])
    }
    Pattern::ArrayPat(pats) => {
      let mut envs : Array[Int] = [venv]
      let mut i = 0
      while i < pats.length() {
        let elem = match jq_index_val(v, JqVal::Int(i.to_int64())) {
          Ok(ev) => ev
          Err(e) => return Err(EvalSignal::Error(e))
        }
        let next_envs : Array[Int] = []
        let mut ei = 0
        while ei < envs.length() {
          let bound = match self.bind_pattern_all(pats[i], elem, input, envs[ei], fenv) {
            Ok(bs) => bs
            Err(e) => return Err(e)
          }
          let mut bi = 0
          while bi < bound.length() {
            next_envs.push(bound[bi])
            bi = bi + 1
          }
          ei = ei + 1
        }
        envs = next_envs
        i = i + 1
      }
      Ok(envs)
    }
    Pattern::ObjPat(entries) => {
      let mut envs : Array[Int] = [venv]
      let mut i = 0
      while i < entries.length() {
        let (pk, sub_pat) = entries[i]
        let next_envs : Array[Int] = []
        let mut ei = 0
        while ei < envs.length() {
          let cur_env = envs[ei]
          let key_vals = match pk {
            PatKey::LitKey(s) => [JqVal::Str(s)]
            PatKey::ExprKey(kexpr) =>
            match self.eval_collect(kexpr, input, cur_env, fenv) {
              Ok(xs) => xs
              Err(e) => return Err(e)
            }
          }
          let mut ki = 0
          while ki < key_vals.length() {
            let field_val = match jq_index_val(v, key_vals[ki]) {
              Ok(fv) => fv
              Err(e) => return Err(EvalSignal::Error(e))
            }
            let bound = match self.bind_pattern_all(sub_pat, field_val, input, cur_env, fenv) {
              Ok(bs) => bs
              Err(e) => return Err(e)
            }
            let mut bi = 0
            while bi < bound.length() {
              next_envs.push(bound[bi])
              bi = bi + 1
            }
            ki = ki + 1
          }
          ei = ei + 1
        }
        envs = next_envs
        i = i + 1
      }
      Ok(envs)
    }
  }
}

///| Iterative recursive descent `..` (O(1) call stack on 10,000+ deep trees).
fn EvalCtx::eval_recurse(
  self : EvalCtx,
  root : JqVal,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let stack : Array[JqVal] = [root]
  while stack.length() > 0 {
    let v = match stack.pop() {
      Some(x) => x
      None => break
    }
    match self.step() {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    match self.emit(sink, v) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    match v {
      JqVal::Array(items) => {
        let mut i = items.length() - 1
        while i >= 0 {
          stack.push(items[i])
          i = i - 1
        }
      }
      JqVal::Object(obj) => {
        let es = obj.entries
        let mut i = es.length() - 1
        while i >= 0 {
          let (_, ev) = es[i]
          stack.push(ev)
          i = i - 1
        }
      }
      _ => ()
    }
  }
  Ok(())
}

///| Core evaluator with tail-call loop (TCO):
///| Tail calls (`Def`, `Pos`, `If` single-cond, `Pipe` single-mid, `Comma` rhs, user `Call`)
///| iterate in place without consuming native/Wasm32 stack frames.
fn EvalCtx::eval(
  self : EvalCtx,
  expr_id : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  match self.enter() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let mut cur_expr = expr_id
  let mut cur_input = input
  let mut cur_venv = venv
  let mut cur_fenv = fenv
  let mut res : Result[Unit, EvalSignal] = Ok(())
  while true {
    match self.step() {
      Err(e) => {
        res = Err(e)
        break
      }
      Ok(_) => ()
    }
    match self.exprs[cur_expr] {
      Expr::Identity => {
        res = self.emit(sink, cur_input)
        break
      }
      Expr::Recurse => {
        res = self.eval_recurse(cur_input, sink)
        break
      }
      Expr::NullLit => {
        res = self.emit(sink, JqVal::Null)
        break
      }
      Expr::BoolLit(b) => {
        res = self.emit(sink, JqVal::Bool(b))
        break
      }
      Expr::NumLit(v) => {
        res = self.emit(sink, v)
        break
      }
      Expr::StrLit(s) => {
        res = self.emit(sink, JqVal::Str(s))
        break
      }
      Expr::Format(fmt) => {
        res = match apply_format(fmt, cur_input, self.limits.max_output_bytes) {
          Ok(s) => self.emit(sink, JqVal::Str(s))
          Err(e) => Err(EvalSignal::Error(e))
        }
        break
      }
      Expr::StrInterp(fmt, parts) => {
        res = self.eval_str_interp(fmt, parts, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::VarRef(name) => {
        res = match self.lookup_var(cur_venv, name) {
          Some(v) => self.emit(sink, v)
          None => Err(EvalSignal::Error(JqError::CompileError("undefined variable $" + name)))
        }
        break
      }
      Expr::ArrayCons(inner) => {
        if inner < 0 {
          res = self.emit(sink, JqVal::Array([]))
          break
        }
        let items = match self.eval_collect(inner, cur_input, cur_venv, cur_fenv) {
          Ok(xs) => xs
          Err(e) => {
            res = Err(e)
            break
          }
        }
        res = self.emit(sink, JqVal::Array(items))
        break
      }
      Expr::ObjCons(entries) => {
        res = self.eval_obj_cons_fast(entries, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::Field(target, key, opt) => {
        match self.exprs[target] {
          Expr::Identity => {
            res = match jq_index_field(cur_input, key) {
              Ok(v) => self.emit(sink, v)
              Err(e) => if opt { Ok(()) } else { Err(EvalSignal::Error(e)) }
            }
          }
          _ => {
            res = self.eval_field_slow(target, key, opt, cur_input, cur_venv, cur_fenv, sink)
          }
        }
        break
      }
      Expr::FieldChain(target, fields) => {
        match self.exprs[target] {
          Expr::Identity => {
            let mut v = cur_input
            let mut skipped = false
            let mut failed = false
            let mut fi = 0
            while fi < fields.length() {
              let (fk, fopt) = fields[fi]
              match jq_index_field(v, fk) {
                Ok(nv) => v = nv
                Err(e) =>
                if fopt {
                  skipped = true
                  break
                } else {
                  res = Err(EvalSignal::Error(e))
                  failed = true
                  break
                }
              }
              fi = fi + 1
            }
            if !failed && !skipped {
              res = self.emit(sink, v)
            }
          }
          _ => {
            res = self.eval_field_chain_slow(target, fields, cur_input, cur_venv, cur_fenv, sink)
          }
        }
        break
      }
      Expr::Index(target, idx_expr, opt) => {
        let is_id = match self.exprs[target] {
          Expr::Identity => true
          _ => false
        }
        if is_id {
          match self.eval_one(idx_expr, cur_input, cur_venv, cur_fenv) {
            Ok(SingleRes::Val(iv)) => {
              res = match jq_index_val(cur_input, iv) {
                Ok(v) => self.emit(sink, v)
                Err(e) => if opt { Ok(()) } else { Err(EvalSignal::Error(e)) }
              }
              break
            }
            Ok(SingleRes::Empty) => break
            Err(e) => {
              res = Err(e)
              break
            }
            Ok(SingleRes::Slow) => ()
          }
        }
        res = self.eval_index_slow(target, idx_expr, opt, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::Slice(target, s_expr, e_expr, opt) => {
        res = self.eval_slice(target, s_expr, e_expr, opt, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::Iter(target, opt) => {
        match self.exprs[target] {
          Expr::Identity => {
            res = self.emit_iter_val(cur_input, opt, sink)
          }
          _ => {
            res = self.eval_iter_slow(target, opt, cur_input, cur_venv, cur_fenv, sink)
          }
        }
        break
      }
      Expr::Optional(inner) => {
        res = match self.eval(inner, cur_input, cur_venv, cur_fenv, sink) {
          Ok(_) => Ok(())
          Err(EvalSignal::Error(JqError::LimitExceeded(m))) =>
          Err(EvalSignal::Error(JqError::LimitExceeded(m)))
          Err(EvalSignal::Error(JqError::InvalidLimits(m))) =>
          Err(EvalSignal::Error(JqError::InvalidLimits(m)))
          Err(EvalSignal::Break(b)) => Err(EvalSignal::Break(b))
          Err(EvalSignal::CapReached) => Err(EvalSignal::CapReached)
          Err(EvalSignal::Error(_)) => Ok(())
        }
        break
      }
      Expr::Neg(inner) => {
        match self.eval_one(inner, cur_input, cur_venv, cur_fenv) {
          Ok(SingleRes::Val(v)) => {
            res = match jq_neg_val(v) {
              Ok(nv) => self.emit(sink, nv)
              Err(e) => Err(e)
            }
          }
          Ok(SingleRes::Empty) => ()
          Err(e) => res = Err(e)
          Ok(SingleRes::Slow) => {
            res = self.eval_neg_slow(inner, cur_input, cur_venv, cur_fenv, sink)
          }
        }
        break
      }
      Expr::Pos(inner) => {
        // Tail-call jump
        cur_expr = inner
        continue
      }
      Expr::Bin(BinOp::Pipe, lhs, rhs) => {
        // Fast path 1: `.[] | rhs` on an Array streams directly without intermediate copy
        match self.exprs[lhs] {
          Expr::Iter(inner_t, false) => {
            let inner_is_id = match self.exprs[inner_t] {
              Expr::Identity => true
              _ => false
            }
            if inner_is_id {
              match cur_input {
                JqVal::Array(items) => {
                  let n = items.length()
                  if n == 0 {
                    break
                  }
                  let mut i = 0
                  while i + 1 < n {
                    match self.eval(rhs, items[i], cur_venv, cur_fenv, sink) {
                      Err(e) => {
                        res = Err(e)
                        break
                      }
                      Ok(_) => ()
                    }
                    i = i + 1
                  }
                  match res {
                    Err(_) => break
                    Ok(_) => {
                      cur_expr = rhs
                      cur_input = items[n - 1]
                      continue
                    }
                  }
                }
                _ => ()
              }
            }
          }
          _ => ()
        }
        // Fast path 2: single-value lhs avoids Sink + Array allocation
        match self.eval_one(lhs, cur_input, cur_venv, cur_fenv) {
          Ok(SingleRes::Val(v)) => {
            cur_expr = rhs
            cur_input = v
            continue
          }
          Ok(SingleRes::Empty) => break
          Err(e) => {
            res = Err(e)
            break
          }
          Ok(SingleRes::Slow) => ()
        }
        let mid = match self.eval_collect(lhs, cur_input, cur_venv, cur_fenv) {
          Ok(xs) => xs
          Err(e) => {
            res = Err(e)
            break
          }
        }
        if mid.length() == 0 {
          break
        }
        if mid.length() == 1 {
          // Tail-call jump!
          cur_expr = rhs
          cur_input = mid[0]
          continue
        }
        let mut i = 0
        while i + 1 < mid.length() {
          match self.eval(rhs, mid[i], cur_venv, cur_fenv, sink) {
            Err(e) => {
              res = Err(e)
              break
            }
            Ok(_) => ()
          }
          i = i + 1
        }
        match res {
          Err(_) => break
          Ok(_) => {
            // Tail-call jump for the last element
            cur_expr = rhs
            cur_input = mid[mid.length() - 1]
            continue
          }
        }
      }
      Expr::Bin(BinOp::Comma, lhs, rhs) => {
        match self.eval(lhs, cur_input, cur_venv, cur_fenv, sink) {
          Err(e) => {
            res = Err(e)
            break
          }
          Ok(_) => ()
        }
        // Tail-call jump for rhs! (Makes `def r: ., (. + 1 | r)` O(1) stack!)
        cur_expr = rhs
        continue
      }
      Expr::PipeChain(stages) => {
        res = self.eval_pipe_chain(stages, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::CommaChain(items) => {
        let mut i = 0
        let mut failed = false
        while i + 1 < items.length() {
          match self.eval(items[i], cur_input, cur_venv, cur_fenv, sink) {
            Err(e) => {
              res = Err(e)
              failed = true
              break
            }
            Ok(_) => ()
          }
          i = i + 1
        }
        if failed {
          break
        }
        cur_expr = items[items.length() - 1]
        continue
      }
      Expr::AddChain(first, rest) => {
        res = self.eval_add_chain(first, rest, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::Bin(op, lhs, rhs) => {
        res = self.eval_bin(op, lhs, rhs, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::If(cond, then_e, elifs, else_e) => {
        if elifs.length() == 0 {
          match self.eval_one(cond, cur_input, cur_venv, cur_fenv) {
            Ok(SingleRes::Val(c)) => {
              if jq_truthy(c) {
                cur_expr = then_e
                continue
              } else if else_e >= 0 {
                cur_expr = else_e
                continue
              } else {
                res = self.emit(sink, cur_input)
                break
              }
            }
            Ok(SingleRes::Empty) => break
            Err(e) => {
              res = Err(e)
              break
            }
            Ok(SingleRes::Slow) => ()
          }
        }
        let cs = match self.eval_collect(cond, cur_input, cur_venv, cur_fenv) {
          Ok(xs) => xs
          Err(e) => {
            res = Err(e)
            break
          }
        }
        if cs.length() == 1 && elifs.length() == 0 {
          // Tail-call jump for the common single-condition `if c then a else b end`!
          if jq_truthy(cs[0]) {
            cur_expr = then_e
            continue
          } else if else_e >= 0 {
            cur_expr = else_e
            continue
          } else {
            res = self.emit(sink, cur_input)
            break
          }
        }
        res = self.eval_if_vals(cs, then_e, elifs, 0, else_e, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::Try(body, catch_e) => {
        res = self.eval_try(body, catch_e, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::As(val_e, pat, body_e) => {
        match pat {
          Pattern::Var(name) => {
            match self.eval_one(val_e, cur_input, cur_venv, cur_fenv) {
              Ok(SingleRes::Val(v)) => {
                cur_venv = self.push_var(cur_venv, name, v)
                cur_expr = body_e
                continue
              }
              Ok(SingleRes::Empty) => break
              Err(e) => {
                res = Err(e)
                break
              }
              Ok(SingleRes::Slow) => ()
            }
          }
          _ => ()
        }
        res = self.eval_as_slow(val_e, pat, body_e, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::Reduce(src_e, pat, init_e, upd_e) => {
        res = self.eval_reduce(src_e, pat, init_e, upd_e, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::Foreach(src_e, pat, init_e, upd_e, ext_e) => {
        res = self.eval_foreach(src_e, pat, init_e, upd_e, ext_e, cur_input, cur_venv, cur_fenv, sink)
        break
      }
      Expr::Def(name, params, body, next) => {
        cur_fenv = self.push_func(cur_fenv, name, params, body, cur_venv)
        cur_expr = next
        continue
      }
      Expr::Label(name, body) => {
        res = match self.eval(body, cur_input, cur_venv, cur_fenv, sink) {
          Ok(_) => Ok(())
          Err(EvalSignal::Break(bname)) =>
          if bname == name {
            Ok(())
          } else {
            Err(EvalSignal::Break(bname))
          }
          Err(e) => Err(e)
        }
        break
      }
      Expr::Break(name) => {
        res = Err(EvalSignal::Break(name))
        break
      }
      Expr::Call(name, args) => {
        // Tail-call jump for user-defined functions!
        match self.lookup_func(cur_fenv, name, args.length()) {
          Some(def_id) => {
            let fdef = self.func_defs[def_id]
            let mut call_fenv = fdef.func_env
            let mut i = 0
            while i < fdef.params.length() {
              let arg_def_id = self.func_defs.length()
              let arg_node_id = self.func_nodes.length()
              self.func_defs.push(
                FuncDef::{
                  name: fdef.params[i],
                  params: [],
                  body: args[i],
                  var_env: cur_venv,
                  func_env: cur_fenv,
                },
              )
              self.func_nodes.push(
                FuncNode::{
                  name: fdef.params[i],
                  arity: 0,
                  def_id: arg_def_id,
                  prev: call_fenv,
                },
              )
              call_fenv = arg_node_id
              i = i + 1
            }
            cur_expr = fdef.body
            cur_venv = fdef.var_env
            cur_fenv = call_fenv
            continue
          }
          None => {
            res = self.eval_builtin_call(name, args, cur_input, cur_venv, cur_fenv, sink)
            break
          }
        }
      }
    }
  }
  self.leave()
  res
}

///| Extracted cold-path helpers for `EvalCtx::eval` to keep the main dispatch loop compact.
fn EvalCtx::emit_iter_val(
  self : EvalCtx,
  v : JqVal,
  opt : Bool,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  match v {
    JqVal::Array(items) => {
      let mut k = 0
      while k < items.length() {
        match self.emit(sink, items[k]) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        k = k + 1
      }
      Ok(())
    }
    JqVal::Object(obj) => {
      let es = obj.entries
      let mut k = 0
      while k < es.length() {
        let (_, ev) = es[k]
        match self.emit(sink, ev) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        k = k + 1
      }
      Ok(())
    }
    other =>
    if opt {
      Ok(())
    } else {
      Err(EvalSignal::Error(JqError::RuntimeError("cannot iterate over " + jq_type_name(other))))
    }
  }
}

fn EvalCtx::eval_field_slow(
  self : EvalCtx,
  target : Int,
  key : String,
  opt : Bool,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let ts = match self.eval_collect(target, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mut i = 0
  while i < ts.length() {
    match jq_index_field(ts[i], key) {
      Ok(v) =>
      match self.emit(sink, v) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      Err(e) => if !opt { return Err(EvalSignal::Error(e)) }
    }
    i = i + 1
  }
  Ok(())
}

fn EvalCtx::eval_field_chain_slow(
  self : EvalCtx,
  target : Int,
  fields : Array[(String, Bool)],
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let ts = match self.eval_collect(target, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mut ti = 0
  while ti < ts.length() {
    let mut v = ts[ti]
    let mut skipped = false
    let mut fi = 0
    while fi < fields.length() {
      let (fk, fopt) = fields[fi]
      match jq_index_field(v, fk) {
        Ok(nv) => v = nv
        Err(e) =>
        if fopt {
          skipped = true
          break
        } else {
          return Err(EvalSignal::Error(e))
        }
      }
      fi = fi + 1
    }
    if !skipped {
      match self.emit(sink, v) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    }
    ti = ti + 1
  }
  Ok(())
}

fn EvalCtx::eval_index_slow(
  self : EvalCtx,
  target : Int,
  idx_expr : Int,
  opt : Bool,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  // P2-2: index expression is outer loop, target is inner loop (matches jq/gojq)
  let idxs = match self.eval_collect(idx_expr, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  if idxs.length() == 0 {
    return Ok(())
  }
  let ts = match self.eval_collect(target, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mut j = 0
  while j < idxs.length() {
    let mut i = 0
    while i < ts.length() {
      match jq_index_val(ts[i], idxs[j]) {
        Ok(v) =>
        match self.emit(sink, v) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        Err(e) => if !opt { return Err(EvalSignal::Error(e)) }
      }
      i = i + 1
    }
    j = j + 1
  }
  Ok(())
}

fn EvalCtx::eval_slice(
  self : EvalCtx,
  target : Int,
  s_expr : Int,
  e_expr : Int,
  opt : Bool,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let ts = match self.eval_collect(target, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let starts : Array[Option[JqVal]] = if s_expr < 0 {
    [None]
  } else {
    let xs = match self.eval_collect(s_expr, input, venv, fenv) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let arr : Array[Option[JqVal]] = []
    let mut k = 0
    while k < xs.length() {
      arr.push(Some(xs[k]))
      k = k + 1
    }
    arr
  }
  let ends : Array[Option[JqVal]] = if e_expr < 0 {
    [None]
  } else {
    let xs = match self.eval_collect(e_expr, input, venv, fenv) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let arr : Array[Option[JqVal]] = []
    let mut k = 0
    while k < xs.length() {
      arr.push(Some(xs[k]))
      k = k + 1
    }
    arr
  }
  let mut ti = 0
  while ti < ts.length() {
    let mut si = 0
    while si < starts.length() {
      let mut ei = 0
      while ei < ends.length() {
        match jq_slice_val(ts[ti], starts[si], ends[ei]) {
          Ok(v) =>
          match self.emit(sink, v) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          Err(e) => if !opt { return Err(EvalSignal::Error(e)) }
        }
        ei = ei + 1
      }
      si = si + 1
    }
    ti = ti + 1
  }
  Ok(())
}

fn EvalCtx::eval_iter_slow(
  self : EvalCtx,
  target : Int,
  opt : Bool,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let ts = match self.eval_collect(target, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mut ti = 0
  while ti < ts.length() {
    match self.emit_iter_val(ts[ti], opt, sink) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    ti = ti + 1
  }
  Ok(())
}

fn EvalCtx::eval_neg_slow(
  self : EvalCtx,
  inner : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let xs = match self.eval_collect(inner, input, venv, fenv) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let mut i = 0
  while i < xs.length() {
    match jq_neg_val(xs[i]) {
      Ok(nv) =>
      match self.emit(sink, nv) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  Ok(())
}

fn EvalCtx::eval_pipe_chain(
  self : EvalCtx,
  stages : Array[Int],
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let mut cur_vals : Array[JqVal] = [input]
  let last_s = stages.length() - 1
  let mut si = 0
  while si < last_s {
    let st_expr = stages[si]
    if cur_vals.length() == 1 {
      match self.eval_one(st_expr, cur_vals[0], venv, fenv) {
        Ok(SingleRes::Val(v)) => {
          cur_vals[0] = v
          si = si + 1
          continue
        }
        Ok(SingleRes::Empty) => return Ok(())
        Err(e) => return Err(e)
        Ok(SingleRes::Slow) => ()
      }
    }
    let stage_sink = Sink::{ out: [], is_top_level: false, cap_remaining: -1, skip_remaining: 0 }
    let mut vi = 0
    while vi < cur_vals.length() {
      match self.eval(st_expr, cur_vals[vi], venv, fenv, stage_sink) {
        Ok(_) | Err(EvalSignal::CapReached) => ()
        Err(e) => return Err(e)
      }
      vi = vi + 1
    }
    cur_vals = stage_sink.out
    if cur_vals.length() == 0 {
      return Ok(())
    }
    si = si + 1
  }
  let last_expr = stages[last_s]
  let mut vi = 0
  while vi < cur_vals.length() {
    match self.eval(last_expr, cur_vals[vi], venv, fenv, sink) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    vi = vi + 1
  }
  Ok(())
}

fn EvalCtx::eval_add_chain(
  self : EvalCtx,
  first : Int,
  rest : Array[(BinOp, Int)],
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let mut cur_vals = match self.eval_collect(first, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mut ri = 0
  while ri < rest.length() {
    let (op, r_expr) = rest[ri]
    let rs = match self.eval_collect(r_expr, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let next_vals : Array[JqVal] = []
    let mut j = 0
    while j < rs.length() {
      let mut i = 0
      while i < cur_vals.length() {
        let r = match op {
          BinOp::Add => jq_add(cur_vals[i], rs[j], self.limits.max_output_bytes)
          _ => jq_sub(cur_vals[i], rs[j])
        }
        match r {
          Ok(v) => next_vals.push(v)
          Err(e) => return Err(EvalSignal::Error(e))
        }
        i = i + 1
      }
      j = j + 1
    }
    cur_vals = next_vals
    ri = ri + 1
  }
  let mut i = 0
  while i < cur_vals.length() {
    match self.emit(sink, cur_vals[i]) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    i = i + 1
  }
  Ok(())
}

fn EvalCtx::eval_try(
  self : EvalCtx,
  body : Int,
  catch_e : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  match self.eval(body, input, venv, fenv, sink) {
    Ok(_) => Ok(())
    Err(EvalSignal::Error(JqError::LimitExceeded(m))) =>
    Err(EvalSignal::Error(JqError::LimitExceeded(m)))
    Err(EvalSignal::Error(JqError::InvalidLimits(m))) =>
    Err(EvalSignal::Error(JqError::InvalidLimits(m)))
    Err(EvalSignal::Break(b)) => Err(EvalSignal::Break(b))
    Err(EvalSignal::CapReached) => Err(EvalSignal::CapReached)
    Err(EvalSignal::Error(JqError::UserError(uv))) =>
    if catch_e >= 0 {
      self.eval(catch_e, from_json5(uv), venv, fenv, sink)
    } else {
      Ok(())
    }
    Err(EvalSignal::Error(JqError::RuntimeError(msg))) =>
    if catch_e >= 0 {
      self.eval(catch_e, JqVal::Str(msg), venv, fenv, sink)
    } else {
      Ok(())
    }
    Err(EvalSignal::Error(other)) =>
    if catch_e >= 0 {
      self.eval(catch_e, JqVal::Str(error_message(other)), venv, fenv, sink)
    } else {
      Ok(())
    }
  }
}

fn EvalCtx::eval_as_slow(
  self : EvalCtx,
  val_e : Int,
  pat : Pattern,
  body_e : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let vs = match self.eval_collect(val_e, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mut i = 0
  while i < vs.length() {
    let new_envs = match self.bind_pattern_all(pat, vs[i], input, venv, fenv) {
      Ok(ne) => ne
      Err(e) => return Err(e)
    }
    let mut ei = 0
    while ei < new_envs.length() {
      match self.eval(body_e, input, new_envs[ei], fenv, sink) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      ei = ei + 1
    }
    i = i + 1
  }
  Ok(())
}

fn EvalCtx::eval_reduce(
  self : EvalCtx,
  src_e : Int,
  pat : Pattern,
  init_e : Int,
  upd_e : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let inits = match self.eval_collect(init_e, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let items = match self.eval_collect(src_e, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mut ii = 0
  while ii < inits.length() {
    let mut acc = inits[ii]
    let mut j = 0
    while j < items.length() {
      match self.step() {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let new_envs = match self.bind_pattern_all(pat, items[j], input, venv, fenv) {
        Ok(ne) => ne
        Err(e) => return Err(e)
      }
      let mut ei = 0
      while ei < new_envs.length() {
        let nexts = match self.eval_collect(upd_e, acc, new_envs[ei], fenv) {
          Ok(xs) => xs
          Err(e) => return Err(e)
        }
        if nexts.length() > 0 {
          acc = nexts[nexts.length() - 1]
        }
        ei = ei + 1
      }
      j = j + 1
    }
    match self.emit(sink, acc) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    ii = ii + 1
  }
  Ok(())
}

fn EvalCtx::eval_foreach(
  self : EvalCtx,
  src_e : Int,
  pat : Pattern,
  init_e : Int,
  upd_e : Int,
  ext_e : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let inits = match self.eval_collect(init_e, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let items = match self.eval_collect(src_e, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mut ii = 0
  while ii < inits.length() {
    let mut acc = inits[ii]
    let mut j = 0
    while j < items.length() {
      match self.step() {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let new_envs = match self.bind_pattern_all(pat, items[j], input, venv, fenv) {
        Ok(ne) => ne
        Err(e) => return Err(e)
      }
      let mut ei = 0
      while ei < new_envs.length() {
        let nexts = match self.eval_collect(upd_e, acc, new_envs[ei], fenv) {
          Ok(xs) => xs
          Err(e) => return Err(e)
        }
        let mut k = 0
        while k < nexts.length() {
          acc = nexts[k]
          if ext_e >= 0 {
            match self.eval(ext_e, acc, new_envs[ei], fenv, sink) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
          } else {
            match self.emit(sink, acc) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
          }
          k = k + 1
        }
        ei = ei + 1
      }
      j = j + 1
    }
    ii = ii + 1
  }
  Ok(())
}

///| String interpolation with jq/gojq right-outer stream order (P2-2):
///| `"\(1,2)-\(3,4)"` -> `"1-3", "2-3", "1-4", "2-4"`.
fn EvalCtx::eval_str_interp(
  self : EvalCtx,
  fmt : String,
  parts : Array[StrPart],
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let n = parts.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    match parts[i] {
      StrPart::Lit(s) => {
        if sb.length() + s.length() > self.limits.max_output_bytes {
          return Err(EvalSignal::Error(JqError::LimitExceeded("string interpolation exceeds max_output_bytes")))
        }
        sb.write_string(s)
      }
      StrPart::Interp(e_id) => {
        let one_opt : Option[JqVal] = match self.eval_one(e_id, input, venv, fenv) {
          Ok(SingleRes::Val(v)) => Some(v)
          Ok(SingleRes::Empty) => return Ok(())
          Err(e) => return Err(e)
          Ok(SingleRes::Slow) => None
        }
        match one_opt {
          Some(v) => {
            let s = match apply_format(fmt, v, self.limits.max_output_bytes) {
              Ok(x) => x
              Err(e) => return Err(EvalSignal::Error(e))
            }
            if sb.length() + s.length() > self.limits.max_output_bytes {
              return Err(EvalSignal::Error(JqError::LimitExceeded("string interpolation exceeds max_output_bytes")))
            }
            sb.write_string(s)
          }
          None => {
            let vs = match self.eval_collect(e_id, input, venv, fenv) {
              Ok(xs) => xs
              Err(e) => return Err(e)
            }
            if vs.length() == 0 {
              return Ok(())
            }
            if vs.length() == 1 {
              let s = match apply_format(fmt, vs[0], self.limits.max_output_bytes) {
                Ok(x) => x
                Err(e) => return Err(EvalSignal::Error(e))
              }
              if sb.length() + s.length() > self.limits.max_output_bytes {
                return Err(EvalSignal::Error(JqError::LimitExceeded("string interpolation exceeds max_output_bytes")))
              }
              sb.write_string(s)
            } else {
              return self.eval_str_interp_multi(fmt, parts, i, [sb.to_string()], vs, input, venv, fenv, sink)
            }
          }
        }
      }
    }
    i = i + 1
  }
  self.emit(sink, JqVal::Str(sb.to_string()))
}

fn EvalCtx::eval_str_interp_multi(
  self : EvalCtx,
  fmt : String,
  parts : Array[StrPart],
  start_i : Int,
  init_acc : Array[String],
  first_vs : Array[JqVal],
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let n = parts.length()
  let mut acc = init_acc
  let mut i = start_i
  while i < n {
    match parts[i] {
      StrPart::Lit(s) => {
        let next : Array[String] = []
        let mut j = 0
        while j < acc.length() {
          if acc[j].length() + s.length() > self.limits.max_output_bytes {
            return Err(EvalSignal::Error(JqError::LimitExceeded("string interpolation exceeds max_output_bytes")))
          }
          next.push(acc[j] + s)
          j = j + 1
        }
        acc = next
      }
      StrPart::Interp(e_id) => {
        let vs = if i == start_i {
          first_vs
        } else {
          match self.eval_collect(e_id, input, venv, fenv) {
            Ok(xs) => xs
            Err(e) => return Err(e)
          }
        }
        if vs.length() == 0 {
          return Ok(())
        }
        let strs : Array[String] = []
        let mut k = 0
        while k < vs.length() {
          match apply_format(fmt, vs[k], self.limits.max_output_bytes) {
            Ok(s) => strs.push(s)
            Err(e) => return Err(EvalSignal::Error(e))
          }
          k = k + 1
        }
        // Rightmost interpolation is outer loop, earlier prefix is inner loop (jq/gojq order!)
        let next : Array[String] = []
        let mut vi = 0
        while vi < strs.length() {
          let mut pi = 0
          while pi < acc.length() {
            if acc[pi].length() + strs[vi].length() > self.limits.max_output_bytes {
              return Err(EvalSignal::Error(JqError::LimitExceeded("string interpolation exceeds max_output_bytes")))
            }
            next.push(acc[pi] + strs[vi])
            pi = pi + 1
          }
          vi = vi + 1
        }
        acc = next
      }
    }
    i = i + 1
  }
  let mut out_i = 0
  while out_i < acc.length() {
    match self.emit(sink, JqVal::Str(acc[out_i])) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    out_i = out_i + 1
  }
  Ok(())
}

fn EvalCtx::eval_obj_cons_fast(
  self : EvalCtx,
  entries : Array[ObjEntry],
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let n = entries.length()
  if n == 0 {
    return self.emit(sink, JqVal::Object(jq_obj_from_entries([])))
  }
  let acc : Array[(String, JqVal)] = []
  let mut i = 0
  while i < n {
    let entry = entries[i]
    let k = match entry.key {
      ObjKey::Lit(s) => s
      ObjKey::VarKey(vn) => vn
      ObjKey::Expr(_) => return self.eval_obj_cons(entries, i, acc, input, venv, fenv, sink)
    }
    match self.eval_one(entry.val_expr, input, venv, fenv) {
      Ok(SingleRes::Val(v)) => acc.push((k, v))
      Ok(SingleRes::Empty) => return Ok(())
      Err(e) => return Err(e)
      Ok(SingleRes::Slow) => {
        let vs = match self.eval_collect(entry.val_expr, input, venv, fenv) {
          Ok(xs) => xs
          Err(e) => return Err(e)
        }
        if vs.length() == 0 {
          return Ok(())
        }
        if vs.length() == 1 {
          acc.push((k, vs[0]))
        } else {
          let mut vi = 0
          while vi < vs.length() {
            let next_acc : Array[(String, JqVal)] = []
            let mut ai = 0
            while ai < acc.length() {
              next_acc.push(acc[ai])
              ai = ai + 1
            }
            next_acc.push((k, vs[vi]))
            match self.eval_obj_cons(entries, i + 1, next_acc, input, venv, fenv, sink) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            vi = vi + 1
          }
          return Ok(())
        }
      }
    }
    i = i + 1
  }
  self.emit(sink, JqVal::Object(jq_obj_dedup_entries(acc)))
}

fn EvalCtx::eval_obj_cons(
  self : EvalCtx,
  entries : Array[ObjEntry],
  idx : Int,
  acc : Array[(String, JqVal)],
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  if idx >= entries.length() {
    return self.emit(sink, JqVal::Object(jq_obj_dedup_entries(acc)))
  }
  let entry = entries[idx]
  let keys : Array[String] = match entry.key {
    ObjKey::Lit(k) => [k]
    ObjKey::VarKey(vn) => [vn]
    ObjKey::Expr(kexpr) => {
      let kvs = match self.eval_collect(kexpr, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let ks : Array[String] = []
      let mut i = 0
      while i < kvs.length() {
        match kvs[i] {
          JqVal::Str(s) => ks.push(s)
          other =>
          return Err(
            EvalSignal::Error(
              JqError::RuntimeError("object key must be string, got " + jq_type_name(other)),
            ),
          )
        }
        i = i + 1
      }
      ks
    }
  }
  let vals = match self.eval_collect(entry.val_expr, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mut ki = 0
  while ki < keys.length() {
    let mut vi = 0
    while vi < vals.length() {
      let next_acc : Array[(String, JqVal)] = []
      let mut ai = 0
      while ai < acc.length() {
        next_acc.push(acc[ai])
        ai = ai + 1
      }
      next_acc.push((keys[ki], vals[vi]))
      match self.eval_obj_cons(entries, idx + 1, next_acc, input, venv, fenv, sink) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      vi = vi + 1
    }
    ki = ki + 1
  }
  Ok(())
}

fn EvalCtx::eval_if_vals(
  self : EvalCtx,
  cs : Array[JqVal],
  then_e : Int,
  elifs : Array[ElifBranch],
  elif_idx : Int,
  else_e : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let mut i = 0
  while i < cs.length() {
    if jq_truthy(cs[i]) {
      match self.eval(then_e, input, venv, fenv, sink) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    } else if elif_idx < elifs.length() {
      let eb = elifs[elif_idx]
      let ecs = match self.eval_collect(eb.cond, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      match self.eval_if_vals(ecs, eb.body, elifs, elif_idx + 1, else_e, input, venv, fenv, sink) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    } else if else_e >= 0 {
      match self.eval(else_e, input, venv, fenv, sink) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    } else {
      match self.emit(sink, input) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    }
    i = i + 1
  }
  Ok(())
}

fn EvalCtx::eval_bin(
  self : EvalCtx,
  op : BinOp,
  lhs : Int,
  rhs : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  match op {
    BinOp::Alt => {
      let ls = match self.eval_collect(lhs, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut emitted = false
      let mut i = 0
      while i < ls.length() {
        if jq_truthy(ls[i]) {
          emitted = true
          match self.emit(sink, ls[i]) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
        }
        i = i + 1
      }
      if !emitted {
        self.eval(rhs, input, venv, fenv, sink)
      } else {
        Ok(())
      }
    }
    BinOp::And => {
      let ls = match self.eval_collect(lhs, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut i = 0
      while i < ls.length() {
        if !jq_truthy(ls[i]) {
          match self.emit(sink, JqVal::Bool(false)) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
        } else {
          let rs = match self.eval_collect(rhs, input, venv, fenv) {
            Ok(xs) => xs
            Err(e) => return Err(e)
          }
          let mut j = 0
          while j < rs.length() {
            match self.emit(sink, JqVal::Bool(jq_truthy(rs[j]))) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            j = j + 1
          }
        }
        i = i + 1
      }
      Ok(())
    }
    BinOp::Or => {
      let ls = match self.eval_collect(lhs, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut i = 0
      while i < ls.length() {
        if jq_truthy(ls[i]) {
          match self.emit(sink, JqVal::Bool(true)) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
        } else {
          let rs = match self.eval_collect(rhs, input, venv, fenv) {
            Ok(xs) => xs
            Err(e) => return Err(e)
          }
          let mut j = 0
          while j < rs.length() {
            match self.emit(sink, JqVal::Bool(jq_truthy(rs[j]))) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            j = j + 1
          }
        }
        i = i + 1
      }
      Ok(())
    }
    BinOp::Assign => self.eval_assign(lhs, rhs, input, venv, fenv, sink)
    BinOp::Update => self.eval_update(lhs, rhs, input, venv, fenv, sink)
    BinOp::AddAssign | BinOp::SubAssign | BinOp::MulAssign | BinOp::DivAssign | BinOp::ModAssign | BinOp::AltAssign =>
    self.eval_compound_assign(op, lhs, rhs, input, venv, fenv, sink)
    _ => {
      // P2-2: Evaluate RHS first! If RHS is empty (e.g. `.[0] * empty` on a string),
      // LHS is not evaluated and the result is empty.
      let rs = match self.eval_collect(rhs, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      if rs.length() == 0 {
        return Ok(())
      }
      let ls = match self.eval_collect(lhs, input, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut j = 0
      while j < rs.length() {
        let mut i = 0
        while i < ls.length() {
          let res = match op {
            BinOp::Eq => Ok(JqVal::Bool(jq_eq(ls[i], rs[j])))
            BinOp::Ne => Ok(JqVal::Bool(!jq_eq(ls[i], rs[j])))
            BinOp::Lt => Ok(JqVal::Bool(jq_lt(ls[i], rs[j])))
            BinOp::Le => Ok(JqVal::Bool(jq_le(ls[i], rs[j])))
            BinOp::Gt => Ok(JqVal::Bool(jq_gt(ls[i], rs[j])))
            BinOp::Ge => Ok(JqVal::Bool(jq_ge(ls[i], rs[j])))
            BinOp::Add => jq_add(ls[i], rs[j], self.limits.max_output_bytes)
            BinOp::Sub => jq_sub(ls[i], rs[j])
            BinOp::Mul => jq_mul(ls[i], rs[j], self.limits)
            BinOp::Div => jq_div(ls[i], rs[j])
            BinOp::Mod => jq_mod(ls[i], rs[j])
            _ => Err(JqError::RuntimeError("unexpected binary operator"))
          }
          match res {
            Ok(v) =>
            match self.emit(sink, v) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            Err(e) => return Err(EvalSignal::Error(e))
          }
          i = i + 1
        }
        j = j + 1
      }
      Ok(())
    }
  }
}
