///| Recursive-descent + precedence parser for jq queries into a flat `Array[Expr]` arena,
///| with flat chain nodes (O(1) stack on 20k chains) and compile-time function validation.

struct Parser {
  tokens : Array[Token]
  mut pos : Int
  exprs : Array[Expr]
  max_depth : Int
  mut depth : Int
}

fn Parser::new(tokens : Array[Token], max_depth : Int) -> Parser {
  Parser::{ tokens: tokens, pos: 0, exprs: [], max_depth: max_depth, depth: 0 }
}

fn Parser::peek(self : Parser) -> Token {
  if self.pos < self.tokens.length() {
    self.tokens[self.pos]
  } else {
    self.tokens[self.tokens.length() - 1]
  }
}

fn Parser::advance(self : Parser) -> Token {
  let t = self.peek()
  if self.pos + 1 < self.tokens.length() {
    self.pos = self.pos + 1
  }
  t
}

fn Parser::alloc(self : Parser, e : Expr) -> Int {
  let id = self.exprs.length()
  self.exprs.push(e)
  id
}

fn Parser::enter(self : Parser) -> Result[Unit, JqError] {
  self.depth = self.depth + 1
  if self.depth > self.max_depth {
    return Err(JqError::LimitExceeded("max parse depth exceeded"))
  }
  Ok(())
}

fn Parser::leave(self : Parser) -> Unit {
  self.depth = self.depth - 1
}

fn token_as_key_name(kind : TokKind) -> Option[String] {
  match kind {
    TokKind::Ident(s) => Some(s)
    TokKind::Str(s) => Some(s)
    TokKind::KwAnd => Some("and")
    TokKind::KwOr => Some("or")
    TokKind::KwAs => Some("as")
    TokKind::KwIf => Some("if")
    TokKind::KwThen => Some("then")
    TokKind::KwElif => Some("elif")
    TokKind::KwElse => Some("else")
    TokKind::KwEnd => Some("end")
    TokKind::KwTry => Some("try")
    TokKind::KwCatch => Some("catch")
    TokKind::KwReduce => Some("reduce")
    TokKind::KwForeach => Some("foreach")
    TokKind::KwDef => Some("def")
    TokKind::KwLabel => Some("label")
    TokKind::KwBreak => Some("break")
    TokKind::KwNull => Some("null")
    TokKind::KwTrue => Some("true")
    TokKind::KwFalse => Some("false")
    _ => None
  }
}

fn is_builtin_func(name : String, arity : Int) -> Bool {
  if arity == 0 {
    name == "empty" || name == "not" || name == "type" || name == "length" ||
    name == "utf8bytelength" || name == "keys" || name == "keys_unsorted" ||
    name == "values" || name == "error" || name == "nan" || name == "infinite" ||
    name == "isnan" || name == "isinfinite" || name == "isfinite" || name == "isnormal" ||
    name == "floor" || name == "ceil" || name == "trunc" || name == "round" ||
    name == "fabs" || name == "abs" || name == "sqrt" || name == "add" ||
    name == "any" || name == "all" || name == "first" || name == "last" ||
    name == "reverse" || name == "sort" || name == "unique" || name == "min" ||
    name == "max" || name == "flatten" || name == "transpose" || name == "combinations" ||
    name == "to_entries" || name == "from_entries" || name == "arrays" ||
    name == "objects" || name == "iterables" || name == "booleans" ||
    name == "numbers" || name == "strings" || name == "nulls" || name == "scalars" ||
    name == "leaf_paths" || name == "paths" || name == "recurse" ||
    name == "tostring" || name == "tonumber" || name == "toboolean" ||
    name == "tojson" || name == "fromjson" || name == "ascii_downcase" ||
    name == "ascii_upcase" || name == "explode" || name == "implode" ||
    name == "tostream" || name == "env" || name == "builtins" ||
    name == "halt" || name == "halt_error" || name == "ltrim" || name == "rtrim" ||
    name == "trim" || name == "debug" || name == "stderr" || name == "normals" ||
    name == "finites"
  } else if arity == 1 {
    name == "select" || name == "map" || name == "map_values" || name == "with_entries" ||
    name == "error" || name == "first" || name == "last" || name == "isempty" ||
    name == "any" || name == "all" || name == "range" || name == "sort_by" ||
    name == "group_by" || name == "unique_by" || name == "min_by" || name == "max_by" ||
    name == "path" || name == "del" || name == "getpath" || name == "delpaths" ||
    name == "has" || name == "in" || name == "contains" || name == "inside" ||
    name == "flatten" || name == "indices" || name == "index" || name == "rindex" ||
    name == "ltrimstr" || name == "rtrimstr" || name == "trimstr" ||
    name == "startswith" || name == "endswith" || name == "split" || name == "join" ||
    name == "test" || name == "match" || name == "capture" || name == "scan" ||
    name == "splits" || name == "paths" || name == "repeat" || name == "walk" ||
    name == "IN" || name == "fromstream" || name == "nth" || name == "pick" ||
    name == "combinations" || name == "recurse" || name == "halt_error" ||
    name == "bsearch" || name == "add" || name == "debug"
  } else if arity == 2 {
    name == "limit" || name == "nth" || name == "range" || name == "setpath" ||
    name == "any" || name == "all" || name == "test" || name == "match" ||
    name == "capture" || name == "scan" || name == "splits" || name == "split" ||
    name == "sub" || name == "gsub" || name == "while" || name == "until" ||
    name == "IN" || name == "pow" || name == "recurse" || name == "skip" ||
    name == "ldexp"
  } else if arity == 3 {
    name == "range" || name == "sub" || name == "gsub"
  } else {
    false
  }
}

fn is_valid_format(fmt : String) -> Bool {
  fmt == "" || fmt == "text" || fmt == "json" || fmt == "html" || fmt == "uri" ||
  fmt == "csv" || fmt == "tsv" || fmt == "sh" || fmt == "base64" || fmt == "base64d"
}

struct ScopeNode {
  name : String
  arity : Int
  prev : Int
}

fn scope_has(nodes : Array[ScopeNode], head : Int, name : String, arity : Int) -> Bool {
  let mut cur = head
  while cur >= 0 {
    let nd = nodes[cur]
    if nd.name == name && nd.arity == arity {
      return true
    }
    cur = nd.prev
  }
  false
}

fn validate_pattern(
  exprs : Array[Expr],
  pat : Pattern,
  scopes : Array[ScopeNode],
  scope_head : Int,
) -> Result[Unit, JqError] {
  match pat {
    Pattern::Var(_) => Ok(())
    Pattern::ArrayPat(ps) => {
      let mut i = 0
      while i < ps.length() {
        match validate_pattern(exprs, ps[i], scopes, scope_head) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        i = i + 1
      }
      Ok(())
    }
    Pattern::ObjPat(es) => {
      let mut i = 0
      while i < es.length() {
        let (pk, sp) = es[i]
        match pk {
          PatKey::ExprKey(eid) =>
          match validate_expr(exprs, eid, scopes, scope_head) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          PatKey::LitKey(_) => ()
        }
        match validate_pattern(exprs, sp, scopes, scope_head) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        i = i + 1
      }
      Ok(())
    }
    Pattern::AltPat(ps) => {
      let mut i = 0
      while i < ps.length() {
        match validate_pattern(exprs, ps[i], scopes, scope_head) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        i = i + 1
      }
      Ok(())
    }
  }
}

///| Compile-time validation of all function calls and format names (iterative worklist).
fn validate_expr(
  exprs : Array[Expr],
  root : Int,
  scopes : Array[ScopeNode],
  init_scope : Int,
) -> Result[Unit, JqError] {
  let work : Array[(Int, Int)] = [(root, init_scope)]
  while work.length() > 0 {
    let (eid, sh) = match work.pop() {
      Some(p) => p
      None => break
    }
    if eid < 0 {
      continue
    }
    match exprs[eid] {
      Expr::Identity | Expr::Recurse | Expr::NullLit | Expr::BoolLit(_) |
      Expr::NumLit(_) | Expr::StrLit(_) | Expr::VarRef(_) | Expr::Break(_) => ()
      Expr::Format(fmt) =>
      if !is_valid_format(fmt) {
        return Err(JqError::CompileError("unknown format @" + fmt))
      }
      Expr::StrInterp(fmt, parts) => {
        if !is_valid_format(fmt) {
          return Err(JqError::CompileError("unknown format @" + fmt))
        }
        let mut i = 0
        while i < parts.length() {
          match parts[i] {
            StrPart::Interp(e) => work.push((e, sh))
            StrPart::Lit(_) => ()
          }
          i = i + 1
        }
      }
      Expr::ArrayCons(inner) => if inner >= 0 { work.push((inner, sh)) }
      Expr::ObjCons(entries) => {
        let mut i = 0
        while i < entries.length() {
          match entries[i].key {
            ObjKey::Expr(ke) => work.push((ke, sh))
            _ => ()
          }
          work.push((entries[i].val_expr, sh))
          i = i + 1
        }
      }
      Expr::Field(t, _, _) | Expr::FieldChain(t, _) | Expr::Iter(t, _) |
      Expr::Optional(t) | Expr::Neg(t) | Expr::Pos(t) | Expr::Label(_, t) =>
      work.push((t, sh))
      Expr::Index(t, idx, _) => {
        work.push((t, sh))
        work.push((idx, sh))
      }
      Expr::Slice(t, s, e, _) => {
        work.push((t, sh))
        if s >= 0 { work.push((s, sh)) }
        if e >= 0 { work.push((e, sh)) }
      }
      Expr::Bin(_, l, r) => {
        work.push((l, sh))
        work.push((r, sh))
      }
      Expr::PipeChain(stages) | Expr::CommaChain(stages) => {
        let mut i = 0
        while i < stages.length() {
          work.push((stages[i], sh))
          i = i + 1
        }
      }
      Expr::AddChain(first, rest) => {
        work.push((first, sh))
        let mut i = 0
        while i < rest.length() {
          let (_, r) = rest[i]
          work.push((r, sh))
          i = i + 1
        }
      }
      Expr::If(c, t, elifs, el) => {
        work.push((c, sh))
        work.push((t, sh))
        let mut i = 0
        while i < elifs.length() {
          work.push((elifs[i].cond, sh))
          work.push((elifs[i].body, sh))
          i = i + 1
        }
        if el >= 0 { work.push((el, sh)) }
      }
      Expr::Try(b, c) => {
        work.push((b, sh))
        if c >= 0 { work.push((c, sh)) }
      }
      Expr::As(v, pat, b) => {
        work.push((v, sh))
        match validate_pattern(exprs, pat, scopes, sh) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        work.push((b, sh))
      }
      Expr::Reduce(s, pat, init_e, upd_e) => {
        work.push((s, sh))
        match validate_pattern(exprs, pat, scopes, sh) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        work.push((init_e, sh))
        work.push((upd_e, sh))
      }
      Expr::Foreach(s, pat, init_e, upd_e, ext_e) => {
        work.push((s, sh))
        match validate_pattern(exprs, pat, scopes, sh) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        work.push((init_e, sh))
        work.push((upd_e, sh))
        if ext_e >= 0 { work.push((ext_e, sh)) }
      }
      Expr::Def(name, params, body, next) => {
        let fn_scope = scopes.length()
        scopes.push(ScopeNode::{ name: name, arity: params.length(), prev: sh })
        let mut body_scope = fn_scope
        let mut i = 0
        while i < params.length() {
          let p_id = scopes.length()
          scopes.push(ScopeNode::{ name: params[i], arity: 0, prev: body_scope })
          body_scope = p_id
          i = i + 1
        }
        work.push((next, fn_scope))
        work.push((body, body_scope))
      }
      Expr::Call(name, args) => {
        let arity = args.length()
        if !scope_has(scopes, sh, name, arity) && !is_builtin_func(name, arity) {
          return Err(
            JqError::CompileError("unknown function " + name + "/" + arity.to_string()),
          )
        }
        let mut i = 0
        while i < arity {
          work.push((args[i], sh))
          i = i + 1
        }
      }
    }
  }
  Ok(())
}

fn parse_query(src : String, limits : JqLimits) -> Result[Query, JqError] {
  let tokens = match tokenize(src, limits.max_depth) {
    Ok(ts) => ts
    Err(e) => return Err(e)
  }
  let p = Parser::new(tokens, limits.max_depth)
  let root = match p.parse_pipe() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match p.peek().kind {
    TokKind::Eof => ()
    _ => return Err(JqError::SyntaxError(p.peek().pos, "unexpected trailing token"))
  }
  let scopes : Array[ScopeNode] = []
  match validate_expr(p.exprs, root, scopes, -1) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  Ok(Query::{ source: src, exprs: p.exprs, root: root })
}

fn Parser::parse_pipe(self : Parser) -> Result[Int, JqError] {
  match self.enter() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let res = self.parse_pipe_inner()
  self.leave()
  res
}

fn Parser::parse_pipe_inner(self : Parser) -> Result[Int, JqError] {
  // Handle leading `def ...; body` or `label $x | body`
  match self.peek().kind {
    TokKind::KwDef => return self.parse_def()
    TokKind::KwLabel => return self.parse_label()
    _ => ()
  }
  let first = match self.parse_comma() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::KwAs => {
      let _ = self.advance()
      let pat = match self.parse_pattern() {
        Ok(pt) => pt
        Err(e) => return Err(e)
      }
      match self.peek().kind {
        TokKind::Pipe => {
          let _ = self.advance()
        }
        _ => return Err(JqError::SyntaxError(self.peek().pos, "expected '|' after 'as <pattern>'"))
      }
      let body = match self.parse_pipe() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      return Ok(self.alloc(Expr::As(first, pat, body)))
    }
    TokKind::Pipe => ()
    _ => return Ok(first)
  }
  // Iterative flat pipe chain: avoids deep recursion on 10k-long `| . | .` chains
  let stages : Array[Int] = [first]
  while true {
    match self.peek().kind {
      TokKind::Pipe => {
        let _ = self.advance()
        match self.peek().kind {
          TokKind::KwDef => {
            let tail = match self.parse_def() {
              Ok(id) => id
              Err(e) => return Err(e)
            }
            stages.push(tail)
            break
          }
          TokKind::KwLabel => {
            let tail = match self.parse_label() {
              Ok(id) => id
              Err(e) => return Err(e)
            }
            stages.push(tail)
            break
          }
          _ => {
            let stage = match self.parse_comma() {
              Ok(id) => id
              Err(e) => return Err(e)
            }
            match self.peek().kind {
              TokKind::KwAs => {
                let _ = self.advance()
                let pat = match self.parse_pattern() {
                  Ok(pt) => pt
                  Err(e) => return Err(e)
                }
                match self.peek().kind {
                  TokKind::Pipe => {
                    let _ = self.advance()
                  }
                  _ => return Err(JqError::SyntaxError(self.peek().pos, "expected '|' after 'as <pattern>'"))
                }
                let body = match self.parse_pipe() {
                  Ok(id) => id
                  Err(e) => return Err(e)
                }
                stages.push(self.alloc(Expr::As(stage, pat, body)))
                break
              }
              _ => stages.push(stage)
            }
          }
        }
      }
      _ => break
    }
  }
  if stages.length() == 2 {
    Ok(self.alloc(Expr::Bin(BinOp::Pipe, stages[0], stages[1])))
  } else {
    Ok(self.alloc(Expr::PipeChain(stages)))
  }
}

///| Object value expression (`ExpD`): accepts `|` pipes without parens, but stops at `,`.
fn Parser::parse_obj_val(self : Parser) -> Result[Int, JqError] {
  match self.enter() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let res = self.parse_obj_val_inner()
  self.leave()
  res
}

fn Parser::parse_obj_val_inner(self : Parser) -> Result[Int, JqError] {
  let first = match self.parse_assign() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::Pipe => ()
    _ => return Ok(first)
  }
  let stages : Array[Int] = [first]
  while true {
    match self.peek().kind {
      TokKind::Pipe => {
        let _ = self.advance()
        let stage = match self.parse_assign() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        stages.push(stage)
      }
      _ => break
    }
  }
  if stages.length() == 2 {
    Ok(self.alloc(Expr::Bin(BinOp::Pipe, stages[0], stages[1])))
  } else {
    Ok(self.alloc(Expr::PipeChain(stages)))
  }
}

fn Parser::parse_def(self : Parser) -> Result[Int, JqError] {
  let _ = self.advance() // consume 'def'
  let name = match self.peek().kind {
    TokKind::Ident(s) => {
      let _ = self.advance()
      s
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected function name after 'def'"))
  }
  let params : Array[String] = []
  let val_params : Array[(String, String)] = []
  match self.peek().kind {
    TokKind::LParen => {
      let _ = self.advance()
      match self.peek().kind {
        TokKind::RParen => {
          let _ = self.advance()
        }
        _ => {
          let mut more = true
          while more {
            match self.peek().kind {
              TokKind::Ident(pn) => {
                let _ = self.advance()
                params.push(pn)
              }
              TokKind::Var(vn) => {
                let _ = self.advance()
                // Unique synthetic name per position so duplicate `$g; $g` never collide
                let synth = "__val_param_" + params.length().to_string() + "_" + vn
                params.push(synth)
                val_params.push((synth, vn))
              }
              _ => return Err(JqError::SyntaxError(self.peek().pos, "expected parameter name in def"))
            }
            match self.peek().kind {
              TokKind::Semicolon => {
                let _ = self.advance()
              }
              TokKind::RParen => {
                let _ = self.advance()
                more = false
              }
              _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ';' or ')' in def parameters"))
            }
          }
        }
      }
    }
    _ => ()
  }
  match self.peek().kind {
    TokKind::Colon => {
      let _ = self.advance()
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ':' after def signature"))
  }
  let raw_body = match self.parse_pipe() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let mut body = raw_body
  let mut k = val_params.length() - 1
  while k >= 0 {
    let (synth, vn) = val_params[k]
    let call_id = self.alloc(Expr::Call(synth, []))
    body = self.alloc(Expr::As(call_id, Pattern::Var(vn), body))
    k = k - 1
  }
  match self.peek().kind {
    TokKind::Semicolon => {
      let _ = self.advance()
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ';' after def body"))
  }
  let next = match self.parse_pipe() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  Ok(self.alloc(Expr::Def(name, params, body, next)))
}

fn Parser::parse_label(self : Parser) -> Result[Int, JqError] {
  let _ = self.advance() // consume 'label'
  let name = match self.peek().kind {
    TokKind::Var(s) => {
      let _ = self.advance()
      s
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected $label after 'label'"))
  }
  match self.peek().kind {
    TokKind::Pipe => {
      let _ = self.advance()
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected '|' after label $name"))
  }
  let body = match self.parse_pipe() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  Ok(self.alloc(Expr::Label(name, body)))
}

fn Parser::parse_pattern(self : Parser) -> Result[Pattern, JqError] {
  match self.enter() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let first = match self.parse_pattern_single() {
    Ok(pt) => pt
    Err(e) => {
      self.leave()
      return Err(e)
    }
  }
  match self.peek().kind {
    TokKind::AltPat => {
      let alts : Array[Pattern] = [first]
      while true {
        match self.peek().kind {
          TokKind::AltPat => {
            let _ = self.advance()
            let next_pt = match self.parse_pattern_single() {
              Ok(pt) => pt
              Err(e) => {
                self.leave()
                return Err(e)
              }
            }
            alts.push(next_pt)
          }
          _ => break
        }
      }
      self.leave()
      Ok(Pattern::AltPat(alts))
    }
    _ => {
      self.leave()
      Ok(first)
    }
  }
}

fn Parser::parse_pattern_single(self : Parser) -> Result[Pattern, JqError] {
  match self.peek().kind {
    TokKind::Var(name) => {
      let _ = self.advance()
      Ok(Pattern::Var(name))
    }
    TokKind::LBracket => {
      let _ = self.advance()
      let items : Array[Pattern] = []
      match self.peek().kind {
        TokKind::RBracket => {
          let _ = self.advance()
          return Ok(Pattern::ArrayPat(items))
        }
        _ => ()
      }
      let mut more = true
      while more {
        let item = match self.parse_pattern() {
          Ok(pt) => pt
          Err(e) => return Err(e)
        }
        items.push(item)
        match self.peek().kind {
          TokKind::Comma => {
            let _ = self.advance()
          }
          TokKind::RBracket => {
            let _ = self.advance()
            more = false
          }
          _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ',' or ']' in array pattern"))
        }
      }
      Ok(Pattern::ArrayPat(items))
    }
    TokKind::LBrace => {
      let _ = self.advance()
      let entries : Array[(PatKey, Pattern)] = []
      match self.peek().kind {
        TokKind::RBrace => {
          let _ = self.advance()
          return Ok(Pattern::ObjPat(entries))
        }
        _ => ()
      }
      let mut more = true
      while more {
        match self.peek().kind {
          TokKind::Var(vn) => {
            let _ = self.advance()
            match self.peek().kind {
              TokKind::Colon => {
                let _ = self.advance()
                let sub = match self.parse_pattern() {
                  Ok(pt) => pt
                  Err(e) => return Err(e)
                }
                entries.push((PatKey::LitKey(vn), sub))
              }
              _ => entries.push((PatKey::LitKey(vn), Pattern::Var(vn)))
            }
          }
          TokKind::LParen => {
            let _ = self.advance()
            let kexpr = match self.parse_pipe() {
              Ok(id) => id
              Err(e) => return Err(e)
            }
            match self.peek().kind {
              TokKind::RParen => {
                let _ = self.advance()
              }
              _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ')' after computed pattern key"))
            }
            match self.peek().kind {
              TokKind::Colon => {
                let _ = self.advance()
              }
              _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ':' in object pattern"))
            }
            let sub = match self.parse_pattern() {
              Ok(pt) => pt
              Err(e) => return Err(e)
            }
            entries.push((PatKey::ExprKey(kexpr), sub))
          }
          _ => {
            let kname = match token_as_key_name(self.peek().kind) {
              Some(k) => {
                let _ = self.advance()
                k
              }
              None => return Err(JqError::SyntaxError(self.peek().pos, "expected key in object pattern"))
            }
            match self.peek().kind {
              TokKind::Colon => {
                let _ = self.advance()
              }
              _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ':' after key in object pattern"))
            }
            let sub = match self.parse_pattern() {
              Ok(pt) => pt
              Err(e) => return Err(e)
            }
            entries.push((PatKey::LitKey(kname), sub))
          }
        }
        match self.peek().kind {
          TokKind::Comma => {
            let _ = self.advance()
          }
          TokKind::RBrace => {
            let _ = self.advance()
            more = false
          }
          _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ',' or '}' in object pattern"))
        }
      }
      Ok(Pattern::ObjPat(entries))
    }
    _ => Err(JqError::SyntaxError(self.peek().pos, "expected variable or destructuring pattern"))
  }
}

fn Parser::parse_comma(self : Parser) -> Result[Int, JqError] {
  let first = match self.parse_assign() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::Comma => ()
    _ => return Ok(first)
  }
  let items : Array[Int] = [first]
  while true {
    match self.peek().kind {
      TokKind::Comma => {
        let _ = self.advance()
        let rhs = match self.parse_assign() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        items.push(rhs)
      }
      _ => break
    }
  }
  if items.length() == 2 {
    Ok(self.alloc(Expr::Bin(BinOp::Comma, items[0], items[1])))
  } else {
    Ok(self.alloc(Expr::CommaChain(items)))
  }
}

fn Parser::parse_assign(self : Parser) -> Result[Int, JqError] {
  let lhs = match self.parse_alt() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let op = match self.peek().kind {
    TokKind::Assign => Some(BinOp::Assign)
    TokKind::Update => Some(BinOp::Update)
    TokKind::AddAssign => Some(BinOp::AddAssign)
    TokKind::SubAssign => Some(BinOp::SubAssign)
    TokKind::MulAssign => Some(BinOp::MulAssign)
    TokKind::DivAssign => Some(BinOp::DivAssign)
    TokKind::ModAssign => Some(BinOp::ModAssign)
    TokKind::AltAssign => Some(BinOp::AltAssign)
    _ => None
  }
  match op {
    Some(bop) => {
      let _ = self.advance()
      let rhs = match self.parse_assign() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      Ok(self.alloc(Expr::Bin(bop, lhs, rhs)))
    }
    None => Ok(lhs)
  }
}

fn Parser::parse_alt(self : Parser) -> Result[Int, JqError] {
  let lhs = match self.parse_or() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::Alt => {
      let _ = self.advance()
      let rhs = match self.parse_alt() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      Ok(self.alloc(Expr::Bin(BinOp::Alt, lhs, rhs)))
    }
    _ => Ok(lhs)
  }
}

fn Parser::parse_or(self : Parser) -> Result[Int, JqError] {
  let mut lhs = match self.parse_and() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while true {
    match self.peek().kind {
      TokKind::KwOr => {
        let _ = self.advance()
        let rhs = match self.parse_and() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        lhs = self.alloc(Expr::Bin(BinOp::Or, lhs, rhs))
      }
      _ => break
    }
  }
  Ok(lhs)
}

fn Parser::parse_and(self : Parser) -> Result[Int, JqError] {
  let mut lhs = match self.parse_cmp() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while true {
    match self.peek().kind {
      TokKind::KwAnd => {
        let _ = self.advance()
        let rhs = match self.parse_cmp() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        lhs = self.alloc(Expr::Bin(BinOp::And, lhs, rhs))
      }
      _ => break
    }
  }
  Ok(lhs)
}

fn Parser::parse_cmp(self : Parser) -> Result[Int, JqError] {
  let lhs = match self.parse_add() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let op = match self.peek().kind {
    TokKind::EqEq => Some(BinOp::Eq)
    TokKind::NotEq => Some(BinOp::Ne)
    TokKind::Lt => Some(BinOp::Lt)
    TokKind::Le => Some(BinOp::Le)
    TokKind::Gt => Some(BinOp::Gt)
    TokKind::Ge => Some(BinOp::Ge)
    _ => None
  }
  match op {
    Some(bop) => {
      let _ = self.advance()
      let rhs = match self.parse_add() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      Ok(self.alloc(Expr::Bin(bop, lhs, rhs)))
    }
    None => Ok(lhs)
  }
}

fn Parser::parse_add(self : Parser) -> Result[Int, JqError] {
  let first = match self.parse_mul() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let rest : Array[(BinOp, Int)] = []
  while true {
    match self.peek().kind {
      TokKind::Plus => {
        let _ = self.advance()
        let rhs = match self.parse_mul() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        rest.push((BinOp::Add, rhs))
      }
      TokKind::Minus => {
        let _ = self.advance()
        let rhs = match self.parse_mul() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        rest.push((BinOp::Sub, rhs))
      }
      _ => break
    }
  }
  if rest.length() == 0 {
    Ok(first)
  } else if rest.length() == 1 {
    let (op, r) = rest[0]
    Ok(self.alloc(Expr::Bin(op, first, r)))
  } else {
    Ok(self.alloc(Expr::AddChain(first, rest)))
  }
}

fn Parser::parse_mul(self : Parser) -> Result[Int, JqError] {
  let mut lhs = match self.parse_unary() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  while true {
    match self.peek().kind {
      TokKind::Star => {
        let _ = self.advance()
        let rhs = match self.parse_unary() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        lhs = self.alloc(Expr::Bin(BinOp::Mul, lhs, rhs))
      }
      TokKind::Slash => {
        let _ = self.advance()
        let rhs = match self.parse_unary() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        lhs = self.alloc(Expr::Bin(BinOp::Div, lhs, rhs))
      }
      TokKind::Percent => {
        let _ = self.advance()
        let rhs = match self.parse_unary() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        lhs = self.alloc(Expr::Bin(BinOp::Mod, lhs, rhs))
      }
      _ => break
    }
  }
  Ok(lhs)
}

fn Parser::parse_unary(self : Parser) -> Result[Int, JqError] {
  match self.peek().kind {
    TokKind::Minus => {
      let _ = self.advance()
      let inner = match self.parse_unary() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      Ok(self.alloc(Expr::Neg(inner)))
    }
    TokKind::Plus => {
      let _ = self.advance()
      let inner = match self.parse_unary() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      Ok(self.alloc(Expr::Pos(inner)))
    }
    TokKind::KwTry => {
      // jq grammar: `try Term (catch Term)?` — binds tighter than `+`, `//`, etc.
      let _ = self.advance()
      let body = match self.parse_unary() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      let catch_id = match self.peek().kind {
        TokKind::KwCatch => {
          let _ = self.advance()
          match self.parse_unary() {
            Ok(id) => id
            Err(e) => return Err(e)
          }
        }
        _ => -1
      }
      Ok(self.alloc(Expr::Try(body, catch_id)))
    }
    _ => self.parse_postfix()
  }
}

fn Parser::parse_postfix(self : Parser) -> Result[Int, JqError] {
  let mut expr = match self.parse_primary() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let mut field_chain : Array[(String, Bool)] = []
  let mut field_base = -1
  while true {
    match self.peek().kind {
      TokKind::Dot => {
        let dot_tok = self.advance()
        let next_tok = self.peek()
        match next_tok.kind {
          TokKind::Str(s) => {
            let _ = self.advance()
            if field_base < 0 {
              field_base = expr
            }
            field_chain.push((s, false))
          }
          TokKind::StrStart(s) => {
            // Flush pending field chain
            if field_chain.length() > 0 {
              expr = if field_chain.length() == 1 {
                let (fnm, fopt) = field_chain[0]
                self.alloc(Expr::Field(field_base, fnm, fopt))
              } else {
                self.alloc(Expr::FieldChain(field_base, field_chain))
              }
              field_chain = []
              field_base = -1
            }
            let _ = self.advance()
            let kexpr = match self.parse_interp_string("", s) {
              Ok(id) => id
              Err(e) => return Err(e)
            }
            expr = self.alloc(Expr::Index(expr, kexpr, false))
          }
          TokKind::LBracket => {
            // `.a.[0]` syntax (P2-6)
            if field_chain.length() > 0 {
              expr = if field_chain.length() == 1 {
                let (fnm, fopt) = field_chain[0]
                self.alloc(Expr::Field(field_base, fnm, fopt))
              } else {
                self.alloc(Expr::FieldChain(field_base, field_chain))
              }
              field_chain = []
              field_base = -1
            }
            expr = match self.parse_bracket_suffix(expr) {
              Ok(id) => id
              Err(e) => return Err(e)
            }
          }
          _ => {
            // Reject whitespace between '.' and field name (`. a` is a syntax error)
            if next_tok.pos != dot_tok.pos + 1 {
              return Err(JqError::SyntaxError(next_tok.pos, "expected field name immediately after '.'"))
            }
            match token_as_key_name(next_tok.kind) {
              Some(name) => {
                let _ = self.advance()
                if field_base < 0 {
                  field_base = expr
                }
                field_chain.push((name, false))
              }
              None => return Err(JqError::SyntaxError(next_tok.pos, "expected field name after '.'"))
            }
          }
        }
      }
      TokKind::LBracket => {
        if field_chain.length() > 0 {
          expr = if field_chain.length() == 1 {
            let (fnm, fopt) = field_chain[0]
            self.alloc(Expr::Field(field_base, fnm, fopt))
          } else {
            self.alloc(Expr::FieldChain(field_base, field_chain))
          }
          field_chain = []
          field_base = -1
        }
        expr = match self.parse_bracket_suffix(expr) {
          Ok(id) => id
          Err(e) => return Err(e)
        }
      }
      TokKind::Question => {
        let _ = self.advance()
        if field_chain.length() > 0 {
          let last_idx = field_chain.length() - 1
          let (fnm, _) = field_chain[last_idx]
          field_chain[last_idx] = (fnm, true)
        } else {
          match self.exprs[expr] {
            Expr::Field(t, k, _) => self.exprs[expr] = Expr::Field(t, k, true)
            Expr::Index(t, idx, _) => self.exprs[expr] = Expr::Index(t, idx, true)
            Expr::Slice(t, s, e, _) => self.exprs[expr] = Expr::Slice(t, s, e, true)
            Expr::Iter(t, _) => self.exprs[expr] = Expr::Iter(t, true)
            _ => expr = self.alloc(Expr::Optional(expr))
          }
        }
      }
      _ => break
    }
  }
  if field_chain.length() > 0 {
    expr = if field_chain.length() == 1 {
      let (fnm, fopt) = field_chain[0]
      self.alloc(Expr::Field(field_base, fnm, fopt))
    } else {
      self.alloc(Expr::FieldChain(field_base, field_chain))
    }
  }
  Ok(expr)
}

fn Parser::parse_bracket_suffix(self : Parser, target : Int) -> Result[Int, JqError] {
  let _ = self.advance() // consume '['
  match self.peek().kind {
    TokKind::RBracket => {
      let _ = self.advance()
      return Ok(self.alloc(Expr::Iter(target, false)))
    }
    TokKind::Colon => {
      let _ = self.advance()
      let end_id = match self.peek().kind {
        TokKind::RBracket => -1
        _ => match self.parse_pipe() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
      }
      match self.peek().kind {
        TokKind::RBracket => {
          let _ = self.advance()
          return Ok(self.alloc(Expr::Slice(target, -1, end_id, false)))
        }
        _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ']' after slice"))
      }
    }
    _ => ()
  }
  let first = match self.parse_pipe() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::Colon => {
      let _ = self.advance()
      let end_id = match self.peek().kind {
        TokKind::RBracket => -1
        _ => match self.parse_pipe() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
      }
      match self.peek().kind {
        TokKind::RBracket => {
          let _ = self.advance()
          Ok(self.alloc(Expr::Slice(target, first, end_id, false)))
        }
        _ => Err(JqError::SyntaxError(self.peek().pos, "expected ']' after slice"))
      }
    }
    TokKind::RBracket => {
      let _ = self.advance()
      Ok(self.alloc(Expr::Index(target, first, false)))
    }
    _ => Err(JqError::SyntaxError(self.peek().pos, "expected ']' or ':' in index expression"))
  }
}

fn Parser::parse_interp_string(
  self : Parser,
  fmt : String,
  first_lit : String,
) -> Result[Int, JqError] {
  let parts : Array[StrPart] = []
  if first_lit.length() > 0 {
    parts.push(StrPart::Lit(first_lit))
  }
  let mut done = false
  while !done {
    let inner = match self.parse_pipe() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    parts.push(StrPart::Interp(inner))
    match self.peek().kind {
      TokKind::StrMid(s) => {
        let _ = self.advance()
        if s.length() > 0 {
          parts.push(StrPart::Lit(s))
        }
      }
      TokKind::StrEnd(s) => {
        let _ = self.advance()
        if s.length() > 0 {
          parts.push(StrPart::Lit(s))
        }
        done = true
      }
      _ => return Err(JqError::SyntaxError(self.peek().pos, "expected continuation of interpolated string"))
    }
  }
  Ok(self.alloc(Expr::StrInterp(fmt, parts)))
}

fn Parser::parse_primary(self : Parser) -> Result[Int, JqError] {
  match self.enter() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let res = self.parse_primary_inner()
  self.leave()
  res
}

fn Parser::parse_primary_inner(self : Parser) -> Result[Int, JqError] {
  let tok = self.peek()
  match tok.kind {
    TokKind::Dot => {
      let dot_tok = self.advance()
      let id_expr = self.alloc(Expr::Identity)
      let next_tok = self.peek()
      match next_tok.kind {
        TokKind::Str(s) => {
          let _ = self.advance()
          Ok(self.alloc(Expr::Field(id_expr, s, false)))
        }
        TokKind::StrStart(s) => {
          let _ = self.advance()
          let kexpr = match self.parse_interp_string("", s) {
            Ok(id) => id
            Err(e) => return Err(e)
          }
          Ok(self.alloc(Expr::Index(id_expr, kexpr, false)))
        }
        TokKind::LBracket => self.parse_bracket_suffix(id_expr)
        _ => {
          // Only bind `.field` (including keyword fields like `.and`, `.or`) if immediately adjacent!
          if next_tok.pos == dot_tok.pos + 1 {
            match token_as_key_name(next_tok.kind) {
              Some(name) => {
                let _ = self.advance()
                Ok(self.alloc(Expr::Field(id_expr, name, false)))
              }
              None => Ok(id_expr)
            }
          } else {
            Ok(id_expr)
          }
        }
      }
    }
    TokKind::DotDot => {
      let _ = self.advance()
      Ok(self.alloc(Expr::Recurse))
    }
    TokKind::KwNull => {
      let _ = self.advance()
      Ok(self.alloc(Expr::NullLit))
    }
    TokKind::KwTrue => {
      let _ = self.advance()
      Ok(self.alloc(Expr::BoolLit(true)))
    }
    TokKind::KwFalse => {
      let _ = self.advance()
      Ok(self.alloc(Expr::BoolLit(false)))
    }
    TokKind::Num(v) => {
      let _ = self.advance()
      Ok(self.alloc(Expr::NumLit(v)))
    }
    TokKind::Str(s) => {
      let _ = self.advance()
      Ok(self.alloc(Expr::StrLit(s)))
    }
    TokKind::StrStart(s) => {
      let _ = self.advance()
      self.parse_interp_string("", s)
    }
    TokKind::Format(fmt) => {
      let _ = self.advance()
      match self.peek().kind {
        TokKind::Str(s) => {
          let _ = self.advance()
          Ok(self.alloc(Expr::StrInterp(fmt, [StrPart::Lit(s)])))
        }
        TokKind::StrStart(s) => {
          let _ = self.advance()
          self.parse_interp_string(fmt, s)
        }
        _ => Ok(self.alloc(Expr::Format(fmt)))
      }
    }
    TokKind::Var(name) => {
      let _ = self.advance()
      Ok(self.alloc(Expr::VarRef(name)))
    }
    TokKind::LParen => {
      let _ = self.advance()
      let inner = match self.parse_pipe() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
      match self.peek().kind {
        TokKind::RParen => {
          let _ = self.advance()
          Ok(inner)
        }
        _ => Err(JqError::SyntaxError(self.peek().pos, "expected ')'"))
      }
    }
    TokKind::LBracket => {
      let _ = self.advance()
      match self.peek().kind {
        TokKind::RBracket => {
          let _ = self.advance()
          Ok(self.alloc(Expr::ArrayCons(-1)))
        }
        _ => {
          let inner = match self.parse_pipe() {
            Ok(id) => id
            Err(e) => return Err(e)
          }
          match self.peek().kind {
            TokKind::RBracket => {
              let _ = self.advance()
              Ok(self.alloc(Expr::ArrayCons(inner)))
            }
            _ => Err(JqError::SyntaxError(self.peek().pos, "expected ']'"))
          }
        }
      }
    }
    TokKind::LBrace => self.parse_object()
    TokKind::KwIf => self.parse_if()
    TokKind::KwReduce => self.parse_reduce()
    TokKind::KwForeach => self.parse_foreach()
    TokKind::KwBreak => {
      let _ = self.advance()
      match self.peek().kind {
        TokKind::Var(name) => {
          let _ = self.advance()
          Ok(self.alloc(Expr::Break(name)))
        }
        _ => Err(JqError::SyntaxError(self.peek().pos, "expected $label after 'break'"))
      }
    }
    TokKind::Ident(name) => {
      let _ = self.advance()
      let args : Array[Int] = []
      match self.peek().kind {
        TokKind::LParen => {
          let _ = self.advance()
          match self.peek().kind {
            TokKind::RParen => {
              let _ = self.advance()
            }
            _ => {
              let mut more = true
              while more {
                let arg = match self.parse_pipe() {
                  Ok(id) => id
                  Err(e) => return Err(e)
                }
                args.push(arg)
                match self.peek().kind {
                  TokKind::Semicolon => {
                    let _ = self.advance()
                  }
                  TokKind::RParen => {
                    let _ = self.advance()
                    more = false
                  }
                  _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ';' or ')' in function call"))
                }
              }
            }
          }
        }
        _ => ()
      }
      Ok(self.alloc(Expr::Call(name, args)))
    }
    _ => Err(JqError::SyntaxError(tok.pos, "unexpected token in expression"))
  }
}

fn Parser::parse_object(self : Parser) -> Result[Int, JqError] {
  let _ = self.advance() // consume '{'
  let entries : Array[ObjEntry] = []
  match self.peek().kind {
    TokKind::RBrace => {
      let _ = self.advance()
      return Ok(self.alloc(Expr::ObjCons(entries)))
    }
    _ => ()
  }
  let mut more = true
  while more {
    match self.peek().kind {
      TokKind::RBrace => {
        let _ = self.advance()
        break
      }
      TokKind::LParen => {
        let _ = self.advance()
        let kexpr = match self.parse_pipe() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        match self.peek().kind {
          TokKind::RParen => {
            let _ = self.advance()
          }
          _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ')' after computed object key"))
        }
        match self.peek().kind {
          TokKind::Colon => {
            let _ = self.advance()
          }
          _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ':' after computed object key"))
        }
        let vexpr = match self.parse_obj_val() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        entries.push(ObjEntry::{ key: ObjKey::Expr(kexpr), val_expr: vexpr })
      }
      TokKind::Var(vn) => {
        let _ = self.advance()
        match self.peek().kind {
          TokKind::Colon => {
            let _ = self.advance()
            let vexpr = match self.parse_obj_val() {
              Ok(id) => id
              Err(e) => return Err(e)
            }
            let kexpr = self.alloc(Expr::VarRef(vn))
            entries.push(ObjEntry::{ key: ObjKey::Expr(kexpr), val_expr: vexpr })
          }
          _ => {
            let vexpr = self.alloc(Expr::VarRef(vn))
            entries.push(ObjEntry::{ key: ObjKey::VarKey(vn), val_expr: vexpr })
          }
        }
      }
      TokKind::StrStart(s) => {
        let _ = self.advance()
        let kexpr = match self.parse_interp_string("", s) {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        match self.peek().kind {
          TokKind::Colon => {
            let _ = self.advance()
            let vexpr = match self.parse_obj_val() {
              Ok(id) => id
              Err(e) => return Err(e)
            }
            entries.push(ObjEntry::{ key: ObjKey::Expr(kexpr), val_expr: vexpr })
          }
          _ => {
            let id_expr = self.alloc(Expr::Identity)
            let vexpr = self.alloc(Expr::Index(id_expr, kexpr, false))
            entries.push(ObjEntry::{ key: ObjKey::Expr(kexpr), val_expr: vexpr })
          }
        }
      }
      _ => {
        let kname = match token_as_key_name(self.peek().kind) {
          Some(k) => {
            let _ = self.advance()
            k
          }
          None => return Err(JqError::SyntaxError(self.peek().pos, "expected object key"))
        }
        match self.peek().kind {
          TokKind::Colon => {
            let _ = self.advance()
            let vexpr = match self.parse_obj_val() {
              Ok(id) => id
              Err(e) => return Err(e)
            }
            entries.push(ObjEntry::{ key: ObjKey::Lit(kname), val_expr: vexpr })
          }
          _ => {
            let id_expr = self.alloc(Expr::Identity)
            let vexpr = self.alloc(Expr::Field(id_expr, kname, false))
            entries.push(ObjEntry::{ key: ObjKey::Lit(kname), val_expr: vexpr })
          }
        }
      }
    }
    match self.peek().kind {
      TokKind::Comma => {
        let _ = self.advance()
      }
      TokKind::RBrace => {
        let _ = self.advance()
        more = false
      }
      _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ',' or '}' in object literal"))
    }
  }
  Ok(self.alloc(Expr::ObjCons(entries)))
}

fn Parser::parse_if(self : Parser) -> Result[Int, JqError] {
  let _ = self.advance() // consume 'if'
  let cond = match self.parse_pipe() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::KwThen => {
      let _ = self.advance()
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected 'then'"))
  }
  let then_expr = match self.parse_pipe() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let elifs : Array[ElifBranch] = []
  while true {
    match self.peek().kind {
      TokKind::KwElif => {
        let _ = self.advance()
        let ec = match self.parse_pipe() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        match self.peek().kind {
          TokKind::KwThen => {
            let _ = self.advance()
          }
          _ => return Err(JqError::SyntaxError(self.peek().pos, "expected 'then' after 'elif'"))
        }
        let eb = match self.parse_pipe() {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        elifs.push(ElifBranch::{ cond: ec, body: eb })
      }
      _ => break
    }
  }
  let else_expr = match self.peek().kind {
    TokKind::KwElse => {
      let _ = self.advance()
      match self.parse_pipe() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
    }
    _ => -1
  }
  match self.peek().kind {
    TokKind::KwEnd => {
      let _ = self.advance()
      Ok(self.alloc(Expr::If(cond, then_expr, elifs, else_expr)))
    }
    _ => Err(JqError::SyntaxError(self.peek().pos, "expected 'end' to close 'if'"))
  }
}

fn Parser::parse_reduce(self : Parser) -> Result[Int, JqError] {
  let _ = self.advance() // consume 'reduce'
  let source = match self.parse_comma() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::KwAs => {
      let _ = self.advance()
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected 'as' in reduce"))
  }
  let pat = match self.parse_pattern() {
    Ok(pt) => pt
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::LParen => {
      let _ = self.advance()
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected '(' in reduce"))
  }
  let init = match self.parse_pipe() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::Semicolon => {
      let _ = self.advance()
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ';' in reduce"))
  }
  let update = match self.parse_pipe() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::RParen => {
      let _ = self.advance()
      Ok(self.alloc(Expr::Reduce(source, pat, init, update)))
    }
    _ => Err(JqError::SyntaxError(self.peek().pos, "expected ')' in reduce"))
  }
}

fn Parser::parse_foreach(self : Parser) -> Result[Int, JqError] {
  let _ = self.advance() // consume 'foreach'
  let source = match self.parse_comma() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::KwAs => {
      let _ = self.advance()
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected 'as' in foreach"))
  }
  let pat = match self.parse_pattern() {
    Ok(pt) => pt
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::LParen => {
      let _ = self.advance()
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected '(' in foreach"))
  }
  let init = match self.parse_pipe() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  match self.peek().kind {
    TokKind::Semicolon => {
      let _ = self.advance()
    }
    _ => return Err(JqError::SyntaxError(self.peek().pos, "expected ';' in foreach"))
  }
  let update = match self.parse_pipe() {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  let extract = match self.peek().kind {
    TokKind::Semicolon => {
      let _ = self.advance()
      match self.parse_pipe() {
        Ok(id) => id
        Err(e) => return Err(e)
      }
    }
    _ => -1
  }
  match self.peek().kind {
    TokKind::RParen => {
      let _ = self.advance()
      Ok(self.alloc(Expr::Foreach(source, pat, init, update, extract)))
    }
    _ => Err(JqError::SyntaxError(self.peek().pos, "expected ')' in foreach"))
  }
}
