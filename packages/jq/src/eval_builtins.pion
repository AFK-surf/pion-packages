  if name == "join" {
    let seps = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let items = match jq_iter_values(input) {
      Some(xs) => xs
      None => return Err(EvalSignal::Error(JqError::RuntimeError("cannot iterate over " + jq_type_name(input))))
    }
    let mut si = 0
    while si < seps.length() {
      let sep = match seps[si] {
        JqVal::Str(s) => s
        _ => return Err(EvalSignal::Error(JqError::RuntimeError("join separator must be string")))
      }
      let sb = StringBuilder::new()
      let mut i = 0
      while i < items.length() {
        if i > 0 {
          sb.write_string(sep)
        }
        match items[i] {
          JqVal::Null => ()
          JqVal::Str(s) => sb.write_string(s)
          JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) | JqVal::Bool(_) =>
          match serialize_jq_val(items[i], false, self.limits.max_output_bytes) {
            Ok(s) => sb.write_string(s)
            Err(e) => return Err(EvalSignal::Error(e))
          }
          other =>
          return Err(EvalSignal::Error(JqError::RuntimeError("cannot join " + jq_type_name(other))))
        }
        if sb.length() > self.limits.max_output_bytes {
          return Err(EvalSignal::Error(JqError::LimitExceeded("join exceeds max_output_bytes")))
        }
        i = i + 1
      }
      match self.emit(sink, JqVal::Str(sb.to_string())) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      si = si + 1
    }
    return Ok(())
  }
  if name == "test" || name == "match" || name == "capture" || name == "scan" || name == "splits" {
    return self.eval_regex_builtin(name, arg0, -1, input, venv, fenv, sink)
  }
  Err(EvalSignal::Error(JqError::CompileError("unknown function " + name + "/1")))
}

fn EvalCtx::eval_builtin_2(
  self : EvalCtx,
  name : String,
  arg0 : Int,
  arg1 : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  if name == "limit" {
    let ns = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let mut i = 0
    while i < ns.length() {
      match ns[i] {
        JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => {
          let n = match jq_val_to_int_index(ns[i]) {
            Some(k) => k
            None =>
            match jq_val_to_double(ns[i]) {
              Some(d) => if d > 0.0 { 2147483647 } else { 0 }
              None => 0
            }
          }
          if n < 0 {
            return Err(EvalSignal::Error(JqError::RuntimeError("limit doesn't support negative count")))
          }
          // P0-4: Stream directly into `sink` so break/error preserves emitted prefix!
          match self.eval_streaming_limit(n, arg1, input, venv, fenv, sink) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
        }
        _ => return Err(EvalSignal::Error(JqError::RuntimeError("limit requires a number")))
      }
      i = i + 1
    }
    return Ok(())
  }
  if name == "skip" {
    let ns = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let mut i = 0
    while i < ns.length() {
      let n = match jq_val_to_int_index(ns[i]) {
        Some(k) => k
        None => return Err(EvalSignal::Error(JqError::RuntimeError("skip requires integer")))
      }
      if n < 0 {
        return Err(EvalSignal::Error(JqError::RuntimeError("skip count cannot be negative")))
      }
      let prev_skip = sink.skip_remaining
      sink.skip_remaining = prev_skip + n
      let r = self.eval(arg1, input, venv, fenv, sink)
      sink.skip_remaining = prev_skip
      match r {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      i = i + 1
    }
    return Ok(())
  }
  if name == "nth" {
    let ns = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let mut i = 0
    while i < ns.length() {
      match ns[i] {
        JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => {
          let n = match jq_val_to_int_index(ns[i]) {
            Some(k) => k
            None => return Err(EvalSignal::Error(JqError::RuntimeError("invalid nth index")))
          }
          if n < 0 {
            return Err(EvalSignal::Error(JqError::RuntimeError("nth index cannot be negative")))
          }
          let prev_skip = sink.skip_remaining
          sink.skip_remaining = n
          let r = self.eval_streaming_limit(1, arg1, input, venv, fenv, sink)
          sink.skip_remaining = prev_skip
          match r {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
        }
        _ => return Err(EvalSignal::Error(JqError::RuntimeError("nth requires a number")))
      }
      i = i + 1
    }
    return Ok(())
  }
  if name == "while" {
    let stack : Array[JqVal] = [input]
    while stack.length() > 0 {
      let v = match stack.pop() {
        Some(x) => x
        None => break
      }
      match self.step() {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let cs = match self.eval_collect(arg0, v, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut ci = 0
      while ci < cs.length() {
        if jq_truthy(cs[ci]) {
          match self.emit(sink, v) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          let nexts = match self.eval_collect(arg1, v, venv, fenv) {
            Ok(xs) => xs
            Err(e) => return Err(e)
          }
          let mut k = nexts.length() - 1
          while k >= 0 {
            stack.push(nexts[k])
            k = k - 1
          }
        }
        ci = ci + 1
      }
    }
    return Ok(())
  }
  if name == "until" {
    let stack : Array[JqVal] = [input]
    while stack.length() > 0 {
      let v = match stack.pop() {
        Some(x) => x
        None => break
      }
      match self.step() {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let cs = match self.eval_collect(arg0, v, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut ci = 0
      while ci < cs.length() {
        if jq_truthy(cs[ci]) {
          match self.emit(sink, v) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
        } else {
          let nexts = match self.eval_collect(arg1, v, venv, fenv) {
            Ok(xs) => xs
            Err(e) => return Err(e)
          }
          let mut k = nexts.length() - 1
          while k >= 0 {
            stack.push(nexts[k])
            k = k - 1
          }
        }
        ci = ci + 1
      }
    }
    return Ok(())
  }
  if name == "IN" {
    let srcs = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let ys = match self.eval_collect(arg1, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let mut i = 0
    while i < srcs.length() {
      let mut j = 0
      while j < ys.length() {
        if jq_eq(srcs[i], ys[j]) {
          return self.emit(sink, JqVal::Bool(true))
        }
        j = j + 1
      }
      i = i + 1
    }
    return self.emit(sink, JqVal::Bool(false))
  }
  if name == "ldexp" {
    let xs = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let ys = match self.eval_collect(arg1, input, venv, fenv) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let mut j = 0
    while j < ys.length() {
      let mut i = 0
      while i < xs.length() {
        let dx = match jq_val_to_double(xs[i]) {
          Some(d) => d
          None => return Err(EvalSignal::Error(JqError::RuntimeError("ldexp requires numbers")))
        }
        let dy = match jq_val_to_double(ys[j]) {
          Some(d) => d
          None => return Err(EvalSignal::Error(JqError::RuntimeError("ldexp requires numbers")))
        }
        match self.emit(sink, JqVal::Float(dx * f64_pow(2.0, f64_trunc(dy)))) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        i = i + 1
      }
      j = j + 1
    }
    return Ok(())
  }
  if name == "pow" {
    let xs = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let ys = match self.eval_collect(arg1, input, venv, fenv) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let mut j = 0
    while j < ys.length() {
      let mut i = 0
      while i < xs.length() {
        let dx = match jq_val_to_double(xs[i]) {
          Some(d) => d
          None => return Err(EvalSignal::Error(JqError::RuntimeError("pow requires numbers")))
        }
        let dy = match jq_val_to_double(ys[j]) {
          Some(d) => d
          None => return Err(EvalSignal::Error(JqError::RuntimeError("pow requires numbers")))
        }
        match self.emit(sink, JqVal::Float(f64_pow(dx, dy))) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        i = i + 1
      }
      j = j + 1
    }
    return Ok(())
  }
  if name == "recurse" {
    let stack : Array[JqVal] = [input]
    while stack.length() > 0 {
      let v = match stack.pop() {
        Some(x) => x
        None => break
      }
      match self.step() {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let cs = match self.eval_collect(arg1, v, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut ok = false
      let mut ci = 0
      while ci < cs.length() {
        if jq_truthy(cs[ci]) {
          ok = true
          break
        }
        ci = ci + 1
      }
      if ok {
        match self.emit(sink, v) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        match self.eval_collect(arg0, v, venv, fenv) {
          Ok(nexts) => {
            let mut k = nexts.length() - 1
            while k >= 0 {
              stack.push(nexts[k])
              k = k - 1
            }
          }
          Err(EvalSignal::Error(JqError::LimitExceeded(m))) =>
          return Err(EvalSignal::Error(JqError::LimitExceeded(m)))
          Err(_) => ()
        }
      }
    }
    return Ok(())
  }
  if name == "range" {
    let starts = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let ends = match self.eval_collect(arg1, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let mut si = 0
    while si < starts.length() {
      let mut ei = 0
      while ei < ends.length() {
        match (starts[si], ends[ei]) {
          (JqVal::Int(s), JqVal::Int(e)) => {
            let mut cur = s
            while cur < e {
              match self.step() {
                Err(err) => return Err(err)
                Ok(_) => ()
              }
              match self.emit(sink, JqVal::Int(cur)) {
                Err(err) => return Err(err)
                Ok(_) => ()
              }
              cur = cur + 1L
            }
          }
          _ => {
            let s = match jq_val_to_double(starts[si]) {
              Some(d) => d
              None => return Err(EvalSignal::Error(JqError::RuntimeError("range requires numbers")))
            }
            let e = match jq_val_to_double(ends[ei]) {
              Some(d) => d
              None => return Err(EvalSignal::Error(JqError::RuntimeError("range requires numbers")))
            }
            let mut cur = s
            while cur < e {
              match self.step() {
                Err(err) => return Err(err)
                Ok(_) => ()
              }
              match self.emit(sink, JqVal::Float(cur)) {
                Err(err) => return Err(err)
                Ok(_) => ()
              }
              cur = cur + 1.0
            }
          }
        }
        ei = ei + 1
      }
      si = si + 1
    }
    return Ok(())
  }
  if name == "setpath" {
    let ps = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let vs = match self.eval_collect(arg1, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let mut pi = 0
    while pi < ps.length() {
      match ps[pi] {
        JqVal::Array(p) => {
          let mut vi = 0
          while vi < vs.length() {
            match jq_setpath(input, p, 0, vs[vi], self.limits.max_output_bytes) {
              Ok(res) =>
              match self.emit(sink, res) {
                Err(e) => return Err(e)
                Ok(_) => ()
              }
              Err(e) => return Err(EvalSignal::Error(e))
            }
            vi = vi + 1
          }
        }
        _ => return Err(EvalSignal::Error(JqError::RuntimeError("setpath requires array path")))
      }
      pi = pi + 1
    }
    return Ok(())
  }
  if name == "any" || name == "all" {
    let items = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let mut i = 0
    while i < items.length() {
      let cs = match self.eval_collect(arg1, items[i], venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut j = 0
      while j < cs.length() {
        let t = jq_truthy(cs[j])
        if name == "any" && t {
          return self.emit(sink, JqVal::Bool(true))
        }
        if name == "all" && !t {
          return self.emit(sink, JqVal::Bool(false))
        }
        j = j + 1
      }
      i = i + 1
    }
    return self.emit(sink, JqVal::Bool(name == "all"))
  }
  if name == "split" {
    // split(re; flags) = [splits(re; flags)]
    let sub_sink = Sink::{ out: [], is_top_level: false, cap_remaining: -1, skip_remaining: 0 }
    match self.eval_regex_builtin("splits", arg0, arg1, input, venv, fenv, sub_sink) {
      Ok(_) | Err(EvalSignal::CapReached) => return self.emit(sink, JqVal::Array(sub_sink.out))
      Err(e) => return Err(e)
    }
  }
  if name == "test" || name == "match" || name == "capture" || name == "scan" || name == "splits" {
    return self.eval_regex_builtin(name, arg0, arg1, input, venv, fenv, sink)
  }
  if name == "sub" || name == "gsub" {
    return self.eval_sub_builtin(name == "gsub", arg0, arg1, -1, input, venv, fenv, sink)
  }
  Err(EvalSignal::Error(JqError::CompileError("unknown function " + name + "/2")))
}

fn EvalCtx::eval_builtin_3(
  self : EvalCtx,
  name : String,
  arg0 : Int,
  arg1 : Int,
  arg2 : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  if name == "range" {
    let starts = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let ends = match self.eval_collect(arg1, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let steps = match self.eval_collect(arg2, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let mut si = 0
    while si < starts.length() {
      let mut ei = 0
      while ei < ends.length() {
        let mut bi = 0
        while bi < steps.length() {
          match (starts[si], ends[ei], steps[bi]) {
            (JqVal::Int(s), JqVal::Int(e), JqVal::Int(st)) => {
              if st != 0L {
                let mut cur = s
                while (st > 0L && cur < e) || (st < 0L && cur > e) {
                  match self.step() {
                    Err(err) => return Err(err)
                    Ok(_) => ()
                  }
                  match self.emit(sink, JqVal::Int(cur)) {
                    Err(err) => return Err(err)
                    Ok(_) => ()
                  }
                  // Prevent overflow wrap on Int64 boundaries
                  if (st > 0L && cur > 9223372036854775807L - st) ||
                  (st < 0L && cur < -9223372036854775807L - 1L - st) {
                    break
                  }
                  cur = cur + st
                }
              }
            }
            _ => {
              let s = match jq_val_to_double(starts[si]) {
                Some(d) => d
                None => return Err(EvalSignal::Error(JqError::RuntimeError("range requires numbers")))
              }
              let e = match jq_val_to_double(ends[ei]) {
                Some(d) => d
                None => return Err(EvalSignal::Error(JqError::RuntimeError("range requires numbers")))
              }
              let st = match jq_val_to_double(steps[bi]) {
                Some(d) => d
                None => return Err(EvalSignal::Error(JqError::RuntimeError("range requires numbers")))
              }
              if st != 0.0 {
                let mut cur = s
                while (st > 0.0 && cur < e) || (st < 0.0 && cur > e) {
                  match self.step() {
                    Err(err) => return Err(err)
                    Ok(_) => ()
                  }
                  match self.emit(sink, JqVal::Float(cur)) {
                    Err(err) => return Err(err)
                    Ok(_) => ()
                  }
                  let next = cur + st
                  if next == cur {
                    break
                  }
                  cur = next
                }
              }
            }
          }
          bi = bi + 1
        }
        ei = ei + 1
      }
      si = si + 1
    }
    return Ok(())
  }
  if name == "sub" || name == "gsub" {
    return self.eval_sub_builtin(name == "gsub", arg0, arg1, arg2, input, venv, fenv, sink)
  }
  Err(EvalSignal::Error(JqError::CompileError("unknown function " + name + "/3")))
}

fn EvalCtx::eval_regex_builtin(
  self : EvalCtx,
  name : String,
  pat_e : Int,
  flags_e : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let text = match input {
    JqVal::Str(s) => s
    _ => return Err(EvalSignal::Error(JqError::RuntimeError(name + " requires string input")))
  }
  let pats = match self.eval_collect(pat_e, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let flgs : Array[String] = if flags_e < 0 {
    [""]
  } else {
    let fvs = match self.eval_collect(flags_e, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let arr : Array[String] = []
    let mut k = 0
    while k < fvs.length() {
      match fvs[k] {
        JqVal::Str(s) => arr.push(s)
        JqVal::Null => arr.push("")
        _ => return Err(EvalSignal::Error(JqError::RuntimeError("regex flags must be string")))
      }
      k = k + 1
    }
    arr
  }
  let mut pi = 0
  while pi < pats.length() {
    let pat_s = match pats[pi] {
      JqVal::Str(s) => s
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("regex pattern must be string")))
    }
    let mut fi = 0
    while fi < flgs.length() {
      let (re, is_global, ignore_empty) = match compile_jq_regex(pat_s, flgs[fi]) {
        Ok(r) => r
        Err(e) => return Err(EvalSignal::Error(e))
      }
      if name == "test" {
        match self.emit(sink, JqVal::Bool(re.is_match(text))) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
      } else if name == "match" {
        if is_global {
          let all_caps = re.captures_iter(text)
          let mut ci = 0
          while ci < all_caps.length() {
            let m = all_caps[ci].get(0)
            let skip = match m {
              Some(mv) => ignore_empty && mv.start == mv.end
              None => true
            }
            if !skip {
              match self.emit(sink, captures_to_match_obj(text, re, all_caps[ci])) {
                Err(e) => return Err(e)
                Ok(_) => ()
              }
            }
            ci = ci + 1
          }
        } else {
          match re.captures(text) {
            Some(caps) =>
            match self.emit(sink, captures_to_match_obj(text, re, caps)) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            None => ()
          }
        }
      } else if name == "capture" {
        if is_global {
          let all_caps = re.captures_iter(text)
          let mut ci = 0
          while ci < all_caps.length() {
            match self.emit(sink, captures_to_named_obj(re, all_caps[ci])) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            ci = ci + 1
          }
        } else {
          match re.captures(text) {
            Some(caps) =>
            match self.emit(sink, captures_to_named_obj(re, caps)) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            None => ()
          }
        }
      } else if name == "scan" {
        let all_caps = re.captures_iter(text)
        let mut ci = 0
        while ci < all_caps.length() {
          let caps = all_caps[ci]
          if caps.len() > 1 {
            let arr : Array[JqVal] = []
            let mut g = 1
            while g < caps.len() {
              match caps.get(g) {
                Some(m) => arr.push(JqVal::Str(m.text))
                None => arr.push(JqVal::Null)
              }
              g = g + 1
            }
            match self.emit(sink, JqVal::Array(arr)) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
          } else {
            match caps.get(0) {
              Some(m) =>
              match self.emit(sink, JqVal::Str(m.text)) {
                Err(e) => return Err(e)
                Ok(_) => ()
              }
              None => ()
            }
          }
          ci = ci + 1
        }
      } else if name == "splits" {
        let parts = re.split(text)
        let mut k = 0
        while k < parts.length() {
          match self.emit(sink, JqVal::Str(parts[k])) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          k = k + 1
        }
      }
      fi = fi + 1
    }
    pi = pi + 1
  }
  Ok(())
}

///| P1-8: `sub`/`gsub` with multi-output replacement streams.
fn EvalCtx::eval_sub_expand(
  self : EvalCtx,
  text : String,
  re : regex::Regex,
  matches : Array[regex::Captures],
  mi : Int,
  last_end : Int,
  prefix : String,
  to_e : Int,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  if mi >= matches.length() {
    let tail = text.slice(last_end, text.length())
    if prefix.length() + tail.length() > self.limits.max_output_bytes {
      return Err(EvalSignal::Error(JqError::LimitExceeded("sub/gsub result exceeds max_output_bytes")))
    }
    return self.emit(sink, JqVal::Str(prefix + tail))
  }
  let caps = matches[mi]
  let full = match caps.get(0) {
    Some(m) => m
    None => return self.eval_sub_expand(text, re, matches, matches.length(), last_end, prefix, to_e, venv, fenv, sink)
  }
  let seg = text.slice(last_end, full.start)
  let cap_obj = captures_to_named_obj(re, caps)
  let reps = match self.eval_collect(to_e, cap_obj, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mut ri = 0
  while ri < reps.length() {
    let rep_s = match jq_tostring_val(reps[ri], self.limits.max_output_bytes) {
      Ok(s) => s
      Err(e) => return Err(EvalSignal::Error(e))
    }
    if prefix.length() + seg.length() + rep_s.length() > self.limits.max_output_bytes {
      return Err(EvalSignal::Error(JqError::LimitExceeded("sub/gsub result exceeds max_output_bytes")))
    }
    match self.eval_sub_expand(text, re, matches, mi + 1, full.end, prefix + seg + rep_s, to_e, venv, fenv, sink) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    ri = ri + 1
  }
  Ok(())
}

fn EvalCtx::eval_sub_builtin(
  self : EvalCtx,
  is_global : Bool,
  pat_e : Int,
  to_e : Int,
  flags_e : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let text = match input {
    JqVal::Str(s) => s
    _ => return Err(EvalSignal::Error(JqError::RuntimeError("sub/gsub requires string input")))
  }
  let pats = match self.eval_collect(pat_e, input, venv, fenv) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let flgs : Array[String] = if flags_e < 0 {
    [""]
  } else {
    let fvs = match self.eval_collect(flags_e, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let arr : Array[String] = []
    let mut k = 0
    while k < fvs.length() {
      match fvs[k] {
        JqVal::Str(s) => arr.push(s)
        JqVal::Null => arr.push("")
        _ => return Err(EvalSignal::Error(JqError::RuntimeError("regex flags must be string")))
      }
      k = k + 1
    }
    arr
  }
  let mut pi = 0
  while pi < pats.length() {
    let pat_s = match pats[pi] {
      JqVal::Str(s) => s
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("regex pattern must be string")))
    }
    let mut fi = 0
    while fi < flgs.length() {
      let (re, flag_g, _) = match compile_jq_regex(pat_s, flgs[fi]) {
        Ok(r) => r
        Err(e) => return Err(EvalSignal::Error(e))
      }
      let do_all = is_global || flag_g
      let matches = if do_all {
        re.captures_iter(text)
      } else {
        match re.captures(text) {
          Some(c) => [c]
          None => []
        }
      }
      // Fast O(n) StringBuilder path when `to_e` is a simple string literal (preserves B7 239x speed!)
      match self.exprs[to_e] {
        Expr::StrLit(rep_lit) => {
          let sb = StringBuilder::new()
          let mut last_end = 0
          let mut mi = 0
          while mi < matches.length() {
            let full = match matches[mi].get(0) {
              Some(m) => m
              None => break
            }
            sb.write_string(text.slice(last_end, full.start))
            sb.write_string(rep_lit)
            if sb.length() > self.limits.max_output_bytes {
              return Err(EvalSignal::Error(JqError::LimitExceeded("sub/gsub result exceeds max_output_bytes")))
            }
            last_end = full.end
            mi = mi + 1
          }
          sb.write_string(text.slice(last_end, text.length()))
          let out_s = sb.to_string()
          if out_s.length() > self.limits.max_output_bytes {
            return Err(EvalSignal::Error(JqError::LimitExceeded("sub/gsub result exceeds max_output_bytes")))
          }
          match self.emit(sink, JqVal::Str(out_s)) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
        }
        _ =>
        match self.eval_sub_expand(text, re, matches, 0, 0, "", to_e, venv, fenv, sink) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
      }
      fi = fi + 1
    }
    pi = pi + 1
  }
  Ok(())
}
