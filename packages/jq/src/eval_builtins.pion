///| Built-in function dispatch for `packages/jq` (arity 0..3), including streaming
///| `limit`/`first`/`isempty`/`nth`/`skip` (P0-4), O(n) `from_entries`/`with_entries` (P0-7),
///| multi-output `sub`/`gsub` (P1-8), object-capable `add`/`any`/`all`/`join` (P1-9),
///| and core jq 1.7 builtins (`paths/1`, `while`, `until`, `repeat`, `walk`, `IN`,
///| `tostream`/`fromstream`, `nth/1`, `pow`, `sqrt`, `pick`, `split/2`, `combinations/1`, ...).

import "regex"

fn EvalCtx::eval_builtin_call(
  self : EvalCtx,
  name : String,
  args : Array[Int],
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let arity = args.length()
  if arity == 0 {
    self.eval_builtin_0(name, input, sink)
  } else if arity == 1 {
    self.eval_builtin_1(name, args[0], input, venv, fenv, sink)
  } else if arity == 2 {
    self.eval_builtin_2(name, args[0], args[1], input, venv, fenv, sink)
  } else if arity == 3 {
    self.eval_builtin_3(name, args[0], args[1], args[2], input, venv, fenv, sink)
  } else {
    Err(EvalSignal::Error(JqError::CompileError("unknown function " + name + "/" + arity.to_string())))
  }
}

///| Helper: stream `expr_id` directly into `sink` with a temporary cap of `n` outputs (P0-4).
///| Values emitted before `error` or `break` stay in `sink.out`!
fn EvalCtx::eval_streaming_limit(
  self : EvalCtx,
  n : Int,
  expr_id : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  if n <= 0 {
    return Ok(())
  }
  let prev_cap = sink.cap_remaining
  let prev_len = sink.out.length()
  let eff_cap = if prev_cap >= 0 && prev_cap < n { prev_cap } else { n }
  sink.cap_remaining = eff_cap
  let r = self.eval(expr_id, input, venv, fenv, sink)
  let emitted = sink.out.length() - prev_len
  if prev_cap >= 0 {
    let rem = prev_cap - emitted
    sink.cap_remaining = if rem < 0 { 0 } else { rem }
  } else {
    sink.cap_remaining = -1
  }
  match r {
    Ok(_) => Ok(())
    Err(EvalSignal::CapReached) =>
    if prev_cap >= 0 && sink.cap_remaining <= 0 {
      Err(EvalSignal::CapReached)
    } else {
      Ok(())
    }
    Err(e) => Err(e)
  }
}

///| Helper: extract iterable values from Array or Object (P1-9).
fn jq_iter_values(v : JqVal) -> Option[Array[JqVal]] {
  match v {
    JqVal::Array(xs) => Some(xs)
    JqVal::Object(obj) => {
      let arr : Array[JqVal] = []
      let es = obj.entries
      let mut i = 0
      while i < es.length() {
        let (_, ev) = es[i]
        arr.push(ev)
        i = i + 1
      }
      Some(arr)
    }
    _ => None
  }
}

fn EvalCtx::eval_builtin_0(
  self : EvalCtx,
  name : String,
  input : JqVal,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  if name == "empty" {
    return Ok(())
  }
  if name == "not" {
    return self.emit(sink, JqVal::Bool(!jq_truthy(input)))
  }
  if name == "type" {
    return self.emit(sink, JqVal::Str(jq_type_name(input)))
  }
  if name == "length" {
    let out_v = match input {
      JqVal::Null => JqVal::Int(0L)
      JqVal::Str(s) => JqVal::Int(utf8_char_len(s).to_int64())
      JqVal::Array(xs) => JqVal::Int(xs.length().to_int64())
      JqVal::Object(obj) => JqVal::Int(jq_obj_dedup_entries(obj.entries).entries.length().to_int64())
      JqVal::Int(i) =>
      if i == -9223372036854775807L - 1L {
        JqVal::BigInt("9223372036854775808")
      } else if i < 0L {
        JqVal::Int(-i)
      } else {
        JqVal::Int(i)
      }
      JqVal::BigInt(s) => jq_int_from_decimal(bigint_abs(s))
      JqVal::Float(x) => JqVal::Float(if x < 0.0 { -x } else { x })
      other =>
      return Err(EvalSignal::Error(JqError::RuntimeError(jq_type_name(other) + " has no length")))
    }
    return self.emit(sink, out_v)
  }
  if name == "utf8bytelength" {
    match input {
      JqVal::Str(s) => return self.emit(sink, JqVal::Int(s.length().to_int64()))
      other =>
      return Err(EvalSignal::Error(JqError::RuntimeError(jq_type_name(other) + " only strings have UTF-8 byte length")))
    }
  }
  if name == "keys" || name == "keys_unsorted" {
    match input {
      JqVal::Object(obj) => {
        let out : Array[JqVal] = []
        if name == "keys" {
          let sorted = sort_obj_entries(obj.entries)
          let mut i = 0
          while i < sorted.length() {
            let (k, _) = sorted[i]
            out.push(JqVal::Str(k))
            i = i + 1
          }
        } else {
          let dedup = jq_obj_dedup_entries(obj.entries).entries
          let mut i = 0
          while i < dedup.length() {
            let (k, _) = dedup[i]
            out.push(JqVal::Str(k))
            i = i + 1
          }
        }
        return self.emit(sink, JqVal::Array(out))
      }
      JqVal::Array(xs) => {
        let out : Array[JqVal] = []
        let mut i = 0
        while i < xs.length() {
          out.push(JqVal::Int(i.to_int64()))
          i = i + 1
        }
        return self.emit(sink, JqVal::Array(out))
      }
      other =>
      return Err(EvalSignal::Error(JqError::RuntimeError(jq_type_name(other) + " has no keys")))
    }
  }
  if name == "values" {
    return match input {
      JqVal::Null => Ok(())
      _ => self.emit(sink, input)
    }
  }
  if name == "error" {
    return Err(EvalSignal::Error(JqError::UserError(to_json5(input))))
  }
  if name == "halt" {
    return Ok(())
  }
  if name == "halt_error" {
    return Err(EvalSignal::Error(JqError::UserError(to_json5(input))))
  }
  if name == "debug" || name == "stderr" {
    return self.emit(sink, input)
  }
  if name == "env" {
    return self.emit(sink, JqVal::Object(jq_obj_from_entries([])))
  }
  if name == "builtins" {
    let list : Array[JqVal] = [
      JqVal::Str("IN/1"), JqVal::Str("IN/2"), JqVal::Str("abs/0"), JqVal::Str("add/0"),
      JqVal::Str("add/1"), JqVal::Str("all/0"), JqVal::Str("all/1"), JqVal::Str("all/2"),
      JqVal::Str("any/0"), JqVal::Str("any/1"), JqVal::Str("any/2"), JqVal::Str("arrays/0"),
      JqVal::Str("ascii_downcase/0"), JqVal::Str("ascii_upcase/0"), JqVal::Str("booleans/0"),
      JqVal::Str("bsearch/1"), JqVal::Str("builtins/0"), JqVal::Str("capture/1"),
      JqVal::Str("capture/2"), JqVal::Str("ceil/0"), JqVal::Str("combinations/0"),
      JqVal::Str("combinations/1"), JqVal::Str("contains/1"), JqVal::Str("del/1"),
      JqVal::Str("delpaths/1"), JqVal::Str("empty/0"), JqVal::Str("endswith/1"),
      JqVal::Str("env/0"), JqVal::Str("error/0"), JqVal::Str("error/1"),
      JqVal::Str("explode/0"), JqVal::Str("fabs/0"), JqVal::Str("first/0"),
      JqVal::Str("first/1"), JqVal::Str("flatten/0"), JqVal::Str("flatten/1"),
      JqVal::Str("floor/0"), JqVal::Str("from_entries/0"), JqVal::Str("fromjson/0"),
      JqVal::Str("fromstream/1"), JqVal::Str("getpath/1"), JqVal::Str("group_by/1"),
      JqVal::Str("gsub/2"), JqVal::Str("gsub/3"), JqVal::Str("has/1"),
      JqVal::Str("implode/0"), JqVal::Str("in/1"), JqVal::Str("index/1"),
      JqVal::Str("indices/1"), JqVal::Str("infinite/0"), JqVal::Str("inside/1"),
      JqVal::Str("isempty/1"), JqVal::Str("isfinite/0"), JqVal::Str("isinfinite/0"),
      JqVal::Str("isnan/0"), JqVal::Str("isnormal/0"), JqVal::Str("iterables/0"),
      JqVal::Str("join/1"), JqVal::Str("keys/0"), JqVal::Str("keys_unsorted/0"),
      JqVal::Str("last/0"), JqVal::Str("last/1"), JqVal::Str("leaf_paths/0"),
      JqVal::Str("length/0"), JqVal::Str("limit/2"), JqVal::Str("ltrim/0"),
      JqVal::Str("ltrimstr/1"), JqVal::Str("map/1"), JqVal::Str("map_values/1"),
      JqVal::Str("match/1"), JqVal::Str("match/2"), JqVal::Str("max/0"),
      JqVal::Str("max_by/1"), JqVal::Str("min/0"), JqVal::Str("min_by/1"),
      JqVal::Str("nan/0"), JqVal::Str("not/0"), JqVal::Str("nth/1"),
      JqVal::Str("nth/2"), JqVal::Str("nulls/0"), JqVal::Str("numbers/0"),
      JqVal::Str("objects/0"), JqVal::Str("path/1"), JqVal::Str("paths/0"),
      JqVal::Str("paths/1"), JqVal::Str("pick/1"), JqVal::Str("pow/2"),
      JqVal::Str("range/1"), JqVal::Str("range/2"), JqVal::Str("range/3"),
      JqVal::Str("recurse/0"), JqVal::Str("recurse/1"), JqVal::Str("recurse/2"),
      JqVal::Str("repeat/1"), JqVal::Str("reverse/0"), JqVal::Str("rindex/1"),
      JqVal::Str("round/0"), JqVal::Str("rtrim/0"), JqVal::Str("rtrimstr/1"),
      JqVal::Str("scalars/0"), JqVal::Str("scan/1"), JqVal::Str("scan/2"),
      JqVal::Str("select/1"), JqVal::Str("setpath/2"), JqVal::Str("skip/2"),
      JqVal::Str("sort/0"), JqVal::Str("sort_by/1"), JqVal::Str("split/1"),
      JqVal::Str("split/2"), JqVal::Str("splits/1"), JqVal::Str("splits/2"),
      JqVal::Str("sqrt/0"), JqVal::Str("startswith/1"), JqVal::Str("strings/0"),
      JqVal::Str("sub/2"), JqVal::Str("sub/3"), JqVal::Str("test/1"),
      JqVal::Str("test/2"), JqVal::Str("to_entries/0"), JqVal::Str("toboolean/0"),
      JqVal::Str("tojson/0"), JqVal::Str("tonumber/0"), JqVal::Str("tostream/0"),
      JqVal::Str("tostring/0"), JqVal::Str("transpose/0"), JqVal::Str("trim/0"),
      JqVal::Str("trimstr/1"), JqVal::Str("trunc/0"), JqVal::Str("type/0"),
      JqVal::Str("unique/0"), JqVal::Str("unique_by/1"), JqVal::Str("until/2"),
      JqVal::Str("utf8bytelength/0"), JqVal::Str("values/0"), JqVal::Str("walk/1"),
      JqVal::Str("while/2"), JqVal::Str("with_entries/1"),
    ]
    return self.emit(sink, JqVal::Array(list))
  }
  if name == "nan" {
    return self.emit(sink, JqVal::Float(0.0 / 0.0))
  }
  if name == "infinite" {
    return self.emit(sink, JqVal::Float(1.0 / 0.0))
  }
  if name == "isnan" {
    return self.emit(sink, JqVal::Bool(jq_is_nan_val(input)))
  }
  if name == "isinfinite" {
    let b = match input {
      JqVal::Float(x) => is_inf_f64(x)
      _ => false
    }
    return self.emit(sink, JqVal::Bool(b))
  }
  if name == "isfinite" {
    let b = match input {
      JqVal::Int(_) | JqVal::BigInt(_) => true
      JqVal::Float(x) => is_finite_f64(x)
      _ => false
    }
    return self.emit(sink, JqVal::Bool(b))
  }
  if name == "isnormal" {
    let b = match input {
      JqVal::Int(i) => i != 0L
      JqVal::BigInt(s) => s != "0"
      JqVal::Float(x) => is_normal_f64(x)
      _ => false
    }
    return self.emit(sink, JqVal::Bool(b))
  }
  if name == "floor" {
    match input {
      JqVal::Int(_) | JqVal::BigInt(_) => return self.emit(sink, input)
      JqVal::Float(x) => return self.emit(sink, JqVal::Float(f64_floor(x)))
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("floor requires a number")))
    }
  }
  if name == "ceil" {
    match input {
      JqVal::Int(_) | JqVal::BigInt(_) => return self.emit(sink, input)
      JqVal::Float(x) => return self.emit(sink, JqVal::Float(f64_ceil(x)))
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("ceil requires a number")))
    }
  }
  if name == "trunc" {
    match input {
      JqVal::Int(_) | JqVal::BigInt(_) => return self.emit(sink, input)
      JqVal::Float(x) => return self.emit(sink, JqVal::Float(f64_trunc(x)))
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("trunc requires a number")))
    }
  }
  if name == "round" {
    match input {
      JqVal::Int(_) | JqVal::BigInt(_) => return self.emit(sink, input)
      JqVal::Float(x) => return self.emit(sink, JqVal::Float(f64_round(x)))
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("round requires a number")))
    }
  }
  if name == "fabs" || name == "abs" {
    match input {
      JqVal::Int(i) =>
      if i == -9223372036854775807L - 1L {
        return self.emit(sink, JqVal::BigInt("9223372036854775808"))
      } else {
        return self.emit(sink, JqVal::Int(if i < 0L { -i } else { i }))
      }
      JqVal::BigInt(s) => return self.emit(sink, jq_int_from_decimal(bigint_abs(s)))
      JqVal::Float(x) => return self.emit(sink, JqVal::Float(if x < 0.0 { -x } else { x }))
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("abs requires a number")))
    }
  }
  if name == "sqrt" {
    match jq_val_to_double(input) {
      Some(x) => return self.emit(sink, JqVal::Float(f64_sqrt(x)))
      None => return Err(EvalSignal::Error(JqError::RuntimeError("sqrt requires a number")))
    }
  }
  if name == "add" {
    let items = match jq_iter_values(input) {
      Some(xs) => xs
      None => return Err(EvalSignal::Error(JqError::RuntimeError("cannot iterate over " + jq_type_name(input))))
    }
    let mut acc = JqVal::Null
    let mut i = 0
    while i < items.length() {
      acc = match jq_add(acc, items[i], self.limits.max_output_bytes) {
        Ok(v) => v
        Err(e) => return Err(EvalSignal::Error(e))
      }
      i = i + 1
    }
    return self.emit(sink, acc)
  }
  if name == "any" {
    let items = match jq_iter_values(input) {
      Some(xs) => xs
      None => return Err(EvalSignal::Error(JqError::RuntimeError("cannot iterate over " + jq_type_name(input))))
    }
    let mut i = 0
    while i < items.length() {
      if jq_truthy(items[i]) {
        return self.emit(sink, JqVal::Bool(true))
      }
      i = i + 1
    }
    return self.emit(sink, JqVal::Bool(false))
  }
  if name == "all" {
    let items = match jq_iter_values(input) {
      Some(xs) => xs
      None => return Err(EvalSignal::Error(JqError::RuntimeError("cannot iterate over " + jq_type_name(input))))
    }
    let mut i = 0
    while i < items.length() {
      if !jq_truthy(items[i]) {
        return self.emit(sink, JqVal::Bool(false))
      }
      i = i + 1
    }
    return self.emit(sink, JqVal::Bool(true))
  }
  if name == "first" {
    match input {
      JqVal::Null => return self.emit(sink, JqVal::Null)
      JqVal::Array(xs) => return self.emit(sink, if xs.length() > 0 { xs[0] } else { JqVal::Null })
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("first requires an array")))
    }
  }
  if name == "last" {
    match input {
      JqVal::Null => return self.emit(sink, JqVal::Null)
      JqVal::Array(xs) =>
      return self.emit(sink, if xs.length() > 0 { xs[xs.length() - 1] } else { JqVal::Null })
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("last requires an array")))
    }
  }
  if name == "reverse" {
    match input {
      JqVal::Array(xs) => {
        let out : Array[JqVal] = []
        let mut i = xs.length() - 1
        while i >= 0 {
          out.push(xs[i])
          i = i - 1
        }
        return self.emit(sink, JqVal::Array(out))
      }
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("reverse requires an array")))
    }
  }
  if name == "sort" {
    match input {
      JqVal::Array(xs) => return self.emit(sink, JqVal::Array(sort_values(xs)))
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("sort requires an array")))
    }
  }
  if name == "unique" {
    match input {
      JqVal::Array(xs) => {
        let sorted = sort_values(xs)
        let out : Array[JqVal] = []
        let mut i = 0
        while i < sorted.length() {
          if i == 0 || jq_cmp(sorted[i - 1], sorted[i]) != 0 {
            out.push(sorted[i])
          }
          i = i + 1
        }
        return self.emit(sink, JqVal::Array(out))
      }
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("unique requires an array")))
    }
  }
  if name == "min" || name == "max" {
    match input {
      JqVal::Array(xs) => {
        if xs.length() == 0 {
          return self.emit(sink, JqVal::Null)
        }
        let mut best = xs[0]
        let mut i = 1
        while i < xs.length() {
          let c = jq_cmp(xs[i], best)
          if (name == "min" && c < 0) || (name == "max" && c > 0) {
            best = xs[i]
          }
          i = i + 1
        }
        return self.emit(sink, best)
      }
      _ => return Err(EvalSignal::Error(JqError::RuntimeError(name + " requires an array")))
    }
  }
  if name == "flatten" {
    match jq_iter_values(input) {
      Some(xs) => {
        let out : Array[JqVal] = []
        match self.flatten_into_iter(xs, -1, out) {
          Err(e) => return Err(e)
          Ok(_) => return self.emit(sink, JqVal::Array(out))
        }
      }
      None => return Err(EvalSignal::Error(JqError::RuntimeError("flatten requires an array or object")))
    }
  }
  if name == "transpose" {
    match input {
      JqVal::Array(rows) => {
        let mut max_cols = 0
        let mut i = 0
        while i < rows.length() {
          match rows[i] {
            JqVal::Array(r) => if r.length() > max_cols { max_cols = r.length() }
            _ => return Err(EvalSignal::Error(JqError::RuntimeError("transpose requires array of arrays")))
          }
          i = i + 1
        }
        let out : Array[JqVal] = []
        let mut c = 0
        while c < max_cols {
          let col : Array[JqVal] = []
          let mut r = 0
          while r < rows.length() {
            match rows[r] {
              JqVal::Array(row) =>
              if c < row.length() { col.push(row[c]) } else { col.push(JqVal::Null) }
              _ => ()
            }
            r = r + 1
          }
          out.push(JqVal::Array(col))
          c = c + 1
        }
        return self.emit(sink, JqVal::Array(out))
      }
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("transpose requires an array")))
    }
  }
  if name == "combinations" {
    match input {
      JqVal::Null => return self.emit(sink, JqVal::Array([]))
      JqVal::Array(groups) => return self.eval_combinations(groups, 0, [], sink)
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("combinations requires an array of arrays")))
    }
  }
  if name == "to_entries" {
    match input {
      JqVal::Object(obj) => {
        let es = obj.entries
        let out : Array[JqVal] = []
        let mut i = 0
        while i < es.length() {
          let (k, v) = es[i]
          out.push(JqVal::Object(jq_obj_from_entries([("key", JqVal::Str(k)), ("value", v)])))
          i = i + 1
        }
        return self.emit(sink, JqVal::Array(out))
      }
      JqVal::Array(xs) => {
        let out : Array[JqVal] = []
        let mut i = 0
        while i < xs.length() {
          out.push(JqVal::Object(jq_obj_from_entries([("key", JqVal::Int(i.to_int64())), ("value", xs[i])])))
          i = i + 1
        }
        return self.emit(sink, JqVal::Array(out))
      }
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("to_entries requires object or array")))
    }
  }
  if name == "from_entries" {
    // O(n) seeded ObjHashIndex construction (fixes P0-7 B4: 14.3s -> ~30ms!)
    match input {
      JqVal::Array(xs) => {
        let n = xs.length()
        let out_entries : Array[(String, JqVal)] = []
        let hi = ObjHashIndex::new(if n * 2 < 16 { 16 } else { n * 2 })
        let mut i = 0
        while i < n {
          match self.step() {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          match xs[i] {
            JqVal::Object(obj) => {
              let k_opt = match jq_obj_get(obj, "key") {
                Some(v) => Some(v)
                None => match jq_obj_get(obj, "Key") {
                  Some(v) => Some(v)
                  None => match jq_obj_get(obj, "name") {
                    Some(v) => Some(v)
                    None => jq_obj_get(obj, "Name")
                  }
                }
              }
              let key = match k_opt {
                Some(JqVal::Str(s)) => s
                _ => return Err(EvalSignal::Error(JqError::RuntimeError("from_entries requires string key")))
              }
              let val_opt = match jq_obj_get(obj, "value") {
                Some(v) => Some(v)
                None => jq_obj_get(obj, "Value")
              }
              let v = match val_opt {
                Some(x) => x
                None => JqVal::Null
              }
              let existing = hi.get(key)
              if existing >= 0 {
                out_entries[existing] = (key, v)
              } else {
                let idx = out_entries.length()
                let _ = hi.upsert(key, idx)
                out_entries.push((key, v))
              }
            }
            _ => return Err(EvalSignal::Error(JqError::RuntimeError("from_entries requires array of objects")))
          }
          i = i + 1
        }
        return self.emit(sink, JqVal::Object(JqObj::{ entries: out_entries, index: Some(hi) }))
      }
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("from_entries requires an array")))
    }
  }
  if name == "arrays" {
    return match input { JqVal::Array(_) => self.emit(sink, input) _ => Ok(()) }
  }
  if name == "objects" {
    return match input { JqVal::Object(_) => self.emit(sink, input) _ => Ok(()) }
  }
  if name == "iterables" {
    return match input { JqVal::Array(_) | JqVal::Object(_) => self.emit(sink, input) _ => Ok(()) }
  }
  if name == "booleans" {
    return match input { JqVal::Bool(_) => self.emit(sink, input) _ => Ok(()) }
  }
  if name == "numbers" {
    return match input { JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => self.emit(sink, input) _ => Ok(()) }
  }
  if name == "strings" {
    return match input { JqVal::Str(_) => self.emit(sink, input) _ => Ok(()) }
  }
  if name == "nulls" {
    return match input { JqVal::Null => self.emit(sink, input) _ => Ok(()) }
  }
  if name == "scalars" {
    return match input { JqVal::Array(_) | JqVal::Object(_) => Ok(()) _ => self.emit(sink, input) }
  }
  if name == "leaf_paths" {
    return self.emit_leaf_paths_iter(input, sink)
  }
  if name == "paths" {
    return self.emit_all_paths_iter(input, sink)
  }
  if name == "recurse" {
    return self.eval_recurse(input, sink)
  }
  if name == "tostream" {
    return self.emit_tostream(input, [], sink)
  }
  if name == "tostring" {
    match jq_tostring_val(input, self.limits.max_output_bytes) {
      Ok(s) => return self.emit(sink, JqVal::Str(s))
      Err(e) => return Err(EvalSignal::Error(e))
    }
  }
  if name == "tonumber" {
    match input {
      JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) => return self.emit(sink, input)
      JqVal::Str(s) =>
      match parse_jq_number_str(s, false) {
        Some(v) => return self.emit(sink, v)
        None => return Err(EvalSignal::Error(JqError::RuntimeError("string cannot be parsed as a number")))
      }
      other =>
      return Err(EvalSignal::Error(JqError::RuntimeError(jq_type_name(other) + " cannot be parsed as a number")))
    }
  }
  if name == "toboolean" {
    match input {
      JqVal::Bool(_) => return self.emit(sink, input)
      JqVal::Str(s) =>
      if s == "true" {
        return self.emit(sink, JqVal::Bool(true))
      } else if s == "false" {
        return self.emit(sink, JqVal::Bool(false))
      } else {
        return Err(EvalSignal::Error(JqError::RuntimeError("string cannot be parsed as a boolean")))
      }
      other =>
      return Err(EvalSignal::Error(JqError::RuntimeError(jq_type_name(other) + " cannot be parsed as a boolean")))
    }
  }
  if name == "tojson" {
    match serialize_jq_val(input, false, self.limits.max_output_bytes) {
      Ok(s) => return self.emit(sink, JqVal::Str(s))
      Err(e) => return Err(EvalSignal::Error(e))
    }
  }
  if name == "fromjson" {
    match input {
      JqVal::Str(s) => {
        let jdepth = if self.limits.max_depth > 10000 { self.limits.max_depth } else { 10000 }
        match parse_json_to_jqval(s, jdepth) {
          Ok(v) => return self.emit(sink, v)
          Err(e) => return Err(EvalSignal::Error(e))
        }
      }
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("fromjson requires a string")))
    }
  }
  if name == "ascii_downcase" {
    match input {
      JqVal::Str(s) => return self.emit(sink, JqVal::Str(str_ascii_downcase(s)))
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("ascii_downcase requires a string")))
    }
  }
  if name == "ascii_upcase" {
    match input {
      JqVal::Str(s) => return self.emit(sink, JqVal::Str(str_ascii_upcase(s)))
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("ascii_upcase requires a string")))
    }
  }
  if name == "ltrim" || name == "rtrim" || name == "trim" {
    match input {
      JqVal::Str(s) => {
        let n = s.length()
        let mut l = 0
        let mut r = n
        if name == "ltrim" || name == "trim" {
          while l < r {
            let b = s.code_unit_at(l)
            if b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12 {
              l = l + 1
            } else {
              break
            }
          }
        }
        if name == "rtrim" || name == "trim" {
          while r > l {
            let b = s.code_unit_at(r - 1)
            if b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12 {
              r = r - 1
            } else {
              break
            }
          }
        }
        return self.emit(sink, JqVal::Str(s.slice(l, r)))
      }
      _ => return Err(EvalSignal::Error(JqError::RuntimeError(name + " requires a string")))
    }
  }
  if name == "explode" {
    match input {
      JqVal::Str(s) => {
        let cps = utf8_explode(s)
        let out : Array[JqVal] = []
        let mut i = 0
        while i < cps.length() {
          out.push(JqVal::Int(cps[i].to_int64()))
          i = i + 1
        }
        return self.emit(sink, JqVal::Array(out))
      }
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("explode requires a string")))
    }
  }
  if name == "implode" {
    match input {
      JqVal::Array(xs) => {
        let sb = StringBuilder::new()
        let mut i = 0
        while i < xs.length() {
          match jq_val_to_int_index(xs[i]) {
            Some(cp) => write_utf8_cp(sb, cp)
            None =>
            match xs[i] {
              JqVal::Int(_) | JqVal::BigInt(_) | JqVal::Float(_) =>
              return Err(EvalSignal::Error(JqError::RuntimeError("invalid codepoint in implode")))
              _ => return Err(EvalSignal::Error(JqError::RuntimeError("implode requires array of numbers")))
            }
          }
          if sb.length() > self.limits.max_output_bytes {
            return Err(EvalSignal::Error(JqError::LimitExceeded("implode exceeds max_output_bytes")))
          }
          i = i + 1
        }
        return self.emit(sink, JqVal::Str(sb.to_string()))
      }
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("implode requires an array")))
    }
  }
  if name == "normals" {
    let b = match input {
      JqVal::Int(i) => i != 0L
      JqVal::BigInt(s) => s != "0"
      JqVal::Float(x) => is_normal_f64(x)
      _ => false
    }
    return if b { self.emit(sink, input) } else { Ok(()) }
  }
  if name == "finites" {
    let b = match input {
      JqVal::Int(_) | JqVal::BigInt(_) => true
      JqVal::Float(x) => is_finite_f64(x)
      _ => false
    }
    return if b { self.emit(sink, input) } else { Ok(()) }
  }
  Err(EvalSignal::Error(JqError::CompileError("unknown function " + name + "/0")))
}

fn EvalCtx::flatten_into_iter(
  self : EvalCtx,
  root_xs : Array[JqVal],
  max_depth : Int,
  out : Array[JqVal],
) -> Result[Unit, EvalSignal] {
  let stack : Array[(Array[JqVal], Int, Int)] = [(root_xs, 0, max_depth)]
  while stack.length() > 0 {
    let (xs, idx, dleft) = match stack.pop() {
      Some(f) => f
      None => break
    }
    if idx >= xs.length() {
      continue
    }
    match self.step() {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    if idx + 1 < xs.length() {
      stack.push((xs, idx + 1, dleft))
    }
    match xs[idx] {
      JqVal::Array(sub) =>
      if dleft != 0 {
        let next_d = if dleft > 0 { dleft - 1 } else { -1 }
        stack.push((sub, 0, next_d))
      } else {
        out.push(xs[idx])
      }
      _ => out.push(xs[idx])
    }
  }
  Ok(())
}

fn EvalCtx::eval_combinations(
  self : EvalCtx,
  groups : Array[JqVal],
  idx : Int,
  prefix : Array[JqVal],
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  if idx >= groups.length() {
    match self.step() {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    let copy : Array[JqVal] = []
    let mut i = 0
    while i < prefix.length() {
      copy.push(prefix[i])
      i = i + 1
    }
    return self.emit(sink, JqVal::Array(copy))
  }
  match jq_iter_values(groups[idx]) {
    Some(items) => {
      let mut i = 0
      while i < items.length() {
        prefix.push(items[i])
        match self.eval_combinations(groups, idx + 1, prefix, sink) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        let _ = prefix.pop()
        i = i + 1
      }
      Ok(())
    }
    None => Err(EvalSignal::Error(JqError::RuntimeError("combinations requires array of iterables")))
  }
}

fn EvalCtx::emit_leaf_paths_iter(
  self : EvalCtx,
  root : JqVal,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let stack : Array[(Array[JqVal], JqVal)] = [([], root)]
  while stack.length() > 0 {
    let (prefix, v) = match stack.pop() {
      Some(x) => x
      None => break
    }
    match self.step() {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    match v {
      JqVal::Array(items) => {
        let mut i = items.length() - 1
        while i >= 0 {
          stack.push((clone_path_with(prefix, JqVal::Int(i.to_int64())), items[i]))
          i = i - 1
        }
      }
      JqVal::Object(obj) => {
        let es = obj.entries
        let mut i = es.length() - 1
        while i >= 0 {
          let (k, ev) = es[i]
          stack.push((clone_path_with(prefix, JqVal::Str(k)), ev))
          i = i - 1
        }
      }
      _ =>
      match self.emit(sink, JqVal::Array(prefix)) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    }
  }
  Ok(())
}

fn EvalCtx::emit_all_paths_iter(
  self : EvalCtx,
  root : JqVal,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let stack : Array[(Array[JqVal], JqVal, Bool)] = [([], root, false)]
  while stack.length() > 0 {
    let (prefix, v, emit_self) = match stack.pop() {
      Some(x) => x
      None => break
    }
    match self.step() {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    if emit_self {
      match self.emit(sink, JqVal::Array(prefix)) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    }
    match v {
      JqVal::Array(items) => {
        let mut i = items.length() - 1
        while i >= 0 {
          stack.push((clone_path_with(prefix, JqVal::Int(i.to_int64())), items[i], true))
          i = i - 1
        }
      }
      JqVal::Object(obj) => {
        let es = obj.entries
        let mut i = es.length() - 1
        while i >= 0 {
          let (k, ev) = es[i]
          stack.push((clone_path_with(prefix, JqVal::Str(k)), ev, true))
          i = i - 1
        }
      }
      _ => ()
    }
  }
  Ok(())
}

fn EvalCtx::emit_filtered_paths_iter(
  self : EvalCtx,
  root : JqVal,
  pred_e : Int,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  let stack : Array[(Array[JqVal], JqVal, Bool)] = [([], root, false)]
  while stack.length() > 0 {
    let (prefix, v, check_self) = match stack.pop() {
      Some(x) => x
      None => break
    }
    match self.step() {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    if check_self {
      let cs = match self.eval_collect(pred_e, v, venv, fenv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      let mut ci = 0
      while ci < cs.length() {
        if jq_truthy(cs[ci]) {
          match self.emit(sink, JqVal::Array(prefix)) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
        }
        ci = ci + 1
      }
    }
    match v {
      JqVal::Array(items) => {
        let mut i = items.length() - 1
        while i >= 0 {
          stack.push((clone_path_with(prefix, JqVal::Int(i.to_int64())), items[i], true))
          i = i - 1
        }
      }
      JqVal::Object(obj) => {
        let es = obj.entries
        let mut i = es.length() - 1
        while i >= 0 {
          let (k, ev) = es[i]
          stack.push((clone_path_with(prefix, JqVal::Str(k)), ev, true))
          i = i - 1
        }
      }
      _ => ()
    }
  }
  Ok(())
}

fn EvalCtx::emit_tostream(
  self : EvalCtx,
  v : JqVal,
  prefix : Array[JqVal],
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  match self.step() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  match v {
    JqVal::Array(items) => {
      if items.length() == 0 {
        return self.emit(sink, JqVal::Array([JqVal::Array(prefix), JqVal::Array([])]))
      }
      let mut i = 0
      while i < items.length() {
        let child_p = clone_path_with(prefix, JqVal::Int(i.to_int64()))
        match self.emit_tostream(items[i], child_p, sink) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        i = i + 1
      }
      let end_p = clone_path_with(prefix, JqVal::Int((items.length() - 1).to_int64()))
      self.emit(sink, JqVal::Array([JqVal::Array(end_p)]))
    }
    JqVal::Object(obj) => {
      let es = obj.entries
      if es.length() == 0 {
        return self.emit(sink, JqVal::Array([JqVal::Array(prefix), JqVal::Object(jq_obj_from_entries([]))]))
      }
      let mut i = 0
      while i < es.length() {
        let (k, ev) = es[i]
        let child_p = clone_path_with(prefix, JqVal::Str(k))
        match self.emit_tostream(ev, child_p, sink) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        i = i + 1
      }
      let (last_k, _) = es[es.length() - 1]
      let end_p = clone_path_with(prefix, JqVal::Str(last_k))
      self.emit(sink, JqVal::Array([JqVal::Array(end_p)]))
    }
    _ => self.emit(sink, JqVal::Array([JqVal::Array(prefix), v]))
  }
}

fn EvalCtx::eval_walk(
  self : EvalCtx,
  f_expr : Int,
  v : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  match self.step() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  match self.enter() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let mapped = match v {
    JqVal::Array(items) => {
      let out : Array[JqVal] = []
      let mut i = 0
      while i < items.length() {
        let sub_sink = Sink::{ out: [], is_top_level: false, cap_remaining: -1, skip_remaining: 0 }
        match self.eval_walk(f_expr, items[i], venv, fenv, sub_sink) {
          Err(e) => {
            self.leave()
            return Err(e)
          }
          Ok(_) => ()
        }
        let mut j = 0
        while j < sub_sink.out.length() {
          out.push(sub_sink.out[j])
          j = j + 1
        }
        i = i + 1
      }
      JqVal::Array(out)
    }
    JqVal::Object(obj) => {
      let es = obj.entries
      let out : Array[(String, JqVal)] = []
      let mut i = 0
      while i < es.length() {
        let (k, ev) = es[i]
        let sub_sink = Sink::{ out: [], is_top_level: false, cap_remaining: 1, skip_remaining: 0 }
        match self.eval_walk(f_expr, ev, venv, fenv, sub_sink) {
          Ok(_) | Err(EvalSignal::CapReached) => ()
          Err(e) => {
            self.leave()
            return Err(e)
          }
        }
        if sub_sink.out.length() > 0 {
          out.push((k, sub_sink.out[0]))
        }
        i = i + 1
      }
      JqVal::Object(jq_obj_from_entries(out))
    }
    _ => v
  }
  self.leave()
  self.eval(f_expr, mapped, venv, fenv, sink)
}

fn EvalCtx::eval_builtin_1(
  self : EvalCtx,
  name : String,
  arg0 : Int,
  input : JqVal,
  venv : Int,
  fenv : Int,
  sink : Sink,
) -> Result[Unit, EvalSignal] {
  if name == "select" {
    let cs = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    let mut i = 0
    while i < cs.length() {
      if jq_truthy(cs[i]) {
        match self.emit(sink, input) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
      }
      i = i + 1
    }
    return Ok(())
  }
  if name == "map" {
    let items = match jq_iter_values(input) {
      Some(xs) => xs
      None => return Err(EvalSignal::Error(JqError::RuntimeError("cannot iterate over " + jq_type_name(input))))
    }
    let out : Array[JqVal] = []
    let mut i = 0
    while i < items.length() {
      let ys = match self.eval_collect(arg0, items[i], venv, fenv) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let mut j = 0
      while j < ys.length() {
        out.push(ys[j])
        j = j + 1
      }
      i = i + 1
    }
    return self.emit(sink, JqVal::Array(out))
  }
  if name == "map_values" {
    match input {
      JqVal::Object(obj) => {
        let es = obj.entries
        let out : Array[(String, JqVal)] = []
        let mut i = 0
        while i < es.length() {
          let (k, ev) = es[i]
          let ys = match self.eval_collect_cap(arg0, ev, venv, fenv, 1) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if ys.length() > 0 {
            out.push((k, ys[0]))
          }
          i = i + 1
        }
        return self.emit(sink, JqVal::Object(jq_obj_from_entries(out)))
      }
      JqVal::Array(xs) => {
        let out : Array[JqVal] = []
        let mut i = 0
        while i < xs.length() {
          let ys = match self.eval_collect_cap(arg0, xs[i], venv, fenv, 1) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if ys.length() > 0 {
            out.push(ys[0])
          }
          i = i + 1
        }
        return self.emit(sink, JqVal::Array(out))
      }
      other =>
      return Err(EvalSignal::Error(JqError::RuntimeError("cannot iterate over " + jq_type_name(other))))
    }
  }
  if name == "with_entries" {
    let entries_arr = match input {
      JqVal::Object(obj) => {
        let es = obj.entries
        let arr : Array[JqVal] = []
        let mut i = 0
        while i < es.length() {
          let (k, v) = es[i]
          arr.push(JqVal::Object(jq_obj_from_entries([("key", JqVal::Str(k)), ("value", v)])))
          i = i + 1
        }
        arr
      }
      _ => return Err(EvalSignal::Error(JqError::RuntimeError("with_entries requires an object")))
    }
    let out_entries : Array[(String, JqVal)] = []
    let hi = ObjHashIndex::new(if entries_arr.length() * 2 < 16 { 16 } else { entries_arr.length() * 2 })
    let mut i = 0
    while i < entries_arr.length() {
      let ys = match self.eval_collect(arg0, entries_arr[i], venv, fenv) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let mut j = 0
      while j < ys.length() {
        match ys[j] {
          JqVal::Object(obj) => {
            let k_opt = match jq_obj_get(obj, "key") {
              Some(v) => Some(v)
              None => match jq_obj_get(obj, "Key") {
                Some(v) => Some(v)
                None => match jq_obj_get(obj, "name") {
                  Some(v) => Some(v)
                  None => jq_obj_get(obj, "Name")
                }
              }
            }
            let key = match k_opt {
              Some(JqVal::Str(s)) => s
              _ => return Err(EvalSignal::Error(JqError::RuntimeError("with_entries requires string key")))
            }
            let val_opt = match jq_obj_get(obj, "value") {
              Some(v) => Some(v)
              None => jq_obj_get(obj, "Value")
            }
            let v = match val_opt { Some(x) => x None => JqVal::Null }
            let existing = hi.get(key)
            if existing >= 0 {
              out_entries[existing] = (key, v)
            } else {
              let idx = out_entries.length()
              let _ = hi.upsert(key, idx)
              out_entries.push((key, v))
            }
          }
          _ => return Err(EvalSignal::Error(JqError::RuntimeError("with_entries expects object entries")))
        }
        j = j + 1
      }
      i = i + 1
    }
    return self.emit(sink, JqVal::Object(JqObj::{ entries: out_entries, index: Some(hi) }))
  }
  if name == "error" || name == "halt_error" {
    let vs = match self.eval_collect_cap(arg0, input, venv, fenv, 1) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    if vs.length() == 0 {
      return Ok(())
    }
    return Err(EvalSignal::Error(JqError::UserError(to_json5(vs[0]))))
  }
  if name == "debug" {
    return self.emit(sink, input)
  }
  if name == "first" {
    // P0-4: streaming limit(1; arg0)
    return self.eval_streaming_limit(1, arg0, input, venv, fenv, sink)
  }
  if name == "last" {
    let vs = match self.eval_collect(arg0, input, venv, fenv) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    if vs.length() > 0 {
      return self.emit(sink, vs[vs.length() - 1])
    }
    return Ok(())
  }
  if name == "isempty" {
    let vs = match self.eval_collect_cap(arg0, input, venv, fenv, 1) {
      Ok(xs) => xs
      Err(e) => return Err(e)
    }
    return self.emit(sink, JqVal::Bool(vs.length() == 0))
  }
  if name == "add" {
