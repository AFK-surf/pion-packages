///| Flat arena AST definitions for `packages/jq`.

enum BinOp {
  Pipe
  Comma
  Alt
  Or
  And
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
  Add
  Sub
  Mul
  Div
  Mod
  Assign
  Update
  AddAssign
  SubAssign
  MulAssign
  DivAssign
  ModAssign
  AltAssign
}

enum PatKey {
  LitKey(String)
  ExprKey(Int)
}

enum Pattern {
  Var(String)
  ArrayPat(Array[Pattern])
  ObjPat(Array[(PatKey, Pattern)])
  AltPat(Array[Pattern])
}

enum ObjKey {
  Lit(String)
  Expr(Int)
  VarKey(String)
}

struct ObjEntry {
  key : ObjKey
  val_expr : Int
}

enum StrPart {
  Lit(String)
  Interp(Int)
}

struct ElifBranch {
  cond : Int
  body : Int
}

enum Expr {
  Identity
  Recurse
  NullLit
  BoolLit(Bool)
  NumLit(JqVal)
  StrLit(String)
  StrInterp(String, Array[StrPart])
  Format(String)
  VarRef(String)
  ArrayCons(Int)
  ObjCons(Array[ObjEntry])
  Field(Int, String, Bool)
  FieldChain(Int, Array[(String, Bool)])
  Index(Int, Int, Bool)
  Slice(Int, Int, Int, Bool)
  Iter(Int, Bool)
  Optional(Int)
  Neg(Int)
  Pos(Int)
  Bin(BinOp, Int, Int)
  PipeChain(Array[Int])
  CommaChain(Array[Int])
  AddChain(Int, Array[(BinOp, Int)])
  If(Int, Int, Array[ElifBranch], Int)
  Try(Int, Int)
  As(Int, Pattern, Int)
  Reduce(Int, Pattern, Int, Int)
  Foreach(Int, Pattern, Int, Int, Int)
  Def(String, Array[String], Int, Int)
  Label(String, Int)
  Break(String)
  Call(String, Array[Int])
}
