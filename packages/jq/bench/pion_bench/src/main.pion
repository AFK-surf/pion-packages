///| Pion Native head-to-head benchmark for `packages/jq` vs Go `github.com/itchyny/gojq`.
///| Workloads:
///|   w1 <file> - 10,000 K8s/API events: select + group_by + map + sort_by + object reconstruction
///|   w2 <file> - Deeply nested JSON tree: `.. | objects | select(...)` + `|=` batch rewrite
///|   w3 <file> - End-to-end Compile + Eval: 200 rounds x 5 queries (reduce, def, interp, @csv, test)

import "jq"

fn run_w1(world : World, path : String) -> Int {
  let raw = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read w1 input")
      return 1
    }
  }
  let doc = match jq::parse_json(raw) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "error: parse_json: " + jq::error_message(e))
      return 1
    }
  }
  let query_str = "[.[] | select(.ok)] | group_by(.ns) | map({ns: .[0].ns, count: length, total_ms: (map(.latency_ms) | add), max_ms: (map(.latency_ms) | max)}) | sort_by(-.total_ms)"
  let q = match jq::compile(query_str) {
    Ok(x) => x
    Err(e) => {
      io_println(world, "error: compile: " + jq::error_message(e))
      return 1
    }
  }
  let limits = jq::JqLimits::new(256, 50000000, 100000, 67108864)
  let mut last_out = ""
  let mut r = 0
  while r < 5 {
    let vals = match jq::run_with_limits(q, doc, limits) {
      Ok(vs) => vs
      Err(e) => {
        io_println(world, "error: run: " + jq::error_message(e))
        return 1
      }
    }
    if vals.length() != 1 {
      io_println(world, "error: expected 1 output")
      return 1
    }
    last_out = match jq::to_json_sorted(vals[0]) {
      Ok(s) => s
      Err(e) => {
        io_println(world, "error: to_json_sorted: " + jq::error_message(e))
        return 1
      }
    }
    r = r + 1
  }
  io_println(world, last_out)
  0
}

fn run_w2(world : World, path : String) -> Int {
  let raw = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read w2 input")
      return 1
    }
  }
  let doc = match jq::parse_json(raw) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "error: parse_json: " + jq::error_message(e))
      return 1
    }
  }
  let query_str = "(.. | objects | select(has(\"score\") and .active) | .score) |= . * 2 + 1 | [.. | objects | select(has(\"score\")) | .score] | {count: length, total: add, min: min, max: max}"
  let q = match jq::compile(query_str) {
    Ok(x) => x
    Err(e) => {
      io_println(world, "error: compile: " + jq::error_message(e))
      return 1
    }
  }
  let limits = jq::JqLimits::new(256, 50000000, 100000, 67108864)
  let mut last_out = ""
  let mut r = 0
  while r < 10 {
    let vals = match jq::run_with_limits(q, doc, limits) {
      Ok(vs) => vs
      Err(e) => {
        io_println(world, "error: run: " + jq::error_message(e))
        return 1
      }
    }
    if vals.length() != 1 {
      io_println(world, "error: expected 1 output")
      return 1
    }
    last_out = match jq::to_json_sorted(vals[0]) {
      Ok(s) => s
      Err(e) => {
        io_println(world, "error: to_json_sorted: " + jq::error_message(e))
        return 1
      }
    }
    r = r + 1
  }
  io_println(world, last_out)
  0
}

fn run_w3(world : World, path : String) -> Int {
  let raw = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read w3 input")
      return 1
    }
  }
  let doc = match jq::parse_json(raw) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "error: parse_json: " + jq::error_message(e))
      return 1
    }
  }
  let queries = [
    "reduce .items[] as $x (0; . + $x.price * $x.qty)",
    "def sum_tree: if type == \"array\" then (map(sum_tree) | add) elif type == \"object\" then ([.[]] | map(sum_tree) | add) elif type == \"number\" then . else 0 end; .nested | sum_tree",
    "[.items[] | \"\\(.sku):\\(.price)x\\(.qty)\"] | join(\"|\")",
    "[.items[] | [.sku, .category, .price, .qty] | @csv]",
    "[.items[] | select(.sku | test(\"^[A-Z]{2}-[0-9]{3}$\")) | .sku]",
  ]
  let limits = jq::JqLimits::new(256, 20000000, 100000, 67108864)
  let sb = StringBuilder::new()
  let mut r = 0
  while r < 200 {
    let mut qi = 0
    while qi < queries.length() {
      let q = match jq::compile_with_limits(queries[qi], limits) {
        Ok(x) => x
        Err(e) => {
          io_println(world, "error: compile: " + jq::error_message(e))
          return 1
        }
      }
      let vals = match jq::run_with_limits(q, doc, limits) {
        Ok(vs) => vs
        Err(e) => {
          io_println(world, "error: run: " + jq::error_message(e))
          return 1
        }
      }
      if r == 199 {
        let mut vi = 0
        while vi < vals.length() {
          match jq::to_json_sorted(vals[vi]) {
            Ok(s) => {
              sb.write_string(s)
              sb.write_byte(10.to_byte())
            }
            Err(e) => {
              io_println(world, "error: to_json_sorted: " + jq::error_message(e))
              return 1
            }
          }
          vi = vi + 1
        }
      }
      qi = qi + 1
    }
    r = r + 1
  }
  io_print(world, sb.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: jq_bench <w1|w2|w3> <input.json>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  if mode == "w1" {
    run_w1(world, path)
  } else if mode == "w2" {
    run_w2(world, path)
  } else if mode == "w3" {
    run_w3(world, path)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
