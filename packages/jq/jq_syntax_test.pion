///| Compliance tests for jq 1.7 / gojq syntax, operators, indexing, streams,
///| conditionals, try/catch, string interpolation, and array/object construction.

import "json5"

fn assert_jq(query : String, input_json : String, expected_json : Array[String]) -> Unit {
  let res = match eval_json(query, input_json) {
    Ok(xs) => xs
    Err(e) => {
      debug_assert(false, "query failed: " + query + " | input=" + input_json + " | err=" + error_message(e))
      return
    }
  }
  if res.length() != expected_json.length() {
    debug_assert(
      false,
      "output count mismatch for " + query + ": got " + res.length().to_string() + ", expected " + expected_json.length().to_string(),
    )
    return
  }
  let mut i = 0
  while i < res.length() {
    let got_v = match parse_json(res[i]) {
      Ok(v) => v
      Err(e) => {
        debug_assert(false, "invalid output json: " + res[i] + " err=" + error_message(e))
        return
      }
    }
    let exp_v = match parse_json(expected_json[i]) {
      Ok(v) => v
      Err(e) => {
        debug_assert(false, "invalid expected json: " + expected_json[i] + " err=" + error_message(e))
        return
      }
    }
    if !json5::value_eq(got_v, exp_v) {
      debug_assert(
        false,
        "mismatch at output[" + i.to_string() + "] for " + query + ": got=" + res[i] + " expected=" + expected_json[i],
      )
      return
    }
    i = i + 1
  }
}

fn assert_jq_exact(query : String, input_json : String, expected : Array[String]) -> Unit {
  let res = match eval_json(query, input_json) {
    Ok(xs) => xs
    Err(e) => {
      debug_assert(false, "query failed: " + query + " | err=" + error_message(e))
      return
    }
  }
  if res.length() != expected.length() {
    debug_assert(
      false,
      "exact count mismatch for " + query + ": got " + res.length().to_string() + ", expected " + expected.length().to_string(),
    )
    return
  }
  let mut i = 0
  while i < res.length() {
    if res[i] != expected[i] {
      debug_assert(
        false,
        "exact mismatch at [" + i.to_string() + "] for " + query + ": got=" + res[i] + " expected=" + expected[i],
      )
      return
    }
    i = i + 1
  }
}

fn assert_jq_err(query : String, input_json : String) -> Unit {
  match eval_json(query, input_json) {
    Ok(_) => debug_assert(false, "expected error for query: " + query + " on " + input_json)
    Err(_) => ()
  }
}

test "identity_and_literals" {
  assert_jq(".", "null", ["null"])
  assert_jq(".", "true", ["true"])
  assert_jq(".", "42", ["42"])
  assert_jq(".", "\"hello\"", ["\"hello\""])
  assert_jq(".", "[1,2,3]", ["[1,2,3]"])
  assert_jq("null", "123", ["null"])
  assert_jq("true", "null", ["true"])
  assert_jq("false", "null", ["false"])
  assert_jq("123.5", "null", ["123.5"])
  assert_jq("-42", "null", ["-42"])
  assert_jq("\"a\\nb\\t\\\"c\\\\\"", "null", ["\"a\\nb\\t\\\"c\\\\\""])
  assert_jq("# comment\n42 # trailing", "null", ["42"])
}

test "field_and_index_access" {
  assert_jq(".foo", "{\"foo\": 42, \"bar\": 99}", ["42"])
  assert_jq(".missing", "{\"foo\": 42}", ["null"])
  assert_jq(".foo", "null", ["null"])
  assert_jq(".\"a-b\"", "{\"a-b\": 7}", ["7"])
  assert_jq(".a.b.c", "{\"a\":{\"b\":{\"c\":10}}}", ["10"])
  assert_jq(".[0]", "[10,20,30]", ["10"])
  assert_jq(".[-1]", "[10,20,30]", ["30"])
  assert_jq(".[-4]", "[10,20,30]", ["null"])
  assert_jq(".[5]", "[10,20,30]", ["null"])
  assert_jq(".[\"foo\"]", "{\"foo\":1}", ["1"])
  assert_jq(".foo?", "42", [])
  assert_jq(".[0]?", "\"notarray\"", [])
  assert_jq_err(".foo", "42")
  assert_jq_err(".[0]", "{\"a\":1}")
}

test "slicing_arrays_and_strings" {
  assert_jq(".[1:3]", "[0,1,2,3,4]", ["[1,2]"])
  assert_jq(".[:2]", "[0,1,2,3]", ["[0,1]"])
  assert_jq(".[2:]", "[0,1,2,3]", ["[2,3]"])
  assert_jq(".[-2:]", "[0,1,2,3]", ["[2,3]"])
  assert_jq(".[3:1]", "[0,1,2,3]", ["[]"])
  assert_jq(".[1:4]", "\"abcdef\"", ["\"bcd\""])
  assert_jq(".[:2]", "\"abcdef\"", ["\"ab\""])
  assert_jq(".[-2:]", "\"abcdef\"", ["\"ef\""])
  assert_jq(".[1:3]", "\"αβγδ\"", ["\"βγ\""])
  assert_jq(".[1:3]", "null", ["null"])
}

test "iterators_and_recursive_descent" {
  assert_jq(".[]", "[1,2,3]", ["1", "2", "3"])
  assert_jq(".[]", "{\"a\":1,\"b\":2}", ["1", "2"])
  assert_jq(".[]", "[]", [])
  assert_jq(".[]?", "42", [])
  assert_jq_err(".[]", "42")
  assert_jq("[.. | numbers]", "{\"a\":1,\"b\":[2,{\"c\":3}]}", ["[1,2,3]"])
  assert_jq("[..]", "[[1],2]", ["[[[1],2],[1],1,2]"])
}

test "pipes_and_commas_streams" {
  assert_jq("1, 2, 3", "null", ["1", "2", "3"])
  assert_jq("(1, 2) | (. * 10, . * 100)", "null", ["10", "100", "20", "200"])
  assert_jq("[.[] | . * 2]", "[1,2,3]", ["[2,4,6]"])
  assert_jq(".a, .b", "{\"a\":1,\"b\":2}", ["1", "2"])
}

test "arithmetic_operators" {
  assert_jq("1 + 2 * 3", "null", ["7"])
  assert_jq("(1 + 2) * 3", "null", ["9"])
  assert_jq("10 - 3 - 2", "null", ["5"])
  assert_jq("10 / 4", "null", ["2.5"])
  assert_jq("7 % 3", "null", ["1"])
  assert_jq("null + 5", "null", ["5"])
  assert_jq("5 + null", "null", ["5"])
  assert_jq("\"foo\" + \"bar\"", "null", ["\"foobar\""])
  assert_jq("[1,2] + [3,4]", "null", ["[1,2,3,4]"])
  assert_jq("{\"a\":1,\"b\":2} + {\"b\":3,\"c\":4}", "null", ["{\"a\":1,\"b\":3,\"c\":4}"])
  assert_jq("[1,2,3,2,4] - [2,4]", "null", ["[1,3]"])
  assert_jq("\"ab\" * 3", "null", ["\"ababab\""])
  assert_jq("3 * \"ab\"", "null", ["\"ababab\""])
  assert_jq("\"ab\" * 0", "null", ["null"])
  assert_jq("\"ab\" * -1", "null", ["null"])
  assert_jq("{\"a\":{\"x\":1,\"y\":2},\"b\":1} * {\"a\":{\"y\":9,\"z\":3}}", "null", ["{\"a\":{\"x\":1,\"y\":9,\"z\":3},\"b\":1}"])
  assert_jq("\"a,b,c\" / \",\"", "null", ["[\"a\",\"b\",\"c\"]"])
  assert_jq_err("1 / 0", "null")
  assert_jq_err("1 % 0", "null")
}

test "comparisons_and_jq_total_order" {
  assert_jq("null < false", "null", ["true"])
  assert_jq("false < true", "null", ["true"])
  assert_jq("true < -100", "null", ["true"])
  assert_jq("100 < \"\"", "null", ["true"])
  assert_jq("\"z\" < []", "null", ["true"])
  assert_jq("[999] < {}", "null", ["true"])
  assert_jq("[1,2] < [1,3]", "null", ["true"])
  assert_jq("[1,2] < [1,2,0]", "null", ["true"])
  assert_jq("{\"a\":1} < {\"a\":2}", "null", ["true"])
  assert_jq("{\"a\":1} < {\"b\":0}", "null", ["true"])
  assert_jq("{\"a\":1,\"b\":2} == {\"b\":2,\"a\":1}", "null", ["true"])
  assert_jq("1 == 1.0", "null", ["true"])
  assert_jq("1 != 2", "null", ["true"])
  assert_jq("2 <= 2 and 2 >= 2", "null", ["true"])
}

test "boolean_and_alternative_operators" {
  assert_jq("true and false", "null", ["false"])
  assert_jq("true or false", "null", ["true"])
  assert_jq("null | not", "null", ["true"])
  assert_jq("false | not", "null", ["true"])
  assert_jq("0 | not", "null", ["false"])
  assert_jq("\"\" | not", "null", ["false"])
  assert_jq("[] | not", "null", ["false"])
  assert_jq("null // 42", "null", ["42"])
  assert_jq("false // 42", "null", ["42"])
  assert_jq("0 // 42", "null", ["0"])
  assert_jq("empty // 42", "null", ["42"])
  assert_jq("(false, null, 1, 2) // 99", "null", ["1", "2"])
  assert_jq("(false, null) // 99", "null", ["99"])
}

test "conditionals_and_multi_value_cond" {
  assert_jq("if . > 0 then \"pos\" elif . < 0 then \"neg\" else \"zero\" end", "5", ["\"pos\""])
  assert_jq("if . > 0 then \"pos\" elif . < 0 then \"neg\" else \"zero\" end", "-3", ["\"neg\""])
  assert_jq("if . > 0 then \"pos\" elif . < 0 then \"neg\" else \"zero\" end", "0", ["\"zero\""])
  assert_jq("if true then 1 end", "99", ["1"])
  assert_jq("if false then 1 end", "99", ["99"])
  assert_jq("[if (true, false) then \"yes\" else \"no\" end]", "null", ["[\"yes\",\"no\"]"])
}

test "try_catch_semantics" {
  assert_jq("try .foo catch \"caught\"", "42", ["\"caught\""])
  assert_jq("try error(\"boom\") catch .", "null", ["\"boom\""])
  assert_jq("try error({\"code\":404}) catch .code", "null", ["404"])
  assert_jq("try .foo", "42", [])
  assert_jq("[.[] | try (. + 1)]", "[1,\"bad\",3]", ["[2,4]"])
}

test "string_interpolation" {
  assert_jq("\"hello \\(.name)!\"", "{\"name\":\"pion\"}", ["\"hello pion!\""])
  assert_jq("\"x=\\(1 + 2), y=\\([1,2])\"", "null", ["\"x=3, y=[1,2]\""])
  assert_jq("[\"\\(1, 2)-\\(\"a\", \"b\")\"]", "null", ["[\"1-a\",\"1-b\",\"2-a\",\"2-b\"]"])
}

test "array_and_object_construction" {
  assert_jq("[1, 2, 3]", "null", ["[1,2,3]"])
  assert_jq("[]", "null", ["[]"])
  assert_jq("{}", "null", ["{}"])
  assert_jq("{a, b}", "{\"a\":1,\"b\":2,\"c\":3}", ["{\"a\":1,\"b\":2}"])
  assert_jq("{(.k): .v}", "{\"k\":\"x\",\"v\":10}", ["{\"x\":10}"])
  assert_jq("[{a: (1, 2), b: (3, 4)}]", "null", ["[{\"a\":1,\"b\":3},{\"a\":1,\"b\":4},{\"a\":2,\"b\":3},{\"a\":2,\"b\":4}]"])
  assert_jq("[{(\"a\", \"b\"): (1, 2)}]", "null", ["[{\"a\":1},{\"a\":2},{\"b\":1},{\"b\":2}]"])
}
