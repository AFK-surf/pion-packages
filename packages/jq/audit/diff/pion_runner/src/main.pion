///| Red-team differential runner for `packages/jq`.
///| Usage: jq_redteam_runner <corpus.json>
///| The corpus is a JSON array of `[query, input_json]` string pairs. For every case one
///| JSON line is printed immediately: `{"ok":[<to_json_sorted output>...]}` or
///| `{"err":"<kind>: <message>"}` (same schema as `audit/diff/go`).

import "jq"
import "json5"

fn err_kind(e : jq::JqError) -> String {
  match e {
    jq::JqError::SyntaxError(_, _) => "syntax"
    jq::JqError::CompileError(_) => "compile"
    jq::JqError::RuntimeError(_) => "runtime"
    jq::JqError::UserError(_) => "runtime"
    jq::JqError::InvalidJson(_) => "invalid json"
    jq::JqError::LimitExceeded(_) => "limit"
    jq::JqError::InvalidLimits(_) => "limits"
  }
}

fn err_line(e : jq::JqError) -> String {
  let v = json5::Json5Value::Object([("err", json5::Json5Value::Str(err_kind(e) + ": " + jq::error_message(e)))])
  match jq::to_json(v) {
    Ok(s) => s
    Err(_) => "{\"err\":\"unserializable error\"}"
  }
}

fn run_case(q : String, input : String) -> String {
  let query = match jq::compile(q) {
    Ok(x) => x
    Err(e) => return err_line(e)
  }
  let doc = match jq::parse_json(input) {
    Ok(v) => v
    Err(e) => return err_line(e)
  }
  let vals = match jq::run(query, doc) {
    Ok(vs) => vs
    Err(e) => return err_line(e)
  }
  let outs : Array[json5::Json5Value] = []
  let mut i = 0
  while i < vals.length() {
    match jq::to_json_sorted(vals[i]) {
      Ok(s) => outs.push(json5::Json5Value::Str(s))
      Err(e) => return err_line(e)
    }
    i = i + 1
  }
  match jq::to_json(json5::Json5Value::Object([("ok", json5::Json5Value::Array(outs))])) {
    Ok(s) => s
    Err(e) => err_line(e)
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: jq_redteam_runner <corpus.json>")
    return 2
  }
  let raw = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: cannot read corpus")
      return 2
    }
  }
  let corpus = match jq::parse_json(raw) {
    Ok(json5::Json5Value::Array(xs)) => xs
    _ => {
      io_println(world, "error: corpus must be a JSON array")
      return 2
    }
  }
  let mut i = 0
  while i < corpus.length() {
    match corpus[i] {
      json5::Json5Value::Array(pair) =>
      if pair.length() == 2 {
        match (pair[0], pair[1]) {
          (json5::Json5Value::Str(q), json5::Json5Value::Str(inp)) =>
          io_println(world, run_case(q, inp))
          _ => io_println(world, "{\"err\":\"bad case\"}")
        }
      } else {
        io_println(world, "{\"err\":\"bad case\"}")
      }
      _ => io_println(world, "{\"err\":\"bad case\"}")
    }
    i = i + 1
  }
  0
}
