///| Red-team audit of `packages/jq` (RT-jq), baseline `feat/pkg-jq` @ 35ff1bb.
///|
///| Every `p0_*` / `p1_*` / `p2_*` test asserts the behaviour on which Go
///| `github.com/itchyny/gojq v0.12.17` AND `jq 1.7.1` agree (both were run on the exact
///| query/input, see audit/diff) and therefore FAILS on the audited baseline: the failure is
///| the evidence. Every `control_*` test pins something the package already gets right and
///| must keep passing. See REPORT.md for root causes.

import "jq"
import "json5"

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

///| Run `q` on `input` and render every output with `to_json_sorted`; errors become "ERR: ...".
fn run_q(q : String, input : String) -> Array[String] {
  let doc = match jq::parse_json(input) {
    Ok(v) => v
    Err(e) => return ["ERR: " + jq::error_message(e)]
  }
  let query = match jq::compile(q) {
    Ok(x) => x
    Err(e) => return ["ERR: " + jq::error_message(e)]
  }
  let vals = match jq::run(query, doc) {
    Ok(vs) => vs
    Err(e) => return ["ERR: " + jq::error_message(e)]
  }
  let out : Array[String] = []
  let mut i = 0
  while i < vals.length() {
    match jq::to_json_sorted(vals[i]) {
      Ok(s) => out.push(s)
      Err(e) => out.push("ERR: " + jq::error_message(e))
    }
    i = i + 1
  }
  out
}

///|
fn show(xs : Array[String]) -> String {
  let sb = StringBuilder::new()
  sb.write_string("[")
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(" , ")
    }
    sb.write_string(xs[i])
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///| Assert the exact output stream (compact, keys sorted).
fn expect(q : String, input : String, want : Array[String]) -> Unit {
  let got = run_q(q, input)
  let mut same = got.length() == want.length()
  let mut i = 0
  while same && i < got.length() {
    if got[i] != want[i] {
      same = false
    }
    i = i + 1
  }
  debug_assert(same, "jq `" + q + "` on " + input + ": got " + show(got) + ", gojq+jq1.7.1 give " + show(want))
}

///| Assert that every output of `eval_json` is valid UTF-8 JSON (re-parsed from raw bytes).
fn expect_valid_utf8_json(q : String, input : String) -> Unit {
  match jq::eval_json(q, input) {
    Ok(xs) => {
      let mut i = 0
      while i < xs.length() {
        match json5::parse_bytes(xs[i].to_bytes()) {
          Ok(_) => ()
          Err(e) => debug_assert(false, "jq `" + q + "` on " + input + " emitted output that is not valid UTF-8 JSON: " + e.message)
        }
        i = i + 1
      }
    }
    Err(e) => debug_assert(false, "jq `" + q + "` failed: " + jq::error_message(e))
  }
}

///| Assert that `q` is rejected at compile time.
fn expect_compile_error(q : String) -> Unit {
  match jq::compile(q) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "jq `" + q + "` must be a compile error (gojq + jq 1.7.1 reject it), but compiled")
  }
}

///| True when a rendered output is an error marker ("ERR: ...").
fn is_err(s : String) -> Bool {
  s.length() >= 4 && s.code_unit_at(0) == 69 && s.code_unit_at(1) == 82 && s.code_unit_at(2) == 82 && s.code_unit_at(3) == 58
}

///| Assert that `q` fails (any error) on `input`.
fn expect_error(q : String, input : String) -> Unit {
  let got = run_q(q, input)
  let mut failed = false
  let mut i = 0
  while i < got.length() {
    if is_err(got[i]) {
      failed = true
    }
    i = i + 1
  }
  debug_assert(failed, "jq `" + q + "` on " + input + " must error (gojq + jq 1.7.1), got " + show(got))
}

// ===========================================================================
// P0: silent data corruption / security-relevant wrong answers
// ===========================================================================

///| P0-1 Regex `^`/`$` are compiled multi-line by default (`compile_jq_regex` sets
///| `multi_line = true`), so anchored validation patterns are bypassed by an embedded newline.
test "p0_regex_anchors_are_multiline_by_default_validation_bypass" {
  // classic allow-list check: must reject a value carrying a second line
  expect("test(\"^[a-z]+$\")", "\"ok\\n; rm -rf /\"", ["false"])
  expect("test(\"^line2\")", "\"line1\\nline2\"", ["false"])
  expect("[match(\"^.\"; \"g\").string]", "\"a\\nb\"", ["[\"a\"]"])
  expect("gsub(\"$\"; \"!\")", "\"l1\\nl2\"", ["\"l1\\nl2!\""])
  expect("gsub(\"^\"; \">\")", "\"l1\\nl2\"", ["\">l1\\nl2\""])
}

///| P0-2 Numbers are `json5::Number(Double)`: integer literals above 2^53 are silently changed
///| even by the identity filter (`jq .` corrupts 64-bit IDs). gojq keeps `int`/`big.Int`; jq 1.7
///| preserves the literal. `range` over such bounds becomes empty.
test "p0_large_integer_identity_corrupts_ids" {
  expect(".", "9007199254740993", ["9007199254740993"])
  expect(".id", "{\"id\":1234567890123456789}", ["1234567890123456789"])
  expect("[.[] | .id]", "[{\"id\":13911860366432393}]", ["[13911860366432393]"])
  expect("values", "12345678901234567890", ["12345678901234567890"])
}

///| P0-3 `jq_mod` computes `x - trunc(x/y)*y` in Double, which loses the remainder once
///| |x| > 2^53/|y|; jq/gojq use integer remainder.
test "p0_modulo_wrong_for_large_operands" {
  expect("1e17 % 7", "null", ["5"])
}

///| P0-6 `max_output_bytes` is not enforced by serialization: values that share structure
///| (`[., .]` doubling) are cheap to build but `tojson`/`tostring`/`to_json` expand them without
///| any budget (run_dos: `reduce range(40) ... | tojson` runs unbounded; the object variant
///| aborts the whole process with a runtime panic "container length exceeds maximum").
test "p0_max_output_bytes_bypassed_by_shared_structure_serialization" {
  let lim = jq::JqLimits::new(64, 100000, 1000, 4096)
  match jq::eval_json_with_limits("reduce range(18) as $i ([1]; [., .]) | tojson | length", "null", lim) {
    Err(jq::JqError::LimitExceeded(_)) => ()
    Ok(xs) => debug_assert(false, "tojson produced " + show(xs) + " bytes under max_output_bytes=4096")
    Err(e) => debug_assert(false, "unexpected error " + jq::error_message(e))
  }
  match jq::eval_json_with_limits("reduce range(18) as $i ([1]; [., .])", "null", lim) {
    Err(jq::JqError::LimitExceeded(_)) => ()
    Ok(xs) =>
    debug_assert(false, "a 2^18-leaf output passed max_output_bytes=4096 (serialized length " + xs[0].length().to_string() + ")")
    Err(e) => debug_assert(false, "unexpected error " + jq::error_message(e))
  }
}

///| P0-4 `limit` (and every collect-then-emit builtin) buffers its argument's outputs with
///| `eval_collect_cap`; a later `error` or `break` discards the outputs already produced.
test "p0_limit_drops_outputs_already_emitted_on_error_or_break" {
  expect("[label $f | limit(3; 1, break $f)]", "null", ["[1]"])
  expect("try limit(5; 1, 2, error(\"x\")) catch .", "null", ["1", "2", "\"x\""])
  expect("[limit(5; .[] | if . == 0 then error(\"z\") else . end)?]", "[1,0,2]", ["[1]"])
  expect(
    "[range(.) | label $out | limit(3; 1, if . > 1 then break $out end, 2)]",
    "3",
    ["[1,0,2,1,1,2,1]"],
  )
}

///| P0-5 `@base64d` (`bytes_to_string_lossy`) and `implode` of a surrogate code point put bytes
///| that are not UTF-8 inside a `String`; `to_json` then emits them raw, so the output stream is
///| not valid UTF-8 / JSON. gojq and jq replace invalid sequences with U+FFFD.
test "p0_invalid_utf8_inside_strings_base64d_implode" {
  // "aaaa" decodes to bytes 69 a6 9a; gojq emits "i\ufffd\ufffd", jq 1.7.1 emits raw U+FFFD
  expect_valid_utf8_json("@base64d", "\"aaaa\"")
  expect_valid_utf8_json("[@base64d] | tojson", "\"/w==\"")
  // lone surrogate code point: Pion stores CESU bytes ED A0 80; gojq/jq: U+FFFD (EF BF BD)
  expect("[55296] | implode | @base64", "null", ["\"77+9\""])
}

// ===========================================================================
// P1: core jq semantics that fail or silently differ
// ===========================================================================

///| P1-1 Path expressions (`path`, `|=`, `=`, `del`, `paths(f)`) only support
///| `. .a .[i] .[] .. , | select if` and type filters: user-defined functions fail.
test "p1_path_through_user_defined_function" {
  expect("def f: .a; f |= 1", "{\"a\":5}", ["{\"a\":1}"])
  expect("def f: .b[0]; del(f)", "{\"b\":[1,2,3]}", ["{\"b\":[2,3]}"])
  expect("def f($x): .y; path(f(.x))", "null", ["[\"y\"]"])
}

///| P1-2 Slice paths are not implemented in path mode (`Expr::Slice` missing in eval_paths_inner).
test "p1_slice_update_and_delete" {
  expect(".[1:3] |= map(. * 10)", "[1,2,3,4]", ["[1,20,30,4]"])
  expect(".[1:] = []", "[0,1,2]", ["[0]"])
  expect("del(.[1:])", "[1,2,3]", ["[1]"])
  expect(".a[1:] = [\"x\"]", "{\"a\":[1,2,3]}", ["{\"a\":[1,\"x\"]}"])
  expect("path(.[1:2])", "null", ["[{\"end\":2,\"start\":1}]"])
}

///| P1-3 Common builtins / operators are not valid path expressions.
test "p1_path_through_first_getpath_alt_reduce_try" {
  expect("first(.b[]) |= 9", "{\"b\":[1,2,3]}", ["{\"b\":[9,2,3]}"])
  expect("getpath([\"x\"]) = 1", "null", ["{\"x\":1}"])
  expect("path(.a // .b)", "null", ["[\"b\"]"])
  expect("[path(foreach (\"a\",\"b\") as $k (.; .[$k]))]", "null", ["[[\"a\"],[\"b\"]]"])
  expect("path(try .a catch .b)", "null", ["[\"a\"]"])
  expect("path(.a as $x | .b)", "null", ["[\"b\"]"])
  expect("[path(recurse)]", "null", ["[[]]"])
}

///| P1-4 Unknown functions are not rejected by `compile`: the "compile error" is raised at run
///| time, so `?` / `try` swallow it and a typo silently produces no output.
test "p1_unknown_function_is_not_a_compile_error" {
  expect_compile_error("nosuchfn")
  expect_compile_error("[.[] | nosuchfn(1)]?")
  expect("[paths(numbers)]?", "{\"a\":5}", ["[[\"a\"]]"])
}

///| P1-5 Parser accepts `. a` as `.a` (gojq/jq: syntax error).
test "p1_parser_accepts_space_between_dot_and_field" {
  expect_compile_error(". a")
  expect_compile_error(". foo | . bar")
}

///| P1-6 `try`/`catch` bodies are parsed too greedily (jq: `try` takes a post-term).
test "p1_try_catch_precedence" {
  expect("1 + try 2 catch 3 + 4", "null", ["7"])
  expect("try error(0) // 1", "null", ["1"])
}

///| P1-7 Object values cannot contain a pipe without parentheses (jq grammar `ObjVal: ExpD`).
test "p1_object_value_pipe_without_parens" {
  expect("{x: -. | abs}", "1", ["{\"x\":1}"])
  expect("{\"bar\": {\"baz\":.} | select(.baz)}", "{\"foo\":100}", ["{\"bar\":{\"baz\":{\"foo\":100}}}"])
}

///| P1-8 `sub`/`gsub` with a multi-output replacement keep only the first output.
test "p1_sub_gsub_multi_output_replacement" {
  expect("sub(\"a\"; \"1\", \"2\")", "\"abc\"", ["\"1bc\"", "\"2bc\""])
  expect("gsub(\"a\"; \"1\", \"2\")", "\"abc\"", ["\"1bc\"", "\"2bc\""])
}

///| P1-9 `add`, `any`, `all`, `join`, `flatten`, `first/last`, `with_entries` reject objects/null.
test "p1_collection_builtins_reject_objects_and_null" {
  expect("add", "{\"a\":1,\"b\":2}", ["3"])
  expect("add", "{}", ["null"])
  expect("any", "{\"a\":true}", ["true"])
  expect("all", "{}", ["true"])
  expect("join(\",\")", "{\"a\":\"x\",\"b\":\"y\"}", ["\"x,y\""])
  expect(".[] |= . * 2 | add", "{\"a\":1,\"b\":2}", ["6"])
}

///| P1-11 `max_outputs` is checked per collection sink (`EvalCtx::emit`), not per query: with the
///| default limits any `[...]` with more than 100000 elements fails (`[range(150000)]`, `tojson`
///| of a 200k array, `join` of 200k strings), although the query emits a single value.
test "p1_default_max_outputs_rejects_ordinary_large_arrays" {
  expect("[range(150000)] | length", "null", ["150000"])
}

///| P1-12 `parse_json` hard-codes json5 strict `max_depth: 128` and ignores `JqLimits.max_depth`:
///| documents nested 129..256 deep (accepted by jq 1.7.1 and gojq) are rejected, and values that
///| jq itself builds deeper cannot round-trip through `tojson | fromjson`.
test "p1_parse_json_depth_128_ignores_limits" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 200 {
    sb.write_string("[")
    i = i + 1
  }
  i = 0
  while i < 200 {
    sb.write_string("]")
    i = i + 1
  }
  expect("[paths] | length", sb.to_string(), ["199"])
  expect("reduce range(150) as $i (0; [.]) | tojson | fromjson | [paths] | length", "null", ["150"])
}

///| P1-10 Missing jq 1.7 builtins in daily use.
test "p1_missing_core_builtins" {
  expect("[paths(type == \"number\")]", "{\"a\":1,\"b\":[2]}", ["[[\"a\"],[\"b\",0]]"])
  expect("[while(. < 10; . + 3)]", "1", ["[1,4,7]"])
  expect("until(. > 10; . * 2)", "1", ["16"])
  expect("[limit(3; repeat(1))]", "null", ["[1,1,1]"])
  expect("walk(if type == \"number\" then . + 1 else . end)", "[1,{\"a\":2}]", ["[2,{\"a\":3}]"])
  expect("[.[] | IN(2, 3)]", "[1,2]", ["[false,true]"])
  expect("[tostream]", "[1]", ["[[[0],1],[[0]]]"])
  expect("nth(1)", "[5,6]", ["6"])
  expect("pow(2; 10)", "null", ["1024"])
  expect("sqrt", "16", ["4"])
}

// ===========================================================================
// P2: edge semantics, syntax coverage, formatting
// ===========================================================================

///| P2-1 Negative zero is stringified as "-0.0" (jq 1.7.1: "-0", gojq: "0").
test "p2_negative_zero_tostring" {
  let got = run_q("-0 | tostring", "null")
  debug_assert(got.length() == 1 && (got[0] == "\"-0\"" || got[0] == "\"0\""), "-0|tostring got " + show(got))
  let got2 = run_q("[-0] | tojson", "null")
  debug_assert(got2.length() == 1 && (got2[0] == "\"[-0]\"" || got2[0] == "\"[0]\""), "[-0]|tojson got " + show(got2))
}

///| P2-2 Stream ordering of string interpolation and of index-expressions.
test "p2_multi_output_ordering" {
  expect("[\"\\(1,2)-\\(3,4)\"]", "null", ["[\"1-3\",\"2-3\",\"1-4\",\"2-4\"]"])
  expect("[.c[][.k[]]]", "{\"k\":[\"a\",\"b\"],\"c\":[{\"a\":1,\"b\":2},{\"a\":3,\"b\":4}]}", ["[1,3,2,4]"])
}

///| P2-3 `nan < nan` must be true (nan sorts below every number in jq).
test "p2_nan_ordering" {
  expect("nan < nan", "null", ["true"])
}

///| P2-4 `has`/`in`/`indices` on null.
test "p2_null_has_and_indices" {
  expect("has(\"a\")", "null", ["false"])
  expect("in(null)", "0", ["false"])
  expect("indices(1)", "null", ["null"])
}

///| P2-5 Duplicate parameter names, multi-key destructuring, `?//`, array index `.[[x]]`.
test "p2_binding_edge_cases" {
  expect("def f($g;$g): $g; f(1;2,3)", "null", ["2", "3"])
  expect("{\"a\":1} as {(\"a\",\"b\"):$v} | $v", "null", ["1", "null"])
  expect(". as [$a] ?// $a | $a", "[[1,2]]", ["[1,2]"])
  expect(".[[1]]", "[1,2,1]", ["[0,2]"])
}

///| P2-6 Lexer coverage: keyword field names, interpolated field names, `.a.[0]`, number forms.
test "p2_lexer_coverage" {
  expect(".and, .or", "{\"and\":1,\"or\":2}", ["1", "2"])
  expect(".\"a\\(1)\"", "{\"a1\":3}", ["3"])
  expect(".a.[0]", "{\"a\":[7]}", ["7"])
  expect("[5., 01000]", "null", ["[5,1000]"])
  expect("1e1000 | . > 1e308", "null", ["true"])
}

///| P2-7 `@sh` quotes null/booleans and accepts objects; `@csv`/`@tsv` render nan as "null".
test "p2_format_strings" {
  expect("@sh", "null", ["\"null\""])
  expect("[1, true] | @sh", "null", ["\"1 true\""])
  expect_error("[{\"a\":1}] | @sh", "null")
  expect("[nan] | @csv", "null", ["\"\""])
}

///| P2-8 `tonumber` rejects inputs jq/gojq accept.
test "p2_tonumber_leniency" {
  expect("tonumber", "\"+4.2\"", ["4.2"])
  expect("tonumber", "\"05\"", ["5"])
  expect("tonumber", "\".5\"", ["0.5"])
}

///| P2-9 String repetition by a fraction in (0,1) (jq 1.7.1 / gojq: "").
test "p2_string_repeat_fraction" {
  expect("\"ab\" * 0.5", "null", ["\"\""])
}

///| P2-11 Default `max_depth = 256` caps *call* depth: ordinary tail-recursive jq that gojq and
///| jq run fine (depth 1e4) fails with LimitExceeded under the default limits.
test "p2_default_depth_limit_rejects_ordinary_recursion" {
  expect("def f: if . < 1000 then . + 1 | f else . end; 0 | f", "null", ["1000"])
  expect("[limit(1000; def f: ., (. + 1 | f); 0 | f)] | length", "null", ["1000"])
}

// ===========================================================================
// controls: behaviour the package already gets right (must PASS)
// ===========================================================================

test "control_streams_and_cartesian_products" {
  expect("[(1,2) + (10,20)]", "null", ["[11,12,21,22]"])
  expect("[{a:(1,2), b:(3,4)}]", "null", ["[{\"a\":1,\"b\":3},{\"a\":1,\"b\":4},{\"a\":2,\"b\":3},{\"a\":2,\"b\":4}]"])
  expect("[if (true,false) then 1 else 2 end]", "null", ["[1,2]"])
  expect("[if false then 1 elif (true,false) then 2 else 3 end]", "null", ["[2,3]"])
  expect("[(true,false) and (true,false)]", "null", ["[true,false,false]"])
  expect("[(false, null, 1) // 2]", "null", ["[1]"])
  expect("[(false, null) // (3, 4)]", "null", ["[3,4]"])
}

test "control_reduce_foreach_label" {
  expect("reduce range(5) as $i (0; . + $i)", "null", ["10"])
  expect("[foreach range(5) as $i (0; . + $i; [$i, .])]", "null", ["[[0,0],[1,1],[2,3],[3,6],[4,10]]"])
  expect("[label $f | range(10) | ., (select(. == 3) | break $f)]", "null", ["[0,1,2,3]"])
  expect("[label $f | first(1, break $f)]", "null", ["[1]"])
}

test "control_def_closures_and_arity_overloading" {
  expect("def f: 1; def f(x): 2; [f, f(.)]", "null", ["[1,2]"])
  expect("1 as $x | def f: $x; 2 as $x | f", "null", ["1"])
  expect("def x: 1; def y: x; def x: 2; y", "null", ["1"])
  expect("def rec(f): def r: ., (f | r); r; [3 | rec(if . > 0 then . - 1 else empty end)]", "null", ["[3,2,1,0]"])
}

test "control_basic_update_operators" {
  expect("{} | .a.b.c |= 1", "null", ["{\"a\":{\"b\":{\"c\":1}}}"])
  expect("[1,2,3] | (.[] | select(. > 1)) |= empty", "null", ["[1]"])
  expect("{\"a\":[{\"b\":1},{\"b\":2}]} | .a[].b |= . * 10", "null", ["{\"a\":[{\"b\":10},{\"b\":20}]}"])
  expect("{\"a\":1} | .a += (1,2)", "null", ["{\"a\":2}", "{\"a\":3}"])
  expect("null | .[2] = 1", "null", ["[null,null,1]"])
  expect("[1,2,3,4] | del(.[0, 2])", "null", ["[2,4]"])
}

test "control_sort_total_order_and_grouping" {
  expect("[null, true, false, 0, \"\", [], {}] | sort", "null", ["[null,false,true,0,\"\",[],{}]"])
  expect("[{\"b\":1},{\"a\":2},{\"a\":1,\"b\":0},{\"a\":1}] | sort", "null", ["[{\"a\":1},{\"a\":2},{\"a\":1,\"b\":0},{\"b\":1}]"])
  expect("[{\"a\":2,\"i\":0},{\"a\":1,\"i\":1},{\"a\":2,\"i\":2}] | sort_by(.a) | map(.i)", "null", ["[1,0,2]"])
  expect("[1,2,1,3] | group_by(.) | map(length)", "null", ["[2,1,1]"])
}

test "control_limits_bound_bombs" {
  let lim = jq::JqLimits::new(64, 100000, 1000, 4096)
  match jq::eval_json_with_limits("\"a\" * 100000000", "null", lim) {
    Err(jq::JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "string repetition bomb must hit LimitExceeded")
  }
  match jq::eval_json_with_limits("null | setpath([100000000]; 1)", "null", lim) {
    Err(jq::JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "sparse setpath bomb must hit LimitExceeded")
  }
  match jq::eval_json_with_limits("def f: f; f", "null", lim) {
    Err(jq::JqError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "infinite recursion must hit LimitExceeded")
  }
}

test "control_strings_and_formats" {
  expect("\"\\u00e9\\ud83d\\ude00\" | [length, utf8bytelength]", "null", ["[2,6]"])
  expect("\"<&>'\\\"\" | @html", "null", ["\"&lt;&amp;&gt;&apos;&quot;\""])
  expect("[1, \"a,b\", null] | @csv", "null", ["\"1,\\\"a,b\\\",\""])
  expect("\"it's\" | @sh", "null", ["\"'it'\\\\''s'\""])
  expect("\"a b/c\" | @uri", "null", ["\"a%20b%2Fc\""])
  expect("[splits(\", *\")]", "\"a, b,c\"", ["[\"a\",\"b\",\"c\"]"])
  expect("capture(\"(?<y>\\\\d{4})-(?<m>\\\\d{2})\")", "\"2026-11\"", ["{\"m\":\"11\",\"y\":\"2026\"}"])
}
