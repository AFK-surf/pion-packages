///| Red-team audit probe for `packages/email` (Native + Wasm32, 4 modes).
///|
///| Every check prints exactly one line:
///|   `PASS <id> <sev> <title>`  -- behaviour matches RFC / reference expectation
///|   `FAIL <id> <sev> <title> :: <observed>`  -- reproducible defect
///|   `INFO <id> <title> :: <observed>`  -- informational, never affects the verdict
///| Differential observations are printed as `OUT <set>\t<id>\t<normalized>` for the oracle table.
///| Output is byte-for-byte deterministic so the 4 build modes can be compared by SHA-256.

import "email"
import "crypto"
import "base64"

///| Print with invalid UTF-8 bytes rendered as `\xHH`: the wasm32 runtime decodes stdout as
///| UTF-8 (lossy), native writes raw bytes, so raw invalid bytes would make the 4 modes differ.
fn out(world : World, s : String) -> Unit {
  let b = s.to_bytes()
  let n = b.length()
  let sb = StringBuilder::new()
  let digits = "0123456789abcdef"
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    let need = if c < 0x80 {
      0
    } else if c >= 0xC2 && c <= 0xDF {
      1
    } else if c >= 0xE0 && c <= 0xEF {
      2
    } else if c >= 0xF0 && c <= 0xF4 {
      3
    } else {
      -1
    }
    let mut ok = need >= 0 && i + need < n
    let mut k = 1
    while ok && k <= need {
      if (b[i + k].to_int() & 0xC0) != 0x80 {
        ok = false
      }
      k = k + 1
    }
    if ok {
      let mut j = 0
      while j <= need {
        sb.write_byte(b[i + j])
        j = j + 1
      }
      i = i + need + 1
    } else {
      sb.write_string("\\x")
      sb.write_byte(digits.code_unit_at((c >> 4) & 15).to_byte())
      sb.write_byte(digits.code_unit_at(c & 15).to_byte())
      i = i + 1
    }
  }
  io_println(world, sb.to_string())
}

///|
fn ck(world : World, id : String, sev : String, title : String, ok : Bool, observed : String) -> Unit {
  if ok {
    out(world, "PASS " + id + " " + sev + " " + title)
  } else {
    out(world, "FAIL " + id + " " + sev + " " + title + " :: " + esc(observed))
  }
}

///|
fn info(world : World, id : String, title : String, observed : String) -> Unit {
  out(world, "INFO " + id + " " + title + " :: " + esc(observed))
}

///|
fn esc(s : String) -> String {
  let b = s.to_bytes()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int()
    if c == 13 {
      sb.write_string("\\r")
    } else if c == 10 {
      sb.write_string("\\n")
    } else if c == 9 {
      sb.write_string("\\t")
    } else if c == 92 {
      sb.write_string("\\\\")
    } else {
      sb.write_byte(b[i])
    }
    i = i + 1
  }
  sb.to_string()
}

///| FNV-1a 64-bit (identical to the Rust oracle), as 16 lowercase hex digits.
fn fnv(b : Bytes) -> String {
  let mut h = -3750763034362895579L
  let mut i = 0
  while i < b.length() {
    h = h ^ b[i].to_int().to_int64()
    h = h * 1099511628211L
    i = i + 1
  }
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut k = 0
  while k < 16 {
    let nib = ((h >> (60 - 4 * k)) & 15L).to_int()
    sb.write_byte(digits.code_unit_at(nib).to_byte())
    k = k + 1
  }
  sb.to_string()
}

///|
fn err_str(e : email::EmailError) -> String {
  e.to_string()
}

///|
fn is_limit(e : email::EmailError) -> Bool {
  match e {
    email::EmailError::LimitExceeded(_) => true
    _ => false
  }
}

///|
fn split_char(s : String, ch : Int) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == ch {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(start, s.length()))
  out
}

///| Read `id<TAB>input<TAB>expected` rows, skipping blank and `#` lines.
fn read_cases(world : World, path : String) -> Array[Array[String]] {
  let out : Array[Array[String]] = []
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b.to_string()
    Err(_) => {
      out(world, "HARNESS cannot read " + path)
      return out
    }
  }
  let lines = split_char(data, 10)
  let mut i = 0
  while i < lines.length() {
    let l = lines[i]
    if l.length() > 0 && l.code_unit_at(0) != 35 {
      let cols = split_char(l, 9)
      if cols.length() >= 3 {
        out.push(cols)
      }
    }
    i = i + 1
  }
  out
}

///|
fn verdict_line(world : World, set : String, sev : String, id : String, input : String, expected : String, got : String) -> Unit {
  out(world, "OUT " + set + "\t" + id + "\t" + got)
  if expected == "*" {
    info(world, set + "_" + id, "[" + input + "]", got)
  } else {
    ck(world, set + "_" + id, sev, "[" + input + "] expect " + expected, got == expected, got)
  }
}

///|
fn fmt_mailboxes(mbs : Array[email::Mailbox]) -> String {
  if mbs.length() == 0 {
    return "OK"
  }
  let sb = StringBuilder::new()
  sb.write_string("OK ")
  let mut i = 0
  while i < mbs.length() {
    if i > 0 {
      sb.write_string(" | ")
    }
    sb.write_string(mbs[i].name)
    sb.write_string(" <")
    sb.write_string(mbs[i].address)
    sb.write_string(">")
    i = i + 1
  }
  sb.to_string()
}

// ---------------------------------------------------------------------------
// 1. RFC 5322 / 6532 address, date and RFC 2047 differential (expected column)
// ---------------------------------------------------------------------------

///|
fn sec_addr(world : World, dir : String) -> Unit {
  let cs = read_cases(world, dir + "/addr.tsv")
  let mut i = 0
  while i < cs.length() {
    let got = match email::parse_address_list(cs[i][1]) {
      Ok(a) => fmt_mailboxes(email::flatten_addresses(a))
      Err(_) => "ERR"
    }
    verdict_line(world, "addr", "P2", cs[i][0], cs[i][1], cs[i][2], got)
    i = i + 1
  }
}

///|
fn sec_date(world : World, dir : String) -> Unit {
  let cs = read_cases(world, dir + "/date.tsv")
  let mut i = 0
  while i < cs.length() {
    let got = match email::parse_date(cs[i][1]) {
      Ok(d) => "OK " + d.timestamp.to_string() + " " + d.offset_seconds.to_string()
      Err(_) => "ERR"
    }
    verdict_line(world, "date", "P2", cs[i][0], cs[i][1], cs[i][2], got)
    i = i + 1
  }
}

///|
fn sec_rfc2047(world : World, dir : String) -> Unit {
  let cs = read_cases(world, dir + "/rfc2047.tsv")
  let mut i = 0
  while i < cs.length() {
    let raw = "Subject: " + cs[i][1] + "\r\n\r\n"
    let got = match email::parse_message(raw.to_bytes()) {
      Ok(m) =>
      match m.subject() {
        Some(s) => "OK " + esc(s)
        None => "ERR"
      }
      Err(_) => "ERR"
    }
    verdict_line(world, "rfc2047", "P2", cs[i][0], cs[i][1], cs[i][2], got)
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// 2. MIME tree differential (cases/mime/*.eml vs cases/mime_expected.tsv)
// ---------------------------------------------------------------------------

///|
fn mime_summary(raw : Bytes) -> String {
  match email::parse_message(raw) {
    Err(e) => "ERR " + err_str(e)
    Ok(m) => {
      let subj = match m.subject() {
        Some(s) => esc(s)
        None => "-"
      }
      let text = match m.text_body() {
        Some(s) => esc(s)
        None => "-"
      }
      let html = match m.html_body() {
        Some(s) => esc(s)
        None => "-"
      }
      let atts = m.attachments()
      let sb = StringBuilder::new()
      let mut i = 0
      while i < atts.length() {
        if i > 0 {
          sb.write_string(",")
        }
        sb.write_string(esc(atts[i].filename))
        sb.write_string(":")
        sb.write_string(fnv(atts[i].body))
        i = i + 1
      }
      "subj=" + subj + " text=" + text + " html=" + html + " atts=" + atts.length().to_string() + "[" + sb.to_string() + "]"
    }
  }
}

///|
fn sec_mime(world : World, dir : String) -> Unit {
  let cs = read_cases(world, dir + "/mime_expected.tsv")
  let mut i = 0
  while i < cs.length() {
    let id = cs[i][0]
    let got = match fs_read_bytes(world, dir + "/mime/" + id + ".eml") {
      Ok(b) => mime_summary(b)
      Err(_) => "HARNESS missing eml"
    }
    let sev = if cs[i].length() >= 4 { cs[i][3] } else { "P2" }
    verdict_line(world, "mime", sev, id, cs[i][1], cs[i][2], got)
    i = i + 1
  }
  // Content-ID lookup with / without angle brackets and surrounding whitespace
  match fs_read_bytes(world, dir + "/mime/m16_related_cid.eml") {
    Ok(b) =>
    match email::parse_message(b) {
      Ok(m) => {
        let a = match m.part_by_cid("<img2@x>") {
          Some(p) => p.body.to_string()
          None => "<none>"
        }
        let c = match m.part_by_cid("img1@x") {
          Some(p) => p.body.to_string()
          None => "<none>"
        }
        ck(world, "mime_cid_lookup", "P1", "part_by_cid matches <id> and bare id", a == "PNG2" && c == "PNG1" && m.inline_parts().length() == 2, a + "|" + c + "|inline=" + m.inline_parts().length().to_string())
      }
      Err(e) => ck(world, "mime_cid_lookup", "P1", "part_by_cid matches <id> and bare id", false, err_str(e))
    }
    Err(_) => ()
  }
  // QP soft line break with bare LF (=\n) and CRLF (=\r\n)
  match email::parse_message("Content-Transfer-Encoding: quoted-printable\n\nab=\ncd=\r\nef\n".to_bytes()) {
    Ok(m) => {
      let t = match m.text_body() {
        Some(x) => x
        None => ""
      }
      ck(world, "mime_qp_bare_lf_softbreak", "P2", "QP soft breaks =LF and =CRLF removed", t == "abcdef\n", t)
    }
    Err(e) => ck(world, "mime_qp_bare_lf_softbreak", "P2", "QP soft breaks removed", false, err_str(e))
  }
  // safe_filename hardening on the traversal sample (Pion-only API)
  match fs_read_bytes(world, dir + "/mime/m14_path_traversal.eml") {
    Ok(b) =>
    match email::parse_message(b) {
      Ok(m) => {
        let atts = m.attachments()
        let sb = StringBuilder::new()
        let mut ok = atts.length() == 4
        let mut k = 0
        while k < atts.length() {
          let s = match atts[k].safe_filename {
            Some(v) => v
            None => "<none>"
          }
          sb.write_string(s + ";")
          if s.length() > 0 && s != "<none>" {
            let sbb = s.to_bytes()
            let mut j = 0
            while j < sbb.length() {
              let c = sbb[j].to_int()
              if c == 47 || c == 92 || c < 32 {
                ok = false
              }
              if c == 0xE2 && j + 2 < sbb.length() && sbb[j + 1].to_int() == 0x80 && sbb[j + 2].to_int() == 0xAE {
                ok = false
              }
              j = j + 1
            }
            if s.length() >= 2 && s.slice(0, 2) == ".." {
              ok = false
            }
          }
          k = k + 1
        }
        let expect = "passwd;boot.ini;<none>;invexe.pdf;"
        ck(world, "mime_safe_filename", "P1", "safe_filename strips ../ \\ CON RLO", ok && sb.to_string() == expect, sb.to_string())
      }
      Err(e) => ck(world, "mime_safe_filename", "P1", "safe_filename strips ../ \\ CON RLO", false, err_str(e))
    }
    Err(_) => ()
  }
}

// ---------------------------------------------------------------------------
// 3. DKIM (RFC 6376 / RFC 8463 / RFC 8301)
// ---------------------------------------------------------------------------

///|
fn rsa_pem() -> String {
  let lines = [
    "-----BEGIN PRIVATE KEY-----",
    "MIIEvAIBADANBgkqhkiG9w0BAQEFAASCBKYwggSiAgEAAoIBAQCSqE101cM7VawG",
    "TDNdrM9IsPO+1Xeb4fNezAheyDsf68JXseejLoQTA6l+I5/NRegr7/45NXcK1I5C",
    "d2sj1itXQ6aUMBVLwxR233skZXENF7M4L73NBz3WMccPMU8KnH5NeaC4v08Onziz",
    "xU2N76cjFxdRrCCT72shI8lF0Cr9RgMOcYLxBpAXaUkZBrWqSom0Ny6wXEwQ1umO",
    "AdPxrG3Jtj0Ut2E0oE9/EYqXcl2EK15F7YL16RiwOQFs1mj5tQ8o/xiPa3Nq91Gv",
    "xAiMWiTzNI0RFCaz/LIAjw+hXcGz/kIX6o0VTuFQMAPyEiPH1ZuCU0k42uSlvF8r",
    "RFfePsg5AgMBAAECggEABCqv+K/SGi928b7cfr7YLNKKOlPKUC19QqY9XqQFugRy",
    "wxcU47gAnKGwARt2ANkJnaX17R4twasEV7MY4i3FkXcklnU/RaXHQRFcaE5RhfO0",
    "bdY9aEPaZ+mGJFJcUorbs8vO2zDkSCAR9lmWuH+kmgSf7vwa+NkGjCx+HXOqpQN7",
    "MyHsrbahS4gWDnztFfB4DRwyTVpXE4UjODMHo4YgNnCF354U9kyC72/NHRAHnpl6",
    "aUipYRP5yhmLvXPxl8/y2KITvOd2f6Vl7u7OS0FubE6OZrnkYf+U6smr1SA/QjQ7",
    "R9zo+FB0rYDlKDIzOOslpbcoVfdDjCVozprNI4GgWQKBgQDG5UciWNUN/hCH7mcR",
    "8DBi2bm8/2RIZpUY5L2KdUkU7KlTVi6GRjbtOL2OFX4hwA/zu4QCwlhcdOw94wD4",
    "YLJXr6R0H4liZMXuQr2YV291NcFdKJP+XhFLhgt69Wl+xAt+Bzc+LvJ08p7KHcGo",
    "xkvfUgC38Eh+74xvonwvDgBNuwKBgQC8w4u+aP45e99F5kuOb17ld72X+XkxVG+i",
    "SCq8n53z3t/GQODEVMYntmp1YIZs5lPr8sEgRYb98Jk6dudxuyuY3z3+fkqjbrJo",
    "mtgS+3wxA273FmF7quQgCN6C9rxjmNoW0bSRjMx52EOXuFsCafofD310zonwp3ts",
    "GF8nq9eomwKBgAK/Hclaoq6LyJyn7SJxR6nFyevTNwZM7FgoqHll/zlbv0bYVNIj",
    "3BRQiUWSBGjg5xd9imgjWOcF8lE0dkn3w960HThBSzthmt4ca9PTuUVMFbx8l/aW",
    "Q/TgB/6NrwRCHsqBvQCN02lMBGdUG92Bx4Bw+HORzN573luYSdC4h8aLAoGAOprP",
    "eRdpznkJ8c61KIylPsL1Rwi6OrmHSy/yrMs1o/BPM2MTJYFYYB3/YV/NfGPqLDgb",
    "A6Tya0bWm9Msuh+tQnIU8j1NeP42P8nLSeFwRltViTsWmumMl/GI+8oU5SsgkrMa",
    "x5GaLj4ZhjJDdzVl5VzOy4QQSXoGFKJgcJWmh/8CgYBGdd58kIX0mURXabzBd+5C",
    "xLZ9QnCDFqmUF67C2MCuK/H2bjVrY81T4+0YIA01sGAHSTkniUJl4lot4Klm7HJg",
    "C9flzEgdpcO1z/n3ZajWyyVGYtRyD22HoiuGsJBMG7osJuMEjYjg1VqPU/jTm242",
    "7qqNDJl4TejNYRC4bGj/YQ==",
    "-----END PRIVATE KEY-----",
  ]
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    sb.write_string(lines[i])
    sb.write_string("\n")
    i = i + 1
  }
  sb.to_string()
}

///| RFC 8032 §7.1 TEST 1 seed (also RFC 8463 Appendix A Ed25519 key).
fn ed_seed() -> Bytes {
  match base64::decode("nWGxne/9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A=") {
    Ok(b) => b
    Err(_) => Bytes::new(32)
  }
}

///|
fn vres(r : Result[email::DkimSignature, email::EmailError]) -> String {
  match r {
    Ok(_) => "VERIFY_OK"
    Err(e) => err_str(e)
  }
}

///|
fn is_ok(r : Result[email::DkimSignature, email::EmailError]) -> Bool {
  match r {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn canon_name(c : email::DkimCanon) -> String {
  match c {
    email::DkimCanon::Simple => "simple"
    email::DkimCanon::Relaxed => "relaxed"
  }
}

///|
fn base_msg() -> String {
  "From: Alice <alice@good.example>\r\nTo: bob@x.example\r\nSubject: quarterly numbers\r\nDate: Mon, 23 Nov 2026 12:00:00 +0000\r\n\r\nPay invoice 1234 to account A.\r\n"
}

///|
fn cfg(hc : email::DkimCanon, bc : email::DkimCanon, sel : String, hs : Array[String]) -> email::DkimSignConfig {
  email::DkimSignConfig::{
    domain: "audit.example",
    selector: sel,
    header_canon: hc,
    body_canon: bc,
    signed_headers: hs,
    timestamp: Some(1795435200L),
  }
}

///| Insert `extra` right after the first header line (i.e. below the DKIM-Signature).
fn insert_after_first_line(s : String, extra : String) -> String {
  let mut i = 0
  while i + 1 < s.length() {
    if s.code_unit_at(i) == 13 && s.code_unit_at(i + 1) == 10 {
      return s.slice(0, i + 2) + extra + s.slice(i + 2, s.length())
    }
    i = i + 1
  }
  s
}

///|
fn replace_first(s : String, from : String, to : String) -> String {
  let n = from.length()
  let mut i = 0
  while i + n <= s.length() {
    if s.slice(i, i + n) == from {
      return s.slice(0, i) + to + s.slice(i + n, s.length())
    }
    i = i + 1
  }
  s
}

///|
fn sec_dkim(world : World, fx : String, out_dir : String) -> Unit {
  let seed = ed_seed()
  let ed_pub = match crypto::ed25519_public_key(seed) {
    Ok(k) => k
    Err(_) => Bytes::new(32)
  }
  let rsa_key = match crypto::RsaPrivateKey::from_pkcs8_pem(rsa_pem()) {
    Ok(k) => Some(k)
    Err(_) => None
  }
  let rsa_pub = match rsa_key {
    Some(k) => Some(k.public_key())
    None => None
  }
  ck(world, "dkim_rsa2048_key_load", "P2", "RSA-2048 PKCS#8 key loads", rsa_key is Some(_), "from_pkcs8_pem failed")

  // --- 3.1 canonicalization unit vectors (RFC 6376 §3.4.2-§3.4.5, errata 1384) ---
  let cbs = email::canonicalize_body("".to_bytes(), email::DkimCanon::Simple).to_string()
  ck(world, "dkim_canon_empty_simple", "P1", "simple(empty body) == CRLF", cbs == "\r\n", cbs)
  let cbr = email::canonicalize_body("".to_bytes(), email::DkimCanon::Relaxed).to_string()
  ck(world, "dkim_canon_empty_relaxed", "P1", "relaxed(empty body) == empty", cbr == "", cbr)
  let t1 = email::canonicalize_body("a \t b\t \r\n\r\n\r\n".to_bytes(), email::DkimCanon::Relaxed).to_string()
  ck(world, "dkim_canon_relaxed_wsp_tail", "P1", "relaxed collapses WSP and trailing empty lines", t1 == "a b\r\n", t1)
  let t2 = email::canonicalize_body("a \t\r\n\r\n\r\n".to_bytes(), email::DkimCanon::Simple).to_string()
  ck(world, "dkim_canon_simple_tail", "P1", "simple keeps WSP, drops trailing empty lines", t2 == "a \t\r\n", t2)
  let t3 = email::canonicalize_body("x\r\ny".to_bytes(), email::DkimCanon::Simple).to_string()
  ck(world, "dkim_canon_simple_nocrlf", "P1", "simple appends CRLF to unterminated body", t3 == "x\r\ny\r\n", t3)
  let t4 = email::canonicalize_body("\r\n\r\n".to_bytes(), email::DkimCanon::Relaxed).to_string()
  ck(world, "dkim_canon_relaxed_only_crlf", "P1", "relaxed(CRLFCRLF) == empty", t4 == "", t4)
  let h1 = email::canonicalize_header("SuBJect", " \t a  \r\n\t b \t", email::DkimCanon::Relaxed)
  ck(world, "dkim_canon_hdr_relaxed", "P1", "relaxed header unfold/collapse/trim", h1 == "subject:a b", h1)
  let h2 = email::canonicalize_header("SuBJect", " \t a  \r\n\t b \t", email::DkimCanon::Simple)
  ck(world, "dkim_canon_hdr_simple", "P1", "simple header verbatim", h2 == "SuBJect: \t a  \r\n\t b \t", h2)

  // --- 3.2 RFC 8463 Appendix A interoperability vectors ---
  match fs_read_bytes(world, fx + "/rfc8463.eml") {
    Ok(v) => {
      let r = email::dkim_verify_ed25519(v, ed_pub)
      ck(world, "dkim_rfc8463_ed25519", "P0", "RFC 8463 A.3 ed25519-sha256 vector verifies", is_ok(r), vres(r))
    }
    Err(_) => ck(world, "dkim_rfc8463_ed25519", "P0", "RFC 8463 vector present", false, "missing fixture")
  }
  match fs_read_bytes(world, fx + "/rfc8463_rsa1024.spki.der") {
    Ok(der) =>
    match crypto::RsaPublicKey::from_spki_der(der) {
      Ok(k) =>
      match fs_read_bytes(world, fx + "/rfc8463.eml") {
        Ok(v) => {
          let r = email::dkim_verify_rsa(v, k)
          ck(world, "dkim_rfc8463_rsa1024", "P1", "RFC 8463 A.3 rsa-sha256 (1024-bit, RFC 8301 MUST verify) vector verifies", is_ok(r), vres(r))
        }
        Err(_) => ()
      }
      Err(_) =>
      ck(world, "dkim_rfc8463_rsa1024", "P1", "RFC 8463 A.3 rsa-sha256 (1024-bit, RFC 8301 MUST verify) vector verifies", false, "RsaPublicKey::from_spki_der rejects RFC 8463 1024-bit key (verifier floor is 2048)")
    }
    Err(_) => ()
  }

  // --- 3.3 go-msgauth signed fixtures: 2 algs x 4 canon x 8 bodies ---
  let cn = ["simple", "relaxed"]
  let mut alg_i = 0
  while alg_i < 2 {
    let mut fails = 0
    let mut total = 0
    let mut first_fail = ""
    let mut hi = 0
    while hi < 2 {
      let mut bi = 0
      while bi < 2 {
        let mut b = 0
        while b < 8 {
          let tag = cn[hi] + "_" + cn[bi] + "_b0" + b.to_string()
          let name = if alg_i == 0 { "go_ed_" + tag } else { "go_rsa_" + tag }
          match fs_read_bytes(world, fx + "/" + name + ".eml") {
            Ok(m) => {
              total = total + 1
              let r = if alg_i == 0 {
                email::dkim_verify_ed25519(m, ed_pub)
              } else {
                match rsa_pub {
                  Some(k) => email::dkim_verify_rsa(m, k)
                  None => Err(email::EmailError::InvalidDkim("no key"))
                }
              }
              if !is_ok(r) {
                fails = fails + 1
                if first_fail == "" {
                  first_fail = name + ": " + vres(r)
                }
              }
            }
            Err(_) => {
              fails = fails + 1
              first_fail = "missing " + name
            }
          }
          b = b + 1
        }
        bi = bi + 1
      }
      hi = hi + 1
    }
    let id = if alg_i == 0 { "dkim_interop_go_ed25519" } else { "dkim_interop_go_rsa2048" }
    ck(world, id, "P0", "go-msgauth signed fixtures verify in Pion (4 canon x 8 bodies)", fails == 0 && total == 32, fails.to_string() + "/" + total.to_string() + " failed; first: " + first_fail)
    alg_i = alg_i + 1
  }

  // --- 3.4 Pion-signed messages for go-msgauth verification (files written to out_dir) ---
  let cans = [email::DkimCanon::Simple, email::DkimCanon::Relaxed]
  let bodies = ["", "\r\n", "Hello.\r\n", "a  \t b \t\r\n\r\n\r\n", "no final crlf  \t", " lead\r\n\r\nmid\r\n\r\n"]
  let mut written = 0
  let mut hci = 0
  while hci < 2 {
    let mut bci = 0
    while bci < 2 {
      let mut b = 0
      while b < bodies.length() {
        let raw = ("From: Audit Sender <sender@audit.example>\r\nTo:   Recipient\r\n\t<rcpt@audit.example>  \r\nSUBJECT:  Canon   case \t\r\nX-Folded: a\r\n   b\r\n\tc\r\n\r\n" + bodies[b]).to_bytes()
        let tag = canon_name(cans[hci]) + "_" + canon_name(cans[bci]) + "_b" + b.to_string()
        let hs = ["From", "To", "Subject", "X-Folded"]
        match email::dkim_sign_ed25519(raw, cfg(cans[hci], cans[bci], "ed", hs), seed) {
          Ok(s) => {
            let _ = fs_write_bytes(world, out_dir + "/pion_ed_" + tag + ".eml", s)
            written = written + 1
          }
          Err(e) => info(world, "dkim_pion_sign_ed_" + tag, "sign failed", err_str(e))
        }
        match rsa_key {
          Some(k) =>
          match email::dkim_sign_rsa(raw, cfg(cans[hci], cans[bci], "rsa", hs), k) {
            Ok(s) => {
              let _ = fs_write_bytes(world, out_dir + "/pion_rsa_" + tag + ".eml", s)
              written = written + 1
            }
            Err(e) => info(world, "dkim_pion_sign_rsa_" + tag, "sign failed", err_str(e))
          }
          None => ()
        }
        b = b + 1
      }
      bci = bci + 1
    }
    hci = hci + 1
  }
  out(world, "OUT dkim\tpion_signed_written\t" + written.to_string())

  // --- 3.5 multi-signature messages (ESPs routinely add 2+ DKIM-Signature fields) ---
  match (fs_read_bytes(world, fx + "/multi_ed_top.eml"), rsa_pub) {
    (Ok(m), Some(k)) => {
      let r = email::dkim_verify_rsa(m, k)
      ck(world, "dkim_multisig_rsa_below_ed", "P1", "rsa signature verifies when an ed25519 DKIM-Signature is above it", is_ok(r), vres(r))
    }
    _ => ()
  }
  match fs_read_bytes(world, fx + "/multi_rsa_top.eml") {
    Ok(m) => {
      let r = email::dkim_verify_ed25519(m, ed_pub)
      ck(world, "dkim_multisig_ed_below_rsa", "P1", "ed25519 signature verifies when an rsa DKIM-Signature is above it", is_ok(r), vres(r))
    }
    _ => ()
  }

  // --- 3.6 attacks against Pion's own signatures (ed25519, relaxed/relaxed) ---
  let full = ["From", "To", "Subject", "Date"]
  let rel = email::DkimCanon::Relaxed
  let signed = match email::dkim_sign_ed25519(base_msg().to_bytes(), cfg(rel, rel, "ed", full), seed) {
    Ok(s) => s.to_string()
    Err(e) => {
      ck(world, "dkim_sign_basic", "P0", "ed25519 relaxed/relaxed signing works", false, err_str(e))
      return
    }
  }
  let base_r = email::dkim_verify_ed25519(signed.to_bytes(), ed_pub)
  ck(world, "dkim_roundtrip", "P0", "Pion sign -> Pion verify", is_ok(base_r), vres(base_r))
  let tb = replace_first(signed, "account A.", "account B.")
  ck(world, "dkim_tamper_body_byte", "P0", "1-byte body tamper rejected", !is_ok(email::dkim_verify_ed25519(tb.to_bytes(), ed_pub)), "VERIFY_OK")
  let th = replace_first(signed, "quarterly numbers", "quarterly numbcrs")
  ck(world, "dkim_tamper_header_byte", "P0", "1-byte signed-header tamper rejected", !is_ok(email::dkim_verify_ed25519(th.to_bytes(), ed_pub)), "VERIFY_OK")
  let ta = replace_first(signed, "a=ed25519-sha256", "a=rsa-sha256")
  let tar = match rsa_pub {
    Some(k) => email::dkim_verify_rsa(ta.to_bytes(), k)
    None => Err(email::EmailError::InvalidDkim("no key"))
  }
  ck(world, "dkim_alg_confusion", "P0", "a= swapped ed25519->rsa rejected", !is_ok(tar) && !is_ok(email::dkim_verify_ed25519(ta.to_bytes(), ed_pub)), "VERIFY_OK")
  let tr = replace_first(signed, "; b=", "; b=AAAA")
  ck(world, "dkim_corrupt_sig", "P0", "corrupted/extended b= rejected", !is_ok(email::dkim_verify_ed25519(tr.to_bytes(), ed_pub)), "VERIFY_OK")
  let tbad = replace_first(signed, "; b=", "; b=!!")
  ck(world, "dkim_bad_base64_b", "P1", "non-base64 b= rejected", !is_ok(email::dkim_verify_ed25519(tbad.to_bytes(), ed_pub)), "VERIFY_OK")
  let wrong_pub = match crypto::ed25519_public_key(Bytes::new(32)) {
    Ok(k) => k
    Err(_) => Bytes::new(32)
  }
  ck(world, "dkim_wrong_key", "P0", "verification with a different key rejected", !is_ok(email::dkim_verify_ed25519(signed.to_bytes(), wrong_pub)), "VERIFY_OK")
  let tl = replace_first(signed, "Pay invoice", "Pay   invoice")
  ck(world, "dkim_relaxed_wsp_tolerated", "P1", "relaxed body tolerates WSP-run change", is_ok(email::dkim_verify_ed25519(tl.to_bytes(), ed_pub)), vres(email::dkim_verify_ed25519(tl.to_bytes(), ed_pub)))

  // Truncated b= (last 4 base64 chars dropped)
  let mut eol = 0
  while eol + 1 < signed.length() && !(signed.code_unit_at(eol) == 13 && signed.code_unit_at(eol + 1) == 10) {
    eol = eol + 1
  }
  let trunc = signed.slice(0, eol - 4) + signed.slice(eol, signed.length())
  ck(world, "dkim_truncated_sig", "P0", "truncated b= rejected", !is_ok(email::dkim_verify_ed25519(trunc.to_bytes(), ed_pub)), "VERIFY_OK")
  // Weak RSA keys (< 1024 bits) must never be usable for verification
  let weak_n = Bytes::new(64)
  let mut wi = 0
  while wi < 64 {
    weak_n[wi] = (0xFF).to_byte()
    wi = wi + 1
  }
  let weak_e = Bytes::new(3)
  weak_e[0] = (1).to_byte()
  weak_e[2] = (1).to_byte()
  let weak_ok = match crypto::RsaPublicKey::from_components(weak_n, weak_e) {
    Ok(_) => true
    Err(_) => false
  }
  ck(world, "dkim_weak_rsa_512", "P0", "512-bit RSA public key refused", !weak_ok, "accepted 512-bit modulus")
  // Oversigning: h=from:from consumes bottom-up; an added From must then break the signature
  match email::dkim_sign_ed25519(base_msg().to_bytes(), cfg(rel, rel, "ed", ["From", "From", "To", "Subject"]), seed) {
    Ok(s) => {
      let ok1 = is_ok(email::dkim_verify_ed25519(s, ed_pub))
      let s2 = insert_after_first_line(s.to_string(), "From: CEO <ceo@good.example>\r\n")
      let ok2 = is_ok(email::dkim_verify_ed25519(s2.to_bytes(), ed_pub))
      ck(world, "dkim_oversign_from", "P0", "oversigned From (h=from:from) verifies and blocks an injected From", ok1 && !ok2, "verify(original)=" + ok1.to_string() + " verify(injected)=" + ok2.to_string())
    }
    Err(e) => ck(world, "dkim_oversign_from", "P0", "oversigned From signs", false, err_str(e))
  }
  // l= body length: content appended after the signed prefix (RFC 6376 §8.2)
  let lbody = "Pay invoice 1234 to account A.\r\n"
  let lmsg_hdr = "From: Alice <alice@good.example>\r\nTo: bob@x.example\r\nSubject: quarterly numbers\r\n"
  let cbody = email::canonicalize_body(lbody.to_bytes(), rel)
  let bh = base64::encode(crypto::sha256(cbody))
  let dval = " v=1; a=ed25519-sha256; c=relaxed/relaxed; d=audit.example; s=ed; l=" + cbody.length().to_string() + "; h=from:to:subject; bh=" + bh + "; b="
  let sin = email::canonicalize_header("From", " Alice <alice@good.example>", rel) + "\r\n" + email::canonicalize_header("To", " bob@x.example", rel) + "\r\n" + email::canonicalize_header("Subject", " quarterly numbers", rel) + "\r\n" + email::canonicalize_header("DKIM-Signature", dval, rel)
  match crypto::ed25519_sign(seed, crypto::sha256(sin.to_bytes())) {
    Ok(sig) => {
      let lsigned = "DKIM-Signature:" + dval + base64::encode(sig) + "\r\n" + lmsg_hdr + "\r\n" + lbody
      let base_ok = is_ok(email::dkim_verify_ed25519(lsigned.to_bytes(), ed_pub))
      let appended = lsigned + "\r\nUPDATE: pay account EVIL instead.\r\n"
      let ar = email::dkim_verify_ed25519(appended.to_bytes(), ed_pub)
      let reported = match ar {
        Ok(d) =>
        match d.body_length {
          Some(l) => "Ok(body_length=" + l.to_string() + ")"
          None => "Ok(body_length=None)"
        }
        Err(e) => err_str(e)
      }
      ck(world, "dkim_l_tag_control", "P1", "hand-built l= signature verifies (oracle-free construction)", base_ok, "verify failed")
      info(world, "dkim_l_tag_append", "content appended after l= prefix", reported + " -- caller must compare body_length with the body size")
    }
    Err(_) => ()
  }

  // Duplicate From smuggling (RFC 5322 §3.6: exactly one From; RFC 6376 §8.15)
  let smuggled = insert_after_first_line(signed, "From: CEO <ceo@good.example>\r\n")
  let _ = fs_write_bytes(world, out_dir + "/pion_atk_dup_from.eml", smuggled.to_bytes())
  let sr = email::dkim_verify_ed25519(smuggled.to_bytes(), ed_pub)
  let shown = match email::parse_message(smuggled.to_bytes()) {
    Ok(m) =>
    match m.from() {
      Ok(f) => if f.length() > 0 { f[0].address } else { "" }
      Err(_) => ""
    }
    Err(_) => ""
  }
  ck(world, "dkim_dup_from_smuggling", "P0", "extra unsigned From: above the signed one must not yield a passing signature", !is_ok(sr), vres(sr) + "; EmailMessage::from()[0] = " + shown)

  // h= that does not cover From (RFC 6376 §5.4 / §6.1.1: verifiers MUST ignore such signatures)
  match email::dkim_sign_ed25519(base_msg().to_bytes(), cfg(rel, rel, "ed", ["Subject"]), seed) {
    Ok(s) => {
      ck(world, "dkim_sign_requires_from", "P2", "signer refuses h= without From", false, "dkim_sign_ed25519 accepted signed_headers=[Subject]")
      let spoof = replace_first(s.to_string(), "From: Alice <alice@good.example>", "From: Mallory <ceo@good.example>")
      let _ = fs_write_bytes(world, out_dir + "/pion_atk_h_without_from.eml", spoof.to_bytes())
      let r = email::dkim_verify_ed25519(spoof.to_bytes(), ed_pub)
      ck(world, "dkim_h_without_from", "P0", "signature whose h= omits From is not accepted (From freely replaceable)", !is_ok(r), vres(r))
    }
    Err(_) => {
      ck(world, "dkim_sign_requires_from", "P2", "signer refuses h= without From", true, "")
      ck(world, "dkim_h_without_from", "P0", "signature whose h= omits From is not accepted (From freely replaceable)", true, "")
    }
  }

  // Tag-list syntax (RFC 6376 §3.2: duplicate tag => entire tag-list invalid; §6.1.1 required tags)
  let base_tags = "v=1; a=ed25519-sha256; d=audit.example; s=ed; h=from; bh=AAAA; b=AAAA"
  let dup_cases = [
    ("dup_h", "v=1; a=ed25519-sha256; d=audit.example; s=ed; h=from; h=subject; bh=AAAA; b=AAAA"),
    ("dup_d", "v=1; a=ed25519-sha256; d=audit.example; d=evil.example; s=ed; h=from; bh=AAAA; b=AAAA"),
    ("dup_v", "v=1; v=1; a=ed25519-sha256; d=audit.example; s=ed; h=from; bh=AAAA; b=AAAA"),
  ]
  let mut di = 0
  while di < dup_cases.length() {
    let (nm, tv) = dup_cases[di]
    let accepted = match email::parse_dkim_signature(tv) {
      Ok(_) => true
      Err(_) => false
    }
    ck(world, "dkim_tag_" + nm, "P1", "duplicate tag rejected (RFC 6376 §3.2)", !accepted, "parse_dkim_signature accepted [" + tv + "]")
    di = di + 1
  }
  let miss_cases = [
    ("missing_v", "a=ed25519-sha256; d=audit.example; s=ed; h=from; bh=AAAA; b=AAAA"),
    ("missing_a", "v=1; d=audit.example; s=ed; h=from; bh=AAAA; b=AAAA"),
    ("missing_b", "v=1; a=ed25519-sha256; d=audit.example; s=ed; h=from; bh=AAAA"),
    ("missing_bh", "v=1; a=ed25519-sha256; d=audit.example; s=ed; h=from; b=AAAA"),
    ("missing_d", "v=1; a=ed25519-sha256; s=ed; h=from; bh=AAAA; b=AAAA"),
    ("missing_h", "v=1; a=ed25519-sha256; d=audit.example; s=ed; bh=AAAA; b=AAAA"),
    ("missing_s", "v=1; a=ed25519-sha256; d=audit.example; h=from; bh=AAAA; b=AAAA"),
    ("rsa_sha1", "v=1; a=rsa-sha1; d=audit.example; s=ed; h=from; bh=AAAA; b=AAAA"),
    ("v2", "v=2; a=ed25519-sha256; d=audit.example; s=ed; h=from; bh=AAAA; b=AAAA"),
  ]
  let mut mi = 0
  while mi < miss_cases.length() {
    let (nm, tv) = miss_cases[mi]
    let accepted = match email::parse_dkim_signature(tv) {
      Ok(_) => true
      Err(_) => false
    }
    let sev = if nm == "missing_b" || nm == "missing_bh" { "P2" } else { "P1" }
    ck(world, "dkim_tag_" + nm, sev, "invalid/incomplete tag-list rejected at parse (RFC 6376 §6.1.1 / RFC 8301)", !accepted, "parse_dkim_signature accepted [" + tv + "]")
    mi = mi + 1
  }
  match email::parse_dkim_signature(base_tags) {
    Ok(_) => ck(world, "dkim_tag_control", "P1", "well-formed tag-list accepted", true, "")
    Err(e) => ck(world, "dkim_tag_control", "P1", "well-formed tag-list accepted", false, err_str(e))
  }
  // l= overflow: 2^32 + 5 must not silently become 5
  match email::parse_dkim_signature("v=1; a=ed25519-sha256; d=audit.example; s=ed; h=from; l=4294967301; bh=AAAA; b=AAAA") {
    Ok(s) =>
    match s.body_length {
      Some(l) => ck(world, "dkim_l_overflow", "P2", "l=4294967301 not truncated to 32-bit", l != 5, "body_length=" + l.to_string())
      None => ck(world, "dkim_l_overflow", "P2", "l=4294967301 not truncated to 32-bit", true, "")
    }
    Err(_) => ck(world, "dkim_l_overflow", "P2", "l=4294967301 not truncated to 32-bit", true, "")
  }
  match email::parse_dkim_signature("v=1; a=ed25519-sha256; d=audit.example; s=ed; h=from; t=99999999999999999999999; bh=AAAA; b=AAAA") {
    Ok(s) =>
    match s.timestamp {
      Some(t) => ck(world, "dkim_t_overflow", "P2", "t= with > 64-bit value rejected, not wrapped", false, "timestamp=" + t.to_string())
      None => ck(world, "dkim_t_overflow", "P2", "t= overflow rejected", true, "")
    }
    Err(_) => ck(world, "dkim_t_overflow", "P2", "t= overflow rejected", true, "")
  }
}

// ---------------------------------------------------------------------------
// 4. Builder: injection, boundary collision, folding
// ---------------------------------------------------------------------------

///|
fn build_ok(r : Result[Bytes, email::EmailError]) -> Bool {
  match r {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn max_line_len(s : String) -> Int {
  let mut mx = 0
  let mut cur = 0
  let mut k = 0
  while k < s.length() {
    let c = s.code_unit_at(k)
    if c == 10 {
      if cur > mx {
        mx = cur
      }
      cur = 0
    } else if c != 13 {
      cur = cur + 1
    }
    k = k + 1
  }
  if cur > mx {
    cur
  } else {
    mx
  }
}

///|
fn rep(c : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(c)
    i = i + 1
  }
  sb.to_string()
}

///|
fn sec_builder(world : World) -> Unit {
  let alice = match email::Mailbox::new("Alice", "alice@good.example") {
    Ok(m) => m
    Err(_) => return
  }
  // Injection: CR / LF / NUL / bare CR / bare LF in every user-controlled header input
  let bad = ["x\r\nBcc: v@evil.example", "x\nBcc: v@evil.example", "x\rBcc: v@evil.example", "x\u{0}y"]
  let mut i = 0
  let mut leaks = ""
  while i < bad.length() {
    let v = bad[i]
    if build_ok(email::EmailBuilder::new().from(alice).subject(v).text_body("b").build()) {
      leaks = leaks + "subject#" + i.to_string() + " "
    }
    if build_ok(email::EmailBuilder::new().from(alice).header("X-A", v).text_body("b").build()) {
      leaks = leaks + "header-value#" + i.to_string() + " "
    }
    if build_ok(email::EmailBuilder::new().from(alice).header(v, "x").text_body("b").build()) {
      leaks = leaks + "header-name#" + i.to_string() + " "
    }
    if build_ok(email::EmailBuilder::new().from(alice).message_id(v).text_body("b").build()) {
      leaks = leaks + "message-id#" + i.to_string() + " "
    }
    if build_ok(email::EmailBuilder::new().from(alice).attach(v, "text/plain", "z".to_bytes()).build()) {
      leaks = leaks + "filename#" + i.to_string() + " "
    }
    if build_ok(email::EmailBuilder::new().from(alice).attach("f.txt", v, "z".to_bytes()).build()) {
      leaks = leaks + "content-type#" + i.to_string() + " "
    }
    if build_ok(email::EmailBuilder::new().from(alice).inline_part(v, "i.png", "image/png", "z".to_bytes()).build()) {
      leaks = leaks + "content-id#" + i.to_string() + " "
    }
    match email::Mailbox::new(v, "a@b.example") {
      Ok(_) => leaks = leaks + "mailbox-name#" + i.to_string() + " "
      Err(_) => ()
    }
    match email::Mailbox::new("n", "a" + v + "@b.example") {
      Ok(_) => leaks = leaks + "mailbox-addr#" + i.to_string() + " "
      Err(_) => ()
    }
    i = i + 1
  }
  ck(world, "bld_crlf_nul_injection", "P0", "CR/LF/NUL rejected in every builder header input", leaks == "", leaks)

  // Address smuggling through un-validated addr-spec specials (RFC 5322 §3.4.1)
  let smug = ["abc>,<victim@evil.example", "list:victim@evil.example;", "a@b.example>, <c@d.example"]
  let mut leaked = ""
  let mut si = 0
  while si < smug.length() {
    match email::Mailbox::new("Bob", smug[si]) {
      Ok(mb) =>
      match email::EmailBuilder::new().from(alice).to(mb).text_body("b").build() {
        Ok(raw) =>
        match email::parse_message(raw) {
          Ok(m) => {
            let to_hdr = match m.header("To") {
              Some(t) => t
              None => ""
            }
            leaked = leaked + "[" + smug[si] + " => To: " + to_hdr + "] "
          }
          Err(_) => leaked = leaked + "[" + smug[si] + " => unparseable] "
        }
        Err(_) => ()
      }
      Err(_) => ()
    }
    si = si + 1
  }
  ck(world, "bld_addr_spec_smuggling", "P1", "Mailbox::new rejects RFC 5322 specials (< > , ; :) in addr-spec", leaked == "", leaked)

  // Boundary collision: attacker content embeds the deterministic boundary
  let evil = "x\r\n--pion-email-boundary-mix\r\nContent-Type: application/x-msdownload\r\nContent-Disposition: attachment; filename=\"evil.exe\"\r\n\r\nMZ\r\n--pion-email-boundary-mix--\r\n"
  match email::EmailBuilder::new().from(alice).text_body(evil).html_body(evil).attach("a.bin", "application/octet-stream", evil.to_bytes()).inline_part("c1", "i.png", "image/png", evil.to_bytes()).build() {
    Ok(raw) =>
    match email::parse_message(raw) {
      Ok(m) => {
        let atts = m.attachments()
        let txt = match m.text_body() {
          Some(t) => t
          None => ""
        }
        let ok = atts.length() == 1 && atts[0].filename == "a.bin" && atts[0].body.to_string() == evil && txt == evil && m.inline_parts().length() == 1
        ck(world, "bld_boundary_collision", "P0", "content containing the builder boundary cannot forge parts", ok, "atts=" + atts.length().to_string())
      }
      Err(e) => ck(world, "bld_boundary_collision", "P0", "content containing the builder boundary cannot forge parts", false, err_str(e))
    }
    Err(e) => ck(world, "bld_boundary_collision", "P0", "content containing the builder boundary cannot forge parts", false, err_str(e))
  }

  // Boundary seed validation (RFC 2046 §5.1.1: 1..70 bchars, no trailing space)
  let seeds = [("quote_space", "a\"b c"), ("len100", rep("s", 100)), ("semicolon", "a;b=c")]
  let mut ki = 0
  while ki < seeds.length() {
    let (nm, sd) = seeds[ki]
    match email::EmailBuilder::new().from(alice).text_body("T").attach("a.bin", "application/octet-stream", "Z".to_bytes()).boundary_seed(sd).build() {
      Err(_) => ck(world, "bld_seed_" + nm, "P2", "invalid boundary seed rejected or sanitized", true, "")
      Ok(raw) => {
        let ok = match email::parse_message(raw) {
          Ok(m) => {
            let t = match m.text_body() {
              Some(x) => x
              None => ""
            }
            t == "T" && m.attachments().length() == 1 && sd.length() + 4 <= 70
          }
          Err(_) => false
        }
        ck(world, "bld_seed_" + nm, "P2", "invalid boundary seed rejected or sanitized (RFC 2046 bchars, <=70)", ok, "built a message whose MIME structure does not round-trip / boundary > 70 chars")
      }
    }
    ki = ki + 1
  }

  // Attachment content-type is spliced verbatim: multipart/* leaf breaks the whole message
  match email::EmailBuilder::new().from(alice).text_body("T").attach("x.bin", "multipart/mixed; boundary=\"zz\"", "Z".to_bytes()).build() {
    Err(_) => ck(world, "bld_attach_multipart_ct", "P2", "attachment content-type validated (no multipart/*)", true, "")
    Ok(raw) => {
      let r = match email::parse_message(raw) {
        Ok(_) => "parse ok"
        Err(e) => "parse_message => " + err_str(e)
      }
      ck(world, "bld_attach_multipart_ct", "P2", "attachment content-type validated (no multipart/*)", r == "parse ok", r)
    }
  }

  // Line length: RFC 5322 §2.1.1 MUST <= 998 octets
  match email::EmailBuilder::new().from(alice).subject(rep("a", 1200)).header("X-Long", rep("b", 1100)).text_body("T").build() {
    Ok(raw) => {
      let mx = max_line_len(raw.to_string())
      ck(world, "bld_line_998", "P2", "no generated line exceeds 998 octets", mx <= 998, "max line = " + mx.to_string())
    }
    Err(_) => ck(world, "bld_line_998", "P2", "no generated line exceeds 998 octets", true, "")
  }
  // Folding must be reversible: unfold(fold(v)) == v (RFC 5322 §2.2.3)
  let v = rep("word  ", 30)
  match email::EmailBuilder::new().from(alice).header("X-Spaces", v).text_body("T").build() {
    Ok(raw) =>
    match email::parse_message(raw) {
      Ok(m) => {
        let got = match m.header("X-Spaces") {
          Some(x) => x
          None => ""
        }
        let want = v.slice(0, v.length() - 2)
        ck(world, "bld_fold_roundtrip", "P2", "fold/unfold preserves whitespace runs", got == want, "got " + got.length().to_string() + " chars, want " + want.length().to_string())
      }
      Err(e) => ck(world, "bld_fold_roundtrip", "P2", "fold/unfold preserves whitespace runs", false, err_str(e))
    }
    Err(e) => ck(world, "bld_fold_roundtrip", "P2", "fold/unfold preserves whitespace runs", false, err_str(e))
  }
  // Long non-ASCII subject: RFC 2047 encoded-words <= 75 chars, lines <= 78, decodes back
  let subj = rep("季度报告✓ ", 25)
  match email::EmailBuilder::new().from(alice).subject(subj).text_body("T").build() {
    Ok(raw) =>
    match email::parse_message(raw) {
      Ok(m) => {
        let got = match m.subject() {
          Some(x) => x
          None => ""
        }
        let mx = max_line_len(raw.to_string())
        ck(world, "bld_subject_2047_roundtrip", "P2", "long UTF-8 subject round-trips, lines <= 78", got == subj && mx <= 78, "max line " + mx.to_string() + ", equal=" + (got == subj).to_string())
      }
      Err(e) => ck(world, "bld_subject_2047_roundtrip", "P1", "long UTF-8 subject round-trips", false, err_str(e))
    }
    Err(e) => ck(world, "bld_subject_2047_roundtrip", "P1", "long UTF-8 subject round-trips", false, err_str(e))
  }
  // Display names with specials / non-ASCII and filenames with quotes round-trip
  let names = ["Doe, \"JD\" \\ John", "张三 (CEO)", "=?utf-8?b?Zm9v?="]
  let mut ni = 0
  while ni < names.length() {
    match email::Mailbox::new(names[ni], "x@y.example") {
      Ok(mb) =>
      match email::EmailBuilder::new().from(mb).text_body("T").build() {
        Ok(raw) =>
        match email::parse_message(raw) {
          Ok(m) => {
            let got = match m.from() {
              Ok(f) => if f.length() == 1 { f[0].name } else { "<" + f.length().to_string() + " mailboxes>" }
              Err(e) => err_str(e)
            }
            ck(world, "bld_display_name_" + ni.to_string(), "P2", "display name [" + names[ni] + "] round-trips", got == names[ni], got)
          }
          Err(e) => ck(world, "bld_display_name_" + ni.to_string(), "P2", "display name round-trips", false, err_str(e))
        }
        Err(e) => ck(world, "bld_display_name_" + ni.to_string(), "P2", "display name round-trips", false, err_str(e))
      }
      Err(e) => ck(world, "bld_display_name_" + ni.to_string(), "P2", "display name accepted", false, err_str(e))
    }
    ni = ni + 1
  }
  let fnames = ["报告 2026.pdf", "a\"b\\c.txt"]
  let mut fi = 0
  while fi < fnames.length() {
    match email::EmailBuilder::new().from(alice).text_body("T").attach(fnames[fi], "application/octet-stream", "Z".to_bytes()).build() {
      Ok(raw) =>
      match email::parse_message(raw) {
        Ok(m) => {
          let atts = m.attachments()
          let got = if atts.length() == 1 { atts[0].filename } else { "<" + atts.length().to_string() + " atts>" }
          ck(world, "bld_filename_" + fi.to_string(), "P2", "attachment filename [" + fnames[fi] + "] round-trips", got == fnames[fi], got)
        }
        Err(e) => ck(world, "bld_filename_" + fi.to_string(), "P2", "filename round-trips", false, err_str(e))
      }
      Err(e) => ck(world, "bld_filename_" + fi.to_string(), "P2", "filename round-trips", false, err_str(e))
    }
    fi = fi + 1
  }
}

// ---------------------------------------------------------------------------
// 5. mbox (mboxo / mboxrd)
// ---------------------------------------------------------------------------

///|
fn mbox_rt(world : World, id : String, sev : String, msg : String, fl : email::MboxFlavor) -> Unit {
  match email::format_mbox_entry("a@b.example Mon Jan  1 00:00:00 2024", msg.to_bytes(), fl) {
    Ok(fb) =>
    match email::parse_mbox(fb, fl) {
      Ok(es) => {
        let got = if es.length() == 1 { es[0].message.to_string() } else { "<" + es.length().to_string() + " entries>" }
        ck(world, id, sev, "mbox round-trip is lossless for [" + esc(msg) + "]", got == msg, got)
      }
      Err(e) => ck(world, id, sev, "mbox round-trip", false, err_str(e))
    }
    Err(e) => ck(world, id, sev, "mbox round-trip", false, err_str(e))
  }
}

///|
fn sec_mbox(world : World) -> Unit {
  let rd = email::MboxFlavor::Mboxrd
  mbox_rt(world, "mbox_rd_from_quoting", "P1", "Subject: x\n\nFrom here\n>From a\n>>From b\n>>>From c\n", rd)
  mbox_rt(world, "mbox_rd_crlf", "P1", "Subject: x\r\n\r\nFrom crlf\r\n>From q\r\n", rd)
  mbox_rt(world, "mbox_rd_mixed_eol", "P1", "Subject: x\r\n\nFrom a\nb\r\n", rd)
  mbox_rt(world, "mbox_rd_no_final_newline", "P2", "Subject: x\n\nno newline", rd)
  mbox_rt(world, "mbox_rd_empty", "P2", "", rd)
  mbox_rt(world, "mbox_rd_trailing_blank", "P1", "Subject: x\n\nbody\n\n", rd)
  mbox_rt(world, "mbox_o_from_quoting", "P1", "Subject: x\n\nFrom here\n", email::MboxFlavor::Mboxo)
  // From_ line injection
  let inj = ["a@b\nFrom evil", "a@b\rX", "a\u{0}b"]
  let mut leaks = ""
  let mut i = 0
  while i < inj.length() {
    match email::format_mbox_entry(inj[i], "S: x\n\nb\n".to_bytes(), rd) {
      Ok(_) => leaks = leaks + i.to_string() + " "
      Err(_) => ()
    }
    i = i + 1
  }
  ck(world, "mbox_from_line_injection", "P0", "CR/LF/NUL in From_ line rejected", leaks == "", leaks)
  // Two messages, second body contains a quoted From_
  let two = "From a@b Mon Jan  1 00:00:00 2024\nSubject: 1\n\none\n>From x\n\nFrom c@d Mon Jan  1 00:00:00 2024\nSubject: 2\n\ntwo\n"
  match email::parse_mbox(two.to_bytes(), rd) {
    Ok(es) => ck(world, "mbox_two_messages", "P1", "two-entry mboxrd parses", es.length() == 2 && es[0].message.to_string() == "Subject: 1\n\none\nFrom x\n" && es[1].message.to_string() == "Subject: 2\n\ntwo\n", es.length().to_string())
    Err(e) => ck(world, "mbox_two_messages", "P1", "two-entry mboxrd parses", false, err_str(e))
  }
  // Default limits must not cap ordinary mailboxes at 1024 messages
  let sb = StringBuilder::new()
  let mut k = 0
  while k < 3000 {
    sb.write_string("From a@b Mon Jan  1 00:00:00 2024\nSubject: m\n\nbody\n\n")
    k = k + 1
  }
  match email::parse_mbox(sb.to_string().to_bytes(), rd) {
    Ok(es) => ck(world, "mbox_3000_default_limits", "P2", "3,000-message mbox parses with default limits", es.length() == 3000, es.length().to_string())
    Err(e) => ck(world, "mbox_3000_default_limits", "P2", "3,000-message mbox parses with default limits", false, err_str(e))
  }
}

// ---------------------------------------------------------------------------
// 6. Header parsing robustness
// ---------------------------------------------------------------------------

///|
fn sec_headers(world : World) -> Unit {
  // Header lookup must see a value folded with bare LF continuation
  match email::parse_message("Subject: a\n b\nTo: x@y.example\n\nB".to_bytes()) {
    Ok(m) => {
      let s = match m.subject() {
        Some(x) => x
        None => ""
      }
      ck(world, "hdr_lf_folding", "P2", "LF-only folded header unfolds", s == "a b", s)
    }
    Err(e) => ck(world, "hdr_lf_folding", "P2", "LF-only folded header unfolds", false, err_str(e))
  }
  // Multi-value header order preserved
  match email::parse_message("Received: one\r\nReceived: two\r\nReceived: three\r\n\r\n".to_bytes()) {
    Ok(m) => {
      let all = m.headers_all("received")
      ck(world, "hdr_multi_order", "P2", "multi-value header order preserved", all.length() == 3 && all[0] == "one" && all[2] == "three", all.length().to_string())
    }
    Err(e) => ck(world, "hdr_multi_order", "P2", "multi-value header order preserved", false, err_str(e))
  }
  // Leading mbox envelope line or a single non-RFC line must not make the whole message unparseable
  match email::parse_message("Subject: ok\r\nthis line has no colon\r\nTo: x@y.example\r\n\r\nB".to_bytes()) {
    Ok(_) => ck(world, "hdr_garbage_line", "P2", "one malformed header line does not reject the message", true, "")
    Err(e) => ck(world, "hdr_garbage_line", "P2", "one malformed header line does not reject the message (mail-parser/Go tolerate)", false, err_str(e))
  }
}

// ---------------------------------------------------------------------------
// 7. DoS probes (each run as a separate process per build mode)
// ---------------------------------------------------------------------------

///|
fn nested_multipart(depth : Int) -> Bytes {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_string("Content-Type: multipart/mixed; boundary=\"b" + i.to_string() + "\"\r\n\r\n--b" + i.to_string() + "\r\n")
    i = i + 1
  }
  sb.write_string("Content-Type: text/plain\r\n\r\nleaf\r\n")
  i = depth - 1
  while i >= 0 {
    sb.write_string("--b" + i.to_string() + "--\r\n")
    i = i - 1
  }
  sb.to_string().to_bytes()
}

///|
fn nested_rfc822(depth : Int) -> Bytes {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_string("Content-Type: message/rfc822\r\n\r\n")
    i = i + 1
  }
  sb.write_string("Subject: leaf\r\n\r\nleaf\r\n")
  sb.to_string().to_bytes()
}

///|
fn dos_expect_err(world : World, name : String, r : Result[email::EmailMessage, email::EmailError]) -> Unit {
  match r {
    Ok(_) => out(world, "DOS " + name + " OK")
    Err(e) => out(world, "DOS " + name + " ERR " + (if is_limit(e) { "LimitExceeded" } else { "Other" }))
  }
}

///|
fn run_dos(world : World, name : String) -> Int {
  if name == "mp_deep_2000" {
    dos_expect_err(world, name, email::parse_message(nested_multipart(2000)))
  } else if name == "rfc822_deep_2000" {
    dos_expect_err(world, name, email::parse_message(nested_rfc822(2000)))
  } else if name == "rfc822_deep_1000_raised_limit" {
    // caller raises max_depth to 1000; parser must fail or succeed gracefully, never exhaust the stack
    let lim = email::EmailLimits::{ max_depth: 1000, max_parts: 1000000, max_headers: 1024, max_header_bytes: 262144, max_body_bytes: 67108864 }
    dos_expect_err(world, name, email::parse_message_with_limits(nested_rfc822(1000), lim))
  } else if name == "rfc822_deep_20000_raised_limit" {
    let lim = email::EmailLimits::{ max_depth: 1000000, max_parts: 1000000, max_headers: 1024, max_header_bytes: 262144, max_body_bytes: 67108864 }
    dos_expect_err(world, name, email::parse_message_with_limits(nested_rfc822(20000), lim))
  } else if name == "headers_10k" {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < 10000 {
      sb.write_string("X-H" + i.to_string() + ": v\r\n")
      i = i + 1
    }
    sb.write_string("\r\nB")
    dos_expect_err(world, name, email::parse_message(sb.to_string().to_bytes()))
  } else if name == "parts_10k" {
    let sb = StringBuilder::new()
    sb.write_string("Content-Type: multipart/mixed; boundary=\"b\"\r\n\r\n")
    let mut i = 0
    while i < 10000 {
      sb.write_string("--b\r\nContent-Type: text/plain\r\n\r\np\r\n")
      i = i + 1
    }
    sb.write_string("--b--\r\n")
    dos_expect_err(world, name, email::parse_message(sb.to_string().to_bytes()))
  } else if name == "header_1mib" {
    dos_expect_err(world, name, email::parse_message(("Subject: " + rep("A", 1048576) + "\r\n\r\nB").to_bytes()))
  } else if name == "addr_comment_10k" {
    let s = rep("(", 10000) + "x" + rep(")", 10000) + " a@b.example"
    match email::parse_address_list(s) {
      Ok(_) => out(world, "DOS " + name + " OK")
      Err(e) => out(world, "DOS " + name + " ERR " + (if is_limit(e) { "LimitExceeded" } else { "Other" }))
    }
  } else if name == "date_comment_10k" {
    match email::parse_date(rep("(", 10000) + rep(")", 10000) + " 1 Jan 2024 00:00:00 +0000") {
      Ok(_) => out(world, "DOS " + name + " OK")
      Err(e) => out(world, "DOS " + name + " ERR " + (if is_limit(e) { "LimitExceeded" } else { "Other" }))
    }
  } else if name == "addr_list_100k" {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < 100000 {
      if i > 0 {
        sb.write_string(", ")
      }
      sb.write_string("u" + i.to_string() + "@x.example")
      i = i + 1
    }
    match email::parse_address_list(sb.to_string()) {
      Ok(a) => out(world, "DOS " + name + " OK " + a.length().to_string())
      Err(_) => out(world, "DOS " + name + " ERR")
    }
  } else if name == "rfc2047_6k_words" {
    let s = rep("=?UTF-8?B?5L2g?= =?ISO-8859-1?Q?=E9?= ", 6000)
    match email::parse_message(("Subject: " + s + "\r\n\r\n").to_bytes()) {
      Ok(m) =>
      match m.subject() {
        Some(x) => out(world, "DOS " + name + " OK " + x.length().to_string())
        None => out(world, "DOS " + name + " OK")
      }
      Err(e) => out(world, "DOS " + name + " ERR " + (if is_limit(e) { "LimitExceeded" } else { "Other" }))
    }
  } else if name == "dkim_h_40k" {
    let raw = ("DKIM-Signature: v=1; a=ed25519-sha256; c=relaxed/relaxed; d=a.example; s=s; h=" + rep("from:", 40000) + "from; bh=47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=; b=AAAA\r\n" + rep("From: a@b.example\r\n", 1000) + "\r\n").to_bytes()
    match email::dkim_verify_ed25519(raw, Bytes::new(32)) {
      Ok(_) => out(world, "DOS " + name + " OK")
      Err(e) => out(world, "DOS " + name + " ERR " + (if is_limit(e) { "LimitExceeded" } else { "Other" }))
    }
  } else {
    out(world, "DOS " + name + " UNKNOWN")
    return 2
  }
  0
}

///|
fn mbox_scale(world : World, n : Int) -> Int {
  let sb = StringBuilder::new()
  let mut k = 0
  while k < n {
    sb.write_string("From a@b Mon Jan  1 00:00:00 2024\nSubject: m\n\nbody line one\n>From quoted\nbody line three\n\n")
    k = k + 1
  }
  let lim = email::EmailLimits::{ max_depth: 16, max_parts: 100000000, max_headers: 1024, max_header_bytes: 262144, max_body_bytes: 67108864 }
  match email::parse_mbox_with_limits(sb.to_string().to_bytes(), email::MboxFlavor::Mboxrd, lim) {
    Ok(es) => out(world, "MBOX " + es.length().to_string())
    Err(e) => out(world, "MBOX ERR " + err_str(e))
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() >= 5 && args[1] == "all" {
    let cases = args[2]
    let fx = args[3]
    let out = args[4]
    sec_addr(world, cases)
    sec_date(world, cases)
    sec_rfc2047(world, cases)
    sec_mime(world, cases)
    sec_headers(world)
    sec_dkim(world, fx, out)
    sec_builder(world)
    sec_mbox(world)
    out(world, "END")
    return 0
  }
  if args.length() >= 3 && args[1] == "dos" {
    return run_dos(world, args[2])
  }
  if args.length() >= 3 && args[1] == "mbox-scale" {
    let mut n = 0
    let s = args[2]
    let mut i = 0
    while i < s.length() {
      n = n * 10 + (s.code_unit_at(i) - 48)
      i = i + 1
    }
    return mbox_scale(world, n)
  }
  out(world, "usage: email_audit all <cases_dir> <fixtures_dir> <out_dir> | dos <name> | mbox-scale <n>")
  1
}
