///| Pion Native head-to-head benchmark for packages/email.
///| Modes: "w1_mime" | "w2_addr_date" | "w3_dkim"

import "email"
import "crypto"

///|
fn mix(h : Int64, v : Int64) -> Int64 {
  ((h * 131L) + v) % 1000000007L
}

///|
fn hash_bytes(h0 : Int64, b : Bytes) -> Int64 {
  let len = b.length()
  let mut h = mix(h0, len.to_int64())
  let mut i = 0
  while i < len {
    h = mix(h, b[i].to_int().to_int64())
    i = i + 1
  }
  h
}

///|
fn hash_str(h0 : Int64, s : String) -> Int64 {
  hash_bytes(h0, s.to_bytes())
}

///|
fn split_nul(data : Bytes) -> Array[Bytes] {
  let out : Array[Bytes] = []
  let len = data.length()
  let mut start = 0
  let mut i = 0
  while i < len {
    if data[i].to_int() == 0 {
      out.push(data.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < len {
    out.push(data.slice(start, len))
  }
  out
}

///|
fn split_lines(data : Bytes) -> Array[String] {
  let out : Array[String] = []
  let len = data.length()
  let mut start = 0
  let mut i = 0
  while i < len {
    if data[i].to_int() == 10 {
      let mut end = i
      if end > start && data[end - 1].to_int() == 13 {
        end = end - 1
      }
      if end > start {
        out.push(data.slice(start, end).to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < len {
    out.push(data.slice(start, len).to_string())
  }
  out
}

///|
fn bench_w1_mime(world : World, data : Bytes) -> Int {
  let msgs = split_nul(data)
  let mut total_msgs = 0L
  let mut total_att = 0L
  let mut checksum = 0L
  let mut round = 0
  while round < 20 {
    let mut i = 0
    while i < msgs.length() {
      let m = match email::parse_message(msgs[i]) {
        Ok(x) => x
        Err(_) => return 2
      }
      total_msgs = total_msgs + 1L
      match m.subject() {
        Some(s) => checksum = hash_str(checksum, s)
        None => ()
      }
      match m.text_body() {
        Some(t) => checksum = hash_str(checksum, t)
        None => ()
      }
      match m.html_body() {
        Some(h) => checksum = hash_str(checksum, h)
        None => ()
      }
      let atts = m.attachments()
      let mut a = 0
      while a < atts.length() {
        total_att = total_att + 1L
        checksum = hash_bytes(checksum, atts[a].body)
        a = a + 1
      }
      i = i + 1
    }
    round = round + 1
  }
  io_println(world, "mode=w1_mime")
  io_println(world, "msgs=" + total_msgs.to_string())
  io_println(world, "attachments=" + total_att.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
fn bench_w2_addr_date(world : World, data : Bytes) -> Int {
  let lines = split_lines(data)
  let addrs_in : Array[String] = []
  let dates_in : Array[String] = []
  let mut li = 0
  while li < lines.length() {
    let line = lines[li]
    let mut tab = -1
    let mut k = 0
    while k < line.length() {
      if line.code_unit_at(k) == 9 {
        tab = k
        break
      }
      k = k + 1
    }
    if tab > 0 {
      addrs_in.push(line.slice(0, tab))
      dates_in.push(line.slice(tab + 1, line.length()))
    }
    li = li + 1
  }

  let mut ops = 0L
  let mut checksum = 0L
  let mut round = 0
  while round < 200 {
    let mut i = 0
    while i < addrs_in.length() {
      let list = match email::parse_address_list(addrs_in[i]) {
        Ok(x) => x
        Err(_) => return 3
      }
      let flat = email::flatten_addresses(list)
      let mut j = 0
      while j < flat.length() {
        checksum = hash_str(checksum, flat[j].address)
        j = j + 1
      }
      let dt = match email::parse_date(dates_in[i]) {
        Ok(d) => d
        Err(_) => return 4
      }
      checksum = mix(checksum, dt.timestamp % 1000000007L)
      ops = ops + 1L
      i = i + 1
    }
    round = round + 1
  }
  io_println(world, "mode=w2_addr_date")
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
fn bench_w3_dkim(world : World) -> Int {
  let seed = Bytes::new(32)
  let mut si = 0
  while si < 32 {
    seed[si] = (si + 1).to_byte()
    si = si + 1
  }
  let pub_key = match crypto::ed25519_public_key(seed) {
    Ok(k) => k
    Err(_) => return 5
  }
  let from_mb = match email::Mailbox::new("Sender", "sender@example.com") {
    Ok(m) => m
    Err(_) => return 6
  }
  let to_mb = match email::Mailbox::new("Recipient", "recv@example.com") {
    Ok(m) => m
    Err(_) => return 7
  }
  let dt = match email::parse_date("Mon, 23 Nov 2026 12:00:00 +0000") {
    Ok(d) => d
    Err(_) => return 8
  }
  let cfg = email::DkimSignConfig::{
    domain: "example.com",
    selector: "ed2026",
    header_canon: email::DkimCanon::Relaxed,
    body_canon: email::DkimCanon::Relaxed,
    signed_headers: ["From", "To", "Subject", "Date"],
    timestamp: Some(1795435200L),
  }

  let mut ops = 0L
  let mut verified = 0L
  let mut checksum = 0L
  let mut i = 0
  while i < 2000 {
    let raw = match email::EmailBuilder::new()
    .from(from_mb)
    .to(to_mb)
    .subject("DKIM Bench #" + i.to_string())
    .date(dt)
    .text_body("Benchmark body line " + i.to_string() + " with payload.")
    .build()
    {
      Ok(b) => b
      Err(_) => return 9
    }
    let signed = match email::dkim_sign_ed25519(raw, cfg, seed) {
      Ok(b) => b
      Err(_) => return 10
    }
    let sig = match email::dkim_verify_ed25519(signed, pub_key) {
      Ok(s) => s
      Err(_) => return 11
    }
    verified = verified + 1L
    checksum = hash_bytes(checksum, sig.body_hash)
    ops = ops + 1L
    i = i + 1
  }
  io_println(world, "mode=w3_dkim")
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "verified=" + verified.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: pion_email_bench <mode> [corpus_path]")
    return 1
  }
  let mode = args[1]
  if mode == "w3_dkim" {
    return bench_w3_dkim(world)
  }
  if args.length() < 3 {
    io_println(world, "missing corpus_path")
    return 1
  }
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => return 1
  }
  if mode == "w1_mime" {
    bench_w1_mime(world, data)
  } else if mode == "w2_addr_date" {
    bench_w2_addr_date(world, data)
  } else {
    1
  }
}
