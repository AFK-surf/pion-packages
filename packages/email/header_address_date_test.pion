///| RFC 5322 / 6532 / 2047 header, address-list, and date compliance tests.

///|
fn email_opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///|
test "header_unfold_multiline_and_rfc2047_and_utf8" {
  let raw = (
    "From: =?UTF-8?B?5byg5LiJ?= <zhangsan@example.com>\r\n" +
    "Subject: =?UTF-8?Q?Hello_=E4=B8=96=E7=95=8C?=\r\n" +
    " =?UTF-8?B?77yB?=\r\n" +
    "\tContinuation line\r\n" +
    "X-UTF8: 国际化邮件头测试 🚀\r\n" +
    "Received: from mx1.example.com\n" +
    " by mx2.example.com\n" +
    "Received: from mx0.example.com\r\n" +
    "\r\n" +
    "Body line\r\n"
  ).to_bytes()
  let (headers, body_off) = match parse_headers(raw, EmailLimits::default()) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse_headers failed: " + e.to_string())
      return ()
    }
  }
  debug_assert(headers.length() == 5, "expected 5 headers")
  debug_assert(
    raw.slice(body_off, raw.length()).to_string() == "Body line\r\n",
    "body offset exact",
  )
  debug_assert(
    email_opt_str_eq(
      headers_get_decoded(headers, "subject"),
      Some("Hello 世界！ Continuation line"),
    ),
    "unfolded + rfc2047 decoded subject",
  )
  debug_assert(
    email_opt_str_eq(headers_get(headers, "x-utf8"), Some("国际化邮件头测试 🚀")),
    "rfc6532 utf8 header",
  )
  let recvs = headers_get_all(headers, "RECEIVED")
  debug_assert(recvs.length() == 2, "two Received headers")
  debug_assert(recvs[0] == "from mx1.example.com by mx2.example.com", "LF folding")
  debug_assert(recvs[1] == "from mx0.example.com", "second Received")

  // Folding to <= 78 columns
  let folded = fold_header_line(
    "Subject",
    "This is a very long email subject header value that definitely exceeds seventy eight columns and must fold cleanly",
    78,
  )
  debug_assert(folded.contains("\r\n "), "folded with CRLF+SP")
  debug_assert(
    unfold_header(folded) ==
    "Subject: This is a very long email subject header value that definitely exceeds seventy eight columns and must fold cleanly",
    "unfold reverses fold",
  )
}

///|
test "header_validation_rejects_injection_and_bad_names" {
  match validate_header_name("X-Custom-Header") {
    Ok(_) => ()
    Err(_) => debug_assert(false, "valid header name")
  }
  match validate_header_name("Bad Name") {
    Err(EmailError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "space in header name must fail")
  }
  match validate_header_name("Bad:Name") {
    Err(EmailError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "colon in header name must fail")
  }
  match validate_header_value("normal value") {
    Ok(_) => ()
    Err(_) => debug_assert(false, "normal header value")
  }
  match validate_header_value("inject\r\nBcc: evil@attacker.test") {
    Err(EmailError::HeaderInjection(_)) => ()
    _ => debug_assert(false, "CRLF injection must be rejected")
  }
  match validate_header_value("inject\nBcc: evil@attacker.test") {
    Err(EmailError::HeaderInjection(_)) => ()
    _ => debug_assert(false, "LF injection must be rejected")
  }
  match validate_header_value("bad\x00nul") {
    Err(EmailError::HeaderInjection(_)) => ()
    _ => debug_assert(false, "NUL injection must be rejected")
  }
}

///|
test "address_list_quoted_comments_groups_routes_and_rfc2047" {
  // Single mailbox with quoted display name containing comma, escaped quote, and nested comment
  let s1 = "\"Doe, \\\"John\\\"\" (outer (nested) comment) <john.doe@example.com> (trailing)"
  match parse_address(s1) {
    Ok(mb) => {
      debug_assert(mb.name == "Doe, \"John\"", "quoted display name")
      debug_assert(mb.address == "john.doe@example.com", "addr-spec")
      debug_assert(mb.local_part() == "john.doe", "local_part")
      debug_assert(mb.domain() == "example.com", "domain")
    }
    Err(e) => debug_assert(false, "parse_address failed: " + e.to_string())
  }

  // Complex address-list: single + group + empty group + obsolete route + RFC 2047 display name
  let list_str =
  "Alice <alice@example.com>, " +
  "Engineering Team: =?UTF-8?B?5p2O5Zub?= <lisi@corp.example>, (dev) bob@corp.example;, " +
  "Undisclosed Recipients:;, " +
  "Legacy <@hop1.example,@hop2.example:carol@example.org>"
  let addrs = match parse_address_list(list_str) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse_address_list failed: " + e.to_string())
      return ()
    }
  }
  debug_assert(addrs.length() == 4, "expected 4 top-level Address items")
  match addrs[0] {
    Address::Single(mb) => {
      debug_assert(mb.name == "Alice", "alice name")
      debug_assert(mb.address == "alice@example.com", "alice addr")
    }
    _ => debug_assert(false, "addrs[0] should be Single")
  }
  match addrs[1] {
    Address::Group(g) => {
      debug_assert(g.name == "Engineering Team", "group name")
      debug_assert(g.members.length() == 2, "2 group members")
      debug_assert(g.members[0].name == "李四", "rfc2047 decoded member name")
      debug_assert(g.members[0].address == "lisi@corp.example", "member 0 addr")
      debug_assert(g.members[1].address == "bob@corp.example", "member 1 addr")
    }
    _ => debug_assert(false, "addrs[1] should be Group")
  }
  match addrs[2] {
    Address::Group(g) => {
      debug_assert(g.name == "Undisclosed Recipients", "empty group name")
      debug_assert(g.members.length() == 0, "0 members")
    }
    _ => debug_assert(false, "addrs[2] should be empty Group")
  }
  match addrs[3] {
    Address::Single(mb) => {
      debug_assert(mb.name == "Legacy", "legacy name")
      debug_assert(mb.address == "carol@example.org", "obsolete route stripped")
    }
    _ => debug_assert(false, "addrs[3] should be Single")
  }

  let flat = flatten_addresses(addrs)
  debug_assert(flat.length() == 4, "4 flattened mailboxes")

  // Formatting roundtrip
  let formatted = format_address_list(addrs)
  match parse_address_list(formatted) {
    Ok(reparsed) => {
      let flat2 = flatten_addresses(reparsed)
      debug_assert(flat2.length() == 4, "roundtrip count")
      debug_assert(flat2[1].name == "李四", "roundtrip utf8 name preserved")
      debug_assert(flat2[1].address == "lisi@corp.example", "roundtrip addr preserved")
    }
    Err(e) => debug_assert(false, "reparse formatted failed: " + e.to_string())
  }
}

///|
test "address_rejects_injection_and_malformed" {
  match parse_address_list("alice@example.com\r\nBcc: eve@evil.com") {
    Err(EmailError::HeaderInjection(_)) => ()
    _ => debug_assert(false, "CRLF in address list must fail with HeaderInjection")
  }
  match Mailbox::new("Evil\nName", "a@b.com") {
    Err(EmailError::HeaderInjection(_)) => ()
    _ => debug_assert(false, "LF in mailbox name must fail")
  }
  match parse_address("not-an-email") {
    Err(EmailError::InvalidAddress(_)) => ()
    _ => debug_assert(false, "missing @ must fail")
  }
  match parse_address("Alice (unclosed <alice@example.com>") {
    Err(EmailError::InvalidAddress(_)) => ()
    _ => debug_assert(false, "unclosed comment must fail")
  }
}

///|
test "date_rfc5322_numeric_legacy_unknown_offset_and_weekday" {
  // Standard numeric offset
  match parse_date("Mon, 23 Nov 2026 12:34:56 +0800") {
    Ok(d) => {
      debug_assert(d.year == 2026 && d.month == 11 && d.day == 23, "ymd")
      debug_assert(d.hour == 12 && d.minute == 34 && d.second == 56, "hms")
      debug_assert(d.offset_seconds == 28800, "+0800")
      debug_assert(!d.unknown_local_offset, "known offset")
      debug_assert(d.format() == "Mon, 23 Nov 2026 12:34:56 +0800", "canonical format")
    }
    Err(e) => debug_assert(false, "parse standard date failed: " + e.to_string())
  }

  // -0000 unknown local offset per RFC 5322 §3.3
  match parse_date("Fri, 21 Nov 1997 09:55:06 -0000") {
    Ok(d) => {
      debug_assert(d.offset_seconds == 0, "-0000 offset 0")
      debug_assert(d.unknown_local_offset, "-0000 marks unknown_local_offset")
      debug_assert(d.format() == "Fri, 21 Nov 1997 09:55:06 -0000", "preserves -0000")
    }
    Err(e) => debug_assert(false, "parse -0000 failed: " + e.to_string())
  }

  // Legacy timezones: EST, PST, GMT, UT, EDT, CST, CDT, MST, MDT, PDT + comment + optional seconds
  match parse_date("Tue, 1 Jul 2003 10:52:37 EST (Eastern)") {
    Ok(d) => debug_assert(d.offset_seconds == -18000, "EST = -0500")
    Err(e) => debug_assert(false, "EST failed: " + e.to_string())
  }
  match parse_date("1 Jul 2003 10:52 PST") {
    Ok(d) => {
      debug_assert(d.second == 0, "optional second defaults to 0")
      debug_assert(d.offset_seconds == -28800, "PST = -0800")
    }
    Err(e) => debug_assert(false, "PST failed: " + e.to_string())
  }
  match parse_date("Thu, 01 Jan 1970 00:00:00 GMT") {
    Ok(d) => {
      debug_assert(d.timestamp == 0L, "unix epoch")
      debug_assert(d.offset_seconds == 0, "GMT = 0")
    }
    Err(e) => debug_assert(false, "GMT failed: " + e.to_string())
  }
  match parse_date("Thu, 01 Jan 70 00:00:00 UT") {
    Ok(d) => debug_assert(d.year == 1970 && d.timestamp == 0L, "2-digit year 70 -> 1970")
    Err(e) => debug_assert(false, "UT 2-digit year failed: " + e.to_string())
  }

  // Wrong weekday must be rejected (2026-11-23 is Monday, not Tuesday)
  match parse_date("Tue, 23 Nov 2026 12:00:00 +0000") {
    Err(EmailError::InvalidDate(_)) => ()
    _ => debug_assert(false, "mismatched weekday must fail")
  }

  // Invalid calendar date must be rejected
  match parse_date("30 Feb 2026 12:00:00 +0000") {
    Err(EmailError::InvalidDate(_)) => ()
    _ => debug_assert(false, "Feb 30 must fail")
  }

  // from_timestamp roundtrip
  match EmailDate::from_timestamp(1700000000L, -18000) {
    Ok(d) => {
      let s = d.format()
      match parse_date(s) {
        Ok(d2) => debug_assert(d2.timestamp == 1700000000L && d2.offset_seconds == -18000, "ts roundtrip")
        Err(_) => debug_assert(false, "reparse from_timestamp failed")
      }
    }
    Err(_) => debug_assert(false, "from_timestamp failed")
  }
}
