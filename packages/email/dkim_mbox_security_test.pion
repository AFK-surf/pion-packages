///|
test "dkim_canonicalization_rfc6376_vectors" {
  // RFC 6376 §3.4.5 Example 1 & 2
  let h_simple = canonicalize_header("A", " X\r\n", DkimCanon::Simple)
  debug_assert(h_simple == "A: X\r\n", "simple header preserves case and spaces")

  let h_relaxed = canonicalize_header("SubJect", "  foo   \r\n\t bar  \r\n", DkimCanon::Relaxed)
  debug_assert(h_relaxed == "subject:foo bar", "relaxed header lowercases, unfolds, collapses WSP")

  // Simple body: strips trailing empty lines, ensures single CRLF (empty body -> CRLF)
  let b_empty_simple = canonicalize_body(Bytes::new(0), DkimCanon::Simple)
  debug_assert(b_empty_simple.to_string() == "\r\n", "simple empty body -> CRLF")

  let b_empty_relaxed = canonicalize_body(Bytes::new(0), DkimCanon::Relaxed)
  debug_assert(b_empty_relaxed.length() == 0, "relaxed empty body -> empty")

  let sample_body = " C \r\nD \t E\r\n\r\n\r\n".to_bytes()
  let b_s = canonicalize_body(sample_body, DkimCanon::Simple)
  debug_assert(b_s.to_string() == " C \r\nD \t E\r\n", "simple body keeps internal spaces, strips trailing empty lines")

  let b_r = canonicalize_body(sample_body, DkimCanon::Relaxed)
  debug_assert(b_r.to_string() == " C\r\nD E\r\n", "relaxed body strips trailing WSP and collapses internal WSP")
}

///|
test "dkim_ed25519_all_4_canon_modes_and_tamper_detection" {
  let seed = Bytes::new(32)
  let mut i = 0
  while i < 32 {
    seed[i] = (i + 1).to_byte()
    i = i + 1
  }
  let pub_key = match crypto::ed25519_public_key(seed) {
    Ok(k) => k
    Err(_) => {
      debug_assert(false, "ed25519_public_key failed")
      return ()
    }
  }
  let raw_email = (
    "From: Alice <alice@example.com>\r\n" +
    "To: Bob <bob@example.com>\r\n" +
    "Subject: DKIM Test   Message\r\n" +
    "Date: Mon, 23 Nov 2026 12:00:00 +0000\r\n" +
    "\r\n" +
    "Hello   DKIM  world!  \r\n" +
    "\r\n"
  ).to_bytes()

  let modes : Array[(DkimCanon, DkimCanon)] = [
    (DkimCanon::Simple, DkimCanon::Simple),
    (DkimCanon::Relaxed, DkimCanon::Simple),
    (DkimCanon::Simple, DkimCanon::Relaxed),
    (DkimCanon::Relaxed, DkimCanon::Relaxed),
  ]
  let mut m = 0
  while m < modes.length() {
    let (hc, bc) = modes[m]
    let cfg = DkimSignConfig::{
      domain: "example.com",
      selector: "ed2026",
      header_canon: hc,
      body_canon: bc,
      signed_headers: ["From", "To", "Subject", "Date"],
      timestamp: Some(1795435200L),
    }
    let signed = match dkim_sign_ed25519(raw_email, cfg, seed) {
      Ok(b) => b
      Err(e) => {
        debug_assert(false, "dkim_sign_ed25519 failed: " + e.to_string())
        return ()
      }
    }
    match dkim_verify_ed25519(signed, pub_key) {
      Ok(sig) => {
        debug_assert(sig.domain == "example.com", "domain matches")
        debug_assert(sig.selector == "ed2026", "selector matches")
      }
      Err(e) => debug_assert(false, "dkim_verify_ed25519 failed: " + e.to_string())
    }
    m = m + 1
  }

  // Tamper body must fail verification
  let cfg_rr = DkimSignConfig::{
    domain: "example.com",
    selector: "ed2026",
    header_canon: DkimCanon::Relaxed,
    body_canon: DkimCanon::Relaxed,
    signed_headers: ["From", "To", "Subject"],
    timestamp: None,
  }
  let signed = match dkim_sign_ed25519(raw_email, cfg_rr, seed) {
    Ok(b) => b
    Err(_) => {
      debug_assert(false, "sign rr")
      return ()
    }
  }
  let tampered = (signed.to_string() + "X").to_bytes()
  match dkim_verify_ed25519(tampered, pub_key) {
    Err(EmailError::DkimVerifyFailed(_)) => ()
    _ => debug_assert(false, "tampered body must fail DKIM verification")
  }
}

///|
test "dkim_rsa2048_sign_and_verify" {
  let priv_key = match crypto::RsaPrivateKey::from_pkcs8_pem(dkim_test_rsa_pem()) {
    Ok(k) => k
    Err(_) => {
      debug_assert(false, "load rsa key")
      return ()
    }
  }
  let pub_key = priv_key.public_key()
  let raw_email = (
    "From: sender@example.org\r\n" +
    "To: recv@example.org\r\n" +
    "Subject: RSA DKIM\r\n" +
    "\r\n" +
    "Signed with RSA-2048.\r\n"
  ).to_bytes()
  let cfg = DkimSignConfig::{
    domain: "example.org",
    selector: "rsa2026",
    header_canon: DkimCanon::Relaxed,
    body_canon: DkimCanon::Relaxed,
    signed_headers: ["From", "To", "Subject"],
    timestamp: Some(1795435200L),
  }
  let signed = match dkim_sign_rsa(raw_email, cfg, priv_key) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "dkim_sign_rsa failed: " + e.to_string())
      return ()
    }
  }
  match dkim_verify_rsa(signed, pub_key) {
    Ok(sig) => {
      debug_assert(sig.domain == "example.org", "rsa dkim domain")
      debug_assert(sig.selector == "rsa2026", "rsa dkim selector")
    }
    Err(e) => debug_assert(false, "dkim_verify_rsa failed: " + e.to_string())
  }
}

///|
test "dkim_rfc8463_rsa1024_spki_der_and_reject_512" {
  let spki_b64 = "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDkHlOQoBTzWRiGs5V6NpP3idY6Wk08a5qhdR6wy5bdOKb2jLQiY/J16JYi0Qvx/byYzCNb3W91y3FutACDfzwQ/BC/e/8uBsCR+yz1Lxj+PL6lHvqMKrM3rG4hstT5QjvHO9PzoxZyVYLzBfO2EeC3Ip3G+2kryOTIKT+l/K4w3QIDAQAB"
  let spki_der = match base64::decode(spki_b64) {
    Ok(b) => b
    Err(_) => {
      debug_assert(false, "decode rfc8463 spki")
      return ()
    }
  }
  let rfc8463_msg = (
    "DKIM-Signature: v=1; a=ed25519-sha256; c=relaxed/relaxed;\r\n" +
    " d=football.example.com; i=@football.example.com;\r\n" +
    " q=dns/txt; s=brisbane; t=1528637909; h=from : to :\r\n" +
    " subject : date : message-id : from : subject : date;\r\n" +
    " bh=2jUSOH9NhtVGCQWNr9BrIAPreKQjO6Sn7XIkfJVOzv8=;\r\n" +
    " b=/gCrinpcQOoIfuHNQIbq4pgh9kyIK3AQUdt9OdqQehSwhEIug4D11Bus\r\n" +
    " Fa3bT3FY5OsU7ZbnKELq+eXdp1Q1Dw==\r\n" +
    "DKIM-Signature: v=1; a=rsa-sha256; c=relaxed/relaxed;\r\n" +
    " d=football.example.com; i=@football.example.com;\r\n" +
    " q=dns/txt; s=test; t=1528637909; h=from : to : subject :\r\n" +
    " date : message-id : from : subject : date;\r\n" +
    " bh=2jUSOH9NhtVGCQWNr9BrIAPreKQjO6Sn7XIkfJVOzv8=;\r\n" +
    " b=F45dVWDfMbQDGHJFlXUNB2HKfbCeLRyhDXgFpEL8GwpsRe0IeIixNTe3\r\n" +
    " DhCVlUrSjV4BwcVcOF6+FF3Zo9Rpo1tFOeS9mPYQTnGdaSGsgeefOsk2Jz\r\n" +
    " dA+L10TeYt9BgDfQNZtKdN1WO//KgIqXP7OdEFE4LjFYNcUxZQ4FADY+8=\r\n" +
    "From: Joe SixPack <joe@football.example.com>\r\n" +
    "To: Suzie Q <suzie@shopping.example.net>\r\n" +
    "Subject: Is dinner ready?\r\n" +
    "Date: Fri, 11 Jul 2003 21:00:37 -0700 (PDT)\r\n" +
    "Message-ID: <20030712040037.46341.5F8J@football.example.com>\r\n" +
    "\r\n" +
    "Hi.\r\n" +
    "\r\n" +
    "We lost the game.  Are you hungry yet?\r\n" +
    "\r\n" +
    "Joe.\r\n"
  ).to_bytes()

  match dkim_verify_rsa_spki_der(rfc8463_msg, spki_der) {
    Ok(sig) => {
      debug_assert(sig.domain == "football.example.com", "rfc8463 rsa1024 domain")
      debug_assert(sig.selector == "test", "rfc8463 rsa1024 selector")
    }
    Err(e) => debug_assert(false, "RFC 8463 RSA-1024 vector must verify: " + e.to_string())
  }

  // Tampered message must fail with the 1024-bit key
  let tampered = (rfc8463_msg.to_string() + "tamper\r\n").to_bytes()
  match dkim_verify_rsa_spki_der(tampered, spki_der) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "tampered RFC 8463 RSA-1024 message must fail")
  }

  // 512-bit RSA SPKI DER must be strictly rejected (< 1024 bits)
  let weak_spki_b64 = "MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBALe5c9V1d2J3a4k5l6m7n8o9p0q1r2s3t4u5v6w7x8y9z0A1B2C3D4E5F6G7H8I9J0K1L2M3N4O5P6Q7R8S9T0UCAwEAAQ=="
  match base64::decode(weak_spki_b64) {
    Ok(weak_der) =>
    match dkim_verify_rsa_spki_der(rfc8463_msg, weak_der) {
      Err(EmailError::InvalidDkim(_)) => ()
      _ => debug_assert(false, "512-bit RSA key must be rejected with InvalidDkim")
    }
    Err(_) => debug_assert(false, "decode weak spki")
  }
}

///|
test "mbox_mboxrd_and_mboxo_escaping_roundtrip" {
  let m1 = (
    "From: a@example.com\r\n" +
    "Subject: One\r\n" +
    "\r\n" +
    "Normal line\n" +
    "From someone in body\n" +
    ">From already quoted\n" +
    ">>From double quoted\n"
  ).to_bytes()
  let m2 = (
    "From: b@example.com\r\n" +
    "Subject: Two\r\n" +
    "\r\n" +
    "Second message body.\n"
  ).to_bytes()

  let entries = [
    MboxEntry::{ from_line: "a@example.com Mon Nov 23 12:00:00 2026", message: m1 },
    MboxEntry::{ from_line: "b@example.com Mon Nov 23 12:05:00 2026", message: m2 },
  ]

  // mboxrd is lossless for >*From lines
  let encoded_rd = match format_mbox(entries, MboxFlavor::Mboxrd) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "format_mbox rd failed: " + e.to_string())
      return ()
    }
  }
  let rd_str = encoded_rd.to_string()
  debug_assert(rd_str.contains(">From someone in body"), "mboxrd escapes From ")
  debug_assert(rd_str.contains(">>From already quoted"), "mboxrd escapes >From ")
  debug_assert(rd_str.contains(">>>From double quoted"), "mboxrd escapes >>From ")

  let decoded_rd = match parse_mbox(encoded_rd, MboxFlavor::Mboxrd) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse_mbox rd failed: " + e.to_string())
      return ()
    }
  }
  debug_assert(decoded_rd.length() == 2, "2 mbox entries")
  debug_assert(decoded_rd[0].from_line == "a@example.com Mon Nov 23 12:00:00 2026", "from_line 0")
  debug_assert(decoded_rd[0].message.to_string() == m1.to_string(), "mboxrd lossless roundtrip")
  debug_assert(decoded_rd[1].message.to_string() == m2.to_string(), "mboxrd entry 2")

  // mboxo rejects from_line newline injection
  match format_mbox_entry("a@b\nInjected", m2, MboxFlavor::Mboxo) {
    Err(EmailError::HeaderInjection(_)) => ()
    _ => debug_assert(false, "mbox from_line newline injection must fail")
  }
}

///|
test "security_deep_nesting_and_limits_dos" {
  // Build a 32-level deeply nested multipart message; default max_depth=16 must reject cleanly
  let sb = StringBuilder::new()
  sb.write_string("From: dos@example.com\r\n")
  let mut d = 0
  while d < 32 {
    sb.write_string("Content-Type: multipart/mixed; boundary=\"b")
    sb.write_string(d.to_string())
    sb.write_string("\"\r\n\r\n--b")
    sb.write_string(d.to_string())
    sb.write_string("\r\n")
    d = d + 1
  }
  sb.write_string("Content-Type: text/plain\r\n\r\nleaf\r\n")
  let mut c = 31
  while c >= 0 {
    sb.write_string("--b")
    sb.write_string(c.to_string())
    sb.write_string("--\r\n")
    c = c - 1
  }
  let deep_raw = sb.to_string().to_bytes()
  match parse_message(deep_raw) {
    Err(EmailError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "deep nesting > max_depth must return LimitExceeded")
  }

  // Tight max_headers limit
  let tight = EmailLimits::{
    max_depth: 16,
    max_parts: 10,
    max_headers: 2,
    max_header_bytes: 65536,
    max_body_bytes: 65536,
  }
  let three_hdrs = "A: 1\r\nB: 2\r\nC: 3\r\n\r\nbody".to_bytes()
  match parse_message_with_limits(three_hdrs, tight) {
    Err(EmailError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "exceeding max_headers must return LimitExceeded")
  }

  // Tight max_body_bytes limit
  let tiny_body = EmailLimits::{
    max_depth: 16,
    max_parts: 10,
    max_headers: 100,
    max_header_bytes: 65536,
    max_body_bytes: 4,
  }
  let big_body = "From: a@b.com\r\n\r\n0123456789".to_bytes()
  match parse_message_with_limits(big_body, tiny_body) {
    Err(EmailError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "exceeding max_body_bytes must return LimitExceeded")
  }
}
