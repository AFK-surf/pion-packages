///| RFC 6376 DKIM canonicalization, signing, and verification (rsa-sha256 & ed25519-sha256).

import "crypto"
import "base64"

///|
pub enum DkimCanon {
  Simple
  Relaxed
}

///|
pub enum DkimAlgorithm {
  RsaSha256
  Ed25519Sha256
}

///|
pub struct DkimSignature {
  version : String
  algorithm : DkimAlgorithm
  signature : Bytes
  body_hash : Bytes
  header_canon : DkimCanon
  body_canon : DkimCanon
  domain : String
  selector : String
  signed_headers : Array[String]
  body_length : Option[Int]
  timestamp : Option[Int64]
  expiration : Option[Int64]
  raw_header_name : String
  raw_header_value : String
}

///|
pub struct DkimSignConfig {
  domain : String
  selector : String
  header_canon : DkimCanon
  body_canon : DkimCanon
  signed_headers : Array[String]
  timestamp : Option[Int64]
}

///|
fn dkim_canon_name(c : DkimCanon) -> String {
  match c {
    DkimCanon::Simple => "simple"
    DkimCanon::Relaxed => "relaxed"
  }
}

///|
pub fn canonicalize_header(
  name : String,
  raw_value : String,
  canon : DkimCanon,
) -> String {
  match canon {
    DkimCanon::Simple => name + ":" + raw_value
    DkimCanon::Relaxed => {
      // 1. Lowercase header name, trim trailing WSP on name
      let sb = StringBuilder::new()
      let nlen = name.length()
      let mut ni = 0
      while ni < nlen {
        let c = name.code_unit_at(ni)
        if c != 32 && c != 9 {
          sb.write_byte(hdr_ascii_lower(c).to_byte())
        }
        ni = ni + 1
      }
      sb.write_byte((58).to_byte())
      // 2. Unfold CRLF/LF, collapse all WSP runs to a single SP, strip leading/trailing WSP
      let vlen = raw_value.length()
      let val_sb = StringBuilder::new()
      let mut i = 0
      let mut in_wsp = false
      let mut wrote_any = false
      while i < vlen {
        let c = raw_value.code_unit_at(i)
        if c == 13 || c == 10 {
          i = i + 1
          continue
        }
        if c == 32 || c == 9 {
          if wrote_any {
            in_wsp = true
          }
        } else {
          if in_wsp {
            val_sb.write_byte((32).to_byte())
            in_wsp = false
          }
          val_sb.write_byte(c.to_byte())
          wrote_any = true
        }
        i = i + 1
      }
      sb.write_string(val_sb.to_string())
      sb.to_string()
    }
  }
}

///|
pub fn canonicalize_body(body : Bytes, canon : DkimCanon) -> Bytes {
  let len = body.length()
  match canon {
    DkimCanon::Simple => {
      if len == 0 {
        return "\r\n".to_bytes()
      }
      // Split into lines normalized to CRLF, strip all trailing empty lines
      let lines : Array[Bytes] = []
      let mut pos = 0
      while pos < len {
        let start = pos
        while pos < len && body[pos].to_int() != 10 {
          pos = pos + 1
        }
        let mut end = pos
        if end > start && body[end - 1].to_int() == 13 {
          end = end - 1
        }
        lines.push(body.slice(start, end))
        if pos < len && body[pos].to_int() == 10 {
          pos = pos + 1
        }
      }
      let mut last = lines.length()
      while last > 0 && lines[last - 1].length() == 0 {
        last = last - 1
      }
      if last == 0 {
        return "\r\n".to_bytes()
      }
      let sb = StringBuilder::new()
      let mut i = 0
      while i < last {
        let line = lines[i]
        let mut j = 0
        while j < line.length() {
          sb.write_byte(line[j])
          j = j + 1
        }
        sb.write_string("\r\n")
        i = i + 1
      }
      sb.to_string().to_bytes()
    }
    DkimCanon::Relaxed => {
      if len == 0 {
        return Bytes::new(0)
      }
      let lines : Array[String] = []
      let mut pos = 0
      while pos < len {
        let start = pos
        while pos < len && body[pos].to_int() != 10 {
          pos = pos + 1
        }
        let mut end = pos
        if end > start && body[end - 1].to_int() == 13 {
          end = end - 1
        }
        // Strip trailing WSP on line
        while end > start && (body[end - 1].to_int() == 32 || body[end - 1].to_int() == 9) {
          end = end - 1
        }
        // Collapse internal WSP runs to single SP
        let lsb = StringBuilder::new()
        let mut i = start
        let mut prev_wsp = false
        while i < end {
          let c = body[i].to_int()
          if c == 32 || c == 9 {
            if !prev_wsp {
              lsb.write_byte((32).to_byte())
              prev_wsp = true
            }
          } else {
            lsb.write_byte(c.to_byte())
            prev_wsp = false
          }
          i = i + 1
        }
        lines.push(lsb.to_string())
        if pos < len && body[pos].to_int() == 10 {
          pos = pos + 1
        }
      }
      let mut last = lines.length()
      while last > 0 && lines[last - 1].length() == 0 {
        last = last - 1
      }
      if last == 0 {
        return Bytes::new(0)
      }
      let sb = StringBuilder::new()
      let mut i = 0
      while i < last {
        sb.write_string(lines[i])
        sb.write_string("\r\n")
        i = i + 1
      }
      sb.to_string().to_bytes()
    }
  }
}

///|
fn dkim_trim_fws(s : String) -> String {
  let len = s.length()
  let mut start = 0
  while start < len {
    let c = s.code_unit_at(start)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      start = start + 1
    } else {
      break
    }
  }
  let mut end = len
  while end > start {
    let c = s.code_unit_at(end - 1)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      end = end - 1
    } else {
      break
    }
  }
  s.slice(start, end)
}

///|
fn dkim_parse_int64(s : String) -> Option[Int64] {
  let t = dkim_trim_fws(s)
  if t.length() == 0 {
    return None
  }
  let mut v = 0L
  let mut i = 0
  while i < t.length() {
    let c = t.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    let d = (c - 48).to_int64()
    if v > (9223372036854775807L - d) / 10L {
      return None
    }
    v = v * 10L + d
    i = i + 1
  }
  Some(v)
}

///|
fn dkim_parse_canon_pair(v : String) -> Result[(DkimCanon, DkimCanon), EmailError] {
  let t = msg_ascii_lower_str(dkim_trim_fws(v))
  let mut slash = -1
  let mut i = 0
  while i < t.length() {
    if t.code_unit_at(i) == 47 {
      slash = i
      break
    }
    i = i + 1
  }
  let (h_str, b_str) = if slash < 0 {
    (t, "simple")
  } else {
    (t.slice(0, slash), t.slice(slash + 1, t.length()))
  }
  let hc = if h_str == "simple" {
    DkimCanon::Simple
  } else if h_str == "relaxed" {
    DkimCanon::Relaxed
  } else {
    return Err(EmailError::InvalidDkim("invalid header canonicalization: " + h_str))
  }
  let bc = if b_str == "simple" {
    DkimCanon::Simple
  } else if b_str == "relaxed" {
    DkimCanon::Relaxed
  } else {
    return Err(EmailError::InvalidDkim("invalid body canonicalization: " + b_str))
  }
  Ok((hc, bc))
}

///|
fn dkim_tag_seen(seen : Array[String], tag : String) -> Bool {
  let mut i = 0
  while i < seen.length() {
    if seen[i] == tag {
      return true
    }
    i = i + 1
  }
  false
}

///|
pub fn parse_dkim_signature(raw_value : String) -> Result[DkimSignature, EmailError] {
  let mut version = ""
  let mut alg_str = ""
  let mut sig_b64 = ""
  let mut bh_b64 = ""
  let mut h_canon = DkimCanon::Simple
  let mut b_canon = DkimCanon::Simple
  let mut domain = ""
  let mut selector = ""
  let signed_headers : Array[String] = []
  let mut body_length : Option[Int] = None
  let mut timestamp : Option[Int64] = None
  let mut expiration : Option[Int64] = None
  let mut has_v = false
  let mut has_a = false
  let mut has_b = false
  let mut has_bh = false
  let mut has_d = false
  let mut has_s = false
  let mut has_h = false
  let seen_tags : Array[String] = []

  let len = raw_value.length()
  let mut pos = 0
  while pos < len {
    let start = pos
    while pos < len && raw_value.code_unit_at(pos) != 59 {
      pos = pos + 1
    }
    let part = dkim_trim_fws(raw_value.slice(start, pos))
    if pos < len && raw_value.code_unit_at(pos) == 59 {
      pos = pos + 1
    }
    if part.length() == 0 {
      continue
    }
    let mut eq = -1
    let mut k = 0
    while k < part.length() {
      if part.code_unit_at(k) == 61 {
        eq = k
        break
      }
      k = k + 1
    }
    if eq <= 0 {
      return Err(EmailError::InvalidDkim("malformed DKIM tag"))
    }
    let tag = dkim_trim_fws(part.slice(0, eq))
    let v_str = dkim_trim_fws(part.slice(eq + 1, part.length()))
    // RFC 6376 §3.2: duplicate tag names make the entire tag-list invalid
    if dkim_tag_seen(seen_tags, tag) {
      return Err(EmailError::InvalidDkim("duplicate DKIM tag: " + tag))
    }
    seen_tags.push(tag)
    if tag == "v" {
      has_v = true
      version = v_str
    } else if tag == "a" {
      has_a = true
      alg_str = msg_ascii_lower_str(v_str)
    } else if tag == "b" {
      has_b = true
      sig_b64 = v_str
    } else if tag == "bh" {
      has_bh = true
      bh_b64 = v_str
    } else if tag == "c" {
      match dkim_parse_canon_pair(v_str) {
        Ok((hc, bc)) => {
          h_canon = hc
          b_canon = bc
        }
        Err(e) => return Err(e)
      }
    } else if tag == "d" {
      has_d = true
      domain = v_str
    } else if tag == "s" {
      has_s = true
      selector = v_str
    } else if tag == "h" {
      has_h = true
      let mut hp = 0
      let hlen = v_str.length()
      while hp < hlen {
        let hs = hp
        while hp < hlen && v_str.code_unit_at(hp) != 58 {
          hp = hp + 1
        }
        let hname = msg_ascii_lower_str(dkim_trim_fws(v_str.slice(hs, hp)))
        if hname.length() > 0 {
          if signed_headers.length() >= 1024 {
            return Err(EmailError::LimitExceeded("too many entries in DKIM h= tag"))
          }
          signed_headers.push(hname)
        }
        if hp < hlen && v_str.code_unit_at(hp) == 58 {
          hp = hp + 1
        }
      }
    } else if tag == "l" {
      match dkim_parse_int64(v_str) {
        Some(n) => {
          if n < 0L || n > 2147483647L {
            return Err(EmailError::InvalidDkim("l= tag value out of range"))
          }
          body_length = Some(n.to_int())
        }
        None => return Err(EmailError::InvalidDkim("invalid l= tag"))
      }
    } else if tag == "t" {
      match dkim_parse_int64(v_str) {
        Some(n) => timestamp = Some(n)
        None => return Err(EmailError::InvalidDkim("invalid t= tag"))
      }
    } else if tag == "x" {
      match dkim_parse_int64(v_str) {
        Some(n) => expiration = Some(n)
        None => return Err(EmailError::InvalidDkim("invalid x= tag"))
      }
    }
  }

  if !has_v || version != "1" {
    return Err(EmailError::InvalidDkim("missing or unsupported DKIM version"))
  }
  if !has_a {
    return Err(EmailError::InvalidDkim("missing required a= tag"))
  }
  let algorithm = if alg_str == "rsa-sha256" {
    DkimAlgorithm::RsaSha256
  } else if alg_str == "ed25519-sha256" {
    DkimAlgorithm::Ed25519Sha256
  } else {
    return Err(EmailError::InvalidDkim("unsupported DKIM algorithm: " + alg_str))
  }
  if !has_d || !has_s || !has_h || !has_b || !has_bh ||
  domain.length() == 0 || selector.length() == 0 || signed_headers.length() == 0 ||
  sig_b64.length() == 0 || bh_b64.length() == 0 {
    return Err(EmailError::InvalidDkim("missing required d=/s=/h=/b=/bh= tag"))
  }
  // RFC 6376 §5.4 / §6.1.1: h= MUST include From
  let mut has_from = false
  let mut fi = 0
  while fi < signed_headers.length() {
    if signed_headers[fi] == "from" {
      has_from = true
      break
    }
    fi = fi + 1
  }
  if !has_from {
    return Err(EmailError::InvalidDkim("DKIM h= tag must include from"))
  }
  let signature = match base64::decode_loose(sig_b64) {
    Ok(b) => b
    Err(_) => return Err(EmailError::InvalidDkim("invalid base64 in b= tag"))
  }
  let body_hash = match base64::decode_loose(bh_b64) {
    Ok(b) => b
    Err(_) => return Err(EmailError::InvalidDkim("invalid base64 in bh= tag"))
  }

  Ok(
    DkimSignature::{
      version: version,
      algorithm: algorithm,
      signature: signature,
      body_hash: body_hash,
      header_canon: h_canon,
      body_canon: b_canon,
      domain: domain,
      selector: selector,
      signed_headers: signed_headers,
      body_length: body_length,
      timestamp: timestamp,
      expiration: expiration,
      raw_header_name: "DKIM-Signature",
      raw_header_value: raw_value,
    },
  )
}

///|
fn dkim_strip_b_value(raw_value : String) -> String {
  // Replace `b=<base64...>` with `b=` preserving all other bytes/whitespace verbatim
  let len = raw_value.length()
  let sb = StringBuilder::new()
  let mut pos = 0
  while pos < len {
    let seg_start = pos
    while pos < len && raw_value.code_unit_at(pos) != 59 {
      pos = pos + 1
    }
    let seg_end = pos
    let has_semi = pos < len && raw_value.code_unit_at(pos) == 59
    if has_semi {
      pos = pos + 1
    }
    let seg = raw_value.slice(seg_start, seg_end)
    let mut eq = -1
    let mut k = 0
    while k < seg.length() {
      if seg.code_unit_at(k) == 61 {
        eq = k
        break
      }
      k = k + 1
    }
    if eq > 0 && dkim_trim_fws(seg.slice(0, eq)) == "b" {
      sb.write_string(seg.slice(0, eq + 1))
    } else {
      sb.write_string(seg)
    }
    if has_semi {
      sb.write_byte((59).to_byte())
    }
  }
  sb.to_string()
}

///|
fn dkim_build_signing_input(
  headers : Array[Header],
  signed_headers : Array[String],
  dkim_hdr_name : String,
  dkim_hdr_raw_value_no_b : String,
  h_canon : DkimCanon,
) -> Bytes {
  // RFC 6376 §5.4.2 bottom-up header selection
  let used : Array[Bool] = []
  let mut u = 0
  while u < headers.length() {
    used.push(false)
    u = u + 1
  }
  let sb = StringBuilder::new()
  let mut si = 0
  while si < signed_headers.length() {
    let target = signed_headers[si]
    let mut hi = headers.length() - 1
    while hi >= 0 {
      if !used[hi] && hdr_eq_ignore_case(headers[hi].name, target) {
        used[hi] = true
        sb.write_string(canonicalize_header(headers[hi].name, headers[hi].raw_value, h_canon))
        sb.write_string("\r\n")
        break
      }
      hi = hi - 1
    }
    si = si + 1
  }
  // Append DKIM-Signature header with empty b= and NO trailing CRLF
  sb.write_string(canonicalize_header(dkim_hdr_name, dkim_hdr_raw_value_no_b, h_canon))
  sb.to_string().to_bytes()
}

///|
fn dkim_prepare_sign_header(
  raw_email : Bytes,
  cfg : DkimSignConfig,
  alg_name : String,
) -> Result[(String, Bytes), EmailError] {
  match validate_header_value(cfg.domain) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match validate_header_value(cfg.selector) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let (headers, body_off) = match parse_headers(raw_email, EmailLimits::default()) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let raw_body = raw_email.slice(body_off, raw_email.length())
  let cbody = canonicalize_body(raw_body, cfg.body_canon)
  let bh = base64::encode(crypto::sha256(cbody))

  let h_list = StringBuilder::new()
  let signed_lower : Array[String] = []
  let mut has_from = false
  let mut i = 0
  while i < cfg.signed_headers.length() {
    if i > 0 {
      h_list.write_byte((58).to_byte())
    }
    let ln = msg_ascii_lower_str(cfg.signed_headers[i])
    if ln == "from" {
      has_from = true
    }
    h_list.write_string(ln)
    signed_lower.push(ln)
    i = i + 1
  }
  if !has_from {
    return Err(EmailError::InvalidDkim("DKIM signed_headers must include From (RFC 6376 §5.4)"))
  }

  let val_sb = StringBuilder::new()
  val_sb.write_string(" v=1; a=")
  val_sb.write_string(alg_name)
  val_sb.write_string("; c=")
  val_sb.write_string(dkim_canon_name(cfg.header_canon))
  val_sb.write_byte((47).to_byte())
  val_sb.write_string(dkim_canon_name(cfg.body_canon))
  val_sb.write_string("; d=")
  val_sb.write_string(cfg.domain)
  val_sb.write_string("; s=")
  val_sb.write_string(cfg.selector)
  match cfg.timestamp {
    Some(t) => {
      val_sb.write_string("; t=")
      val_sb.write_string(t.to_string())
    }
    None => ()
  }
  val_sb.write_string("; h=")
  val_sb.write_string(h_list.to_string())
  val_sb.write_string("; bh=")
  val_sb.write_string(bh)
  val_sb.write_string("; b=")
  let dkim_val_no_b = val_sb.to_string()

  let signing_input = dkim_build_signing_input(
    headers,
    signed_lower,
    "DKIM-Signature",
    dkim_val_no_b,
    cfg.header_canon,
  )
  Ok((dkim_val_no_b, signing_input))
}

///|
fn dkim_prepend_header(raw_email : Bytes, dkim_val_no_b : String, sig_bytes : Bytes) -> Bytes {
  let sb = StringBuilder::new()
  sb.write_string("DKIM-Signature:")
  sb.write_string(dkim_val_no_b)
  sb.write_string(base64::encode(sig_bytes))
  sb.write_string("\r\n")
  let prefix = sb.to_string().to_bytes()
  let total = prefix.length() + raw_email.length()
  let out = Bytes::new(total)
  let mut i = 0
  while i < prefix.length() {
    out[i] = prefix[i]
    i = i + 1
  }
  let mut j = 0
  while j < raw_email.length() {
    out[prefix.length() + j] = raw_email[j]
    j = j + 1
  }
  out
}

///|
pub fn dkim_sign_ed25519(
  raw_email : Bytes,
  cfg : DkimSignConfig,
  seed : Bytes,
) -> Result[Bytes, EmailError] {
  let (dkim_val_no_b, signing_input) = match dkim_prepare_sign_header(raw_email, cfg, "ed25519-sha256") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  // RFC 8463 §3.3: Ed25519-SHA256 signs the SHA-256 digest of the canonicalized header data
  let digest = crypto::sha256(signing_input)
  let sig = match crypto::ed25519_sign(seed, digest) {
    Ok(s) => s
    Err(_) => return Err(EmailError::InvalidDkim("ed25519 signing failed"))
  }
  Ok(dkim_prepend_header(raw_email, dkim_val_no_b, sig))
}

///|
pub fn dkim_sign_rsa(
  raw_email : Bytes,
  cfg : DkimSignConfig,
  key : crypto::RsaPrivateKey,
) -> Result[Bytes, EmailError] {
  let (dkim_val_no_b, signing_input) = match dkim_prepare_sign_header(raw_email, cfg, "rsa-sha256") {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let sig = match crypto::rsa_sign_rs256(key, signing_input) {
    Ok(s) => s
    Err(_) => return Err(EmailError::InvalidDkim("rsa-sha256 signing failed"))
  }
  Ok(dkim_prepend_header(raw_email, dkim_val_no_b, sig))
}

///| Count occurrences of `From` headers in the message and `from` entries in `h=`.
fn dkim_check_from_coverage(headers : Array[Header], sig : DkimSignature) -> Result[Unit, EmailError] {
  let mut n_from = 0
  let mut hi = 0
  while hi < headers.length() {
    if hdr_eq_ignore_case(headers[hi].name, "From") {
      n_from = n_from + 1
    }
    hi = hi + 1
  }
  let mut h_from = 0
  let mut si = 0
  while si < sig.signed_headers.length() {
    if sig.signed_headers[si] == "from" {
      h_from = h_from + 1
    }
    si = si + 1
  }
  if h_from == 0 {
    return Err(EmailError::InvalidDkim("DKIM h= tag must include from"))
  }
  if n_from > h_from {
    return Err(EmailError::DkimVerifyFailed("unsigned duplicate From header present (RFC 6376 §8.15)"))
  }
  Ok(())
}

///| Check body hash and construct signing input for one parsed DKIM-Signature header.
fn dkim_prepare_verify_one(
  headers : Array[Header],
  raw_body : Bytes,
  dkim_hdr : Header,
  want_rsa : Bool,
) -> Result[(DkimSignature, Bytes), EmailError] {
  let parsed = match parse_dkim_signature(dkim_hdr.raw_value) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let alg_ok = match parsed.algorithm {
    DkimAlgorithm::RsaSha256 => want_rsa
    DkimAlgorithm::Ed25519Sha256 => !want_rsa
  }
  if !alg_ok {
    return Err(EmailError::DkimVerifyFailed("algorithm mismatch"))
  }
  match dkim_check_from_coverage(headers, parsed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut cbody = canonicalize_body(raw_body, parsed.body_canon)
  match parsed.body_length {
    Some(l) => {
      if l < 0 || l > cbody.length() {
        return Err(EmailError::DkimVerifyFailed("l= body length out of range"))
      }
      cbody = cbody.slice(0, l)
    }
    None => ()
  }
  let computed_bh = crypto::sha256(cbody)
  if !crypto::constant_time_eq(computed_bh, parsed.body_hash) {
    return Err(EmailError::DkimVerifyFailed("body hash (bh=) mismatch"))
  }
  let dkim_no_b = dkim_strip_b_value(dkim_hdr.raw_value)
  let signing_input = dkim_build_signing_input(
    headers,
    parsed.signed_headers,
    dkim_hdr.name,
    dkim_no_b,
    parsed.header_canon,
  )
  Ok((parsed, signing_input))
}

///|
pub fn dkim_verify_ed25519(
  raw_email : Bytes,
  public_key : Bytes,
) -> Result[DkimSignature, EmailError] {
  let (headers, body_off) = match parse_headers(raw_email, EmailLimits::default()) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let raw_body = raw_email.slice(body_off, raw_email.length())
  let mut found = false
  let mut last_err = EmailError::InvalidDkim("missing DKIM-Signature header")
  let mut i = 0
  while i < headers.length() {
    if hdr_eq_ignore_case(headers[i].name, "DKIM-Signature") {
      found = true
      match dkim_prepare_verify_one(headers, raw_body, headers[i], false) {
        Ok((sig, signing_input)) => {
          let digest = crypto::sha256(signing_input)
          if crypto::ed25519_verify(public_key, digest, sig.signature) {
            return Ok(sig)
          }
          last_err = EmailError::DkimVerifyFailed("ed25519 signature verification failed")
        }
        Err(e) => last_err = e
      }
    }
    i = i + 1
  }
  if !found {
    return Err(EmailError::InvalidDkim("missing DKIM-Signature header"))
  }
  Err(last_err)
}

///|
pub fn dkim_verify_rsa(
  raw_email : Bytes,
  key : crypto::RsaPublicKey,
) -> Result[DkimSignature, EmailError] {
  let (headers, body_off) = match parse_headers(raw_email, EmailLimits::default()) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let raw_body = raw_email.slice(body_off, raw_email.length())
  let mut found = false
  let mut last_err = EmailError::InvalidDkim("missing DKIM-Signature header")
  let mut i = 0
  while i < headers.length() {
    if hdr_eq_ignore_case(headers[i].name, "DKIM-Signature") {
      found = true
      match dkim_prepare_verify_one(headers, raw_body, headers[i], true) {
        Ok((sig, signing_input)) =>
        match crypto::rsa_verify_rs256(key, signing_input, sig.signature) {
          Ok(_) => return Ok(sig)
          Err(_) => last_err = EmailError::DkimVerifyFailed("rsa-sha256 signature verification failed")
        }
        Err(e) => last_err = e
      }
    }
    i = i + 1
  }
  if !found {
    return Err(EmailError::InvalidDkim("missing DKIM-Signature header"))
  }
  Err(last_err)
}

///| Verify an `rsa-sha256` DKIM signature using an SPKI DER public key (1024..4096 bits per RFC 8301 §3.2).
///| Strictly rejects keys smaller than 1024 bits (e.g. 512-bit) or larger than 4096 bits.
pub fn dkim_verify_rsa_spki_der(
  raw_email : Bytes,
  spki_der : Bytes,
) -> Result[DkimSignature, EmailError] {
  // Validate key format and bit length upfront
  let (n_bytes, _) = match dkim_parse_rsa_spki_der(spki_der) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let n_bits = dkim_be_bit_len(n_bytes)
  if n_bits < 1024 || n_bits > 4096 {
    return Err(EmailError::InvalidDkim("RSA key size must be 1024..4096 bits"))
  }
  let (headers, body_off) = match parse_headers(raw_email, EmailLimits::default()) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let raw_body = raw_email.slice(body_off, raw_email.length())
  let mut found = false
  let mut last_err = EmailError::InvalidDkim("missing DKIM-Signature header")
  let mut i = 0
  while i < headers.length() {
    if hdr_eq_ignore_case(headers[i].name, "DKIM-Signature") {
      found = true
      match dkim_prepare_verify_one(headers, raw_body, headers[i], true) {
        Ok((sig, signing_input)) =>
        match dkim_rsa_verify_rs256_spki_der(spki_der, signing_input, sig.signature) {
          Ok(_) => return Ok(sig)
          Err(e) => last_err = e
        }
        Err(e) => last_err = e
      }
    }
    i = i + 1
  }
  if !found {
    return Err(EmailError::InvalidDkim("missing DKIM-Signature header"))
  }
  Err(last_err)
}
