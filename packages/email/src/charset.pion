  "P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P/9P" +
  "/9P/9P/9"
}

///|
fn cs_b64_val(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  } else if c >= 97 && c <= 122 {
    c - 71
  } else if c >= 48 && c <= 57 {
    c + 4
  } else if c == 43 {
    62
  } else if c == 47 {
    63
  } else {
    -1
  }
}

///|
fn cs_table_cp(tbl : String, idx : Int) -> Int {
  let o = idx * 3
  if o + 2 >= tbl.length() {
    return 0xFFFD
  }
  let a = cs_b64_val(tbl.code_unit_at(o))
  let b = cs_b64_val(tbl.code_unit_at(o + 1))
  let c = cs_b64_val(tbl.code_unit_at(o + 2))
  (a << 12) | (b << 6) | c
}

///|
fn cs_write_utf8(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    sb.write_byte((0xEF).to_byte())
    sb.write_byte((0xBF).to_byte())
    sb.write_byte((0xBD).to_byte())
  } else if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///|
fn cs_is_valid_utf8(b : Bytes) -> Bool {
  let n = b.length()
  let mut i = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if c < 0x80 {
      i = i + 1
    } else if c >= 0xC2 && c <= 0xDF {
      if i + 1 >= n || (b[i + 1].to_int() & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if c >= 0xE0 && c <= 0xEF {
      if i + 2 >= n {
        return false
      }
      let c1 = b[i + 1].to_int() & 0xFF
      let c2 = b[i + 2].to_int() & 0xFF
      if (c1 & 0xC0) != 0x80 || (c2 & 0xC0) != 0x80 {
        return false
      }
      if (c == 0xE0 && c1 < 0xA0) || (c == 0xED && c1 >= 0xA0) {
        return false
      }
      i = i + 3
    } else if c >= 0xF0 && c <= 0xF4 {
      if i + 3 >= n {
        return false
      }
      let c1 = b[i + 1].to_int() & 0xFF
      let c2 = b[i + 2].to_int() & 0xFF
      let c3 = b[i + 3].to_int() & 0xFF
      if (c1 & 0xC0) != 0x80 || (c2 & 0xC0) != 0x80 || (c3 & 0xC0) != 0x80 {
        return false
      }
      if (c == 0xF0 && c1 < 0x90) || (c == 0xF4 && c1 >= 0x90) {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///|
fn cs_decode_utf8_lossy(b : Bytes) -> String {
  if cs_is_valid_utf8(b) {
    return b.to_string()
  }
  let n = b.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if c < 0x80 {
      sb.write_byte(b[i])
      i = i + 1
    } else if c >= 0xC2 && c <= 0xDF && i + 1 < n && (b[i + 1].to_int() & 0xC0) == 0x80 {
      sb.write_byte(b[i])
      sb.write_byte(b[i + 1])
      i = i + 2
    } else if c >= 0xE0 && c <= 0xEF && i + 2 < n {
      let c1 = b[i + 1].to_int() & 0xFF
      let c2 = b[i + 2].to_int() & 0xFF
      if (c1 & 0xC0) == 0x80 && (c2 & 0xC0) == 0x80 &&
      !(c == 0xE0 && c1 < 0xA0) && !(c == 0xED && c1 >= 0xA0) {
        sb.write_byte(b[i])
        sb.write_byte(b[i + 1])
        sb.write_byte(b[i + 2])
        i = i + 3
      } else {
        cs_write_utf8(sb, 0xFFFD)
        i = i + 1
      }
    } else if c >= 0xF0 && c <= 0xF4 && i + 3 < n {
      let c1 = b[i + 1].to_int() & 0xFF
      let c2 = b[i + 2].to_int() & 0xFF
      let c3 = b[i + 3].to_int() & 0xFF
      if (c1 & 0xC0) == 0x80 && (c2 & 0xC0) == 0x80 && (c3 & 0xC0) == 0x80 &&
      !(c == 0xF0 && c1 < 0x90) && !(c == 0xF4 && c1 >= 0x90) {
        sb.write_byte(b[i])
        sb.write_byte(b[i + 1])
        sb.write_byte(b[i + 2])
        sb.write_byte(b[i + 3])
        i = i + 4
      } else {
        cs_write_utf8(sb, 0xFFFD)
        i = i + 1
      }
    } else {
      cs_write_utf8(sb, 0xFFFD)
      i = i + 1
    }
  }
  sb.to_string()
}

///|
fn cs_norm_name(charset : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  let len = charset.length()
  while i < len {
    let c = charset.code_unit_at(i)
    if c == 42 {
      // RFC 2231 language tag suffix (*lang)
      break
    }
    if c != 45 && c != 95 && c != 32 && c != 9 {
      sb.write_byte(hdr_ascii_lower(c).to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn cs_kind(charset : String) -> Int {
  // 0=utf8/ascii, 1=iso-8859-1, 2=iso-8859-15, 3=windows-1252, 4=koi8-r, 5=gb2312/gbk, 6=shift_jis, -1=unknown
  let n = cs_norm_name(charset)
  if n == "" || n == "utf8" || n == "usascii" || n == "ascii" || n == "ansix341968" {
    0
  } else if n == "iso88591" || n == "latin1" || n == "l1" || n == "cp819" || n == "ibm819" {
    1
  } else if n == "iso885915" || n == "latin9" || n == "l9" {
    2
  } else if n == "windows1252" || n == "cp1252" || n == "xcp1252" {
    3
  } else if n == "koi8r" || n == "cskoi8r" {
    4
  } else if n == "gb2312" || n == "gbk" || n == "gb18030" || n == "gb231280" || n == "csgb2312" || n == "chinese" || n == "euccn" || n == "cp936" || n == "ms936" {
    5
  } else if n == "shiftjis" || n == "sjis" || n == "mskanji" || n == "csshiftjis" || n == "cp932" || n == "windows31j" {
    6
  } else {
    -1
  }
}

///|
pub fn decode_charset_to_utf8(data : Bytes, charset : String) -> String {
  let kind = cs_kind(charset)
  if kind == 0 || kind < 0 {
    return cs_decode_utf8_lossy(data)
  }
  let n = data.length()
  let sb = StringBuilder::new()
  if kind == 1 {
    // ISO-8859-1
    let mut i = 0
    while i < n {
      cs_write_utf8(sb, data[i].to_int() & 0xFF)
      i = i + 1
    }
    return sb.to_string()
  }
  if kind == 2 {
    // ISO-8859-15
    let mut i = 0
    while i < n {
      let b = data[i].to_int() & 0xFF
      let cp = if b == 0xA4 {
        0x20AC
      } else if b == 0xA6 {
        0x0160
      } else if b == 0xA8 {
        0x0161
      } else if b == 0xB4 {
        0x017D
      } else if b == 0xB8 {
        0x017E
      } else if b == 0xBC {
        0x0152
      } else if b == 0xBD {
        0x0153
      } else if b == 0xBE {
        0x0178
      } else {
        b
      }
      cs_write_utf8(sb, cp)
      i = i + 1
    }
    return sb.to_string()
  }
  if kind == 3 {
    // Windows-1252
    let tbl = cs_tbl_cp1252()
    let mut i = 0
    while i < n {
      let b = data[i].to_int() & 0xFF
      let cp = if b >= 0x80 && b <= 0x9F {
        cs_table_cp(tbl, b - 0x80)
      } else {
        b
      }
      cs_write_utf8(sb, cp)
      i = i + 1
    }
    return sb.to_string()
  }
  if kind == 4 {
    // KOI8-R
    let tbl = cs_tbl_koi8r()
    let mut i = 0
    while i < n {
      let b = data[i].to_int() & 0xFF
      let cp = if b >= 0x80 {
        cs_table_cp(tbl, b - 0x80)
      } else {
        b
      }
      cs_write_utf8(sb, cp)
      i = i + 1
    }
    return sb.to_string()
  }
  if kind == 5 {
    // GB2312 / GBK / GB18030
    let tbl = cs_tbl_gb2312()
    let mut i = 0
    while i < n {
      let b1 = data[i].to_int() & 0xFF
      if b1 < 0x80 {
        sb.write_byte(b1.to_byte())
        i = i + 1
      } else if b1 == 0x80 {
        cs_write_utf8(sb, 0x20AC)
        i = i + 1
      } else if b1 >= 0xA1 && b1 <= 0xFE && i + 1 < n {
        let b2 = data[i + 1].to_int() & 0xFF
        if b2 >= 0xA1 && b2 <= 0xFE {
          let cp = cs_table_cp(tbl, (b1 - 0xA1) * 94 + (b2 - 0xA1))
          cs_write_utf8(sb, cp)
          i = i + 2
        } else {
          cs_write_utf8(sb, 0xFFFD)
          i = i + 1
        }
      } else {
        cs_write_utf8(sb, 0xFFFD)
        i = i + 1
      }
    }
    return sb.to_string()
  }
  // kind == 6: Shift_JIS
  let tbl = cs_tbl_sjis()
  let mut i = 0
  while i < n {
    let b1 = data[i].to_int() & 0xFF
    if b1 < 0x80 {
      sb.write_byte(b1.to_byte())
      i = i + 1
    } else if b1 >= 0xA1 && b1 <= 0xDF {
      cs_write_utf8(sb, 0xFF61 + (b1 - 0xA1))
      i = i + 1
    } else if ((b1 >= 0x81 && b1 <= 0x9F) || (b1 >= 0xE0 && b1 <= 0xFC)) && i + 1 < n {
      let b2 = data[i + 1].to_int() & 0xFF
      if (b2 >= 0x40 && b2 <= 0x7E) || (b2 >= 0x80 && b2 <= 0xFC) {
        let base_r = if b1 <= 0x9F { (b1 - 0x81) * 2 } else { (b1 - 0xC1) * 2 }
        let (r, c) = if b2 >= 0x9F {
          (base_r + 1, b2 - 0x9F)
        } else {
          (base_r, if b2 < 0x7F { b2 - 0x40 } else { b2 - 0x41 })
        }
        if r >= 0 && r < 94 && c >= 0 && c < 94 {
          cs_write_utf8(sb, cs_table_cp(tbl, r * 94 + c))
        } else {
          cs_write_utf8(sb, 0xFFFD)
        }
        i = i + 2
      } else {
        cs_write_utf8(sb, 0xFFFD)
        i = i + 1
      }
    } else {
      cs_write_utf8(sb, 0xFFFD)
      i = i + 1
    }
  }
  sb.to_string()
}

///|
fn cs_hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

///|
fn cs_decode_b_strict(s : String, start : Int, end : Int) -> Option[Array[Byte]] {
  let out : Array[Byte] = []
  let mut buf = 0
  let mut bits = 0
  let mut pad = 0
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c == 61 {
      pad = pad + 1
      if pad > 2 {
        return None
      }
    } else {
      if pad > 0 {
        return None
      }
      let v = cs_b64_val(c)
      if v < 0 {
        return None
      }
      buf = (buf << 6) | v
      bits = bits + 6
      if bits >= 8 {
        bits = bits - 8
        out.push(((buf >> bits) & 0xFF).to_byte())
      }
    }
    i = i + 1
  }
  if (end - start) % 4 == 1 {
    return None
  }
  Some(out)
}

///|
fn cs_decode_q(s : String, start : Int, end : Int) -> Option[Array[Byte]] {
  let out : Array[Byte] = []
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c == 95 {
      out.push((32).to_byte())
      i = i + 1
    } else if c == 61 {
      if i + 2 >= end {
        return None
      }
      let hi = cs_hex_val(s.code_unit_at(i + 1))
      let lo = cs_hex_val(s.code_unit_at(i + 2))
      if hi < 0 || lo < 0 {
        return None
      }
      out.push(((hi << 4) | lo).to_byte())
      i = i + 3
    } else if c == 32 || c == 9 || c == 13 || c == 10 {
      return None
    } else {
      out.push(c.to_byte())
      i = i + 1
    }
  }
  Some(out)
}

///|
fn cs_flush_pending(sb : StringBuilder, pending_cs : String, pending : Array[Byte]) -> Unit {
  if pending.length() == 0 {
    return ()
  }
  let b = Bytes::new(pending.length())
  let mut i = 0
  while i < pending.length() {
    b[i] = pending[i]
    i = i + 1
  }
  sb.write_string(decode_charset_to_utf8(b, pending_cs))
}

///| Decode RFC 2047 encoded-words with multi-charset support and adjacent-word byte merging.
pub fn email_decode_rfc2047(input : String) -> String {
  if !input.contains("=?") {
    return input
  }
  let len = input.length()
  let sb = StringBuilder::new()
  let mut pending_cs = ""
  let mut pending : Array[Byte] = []
  let mut had_ew = false
  let mut ws_start = -1
  let mut i = 0
  while i < len {
    // Try parsing =?charset?enc?text?=
    if i + 6 < len && input.code_unit_at(i) == 61 && input.code_unit_at(i + 1) == 63 {
      let mut q1 = i + 2
      while q1 < len && input.code_unit_at(q1) != 63 && input.code_unit_at(q1) != 32 && input.code_unit_at(q1) != 9 {
        q1 = q1 + 1
      }
      if q1 > i + 2 && q1 + 2 < len && input.code_unit_at(q1) == 63 && input.code_unit_at(q1 + 2) == 63 {
        let enc_c = hdr_ascii_lower(input.code_unit_at(q1 + 1))
        let text_start = q1 + 3
        let mut q3 = text_start
        while q3 + 1 < len && !(input.code_unit_at(q3) == 63 && input.code_unit_at(q3 + 1) == 61) {
          let tc = input.code_unit_at(q3)
          if tc == 32 || tc == 9 || tc == 13 || tc == 10 {
            break
          }
          q3 = q3 + 1
        }
        if q3 + 1 < len && input.code_unit_at(q3) == 63 && input.code_unit_at(q3 + 1) == 61 {
          let cs_raw = input.slice(i + 2, q1)
          let kind = cs_kind(cs_raw)
          if kind >= 0 && (enc_c == 98 || enc_c == 113) {
            let dec_opt = if enc_c == 98 {
              cs_decode_b_strict(input, text_start, q3)
            } else {
              cs_decode_q(input, text_start, q3)
            }
            match dec_opt {
              Some(bytes_arr) => {
                let norm_cs = cs_norm_name(cs_raw)
                if had_ew && pending_cs == norm_cs {
                  let mut bi = 0
                  while bi < bytes_arr.length() {
                    pending.push(bytes_arr[bi])
                    bi = bi + 1
                  }
                } else {
                  cs_flush_pending(sb, pending_cs, pending)
                  pending = bytes_arr
                  pending_cs = norm_cs
                }
                had_ew = true
                ws_start = -1
                i = q3 + 2
                continue
              }
              None => ()
            }
          }
        }
      }
    }

    // Check if we are in linear whitespace right after a decoded encoded-word
    let c = input.code_unit_at(i)
    if had_ew && (c == 32 || c == 9 || c == 13 || c == 10) {
      if ws_start < 0 {
        ws_start = i
      }
      i = i + 1
      continue
    }

    // Non-encoded-word character: flush pending decoded bytes and any deferred whitespace
    if had_ew {
      cs_flush_pending(sb, pending_cs, pending)
      pending = []
      pending_cs = ""
      had_ew = false
      if ws_start >= 0 {
        sb.write_string(input.slice(ws_start, i))
        ws_start = -1
      }
    }
    sb.write_byte(c.to_byte())
    i = i + 1
  }

  if had_ew {
    cs_flush_pending(sb, pending_cs, pending)
    if ws_start >= 0 {
      sb.write_string(input.slice(ws_start, len))
    }
  }
  sb.to_string()
}

///| Encode a header value as folded RFC 2047 UTF-8 Base64 encoded-words so every line <= max_line.
fn email_encode_rfc2047_b_folded(name : String, value : String, max_line : Int) -> String {
  let b = value.to_bytes()
  let n = b.length()
  let sb = StringBuilder::new()
  sb.write_string(name)
  sb.write_string(": ")
  let mut pos = 0
  let mut first = true
  while pos < n {
    let overhead = if first { name.length() + 2 + 12 } else { 1 + 12 }
    // Each encoded-word itself must be <= 75 chars, and line must be <= max_line (e.g. 76/78)
    let cap_line = max_line - overhead
    let cap_ew = 75 - 12
    let b64_budget = if cap_line < cap_ew { cap_line } else { cap_ew }
    let mut max_raw = (b64_budget / 4) * 3
    if max_raw < 3 {
      max_raw = 3
    }
    let mut end = if pos + max_raw < n { pos + max_raw } else { n }
    // Do not split in the middle of a UTF-8 multi-byte sequence
    if end < n {
      while end > pos && (b[end].to_int() & 0xC0) == 0x80 {
        end = end - 1
      }
      if end == pos {
        // Single code point longer than max_raw (impossible for UTF-8 <= 4 bytes when max_raw >= 4)
        end = pos + 1
        while end < n && (b[end].to_int() & 0xC0) == 0x80 {
          end = end + 1
        }
      }
    }
    if !first {
      sb.write_string("\r\n ")
    }
    sb.write_string("=?UTF-8?B?")
    sb.write_string(base64::encode(b.slice(pos, end)))
    sb.write_string("?=")
    first = false
    pos = end
  }
  sb.to_string()
}
