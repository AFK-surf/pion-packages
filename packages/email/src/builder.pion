///| Fluent, injection-safe RFC 5322 / MIME email builder.

import "mime"
import "base64"

///|
pub struct BuilderAttachment {
  filename : String
  content_type : String
  content_id : Option[String]
  is_inline : Bool
  data : Bytes
}

///|
pub struct EmailBuilder {
  mut from_list : Array[Mailbox]
  mut to_list : Array[Mailbox]
  mut cc_list : Array[Mailbox]
  mut reply_to_list : Array[Mailbox]
  mut subject_val : Option[String]
  mut message_id_val : Option[String]
  mut date_val : Option[EmailDate]
  mut extra_headers : Array[Header]
  mut text_val : Option[String]
  mut html_val : Option[String]
  mut parts : Array[BuilderAttachment]
  mut boundary_seed_val : String
}

///|
pub fn EmailBuilder::new() -> EmailBuilder {
  EmailBuilder::{
    from_list: [],
    to_list: [],
    cc_list: [],
    reply_to_list: [],
    subject_val: None,
    message_id_val: None,
    date_val: None,
    extra_headers: [],
    text_val: None,
    html_val: None,
    parts: [],
    boundary_seed_val: "pion-email-boundary",
  }
}

///|
pub fn EmailBuilder::from(self : EmailBuilder, mb : Mailbox) -> EmailBuilder {
  self.from_list.push(mb)
  self
}

///|
pub fn EmailBuilder::to(self : EmailBuilder, mb : Mailbox) -> EmailBuilder {
  self.to_list.push(mb)
  self
}

///|
pub fn EmailBuilder::cc(self : EmailBuilder, mb : Mailbox) -> EmailBuilder {
  self.cc_list.push(mb)
  self
}

///|
pub fn EmailBuilder::reply_to(self : EmailBuilder, mb : Mailbox) -> EmailBuilder {
  self.reply_to_list.push(mb)
  self
}

///|
pub fn EmailBuilder::subject(self : EmailBuilder, subj : String) -> EmailBuilder {
  self.subject_val = Some(subj)
  self
}

///|
pub fn EmailBuilder::message_id(self : EmailBuilder, id : String) -> EmailBuilder {
  self.message_id_val = Some(id)
  self
}

///|
pub fn EmailBuilder::date(self : EmailBuilder, d : EmailDate) -> EmailBuilder {
  self.date_val = Some(d)
  self
}

///|
pub fn EmailBuilder::header(
  self : EmailBuilder,
  name : String,
  value : String,
) -> EmailBuilder {
  self.extra_headers.push(Header::new(name, value))
  self
}

///|
pub fn EmailBuilder::text_body(self : EmailBuilder, text : String) -> EmailBuilder {
  self.text_val = Some(text)
  self
}

///|
pub fn EmailBuilder::html_body(self : EmailBuilder, html : String) -> EmailBuilder {
  self.html_val = Some(html)
  self
}

///|
pub fn EmailBuilder::attach(
  self : EmailBuilder,
  filename : String,
  content_type : String,
  data : Bytes,
) -> EmailBuilder {
  self.parts.push(
    BuilderAttachment::{
      filename: filename,
      content_type: content_type,
      content_id: None,
      is_inline: false,
      data: data,
    },
  )
  self
}

///|
pub fn EmailBuilder::inline_part(
  self : EmailBuilder,
  cid : String,
  filename : String,
  content_type : String,
  data : Bytes,
) -> EmailBuilder {
  self.parts.push(
    BuilderAttachment::{
      filename: filename,
      content_type: content_type,
      content_id: Some(cid),
      is_inline: true,
      data: data,
    },
  )
  self
}

///|
pub fn EmailBuilder::boundary_seed(self : EmailBuilder, seed : String) -> EmailBuilder {
  self.boundary_seed_val = seed
  self
}

///|
fn bld_format_mailboxes(list : Array[Mailbox]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < list.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(list[i].format())
    i = i + 1
  }
  sb.to_string()
}

///|
fn bld_encode_b64_wrapped(data : Bytes) -> String {
  let b64 = base64::encode(data)
  let len = b64.length()
  if len <= 76 {
    return b64
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    if i > 0 {
      sb.write_string("\r\n")
    }
    let end = if i + 76 < len { i + 76 } else { len }
    sb.write_string(b64.slice(i, end))
    i = end
  }
  sb.to_string()
}

///|
fn bld_write_text_part(sb : StringBuilder, ctype : String, content : String) -> Unit {
  sb.write_string("Content-Type: ")
  sb.write_string(ctype)
  sb.write_string("; charset=\"utf-8\"\r\n")
  sb.write_string("Content-Transfer-Encoding: base64\r\n\r\n")
  sb.write_string(bld_encode_b64_wrapped(content.to_bytes()))
}

///| Validate RFC 2046 §5.1.1 boundary seed (`bcharsnospace`, length 1..66 so `-alt`/`-rel`/`-mix` <= 70).
fn bld_validate_boundary_seed(seed : String) -> Result[Unit, EmailError] {
  match validate_header_value(seed) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let len = seed.length()
  if len == 0 || len > 66 {
    return Err(EmailError::InvalidMime("boundary seed length must be 1..66"))
  }
  let mut i = 0
  while i < len {
    let c = seed.code_unit_at(i)
    let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
    c == 39 || c == 40 || c == 41 || c == 43 || c == 95 || c == 44 || c == 45 ||
    c == 46 || c == 47 || c == 58 || c == 61 || c == 63
    if !ok {
      return Err(EmailError::InvalidMime("illegal character in boundary seed"))
    }
    i = i + 1
  }
  Ok(())
}

///|
fn bld_write_attachment_part(
  sb : StringBuilder,
  att : BuilderAttachment,
) -> Result[Unit, EmailError] {
  match validate_header_value(att.content_type) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match mime::parse_media_type(att.content_type) {
    Ok(mt) =>
    if msg_is_multipart(mt.essence()) {
      return Err(EmailError::InvalidMime("attachment content-type must not be multipart/*"))
    }
    Err(_) => return Err(EmailError::InvalidMime("invalid attachment content-type"))
  }
  match validate_header_value(att.filename) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  sb.write_string("Content-Type: ")
  sb.write_string(att.content_type)
  sb.write_string("\r\n")
  let disp = if att.is_inline { "inline" } else { "attachment" }
  let cd = match mime::format_content_disposition(disp, [mime::Param::new("filename", att.filename)]) {
    Ok(s) => s
    Err(e) => return Err(EmailError::InvalidMime(e.to_string()))
  }
  sb.write_string("Content-Disposition: ")
  sb.write_string(cd)
  sb.write_string("\r\n")
  match att.content_id {
    Some(cid) => {
      match validate_header_value(cid) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string("Content-ID: <")
      sb.write_string(cid)
      sb.write_string(">\r\n")
    }
    None => ()
  }
  sb.write_string("Content-Transfer-Encoding: base64\r\n\r\n")
  sb.write_string(bld_encode_b64_wrapped(att.data))
  Ok(())
}

///|
fn bld_build_body_section(
  self : EmailBuilder,
) -> Result[(String, String), EmailError] {
  // Separate inline parts vs regular attachments
  let inlines : Array[BuilderAttachment] = []
  let atts : Array[BuilderAttachment] = []
  let mut i = 0
  while i < self.parts.length() {
    if self.parts[i].is_inline {
      inlines.push(self.parts[i])
    } else {
      atts.push(self.parts[i])
    }
    i = i + 1
  }

  let seed = self.boundary_seed_val
  // 1. Build core text/html content (may be single part or multipart/alternative)
  let (core_ct, core_body) = match (self.text_val, self.html_val) {
    (Some(t), Some(h)) => {
      let b_alt = seed + "-alt"
      let sb = StringBuilder::new()
      sb.write_string("--")
      sb.write_string(b_alt)
      sb.write_string("\r\n")
      bld_write_text_part(sb, "text/plain", t)
      sb.write_string("\r\n--")
      sb.write_string(b_alt)
      sb.write_string("\r\n")
      bld_write_text_part(sb, "text/html", h)
      sb.write_string("\r\n--")
      sb.write_string(b_alt)
      sb.write_string("--\r\n")
      ("multipart/alternative; boundary=\"" + b_alt + "\"", sb.to_string())
    }
    (Some(t), None) => {
      let sb = StringBuilder::new()
      sb.write_string(bld_encode_b64_wrapped(t.to_bytes()))
      ("text/plain; charset=\"utf-8\"\r\nContent-Transfer-Encoding: base64", sb.to_string())
    }
    (None, Some(h)) => {
      let sb = StringBuilder::new()
      sb.write_string(bld_encode_b64_wrapped(h.to_bytes()))
      ("text/html; charset=\"utf-8\"\r\nContent-Transfer-Encoding: base64", sb.to_string())
    }
    _ =>
    ("text/plain; charset=\"utf-8\"\r\nContent-Transfer-Encoding: 7bit", "")
  }

  // 2. Wrap with multipart/related if inline parts exist
  let (rel_ct, rel_body) = if inlines.length() > 0 {
    let b_rel = seed + "-rel"
    let sb = StringBuilder::new()
    sb.write_string("--")
    sb.write_string(b_rel)
    sb.write_string("\r\nContent-Type: ")
    sb.write_string(core_ct)
    sb.write_string("\r\n\r\n")
    sb.write_string(core_body)
    let mut k = 0
    while k < inlines.length() {
      sb.write_string("\r\n--")
      sb.write_string(b_rel)
      sb.write_string("\r\n")
      match bld_write_attachment_part(sb, inlines[k]) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      k = k + 1
    }
    sb.write_string("\r\n--")
    sb.write_string(b_rel)
    sb.write_string("--\r\n")
    ("multipart/related; boundary=\"" + b_rel + "\"", sb.to_string())
  } else {
    (core_ct, core_body)
  }

  // 3. Wrap with multipart/mixed if regular attachments exist
  if atts.length() > 0 {
    let b_mix = seed + "-mix"
    let sb = StringBuilder::new()
    sb.write_string("--")
    sb.write_string(b_mix)
    sb.write_string("\r\nContent-Type: ")
    sb.write_string(rel_ct)
    sb.write_string("\r\n\r\n")
    sb.write_string(rel_body)
    let mut k = 0
    while k < atts.length() {
      sb.write_string("\r\n--")
      sb.write_string(b_mix)
      sb.write_string("\r\n")
      match bld_write_attachment_part(sb, atts[k]) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      k = k + 1
    }
    sb.write_string("\r\n--")
    sb.write_string(b_mix)
    sb.write_string("--\r\n")
    Ok(("multipart/mixed; boundary=\"" + b_mix + "\"", sb.to_string()))
  } else {
    Ok((rel_ct, rel_body))
  }
}

///|
pub fn EmailBuilder::build(self : EmailBuilder) -> Result[Bytes, EmailError] {
  match bld_validate_boundary_seed(self.boundary_seed_val) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let sb = StringBuilder::new()

  if self.from_list.length() > 0 {
    sb.write_string(fold_header_line("From", bld_format_mailboxes(self.from_list), 78))
    sb.write_string("\r\n")
  }
  if self.to_list.length() > 0 {
    sb.write_string(fold_header_line("To", bld_format_mailboxes(self.to_list), 78))
    sb.write_string("\r\n")
  }
  if self.cc_list.length() > 0 {
    sb.write_string(fold_header_line("Cc", bld_format_mailboxes(self.cc_list), 78))
    sb.write_string("\r\n")
  }
  if self.reply_to_list.length() > 0 {
    sb.write_string(fold_header_line("Reply-To", bld_format_mailboxes(self.reply_to_list), 78))
    sb.write_string("\r\n")
  }
  match self.subject_val {
    Some(subj) => {
      match validate_header_value(subj) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if addr_has_non_ascii(subj) {
        sb.write_string(email_encode_rfc2047_b_folded("Subject", subj, 76))
      } else {
        sb.write_string(fold_header_line("Subject", subj, 78))
      }
      sb.write_string("\r\n")
    }
    None => ()
  }
  match self.date_val {
    Some(d) => {
      sb.write_string("Date: ")
      sb.write_string(d.format())
      sb.write_string("\r\n")
    }
    None => ()
  }
  match self.message_id_val {
    Some(mid) => {
      match validate_header_value(mid) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      sb.write_string("Message-ID: ")
      sb.write_string(mid)
      sb.write_string("\r\n")
    }
    None => ()
  }

  let mut hi = 0
  while hi < self.extra_headers.length() {
    let h = self.extra_headers[hi]
    match validate_header_name(h.name) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match validate_header_value(h.raw_value) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sb.write_string(fold_header_line(h.name, h.raw_value, 78))
    sb.write_string("\r\n")
    hi = hi + 1
  }

  sb.write_string("MIME-Version: 1.0\r\n")
  let (ct_header, body) = match bld_build_body_section(self) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  sb.write_string("Content-Type: ")
  sb.write_string(ct_header)
  sb.write_string("\r\n\r\n")
  sb.write_string(body)
  Ok(sb.to_string().to_bytes())
}
