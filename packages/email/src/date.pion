///| RFC 5322 date-time parser and formatter backed by `packages/time`.

import "time"

///|
pub val struct EmailDate {
  year : Int
  month : Int
  day : Int
  hour : Int
  minute : Int
  second : Int
  offset_seconds : Int
  unknown_local_offset : Bool
  timestamp : Int64
}

///|
#verify
pub fn dt_is_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

///|
pub fn dt_lower(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

///| RFC 5322 §4.3 2/3/4-digit year normalization.
pub fn dt_normalize_year(year : Int, ydigits : Int) -> Int {
  if ydigits == 2 {
    if year <= 49 {
      year + 2000
    } else {
      year + 1900
    }
  } else if ydigits == 3 {
    year + 1900
  } else {
    year
  }
}

///| RFC 5322 §3.3 numeric timezone offset validity (`[-23:59, +23:59]`).
#verify
pub fn dt_is_valid_offset_seconds(offset_seconds : Int) -> Bool {
  offset_seconds >= -86340 && offset_seconds <= 86340
}

///| Convert numeric timezone `sign` (`+`=43 / `-`=45), `hh`, `mm` to signed offset seconds.
#verify
pub fn dt_numeric_offset_seconds(sign : Int, hh : Int, mm : Int) -> Int {
  let mag = hh * 3600 + mm * 60
  if sign == 45 {
    -mag
  } else {
    mag
  }
}

///| Clamp RFC 5322 leap second `60` to `59`.
pub fn dt_clamp_leap_second(sec : Int) -> Int {
  if sec == 60 {
    59
  } else {
    sec
  }
}

///| Euclidean floor day count from local Unix seconds (`floor(local_sec / 86400)`).
#verify
pub fn dt_epoch_floor_day(local_sec : Int64) -> Int64 {
  let days = local_sec / 86400L
  let rem = local_sec % 86400L
  if rem < 0L {
    days - 1L
  } else {
    days
  }
}

///| Euclidean non-negative second-of-day remainder (`local_sec mod 86400` in `[0, 86399]`).
#verify
pub fn dt_epoch_rem_sec(local_sec : Int64) -> Int64 {
  let rem = local_sec % 86400L
  if rem < 0L {
    rem + 86400L
  } else {
    rem
  }
}

///| Zero-boxing CFWS skipper: returns `>= 0` new pos, `-1` unclosed comment, `-2` nesting limit exceeded.
fn dt_skip_cfws_fast(s : String, start : Int, len : Int) -> Int {
  let mut pos = start
  while pos < len {
    let c = s.code_unit_at(pos)
    if c == 32 || c == 9 {
      pos = pos + 1
    } else if c == 40 {
      pos = pos + 1
      let mut depth = 1
      let mut esc = false
      while pos < len && depth > 0 {
        let ch = s.code_unit_at(pos)
        pos = pos + 1
        if esc {
          esc = false
        } else if ch == 92 {
          esc = true
        } else if ch == 40 {
          depth = depth + 1
          if depth > 64 {
            return -2
          }
        } else if ch == 41 {
          depth = depth - 1
        }
      }
      if depth != 0 {
        return -1
      }
    } else {
      break
    }
  }
  pos
}

///|
fn dt_cfws_err(code : Int) -> EmailError {
  if code == -2 {
    EmailError::LimitExceeded("date comment nesting too deep")
  } else {
    EmailError::InvalidDate("unclosed comment in date")
  }
}

///|
fn dt_parse_weekday(s : String, pos : Int) -> Option[time::Weekday] {
  if pos + 3 > s.length() {
    return None
  }
  let key = (dt_lower(s.code_unit_at(pos)) << 16) |
  (dt_lower(s.code_unit_at(pos + 1)) << 8) |
  dt_lower(s.code_unit_at(pos + 2))
  match key {
    0x6d6f6e => Some(time::Weekday::Mon) // "mon"
    0x747565 => Some(time::Weekday::Tue) // "tue"
    0x776564 => Some(time::Weekday::Wed) // "wed"
    0x746875 => Some(time::Weekday::Thu) // "thu"
    0x667269 => Some(time::Weekday::Fri) // "fri"
    0x736174 => Some(time::Weekday::Sat) // "sat"
    0x73756e => Some(time::Weekday::Sun) // "sun"
    _ => None
  }
}

///|
fn dt_parse_month(s : String, pos : Int) -> Int {
  if pos + 3 > s.length() {
    return -1
  }
  let key = (dt_lower(s.code_unit_at(pos)) << 16) |
  (dt_lower(s.code_unit_at(pos + 1)) << 8) |
  dt_lower(s.code_unit_at(pos + 2))
  match key {
    0x6a616e => 1 // "jan"
    0x666562 => 2 // "feb"
    0x6d6172 => 3 // "mar"
    0x617072 => 4 // "apr"
    0x6d6179 => 5 // "may"
    0x6a756e => 6 // "jun"
    0x6a756c => 7 // "jul"
    0x617567 => 8 // "aug"
    0x736570 => 9 // "sep"
    0x6f6374 => 10 // "oct"
    0x6e6f76 => 11 // "nov"
    0x646563 => 12 // "dec"
    _ => -1
  }
}

///|
fn dt_month_name(m : Int) -> String {
  match m {
    1 => "Jan"
    2 => "Feb"
    3 => "Mar"
    4 => "Apr"
    5 => "May"
    6 => "Jun"
    7 => "Jul"
    8 => "Aug"
    9 => "Sep"
    10 => "Oct"
    11 => "Nov"
    12 => "Dec"
    _ => "Jan"
  }
}

///|
fn dt_write_2d(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte((48 + (v / 10) % 10).to_byte())
  sb.write_byte((48 + v % 10).to_byte())
}

///|
fn dt_write_4d(sb : StringBuilder, v : Int) -> Unit {
  sb.write_byte((48 + (v / 1000) % 10).to_byte())
  sb.write_byte((48 + (v / 100) % 10).to_byte())
  sb.write_byte((48 + (v / 10) % 10).to_byte())
  sb.write_byte((48 + v % 10).to_byte())
}

///|
pub fn EmailDate::from_timestamp(
  ts : Int64,
  offset_seconds : Int,
) -> Result[EmailDate, EmailError] {
  if !dt_is_valid_offset_seconds(offset_seconds) {
    return Err(EmailError::InvalidDate("offset out of range"))
  }
  let local_sec = ts + offset_seconds.to_int64()
  let days = dt_epoch_floor_day(local_sec)
  let rem = dt_epoch_rem_sec(local_sec)
  let d = match time::Date::from_epoch_days(days.to_int()) {
    Ok(v) => v
    Err(_) => return Err(EmailError::InvalidDate("timestamp out of range"))
  }
  let sec_in_day = rem.to_int()
  let hour = sec_in_day / 3600
  let minute = (sec_in_day % 3600) / 60
  let second = sec_in_day % 60
  Ok(
    EmailDate::{
      year: d.year,
      month: d.month,
      day: d.day,
      hour: hour,
      minute: minute,
      second: second,
      offset_seconds: offset_seconds,
      unknown_local_offset: false,
      timestamp: ts,
    },
  )
}

///|
pub fn EmailDate::format(self : EmailDate) -> String {
  let sb = StringBuilder::new()
  match time::Date::new(self.year, self.month, self.day) {
    Ok(d) => {
      sb.write_string(time::weekday_to_short_name(d.weekday()))
      sb.write_string(", ")
    }
    Err(_) => ()
  }
  dt_write_2d(sb, self.day)
  sb.write_byte((32).to_byte())
  sb.write_string(dt_month_name(self.month))
  sb.write_byte((32).to_byte())
  dt_write_4d(sb, self.year)
  sb.write_byte((32).to_byte())
  dt_write_2d(sb, self.hour)
  sb.write_byte((58).to_byte())
  dt_write_2d(sb, self.minute)
  sb.write_byte((58).to_byte())
  dt_write_2d(sb, self.second)
  sb.write_byte((32).to_byte())
  if self.unknown_local_offset {
    sb.write_string("-0000")
  } else {
    let sign = if self.offset_seconds < 0 { 45 } else { 43 }
    let mag = if self.offset_seconds < 0 { -self.offset_seconds } else { self.offset_seconds }
    let hh = mag / 3600
    let mm = (mag % 3600) / 60
    sb.write_byte(sign.to_byte())
    dt_write_2d(sb, hh)
    dt_write_2d(sb, mm)
  }
  sb.to_string()
}

///|
pub fn parse_date(input : String) -> Result[EmailDate, EmailError] {
  let len = input.length()
  let mut k = 0
  while k < len {
    let ch = input.code_unit_at(k)
    if ch <= 13 && email_is_injection_byte(ch) {
      return Err(EmailError::HeaderInjection("CR/LF/NUL not allowed in date"))
    }
    k = k + 1
  }
  let mut pos = dt_skip_cfws_fast(input, 0, len)
  if pos < 0 {
    return Err(dt_cfws_err(pos))
  }
  if pos >= len {
    return Err(EmailError::InvalidDate("empty date"))
  }

  // Optional day-of-week
  let mut parsed_wd : Option[time::Weekday] = None
  if !dt_is_digit(input.code_unit_at(pos)) {
    match dt_parse_weekday(input, pos) {
      None => return Err(EmailError::InvalidDate("invalid weekday"))
      Some(wd) => {
        parsed_wd = Some(wd)
        pos = dt_skip_cfws_fast(input, pos + 3, len)
        if pos < 0 {
          return Err(dt_cfws_err(pos))
        }
        if pos >= len || input.code_unit_at(pos) != 44 {
          return Err(EmailError::InvalidDate("expected ',' after weekday"))
        }
        pos = dt_skip_cfws_fast(input, pos + 1, len)
        if pos < 0 {
          return Err(dt_cfws_err(pos))
        }
      }
    }
  }

  // 1 or 2 digit day
  if pos >= len || !dt_is_digit(input.code_unit_at(pos)) {
    return Err(EmailError::InvalidDate("expected day"))
  }
  let mut day = input.code_unit_at(pos) - 48
  pos = pos + 1
  if pos < len && dt_is_digit(input.code_unit_at(pos)) {
    day = day * 10 + (input.code_unit_at(pos) - 48)
    pos = pos + 1
  }
  let after_day = dt_skip_cfws_fast(input, pos, len)
  if after_day < 0 {
    return Err(dt_cfws_err(after_day))
  }
  if after_day == pos {
    return Err(EmailError::InvalidDate("expected whitespace after day"))
  }
  pos = after_day

  // 3-letter month
  let month = dt_parse_month(input, pos)
  if month < 0 {
    return Err(EmailError::InvalidDate("invalid month"))
  }
  pos = pos + 3
  let after_mon = dt_skip_cfws_fast(input, pos, len)
  if after_mon < 0 {
    return Err(dt_cfws_err(after_mon))
  }
  if after_mon == pos {
    return Err(EmailError::InvalidDate("expected whitespace after month"))
  }
  pos = after_mon

  // 2, 3, or 4 digit year
  let mut ydigits = 0
  let mut year = 0
  while pos < len && ydigits < 4 && dt_is_digit(input.code_unit_at(pos)) {
    year = year * 10 + (input.code_unit_at(pos) - 48)
    ydigits = ydigits + 1
    pos = pos + 1
  }
  if ydigits < 2 {
    return Err(EmailError::InvalidDate("year must be 2..=4 digits"))
  }
  year = dt_normalize_year(year, ydigits)
  let after_yr = dt_skip_cfws_fast(input, pos, len)
  if after_yr < 0 {
    return Err(dt_cfws_err(after_yr))
  }
  if after_yr == pos {
    return Err(EmailError::InvalidDate("expected whitespace after year"))
  }
  pos = after_yr

  // HH:MM(:SS)?
  if pos + 2 > len || !dt_is_digit(input.code_unit_at(pos)) || !dt_is_digit(input.code_unit_at(pos + 1)) {
    return Err(EmailError::InvalidDate("invalid hour"))
  }
  let hour = (input.code_unit_at(pos) - 48) * 10 + (input.code_unit_at(pos + 1) - 48)
  pos = dt_skip_cfws_fast(input, pos + 2, len)
  if pos < 0 {
    return Err(dt_cfws_err(pos))
  }
  if pos >= len || input.code_unit_at(pos) != 58 {
    return Err(EmailError::InvalidDate("expected ':' after hour"))
  }
  pos = dt_skip_cfws_fast(input, pos + 1, len)
  if pos < 0 {
    return Err(dt_cfws_err(pos))
  }
  if pos + 2 > len || !dt_is_digit(input.code_unit_at(pos)) || !dt_is_digit(input.code_unit_at(pos + 1)) {
    return Err(EmailError::InvalidDate("invalid minute"))
  }
  let minute = (input.code_unit_at(pos) - 48) * 10 + (input.code_unit_at(pos + 1) - 48)
  pos = pos + 2
  let ws_after_min = dt_skip_cfws_fast(input, pos, len)
  if ws_after_min < 0 {
    return Err(dt_cfws_err(ws_after_min))
  }
  let mut second = 0
  if ws_after_min < len && input.code_unit_at(ws_after_min) == 58 {
    pos = dt_skip_cfws_fast(input, ws_after_min + 1, len)
    if pos < 0 {
      return Err(dt_cfws_err(pos))
    }
    if pos + 2 > len || !dt_is_digit(input.code_unit_at(pos)) || !dt_is_digit(input.code_unit_at(pos + 1)) {
      return Err(EmailError::InvalidDate("invalid second"))
    }
    second = (input.code_unit_at(pos) - 48) * 10 + (input.code_unit_at(pos + 1) - 48)
    if second > 60 {
      return Err(EmailError::InvalidDate("second out of range"))
    }
    second = dt_clamp_leap_second(second)
    pos = pos + 2
    let ws_after_sec = dt_skip_cfws_fast(input, pos, len)
    if ws_after_sec < 0 {
      return Err(dt_cfws_err(ws_after_sec))
    }
    if ws_after_sec == pos {
      return Err(EmailError::InvalidDate("expected whitespace before zone"))
    }
    pos = ws_after_sec
  } else {
    if ws_after_min == pos {
      return Err(EmailError::InvalidDate("expected whitespace before zone"))
    }
    pos = ws_after_min
  }

  if hour > 23 || minute > 59 {
    return Err(EmailError::InvalidDate("time out of range"))
  }

  // Time zone
  if pos >= len {
    return Err(EmailError::InvalidDate("missing time zone"))
  }
  let mut offset_seconds = 0
  let mut unknown_local = false
  let z0 = input.code_unit_at(pos)
  if z0 == 43 || z0 == 45 {
    if pos + 5 > len {
      return Err(EmailError::InvalidDate("truncated numeric offset"))
    }
    let d1 = input.code_unit_at(pos + 1)
    let d2 = input.code_unit_at(pos + 2)
    let d3 = input.code_unit_at(pos + 3)
    let d4 = input.code_unit_at(pos + 4)
    if !dt_is_digit(d1) || !dt_is_digit(d2) || !dt_is_digit(d3) || !dt_is_digit(d4) {
      return Err(EmailError::InvalidDate("invalid numeric offset digits"))
    }
    let hh = (d1 - 48) * 10 + (d2 - 48)
    let mm = (d3 - 48) * 10 + (d4 - 48)
    if hh > 23 || mm > 59 {
      return Err(EmailError::InvalidDate("numeric offset out of range"))
    }
    let off = dt_numeric_offset_seconds(z0, hh, mm)
    if z0 == 45 && off == 0 {
      offset_seconds = 0
      unknown_local = true
    } else {
      offset_seconds = off
    }
    pos = pos + 5
  } else {
    let zstart = pos
    while pos < len {
      let ch = input.code_unit_at(pos)
      if ch == 32 || ch == 9 || ch == 40 {
        break
      }
      let lc = dt_lower(ch)
      if lc < 97 || lc > 122 {
        return Err(EmailError::InvalidDate("invalid zone character"))
      }
      pos = pos + 1
    }
    let zlen = pos - zstart
    if zlen == 0 || zlen > 5 {
      return Err(EmailError::InvalidDate("invalid zone name length"))
    }
    let a = dt_lower(input.code_unit_at(zstart))
    if zlen == 1 {
      if a == 106 {
        return Err(EmailError::InvalidDate("military zone J is invalid"))
      }
      offset_seconds = 0
      unknown_local = true
    } else if zlen == 2 {
      let b = dt_lower(input.code_unit_at(zstart + 1))
      if a == 117 && b == 116 {
        offset_seconds = 0
      } else {
        return Err(EmailError::InvalidDate("unknown 2-letter zone"))
      }
    } else if zlen == 3 {
      let b = dt_lower(input.code_unit_at(zstart + 1))
      let c = dt_lower(input.code_unit_at(zstart + 2))
      if a == 103 && b == 109 && c == 116 {
        offset_seconds = 0
      } else if a == 117 && b == 116 && c == 99 {
        offset_seconds = 0
      } else if a == 101 && b == 115 && c == 116 {
        offset_seconds = -18000
      } else if a == 101 && b == 100 && c == 116 {
        offset_seconds = -14400
      } else if a == 99 && b == 115 && c == 116 {
        offset_seconds = -21600
      } else if a == 99 && b == 100 && c == 116 {
        offset_seconds = -18000
      } else if a == 109 && b == 115 && c == 116 {
        offset_seconds = -25200
      } else if a == 109 && b == 100 && c == 116 {
        offset_seconds = -21600
      } else if a == 112 && b == 115 && c == 116 {
        offset_seconds = -28800
      } else if a == 112 && b == 100 && c == 116 {
        offset_seconds = -25200
      } else {
        offset_seconds = 0
        unknown_local = true
      }
    } else {
      offset_seconds = 0
      unknown_local = true
    }
  }

  pos = dt_skip_cfws_fast(input, pos, len)
  if pos < 0 {
    return Err(dt_cfws_err(pos))
  }
  if pos != len {
    return Err(EmailError::InvalidDate("trailing characters in date"))
  }

  let d = match time::Date::new(year, month, day) {
    Ok(v) => v
    Err(_) => return Err(EmailError::InvalidDate("invalid calendar date"))
  }
  match parsed_wd {
    Some(wd) =>
    if !time::weekday_eq(wd, d.weekday()) {
      return Err(EmailError::InvalidDate("weekday does not match date"))
    }
    None => ()
  }

  let ts = d.to_epoch_days().to_int64() * 86400L +
  (hour * 3600 + minute * 60 + second - offset_seconds).to_int64()
  Ok(
    EmailDate::{
      year: year,
      month: month,
      day: day,
      hour: hour,
      minute: minute,
      second: second,
      offset_seconds: offset_seconds,
      unknown_local_offset: unknown_local,
      timestamp: ts,
    },
  )
}
