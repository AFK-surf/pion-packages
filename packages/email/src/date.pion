///| RFC 5322 date-time parser and formatter.

///|
pub val struct EmailDate {
  year : Int
  month : Int
  day : Int
  hour : Int
  minute : Int
  second : Int
  offset_seconds : Int
  unknown_local_offset : Bool
  timestamp : Int64
}

///|
pub fn EmailDate::from_timestamp(
  ts : Int64,
  offset_seconds : Int,
) -> Result[EmailDate, EmailError] {
  let _ = (ts, offset_seconds)
  Err(EmailError::InvalidDate("unimplemented"))
}

///|
pub fn EmailDate::format(self : EmailDate) -> String {
  let _ = self
  ""
}

///|
pub fn parse_date(input : String) -> Result[EmailDate, EmailError] {
  let _ = input
  Err(EmailError::InvalidDate("unimplemented"))
}
