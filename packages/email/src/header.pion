///| RFC 5322 / 6532 / 2047 email header parsing, unfolding, validation, and folding.

///|
pub val struct Header {
  name : String
  raw_value : String
  value : String
}

///|
pub fn Header::new(name : String, value : String) -> Header {
  Header::{ name: name, raw_value: value, value: unfold_header(value) }
}

///|
pub fn Header::decoded_value(self : Header) -> String {
  email_decode_rfc2047(self.value)
}

///|
#verify
pub fn hdr_ascii_lower(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

///| RFC 5322 §3.6.8 ftext: printable US-ASCII except `:` (`33..57`, `59..126`).
#verify
pub fn email_is_ftext(c : Int) -> Bool {
  c >= 33 && c <= 126 && c != 58
}

///| Header-injection control byte predicate (NUL, LF, CR).
#verify
pub fn email_is_injection_byte(c : Int) -> Bool {
  c == 0 || c == 10 || c == 13
}

///| Effective soft folding column limit (`max_col < 20` defaults to RFC 5322 78).
pub fn email_effective_fold_limit(max_col : Int) -> Int {
  if max_col < 20 {
    78
  } else {
    max_col
  }
}

///|
fn hdr_eq_ignore_case(a : String, b : String) -> Bool {
  let la = a.length()
  if la != b.length() {
    return false
  }
  let mut i = 0
  while i < la {
    let ca = a.code_unit_at(i)
    let cb = b.code_unit_at(i)
    if ca != cb {
      let da = if ca >= 65 && ca <= 90 { ca + 32 } else { ca }
      let db = if cb >= 65 && cb <= 90 { cb + 32 } else { cb }
      if da != db {
        return false
      }
    }
    i = i + 1
  }
  true
}

///|
fn hdr_trim_wsp(s : String) -> String {
  let len = s.length()
  let mut start = 0
  while start < len {
    let c = s.code_unit_at(start)
    if c == 32 || c == 9 {
      start = start + 1
    } else {
      break
    }
  }
  let mut end = len
  while end > start {
    let c = s.code_unit_at(end - 1)
    if c == 32 || c == 9 {
      end = end - 1
    } else {
      break
    }
  }
  if start == 0 && end == len {
    s
  } else {
    s.slice(start, end)
  }
}

///|
pub fn unfold_header(raw : String) -> String {
  let len = raw.length()
  let mut needs_work = false
  let mut scan = 0
  while scan < len {
    let c = raw.code_unit_at(scan)
    if c == 13 || c == 10 {
      needs_work = true
      break
    }
    scan = scan + 1
  }
  if !needs_work {
    return hdr_trim_wsp(raw)
  }
  let sb = StringBuilder::new()
  let mut i = 0
  let mut seg_start = 0
  while i < len {
    let c = raw.code_unit_at(i)
    if c == 13 && i + 1 < len && raw.code_unit_at(i + 1) == 10 {
      if i > seg_start {
        sb.write_string(raw.slice(seg_start, i))
      }
      if i + 2 < len && (raw.code_unit_at(i + 2) == 32 || raw.code_unit_at(i + 2) == 9) {
        sb.write_byte((32).to_byte())
        i = i + 3
        while i < len && (raw.code_unit_at(i) == 32 || raw.code_unit_at(i) == 9) {
          i = i + 1
        }
      } else {
        i = i + 2
      }
      seg_start = i
      continue
    }
    if c == 10 {
      if i > seg_start {
        sb.write_string(raw.slice(seg_start, i))
      }
      if i + 1 < len && (raw.code_unit_at(i + 1) == 32 || raw.code_unit_at(i + 1) == 9) {
        sb.write_byte((32).to_byte())
        i = i + 2
        while i < len && (raw.code_unit_at(i) == 32 || raw.code_unit_at(i) == 9) {
          i = i + 1
        }
      } else {
        i = i + 1
      }
      seg_start = i
      continue
    }
    i = i + 1
  }
  if seg_start < len {
    sb.write_string(raw.slice(seg_start, len))
  }
  hdr_trim_wsp(sb.to_string())
}

///|
pub fn validate_header_name(name : String) -> Result[Unit, EmailError] {
  let len = name.length()
  if len == 0 {
    return Err(EmailError::InvalidHeader("empty header name"))
  }
  let mut i = 0
  while i < len {
    let c = name.code_unit_at(i)
    // RFC 5322 ftext: 33..57, 59..126
    if !email_is_ftext(c) {
      return Err(EmailError::InvalidHeader("invalid character in header name"))
    }
    i = i + 1
  }
  Ok(())
}

///|
pub fn validate_header_value(value : String) -> Result[Unit, EmailError] {
  let len = value.length()
  let mut i = 0
  while i < len {
    let c = value.code_unit_at(i)
    if c <= 13 && email_is_injection_byte(c) {
      return Err(EmailError::HeaderInjection("CR/LF/NUL not allowed in header value"))
    }
    i = i + 1
  }
  Ok(())
}

///|
pub fn fold_header_line(name : String, value : String, max_col : Int) -> String {
  let limit = email_effective_fold_limit(max_col)
  let hard_limit = 998
  let prefix = name + ": "
  let full = prefix + value
  let len = full.length()
  if len <= limit && len <= hard_limit {
    return full
  }
  let sb = StringBuilder::new()
  let mut line_start = 0
  let mut last_wsp = -1
  let mut i = 0
  let min_break = prefix.length()
  let mut is_first_line = true
  while i < len {
    let c = full.code_unit_at(i)
    if (c == 32 || c == 9) && i >= min_break && i > line_start + 1 {
      last_wsp = i
    }
    let prefix_w = if is_first_line { 0 } else { 1 }
    let col = prefix_w + (i - line_start + 1)
    if col > limit && last_wsp > line_start {
      sb.write_string(full.slice(line_start, last_wsp))
      sb.write_string("\r\n ")
      line_start = last_wsp + 1
      while line_start < len &&
      (full.code_unit_at(line_start) == 32 || full.code_unit_at(line_start) == 9) {
        line_start = line_start + 1
      }
      if i < line_start {
        i = line_start
      }
      last_wsp = -1
      is_first_line = false
      continue
    }
    // RFC 5322 §2.1.1: never emit a physical line longer than 998 octets
    if col >= hard_limit {
      let mut split_at = i
      if split_at <= line_start {
        split_at = line_start + 1
      }
      // Avoid splitting mid UTF-8 multi-byte sequence
      while split_at > line_start + 1 && (full.code_unit_at(split_at) & 0xC0) == 0x80 {
        split_at = split_at - 1
      }
      sb.write_string(full.slice(line_start, split_at))
      sb.write_string("\r\n ")
      line_start = split_at
      i = split_at
      last_wsp = -1
      is_first_line = false
      continue
    }
    i = i + 1
  }
  if line_start < len {
    sb.write_string(full.slice(line_start, len))
  }
  sb.to_string()
}

///|
pub fn parse_headers(
  raw : Bytes,
  limits : EmailLimits,
) -> Result[(Array[Header], Int), EmailError] {
  parse_headers_range(raw, 0, raw.length(), limits)
}

///| Exact-case interning for common RFC 5322 / MIME header names directly from `Bytes` (zero alloc on match).
fn hdr_intern_name_bytes(raw : Bytes, start : Int, end : Int) -> String {
  let len = end - start
  let c0 = raw[start].to_int()
  if len == 2 {
    if c0 == 84 && raw[start + 1].to_int() == 111 {
      return "To"
    }
    if c0 == 67 && raw[start + 1].to_int() == 99 {
      return "Cc"
    }
  } else if len == 4 {
    if c0 == 70 &&
    raw[start + 1].to_int() == 114 &&
    raw[start + 2].to_int() == 111 &&
    raw[start + 3].to_int() == 109 {
      return "From"
    }
    if c0 == 68 &&
    raw[start + 1].to_int() == 97 &&
    raw[start + 2].to_int() == 116 &&
    raw[start + 3].to_int() == 101 {
      return "Date"
    }
  } else if len == 7 {
    if c0 == 83 &&
    raw[start + 1].to_int() == 117 &&
    raw[start + 2].to_int() == 98 &&
    raw[start + 3].to_int() == 106 &&
    raw[start + 4].to_int() == 101 &&
    raw[start + 5].to_int() == 99 &&
    raw[start + 6].to_int() == 116 {
      return "Subject"
    }
  } else if len == 10 {
    if c0 == 77 &&
    raw[start + 1].to_int() == 101 &&
    raw[start + 2].to_int() == 115 &&
    raw[start + 3].to_int() == 115 &&
    raw[start + 4].to_int() == 97 &&
    raw[start + 5].to_int() == 103 &&
    raw[start + 6].to_int() == 101 &&
    raw[start + 7].to_int() == 45 &&
    raw[start + 8].to_int() == 73 &&
    raw[start + 9].to_int() == 68 {
      return "Message-ID"
    }
    if c0 == 67 &&
    raw[start + 1].to_int() == 111 &&
    raw[start + 2].to_int() == 110 &&
    raw[start + 3].to_int() == 116 &&
    raw[start + 4].to_int() == 101 &&
    raw[start + 5].to_int() == 110 &&
    raw[start + 6].to_int() == 116 &&
    raw[start + 7].to_int() == 45 &&
    raw[start + 8].to_int() == 73 &&
    raw[start + 9].to_int() == 68 {
      return "Content-ID"
    }
  } else if len == 12 {
    if c0 == 67 &&
    raw[start + 7].to_int() == 45 &&
    raw[start + 8].to_int() == 84 &&
    raw[start + 11].to_int() == 101 &&
    raw[start + 1].to_int() == 111 &&
    raw[start + 2].to_int() == 110 &&
    raw[start + 3].to_int() == 116 &&
    raw[start + 4].to_int() == 101 &&
    raw[start + 5].to_int() == 110 &&
    raw[start + 6].to_int() == 116 &&
    raw[start + 9].to_int() == 121 &&
    raw[start + 10].to_int() == 112 {
      return "Content-Type"
    }
    if c0 == 77 &&
    raw[start + 4].to_int() == 45 &&
    raw[start + 5].to_int() == 86 &&
    raw[start + 1].to_int() == 73 &&
    raw[start + 2].to_int() == 77 &&
    raw[start + 3].to_int() == 69 &&
    raw[start + 6].to_int() == 101 &&
    raw[start + 7].to_int() == 114 &&
    raw[start + 8].to_int() == 115 &&
    raw[start + 9].to_int() == 105 &&
    raw[start + 10].to_int() == 111 &&
    raw[start + 11].to_int() == 110 {
      return "MIME-Version"
    }
  } else if len == 14 && c0 == 68 && raw[start + 4].to_int() == 45 && raw[start + 5].to_int() == 83 {
    if raw[start + 1].to_int() == 75 &&
    raw[start + 2].to_int() == 73 &&
    raw[start + 3].to_int() == 77 &&
    raw[start + 6].to_int() == 105 &&
    raw[start + 7].to_int() == 103 &&
    raw[start + 8].to_int() == 110 &&
    raw[start + 9].to_int() == 97 &&
    raw[start + 10].to_int() == 116 &&
    raw[start + 11].to_int() == 117 &&
    raw[start + 12].to_int() == 114 &&
    raw[start + 13].to_int() == 101 {
      return "DKIM-Signature"
    }
  } else if len == 19 && c0 == 67 && raw[start + 7].to_int() == 45 && raw[start + 8].to_int() == 68 {
    if raw[start + 1].to_int() == 111 &&
    raw[start + 2].to_int() == 110 &&
    raw[start + 3].to_int() == 116 &&
    raw[start + 4].to_int() == 101 &&
    raw[start + 5].to_int() == 110 &&
    raw[start + 6].to_int() == 116 &&
    raw[start + 9].to_int() == 105 &&
    raw[start + 10].to_int() == 115 &&
    raw[start + 11].to_int() == 112 &&
    raw[start + 12].to_int() == 111 &&
    raw[start + 13].to_int() == 115 &&
    raw[start + 14].to_int() == 105 &&
    raw[start + 15].to_int() == 116 &&
    raw[start + 16].to_int() == 105 &&
    raw[start + 17].to_int() == 111 &&
    raw[start + 18].to_int() == 110 {
      return "Content-Disposition"
    }
  } else if len == 25 && c0 == 67 && raw[start + 7].to_int() == 45 && raw[start + 16].to_int() == 45 {
    if raw[start + 8].to_int() == 84 &&
    raw[start + 17].to_int() == 69 &&
    raw[start + 24].to_int() == 103 &&
    raw[start + 1].to_int() == 111 &&
    raw[start + 2].to_int() == 110 &&
    raw[start + 3].to_int() == 116 &&
    raw[start + 4].to_int() == 101 &&
    raw[start + 5].to_int() == 110 &&
    raw[start + 6].to_int() == 116 &&
    raw[start + 9].to_int() == 114 &&
    raw[start + 10].to_int() == 97 &&
    raw[start + 11].to_int() == 110 &&
    raw[start + 12].to_int() == 115 &&
    raw[start + 13].to_int() == 102 &&
    raw[start + 14].to_int() == 101 &&
    raw[start + 15].to_int() == 114 &&
    raw[start + 18].to_int() == 110 &&
    raw[start + 19].to_int() == 99 &&
    raw[start + 20].to_int() == 111 &&
    raw[start + 21].to_int() == 100 &&
    raw[start + 22].to_int() == 105 &&
    raw[start + 23].to_int() == 110 {
      return "Content-Transfer-Encoding"
    }
  }
  raw.slice(start, end).to_string()
}

///| Exact-match interning for the most common RFC 2045/5322 constant header values (zero alloc on match).
fn hdr_intern_val_bytes(raw : Bytes, start : Int, end : Int) -> (String, String) {
  let len = end - start
  if len >= 4 && raw[start].to_int() == 32 {
    let c1 = raw[start + 1].to_int()
    if len == 4 && c1 == 49 && raw[start + 2].to_int() == 46 && raw[start + 3].to_int() == 48 {
      return (" 1.0", "1.0")
    }
    if len == 5 && c1 == 55 && raw[start + 2].to_int() == 98 && raw[start + 3].to_int() == 105 && raw[start + 4].to_int() == 116 {
      return (" 7bit", "7bit")
    }
    if len == 5 && c1 == 56 && raw[start + 2].to_int() == 98 && raw[start + 3].to_int() == 105 && raw[start + 4].to_int() == 116 {
      return (" 8bit", "8bit")
    }
    if len == 7 &&
    c1 == 98 &&
    raw[start + 2].to_int() == 97 &&
    raw[start + 3].to_int() == 115 &&
    raw[start + 4].to_int() == 101 &&
    raw[start + 5].to_int() == 54 &&
    raw[start + 6].to_int() == 52 {
      return (" base64", "base64")
    }
    if len == 17 &&
    c1 == 113 &&
    raw[start + 7].to_int() == 45 &&
    raw[start + 16].to_int() == 101 &&
    raw[start + 2].to_int() == 117 &&
    raw[start + 3].to_int() == 111 &&
    raw[start + 4].to_int() == 116 &&
    raw[start + 5].to_int() == 101 &&
    raw[start + 6].to_int() == 100 &&
    raw[start + 8].to_int() == 112 &&
    raw[start + 9].to_int() == 114 &&
    raw[start + 10].to_int() == 105 &&
    raw[start + 11].to_int() == 110 &&
    raw[start + 12].to_int() == 116 &&
    raw[start + 13].to_int() == 97 &&
    raw[start + 14].to_int() == 98 &&
    raw[start + 15].to_int() == 108 {
      return (" quoted-printable", "quoted-printable")
    }
    if len == 25 &&
    c1 == 97 &&
    raw[start + 12].to_int() == 47 &&
    raw[start + 24].to_int() == 109 &&
    raw[start + 2].to_int() == 112 &&
    raw[start + 3].to_int() == 112 &&
    raw[start + 4].to_int() == 108 &&
    raw[start + 5].to_int() == 105 &&
    raw[start + 6].to_int() == 99 &&
    raw[start + 7].to_int() == 97 &&
    raw[start + 8].to_int() == 116 &&
    raw[start + 9].to_int() == 105 &&
    raw[start + 10].to_int() == 111 &&
    raw[start + 11].to_int() == 110 &&
    raw[start + 13].to_int() == 111 &&
    raw[start + 14].to_int() == 99 &&
    raw[start + 15].to_int() == 116 &&
    raw[start + 16].to_int() == 101 &&
    raw[start + 17].to_int() == 116 &&
    raw[start + 18].to_int() == 45 &&
    raw[start + 19].to_int() == 115 &&
    raw[start + 20].to_int() == 116 &&
    raw[start + 21].to_int() == 114 &&
    raw[start + 22].to_int() == 101 &&
    raw[start + 23].to_int() == 97 {
      return (" application/octet-stream", "application/octet-stream")
    }
    if len == 25 &&
    c1 == 116 &&
    raw[start + 5].to_int() == 47 &&
    raw[start + 10].to_int() == 59 &&
    raw[start + 24].to_int() == 56 &&
    raw[start + 2].to_int() == 101 &&
    raw[start + 3].to_int() == 120 &&
    raw[start + 4].to_int() == 116 &&
    raw[start + 6].to_int() == 104 &&
    raw[start + 7].to_int() == 116 &&
    raw[start + 8].to_int() == 109 &&
    raw[start + 9].to_int() == 108 &&
    raw[start + 11].to_int() == 32 &&
    raw[start + 12].to_int() == 99 &&
    raw[start + 13].to_int() == 104 &&
    raw[start + 14].to_int() == 97 &&
    raw[start + 15].to_int() == 114 &&
    raw[start + 16].to_int() == 115 &&
    raw[start + 17].to_int() == 101 &&
    raw[start + 18].to_int() == 116 &&
    raw[start + 19].to_int() == 61 &&
    raw[start + 20].to_int() == 117 &&
    raw[start + 21].to_int() == 116 &&
    raw[start + 22].to_int() == 102 &&
    raw[start + 23].to_int() == 45 {
      return (" text/html; charset=utf-8", "text/html; charset=utf-8")
    }
    if len == 26 &&
    c1 == 116 &&
    raw[start + 5].to_int() == 47 &&
    raw[start + 11].to_int() == 59 &&
    raw[start + 25].to_int() == 56 &&
    raw[start + 2].to_int() == 101 &&
    raw[start + 3].to_int() == 120 &&
    raw[start + 4].to_int() == 116 &&
    raw[start + 6].to_int() == 112 &&
    raw[start + 7].to_int() == 108 &&
    raw[start + 8].to_int() == 97 &&
    raw[start + 9].to_int() == 105 &&
    raw[start + 10].to_int() == 110 &&
    raw[start + 12].to_int() == 32 &&
    raw[start + 13].to_int() == 99 &&
    raw[start + 14].to_int() == 104 &&
    raw[start + 15].to_int() == 97 &&
    raw[start + 16].to_int() == 114 &&
    raw[start + 17].to_int() == 115 &&
    raw[start + 18].to_int() == 101 &&
    raw[start + 19].to_int() == 116 &&
    raw[start + 20].to_int() == 61 &&
    raw[start + 21].to_int() == 117 &&
    raw[start + 22].to_int() == 116 &&
    raw[start + 23].to_int() == 102 &&
    raw[start + 24].to_int() == 45 {
      return (" text/plain; charset=utf-8", "text/plain; charset=utf-8")
    }
  }
  let raw_val = raw.slice(start, end).to_string()
  (raw_val, hdr_trim_wsp(raw_val))
}

///|
fn parse_headers_range(
  raw : Bytes,
  start_off : Int,
  end_off : Int,
  limits : EmailLimits,
) -> Result[(Array[Header], Int), EmailError] {
  let headers : Array[Header] = Array::with_capacity(8)
  let max_hbytes = limits.max_header_bytes
  let max_hdrs = limits.max_headers
  let mut pos = start_off
  let mut cur_name = ""
  let mut cur_raw_start = 0
  let mut cur_raw_end = 0
  let mut cur_needs_unfold = false
  let mut has_cur = false

  while pos < end_off {
    if pos - start_off > max_hbytes {
      return Err(EmailError::LimitExceeded("header section exceeds max_header_bytes"))
    }
    let b0 = raw[pos].to_int()
    if b0 == 13 && pos + 1 < end_off && raw[pos + 1].to_int() == 10 {
      pos = pos + 2
      break
    }
    if b0 == 10 {
      pos = pos + 1
      break
    }
    let line_start = pos
    let mut line_end = pos
    let mut colon = -1
    let mut cr_count = 0
    while line_end < end_off {
      let c = raw[line_end].to_int()
      if c == 10 {
        break
      }
      if c == 0 {
        return Err(EmailError::HeaderInjection("NUL byte in header"))
      }
      if c == 58 {
        colon = line_end
        line_end = line_end + 1
        // Fast value scan: 99.9% of header value bytes are > 13 (printable ASCII / UTF-8)
        while line_end < end_off {
          while line_end + 4 <= end_off &&
          raw[line_end].to_int() > 13 &&
          raw[line_end + 1].to_int() > 13 &&
          raw[line_end + 2].to_int() > 13 &&
          raw[line_end + 3].to_int() > 13 {
            line_end = line_end + 4
          }
          if line_end >= end_off {
            break
          }
          let vc = raw[line_end].to_int()
          if vc == 10 {
            break
          }
          if vc == 0 {
            return Err(EmailError::HeaderInjection("NUL byte in header"))
          }
          if vc == 13 {
            cr_count = cr_count + 1
          }
          line_end = line_end + 1
        }
        break
      } else if c == 13 {
        cr_count = cr_count + 1
      }
      line_end = line_end + 1
    }
    let mut content_end = line_end
    if content_end > line_start && raw[content_end - 1].to_int() == 13 {
      content_end = content_end - 1
      cr_count = cr_count - 1
    }
    let next_pos = if line_end < end_off { line_end + 1 } else { end_off }
    if next_pos - start_off > max_hbytes {
      return Err(EmailError::LimitExceeded("header section exceeds max_header_bytes"))
    }

    if b0 == 32 || b0 == 9 {
      if !has_cur {
        return Err(EmailError::InvalidHeader("unexpected leading whitespace before first header"))
      }
      cur_raw_end = content_end
      cur_needs_unfold = true
      pos = next_pos
      continue
    }

    if has_cur {
      if cur_needs_unfold {
        let raw_val = raw.slice(cur_raw_start, cur_raw_end).to_string()
        headers.push(Header::{ name: cur_name, raw_value: raw_val, value: unfold_header(raw_val) })
      } else {
        let (raw_val, hval) = hdr_intern_val_bytes(raw, cur_raw_start, cur_raw_end)
        headers.push(Header::{ name: cur_name, raw_value: raw_val, value: hval })
      }
    }

    if headers.length() >= max_hdrs {
      return Err(EmailError::LimitExceeded("header count exceeds max_headers"))
    }

    if colon < 0 || colon >= content_end {
      has_cur = false
      pos = next_pos
      continue
    }
    let mut name_end = colon
    while name_end > line_start &&
    (raw[name_end - 1].to_int() == 32 || raw[name_end - 1].to_int() == 9) {
      name_end = name_end - 1
    }
    let mut name_ok = name_end > line_start
    let mut ni = line_start
    while name_ok && ni < name_end {
      let ch = raw[ni].to_int()
      if ch < 33 || ch > 126 {
        name_ok = false
      }
      ni = ni + 1
    }
    if !name_ok {
      has_cur = false
      pos = next_pos
      continue
    }
    cur_name = hdr_intern_name_bytes(raw, line_start, name_end)
    cur_raw_start = colon + 1
    cur_raw_end = content_end
    cur_needs_unfold = cr_count > 0
    has_cur = true
    pos = next_pos
  }

  if has_cur {
    if cur_needs_unfold {
      let raw_val = raw.slice(cur_raw_start, cur_raw_end).to_string()
      headers.push(Header::{ name: cur_name, raw_value: raw_val, value: unfold_header(raw_val) })
    } else {
      let (raw_val, hval) = hdr_intern_val_bytes(raw, cur_raw_start, cur_raw_end)
      headers.push(Header::{ name: cur_name, raw_value: raw_val, value: hval })
    }
  }

  Ok((headers, pos))
}

///|
pub fn headers_get(headers : Array[Header], name : String) -> Option[String] {
  let mut i = 0
  let n = headers.length()
  while i < n {
    if hdr_eq_ignore_case(headers[i].name, name) {
      return Some(headers[i].value)
    }
    i = i + 1
  }
  None
}

///|
pub fn headers_get_decoded(headers : Array[Header], name : String) -> Option[String] {
  let mut i = 0
  let n = headers.length()
  while i < n {
    if hdr_eq_ignore_case(headers[i].name, name) {
      return Some(headers[i].decoded_value())
    }
    i = i + 1
  }
  None
}

///|
pub fn headers_get_all(headers : Array[Header], name : String) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  let n = headers.length()
  while i < n {
    if hdr_eq_ignore_case(headers[i].name, name) {
      out.push(headers[i].value)
    }
    i = i + 1
  }
  out
}
