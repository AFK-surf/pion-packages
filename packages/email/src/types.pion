///| Core error types and resource limits for `packages/email`.

///|
pub enum EmailError {
  InvalidHeader(String)
  HeaderInjection(String)
  InvalidAddress(String)
  InvalidDate(String)
  InvalidMime(String)
  InvalidEncoding(String)
  InvalidDkim(String)
  DkimVerifyFailed(String)
  InvalidMbox(String)
  LimitExceeded(String)
}

///|
pub fn EmailError::to_string(self : EmailError) -> String {
  match self {
    EmailError::InvalidHeader(s) => "InvalidHeader: " + s
    EmailError::HeaderInjection(s) => "HeaderInjection: " + s
    EmailError::InvalidAddress(s) => "InvalidAddress: " + s
    EmailError::InvalidDate(s) => "InvalidDate: " + s
    EmailError::InvalidMime(s) => "InvalidMime: " + s
    EmailError::InvalidEncoding(s) => "InvalidEncoding: " + s
    EmailError::InvalidDkim(s) => "InvalidDkim: " + s
    EmailError::DkimVerifyFailed(s) => "DkimVerifyFailed: " + s
    EmailError::InvalidMbox(s) => "InvalidMbox: " + s
    EmailError::LimitExceeded(s) => "LimitExceeded: " + s
  }
}

///|
pub val struct EmailLimits {
  max_depth : Int
  max_parts : Int
  max_headers : Int
  max_header_bytes : Int
  max_body_bytes : Int
}

///|
pub fn EmailLimits::default() -> EmailLimits {
  EmailLimits::{
    max_depth: 16,
    max_parts: 1024,
    max_headers: 1024,
    max_header_bytes: 262144,
    max_body_bytes: 67108864,
  }
}
