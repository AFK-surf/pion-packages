///| RFC 5322 / 6532 email address, address-list, group, and nested comment parser.

import "mime"

///|
pub val struct Mailbox {
  name : String
  address : String
}

///|
fn addr_check_no_injection(s : String) -> Result[Unit, EmailError] {
  let len = s.length()
  let mut i = 0
  while i < len {
    let c = s.code_unit_at(i)
    if c == 0 || c == 10 || c == 13 {
      return Err(EmailError::HeaderInjection("CR/LF/NUL not allowed in address"))
    }
    i = i + 1
  }
  Ok(())
}

///| RFC 5322 §3.2.3 atext + RFC 6532 UTF-8 non-ASCII octets.
fn addr_is_atext(c : Int) -> Bool {
  if c >= 128 {
    return true
  }
  if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
    return true
  }
  c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 ||
  c == 43 || c == 45 || c == 47 || c == 61 || c == 63 || c == 94 || c == 95 ||
  c == 96 || c == 123 || c == 124 || c == 125 || c == 126
}

///| Validate dot-atom-text: `atext *("." atext)` (no leading/trailing `.`, no `..`, no specials).
fn addr_validate_dot_atom(s : String, start : Int, end : Int) -> Bool {
  if start >= end {
    return false
  }
  if s.code_unit_at(start) == 46 || s.code_unit_at(end - 1) == 46 {
    return false
  }
  let mut prev_dot = false
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c == 46 {
      if prev_dot {
        return false
      }
      prev_dot = true
    } else if addr_is_atext(c) {
      prev_dot = false
    } else {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn addr_validate_spec(addr : String) -> Result[Unit, EmailError] {
  match addr_check_no_injection(addr) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let len = addr.length()
  if len < 3 {
    return Err(EmailError::InvalidAddress("address too short"))
  }
  // 1. Parse local-part: quoted-string OR dot-atom-text
  let mut at_pos = -1
  if addr.code_unit_at(0) == 34 {
    let mut i = 1
    let mut esc = false
    let mut closed = false
    while i < len {
      let c = addr.code_unit_at(i)
      if esc {
        if c < 32 || c == 127 {
          return Err(EmailError::InvalidAddress("illegal escaped char in quoted local-part"))
        }
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        closed = true
        i = i + 1
        break
      } else if c < 32 || c == 127 {
        return Err(EmailError::InvalidAddress("illegal char in quoted local-part"))
      }
      i = i + 1
    }
    if !closed || i >= len || addr.code_unit_at(i) != 64 {
      return Err(EmailError::InvalidAddress("invalid quoted local-part in addr-spec"))
    }
    at_pos = i
  } else {
    let mut i = 0
    while i < len && addr.code_unit_at(i) != 64 {
      i = i + 1
    }
    if i <= 0 || i >= len - 1 {
      return Err(EmailError::InvalidAddress("invalid addr-spec"))
    }
    if !addr_validate_dot_atom(addr, 0, i) {
      return Err(EmailError::InvalidAddress("invalid local-part in addr-spec"))
    }
    at_pos = i
  }
  // 2. Parse domain: domain-literal `[...]` OR dot-atom-text
  let dstart = at_pos + 1
  if dstart >= len {
    return Err(EmailError::InvalidAddress("empty domain in addr-spec"))
  }
  if addr.code_unit_at(dstart) == 91 {
    if len - dstart < 3 || addr.code_unit_at(len - 1) != 93 {
      return Err(EmailError::InvalidAddress("invalid domain-literal in addr-spec"))
    }
    let mut i = dstart + 1
    while i < len - 1 {
      let c = addr.code_unit_at(i)
      if c < 33 || c > 126 || c == 91 || c == 92 || c == 93 {
        return Err(EmailError::InvalidAddress("illegal char in domain-literal"))
      }
      i = i + 1
    }
  } else if !addr_validate_dot_atom(addr, dstart, len) {
    return Err(EmailError::InvalidAddress("invalid domain in addr-spec"))
  }
  Ok(())
}

///|
pub fn Mailbox::new(name : String, address : String) -> Result[Mailbox, EmailError] {
  match addr_check_no_injection(name) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match addr_validate_spec(address) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(Mailbox::{ name: name, address: address })
}

///|
pub fn Mailbox::local_part(self : Mailbox) -> String {
  let len = self.address.length()
  let mut i = len - 1
  while i >= 0 {
    if self.address.code_unit_at(i) == 64 {
      return self.address.slice(0, i)
    }
    i = i - 1
  }
  self.address
}

///|
pub fn Mailbox::domain(self : Mailbox) -> String {
  let len = self.address.length()
  let mut i = len - 1
  while i >= 0 {
    if self.address.code_unit_at(i) == 64 {
      return self.address.slice(i + 1, len)
    }
    i = i - 1
  }
  ""
}

///|
fn addr_has_non_ascii(s : String) -> Bool {
  let len = s.length()
  let mut i = 0
  while i < len {
    if s.code_unit_at(i) >= 128 {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn addr_needs_quoting(s : String) -> Bool {
  if s.contains("=?") {
    return true
  }
  let len = s.length()
  let mut i = 0
  while i < len {
    let c = s.code_unit_at(i)
    // RFC 5322 specials: ( ) < > [ ] : ; @ \ , . "
    if c == 40 || c == 41 || c == 60 || c == 62 || c == 91 || c == 93 ||
    c == 58 || c == 59 || c == 64 || c == 92 || c == 44 || c == 46 || c == 34 {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn addr_format_phrase(phrase : String) -> String {
  if addr_has_non_ascii(phrase) {
    return mime::encode_rfc2047_b(phrase)
  }
  if !addr_needs_quoting(phrase) {
    return phrase
  }
  let sb = StringBuilder::new()
  sb.write_byte((34).to_byte())
  let len = phrase.length()
  let mut i = 0
  while i < len {
    let c = phrase.code_unit_at(i)
    if c == 34 || c == 92 {
      sb.write_byte((92).to_byte())
    }
    sb.write_byte(c.to_byte())
    i = i + 1
  }
  sb.write_byte((34).to_byte())
  sb.to_string()
}

///|
pub fn Mailbox::format(self : Mailbox) -> String {
  if self.name.length() == 0 {
    return self.address
  }
  addr_format_phrase(self.name) + " <" + self.address + ">"
}

///|
pub struct AddressGroup {
  name : String
  members : Array[Mailbox]
}

///|
pub enum Address {
  Single(Mailbox)
  Group(AddressGroup)
}

///|
struct AddrParser {
  s : String
  len : Int
  mut pos : Int
}

///|
fn AddrParser::skip_cfws(self : AddrParser) -> Result[Unit, EmailError] {
  while self.pos < self.len {
    let c = self.s.code_unit_at(self.pos)
    if c == 32 || c == 9 {
      self.pos = self.pos + 1
    } else if c == 40 {
      // Nested comment
      self.pos = self.pos + 1
      let mut depth = 1
      let mut esc = false
      while self.pos < self.len && depth > 0 {
        let ch = self.s.code_unit_at(self.pos)
        self.pos = self.pos + 1
        if esc {
          esc = false
        } else if ch == 92 {
          esc = true
        } else if ch == 40 {
          depth = depth + 1
          if depth > 64 {
            return Err(EmailError::LimitExceeded("comment nesting too deep"))
          }
        } else if ch == 41 {
          depth = depth - 1
        }
      }
      if depth != 0 {
        return Err(EmailError::InvalidAddress("unclosed comment"))
      }
    } else {
      break
    }
  }
  Ok(())
}

///|
fn AddrParser::parse_quoted(self : AddrParser) -> Result[String, EmailError] {
  if self.pos >= self.len || self.s.code_unit_at(self.pos) != 34 {
    return Err(EmailError::InvalidAddress("expected '\"'"))
  }
  self.pos = self.pos + 1
  let sb = StringBuilder::new()
  let mut esc = false
  while self.pos < self.len {
    let c = self.s.code_unit_at(self.pos)
    self.pos = self.pos + 1
    if esc {
      sb.write_byte(c.to_byte())
      esc = false
    } else if c == 92 {
      esc = true
    } else if c == 34 {
      return Ok(sb.to_string())
    } else {
      sb.write_byte(c.to_byte())
    }
  }
  Err(EmailError::InvalidAddress("unclosed quoted-string"))
}

///|
fn is_addr_delim(c : Int) -> Bool {
  c == 32 || c == 9 || c == 40 || c == 41 || c == 60 || c == 62 ||
  c == 44 || c == 58 || c == 59 || c == 34
}

///|
fn AddrParser::parse_atom(self : AddrParser) -> String {
  let start = self.pos
  let mut in_bracket = false
  while self.pos < self.len {
    let c = self.s.code_unit_at(self.pos)
    if in_bracket {
      if c == 93 {
        in_bracket = false
      }
      self.pos = self.pos + 1
      continue
    }
    if c == 91 {
      in_bracket = true
      self.pos = self.pos + 1
      continue
    }
    if is_addr_delim(c) {
      break
    }
    self.pos = self.pos + 1
  }
  self.s.slice(start, self.pos)
}

///|
fn AddrParser::parse_angle_addr(self : AddrParser) -> Result[String, EmailError] {
  if self.pos >= self.len || self.s.code_unit_at(self.pos) != 60 {
    return Err(EmailError::InvalidAddress("expected '<'"))
  }
  self.pos = self.pos + 1
  match self.skip_cfws() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  // Optional obsolete source route: @domain1,@domain2:
  if self.pos < self.len && self.s.code_unit_at(self.pos) == 64 {
    while self.pos < self.len && self.s.code_unit_at(self.pos) != 58 {
      if self.s.code_unit_at(self.pos) == 62 {
        return Err(EmailError::InvalidAddress("malformed obsolete route"))
      }
      self.pos = self.pos + 1
    }
    if self.pos >= self.len || self.s.code_unit_at(self.pos) != 58 {
      return Err(EmailError::InvalidAddress("unterminated obsolete route"))
    }
    self.pos = self.pos + 1
    match self.skip_cfws() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let sb = StringBuilder::new()
  let mut in_quote = false
  let mut esc = false
  while self.pos < self.len {
    let c = self.s.code_unit_at(self.pos)
    if !in_quote && c == 62 {
      self.pos = self.pos + 1
      let spec = sb.to_string()
      match addr_validate_spec(spec) {
        Ok(_) => return Ok(spec)
        Err(e) => return Err(e)
      }
    }
    if !in_quote && (c == 32 || c == 9 || c == 40) {
      match self.skip_cfws() {
        Ok(_) => continue
        Err(e) => return Err(e)
      }
    }
    if esc {
      sb.write_byte(c.to_byte())
      esc = false
    } else if in_quote {
      sb.write_byte(c.to_byte())
      if c == 92 {
        esc = true
      } else if c == 34 {
        in_quote = false
      }
    } else {
      if c == 34 {
        in_quote = true
      }
      sb.write_byte(c.to_byte())
    }
    self.pos = self.pos + 1
  }
  Err(EmailError::InvalidAddress("unclosed angle-addr"))
}

///|
fn decode_display_name(raw : String) -> String {
  let trimmed = hdr_trim_wsp(raw)
  if trimmed.length() == 0 {
    return ""
  }
  email_decode_rfc2047(trimmed)
}

///|
fn AddrParser::parse_mailbox_or_group(
  self : AddrParser,
  allow_group : Bool,
) -> Result[Address, EmailError] {
  match self.skip_cfws() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.pos >= self.len {
    return Err(EmailError::InvalidAddress("unexpected end of address"))
  }

  // Direct <addr-spec>
  if self.s.code_unit_at(self.pos) == 60 {
    let spec = match self.parse_angle_addr() {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match self.skip_cfws() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(Address::Single(Mailbox::{ name: "", address: spec }))
  }

  // Collect phrase/atom tokens until '<', ':', ',', ';', or EOF
  let tokens : Array[String] = []
  let tok_quoted : Array[Bool] = []
  let mut first_was_quoted = false
  let mut raw_first_quoted = ""
  while self.pos < self.len {
    match self.skip_cfws() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if self.pos >= self.len {
      break
    }
    let c = self.s.code_unit_at(self.pos)
    if c == 60 || c == 58 || c == 44 || c == 59 {
      break
    }
    if c == 34 {
      let q_start = self.pos
      let q = match self.parse_quoted() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      if tokens.length() == 0 {
        first_was_quoted = true
        raw_first_quoted = self.s.slice(q_start, self.pos)
      }
      tokens.push(q)
      tok_quoted.push(true)
    } else {
      let atom = self.parse_atom()
      if atom.length() == 0 {
        return Err(EmailError::InvalidAddress("unexpected token in address"))
      }
      tokens.push(atom)
      tok_quoted.push(false)
    }
  }

  // Assemble display name: RFC 2047 §5 forbids decoding encoded-words inside quoted-strings
  let phrase_sb = StringBuilder::new()
  let mut ti = 0
  while ti < tokens.length() {
    if ti > 0 {
      phrase_sb.write_byte((32).to_byte())
    }
    if tok_quoted[ti] {
      phrase_sb.write_string(tokens[ti])
      ti = ti + 1
    } else {
      // Collect consecutive unquoted atoms so adjacent RFC 2047 words merge per §6.2
      let unq_sb = StringBuilder::new()
      let mut first_u = true
      while ti < tokens.length() && !tok_quoted[ti] {
        if !first_u {
          unq_sb.write_byte((32).to_byte())
        }
        unq_sb.write_string(tokens[ti])
        first_u = false
        ti = ti + 1
      }
      phrase_sb.write_string(decode_display_name(unq_sb.to_string()))
    }
  }
  let phrase_decoded = phrase_sb.to_string()

  if self.pos < self.len && self.s.code_unit_at(self.pos) == 60 {
    // Display Name <addr-spec>
    let spec = match self.parse_angle_addr() {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    match self.skip_cfws() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(
      Address::Single(Mailbox::{ name: phrase_decoded, address: spec }),
    )
  }

  if allow_group && self.pos < self.len && self.s.code_unit_at(self.pos) == 58 {
    // Group: Name: member1, member2;
    self.pos = self.pos + 1
    let members : Array[Mailbox] = []
    while true {
      match self.skip_cfws() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if self.pos >= self.len {
        return Err(EmailError::InvalidAddress("unclosed group missing ';'"))
      }
      if self.s.code_unit_at(self.pos) == 59 {
        self.pos = self.pos + 1
        match self.skip_cfws() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        break
      }
      if self.s.code_unit_at(self.pos) == 44 {
        self.pos = self.pos + 1
        continue
      }
      match self.parse_mailbox_or_group(false) {
        Ok(Address::Single(mb)) => members.push(mb)
        Ok(Address::Group(_)) =>
        return Err(EmailError::InvalidAddress("nested group not allowed"))
        Err(e) => return Err(e)
      }
      match self.skip_cfws() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if self.pos < self.len && self.s.code_unit_at(self.pos) == 44 {
        self.pos = self.pos + 1
      } else if self.pos < self.len && self.s.code_unit_at(self.pos) == 59 {
        self.pos = self.pos + 1
        match self.skip_cfws() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        break
      } else {
        return Err(EmailError::InvalidAddress("expected ',' or ';' in group"))
      }
    }
    return Ok(
      Address::Group(AddressGroup::{ name: phrase_decoded, members: members }),
    )
  }

  // Bare addr-spec: allow CFWS adjacent to '@' (RFC 5322 §3.4.1 dot-atom CFWS)
  let bare_spec = if tokens.length() == 1 {
    if first_was_quoted {
      raw_first_quoted
    } else {
      tokens[0]
    }
  } else if tokens.length() >= 2 && tokens.length() <= 3 {
    let bsb = StringBuilder::new()
    let mut bi = 0
    while bi < tokens.length() {
      let cur_tok = if bi == 0 && first_was_quoted { raw_first_quoted } else { tokens[bi] }
      if bi > 0 {
        let prev_tok = if bi - 1 == 0 && first_was_quoted { raw_first_quoted } else { tokens[bi - 1] }
        let prev_ends_at = prev_tok.length() > 0 && prev_tok.code_unit_at(prev_tok.length() - 1) == 64
        let cur_starts_at = cur_tok.length() > 0 && cur_tok.code_unit_at(0) == 64
        if !prev_ends_at && !cur_starts_at {
          return Err(EmailError::InvalidAddress("malformed bare address"))
        }
      }
      bsb.write_string(cur_tok)
      bi = bi + 1
    }
    bsb.to_string()
  } else {
    return Err(EmailError::InvalidAddress("malformed bare address"))
  }
  match addr_validate_spec(bare_spec) {
    Ok(_) => Ok(Address::Single(Mailbox::{ name: "", address: bare_spec }))
    Err(e) => Err(e)
  }
}

///|
pub fn parse_address(input : String) -> Result[Mailbox, EmailError] {
  match addr_check_no_injection(input) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let p = AddrParser::{ s: input, len: input.length(), pos: 0 }
  let res = match p.parse_mailbox_or_group(false) {
    Ok(Address::Single(mb)) => mb
    Ok(Address::Group(_)) =>
    return Err(EmailError::InvalidAddress("group not allowed in parse_address"))
    Err(e) => return Err(e)
  }
  match p.skip_cfws() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if p.pos != p.len {
    return Err(EmailError::InvalidAddress("trailing characters after address"))
  }
  Ok(res)
}

///|
pub fn parse_address_list(input : String) -> Result[Array[Address], EmailError] {
  match addr_check_no_injection(input) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let p = AddrParser::{ s: input, len: input.length(), pos: 0 }
  let out : Array[Address] = []
  while true {
    match p.skip_cfws() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if p.pos >= p.len {
      break
    }
    if p.s.code_unit_at(p.pos) == 44 {
      p.pos = p.pos + 1
      continue
    }
    let item = match p.parse_mailbox_or_group(true) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    out.push(item)
    match p.skip_cfws() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if p.pos >= p.len {
      break
    }
    if p.s.code_unit_at(p.pos) == 44 {
      p.pos = p.pos + 1
    } else {
      return Err(EmailError::InvalidAddress("expected ',' between addresses"))
    }
  }
  if out.length() == 0 {
    return Err(EmailError::InvalidAddress("empty address list"))
  }
  Ok(out)
}

///|
pub fn flatten_addresses(addrs : Array[Address]) -> Array[Mailbox] {
  let out : Array[Mailbox] = []
  let mut i = 0
  while i < addrs.length() {
    match addrs[i] {
      Address::Single(mb) => out.push(mb)
      Address::Group(g) => {
        let mut j = 0
        while j < g.members.length() {
          out.push(g.members[j])
          j = j + 1
        }
      }
    }
    i = i + 1
  }
  out
}

///|
pub fn format_address_list(addrs : Array[Address]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < addrs.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    match addrs[i] {
      Address::Single(mb) => sb.write_string(mb.format())
      Address::Group(g) => {
        sb.write_string(addr_format_phrase(g.name))
        sb.write_string(": ")
        let mut j = 0
        while j < g.members.length() {
          if j > 0 {
            sb.write_string(", ")
          }
          sb.write_string(g.members[j].format())
          j = j + 1
        }
        sb.write_byte((59).to_byte())
      }
    }
    i = i + 1
  }
  sb.to_string()
}
