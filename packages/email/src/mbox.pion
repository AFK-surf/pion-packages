///| mbox (mboxo / mboxrd) streaming parser and writer.

///|
pub enum MboxFlavor {
  Mboxo
  Mboxrd
}

///|
pub struct MboxEntry {
  from_line : String
  message : Bytes
}

///|
pub fn parse_mbox(
  data : Bytes,
  flavor : MboxFlavor,
) -> Result[Array[MboxEntry], EmailError] {
  parse_mbox_with_limits(data, flavor, EmailLimits::default())
}

///|
pub fn parse_mbox_with_limits(
  data : Bytes,
  flavor : MboxFlavor,
  limits : EmailLimits,
) -> Result[Array[MboxEntry], EmailError] {
  let _ = (data, flavor, limits)
  Err(EmailError::InvalidMbox("unimplemented"))
}

///|
pub fn format_mbox_entry(
  from_line : String,
  message : Bytes,
  flavor : MboxFlavor,
) -> Result[Bytes, EmailError] {
  let _ = (from_line, message, flavor)
  Err(EmailError::InvalidMbox("unimplemented"))
}

///|
pub fn format_mbox(
  entries : Array[MboxEntry],
  flavor : MboxFlavor,
) -> Result[Bytes, EmailError] {
  let _ = (entries, flavor)
  Err(EmailError::InvalidMbox("unimplemented"))
}
