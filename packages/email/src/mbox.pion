///| mbox (mboxo / mboxrd) streaming parser and writer with `From ` escaping.

///|
pub enum MboxFlavor {
  Mboxo
  Mboxrd
}

///|
pub struct MboxEntry {
  from_line : String
  message : Bytes
}

///|
fn mbox_starts_with_from_sp(data : Bytes, start : Int, end : Int) -> Bool {
  end - start >= 5 &&
  data[start].to_int() == 70 &&
  data[start + 1].to_int() == 114 &&
  data[start + 2].to_int() == 111 &&
  data[start + 3].to_int() == 109 &&
  data[start + 4].to_int() == 32
}

///|
fn mbox_needs_unescape(
  data : Bytes,
  start : Int,
  end : Int,
  flavor : MboxFlavor,
) -> Bool {
  match flavor {
    MboxFlavor::Mboxo =>
    end - start >= 6 &&
    data[start].to_int() == 62 &&
    mbox_starts_with_from_sp(data, start + 1, end)
    MboxFlavor::Mboxrd => {
      let mut p = start
      while p < end && data[p].to_int() == 62 {
        p = p + 1
      }
      p > start && mbox_starts_with_from_sp(data, p, end)
    }
  }
}

///|
fn mbox_needs_escape(
  data : Bytes,
  start : Int,
  end : Int,
  flavor : MboxFlavor,
) -> Bool {
  match flavor {
    MboxFlavor::Mboxo => mbox_starts_with_from_sp(data, start, end)
    MboxFlavor::Mboxrd => {
      let mut p = start
      while p < end && data[p].to_int() == 62 {
        p = p + 1
      }
      mbox_starts_with_from_sp(data, p, end)
    }
  }
}

///|
pub fn parse_mbox(
  data : Bytes,
  flavor : MboxFlavor,
) -> Result[Array[MboxEntry], EmailError] {
  parse_mbox_with_limits(data, flavor, EmailLimits::default())
}

///|
pub fn parse_mbox_with_limits(
  data : Bytes,
  flavor : MboxFlavor,
  limits : EmailLimits,
) -> Result[Array[MboxEntry], EmailError] {
  let len = data.length()
  let entries : Array[MboxEntry] = []
  let mut pos = 0
  let mut has_entry = false
  let mut cur_from = ""
  let mut cur_buf = StringBuilder::new()
  let mut cur_bytes = 0

  while pos < len {
    let line_start = pos
    let mut line_end = pos
    while line_end < len && data[line_end].to_int() != 10 {
      line_end = line_end + 1
    }
    let next_pos = if line_end < len { line_end + 1 } else { len }
    let content_end = if line_end > line_start && data[line_end - 1].to_int() == 13 {
      line_end - 1
    } else {
      line_end
    }

    if mbox_starts_with_from_sp(data, line_start, content_end) {
      if has_entry {
        let mut msg_bytes = cur_buf.to_string().to_bytes()
        // Strip single trailing blank separator line added by mbox
        let ml = msg_bytes.length()
        if ml >= 2 && msg_bytes[ml - 1].to_int() == 10 && msg_bytes[ml - 2].to_int() == 10 {
          msg_bytes = msg_bytes.slice(0, ml - 1)
        } else if ml >= 4 &&
        msg_bytes[ml - 1].to_int() == 10 &&
        msg_bytes[ml - 2].to_int() == 13 &&
        msg_bytes[ml - 3].to_int() == 10 &&
        msg_bytes[ml - 4].to_int() == 13 {
          msg_bytes = msg_bytes.slice(0, ml - 2)
        }
        entries.push(MboxEntry::{ from_line: cur_from, message: msg_bytes })
      }
      if entries.length() >= limits.max_parts {
        return Err(EmailError::LimitExceeded("mbox entry count exceeds max_parts"))
      }
      cur_from = data.slice(line_start + 5, content_end).to_string()
      cur_buf = StringBuilder::new()
      cur_bytes = 0
      has_entry = true
      pos = next_pos
      continue
    }

    if !has_entry {
      // Allow leading blank lines before first From_ line
      if content_end == line_start {
        pos = next_pos
        continue
      }
      return Err(EmailError::InvalidMbox("expected 'From ' separator at start of mbox"))
    }

    let write_start = if mbox_needs_unescape(data, line_start, content_end, flavor) {
      line_start + 1
    } else {
      line_start
    }
    let chunk_len = next_pos - write_start
    cur_bytes = cur_bytes + chunk_len
    if cur_bytes > limits.max_body_bytes {
      return Err(EmailError::LimitExceeded("mbox message exceeds max_body_bytes"))
    }
    let mut i = write_start
    while i < next_pos {
      cur_buf.write_byte(data[i])
      i = i + 1
    }
    pos = next_pos
  }

  if has_entry {
    let mut msg_bytes = cur_buf.to_string().to_bytes()
    let ml = msg_bytes.length()
    if ml >= 2 && msg_bytes[ml - 1].to_int() == 10 && msg_bytes[ml - 2].to_int() == 10 {
      msg_bytes = msg_bytes.slice(0, ml - 1)
    } else if ml >= 4 &&
    msg_bytes[ml - 1].to_int() == 10 &&
    msg_bytes[ml - 2].to_int() == 13 &&
    msg_bytes[ml - 3].to_int() == 10 &&
    msg_bytes[ml - 4].to_int() == 13 {
      msg_bytes = msg_bytes.slice(0, ml - 2)
    }
    entries.push(MboxEntry::{ from_line: cur_from, message: msg_bytes })
  }

  Ok(entries)
}

///|
pub fn format_mbox_entry(
  from_line : String,
  message : Bytes,
  flavor : MboxFlavor,
) -> Result[Bytes, EmailError] {
  let flen = from_line.length()
  let mut k = 0
  while k < flen {
    let c = from_line.code_unit_at(k)
    if c == 0 || c == 10 || c == 13 {
      return Err(EmailError::HeaderInjection("CR/LF/NUL not allowed in mbox From line"))
    }
    k = k + 1
  }
  let sb = StringBuilder::new()
  sb.write_string("From ")
  sb.write_string(from_line)
  sb.write_byte((10).to_byte())
  let len = message.length()
  let mut pos = 0
  while pos < len {
    let line_start = pos
    let mut line_end = pos
    while line_end < len && message[line_end].to_int() != 10 {
      line_end = line_end + 1
    }
    let next_pos = if line_end < len { line_end + 1 } else { len }
    let content_end = if line_end > line_start && message[line_end - 1].to_int() == 13 {
      line_end - 1
    } else {
      line_end
    }
    if mbox_needs_escape(message, line_start, content_end, flavor) {
      sb.write_byte((62).to_byte())
    }
    let mut i = line_start
    while i < next_pos {
      sb.write_byte(message[i])
      i = i + 1
    }
    pos = next_pos
  }
  if len == 0 || message[len - 1].to_int() != 10 {
    sb.write_byte((10).to_byte())
  }
  sb.write_byte((10).to_byte())
  Ok(sb.to_string().to_bytes())
}

///|
pub fn format_mbox(
  entries : Array[MboxEntry],
  flavor : MboxFlavor,
) -> Result[Bytes, EmailError] {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < entries.length() {
    let chunk = match format_mbox_entry(entries[i].from_line, entries[i].message, flavor) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    let mut j = 0
    while j < chunk.length() {
      sb.write_byte(chunk[j])
      j = j + 1
    }
    i = i + 1
  }
  Ok(sb.to_string().to_bytes())
}
