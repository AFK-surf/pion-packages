///| Iterative MIME email tree parser and body/inline/attachment extractor.

import "mime"

///|
pub struct Attachment {
  filename : String
  safe_filename : Option[String]
  content_type : String
  content_id : Option[String]
  is_inline : Bool
  body : Bytes
}

///|
pub struct MimePart {
  headers : Array[Header]
  content_type : String
  charset : String
  content_disposition : Option[String]
  filename : Option[String]
  safe_filename : Option[String]
  content_id : Option[String]
  transfer_encoding : String
  body : Bytes
  children : Array[MimePart]
}

///|
pub struct EmailMessage {
  headers : Array[Header]
  raw_header_bytes : Bytes
  raw_body_bytes : Bytes
  root : MimePart
}

///|
fn msg_ascii_lower_str(s : String) -> String {
  let len = s.length()
  let mut has_upper = false
  let mut k = 0
  while k < len {
    let c = s.code_unit_at(k)
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    k = k + 1
  }
  if !has_upper {
    return s
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    sb.write_byte(hdr_ascii_lower(s.code_unit_at(i)).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn msg_strip_angle_brackets(s : String) -> String {
  let t = hdr_trim_wsp(s)
  let len = t.length()
  if len >= 2 && t.code_unit_at(0) == 60 && t.code_unit_at(len - 1) == 62 {
    t.slice(1, len - 1)
  } else {
    t
  }
}

let msg_empty_bytes : Bytes = Bytes::new(0)

let msg_b64_lut : FixedArray[Int] = build_msg_b64_lut()

fn build_msg_b64_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, -1)
  let mut i = 0
  while i < 26 {
    lut[65 + i] = i
    lut[97 + i] = i + 26
    i = i + 1
  }
  let mut d = 0
  while d < 10 {
    lut[48 + d] = d + 52
    d = d + 1
  }
  lut[43] = 62
  lut[47] = 63
  lut[61] = -2
  lut
}

let msg_qp_lit_lut : FixedArray[Int] = build_msg_qp_lit_lut()

fn build_msg_qp_lit_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    if i == 9 || (i >= 32 && i <= 126) || i == 13 || i >= 128 {
      lut[i] = 1
    }
    i = i + 1
  }
  lut
}

let msg_tchar_lut : FixedArray[Int] = build_msg_tchar_lut()

fn build_msg_tchar_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 48
  while i <= 57 {
    lut[i] = 1
    i = i + 1
  }
  i = 65
  while i <= 90 {
    lut[i] = 1
    i = i + 1
  }
  i = 97
  while i <= 122 {
    lut[i] = 1
    i = i + 1
  }
  // !#$%&'*+-.^_`|~
  lut[33] = 1
  lut[35] = 1
  lut[36] = 1
  lut[37] = 1
  lut[38] = 1
  lut[39] = 1
  lut[42] = 1
  lut[43] = 1
  lut[45] = 1
  lut[46] = 1
  lut[94] = 1
  lut[95] = 1
  lut[96] = 1
  lut[124] = 1
  lut[126] = 1
  lut
}

///| RFC 2045 §6.8 single-pass Base64 decoder: ignores all characters outside the Base64 alphabet.
fn msg_decode_base64_permissive(raw : Bytes, start : Int, end : Int) -> Bytes {
  // Trim trailing CR/LF/SP/HTAB so single-line base64 allocates exact output size (0 copy on return)
  let mut clean_end = end
  while clean_end > start {
    let tc = raw[clean_end - 1].to_int()
    if tc == 10 || tc == 13 || tc == 32 || tc == 9 {
      clean_end = clean_end - 1
    } else {
      break
    }
  }
  let clen = clean_end - start
  if clen <= 0 {
    return msg_empty_bytes
  }
  let cap = if clen % 4 == 0 {
    let mut pad = 0
    if raw[clean_end - 1].to_int() == 61 {
      pad = 1
      if clen >= 2 && raw[clean_end - 2].to_int() == 61 {
        pad = 2
      }
    }
    (clen / 4) * 3 - pad
  } else {
    (clen * 3) / 4 + 4
  }
  if cap <= 0 {
    return msg_empty_bytes
  }
  let tmp = Bytes::new(cap)
  let lut = msg_b64_lut
  let mut out_len = 0
  let mut buf = 0
  let mut bits = 0
  let mut i = start
  while i < clean_end {
    if bits == 0 {
      while i + 4 <= clean_end {
        let v0 = lut[raw[i].to_int()]
        let v1 = lut[raw[i + 1].to_int()]
        let v2 = lut[raw[i + 2].to_int()]
        let v3 = lut[raw[i + 3].to_int()]
        if (v0 | v1 | v2 | v3) >= 0 {
          let n24 = (v0 << 18) | (v1 << 12) | (v2 << 6) | v3
          tmp[out_len] = ((n24 >> 16) & 0xFF).to_byte()
          tmp[out_len + 1] = ((n24 >> 8) & 0xFF).to_byte()
          tmp[out_len + 2] = (n24 & 0xFF).to_byte()
          out_len = out_len + 3
          i = i + 4
        } else {
          break
        }
      }
      if i >= clean_end {
        break
      }
    }
    let v = lut[raw[i].to_int()]
    if v == -2 {
      // Padding '=' ends the stream
      break
    }
    if v >= 0 {
      buf = (buf << 6) | v
      bits = bits + 6
      if bits >= 8 {
        bits = bits - 8
        tmp[out_len] = ((buf >> bits) & 0xFF).to_byte()
        out_len = out_len + 1
      }
    }
    i = i + 1
  }
  if out_len == cap {
    tmp
  } else {
    tmp.slice(0, out_len)
  }
}

///| Direct-range RFC 2045 §6.7 Quoted-Printable decoder (zero input slice copy).
fn msg_decode_qp_range(raw : Bytes, start : Int, end : Int) -> Result[Bytes, EmailError] {
  let len = end - start
  if len <= 0 {
    return Ok(Bytes::new(0))
  }
  let hlut = cs_hex_lut
  let llut = msg_qp_lit_lut
  let out = Bytes::new(len)
  let mut opos = 0
  let mut pos = start
  while pos < end {
    let line_start = pos
    let mut line_end = end
    let mut eol_kind = 0
    let mut next_pos = end
    while pos < end {
      let c = raw[pos].to_int()
      if c == 10 {
        if pos > line_start && raw[pos - 1].to_int() == 13 {
          line_end = pos - 1
          eol_kind = 2
        } else {
          line_end = pos
          eol_kind = 1
        }
        next_pos = pos + 1
        break
      }
      pos = pos + 1
    }
    let mut trimmed_end = line_end
    while trimmed_end > line_start {
      let tc = raw[trimmed_end - 1].to_int()
      if tc == 32 || tc == 9 {
        trimmed_end = trimmed_end - 1
      } else {
        break
      }
    }
    let mut soft_break = false
    let mut body_end = trimmed_end
    if trimmed_end > line_start && raw[trimmed_end - 1].to_int() == 61 {
      soft_break = true
      body_end = trimmed_end - 1
    }
    let mut i = line_start
    while i < body_end {
      let c = raw[i].to_int()
      if c == 61 {
        if i + 2 < body_end {
          let hi = hlut[raw[i + 1].to_int()]
          let lo = hlut[raw[i + 2].to_int()]
          if hi >= 0 && lo >= 0 {
            out[opos] = ((hi << 4) | lo).to_byte()
            opos = opos + 1
            i = i + 3
            continue
          }
        }
        out[opos] = raw[i]
        opos = opos + 1
        i = i + 1
      } else if llut[c] == 1 {
        out[opos] = raw[i]
        opos = opos + 1
        i = i + 1
      } else {
        return Err(EmailError::InvalidEncoding("invalid quoted-printable body"))
      }
    }
    if !soft_break {
      if eol_kind == 2 {
        out[opos] = (13).to_byte()
        out[opos + 1] = (10).to_byte()
        opos = opos + 2
      } else if eol_kind == 1 {
        out[opos] = (10).to_byte()
        opos = opos + 1
      }
    }
    pos = next_pos
  }
  Ok(if opos == len { out } else { out.slice(0, opos) })
}

///|
fn msg_decode_body_range(raw : Bytes, start : Int, end : Int, enc : String) -> Result[Bytes, EmailError] {
  if enc == "" || enc == "7bit" || enc == "8bit" || enc == "binary" {
    return Ok(if start == 0 && end == raw.length() { raw } else { raw.slice(start, end) })
  }
  if enc == "base64" {
    return Ok(msg_decode_base64_permissive(raw, start, end))
  }
  if enc == "quoted-printable" {
    return msg_decode_qp_range(raw, start, end)
  }
  // Unknown transfer-encoding: return raw bytes per Postel's law
  Ok(if start == 0 && end == raw.length() { raw } else { raw.slice(start, end) })
}

///| Fast-path ASCII range case-insensitive equality against a lowercase literal.
fn msg_slice_eq_lower(s : String, start : Int, end : Int, target : String) -> Bool {
  let len = end - start
  if len != target.length() {
    return false
  }
  let mut i = 0
  while i < len {
    let c = s.code_unit_at(start + i)
    let lc = if c >= 65 && c <= 90 { c + 32 } else { c }
    if lc != target.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Fast-path Content-Type parser for standard headers without RFC 2231 `*`, escapes, or comments.
///| Returns `None` to fall back to `mime::parse_media_type`.
fn msg_parse_ct_fast(
  s : String,
) -> Option[(String, String, Option[String], Option[String])] {
  let len = s.length()
  let tlut = msg_tchar_lut
  let mut i = 0
  while i < len {
    let c = s.code_unit_at(i)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      i = i + 1
    } else {
      break
    }
  }
  let type_start = i
  while i < len {
    let c = s.code_unit_at(i)
    if c < 256 && tlut[c] == 1 {
      i = i + 1
    } else {
      break
    }
  }
  if i == type_start || i >= len || s.code_unit_at(i) != 47 {
    return None
  }
  i = i + 1
  let sub_start = i
  while i < len {
    let c = s.code_unit_at(i)
    if c < 256 && tlut[c] == 1 {
      i = i + 1
    } else {
      break
    }
  }
  if i == sub_start {
    return None
  }
  let elen = i - type_start
  let essence = if elen == 10 && msg_slice_eq_lower(s, type_start, i, "text/plain") {
    "text/plain"
  } else if elen == 9 && msg_slice_eq_lower(s, type_start, i, "text/html") {
    "text/html"
  } else if elen == 15 && msg_slice_eq_lower(s, type_start, i, "multipart/mixed") {
    "multipart/mixed"
  } else if elen == 21 && msg_slice_eq_lower(s, type_start, i, "multipart/alternative") {
    "multipart/alternative"
  } else if elen == 17 && msg_slice_eq_lower(s, type_start, i, "multipart/related") {
    "multipart/related"
  } else if elen == 24 && msg_slice_eq_lower(s, type_start, i, "application/octet-stream") {
    "application/octet-stream"
  } else if elen == 14 && msg_slice_eq_lower(s, type_start, i, "message/rfc822") {
    "message/rfc822"
  } else {
    msg_ascii_lower_str(s.slice(type_start, i))
  }
  let mut charset = "us-ascii"
  let mut boundary : Option[String] = None
  let mut ct_name : Option[String] = None
  let mut seen_cs = false
  let mut seen_bnd = false
  let mut seen_name = false

  while i < len {
    let c = s.code_unit_at(i)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      i = i + 1
    } else {
      break
    }
  }
  while i < len {
    if s.code_unit_at(i) != 59 {
      return None
    }
    i = i + 1
    while i < len {
      let c = s.code_unit_at(i)
      if c == 32 || c == 9 || c == 13 || c == 10 {
        i = i + 1
      } else {
        break
      }
    }
    if i >= len {
      break
    }
    let pstart = i
    while i < len {
      let c = s.code_unit_at(i)
      if c == 42 {
        // RFC 2231 extended/continuation parameter -> fall back
        return None
      }
      if c < 256 && tlut[c] == 1 {
        i = i + 1
      } else {
        break
      }
    }
    let pend = i
    if pend == pstart {
      return None
    }
    while i < len {
      let c = s.code_unit_at(i)
      if c == 32 || c == 9 || c == 13 || c == 10 {
        i = i + 1
      } else {
        break
      }
    }
    if i >= len || s.code_unit_at(i) != 61 {
      return None
    }
    i = i + 1
    while i < len {
      let c = s.code_unit_at(i)
      if c == 32 || c == 9 || c == 13 || c == 10 {
        i = i + 1
      } else {
        break
      }
    }
    if i >= len {
      return None
    }
    let vstart : Int = if s.code_unit_at(i) == 34 {
      i = i + 1
      let qs = i
      while i < len {
        let qc = s.code_unit_at(i)
        if qc == 92 {
          // Backslash escape -> fall back
          return None
        }
        if qc == 34 {
          break
        }
        i = i + 1
      }
      if i >= len || s.code_unit_at(i) != 34 {
        return None
      }
      qs
    } else {
      let ts = i
      while i < len {
        let tc = s.code_unit_at(i)
        if tc < 256 && tlut[tc] == 1 {
          i = i + 1
        } else {
          break
        }
      }
      if i == ts {
        return None
      }
      ts
    }
    let vend = i
    if i < len && s.code_unit_at(i) == 34 {
      i = i + 1
    }
    let plen = pend - pstart
    if plen == 7 && msg_slice_eq_lower(s, pstart, pend, "charset") {
      if seen_cs {
        return None
      }
      seen_cs = true
      let vlen = vend - vstart
      charset = if vlen == 5 && msg_slice_eq_lower(s, vstart, vend, "utf-8") {
        "utf-8"
      } else if vlen == 8 && msg_slice_eq_lower(s, vstart, vend, "us-ascii") {
        "us-ascii"
      } else if vlen == 10 && msg_slice_eq_lower(s, vstart, vend, "iso-8859-1") {
        "iso-8859-1"
      } else {
        msg_ascii_lower_str(s.slice(vstart, vend))
      }
    } else if plen == 8 && msg_slice_eq_lower(s, pstart, pend, "boundary") {
      if seen_bnd {
        return None
      }
      seen_bnd = true
      boundary = Some(s.slice(vstart, vend))
    } else if plen == 4 && msg_slice_eq_lower(s, pstart, pend, "name") {
      if seen_name {
        return None
      }
      seen_name = true
      ct_name = Some(s.slice(vstart, vend))
    }
    while i < len {
      let c = s.code_unit_at(i)
      if c == 32 || c == 9 || c == 13 || c == 10 {
        i = i + 1
      } else {
        break
      }
    }
  }
  Some((essence, charset, boundary, ct_name))
}

///| Check if a filename is strictly safe ASCII `[A-Za-z0-9._-]` without path/DOS hazards.
fn msg_is_simple_safe_filename(name : String) -> Bool {
  let len = name.length()
  if len == 0 || len > 255 {
    return false
  }
  if name.code_unit_at(0) == 46 || name.code_unit_at(len - 1) == 46 {
    return false
  }
  let mut dot_pos = len
  let mut prev_dot = false
  let mut i = 0
  while i < len {
    let c = name.code_unit_at(i)
    let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
    c == 46 || c == 95 || c == 45
    if !ok {
      return false
    }
    if c == 46 {
      if prev_dot {
        return false
      }
      if dot_pos == len {
        dot_pos = i
      }
      prev_dot = true
    } else {
      prev_dot = false
    }
    i = i + 1
  }
  // Reject Windows reserved device stems (CON, PRN, AUX, NUL, COM1..9, LPT1..9)
  if dot_pos == 3 {
    if msg_slice_eq_lower(name, 0, 3, "con") ||
    msg_slice_eq_lower(name, 0, 3, "prn") ||
    msg_slice_eq_lower(name, 0, 3, "aux") ||
    msg_slice_eq_lower(name, 0, 3, "nul") {
      return false
    }
  } else if dot_pos == 4 {
    let d3 = name.code_unit_at(3)
    if d3 >= 49 && d3 <= 57 {
      if msg_slice_eq_lower(name, 0, 3, "com") || msg_slice_eq_lower(name, 0, 3, "lpt") {
        return false
      }
    }
  }
  true
}

///| Fast-path Content-Disposition parser for simple `attachment`/`inline` with ASCII filename.
///| Returns `None` to fall back to `mime::parse_content_disposition`.
fn msg_parse_cd_fast(s : String) -> Option[(String, Option[String], Option[String])] {
  let len = s.length()
  let tlut = msg_tchar_lut
  let mut i = 0
  while i < len {
    let c = s.code_unit_at(i)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      i = i + 1
    } else {
      break
    }
  }
  let dstart = i
  while i < len {
    let c = s.code_unit_at(i)
    if c < 256 && tlut[c] == 1 {
      i = i + 1
    } else {
      break
    }
  }
  if i == dstart {
    return None
  }
  let dlen = i - dstart
  let disp = if dlen == 10 && msg_slice_eq_lower(s, dstart, i, "attachment") {
    "attachment"
  } else if dlen == 6 && msg_slice_eq_lower(s, dstart, i, "inline") {
    "inline"
  } else {
    msg_ascii_lower_str(s.slice(dstart, i))
  }
  let mut fname : Option[String] = None
  let mut safe_fn : Option[String] = None
  let mut seen_fn = false

  while i < len {
    let c = s.code_unit_at(i)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      i = i + 1
    } else {
      break
    }
  }
  while i < len {
    if s.code_unit_at(i) != 59 {
      return None
    }
    i = i + 1
    while i < len {
      let c = s.code_unit_at(i)
      if c == 32 || c == 9 || c == 13 || c == 10 {
        i = i + 1
      } else {
        break
      }
    }
    if i >= len {
      break
    }
    let pstart = i
    while i < len {
      let c = s.code_unit_at(i)
      if c == 42 {
        return None
      }
      if c < 256 && tlut[c] == 1 {
        i = i + 1
      } else {
        break
      }
    }
    let pend = i
    if pend == pstart {
      return None
    }
    while i < len {
      let c = s.code_unit_at(i)
      if c == 32 || c == 9 || c == 13 || c == 10 {
        i = i + 1
      } else {
        break
      }
    }
    if i >= len || s.code_unit_at(i) != 61 {
      return None
    }
    i = i + 1
    while i < len {
      let c = s.code_unit_at(i)
      if c == 32 || c == 9 || c == 13 || c == 10 {
        i = i + 1
      } else {
        break
      }
    }
    if i >= len {
      return None
    }
    let is_q = s.code_unit_at(i) == 34
    let vstart = if is_q {
      i = i + 1
      let qs = i
      while i < len {
        let qc = s.code_unit_at(i)
        if qc == 92 {
          return None
        }
        if qc == 34 {
          break
        }
        i = i + 1
      }
      if i >= len || s.code_unit_at(i) != 34 {
        return None
      }
      qs
    } else {
      let ts = i
      while i < len {
        let tc = s.code_unit_at(i)
        if tc < 256 && tlut[tc] == 1 {
          i = i + 1
        } else {
          break
        }
      }
      if i == ts {
        return None
      }
      ts
    }
    let vend = i
    if is_q {
      i = i + 1
    }
    if pend - pstart == 8 && msg_slice_eq_lower(s, pstart, pend, "filename") {
      if seen_fn {
        return None
      }
      seen_fn = true
      let f = s.slice(vstart, vend)
      if !msg_is_simple_safe_filename(f) {
        return None
      }
      fname = Some(f)
      safe_fn = Some(f)
    }
    while i < len {
      let c = s.code_unit_at(i)
      if c == 32 || c == 9 || c == 13 || c == 10 {
        i = i + 1
      } else {
        break
      }
    }
  }
  Some((disp, fname, safe_fn))
}

///|
fn msg_is_multipart(essence : String) -> Bool {
  essence.length() >= 10 &&
  essence.code_unit_at(0) == 109 &&
  essence.code_unit_at(9) == 47 &&
  essence.slice(0, 10) == "multipart/"
}

///|
fn msg_safe_filename_from_raw(raw_name : String) -> Option[String] {
  let sb = StringBuilder::new()
  sb.write_string("attachment; filename=\"")
  let len = raw_name.length()
  let mut i = 0
  while i < len {
    let c = raw_name.code_unit_at(i)
    if c == 34 || c == 92 {
      sb.write_byte((92).to_byte())
    }
    sb.write_byte(c.to_byte())
    i = i + 1
  }
  sb.write_byte((34).to_byte())
  match mime::parse_content_disposition(sb.to_string()) {
    Ok(cd) => cd.safe_filename()
    Err(_) => None
  }
}

///| Zero-copy RFC 2046 §5.1.1 multipart splitter over `raw[start..end)`.
///| Tolerates a missing close-delimiter `--boundary--` while strictly checking delimiter suffix.
fn msg_split_multipart(
  raw : Bytes,
  start : Int,
  end : Int,
  boundary : String,
  max_parts : Int,
) -> Result[Array[(Int, Int)], EmailError] {
  let blen = boundary.length()
  if blen == 0 || blen > 200 {
    return Err(EmailError::InvalidMime("invalid multipart boundary"))
  }
  let parts : Array[(Int, Int)] = Array::with_capacity(4)
  let b0 = boundary.code_unit_at(0)
  let mut pos = start
  let mut in_part = false
  let mut part_start = start

  while pos < end {
    // Check if current line starts with `--<boundary>`
    if pos + 2 + blen <= end &&
    raw[pos].to_int() == 45 &&
    raw[pos + 1].to_int() == 45 &&
    (raw[pos + 2].to_int() & 0xFF) == b0 {
      let mut eq = true
      let mut k = 1
      while k < blen {
        if (raw[pos + 2 + k].to_int() & 0xFF) != boundary.code_unit_at(k) {
          eq = false
          break
        }
        k = k + 1
      }
      if eq {
        let mut after = pos + 2 + blen
        let is_close = after + 2 <= end && raw[after].to_int() == 45 && raw[after + 1].to_int() == 45
        if is_close {
          after = after + 2
        }
        // RFC 2046 §5.1.1: optional transport padding (SP/HTAB) before CRLF/LF/EOF
        while after < end && (raw[after].to_int() == 32 || raw[after].to_int() == 9) {
          after = after + 1
        }
        let valid_eol = after == end ||
        raw[after].to_int() == 10 ||
        (raw[after].to_int() == 13 && after + 1 < end && raw[after + 1].to_int() == 10)
        if valid_eol {
          if in_part {
            // The CRLF/LF immediately preceding the delimiter belongs to the delimiter, not the part
            let mut pend = pos
            if pend >= part_start + 2 && raw[pend - 2].to_int() == 13 && raw[pend - 1].to_int() == 10 {
              pend = pend - 2
            } else if pend >= part_start + 1 && raw[pend - 1].to_int() == 10 {
              pend = pend - 1
            }
            parts.push((part_start, pend))
            if parts.length() > max_parts {
              return Err(EmailError::LimitExceeded("MIME part count exceeds max_parts"))
            }
          }
          if is_close {
            return Ok(parts)
          }
          // Advance past delimiter line ending
          let mut next_start = after
          if next_start < end && raw[next_start].to_int() == 13 && next_start + 1 < end && raw[next_start + 1].to_int() == 10 {
            next_start = next_start + 2
          } else if next_start < end && raw[next_start].to_int() == 10 {
            next_start = next_start + 1
          }
          in_part = true
          part_start = next_start
          pos = next_start
          continue
        }
      }
    }
    // Advance to the start of the next line (4x unrolled)
    while pos + 4 <= end &&
    raw[pos].to_int() != 10 &&
    raw[pos + 1].to_int() != 10 &&
    raw[pos + 2].to_int() != 10 &&
    raw[pos + 3].to_int() != 10 {
      pos = pos + 4
    }
    while pos < end && raw[pos].to_int() != 10 {
      pos = pos + 1
    }
    if pos < end {
      pos = pos + 1
    }
  }

  // Tolerate missing close-delimiter: keep the trailing open part if any
  if in_part {
    parts.push((part_start, end))
    if parts.length() > max_parts {
      return Err(EmailError::LimitExceeded("MIME part count exceeds max_parts"))
    }
  }
  Ok(parts)
}

///|
struct PartWork {
  parent_idx : Int
  headers : Array[Header]
  buf : Bytes
  start : Int
  end : Int
  depth : Int
}

///|
fn parse_part_tree_iterative(
  top_headers : Array[Header],
  raw_buf : Bytes,
  body_start : Int,
  body_end : Int,
  limits : EmailLimits,
) -> Result[MimePart, EmailError] {
  // Hard safety ceiling prevents O(N^2) memory amplification even when caller raises max_depth
  let hard_max_depth = 256
  let eff_max_depth = if limits.max_depth < hard_max_depth { limits.max_depth } else { hard_max_depth }

  let stack : Array[PartWork] = Array::with_capacity(8)
  stack.push(
    PartWork::{
      parent_idx: -1,
      headers: top_headers,
      buf: raw_buf,
      start: body_start,
      end: body_end,
      depth: 0,
    },
  )
  let nodes : Array[MimePart] = Array::with_capacity(8)
  let parent_of : Array[Int] = Array::with_capacity(8)
  let mut part_count = 0

  while stack.length() > 0 {
    let work = stack[stack.length() - 1]
    let _ = stack.pop()

    if work.depth > eff_max_depth {
      return Err(EmailError::LimitExceeded("MIME nesting depth exceeds max_depth"))
    }
    if part_count >= limits.max_parts {
      return Err(EmailError::LimitExceeded("MIME part count exceeds max_parts"))
    }
    part_count = part_count + 1

    // Single-pass scan for the 4 MIME headers
    let mut ct_opt : Option[String] = None
    let mut cd_opt : Option[String] = None
    let mut cid_opt : Option[String] = None
    let mut te_opt : Option[String] = None
    let mut hi = 0
    while hi < work.headers.length() {
      let h = work.headers[hi]
      let hlen = h.name.length()
      if hlen == 12 && ct_opt is None && hdr_eq_ignore_case(h.name, "Content-Type") {
        ct_opt = Some(h.value)
      } else if hlen == 19 && cd_opt is None && hdr_eq_ignore_case(h.name, "Content-Disposition") {
        cd_opt = Some(h.value)
      } else if hlen == 10 && cid_opt is None && hdr_eq_ignore_case(h.name, "Content-ID") {
        cid_opt = Some(h.value)
      } else if hlen == 25 && te_opt is None && hdr_eq_ignore_case(h.name, "Content-Transfer-Encoding") {
        te_opt = Some(h.value)
      }
      hi = hi + 1
    }

    // Parse Content-Type
    let mut content_type = "text/plain"
    let mut charset = "us-ascii"
    let mut boundary : Option[String] = None
    let mut ct_name : Option[String] = None
    match ct_opt {
      Some(ct_raw) =>
      match msg_parse_ct_fast(ct_raw) {
        Some((ess, cs, bnd, nm)) => {
          content_type = ess
          charset = cs
          boundary = bnd
          ct_name = nm
        }
        None =>
        match mime::parse_media_type(ct_raw) {
          Ok(mt) => {
            content_type = mt.essence()
            match mt.param("charset") {
              Some(cs) => charset = msg_ascii_lower_str(cs)
              None => ()
            }
            boundary = mt.param("boundary")
            ct_name = mt.param("name")
          }
          Err(_) => ()
        }
      }
      None => ()
    }

    // Parse Content-Disposition (+ RFC 2047 filename decoding)
    let mut disp_type : Option[String] = None
    let mut filename : Option[String] = None
    let mut safe_filename : Option[String] = None
    match cd_opt {
      Some(cd_raw) =>
      match msg_parse_cd_fast(cd_raw) {
        Some((d, fn_opt, sfn_opt)) => {
          disp_type = Some(d)
          filename = fn_opt
          safe_filename = sfn_opt
        }
        None =>
        match mime::parse_content_disposition(cd_raw) {
          Ok(cd) => {
            disp_type = Some(cd.disposition)
            match cd.filename() {
              Some(fn_raw) =>
              if fn_raw.contains("=?") {
                let dec_fn = email_decode_rfc2047(fn_raw)
                filename = Some(dec_fn)
                safe_filename = msg_safe_filename_from_raw(dec_fn)
              } else {
                filename = Some(fn_raw)
                safe_filename = cd.safe_filename()
              }
              None => ()
            }
          }
          Err(_) => ()
        }
      }
      None => ()
    }
    match (filename, ct_name) {
      (None, Some(n_raw)) => {
        let dec_n = if n_raw.contains("=?") { email_decode_rfc2047(n_raw) } else { n_raw }
        filename = Some(dec_n)
        safe_filename = msg_safe_filename_from_raw(dec_n)
      }
      _ => ()
    }

    // Parse Content-ID
    let content_id = match cid_opt {
      Some(cid) => {
        let stripped = msg_strip_angle_brackets(cid)
        if stripped.length() > 0 { Some(stripped) } else { None }
      }
      None => None
    }

    // Parse Content-Transfer-Encoding (header values are already WSP-trimmed)
    let transfer_encoding = match te_opt {
      Some(te) => msg_ascii_lower_str(te)
      None => "7bit"
    }

    let node_idx = nodes.length()
    parent_of.push(work.parent_idx)

    if msg_is_multipart(content_type) {
      match boundary {
        Some(b) => {
          let spans = match msg_split_multipart(work.buf, work.start, work.end, b, limits.max_parts) {
            Ok(ps) => ps
            Err(e) => return Err(e)
          }
          nodes.push(
            MimePart::{
              headers: work.headers,
              content_type: content_type,
              charset: charset,
              content_disposition: disp_type,
              filename: filename,
              safe_filename: safe_filename,
              content_id: content_id,
              transfer_encoding: transfer_encoding,
              body: msg_empty_bytes,
              children: [],
            },
          )
          // Push children in reverse order so they pop in document order
          let mut pi = spans.length() - 1
          while pi >= 0 {
            let (ps, pe) = spans[pi]
            let (sub_hdrs, sub_body_off) = match parse_headers_range(work.buf, ps, pe, limits) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            stack.push(
              PartWork::{
                parent_idx: node_idx,
                headers: sub_hdrs,
                buf: work.buf,
                start: sub_body_off,
                end: pe,
                depth: work.depth + 1,
              },
            )
            pi = pi - 1
          }
          continue
        }
        None => {
          let raw_slice = work.buf.slice(work.start, work.end)
          nodes.push(
            MimePart::{
              headers: work.headers,
              content_type: content_type,
              charset: charset,
              content_disposition: disp_type,
              filename: filename,
              safe_filename: safe_filename,
              content_id: content_id,
              transfer_encoding: transfer_encoding,
              body: raw_slice,
              children: [],
            },
          )
          continue
        }
      }
    }

    if content_type == "message/rfc822" {
      let decoded = match msg_decode_body_range(work.buf, work.start, work.end, transfer_encoding) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      nodes.push(
        MimePart::{
          headers: work.headers,
          content_type: content_type,
          charset: charset,
          content_disposition: disp_type,
          filename: filename,
          safe_filename: safe_filename,
          content_id: content_id,
          transfer_encoding: transfer_encoding,
          body: decoded,
          children: [],
        },
      )
      match parse_headers_range(decoded, 0, decoded.length(), limits) {
        Ok((sub_hdrs, sub_off)) =>
        stack.push(
          PartWork::{
            parent_idx: node_idx,
            headers: sub_hdrs,
            buf: decoded,
            start: sub_off,
            end: decoded.length(),
            depth: work.depth + 1,
          },
        )
        Err(_) => ()
      }
      continue
    }

    let decoded = match msg_decode_body_range(work.buf, work.start, work.end, transfer_encoding) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    nodes.push(
      MimePart::{
        headers: work.headers,
        content_type: content_type,
        charset: charset,
        content_disposition: disp_type,
        filename: filename,
        safe_filename: safe_filename,
        content_id: content_id,
        transfer_encoding: transfer_encoding,
        body: decoded,
        children: [],
      },
    )
  }

  // Assemble children in document order (MimePart is a reference struct)
  let mut ni = 1
  while ni < nodes.length() {
    let p = parent_of[ni]
    if p >= 0 {
      nodes[p].children.push(nodes[ni])
    }
    ni = ni + 1
  }
  Ok(nodes[0])
}

///|
pub fn parse_message(raw : Bytes) -> Result[EmailMessage, EmailError] {
  parse_message_with_limits(raw, EmailLimits::default())
}

///|
pub fn parse_message_with_limits(
  raw : Bytes,
  limits : EmailLimits,
) -> Result[EmailMessage, EmailError] {
  let (top_headers, body_off) = match parse_headers(raw, limits) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let body_len = raw.length() - body_off
  if body_len > limits.max_body_bytes {
    return Err(EmailError::LimitExceeded("message body exceeds max_body_bytes"))
  }
  let raw_header_bytes = raw.slice(0, body_off)
  let raw_body_bytes = raw.slice(body_off, raw.length())
  let root = match parse_part_tree_iterative(top_headers, raw, body_off, raw.length(), limits) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  Ok(
    EmailMessage::{
      headers: top_headers,
      raw_header_bytes: raw_header_bytes,
      raw_body_bytes: raw_body_bytes,
      root: root,
    },
  )
}

///|
pub fn EmailMessage::header(self : EmailMessage, name : String) -> Option[String] {
  headers_get(self.headers, name)
}

///|
pub fn EmailMessage::header_decoded(self : EmailMessage, name : String) -> Option[String] {
  headers_get_decoded(self.headers, name)
}

///|
pub fn EmailMessage::headers_all(self : EmailMessage, name : String) -> Array[String] {
  headers_get_all(self.headers, name)
}

///|
pub fn EmailMessage::subject(self : EmailMessage) -> Option[String] {
  headers_get_decoded(self.headers, "Subject")
}

///|
pub fn EmailMessage::message_id(self : EmailMessage) -> Option[String] {
  headers_get(self.headers, "Message-ID")
}

///|
fn msg_parse_addr_header(
  self : EmailMessage,
  name : String,
) -> Result[Array[Mailbox], EmailError] {
  match headers_get(self.headers, name) {
    None => Ok([])
    Some(v) =>
    match parse_address_list(v) {
      Ok(addrs) => Ok(flatten_addresses(addrs))
      Err(e) => Err(e)
    }
  }
}

///|
pub fn EmailMessage::from(self : EmailMessage) -> Result[Array[Mailbox], EmailError] {
  msg_parse_addr_header(self, "From")
}

///|
pub fn EmailMessage::to(self : EmailMessage) -> Result[Array[Mailbox], EmailError] {
  msg_parse_addr_header(self, "To")
}

///|
pub fn EmailMessage::cc(self : EmailMessage) -> Result[Array[Mailbox], EmailError] {
  msg_parse_addr_header(self, "Cc")
}

///|
pub fn EmailMessage::date(self : EmailMessage) -> Result[Option[EmailDate], EmailError] {
  match headers_get(self.headers, "Date") {
    None => Ok(None)
    Some(v) =>
    match parse_date(v) {
      Ok(d) => Ok(Some(d))
      Err(e) => Err(e)
    }
  }
}

///|
fn part_is_attachment_disp(p : MimePart) -> Bool {
  match p.content_disposition {
    Some(d) => d == "attachment"
    None => false
  }
}

///|
fn part_is_inline_resource(p : MimePart) -> Bool {
  match p.content_disposition {
    Some(d) =>
    if d == "inline" {
      match (p.content_id, p.filename) {
        (Some(_), _) => true
        (_, Some(_)) => true
        _ => p.content_type != "text/plain" && p.content_type != "text/html"
      }
    } else {
      false
    }
    None =>
    match p.content_id {
      Some(_) => p.content_type != "text/plain" && p.content_type != "text/html"
      None => false
    }
  }
}

///|
fn find_body_part(p : MimePart, target_ct : String) -> Option[MimePart] {
  if msg_is_multipart(p.content_type) {
    let mut i = 0
    let n = p.children.length()
    while i < n {
      match find_body_part(p.children[i], target_ct) {
        Some(found) => return Some(found)
        None => ()
      }
      i = i + 1
    }
    None
  } else if p.content_type == target_ct && !part_is_attachment_disp(p) {
    Some(p)
  } else {
    None
  }
}

///|
fn collect_attachments_rec(p : MimePart, out : Array[Attachment]) -> Unit {
  if msg_is_multipart(p.content_type) {
    let mut i = 0
    let n = p.children.length()
    while i < n {
      collect_attachments_rec(p.children[i], out)
      i = i + 1
    }
  } else {
    let is_att = part_is_attachment_disp(p) ||
    (!part_is_inline_resource(p) &&
      p.content_type != "text/plain" &&
      p.content_type != "text/html")
    if is_att {
      let fname = match p.filename {
        Some(f) => f
        None => ""
      }
      out.push(
        Attachment::{
          filename: fname,
          safe_filename: p.safe_filename,
          content_type: p.content_type,
          content_id: p.content_id,
          is_inline: false,
          body: p.body,
        },
      )
    }
  }
}

///|
fn collect_inlines_rec(p : MimePart, out : Array[Attachment]) -> Unit {
  if msg_is_multipart(p.content_type) {
    let mut i = 0
    let n = p.children.length()
    while i < n {
      collect_inlines_rec(p.children[i], out)
      i = i + 1
    }
  } else if part_is_inline_resource(p) {
    let fname = match p.filename {
      Some(f) => f
      None => ""
    }
    out.push(
      Attachment::{
        filename: fname,
        safe_filename: p.safe_filename,
        content_type: p.content_type,
        content_id: p.content_id,
        is_inline: true,
        body: p.body,
      },
    )
  }
}

///|
fn find_part_by_cid_rec(p : MimePart, target : String) -> Option[Attachment] {
  if msg_is_multipart(p.content_type) {
    let mut i = 0
    let n = p.children.length()
    while i < n {
      match find_part_by_cid_rec(p.children[i], target) {
        Some(found) => return Some(found)
        None => ()
      }
      i = i + 1
    }
    None
  } else {
    match p.content_id {
      Some(c) =>
      if c == target {
        let fname = match p.filename {
          Some(f) => f
          None => ""
        }
        Some(
          Attachment::{
            filename: fname,
            safe_filename: p.safe_filename,
            content_type: p.content_type,
            content_id: Some(c),
            is_inline: part_is_inline_resource(p),
            body: p.body,
          },
        )
      } else {
        None
      }
      None => None
    }
  }
}

///|
pub fn EmailMessage::text_body(self : EmailMessage) -> Option[String] {
  match find_body_part(self.root, "text/plain") {
    Some(p) => Some(decode_charset_to_utf8(p.body, p.charset))
    None => None
  }
}

///|
pub fn EmailMessage::html_body(self : EmailMessage) -> Option[String] {
  match find_body_part(self.root, "text/html") {
    Some(p) => Some(decode_charset_to_utf8(p.body, p.charset))
    None => None
  }
}

///|
pub fn EmailMessage::attachments(self : EmailMessage) -> Array[Attachment] {
  let out : Array[Attachment] = []
  collect_attachments_rec(self.root, out)
  out
}

///|
pub fn EmailMessage::inline_parts(self : EmailMessage) -> Array[Attachment] {
  let out : Array[Attachment] = []
  collect_inlines_rec(self.root, out)
  out
}

///|
pub fn EmailMessage::part_by_cid(
  self : EmailMessage,
  cid : String,
) -> Option[Attachment] {
  let target = msg_strip_angle_brackets(cid)
  find_part_by_cid_rec(self.root, target)
}
