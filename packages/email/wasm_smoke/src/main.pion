///| Native + Wasm32 4-mode smoke entry for `packages/email`.

import "email"
import "crypto"

///|
pub fn main(world : World) -> Int {
  // 1. Address list (quoted, nested comments, group, RFC 2047)
  let addrs = match email::parse_address_list(
    "\"Doe, John\" (dev (core)) <john@example.com>, Team: =?UTF-8?B?5byg5LiJ?= <zs@example.com>, bob@example.com;",
  ) {
    Ok(a) => a
    Err(_) => return 1
  }
  let flat = email::flatten_addresses(addrs)
  if flat.length() != 3 || flat[1].name != "张三" {
    return 2
  }

  // 2. RFC 5322 Date (legacy EST + numeric +0800)
  let d1 = match email::parse_date("Mon, 23 Nov 2026 12:00:00 +0800") {
    Ok(d) => d
    Err(_) => return 3
  }
  let d2 = match email::parse_date("Tue, 1 Jul 2003 10:52:37 EST (Eastern)") {
    Ok(d) => d
    Err(_) => return 4
  }
  if d2.offset_seconds != -18000 {
    return 5
  }

  // 3. Builder + parse_message roundtrip
  let from_mb = match email::Mailbox::new("张三", "zs@example.com") {
    Ok(m) => m
    Err(_) => return 6
  }
  let to_mb = match email::Mailbox::new("Bob", "bob@example.com") {
    Ok(m) => m
    Err(_) => return 7
  }
  let built = match email::EmailBuilder::new()
  .from(from_mb)
  .to(to_mb)
  .subject("Wasm 邮件测试")
  .date(d1)
  .message_id("<wasm-smoke@example.com>")
  .text_body("Hello Wasm32 世界")
  .html_body("<p>Hello <b>Wasm32</b></p>")
  .inline_part("img1", "logo.png", "image/png", "PNG123".to_bytes())
  .attach("report.pdf", "application/pdf", "%PDF-1.4".to_bytes())
  .boundary_seed("wasm-smoke-seed")
  .build()
  {
    Ok(b) => b
    Err(_) => return 8
  }

  // 4. DKIM relaxed/relaxed Ed25519 sign + verify
  let seed = Bytes::new(32)
  let mut i = 0
  while i < 32 {
    seed[i] = (i + 7).to_byte()
    i = i + 1
  }
  let pub_key = match crypto::ed25519_public_key(seed) {
    Ok(k) => k
    Err(_) => return 9
  }
  let cfg = email::DkimSignConfig::{
    domain: "example.com",
    selector: "ed2026",
    header_canon: email::DkimCanon::Relaxed,
    body_canon: email::DkimCanon::Relaxed,
    signed_headers: ["From", "To", "Subject", "Date"],
    timestamp: Some(1795435200L),
  }
  let signed = match email::dkim_sign_ed25519(built, cfg, seed) {
    Ok(b) => b
    Err(_) => return 10
  }
  let dkim_sig = match email::dkim_verify_ed25519(signed, pub_key) {
    Ok(s) => s
    Err(_) => return 11
  }

  // 5. Parse signed message
  let parsed = match email::parse_message(signed) {
    Ok(m) => m
    Err(_) => return 12
  }
  let subj = match parsed.subject() {
    Some(s) => s
    None => return 13
  }
  let txt = match parsed.text_body() {
    Some(s) => s
    None => return 14
  }
  let atts = parsed.attachments()
  if atts.length() != 1 {
    return 15
  }

  // 6. mboxrd roundtrip
  let mbox_bytes = match email::format_mbox(
    [email::MboxEntry::{ from_line: "zs@example.com Mon Nov 23 12:00:00 2026", message: signed }],
    email::MboxFlavor::Mboxrd,
  ) {
    Ok(b) => b
    Err(_) => return 16
  }
  let mbox_entries = match email::parse_mbox(mbox_bytes, email::MboxFlavor::Mboxrd) {
    Ok(e) => e
    Err(_) => return 17
  }
  if mbox_entries.length() != 1 {
    return 18
  }

  // 7. Injection defense
  match email::validate_header_value("bad\r\nBcc: x@y") {
    Err(email::EmailError::HeaderInjection(_)) => ()
    _ => return 19
  }

  io_println(world, "email_wasm_smoke=ok")
  io_println(world, "flat=" + flat.length().to_string() + ":" + flat[1].name)
  io_println(world, "date=" + d1.format() + "|" + d2.timestamp.to_string())
  io_println(world, "subj=" + subj)
  io_println(world, "txt=" + txt)
  io_println(world, "att=" + atts[0].content_type + ":" + atts[0].body.length().to_string())
  io_println(world, "dkim=" + dkim_sig.domain + ":" + dkim_sig.selector)
  io_println(world, "mbox=" + mbox_entries.length().to_string())
  0
}
