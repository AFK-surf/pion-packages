///| Nested MIME email tree parsing, attachment/inline extraction, and EmailBuilder tests.

///|
fn msg_opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///|
test "message_nested_mixed_related_alternative_and_attachments" {
  let raw = (
    "From: Alice <alice@example.com>\r\n" +
    "To: Bob <bob@example.com>\r\n" +
    "Subject: =?UTF-8?B?5ZCN5ZCN5rWL6K+V?=\r\n" +
    "Date: Mon, 23 Nov 2026 12:00:00 +0000\r\n" +
    "Message-ID: <msg-001@example.com>\r\n" +
    "MIME-Version: 1.0\r\n" +
    "Content-Type: multipart/mixed; boundary=\"MIXED\"\r\n" +
    "\r\n" +
    "--MIXED\r\n" +
    "Content-Type: multipart/related; boundary=\"REL\"\r\n" +
    "\r\n" +
    "--REL\r\n" +
    "Content-Type: multipart/alternative; boundary=\"ALT\"\r\n" +
    "\r\n" +
    "--ALT\r\n" +
    "Content-Type: text/plain; charset=utf-8\r\n" +
    "Content-Transfer-Encoding: quoted-printable\r\n" +
    "\r\n" +
    "Hello=20=E4=B8=96=E7=95=8C!\r\n" +
    "--ALT\r\n" +
    "Content-Type: text/html; charset=utf-8\r\n" +
    "Content-Transfer-Encoding: base64\r\n" +
    "\r\n" +
    "PGgxPkhlbGxvPC9oMT48aW1nIHNyYz0iY2lkOmxvZ28xIj4=\r\n" +
    "--ALT--\r\n" +
    "--REL\r\n" +
    "Content-Type: image/png; name=\"logo.png\"\r\n" +
    "Content-Disposition: inline; filename=\"logo.png\"\r\n" +
    "Content-ID: <logo1>\r\n" +
    "Content-Transfer-Encoding: base64\r\n" +
    "\r\n" +
    "iVBORw0KGgo=\r\n" +
    "--REL--\r\n" +
    "--MIXED\r\n" +
    "Content-Type: application/pdf\r\n" +
    "Content-Disposition: attachment; filename=\"../../etc/report.pdf\"\r\n" +
    "Content-Transfer-Encoding: base64\r\n" +
    "\r\n" +
    "JVBERi0xLjQ=\r\n" +
    "--MIXED--\r\n"
  ).to_bytes()

  let msg = match parse_message(raw) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "parse_message failed: " + e.to_string())
      return ()
    }
  }
  debug_assert(msg_opt_str_eq(msg.subject(), Some("名名测试")), "subject decoded")
  debug_assert(msg_opt_str_eq(msg.message_id(), Some("<msg-001@example.com>")), "message_id")
  debug_assert(msg_opt_str_eq(msg.text_body(), Some("Hello 世界!")), "qp text_body")
  debug_assert(
    msg_opt_str_eq(msg.html_body(), Some("<h1>Hello</h1><img src=\"cid:logo1\">")),
    "base64 html_body",
  )

  let inlines = msg.inline_parts()
  debug_assert(inlines.length() == 1, "1 inline part")
  debug_assert(msg_opt_str_eq(inlines[0].content_id, Some("logo1")), "cid stripped")
  debug_assert(inlines[0].body.length() == 8, "decoded png prefix length 8")

  match msg.part_by_cid("logo1") {
    Some(p) => debug_assert(p.content_type == "image/png", "part_by_cid found png")
    None => debug_assert(false, "part_by_cid missing")
  }

  let atts = msg.attachments()
  debug_assert(atts.length() == 1, "1 non-inline attachment")
  debug_assert(atts[0].content_type == "application/pdf", "pdf content_type")
  debug_assert(msg_opt_str_eq(atts[0].safe_filename, Some("report.pdf")), "safe_filename strips traversal")
  debug_assert(atts[0].body.to_string() == "%PDF-1.4", "decoded pdf bytes")
}

///|
test "message_rfc822_embedded_message" {
  let raw = (
    "From: outer@example.com\r\n" +
    "Subject: Fwd: Inner\r\n" +
    "Content-Type: multipart/mixed; boundary=\"OUT\"\r\n" +
    "\r\n" +
    "--OUT\r\n" +
    "Content-Type: text/plain\r\n" +
    "\r\n" +
    "See attached email.\r\n" +
    "--OUT\r\n" +
    "Content-Type: message/rfc822\r\n" +
    "\r\n" +
    "From: inner@example.com\r\n" +
    "Subject: Inner Subject\r\n" +
    "Content-Type: text/plain\r\n" +
    "\r\n" +
    "Inner body content.\r\n" +
    "--OUT--\r\n"
  ).to_bytes()

  let msg = match parse_message(raw) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "parse rfc822 failed: " + e.to_string())
      return ()
    }
  }
  debug_assert(msg_opt_str_eq(msg.text_body(), Some("See attached email.")), "outer text_body")
  debug_assert(msg.root.children.length() == 2, "2 children")
  let embedded = msg.root.children[1]
  debug_assert(embedded.content_type == "message/rfc822", "embedded media type")
  debug_assert(embedded.children.length() == 1, "embedded parsed child")
  debug_assert(
    embedded.children[0].body.to_string() == "Inner body content.\r\n" ||
    embedded.children[0].body.to_string() == "Inner body content.",
    "embedded body decoded",
  )
}

///|
test "builder_roundtrip_and_injection_defense" {
  let from_mb = match Mailbox::new("张三", "zhangsan@example.com") {
    Ok(m) => m
    Err(_) => {
      debug_assert(false, "from mailbox")
      return ()
    }
  }
  let to_mb = match Mailbox::new("Bob", "bob@example.com") {
    Ok(m) => m
    Err(_) => {
      debug_assert(false, "to mailbox")
      return ()
    }
  }
  let dt = match parse_date("Mon, 23 Nov 2026 12:00:00 +0800") {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "date")
      return ()
    }
  }
  let raw = match EmailBuilder::new()
  .from(from_mb)
  .to(to_mb)
  .subject("季度报告：Q4 总结与计划")
  .date(dt)
  .message_id("<q4-2026@example.com>")
  .header("X-Mailer", "pion-email/0.1")
  .text_body("Plain text version: 你好世界")
  .html_body("<p>HTML version: <b>你好世界</b><img src=\"cid:chart1\"></p>")
  .inline_part("chart1", "chart.png", "image/png", "PNGDATA".to_bytes())
  .attach("summary.bin", "application/octet-stream", "BINDATA123".to_bytes())
  .boundary_seed("deterministic-test-01")
  .build()
  {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "builder failed: " + e.to_string())
      return ()
    }
  }

  let parsed = match parse_message(raw) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "parse built email failed: " + e.to_string())
      return ()
    }
  }
  debug_assert(msg_opt_str_eq(parsed.subject(), Some("季度报告：Q4 总结与计划")), "roundtrip utf8 subject")
  debug_assert(msg_opt_str_eq(parsed.text_body(), Some("Plain text version: 你好世界")), "roundtrip text")
  debug_assert(
    msg_opt_str_eq(
      parsed.html_body(),
      Some("<p>HTML version: <b>你好世界</b><img src=\"cid:chart1\"></p>"),
    ),
    "roundtrip html",
  )
  match parsed.part_by_cid("chart1") {
    Some(p) => debug_assert(p.body.to_string() == "PNGDATA", "roundtrip inline")
    None => debug_assert(false, "missing inline part")
  }
  let atts = parsed.attachments()
  debug_assert(atts.length() == 1, "roundtrip 1 attachment")
  debug_assert(atts[0].body.to_string() == "BINDATA123", "roundtrip attachment bytes")
  debug_assert(msg_opt_str_eq(atts[0].safe_filename, Some("summary.bin")), "roundtrip filename")

  // Injection defense in builder
  match EmailBuilder::new()
  .from(from_mb)
  .to(to_mb)
  .subject("Bad\r\nBcc: attacker@evil.test")
  .text_body("hi")
  .build()
  {
    Err(EmailError::HeaderInjection(_)) => ()
    _ => debug_assert(false, "builder must reject CRLF in subject")
  }
  match EmailBuilder::new()
  .from(from_mb)
  .to(to_mb)
  .header("X-Evil", "val\nInjected: 1")
  .text_body("hi")
  .build()
  {
    Err(EmailError::HeaderInjection(_)) => ()
    _ => debug_assert(false, "builder must reject LF in custom header")
  }
}
