///| Wasm32 + Native release smoke entry for `packages/regex`.

import "regex"

///|
pub fn smoke() -> Int {
  let re = match regex::compile("(?P<year>\\d{4})-(?P<month>\\d{2})-(?P<day>\\d{2})") {
    Ok(v) => v
    Err(_) => return 1
  }
  let m1 = if re.is_match("date: 2026-11-23 ok") { 1 } else { 0 }
  let c1 = match re.captures("date: 2026-11-23 ok") {
    Some(caps) =>
    match caps.name("year") {
      Some(m) => if m.text == "2026" { 1 } else { 0 }
      None => 0
    }
    None => 0
  }
  let rep = re.replace_all("2026-11-23 and 2025-01-02", "$day/$month/$year")
  let r1 = if rep == "23/11/2026 and 02/01/2025" { 1 } else { 0 }

  let set = match regex::compile_set(["error", "warn\\d+", "^info:"]) {
    Ok(s) => s
    Err(_) => return 2
  }
  let hits = set.matches("info: warn42 error")
  let s1 = if hits.length() == 3 && hits[0] == 0 && hits[1] == 1 && hits[2] == 2 {
    1
  } else {
    0
  }

  let err_ok = match regex::compile("[unclosed") {
    Ok(_) => 0
    Err(_) => 1
  }
  m1 + c1 + r1 + s1 + err_ok
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  io_println(world, "regex_smoke=" + r.to_string())
  if r == 5 {
    0
  } else {
    1
  }
}
