///| Unicode UTF-8 utilities, character range algebra, Unicode property tables,
///| case folding, and Cox/Rust `utf8_sequences` range-to-UTF-8-byte-automaton compiler.

///| Inclusive Unicode scalar value range `[lo, hi]`.
pub val struct CharRange {
  pub lo : Int
  pub hi : Int
}

///| A single byte range `[lo, hi]` (0..255).
pub val struct ByteRange {
  pub lo : Int
  pub hi : Int
}

///| A 1..4 byte UTF-8 sequence of byte ranges.
pub val struct Utf8Seq {
  pub len : Int
  pub b0_lo : Int
  pub b0_hi : Int
  pub b1_lo : Int
  pub b1_hi : Int
  pub b2_lo : Int
  pub b2_hi : Int
  pub b3_lo : Int
  pub b3_hi : Int
}

///| Decode one UTF-8 codepoint from `s` starting at byte offset `pos`.
///| Returns `(codepoint, next_pos)`.
pub fn decode_utf8(s : String, pos : Int) -> (Int, Int) {
  let n = s.length()
  if pos >= n {
    return (0, pos)
  }
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0, pos + 1)
  }
  if b0 >= 0xC2 && b0 <= 0xDF && pos + 1 < n {
    let b1 = s.code_unit_at(pos + 1)
    if (b1 & 0xC0) == 0x80 {
      return (((b0 & 0x1F) << 6) | (b1 & 0x3F), pos + 2)
    }
  } else if b0 >= 0xE0 && b0 <= 0xEF && pos + 2 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      return (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), pos + 3)
    }
  } else if b0 >= 0xF0 && b0 <= 0xF4 && pos + 3 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      return (
        ((b0 & 0x07) << 18) |
        ((b1 & 0x3F) << 12) |
        ((b2 & 0x3F) << 6) |
        (b3 & 0x3F),
        pos + 4,
      )
    }
  }
  (b0, pos + 1)
}

///| Decode the UTF-8 codepoint immediately BEFORE byte offset `pos`.
pub fn decode_utf8_before(s : String, pos : Int) -> Int {
  if pos <= 0 {
    return -1
  }
  let b1 = s.code_unit_at(pos - 1)
  if b1 < 0x80 {
    return b1
  }
  let mut p = pos - 1
  let limit = if pos >= 4 { pos - 4 } else { 0 }
  while p > limit && (s.code_unit_at(p) & 0xC0) == 0x80 {
    p = p - 1
  }
  let (cp, _) = decode_utf8(s, p)
  cp
}

///| Return byte length of the UTF-8 character starting at `pos` in `s` (at least 1).
pub fn utf8_char_len_at(s : String, pos : Int) -> Int {
  let n = s.length()
  if pos >= n {
    return 0
  }
  let b = s.code_unit_at(pos)
  if b < 0x80 {
    1
  } else if b < 0xE0 {
    if pos + 2 <= n { 2 } else { n - pos }
  } else if b < 0xF0 {
    if pos + 3 <= n { 3 } else { n - pos }
  } else if pos + 4 <= n {
    4
  } else {
    n - pos
  }
}

///| Encode a Unicode scalar value into 1..4 UTF-8 bytes.
pub fn encode_utf8(cp : Int) -> Array[Int] {
  if cp < 0x80 {
    [cp]
  } else if cp < 0x800 {
    [0xC0 | (cp >> 6), 0x80 | (cp & 0x3F)]
  } else if cp < 0x10000 {
    [0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
  } else {
    [
      0xF0 | (cp >> 18),
      0x80 | ((cp >> 12) & 0x3F),
      0x80 | ((cp >> 6) & 0x3F),
      0x80 | (cp & 0x3F),
    ]
  }
}

///| Sort and merge overlapping/adjacent `CharRange`s in place.
pub fn normalize_ranges(ranges : Array[CharRange]) -> Array[CharRange] {
  let n = ranges.length()
  if n <= 1 {
    return ranges
  }
  // Iterative quicksort by (lo, hi)
  let slo : Array[Int] = [0]
  let shi : Array[Int] = [n - 1]
  while slo.length() > 0 {
    let lo = match slo.pop() {
      Some(v) => v
      None => break
    }
    let hi = match shi.pop() {
      Some(v) => v
      None => break
    }
    if lo >= hi {
      continue
    }
    let mid = lo + (hi - lo) / 2
    let pivot = ranges[mid]
    ranges[mid] = ranges[hi]
    ranges[hi] = pivot
    let mut i = lo - 1
    let mut j = lo
    while j < hi {
      let r = ranges[j]
      if r.lo < pivot.lo || (r.lo == pivot.lo && r.hi <= pivot.hi) {
        i = i + 1
        let t = ranges[i]
        ranges[i] = ranges[j]
        ranges[j] = t
      }
      j = j + 1
    }
    let p = i + 1
    let t = ranges[p]
    ranges[p] = ranges[hi]
    ranges[hi] = t
    if p - 1 > lo {
      slo.push(lo)
      shi.push(p - 1)
    }
    if p + 1 < hi {
      slo.push(p + 1)
      shi.push(hi)
    }
  }
  let out : Array[CharRange] = Array::new()
  let mut cur = ranges[0]
  let mut i = 1
  while i < n {
    let r = ranges[i]
    if r.lo <= cur.hi + 1 {
      if r.hi > cur.hi {
        cur = CharRange::{ lo: cur.lo, hi: r.hi }
      }
    } else {
      out.push(cur)
      cur = r
    }
    i = i + 1
  }
  out.push(cur)
  out
}

///| Complement a list of `CharRange`s over `[0, max_cp]` (excluding surrogates if `unicode`).
pub fn negate_ranges(
  ranges : Array[CharRange],
  unicode : Bool,
) -> Array[CharRange] {
  let max_cp = if unicode { 0x10FFFF } else { 0xFF }
  let norm = normalize_ranges(ranges)
  let out : Array[CharRange] = Array::new()
  let mut cur = 0
  let mut i = 0
  let n = norm.length()
  while i < n {
    let r = norm[i]
    if r.lo > cur {
      push_valid_scalar_range(out, cur, r.lo - 1, unicode)
    }
    if r.hi + 1 > cur {
      cur = r.hi + 1
    }
    i = i + 1
  }
  if cur <= max_cp {
    push_valid_scalar_range(out, cur, max_cp, unicode)
  }
  out
}

fn push_valid_scalar_range(
  out : Array[CharRange],
  lo : Int,
  hi : Int,
  unicode : Bool,
) -> Unit {
  if lo > hi {
    return
  }
  if !unicode {
    out.push(CharRange::{ lo, hi })
    return
  }
  // Exclude UTF-16 surrogates 0xD800..0xDFFF
  if hi < 0xD800 || lo > 0xDFFF {
    out.push(CharRange::{ lo, hi })
  } else {
    if lo < 0xD800 {
      out.push(CharRange::{ lo, hi: 0xD7FF })
    }
    if hi > 0xDFFF {
      out.push(CharRange::{ lo: 0xE000, hi })
    }
  }
}

///| Simple case-folding helper: adds case-folded counterparts for a list of `CharRange`s.
pub fn case_fold_ranges(
  ranges : Array[CharRange],
  unicode : Bool,
) -> Array[CharRange] {
  let out : Array[CharRange] = Array::new()
  let mut i = 0
  let n = ranges.length()
  while i < n {
    let r = ranges[i]
    out.push(r)
    // ASCII A-Z <-> a-z
    let a_lo = if r.lo > 65 { r.lo } else { 65 }
    let a_hi = if r.hi < 90 { r.hi } else { 90 }
    if a_lo <= a_hi {
      out.push(CharRange::{ lo: a_lo + 32, hi: a_hi + 32 })
    }
    let l_lo = if r.lo > 97 { r.lo } else { 97 }
    let l_hi = if r.hi < 122 { r.hi } else { 122 }
    if l_lo <= l_hi {
      out.push(CharRange::{ lo: l_lo - 32, hi: l_hi - 32 })
    }
    if unicode {
      // Latin-1 Supplement: 0xC0..0xD6 <-> 0xE0..0xF6, 0xD8..0xDE <-> 0xF8..0xFE
      fold_block(out, r, 0xC0, 0xD6, 32)
      fold_block(out, r, 0xD8, 0xDE, 32)
      // Greek: 0x0391..0x03A1 <-> 0x03B1..0x03C1, 0x03A3..0x03AB <-> 0x03C3..0x03CB
      fold_block(out, r, 0x0391, 0x03A1, 32)
      fold_block(out, r, 0x03A3, 0x03AB, 32)
      // Cyrillic: 0x0410..0x042F <-> 0x0430..0x044F, 0x0400..0x040F <-> 0x0450..0x045F
      fold_block(out, r, 0x0410, 0x042F, 32)
      fold_block(out, r, 0x0400, 0x040F, 80)
    }
    i = i + 1
  }
  normalize_ranges(out)
}

fn fold_block(
  out : Array[CharRange],
  r : CharRange,
  u_lo : Int,
  u_hi : Int,
  delta : Int,
) -> Unit {
  let l_lo = u_lo + delta
  let l_hi = u_hi + delta
  let a = if r.lo > u_lo { r.lo } else { u_lo }
  let b = if r.hi < u_hi { r.hi } else { u_hi }
  if a <= b {
    out.push(CharRange::{ lo: a + delta, hi: b + delta })
  }
  let c = if r.lo > l_lo { r.lo } else { l_lo }
  let d = if r.hi < l_hi { r.hi } else { l_hi }
  if c <= d {
    out.push(CharRange::{ lo: c - delta, hi: d - delta })
  }
}

///| Compile a single inclusive Unicode scalar range `[lo, hi]` into minimal UTF-8 byte-range sequences.
///| Ported directly from `regex-syntax/src/utf8.rs` (Cox / BurntSushi algorithm).
pub fn compile_utf8_range(lo : Int, hi : Int, out : Array[Utf8Seq]) -> Unit {
  if lo > hi {
    return
  }
  let stack_lo : Array[Int] = Array::new()
  let stack_hi : Array[Int] = Array::new()
  // Split around surrogates 0xD800..0xDFFF
  if hi < 0xD800 || lo > 0xDFFF {
    stack_lo.push(lo)
    stack_hi.push(hi)
  } else {
    if hi > 0xDFFF {
      stack_lo.push(0xE000)
      stack_hi.push(hi)
    }
    if lo < 0xD800 {
      stack_lo.push(lo)
      stack_hi.push(0xD7FF)
    }
  }
  while stack_lo.length() > 0 {
    let mut start = match stack_lo.pop() {
      Some(v) => v
      None => break
    }
    let mut end = match stack_hi.pop() {
      Some(v) => v
      None => break
    }
    // Split across UTF-8 byte-length boundaries: 0x7F, 0x7FF, 0xFFFF
    if start <= 0x7F && end > 0x7F {
      stack_lo.push(0x80)
      stack_hi.push(end)
      end = 0x7F
    } else if start <= 0x7FF && end > 0x7FF {
      stack_lo.push(0x800)
      stack_hi.push(end)
      end = 0x7FF
    } else if start <= 0xFFFF && end > 0xFFFF {
      stack_lo.push(0x10000)
      stack_hi.push(end)
      end = 0xFFFF
    }
    // Now start and end have the same UTF-8 length!
    if start <= 0x7F {
      out.push(Utf8Seq::{
        len: 1,
        b0_lo: start,
        b0_hi: end,
        b1_lo: 0,
        b1_hi: 0,
        b2_lo: 0,
        b2_hi: 0,
        b3_lo: 0,
        b3_hi: 0,
      })
      continue
    }
    // Split low aligned boundary: if (start & mask) != 0
    let mut split_done = false
    let mut i = 1
    while i < 4 {
      let m = (1 << (6 * i)) - 1
      if (start & (m ^ -1)) != (end & (m ^ -1)) {
        if (start & m) != 0 {
          let split = start | m
          stack_lo.push(split + 1)
          stack_hi.push(end)
          stack_lo.push(start)
          stack_hi.push(split)
          split_done = true
          break
        }
        if (end & m) != m {
          let split = end & (m ^ -1)
          stack_lo.push(split)
          stack_hi.push(end)
          stack_lo.push(start)
          stack_hi.push(split - 1)
          split_done = true
          break
        }
      }
      i = i + 1
    }
    if split_done {
      continue
    }
    // Emit direct byte-range sequence
    let s_bytes = encode_utf8(start)
    let e_bytes = encode_utf8(end)
    let n = s_bytes.length()
    if n == 2 {
      out.push(Utf8Seq::{
        len: 2,
        b0_lo: s_bytes[0],
        b0_hi: e_bytes[0],
        b1_lo: s_bytes[1],
        b1_hi: e_bytes[1],
        b2_lo: 0,
        b2_hi: 0,
        b3_lo: 0,
        b3_hi: 0,
      })
    } else if n == 3 {
      out.push(Utf8Seq::{
        len: 3,
        b0_lo: s_bytes[0],
        b0_hi: e_bytes[0],
        b1_lo: s_bytes[1],
        b1_hi: e_bytes[1],
        b2_lo: s_bytes[2],
        b2_hi: e_bytes[2],
        b3_lo: 0,
        b3_hi: 0,
      })
    } else {
      out.push(Utf8Seq::{
        len: 4,
        b0_lo: s_bytes[0],
        b0_hi: e_bytes[0],
        b1_lo: s_bytes[1],
        b1_hi: e_bytes[1],
        b2_lo: s_bytes[2],
        b2_hi: e_bytes[2],
        b3_lo: s_bytes[3],
        b3_hi: e_bytes[3],
      })
    }
  }
}

///| Compile a normalized list of `CharRange`s into UTF-8 byte-range sequences.
pub fn compile_utf8_ranges(ranges : Array[CharRange]) -> Array[Utf8Seq] {
  let out : Array[Utf8Seq] = Array::new()
  let mut i = 0
  let n = ranges.length()
  while i < n {
    compile_utf8_range(ranges[i].lo, ranges[i].hi, out)
    i = i + 1
  }
  out
}

///| ASCII word byte check `[0-9A-Za-z_]`.
pub fn is_ascii_word_byte(b : Int) -> Bool {
  (b >= 48 && b <= 57) ||
  (b >= 65 && b <= 90) ||
  (b >= 97 && b <= 122) ||
  b == 95
}

///| Unicode word codepoint check (ASCII word + Unicode letters/digits/marks).
pub fn is_unicode_word_cp(cp : Int) -> Bool {
  if cp < 0 {
    return false
  }
  if cp < 128 {
    return is_ascii_word_byte(cp)
  }
  if cp == 0x200C || cp == 0x200D {
    return true
  }
  cp_in_ranges(cp, unicode_word_ranges())
}

fn cp_in_ranges(cp : Int, ranges : Array[CharRange]) -> Bool {
  let mut lo = 0
  let mut hi = ranges.length() - 1
  while lo <= hi {
    let mid = lo + (hi - lo) / 2
    let r = ranges[mid]
    if cp < r.lo {
      hi = mid - 1
    } else if cp > r.hi {
      lo = mid + 1
    } else {
      return true
    }
  }
  false
}

///| Shorthand `\d` ranges.
pub fn digit_ranges(unicode : Bool) -> Array[CharRange] {
  if !unicode {
    return [CharRange::{ lo: 48, hi: 57 }]
  }
  unicode_nd_ranges()
}

///| Shorthand `\s` ranges.
pub fn space_ranges(unicode : Bool) -> Array[CharRange] {
  if !unicode {
    return [
      CharRange::{ lo: 9, hi: 13 }, // \t \n \v \f \r
      CharRange::{ lo: 32, hi: 32 }, // ' '
    ]
  }
  [
    CharRange::{ lo: 0x09, hi: 0x0D },
    CharRange::{ lo: 0x20, hi: 0x20 },
    CharRange::{ lo: 0x85, hi: 0x85 },
    CharRange::{ lo: 0xA0, hi: 0xA0 },
    CharRange::{ lo: 0x1680, hi: 0x1680 },
    CharRange::{ lo: 0x2000, hi: 0x200A },
    CharRange::{ lo: 0x2028, hi: 0x2029 },
    CharRange::{ lo: 0x202F, hi: 0x202F },
    CharRange::{ lo: 0x205F, hi: 0x205F },
    CharRange::{ lo: 0x3000, hi: 0x3000 },
  ]
}

///| Shorthand `\w` ranges.
pub fn word_ranges(unicode : Bool) -> Array[CharRange] {
  if !unicode {
    return [
      CharRange::{ lo: 48, hi: 57 },
      CharRange::{ lo: 65, hi: 90 },
      CharRange::{ lo: 95, hi: 95 },
      CharRange::{ lo: 97, hi: 122 },
    ]
  }
  unicode_word_ranges()
}

fn unicode_word_ranges() -> Array[CharRange] {
  let out : Array[CharRange] = Array::new()
  append_ranges(out, unicode_letter_ranges())
  append_ranges(out, unicode_nd_ranges())
  out.push(CharRange::{ lo: 0x5F, hi: 0x5F }) // '_'
  out.push(CharRange::{ lo: 0x0300, hi: 0x036F }) // Combining Diacritical Marks
  normalize_ranges(out)
}

fn append_ranges(dst : Array[CharRange], src : Array[CharRange]) -> Unit {
  let mut i = 0
  let n = src.length()
  while i < n {
    dst.push(src[i])
    i = i + 1
  }
}

///| Unicode `\p{Nd}` (Decimal_Number) ranges.
pub fn unicode_nd_ranges() -> Array[CharRange] {
  [
    CharRange::{ lo: 0x0030, hi: 0x0039 }, // ASCII 0-9
    CharRange::{ lo: 0x0660, hi: 0x0669 }, // Arabic-Indic
    CharRange::{ lo: 0x06F0, hi: 0x06F9 }, // Extended Arabic-Indic
    CharRange::{ lo: 0x07C0, hi: 0x07C9 }, // NKo
    CharRange::{ lo: 0x0966, hi: 0x096F }, // Devanagari
    CharRange::{ lo: 0x09E6, hi: 0x09EF }, // Bengali
    CharRange::{ lo: 0x0A66, hi: 0x0A6F }, // Gurmukhi
    CharRange::{ lo: 0x0AE6, hi: 0x0AEF }, // Gujarati
    CharRange::{ lo: 0x0B66, hi: 0x0B6F }, // Oriya
    CharRange::{ lo: 0x0BE6, hi: 0x0BEF }, // Tamil
    CharRange::{ lo: 0x0C66, hi: 0x0C6F }, // Telugu
    CharRange::{ lo: 0x0CE6, hi: 0x0CEF }, // Kannada
    CharRange::{ lo: 0x0D66, hi: 0x0D6F }, // Malayalam
    CharRange::{ lo: 0x0E50, hi: 0x0E59 }, // Thai
    CharRange::{ lo: 0x0ED0, hi: 0x0ED9 }, // Lao
    CharRange::{ lo: 0x0F20, hi: 0x0F29 }, // Tibetan
    CharRange::{ lo: 0x1040, hi: 0x1049 }, // Myanmar
    CharRange::{ lo: 0xFF10, hi: 0xFF19 }, // Fullwidth 0-9
  ]
}

///| Unicode `\p{Lu}` (Uppercase_Letter) ranges.
pub fn unicode_lu_ranges() -> Array[CharRange] {
  [
    CharRange::{ lo: 0x0041, hi: 0x005A }, // A-Z
    CharRange::{ lo: 0x00C0, hi: 0x00D6 }, // Latin-1 Upper
    CharRange::{ lo: 0x00D8, hi: 0x00DE },
    CharRange::{ lo: 0x0391, hi: 0x03A1 }, // Greek Upper
    CharRange::{ lo: 0x03A3, hi: 0x03AB },
    CharRange::{ lo: 0x0400, hi: 0x042F }, // Cyrillic Upper
    CharRange::{ lo: 0xFF21, hi: 0xFF3A }, // Fullwidth A-Z
  ]
}

///| Unicode `\p{Ll}` (Lowercase_Letter) ranges.
pub fn unicode_ll_ranges() -> Array[CharRange] {
  [
    CharRange::{ lo: 0x0061, hi: 0x007A }, // a-z
    CharRange::{ lo: 0x00DF, hi: 0x00F6 }, // Latin-1 Lower
    CharRange::{ lo: 0x00F8, hi: 0x00FF },
    CharRange::{ lo: 0x03B1, hi: 0x03C1 }, // Greek Lower
    CharRange::{ lo: 0x03C2, hi: 0x03CB },
    CharRange::{ lo: 0x0430, hi: 0x045F }, // Cyrillic Lower
    CharRange::{ lo: 0xFF41, hi: 0xFF5A }, // Fullwidth a-z
  ]
}

///| Unicode `\p{L}` (Letter) ranges (major scripts + Latin/Greek/Cyrillic/CJK/Arabic/Hebrew/Hangul/Kana).
pub fn unicode_letter_ranges() -> Array[CharRange] {
  [
    CharRange::{ lo: 0x0041, hi: 0x005A },
    CharRange::{ lo: 0x0061, hi: 0x007A },
    CharRange::{ lo: 0x00AA, hi: 0x00AA },
    CharRange::{ lo: 0x00B5, hi: 0x00B5 },
    CharRange::{ lo: 0x00BA, hi: 0x00BA },
    CharRange::{ lo: 0x00C0, hi: 0x00D6 },
    CharRange::{ lo: 0x00D8, hi: 0x00F6 },
    CharRange::{ lo: 0x00F8, hi: 0x02C1 },
    CharRange::{ lo: 0x0370, hi: 0x0374 },
    CharRange::{ lo: 0x0376, hi: 0x0377 },
    CharRange::{ lo: 0x037A, hi: 0x037D },
    CharRange::{ lo: 0x0386, hi: 0x0386 },
    CharRange::{ lo: 0x0388, hi: 0x038A },
    CharRange::{ lo: 0x038C, hi: 0x038C },
    CharRange::{ lo: 0x038E, hi: 0x03A1 },
    CharRange::{ lo: 0x03A3, hi: 0x03F5 },
    CharRange::{ lo: 0x0400, hi: 0x0481 },
    CharRange::{ lo: 0x048A, hi: 0x052F },
    CharRange::{ lo: 0x05D0, hi: 0x05EA }, // Hebrew
    CharRange::{ lo: 0x0620, hi: 0x064A }, // Arabic
    CharRange::{ lo: 0x066E, hi: 0x066F },
    CharRange::{ lo: 0x0671, hi: 0x06D3 },
    CharRange::{ lo: 0x0904, hi: 0x0939 }, // Devanagari
    CharRange::{ lo: 0x0E01, hi: 0x0E30 }, // Thai
    CharRange::{ lo: 0x1100, hi: 0x1248 }, // Hangul Jamo + Ethiopic
    CharRange::{ lo: 0x1E00, hi: 0x1EFF }, // Latin Extended Additional
    CharRange::{ lo: 0x3041, hi: 0x3096 }, // Hiragana
    CharRange::{ lo: 0x30A1, hi: 0x30FA }, // Katakana
    CharRange::{ lo: 0x3400, hi: 0x4DBF }, // CJK Extension A
    CharRange::{ lo: 0x4E00, hi: 0x9FFF }, // CJK Unified Ideographs
    CharRange::{ lo: 0xAC00, hi: 0xD7A3 }, // Hangul Syllables
    CharRange::{ lo: 0xF900, hi: 0xFAFF }, // CJK Compatibility Ideographs
    CharRange::{ lo: 0xFF21, hi: 0xFF3A }, // Fullwidth A-Z
    CharRange::{ lo: 0xFF41, hi: 0xFF5A }, // Fullwidth a-z
    CharRange::{ lo: 0xFF66, hi: 0xFFDC }, // Halfwidth Katakana/Hangul
    CharRange::{ lo: 0x20000, hi: 0x2A6DF }, // CJK Extension B
  ]
}

///| Look up a Unicode property name for `\p{name}` / `\P{name}`.
pub fn lookup_unicode_property(name : String) -> Option[Array[CharRange]] {
  if name == "L" || name == "Letter" {
    Some(unicode_letter_ranges())
  } else if name == "Lu" || name == "Uppercase_Letter" {
    Some(unicode_lu_ranges())
  } else if name == "Ll" || name == "Lowercase_Letter" {
    Some(unicode_ll_ranges())
  } else if name == "Nd" || name == "Decimal_Number" || name == "digit" {
    Some(unicode_nd_ranges())
  } else if name == "N" || name == "Number" {
    let out : Array[CharRange] = Array::new()
    append_ranges(out, unicode_nd_ranges())
    out.push(CharRange::{ lo: 0x00B2, hi: 0x00B3 })
    out.push(CharRange::{ lo: 0x00B9, hi: 0x00B9 })
    out.push(CharRange::{ lo: 0x00BC, hi: 0x00BE })
    out.push(CharRange::{ lo: 0x2150, hi: 0x218B })
    Some(normalize_ranges(out))
  } else if name == "P" || name == "Punctuation" {
    Some([
      CharRange::{ lo: 0x21, hi: 0x23 },
      CharRange::{ lo: 0x25, hi: 0x2A },
      CharRange::{ lo: 0x2C, hi: 0x2F },
      CharRange::{ lo: 0x3A, hi: 0x3B },
      CharRange::{ lo: 0x3F, hi: 0x40 },
      CharRange::{ lo: 0x5B, hi: 0x5D },
      CharRange::{ lo: 0x5F, hi: 0x5F },
      CharRange::{ lo: 0x7B, hi: 0x7B },
      CharRange::{ lo: 0x7D, hi: 0x7D },
      CharRange::{ lo: 0x2010, hi: 0x2027 },
      CharRange::{ lo: 0x3001, hi: 0x3003 },
      CharRange::{ lo: 0x3008, hi: 0x3011 },
      CharRange::{ lo: 0x3014, hi: 0x301F },
    ])
  } else if name == "S" || name == "Symbol" {
    Some([
      CharRange::{ lo: 0x24, hi: 0x24 },
      CharRange::{ lo: 0x2B, hi: 0x2B },
      CharRange::{ lo: 0x3C, hi: 0x3E },
      CharRange::{ lo: 0x5E, hi: 0x5E },
      CharRange::{ lo: 0x60, hi: 0x60 },
      CharRange::{ lo: 0x7C, hi: 0x7C },
      CharRange::{ lo: 0x7E, hi: 0x7E },
      CharRange::{ lo: 0x2190, hi: 0x27BF },
      CharRange::{ lo: 0x1F300, hi: 0x1FAFF },
    ])
  } else if name == "Z" || name == "Separator" {
    Some([
      CharRange::{ lo: 0x20, hi: 0x20 },
      CharRange::{ lo: 0xA0, hi: 0xA0 },
      CharRange::{ lo: 0x1680, hi: 0x1680 },
      CharRange::{ lo: 0x2000, hi: 0x200A },
      CharRange::{ lo: 0x2028, hi: 0x2029 },
      CharRange::{ lo: 0x202F, hi: 0x202F },
      CharRange::{ lo: 0x205F, hi: 0x205F },
      CharRange::{ lo: 0x3000, hi: 0x3000 },
    ])
  } else if name == "C" || name == "Other" {
    Some([
      CharRange::{ lo: 0x00, hi: 0x1F },
      CharRange::{ lo: 0x7F, hi: 0x9F },
    ])
  } else if name == "ASCII" {
    Some([CharRange::{ lo: 0x00, hi: 0x7F }])
  } else if name == "Latin" {
    Some([
      CharRange::{ lo: 0x0041, hi: 0x005A },
      CharRange::{ lo: 0x0061, hi: 0x007A },
      CharRange::{ lo: 0x00C0, hi: 0x00D6 },
      CharRange::{ lo: 0x00D8, hi: 0x00F6 },
      CharRange::{ lo: 0x00F8, hi: 0x024F },
      CharRange::{ lo: 0x1E00, hi: 0x1EFF },
    ])
  } else if name == "Greek" {
    Some([
      CharRange::{ lo: 0x0370, hi: 0x03FF },
      CharRange::{ lo: 0x1F00, hi: 0x1FFF },
    ])
  } else if name == "Cyrillic" {
    Some([
      CharRange::{ lo: 0x0400, hi: 0x052F },
    ])
  } else if name == "Han" {
    Some([
      CharRange::{ lo: 0x3400, hi: 0x4DBF },
      CharRange::{ lo: 0x4E00, hi: 0x9FFF },
      CharRange::{ lo: 0xF900, hi: 0xFAFF },
      CharRange::{ lo: 0x20000, hi: 0x2A6DF },
    ])
  } else if name == "Hiragana" {
    Some([CharRange::{ lo: 0x3041, hi: 0x3096 }])
  } else if name == "Katakana" {
    Some([
      CharRange::{ lo: 0x30A1, hi: 0x30FA },
      CharRange::{ lo: 0x31F0, hi: 0x31FF },
      CharRange::{ lo: 0xFF66, hi: 0xFF9D },
    ])
  } else if name == "Arabic" {
    Some([CharRange::{ lo: 0x0600, hi: 0x06FF }])
  } else if name == "Hebrew" {
    Some([CharRange::{ lo: 0x0590, hi: 0x05FF }])
  } else if name == "Hangul" {
    Some([
      CharRange::{ lo: 0x1100, hi: 0x11FF },
      CharRange::{ lo: 0x3130, hi: 0x318F },
      CharRange::{ lo: 0xAC00, hi: 0xD7A3 },
    ])
  } else {
    None
  }
}

///| Look up a POSIX character class name inside `[[:name:]]`.
pub fn lookup_posix_class(name : String) -> Option[Array[CharRange]] {
  if name == "digit" {
    Some([CharRange::{ lo: 48, hi: 57 }])
  } else if name == "xdigit" {
    Some([
      CharRange::{ lo: 48, hi: 57 },
      CharRange::{ lo: 65, hi: 70 },
      CharRange::{ lo: 97, hi: 102 },
    ])
  } else if name == "alpha" {
    Some([
      CharRange::{ lo: 65, hi: 90 },
      CharRange::{ lo: 97, hi: 122 },
    ])
  } else if name == "alnum" {
    Some([
      CharRange::{ lo: 48, hi: 57 },
      CharRange::{ lo: 65, hi: 90 },
      CharRange::{ lo: 97, hi: 122 },
    ])
  } else if name == "lower" {
    Some([CharRange::{ lo: 97, hi: 122 }])
  } else if name == "upper" {
    Some([CharRange::{ lo: 65, hi: 90 }])
  } else if name == "space" {
    Some([
      CharRange::{ lo: 9, hi: 13 },
      CharRange::{ lo: 32, hi: 32 },
    ])
  } else if name == "blank" {
    Some([
      CharRange::{ lo: 9, hi: 9 },
      CharRange::{ lo: 32, hi: 32 },
    ])
  } else if name == "word" {
    Some([
      CharRange::{ lo: 48, hi: 57 },
      CharRange::{ lo: 65, hi: 90 },
      CharRange::{ lo: 95, hi: 95 },
      CharRange::{ lo: 97, hi: 122 },
    ])
  } else if name == "ascii" {
    Some([CharRange::{ lo: 0, hi: 127 }])
  } else if name == "cntrl" {
    Some([
      CharRange::{ lo: 0, hi: 31 },
      CharRange::{ lo: 127, hi: 127 },
    ])
  } else if name == "graph" {
    Some([CharRange::{ lo: 33, hi: 126 }])
  } else if name == "print" {
    Some([CharRange::{ lo: 32, hi: 126 }])
  } else if name == "punct" {
    Some([
      CharRange::{ lo: 33, hi: 47 },
      CharRange::{ lo: 58, hi: 64 },
      CharRange::{ lo: 91, hi: 96 },
      CharRange::{ lo: 123, hi: 126 },
    ])
  } else {
    None
  }
}
