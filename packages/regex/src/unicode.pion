  } else if name == "Co" || name == "Private_Use" {
    Some(flat_to_ranges(ucd_gc_co))
  } else if name == "Cn" || name == "Unassigned" {
    Some(flat_to_ranges(ucd_gc_cn))
  } else if name == "ASCII" {
    Some([CharRange::{ lo: 0x00, hi: 0x7F }])
  } else if name == "Latin" {
    Some(flat_to_ranges(ucd_sc_latin))
  } else if name == "Greek" {
    Some(flat_to_ranges(ucd_sc_greek))
