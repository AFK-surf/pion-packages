///| Unicode UTF-8 utilities, character range algebra, Unicode property tables,
///| case folding, and Cox/Rust `utf8_sequences` range-to-UTF-8-byte-automaton compiler.

///| Inclusive Unicode scalar value range `[lo, hi]`.
#verify
pub val struct CharRange {
  pub lo : Int
  pub hi : Int
}

///| A single byte range `[lo, hi]` (0..255).
pub val struct ByteRange {
  pub lo : Int
  pub hi : Int
}

///| A 1..4 byte UTF-8 sequence of byte ranges.
pub val struct Utf8Seq {
  pub len : Int
  pub b0_lo : Int
  pub b0_hi : Int
  pub b1_lo : Int
  pub b1_hi : Int
  pub b2_lo : Int
  pub b2_hi : Int
  pub b3_lo : Int
  pub b3_hi : Int
}

///| Decode one UTF-8 codepoint from `s` starting at byte offset `pos`.
///| Returns `(codepoint, next_pos)`.
pub fn decode_utf8(s : String, pos : Int) -> (Int, Int) {
  let n = s.length()
  if pos >= n {
    return (0, pos)
  }
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0, pos + 1)
  }
  if b0 >= 0xC2 && b0 <= 0xDF && pos + 1 < n {
    let b1 = s.code_unit_at(pos + 1)
    if (b1 & 0xC0) == 0x80 {
      return (((b0 & 0x1F) << 6) | (b1 & 0x3F), pos + 2)
    }
  } else if b0 >= 0xE0 && b0 <= 0xEF && pos + 2 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      return (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), pos + 3)
    }
  } else if b0 >= 0xF0 && b0 <= 0xF4 && pos + 3 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      return (
        ((b0 & 0x07) << 18) |
        ((b1 & 0x3F) << 12) |
        ((b2 & 0x3F) << 6) |
        (b3 & 0x3F),
        pos + 4,
      )
    }
  }
  (b0, pos + 1)
}

///| Decode the UTF-8 codepoint immediately BEFORE byte offset `pos`.
pub fn decode_utf8_before(s : String, pos : Int) -> Int {
  if pos <= 0 {
    return -1
  }
  let b1 = s.code_unit_at(pos - 1)
  if b1 < 0x80 {
    return b1
  }
  let mut p = pos - 1
  let limit = if pos >= 4 { pos - 4 } else { 0 }
  while p > limit && (s.code_unit_at(p) & 0xC0) == 0x80 {
    p = p - 1
  }
  let (cp, _) = decode_utf8(s, p)
  cp
}

///| Return true if `b` is a UTF-8 continuation byte (`10xxxxxx`, `0x80..0xBF`).
#verify
pub fn is_utf8_cont_byte(b : Int) -> Bool {
  (b & 0xC0) == 0x80
}

///| Return nominal UTF-8 byte length (1..4) from a leading byte `b`.
pub fn utf8_lead_len(b : Int) -> Int {
  if b < 0x80 {
    1
  } else if b < 0xE0 {
    2
  } else if b < 0xF0 {
    3
  } else {
    4
  }
}

///| Return byte length of the UTF-8 character starting at `pos` in `s` (at least 1).
pub fn utf8_char_len_at(s : String, pos : Int) -> Int {
  let n = s.length()
  if pos >= n {
    return 0
  }
  let want = utf8_lead_len(s.code_unit_at(pos))
  if pos + want <= n { want } else { n - pos }
}

///| Encode a Unicode scalar value into 1..4 UTF-8 bytes.
pub fn encode_utf8(cp : Int) -> Array[Int] {
  if cp < 0x80 {
    [cp]
  } else if cp < 0x800 {
    [0xC0 | (cp >> 6), 0x80 | (cp & 0x3F)]
  } else if cp < 0x10000 {
    [0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
  } else {
    [
      0xF0 | (cp >> 18),
      0x80 | ((cp >> 12) & 0x3F),
      0x80 | ((cp >> 6) & 0x3F),
      0x80 | (cp & 0x3F),
    ]
  }
}

///| Return true if `pos` is a UTF-8 character boundary in `s`.
pub fn is_char_boundary(s : String, pos : Int) -> Bool {
  let n = s.length()
  if pos == 0 || pos == n {
    return true
  }
  if pos < 0 || pos > n {
    return false
  }
  !is_utf8_cont_byte(s.code_unit_at(pos))
}

///| Return true if `bs` is a valid UTF-8 byte sequence.
pub fn is_valid_utf8_bytes(bs : Array[Int]) -> Bool {
  let n = bs.length()
  let mut i = 0
  while i < n {
    let b0 = bs[i]
    if b0 < 0 || b0 > 255 {
      return false
    }
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n || (bs[i + 1] & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        return false
      }
      let b1 = bs[i + 1]
      let b2 = bs[i + 2]
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        return false
      }
      let b1 = bs[i + 1]
      let b2 = bs[i + 2]
      let b3 = bs[i + 3]
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return false
      }
      if b0 == 0xF4 && b1 >= 0x90 {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| Lexicographic total order on `CharRange` used by `normalize_ranges`.
#verify
pub fn char_range_le(a : CharRange, b : CharRange) -> Bool {
  a.lo < b.lo || (a.lo == b.lo && a.hi <= b.hi)
}

///| Interval intersection `[max(a.lo, b.lo), min(a.hi, b.hi)]` (empty iff `lo > hi`).
#verify
pub fn char_range_intersect(a : CharRange, b : CharRange) -> CharRange {
  let lo = if a.lo > b.lo { a.lo } else { b.lo }
  let hi = if a.hi < b.hi { a.hi } else { b.hi }
  CharRange::{ lo, hi }
}

///| Sort and merge overlapping/adjacent `CharRange`s in O(N log N) worst-case time.
pub fn normalize_ranges(ranges : Array[CharRange]) -> Array[CharRange] {
  let n = ranges.length()
  if n <= 1 {
    return ranges
  }
  // Bottom-up iterative merge sort (guaranteed O(N log N), immune to duplicate-key degeneracy)
  let mut src : Array[CharRange] = Array::new()
  let mut dst : Array[CharRange] = Array::new()
  let mut i = 0
  while i < n {
    src.push(ranges[i])
    dst.push(ranges[i])
    i = i + 1
  }
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut a = left
      let mut b = mid
      let mut k = left
      while a < mid && b < right {
        let ra = src[a]
        let rb = src[b]
        if char_range_le(ra, rb) {
          dst[k] = ra
          a = a + 1
        } else {
          dst[k] = rb
          b = b + 1
        }
        k = k + 1
      }
      while a < mid {
        dst[k] = src[a]
        a = a + 1
        k = k + 1
      }
      while b < right {
        dst[k] = src[b]
        b = b + 1
        k = k + 1
      }
      left = left + width * 2
    }
    let tmp = src
    src = dst
    dst = tmp
    width = width * 2
  }
  let out : Array[CharRange] = Array::new()
  let mut cur = src[0]
  i = 1
  while i < n {
    let r = src[i]
    if r.lo <= cur.hi + 1 {
      if r.hi > cur.hi {
        cur = CharRange::{ lo: cur.lo, hi: r.hi }
      }
    } else {
      out.push(cur)
      cur = r
    }
    i = i + 1
  }
  out.push(cur)
  out
}

///| Union of two `CharRange` lists.
pub fn union_ranges(
  a : Array[CharRange],
  b : Array[CharRange],
) -> Array[CharRange] {
  let out : Array[CharRange] = Array::new()
  append_ranges(out, a)
  append_ranges(out, b)
  normalize_ranges(out)
}

///| Intersection of two normalized `CharRange` lists in O(|a| + |b|).
pub fn intersect_ranges(
  a_in : Array[CharRange],
  b_in : Array[CharRange],
) -> Array[CharRange] {
  let a = normalize_ranges(a_in)
  let b = normalize_ranges(b_in)
  let out : Array[CharRange] = Array::new()
  let mut i = 0
  let mut j = 0
  let na = a.length()
  let nb = b.length()
  while i < na && j < nb {
    let ra = a[i]
    let rb = b[j]
    let inter = char_range_intersect(ra, rb)
    if inter.lo <= inter.hi {
      out.push(inter)
    }
    if ra.hi < rb.hi {
      i = i + 1
    } else {
      j = j + 1
    }
  }
  out
}

///| Set difference `a \ b` of two `CharRange` lists in O(|a| + |b|).
pub fn difference_ranges(
  a_in : Array[CharRange],
  b_in : Array[CharRange],
) -> Array[CharRange] {
  let a = normalize_ranges(a_in)
  let b = normalize_ranges(b_in)
  let out : Array[CharRange] = Array::new()
  let mut i = 0
  let mut j = 0
  let na = a.length()
  let nb = b.length()
  while i < na {
    let mut lo = a[i].lo
    let hi = a[i].hi
    while j < nb && b[j].hi < lo {
      j = j + 1
    }
    let mut k = j
    while k < nb && b[k].lo <= hi {
      if b[k].lo > lo {
        out.push(CharRange::{ lo, hi: b[k].lo - 1 })
      }
      if b[k].hi >= hi {
        lo = hi + 1
        break
      }
      lo = b[k].hi + 1
      k = k + 1
    }
    if lo <= hi {
      out.push(CharRange::{ lo, hi })
    }
    i = i + 1
  }
  out
}

///| Symmetric difference `(a \ b) U (b \ a)`.
pub fn sym_diff_ranges(
  a : Array[CharRange],
  b : Array[CharRange],
) -> Array[CharRange] {
  let d1 = difference_ranges(a, b)
  let d2 = difference_ranges(b, a)
  union_ranges(d1, d2)
}

///| Complement a list of `CharRange`s over `[0, max_cp]` (excluding surrogates if `unicode`).
pub fn negate_ranges(
  ranges : Array[CharRange],
  unicode : Bool,
) -> Array[CharRange] {
  let max_cp = if unicode { 0x10FFFF } else { 0xFF }
  let norm = normalize_ranges(ranges)
  let out : Array[CharRange] = Array::new()
  let mut cur = 0
  let mut i = 0
  let n = norm.length()
  while i < n {
    let r = norm[i]
    if r.lo > cur {
      push_valid_scalar_range(out, cur, r.lo - 1, unicode)
    }
    if r.hi + 1 > cur {
      cur = r.hi + 1
    }
    i = i + 1
  }
  if cur <= max_cp {
    push_valid_scalar_range(out, cur, max_cp, unicode)
  }
  out
}

fn push_valid_scalar_range(
  out : Array[CharRange],
  lo : Int,
  hi : Int,
  unicode : Bool,
) -> Unit {
  if lo > hi {
    return
  }
  if !unicode {
    out.push(CharRange::{ lo, hi })
    return
  }
  // Exclude UTF-16 surrogates 0xD800..0xDFFF
  if hi < 0xD800 || lo > 0xDFFF {
    out.push(CharRange::{ lo, hi })
  } else {
    if lo < 0xD800 {
      out.push(CharRange::{ lo, hi: 0xD7FF })
    }
    if hi > 0xDFFF {
      out.push(CharRange::{ lo: 0xE000, hi })
    }
  }
}

fn cf_lower_bound(target : Int) -> Int {
  let mut lo = 0
  let mut hi = ucd_cf_keys.length()
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if ucd_cf_keys[mid] < target {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  lo
}

///| Simple case-folding helper: adds case-folded counterparts for a list of `CharRange`s.
pub fn case_fold_ranges(
  ranges : Array[CharRange],
  unicode : Bool,
) -> Array[CharRange] {
  let out : Array[CharRange] = Array::new()
  let mut i = 0
  let n = ranges.length()
  let num_cf = ucd_cf_keys.length()
  while i < n {
    let r = ranges[i]
    out.push(r)
    if !unicode {
      // ASCII A-Z <-> a-z only
      let a_lo = if r.lo > 65 { r.lo } else { 65 }
      let a_hi = if r.hi < 90 { r.hi } else { 90 }
      if a_lo <= a_hi {
        out.push(CharRange::{ lo: a_lo + 32, hi: a_hi + 32 })
      }
      let l_lo = if r.lo > 97 { r.lo } else { 97 }
      let l_hi = if r.hi < 122 { r.hi } else { 122 }
      if l_lo <= l_hi {
        out.push(CharRange::{ lo: l_lo - 32, hi: l_hi - 32 })
      }
    } else {
      // Full UCD 16.0.0 Simple Case Folding via binary search on sorted ucd_cf_keys
      let mut idx = cf_lower_bound(r.lo)
      while idx < num_cf && ucd_cf_keys[idx] <= r.hi {
        let mut p = ucd_cf_offs[idx]
        let p_end = ucd_cf_offs[idx + 1]
        while p < p_end {
          let folded = ucd_cf_vals[p]
          out.push(CharRange::{ lo: folded, hi: folded })
          p = p + 1
        }
        idx = idx + 1
      }
    }
    i = i + 1
  }
  normalize_ranges(out)
}

///| Compile a single inclusive Unicode scalar range `[lo, hi]` into minimal UTF-8 byte-range sequences.
///| Ported directly from `regex-syntax/src/utf8.rs` (Cox / BurntSushi algorithm).
pub fn compile_utf8_range(lo : Int, hi : Int, out : Array[Utf8Seq]) -> Unit {
  if lo > hi {
    return
  }
  let stack_lo : Array[Int] = Array::new()
  let stack_hi : Array[Int] = Array::new()
  // Split around surrogates 0xD800..0xDFFF
  if hi < 0xD800 || lo > 0xDFFF {
    stack_lo.push(lo)
    stack_hi.push(hi)
  } else {
    if hi > 0xDFFF {
      stack_lo.push(0xE000)
      stack_hi.push(hi)
    }
    if lo < 0xD800 {
      stack_lo.push(lo)
      stack_hi.push(0xD7FF)
    }
  }
  while stack_lo.length() > 0 {
    let mut start = match stack_lo.pop() {
      Some(v) => v
      None => break
    }
    let mut end = match stack_hi.pop() {
      Some(v) => v
      None => break
    }
    // Split across UTF-8 byte-length boundaries: 0x7F, 0x7FF, 0xFFFF
    if start <= 0x7F && end > 0x7F {
      stack_lo.push(0x80)
      stack_hi.push(end)
      end = 0x7F
    } else if start <= 0x7FF && end > 0x7FF {
      stack_lo.push(0x800)
      stack_hi.push(end)
      end = 0x7FF
    } else if start <= 0xFFFF && end > 0xFFFF {
      stack_lo.push(0x10000)
      stack_hi.push(end)
      end = 0xFFFF
    }
    // Now start and end have the same UTF-8 length!
    if start <= 0x7F {
      out.push(Utf8Seq::{
        len: 1,
        b0_lo: start,
        b0_hi: end,
        b1_lo: 0,
        b1_hi: 0,
        b2_lo: 0,
        b2_hi: 0,
        b3_lo: 0,
        b3_hi: 0,
      })
      continue
    }
    // Split low aligned boundary: if (start & mask) != 0
    let mut split_done = false
    let mut i = 1
    while i < 4 {
      let m = (1 << (6 * i)) - 1
      if (start & (m ^ -1)) != (end & (m ^ -1)) {
        if (start & m) != 0 {
          let split = start | m
          stack_lo.push(split + 1)
          stack_hi.push(end)
          stack_lo.push(start)
          stack_hi.push(split)
          split_done = true
          break
        }
        if (end & m) != m {
          let split = end & (m ^ -1)
          stack_lo.push(split)
          stack_hi.push(end)
          stack_lo.push(start)
          stack_hi.push(split - 1)
          split_done = true
          break
        }
      }
      i = i + 1
    }
    if split_done {
      continue
    }
    // Emit direct byte-range sequence
    let s_bytes = encode_utf8(start)
    let e_bytes = encode_utf8(end)
    let n = s_bytes.length()
    if n == 2 {
      out.push(Utf8Seq::{
        len: 2,
        b0_lo: s_bytes[0],
        b0_hi: e_bytes[0],
        b1_lo: s_bytes[1],
        b1_hi: e_bytes[1],
        b2_lo: 0,
        b2_hi: 0,
        b3_lo: 0,
        b3_hi: 0,
      })
    } else if n == 3 {
      out.push(Utf8Seq::{
        len: 3,
        b0_lo: s_bytes[0],
        b0_hi: e_bytes[0],
        b1_lo: s_bytes[1],
        b1_hi: e_bytes[1],
        b2_lo: s_bytes[2],
        b2_hi: e_bytes[2],
        b3_lo: 0,
        b3_hi: 0,
      })
    } else {
      out.push(Utf8Seq::{
        len: 4,
        b0_lo: s_bytes[0],
        b0_hi: e_bytes[0],
        b1_lo: s_bytes[1],
        b1_hi: e_bytes[1],
        b2_lo: s_bytes[2],
        b2_hi: e_bytes[2],
        b3_lo: s_bytes[3],
        b3_hi: e_bytes[3],
      })
    }
  }
}

///| Compile a normalized list of `CharRange`s into UTF-8 byte-range sequences.
pub fn compile_utf8_ranges(ranges : Array[CharRange]) -> Array[Utf8Seq] {
  let out : Array[Utf8Seq] = Array::new()
  let mut i = 0
  let n = ranges.length()
  while i < n {
    compile_utf8_range(ranges[i].lo, ranges[i].hi, out)
    i = i + 1
  }
  out
}

fn build_ascii_word_lut() -> FixedArray[Int] {
  let lut = FixedArray::make(128, 0)
  let mut i = 48
  while i <= 57 {
    lut[i] = 1
    i = i + 1
  }
  i = 65
  while i <= 90 {
    lut[i] = 1
    i = i + 1
  }
  lut[95] = 1
  i = 97
  while i <= 122 {
    lut[i] = 1
    i = i + 1
  }
  lut
}

let ascii_word_lut : FixedArray[Int] = build_ascii_word_lut()

///| ASCII word byte check `[0-9A-Za-z_]`.
pub fn is_ascii_word_byte(b : Int) -> Bool {
  b >= 0 && b < 128 && ascii_word_lut[b] != 0
}

///| Binary search in a flat pre-sorted `[lo0, hi0, lo1, hi1, ...]` range table.
fn cp_in_flat_ranges(cp : Int, flat : Array[Int]) -> Bool {
  let mut lo = 0
  let mut hi = flat.length() / 2 - 1
  while lo <= hi {
    let mid = lo + (hi - lo) / 2
    let idx = mid * 2
    let rlo = flat[idx]
    if cp < rlo {
      hi = mid - 1
    } else if cp > flat[idx + 1] {
      lo = mid + 1
    } else {
      return true
    }
  }
  false
}

///| Unicode word codepoint check (exact UCD 16.0.0 `PERL_WORD`, zero allocation).
pub fn is_unicode_word_cp(cp : Int) -> Bool {
  if cp < 0 {
    return false
  }
  if cp < 128 {
    return ascii_word_lut[cp] != 0
  }
  cp_in_flat_ranges(cp, ucd_perl_word)
}

fn flat_to_ranges(flat : Array[Int]) -> Array[CharRange] {
  let out : Array[CharRange] = Array::new()
  let mut i = 0
  let n = flat.length()
  while i + 1 < n {
    out.push(CharRange::{ lo: flat[i], hi: flat[i + 1] })
    i = i + 2
  }
  out
}

///| Shorthand `\d` ranges.
pub fn digit_ranges(unicode : Bool) -> Array[CharRange] {
  if !unicode {
    return [CharRange::{ lo: 48, hi: 57 }]
  }
  flat_to_ranges(ucd_perl_decimal)
}

///| Shorthand `\s` ranges.
pub fn space_ranges(unicode : Bool) -> Array[CharRange] {
  if !unicode {
    return [
      CharRange::{ lo: 9, hi: 13 }, // \t \n \v \f \r
      CharRange::{ lo: 32, hi: 32 }, // ' '
    ]
  }
  flat_to_ranges(ucd_perl_space)
}

///| Shorthand `\w` ranges.
pub fn word_ranges(unicode : Bool) -> Array[CharRange] {
  if !unicode {
    return [
      CharRange::{ lo: 48, hi: 57 },
      CharRange::{ lo: 65, hi: 90 },
      CharRange::{ lo: 95, hi: 95 },
      CharRange::{ lo: 97, hi: 122 },
    ]
  }
  flat_to_ranges(ucd_perl_word)
}

fn append_ranges(dst : Array[CharRange], src : Array[CharRange]) -> Unit {
  let mut i = 0
  let n = src.length()
  while i < n {
    dst.push(src[i])
    i = i + 1
  }
}

///| Unicode `\p{Nd}` (Decimal_Number) ranges.
pub fn unicode_nd_ranges() -> Array[CharRange] {
  flat_to_ranges(ucd_gc_nd)
}

///| Unicode `\p{Lu}` (Uppercase_Letter) ranges.
pub fn unicode_lu_ranges() -> Array[CharRange] {
  flat_to_ranges(ucd_gc_lu)
}

///| Unicode `\p{Ll}` (Lowercase_Letter) ranges.
pub fn unicode_ll_ranges() -> Array[CharRange] {
  flat_to_ranges(ucd_gc_ll)
}

///| Unicode `\p{L}` (Letter) ranges.
pub fn unicode_letter_ranges() -> Array[CharRange] {
  flat_to_ranges(ucd_gc_l)
}

///| Look up a Unicode property name for `\p{name}` / `\P{name}`.
pub fn lookup_unicode_property(name : String) -> Option[Array[CharRange]] {
  if name == "L" || name == "Letter" {
    Some(flat_to_ranges(ucd_gc_l))
  } else if name == "Lu" || name == "Uppercase_Letter" {
