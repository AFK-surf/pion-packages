  } else if name == "Nl" || name == "Letter_Number" {
    Some(flat_to_ranges(ucd_gc_nl))
  } else if name == "No" || name == "Other_Number" {
    Some(flat_to_ranges(ucd_gc_no))
  } else if name == "P" || name == "Punctuation" {
