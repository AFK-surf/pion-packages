///| Public API types for `packages/regex`.

///| Kind of error returned when compiling a regular expression.
pub enum RegexErrorKind {
  Syntax
  CompiledTooBig
  NestLimitExceeded
  UnsupportedFeature
  Unimplemented
}

///| Error returned when compiling a regular expression.
pub val struct RegexError {
  pub kind : RegexErrorKind
  pub pattern : String
  pub offset : Int
  pub message : String
}

///| Options controlling regular expression compilation and matching semantics.
pub val struct RegexOptions {
  pub case_insensitive : Bool
  pub multi_line : Bool
  pub dot_matches_new_line : Bool
  pub swap_greed : Bool
  pub ignore_whitespace : Bool
  pub unicode : Bool
  pub nest_limit : Int
  pub size_limit : Int
}

///| Default options matching Rust `regex` (`(?u)` enabled, others disabled).
pub fn RegexOptions::default() -> RegexOptions {
  RegexOptions::{
    case_insensitive: false,
    multi_line: false,
    dot_matches_new_line: false,
    swap_greed: false,
    ignore_whitespace: false,
    unicode: true,
    nest_limit: 250,
    size_limit: 1000000,
  }
}

///| A single match span in a haystack string (byte offsets `[start, end)`).
pub val struct Match {
  pub start : Int
  pub end : Int
  pub text : String
}

///| Returns the byte length of this match.
pub fn Match::len(self : Match) -> Int {
  self.end - self.start
}

///| Returns true if this match is empty.
pub fn Match::is_empty(self : Match) -> Bool {
  self.start == self.end
}

///| Returns the matched substring.
pub fn Match::as_str(self : Match) -> String {
  self.text
}

///| Capture group matches from a single regex match.
pub struct Captures {
  haystack : String
  slots : Array[Int]
  names : Array[String]
}

///| Returns the number of capture groups (including group 0 for the whole match).
pub fn Captures::len(self : Captures) -> Int {
  self.slots.length() / 2
}

///| Return true if capture group `idx` has both start/end slots within `[0, slots_len)`.
#verify
pub fn captures_slot_valid(idx : Int, slots_len : Int) -> Bool {
  idx >= 0 && idx < slots_len / 2
}

///| Returns the match for capture group `idx` (0 is the entire match).
pub fn Captures::get(self : Captures, idx : Int) -> Option[Match] {
  if !captures_slot_valid(idx, self.slots.length()) {
    return None
  }
  let s = self.slots[idx * 2]
  let e = self.slots[idx * 2 + 1]
  if s < 0 || e < 0 {
    return None
  }
  Some(Match::{ start: s, end: e, text: self.haystack.slice(s, e) })
}

///| Returns the match for the named capture group `name`.
pub fn Captures::name(self : Captures, name : String) -> Option[Match] {
  if name.length() == 0 {
    return None
  }
  let mut i = 0
  let n = self.names.length()
  while i < n {
    if self.names[i] == name {
      return self.get(i)
    }
    i = i + 1
  }
  None
}

fn parse_nonneg_int(s : String) -> Int {
  if s.length() == 0 {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return -1
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

///| Expand a replacement template (`$0`, `$1`, `${1}`, `$name`, `${name}`, `$$`) into `sb`.
pub fn Captures::expand_into(
  self : Captures,
  replacement : String,
  sb : StringBuilder,
) -> Unit {
  let n = replacement.length()
  let mut i = 0
  while i < n {
    let b = replacement.code_unit_at(i)
    if b != 36 {
      // Not '$'
      sb.write_byte(b.to_byte())
      i = i + 1
      continue
    }
    if i + 1 >= n {
      sb.write_byte(36.to_byte())
      break
    }
    let next = replacement.code_unit_at(i + 1)
    if next == 36 {
      // '$$' -> literal '$'
      sb.write_byte(36.to_byte())
      i = i + 2
      continue
    }
    if next == 123 {
      // '${...}'
      let mut j = i + 2
      while j < n && replacement.code_unit_at(j) != 125 {
        j = j + 1
      }
      if j < n {
        let key = replacement.slice(i + 2, j)
        self.write_group_key(key, sb)
        i = j + 1
        continue
      }
      sb.write_byte(36.to_byte())
      i = i + 1
      continue
    }
    if is_ascii_word_byte(next) {
      let mut j = i + 1
      while j < n && is_ascii_word_byte(replacement.code_unit_at(j)) {
        j = j + 1
      }
      let key = replacement.slice(i + 1, j)
      self.write_group_key(key, sb)
      i = j
      continue
    }
    sb.write_byte(36.to_byte())
    i = i + 1
  }
}

fn Captures::write_group_key(
  self : Captures,
  key : String,
  sb : StringBuilder,
) -> Unit {
  let idx = parse_nonneg_int(key)
  if idx >= 0 {
    match self.get(idx) {
      Some(m) => sb.write_string(m.text)
      None => ()
    }
  } else {
    match self.name(key) {
      Some(m) => sb.write_string(m.text)
      None => ()
    }
  }
}

///| Expand a replacement template (`$0`, `$1`, `${1}`, `$name`, `${name}`, `$$`).
pub fn Captures::expand(self : Captures, replacement : String) -> String {
  let sb = StringBuilder::new()
  self.expand_into(replacement, sb)
  sb.to_string()
}

///| A compiled linear-time regular expression.
pub struct Regex {
  pattern : String
  fwd_nfa : Nfa
  fwd_dfa : LazyDfa
  rev_dfa : LazyDfa
  onepass : Option[OnePassDfa]
  pike_cache : PikeVmCache
  use_dfa : Bool
}

///| A compiled set of regular expressions matched simultaneously in a single pass.
pub struct RegexSet {
  patterns : Array[String]
  has_dfa_part : Bool
  dfa_nfa : Nfa
  dfa : LazyDfa
  dfa_pids : Array[Int]
  has_wb_part : Bool
  wb_nfa : Nfa
  wb_dfa : LazyDfa
  wb_pike : PikeVmCache
  wb_pids : Array[Int]
  merge_buf_a : Array[Int]
  merge_buf_b : Array[Int]
}
