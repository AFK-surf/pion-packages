///| Public API types for `packages/regex`.

///| Kind of error returned when compiling a regular expression.
pub enum RegexErrorKind {
  Syntax
  CompiledTooBig
  NestLimitExceeded
  UnsupportedFeature
  Unimplemented
}

///| Error returned when compiling a regular expression.
pub val struct RegexError {
  pub kind : RegexErrorKind
  pub pattern : String
  pub offset : Int
  pub message : String
}

///| Options controlling regular expression compilation and matching semantics.
pub val struct RegexOptions {
  pub case_insensitive : Bool
  pub multi_line : Bool
  pub dot_matches_new_line : Bool
  pub swap_greed : Bool
  pub ignore_whitespace : Bool
  pub unicode : Bool
  pub nest_limit : Int
  pub size_limit : Int
}

///| Default options matching Rust `regex` (`(?u)` enabled, others disabled).
pub fn RegexOptions::default() -> RegexOptions {
  RegexOptions::{
    case_insensitive: false,
    multi_line: false,
    dot_matches_new_line: false,
    swap_greed: false,
    ignore_whitespace: false,
    unicode: true,
    nest_limit: 250,
    size_limit: 1000000,
  }
}

///| A single match span in a haystack string (byte offsets `[start, end)`).
pub val struct Match {
  pub start : Int
  pub end : Int
  pub text : String
}

///| Returns the byte length of this match.
pub fn Match::len(self : Match) -> Int {
  self.end - self.start
}

///| Returns true if this match is empty.
pub fn Match::is_empty(self : Match) -> Bool {
  self.start == self.end
}

///| Returns the matched substring.
pub fn Match::as_str(self : Match) -> String {
  self.text
}

///| Capture group matches from a single regex match.
pub struct Captures {
  haystack : String
  slots : Array[Int]
  names : Array[String]
}

///| Returns the number of capture groups (including group 0 for the whole match).
pub fn Captures::len(self : Captures) -> Int {
  self.slots.length() / 2
}

///| Returns the match for capture group `idx` (0 is the entire match).
pub fn Captures::get(self : Captures, idx : Int) -> Option[Match] {
  if idx < 0 || idx * 2 + 1 >= self.slots.length() {
    return None
  }
  let s = self.slots[idx * 2]
  let e = self.slots[idx * 2 + 1]
  if s < 0 || e < 0 {
    return None
  }
  Some(Match::{ start: s, end: e, text: self.haystack.slice(s, e) })
}

///| Returns the match for the named capture group `name`.
pub fn Captures::name(self : Captures, name : String) -> Option[Match] {
  if name.length() == 0 {
    return None
  }
  let mut i = 0
  let n = self.names.length()
  while i < n {
    if self.names[i] == name {
      return self.get(i)
    }
    i = i + 1
  }
  None
}

///| Expand a replacement template (`$0`, `$1`, `${1}`, `$name`, `${name}`, `$$`).
pub fn Captures::expand(self : Captures, replacement : String) -> String {
  let _ = self
  replacement
}

///| A compiled linear-time regular expression.
pub struct Regex {
  pattern : String
}

///| A compiled set of regular expressions matched simultaneously in a single pass.
pub struct RegexSet {
  patterns : Array[String]
}
