///| Exact O(N * M) Thompson / Russ Cox PikeVM simulator using flat parallel arrays.
///| - Guaranteed linear time in haystack length (zero exponential backtracking).
///| - Zero per-thread heap allocations (flat `states` + `slots` buffers).
///| - Supports full capture group extraction with exact Perl leftmost-first,
///|   greedy, and lazy semantics.
///| - Supports all lookaround assertions (^, $, \A, \z, (?m)^/$, ASCII & Unicode \b/\B).

///| Evaluate a zero-width lookaround assertion at byte position `pos` in `text`.
pub fn eval_look(kind : LookKind, text : String, pos : Int) -> Bool {
  let n = text.length()
  match kind {
    LookKind::StartText => pos == 0
    LookKind::EndText => pos == n
    LookKind::StartLine => pos == 0 || text.code_unit_at(pos - 1) == 10
    LookKind::EndLine => pos == n || text.code_unit_at(pos) == 10
    LookKind::WordBoundaryAscii => {
      let before = pos > 0 && is_ascii_word_byte(text.code_unit_at(pos - 1))
      let after = pos < n && is_ascii_word_byte(text.code_unit_at(pos))
      before != after
    }
    LookKind::NotWordBoundaryAscii => {
      let before = pos > 0 && is_ascii_word_byte(text.code_unit_at(pos - 1))
      let after = pos < n && is_ascii_word_byte(text.code_unit_at(pos))
      before == after
    }
    LookKind::WordBoundaryUnicode => {
      let before = pos > 0 && is_unicode_word_cp(decode_utf8_before(text, pos))
      let after = if pos < n {
        let (cp, _) = decode_utf8(text, pos)
        is_unicode_word_cp(cp)
      } else {
        false
      }
      before != after
    }
    LookKind::NotWordBoundaryUnicode => {
      let before = pos > 0 && is_unicode_word_cp(decode_utf8_before(text, pos))
      let after = if pos < n {
        let (cp, _) = decode_utf8(text, pos)
        is_unicode_word_cp(cp)
      } else {
        false
      }
      before == after
    }
  }
}

///| Iterative epsilon-closure adding active threads in exact priority order into
///| flat `out_states` and `out_slots` (each thread occupies `nslots` ints).
fn pike_add_thread_flat(
  nfa : Nfa,
  text : String,
  pos : Int,
  start_state : Int,
  src_slots : Array[Int],
  src_off : Int,
  nslots : Int,
  out_states : Array[Int],
  out_slots : Array[Int],
  visited : Array[Int],
  gen : Int,
  cur_slots : Array[Int],
  stack_st : Array[Int],
  stack_undo_slot : Array[Int],
  stack_undo_val : Array[Int],
) -> Unit {
  if nslots > 0 {
    let mut k = 0
    while k < nslots {
      cur_slots[k] = src_slots[src_off + k]
      k = k + 1
    }
  }
  stack_st.clear()
  stack_undo_slot.clear()
  stack_undo_val.clear()
  stack_st.push(start_state)
  stack_undo_slot.push(-1)
  stack_undo_val.push(-1)
  let states = nfa.states

  while stack_st.length() > 0 {
    let sid = match stack_st.pop() {
      Some(v) => v
      None => break
    }
    let undo_slot = match stack_undo_slot.pop() {
      Some(v) => v
      None => -1
    }
    let undo_val = match stack_undo_val.pop() {
      Some(v) => v
      None => -1
    }
    if sid < 0 {
      if nslots > 0 && undo_slot >= 0 && undo_slot < nslots {
        cur_slots[undo_slot] = undo_val
      }
      continue
    }
    if visited[sid] == gen {
      continue
    }
    visited[sid] = gen
    let st = states[sid]
    match st.kind {
      NfaKind::Split => {
        if st.out2 >= 0 {
          stack_st.push(st.out2)
          stack_undo_slot.push(-1)
          stack_undo_val.push(-1)
        }
        if st.out1 >= 0 {
          stack_st.push(st.out1)
          stack_undo_slot.push(-1)
          stack_undo_val.push(-1)
        }
      }
      NfaKind::Capture(slot) => {
        if nslots > 0 && slot >= 0 && slot < nslots {
          let old_val = cur_slots[slot]
          stack_st.push(-1)
          stack_undo_slot.push(slot)
          stack_undo_val.push(old_val)
          cur_slots[slot] = pos
        }
        if st.out1 >= 0 {
          stack_st.push(st.out1)
          stack_undo_slot.push(-1)
          stack_undo_val.push(-1)
        }
      }
      NfaKind::Look(lk) =>
      if eval_look(lk, text, pos) && st.out1 >= 0 {
        stack_st.push(st.out1)
        stack_undo_slot.push(-1)
        stack_undo_val.push(-1)
      }
      _ => {
        out_states.push(sid)
        if nslots > 0 {
          let mut k = 0
          while k < nslots {
            out_slots.push(cur_slots[k])
            k = k + 1
          }
        }
      }
    }
  }
}

///| Run PikeVM on `text` over `[start_pos, end_pos]`.
///| If `anchored` is true, match must start at `start_pos`.
///| If `track_captures` is true, writes winning capture slots into `out_slots`.
///| Returns `true` if a match was found.
pub fn pikevm_search(
  nfa : Nfa,
  text : String,
  start_pos : Int,
  end_pos : Int,
  anchored : Bool,
  track_captures : Bool,
  out_slots : Array[Int],
) -> Bool {
  let num_states = nfa.states.length()
  let visited : Array[Int] = Array::new()
  let mut i = 0
  while i < num_states {
    visited.push(0)
    i = i + 1
  }
  let nslots = if track_captures { nfa.num_captures * 2 } else { 0 }
  let empty_slots : Array[Int] = Array::new()
  let scratch_slots : Array[Int] = Array::new()
  i = 0
  while i < nslots {
    empty_slots.push(-1)
    scratch_slots.push(-1)
    i = i + 1
  }
  let stack_st : Array[Int] = Array::new()
  let stack_undo_slot : Array[Int] = Array::new()
  let stack_undo_val : Array[Int] = Array::new()

  let mut cur_st : Array[Int] = Array::new()
  let mut cur_sl : Array[Int] = Array::new()
  let mut nxt_st : Array[Int] = Array::new()
  let mut nxt_sl : Array[Int] = Array::new()

  let start_state = if anchored { nfa.start_anchored } else { nfa.start_unanchored }
  let mut matched = false
  let mut pos = start_pos
  let mut gen = 1

  pike_add_thread_flat(
    nfa,
    text,
    pos,
    start_state,
    empty_slots,
    0,
    nslots,
    cur_st,
    cur_sl,
    visited,
    gen,
    scratch_slots,
    stack_st,
    stack_undo_slot,
    stack_undo_val,
  )

  while pos <= end_pos {
    let has_byte = pos < end_pos
    let b = if has_byte { text.code_unit_at(pos) } else { -1 }
    nxt_st.clear()
    nxt_sl.clear()
    gen = gen + 1

    let mut t = 0
    let nt = cur_st.length()
    while t < nt {
      let sid = cur_st[t]
      let st = nfa.states[sid]
      match st.kind {
        NfaKind::Match(_) => {
          matched = true
          if nslots > 0 {
            out_slots.clear()
            let base = t * nslots
            let mut k = 0
            while k < nslots {
              out_slots.push(cur_sl[base + k])
              k = k + 1
            }
          }
          break
        }
        _ =>
        if has_byte && nfa_state_matches_byte(st.kind, b) && st.out1 >= 0 {
          pike_add_thread_flat(
            nfa,
            text,
            pos + 1,
            st.out1,
            cur_sl,
            t * nslots,
            nslots,
            nxt_st,
            nxt_sl,
            visited,
            gen,
            scratch_slots,
            stack_st,
            stack_undo_slot,
            stack_undo_val,
          )
        }
      }
      t = t + 1
    }

    if !has_byte {
      break
    }
    let tmp_st = cur_st
    cur_st = nxt_st
    nxt_st = tmp_st
    let tmp_sl = cur_sl
    cur_sl = nxt_sl
    nxt_sl = tmp_sl

    if cur_st.length() == 0 && matched {
      break
    }
    pos = pos + 1
  }
  matched
}

///| Run PikeVM for `RegexSet` (collects ALL matching pattern IDs in `text` starting at `start_pos`).
pub fn pikevm_set_matches(
  nfa : Nfa,
  text : String,
  start_pos : Int,
  num_patterns : Int,
  into : Array[Int],
) -> Unit {
  into.clear()
  if num_patterns == 0 {
    return
  }
  let num_states = nfa.states.length()
  let visited : Array[Int] = Array::new()
  let mut i = 0
  while i < num_states {
    visited.push(0)
    i = i + 1
  }
  let hit : Array[Bool] = Array::new()
  i = 0
  while i < num_patterns {
    hit.push(false)
    i = i + 1
  }
  let empty_slots : Array[Int] = Array::new()
  let scratch_slots : Array[Int] = Array::new()
  let stack_st : Array[Int] = Array::new()
  let stack_undo_slot : Array[Int] = Array::new()
  let stack_undo_val : Array[Int] = Array::new()
  let mut cur_st : Array[Int] = Array::new()
  let mut nxt_st : Array[Int] = Array::new()
  let dummy_sl : Array[Int] = Array::new()
  let mut gen = 1
  let end_pos = text.length()

  pike_add_thread_flat(
    nfa,
    text,
    start_pos,
    nfa.start_unanchored,
    empty_slots,
    0,
    0,
    cur_st,
    dummy_sl,
    visited,
    gen,
    scratch_slots,
    stack_st,
    stack_undo_slot,
    stack_undo_val,
  )

  let mut pos = start_pos
  let mut hits_found = 0
  while pos <= end_pos {
    let has_byte = pos < end_pos
    let b = if has_byte { text.code_unit_at(pos) } else { -1 }
    nxt_st.clear()
    gen = gen + 1
    let mut t = 0
    let nt = cur_st.length()
    while t < nt {
      let sid = cur_st[t]
      let st = nfa.states[sid]
      match st.kind {
        NfaKind::Match(pid) =>
        if !hit[pid] {
          hit[pid] = true
          hits_found = hits_found + 1
        }
        _ =>
        if has_byte && nfa_state_matches_byte(st.kind, b) && st.out1 >= 0 {
          pike_add_thread_flat(
            nfa,
            text,
            pos + 1,
            st.out1,
            empty_slots,
            0,
            0,
            nxt_st,
            dummy_sl,
            visited,
            gen,
            scratch_slots,
            stack_st,
            stack_undo_slot,
            stack_undo_val,
          )
        }
      }
      t = t + 1
    }
    if !has_byte || hits_found == num_patterns {
      break
    }
    let tmp = cur_st
    cur_st = nxt_st
    nxt_st = tmp
    if cur_st.length() == 0 {
      break
    }
    pos = pos + 1
  }

  i = 0
  while i < num_patterns {
    if hit[i] {
      into.push(i)
    }
    i = i + 1
  }
}
