///| Stub public API for `packages/regex` (Red phase of Red -> Green TDD).

///| Compile a regular expression with default options.
pub fn compile(pattern : String) -> Result[Regex, RegexError] {
  compile_with(pattern, RegexOptions::default())
}

///| Compile a regular expression with custom options.
pub fn compile_with(
  pattern : String,
  opts : RegexOptions,
) -> Result[Regex, RegexError] {
  let _ = opts
  Err(RegexError::{
    kind: RegexErrorKind::Unimplemented,
    pattern,
    offset: 0,
    message: "regex engine not implemented yet",
  })
}

///| Escape all regex metacharacters in `text`.
pub fn escape(text : String) -> String {
  text
}

///| Returns the original pattern string.
pub fn Regex::as_str(self : Regex) -> String {
  self.pattern
}

///| Returns the number of capture groups (including group 0).
pub fn Regex::captures_len(self : Regex) -> Int {
  0
}

///| Returns the capture group names (None for unnamed groups).
pub fn Regex::capture_names(self : Regex) -> Array[Option[String]] {
  Array::new()
}

///| Returns true if the regex matches anywhere in `text`.
pub fn Regex::is_match(self : Regex, text : String) -> Bool {
  self.is_match_at(text, 0)
}

///| Returns true if the regex matches anywhere in `text` starting at byte offset `start`.
pub fn Regex::is_match_at(self : Regex, text : String, start : Int) -> Bool {
  let _ = self
  let _ = text
  let _ = start
  false
}

///| Finds the leftmost-first match in `text`.
pub fn Regex::find(self : Regex, text : String) -> Option[Match] {
  self.find_at(text, 0)
}

///| Finds the leftmost-first match in `text` starting at byte offset `start`.
pub fn Regex::find_at(self : Regex, text : String, start : Int) -> Option[Match] {
  let _ = self
  let _ = text
  let _ = start
  None
}

///| Finds the leftmost-first match span `(start, end)` without allocating a slice.
pub fn Regex::find_span_at(
  self : Regex,
  text : String,
  start : Int,
) -> Option[(Int, Int)] {
  let _ = self
  let _ = text
  let _ = start
  None
}

///| Finds all non-overlapping match spans into `starts` and `ends`.
pub fn Regex::find_spans_into(
  self : Regex,
  text : String,
  starts : Array[Int],
  ends : Array[Int],
) -> Unit {
  let _ = self
  let _ = text
  starts.clear()
  ends.clear()
}

///| Finds all successive non-overlapping matches in `text`.
pub fn Regex::find_iter(self : Regex, text : String) -> Array[Match] {
  let _ = self
  let _ = text
  Array::new()
}

///| Returns capture groups for the leftmost-first match in `text`.
pub fn Regex::captures(self : Regex, text : String) -> Option[Captures] {
  self.captures_at(text, 0)
}

///| Returns capture groups for the leftmost-first match in `text` starting at `start`.
pub fn Regex::captures_at(
  self : Regex,
  text : String,
  start : Int,
) -> Option[Captures] {
  let _ = self
  let _ = text
  let _ = start
  None
}

///| Writes capture slots into `slots` (length `2 * captures_len()`), returning true if matched.
pub fn Regex::captures_slots_at(
  self : Regex,
  text : String,
  start : Int,
  slots : Array[Int],
) -> Bool {
  let _ = self
  let _ = text
  let _ = start
  let _ = slots
  false
}

///| Returns capture groups for all successive non-overlapping matches in `text`.
pub fn Regex::captures_iter(self : Regex, text : String) -> Array[Captures] {
  let _ = self
  let _ = text
  Array::new()
}

///| Replaces the leftmost-first match with `rep`.
pub fn Regex::replace(self : Regex, text : String, rep : String) -> String {
  self.replacen(text, 1, rep)
}

///| Replaces all non-overlapping matches with `rep`.
pub fn Regex::replace_all(self : Regex, text : String, rep : String) -> String {
  self.replacen(text, 0, rep)
}

///| Replaces at most `limit` matches (`limit == 0` replaces all).
pub fn Regex::replacen(
  self : Regex,
  text : String,
  limit : Int,
  rep : String,
) -> String {
  let _ = self
  let _ = limit
  let _ = rep
  text
}

///| Splits `text` by all matches of this regex.
pub fn Regex::split(self : Regex, text : String) -> Array[String] {
  self.splitn(text, 0)
}

///| Splits `text` into at most `limit` substrings (`limit == 0` means unlimited).
pub fn Regex::splitn(
  self : Regex,
  text : String,
  limit : Int,
) -> Array[String] {
  let _ = self
  let _ = text
  let _ = limit
  Array::new()
}

///| Compile a set of regular expressions with default options.
pub fn compile_set(patterns : Array[String]) -> Result[RegexSet, RegexError] {
  compile_set_with(patterns, RegexOptions::default())
}

///| Compile a set of regular expressions with custom options.
pub fn compile_set_with(
  patterns : Array[String],
  opts : RegexOptions,
) -> Result[RegexSet, RegexError] {
  let _ = opts
  let pat = if patterns.length() > 0 { patterns[0] } else { "" }
  Err(RegexError::{
    kind: RegexErrorKind::Unimplemented,
    pattern: pat,
    offset: 0,
    message: "regex set not implemented yet",
  })
}

///| Returns the number of patterns in the set.
pub fn RegexSet::len(self : RegexSet) -> Int {
  self.patterns.length()
}

///| Returns true if the set contains no patterns.
pub fn RegexSet::is_empty(self : RegexSet) -> Bool {
  self.patterns.length() == 0
}

///| Returns the original pattern strings.
pub fn RegexSet::patterns(self : RegexSet) -> Array[String] {
  self.patterns
}

///| Returns true if any pattern in the set matches anywhere in `text`.
pub fn RegexSet::is_match(self : RegexSet, text : String) -> Bool {
  self.is_match_at(text, 0)
}

///| Returns true if any pattern in the set matches anywhere in `text` starting at `start`.
pub fn RegexSet::is_match_at(
  self : RegexSet,
  text : String,
  start : Int,
) -> Bool {
  let _ = self
  let _ = text
  let _ = start
  false
}

///| Returns sorted indices of all patterns matching `text`.
pub fn RegexSet::matches(self : RegexSet, text : String) -> Array[Int] {
  self.matches_at(text, 0)
}

///| Returns sorted indices of all patterns matching `text` starting at `start`.
pub fn RegexSet::matches_at(
  self : RegexSet,
  text : String,
  start : Int,
) -> Array[Int] {
  let _ = self
  let _ = text
  let _ = start
  Array::new()
}

///| Writes sorted matching pattern indices into `into` (clearing it first).
pub fn RegexSet::matches_into(
  self : RegexSet,
  text : String,
  into : Array[Int],
) -> Unit {
  let _ = self
  let _ = text
  into.clear()
}
