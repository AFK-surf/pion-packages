///| One-Pass DFA for zero-allocation O(match_len) capture group extraction.
///| When an anchored NFA has at most one transition per (state, byte_class),
///| every capture slot update is encoded as a 64-bit bitmask directly on the
///| DFA transition, extracting all capture groups in a single table-driven pass.

///| Compiled One-Pass DFA (present only when the NFA is provably one-pass).
pub struct OnePassDfa {
  stride : Int
  byte_classes : Array[Int]
  nslots : Int
  // Flat transition tables indexed by `op_state * stride + cls`
  trans_next : Array[Int] // -1 = dead, >= 0 = next op_state
  trans_slots : Array[Int64] // bitmask of capture slots to set to `pos`
  match_ok : Array[Bool] // whether op_state can reach Match(0) via epsilon
  match_slots : Array[Int64] // bitmask of capture slots to set at match_end
}

fn op_add_state(
  nid : Int,
  stride : Int,
  nfa_to_op : Array[Int],
  op_nfa_id : Array[Int],
  trans_next : Array[Int],
  trans_slots : Array[Int64],
  match_ok : Array[Bool],
  match_slots : Array[Int64],
) -> Int {
  let existing = nfa_to_op[nid]
  if existing >= 0 {
    return existing
  }
  let oid = op_nfa_id.length()
  nfa_to_op[nid] = oid
  op_nfa_id.push(nid)
  match_ok.push(false)
  match_slots.push(0L)
  let mut c = 0
  while c < stride {
    trans_next.push(-1)
    trans_slots.push(0L)
    c = c + 1
  }
  oid
}

///| Check whether an NFA satisfies the structural bounds for One-Pass DFA compilation.
pub fn onepass_can_compile(
  has_look : Bool,
  num_captures : Int,
  num_nfa : Int,
) -> Bool {
  !has_look && num_captures >= 1 && num_captures <= 31 && num_nfa <= 512
}

///| Record a capture slot into a 64-bit One-Pass DFA transition bitmask.
#verify
pub fn onepass_mask_add_slot(mask : Int64, slot : Int, nslots : Int) -> Int64 {
  if slot >= 0 && slot < nslots && slot < 63 {
    mask | (1L << slot)
  } else {
    mask
  }
}

///| Attempt to compile a forward NFA into a `OnePassDfa`.
///| Returns `None` if the NFA is ambiguous (not one-pass), uses lookarounds,
///| has > 31 capture groups, or exceeds the state budget.
pub fn compile_onepass(nfa : Nfa) -> Option[OnePassDfa] {
  let num_nfa = nfa.states.length()
  if !onepass_can_compile(nfa.has_look, nfa.num_captures, num_nfa) {
    return None
  }
  let nslots = nfa.num_captures * 2
  let stride = nfa.stride
  let rep_bytes = nfa.rep_bytes
  let states = nfa.states

  // Map NFA state ID -> OnePass state ID (-1 if not yet allocated)
  let nfa_to_op : Array[Int] = Array::new()
  let mut i = 0
  while i < num_nfa {
    nfa_to_op.push(-1)
    i = i + 1
  }

  let op_nfa_id : Array[Int] = Array::new()
  let trans_next : Array[Int] = Array::new()
  let trans_slots : Array[Int64] = Array::new()
  let match_ok : Array[Bool] = Array::new()
  let match_slots : Array[Int64] = Array::new()

  let _ = op_add_state(
    nfa.start_anchored,
    stride,
    nfa_to_op,
    op_nfa_id,
    trans_next,
    trans_slots,
    match_ok,
    match_slots,
  )

  // Scratch arrays for epsilon DFS per OnePass state
  let seen : Array[Int] = Array::new()
  let seen_mask : Array[Int64] = Array::new()
  i = 0
  while i < num_nfa {
    seen.push(0)
    seen_mask.push(0L)
    i = i + 1
  }
  let mut gen = 0
  let stack_nid : Array[Int] = Array::new()
  let stack_mask : Array[Int64] = Array::new()

  let mut oid = 0
  while oid < op_nfa_id.length() {
    if op_nfa_id.length() > 512 {
      return None
    }
    gen = gen + 1
    stack_nid.clear()
    stack_mask.clear()
    stack_nid.push(op_nfa_id[oid])
    stack_mask.push(0L)
    let row = oid * stride

    while stack_nid.length() > 0 {
      let cur = match stack_nid.pop() {
        Some(v) => v
        None => break
      }
      let mask = match stack_mask.pop() {
        Some(v) => v
        None => 0L
      }
      if seen[cur] == gen {
        // Reached same NFA state twice in epsilon closure -> ambiguous if mask differs or loop
        return None
      }
      seen[cur] = gen
      seen_mask[cur] = mask
      let st = states[cur]
      match st.kind {
        NfaKind::Split => {
          if st.out2 >= 0 {
            stack_nid.push(st.out2)
            stack_mask.push(mask)
          }
          if st.out1 >= 0 {
            stack_nid.push(st.out1)
            stack_mask.push(mask)
          }
        }
        NfaKind::Capture(slot) => {
          let nmask = onepass_mask_add_slot(mask, slot, nslots)
          if st.out1 >= 0 {
            stack_nid.push(st.out1)
            stack_mask.push(nmask)
          }
        }
        NfaKind::Look(_) => return None
        NfaKind::Match(_) => {
          if match_ok[oid] {
            return None
          }
          match_ok[oid] = true
          match_slots[oid] = mask
        }
        NfaKind::Sparse(edges) => {
          let mut c = 0
          while c < stride {
            let dst_nid = nfa_sparse_next(edges, rep_bytes[c])
            if dst_nid >= 0 {
              if trans_next[row + c] >= 0 {
                return None
              }
              let dst_oid = op_add_state(
                dst_nid,
                stride,
                nfa_to_op,
                op_nfa_id,
                trans_next,
                trans_slots,
                match_ok,
                match_slots,
              )
              trans_next[row + c] = dst_oid
              trans_slots[row + c] = mask
            }
            c = c + 1
          }
        }
        _ => {
          // Consuming state: map every matching byte class
          let dst_nid = st.out1
          if dst_nid < 0 {
            continue
          }
          let mut dst_oid = -1
          let mut c = 0
          while c < stride {
            if nfa_state_matches_byte(st.kind, rep_bytes[c]) {
              if trans_next[row + c] >= 0 {
                // Ambiguous! Two distinct paths consume the same byte class.
                return None
              }
              if dst_oid < 0 {
                dst_oid = op_add_state(
                  dst_nid,
                  stride,
                  nfa_to_op,
                  op_nfa_id,
                  trans_next,
                  trans_slots,
                  match_ok,
                  match_slots,
                )
              }
              trans_next[row + c] = dst_oid
              trans_slots[row + c] = mask
            }
            c = c + 1
          }
        }
      }
    }
    oid = oid + 1
  }

  Some(OnePassDfa::{
    stride,
    byte_classes: nfa.byte_classes,
    nslots,
    trans_next,
    trans_slots,
    match_ok,
    match_slots,
  })
}

fn apply_slot_mask(slots : Array[Int], mask : Int64, pos : Int) -> Unit {
  let mut m = mask
  let mut bit = 0
  while m != 0L {
    if (m & 1L) != 0L {
      slots[bit] = pos
    }
    m = (m >> 1) & 0x7FFFFFFFFFFFFFFFL
    bit = bit + 1
  }
}

///| Execute One-Pass DFA anchored over `[start_pos, end_pos]`, filling `slots`.
///| Returns `true` if matched cleanly, `false` otherwise.
pub fn OnePassDfa::captures(
  self : OnePassDfa,
  text : String,
  start_pos : Int,
  end_pos : Int,
  slots : Array[Int],
) -> Bool {
  let nslots = self.nslots
  if slots.length() != nslots {
    slots.clear()
    let mut k = 0
    while k < nslots {
      slots.push(-1)
      k = k + 1
    }
  } else {
    let mut k = 0
    while k < nslots {
      slots[k] = -1
      k = k + 1
    }
  }
  let stride = self.stride
  let byte_classes = self.byte_classes
  let trans_next = self.trans_next
  let trans_slots = self.trans_slots
  let mut st = 0
  let mut pos = start_pos
  while pos < end_pos {
    let idx = st * stride + byte_classes[text.code_unit_at(pos)]
    let nxt = trans_next[idx]
    if nxt < 0 {
      return false
    }
    let mask = trans_slots[idx]
    if mask != 0L {
      apply_slot_mask(slots, mask, pos)
    }
    st = nxt
    pos = pos + 1
  }
  if !self.match_ok[st] {
    return false
  }
  let emask = self.match_slots[st]
  if emask != 0L {
    apply_slot_mask(slots, emask, end_pos)
  }
  true
}
