///| Control tests for the red-team audit: behaviours that already agree with Rust
///| `regex =1.11.1` (expected values read from the oracle). They must PASS; a failure here
///| means the audit harness or the engine regressed, not a new red-team finding.
import "regex"

fn c_re(pat : String) -> regex::Regex {
  match regex::compile(pat) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "compile failed for '" + pat + "': " + e.message)
      panic()
    }
  }
}

fn c_find(pat : String, hay : String) -> String {
  match c_re(pat).find(hay) {
    Some(m) => m.start.to_string() + "-" + m.end.to_string()
    None => "none"
  }
}

fn grp(c : regex::Captures, i : Int) -> String {
  match c.get(i) {
    Some(m) => m.start.to_string() + "-" + m.end.to_string()
    None => "none"
  }
}

test "control: leftmost-first alternation and laziness" {
  debug_assert(c_find("(a|ab)", "ab") == "0-1", "(a|ab)")
  debug_assert(c_find("(ab|a)", "ab") == "0-2", "(ab|a)")
  debug_assert(c_find("a+?", "aaa") == "0-1", "a+?")
  debug_assert(c_find("a{1,3}?", "aaa") == "0-1", "a{1,3}?")
  debug_assert(c_find("(?U)a+", "aaa") == "0-1", "(?U)a+")
}

test "control: one-pass captures on multi-byte UTF-8" {
  match c_re("(中)(文)?").captures("中文") {
    Some(c) => {
      debug_assert(grp(c, 1) == "0-3", "group 1")
      debug_assert(grp(c, 2) == "3-6", "group 2")
    }
    None => debug_assert(false, "should match")
  }
  match c_re("(a+)?(a+)").captures("aaa") {
    Some(c) => debug_assert(grp(c, 1) == "0-2" && grp(c, 2) == "2-3", "(a+)?(a+)")
    None => debug_assert(false, "should match")
  }
}

test "control: empty pattern iterates by code point" {
  let ms = c_re("").find_iter("a中🚀b")
  debug_assert(ms.length() == 5, "'' on a中🚀b has 5 empty matches")
  debug_assert(ms[2].start == 4 && ms[3].start == 8, "advances by whole code points")
}

test "control: RegexSet matches and compile limits" {
  match regex::compile_set(["a", "b+", "^a", "a$", "\\bfoo\\b", "(?i)FOO"]) {
    Ok(s) => {
      let m = s.matches("afoob")
      debug_assert(
        m.length() == 4 && m[0] == 0 && m[1] == 1 && m[2] == 2 && m[3] == 5,
        "set matches (Rust: 0,1,2,5)",
      )
    }
    Err(_) => debug_assert(false, "set compiles")
  }
  match regex::compile("a{1000000000}") {
    Ok(_) => debug_assert(false, "repetition bomb must be rejected")
    Err(_) => ()
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 20000 {
    sb.write_string("(")
    i = i + 1
  }
  match regex::compile(sb.to_string()) {
    Ok(_) => debug_assert(false, "20000 '(' must be rejected")
    Err(e) =>
    match e.kind {
      regex::RegexErrorKind::NestLimitExceeded => ()
      _ => debug_assert(false, "expected NestLimitExceeded")
    }
  }
}

test "control: replacement templates that already agree with Rust" {
  let r = c_re("(?P<name>a)(b)?")
  debug_assert(r.replace_all("abaab", "[$name_x|${name}x|$2|$$|$10|$99]") == "[|ax|b|$||][|ax||$||][|ax|b|$||]", "templates")
  debug_assert(r.replace_all("ab", "a$") == "a$", "trailing $")
}
