///| Differential driver for `packages/regex` (Pion side).
///| Reads the same hex case file as `audit/diff/rust_oracle` and prints the
///| very same canonical transcript, so the two outputs can be `diff`-ed byte for byte.
///|
///| Line formats:
///|   R <hex pattern> <hex haystack> <hex replacement>
///|   S <hex haystack> <hex pat1>,<hex pat2>,...

import "regex"

fn hexval(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    0
  }
}

fn unhex(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length() / 2
  let mut i = 0
  while i < n {
    let v = hexval(s.code_unit_at(2 * i)) * 16 + hexval(s.code_unit_at(2 * i + 1))
    sb.write_byte(v.to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn hex_into(s : String, sb : StringBuilder) -> Unit {
  let digits = "0123456789abcdef"
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    sb.write_byte(digits.code_unit_at(b / 16).to_byte())
    sb.write_byte(digits.code_unit_at(b % 16).to_byte())
    i = i + 1
  }
}

fn span_into(m : Option[regex::Match], sb : StringBuilder) -> Unit {
  match m {
    Some(x) => {
      sb.write_string(x.start.to_string())
      sb.write_string("-")
      sb.write_string(x.end.to_string())
    }
    None => sb.write_string("none")
  }
}

fn caps_into(c : regex::Captures, sb : StringBuilder) -> Unit {
  let mut i = 0
  while i < c.len() {
    if i > 0 {
      sb.write_string(";")
    }
    span_into(c.get(i), sb)
    i = i + 1
  }
}

fn split_fields(line : String, sep : Int) -> Array[String] {
  let out : Array[String] = Array::new()
  let mut last = 0
  let mut i = 0
  while i < line.length() {
    if line.code_unit_at(i) == sep {
      out.push(line.slice(last, i))
      last = i + 1
    }
    i = i + 1
  }
  out.push(line.slice(last, line.length()))
  out
}

fn strs_into(xs : Array[String], sb : StringBuilder) -> Unit {
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(",")
    }
    hex_into(xs[i], sb)
    i = i + 1
  }
}

fn run_set(f : Array[String], sb : StringBuilder) -> Unit {
  let hay = unhex(f[1])
  let pats : Array[String] = Array::new()
  if f.length() > 2 && f[2].length() > 0 {
    let hs = split_fields(f[2], 44)
    let mut i = 0
    while i < hs.length() {
      pats.push(unhex(hs[i]))
      i = i + 1
    }
  }
  match regex::compile_set(pats) {
    Err(_) => sb.write_string("set=ERR\n")
    Ok(set) => {
      sb.write_string("set_is_match=")
      sb.write_string(if set.is_match(hay) { "1" } else { "0" })
      sb.write_string("\nset_matches=")
      let m = set.matches(hay)
      let mut i = 0
      while i < m.length() {
        if i > 0 {
          sb.write_string(",")
        }
        sb.write_string(m[i].to_string())
        i = i + 1
      }
      sb.write_string("\n")
    }
  }
}

fn run_regex(f : Array[String], sb : StringBuilder) -> Unit {
  let pat = unhex(f[1])
  let hay = unhex(f[2])
  let rep = unhex(f[3])
  let re = match regex::compile(pat) {
    Ok(r) => r
    Err(_) => {
      sb.write_string("compile=ERR\n")
      return
    }
  }
  sb.write_string("compile=ok caps=")
  sb.write_string(re.captures_len().to_string())
  sb.write_string("\nis_match=")
  sb.write_string(if re.is_match(hay) { "1" } else { "0" })
  sb.write_string("\nfind=")
  span_into(re.find(hay), sb)
  sb.write_string("\nfind_iter=")
  let it = re.find_iter(hay)
  let mut i = 0
  while i < it.length() {
    if i > 0 {
      sb.write_string(",")
    }
    span_into(Some(it[i]), sb)
    i = i + 1
  }
  sb.write_string("\nfind_at=")
  let n = hay.length()
  let mut p = 0
  let mut first = true
  while p <= n {
    if p == n || hay.code_unit_at(p) / 64 != 2 {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string(p.to_string())
      sb.write_string(":")
      span_into(re.find_at(hay, p), sb)
      if !re.is_match_at(hay, p) {
        sb.write_string("!")
      }
    }
    p = p + 1
  }
  sb.write_string("\ncaptures=")
  match re.captures(hay) {
    Some(c) => caps_into(c, sb)
    None => sb.write_string("none")
  }
  sb.write_string("\ncaptures_iter=")
  let ci = re.captures_iter(hay)
  i = 0
  while i < ci.length() {
    if i > 0 {
      sb.write_string("|")
    }
    caps_into(ci[i], sb)
    i = i + 1
  }
  sb.write_string("\nreplace=")
  hex_into(re.replace(hay, rep), sb)
  sb.write_string("\nreplace_all=")
  hex_into(re.replace_all(hay, rep), sb)
  sb.write_string("\nreplacen2=")
  hex_into(re.replacen(hay, 2, rep), sb)
  sb.write_string("\nsplit=")
  strs_into(re.split(hay), sb)
  sb.write_string("\nsplitn2=")
  strs_into(re.splitn(hay, 2), sb)
  sb.write_string("\nsplitn3=")
  strs_into(re.splitn(hay, 3), sb)
  sb.write_string("\n")
}

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return 0
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: regex_audit_driver <cases>")
    return 2
  }
  let data = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: cannot read " + args[1])
      return 2
    }
  }
  let lines = split_fields(data, 10)
  // Optional 1-based line to resume from (used by run_diff.py after a crash).
  let mut idx = if args.length() > 2 { parse_int(args[2]) - 1 } else { 0 }
  if idx < 0 {
    idx = 0
  }
  while idx < lines.length() {
    let line = lines[idx]
    idx = idx + 1
    if line.length() == 0 || line.code_unit_at(0) == 35 {
      continue
    }
    let f = split_fields(line, 9)
    let sb = StringBuilder::new()
    sb.write_string("## ")
    sb.write_string(idx.to_string())
    sb.write_string("\n")
    if f[0] == "S" {
      run_set(f, sb)
    } else {
      run_regex(f, sb)
    }
    io_print(world, sb.to_string())
  }
  0
}
