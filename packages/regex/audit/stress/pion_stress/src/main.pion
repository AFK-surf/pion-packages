///| Stress / DoS / adversarial-performance driver for `packages/regex` (Pion side).
///| Mirrors `audit/stress/rust_stress` mode-for-mode; stdout must be byte-identical.
///|
///| usage:
///|   regex_audit_stress compile  <pattern_file>                  # compile only
///|   regex_audit_stress compile_nl <pattern_file>                # compile, nest_limit=1e6
///|   regex_audit_stress find     <pattern_file> <hay_file> <iters> # find_iter count+checksum
///|   regex_audit_stress caps     <pattern_file> <hay_file> <iters> # captures_iter checksum
///|   regex_audit_stress is_match <pattern_file> <hay_file> <iters> # per-line is_match count
///|   regex_audit_stress set      <patterns_file> <hay_file> <iters> # per-line RegexSet checksum
///| Pattern files hold the raw pattern bytes (set: one pattern per line).

import "regex"

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return 1
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn lines_of(s : String) -> Array[String] {
  let out : Array[String] = Array::new()
  let mut last = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == 10 {
      out.push(s.slice(last, i))
      last = i + 1
    }
    i = i + 1
  }
  if last < s.length() {
    out.push(s.slice(last, s.length()))
  }
  out
}

fn kind_name(k : regex::RegexErrorKind) -> String {
  match k {
    regex::RegexErrorKind::Syntax => "Syntax"
    regex::RegexErrorKind::CompiledTooBig => "CompiledTooBig"
    regex::RegexErrorKind::NestLimitExceeded => "NestLimitExceeded"
    regex::RegexErrorKind::UnsupportedFeature => "UnsupportedFeature"
    regex::RegexErrorKind::Unimplemented => "Unimplemented"
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: regex_audit_stress <mode> <pattern_file> [hay_file iters]")
    return 2
  }
  let mode = args[1]
  let pat_src = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => return 2
  }
  let hay = if args.length() > 3 {
    match fs_read(world, args[3]) {
      Ok(s) => s
      Err(_) => return 2
    }
  } else {
    ""
  }
  let iters = if args.length() > 4 { parse_int(args[4]) } else { 1 }
  if mode == "set" {
    let pats = lines_of(pat_src)
    let set = match regex::compile_set(pats) {
      Ok(s) => s
      Err(_) => {
        io_println(world, "compile=ERR")
        return 0
      }
    }
    let lines = lines_of(hay)
    let buf : Array[Int] = Array::new()
    let mut hits : Int64 = 0L
    let mut ck : Int64 = 0L
    let mut it = 0
    while it < iters {
      let mut li = 0
      while li < lines.length() {
        set.matches_into(lines[li], buf)
        let mut h = 0
        while h < buf.length() {
          hits = hits + 1L
          ck = (ck * 131L + (buf[h] + 1).to_int64() + li.to_int64()) % 1000000007L
          h = h + 1
        }
        li = li + 1
      }
      it = it + 1
    }
    io_println(world, "set rules=" + set.len().to_string() + " hits=" + hits.to_string() + " checksum=" + ck.to_string())
    return 0
  }
  // `compile_nl`: same as `compile` but with nest_limit raised to 1,000,000 (stack-depth probe).
  let opts = if mode == "compile_nl" {
    let d = regex::RegexOptions::default()
    regex::RegexOptions::{ ..d, nest_limit: 1000000 }
  } else {
    regex::RegexOptions::default()
  }
  let re = match regex::compile_with(pat_src, opts) {
    Ok(r) => r
    Err(e) => {
      io_println(world, "compile=ERR")
      io_eprintln(world, "error kind=" + kind_name(e.kind) + " msg=" + e.message)
      return 0
    }
  }
  if mode == "compile" || mode == "compile_nl" {
    io_println(world, "compile=ok caps=" + re.captures_len().to_string())
    return 0
  }
  let mut count : Int64 = 0L
  let mut ck : Int64 = 0L
  let mut it = 0
  if mode == "find" {
    let starts : Array[Int] = Array::new()
    let ends : Array[Int] = Array::new()
    while it < iters {
      re.find_spans_into(hay, starts, ends)
      let mut i = 0
      while i < starts.length() {
        count = count + 1L
        ck = (ck * 131L + starts[i].to_int64() + ends[i].to_int64() * 7L) % 1000000007L
        i = i + 1
      }
      it = it + 1
    }
  } else if mode == "caps" {
    let slots : Array[Int] = Array::new()
    let n = hay.length()
    while it < iters {
      let mut pos = 0
      while pos <= n {
        if !re.captures_slots_at(hay, pos, slots) {
          break
        }
        count = count + 1L
        let mut g = 0
        while g < slots.length() {
          ck = (ck * 131L + slots[g].to_int64() + 1L) % 1000000007L
          g = g + 1
        }
        if slots[0] == slots[1] {
          pos = slots[1] + 1
        } else {
          pos = slots[1]
        }
      }
      it = it + 1
    }
  } else if mode == "is_match" {
    let lines = lines_of(hay)
    while it < iters {
      let mut li = 0
      while li < lines.length() {
        if re.is_match(lines[li]) {
          count = count + 1L
          ck = (ck * 131L + li.to_int64()) % 1000000007L
        }
        li = li + 1
      }
      it = it + 1
    }
  } else {
    io_println(world, "unknown mode " + mode)
    return 2
  }
  io_println(world, mode + " matches=" + count.to_string() + " checksum=" + ck.to_string())
  0
}
