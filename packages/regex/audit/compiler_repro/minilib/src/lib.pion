///| Minimal reproduction of the pionc `--release` miscompile behind regex finding P0-1.
///| A package that declares an enum with a variant named `None` (here `Pf::None`, in
///| `packages/regex` it is `Prefilter::None` in src/nfa.pion) makes a bare `None` returned
///| as `Option[T]` from a pub function arrive as `Some(..)` in a downstream package when
///| built with `--release`. Debug builds are correct. Delete `Pf` and the bug disappears.

///| A heap struct, like `regex::Captures`.
pub struct Caps {
  hay : String
  slots : Array[Int]
}

///| Returns `None` unless `text` has length 12345.
pub fn mk_none(text : String) -> Option[Caps] {
  if text.length() == 12345 {
    return Some(Caps::{ hay: text, slots: Array::new() })
  }
  None
}

///| Always returns `None`.
pub fn mk_none2() -> Option[Caps] {
  None
}

///| The trigger: an enum variant spelled `None` (like `Prefilter::None`).
pub enum Pf {
  None
  Lit(Array[Int])
}
