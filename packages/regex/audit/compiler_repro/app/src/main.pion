///| Expected output (debug and release): `a=false b=false`, exit 0.
///| pionc 0.1.0 `--release` prints `a=true b=true` and exits 1.
import "minilib"

///|
pub fn main(world : World) -> Int {
  let a = minilib::mk_none("abc").is_some()
  let b = minilib::mk_none2().is_some()
  io_println(world, "a=" + a.to_string() + " b=" + b.to_string())
  if a || b {
    1
  } else {
    0
  }
}
