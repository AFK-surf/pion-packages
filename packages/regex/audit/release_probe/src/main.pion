///| P0-1 probe: `None` returned by `packages/regex` public APIs under `--release`.
///| Run in all four build modes (see run_audit.sh): native debug, native --release,
///| wasm32 debug, wasm32 --release. Every line must print PASS; exit code = #FAIL.
///| Under --release the `None` of `captures`/`captures_at` comes back as `Some(<garbage
///| Captures>)`; touching it (e.g. `caps.get(0)`) is a SIGSEGV on native.
import "regex"

fn compile_or_die(p : String) -> regex::Regex {
  match regex::compile(p) {
    Ok(r) => r
    Err(_) => panic()
  }
}

fn report(world : World, name : String, ok : Bool) -> Int {
  io_println(world, (if ok { "PASS " } else { "FAIL " }) + name)
  if ok {
    0
  } else {
    1
  }
}

///|
pub fn main(world : World) -> Int {
  let x = compile_or_die("x")
  let mut fails = 0
  fails = fails +
  report(world, "find(no match) is None", match x.find("abc") {
    Some(_) => false
    None => true
  })
  fails = fails +
  report(world, "captures_slots_at(no match) is false", !x.captures_slots_at("abc", 0, []))
  // The following go through `Option[Captures]`.
  fails = fails +
  report(world, "captures(no match) is None", match x.captures("abc") {
    Some(_) => false
    None => true
  })
  fails = fails +
  report(world, "captures_at(no match) is None", match x.captures_at("abc", 1) {
    Some(_) => false
    None => true
  })
  let alt = compile_or_die("(a)|b")
  fails = fails +
  report(world, "Captures::get(non-participating group) is None", match alt.captures("b") {
    Some(c) =>
    match c.get(1) {
      Some(_) => false
      None => true
    }
    None => false
  })
  fails = fails +
  report(world, "Captures::name(unknown) is None", match compile_or_die("(?P<y>a)").captures("a") {
    Some(c) =>
    match c.name("nope") {
      Some(_) => false
      None => true
    }
    None => false
  })
  fails = fails +
  report(world, "capture_names()[0] is None", match compile_or_die("(?P<y>a)").capture_names()[0] {
    Some(_) => false
    None => true
  })
  io_println(world, "release_probe_failures=" + fails.to_string())
  fails
}
