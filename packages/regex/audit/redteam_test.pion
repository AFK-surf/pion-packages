///| Red-team evidence for `packages/regex` vs Rust `regex =1.11.1`.
///| Every expected value below was read from the real Rust crate via
///| `audit/diff/rust_oracle` (see REPORT.md). Each red test asserts the CORRECT
///| (Rust-compatible) behaviour: it FAILS while the defect exists and PASSES once fixed.
///| Test names carry the finding id from REPORT.md.
import "regex"

fn re(pat : String) -> regex::Regex {
  match regex::compile(pat) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "compile failed for '" + pat + "': " + e.message)
      panic()
    }
  }
}

fn spans(r : regex::Regex, hay : String) -> String {
  let ms = r.find_iter(hay)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ms.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(ms[i].start.to_string() + "-" + ms[i].end.to_string())
    i = i + 1
  }
  sb.to_string()
}

fn find_str(pat : String, hay : String) -> String {
  match re(pat).find(hay) {
    Some(m) => m.start.to_string() + "-" + m.end.to_string()
    None => "none"
  }
}

fn join(xs : Array[String]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string("|")
    }
    sb.write_string(xs[i])
    i = i + 1
  }
  sb.to_string()
}

fn expect_eq(what : String, got : String, want : String) -> Unit {
  debug_assert(got == want, what + ": got [" + got + "], Rust regex 1.11.1 gives [" + want + "]")
}

fn expect_err(pat : String) -> Unit {
  match regex::compile(pat) {
    Ok(_) => debug_assert(false, "'" + pat + "' compiled, Rust regex 1.11.1 rejects it")
    Err(_) => ()
  }
}

fn expect_ok(pat : String) -> Unit {
  match regex::compile(pat) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "'" + pat + "' rejected (" + e.message + "), Rust regex 1.11.1 accepts it")
  }
}

fn is_char_boundary(s : String, i : Int) -> Bool {
  i == 0 || i == s.length() || s.code_unit_at(i) / 64 != 2
}

// ---------------------------------------------------------------- P0

test "P0-2 \\B empty match is reported inside a multi-byte code point" {
  let hay = "k🚀1x"
  expect_eq("find(\\B)", find_str("\\B", hay), "6-6")
  expect_eq("find_iter(\\B)", spans(re("\\B"), hay), "6-6")
  // replace_all splits the rocket emoji and emits invalid UTF-8 today
  expect_eq("replace_all(\\B,'[]')", re("\\B").replace_all(hay, "[]"), "k🚀1[]x")
}

test "P0-2 \\b empty match is reported inside a multi-byte code point" {
  expect_eq("find_iter(\\b) on 中文", spans(re("\\b"), "中文"), "0-0,6-6")
  expect_eq("find_iter(\\b) on aé", spans(re("\\b"), "aé"), "0-0,3-3")
  let r = re("\\b")
  let hay = "éa中x"
  let ms = r.find_iter(hay)
  let mut i = 0
  while i < ms.length() {
    debug_assert(
      is_char_boundary(hay, ms[i].start),
      "\\b match at byte " + ms[i].start.to_string() + " is not a char boundary of " + hay,
    )
    i = i + 1
  }
}

// ---------------------------------------------------------------- P1: iteration

test "P1-1 empty match abutting the previous match is not skipped (find_iter)" {
  expect_eq("a* find_iter baaac", spans(re("a*"), "baaac"), "0-0,1-4,5-5")
  expect_eq("a? find_iter ab", spans(re("a?"), "ab"), "0-1,2-2")
  expect_eq(".* find_iter a", spans(re(".*"), "a"), "0-1")
}

test "P1-1 empty match abutting the previous match is not skipped (replace_all/split/captures_iter)" {
  let r = re("a*")
  expect_eq("a* replace_all baaac", r.replace_all("baaac", "-"), "-b-c-")
  expect_eq("a* split baaac", join(r.split("baaac")), "|b|c|")
  expect_eq("a* captures_iter count", r.captures_iter("baaac").length().to_string(), "3")
  expect_eq("(a)? replace_all ba", re("(a)?").replace_all("ba", "[$0]"), "[]b[a]")
}

// ---------------------------------------------------------------- P1: anchors

test "P1-2 (?m)$ never matches an empty span right before \\n" {
  expect_eq("(?m)$ on a\\n", find_str("(?m)$", "a\n"), "1-1")
  expect_eq("(?m)$ on \\n", find_str("(?m)$", "\n"), "0-0")
  expect_eq("(?m)^$ on \\n", find_str("(?m)^$", "\n"), "0-0")
  expect_eq("(?m)$ replace_all", re("(?m)$").replace_all("ab\ncd", ";"), "ab;\ncd;")
  expect_eq("(?m)(a|$) on \\n", find_str("(?m)(a|$)", "\n"), "0-0")
}

// ---------------------------------------------------------------- P1: leftmost-first with nullable loop bodies

test "P1-3 nullable loop body: leftmost-first priority differs from Rust" {
  expect_eq("(?:\\b|a)+ on a", find_str("(?:\\b|a)+", "a"), "0-0")
  expect_eq("(|a)* on aa", find_str("(|a)*", "aa"), "0-0")
  expect_eq("(b*|a)+ on acabac", find_str("(b*|a)+", "acabac"), "0-0")
  expect_eq("(?m)(?:^|a)+ on a", find_str("(?m)(?:^|a)+", "a"), "0-0")
  expect_eq("^(a{0,2}?)* on aa", find_str("^(a{0,2}?)*", "aa"), "0-0")
}

test "P1-3 empty final iteration of a starred group is not recorded" {
  let cases = [("(a*)*", ""), ("(a?)*", "\n"), ("(|a)*", ""), ("(\\A)*", "b")]
  let mut i = 0
  while i < cases.length() {
    let (p, h) = cases[i]
    match re(p).captures(h) {
      Some(c) =>
      match c.get(1) {
        Some(m) => expect_eq(p + " group 1", m.start.to_string() + "-" + m.end.to_string(), "0-0")
        None => debug_assert(false, p + " on '" + h + "': group 1 is None, Rust regex 1.11.1 gives 0-0")
      }
      None => debug_assert(false, p + " should match")
    }
    i = i + 1
  }
}

// ---------------------------------------------------------------- P1: character classes

test "P1-4 class set operations && -- ~~ are silently treated as literals" {
  expect_eq("[a-c&&b] on a", find_str("[a-c&&b]", "a"), "none")
  expect_eq("[a-c&&b] on b", find_str("[a-c&&b]", "b"), "0-1")
  expect_eq("[a-z--b] on b", find_str("[a-z--b]", "b"), "none")
  expect_eq("[a-z~~c] on c", find_str("[a-z~~c]", "c"), "none")
  expect_eq("[a&&[^b]] on b]", find_str("[a&&[^b]]", "b]"), "none")
}

test "P1-4 nested classes [[a]] / [a[b]] / [^[a]] are mis-parsed" {
  expect_eq("[[a]] on a", find_str("[[a]]", "a"), "0-1")
  expect_eq("[a[b]] on b]", find_str("[a[b]]", "b]"), "0-1")
  expect_eq("[^[a]] on 中", find_str("[^[a]]", "中"), "0-3")
  expect_eq("[[^a]] on ]", find_str("[[^a]]", "]"), "0-1")
}

test "P1-5 '[' nesting bypasses nest_limit (and compiles in super-linear time)" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 300 {
    sb.write_string("[")
    i = i + 1
  }
  sb.write_string("a")
  i = 0
  while i < 300 {
    sb.write_string("]")
    i = i + 1
  }
  match regex::compile(sb.to_string()) {
    Ok(_) => debug_assert(false, "300 nested '[' compiled; nest_limit=250 must reject it like Rust")
    Err(e) =>
    match e.kind {
      regex::RegexErrorKind::NestLimitExceeded => ()
      _ => debug_assert(false, "expected NestLimitExceeded, got: " + e.message)
    }
  }
}

// ---------------------------------------------------------------- P1: Unicode

test "P1-6 (?i) simple case folding misses Unicode equivalents" {
  expect_eq("(?i)k on Kelvin sign", find_str("(?i)k", "\u{212A}"), "0-3")
  expect_eq("(?i)K on Kelvin sign", find_str("(?i)K", "\u{212A}"), "0-3")
  expect_eq("(?i)K(kelvin) on k", find_str("(?i)\u{212A}", "k"), "0-1")
  expect_eq("(?i)s on long s", find_str("(?i)s", "ſ"), "0-2")
  expect_eq("(?i)σ on final sigma", find_str("(?i)σ", "ς"), "0-2")
  expect_eq("(?i)ǅ on ǆ", find_str("(?i)ǅ", "ǆ"), "0-2")
  expect_eq("(?i)[k] on Kelvin sign", find_str("(?i)[k]", "\u{212A}"), "0-3")
}

test "P1-7 Unicode property / Perl class tables are incomplete" {
  expect_eq("\\w on ﬀ", find_str("\\w", "ﬀ"), "0-3")
  expect_eq("\\w on Kelvin sign", find_str("\\w", "\u{212A}"), "0-3")
  expect_eq("\\pN on ①", find_str("\\pN", "①"), "0-3")
  expect_eq("\\p{Lu} on İ", find_str("\\p{Lu}", "İ"), "0-2")
  expect_eq("\\p{Ll} on ı", find_str("\\p{Ll}", "ı"), "0-2")
  expect_eq("\\p{Ll} on ſ", find_str("\\p{Ll}", "ſ"), "0-2")
  expect_eq("\\b on ﬀ", find_str("\\b", "ﬀ ﬃ"), "0-0")
}

test "P1-8 (?-u) classes that match invalid UTF-8 are accepted on String haystacks" {
  // Rust rejects these at compile time for `&str` haystacks; Pion accepts them and then
  // returns matches that split code points (e.g. `(?-u).` on 中 yields 0-1,1-2,2-3).
  expect_err("(?-u).")
  expect_err("(?-u)[^a]")
  expect_err("(?-u)\\W")
  expect_err("(?-u:\\xFF)")
}

// ---------------------------------------------------------------- P2: syntax acceptance

test "P2-1 patterns Rust rejects but Pion accepts" {
  expect_err("\\Q")
  expect_err("[\\w-a]")
  expect_err("(?x)[ ]")
}

test "P2-2 repetition of an empty / assertion-only expression is rejected" {
  expect_ok("^*")
  expect_ok("\\b{2}")
  expect_ok("(?:$)+")
  expect_ok("(?:)*")
  expect_ok("(?m:^)+")
  expect_ok("(?:\\A){2,}")
}

// ---------------------------------------------------------------- P2: replacement templates

test "P2-3 replacement template '${}' is emitted literally" {
  expect_eq("${} expansion", re("b").replace_all("abc", "${}"), "ac")
  expect_eq("${} expansion with \\b", re("\\b").replace_all("aab", "${}"), "aab")
}
