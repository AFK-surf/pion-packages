///| v0.2.0 regression & invariant tests:
///| 1. Power-of-2 DFA row_stride / stride_shift (num_classes = 3, 5, 129) & cache_gen safety on forced reset_cache
///| 2. Multi-literal Packed-Pair prefilter (strict leftmost-first, unequal offsets, exclusions, O(N) linear time)
///| 3. Shared `replacen` fast path (no-`$`, `$` expansion, empty matches on UTF-8, `a*`, `limit`, no-match passthrough)

fn v020_compile(pat : String) -> Regex {
  match compile(pat) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "compile failed for '" + pat + "': " + e.message)
      panic()
    }
  }
}

fn v020_repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

fn assert_span(o : Option[(Int, Int)], s : Int, e : Int, msg : String) -> Unit {
  match o {
    Some((as_, ae)) =>
    debug_assert(
      as_ == s && ae == e,
      msg + ": got (" + as_.to_string() + "," + ae.to_string() + ")",
    )
    None => debug_assert(false, msg + ": got None")
  }
}

fn assert_none_span(o : Option[(Int, Int)], msg : String) -> Unit {
  match o {
    None => ()
    Some((as_, ae)) =>
    debug_assert(
      false,
      msg + ": expected None, got (" + as_.to_string() + "," + ae.to_string() + ")",
    )
  }
}

test "v020 dfa: power-of-2 row_stride for num_classes 3, 5, 129" {
  // num_classes == 3: byte 'a' (97) -> [0..96], [97], [98..255]
  let r3 = v020_compile("a")
  debug_assert(r3.fwd_dfa.num_classes == 3, "expected 3 classes for 'a'")
  debug_assert(r3.fwd_dfa.row_stride == 4, "expected row_stride 4 for 3 classes")
  debug_assert(r3.fwd_dfa.stride_shift == 2, "expected stride_shift 2")
  assert_span(r3.find_span_at("zzzaa", 0), 3, 4, "r3 find")

  // num_classes == 5: bytes 'a' (97) and 'c' (99) -> [0..96], [97], [98], [99], [100..255]
  let r5 = v020_compile("ac|ca")
  debug_assert(r5.fwd_dfa.num_classes == 5, "expected 5 classes for 'ac|ca'")
  debug_assert(r5.fwd_dfa.row_stride == 8, "expected row_stride 8 for 5 classes")
  debug_assert(r5.fwd_dfa.stride_shift == 3, "expected stride_shift 3")
  assert_span(r5.find_span_at("bbbcab", 0), 3, 5, "r5 find ca")
  assert_span(r5.find_span_at("bbbacb", 0), 3, 5, "r5 find ac")

  // num_classes == 129: 64 non-adjacent ASCII bytes (odd bytes 1,3,...,127 -> bounds 1..128 -> 129 classes)
  let sb = StringBuilder::new()
  let mut b = 1
  let mut first = true
  while b <= 127 {
    if !first {
      sb.write_string("|")
    }
    first = false
    let hi = b / 16
    let lo = b % 16
    let hex_digit = fn(d : Int) -> String {
      if d < 10 {
        d.to_string()
      } else if d == 10 {
        "a"
      } else if d == 11 {
        "b"
      } else if d == 12 {
        "c"
      } else if d == 13 {
        "d"
      } else if d == 14 {
        "e"
      } else {
        "f"
      }
    }
    sb.write_string("\\x" + hex_digit(hi) + hex_digit(lo))
    b = b + 2
  }
  let r129 = v020_compile(sb.to_string())
  debug_assert(
    r129.fwd_dfa.num_classes == 129,
    "expected 129 classes, got " + r129.fwd_dfa.num_classes.to_string(),
  )
  debug_assert(r129.fwd_dfa.row_stride == 256, "expected row_stride 256 for 129 classes")
  debug_assert(r129.fwd_dfa.stride_shift == 8, "expected stride_shift 8")
  // 'A' = 65 (odd, matches), 'B' = 66 (even, does not match)
  assert_span(r129.find_span_at("BBBABBB", 0), 3, 4, "r129 matches odd byte 'A'")
  debug_assert(!r129.is_match("BBBBBBB"), "r129 rejects even byte 'B'")
}

test "v020 dfa: forced cache reset_cache & cache_gen safety" {
  // Small max_states forces frequent cache flushes while using PackedPair & FirstBytes prefilters
  let pat = "[cgt]gggtaaa|tttaccc[acg]"
  let re_full = v020_compile(pat)
  let re_tiny = v020_compile(pat)
  re_tiny.fwd_dfa.max_states = 4
  re_tiny.rev_dfa.max_states = 4

  let hay = v020_repeat("acgtggta", 50) +
  "cgggtaaa" +
  v020_repeat("ttacg", 40) +
  "tttaccct" +
  "tttaccca" +
  v020_repeat("gggtt", 40) +
  "tgggtaaa"

  let s1 : Array[Int] = Array::new()
  let e1 : Array[Int] = Array::new()
  let s2 : Array[Int] = Array::new()
  let e2 : Array[Int] = Array::new()
  re_full.find_spans_into(hay, s1, e1)
  re_tiny.find_spans_into(hay, s2, e2)

  debug_assert(re_tiny.fwd_dfa.cache_resets > 2, "expected multiple forced cache resets")
  debug_assert(s1.length() == s2.length() && s1.length() == 3, "same match count after cache resets")
  let mut i = 0
  while i < s1.length() {
    debug_assert(s1[i] == s2[i] && e1[i] == e2[i], "exact span equality under cache resets")
    i = i + 1
  }
  debug_assert(re_tiny.is_match(hay), "is_match under forced cache resets")

  // Also test RegexSet under forced cache resets
  let set_full = match compile_set(["agggtaaa", "tttaccc[acg]", "a[act]ggtaaa", "^acgt"]) {
    Ok(s) => s
    Err(_) => panic()
  }
  let set_tiny = match compile_set(["agggtaaa", "tttaccc[acg]", "a[act]ggtaaa", "^acgt"]) {
    Ok(s) => s
    Err(_) => panic()
  }
  set_tiny.dfa.max_states = 4
  let m_full = set_full.matches(hay)
  let m_tiny = set_tiny.matches(hay)
  debug_assert(set_tiny.dfa.cache_resets > 2, "RegexSet forced cache resets")
  debug_assert(m_full.length() == m_tiny.length(), "RegexSet match count identical")
  i = 0
  while i < m_full.length() {
    debug_assert(m_full[i] == m_tiny[i], "RegexSet IDs identical under cache resets")
    i = i + 1
  }
}

test "v020 prefilter: PackedPair leftmost-first, unequal offsets & exclusions" {
  // 1. abcd|bc on "abcd" MUST return [0, 4)
  let r1 = v020_compile("abcd|bc")
  match r1.fwd_nfa.prefilter {
    Prefilter::PackedPair(_) => ()
    _ => debug_assert(false, "abcd|bc should use PackedPair")
  }
  assert_span(r1.find_span_at("abcd", 0), 0, 4, "abcd|bc on abcd => [0,4)")
  assert_span(r1.find_span_at("xxabcd", 0), 2, 6, "abcd|bc on xxabcd => [2,6)")

  // 2. Leftmost-first tie breaking: a|ab vs ab|a and ab|abc vs abc|ab
  assert_span(v020_compile("a|ab").find_span_at("ab", 0), 0, 1, "a|ab => [0,1)")
  assert_span(v020_compile("ab|a").find_span_at("ab", 0), 0, 2, "ab|a => [0,2)")
  let r_ab_abc = v020_compile("ab|abc")
  let r_abc_ab = v020_compile("abc|ab")
  assert_span(r_ab_abc.find_span_at("zzabc", 0), 2, 4, "ab|abc => [2,4)")
  assert_span(r_abc_ab.find_span_at("zzabc", 0), 2, 5, "abc|ab => [2,5)")

  // 3. .*foo|bar on "xxbarfoo" MUST start at 0 (cannot use PackedPair because of .*)
  let r_dot = v020_compile(".*foo|bar")
  match r_dot.fwd_nfa.prefilter {
    Prefilter::PackedPair(_) => debug_assert(false, ".*foo|bar must NOT use PackedPair")
    _ => ()
  }
  assert_span(r_dot.find_span_at("xxbarfoo", 0), 0, 8, ".*foo|bar on xxbarfoo => [0,8)")

  // 4. Unequal fixed offsets: branch 0 has off=2 ("ggtaaa"), branch 1 has off=0 ("tggta").
  // In "xxxatggtaaa", branch 1 ("tggta") hits at scan=4 (off=0 -> 4), while branch 0 starts earlier at pos=3!
  // PackedPair MUST compute cand = hit - max_off = 4 - 2 = 2 <= 3 so it NEVER skips pos=3!
  let r_off = v020_compile("a[ct]ggtaaa|tggta[acg]")
  match r_off.fwd_nfa.prefilter {
    Prefilter::PackedPair(_) => ()
    _ => debug_assert(false, "a[ct]ggtaaa|tggta[acg] should use PackedPair")
  }
  assert_span(
    r_off.find_span_at("atggtaaa", 0),
    0,
    8,
    "unequal offset must not skip earlier branch starting at 0",
  )
  assert_span(r_off.find_span_at("xxxatggtaaa", 0), 3, 11, "unequal offset with leading noise")
  assert_span(r_off.find_span_at("xxxatggtaaa", 3), 3, 11, "non-zero start on PackedPair")
  assert_span(r_off.find_span_at("xxxatggtaaa", 4), 4, 10, "non-zero start matches later branch")
  assert_none_span(
    r_off.find_span_at("xxxatggtaaa", 5),
    "non-zero start past all matches returns None",
  )

  // 5. CLBG regex-redux patterns with small class expansion (a[NSt]|BY)
  let r_nst = v020_compile("a[NSt]|BY")
  match r_nst.fwd_nfa.prefilter {
    Prefilter::PackedPair(_) => ()
    _ => debug_assert(false, "a[NSt]|BY should use PackedPair")
  }
  assert_span(r_nst.find_span_at("xxxatyyyBY", 0), 3, 5, "a[NSt]|BY finds at")
  assert_span(r_nst.find_span_at("xxxatyyyBY", 5), 8, 10, "a[NSt]|BY finds BY")

  // 6. Exclusions: empty branch, (?i), Unicode, ^, $, \b
  let r_empty_b = v020_compile("abcd|")
  match r_empty_b.fwd_nfa.prefilter {
    Prefilter::PackedPair(_) => debug_assert(false, "empty branch must not use PackedPair")
    _ => ()
  }
  assert_span(r_empty_b.find_span_at("xyz", 0), 0, 0, "empty branch matches empty")

  let r_ci = v020_compile("(?i)abcd|efgh")
  match r_ci.fwd_nfa.prefilter {
    Prefilter::PackedPair(_) => debug_assert(false, "(?i) must not use PackedPair")
    _ => ()
  }
  assert_span(r_ci.find_span_at("xxAbCd", 0), 2, 6, "(?i) still matches case-insensitively")

  let r_uni = v020_compile("中文|日本")
  match r_uni.fwd_nfa.prefilter {
    Prefilter::PackedPair(_) => debug_assert(false, "Unicode must not use PackedPair")
    _ => ()
  }
  assert_span(r_uni.find_span_at("aa日本bb", 0), 2, 8, "Unicode alt matches")

  let r_line = v020_compile("(?m)^abcd|efgh$")
  match r_line.fwd_nfa.prefilter {
    Prefilter::PackedPair(_) => debug_assert(false, "line anchor must not use PackedPair")
    _ => ()
  }
  assert_span(r_line.find_span_at("xx\nabcd", 0), 3, 7, "multiline ^ still matches")

  let r_wb = v020_compile("\\babcd\\b|\\befgh\\b")
  match r_wb.fwd_nfa.prefilter {
    Prefilter::PackedPair(_) => debug_assert(false, "word boundary must not use PackedPair")
    _ => ()
  }
  assert_span(r_wb.find_span_at("xabcd efgh!", 0), 6, 10, "\\b still matches whole word")
}

test "v020 prefilter: linear-time O(N) guarantee on pathological & DNA inputs" {
  let r_az = v020_compile("a.*Z")
  let a2k = v020_repeat("a", 2000)
  let a4k = v020_repeat("a", 4000)
  debug_assert(!r_az.is_match(a2k), "a.*Z rejects 2000 a's")
  debug_assert(!r_az.is_match(a4k), "a.*Z rejects 4000 a's")
  assert_span(r_az.find_span_at(a4k + "Z", 0), 0, 4001, "a.*Z matches 4000 a's + Z")

  // Repeated near-miss DNA with PackedPair (linear scan, zero quadratic rescans)
  let r_dna = v020_compile("agggtaaa|tttaccct")
  let dna_miss = v020_repeat("agggtaac", 1000)
  debug_assert(!r_dna.is_match(dna_miss), "near-miss DNA rejected in linear time")
  assert_span(
    r_dna.find_span_at(dna_miss + "tttaccct", 0),
    8000,
    8008,
    "near-miss DNA + tail match",
  )
}

test "v020 replacen: fast path, UTF-8 empty matches, a*, limit, and $ expansion" {
  // Empty pattern on UTF-8 "é" (2 bytes: 0xC3 0xA9) must not split codepoint
  let r_empty = v020_compile("")
  debug_assert(r_empty.replace_all("é", "-") == "-é-", "empty replace_all on UTF-8 é")
  debug_assert(r_empty.replacen("é", 1, "-") == "-é", "empty replacen limit=1 on UTF-8 é")
  debug_assert(r_empty.replace_all("é", "$0-") == "-é-", "empty replace_all with $0 on UTF-8 é")

  // "a*" on "a" (abutting empty match suppression)
  let r_astar = v020_compile("a*")
  debug_assert(r_astar.replace_all("a", "X") == "X", "a* on 'a' literal rep")
  debug_assert(r_astar.replace_all("a", "[$0]") == "[a]", "a* on 'a' $0 rep")
  debug_assert(r_astar.replacen("aba", 1, "X") == "Xba", "a* replacen limit=1")

  // Template expansion with $$, $1, ${name}, ${}, trailing $, and literal chunks
  let r_kv = v020_compile("(?P<k>[a-z]+)=(\\d+)")
  debug_assert(
    r_kv.replace_all("x=1, y=22", "prefix-${k}:$$:$2:${}:$") == "prefix-x:$:1::$, prefix-y:$:22::$",
    "expand_into bulk copy with $$, $2, ${k}, ${}, trailing $",
  )
  debug_assert(
    r_kv.replacen("x=1, y=22", 1, "Z") == "Z, y=22",
    "replacen limit=1 fast path",
  )

  // No-match passthrough returns original string unchanged
  debug_assert(r_kv.replace_all("no match here", "Z") == "no match here", "no-match fast path")
  debug_assert(r_kv.replace_all("no match here", "$1") == "no match here", "no-match $ path")
}

test "v020 dfa: max_states = 2 cold cache never overwrites active state st" {
  // Independent cold cache: ab|cd on "zab" with max_states = 2 (row 0 dummy, 1 live state)
  let re1 = v020_compile("ab|cd")
  re1.fwd_dfa.max_states = 2
  re1.rev_dfa.max_states = 2
  debug_assert(re1.fwd_dfa.find_end("zab", 0, 3, false) == 3, "cold max_states=2 find_end == 3")
  assert_span(re1.find_span_at("zab", 0), 1, 3, "cold max_states=2 find_span_at == Some((1, 3))")

  let re2 = v020_compile("ab|cd")
  re2.fwd_dfa.max_states = 2
  debug_assert(re2.fwd_dfa.is_match_tri("zab", 0, 3, false) == 1, "cold max_states=2 is_match_tri == 1")
  debug_assert(re2.is_match("zab"), "cold max_states=2 is_match == true")

  // Same Regex instance: anchored call triggering reset_cache, then unanchored call
  let re3 = v020_compile("ab|cd")
  let re_ref = v020_compile("ab|cd")
  re3.fwd_dfa.max_states = 2
  re3.rev_dfa.max_states = 2
  debug_assert(re3.fwd_dfa.find_end("zzab", 0, 4, true) == -1, "anchored miss at 0")
  debug_assert(re3.fwd_dfa.is_match_tri("ab", 0, 2, true) == 1, "anchored hit on ab")
  assert_span(re3.find_span_at("zzcdab", 0), 2, 4, "unanchored after anchored matches cd")
  let s_ref : Array[Int] = Array::new()
  let e_ref : Array[Int] = Array::new()
  let s_tiny : Array[Int] = Array::new()
  let e_tiny : Array[Int] = Array::new()
  re_ref.find_spans_into("zabcdzzabzcd", s_ref, e_ref)
  re3.find_spans_into("zabcdzzabzcd", s_tiny, e_tiny)
  debug_assert(s_ref.length() == s_tiny.length() && s_ref.length() == 4, "all 4 spans found")
  let mut i = 0
  while i < s_ref.length() {
    debug_assert(s_ref[i] == s_tiny[i] && e_ref[i] == e_tiny[i], "exact spans match ref")
    i = i + 1
  }
}

test "v020 prefilter: PrefixBytes strict O(N) work bound, Int64 budget, and fallback positives" {
  // Int64 budget overflow guard: span_len = 2147483583 (INT32_MAX - 64)
  let huge_span = 2147483583
  let huge_n64 = huge_span.to_int64()
  debug_assert(
    !prefix_budget_exceeded(huge_n64, huge_span),
    "single scan of n should not exceed n + 64",
  )
  debug_assert(
    prefix_budget_exceeded(huge_n64 + (huge_n64 - 1L), huge_span),
    "two scans (n + n - 1) at INT32_MAX-64 must exceed Int64 budget without wrap",
  )

  let re = v020_compile("a.*Z")
  let a4k = v020_repeat("a", 4000)
  let a8k = v020_repeat("a", 8000)

  // N = 4000 miss: is_match_at
  re.fwd_dfa.total_scan_bytes = 0L
  debug_assert(!re.is_match_at(a4k, 0), "a.*Z miss on 4000 a's (is_match_at)")
  let w_is_4k = re.fwd_dfa.total_scan_bytes
  debug_assert(
    w_is_4k < 4L * 4000L + 256L,
    "is_match_at 4k work must be linear, got " + w_is_4k.to_string(),
  )

  // N = 4000 miss: find_span_at
  re.fwd_dfa.total_scan_bytes = 0L
  assert_none_span(re.find_span_at(a4k, 0), "a.*Z miss on 4000 a's (find_span_at)")
  let w_find_4k = re.fwd_dfa.total_scan_bytes
  debug_assert(
    w_find_4k < 4L * 4000L + 256L,
    "find_span_at 4k work must be linear, got " + w_find_4k.to_string(),
  )

  // N = 8000 miss: is_match_at
  re.fwd_dfa.total_scan_bytes = 0L
  debug_assert(!re.is_match_at(a8k, 0), "a.*Z miss on 8000 a's (is_match_at)")
  let w_is_8k = re.fwd_dfa.total_scan_bytes
  debug_assert(
    w_is_8k < 4L * 8000L + 256L,
    "is_match_at 8k work must be linear, got " + w_is_8k.to_string(),
  )

  // N = 8000 miss: find_span_at
  re.fwd_dfa.total_scan_bytes = 0L
  assert_none_span(re.find_span_at(a8k, 0), "a.*Z miss on 8000 a's (find_span_at)")
  let w_find_8k = re.fwd_dfa.total_scan_bytes
  debug_assert(
    w_find_8k < 4L * 8000L + 256L,
    "find_span_at 8k work must be linear, got " + w_find_8k.to_string(),
  )

  // Positive cases with trailing 'Z'
  re.fwd_dfa.total_scan_bytes = 0L
  debug_assert(re.is_match_at(a4k + "Z", 0), "a.*Z hit on 4000 a's + Z")
  debug_assert(re.fwd_dfa.total_scan_bytes < 4L * 4001L + 256L, "4k+Z is_match linear work")

  re.fwd_dfa.total_scan_bytes = 0L
  assert_span(re.find_span_at(a8k + "Z", 0), 0, 8001, "a.*Z hit on 8000 a's + Z")
  debug_assert(re.fwd_dfa.total_scan_bytes < 4L * 8001L + 256L, "8k+Z find_span linear work")

  // Budget-exceeded fallback to unanchored positive case:
  // a[ab]*Z on ("a" * 200 + "!aZ"): anchored scans on leading 'a's exceed budget and switch to unanchored,
  // finding "aZ" at [201, 203).
  let re_abz = v020_compile("a[ab]*Z")
  let hay_abz = v020_repeat("a", 200) + "!aZ"
  debug_assert(re_abz.is_match_at(hay_abz, 0), "a[ab]*Z fallback is_match_at == true")
  assert_span(re_abz.find_span_at(hay_abz, 0), 201, 203, "a[ab]*Z fallback find_span_at == (201, 203)")

  // Unicode -2 bailout to unanchored PikeVM positive case:
  // \bword\b on "éword word": 'é' is 2 bytes in UTF-8, "éword " is 7 bytes, second "word" is [7, 11).
  let re_wb = v020_compile("\\bword\\b")
  debug_assert(re_wb.is_match_at("éword word", 0), "\\bword\\b Unicode bailout is_match_at == true")
  assert_span(
    re_wb.find_span_at("éword word", 0),
    7,
    11,
    "\\bword\\b Unicode bailout find_span_at == (7, 11)",
  )
}
