///| Unicode compliance tests: UTF-8 byte automata, \p{...}/\P{...} categories & scripts,
///| (?u) vs (?-u) shorthand classes (\w, \d, \s, \b), and Unicode case folding.

fn uni_compile(pat : String) -> Regex {
  match compile(pat) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "compile failed for '" + pat + "': " + e.message)
      panic()
    }
  }
}

fn uni_find_text(re : Regex, text : String) -> String {
  match re.find(text) {
    Some(m) => m.text
    None => {
      debug_assert(false, "expected match in '" + text + "'")
      ""
    }
  }
}

test "unicode: multi-byte UTF-8 literals and character ranges" {
  let r_han = uni_compile("[一-龥]+")
  match r_han.find("hello 世界你好 123") {
    Some(m) => debug_assert(m.text == "世界你好", "expected 世界你好, got " + m.text)
    None => debug_assert(false, "expected Han range match")
  }

  let r_greek = uni_compile("[α-ω]+")
  match r_greek.find("123 αβγδ 456") {
    Some(m) => debug_assert(m.text == "αβγδ", "expected αβγδ")
    None => debug_assert(false, "expected Greek range match")
  }

  let r_emoji = uni_compile("[😀-🙏]+")
  match r_emoji.find("hi 😀😁😂 bye") {
    Some(m) => debug_assert(m.text == "😀😁😂", "expected emoji range match")
    None => debug_assert(false, "expected emoji match")
  }

  // Negated class over UTF-8 matches full scalar values
  let r_neg = uni_compile("[^a-z]+")
  match r_neg.find("abc中文def") {
    Some(m) => debug_assert(m.text == "中文" && m.start == 3 && m.end == 9, "negated class UTF-8")
    None => debug_assert(false, "expected negated UTF-8 match")
  }
}

test "unicode: general categories \\p{L}, \\p{Lu}, \\p{Ll}, \\p{Nd}, \\p{P}, \\p{Z}" {
  let r_l = uni_compile("\\p{L}+")
  let ms = r_l.find_iter("123 Hello 世界 αβγ Привет 456")
  debug_assert(ms.length() == 4, "expected 4 letter runs, got " + ms.length().to_string())
  debug_assert(ms[0].text == "Hello", "l0")
  debug_assert(ms[1].text == "世界", "l1")
  debug_assert(ms[2].text == "αβγ", "l2")
  debug_assert(ms[3].text == "Привет", "l3")

  let r_lu = uni_compile("\\p{Lu}+")
  debug_assert(uni_find_text(r_lu, "aÄÖÜb") == "ÄÖÜ", "\\p{Lu} matches Latin uppercase")
  debug_assert(uni_find_text(r_lu, "αΑΒΓδ") == "ΑΒΓ", "\\p{Lu} matches Greek uppercase")

  let r_ll = uni_compile("\\p{Ll}+")
  debug_assert(uni_find_text(r_ll, "AäöüB") == "äöü", "\\p{Ll} matches Latin lowercase")

  // \p{Nd} includes ASCII and Arabic-Indic / Fullwidth digits
  let r_nd = uni_compile("\\p{Nd}+")
  debug_assert(uni_find_text(r_nd, "abc 123 def") == "123", "\\p{Nd} ASCII")
  debug_assert(uni_find_text(r_nd, "num ١٢٣ end") == "١٢٣", "\\p{Nd} Arabic-Indic")
  debug_assert(uni_find_text(r_nd, "num ０１２ end") == "０１２", "\\p{Nd} Fullwidth")

  // Negated \P{Nd}
  let r_nnd = uni_compile("\\P{Nd}+")
  debug_assert(uni_find_text(r_nnd, "123abc456") == "abc", "\\P{Nd}")

  // Scripts
  debug_assert(uni_find_text(uni_compile("\\p{Han}+"), "abc漢字def") == "漢字", "\\p{Han}")
  debug_assert(uni_find_text(uni_compile("\\p{Hiragana}+"), "aあいうb") == "あいう", "\\p{Hiragana}")
  debug_assert(uni_find_text(uni_compile("\\p{Katakana}+"), "aアイウb") == "アイウ", "\\p{Katakana}")
  debug_assert(uni_find_text(uni_compile("\\p{Greek}+"), "aΩωb") == "Ωω", "\\p{Greek}")
  debug_assert(uni_find_text(uni_compile("\\p{Cyrillic}+"), "aЖжb") == "Жж", "\\p{Cyrillic}")
}

test "unicode: (?u) vs (?-u) for \\w, \\d, \\s, and \\b" {
  // Default (?u): \w matches Unicode letters & digits
  let rw_u = uni_compile("\\w+")
  debug_assert(uni_find_text(rw_u, "  café_123!") == "café_123", "(?u)\\w+ matches café_123")
  debug_assert(uni_find_text(rw_u, "  你好世界!") == "你好世界", "(?u)\\w+ matches CJK")

  // (?-u): \w is ASCII-only [0-9A-Za-z_]
  let rw_ascii = uni_compile("(?-u)\\w+")
  debug_assert(uni_find_text(rw_ascii, "  café_123!") == "caf", "(?-u)\\w+ stops at é")
  debug_assert(!rw_ascii.is_match("你好世界"), "(?-u)\\w+ does not match CJK")

  // (?u) \s matches U+00A0 (NBSP) and U+3000 (Ideographic Space)
  let rs_u = uni_compile("\\s+")
  debug_assert(rs_u.is_match("\u{00A0}"), "(?u)\\s matches NBSP")
  debug_assert(rs_u.is_match("\u{3000}"), "(?u)\\s matches ideographic space")
  let rs_ascii = uni_compile("(?-u)\\s+")
  debug_assert(!rs_ascii.is_match("\u{00A0}"), "(?-u)\\s does not match NBSP")

  // (?u) \d vs (?-u) \d
  debug_assert(uni_compile("\\d+").is_match("١٢٣"), "(?u)\\d matches Arabic-Indic digits")
  debug_assert(!uni_compile("(?-u)\\d+").is_match("١٢٣"), "(?-u)\\d is ASCII-only")
}

test "unicode: case folding (?i)" {
  let r_ascii = uni_compile("(?i)abc")
  debug_assert(r_ascii.is_match("AbC"), "ASCII (?i)")

  let r_latin = uni_compile("(?i)café")
  debug_assert(r_latin.is_match("CAFÉ"), "Latin-1 (?i) café vs CAFÉ")

  let r_greek = uni_compile("(?i)αβγ")
  debug_assert(r_greek.is_match("ΑΒΓ"), "Greek (?i)")

  let r_cyr = uni_compile("(?i)привет")
  debug_assert(r_cyr.is_match("ПРИВЕТ"), "Cyrillic (?i)")
}
