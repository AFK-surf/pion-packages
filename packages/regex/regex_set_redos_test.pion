///| RegexSet multi-pattern matching and Day-1 ReDoS linear-time guarantee tests.

fn repeat_str(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

test "regex_set: multi-pattern matching and matches_into" {
  let set = match compile_set([
    "\\w+",
    "\\d+",
    "\\p{L}+",
    "foo",
    "bar",
    "barfoo",
    "foobar",
    "^bar",
    "foo$",
  ]) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "compile_set failed: " + e.message)
      panic()
    }
  }
  debug_assert(set.len() == 9, "set.len() == 9")
  debug_assert(!set.is_empty(), "!set.is_empty()")
  debug_assert(set.is_match("foobar"), "is_match foobar")

  let m1 = set.matches("foobar")
  // Matching indices: 0 (\w+), 2 (\p{L}+), 3 (foo), 4 (bar), 6 (foobar)
  debug_assert(m1.length() == 5, "expected 5 matches for foobar, got " + m1.length().to_string())
  debug_assert(
    m1[0] == 0 && m1[1] == 2 && m1[2] == 3 && m1[3] == 4 && m1[4] == 6,
    "exact sorted indices for foobar",
  )

  let buf : Array[Int] = Array::new()
  set.matches_into("barfoo", buf)
  // Matching indices: 0 (\w+), 2 (\p{L}+), 3 (foo), 4 (bar), 5 (barfoo), 7 (^bar), 8 (foo$)
  debug_assert(buf.length() == 7, "expected 7 matches for barfoo, got " + buf.length().to_string())
  debug_assert(
    buf[0] == 0 &&
    buf[1] == 2 &&
    buf[2] == 3 &&
    buf[3] == 4 &&
    buf[4] == 5 &&
    buf[5] == 7 &&
    buf[6] == 8,
    "exact sorted indices for barfoo",
  )

  // Buffer reuse clears previous hits
  set.matches_into("12345", buf)
  debug_assert(buf.length() == 2 && buf[0] == 0 && buf[1] == 1, "reuse buf for 12345")

  // Empty set
  let empty = match compile_set([]) {
    Ok(s) => s
    Err(_) => panic()
  }
  debug_assert(empty.is_empty() && empty.len() == 0, "empty set")
  debug_assert(!empty.is_match("anything"), "empty set never matches")
  debug_assert(empty.matches("anything").length() == 0, "empty set matches empty")
}

test "redos: classic a?^50 a^50 linear-time guarantee (Cox 2007)" {
  let pat = repeat_str("a?", 50) + repeat_str("a", 50)
  let text = repeat_str("a", 50)
  let re = match compile(pat) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "compile failed: " + e.message)
      panic()
    }
  }
  debug_assert(re.is_match(text), "a?^50 a^50 must match a^50 in linear time")
  debug_assert(!re.is_match(repeat_str("a", 49)), "a?^50 a^50 must not match a^49")
  match re.find(text) {
    Some(m) => debug_assert(m.start == 0 && m.end == 50, "find span 0..50")
    None => debug_assert(false, "expected match")
  }
  match re.captures(text) {
    Some(c) =>
    match c.get(0) {
      Some(m) => debug_assert(m.len() == 50, "captures len 50")
      None => debug_assert(false, "expected group 0")
    }
    None => debug_assert(false, "expected captures")
  }
}

test "redos: catastrophic backtracking patterns complete in linear time" {
  let evil1 = match compile("(a+)+$") {
    Ok(r) => r
    Err(_) => panic()
  }
  let s1 = repeat_str("a", 40) + "b"
  debug_assert(!evil1.is_match(s1), "(a+)+$ must reject a^40 b in linear time")
  debug_assert(evil1.is_match(repeat_str("a", 40)), "(a+)+$ matches a^40")

  let evil2 = match compile("(a|aa)+$") {
    Ok(r) => r
    Err(_) => panic()
  }
  debug_assert(!evil2.is_match(s1), "(a|aa)+$ must reject a^40 b in linear time")

  let evil3 = match compile("^([a-zA-Z]+)*$") {
    Ok(r) => r
    Err(_) => panic()
  }
  let s3 = repeat_str("a", 40) + "!"
  debug_assert(!evil3.is_match(s3), "^([a-zA-Z]+)*$ must reject a^40 ! in linear time")
  match evil3.captures(s3) {
    None => ()
    Some(_) => debug_assert(false, "captures on evil3 must return None")
  }
  let evil3_unanch = match compile("([a-zA-Z]+)*$") {
    Ok(r) => r
    Err(_) => panic()
  }
  match evil3_unanch.find(s3) {
    Some(m) => debug_assert(m.start == 41 && m.end == 41, "unanchored ([a-zA-Z]+)*$ matches empty at end in linear time")
    None => debug_assert(false, "expected empty match at end")
  }

  let evil4 = match compile("(a+){10,20}b") {
    Ok(r) => r
    Err(_) => panic()
  }
  let s4 = repeat_str("a", 100)
  debug_assert(!evil4.is_match(s4), "(a+){10,20}b must reject a^100 in linear time")

  let evil5 = match compile("(.*a){20}") {
    Ok(r) => r
    Err(_) => panic()
  }
  let s5 = repeat_str("b", 100)
  debug_assert(!evil5.is_match(s5), "(.*a){20} must reject b^100 in linear time")
}
