///| Syntax, character classes, quantifiers, flags, groups, escape, and error tests
///| ported from Rust `BurntSushi/regex` (`regex-test` / `regex-syntax`) & Go `regexp` (RE2).

fn must_compile(pat : String) -> Regex {
  match compile(pat) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "compile failed for '" + pat + "': " + e.message)
      panic()
    }
  }
}

fn must_compile_with(pat : String, opts : RegexOptions) -> Regex {
  match compile_with(pat, opts) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "compile_with failed for '" + pat + "': " + e.message)
      panic()
    }
  }
}

fn assert_find(pat : String, text : String, want_start : Int, want_end : Int) -> Unit {
  let re = must_compile(pat)
  match re.find(text) {
    Some(m) => {
      debug_assert(
        m.start == want_start && m.end == want_end,
        "pat='" + pat + "' text='" + text + "' got=(" + m.start.to_string() + "," + m.end.to_string() + ") want=(" + want_start.to_string() + "," + want_end.to_string() + ")",
      )
    }
    None =>
    debug_assert(
      false,
      "pat='" + pat + "' text='" + text + "' expected match (" + want_start.to_string() + "," + want_end.to_string() + "), got None",
    )
  }
}

fn assert_no_match(pat : String, text : String) -> Unit {
  let re = must_compile(pat)
  debug_assert(
    !re.is_match(text),
    "pat='" + pat + "' text='" + text + "' expected no match",
  )
}

fn assert_err_kind(pat : String, want : RegexErrorKind) -> Unit {
  match compile(pat) {
    Ok(_) => debug_assert(false, "expected compile error for '" + pat + "'")
    Err(e) => {
      let ok = match (e.kind, want) {
        (RegexErrorKind::Syntax, RegexErrorKind::Syntax) => true
        (RegexErrorKind::CompiledTooBig, RegexErrorKind::CompiledTooBig) => true
        (RegexErrorKind::NestLimitExceeded, RegexErrorKind::NestLimitExceeded) => true
        (RegexErrorKind::UnsupportedFeature, RegexErrorKind::UnsupportedFeature) => true
        _ => false
      }
      debug_assert(ok, "unexpected error kind for '" + pat + "': " + e.message)
    }
  }
}

test "syntax: literals and basic escapes" {
  assert_find("abc", "xxabcyy", 2, 5)
  assert_no_match("abc", "ab")
  assert_find("", "abc", 0, 0)
  assert_find("", "", 0, 0)
  assert_find("a\\.b", "a.b", 0, 3)
  assert_no_match("a\\.b", "axb")
  assert_find("\\t\\n\\r\\f\\v\\a", "\t\n\r\u{0c}\u{0b}\u{07}", 0, 6)
  assert_find("\\x41\\x7a", "Az", 0, 2)
  assert_find("\\u0041\\u{3b1}", "Aα", 0, 3)
  assert_find("\\U0001F600", "😀", 0, 4)
  assert_find("\\(\\)\\[\\]\\{\\}\\+\\*\\?\\^\\$\\|\\\\", "()[]{}+*?^$|\\", 0, 13)
}

test "syntax: dot and dotall flag (?s)" {
  assert_find("a.b", "axb", 0, 3)
  assert_no_match("a.b", "a\nb")
  assert_find("(?s)a.b", "a\nb", 0, 3)
  assert_find("(?s:a.b)c.d", "a\nbcxd", 0, 6)
  assert_no_match("(?s:a.b)c.d", "a\nbc\nd")
  // Dot matches a full multi-byte UTF-8 scalar value
  assert_find("^.$", "中", 0, 3)
  assert_find("^.$", "😀", 0, 4)
}

test "syntax: character classes and ranges" {
  assert_find("[a-z]+", "123abc456", 3, 6)
  assert_find("[^a-z]+", "abc123def", 3, 6)
  assert_find("[]a]", "]", 0, 1)
  assert_find("[]a]", "a", 0, 1)
  assert_find("[^]a]", "b", 0, 1)
  assert_no_match("[^]a]", "]")
  assert_find("[-a]", "-", 0, 1)
  assert_find("[a-]", "-", 0, 1)
  assert_find("[a-c-e]", "-", 0, 1)
  assert_find("[\\d\\s]+", "a 12\t3 b", 1, 7)
  // POSIX character classes
  assert_find("[[:digit:]]+", "ab123cd", 2, 5)
  assert_find("[[:xdigit:]]+", "zz09afAFgg", 2, 8)
  assert_find("[[:alpha:]]+", "123Hello456", 3, 8)
  assert_find("[[:^digit:]]+", "123abc456", 3, 6)
  assert_find("[[:lower:]]+", "ABCdefGHI", 3, 6)
  assert_find("[[:upper:]]+", "abcDEFghi", 3, 6)
  assert_find("[[:space:]]+", "a \t\n b", 1, 5)
}

test "syntax: quantifiers greedy and lazy" {
  assert_find("a*", "aaa", 0, 3)
  assert_find("a*?", "aaa", 0, 0)
  assert_find("a+", "aaa", 0, 3)
  assert_find("a+?", "aaa", 0, 1)
  assert_find("a?", "aaa", 0, 1)
  assert_find("a??", "aaa", 0, 0)
  assert_find("a{3}", "aaaaa", 0, 3)
  assert_no_match("a{3}", "aa")
  assert_find("a{2,4}", "aaaaa", 0, 4)
  assert_find("a{2,4}?", "aaaaa", 0, 2)
  assert_find("a{2,}", "aaaaa", 0, 5)
  assert_find("a{2,}?", "aaaaa", 0, 2)
  assert_find("a{0}", "bbb", 0, 0)
  assert_find("a{0,0}", "aaa", 0, 0)
  // swap greed (?U)
  assert_find("(?U)a+", "aaa", 0, 1)
  assert_find("(?U)a+?", "aaa", 0, 3)
  assert_find("(?U:a+)b+", "aaabbb", 0, 6)
}

test "syntax: flags (?i) (?m) (?s) (?U) (?x) (?u) and scoped flags" {
  assert_find("(?i)hello", "HeLLo", 0, 5)
  assert_find("(?i:abc)def", "ABCdef", 0, 6)
  assert_no_match("(?i:abc)def", "ABCDEF")
  assert_find("(?i)a(?-i)b", "Ab", 0, 2)
  assert_no_match("(?i)a(?-i)b", "AB")
  // (?x) ignore whitespace and comments
  let pat_x = "(?x)\n  \\d{4} # year\n  -      # sep\n  \\d{2} # month\n"
  assert_find(pat_x, "date 2026-11!", 5, 12)
  // Escaped space and class space inside (?x)
  assert_find("(?x)a\\ b", "a b", 0, 3)
  assert_find("(?x)a[ ]b", "a b", 0, 3)
  // RegexOptions API
  let mut opts = RegexOptions::default()
  opts = RegexOptions::{
    case_insensitive: true,
    multi_line: opts.multi_line,
    dot_matches_new_line: opts.dot_matches_new_line,
    swap_greed: opts.swap_greed,
    ignore_whitespace: opts.ignore_whitespace,
    unicode: opts.unicode,
    nest_limit: opts.nest_limit,
    size_limit: opts.size_limit,
  }
  let re_ci = must_compile_with("foo[a-c]+", opts)
  debug_assert(re_ci.is_match("FOOBAC"), "case_insensitive option should match")
}

test "syntax: groups, non-capturing, named captures" {
  let re = must_compile("(?P<first>[a-z]+)-(?:\\d+)-(?<second>[a-z]+)")
  debug_assert(re.captures_len() == 3, "expected 3 capture slots (0, 1, 2)")
  let names = re.capture_names()
  debug_assert(names.length() == 3, "capture_names length should be 3")
  match names[0] {
    None => ()
    Some(_) => debug_assert(false, "group 0 should be unnamed")
  }
  match names[1] {
    Some(s) => debug_assert(s == "first", "group 1 should be 'first'")
    None => debug_assert(false, "group 1 should have name 'first'")
  }
  match names[2] {
    Some(s) => debug_assert(s == "second", "group 2 should be 'second'")
    None => debug_assert(false, "group 2 should have name 'second'")
  }
  match re.captures("xx foo-123-bar yy") {
    Some(caps) => {
      match caps.name("first") {
        Some(m) => debug_assert(m.text == "foo", "first should be foo")
        None => debug_assert(false, "missing first")
      }
      match caps.name("second") {
        Some(m) => debug_assert(m.text == "bar", "second should be bar")
        None => debug_assert(false, "missing second")
      }
    }
    None => debug_assert(false, "expected captures")
  }
}

test "syntax: escape helper" {
  let raw = "a.b+c*d?e^f$g(h)i[j]k{l}m|n\\o"
  let esc = escape(raw)
  let re = must_compile("^" + esc + "$")
  debug_assert(re.is_match(raw), "escaped literal must match original")
  debug_assert(!re.is_match("axb+c*d?e^f$g(h)i[j]k{l}m|n\\o"), "escaped dot must not match x")
}

test "syntax: invalid patterns, unsupported features, and limits" {
  assert_err_kind("(abc", RegexErrorKind::Syntax)
  assert_err_kind("abc)", RegexErrorKind::Syntax)
  assert_err_kind("[abc", RegexErrorKind::Syntax)
  assert_err_kind("[z-a]", RegexErrorKind::Syntax)
  assert_err_kind("*abc", RegexErrorKind::Syntax)
  assert_err_kind("+abc", RegexErrorKind::Syntax)
  assert_err_kind("?abc", RegexErrorKind::Syntax)
  assert_err_kind("a{5,2}", RegexErrorKind::Syntax)
  assert_err_kind("a\\", RegexErrorKind::Syntax)
  assert_err_kind("(?P<dup>a)(?P<dup>b)", RegexErrorKind::Syntax)
  assert_err_kind("(?P<>a)", RegexErrorKind::Syntax)
  assert_err_kind("(?z)a", RegexErrorKind::Syntax)
  // Unsupported non-regular features (linear-time guarantee)
  assert_err_kind("(a)\\1", RegexErrorKind::UnsupportedFeature)
  assert_err_kind("(?=a)a", RegexErrorKind::UnsupportedFeature)
  assert_err_kind("(?!a)b", RegexErrorKind::UnsupportedFeature)
  assert_err_kind("(?<=a)b", RegexErrorKind::UnsupportedFeature)
  assert_err_kind("(?<!a)b", RegexErrorKind::UnsupportedFeature)
  // Nesting limit
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 60 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("a")
  i = 0
  while i < 60 {
    sb.write_string(")")
    i = i + 1
  }
  let deep = sb.to_string()
  let opts_nest = RegexOptions::{
    case_insensitive: false,
    multi_line: false,
    dot_matches_new_line: false,
    swap_greed: false,
    ignore_whitespace: false,
    unicode: true,
    nest_limit: 20,
    size_limit: 1000000,
  }
  match compile_with(deep, opts_nest) {
    Ok(_) => debug_assert(false, "expected NestLimitExceeded")
    Err(e) =>
    match e.kind {
      RegexErrorKind::NestLimitExceeded => ()
      _ => debug_assert(false, "expected NestLimitExceeded, got: " + e.message)
    }
  }
  // Size limit
  let opts_small = RegexOptions::{
    case_insensitive: false,
    multi_line: false,
    dot_matches_new_line: false,
    swap_greed: false,
    ignore_whitespace: false,
    unicode: true,
    nest_limit: 250,
    size_limit: 50,
  }
  match compile_with("a{200}", opts_small) {
    Ok(_) => debug_assert(false, "expected CompiledTooBig")
    Err(e) =>
    match e.kind {
      RegexErrorKind::CompiledTooBig => ()
      _ => debug_assert(false, "expected CompiledTooBig, got: " + e.message)
    }
  }
}
