///| Semantics compliance tests: anchors, leftmost-first, captures, find_iter,
///| replace/replace_all/replacen, split/splitn, and zero-width match iteration.

fn sem_compile(pat : String) -> Regex {
  match compile(pat) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "compile failed for '" + pat + "': " + e.message)
      panic()
    }
  }
}

fn unwrap_m(o : Option[Match]) -> Match {
  match o {
    Some(m) => m
    None => {
      debug_assert(false, "expected Some(Match), got None")
      panic()
    }
  }
}

test "semantics: anchors ^ $ \\A \\z \\b \\B and multiline (?m)" {
  let r_start = sem_compile("^abc")
  debug_assert(r_start.is_match("abcdef"), "^abc matches start")
  debug_assert(!r_start.is_match("xabc"), "^abc does not match middle")
  debug_assert(!r_start.is_match("\nabc"), "^abc without (?m) does not match after newline")

  let r_end = sem_compile("abc$")
  debug_assert(r_end.is_match("xyzabc"), "abc$ matches end")
  debug_assert(!r_end.is_match("abc\n"), "abc$ without (?m) does not match before newline")

  let r_m = sem_compile("(?m)^abc$")
  debug_assert(r_m.is_match("foo\nabc\nbar"), "(?m)^abc$ matches middle line")
  match r_m.find("foo\nabc\nbar") {
    Some(m) => debug_assert(m.start == 4 && m.end == 7, "(?m)^abc$ span should be 4..7")
    None => debug_assert(false, "expected match")
  }

  let r_az = sem_compile("(?m)\\Aabc\\z")
  debug_assert(r_az.is_match("abc"), "\\Aabc\\z matches whole string")
  debug_assert(!r_az.is_match("foo\nabc\nbar"), "\\A and \\z ignore (?m)")

  // Word boundaries \b and \B
  let r_wb = sem_compile("\\bcat\\b")
  debug_assert(r_wb.is_match("the cat sat"), "\\bcat\\b matches whole word")
  debug_assert(r_wb.is_match("cat"), "\\bcat\\b matches at boundaries")
  debug_assert(!r_wb.is_match("concatenate"), "\\bcat\\b does not match inside word")
  debug_assert(!r_wb.is_match("cats"), "\\bcat\\b does not match prefix")

  let r_nwb = sem_compile("\\Bcat\\B")
  debug_assert(r_nwb.is_match("concatenate"), "\\Bcat\\B matches interior")
  debug_assert(!r_nwb.is_match("cat"), "\\Bcat\\B does not match whole word")
  debug_assert(!r_nwb.is_match("the cat"), "\\Bcat\\B does not match word start")
}

test "semantics: leftmost-first alternation and preference order" {
  // Perl / Rust regex leftmost-first semantics
  let r1 = sem_compile("a|ab")
  match r1.find("ab") {
    Some(m) => debug_assert(m.start == 0 && m.end == 1, "a|ab on ab should match a")
    None => debug_assert(false, "expected match")
  }
  let r2 = sem_compile("ab|a")
  match r2.find("ab") {
    Some(m) => debug_assert(m.start == 0 && m.end == 2, "ab|a on ab should match ab")
    None => debug_assert(false, "expected match")
  }
  let r3 = sem_compile("sam|samwise")
  match r3.find("samwise") {
    Some(m) => debug_assert(m.text == "sam", "sam|samwise should match sam")
    None => debug_assert(false, "expected match")
  }
  let r4 = sem_compile("samwise|sam")
  match r4.find("samwise") {
    Some(m) => debug_assert(m.text == "samwise", "samwise|sam should match samwise")
    None => debug_assert(false, "expected match")
  }
  // Continuation forces second alternative
  let r5 = sem_compile("(a|ab)c")
  match r5.find("abc") {
    Some(m) => debug_assert(m.text == "abc", "(a|ab)c must match abc")
    None => debug_assert(false, "expected match")
  }
  // Leftmost start beats longer later match
  let r6 = sem_compile("bc|abcd")
  match r6.find("xabcd") {
    Some(m) => debug_assert(m.start == 1 && m.end == 5, "earlier start at 1 beats later at 2")
    None => debug_assert(false, "expected match")
  }
}

test "semantics: captures greedy/lazy disambiguation and optional groups" {
  let r1 = sem_compile("(a+?)(a+)")
  match r1.captures("aaa") {
    Some(c) => {
      debug_assert(unwrap_m(c.get(0)).text == "aaa", "g0=aaa")
      debug_assert(unwrap_m(c.get(1)).text == "a", "g1=a")
      debug_assert(unwrap_m(c.get(2)).text == "aa", "g2=aa")
    }
    None => debug_assert(false, "expected match")
  }

  let r2 = sem_compile("(a+)(a+?)")
  match r2.captures("aaa") {
    Some(c) => {
      debug_assert(unwrap_m(c.get(1)).text == "aa", "g1=aa")
      debug_assert(unwrap_m(c.get(2)).text == "a", "g2=a")
    }
    None => debug_assert(false, "expected match")
  }

  // Unmatched optional group returns None
  let r3 = sem_compile("(a)|(b)")
  match r3.captures("b") {
    Some(c) => {
      debug_assert(unwrap_m(c.get(0)).text == "b", "g0=b")
      match c.get(1) {
        None => ()
        Some(_) => debug_assert(false, "g1 should be None")
      }
      debug_assert(unwrap_m(c.get(2)).text == "b", "g2=b")
    }
    None => debug_assert(false, "expected match")
  }

  // Repeated capture keeps last iteration
  let r4 = sem_compile("(a|b)+")
  match r4.captures("abba") {
    Some(c) => {
      debug_assert(unwrap_m(c.get(0)).text == "abba", "g0=abba")
      let g1 = unwrap_m(c.get(1))
      debug_assert(g1.start == 3 && g1.end == 4, "g1=last a")
    }
    None => debug_assert(false, "expected match")
  }
}

test "semantics: find_iter, captures_iter, and empty match advancement" {
  let r_num = sem_compile("\\d+")
  let ms = r_num.find_iter("a12b345c6")
  debug_assert(ms.length() == 3, "expected 3 matches")
  debug_assert(ms[0].text == "12" && ms[0].start == 1 && ms[0].end == 3, "m0")
  debug_assert(ms[1].text == "345" && ms[1].start == 4 && ms[1].end == 7, "m1")
  debug_assert(ms[2].text == "6" && ms[2].start == 8 && ms[2].end == 9, "m2")

  // Empty pattern on ASCII and UTF-8
  let r_empty = sem_compile("")
  let me = r_empty.find_iter("a中")
  // Byte positions: 0, 1, 4 (must step by UTF-8 char, never split multi-byte char!)
  debug_assert(me.length() == 3, "empty regex on 'a中' should yield 3 matches")
  debug_assert(me[0].start == 0 && me[0].end == 0, "e0")
  debug_assert(me[1].start == 1 && me[1].end == 1, "e1")
  debug_assert(me[2].start == 4 && me[2].end == 4, "e2")

  // Zero-or-more empty match after non-empty match (Rust/Go P1-1 rule: skip abutting empty match)
  let r_astar = sem_compile("a*")
  let ma = r_astar.find_iter("ab")
  debug_assert(ma.length() == 2, "a* on 'ab' should yield 2 matches: [0..1], [2..2]")
  debug_assert(ma[0].start == 0 && ma[0].end == 1, "ma0")
  debug_assert(ma[1].start == 2 && ma[1].end == 2, "ma1")

  // captures_iter
  let r_kv = sem_compile("(?P<k>[a-z]+)=(?P<v>\\d+)")
  let cs = r_kv.captures_iter("x=10, y=20, z=30")
  debug_assert(cs.length() == 3, "expected 3 kv captures")
  debug_assert(
    unwrap_m(cs[0].name("k")).text == "x" && unwrap_m(cs[0].name("v")).text == "10",
    "kv0",
  )
  debug_assert(
    unwrap_m(cs[1].name("k")).text == "y" && unwrap_m(cs[1].name("v")).text == "20",
    "kv1",
  )
  debug_assert(
    unwrap_m(cs[2].name("k")).text == "z" && unwrap_m(cs[2].name("v")).text == "30",
    "kv2",
  )
}

test "semantics: replace, replace_all, replacen, and $ expansion" {
  let r_date = sem_compile("(?P<y>\\d{4})-(?P<m>\\d{2})-(?P<d>\\d{2})")
  debug_assert(
    r_date.replace("2026-11-23 and 2025-01-02", "$d/$m/$y") == "23/11/2026 and 2025-01-02",
    "replace should only replace first",
  )
  debug_assert(
    r_date.replace_all("2026-11-23 and 2025-01-02", "$d/$m/$y") == "23/11/2026 and 02/01/2025",
    "replace_all should replace all",
  )
  debug_assert(
    r_date.replace_all("2026-11-23", "[$0] ${1}x $$1") == "[2026-11-23] 2026x $1",
    "expand $0, ${1}, and $$",
  )
  let r_word = sem_compile("\\w+")
  debug_assert(
    r_word.replacen("one two three four", 2, "X") == "X X three four",
    "replacen with limit 2",
  )
  // No match returns original unchanged
  debug_assert(r_date.replace_all("no dates", "X") == "no dates", "no match unchanged")
}

test "semantics: split and splitn" {
  let r_comma = sem_compile(",\\s*")
  let parts = r_comma.split("a, b,c,  d")
  debug_assert(parts.length() == 4, "split length 4")
  debug_assert(
    parts[0] == "a" && parts[1] == "b" && parts[2] == "c" && parts[3] == "d",
    "split contents",
  )

  let trailing = sem_compile(",").split("a,b,")
  debug_assert(trailing.length() == 3 && trailing[2] == "", "trailing delimiter produces empty part")

  let limited = sem_compile(",").splitn("a,b,c,d", 2)
  debug_assert(limited.length() == 2 && limited[0] == "a" && limited[1] == "b,c,d", "splitn 2")

  let one = sem_compile(",").splitn("a,b,c", 1)
  debug_assert(one.length() == 1 && one[0] == "a,b,c", "splitn 1")

  let empty_split = sem_compile("").split("ab")
  debug_assert(
    empty_split.length() == 4 &&
    empty_split[0] == "" &&
    empty_split[1] == "a" &&
    empty_split[2] == "b" &&
    empty_split[3] == "",
    "empty regex split",
  )
}

test "semantics: redteam regressions (P0-2, P1-1, P1-2, P1-3, P2-3)" {
  // P0-2: Unicode \b/\B never split multi-byte UTF-8 codepoints
  debug_assert(sem_compile("\\B").replace_all("k🚀1x", "[]") == "k🚀1[]x", "P0-2 \\B replace_all")
  let wb_zh = sem_compile("\\b").find_iter("中文")
  debug_assert(
    wb_zh.length() == 2 && wb_zh[0].start == 0 && wb_zh[1].start == 6,
    "P0-2 \\b on 中文",
  )

  // P1-1: abutting empty match skipped in replace_all / split / captures_iter
  let r_a = sem_compile("a*")
  debug_assert(r_a.replace_all("baaac", "-") == "-b-c-", "P1-1 replace_all")
  let sp = r_a.split("baaac")
  debug_assert(
    sp.length() == 4 && sp[0] == "" && sp[1] == "b" && sp[2] == "c" && sp[3] == "",
    "P1-1 split",
  )
  debug_assert(r_a.captures_iter("baaac").length() == 3, "P1-1 captures_iter")

  // P1-2: (?m)$ matches right before \n
  debug_assert(sem_compile("(?m)$").replace_all("ab\ncd", ";") == "ab;\ncd;", "P1-2 (?m)$")

  // P1-3: nullable loop leftmost-first & empty final iteration capture
  let m1 = unwrap_m(sem_compile("(|a)*").find("aa"))
  debug_assert(m1.start == 0 && m1.end == 0, "P1-3 (|a)* on aa")
  let m2 = unwrap_m(sem_compile("(?:\\b|a)+").find("a"))
  debug_assert(m2.start == 0 && m2.end == 0, "P1-3 (?:\\b|a)+ on a")
  match sem_compile("(a*)*").captures("") {
    Some(c) => {
      let g1 = unwrap_m(c.get(1))
      debug_assert(g1.start == 0 && g1.end == 0, "P1-3 (a*)* group 1")
    }
    None => debug_assert(false, "P1-3 (a*)* must match")
  }

  // P2-3: ${} expands to empty string
  debug_assert(sem_compile("b").replace_all("abc", "${}") == "ac", "P2-3 ${} expansion")
}

test "reverse_look_kind involution and word boundary preservation (migrated C1)" {
  let kinds = [
    LookKind::StartLine,
    LookKind::EndLine,
    LookKind::StartText,
    LookKind::EndText,
    LookKind::WordBoundaryAscii,
    LookKind::NotWordBoundaryAscii,
    LookKind::WordBoundaryUnicode,
    LookKind::NotWordBoundaryUnicode,
  ]
  let mut i = 0
  while i < kinds.length() {
    let k = kinds[i]
    let r = reverse_look_kind(k)
    let rr = reverse_look_kind(r)
    debug_assert(
      look_is_word_boundary(k) == look_is_word_boundary(r),
      "reverse_look_kind preserves word boundary",
    )
    debug_assert(
      look_is_word_boundary(k) == look_is_word_boundary(rr),
      "reverse_look_kind involutive check",
    )
    i = i + 1
  }
}
