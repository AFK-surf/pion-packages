///| Head-to-head benchmark binary for `packages/regex` (Pion Native).
///| Modes: find_iter | captures_iter | regex_set | redos

import "regex"

fn parse_pos_int(s : String, fallback : Int) -> Int {
  if s.length() == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  if acc <= 0 { fallback } else { acc }
}

fn repeat_str(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

fn run_find_iter(world : World, data : String, iters : Int) -> Int {
  let pat = "(?:ERROR|WARN) \\[[a-z0-9_-]+\\] req_id=[0-9a-f]{8,16}|https?://[A-Za-z0-9._/-]+"
  let re = match regex::compile(pat) {
    Ok(r) => r
    Err(e) => {
      io_println(world, "compile error: " + e.message)
      return 1
    }
  }
  let starts : Array[Int] = Array::new()
  let ends : Array[Int] = Array::new()
  let mut total_matches : Int64 = 0L
  let mut checksum : Int64 = 0L
  let mut it = 0
  while it < iters {
    re.find_spans_into(data, starts, ends)
    let nm = starts.length()
    total_matches = total_matches + nm.to_int64()
    let mut i = 0
    while i < nm {
      checksum = (checksum * 131L + starts[i].to_int64() + ends[i].to_int64() * 7L) % 1000000007L
      i = i + 1
    }
    it = it + 1
  }
  io_println(world, "mode=find_iter")
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "matches=" + total_matches.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

fn run_captures_iter(world : World, data : String, iters : Int) -> Int {
  let pat = "([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z) (INFO|WARN|ERROR) \\[([a-z0-9_-]+)\\] req_id=([0-9a-f]+) path=[^ ]+ status=([0-9]{3}) latency=([0-9]+)ms"
  let re = match regex::compile(pat) {
    Ok(r) => r
    Err(e) => {
      io_println(world, "compile error: " + e.message)
      return 1
    }
  }
  let slots : Array[Int] = Array::new()
  let mut total_matches : Int64 = 0L
  let mut checksum : Int64 = 0L
  let n = data.length()
  let mut it = 0
  while it < iters {
    let mut pos = 0
    while pos <= n {
      if !re.captures_slots_at(data, pos, slots) {
        break
      }
      total_matches = total_matches + 1L
      let mut g = 1
      while g <= 6 {
        let s = slots[g * 2]
        let e = slots[g * 2 + 1]
        checksum = (checksum * 131L + (e - s).to_int64() + s.to_int64()) % 1000000007L
        g = g + 1
      }
      let m_start = slots[0]
      let m_end = slots[1]
      if m_start == m_end {
        if m_end >= n {
          break
        }
        pos = m_end + 1
      } else {
        pos = m_end
      }
    }
    it = it + 1
  }
  io_println(world, "mode=captures_iter")
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "matches=" + total_matches.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

fn run_regex_set(world : World, data : String, iters : Int) -> Int {
  let rules = [
    "ERROR",
    "FATAL",
    "status=50[0-9]",
    "status=429",
    "latency=[5-9][0-9]{2}ms",
    "latency=[0-9]{4,}ms",
    "timeout",
    "connection refused",
    "SELECT .* FROM",
    "\\.\\./\\.\\./",
    "OOMKilled",
    "panic:",
    "tls: handshake",
    "rate_limit",
    "^2026-11-23T00:",
    "\\[auth-api\\]",
  ]
  let set = match regex::compile_set(rules) {
    Ok(s) => s
    Err(e) => {
      io_println(world, "compile_set error: " + e.message)
      return 1
    }
  }
  let raw_lines = data.split("\n")
  let lines : Array[String] = Array::new()
  let mut i = 0
  while i < raw_lines.length() {
    if raw_lines[i].length() > 0 {
      lines.push(raw_lines[i])
    }
    i = i + 1
  }
  let buf : Array[Int] = Array::new()
  let mut matched_lines : Int64 = 0L
  let mut total_hits : Int64 = 0L
  let mut checksum : Int64 = 0L
  let nl = lines.length()
  let mut it = 0
  while it < iters {
    let mut li = 0
    while li < nl {
      set.matches_into(lines[li], buf)
      let nh = buf.length()
      if nh > 0 {
        matched_lines = matched_lines + 1L
        total_hits = total_hits + nh.to_int64()
        let mut h = 0
        while h < nh {
          checksum = (checksum * 131L + (buf[h] + 1).to_int64()) % 1000000007L
          h = h + 1
        }
      }
      li = li + 1
    }
    it = it + 1
  }
  io_println(world, "mode=regex_set")
  io_println(world, "rules=" + rules.length().to_string())
  io_println(world, "lines=" + nl.to_string())
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "matched_lines=" + matched_lines.to_string())
  io_println(world, "total_hits=" + total_hits.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

fn run_redos(world : World, iters : Int) -> Int {
  let re1 = match regex::compile(repeat_str("a?", 40) + repeat_str("a", 40)) {
    Ok(r) => r
    Err(_) => return 1
  }
  let re2 = match regex::compile("(a+)+$") {
    Ok(r) => r
    Err(_) => return 1
  }
  let re3 = match regex::compile("(a|aa)+$") {
    Ok(r) => r
    Err(_) => return 1
  }
  let re4 = match regex::compile("^([a-zA-Z]+)*$") {
    Ok(r) => r
    Err(_) => return 1
  }
  let s_a40 = repeat_str("a", 40)
  let s_a39 = repeat_str("a", 39)
  let s_evil_b = repeat_str("a", 4000) + "b"
  let s_evil_bang = repeat_str("a", 4000) + "!"

  let mut hits : Int64 = 0L
  let mut it = 0
  while it < iters {
    if re1.is_match(s_a40) {
      hits = hits + 1L
    }
    if re1.is_match(s_a39) {
      hits = hits + 10L
    }
    if re2.is_match(s_evil_b) {
      hits = hits + 100L
    }
    if re3.is_match(s_evil_b) {
      hits = hits + 1000L
    }
    if re4.is_match(s_evil_bang) {
      hits = hits + 10000L
    }
    it = it + 1
  }
  io_println(world, "mode=redos")
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "hits=" + hits.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_regex <mode> <data_file> [iters]")
    return 1
  }
  let mode = args[1]
  let data_file = args[2]
  let iters = if args.length() > 3 { parse_pos_int(args[3], 5) } else { 5 }
  if mode == "redos" {
    return run_redos(world, iters)
  }
  let data = match fs_read(world, data_file) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read " + data_file)
      return 1
    }
  }
  if mode == "find_iter" {
    run_find_iter(world, data, iters)
  } else if mode == "captures_iter" {
    run_captures_iter(world, data, iters)
  } else if mode == "regex_set" {
    run_regex_set(world, data, iters)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
