///| Ported State Diagram parser & layout test suite (from mermaid-js/mermaid state specs).

///|
fn must_parse_state(src : String) -> StateDiagram {
  match parse(src) {
    Ok(Diagram::State(st)) => st
    Ok(_) => {
      debug_assert(false, "expected State diagram")
      StateDiagram::{
        version: 2,
        direction: Direction::TB,
        states: [],
        transitions: [],
        notes: [],
      }
    }
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      StateDiagram::{
        version: 2,
        direction: Direction::TB,
        states: [],
        transitions: [],
        notes: [],
      }
    }
  }
}

///|
fn find_state(st : StateDiagram, id : String) -> Option[StateNode] {
  for s in st.states {
    if s.id == id {
      return Some(s)
    }
  }
  None
}

///|
test "state: v1 header" {
  let st = must_parse_state("stateDiagram\n  [*] --> Still")
  debug_assert(st.version == 1, "version 1")
  debug_assert(st.transitions.length() == 1, "1 transition")
}

///|
test "state: v2 header with start and end [*]" {
  let src =
  #|stateDiagram-v2
  #| [*] --> Idle
  #| Idle --> Running : start
  #| Running --> [*]
  let st = must_parse_state(src)
  debug_assert(st.version == 2, "version 2")
  debug_assert(st.transitions.length() == 3, "3 transitions")
  debug_assert(st.transitions[1].label == "start", "label start")
}

///|
test "state: distinct start and end nodes for [*]" {
  let src =
  #|stateDiagram-v2
  #| [*] --> Active
  #| Active --> [*]
  let st = must_parse_state(src)
  let mut has_start = false
  let mut has_end = false
  for s in st.states {
    if s.kind == StateKind::Start {
      has_start = true
    }
    if s.kind == StateKind::End {
      has_end = true
    }
  }
  debug_assert(has_start && has_end, "both start and end nodes")
}

///|
test "state: state description with colon syntax" {
  let src =
  #|stateDiagram-v2
  #| s1 : This is a state description
  #| s2:No spaces around colon
  let st = must_parse_state(src)
  match find_state(st, "s1") {
    Some(s) => debug_assert(s.descriptions.length() == 1 && s.descriptions[0] == "This is a state description", "s1 desc")
    None => debug_assert(false, "missing s1")
  }
  match find_state(st, "s2") {
    Some(s) => debug_assert(s.descriptions.length() == 1 && s.descriptions[0] == "No spaces around colon", "s2 desc")
    None => debug_assert(false, "missing s2")
  }
}

///|
test "state: state \"Description\" as id syntax" {
  let src =
  #|stateDiagram-v2
  #| state "Small State 1" as namedState1
  let st = must_parse_state(src)
  match find_state(st, "namedState1") {
    Some(s) => debug_assert(s.label == "Small State 1", "label")
    None => debug_assert(false, "missing namedState1")
  }
}

///|
test "state: state name containing 'as' substring" {
  let src =
  #|stateDiagram-v2
  #| assemble
  #| assemblies
  #| state assemble
  #| state "as" as as
  let st = must_parse_state(src)
  debug_assert(find_state(st, "assemble").is_some(), "assemble")
  debug_assert(find_state(st, "assemblies").is_some(), "assemblies")
  debug_assert(find_state(st, "as").is_some(), "as")
}

///|
test "state: composite state block" {
  let src =
  #|stateDiagram-v2
  #| state Active {
    #| [*] --> Running
    #| Running --> Paused
    #| }
  let st = must_parse_state(src)
  match find_state(st, "Active") {
    Some(s) => debug_assert(s.kind == StateKind::Composite, "composite")
    None => debug_assert(false, "missing Active")
  }
  match find_state(st, "Running") {
    Some(s) => debug_assert(s.parent.unwrap_or("") == "Active", "Running parent Active")
    None => debug_assert(false, "missing Running")
  }
}

///|
test "state: composite state with quoted alias" {
  let src =
  #|stateDiagram-v2
  #| state "Big State 1" as bigState1 {
    #| inner1 --> inner2
    #| }
  #| outer --> bigState1
  let st = must_parse_state(src)
  match find_state(st, "bigState1") {
    Some(s) => debug_assert(s.kind == StateKind::Composite && s.label == "Big State 1", "bigState1")
    None => debug_assert(false, "missing bigState1")
  }
  match find_state(st, "inner1") {
    Some(s) => debug_assert(s.parent.unwrap_or("") == "bigState1", "inner1 parent")
    None => debug_assert(false, "missing inner1")
  }
}

///|
test "state: nested composite states" {
  let src =
  #|stateDiagram-v2
  #| state Outer {
    #| state Inner {
      #| Leaf1 --> Leaf2
      #| }
    #| }
  let st = must_parse_state(src)
  match find_state(st, "Inner") {
    Some(s) => debug_assert(s.parent.unwrap_or("") == "Outer" && s.kind == StateKind::Composite, "Inner")
    None => debug_assert(false, "missing Inner")
  }
  match find_state(st, "Leaf1") {
    Some(s) => debug_assert(s.parent.unwrap_or("") == "Inner", "Leaf1 parent Inner")
    None => debug_assert(false, "missing Leaf1")
  }
}

///|
test "state: choice stereotype <<choice>>" {
  let src =
  #|stateDiagram-v2
  #| state if_state <<choice>>
    #| [*] --> if_state
    #| if_state --> TrueState : yes
    #| if_state --> FalseState : no
    let st = must_parse_state(src)
    match find_state(st, "if_state") {
      Some(s) => debug_assert(s.kind == StateKind::Choice, "choice")
      None => debug_assert(false, "missing if_state")
    }
  }

  ///|
  test "state: fork and join stereotypes <<fork>> <<join>>" {
    let src =
    #|stateDiagram-v2
    #| state fork_state <<fork>>
      #| state join_state <<join>>
        #| [*] --> fork_state
        #| fork_state --> S2
        #| fork_state --> S3
        #| S2 --> join_state
        #| S3 --> join_state
        let st = must_parse_state(src)
        match find_state(st, "fork_state") {
          Some(s) => debug_assert(s.kind == StateKind::Fork, "fork")
          None => debug_assert(false, "missing fork_state")
        }
        match find_state(st, "join_state") {
          Some(s) => debug_assert(s.kind == StateKind::Join, "join")
          None => debug_assert(false, "missing join_state")
        }
      }

      ///|
      test "state: inline note right of and left of" {
        let src =
        #|stateDiagram-v2
        #| S1 --> S2
        #| note right of S1 : Important info
        #| note left of S2 : Side remark
        let st = must_parse_state(src)
        debug_assert(st.notes.length() == 2, "2 notes")
        debug_assert(st.notes[0].target == "S1" && st.notes[0].position == "right", "note 0")
        debug_assert(st.notes[1].target == "S2" && st.notes[1].position == "left", "note 1")
      }

      ///|
      test "state: multiline note block" {
        let src =
        #|stateDiagram-v2
        #| S1 --> S2
        #| note right of S1
        #| Line one
        #| Line two
        #| end note
        let st = must_parse_state(src)
        debug_assert(st.notes.length() == 1, "1 note")
        debug_assert(st.notes[0].text.contains("Line one") && st.notes[0].text.contains("Line two"), "multiline note")
      }

      ///|
      test "state: direction LR" {
        let src =
        #|stateDiagram-v2
        #| direction LR
        #| A --> B
        let st = must_parse_state(src)
        debug_assert(st.direction == Direction::LR, "LR")
      }

      ///|
      test "state: comments ignored" {
        let src =
        #|stateDiagram-v2
        #| %% state comment
        #| A --> B : go
        let st = must_parse_state(src)
        debug_assert(st.transitions.length() == 1, "1 transition")
      }

      ///|
      test "state: self-transition" {
        let src =
        #|stateDiagram-v2
        #| Retry --> Retry : backoff
        let st = must_parse_state(src)
        debug_assert(st.transitions.length() == 1, "1 transition")
        debug_assert(st.transitions[0].from == "Retry" && st.transitions[0].to == "Retry", "self")
      }

      ///|
      test "state: invalid multi-word state name before brace rejected" {
        let src =
        #|stateDiagram-v2
        #| state invalid syntax { Y }
        match parse(src) {
          Ok(_) => debug_assert(false, "should fail multi-word state name")
          Err(e) => debug_assert(e.line == 2, "error line 2")
        }
      }

      ///|
      test "state: invalid unclosed composite state rejected" {
        let src =
        #|stateDiagram-v2
        #| state Open {
          #| A --> B
          match parse(src) {
            Ok(_) => debug_assert(false, "should fail unclosed brace")
            Err(e) => debug_assert(e.line >= 1, "error line")
          }
        }

        ///|
        test "state layout: produces valid scene with groups for composite states" {
          let src =
          #|stateDiagram-v2
          #| [*] --> Active
          #| state Active {
            #| Running --> Paused
            #| }
          #| Active --> [*]
          let scene = layout(Diagram::State(must_parse_state(src)))
          debug_assert(scene.width > 0.0 && scene.height > 0.0, "positive dims")
          debug_assert(scene.groups.length() >= 1, "composite group")
          debug_assert(scene.edges.length() >= 2, "edges laid out")
        }

        ///|
        test "state layout: LR direction orders nodes left to right" {
          let src =
          #|stateDiagram-v2
          #| direction LR
          #| S1 --> S2
          #| S2 --> S3
          let scene = layout(Diagram::State(must_parse_state(src)))
          let mut x1 = 0.0
          let mut x2 = 0.0
          let mut x3 = 0.0
          for n in scene.nodes {
            if n.id == "S1" {
              x1 = n.x
            } else if n.id == "S2" {
              x2 = n.x
            } else if n.id == "S3" {
              x3 = n.x
            }
          }
          debug_assert(x1 < x2 && x2 < x3, "S1 < S2 < S3 in LR")
        }
