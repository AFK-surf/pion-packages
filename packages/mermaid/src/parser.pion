///| Top-level Mermaid parser dispatcher.

///|
pub fn parse(src : String) -> Result[Diagram, ParseError] {
  let lines = split_source_lines(src)
  let mut idx = 0
  // Skip leading blank lines, comments, and optional YAML frontmatter (`--- ... ---`)
  while idx < lines.length() {
    let trimmed = lines[idx].text.trim()
    if trimmed.length() == 0 {
      idx = idx + 1
      continue
    }
    if trimmed == "---" {
      idx = idx + 1
      let mut closed = false
      while idx < lines.length() {
        if lines[idx].text.trim() == "---" {
          closed = true
          idx = idx + 1
          break
        }
        idx = idx + 1
      }
      if !closed {
        return Err(ParseError::{ line: 1, col: 1, message: "unclosed YAML frontmatter" })
      }
      continue
    }
    let cleaned = strip_line_comment(lines[idx].text).trim()
    if cleaned.length() == 0 {
      idx = idx + 1
      continue
    }
    break
  }
  while idx < lines.length() {
    let cleaned = strip_line_comment(lines[idx].text).trim()
    if cleaned.length() == 0 {
      idx = idx + 1
      continue
    }
    let first_semi = find_char_outside_quotes(cleaned, 59, 0)
    let header_part = if first_semi >= 0 {
      cleaned.slice(0, first_semi).trim()
    } else {
      cleaned
    }
    let words = split_words(header_part)
    if words.length() == 0 {
      idx = idx + 1
      continue
    }
    let kw = words[0]
    if kw == "flowchart" || kw == "graph" || kw == "flowchart-elk" {
      let dir = if words.length() >= 2 {
        match parse_direction_opt(words[1]) {
          Some(d) => d
          None => {
            return Err(ParseError::{
              line: lines[idx].line_no,
              col: 1,
              message: "invalid flowchart direction: " + words[1],
            })
          }
        }
      } else {
        Direction::TB
      }
      let rest_on_line = if first_semi >= 0 {
        cleaned.slice(first_semi + 1, cleaned.length()).trim()
      } else {
        ""
      }
      return match parse_flowchart(lines, idx + 1, lines[idx].line_no, rest_on_line, dir) {
        Ok(fc) => Ok(Diagram::Flowchart(fc))
        Err(e) => Err(e)
      }
    }
    if kw == "sequenceDiagram" {
      return match parse_sequence(lines, idx + 1) {
        Ok(sd) => Ok(Diagram::Sequence(sd))
        Err(e) => Err(e)
      }
    }
    if kw == "stateDiagram-v2" || kw == "stateDiagram" {
      let ver = if kw == "stateDiagram-v2" { 2 } else { 1 }
      return match parse_state(lines, idx + 1, ver) {
        Ok(st) => Ok(Diagram::State(st))
        Err(e) => Err(e)
      }
    }
    if kw == "classDiagram" || kw == "classDiagram-v2" {
      return match parse_class(lines, idx + 1) {
        Ok(cd) => Ok(Diagram::Class(cd))
        Err(e) => Err(e)
      }
    }
    if kw == "erDiagram" {
      return match parse_er(lines, idx + 1) {
        Ok(ed) => Ok(Diagram::Er(ed))
        Err(e) => Err(e)
      }
    }
    return Err(ParseError::{
      line: lines[idx].line_no,
      col: 1,
      message: "unsupported or unknown diagram type: " + kw,
    })
  }
  Err(ParseError::{ line: 1, col: 1, message: "empty diagram" })
}
