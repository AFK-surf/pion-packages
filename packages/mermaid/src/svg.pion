///| Clean deterministic SVG renderer for unified Scene IR.

///|
fn parse_inline_style(raw : String) -> (String, String, String, String) {
  // Returns (fill, stroke, stroke_width, color) — empty string means default
  let mut fill = ""
  let mut stroke = ""
  let mut sw = ""
  let mut color = ""
  for part in raw.split(",") {
    let t = part.trim()
    let colon = t.index_of(":")
    if colon > 0 {
      let k = t.slice(0, colon).trim()
      let v = t.slice(colon + 1, t.length()).trim()
      if k == "fill" && v.length() > 0 {
        fill = v
      } else if k == "stroke" && v.length() > 0 {
        stroke = v
      } else if k == "stroke-width" && v.length() > 0 {
        sw = v
      } else if k == "color" && v.length() > 0 {
        color = v
      }
    }
  }
  (fill, stroke, sw, color)
}

///|
fn write_multiline_text(
  sb : StringBuilder,
  cx : Double,
  cy : Double,
  label : String,
  font_size : String,
  text_fill : String,
  cls : String,
) -> Unit {
  let lines = split_label_lines(label)
  let n = lines.length()
  sb.write_string("<text")
  if cls.length() > 0 {
    sb.write_string(" class=\"")
    sb.write_string(cls)
    sb.write_string("\"")
  }
  sb.write_string(" x=\"")
  sb.write_string(fmt_coord(cx))
  sb.write_string("\" y=\"")
  if n <= 1 {
    sb.write_string(fmt_coord(cy + 4.0))
    sb.write_string("\" text-anchor=\"middle\" font-size=\"")
    sb.write_string(font_size)
    sb.write_string("\" font-family=\"sans-serif\" fill=\"")
    sb.write_string(xml_escape(text_fill))
    sb.write_string("\">")
    sb.write_string(xml_escape(lines[0]))
    sb.write_string("</text>")
  } else {
    let line_h = 16.0
    let start_y = cy - ((n - 1).to_double() * line_h) / 2.0 + 4.0
    sb.write_string(fmt_coord(start_y))
    sb.write_string("\" text-anchor=\"middle\" font-size=\"")
    sb.write_string(font_size)
    sb.write_string("\" font-family=\"sans-serif\" fill=\"")
    sb.write_string(xml_escape(text_fill))
    sb.write_string("\">")
    for idx = 0; idx < n; idx = idx + 1 {
      sb.write_string("<tspan x=\"")
      sb.write_string(fmt_coord(cx))
      sb.write_string("\" dy=\"")
      sb.write_string(if idx == 0 { "0" } else { fmt_coord(line_h) })
      sb.write_string("\">")
      sb.write_string(xml_escape(lines[idx]))
      sb.write_string("</tspan>")
    }
    sb.write_string("</text>")
  }
}

///|
fn arrow_marker_attr(head : String) -> String {
  if head == "arrow" || head == "async" {
    "url(#arrow)"
  } else if head == "open" {
    "url(#open-arrow)"
  } else if head == "circle" {
    "url(#circle-head)"
  } else if head == "cross" {
    "url(#cross-head)"
  } else {
    ""
  }
}

///|
fn render_svg_styled(scene : Scene, node_styles : Map[String, String]) -> String {
  let sb = StringBuilder::new()
  let w_str = fmt_coord(scene.width)
  let h_str = fmt_coord(scene.height)
  sb.write_string("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"")
  sb.write_string(w_str)
  sb.write_string("\" height=\"")
  sb.write_string(h_str)
  sb.write_string("\" viewBox=\"0 0 ")
  sb.write_string(w_str)
  sb.write_string(" ")
  sb.write_string(h_str)
  sb.write_string("\">")
  sb.write_string("<defs>")
  sb.write_string("<marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M 0 1 L 10 5 L 0 9 z\" fill=\"#333\"/></marker>")
  sb.write_string("<marker id=\"open-arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M 1 1 L 9 5 L 1 9\" fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"/></marker>")
  sb.write_string("<marker id=\"circle-head\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\"><circle cx=\"5\" cy=\"5\" r=\"3.5\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1.5\"/></marker>")
  sb.write_string("<marker id=\"cross-head\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\"><path d=\"M 2 2 L 8 8 M 8 2 L 2 8\" stroke=\"#333\" stroke-width=\"1.5\"/></marker>")
  sb.write_string("</defs>")

  // Groups
  for g in scene.groups {
    sb.write_string("<g class=\"group group-")
    sb.write_string(xml_escape(g.kind))
    sb.write_string("\" data-id=\"")
    sb.write_string(xml_escape(g.id))
    sb.write_string("\">")
    let fill = if g.kind == "activation" { "#e2e8f0" } else { "#f8fafc" }
    sb.write_string("<rect x=\"")
    sb.write_string(fmt_coord(g.x))
    sb.write_string("\" y=\"")
    sb.write_string(fmt_coord(g.y))
    sb.write_string("\" width=\"")
    sb.write_string(fmt_coord(g.width))
    sb.write_string("\" height=\"")
    sb.write_string(fmt_coord(g.height))
    sb.write_string("\" rx=\"6\" fill=\"")
    sb.write_string(fill)
    sb.write_string("\" stroke=\"#94a3b8\" stroke-width=\"1.2\"/>")
    if g.title.length() > 0 && g.kind != "activation" {
      sb.write_string("<text x=\"")
      sb.write_string(fmt_coord(g.x + 8.0))
      sb.write_string("\" y=\"")
      sb.write_string(fmt_coord(g.y + 16.0))
      sb.write_string("\" font-size=\"12\" font-family=\"sans-serif\" fill=\"#334155\">")
      sb.write_string(xml_escape(g.title))
      sb.write_string("</text>")
    }
    sb.write_string("</g>")
  }

  // Edges
  for e in scene.edges {
    if e.stroke == "invisible" || e.points.length() < 2 {
      continue
    }
    sb.write_string("<polyline fill=\"none\" stroke=\"#334155\" stroke-width=\"")
    sb.write_string(if e.stroke == "thick" { "3" } else { "1.5" })
    sb.write_string("\"")
    if e.stroke == "dotted" {
      sb.write_string(" stroke-dasharray=\"5,4\"")
    }
    let end_m = arrow_marker_attr(e.end_arrow)
    if end_m.length() > 0 {
      sb.write_string(" marker-end=\"")
      sb.write_string(end_m)
      sb.write_string("\"")
    }
    let start_m = arrow_marker_attr(e.start_arrow)
    if start_m.length() > 0 {
      sb.write_string(" marker-start=\"")
      sb.write_string(start_m)
      sb.write_string("\"")
    }
    sb.write_string(" points=\"")
    for k = 0; k < e.points.length(); k = k + 1 {
      if k > 0 {
        sb.write_byte(b' ')
      }
      sb.write_string(fmt_coord(e.points[k].x))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(e.points[k].y))
    }
    sb.write_string("\"/>")
  }

  // Nodes
  for n in scene.nodes {
    let x0 = n.x - n.width / 2.0
    let y0 = n.y - n.height / 2.0
    let x1 = x0 + n.width
    let y1 = y0 + n.height
    let (s_fill, s_stroke, s_sw, s_color) = match node_styles.get(n.id) {
      Some(st_str) => parse_inline_style(st_str)
      None => ("", "", "", "")
    }
    let default_fill = if n.shape == "start" {
      "#1e293b"
    } else if n.shape == "note" {
      "#fef9c3"
    } else {
      "#ffffff"
    }
    let fill = if s_fill.length() > 0 { s_fill } else { default_fill }
    let stroke = if s_stroke.length() > 0 { s_stroke } else { "#334155" }
    let sw = if s_sw.length() > 0 { s_sw } else { "1.5" }
    let text_fill = if s_color.length() > 0 { s_color } else { "#0f172a" }

    sb.write_string("<g class=\"node node-")
    sb.write_string(xml_escape(n.shape))
    sb.write_string("\" data-id=\"")
    sb.write_string(xml_escape(n.id))
    sb.write_string("\">")
    if n.shape == "circle" || n.shape == "double_circle" || n.shape == "start" || n.shape == "end" {
      let r = (if n.width < n.height { n.width } else { n.height }) / 2.0
      sb.write_string("<circle cx=\"")
      sb.write_string(fmt_coord(n.x))
      sb.write_string("\" cy=\"")
      sb.write_string(fmt_coord(n.y))
      sb.write_string("\" r=\"")
      sb.write_string(fmt_coord(r))
      sb.write_string("\" fill=\"")
      sb.write_string(xml_escape(fill))
      sb.write_string("\" stroke=\"")
      sb.write_string(xml_escape(stroke))
      sb.write_string("\" stroke-width=\"")
      sb.write_string(xml_escape(sw))
      sb.write_string("\"/>")
      if n.shape == "double_circle" || n.shape == "end" {
        sb.write_string("<circle cx=\"")
        sb.write_string(fmt_coord(n.x))
        sb.write_string("\" cy=\"")
        sb.write_string(fmt_coord(n.y))
        sb.write_string("\" r=\"")
        sb.write_string(fmt_coord(r - 4.0))
        sb.write_string("\" fill=\"")
        sb.write_string(if n.shape == "end" { "#1e293b" } else { "none" })
        sb.write_string("\" stroke=\"")
        sb.write_string(xml_escape(stroke))
        sb.write_string("\" stroke-width=\"1.5\"/>")
      }
    } else if n.shape == "diamond" {
      sb.write_string("<polygon points=\"")
      sb.write_string(fmt_coord(n.x))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y0))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(x1))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(n.y))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(n.x))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y1))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(x0))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(n.y))
      sb.write_string("\" fill=\"")
      sb.write_string(xml_escape(fill))
      sb.write_string("\" stroke=\"")
      sb.write_string(xml_escape(stroke))
      sb.write_string("\" stroke-width=\"")
      sb.write_string(xml_escape(sw))
      sb.write_string("\"/>")
    } else if n.shape == "hexagon" {
      let dx = n.height * 0.35
      sb.write_string("<polygon points=\"")
      sb.write_string(fmt_coord(x0 + dx))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y0))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(x1 - dx))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y0))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(x1))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(n.y))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(x1 - dx))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y1))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(x0 + dx))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y1))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(x0))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(n.y))
      sb.write_string("\" fill=\"")
      sb.write_string(xml_escape(fill))
      sb.write_string("\" stroke=\"")
      sb.write_string(xml_escape(stroke))
      sb.write_string("\" stroke-width=\"")
      sb.write_string(xml_escape(sw))
      sb.write_string("\"/>")
    } else if n.shape == "cylinder" {
      let rx = n.width / 2.0
      let ry = 7.0
      sb.write_string("<path d=\"M ")
      sb.write_string(fmt_coord(x0))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(y0 + ry))
      sb.write_string(" A ")
      sb.write_string(fmt_coord(rx))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(ry))
      sb.write_string(" 0 0 1 ")
      sb.write_string(fmt_coord(x1))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(y0 + ry))
      sb.write_string(" L ")
      sb.write_string(fmt_coord(x1))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(y1 - ry))
      sb.write_string(" A ")
      sb.write_string(fmt_coord(rx))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(ry))
      sb.write_string(" 0 0 1 ")
      sb.write_string(fmt_coord(x0))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(y1 - ry))
      sb.write_string(" Z\" fill=\"")
      sb.write_string(xml_escape(fill))
      sb.write_string("\" stroke=\"")
      sb.write_string(xml_escape(stroke))
      sb.write_string("\" stroke-width=\"")
      sb.write_string(xml_escape(sw))
      sb.write_string("\"/>")
      sb.write_string("<ellipse cx=\"")
      sb.write_string(fmt_coord(n.x))
      sb.write_string("\" cy=\"")
      sb.write_string(fmt_coord(y0 + ry))
      sb.write_string("\" rx=\"")
      sb.write_string(fmt_coord(rx))
      sb.write_string("\" ry=\"")
      sb.write_string(fmt_coord(ry))
      sb.write_string("\" fill=\"")
      sb.write_string(xml_escape(fill))
      sb.write_string("\" stroke=\"")
      sb.write_string(xml_escape(stroke))
      sb.write_string("\" stroke-width=\"")
      sb.write_string(xml_escape(sw))
      sb.write_string("\"/>")
    } else if n.shape == "parallelogram" || n.shape == "parallelogram_alt" {
      let skew = n.height * 0.3
      let (tx0, tx1, bx0, bx1) = if n.shape == "parallelogram" {
        (x0 + skew, x1, x0, x1 - skew)
      } else {
        (x0, x1 - skew, x0 + skew, x1)
      }
      sb.write_string("<polygon points=\"")
      sb.write_string(fmt_coord(tx0))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y0))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(tx1))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y0))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(bx1))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y1))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(bx0))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y1))
      sb.write_string("\" fill=\"")
      sb.write_string(xml_escape(fill))
      sb.write_string("\" stroke=\"")
      sb.write_string(xml_escape(stroke))
      sb.write_string("\" stroke-width=\"")
      sb.write_string(xml_escape(sw))
      sb.write_string("\"/>")
    } else if n.shape == "trapezoid" || n.shape == "trapezoid_alt" {
      let inset = n.height * 0.25
      let (tx0, tx1, bx0, bx1) = if n.shape == "trapezoid" {
        (x0 + inset, x1 - inset, x0, x1)
      } else {
        (x0, x1, x0 + inset, x1 - inset)
      }
      sb.write_string("<polygon points=\"")
      sb.write_string(fmt_coord(tx0))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y0))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(tx1))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y0))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(bx1))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y1))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(bx0))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y1))
      sb.write_string("\" fill=\"")
      sb.write_string(xml_escape(fill))
      sb.write_string("\" stroke=\"")
      sb.write_string(xml_escape(stroke))
      sb.write_string("\" stroke-width=\"")
      sb.write_string(xml_escape(sw))
      sb.write_string("\"/>")
    } else if n.shape == "asymmetric" {
      let notch = n.height * 0.3
      sb.write_string("<polygon points=\"")
      sb.write_string(fmt_coord(x0))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y0))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(x1))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y0))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(x1))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y1))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(x0))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(y1))
      sb.write_byte(b' ')
      sb.write_string(fmt_coord(x0 + notch))
      sb.write_byte(b',')
      sb.write_string(fmt_coord(n.y))
      sb.write_string("\" fill=\"")
      sb.write_string(xml_escape(fill))
      sb.write_string("\" stroke=\"")
      sb.write_string(xml_escape(stroke))
      sb.write_string("\" stroke-width=\"")
      sb.write_string(xml_escape(sw))
      sb.write_string("\"/>")
    } else {
      let rx = if n.shape == "round" {
        "8"
      } else if n.shape == "stadium" {
        fmt_coord(n.height / 2.0)
      } else {
        "2"
      }
      sb.write_string("<rect x=\"")
      sb.write_string(fmt_coord(x0))
      sb.write_string("\" y=\"")
      sb.write_string(fmt_coord(y0))
      sb.write_string("\" width=\"")
      sb.write_string(fmt_coord(n.width))
      sb.write_string("\" height=\"")
      sb.write_string(fmt_coord(n.height))
      sb.write_string("\" rx=\"")
      sb.write_string(rx)
      sb.write_string("\" fill=\"")
      sb.write_string(xml_escape(fill))
      sb.write_string("\" stroke=\"")
      sb.write_string(xml_escape(stroke))
      sb.write_string("\" stroke-width=\"")
      sb.write_string(xml_escape(sw))
      sb.write_string("\"/>")
      if n.shape == "subroutine" {
        sb.write_string("<line x1=\"")
        sb.write_string(fmt_coord(x0 + 8.0))
        sb.write_string("\" y1=\"")
        sb.write_string(fmt_coord(y0))
        sb.write_string("\" x2=\"")
        sb.write_string(fmt_coord(x0 + 8.0))
        sb.write_string("\" y2=\"")
        sb.write_string(fmt_coord(y1))
        sb.write_string("\" stroke=\"")
        sb.write_string(xml_escape(stroke))
        sb.write_string("\" stroke-width=\"1.2\"/>")
        sb.write_string("<line x1=\"")
        sb.write_string(fmt_coord(x1 - 8.0))
        sb.write_string("\" y1=\"")
        sb.write_string(fmt_coord(y0))
        sb.write_string("\" x2=\"")
        sb.write_string(fmt_coord(x1 - 8.0))
        sb.write_string("\" y2=\"")
        sb.write_string(fmt_coord(y1))
        sb.write_string("\" stroke=\"")
        sb.write_string(xml_escape(stroke))
        sb.write_string("\" stroke-width=\"1.2\"/>")
      }
    }
    if n.label.length() > 0 && n.shape != "start" && n.shape != "end" {
      write_multiline_text(sb, n.x, n.y, n.label, "13", text_fill, "")
    }
    sb.write_string("</g>")
  }

  // Edge labels
  for lbl in scene.labels {
    write_multiline_text(sb, lbl.x, lbl.y, lbl.text, "11", "#475569", "edge-label")
  }

  sb.write_string("</svg>")
  sb.to_string()
}

///|
pub fn render_svg(scene : Scene) -> String {
  render_svg_styled(scene, Map::new())
}

///|
fn extract_diagram_styles(d : Diagram) -> Map[String, String] {
  let styles : Map[String, String] = Map::new()
  match d {
    Diagram::Flowchart(fc) => {
      let class_map : Map[String, String] = Map::new()
      for cd in fc.class_defs {
        class_map.set(cd.name, cd.style)
      }
      for n in fc.nodes {
        let mut combined = ""
        for cname in n.classes {
          match class_map.get(cname) {
            Some(cs) => {
              if cs.length() > 0 {
                if combined.length() > 0 {
                  combined = combined + "," + cs
                } else {
                  combined = cs
                }
              }
            }
            None => ()
          }
        }
        if n.style.length() > 0 {
          if combined.length() > 0 {
            combined = combined + "," + n.style
          } else {
            combined = n.style
          }
        }
        if combined.length() > 0 {
          styles.set(n.id, combined)
        }
      }
    }
    _ => ()
  }
  styles
}

///|
pub fn render(src : String) -> Result[String, ParseError] {
  match parse(src) {
    Ok(d) => Ok(render_svg_styled(layout(d), extract_diagram_styles(d)))
    Err(e) => Err(e)
  }
}
