///| ER Diagram (`erDiagram`) parser.

///|
struct MutErEntity {
  id : String
  mut alias : String
  attributes : Array[ErAttribute]
}

///|
struct ErParserCtx {
  mut direction : Direction
  entities : Array[MutErEntity]
  entity_idx : Map[String, Int]
  relations : Array[ErRelation]
}

///|
fn er_ensure(ctx : ErParserCtx, id : String) -> Int {
  match ctx.entity_idx.get(id) {
    Some(idx) => return idx
    None => ()
  }
  let idx = ctx.entities.length()
  ctx.entities.push(MutErEntity::{ id: id, alias: "", attributes: [] })
  ctx.entity_idx.set(id, idx)
  idx
}

///|
fn parse_er_entity_token(s : String, pos_in : Int, line_no : Int) -> Result[(String, String, Int), ParseError] {
  let n = s.length()
  let mut i = pos_in
  while i < n && is_space_byte(byte_at(s, i)) {
    i = i + 1
  }
  if i >= n {
    return Err(ParseError::{ line: line_no, col: i + 1, message: "expected ER entity name" })
  }
  let mut id = ""
  if byte_at(s, i) == 34 {
    // Quoted entity name
    let mut j = i + 1
    while j < n && byte_at(s, j) != 34 {
      let b = byte_at(s, j)
      if b == 37 || b == 92 || b == 10 || b == 13 {
        return Err(ParseError::{ line: line_no, col: j + 1, message: "disallowed character in ER entity name" })
      }
      j = j + 1
    }
    if j >= n {
      return Err(ParseError::{ line: line_no, col: i + 1, message: "unclosed quoted ER entity name" })
    }
    id = s.slice(i + 1, j)
    if id.length() == 0 {
      return Err(ParseError::{ line: line_no, col: i + 1, message: "empty quoted ER entity name" })
    }
    i = j + 1
  } else {
    let start = i
    while i < n && is_ident_byte(byte_at(s, i)) {
      i = i + 1
    }
    if i == start {
      return Err(ParseError::{ line: line_no, col: i + 1, message: "invalid ER entity identifier" })
    }
    id = s.slice(start, i)
  }
  // Optional alias `["alias"]`
  let mut alias_str = ""
  if i < n && byte_at(s, i) == 91 {
    let close_br = scan_balanced(s, i + 1, "]")
    if close_br < 0 {
      return Err(ParseError::{ line: line_no, col: i + 1, message: "unclosed ER entity alias [" })
    }
    alias_str = unquote_string(s.slice(i + 1, close_br).trim())
    i = close_br + 1
  }
  Ok((id, alias_str, i))
}

///|
fn parse_er_left_card(s : String, pos : Int) -> Option[(ErCardinality, Int)] {
  if pos + 2 > s.length() {
    return None
  }
  let tok = s.slice(pos, pos + 2)
  if tok == "||" {
    Some((ErCardinality::OnlyOne, pos + 2))
  } else if tok == "|o" || tok == "o|" {
    Some((ErCardinality::ZeroOrOne, pos + 2))
  } else if tok == "}|" || tok == "|{" {
    Some((ErCardinality::OneOrMore, pos + 2))
  } else if tok == "}o" || tok == "o{" {
    Some((ErCardinality::ZeroOrMore, pos + 2))
  } else {
    None
  }
}

///|
fn parse_er_right_card(s : String, pos : Int) -> Option[(ErCardinality, Int)] {
  if pos + 2 > s.length() {
    return None
  }
  let tok = s.slice(pos, pos + 2)
  if tok == "||" {
    Some((ErCardinality::OnlyOne, pos + 2))
  } else if tok == "o|" || tok == "|o" {
    Some((ErCardinality::ZeroOrOne, pos + 2))
  } else if tok == "|{" || tok == "}|" {
    Some((ErCardinality::OneOrMore, pos + 2))
  } else if tok == "o{" || tok == "}o" {
    Some((ErCardinality::ZeroOrMore, pos + 2))
  } else {
    None
  }
}

///|
fn parse_er_attribute_line(line : String) -> ErAttribute {
  let t = line.trim()
  // Extract optional trailing quoted comment
  let mut comment = ""
  let mut head = t
  let q1 = find_char_outside_quotes(t, 34, 0)
  // Find first quote directly
  let fq = t.index_of("\"")
  let _ = q1
  if fq >= 0 {
    let rest = t.slice(fq, t.length())
    comment = unquote_string(rest)
    head = t.slice(0, fq).trim()
  }
  let words = split_words(head)
  let attr_type = if words.length() >= 1 { words[0] } else { "" }
  let name = if words.length() >= 2 { words[1] } else { "" }
  let keys : Array[String] = []
  for k = 2; k < words.length(); k = k + 1 {
    for kp in words[k].split(",") {
      let tk = kp.trim()
      if tk.length() > 0 {
        keys.push(tk)
      }
    }
  }
  ErAttribute::{ attr_type: attr_type, name: name, keys: keys, comment: comment }
}

///|
pub fn parse_er(lines : Array[SourceLine], start_idx : Int) -> Result[ErDiagram, ParseError] {
  let ctx = ErParserCtx::{
    direction: Direction::TB,
    entities: [],
    entity_idx: Map::new(),
    relations: [],
  }
  let mut open_entity : Option[Int] = None
  let mut open_line = 0

  for i = start_idx; i < lines.length(); i = i + 1 {
    let line_no = lines[i].line_no
    let s = strip_line_comment(lines[i].text).trim()
    if s.length() == 0 {
      continue
    }
    if open_entity.is_some() {
      let eidx = open_entity.unwrap_or(0)
      if s == "}" {
        open_entity = None
        continue
      }
      ctx.entities[eidx].attributes.push(parse_er_attribute_line(s))
      continue
    }
    let words = split_words(s)
    if words.length() >= 2 && words[0] == "direction" {
      match parse_direction_opt(words[1]) {
        Some(d) => ctx.direction = d
        None => return Err(ParseError::{ line: line_no, col: 1, message: "invalid direction" })
      }
      continue
    }
    let (e1_id, e1_alias, pos_init) = parse_er_entity_token(s, 0, line_no)?
    let mut pos = pos_init
    let e1_idx = er_ensure(ctx, e1_id)
    if e1_alias.length() > 0 {
      ctx.entities[e1_idx].alias = e1_alias
    }
    let n = s.length()
    while pos < n && is_space_byte(byte_at(s, pos)) {
      pos = pos + 1
    }
    if pos >= n {
      continue
    }
    if byte_at(s, pos) == 123 {
      let after = s.slice(pos + 1, n).trim()
      if after != "}" {
        open_entity = Some(e1_idx)
        open_line = line_no
      }
      continue
    }
    // Otherwise expect relationship: <left_card>(--|..)<right_card> <e2> : <label>
    let (left_card, p1) = match parse_er_left_card(s, pos) {
      Some(v) => v
      None => return Err(ParseError::{ line: line_no, col: pos + 1, message: "expected ER cardinality" })
    }
    if p1 + 2 > n {
      return Err(ParseError::{ line: line_no, col: p1 + 1, message: "expected -- or .. in ER relation" })
    }
    let line_tok = s.slice(p1, p1 + 2)
    let identifying = if line_tok == "--" {
      true
    } else if line_tok == ".." {
      false
    } else {
      return Err(ParseError::{ line: line_no, col: p1 + 1, message: "expected -- or .. in ER relation" })
    }
    let (right_card, p2) = match parse_er_right_card(s, p1 + 2) {
      Some(v) => v
      None => return Err(ParseError::{ line: line_no, col: p1 + 3, message: "expected right ER cardinality" })
    }
    let (e2_id, e2_alias, p3_init) = parse_er_entity_token(s, p2, line_no)?
    let mut p3 = p3_init
    let e2_idx = er_ensure(ctx, e2_id)
    if e2_alias.length() > 0 {
      ctx.entities[e2_idx].alias = e2_alias
    }
    while p3 < n && is_space_byte(byte_at(s, p3)) {
      p3 = p3 + 1
    }
    let mut lbl = ""
    if p3 < n && byte_at(s, p3) == 58 {
      lbl = unquote_string(s.slice(p3 + 1, n).trim())
    }
    ctx.relations.push(ErRelation::{
      from: e1_id,
      to: e2_id,
      from_card: left_card,
      to_card: right_card,
      identifying: identifying,
      label: lbl,
    })
  }
  if open_entity.is_some() {
    return Err(ParseError::{ line: open_line, col: 1, message: "unclosed ER entity attribute block" })
  }
  let out_entities : Array[ErEntity] = []
  for e in ctx.entities {
    out_entities.push(ErEntity::{ id: e.id, alias: e.alias, attributes: e.attributes })
  }
  Ok(ErDiagram::{
    direction: ctx.direction,
    entities: out_entities,
    relations: ctx.relations,
  })
}
