///| Class Diagram (`classDiagram`) parser.

///|
struct MutClassNode {
  id : String
  mut label : String
  mut annotation : String
  mut generic : String
  mut namespace_name : Option[String]
  members : Array[ClassMember]
}

///|
struct ClassParserCtx {
  mut direction : Direction
  classes : Array[MutClassNode]
  class_idx : Map[String, Int]
  relations : Array[ClassRelation]
  mut cur_ns : Option[String]
}

///|
fn strip_backticks(s : String) -> String {
  let t = s.trim()
  let n = t.length()
  if n >= 2 && byte_at(t, 0) == 96 && byte_at(t, n - 1) == 96 {
    return t.slice(1, n - 1)
  }
  t
}

///|
fn parse_class_name_generic(raw : String) -> (String, String) {
  let mut t = strip_backticks(raw)
  let cls_pos = t.index_of(":::")
  if cls_pos >= 0 {
    t = t.slice(0, cls_pos).trim()
  }
  let t1 = t.index_of("~")
  if t1 >= 0 {
    let base = t.slice(0, t1).trim()
    let rest = t.slice(t1 + 1, t.length())
    let t2 = rest.index_of("~")
    if t2 >= 0 {
      return (base, rest.slice(0, t2).trim())
    }
    return (base, rest.trim())
  }
  (t, "")
}

///|
fn class_ensure(ctx : ClassParserCtx, raw_name : String) -> Int {
  let (id, gen) = parse_class_name_generic(raw_name)
  match ctx.class_idx.get(id) {
    Some(idx) => {
      if gen.length() > 0 && ctx.classes[idx].generic.length() == 0 {
        ctx.classes[idx].generic = gen
      }
      if ctx.classes[idx].namespace_name.is_none() && ctx.cur_ns.is_some() {
        ctx.classes[idx].namespace_name = ctx.cur_ns
      }
      return idx
    }
    None => ()
  }
  let idx = ctx.classes.length()
  ctx.classes.push(MutClassNode::{
    id: id,
    label: id,
    annotation: "",
    generic: gen,
    namespace_name: ctx.cur_ns,
    members: [],
  })
  ctx.class_idx.set(id, idx)
  idx
}

///|
fn parse_class_member(line : String) -> ClassMember {
  let t = line.trim()
  let mut vis = ""
  let mut body = t
  if t.length() > 0 {
    let b = byte_at(t, 0)
    if b == 43 || b == 45 || b == 35 || b == 126 {
      vis = t.slice(0, 1)
      body = t.slice(1, t.length()).trim()
    }
  }
  let is_method = body.contains("(")
  ClassMember::{ visibility: vis, text: body, is_method: is_method }
}

///|
struct ClassRelOpMatch {
  pos : Int
  len : Int
  kind : ClassRelationKind
}

///|
fn find_class_rel_op(s : String) -> Option[ClassRelOpMatch] {
  let ops : Array[(String, ClassRelationKind)] = [
    ("<|--|>", ClassRelationKind::Inheritance),
    ("<|..|>", ClassRelationKind::Realization),
    ("<|--*", ClassRelationKind::Inheritance),
    ("*--|>", ClassRelationKind::Composition),
    ("<|--o", ClassRelationKind::Inheritance),
    ("o--|>", ClassRelationKind::Aggregation),
    ("<|-->", ClassRelationKind::Inheritance),
    ("<--|>", ClassRelationKind::Inheritance),
    ("*--*", ClassRelationKind::Composition),
    ("o--o", ClassRelationKind::Aggregation),
    ("*--o", ClassRelationKind::Composition),
    ("o--*", ClassRelationKind::Aggregation),
    ("<-->", ClassRelationKind::Association),
    ("<..>", ClassRelationKind::Dependency),
    ("<|--", ClassRelationKind::Inheritance),
    ("--|>", ClassRelationKind::Inheritance),
    ("<|..", ClassRelationKind::Realization),
    ("..|>", ClassRelationKind::Realization),
    ("*--", ClassRelationKind::Composition),
    ("--*", ClassRelationKind::Composition),
    ("o--", ClassRelationKind::Aggregation),
    ("--o", ClassRelationKind::Aggregation),
    ("()--", ClassRelationKind::Lollipop),
    ("--()", ClassRelationKind::Lollipop),
    ("-->", ClassRelationKind::Association),
    ("<--", ClassRelationKind::Association),
    ("..>", ClassRelationKind::Dependency),
    ("<..", ClassRelationKind::Dependency),
    ("--", ClassRelationKind::Link),
    ("..", ClassRelationKind::Dependency),
  ]
  for pair in ops {
    let (tok, kind) = pair
    let p = find_token_outside_quotes(s, tok)
    if p >= 0 {
      return Some(ClassRelOpMatch::{ pos: p, len: tok.length(), kind: kind })
    }
  }
  None
}

///|
fn find_token_outside_quotes(s : String, tok : String) -> Int {
  let n = s.length()
  let tn = tok.length()
  let mut in_q = false
  let mut in_bt = false
  for i = 0; i + tn <= n; i = i + 1 {
    let b = byte_at(s, i)
    if b == 34 && !in_bt {
      in_q = !in_q
      continue
    }
    if b == 96 && !in_q {
      in_bt = !in_bt
      continue
    }
    if !in_q && !in_bt && s.slice(i, i + tn) == tok {
      return i
    }
  }
  -1
}

///|
fn split_class_side(side : String, is_left : Bool) -> (String, String) {
  let t = side.trim()
  let q1 = t.index_of("\"")
  if q1 < 0 {
    return (t, "")
  }
  let q2 = t.slice(q1 + 1, t.length()).index_of("\"")
  if q2 < 0 {
    return (t, "")
  }
  let end_q = q1 + 1 + q2
  let card = t.slice(q1 + 1, end_q)
  if is_left {
    (t.slice(0, q1).trim(), card)
  } else {
    (t.slice(end_q + 1, t.length()).trim(), card)
  }
}

///|
pub fn parse_class(lines : Array[SourceLine], start_idx : Int) -> Result[ClassDiagram, ParseError] {
  let ctx = ClassParserCtx::{
    direction: Direction::TB,
    classes: [],
    class_idx: Map::new(),
    relations: [],
    cur_ns: None,
  }
  let mut open_class : Option[Int] = None
  let mut open_class_line = 0
  let mut open_ns_line = 0

  for i = start_idx; i < lines.length(); i = i + 1 {
    let line_no = lines[i].line_no
    let s = strip_line_comment(lines[i].text).trim()
    if s.length() == 0 {
      continue
    }
    if open_class.is_some() {
      let cidx = open_class.unwrap_or(0)
      if s == "}" {
        open_class = None
        continue
      }
      if s.starts_with("<<") && s.ends_with(">>") && s.length() > 4 {
        ctx.classes[cidx].annotation = s.slice(2, s.length() - 2).trim()
      } else {
        ctx.classes[cidx].members.push(parse_class_member(s))
      }
      continue
    }
    if s == "}" {
      if ctx.cur_ns.is_some() {
        ctx.cur_ns = None
        continue
      }
      return Err(ParseError::{ line: line_no, col: 1, message: "unexpected '}'" })
    }
    let words = split_words(s)
    if words.length() == 0 {
      continue
    }
    let kw = words[0]
    if kw == "direction" && words.length() >= 2 {
      match parse_direction_opt(words[1]) {
        Some(d) => ctx.direction = d
        None => return Err(ParseError::{ line: line_no, col: 1, message: "invalid direction" })
      }
      continue
    }
    if kw == "namespace" {
      let rest = s.slice(9, s.length()).trim()
      let br = rest.index_of("{")
      let ns_name = if br >= 0 { strip_backticks(rest.slice(0, br).trim()) } else { strip_backticks(rest) }
      ctx.cur_ns = Some(ns_name)
      open_ns_line = line_no
      continue
    }
    if kw == "class" {
      let mut rest = s.slice(5, s.length()).trim()
      let mut has_open = false
      let br = find_char_outside_quotes(rest, 123, 0)
      if br >= 0 {
        let after = rest.slice(br + 1, rest.length()).trim()
        rest = rest.slice(0, br).trim()
        if !after.ends_with("}") {
          has_open = true
        }
      }
      // Check optional bracket label: `class Animal["Animal with a label"]`
      let mut explicit_label = ""
      let lbr = find_char_outside_quotes(rest, 91, 0)
      if lbr > 0 {
        let rbr = scan_balanced(rest, lbr + 1, "]")
        if rbr > lbr {
          explicit_label = unquote_string(rest.slice(lbr + 1, rbr).trim())
          rest = rest.slice(0, lbr).trim()
        }
      }
      let cidx = class_ensure(ctx, rest)
      if explicit_label.length() > 0 {
        ctx.classes[cidx].label = explicit_label
      }
      if has_open {
        open_class = Some(cidx)
        open_class_line = line_no
      }
      continue
    }
    if s.starts_with("<<") {
      let end_a = s.index_of(">>")
      if end_a > 2 {
        let annot = s.slice(2, end_a).trim()
        let cname = s.slice(end_a + 2, s.length()).trim()
        if cname.length() > 0 {
          let cidx = class_ensure(ctx, cname)
          ctx.classes[cidx].annotation = annot
          continue
        }
      }
    }
    if kw == "note" ||
    kw == "link" ||
    kw == "click" ||
    kw == "callback" ||
    kw == "style" ||
    kw == "cssClass" ||
    kw == "classDef" ||
    kw == "accTitle:" ||
    kw == "accDescr:" ||
    kw == "accTitle" ||
    kw == "accDescr" {
      continue
    }
    // Check relationship
    match find_class_rel_op(s) {
      Some(m) => {
        let left_raw = s.slice(0, m.pos).trim()
        let right_full = s.slice(m.pos + m.len, s.length()).trim()
        let colon = find_char_outside_quotes(right_full, 58, 0)
        let right_raw = if colon >= 0 { right_full.slice(0, colon).trim() } else { right_full }
        let lbl = if colon >= 0 { right_full.slice(colon + 1, right_full.length()).trim() } else { "" }
        let (from_raw, from_card) = split_class_side(left_raw, true)
        let (to_raw, to_card) = split_class_side(right_raw, false)
        let fidx = class_ensure(ctx, from_raw)
        let tidx = class_ensure(ctx, to_raw)
        ctx.relations.push(ClassRelation::{
          from: ctx.classes[fidx].id,
          to: ctx.classes[tidx].id,
          kind: m.kind,
          label: lbl,
          from_card: from_card,
          to_card: to_card,
        })
        continue
      }
      None => ()
    }
    // Check colon member syntax: ClassName : member
    let colon = find_char_outside_quotes(s, 58, 0)
    if colon > 0 {
      let cname = s.slice(0, colon).trim()
      let mem = s.slice(colon + 1, s.length()).trim()
      let cidx = class_ensure(ctx, cname)
      ctx.classes[cidx].members.push(parse_class_member(mem))
      continue
    }
    return Err(ParseError::{ line: line_no, col: 1, message: "unrecognized class statement: " + s })
  }
  if open_class.is_some() {
    return Err(ParseError::{ line: open_class_line, col: 1, message: "unclosed class block" })
  }
  if ctx.cur_ns.is_some() {
    return Err(ParseError::{ line: open_ns_line, col: 1, message: "unclosed namespace block" })
  }
  let out_classes : Array[ClassNode] = []
  for c in ctx.classes {
    out_classes.push(ClassNode::{
      id: c.id,
      label: c.label,
      annotation: c.annotation,
      generic: c.generic,
      namespace_name: c.namespace_name,
      members: c.members,
    })
  }
  Ok(ClassDiagram::{
    direction: ctx.direction,
    classes: out_classes,
    relations: ctx.relations,
  })
}
