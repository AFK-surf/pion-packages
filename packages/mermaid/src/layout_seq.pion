///| Sequence Diagram 2D layout engine (lifelines, messages, activations, notes, nested blocks).

///|
struct SeqLayoutCtx {
  autonumber : Bool
  part_x : Map[String, Double]
  part_w : Map[String, Double]
  part_ids : Array[String]
  nodes : Array[LayoutNode]
  edges : Array[LayoutEdge]
  groups : Array[LayoutGroup]
  labels : Array[LayoutLabel]
  act_stacks : Map[String, Array[Double]]
  mut cur_y : Double
  mut msg_num : Int
  mut block_seq : Int
  mut note_seq : Int
  mut act_seq : Int
}

///|
fn seq_arrow_stroke(k : SeqArrowKind) -> String {
  match k {
    SeqArrowKind::DottedLine | SeqArrowKind::DottedArrow | SeqArrowKind::DottedCross | SeqArrowKind::DottedAsync =>
    "dotted"
    _ => "solid"
  }
}

///|
fn seq_arrow_end(k : SeqArrowKind) -> String {
  match k {
    SeqArrowKind::SolidLine | SeqArrowKind::DottedLine => "open"
    SeqArrowKind::SolidArrow | SeqArrowKind::DottedArrow => "arrow"
    SeqArrowKind::SolidCross | SeqArrowKind::DottedCross => "cross"
    SeqArrowKind::SolidAsync | SeqArrowKind::DottedAsync => "async"
  }
}

///|
fn seq_block_kind_str(k : SeqBlockKind) -> String {
  match k {
    SeqBlockKind::Loop => "loop"
    SeqBlockKind::Alt => "alt"
    SeqBlockKind::Opt => "opt"
    SeqBlockKind::Par => "par"
    SeqBlockKind::Critical => "critical"
    SeqBlockKind::Break => "break"
    SeqBlockKind::Rect => "rect"
  }
}

///|
fn seq_push_act(ctx : SeqLayoutCtx, pid : String, y : Double) -> Unit {
  match ctx.act_stacks.get(pid) {
    Some(arr) => arr.push(y)
    None => {
      let arr : Array[Double] = [y]
      ctx.act_stacks.set(pid, arr)
    }
  }
}

///|
fn seq_pop_act(ctx : SeqLayoutCtx, pid : String, end_y : Double) -> Unit {
  let st = match ctx.act_stacks.get(pid) {
    Some(arr) => arr
    None => return
  }
  let start_y = match st.pop() {
    Some(y) => y
    None => return
  }
  let depth = st.length()
  let cx = ctx.part_x.get(pid).unwrap_or(100.0)
  let w = 12.0
  let h = if end_y - start_y > 16.0 { end_y - start_y } else { 16.0 }
  ctx.groups.push(LayoutGroup::{
    id: "act_" + ctx.act_seq.to_string(),
    title: pid,
    kind: "activation",
    x: cx - w / 2.0 + depth.to_double() * 4.0,
    y: start_y,
    width: w,
    height: h,
    parent_id: None,
  })
  ctx.act_seq = ctx.act_seq + 1
}

///|
fn seq_layout_stmts(ctx : SeqLayoutCtx, stmts : Array[SeqStmt], depth : Int) -> Unit {
  for stmt in stmts {
    match stmt {
      SeqStmt::Message(from_id, to_id, akind, text, act, deact) => {
        ctx.msg_num = ctx.msg_num + 1
        let lbl = if ctx.autonumber {
          ctx.msg_num.to_string() + ". " + text
        } else {
          text
        }
        let x1 = ctx.part_x.get(from_id).unwrap_or(80.0)
        let x2 = ctx.part_x.get(to_id).unwrap_or(240.0)
        let y = ctx.cur_y
        let pts : Array[Point] = if from_id == to_id {
          [
            Point::{ x: x1, y: y },
            Point::{ x: x1 + 45.0, y: y },
            Point::{ x: x1 + 45.0, y: y + 26.0 },
            Point::{ x: x1, y: y + 26.0 },
          ]
        } else {
          [Point::{ x: x1, y: y }, Point::{ x: x2, y: y }]
        }
        let eid = "msg_" + ctx.msg_num.to_string()
        ctx.edges.push(LayoutEdge::{
          id: eid,
          from: from_id,
          to: to_id,
          label: lbl,
          stroke: seq_arrow_stroke(akind),
          start_arrow: "none",
          end_arrow: seq_arrow_end(akind),
          points: pts,
          reversed: false,
        })
        if lbl.length() > 0 {
          let lx = if from_id == to_id { x1 + 52.0 } else { (x1 + x2) / 2.0 }
          ctx.labels.push(LayoutLabel::{
            text: lbl,
            x: lx,
            y: y - 10.0,
            width: lbl.length().to_double() * 7.2 + 12.0,
            height: 18.0,
            owner_id: eid,
          })
        }
        if act {
          seq_push_act(ctx, to_id, y)
        }
        if deact {
          seq_pop_act(ctx, from_id, y)
        }
        ctx.cur_y = ctx.cur_y + (if from_id == to_id { 54.0 } else { 42.0 })
      }
      SeqStmt::Activate(pid) => seq_push_act(ctx, pid, ctx.cur_y - 20.0)
      SeqStmt::Deactivate(pid) => seq_pop_act(ctx, pid, ctx.cur_y)
      SeqStmt::Note(pos_kind, targets, text) => {
        let note_w = {
          let est = text.length().to_double() * 7.5 + 24.0
          if est > 110.0 { est } else { 110.0 }
        }
        let note_h = 34.0
        let mut nx = 100.0
        let mut nw = note_w
        if targets.length() >= 1 {
          let tx0 = ctx.part_x.get(targets[0]).unwrap_or(100.0)
          match pos_kind {
            SeqNotePos::LeftOf => nx = tx0 - note_w / 2.0 - 16.0
            SeqNotePos::RightOf => nx = tx0 + note_w / 2.0 + 16.0
            SeqNotePos::Over => {
              if targets.length() >= 2 {
                let tx1 = ctx.part_x.get(targets[1]).unwrap_or(tx0)
                let lo = if tx0 < tx1 { tx0 } else { tx1 }
                let hi = if tx0 > tx1 { tx0 } else { tx1 }
                let span = (hi - lo) + 80.0
                nw = if span > note_w { span } else { note_w }
                nx = (lo + hi) / 2.0
              } else {
                nx = tx0
              }
            }
          }
        }
        if nx - nw / 2.0 < 16.0 {
          nx = 16.0 + nw / 2.0
        }
        let ny = ctx.cur_y + note_h / 2.0
        ctx.nodes.push(LayoutNode::{
          id: "note_" + ctx.note_seq.to_string(),
          label: text,
          shape: "note",
          x: nx,
          y: ny,
          width: nw,
          height: note_h,
          rank: 0,
          order: ctx.note_seq,
          group_id: None,
        })
        ctx.note_seq = ctx.note_seq + 1
        ctx.cur_y = ctx.cur_y + note_h + 18.0
      }
      SeqStmt::Block(bkind, label, sections) => {
        let top_y = ctx.cur_y - 12.0
        ctx.cur_y = ctx.cur_y + 24.0
        for sec in sections {
          seq_layout_stmts(ctx, sec.stmts, depth + 1)
          ctx.cur_y = ctx.cur_y + 10.0
        }
        let bot_y = ctx.cur_y
        let mut min_x = 1.0e18
        let mut max_x = 0.0
        for pid in ctx.part_ids {
          let px = ctx.part_x.get(pid).unwrap_or(100.0)
          let pw = ctx.part_w.get(pid).unwrap_or(100.0)
          if px - pw / 2.0 < min_x { min_x = px - pw / 2.0 }
          if px + pw / 2.0 > max_x { max_x = px + pw / 2.0 }
        }
        if min_x > max_x {
          min_x = 20.0
          max_x = 220.0
        }
        let inset = depth.to_double() * 8.0
        ctx.groups.push(LayoutGroup::{
          id: "block_" + ctx.block_seq.to_string(),
          title: label,
          kind: seq_block_kind_str(bkind),
          x: min_x - 16.0 + inset,
          y: top_y,
          width: (max_x - min_x) + 32.0 - inset * 2.0,
          height: bot_y - top_y,
          parent_id: None,
        })
        ctx.block_seq = ctx.block_seq + 1
        ctx.cur_y = ctx.cur_y + 16.0
      }
    }
  }
}

///|
pub fn layout_sequence(sd : SequenceDiagram) -> Scene {
  let ctx = SeqLayoutCtx::{
    autonumber: sd.autonumber,
    part_x: Map::new(),
    part_w: Map::new(),
    part_ids: [],
    nodes: [],
    edges: [],
    groups: [],
    labels: [],
    act_stacks: Map::new(),
    cur_y: 100.0,
    msg_num: 0,
    block_seq: 0,
    note_seq: 0,
    act_seq: 0,
  }
  let margin_x = 40.0
  let part_gap = 60.0
  let part_h = 40.0
  let top_y = 40.0
  let mut cur_x = margin_x
  for i = 0; i < sd.participants.length(); i = i + 1 {
    let p = sd.participants[i]
    let est_w = p.alias.length().to_double() * 8.0 + 32.0
    let pw = if est_w > 100.0 { est_w } else { 100.0 }
    let cx = cur_x + pw / 2.0
    ctx.part_x.set(p.id, cx)
    ctx.part_w.set(p.id, pw)
    ctx.part_ids.push(p.id)
    let sh = match p.kind {
      SeqParticipantKind::Actor => "actor"
      SeqParticipantKind::Participant => "rect"
    }
    ctx.nodes.push(LayoutNode::{
      id: p.id,
      label: p.alias,
      shape: sh,
      x: cx,
      y: top_y,
      width: pw,
      height: part_h,
      rank: 0,
      order: i,
      group_id: None,
    })
    cur_x = cur_x + pw + part_gap
  }
  seq_layout_stmts(ctx, sd.stmts, 0)
  // Close any unclosed activations
  for pid in ctx.part_ids {
    match ctx.act_stacks.get(pid) {
      Some(st) => {
        while st.length() > 0 {
          seq_pop_act(ctx, pid, ctx.cur_y)
        }
      }
      None => ()
    }
  }
  let mut max_x = cur_x + margin_x
  let max_y = ctx.cur_y + 40.0
  for n in ctx.nodes {
    if n.x + n.width / 2.0 + margin_x > max_x {
      max_x = n.x + n.width / 2.0 + margin_x
    }
  }
  for g in ctx.groups {
    if g.x + g.width + margin_x > max_x {
      max_x = g.x + g.width + margin_x
    }
  }
  Scene::{
    width: if max_x > 100.0 { max_x } else { 100.0 },
    height: max_y,
    nodes: ctx.nodes,
    edges: ctx.edges,
    groups: ctx.groups,
    labels: ctx.labels,
  }
}
