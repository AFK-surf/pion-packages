///| Sequence Diagram (`sequenceDiagram`) parser.

///|
struct OpenSeqBlock {
  kind : SeqBlockKind
  label : String
  sections : Array[SeqBlockSection]
  mut cur_label : String
  mut cur_stmts : Array[SeqStmt]
  start_line : Int
}

///|
struct SeqParserState {
  mut autonumber : Bool
  participants : Array[SeqParticipant]
  part_idx : Map[String, Int]
}

///|
fn seq_ensure_participant(st : SeqParserState, id : String) -> Unit {
  if st.part_idx.get(id).is_none() {
    let idx = st.participants.length()
    st.participants.push(SeqParticipant::{
      id: id,
      alias: id,
      kind: SeqParticipantKind::Participant,
    })
    st.part_idx.set(id, idx)
  }
}

///|
fn seq_declare_participant(
  st : SeqParserState,
  id : String,
  alias_str : String,
  kind : SeqParticipantKind,
) -> Unit {
  match st.part_idx.get(id) {
    Some(idx) => st.participants[idx] = SeqParticipant::{ id: id, alias: alias_str, kind: kind }
    None => {
      let idx = st.participants.length()
      st.participants.push(SeqParticipant::{ id: id, alias: alias_str, kind: kind })
      st.part_idx.set(id, idx)
    }
  }
}

///|
fn seq_emit(root : Array[SeqStmt], stack : Array[OpenSeqBlock], stmt : SeqStmt) -> Unit {
  if stack.length() > 0 {
    stack[stack.length() - 1].cur_stmts.push(stmt)
  } else {
    root.push(stmt)
  }
}

///|
struct SeqArrowMatch {
  pos : Int
  len : Int
  kind : SeqArrowKind
}

///|
fn find_seq_arrow(s : String) -> Option[SeqArrowMatch] {
  let n = s.length()
  let mut i = 0
  while i < n {
    if byte_at(s, i) == 45 {
      // Check longest matches first
      if i + 4 <= n {
        let s4 = s.slice(i, i + 4)
        if s4 == "-->>" {
          return Some(SeqArrowMatch::{ pos: i, len: 4, kind: SeqArrowKind::DottedArrow })
        }
      }
      if i + 3 <= n {
        let s3 = s.slice(i, i + 3)
        if s3 == "->>" {
          return Some(SeqArrowMatch::{ pos: i, len: 3, kind: SeqArrowKind::SolidArrow })
        }
        if s3 == "-->" {
          return Some(SeqArrowMatch::{ pos: i, len: 3, kind: SeqArrowKind::DottedLine })
        }
        if s3 == "--x" {
          return Some(SeqArrowMatch::{ pos: i, len: 3, kind: SeqArrowKind::DottedCross })
        }
        if s3 == "--)" {
          return Some(SeqArrowMatch::{ pos: i, len: 3, kind: SeqArrowKind::DottedAsync })
        }
      }
      if i + 2 <= n {
        let s2 = s.slice(i, i + 2)
        if s2 == "->" {
          return Some(SeqArrowMatch::{ pos: i, len: 2, kind: SeqArrowKind::SolidLine })
        }
        if s2 == "-x" {
          return Some(SeqArrowMatch::{ pos: i, len: 2, kind: SeqArrowKind::SolidCross })
        }
        if s2 == "-)" {
          return Some(SeqArrowMatch::{ pos: i, len: 2, kind: SeqArrowKind::SolidAsync })
        }
      }
    }
    i = i + 1
  }
  None
}

///|
pub fn parse_sequence(lines : Array[SourceLine], start_idx : Int) -> Result[SequenceDiagram, ParseError] {
  let st = SeqParserState::{
    autonumber: false,
    participants: [],
    part_idx: Map::new(),
  }
  let root_stmts : Array[SeqStmt] = []
  let stack : Array[OpenSeqBlock] = []

  for i = start_idx; i < lines.length(); i = i + 1 {
    let line_no = lines[i].line_no
    let s = strip_line_comment(lines[i].text).trim()
    if s.length() == 0 {
      continue
    }
    if s == "autonumber" {
      st.autonumber = true
      continue
    }
    if s == "end" {
      match stack.pop() {
        None =>
        return Err(ParseError::{ line: line_no, col: 1, message: "unexpected 'end' without open block" })
        Some(blk) => {
          blk.sections.push(SeqBlockSection::{ label: blk.cur_label, stmts: blk.cur_stmts })
          let stmt = SeqStmt::Block(blk.kind, blk.label, blk.sections)
          seq_emit(root_stmts, stack, stmt)
          continue
        }
      }
    }
    let words = split_words(s)
    if words.length() == 0 {
      continue
    }
    let kw = words[0]
    if kw == "participant" || kw == "actor" {
      let kind = if kw == "actor" { SeqParticipantKind::Actor } else { SeqParticipantKind::Participant }
      let rest = s.slice(kw.length(), s.length()).trim()
      let as_pos = rest.index_of(" as ")
      if as_pos >= 0 {
        let pid = rest.slice(0, as_pos).trim()
        let palias = rest.slice(as_pos + 4, rest.length()).trim()
        seq_declare_participant(st, pid, palias, kind)
      } else {
        seq_declare_participant(st, rest, rest, kind)
      }
      continue
    }
    if kw == "activate" && words.length() >= 2 {
      let pid = s.slice(8, s.length()).trim()
      seq_ensure_participant(st, pid)
      seq_emit(root_stmts, stack, SeqStmt::Activate(pid))
      continue
    }
    if kw == "deactivate" && words.length() >= 2 {
      let pid = s.slice(10, s.length()).trim()
      seq_ensure_participant(st, pid)
      seq_emit(root_stmts, stack, SeqStmt::Deactivate(pid))
      continue
    }
    if kw == "loop" || kw == "alt" || kw == "opt" || kw == "par" || kw == "critical" || kw == "break" || kw == "rect" {
      let bkind = if kw == "loop" {
        SeqBlockKind::Loop
      } else if kw == "alt" {
        SeqBlockKind::Alt
      } else if kw == "opt" {
        SeqBlockKind::Opt
      } else if kw == "par" {
        SeqBlockKind::Par
      } else if kw == "critical" {
        SeqBlockKind::Critical
      } else if kw == "break" {
        SeqBlockKind::Break
      } else {
        SeqBlockKind::Rect
      }
      let lbl = s.slice(kw.length(), s.length()).trim()
      stack.push(OpenSeqBlock::{
        kind: bkind,
        label: lbl,
        sections: [],
        cur_label: lbl,
        cur_stmts: [],
        start_line: line_no,
      })
      continue
    }
    if kw == "else" || kw == "and" || kw == "option" {
      if stack.length() == 0 {
        return Err(ParseError::{ line: line_no, col: 1, message: "unexpected '" + kw + "' outside block" })
      }
      let top = stack[stack.length() - 1]
      top.sections.push(SeqBlockSection::{ label: top.cur_label, stmts: top.cur_stmts })
      top.cur_label = s.slice(kw.length(), s.length()).trim()
      top.cur_stmts = []
      continue
    }
    if kw == "Note" || kw == "note" {
      let colon = find_char_outside_quotes(s, 58, 0)
      if colon < 0 {
        return Err(ParseError::{ line: line_no, col: 1, message: "expected ':' in Note statement" })
      }
      let head = s.slice(kw.length(), colon).trim()
      let body = s.slice(colon + 1, s.length()).trim()
      let mut pos_kind = SeqNotePos::Over
      let mut targets_raw = ""
      if head.starts_with("left of ") {
        pos_kind = SeqNotePos::LeftOf
        targets_raw = head.slice(8, head.length()).trim()
      } else if head.starts_with("right of ") {
        pos_kind = SeqNotePos::RightOf
        targets_raw = head.slice(9, head.length()).trim()
      } else if head.starts_with("over ") {
        pos_kind = SeqNotePos::Over
        targets_raw = head.slice(5, head.length()).trim()
      } else {
        return Err(ParseError::{ line: line_no, col: 1, message: "invalid Note placement: " + head })
      }
      let targets : Array[String] = []
      for p in targets_raw.split(",") {
        let tp = p.trim()
        if tp.length() > 0 {
          seq_ensure_participant(st, tp)
          targets.push(tp)
        }
      }
      seq_emit(root_stmts, stack, SeqStmt::Note(pos_kind, targets, body))
      continue
    }
    if kw == "title" || kw == "title:" || kw == "box" || kw == "create" || kw == "destroy" {
      continue
    }
    // Message statement: from <arrow>[+|-] to : text
    match find_seq_arrow(s) {
      Some(m) => {
        let from_id = s.slice(0, m.pos).trim()
        let after_arrow = s.slice(m.pos + m.len, s.length())
        let colon = find_char_outside_quotes(after_arrow, 58, 0)
        let to_raw = if colon >= 0 { after_arrow.slice(0, colon).trim() } else { after_arrow.trim() }
        let msg_text = if colon >= 0 { after_arrow.slice(colon + 1, after_arrow.length()).trim() } else { "" }
        let mut act = false
        let mut deact = false
        let mut to_id = to_raw
        if to_id.starts_with("+") {
          act = true
          to_id = to_id.slice(1, to_id.length()).trim()
        } else if to_id.starts_with("-") {
          deact = true
          to_id = to_id.slice(1, to_id.length()).trim()
        }
        if from_id.length() == 0 || to_id.length() == 0 {
          return Err(ParseError::{ line: line_no, col: 1, message: "missing sender or receiver in message" })
        }
        seq_ensure_participant(st, from_id)
        seq_ensure_participant(st, to_id)
        seq_emit(root_stmts, stack, SeqStmt::Message(from_id, to_id, m.kind, msg_text, act, deact))
      }
      None =>
      return Err(ParseError::{
        line: line_no,
        col: 1,
        message: "unrecognized sequence diagram statement: " + s,
      })
    }
  }
  if stack.length() > 0 {
    return Err(ParseError::{
      line: stack[stack.length() - 1].start_line,
      col: 1,
      message: "unclosed sequence block (missing 'end')",
    })
  }
  Ok(SequenceDiagram::{
    autonumber: st.autonumber,
    participants: st.participants,
    stmts: root_stmts,
  })
}
