///| State Diagram (`stateDiagram` / `stateDiagram-v2`) parser.

///|
struct MutStateNode {
  id : String
  mut label : String
  mut kind : StateKind
  mut parent : Option[String]
  descriptions : Array[String]
}

///|
struct StateParserCtx {
  mut direction : Direction
  states : Array[MutStateNode]
  state_idx : Map[String, Int]
  transitions : Array[StateTransition]
  notes : Array[StateNote]
  scope_stack : Array[String]
  mut star_seq : Int
}

///|
fn state_cur_parent(ctx : StateParserCtx) -> Option[String] {
  if ctx.scope_stack.length() > 0 {
    Some(ctx.scope_stack[ctx.scope_stack.length() - 1])
  } else {
    None
  }
}

///|
fn state_ensure(ctx : StateParserCtx, id : String, kind : StateKind) -> Int {
  match ctx.state_idx.get(id) {
    Some(idx) => {
      if ctx.states[idx].parent.is_none() && ctx.scope_stack.length() > 0 {
        let p = ctx.scope_stack[ctx.scope_stack.length() - 1]
        if p != id {
          ctx.states[idx].parent = Some(p)
        }
      }
      return idx
    }
    None => ()
  }
  let idx = ctx.states.length()
  ctx.states.push(MutStateNode::{
    id: id,
    label: id,
    kind: kind,
    parent: state_cur_parent(ctx),
    descriptions: [],
  })
  ctx.state_idx.set(id, idx)
  idx
}

///|
fn state_make_star(ctx : StateParserCtx, is_start : Bool) -> String {
  let id = if is_start {
    "__start_" + ctx.star_seq.to_string()
  } else {
    "__end_" + ctx.star_seq.to_string()
  }
  ctx.star_seq = ctx.star_seq + 1
  let kind = if is_start { StateKind::Start } else { StateKind::End }
  let _ = state_ensure(ctx, id, kind)
  id
}

///|
pub fn parse_state(lines : Array[SourceLine], start_idx : Int, version : Int) -> Result[StateDiagram, ParseError] {
  let ctx = StateParserCtx::{
    direction: Direction::TB,
    states: [],
    state_idx: Map::new(),
    transitions: [],
    notes: [],
    scope_stack: [],
    star_seq: 0,
  }
  let mut i = start_idx
  while i < lines.length() {
    let line_no = lines[i].line_no
    let s = strip_line_comment(lines[i].text).trim()
    if s.length() == 0 {
      i = i + 1
      continue
    }
    if s == "}" {
      if ctx.scope_stack.length() == 0 {
        return Err(ParseError::{ line: line_no, col: 1, message: "unexpected '}'" })
      }
      let _ = ctx.scope_stack.pop()
      i = i + 1
      continue
    }
    if s == "--" {
      // Concurrency divider inside composite state
      i = i + 1
      continue
    }
    let words = split_words(s)
    if words.length() == 0 {
      i = i + 1
      continue
    }
    let kw = words[0]
    if kw == "direction" && words.length() >= 2 {
      match parse_direction_opt(words[1]) {
        Some(d) => ctx.direction = d
        None => return Err(ParseError::{ line: line_no, col: 1, message: "invalid direction: " + words[1] })
      }
      i = i + 1
      continue
    }
    if kw == "note" || kw == "Note" {
      let colon = find_char_outside_quotes(s, 58, 0)
      let head = if colon >= 0 { s.slice(kw.length(), colon).trim() } else { s.slice(kw.length(), s.length()).trim() }
      let mut pos_str = "right"
      let mut target = ""
      if head.starts_with("right of ") {
        pos_str = "right"
        target = head.slice(9, head.length()).trim()
      } else if head.starts_with("left of ") {
        pos_str = "left"
        target = head.slice(8, head.length()).trim()
      } else {
        return Err(ParseError::{ line: line_no, col: 1, message: "invalid state note header: " + head })
      }
      if colon >= 0 {
        let txt = s.slice(colon + 1, s.length()).trim()
        ctx.notes.push(StateNote::{ target: target, position: pos_str, text: txt })
        i = i + 1
      } else {
        let sb = StringBuilder::new()
        let mut closed = false
        i = i + 1
        while i < lines.length() {
          let nl = lines[i].text.trim()
          if nl == "end note" {
            closed = true
            i = i + 1
            break
          }
          if sb.length() > 0 {
            sb.write_byte(b'\n')
          }
          sb.write_string(nl)
          i = i + 1
        }
        if !closed {
          return Err(ParseError::{ line: line_no, col: 1, message: "unclosed multiline note" })
        }
        ctx.notes.push(StateNote::{ target: target, position: pos_str, text: sb.to_string() })
      }
      continue
    }
    if kw == "state" {
      let mut rest = s.slice(5, s.length()).trim()
      let mut opens_block = false
      let mut inline_body = ""
      let open_br = find_char_outside_quotes(rest, 123, 0)
      if open_br >= 0 {
        opens_block = true
        let after_br = rest.slice(open_br + 1, rest.length()).trim()
        rest = rest.slice(0, open_br).trim()
        if after_br.ends_with("}") {
          opens_block = false
          inline_body = after_br.slice(0, after_br.length() - 1).trim()
        } else if after_br.length() > 0 {
          inline_body = after_br
        }
      }
      // Check stereotypes <<choice>> / <<fork>> / <<join>>
      let mut stereo = StateKind::Normal
      if rest.contains("<<choice>>") || rest.contains("[[choice]]") {
        stereo = StateKind::Choice
        rest = rest.replace("<<choice>>", "").replace("[[choice]]", "").trim()
      } else if rest.contains("<<fork>>") || rest.contains("[[fork]]") {
        stereo = StateKind::Fork
        rest = rest.replace("<<fork>>", "").replace("[[fork]]", "").trim()
      } else if rest.contains("<<join>>") || rest.contains("[[join]]") {
        stereo = StateKind::Join
        rest = rest.replace("<<join>>", "").replace("[[join]]", "").trim()
      }
      // Check quoted alias: `"Description" as stateId`
      let mut sid = ""
      let mut slabel = ""
      if rest.starts_with("\"") {
        let close_q = find_char_outside_quotes(rest, 34, 1)
        // Actually find closing quote directly
        let mut cq = -1
        for k = 1; k < rest.length(); k = k + 1 {
          if byte_at(rest, k) == 34 && byte_at(rest, k - 1) != 92 {
            cq = k
            break
          }
        }
        if cq < 0 {
          return Err(ParseError::{ line: line_no, col: 1, message: "unclosed quoted state description" })
        }
        slabel = unquote_string(rest.slice(0, cq + 1))
        let after_q = rest.slice(cq + 1, rest.length()).trim()
        if !after_q.starts_with("as ") {
          return Err(ParseError::{ line: line_no, col: 1, message: "expected 'as <stateId>' after quoted state name" })
        }
        sid = after_q.slice(3, after_q.length()).trim()
      } else {
        let rwords = split_words(rest)
        if (opens_block || inline_body.length() > 0) && rwords.length() != 1 {
          return Err(ParseError::{ line: line_no, col: 1, message: "Error: State name must be a single word." })
        }
        if rwords.length() == 0 {
          return Err(ParseError::{ line: line_no, col: 1, message: "missing state name" })
        }
        sid = rwords[0]
        slabel = sid
      }
      let final_kind = if opens_block || inline_body.length() > 0 {
        StateKind::Composite
      } else {
        stereo
      }
      let idx = state_ensure(ctx, sid, final_kind)
      ctx.states[idx].kind = final_kind
      if slabel != sid {
        ctx.states[idx].label = slabel
        ctx.states[idx].descriptions.push(slabel)
      }
      if opens_block {
        ctx.scope_stack.push(sid)
        if inline_body.length() > 0 {
          let _ = state_ensure(ctx, inline_body, StateKind::Normal)
        }
      } else if inline_body.length() > 0 {
        ctx.scope_stack.push(sid)
        let _ = state_ensure(ctx, inline_body, StateKind::Normal)
        let _ = ctx.scope_stack.pop()
      }
      i = i + 1
      continue
    }
    if kw == "classDef" || kw == "class" || kw == "style" {
      i = i + 1
      continue
    }
    // Check transition `from --> to [: label]`
    let arrow_pos = s.index_of("-->")
    if arrow_pos >= 0 {
      let raw_from = s.slice(0, arrow_pos).trim()
      let after_a = s.slice(arrow_pos + 3, s.length()).trim()
      let colon = find_char_outside_quotes(after_a, 58, 0)
      let raw_to = if colon >= 0 { after_a.slice(0, colon).trim() } else { after_a }
      let lbl = if colon >= 0 { after_a.slice(colon + 1, after_a.length()).trim() } else { "" }
      let from_id = if raw_from == "[*]" {
        state_make_star(ctx, true)
      } else {
        let _ = state_ensure(ctx, raw_from, StateKind::Normal)
        raw_from
      }
      let to_id = if raw_to == "[*]" {
        state_make_star(ctx, false)
      } else {
        let _ = state_ensure(ctx, raw_to, StateKind::Normal)
        raw_to
      }
      ctx.transitions.push(StateTransition::{ from: from_id, to: to_id, label: lbl })
      i = i + 1
      continue
    }
    // Check description `id : description`
    let colon = find_char_outside_quotes(s, 58, 0)
    if colon >= 0 {
      let sid = s.slice(0, colon).trim()
      let desc = s.slice(colon + 1, s.length()).trim()
      let idx = state_ensure(ctx, sid, StateKind::Normal)
      ctx.states[idx].descriptions.push(desc)
      i = i + 1
      continue
    }
    // Bare state declaration
    if words.length() == 1 {
      let _ = state_ensure(ctx, words[0], StateKind::Normal)
      i = i + 1
      continue
    }
    return Err(ParseError::{ line: line_no, col: 1, message: "unrecognized state statement: " + s })
  }
  if ctx.scope_stack.length() > 0 {
    return Err(ParseError::{ line: 1, col: 1, message: "unclosed composite state block" })
  }
  let out_states : Array[StateNode] = []
  for st in ctx.states {
    out_states.push(StateNode::{
      id: st.id,
      label: st.label,
      kind: st.kind,
      parent: st.parent,
      descriptions: st.descriptions,
    })
  }
  Ok(StateDiagram::{
    version: version,
    direction: ctx.direction,
    states: out_states,
    transitions: ctx.transitions,
    notes: ctx.notes,
  })
}
