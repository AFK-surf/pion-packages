///| AST and error definitions for Mermaid diagrams.

///|
pub val struct ParseError {
  pub line : Int
  pub col : Int
  pub message : String
}

///|
pub enum Direction {
  TB
  BT
  LR
  RL
}

///|
pub enum NodeShape {
  Rect
  Round
  Stadium
  Subroutine
  Cylinder
  Circle
  DoubleCircle
  Diamond
  Hexagon
  Asymmetric
  Parallelogram
  ParallelogramAlt
  Trapezoid
  TrapezoidAlt
}

///|
pub enum EdgeStroke {
  Solid
  Dotted
  Thick
  Invisible
}

///|
pub enum ArrowHead {
  None
  Arrow
  Circle
  Cross
  Open
}

///|
pub struct FlowNode {
  pub id : String
  pub label : String
  pub shape : NodeShape
  pub classes : Array[String]
  pub style : String
  pub subgraph : Option[String]
}

///|
pub struct FlowEdge {
  pub id : Option[String]
  pub from : String
  pub to : String
  pub label : String
  pub stroke : EdgeStroke
  pub start_arrow : ArrowHead
  pub end_arrow : ArrowHead
  pub minlen : Int
}

///|
pub struct FlowSubgraph {
  pub id : String
  pub title : String
  pub parent : Option[String]
  pub direction : Option[Direction]
  pub node_ids : Array[String]
}

///|
pub struct FlowClassDef {
  pub name : String
  pub style : String
}

///|
pub struct FlowchartDiagram {
  pub direction : Direction
  pub nodes : Array[FlowNode]
  pub edges : Array[FlowEdge]
  pub subgraphs : Array[FlowSubgraph]
  pub class_defs : Array[FlowClassDef]
}

///|
pub enum SeqParticipantKind {
  Participant
  Actor
}

///|
pub struct SeqParticipant {
  pub id : String
  pub alias : String
  pub kind : SeqParticipantKind
}

///|
pub enum SeqArrowKind {
  SolidLine
  DottedLine
  SolidArrow
  DottedArrow
  SolidCross
  DottedCross
  SolidAsync
  DottedAsync
}

///|
pub enum SeqNotePos {
  LeftOf
  RightOf
  Over
}

///|
pub enum SeqBlockKind {
  Loop
  Alt
  Opt
  Par
  Critical
  Break
  Rect
}

///|
pub enum SeqStmt {
  Message(String, String, SeqArrowKind, String, Bool, Bool)
  Activate(String)
  Deactivate(String)
  Note(SeqNotePos, Array[String], String)
  Block(SeqBlockKind, String, Array[SeqBlockSection])
}

///|
pub struct SeqBlockSection {
  pub label : String
  pub stmts : Array[SeqStmt]
}

///|
pub struct SequenceDiagram {
  pub autonumber : Bool
  pub participants : Array[SeqParticipant]
  pub stmts : Array[SeqStmt]
}

///|
pub enum StateKind {
  Normal
  Start
  End
  Choice
  Fork
  Join
  Composite
}

///|
pub struct StateNode {
  pub id : String
  pub label : String
  pub kind : StateKind
  pub parent : Option[String]
  pub descriptions : Array[String]
}

///|
pub struct StateTransition {
  pub from : String
  pub to : String
  pub label : String
}

///|
pub struct StateNote {
  pub target : String
  pub position : String
  pub text : String
}

///|
pub struct StateDiagram {
  pub version : Int
  pub direction : Direction
  pub states : Array[StateNode]
  pub transitions : Array[StateTransition]
  pub notes : Array[StateNote]
}

///|
pub enum ClassRelationKind {
  Inheritance
  Composition
  Aggregation
  Association
  Link
  Dependency
  Realization
  Lollipop
}

///|
pub struct ClassMember {
  pub visibility : String
  pub text : String
  pub is_method : Bool
}

///|
pub struct ClassNode {
  pub id : String
  pub label : String
  pub annotation : String
  pub generic : String
  pub namespace_name : Option[String]
  pub members : Array[ClassMember]
}

///|
pub struct ClassRelation {
  pub from : String
  pub to : String
  pub kind : ClassRelationKind
  pub label : String
  pub from_card : String
  pub to_card : String
}

///|
pub struct ClassDiagram {
  pub direction : Direction
  pub classes : Array[ClassNode]
  pub relations : Array[ClassRelation]
}

///|
pub enum ErCardinality {
  ZeroOrOne
  OnlyOne
  ZeroOrMore
  OneOrMore
}

///|
pub struct ErAttribute {
  pub attr_type : String
  pub name : String
  pub keys : Array[String]
  pub comment : String
}

///|
pub struct ErEntity {
  pub id : String
  pub alias : String
  pub attributes : Array[ErAttribute]
}

///|
pub struct ErRelation {
  pub from : String
  pub to : String
  pub from_card : ErCardinality
  pub to_card : ErCardinality
  pub identifying : Bool
  pub label : String
}

///|
pub struct ErDiagram {
  pub direction : Direction
  pub entities : Array[ErEntity]
  pub relations : Array[ErRelation]
}

///|
pub enum Diagram {
  Flowchart(FlowchartDiagram)
  Sequence(SequenceDiagram)
  State(StateDiagram)
  Class(ClassDiagram)
  Er(ErDiagram)
}
