///| Canonical graph topology JSON serializer for 100% SHA-256 parity verification.

///|
fn collect_seq_edges(stmts : Array[SeqStmt], out : Array[String]) -> Unit {
  for stmt in stmts {
    match stmt {
      SeqStmt::Message(from_id, to_id, _, text, _, _) => {
        let sb = StringBuilder::new()
        sb.write_string("{\"from\":")
        sb.write_string(json_escape(from_id))
        sb.write_string(",\"to\":")
        sb.write_string(json_escape(to_id))
        sb.write_string(",\"label\":")
        sb.write_string(json_escape(text))
        sb.write_string("}")
        out.push(sb.to_string())
      }
      SeqStmt::Block(_, _, secs) => {
        for sec in secs {
          collect_seq_edges(sec.stmts, out)
        }
      }
      _ => ()
    }
  }
}

///|
fn emit_json_str_array(sb : StringBuilder, items : Array[String]) -> Unit {
  sb.write_byte(b'[')
  for i = 0; i < items.length(); i = i + 1 {
    if i > 0 {
      sb.write_byte(b',')
    }
    sb.write_string(items[i])
  }
  sb.write_byte(b']')
}

///|
pub fn canonical_graph_json(d : Diagram) -> String {
  let sb = StringBuilder::new()
  match d {
    Diagram::Flowchart(fc) => {
      let node_strs : Array[String] = []
      for n in fc.nodes {
        let nsb = StringBuilder::new()
        nsb.write_string("{\"id\":")
        nsb.write_string(json_escape(n.id))
        nsb.write_string(",\"label\":")
        nsb.write_string(json_escape(n.label))
        nsb.write_string("}")
        node_strs.push(nsb.to_string())
      }
      node_strs.sort()
      let edge_strs : Array[String] = []
      for e in fc.edges {
        let esb = StringBuilder::new()
        esb.write_string("{\"from\":")
        esb.write_string(json_escape(e.from))
        esb.write_string(",\"to\":")
        esb.write_string(json_escape(e.to))
        esb.write_string(",\"label\":")
        esb.write_string(json_escape(e.label))
        esb.write_string("}")
        edge_strs.push(esb.to_string())
      }
      edge_strs.sort()
      sb.write_string("{\"kind\":\"flowchart\",\"direction\":")
      sb.write_string(json_escape(direction_to_string(fc.direction)))
      sb.write_string(",\"nodes\":")
      emit_json_str_array(sb, node_strs)
      sb.write_string(",\"edges\":")
      emit_json_str_array(sb, edge_strs)
      sb.write_byte(b'}')
    }
    Diagram::Sequence(sd) => {
      let node_strs : Array[String] = []
      for p in sd.participants {
        let nsb = StringBuilder::new()
        nsb.write_string("{\"id\":")
        nsb.write_string(json_escape(p.id))
        nsb.write_string(",\"label\":")
        nsb.write_string(json_escape(p.alias))
        nsb.write_string("}")
        node_strs.push(nsb.to_string())
      }
      node_strs.sort()
      let edge_strs : Array[String] = []
      collect_seq_edges(sd.stmts, edge_strs)
      edge_strs.sort()
      sb.write_string("{\"kind\":\"sequence\",\"direction\":\"LR\",\"nodes\":")
      emit_json_str_array(sb, node_strs)
      sb.write_string(",\"edges\":")
      emit_json_str_array(sb, edge_strs)
      sb.write_byte(b'}')
    }
    Diagram::State(st) => {
      let node_strs : Array[String] = []
      for s in st.states {
        let nsb = StringBuilder::new()
        nsb.write_string("{\"id\":")
        nsb.write_string(json_escape(s.id))
        nsb.write_string(",\"label\":")
        nsb.write_string(json_escape(s.label))
        nsb.write_string("}")
        node_strs.push(nsb.to_string())
      }
      node_strs.sort()
      let edge_strs : Array[String] = []
      for t in st.transitions {
        let esb = StringBuilder::new()
        esb.write_string("{\"from\":")
        esb.write_string(json_escape(t.from))
        esb.write_string(",\"to\":")
        esb.write_string(json_escape(t.to))
        esb.write_string(",\"label\":")
        esb.write_string(json_escape(t.label))
        esb.write_string("}")
        edge_strs.push(esb.to_string())
      }
      edge_strs.sort()
      sb.write_string("{\"kind\":\"state\",\"direction\":")
      sb.write_string(json_escape(direction_to_string(st.direction)))
      sb.write_string(",\"nodes\":")
      emit_json_str_array(sb, node_strs)
      sb.write_string(",\"edges\":")
      emit_json_str_array(sb, edge_strs)
      sb.write_byte(b'}')
    }
    Diagram::Class(cd) => {
      let node_strs : Array[String] = []
      for c in cd.classes {
        let nsb = StringBuilder::new()
        nsb.write_string("{\"id\":")
        nsb.write_string(json_escape(c.id))
        nsb.write_string(",\"label\":")
        nsb.write_string(json_escape(c.label))
        nsb.write_string("}")
        node_strs.push(nsb.to_string())
      }
      node_strs.sort()
      let edge_strs : Array[String] = []
      for r in cd.relations {
        let esb = StringBuilder::new()
        esb.write_string("{\"from\":")
        esb.write_string(json_escape(r.from))
        esb.write_string(",\"to\":")
        esb.write_string(json_escape(r.to))
        esb.write_string(",\"label\":")
        esb.write_string(json_escape(r.label))
        esb.write_string("}")
        edge_strs.push(esb.to_string())
      }
      edge_strs.sort()
      sb.write_string("{\"kind\":\"class\",\"direction\":")
      sb.write_string(json_escape(direction_to_string(cd.direction)))
      sb.write_string(",\"nodes\":")
      emit_json_str_array(sb, node_strs)
      sb.write_string(",\"edges\":")
      emit_json_str_array(sb, edge_strs)
      sb.write_byte(b'}')
    }
    Diagram::Er(ed) => {
      let node_strs : Array[String] = []
      for e in ed.entities {
        let nsb = StringBuilder::new()
        nsb.write_string("{\"id\":")
        nsb.write_string(json_escape(e.id))
        nsb.write_string(",\"label\":")
        nsb.write_string(json_escape(if e.alias.length() > 0 { e.alias } else { e.id }))
        nsb.write_string("}")
        node_strs.push(nsb.to_string())
      }
      node_strs.sort()
      let edge_strs : Array[String] = []
      for r in ed.relations {
        let esb = StringBuilder::new()
        esb.write_string("{\"from\":")
        esb.write_string(json_escape(r.from))
        esb.write_string(",\"to\":")
        esb.write_string(json_escape(r.to))
        esb.write_string(",\"label\":")
        esb.write_string(json_escape(r.label))
        esb.write_string("}")
        edge_strs.push(esb.to_string())
      }
      edge_strs.sort()
      sb.write_string("{\"kind\":\"er\",\"direction\":")
      sb.write_string(json_escape(direction_to_string(ed.direction)))
      sb.write_string(",\"nodes\":")
      emit_json_str_array(sb, node_strs)
      sb.write_string(",\"edges\":")
      emit_json_str_array(sb, edge_strs)
      sb.write_byte(b'}')
    }
  }
  sb.to_string()
}
