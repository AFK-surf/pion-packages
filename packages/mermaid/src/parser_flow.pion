///| Flowchart (`flowchart` / `graph`) parser.

///|
struct MutFlowNode {
  id : String
  mut label : String
  mut shape : NodeShape
  mut shape_explicit : Bool
  classes : Array[String]
  mut style : String
  mut subgraph : Option[String]
}

///|
struct MutFlowSubgraph {
  id : String
  title : String
  parent : Option[String]
  mut direction : Option[Direction]
  node_ids : Array[String]
}

///|
struct FlowState {
  mut direction : Direction
  nodes : Array[MutFlowNode]
  node_index : Map[String, Int]
  edges : Array[FlowEdge]
  subgraphs : Array[MutFlowSubgraph]
  sg_stack : Array[Int]
  subgraph_ids : Map[String, Bool]
  edge_ids : Map[String, Bool]
  class_defs : Array[FlowClassDef]
}

///|
fn flow_ensure_node(st : FlowState, id : String) -> Int {
  match st.node_index.get(id) {
    Some(idx) => {
      if st.sg_stack.length() > 0 && st.nodes[idx].subgraph.is_none() {
        let sg_idx = st.sg_stack[st.sg_stack.length() - 1]
        let sg_id = st.subgraphs[sg_idx].id
        st.nodes[idx].subgraph = Some(sg_id)
        st.subgraphs[sg_idx].node_ids.push(id)
      }
      return idx
    }
    None => ()
  }
  let idx = st.nodes.length()
  let mut sg_opt : Option[String] = None
  if st.sg_stack.length() > 0 {
    let sg_idx = st.sg_stack[st.sg_stack.length() - 1]
    let sg_id = st.subgraphs[sg_idx].id
    sg_opt = Some(sg_id)
    st.subgraphs[sg_idx].node_ids.push(id)
  }
  st.nodes.push(MutFlowNode::{
    id: id,
    label: id,
    shape: NodeShape::Rect,
    shape_explicit: false,
    classes: [],
    style: "",
    subgraph: sg_opt,
  })
  st.node_index.set(id, idx)
  idx
}

///|
fn flow_add_class(node : MutFlowNode, cls : String) -> Unit {
  for existing in node.classes {
    if existing == cls {
      return
    }
  }
  node.classes.push(cls)
}

///|
fn scan_balanced(s : String, open_pos : Int, close_str : String) -> Int {
  let n = s.length()
  let cn = close_str.length()
  let mut in_q = false
  let mut esc = false
  let mut i = open_pos
  while i + cn <= n {
    let b = byte_at(s, i)
    if esc {
      esc = false
      i = i + 1
      continue
    }
    if b == 92 && in_q {
      esc = true
      i = i + 1
      continue
    }
    if b == 34 {
      in_q = !in_q
      i = i + 1
      continue
    }
    if !in_q && s.slice(i, i + cn) == close_str {
      return i
    }
    i = i + 1
  }
  -1
}

///|
struct ParsedNodeRef {
  id : String
  next_pos : Int
}

///|
fn parse_v11_shape_name(name : String) -> NodeShape {
  let w = name.trim()
  if w == "cyl" || w == "cylinder" || w == "db" || w == "database" {
    NodeShape::Cylinder
  } else if w == "diam" || w == "diamond" || w == "decision" {
    NodeShape::Diamond
  } else if w == "rounded" || w == "round" || w == "event" {
    NodeShape::Round
  } else if w == "stadium" || w == "pill" || w == "terminal" {
    NodeShape::Stadium
  } else if w == "subproc" || w == "subroutine" || w == "fr-rect" {
    NodeShape::Subroutine
  } else if w == "circ" || w == "circle" || w == "start" {
    NodeShape::Circle
  } else if w == "dbl-circ" || w == "double-circle" || w == "stop" {
    NodeShape::DoubleCircle
  } else if w == "hex" || w == "hexagon" || w == "prepare" {
    NodeShape::Hexagon
  } else if w == "lean-r" || w == "parallelogram" {
    NodeShape::Parallelogram
  } else if w == "lean-l" || w == "parallelogram-alt" {
    NodeShape::ParallelogramAlt
  } else if w == "trap-b" || w == "trapezoid" {
    NodeShape::Trapezoid
  } else if w == "trap-t" || w == "trapezoid-alt" {
    NodeShape::TrapezoidAlt
  } else if w == "odd" || w == "flag" || w == "asymmetric" {
    NodeShape::Asymmetric
  } else {
    NodeShape::Rect
  }
}

///|
fn apply_v11_node_attrs(node : MutFlowNode, body : String) -> Unit {
  // Parse comma-separated key: value pairs respecting quotes
  let n = body.length()
  let mut start = 0
  let mut in_q = false
  let mut esc = false
  for i = 0; i <= n; i = i + 1 {
    if i < n {
      let b = byte_at(body, i)
      if esc {
        esc = false
        continue
      }
      if b == 92 && in_q {
        esc = true
        continue
      }
      if b == 34 {
        in_q = !in_q
        continue
      }
      if in_q || b != 44 {
        continue
      }
    }
    let part = body.slice(start, i).trim()
    start = i + 1
    let colon = find_char_outside_quotes(part, 58, 0)
    if colon > 0 {
      let k = unquote_string(part.slice(0, colon).trim())
      let v = unquote_string(part.slice(colon + 1, part.length()).trim())
      if k == "shape" {
        node.shape = parse_v11_shape_name(v)
        node.shape_explicit = true
      } else if k == "label" {
        node.label = v
      }
    }
  }
}

///|
fn has_unquoted_parens(raw : String) -> Bool {
  let t = raw.trim()
  if t.length() >= 2 && byte_at(t, 0) == 34 && byte_at(t, t.length() - 1) == 34 {
    return false
  }
  let mut in_q = false
  let mut esc = false
  for i = 0; i < t.length(); i = i + 1 {
    let b = byte_at(t, i)
    if esc {
      esc = false
      continue
    }
    if b == 92 && in_q {
      esc = true
      continue
    }
    if b == 34 {
      in_q = !in_q
      continue
    }
    if !in_q && (b == 40 || b == 41) {
      return true
    }
  }
  false
}

///|
fn parse_flow_node_ref(st : FlowState, s : String, pos_in : Int, line_no : Int) -> Result[ParsedNodeRef, ParseError] {
  let n = s.length()
  let mut i = pos_in
  while i < n && is_space_byte(byte_at(s, i)) {
    i = i + 1
  }
  if i >= n {
    return Err(ParseError::{ line: line_no, col: i + 1, message: "expected node identifier" })
  }
  let id_start = i
  while i < n {
    let b = byte_at(s, i)
    if is_alpha_byte(b) || is_digit_byte(b) || b == 95 || b == 46 || b >= 128 {
      i = i + 1
    } else if b == 45 {
      // Allow single hyphen inside node ID only if not starting an arrow like -- or -. or ->
      if i + 1 < n {
        let nb = byte_at(s, i + 1)
        if nb == 45 || nb == 46 || nb == 62 || nb == 120 || nb == 111 {
          break
        }
        i = i + 1
      } else {
        break
      }
    } else {
      break
    }
  }
  if i == id_start {
    return Err(ParseError::{ line: line_no, col: i + 1, message: "invalid node identifier" })
  }
  let id = s.slice(id_start, i)
  // Check for v11 @{ shape: ..., label: ... } syntax
  if i + 2 <= n && s.slice(i, i + 2) == "@{" {
    let close_pos = scan_balanced(s, i + 2, "}")
    if close_pos < 0 {
      return Err(ParseError::{ line: line_no, col: i + 1, message: "unclosed @{ ... } node attribute" })
    }
    let node_idx = flow_ensure_node(st, id)
    apply_v11_node_attrs(st.nodes[node_idx], s.slice(i + 2, close_pos))
    i = close_pos + 1
    while i + 3 <= n && s.slice(i, i + 3) == ":::" {
      i = i + 3
      let cstart = i
      while i < n && is_ident_byte(byte_at(s, i)) {
        i = i + 1
      }
      if i > cstart {
        flow_add_class(st.nodes[node_idx], s.slice(cstart, i))
      }
    }
    return Ok(ParsedNodeRef::{ id: id, next_pos: i })
  }
  // Check if this is a bare reference to an existing subgraph ID
  let has_shape_char = i < n && (byte_at(s, i) == 91 || byte_at(s, i) == 40 || byte_at(s, i) == 123 || byte_at(s, i) == 62)
  if !has_shape_char && st.subgraph_ids.get(id).is_some() {
    while i + 3 <= n && s.slice(i, i + 3) == ":::" {
      i = i + 3
      while i < n && is_ident_byte(byte_at(s, i)) {
        i = i + 1
      }
    }
    return Ok(ParsedNodeRef::{ id: id, next_pos: i })
  }
  let node_idx = flow_ensure_node(st, id)
  // Check for shape brackets immediately following id
  if i < n {
    let mut shape_opt : Option[NodeShape] = None
    let mut close_delim = ""
    let mut inner_start = i
    if i + 3 <= n && s.slice(i, i + 3) == "(((" {
      shape_opt = Some(NodeShape::DoubleCircle)
      close_delim = ")))"
      inner_start = i + 3
    } else if i + 2 <= n && s.slice(i, i + 2) == "((" {
      shape_opt = Some(NodeShape::Circle)
      close_delim = "))"
      inner_start = i + 2
    } else if i + 2 <= n && s.slice(i, i + 2) == "([" {
      shape_opt = Some(NodeShape::Stadium)
      close_delim = "])"
      inner_start = i + 2
    } else if i + 2 <= n && s.slice(i, i + 2) == "[[" {
      shape_opt = Some(NodeShape::Subroutine)
      close_delim = "]]"
      inner_start = i + 2
    } else if i + 2 <= n && s.slice(i, i + 2) == "[(" {
      shape_opt = Some(NodeShape::Cylinder)
      close_delim = ")]"
      inner_start = i + 2
    } else if i + 2 <= n && s.slice(i, i + 2) == "{{" {
      shape_opt = Some(NodeShape::Hexagon)
      close_delim = "}}"
      inner_start = i + 2
    } else if i + 2 <= n && s.slice(i, i + 2) == "[/" {
      // Could be parallelogram [/ /] or trapezoid [/ \]
      let c_para = scan_balanced(s, i + 2, "/]")
      let c_trap = scan_balanced(s, i + 2, "\\]")
      if c_para >= 0 && (c_trap < 0 || c_para < c_trap) {
        shape_opt = Some(NodeShape::Parallelogram)
        close_delim = "/]"
        inner_start = i + 2
      } else if c_trap >= 0 {
        shape_opt = Some(NodeShape::Trapezoid)
        close_delim = "\\]"
        inner_start = i + 2
      } else {
        return Err(ParseError::{ line: line_no, col: i + 1, message: "unclosed [/ shape" })
      }
    } else if i + 2 <= n && s.slice(i, i + 2) == "[\\" {
      let c_para = scan_balanced(s, i + 2, "\\]")
      let c_trap = scan_balanced(s, i + 2, "/]")
      if c_para >= 0 && (c_trap < 0 || c_para < c_trap) {
        shape_opt = Some(NodeShape::ParallelogramAlt)
        close_delim = "\\]"
        inner_start = i + 2
      } else if c_trap >= 0 {
        shape_opt = Some(NodeShape::TrapezoidAlt)
        close_delim = "/]"
        inner_start = i + 2
      } else {
        return Err(ParseError::{ line: line_no, col: i + 1, message: "unclosed [\\ shape" })
      }
    } else if byte_at(s, i) == 91 {
      shape_opt = Some(NodeShape::Rect)
      close_delim = "]"
      inner_start = i + 1
    } else if byte_at(s, i) == 40 {
      shape_opt = Some(NodeShape::Round)
      close_delim = ")"
      inner_start = i + 1
    } else if byte_at(s, i) == 123 {
      shape_opt = Some(NodeShape::Diamond)
      close_delim = "}"
      inner_start = i + 1
    } else if byte_at(s, i) == 62 {
      shape_opt = Some(NodeShape::Asymmetric)
      close_delim = "]"
      inner_start = i + 1
    }
    match shape_opt {
      Some(sh) => {
        let close_pos = scan_balanced(s, inner_start, close_delim)
        if close_pos < 0 {
          return Err(ParseError::{
            line: line_no,
            col: i + 1,
            message: "unclosed node shape delimiter " + close_delim,
          })
        }
        let raw_lbl = s.slice(inner_start, close_pos)
        if sh == NodeShape::Rect && has_unquoted_parens(raw_lbl) {
          return Err(ParseError::{
            line: line_no,
            col: inner_start + 1,
            message: "unexpected '(' or ')' in unquoted bracket label",
          })
        }
        st.nodes[node_idx].shape = sh
        st.nodes[node_idx].shape_explicit = true
        st.nodes[node_idx].label = unquote_string(raw_lbl)
        i = close_pos + close_delim.length()
      }
      None => ()
    }
  }
  // Optional :::className shorthand
  while i + 3 <= n && s.slice(i, i + 3) == ":::" {
    i = i + 3
    let cstart = i
    while i < n && is_ident_byte(byte_at(s, i)) {
      i = i + 1
    }
    if i > cstart {
      flow_add_class(st.nodes[node_idx], s.slice(cstart, i))
    }
  }
  Ok(ParsedNodeRef::{ id: id, next_pos: i })
}

///|
struct ParsedEdgeOp {
  edge_id : Option[String]
  stroke : EdgeStroke
  start_arrow : ArrowHead
  end_arrow : ArrowHead
  label : String
  minlen : Int
  next_pos : Int
}

///|
fn is_edge_start(s : String, pos : Int) -> Bool {
  let n = s.length()
  if pos >= n {
    return false
  }
  let b = byte_at(s, pos)
  if b == 45 || b == 61 || b == 126 {
    if pos + 1 < n {
      let nb = byte_at(s, pos + 1)
      return nb == 45 || nb == 46 || nb == 61 || nb == 126
    }
    return false
  }
  if b == 60 || b == 111 || b == 120 {
    if pos + 2 < n {
      let b1 = byte_at(s, pos + 1)
      let b2 = byte_at(s, pos + 2)
      return (b1 == 45 && (b2 == 45 || b2 == 46)) || (b1 == 61 && b2 == 61)
    }
  }
  false
}

///|
fn parse_edge_op(s : String, pos_in : Int, line_no : Int) -> Result[Option[ParsedEdgeOp], ParseError] {
  let n = s.length()
  let mut i = pos_in
  while i < n && is_space_byte(byte_at(s, i)) {
    i = i + 1
  }
  if i >= n {
    return Ok(None)
  }
  // Check optional edge id: `id@<arrow>`
  let mut edge_id : Option[String] = None
  let saved = i
  if is_alpha_byte(byte_at(s, i)) || byte_at(s, i) == 95 {
    let mut k = i
    while k < n && is_ident_byte(byte_at(s, k)) {
      k = k + 1
    }
    if k < n && byte_at(s, k) == 64 && is_edge_start(s, k + 1) {
      edge_id = Some(s.slice(i, k))
      i = k + 1
    } else {
      i = saved
    }
  }
  if !is_edge_start(s, i) {
    return Ok(None)
  }
  // Invisible link ~~~
  if byte_at(s, i) == 126 {
    let start = i
    while i < n && byte_at(s, i) == 126 {
      i = i + 1
    }
    let cnt = i - start
    if cnt < 3 {
      return Err(ParseError::{ line: line_no, col: start + 1, message: "expected ~~~" })
    }
    return Ok(Some(ParsedEdgeOp::{
      edge_id: edge_id,
      stroke: EdgeStroke::Invisible,
      start_arrow: ArrowHead::None,
      end_arrow: ArrowHead::None,
      label: "",
      minlen: cnt - 2,
      next_pos: i,
    }))
  }
  // Optional start arrow
  let mut start_arrow = ArrowHead::None
  let b0 = byte_at(s, i)
  if b0 == 60 {
    start_arrow = ArrowHead::Arrow
    i = i + 1
  } else if b0 == 111 {
    start_arrow = ArrowHead::Circle
    i = i + 1
  } else if b0 == 120 {
    start_arrow = ArrowHead::Cross
    i = i + 1
  }
  // Determine stroke and consume first segment
  let mut stroke = EdgeStroke::Solid
  let mut dashes = 0
  if byte_at(s, i) == 61 {
    stroke = EdgeStroke::Thick
    while i < n && byte_at(s, i) == 61 {
      dashes = dashes + 1
      i = i + 1
    }
  } else if i + 1 < n && byte_at(s, i) == 45 && byte_at(s, i + 1) == 46 {
    stroke = EdgeStroke::Dotted
    i = i + 1
    while i < n && (byte_at(s, i) == 46 || byte_at(s, i) == 45) {
      if byte_at(s, i) == 46 {
        dashes = dashes + 1
      }
      i = i + 1
    }
  } else {
    stroke = EdgeStroke::Solid
    while i < n && byte_at(s, i) == 45 {
      dashes = dashes + 1
      i = i + 1
    }
  }
  // Check for inline text: `-- text -->` / `--text-->` / `== text ==>` / `-. text .->`
  let mut label = ""
  let mut end_arrow = ArrowHead::None
  if i < n {
    let nb = byte_at(s, i)
    let is_end_arrow_or_pipe = nb == 62 || nb == 111 || nb == 120 || nb == 124
    let can_inline = is_space_byte(nb) ||
    (!is_end_arrow_or_pipe &&
      ((stroke == EdgeStroke::Solid && dashes == 2) ||
        (stroke == EdgeStroke::Thick && dashes == 2) ||
        stroke == EdgeStroke::Dotted))
    if can_inline {
      let after_sp = i
      let had_space = is_space_byte(nb)
      let mut j = i
      while j < n && is_space_byte(byte_at(s, j)) {
        j = j + 1
      }
      let close_pat = match stroke {
        EdgeStroke::Thick => "=="
        EdgeStroke::Dotted => ".-"
        _ => "--"
      }
      let found_close = find_inline_edge_close(s, j, close_pat, had_space)
      if found_close >= 0 {
        label = unquote_string(s.slice(j, found_close).trim())
        i = found_close
        while i < n && (byte_at(s, i) == 45 || byte_at(s, i) == 61 || byte_at(s, i) == 46) {
          i = i + 1
        }
      } else {
        i = after_sp
      }
    }
  }
  // End arrow
  if i < n {
    let eb = byte_at(s, i)
    if eb == 62 {
      end_arrow = ArrowHead::Arrow
      i = i + 1
    } else if eb == 111 {
      end_arrow = ArrowHead::Circle
      i = i + 1
    } else if eb == 120 {
      end_arrow = ArrowHead::Cross
      i = i + 1
    }
  }
  // Optional pipe label `|text|`
  let mut k = i
  while k < n && is_space_byte(byte_at(s, k)) {
    k = k + 1
  }
  if k < n && byte_at(s, k) == 124 {
    let end_pipe = find_char_outside_quotes(s, 124, k + 1)
    if end_pipe < 0 {
      return Err(ParseError::{ line: line_no, col: k + 1, message: "unclosed edge label |" })
    }
    label = unquote_string(s.slice(k + 1, end_pipe).trim())
    i = end_pipe + 1
  }
  let minlen = match stroke {
    EdgeStroke::Dotted => if dashes > 1 { dashes } else { 1 }
    EdgeStroke::Thick => if dashes > 2 { dashes - 1 } else { 1 }
    _ => if dashes > 2 { dashes - 1 } else { 1 }
  }
  Ok(Some(ParsedEdgeOp::{
    edge_id: edge_id,
    stroke: stroke,
    start_arrow: start_arrow,
    end_arrow: end_arrow,
    label: label,
    minlen: minlen,
    next_pos: i,
  }))
}

///|
fn find_inline_edge_close(s : String, start : Int, pat : String, require_space : Bool) -> Int {
  let n = s.length()
  let pn = pat.length()
  let mut in_q = false
  let mut esc = false
  let mut i = start
  while i + pn <= n {
    let b = byte_at(s, i)
    if esc {
      esc = false
      i = i + 1
      continue
    }
    if b == 92 && in_q {
      esc = true
      i = i + 1
      continue
    }
    if b == 34 {
      in_q = !in_q
      i = i + 1
      continue
    }
    if !in_q && s.slice(i, i + pn) == pat {
      if i > start {
        if is_space_byte(byte_at(s, i - 1)) {
          return i
        }
        if !require_space {
          // For `A--text-->B`, accept closing `--` / `==` / `.-` when followed by `>`, `o`, `x`, `-`, `=`
          let mut k = i + pn
          while k < n && (byte_at(s, k) == 45 || byte_at(s, k) == 61 || byte_at(s, k) == 46) {
            k = k + 1
          }
          if k < n {
            let eb = byte_at(s, k)
            if eb == 62 || eb == 111 || eb == 120 || k > i + pn {
              return i
            }
          }
        }
      }
    }
    i = i + 1
  }
  -1
}

///|
fn parse_node_group(st : FlowState, s : String, pos_in : Int, line_no : Int) -> Result[(Array[String], Int), ParseError] {
  let ids : Array[String] = []
  let first = parse_flow_node_ref(st, s, pos_in, line_no)?
  ids.push(first.id)
  let mut i = first.next_pos
  let n = s.length()
  while i < n {
    let mut k = i
    while k < n && is_space_byte(byte_at(s, k)) {
      k = k + 1
    }
    if k < n && byte_at(s, k) == 38 {
      let nxt = parse_flow_node_ref(st, s, k + 1, line_no)?
      ids.push(nxt.id)
      i = nxt.next_pos
    } else {
      break
    }
  }
  Ok((ids, i))
}

///|
fn parse_flow_stmt(st : FlowState, stmt : String, line_no : Int) -> Result[Unit, ParseError] {
  let s = stmt.trim()
  if s.length() == 0 {
    return Ok(())
  }
  let words = split_words(s)
  if words.length() == 0 {
    return Ok(())
  }
  let kw = words[0]
  if kw == "end" && words.length() == 1 {
    if st.sg_stack.length() == 0 {
      return Err(ParseError::{ line: line_no, col: 1, message: "unexpected 'end' without matching subgraph" })
    }
    let _ = st.sg_stack.pop()
    return Ok(())
  }
  if kw == "subgraph" {
    let rest = s.slice(8, s.length()).trim()
    let mut sg_id = "subGraph" + st.subgraphs.length().to_string()
    let mut sg_title = ""
    if rest.length() > 0 {
      let br = find_char_outside_quotes(rest, 91, 0)
      if br >= 0 {
        let close_br = scan_balanced(rest, br + 1, "]")
        if close_br < 0 {
          return Err(ParseError::{ line: line_no, col: 1, message: "unclosed subgraph title [" })
        }
        let left = rest.slice(0, br).trim()
        if left.length() > 0 {
          sg_id = left
        }
        sg_title = unquote_string(rest.slice(br + 1, close_br).trim())
      } else if rest.starts_with("\"") {
        sg_title = unquote_string(rest)
      } else {
        let unq = unquote_string(rest)
        sg_id = unq
        sg_title = unq
      }
    }
    let parent_opt : Option[String] = if st.sg_stack.length() > 0 {
      Some(st.subgraphs[st.sg_stack[st.sg_stack.length() - 1]].id)
    } else {
      None
    }
    let sg_idx = st.subgraphs.length()
    st.subgraphs.push(MutFlowSubgraph::{
      id: sg_id,
      title: sg_title,
      parent: parent_opt,
      direction: None,
      node_ids: [],
    })
    st.subgraph_ids.set(sg_id, true)
    st.sg_stack.push(sg_idx)
    return Ok(())
  }
  if kw == "direction" && words.length() >= 2 {
    match parse_direction_opt(words[1]) {
      Some(d) => {
        if st.sg_stack.length() > 0 {
          let sg_idx = st.sg_stack[st.sg_stack.length() - 1]
          st.subgraphs[sg_idx].direction = Some(d)
        } else {
          st.direction = d
        }
        return Ok(())
      }
      None =>
      return Err(ParseError::{ line: line_no, col: 1, message: "invalid direction: " + words[1] })
    }
  }
  if kw == "classDef" && words.length() >= 3 {
    let raw_names = words[1]
    let pos_name = s.index_of(raw_names)
    let style_str = if pos_name >= 0 {
      s.slice(pos_name + raw_names.length(), s.length()).trim()
    } else {
      ""
    }
    for part in raw_names.split(",") {
      let cname = part.trim()
      if cname.length() > 0 {
        st.class_defs.push(FlowClassDef::{ name: cname, style: style_str })
      }
    }
    return Ok(())
  }
  if kw == "class" && words.length() >= 3 {
    let target_list = words[1].split(",")
    let cls_name = words[2]
    for raw_id in target_list {
      let tid = raw_id.trim()
      if tid.length() > 0 {
        let nidx = flow_ensure_node(st, tid)
        flow_add_class(st.nodes[nidx], cls_name)
      }
    }
    return Ok(())
  }
  if kw == "style" && words.length() >= 3 {
    let tid = words[1]
    let nidx = flow_ensure_node(st, tid)
    let pos_id = s.index_of(tid)
    if pos_id >= 0 {
      st.nodes[nidx].style = s.slice(pos_id + tid.length(), s.length()).trim()
    }
    return Ok(())
  }
  if kw == "linkStyle" || kw == "click" || kw == "accTitle:" || kw == "accDescr:" || kw == "accTitle" || kw == "accDescr" {
    return Ok(())
  }
  // Standalone edge attribute statement: `e1@{ animate: true }`
  let at_pos = s.index_of("@{")
  if at_pos > 0 {
    let pref = s.slice(0, at_pos).trim()
    if st.edge_ids.get(pref).is_some() && s.ends_with("}") {
      return Ok(())
    }
  }
  // Node / edge chain statement
  let (left_init, pos_init) = parse_node_group(st, s, 0, line_no)?
  let mut left_ids = left_init
  let mut pos = pos_init
  let n = s.length()
  while pos < n {
    while pos < n && is_space_byte(byte_at(s, pos)) {
      pos = pos + 1
    }
    if pos >= n {
      break
    }
    let op_opt = parse_edge_op(s, pos, line_no)?
    match op_opt {
      None =>
      return Err(ParseError::{
        line: line_no,
        col: pos + 1,
        message: "unexpected token in flowchart statement: " + s.slice(pos, n),
      })
      Some(op) => {
        let mut next_p = op.next_pos
        while next_p < n && is_space_byte(byte_at(s, next_p)) {
          next_p = next_p + 1
        }
        if next_p >= n {
          return Err(ParseError::{
            line: line_no,
            col: next_p + 1,
            message: "expected target node after edge operator",
          })
        }
        let (right_ids, after_right) = parse_node_group(st, s, next_p, line_no)?
        match op.edge_id {
          Some(eid) => st.edge_ids.set(eid, true)
          None => ()
        }
        for u in left_ids {
          for v in right_ids {
            st.edges.push(FlowEdge::{
              id: op.edge_id,
              from: u,
              to: v,
              label: op.label,
              stroke: op.stroke,
              start_arrow: op.start_arrow,
              end_arrow: op.end_arrow,
              minlen: op.minlen,
            })
          }
        }
        left_ids = right_ids
        pos = after_right
      }
    }
  }
  Ok(())
}

///|
pub fn parse_flowchart(
  lines : Array[SourceLine],
  start_idx : Int,
  header_line_no : Int,
  rest_on_header : String,
  direction : Direction,
) -> Result[FlowchartDiagram, ParseError] {
  let st = FlowState::{
    direction: direction,
    nodes: [],
    node_index: Map::new(),
    edges: [],
    subgraphs: [],
    sg_stack: [],
    subgraph_ids: Map::new(),
    edge_ids: Map::new(),
    class_defs: [],
  }
  if rest_on_header.length() > 0 {
    let parts = split_semicolons(rest_on_header)
    for part in parts {
      parse_flow_stmt(st, part, header_line_no)?
    }
  }
  let mut in_acc_block = false
  for i = start_idx; i < lines.length(); i = i + 1 {
    let cleaned = strip_line_comment(lines[i].text).trim()
    if cleaned.length() == 0 {
      continue
    }
    if in_acc_block {
      if cleaned.contains("}") {
        in_acc_block = false
      }
      continue
    }
    if (cleaned.starts_with("accDescr") || cleaned.starts_with("accTitle")) && cleaned.contains("{") {
      if !cleaned.contains("}") {
        in_acc_block = true
      }
      continue
    }
    let parts = split_semicolons(cleaned)
    for part in parts {
      parse_flow_stmt(st, part, lines[i].line_no)?
    }
  }
  if st.sg_stack.length() > 0 {
    return Err(ParseError::{
      line: header_line_no,
      col: 1,
      message: "unclosed subgraph block (missing 'end')",
    })
  }
  let out_nodes : Array[FlowNode] = []
  for n in st.nodes {
    if !n.shape_explicit && st.subgraph_ids.get(n.id).is_some() {
      continue
    }
    out_nodes.push(FlowNode::{
      id: n.id,
      label: n.label,
      shape: n.shape,
      classes: n.classes,
      style: n.style,
      subgraph: n.subgraph,
    })
  }
  let out_sgs : Array[FlowSubgraph] = []
  for sg in st.subgraphs {
    out_sgs.push(FlowSubgraph::{
      id: sg.id,
      title: sg.title,
      parent: sg.parent,
      direction: sg.direction,
      node_ids: sg.node_ids,
    })
  }
  Ok(FlowchartDiagram::{
    direction: st.direction,
    nodes: out_nodes,
    edges: st.edges,
    subgraphs: out_sgs,
    class_defs: st.class_defs,
  })
}
