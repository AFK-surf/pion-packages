///| Sugiyama / Dagre layered graph layout engine (stub for Red phase).

///|
pub struct GraphNodeInput {
  pub id : String
  pub label : String
  pub shape : String
  pub width : Double
  pub height : Double
  pub parent : Option[String]
}

///|
pub struct GraphEdgeInput {
  pub id : String
  pub from : String
  pub to : String
  pub label : String
  pub stroke : String
  pub start_arrow : String
  pub end_arrow : String
  pub weight : Int
  pub minlen : Int
}

///|
pub struct GraphGroupInput {
  pub id : String
  pub title : String
  pub parent : Option[String]
}

///|
pub struct GraphInput {
  pub direction : Direction
  pub nodes : Array[GraphNodeInput]
  pub edges : Array[GraphEdgeInput]
  pub groups : Array[GraphGroupInput]
  pub node_sep : Double
  pub rank_sep : Double
  pub edge_sep : Double
  pub margin_x : Double
  pub margin_y : Double
}

///|
pub fn default_graph_input(direction : Direction) -> GraphInput {
  GraphInput::{
    direction: direction,
    nodes: [],
    edges: [],
    groups: [],
    node_sep: 40.0,
    rank_sep: 50.0,
    edge_sep: 20.0,
    margin_x: 20.0,
    margin_y: 20.0,
  }
}

///|
pub fn layout_sugiyama(input : GraphInput) -> Scene {
  let _ = input
  empty_scene()
}
