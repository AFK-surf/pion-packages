///| Pure Pion Sugiyama / Dagre layered graph layout engine.
///| Pipeline:
///|   1. Direction normalization (swap dims for LR/RL)
///|   2. Self-loop extraction & parallel-edge detection
///|   3. Iterative DFS feedback arc set (acyclic, stack-safe for 200k+ chains)
///|   4. Longest-path + source tightening + optional rank-doubling for labels/multi-edges
///|   5. O(N+G) post-order group hierarchy & cluster-span / edge-label dummy insertion
///|   6. Cluster-preserving barycenter multi-sweep crossing minimization
///|   7. Y rank spacing (with vertical cluster padding) & constraint-DAG / neighbor-aligned X assignment
///|   8. Bottom-up O(N+G) nested group bounding boxes
///|   9. Band-safe edge polyline routing, self-loop placement, label bounds, and direction transform

///|
pub struct GraphNodeInput {
  pub id : String
  pub label : String
  pub shape : String
  pub width : Double
  pub height : Double
  pub parent : Option[String]
}

///|
pub struct GraphEdgeInput {
  pub id : String
  pub from : String
  pub to : String
  pub label : String
  pub stroke : String
  pub start_arrow : String
  pub end_arrow : String
  pub weight : Int
  pub minlen : Int
}

///|
pub struct GraphGroupInput {
  pub id : String
  pub title : String
  pub parent : Option[String]
}

///|
pub struct GraphInput {
  pub direction : Direction
  pub nodes : Array[GraphNodeInput]
  pub edges : Array[GraphEdgeInput]
  pub groups : Array[GraphGroupInput]
  pub node_sep : Double
  pub rank_sep : Double
  pub edge_sep : Double
  pub margin_x : Double
  pub margin_y : Double
}

///|
pub fn default_graph_input(direction : Direction) -> GraphInput {
  GraphInput::{
    direction: direction,
    nodes: [],
    edges: [],
    groups: [],
    node_sep: 40.0,
    rank_sep: 50.0,
    edge_sep: 20.0,
    margin_x: 20.0,
    margin_y: 20.0,
  }
}

///|
struct WorkNode {
  id : String
  label : String
  shape : String
  width : Double
  height : Double
  parent : Option[String]
  is_dummy : Bool
  mut rank : Int
  mut order : Int
  mut x : Double
  mut y : Double
}

///|
struct WorkEdge {
  orig_idx : Int
  mut u : Int
  mut v : Int
  weight : Int
  minlen : Int
  mut reversed : Bool
  is_self : Bool
  dummy_ids : Array[Int]
  mut label_dummy : Int
}

///|
struct XConstraint {
  to : Int
  delta : Double
}

///|
fn is_horizontal_dir(d : Direction) -> Bool {
  d == Direction::LR || d == Direction::RL
}

///|
fn is_reversed_dir(d : Direction) -> Bool {
  d == Direction::BT || d == Direction::RL
}

///| Iterative DFS feedback arc set (zero recursion, safe for 200k+ depth).
fn dfs_break_cycles_iter(
  start : Int,
  out_adj : Array[Array[Int]],
  edges : Array[WorkEdge],
  state : Array[Int],
) -> Unit {
  let stack_u : Array[Int] = [start]
  let stack_ei : Array[Int] = [0]
  state[start] = 1
  while stack_u.length() > 0 {
    let top = stack_u.length() - 1
    let u = stack_u[top]
    let ei = stack_ei[top]
    let adj = out_adj[u]
    if ei >= adj.length() {
      state[u] = 2
      let _ = stack_u.pop()
      let _ = stack_ei.pop()
      continue
    }
    stack_ei[top] = ei + 1
    let eidx = adj[ei]
    let e = edges[eidx]
    if e.is_self {
      continue
    }
    let v = e.v
    if state[v] == 1 {
      e.reversed = true
      let tmp = e.u
      e.u = e.v
      e.v = tmp
    } else if state[v] == 0 {
      state[v] = 1
      stack_u.push(v)
      stack_ei.push(0)
    }
  }
}

///|
fn count_two_layer_crossings(
  upper : Array[Int],
  lower : Array[Int],
  out_layer_edges : Array[Array[Int]],
  pos_in_layer : Array[Int],
) -> Int {
  let v_positions : Array[Int] = []
  for u in upper {
    let nbrs = out_layer_edges[u]
    if nbrs.length() == 0 {
      continue
    }
    let tmp : Array[Int] = []
    for v in nbrs {
      tmp.push(pos_in_layer[v])
    }
    tmp.sort()
    for p in tmp {
      v_positions.push(p)
    }
  }
  let m = v_positions.length()
  if m <= 1 {
    return 0
  }
  let sz = lower.length() + 2
  let bit = Array::make(sz, 0)
  let mut crossings = 0
  for i = m - 1; i >= 0; i = i - 1 {
    let p = v_positions[i]
    let mut q = p
    while q > 0 {
      crossings = crossings + bit[q]
      q = q - (q & -q)
    }
    let mut k = p + 1
    while k < sz {
      bit[k] = bit[k] + 1
      k = k + (k & -k)
    }
  }
  crossings
}

///|
fn count_all_crossings(
  layers : Array[Array[Int]],
  out_layer_edges : Array[Array[Int]],
  pos_in_layer : Array[Int],
) -> Int {
  let mut total = 0
  for r = 0; r + 1 < layers.length(); r = r + 1 {
    total = total + count_two_layer_crossings(layers[r], layers[r + 1], out_layer_edges, pos_in_layer)
  }
  total
}

///| Iterative bottom-up stable merge sort of (layer, keys) for O(m log m) on large layers.
fn merge_sort_layer_by_keys(layer : Array[Int], keys : Array[Double], bias_right : Bool) -> Unit {
  let m = layer.length()
  if m <= 32 {
    for i = 1; i < m; i = i + 1 {
      let kv = keys[i]
      let nv = layer[i]
      let mut j = i - 1
      while j >= 0 {
        let cmp = if bias_right { keys[j] > kv } else { keys[j] >= kv }
        if cmp {
          keys[j + 1] = keys[j]
          layer[j + 1] = layer[j]
          j = j - 1
        } else {
          break
        }
      }
      keys[j + 1] = kv
      layer[j + 1] = nv
    }
    return
  }
  let tmp_l = Array::make(m, 0)
  let tmp_k = Array::make(m, 0.0)
  let mut width = 1
  while width < m {
    let mut lo = 0
    while lo < m {
      let mid = if lo + width < m { lo + width } else { m }
      let hi = if lo + width * 2 < m { lo + width * 2 } else { m }
      let mut i = lo
      let mut j = mid
      let mut k = lo
      while i < mid && j < hi {
        let take_left = if bias_right { keys[i] <= keys[j] } else { keys[i] < keys[j] }
        if take_left {
          tmp_l[k] = layer[i]
          tmp_k[k] = keys[i]
          i = i + 1
        } else {
          tmp_l[k] = layer[j]
          tmp_k[k] = keys[j]
          j = j + 1
        }
        k = k + 1
      }
      while i < mid {
        tmp_l[k] = layer[i]
        tmp_k[k] = keys[i]
        i = i + 1
        k = k + 1
      }
      while j < hi {
        tmp_l[k] = layer[j]
        tmp_k[k] = keys[j]
        j = j + 1
        k = k + 1
      }
      for p = lo; p < hi; p = p + 1 {
        layer[p] = tmp_l[p]
        keys[p] = tmp_k[p]
      }
      lo = lo + width * 2
    }
    width = width * 2
  }
}

///|
fn sort_layer_by_barycenter(
  layer : Array[Int],
  adj : Array[Array[Int]],
  pos_in_layer : Array[Int],
  bias_right : Bool,
) -> Unit {
  let m = layer.length()
  if m <= 1 {
    return
  }
  let keys : Array[Double] = Array::make(m, 0.0)
  for i = 0; i < m; i = i + 1 {
    let u = layer[i]
    let nbrs = adj[u]
    if nbrs.length() == 0 {
      keys[i] = i.to_double()
    } else {
      let mut sum = 0.0
      for v in nbrs {
        sum = sum + pos_in_layer[v].to_double()
      }
      keys[i] = sum / nbrs.length().to_double()
    }
  }
  merge_sort_layer_by_keys(layer, keys, bias_right)
  for i = 0; i < m; i = i + 1 {
    pos_in_layer[layer[i]] = i
  }
}

///| Compute lowest common ancestor of two group indices (-1 = root).
fn lca_group(g1_in : Int, g2_in : Int, group_parent : Array[Int], group_depth : Array[Int]) -> Int {
  let mut a = g1_in
  let mut b = g2_in
  if a == b {
    return a
  }
  if a < 0 || b < 0 {
    return -1
  }
  while a >= 0 && b >= 0 && group_depth[a] > group_depth[b] {
    a = group_parent[a]
  }
  while a >= 0 && b >= 0 && group_depth[b] > group_depth[a] {
    b = group_parent[b]
  }
  while a != b && a >= 0 && b >= 0 {
    a = group_parent[a]
    b = group_parent[b]
  }
  if a == b { a } else { -1 }
}

///| Find highest ancestor of `g_in` whose parent is `lca` (-1 if `g_in == lca`).
fn highest_ancestor_below(g_in : Int, lca : Int, group_parent : Array[Int]) -> Int {
  let mut cur = g_in
  if cur == lca || cur < 0 {
    return -1
  }
  let mut steps = 0
  while cur >= 0 && steps < 100000 {
    steps = steps + 1
    let p = group_parent[cur]
    if p == lca {
      return cur
    }
    cur = p
  }
  -1
}

///| Cluster-preserving sort of a single layer:
///| - Keeps members of every group contiguous.
///| - Preserves consistent global order between any two sibling groups (by group index).
///| - Orders ungrouped nodes and intra-group nodes by barycenter.
fn sort_layer_cluster_aware(
  layer : Array[Int],
  adj : Array[Array[Int]],
  pos_in_layer : Array[Int],
  node_group : Array[Int],
  group_parent : Array[Int],
  group_depth : Array[Int],
  num_groups : Int,
  bias_right : Bool,
) -> Unit {
  let m = layer.length()
  if m <= 1 {
    return
  }
  let node_bc : Array[Double] = Array::make(m, 0.0)
  for i = 0; i < m; i = i + 1 {
    let u = layer[i]
    let nbrs = adj[u]
    if nbrs.length() == 0 {
      node_bc[i] = i.to_double()
    } else {
      let mut sum = 0.0
      for v in nbrs {
        sum = sum + pos_in_layer[v].to_double()
      }
      node_bc[i] = sum / nbrs.length().to_double()
    }
  }
  // Compute average barycenter per group on this rank (for positioning ungrouped nodes vs groups)
  let g_sum : Map[Int, Double] = Map::new()
  let g_cnt : Map[Int, Int] = Map::new()
  let _ = num_groups
  for i = 0; i < m; i = i + 1 {
    let mut g = node_group[layer[i]]
    let mut steps = 0
    while g >= 0 && steps < 64 {
      steps = steps + 1
      g_sum.set(g, g_sum.get(g).unwrap_or(0.0) + node_bc[i])
      g_cnt.set(g, g_cnt.get(g).unwrap_or(0) + 1)
      g = group_parent[g]
    }
  }
  // Compare two items (u_idx, v_idx) in layer: returns true if a should come AFTER b
  let order_idx : Array[Int] = []
  for i = 0; i < m; i = i + 1 {
    order_idx.push(i)
  }
  // Insertion sort on layer indices (layer sizes in clustered graphs are modest; cap for huge layers)
  if m > 512 {
    sort_layer_by_barycenter(layer, adj, pos_in_layer, bias_right)
    return
  }
  for i = 1; i < m; i = i + 1 {
    let cur_i = order_idx[i]
    let u = layer[cur_i]
    let gu = node_group[u]
    let bcu = node_bc[cur_i]
    let mut j = i - 1
    while j >= 0 {
      let prev_i = order_idx[j]
      let v = layer[prev_i]
      let gv = node_group[v]
      let bcv = node_bc[prev_i]
      let lca = lca_group(gv, gu, group_parent, group_depth)
      let top_v = highest_ancestor_below(gv, lca, group_parent)
      let top_u = highest_ancestor_below(gu, lca, group_parent)
      let swap = if top_v >= 0 && top_u >= 0 {
        // Two distinct sibling groups: ALWAYS enforce consistent global order top_v < top_u
        top_v > top_u
      } else if top_v >= 0 && top_u < 0 {
        // Group vs node at same level
        let gv_bc = g_sum.get(top_v).unwrap_or(0.0) / g_cnt.get(top_v).unwrap_or(1).to_double()
        if bias_right { gv_bc > bcu } else { gv_bc >= bcu }
      } else if top_v < 0 && top_u >= 0 {
        // Node vs group at same level
        let gu_bc = g_sum.get(top_u).unwrap_or(0.0) / g_cnt.get(top_u).unwrap_or(1).to_double()
        if bias_right { bcv > gu_bc } else { bcv >= gu_bc }
      } else {
        // Both directly inside the same group (or both ungrouped)
        if bias_right { bcv > bcu } else { bcv >= bcu }
      }
      if swap {
        order_idx[j + 1] = prev_i
        j = j - 1
      } else {
        break
      }
    }
    order_idx[j + 1] = cur_i
  }
  let new_layer : Array[Int] = []
  for idx in order_idx {
    new_layer.push(layer[idx])
  }
  for i = 0; i < m; i = i + 1 {
    layer[i] = new_layer[i]
    pos_in_layer[layer[i]] = i
  }
}

///|
fn copy_layers(layers : Array[Array[Int]]) -> Array[Array[Int]] {
  let out : Array[Array[Int]] = []
  for l in layers {
    out.push(l.copy())
  }
  out
}

///|
pub fn layout_sugiyama(input : GraphInput) -> Scene {
  let orig_n = input.nodes.length()
  if orig_n == 0 {
    return empty_scene()
  }
  let horiz = is_horizontal_dir(input.direction)
  let rev_axis = is_reversed_dir(input.direction)

  // 1. Build working nodes & ID index
  let nodes : Array[WorkNode] = []
  let id_to_idx : Map[String, Int] = Map::new()
  for i = 0; i < orig_n; i = i + 1 {
    let n = input.nodes[i]
    let w = if horiz { n.height } else { n.width }
    let h = if horiz { n.width } else { n.height }
    nodes.push(WorkNode::{
      id: n.id,
      label: n.label,
      shape: n.shape,
      width: w,
      height: h,
      parent: n.parent,
      is_dummy: false,
      rank: 0,
      order: i,
      x: 0.0,
      y: 0.0,
    })
    id_to_idx.set(n.id, i)
  }

  // 2. Build working edges (extracting self-loops & detecting labels / parallel edges)
  let edges : Array[WorkEdge] = []
  let out_adj : Array[Array[Int]] = []
  for i = 0; i < orig_n; i = i + 1 {
    out_adj.push([])
  }
  let pair_counts : Map[String, Int] = Map::new()
  let mut has_any_label = false
  let mut has_any_parallel = false
  let self_loop_counts = Array::make(orig_n, 0)
  let self_extra_right = Array::make(orig_n, 0.0)
  for i = 0; i < input.edges.length(); i = i + 1 {
    let e = input.edges[i]
    let u = match id_to_idx.get(e.from) {
      Some(idx) => idx
      None => continue
    }
    let v = match id_to_idx.get(e.to) {
      Some(idx) => idx
      None => continue
    }
    let ml = if e.minlen > 0 { e.minlen } else { 1 }
    let wt = if e.weight > 0 { e.weight } else { 1 }
    let eidx = edges.length()
    let is_self = u == v
    edges.push(WorkEdge::{
      orig_idx: i,
      u: u,
      v: v,
      weight: wt,
      minlen: ml,
      reversed: false,
      is_self: is_self,
      dummy_ids: [],
      label_dummy: -1,
    })
    if is_self {
      let k = self_loop_counts[u]
      self_loop_counts[u] = k + 1
      let loop_w = 28.0 + k.to_double() * 14.0
      let orig_lw = if e.label.length() > 0 { e.label.length().to_double() * 7.5 + 12.0 } else { 0.0 }
      let lbl_span = if e.label.length() > 0 {
        (if horiz { 20.0 } else { orig_lw }) + 12.0
      } else {
        0.0
      }
      let need_r = loop_w + lbl_span + 8.0
      if need_r > self_extra_right[u] {
        self_extra_right[u] = need_r
      }
    } else {
      out_adj[u].push(eidx)
      if e.label.length() > 0 {
        has_any_label = true
      }
      let lo = if u < v { u } else { v }
      let hi = if u < v { v } else { u }
      let pkey = lo.to_string() + ":" + hi.to_string()
      let pc = pair_counts.get(pkey).unwrap_or(0) + 1
      pair_counts.set(pkey, pc)
      if pc > 1 {
        has_any_parallel = true
      }
    }
  }
  let need_mid_rank = has_any_label || has_any_parallel

  // 3. Acyclic (Iterative DFS feedback arc set — stack-safe)
  let in_deg_raw = Array::make(orig_n, 0)
  for e in edges {
    if !e.is_self {
      in_deg_raw[e.v] = in_deg_raw[e.v] + 1
    }
  }
  let dfs_state = Array::make(orig_n, 0)
  for i = 0; i < orig_n; i = i + 1 {
    if in_deg_raw[i] == 0 && dfs_state[i] == 0 {
      dfs_break_cycles_iter(i, out_adj, edges, dfs_state)
    }
  }
  for i = 0; i < orig_n; i = i + 1 {
    if dfs_state[i] == 0 {
      dfs_break_cycles_iter(i, out_adj, edges, dfs_state)
    }
  }

  // 4. Ranking (Longest-Path via Kahn's topological sort + source tightening)
  let dag_out : Array[Array[Int]] = []
  let dag_in_deg = Array::make(orig_n, 0)
  for i = 0; i < orig_n; i = i + 1 {
    dag_out.push([])
  }
  for eidx = 0; eidx < edges.length(); eidx = eidx + 1 {
    let e = edges[eidx]
    if e.is_self {
      continue
    }
    dag_out[e.u].push(eidx)
    dag_in_deg[e.v] = dag_in_deg[e.v] + 1
  }
  let queue : Array[Int] = []
  for i = 0; i < orig_n; i = i + 1 {
    if dag_in_deg[i] == 0 {
      queue.push(i)
    }
  }
  let topo : Array[Int] = []
  let mut qh = 0
  while qh < queue.length() {
    let u = queue[qh]
    qh = qh + 1
    topo.push(u)
    for eidx in dag_out[u] {
      let e = edges[eidx]
      let cand = nodes[u].rank + e.minlen
      if cand > nodes[e.v].rank {
        nodes[e.v].rank = cand
      }
      dag_in_deg[e.v] = dag_in_deg[e.v] - 1
      if dag_in_deg[e.v] == 0 {
        queue.push(e.v)
      }
    }
  }
  // Source tightening
  let has_in = Array::make(orig_n, false)
  for e in edges {
    if !e.is_self {
      has_in[e.v] = true
    }
  }
  for i = topo.length() - 1; i >= 0; i = i - 1 {
    let u = topo[i]
    if !has_in[u] && dag_out[u].length() > 0 {
      let mut min_target = 1000000000
      for eidx in dag_out[u] {
        let e = edges[eidx]
        let t = nodes[e.v].rank - e.minlen
        if t < min_target {
          min_target = t
        }
      }
      if min_target < 1000000000 && min_target > nodes[u].rank {
        nodes[u].rank = min_target
      }
    }
  }
  // Normalize min rank to 0
  let mut min_rank = 1000000000
  let mut max_rank = 0
  for i = 0; i < orig_n; i = i + 1 {
    if nodes[i].rank < min_rank {
      min_rank = nodes[i].rank
    }
  }
  if min_rank == 1000000000 {
    min_rank = 0
  }
  for i = 0; i < orig_n; i = i + 1 {
    nodes[i].rank = nodes[i].rank - min_rank
    if need_mid_rank {
      nodes[i].rank = nodes[i].rank * 2
    }
    if nodes[i].rank > max_rank {
      max_rank = nodes[i].rank
    }
  }

  // 5. Group Hierarchy (O(N + G) iterative post-order)
  let num_groups = input.groups.length()
  let group_idx_map : Map[String, Int] = Map::new()
  for gi = 0; gi < num_groups; gi = gi + 1 {
    group_idx_map.set(input.groups[gi].id, gi)
  }
  let group_parent = Array::make(num_groups, -1)
  let group_children : Array[Array[Int]] = []
  let group_direct_nodes : Array[Array[Int]] = []
  for gi = 0; gi < num_groups; gi = gi + 1 {
    group_children.push([])
    group_direct_nodes.push([])
  }
  for gi = 0; gi < num_groups; gi = gi + 1 {
    match input.groups[gi].parent {
      Some(pid) => {
        match group_idx_map.get(pid) {
          Some(pgi) => {
            if pgi != gi {
              group_parent[gi] = pgi
              group_children[pgi].push(gi)
            }
          }
          None => ()
        }
      }
      None => ()
    }
  }
  // Iterative pre-order & depth, then reverse for post-order
  let group_depth = Array::make(num_groups, 0)
  let group_pre_order : Array[Int] = []
  let g_visited = Array::make(num_groups, false)
  let g_stack : Array[Int] = []
  for gi = 0; gi < num_groups; gi = gi + 1 {
    if group_parent[gi] < 0 && !g_visited[gi] {
      g_stack.push(gi)
      while g_stack.length() > 0 {
        let cur = g_stack.pop().unwrap_or(0)
        if g_visited[cur] {
          continue
        }
        g_visited[cur] = true
        group_pre_order.push(cur)
        let ch = group_children[cur]
        for k = ch.length() - 1; k >= 0; k = k - 1 {
          let c = ch[k]
          if !g_visited[c] {
            group_depth[c] = group_depth[cur] + 1
            g_stack.push(c)
          }
        }
      }
    }
  }
  let group_post_order : Array[Int] = []
  for k = group_pre_order.length() - 1; k >= 0; k = k - 1 {
    group_post_order.push(group_pre_order[k])
  }

  let node_group : Array[Int] = Array::make(orig_n, -1)
  for ni = 0; ni < orig_n; ni = ni + 1 {
    match nodes[ni].parent {
      Some(gid) => {
        match group_idx_map.get(gid) {
          Some(gi) => {
            node_group[ni] = gi
            group_direct_nodes[gi].push(ni)
          }
          None => ()
        }
      }
      None => ()
    }
  }
  let group_has = Array::make(num_groups, false)
  let group_min_rank = Array::make(num_groups, 1000000000)
  let group_max_rank = Array::make(num_groups, -1)
  let mut active_group_count = 0
  for gi in group_post_order {
    let mut found = false
    let mut rmin = 1000000000
    let mut rmax = -1
    for ni in group_direct_nodes[gi] {
      found = true
      let r = nodes[ni].rank
      if r < rmin { rmin = r }
      if r > rmax { rmax = r }
    }
    for cgi in group_children[gi] {
      if group_has[cgi] {
        found = true
        if group_min_rank[cgi] < rmin { rmin = group_min_rank[cgi] }
        if group_max_rank[cgi] > rmax { rmax = group_max_rank[cgi] }
      }
    }
    if found {
      group_has[gi] = true
      group_min_rank[gi] = rmin
      group_max_rank[gi] = rmax
      active_group_count = active_group_count + 1
    }
  }
  let has_active_groups = active_group_count > 0

  // 6. Normalization: insert edge dummy nodes (with label-sized dummy for labeled edges)
  for ei = 0; ei < edges.length(); ei = ei + 1 {
    let e = edges[ei]
    if e.is_self {
      continue
    }
    let ru = nodes[e.u].rank
    let rv = nodes[e.v].rank
    if rv - ru > 1 {
      let orig_e = input.edges[e.orig_idx]
      let has_lbl = orig_e.label.length() > 0
      let mut label_rank = -1
      if has_lbl {
        let mid = (ru + rv) / 2
        label_rank = if need_mid_rank && mid % 2 == 0 {
          if mid - 1 > ru { mid - 1 } else { mid + 1 }
        } else {
          mid
        }
      }
      let orig_lw = if has_lbl { orig_e.label.length().to_double() * 7.5 + 12.0 } else { 0.0 }
      let orig_lh = 20.0
      let lw = if horiz { orig_lh } else { orig_lw }
      let lh = if horiz { orig_lw } else { orig_lh }
      let lca = if has_active_groups {
        lca_group(node_group[e.u], node_group[e.v], group_parent, group_depth)
      } else {
        -1
      }
      let dummy_parent : Option[String] = if lca >= 0 { Some(input.groups[lca].id) } else { None }
      for r = ru + 1; r < rv; r = r + 1 {
        let did = nodes.length()
        let is_lbl = has_lbl && r == label_rank
        let dw = if is_lbl { lw } else { input.edge_sep }
        let dh = if is_lbl { lh } else { 0.0 }
        nodes.push(WorkNode::{
          id: "__dummy_" + did.to_string(),
          label: "",
          shape: "dummy",
          width: dw,
          height: dh,
          parent: dummy_parent,
          is_dummy: true,
          rank: r,
          order: 0,
          x: 0.0,
          y: 0.0,
        })
        node_group.push(lca)
        e.dummy_ids.push(did)
        if is_lbl {
          e.label_dummy = did
        }
      }
    }
  }

  // Insert cluster-span dummy nodes on skipped ranks so foreign nodes cannot slip inside cluster boxes
  if has_active_groups && active_group_count <= 2000 {
    // Track which (group, rank) pairs already have a descendant node
    let group_rank_present : Map[String, Bool] = Map::new()
    for ni = 0; ni < nodes.length(); ni = ni + 1 {
      let mut g = node_group[ni]
      let r = nodes[ni].rank
      let mut steps = 0
      while g >= 0 && steps < 64 {
        steps = steps + 1
        group_rank_present.set(g.to_string() + ":" + r.to_string(), true)
        g = group_parent[g]
      }
    }
    for gi in group_post_order {
      if !group_has[gi] {
        continue
      }
      let r0 = group_min_rank[gi]
      let r1 = group_max_rank[gi]
      if r1 - r0 < 2 {
        continue
      }
      for r = r0 + 1; r < r1; r = r + 1 {
        let key = gi.to_string() + ":" + r.to_string()
        if group_rank_present.get(key).is_none() {
          let did = nodes.length()
          nodes.push(WorkNode::{
            id: "__gspan_" + did.to_string(),
            label: "",
            shape: "dummy",
            width: 0.0,
            height: 0.0,
            parent: Some(input.groups[gi].id),
            is_dummy: true,
            rank: r,
            order: 0,
            x: 0.0,
            y: 0.0,
          })
          node_group.push(gi)
          let mut g = gi
          let mut steps = 0
          while g >= 0 && steps < 64 {
            steps = steps + 1
            group_rank_present.set(g.to_string() + ":" + r.to_string(), true)
            g = group_parent[g]
          }
        }
      }
    }
  }

  let total_n = nodes.length()

  // Build normalized 1-rank adjacency
  let out_layer : Array[Array[Int]] = []
  let in_layer : Array[Array[Int]] = []
  for i = 0; i < total_n; i = i + 1 {
    out_layer.push([])
    in_layer.push([])
  }
  for e in edges {
    if e.is_self {
      continue
    }
    if e.dummy_ids.length() == 0 {
      out_layer[e.u].push(e.v)
      in_layer[e.v].push(e.u)
    } else {
      let mut prev = e.u
      for d in e.dummy_ids {
        out_layer[prev].push(d)
        in_layer[d].push(prev)
        prev = d
      }
      out_layer[prev].push(e.v)
      in_layer[e.v].push(prev)
    }
  }

  // 7. Layer Matrix & Crossing Minimization
  let layers : Array[Array[Int]] = []
  for r = 0; r <= max_rank; r = r + 1 {
    layers.push([])
  }
  for i = 0; i < total_n; i = i + 1 {
    layers[nodes[i].rank].push(i)
  }
  let pos_in_layer = Array::make(total_n, 0)
  for r = 0; r <= max_rank; r = r + 1 {
    for j = 0; j < layers[r].length(); j = j + 1 {
      pos_in_layer[layers[r][j]] = j
    }
  }
  // Initial cluster-preserving pass so every layer starts with valid contiguous cluster order
  if has_active_groups {
    for r = 0; r <= max_rank; r = r + 1 {
      sort_layer_cluster_aware(
        layers[r],
        in_layer,
        pos_in_layer,
        node_group,
        group_parent,
        group_depth,
        num_groups,
        false,
      )
    }
  }

  let max_sweeps = if total_n > 30000 { 2 } else if total_n > 5000 { 6 } else { 24 }
  let mut best_layers = copy_layers(layers)
  let mut best_cc = count_all_crossings(layers, out_layer, pos_in_layer)
  let mut no_improve = 0
  let mut sweep = 0
  while sweep < max_sweeps && no_improve < 4 && best_cc > 0 {
    let bias_right = (sweep % 4) >= 2
    if sweep % 2 == 0 {
      for r = 1; r <= max_rank; r = r + 1 {
        if has_active_groups {
          sort_layer_cluster_aware(
            layers[r],
            in_layer,
            pos_in_layer,
            node_group,
            group_parent,
            group_depth,
            num_groups,
            bias_right,
          )
        } else {
          sort_layer_by_barycenter(layers[r], in_layer, pos_in_layer, bias_right)
        }
      }
    } else {
      for r = max_rank - 1; r >= 0; r = r - 1 {
        if has_active_groups {
          sort_layer_cluster_aware(
            layers[r],
            out_layer,
            pos_in_layer,
            node_group,
            group_parent,
            group_depth,
            num_groups,
            bias_right,
          )
        } else {
          sort_layer_by_barycenter(layers[r], out_layer, pos_in_layer, bias_right)
        }
      }
    }
    let cc = count_all_crossings(layers, out_layer, pos_in_layer)
    if cc < best_cc {
      best_cc = cc
      best_layers = copy_layers(layers)
      no_improve = 0
    } else {
      no_improve = no_improve + 1
    }
    sweep = sweep + 1
  }
  for r = 0; r <= max_rank; r = r + 1 {
    let layer = best_layers[r]
    for j = 0; j < layer.length(); j = j + 1 {
      nodes[layer[j]].order = j
      pos_in_layer[layer[j]] = j
    }
  }

  // 8. Y Coordinate Assignment (with vertical cluster padding gaps)
  let pad_x = 16.0
  let pad_top = 26.0
  let pad_bot = 16.0
  let need_above = Array::make(max_rank + 1, 0.0)
  let need_below = Array::make(max_rank + 1, 0.0)
  if has_active_groups {
    let g_top_pad = Array::make(num_groups, 0.0)
    let g_bot_pad = Array::make(num_groups, 0.0)
    for gi in group_post_order {
      if !group_has[gi] {
        continue
      }
      let mut max_ct = 0.0
      let mut max_cb = 0.0
      for cgi in group_children[gi] {
        if group_has[cgi] {
          if group_min_rank[cgi] == group_min_rank[gi] && g_top_pad[cgi] > max_ct {
            max_ct = g_top_pad[cgi]
          }
          if group_max_rank[cgi] == group_max_rank[gi] && g_bot_pad[cgi] > max_cb {
            max_cb = g_bot_pad[cgi]
          }
        }
      }
      g_top_pad[gi] = pad_top + max_ct
      g_bot_pad[gi] = pad_bot + max_cb
      let r0 = group_min_rank[gi]
      let r1 = group_max_rank[gi]
      if r0 >= 0 && r0 <= max_rank && g_top_pad[gi] > need_above[r0] {
        need_above[r0] = g_top_pad[gi]
      }
      if r1 >= 0 && r1 <= max_rank && g_bot_pad[gi] > need_below[r1] {
        need_below[r1] = g_bot_pad[gi]
      }
    }
  }
  let rank_top_y = Array::make(max_rank + 1, 0.0)
  let rank_bot_y = Array::make(max_rank + 1, 0.0)
  let base_rank_sep = if need_mid_rank { input.rank_sep * 0.55 } else { input.rank_sep }
  let mut cur_y = input.margin_y
  for r = 0; r <= max_rank; r = r + 1 {
    let layer = best_layers[r]
    let mut max_h = 0.0
    for u in layer {
      if nodes[u].height > max_h {
        max_h = nodes[u].height
      }
    }
    let center_y = cur_y + max_h / 2.0
    rank_top_y[r] = cur_y
    rank_bot_y[r] = cur_y + max_h
    for u in layer {
      nodes[u].y = center_y
    }
    let next_gap = if r + 1 <= max_rank {
      let cluster_gap = if has_active_groups && (need_below[r] > 0.0 || need_above[r + 1] > 0.0) {
        need_below[r] + need_above[r + 1] + 16.0
      } else {
        0.0
      }
      if cluster_gap > base_rank_sep { cluster_gap } else { base_rank_sep }
    } else {
      base_rank_sep
    }
    cur_y = cur_y + max_h + next_gap
  }

  // 9. X Coordinate Assignment
  let group_x = Array::make(num_groups, 0.0)
  let group_y = Array::make(num_groups, 0.0)
  let group_w = Array::make(num_groups, 0.0)
  let group_h = Array::make(num_groups, 0.0)

  if !has_active_groups {
    // Fast path for ungrouped graphs
    for r = 0; r <= max_rank; r = r + 1 {
      let layer = best_layers[r]
      let m = layer.length()
      if m == 0 {
        continue
      }
      let mut x = 0.0
      for j = 0; j < m; j = j + 1 {
        let u = layer[j]
        if j == 0 {
          x = nodes[u].width / 2.0
        } else {
          let prev = layer[j - 1]
          let prev_er = if prev < orig_n { self_extra_right[prev] } else { 0.0 }
          x = x + nodes[prev].width / 2.0 + prev_er + input.node_sep + nodes[u].width / 2.0
        }
        nodes[u].x = x
      }
      let first_l = nodes[layer[0]].x - nodes[layer[0]].width / 2.0
      let last_u = layer[m - 1]
      let last_er = if last_u < orig_n { self_extra_right[last_u] } else { 0.0 }
      let last_r = nodes[last_u].x + nodes[last_u].width / 2.0 + last_er
      let mid = (first_l + last_r) / 2.0
      for u in layer {
        nodes[u].x = nodes[u].x - mid
      }
    }
    for iter = 0; iter < 4; iter = iter + 1 {
      for r = 1; r <= max_rank; r = r + 1 {
        align_layer_x(best_layers[r], in_layer, nodes, input.node_sep, self_extra_right, orig_n)
      }
      for r = max_rank - 1; r >= 0; r = r - 1 {
        align_layer_x(best_layers[r], out_layer, nodes, input.node_sep, self_extra_right, orig_n)
      }
    }
  } else {
    // Cluster-aware Constraint-DAG X-Assignment (O(V + E), guarantees 0 cluster overlap & 0 intrusion)
    let nvars = total_n + num_groups * 2
    let c_out : Array[Array[XConstraint]] = []
    let c_indeg = Array::make(nvars, 0)
    for k = 0; k < nvars; k = k + 1 {
      c_out.push([])
    }
    // Helper closure-less edge insertion via direct push
    // 9a. Node containment in direct group
    for u = 0; u < total_n; u = u + 1 {
      let g = node_group[u]
      if g >= 0 && group_has[g] {
        let gl = total_n + g * 2
        let gr = gl + 1
        let er = if u < orig_n { self_extra_right[u] } else { 0.0 }
        c_out[gl].push(XConstraint::{ to: u, delta: pad_x })
        c_indeg[u] = c_indeg[u] + 1
        c_out[u].push(XConstraint::{ to: gr, delta: nodes[u].width + er + pad_x })
        c_indeg[gr] = c_indeg[gr] + 1
      }
    }
    // 9b. Group minimum title width & nested group containment
    for gi = 0; gi < num_groups; gi = gi + 1 {
      if !group_has[gi] {
        continue
      }
      let gl = total_n + gi * 2
      let gr = gl + 1
      let tw = input.groups[gi].title.length().to_double() * 7.5 + 24.0
      let min_gw = if tw > 40.0 { tw } else { 40.0 }
      c_out[gl].push(XConstraint::{ to: gr, delta: min_gw })
      c_indeg[gr] = c_indeg[gr] + 1
      let pg = group_parent[gi]
      if pg >= 0 && group_has[pg] {
        let pgl = total_n + pg * 2
        let pgr = pgl + 1
        c_out[pgl].push(XConstraint::{ to: gl, delta: pad_x })
        c_indeg[gl] = c_indeg[gl] + 1
        c_out[gr].push(XConstraint::{ to: pgr, delta: pad_x })
        c_indeg[pgr] = c_indeg[pgr] + 1
      }
    }
    // 9c. Adjacent separation on each layer (lifted to highest differing cluster borders)
    let group_sep = if input.node_sep > 24.0 { input.node_sep } else { 24.0 }
    for r = 0; r <= max_rank; r = r + 1 {
      let layer = best_layers[r]
      for j = 1; j < layer.length(); j = j + 1 {
        let u = layer[j - 1]
        let v = layer[j]
        let gu = node_group[u]
        let gv = node_group[v]
        let lca = lca_group(gu, gv, group_parent, group_depth)
        let top_u = highest_ancestor_below(gu, lca, group_parent)
        let top_v = highest_ancestor_below(gv, lca, group_parent)
        let from_var = if top_u >= 0 { total_n + top_u * 2 + 1 } else { u }
        let u_er = if u < orig_n { self_extra_right[u] } else { 0.0 }
        let from_w = if top_u >= 0 { 0.0 } else { nodes[u].width + u_er }
        let to_var = if top_v >= 0 { total_n + top_v * 2 } else { v }
        let sep = if top_u >= 0 || top_v >= 0 { group_sep } else { input.node_sep }
        if from_var != to_var {
          c_out[from_var].push(XConstraint::{ to: to_var, delta: from_w + sep })
          c_indeg[to_var] = c_indeg[to_var] + 1
        }
      }
    }
    // 9d. Solve constraint DAG via Kahn's topological sort
    let xval = Array::make(nvars, 0.0)
    let cq : Array[Int] = []
    for k = 0; k < nvars; k = k + 1 {
      if c_indeg[k] == 0 {
        cq.push(k)
      }
    }
    let c_topo : Array[Int] = []
    let mut cqh = 0
    while cqh < cq.length() {
      let a = cq[cqh]
      cqh = cqh + 1
      c_topo.push(a)
      for c in c_out[a] {
        let cand = xval[a] + c.delta
        if cand > xval[c.to] {
          xval[c.to] = cand
        }
        c_indeg[c.to] = c_indeg[c.to] - 1
        if c_indeg[c.to] == 0 {
          cq.push(c.to)
        }
      }
    }
    // 9e. Reverse-topo right-tightening of group left borders (so boxes hug their members)
    for k = c_topo.length() - 1; k >= 0; k = k - 1 {
      let a = c_topo[k]
      if a >= total_n && (a - total_n) % 2 == 0 {
        // Group left border: pull right as far as outgoing constraints allow
        let outs = c_out[a]
        if outs.length() > 0 {
          let mut tight = 1.0e18
          for c in outs {
            let lim = xval[c.to] - c.delta
            if lim < tight {
              tight = lim
            }
          }
          if tight < 1.0e18 && tight > xval[a] {
            xval[a] = tight
          }
        }
      }
    }
    // Commit node X and group X/W
    for u = 0; u < total_n; u = u + 1 {
      nodes[u].x = xval[u] + nodes[u].width / 2.0
    }
    for gi = 0; gi < num_groups; gi = gi + 1 {
      if group_has[gi] {
        let gl = total_n + gi * 2
        let gr = gl + 1
        group_x[gi] = xval[gl]
        group_w[gi] = xval[gr] - xval[gl]
      }
    }
    // Compute group Y/H in O(N + G) post-order
    for gi in group_post_order {
      if !group_has[gi] {
        continue
      }
      let mut g_min_y = 1.0e18
      let mut g_max_y = -1.0e18
      for ni in group_direct_nodes[gi] {
        let ty = nodes[ni].y - nodes[ni].height / 2.0
        let by = nodes[ni].y + nodes[ni].height / 2.0
        if ty < g_min_y { g_min_y = ty }
        if by > g_max_y { g_max_y = by }
      }
      for cgi in group_children[gi] {
        if group_has[cgi] {
          let ty = group_y[cgi]
          let by = group_y[cgi] + group_h[cgi]
          if ty < g_min_y { g_min_y = ty }
          if by > g_max_y { g_max_y = by }
        }
      }
      group_y[gi] = g_min_y - pad_top
      group_h[gi] = (g_max_y - g_min_y) + pad_top + pad_bot
    }
  }

  // Shift X so minimum left edge is at margin_x
  let mut min_x = 1.0e18
  for i = 0; i < total_n; i = i + 1 {
    let lx = nodes[i].x - nodes[i].width / 2.0
    if lx < min_x {
      min_x = lx
    }
  }
  for gi = 0; gi < num_groups; gi = gi + 1 {
    if group_has[gi] && group_x[gi] < min_x {
      min_x = group_x[gi]
    }
  }
  let shift_x = input.margin_x - min_x
  for i = 0; i < total_n; i = i + 1 {
    nodes[i].x = nodes[i].x + shift_x
  }
  for gi = 0; gi < num_groups; gi = gi + 1 {
    if group_has[gi] {
      group_x[gi] = group_x[gi] + shift_x
    }
  }

  // 10. Build edge polylines & label boxes (in normalized TB space)
  let raw_edge_pts : Array[Array[Point]] = []
  let raw_lbl_has = Array::make(edges.length(), false)
  let raw_lbl_x = Array::make(edges.length(), 0.0)
  let raw_lbl_y = Array::make(edges.length(), 0.0)
  let raw_lbl_w = Array::make(edges.length(), 0.0)
  let raw_lbl_h = Array::make(edges.length(), 0.0)
  let self_seen = Array::make(orig_n, 0)
  for ei = 0; ei < edges.length(); ei = ei + 1 {
    let e = edges[ei]
    let orig_e = input.edges[e.orig_idx]
    let pts : Array[Point] = []
    let has_lbl = orig_e.label.length() > 0
    let orig_lw = if has_lbl { orig_e.label.length().to_double() * 7.5 + 12.0 } else { 0.0 }
    let orig_lh = 20.0
    let tb_lw = if horiz { orig_lh } else { orig_lw }
    let tb_lh = if horiz { orig_lw } else { orig_lh }
    if e.is_self {
      let n = nodes[e.u]
      let k = self_seen[e.u]
      self_seen[e.u] = k + 1
      let rx = n.x + n.width / 2.0
      let loop_w = 28.0 + k.to_double() * 14.0
      let loop_h = if n.height > 20.0 { n.height * 0.35 } else { 12.0 }
      pts.push(Point::{ x: rx, y: n.y - loop_h })
      pts.push(Point::{ x: rx + loop_w, y: n.y - loop_h })
      pts.push(Point::{ x: rx + loop_w, y: n.y + loop_h })
      pts.push(Point::{ x: rx, y: n.y + loop_h })
      if has_lbl {
        raw_lbl_has[ei] = true
        raw_lbl_x[ei] = rx + loop_w + 6.0 + tb_lw / 2.0
        raw_lbl_y[ei] = n.y
        raw_lbl_w[ei] = tb_lw
        raw_lbl_h[ei] = tb_lh
      }
    } else {
      let nu = nodes[e.u]
      let nv = nodes[e.v]
      let u_bot = nu.y + nu.height / 2.0
      let v_top = nv.y - nv.height / 2.0
      pts.push(Point::{ x: nu.x, y: u_bot })
      if u_bot < rank_bot_y[nu.rank] - 0.5 {
        pts.push(Point::{ x: nu.x, y: rank_bot_y[nu.rank] })
      }
      for d in e.dummy_ids {
        let dr = nodes[d].rank
        let rt = rank_top_y[dr]
        let rb = rank_bot_y[dr]
        if rb - rt > 1.0 {
          pts.push(Point::{ x: nodes[d].x, y: rt })
          pts.push(Point::{ x: nodes[d].x, y: rb })
        } else {
          pts.push(Point::{ x: nodes[d].x, y: nodes[d].y })
        }
      }
      if v_top > rank_top_y[nv.rank] + 0.5 {
        pts.push(Point::{ x: nv.x, y: rank_top_y[nv.rank] })
      }
      pts.push(Point::{ x: nv.x, y: v_top })
      if e.reversed {
        pts.reverse()
      }
      if has_lbl {
        raw_lbl_has[ei] = true
        raw_lbl_w[ei] = tb_lw
        raw_lbl_h[ei] = tb_lh
        if e.label_dummy >= 0 {
          raw_lbl_x[ei] = nodes[e.label_dummy].x
          raw_lbl_y[ei] = nodes[e.label_dummy].y
        } else {
          let mid_idx = pts.length() / 2
          let p1 = pts[mid_idx - 1]
          let p2 = pts[mid_idx]
          raw_lbl_x[ei] = (p1.x + p2.x) / 2.0
          raw_lbl_y[ei] = (p1.y + p2.y) / 2.0
        }
      }
    }
    raw_edge_pts.push(pts)
  }

  // Compute bounding box in normalized TB space (including nodes, groups, edges, AND labels!)
  let mut bb_min_x = 1.0e18
  let mut bb_min_y = 1.0e18
  let mut bb_max_x = -1.0e18
  let mut bb_max_y = -1.0e18
  for i = 0; i < orig_n; i = i + 1 {
    let lx = nodes[i].x - nodes[i].width / 2.0
    let rx = nodes[i].x + nodes[i].width / 2.0
    let ty = nodes[i].y - nodes[i].height / 2.0
    let by = nodes[i].y + nodes[i].height / 2.0
    if lx < bb_min_x { bb_min_x = lx }
    if rx > bb_max_x { bb_max_x = rx }
    if ty < bb_min_y { bb_min_y = ty }
    if by > bb_max_y { bb_max_y = by }
  }
  for gi = 0; gi < num_groups; gi = gi + 1 {
    if group_has[gi] {
      if group_x[gi] < bb_min_x { bb_min_x = group_x[gi] }
      if group_x[gi] + group_w[gi] > bb_max_x { bb_max_x = group_x[gi] + group_w[gi] }
      if group_y[gi] < bb_min_y { bb_min_y = group_y[gi] }
      if group_y[gi] + group_h[gi] > bb_max_y { bb_max_y = group_y[gi] + group_h[gi] }
    }
  }
  for pts in raw_edge_pts {
    for p in pts {
      if p.x < bb_min_x { bb_min_x = p.x }
      if p.x > bb_max_x { bb_max_x = p.x }
      if p.y < bb_min_y { bb_min_y = p.y }
      if p.y > bb_max_y { bb_max_y = p.y }
    }
  }
  for ei = 0; ei < edges.length(); ei = ei + 1 {
    if raw_lbl_has[ei] {
      let lx = raw_lbl_x[ei] - raw_lbl_w[ei] / 2.0
      let rx = raw_lbl_x[ei] + raw_lbl_w[ei] / 2.0
      let ty = raw_lbl_y[ei] - raw_lbl_h[ei] / 2.0
      let by = raw_lbl_y[ei] + raw_lbl_h[ei] / 2.0
      if lx < bb_min_x { bb_min_x = lx }
      if rx > bb_max_x { bb_max_x = rx }
      if ty < bb_min_y { bb_min_y = ty }
      if by > bb_max_y { bb_max_y = by }
    }
  }

  // Transform coordinates for BT / LR / RL and normalize top-left to (margin_x, margin_y)
  let span_y = bb_max_y - bb_min_y
  let out_nodes : Array[LayoutNode] = []
  for i = 0; i < orig_n; i = i + 1 {
    let n = nodes[i]
    let nx0 = n.x - bb_min_x + input.margin_x
    let ny0 = if rev_axis {
      (bb_max_y - n.y) + input.margin_y
    } else {
      (n.y - bb_min_y) + input.margin_y
    }
    let fx = if horiz { ny0 } else { nx0 }
    let fy = if horiz { nx0 } else { ny0 }
    let fw = if horiz { n.height } else { n.width }
    let fh = if horiz { n.width } else { n.height }
    out_nodes.push(LayoutNode::{
      id: n.id,
      label: n.label,
      shape: n.shape,
      x: fx,
      y: fy,
      width: fw,
      height: fh,
      rank: n.rank,
      order: n.order,
      group_id: n.parent,
    })
  }

  let out_groups : Array[LayoutGroup] = []
  for gi = 0; gi < num_groups; gi = gi + 1 {
    if !group_has[gi] {
      continue
    }
    let gx0 = group_x[gi] - bb_min_x + input.margin_x
    let gy0 = if rev_axis {
      (bb_max_y - (group_y[gi] + group_h[gi])) + input.margin_y
    } else {
      (group_y[gi] - bb_min_y) + input.margin_y
    }
    let fgx = if horiz { gy0 } else { gx0 }
    let fgy = if horiz { gx0 } else { gy0 }
    let fgw = if horiz { group_h[gi] } else { group_w[gi] }
    let fgh = if horiz { group_w[gi] } else { group_h[gi] }
    out_groups.push(LayoutGroup::{
      id: input.groups[gi].id,
      title: input.groups[gi].title,
      kind: "subgraph",
      x: fgx,
      y: fgy,
      width: fgw,
      height: fgh,
      parent_id: input.groups[gi].parent,
    })
  }

  let out_edges : Array[LayoutEdge] = []
  let out_labels : Array[LayoutLabel] = []
  for ei = 0; ei < edges.length(); ei = ei + 1 {
    let e = edges[ei]
    let orig_e = input.edges[e.orig_idx]
    let tpts : Array[Point] = []
    for p in raw_edge_pts[ei] {
      let px0 = p.x - bb_min_x + input.margin_x
      let py0 = if rev_axis {
        (bb_max_y - p.y) + input.margin_y
      } else {
        (p.y - bb_min_y) + input.margin_y
      }
      tpts.push(Point::{
        x: if horiz { py0 } else { px0 },
        y: if horiz { px0 } else { py0 },
      })
    }
    out_edges.push(LayoutEdge::{
      id: orig_e.id,
      from: orig_e.from,
      to: orig_e.to,
      label: orig_e.label,
      stroke: orig_e.stroke,
      start_arrow: orig_e.start_arrow,
      end_arrow: orig_e.end_arrow,
      points: tpts,
      reversed: e.reversed,
    })
    if raw_lbl_has[ei] {
      let lx0 = raw_lbl_x[ei] - bb_min_x + input.margin_x
      let ly0 = if rev_axis {
        (bb_max_y - raw_lbl_y[ei]) + input.margin_y
      } else {
        (raw_lbl_y[ei] - bb_min_y) + input.margin_y
      }
      let lw = orig_e.label.length().to_double() * 7.5 + 12.0
      out_labels.push(LayoutLabel::{
        text: orig_e.label,
        x: if horiz { ly0 } else { lx0 },
        y: if horiz { lx0 } else { ly0 },
        width: lw,
        height: 20.0,
        owner_id: orig_e.id,
      })
    }
  }

  let raw_w = (bb_max_x - bb_min_x) + input.margin_x * 2.0
  let raw_h = span_y + input.margin_y * 2.0
  let scene_w = if horiz { raw_h } else { raw_w }
  let scene_h = if horiz { raw_w } else { raw_h }

  Scene::{
    width: scene_w,
    height: scene_h,
    nodes: out_nodes,
    edges: out_edges,
    groups: out_groups,
    labels: out_labels,
  }
}

///|
fn align_layer_x(
  layer : Array[Int],
  nbr_adj : Array[Array[Int]],
  nodes : Array[WorkNode],
  node_sep : Double,
  self_extra_right : Array[Double],
  orig_n : Int,
) -> Unit {
  let m = layer.length()
  if m == 0 {
    return
  }
  let target = Array::make(m, 0.0)
  for j = 0; j < m; j = j + 1 {
    let u = layer[j]
    let nbrs = nbr_adj[u]
    if nbrs.length() > 0 {
      let mut sum = 0.0
      for v in nbrs {
        sum = sum + nodes[v].x
      }
      target[j] = sum / nbrs.length().to_double()
    } else {
      target[j] = nodes[u].x
    }
  }
  nodes[layer[0]].x = target[0]
  for j = 1; j < m; j = j + 1 {
    let prev = layer[j - 1]
    let cur = layer[j]
    let prev_er = if prev < orig_n { self_extra_right[prev] } else { 0.0 }
    let min_x = nodes[prev].x + nodes[prev].width / 2.0 + prev_er + node_sep + nodes[cur].width / 2.0
    nodes[cur].x = if target[j] > min_x { target[j] } else { min_x }
  }
  for j = m - 2; j >= 0; j = j - 1 {
    let cur = layer[j]
    let nxt = layer[j + 1]
    let cur_er = if cur < orig_n { self_extra_right[cur] } else { 0.0 }
    let max_x = nodes[nxt].x - nodes[nxt].width / 2.0 - node_sep - cur_er - nodes[cur].width / 2.0
    if nodes[cur].x > max_x {
      nodes[cur].x = max_x
    }
  }
}
