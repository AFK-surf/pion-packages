///| Pure Pion Sugiyama / Dagre layered graph layout engine.
///| Pipeline:
///|   1. Direction normalization (swap dims for LR/RL)
///|   2. Self-loop extraction
///|   3. DFS feedback arc set (acyclic)
///|   4. Longest-path + source tightening (ranking)
///|   5. Dummy node insertion for long edges (normalization)
///|   6. Barycenter multi-sweep crossing minimization with best-state tracking
///|   7. Neighbor-aligned order-preserving X compaction & Y rank spacing
///|   8. Bottom-up nested subgraph bounding boxes
///|   9. Edge polyline routing, reversal restoration, and direction transform

///|
pub struct GraphNodeInput {
  pub id : String
  pub label : String
  pub shape : String
  pub width : Double
  pub height : Double
  pub parent : Option[String]
}

///|
pub struct GraphEdgeInput {
  pub id : String
  pub from : String
  pub to : String
  pub label : String
  pub stroke : String
  pub start_arrow : String
  pub end_arrow : String
  pub weight : Int
  pub minlen : Int
}

///|
pub struct GraphGroupInput {
  pub id : String
  pub title : String
  pub parent : Option[String]
}

///|
pub struct GraphInput {
  pub direction : Direction
  pub nodes : Array[GraphNodeInput]
  pub edges : Array[GraphEdgeInput]
  pub groups : Array[GraphGroupInput]
  pub node_sep : Double
  pub rank_sep : Double
  pub edge_sep : Double
  pub margin_x : Double
  pub margin_y : Double
}

///|
pub fn default_graph_input(direction : Direction) -> GraphInput {
  GraphInput::{
    direction: direction,
    nodes: [],
    edges: [],
    groups: [],
    node_sep: 40.0,
    rank_sep: 50.0,
    edge_sep: 20.0,
    margin_x: 20.0,
    margin_y: 20.0,
  }
}

///|
struct WorkNode {
  id : String
  label : String
  shape : String
  width : Double
  height : Double
  parent : Option[String]
  is_dummy : Bool
  mut rank : Int
  mut order : Int
  mut x : Double
  mut y : Double
}

///|
struct WorkEdge {
  orig_idx : Int
  mut u : Int
  mut v : Int
  weight : Int
  minlen : Int
  mut reversed : Bool
  is_self : Bool
  dummy_ids : Array[Int]
}

///|
fn is_horizontal_dir(d : Direction) -> Bool {
  d == Direction::LR || d == Direction::RL
}

///|
fn is_reversed_dir(d : Direction) -> Bool {
  d == Direction::BT || d == Direction::RL
}

///|
fn dfs_break_cycles(
  u : Int,
  out_adj : Array[Array[Int]],
  edges : Array[WorkEdge],
  state : Array[Int],
) -> Unit {
  // state: 0 = unvisited, 1 = on stack, 2 = done
  state[u] = 1
  for eidx in out_adj[u] {
    let e = edges[eidx]
    if e.is_self {
      continue
    }
    let v = e.v
    if state[v] == 1 {
      // Back edge -> reverse
      e.reversed = true
      let tmp = e.u
      e.u = e.v
      e.v = tmp
    } else if state[v] == 0 {
      dfs_break_cycles(v, out_adj, edges, state)
    }
  }
  state[u] = 2
}

///|
fn count_two_layer_crossings(
  upper : Array[Int],
  lower : Array[Int],
  out_layer_edges : Array[Array[Int]],
  pos_in_layer : Array[Int],
) -> Int {
  // Collect pairs (u_pos, v_pos) sorted by u_pos (ascending), then v_pos (ascending),
  // and count inversions in v_pos.
  let v_positions : Array[Int] = []
  for u in upper {
    let nbrs = out_layer_edges[u]
    if nbrs.length() == 0 {
      continue
    }
    let tmp : Array[Int] = []
    for v in nbrs {
      tmp.push(pos_in_layer[v])
    }
    tmp.sort()
    for p in tmp {
      v_positions.push(p)
    }
  }
  let m = v_positions.length()
  if m <= 1 {
    return 0
  }
  // Fenwick tree (BIT) over 1..lower.length()
  let sz = lower.length() + 2
  let bit = Array::make(sz, 0)
  let mut crossings = 0
  for i = m - 1; i >= 0; i = i - 1 {
    let p = v_positions[i]
    // Query sum of [0..p-1]
    let mut q = p
    while q > 0 {
      crossings = crossings + bit[q]
      q = q - (q & -q)
    }
    // Add 1 at p + 1
    let mut k = p + 1
    while k < sz {
      bit[k] = bit[k] + 1
      k = k + (k & -k)
    }
  }
  crossings
}

///|
fn count_all_crossings(
  layers : Array[Array[Int]],
  out_layer_edges : Array[Array[Int]],
  pos_in_layer : Array[Int],
) -> Int {
  let mut total = 0
  for r = 0; r + 1 < layers.length(); r = r + 1 {
    total = total + count_two_layer_crossings(layers[r], layers[r + 1], out_layer_edges, pos_in_layer)
  }
  total
}

///|
fn sort_layer_by_barycenter(
  layer : Array[Int],
  adj : Array[Array[Int]],
  pos_in_layer : Array[Int],
  bias_right : Bool,
) -> Unit {
  let m = layer.length()
  if m <= 1 {
    return
  }
  let keys : Array[Double] = Array::make(m, 0.0)
  for i = 0; i < m; i = i + 1 {
    let u = layer[i]
    let nbrs = adj[u]
    if nbrs.length() == 0 {
      keys[i] = i.to_double()
    } else {
      let mut sum = 0.0
      for v in nbrs {
        sum = sum + pos_in_layer[v].to_double()
      }
      keys[i] = sum / nbrs.length().to_double()
    }
  }
  // Insertion sort (stable, fast for typical layer sizes, zero extra allocation)
  for i = 1; i < m; i = i + 1 {
    let kv = keys[i]
    let nv = layer[i]
    let mut j = i - 1
    while j >= 0 {
      let cmp = if bias_right { keys[j] > kv } else { keys[j] >= kv }
      if cmp {
        keys[j + 1] = keys[j]
        layer[j + 1] = layer[j]
        j = j - 1
      } else {
        break
      }
    }
    keys[j + 1] = kv
    layer[j + 1] = nv
  }
  for i = 0; i < m; i = i + 1 {
    pos_in_layer[layer[i]] = i
  }
}

///|
fn copy_layers(layers : Array[Array[Int]]) -> Array[Array[Int]] {
  let out : Array[Array[Int]] = []
  for l in layers {
    out.push(l.copy())
  }
  out
}

///|
pub fn layout_sugiyama(input : GraphInput) -> Scene {
  let orig_n = input.nodes.length()
  if orig_n == 0 {
    return empty_scene()
  }
  let horiz = is_horizontal_dir(input.direction)
  let rev_axis = is_reversed_dir(input.direction)

  // 1. Build working nodes & ID index
  let nodes : Array[WorkNode] = []
  let id_to_idx : Map[String, Int] = Map::new()
  for i = 0; i < orig_n; i = i + 1 {
    let n = input.nodes[i]
    let w = if horiz { n.height } else { n.width }
    let h = if horiz { n.width } else { n.height }
    nodes.push(WorkNode::{
      id: n.id,
      label: n.label,
      shape: n.shape,
      width: w,
      height: h,
      parent: n.parent,
      is_dummy: false,
      rank: 0,
      order: i,
      x: 0.0,
      y: 0.0,
    })
    id_to_idx.set(n.id, i)
  }

  // 2. Build working edges (extracting self-loops)
  let edges : Array[WorkEdge] = []
  let out_adj : Array[Array[Int]] = []
  for i = 0; i < orig_n; i = i + 1 {
    out_adj.push([])
  }
  for i = 0; i < input.edges.length(); i = i + 1 {
    let e = input.edges[i]
    let u = match id_to_idx.get(e.from) {
      Some(idx) => idx
      None => continue
    }
    let v = match id_to_idx.get(e.to) {
      Some(idx) => idx
      None => continue
    }
    let ml = if e.minlen > 0 { e.minlen } else { 1 }
    let wt = if e.weight > 0 { e.weight } else { 1 }
    let eidx = edges.length()
    let is_self = u == v
    edges.push(WorkEdge::{
      orig_idx: i,
      u: u,
      v: v,
      weight: wt,
      minlen: ml,
      reversed: false,
      is_self: is_self,
      dummy_ids: [],
    })
    if !is_self {
      out_adj[u].push(eidx)
    }
  }

  // 3. Acyclic (DFS feedback arc set)
  let in_deg_raw = Array::make(orig_n, 0)
  for e in edges {
    if !e.is_self {
      in_deg_raw[e.v] = in_deg_raw[e.v] + 1
    }
  }
  let dfs_state = Array::make(orig_n, 0)
  // Start DFS from sources first (matches Dagre's dfsFAS)
  for i = 0; i < orig_n; i = i + 1 {
    if in_deg_raw[i] == 0 && dfs_state[i] == 0 {
      dfs_break_cycles(i, out_adj, edges, dfs_state)
    }
  }
  for i = 0; i < orig_n; i = i + 1 {
    if dfs_state[i] == 0 {
      dfs_break_cycles(i, out_adj, edges, dfs_state)
    }
  }

  // 4. Ranking (Longest-Path via Kahn's topological sort + source tightening)
  let dag_out : Array[Array[Int]] = []
  let dag_in_deg = Array::make(orig_n, 0)
  for i = 0; i < orig_n; i = i + 1 {
    dag_out.push([])
  }
  for eidx = 0; eidx < edges.length(); eidx = eidx + 1 {
    let e = edges[eidx]
    if e.is_self {
      continue
    }
    dag_out[e.u].push(eidx)
    dag_in_deg[e.v] = dag_in_deg[e.v] + 1
  }
  let queue : Array[Int] = []
  for i = 0; i < orig_n; i = i + 1 {
    if dag_in_deg[i] == 0 {
      queue.push(i)
    }
  }
  let topo : Array[Int] = []
  let mut qh = 0
  while qh < queue.length() {
    let u = queue[qh]
    qh = qh + 1
    topo.push(u)
    for eidx in dag_out[u] {
      let e = edges[eidx]
      let cand = nodes[u].rank + e.minlen
      if cand > nodes[e.v].rank {
        nodes[e.v].rank = cand
      }
      dag_in_deg[e.v] = dag_in_deg[e.v] - 1
      if dag_in_deg[e.v] == 0 {
        queue.push(e.v)
      }
    }
  }
  // Source tightening: pull sources down toward their minimum successor rank
  let has_in = Array::make(orig_n, false)
  for e in edges {
    if !e.is_self {
      has_in[e.v] = true
    }
  }
  for i = topo.length() - 1; i >= 0; i = i - 1 {
    let u = topo[i]
    if !has_in[u] && dag_out[u].length() > 0 {
      let mut min_target = 1000000000
      for eidx in dag_out[u] {
        let e = edges[eidx]
        let t = nodes[e.v].rank - e.minlen
        if t < min_target {
          min_target = t
        }
      }
      if min_target < 1000000000 && min_target > nodes[u].rank {
        nodes[u].rank = min_target
      }
    }
  }
  // Normalize min rank to 0
  let mut min_rank = 1000000000
  let mut max_rank = 0
  for i = 0; i < orig_n; i = i + 1 {
    if nodes[i].rank < min_rank {
      min_rank = nodes[i].rank
    }
  }
  if min_rank == 1000000000 {
    min_rank = 0
  }
  for i = 0; i < orig_n; i = i + 1 {
    nodes[i].rank = nodes[i].rank - min_rank
    if nodes[i].rank > max_rank {
      max_rank = nodes[i].rank
    }
  }

  // 5. Normalization: insert dummy nodes for edges spanning > 1 rank
  for e in edges {
    if e.is_self {
      continue
    }
    let ru = nodes[e.u].rank
    let rv = nodes[e.v].rank
    if rv - ru > 1 {
      for r = ru + 1; r < rv; r = r + 1 {
        let did = nodes.length()
        nodes.push(WorkNode::{
          id: "__dummy_" + did.to_string(),
          label: "",
          shape: "dummy",
          width: input.edge_sep,
          height: 0.0,
          parent: None,
          is_dummy: true,
          rank: r,
          order: 0,
          x: 0.0,
          y: 0.0,
        })
        e.dummy_ids.push(did)
      }
    }
  }
  let total_n = nodes.length()

  // Build normalized 1-rank adjacency (out_layer_edges & in_layer_edges)
  let out_layer : Array[Array[Int]] = []
  let in_layer : Array[Array[Int]] = []
  for i = 0; i < total_n; i = i + 1 {
    out_layer.push([])
    in_layer.push([])
  }
  for e in edges {
    if e.is_self {
      continue
    }
    if e.dummy_ids.length() == 0 {
      out_layer[e.u].push(e.v)
      in_layer[e.v].push(e.u)
    } else {
      let mut prev = e.u
      for d in e.dummy_ids {
        out_layer[prev].push(d)
        in_layer[d].push(prev)
        prev = d
      }
      out_layer[prev].push(e.v)
      in_layer[e.v].push(prev)
    }
  }

  // 6. Layer Matrix & Crossing Minimization (Barycenter multi-sweep)
  let layers : Array[Array[Int]] = []
  for r = 0; r <= max_rank; r = r + 1 {
    layers.push([])
  }
  for i = 0; i < total_n; i = i + 1 {
    layers[nodes[i].rank].push(i)
  }
  let pos_in_layer = Array::make(total_n, 0)
  for r = 0; r <= max_rank; r = r + 1 {
    for j = 0; j < layers[r].length(); j = j + 1 {
      pos_in_layer[layers[r][j]] = j
    }
  }

  let mut best_layers = copy_layers(layers)
  let mut best_cc = count_all_crossings(layers, out_layer, pos_in_layer)
  let mut no_improve = 0
  let mut sweep = 0
  while sweep < 24 && no_improve < 4 && best_cc > 0 {
    let bias_right = (sweep % 4) >= 2
    if sweep % 2 == 0 {
      // Downward sweep: rank 1..max_rank
      for r = 1; r <= max_rank; r = r + 1 {
        sort_layer_by_barycenter(layers[r], in_layer, pos_in_layer, bias_right)
      }
    } else {
      // Upward sweep: rank max_rank-1..0
      for r = max_rank - 1; r >= 0; r = r - 1 {
        sort_layer_by_barycenter(layers[r], out_layer, pos_in_layer, bias_right)
      }
    }
    let cc = count_all_crossings(layers, out_layer, pos_in_layer)
    if cc < best_cc {
      best_cc = cc
      best_layers = copy_layers(layers)
      no_improve = 0
    } else {
      no_improve = no_improve + 1
    }
    sweep = sweep + 1
  }
  // Commit best order to nodes
  for r = 0; r <= max_rank; r = r + 1 {
    let layer = best_layers[r]
    for j = 0; j < layer.length(); j = j + 1 {
      nodes[layer[j]].order = j
      pos_in_layer[layer[j]] = j
    }
  }

  // 7. Coordinate Assignment (Y by rank height, X by order-preserving neighbor alignment)
  let mut cur_y = input.margin_y
  for r = 0; r <= max_rank; r = r + 1 {
    let layer = best_layers[r]
    let mut max_h = 0.0
    for u in layer {
      if nodes[u].height > max_h {
        max_h = nodes[u].height
      }
    }
    let center_y = cur_y + max_h / 2.0
    for u in layer {
      nodes[u].y = center_y
    }
    cur_y = cur_y + max_h + input.rank_sep
  }

  // Initial left-packed X per layer (centered around 0)
  for r = 0; r <= max_rank; r = r + 1 {
    let layer = best_layers[r]
    let m = layer.length()
    if m == 0 {
      continue
    }
    let mut x = 0.0
    for j = 0; j < m; j = j + 1 {
      let u = layer[j]
      if j == 0 {
        x = nodes[u].width / 2.0
      } else {
        let prev = layer[j - 1]
        x = x + nodes[prev].width / 2.0 + input.node_sep + nodes[u].width / 2.0
      }
      nodes[u].x = x
    }
    // Center this layer around 0
    let first_l = nodes[layer[0]].x - nodes[layer[0]].width / 2.0
    let last_r = nodes[layer[m - 1]].x + nodes[layer[m - 1]].width / 2.0
    let mid = (first_l + last_r) / 2.0
    for u in layer {
      nodes[u].x = nodes[u].x - mid
    }
  }

  // Neighbor-alignment X refinement (4 down/up passes, strictly preserving min separation)
  for iter = 0; iter < 4; iter = iter + 1 {
    // Downward
    for r = 1; r <= max_rank; r = r + 1 {
      align_layer_x(best_layers[r], in_layer, nodes, input.node_sep)
    }
    // Upward
    for r = max_rank - 1; r >= 0; r = r - 1 {
      align_layer_x(best_layers[r], out_layer, nodes, input.node_sep)
    }
  }

  // Shift X so minimum left edge is at margin_x
  let mut min_x = 1.0e18
  for i = 0; i < total_n; i = i + 1 {
    let lx = nodes[i].x - nodes[i].width / 2.0
    if lx < min_x {
      min_x = lx
    }
  }
  let shift_x = input.margin_x - min_x
  for i = 0; i < total_n; i = i + 1 {
    nodes[i].x = nodes[i].x + shift_x
  }

  // 8. Compute bottom-up bounding boxes for groups (in normalized TB space)
  let group_x : Array[Double] = Array::make(input.groups.length(), 0.0)
  let group_y : Array[Double] = Array::make(input.groups.length(), 0.0)
  let group_w : Array[Double] = Array::make(input.groups.length(), 0.0)
  let group_h : Array[Double] = Array::make(input.groups.length(), 0.0)
  let group_has : Array[Bool] = Array::make(input.groups.length(), false)
  let group_idx_map : Map[String, Int] = Map::new()
  for gi = 0; gi < input.groups.length(); gi = gi + 1 {
    group_idx_map.set(input.groups[gi].id, gi)
  }
  let pad_x = 16.0
  let pad_top = 26.0
  let pad_bot = 16.0
  // Reverse order handles nested groups (children declared after parents)
  for gi = input.groups.length() - 1; gi >= 0; gi = gi - 1 {
    let gid = input.groups[gi].id
    let mut g_min_x = 1.0e18
    let mut g_min_y = 1.0e18
    let mut g_max_x = -1.0e18
    let mut g_max_y = -1.0e18
    let mut found = false
    for ni = 0; ni < orig_n; ni = ni + 1 {
      if nodes[ni].parent.unwrap_or("") == gid {
        found = true
        let lx = nodes[ni].x - nodes[ni].width / 2.0
        let rx = nodes[ni].x + nodes[ni].width / 2.0
        let ty = nodes[ni].y - nodes[ni].height / 2.0
        let by = nodes[ni].y + nodes[ni].height / 2.0
        if lx < g_min_x { g_min_x = lx }
        if rx > g_max_x { g_max_x = rx }
        if ty < g_min_y { g_min_y = ty }
        if by > g_max_y { g_max_y = by }
      }
    }
    for cgi = 0; cgi < input.groups.length(); cgi = cgi + 1 {
      if group_has[cgi] && input.groups[cgi].parent.unwrap_or("") == gid {
        found = true
        let lx = group_x[cgi]
        let rx = group_x[cgi] + group_w[cgi]
        let ty = group_y[cgi]
        let by = group_y[cgi] + group_h[cgi]
        if lx < g_min_x { g_min_x = lx }
        if rx > g_max_x { g_max_x = rx }
        if ty < g_min_y { g_min_y = ty }
        if by > g_max_y { g_max_y = by }
      }
    }
    if found {
      group_has[gi] = true
      group_x[gi] = g_min_x - pad_x
      group_y[gi] = g_min_y - pad_top
      group_w[gi] = (g_max_x - g_min_x) + pad_x * 2.0
      group_h[gi] = (g_max_y - g_min_y) + pad_top + pad_bot
    }
  }

  // 9. Build edge polylines (in normalized TB space) and compute bounds
  let raw_edge_pts : Array[Array[Point]] = []
  for e in edges {
    let pts : Array[Point] = []
    if e.is_self {
      let n = nodes[e.u]
      let rx = n.x + n.width / 2.0
      let loop_w = 28.0
      let loop_h = if n.height > 20.0 { n.height * 0.35 } else { 12.0 }
      pts.push(Point::{ x: rx, y: n.y - loop_h })
      pts.push(Point::{ x: rx + loop_w, y: n.y - loop_h })
      pts.push(Point::{ x: rx + loop_w, y: n.y + loop_h })
      pts.push(Point::{ x: rx, y: n.y + loop_h })
    } else {
      let nu = nodes[e.u]
      let nv = nodes[e.v]
      pts.push(Point::{ x: nu.x, y: nu.y + nu.height / 2.0 })
      for d in e.dummy_ids {
        pts.push(Point::{ x: nodes[d].x, y: nodes[d].y })
      }
      pts.push(Point::{ x: nv.x, y: nv.y - nv.height / 2.0 })
      if e.reversed {
        pts.reverse()
      }
    }
    raw_edge_pts.push(pts)
  }

  // Compute bounding box in normalized TB space
  let mut bb_min_x = 1.0e18
  let mut bb_min_y = 1.0e18
  let mut bb_max_x = -1.0e18
  let mut bb_max_y = -1.0e18
  for i = 0; i < orig_n; i = i + 1 {
    let lx = nodes[i].x - nodes[i].width / 2.0
    let rx = nodes[i].x + nodes[i].width / 2.0
    let ty = nodes[i].y - nodes[i].height / 2.0
    let by = nodes[i].y + nodes[i].height / 2.0
    if lx < bb_min_x { bb_min_x = lx }
    if rx > bb_max_x { bb_max_x = rx }
    if ty < bb_min_y { bb_min_y = ty }
    if by > bb_max_y { bb_max_y = by }
  }
  for gi = 0; gi < input.groups.length(); gi = gi + 1 {
    if group_has[gi] {
      if group_x[gi] < bb_min_x { bb_min_x = group_x[gi] }
      if group_x[gi] + group_w[gi] > bb_max_x { bb_max_x = group_x[gi] + group_w[gi] }
      if group_y[gi] < bb_min_y { bb_min_y = group_y[gi] }
      if group_y[gi] + group_h[gi] > bb_max_y { bb_max_y = group_y[gi] + group_h[gi] }
    }
  }
  for pts in raw_edge_pts {
    for p in pts {
      if p.x < bb_min_x { bb_min_x = p.x }
      if p.x > bb_max_x { bb_max_x = p.x }
      if p.y < bb_min_y { bb_min_y = p.y }
      if p.y > bb_max_y { bb_max_y = p.y }
    }
  }

  // Transform coordinates for BT / LR / RL and normalize top-left to (margin_x, margin_y)
  let span_y = bb_max_y - bb_min_y
  let out_nodes : Array[LayoutNode] = []
  for i = 0; i < orig_n; i = i + 1 {
    let n = nodes[i]
    let nx0 = n.x - bb_min_x + input.margin_x
    let ny0 = if rev_axis {
      (bb_max_y - n.y) + input.margin_y
    } else {
      (n.y - bb_min_y) + input.margin_y
    }
    let fx = if horiz { ny0 } else { nx0 }
    let fy = if horiz { nx0 } else { ny0 }
    let fw = if horiz { n.height } else { n.width }
    let fh = if horiz { n.width } else { n.height }
    out_nodes.push(LayoutNode::{
      id: n.id,
      label: n.label,
      shape: n.shape,
      x: fx,
      y: fy,
      width: fw,
      height: fh,
      rank: n.rank,
      order: n.order,
      group_id: n.parent,
    })
  }

  let out_groups : Array[LayoutGroup] = []
  for gi = 0; gi < input.groups.length(); gi = gi + 1 {
    if !group_has[gi] {
      continue
    }
    let gx0 = group_x[gi] - bb_min_x + input.margin_x
    let gy0 = if rev_axis {
      (bb_max_y - (group_y[gi] + group_h[gi])) + input.margin_y
    } else {
      (group_y[gi] - bb_min_y) + input.margin_y
    }
    let fgx = if horiz { gy0 } else { gx0 }
    let fgy = if horiz { gx0 } else { gy0 }
    let fgw = if horiz { group_h[gi] } else { group_w[gi] }
    let fgh = if horiz { group_w[gi] } else { group_h[gi] }
    out_groups.push(LayoutGroup::{
      id: input.groups[gi].id,
      title: input.groups[gi].title,
      kind: "subgraph",
      x: fgx,
      y: fgy,
      width: fgw,
      height: fgh,
      parent_id: input.groups[gi].parent,
    })
  }

  let out_edges : Array[LayoutEdge] = []
  let out_labels : Array[LayoutLabel] = []
  for ei = 0; ei < edges.length(); ei = ei + 1 {
    let e = edges[ei]
    let orig_e = input.edges[e.orig_idx]
    let tpts : Array[Point] = []
    for p in raw_edge_pts[ei] {
      let px0 = p.x - bb_min_x + input.margin_x
      let py0 = if rev_axis {
        (bb_max_y - p.y) + input.margin_y
      } else {
        (p.y - bb_min_y) + input.margin_y
      }
      tpts.push(Point::{
        x: if horiz { py0 } else { px0 },
        y: if horiz { px0 } else { py0 },
      })
    }
    out_edges.push(LayoutEdge::{
      id: orig_e.id,
      from: orig_e.from,
      to: orig_e.to,
      label: orig_e.label,
      stroke: orig_e.stroke,
      start_arrow: orig_e.start_arrow,
      end_arrow: orig_e.end_arrow,
      points: tpts,
      reversed: e.reversed,
    })
    if orig_e.label.length() > 0 && tpts.length() >= 2 {
      let mid_idx = tpts.length() / 2
      let p1 = tpts[mid_idx - 1]
      let p2 = tpts[mid_idx]
      let lx = (p1.x + p2.x) / 2.0
      let ly = (p1.y + p2.y) / 2.0
      let lw = orig_e.label.length().to_double() * 7.5 + 12.0
      out_labels.push(LayoutLabel::{
        text: orig_e.label,
        x: lx,
        y: ly,
        width: lw,
        height: 20.0,
        owner_id: orig_e.id,
      })
    }
  }

  let raw_w = (bb_max_x - bb_min_x) + input.margin_x * 2.0
  let raw_h = span_y + input.margin_y * 2.0
  let scene_w = if horiz { raw_h } else { raw_w }
  let scene_h = if horiz { raw_w } else { raw_h }

  Scene::{
    width: scene_w,
    height: scene_h,
    nodes: out_nodes,
    edges: out_edges,
    groups: out_groups,
    labels: out_labels,
  }
}

///|
fn align_layer_x(
  layer : Array[Int],
  nbr_adj : Array[Array[Int]],
  nodes : Array[WorkNode],
  node_sep : Double,
) -> Unit {
  let m = layer.length()
  if m == 0 {
    return
  }
  let target = Array::make(m, 0.0)
  for j = 0; j < m; j = j + 1 {
    let u = layer[j]
    let nbrs = nbr_adj[u]
    if nbrs.length() > 0 {
      let mut sum = 0.0
      for v in nbrs {
        sum = sum + nodes[v].x
      }
      target[j] = sum / nbrs.length().to_double()
    } else {
      target[j] = nodes[u].x
    }
  }
  // Left-to-right pass enforcing strict separation
  nodes[layer[0]].x = target[0]
  for j = 1; j < m; j = j + 1 {
    let prev = layer[j - 1]
    let cur = layer[j]
    let min_x = nodes[prev].x + nodes[prev].width / 2.0 + node_sep + nodes[cur].width / 2.0
    nodes[cur].x = if target[j] > min_x { target[j] } else { min_x }
  }
  // Right-to-left compaction pass
  for j = m - 2; j >= 0; j = j - 1 {
    let cur = layer[j]
    let nxt = layer[j + 1]
    let max_x = nodes[nxt].x - nodes[nxt].width / 2.0 - node_sep - nodes[cur].width / 2.0
    if nodes[cur].x > max_x {
      nodes[cur].x = max_x
    }
  }
}
