///| Unified 2D Scene IR, layout dispatcher, and layout quality metrics.

///|
pub val struct Point {
  pub x : Double
  pub y : Double
}

///|
pub struct LayoutNode {
  pub id : String
  pub label : String
  pub shape : String
  pub x : Double
  pub y : Double
  pub width : Double
  pub height : Double
  pub rank : Int
  pub order : Int
  pub group_id : Option[String]
}

///|
pub struct LayoutEdge {
  pub id : String
  pub from : String
  pub to : String
  pub label : String
  pub stroke : String
  pub start_arrow : String
  pub end_arrow : String
  pub points : Array[Point]
  pub reversed : Bool
}

///|
pub struct LayoutGroup {
  pub id : String
  pub title : String
  pub kind : String
  pub x : Double
  pub y : Double
  pub width : Double
  pub height : Double
  pub parent_id : Option[String]
}

///|
pub struct LayoutLabel {
  pub text : String
  pub x : Double
  pub y : Double
  pub width : Double
  pub height : Double
  pub owner_id : String
}

///|
pub struct Scene {
  pub width : Double
  pub height : Double
  pub nodes : Array[LayoutNode]
  pub edges : Array[LayoutEdge]
  pub groups : Array[LayoutGroup]
  pub labels : Array[LayoutLabel]
}

///|
pub val struct LayoutMetrics {
  pub crossings : Int
  pub total_edge_length : Double
  pub area : Double
  pub reversed_edges : Int
}

///|
pub fn empty_scene() -> Scene {
  Scene::{ width: 0.0, height: 0.0, nodes: [], edges: [], groups: [], labels: [] }
}

///|
fn node_shape_str(s : NodeShape) -> String {
  match s {
    NodeShape::Rect => "rect"
    NodeShape::Round => "round"
    NodeShape::Stadium => "stadium"
    NodeShape::Subroutine => "subroutine"
    NodeShape::Cylinder => "cylinder"
    NodeShape::Circle => "circle"
    NodeShape::DoubleCircle => "double_circle"
    NodeShape::Diamond => "diamond"
    NodeShape::Hexagon => "hexagon"
    NodeShape::Asymmetric => "asymmetric"
    NodeShape::Parallelogram => "parallelogram"
    NodeShape::ParallelogramAlt => "parallelogram_alt"
    NodeShape::Trapezoid => "trapezoid"
    NodeShape::TrapezoidAlt => "trapezoid_alt"
  }
}

///|
fn edge_stroke_str(s : EdgeStroke) -> String {
  match s {
    EdgeStroke::Solid => "solid"
    EdgeStroke::Dotted => "dotted"
    EdgeStroke::Thick => "thick"
    EdgeStroke::Invisible => "invisible"
  }
}

///|
fn arrow_head_str(a : ArrowHead) -> String {
  match a {
    ArrowHead::None => "none"
    ArrowHead::Arrow => "arrow"
    ArrowHead::Circle => "circle"
    ArrowHead::Cross => "cross"
    ArrowHead::Open => "open"
  }
}

///|
fn estimate_box(label : String, min_w : Double, min_h : Double) -> (Double, Double) {
  let w = label.length().to_double() * 8.0 + 28.0
  let fw = if w > min_w { w } else { min_w }
  (fw, min_h)
}

///|
fn layout_flowchart(fc : FlowchartDiagram) -> Scene {
  let g = default_graph_input(fc.direction)
  for sg in fc.subgraphs {
    g.groups.push(GraphGroupInput::{ id: sg.id, title: sg.title, parent: sg.parent })
  }
  for n in fc.nodes {
    let (bw, bh) = estimate_box(n.label, 72.0, 38.0)
    let (w, h) = match n.shape {
      NodeShape::Circle | NodeShape::DoubleCircle => {
        let d = if bw > bh { bw } else { bh }
        (d, d)
      }
      NodeShape::Diamond => (bw + 24.0, bh + 20.0)
      _ => (bw, bh)
    }
    g.nodes.push(GraphNodeInput::{
      id: n.id,
      label: n.label,
      shape: node_shape_str(n.shape),
      width: w,
      height: h,
      parent: n.subgraph,
    })
  }
  for i = 0; i < fc.edges.length(); i = i + 1 {
    let e = fc.edges[i]
    let eid = e.id.unwrap_or("e" + i.to_string())
    g.edges.push(GraphEdgeInput::{
      id: eid,
      from: e.from,
      to: e.to,
      label: e.label,
      stroke: edge_stroke_str(e.stroke),
      start_arrow: arrow_head_str(e.start_arrow),
      end_arrow: arrow_head_str(e.end_arrow),
      weight: 1,
      minlen: e.minlen,
    })
  }
  layout_sugiyama(g)
}

///|
fn layout_state(st : StateDiagram) -> Scene {
  let g = default_graph_input(st.direction)
  let comp_ids : Map[String, Bool] = Map::new()
  for s in st.states {
    if s.kind == StateKind::Composite {
      comp_ids.set(s.id, true)
      g.groups.push(GraphGroupInput::{ id: s.id, title: s.label, parent: s.parent })
    }
  }
  for s in st.states {
    if s.kind == StateKind::Composite {
      continue
    }
    let (w, h, sh) = match s.kind {
      StateKind::Start => (20.0, 20.0, "start")
      StateKind::End => (24.0, 24.0, "end")
      StateKind::Choice => (32.0, 32.0, "diamond")
      StateKind::Fork | StateKind::Join => (72.0, 12.0, "bar")
      _ => {
        let (bw, bh) = estimate_box(s.label, 80.0, 38.0)
        (bw, bh + s.descriptions.length().to_double() * 16.0, "round")
      }
    }
    g.nodes.push(GraphNodeInput::{
      id: s.id,
      label: s.label,
      shape: sh,
      width: w,
      height: h,
      parent: s.parent,
    })
  }
  // If a transition targets a composite state, attach to its first child node if available
  let first_child : Map[String, String] = Map::new()
  for s in st.states {
    if s.kind != StateKind::Composite && s.parent.is_some() {
      let p = s.parent.unwrap_or("")
      if first_child.get(p).is_none() {
        first_child.set(p, s.id)
      }
    }
  }
  for i = 0; i < st.transitions.length(); i = i + 1 {
    let t = st.transitions[i]
    let from_id = if comp_ids.get(t.from).is_some() {
      first_child.get(t.from).unwrap_or(t.from)
    } else {
      t.from
    }
    let to_id = if comp_ids.get(t.to).is_some() {
      first_child.get(t.to).unwrap_or(t.to)
    } else {
      t.to
    }
    g.edges.push(GraphEdgeInput::{
      id: "t" + i.to_string(),
      from: from_id,
      to: to_id,
      label: t.label,
      stroke: "solid",
      start_arrow: "none",
      end_arrow: "arrow",
      weight: 1,
      minlen: 1,
    })
  }
  layout_sugiyama(g)
}

///|
fn layout_class(cd : ClassDiagram) -> Scene {
  let g = default_graph_input(cd.direction)
  let ns_seen : Map[String, Bool] = Map::new()
  for c in cd.classes {
    if c.namespace_name.is_some() {
      let ns = c.namespace_name.unwrap_or("")
      if ns_seen.get(ns).is_none() {
        ns_seen.set(ns, true)
        g.groups.push(GraphGroupInput::{ id: ns, title: ns, parent: None })
      }
    }
  }
  for c in cd.classes {
    let mut max_len = c.label.length()
    for m in c.members {
      if m.text.length() + 2 > max_len {
        max_len = m.text.length() + 2
      }
    }
    let w = {
      let est = max_len.to_double() * 7.8 + 28.0
      if est > 110.0 { est } else { 110.0 }
    }
    let h = 38.0 + c.members.length().to_double() * 18.0 + (if c.annotation.length() > 0 { 16.0 } else { 0.0 })
    g.nodes.push(GraphNodeInput::{
      id: c.id,
      label: c.label,
      shape: "class",
      width: w,
      height: h,
      parent: c.namespace_name,
    })
  }
  for i = 0; i < cd.relations.length(); i = i + 1 {
    let r = cd.relations[i]
    let stroke = match r.kind {
      ClassRelationKind::Dependency | ClassRelationKind::Realization => "dotted"
      _ => "solid"
    }
    g.edges.push(GraphEdgeInput::{
      id: "r" + i.to_string(),
      from: r.from,
      to: r.to,
      label: r.label,
      stroke: stroke,
      start_arrow: "none",
      end_arrow: "arrow",
      weight: 1,
      minlen: 1,
    })
  }
  layout_sugiyama(g)
}

///|
fn layout_er(ed : ErDiagram) -> Scene {
  let g = default_graph_input(ed.direction)
  for e in ed.entities {
    let title = if e.alias.length() > 0 { e.alias } else { e.id }
    let mut max_len = title.length()
    for a in e.attributes {
      let alen = a.attr_type.length() + a.name.length() + 4
      if alen > max_len {
        max_len = alen
      }
    }
    let w = {
      let est = max_len.to_double() * 8.0 + 32.0
      if est > 110.0 { est } else { 110.0 }
    }
    let h = 36.0 + e.attributes.length().to_double() * 18.0
    g.nodes.push(GraphNodeInput::{
      id: e.id,
      label: title,
      shape: "entity",
      width: w,
      height: h,
      parent: None,
    })
  }
  for i = 0; i < ed.relations.length(); i = i + 1 {
    let r = ed.relations[i]
    g.edges.push(GraphEdgeInput::{
      id: "er" + i.to_string(),
      from: r.from,
      to: r.to,
      label: r.label,
      stroke: if r.identifying { "solid" } else { "dotted" },
      start_arrow: "none",
      end_arrow: "none",
      weight: 1,
      minlen: 1,
    })
  }
  layout_sugiyama(g)
}

///|
pub fn layout(diagram : Diagram) -> Scene {
  match diagram {
    Diagram::Flowchart(fc) => layout_flowchart(fc)
    Diagram::Sequence(sd) => layout_sequence(sd)
    Diagram::State(st) => layout_state(st)
    Diagram::Class(cd) => layout_class(cd)
    Diagram::Er(ed) => layout_er(ed)
  }
}

///|
fn orient2d(a : Point, b : Point, c : Point) -> Double {
  (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)
}

///|
fn segments_properly_intersect(a : Point, b : Point, c : Point, d : Point) -> Bool {
  let eps = 1.0e-6
  let o1 = orient2d(a, b, c)
  let o2 = orient2d(a, b, d)
  let o3 = orient2d(c, d, a)
  let o4 = orient2d(c, d, b)
  ((o1 > eps && o2 < -eps) || (o1 < -eps && o2 > eps)) &&
  ((o3 > eps && o4 < -eps) || (o3 < -eps && o4 > eps))
}

///|
pub fn measure_layout(scene : Scene) -> LayoutMetrics {
  let mut total_len = 0.0
  let mut rev_cnt = 0
  let seg_a : Array[Point] = []
  let seg_b : Array[Point] = []
  let seg_edge : Array[Int] = []
  for ei = 0; ei < scene.edges.length(); ei = ei + 1 {
    let e = scene.edges[ei]
    if e.reversed {
      rev_cnt = rev_cnt + 1
    }
    let pts = e.points
    for k = 0; k + 1 < pts.length(); k = k + 1 {
      let p1 = pts[k]
      let p2 = pts[k + 1]
      let dx = p2.x - p1.x
      let dy = p2.y - p1.y
      total_len = total_len + (dx * dx + dy * dy).sqrt()
      seg_a.push(p1)
      seg_b.push(p2)
      seg_edge.push(ei)
    }
  }
  let mut crossings = 0
  let m = seg_a.length()
  for i = 0; i < m; i = i + 1 {
    for j = i + 1; j < m; j = j + 1 {
      if seg_edge[i] == seg_edge[j] {
        continue
      }
      if segments_properly_intersect(seg_a[i], seg_b[i], seg_a[j], seg_b[j]) {
        crossings = crossings + 1
      }
    }
  }
  LayoutMetrics::{
    crossings: crossings,
    total_edge_length: total_len,
    area: scene.width * scene.height,
    reversed_edges: rev_cnt,
  }
}
