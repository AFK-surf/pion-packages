///| Unified 2D Scene IR and top-level layout dispatcher.

///|
pub val struct Point {
  pub x : Double
  pub y : Double
}

///|
pub struct LayoutNode {
  pub id : String
  pub label : String
  pub shape : String
  pub x : Double
  pub y : Double
  pub width : Double
  pub height : Double
  pub rank : Int
  pub order : Int
  pub group_id : Option[String]
}

///|
pub struct LayoutEdge {
  pub id : String
  pub from : String
  pub to : String
  pub label : String
  pub stroke : String
  pub start_arrow : String
  pub end_arrow : String
  pub points : Array[Point]
  pub reversed : Bool
}

///|
pub struct LayoutGroup {
  pub id : String
  pub title : String
  pub kind : String
  pub x : Double
  pub y : Double
  pub width : Double
  pub height : Double
  pub parent_id : Option[String]
}

///|
pub struct LayoutLabel {
  pub text : String
  pub x : Double
  pub y : Double
  pub width : Double
  pub height : Double
  pub owner_id : String
}

///|
pub struct Scene {
  pub width : Double
  pub height : Double
  pub nodes : Array[LayoutNode]
  pub edges : Array[LayoutEdge]
  pub groups : Array[LayoutGroup]
  pub labels : Array[LayoutLabel]
}

///|
pub val struct LayoutMetrics {
  pub crossings : Int
  pub total_edge_length : Double
  pub area : Double
  pub reversed_edges : Int
}

///|
pub fn empty_scene() -> Scene {
  Scene::{ width: 0.0, height: 0.0, nodes: [], edges: [], groups: [], labels: [] }
}

///|
pub fn layout(diagram : Diagram) -> Scene {
  let _ = diagram
  empty_scene()
}

///|
pub fn measure_layout(scene : Scene) -> LayoutMetrics {
  let _ = scene
  LayoutMetrics::{ crossings: 0, total_edge_length: 0.0, area: 0.0, reversed_edges: 0 }
}
