///| Shared lexical, string scanning, and escaping utilities (zero-World, pure Pion).

///|
pub val struct SourceLine {
  pub line_no : Int
  pub text : String
}

///|
pub fn byte_at(s : String, i : Int) -> Int {
  s.code_unit_at(i).to_int()
}

///|
pub fn is_space_byte(b : Int) -> Bool {
  b == 32 || b == 9 || b == 13
}

///|
pub fn is_alpha_byte(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

///|
pub fn is_digit_byte(b : Int) -> Bool {
  b >= 48 && b <= 57
}

///|
pub fn is_ident_byte(b : Int) -> Bool {
  is_alpha_byte(b) || is_digit_byte(b) || b == 95 || b == 45 || b >= 128
}

///|
pub fn is_flow_id_byte(b : Int) -> Bool {
  is_alpha_byte(b) || is_digit_byte(b) || b == 95 || b == 45 || b == 46 || b >= 128
}

///|
pub fn strip_line_comment(line : String) -> String {
  let n = line.length()
  let mut in_quote = false
  let mut esc = false
  for i = 0; i < n; i = i + 1 {
    let b = byte_at(line, i)
    if esc {
      esc = false
      continue
    }
    if b == 92 && in_quote {
      esc = true
      continue
    }
    if b == 34 {
      in_quote = !in_quote
      continue
    }
    if !in_quote && b == 37 && i + 1 < n && byte_at(line, i + 1) == 37 {
      return line.slice(0, i)
    }
  }
  line
}

///|
pub fn split_source_lines(src : String) -> Array[SourceLine] {
  let out : Array[SourceLine] = []
  let n = src.length()
  let mut start = 0
  let mut line_no = 1
  for i = 0; i <= n; i = i + 1 {
    if i == n || byte_at(src, i) == 10 {
      let mut end = i
      if end > start && byte_at(src, end - 1) == 13 {
        end = end - 1
      }
      let raw = src.slice(start, end)
      out.push(SourceLine::{ line_no: line_no, text: raw })
      start = i + 1
      line_no = line_no + 1
    }
  }
  out
}

///|
pub fn split_semicolons(line : String) -> Array[String] {
  let out : Array[String] = []
  let n = line.length()
  let mut start = 0
  let mut in_quote = false
  let mut esc = false
  let mut depth_sq = 0
  let mut depth_par = 0
  let mut depth_cur = 0
  for i = 0; i < n; i = i + 1 {
    let b = byte_at(line, i)
    if esc {
      esc = false
      continue
    }
    if b == 92 && in_quote {
      esc = true
      continue
    }
    if b == 34 {
      in_quote = !in_quote
      continue
    }
    if !in_quote {
      if b == 91 {
        depth_sq = depth_sq + 1
      } else if b == 93 && depth_sq > 0 {
        depth_sq = depth_sq - 1
      } else if b == 40 {
        depth_par = depth_par + 1
      } else if b == 41 && depth_par > 0 {
        depth_par = depth_par - 1
      } else if b == 123 {
        depth_cur = depth_cur + 1
      } else if b == 125 && depth_cur > 0 {
        depth_cur = depth_cur - 1
      } else if b == 59 && depth_sq == 0 && depth_par == 0 && depth_cur == 0 {
        let part = line.slice(start, i).trim()
        if part.length() > 0 {
          out.push(part)
        }
        start = i + 1
      }
    }
  }
  let tail = line.slice(start, n).trim()
  if tail.length() > 0 {
    out.push(tail)
  }
  out
}

///|
fn write_utf8_codepoint(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    sb.write_byte(b'\xef')
    sb.write_byte(b'\xbf')
    sb.write_byte(b'\xbd')
  } else if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///|
fn lookup_mermaid_entity(name : String) -> Option[String] {
  if name == "quot" {
    Some("\"")
  } else if name == "amp" {
    Some("&")
  } else if name == "lt" {
    Some("<")
  } else if name == "gt" {
    Some(">")
  } else if name == "apos" {
    Some("'")
  } else if name == "nbsp" {
    Some(" ")
  } else if name == "infin" {
    Some("∞")
  } else if name == "hearts" {
    Some("♥")
  } else if name == "copy" {
    Some("©")
  } else if name == "reg" {
    Some("®")
  } else if name == "mdash" {
    Some("—")
  } else if name == "ndash" {
    Some("–")
  } else if name == "hellip" {
    Some("…")
  } else if name == "bull" {
    Some("•")
  } else if name == "deg" {
    Some("°")
  } else if name == "times" {
    Some("×")
  } else if name == "divide" {
    Some("÷")
  } else if name == "larr" {
    Some("←")
  } else if name == "rarr" {
    Some("→")
  } else if name == "uarr" {
    Some("↑")
  } else if name == "darr" {
    Some("↓")
  } else if name == "harr" {
    Some("↔")
  } else {
    None
  }
}

///|
pub fn decode_mermaid_entities(s : String) -> String {
  if !s.contains("#") {
    return s
  }
  let n = s.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let b = byte_at(s, i)
    if b == 35 {
      // Find closing ';' within 16 chars
      let mut semi = -1
      let limit = if i + 16 < n { i + 16 } else { n }
      for k = i + 1; k < limit; k = k + 1 {
        let kb = byte_at(s, k)
        if kb == 59 {
          semi = k
          break
        }
        if !is_alpha_byte(kb) && !is_digit_byte(kb) {
          break
        }
      }
      if semi > i + 1 {
        let code = s.slice(i + 1, semi)
        let first = byte_at(code, 0)
        if is_digit_byte(first) {
          let mut cp = 0
          let mut ok = true
          for k = 0; k < code.length(); k = k + 1 {
            let db = byte_at(code, k)
            if is_digit_byte(db) {
              cp = cp * 10 + (db - 48)
            } else {
              ok = false
              break
            }
          }
          if ok && cp > 0 && cp <= 0x10FFFF {
            write_utf8_codepoint(sb, cp)
            i = semi + 1
            continue
          }
        } else if (first == 120 || first == 88) && code.length() >= 2 {
          let mut cp = 0
          let mut ok = true
          for k = 1; k < code.length(); k = k + 1 {
            let hb = byte_at(code, k)
            if is_digit_byte(hb) {
              cp = cp * 16 + (hb - 48)
            } else if hb >= 65 && hb <= 70 {
              cp = cp * 16 + (hb - 55)
            } else if hb >= 97 && hb <= 102 {
              cp = cp * 16 + (hb - 87)
            } else {
              ok = false
              break
            }
          }
          if ok && cp > 0 && cp <= 0x10FFFF {
            write_utf8_codepoint(sb, cp)
            i = semi + 1
            continue
          }
        } else {
          match lookup_mermaid_entity(code) {
            Some(rep) => {
              sb.write_string(rep)
              i = semi + 1
              continue
            }
            None => ()
          }
        }
      }
    }
    sb.write_byte(b.to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn unquote_string(raw : String) -> String {
  let s = raw.trim()
  let n = s.length()
  let inner = if n >= 2 && byte_at(s, 0) == 34 && byte_at(s, n - 1) == 34 {
    let sb = StringBuilder::new()
    let mut i = 1
    while i < n - 1 {
      let b = byte_at(s, i)
      if b == 92 && i + 1 < n - 1 {
        let nxt = byte_at(s, i + 1)
        if nxt == 34 {
          sb.write_byte(b'"')
        } else if nxt == 92 {
          sb.write_byte(b'\\')
        } else if nxt == 110 {
          sb.write_string("\\n")
        } else {
          sb.write_string(s.slice(i + 1, i + 2))
        }
        i = i + 2
      } else {
        sb.write_string(s.slice(i, i + 1))
        i = i + 1
      }
    }
    sb.to_string()
  } else {
    s
  }
  let stripped = if inner.length() >= 2 && byte_at(inner, 0) == 96 && byte_at(inner, inner.length() - 1) == 96 {
    inner.slice(1, inner.length() - 1)
  } else {
    inner
  }
  decode_mermaid_entities(stripped)
}

///|
pub fn parse_direction_opt(word : String) -> Option[Direction] {
  let w = word.trim()
  if w == "TD" || w == "TB" {
    Some(Direction::TB)
  } else if w == "BT" {
    Some(Direction::BT)
  } else if w == "LR" {
    Some(Direction::LR)
  } else if w == "RL" {
    Some(Direction::RL)
  } else {
    None
  }
}

///|
pub fn direction_to_string(d : Direction) -> String {
  match d {
    Direction::TB => "TB"
    Direction::BT => "BT"
    Direction::LR => "LR"
    Direction::RL => "RL"
  }
}

///|
pub fn split_words(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    while i < n && is_space_byte(byte_at(s, i)) {
      i = i + 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && !is_space_byte(byte_at(s, i)) {
      i = i + 1
    }
    out.push(s.slice(start, i))
  }
  out
}

///|
pub fn find_char_outside_quotes(s : String, ch : Int, start : Int) -> Int {
  let n = s.length()
  let mut in_q = false
  let mut esc = false
  for i = start; i < n; i = i + 1 {
    let b = byte_at(s, i)
    if esc {
      esc = false
      continue
    }
    if b == 92 && in_q {
      esc = true
      continue
    }
    if b == 34 {
      in_q = !in_q
      continue
    }
    if !in_q && b == ch {
      return i
    }
  }
  -1
}

///|
fn hex_nibble(v : Int) -> Byte {
  let d = v & 15
  if d < 10 {
    (48 + d).to_byte()
  } else {
    (97 + d - 10).to_byte()
  }
}

///|
fn utf8_seq_len(s : String, i : Int, n : Int) -> Int {
  let b0 = byte_at(s, i)
  if b0 < 0x80 {
    return 1
  }
  if b0 >= 0xC2 && b0 <= 0xDF {
    if i + 1 < n {
      let b1 = byte_at(s, i + 1)
      if (b1 & 0xC0) == 0x80 {
        return 2
      }
    }
    return 0
  }
  if b0 >= 0xE0 && b0 <= 0xEF {
    if i + 2 < n {
      let b1 = byte_at(s, i + 1)
      let b2 = byte_at(s, i + 2)
      if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
        if (b0 == 0xE0 && b1 < 0xA0) || (b0 == 0xED && b1 >= 0xA0) {
          return 0
        }
        return 3
      }
    }
    return 0
  }
  if b0 >= 0xF0 && b0 <= 0xF4 {
    if i + 3 < n {
      let b1 = byte_at(s, i + 1)
      let b2 = byte_at(s, i + 2)
      let b3 = byte_at(s, i + 3)
      if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
        if (b0 == 0xF0 && b1 < 0x90) || (b0 == 0xF4 && b1 >= 0x90) {
          return 0
        }
        return 4
      }
    }
    return 0
  }
  0
}

///|
pub fn json_escape(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::new()
  sb.write_byte(b'"')
  let mut i = 0
  while i < n {
    let b = byte_at(s, i)
    if b == 34 {
      sb.write_string("\\\"")
      i = i + 1
    } else if b == 92 {
      sb.write_string("\\\\")
      i = i + 1
    } else if b == 10 {
      sb.write_string("\\n")
      i = i + 1
    } else if b == 13 {
      sb.write_string("\\r")
      i = i + 1
    } else if b == 9 {
      sb.write_string("\\t")
      i = i + 1
    } else if b < 32 {
      sb.write_string("\\u00")
      sb.write_byte(hex_nibble(b >> 4))
      sb.write_byte(hex_nibble(b))
      i = i + 1
    } else if b < 128 {
      sb.write_byte(b.to_byte())
      i = i + 1
    } else {
      let slen = utf8_seq_len(s, i, n)
      if slen > 0 {
        for k = 0; k < slen; k = k + 1 {
          sb.write_byte(byte_at(s, i + k).to_byte())
        }
        i = i + slen
      } else {
        sb.write_byte(b'\xef')
        sb.write_byte(b'\xbf')
        sb.write_byte(b'\xbd')
        i = i + 1
      }
    }
  }
  sb.write_byte(b'"')
  sb.to_string()
}

///|
pub fn xml_escape(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let b = byte_at(s, i)
    if b == 38 {
      sb.write_string("&amp;")
      i = i + 1
    } else if b == 60 {
      sb.write_string("&lt;")
      i = i + 1
    } else if b == 62 {
      sb.write_string("&gt;")
      i = i + 1
    } else if b == 34 {
      sb.write_string("&quot;")
      i = i + 1
    } else if b == 39 {
      sb.write_string("&apos;")
      i = i + 1
    } else if b < 32 {
      // XML 1.0 permits only TAB (9), LF (10), CR (13) among C0 control chars
      if b == 9 || b == 10 || b == 13 {
        sb.write_byte(b.to_byte())
      }
      i = i + 1
    } else if b < 128 {
      sb.write_byte(b.to_byte())
      i = i + 1
    } else {
      let slen = utf8_seq_len(s, i, n)
      if slen > 0 {
        for k = 0; k < slen; k = k + 1 {
          sb.write_byte(byte_at(s, i + k).to_byte())
        }
        i = i + slen
      } else {
        sb.write_byte(b'\xef')
        sb.write_byte(b'\xbf')
        sb.write_byte(b'\xbd')
        i = i + 1
      }
    }
  }
  sb.to_string()
}

///|
pub fn fmt_coord(v : Double) -> String {
  let scaled = (v * 100.0).round().to_int64()
  let neg = scaled < 0L
  let abs_v = if neg { -scaled } else { scaled }
  let whole = abs_v / 100L
  let frac = abs_v % 100L
  let sb = StringBuilder::new()
  if neg && abs_v != 0L {
    sb.write_byte(b'-')
  }
  sb.write_string(whole.to_string())
  if frac != 0L {
    sb.write_byte(b'.')
    if frac < 10L {
      sb.write_byte(b'0')
      sb.write_string(frac.to_string())
    } else if frac % 10L == 0L {
      sb.write_string((frac / 10L).to_string())
    } else {
      sb.write_string(frac.to_string())
    }
  }
  sb.to_string()
}
