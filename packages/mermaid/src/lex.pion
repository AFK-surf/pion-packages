///| Shared lexical, string scanning, and escaping utilities (zero-World, pure Pion).

///|
pub val struct SourceLine {
  pub line_no : Int
  pub text : String
}

///|
pub fn byte_at(s : String, i : Int) -> Int {
  s.code_unit_at(i).to_int()
}

///|
pub fn is_space_byte(b : Int) -> Bool {
  b == 32 || b == 9 || b == 13
}

///|
pub fn is_alpha_byte(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

///|
pub fn is_digit_byte(b : Int) -> Bool {
  b >= 48 && b <= 57
}

///|
pub fn is_ident_byte(b : Int) -> Bool {
  is_alpha_byte(b) || is_digit_byte(b) || b == 95 || b == 45
}

///|
pub fn is_flow_id_byte(b : Int) -> Bool {
  is_alpha_byte(b) || is_digit_byte(b) || b == 95 || b == 45 || b == 46
}

///|
pub fn strip_line_comment(line : String) -> String {
  let n = line.length()
  let mut in_quote = false
  let mut esc = false
  for i = 0; i < n; i = i + 1 {
    let b = byte_at(line, i)
    if esc {
      esc = false
      continue
    }
    if b == 92 && in_quote {
      esc = true
      continue
    }
    if b == 34 {
      in_quote = !in_quote
      continue
    }
    if !in_quote && b == 37 && i + 1 < n && byte_at(line, i + 1) == 37 {
      return line.slice(0, i)
    }
  }
  line
}

///|
pub fn split_source_lines(src : String) -> Array[SourceLine] {
  let out : Array[SourceLine] = []
  let n = src.length()
  let mut start = 0
  let mut line_no = 1
  for i = 0; i <= n; i = i + 1 {
    if i == n || byte_at(src, i) == 10 {
      let mut end = i
      if end > start && byte_at(src, end - 1) == 13 {
        end = end - 1
      }
      let raw = src.slice(start, end)
      out.push(SourceLine::{ line_no: line_no, text: raw })
      start = i + 1
      line_no = line_no + 1
    }
  }
  out
}

///|
pub fn split_semicolons(line : String) -> Array[String] {
  let out : Array[String] = []
  let n = line.length()
  let mut start = 0
  let mut in_quote = false
  let mut esc = false
  let mut depth_sq = 0
  let mut depth_par = 0
  let mut depth_cur = 0
  for i = 0; i < n; i = i + 1 {
    let b = byte_at(line, i)
    if esc {
      esc = false
      continue
    }
    if b == 92 && in_quote {
      esc = true
      continue
    }
    if b == 34 {
      in_quote = !in_quote
      continue
    }
    if !in_quote {
      if b == 91 {
        depth_sq = depth_sq + 1
      } else if b == 93 && depth_sq > 0 {
        depth_sq = depth_sq - 1
      } else if b == 40 {
        depth_par = depth_par + 1
      } else if b == 41 && depth_par > 0 {
        depth_par = depth_par - 1
      } else if b == 123 {
        depth_cur = depth_cur + 1
      } else if b == 125 && depth_cur > 0 {
        depth_cur = depth_cur - 1
      } else if b == 59 && depth_sq == 0 && depth_par == 0 && depth_cur == 0 {
        let part = line.slice(start, i).trim()
        if part.length() > 0 {
          out.push(part)
        }
        start = i + 1
      }
    }
  }
  let tail = line.slice(start, n).trim()
  if tail.length() > 0 {
    out.push(tail)
  }
  out
}

///|
pub fn unquote_string(raw : String) -> String {
  let s = raw.trim()
  let n = s.length()
  if n >= 2 && byte_at(s, 0) == 34 && byte_at(s, n - 1) == 34 {
    let sb = StringBuilder::new()
    let mut i = 1
    while i < n - 1 {
      let b = byte_at(s, i)
      if b == 92 && i + 1 < n - 1 {
        let nxt = byte_at(s, i + 1)
        if nxt == 34 {
          sb.write_byte(b'"')
        } else if nxt == 92 {
          sb.write_byte(b'\\')
        } else if nxt == 110 {
          sb.write_string("\\n")
        } else {
          sb.write_string(s.slice(i + 1, i + 2))
        }
        i = i + 2
      } else {
        sb.write_string(s.slice(i, i + 1))
        i = i + 1
      }
    }
    return sb.to_string()
  }
  s
}

///|
pub fn parse_direction_opt(word : String) -> Option[Direction] {
  let w = word.trim()
  if w == "TD" || w == "TB" {
    Some(Direction::TB)
  } else if w == "BT" {
    Some(Direction::BT)
  } else if w == "LR" {
    Some(Direction::LR)
  } else if w == "RL" {
    Some(Direction::RL)
  } else {
    None
  }
}

///|
pub fn direction_to_string(d : Direction) -> String {
  match d {
    Direction::TB => "TB"
    Direction::BT => "BT"
    Direction::LR => "LR"
    Direction::RL => "RL"
  }
}

///|
pub fn split_words(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    while i < n && is_space_byte(byte_at(s, i)) {
      i = i + 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && !is_space_byte(byte_at(s, i)) {
      i = i + 1
    }
    out.push(s.slice(start, i))
  }
  out
}

///|
pub fn find_char_outside_quotes(s : String, ch : Int, start : Int) -> Int {
  let n = s.length()
  let mut in_q = false
  let mut esc = false
  for i = start; i < n; i = i + 1 {
    let b = byte_at(s, i)
    if esc {
      esc = false
      continue
    }
    if b == 92 && in_q {
      esc = true
      continue
    }
    if b == 34 {
      in_q = !in_q
      continue
    }
    if !in_q && b == ch {
      return i
    }
  }
  -1
}

///|
pub fn json_escape(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::new()
  sb.write_byte(b'"')
  for i = 0; i < n; i = i + 1 {
    let b = byte_at(s, i)
    if b == 34 {
      sb.write_string("\\\"")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 9 {
      sb.write_string("\\t")
    } else {
      sb.write_string(s.slice(i, i + 1))
    }
  }
  sb.write_byte(b'"')
  sb.to_string()
}

///|
pub fn xml_escape(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::new()
  for i = 0; i < n; i = i + 1 {
    let b = byte_at(s, i)
    if b == 38 {
      sb.write_string("&amp;")
    } else if b == 60 {
      sb.write_string("&lt;")
    } else if b == 62 {
      sb.write_string("&gt;")
    } else if b == 34 {
      sb.write_string("&quot;")
    } else if b == 39 {
      sb.write_string("&apos;")
    } else {
      sb.write_string(s.slice(i, i + 1))
    }
  }
  sb.to_string()
}

///|
pub fn fmt_coord(v : Double) -> String {
  let scaled = (v * 100.0).round().to_int64()
  let neg = scaled < 0L
  let abs_v = if neg { -scaled } else { scaled }
  let whole = abs_v / 100L
  let frac = abs_v % 100L
  let sb = StringBuilder::new()
  if neg && abs_v != 0L {
    sb.write_byte(b'-')
  }
  sb.write_string(whole.to_string())
  if frac != 0L {
    sb.write_byte(b'.')
    if frac < 10L {
      sb.write_byte(b'0')
      sb.write_string(frac.to_string())
    } else if frac % 10L == 0L {
      sb.write_string((frac / 10L).to_string())
    } else {
      sb.write_string(frac.to_string())
    }
  }
  sb.to_string()
}
