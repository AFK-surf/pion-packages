///| Ported Sequence Diagram parser & 2D layout test suite (from mermaid-js/mermaid sequence specs).

///|
fn must_parse_seq(src : String) -> SequenceDiagram {
  match parse(src) {
    Ok(Diagram::Sequence(sd)) => sd
    Ok(_) => {
      debug_assert(false, "expected Sequence diagram")
      SequenceDiagram::{ autonumber: false, participants: [], stmts: [] }
    }
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      SequenceDiagram::{ autonumber: false, participants: [], stmts: [] }
    }
  }
}

///|
test "seq: basic two messages with implicit participants" {
  let src =
  #|sequenceDiagram
  #| Alice->Bob: Hello Bob, how are you?
  #| Bob-->Alice: I am good thanks!
  let sd = must_parse_seq(src)
  debug_assert(sd.participants.length() == 2, "2 participants")
  debug_assert(sd.participants[0].id == "Alice", "Alice")
  debug_assert(sd.participants[1].id == "Bob", "Bob")
  debug_assert(sd.stmts.length() == 2, "2 stmts")
}

///|
test "seq: explicit participant and actor with aliases" {
  let src =
  #|sequenceDiagram
  #| actor U as End User
  #| participant S as API Server
  #| U->>S: GET /health
  let sd = must_parse_seq(src)
  debug_assert(sd.participants.length() == 2, "2 participants")
  debug_assert(sd.participants[0].id == "U" && sd.participants[0].alias == "End User", "U alias")
  debug_assert(sd.participants[0].kind == SeqParticipantKind::Actor, "actor")
  debug_assert(sd.participants[1].id == "S" && sd.participants[1].alias == "API Server", "S alias")
  debug_assert(sd.participants[1].kind == SeqParticipantKind::Participant, "participant")
}

///|
test "seq: all arrow types" {
  let src =
  #|sequenceDiagram
  #| A->B: solid line
  #| A-->B: dotted line
  #| A->>B: solid arrow
  #| A-->>B: dotted arrow
  #| A-xB: solid cross
  #| A--xB: dotted cross
  #| A-)B: solid async
#| A--)B: dotted async
let sd = must_parse_seq(src)
debug_assert(sd.stmts.length() == 8, "8 messages")
let expected : Array[SeqArrowKind] = [
  SeqArrowKind::SolidLine,
  SeqArrowKind::DottedLine,
  SeqArrowKind::SolidArrow,
  SeqArrowKind::DottedArrow,
  SeqArrowKind::SolidCross,
  SeqArrowKind::DottedCross,
  SeqArrowKind::SolidAsync,
  SeqArrowKind::DottedAsync,
]
for i = 0; i < 8; i = i + 1 {
  match sd.stmts[i] {
    SeqStmt::Message(_, _, kind, _, _, _) =>
    debug_assert(kind == expected[i], "arrow kind mismatch")
    _ => debug_assert(false, "expected message")
  }
}
}

///|
test "seq: shorthand activation + and -" {
  let src =
  #|sequenceDiagram
  #| Alice->>+Bob: Request
  #| Bob-->>-Alice: Response
  let sd = must_parse_seq(src)
  debug_assert(sd.stmts.length() == 2, "2 stmts")
  match sd.stmts[0] {
    SeqStmt::Message(from, to, kind, text, act, deact) => {
      debug_assert(from == "Alice" && to == "Bob", "Alice->Bob")
      debug_assert(kind == SeqArrowKind::SolidArrow, "solid arrow")
      debug_assert(text == "Request", "Request")
      debug_assert(act && !deact, "activate only")
    }
    _ => debug_assert(false, "expected msg")
  }
  match sd.stmts[1] {
    SeqStmt::Message(_, _, _, _, act, deact) =>
    debug_assert(!act && deact, "deactivate only")
    _ => debug_assert(false, "expected msg")
  }
}

///|
test "seq: explicit activate and deactivate" {
  let src =
  #|sequenceDiagram
  #| Alice->>Bob: Call
  #| activate Bob
  #| Bob-->>Alice: Done
  #| deactivate Bob
  let sd = must_parse_seq(src)
  debug_assert(sd.stmts.length() == 4, "4 stmts")
  match sd.stmts[1] {
    SeqStmt::Activate(p) => debug_assert(p == "Bob", "activate Bob")
    _ => debug_assert(false, "expected activate")
  }
  match sd.stmts[3] {
    SeqStmt::Deactivate(p) => debug_assert(p == "Bob", "deactivate Bob")
    _ => debug_assert(false, "expected deactivate")
  }
}

///|
test "seq: note left of, right of, over single and span" {
  let src =
  #|sequenceDiagram
  #| Note left of Alice: Left note
  #| Note right of Bob: Right note
  #| Note over Alice: Single over
  #| Note over Alice,Bob: Spanning note
  let sd = must_parse_seq(src)
  debug_assert(sd.stmts.length() == 4, "4 notes")
  match sd.stmts[0] {
    SeqStmt::Note(pos, targets, text) =>
    debug_assert(pos == SeqNotePos::LeftOf && targets.length() == 1 && text == "Left note", "left")
    _ => debug_assert(false, "expected note")
  }
  match sd.stmts[1] {
    SeqStmt::Note(pos, targets, text) =>
    debug_assert(pos == SeqNotePos::RightOf && targets.length() == 1 && text == "Right note", "right")
    _ => debug_assert(false, "expected note")
  }
  match sd.stmts[3] {
    SeqStmt::Note(pos, targets, text) =>
    debug_assert(pos == SeqNotePos::Over && targets.length() == 2 && text == "Spanning note", "over 2")
    _ => debug_assert(false, "expected note")
  }
}

///|
test "seq: loop block" {
  let src =
  #|sequenceDiagram
  #| loop Every minute
  #| Alice->>Bob: Ping
  #| end
  let sd = must_parse_seq(src)
  debug_assert(sd.stmts.length() == 1, "1 block")
  match sd.stmts[0] {
    SeqStmt::Block(kind, label, secs) => {
      debug_assert(kind == SeqBlockKind::Loop, "loop")
      debug_assert(label == "Every minute", "label")
      debug_assert(secs.length() == 1 && secs[0].stmts.length() == 1, "1 stmt in loop")
    }
    _ => debug_assert(false, "expected block")
  }
}

///|
test "seq: alt / else block" {
  let src =
  #|sequenceDiagram
  #| alt is valid
  #| A->>B: Accept
  #| else is invalid
  #| A->>B: Reject
  #| end
  let sd = must_parse_seq(src)
  debug_assert(sd.stmts.length() == 1, "1 block")
  match sd.stmts[0] {
    SeqStmt::Block(kind, label, secs) => {
      debug_assert(kind == SeqBlockKind::Alt, "alt")
      debug_assert(label == "is valid", "alt label")
      debug_assert(secs.length() == 2, "2 sections")
      debug_assert(secs[1].label == "is invalid", "else label")
    }
    _ => debug_assert(false, "expected alt")
  }
}

///|
test "seq: opt block" {
  let src =
  #|sequenceDiagram
  #| opt Extra logging
  #| A->>B: Log
  #| end
  let sd = must_parse_seq(src)
  match sd.stmts[0] {
    SeqStmt::Block(kind, _, secs) =>
    debug_assert(kind == SeqBlockKind::Opt && secs.length() == 1, "opt")
    _ => debug_assert(false, "expected opt")
  }
}

///|
test "seq: par / and block" {
  let src =
  #|sequenceDiagram
  #| par Task 1
  #| A->>B: Work 1
  #| and Task 2
  #| A->>C: Work 2
  #| end
  let sd = must_parse_seq(src)
  match sd.stmts[0] {
    SeqStmt::Block(kind, _, secs) => {
      debug_assert(kind == SeqBlockKind::Par, "par")
      debug_assert(secs.length() == 2, "2 par sections")
      debug_assert(secs[0].label == "Task 1" && secs[1].label == "Task 2", "par labels")
    }
    _ => debug_assert(false, "expected par")
  }
}

///|
test "seq: critical / option and break blocks" {
  let src =
  #|sequenceDiagram
  #| critical Establish connection
  #| A->>B: Connect
  #| option Network timeout
  #| A->>B: Retry
  #| end
  #| break when fatal
  #| A->>B: Abort
  #| end
  let sd = must_parse_seq(src)
  debug_assert(sd.stmts.length() == 2, "2 blocks")
  match sd.stmts[0] {
    SeqStmt::Block(kind, _, secs) =>
    debug_assert(kind == SeqBlockKind::Critical && secs.length() == 2, "critical")
    _ => debug_assert(false, "expected critical")
  }
  match sd.stmts[1] {
    SeqStmt::Block(kind, _, secs) =>
    debug_assert(kind == SeqBlockKind::Break && secs.length() == 1, "break")
    _ => debug_assert(false, "expected break")
  }
}

///|
test "seq: nested blocks (loop inside alt)" {
  let src =
  #|sequenceDiagram
  #| alt online
  #| loop 3 times
  #| A->>B: Heartbeat
  #| end
  #| else offline
  #| A->>A: Queue locally
  #| end
  let sd = must_parse_seq(src)
  debug_assert(sd.stmts.length() == 1, "1 outer block")
  match sd.stmts[0] {
    SeqStmt::Block(SeqBlockKind::Alt, _, secs) => {
      debug_assert(secs.length() == 2, "2 sections")
      match secs[0].stmts[0] {
        SeqStmt::Block(SeqBlockKind::Loop, _, inner) =>
        debug_assert(inner.length() == 1 && inner[0].stmts.length() == 1, "nested loop")
        _ => debug_assert(false, "expected nested loop")
      }
    }
    _ => debug_assert(false, "expected alt")
  }
}

///|
test "seq: autonumber enabled" {
  let src =
  #|sequenceDiagram
  #| autonumber
  #| Alice->>Bob: First
  #| Bob-->>Alice: Second
  let sd = must_parse_seq(src)
  debug_assert(sd.autonumber, "autonumber true")
  debug_assert(sd.stmts.length() == 2, "2 messages")
}

///|
test "seq: self message" {
  let src =
  #|sequenceDiagram
  #| Alice->>Alice: Think
  let sd = must_parse_seq(src)
  debug_assert(sd.participants.length() == 1, "1 participant")
  match sd.stmts[0] {
    SeqStmt::Message(f, t, _, txt, _, _) =>
    debug_assert(f == "Alice" && t == "Alice" && txt == "Think", "self msg")
    _ => debug_assert(false, "expected self msg")
  }
}

///|
test "seq: comments ignored" {
  let src =
  #|sequenceDiagram
  #| %% comment line
  #| Alice->>Bob: Hi
  let sd = must_parse_seq(src)
  debug_assert(sd.stmts.length() == 1, "1 stmt")
}

///|
test "seq: participant declaration order preserved" {
  let src =
  #|sequenceDiagram
  #| participant C
  #| participant A
  #| participant B
  #| A->>B: hi
  #| B->>C: hi
  let sd = must_parse_seq(src)
  debug_assert(sd.participants.length() == 3, "3 participants")
  debug_assert(sd.participants[0].id == "C", "first C")
  debug_assert(sd.participants[1].id == "A", "second A")
  debug_assert(sd.participants[2].id == "B", "third B")
}

///|
test "seq: invalid unclosed loop rejected" {
  let src =
  #|sequenceDiagram
  #| loop forever
  #| A->>B: hi
  match parse(src) {
    Ok(_) => debug_assert(false, "should fail unclosed loop")
    Err(e) => debug_assert(e.line >= 1, "line")
  }
}

///|
test "seq: invalid stray else rejected" {
  let src =
  #|sequenceDiagram
  #| else bad
  match parse(src) {
    Ok(_) => debug_assert(false, "should fail stray else")
    Err(e) => debug_assert(e.line == 2, "line 2")
  }
}

///|
test "seq: invalid stray end rejected" {
  let src =
  #|sequenceDiagram
  #| A->>B: hi
  #| end
  match parse(src) {
    Ok(_) => debug_assert(false, "should fail stray end")
    Err(e) => debug_assert(e.line == 3, "line 3")
  }
}

///|
test "seq layout: participants ordered left-to-right with positive separation" {
  let src =
  #|sequenceDiagram
  #| participant Alice
  #| participant Bob
  #| participant Charlie
  #| Alice->>Bob: Msg 1
  #| Bob->>Charlie: Msg 2
  let sd = must_parse_seq(src)
  let scene = layout(Diagram::Sequence(sd))
  debug_assert(scene.width > 0.0 && scene.height > 0.0, "positive scene size")
  debug_assert(scene.nodes.length() >= 3, "at least 3 participant nodes")
  debug_assert(scene.nodes[0].x < scene.nodes[1].x, "Alice left of Bob")
  debug_assert(scene.nodes[1].x < scene.nodes[2].x, "Bob left of Charlie")
  debug_assert(scene.nodes[0].y == scene.nodes[1].y, "aligned top row")
}

///|
test "seq layout: message y coordinates strictly increase top-to-bottom" {
  let src =
  #|sequenceDiagram
  #| Alice->>Bob: First
  #| Bob->>Charlie: Second
  #| Charlie-->>Alice: Third
  let scene = layout(Diagram::Sequence(must_parse_seq(src)))
  debug_assert(scene.edges.length() == 3, "3 message edges")
  debug_assert(scene.edges[0].points.length() >= 2, "edge 0 pts")
  debug_assert(scene.edges[1].points.length() >= 2, "edge 1 pts")
  debug_assert(scene.edges[2].points.length() >= 2, "edge 2 pts")
  let y0 = scene.edges[0].points[0].y
  let y1 = scene.edges[1].points[0].y
  let y2 = scene.edges[2].points[0].y
  debug_assert(y0 < y1 && y1 < y2, "messages strictly descend")
}

///|
test "seq layout: activation boxes emitted as nodes or groups" {
  let src =
  #|sequenceDiagram
  #| Alice->>+Bob: Start
  #| Bob-->>-Alice: Finish
  let scene = layout(Diagram::Sequence(must_parse_seq(src)))
  let mut found_act = false
  for g in scene.groups {
    if g.kind == "activation" {
      found_act = true
      debug_assert(g.width > 0.0 && g.height > 0.0, "activation bbox positive")
    }
  }
  debug_assert(found_act, "activation box present")
}

///|
test "seq layout: note boxes have positive geometry inside scene" {
  let src =
  #|sequenceDiagram
  #| Alice->>Bob: Hi
  #| Note over Alice,Bob: Shared note
  let scene = layout(Diagram::Sequence(must_parse_seq(src)))
  let mut found_note = false
  for n in scene.nodes {
    if n.shape == "note" {
      found_note = true
      debug_assert(n.width > 0.0 && n.height > 0.0, "note dims")
      debug_assert(n.x >= 0.0 && n.y >= 0.0, "note inside scene")
    }
  }
  debug_assert(found_note, "note node present")
}

///|
test "seq layout: nested block groups enclose inner messages" {
  let src =
  #|sequenceDiagram
  #| loop Check
  #| Alice->>Bob: Ping
  #| Bob-->>Alice: Pong
  #| end
  let scene = layout(Diagram::Sequence(must_parse_seq(src)))
  let mut found_block = false
  for g in scene.groups {
    if g.kind == "loop" {
      found_block = true
      let msg_y0 = scene.edges[0].points[0].y
      let msg_y1 = scene.edges[1].points[0].y
      debug_assert(g.y <= msg_y0 && g.y + g.height >= msg_y1, "block encloses messages")
    }
  }
  debug_assert(found_block, "loop group present")
}

///|
test "seq layout: autonumber prefixes edge labels" {
  let src =
  #|sequenceDiagram
  #| autonumber
  #| Alice->>Bob: First
  #| Bob-->>Alice: Second
  let scene = layout(Diagram::Sequence(must_parse_seq(src)))
  debug_assert(scene.edges[0].label.starts_with("1."), "first numbered")
  debug_assert(scene.edges[1].label.starts_with("2."), "second numbered")
}
