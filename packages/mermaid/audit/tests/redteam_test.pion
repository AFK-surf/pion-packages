}

// ---------------------------------------------------------------------------------------------
// 7. Layout geometry (dagre with identical boxes is clean on every one of these)
// ---------------------------------------------------------------------------------------------

///|
test "P0 layout: cross-linked subgraphs keep foreign nodes out of cluster boxes" {
  let sc = scene_of(
    "flowchart TB\n  subgraph left\n    l1 --> l2 --> l3\n  end\n  subgraph right\n    r1 --> r2 --> r3\n  end\n  l1 --> r3\n  r1 --> l3\n  l2 --> r2",
  )
  let bad = foreign_nodes_in_clusters(sc)
  debug_assert(bad.length() == 0, "foreign nodes inside clusters: " + bad.join(", "))
}

///|
test "P0 layout: sibling subgraph boxes do not overlap" {
  let sc = scene_of("flowchart LR\n  subgraph one\n    a1 --> a2\n  end\n  subgraph two\n    b1 --> b2\n  end\n  a1 --> b1\n  b2 --> a2")
  let mut overlaps = 0
  for i = 0; i < sc.groups.length(); i = i + 1 {
    for j = i + 1; j < sc.groups.length(); j = j + 1 {
      let a = sc.groups[i]
      let b = sc.groups[j]
      if rects_overlap(a.x, a.y, a.x + a.width, a.y + a.height, b.x, b.y, b.x + b.width, b.y + b.height) {
        overlaps = overlaps + 1
      }
    }
  }
  debug_assert(overlaps == 0, "overlapping sibling clusters: " + overlaps.to_string())
}

///|
test "P0 layout: class namespaces stay disjoint" {
  let sc = scene_of(
    "classDiagram\n  namespace Domain {\n    class Order\n    class Customer\n  }\n  namespace Infra {\n    class Repo\n    class Db\n  }\n  Customer --> Order\n  Repo --> Order\n  Repo --> Db\n  Order --> Db",
  )
  let bad = foreign_nodes_in_clusters(sc)
  debug_assert(bad.length() == 0, "foreign classes inside namespace boxes: " + bad.join(", "))
}

///|
test "P0 layout: labels of parallel edges A->B do not overlap each other or the nodes" {
  let sc = scene_of("flowchart LR\n  A -->|request| B\n  A -->|retry| B\n  B -->|response| A")
  let bad = overlapping_labels(sc)
  debug_assert(bad.length() == 0, "label collisions: " + bad.join(", "))
}

///|
test "P1 layout: parallel edges A->B are not drawn on top of each other" {
  let sc = scene_of("flowchart TB\n  A --> B\n  A --> B")
  debug_assert(sc.edges.length() == 2, "edges: " + sc.edges.length().to_string())
  if sc.edges.length() == 2 {
    let p = sc.edges[0].points
    let q = sc.edges[1].points
    let mut same = p.length() == q.length()
    if same {
      for k = 0; k < p.length(); k = k + 1 {
        if p[k].x != q[k].x || p[k].y != q[k].y {
          same = false
        }
      }
    }
    debug_assert(!same, "both edges have identical polylines")
  }
}

///|
test "P1 layout: fan-out edge labels do not overlap" {
  let sc = scene_of(
    "flowchart TB\n  A -->|first long edge label| B\n  A -->|second long edge label| C\n  A -->|third long edge label| D",
  )
  let bad = overlapping_labels(sc)
  debug_assert(bad.length() == 0, "label collisions: " + bad.join(", "))
}

///|
test "P1 layout: self-loop label stays inside the canvas and off the node" {
  let sc = scene_of("flowchart TB\n  A --> B\n  B -->|loop back| B")
  let bad = overlapping_labels(sc)
  debug_assert(bad.length() == 0, "label collisions: " + bad.join(", "))
  for l in sc.labels {
    debug_assert(l.x + l.width / 2.0 <= sc.width + 0.5, "label '" + l.text + "' leaves the canvas on the right")
  }
}

///|
test "P1 layout: long edge does not cut through an unrelated node" {
  let sc = scene_of(
    "flowchart TB\n  n0 --> n1 --> n2 --> n3 --> n4 --> n5\n  n0 --> n5\n  n1 --> n4\n  n0 --> n3\n  m0 --> n5",
  )
  let bad = edges_through_nodes(sc)
  debug_assert(bad.length() == 0, "edges through nodes: " + bad.join(", "))
}

///|
test "P0 layout: transition OUT of a composite state does not start at its [*] pseudo-state" {
  let sc = scene_of(
    "stateDiagram-v2\n  Idle --> Running : start\n  state Running {\n    [*] --> Loading\n  }\n  state Paused {\n    [*] --> Frozen\n  }\n  Running --> Paused : pause",
  )
  for e in sc.edges {
    if e.label == "pause" {
      debug_assert(!e.from.starts_with("__start_"), "'Running --> Paused' drawn from start pseudo-state " + e.from)
      debug_assert(!e.to.starts_with("__start_"), "'Running --> Paused' drawn into start pseudo-state " + e.to)
    }
  }
}

///|
test "P1 layout: transition into an empty composite state is not dropped" {
  let sc = scene_of("stateDiagram-v2\n  A --> Empty\n  state Empty {\n  }")
  debug_assert(sc.edges.length() == 1, "edges in scene: " + sc.edges.length().to_string())
  let mut has_empty = false
  for n in sc.nodes {
    if n.id == "Empty" {
      has_empty = true
    }
  }
  for g in sc.groups {
    if g.id == "Empty" {
      has_empty = true
    }
  }
  debug_assert(has_empty, "state 'Empty' vanished from the layout")
}

// ---------------------------------------------------------------------------------------------
// 8. Output validity / safety
// ---------------------------------------------------------------------------------------------

///|
test "P1 svg: control characters in labels do not produce ill-formed XML" {
  match m::render("flowchart LR\n  A[\"ctl\u{01}x\"] --> B") {
    Ok(svg) => debug_assert(!has_raw_control_char(svg), "raw U+0001 in SVG: XML 1.0 forbids it (not well-formed)")
    Err(e) => debug_assert(false, "render failed: " + e.message)
  }
}

///|
test "P1 canon: control characters produce valid JSON" {
  match m::parse("flowchart LR\n  A[\"ctl\u{01}x\"] --> B") {
    Ok(d) => debug_assert(!has_raw_control_char(m::canonical_graph_json(d)), "raw U+0001 inside a JSON string")
    Err(e) => debug_assert(false, "parse failed: " + e.message)
  }
}

///|
test "P1 svg: <br/> in a label is a line break, not literal text" {
  match m::render("flowchart TD\n  A[line1<br/>line2] --> B") {
    Ok(svg) => debug_assert(!svg.contains("&lt;br/&gt;"), "label renders the literal text '<br/>'")
    Err(e) => debug_assert(false, "render failed: " + e.message)
  }
}

///|
test "P2 svg: node shapes are drawn (hexagon/cylinder/parallelogram are not plain rects)" {
  match m::render("flowchart LR\n  a{{hex}} --> b[(db)] --> c[/para/]") {
    Ok(svg) => {
      let mut rects = 0
      let parts = svg.split("<rect ")
      rects = parts.length() - 1
      debug_assert(rects == 0, "hexagon/cylinder/parallelogram all emitted as <rect>: " + rects.to_string())
    }
    Err(e) => debug_assert(false, "render failed: " + e.message)
  }
}

///|
test "P2 svg: classDef / style colours reach the SVG" {
  match m::render("flowchart LR\n  A --> B\n  style A fill:#ff0000") {
    Ok(svg) => debug_assert(svg.contains("ff0000"), "style fill:#ff0000 was dropped")
    Err(e) => debug_assert(false, "render failed: " + e.message)
  }
}

///|
test "P2 svg: class members are rendered" {
  match m::render("classDiagram\n  class Account {\n    +String owner\n    +deposit(amount) bool\n  }") {
    Ok(svg) => debug_assert(svg.contains("deposit"), "class members missing from SVG")
    Err(e) => debug_assert(false, "render failed: " + e.message)
  }
}

///|
test "P2 svg: ER attributes are rendered" {
  match m::render("erDiagram\n  CAR {\n    string registrationNumber PK\n  }") {
    Ok(svg) => debug_assert(svg.contains("registrationNumber"), "ER attributes missing from SVG")
    Err(e) => debug_assert(false, "render failed: " + e.message)
  }
}

///|
test "control: sequence notes keep their text (expected to PASS)" {
  match m::render("sequenceDiagram\n  A->>B: hi\n  Note over A,B: important note") {
    Ok(svg) => debug_assert(svg.contains("important note"), "note text missing from SVG")
    Err(e) => debug_assert(false, "render failed: " + e.message)
  }
}

///|
test "control: XSS payloads in labels are escaped (expected to PASS)" {
  match m::render("flowchart LR\n  A[\"<script>alert(1)</script>\"] -->|\"x\\\" onload=\\\"alert(1)\"| B") {
    Ok(svg) => {
      debug_assert(!svg.contains("<script"), "raw <script> in SVG")
      debug_assert(!svg.contains("\" onload="), "attribute breakout in SVG")
    }
    Err(e) => debug_assert(false, "render failed: " + e.message)
  }
}
