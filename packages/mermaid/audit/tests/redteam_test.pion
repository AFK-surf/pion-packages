///|
test "control: er relationship count is preserved (expected to PASS)" {
  match er("erDiagram\n  CUSTOMER ||--o{ ORDER : places\n  ORDER ||--|{ LINE-ITEM : contains") {
    Some(ed) => debug_assert(ed.relations.length() == 2, "relations: " + ed.relations.length().to_string())
    None => debug_assert(false, "parse failed")
  }
}

