///| Red-team prosecution suite for packages/mermaid.
///|
///| Every test asserts the behaviour of the official implementation (mermaid 12.3.0 parse via
///| `mermaid.mermaidAPI.getDiagramFromText`, `@dagrejs/dagre` 3.1.3 layout of identical node and
///| label boxes). The expected values were taken from those runs (`audit/run_audit.sh` reproduces
///| them). A FAILING test here is a reproducible defect of the Pion port, not a test bug.
///|
///| Crash / DoS probes (SIGSEGV on deep input, super-linear blowups) are NOT in this file because
///| a segfault would take the whole test runner down; they live in `run_audit.sh` step 4.

import "mermaid" as m

// ---------------------------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------------------------

///|
fn parse_ok(src : String) -> Bool {
  match m::parse(src) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn err_msg(src : String) -> String {
  match m::parse(src) {
    Ok(_) => ""
    Err(e) => "line " + e.line.to_string() + ": " + e.message
  }
}

///|
fn flow(src : String) -> Option[m::FlowchartDiagram] {
  match m::parse(src) {
    Ok(m::Diagram::Flowchart(fc)) => Some(fc)
    _ => None
  }
}

///|
fn seq(src : String) -> Option[m::SequenceDiagram] {
  match m::parse(src) {
    Ok(m::Diagram::Sequence(sd)) => Some(sd)
    _ => None
  }
}

///|
fn state(src : String) -> Option[m::StateDiagram] {
  match m::parse(src) {
    Ok(m::Diagram::State(st)) => Some(st)
    _ => None
  }
}

///|
fn class_d(src : String) -> Option[m::ClassDiagram] {
  match m::parse(src) {
    Ok(m::Diagram::Class(cd)) => Some(cd)
    _ => None
  }
}

///|
fn er(src : String) -> Option[m::ErDiagram] {
  match m::parse(src) {
    Ok(m::Diagram::Er(ed)) => Some(ed)
    _ => None
  }
}

///|
fn scene_of(src : String) -> m::Scene {
  match m::parse(src) {
    Ok(d) => m::layout(d)
    Err(e) => {
      debug_assert(false, "fixture failed to parse: " + e.message)
      m::empty_scene()
    }
  }
}

///|
fn flow_node_ids(fc : m::FlowchartDiagram) -> String {
  let ids : Array[String] = []
  for n in fc.nodes {
    ids.push(n.id)
  }
  ids.sort()
  ids.join(",")
}

///|
fn seq_ids(sd : m::SequenceDiagram) -> String {
  let ids : Array[String] = []
  for p in sd.participants {
    ids.push(p.id)
  }
  ids.sort()
  ids.join(",")
}

///|
fn count_messages(stmts : Array[m::SeqStmt]) -> Int {
  let mut c = 0
  for s in stmts {
    match s {
      m::SeqStmt::Message(_, _, _, _, _, _) => c = c + 1
      m::SeqStmt::Block(_, _, secs) => {
        for sec in secs {
          c = c + count_messages(sec.stmts)
        }
      }
      _ => ()
    }
  }
  c
}

///|
fn min_d(a : Double, b : Double) -> Double {
  if a < b { a } else { b }
}

///|
fn max_d(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}

///|
fn rects_overlap(
  ax0 : Double,
  ay0 : Double,
  ax1 : Double,
  ay1 : Double,
  bx0 : Double,
  by0 : Double,
  bx1 : Double,
  by1 : Double,
) -> Bool {
  min_d(ax1, bx1) - max_d(ax0, bx0) > 0.5 && min_d(ay1, by1) - max_d(ay0, by0) > 0.5
}

///|
fn group_ancestry(sc : m::Scene, gid_opt : Option[String], target : String) -> Bool {
  let mut cur = gid_opt
  let mut steps = 0
  while steps < 1000 {
    steps = steps + 1
    match cur {
      None => return false
      Some(g) => {
        if g == target {
          return true
        }
        let mut next : Option[String] = None
        for gr in sc.groups {
          if gr.id == g {
            next = gr.parent_id
          }
        }
        cur = next
      }
    }
  }
  false
}

///| Non-member nodes whose box intrudes into a cluster box ("A<-x" strings).
fn foreign_nodes_in_clusters(sc : m::Scene) -> Array[String] {
  let out : Array[String] = []
  for g in sc.groups {
    for n in sc.nodes {
      if group_ancestry(sc, n.group_id, g.id) {
        continue
      }
      if rects_overlap(
        g.x,
        g.y,
        g.x + g.width,
        g.y + g.height,
        n.x - n.width / 2.0,
        n.y - n.height / 2.0,
        n.x + n.width / 2.0,
        n.y + n.height / 2.0,
      ) {
        out.push(g.id + "<-" + n.id)
      }
    }
  }
  out
}

///|
fn overlapping_labels(sc : m::Scene) -> Array[String] {
  let out : Array[String] = []
  for i = 0; i < sc.labels.length(); i = i + 1 {
    let a = sc.labels[i]
    for j = i + 1; j < sc.labels.length(); j = j + 1 {
      let b = sc.labels[j]
      if rects_overlap(
        a.x - a.width / 2.0,
        a.y - a.height / 2.0,
        a.x + a.width / 2.0,
        a.y + a.height / 2.0,
        b.x - b.width / 2.0,
        b.y - b.height / 2.0,
        b.x + b.width / 2.0,
        b.y + b.height / 2.0,
      ) {
        out.push(a.text + "~" + b.text)
      }
    }
    for n in sc.nodes {
      if rects_overlap(
        a.x - a.width / 2.0,
        a.y - a.height / 2.0,
        a.x + a.width / 2.0,
        a.y + a.height / 2.0,
        n.x - n.width / 2.0,
        n.y - n.height / 2.0,
        n.x + n.width / 2.0,
        n.y + n.height / 2.0,
      ) {
        out.push(a.text + "x" + n.id)
      }
    }
  }
  out
}

///| Liang-Barsky: segment p->q passes through the open box.
fn seg_hits_box(p : m::Point, q : m::Point, x0 : Double, y0 : Double, x1 : Double, y1 : Double) -> Bool {
  let dx = q.x - p.x
  let dy = q.y - p.y
  let mut t0 = 0.0
  let mut t1 = 1.0
  let ps = [-dx, dx, -dy, dy]
  let qs = [p.x - x0, x1 - p.x, p.y - y0, y1 - p.y]
  for k = 0; k < 4; k = k + 1 {
    let pk = ps[k]
    let qk = qs[k]
    if pk < 1.0e-12 && pk > -1.0e-12 {
      if qk <= 0.0 {
        return false
      }
    } else {
      let t = qk / pk
      if pk < 0.0 {
        if t > t0 {
          t0 = t
        }
      } else if t < t1 {
        t1 = t
      }
      if t0 >= t1 {
        return false
      }
    }
  }
  t1 - t0 > 1.0e-6
}

///|
fn edges_through_nodes(sc : m::Scene) -> Array[String] {
  let out : Array[String] = []
  for e in sc.edges {
    for n in sc.nodes {
      if n.id == e.from || n.id == e.to {
        continue
      }
      let x0 = n.x - n.width / 2.0 + 1.0
      let x1 = n.x + n.width / 2.0 - 1.0
      let y0 = n.y - n.height / 2.0 + 1.0
      let y1 = n.y + n.height / 2.0 - 1.0
      for k = 0; k + 1 < e.points.length(); k = k + 1 {
        if seg_hits_box(e.points[k], e.points[k + 1], x0, y0, x1, y1) {
          out.push(e.from + "->" + e.to + " x " + n.id)
          break
        }
      }
    }
  }
  out
}

///|
fn has_raw_control_char(s : String) -> Bool {
  for i = 0; i < s.length(); i = i + 1 {
    let b = s.code_unit_at(i).to_int()
    if b < 32 && b != 9 && b != 10 && b != 13 {
      return true
    }
  }
  false
}

// ---------------------------------------------------------------------------------------------
// 1. Flowchart parse: valid mermaid rejected
// ---------------------------------------------------------------------------------------------

///|
test "P1 flow: YAML frontmatter (title/config) is accepted" {
  let src = "---\ntitle: Order pipeline\nconfig:\n  theme: forest\n---\nflowchart LR\n  A --> B"
  debug_assert(parse_ok(src), "mermaid parses this; pion: " + err_msg(src))
}

///|
test "P1 flow: unicode node ids are accepted" {
  let src = "flowchart LR\n  开始 --> 结束"
  debug_assert(parse_ok(src), "mermaid parses this; pion: " + err_msg(src))
}

///|
test "P1 flow: v11 shape syntax A@{ shape: cyl } is accepted" {
  let src = "flowchart LR\n  A@{ shape: cyl, label: \"Database\" } --> B"
  debug_assert(parse_ok(src), "mermaid parses this; pion: " + err_msg(src))
}

///|
test "P1 flow: edge attribute statement e1@{ animate: true } is accepted" {
  let src = "flowchart LR\n  A e1@--> B\n  e1@{ animate: true }"
  debug_assert(parse_ok(src), "mermaid parses this; pion: " + err_msg(src))
}

///|
test "P2 flow: multi-line accDescr { ... } is accepted" {
  let src = "flowchart LR\n  accDescr {\n    multi line\n  }\n  A --> B"
  debug_assert(parse_ok(src), "mermaid parses this; pion: " + err_msg(src))
}

// ---------------------------------------------------------------------------------------------
// 2. Flowchart parse: silently wrong graph
// ---------------------------------------------------------------------------------------------

///|
test "P0 flow: A--text-->B is ONE labelled edge, not a phantom node 'text'" {
  match flow("flowchart LR\n  A--text-->B") {
    Some(fc) => {
      debug_assert(flow_node_ids(fc) == "A,B", "nodes: " + flow_node_ids(fc))
      debug_assert(fc.edges.length() == 1, "edges: " + fc.edges.length().to_string())
      if fc.edges.length() == 1 {
        debug_assert(fc.edges[0].label == "text", "label: " + fc.edges[0].label)
      }
    }
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P1 flow: edge to a subgraph id targets the cluster, no phantom node" {
  let src = "flowchart TB\n  subgraph one\n    a1 --> a2\n  end\n  subgraph two\n    b1 --> b2\n  end\n  one --> two"
  match flow(src) {
    Some(fc) => debug_assert(flow_node_ids(fc) == "a1,a2,b1,b2", "phantom nodes created: " + flow_node_ids(fc))
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P2 flow: classDef foo,bar defines both classes" {
  match flow("flowchart LR\n  classDef foo,bar fill:#f96\n  A:::foo --> B:::bar") {
    Some(fc) => {
      let names : Array[String] = []
      for c in fc.class_defs {
        names.push(c.name)
      }
      names.sort()
      debug_assert(names.join(" | ") == "bar | foo", "class_defs: " + names.join(" | "))
    }
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P2 flow: markdown string label drops the backticks" {
  match flow("flowchart LR\n  A[\"`**Bold** and _italic_`\"] --> B") {
    Some(fc) => debug_assert(fc.nodes[0].label == "**Bold** and _italic_", "label: " + fc.nodes[0].label)
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P2 flow: entity codes #quot; #amp; #9829; are decoded" {
  match flow("flowchart LR\n  A[\"A #quot;q#quot; #amp; #9829;\"] --> B") {
    Some(fc) => debug_assert(fc.nodes[0].label == "A \"q\" & ♥", "label: " + fc.nodes[0].label)
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P2 flow: quoted subgraph title does not become the subgraph id" {
  match flow("flowchart TB\n  subgraph \"My Title\"\n    a --> b\n  end") {
    Some(fc) => debug_assert(!fc.subgraphs[0].id.contains(" "), "subgraph id with spaces: " + fc.subgraphs[0].id)
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P2 flow: invalid A[foo (bar)] is rejected like mermaid" {
  debug_assert(!parse_ok("flowchart LR\n  A[foo (bar)] --> B"), "mermaid: Parse error ... got 'PS'")
}

