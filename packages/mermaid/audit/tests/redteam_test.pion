test "P1 seq: autonumber off is accepted" {
  let src = "sequenceDiagram\n  autonumber\n  A->>B: one\n  autonumber off\n  B->>A: two"
  debug_assert(parse_ok(src), "mermaid parses this; pion: " + err_msg(src))
}

