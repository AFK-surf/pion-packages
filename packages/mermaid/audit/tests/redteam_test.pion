///|
test "P0 seq: bidirectional A<<->>B has participants A,B (no phantom 'A<<')" {
  match seq("sequenceDiagram\n  A<<->>B: both ways") {
    Some(sd) => debug_assert(seq_ids(sd) == "A,B", "participants: " + seq_ids(sd))
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P1 seq: central connection A->>()B targets B (no phantom '()B')" {
  match seq("sequenceDiagram\n  participant A\n  participant B\n  A->>()B: central") {
    Some(sd) => debug_assert(seq_ids(sd) == "A,B", "participants: " + seq_ids(sd))
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P1 seq: participant D@{ type: database } has id D" {
  match seq("sequenceDiagram\n  participant D@{ \"type\" : \"database\" }\n  D->>Q: x") {
    Some(sd) => debug_assert(seq_ids(sd) == "D,Q", "participants: " + seq_ids(sd))
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P1 seq: ';' separates two messages" {
  match seq("sequenceDiagram\n  A->>B: hi; B->>A: yo") {
    Some(sd) => debug_assert(count_messages(sd.stmts) == 2, "messages: " + count_messages(sd.stmts).to_string())
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P2 seq: create participant C as Carl keeps the alias" {
  match seq("sequenceDiagram\n  A->>B: hello\n  create participant C as Carl\n  B->>C: spawn") {
    Some(sd) => {
      let mut alias = ""
      for p in sd.participants {
        if p.id == "C" {
          alias = p.alias
        }
      }
      debug_assert(alias == "Carl", "alias of C: " + alias)
    }
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P2 seq: message without ': text' is rejected like mermaid" {
  debug_assert(!parse_ok("sequenceDiagram\n  A->>B"), "mermaid: Expecting 'TXT', got 'NEWLINE'")
}

// ---------------------------------------------------------------------------------------------
// 4. State parse
// ---------------------------------------------------------------------------------------------

///|
test "P1 state: [*] in one scope is ONE start and ONE end node" {
  match state("stateDiagram-v2\n  [*] --> A\n  [*] --> B\n  A --> [*]\n  B --> [*]") {
    Some(st) => {
      let mut starts = 0
      let mut ends = 0
      for s in st.states {
        if s.kind == m::StateKind::Start {
          starts = starts + 1
        }
        if s.kind == m::StateKind::End {
          ends = ends + 1
        }
      }
      debug_assert(starts == 1 && ends == 1, "starts=" + starts.to_string() + " ends=" + ends.to_string())
    }
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P0 state: A:::cls --> B creates states A and B (no phantom 'A:::cls')" {
  match state("stateDiagram-v2\n  classDef bad fill:#f00\n  A:::bad --> B") {
    Some(st) => {
      let ids : Array[String] = []
      for s in st.states {
        ids.push(s.id)
      }
      ids.sort()
      debug_assert(ids.join(",") == "A,B", "states: " + ids.join(","))
    }
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P1 state: concurrency '--' splits the composite into regions" {
  let src = "stateDiagram-v2\n  state Active {\n    [*] --> X\n    --\n    [*] --> Y\n  }"
  match state(src) {
    Some(st) => {
      let mut composites = 0
      for s in st.states {
        if s.kind == m::StateKind::Composite {
          composites = composites + 1
        }
      }
      // mermaid: Active + 2 region groups, each with its own start
      debug_assert(composites >= 3, "composite/region groups: " + composites.to_string())
    }
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P2 state: hide empty description is accepted" {
  let src = "stateDiagram-v2\n  hide empty description\n  A --> B"
  debug_assert(parse_ok(src), "mermaid parses this; pion: " + err_msg(src))
}

///|
test "P2 state: floating note \"text\" as N1 is accepted" {
  let src = "stateDiagram-v2\n  A --> B\n  note \"floating\" as N1"
  debug_assert(parse_ok(src), "mermaid parses this; pion: " + err_msg(src))
}

///|
test "P1 state: dangling 'A -->' is rejected (pion invents a state named \"\")" {
  debug_assert(!parse_ok("stateDiagram-v2\n  A -->"), "mermaid: Expecting 'ID', 'EDGE_STATE', got 'NL'")
}

// ---------------------------------------------------------------------------------------------
// 5. Class / ER parse
// ---------------------------------------------------------------------------------------------

///|
test "P0 class: two-way relation Animal <|--|> Zebra targets 'Zebra'" {
  match class_d("classDiagram\n  Animal <|--|> Zebra") {
    Some(cd) => {
      debug_assert(cd.relations.length() == 1, "relations: " + cd.relations.length().to_string())
      if cd.relations.length() == 1 {
        debug_assert(cd.relations[0].to == "Zebra", "to: '" + cd.relations[0].to + "'")
      }
    }
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P0 class: classDef / Animal:::cls do not create phantom classes" {
  let src = "classDiagram\n  class Animal:::someclass\n  classDef someclass fill:#f96"
  match class_d(src) {
    Some(cd) => {
      let ids : Array[String] = []
      for c in cd.classes {
        ids.push(c.id)
      }
      debug_assert(ids.join(",") == "Animal", "classes: " + ids.join(" | "))
    }
    None => debug_assert(false, "parse failed")
  }
}

///|
test "P1 class: class Animal[\"label\"] is one class with that label" {
  match class_d("classDiagram\n  class Animal[\"Animal with a label\"]\n  Animal --> Dog") {
    Some(cd) => {
      let ids : Array[String] = []
      for c in cd.classes {
        ids.push(c.id + "=" + c.label)
      }
      ids.sort()
      debug_assert(ids.join(" | ") == "Animal=Animal with a label | Dog=Dog", "classes: " + ids.join(" | "))
    }
    None => debug_assert(false, "parse failed")
  }
}

