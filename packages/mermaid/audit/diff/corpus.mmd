%%CASE state_choice_fork_join
stateDiagram-v2
  state if_state <<choice>>
  state fork_state <<fork>>
  state join_state <<join>>
  [*] --> fork_state
  fork_state --> S2
  fork_state --> S3
  S2 --> join_state
  S3 --> join_state
  join_state --> if_state
  if_state --> False: n < 0
  if_state --> True : n >= 0
