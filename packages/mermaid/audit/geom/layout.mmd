%%CASE g_state_composites
stateDiagram-v2
  [*] --> Idle
  Idle --> Running : start
  state Running {
    [*] --> Loading
    Loading --> Ready
    Ready --> Loading : refresh
  }
  state Paused {
    [*] --> Frozen
  }
  Running --> Paused : pause
  Paused --> Running : resume
  Running --> [*]
