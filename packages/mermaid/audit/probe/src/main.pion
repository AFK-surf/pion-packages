///| Red-team probe CLI for packages/mermaid.
///| Usage:
///|   probe parse <corpus>   one line per case: name \t OK|ERR \t normalized-json|message
///|   probe scene <corpus>   one line per case: name \t OK|ERR \t scene-json (geometry after layout)
///|   probe svg <file>       render one diagram to SVG on stdout
///|   probe gen <kind> <n>   print a generated stress input (chain|wide|dense|scc|nest|seq|flowseq)
///|   probe time <file> [iters]  parse+layout+render a file, print node/edge counts + svg size
///|   probe count <file> [iters] same work, prints only `nodes=N edges=E` (bench_compare SHA parity)
///| Corpus format: cases separated by a line `%%CASE <name>` (the line itself starts each case).

import "mermaid" as m

///|
fn q(s : String) -> String {
  m::json_escape(s)
}

///|
fn opt_q(o : Option[String]) -> String {
  match o {
    Some(s) => q(s)
    None => "null"
  }
}

///|
fn node_str(id : String, label : String, parent : Option[String], group : Bool) -> String {
  "{\"id\":" + q(id) + ",\"label\":" + q(label) + ",\"parent\":" + opt_q(parent) + ",\"group\":" +
  (if group { "true" } else { "false" }) +
  "}"
}

///|
fn edge_str(s : String, e : String, l : String) -> String {
  "{\"s\":" + q(s) + ",\"e\":" + q(e) + ",\"l\":" + q(l) + "}"
}

///|
fn join_sorted(items : Array[String]) -> String {
  items.sort()
  let sb = StringBuilder::new()
  sb.write_byte(b'[')
  for i = 0; i < items.length(); i = i + 1 {
    if i > 0 {
      sb.write_byte(b',')
    }
    sb.write_string(items[i])
  }
  sb.write_byte(b']')
  sb.to_string()
}

///|
fn seq_collect(stmts : Array[m::SeqStmt], edges : Array[String], notes : Array[String]) -> Unit {
  for st in stmts {
    match st {
      m::SeqStmt::Message(f, t, _, text, _, _) => edges.push(edge_str(f, t, text))
      m::SeqStmt::Note(_, targets, text) => {
        let tsb = StringBuilder::new()
        for i = 0; i < targets.length(); i = i + 1 {
          if i > 0 {
            tsb.write_byte(b',')
          }
          tsb.write_string(targets[i])
        }
        notes.push(edge_str(tsb.to_string(), "", text))
      }
      m::SeqStmt::Block(_, _, secs) => {
        for sec in secs {
          seq_collect(sec.stmts, edges, notes)
        }
      }
      _ => ()
    }
  }
}

///|
fn state_norm_id(st : m::StateDiagram, id : String) -> String {
  for s in st.states {
    if s.id == id {
      if s.kind == m::StateKind::Start || s.kind == m::StateKind::End {
        let sc_name = s.parent.unwrap_or("root")
        return sc_name + (if s.kind == m::StateKind::Start { "_start" } else { "_end" })
      }
      return id
    }
  }
  id
}

///|
fn normalize(d : m::Diagram) -> String {
  let nodes : Array[String] = []
  let edges : Array[String] = []
  let notes : Array[String] = []
  let mut kind = ""
  match d {
    m::Diagram::Flowchart(fc) => {
      kind = "flowchart"
      for sg in fc.subgraphs {
        nodes.push(node_str(sg.id, sg.title, sg.parent, true))
      }
      for n in fc.nodes {
        nodes.push(node_str(n.id, n.label, n.subgraph, false))
      }
      for e in fc.edges {
        edges.push(edge_str(e.from, e.to, e.label))
      }
    }
    m::Diagram::Sequence(sd) => {
      kind = "sequence"
      for p in sd.participants {
        nodes.push(node_str(p.id, p.alias, None, false))
      }
      seq_collect(sd.stmts, edges, notes)
    }
    m::Diagram::State(st) => {
      kind = "state"
      for s in st.states {
        nodes.push(
          node_str(state_norm_id(st, s.id), state_norm_id(st, s.id), s.parent, s.kind == m::StateKind::Composite),
        )
      }
      for t in st.transitions {
        edges.push(edge_str(state_norm_id(st, t.from), state_norm_id(st, t.to), t.label))
      }
    }
    m::Diagram::Class(cd) => {
      kind = "class"
      let seen : Map[String, Bool] = Map::new()
      for c in cd.classes {
        match c.namespace_name {
          Some(ns) => {
            if seen.get(ns).is_none() {
              seen.set(ns, true)
              nodes.push(node_str(ns, ns, None, true))
            }
          }
          None => ()
        }
        nodes.push(node_str(c.id, c.label, c.namespace_name, false))
      }
      for r in cd.relations {
        edges.push(edge_str(r.from, r.to, r.label))
      }
    }
    m::Diagram::Er(ed) => {
      kind = "er"
      for e in ed.entities {
        let lbl = if e.alias.length() > 0 { e.alias } else { e.id }
        nodes.push(node_str(e.id, lbl, None, false))
      }
      for r in ed.relations {
        edges.push(edge_str(r.from, r.to, r.label))
      }
    }
  }
  "{\"kind\":" + q(kind) + ",\"nodes\":" + join_sorted(nodes) + ",\"edges\":" + join_sorted(edges) +
  ",\"notes\":" +
  join_sorted(notes) +
  "}"
}

///|
fn num(v : Double) -> String {
  if v != v {
    return "\"NaN\""
  }
  if v > 1.0e300 || v < -1.0e300 {
    return "\"Inf\""
  }
  m::fmt_coord(v)
}

///|
fn diagram_meta(d : m::Diagram) -> String {
  let (kind, dir) = match d {
    m::Diagram::Flowchart(fc) => ("flowchart", fc.direction)
    m::Diagram::Sequence(_) => ("sequence", m::Direction::LR)
    m::Diagram::State(st) => ("state", st.direction)
    m::Diagram::Class(cd) => ("class", cd.direction)
    m::Diagram::Er(ed) => ("er", ed.direction)
  }
  "\"kind\":" + q(kind) + ",\"dir\":" + q(m::direction_to_string(dir)) + ","
}

///|
fn scene_json(meta : String, sc : m::Scene) -> String {
  let sb = StringBuilder::new()
  sb.write_string("{" + meta + "\"width\":" + num(sc.width) + ",\"height\":" + num(sc.height) + ",\"nodes\":[")
  for i = 0; i < sc.nodes.length(); i = i + 1 {
    let n = sc.nodes[i]
    if i > 0 {
      sb.write_byte(b',')
    }
    sb.write_string(
      "{\"id\":" + q(n.id) + ",\"label\":" + q(n.label) + ",\"shape\":" + q(n.shape) + ",\"x\":" + num(n.x) +
      ",\"y\":" +
      num(n.y) +
      ",\"w\":" +
      num(n.width) +
      ",\"h\":" +
      num(n.height) +
      ",\"group\":" +
      opt_q(n.group_id) +
      "}",
    )
  }
  sb.write_string("],\"groups\":[")
  for i = 0; i < sc.groups.length(); i = i + 1 {
    let g = sc.groups[i]
    if i > 0 {
      sb.write_byte(b',')
    }
    sb.write_string(
      "{\"id\":" + q(g.id) + ",\"title\":" + q(g.title) + ",\"kind\":" + q(g.kind) + ",\"x\":" + num(g.x) +
      ",\"y\":" +
      num(g.y) +
      ",\"w\":" +
      num(g.width) +
      ",\"h\":" +
      num(g.height) +
      ",\"parent\":" +
      opt_q(g.parent_id) +
      "}",
    )
  }
  sb.write_string("],\"edges\":[")
  for i = 0; i < sc.edges.length(); i = i + 1 {
    let e = sc.edges[i]
    if i > 0 {
      sb.write_byte(b',')
    }
    sb.write_string("{\"id\":" + q(e.id) + ",\"s\":" + q(e.from) + ",\"e\":" + q(e.to) + ",\"l\":" + q(e.label) + ",\"pts\":[")
    for k = 0; k < e.points.length(); k = k + 1 {
      if k > 0 {
        sb.write_byte(b',')
      }
      sb.write_string("[" + num(e.points[k].x) + "," + num(e.points[k].y) + "]")
    }
    sb.write_string("]}")
  }
  sb.write_string("],\"labels\":[")
  for i = 0; i < sc.labels.length(); i = i + 1 {
    let l = sc.labels[i]
    if i > 0 {
      sb.write_byte(b',')
    }
    sb.write_string(
      "{\"text\":" + q(l.text) + ",\"owner\":" + q(l.owner_id) + ",\"x\":" + num(l.x) + ",\"y\":" + num(l.y) +
      ",\"w\":" +
      num(l.width) +
      ",\"h\":" +
      num(l.height) +
      "}",
    )
  }
  sb.write_string("]}")
  sb.to_string()
}

///|
fn split_corpus(content : String) -> (Array[String], Array[String]) {
  let names : Array[String] = []
  let bodies : Array[String] = []
  let lines = content.split("\n")
  let mut cur = StringBuilder::new()
  let mut have = false
  for ln in lines {
    if ln.starts_with("%%CASE ") {
      if have {
        bodies.push(cur.to_string())
      }
      names.push(ln.slice(7, ln.length()).trim())
      cur = StringBuilder::new()
      have = true
    } else if have {
      cur.write_string(ln)
      cur.write_byte(b'\n')
    }
  }
  if have {
    bodies.push(cur.to_string())
  }
  (names, bodies)
}

///|
fn one_line(s : String) -> String {
  s.replace("\n", " ").replace("\t", " ")
}

///|
fn gen(kind : String, n : Int) -> String {
  let sb = StringBuilder::new()
  if kind == "chain" {
    sb.write_string("flowchart TD\n")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("  n" + i.to_string() + " --> n" + (i + 1).to_string() + "\n")
    }
  } else if kind == "wide" {
    // one root fanning out to n leaves, leaves fan back in to one sink (reverse-ordered)
    sb.write_string("flowchart TD\n")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("  r --> a" + i.to_string() + "\n")
    }
    for i = 0; i < n; i = i + 1 {
      sb.write_string("  a" + i.to_string() + " --> b" + (n - 1 - i).to_string() + "\n")
    }
  } else if kind == "dense" {
    // complete DAG on n nodes: every i -> j for i < j (n*(n-1)/2 edges, O(n^2) dummy nodes)
    sb.write_string("flowchart TD\n")
    for i = 0; i < n; i = i + 1 {
      for j = i + 1; j < n; j = j + 1 {
        sb.write_string("  n" + i.to_string() + " --> n" + j.to_string() + "\n")
      }
    }
  } else if kind == "scc" {
    // strongly connected: ring plus chords both ways
    sb.write_string("flowchart TD\n")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("  n" + i.to_string() + " --> n" + ((i + 1) % n).to_string() + "\n")
      sb.write_string("  n" + i.to_string() + " --> n" + ((i * 7 + 3) % n).to_string() + "\n")
      sb.write_string("  n" + ((i * 5 + 1) % n).to_string() + " --> n" + i.to_string() + "\n")
    }
  } else if kind == "nest" {
    sb.write_string("flowchart TD\n")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("subgraph s" + i.to_string() + "\n")
    }
    sb.write_string("  x --> y\n")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("end\n")
    }
  } else if kind == "seq" {
    sb.write_string("sequenceDiagram\n")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("  P" + (i % 20).to_string() + "->>P" + ((i * 7 + 1) % 20).to_string() + ": m" + i.to_string() + "\n")
    }
  } else if kind == "seqnest" {
    sb.write_string("sequenceDiagram\n")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("loop L" + i.to_string() + "\n")
    }
    sb.write_string("A->>B: x\n")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("end\n")
    }
  } else if kind == "statenest" {
    sb.write_string("stateDiagram-v2\n")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("state S" + i.to_string() + " {\n")
    }
    sb.write_string("A --> B\n")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("}\n")
    }
  } else if kind == "longline" {
    sb.write_string("flowchart TD\n  A[\"")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("x")
    }
    sb.write_string("\"] --> B\n")
  } else if kind == "subgraphs" {
    // n sibling subgraphs each with 4 nodes, cross-linked
    sb.write_string("flowchart TD\n")
    for i = 0; i < n; i = i + 1 {
      sb.write_string("subgraph g" + i.to_string() + "\n")
      for k = 0; k < 4; k = k + 1 {
        sb.write_string("  g" + i.to_string() + "n" + k.to_string() + " --> g" + i.to_string() + "n" + ((k + 1) % 4).to_string() + "\n")
      }
      sb.write_string("end\n")
    }
    for i = 0; i + 1 < n; i = i + 1 {
      sb.write_string("g" + i.to_string() + "n2 --> g" + (i + 1).to_string() + "n0\n")
    }
  }
  sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let args = args_get(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: probe parse|scene|svg|gen|time ...")
    return 1
  }
  let mode = args[1]
  if mode == "gen" {
    let n = args[3].to_int().unwrap_or(10)
    io_print(world, gen(args[2], n))
    return 0
  }
  let content = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(e) => {
      io_eprintln(world, "read error: " + e)
      return 1
    }
  }
  if mode == "svg" {
    match m::render(content) {
      Ok(svg) => io_print(world, svg + "\n")
      Err(e) => {
        io_eprintln(world, "ERR line " + e.line.to_string() + ": " + e.message)
        return 2
      }
    }
    return 0
  }
  if mode == "time" || mode == "count" {
    let iters = if args.length() >= 4 { args[3].to_int().unwrap_or(1) } else { 1 }
    let mut nn = 0
    let mut ne = 0
    let mut bytes = 0
    for it = 0; it < iters; it = it + 1 {
      match m::parse(content) {
        Ok(d) => {
          let sc = m::layout(d)
          let svg = m::render_svg(sc)
          nn = sc.nodes.length()
          ne = sc.edges.length()
          bytes = svg.length()
        }
        Err(e) => {
          io_eprintln(world, "ERR line " + e.line.to_string() + ": " + e.message)
          return 2
        }
      }
    }
    if mode == "count" {
      io_print(world, "nodes=" + nn.to_string() + " edges=" + ne.to_string() + "\n")
    } else {
      io_print(world, "nodes=" + nn.to_string() + " edges=" + ne.to_string() + " svg_bytes=" + bytes.to_string() + "\n")
    }
    return 0
  }
  let (names, bodies) = split_corpus(content)
  let sb = StringBuilder::new()
  for i = 0; i < names.length(); i = i + 1 {
    sb.write_string(names[i])
    sb.write_byte(b'\t')
    match m::parse(bodies[i]) {
      Ok(d) => {
        sb.write_string("OK\t")
        if mode == "scene" {
          sb.write_string(scene_json(diagram_meta(d), m::layout(d)))
        } else {
          sb.write_string(normalize(d))
        }
      }
      Err(e) => {
        sb.write_string("ERR\t")
        sb.write_string(one_line("line " + e.line.to_string() + ": " + e.message))
      }
    }
    sb.write_byte(b'\n')
  }
  io_print(world, sb.to_string())
  0
}
