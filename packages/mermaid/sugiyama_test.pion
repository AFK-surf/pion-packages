///| Ported Dagre / Sugiyama layout invariants, SVG renderer, and canonical JSON tests.

///|
fn make_node(id : String, w : Double, h : Double) -> GraphNodeInput {
  GraphNodeInput::{
    id: id,
    label: id,
    shape: "rect",
    width: w,
    height: h,
    parent: None,
  }
}

///|
fn make_node_in(id : String, w : Double, h : Double, parent : String) -> GraphNodeInput {
  GraphNodeInput::{
    id: id,
    label: id,
    shape: "rect",
    width: w,
    height: h,
    parent: Some(parent),
  }
}

///|
fn make_edge(from : String, to : String) -> GraphEdgeInput {
  GraphEdgeInput::{
    id: from + "->" + to,
    from: from,
    to: to,
    label: "",
    stroke: "solid",
    start_arrow: "none",
    end_arrow: "arrow",
    weight: 1,
    minlen: 1,
  }
}

///|
fn rect_overlap_area(a : LayoutNode, b : LayoutNode) -> Double {
  let ax0 = a.x - a.width / 2.0
  let ax1 = a.x + a.width / 2.0
  let ay0 = a.y - a.height / 2.0
  let ay1 = a.y + a.height / 2.0
  let bx0 = b.x - b.width / 2.0
  let bx1 = b.x + b.width / 2.0
  let by0 = b.y - b.height / 2.0
  let by1 = b.y + b.height / 2.0
  let ox = if ax1 < bx1 { ax1 } else { bx1 } - if ax0 > bx0 { ax0 } else { bx0 }
  let oy = if ay1 < by1 { ay1 } else { by1 } - if ay0 > by0 { ay0 } else { by0 }
  if ox > 0.0 && oy > 0.0 {
    ox * oy
  } else {
    0.0
  }
}

///|
fn assert_no_overlaps(scene : Scene) -> Unit {
  let n = scene.nodes.length()
  for i = 0; i < n; i = i + 1 {
    for j = i + 1; j < n; j = j + 1 {
      let area = rect_overlap_area(scene.nodes[i], scene.nodes[j])
      debug_assert(area == 0.0, "nodes overlap: " + scene.nodes[i].id + " and " + scene.nodes[j].id)
    }
  }
}

///|
fn find_layout_node(scene : Scene, id : String) -> LayoutNode {
  for n in scene.nodes {
    if n.id == id {
      return n
    }
  }
  debug_assert(false, "missing layout node: " + id)
  LayoutNode::{
    id: "",
    label: "",
    shape: "rect",
    x: 0.0,
    y: 0.0,
    width: 0.0,
    height: 0.0,
    rank: 0,
    order: 0,
    group_id: None,
  }
}

///|
test "sugiyama: empty graph returns zero-size scene" {
  let g = default_graph_input(Direction::TB)
  let scene = layout_sugiyama(g)
  debug_assert(scene.nodes.length() == 0 && scene.edges.length() == 0, "empty")
}

///|
test "sugiyama: single node centered with margins" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("a", 80.0, 40.0))
  let scene = layout_sugiyama(g)
  debug_assert(scene.nodes.length() == 1, "1 node")
  debug_assert(scene.width >= 80.0 && scene.height >= 40.0, "scene encloses node")
  let a = find_layout_node(scene, "a")
  debug_assert(a.x >= a.width / 2.0 && a.y >= a.height / 2.0, "positive coords")
}

///|
test "sugiyama: simple chain TB rank monotonicity" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("a", 80.0, 40.0))
  g.nodes.push(make_node("b", 80.0, 40.0))
  g.nodes.push(make_node("c", 80.0, 40.0))
  g.edges.push(make_edge("a", "b"))
  g.edges.push(make_edge("b", "c"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  let a = find_layout_node(scene, "a")
  let b = find_layout_node(scene, "b")
  let c = find_layout_node(scene, "c")
  debug_assert(a.rank < b.rank && b.rank < c.rank, "strict rank increase")
  debug_assert(a.y < b.y && b.y < c.y, "TB y increases")
}

///|
test "sugiyama: BT direction reverses y axis" {
  let g = default_graph_input(Direction::BT)
  g.nodes.push(make_node("a", 80.0, 40.0))
  g.nodes.push(make_node("b", 80.0, 40.0))
  g.edges.push(make_edge("a", "b"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  let a = find_layout_node(scene, "a")
  let b = find_layout_node(scene, "b")
  debug_assert(a.y > b.y, "BT: a below b")
}

///|
test "sugiyama: LR direction orders x left to right" {
  let g = default_graph_input(Direction::LR)
  g.nodes.push(make_node("a", 80.0, 40.0))
  g.nodes.push(make_node("b", 80.0, 40.0))
  g.nodes.push(make_node("c", 80.0, 40.0))
  g.edges.push(make_edge("a", "b"))
  g.edges.push(make_edge("b", "c"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  let a = find_layout_node(scene, "a")
  let b = find_layout_node(scene, "b")
  let c = find_layout_node(scene, "c")
  debug_assert(a.x < b.x && b.x < c.x, "LR x increases")
}

///|
test "sugiyama: RL direction orders x right to left" {
  let g = default_graph_input(Direction::RL)
  g.nodes.push(make_node("a", 80.0, 40.0))
  g.nodes.push(make_node("b", 80.0, 40.0))
  g.edges.push(make_edge("a", "b"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  let a = find_layout_node(scene, "a")
  let b = find_layout_node(scene, "b")
  debug_assert(a.x > b.x, "RL: a right of b")
}

///|
test "sugiyama: 2-cycle breaks cleanly and restores edge direction" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("a", 80.0, 40.0))
  g.nodes.push(make_node("b", 80.0, 40.0))
  g.edges.push(make_edge("a", "b"))
  g.edges.push(make_edge("b", "a"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  debug_assert(scene.edges.length() == 2, "both edges preserved")
  let mut has_rev = false
  for e in scene.edges {
    if e.reversed {
      has_rev = true
    }
    debug_assert(e.points.length() >= 2, "edge has polyline")
  }
  debug_assert(has_rev, "at least one edge marked reversed")
}

///|
test "sugiyama: 3-cycle terminates and has zero overlaps" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("a", 80.0, 40.0))
  g.nodes.push(make_node("b", 80.0, 40.0))
  g.nodes.push(make_node("c", 80.0, 40.0))
  g.edges.push(make_edge("a", "b"))
  g.edges.push(make_edge("b", "c"))
  g.edges.push(make_edge("c", "a"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  debug_assert(scene.nodes.length() == 3 && scene.edges.length() == 3, "3 nodes 3 edges")
}

///|
test "sugiyama: self-loop handled safely" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("a", 80.0, 40.0))
  g.edges.push(make_edge("a", "a"))
  let scene = layout_sugiyama(g)
  debug_assert(scene.nodes.length() == 1, "1 node")
  debug_assert(scene.edges.length() == 1, "1 self edge")
  debug_assert(scene.edges[0].points.length() >= 3, "self-loop has bend points")
}

///|
test "sugiyama: long edge inserts dummy nodes and produces intermediate bend points" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("a", 80.0, 40.0))
  g.nodes.push(make_node("b", 80.0, 40.0))
  g.nodes.push(make_node("c", 80.0, 40.0))
  g.nodes.push(make_node("d", 80.0, 40.0))
  g.edges.push(make_edge("a", "b"))
  g.edges.push(make_edge("b", "c"))
  g.edges.push(make_edge("c", "d"))
  g.edges.push(make_edge("a", "d"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  let mut long_pts = 0
  for e in scene.edges {
    if e.from == "a" && e.to == "d" {
      long_pts = e.points.length()
    }
  }
  debug_assert(long_pts >= 4, "long edge a->d has dummy intermediate points")
}

///|
test "sugiyama: parallel multi-edges both preserved" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("a", 80.0, 40.0))
  g.nodes.push(make_node("b", 80.0, 40.0))
  g.edges.push(make_edge("a", "b"))
  g.edges.push(GraphEdgeInput::{
    id: "e2",
    from: "a",
    to: "b",
    label: "second",
    stroke: "dotted",
    start_arrow: "none",
    end_arrow: "arrow",
    weight: 1,
    minlen: 1,
  })
  let scene = layout_sugiyama(g)
  debug_assert(scene.edges.length() == 2, "both parallel edges")
}

///|
test "sugiyama: disconnected components laid out without overlap" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("a", 80.0, 40.0))
  g.nodes.push(make_node("b", 80.0, 40.0))
  g.nodes.push(make_node("c", 80.0, 40.0))
  g.nodes.push(make_node("d", 80.0, 40.0))
  g.edges.push(make_edge("a", "b"))
  g.edges.push(make_edge("c", "d"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  debug_assert(scene.nodes.length() == 4, "4 nodes")
}

///|
test "sugiyama: diamond graph zero overlap and centered" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("top", 80.0, 40.0))
  g.nodes.push(make_node("left", 80.0, 40.0))
  g.nodes.push(make_node("right", 80.0, 40.0))
  g.nodes.push(make_node("bot", 80.0, 40.0))
  g.edges.push(make_edge("top", "left"))
  g.edges.push(make_edge("top", "right"))
  g.edges.push(make_edge("left", "bot"))
  g.edges.push(make_edge("right", "bot"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  let top = find_layout_node(scene, "top")
  let left = find_layout_node(scene, "left")
  let right = find_layout_node(scene, "right")
  let bot = find_layout_node(scene, "bot")
  debug_assert(top.rank == 0 && left.rank == 1 && right.rank == 1 && bot.rank == 2, "diamond ranks")
  debug_assert(left.y == right.y, "same layer y")
}

///|
test "sugiyama: crossing minimization untangles crossed bipartite pair" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("u1", 60.0, 30.0))
  g.nodes.push(make_node("u2", 60.0, 30.0))
  g.nodes.push(make_node("v1", 60.0, 30.0))
  g.nodes.push(make_node("v2", 60.0, 30.0))
  // Crossed in declaration order: u1->v2 and u2->v1
  g.edges.push(make_edge("u1", "v2"))
  g.edges.push(make_edge("u2", "v1"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  let m = measure_layout(scene)
  debug_assert(m.crossings == 0, "0 crossings after barycenter ordering")
}

///|
test "sugiyama: subgraph bounding box encloses all child nodes" {
  let g = default_graph_input(Direction::TB)
  g.groups.push(GraphGroupInput::{ id: "sg1", title: "Cluster", parent: None })
  g.nodes.push(make_node_in("a", 80.0, 40.0, "sg1"))
  g.nodes.push(make_node_in("b", 80.0, 40.0, "sg1"))
  g.nodes.push(make_node("c", 80.0, 40.0))
  g.edges.push(make_edge("a", "b"))
  g.edges.push(make_edge("b", "c"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  debug_assert(scene.groups.length() == 1, "1 group")
  let sg = scene.groups[0]
  let a = find_layout_node(scene, "a")
  let b = find_layout_node(scene, "b")
  debug_assert(sg.x <= a.x - a.width / 2.0 && sg.x + sg.width >= a.x + a.width / 2.0, "sg encloses a x")
  debug_assert(sg.y <= a.y - a.height / 2.0 && sg.y + sg.height >= a.y + a.height / 2.0, "sg encloses a y")
  debug_assert(sg.x <= b.x - b.width / 2.0 && sg.x + sg.width >= b.x + b.width / 2.0, "sg encloses b x")
  debug_assert(sg.y <= b.y - b.height / 2.0 && sg.y + sg.height >= b.y + b.height / 2.0, "sg encloses b y")
}

///|
test "sugiyama: nested subgraph outer encloses inner" {
  let g = default_graph_input(Direction::TB)
  g.groups.push(GraphGroupInput::{ id: "outer", title: "Outer", parent: None })
  g.groups.push(GraphGroupInput::{ id: "inner", title: "Inner", parent: Some("outer") })
  g.nodes.push(make_node_in("x", 80.0, 40.0, "inner"))
  g.nodes.push(make_node_in("y", 80.0, 40.0, "outer"))
  g.edges.push(make_edge("x", "y"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  debug_assert(scene.groups.length() == 2, "2 groups")
  let outer = scene.groups[0]
  let inner = scene.groups[1]
  debug_assert(outer.x <= inner.x && outer.y <= inner.y, "outer top-left <= inner")
  debug_assert(outer.x + outer.width >= inner.x + inner.width, "outer right >= inner")
  debug_assert(outer.y + outer.height >= inner.y + inner.height, "outer bottom >= inner")
}

///|
test "sugiyama: wider nodes do not overlap on same rank" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("root", 60.0, 30.0))
  g.nodes.push(make_node("wide1", 220.0, 50.0))
  g.nodes.push(make_node("wide2", 180.0, 50.0))
  g.nodes.push(make_node("wide3", 200.0, 50.0))
  g.edges.push(make_edge("root", "wide1"))
  g.edges.push(make_edge("root", "wide2"))
  g.edges.push(make_edge("root", "wide3"))
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
}

///|
test "sugiyama: edge labels placed in scene.labels" {
  let g = default_graph_input(Direction::TB)
  g.nodes.push(make_node("a", 80.0, 40.0))
  g.nodes.push(make_node("b", 80.0, 40.0))
  g.edges.push(GraphEdgeInput::{
    id: "e0",
    from: "a",
    to: "b",
    label: "Yes",
    stroke: "solid",
    start_arrow: "none",
    end_arrow: "arrow",
    weight: 1,
    minlen: 1,
  })
  let scene = layout_sugiyama(g)
  debug_assert(scene.labels.length() >= 1, "edge label placed")
  debug_assert(scene.labels[0].text == "Yes", "label text Yes")
}

///|
test "sugiyama: 100% deterministic across repeated runs" {
  let src =
  #|flowchart TD
  #| A[Start] --> B{Branch}
  #| B -->|Yes| C[Process 1]
  #| B -->|No| D[Process 2]
  #| C --> E((End))
  #| D --> E
  #| E -.-> A
  let svg1 = match render(src) {
    Ok(s) => s
    Err(_) => ""
  }
  let svg2 = match render(src) {
    Ok(s) => s
    Err(_) => ""
  }
  debug_assert(svg1.length() > 0 && svg1 == svg2, "byte-identical SVG")
}

///|
test "sugiyama: 50-node layered DAG zero overlaps and monotonic ranks" {
  let g = default_graph_input(Direction::TB)
  for i = 0; i < 50; i = i + 1 {
    g.nodes.push(make_node("n" + i.to_string(), 70.0, 32.0))
  }
  for i = 0; i < 45; i = i + 1 {
    g.edges.push(make_edge("n" + i.to_string(), "n" + (i + 5).to_string()))
    if i % 3 == 0 && i + 6 < 50 {
      g.edges.push(make_edge("n" + i.to_string(), "n" + (i + 6).to_string()))
    }
  }
  let scene = layout_sugiyama(g)
  assert_no_overlaps(scene)
  let rank_map : Map[String, Int] = Map::new()
  for n in scene.nodes {
    rank_map.set(n.id, n.rank)
  }
  for e in scene.edges {
    if !e.reversed {
      let rf = rank_map.get(e.from).unwrap_or(-1)
      let rt = rank_map.get(e.to).unwrap_or(-1)
      debug_assert(rf < rt, "forward edge rank strictly increases")
    }
  }
}

///|
test "svg: render_svg produces valid svg root with viewBox and elements" {
  let src = "flowchart LR\nA[Hello] -->|go| B((World))"
  match render(src) {
    Ok(svg) => {
      debug_assert(svg.starts_with("<svg "), "starts with <svg")
      debug_assert(svg.contains("viewBox="), "has viewBox")
      debug_assert(svg.contains("Hello") && svg.contains("World"), "contains labels")
      debug_assert(svg.ends_with("</svg>"), "ends with </svg>")
    }
    Err(e) => debug_assert(false, "render failed: " + e.message)
  }
}

///|
test "svg: escapes xml special characters in labels" {
  let src = "flowchart TD\nA[\"x < y & z > 0\"]"
  match render(src) {
    Ok(svg) => {
      debug_assert(svg.contains("&lt;") && svg.contains("&amp;") && svg.contains("&gt;"), "xml escaped")
    }
    Err(e) => debug_assert(false, "render failed: " + e.message)
  }
}

///|
test "canon: canonical_graph_json deterministic for flowchart" {
  let d1 = match parse("flowchart TD\nB --> C\nA --> B") {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      Diagram::Flowchart(FlowchartDiagram::{
        direction: Direction::TB,
        nodes: [],
        edges: [],
        subgraphs: [],
        class_defs: [],
      })
    }
  }
  let j = canonical_graph_json(d1)
  debug_assert(j.starts_with("{"), "json object")
  debug_assert(j.contains("\"kind\":\"flowchart\""), "kind flowchart")
  debug_assert(j.contains("\"direction\":\"TB\""), "direction TB")
}

///|
test "canon: canonical_graph_json works for all 5 diagram kinds" {
  let samples : Array[String] = [
    "flowchart LR\nA --> B",
    "sequenceDiagram\nAlice->>Bob: Hi",
    "stateDiagram-v2\n[*] --> Active",
    "classDiagram\nAnimal <|-- Dog",
    "erDiagram\nCUSTOMER ||--o{ ORDER : places",
  ]
  for s in samples {
    match parse(s) {
      Ok(d) => {
        let j = canonical_graph_json(d)
        debug_assert(j.length() > 10 && j.starts_with("{"), "valid canon json")
      }
      Err(e) => debug_assert(false, "parse failed: " + e.message)
    }
  }
}

///|
test "metrics: measure_layout reports positive area and edge length" {
  let src = "flowchart TD\nA --> B\nB --> C"
  match parse(src) {
    Ok(d) => {
      let scene = layout(d)
      let m = measure_layout(scene)
      debug_assert(m.area > 0.0, "positive area")
      debug_assert(m.total_edge_length > 0.0, "positive edge length")
      debug_assert(m.crossings == 0, "0 crossings")
    }
    Err(_) => debug_assert(false, "parse failed")
  }
}
