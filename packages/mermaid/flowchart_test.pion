test "flow: shape parallelogram [/ /]" {
  let fc = must_parse_flow("flowchart TD\np[/Input/]")
  let n = must_flow_node(fc, "p")
  debug_assert(n.shape == NodeShape::Parallelogram, "parallelogram")
  debug_assert(n.label == "Input", "label")
}

///|
test "flow: shape parallelogram alt [\\ \\]" {
  let fc = must_parse_flow("flowchart TD\np[\\Output\\]")
  let n = must_flow_node(fc, "p")
  debug_assert(n.shape == NodeShape::ParallelogramAlt, "parallelogram alt")
  debug_assert(n.label == "Output", "label")
}

///|
test "flow: shape trapezoid [/ \\]" {
  let fc = must_parse_flow("flowchart TD\nt[/Trapezoid\\]")
  let n = must_flow_node(fc, "t")
  debug_assert(n.shape == NodeShape::Trapezoid, "trapezoid")
  debug_assert(n.label == "Trapezoid", "label")
}

///|
test "flow: shape trapezoid alt [\\ /]" {
  let fc = must_parse_flow("flowchart TD\nt[\\Trapezoid Alt/]")
  let n = must_flow_node(fc, "t")
  debug_assert(n.shape == NodeShape::TrapezoidAlt, "trapezoid alt")
  debug_assert(n.label == "Trapezoid Alt", "label")
}

///|
test "flow: edge solid arrow -->" {
  let fc = must_parse_flow("flowchart LR\nA --> B")
  debug_assert(fc.edges.length() == 1, "1 edge")
  let e = fc.edges[0]
  debug_assert(e.from == "A" && e.to == "B", "A->B")
  debug_assert(e.stroke == EdgeStroke::Solid, "solid")
  debug_assert(e.start_arrow == ArrowHead::None, "no start arrow")
  debug_assert(e.end_arrow == ArrowHead::Arrow, "end arrow")
}

///|
test "flow: edge open line ---" {
  let fc = must_parse_flow("flowchart LR\nA --- B")
  let e = fc.edges[0]
  debug_assert(e.stroke == EdgeStroke::Solid, "solid")
  debug_assert(e.end_arrow == ArrowHead::None, "open")
}

///|
test "flow: edge dotted arrow -.->" {
  let fc = must_parse_flow("flowchart LR\nA -.-> B")
  let e = fc.edges[0]
  debug_assert(e.stroke == EdgeStroke::Dotted, "dotted")
  debug_assert(e.end_arrow == ArrowHead::Arrow, "arrow")
}

///|
test "flow: edge thick arrow ==>" {
  let fc = must_parse_flow("flowchart LR\nA ==> B")
  let e = fc.edges[0]
  debug_assert(e.stroke == EdgeStroke::Thick, "thick")
  debug_assert(e.end_arrow == ArrowHead::Arrow, "arrow")
}

///|
test "flow: edge bidirectional <-->, o--o, x--x" {
  let fc = must_parse_flow("flowchart LR\nA <--> B\nB o--o C\nC x--x D")
  debug_assert(fc.edges.length() == 3, "3 edges")
  debug_assert(fc.edges[0].start_arrow == ArrowHead::Arrow && fc.edges[0].end_arrow == ArrowHead::Arrow, "<-->")
  debug_assert(fc.edges[1].start_arrow == ArrowHead::Circle && fc.edges[1].end_arrow == ArrowHead::Circle, "o--o")
  debug_assert(fc.edges[2].start_arrow == ArrowHead::Cross && fc.edges[2].end_arrow == ArrowHead::Cross, "x--x")
}

///|
test "flow: edge cross and circle ends --x, --o" {
  let fc = must_parse_flow("flowchart TD\nA --x B\nB --o C")
  debug_assert(fc.edges.length() == 2, "2 edges")
  debug_assert(fc.edges[0].end_arrow == ArrowHead::Cross, "--x")
  debug_assert(fc.edges[1].end_arrow == ArrowHead::Circle, "--o")
}

///|
test "flow: edge invisible ~~~" {
  let fc = must_parse_flow("flowchart TD\nA ~~~ B")
  debug_assert(fc.edges.length() == 1, "1 edge")
  debug_assert(fc.edges[0].stroke == EdgeStroke::Invisible, "invisible")
}

///|
test "flow: edge pipe label -->|text|" {
  let fc = must_parse_flow("flowchart TD\nA -->|Yes| B\nA -.->|Maybe| C")
  debug_assert(fc.edges.length() == 2, "2 edges")
  debug_assert(fc.edges[0].label == "Yes", "Yes")
  debug_assert(fc.edges[1].label == "Maybe", "Maybe")
  debug_assert(fc.edges[1].stroke == EdgeStroke::Dotted, "dotted")
}

///|
test "flow: edge inline label -- text --> and == text ==>" {
  let fc = must_parse_flow("flowchart LR\nA -- solid label --> B\nB == thick label ==> C\nC -. dotted label .-> D")
  debug_assert(fc.edges.length() == 3, "3 edges")
  debug_assert(fc.edges[0].label == "solid label" && fc.edges[0].stroke == EdgeStroke::Solid, "solid inline")
  debug_assert(fc.edges[1].label == "thick label" && fc.edges[1].stroke == EdgeStroke::Thick, "thick inline")
  debug_assert(fc.edges[2].label == "dotted label" && fc.edges[2].stroke == EdgeStroke::Dotted, "dotted inline")
}

///|
test "flow: edge chaining A --> B --> C" {
  let fc = must_parse_flow("flowchart LR\nA[Start] --> B{Check} -->|ok| C((Done))")
  debug_assert(fc.nodes.length() == 3, "3 nodes")
  debug_assert(fc.edges.length() == 2, "2 edges")
  debug_assert(fc.edges[0].from == "A" && fc.edges[0].to == "B", "A->B")
  debug_assert(fc.edges[1].from == "B" && fc.edges[1].to == "C" && fc.edges[1].label == "ok", "B->C")
}

///|
test "flow: ampersand multi-source and multi-target A & B --> C & D" {
  let fc = must_parse_flow("flowchart TD\nA & B --> C & D")
  debug_assert(fc.nodes.length() == 4, "4 nodes")
  debug_assert(fc.edges.length() == 4, "4 edges")
  debug_assert(fc.edges[0].from == "A" && fc.edges[0].to == "C", "A->C")
  debug_assert(fc.edges[1].from == "A" && fc.edges[1].to == "D", "A->D")
  debug_assert(fc.edges[2].from == "B" && fc.edges[2].to == "C", "B->C")
  debug_assert(fc.edges[3].from == "B" && fc.edges[3].to == "D", "B->D")
}

///|
test "flow: subgraph with id and title" {
  let src =
  #|flowchart TB
  #| subgraph sg1 [Backend Services]
  #| api[API] --> db[(DB)]
  #| end
  #| client[Web] --> api
  let fc = must_parse_flow(src)
  debug_assert(fc.subgraphs.length() == 1, "1 subgraph")
  debug_assert(fc.subgraphs[0].id == "sg1", "sg1")
  debug_assert(fc.subgraphs[0].title == "Backend Services", "title")
  debug_assert(fc.subgraphs[0].node_ids.length() == 2, "2 nodes in sg")
  let api = must_flow_node(fc, "api")
  debug_assert(api.subgraph.unwrap_or("") == "sg1", "api in sg1")
}

///|
test "flow: nested subgraphs with inner direction" {
  let src =
  #|flowchart TB
  #| subgraph outer [Outer]
  #| subgraph inner [Inner]
  #| direction LR
  #| a --> b
  #| end
  #| c --> a
  #| end
  let fc = must_parse_flow(src)
  debug_assert(fc.subgraphs.length() == 2, "2 subgraphs")
  debug_assert(fc.subgraphs[0].id == "outer", "outer")
  debug_assert(fc.subgraphs[1].id == "inner", "inner")
  debug_assert(fc.subgraphs[1].parent.unwrap_or("") == "outer", "inner parent outer")
  debug_assert(fc.subgraphs[1].direction.unwrap_or(Direction::TB) == Direction::LR, "inner LR")
}

///|
test "flow: classDef, class, :::shorthand, and style" {
  let src =
  #|flowchart TD
  #| classDef hot fill:#f96,stroke:#333
  #| A[Start]:::hot --> B[End]
  #| class B hot
  #| style A stroke-width:4px
  let fc = must_parse_flow(src)
  debug_assert(fc.class_defs.length() == 1, "1 classDef")
  debug_assert(fc.class_defs[0].name == "hot", "hot")
  let a = must_flow_node(fc, "A")
  let b = must_flow_node(fc, "B")
  debug_assert(a.classes.length() == 1 && a.classes[0] == "hot", "A class hot")
  debug_assert(b.classes.length() == 1 && b.classes[0] == "hot", "B class hot")
  debug_assert(a.style == "stroke-width:4px", "A style")
}

///|
test "flow: comments %% stripped everywhere" {
  let src =
  #|%% leading comment
  #|flowchart TD
  #| %% inside comment
  #| A[Alpha] --> B[Beta] %% trailing comment
  let fc = must_parse_flow(src)
  debug_assert(fc.nodes.length() == 2, "2 nodes")
  debug_assert(fc.edges.length() == 1, "1 edge")
  debug_assert(must_flow_node(fc, "B").label == "Beta", "Beta")
}

///|
test "flow: quoted labels with special chars and escapes" {
  let src =
  #|flowchart TD
  #| A["Hello \"World\" (a & b)"] --> B["Line 1 <br> Line 2"]
  let fc = must_parse_flow(src)
  let a = must_flow_node(fc, "A")
  let b = must_flow_node(fc, "B")
  debug_assert(a.label == "Hello \"World\" (a & b)", "escaped quotes")
  debug_assert(b.label == "Line 1 <br> Line 2", "html br")
}

///|
test "flow: edge with explicit id e1@-->" {
  let fc = must_parse_flow("flowchart LR\nA e1@--> B")
  debug_assert(fc.edges.length() == 1, "1 edge")
  debug_assert(fc.edges[0].id.unwrap_or("") == "e1", "edge id e1")
}

///|
test "flow: longer arrows increase minlen" {
  let fc = must_parse_flow("flowchart TD\nA --> B\nA ----> C")
  debug_assert(fc.edges.length() == 2, "2 edges")
  debug_assert(fc.edges[0].minlen == 1, "minlen 1")
  debug_assert(fc.edges[1].minlen >= 2, "minlen >= 2")
}

///|
test "flow: invalid syntax rejected - unknown header" {
  match parse("unknownDiagram\nA --> B") {
    Ok(_) => debug_assert(false, "should fail on unknown diagram")
    Err(e) => debug_assert(e.line == 1, "error at line 1")
  }
}

///|
test "flow: invalid syntax rejected - unclosed subgraph" {
  let src =
  #|flowchart TD
  #| subgraph s1
  #| A --> B
  match parse(src) {
    Ok(_) => debug_assert(false, "should fail on unclosed subgraph")
    Err(e) => debug_assert(e.line >= 1, "error has line")
  }
}

///|
test "flow: invalid syntax rejected - unmatched end" {
  let src =
  #|flowchart TD
  #| A --> B
  #| end
  match parse(src) {
    Ok(_) => debug_assert(false, "should fail on stray end")
    Err(e) => debug_assert(e.line == 3, "error at line 3")
  }
}

///|
test "flow: invalid syntax rejected - dangling edge" {
  match parse("flowchart TD\nA -->") {
    Ok(_) => debug_assert(false, "should fail on dangling edge")
    Err(e) => debug_assert(e.line == 2, "error at line 2")
  }
}
