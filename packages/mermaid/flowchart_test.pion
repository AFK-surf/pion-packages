///|
test "flow: shape asymmetric >]" {
  let fc = must_parse_flow("flowchart TD\na>Flag shape]")
  let n = must_flow_node(fc, "a")
  debug_assert(n.shape == NodeShape::Asymmetric, "asymmetric")
  debug_assert(n.label == "Flag shape", "label")
}

