///| Ported Flowchart parser test suite (from mermaid-js/mermaid flowchart specs).

///|
fn must_parse_flow(src : String) -> FlowchartDiagram {
  match parse(src) {
    Ok(Diagram::Flowchart(fc)) => fc
    Ok(_) => {
      debug_assert(false, "expected Flowchart diagram")
      FlowchartDiagram::{
        direction: Direction::TB,
        nodes: [],
        edges: [],
        subgraphs: [],
        class_defs: [],
      }
    }
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      FlowchartDiagram::{
        direction: Direction::TB,
        nodes: [],
        edges: [],
        subgraphs: [],
        class_defs: [],
      }
    }
  }
}

///|
fn find_flow_node(fc : FlowchartDiagram, id : String) -> Option[FlowNode] {
  for n in fc.nodes {
    if n.id == id {
      return Some(n)
    }
  }
  None
}

///|
fn must_flow_node(fc : FlowchartDiagram, id : String) -> FlowNode {
  match find_flow_node(fc, id) {
    Some(n) => n
    None => {
      debug_assert(false, "missing node: " + id)
      FlowNode::{
        id: "",
        label: "",
        shape: NodeShape::Rect,
        classes: [],
        style: "",
        subgraph: None,
      }
    }
  }
}

///|
test "flow: direction TD maps to TB" {
  let fc = must_parse_flow("graph TD;\nA;")
  debug_assert(fc.direction == Direction::TB, "TD -> TB")
  debug_assert(fc.nodes.length() == 1, "1 node")
  debug_assert(fc.edges.length() == 0, "0 edges")
}

///|
test "flow: direction TB" {
  let fc = must_parse_flow("flowchart TB\nA --> B")
  debug_assert(fc.direction == Direction::TB, "TB")
  debug_assert(fc.nodes.length() == 2, "2 nodes")
  debug_assert(fc.edges.length() == 1, "1 edge")
}

///|
test "flow: direction BT" {
  let fc = must_parse_flow("flowchart BT\nA --> B")
  debug_assert(fc.direction == Direction::BT, "BT")
}

///|
test "flow: direction LR" {
  let fc = must_parse_flow("flowchart LR\nA --> B")
  debug_assert(fc.direction == Direction::LR, "LR")
}

///|
test "flow: direction RL" {
  let fc = must_parse_flow("graph RL\nA --> B")
  debug_assert(fc.direction == Direction::RL, "RL")
}

///|
test "flow: single bare node with semicolon and spaces" {
  let fc = must_parse_flow("graph TD;A ;")
  debug_assert(fc.nodes.length() == 1, "1 node")
  let n = must_flow_node(fc, "A")
  debug_assert(n.label == "A", "default label")
  debug_assert(n.shape == NodeShape::Rect, "default rect")
}

///|
test "flow: shape rect []" {
  let fc = must_parse_flow("flowchart TD\na[Square Label]")
  let n = must_flow_node(fc, "a")
  debug_assert(n.shape == NodeShape::Rect, "rect")
  debug_assert(n.label == "Square Label", "label")
}

///|
test "flow: shape round ()" {
  let fc = must_parse_flow("flowchart TD\na(Round Label)")
  let n = must_flow_node(fc, "a")
  debug_assert(n.shape == NodeShape::Round, "round")
  debug_assert(n.label == "Round Label", "label")
}

///|
test "flow: shape stadium ([])" {
  let fc = must_parse_flow("flowchart TD\na([Stadium Label])")
  let n = must_flow_node(fc, "a")
  debug_assert(n.shape == NodeShape::Stadium, "stadium")
  debug_assert(n.label == "Stadium Label", "label")
}

