  let fc = must_parse_flow("flowchart TD\nh{{Prepare}}")
  let n = must_flow_node(fc, "h")
  debug_assert(n.shape == NodeShape::Hexagon, "hexagon")
  debug_assert(n.label == "Prepare", "label")
