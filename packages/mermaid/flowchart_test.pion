test "flow: shape subroutine [[]]" {
  let fc = must_parse_flow("flowchart TD\na[[Subroutine]]")
  let n = must_flow_node(fc, "a")
  debug_assert(n.shape == NodeShape::Subroutine, "subroutine")
  debug_assert(n.label == "Subroutine", "label")
}

