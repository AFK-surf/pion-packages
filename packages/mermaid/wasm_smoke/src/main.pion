///| Wasm32 compilation smoke test for packages/mermaid.

import "mermaid" as m

///|
pub fn smoke() -> Int {
  let src =
  #|flowchart TD
  #| A[Start] --> B{Check}
  #| B -->|yes| C((Done))
  match m::parse(src) {
    Ok(d) => {
      let scene = m::layout(d)
      let svg = m::render_svg(scene)
      let canon = m::canonical_graph_json(d)
      svg.length() + canon.length()
    }
    Err(_) => -1
  }
}

///|
pub fn main(world : World) -> Int {
  let n = smoke()
  io_println(world, "wasm_smoke bytes=" + n.to_string())
  if n > 0 { 0 } else { 1 }
}
