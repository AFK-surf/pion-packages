///| Pion Native benchmark CLI: Sugiyama layered layout on 50 / 200 / 500 node graphs.
///| Usage: bench_layout <graphs_file> [--iters N] [--metrics]

import "mermaid" as m

///|
fn count_overlaps(scene : m::Scene) -> Int {
  let mut cnt = 0
  let n = scene.nodes.length()
  for i = 0; i < n; i = i + 1 {
    let a = scene.nodes[i]
    let ax0 = a.x - a.width / 2.0
    let ax1 = a.x + a.width / 2.0
    let ay0 = a.y - a.height / 2.0
    let ay1 = a.y + a.height / 2.0
    for j = i + 1; j < n; j = j + 1 {
      let b = scene.nodes[j]
      let bx0 = b.x - b.width / 2.0
      let bx1 = b.x + b.width / 2.0
      let by0 = b.y - b.height / 2.0
      let by1 = b.y + b.height / 2.0
      let ox = if ax1 < bx1 { ax1 } else { bx1 } - if ax0 > bx0 { ax0 } else { bx0 }
      let oy = if ay1 < by1 { ay1 } else { by1 } - if ay0 > by0 { ay0 } else { by0 }
      if ox > 1.0e-6 && oy > 1.0e-6 {
        cnt = cnt + 1
      }
    }
  }
  cnt
}

///|
fn check_rank_monotonic(scene : m::Scene) -> Bool {
  let rmap : Map[String, Int] = Map::new()
  for n in scene.nodes {
    rmap.set(n.id, n.rank)
  }
  for e in scene.edges {
    if !e.reversed && e.from != e.to {
      let rf = rmap.get(e.from).unwrap_or(-1)
      let rt = rmap.get(e.to).unwrap_or(-1)
      if rf >= rt {
        return false
      }
    }
  }
  true
}

///|
pub fn main(world : World) -> Int {
  let args = args_get(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: bench_layout <graphs_file> [--iters N] [--metrics]")
    return 1
  }
  let mut iters = 1
  let mut show_metrics = false
  let mut ai = 2
  while ai < args.length() {
    if args[ai] == "--iters" && ai + 1 < args.length() {
      iters = args[ai + 1].to_int().unwrap_or(1)
      if iters < 1 {
        iters = 1
      }
      ai = ai + 2
    } else if args[ai] == "--metrics" {
      show_metrics = true
      ai = ai + 1
    } else {
      ai = ai + 1
    }
  }
  let content = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(e) => {
      io_eprintln(world, "read error: " + e)
      return 1
    }
  }
  let lines = content.split("\n")
  let names : Array[String] = []
  let graphs : Array[m::GraphInput] = []
  let mut cur_idx = -1
  let mut edge_seq = 0
  for raw in lines {
    let line = raw.trim()
    if line.length() == 0 {
      continue
    }
    let toks = line.split(" ")
    if toks.length() == 0 {
      continue
    }
    if toks[0] == "GRAPH" && toks.length() >= 2 {
      names.push(toks[1])
      graphs.push(m::default_graph_input(m::Direction::TB))
      cur_idx = graphs.length() - 1
      edge_seq = 0
    } else if toks[0] == "N" && toks.length() >= 4 && cur_idx >= 0 {
      let w = toks[2].to_double().unwrap_or(80.0)
      let h = toks[3].to_double().unwrap_or(40.0)
      graphs[cur_idx].nodes.push(m::GraphNodeInput::{
        id: toks[1],
        label: toks[1],
        shape: "rect",
        width: w,
        height: h,
        parent: None,
      })
    } else if toks[0] == "E" && toks.length() >= 3 && cur_idx >= 0 {
      graphs[cur_idx].edges.push(m::GraphEdgeInput::{
        id: "e" + edge_seq.to_string(),
        from: toks[1],
        to: toks[2],
        label: "",
        stroke: "solid",
        start_arrow: "none",
        end_arrow: "arrow",
        weight: 1,
        minlen: 1,
      })
      edge_seq = edge_seq + 1
    }
  }

  let mut total_nodes = 0L
  let mut total_edges = 0L
  let mut total_overlaps = 0
  let mut all_rank_ok = true
  let mut all_finite = true
  let mut last_out = ""

  for iter = 0; iter < iters; iter = iter + 1 {
    let sb = StringBuilder::new()
    for i = 0; i < graphs.length(); i = i + 1 {
      let scene = m::layout_sugiyama(graphs[i])
      let overlaps = count_overlaps(scene)
      let mono = check_rank_monotonic(scene)
      let finite_ok = scene.width > 0.0 && scene.height > 0.0
      total_nodes = total_nodes + scene.nodes.length().to_int64()
      total_edges = total_edges + scene.edges.length().to_int64()
      total_overlaps = total_overlaps + overlaps
      if !mono {
        all_rank_ok = false
      }
      if !finite_ok {
        all_finite = false
      }
      if iter + 1 == iters {
        sb.write_string(names[i])
        sb.write_string(" nodes=")
        sb.write_string(scene.nodes.length().to_string())
        sb.write_string(" edges=")
        sb.write_string(scene.edges.length().to_string())
        sb.write_string(" overlaps=")
        sb.write_string(overlaps.to_string())
        sb.write_string(" rank_ok=")
        sb.write_string(if mono { "true" } else { "false" })
        sb.write_string(" finite=")
        sb.write_string(if finite_ok { "true" } else { "false" })
        if show_metrics {
          let met = m::measure_layout(scene)
          sb.write_string(" crossings=")
          sb.write_string(met.crossings.to_string())
          sb.write_string(" edge_len=")
          sb.write_string(met.total_edge_length.round().to_int64().to_string())
          sb.write_string(" area=")
          sb.write_string(met.area.round().to_int64().to_string())
        }
        sb.write_byte(b'\n')
      }
    }
    if iter + 1 == iters {
      last_out = sb.to_string()
    }
  }
  let hdr = "iters=" +
  iters.to_string() +
  " total_nodes=" +
  total_nodes.to_string() +
  " total_edges=" +
  total_edges.to_string() +
  " total_overlaps=" +
  total_overlaps.to_string() +
  " all_rank_ok=" +
  (if all_rank_ok { "true" } else { "false" }) +
  " all_finite=" +
  (if all_finite { "true" } else { "false" }) +
  "\n"
  io_print(world, hdr + last_out)
  0
}
