///| Pion Native benchmark CLI: parse multi-diagram corpus and emit canonical topology JSON.

import "mermaid" as m

///|
pub fn main(world : World) -> Int {
  let args = args_get(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: bench_parse <corpus_file>")
    return 1
  }
  let path = args[1]
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(e) => {
      io_eprintln(world, "read error: " + e)
      return 1
    }
  }
  let parts = content.split("\n===DIAGRAM===\n")
  let sb = StringBuilder::new()
  for raw in parts {
    let s = raw.trim()
    if s.length() == 0 {
      continue
    }
    match m::parse(s) {
      Ok(d) => {
        sb.write_string(m::canonical_graph_json(d))
        sb.write_byte(b'\n')
      }
      Err(e) => {
        io_eprintln(world, "parse error line " + e.line.to_string() + ": " + e.message)
        return 2
      }
    }
  }
  io_print(world, sb.to_string())
  0
}
