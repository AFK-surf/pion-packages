///| Pion Native benchmark CLI: parse multi-diagram corpus and emit canonical topology JSON.
///| Usage: bench_parse <corpus_file> [--iters N]

import "mermaid" as m

///|
pub fn main(world : World) -> Int {
  let args = args_get(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: bench_parse <corpus_file> [--iters N]")
    return 1
  }
  let path = args[1]
  let mut iters = 1
  let mut ai = 2
  while ai < args.length() {
    if args[ai] == "--iters" && ai + 1 < args.length() {
      iters = args[ai + 1].to_int().unwrap_or(1)
      if iters < 1 {
        iters = 1
      }
      ai = ai + 2
    } else {
      ai = ai + 1
    }
  }
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(e) => {
      io_eprintln(world, "read error: " + e)
      return 1
    }
  }
  let raw_parts = content.split("\n===DIAGRAM===\n")
  let diagrams : Array[String] = []
  for raw in raw_parts {
    let s = raw.trim()
    if s.length() > 0 {
      diagrams.push(s)
    }
  }

  let mut total_bytes = 0L
  let mut last_out = ""
  for iter = 0; iter < iters; iter = iter + 1 {
    let sb = StringBuilder::new()
    for s in diagrams {
      match m::parse(s) {
        Ok(d) => {
          sb.write_string(m::canonical_graph_json(d))
          sb.write_byte(b'\n')
        }
        Err(e) => {
          io_eprintln(world, "parse error line " + e.line.to_string() + ": " + e.message)
          return 2
        }
      }
    }
    let out_str = sb.to_string()
    total_bytes = total_bytes + out_str.length().to_int64()
    if iter + 1 == iters {
      last_out = out_str
    }
  }
  io_print(world, "iters=" + iters.to_string() + " total_bytes=" + total_bytes.to_string() + "\n" + last_out)
  0
}
