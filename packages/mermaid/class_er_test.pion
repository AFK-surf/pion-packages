///| Ported Class Diagram & ER Diagram parser + layout test suite (from mermaid-js/mermaid class & er specs).

///|
fn must_parse_class(src : String) -> ClassDiagram {
  match parse(src) {
    Ok(Diagram::Class(cd)) => cd
    Ok(_) => {
      debug_assert(false, "expected Class diagram")
      ClassDiagram::{ direction: Direction::TB, classes: [], relations: [] }
    }
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      ClassDiagram::{ direction: Direction::TB, classes: [], relations: [] }
    }
  }
}

///|
fn find_class(cd : ClassDiagram, id : String) -> Option[ClassNode] {
  for c in cd.classes {
    if c.id == id {
      return Some(c)
    }
  }
  None
}

///|
fn must_parse_er(src : String) -> ErDiagram {
  match parse(src) {
    Ok(Diagram::Er(ed)) => ed
    Ok(_) => {
      debug_assert(false, "expected ER diagram")
      ErDiagram::{ direction: Direction::TB, entities: [], relations: [] }
    }
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      ErDiagram::{ direction: Direction::TB, entities: [], relations: [] }
    }
  }
}

///|
fn find_er_entity(ed : ErDiagram, id : String) -> Option[ErEntity] {
  for e in ed.entities {
    if e.id == id {
      return Some(e)
    }
  }
  None
}

///|
test "class: basic class block with fields and methods" {
  let src =
  #|classDiagram
  #| class Animal {
    #| +int age
    #| -String name
    #| #bool alive
    #| ~int id
    #| +isMammal() bool
    #| +mate()
    #| }
  let cd = must_parse_class(src)
  debug_assert(cd.classes.length() == 1, "1 class")
  let c = cd.classes[0]
  debug_assert(c.id == "Animal", "Animal")
  debug_assert(c.members.length() == 6, "6 members")
  debug_assert(c.members[0].visibility == "+" && !c.members[0].is_method, "+age field")
  debug_assert(c.members[1].visibility == "-" && !c.members[1].is_method, "-name field")
  debug_assert(c.members[2].visibility == "#", "#alive")
  debug_assert(c.members[3].visibility == "~", "~id")
  debug_assert(c.members[4].is_method && c.members[5].is_method, "methods")
}

///|
test "class: colon member syntax ClassName : member" {
  let src =
  #|classDiagram
  #| BankAccount : +String owner
  #| BankAccount : +deposit(amount)
  let cd = must_parse_class(src)
  match find_class(cd, "BankAccount") {
    Some(c) => debug_assert(c.members.length() == 2, "2 members")
    None => debug_assert(false, "missing BankAccount")
  }
}

///|
test "class: annotations <<interface>> and <<abstract>>" {
  let src =
  #|classDiagram
  #| class Shape {
    #| <<interface>>
      #| +area() double
      #| }
    #| <<abstract>> Vehicle
      let cd = must_parse_class(src)
      match find_class(cd, "Shape") {
        Some(c) => debug_assert(c.annotation == "interface", "interface")
        None => debug_assert(false, "missing Shape")
      }
      match find_class(cd, "Vehicle") {
        Some(c) => debug_assert(c.annotation == "abstract", "abstract")
        None => debug_assert(false, "missing Vehicle")
      }
    }

    ///|
    test "class: generic type parameter ~T~" {
      let src =
      #|classDiagram
      #| class List~T~ {
        #| +add(T item)
        #| }
      let cd = must_parse_class(src)
      match find_class(cd, "List") {
        Some(c) => debug_assert(c.generic == "T", "generic T")
        None => debug_assert(false, "missing List")
      }
    }

    ///|
    test "class: inheritance <|-- and --|>" {
      let src =
      #|classDiagram
      #| Animal <|-- Duck
      #| Fish --|> Animal
      let cd = must_parse_class(src)
      debug_assert(cd.relations.length() == 2, "2 relations")
      debug_assert(cd.relations[0].kind == ClassRelationKind::Inheritance, "inheritance 0")
      debug_assert(cd.relations[1].kind == ClassRelationKind::Inheritance, "inheritance 1")
    }

    ///|
    test "class: composition *-- and aggregation o--" {
      let src =
      #|classDiagram
      #| Car *-- Engine
      #| Library o-- Book
      let cd = must_parse_class(src)
      debug_assert(cd.relations.length() == 2, "2 relations")
      debug_assert(cd.relations[0].kind == ClassRelationKind::Composition, "composition")
      debug_assert(cd.relations[1].kind == ClassRelationKind::Aggregation, "aggregation")
    }

    ///|
    test "class: association -->, link --, dependency ..>, realization ..|>" {
      let src =
      #|classDiagram
      #| A --> B : uses
      #| B -- C : links
      #| C ..> D : depends
      #| D ..|> E : implements
      let cd = must_parse_class(src)
      debug_assert(cd.relations.length() == 4, "4 relations")
      debug_assert(cd.relations[0].kind == ClassRelationKind::Association && cd.relations[0].label == "uses", "assoc")
      debug_assert(cd.relations[1].kind == ClassRelationKind::Link && cd.relations[1].label == "links", "link")
      debug_assert(cd.relations[2].kind == ClassRelationKind::Dependency && cd.relations[2].label == "depends", "dep")
      debug_assert(cd.relations[3].kind == ClassRelationKind::Realization && cd.relations[3].label == "implements", "real")
    }

    ///|
    test "class: relation cardinalities" {
      let src =
      #|classDiagram
      #| Customer "1" --> "*" Order : places
      let cd = must_parse_class(src)
      debug_assert(cd.relations.length() == 1, "1 relation")
      debug_assert(cd.relations[0].from_card == "1", "from 1")
      debug_assert(cd.relations[0].to_card == "*", "to *")
      debug_assert(cd.relations[0].label == "places", "label places")
    }

    ///|
    test "class: namespace with backtick-quoted names" {
      let src =
      #|classDiagram
      #| namespace Core {
        #| class Engine
        #| }
      #| namespace `A::B` {
        #| class `IPC::Sender`
        #| }
      let cd = must_parse_class(src)
      match find_class(cd, "Engine") {
        Some(c) => debug_assert(c.namespace_name.unwrap_or("") == "Core", "Core ns")
        None => debug_assert(false, "missing Engine")
      }
      match find_class(cd, "IPC::Sender") {
        Some(c) => debug_assert(c.namespace_name.unwrap_or("") == "A::B", "A::B ns")
        None => debug_assert(false, "missing IPC::Sender")
      }
    }

    ///|
    test "class: prototype-safe class names __proto__ and constructor" {
      let src =
      #|classDiagram
      #| class __proto__
      #| class constructor
      let cd = must_parse_class(src)
      debug_assert(find_class(cd, "__proto__").is_some(), "__proto__")
      debug_assert(find_class(cd, "constructor").is_some(), "constructor")
    }

    ///|
    test "class: direction RL" {
      let src =
      #|classDiagram
      #| direction RL
      #| A <|-- B
      let cd = must_parse_class(src)
      debug_assert(cd.direction == Direction::RL, "RL")
    }

    ///|
    test "class: invalid unclosed class block rejected" {
      let src =
      #|classDiagram
      #| class Broken {
        #| +int x
        match parse(src) {
          Ok(_) => debug_assert(false, "should fail unclosed class")
          Err(e) => debug_assert(e.line >= 1, "line")
        }
      }

      ///|
      test "class layout: produces nodes and edges with positive dimensions" {
        let src =
        #|classDiagram
        #| Animal <|-- Duck
        #| Animal <|-- Fish
        #| class Animal {
          #| +int age
          #| +eat()
          #| }
        let scene = layout(Diagram::Class(must_parse_class(src)))
        debug_assert(scene.nodes.length() == 3, "3 nodes")
        debug_assert(scene.edges.length() == 2, "2 edges")
        debug_assert(scene.width > 0.0 && scene.height > 0.0, "positive dims")
      }

      ///|
      test "er: standalone entities" {
        let src =
        #|erDiagram
        #| ISLAND
        #| MAINLAND
        let ed = must_parse_er(src)
        debug_assert(ed.entities.length() == 2, "2 entities")
        debug_assert(ed.relations.length() == 0, "0 relations")
      }

      ///|
      test "er: entity with hyphens and underscores" {
        let ed = must_parse_er("erDiagram\n  DUCK-BILLED_PLATYPUS")
        debug_assert(find_er_entity(ed, "DUCK-BILLED_PLATYPUS").is_some(), "hyphen/underscore entity")
      }

      ///|
      test "er: entity with quoted alias" {
        let ed = must_parse_er("erDiagram\n  foo[\"bar\"]")
        match find_er_entity(ed, "foo") {
          Some(e) => debug_assert(e.alias == "bar", "alias bar")
          None => debug_assert(false, "missing foo")
        }
      }

      ///|
      test "er: entity attributes with type, name, keys, and comment" {
        let src =
        #|erDiagram
        #| CUSTOMER {
          #| int id PK
          #| string email UK "Primary contact"
          #| int org_id FK
          #| }
        let ed = must_parse_er(src)
        match find_er_entity(ed, "CUSTOMER") {
          Some(e) => {
            debug_assert(e.attributes.length() == 3, "3 attrs")
            debug_assert(e.attributes[0].attr_type == "int" && e.attributes[0].name == "id", "id")
            debug_assert(e.attributes[0].keys.length() == 1 && e.attributes[0].keys[0] == "PK", "PK")
            debug_assert(e.attributes[1].comment == "Primary contact", "comment")
            debug_assert(e.attributes[2].keys.length() == 1 && e.attributes[2].keys[0] == "FK", "FK")
          }
          None => debug_assert(false, "missing CUSTOMER")
        }
      }

      ///|
      test "er: identifying relationship ||--o{" {
        let src =
        #|erDiagram
        #| CUSTOMER ||--o{ ORDER : places
          let ed = must_parse_er(src)
          debug_assert(ed.relations.length() == 1, "1 relation")
          let r = ed.relations[0]
          debug_assert(r.from == "CUSTOMER" && r.to == "ORDER", "CUSTOMER->ORDER")
          debug_assert(r.from_card == ErCardinality::OnlyOne, "only one")
          debug_assert(r.to_card == ErCardinality::ZeroOrMore, "zero or more")
          debug_assert(r.identifying, "identifying")
          debug_assert(r.label == "places", "places")
        }

        ///|
        test "er: non-identifying relationship |o..|{" {
          let src =
          #|erDiagram
          #| PERSON |o..|{ ADDRESS : "lives at"
            let ed = must_parse_er(src)
            debug_assert(ed.relations.length() == 1, "1 relation")
            let r = ed.relations[0]
            debug_assert(r.from_card == ErCardinality::ZeroOrOne, "zero or one")
            debug_assert(r.to_card == ErCardinality::OneOrMore, "one or more")
            debug_assert(!r.identifying, "non-identifying")
            debug_assert(r.label == "lives at", "quoted label")
          }

          ///|
          test "er: all cardinality combinations" {
            let src =
            #|erDiagram
            #| A ||--|| B : one-to-one
            #| B }|--o| C : many-to-zero-or-one
          #| C }o..|{ D : zero-or-more-to-one-or-more
          let ed = must_parse_er(src)
          debug_assert(ed.relations.length() == 3, "3 relations")
          debug_assert(ed.relations[0].from_card == ErCardinality::OnlyOne && ed.relations[0].to_card == ErCardinality::OnlyOne, "1:1")
          debug_assert(ed.relations[1].from_card == ErCardinality::OneOrMore && ed.relations[1].to_card == ErCardinality::ZeroOrOne, "1+:0..1")
          debug_assert(ed.relations[2].from_card == ErCardinality::ZeroOrMore && ed.relations[2].to_card == ErCardinality::OneOrMore, "0+:1+")
        }

        ///|
        test "er: quoted entity names with spaces" {
          let src =
          #|erDiagram
          #| "ORDER ITEM" }|--|| PRODUCT : references
        let ed = must_parse_er(src)
        debug_assert(find_er_entity(ed, "ORDER ITEM").is_some(), "ORDER ITEM")
        debug_assert(ed.relations.length() == 1, "1 relation")
      }

      ///|
      test "er: comments ignored" {
        let src =
        #|erDiagram
        #| %% schema comment
        #| USER ||--o{ POST : writes
          let ed = must_parse_er(src)
          debug_assert(ed.relations.length() == 1, "1 relation")
        }

        ///|
        test "er: invalid empty quoted entity name rejected" {
          match parse("erDiagram\n  \"\"") {
            Ok(_) => debug_assert(false, "should fail empty quotes")
            Err(e) => debug_assert(e.line == 2, "line 2")
          }
        }

        ///|
        test "er: invalid unclosed attribute block rejected" {
          let src =
          #|erDiagram
          #| USER {
            #| int id PK
            match parse(src) {
              Ok(_) => debug_assert(false, "should fail unclosed block")
              Err(e) => debug_assert(e.line >= 1, "line")
            }
          }

          ///|
          test "er layout: produces non-overlapping entity boxes and edges" {
            let src =
            #|erDiagram
            #| CUSTOMER ||--o{ ORDER : places
              #| ORDER ||--|{ LINE_ITEM : contains
                #| CUSTOMER {
                  #| int id PK
                  #| string name
                  #| }
                let scene = layout(Diagram::Er(must_parse_er(src)))
                debug_assert(scene.nodes.length() == 3, "3 entity boxes")
                debug_assert(scene.edges.length() == 2, "2 relation edges")
                debug_assert(scene.width > 0.0 && scene.height > 0.0, "positive dims")
              }
