///| Red-team CLI for `packages/encoding` (native + wasm32).
///|   run <casefile>                 -> one result line per case line (protocol: diff/oracle/src/main.rs)
///|   time <enc> <hex pattern> <bytes> <chunk> -> decode a repeated pattern; `<ms> out=<len> fnv=<h> err=<E|.>`
///|   enctime <enc> <hex utf8 pattern> <bytes> -> encode_html a repeated pattern; `<ms> out=<len> fnv=<h>`
///|   list | case <name>            -> red-team / control cases (src/cases.pion)

import "encoding"

///|
fn parse_uint(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Decode hex in `s[start..end]`; `-` is the empty string.
fn unhex_range(s : String, start : Int, end : Int) -> Bytes {
  if end - start == 1 && s.code_unit_at(start) == 45 {
    return Bytes::new(0)
  }
  let n = (end - start) / 2
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hexval(s.code_unit_at(start + 2 * i))
    let lo = hexval(s.code_unit_at(start + 2 * i + 1))
    b[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  b
}

///|
pub fn unhex(s : String) -> Bytes {
  unhex_range(s, 0, s.length())
}

///|
fn hexdigit(v : Int) -> Byte {
  if v < 10 {
    (v + 48).to_byte()
  } else {
    (v + 87).to_byte()
  }
}

///|
fn write_hex_bytes(sb : StringBuilder, b : Bytes) -> Unit {
  if b.length() == 0 {
    sb.write_byte((45).to_byte())
    return ()
  }
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int() & 0xFF
    sb.write_byte(hexdigit(v >> 4))
    sb.write_byte(hexdigit(v & 15))
    i = i + 1
  }
}

///|
fn write_hex_str(sb : StringBuilder, s : String) -> Unit {
  if s.length() == 0 {
    sb.write_byte((45).to_byte())
    return ()
  }
  let mut i = 0
  while i < s.length() {
    let v = s.code_unit_at(i) & 0xFF
    sb.write_byte(hexdigit(v >> 4))
    sb.write_byte(hexdigit(v & 15))
    i = i + 1
  }
}

///| Split on `sep`, keeping empty fields.
fn split_on(s : String, sep : Int) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == sep {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(start, s.length()))
  out
}

///| Split on '\n', dropping empty lines.
fn split_lines(b : Bytes) -> Array[String] {
  let out : Array[String] = []
  let n = b.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || b[i].to_int() == 10 {
      if i > start {
        out.push(b.slice(start, i).to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  out
}

///|
pub fn enc_of(name : String) -> encoding::Encoding {
  match encoding::Encoding::for_label(name) {
    Some(e) => e
    None => encoding::Encoding::Utf8
  }
}

///| Feed `chunks` to a decoder; `empty_between` inserts an empty non-last chunk before each one,
///| `final_empty` appends an empty last chunk. Returns (output, had_errors, fatal error).
fn feed(
  dec : encoding::Decoder,
  chunks : Array[Bytes],
  empty_between : Bool,
  final_empty : Bool,
) -> (String, Bool, Bool) {
  let sb = StringBuilder::new()
  let mut had = false
  let mut i = 0
  while i < chunks.length() {
    if empty_between {
      match dec.decode_chunk(Bytes::new(0), false) {
        Ok(s) => sb.write_string(s)
        Err(_) => return ("", had, true)
      }
      had = had || dec.had_errors()
    }
    let last = !final_empty && i + 1 == chunks.length()
    match dec.decode_chunk(chunks[i], last) {
      Ok(s) => sb.write_string(s)
      Err(_) => return ("", had, true)
    }
    had = had || dec.had_errors()
    i = i + 1
  }
  if final_empty || chunks.length() == 0 {
    match dec.decode_chunk(Bytes::new(0), true) {
      Ok(s) => sb.write_string(s)
      Err(_) => return ("", had, true)
    }
    had = had || dec.had_errors()
  }
  (sb.to_string(), had, false)
}

///|
fn run_decode(sb : StringBuilder, p : Array[String]) -> Unit {
  let enc = enc_of(p[1])
  let fatal = p[2].code_unit_at(0) == 102
  let ignore_bom = p[2].code_unit_at(1) == 105
  let spec = p[3]
  let hx = p[4]
  let dec = encoding::Decoder::with_options(enc, encoding::DecodeOptions::new(fatal, ignore_bom))
  let c0 = spec.code_unit_at(0)
  let res = if c0 == 120 {
    // x: explicit chunks
    let parts = split_on(hx, 46)
    let chunks : Array[Bytes] = []
    let mut i = 0
    while i < parts.length() {
      chunks.push(unhex(parts[i]))
      i = i + 1
    }
    feed(dec, chunks, false, false)
  } else if c0 == 107 || c0 == 101 {
    // k<N> / e<N>
    let n = parse_uint(spec.slice(1, spec.length()))
    let data = unhex(hx)
    let chunks : Array[Bytes] = []
    let mut i = 0
    while i < data.length() {
      let e = if i + n < data.length() { i + n } else { data.length() }
      chunks.push(data.slice(i, e))
      i = e
    }
    feed(dec, chunks, c0 == 101, true)
  } else if c0 == 114 {
    // r: dirty the state, reset(), then a whole decode
    let data = unhex(hx)
    let _ = dec.decode_chunk(data, false)
    dec.reset()
    feed(dec, [data], false, false)
  } else if c0 == 117 {
    // u: reuse after a completed (last=true) stream
    let data = unhex(hx)
    let _ = dec.decode_chunk(data, true)
    feed(dec, [data], false, false)
  } else {
    feed(dec, [unhex(hx)], false, false)
  }
  let (s, had, err) = res
  if err {
    sb.write_string("ERR")
  } else {
    write_hex_str(sb, s)
    sb.write_string(if had { " E" } else { " ." })
  }
}

///|
fn run_line(sb : StringBuilder, line : String) -> Unit {
  let p = split_on(line, 32)
  let k = p[0]
  if k == "D" {
    run_decode(sb, p)
  } else if k == "S" {
    let (s, used, had) = encoding::decode_with_bom_sniffing(enc_of(p[1]), unhex(p[2]))
    write_hex_str(sb, s)
    sb.write_string(" " + used.name() + (if had { " E" } else { " ." }))
  } else if k == "E" {
    let s = unhex(p[3]).to_string()
    if p[2] == "h" {
      let (b, unm) = encoding::encode_html(enc_of(p[1]), s)
      write_hex_bytes(sb, b)
      sb.write_string(if unm { " U" } else { " ." })
    } else {
      match encoding::encode(enc_of(p[1]), s) {
        Ok(b) => {
          sb.write_string("OK ")
          write_hex_bytes(sb, b)
        }
        Err(_) => sb.write_string("ERR")
      }
    }
  } else if k == "L" {
    let l = unhex(p[1]).to_string()
    let a = match encoding::Encoding::for_label(l) {
      Some(e) => e.name()
      None => "-"
    }
    let b = match encoding::Encoding::for_label_no_replacement(l) {
      Some(e) => e.name()
      None => "-"
    }
    sb.write_string(a + " " + b)
  } else {
    sb.write_string(line)
  }
  sb.write_byte((10).to_byte())
}

///|
fn fnv1a64_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let mut i = 0
  while i < s.length() {
    h = h ^ (s.code_unit_at(i) & 0xFF).to_int64().to_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn fnv1a64_bytes(b : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let mut i = 0
  while i < b.length() {
    h = h ^ (b[i].to_int() & 0xFF).to_int64().to_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn repeat_to(pat : Bytes, total : Int) -> Bytes {
  let b = Bytes::new(total)
  let n = pat.length()
  let mut i = 0
  while i < total {
    b[i] = pat[i % n]
    i = i + 1
  }
  b
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: encoding_audit run <casefile> | time <enc> <hex> <bytes> <chunk> | enctime <enc> <hex> <bytes> | list | case <name>")
    return 2
  }
  let mode = args[1]
  if mode == "run" && args.length() >= 3 {
    let lines = match fs_read_bytes(world, args[2]) {
      Ok(b) => split_lines(b)
      Err(_) => return 3
    }
    let mut sb = StringBuilder::new()
    let mut i = 0
    while i < lines.length() {
      run_line(sb, lines[i])
      if sb.length() > (1 << 20) {
        io_print(world, sb.to_string())
        sb = StringBuilder::new()
      }
      i = i + 1
    }
    io_print(world, sb.to_string())
    return 0
  }
  if mode == "time" && args.length() >= 6 {
    let enc = enc_of(args[2])
    let data = repeat_to(unhex(args[3]), parse_uint(args[4]))
    let chunk = parse_uint(args[5])
    let dec = encoding::Decoder::new(enc)
    let t0 = clock_monotonic_us()
    let sb = StringBuilder::new()
    let mut had = false
    if chunk == 0 {
      match dec.decode_chunk(data, true) {
        Ok(s) => sb.write_string(s)
        Err(_) => ()
      }
      had = dec.had_errors()
    } else {
      let mut i = 0
      while i < data.length() {
        let e = if i + chunk < data.length() { i + chunk } else { data.length() }
        match dec.decode_chunk(data.slice(i, e), false) {
          Ok(s) => sb.write_string(s)
          Err(_) => ()
        }
        had = had || dec.had_errors()
        i = e
      }
      match dec.decode_chunk(Bytes::new(0), true) {
        Ok(s) => sb.write_string(s)
        Err(_) => ()
      }
      had = had || dec.had_errors()
    }
    let out = sb.to_string()
    let t1 = clock_monotonic_us()
    io_println(
      world,
      ((t1 - t0) / 1000L).to_string() + " out=" + out.length().to_string() + " fnv=" + fnv1a64_str(out).to_string() +
      " err=" +
      (if had { "E" } else { "." }),
    )
    return 0
  }
  if mode == "enctime" && args.length() >= 5 {
    let enc = enc_of(args[2])
    let pat = unhex(args[3])
    let reps = parse_uint(args[4]) / pat.length()
    let sb = StringBuilder::new()
    let ps = pat.to_string()
    let mut k = 0
    while k < reps {
      sb.write_string(ps)
      k = k + 1
    }
    let s = sb.to_string()
    let t0 = clock_monotonic_us()
    let (b, unm) = encoding::encode_html(enc, s)
    let t1 = clock_monotonic_us()
    io_println(
      world,
      ((t1 - t0) / 1000L).to_string() + " out=" + b.length().to_string() + " fnv=" + fnv1a64_bytes(b).to_string() +
      " unm=" +
      (if unm { "U" } else { "." }),
    )
    return 0
  }
  if mode == "list" {
    let names = rt_all_cases()
    let mut i = 0
    while i < names.length() {
      io_println(world, names[i])
      i = i + 1
    }
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = rt_run_case(args[2])
    if r == "" {
      io_println(world, "PASS " + args[2])
      return 0
    }
    io_println(world, "FAIL " + args[2] + " :: " + r)
    return 1
  }
  io_println(world, "bad arguments")
  2
}
