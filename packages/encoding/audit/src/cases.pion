///| Every pin, whole and 1/2/3-byte chunked, with empty chunks, non-fatal and fatal.
fn control_decode_pins() -> String {
  let pins = decode_pins()
  let mut i = 0
  while i < pins.length() {
    let (en, inp, want, werr) = pins[i]
    let enc = enc_of(en)
    let data = unhex(inp)
    let ks = [0, 1, 2, 3]
    let mut j = 0
    while j < ks.length() {
      let mut e = 0
      while e < 2 {
        let (s, had, _) = dec_chunked(enc, data, ks[j], e == 1, false)
        if hex_of_str(s) != want || had != werr {
          return en + " " + inp + " k=" + ks[j].to_string() + ": got " + hex_of_str(s) + " " + had.to_string() + ", want " +
          want +
          " " +
          werr.to_string()
        }
        let (fs, _, ferr) = dec_chunked(enc, data, ks[j], e == 1, true)
        if ferr != werr || (!ferr && hex_of_str(fs) != want) {
          return en + " " + inp + " fatal k=" + ks[j].to_string() + ": error=" + ferr.to_string() + ", want " + werr.to_string()
        }
        e = e + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  ""
}

///| (encoding, mode h|s, input utf8 hex, encoding_rs result)
fn encode_pins() -> Array[(String, String, String, String)] {
  [
    ("ISO-2022-JP", "h", "e381820e", "1b244224221b2842262336353533333b U"),
    ("ISO-2022-JP", "h", "efbda1e28892", "1b24422123215d1b2842 ."),
    ("ISO-2022-JP", "h", "41e4b8ad5c", "411b244243661b28425c ."),
    ("gb18030", "s", "ee9789", "OK a384"),
    ("gb18030", "s", "efb890", "OK a6d9"),
    ("gb18030", "s", "e282ac", "OK a2e3"),
    ("gb18030", "s", "ee9fa7", "OK 8336c831"),
    ("gb18030", "s", "f48fbfbf", "OK e3329a35"),
    ("gb18030", "s", "ee9785", "OK a380"),
    ("gb18030", "s", "ee97a5", "ERR"),
    ("GBK", "h", "e282ac", "80 ."),
    ("GBK", "h", "f09f9880", "26233132383531323b U"),
    ("Big5", "s", "e29590", "OK f9f9"),
    ("Big5", "s", "c38acc84", "ERR"),
    ("Shift_JIS", "s", "c2a5e280bee28892", "OK 5c7e817c"),
    ("EUC-JP", "s", "efbda1", "OK 8ea1"),
    ("windows-1252", "h", "41e4b8ad42", "41262332303031333b42 U"),
    ("UTF-16BE", "h", "e4b8ad", "e4b8ad ."),
    ("replacement", "s", "e4b8ad", "OK e4b8ad"),
    ("x-user-defined", "s", "ef9e80", "OK 80"),
    ("x-user-defined", "h", "c280", "26233132383b U"),
  ]
}

///|
fn control_encode_pins() -> String {
  let pins = encode_pins()
  let mut i = 0
  while i < pins.length() {
    let (en, mode, inp, want) = pins[i]
    let sb = StringBuilder::new()
    run_line(sb, "E " + en + " " + mode + " " + inp)
    let out = sb.to_string()
    let got = out.slice(0, out.length() - 1)
    if got != want {
      return en + " " + mode + " " + inp + ": got " + got + ", want " + want
    }
    i = i + 1
  }
  ""
}

///|
fn upper_ascii(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    sb.write_byte((if c >= 97 && c <= 122 { c - 32 } else { c }).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| The 6 labels of the replacement encoding: for_label -> replacement, for_label_no_replacement -> None,
///| non-empty input -> exactly one U+FFFD (even 1 byte at a time), empty -> "", fatal -> Err once.
fn control_replacement() -> String {
  let labels = ["csiso2022kr", "hz-gb-2312", "iso-2022-cn", "iso-2022-cn-ext", "iso-2022-kr", "replacement"]
  let mut i = 0
  while i < labels.length() {
    let l = "\t " + upper_ascii(labels[i]) + "\n"
    match encoding::Encoding::for_label(l) {
      Some(e) => if e.name() != "replacement" { return labels[i] + " -> " + e.name() }
      None => return labels[i] + " -> None"
    }
    match encoding::Encoding::for_label_no_replacement(l) {
      Some(e) => return labels[i] + " no_replacement -> " + e.name()
      None => ()
    }
    i = i + 1
  }
  let r = encoding::Encoding::Replacement
  let big = unhex("1b2429434142430e2121")
  let (s1, h1, _) = dec_chunked(r, big, 1, true, false)
  if s1 != "\u{FFFD}" || !h1 {
    return "1-byte streaming: " + hex_of_str(s1)
  }
  let (s0, h0, _) = dec_chunked(r, Bytes::new(0), 1, true, false)
  if s0 != "" || h0 {
    return "empty input: " + hex_of_str(s0)
  }
  let (_, _, f) = dec_chunked(r, big, 3, false, true)
  if !f {
    return "fatal replacement must fail"
  }
  let (_, _, f0) = dec_chunked(r, Bytes::new(0), 0, false, true)
  if f0 {
    return "fatal replacement on empty input must succeed"
  }
  ""
}

///| WHATWG ASCII whitespace only (09 0A 0C 0D 20) is trimmed; VT, NBSP, U+3000, NEL, U+212A KELVIN are not.
fn control_label_whitespace() -> String {
  let good = ["\t\n\x0C\r utf-8 \r\x0C\n\t", "  GB18030", "Shift_JIS\x0C", "\nWindows-1252\n"]
  let mut i = 0
  while i < good.length() {
    match encoding::Encoding::for_label(good[i]) {
      Some(_) => ()
      None => return "rejected " + hex_of_str(good[i])
    }
    i = i + 1
  }
  let bad = [
    "\x0Butf-8", "utf-8\x0B", "\u{00A0}utf-8", "utf-8\u{00A0}", "\u{3000}utf-8", "utf-8\u{3000}", "\u{0085}utf-8",
    "utf 8", "", "   ", "\u{212A}oi8-r", "utf-8\x00", "x-user-defined2",
  ]
  i = 0
  while i < bad.length() {
    match encoding::Encoding::for_label(bad[i]) {
      Some(e) => return "accepted " + hex_of_str(bad[i]) + " as " + e.name()
      None => ()
    }
    i = i + 1
  }
  ""
}

///| BOM split across chunks (with empty chunks in between), fake BOMs, ignore_bom, reset() and reuse.
fn control_bom_stream() -> String {
  let cases : Array[(String, String, Bool, String)] = [
    ("UTF-8", "ef.bb.bf.41", false, "41"),
    ("UTF-8", "ef..bb..bf41", false, "41"),
    ("UTF-8", "ef.bb.bf.41", true, "efbbbf41"),
    ("UTF-8", "ef.bb.00", false, "efbfbd00"),
    ("UTF-8", "ef.bb", false, "efbfbd"),
    ("UTF-8", "ef", false, "efbfbd"),
    ("UTF-8", "ef.bc.80", false, "efbc80"),
    ("UTF-8", "41.efbbbf", false, "41efbbbf"),
    ("UTF-16LE", "ff.fe.41.00", false, "41"),
    ("UTF-16LE", "ff.fe.41.00", true, "efbbbf41"),
    ("UTF-16LE", "fe.ff", false, "efbfbe"),
    ("UTF-16BE", "fe.ff.00.41", false, "41"),
    ("UTF-16BE", "ff.fe", false, "efbfbe"),
    ("UTF-16BE", "fe", false, "efbfbd"),
    ("windows-1252", "ef.bb.bf", false, "c3afc2bbc2bf"),
    ("gb18030", "ef.bb.bf", false, "e99498efbfbd"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (en, pieces, ign, want) = cases[i]
    let parts = split_on(pieces, 46)
    let chunks : Array[Bytes] = []
    let mut j = 0
    while j < parts.length() {
      chunks.push(if parts[j] == "" { Bytes::new(0) } else { unhex(parts[j]) })
      j = j + 1
    }
    let dec = encoding::Decoder::with_options(enc_of(en), encoding::DecodeOptions::new(false, ign))
    let (s, _, _) = feed(dec, chunks, false, false)
    if hex_of_str(s) != want {
      return en + " " + pieces + " ignore_bom=" + ign.to_string() + ": got " + hex_of_str(s) + ", want " + want
    }
    // the decoder resets after last=true: the BOM must be stripped again on the next stream
    let (s2, _, _) = feed(dec, chunks, false, false)
    if hex_of_str(s2) != want {
      return en + " " + pieces + " reuse: got " + hex_of_str(s2) + ", want " + want
    }
    i = i + 1
  }
  // reset() in the middle of a BOM / a multi-byte sequence
  let d = encoding::Decoder::new(encoding::Encoding::Utf8)
  let _ = d.decode_chunk(unhex("efbb"), false)
  d.reset()
  match d.decode_chunk(unhex("efbbbf41"), true) {
    Ok(s) => if s != "A" { return "reset mid-BOM: " + hex_of_str(s) }
    Err(_) => return "reset mid-BOM: Err"
  }
  let g = encoding::Decoder::new(encoding::Encoding::Gb18030)
  let _ = g.decode_chunk(unhex("813081"), false)
  g.reset()
  match g.decode_chunk(unhex("30"), true) {
    Ok(s) => if s != "0" { return "reset mid-gb18030: " + hex_of_str(s) }
    Err(_) => return "reset mid-gb18030: Err"
  }
  ""
}

///| BOM sniffing one-shot decode == encoding_rs `Encoding::decode`.
fn control_bom_sniffing() -> String {
  let cases : Array[(String, String, String, String)] = [
    ("windows-1252", "efbbbf41", "41", "UTF-8"),
    ("Shift_JIS", "fffe4100", "41", "UTF-16LE"),
    ("UTF-8", "feff0041", "41", "UTF-16BE"),
    ("UTF-16BE", "4100", "e48480", "UTF-16BE"),
    ("replacement", "41", "efbfbd", "replacement"),
    ("replacement", "efbbbf41", "41", "UTF-8"),
    ("gb18030", "efbb", "e99498", "gb18030"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (en, inp, want, wenc) = cases[i]
    let (s, used, _) = encoding::decode_with_bom_sniffing(enc_of(en), unhex(inp))
    if hex_of_str(s) != want || used.name() != wenc {
      return en + " " + inp + ": got " + hex_of_str(s) + " " + used.name() + ", want " + want + " " + wenc
    }
    i = i + 1
  }
  ""
}

// ---------------------------------------------------------------------------------------------
// red-team cases: FAIL while the finding is open
// ---------------------------------------------------------------------------------------------

///| P2-1: ISO-2022-JP encode_html must not leave the Roman state for an NCR or for U+000E/U+000F/U+001B.
///| WHATWG §12.2.2 steps 3 and 11: only the jis0208 state switches to ASCII before an error.
fn redteam_p2_1_iso2022jp_roman_ncr() -> String {
  let cases : Array[(String, String)] = [
    ("c2a5f09f9880", "1b284a5c26233132383531323b1b2842"),
    ("c2a50e41", "1b284a5c262336353533333b411b2842"),
    ("e280bee4b8ad", "1b284a7e1b244243661b2842"),
    ("e280bef09f9880e280be", "1b284a7e26233132383531323b7e1b2842"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (inp, want) = cases[i]
    let (b, _) = encoding::encode_html(encoding::Encoding::Iso2022Jp, unhex(inp).to_string())
    if hex_of_bytes(b) != want {
      return inp + ": got " + hex_of_bytes(b) + ", want (WHATWG / encoding_rs) " + want
    }
    i = i + 1
  }
  ""
}

///| P2-2: had_errors() must still report errors of earlier chunks after the final (last=true) chunk.
fn redteam_p2_2_had_errors_after_last() -> String {
  let encs = [encoding::Encoding::Utf8, encoding::Encoding::Gb18030, encoding::Encoding::Windows1252]
  let bad = [unhex("ff"), unhex("ff"), unhex("81")]
  let mut i = 0
  while i < encs.length() {
    let d = encoding::Decoder::new(encs[i])
    let _ = d.decode_chunk(bad[i], false)
    if encs[i].name() != "windows-1252" && !d.had_errors() {
      return encs[i].name() + ": no error after the bad chunk"
    }
    let _ = d.decode_chunk(unhex("41"), true)
    if encs[i].name() != "windows-1252" && !d.had_errors() {
      return encs[i].name() + ": had_errors() is false after last=true although chunk 1 was replaced"
    }
    i = i + 1
  }
  ""
}

///| P2-3: DecodeError offsets must be >= 0 (a sequence that began in an earlier chunk gives -1 / -3 today).
fn redteam_p2_3_fatal_offsets() -> String {
  let cases : Array[(encoding::Encoding, String, String)] = [
    (encoding::Encoding::Gb18030, "8431a5", "30"),
    (encoding::Encoding::Utf16Le, "00", "dc"),
    (encoding::Encoding::Utf16Be, "d8", "00d8"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (enc, a, b) = cases[i]
    let d = encoding::Decoder::with_options(enc, encoding::DecodeOptions::new(true, false))
    let _ = d.decode_chunk(unhex(a), false)
    match d.decode_chunk(unhex(b), true) {
      Ok(_) => return enc.name() + " " + a + "|" + b + ": no error"
      Err(encoding::DecodeError::MalformedSequence(p)) =>
      if p < 0 {
        return enc.name() + " " + a + "|" + b + ": MalformedSequence(" + p.to_string() + ")"
      }
      Err(encoding::DecodeError::TruncatedSequence(p)) =>
      if p < 0 {
        return enc.name() + " " + a + "|" + b + ": TruncatedSequence(" + p.to_string() + ")"
      }
      Err(_) => ()
    }
    i = i + 1
  }
  ""
}

///| P2-4: a String that is not valid UTF-8 (Bytes::to_string does not validate) must be encoded into the
///| requested encoding with U+FFFD for each ill-formed subsequence, never passed through or sent as UTF-8.
fn redteam_p2_4_invalid_utf8_string() -> String {
  let s = unhex("41ffe4b8ad").to_string() // "A" <FF> "中"
  let (sj, unm) = encoding::encode_html(encoding::Encoding::ShiftJis, s)
  if hex_of_bytes(sj) != "41262336353533333b9286" || !unm {
    return "encode_html(Shift_JIS): got " + hex_of_bytes(sj) + ", want 41 &#65533; 92 86"
  }
  match encoding::encode(encoding::Encoding::Utf8, s) {
    Ok(b) => if hex_of_bytes(b) != "41efbfbde4b8ad" { return "encode(UTF-8) passes ill-formed bytes through: " + hex_of_bytes(b) }
    Err(_) => ()
  }
  match encoding::encode(encoding::Encoding::Utf16Le, s) {
    Ok(b) => if hex_of_bytes(b) != "4100fdff2d4e" { return "encode(UTF-16LE): " + hex_of_bytes(b) }
    Err(_) => ()
  }
  ""
}

///|
pub fn rt_all_cases() -> Array[String] {
  [
    "control_decode_pins", "control_encode_pins", "control_replacement", "control_label_whitespace", "control_bom_stream",
    "control_bom_sniffing", "redteam_p2_1_iso2022jp_roman_ncr", "redteam_p2_2_had_errors_after_last",
    "redteam_p2_3_fatal_offsets", "redteam_p2_4_invalid_utf8_string",
  ]
}

///|
pub fn rt_run_case(name : String) -> String {
  match name {
    "control_decode_pins" => control_decode_pins()
    "control_encode_pins" => control_encode_pins()
    "control_replacement" => control_replacement()
    "control_label_whitespace" => control_label_whitespace()
    "control_bom_stream" => control_bom_stream()
    "control_bom_sniffing" => control_bom_sniffing()
    "redteam_p2_1_iso2022jp_roman_ncr" => redteam_p2_1_iso2022jp_roman_ncr()
    "redteam_p2_2_had_errors_after_last" => redteam_p2_2_had_errors_after_last()
    "redteam_p2_3_fatal_offsets" => redteam_p2_3_fatal_offsets()
    "redteam_p2_4_invalid_utf8_string" => redteam_p2_4_invalid_utf8_string()
    _ => "unknown case " + name
  }
}
