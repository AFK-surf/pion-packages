///| Red-team cases for `packages/encoding`. Every case returns "" on PASS or a failure reason.
///| `redteam_*` cases assert what a correct implementation must do and FAIL while the finding of the same
///| id (REPORT.md) is open. `control_*` cases pin attacks and edge cases the package already handles; their
///| expected bytes are encoding_rs 0.8.44 outputs (diff/oracle) frozen here.
///| The same functions run under `pionc test` (cases_test.pion) and, one process per case, under
///| `encoding_audit case <name>` in native debug/release and wasm32 debug/release (run_audit.sh).

import "encoding"

///|
fn hex_of_str(s : String) -> String {
  let sb = StringBuilder::new()
  write_hex_str(sb, s)
  sb.to_string()
}

///|
fn hex_of_bytes(b : Bytes) -> String {
  let sb = StringBuilder::new()
  write_hex_bytes(sb, b)
  sb.to_string()
}

///| Decode `data` in chunks of `k` bytes (0 = whole); `empty` inserts an empty non-last chunk before each.
fn dec_chunked(enc : encoding::Encoding, data : Bytes, k : Int, empty : Bool, fatal : Bool) -> (String, Bool, Bool) {
  let dec = encoding::Decoder::with_options(enc, encoding::DecodeOptions::new(fatal, false))
  let chunks : Array[Bytes] = []
  if k == 0 {
    chunks.push(data)
  } else {
    let mut i = 0
    while i < data.length() {
      let e = if i + k < data.length() { i + k } else { data.length() }
      chunks.push(data.slice(i, e))
      i = e
    }
  }
  feed(dec, chunks, empty, k != 0)
}

