///| Wasm32 + Native 4-mode smoke entry for `packages/encoding`.

import "encoding"

fn mk_bytes(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

fn fnv1a64_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = h ^ (s.code_unit_at(i) & 0xFF).to_int64().to_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

fn decode_1byte_stream(enc : encoding::Encoding, data : Bytes) -> (String, Bool) {
  let dec = encoding::Decoder::new(enc)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < data.length() {
    match dec.decode_chunk(data.slice(i, i + 1), false) {
      Ok(s) => sb.write_string(s)
      Err(_) => ()
    }
    i = i + 1
  }
  match dec.decode_chunk(Bytes::new(0), true) {
    Ok(s) => sb.write_string(s)
    Err(_) => ()
  }
  (sb.to_string(), dec.had_errors())
}

fn smoke() -> (Int, UInt64) {
  let mut acc : UInt64 = 0UL
  let mut checks = 0

  // 1. Label resolution & BOM sniffing
  match encoding::Encoding::for_label("  UTF-8\n") {
    Some(e) => if e.name() != "UTF-8" { return (-1, 0UL) }
    None => return (-2, 0UL)
  }
  checks = checks + 1
  match encoding::sniff_bom(mk_bytes([0xEF, 0xBB, 0xBF, 0x41])) {
    Some((e, n)) => if e.name() != "UTF-8" || n != 3 { return (-3, 0UL) }
    None => return (-4, 0UL)
  }
  checks = checks + 1

  // 2. UTF-8 & UTF-16LE genuine 1-byte streaming decode (including had_errors persistence)
  let u8_in = mk_bytes([0xEF, 0xBB, 0xBF, 0x48, 0x69, 0xE4, 0xB8, 0xAD, 0xF0, 0x9F, 0x98, 0x80, 0xE4, 0xB8, 0x41])
  let (s_u8, err_u8) = decode_1byte_stream(encoding::Encoding::Utf8, u8_in)
  if s_u8 != "Hi中😀\u{FFFD}A" || !err_u8 {
    return (-5, 0UL)
  }
  acc = acc ^ fnv1a64_str(s_u8)
  checks = checks + 1

  let u16_in = mk_bytes([0xFF, 0xFE, 0x41, 0x00, 0x3D, 0xD8, 0x00, 0xDE])
  let (s_u16, err_u16) = decode_1byte_stream(encoding::Encoding::Utf16Le, u16_in)
  if s_u16 != "A😀" || err_u16 {
    return (-6, 0UL)
  }
  acc = acc ^ fnv1a64_str(s_u16)
  checks = checks + 1

  // 3. Single-byte windows-1252
  let s_w1252 = encoding::decode(encoding::Encoding::Windows1252, mk_bytes([0x80, 0xE9, 0xFF]))
  if s_w1252 != "€éÿ" {
    return (-7, 0UL)
  }
  acc = acc ^ fnv1a64_str(s_w1252)
  checks = checks + 1

  // 4. CJK: GB18030 (2-byte + 4-byte astral + 7457), Shift_JIS, Big5 (double-cp), EUC-KR, ISO-2022-JP
  let s_gb = encoding::decode(
    encoding::Encoding::Gb18030,
    mk_bytes([0xD6, 0xD0, 0x80, 0x94, 0x39, 0xFC, 0x36, 0x81, 0x35, 0xF4, 0x37]),
  )
  if s_gb != "中€😀\u{E7C7}" {
    return (-8, 0UL)
  }
  acc = acc ^ fnv1a64_str(s_gb)
  checks = checks + 1

  let s_sjis = encoding::decode(encoding::Encoding::ShiftJis, mk_bytes([0x82, 0xA0, 0xB1]))
  if s_sjis != "あｱ" {
    return (-9, 0UL)
  }
  acc = acc ^ fnv1a64_str(s_sjis)
  checks = checks + 1

  let s_big5 = encoding::decode(encoding::Encoding::Big5, mk_bytes([0xA4, 0xA4, 0x88, 0x62]))
  if s_big5 != "中\u{00CA}\u{0304}" {
    return (-10, 0UL)
  }
  acc = acc ^ fnv1a64_str(s_big5)
  checks = checks + 1

  let s_kr = encoding::decode(encoding::Encoding::EucKr, mk_bytes([0xC7, 0xD1, 0xB1, 0xDB]))
  if s_kr != "한글" {
    return (-11, 0UL)
  }
  acc = acc ^ fnv1a64_str(s_kr)
  checks = checks + 1

  let s_iso = encoding::decode(encoding::Encoding::Iso2022Jp, mk_bytes([0x1B, 0x24, 0x42, 0x24, 0x22, 0x1B, 0x28, 0x42, 0x41]))
  if s_iso != "あA" {
    return (-12, 0UL)
  }
  acc = acc ^ fnv1a64_str(s_iso)
  checks = checks + 1

  // 5. Encode round-trip + HTML NCR fallback (gb18030, Big5, ISO-2022-JP, windows-1252)
  match encoding::encode(encoding::Encoding::Gb18030, "中😀") {
    Ok(b) => {
      if b.length() != 6 {
        return (-13, 0UL)
      }
      acc = acc ^ fnv1a64_str(encoding::decode(encoding::Encoding::Gb18030, b))
    }
    Err(_) => return (-14, 0UL)
  }
  checks = checks + 1

  let (b5_b, b5_unm) = encoding::encode_html(encoding::Encoding::Big5, "中文é")
  if !b5_unm || encoding::decode(encoding::Encoding::Big5, b5_b) != "中文&#233;" {
    return (-15, 0UL)
  }
  acc = acc ^ fnv1a64_str(b5_b.to_string())
  checks = checks + 1

  let (html_b, unmap) = encoding::encode_html(encoding::Encoding::Windows1252, "A中B")
  if !unmap || html_b.to_string() != "A&#20013;B" {
    return (-16, 0UL)
  }
  acc = acc ^ fnv1a64_str(html_b.to_string())
  checks = checks + 1

  (checks, acc)
}

pub fn main(world : World) -> Int {
  let (checks, hash) = smoke()
  if checks > 0 {
    io_println(
      world,
      "encoding_wasm_smoke: OK checks=" + checks.to_string() + " fnv64=" + hash.to_string(),
    )
    0
  } else {
    io_println(world, "encoding_wasm_smoke: FAIL code=" + checks.to_string())
    1
  }
}
