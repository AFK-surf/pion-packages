///| Pion Native head-to-head benchmark for `packages/encoding`.
///| Usage: pion_encoding_bench <mode: utf8|gb18030|sjis> <input_file> <iters>

import "encoding"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn fnv1a64_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = h ^ (s.code_unit_at(i) & 0xFF).to_int64().to_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_encoding_bench <utf8|gb18030|sjis> <input_file> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_int(args[3])
  let enc = match mode {
    "utf8" => encoding::Encoding::Utf8
    "gb18030" => encoding::Encoding::Gb18030
    "sjis" => encoding::Encoding::ShiftJis
    _ => {
      io_println(world, "unknown mode: " + mode)
      return 1
    }
  }
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }

  let mut total_bytes : Int64 = 0L
  let mut last_out = ""
  let mut it = 0
  while it < iters {
    let s = encoding::decode(enc, raw)
    total_bytes = total_bytes + s.length().to_int64()
    last_out = s
    it = it + 1
  }

  let h = fnv1a64_str(last_out)
  io_println(
    world,
    "MODE=" + mode + " ITERS=" + iters.to_string() + " OUT_BYTES=" + total_bytes.to_string() + " FNV64=" + h.to_string(),
  )
  0
}
