let iso2022_jp_half_width_trail : FixedArray[Int] = [
  35, 86, 87, 34, 38, 114, 33, 35, 37, 39, 41, 99, 101, 103, 67, 60, 34, 36, 38, 40, 42, 43, 45, 47, 49, 51, 53, 55, 57, 59, 61, 63, 65, 68, 70, 72, 74, 75, 76, 77, 78, 79, 82, 85, 88, 91, 94, 95, 96, 97, 98, 100, 102, 104, 105, 106, 107, 108, 109, 111, 115, 43, 44,
]

fn sb_table_index(enc : Encoding) -> Int {
  match enc {
    Encoding::Ibm866 => 0
    Encoding::Iso8859_2 => 1
    Encoding::Iso8859_3 => 2
    Encoding::Iso8859_4 => 3
    Encoding::Iso8859_5 => 4
    Encoding::Iso8859_6 => 5
    Encoding::Iso8859_7 => 6
    Encoding::Iso8859_8 => 7
    Encoding::Iso8859_8I => 7
    Encoding::Iso8859_10 => 8
    Encoding::Iso8859_13 => 9
    Encoding::Iso8859_14 => 10
    Encoding::Iso8859_15 => 11
    Encoding::Iso8859_16 => 12
    Encoding::Koi8R => 13
    Encoding::Koi8U => 14
    Encoding::Macintosh => 15
    Encoding::Windows874 => 16
    Encoding::Windows1250 => 17
    Encoding::Windows1251 => 18
    Encoding::Windows1252 => 19
    Encoding::Windows1253 => 20
    Encoding::Windows1254 => 21
    Encoding::Windows1255 => 22
    Encoding::Windows1256 => 23
    Encoding::Windows1257 => 24
    Encoding::Windows1258 => 25
    Encoding::XMacCyrillic => 26
    _ => -1
  }
}

fn sb_decode_upper(tbl_idx : Int, b : Int) -> Int {
  u16_at(single_byte_tbl, (tbl_idx << 7) + (b - 128))
}

fn sb_encode_cp(tbl_idx : Int, cp : Int) -> Int {
  if cp < 0x80 {
    return cp
  }
  if cp > 0xFFFF {
    return -1
  }
  let base = tbl_idx << 7
  let pos = tbl_position(single_byte_tbl, base, base + 128, cp)
  if pos < 0 {
    -1
  } else {
    pos + 128
  }
}

fn big5_is_astral(rebased_pointer : Int) -> Bool {
  (u16_at(big5_astralness_tbl, rebased_pointer >> 4) & (1 << (rebased_pointer & 15))) != 0
}

fn big5_low_bits(rebased_pointer : Int) -> Int {
  if rebased_pointer >= 0 && rebased_pointer < 18840 {
    u16_at(big5_low_bits_tbl, rebased_pointer)
  } else {
    0
  }
}

fn jis0208_symbol_decode(pointer : Int) -> Int {
  let mut i = 0
  while i < 33 {
    let start = u16_at(jis0208_symbol_triples_tbl, i)
    let length = u16_at(jis0208_symbol_triples_tbl, i + 1)
    if pointer >= start && pointer - start < length {
      let offset = u16_at(jis0208_symbol_triples_tbl, i + 2)
      return u16_at(jis0208_symbols_tbl, pointer - start + offset)
    }
    i = i + 3
  }
  0
}

fn jis0208_symbol_encode(bmp : Int) -> Int {
  let mut i = 0
  while i < 33 {
    let pointer_start = u16_at(jis0208_symbol_triples_tbl, i)
    let length = u16_at(jis0208_symbol_triples_tbl, i + 1)
    let symbol_start = u16_at(jis0208_symbol_triples_tbl, i + 2)
    let pos = tbl_position(jis0208_symbols_tbl, symbol_start, symbol_start + length, bmp)
    if pos >= 0 {
      return pos + pointer_start
    }
    i = i + 3
  }
  -1
}

fn ibm_symbol_encode(bmp : Int) -> Int {
  let pos = tbl_position(jis0208_symbols_tbl, 233, 236, bmp)
  if pos >= 0 {
    pos + 8645
  } else {
    -1
  }
}

fn jis0208_range_decode(pointer : Int) -> Int {
  let mut i = 0
  while i < 54 {
    let start = u16_at(jis0208_range_triples_tbl, i)
    let length = u16_at(jis0208_range_triples_tbl, i + 1)
    if pointer >= start && pointer - start < length {
      let offset = u16_at(jis0208_range_triples_tbl, i + 2)
      return pointer - start + offset
    }
    i = i + 3
  }
  0
}

fn jis0208_range_encode(bmp : Int) -> Int {
  let mut i = 0
  while i < 54 {
    let start = u16_at(jis0208_range_triples_tbl, i + 2)
    let length = u16_at(jis0208_range_triples_tbl, i + 1)
    if bmp >= start && bmp - start < length {
      let offset = u16_at(jis0208_range_triples_tbl, i)
      return bmp - start + offset
    }
    i = i + 3
  }
  -1
}

fn jis0212_accented_decode(pointer : Int) -> Int {
  let mut i = 0
  while i < 33 {
    let start = u16_at(jis0212_accented_triples_tbl, i)
    let length = u16_at(jis0212_accented_triples_tbl, i + 1)
    if pointer >= start && pointer - start < length {
      let offset = u16_at(jis0212_accented_triples_tbl, i + 2)
      return u16_at(jis0212_accented_tbl, pointer - start + offset)
    }
    i = i + 3
  }
  0
}

fn gb18030_range_decode(pointer : Int) -> Int {
  map_with_ranges(gb18030_range_ptrs_tbl, 206, gb18030_range_offs_tbl, pointer)
}

fn gb18030_range_encode(bmp : Int) -> Int {
  if bmp == 0xE7C7 {
    return 7457
  }
  map_with_ranges(gb18030_range_offs_tbl, 206, gb18030_range_ptrs_tbl, bmp)
}

