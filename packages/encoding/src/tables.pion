///| Compact immutable read-only WHATWG Encoding Standard mapping tables.
///| Generated from WHATWG Encoding Standard indices (aligned with Mozilla encoding_rs 0.8.44).
///| Each `u16` entry is stored as 3 printable ASCII bytes (4+6+6 bit packing) for O(1) lookup,
///| zero startup allocation, zero mutable module globals, and minimal Wasm32 footprint.

fn d6(c : Int) -> Int {
  if c >= 97 {
    c - 41
  } else {
    c - 35
  }
}

fn u16_at(tbl : String, idx : Int) -> Int {
  let o = idx * 3
  ((tbl.code_unit_at(o) - 48) << 12) | (d6(tbl.code_unit_at(o + 1)) << 6) | d6(tbl.code_unit_at(o + 2))
}

fn tbl_len(tbl : String) -> Int {
  tbl.length() / 3
}

fn tbl_position(tbl : String, start : Int, end : Int, needle : Int) -> Int {
  let mut i = start
  while i < end {
    let o = i * 3
    let c1 = tbl.code_unit_at(o + 1)
    let c2 = tbl.code_unit_at(o + 2)
    let v = ((tbl.code_unit_at(o) - 48) << 12) | ((if c1 >= 97 { c1 - 41 } else { c1 - 35 }) << 6) | (if c2 >= 97 { c2 - 41 } else { c2 - 35 })
    if v == needle {
      return i - start
    }
    i = i + 1
  }
  -1
}

fn tbl_bsearch_key_range(keys : String, lo0 : Int, hi0 : Int, needle : Int) -> Int {
  let mut lo = lo0
  let mut hi = hi0
  while lo < hi {
    let mid = lo + ((hi - lo) >> 1)
    let o = mid * 3
    let c1 = keys.code_unit_at(o + 1)
    let c2 = keys.code_unit_at(o + 2)
    let v = ((keys.code_unit_at(o) - 48) << 12) | ((if c1 >= 97 { c1 - 41 } else { c1 - 35 }) << 6) | (if c2 >= 97 { c2 - 41 } else { c2 - 35 })
    if v == needle {
      return mid
    } else if v < needle {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  -1
}

fn tbl_bsearch_u16_range(keys : String, vals : String, lo0 : Int, hi0 : Int, needle : Int) -> Int {
  let mut lo = lo0
  let mut hi = hi0
  while lo < hi {
    let mid = lo + ((hi - lo) >> 1)
    let o = mid * 3
    let c1 = keys.code_unit_at(o + 1)
    let c2 = keys.code_unit_at(o + 2)
    let v = ((keys.code_unit_at(o) - 48) << 12) | ((if c1 >= 97 { c1 - 41 } else { c1 - 35 }) << 6) | (if c2 >= 97 { c2 - 41 } else { c2 - 35 })
    if v == needle {
      let v1 = vals.code_unit_at(o + 1)
      let v2 = vals.code_unit_at(o + 2)
      return ((vals.code_unit_at(o) - 48) << 12) | ((if v1 >= 97 { v1 - 41 } else { v1 - 35 }) << 6) | (if v2 >= 97 { v2 - 41 } else { v2 - 35 })
    } else if v < needle {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  -1
}

fn tbl_bsearch_u16(keys : String, vals : String, count : Int, needle : Int) -> Int {
  tbl_bsearch_u16_range(keys, vals, 0, count, needle)
}

fn map_with_ranges(haystack : String, hay_len : Int, other : String, needle : Int) -> Int {
  let mut lo = 0
  let mut hi = hay_len
  while lo < hi {
    let mid = lo + ((hi - lo) >> 1)
    let o = mid * 3
    let c1 = haystack.code_unit_at(o + 1)
    let c2 = haystack.code_unit_at(o + 2)
    let v = ((haystack.code_unit_at(o) - 48) << 12) | ((if c1 >= 97 { c1 - 41 } else { c1 - 35 }) << 6) | (if c2 >= 97 { c2 - 41 } else { c2 - 35 })
    if v == needle {
      return u16_at(other, mid)
    } else if v < needle {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  let idx = lo - 1
  u16_at(other, idx) + (needle - u16_at(haystack, idx))
}

fn map_with_unsorted_ranges(haystack : String, other : String, needle : Int) -> Int {
  let n = tbl_len(haystack)
  let mut i = 0
  while i < n {
    let start = u16_at(other, i)
    let end = u16_at(other, i + 1)
    let length = end - start
    let h = u16_at(haystack, i)
    if needle >= h && needle - h < length {
      return start + (needle - h)
    }
    i = i + 1
  }
  -1
}

