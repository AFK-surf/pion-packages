///| WHATWG CJK multi-byte streaming decoders & encoders:
///| GBK, gb18030 (including GB18030-2022), Shift_JIS, EUC-JP, Big5, EUC-KR, ISO-2022-JP.

// ============================================================================
// GBK & gb18030
// ============================================================================

struct Gb18030State {
  mut first : Int // -1 or 0..(0xFE-0x81)
  mut second : Int // -1 or 0..9 (represents 0x30..0x39)
  mut third : Int // -1 or 0..(0xFE-0x81)
}

fn Gb18030State::new() -> Gb18030State {
  Gb18030State::{ first: -1, second: -1, third: -1 }
}

fn Gb18030State::reset(self : Gb18030State) -> Unit {
  self.first = -1
  self.second = -1
  self.third = -1
}

fn gb18030_decode_chunk(
  st : Gb18030State,
  data : Bytes,
  base_off : Int,
  last : Bool,
  fatal : Bool,
  had_err_out : FixedArray[Int],
) -> Result[String, DecodeError] {
  let n = data.length()
  if n == 0 && !last {
    return Ok("")
  }
  if st.first < 0 && n > 0 {
    let first_non_ascii = scan_ascii_end(data, 0, n)
    if first_non_ascii == n {
      return Ok(data.to_string())
    }
  }
  let out = ByteBuf::with_capacity(n + (n >> 1) + 16)
  let mut i = 0
  while i < n {
    if st.first < 0 {
      // Fast single-pass ASCII + 2-byte GB2312/GBK loop when in neutral state
      let mut ob = out.data
      let mut op = out.len
      let mut cap = ob.length()
      while i < n {
        let b = data[i].to_int() & 0xFF
        if b < 0x80 {
          if op >= cap {
            out.len = op
            out.grow(n - i + 16)
            ob = out.data
            cap = ob.length()
          }
          ob[op] = b.to_byte()
          op = op + 1
          i = i + 1
          continue
        }
        if b >= 0xB0 && b <= 0xF7 && i + 1 < n {
          let b2 = data[i + 1].to_int() & 0xFF
          if b2 >= 0xA1 && b2 <= 0xFE {
            if op + 3 > cap {
              out.len = op
              out.grow((n - i) * 2 + 16)
              ob = out.data
              cap = ob.length()
            }
            let hp = (b - 0xB0) * 94 + (b2 - 0xA1)
            let cp = u16_at(gb2312_hanzi_tbl, hp)
            ob[op] = (0xE0 | (cp >> 12)).to_byte()
            ob[op + 1] = (0x80 | ((cp >> 6) & 0x3F)).to_byte()
            ob[op + 2] = (0x80 | (cp & 0x3F)).to_byte()
            op = op + 3
            i = i + 2
            continue
          }
        }
        if b == 0xA1 && i + 1 < n {
          let b2 = data[i + 1].to_int() & 0xFF
          if b2 >= 0xA1 && b2 <= 0xFE {
            if op + 3 > cap {
              out.len = op
              out.grow((n - i) * 2 + 16)
              ob = out.data
              cap = ob.length()
            }
            let cp = u16_at(gb2312_symbols_tbl, b2 - 0xA1)
            if cp < 0x800 {
              ob[op] = (0xC0 | (cp >> 6)).to_byte()
              ob[op + 1] = (0x80 | (cp & 0x3F)).to_byte()
              op = op + 2
            } else {
              ob[op] = (0xE0 | (cp >> 12)).to_byte()
              ob[op + 1] = (0x80 | ((cp >> 6) & 0x3F)).to_byte()
              ob[op + 2] = (0x80 | (cp & 0x3F)).to_byte()
              op = op + 3
            }
            i = i + 2
            continue
          }
        }
        break
      }
      out.len = op
      if i >= n {
        break
      }
      let b = data[i].to_int() & 0xFF
      if b == 0x80 {
        out.push_upper_bmp(0x20AC)
        i = i + 1
        continue
      }
      if b >= 0x81 && b <= 0xFE {
        st.first = b - 0x81
        i = i + 1
        continue
      }
      // 0xFF
      if fatal {
        return Err(DecodeError::MalformedSequence(base_off + i))
      }
      had_err_out[0] = 1
      out.push_replacement()
      i = i + 1
    } else if st.second < 0 {
      let b = data[i].to_int() & 0xFF
      if b >= 0x30 && b <= 0x39 {
        st.second = b - 0x30
        i = i + 1
        continue
      }
      let first_mo = st.first
      st.first = -1
      if first_mo >= 0x20 {
        if b >= 0xA1 && b <= 0xFE {
          let trail_mo = b - 0xA1
          let hanzi_lead = first_mo - 0x2F
          if hanzi_lead >= 0 && hanzi_lead < (0x77 - 0x2F) {
            let hp = hanzi_lead * 94 + trail_mo
            out.push_upper_bmp(u16_at(gb2312_hanzi_tbl, hp))
          } else if first_mo == 0x20 {
            out.push_bmp(u16_at(gb2312_symbols_tbl, trail_mo))
          } else if first_mo == 0x25 && trail_mo >= 63 && trail_mo - 63 < 22 {
            out.push_bmp(u16_at(gb2312_symbols_after_greek_tbl, trail_mo - 63))
          } else if first_mo == 0x27 && trail_mo < 32 {
            out.push_bmp(u16_at(gb2312_pinyin_tbl, trail_mo))
          } else if first_mo > 0x76 {
            out.push_upper_bmp(0xE234 + (first_mo - 0x77) * 94 + trail_mo)
          } else {
            out.push_bmp(gb2312_other_decode((first_mo - 0x21) * 94 + trail_mo))
          }
          i = i + 1
          continue
        }
        // GBK left range: 0x40..0x7E or 0x80..0xA0
        let trail_mo = if b >= 0x40 && b <= 0x7E {
          b - 0x40
        } else if b >= 0x80 && b <= 0xA0 {
          b - 0x41
        } else {
          -1
        }
        if trail_mo < 0 {
          if fatal {
            return Err(DecodeError::MalformedSequence(base_off + i - 1))
          }
          had_err_out[0] = 1
          out.push_replacement()
          if b >= 0x80 {
            i = i + 1
          }
          continue
        }
        let left_lead = first_mo - 0x20
        let left_ptr = left_lead * 96 + trail_mo
        let gbk_left_ideo_ptr = left_ptr - 9 * 96
        if gbk_left_ideo_ptr >= 0 && gbk_left_ideo_ptr < ((0x7D - 0x29) * 96 - 5) {
          out.push_upper_bmp(gbk_left_ideograph_decode(gbk_left_ideo_ptr))
        } else if left_ptr < 9 * 96 {
          out.push_bmp(gbk_other_decode(left_ptr))
        } else {
          let bottom_ptr = left_ptr - ((0x7D - 0x20) * 96 - 5)
          out.push_upper_bmp(u16_at(gbk_bottom_tbl, bottom_ptr))
        }
        i = i + 1
      } else {
        // GBK top ideograph range: 0x40..0x7E or 0x80..0xFE
        let trail_mo = if b >= 0x40 && b <= 0x7E {
          b - 0x40
        } else if b >= 0x80 && b <= 0xFE {
          b - 0x41
        } else {
          -1
        }
        if trail_mo < 0 {
          if fatal {
            return Err(DecodeError::MalformedSequence(base_off + i - 1))
          }
          had_err_out[0] = 1
          out.push_replacement()
          if b >= 0x80 {
            i = i + 1
          }
          continue
        }
        let ptr = first_mo * 190 + trail_mo
        out.push_upper_bmp(gbk_top_ideograph_decode(ptr))
        i = i + 1
      }
    } else if st.third < 0 {
      let b = data[i].to_int() & 0xFF
      if b >= 0x81 && b <= 0xFE {
        st.third = b - 0x81
        i = i + 1
        continue
      }
      // Malformed 3rd byte: error for first, emit ASCII second, reprocess b
      let sec_byte = st.second + 0x30
      st.first = -1
      st.second = -1
      if fatal {
        return Err(DecodeError::MalformedSequence(base_off + i - 2))
      }
      had_err_out[0] = 1
      out.push_replacement()
      out.push_u8(sec_byte)
    } else {
      let b = data[i].to_int() & 0xFF
      if b < 0x30 || b > 0x39 {
        // Malformed 4th byte: error for first, emit ASCII second, third becomes new first, reprocess b
        let sec_byte = st.second + 0x30
        let next_first = st.third
        st.first = next_first
        st.second = -1
        st.third = -1
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 3))
        }
        had_err_out[0] = 1
        out.push_replacement()
        out.push_u8(sec_byte)
        continue
      }
      let ptr = st.first * 12600 + st.second * 1260 + st.third * 10 + (b - 0x30)
      st.first = -1
      st.second = -1
      st.third = -1
      i = i + 1
      if ptr <= 39419 {
        if ptr == 7457 {
          out.push_upper_bmp(0xE7C7)
        } else {
          out.push_bmp(gb18030_range_decode(ptr))
        }
      } else if ptr >= 189000 && ptr <= 1237575 {
        out.push_astral(ptr - (189000 - 0x10000))
      } else {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 4))
        }
        had_err_out[0] = 1
        out.push_replacement()
      }
    }
  }

  if last && st.first >= 0 {
    let pending = if st.third >= 0 { 3 } else if st.second >= 0 { 2 } else { 1 }
    st.first = -1
    st.second = -1
    st.third = -1
    if fatal {
      return Err(DecodeError::TruncatedSequence(base_off + n - pending))
    }
    had_err_out[0] = 1
    out.push_replacement()
  }
  Ok(out.to_string())
}

// GB18030-2022 PUA overrides for encoder (pure match, zero mutable globals)
fn gb18030_2022_pua_encode(bmp : Int) -> (Int, Int) {
  match bmp {
    0xE78D => (0xA6, 0xD9)
    0xE78E => (0xA6, 0xDA)
    0xE78F => (0xA6, 0xDB)
    0xE790 => (0xA6, 0xDC)
    0xE791 => (0xA6, 0xDD)
    0xE792 => (0xA6, 0xDE)
    0xE793 => (0xA6, 0xDF)
    0xE794 => (0xA6, 0xEC)
    0xE795 => (0xA6, 0xED)
    0xE796 => (0xA6, 0xF3)
    0xE81E => (0xFE, 0x59)
    0xE826 => (0xFE, 0x61)
    0xE82B => (0xFE, 0x66)
    0xE82C => (0xFE, 0x67)
    0xE832 => (0xFE, 0x6D)
    0xE843 => (0xFE, 0x7E)
    0xE854 => (0xFE, 0x90)
    0xE864 => (0xFE, 0xA0)
    _ => (-1, -1)
  }
}

fn gbk_encode_non_unified(bmp : Int) -> (Int, Int) {
  if (bmp >= 0x2014 && bmp <= 0x3017) || (bmp >= 0xFF04 && bmp <= 0xFFE1) {
    let pos = tbl_position(gb2312_symbols_tbl, 0, 94, bmp)
    if pos >= 0 {
      return (0xA1, pos + 0xA1)
    }
  }
  if bmp >= 0x3400 && bmp < 0x4E00 {
    let pos = tbl_position(gbk_bottom_tbl, 21, 100, bmp)
    if pos >= 0 {
      let off = if pos < (0x3F - 16) { 0x40 + 16 } else { 0x41 + 16 }
      return (0xFE, pos + off)
    }
    return (-1, -1)
  }
  if bmp >= 0xF900 && bmp < 0xFB00 {
    let pos = tbl_position(gbk_bottom_tbl, 0, 21, bmp)
    if pos >= 0 {
      if pos < 5 {
        return (0xFD, pos + (190 - 94 - 5 + 0x41))
      }
      return (0xFE, pos + (0x40 - 5))
    }
    return (-1, -1)
  }
  if bmp < 0x02CA {
    if bmp >= 0x00E0 && bmp < 0x0262 && bmp != 0x00F7 {
      let pos = tbl_position(gb2312_pinyin_tbl, 0, 32, bmp)
      if pos >= 0 {
        return (0xA8, pos + 0xA1)
      }
    } else if (bmp >= 0x00A4 && bmp <= 0x00F7) || (bmp >= 0x02C7 && bmp <= 0x02C9) {
      let pos = tbl_position(gb2312_symbols_tbl, 3, 0xAC - 0x60, bmp)
      if pos >= 0 {
        return (0xA1, pos + 0xA1 + 3)
      }
    }
    return (-1, -1)
  }
  if bmp >= 0xE78D && bmp <= 0xE864 {
    let (pb0, pb1) = gb18030_2022_pua_encode(bmp)
    if pb0 >= 0 {
      return (pb0, pb1)
    }
  } else if bmp >= 0xFE17 {
    let pos = tbl_position(gb2312_symbols_after_greek_tbl, 0, 22, bmp)
    if pos >= 0 {
      return (0xA6, pos + (0x9F - 0x60 + 0xA1))
    }
  } else if bmp == 0x1E3F {
    return (0xA8, 0x7B - 0x60 + 0xA1)
  } else if bmp >= 0xA000 && bmp < 0xD800 {
    return (-1, -1)
  }
  let other_ptr = gb2312_other_encode(bmp)
  if other_ptr >= 0 {
    return (0xA2 + other_ptr / 94, 0xA1 + other_ptr % 94)
  }
  if bmp >= 0x02DA && bmp < 0x2010 {
    return (-1, -1)
  }
  let gbk_op = gbk_other_encode(bmp)
  if gbk_op >= 0 {
    let lead = gbk_op / 96
    let trail = gbk_op % 96
    let off = if trail < 0x3F { 0x40 } else { 0x41 }
    return (lead + 0xA1, trail + off)
  }
  if (bmp >= 0x2E81 && bmp <= 0x2ECA) || (bmp >= 0x9FB4 && bmp <= 0x9FBB) || (bmp >= 0xE816 && bmp <= 0xE855) {
    let pos = tbl_position(gbk_bottom_tbl, 21, 101, bmp)
    if pos >= 0 {
      let trail = pos + 16
      let off = if trail < 0x3F { 0x40 } else { 0x41 }
      return (0xFE, trail + off)
    }
  }
  if bmp >= 0xE234 && bmp <= 0xE4C5 {
    let d = bmp - 0xE234
    return (0xF8 + d / 94, 0xA1 + d % 94)
  }
  if bmp >= 0xE810 && bmp < 0xE815 {
    return (0xD7, 0xFA + (bmp - 0xE810))
  }
  (-1, -1)
}

fn gb18030_encode_hanzi(bmp : Int) -> (Int, Int) {
  let packed = gb2312_hanzi_encode(bmp)
  if packed >= 0 {
    return (packed >> 8, packed & 0xFF)
  }
  if bmp < 0x72DC {
    let ptr = gbk_top_ideograph_encode(bmp)
    let lead = ptr / 190 + 0x81
    let trail = ptr % 190
    let off = if trail < 0x3F { 0x40 } else { 0x41 }
    (lead, trail + off)
  } else {
    let ptr = gbk_left_ideograph_encode(bmp)
    let lead = ptr / 96 + (0x81 + 0x29)
    let trail = ptr % 96
    let off = if trail < 0x3F { 0x40 } else { 0x41 }
    (lead, trail + off)
  }
}

fn gb18030_push_4byte(out : ByteBuf, rp : Int) -> Unit {
  let first = rp / 12600
  let rem1 = rp % 12600
  let second = rem1 / 1260
  let rem2 = rem1 % 1260
  let third = rem2 / 10
  let fourth = rem2 % 10
  out.push_u8_4(first + 0x81, second + 0x30, third + 0x81, fourth + 0x30)
}

fn gb18030_encode(
  s : String,
  extended : Bool,
  html_fallback : Bool,
) -> Result[(Bytes, Bool), EncodeError] {
  let n = s.length()
  let out = ByteBuf::with_capacity(n)
  let mut had_unmappable = false
  let mut i = 0
  while i < n {
    let c0 = s.code_unit_at(i)
    if c0 < 0x80 {
      out.push_u8(c0)
      i = i + 1
      continue
    }
    let (cp, step) = utf8_str_next(s, i)
    if cp >= 0x10000 {
      if extended {
        gb18030_push_4byte(out, cp + (189000 - 0x10000))
      } else if html_fallback {
        had_unmappable = true
        out.push_html_ncr(cp)
      } else {
        return Err(EncodeError::UnmappableCodePoint(cp, i))
      }
      i = i + step
      continue
    }
    if cp >= 0x4E00 && cp <= 0x9FA5 {
      let (l, t) = gb18030_encode_hanzi(cp)
      out.push_u8_2(l, t)
    } else if cp == 0xE5E5 {
      if html_fallback {
        had_unmappable = true
        out.push_html_ncr(cp)
      } else {
        return Err(EncodeError::UnmappableCodePoint(cp, i))
      }
    } else if cp == 0x20AC && !extended {
      out.push_u8(0x80)
    } else {
      let (l, t) = gbk_encode_non_unified(cp)
      if l >= 0 {
        out.push_u8_2(l, t)
      } else if extended {
        gb18030_push_4byte(out, gb18030_range_encode(cp))
      } else if html_fallback {
        had_unmappable = true
        out.push_html_ncr(cp)
      } else {
        return Err(EncodeError::UnmappableCodePoint(cp, i))
      }
    }
    i = i + step
  }
  Ok((out.to_bytes(), had_unmappable))
}

// ============================================================================
// Shift_JIS
// ============================================================================

struct LeadState {
  mut lead : Int // -1 = none
}

fn LeadState::new() -> LeadState {
  LeadState::{ lead: -1 }
}

fn LeadState::reset(self : LeadState) -> Unit {
  self.lead = -1
}

fn shift_jis_decode_chunk(
  st : LeadState,
  data : Bytes,
  base_off : Int,
  last : Bool,
  fatal : Bool,
  had_err_out : FixedArray[Int],
) -> Result[String, DecodeError] {
  let n = data.length()
  if n == 0 && !last {
    return Ok("")
  }
  if st.lead < 0 && n > 0 {
    let first_non_ascii = scan_ascii_end(data, 0, n)
    if first_non_ascii == n {
      return Ok(data.to_string())
    }
  }
  let out = ByteBuf::with_capacity(n + (n >> 1) + 16)
  let mut i = 0
  while i < n {
    if st.lead < 0 {
      // Fast single-pass ASCII + Hiragana + Katakana + Level 1 Kanji + Half-width Katakana loop
      let mut ob = out.data
      let mut op = out.len
      let mut cap = ob.length()
      while i < n {
        let b = data[i].to_int() & 0xFF
        if b < 0x80 {
          if op >= cap {
            out.len = op
            out.grow(n - i + 16)
            ob = out.data
            cap = ob.length()
          }
          ob[op] = b.to_byte()
          op = op + 1
          i = i + 1
          continue
        }
        if b >= 0xA1 && b <= 0xDF {
          if op + 3 > cap {
            out.len = op
            out.grow((n - i) * 3 + 16)
            ob = out.data
            cap = ob.length()
          }
          let cp = 0xFF61 + (b - 0xA1)
          ob[op] = (0xE0 | (cp >> 12)).to_byte()
          ob[op + 1] = (0x80 | ((cp >> 6) & 0x3F)).to_byte()
          ob[op + 2] = (0x80 | (cp & 0x3F)).to_byte()
          op = op + 3
          i = i + 1
          continue
        }
        if b == 0x82 && i + 1 < n {
          let b2 = data[i + 1].to_int() & 0xFF
          if b2 >= 0x9F && b2 < 0xF2 {
            if op + 3 > cap {
              out.len = op
              out.grow((n - i) * 2 + 16)
              ob = out.data
              cap = ob.length()
            }
            let cp = 0x3041 + (b2 - 0x9F)
            ob[op] = (0xE0 | (cp >> 12)).to_byte()
            ob[op + 1] = (0x80 | ((cp >> 6) & 0x3F)).to_byte()
            ob[op + 2] = (0x80 | (cp & 0x3F)).to_byte()
            op = op + 3
            i = i + 2
            continue
          }
        }
        if b == 0x83 && i + 1 < n {
          let b2 = data[i + 1].to_int() & 0xFF
          let tm = if b2 >= 0x40 && b2 <= 0x7E {
            b2 - 0x40
          } else if b2 >= 0x80 && b2 <= 0x96 {
            b2 - 0x41
          } else {
            -1
          }
          if tm >= 0 && tm < 0x56 {
            if op + 3 > cap {
              out.len = op
              out.grow((n - i) * 2 + 16)
              ob = out.data
              cap = ob.length()
            }
            let cp = 0x30A1 + tm
            ob[op] = (0xE0 | (cp >> 12)).to_byte()
            ob[op + 1] = (0x80 | ((cp >> 6) & 0x3F)).to_byte()
            ob[op + 2] = (0x80 | (cp & 0x3F)).to_byte()
            op = op + 3
            i = i + 2
            continue
          }
        }
        if b >= 0x88 && b <= 0x98 && i + 1 < n {
          let b2 = data[i + 1].to_int() & 0xFF
          let tm = if b2 >= 0x40 && b2 <= 0x7E {
            b2 - 0x40
          } else if b2 >= 0x80 && b2 <= 0xFC {
            b2 - 0x41
          } else {
            -1
          }
          if tm >= 0 {
            let l1 = (b - 0x81) * 188 + tm - 1410
            if l1 >= 0 && l1 < 2965 {
              if op + 3 > cap {
                out.len = op
                out.grow((n - i) * 2 + 16)
                ob = out.data
                cap = ob.length()
              }
              let cp = u16_at(jis0208_level1_kanji_tbl, l1)
              ob[op] = (0xE0 | (cp >> 12)).to_byte()
              ob[op + 1] = (0x80 | ((cp >> 6) & 0x3F)).to_byte()
              ob[op + 2] = (0x80 | (cp & 0x3F)).to_byte()
              op = op + 3
              i = i + 2
              continue
            }
          }
        }
        break
      }
      out.len = op
      if i >= n {
        break
      }
      let b = data[i].to_int() & 0xFF
      if b >= 0x81 && b <= 0x9F {
        st.lead = b - 0x81
        i = i + 1
      } else if b >= 0xE0 && b <= 0xFC {
        st.lead = b - 0xC1
        i = i + 1
      } else if b == 0x80 {
        out.push_mid_bmp(0x80)
        i = i + 1
      } else {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i))
        }
        had_err_out[0] = 1
        out.push_replacement()
        i = i + 1
      }
    } else {
      let lead_mo = st.lead
      st.lead = -1
      let b = data[i].to_int() & 0xFF
      // Fast-track Hiragana
      if lead_mo == 0x01 && b >= 0x9F && b < 0x9F + 0x53 {
        out.push_upper_bmp(0x3041 + (b - 0x9F))
        i = i + 1
        continue
      }
      let trail_mo = if b >= 0x40 && b <= 0x7E {
        b - 0x40
      } else if b >= 0x80 && b <= 0xFC {
        b - 0x41
      } else {
        -1
      }
      if trail_mo < 0 {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 1))
        }
        had_err_out[0] = 1
        out.push_replacement()
        if b >= 0x80 {
          i = i + 1
        }
        continue
      }
      if lead_mo == 0x02 && trail_mo < 0x56 {
        out.push_upper_bmp(0x30A1 + trail_mo)
        i = i + 1
        continue
      }
      let ptr = lead_mo * 188 + trail_mo
      let l1 = ptr - 1410
      if l1 >= 0 && l1 < 2965 {
        out.push_upper_bmp(u16_at(jis0208_level1_kanji_tbl, l1))
        i = i + 1
        continue
      }
      let l2 = ptr - 4418
      if l2 >= 0 && l2 < 3390 {
        out.push_upper_bmp(u16_at(jis0208_level2_kanji_tbl, l2))
        i = i + 1
        continue
      }
      let uibm = ptr - 10744
      if uibm >= 0 && uibm < 360 {
        out.push_upper_bmp(u16_at(ibm_kanji_tbl, uibm))
        i = i + 1
        continue
      }
      let libm = ptr - 8272
      if libm >= 0 && libm < 360 {
        out.push_upper_bmp(u16_at(ibm_kanji_tbl, libm))
        i = i + 1
        continue
      }
      if ptr >= 8836 && ptr <= 10715 {
        out.push_upper_bmp(0xE000 - 8836 + ptr)
        i = i + 1
        continue
      }
      let sym = jis0208_symbol_decode(ptr)
      if sym != 0 {
        out.push_bmp(sym)
        i = i + 1
        continue
      }
      let rng = jis0208_range_decode(ptr)
      if rng != 0 {
        out.push_bmp(rng)
        i = i + 1
        continue
      }
      if fatal {
        return Err(DecodeError::MalformedSequence(base_off + i - 1))
      }
      had_err_out[0] = 1
      out.push_replacement()
      if b >= 0x80 {
        i = i + 1
      }
    }
  }
  if last && st.lead >= 0 {
    st.lead = -1
    if fatal {
      return Err(DecodeError::TruncatedSequence(base_off + n - 1))
    }
    had_err_out[0] = 1
    out.push_replacement()
  }
  Ok(out.to_string())
}

fn shift_jis_ptr_to_bytes(ptr : Int) -> (Int, Int) {
  let lead = ptr / 188
  let lead_off = if lead < 0x1F { 0x81 } else { 0xC1 }
  let trail = ptr % 188
  let trail_off = if trail < 0x3F { 0x40 } else { 0x41 }
  (lead + lead_off, trail + trail_off)
}

fn shift_jis_encode(s : String, html_fallback : Bool) -> Result[(Bytes, Bool), EncodeError] {
  let n = s.length()
  let out = ByteBuf::with_capacity(n)
  let mut had_unmappable = false
  let mut i = 0
  while i < n {
    let c0 = s.code_unit_at(i)
    if c0 < 0x80 {
      out.push_u8(c0)
      i = i + 1
      continue
    }
    let (cp, step) = utf8_str_next(s, i)
    if cp >= 0x3041 && cp < 0x3041 + 0x53 {
      out.push_u8_2(0x82, 0x9F + (cp - 0x3041))
    } else if cp >= 0x4E00 && cp <= 0x9FA0 {
      let raw_ptr = jis0208_kanji_encode(cp)
      let ptr = if raw_ptr >= 8272 { raw_ptr + 2472 } else { raw_ptr }
      if ptr >= 0 {
        let (l, t) = shift_jis_ptr_to_bytes(ptr)
        out.push_u8_2(l, t)
      } else if html_fallback {
        had_unmappable = true
        out.push_html_ncr(cp)
      } else {
        return Err(EncodeError::UnmappableCodePoint(cp, i))
      }
    } else if cp >= 0x30A1 && cp < 0x30A1 + 0x56 {
      let d = cp - 0x30A1
      let off = if d < 0x3F { 0x40 } else { 0x41 }
      out.push_u8_2(0x83, off + d)
    } else if cp >= 0x3000 && cp < 0x3003 {
      out.push_u8_2(0x81, 0x40 + (cp - 0x3000))
    } else if cp == 0xA5 {
      out.push_u8(0x5C)
    } else if cp == 0x80 {
      out.push_u8(0x80)
    } else if cp == 0x203E {
      out.push_u8(0x7E)
    } else if cp >= 0xFF61 && cp <= 0xFF9F {
      out.push_u8(cp - (0xFF61 - 0xA1))
    } else if cp == 0x2212 {
      out.push_u8_2(0x81, 0x7C)
    } else if cp < 0x10000 {
      let ptr = if cp >= 0x2170 && cp <= 0x2179 {
        10716 + (cp - 0x2170)
      } else {
        let r = jis0208_range_encode(cp)
        if r >= 0 {
          r
        } else if (cp >= 0xFA0E && cp <= 0xFA2D) || cp == 0xF929 || cp == 0xF9DC {
          let raw_ptr = jis0208_kanji_encode(cp)
          if raw_ptr >= 8272 { raw_ptr + 2472 } else { raw_ptr }
        } else {
          jis0208_symbol_encode(cp)
        }
      }
      if ptr >= 0 {
        let (l, t) = shift_jis_ptr_to_bytes(ptr)
        out.push_u8_2(l, t)
      } else if html_fallback {
        had_unmappable = true
        out.push_html_ncr(cp)
      } else {
        return Err(EncodeError::UnmappableCodePoint(cp, i))
      }
    } else if html_fallback {
      had_unmappable = true
      out.push_html_ncr(cp)
    } else {
      return Err(EncodeError::UnmappableCodePoint(cp, i))
    }
    i = i + step
  }
  Ok((out.to_bytes(), had_unmappable))
}

// ============================================================================
// EUC-JP
// ============================================================================

struct EucJpState {
  mut mode : Int // 0 = none, 1 = jis0208 lead, 2 = 0x8E katakana, 3 = 0x8F jis0212 shift, 4 = jis0212 lead
  mut lead : Int // lead - 0xA1
}

fn EucJpState::new() -> EucJpState {
  EucJpState::{ mode: 0, lead: 0 }
}

fn EucJpState::reset(self : EucJpState) -> Unit {
  self.mode = 0
  self.lead = 0
}

fn euc_jp_decode_chunk(
  st : EucJpState,
  data : Bytes,
  base_off : Int,
  last : Bool,
  fatal : Bool,
  had_err_out : FixedArray[Int],
) -> Result[String, DecodeError] {
  let n = data.length()
  if n == 0 && !last {
    return Ok("")
  }
  if st.mode == 0 && n > 0 {
    let first_non_ascii = scan_ascii_end(data, 0, n)
    if first_non_ascii == n {
      return Ok(data.to_string())
    }
  }
  let out = ByteBuf::with_capacity(n + (n >> 1) + 16)
  let mut i = 0
  while i < n {
    if st.mode == 0 {
      let b = data[i].to_int() & 0xFF
      if b < 0x80 {
        let end = scan_ascii_end(data, i + 1, n)
        out.push_bytes_slice(data, i, end)
        i = end
        continue
      }
      if b >= 0xA1 && b <= 0xFE {
        st.mode = 1
        st.lead = b - 0xA1
        i = i + 1
      } else if b == 0x8E {
        st.mode = 2
        i = i + 1
      } else if b == 0x8F {
        st.mode = 3
        i = i + 1
      } else {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i))
        }
        had_err_out[0] = 1
        out.push_replacement()
        i = i + 1
      }
    } else if st.mode == 1 {
      let lead_mo = st.lead
      st.mode = 0
      let b = data[i].to_int() & 0xFF
      if b < 0xA1 || b > 0xFE {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 1))
        }
        had_err_out[0] = 1
        out.push_replacement()
        if b >= 0x80 {
          i = i + 1
        }
        continue
      }
      let trail_mo = b - 0xA1
      if lead_mo == 0x03 && trail_mo < 0x53 {
        out.push_upper_bmp(0x3041 + trail_mo)
        i = i + 1
        continue
      }
      if lead_mo == 0x04 && trail_mo < 0x56 {
        out.push_upper_bmp(0x30A1 + trail_mo)
        i = i + 1
        continue
      }
      let ptr = lead_mo * 94 + trail_mo
      let l1 = ptr - 1410
      if l1 >= 0 && l1 < 2965 {
        out.push_upper_bmp(u16_at(jis0208_level1_kanji_tbl, l1))
        i = i + 1
        continue
      }
      let l2 = ptr - 4418
      if l2 >= 0 && l2 < 3390 {
        out.push_upper_bmp(u16_at(jis0208_level2_kanji_tbl, l2))
        i = i + 1
        continue
      }
      let ibm = ptr - 8272
      if ibm >= 0 && ibm < 360 {
        out.push_upper_bmp(u16_at(ibm_kanji_tbl, ibm))
        i = i + 1
        continue
      }
      let sym = jis0208_symbol_decode(ptr)
      if sym != 0 {
        out.push_bmp(sym)
        i = i + 1
        continue
      }
      let rng = jis0208_range_decode(ptr)
      if rng != 0 {
        out.push_bmp(rng)
        i = i + 1
        continue
      }
      if fatal {
        return Err(DecodeError::MalformedSequence(base_off + i - 1))
      }
      had_err_out[0] = 1
      out.push_replacement()
      i = i + 1
    } else if st.mode == 2 {
      // 0x8E half-width Katakana
      st.mode = 0
      let b = data[i].to_int() & 0xFF
      if b >= 0xA1 && b <= 0xDF {
        out.push_upper_bmp(0xFF61 + (b - 0xA1))
        i = i + 1
      } else {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 1))
        }
        had_err_out[0] = 1
        out.push_replacement()
        if b >= 0x80 {
          i = i + 1
        }
      }
    } else if st.mode == 3 {
      // 0x8F JIS0212 shift -> expect lead 0xA1..0xFE
      let b = data[i].to_int() & 0xFF
      if b >= 0xA1 && b <= 0xFE {
        st.mode = 4
        st.lead = b - 0xA1
        i = i + 1
      } else {
        st.mode = 0
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 1))
        }
        had_err_out[0] = 1
        out.push_replacement()
        if b >= 0x80 {
          i = i + 1
        }
      }
    } else {
      // st.mode == 4: JIS0212 trail
      let lead_mo = st.lead
      st.mode = 0
      let b = data[i].to_int() & 0xFF
      if b < 0xA1 || b > 0xFE {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 2))
        }
        had_err_out[0] = 1
        out.push_replacement()
        if b >= 0x80 {
          i = i + 1
        }
        continue
      }
      let ptr = lead_mo * 94 + (b - 0xA1)
      let k = ptr - 1410
      if k >= 0 && k < 5801 {
        out.push_upper_bmp(u16_at(jis0212_kanji_tbl, k))
        i = i + 1
        continue
      }
      let acc = jis0212_accented_decode(ptr)
      if acc != 0 {
        out.push_bmp(acc)
        i = i + 1
        continue
      }
      if ptr >= 597 && ptr <= 607 {
        out.push_mid_bmp(0x0402 + (ptr - 597))
        i = i + 1
        continue
      }
      if ptr >= 645 && ptr <= 655 {
        out.push_mid_bmp(0x0452 + (ptr - 645))
        i = i + 1
        continue
      }
      if fatal {
        return Err(DecodeError::MalformedSequence(base_off + i - 2))
      }
      had_err_out[0] = 1
      out.push_replacement()
      i = i + 1
    }
  }
  if last && st.mode != 0 {
    let pending = if st.mode == 4 { 2 } else { 1 }
    st.mode = 0
    if fatal {
      return Err(DecodeError::TruncatedSequence(base_off + n - pending))
    }
    had_err_out[0] = 1
    out.push_replacement()
  }
  Ok(out.to_string())
}

fn euc_jp_encode(s : String, html_fallback : Bool) -> Result[(Bytes, Bool), EncodeError] {
  let n = s.length()
  let out = ByteBuf::with_capacity(n)
  let mut had_unmappable = false
  let mut i = 0
  while i < n {
    let c0 = s.code_unit_at(i)
    if c0 < 0x80 {
      out.push_u8(c0)
      i = i + 1
      continue
    }
    let (cp, step) = utf8_str_next(s, i)
    if cp >= 0x3041 && cp < 0x3041 + 0x53 {
      out.push_u8_2(0xA4, 0xA1 + (cp - 0x3041))
    } else if cp >= 0x4E00 && cp <= 0x9FA0 {
      let ptr = jis0208_kanji_encode(cp)
      if ptr >= 0 {
        out.push_u8_2(ptr / 94 + 0xA1, ptr % 94 + 0xA1)
      } else if html_fallback {
        had_unmappable = true
        out.push_html_ncr(cp)
      } else {
        return Err(EncodeError::UnmappableCodePoint(cp, i))
      }
    } else if cp >= 0x30A1 && cp < 0x30A1 + 0x56 {
      out.push_u8_2(0xA5, 0xA1 + (cp - 0x30A1))
    } else if cp >= 0x3000 && cp < 0x3003 {
      out.push_u8_2(0xA1, 0xA1 + (cp - 0x3000))
    } else if cp == 0xA5 {
      out.push_u8(0x5C)
    } else if cp == 0x203E {
      out.push_u8(0x7E)
    } else if cp >= 0xFF61 && cp <= 0xFF9F {
      out.push_u8_2(0x8E, cp - (0xFF61 - 0xA1))
    } else if cp == 0x2212 {
      out.push_u8_2(0xA1, 0xDD)
    } else if cp < 0x10000 {
      let r = jis0208_range_encode(cp)
      if r >= 0 {
        out.push_u8_2(r / 94 + 0xA1, r % 94 + 0xA1)
      } else if (cp >= 0xFA0E && cp <= 0xFA2D) || cp == 0xF929 || cp == 0xF9DC {
        let ptr = jis0208_kanji_encode(cp)
        if ptr >= 0 {
          out.push_u8_2(ptr / 94 + 0xA1, ptr % 94 + 0xA1)
        } else if html_fallback {
          had_unmappable = true
          out.push_html_ncr(cp)
        } else {
          return Err(EncodeError::UnmappableCodePoint(cp, i))
        }
      } else {
        let isym = ibm_symbol_encode(cp)
        if isym >= 0 {
          out.push_u8_2(isym / 94 + 0xA1, isym % 94 + 0xA1)
        } else {
          let sym = jis0208_symbol_encode(cp)
          if sym >= 0 {
            out.push_u8_2(sym / 94 + 0xA1, sym % 94 + 0xA1)
          } else if html_fallback {
            had_unmappable = true
            out.push_html_ncr(cp)
          } else {
            return Err(EncodeError::UnmappableCodePoint(cp, i))
          }
        }
      }
    } else if html_fallback {
      had_unmappable = true
      out.push_html_ncr(cp)
    } else {
      return Err(EncodeError::UnmappableCodePoint(cp, i))
    }
    i = i + step
  }
  Ok((out.to_bytes(), had_unmappable))
}

// ============================================================================
// Big5
// ============================================================================

fn big5_decode_chunk(
  st : LeadState,
  data : Bytes,
  base_off : Int,
  last : Bool,
  fatal : Bool,
  had_err_out : FixedArray[Int],
) -> Result[String, DecodeError] {
  let n = data.length()
  if n == 0 && !last {
    return Ok("")
  }
  if st.lead < 0 && n > 0 {
    let first_non_ascii = scan_ascii_end(data, 0, n)
    if first_non_ascii == n {
      return Ok(data.to_string())
    }
  }
  let out = ByteBuf::with_capacity(n + (n >> 1) + 16)
  let mut i = 0
  while i < n {
    if st.lead < 0 {
      let b = data[i].to_int() & 0xFF
      if b < 0x80 {
        let end = scan_ascii_end(data, i + 1, n)
        out.push_bytes_slice(data, i, end)
        i = end
        continue
      }
      if b >= 0x81 && b <= 0xFE {
        st.lead = b - 0x81
        i = i + 1
      } else {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i))
        }
        had_err_out[0] = 1
        out.push_replacement()
        i = i + 1
      }
    } else {
      let lead_mo = st.lead
      st.lead = -1
      let b = data[i].to_int() & 0xFF
      let trail_mo = if b >= 0x40 && b <= 0x7E {
        b - 0x40
      } else if b >= 0xA1 && b <= 0xFE {
        b - 0x62
      } else {
        -1
      }
      if trail_mo < 0 {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 1))
        }
        had_err_out[0] = 1
        out.push_replacement()
        if b >= 0x80 {
          i = i + 1
        }
        continue
      }
      let ptr = lead_mo * 157 + trail_mo
      let rebased = ptr - 942
      let low = big5_low_bits(rebased)
      if low == 0 {
        if ptr == 1133 {
          out.push_mid_bmp(0x00CA)
          out.push_mid_bmp(0x0304)
          i = i + 1
        } else if ptr == 1135 {
          out.push_mid_bmp(0x00CA)
          out.push_mid_bmp(0x030C)
          i = i + 1
        } else if ptr == 1164 {
          out.push_mid_bmp(0x00EA)
          out.push_mid_bmp(0x0304)
          i = i + 1
        } else if ptr == 1166 {
          out.push_mid_bmp(0x00EA)
          out.push_mid_bmp(0x030C)
          i = i + 1
        } else {
          if fatal {
            return Err(DecodeError::MalformedSequence(base_off + i - 1))
          }
          had_err_out[0] = 1
          out.push_replacement()
          if b >= 0x80 {
            i = i + 1
          }
        }
      } else if big5_is_astral(rebased) {
        out.push_astral(low | 0x20000)
        i = i + 1
      } else {
        out.push_bmp(low)
        i = i + 1
      }
    }
  }
  if last && st.lead >= 0 {
    st.lead = -1
    if fatal {
      return Err(DecodeError::TruncatedSequence(base_off + n - 1))
    }
    had_err_out[0] = 1
    out.push_replacement()
  }
  Ok(out.to_string())
}

fn big5_ptr_to_bytes(ptr : Int) -> (Int, Int) {
  let lead = ptr / 157 + 0x81
  let rem = ptr % 157
  let trail = if rem < 0x3F { rem + 0x40 } else { rem + 0x62 }
  (lead, trail)
}

fn big5_encode_bmp(bmp : Int) -> (Int, Int) {
  if bmp < 0x00A7 || (bmp >= 0xAC00 && bmp <= 0xD7FF) || bmp > 0xFFED {
    return (-1, -1)
  }
  let ptr = big5_bmp_encode_ptr(bmp)
  if ptr >= 0 {
    big5_ptr_to_bytes(ptr)
  } else {
    (-1, -1)
  }
}

fn big5_encode_astral(cp : Int) -> (Int, Int) {
  if (cp >> 16) != 2 {
    return (-1, -1)
  }
  let ptr = big5_astral_encode_ptr(cp & 0xFFFF)
  if ptr >= 0 {
    big5_ptr_to_bytes(ptr)
  } else {
    (-1, -1)
  }
}

fn big5_encode(s : String, html_fallback : Bool) -> Result[(Bytes, Bool), EncodeError] {
  let n = s.length()
  let out = ByteBuf::with_capacity(n)
  let mut had_unmappable = false
  let mut i = 0
  while i < n {
    let c0 = s.code_unit_at(i)
    if c0 < 0x80 {
      out.push_u8(c0)
      i = i + 1
      continue
    }
    let (cp, step) = utf8_str_next(s, i)
    let (l, t) = if cp < 0x10000 { big5_encode_bmp(cp) } else { big5_encode_astral(cp) }
    if l >= 0 {
      out.push_u8_2(l, t)
    } else if html_fallback {
      had_unmappable = true
      out.push_html_ncr(cp)
    } else {
      return Err(EncodeError::UnmappableCodePoint(cp, i))
    }
    i = i + step
  }
  Ok((out.to_bytes(), had_unmappable))
}

// ============================================================================
// EUC-KR
// ============================================================================

fn euc_kr_decode_chunk(
  st : LeadState,
  data : Bytes,
  base_off : Int,
  last : Bool,
  fatal : Bool,
  had_err_out : FixedArray[Int],
) -> Result[String, DecodeError] {
  let n = data.length()
  if n == 0 && !last {
    return Ok("")
  }
  if st.lead < 0 && n > 0 {
    let first_non_ascii = scan_ascii_end(data, 0, n)
    if first_non_ascii == n {
      return Ok(data.to_string())
    }
  }
  let out = ByteBuf::with_capacity(n + (n >> 1) + 16)
  let mut i = 0
  while i < n {
    if st.lead < 0 {
      let b = data[i].to_int() & 0xFF
      if b < 0x80 {
        let end = scan_ascii_end(data, i + 1, n)
        out.push_bytes_slice(data, i, end)
        i = end
        continue
      }
      if b >= 0x81 && b <= 0xFE {
        st.lead = b - 0x81
        i = i + 1
      } else {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i))
        }
        had_err_out[0] = 1
        out.push_replacement()
        i = i + 1
      }
    } else {
      let lead_mo = st.lead
      st.lead = -1
      let b = data[i].to_int() & 0xFF
      if lead_mo >= 0x20 {
        if b >= 0xA1 && b <= 0xFE {
          let trail_mo = b - 0xA1
          let ksx_ptr = (lead_mo - 0x20) * 94 + trail_mo
          let hangul_ptr = ksx_ptr - (0x2F - 0x20) * 94
          if hangul_ptr >= 0 && hangul_ptr < 2350 {
            out.push_upper_bmp(u16_at(ksx1001_hangul_tbl, hangul_ptr))
            i = i + 1
            continue
          }
          if ksx_ptr < 165 {
            out.push_bmp(u16_at(ksx1001_symbols_tbl, ksx_ptr))
            i = i + 1
            continue
          }
          let hanja_ptr = ksx_ptr - (0x49 - 0x20) * 94
          if hanja_ptr >= 0 && hanja_ptr < 4888 {
            out.push_upper_bmp(u16_at(ksx1001_hanja_tbl, hanja_ptr))
            i = i + 1
            continue
          }
          if lead_mo == 0x27 && trail_mo < 15 {
            let cp = u16_at(ksx1001_uppercase_tbl, trail_mo)
            if cp == 0 {
              if fatal {
                return Err(DecodeError::MalformedSequence(base_off + i - 1))
              }
              had_err_out[0] = 1
              out.push_replacement()
            } else {
              out.push_mid_bmp(cp)
            }
            i = i + 1
            continue
          }
          if lead_mo == 0x28 && trail_mo < 16 {
            out.push_mid_bmp(u16_at(ksx1001_lowercase_tbl, trail_mo))
            i = i + 1
            continue
          }
          if lead_mo == 0x25 && trail_mo < 68 {
            out.push_upper_bmp(u16_at(ksx1001_box_tbl, trail_mo))
            i = i + 1
            continue
          }
          let other_ptr = ksx_ptr - 2 * 94
          if other_ptr >= 0 && other_ptr < 0x039F {
            let cp = ksx1001_other_decode(other_ptr)
            if cp < 0x80 {
              if fatal {
                return Err(DecodeError::MalformedSequence(base_off + i - 1))
              }
              had_err_out[0] = 1
              out.push_replacement()
            } else {
              out.push_bmp(cp)
            }
            i = i + 1
            continue
          }
          if fatal {
            return Err(DecodeError::MalformedSequence(base_off + i - 1))
          }
          had_err_out[0] = 1
          out.push_replacement()
          i = i + 1
          continue
        }
        // CP949 left Hangul range
        let left_trail = if b >= 0x81 && b <= 0xA0 {
          b - (12 + 0x41)
        } else if b >= 0x61 && b <= 0x7A {
          b - (6 + 0x41)
        } else if b >= 0x41 && b <= 0x5A {
          b - 0x41
        } else {
          -1
        }
        if left_trail < 0 {
          if fatal {
            return Err(DecodeError::MalformedSequence(base_off + i - 1))
          }
          had_err_out[0] = 1
          out.push_replacement()
          if b >= 0x80 {
            i = i + 1
          }
          continue
        }
        let left_ptr = (lead_mo - 0x20) * 84 + left_trail
        if left_ptr < (0x45 - 0x20) * 84 + 0x12 {
          out.push_upper_bmp(cp949_left_hangul_decode(left_ptr))
          i = i + 1
        } else {
          if fatal {
            return Err(DecodeError::MalformedSequence(base_off + i - 1))
          }
          had_err_out[0] = 1
          out.push_replacement()
          if b >= 0x80 {
            i = i + 1
          }
        }
      } else {
        // CP949 top Hangul range
        let top_trail = if b >= 0x81 && b <= 0xFE {
          b - (12 + 0x41)
        } else if b >= 0x61 && b <= 0x7A {
          b - (6 + 0x41)
        } else if b >= 0x41 && b <= 0x5A {
          b - 0x41
        } else {
          -1
        }
        if top_trail < 0 {
          if fatal {
            return Err(DecodeError::MalformedSequence(base_off + i - 1))
          }
          had_err_out[0] = 1
          out.push_replacement()
          if b >= 0x80 {
            i = i + 1
          }
          continue
        }
        let top_ptr = lead_mo * 178 + top_trail
        out.push_upper_bmp(cp949_top_hangul_decode(top_ptr))
        i = i + 1
      }
    }
  }
  if last && st.lead >= 0 {
    st.lead = -1
    if fatal {
      return Err(DecodeError::TruncatedSequence(base_off + n - 1))
    }
    had_err_out[0] = 1
    out.push_replacement()
  }
  Ok(out.to_string())
}

fn ksx1001_hangul_binary_search(bmp : Int) -> Int {
  let mut lo = 0
  let mut hi = 2350
  while lo < hi {
    let mid = lo + ((hi - lo) >> 1)
    let v = u16_at(ksx1001_hangul_tbl, mid)
    if v == bmp {
      return mid
    } else if v < bmp {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  -1
}

fn euc_kr_encode_bmp(bmp : Int) -> (Int, Int) {
  if bmp >= 0xAC00 && bmp <= 0xD7A3 {
    let hp = ksx1001_hangul_binary_search(bmp)
    if hp >= 0 {
      return (hp / 94 + 0xB0, hp % 94 + 0xA1)
    }
    let (lead, trail) = if bmp < 0xC8A5 {
      let tp = cp949_top_hangul_encode(bmp)
      (tp / 178 + 0x81, tp % 178)
    } else {
      let lp = cp949_left_hangul_encode(bmp)
      (lp / 84 + 0xA1, lp % 84)
    }
    let off = if trail >= 52 {
      0x41 + 12
    } else if trail >= 26 {
      0x41 + 6
    } else {
      0x41
    }
    return (lead, trail + off)
  }
  if bmp >= 0x33DE && bmp < 0xFF01 {
    if (bmp >= 0x4E00 && bmp < 0x9F9D) || (bmp >= 0xF900 && bmp < 0xFA0C) {
      let hp = ksx1001_hanja_encode(bmp)
      if hp >= 0 {
        return (hp / 94 + 0xCA, hp % 94 + 0xA1)
      }
    }
    return (-1, -1)
  }
  if bmp >= 0x3000 && bmp <= 0x3015 {
    let pos = tbl_position(ksx1001_symbols_tbl, 0, 0xAB - 0x60, bmp)
    if pos >= 0 {
      return (0xA1, pos + 0xA1)
    }
  }
  let op = ksx1001_other_encode(bmp)
  if op >= 0 {
    return (op / 94 + 0xA3, op % 94 + 0xA1)
  }
  if bmp >= 0x00AA && bmp < 0x0168 {
    let pl = tbl_position(ksx1001_lowercase_tbl, 0, 16, bmp)
    if pl >= 0 {
      return (0xA9, 0xA1 + pl)
    }
    let pu = tbl_position(ksx1001_uppercase_tbl, 0, 15, bmp)
    if pu >= 0 {
      return (0xA8, 0xA1 + pu)
    }
  } else if bmp >= 0x2500 && bmp < 0x254C {
    let pb = tbl_position(ksx1001_box_tbl, 0, 68, bmp)
    if pb >= 0 {
      return (0xA6, 0xA1 + pb)
    }
  }
  if (bmp >= 0x2015 && bmp <= 0x266D) ||
  (bmp >= 0x321C && bmp <= 0x33D8) ||
  (bmp >= 0xFF3C && bmp <= 0xFFE5) ||
  (bmp >= 0x00A1 && bmp <= 0x00F7) ||
  (bmp >= 0x02C7 && bmp <= 0x02DD) {
    let pos = tbl_position(ksx1001_symbols_tbl, 3, 165, bmp)
    if pos >= 0 {
      if pos < 91 {
        return (0xA1, pos + 0xA4)
      }
      return (0xA2, pos - 91 + 0xA1)
    }
  }
  (-1, -1)
}

fn euc_kr_encode(s : String, html_fallback : Bool) -> Result[(Bytes, Bool), EncodeError] {
  let n = s.length()
  let out = ByteBuf::with_capacity(n)
  let mut had_unmappable = false
  let mut i = 0
  while i < n {
    let c0 = s.code_unit_at(i)
    if c0 < 0x80 {
      out.push_u8(c0)
      i = i + 1
      continue
    }
    let (cp, step) = utf8_str_next(s, i)
    let (l, t) = if cp < 0x10000 { euc_kr_encode_bmp(cp) } else { (-1, -1) }
    if l >= 0 {
      out.push_u8_2(l, t)
    } else if html_fallback {
      had_unmappable = true
      out.push_html_ncr(cp)
    } else {
      return Err(EncodeError::UnmappableCodePoint(cp, i))
    }
    i = i + step
  }
  Ok((out.to_bytes(), had_unmappable))
}

// ============================================================================
// ISO-2022-JP
// ============================================================================
// States: 0=Ascii, 1=Roman, 2=Katakana, 3=LeadByte, 4=TrailByte, 5=EscapeStart, 6=Escape

struct Iso2022JpState {
  mut decoder_state : Int
  mut output_state : Int
  mut lead : Int
  mut output_flag : Bool
}

fn Iso2022JpState::new() -> Iso2022JpState {
  Iso2022JpState::{ decoder_state: 0, output_state: 0, lead: 0, output_flag: false }
}

fn Iso2022JpState::reset(self : Iso2022JpState) -> Unit {
  self.decoder_state = 0
  self.output_state = 0
  self.lead = 0
  self.output_flag = false
}

fn iso2022_jp_decode_chunk(
  st : Iso2022JpState,
  data : Bytes,
  base_off : Int,
  last : Bool,
  fatal : Bool,
  had_err_out : FixedArray[Int],
) -> Result[String, DecodeError] {
  let n = data.length()
  let out = ByteBuf::with_capacity(n + 16)
  let mut i = 0
  while i < n {
    let b = data[i].to_int() & 0xFF
    let ds = st.decoder_state
    if ds == 0 {
      // Ascii
      if b == 0x1B {
        st.decoder_state = 5
        i = i + 1
        continue
      }
      st.output_flag = false
      if b > 0x7F || b == 0x0E || b == 0x0F {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i))
        }
        had_err_out[0] = 1
        out.push_replacement()
      } else {
        out.push_u8(b)
      }
      i = i + 1
    } else if ds == 1 {
      // Roman
      if b == 0x1B {
        st.decoder_state = 5
        i = i + 1
        continue
      }
      st.output_flag = false
      if b == 0x5C {
        out.push_mid_bmp(0x00A5)
      } else if b == 0x7E {
        out.push_upper_bmp(0x203E)
      } else if b > 0x7F || b == 0x0E || b == 0x0F {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i))
        }
        had_err_out[0] = 1
        out.push_replacement()
      } else {
        out.push_u8(b)
      }
      i = i + 1
    } else if ds == 2 {
      // Katakana
      if b == 0x1B {
        st.decoder_state = 5
        i = i + 1
        continue
      }
      st.output_flag = false
      if b >= 0x21 && b <= 0x5F {
        out.push_upper_bmp(0xFF61 + (b - 0x21))
      } else {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i))
        }
        had_err_out[0] = 1
        out.push_replacement()
      }
      i = i + 1
    } else if ds == 3 {
      // LeadByte
      if b == 0x1B {
        st.decoder_state = 5
        i = i + 1
        continue
      }
      st.output_flag = false
      if b >= 0x21 && b <= 0x7E {
        st.lead = b
        st.decoder_state = 4
      } else {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i))
        }
        had_err_out[0] = 1
        out.push_replacement()
      }
      i = i + 1
    } else if ds == 4 {
      // TrailByte
      if b == 0x1B {
        st.decoder_state = 5
        i = i + 1
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 2))
        }
        had_err_out[0] = 1
        out.push_replacement()
        continue
      }
      st.decoder_state = 3
      let lead_mo = st.lead - 0x21
      if b < 0x21 || b > 0x7E {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 1))
        }
        had_err_out[0] = 1
        out.push_replacement()
        i = i + 1
        continue
      }
      let trail_mo = b - 0x21
      if lead_mo == 0x03 && trail_mo < 0x53 {
        out.push_upper_bmp(0x3041 + trail_mo)
      } else if lead_mo == 0x04 && trail_mo < 0x56 {
        out.push_upper_bmp(0x30A1 + trail_mo)
      } else {
        let ptr = lead_mo * 94 + trail_mo
        let l1 = ptr - 1410
        if l1 >= 0 && l1 < 2965 {
          out.push_upper_bmp(u16_at(jis0208_level1_kanji_tbl, l1))
        } else {
          let l2 = ptr - 4418
          if l2 >= 0 && l2 < 3390 {
            out.push_upper_bmp(u16_at(jis0208_level2_kanji_tbl, l2))
          } else {
            let ibm = ptr - 8272
            if ibm >= 0 && ibm < 360 {
              out.push_upper_bmp(u16_at(ibm_kanji_tbl, ibm))
            } else {
              let sym = jis0208_symbol_decode(ptr)
              if sym != 0 {
                out.push_bmp(sym)
              } else {
                let rng = jis0208_range_decode(ptr)
                if rng != 0 {
                  out.push_bmp(rng)
                } else {
                  if fatal {
                    return Err(DecodeError::MalformedSequence(base_off + i - 1))
                  }
                  had_err_out[0] = 1
                  out.push_replacement()
                }
              }
            }
          }
        }
      }
      i = i + 1
    } else if ds == 5 {
      // EscapeStart
      if b == 0x24 || b == 0x28 {
        st.lead = b
        st.decoder_state = 6
        i = i + 1
        continue
      }
      st.output_flag = false
      st.decoder_state = st.output_state
      if fatal {
        return Err(DecodeError::MalformedSequence(base_off + i - 1))
      }
      had_err_out[0] = 1
      out.push_replacement()
      // Reprocess b (do not increment i)
    } else {
      // ds == 6: Escape
      let mut next_st = -1
      if st.lead == 0x28 && b == 0x42 {
        next_st = 0
      } else if st.lead == 0x28 && b == 0x4A {
        next_st = 1
      } else if st.lead == 0x28 && b == 0x49 {
        next_st = 2
      } else if st.lead == 0x24 && (b == 0x40 || b == 0x42) {
        next_st = 3
      }
      if next_st >= 0 {
        st.lead = 0
        st.decoder_state = next_st
        st.output_state = next_st
        let flag = st.output_flag
        st.output_flag = true
        i = i + 1
        if flag {
          if fatal {
            return Err(DecodeError::MalformedSequence(base_off + i - 3))
          }
          had_err_out[0] = 1
          out.push_replacement()
        }
      } else {
        // Invalid escape completion: emit U+FFFD for ESC, reprocess st.lead in output_state, then reprocess b!
        let saved_lead = st.lead
        st.lead = 0
        st.decoder_state = st.output_state
        st.output_flag = false
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 2))
        }
        had_err_out[0] = 1
        out.push_replacement()
        if st.output_state == 0 || st.output_state == 1 {
          out.push_u8(saved_lead)
        } else if st.output_state == 2 {
          out.push_upper_bmp(0xFF61 + (saved_lead - 0x21))
        } else {
          // LeadByte: saved_lead (0x24 or 0x28) becomes lead and enters TrailByte
          st.lead = saved_lead
          st.decoder_state = 4
        }
        // Do not increment i: reprocess b
      }
    }
  }

  if last {
    let ds = st.decoder_state
    if ds == 4 || ds == 5 {
      st.decoder_state = st.output_state
      if fatal {
        return Err(DecodeError::TruncatedSequence(base_off + n - 1))
      }
      had_err_out[0] = 1
      out.push_replacement()
    } else if ds == 6 {
      let saved_lead = st.lead
      st.lead = 0
      st.decoder_state = st.output_state
      st.output_flag = false
      if fatal {
        return Err(DecodeError::TruncatedSequence(base_off + n - 2))
      }
      had_err_out[0] = 1
      out.push_replacement()
      if st.output_state == 0 || st.output_state == 1 {
        out.push_u8(saved_lead)
      } else if st.output_state == 2 {
        out.push_upper_bmp(0xFF61 + (saved_lead - 0x21))
      } else {
        // LeadByte: saved_lead enters TrailByte, then EOF triggers another error!
        out.push_replacement()
      }
    }
  }
  Ok(out.to_string())
}

fn iso2022_jp_encode(s : String, html_fallback : Bool) -> Result[(Bytes, Bool), EncodeError] {
  let n = s.length()
  let out = ByteBuf::with_capacity(n + 16)
  let mut had_unmappable = false
  let mut state = 0 // 0=Ascii, 1=Roman, 2=Jis0208
  let mut i = 0
  while i < n {
    let (cp, step) = utf8_str_next(s, i)
    if cp == 0x0E || cp == 0x0F || cp == 0x1B {
      if state == 2 {
        out.push_u8_3(0x1B, 0x28, 0x42)
        state = 0
      }
      if html_fallback {
        had_unmappable = true
        out.push_html_ncr(0xFFFD)
      } else {
        return Err(EncodeError::UnmappableCodePoint(0xFFFD, i))
      }
      i = i + step
      continue
    }
    if cp < 0x80 {
      if (state == 0 || state == 1) && (state == 0 || (cp != 0x5C && cp != 0x7E)) {
        out.push_u8(cp)
      } else {
        out.push_u8_3(0x1B, 0x28, 0x42)
        state = 0
        out.push_u8(cp)
      }
      i = i + step
      continue
    }
    if cp == 0x00A5 {
      if state != 1 {
        out.push_u8_3(0x1B, 0x28, 0x4A)
        state = 1
      }
      out.push_u8(0x5C)
      i = i + step
      continue
    }
    if cp == 0x203E {
      if state != 1 {
        out.push_u8_3(0x1B, 0x28, 0x4A)
        state = 1
      }
      out.push_u8(0x7E)
      i = i + step
      continue
    }
    // Map fullwidth/halfwidth katakana to JIS0208 per WHATWG §13.2.2
    let mut l = -1
    let mut t = -1
    let mut mapped_cp = cp
    if cp == 0x2212 {
      mapped_cp = 0xFF0D
    }
    if mapped_cp >= 0xFF61 && mapped_cp <= 0xFF9F {
      let idx = mapped_cp - 0xFF61
      let trail_b = iso2022_jp_half_width_trail_at(idx)
      l = if idx == 0 || idx == 1 || idx == 2 || idx == 3 || idx == 4 || idx == 15 || idx == 61 || idx == 62 {
        0x21
      } else {
        0x25
      }
      t = trail_b
    } else if mapped_cp >= 0x3041 && mapped_cp < 0x3041 + 0x53 {
      l = 0x24
      t = 0x21 + (mapped_cp - 0x3041)
    } else if mapped_cp >= 0x30A1 && mapped_cp < 0x30A1 + 0x56 {
      l = 0x25
      t = 0x21 + (mapped_cp - 0x30A1)
    } else if mapped_cp >= 0x4E00 && mapped_cp <= 0x9FA0 {
      let ptr = jis0208_kanji_encode(mapped_cp)
      if ptr >= 0 {
        l = ptr / 94 + 0x21
        t = ptr % 94 + 0x21
      }
    } else if mapped_cp < 0x10000 {
      let r = jis0208_range_encode(mapped_cp)
      if r >= 0 {
        l = r / 94 + 0x21
        t = r % 94 + 0x21
      } else if (mapped_cp >= 0xFA0E && mapped_cp <= 0xFA2D) || mapped_cp == 0xF929 || mapped_cp == 0xF9DC {
        let ptr = jis0208_kanji_encode(mapped_cp)
        if ptr >= 0 {
          l = ptr / 94 + 0x21
          t = ptr % 94 + 0x21
        }
      } else {
        let isym = ibm_symbol_encode(mapped_cp)
        if isym >= 0 {
          l = isym / 94 + 0x21
          t = isym % 94 + 0x21
        } else {
          let sym = jis0208_symbol_encode(mapped_cp)
          if sym >= 0 {
            l = sym / 94 + 0x21
            t = sym % 94 + 0x21
          }
        }
      }
    }
    if l >= 0 {
      if state != 2 {
        out.push_u8_3(0x1B, 0x24, 0x42)
        state = 2
      }
      out.push_u8_2(l, t)
    } else {
      if state == 2 {
        out.push_u8_3(0x1B, 0x28, 0x42)
        state = 0
      }
      if html_fallback {
        had_unmappable = true
        out.push_html_ncr(cp)
      } else {
        return Err(EncodeError::UnmappableCodePoint(cp, i))
      }
    }
    i = i + step
  }
  if state != 0 {
    out.push_u8_3(0x1B, 0x28, 0x42)
  }
  Ok((out.to_bytes(), had_unmappable))
}
