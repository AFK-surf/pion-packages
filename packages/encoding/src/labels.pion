///| Resolve a WHATWG encoding label, returning `None` for the `replacement` encoding.
pub fn Encoding::for_label_no_replacement(label : String) -> Option[Encoding] {
  match Encoding::for_label(label) {
    Some(Encoding::Replacement) => None
    other => other
  }
}

///| Sniff a UTF-8 (`EF BB BF`, 3), UTF-16BE (`FE FF`, 2), or UTF-16LE (`FF FE`, 2) BOM per WHATWG §6.
pub fn sniff_bom(data : Bytes) -> Option[(Encoding, Int)] {
  let n = data.length()
  if n >= 3 && data[0] == 0xEF.to_byte() && data[1] == 0xBB.to_byte() && data[2] == 0xBF.to_byte() {
    return Some((Encoding::Utf8, 3))
  }
  if n >= 2 {
    let b0 = data[0].to_int() & 0xFF
    let b1 = data[1].to_int() & 0xFF
    if b0 == 0xFE && b1 == 0xFF {
      return Some((Encoding::Utf16Be, 2))
    }
    if b0 == 0xFF && b1 == 0xFE {
      return Some((Encoding::Utf16Le, 2))
    }
  }
  None
}
