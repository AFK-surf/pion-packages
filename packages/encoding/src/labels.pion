///| WHATWG Encoding Standard §4.2 label resolution & §6 BOM sniffing.
///| Covers all official WHATWG labels with ASCII whitespace trimming (U+0009, U+000A, U+000C, U+000D, U+0020)
///| and ASCII case-insensitive matching.

fn is_whatwg_ascii_ws(c : Int) -> Bool {
  c == 0x09 || c == 0x0A || c == 0x0C || c == 0x0D || c == 0x20
}

fn normalize_label(label : String) -> String {
  let n = label.length()
  let mut start = 0
  while start < n && is_whatwg_ascii_ws(label.code_unit_at(start)) {
    start = start + 1
  }
  let mut end = n
  while end > start && is_whatwg_ascii_ws(label.code_unit_at(end - 1)) {
    end = end - 1
  }
  let len = end - start
  if len == 0 || len > 40 {
    return ""
  }
  let sb = StringBuilder::with_capacity(len)
  let mut i = start
  while i < end {
    let c = label.code_unit_at(i)
    if c >= 0x41 && c <= 0x5A {
      sb.write_byte((c + 32).to_byte())
    } else if c >= 0x80 {
      return ""
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Resolve a WHATWG encoding label (case-insensitive, trimmed of ASCII whitespace).
pub fn Encoding::for_label(label : String) -> Option[Encoding] {
  let norm = normalize_label(label)
  if norm.length() == 0 {
    return None
  }
  match norm {
    "l1" => Some(Encoding::Windows1252)
    "l2" => Some(Encoding::Iso8859_2)
    "l3" => Some(Encoding::Iso8859_3)
    "l4" => Some(Encoding::Iso8859_4)
    "l5" => Some(Encoding::Windows1254)
    "l6" => Some(Encoding::Iso8859_10)
    "l9" => Some(Encoding::Iso8859_15)
    "866" => Some(Encoding::Ibm866)
    "mac" => Some(Encoding::Macintosh)
    "koi" => Some(Encoding::Koi8R)
    "gbk" => Some(Encoding::Gbk)
    "big5" => Some(Encoding::Big5)
    "utf8" => Some(Encoding::Utf8)
    "koi8" => Some(Encoding::Koi8R)
    "sjis" => Some(Encoding::ShiftJis)
    "ucs-2" => Some(Encoding::Utf16Le)
