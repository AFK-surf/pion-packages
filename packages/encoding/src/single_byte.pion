///| Single-byte (all 28 WHATWG single-byte encodings), `x-user-defined`, and `replacement` decoders & encoders.

fn single_byte_decode_chunk(
  tbl_idx : Int,
  data : Bytes,
  base_off : Int,
  fatal : Bool,
  had_err_out : FixedArray[Int],
) -> Result[String, DecodeError] {
  let n = data.length()
  if n == 0 {
    return Ok("")
  }
  let first_non_ascii = scan_ascii_end(data, 0, n)
  if first_non_ascii == n {
    return Ok(data.to_string())
  }
  let out = ByteBuf::with_capacity(n + (n - first_non_ascii))
  if first_non_ascii > 0 {
    out.push_bytes_slice(data, 0, first_non_ascii)
  }
  let mut i = first_non_ascii
  while i < n {
    let b = data[i].to_int() & 0xFF
    if b < 0x80 {
      let end = scan_ascii_end(data, i + 1, n)
      out.push_bytes_slice(data, i, end)
      i = end
      continue
    }
    let cp = sb_decode_upper(tbl_idx, b)
    if cp == 0 {
      if fatal {
        return Err(DecodeError::MalformedSequence(base_off + i))
      }
      had_err_out[0] = 1
      out.push_replacement()
    } else {
      out.push_bmp(cp)
    }
    i = i + 1
  }
  Ok(out.to_string())
}

fn x_user_defined_decode_chunk(data : Bytes) -> String {
  let n = data.length()
  if n == 0 {
    return ""
  }
  let first_non_ascii = scan_ascii_end(data, 0, n)
  if first_non_ascii == n {
    return data.to_string()
  }
  let out = ByteBuf::with_capacity(n + (n - first_non_ascii) * 2)
  if first_non_ascii > 0 {
    out.push_bytes_slice(data, 0, first_non_ascii)
  }
  let mut i = first_non_ascii
  while i < n {
    let b = data[i].to_int() & 0xFF
    if b < 0x80 {
      let end = scan_ascii_end(data, i + 1, n)
      out.push_bytes_slice(data, i, end)
      i = end
      continue
    }
    out.push_upper_bmp(0xF700 + b)
    i = i + 1
  }
  out.to_string()
}

fn single_byte_encode(
  tbl_idx : Int,
  s : String,
  html_fallback : Bool,
) -> Result[(Bytes, Bool), EncodeError] {
  let n = s.length()
  let out = ByteBuf::with_capacity(n)
  let mut had_unmappable = false
  let mut i = 0
  while i < n {
    let c0 = s.code_unit_at(i)
    if c0 < 0x80 {
      out.push_u8(c0)
      i = i + 1
      continue
    }
    let (cp, step) = utf8_str_next(s, i)
    let mapped = sb_encode_cp(tbl_idx, cp)
    if mapped >= 0 {
      out.push_u8(mapped)
    } else if html_fallback {
      had_unmappable = true
      out.push_html_ncr(cp)
    } else {
      return Err(EncodeError::UnmappableCodePoint(cp, i))
    }
    i = i + step
  }
  Ok((out.to_bytes(), had_unmappable))
}

fn x_user_defined_encode(
  s : String,
  html_fallback : Bool,
) -> Result[(Bytes, Bool), EncodeError] {
  let n = s.length()
  let out = ByteBuf::with_capacity(n)
  let mut had_unmappable = false
  let mut i = 0
  while i < n {
    let c0 = s.code_unit_at(i)
    if c0 < 0x80 {
      out.push_u8(c0)
      i = i + 1
      continue
    }
    let (cp, step) = utf8_str_next(s, i)
    if cp >= 0xF780 && cp <= 0xF7FF {
      out.push_u8(cp - 0xF700)
    } else if html_fallback {
      had_unmappable = true
      out.push_html_ncr(cp)
    } else {
      return Err(EncodeError::UnmappableCodePoint(cp, i))
    }
    i = i + step
  }
  Ok((out.to_bytes(), had_unmappable))
}
