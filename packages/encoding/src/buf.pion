///| Fast reusable growable byte buffer & UTF-8 scalar reader for `packages/encoding`.

struct ByteBuf {
  mut data : Bytes
  mut len : Int
}

fn ByteBuf::with_capacity(cap : Int) -> ByteBuf {
  let c = if cap < 16 { 16 } else { cap }
  ByteBuf::{ data: Bytes::new(c), len: 0 }
}

fn ByteBuf::grow(self : ByteBuf, needed : Int) -> Unit {
  let mut cap = self.data.length()
  let target = self.len + needed
  if cap >= target {
    return ()
  }
  while cap < target {
    cap = cap * 2
  }
  let next = Bytes::new(cap)
  let n = self.len
  let src = self.data
  let mut i = 0
  while i + 4 <= n {
    next[i] = src[i]
    next[i + 1] = src[i + 1]
    next[i + 2] = src[i + 2]
    next[i + 3] = src[i + 3]
    i = i + 4
  }
  while i < n {
    next[i] = src[i]
    i = i + 1
  }
  self.data = next
}

fn ByteBuf::push_u8(self : ByteBuf, b : Int) -> Unit {
  let pos = self.len
  if pos >= self.data.length() {
    self.grow(1)
  }
  self.data[pos] = b.to_byte()
  self.len = pos + 1
}

fn ByteBuf::push_u8_2(self : ByteBuf, b0 : Int, b1 : Int) -> Unit {
  let pos = self.len
  if pos + 2 > self.data.length() {
    self.grow(2)
  }
  let d = self.data
  d[pos] = b0.to_byte()
  d[pos + 1] = b1.to_byte()
  self.len = pos + 2
}

fn ByteBuf::push_u8_3(self : ByteBuf, b0 : Int, b1 : Int, b2 : Int) -> Unit {
  let pos = self.len
  if pos + 3 > self.data.length() {
    self.grow(3)
  }
  let d = self.data
  d[pos] = b0.to_byte()
  d[pos + 1] = b1.to_byte()
  d[pos + 2] = b2.to_byte()
  self.len = pos + 3
}

fn ByteBuf::push_u8_4(self : ByteBuf, b0 : Int, b1 : Int, b2 : Int, b3 : Int) -> Unit {
  let pos = self.len
  if pos + 4 > self.data.length() {
    self.grow(4)
  }
  let d = self.data
  d[pos] = b0.to_byte()
  d[pos + 1] = b1.to_byte()
  d[pos + 2] = b2.to_byte()
  d[pos + 3] = b3.to_byte()
  self.len = pos + 4
}

fn ByteBuf::push_bytes_slice(self : ByteBuf, src : Bytes, start : Int, end : Int) -> Unit {
  let count = end - start
  if count <= 0 {
    return ()
  }
  let pos = self.len
  if pos + count > self.data.length() {
    self.grow(count)
  }
  let dst = self.data
  let mut s = start
  let mut d = pos
  let stop4 = end - 3
  while s < stop4 {
    dst[d] = src[s]
    dst[d + 1] = src[s + 1]
    dst[d + 2] = src[s + 2]
    dst[d + 3] = src[s + 3]
    s = s + 4
    d = d + 4
  }
  while s < end {
    dst[d] = src[s]
    s = s + 1
    d = d + 1
  }
  self.len = pos + count
}

fn ByteBuf::push_upper_bmp(self : ByteBuf, cp : Int) -> Unit {
  let pos = self.len
  if pos + 3 > self.data.length() {
    self.grow(3)
  }
  let d = self.data
  d[pos] = (0xE0 | (cp >> 12)).to_byte()
  d[pos + 1] = (0x80 | ((cp >> 6) & 0x3F)).to_byte()
  d[pos + 2] = (0x80 | (cp & 0x3F)).to_byte()
  self.len = pos + 3
}

fn ByteBuf::push_mid_bmp(self : ByteBuf, cp : Int) -> Unit {
  let pos = self.len
  if pos + 2 > self.data.length() {
    self.grow(2)
  }
  let d = self.data
  d[pos] = (0xC0 | (cp >> 6)).to_byte()
  d[pos + 1] = (0x80 | (cp & 0x3F)).to_byte()
  self.len = pos + 2
}

fn ByteBuf::push_bmp(self : ByteBuf, cp : Int) -> Unit {
  if cp < 0x80 {
    self.push_u8(cp)
  } else if cp < 0x800 {
    self.push_mid_bmp(cp)
  } else {
    self.push_upper_bmp(cp)
  }
}

fn ByteBuf::push_astral(self : ByteBuf, cp : Int) -> Unit {
  let pos = self.len
  if pos + 4 > self.data.length() {
    self.grow(4)
  }
  let d = self.data
  d[pos] = (0xF0 | (cp >> 18)).to_byte()
  d[pos + 1] = (0x80 | ((cp >> 12) & 0x3F)).to_byte()
  d[pos + 2] = (0x80 | ((cp >> 6) & 0x3F)).to_byte()
  d[pos + 3] = (0x80 | (cp & 0x3F)).to_byte()
  self.len = pos + 4
}

fn ByteBuf::push_replacement(self : ByteBuf) -> Unit {
  self.push_u8_3(0xEF, 0xBF, 0xBD)
}

fn ByteBuf::push_html_ncr(self : ByteBuf, cp : Int) -> Unit {
  self.push_u8_2(0x26, 0x23) // "&#"
  let digits = cp.to_string()
  let mut i = 0
  let n = digits.length()
  while i < n {
    self.push_u8(digits.code_unit_at(i))
    i = i + 1
  }
  self.push_u8(0x3B) // ';'
}

fn ByteBuf::to_bytes(self : ByteBuf) -> Bytes {
  if self.len == self.data.length() {
    self.data
  } else {
    self.data.slice(0, self.len)
  }
}

fn ByteBuf::to_string(self : ByteBuf) -> String {
  if self.len == 0 {
    ""
  } else if self.len == self.data.length() {
    self.data.to_string()
  } else {
    self.data.slice(0, self.len).to_string()
  }
}

///| Scan continuous ASCII bytes `< 0x80` starting at `start` (8-byte unrolled).
fn scan_ascii_end(data : Bytes, start : Int, n : Int) -> Int {
  let mut i = start
  let stop8 = n - 7
  while i < stop8 {
    let a = (data[i].to_int() | data[i + 1].to_int() | data[i + 2].to_int() | data[i + 3].to_int())
    let b = (data[i + 4].to_int() | data[i + 5].to_int() | data[i + 6].to_int() | data[i + 7].to_int())
    if ((a | b) & 0x80) != 0 {
      break
    }
    i = i + 8
  }
  while i < n && (data[i].to_int() & 0x80) == 0 {
    i = i + 1
  }
  i
}

///| Decode one UTF-8 scalar value from `s` at byte `pos`.
///| Returns `(codepoint, byte_len)` or `(-1, 0)` on invalid UTF-8.
fn utf8_str_next(s : String, pos : Int) -> (Int, Int) {
  let n = s.length()
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0, 1)
  }
  if b0 >= 0xC2 && b0 <= 0xDF {
    if pos + 1 < n {
      let b1 = s.code_unit_at(pos + 1)
      if (b1 & 0xC0) == 0x80 {
        return (((b0 & 0x1F) << 6) | (b1 & 0x3F), 2)
      }
    }
    return (-1, 0)
  }
  if b0 >= 0xE0 && b0 <= 0xEF {
    if pos + 2 < n {
      let b1 = s.code_unit_at(pos + 1)
      let b2 = s.code_unit_at(pos + 2)
      let valid_b1 = if b0 == 0xE0 {
        b1 >= 0xA0 && b1 <= 0xBF
      } else if b0 == 0xED {
        b1 >= 0x80 && b1 <= 0x9F
      } else {
        (b1 & 0xC0) == 0x80
      }
      if valid_b1 && (b2 & 0xC0) == 0x80 {
        return (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), 3)
      }
    }
    return (-1, 0)
  }
  if b0 >= 0xF0 && b0 <= 0xF4 {
    if pos + 3 < n {
      let b1 = s.code_unit_at(pos + 1)
      let b2 = s.code_unit_at(pos + 2)
      let b3 = s.code_unit_at(pos + 3)
      let valid_b1 = if b0 == 0xF0 {
        b1 >= 0x90 && b1 <= 0xBF
      } else if b0 == 0xF4 {
        b1 >= 0x80 && b1 <= 0x8F
      } else {
        (b1 & 0xC0) == 0x80
      }
      if valid_b1 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
        return (
          ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F),
          4,
        )
      }
    }
    return (-1, 0)
  }
  (-1, 0)
}
