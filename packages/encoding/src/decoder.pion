///| Unified streaming `Decoder` and one-shot `decode*` / `encode*` APIs for `packages/encoding`.

enum DecoderVariant {
  Utf8(Utf8State)
  Utf16(Utf16State)
  SingleByte(Int)
  XUserDefined
  Replacement(FixedArray[Int]) // [0] = emitted flag
  Gb18030(Gb18030State)
  ShiftJis(LeadState)
  EucJp(EucJpState)
  Big5(LeadState)
  EucKr(LeadState)
  Iso2022Jp(Iso2022JpState)
}

fn make_variant(enc : Encoding, ignore_bom : Bool) -> DecoderVariant {
  match enc {
    Encoding::Utf8 => DecoderVariant::Utf8(Utf8State::new(ignore_bom))
    Encoding::Utf16Le => DecoderVariant::Utf16(Utf16State::new(false, ignore_bom))
    Encoding::Utf16Be => DecoderVariant::Utf16(Utf16State::new(true, ignore_bom))
    Encoding::Replacement => DecoderVariant::Replacement([0])
    Encoding::XUserDefined => DecoderVariant::XUserDefined
    Encoding::Gbk => DecoderVariant::Gb18030(Gb18030State::new())
    Encoding::Gb18030 => DecoderVariant::Gb18030(Gb18030State::new())
    Encoding::ShiftJis => DecoderVariant::ShiftJis(LeadState::new())
    Encoding::EucJp => DecoderVariant::EucJp(EucJpState::new())
    Encoding::Big5 => DecoderVariant::Big5(LeadState::new())
    Encoding::EucKr => DecoderVariant::EucKr(LeadState::new())
    Encoding::Iso2022Jp => DecoderVariant::Iso2022Jp(Iso2022JpState::new())
    _ => DecoderVariant::SingleByte(sb_table_index(enc))
  }
}

///| Streaming WHATWG Encoding Standard decoder (1:1 semantics with Web `TextDecoder`).
pub struct Decoder {
  enc : Encoding
  fatal : Bool
  ignore_bom : Bool
  mut had_err : Bool
  mut variant : DecoderVariant
}

///| Create a streaming `Decoder` with default options (`fatal: false`, `ignore_bom: false`).
pub fn Decoder::new(enc : Encoding) -> Decoder {
  Decoder::with_options(enc, DecodeOptions::default())
}

///| Create a streaming `Decoder` with explicit `DecodeOptions` (`fatal`, `ignore_bom`).
pub fn Decoder::with_options(enc : Encoding, opts : DecodeOptions) -> Decoder {
  Decoder::{
    enc: enc,
    fatal: opts.fatal,
    ignore_bom: opts.ignore_bom,
    had_err: false,
    variant: make_variant(enc, opts.ignore_bom),
  }
}

///| The encoding of this `Decoder`.
pub fn Decoder::encoding(self : Decoder) -> Encoding {
  self.enc
}

///| Whether any malformed or truncated sequence has been replaced so far.
pub fn Decoder::had_errors(self : Decoder) -> Bool {
  self.had_err
}

///| Reset this `Decoder` to its initial state for reuse on a new stream.
pub fn Decoder::reset(self : Decoder) -> Unit {
  self.had_err = false
  match self.variant {
    DecoderVariant::Utf8(st) => st.reset(self.ignore_bom)
    DecoderVariant::Utf16(st) => st.reset(self.ignore_bom)
    DecoderVariant::Replacement(flag) => flag[0] = 0
    DecoderVariant::Gb18030(st) => st.reset()
    DecoderVariant::ShiftJis(st) => st.reset()
    DecoderVariant::EucJp(st) => st.reset()
    DecoderVariant::Big5(st) => st.reset()
    DecoderVariant::EucKr(st) => st.reset()
    DecoderVariant::Iso2022Jp(st) => st.reset()
    _ => ()
  }
}

///| Decode one chunk of bytes. Pass `last = true` on the final chunk to flush pending state.
pub fn Decoder::decode_chunk(
  self : Decoder,
  bytes : Bytes,
  last : Bool,
) -> Result[String, DecodeError] {
  let err_flag : FixedArray[Int] = [0]
  let res = match self.variant {
    DecoderVariant::Utf8(st) => utf8_decode_chunk(st, bytes, last, self.fatal, err_flag)
    DecoderVariant::Utf16(st) => utf16_decode_chunk(st, bytes, last, self.fatal, err_flag)
    DecoderVariant::SingleByte(tbl) => single_byte_decode_chunk(tbl, bytes, self.fatal, err_flag)
    DecoderVariant::XUserDefined => Ok(x_user_defined_decode_chunk(bytes))
    DecoderVariant::Replacement(flag) => {
      if flag[0] != 0 || bytes.length() == 0 {
        Ok("")
      } else {
        flag[0] = 1
        if self.fatal {
          Err(DecodeError::ReplacementEncoding)
        } else {
          err_flag[0] = 1
          Ok("\u{FFFD}")
        }
      }
    }
    DecoderVariant::Gb18030(st) => gb18030_decode_chunk(st, bytes, last, self.fatal, err_flag)
    DecoderVariant::ShiftJis(st) => shift_jis_decode_chunk(st, bytes, last, self.fatal, err_flag)
    DecoderVariant::EucJp(st) => euc_jp_decode_chunk(st, bytes, last, self.fatal, err_flag)
    DecoderVariant::Big5(st) => big5_decode_chunk(st, bytes, last, self.fatal, err_flag)
    DecoderVariant::EucKr(st) => euc_kr_decode_chunk(st, bytes, last, self.fatal, err_flag)
    DecoderVariant::Iso2022Jp(st) => iso2022_jp_decode_chunk(st, bytes, last, self.fatal, err_flag)
  }
  if err_flag[0] != 0 {
    self.had_err = true
  }
  if last {
    self.reset()
    if err_flag[0] != 0 {
      self.had_err = true
    }
  }
  res
}

///| One-shot non-fatal decode (strips matching BOM for UTF-8/UTF-16LE/UTF-16BE).
pub fn decode(enc : Encoding, data : Bytes) -> String {
  let dec = Decoder::new(enc)
  match dec.decode_chunk(data, true) {
    Ok(s) => s
    Err(_) => ""
  }
}

///| One-shot decode with explicit `DecodeOptions` (`fatal`, `ignore_bom`).
pub fn decode_with_options(
  enc : Encoding,
  data : Bytes,
  opts : DecodeOptions,
) -> Result[String, DecodeError] {
  let dec = Decoder::with_options(enc, opts)
  dec.decode_chunk(data, true)
}

///| One-shot decode with WHATWG BOM sniffing (matches `encoding_rs::Encoding::decode`).
///| Returns `(decoded_string, actual_encoding_used, had_errors)`.
pub fn decode_with_bom_sniffing(enc : Encoding, data : Bytes) -> (String, Encoding, Bool) {
  match sniff_bom(data) {
    Some((bom_enc, bom_len)) => {
      let rest = data.slice(bom_len, data.length())
      let dec = Decoder::with_options(bom_enc, DecodeOptions::new(false, true))
      let s = match dec.decode_chunk(rest, true) {
        Ok(v) => v
        Err(_) => ""
      }
      (s, bom_enc, dec.had_errors())
    }
    None => {
      let dec = Decoder::with_options(enc, DecodeOptions::new(false, true))
      let s = match dec.decode_chunk(data, true) {
        Ok(v) => v
        Err(_) => ""
      }
      (s, enc, dec.had_errors())
    }
  }
}

fn encode_internal(
  enc : Encoding,
  s : String,
  html_fallback : Bool,
) -> Result[(Bytes, Bool), EncodeError] {
  match enc {
    Encoding::Utf8 => Ok((encode_utf8(s), false))
    Encoding::Replacement => Ok((encode_utf8(s), false))
    Encoding::Utf16Le =>
    if html_fallback {
      Ok((encode_utf8(s), false))
    } else {
      Ok((encode_utf16le(s), false))
    }
    Encoding::Utf16Be =>
    if html_fallback {
      Ok((encode_utf8(s), false))
    } else {
      Ok((encode_utf16be(s), false))
    }
    Encoding::XUserDefined => x_user_defined_encode(s, html_fallback)
    Encoding::Gbk => gb18030_encode(s, false, html_fallback)
    Encoding::Gb18030 => gb18030_encode(s, true, html_fallback)
    Encoding::ShiftJis => shift_jis_encode(s, html_fallback)
    Encoding::EucJp => euc_jp_encode(s, html_fallback)
    Encoding::Big5 => big5_encode(s, html_fallback)
    Encoding::EucKr => euc_kr_encode(s, html_fallback)
    Encoding::Iso2022Jp => iso2022_jp_encode(s, html_fallback)
    _ => single_byte_encode(sb_table_index(enc), s, html_fallback)
  }
}

///| Strict encode: encodes `s` into `enc`, returning `Err(EncodeError)` on unmappable code points.
pub fn encode(enc : Encoding, s : String) -> Result[Bytes, EncodeError] {
  match encode_internal(enc, s, false) {
    Ok((b, _)) => Ok(b)
    Err(e) => Err(e)
  }
}

///| WHATWG HTML encode: uses `enc.output_encoding()` and replaces unmappable code points with `&#<dec>;`.
///| Returns `(encoded_bytes, had_unmappable)`.
pub fn encode_html(enc : Encoding, s : String) -> (Bytes, Bool) {
  match encode_internal(enc.output_encoding(), s, true) {
    Ok(res) => res
    Err(_) => (encode_utf8(s), true)
  }
}
