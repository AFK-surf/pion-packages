///| Comprehensive WHATWG Encoding Standard compliance & streaming test suite.

fn assert_true(cond : Bool) -> Unit {
  debug_assert(cond, "expected true")
}

fn assert_eq_str(a : String, b : String) -> Unit {
  debug_assert(a == b, "string mismatch: got '" + a + "', expected '" + b + "'")
}

fn assert_eq_int(a : Int, b : Int) -> Unit {
  debug_assert(a == b, "int mismatch: got " + a.to_string() + ", expected " + b.to_string())
}

fn mk_bytes(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn decode_1byte_streaming(enc : Encoding, data : Bytes, opts : DecodeOptions) -> Result[String, DecodeError] {
  let dec = Decoder::with_options(enc, opts)
  let sb = StringBuilder::new()
  let n = data.length()
  let mut i = 0
  while i < n {
    let chunk = data.slice(i, i + 1)
    match dec.decode_chunk(chunk, false) {
      Ok(s) => sb.write_string(s)
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  match dec.decode_chunk(Bytes::new(0), true) {
    Ok(s) => {
      sb.write_string(s)
      Ok(sb.to_string())
    }
    Err(e) => Err(e)
  }
}

fn assert_decode_both(enc : Encoding, raw : Array[Int], expected : String, msg : String) -> Unit {
  let b = mk_bytes(raw)
  let whole = decode(enc, b)
  assert_eq_str(whole, expected)
  let streamed = match decode_1byte_streaming(enc, b, DecodeOptions::default()) {
    Ok(s) => s
    Err(e) => {
      assert_true(false)
      e.to_string()
    }
  }
  let _ = msg
  assert_eq_str(streamed, expected)
}

test "labels: core WHATWG aliases, case-insensitivity, whitespace" {
  match Encoding::for_label("utf-8") {
    Some(e) => assert_eq_str(e.name(), "UTF-8")
    None => assert_true(false)
  }
  match Encoding::for_label("  \t\r\nUTF8\n ") {
    Some(e) => assert_eq_str(e.name(), "UTF-8")
    None => assert_true(false)
  }
  match Encoding::for_label("unicode-1-1-utf-8") {
    Some(e) => assert_eq_str(e.name(), "UTF-8")
    None => assert_true(false)
  }
  match Encoding::for_label("utf-16") {
    Some(e) => assert_eq_str(e.name(), "UTF-16LE")
    None => assert_true(false)
  }
  match Encoding::for_label("UTF-16BE") {
    Some(e) => assert_eq_str(e.name(), "UTF-16BE")
    None => assert_true(false)
  }
  match Encoding::for_label("latin1") {
    Some(e) => assert_eq_str(e.name(), "windows-1252")
    None => assert_true(false)
  }
  match Encoding::for_label("ISO-8859-1") {
    Some(e) => assert_eq_str(e.name(), "windows-1252")
    None => assert_true(false)
  }
  match Encoding::for_label("us-ascii") {
    Some(e) => assert_eq_str(e.name(), "windows-1252")
    None => assert_true(false)
  }
  match Encoding::for_label("gb2312") {
    Some(e) => assert_eq_str(e.name(), "GBK")
    None => assert_true(false)
  }
  match Encoding::for_label("x-gbk") {
    Some(e) => assert_eq_str(e.name(), "GBK")
    None => assert_true(false)
  }
  match Encoding::for_label("gb18030") {
    Some(e) => assert_eq_str(e.name(), "gb18030")
    None => assert_true(false)
  }
  match Encoding::for_label("big5-hkscs") {
    Some(e) => assert_eq_str(e.name(), "Big5")
    None => assert_true(false)
  }
  match Encoding::for_label("windows-31j") {
    Some(e) => assert_eq_str(e.name(), "Shift_JIS")
    None => assert_true(false)
  }
  match Encoding::for_label("ms_kanji") {
    Some(e) => assert_eq_str(e.name(), "Shift_JIS")
    None => assert_true(false)
  }
  match Encoding::for_label("euc-jp") {
    Some(e) => assert_eq_str(e.name(), "EUC-JP")
    None => assert_true(false)
  }
  match Encoding::for_label("ks_c_5601-1987") {
    Some(e) => assert_eq_str(e.name(), "EUC-KR")
    None => assert_true(false)
  }
  match Encoding::for_label("iso-2022-jp") {
    Some(e) => assert_eq_str(e.name(), "ISO-2022-JP")
    None => assert_true(false)
  }
  match Encoding::for_label("iso-2022-kr") {
    Some(e) => assert_eq_str(e.name(), "replacement")
    None => assert_true(false)
  }
  match Encoding::for_label_no_replacement("iso-2022-kr") {
    None => ()
    Some(_) => assert_true(false)
  }
  match Encoding::for_label("not-an-encoding") {
    None => ()
    Some(_) => assert_true(false)
  }
  // Vertical tab U+000B is NOT WHATWG ASCII whitespace
  match Encoding::for_label("\x0Butf-8") {
    None => ()
    Some(_) => assert_true(false)
  }
}

test "bom: sniff_bom priority and boundaries" {
  match sniff_bom(mk_bytes([0xEF, 0xBB, 0xBF, 0x41])) {
    Some((e, n)) => {
      assert_eq_str(e.name(), "UTF-8")
      assert_eq_int(n, 3)
    }
    None => assert_true(false)
  }
  match sniff_bom(mk_bytes([0xFE, 0xFF, 0x00, 0x41])) {
    Some((e, n)) => {
      assert_eq_str(e.name(), "UTF-16BE")
      assert_eq_int(n, 2)
    }
    None => assert_true(false)
  }
  match sniff_bom(mk_bytes([0xFF, 0xFE, 0x41, 0x00])) {
    Some((e, n)) => {
      assert_eq_str(e.name(), "UTF-16LE")
      assert_eq_int(n, 2)
    }
    None => assert_true(false)
  }
  match sniff_bom(mk_bytes([0xEF, 0xBB])) {
    None => ()
    Some(_) => assert_true(false)
  }
  match sniff_bom(Bytes::new(0)) {
    None => ()
    Some(_) => assert_true(false)
  }
}

test "utf8: valid, BOM, overlong, surrogates, maximal subpart, streaming" {
  assert_decode_both(Encoding::Utf8, [0x48, 0x69, 0x20, 0xE4, 0xB8, 0xAD, 0xF0, 0x9F, 0x98, 0x80], "Hi 中😀", "utf8 valid")
  // BOM stripped by default
  assert_decode_both(Encoding::Utf8, [0xEF, 0xBB, 0xBF, 0x41], "A", "utf8 bom strip")
  // ignore_bom = true preserves U+FEFF
  let b_bom = mk_bytes([0xEF, 0xBB, 0xBF, 0x41])
  match decode_with_options(Encoding::Utf8, b_bom, DecodeOptions::new(false, true)) {
    Ok(s) => assert_eq_str(s, "\u{FEFF}A")
    Err(_) => assert_true(false)
  }
  // Overlong 2-byte NUL C0 80 -> 2 replacements
  assert_decode_both(Encoding::Utf8, [0xC0, 0x80], "\u{FFFD}\u{FFFD}", "overlong 2")
  // Surrogate U+D800: ED A0 80 -> 3 replacements
  assert_decode_both(Encoding::Utf8, [0xED, 0xA0, 0x80], "\u{FFFD}\u{FFFD}\u{FFFD}", "surrogate")
  // > U+10FFFF: F4 90 80 80 -> 4 replacements
  assert_decode_both(Encoding::Utf8, [0xF4, 0x90, 0x80, 0x80], "\u{FFFD}\u{FFFD}\u{FFFD}\u{FFFD}", "above max")
  // Truncated 3-byte valid prefix E4 B8 followed by 'A' -> 1 replacement + 'A'
  assert_decode_both(Encoding::Utf8, [0xE4, 0xB8, 0x41], "\u{FFFD}A", "maximal subpart")
  // Fatal mode rejects malformed & truncated
  match decode_with_options(Encoding::Utf8, mk_bytes([0xFF]), DecodeOptions::new(true, false)) {
    Err(_) => ()
    Ok(_) => assert_true(false)
  }
  match decode_with_options(Encoding::Utf8, mk_bytes([0xE4, 0xB8]), DecodeOptions::new(true, false)) {
    Err(_) => ()
    Ok(_) => assert_true(false)
  }
}

test "utf16: LE & BE valid, surrogate pairs, lone surrogates, odd tail, streaming" {
  // UTF-16LE: BOM + "A" + U+1F600 (D83D DE00)
  assert_decode_both(Encoding::Utf16Le, [0xFF, 0xFE, 0x41, 0x00, 0x3D, 0xD8, 0x00, 0xDE], "A😀", "utf16le")
  // UTF-16BE: BOM + "A" + U+1F600 (D83D DE00)
  assert_decode_both(Encoding::Utf16Be, [0xFE, 0xFF, 0x00, 0x41, 0xD8, 0x3D, 0xDE, 0x00], "A😀", "utf16be")
  // Lone high surrogate followed by 'A'
  assert_decode_both(Encoding::Utf16Le, [0x00, 0xD8, 0x41, 0x00], "\u{FFFD}A", "utf16le lone high")
  // Lone low surrogate
  assert_decode_both(Encoding::Utf16Le, [0x00, 0xDC, 0x41, 0x00], "\u{FFFD}A", "utf16le lone low")
  // Trailing odd byte
  assert_decode_both(Encoding::Utf16Le, [0x41, 0x00, 0x42], "A\u{FFFD}", "utf16le odd")
}

test "single-byte: windows-1252, koi8-r, windows-1255, x-user-defined, replacement" {
  assert_decode_both(Encoding::Windows1252, [0x80, 0x81, 0x82, 0xE9], "€\u{0081}‚é", "w1252")
  assert_decode_both(Encoding::Koi8R, [0xF0, 0xD2, 0xC9, 0xD7, 0xC5, 0xD4], "Привет", "koi8r")
  assert_decode_both(Encoding::Windows1255, [0xD9, 0xE0], "\u{FFFD}א", "w1255")
  assert_decode_both(Encoding::XUserDefined, [0x41, 0x80, 0xFF], "A\u{F780}\u{F7FF}", "x-user-defined")
  assert_decode_both(Encoding::Replacement, [0x41, 0x42, 0x43], "\u{FFFD}", "replacement")
  assert_decode_both(Encoding::Replacement, [], "", "replacement empty")
}

test "cjk: GBK, GB18030, Shift_JIS, EUC-JP, Big5, EUC-KR, ISO-2022-JP" {
  // GBK / GB18030: "中" (D6 D0), "€" (80), 4-byte U+1F600 (94 39 FC 36), pointer 7457 U+E7C7 (81 35 F4 37)
  assert_decode_both(Encoding::Gbk, [0xD6, 0xD0, 0x80], "中€", "gbk")
  assert_decode_both(Encoding::Gb18030, [0xD6, 0xD0, 0x80, 0x94, 0x39, 0xFC, 0x36, 0x81, 0x35, 0xF4, 0x37], "中€😀\u{E7C7}", "gb18030")
  // Shift_JIS: "あ" (82 A0), half-width "ｱ" (B1), 0x80 -> U+0080
  assert_decode_both(Encoding::ShiftJis, [0x82, 0xA0, 0xB1, 0x80], "あｱ\u{0080}", "sjis")
  // EUC-JP: "あ" (A4 A2), half-width "ｱ" (8E B1)
  assert_decode_both(Encoding::EucJp, [0xA4, 0xA2, 0x8E, 0xB1], "あｱ", "eucjp")
  // Big5: "中" (A4 A4) + 4 double-codepoint pointers (1133=88 62, 1135=88 64, 1164=88 A3, 1166=88 A5)
  assert_decode_both(Encoding::Big5, [0xA4, 0xA4, 0x88, 0x62, 0x88, 0x64, 0x88, 0xA3, 0x88, 0xA5], "中\u{00CA}\u{0304}\u{00CA}\u{030C}\u{00EA}\u{0304}\u{00EA}\u{030C}", "big5")
  // EUC-KR: "한글" (C7 D1 B1 DB)
  assert_decode_both(Encoding::EucKr, [0xC7, 0xD1, 0xB1, 0xDB], "한글", "euckr")
  // ISO-2022-JP: ESC $ B 24 22 ESC ( B "A" -> "あA"
  assert_decode_both(Encoding::Iso2022Jp, [0x1B, 0x24, 0x42, 0x24, 0x22, 0x1B, 0x28, 0x42, 0x41], "あA", "iso2022jp")
}

test "encode: UTF-8, UTF-16LE/BE, single-byte, CJK, HTML NCR fallback" {
  assert_true(bytes_eq(encode_utf8("Hi中"), mk_bytes([0x48, 0x69, 0xE4, 0xB8, 0xAD])))
  assert_true(bytes_eq(encode_utf16le("A😀"), mk_bytes([0x41, 0x00, 0x3D, 0xD8, 0x00, 0xDE])))
  assert_true(bytes_eq(encode_utf16be("A😀"), mk_bytes([0x00, 0x41, 0xD8, 0x3D, 0xDE, 0x00])))
  match encode(Encoding::Windows1252, "€é") {
    Ok(b) => assert_true(bytes_eq(b, mk_bytes([0x80, 0xE9])))
    Err(_) => assert_true(false)
  }
  match encode(Encoding::Windows1252, "中") {
    Err(EncodeError::UnmappableCodePoint(cp, _)) => assert_eq_int(cp, 0x4E2D)
    _ => assert_true(false)
  }
  let (html_b, unmappable) = encode_html(Encoding::Windows1252, "A中B")
  assert_true(unmappable)
  assert_eq_str(html_b.to_string(), "A&#20013;B")
  match encode(Encoding::Gb18030, "中😀") {
    Ok(b) => assert_true(bytes_eq(b, mk_bytes([0xD6, 0xD0, 0x94, 0x39, 0xFC, 0x36])))
    Err(_) => assert_true(false)
  }
}

test "bom_sniffing, decoder_reset, and fatal_mode across encodings" {
  // decode_with_bom_sniffing overrides declared encoding when BOM is present
  let (s1, e1, err1) = decode_with_bom_sniffing(Encoding::Windows1252, mk_bytes([0xEF, 0xBB, 0xBF, 0xE4, 0xB8, 0xAD]))
  assert_eq_str(s1, "中")
  assert_eq_str(e1.name(), "UTF-8")
  assert_true(!err1)

  let (s2, e2, err2) = decode_with_bom_sniffing(Encoding::Utf8, mk_bytes([0xFE, 0xFF, 0x00, 0x41]))
  assert_eq_str(s2, "A")
  assert_eq_str(e2.name(), "UTF-16BE")
  assert_true(!err2)

  // Decoder::reset clears state & had_errors
  let dec = Decoder::new(Encoding::Utf8)
  match dec.decode_chunk(mk_bytes([0xFF]), true) {
    Ok(s) => assert_eq_str(s, "\u{FFFD}")
    Err(_) => assert_true(false)
  }
  assert_true(dec.had_errors())
  dec.reset()
  assert_true(!dec.had_errors())
  match dec.decode_chunk(mk_bytes([0x41]), true) {
    Ok(s) => assert_eq_str(s, "A")
    Err(_) => assert_true(false)
  }
  assert_true(!dec.had_errors())

  // Fatal mode errors on single-byte, CJK, replacement, ISO-2022-JP
  let fatal_opts = DecodeOptions::new(true, false)
  match decode_with_options(Encoding::Windows1255, mk_bytes([0xD9]), fatal_opts) {
    Err(DecodeError::MalformedSequence(_)) => ()
    _ => assert_true(false)
  }
  match decode_with_options(Encoding::Replacement, mk_bytes([0x41]), fatal_opts) {
    Err(DecodeError::ReplacementEncoding) => ()
    _ => assert_true(false)
  }
  match decode_with_options(Encoding::Gb18030, mk_bytes([0x81, 0x30]), fatal_opts) {
    Err(DecodeError::TruncatedSequence(_)) => ()
    _ => assert_true(false)
  }
  match decode_with_options(Encoding::ShiftJis, mk_bytes([0x82, 0x20]), fatal_opts) {
    Err(DecodeError::MalformedSequence(_)) => ()
    _ => assert_true(false)
  }
  match decode_with_options(Encoding::Big5, mk_bytes([0x81]), fatal_opts) {
    Err(DecodeError::TruncatedSequence(_)) => ()
    _ => assert_true(false)
  }
}

test "cjk edge cases: GB18030 recovery, EUC-JP JIS0212, Big5 astral, ISO-2022-JP escapes" {
  // GB18030 invalid 3rd/4th byte unread & EOF single replacement
  assert_decode_both(Encoding::Gb18030, [0x81, 0x30], "\u{FFFD}", "gb18030 eof 2b")
  assert_decode_both(Encoding::Gb18030, [0x81, 0x30, 0x81], "\u{FFFD}", "gb18030 eof 3b")
  assert_decode_both(Encoding::Gb18030, [0x81, 0x30, 0x41], "\u{FFFD}0A", "gb18030 bad 3rd")
  assert_decode_both(Encoding::Gb18030, [0x81, 0x30, 0xD6, 0xD0], "\u{FFFD}0中", "gb18030 bad 4th reprocess")
  // EUC-JP JIS0212 3-byte (0x8F 0xB0 0xA1 -> U+4E02)
  assert_decode_both(Encoding::EucJp, [0x8F, 0xB0, 0xA1], "\u{4E02}", "eucjp jis0212")
  // Big5 Plane 2 astral (0x87 0x40 -> U+2008A? Let's verify 0x88 0x62 + round-trip via encode)
  match encode(Encoding::Big5, "\u{200CC}") {
    Ok(b) => assert_eq_str(decode(Encoding::Big5, b), "\u{200CC}")
    Err(_) => assert_true(false)
  }
  // ISO-2022-JP Roman, Katakana, invalid escape recovery
  assert_decode_both(Encoding::Iso2022Jp, [0x1B, 0x28, 0x4A, 0x5C, 0x7E, 0x1B, 0x28, 0x42, 0x5C], "¥‾\\", "iso2022jp roman")
  assert_decode_both(Encoding::Iso2022Jp, [0x1B, 0x28, 0x58], "\u{FFFD}(X", "iso2022jp bad esc")
  // GB18030-2022 PUA override: U+E78D encodes to 0xA6 0xD9, which decodes to U+FE10 per GB18030-2022
  match encode(Encoding::Gb18030, "\u{E78D}") {
    Ok(b) => {
      assert_true(bytes_eq(b, mk_bytes([0xA6, 0xD9])))
      assert_eq_str(decode(Encoding::Gb18030, b), "\u{FE10}")
    }
    Err(_) => assert_true(false)
  }
}
