///| Comprehensive WHATWG Encoding Standard compliance & streaming test suite.

fn assert_true(cond : Bool) -> Unit {
  debug_assert(cond, "expected true")
}

fn assert_eq_str(a : String, b : String) -> Unit {
  debug_assert(a == b, "string mismatch: got '" + a + "', expected '" + b + "'")
}

fn assert_eq_int(a : Int, b : Int) -> Unit {
  debug_assert(a == b, "int mismatch: got " + a.to_string() + ", expected " + b.to_string())
}

fn mk_bytes(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn decode_1byte_streaming(enc : Encoding, data : Bytes, opts : DecodeOptions) -> Result[String, DecodeError] {
  let dec = Decoder::with_options(enc, opts)
  let sb = StringBuilder::new()
  let n = data.length()
  let mut i = 0
  while i < n {
    let chunk = data.slice(i, i + 1)
    match dec.decode_chunk(chunk, false) {
      Ok(s) => sb.write_string(s)
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  match dec.decode_chunk(Bytes::new(0), true) {
    Ok(s) => {
      sb.write_string(s)
      Ok(sb.to_string())
    }
    Err(e) => Err(e)
  }
}

fn assert_decode_both(enc : Encoding, raw : Array[Int], expected : String, msg : String) -> Unit {
  let b = mk_bytes(raw)
  let whole = decode(enc, b)
  assert_eq_str(whole, expected)
  let streamed = match decode_1byte_streaming(enc, b, DecodeOptions::default()) {
    Ok(s) => s
    Err(e) => {
      assert_true(false)
      e.to_string()
    }
  }
  let _ = msg
  assert_eq_str(streamed, expected)
}

test "labels: core WHATWG aliases, case-insensitivity, whitespace" {
  match Encoding::for_label("utf-8") {
    Some(e) => assert_eq_str(e.name(), "UTF-8")
    None => assert_true(false)
  }
  match Encoding::for_label("  \t\r\nUTF8\n ") {
    Some(e) => assert_eq_str(e.name(), "UTF-8")
    None => assert_true(false)
  }
  match Encoding::for_label("unicode-1-1-utf-8") {
    Some(e) => assert_eq_str(e.name(), "UTF-8")
    None => assert_true(false)
  }
  match Encoding::for_label("utf-16") {
    Some(e) => assert_eq_str(e.name(), "UTF-16LE")
    None => assert_true(false)
  }
  match Encoding::for_label("UTF-16BE") {
    Some(e) => assert_eq_str(e.name(), "UTF-16BE")
    None => assert_true(false)
  }
  match Encoding::for_label("latin1") {
    Some(e) => assert_eq_str(e.name(), "windows-1252")
    None => assert_true(false)
  }
  match Encoding::for_label("ISO-8859-1") {
    Some(e) => assert_eq_str(e.name(), "windows-1252")
    None => assert_true(false)
  }
  match Encoding::for_label("us-ascii") {
    Some(e) => assert_eq_str(e.name(), "windows-1252")
    None => assert_true(false)
  }
  match Encoding::for_label("gb2312") {
    Some(e) => assert_eq_str(e.name(), "GBK")
    None => assert_true(false)
  }
  match Encoding::for_label("x-gbk") {
    Some(e) => assert_eq_str(e.name(), "GBK")
    None => assert_true(false)
  }
  match Encoding::for_label("gb18030") {
    Some(e) => assert_eq_str(e.name(), "gb18030")
    None => assert_true(false)
  }
  match Encoding::for_label("big5-hkscs") {
    Some(e) => assert_eq_str(e.name(), "Big5")
    None => assert_true(false)
  }
  match Encoding::for_label("windows-31j") {
    Some(e) => assert_eq_str(e.name(), "Shift_JIS")
    None => assert_true(false)
  }
  match Encoding::for_label("ms_kanji") {
    Some(e) => assert_eq_str(e.name(), "Shift_JIS")
    None => assert_true(false)
  }
  match Encoding::for_label("euc-jp") {
    Some(e) => assert_eq_str(e.name(), "EUC-JP")
    None => assert_true(false)
  }
  match Encoding::for_label("ks_c_5601-1987") {
    Some(e) => assert_eq_str(e.name(), "EUC-KR")
    None => assert_true(false)
  }
  match Encoding::for_label("iso-2022-jp") {
    Some(e) => assert_eq_str(e.name(), "ISO-2022-JP")
    None => assert_true(false)
  }
  match Encoding::for_label("iso-2022-kr") {
    Some(e) => assert_eq_str(e.name(), "replacement")
    None => assert_true(false)
  }
  match Encoding::for_label_no_replacement("iso-2022-kr") {
    None => ()
    Some(_) => assert_true(false)
  }
  match Encoding::for_label("not-an-encoding") {
    None => ()
    Some(_) => assert_true(false)
  }
  // Vertical tab U+000B is NOT WHATWG ASCII whitespace
  match Encoding::for_label("\x0Butf-8") {
    None => ()
    Some(_) => assert_true(false)
  }
}

test "bom: sniff_bom priority and boundaries" {
  match sniff_bom(mk_bytes([0xEF, 0xBB, 0xBF, 0x41])) {
    Some((e, n)) => {
      assert_eq_str(e.name(), "UTF-8")
      assert_eq_int(n, 3)
    }
    None => assert_true(false)
  }
  match sniff_bom(mk_bytes([0xFE, 0xFF, 0x00, 0x41])) {
    Some((e, n)) => {
      assert_eq_str(e.name(), "UTF-16BE")
      assert_eq_int(n, 2)
    }
    None => assert_true(false)
  }
  match sniff_bom(mk_bytes([0xFF, 0xFE, 0x41, 0x00])) {
    Some((e, n)) => {
      assert_eq_str(e.name(), "UTF-16LE")
      assert_eq_int(n, 2)
    }
    None => assert_true(false)
  }
  match sniff_bom(mk_bytes([0xEF, 0xBB])) {
    None => ()
    Some(_) => assert_true(false)
  }
  match sniff_bom(Bytes::new(0)) {
    None => ()
    Some(_) => assert_true(false)
  }
}

test "utf8: valid, BOM, overlong, surrogates, maximal subpart, streaming" {
  assert_decode_both(Encoding::Utf8, [0x48, 0x69, 0x20, 0xE4, 0xB8, 0xAD, 0xF0, 0x9F, 0x98, 0x80], "Hi 中😀", "utf8 valid")
  // BOM stripped by default
  assert_decode_both(Encoding::Utf8, [0xEF, 0xBB, 0xBF, 0x41], "A", "utf8 bom strip")
  // ignore_bom = true preserves U+FEFF
  let b_bom = mk_bytes([0xEF, 0xBB, 0xBF, 0x41])
  match decode_with_options(Encoding::Utf8, b_bom, DecodeOptions::new(false, true)) {
    Ok(s) => assert_eq_str(s, "\u{FEFF}A")
    Err(_) => assert_true(false)
  }
  // Overlong 2-byte NUL C0 80 -> 2 replacements
  assert_decode_both(Encoding::Utf8, [0xC0, 0x80], "\u{FFFD}\u{FFFD}", "overlong 2")
  // Surrogate U+D800: ED A0 80 -> 3 replacements
  assert_decode_both(Encoding::Utf8, [0xED, 0xA0, 0x80], "\u{FFFD}\u{FFFD}\u{FFFD}", "surrogate")
  // > U+10FFFF: F4 90 80 80 -> 4 replacements
  assert_decode_both(Encoding::Utf8, [0xF4, 0x90, 0x80, 0x80], "\u{FFFD}\u{FFFD}\u{FFFD}\u{FFFD}", "above max")
  // Truncated 3-byte valid prefix E4 B8 followed by 'A' -> 1 replacement + 'A'
  assert_decode_both(Encoding::Utf8, [0xE4, 0xB8, 0x41], "\u{FFFD}A", "maximal subpart")
  // Fatal mode rejects malformed & truncated
  match decode_with_options(Encoding::Utf8, mk_bytes([0xFF]), DecodeOptions::new(true, false)) {
    Err(_) => ()
    Ok(_) => assert_true(false)
  }
  match decode_with_options(Encoding::Utf8, mk_bytes([0xE4, 0xB8]), DecodeOptions::new(true, false)) {
    Err(_) => ()
    Ok(_) => assert_true(false)
  }
}

test "utf16: LE & BE valid, surrogate pairs, lone surrogates, odd tail, streaming" {
  // UTF-16LE: BOM + "A" + U+1F600 (D83D DE00)
  assert_decode_both(Encoding::Utf16Le, [0xFF, 0xFE, 0x41, 0x00, 0x3D, 0xD8, 0x00, 0xDE], "A😀", "utf16le")
  // UTF-16BE: BOM + "A" + U+1F600 (D83D DE00)
  assert_decode_both(Encoding::Utf16Be, [0xFE, 0xFF, 0x00, 0x41, 0xD8, 0x3D, 0xDE, 0x00], "A😀", "utf16be")
  // Lone high surrogate followed by 'A'
  assert_decode_both(Encoding::Utf16Le, [0x00, 0xD8, 0x41, 0x00], "\u{FFFD}A", "utf16le lone high")
  // Lone low surrogate
  assert_decode_both(Encoding::Utf16Le, [0x00, 0xDC, 0x41, 0x00], "\u{FFFD}A", "utf16le lone low")
  // Trailing odd byte
  assert_decode_both(Encoding::Utf16Le, [0x41, 0x00, 0x42], "A\u{FFFD}", "utf16le odd")
}

test "single-byte: windows-1252, koi8-r, windows-1255, x-user-defined, replacement" {
  assert_decode_both(Encoding::Windows1252, [0x80, 0x81, 0x82, 0xE9], "€\u{0081}‚é", "w1252")
  assert_decode_both(Encoding::Koi8R, [0xF0, 0xD2, 0xC9, 0xD7, 0xC5, 0xD4], "Привет", "koi8r")
  assert_decode_both(Encoding::Windows1255, [0xD9, 0xE0], "\u{FFFD}א", "w1255")
  assert_decode_both(Encoding::XUserDefined, [0x41, 0x80, 0xFF], "A\u{F780}\u{F7FF}", "x-user-defined")
  assert_decode_both(Encoding::Replacement, [0x41, 0x42, 0x43], "\u{FFFD}", "replacement")
  assert_decode_both(Encoding::Replacement, [], "", "replacement empty")
}

test "cjk: GBK, GB18030, Shift_JIS, EUC-JP, Big5, EUC-KR, ISO-2022-JP" {
  // GBK / GB18030: "中" (D6 D0), "€" (80), 4-byte U+1F600 (94 39 FC 36), pointer 7457 U+E7C7 (81 35 F4 37)
  assert_decode_both(Encoding::Gbk, [0xD6, 0xD0, 0x80], "中€", "gbk")
  assert_decode_both(Encoding::Gb18030, [0xD6, 0xD0, 0x80, 0x94, 0x39, 0xFC, 0x36, 0x81, 0x35, 0xF4, 0x37], "中€😀\u{E7C7}", "gb18030")
  // Shift_JIS: "あ" (82 A0), half-width "ｱ" (B1), 0x80 -> U+0080
  assert_decode_both(Encoding::ShiftJis, [0x82, 0xA0, 0xB1, 0x80], "あｱ\u{0080}", "sjis")
  // EUC-JP: "あ" (A4 A2), half-width "ｱ" (8E B1)
  assert_decode_both(Encoding::EucJp, [0xA4, 0xA2, 0x8E, 0xB1], "あｱ", "eucjp")
  // Big5: "中" (A4 A4) + 4 double-codepoint pointers (1133=88 62, 1135=88 64, 1164=88 A3, 1166=88 A5)
  assert_decode_both(Encoding::Big5, [0xA4, 0xA4, 0x88, 0x62, 0x88, 0x64, 0x88, 0xA3, 0x88, 0xA5], "中\u{00CA}\u{0304}\u{00CA}\u{030C}\u{00EA}\u{0304}\u{00EA}\u{030C}", "big5")
  // EUC-KR: "한글" (C7 D1 B1 DB)
  assert_decode_both(Encoding::EucKr, [0xC7, 0xD1, 0xB1, 0xDB], "한글", "euckr")
  // ISO-2022-JP: ESC $ B 24 22 ESC ( B "A" -> "あA"
  assert_decode_both(Encoding::Iso2022Jp, [0x1B, 0x24, 0x42, 0x24, 0x22, 0x1B, 0x28, 0x42, 0x41], "あA", "iso2022jp")
}

test "encode: UTF-8, UTF-16LE/BE, single-byte, CJK, HTML NCR fallback" {
  assert_true(bytes_eq(encode_utf8("Hi中"), mk_bytes([0x48, 0x69, 0xE4, 0xB8, 0xAD])))
  assert_true(bytes_eq(encode_utf16le("A😀"), mk_bytes([0x41, 0x00, 0x3D, 0xD8, 0x00, 0xDE])))
  assert_true(bytes_eq(encode_utf16be("A😀"), mk_bytes([0x00, 0x41, 0xD8, 0x3D, 0xDE, 0x00])))
  match encode(Encoding::Windows1252, "€é") {
    Ok(b) => assert_true(bytes_eq(b, mk_bytes([0x80, 0xE9])))
    Err(_) => assert_true(false)
  }
  match encode(Encoding::Windows1252, "中") {
    Err(EncodeError::UnmappableCodePoint(cp, _)) => assert_eq_int(cp, 0x4E2D)
    _ => assert_true(false)
  }
  let (html_b, unmappable) = encode_html(Encoding::Windows1252, "A中B")
  assert_true(unmappable)
  assert_eq_str(html_b.to_string(), "A&#20013;B")
  match encode(Encoding::Gb18030, "中😀") {
    Ok(b) => assert_true(bytes_eq(b, mk_bytes([0xD6, 0xD0, 0x94, 0x39, 0xFC, 0x36])))
    Err(_) => assert_true(false)
  }
}

test "bom_sniffing, decoder_reset, and fatal_mode across encodings" {
  // decode_with_bom_sniffing overrides declared encoding when BOM is present
  let (s1, e1, err1) = decode_with_bom_sniffing(Encoding::Windows1252, mk_bytes([0xEF, 0xBB, 0xBF, 0xE4, 0xB8, 0xAD]))
  assert_eq_str(s1, "中")
  assert_eq_str(e1.name(), "UTF-8")
  assert_true(!err1)

  let (s2, e2, err2) = decode_with_bom_sniffing(Encoding::Utf8, mk_bytes([0xFE, 0xFF, 0x00, 0x41]))
  assert_eq_str(s2, "A")
  assert_eq_str(e2.name(), "UTF-16BE")
  assert_true(!err2)

  // Decoder::reset clears state & had_errors
  let dec = Decoder::new(Encoding::Utf8)
  match dec.decode_chunk(mk_bytes([0xFF]), true) {
    Ok(s) => assert_eq_str(s, "\u{FFFD}")
    Err(_) => assert_true(false)
  }
  assert_true(dec.had_errors())
  dec.reset()
  assert_true(!dec.had_errors())
  match dec.decode_chunk(mk_bytes([0x41]), true) {
    Ok(s) => assert_eq_str(s, "A")
    Err(_) => assert_true(false)
  }
  assert_true(!dec.had_errors())

  // Fatal mode errors on single-byte, CJK, replacement, ISO-2022-JP
  let fatal_opts = DecodeOptions::new(true, false)
  match decode_with_options(Encoding::Windows1255, mk_bytes([0xD9]), fatal_opts) {
    Err(DecodeError::MalformedSequence(_)) => ()
    _ => assert_true(false)
  }
  match decode_with_options(Encoding::Replacement, mk_bytes([0x41]), fatal_opts) {
    Err(DecodeError::ReplacementEncoding) => ()
    _ => assert_true(false)
  }
  match decode_with_options(Encoding::Gb18030, mk_bytes([0x81, 0x30]), fatal_opts) {
    Err(DecodeError::TruncatedSequence(_)) => ()
    _ => assert_true(false)
  }
  match decode_with_options(Encoding::ShiftJis, mk_bytes([0x82, 0x20]), fatal_opts) {
    Err(DecodeError::MalformedSequence(_)) => ()
    _ => assert_true(false)
  }
  match decode_with_options(Encoding::Big5, mk_bytes([0x81]), fatal_opts) {
    Err(DecodeError::TruncatedSequence(_)) => ()
    _ => assert_true(false)
  }
}

test "cjk edge cases: GB18030 recovery, EUC-JP JIS0212, Big5 astral, ISO-2022-JP escapes" {
  // GB18030 invalid 3rd/4th byte unread & EOF single replacement
  assert_decode_both(Encoding::Gb18030, [0x81, 0x30], "\u{FFFD}", "gb18030 eof 2b")
  assert_decode_both(Encoding::Gb18030, [0x81, 0x30, 0x81], "\u{FFFD}", "gb18030 eof 3b")
  assert_decode_both(Encoding::Gb18030, [0x81, 0x30, 0x41], "\u{FFFD}0A", "gb18030 bad 3rd")
  assert_decode_both(Encoding::Gb18030, [0x81, 0x30, 0xD6, 0xD0], "\u{FFFD}0中", "gb18030 bad 4th reprocess")
  // EUC-JP JIS0212 3-byte (0x8F 0xB0 0xA1 -> U+4E02)
  assert_decode_both(Encoding::EucJp, [0x8F, 0xB0, 0xA1], "\u{4E02}", "eucjp jis0212")
  // Big5 Plane 2 astral (0x87 0x40 -> U+2008A? Let's verify 0x88 0x62 + round-trip via encode)
  match encode(Encoding::Big5, "\u{200CC}") {
    Ok(b) => assert_eq_str(decode(Encoding::Big5, b), "\u{200CC}")
    Err(_) => assert_true(false)
  }
  // ISO-2022-JP Roman, Katakana, invalid escape recovery
  assert_decode_both(Encoding::Iso2022Jp, [0x1B, 0x28, 0x4A, 0x5C, 0x7E, 0x1B, 0x28, 0x42, 0x5C], "¥‾\\", "iso2022jp roman")
  assert_decode_both(Encoding::Iso2022Jp, [0x1B, 0x28, 0x58], "\u{FFFD}(X", "iso2022jp bad esc")
  // GB18030-2022 PUA override: U+E78D encodes to 0xA6 0xD9, which decodes to U+FE10 per GB18030-2022
  match encode(Encoding::Gb18030, "\u{E78D}") {
    Ok(b) => {
      assert_true(bytes_eq(b, mk_bytes([0xA6, 0xD9])))
      assert_eq_str(decode(Encoding::Gb18030, b), "\u{FE10}")
    }
    Err(_) => assert_true(false)
  }
}

// ============================================================================
// Extended WHATWG Encoding Standard, encoding_rs & WPT Compliance Tests

fn ok_str(r : Result[String, DecodeError]) -> String {
  match r {
    Ok(v) => v
    Err(_) => {
      assert_true(false)
      ""
    }
  }
}

fn ok_bytes(r : Result[Bytes, EncodeError]) -> Bytes {
  match r {
    Ok(v) => v
    Err(_) => {
      assert_true(false)
      Bytes::new(0)
    }
  }
}

// ============================================================================

test "labels: all 6 replacement labels and for_label_no_replacement" {
  let reps = ["csiso2022kr", "hz-gb-2312", "iso-2022-cn", "iso-2022-cn-ext", "iso-2022-kr", "replacement"]
  let mut i = 0
  while i < reps.length() {
    match Encoding::for_label(" \t" + reps[i] + "\r\n") {
      Some(e) => assert_eq_str(e.name(), "replacement")
      None => assert_true(false)
    }
    match Encoding::for_label_no_replacement(reps[i]) {
      None => ()
      Some(_) => assert_true(false)
    }
    i = i + 1
  }
}

test "labels: non-ASCII whitespace and Unicode case-folding traps rejected" {
  let bad = [
    "", "   ", "\x0Butf-8", "utf-8\x0B", "\u{00A0}utf-8", "utf-8\u{00A0}",
    "\u{3000}utf-8", "\u{0085}utf-8", "\u{212A}oi8-r", "utf 8", "utf-8\x00",
    "utf-7", "utf-32", "unicode-1-1-utf-7",
  ]
  let mut i = 0
  while i < bad.length() {
    match Encoding::for_label(bad[i]) {
      None => ()
      Some(_) => assert_true(false)
    }
    i = i + 1
  }
}

test "labels: metadata methods id, equals, is_single_byte, is_ascii_compatible, output_encoding" {
  assert_true(Encoding::Utf8.equals(Encoding::Utf8))
  assert_true(!Encoding::Utf8.equals(Encoding::Gbk))
  assert_true(Encoding::Windows1252.is_single_byte())
  assert_true(Encoding::XUserDefined.is_single_byte())
  assert_true(!Encoding::Utf8.is_single_byte())
  assert_true(!Encoding::Gb18030.is_single_byte())
  assert_true(Encoding::Utf8.is_ascii_compatible())
  assert_true(Encoding::ShiftJis.is_ascii_compatible())
  assert_true(!Encoding::Utf16Le.is_ascii_compatible())
  assert_true(!Encoding::Utf16Be.is_ascii_compatible())
  assert_true(!Encoding::Iso2022Jp.is_ascii_compatible())
  assert_true(!Encoding::Replacement.is_ascii_compatible())
  assert_eq_str(Encoding::Utf16Le.output_encoding().name(), "UTF-8")
  assert_eq_str(Encoding::Utf16Be.output_encoding().name(), "UTF-8")
  assert_eq_str(Encoding::Replacement.output_encoding().name(), "UTF-8")
  assert_eq_str(Encoding::Big5.output_encoding().name(), "Big5")
}

test "utf8: split BOM with empty chunks and fake BOM look-alikes" {
  let d = Decoder::new(Encoding::Utf8)
  assert_eq_str(ok_str(d.decode_chunk(mk_bytes([0xEF]), false)), "")
  assert_eq_str(ok_str(d.decode_chunk(Bytes::new(0), false)), "")
  assert_eq_str(ok_str(d.decode_chunk(mk_bytes([0xBB]), false)), "")
  assert_eq_str(ok_str(d.decode_chunk(mk_bytes([0xBF, 0x41]), true)), "A")
  assert_true(!d.had_errors())
  // Reuse strips BOM again
  assert_eq_str(ok_str(d.decode_chunk(mk_bytes([0xEF, 0xBB, 0xBF, 0x42]), true)), "B")
  assert_true(!d.had_errors())
  // Fake BOM EF BB 00 -> U+FFFD + NUL
  assert_decode_both(Encoding::Utf8, [0xEF, 0xBB, 0x00, 0x41], "\u{FFFD}\x00A", "fake bom 00")
  // Non-BOM starting with EF BC 80 -> U+FF00
  assert_decode_both(Encoding::Utf8, [0xEF, 0xBC, 0x80], "\u{FF00}", "ef bc 80")
  // Truncated EF BB at EOF
  assert_decode_both(Encoding::Utf8, [0xEF, 0xBB], "\u{FFFD}", "ef bb eof")
}

test "utf8: 4-byte boundaries and maximal subpart combinations" {
  // U+10000 (F0 90 80 80) and U+10FFFF (F4 8F BF BF)
  assert_decode_both(Encoding::Utf8, [0xF0, 0x90, 0x80, 0x80], "\u{10000}", "min 4-byte")
  assert_decode_both(Encoding::Utf8, [0xF4, 0x8F, 0xBF, 0xBF], "\u{10FFFF}", "max 4-byte")
  // Overlong 4-byte F0 80 80 80 -> 4 replacements
  assert_decode_both(Encoding::Utf8, [0xF0, 0x80, 0x80, 0x80], "\u{FFFD}\u{FFFD}\u{FFFD}\u{FFFD}", "overlong 4")
  // Truncated 4-byte valid 3-byte prefix F0 9F 98 followed by 'Z' -> 1 replacement + 'Z'
  assert_decode_both(Encoding::Utf8, [0xF0, 0x9F, 0x98, 0x5A], "\u{FFFD}Z", "4-byte maximal subpart")
  // Overlong 3-byte E0 9F BF -> 3 replacements
  assert_decode_both(Encoding::Utf8, [0xE0, 0x9F, 0xBF], "\u{FFFD}\u{FFFD}\u{FFFD}", "overlong 3")
}

test "utf16: split BOM, ignore_bom, swapped BOM, consecutive surrogates" {
  // ignore_bom preserves U+FEFF
  let b_le = mk_bytes([0xFF, 0xFE, 0x41, 0x00])
  assert_eq_str(ok_str(decode_with_options(Encoding::Utf16Le, b_le, DecodeOptions::new(false, true))), "\u{FEFF}A")
  // Swapped BOM in UTF-16BE is U+FFFE (not stripped)
  assert_decode_both(Encoding::Utf16Be, [0xFF, 0xFE, 0x00, 0x41], "\u{FFFE}A", "utf16be swapped bom")
  // Two high surrogates followed by low surrogate -> U+FFFD + astral
  assert_decode_both(Encoding::Utf16Be, [0xD8, 0x00, 0xD8, 0x3D, 0xDE, 0x00], "\u{FFFD}😀", "double high")
  // High surrogate at EOF
  assert_decode_both(Encoding::Utf16Be, [0xD8, 0x00], "\u{FFFD}", "high eof")
  // Low surrogate then high surrogate at EOF -> two replacements
  assert_decode_both(Encoding::Utf16Be, [0xDC, 0x00, 0xD8, 0x00], "\u{FFFD}\u{FFFD}", "low then high eof")
}

test "single-byte: ISO-8859 family, IBM866, macintosh, windows-874/1250..1258" {
  assert_decode_both(Encoding::Ibm866, [0x80, 0xFF], "\u{0410}\u{00A0}", "ibm866")
  assert_decode_both(Encoding::Iso8859_2, [0xA1, 0xFF], "\u{0104}\u{02D9}", "iso8859-2")
  assert_decode_both(Encoding::Iso8859_7, [0xE1, 0xFF], "\u{03B1}\u{FFFD}", "iso8859-7")
  assert_decode_both(Encoding::Iso8859_8I, [0xE0, 0xFF], "\u{05D0}\u{FFFD}", "iso8859-8i")
  assert_decode_both(Encoding::Iso8859_15, [0xA4, 0xBD], "€œ", "iso8859-15")
  assert_decode_both(Encoding::Koi8U, [0xA4, 0xB4], "\u{0454}\u{0404}", "koi8-u")
  assert_decode_both(Encoding::Macintosh, [0x80, 0xDB], "Ä€", "macintosh")
  assert_decode_both(Encoding::Windows874, [0x80, 0xA1], "€\u{0E01}", "windows-874")
  assert_decode_both(Encoding::Windows1251, [0xC0, 0xFF], "Ая", "windows-1251")
  assert_decode_both(Encoding::Windows1256, [0x80, 0xC7], "€ا", "windows-1256")
  assert_decode_both(Encoding::Windows1258, [0x80, 0xCC], "€\u{0300}", "windows-1258")
  assert_decode_both(Encoding::XMacCyrillic, [0x80, 0xFF], "А€", "x-mac-cyrillic")
}

test "single-byte: encode strict and HTML NCR for unmappable CJK" {
  match encode(Encoding::Windows1252, "Café €") {
    Ok(b) => assert_eq_str(decode(Encoding::Windows1252, b), "Café €")
    Err(_) => assert_true(false)
  }
  let (b1, u1) = encode_html(Encoding::Iso8859_2, "A中B")
  assert_true(u1)
  assert_eq_str(b1.to_string(), "A&#20013;B")
  match encode(Encoding::XUserDefined, "\u{F780}\u{F7FF}") {
    Ok(b) => assert_true(bytes_eq(b, mk_bytes([0x80, 0xFF])))
    Err(_) => assert_true(false)
  }
  let (b2, u2) = encode_html(Encoding::XUserDefined, "\u{0080}")
  assert_true(u2)
  assert_eq_str(b2.to_string(), "&#128;")
}

test "replacement: streaming 1-byte non-empty emits single U+FFFD, empty emits empty" {
  let d = Decoder::new(Encoding::Replacement)
  assert_eq_str(ok_str(d.decode_chunk(Bytes::new(0), false)), "")
  assert_true(!d.had_errors())
  assert_eq_str(ok_str(d.decode_chunk(mk_bytes([0x41]), false)), "\u{FFFD}")
  assert_true(d.had_errors())
  assert_eq_str(ok_str(d.decode_chunk(mk_bytes([0x42]), false)), "")
  assert_eq_str(ok_str(d.decode_chunk(mk_bytes([0x43]), true)), "")
  assert_true(d.had_errors())
}

test "gb18030: 4-byte BMP and astral boundary pointers" {
  // 81 30 81 30 -> U+0080 (ptr 0)
  assert_decode_both(Encoding::Gb18030, [0x81, 0x30, 0x81, 0x30], "\u{0080}", "ptr 0")
  // E3 32 9A 35 -> U+10FFFF (ptr 1237575)
  assert_decode_both(Encoding::Gb18030, [0xE3, 0x32, 0x9A, 0x35], "\u{10FFFF}", "max astral")
  // E3 32 9A 36 -> out of range (ptr 1237576)
  assert_decode_both(Encoding::Gb18030, [0xE3, 0x32, 0x9A, 0x36], "\u{FFFD}", "past max astral")
  // 84 31 A4 39 -> U+FFFF (ptr 39419), 84 31 A5 30 -> out of range (ptr 39420)
  assert_decode_both(Encoding::Gb18030, [0x84, 0x31, 0xA4, 0x39], "\u{FFFF}", "u+ffff")
  assert_decode_both(Encoding::Gb18030, [0x84, 0x31, 0xA5, 0x30], "\u{FFFD}", "ptr 39420")
  // 90 30 81 30 -> U+10000 (ptr 189000)
  assert_decode_both(Encoding::Gb18030, [0x90, 0x30, 0x81, 0x30], "\u{10000}", "u+10000")
}

test "gb18030: GB18030-2022 PUA overrides and GBK euro difference" {
  // GB18030-2022: A6 D9 -> U+FE10, FE 51 -> U+E816, 84 31 82 36 -> U+FE10
  assert_decode_both(Encoding::Gb18030, [0xA6, 0xD9], "\u{FE10}", "2022 a6d9")
  assert_decode_both(Encoding::Gb18030, [0xFE, 0x51], "\u{E816}", "2022 fe51")
  assert_decode_both(Encoding::Gb18030, [0x84, 0x31, 0x82, 0x36], "\u{FE10}", "2022 4byte")
  // GBK encodes U+20AC as 0x80; gb18030 encodes U+20AC as 0xA2 0xE3
  assert_true(bytes_eq(ok_bytes(encode(Encoding::Gbk, "€")), mk_bytes([0x80])))
  assert_true(bytes_eq(ok_bytes(encode(Encoding::Gb18030, "€")), mk_bytes([0xA2, 0xE3])))
  // U+E5E5 is unmappable in both GBK and gb18030
  match encode(Encoding::Gb18030, "\u{E5E5}") {
    Err(EncodeError::UnmappableCodePoint(cp, _)) => assert_eq_int(cp, 0xE5E5)
    _ => assert_true(false)
  }
}

test "gb18030: encode hanzi L1, L2, GBK top/left ideographs, non-unified" {
  let samples = ["中", "国", "龍", "龘", "€", "一", "龥", "\u{E7C7}", "\u{10FFFF}"]
  let mut i = 0
  while i < samples.length() {
    let b = ok_bytes(encode(Encoding::Gb18030, samples[i]))
    assert_eq_str(decode(Encoding::Gb18030, b), samples[i])
    i = i + 1
  }
}

test "big5: trail restore rules, duplicate encoding preference, astral Plane 2" {
  // Unmapped pointer with ASCII trail (< 0x80) restores trail; >= 0x80 swallows trail
  assert_decode_both(Encoding::Big5, [0x87, 0x55, 0x7F], "\u{4C57}\x7F", "big5 ascii trail")
  assert_decode_both(Encoding::Big5, [0x87, 0x55, 0x80], "\u{4C57}\u{FFFD}", "big5 high trail")
  assert_decode_both(Encoding::Big5, [0x81, 0x20], "\u{FFFD} ", "big5 bad ascii trail")
  assert_decode_both(Encoding::Big5, [0x81, 0x80], "\u{FFFD}", "big5 bad high trail")
  // WHATWG Big5 encoder preference for U+2550 (box drawing) -> F9 F9
  assert_true(bytes_eq(ok_bytes(encode(Encoding::Big5, "\u{2550}")), mk_bytes([0xF9, 0xF9])))
  // Plane 2 astral round-trip
  let astrals = ["\u{200CC}", "\u{2008A}", "\u{27607}"]
  let mut i = 0
  while i < astrals.length() {
    let b = ok_bytes(encode(Encoding::Big5, astrals[i]))
    assert_eq_str(decode(Encoding::Big5, b), astrals[i])
    i = i + 1
  }
  // Unmappable Hangul/Latin/Emoji -> HTML NCR
  let (hb, unm) = encode_html(Encoding::Big5, "é한😀")
  assert_true(unm)
  assert_eq_str(hb.to_string(), "&#233;&#54620;&#128512;")
}

test "shift_jis: decode and encode Hiragana, Katakana, Kanji, Yen, Overline, Minus, EUDC" {
  // Decode EUDC pointer 8836 -> U+E000 (F0 40)
  assert_decode_both(Encoding::ShiftJis, [0xF0, 0x40], "\u{E000}", "sjis eudc")
  // Decode invalid bytes A0, FD, FE, FF
  assert_decode_both(Encoding::ShiftJis, [0xA0, 0xFD, 0xFE, 0xFF], "\u{FFFD}\u{FFFD}\u{FFFD}\u{FFFD}", "sjis invalid")
  // Encode Yen, Overline, Minus, half-width Katakana, Kanji
  assert_true(bytes_eq(ok_bytes(encode(Encoding::ShiftJis, "¥‾−")), mk_bytes([0x5C, 0x7E, 0x81, 0x7C])))
  let s = "日本語シフトJISｱｲｳ中龍仝"
  let b = ok_bytes(encode(Encoding::ShiftJis, s))
  assert_eq_str(decode(Encoding::ShiftJis, b), s)
}

test "euc_jp: JIS0208, 0x8E katakana, 0x8F JIS0212 3-byte, error recovery" {
  // 8E + ASCII restores ASCII
  assert_decode_both(Encoding::EucJp, [0x8E, 0x41], "\u{FFFD}A", "eucjp 8e ascii")
  // 8F + invalid lead / unmapped JIS0212
  assert_decode_both(Encoding::EucJp, [0x8F, 0xA1, 0xA1], "\u{FFFD}", "eucjp 8f unmapped")
  assert_decode_both(Encoding::EucJp, [0x8F, 0xB0, 0xA1, 0x41], "\u{4E02}A", "eucjp jis0212")
  assert_decode_both(Encoding::EucJp, [0x8F, 0x41], "\u{FFFD}A", "eucjp 8f ascii")
  // Encode round-trip
  let s = "あいうカタカナｱｲｳ日本語仝"
  let b = ok_bytes(encode(Encoding::EucJp, s))
  assert_eq_str(decode(Encoding::EucJp, b), s)
}

test "euc_kr: KS X 1001 Hangul, Hanja, symbols, and CP949 extensions" {
  // CP949 top Hangul (81 41 -> U+AC02)
  assert_decode_both(Encoding::EucKr, [0x81, 0x41], "\u{AC02}", "cp949 top")
  // Error restore ASCII trail vs swallow >= 0x80
  assert_decode_both(Encoding::EucKr, [0x81, 0x5B], "\u{FFFD}[", "euckr ascii restore")
  assert_decode_both(Encoding::EucKr, [0x81, 0x80], "\u{FFFD}", "euckr high swallow")
  // Encode round-trip Hangul + Hanja + CP949
  let s = "한글測試中龍\u{AC02}"
  let b = ok_bytes(encode(Encoding::EucKr, s))
  assert_eq_str(decode(Encoding::EucKr, b), s)
}

test "iso2022_jp: decoder escape state machine, SO/SI, consecutive escapes, EOF" {
  // Consecutive escapes ESC ( B ESC ( B -> output_flag error
  assert_decode_both(Encoding::Iso2022Jp, [0x1B, 0x28, 0x42, 0x1B, 0x28, 0x42], "\u{FFFD}", "double esc")
  // SO / SI (0x0E / 0x0F) are errors in ASCII/Roman
  assert_decode_both(Encoding::Iso2022Jp, [0x0E, 0x41, 0x0F], "\u{FFFD}A\u{FFFD}", "so si")
  // Katakana mode ESC ( I
  assert_decode_both(Encoding::Iso2022Jp, [0x1B, 0x28, 0x49, 0x21, 0x5C], "｡ﾜ", "katakana")
  // Invalid escape ESC $ A replays '$' and 'A'
  assert_decode_both(Encoding::Iso2022Jp, [0x1B, 0x24, 0x41], "\u{FFFD}$A", "bad esc $A")
  // Truncated ESC $ at EOF replays '$'
  assert_decode_both(Encoding::Iso2022Jp, [0x1B, 0x24], "\u{FFFD}$", "eof esc $")
  // Truncated ESC at EOF
  assert_decode_both(Encoding::Iso2022Jp, [0x1B], "\u{FFFD}", "eof esc")
}

test "redteam P2-1: ISO-2022-JP encode_html stays in Roman state before NCR and SO/SI/ESC" {
  // ¥😀: must emit ESC(J \ &#128512; ESC(B (NOT ESC(J \ ESC(B &#128512;)
  let (b1, u1) = encode_html(Encoding::Iso2022Jp, "¥😀")
  assert_true(u1)
  assert_true(bytes_eq(b1, mk_bytes([0x1B, 0x28, 0x4A, 0x5C, 0x26, 0x23, 0x31, 0x32, 0x38, 0x35, 0x31, 0x32, 0x3B, 0x1B, 0x28, 0x42])))
  // ¥ + 0x0E + A: stays in Roman state for &#65533; and 'A', returns to ASCII at EOF
  let (b2, u2) = encode_html(Encoding::Iso2022Jp, "¥\x0EA")
  assert_true(u2)
  assert_true(bytes_eq(b2, mk_bytes([0x1B, 0x28, 0x4A, 0x5C, 0x26, 0x23, 0x36, 0x35, 0x35, 0x33, 0x33, 0x3B, 0x41, 0x1B, 0x28, 0x42])))
  // In jis0208 state, unmappable MUST switch back to ASCII before NCR
  let (b3, u3) = encode_html(Encoding::Iso2022Jp, "あ\x0E")
  assert_true(u3)
  assert_true(bytes_eq(b3, mk_bytes([0x1B, 0x24, 0x42, 0x24, 0x22, 0x1B, 0x28, 0x42, 0x26, 0x23, 0x36, 0x35, 0x35, 0x33, 0x33, 0x3B])))
}

test "redteam P2-2: Decoder::had_errors preserved after last=true and reset on next stream" {
  let d1 = Decoder::new(Encoding::Utf8)
  assert_eq_str(ok_str(d1.decode_chunk(mk_bytes([0xFF]), false)), "\u{FFFD}")
  assert_true(d1.had_errors())
  assert_eq_str(ok_str(d1.decode_chunk(mk_bytes([0x41]), true)), "A")
  assert_true(d1.had_errors())
  // Starting a new stream without explicit reset clears had_errors for the new stream
  assert_eq_str(ok_str(d1.decode_chunk(mk_bytes([0x42]), true)), "B")
  assert_true(!d1.had_errors())

  let d2 = Decoder::new(Encoding::Gb18030)
  assert_eq_str(ok_str(d2.decode_chunk(mk_bytes([0xFF]), false)), "\u{FFFD}")
  assert_eq_str(ok_str(d2.decode_chunk(mk_bytes([0x41]), true)), "A")
  assert_true(d2.had_errors())
}

test "redteam P2-3: fatal DecodeError reports non-negative absolute stream offsets across chunks" {
  // gb18030: [84 31 A5] + [30] -> MalformedSequence(0)
  let dg = Decoder::with_options(Encoding::Gb18030, DecodeOptions::new(true, false))
  assert_eq_str(ok_str(dg.decode_chunk(mk_bytes([0x84, 0x31, 0xA5]), false)), "")
  match dg.decode_chunk(mk_bytes([0x30]), true) {
    Err(DecodeError::MalformedSequence(off)) => assert_eq_int(off, 0)
    _ => assert_true(false)
  }
  // UTF-16LE: [41 00 00] + [DC] -> lone low surrogate starts at offset 2
  let dl = Decoder::with_options(Encoding::Utf16Le, DecodeOptions::new(true, false))
  assert_eq_str(ok_str(dl.decode_chunk(mk_bytes([0x41, 0x00, 0x00]), false)), "A")
  match dl.decode_chunk(mk_bytes([0xDC]), true) {
    Err(DecodeError::MalformedSequence(off)) => assert_eq_int(off, 2)
    _ => assert_true(false)
  }
  // UTF-16BE: [D8] + [00 D8] -> high surrogate + odd byte at EOF -> TruncatedSequence(0)
  let db = Decoder::with_options(Encoding::Utf16Be, DecodeOptions::new(true, false))
  assert_eq_str(ok_str(db.decode_chunk(mk_bytes([0xD8]), false)), "")
  match db.decode_chunk(mk_bytes([0x00, 0xD8]), true) {
    Err(DecodeError::TruncatedSequence(off)) => assert_eq_int(off, 0)
    _ => assert_true(false)
  }
  // UTF-16BE: [D8] + [00 D8 00] -> unpaired high surrogate starts at offset 0
  let db2 = Decoder::with_options(Encoding::Utf16Be, DecodeOptions::new(true, false))
  assert_eq_str(ok_str(db2.decode_chunk(mk_bytes([0xD8]), false)), "")
  match db2.decode_chunk(mk_bytes([0x00, 0xD8, 0x00]), true) {
    Err(DecodeError::MalformedSequence(off)) => assert_eq_int(off, 0)
    _ => assert_true(false)
  }
  // UTF-8 truncated across chunks: [41 E4] + [B8] -> TruncatedSequence(1)
  let du = Decoder::with_options(Encoding::Utf8, DecodeOptions::new(true, false))
  assert_eq_str(ok_str(du.decode_chunk(mk_bytes([0x41, 0xE4]), false)), "A")
  match du.decode_chunk(mk_bytes([0xB8]), true) {
    Err(DecodeError::TruncatedSequence(off)) => assert_eq_int(off, 1)
    _ => assert_true(false)
  }
}

test "redteam P2-4: invalid UTF-8 String input replaced by U+FFFD maximal subparts in all encoders" {
  let bad = mk_bytes([0x41, 0xFF, 0xE4, 0xB8, 0xAD]).to_string() // "A" <FF> "中"
  // UTF-8 encoder outputs valid UTF-8 with EF BF BD
  assert_true(bytes_eq(encode_utf8(bad), mk_bytes([0x41, 0xEF, 0xBF, 0xBD, 0xE4, 0xB8, 0xAD])))
  assert_true(bytes_eq(ok_bytes(encode(Encoding::Utf8, bad)), mk_bytes([0x41, 0xEF, 0xBF, 0xBD, 0xE4, 0xB8, 0xAD])))
  // UTF-16LE encoder
  assert_true(bytes_eq(ok_bytes(encode(Encoding::Utf16Le, bad)), mk_bytes([0x41, 0x00, 0xFD, 0xFF, 0x2D, 0x4E])))
  // Shift_JIS encode_html -> 41 &#65533; 92 86 (NOT raw UTF-8)
  let (sj, unm) = encode_html(Encoding::ShiftJis, bad)
  assert_true(unm)
  assert_true(bytes_eq(sj, mk_bytes([0x41, 0x26, 0x23, 0x36, 0x35, 0x35, 0x33, 0x33, 0x3B, 0x92, 0x86])))
  // Maximal subpart: E4 B8 followed by 'A' is ONE U+FFFD + 'A'
  let sub = mk_bytes([0xE4, 0xB8, 0x41]).to_string()
  assert_true(bytes_eq(encode_utf8(sub), mk_bytes([0xEF, 0xBF, 0xBD, 0x41])))
  let (w1252, u2) = encode_html(Encoding::Windows1252, sub)
  assert_true(u2)
  assert_eq_str(w1252.to_string(), "&#65533;A")
}

test "encode: UTF-16LE/BE and replacement output_encoding in encode_html" {
  let (b1, u1) = encode_html(Encoding::Utf16Be, "中")
  assert_true(!u1)
  assert_true(bytes_eq(b1, mk_bytes([0xE4, 0xB8, 0xAD])))
  let (b2, u2) = encode_html(Encoding::Utf16Le, "中")
  assert_true(!u2)
  assert_true(bytes_eq(b2, mk_bytes([0xE4, 0xB8, 0xAD])))
  let (b3, u3) = encode_html(Encoding::Replacement, "中")
  assert_true(!u3)
  assert_true(bytes_eq(b3, mk_bytes([0xE4, 0xB8, 0xAD])))
}

test "encode: all CJK encoders HTML NCR fallback on unmappable astral emoji" {
  let encs = [Encoding::Gbk, Encoding::Big5, Encoding::ShiftJis, Encoding::EucJp, Encoding::EucKr, Encoding::Iso2022Jp]
  let mut i = 0
  while i < encs.length() {
    let (b, unm) = encode_html(encs[i], "A😀B")
    assert_true(unm)
    assert_eq_str(b.to_string(), "A&#128512;B")
    i = i + 1
  }
}

test "gb18030: encode_html preserves all Unicode scalars without unmappable flag" {
  let s = "Hello 中國 龍龘 € \u{0080} \u{FFFD} \u{10000} 😀 \u{10FFFF}"
  let (b, unm) = encode_html(Encoding::Gb18030, s)
  assert_true(!unm)
  assert_eq_str(decode(Encoding::Gb18030, b), s)
}

test "iso2022_jp: halfwidth katakana and fullwidth minus encoding" {
  // Half-width katakana ｡ (U+FF61) + U+2212 (minus -> FF0D)
  let (b, unm) = encode_html(Encoding::Iso2022Jp, "\u{FF61}\u{2212}")
  assert_true(!unm)
  assert_true(bytes_eq(b, mk_bytes([0x1B, 0x24, 0x42, 0x21, 0x23, 0x21, 0x5D, 0x1B, 0x28, 0x42])))
  // Ascii -> Kanji -> Backslash switches cleanly back to ASCII
  let (b2, unm2) = encode_html(Encoding::Iso2022Jp, "A中\\")
  assert_true(!unm2)
  assert_true(bytes_eq(b2, mk_bytes([0x41, 0x1B, 0x24, 0x42, 0x43, 0x66, 0x1B, 0x28, 0x42, 0x5C])))
}

test "bom_sniffing: incomplete BOMs and non-UTF encodings" {
  // Incomplete EF BB is NOT a BOM: falls back to declared encoding
  let (s1, e1, err1) = decode_with_bom_sniffing(Encoding::Gb18030, mk_bytes([0xEF, 0xBB]))
  assert_eq_str(e1.name(), "gb18030")
  assert_true(!err1)
  assert_eq_str(s1, "\u{9518}")
  // Replacement encoding overridden by UTF-8 BOM
  let (s2, e2, err2) = decode_with_bom_sniffing(Encoding::Replacement, mk_bytes([0xEF, 0xBB, 0xBF, 0x41]))
  assert_eq_str(e2.name(), "UTF-8")
  assert_true(!err2)
  assert_eq_str(s2, "A")
}

test "decode_error and encode_error to_string formatting" {
  assert_eq_str(DecodeError::MalformedSequence(4).to_string(), "malformed byte sequence at offset 4")
  assert_eq_str(DecodeError::TruncatedSequence(7).to_string(), "truncated byte sequence at offset 7")
  assert_eq_str(DecodeError::ReplacementEncoding.to_string(), "replacement encoding cannot decode non-empty input")
  assert_eq_str(EncodeError::UnmappableCodePoint(20013, 1).to_string(), "unmappable code point U+20013 at byte 1")
}
