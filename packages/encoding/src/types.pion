///| Public types, errors, options, and API stubs for `packages/encoding`.
///| Pure Pion WHATWG Encoding Standard implementation (zero external deps,
///| zero `extern "C"`, zero `World`, zero mutable module globals).

///| Canonical WHATWG Encoding Standard character encoding (all 40 encodings).
pub enum Encoding {
  Utf8
  Utf16Le
  Utf16Be
  Replacement
  XUserDefined
  Gbk
  Gb18030
  Big5
  EucJp
  Iso2022Jp
  ShiftJis
  EucKr
  Ibm866
  Iso8859_2
  Iso8859_3
  Iso8859_4
  Iso8859_5
  Iso8859_6
  Iso8859_7
  Iso8859_8
  Iso8859_8I
  Iso8859_10
  Iso8859_13
  Iso8859_14
  Iso8859_15
  Iso8859_16
  Koi8R
  Koi8U
  Macintosh
  Windows874
  Windows1250
  Windows1251
  Windows1252
  Windows1253
  Windows1254
  Windows1255
  Windows1256
  Windows1257
  Windows1258
  XMacCyrillic
}

///| Integer discriminant for `Encoding`.
pub fn Encoding::id(self : Encoding) -> Int {
  match self {
    Encoding::Utf8 => 0
    Encoding::Utf16Le => 1
    Encoding::Utf16Be => 2
    Encoding::Replacement => 3
    Encoding::XUserDefined => 4
    Encoding::Gbk => 5
    Encoding::Gb18030 => 6
    Encoding::Big5 => 7
    Encoding::EucJp => 8
    Encoding::Iso2022Jp => 9
    Encoding::ShiftJis => 10
    Encoding::EucKr => 11
    Encoding::Ibm866 => 12
    Encoding::Iso8859_2 => 13
    Encoding::Iso8859_3 => 14
    Encoding::Iso8859_4 => 15
    Encoding::Iso8859_5 => 16
    Encoding::Iso8859_6 => 17
    Encoding::Iso8859_7 => 18
    Encoding::Iso8859_8 => 19
    Encoding::Iso8859_8I => 20
    Encoding::Iso8859_10 => 21
    Encoding::Iso8859_13 => 22
    Encoding::Iso8859_14 => 23
    Encoding::Iso8859_15 => 24
    Encoding::Iso8859_16 => 25
    Encoding::Koi8R => 26
    Encoding::Koi8U => 27
    Encoding::Macintosh => 28
    Encoding::Windows874 => 29
    Encoding::Windows1250 => 30
    Encoding::Windows1251 => 31
    Encoding::Windows1252 => 32
    Encoding::Windows1253 => 33
    Encoding::Windows1254 => 34
    Encoding::Windows1255 => 35
    Encoding::Windows1256 => 36
    Encoding::Windows1257 => 37
    Encoding::Windows1258 => 38
    Encoding::XMacCyrillic => 39
  }
}

///| Structural equality for `Encoding`.
pub fn Encoding::equals(self : Encoding, other : Encoding) -> Bool {
  self.id() == other.id()
}

///| Canonical WHATWG name of this encoding.
pub fn Encoding::name(self : Encoding) -> String {
  match self {
    Encoding::Utf8 => "UTF-8"
    Encoding::Utf16Le => "UTF-16LE"
    Encoding::Utf16Be => "UTF-16BE"
    Encoding::Replacement => "replacement"
    Encoding::XUserDefined => "x-user-defined"
    Encoding::Gbk => "GBK"
    Encoding::Gb18030 => "gb18030"
    Encoding::Big5 => "Big5"
    Encoding::EucJp => "EUC-JP"
    Encoding::Iso2022Jp => "ISO-2022-JP"
    Encoding::ShiftJis => "Shift_JIS"
    Encoding::EucKr => "EUC-KR"
    Encoding::Ibm866 => "IBM866"
    Encoding::Iso8859_2 => "ISO-8859-2"
    Encoding::Iso8859_3 => "ISO-8859-3"
    Encoding::Iso8859_4 => "ISO-8859-4"
    Encoding::Iso8859_5 => "ISO-8859-5"
    Encoding::Iso8859_6 => "ISO-8859-6"
    Encoding::Iso8859_7 => "ISO-8859-7"
    Encoding::Iso8859_8 => "ISO-8859-8"
    Encoding::Iso8859_8I => "ISO-8859-8-I"
    Encoding::Iso8859_10 => "ISO-8859-10"
    Encoding::Iso8859_13 => "ISO-8859-13"
    Encoding::Iso8859_14 => "ISO-8859-14"
    Encoding::Iso8859_15 => "ISO-8859-15"
    Encoding::Iso8859_16 => "ISO-8859-16"
    Encoding::Koi8R => "KOI8-R"
    Encoding::Koi8U => "KOI8-U"
    Encoding::Macintosh => "macintosh"
    Encoding::Windows874 => "windows-874"
    Encoding::Windows1250 => "windows-1250"
    Encoding::Windows1251 => "windows-1251"
    Encoding::Windows1252 => "windows-1252"
    Encoding::Windows1253 => "windows-1253"
    Encoding::Windows1254 => "windows-1254"
    Encoding::Windows1255 => "windows-1255"
    Encoding::Windows1256 => "windows-1256"
    Encoding::Windows1257 => "windows-1257"
    Encoding::Windows1258 => "windows-1258"
    Encoding::XMacCyrillic => "x-mac-cyrillic"
  }
}

///|
pub fn Encoding::to_string(self : Encoding) -> String {
  self.name()
}

///| Whether this encoding is a single-byte encoding (28 WHATWG single-byte encodings + x-user-defined).
pub fn Encoding::is_single_byte(self : Encoding) -> Bool {
  let i = self.id()
  i == 4 || i >= 12
}

///| Whether this encoding is ASCII-compatible (all except UTF-16LE, UTF-16BE, ISO-2022-JP, replacement).
pub fn Encoding::is_ascii_compatible(self : Encoding) -> Bool {
  match self {
    Encoding::Utf16Le => false
    Encoding::Utf16Be => false
    Encoding::Iso2022Jp => false
    Encoding::Replacement => false
    _ => true
  }
}

///| WHATWG §4.2 output encoding (replacement, UTF-16BE, UTF-16LE map to UTF-8).
pub fn Encoding::output_encoding(self : Encoding) -> Encoding {
  match self {
    Encoding::Replacement => Encoding::Utf8
    Encoding::Utf16Le => Encoding::Utf8
    Encoding::Utf16Be => Encoding::Utf8
    _ => self
  }
}

///| Error returned when decoding with `fatal: true`.
pub enum DecodeError {
  MalformedSequence(Int)
  TruncatedSequence(Int)
  ReplacementEncoding
}

///|
pub fn DecodeError::to_string(self : DecodeError) -> String {
  match self {
    DecodeError::MalformedSequence(pos) => "malformed byte sequence at offset " + pos.to_string()
    DecodeError::TruncatedSequence(pos) => "truncated byte sequence at offset " + pos.to_string()
    DecodeError::ReplacementEncoding => "replacement encoding cannot decode non-empty input"
  }
}

///| Error returned by strict `encode`.
pub enum EncodeError {
  UnmappableCodePoint(Int, Int)
  InvalidUtf8Input(Int)
}

///|
pub fn EncodeError::to_string(self : EncodeError) -> String {
  match self {
    EncodeError::UnmappableCodePoint(cp, pos) =>
    "unmappable code point U+" + cp.to_string() + " at byte " + pos.to_string()
    EncodeError::InvalidUtf8Input(pos) => "invalid UTF-8 input at byte " + pos.to_string()
  }
}

///| Decoding options matching Web `TextDecoderOptions` (`fatal`, `ignoreBOM`).
pub val struct DecodeOptions {
  pub fatal : Bool
  pub ignore_bom : Bool
}

///|
pub fn DecodeOptions::default() -> DecodeOptions {
  DecodeOptions::{ fatal: false, ignore_bom: false }
}

///|
pub fn DecodeOptions::new(fatal : Bool, ignore_bom : Bool) -> DecodeOptions {
  DecodeOptions::{ fatal: fatal, ignore_bom: ignore_bom }
}
