///| High-speed WHATWG UTF-8, UTF-16LE, and UTF-16BE streaming decoders & encoders.

///| Validate UTF-8 in `data[start..n]` and return the first invalid/truncated offset, or `n` if all valid.
fn utf8_validate_prefix(data : Bytes, start : Int, n : Int) -> Int {
  let mut i = start
  let stop8 = n - 7
  while i < n {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
      while i < stop8 {
        let a = data[i].to_int() | data[i + 1].to_int() | data[i + 2].to_int() | data[i + 3].to_int()
        let b = data[i + 4].to_int() | data[i + 5].to_int() | data[i + 6].to_int() | data[i + 7].to_int()
        if ((a | b) & 0x80) != 0 {
          break
        }
        i = i + 8
      }
      while i < n && data[i].to_int() < 0x80 {
        i = i + 1
      }
      continue
    }
    if b0 < 0xE0 {
      if b0 < 0xC2 || i + 1 >= n {
        return i
      }
      if (data[i + 1].to_int() & 0xC0) != 0x80 {
        return i
      }
      i = i + 2
      continue
    }
    if b0 < 0xF0 {
      if i + 2 >= n {
        return i
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b2 & 0xC0) != 0x80 {
        return i
      }
      if b0 != 0xE0 && b0 != 0xED {
        if (b1 & 0xC0) != 0x80 {
          return i
        }
      } else if b0 == 0xE0 {
        if b1 < 0xA0 || b1 > 0xBF {
          return i
        }
      } else if b1 < 0x80 || b1 > 0x9F {
        return i
      }
      i = i + 3
      continue
    }
    if b0 <= 0xF4 {
      if i + 3 >= n {
        return i
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return i
      }
      let ok1 = if b0 == 0xF0 {
        b1 >= 0x90 && b1 <= 0xBF
      } else if b0 == 0xF4 {
        b1 >= 0x80 && b1 <= 0x8F
      } else {
        (b1 & 0xC0) == 0x80
      }
      if !ok1 {
        return i
      }
      i = i + 4
      continue
    }
    return i
  }
  n
}

///| Streaming UTF-8 decoder state (WHATWG §8.1).
struct Utf8State {
  mut cp : Int
  mut needed : Int
  mut seen : Int
  mut lower : Int
  mut upper : Int
  mut bom_state : Int // 0 = done, 1 = waiting b0, 2 = saw EF, 3 = saw EF BB
}

fn Utf8State::new(ignore_bom : Bool) -> Utf8State {
  Utf8State::{
    cp: 0,
    needed: 0,
    seen: 0,
    lower: 0x80,
    upper: 0xBF,
    bom_state: if ignore_bom { 0 } else { 1 },
  }
}

fn Utf8State::reset(self : Utf8State, ignore_bom : Bool) -> Unit {
  self.cp = 0
  self.needed = 0
  self.seen = 0
  self.lower = 0x80
  self.upper = 0xBF
  self.bom_state = if ignore_bom { 0 } else { 1 }
}

fn utf8_decode_chunk(
  st : Utf8State,
  data : Bytes,
  base_off : Int,
  last : Bool,
  fatal : Bool,
  had_err_out : FixedArray[Int],
) -> Result[String, DecodeError] {
  let n = data.length()
  let mut i = 0

  // Fast path: neutral state & whole chunk is valid UTF-8!
  if st.needed == 0 {
    if st.bom_state == 1 && n >= 3 {
      if data[0] == 0xEF.to_byte() && data[1] == 0xBB.to_byte() && data[2] == 0xBF.to_byte() {
        st.bom_state = 0
        i = 3
      } else if data[0] != 0xEF.to_byte() {
        st.bom_state = 0
      }
    } else if st.bom_state == 1 && n > 0 && data[0] != 0xEF.to_byte() {
      st.bom_state = 0
    }
    if st.bom_state == 0 {
      let valid_end = utf8_validate_prefix(data, i, n)
      if valid_end == n {
        if i == 0 {
          return Ok(data.to_string())
        }
        if i == n {
          return Ok("")
        }
        return Ok(data.slice(i, n).to_string())
      }
    }
  }

  let out = ByteBuf::with_capacity(n + 16)

  // Handle streaming BOM (1-byte-at-a-time UTF-8 BOM EF BB BF)
  while st.bom_state != 0 && i < n {
    let b = data[i].to_int() & 0xFF
    if st.bom_state == 1 {
      if b == 0xEF {
        st.bom_state = 2
        i = i + 1
        continue
      }
      st.bom_state = 0
      break
    } else if st.bom_state == 2 {
      if b == 0xBB {
        st.bom_state = 3
        i = i + 1
        continue
      }
      // Was not a BOM: feed 0xEF into normal UTF-8 state machine
      st.bom_state = 0
      st.needed = 2
      st.seen = 0
      st.cp = 0x0F
      st.lower = 0x80
      st.upper = 0xBF
      break
    } else {
      // bom_state == 3: saw EF BB
      if b == 0xBF {
        st.bom_state = 0
        i = i + 1
        break
      }
      // Was not a BOM: feed EF BB into normal UTF-8 state machine
      st.bom_state = 0
      st.needed = 2
      st.seen = 1
      st.cp = (0x0F << 6) | (0xBB & 0x3F)
      st.lower = 0x80
      st.upper = 0xBF
      break
    }
  }

  // If EOF while in partial BOM state (EF or EF BB)
  if last && i == n && st.bom_state >= 2 {
    let pending = st.bom_state - 1
    st.bom_state = 0
    if fatal {
      return Err(DecodeError::TruncatedSequence(base_off + n - pending))
    }
    had_err_out[0] = 1
    out.push_replacement()
    return Ok(out.to_string())
  }

  // Main streaming UTF-8 state machine
  while i < n {
    if st.needed == 0 {
      // Bulk-validate valid UTF-8 prefix from i
      let valid_end = utf8_validate_prefix(data, i, n)
      if valid_end > i {
        out.push_bytes_slice(data, i, valid_end)
        i = valid_end
        if i >= n {
          break
        }
      }
      let b = data[i].to_int() & 0xFF
      if b < 0x80 {
        out.push_u8(b)
        i = i + 1
      } else if b >= 0xC2 && b <= 0xDF {
        st.needed = 1
        st.seen = 0
        st.cp = b & 0x1F
        st.lower = 0x80
        st.upper = 0xBF
        i = i + 1
      } else if b >= 0xE0 && b <= 0xEF {
        st.needed = 2
        st.seen = 0
        st.cp = b & 0x0F
        st.lower = if b == 0xE0 { 0xA0 } else { 0x80 }
        st.upper = if b == 0xED { 0x9F } else { 0xBF }
        i = i + 1
      } else if b >= 0xF0 && b <= 0xF4 {
        st.needed = 3
        st.seen = 0
        st.cp = b & 0x07
        st.lower = if b == 0xF0 { 0x90 } else { 0x80 }
        st.upper = if b == 0xF4 { 0x8F } else { 0xBF }
        i = i + 1
      } else {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i))
        }
        had_err_out[0] = 1
        out.push_replacement()
        i = i + 1
      }
    } else {
      let b = data[i].to_int() & 0xFF
      if b < st.lower || b > st.upper {
        // WHATWG maximal subpart: do NOT consume b; reset state and reprocess b
        let seq_start = base_off + i - (st.seen + 1)
        st.cp = 0
        st.needed = 0
        st.seen = 0
        st.lower = 0x80
        st.upper = 0xBF
        if fatal {
          return Err(DecodeError::MalformedSequence(seq_start))
        }
        had_err_out[0] = 1
        out.push_replacement()
        continue
      }
      st.lower = 0x80
      st.upper = 0xBF
      st.cp = (st.cp << 6) | (b & 0x3F)
      st.seen = st.seen + 1
      i = i + 1
      if st.seen == st.needed {
        let cp = st.cp
        st.cp = 0
        st.needed = 0
        st.seen = 0
        if cp < 0x10000 {
          out.push_bmp(cp)
        } else {
          out.push_astral(cp)
        }
      }
    }
  }

  if last && st.needed != 0 {
    let seq_start = base_off + n - (st.seen + 1)
    st.cp = 0
    st.needed = 0
    st.seen = 0
    st.lower = 0x80
    st.upper = 0xBF
    if fatal {
      return Err(DecodeError::TruncatedSequence(seq_start))
    }
    had_err_out[0] = 1
    out.push_replacement()
  }

  Ok(out.to_string())
}

///| Streaming UTF-16LE / UTF-16BE decoder state (WHATWG §14.3).
struct Utf16State {
  be : Bool
  mut lead_byte : Int // -1 = none, 0..255 = pending first byte
  mut lead_surrogate : Int // 0 = none, 0xD800..0xDBFF = pending high surrogate
  mut bom_pending : Bool
}

fn Utf16State::new(be : Bool, ignore_bom : Bool) -> Utf16State {
  Utf16State::{
    be: be,
    lead_byte: -1,
    lead_surrogate: 0,
    bom_pending: !ignore_bom,
  }
}

fn Utf16State::reset(self : Utf16State, ignore_bom : Bool) -> Unit {
  self.lead_byte = -1
  self.lead_surrogate = 0
  self.bom_pending = !ignore_bom
}

fn utf16_decode_chunk(
  st : Utf16State,
  data : Bytes,
  base_off : Int,
  last : Bool,
  fatal : Bool,
  had_err_out : FixedArray[Int],
) -> Result[String, DecodeError] {
  let n = data.length()
  let out = ByteBuf::with_capacity(n + 16)
  let mut i = 0
  while i < n {
    let b = data[i].to_int() & 0xFF
    i = i + 1
    if st.lead_byte < 0 {
      st.lead_byte = b
      continue
    }
    let lb = st.lead_byte
    st.lead_byte = -1
    let cu = if st.be { (lb << 8) | b } else { (b << 8) | lb }

    if st.bom_pending {
      st.bom_pending = false
      if cu == 0xFEFF {
        continue
      }
    }

    let hi_bits = cu & 0xFC00
    if hi_bits == 0xD800 {
      // High surrogate
      if st.lead_surrogate != 0 {
        if fatal {
          st.lead_surrogate = 0
          return Err(DecodeError::MalformedSequence(base_off + i - 4))
        }
        had_err_out[0] = 1
        out.push_replacement()
      }
      st.lead_surrogate = cu
    } else if hi_bits == 0xDC00 {
      // Low surrogate
      if st.lead_surrogate == 0 {
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 2))
        }
        had_err_out[0] = 1
        out.push_replacement()
      } else {
        let cp = 0x10000 + ((st.lead_surrogate - 0xD800) << 10) + (cu - 0xDC00)
        st.lead_surrogate = 0
        out.push_astral(cp)
      }
    } else {
      // BMP
      if st.lead_surrogate != 0 {
        st.lead_surrogate = 0
        if fatal {
          return Err(DecodeError::MalformedSequence(base_off + i - 4))
        }
        had_err_out[0] = 1
        out.push_replacement()
      }
      out.push_bmp(cu)
    }
  }

  if last {
    if st.lead_surrogate != 0 || st.lead_byte >= 0 {
      let pending = (if st.lead_surrogate != 0 { 2 } else { 0 }) + (if st.lead_byte >= 0 { 1 } else { 0 })
      st.lead_surrogate = 0
      st.lead_byte = -1
      if fatal {
        return Err(DecodeError::TruncatedSequence(base_off + n - pending))
      }
      had_err_out[0] = 1
      out.push_replacement()
    }
  }

  Ok(out.to_string())
}

///| Encode a Pion `String` as valid UTF-8 `Bytes` (replacing ill-formed subsequences with U+FFFD).
pub fn encode_utf8(s : String) -> Bytes {
  let n = s.length()
  let mut i = 0
  let mut valid = true
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      i = i + 1
      continue
    }
    if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 < n && (s.code_unit_at(i + 1) & 0xC0) == 0x80 {
        i = i + 2
        continue
      }
      valid = false
      break
    }
    if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 < n {
        let b1 = s.code_unit_at(i + 1)
        let b2 = s.code_unit_at(i + 2)
        let ok1 = if b0 == 0xE0 {
          b1 >= 0xA0 && b1 <= 0xBF
        } else if b0 == 0xED {
          b1 >= 0x80 && b1 <= 0x9F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if ok1 && (b2 & 0xC0) == 0x80 {
          i = i + 3
          continue
        }
      }
      valid = false
      break
    }
    if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 < n {
        let b1 = s.code_unit_at(i + 1)
        let b2 = s.code_unit_at(i + 2)
        let b3 = s.code_unit_at(i + 3)
        let ok1 = if b0 == 0xF0 {
          b1 >= 0x90 && b1 <= 0xBF
        } else if b0 == 0xF4 {
          b1 >= 0x80 && b1 <= 0x8F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if ok1 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
          i = i + 4
          continue
        }
      }
      valid = false
      break
    }
    valid = false
    break
  }
  if valid {
    let out = Bytes::new(n)
    let mut k = 0
    while k < n {
      out[k] = s.code_unit_at(k).to_byte()
      k = k + 1
    }
    return out
  }
  let out = ByteBuf::with_capacity(n + 16)
  let mut k = 0
  while k < i {
    out.push_u8(s.code_unit_at(k))
    k = k + 1
  }
  while i < n {
    let (cp, step) = utf8_str_next(s, i)
    if cp < 0x10000 {
      out.push_bmp(cp)
    } else {
      out.push_astral(cp)
    }
    i = i + step
  }
  out.to_bytes()
}

///| Encode a Pion `String` as UTF-16LE `Bytes`.
pub fn encode_utf16le(s : String) -> Bytes {
  let n = s.length()
  let out = ByteBuf::with_capacity(n * 2)
  let mut i = 0
  while i < n {
    let (c, step) = utf8_str_next(s, i)
    i = i + step
    if c < 0x10000 {
      out.push_u8_2(c & 0xFF, (c >> 8) & 0xFF)
    } else {
      let adj = c - 0x10000
      let hi = 0xD800 + (adj >> 10)
      let lo = 0xDC00 + (adj & 0x3FF)
      out.push_u8_4(hi & 0xFF, (hi >> 8) & 0xFF, lo & 0xFF, (lo >> 8) & 0xFF)
    }
  }
  out.to_bytes()
}

///| Encode a Pion `String` as UTF-16BE `Bytes`.
pub fn encode_utf16be(s : String) -> Bytes {
  let n = s.length()
  let out = ByteBuf::with_capacity(n * 2)
  let mut i = 0
  while i < n {
    let (c, step) = utf8_str_next(s, i)
    i = i + step
    if c < 0x10000 {
      out.push_u8_2((c >> 8) & 0xFF, c & 0xFF)
    } else {
      let adj = c - 0x10000
      let hi = 0xD800 + (adj >> 10)
      let lo = 0xDC00 + (adj & 0x3FF)
      out.push_u8_4((hi >> 8) & 0xFF, hi & 0xFF, (lo >> 8) & 0xFF, lo & 0xFF)
    }
  }
  out.to_bytes()
}
