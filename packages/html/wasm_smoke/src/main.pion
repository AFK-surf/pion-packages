///| Wasm32 + Native smoke entry for the `html` package.

import "html"

///|
pub fn smoke() -> Int {
  let src = "<!DOCTYPE html><html><head><title>Pion &amp; HTML5</title></head><body><div id=\"app\" class=\"hero main\"><p>Hello <b>world</b><br><a href=\"https://example.com\">Link</a></p></div></body></html>"
  let doc = match html::Document::parse(src) {
    Ok(d) => d
    Err(_) => return -1
  }
  let links = match doc.select("div#app.hero > p a[href^=\"https://\"]") {
    Ok(v) => v
    Err(_) => return -2
  }
  if links.length() != 1 {
    return -3
  }
  let clean = html::sanitize("<p onclick=\"alert(1)\">Hi <a href=\"javascript:alert(1)\">bad</a> <a href=\"https://ok.test\">ok</a></p><script>evil()</script>")
  if clean.length() == 0 {
    return -4
  }

  // WHATWG HTML §4.8.4.3 srcset & <picture><source> smoke checks
  let cands = html::parse_srcset("https://cdn.test/w_400,f_auto/a.jpg 400w, https://cdn.test/w_800,f_auto/b.jpg 800w")
  if cands.length() != 2 {
    return -5
  }
  let chosen = match html::select_srcset_candidate(cands, "fallback.jpg", 400.0, 2.0) {
    Some(u) => u
    None => return -6
  }
  if chosen != "https://cdn.test/w_800,f_auto/b.jpg" {
    return -7
  }
  let pic = match html::select_picture_source(
    [
      html::PictureSource::{ srcset: "a.jxl 1x", media_matches: true, mime_type: "image/jxl" },
      html::PictureSource::{ srcset: "b.webp 1x, b@2x.webp 2x", media_matches: true, mime_type: "image/webp" },
    ],
    "fb.jpg 1x",
    "fb.jpg",
    400.0,
    2.0,
  ) {
    Some(u) => u
    None => return -8
  }
  if pic != "b@2x.webp" {
    return -9
  }
  doc.node_count() + links.length() + clean.length() + chosen.length() + pic.length()
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  io_println(world, "html_wasm_smoke=" + r.to_string())
  if r > 0 {
    0
  } else {
    1
  }
}
