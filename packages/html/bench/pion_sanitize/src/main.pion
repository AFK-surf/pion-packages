///| Benchmark 3: HTML XSS Sanitization Throughput (20 rounds).

import "html"

fn fnv1a_64(s : String) -> Int64 {
  let mut h : Int64 = -3750763034362895579L // 0xcbf29ce484222325
  let prime : Int64 = 1099511628211L
  let n = s.length()
  let mut i = 0
  while i < n {
    h = h ^ s.code_unit_at(i).to_int64()
    h = h * prime
    i = i + 1
  }
  h
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 {
    args[1]
  } else {
    "/private/tmp/pion-html-bench/ugc_xss.html"
  }
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }

  let sanitizer = html::Sanitizer::default()
  let rounds = 20
  let mut total_bytes : Int64 = 0L
  let mut last_hash : Int64 = 0L
  let mut r = 0
  while r < rounds {
    let clean = sanitizer.clean(src)
    total_bytes = total_bytes + clean.length().to_int64()
    if r == rounds - 1 {
      last_hash = fnv1a_64(clean)
    }
    r = r + 1
  }

  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "fnv64=" + last_hash.to_string())
  0
}
