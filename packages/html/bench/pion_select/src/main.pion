///| Benchmark 2: CSS Selector Query on Large DOM (50 rounds x 5 complex selectors).

import "html"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 {
    args[1]
  } else {
    "/private/tmp/pion-html-bench/mixed_pages.html"
  }
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }
  let doc = match html::Document::parse(src) {
    Ok(d) => d
    Err(e) => {
      io_println(world, "parse error: " + e.to_string())
      return 1
    }
  }

  let queries = [
    "main > section.articles article.post > h2.title a[href^=\"https://\"]",
    "ul.nav-list > li.item:nth-child(odd) > a",
    "table.metrics tbody tr > td[data-status=\"ok\" i]",
    "div.card:not(.archived) p.summary",
    "header h1, footer a[rel~=\"noopener\"]",
  ]
  let compiled : Array[html::Selector] = []
  let mut qi = 0
  while qi < queries.length() {
    match html::Selector::parse(queries[qi]) {
      Ok(s) => compiled.push(s)
      Err(e) => {
        io_println(world, "selector error: " + e.to_string())
        return 1
      }
    }
    qi = qi + 1
  }

  let rounds = 50
  let mut total_matches : Int64 = 0L
  let mut tag_bytes : Int64 = 0L
  let mut r = 0
  while r < rounds {
    let mut k = 0
    while k < compiled.length() {
      let res = doc.select_compiled(compiled[k])
      total_matches = total_matches + res.length().to_int64()
      let mut j = 0
      while j < res.length() {
        tag_bytes = tag_bytes + res[j].tag_name().length().to_int64()
        j = j + 1
      }
      k = k + 1
    }
    r = r + 1
  }

  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "queries=" + compiled.length().to_string())
  io_println(world, "matches=" + total_matches.to_string())
  io_println(world, "tag_bytes=" + tag_bytes.to_string())
  0
}
