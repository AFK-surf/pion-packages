///| Benchmark 1: HTML5 Document Parse + Element/Link/Text Extraction (20 rounds).

import "html"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 {
    args[1]
  } else {
    "/private/tmp/pion-html-bench/mixed_pages.html"
  }
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }
  let rounds = 20
  let mut elements : Int64 = 0L
  let mut links : Int64 = 0L
  let mut href_bytes : Int64 = 0L
  let mut text_bytes : Int64 = 0L

  let mut r = 0
  while r < rounds {
    let doc = match html::Document::parse(src) {
      Ok(d) => d
      Err(e) => {
        io_println(world, "parse error: " + e.to_string())
        return 1
      }
    }
    let n = doc.node_count()
    let mut i = 0
    while i < n {
      let k = doc.node_kind_at(i)
      if k == 2 {
        elements = elements + 1L
        let node = html::Node::{ doc: doc, id: i }
        if node.has_tag_name("a") {
          match node.attr("href") {
            Some(h) => {
              links = links + 1L
              href_bytes = href_bytes + h.length().to_int64()
            }
            None => ()
          }
        }
      } else if k == 3 {
        let node = html::Node::{ doc: doc, id: i }
        match node.text() {
          Some(t) => text_bytes = text_bytes + t.length().to_int64()
          None => ()
        }
      }
      i = i + 1
    }
    r = r + 1
  }

  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "elements=" + elements.to_string())
  io_println(world, "links=" + links.to_string())
  io_println(world, "href_bytes=" + href_bytes.to_string())
  io_println(world, "text_bytes=" + text_bytes.to_string())
  0
}
