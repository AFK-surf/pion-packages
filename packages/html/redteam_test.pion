///| Day-1 red-team security & scalability tests (0 SIGSEGV on 50k nesting, limits, O(N) linearity).

///|
test "redteam_50k_nested_divs_zero_sigsegv" {
  let depth = 50000
  let sb = StringBuilder::with_capacity(depth * 11 + 8)
  let mut i = 0
  while i < depth {
    sb.write_string("<div>")
    i = i + 1
  }
  sb.write_string("leaf")
  i = 0
  while i < depth {
    sb.write_string("</div>")
    i = i + 1
  }
  let src = sb.to_string()
  let doc = match Document::parse_fragment(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "50k nested divs should parse iteratively: " + e.to_string())
      return ()
    }
  }
  debug_assert(doc.node_count() == depth + 2, "document + 50000 divs + 1 text node")
  debug_assert(doc.text_content() == "leaf", "iterative text_content extracts leaf")
  let serialized = doc.to_html()
  debug_assert(serialized.length() == src.length(), "iterative to_html roundtrips 50k nesting")
}

///|
test "redteam_max_depth_and_max_nodes_limits" {
  // max_depth = 32 rejects 40 nested divs
  let sb = StringBuilder::with_capacity(512)
  let mut i = 0
  while i < 40 {
    sb.write_string("<div>")
    i = i + 1
  }
  let deep_src = sb.to_string()
  let depth_opts = ParseOptions::{
    limits: Limits::{ max_depth: 32, max_nodes: 100000, max_attributes: 1024 },
  }
  match Document::parse_fragment_with_options(deep_src, depth_opts) {
    Ok(_) => debug_assert(false, "expected LimitExceeded for max_depth")
    Err(e) => debug_assert(html_error_kind_eq(e.kind, HtmlErrorKind::LimitExceeded), "LimitExceeded kind for depth")
  }

  // max_nodes = 50 rejects 100 sibling spans
  let sb2 = StringBuilder::with_capacity(1400)
  i = 0
  while i < 100 {
    sb2.write_string("<span>x</span>")
    i = i + 1
  }
  let wide_src = sb2.to_string()
  let node_opts = ParseOptions::{
    limits: Limits::{ max_depth: 256, max_nodes: 50, max_attributes: 1024 },
  }
  match Document::parse_fragment_with_options(wide_src, node_opts) {
    Ok(_) => debug_assert(false, "expected LimitExceeded for max_nodes")
    Err(e) => debug_assert(html_error_kind_eq(e.kind, HtmlErrorKind::LimitExceeded), "LimitExceeded kind for nodes")
  }

  // max_attributes = 10 rejects element with 20 attributes
  let sb3 = StringBuilder::with_capacity(256)
  sb3.write_string("<div")
  i = 0
  while i < 20 {
    sb3.write_string(" a")
    sb3.write_string(i.to_string())
    sb3.write_string("=\"1\"")
    i = i + 1
  }
  sb3.write_string("></div>")
  let attr_opts = ParseOptions::{
    limits: Limits::{ max_depth: 256, max_nodes: 100000, max_attributes: 10 },
  }
  match Document::parse_fragment_with_options(sb3.to_string(), attr_opts) {
    Ok(_) => debug_assert(false, "expected LimitExceeded for max_attributes")
    Err(e) => debug_assert(html_error_kind_eq(e.kind, HtmlErrorKind::LimitExceeded), "LimitExceeded kind for attrs")
  }
}

///|
test "redteam_50k_attributes_linear" {
  let count = 50000
  let sb = StringBuilder::with_capacity(count * 12 + 16)
  sb.write_string("<div")
  let mut i = 0
  while i < count {
    sb.write_string(" k")
    sb.write_string(i.to_string())
    sb.write_string("=\"v\"")
    i = i + 1
  }
  sb.write_string(" k0=\"dup\">ok</div>")
  let doc = match Document::parse_fragment(sb.to_string()) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "50k attrs failed: " + e.to_string())
      return ()
    }
  }
  let el = doc.root().element_children()[0]
  debug_assert(el.attributes().length() == count, "50k unique attrs, duplicate k0 ignored")
  match el.attr("k0") {
    Some(v) => debug_assert(v == "v", "first k0 wins")
    None => debug_assert(false, "missing k0")
  }
}

///|
test "redteam_50k_alternating_text_entities_linear" {
  let count = 50000
  let sb = StringBuilder::with_capacity(count * 6 + 16)
  sb.write_string("<p>")
  let mut i = 0
  while i < count {
    sb.write_string("a&amp;")
    i = i + 1
  }
  sb.write_string("</p>")
  let doc = match Document::parse_fragment(sb.to_string()) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "50k entities failed: " + e.to_string())
      return ()
    }
  }
  let txt = doc.text_content()
  debug_assert(txt.length() == count * 2, "50k * 'a&' = 100k chars in linear time")
}

///|
test "redteam_pathological_malformed_inputs" {
  let cases = [
    "<<<<<<<<<<<<<<<<<<<<",
    "&&&&&&&&&&&&&&&&&&&&",
    "<!--<!--<!--<!--",
    "<div a=\"1\" b='2' c=3",
    "</p></p></div></span>",
    "<!DOCTYPE",
    "<?xml version=\"1.0\"?><div>ok</div>",
  ]
  let mut i = 0
  while i < cases.length() {
    match Document::parse_fragment(cases[i]) {
      Ok(d) => {
        let _ = d.to_html()
        let _ = d.text_content()
      }
      Err(e) => debug_assert(false, "pathological input should not fail: " + e.to_string())
    }
    i = i + 1
  }
}
