///| ammonia-grade whitelist HTML XSS sanitizer & OWASP XSS vector tests.

fn str_contains(hay : String, needle : String) -> Bool {
  let hlen = hay.length()
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  if nlen > hlen {
    return false
  }
  let mut i = 0
  while i <= hlen - nlen {
    let mut j = 0
    while j < nlen && hay.code_unit_at(i + j) == needle.code_unit_at(j) {
      j = j + 1
    }
    if j == nlen {
      return true
    }
    i = i + 1
  }
  false
}

///|
test "sanitizer_preserves_safe_html_and_adds_rel" {
  let input = "<p>Hello <b>world</b> and <a href=\"https://example.com\" title=\"Ex\">link</a>!</p>"
  let out = sanitize(input)
  debug_assert(
    out == "<p>Hello <b>world</b> and <a href=\"https://example.com\" title=\"Ex\" rel=\"noopener noreferrer\">link</a>!</p>",
    "safe html preserved with rel=\"noopener noreferrer\"",
  )
}

///|
test "sanitizer_strips_dangerous_tags_and_subtrees" {
  let input = "<p>ok</p>" +
  "<script>alert('xss')</script>" +
  "<style>body{background:url(javascript:alert(1))}</style>" +
  "<iframe src=\"https://evil.com\">fallback</iframe>" +
  "<object data=\"evil.swf\"><param name=\"x\" value=\"1\"></object>" +
  "<embed src=\"evil.swf\">" +
  "<svg onload=\"alert(1)\"><script>alert(2)</script><circle r=\"10\"/></svg>" +
  "<math><mtext><img src=x onerror=alert(1)></mtext></math>"
  let out = sanitize(input)
  debug_assert(out == "<p>ok</p>", "all dangerous tags and subtrees stripped completely")
}

///|
test "sanitizer_unwraps_unknown_tags_and_strips_event_handlers" {
  let input = "<div onclick=\"alert(1)\" ONMOUSEOVER=\"evil()\" title=\"safe\"><font color=\"red\">hello</font><img src=\"https://example.com/a.png\" alt=\"pic\" onerror=\"alert(1)\"></div>"
  let out = sanitize(input)
  debug_assert(!str_contains(out, "onclick"), "onclick stripped")
  debug_assert(!str_contains(out, "onmouseover"), "onmouseover stripped")
  debug_assert(!str_contains(out, "onerror"), "onerror stripped")
  debug_assert(!str_contains(out, "<font"), "font unwrapped")
  debug_assert(str_contains(out, "hello"), "font inner text kept")
  debug_assert(str_contains(out, "title=\"safe\""), "safe title kept")
  debug_assert(str_contains(out, "src=\"https://example.com/a.png\""), "safe img src kept")
}

///|
test "sanitizer_blocks_obfuscated_dangerous_url_schemes" {
  let vectors = [
    "<a href=\"javascript:alert(1)\">1</a>",
    "<a href=\"JAVASCRIPT:alert(1)\">2</a>",
    "<a href=\"vbscript:msgbox(1)\">3</a>",
    "<a href=\"data:text/html,<script>alert(1)</script>\">4</a>",
    "<a href=\"java&#x09;script:alert(1)\">5</a>",
    "<a href=\"&#106;avascript:alert(1)\">6</a>",
    "<a href=\"&#x6A;&#x61;vascript:alert(1)\">7</a>",
    "<a href=\"   javascript:alert(1)\">8</a>",
    "<a href=\"java\nscript:alert(1)\">9</a>",
    "<a href=\"java&#10;script:alert(1)\">10</a>",
    "<img src=\"javascript:alert(1)\" alt=\"x\">",
    "<img src=\"data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==\" alt=\"y\">",
  ]
  let mut i = 0
  while i < vectors.length() {
    let out = sanitize(vectors[i])
    debug_assert(!str_contains(out, "href="), "dangerous href must be stripped: " + out)
    debug_assert(!str_contains(out, "src="), "dangerous src must be stripped: " + out)
    debug_assert(!str_contains(out, "javascript"), "no javascript in output: " + out)
    debug_assert(!str_contains(out, "vbscript"), "no vbscript in output: " + out)
    i = i + 1
  }

  // Allowed schemes: http, https, mailto, relative paths
  let safe = "<a href=\"http://a.test\">1</a><a href=\"https://b.test\">2</a><a href=\"mailto:hi@example.com\">3</a><a href=\"/docs/intro\">4</a><a href=\"#top\">5</a>"
  let sout = sanitize(safe)
  debug_assert(str_contains(sout, "href=\"http://a.test\""), "http allowed")
  debug_assert(str_contains(sout, "href=\"https://b.test\""), "https allowed")
  debug_assert(str_contains(sout, "href=\"mailto:hi@example.com\""), "mailto allowed")
  debug_assert(str_contains(sout, "href=\"/docs/intro\""), "relative path allowed")
  debug_assert(str_contains(sout, "href=\"#top\""), "fragment allowed")
}

///|
test "sanitizer_mxss_defenses" {
  // noscript / xmp / textarea / title / style embedded payloads
  let mxss_cases = [
    "<noscript><p title=\"</noscript><img src=x onerror=alert(1)>\">",
    "<xmp><img src=x onerror=alert(1)></xmp>",
    "<textarea><img src=x onerror=alert(1)></textarea>",
    "<title><img src=x onerror=alert(1)></title>",
    "<style><img src=x onerror=alert(1)></style>",
    "<!--<img src=\"--><img src=x onerror=alert(1)//\">",
  ]
  let mut i = 0
  while i < mxss_cases.length() {
    let out = sanitize(mxss_cases[i])
    debug_assert(!str_contains(out, "onerror"), "mXSS onerror must not survive: " + out)
    debug_assert(!str_contains(out, "alert("), "mXSS payload must not survive: " + out)
    i = i + 1
  }

  // Attribute quote breakout must remain safely escaped
  let q_in = "<a title='a\" onclick=\"alert(1)' href=\"https://example.com\">safe</a>"
  let q_out = sanitize(q_in)
  debug_assert(
    str_contains(q_out, "title=\"a&quot; onclick=&quot;alert(1)\""),
    "attribute quotes properly escaped",
  )
}

///|
test "sanitizer_custom_configuration" {
  let s = Sanitizer::new()
  .add_tags(["custom-tag"])
  .rm_tags(["b"])
  .add_tag_attributes("custom-tag", ["data-x"])
  .add_url_schemes(["ftp"])
  .set_link_rel(None)
  .set_strip_comments(false)
  let out = s.clean("<!-- keep --><b>bold</b><custom-tag data-x=\"1\" onclick=\"bad()\">hi</custom-tag><a href=\"ftp://files.example.com\">f</a>")
  debug_assert(str_contains(out, "<!-- keep -->"), "comment kept when strip_comments=false")
  debug_assert(!str_contains(out, "<b>"), "removed tag b unwrapped")
  debug_assert(str_contains(out, "bold"), "removed tag text kept")
  debug_assert(str_contains(out, "<custom-tag data-x=\"1\">hi</custom-tag>"), "custom tag and attr allowed")
  debug_assert(str_contains(out, "<a href=\"ftp://files.example.com\">f</a>"), "custom scheme allowed & no rel")
}
