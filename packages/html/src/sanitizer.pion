///| ammonia-grade whitelist HTML XSS sanitizer.

fn set_insert_all(m : Map[String, Bool], items : Array[String]) -> Unit {
  let mut i = 0
  while i < items.length() {
    m.set(to_ascii_lower(items[i]), true)
    i = i + 1
  }
}

fn clone_bool_map(src : Map[String, Bool]) -> Map[String, Bool] {
  let dst : Map[String, Bool] = Map::new()
  let ks = src.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match src.get(k) {
      Some(v) => if v { dst.set(k, true) }
      None => ()
    }
    i = i + 1
  }
  dst
}

fn clone_tag_attrs(
  src : Map[String, Map[String, Bool]],
) -> Map[String, Map[String, Bool]] {
  let dst : Map[String, Map[String, Bool]] = Map::new()
  let ks = src.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match src.get(k) {
      Some(inner) => dst.set(k, clone_bool_map(inner))
      None => ()
    }
    i = i + 1
  }
  dst
}

fn map_has(m : Map[String, Bool], key : String) -> Bool {
  match m.get(key) {
    Some(v) => v
    None => false
  }
}

///| Build default `ammonia`-grade safe tag whitelist.
pub fn Sanitizer::default() -> Sanitizer {
  let tags : Map[String, Bool] = Map::new()
  set_insert_all(
    tags,
    [
      "a", "abbr", "acronym", "area", "article", "aside", "b", "bdi", "bdo",
      "blockquote", "br", "caption", "center", "cite", "code", "col", "colgroup",
      "data", "dd", "del", "details", "dfn", "div", "dl", "dt", "em",
      "figcaption", "figure", "footer", "h1", "h2", "h3", "h4", "h5", "h6",
      "header", "hgroup", "hr", "i", "img", "ins", "kbd", "li", "map", "mark",
      "nav", "ol", "p", "pre", "q", "rp", "rt", "rtc", "ruby", "s", "samp",
      "section", "small", "span", "strike", "strong", "sub", "summary", "sup",
      "table", "tbody", "td", "tfoot", "th", "thead", "time", "tr", "tt", "u",
      "ul", "var", "wbr",
    ],
  )

  let clean_content_tags : Map[String, Bool] = Map::new()
  set_insert_all(
    clean_content_tags,
    [
      "script", "style", "iframe", "object", "embed", "svg", "math", "noscript",
      "xmp", "template", "title", "textarea", "noembed", "noframes", "plaintext",
      "applet", "frame", "frameset", "head", "meta", "link", "base",
    ],
  )

  let generic_attributes : Map[String, Bool] = Map::new()
  set_insert_all(generic_attributes, ["lang", "title"])

  let tag_attributes : Map[String, Map[String, Bool]] = Map::new()
  let a_attrs : Map[String, Bool] = Map::new()
  set_insert_all(a_attrs, ["href", "hreflang"])
  tag_attributes.set("a", a_attrs)

  let img_attrs : Map[String, Bool] = Map::new()
  set_insert_all(img_attrs, ["src", "alt", "width", "height"])
  tag_attributes.set("img", img_attrs)

  let bq_attrs : Map[String, Bool] = Map::new()
  set_insert_all(bq_attrs, ["cite"])
  tag_attributes.set("blockquote", bq_attrs)

  let q_attrs : Map[String, Bool] = Map::new()
  set_insert_all(q_attrs, ["cite"])
  tag_attributes.set("q", q_attrs)

  let td_attrs : Map[String, Bool] = Map::new()
  set_insert_all(td_attrs, ["colspan", "rowspan", "headers", "scope", "abbr"])
  tag_attributes.set("td", td_attrs)

  let th_attrs : Map[String, Bool] = Map::new()
  set_insert_all(th_attrs, ["colspan", "rowspan", "headers", "scope", "abbr"])
  tag_attributes.set("th", th_attrs)

  let ol_attrs : Map[String, Bool] = Map::new()
  set_insert_all(ol_attrs, ["start", "reversed", "type"])
  tag_attributes.set("ol", ol_attrs)

  let table_attrs : Map[String, Bool] = Map::new()
  set_insert_all(table_attrs, ["summary"])
  tag_attributes.set("table", table_attrs)

  let col_attrs : Map[String, Bool] = Map::new()
  set_insert_all(col_attrs, ["span"])
  tag_attributes.set("col", col_attrs)

  let colgroup_attrs : Map[String, Bool] = Map::new()
  set_insert_all(colgroup_attrs, ["span"])
  tag_attributes.set("colgroup", colgroup_attrs)

  let del_attrs : Map[String, Bool] = Map::new()
  set_insert_all(del_attrs, ["cite", "datetime"])
  tag_attributes.set("del", del_attrs)

  let ins_attrs : Map[String, Bool] = Map::new()
  set_insert_all(ins_attrs, ["cite", "datetime"])
  tag_attributes.set("ins", ins_attrs)

  let time_attrs : Map[String, Bool] = Map::new()
  set_insert_all(time_attrs, ["datetime"])
  tag_attributes.set("time", time_attrs)

  let details_attrs : Map[String, Bool] = Map::new()
  set_insert_all(details_attrs, ["open"])
  tag_attributes.set("details", details_attrs)

  let area_attrs : Map[String, Bool] = Map::new()
  set_insert_all(area_attrs, ["alt", "coords", "href", "shape"])
  tag_attributes.set("area", area_attrs)

  let map_attrs : Map[String, Bool] = Map::new()
  set_insert_all(map_attrs, ["name"])
  tag_attributes.set("map", map_attrs)

  let data_attrs : Map[String, Bool] = Map::new()
  set_insert_all(data_attrs, ["value"])
  tag_attributes.set("data", data_attrs)

  let bdo_attrs : Map[String, Bool] = Map::new()
  set_insert_all(bdo_attrs, ["dir"])
  tag_attributes.set("bdo", bdo_attrs)

  let url_schemes : Map[String, Bool] = Map::new()
  set_insert_all(url_schemes, ["http", "https", "mailto"])

  let url_attributes : Map[String, Bool] = Map::new()
  set_insert_all(
    url_attributes,
    [
      "href", "src", "cite", "action", "formaction", "poster", "data",
      "xlink:href", "background",
    ],
  )

  Sanitizer::{
    tags: tags,
    clean_content_tags: clean_content_tags,
    generic_attributes: generic_attributes,
    tag_attributes: tag_attributes,
    url_schemes: url_schemes,
    url_attributes: url_attributes,
    link_rel: Some("noopener noreferrer"),
    strip_comments: true,
  }
}

///|
pub fn Sanitizer::new() -> Sanitizer {
  Sanitizer::default()
}

///|
pub fn Sanitizer::add_tags(self : Sanitizer, tags : Array[String]) -> Sanitizer {
  let next_tags = clone_bool_map(self.tags)
  let next_clean = clone_bool_map(self.clean_content_tags)
  let mut i = 0
  while i < tags.length() {
    let t = to_ascii_lower(tags[i])
    next_tags.set(t, true)
    next_clean.set(t, false)
    i = i + 1
  }
  Sanitizer::{
    tags: next_tags,
    clean_content_tags: next_clean,
    generic_attributes: self.generic_attributes,
    tag_attributes: self.tag_attributes,
    url_schemes: self.url_schemes,
    url_attributes: self.url_attributes,
    link_rel: self.link_rel,
    strip_comments: self.strip_comments,
  }
}

///|
pub fn Sanitizer::rm_tags(self : Sanitizer, tags : Array[String]) -> Sanitizer {
  let next_tags = clone_bool_map(self.tags)
  let mut i = 0
  while i < tags.length() {
    next_tags.set(to_ascii_lower(tags[i]), false)
    i = i + 1
  }
  Sanitizer::{
    tags: next_tags,
    clean_content_tags: self.clean_content_tags,
    generic_attributes: self.generic_attributes,
    tag_attributes: self.tag_attributes,
    url_schemes: self.url_schemes,
    url_attributes: self.url_attributes,
    link_rel: self.link_rel,
    strip_comments: self.strip_comments,
  }
}

///|
pub fn Sanitizer::add_tag_attributes(
  self : Sanitizer,
  tag : String,
  attrs : Array[String],
) -> Sanitizer {
  let next_map = clone_tag_attrs(self.tag_attributes)
  let t = to_ascii_lower(tag)
  let inner = match next_map.get(t) {
    Some(m) => m
    None => Map::new()
  }
  set_insert_all(inner, attrs)
  next_map.set(t, inner)
  Sanitizer::{
    tags: self.tags,
    clean_content_tags: self.clean_content_tags,
    generic_attributes: self.generic_attributes,
    tag_attributes: next_map,
    url_schemes: self.url_schemes,
    url_attributes: self.url_attributes,
    link_rel: self.link_rel,
    strip_comments: self.strip_comments,
  }
}

///|
pub fn Sanitizer::add_generic_attributes(
  self : Sanitizer,
  attrs : Array[String],
) -> Sanitizer {
  let next_gen = clone_bool_map(self.generic_attributes)
  set_insert_all(next_gen, attrs)
  Sanitizer::{
    tags: self.tags,
    clean_content_tags: self.clean_content_tags,
    generic_attributes: next_gen,
    tag_attributes: self.tag_attributes,
    url_schemes: self.url_schemes,
    url_attributes: self.url_attributes,
    link_rel: self.link_rel,
    strip_comments: self.strip_comments,
  }
}

///|
pub fn Sanitizer::add_url_schemes(
  self : Sanitizer,
  schemes : Array[String],
) -> Sanitizer {
  let next_schemes = clone_bool_map(self.url_schemes)
  set_insert_all(next_schemes, schemes)
  Sanitizer::{
    tags: self.tags,
    clean_content_tags: self.clean_content_tags,
    generic_attributes: self.generic_attributes,
    tag_attributes: self.tag_attributes,
    url_schemes: next_schemes,
    url_attributes: self.url_attributes,
    link_rel: self.link_rel,
    strip_comments: self.strip_comments,
  }
}

///|
pub fn Sanitizer::set_link_rel(
  self : Sanitizer,
  rel : Option[String],
) -> Sanitizer {
  Sanitizer::{
    tags: self.tags,
    clean_content_tags: self.clean_content_tags,
    generic_attributes: self.generic_attributes,
    tag_attributes: self.tag_attributes,
    url_schemes: self.url_schemes,
    url_attributes: self.url_attributes,
    link_rel: rel,
    strip_comments: self.strip_comments,
  }
}

///|
pub fn Sanitizer::set_strip_comments(
  self : Sanitizer,
  strip : Bool,
) -> Sanitizer {
  Sanitizer::{
    tags: self.tags,
    clean_content_tags: self.clean_content_tags,
    generic_attributes: self.generic_attributes,
    tag_attributes: self.tag_attributes,
    url_schemes: self.url_schemes,
    url_attributes: self.url_attributes,
    link_rel: self.link_rel,
    strip_comments: strip,
  }
}

///| Check whether an attribute name is an `on*` event handler.
fn is_event_handler_attr(name : String) -> Bool {
  name.length() >= 2 &&
  ascii_lower_byte(name.code_unit_at(0)) == 0x6F &&
  ascii_lower_byte(name.code_unit_at(1)) == 0x6E
}

///| Validate a URL attribute value against `allowed_schemes`.
///| Strips ASCII whitespace/control bytes (`<= 0x20`) when extracting scheme to block
///| obfuscations like `java&#x09;script:`, `  javascript:`, `java\nscript:`, etc.
fn is_safe_url(raw : String, allowed_schemes : Map[String, Bool]) -> Bool {
  let n = raw.length()
  let scheme_sb = StringBuilder::with_capacity(16)
  let mut i = 0
  let mut found_colon = false
  while i < n {
    let b = raw.code_unit_at(i)
    if b <= 0x20 {
      // Ignore ASCII control characters and whitespace (WHATWG URL spec strips \t \n \r anywhere)
      i = i + 1
    } else if b == 0x3A {
      found_colon = true
      break
    } else if b == 0x2F || b == 0x3F || b == 0x23 {
      // Relative URL path/query/fragment before any ':'
      return true
    } else {
      scheme_sb.write_byte(ascii_lower_byte(b).to_byte())
      i = i + 1
    }
  }
  if !found_colon {
    return true
  }
  let scheme = scheme_sb.to_string()
  if scheme.length() == 0 {
    return false
  }
  map_has(allowed_schemes, scheme)
}

///| Check if `attr_name` is permitted on `tag`.
fn Sanitizer::is_attr_allowed(
  self : Sanitizer,
  tag : String,
  attr_name : String,
) -> Bool {
  if is_event_handler_attr(attr_name) {
    return false
  }
  if map_has(self.generic_attributes, attr_name) {
    return true
  }
  match self.tag_attributes.get(tag) {
    Some(m) => map_has(m, attr_name)
    None => false
  }
}

///| Sanitize an HTML fragment using the configured whitelist (iterative, 0 recursion).
pub fn Sanitizer::clean(self : Sanitizer, html : String) -> String {
  let doc = match Document::parse_fragment(html) {
    Ok(d) => d
    Err(_) => return ""
  }
  let sb = StringBuilder::with_capacity(html.length())

  // Cursor stack: (node_id, next_child_id, emit_end_tag)
  // next_child_id == -2 means entering node; -1 means children finished
  let stack_node : Array[Int] = [0]
  let stack_child : Array[Int] = [doc.nodes[0].first_child]
  let stack_emit_end : Array[Bool] = [false]

  while stack_node.length() > 0 {
    let top = stack_node.length() - 1
    let nid = stack_node[top]
    let next_c = stack_child[top]
    let emit_end = stack_emit_end[top]
    let nd = doc.nodes[nid]

    if next_c == -2 {
      if nd.kind == 3 {
        // Text node: always escape &, <, >
        write_escaped_text(sb, doc_resolve_span(doc, nd.data_start, nd.data_end))
        let _ = stack_node.pop()
        let _ = stack_child.pop()
        let _ = stack_emit_end.pop()
      } else if nd.kind == 4 {
        // Comment
        if !self.strip_comments {
          sb.write_string("<!--")
          sb.write_string(doc_resolve_span(doc, nd.data_start, nd.data_end))
          sb.write_string("-->")
        }
        let _ = stack_node.pop()
        let _ = stack_child.pop()
        let _ = stack_emit_end.pop()
      } else if nd.kind == 2 {
        // Element
        let tag = doc_resolve_span(doc, nd.data_start, nd.data_end)
        if map_has(self.clean_content_tags, tag) {
          // Drop tag AND entire subtree
          let _ = stack_node.pop()
          let _ = stack_child.pop()
          let _ = stack_emit_end.pop()
        } else if !map_has(self.tags, tag) {
          // Unwrap tag: keep children only
          stack_child[top] = nd.first_child
          stack_emit_end[top] = false
        } else {
          // Allowed tag: emit start tag with whitelisted & validated attributes
          sb.write_byte((0x3C).to_byte())
          sb.write_string(tag)
          let is_link = tag == "a" || tag == "area"
          let has_forced_rel = is_link &&
          match self.link_rel {
            Some(_) => true
            None => false
          }
          let mut a = nd.attrs_start
          while a < nd.attrs_end {
            let ad = doc.attrs[a]
            let aname = doc_resolve_span(doc, ad.name_start, ad.name_end)
            let aval = doc_resolve_span(doc, ad.val_start, ad.val_end)
            if has_forced_rel && aname == "rel" {
              a = a + 1
              continue
            }
            if self.is_attr_allowed(tag, aname) {
              let url_ok = if map_has(self.url_attributes, aname) {
                is_safe_url(aval, self.url_schemes)
              } else {
                true
              }
              if url_ok {
                sb.write_byte((0x20).to_byte())
                sb.write_string(aname)
                sb.write_string("=\"")
                write_escaped_attr(sb, aval)
                sb.write_byte((0x22).to_byte())
              }
            }
            a = a + 1
          }
          if is_link {
            match self.link_rel {
              Some(rel_val) => {
                sb.write_string(" rel=\"")
                write_escaped_attr(sb, rel_val)
                sb.write_byte((0x22).to_byte())
              }
              None => ()
            }
          }
          sb.write_byte((0x3E).to_byte())
          if is_void_tag(tag) {
            let _ = stack_node.pop()
            let _ = stack_child.pop()
            let _ = stack_emit_end.pop()
          } else {
            stack_child[top] = nd.first_child
            stack_emit_end[top] = true
          }
        }
      } else {
        // Doctype or other: skip
        let _ = stack_node.pop()
        let _ = stack_child.pop()
        let _ = stack_emit_end.pop()
      }
    } else if next_c >= 0 {
      let cnd = doc.nodes[next_c]
      stack_child[top] = cnd.next_sibling
      stack_node.push(next_c)
      stack_child.push(-2)
      stack_emit_end.push(false)
    } else {
      if emit_end && nd.kind == 2 {
        sb.write_string("</")
        sb.write_string(doc_resolve_span(doc, nd.data_start, nd.data_end))
        sb.write_byte((0x3E).to_byte())
      }
      let _ = stack_node.pop()
      let _ = stack_child.pop()
      let _ = stack_emit_end.pop()
    }
  }
  sb.to_string()
}

///| Sanitize an HTML fragment with default `ammonia`-grade safe settings.
pub fn sanitize(html : String) -> String {
  Sanitizer::default().clean(html)
}
