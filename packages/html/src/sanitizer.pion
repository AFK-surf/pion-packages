///| ammonia-grade whitelist HTML XSS sanitizer (stub for Red phase).

///|
pub fn Sanitizer::default() -> Sanitizer {
  Sanitizer::{
    tags: Map::new(),
    clean_content_tags: Map::new(),
    generic_attributes: Map::new(),
    tag_attributes: Map::new(),
    url_schemes: Map::new(),
    url_attributes: Map::new(),
    link_rel: Some("noopener noreferrer"),
    strip_comments: true,
  }
}

///|
pub fn Sanitizer::new() -> Sanitizer {
  Sanitizer::default()
}

///|
pub fn Sanitizer::add_tags(self : Sanitizer, tags : Array[String]) -> Sanitizer {
  let _ = tags
  self
}

///|
pub fn Sanitizer::rm_tags(self : Sanitizer, tags : Array[String]) -> Sanitizer {
  let _ = tags
  self
}

///|
pub fn Sanitizer::add_tag_attributes(
  self : Sanitizer,
  tag : String,
  attrs : Array[String],
) -> Sanitizer {
  let _ = tag
  let _ = attrs
  self
}

///|
pub fn Sanitizer::add_generic_attributes(
  self : Sanitizer,
  attrs : Array[String],
) -> Sanitizer {
  let _ = attrs
  self
}

///|
pub fn Sanitizer::add_url_schemes(
  self : Sanitizer,
  schemes : Array[String],
) -> Sanitizer {
  let _ = schemes
  self
}

///|
pub fn Sanitizer::set_link_rel(
  self : Sanitizer,
  rel : Option[String],
) -> Sanitizer {
  let _ = rel
  self
}

///|
pub fn Sanitizer::set_strip_comments(
  self : Sanitizer,
  strip : Bool,
) -> Sanitizer {
  let _ = strip
  self
}

///|
pub fn Sanitizer::clean(self : Sanitizer, html : String) -> String {
  let _ = self
  let _ = html
  ""
}

///|
pub fn sanitize(html : String) -> String {
  Sanitizer::default().clean(html)
}
