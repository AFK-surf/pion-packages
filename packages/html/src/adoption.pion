///| Scope checks, active formatting list (Noah's Ark), adoption agency (8x3), and foster parenting.

fn TreeBuilder::current_ns(self : TreeBuilder) -> Int {
  let n = self.open_ns.length()
  if n == 0 {
    0
  } else {
    self.open_ns[n - 1]
  }
}

fn TreeBuilder::current_tag(self : TreeBuilder) -> String {
  let n = self.open_tags.length()
  if n == 0 {
    ""
  } else {
    self.open_tags[n - 1]
  }
}

fn TreeBuilder::has_open_tag(self : TreeBuilder, tag : String) -> Bool {
  match self.open_counts.get(tag) {
    Some(c) => c > 0
    None => false
  }
}

fn TreeBuilder::find_open_id(self : TreeBuilder, nid : Int) -> Int {
  let mut i = self.open_ids.length() - 1
  while i >= 0 {
    if self.open_ids[i] == nid {
      return i
    }
    i = i - 1
  }
  -1
}

fn TreeBuilder::has_in_scope(self : TreeBuilder, tag : String) -> Bool {
  if !self.has_open_tag(tag) {
    return false
  }
  let mut i = self.open_tags.length() - 1
  while i >= 0 {
    let ns = self.open_ns[i]
    let t = self.open_tags[i]
    if ns == 0 && t == tag {
      return true
    }
    if is_default_scope_marker(ns, t) {
      return false
    }
    i = i - 1
  }
  false
}

fn TreeBuilder::has_in_button_scope(self : TreeBuilder, tag : String) -> Bool {
  if !self.has_open_tag(tag) {
    return false
  }
  let mut i = self.open_tags.length() - 1
  while i >= 0 {
    let ns = self.open_ns[i]
    let t = self.open_tags[i]
    if ns == 0 && t == tag {
      return true
    }
    if (ns == 0 && t == "button") || is_default_scope_marker(ns, t) {
      return false
    }
    i = i - 1
  }
  false
}

fn TreeBuilder::has_in_list_item_scope(self : TreeBuilder, tag : String) -> Bool {
  if !self.has_open_tag(tag) {
    return false
  }
  let mut i = self.open_tags.length() - 1
  while i >= 0 {
    let ns = self.open_ns[i]
    let t = self.open_tags[i]
    if ns == 0 && t == tag {
      return true
    }
    if (ns == 0 && (t == "ol" || t == "ul")) || is_default_scope_marker(ns, t) {
      return false
    }
    i = i - 1
  }
  false
}

fn TreeBuilder::has_in_table_scope(self : TreeBuilder, tag : String) -> Bool {
  if !self.has_open_tag(tag) {
    return false
  }
  let mut i = self.open_tags.length() - 1
  while i >= 0 {
    let ns = self.open_ns[i]
    let t = self.open_tags[i]
    if ns == 0 && t == tag {
      return true
    }
    if ns == 0 && (t == "html" || t == "table" || t == "template") {
      return false
    }
    i = i - 1
  }
  false
}

fn TreeBuilder::has_heading_in_scope(self : TreeBuilder) -> Bool {
  let mut i = self.open_tags.length() - 1
  while i >= 0 {
    let ns = self.open_ns[i]
    let t = self.open_tags[i]
    if ns == 0 && is_heading_tag(t) {
      return true
    }
    if is_default_scope_marker(ns, t) {
      return false
    }
    i = i - 1
  }
  false
}

fn TreeBuilder::generate_implied_end_tags(
  self : TreeBuilder,
  except_tag : String,
) -> Unit {
  while self.open_tags.length() > 0 {
    let top = self.open_tags.length() - 1
    if self.open_ns[top] != 0 {
      break
    }
    let t = self.open_tags[top]
    if t != except_tag && is_implied_end_tag(t) {
      self.pop_open()
    } else {
      break
    }
  }
}

///| Remove element at `idx` from `open_ids`/`open_tags`/`open_ns` and update `open_counts`.
fn TreeBuilder::remove_open_at(self : TreeBuilder, idx : Int) -> Unit {
  let tag = self.open_tags[idx]
  self.dec_open_count(tag)
  let n = self.open_ids.length()
  let mut i = idx
  while i + 1 < n {
    self.open_ids[i] = self.open_ids[i + 1]
    self.open_tags[i] = self.open_tags[i + 1]
    self.open_ns[i] = self.open_ns[i + 1]
    i = i + 1
  }
  let _ = self.open_ids.pop()
  let _ = self.open_tags.pop()
  let _ = self.open_ns.pop()
}

///| Insert `(id, tag, ns)` at `idx` in `open_ids`/`open_tags`/`open_ns` and update `open_counts`.
fn TreeBuilder::insert_open_at(
  self : TreeBuilder,
  idx : Int,
  id : Int,
  tag : String,
  ns : Int,
) -> Unit {
  self.open_ids.push(id)
  self.open_tags.push(tag)
  self.open_ns.push(ns)
  let mut i = self.open_ids.length() - 1
  while i > idx {
    self.open_ids[i] = self.open_ids[i - 1]
    self.open_tags[i] = self.open_tags[i - 1]
    self.open_ns[i] = self.open_ns[i - 1]
    i = i - 1
  }
  self.open_ids[idx] = id
  self.open_tags[idx] = tag
  self.open_ns[idx] = ns
  self.inc_open_count(tag)
}

// ===========================================================================
// Active Formatting Elements (AFE) with Noah's Ark clause (max 3 duplicates)
// ===========================================================================

fn TreeBuilder::afe_push_marker(self : TreeBuilder) -> Unit {
  self.afe_ids.push(-1)
  self.afe_tags.push("")
}

fn TreeBuilder::afe_remove_at(self : TreeBuilder, idx : Int) -> Unit {
  let n = self.afe_ids.length()
  let mut i = idx
  while i + 1 < n {
    self.afe_ids[i] = self.afe_ids[i + 1]
    self.afe_tags[i] = self.afe_tags[i + 1]
    i = i + 1
  }
  let _ = self.afe_ids.pop()
  let _ = self.afe_tags.pop()
}

fn TreeBuilder::afe_insert_at(
  self : TreeBuilder,
  idx : Int,
  id : Int,
  tag : String,
) -> Unit {
  self.afe_ids.push(id)
  self.afe_tags.push(tag)
  let mut i = self.afe_ids.length() - 1
  while i > idx {
    self.afe_ids[i] = self.afe_ids[i - 1]
    self.afe_tags[i] = self.afe_tags[i - 1]
    i = i - 1
  }
  self.afe_ids[idx] = id
  self.afe_tags[idx] = tag
}

fn TreeBuilder::afe_clear_to_marker(self : TreeBuilder) -> Unit {
  while self.afe_ids.length() > 0 {
    let top = self.afe_ids.length() - 1
    let id = self.afe_ids[top]
    let _ = self.afe_ids.pop()
    let _ = self.afe_tags.pop()
    if id == -1 {
      break
    }
  }
}

///| Push a formatting element onto AFE, enforcing Noah's Ark (at most 3 identical entries).
fn TreeBuilder::afe_push(self : TreeBuilder, id : Int, tag : String) -> Unit {
  let mut count = 0
  let mut earliest = -1
  let mut i = self.afe_ids.length() - 1
  while i >= 0 {
    let eid = self.afe_ids[i]
    if eid == -1 {
      break
    }
    if self.afe_tags[i] == tag && self.same_node_attrs(eid, id) {
      count = count + 1
      earliest = i
    }
    i = i - 1
  }
  if count >= 3 && earliest >= 0 {
    self.afe_remove_at(earliest)
  }
  self.afe_ids.push(id)
  self.afe_tags.push(tag)
}

fn TreeBuilder::afe_find_tag_after_marker(
  self : TreeBuilder,
  tag : String,
) -> Int {
  let mut i = self.afe_ids.length() - 1
  while i >= 0 {
    let eid = self.afe_ids[i]
    if eid == -1 {
      return -1
    }
    if self.afe_tags[i] == tag {
      return i
    }
    i = i - 1
  }
  -1
}

fn TreeBuilder::afe_find_id(self : TreeBuilder, nid : Int) -> Int {
  let mut i = self.afe_ids.length() - 1
  while i >= 0 {
    if self.afe_ids[i] == nid {
      return i
    }
    i = i - 1
  }
  -1
}

///| Reconstruct the active formatting elements (WHATWG §13.2.4.3).
fn TreeBuilder::reconstruct_active_formatting(
  self : TreeBuilder,
  offset : Int,
) -> Result[Unit, HtmlError] {
  let len = self.afe_ids.length()
  if len == 0 {
    return Ok(())
  }
  let last_id = self.afe_ids[len - 1]
  if last_id == -1 || self.find_open_id(last_id) >= 0 {
    return Ok(())
  }
  let mut entry = len - 1
  while entry > 0 {
    let prev = entry - 1
    let pid = self.afe_ids[prev]
    if pid == -1 || self.find_open_id(pid) >= 0 {
      break
    }
    entry = prev
  }
  while entry < self.afe_ids.length() {
    let orig_id = self.afe_ids[entry]
    let tag = self.afe_tags[entry]
    let orig = self.nodes[orig_id]
    let clone_id = match
    self.alloc_node(
      kind_element,
      orig.data_start,
      orig.data_end,
      orig.attrs_start,
      orig.attrs_end,
      offset,
    ) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    self.insert_node_appropriate(clone_id)
    match self.push_open_ns(clone_id, tag, 0, offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    self.afe_ids[entry] = clone_id
    entry = entry + 1
  }
  Ok(())
}

// ===========================================================================
// Foster parenting helpers
// ===========================================================================

///| Check whether current insertion point requires foster parenting.
fn TreeBuilder::should_foster(self : TreeBuilder) -> Bool {
  if self.table_open_count <= 0 || self.open_tags.length() == 0 {
    return false
  }
  let top = self.open_tags.length() - 1
  self.open_ns[top] == 0 && is_table_foster_tag(self.open_tags[top])
}

///| Insert `node_id` at the appropriate place (foster parenting before `<table>` if needed).
fn TreeBuilder::insert_node_appropriate(
  self : TreeBuilder,
  node_id : Int,
) -> Unit {
  if self.should_foster() {
    let mut ti = self.open_tags.length() - 1
    while ti >= 0 {
      if self.open_ns[ti] == 0 && self.open_tags[ti] == "table" {
        break
      }
      ti = ti - 1
    }
    if ti >= 0 {
      let table_id = self.open_ids[ti]
      let tparent = self.nodes[table_id].parent
      if tparent >= 0 {
        insert_before(self.nodes, tparent, table_id, node_id)
        return ()
      }
      if ti > 0 {
        link_child(self.nodes, self.open_ids[ti - 1], node_id)
        return ()
      }
    }
  }
  link_child(self.nodes, self.current_parent(), node_id)
}

///| Insert a text node `(ds, de)` at the appropriate place, merging with adjacent text node if possible.
fn TreeBuilder::insert_text_node_appropriate(
  self : TreeBuilder,
  ds : Int,
  de : Int,
  offset : Int,
) -> Result[Unit, HtmlError] {
  if self.should_foster() {
    // Check if text is all ASCII whitespace: if so, insert normally inside table; else foster-parent!
    let txt = raw_resolve_span(self.src, self.strings, ds, de)
    let mut all_ws = true
    let mut i = 0
    while i < txt.length() {
      if !is_html_ws(txt.code_unit_at(i)) {
        all_ws = false
        break
      }
      i = i + 1
    }
    if !all_ws {
      match self.reconstruct_active_formatting(offset) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      if !self.should_foster() {
        // Reconstructed formatting element is now current_parent; insert text inside it
        let parent_id = self.current_parent()
        let tid = match self.alloc_node(kind_text, ds, de, 0, 0, offset) {
          Ok(id) => id
          Err(e) => return Err(e)
        }
        link_child(self.nodes, parent_id, tid)
        return Ok(())
      }
      let mut ti = self.open_tags.length() - 1
      while ti >= 0 {
        if self.open_ns[ti] == 0 && self.open_tags[ti] == "table" {
          break
        }
        ti = ti - 1
      }
      if ti >= 0 {
        let table_id = self.open_ids[ti]
        let tparent = self.nodes[table_id].parent
        if tparent >= 0 {
          let prev = self.nodes[table_id].prev_sibling
          if prev >= 0 && self.nodes[prev].kind == kind_text {
            let pnd = self.nodes[prev]
            let prev_txt = raw_resolve_span(self.src, self.strings, pnd.data_start, pnd.data_end)
            let (mds, mde) = intern_str(self.strings, prev_txt + txt)
            self.nodes[prev] = NodeData::{
              kind: kind_text,
              parent: pnd.parent,
              prev_sibling: pnd.prev_sibling,
              next_sibling: pnd.next_sibling,
              first_child: -1,
              last_child: -1,
              data_start: mds,
              data_end: mde,
              attrs_start: 0,
              attrs_end: 0,
            }
            return Ok(())
          }
          let tid = match self.alloc_node(kind_text, ds, de, 0, 0, offset) {
            Ok(id) => id
            Err(e) => return Err(e)
          }
          insert_before(self.nodes, tparent, table_id, tid)
          return Ok(())
        }
      }
    }
  }
  let parent_id = self.current_parent()
  let last_c = self.nodes[parent_id].last_child
  if last_c >= 0 && self.nodes[last_c].kind == kind_text {
    let lnd = self.nodes[last_c]
    let prev_txt = raw_resolve_span(self.src, self.strings, lnd.data_start, lnd.data_end)
    let cur_txt = raw_resolve_span(self.src, self.strings, ds, de)
    let (mds, mde) = intern_str(self.strings, prev_txt + cur_txt)
    self.nodes[last_c] = NodeData::{
      kind: kind_text,
      parent: lnd.parent,
      prev_sibling: lnd.prev_sibling,
      next_sibling: lnd.next_sibling,
      first_child: -1,
      last_child: -1,
      data_start: mds,
      data_end: mde,
      attrs_start: 0,
      attrs_end: 0,
    }
    return Ok(())
  }
  let tid = match self.alloc_node(kind_text, ds, de, 0, 0, offset) {
    Ok(id) => id
    Err(e) => return Err(e)
  }
  link_child(self.nodes, parent_id, tid)
  Ok(())
}

// ===========================================================================
// Real WHATWG Adoption Agency Algorithm (outer <= 8, inner <= 3, furthest block)
// ===========================================================================

fn TreeBuilder::run_adoption_agency(
  self : TreeBuilder,
  subject : String,
  offset : Int,
) -> Result[Unit, HtmlError] {
  // Fast check: if current node is subject and not in AFE, just pop it
  if self.open_tags.length() > 0 {
    let top = self.open_tags.length() - 1
    if self.open_ns[top] == 0 &&
    self.open_tags[top] == subject &&
    self.afe_find_id(self.open_ids[top]) < 0 {
      self.pop_open()
      return Ok(())
    }
  }

  let mut outer = 0
  while outer < 8 {
    outer = outer + 1
    let afe_idx = self.afe_find_tag_after_marker(subject)
    if afe_idx < 0 {
      // Fallback: "any other end tag"
      self.close_any_other_end_tag(subject)
      return Ok(())
    }
    let fe_id = self.afe_ids[afe_idx]
    let fe_open_idx = self.find_open_id(fe_id)
    if fe_open_idx < 0 {
      self.afe_remove_at(afe_idx)
      return Ok(())
    }
    if !self.has_in_scope(subject) {
      return Ok(())
    }

    // Find furthest block: lowest index > fe_open_idx that is a special element
    let mut fb_open_idx = -1
    let mut k = fe_open_idx + 1
    while k < self.open_tags.length() {
      if self.open_ns[k] == 0 && is_special_html_tag(self.open_tags[k]) {
        fb_open_idx = k
        break
      }
      k = k + 1
    }

    if fb_open_idx < 0 {
      // No furthest block: pop open elements down to and including fe_open_idx
      while self.open_tags.length() > fe_open_idx {
        self.pop_open()
      }
      self.afe_remove_at(afe_idx)
      return Ok(())
    }

    let fb_id = self.open_ids[fb_open_idx]
    let common_ancestor = if fe_open_idx > 0 {
      self.open_ids[fe_open_idx - 1]
    } else {
      0
    }
    let mut bookmark = afe_idx
    let mut node_open_idx = fb_open_idx
    let mut last_node = fb_id
    let mut inner = 0

    while true {
      inner = inner + 1
      node_open_idx = node_open_idx - 1
      if node_open_idx < 0 {
        break
      }
      let node_id = self.open_ids[node_open_idx]
      if node_id == fe_id {
        break
      }
      let mut node_afe_idx = self.afe_find_id(node_id)
      if inner > 3 && node_afe_idx >= 0 {
        self.afe_remove_at(node_afe_idx)
        if node_afe_idx < bookmark {
          bookmark = bookmark - 1
        }
        node_afe_idx = -1
      }
      if node_afe_idx < 0 {
        self.remove_open_at(node_open_idx)
        fb_open_idx = fb_open_idx - 1
        continue
      }
      // Clone node
      let orig = self.nodes[node_id]
      let clone_id = match
      self.alloc_node(
        kind_element,
        orig.data_start,
        orig.data_end,
        orig.attrs_start,
        orig.attrs_end,
        offset,
      ) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      self.afe_ids[node_afe_idx] = clone_id
      self.open_ids[node_open_idx] = clone_id
      if last_node == fb_id {
        bookmark = node_afe_idx + 1
      }
      unlink_node(self.nodes, last_node)
      link_child(self.nodes, clone_id, last_node)
      last_node = clone_id
    }

    // Insert last_node into common_ancestor (with foster parenting if common_ancestor is table-foster)
    unlink_node(self.nodes, last_node)
    let ca_tag = if fe_open_idx > 0 { self.open_tags[fe_open_idx - 1] } else { "" }
    if self.table_open_count > 0 && is_table_foster_tag(ca_tag) {
      // Foster parent last_node before table
      let mut ti = fe_open_idx - 1
      while ti >= 0 && self.open_tags[ti] != "table" {
        ti = ti - 1
      }
      if ti >= 0 && self.nodes[self.open_ids[ti]].parent >= 0 {
        let tid = self.open_ids[ti]
        insert_before(self.nodes, self.nodes[tid].parent, tid, last_node)
      } else {
        link_child(self.nodes, common_ancestor, last_node)
      }
    } else {
      link_child(self.nodes, common_ancestor, last_node)
    }

    // Create new clone of formatting_element and move furthest_block's children into it
    let fe_orig = self.nodes[fe_id]
    let new_fe_id = match
    self.alloc_node(
      kind_element,
      fe_orig.data_start,
      fe_orig.data_end,
      fe_orig.attrs_start,
      fe_orig.attrs_end,
      offset,
    ) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    move_all_children(self.nodes, fb_id, new_fe_id)
    link_child(self.nodes, fb_id, new_fe_id)

    // Remove old fe from AFE and insert new_fe at bookmark
    let cur_fe_afe = self.afe_find_id(fe_id)
    if cur_fe_afe >= 0 {
      self.afe_remove_at(cur_fe_afe)
      if cur_fe_afe < bookmark {
        bookmark = bookmark - 1
      }
    }
    if bookmark < 0 {
      bookmark = 0
    }
    if bookmark > self.afe_ids.length() {
      bookmark = self.afe_ids.length()
    }
    self.afe_insert_at(bookmark, new_fe_id, subject)

    // Remove old fe from open stack and insert new_fe right after furthest_block
    let cur_fe_open = self.find_open_id(fe_id)
    if cur_fe_open >= 0 {
      self.remove_open_at(cur_fe_open)
      if cur_fe_open < fb_open_idx {
        fb_open_idx = fb_open_idx - 1
      }
    }
    self.insert_open_at(fb_open_idx + 1, new_fe_id, subject, 0)
  }
  Ok(())
}

///| Standard "any other end tag" rule in `in body` mode.
fn TreeBuilder::close_any_other_end_tag(
  self : TreeBuilder,
  tag : String,
) -> Unit {
  if !self.has_open_tag(tag) {
    return ()
  }
  let mut i = self.open_tags.length() - 1
  while i >= 0 {
    let ns = self.open_ns[i]
    let t = self.open_tags[i]
    if ns == 0 && t == tag {
      self.generate_implied_end_tags(tag)
      while self.open_tags.length() > i {
        self.pop_open()
      }
      return ()
    }
    if ns == 0 && is_special_html_tag(t) {
      return ()
    }
    i = i - 1
  }
}
