///| Core types, errors, limits, flat-array DOM storage, selector AST, and sanitizer config for `html`.

///| Categories of HTML5 parsing and CSS selector errors.
pub enum HtmlErrorKind {
  LimitExceeded
  InvalidSelector
  Unimplemented
}

///|
pub fn html_error_kind_eq(a : HtmlErrorKind, b : HtmlErrorKind) -> Bool {
  match (a, b) {
    (HtmlErrorKind::LimitExceeded, HtmlErrorKind::LimitExceeded) => true
    (HtmlErrorKind::InvalidSelector, HtmlErrorKind::InvalidSelector) => true
    (HtmlErrorKind::Unimplemented, HtmlErrorKind::Unimplemented) => true
    _ => false
  }
}

///| Structured HTML/CSS error with byte offset and message.
pub struct HtmlError {
  pub kind : HtmlErrorKind
  pub offset : Int
  pub message : String
}

///|
pub fn HtmlError::new(
  kind : HtmlErrorKind,
  offset : Int,
  message : String,
) -> HtmlError {
  HtmlError::{ kind: kind, offset: offset, message: message }
}

///|
pub fn HtmlError::to_string(self : HtmlError) -> String {
  self.message + " (offset " + self.offset.to_string() + ")"
}

///| Resource and security limits enforced during parsing.
pub struct Limits {
  pub max_depth : Int
  pub max_nodes : Int
  pub max_attributes : Int
}

///|
pub fn Limits::default() -> Limits {
  Limits::{ max_depth: 65536, max_nodes: 1000000, max_attributes: 100000 }
}

///| Parsing options for `Document::parse_with_options` and `Document::parse_fragment_with_options`.
pub struct ParseOptions {
  pub limits : Limits
}

///|
pub fn ParseOptions::default() -> ParseOptions {
  ParseOptions::{ limits: Limits::default() }
}

///| Node kinds in the flat read-only HTML DOM tree.
pub enum NodeType {
  Document
  Doctype
  Element
  Text
  Comment
}

///|
pub fn node_type_eq(a : NodeType, b : NodeType) -> Bool {
  match (a, b) {
    (NodeType::Document, NodeType::Document) => true
    (NodeType::Doctype, NodeType::Doctype) => true
    (NodeType::Element, NodeType::Element) => true
    (NodeType::Text, NodeType::Text) => true
    (NodeType::Comment, NodeType::Comment) => true
    _ => false
  }
}

///| An HTML element attribute (lowercased name + decoded value).
pub struct Attribute {
  pub name : String
  pub value : String
}

///| Internal flat-array node storage entry.
///| `kind`: 0=Document, 1=Doctype, 2=Element, 3=Text, 4=Comment.
///| `data_start` / `data_end`: byte span in `doc.src`, or negative pool index `-(idx + 1)` when `data_start < 0`.
pub val struct NodeData {
  pub kind : Int
  pub parent : Int
  pub prev_sibling : Int
  pub next_sibling : Int
  pub first_child : Int
  pub last_child : Int
  pub data_start : Int
  pub data_end : Int
  pub attrs_start : Int
  pub attrs_end : Int
}

///| Internal flat-array attribute storage entry.
///| `name_start`/`name_end` and `val_start`/`val_end` are source spans or `-(idx + 1)` into `doc.strings`.
pub val struct AttrData {
  pub name_start : Int
  pub name_end : Int
  pub val_start : Int
  pub val_end : Int
}

///| Immutable flat-array HTML DOM document.
pub struct Document {
  pub src : String
  pub strings : Array[String]
  pub nodes : Array[NodeData]
  pub attrs : Array[AttrData]
}

///| Lightweight handle to a node inside a `Document`.
pub struct Node {
  pub doc : Document
  pub id : Int
}

///| Attribute match operator for CSS selectors.
pub enum AttrOp {
  Exists
  Exact
  Includes
  DashMatch
  Prefix
  Suffix
  Substring
}

///| Single attribute matcher in a compound CSS selector.
pub struct AttrMatcher {
  pub name : String
  pub op : AttrOp
  pub value : String
  pub case_insensitive : Bool
}

///| Relative CSS selector inside `:has(...)`.
pub struct RelativeSelector {
  pub leading : Combinator
  pub complex : ComplexSelector
}

///| Structural or logical pseudo-class in a compound CSS selector.
pub enum PseudoClass {
  FirstChild
  LastChild
  OnlyChild
  NthChild(Int, Int)
  NthLastChild(Int, Int)
  NthOfType(Int, Int)
  NthLastOfType(Int, Int)
  OnlyOfType
  Empty
  Root
  Scope
  FirstOfType
  LastOfType
  Not(Array[ComplexSelector])
  Is(Array[ComplexSelector])
  Has(Array[RelativeSelector])
}

///| Compound CSS selector (tag, id, classes, attributes, pseudo-classes).
pub struct CompoundSelector {
  pub tag : Option[String]
  pub id : Option[String]
  pub classes : Array[String]
  pub attrs : Array[AttrMatcher]
  pub pseudos : Array[PseudoClass]
  pub never_matches : Bool
}

///| Combinator linking two compound selectors.
pub enum Combinator {
  Descendant
  Child
  NextSibling
  SubsequentSibling
}

///| Complex CSS selector: sequence of compound selectors joined by combinators.
///| Stored left-to-right: `compounds[0] combinators[0] compounds[1] ... compounds[n-1]`.
pub struct ComplexSelector {
  pub compounds : Array[CompoundSelector]
  pub combinators : Array[Combinator]
}

///| Compiled CSS selector list (comma-separated).
pub struct Selector {
  pub items : Array[ComplexSelector]
}

///| Configurable `ammonia`-grade whitelist HTML XSS sanitizer.
pub struct Sanitizer {
  pub tags : Map[String, Bool]
  pub clean_content_tags : Map[String, Bool]
  pub generic_attributes : Map[String, Bool]
  pub tag_attributes : Map[String, Map[String, Bool]]
  pub url_schemes : Map[String, Bool]
  pub url_attributes : Map[String, Bool]
  pub link_rel : Option[String]
  pub strip_comments : Bool
}
