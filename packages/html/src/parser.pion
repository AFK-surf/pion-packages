///| WHATWG HTML5 tokenizer, fault-tolerant tree builder, and flat-array DOM accessors.

let kind_document : Int = 0

let kind_doctype : Int = 1

let kind_element : Int = 2

let kind_text : Int = 3

let kind_comment : Int = 4

///| Resolve a `(start, end)` span from `doc.src` or `doc.strings` (`start < 0` => pool index `-(start + 1)`).
fn doc_resolve_span(doc : Document, start : Int, end : Int) -> String {
  if start < 0 {
    doc.strings[-(start + 1)]
  } else if start == end {
    ""
  } else {
    doc.src.slice(start, end)
  }
}

///| Resolve a `(start, end)` span from `(src, strings)`.
fn raw_resolve_span(
  src : String,
  strings : Array[String],
  start : Int,
  end : Int,
) -> String {
  if start < 0 {
    strings[-(start + 1)]
  } else if start == end {
    ""
  } else {
    src.slice(start, end)
  }
}

///| Intern a lowercase ASCII slice: zero-copy `(start, end)` if already lowercase, else pool.
fn intern_lower_span(
  src : String,
  strings : Array[String],
  start : Int,
  end : Int,
) -> (Int, Int) {
  let mut i = start
  let mut has_upper = false
  while i < end {
    let b = src.code_unit_at(i)
    if b >= 0x41 && b <= 0x5A {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return (start, end)
  }
  let sb = StringBuilder::with_capacity(end - start)
  i = start
  while i < end {
    sb.write_byte(ascii_lower_byte(src.code_unit_at(i)).to_byte())
    i = i + 1
  }
  let idx = strings.length()
  strings.push(sb.to_string())
  (-(idx + 1), 0)
}

///| Intern an explicit string into `strings` pool.
fn intern_str(strings : Array[String], s : String) -> (Int, Int) {
  if s.length() == 0 {
    return (0, 0)
  }
  let idx = strings.length()
  strings.push(s)
  (-(idx + 1), 0)
}

///| Check whether a lowercased tag name is an HTML5 void element (no end tag).
fn is_void_tag(tag : String) -> Bool {
  match tag {
    "area" | "base" | "basefont" | "bgsound" | "br" | "col" | "embed" | "frame" | "hr" | "img" | "input" | "keygen" | "link" | "meta" | "param" | "source" | "track" | "wbr" =>
    true
    _ => false
  }
}

///| Check whether a lowercased tag name uses RAWTEXT tokenizer state.
fn is_rawtext_tag(tag : String) -> Bool {
  match tag {
    "script" | "style" | "xmp" | "iframe" | "noembed" | "noframes" | "noscript" =>
    true
    _ => false
  }
}

///| Check whether a lowercased tag name uses RCDATA tokenizer state.
fn is_rcdata_tag(tag : String) -> Bool {
  tag == "title" || tag == "textarea"
}

///| Check whether a lowercased tag name is a formatting element for adoption agency.
fn is_formatting_tag(tag : String) -> Bool {
  match tag {
    "a" | "b" | "big" | "code" | "em" | "font" | "i" | "nobr" | "s" | "small" | "strike" | "strong" | "tt" | "u" =>
    true
    _ => false
  }
}

///| Check whether a start tag auto-closes an open `<p>` element.
fn closes_open_p(tag : String) -> Bool {
  match tag {
    "address" | "article" | "aside" | "blockquote" | "center" | "details" | "dialog" | "dir" | "dd" | "div" | "dl" | "dt" | "fieldset" | "figcaption" | "figure" | "footer" | "form" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "header" | "hgroup" | "hr" | "li" | "listing" | "main" | "menu" | "nav" | "ol" | "p" | "pre" | "search" | "section" | "summary" | "table" | "ul" =>
    true
    _ => false
  }
}

///| Check whether a tag is a heading (`h1`..`h6`).
fn is_heading_tag(tag : String) -> Bool {
  match tag {
    "h1" | "h2" | "h3" | "h4" | "h5" | "h6" => true
    _ => false
  }
}

///| Check whether a tag belongs in `<head>` when encountered before `<body>`.
fn is_head_tag(tag : String) -> Bool {
  match tag {
    "base" | "basefont" | "bgsound" | "link" | "meta" | "title" | "noscript" | "noframes" | "style" | "script" | "template" =>
    true
    _ => false
  }
}

///| Check whether a tag is a `<p>` scope boundary.
fn is_p_scope_boundary(tag : String) -> Bool {
  match tag {
    "table" | "td" | "th" | "caption" | "html" | "body" | "applet" | "marquee" | "object" | "template" =>
    true
    _ => false
  }
}

///| Append child node `child_id` to `parent_id` in `nodes`.
fn link_child(nodes : Array[NodeData], parent_id : Int, child_id : Int) -> Unit {
  let p = nodes[parent_id]
  let prev = p.last_child
  if prev >= 0 {
    let pn = nodes[prev]
    nodes[prev] = NodeData::{
      kind: pn.kind,
      parent: pn.parent,
      prev_sibling: pn.prev_sibling,
      next_sibling: child_id,
      first_child: pn.first_child,
      last_child: pn.last_child,
      data_start: pn.data_start,
      data_end: pn.data_end,
      attrs_start: pn.attrs_start,
      attrs_end: pn.attrs_end,
    }
  }
  let cn = nodes[child_id]
  nodes[child_id] = NodeData::{
    kind: cn.kind,
    parent: parent_id,
    prev_sibling: prev,
    next_sibling: -1,
    first_child: cn.first_child,
    last_child: cn.last_child,
    data_start: cn.data_start,
    data_end: cn.data_end,
    attrs_start: cn.attrs_start,
    attrs_end: cn.attrs_end,
  }
  let new_first = if p.first_child < 0 { child_id } else { p.first_child }
  nodes[parent_id] = NodeData::{
    kind: p.kind,
    parent: p.parent,
    prev_sibling: p.prev_sibling,
    next_sibling: p.next_sibling,
    first_child: new_first,
    last_child: child_id,
    data_start: p.data_start,
    data_end: p.data_end,
    attrs_start: p.attrs_start,
    attrs_end: p.attrs_end,
  }
}

///| Mutable HTML5 tree-builder state.
struct TreeBuilder {
  src : String
  strings : Array[String]
  nodes : Array[NodeData]
  attrs : Array[AttrData]
  opts : ParseOptions
  is_fragment : Bool
  open_ids : Array[Int]
  open_tags : Array[String]
  open_ns : Array[Int]
  open_counts : Map[String, Int]
  afe_ids : Array[Int]
  afe_tags : Array[String]
  mut p_open_count : Int
  mut table_open_count : Int
  mut html_id : Int
  mut head_id : Int
  mut body_id : Int
  mut frameset_id : Int
  mut form_id : Int
  mut head_closed : Bool
  mut body_closed : Bool
  mut html_closed : Bool
  mut has_doctype : Bool
  mut frameset_ok : Bool
  mut has_pending_text : Bool
  mut pending_text_start : Int
  mut pending_text_end : Int
  mut pending_text_buf : StringBuilder
  mut pending_text_use_buf : Bool
  mut pending_text_raw : Bool
}

fn TreeBuilder::new(
  src : String,
  opts : ParseOptions,
  is_fragment : Bool,
) -> TreeBuilder {
  let slen = src.length()
  let mut est_nodes = slen / 24 + 16
  if est_nodes > 4096 {
    est_nodes = 4096
  }
  if opts.limits.max_nodes > 0 && est_nodes > opts.limits.max_nodes {
    est_nodes = opts.limits.max_nodes
  }
  let mut est_attrs = slen / 32 + 16
  if est_attrs > 4096 {
    est_attrs = 4096
  }
  let nodes : Array[NodeData] = Array::with_capacity(est_nodes)
  nodes.push(
    NodeData::{
      kind: kind_document,
      parent: -1,
      prev_sibling: -1,
      next_sibling: -1,
      first_child: -1,
      last_child: -1,
      data_start: 0,
      data_end: 0,
      attrs_start: 0,
      attrs_end: 0,
    },
  )
  TreeBuilder::{
    src: src,
    strings: Array::with_capacity(64),
    nodes: nodes,
    attrs: Array::with_capacity(est_attrs),
    opts: opts,
    is_fragment: is_fragment,
    open_ids: Array::with_capacity(32),
    open_tags: Array::with_capacity(32),
    open_ns: Array::with_capacity(32),
    open_counts: Map::new(),
    afe_ids: Array::with_capacity(16),
    afe_tags: Array::with_capacity(16),
    p_open_count: 0,
    table_open_count: 0,
    html_id: -1,
    head_id: -1,
    body_id: -1,
    frameset_id: -1,
    form_id: -1,
    head_closed: false,
    body_closed: false,
    html_closed: false,
    has_doctype: false,
    frameset_ok: true,
    has_pending_text: false,
    pending_text_start: 0,
    pending_text_end: 0,
    pending_text_buf: StringBuilder::with_capacity(64),
    pending_text_use_buf: false,
    pending_text_raw: false,
  }
}

fn TreeBuilder::inc_open_count(self : TreeBuilder, tag : String) -> Unit {
  let prev = match self.open_counts.get(tag) {
    Some(c) => c
    None => 0
  }
  self.open_counts.set(tag, prev + 1)
  if tag == "p" {
    self.p_open_count = self.p_open_count + 1
  } else if tag == "table" {
    self.table_open_count = self.table_open_count + 1
  }
}

fn TreeBuilder::dec_open_count(self : TreeBuilder, tag : String) -> Unit {
  let prev = match self.open_counts.get(tag) {
    Some(c) => c
    None => 0
  }
  if prev > 0 {
    self.open_counts.set(tag, prev - 1)
  }
  if tag == "p" && self.p_open_count > 0 {
    self.p_open_count = self.p_open_count - 1
  } else if tag == "table" && self.table_open_count > 0 {
    self.table_open_count = self.table_open_count - 1
  }
}

fn TreeBuilder::current_parent(self : TreeBuilder) -> Int {
  let n = self.open_ids.length()
  if n == 0 {
    0
  } else {
    self.open_ids[n - 1]
  }
}

fn TreeBuilder::alloc_node(
  self : TreeBuilder,
  kind : Int,
  data_start : Int,
  data_end : Int,
  attrs_start : Int,
  attrs_end : Int,
  offset : Int,
) -> Result[Int, HtmlError] {
  if self.nodes.length() >= self.opts.limits.max_nodes {
    return Err(
      HtmlError::new(
        HtmlErrorKind::LimitExceeded,
        offset,
        "max_nodes limit exceeded",
      ),
    )
  }
  let id = self.nodes.length()
  self.nodes.push(
    NodeData::{
      kind: kind,
      parent: -1,
      prev_sibling: -1,
      next_sibling: -1,
      first_child: -1,
      last_child: -1,
      data_start: data_start,
      data_end: data_end,
      attrs_start: attrs_start,
      attrs_end: attrs_end,
    },
  )
  Ok(id)
}

fn TreeBuilder::push_open_ns(
  self : TreeBuilder,
  id : Int,
  tag : String,
  ns : Int,
  offset : Int,
) -> Result[Unit, HtmlError] {
  if self.open_ids.length() >= self.opts.limits.max_depth {
    return Err(
      HtmlError::new(
        HtmlErrorKind::LimitExceeded,
        offset,
        "max_depth limit exceeded",
      ),
    )
  }
  self.open_ids.push(id)
  self.open_tags.push(tag)
  self.open_ns.push(ns)
  self.inc_open_count(tag)
  Ok(())
}

fn TreeBuilder::push_open(
  self : TreeBuilder,
  id : Int,
  tag : String,
  offset : Int,
) -> Result[Unit, HtmlError] {
  self.push_open_ns(id, tag, 0, offset)
}

fn TreeBuilder::pop_open(self : TreeBuilder) -> Unit {
  if self.open_ids.length() > 0 {
    let top = self.open_tags.length() - 1
    let tag = self.open_tags[top]
    let _ = self.open_ids.pop()
    let _ = self.open_tags.pop()
    let _ = self.open_ns.pop()
    self.dec_open_count(tag)
  }
}

///| Flush any buffered pending text into a Text node at the appropriate insertion place.
fn TreeBuilder::flush_text(
  self : TreeBuilder,
  offset : Int,
) -> Result[Unit, HtmlError] {
  if !self.has_pending_text {
    return Ok(())
  }
  self.has_pending_text = false
  let was_raw = self.pending_text_raw
  self.pending_text_raw = false
  let (ds, de) = if self.pending_text_use_buf {
    let s = self.pending_text_buf.to_string()
    self.pending_text_buf = StringBuilder::with_capacity(64)
    self.pending_text_use_buf = false
    if s.length() == 0 {
      return Ok(())
    }
    intern_str(self.strings, s)
  } else {
    if self.pending_text_start == self.pending_text_end {
      return Ok(())
    }
    (self.pending_text_start, self.pending_text_end)
  }
  if !was_raw && self.current_ns() == 0 {
    // Non-whitespace text in body clears frameset_ok
    if self.frameset_ok {
      let t = raw_resolve_span(self.src, self.strings, ds, de)
      let mut k = 0
      while k < t.length() {
        if !is_html_ws(t.code_unit_at(k)) {
          self.frameset_ok = false
          break
        }
        k = k + 1
      }
    }
    if !self.should_foster() {
      match self.reconstruct_active_formatting(offset) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    }
  }
  self.insert_text_node_appropriate(ds, de, offset)
}

///| Queue a raw slice of text (without entity decoding, e.g. RAWTEXT or entity-free text).
fn TreeBuilder::append_text_span(
  self : TreeBuilder,
  start : Int,
  end : Int,
) -> Unit {
  if start >= end {
    return ()
  }
  if !self.has_pending_text {
    self.has_pending_text = true
    self.pending_text_start = start
    self.pending_text_end = end
    self.pending_text_use_buf = false
  } else if !self.pending_text_use_buf && self.pending_text_end == start {
    self.pending_text_end = end
  } else {
    if !self.pending_text_use_buf {
      self.pending_text_use_buf = true
      self.pending_text_buf = StringBuilder::with_capacity(
        (self.pending_text_end - self.pending_text_start) + (end - start) + 32,
      )
      self.pending_text_buf.write_string(
        self.src.slice(self.pending_text_start, self.pending_text_end),
      )
    }
    self.pending_text_buf.write_string(self.src.slice(start, end))
  }
}

///| Queue text that needs entity decoding (`&`, `\r`, or `\x00` present) in body text (drops raw NUL).
fn TreeBuilder::append_text_decoded(
  self : TreeBuilder,
  start : Int,
  end : Int,
) -> Unit {
  if start >= end {
    return ()
  }
  if !self.has_pending_text {
    self.has_pending_text = true
    self.pending_text_use_buf = true
    self.pending_text_buf = StringBuilder::with_capacity(end - start)
  } else if !self.pending_text_use_buf {
    self.pending_text_use_buf = true
    self.pending_text_buf = StringBuilder::with_capacity(
      (self.pending_text_end - self.pending_text_start) + (end - start) + 32,
    )
    self.pending_text_buf.write_string(
      self.src.slice(self.pending_text_start, self.pending_text_end),
    )
  }
  decode_entities_ex(self.src, start, end, false, false, self.pending_text_buf)
}

///| Queue RCDATA text (decodes entities, normalizes CR, replaces NUL with U+FFFD).
fn TreeBuilder::append_rcdata_decoded(
  self : TreeBuilder,
  start : Int,
  end : Int,
) -> Unit {
  if start >= end {
    return ()
  }
  self.pending_text_raw = true
  if !self.has_pending_text {
    self.has_pending_text = true
    self.pending_text_use_buf = true
    self.pending_text_buf = StringBuilder::with_capacity(end - start)
  } else if !self.pending_text_use_buf {
    self.pending_text_use_buf = true
    self.pending_text_buf = StringBuilder::with_capacity(
      (self.pending_text_end - self.pending_text_start) + (end - start) + 32,
    )
    self.pending_text_buf.write_string(
      self.src.slice(self.pending_text_start, self.pending_text_end),
    )
  }
  decode_entities_ex(self.src, start, end, false, true, self.pending_text_buf)
}

///| Queue RAWTEXT span (normalizes CR->LF and NUL->U+FFFD without entity decoding).
fn TreeBuilder::append_rawtext_span(
  self : TreeBuilder,
  start : Int,
  end : Int,
) -> Unit {
  if start >= end {
    return ()
  }
  self.pending_text_raw = true
  if !needs_rawtext_normalize(self.src, start, end) {
    self.append_text_span(start, end)
    return ()
  }
  if !self.has_pending_text {
    self.has_pending_text = true
    self.pending_text_use_buf = true
    self.pending_text_buf = StringBuilder::with_capacity(end - start)
  } else if !self.pending_text_use_buf {
    self.pending_text_use_buf = true
    self.pending_text_buf = StringBuilder::with_capacity(
      (self.pending_text_end - self.pending_text_start) + (end - start) + 32,
    )
    self.pending_text_buf.write_string(
      self.src.slice(self.pending_text_start, self.pending_text_end),
    )
  }
  normalize_rawtext_into(self.src, start, end, self.pending_text_buf)
}

///| Queue a single literal ASCII byte into pending text.
fn TreeBuilder::append_text_byte(self : TreeBuilder, b : Int) -> Unit {
  if !self.has_pending_text {
    self.has_pending_text = true
    self.pending_text_use_buf = true
    self.pending_text_buf = StringBuilder::with_capacity(32)
  } else if !self.pending_text_use_buf {
    self.pending_text_use_buf = true
    self.pending_text_buf = StringBuilder::with_capacity(
      (self.pending_text_end - self.pending_text_start) + 32,
    )
    self.pending_text_buf.write_string(
      self.src.slice(self.pending_text_start, self.pending_text_end),
    )
  }
  self.pending_text_buf.write_byte(b.to_byte())
}

///| Ensure `<html>` exists in full document mode.
fn TreeBuilder::ensure_html(
  self : TreeBuilder,
  offset : Int,
) -> Result[Unit, HtmlError] {
  if self.is_fragment || self.html_id >= 0 {
    return Ok(())
  }
  let (ds, de) = intern_str(self.strings, "html")
  let id = match self.alloc_node(kind_element, ds, de, 0, 0, offset) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  link_child(self.nodes, 0, id)
  self.html_id = id
  self.push_open(id, "html", offset)
}

///| Ensure `<head>` exists in full document mode.
fn TreeBuilder::ensure_head(
  self : TreeBuilder,
  offset : Int,
) -> Result[Unit, HtmlError] {
  if self.is_fragment || self.head_id >= 0 {
    return Ok(())
  }
  match self.ensure_html(offset) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  let (ds, de) = intern_str(self.strings, "head")
  let id = match self.alloc_node(kind_element, ds, de, 0, 0, offset) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  link_child(self.nodes, self.html_id, id)
  self.head_id = id
  self.push_open(id, "head", offset)
}

///| Ensure `<body>` exists in full document mode (closing `<head>` if open).
fn TreeBuilder::ensure_body(
  self : TreeBuilder,
  offset : Int,
) -> Result[Unit, HtmlError] {
  if self.is_fragment || self.body_id >= 0 {
    return Ok(())
  }
  match self.ensure_html(offset) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  if self.head_id < 0 {
    let (hds, hde) = intern_str(self.strings, "head")
    let hid = match self.alloc_node(kind_element, hds, hde, 0, 0, offset) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    link_child(self.nodes, self.html_id, hid)
    self.head_id = hid
  } else {
    // Pop back to `html` if `head` is still on open stack
    while self.open_ids.length() > 0 &&
    self.open_ids[self.open_ids.length() - 1] != self.html_id {
      self.pop_open()
    }
  }
  let (ds, de) = intern_str(self.strings, "body")
  let id = match self.alloc_node(kind_element, ds, de, 0, 0, offset) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  link_child(self.nodes, self.html_id, id)
  self.body_id = id
  self.push_open(id, "body", offset)
}

///| Close an open `<p>` element in button scope if present (O(1) fast skip when no `<p>` is open).
fn TreeBuilder::close_p_in_scope(self : TreeBuilder) -> Unit {
  if self.p_open_count <= 0 {
    return ()
  }
  if !self.has_in_button_scope("p") {
    return ()
  }
  self.generate_implied_end_tags("p")
  while self.open_tags.length() > 0 {
    let top = self.open_tags.length() - 1
    let is_p = self.open_ns[top] == 0 && self.open_tags[top] == "p"
    self.pop_open()
    if is_p {
      return ()
    }
  }
}

///| Insert an implicit element (e.g. `<tbody>`, `<tr>`, `<colgroup>`) onto the open stack.
fn TreeBuilder::insert_implicit_elem(
  self : TreeBuilder,
  tag : String,
  offset : Int,
) -> Result[Unit, HtmlError] {
  let (ds, de) = intern_str(self.strings, tag)
  let id = match self.alloc_node(kind_element, ds, de, 0, 0, offset) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  link_child(self.nodes, self.current_parent(), id)
  self.push_open(id, tag, offset)
}

///| Check whether a tag is a table-only element.
fn is_table_inner_tag(tag : String) -> Bool {
  match tag {
    "caption" | "colgroup" | "col" | "tbody" | "thead" | "tfoot" | "tr" | "td" | "th" =>
    true
    _ => false
  }
}

///| Check whether a tag closes cells and resets back to table/tbody/tr.
fn TreeBuilder::close_cell(self : TreeBuilder) -> Unit {
  self.generate_implied_end_tags("")
  while self.open_tags.length() > 0 {
    let top = self.open_tags.length() - 1
    let t = self.open_tags[top]
    let ns = self.open_ns[top]
    self.pop_open()
    if ns == 0 && (t == "td" || t == "th") {
      break
    }
  }
  self.afe_clear_to_marker()
}

///| Handle start tag tree-building insertion rules.
fn TreeBuilder::handle_start_tag(
  self : TreeBuilder,
  raw_tag : String,
  raw_tag_ds : Int,
  raw_tag_de : Int,
  attrs_start : Int,
  attrs_end : Int,
  self_closing : Bool,
  offset : Int,
) -> Result[Unit, HtmlError] {
  match self.flush_text(offset) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }

  // Foreign content (SVG / MathML) handling
  let cur_ns = self.current_ns()
  if cur_ns != 0 && !is_foreign_html_integration(cur_ns, self.current_tag()) {
    if is_foreign_breakout_tag(raw_tag) {
      while self.open_ns.length() > 0 && self.open_ns[self.open_ns.length() - 1] != 0 {
        if is_foreign_html_integration(
          self.open_ns[self.open_ns.length() - 1],
          self.open_tags[self.open_tags.length() - 1],
        ) {
          break
        }
        self.pop_open()
      }
      // Fall through to HTML rules
    } else {
      let adj_tag = if cur_ns == 1 { adjust_svg_tag(raw_tag) } else { raw_tag }
      let (fds, fde) = if adj_tag == raw_tag {
        (raw_tag_ds, raw_tag_de)
      } else {
        intern_str(self.strings, adj_tag)
      }
      self.adjust_foreign_attrs(cur_ns, attrs_start, attrs_end)
      let id = match
      self.alloc_node(kind_element, fds, fde, attrs_start, attrs_end, offset) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      link_child(self.nodes, self.current_parent(), id)
      if !self_closing {
        match self.push_open_ns(id, adj_tag, cur_ns, offset) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
      return Ok(())
    }
  }

  // `<image>` -> `<img>`
  let (tag, tag_ds, tag_de) = if raw_tag == "image" {
    let (ids, ide) = intern_str(self.strings, "img")
    ("img", ids, ide)
  } else {
    (raw_tag, raw_tag_ds, raw_tag_de)
  }

  // Document-mode structural placement (`html`, `head`, `body`, `frameset`)
  if !self.is_fragment {
    if tag == "html" {
      if self.html_id >= 0 {
        self.merge_attrs(self.html_id, attrs_start, attrs_end)
        return Ok(())
      }
      let id = match
      self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      link_child(self.nodes, 0, id)
      self.html_id = id
      return self.push_open(id, "html", offset)
    } else if tag == "head" {
      if self.head_id >= 0 {
        return Ok(())
      }
      match self.ensure_html(offset) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      let id = match
      self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      link_child(self.nodes, self.html_id, id)
      self.head_id = id
      return self.push_open(id, "head", offset)
    } else if tag == "body" {
      if self.body_id >= 0 {
        self.merge_attrs(self.body_id, attrs_start, attrs_end)
        self.frameset_ok = false
        return Ok(())
      }
      if self.frameset_id >= 0 {
        return Ok(())
      }
      match self.ensure_html(offset) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      if self.head_id < 0 {
        let (hds, hde) = intern_str(self.strings, "head")
        let hid = match self.alloc_node(kind_element, hds, hde, 0, 0, offset) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        link_child(self.nodes, self.html_id, hid)
        self.head_id = hid
      } else {
        while self.open_ids.length() > 0 &&
        self.open_ids[self.open_ids.length() - 1] != self.html_id {
          self.pop_open()
        }
      }
      self.head_closed = true
      let id = match
      self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      link_child(self.nodes, self.html_id, id)
      self.body_id = id
      self.frameset_ok = false
      return self.push_open(id, "body", offset)
    } else if tag == "frameset" {
      if self.body_id < 0 && self.frameset_id < 0 {
        match self.ensure_html(offset) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        if self.head_id < 0 {
          let (hds, hde) = intern_str(self.strings, "head")
          let hid = match self.alloc_node(kind_element, hds, hde, 0, 0, offset) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          link_child(self.nodes, self.html_id, hid)
          self.head_id = hid
        } else {
          while self.open_ids.length() > 0 &&
          self.open_ids[self.open_ids.length() - 1] != self.html_id {
            self.pop_open()
          }
        }
        self.head_closed = true
        let id = match
        self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        link_child(self.nodes, self.html_id, id)
        self.frameset_id = id
        return self.push_open(id, "frameset", offset)
      } else if self.frameset_id >= 0 {
        let id = match
        self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        link_child(self.nodes, self.current_parent(), id)
        return self.push_open(id, "frameset", offset)
      } else if self.frameset_ok && self.body_id >= 0 {
        // Replace implicit body with frameset
        unlink_node(self.nodes, self.body_id)
        while self.open_ids.length() > 0 &&
        self.open_ids[self.open_ids.length() - 1] != self.html_id {
          self.pop_open()
        }
        self.body_id = -1
        let id = match
        self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        link_child(self.nodes, self.html_id, id)
        self.frameset_id = id
        return self.push_open(id, "frameset", offset)
      } else {
        return Ok(())
      }
    } else if self.frameset_id >= 0 {
      if tag == "frame" {
        let id = match
        self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        link_child(self.nodes, self.current_parent(), id)
        return Ok(())
      }
      if tag != "noframes" {
        return Ok(())
      }
    } else if self.body_id < 0 {
      if is_head_tag(tag) {
        if self.head_closed && self.head_id >= 0 {
          // After-head mode: head tags go into existing `<head>`!
          let id = match
          self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          link_child(self.nodes, self.head_id, id)
          if !is_void_tag(tag) {
            match self.push_open(id, tag, offset) {
              Ok(()) => ()
              Err(e) => return Err(e)
            }
          }
          return Ok(())
        }
        match self.ensure_head(offset) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      } else {
        match self.ensure_body(offset) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
    }
  } else {
    // Fragment mode: ignore html/head/body/frameset start tags if appropriate?
    // Wait: html5lib fragment tests ignore `<html>`, `<head>`, `<body>` start tags in body context.
    if tag == "html" || tag == "head" || tag == "body" {
      return Ok(())
    }
  }

  // Foreign entry: `<svg>` or `<math>`
  if tag == "svg" || tag == "math" {
    match self.reconstruct_active_formatting(offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let fns = if tag == "svg" { 1 } else { 2 }
    self.adjust_foreign_attrs(fns, attrs_start, attrs_end)
    let id = match
    self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    self.insert_node_appropriate(id)
    if !self_closing {
      match self.push_open_ns(id, tag, fns, offset) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    }
    self.frameset_ok = false
    return Ok(())
  }

  // Nested `<form>`: ignored when a form is already open (outside template)
  if tag == "form" {
    if self.form_id >= 0 && !self.has_open_tag("template") {
      return Ok(())
    }
    self.close_p_in_scope()
    let id = match
    self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    self.insert_node_appropriate(id)
    if !self.has_open_tag("template") {
      self.form_id = id
    }
    self.frameset_ok = false
    return self.push_open(id, "form", offset)
  }

  // Nested `<button>`
  if tag == "button" {
    if self.has_in_scope("button") {
      self.generate_implied_end_tags("")
      while self.open_tags.length() > 0 {
        let is_b = self.open_ns[self.open_tags.length() - 1] == 0 &&
        self.open_tags[self.open_tags.length() - 1] == "button"
        self.pop_open()
        if is_b {
          break
        }
      }
    }
    match self.reconstruct_active_formatting(offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let id = match
    self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    self.insert_node_appropriate(id)
    self.frameset_ok = false
    return self.push_open(id, "button", offset)
  }

  // Nested `<a>`
  if tag == "a" {
    let existing = self.afe_find_tag_after_marker("a")
    if existing >= 0 {
      let existing_id = self.afe_ids[existing]
      match self.run_adoption_agency("a", offset) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      let ai = self.afe_find_id(existing_id)
      if ai >= 0 {
        self.afe_remove_at(ai)
      }
      let oi = self.find_open_id(existing_id)
      if oi >= 0 {
        self.remove_open_at(oi)
      }
    }
    match self.reconstruct_active_formatting(offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let id = match
    self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    self.insert_node_appropriate(id)
    match self.push_open(id, "a", offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    self.afe_push(id, "a")
    return Ok(())
  }

  // Nested `<nobr>`
  if tag == "nobr" {
    match self.reconstruct_active_formatting(offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    if self.has_in_scope("nobr") {
      match self.run_adoption_agency("nobr", offset) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      match self.reconstruct_active_formatting(offset) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    }
    let id = match
    self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    self.insert_node_appropriate(id)
    match self.push_open(id, "nobr", offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    self.afe_push(id, "nobr")
    return Ok(())
  }

  // Inside `<select>` mode
  if self.has_open_tag("select") {
    if tag == "select" {
      while self.open_tags.length() > 0 {
        let is_s = self.open_ns[self.open_tags.length() - 1] == 0 &&
        self.open_tags[self.open_tags.length() - 1] == "select"
        self.pop_open()
        if is_s {
          break
        }
      }
      return Ok(())
    } else if tag == "input" || tag == "keygen" || tag == "textarea" {
      while self.open_tags.length() > 0 {
        let is_s = self.open_ns[self.open_tags.length() - 1] == 0 &&
        self.open_tags[self.open_tags.length() - 1] == "select"
        self.pop_open()
        if is_s {
          break
        }
      }
      // Fall through to insert normally
    } else if tag == "hr" {
      if self.current_tag() == "option" {
        self.pop_open()
      }
      if self.current_tag() == "optgroup" {
        self.pop_open()
      }
      let id = match
      self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      link_child(self.nodes, self.current_parent(), id)
      return Ok(())
    } else if tag != "option" && tag != "optgroup" && tag != "script" && tag != "template" {
      return Ok(())
    }
  }

  // Ruby tags (`rb`, `rtc`, `rp`, `rt`)
  if (tag == "rb" || tag == "rtc") && self.has_in_scope("ruby") {
    self.generate_implied_end_tags("")
  } else if (tag == "rp" || tag == "rt") && self.has_in_scope("ruby") {
    self.generate_implied_end_tags("rtc")
  }

  // Auto-closing rules
  if closes_open_p(tag) {
    self.close_p_in_scope()
  }

  if tag == "li" {
    self.frameset_ok = false
    let mut i = self.open_tags.length() - 1
    while i >= 0 {
      let t = self.open_tags[i]
      if t == "li" {
        self.generate_implied_end_tags("li")
        while self.open_tags.length() > i {
          self.pop_open()
        }
        break
      }
      if is_special_html_tag(t) && t != "address" && t != "div" && t != "p" {
        break
      }
      i = i - 1
    }
  } else if tag == "dt" || tag == "dd" {
    self.frameset_ok = false
    let mut i = self.open_tags.length() - 1
    while i >= 0 {
      let t = self.open_tags[i]
      if t == "dt" || t == "dd" {
        self.generate_implied_end_tags(t)
        while self.open_tags.length() > i {
          self.pop_open()
        }
        break
      }
      if is_special_html_tag(t) && t != "address" && t != "div" && t != "p" {
        break
      }
      i = i - 1
    }
  } else if tag == "option" {
    if self.open_tags.length() > 0 &&
    self.open_tags[self.open_tags.length() - 1] == "option" {
      self.pop_open()
    }
  } else if tag == "optgroup" {
    if self.open_tags.length() > 0 &&
    self.open_tags[self.open_tags.length() - 1] == "option" {
      self.pop_open()
    }
    if self.open_tags.length() > 0 &&
    self.open_tags[self.open_tags.length() - 1] == "optgroup" {
      self.pop_open()
    }
  } else if is_heading_tag(tag) {
    if self.open_tags.length() > 0 &&
    is_heading_tag(self.open_tags[self.open_tags.length() - 1]) {
      self.pop_open()
    }
  } else if tag == "caption" {
    if self.table_open_count > 0 {
      while self.open_tags.length() > 0 {
        let t = self.open_tags[self.open_tags.length() - 1]
        if t == "table" || t == "template" || t == "html" {
          break
        }
        self.pop_open()
      }
      self.afe_push_marker()
    } else {
      return Ok(())
    }
  } else if tag == "colgroup" {
    if self.table_open_count > 0 {
      while self.open_tags.length() > 0 {
        let t = self.open_tags[self.open_tags.length() - 1]
        if t == "table" || t == "template" || t == "html" {
          break
        }
        self.pop_open()
      }
    } else {
      return Ok(())
    }
  } else if tag == "thead" || tag == "tbody" || tag == "tfoot" {
    if self.table_open_count == 0 {
      return Ok(())
    }
    while self.open_tags.length() > 0 {
      let t = self.open_tags[self.open_tags.length() - 1]
      if t == "table" || t == "template" || t == "html" {
        break
      }
      self.pop_open()
    }
  } else if tag == "tr" {
    if self.table_open_count == 0 {
      return Ok(())
    }
    while self.open_tags.length() > 0 {
      let t = self.open_tags[self.open_tags.length() - 1]
      if t == "tbody" || t == "thead" || t == "tfoot" || t == "table" || t == "template" || t == "html" {
        break
      }
      self.pop_open()
    }
    if self.open_tags.length() > 0 &&
    self.open_tags[self.open_tags.length() - 1] == "table" {
      match self.insert_implicit_elem("tbody", offset) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    }
  } else if tag == "td" || tag == "th" {
    if self.table_open_count == 0 {
      return Ok(())
    }
    while self.open_tags.length() > 0 {
      let t = self.open_tags[self.open_tags.length() - 1]
      if t == "tr" || t == "tbody" || t == "thead" || t == "tfoot" || t == "table" || t == "template" || t == "html" {
        break
      }
      self.pop_open()
    }
    if self.open_tags.length() > 0 &&
    self.open_tags[self.open_tags.length() - 1] == "table" {
      match self.insert_implicit_elem("tbody", offset) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    }
    if self.open_tags.length() > 0 {
      let top_t = self.open_tags[self.open_tags.length() - 1]
      if top_t == "tbody" || top_t == "thead" || top_t == "tfoot" {
        match self.insert_implicit_elem("tr", offset) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
    }
  } else if tag == "col" {
    if self.table_open_count > 0 && self.current_tag() == "table" {
      match self.insert_implicit_elem("colgroup", offset) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    }
  }

  // Reconstruct active formatting elements for inline/phrasing elements only (not block/table/head)
  let is_table_struct = is_table_inner_tag(tag) || tag == "table"
  let is_block_no_reconstruct = closes_open_p(tag) || tag == "option" || tag == "optgroup" || tag == "select"
  if !is_table_struct && !is_head_tag(tag) && !is_block_no_reconstruct {
    match self.reconstruct_active_formatting(offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
  }

  if !is_head_tag(tag) {
    self.frameset_ok = false
  }
  self.body_closed = false
  self.html_closed = false

  let id = match
  self.alloc_node(kind_element, tag_ds, tag_de, attrs_start, attrs_end, offset) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if is_table_inner_tag(tag) || tag == "style" || tag == "script" || tag == "template" {
    link_child(self.nodes, self.current_parent(), id)
  } else {
    self.insert_node_appropriate(id)
  }

  if !is_void_tag(tag) {
    match self.push_open(id, tag, offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    if is_formatting_tag(tag) {
      self.afe_push(id, tag)
    } else if tag == "applet" || tag == "marquee" || tag == "object" || tag == "td" || tag == "th" {
      self.afe_push_marker()
    }
  }
  Ok(())
}

///| Handle end tag with scope checks, O(1) open-tag pruning (F-9), and real adoption agency (F-2/F-4).
fn TreeBuilder::handle_end_tag(
  self : TreeBuilder,
  tag : String,
  offset : Int,
) -> Result[Unit, HtmlError] {
  match self.flush_text(offset) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }

  // Foreign content end tag
  if self.current_ns() != 0 {
    let mut i = self.open_tags.length() - 1
    while i >= 0 {
      if self.open_ns[i] == 0 {
        break
      }
      if to_ascii_lower(self.open_tags[i]) == tag {
        while self.open_tags.length() > i {
          self.pop_open()
        }
        return Ok(())
      }
      i = i - 1
    }
    // Fall through to HTML end tag rules if not matched in foreign content
  }

  // Special `</br>` -> acts as `<br>` start tag!
  if tag == "br" {
    match self.reconstruct_active_formatting(offset) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    let (bds, bde) = intern_str(self.strings, "br")
    let id = match self.alloc_node(kind_element, bds, bde, 0, 0, offset) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    self.insert_node_appropriate(id)
    self.frameset_ok = false
    return Ok(())
  }

  // Special `</p>`: if `<p>` is not in button scope, insert an empty `<p></p>` (only in body/fragment)!
  if tag == "p" {
    if !self.is_fragment && self.body_id < 0 {
      return Ok(())
    }
    if !self.has_in_button_scope("p") {
      let (pds, pde) = intern_str(self.strings, "p")
      let id = match self.alloc_node(kind_element, pds, pde, 0, 0, offset) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      self.insert_node_appropriate(id)
      return Ok(())
    }
    self.close_p_in_scope()
    return Ok(())
  }

  // `</head>` closes head without creating body yet
  if tag == "head" {
    if self.current_tag() == "head" {
      self.pop_open()
      self.head_closed = true
    }
    return Ok(())
  }

  // `</body>` and `</html>`: mark closed for comment placement, but keep `body` on stack for trailing elements
  if tag == "body" {
    if !self.is_fragment && self.body_id >= 0 {
      self.body_closed = true
    }
    return Ok(())
  }
  if tag == "html" {
    if !self.is_fragment && self.html_id >= 0 {
      self.html_closed = true
    }
    return Ok(())
  }

  // `</frameset>`
  if tag == "frameset" {
    if self.open_tags.length() > 0 && self.current_tag() == "frameset" {
      self.pop_open()
    }
    return Ok(())
  }

  if is_void_tag(tag) {
    return Ok(())
  }

  // O(1) fast skip for unopened end tags (F-9!)
  if !self.has_open_tag(tag) {
    return Ok(())
  }

  // Formatting elements -> full WHATWG adoption agency (8x3 + furthest block)
  if is_formatting_tag(tag) {
    return self.run_adoption_agency(tag, offset)
  }

  // Table-related end tags
  if tag == "table" {
    if !self.has_in_table_scope("table") {
      return Ok(())
    }
    while self.open_tags.length() > 0 {
      let top = self.open_tags.length() - 1
      let t = self.open_tags[top]
      let ns = self.open_ns[top]
      if ns == 0 && (t == "td" || t == "th" || t == "caption") {
        self.afe_clear_to_marker()
      }
      self.pop_open()
      if ns == 0 && t == "table" {
        break
      }
    }
    return Ok(())
  }
  if tag == "tbody" || tag == "thead" || tag == "tfoot" {
    if !self.has_in_table_scope(tag) {
      return Ok(())
    }
    while self.open_tags.length() > 0 {
      let top = self.open_tags.length() - 1
      let is_t = self.open_ns[top] == 0 && self.open_tags[top] == tag
      self.pop_open()
      if is_t {
        break
      }
    }
    return Ok(())
  }
  if tag == "tr" {
    if !self.has_in_table_scope("tr") {
      return Ok(())
    }
    while self.open_tags.length() > 0 {
      let top = self.open_tags.length() - 1
      let is_t = self.open_ns[top] == 0 && self.open_tags[top] == "tr"
      self.pop_open()
      if is_t {
        break
      }
    }
    return Ok(())
  }
  if tag == "td" || tag == "th" {
    if !self.has_in_table_scope(tag) {
      return Ok(())
    }
    self.generate_implied_end_tags("")
    while self.open_tags.length() > 0 {
      let top = self.open_tags.length() - 1
      let is_t = self.open_ns[top] == 0 && self.open_tags[top] == tag
      self.pop_open()
      if is_t {
        break
      }
    }
    self.afe_clear_to_marker()
    return Ok(())
  }
  if tag == "caption" {
    if !self.has_in_table_scope("caption") {
      return Ok(())
    }
    self.generate_implied_end_tags("")
    while self.open_tags.length() > 0 {
      let top = self.open_tags.length() - 1
      let is_c = self.open_ns[top] == 0 && self.open_tags[top] == "caption"
      self.pop_open()
      if is_c {
        break
      }
    }
    self.afe_clear_to_marker()
    return Ok(())
  }

  // `</form>`
  if tag == "form" {
    let fid = self.form_id
    self.form_id = -1
    if fid < 0 || !self.has_in_scope("form") {
      return Ok(())
    }
    self.generate_implied_end_tags("")
    let oi = self.find_open_id(fid)
    if oi >= 0 {
      self.remove_open_at(oi)
    }
    return Ok(())
  }

  // `</li>`
  if tag == "li" {
    if !self.has_in_list_item_scope("li") {
      return Ok(())
    }
    self.generate_implied_end_tags("li")
    while self.open_tags.length() > 0 {
      let top = self.open_tags.length() - 1
      let is_li = self.open_ns[top] == 0 && self.open_tags[top] == "li"
      self.pop_open()
      if is_li {
        break
      }
    }
    return Ok(())
  }

  // `</dd>`, `</dt>`
  if tag == "dd" || tag == "dt" {
    if !self.has_in_scope(tag) {
      return Ok(())
    }
    self.generate_implied_end_tags(tag)
    while self.open_tags.length() > 0 {
      let top = self.open_tags.length() - 1
      let is_t = self.open_ns[top] == 0 && self.open_tags[top] == tag
      self.pop_open()
      if is_t {
        break
      }
    }
    return Ok(())
  }

  // `</h1>`..`</h6>`
  if is_heading_tag(tag) {
    if !self.has_heading_in_scope() {
      return Ok(())
    }
    self.generate_implied_end_tags("")
    while self.open_tags.length() > 0 {
      let top = self.open_tags.length() - 1
      let is_h = self.open_ns[top] == 0 && is_heading_tag(self.open_tags[top])
      self.pop_open()
      if is_h {
        break
      }
    }
    return Ok(())
  }

  // Block-level container end tags (must be in default scope!)
  if is_special_html_tag(tag) {
    if !self.has_in_scope(tag) {
      return Ok(())
    }
    self.generate_implied_end_tags("")
    while self.open_tags.length() > 0 {
      let top = self.open_tags.length() - 1
      let is_t = self.open_ns[top] == 0 && self.open_tags[top] == tag
      self.pop_open()
      if is_t {
        break
      }
    }
    if tag == "applet" || tag == "marquee" || tag == "object" {
      self.afe_clear_to_marker()
    }
    return Ok(())
  }

  // Any other end tag
  self.close_any_other_end_tag(tag)
  Ok(())
}

///| Scan `<script>` content with WHATWG script data / escaped / double-escaped states.
fn scan_script_data(
  tb : TreeBuilder,
  src : String,
  start : Int,
  len : Int,
) -> Result[Int, HtmlError] {
  // state: 0=data, 1=escaped, 2=double-escaped
  let mut state = 0
  let mut i = start
  while i < len {
    let b = src.code_unit_at(i)
    if state == 0 {
      if b == 0x3C {
        if i + 3 < len &&
        src.code_unit_at(i + 1) == 0x21 &&
        src.code_unit_at(i + 2) == 0x2D &&
        src.code_unit_at(i + 3) == 0x2D {
          state = 1
          i = i + 4
          continue
        }
        if i + 8 <= len &&
        src.code_unit_at(i + 1) == 0x2F &&
        slice_eq_ci(src, i + 2, i + 8, "script") {
          let after = i + 8
          let valid_end = if after >= len {
            false
          } else {
            let nb = src.code_unit_at(after)
            is_html_ws(nb) || nb == 0x2F || nb == 0x3E
          }
          if valid_end {
            let end_pos = scan_end_tag_close(src, after, len)
            if i > start {
              tb.append_rawtext_span(start, i)
            }
            if end_pos >= 0 {
              match tb.handle_end_tag("script", i) {
                Ok(()) => ()
                Err(e) => return Err(e)
              }
              return Ok(end_pos)
            }
            return Ok(len)
          }
        }
      }
      i = i + 1
    } else if state == 1 {
      if b == 0x2D &&
      i + 2 < len &&
      src.code_unit_at(i + 1) == 0x2D &&
      src.code_unit_at(i + 2) == 0x3E {
        state = 0
        i = i + 3
        continue
      }
      if b == 0x3C {
        if i + 7 <= len && slice_eq_ci(src, i + 1, i + 7, "script") {
          let after = i + 7
          if after < len {
            let nb = src.code_unit_at(after)
            if is_html_ws(nb) || nb == 0x2F || nb == 0x3E {
              state = 2
              i = after + 1
              continue
            }
          }
        }
        if i + 8 <= len &&
        src.code_unit_at(i + 1) == 0x2F &&
        slice_eq_ci(src, i + 2, i + 8, "script") {
          let after = i + 8
          let valid_end = if after >= len {
            false
          } else {
            let nb = src.code_unit_at(after)
            is_html_ws(nb) || nb == 0x2F || nb == 0x3E
          }
          if valid_end {
            let end_pos = scan_end_tag_close(src, after, len)
            if i > start {
              tb.append_rawtext_span(start, i)
            }
            if end_pos >= 0 {
              match tb.handle_end_tag("script", i) {
                Ok(()) => ()
                Err(e) => return Err(e)
              }
              return Ok(end_pos)
            }
            return Ok(len)
          }
        }
      }
      i = i + 1
    } else {
      // state == 2 (double-escaped)
      if b == 0x2D &&
      i + 2 < len &&
      src.code_unit_at(i + 1) == 0x2D &&
      src.code_unit_at(i + 2) == 0x3E {
        state = 0
        i = i + 3
        continue
      }
      if b == 0x3C &&
      i + 8 <= len &&
      src.code_unit_at(i + 1) == 0x2F &&
      slice_eq_ci(src, i + 2, i + 8, "script") {
        let after = i + 8
        if after < len {
          let nb = src.code_unit_at(after)
          if is_html_ws(nb) || nb == 0x2F || nb == 0x3E {
            state = 1
            i = after + 1
            continue
          }
        }
      }
      i = i + 1
    }
  }
  if len > start {
    tb.append_rawtext_span(start, len)
  }
  Ok(len)
}

///| Scan past end-tag attributes (respecting quoted values) until `>`.
///| Returns byte index after `>`, or -1 if EOF is hit before `>`.
fn scan_end_tag_close(src : String, start : Int, len : Int) -> Int {
  let mut pos = start
  while pos < len {
    while pos < len && is_html_ws(src.code_unit_at(pos)) {
      pos = pos + 1
    }
    if pos >= len {
      return -1
    }
    let c = src.code_unit_at(pos)
    if c == 0x3E {
      return pos + 1
    }
    if c == 0x2F {
      pos = pos + 1
      if pos < len && src.code_unit_at(pos) == 0x3E {
        return pos + 1
      }
      continue
    }
    // Attribute name (may start with '=')
    if c == 0x3D {
      pos = pos + 1
    }
    while pos < len {
      let ac = src.code_unit_at(pos)
      if is_html_ws(ac) || ac == 0x3D || ac == 0x3E || ac == 0x2F {
        break
      }
      pos = pos + 1
    }
    while pos < len && is_html_ws(src.code_unit_at(pos)) {
      pos = pos + 1
    }
    if pos < len && src.code_unit_at(pos) == 0x3D {
      pos = pos + 1
      while pos < len && is_html_ws(src.code_unit_at(pos)) {
        pos = pos + 1
      }
      if pos < len {
        let q = src.code_unit_at(pos)
        if q == 0x22 || q == 0x27 {
          pos = pos + 1
          while pos < len && src.code_unit_at(pos) != q {
            pos = pos + 1
          }
          if pos >= len {
            return -1
          }
          pos = pos + 1
        } else {
          while pos < len {
            let vc = src.code_unit_at(pos)
            if is_html_ws(vc) || vc == 0x3E {
              break
            }
            pos = pos + 1
          }
        }
      }
    }
  }
  -1
}

///| Scan RAWTEXT or RCDATA until matching `</tagname` (followed by whitespace, `/`, or `>`).
///| Returns the byte index right after the closing `>` (or `len` at EOF).
fn scan_raw_or_rcdata(
  tb : TreeBuilder,
  src : String,
  start : Int,
  len : Int,
  tag : String,
  is_rcdata : Bool,
) -> Result[Int, HtmlError] {
  if !is_rcdata && tag == "script" {
    return scan_script_data(tb, src, start, len)
  }
  let mut content_start = start
  if tag == "textarea" && content_start < len {
    let b0 = src.code_unit_at(content_start)
    if b0 == 0x0A {
      content_start = content_start + 1
    } else if b0 == 0x0D {
      content_start = content_start + 1
      if content_start < len && src.code_unit_at(content_start) == 0x0A {
        content_start = content_start + 1
      }
    }
  }
  let tlen = tag.length()
  let mut i = content_start
  while i < len {
    if src.code_unit_at(i) == 0x3C &&
    i + 2 + tlen <= len &&
    src.code_unit_at(i + 1) == 0x2F &&
    slice_eq_ci(src, i + 2, i + 2 + tlen, tag) {
      let after = i + 2 + tlen
      let valid_end = if after >= len {
        false
      } else {
        let nb = src.code_unit_at(after)
        is_html_ws(nb) || nb == 0x2F || nb == 0x3E
      }
      if valid_end {
        let end_pos = scan_end_tag_close(src, after, len)
        if end_pos >= 0 {
          if i > content_start {
            if is_rcdata {
              if needs_entity_decode(src, content_start, i) {
                tb.append_rcdata_decoded(content_start, i)
              } else {
                tb.append_text_span(content_start, i)
              }
            } else {
              tb.append_rawtext_span(content_start, i)
            }
          }
          match tb.handle_end_tag(tag, i) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
          return Ok(end_pos)
        }
      }
    }
    i = i + 1
  }
  if len > content_start {
    if is_rcdata {
      if needs_entity_decode(src, content_start, len) {
        tb.append_rcdata_decoded(content_start, len)
      } else {
        tb.append_text_span(content_start, len)
      }
    } else {
      tb.append_rawtext_span(content_start, len)
    }
  }
  Ok(len)
}

///| Main HTML5 tokenizer & tree-builder loop.
fn parse_html_impl(
  src : String,
  opts : ParseOptions,
  is_fragment : Bool,
) -> Result[Document, HtmlError] {
  let tb = TreeBuilder::new(src, opts, is_fragment)
  let len = src.length()
  let mut pos = 0

  // Strip optional UTF-8 BOM (EF BB BF)
  if len >= 3 &&
  src.code_unit_at(0) == 0xEF &&
  src.code_unit_at(1) == 0xBB &&
  src.code_unit_at(2) == 0xBF {
    pos = 3
  }

  while pos < len {
    let b = src.code_unit_at(pos)
    if b != 0x3C {
      // Fast text scan until '<'
      let tstart = pos
      let mut has_special = false
      while pos < len {
        let c = src.code_unit_at(pos)
        if c == 0x3C {
          break
        }
        if c == 0x26 || c == 0x0D || c == 0x00 {
          has_special = true
        }
        pos = pos + 1
      }
      // In full document mode, ensure body for non-whitespace text before body
      if !is_fragment && tb.body_id < 0 && tb.head_id < 0 {
        let mut k = tstart
        let mut all_ws = true
        while k < pos {
          if !is_html_ws(src.code_unit_at(k)) {
            all_ws = false
            break
          }
          k = k + 1
        }
        if !all_ws {
          match tb.ensure_body(tstart) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
        } else {
          continue
        }
      } else if !is_fragment && tb.body_id < 0 {
        let mut k = tstart
        let mut all_ws = true
        while k < pos {
          if !is_html_ws(src.code_unit_at(k)) {
            all_ws = false
            break
          }
          k = k + 1
        }
        if !all_ws {
          match tb.ensure_body(tstart) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
        }
      }
      if has_special {
        tb.append_text_decoded(tstart, pos)
      } else {
        tb.append_text_span(tstart, pos)
      }
      continue
    }

    // `src[pos] == '<'`
    let lt_pos = pos
    if pos + 1 >= len {
      if !is_fragment && tb.body_id < 0 {
        match tb.ensure_body(lt_pos) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
      tb.append_text_byte(0x3C)
      pos = pos + 1
      continue
    }

    let b1 = src.code_unit_at(pos + 1)

    // Comment or DOCTYPE: `<!...`
    if b1 == 0x21 {
      match tb.flush_text(lt_pos) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      if pos + 3 < len &&
      src.code_unit_at(pos + 2) == 0x2D &&
      src.code_unit_at(pos + 3) == 0x2D {
        // HTML5 comment `<!--`
        pos = pos + 4
        // Abrupt closing: `<!-->` or `<!--->`
        let (cs, ce) = if pos < len && src.code_unit_at(pos) == 0x3E {
          pos = pos + 1
          (0, 0)
        } else if pos + 1 < len &&
        src.code_unit_at(pos) == 0x2D &&
        src.code_unit_at(pos + 1) == 0x3E {
          pos = pos + 2
          (0, 0)
        } else {
          let cstart = pos
          let mut cend = len
          while pos < len {
            if src.code_unit_at(pos) == 0x2D &&
            pos + 1 < len &&
            src.code_unit_at(pos + 1) == 0x2D {
              if pos + 2 < len && src.code_unit_at(pos + 2) == 0x3E {
                cend = pos
                pos = pos + 3
                break
              } else if pos + 3 < len &&
              src.code_unit_at(pos + 2) == 0x21 &&
              src.code_unit_at(pos + 3) == 0x3E {
                cend = pos
                pos = pos + 4
                break
              }
            }
            pos = pos + 1
          }
          (cstart, cend)
        }
        let (nds, nde) = if needs_rawtext_normalize(src, cs, ce) {
          let csb = StringBuilder::with_capacity(ce - cs)
          normalize_rawtext_into(src, cs, ce, csb)
          intern_str(tb.strings, csb.to_string())
        } else {
          (cs, ce)
        }
        let cid = match tb.alloc_node(kind_comment, nds, nde, 0, 0, lt_pos) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        let cparent = if !is_fragment && tb.html_closed {
          0
        } else if !is_fragment && tb.body_closed && tb.html_id >= 0 {
          tb.html_id
        } else {
          tb.current_parent()
        }
        link_child(tb.nodes, cparent, cid)
        continue
      }

      // `<!DOCTYPE ...>`
      if pos + 9 <= len && slice_eq_ci(src, pos + 2, pos + 9, "doctype") {
        pos = pos + 9
        while pos < len && is_html_ws(src.code_unit_at(pos)) {
          pos = pos + 1
        }
        let nstart = pos
        while pos < len &&
        !is_html_ws(src.code_unit_at(pos)) &&
        src.code_unit_at(pos) != 0x3E {
          pos = pos + 1
        }
        let nend = pos
        while pos < len && src.code_unit_at(pos) != 0x3E {
          pos = pos + 1
        }
        if pos < len {
          pos = pos + 1
        }
        if !is_fragment && !tb.has_doctype && tb.html_id < 0 {
          tb.has_doctype = true
          let (ds, de) = if nend > nstart {
            intern_lower_span(src, tb.strings, nstart, nend)
          } else {
            (0, 0)
          }
          let did = match tb.alloc_node(kind_doctype, ds, de, 0, 0, lt_pos) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          link_child(tb.nodes, 0, did)
        }
        continue
      }

      // Bogus comment `<!...>`
      let bstart = pos + 2
      pos = bstart
      while pos < len && src.code_unit_at(pos) != 0x3E {
        pos = pos + 1
      }
      let bend = pos
      if pos < len {
        pos = pos + 1
      }
      let (nds, nde) = if needs_rawtext_normalize(src, bstart, bend) {
        let csb = StringBuilder::with_capacity(bend - bstart)
        normalize_rawtext_into(src, bstart, bend, csb)
        intern_str(tb.strings, csb.to_string())
      } else {
        (bstart, bend)
      }
      let cid = match tb.alloc_node(kind_comment, nds, nde, 0, 0, lt_pos) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      link_child(tb.nodes, tb.current_parent(), cid)
      continue
    }

    // Processing instruction / bogus comment `<?...>`
    if b1 == 0x3F {
      match tb.flush_text(lt_pos) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      let bstart = pos + 1
      pos = bstart
      while pos < len && src.code_unit_at(pos) != 0x3E {
        pos = pos + 1
      }
      let bend = pos
      if pos < len {
        pos = pos + 1
      }
      let (nds, nde) = if needs_rawtext_normalize(src, bstart, bend) {
        let csb = StringBuilder::with_capacity(bend - bstart)
        normalize_rawtext_into(src, bstart, bend, csb)
        intern_str(tb.strings, csb.to_string())
      } else {
        (bstart, bend)
      }
      let cid = match tb.alloc_node(kind_comment, nds, nde, 0, 0, lt_pos) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      link_child(tb.nodes, tb.current_parent(), cid)
      continue
    }

    // End tag: `</tag...>`
    if b1 == 0x2F {
      if pos + 2 < len && is_ascii_alpha(src.code_unit_at(pos + 2)) {
        let tstart = pos + 2
        pos = tstart
        while pos < len {
          let c = src.code_unit_at(pos)
          if is_html_ws(c) || c == 0x3E || c == 0x2F {
            break
          }
          pos = pos + 1
        }
        let tend = pos
        let end_pos = scan_end_tag_close(src, pos, len)
        if end_pos < 0 {
          // EOF inside end tag: drop token
          pos = len
          continue
        }
        pos = end_pos
        let tag = to_ascii_lower(src.slice(tstart, tend))
        match tb.handle_end_tag(tag, lt_pos) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        continue
      } else {
        // Bogus comment `</...>` (unless `</>` which is ignored)
        match tb.flush_text(lt_pos) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        let bstart = pos + 2
        pos = bstart
        if pos < len && src.code_unit_at(pos) == 0x3E {
          pos = pos + 1
          continue
        }
        while pos < len && src.code_unit_at(pos) != 0x3E {
          pos = pos + 1
        }
        let bend = pos
        if pos < len {
          pos = pos + 1
        }
        let (nds, nde) = if needs_rawtext_normalize(src, bstart, bend) {
          let csb = StringBuilder::with_capacity(bend - bstart)
          normalize_rawtext_into(src, bstart, bend, csb)
          intern_str(tb.strings, csb.to_string())
        } else {
          (bstart, bend)
        }
        let cid = match tb.alloc_node(kind_comment, nds, nde, 0, 0, lt_pos) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        link_child(tb.nodes, tb.current_parent(), cid)
        continue
      }
    }

    // Start tag: `<tag ...>`
    if is_ascii_alpha(b1) {
      let tstart = pos + 1
      pos = tstart
      while pos < len {
        let c = src.code_unit_at(pos)
        if is_html_ws(c) || c == 0x3E || c == 0x2F {
          break
        }
        pos = pos + 1
      }
      let tend = pos
      let (tag_ds, tag_de) = intern_lower_span(src, tb.strings, tstart, tend)
      let tag = raw_resolve_span(src, tb.strings, tag_ds, tag_de)

      // Parse attributes with O(1) dedup (linear <= 16, Map > 16)
      let attrs_start = tb.attrs.length()
      let mut attr_count = 0
      let mut seen_map_active = false
      let seen_map : Map[String, Bool] = Map::new()
      let mut self_closing = false
      let mut tag_closed = false

      while pos < len {
        // Skip whitespace
        while pos < len && is_html_ws(src.code_unit_at(pos)) {
          pos = pos + 1
        }
        if pos >= len {
          break
        }
        let c = src.code_unit_at(pos)
        if c == 0x3E {
          pos = pos + 1
          tag_closed = true
          break
        }
        if c == 0x2F {
          pos = pos + 1
          if pos < len && src.code_unit_at(pos) == 0x3E {
            self_closing = true
            tag_closed = true
            pos = pos + 1
            break
          }
          continue
        }

        // Attribute name (WHATWG: leading '=' is part of attribute name)
        let astart = pos
        if c == 0x3D {
          pos = pos + 1
        }
        while pos < len {
          let ac = src.code_unit_at(pos)
          if is_html_ws(ac) || ac == 0x3D || ac == 0x3E || ac == 0x2F {
            break
          }
          pos = pos + 1
        }
        let aend = pos
        if aend == astart {
          pos = pos + 1
          continue
        }

        // Skip whitespace before optional '='
        while pos < len && is_html_ws(src.code_unit_at(pos)) {
          pos = pos + 1
        }
        let mut vstart = 0
        let mut vend = 0
        let mut val_needs_decode = false
        if pos < len && src.code_unit_at(pos) == 0x3D {
          pos = pos + 1
          while pos < len && is_html_ws(src.code_unit_at(pos)) {
            pos = pos + 1
          }
          if pos < len {
            let q = src.code_unit_at(pos)
            if q == 0x22 || q == 0x27 {
              pos = pos + 1
              vstart = pos
              while pos < len {
                let vc = src.code_unit_at(pos)
                if vc == q {
                  break
                }
                if vc == 0x26 || vc == 0x0D || vc == 0x00 {
                  val_needs_decode = true
                }
                pos = pos + 1
              }
              vend = pos
              if pos < len && src.code_unit_at(pos) == q {
                pos = pos + 1
              } else {
                // EOF inside quoted attribute value
                break
              }
            } else {
              // Unquoted attribute value
              vstart = pos
              while pos < len {
                let vc = src.code_unit_at(pos)
                if is_html_ws(vc) || vc == 0x3E {
                  break
                }
                if vc == 0x26 || vc == 0x0D || vc == 0x00 {
                  val_needs_decode = true
                }
                pos = pos + 1
              }
              vend = pos
            }
          }
        }

        // Lowercase attribute name & deduplicate (first wins)
        let (nds, nde) = intern_lower_span(src, tb.strings, astart, aend)
        let aname = raw_resolve_span(src, tb.strings, nds, nde)

        let mut is_dup = false
        if seen_map_active {
          match seen_map.get(aname) {
            Some(_) => is_dup = true
            None => ()
          }
        } else {
          let mut k = attrs_start
          while k < tb.attrs.length() {
            let prev_a = tb.attrs[k]
            if raw_resolve_span(src, tb.strings, prev_a.name_start, prev_a.name_end) == aname {
              is_dup = true
              break
            }
            k = k + 1
          }
        }
        if is_dup {
          continue
        }

        attr_count = attr_count + 1
        if attr_count > opts.limits.max_attributes {
          return Err(
            HtmlError::new(
              HtmlErrorKind::LimitExceeded,
              astart,
              "max_attributes limit exceeded",
            ),
          )
        }
        if seen_map_active {
          seen_map.set(aname, true)
        } else if attr_count > 16 {
          seen_map_active = true
          let mut k = attrs_start
          while k < tb.attrs.length() {
            let prev_a = tb.attrs[k]
            seen_map.set(
              raw_resolve_span(src, tb.strings, prev_a.name_start, prev_a.name_end),
              true,
            )
            k = k + 1
          }
          seen_map.set(aname, true)
        }

        let (vds, vde) = if val_needs_decode {
          let vsb = StringBuilder::with_capacity(vend - vstart)
          decode_entities_into(src, vstart, vend, true, vsb)
          intern_str(tb.strings, vsb.to_string())
        } else {
          (vstart, vend)
        }

        tb.attrs.push(
          AttrData::{
            name_start: nds,
            name_end: nde,
            val_start: vds,
            val_end: vde,
          },
        )
      }
      if !tag_closed {
        // EOF inside start tag: drop token and rollback attributes
        while tb.attrs.length() > attrs_start {
          let _ = tb.attrs.pop()
        }
        continue
      }
      let attrs_end = tb.attrs.length()

      match
      tb.handle_start_tag(tag, tag_ds, tag_de, attrs_start, attrs_end, self_closing, lt_pos) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }

      // Strip single leading LF after `<pre>` or `<listing>`
      if (tag == "pre" || tag == "listing") && pos < len {
        let nb = src.code_unit_at(pos)
        if nb == 0x0A {
          pos = pos + 1
        } else if nb == 0x0D {
          pos = pos + 1
          if pos < len && src.code_unit_at(pos) == 0x0A {
            pos = pos + 1
          }
        }
      }

      // Switch to RAWTEXT / RCDATA / PLAINTEXT if applicable (HTML namespace only)
      if tb.current_ns() == 0 {
        if tag == "plaintext" {
          if pos < len {
            tb.append_rawtext_span(pos, len)
            pos = len
          }
        } else if is_rawtext_tag(tag) {
          match scan_raw_or_rcdata(tb, src, pos, len, tag, false) {
            Ok(next_pos) => pos = next_pos
            Err(e) => return Err(e)
          }
        } else if is_rcdata_tag(tag) {
          match scan_raw_or_rcdata(tb, src, pos, len, tag, true) {
            Ok(next_pos) => pos = next_pos
            Err(e) => return Err(e)
          }
        }
      }
      continue
    }

    // Stray '<' treated as literal text
    if !is_fragment && tb.body_id < 0 {
      match tb.ensure_body(lt_pos) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    }
    tb.append_text_byte(0x3C)
    pos = pos + 1
  }

  match tb.flush_text(len) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }

  if !is_fragment && tb.frameset_id < 0 {
    match tb.ensure_body(len) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
  }

  Ok(
    Document::{
      src: tb.src,
      strings: tb.strings,
      nodes: tb.nodes,
      attrs: tb.attrs,
    },
  )
}

///| Parse a full HTML5 document (ensuring implicit `html`/`head`/`body`).
pub fn Document::parse(src : String) -> Result[Document, HtmlError] {
  parse_html_impl(src, ParseOptions::default(), false)
}

///| Parse a full HTML5 document with custom `ParseOptions`.
pub fn Document::parse_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Document, HtmlError] {
  parse_html_impl(src, opts, false)
}

///| Parse an HTML5 fragment without implicit `html`/`head`/`body` wrappers.
pub fn Document::parse_fragment(src : String) -> Result[Document, HtmlError] {
  parse_html_impl(src, ParseOptions::default(), true)
}

///| Parse an HTML5 fragment with custom `ParseOptions`.
pub fn Document::parse_fragment_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Document, HtmlError] {
  parse_html_impl(src, opts, true)
}

///|
pub fn Document::root(self : Document) -> Node {
  Node::{ doc: self, id: 0 }
}

///|
pub fn Document::node_count(self : Document) -> Int {
  self.nodes.length()
}

///|
pub fn Document::node_kind_at(self : Document, id : Int) -> Int {
  self.nodes[id].kind
}

///|
pub fn Node::node_type(self : Node) -> NodeType {
  match self.doc.nodes[self.id].kind {
    0 => NodeType::Document
    1 => NodeType::Doctype
    2 => NodeType::Element
    3 => NodeType::Text
    _ => NodeType::Comment
  }
}

///|
pub fn Node::is_document(self : Node) -> Bool {
  self.doc.nodes[self.id].kind == kind_document
}

///|
pub fn Node::is_doctype(self : Node) -> Bool {
  self.doc.nodes[self.id].kind == kind_doctype
}

///|
pub fn Node::is_element(self : Node) -> Bool {
  self.doc.nodes[self.id].kind == kind_element
}

///|
pub fn Node::is_text(self : Node) -> Bool {
  self.doc.nodes[self.id].kind == kind_text
}

///|
pub fn Node::is_comment(self : Node) -> Bool {
  self.doc.nodes[self.id].kind == kind_comment
}

///|
pub fn Node::tag_name(self : Node) -> String {
  let nd = self.doc.nodes[self.id]
  if nd.kind != kind_element {
    return ""
  }
  doc_resolve_span(self.doc, nd.data_start, nd.data_end)
}

///|
pub fn Node::has_tag_name(self : Node, name : String) -> Bool {
  let nd = self.doc.nodes[self.id]
  if nd.kind != kind_element {
    return false
  }
  let target = to_ascii_lower(name)
  if nd.data_start >= 0 {
    slice_eq_exact(self.doc.src, nd.data_start, nd.data_end, target)
  } else {
    self.doc.strings[-(nd.data_start + 1)] == target
  }
}

///|
pub fn Node::text(self : Node) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  if nd.kind == kind_text || nd.kind == kind_comment || nd.kind == kind_doctype {
    Some(doc_resolve_span(self.doc, nd.data_start, nd.data_end))
  } else {
    None
  }
}

///|
pub fn Node::attr(self : Node, name : String) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  if nd.kind != kind_element {
    return None
  }
  let target = to_ascii_lower(name)
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let ad = self.doc.attrs[i]
    let matched = if ad.name_start >= 0 {
      slice_eq_exact(self.doc.src, ad.name_start, ad.name_end, target)
    } else {
      self.doc.strings[-(ad.name_start + 1)] == target
    }
    if matched {
      return Some(doc_resolve_span(self.doc, ad.val_start, ad.val_end))
    }
    i = i + 1
  }
  None
}

///|
pub fn Node::has_attr(self : Node, name : String) -> Bool {
  match self.attr(name) {
    Some(_) => true
    None => false
  }
}

///|
pub fn Node::attributes(self : Node) -> Array[Attribute] {
  let nd = self.doc.nodes[self.id]
  let out : Array[Attribute] = []
  if nd.kind != kind_element {
    return out
  }
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let ad = self.doc.attrs[i]
    out.push(
      Attribute::{
        name: doc_resolve_span(self.doc, ad.name_start, ad.name_end),
        value: doc_resolve_span(self.doc, ad.val_start, ad.val_end),
      },
    )
    i = i + 1
  }
  out
}

///|
pub fn Node::id_attr(self : Node) -> Option[String] {
  self.attr("id")
}

///| Fast zero-copy attribute value span lookup for an already-lowercased attribute name.
///| Returns `(found, val_start, val_end)`.
fn node_attr_span_lower(doc : Document, nid : Int, lower_name : String) -> (Bool, Int, Int) {
  let nd = doc.nodes[nid]
  if nd.kind != kind_element {
    return (false, 0, 0)
  }
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let ad = doc.attrs[i]
    let matched = if ad.name_start >= 0 {
      slice_eq_exact(doc.src, ad.name_start, ad.name_end, lower_name)
    } else {
      doc.strings[-(ad.name_start + 1)] == lower_name
    }
    if matched {
      return (true, ad.val_start, ad.val_end)
    }
    i = i + 1
  }
  (false, 0, 0)
}

///| Fast zero-copy class token check on `(doc, nid)`.
fn node_has_class_fast(doc : Document, nid : Int, class_name : String) -> Bool {
  if class_name.length() == 0 {
    return false
  }
  let (found, vs, ve) = node_attr_span_lower(doc, nid, "class")
  if !found {
    return false
  }
  let (buf, start, end) = if vs >= 0 {
    (doc.src, vs, ve)
  } else {
    let s = doc.strings[-(vs + 1)]
    (s, 0, s.length())
  }
  let mut i = start
  while i < end {
    while i < end && is_html_ws(buf.code_unit_at(i)) {
      i = i + 1
    }
    let s = i
    while i < end && !is_html_ws(buf.code_unit_at(i)) {
      i = i + 1
    }
    if i > s && slice_eq_exact(buf, s, i, class_name) {
      return true
    }
  }
  false
}

///| Check whether `class_name` is one of the whitespace-separated tokens in `class`.
pub fn Node::has_class(self : Node, class_name : String) -> Bool {
  node_has_class_fast(self.doc, self.id, class_name)
}

///|
pub fn Node::parent(self : Node) -> Option[Node] {
  let pid = self.doc.nodes[self.id].parent
  if pid >= 0 {
    Some(Node::{ doc: self.doc, id: pid })
  } else {
    None
  }
}

///|
pub fn Node::first_child(self : Node) -> Option[Node] {
  let cid = self.doc.nodes[self.id].first_child
  if cid >= 0 {
    Some(Node::{ doc: self.doc, id: cid })
  } else {
    None
  }
}

///|
pub fn Node::last_child(self : Node) -> Option[Node] {
  let cid = self.doc.nodes[self.id].last_child
  if cid >= 0 {
    Some(Node::{ doc: self.doc, id: cid })
  } else {
    None
  }
}

///|
pub fn Node::prev_sibling(self : Node) -> Option[Node] {
  let sid = self.doc.nodes[self.id].prev_sibling
  if sid >= 0 {
    Some(Node::{ doc: self.doc, id: sid })
  } else {
    None
  }
}

///|
pub fn Node::next_sibling(self : Node) -> Option[Node] {
  let sid = self.doc.nodes[self.id].next_sibling
  if sid >= 0 {
    Some(Node::{ doc: self.doc, id: sid })
  } else {
    None
  }
}

///|
pub fn Node::children(self : Node) -> Array[Node] {
  let out : Array[Node] = []
  let mut cur = self.doc.nodes[self.id].first_child
  while cur >= 0 {
    out.push(Node::{ doc: self.doc, id: cur })
    cur = self.doc.nodes[cur].next_sibling
  }
  out
}

///|
pub fn Node::element_children(self : Node) -> Array[Node] {
  let out : Array[Node] = []
  let mut cur = self.doc.nodes[self.id].first_child
  while cur >= 0 {
    if self.doc.nodes[cur].kind == kind_element {
      out.push(Node::{ doc: self.doc, id: cur })
    }
    cur = self.doc.nodes[cur].next_sibling
  }
  out
}
