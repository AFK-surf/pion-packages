///| WHATWG HTML §4.8.4.3 Responsive images: `<img srcset>` & `<picture><source>` parsing and selection.

///| Image candidate descriptor per WHATWG HTML §4.8.4.3.1.
pub enum SrcsetDescriptor {
  Width(Int)
  Density(Double)
}

///|
pub fn srcset_descriptor_eq(
  a : SrcsetDescriptor,
  b : SrcsetDescriptor,
) -> Bool {
  match (a, b) {
    (SrcsetDescriptor::Width(x), SrcsetDescriptor::Width(y)) => x == y
    (SrcsetDescriptor::Density(x), SrcsetDescriptor::Density(y)) => x == y
    _ => false
  }
}

///| A parsed candidate from an HTML `srcset` attribute.
pub struct SrcsetCandidate {
  pub url : String
  pub descriptor : SrcsetDescriptor
}

///| A `<source>` element inside a `<picture>` element.
pub struct PictureSource {
  pub srcset : String
  pub media_matches : Bool
  pub mime_type : String
}

fn srcset_is_space(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

fn srcset_ascii_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let sb = StringBuilder::with_capacity(n)
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_byte((c + 32).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn srcset_trim(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n && srcset_is_space(s.code_unit_at(start)) {
    start = start + 1
  }
  let mut end = n
  while end > start && srcset_is_space(s.code_unit_at(end - 1)) {
    end = end - 1
  }
  s.slice(start, end)
}

///| Parse a WHATWG valid non-negative integer > 0 (ASCII digits only, no overflow).
fn srcset_positive_int(s : String) -> Option[Int] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    let d = c - 48
    if acc > 214748364 || (acc == 214748364 && d > 7) {
      return None
    }
    acc = acc * 10 + d
    i = i + 1
  }
  if acc >= 1 {
    Some(acc)
  } else {
    None
  }
}

///| Parse a WHATWG valid floating-point number > 0 (finite, positive).
fn srcset_positive_float(s : String) -> Option[Double] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  if s.code_unit_at(i) == 45 {
    return None
  }
  let mut digits = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      i = i + 1
      digits = digits + 1
    } else {
      break
    }
  }
  if i < n && s.code_unit_at(i) == 46 {
    i = i + 1
    let mut frac = 0
    while i < n {
      let c = s.code_unit_at(i)
      if c >= 48 && c <= 57 {
        i = i + 1
        frac = frac + 1
      } else {
        break
      }
    }
    if frac == 0 {
      return None
    }
    digits = digits + frac
  }
  if digits == 0 {
    return None
  }
  if i < n && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    i = i + 1
    if i < n && (s.code_unit_at(i) == 43 || s.code_unit_at(i) == 45) {
      i = i + 1
    }
    let mut exp = 0
    while i < n {
      let c = s.code_unit_at(i)
      if c >= 48 && c <= 57 {
        i = i + 1
        exp = exp + 1
      } else {
        break
      }
    }
    if exp == 0 {
      return None
    }
  }
  if i != n {
    return None
  }
  match s.to_double() {
    Some(v) => if v > 0.0 && v == v && v < 1.0e308 { Some(v) } else { None }
    None => None
  }
}

///| Parse an HTML `srcset` attribute per WHATWG HTML §4.8.4.3.1.
///| Linear O(N) time, zero panic on arbitrary input.
pub fn parse_srcset(input : String) -> Array[SrcsetCandidate] {
  let n = input.length()
  let out : Array[SrcsetCandidate] = []
  let mut i = 0
  while i < n {
    // Splitting loop: skip ASCII whitespace and commas.
    while i < n && (srcset_is_space(input.code_unit_at(i)) || input.code_unit_at(i) == 44) {
      i = i + 1
    }
    if i >= n {
      break
    }
    // Collect URL (sequence of non-ASCII-whitespace characters).
    let start = i
    while i < n && !srcset_is_space(input.code_unit_at(i)) {
      i = i + 1
    }
    let mut end = i
    let descs : Array[String] = []
    if input.code_unit_at(end - 1) == 44 {
      // URL ended with comma(s): strip all trailing commas; no descriptor list.
      while end > start && input.code_unit_at(end - 1) == 44 {
        end = end - 1
      }
    } else {
      // Descriptor tokenizer (in_descriptor / in_parens / after_descriptor).
      let mut in_parens = false
      let mut tok_start = -1
      while i < n {
        let c = input.code_unit_at(i)
        if in_parens {
          if tok_start < 0 {
            tok_start = i
          }
          if c == 41 {
            in_parens = false
          }
        } else if c == 44 {
          if tok_start >= 0 {
            descs.push(input.slice(tok_start, i))
            tok_start = -1
          }
          i = i + 1
          break
        } else if srcset_is_space(c) {
          if tok_start >= 0 {
            descs.push(input.slice(tok_start, i))
            tok_start = -1
          }
        } else {
          if tok_start < 0 {
            tok_start = i
          }
          if c == 40 {
            in_parens = true
          }
        }
        i = i + 1
      }
      if tok_start >= 0 {
        let tok_end = if i <= n { i } else { n }
        descs.push(input.slice(tok_start, tok_end))
      }
    }
    if end <= start {
      continue
    }
    let url = input.slice(start, end)
    // Descriptor parser per WHATWG HTML §4.8.4.3.1.
    let mut width : Option[Int] = None
    let mut density : Option[Double] = None
    let mut has_h = false
    let mut bad = false
    let mut di = 0
    while di < descs.length() {
      let d = descs[di]
      let dlen = d.length()
      if dlen < 2 {
        bad = true
      } else {
        let unit = d.code_unit_at(dlen - 1)
        let num = d.slice(0, dlen - 1)
        if unit == 119 && width.is_none() && density.is_none() {
          // 'w'
          match srcset_positive_int(num) {
            Some(v) => width = Some(v)
            None => bad = true
          }
        } else if unit == 120 && density.is_none() && width.is_none() && !has_h {
          // 'x'
          match srcset_positive_float(num) {
            Some(v) => density = Some(v)
            None => bad = true
          }
        } else if unit == 104 && !has_h && density.is_none() {
          // 'h' (future-compat)
          match srcset_positive_int(num) {
            Some(_) => has_h = true
            None => bad = true
          }
        } else {
          bad = true
        }
      }
      di = di + 1
    }
    if has_h && width.is_none() {
      bad = true
    }
    if !bad {
      let desc = match width {
        Some(w) => SrcsetDescriptor::Width(w)
        None => match density {
          Some(x) => SrcsetDescriptor::Density(x)
          None => SrcsetDescriptor::Density(1.0)
        }
      }
      out.push(SrcsetCandidate::{ url: url, descriptor: desc })
    }
  }
  out
}

///| Check whether a `<source type="...">` MIME type is a standard supported web image format.
pub fn is_supported_image_mime(mime : String) -> Bool {
  let trimmed = srcset_trim(mime)
  if trimmed.length() == 0 {
    return true
  }
  let mut semi = 0
  while semi < trimmed.length() && trimmed.code_unit_at(semi) != 59 {
    semi = semi + 1
  }
  let ty = srcset_ascii_lower(srcset_trim(trimmed.slice(0, semi)))
  ty == "image/jpeg" ||
  ty == "image/jpg" ||
  ty == "image/pjpeg" ||
  ty == "image/png" ||
  ty == "image/apng" ||
  ty == "image/gif" ||
  ty == "image/webp" ||
  ty == "image/avif" ||
  ty == "image/svg+xml" ||
  ty == "image/bmp" ||
  ty == "image/x-icon" ||
  ty == "image/vnd.microsoft.icon"
}

///| Select the best image URL from parsed `srcset` candidates per WHATWG HTML §4.8.4.3.6.
pub fn select_srcset_candidate(
  candidates : Array[SrcsetCandidate],
  fallback_src : String,
  target_width : Double,
  dpr : Double,
) -> Option[String] {
  let eff_dpr = if dpr > 0.0 && dpr == dpr { dpr } else { 1.0 }
  let eff_w = if target_width > 0.0 && target_width == target_width {
    target_width
  } else {
    0.0
  }
  let dens : Array[(String, Double)] = []
  let mut has_1x_or_w = false
  let mut ci = 0
  while ci < candidates.length() {
    let c = candidates[ci]
    let d = match c.descriptor {
      SrcsetDescriptor::Width(w) => {
        has_1x_or_w = true
        if eff_w > 0.0 {
          (w as Double) / eff_w
        } else {
          1000000.0
        }
      }
      SrcsetDescriptor::Density(x) => {
        if x == 1.0 {
          has_1x_or_w = true
        }
        x
      }
    }
    let mut dup = false
    let mut dj = 0
    while dj < dens.length() {
      if dens[dj].1 == d {
        dup = true
        break
      }
      dj = dj + 1
    }
    if !dup {
      dens.push((c.url, d))
    }
    ci = ci + 1
  }
  if fallback_src.length() > 0 && !has_1x_or_w {
    let mut has_1 = false
    let mut dj = 0
    while dj < dens.length() {
      if dens[dj].1 == 1.0 {
        has_1 = true
        break
      }
      dj = dj + 1
    }
    if !has_1 {
      dens.push((fallback_src, 1.0))
    }
  }
  if dens.length() == 0 {
    return None
  }
  // Stable insertion sort by effective density ascending.
  let mut a = 1
  while a < dens.length() {
    let cur = dens[a]
    let mut b = a
    while b > 0 && dens[b - 1].1 > cur.1 {
      dens[b] = dens[b - 1]
      b = b - 1
    }
    dens[b] = cur
    a = a + 1
  }
  let mut k = 0
  while k < dens.length() && dens[k].1 < eff_dpr {
    k = k + 1
  }
  if k == dens.length() {
    return Some(dens[k - 1].0)
  }
  if k > 0 {
    let d_lo = dens[k - 1].1
    let d_hi = dens[k].1
    // Geometric mean check: sqrt(d_lo * d_hi) > eff_dpr <=> d_lo * d_hi > eff_dpr * eff_dpr
    if d_lo * d_hi > eff_dpr * eff_dpr {
      return Some(dens[k - 1].0)
    }
  }
  Some(dens[k].0)
}

///| Select the best image URL for a `<picture>` element with `<source>` children and `<img>` fallback.
pub fn select_picture_source(
  sources : Array[PictureSource],
  fallback_srcset : String,
  fallback_src : String,
  target_width : Double,
  dpr : Double,
) -> Option[String] {
  let mut si = 0
  while si < sources.length() {
    let src = sources[si]
    if src.media_matches && is_supported_image_mime(src.mime_type) && srcset_trim(src.srcset).length() > 0 {
      let cands = parse_srcset(src.srcset)
      return select_srcset_candidate(cands, "", target_width, dpr)
    }
    si = si + 1
  }
  let cands = parse_srcset(fallback_srcset)
  select_srcset_candidate(cands, fallback_src, target_width, dpr)
}
