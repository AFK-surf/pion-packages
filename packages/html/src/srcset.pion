///| WHATWG HTML §4.8.4.3 Responsive images: `<img srcset>` & `<picture><source>` parsing and selection.

///| Image candidate descriptor per WHATWG HTML §4.8.4.3.1.
pub enum SrcsetDescriptor {
  Width(Int)
  Density(Double)
}

///|
pub fn srcset_descriptor_eq(
  a : SrcsetDescriptor,
  b : SrcsetDescriptor,
) -> Bool {
  match (a, b) {
    (SrcsetDescriptor::Width(x), SrcsetDescriptor::Width(y)) => x == y
    (SrcsetDescriptor::Density(x), SrcsetDescriptor::Density(y)) => x == y
    _ => false
  }
}

///| A parsed candidate from an HTML `srcset` attribute.
pub struct SrcsetCandidate {
  pub url : String
  pub descriptor : SrcsetDescriptor
}

///| A `<source>` element inside a `<picture>` element.
pub struct PictureSource {
  pub srcset : String
  pub media_matches : Bool
  pub mime_type : String
}

fn srcset_is_space(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

fn srcset_ascii_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let sb = StringBuilder::with_capacity(n)
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_byte((c + 32).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn srcset_trim(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n && srcset_is_space(s.code_unit_at(start)) {
    start = start + 1
  }
  let mut end = n
  while end > start && srcset_is_space(s.code_unit_at(end - 1)) {
    end = end - 1
  }
  s.slice(start, end)
}

///| Parse a WHATWG valid non-negative integer > 0 (ASCII digits only; saturates at Int32 max).
fn srcset_positive_int(s : String) -> Option[Int] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let max_int = 2147483647
  let max_div10 = 214748364
  let mut acc = 0
  let mut has_nonzero = false
  let mut saturated = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    let d = c - 48
    if d != 0 {
      has_nonzero = true
    }
    if !saturated {
      if acc > max_div10 || (acc == max_div10 && d > 7) {
        acc = max_int
        saturated = true
      } else {
        acc = acc * 10 + d
      }
    }
    i = i + 1
  }
  if has_nonzero {
    Some(acc)
  } else {
    None
  }
}

///| Parse a WHATWG valid floating-point number >= 0 (finite, non-negative; -0.0 normalized to 0.0).
fn srcset_non_negative_float(s : String) -> Option[Double] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  if s.code_unit_at(i) == 45 {
    i = i + 1
  }
  let mut digits = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      i = i + 1
      digits = digits + 1
    } else {
      break
    }
  }
  if i < n && s.code_unit_at(i) == 46 {
    i = i + 1
    let mut frac = 0
    while i < n {
      let c = s.code_unit_at(i)
      if c >= 48 && c <= 57 {
        i = i + 1
        frac = frac + 1
      } else {
        break
      }
    }
    if frac == 0 {
      return None
    }
    digits = digits + frac
  }
  if digits == 0 {
    return None
  }
  if i < n && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    i = i + 1
    if i < n && (s.code_unit_at(i) == 43 || s.code_unit_at(i) == 45) {
      i = i + 1
    }
    let mut exp = 0
    while i < n {
      let c = s.code_unit_at(i)
      if c >= 48 && c <= 57 {
        i = i + 1
        exp = exp + 1
      } else {
        break
      }
    }
    if exp == 0 {
      return None
    }
  }
  if i != n {
    return None
  }
  let pos_inf = 1.0 / 0.0
  match s.to_double() {
    Some(v) => if v >= 0.0 && v == v && v != pos_inf {
      if v == 0.0 {
        Some(0.0)
      } else {
        Some(v)
      }
    } else {
      None
    }
    None => None
  }
}

///| Parse an HTML `srcset` attribute per WHATWG HTML §4.8.4.3.1.
///| Linear O(N) time, zero panic on arbitrary input.
pub fn parse_srcset(input : String) -> Array[SrcsetCandidate] {
  let n = input.length()
  let out : Array[SrcsetCandidate] = []
  let mut i = 0
  while i < n {
    // Splitting loop: skip ASCII whitespace and commas.
    while i < n && (srcset_is_space(input.code_unit_at(i)) || input.code_unit_at(i) == 44) {
      i = i + 1
    }
    if i >= n {
      break
    }
    // Collect URL (sequence of non-ASCII-whitespace characters).
    let start = i
    while i < n && !srcset_is_space(input.code_unit_at(i)) {
      i = i + 1
    }
    let mut end = i
    let descs : Array[String] = []
    if input.code_unit_at(end - 1) == 44 {
      // URL ended with comma(s): strip all trailing commas; no descriptor list.
      while end > start && input.code_unit_at(end - 1) == 44 {
        end = end - 1
      }
    } else {
      // Descriptor tokenizer (in_descriptor / in_parens / after_descriptor).
      let mut in_parens = false
      let mut tok_start = -1
      while i < n {
        let c = input.code_unit_at(i)
        if in_parens {
          if tok_start < 0 {
            tok_start = i
          }
          if c == 41 {
            in_parens = false
          }
        } else if c == 44 {
          if tok_start >= 0 {
            descs.push(input.slice(tok_start, i))
            tok_start = -1
          }
          i = i + 1
          break
        } else if srcset_is_space(c) {
          if tok_start >= 0 {
            descs.push(input.slice(tok_start, i))
            tok_start = -1
          }
        } else {
          if tok_start < 0 {
            tok_start = i
          }
          if c == 40 {
            in_parens = true
          }
        }
        i = i + 1
      }
      if tok_start >= 0 {
        let tok_end = if i <= n { i } else { n }
        descs.push(input.slice(tok_start, tok_end))
      }
    }
    if end <= start {
      continue
    }
    let url = input.slice(start, end)
    // Descriptor parser per WHATWG HTML §4.8.4.3.1.
    let mut width : Option[Int] = None
    let mut density : Option[Double] = None
    let mut has_h = false
    let mut bad = false
    let mut di = 0
    while di < descs.length() {
      let d = descs[di]
      let dlen = d.length()
      if dlen < 2 {
        bad = true
      } else {
        let unit = d.code_unit_at(dlen - 1)
        let num = d.slice(0, dlen - 1)
        if unit == 119 && width.is_none() && density.is_none() {
          // 'w'
          match srcset_positive_int(num) {
            Some(v) => width = Some(v)
            None => bad = true
          }
        } else if unit == 120 && density.is_none() && width.is_none() && !has_h {
          // 'x'
          match srcset_non_negative_float(num) {
            Some(v) => density = Some(v)
            None => bad = true
          }
        } else if unit == 104 && !has_h && density.is_none() {
          // 'h' (future-compat)
          match srcset_positive_int(num) {
            Some(_) => has_h = true
            None => bad = true
          }
        } else {
          bad = true
        }
      }
      di = di + 1
    }
    if has_h && width.is_none() {
      bad = true
    }
    if !bad {
      let desc = match width {
        Some(w) => SrcsetDescriptor::Width(w)
        None => match density {
          Some(x) => SrcsetDescriptor::Density(x)
          None => SrcsetDescriptor::Density(1.0)
        }
      }
      out.push(SrcsetCandidate::{ url: url, descriptor: desc })
    }
  }
  out
}

///| Check whether a `<source type="...">` MIME type is a standard supported web image format.
pub fn is_supported_image_mime(mime : String) -> Bool {
  let trimmed = srcset_trim(mime)
  if trimmed.length() == 0 {
    return true
  }
  let mut semi = 0
  while semi < trimmed.length() && trimmed.code_unit_at(semi) != 59 {
    semi = semi + 1
  }
  let ty = srcset_ascii_lower(srcset_trim(trimmed.slice(0, semi)))
  ty == "image/jpeg" ||
  ty == "image/jpg" ||
  ty == "image/pjpeg" ||
  ty == "image/png" ||
  ty == "image/apng" ||
  ty == "image/gif" ||
  ty == "image/webp" ||
  ty == "image/avif" ||
  ty == "image/svg+xml" ||
  ty == "image/bmp" ||
  ty == "image/x-icon" ||
  ty == "image/vnd.microsoft.icon"
}

///| Bottom-up iterative stable merge sort on `(url, density, orig_index)` by `(density, orig_index)` ascending.
fn srcset_sort_candidates(
  items : Array[(String, Double, Int)],
) -> Array[(String, Double, Int)] {
  let n = items.length()
  if n <= 1 {
    return items
  }
  let mut src = items
  let mut dst : Array[(String, Double, Int)] = []
  let mut init_i = 0
  while init_i < n {
    dst.push(src[init_i])
    init_i = init_i + 1
  }
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut i = left
      let mut j = mid
      let mut k = left
      while i < mid && j < right {
        let a = src[i]
        let b = src[j]
        if a.1 < b.1 || (a.1 == b.1 && a.2 <= b.2) {
          dst[k] = a
          i = i + 1
        } else {
          dst[k] = b
          j = j + 1
        }
        k = k + 1
      }
      while i < mid {
        dst[k] = src[i]
        i = i + 1
        k = k + 1
      }
      while j < right {
        dst[k] = src[j]
        j = j + 1
        k = k + 1
      }
      left = left + width * 2
    }
    let tmp = src
    src = dst
    dst = tmp
    width = width * 2
  }
  src
}

///| Select the best image URL from parsed `srcset` candidates per WHATWG HTML §4.8.4.3.6.
///| O(n log n) time, zero recursion, preserves earliest candidate on duplicate density.
pub fn select_srcset_candidate(
  candidates : Array[SrcsetCandidate],
  fallback_src : String,
  target_width : Double,
  dpr : Double,
) -> Option[String] {
  let eff_dpr = if dpr > 0.0 && dpr == dpr { dpr } else { 1.0 }
  let eff_w = if target_width > 0.0 && target_width == target_width {
    target_width
  } else {
    0.0
  }
  let raw : Array[(String, Double, Int)] = []
  let mut has_1x_or_w = false
  let mut has_exact_1 = false
  let mut ci = 0
  while ci < candidates.length() {
    let c = candidates[ci]
    let d = match c.descriptor {
      SrcsetDescriptor::Width(w) => {
        has_1x_or_w = true
        if eff_w > 0.0 {
          (w as Double) / eff_w
        } else {
          1000000.0
        }
      }
      SrcsetDescriptor::Density(x) => {
        let norm_x = if x >= 0.0 && x == x {
          if x == 0.0 { 0.0 } else { x }
        } else {
          0.0
        }
        if norm_x == 1.0 {
          has_1x_or_w = true
        }
        norm_x
      }
    }
    if d == 1.0 {
      has_exact_1 = true
    }
    raw.push((c.url, d, ci))
    ci = ci + 1
  }
  if fallback_src.length() > 0 && !has_1x_or_w && !has_exact_1 {
    raw.push((fallback_src, 1.0, ci))
  }
  if raw.length() == 0 {
    return None
  }
  let sorted = srcset_sort_candidates(raw)
  // Adjacent deduplication keeping earliest original index for each equal density.
  let dens : Array[(String, Double)] = []
  let mut si = 0
  while si < sorted.length() {
    let item = sorted[si]
    if dens.length() == 0 || dens[dens.length() - 1].1 != item.1 {
      dens.push((item.0, item.1))
    }
    si = si + 1
  }
  let mut k = 0
  while k < dens.length() && dens[k].1 < eff_dpr {
    k = k + 1
  }
  if k == dens.length() {
    return Some(dens[k - 1].0)
  }
  if k > 0 {
    let d_lo = dens[k - 1].1
    let d_hi = dens[k].1
    // Geometric mean check: sqrt(d_lo * d_hi) > eff_dpr <=> d_lo * d_hi > eff_dpr * eff_dpr
    if d_lo * d_hi > eff_dpr * eff_dpr {
      return Some(dens[k - 1].0)
    }
  }
  Some(dens[k].0)
}

///| Select the best image URL for a `<picture>` element with `<source>` children and `<img>` fallback.
pub fn select_picture_source(
  sources : Array[PictureSource],
  fallback_srcset : String,
  fallback_src : String,
  target_width : Double,
  dpr : Double,
) -> Option[String] {
  let mut si = 0
  while si < sources.length() {
    let src = sources[si]
    if src.media_matches && is_supported_image_mime(src.mime_type) && srcset_trim(src.srcset).length() > 0 {
      let cands = parse_srcset(src.srcset)
      if cands.length() > 0 {
        return select_srcset_candidate(cands, "", target_width, dpr)
      }
    }
    si = si + 1
  }
  let cands = parse_srcset(fallback_srcset)
  select_srcset_candidate(cands, fallback_src, target_width, dpr)
}
