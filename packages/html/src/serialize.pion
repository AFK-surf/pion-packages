///| Iterative HTML5 serializer (`to_html`, `outer_html`, `inner_html`) and `text_content`.

///| Escape text content (`&`, `<`, `>`) into `sb`.
fn write_escaped_text(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  let mut seg = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 0x26 || b == 0x3C || b == 0x3E {
      if i > seg {
        sb.write_string(s.slice(seg, i))
      }
      if b == 0x26 {
        sb.write_string("&amp;")
      } else if b == 0x3C {
        sb.write_string("&lt;")
      } else {
        sb.write_string("&gt;")
      }
      i = i + 1
      seg = i
    } else {
      i = i + 1
    }
  }
  if seg < n {
    sb.write_string(s.slice(seg, n))
  }
}

///| Escape an HTML attribute value (`&`, `"`) into `sb`.
fn write_escaped_attr(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  let mut seg = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 0x26 || b == 0x22 {
      if i > seg {
        sb.write_string(s.slice(seg, i))
      }
      if b == 0x26 {
        sb.write_string("&amp;")
      } else {
        sb.write_string("&quot;")
      }
      i = i + 1
      seg = i
    } else {
      i = i + 1
    }
  }
  if seg < n {
    sb.write_string(s.slice(seg, n))
  }
}

///| Check whether a tag name serializes its text children unescaped (WHATWG §13.3).
fn is_raw_serialize_tag(tag : String) -> Bool {
  match tag {
    "script" | "style" | "xmp" | "iframe" | "noembed" | "noframes" | "plaintext" =>
    true
    _ => false
  }
}

///| Iteratively serialize a node (or only its children if `include_self == false`) into `sb`.
fn serialize_node_into(
  doc : Document,
  root_id : Int,
  include_self : Bool,
  sb : StringBuilder,
) -> Unit {
  // Explicit cursor stack: (node_id, next_child_id, raw_text_mode)
  // next_child_id == -2 means "not entered yet"; -1 means "children done, emit closing tag"
  let stack_node : Array[Int] = []
  let stack_child : Array[Int] = []
  let stack_raw : Array[Bool] = []

  if include_self {
    stack_node.push(root_id)
    stack_child.push(-2)
    stack_raw.push(false)
  } else {
    let rn = doc.nodes[root_id]
    let raw = if rn.kind == 2 {
      is_raw_serialize_tag(doc_resolve_span(doc, rn.data_start, rn.data_end))
    } else {
      false
    }
    stack_node.push(root_id)
    stack_child.push(rn.first_child)
    stack_raw.push(raw)
  }

  while stack_node.length() > 0 {
    let top = stack_node.length() - 1
    let nid = stack_node[top]
    let next_c = stack_child[top]
    let parent_raw = stack_raw[top]
    let nd = doc.nodes[nid]

    if next_c == -2 {
      // Entering node
      if nd.kind == 0 {
        // Document
        stack_child[top] = nd.first_child
      } else if nd.kind == 1 {
        // Doctype
        sb.write_string("<!DOCTYPE ")
        let name = doc_resolve_span(doc, nd.data_start, nd.data_end)
        if name.length() > 0 {
          sb.write_string(name)
        } else {
          sb.write_string("html")
        }
        sb.write_byte((0x3E).to_byte())
        let _ = stack_node.pop()
        let _ = stack_child.pop()
        let _ = stack_raw.pop()
      } else if nd.kind == 2 {
        // Element
        let tag = doc_resolve_span(doc, nd.data_start, nd.data_end)
        sb.write_byte((0x3C).to_byte())
        sb.write_string(tag)
        let mut a = nd.attrs_start
        while a < nd.attrs_end {
          let ad = doc.attrs[a]
          sb.write_byte((0x20).to_byte())
          sb.write_string(doc_resolve_span(doc, ad.name_start, ad.name_end))
          sb.write_string("=\"")
          write_escaped_attr(sb, doc_resolve_span(doc, ad.val_start, ad.val_end))
          sb.write_byte((0x22).to_byte())
          a = a + 1
        }
        sb.write_byte((0x3E).to_byte())
        if is_void_tag(tag) {
          let _ = stack_node.pop()
          let _ = stack_child.pop()
          let _ = stack_raw.pop()
        } else {
          stack_child[top] = nd.first_child
          stack_raw[top] = is_raw_serialize_tag(tag)
        }
      } else if nd.kind == 3 {
        // Text
        let txt = doc_resolve_span(doc, nd.data_start, nd.data_end)
        if parent_raw {
          sb.write_string(txt)
        } else {
          write_escaped_text(sb, txt)
        }
        let _ = stack_node.pop()
        let _ = stack_child.pop()
        let _ = stack_raw.pop()
      } else if nd.kind == 4 {
        // Comment
        sb.write_string("<!--")
        sb.write_string(doc_resolve_span(doc, nd.data_start, nd.data_end))
        sb.write_string("-->")
        let _ = stack_node.pop()
        let _ = stack_child.pop()
        let _ = stack_raw.pop()
      } else {
        let _ = stack_node.pop()
        let _ = stack_child.pop()
        let _ = stack_raw.pop()
      }
    } else if next_c >= 0 {
      // Advance cursor to next sibling and push current child
      let child_nd = doc.nodes[next_c]
      stack_child[top] = child_nd.next_sibling
      stack_node.push(next_c)
      stack_child.push(-2)
      stack_raw.push(parent_raw)
    } else {
      // Children finished
      if nd.kind == 2 && (include_self || nid != root_id) {
        sb.write_string("</")
        sb.write_string(doc_resolve_span(doc, nd.data_start, nd.data_end))
        sb.write_byte((0x3E).to_byte())
      }
      let _ = stack_node.pop()
      let _ = stack_child.pop()
      let _ = stack_raw.pop()
    }
  }
}

///| Iteratively extract concatenated text content of a node subtree into `sb`.
fn collect_text_into(doc : Document, root_id : Int, sb : StringBuilder) -> Unit {
  let rn = doc.nodes[root_id]
  if rn.kind == 3 {
    sb.write_string(doc_resolve_span(doc, rn.data_start, rn.data_end))
    return ()
  }
  let stack : Array[Int] = []
  let mut cur = rn.first_child
  while cur >= 0 || stack.length() > 0 {
    while cur >= 0 {
      let nd = doc.nodes[cur]
      if nd.kind == 3 {
        sb.write_string(doc_resolve_span(doc, nd.data_start, nd.data_end))
        cur = nd.next_sibling
      } else if nd.first_child >= 0 {
        if nd.next_sibling >= 0 {
          stack.push(nd.next_sibling)
        }
        cur = nd.first_child
      } else {
        cur = nd.next_sibling
      }
    }
    if stack.length() > 0 {
      match stack.pop() {
        Some(nxt) => cur = nxt
        None => ()
      }
    }
  }
}

///|
pub fn Document::to_html(self : Document) -> String {
  let sb = StringBuilder::with_capacity(self.src.length() + 32)
  serialize_node_into(self, 0, true, sb)
  sb.to_string()
}

///|
pub fn Document::text_content(self : Document) -> String {
  let sb = StringBuilder::with_capacity(64)
  collect_text_into(self, 0, sb)
  sb.to_string()
}

///|
pub fn Node::outer_html(self : Node) -> String {
  let sb = StringBuilder::with_capacity(64)
  serialize_node_into(self.doc, self.id, true, sb)
  sb.to_string()
}

///|
pub fn Node::inner_html(self : Node) -> String {
  let sb = StringBuilder::with_capacity(64)
  serialize_node_into(self.doc, self.id, false, sb)
  sb.to_string()
}

///|
pub fn Node::text_content(self : Node) -> String {
  let sb = StringBuilder::with_capacity(64)
  collect_text_into(self.doc, self.id, sb)
  sb.to_string()
}
