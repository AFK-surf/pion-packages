///| Flat-array DOM mutation helpers, scope checks, active formatting list, and adoption agency.

fn set_node_parent_sibs(
  nodes : Array[NodeData],
  id : Int,
  parent : Int,
  prev : Int,
  next : Int,
) -> Unit {
  let n = nodes[id]
  nodes[id] = NodeData::{
    kind: n.kind,
    parent: parent,
    prev_sibling: prev,
    next_sibling: next,
    first_child: n.first_child,
    last_child: n.last_child,
    data_start: n.data_start,
    data_end: n.data_end,
    attrs_start: n.attrs_start,
    attrs_end: n.attrs_end,
  }
}

fn set_node_children(
  nodes : Array[NodeData],
  id : Int,
  first : Int,
  last : Int,
) -> Unit {
  let n = nodes[id]
  nodes[id] = NodeData::{
    kind: n.kind,
    parent: n.parent,
    prev_sibling: n.prev_sibling,
    next_sibling: n.next_sibling,
    first_child: first,
    last_child: last,
    data_start: n.data_start,
    data_end: n.data_end,
    attrs_start: n.attrs_start,
    attrs_end: n.attrs_end,
  }
}

///| Mark document node 0 as having undergone reparenting (not strictly in creation pre-order).
fn mark_reparented(nodes : Array[NodeData]) -> Unit {
  let d = nodes[0]
  if d.data_start == 0 {
    nodes[0] = NodeData::{
      kind: d.kind,
      parent: d.parent,
      prev_sibling: d.prev_sibling,
      next_sibling: d.next_sibling,
      first_child: d.first_child,
      last_child: d.last_child,
      data_start: 1,
      data_end: d.data_end,
      attrs_start: d.attrs_start,
      attrs_end: d.attrs_end,
    }
  }
}

///| Detach `nid` from its current parent's child list.
fn unlink_node(nodes : Array[NodeData], nid : Int) -> Unit {
  mark_reparented(nodes)
  let n = nodes[nid]
  let pid = n.parent
  if pid < 0 {
    return ()
  }
  let prev = n.prev_sibling
  let next = n.next_sibling
  if prev >= 0 {
    let pn = nodes[prev]
    set_node_parent_sibs(nodes, prev, pn.parent, pn.prev_sibling, next)
  }
  if next >= 0 {
    let nn = nodes[next]
    set_node_parent_sibs(nodes, next, nn.parent, prev, nn.next_sibling)
  }
  let p = nodes[pid]
  let new_first = if p.first_child == nid { next } else { p.first_child }
  let new_last = if p.last_child == nid { prev } else { p.last_child }
  set_node_children(nodes, pid, new_first, new_last)
  set_node_parent_sibs(nodes, nid, -1, -1, -1)
}

///| Insert `child_id` into `parent_id` immediately before `ref_id` (which must be a child of `parent_id`).
fn insert_before(
  nodes : Array[NodeData],
  parent_id : Int,
  ref_id : Int,
  child_id : Int,
) -> Unit {
  mark_reparented(nodes)
  let r = nodes[ref_id]
  let prev = r.prev_sibling
  if prev >= 0 {
    let pn = nodes[prev]
    set_node_parent_sibs(nodes, prev, pn.parent, pn.prev_sibling, child_id)
  } else {
    let p = nodes[parent_id]
    set_node_children(nodes, parent_id, child_id, p.last_child)
  }
  set_node_parent_sibs(nodes, child_id, parent_id, prev, ref_id)
  set_node_parent_sibs(nodes, ref_id, parent_id, child_id, r.next_sibling)
}

///| Move all children of `src_id` to the end of `dst_id`.
fn move_all_children(nodes : Array[NodeData], src_id : Int, dst_id : Int) -> Unit {
  let mut cur = nodes[src_id].first_child
  while cur >= 0 {
    let nxt = nodes[cur].next_sibling
    unlink_node(nodes, cur)
    link_child(nodes, dst_id, cur)
    cur = nxt
  }
}

///| Merge non-duplicate attributes `[new_start..new_end)` onto an existing element `target_id`.
fn TreeBuilder::merge_attrs(
  self : TreeBuilder,
  target_id : Int,
  new_start : Int,
  new_end : Int,
) -> Unit {
  if new_start >= new_end {
    return ()
  }
  let tn = self.nodes[target_id]
  let old_start = tn.attrs_start
  let old_end = tn.attrs_end
  // Copy existing attrs to end of `self.attrs` if target already has attrs
  let merged_start = self.attrs.length()
  let mut i = old_start
  while i < old_end {
    self.attrs.push(self.attrs[i])
    i = i + 1
  }
  // Append non-duplicate new attrs
  let mut j = new_start
  while j < new_end {
    let na = self.attrs[j]
    let nname = raw_resolve_span(self.src, self.strings, na.name_start, na.name_end)
    let mut exists = false
    let mut k = old_start
    while k < old_end {
      let oa = self.attrs[k]
      if raw_resolve_span(self.src, self.strings, oa.name_start, oa.name_end) == nname {
        exists = true
        break
      }
      k = k + 1
    }
    if !exists {
      self.attrs.push(na)
    }
    j = j + 1
  }
  let merged_end = self.attrs.length()
  let cur = self.nodes[target_id]
  self.nodes[target_id] = NodeData::{
    kind: cur.kind,
    parent: cur.parent,
    prev_sibling: cur.prev_sibling,
    next_sibling: cur.next_sibling,
    first_child: cur.first_child,
    last_child: cur.last_child,
    data_start: cur.data_start,
    data_end: cur.data_end,
    attrs_start: merged_start,
    attrs_end: merged_end,
  }
}

///| Check whether two element nodes have identical attribute sets (for Noah's Ark clause).
fn TreeBuilder::same_node_attrs(
  self : TreeBuilder,
  id_a : Int,
  id_b : Int,
) -> Bool {
  let na = self.nodes[id_a]
  let nb = self.nodes[id_b]
  let ca = na.attrs_end - na.attrs_start
  let cb = nb.attrs_end - nb.attrs_start
  if ca != cb {
    return false
  }
  if ca == 0 {
    return true
  }
  let mut i = 0
  while i < ca {
    let aa = self.attrs[na.attrs_start + i]
    let aname = raw_resolve_span(self.src, self.strings, aa.name_start, aa.name_end)
    let aval = raw_resolve_span(self.src, self.strings, aa.val_start, aa.val_end)
    let mut matched = false
    let mut j = 0
    while j < cb {
      let ab = self.attrs[nb.attrs_start + j]
      if raw_resolve_span(self.src, self.strings, ab.name_start, ab.name_end) == aname &&
      raw_resolve_span(self.src, self.strings, ab.val_start, ab.val_end) == aval {
        matched = true
        break
      }
      j = j + 1
    }
    if !matched {
      return false
    }
    i = i + 1
  }
  true
}

///| Check whether an HTML tag is in the "special" category.
fn is_special_html_tag(tag : String) -> Bool {
  match tag {
    "address" | "applet" | "area" | "article" | "aside" | "base" | "basefont" | "bgsound" | "blockquote" | "body" | "br" | "button" | "caption" | "center" | "col" | "colgroup" | "dd" | "details" | "dialog" | "dir" | "div" | "dl" | "dt" | "embed" | "fieldset" | "figcaption" | "figure" | "footer" | "form" | "frame" | "frameset" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "head" | "header" | "hgroup" | "hr" | "html" | "iframe" | "img" | "input" | "keygen" | "li" | "link" | "listing" | "main" | "marquee" | "menu" | "meta" | "nav" | "noembed" | "noframes" | "noscript" | "object" | "ol" | "p" | "param" | "plaintext" | "pre" | "script" | "search" | "section" | "select" | "source" | "style" | "summary" | "table" | "tbody" | "td" | "template" | "textarea" | "tfoot" | "th" | "thead" | "title" | "tr" | "track" | "ul" | "wbr" | "xmp" =>
    true
    _ => false
  }
}

///| Check whether a tag is a foster-parenting container.
fn is_table_foster_tag(tag : String) -> Bool {
  match tag {
    "table" | "tbody" | "tfoot" | "thead" | "tr" => true
    _ => false
  }
}

///| Check whether a tag breaks out of foreign (SVG/MathML) content.
fn is_foreign_breakout_tag(tag : String) -> Bool {
  match tag {
    "b" | "big" | "blockquote" | "body" | "br" | "center" | "code" | "dd" | "div" | "dl" | "dt" | "em" | "embed" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "head" | "hr" | "i" | "img" | "li" | "listing" | "menu" | "meta" | "nobr" | "ol" | "p" | "pre" | "ruby" | "s" | "small" | "span" | "strong" | "strike" | "sub" | "sup" | "table" | "tt" | "u" | "ul" | "var" =>
    true
    _ => false
  }
}

///| Check whether a foreign element is an HTML integration point or MathML text integration point.
fn is_foreign_html_integration(ns : Int, tag : String) -> Bool {
  if ns == 1 {
    tag == "foreignObject" || tag == "desc" || tag == "title"
  } else if ns == 2 {
    tag == "mi" || tag == "mo" || tag == "mn" || tag == "ms" || tag == "mtext"
  } else {
    false
  }
}

///| Check whether a tag is a default scope boundary in HTML namespace.
fn is_default_scope_marker(ns : Int, tag : String) -> Bool {
  if ns == 0 {
    match tag {
      "applet" | "caption" | "html" | "table" | "td" | "th" | "marquee" | "object" | "template" =>
      true
      _ => false
    }
  } else if ns == 1 {
    tag == "foreignObject" || tag == "desc" || tag == "title"
  } else {
    tag == "mi" || tag == "mo" || tag == "mn" || tag == "ms" || tag == "mtext" || tag == "annotation-xml"
  }
}

///| Check whether an HTML tag is an implied end tag.
fn is_implied_end_tag(tag : String) -> Bool {
  match tag {
    "dd" | "dt" | "li" | "optgroup" | "option" | "p" | "rb" | "rp" | "rt" | "rtc" =>
    true
    _ => false
  }
}

///| Adjust attribute names in `tb.attrs[start..end)` for SVG (ns=1) or MathML (ns=2).
fn TreeBuilder::adjust_foreign_attrs(
  self : TreeBuilder,
  ns : Int,
  attrs_start : Int,
  attrs_end : Int,
) -> Unit {
  let mut i = attrs_start
  while i < attrs_end {
    let ad = self.attrs[i]
    let cur_name = raw_resolve_span(self.src, self.strings, ad.name_start, ad.name_end)
    let adj = if ns == 1 {
      adjust_svg_attr(cur_name)
    } else {
      adjust_mathml_attr(cur_name)
    }
    if adj != cur_name {
      let (nds, nde) = intern_str(self.strings, adj)
      self.attrs[i] = AttrData::{
        name_start: nds,
        name_end: nde,
        val_start: ad.val_start,
        val_end: ad.val_end,
      }
    }
    i = i + 1
  }
}
