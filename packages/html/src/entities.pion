///| HTML5 named & numeric character reference decoder (WHATWG §13.2.5.72-80).

///| Append a Unicode scalar value `cp` as UTF-8 bytes into `sb`.
fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp <= 0x7F {
    sb.write_byte(cp.to_byte())
  } else if cp <= 0x7FF {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0xFFFF {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0x10FFFF {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_string("\u{FFFD}")
  }
}

///| WHATWG HTML5 Windows-1252 replacement table for numeric character references `0x80..0x9F`.
fn win1252_remap(cp : Int) -> Int {
  match cp {
    0x80 => 0x20AC // €
    0x82 => 0x201A // ‚
    0x83 => 0x0192 // ƒ
    0x84 => 0x201E // „
    0x85 => 0x2026 // …
    0x86 => 0x2020 // †
    0x87 => 0x2021 // ‡
    0x88 => 0x02C6 // ˆ
    0x89 => 0x2030 // ‰
    0x8A => 0x0160 // Š
    0x8B => 0x2039 // ‹
    0x8C => 0x0152 // Œ
    0x8E => 0x017D // Ž
    0x91 => 0x2018 // ‘
    0x92 => 0x2019 // ’
    0x93 => 0x201C // “
    0x94 => 0x201D // ”
    0x95 => 0x2022 // •
    0x96 => 0x2013 // –
    0x97 => 0x2014 // —
    0x98 => 0x02DC // ˜
    0x99 => 0x2122 // ™
    0x9A => 0x0161 // š
    0x9B => 0x203A // ›
    0x9C => 0x0153 // œ
    0x9E => 0x017E // ž
    0x9F => 0x0178 // Ÿ
    _ => cp
  }
}

///| Sanitize a numeric character reference codepoint per WHATWG §13.2.5.80.
fn sanitize_numeric_cp(cp : Int) -> Int {
  if cp == 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    0xFFFD
  } else if cp >= 0x80 && cp <= 0x9F {
    win1252_remap(cp)
  } else {
    cp
  }
}

///| Check if a byte is ASCII alphanumeric (`0-9`, `A-Z`, `a-z`).
fn is_ascii_alnum(b : Int) -> Bool {
  (b >= 0x30 && b <= 0x39) ||
  (b >= 0x41 && b <= 0x5A) ||
  (b >= 0x61 && b <= 0x7A)
}

///| Check if a byte is ASCII letter (`A-Z`, `a-z`).
fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 0x41 && b <= 0x5A) || (b >= 0x61 && b <= 0x7A)
}

///| Check if a byte is ASCII whitespace (space, tab, LF, FF, CR).
fn is_html_ws(b : Int) -> Bool {
  b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0C || b == 0x0D
}

///| Lowercase a single ASCII byte.
fn ascii_lower_byte(b : Int) -> Int {
  if b >= 0x41 && b <= 0x5A {
    b + 32
  } else {
    b
  }
}

///| Lowercase an ASCII string (returns original if already lowercase).
fn to_ascii_lower(s : String) -> String {
  let n = s.length()
  let mut i = 0
  let mut has_upper = false
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 0x41 && b <= 0x5A {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let sb = StringBuilder::with_capacity(n)
  i = 0
  while i < n {
    sb.write_byte(ascii_lower_byte(s.code_unit_at(i)).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Check whether slice `src[start..end]` equals lowercase literal `lit` (ASCII case-insensitive).
fn slice_eq_ci(src : String, start : Int, end : Int, lit : String) -> Bool {
  let n = end - start
  if n != lit.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if ascii_lower_byte(src.code_unit_at(start + i)) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Check whether slice `src[start..end]` equals exact string `lit`.
fn slice_eq_exact(src : String, start : Int, end : Int, lit : String) -> Bool {
  let n = end - start
  if n != lit.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if src.code_unit_at(start + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Look up a legacy HTML5 named character reference (allowed without semicolon).
///| Returns codepoint (> 0) or -1 if not a legacy entity.
fn lookup_legacy_entity(name : String) -> Int {
  match name {
    "amp" | "AMP" => 0x26
    "lt" | "LT" => 0x3C
    "gt" | "GT" => 0x3E
    "quot" | "QUOT" => 0x22
    "nbsp" => 0xA0
    "copy" | "COPY" => 0xA9
    "reg" | "REG" => 0xAE
    "iexcl" => 0xA1
    "cent" => 0xA2
    "pound" => 0xA3
    "curren" => 0xA4
    "yen" => 0xA5
    "brvbar" => 0xA6
    "sect" => 0xA7
    "uml" => 0xA8
    "ordf" => 0xAA
    "laquo" => 0xAB
    "not" => 0xAC
    "shy" => 0xAD
    "macr" => 0xAF
    "deg" => 0xB0
    "plusmn" => 0xB1
    "sup2" => 0xB2
    "sup3" => 0xB3
    "acute" => 0xB4
    "micro" => 0xB5
    "para" => 0xB6
    "middot" => 0xB7
    "cedil" => 0xB8
    "sup1" => 0xB9
    "ordm" => 0xBA
    "raquo" => 0xBB
    "frac14" => 0xBC
    "frac12" => 0xBD
    "frac34" => 0xBE
    "iquest" => 0xBF
    "times" => 0xD7
    "divide" => 0xF7
    _ => -1
  }
}

///| Look up a semicolon-terminated HTML5 named character reference.
///| Returns codepoint (> 0) or -1 if unknown.
fn lookup_named_entity(name : String) -> Int {
  let leg = lookup_legacy_entity(name)
  if leg > 0 {
    return leg
  }
  match name {
    "apos" => 0x27
    "trade" | "TRADE" => 0x2122
    "mdash" => 0x2014
    "ndash" => 0x2013
    "hellip" => 0x2026
    "lsquo" => 0x2018
    "rsquo" => 0x2019
    "ldquo" => 0x201C
    "rdquo" => 0x201D
    "bull" => 0x2022
    "euro" => 0x20AC
    "dagger" => 0x2020
    "Dagger" => 0x2021
    "permil" => 0x2030
    "lsaquo" => 0x2039
    "rsaquo" => 0x203A
    "ensp" => 0x2002
    "emsp" => 0x2003
    "thinsp" => 0x2009
    "zwnj" => 0x200C
    "zwj" => 0x200D
    "lrm" => 0x200E
    "rlm" => 0x200F
    "larr" => 0x2190
    "uarr" => 0x2191
    "rarr" => 0x2192
    "darr" => 0x2193
    "harr" => 0x2194
    "le" => 0x2264
    "ge" => 0x2265
    "ne" => 0x2260
    "asymp" => 0x2248
    "equiv" => 0x2261
    "infin" => 0x221E
    "minus" => 0x2212
    "radic" => 0x221A
    "sum" => 0x2211
    "prod" => 0x220F
    "int" => 0x222B
    "part" => 0x2202
    "empty" => 0x2205
    "nabla" => 0x2207
    "isin" => 0x2208
    "notin" => 0x2209
    "ni" => 0x220B
    "and" => 0x2227
    "or" => 0x2228
    "cap" => 0x2229
    "cup" => 0x222A
    "sub" => 0x2282
    "sup" => 0x2283
    "nsub" => 0x2284
    "sube" => 0x2286
    "supe" => 0x2287
    "oplus" => 0x2295
    "otimes" => 0x2297
    "perp" => 0x22A5
    "sdot" => 0x22C5
    "forall" => 0x2200
    "exist" => 0x2203
    "alpha" => 0x03B1
    "beta" => 0x03B2
    "gamma" => 0x03B3
    "delta" => 0x03B4
    "epsilon" => 0x03B5
    "zeta" => 0x03B6
    "eta" => 0x03B7
    "theta" => 0x03B8
    "iota" => 0x03B9
    "kappa" => 0x03BA
    "lambda" => 0x03BB
    "mu" => 0x03BC
    "nu" => 0x03BD
    "xi" => 0x03BE
    "omicron" => 0x03BF
    "pi" => 0x03C0
    "rho" => 0x03C1
    "sigmaf" => 0x03C2
    "sigma" => 0x03C3
    "tau" => 0x03C4
    "upsilon" => 0x03C5
    "phi" => 0x03C6
    "chi" => 0x03C7
    "psi" => 0x03C8
    "omega" => 0x03C9
    "Alpha" => 0x0391
    "Beta" => 0x0392
    "Gamma" => 0x0393
    "Delta" => 0x0394
    "Epsilon" => 0x0395
    "Theta" => 0x0398
    "Lambda" => 0x039B
    "Pi" => 0x03A0
    "Sigma" => 0x03A3
    "Phi" => 0x03A6
    "Psi" => 0x03A8
    "Omega" => 0x03A9
    "Tab" | "tab" => 0x09
    "NewLine" | "newline" => 0x0A
    "excl" => 0x21
    "num" => 0x23
    "dollar" => 0x24
    "percnt" => 0x25
    "lpar" => 0x28
    "rpar" => 0x29
    "ast" => 0x2A
    "plus" => 0x2B
    "comma" => 0x2C
    "period" => 0x2E
    "sol" => 0x2F
    "colon" => 0x3A
    "semi" => 0x3B
    "equals" => 0x3D
    "quest" => 0x3F
    "commat" => 0x40
    "lsqb" => 0x5B
    "bsol" => 0x5C
    "rsqb" => 0x5D
    "Hat" | "circ" => 0x5E
    "lowbar" => 0x5F
    "grave" => 0x60
    "lcub" | "lbrace" => 0x7B
    "verbar" | "vert" => 0x7C
    "rcub" | "rbrace" => 0x7D
    "tilde" => 0x7E
    "spades" => 0x2660
    "clubs" => 0x2663
    "hearts" => 0x2665
    "diams" => 0x2666
    "Agrave" => 0xC0
    "Aacute" => 0xC1
    "Acirc" => 0xC2
    "Atilde" => 0xC3
    "Auml" => 0xC4
    "Aring" => 0xC5
    "AElig" => 0xC6
    "Ccedil" => 0xC7
    "Egrave" => 0xC8
    "Eacute" => 0xC9
    "Ecirc" => 0xCA
    "Euml" => 0xCB
    "Igrave" => 0xCC
    "Iacute" => 0xCD
    "Icirc" => 0xCE
    "Iuml" => 0xCF
    "Ntilde" => 0xD1
    "Ograve" => 0xD2
    "Oacute" => 0xD3
    "Ocirc" => 0xD4
    "Otilde" => 0xD5
    "Ouml" => 0xD6
    "Oslash" => 0xD8
    "Ugrave" => 0xD9
    "Uacute" => 0xDA
    "Ucirc" => 0xDB
    "Uuml" => 0xDC
    "szlig" => 0xDF
    "agrave" => 0xE0
    "aacute" => 0xE1
    "acirc" => 0xE2
    "atilde" => 0xE3
    "auml" => 0xE4
    "aring" => 0xE5
    "aelig" => 0xE6
    "ccedil" => 0xE7
    "egrave" => 0xE8
    "eacute" => 0xE9
    "ecirc" => 0xEA
    "euml" => 0xEB
    "igrave" => 0xEC
    "iacute" => 0xED
    "icirc" => 0xEE
    "iuml" => 0xEF
    "ntilde" => 0xF1
    "ograve" => 0xF2
    "oacute" => 0xF3
    "ocirc" => 0xF4
    "otilde" => 0xF5
    "ouml" => 0xF6
    "oslash" => 0xF8
    "ugrave" => 0xF9
    "uacute" => 0xFA
    "ucirc" => 0xFB
    "uuml" => 0xFC
    "yuml" => 0xFF
    _ => -1
  }
}

///| Decode a single HTML5 character reference starting at `amp_pos` (`src[amp_pos] == '&'`).
///| Appends decoded bytes into `sb` and returns the next byte index after the reference.
fn decode_one_entity(
  src : String,
  amp_pos : Int,
  end : Int,
  in_attr : Bool,
  sb : StringBuilder,
) -> Int {
  let mut i = amp_pos + 1
  if i >= end {
    sb.write_byte((0x26).to_byte())
    return i
  }
  let b0 = src.code_unit_at(i)
  if b0 == 0x23 {
    // Numeric character reference: &#... or &#x...
    i = i + 1
    if i >= end {
      sb.write_string("&#")
      return i
    }
    let bx = src.code_unit_at(i)
    if bx == 0x78 || bx == 0x58 {
      // Hexadecimal
      i = i + 1
      let dstart = i
      let mut cp = 0
      while i < end {
        let c = src.code_unit_at(i)
        let d = if c >= 0x30 && c <= 0x39 {
          c - 0x30
        } else if c >= 0x61 && c <= 0x66 {
          c - 0x61 + 10
        } else if c >= 0x41 && c <= 0x46 {
          c - 0x41 + 10
        } else {
          -1
        }
        if d < 0 {
          break
        }
        if cp < 0x110000 {
          cp = (cp << 4) | d
        }
        i = i + 1
      }
      if i == dstart {
        sb.write_string(src.slice(amp_pos, i))
        return i
      }
      if i < end && src.code_unit_at(i) == 0x3B {
        i = i + 1
      }
      write_utf8_cp(sb, sanitize_numeric_cp(cp))
      return i
    } else {
      // Decimal
      let dstart = i
      let mut cp = 0
      while i < end {
        let c = src.code_unit_at(i)
        if c >= 0x30 && c <= 0x39 {
          if cp < 0x110000 {
            cp = cp * 10 + (c - 0x30)
          }
          i = i + 1
        } else {
          break
        }
      }
      if i == dstart {
        sb.write_string("&#")
        return i
      }
      if i < end && src.code_unit_at(i) == 0x3B {
        i = i + 1
      }
      write_utf8_cp(sb, sanitize_numeric_cp(cp))
      return i
    }
  }

  // Named character reference
  if !is_ascii_alpha(b0) {
    sb.write_byte((0x26).to_byte())
    return i
  }
  let name_start = i
  let max_end = if name_start + 32 < end { name_start + 32 } else { end }
  while i < max_end && is_ascii_alnum(src.code_unit_at(i)) {
    i = i + 1
  }
  if i < end && src.code_unit_at(i) == 0x3B {
    // Semicolon-terminated: try exact full match first
    let name = src.slice(name_start, i)
    let cp = lookup_named_entity(name)
    if cp > 0 {
      write_utf8_cp(sb, cp)
      return i + 1
    }
  }
  // Try longest legacy prefix without semicolon
  let mut k = i
  if k > name_start + 6 {
    k = name_start + 6
  }
  while k >= name_start + 2 {
    let cand = src.slice(name_start, k)
    let cp = lookup_legacy_entity(cand)
    if cp > 0 {
      if in_attr && k < end {
        let next_b = src.code_unit_at(k)
        if next_b == 0x3D || is_ascii_alnum(next_b) {
          sb.write_byte((0x26).to_byte())
          return amp_pos + 1
        }
      }
      write_utf8_cp(sb, cp)
      return k
    }
    k = k - 1
  }
  sb.write_byte((0x26).to_byte())
  amp_pos + 1
}

///| Decode HTML5 character references and normalize `\r\n`/`\r` -> `\n` in `src[start..end]` into `sb`.
fn decode_entities_into(
  src : String,
  start : Int,
  end : Int,
  in_attr : Bool,
  sb : StringBuilder,
) -> Unit {
  let mut i = start
  let mut seg_start = start
  while i < end {
    let b = src.code_unit_at(i)
    if b == 0x26 {
      if i > seg_start {
        sb.write_string(src.slice(seg_start, i))
      }
      i = decode_one_entity(src, i, end, in_attr, sb)
      seg_start = i
    } else if b == 0x0D {
      if i > seg_start {
        sb.write_string(src.slice(seg_start, i))
      }
      sb.write_byte((0x0A).to_byte())
      if i + 1 < end && src.code_unit_at(i + 1) == 0x0A {
        i = i + 2
      } else {
        i = i + 1
      }
      seg_start = i
    } else {
      i = i + 1
    }
  }
  if seg_start < end {
    sb.write_string(src.slice(seg_start, end))
  }
}

///| Fast check whether `src[start..end]` contains `&` or `\r`.
fn needs_entity_decode(src : String, start : Int, end : Int) -> Bool {
  let mut i = start
  while i < end {
    let b = src.code_unit_at(i)
    if b == 0x26 || b == 0x0D {
      return true
    }
    i = i + 1
  }
  false
}
