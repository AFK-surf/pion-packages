  Err(HtmlError::new(HtmlErrorKind::Unimplemented, 0, "Node::select_first not implemented"))
}

///|
pub fn Node::select_compiled(self : Node, sel : Selector) -> Array[Node] {
  let _ = self
  let _ = sel
  []
}

///|
pub fn Node::matches(self : Node, sel : Selector) -> Bool {
  sel.matches(self)
}
