///| CSS Selectors parser and matcher (`Selector`, `select`, `select_first`, `matches`).

struct SelParser {
  src : String
  len : Int
  mut pos : Int
}

fn SelParser::new(src : String) -> SelParser {
  SelParser::{ src: src, len: src.length(), pos: 0 }
}

fn SelParser::skip_ws(self : SelParser) -> Bool {
  let start = self.pos
  while self.pos < self.len && is_html_ws(self.src.code_unit_at(self.pos)) {
    self.pos = self.pos + 1
  }
  self.pos > start
}

fn is_css_hex(b : Int) -> Int {
  if b >= 0x30 && b <= 0x39 {
    b - 0x30
  } else if b >= 0x61 && b <= 0x66 {
    b - 0x61 + 10
  } else if b >= 0x41 && b <= 0x46 {
    b - 0x41 + 10
  } else {
    -1
  }
}

fn is_css_ident_start(b : Int) -> Bool {
  is_ascii_alpha(b) || b == 0x5F || b >= 0x80
}

fn is_css_ident_char(b : Int) -> Bool {
  is_ascii_alnum(b) || b == 0x2D || b == 0x5F || b >= 0x80
}

///| Check whether the current position starts a valid CSS identifier (CSS Syntax 3 §4.3.9).
fn SelParser::starts_ident(self : SelParser) -> Bool {
  if self.pos >= self.len {
    return false
  }
  let b0 = self.src.code_unit_at(self.pos)
  if is_css_ident_start(b0) {
    return true
  }
  if b0 == 0x5C {
    return self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) != 0x0A
  }
  if b0 == 0x2D {
    if self.pos + 1 >= self.len {
      return false
    }
    let b1 = self.src.code_unit_at(self.pos + 1)
    if is_css_ident_start(b1) || b1 == 0x2D {
      return true
    }
    if b1 == 0x5C {
      return self.pos + 2 < self.len && self.src.code_unit_at(self.pos + 2) != 0x0A
    }
    return false
  }
  false
}

///| Consume a CSS escape sequence starting at `\` (`self.src[self.pos] == '\\'`).
fn SelParser::consume_escape(
  self : SelParser,
  sb : StringBuilder,
) -> Result[Unit, HtmlError] {
  let esc_pos = self.pos
  self.pos = self.pos + 1
  if self.pos >= self.len {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        esc_pos,
        "unterminated CSS escape",
      ),
    )
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 0x0A {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        esc_pos,
        "invalid newline in CSS escape",
      ),
    )
  }
  let h0 = is_css_hex(b)
  if h0 >= 0 {
    let mut cp = h0
    self.pos = self.pos + 1
    let mut digits = 1
    while digits < 6 && self.pos < self.len {
      let hd = is_css_hex(self.src.code_unit_at(self.pos))
      if hd < 0 {
        break
      }
      cp = (cp << 4) | hd
      self.pos = self.pos + 1
      digits = digits + 1
    }
    // Consume optional single whitespace (or \r\n) after hex escape
    if self.pos < self.len {
      let wb = self.src.code_unit_at(self.pos)
      if wb == 0x0D {
        self.pos = self.pos + 1
        if self.pos < self.len && self.src.code_unit_at(self.pos) == 0x0A {
          self.pos = self.pos + 1
        }
      } else if is_html_ws(wb) {
        self.pos = self.pos + 1
      }
    }
    if cp == 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
      write_utf8_cp(sb, 0xFFFD)
    } else {
      write_utf8_cp(sb, cp)
    }
    Ok(())
  } else {
    sb.write_byte(b.to_byte())
    self.pos = self.pos + 1
    Ok(())
  }
}

fn SelParser::parse_ident(self : SelParser) -> Result[String, HtmlError] {
  let start = self.pos
  if !self.starts_ident() {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        start,
        "expected CSS identifier",
      ),
    )
  }
  let sb = StringBuilder::with_capacity(16)
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 0x5C {
      match self.consume_escape(sb) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    } else if is_css_ident_char(b) {
      sb.write_byte(b.to_byte())
      self.pos = self.pos + 1
    } else {
      break
    }
  }
  let out = sb.to_string()
  if out.length() == 0 {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        start,
        "expected CSS identifier",
      ),
    )
  }
  Ok(out)
}

fn SelParser::parse_string(self : SelParser) -> Result[String, HtmlError] {
  let start = self.pos
  let q = self.src.code_unit_at(self.pos)
  self.pos = self.pos + 1
  let sb = StringBuilder::with_capacity(16)
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == q {
      self.pos = self.pos + 1
      return Ok(sb.to_string())
    }
    if b == 0x5C {
      if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 0x0A {
        self.pos = self.pos + 2
      } else {
        match self.consume_escape(sb) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
    } else {
      sb.write_byte(b.to_byte())
      self.pos = self.pos + 1
    }
  }
  Err(
    HtmlError::new(
      HtmlErrorKind::InvalidSelector,
      start,
      "unterminated string in attribute selector",
    ),
  )
}

///| WHATWG HTML §4.15.2 attributes whose values match ASCII case-insensitively in HTML documents.
fn is_html_ci_attr(name : String) -> Bool {
  match name {
    "accept" | "accept-charset" | "align" | "alink" | "axis" | "bgcolor" | "charset" | "checked" | "clear" | "codetype" | "color" | "compact" | "declare" | "defer" | "dir" | "direction" | "disabled" | "enctype" | "face" | "frame" | "hreflang" | "http-equiv" | "lang" | "language" | "link" | "media" | "method" | "multiple" | "nohref" | "noresize" | "noshade" | "nowrap" | "readonly" | "rel" | "rev" | "rules" | "scope" | "scrolling" | "selected" | "shape" | "target" | "text" | "type" | "valign" | "valuetype" | "vlink" =>
    true
    _ => false
  }
}

fn SelParser::parse_attr_matcher(
  self : SelParser,
) -> Result[AttrMatcher, HtmlError] {
  let open_pos = self.pos
  self.pos = self.pos + 1 // skip '['
  let _ = self.skip_ws()
  let raw_name = match self.parse_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let name = to_ascii_lower(raw_name)
  let _ = self.skip_ws()
  if self.pos >= self.len {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        open_pos,
        "unclosed '[' in attribute selector",
      ),
    )
  }
  if self.src.code_unit_at(self.pos) == 0x5D {
    self.pos = self.pos + 1
    return Ok(
      AttrMatcher::{
        name: name,
        op: AttrOp::Exists,
        value: "",
        case_insensitive: false,
      },
    )
  }

  let b0 = self.src.code_unit_at(self.pos)
  let op = if b0 == 0x3D {
    self.pos = self.pos + 1
    AttrOp::Exact
  } else if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 0x3D {
    self.pos = self.pos + 2
    if b0 == 0x7E {
      AttrOp::Includes
    } else if b0 == 0x7C {
      AttrOp::DashMatch
    } else if b0 == 0x5E {
      AttrOp::Prefix
    } else if b0 == 0x24 {
      AttrOp::Suffix
    } else if b0 == 0x2A {
      AttrOp::Substring
    } else {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          self.pos - 2,
          "invalid attribute operator",
        ),
      )
    }
  } else {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        self.pos,
        "expected attribute operator or ']'",
      ),
    )
  }

  let _ = self.skip_ws()
  if self.pos >= self.len {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        open_pos,
        "expected attribute value",
      ),
    )
  }
  let v0 = self.src.code_unit_at(self.pos)
  let attr_val = if v0 == 0x22 || v0 == 0x27 {
    match self.parse_string() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
  } else {
    let vstart = self.pos
    let vsb = StringBuilder::with_capacity(16)
    while self.pos < self.len {
      let vb = self.src.code_unit_at(self.pos)
      if vb == 0x5C {
        match self.consume_escape(vsb) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      } else if is_css_ident_char(vb) {
        vsb.write_byte(vb.to_byte())
        self.pos = self.pos + 1
      } else {
        break
      }
    }
    let s = vsb.to_string()
    if s.length() == 0 {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          vstart,
          "expected attribute value",
        ),
      )
    }
    s
  }

  let _ = self.skip_ws()
  let mut ci = is_html_ci_attr(name)
  if self.pos < self.len {
    let f = self.src.code_unit_at(self.pos)
    if f == 0x69 || f == 0x49 {
      ci = true
      self.pos = self.pos + 1
      let _ = self.skip_ws()
    } else if f == 0x73 || f == 0x53 {
      ci = false
      self.pos = self.pos + 1
      let _ = self.skip_ws()
    }
  }

  if self.pos >= self.len || self.src.code_unit_at(self.pos) != 0x5D {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        open_pos,
        "expected ']' to close attribute selector",
      ),
    )
  }
  self.pos = self.pos + 1
  Ok(AttrMatcher::{ name: name, op: op, value: attr_val, case_insensitive: ci })
}

///| Parse `An+B` / `odd` / `even` inside `:nth-*`.
fn parse_nth_expr(raw : String, offset : Int) -> Result[(Int, Int), HtmlError] {
  let sb = StringBuilder::with_capacity(raw.length())
  let mut i = 0
  while i < raw.length() {
    let b = raw.code_unit_at(i)
    if !is_html_ws(b) {
      sb.write_byte(ascii_lower_byte(b).to_byte())
    }
    i = i + 1
  }
  let s = sb.to_string()
  if s.length() == 0 {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        offset,
        "empty nth expression",
      ),
    )
  }
  if s == "odd" {
    return Ok((2, 1))
  }
  if s == "even" {
    return Ok((2, 0))
  }
  let mut n_idx = -1
  i = 0
  while i < s.length() {
    if s.code_unit_at(i) == 0x6E {
      n_idx = i
      break
    }
    i = i + 1
  }
  if n_idx < 0 {
    let b_val = match parse_signed_int(s, 0, s.length()) {
      Some(v) => v
      None =>
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          offset,
          "invalid nth integer: " + s,
        ),
      )
    }
    return Ok((0, b_val))
  }
  let a_val = if n_idx == 0 {
    1
  } else if n_idx == 1 && s.code_unit_at(0) == 0x2B {
    1
  } else if n_idx == 1 && s.code_unit_at(0) == 0x2D {
    -1
  } else {
    match parse_signed_int(s, 0, n_idx) {
      Some(v) => v
      None =>
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          offset,
          "invalid nth A coefficient: " + s,
        ),
      )
    }
  }
  let b_val = if n_idx + 1 >= s.length() {
    0
  } else {
    let first_b = s.code_unit_at(n_idx + 1)
    if first_b != 0x2B && first_b != 0x2D {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          offset,
          "expected '+' or '-' after 'n' in nth expression",
        ),
      )
    }
    match parse_signed_int(s, n_idx + 1, s.length()) {
      Some(v) => v
      None =>
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          offset,
          "invalid nth B offset: " + s,
        ),
      )
    }
  }
  Ok((a_val, b_val))
}

fn parse_signed_int(s : String, start : Int, end : Int) -> Option[Int] {
  if start >= end {
    return None
  }
  let mut i = start
  let mut neg = false
  let b0 = s.code_unit_at(i)
  if b0 == 0x2D {
    neg = true
    i = i + 1
  } else if b0 == 0x2B {
    i = i + 1
  }
  if i >= end {
    return None
  }
  let mut acc = 0
  while i < end {
    let c = s.code_unit_at(i)
    if c < 0x30 || c > 0x39 {
      return None
    }
    acc = acc * 10 + (c - 0x30)
    i = i + 1
  }
  if neg {
    Some(-acc)
  } else {
    Some(acc)
  }
}

fn SelParser::parse_nth_arg(
  self : SelParser,
  p_pos : Int,
) -> Result[(Int, Int), HtmlError] {
  if self.pos >= self.len || self.src.code_unit_at(self.pos) != 0x28 {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        p_pos,
        "expected '(' after nth pseudo-class",
      ),
    )
  }
  self.pos = self.pos + 1
  let astart = self.pos
  while self.pos < self.len && self.src.code_unit_at(self.pos) != 0x29 {
    self.pos = self.pos + 1
  }
  if self.pos >= self.len {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        p_pos,
        "unclosed '(' in nth pseudo-class",
      ),
    )
  }
  let expr = self.src.slice(astart, self.pos)
  self.pos = self.pos + 1
  parse_nth_expr(expr, astart)
}

fn SelParser::parse_relative_selector_list(
  self : SelParser,
  not_depth : Int,
) -> Result[Array[RelativeSelector], HtmlError] {
  let items : Array[RelativeSelector] = []
  let _ = self.skip_ws()
  if self.pos >= self.len || self.src.code_unit_at(self.pos) == 0x29 {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        self.pos,
        "empty :has() selector list",
      ),
    )
  }
  let mut parsing = true
  while parsing {
    let _ = self.skip_ws()
    let leading = if self.pos < self.len {
      let b = self.src.code_unit_at(self.pos)
      if b == 0x3E {
        self.pos = self.pos + 1
        let _ = self.skip_ws()
        Combinator::Child
      } else if b == 0x2B {
        self.pos = self.pos + 1
        let _ = self.skip_ws()
        Combinator::NextSibling
      } else if b == 0x7E {
        self.pos = self.pos + 1
        let _ = self.skip_ws()
        Combinator::SubsequentSibling
      } else {
        Combinator::Descendant
      }
    } else {
      Combinator::Descendant
    }
    let cx = match self.parse_complex(true, not_depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    items.push(RelativeSelector::{ leading: leading, complex: cx })
    let _ = self.skip_ws()
    if self.pos < self.len && self.src.code_unit_at(self.pos) == 0x2C {
      self.pos = self.pos + 1
      let _ = self.skip_ws()
      if self.pos >= self.len || self.src.code_unit_at(self.pos) == 0x29 {
        return Err(
          HtmlError::new(
            HtmlErrorKind::InvalidSelector,
            self.pos,
            "trailing comma in :has()",
          ),
        )
      }
    } else {
      parsing = false
    }
  }
  Ok(items)
}

fn SelParser::parse_pseudo(
  self : SelParser,
  not_depth : Int,
) -> Result[PseudoClass, HtmlError] {
  let p_pos = self.pos
  self.pos = self.pos + 1 // skip ':'
  if self.pos < self.len && self.src.code_unit_at(self.pos) == 0x3A {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        p_pos,
        "pseudo-elements are not supported",
      ),
    )
  }
  let raw_name = match self.parse_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let name = to_ascii_lower(raw_name)
  if name == "first-child" {
    return Ok(PseudoClass::FirstChild)
  }
  if name == "last-child" {
    return Ok(PseudoClass::LastChild)
  }
  if name == "only-child" {
    return Ok(PseudoClass::OnlyChild)
  }
  if name == "only-of-type" {
    return Ok(PseudoClass::OnlyOfType)
  }
  if name == "empty" {
    return Ok(PseudoClass::Empty)
  }
  if name == "root" {
    return Ok(PseudoClass::Root)
  }
  if name == "scope" {
    return Ok(PseudoClass::Scope)
  }
  if name == "first-of-type" {
    return Ok(PseudoClass::FirstOfType)
  }
  if name == "last-of-type" {
    return Ok(PseudoClass::LastOfType)
  }
  if name == "nth-child" {
    return match self.parse_nth_arg(p_pos) {
      Ok((a, b)) => Ok(PseudoClass::NthChild(a, b))
      Err(e) => Err(e)
    }
  }
  if name == "nth-last-child" {
    return match self.parse_nth_arg(p_pos) {
      Ok((a, b)) => Ok(PseudoClass::NthLastChild(a, b))
      Err(e) => Err(e)
    }
  }
  if name == "nth-of-type" {
    return match self.parse_nth_arg(p_pos) {
      Ok((a, b)) => Ok(PseudoClass::NthOfType(a, b))
      Err(e) => Err(e)
    }
  }
  if name == "nth-last-of-type" {
    return match self.parse_nth_arg(p_pos) {
      Ok((a, b)) => Ok(PseudoClass::NthLastOfType(a, b))
      Err(e) => Err(e)
    }
  }
  if name == "not" || name == "is" || name == "where" {
    if not_depth >= 8 {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          p_pos,
          "functional pseudo-class nesting too deep",
        ),
      )
    }
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 0x28 {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          p_pos,
          "expected '(' after :" + name,
        ),
      )
    }
    self.pos = self.pos + 1
    let inner = match self.parse_selector_list(true, not_depth + 1) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 0x29 {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          p_pos,
          "unclosed '(' in :" + name + "()",
        ),
      )
    }
    self.pos = self.pos + 1
    if name == "not" {
      return Ok(PseudoClass::Not(inner))
    } else {
      return Ok(PseudoClass::Is(inner))
    }
  }
  if name == "has" {
    if not_depth >= 8 {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          p_pos,
          ":has() nesting too deep",
        ),
      )
    }
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 0x28 {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          p_pos,
          "expected '(' after :has",
        ),
      )
    }
    self.pos = self.pos + 1
    let inner = match self.parse_relative_selector_list(not_depth + 1) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 0x29 {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          p_pos,
          "unclosed '(' in :has()",
        ),
      )
    }
    self.pos = self.pos + 1
    return Ok(PseudoClass::Has(inner))
  }
  Err(
    HtmlError::new(
      HtmlErrorKind::InvalidSelector,
      p_pos,
      "unsupported pseudo-class :" + name,
    ),
  )
}

fn SelParser::parse_compound(
  self : SelParser,
  not_depth : Int,
) -> Result[CompoundSelector, HtmlError] {
  let start = self.pos
  let mut tag : Option[String] = None
  let mut id : Option[String] = None
  let classes : Array[String] = []
  let attrs : Array[AttrMatcher] = []
  let pseudos : Array[PseudoClass] = []
  let mut parsed_any = false
  let mut never_matches = false

  if self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 0x2A {
      // '*' or '*|tag' or '*|*'
      self.pos = self.pos + 1
      if self.pos < self.len && self.src.code_unit_at(self.pos) == 0x7C {
        self.pos = self.pos + 1
        if self.pos < self.len && self.src.code_unit_at(self.pos) == 0x2A {
          self.pos = self.pos + 1
          parsed_any = true
        } else if self.starts_ident() {
          match self.parse_ident() {
            Ok(t) => {
              tag = Some(to_ascii_lower(t))
              parsed_any = true
            }
            Err(e) => return Err(e)
          }
        } else {
          return Err(
            HtmlError::new(
              HtmlErrorKind::InvalidSelector,
              self.pos,
              "expected tag name or '*' after '*|'",
            ),
          )
        }
      } else {
        parsed_any = true
      }
    } else if b == 0x7C {
      // '|tag' or '|*' (empty namespace: never matches HTML elements)
      self.pos = self.pos + 1
      never_matches = true
      if self.pos < self.len && self.src.code_unit_at(self.pos) == 0x2A {
        self.pos = self.pos + 1
        parsed_any = true
      } else if self.starts_ident() {
        match self.parse_ident() {
          Ok(t) => {
            tag = Some(to_ascii_lower(t))
            parsed_any = true
          }
          Err(e) => return Err(e)
        }
      } else {
        return Err(
          HtmlError::new(
            HtmlErrorKind::InvalidSelector,
            self.pos,
            "expected tag name or '*' after '|'",
          ),
        )
      }
    } else if self.starts_ident() {
      match self.parse_ident() {
        Ok(t) => {
          if self.pos < self.len && self.src.code_unit_at(self.pos) == 0x7C {
            return Err(
              HtmlError::new(
                HtmlErrorKind::InvalidSelector,
                self.pos,
                "undeclared namespace prefix",
              ),
            )
          }
          tag = Some(to_ascii_lower(t))
          parsed_any = true
        }
        Err(e) => return Err(e)
      }
    }
  }

  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 0x23 {
      // '#'
      self.pos = self.pos + 1
      match self.parse_ident() {
        Ok(v) => {
          id = Some(v)
          parsed_any = true
        }
        Err(e) => return Err(e)
      }
    } else if b == 0x2E {
      // '.'
      self.pos = self.pos + 1
      match self.parse_ident() {
        Ok(c) => {
          classes.push(c)
          parsed_any = true
        }
        Err(e) => return Err(e)
      }
    } else if b == 0x5B {
      // '['
      match self.parse_attr_matcher() {
        Ok(am) => {
          attrs.push(am)
          parsed_any = true
        }
        Err(e) => return Err(e)
      }
    } else if b == 0x3A {
      // ':'
      match self.parse_pseudo(not_depth) {
        Ok(pc) => {
          pseudos.push(pc)
          parsed_any = true
        }
        Err(e) => return Err(e)
      }
    } else {
      break
    }
  }

  if !parsed_any {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        start,
        "expected compound selector",
      ),
    )
  }

  Ok(
    CompoundSelector::{
      tag: tag,
      id: id,
      classes: classes,
      attrs: attrs,
      pseudos: pseudos,
      never_matches: never_matches,
    },
  )
}

fn SelParser::parse_complex(
  self : SelParser,
  stop_on_rparen : Bool,
  not_depth : Int,
) -> Result[ComplexSelector, HtmlError] {
  let _ = self.skip_ws()
  let compounds : Array[CompoundSelector] = []
  let combinators : Array[Combinator] = []

  let first = match self.parse_compound(not_depth) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  compounds.push(first)

  while self.pos < self.len {
    let had_ws = self.skip_ws()
    if self.pos >= self.len {
      break
    }
    let b = self.src.code_unit_at(self.pos)
    if b == 0x2C || (stop_on_rparen && b == 0x29) {
      break
    }
    let comb = if b == 0x3E {
      self.pos = self.pos + 1
      let _ = self.skip_ws()
      Combinator::Child
    } else if b == 0x2B {
      self.pos = self.pos + 1
      let _ = self.skip_ws()
      Combinator::NextSibling
    } else if b == 0x7E {
      self.pos = self.pos + 1
      let _ = self.skip_ws()
      Combinator::SubsequentSibling
    } else if had_ws {
      Combinator::Descendant
    } else {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          self.pos,
          "unexpected character in selector",
        ),
      )
    }

    let next_c = match self.parse_compound(not_depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    combinators.push(comb)
    compounds.push(next_c)
  }

  Ok(ComplexSelector::{ compounds: compounds, combinators: combinators })
}

fn SelParser::parse_selector_list(
  self : SelParser,
  stop_on_rparen : Bool,
  not_depth : Int,
) -> Result[Array[ComplexSelector], HtmlError] {
  let items : Array[ComplexSelector] = []
  let _ = self.skip_ws()
  if self.pos >= self.len ||
  (stop_on_rparen && self.src.code_unit_at(self.pos) == 0x29) {
    return Err(
      HtmlError::new(HtmlErrorKind::InvalidSelector, self.pos, "empty selector"),
    )
  }
  let mut parsing = true
  while parsing {
    let cx = match self.parse_complex(stop_on_rparen, not_depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    items.push(cx)
    let _ = self.skip_ws()
    if self.pos < self.len && self.src.code_unit_at(self.pos) == 0x2C {
      self.pos = self.pos + 1
      let _ = self.skip_ws()
      if self.pos >= self.len ||
      (stop_on_rparen && self.src.code_unit_at(self.pos) == 0x29) {
        return Err(
          HtmlError::new(
            HtmlErrorKind::InvalidSelector,
            self.pos,
            "trailing comma in selector list",
          ),
        )
      }
    } else {
      parsing = false
    }
  }
  Ok(items)
}

///| Parse a CSS selector string into a compiled `Selector`.
pub fn Selector::parse(input : String) -> Result[Selector, HtmlError] {
  let p = SelParser::new(input)
  let items = match p.parse_selector_list(false, 0) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let _ = p.skip_ws()
  if p.pos < p.len {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        p.pos,
        "unexpected trailing token in selector",
      ),
    )
  }
  Ok(Selector::{ items: items })
}

// ===========================================================================
// Precomputed O(1) :nth-child / :nth-last-child cache for select_descendants
// ===========================================================================

struct NthCache {
  mut enabled : Bool
  mut child_idx : Array[Int]
  mut parent_cnt : Array[Int]
  st_idx : Array[Int]
  st_nid : Array[Int]
  st_kind : Array[Int]
}

fn empty_nth_cache() -> NthCache {
  NthCache::{
    enabled: false,
    child_idx: [],
    parent_cnt: [],
    st_idx: [],
    st_nid: [],
    st_kind: [],
  }
}

///| Lazily populate O(1) 1-based element child index and parent element child count.
fn populate_nth_cache(doc : Document, cache : NthCache) -> Unit {
  if cache.enabled {
    return ()
  }
  let n = doc.nodes.length()
  let child_idx : Array[Int] = []
  let parent_cnt : Array[Int] = []
  let mut i = 0
  while i < n {
    child_idx.push(0)
    parent_cnt.push(0)
    i = i + 1
  }
  let nodes = doc.nodes
  i = 0
  while i < n {
    let fc = nodes[i].first_child
    let k = nodes[i].kind
    if fc >= 0 && (k == kind_element || k == kind_document) {
      let mut cnt = 0
      let mut c = fc
      while c >= 0 {
        if nodes[c].kind == kind_element {
          cnt = cnt + 1
          child_idx[c] = cnt
        }
        c = nodes[c].next_sibling
      }
      parent_cnt[i] = cnt
    }
    i = i + 1
  }
  cache.child_idx = child_idx
  cache.parent_cnt = parent_cnt
  cache.enabled = true
}

// ===========================================================================
// Zero-copy span matching helpers (direct node-id indexing, zero NodeData copies)
// ===========================================================================

fn span_eq_opt_ci(
  buf : String,
  start : Int,
  end : Int,
  target : String,
  ci : Bool,
) -> Bool {
  let n = end - start
  if n != target.length() {
    return false
  }
  if !ci {
    let mut i = 0
    while i < n {
      if buf.code_unit_at(start + i) != target.code_unit_at(i) {
        return false
      }
      i = i + 1
    }
    return true
  }
  let mut i = 0
  while i < n {
    if ascii_lower_byte(buf.code_unit_at(start + i)) !=
    ascii_lower_byte(target.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

fn node_attr_span_range(
  doc : Document,
  attrs_start : Int,
  attrs_end : Int,
  lower_name : String,
) -> (Bool, Int, Int) {
  let mut i = attrs_start
  let attrs = doc.attrs
  let src = doc.src
  let strings = doc.strings
  let lname_len = lower_name.length()
  while i < attrs_end {
    let ad = attrs[i]
    let ns = ad.name_start
    let ne = ad.name_end
    let matched = if ns >= 0 {
      (ne - ns) == lname_len && slice_eq_exact(src, ns, ne, lower_name)
    } else {
      strings[-(ns + 1)] == lower_name
    }
    if matched {
      return (true, ad.val_start, ad.val_end)
    }
    i = i + 1
  }
  (false, 0, 0)
}

fn node_has_class_range(
  doc : Document,
  attrs_start : Int,
  attrs_end : Int,
  class_name : String,
) -> Bool {
  if class_name.length() == 0 {
    return false
  }
  let (found, vs, ve) = node_attr_span_range(doc, attrs_start, attrs_end, "class")
  if !found {
    return false
  }
  let (buf, start, end) = if vs >= 0 {
    (doc.src, vs, ve)
  } else {
    let s = doc.strings[-(vs + 1)]
    (s, 0, s.length())
  }
  let clen = class_name.length()
  let mut i = start
  while i < end {
    while i < end && is_html_ws(buf.code_unit_at(i)) {
      i = i + 1
    }
    let s = i
    while i < end && !is_html_ws(buf.code_unit_at(i)) {
      i = i + 1
    }
    if (i - s) == clen && slice_eq_exact(buf, s, i, class_name) {
      return true
    }
  }
  false
}

fn match_attr_range(
  doc : Document,
  attrs_start : Int,
  attrs_end : Int,
  am : AttrMatcher,
) -> Bool {
  let (found, vs, ve) = node_attr_span_range(doc, attrs_start, attrs_end, am.name)
  if !found {
    return false
  }
  match am.op {
    AttrOp::Exists => return true
    _ => ()
  }
  let (buf, start, end) = if vs >= 0 {
    (doc.src, vs, ve)
  } else {
    let s = doc.strings[-(vs + 1)]
    (s, 0, s.length())
  }
  let rlen = end - start
  let vlen = am.value.length()
  match am.op {
    AttrOp::Exists => true
    AttrOp::Exact => span_eq_opt_ci(buf, start, end, am.value, am.case_insensitive)
    AttrOp::Includes => {
      if vlen == 0 {
        return false
      }
      let mut i = start
      while i < end {
        while i < end && is_html_ws(buf.code_unit_at(i)) {
          i = i + 1
        }
        let s = i
        while i < end && !is_html_ws(buf.code_unit_at(i)) {
          i = i + 1
        }
        if (i - s) == vlen && span_eq_opt_ci(buf, s, i, am.value, am.case_insensitive) {
          return true
        }
      }
      false
    }
    AttrOp::DashMatch => {
      if rlen == vlen {
        span_eq_opt_ci(buf, start, end, am.value, am.case_insensitive)
      } else if rlen > vlen && buf.code_unit_at(start + vlen) == 0x2D {
        span_eq_opt_ci(buf, start, start + vlen, am.value, am.case_insensitive)
      } else {
        false
      }
    }
    AttrOp::Prefix => {
      if vlen == 0 || rlen < vlen {
        return false
      }
      span_eq_opt_ci(buf, start, start + vlen, am.value, am.case_insensitive)
    }
    AttrOp::Suffix => {
      if vlen == 0 || rlen < vlen {
        return false
      }
      span_eq_opt_ci(buf, end - vlen, end, am.value, am.case_insensitive)
    }
    AttrOp::Substring => {
      if vlen == 0 || rlen < vlen {
        return false
      }
      let mut i = 0
      while i <= rlen - vlen {
        let mut j = 0
        while j < vlen {
          let cb = if am.case_insensitive {
            ascii_lower_byte(buf.code_unit_at(start + i + j))
          } else {
            buf.code_unit_at(start + i + j)
          }
          let tb = if am.case_insensitive {
            ascii_lower_byte(am.value.code_unit_at(j))
          } else {
            am.value.code_unit_at(j)
          }
          if cb != tb {
            break
          }
          j = j + 1
        }
        if j == vlen {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

fn prev_elem_sibling(doc : Document, nid : Int) -> Int {
  let nodes = doc.nodes
  let mut cur = nodes[nid].prev_sibling
  while cur >= 0 {
    if nodes[cur].kind == kind_element {
      return cur
    }
    cur = nodes[cur].prev_sibling
  }
  -1
}

fn next_elem_sibling(doc : Document, nid : Int) -> Int {
  let nodes = doc.nodes
  let mut cur = nodes[nid].next_sibling
  while cur >= 0 {
    if nodes[cur].kind == kind_element {
      return cur
    }
    cur = nodes[cur].next_sibling
  }
  -1
}

fn elem_child_index_1based(doc : Document, nid : Int, cache : NthCache) -> Int {
  if cache.enabled {
    return cache.child_idx[nid]
  }
  let nodes = doc.nodes
  let mut idx = 1
  let mut cur = nodes[nid].prev_sibling
  while cur >= 0 {
    if nodes[cur].kind == kind_element {
      idx = idx + 1
      if idx > 32 {
        populate_nth_cache(doc, cache)
        return cache.child_idx[nid]
      }
    }
    cur = nodes[cur].prev_sibling
  }
  idx
}

fn elem_last_child_index_1based(doc : Document, nid : Int, cache : NthCache) -> Int {
  if cache.enabled {
    let pid = doc.nodes[nid].parent
    if pid >= 0 {
      return cache.parent_cnt[pid] - cache.child_idx[nid] + 1
    }
  }
  let nodes = doc.nodes
  let mut idx = 1
  let mut cur = nodes[nid].next_sibling
  while cur >= 0 {
    if nodes[cur].kind == kind_element {
      idx = idx + 1
      if idx > 32 {
        populate_nth_cache(doc, cache)
        let pid = nodes[nid].parent
        if pid >= 0 {
          return cache.parent_cnt[pid] - cache.child_idx[nid] + 1
        }
      }
    }
    cur = nodes[cur].next_sibling
  }
  idx
}

fn node_tag_eq_id(doc : Document, a : Int, b : Int) -> Bool {
  let nodes = doc.nodes
  let ads = nodes[a].data_start
  let bds = nodes[b].data_start
  if ads >= 0 && bds >= 0 {
    let la = nodes[a].data_end - ads
    if la != nodes[b].data_end - bds {
      return false
    }
    let src = doc.src
    let mut i = 0
    while i < la {
      if src.code_unit_at(ads + i) != src.code_unit_at(bds + i) {
        return false
      }
      i = i + 1
    }
    true
  } else {
    doc_resolve_span(doc, ads, nodes[a].data_end) ==
    doc_resolve_span(doc, bds, nodes[b].data_end)
  }
}

fn elem_of_type_index_1based(doc : Document, nid : Int) -> Int {
  let nodes = doc.nodes
  let mut idx = 1
  let mut cur = nodes[nid].prev_sibling
  while cur >= 0 {
    if nodes[cur].kind == kind_element && node_tag_eq_id(doc, cur, nid) {
      idx = idx + 1
    }
    cur = nodes[cur].prev_sibling
  }
  idx
}

fn elem_last_of_type_index_1based(doc : Document, nid : Int) -> Int {
  let nodes = doc.nodes
  let mut idx = 1
  let mut cur = nodes[nid].next_sibling
  while cur >= 0 {
    if nodes[cur].kind == kind_element && node_tag_eq_id(doc, cur, nid) {
      idx = idx + 1
    }
    cur = nodes[cur].next_sibling
  }
  idx
}

fn match_nth(a : Int, b : Int, idx : Int) -> Bool {
  if a == 0 {
    return idx == b
  }
  let diff = idx - b
  if a > 0 {
    diff >= 0 && diff % a == 0
  } else {
    diff <= 0 && (-diff) % (-a) == 0
  }
}

fn match_has_rel(
  doc : Document,
  anchor_id : Int,
  rel : RelativeSelector,
  scope_id : Int,
  cache : NthCache,
) -> Bool {
  let nodes = doc.nodes
  match rel.leading {
    Combinator::Child => {
      if rel.complex.compounds.length() == 1 {
        let comp = rel.complex.compounds[0]
        let mut c = nodes[anchor_id].first_child
        while c >= 0 {
          if nodes[c].kind == kind_element &&
          match_compound_id(doc, c, comp, scope_id, cache, false) {
            return true
          }
          c = nodes[c].next_sibling
        }
        return false
      }
      let stack : Array[Int] = []
      let mut cur = nodes[anchor_id].first_child
      while cur >= 0 || stack.length() > 0 {
        while cur >= 0 {
          if nodes[cur].kind == kind_element &&
          match_complex_anchored(doc, cur, rel.complex, anchor_id, true, scope_id, cache, false) {
            return true
          }
          let fc = nodes[cur].first_child
          let ns = nodes[cur].next_sibling
          if fc >= 0 {
            if ns >= 0 {
              stack.push(ns)
            }
            cur = fc
          } else {
            cur = ns
          }
        }
        if stack.length() > 0 {
          match stack.pop() {
            Some(nxt) => cur = nxt
            None => ()
          }
        }
      }
      false
    }
    Combinator::Descendant => {
      let stack : Array[Int] = []
      let mut cur = nodes[anchor_id].first_child
      while cur >= 0 || stack.length() > 0 {
        while cur >= 0 {
          if nodes[cur].kind == kind_element &&
          match_complex_anchored(doc, cur, rel.complex, anchor_id, false, scope_id, cache, false) {
            return true
          }
          let fc = nodes[cur].first_child
          let ns = nodes[cur].next_sibling
          if fc >= 0 {
            if ns >= 0 {
              stack.push(ns)
            }
            cur = fc
          } else {
            cur = ns
          }
        }
        if stack.length() > 0 {
          match stack.pop() {
            Some(nxt) => cur = nxt
            None => ()
          }
        }
      }
      false
    }
    Combinator::NextSibling => {
      let sid = next_elem_sibling(doc, anchor_id)
      if sid < 0 {
        return false
      }
      match_complex_iter(doc, sid, rel.complex, scope_id, cache)
    }
    Combinator::SubsequentSibling => {
      let mut sid = next_elem_sibling(doc, anchor_id)
      while sid >= 0 {
        if match_complex_iter(doc, sid, rel.complex, scope_id, cache) {
          return true
        }
        sid = next_elem_sibling(doc, sid)
      }
      false
    }
  }
}

fn match_pseudo_id(
  doc : Document,
  nid : Int,
  pc : PseudoClass,
  scope_id : Int,
  cache : NthCache,
) -> Bool {
  let nodes = doc.nodes
  match pc {
    PseudoClass::FirstChild => prev_elem_sibling(doc, nid) < 0
    PseudoClass::LastChild => next_elem_sibling(doc, nid) < 0
    PseudoClass::OnlyChild =>
    prev_elem_sibling(doc, nid) < 0 && next_elem_sibling(doc, nid) < 0
    PseudoClass::NthChild(a, b) =>
    match_nth(a, b, elem_child_index_1based(doc, nid, cache))
    PseudoClass::NthLastChild(a, b) =>
    match_nth(a, b, elem_last_child_index_1based(doc, nid, cache))
    PseudoClass::NthOfType(a, b) =>
    match_nth(a, b, elem_of_type_index_1based(doc, nid))
    PseudoClass::NthLastOfType(a, b) =>
    match_nth(a, b, elem_last_of_type_index_1based(doc, nid))
    PseudoClass::OnlyOfType => {
      let mut cur = nodes[nid].prev_sibling
      while cur >= 0 {
        if nodes[cur].kind == kind_element && node_tag_eq_id(doc, cur, nid) {
          return false
        }
        cur = nodes[cur].prev_sibling
      }
      cur = nodes[nid].next_sibling
      while cur >= 0 {
        if nodes[cur].kind == kind_element && node_tag_eq_id(doc, cur, nid) {
          return false
        }
        cur = nodes[cur].next_sibling
      }
      true
    }
    PseudoClass::Empty => {
      let mut c = nodes[nid].first_child
      while c >= 0 {
        let ck = nodes[c].kind
        if ck == kind_element {
          return false
        }
        if ck == kind_text {
          let cds = nodes[c].data_start
          let tlen = if cds >= 0 {
            nodes[c].data_end - cds
          } else {
            doc.strings[-(cds + 1)].length()
          }
          if tlen > 0 {
            return false
          }
        }
        c = nodes[c].next_sibling
      }
      true
    }
    PseudoClass::Root => nodes[nid].parent == 0 && nodes[nid].kind == kind_element
    PseudoClass::Scope => {
      if scope_id == 0 {
        nodes[nid].parent == 0 && nodes[nid].kind == kind_element
      } else {
        nid == scope_id
      }
    }
    PseudoClass::FirstOfType => {
      let mut cur = nodes[nid].prev_sibling
      while cur >= 0 {
        if nodes[cur].kind == kind_element && node_tag_eq_id(doc, cur, nid) {
          return false
        }
        cur = nodes[cur].prev_sibling
      }
      true
    }
    PseudoClass::LastOfType => {
      let mut cur = nodes[nid].next_sibling
      while cur >= 0 {
        if nodes[cur].kind == kind_element && node_tag_eq_id(doc, cur, nid) {
          return false
        }
        cur = nodes[cur].next_sibling
      }
      true
    }
    PseudoClass::Not(list) => {
      let mut i = 0
      while i < list.length() {
        if match_complex_iter(doc, nid, list[i], scope_id, cache) {
          return false
        }
        i = i + 1
      }
      true
    }
    PseudoClass::Is(list) => {
      let mut i = 0
      while i < list.length() {
        if match_complex_iter(doc, nid, list[i], scope_id, cache) {
          return true
        }
        i = i + 1
      }
      false
    }
    PseudoClass::Has(rlist) => {
      let mut i = 0
      while i < rlist.length() {
        if match_has_rel(doc, nid, rlist[i], scope_id, cache) {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

fn match_tag_id(doc : Document, nid : Int, t : String) -> Bool {
  let ds = doc.nodes[nid].data_start
  if ds >= 0 {
    let de = doc.nodes[nid].data_end
    (de - ds) == t.length() && slice_eq_exact(doc.src, ds, de, t)
  } else {
    doc.strings[-(ds + 1)] == t
  }
}

fn match_compound_id(
  doc : Document,
  nid : Int,
  comp : CompoundSelector,
  scope_id : Int,
  cache : NthCache,
  skip_tag : Bool,
) -> Bool {
  let nd = doc.nodes[nid]
  if comp.never_matches || nd.kind != kind_element {
    return false
  }
  if !skip_tag {
    match comp.tag {
      Some(t) => {
        let ok = if nd.data_start >= 0 {
          (nd.data_end - nd.data_start) == t.length() &&
          slice_eq_exact(doc.src, nd.data_start, nd.data_end, t)
        } else {
          doc.strings[-(nd.data_start + 1)] == t
        }
        if !ok {
          return false
        }
      }
      None => ()
    }
  }
  let astart = nd.attrs_start
  let aend = nd.attrs_end
  match comp.id {
    Some(expected_id) => {
      let (found, vs, ve) = node_attr_span_range(doc, astart, aend, "id")
      if !found {
        return false
      }
      let ok = if vs >= 0 {
        (ve - vs) == expected_id.length() && slice_eq_exact(doc.src, vs, ve, expected_id)
      } else {
        doc.strings[-(vs + 1)] == expected_id
      }
      if !ok {
        return false
      }
    }
    None => ()
  }
  let mut i = 0
  let clen = comp.classes.length()
  while i < clen {
    if !node_has_class_range(doc, astart, aend, comp.classes[i]) {
      return false
    }
    i = i + 1
  }
  i = 0
  let alen = comp.attrs.length()
  while i < alen {
    if !match_attr_range(doc, astart, aend, comp.attrs[i]) {
      return false
    }
    i = i + 1
  }
  i = 0
  let plen = comp.pseudos.length()
  while i < plen {
    if !match_pseudo_id(doc, nid, comp.pseudos[i], scope_id, cache) {
      return false
    }
    i = i + 1
  }
  true
}

///| Check whether `nid` is a strict descendant of `anchor_id`.
fn is_strict_descendant(doc : Document, nid : Int, anchor_id : Int) -> Bool {
  let nodes = doc.nodes
  let mut p = nodes[nid].parent
  while p >= 0 {
    if p == anchor_id {
      return true
    }
    p = nodes[p].parent
  }
  false
}

///| 100% iterative right-to-left complex selector matcher with Servo `NotMatchedGlobally`
///| and sibling-exhaustion cut-offs (O(N * compounds), zero recursion, 0 Wasm32 stack overflow).
fn match_complex_anchored(
  doc : Document,
  start_nid : Int,
  cx : ComplexSelector,
  anchor_id : Int,
  anchor_direct : Bool,
  scope_id : Int,
  cache : NthCache,
  skip_first_tag : Bool,
) -> Bool {
  let last = cx.compounds.length() - 1
  if last < 0 {
    return false
  }
  if !match_compound_id(doc, start_nid, cx.compounds[last], scope_id, cache, skip_first_tag) {
    return false
  }
  let nodes = doc.nodes
  if last == 0 {
    if anchor_id < 0 {
      return true
    }
    if anchor_direct {
      return nodes[start_nid].parent == anchor_id
    }
    return is_strict_descendant(doc, start_nid, anchor_id)
  }

  // Reuse scratch stacks from `cache` (zero heap allocation per candidate node!)
  let st_idx = cache.st_idx
  let st_nid = cache.st_nid
  let st_kind = cache.st_kind
  let st_base = st_idx.length()

  let mut cur_idx = last
  let mut cur_nid = start_nid

  while true {
    let mut fail_level = 0 // 0=local, 1=sibling-exhausted, 2=global-ancestor-exhausted

    while cur_idx > 0 {
      let comb = cx.combinators[cur_idx - 1]
      let target_idx = cur_idx - 1
      let target_comp = cx.compounds[target_idx]
      match comb {
        Combinator::Child => {
          let pid = nodes[cur_nid].parent
          if pid < 0 || nodes[pid].kind != kind_element {
            fail_level = 2
            break
          }
          if !match_compound_id(doc, pid, target_comp, scope_id, cache, false) {
            fail_level = 0
            break
          }
          cur_idx = target_idx
          cur_nid = pid
        }
        Combinator::NextSibling => {
          let sid = prev_elem_sibling(doc, cur_nid)
          if sid < 0 {
            fail_level = 1
            break
          }
          if !match_compound_id(doc, sid, target_comp, scope_id, cache, false) {
            fail_level = 0
            break
          }
          cur_idx = target_idx
          cur_nid = sid
        }
        Combinator::Descendant => {
          let mut pid = nodes[cur_nid].parent
          let mut found_pid = -1
          while pid >= 0 && nodes[pid].kind == kind_element {
            if match_compound_id(doc, pid, target_comp, scope_id, cache, false) {
              found_pid = pid
              break
            }
            pid = nodes[pid].parent
          }
          if found_pid < 0 {
            fail_level = 2
            break
          }
          if target_idx > 0 || anchor_id >= 0 {
            let next_anc = nodes[found_pid].parent
            if next_anc >= 0 && nodes[next_anc].kind == kind_element {
              st_idx.push(target_idx)
              st_nid.push(next_anc)
              st_kind.push(1)
            }
          }
          cur_idx = target_idx
          cur_nid = found_pid
        }
        Combinator::SubsequentSibling => {
          let mut sid = prev_elem_sibling(doc, cur_nid)
          let mut found_sid = -1
          while sid >= 0 {
            if match_compound_id(doc, sid, target_comp, scope_id, cache, false) {
              found_sid = sid
              break
            }
            sid = prev_elem_sibling(doc, sid)
          }
          if found_sid < 0 {
            fail_level = 1
            break
          }
          if target_idx > 0 || anchor_id >= 0 {
            let next_sib = prev_elem_sibling(doc, found_sid)
            if next_sib >= 0 {
              st_idx.push(target_idx)
              st_nid.push(next_sib)
              st_kind.push(3)
            }
          }
          cur_idx = target_idx
          cur_nid = found_sid
        }
      }
    }

    if cur_idx == 0 {
      let ok = if anchor_id < 0 {
        true
      } else if anchor_direct {
        nodes[cur_nid].parent == anchor_id
      } else {
        is_strict_descendant(doc, cur_nid, anchor_id)
      }
      if ok {
        while st_idx.length() > st_base {
          let _ = st_idx.pop()
          let _ = st_nid.pop()
          let _ = st_kind.pop()
        }
        return true
      }
      fail_level = 0
    }

    if fail_level == 2 || st_idx.length() <= st_base {
      while st_idx.length() > st_base {
        let _ = st_idx.pop()
        let _ = st_nid.pop()
        let _ = st_kind.pop()
      }
      return false
    }

    let mut resumed = false
    while st_idx.length() > st_base {
      let top = st_idx.length() - 1
      let kind = st_kind[top]
      let tidx = st_idx[top]
      let cand = st_nid[top]
      let _ = st_idx.pop()
      let _ = st_nid.pop()
      let _ = st_kind.pop()

      if fail_level == 1 && kind == 3 {
        continue
      }

      let target_comp = cx.compounds[tidx]
      if kind == 1 {
        let mut pid = cand
        let mut found_pid = -1
        while pid >= 0 && nodes[pid].kind == kind_element {
          if match_compound_id(doc, pid, target_comp, scope_id, cache, false) {
            found_pid = pid
            break
          }
          pid = nodes[pid].parent
        }
        if found_pid >= 0 {
          let next_anc = nodes[found_pid].parent
          if next_anc >= 0 && nodes[next_anc].kind == kind_element {
            st_idx.push(tidx)
            st_nid.push(next_anc)
            st_kind.push(1)
          }
          cur_idx = tidx
          cur_nid = found_pid
          resumed = true
          break
        } else {
          while st_idx.length() > st_base {
            let _ = st_idx.pop()
            let _ = st_nid.pop()
            let _ = st_kind.pop()
          }
          return false
        }
      } else {
        let mut sid = cand
        let mut found_sid = -1
        while sid >= 0 {
          if match_compound_id(doc, sid, target_comp, scope_id, cache, false) {
            found_sid = sid
            break
          }
          sid = prev_elem_sibling(doc, sid)
        }
        if found_sid >= 0 {
          let next_sib = prev_elem_sibling(doc, found_sid)
          if next_sib >= 0 {
            st_idx.push(tidx)
            st_nid.push(next_sib)
            st_kind.push(3)
          }
          cur_idx = tidx
          cur_nid = found_sid
          resumed = true
          break
        } else {
          fail_level = 1
        }
      }
    }
    if !resumed {
      return false
    }
  }
  false
}

fn match_complex_iter(
  doc : Document,
  nid : Int,
  cx : ComplexSelector,
  scope_id : Int,
  cache : NthCache,
) -> Bool {
  match_complex_anchored(doc, nid, cx, -1, false, scope_id, cache, false)
}

fn selector_matches_id(
  sel : Selector,
  doc : Document,
  nid : Int,
  scope_id : Int,
  cache : NthCache,
) -> Bool {
  let n = sel.items.length()
  let mut i = 0
  while i < n {
    if match_complex_iter(doc, nid, sel.items[i], scope_id, cache) {
      return true
    }
    i = i + 1
  }
  false
}

///| Test whether `node` matches this compiled `Selector`.
pub fn Selector::matches(self : Selector, node : Node) -> Bool {
  if node.doc.nodes[node.id].kind != kind_element {
    return false
  }
  selector_matches_id(self, node.doc, node.id, 0, empty_nth_cache())
}

///| Iteratively collect matching descendant elements of `root_id` in document order.
fn select_descendants(
  doc : Document,
  root_id : Int,
  sel : Selector,
  first_only : Bool,
) -> Array[Node] {
  let out : Array[Node] = []
  let cache = empty_nth_cache()
  let nodes = doc.nodes
  let n_nodes = nodes.length()
  let src = doc.src
  let strings = doc.strings

  let item_count = sel.items.length()
  // Pre-extract rightmost tag filters for every item in selector list
  let tag_filters : Array[String] = []
  let tag_lens : Array[Int] = []
  let tag_b0s : Array[Int] = []
  let mut all_have_tag = item_count > 0
  let mut ti = 0
  while ti < item_count {
    let cx = sel.items[ti]
    let last_c = cx.compounds[cx.compounds.length() - 1]
    if last_c.never_matches {
      all_have_tag = false
      break
    }
    match last_c.tag {
      Some(t) => {
        tag_filters.push(t)
        tag_lens.push(t.length())
        tag_b0s.push(if t.length() > 0 { t.code_unit_at(0) } else { 0 })
      }
      None => {
        all_have_tag = false
        break
      }
    }
    ti = ti + 1
  }

  // Ultra-fast flat linear scan when querying full document with no reparenting (zero stack, zero pointer chase)
  if root_id == 0 && n_nodes > 0 && nodes[0].data_start == 0 {
    if all_have_tag && item_count == 1 {
      let cx = sel.items[0]
      let ftag = tag_filters[0]
      let flen = tag_lens[0]
      let fb0 = tag_b0s[0]
      let mut cur = 1
      while cur < n_nodes {
        let nd = nodes[cur]
        if nd.kind == kind_element {
          let ds = nd.data_start
          let tag_ok = if ds >= 0 {
            (nd.data_end - ds) == flen &&
            src.code_unit_at(ds) == fb0 &&
            (flen == 1 || slice_eq_exact(src, ds, nd.data_end, ftag))
          } else {
            strings[-(ds + 1)] == ftag
          }
          if tag_ok && match_complex_anchored(doc, cur, cx, -1, false, 0, cache, true) {
            out.push(Node::{ doc: doc, id: cur })
            if first_only {
              return out
            }
          }
        }
        cur = cur + 1
      }
      return out
    }
    if all_have_tag && item_count == 2 {
      let cx0 = sel.items[0]
      let cx1 = sel.items[1]
      let t0 = tag_filters[0]
      let l0 = tag_lens[0]
      let b0 = tag_b0s[0]
      let t1 = tag_filters[1]
      let l1 = tag_lens[1]
      let b1 = tag_b0s[1]
      let mut cur = 1
      while cur < n_nodes {
        let nd = nodes[cur]
        if nd.kind == kind_element {
          let ds = nd.data_start
          let mut matched = false
          if ds >= 0 {
            let nlen = nd.data_end - ds
            let nb0 = src.code_unit_at(ds)
            if nlen == l0 && nb0 == b0 && (l0 == 1 || slice_eq_exact(src, ds, nd.data_end, t0)) {
              if match_complex_anchored(doc, cur, cx0, -1, false, 0, cache, true) {
                matched = true
              }
            }
            if !matched && nlen == l1 && nb0 == b1 && (l1 == 1 || slice_eq_exact(src, ds, nd.data_end, t1)) {
              if match_complex_anchored(doc, cur, cx1, -1, false, 0, cache, true) {
                matched = true
              }
            }
          } else {
            let s = strings[-(ds + 1)]
            if s == t0 && match_complex_anchored(doc, cur, cx0, -1, false, 0, cache, true) {
              matched = true
            } else if s == t1 && match_complex_anchored(doc, cur, cx1, -1, false, 0, cache, true) {
              matched = true
            }
          }
          if matched {
            out.push(Node::{ doc: doc, id: cur })
            if first_only {
              return out
            }
          }
        }
        cur = cur + 1
      }
      return out
    }
    let mut cur = 1
    while cur < n_nodes {
      let nd = nodes[cur]
      if nd.kind == kind_element {
        if selector_matches_id(sel, doc, cur, 0, cache) {
          out.push(Node::{ doc: doc, id: cur })
          if first_only {
            return out
          }
        }
      }
      cur = cur + 1
    }
    return out
  }

  // General tree walk (for Node::select or documents with reparented nodes)
  let stack : Array[Int] = []
  let mut cur = nodes[root_id].first_child
  if all_have_tag && item_count == 1 {
    let cx = sel.items[0]
    let ftag = tag_filters[0]
    let flen = tag_lens[0]
    let fb0 = tag_b0s[0]
    while cur >= 0 || stack.length() > 0 {
      while cur >= 0 {
        let nd = nodes[cur]
        if nd.kind == kind_element {
          let ds = nd.data_start
          let tag_ok = if ds >= 0 {
            (nd.data_end - ds) == flen &&
            src.code_unit_at(ds) == fb0 &&
            (flen == 1 || slice_eq_exact(src, ds, nd.data_end, ftag))
          } else {
            strings[-(ds + 1)] == ftag
          }
          if tag_ok && match_complex_anchored(doc, cur, cx, -1, false, root_id, cache, true) {
            out.push(Node::{ doc: doc, id: cur })
            if first_only {
              return out
            }
          }
        }
        if nd.first_child >= 0 {
          if nd.next_sibling >= 0 {
            stack.push(nd.next_sibling)
          }
          cur = nd.first_child
        } else {
          cur = nd.next_sibling
        }
      }
      if stack.length() > 0 {
        match stack.pop() {
          Some(nxt) => cur = nxt
          None => ()
        }
      }
    }
    return out
  }

  while cur >= 0 || stack.length() > 0 {
    while cur >= 0 {
      let nd = nodes[cur]
      if nd.kind == kind_element {
        if selector_matches_id(sel, doc, cur, root_id, cache) {
          out.push(Node::{ doc: doc, id: cur })
          if first_only {
            return out
          }
        }
      }
      if nd.first_child >= 0 {
        if nd.next_sibling >= 0 {
          stack.push(nd.next_sibling)
        }
        cur = nd.first_child
      } else {
        cur = nd.next_sibling
      }
    }
    if stack.length() > 0 {
      match stack.pop() {
        Some(nxt) => cur = nxt
        None => ()
      }
    }
  }
  out
}

///|
pub fn Document::select(
  self : Document,
  selector : String,
) -> Result[Array[Node], HtmlError] {
  match Selector::parse(selector) {
    Ok(sel) => Ok(select_descendants(self, 0, sel, false))
    Err(e) => Err(e)
  }
}

///|
pub fn Document::select_first(
  self : Document,
  selector : String,
) -> Result[Option[Node], HtmlError] {
  match Selector::parse(selector) {
    Ok(sel) => {
      let v = select_descendants(self, 0, sel, true)
      if v.length() > 0 {
        Ok(Some(v[0]))
      } else {
        Ok(None)
      }
    }
    Err(e) => Err(e)
  }
}

///|
pub fn Document::select_compiled(self : Document, sel : Selector) -> Array[Node] {
  select_descendants(self, 0, sel, false)
}

///|
pub fn Document::select_first_compiled(
  self : Document,
  sel : Selector,
) -> Option[Node] {
  let v = select_descendants(self, 0, sel, true)
  if v.length() > 0 {
    Some(v[0])
  } else {
    None
  }
}

///|
pub fn Node::select(
  self : Node,
  selector : String,
) -> Result[Array[Node], HtmlError] {
  match Selector::parse(selector) {
    Ok(sel) => Ok(select_descendants(self.doc, self.id, sel, false))
    Err(e) => Err(e)
  }
}

///|
pub fn Node::select_first(
  self : Node,
  selector : String,
) -> Result[Option[Node], HtmlError] {
  match Selector::parse(selector) {
    Ok(sel) => {
      let v = select_descendants(self.doc, self.id, sel, true)
      if v.length() > 0 {
        Ok(Some(v[0]))
      } else {
        Ok(None)
      }
    }
    Err(e) => Err(e)
  }
}

///|
pub fn Node::select_compiled(self : Node, sel : Selector) -> Array[Node] {
  select_descendants(self.doc, self.id, sel, false)
}

///|
pub fn Node::matches(self : Node, sel : Selector) -> Bool {
  sel.matches(self)
}
