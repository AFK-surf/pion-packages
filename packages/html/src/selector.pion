///| CSS selector parser and matcher (stub for Red phase).

///|
pub fn Selector::parse(input : String) -> Result[Selector, HtmlError] {
  let _ = input
  Err(HtmlError::new(HtmlErrorKind::Unimplemented, 0, "Selector::parse not implemented"))
}

///|
pub fn Selector::matches(self : Selector, node : Node) -> Bool {
  let _ = self
  let _ = node
  false
}

///|
pub fn Document::select(
  self : Document,
  selector : String,
) -> Result[Array[Node], HtmlError] {
  let _ = self
  let _ = selector
  Err(HtmlError::new(HtmlErrorKind::Unimplemented, 0, "Document::select not implemented"))
}

///|
pub fn Document::select_first(
  self : Document,
  selector : String,
) -> Result[Option[Node], HtmlError] {
  let _ = self
  let _ = selector
  Err(HtmlError::new(HtmlErrorKind::Unimplemented, 0, "Document::select_first not implemented"))
}

///|
pub fn Document::select_compiled(self : Document, sel : Selector) -> Array[Node] {
  let _ = self
  let _ = sel
  []
}

///|
pub fn Document::select_first_compiled(
  self : Document,
  sel : Selector,
) -> Option[Node] {
  let _ = self
  let _ = sel
  None
}

///|
pub fn Node::select(
  self : Node,
