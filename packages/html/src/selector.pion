///| CSS Selectors parser and matcher (`Selector`, `select`, `select_first`, `matches`).

struct SelParser {
  src : String
  len : Int
  mut pos : Int
}

fn SelParser::new(src : String) -> SelParser {
  SelParser::{ src: src, len: src.length(), pos: 0 }
}

fn SelParser::skip_ws(self : SelParser) -> Bool {
  let start = self.pos
  while self.pos < self.len && is_html_ws(self.src.code_unit_at(self.pos)) {
    self.pos = self.pos + 1
  }
  self.pos > start
}

fn is_css_ident_char(b : Int) -> Bool {
  is_ascii_alnum(b) || b == 0x2D || b == 0x5F || b >= 0x80
}

fn SelParser::parse_ident(self : SelParser) -> Result[String, HtmlError] {
  let start = self.pos
  if self.pos >= self.len {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        start,
        "expected CSS identifier",
      ),
    )
  }
  let sb = StringBuilder::with_capacity(16)
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 0x5C && self.pos + 1 < self.len {
      self.pos = self.pos + 1
      sb.write_byte(self.src.code_unit_at(self.pos).to_byte())
      self.pos = self.pos + 1
    } else if is_css_ident_char(b) {
      sb.write_byte(b.to_byte())
      self.pos = self.pos + 1
    } else {
      break
    }
  }
  let out = sb.to_string()
  if out.length() == 0 {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        start,
        "expected CSS identifier",
      ),
    )
  }
  Ok(out)
}

fn SelParser::parse_string(self : SelParser) -> Result[String, HtmlError] {
  let start = self.pos
  let q = self.src.code_unit_at(self.pos)
  self.pos = self.pos + 1
  let sb = StringBuilder::with_capacity(16)
  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == q {
      self.pos = self.pos + 1
      return Ok(sb.to_string())
    }
    if b == 0x5C && self.pos + 1 < self.len {
      self.pos = self.pos + 1
      sb.write_byte(self.src.code_unit_at(self.pos).to_byte())
      self.pos = self.pos + 1
    } else {
      sb.write_byte(b.to_byte())
      self.pos = self.pos + 1
    }
  }
  Err(
    HtmlError::new(
      HtmlErrorKind::InvalidSelector,
      start,
      "unterminated string in attribute selector",
    ),
  )
}

fn SelParser::parse_attr_matcher(
  self : SelParser,
) -> Result[AttrMatcher, HtmlError] {
  let open_pos = self.pos
  self.pos = self.pos + 1 // skip '['
  let _ = self.skip_ws()
  let raw_name = match self.parse_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let name = to_ascii_lower(raw_name)
  let _ = self.skip_ws()
  if self.pos >= self.len {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        open_pos,
        "unclosed '[' in attribute selector",
      ),
    )
  }
  if self.src.code_unit_at(self.pos) == 0x5D {
    self.pos = self.pos + 1
    return Ok(
      AttrMatcher::{
        name: name,
        op: AttrOp::Exists,
        value: "",
        case_insensitive: false,
      },
    )
  }

  let b0 = self.src.code_unit_at(self.pos)
  let op = if b0 == 0x3D {
    self.pos = self.pos + 1
    AttrOp::Exact
  } else if self.pos + 1 < self.len && self.src.code_unit_at(self.pos + 1) == 0x3D {
    self.pos = self.pos + 2
    if b0 == 0x7E {
      AttrOp::Includes
    } else if b0 == 0x7C {
      AttrOp::DashMatch
    } else if b0 == 0x5E {
      AttrOp::Prefix
    } else if b0 == 0x24 {
      AttrOp::Suffix
    } else if b0 == 0x2A {
      AttrOp::Substring
    } else {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          self.pos - 2,
          "invalid attribute operator",
        ),
      )
    }
  } else {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        self.pos,
        "expected attribute operator or ']'",
      ),
    )
  }

  let _ = self.skip_ws()
  if self.pos >= self.len {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        open_pos,
        "expected attribute value",
      ),
    )
  }
  let v0 = self.src.code_unit_at(self.pos)
  let attr_val = if v0 == 0x22 || v0 == 0x27 {
    match self.parse_string() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
  } else {
    match self.parse_ident() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
  }

  let _ = self.skip_ws()
  let mut ci = false
  if self.pos < self.len {
    let f = self.src.code_unit_at(self.pos)
    if f == 0x69 || f == 0x49 {
      ci = true
      self.pos = self.pos + 1
      let _ = self.skip_ws()
    } else if f == 0x73 || f == 0x53 {
      ci = false
      self.pos = self.pos + 1
      let _ = self.skip_ws()
    }
  }

  if self.pos >= self.len || self.src.code_unit_at(self.pos) != 0x5D {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        open_pos,
        "expected ']' to close attribute selector",
      ),
    )
  }
  self.pos = self.pos + 1
  Ok(AttrMatcher::{ name: name, op: op, value: attr_val, case_insensitive: ci })
}

///| Parse `An+B` / `odd` / `even` inside `:nth-child(...)`.
fn parse_nth_expr(raw : String, offset : Int) -> Result[(Int, Int), HtmlError] {
  // Strip all ASCII whitespace
  let sb = StringBuilder::with_capacity(raw.length())
  let mut i = 0
  while i < raw.length() {
    let b = raw.code_unit_at(i)
    if !is_html_ws(b) {
      sb.write_byte(ascii_lower_byte(b).to_byte())
    }
    i = i + 1
  }
  let s = sb.to_string()
  if s.length() == 0 {
    return Err(
      HtmlError::new(HtmlErrorKind::InvalidSelector, offset, "empty nth-child expression"),
    )
  }
  if s == "odd" {
    return Ok((2, 1))
  }
  if s == "even" {
    return Ok((2, 0))
  }
  // Find 'n'
  let mut n_idx = -1
  i = 0
  while i < s.length() {
    if s.code_unit_at(i) == 0x6E {
      n_idx = i
      break
    }
    i = i + 1
  }
  if n_idx < 0 {
    // Pure integer B
    let b_val = match parse_signed_int(s, 0, s.length()) {
      Some(v) => v
      None =>
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          offset,
          "invalid nth-child integer: " + s,
        ),
      )
    }
    return Ok((0, b_val))
  }
  // Parse A before 'n'
  let a_val = if n_idx == 0 {
    1
  } else if n_idx == 1 && s.code_unit_at(0) == 0x2B {
    1
  } else if n_idx == 1 && s.code_unit_at(0) == 0x2D {
    -1
  } else {
    match parse_signed_int(s, 0, n_idx) {
      Some(v) => v
      None =>
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          offset,
          "invalid nth-child A coefficient: " + s,
        ),
      )
    }
  }
  // Parse B after 'n'
  let b_val = if n_idx + 1 >= s.length() {
    0
  } else {
    let first_b = s.code_unit_at(n_idx + 1)
    if first_b != 0x2B && first_b != 0x2D {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          offset,
          "expected '+' or '-' after 'n' in nth-child",
        ),
      )
    }
    match parse_signed_int(s, n_idx + 1, s.length()) {
      Some(v) => v
      None =>
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          offset,
          "invalid nth-child B offset: " + s,
        ),
      )
    }
  }
  Ok((a_val, b_val))
}

fn parse_signed_int(s : String, start : Int, end : Int) -> Option[Int] {
  if start >= end {
    return None
  }
  let mut i = start
  let mut neg = false
  let b0 = s.code_unit_at(i)
  if b0 == 0x2D {
    neg = true
    i = i + 1
  } else if b0 == 0x2B {
    i = i + 1
  }
  if i >= end {
    return None
  }
  let mut acc = 0
  while i < end {
    let c = s.code_unit_at(i)
    if c < 0x30 || c > 0x39 {
      return None
    }
    acc = acc * 10 + (c - 0x30)
    i = i + 1
  }
  if neg {
    Some(-acc)
  } else {
    Some(acc)
  }
}

fn SelParser::parse_pseudo(
  self : SelParser,
  not_depth : Int,
) -> Result[PseudoClass, HtmlError] {
  let p_pos = self.pos
  self.pos = self.pos + 1 // skip ':'
  let raw_name = match self.parse_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let name = to_ascii_lower(raw_name)
  if name == "first-child" {
    return Ok(PseudoClass::FirstChild)
  }
  if name == "last-child" {
    return Ok(PseudoClass::LastChild)
  }
  if name == "only-child" {
    return Ok(PseudoClass::OnlyChild)
  }
  if name == "empty" {
    return Ok(PseudoClass::Empty)
  }
  if name == "root" {
    return Ok(PseudoClass::Root)
  }
  if name == "first-of-type" {
    return Ok(PseudoClass::FirstOfType)
  }
  if name == "last-of-type" {
    return Ok(PseudoClass::LastOfType)
  }
  if name == "nth-child" {
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 0x28 {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          p_pos,
          "expected '(' after :nth-child",
        ),
      )
    }
    self.pos = self.pos + 1
    let astart = self.pos
    while self.pos < self.len && self.src.code_unit_at(self.pos) != 0x29 {
      self.pos = self.pos + 1
    }
    if self.pos >= self.len {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          p_pos,
          "unclosed '(' in :nth-child",
        ),
      )
    }
    let expr = self.src.slice(astart, self.pos)
    self.pos = self.pos + 1
    match parse_nth_expr(expr, astart) {
      Ok((a, b)) => return Ok(PseudoClass::NthChild(a, b))
      Err(e) => return Err(e)
    }
  }
  if name == "not" {
    if not_depth >= 8 {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          p_pos,
          ":not() nesting too deep",
        ),
      )
    }
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 0x28 {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          p_pos,
          "expected '(' after :not",
        ),
      )
    }
    self.pos = self.pos + 1
    let inner = match self.parse_selector_list(true, not_depth + 1) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if self.pos >= self.len || self.src.code_unit_at(self.pos) != 0x29 {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          p_pos,
          "unclosed '(' in :not()",
        ),
      )
    }
    self.pos = self.pos + 1
    return Ok(PseudoClass::Not(inner))
  }
  Err(
    HtmlError::new(
      HtmlErrorKind::InvalidSelector,
      p_pos,
      "unsupported pseudo-class :" + name,
    ),
  )
}

fn SelParser::parse_compound(
  self : SelParser,
  not_depth : Int,
) -> Result[CompoundSelector, HtmlError] {
  let start = self.pos
  let mut tag : Option[String] = None
  let mut id : Option[String] = None
  let classes : Array[String] = []
  let attrs : Array[AttrMatcher] = []
  let pseudos : Array[PseudoClass] = []
  let mut parsed_any = false

  if self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 0x2A {
      // '*'
      self.pos = self.pos + 1
      parsed_any = true
    } else if is_css_ident_char(b) {
      match self.parse_ident() {
        Ok(t) => {
          tag = Some(to_ascii_lower(t))
          parsed_any = true
        }
        Err(e) => return Err(e)
      }
    }
  }

  while self.pos < self.len {
    let b = self.src.code_unit_at(self.pos)
    if b == 0x23 {
      // '#'
      self.pos = self.pos + 1
      match self.parse_ident() {
        Ok(v) => {
          id = Some(v)
          parsed_any = true
        }
        Err(e) => return Err(e)
      }
    } else if b == 0x2E {
      // '.'
      self.pos = self.pos + 1
      match self.parse_ident() {
        Ok(c) => {
          classes.push(c)
          parsed_any = true
        }
        Err(e) => return Err(e)
      }
    } else if b == 0x5B {
      // '['
      match self.parse_attr_matcher() {
        Ok(am) => {
          attrs.push(am)
          parsed_any = true
        }
        Err(e) => return Err(e)
      }
    } else if b == 0x3A {
      // ':'
      match self.parse_pseudo(not_depth) {
        Ok(pc) => {
          pseudos.push(pc)
          parsed_any = true
        }
        Err(e) => return Err(e)
      }
    } else {
      break
    }
  }

  if !parsed_any {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        start,
        "expected compound selector",
      ),
    )
  }

  Ok(
    CompoundSelector::{
      tag: tag,
      id: id,
      classes: classes,
      attrs: attrs,
      pseudos: pseudos,
    },
  )
}

fn SelParser::parse_complex(
  self : SelParser,
  stop_on_rparen : Bool,
  not_depth : Int,
) -> Result[ComplexSelector, HtmlError] {
  let _ = self.skip_ws()
  let compounds : Array[CompoundSelector] = []
  let combinators : Array[Combinator] = []

  let first = match self.parse_compound(not_depth) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  compounds.push(first)

  while self.pos < self.len {
    let had_ws = self.skip_ws()
    if self.pos >= self.len {
      break
    }
    let b = self.src.code_unit_at(self.pos)
    if b == 0x2C || (stop_on_rparen && b == 0x29) {
      break
    }
    let comb = if b == 0x3E {
      self.pos = self.pos + 1
      let _ = self.skip_ws()
      Combinator::Child
    } else if b == 0x2B {
      self.pos = self.pos + 1
      let _ = self.skip_ws()
      Combinator::NextSibling
    } else if b == 0x7E {
      self.pos = self.pos + 1
      let _ = self.skip_ws()
      Combinator::SubsequentSibling
    } else if had_ws {
      Combinator::Descendant
    } else {
      return Err(
        HtmlError::new(
          HtmlErrorKind::InvalidSelector,
          self.pos,
          "unexpected character in selector",
        ),
      )
    }

    let next_c = match self.parse_compound(not_depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    combinators.push(comb)
    compounds.push(next_c)
  }

  Ok(ComplexSelector::{ compounds: compounds, combinators: combinators })
}

fn SelParser::parse_selector_list(
  self : SelParser,
  stop_on_rparen : Bool,
  not_depth : Int,
) -> Result[Array[ComplexSelector], HtmlError] {
  let items : Array[ComplexSelector] = []
  let _ = self.skip_ws()
  if self.pos >= self.len ||
  (stop_on_rparen && self.src.code_unit_at(self.pos) == 0x29) {
    return Err(
      HtmlError::new(HtmlErrorKind::InvalidSelector, self.pos, "empty selector"),
    )
  }
  let mut parsing = true
  while parsing {
    let cx = match self.parse_complex(stop_on_rparen, not_depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    items.push(cx)
    let _ = self.skip_ws()
    if self.pos < self.len && self.src.code_unit_at(self.pos) == 0x2C {
      self.pos = self.pos + 1
      let _ = self.skip_ws()
      if self.pos >= self.len ||
      (stop_on_rparen && self.src.code_unit_at(self.pos) == 0x29) {
        return Err(
          HtmlError::new(
            HtmlErrorKind::InvalidSelector,
            self.pos,
            "trailing comma in selector list",
          ),
        )
      }
    } else {
      parsing = false
    }
  }
  Ok(items)
}

///| Parse a CSS selector string into a compiled `Selector`.
pub fn Selector::parse(input : String) -> Result[Selector, HtmlError] {
  let p = SelParser::new(input)
  let items = match p.parse_selector_list(false, 0) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let _ = p.skip_ws()
  if p.pos < p.len {
    return Err(
      HtmlError::new(
        HtmlErrorKind::InvalidSelector,
        p.pos,
        "unexpected trailing token in selector",
      ),
    )
  }
  Ok(Selector::{ items: items })
}

fn eq_str_opt_ci(a : String, b : String, ci : Bool) -> Bool {
  if !ci {
    return a == b
  }
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if ascii_lower_byte(a.code_unit_at(i)) != ascii_lower_byte(b.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

fn match_attr(doc : Document, nid : Int, am : AttrMatcher) -> Bool {
  let node = Node::{ doc: doc, id: nid }
  let raw_val = match node.attr(am.name) {
    Some(v) => v
    None => return false
  }
  match am.op {
    AttrOp::Exists => true
    AttrOp::Exact => eq_str_opt_ci(raw_val, am.value, am.case_insensitive)
    AttrOp::Includes => {
      if am.value.length() == 0 {
        return false
      }
      let n = raw_val.length()
      let mut i = 0
      while i < n {
        while i < n && is_html_ws(raw_val.code_unit_at(i)) {
          i = i + 1
        }
        let s = i
        while i < n && !is_html_ws(raw_val.code_unit_at(i)) {
          i = i + 1
        }
        if i > s && eq_str_opt_ci(raw_val.slice(s, i), am.value, am.case_insensitive) {
          return true
        }
      }
      false
    }
    AttrOp::DashMatch => {
      let vlen = am.value.length()
      if raw_val.length() == vlen {
        eq_str_opt_ci(raw_val, am.value, am.case_insensitive)
      } else if raw_val.length() > vlen && raw_val.code_unit_at(vlen) == 0x2D {
        eq_str_opt_ci(raw_val.slice(0, vlen), am.value, am.case_insensitive)
      } else {
        false
      }
    }
    AttrOp::Prefix => {
      let vlen = am.value.length()
      if vlen == 0 || raw_val.length() < vlen {
        return false
      }
      eq_str_opt_ci(raw_val.slice(0, vlen), am.value, am.case_insensitive)
    }
    AttrOp::Suffix => {
      let vlen = am.value.length()
      let rlen = raw_val.length()
      if vlen == 0 || rlen < vlen {
        return false
      }
      eq_str_opt_ci(raw_val.slice(rlen - vlen, rlen), am.value, am.case_insensitive)
    }
    AttrOp::Substring => {
      let vlen = am.value.length()
      let rlen = raw_val.length()
      if vlen == 0 || rlen < vlen {
        return false
      }
      let mut i = 0
      while i <= rlen - vlen {
        let mut j = 0
        while j < vlen {
          let cb = if am.case_insensitive {
            ascii_lower_byte(raw_val.code_unit_at(i + j))
          } else {
            raw_val.code_unit_at(i + j)
          }
          let tb = if am.case_insensitive {
            ascii_lower_byte(am.value.code_unit_at(j))
          } else {
            am.value.code_unit_at(j)
          }
          if cb != tb {
            break
          }
          j = j + 1
        }
        if j == vlen {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

fn prev_elem_sibling(doc : Document, nid : Int) -> Int {
  let mut cur = doc.nodes[nid].prev_sibling
  while cur >= 0 {
    if doc.nodes[cur].kind == kind_element {
      return cur
    }
    cur = doc.nodes[cur].prev_sibling
  }
  -1
}

fn next_elem_sibling(doc : Document, nid : Int) -> Int {
  let mut cur = doc.nodes[nid].next_sibling
  while cur >= 0 {
    if doc.nodes[cur].kind == kind_element {
      return cur
    }
    cur = doc.nodes[cur].next_sibling
  }
  -1
}

fn elem_child_index_1based(doc : Document, nid : Int) -> Int {
  let mut idx = 1
  let mut cur = doc.nodes[nid].prev_sibling
  while cur >= 0 {
    if doc.nodes[cur].kind == kind_element {
      idx = idx + 1
    }
    cur = doc.nodes[cur].prev_sibling
  }
  idx
}

fn match_nth(a : Int, b : Int, idx : Int) -> Bool {
  if a == 0 {
    return idx == b
  }
  let diff = idx - b
  if a > 0 {
    diff >= 0 && diff % a == 0
  } else {
    diff <= 0 && (-diff) % (-a) == 0
  }
}

fn match_pseudo(doc : Document, nid : Int, pc : PseudoClass) -> Bool {
  match pc {
    PseudoClass::FirstChild => prev_elem_sibling(doc, nid) < 0
    PseudoClass::LastChild => next_elem_sibling(doc, nid) < 0
    PseudoClass::OnlyChild =>
    prev_elem_sibling(doc, nid) < 0 && next_elem_sibling(doc, nid) < 0
    PseudoClass::NthChild(a, b) => match_nth(a, b, elem_child_index_1based(doc, nid))
    PseudoClass::Empty => {
      let mut c = doc.nodes[nid].first_child
      while c >= 0 {
        let cnd = doc.nodes[c]
        if cnd.kind == kind_element {
          return false
        }
        if cnd.kind == kind_text {
          if doc_resolve_span(doc, cnd.data_start, cnd.data_end).length() > 0 {
            return false
          }
        }
        c = cnd.next_sibling
      }
      true
    }
    PseudoClass::Root => {
      let pid = doc.nodes[nid].parent
      pid == 0 && doc.nodes[nid].kind == kind_element
    }
    PseudoClass::FirstOfType => {
      let my_tag = Node::{ doc: doc, id: nid }.tag_name()
      let mut cur = doc.nodes[nid].prev_sibling
      while cur >= 0 {
        if doc.nodes[cur].kind == kind_element &&
        Node::{ doc: doc, id: cur }.tag_name() == my_tag {
          return false
        }
        cur = doc.nodes[cur].prev_sibling
      }
      true
    }
    PseudoClass::LastOfType => {
      let my_tag = Node::{ doc: doc, id: nid }.tag_name()
      let mut cur = doc.nodes[nid].next_sibling
      while cur >= 0 {
        if doc.nodes[cur].kind == kind_element &&
        Node::{ doc: doc, id: cur }.tag_name() == my_tag {
          return false
        }
        cur = doc.nodes[cur].next_sibling
      }
      true
    }
    PseudoClass::Not(list) => {
      let mut i = 0
      while i < list.length() {
        if match_complex(doc, nid, list[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
  }
}

fn match_compound(doc : Document, nid : Int, comp : CompoundSelector) -> Bool {
  let nd = doc.nodes[nid]
  if nd.kind != kind_element {
    return false
  }
  match comp.tag {
    Some(t) => {
      let ok = if nd.data_start >= 0 {
        slice_eq_exact(doc.src, nd.data_start, nd.data_end, t)
      } else {
        doc.strings[-(nd.data_start + 1)] == t
      }
      if !ok {
        return false
      }
    }
    None => ()
  }
  let node = Node::{ doc: doc, id: nid }
  match comp.id {
    Some(expected_id) =>
    match node.attr("id") {
      Some(actual) => if actual != expected_id { return false }
      None => return false
    }
    None => ()
  }
  let mut i = 0
  while i < comp.classes.length() {
    if !node.has_class(comp.classes[i]) {
      return false
    }
    i = i + 1
  }
  i = 0
  while i < comp.attrs.length() {
    if !match_attr(doc, nid, comp.attrs[i]) {
      return false
    }
    i = i + 1
  }
  i = 0
  while i < comp.pseudos.length() {
    if !match_pseudo(doc, nid, comp.pseudos[i]) {
      return false
    }
    i = i + 1
  }
  true
}

///| Match a complex selector against `nid` from right to left.
fn match_complex_at(
  doc : Document,
  nid : Int,
  cx : ComplexSelector,
  idx : Int,
) -> Bool {
  if !match_compound(doc, nid, cx.compounds[idx]) {
    return false
  }
  if idx == 0 {
    return true
  }
  let comb = cx.combinators[idx - 1]
  match comb {
    Combinator::Child => {
      let pid = doc.nodes[nid].parent
      if pid < 0 || doc.nodes[pid].kind != kind_element {
        return false
      }
      match_complex_at(doc, pid, cx, idx - 1)
    }
    Combinator::Descendant => {
      let mut pid = doc.nodes[nid].parent
      while pid >= 0 && doc.nodes[pid].kind == kind_element {
        if match_complex_at(doc, pid, cx, idx - 1) {
          return true
        }
        pid = doc.nodes[pid].parent
      }
      false
    }
    Combinator::NextSibling => {
      let sid = prev_elem_sibling(doc, nid)
      if sid < 0 {
        return false
      }
      match_complex_at(doc, sid, cx, idx - 1)
    }
    Combinator::SubsequentSibling => {
      let mut sid = prev_elem_sibling(doc, nid)
      while sid >= 0 {
        if match_complex_at(doc, sid, cx, idx - 1) {
          return true
        }
        sid = prev_elem_sibling(doc, sid)
      }
      false
    }
  }
}

fn match_complex(doc : Document, nid : Int, cx : ComplexSelector) -> Bool {
  let last = cx.compounds.length() - 1
  if last < 0 {
    return false
  }
  match_complex_at(doc, nid, cx, last)
}

///| Test whether `node` matches this compiled `Selector`.
pub fn Selector::matches(self : Selector, node : Node) -> Bool {
  if node.doc.nodes[node.id].kind != kind_element {
    return false
  }
  let mut i = 0
  while i < self.items.length() {
    if match_complex(node.doc, node.id, self.items[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///| Iteratively collect matching descendant elements of `root_id` in document order.
fn select_descendants(
  doc : Document,
  root_id : Int,
  sel : Selector,
  first_only : Bool,
) -> Array[Node] {
  let out : Array[Node] = []
  let stack : Array[Int] = []
  let mut cur = doc.nodes[root_id].first_child
  while cur >= 0 || stack.length() > 0 {
    while cur >= 0 {
      let nd = doc.nodes[cur]
      if nd.kind == kind_element {
        let node = Node::{ doc: doc, id: cur }
        if sel.matches(node) {
          out.push(node)
          if first_only {
            return out
          }
        }
      }
      if nd.first_child >= 0 {
        if nd.next_sibling >= 0 {
          stack.push(nd.next_sibling)
        }
        cur = nd.first_child
      } else {
        cur = nd.next_sibling
      }
    }
    if stack.length() > 0 {
      match stack.pop() {
        Some(nxt) => cur = nxt
        None => ()
      }
    }
  }
  out
}

///|
pub fn Document::select(
  self : Document,
  selector : String,
) -> Result[Array[Node], HtmlError] {
  match Selector::parse(selector) {
    Ok(sel) => Ok(select_descendants(self, 0, sel, false))
    Err(e) => Err(e)
  }
}

///|
pub fn Document::select_first(
  self : Document,
  selector : String,
) -> Result[Option[Node], HtmlError] {
  match Selector::parse(selector) {
    Ok(sel) => {
      let v = select_descendants(self, 0, sel, true)
      if v.length() > 0 {
        Ok(Some(v[0]))
      } else {
        Ok(None)
      }
    }
    Err(e) => Err(e)
  }
}

///|
pub fn Document::select_compiled(self : Document, sel : Selector) -> Array[Node] {
  select_descendants(self, 0, sel, false)
}

///|
pub fn Document::select_first_compiled(
  self : Document,
  sel : Selector,
) -> Option[Node] {
  let v = select_descendants(self, 0, sel, true)
  if v.length() > 0 {
    Some(v[0])
  } else {
    None
  }
}

///|
pub fn Node::select(
  self : Node,
  selector : String,
) -> Result[Array[Node], HtmlError] {
  match Selector::parse(selector) {
    Ok(sel) => Ok(select_descendants(self.doc, self.id, sel, false))
    Err(e) => Err(e)
  }
}

///|
pub fn Node::select_first(
  self : Node,
  selector : String,
) -> Result[Option[Node], HtmlError] {
  match Selector::parse(selector) {
    Ok(sel) => {
      let v = select_descendants(self.doc, self.id, sel, true)
      if v.length() > 0 {
        Ok(Some(v[0]))
      } else {
        Ok(None)
      }
    }
    Err(e) => Err(e)
  }
}

///|
pub fn Node::select_compiled(self : Node, sel : Selector) -> Array[Node] {
  select_descendants(self.doc, self.id, sel, false)
}

///|
pub fn Node::matches(self : Node, sel : Selector) -> Bool {
  sel.matches(self)
}
