///| WHATWG HTML §4.8.4.3 `<img srcset>` & `<picture><source>` compliance & edge-case tests.

///|
test "srcset_parse_width_density_and_default" {
  let c1 = parse_srcset("small.jpg 400w, medium.jpg 800w, large.jpg 1200w")
  debug_assert(c1.length() == 3, "3 width candidates")
  debug_assert(c1[0].url == "small.jpg", "c1[0] url")
  debug_assert(srcset_descriptor_eq(c1[0].descriptor, SrcsetDescriptor::Width(400)), "c1[0] 400w")
  debug_assert(c1[1].url == "medium.jpg", "c1[1] url")
  debug_assert(srcset_descriptor_eq(c1[1].descriptor, SrcsetDescriptor::Width(800)), "c1[1] 800w")
  debug_assert(c1[2].url == "large.jpg", "c1[2] url")
  debug_assert(srcset_descriptor_eq(c1[2].descriptor, SrcsetDescriptor::Width(1200)), "c1[2] 1200w")

  let c2 = parse_srcset("a.png, b.png 1.5x, c.png 2x, d.png .5x, e.png 2e0x")
  debug_assert(c2.length() == 5, "5 density candidates")
  debug_assert(c2[0].url == "a.png", "default 1x url")
  debug_assert(srcset_descriptor_eq(c2[0].descriptor, SrcsetDescriptor::Density(1.0)), "default 1x")
  debug_assert(srcset_descriptor_eq(c2[1].descriptor, SrcsetDescriptor::Density(1.5)), "1.5x")
  debug_assert(srcset_descriptor_eq(c2[2].descriptor, SrcsetDescriptor::Density(2.0)), "2x")
  debug_assert(srcset_descriptor_eq(c2[3].descriptor, SrcsetDescriptor::Density(0.5)), ".5x")
  debug_assert(srcset_descriptor_eq(c2[4].descriptor, SrcsetDescriptor::Density(2.0)), "2e0x")
}

///|
test "srcset_parse_urls_with_internal_and_trailing_commas" {
  // Cloudinary-style URLs containing internal commas
  let input = "https://res.cloudinary.com/demo/image/upload/w_400,f_auto,q_80/sample.jpg 400w, https://res.cloudinary.com/demo/image/upload/w_800,f_auto/sample.jpg 800w"
  let c = parse_srcset(input)
  debug_assert(c.length() == 2, "2 cloudinary candidates")
  debug_assert(
    c[0].url == "https://res.cloudinary.com/demo/image/upload/w_400,f_auto,q_80/sample.jpg",
    "internal commas preserved 0",
  )
  debug_assert(srcset_descriptor_eq(c[0].descriptor, SrcsetDescriptor::Width(400)), "400w")
  debug_assert(
    c[1].url == "https://res.cloudinary.com/demo/image/upload/w_800,f_auto/sample.jpg",
    "internal commas preserved 1",
  )
  debug_assert(srcset_descriptor_eq(c[1].descriptor, SrcsetDescriptor::Width(800)), "800w")

  // Trailing commas without descriptors + leading/extra commas
  let c2 = parse_srcset(",,, https://cdn.test/a,b,c.jpg,,,  https://cdn.test/d,e.jpg 2x , , ")
  debug_assert(c2.length() == 2, "2 candidates with trailing commas")
  debug_assert(c2[0].url == "https://cdn.test/a,b,c.jpg", "trailing commas stripped, internal kept")
  debug_assert(srcset_descriptor_eq(c2[0].descriptor, SrcsetDescriptor::Density(1.0)), "comma-terminated defaults to 1x")
  debug_assert(c2[1].url == "https://cdn.test/d,e.jpg", "second url")
  debug_assert(srcset_descriptor_eq(c2[1].descriptor, SrcsetDescriptor::Density(2.0)), "second 2x")
}

///|
test "srcset_parse_parens_and_invalid_descriptors" {
  // Commas inside parentheses do NOT split the candidate per WHATWG §4.8.4.3.1
  let c1 = parse_srcset("bad.jpg (1, 2), good.jpg 2x")
  debug_assert(c1.length() == 1, "paren descriptor discarded, comma inside parens did not split")
  debug_assert(c1[0].url == "good.jpg", "good.jpg kept")
  debug_assert(srcset_descriptor_eq(c1[0].descriptor, SrcsetDescriptor::Density(2.0)), "good.jpg 2x")

  // Unclosed paren swallows rest of input
  let c2 = parse_srcset("bad.jpg (1, swallowed.jpg 2x")
  debug_assert(c2.length() == 0, "unclosed paren consumes to EOF")

  // Mixed, duplicate, zero-width, negative, uppercase, overflow-float, h-descriptor rules
  let c3 = parse_srcset(
    "zero.jpg 0w, neg.jpg -100w, frac.jpg 1.5w, upper.jpg 400W, dupw.jpg 400w 800w, " +
    "negx.jpg -2x, upperx.jpg 2X, dupx.jpg 1x 2x, mix.jpg 400w 2x, " +
    "honly.jpg 300h, hx.jpg 2x 300h, duph.jpg 400w 300h 200h, " +
    "infx.jpg 1e309x, " +
    "ok_wh.jpg 400w 300h, ok_x.jpg 3x, zerox.jpg 0x, negzero.jpg -0x, bigx.jpg 1e308x, bigw.jpg 2147483648w",
  )
  debug_assert(c3.length() == 6, "6 spec-valid candidates kept")
  debug_assert(c3[0].url == "ok_wh.jpg", "400w 300h valid per spec")
  debug_assert(srcset_descriptor_eq(c3[0].descriptor, SrcsetDescriptor::Width(400)), "400w")
  debug_assert(c3[1].url == "ok_x.jpg", "ok_x.jpg")
  debug_assert(srcset_descriptor_eq(c3[1].descriptor, SrcsetDescriptor::Density(3.0)), "3x")
  debug_assert(srcset_descriptor_eq(c3[2].descriptor, SrcsetDescriptor::Density(0.0)), "0x valid")
  debug_assert(srcset_descriptor_eq(c3[3].descriptor, SrcsetDescriptor::Density(0.0)), "-0x normalized to 0.0")
  debug_assert(srcset_descriptor_eq(c3[4].descriptor, SrcsetDescriptor::Density(1.0e308)), "1e308x valid")
  debug_assert(srcset_descriptor_eq(c3[5].descriptor, SrcsetDescriptor::Width(2147483647)), "2147483648w saturates to Int32 max")
}

///|
test "srcset_select_candidate_density_width_and_fallback" {
  // Density selection with fallback_src injected as 1x
  let c1 = parse_srcset("hi.jpg 2x, ultra.jpg 3x")
  match select_srcset_candidate(c1, "base.jpg", 400.0, 1.0) {
    Some(u) => debug_assert(u == "base.jpg", "fallback_src chosen at 1x")
    None => debug_assert(false, "expected base.jpg")
  }
  match select_srcset_candidate(c1, "base.jpg", 400.0, 2.0) {
    Some(u) => debug_assert(u == "hi.jpg", "hi.jpg chosen at 2x")
    None => debug_assert(false, "expected hi.jpg")
  }
  match select_srcset_candidate(c1, "base.jpg", 400.0, 4.0) {
    Some(u) => debug_assert(u == "ultra.jpg", "highest chosen above max dpr")
    None => debug_assert(false, "expected ultra.jpg")
  }

  // Geometric mean boundary: sqrt(1 * 2) = 1.414... -> dpr 1.2 picks 1x, dpr 1.5 picks 2x
  match select_srcset_candidate(c1, "base.jpg", 400.0, 1.2) {
    Some(u) => debug_assert(u == "base.jpg", "1.2 < sqrt(2) picks 1x")
    None => debug_assert(false, "expected base.jpg")
  }
  match select_srcset_candidate(c1, "base.jpg", 400.0, 1.5) {
    Some(u) => debug_assert(u == "hi.jpg", "1.5 > sqrt(2) picks 2x")
    None => debug_assert(false, "expected hi.jpg")
  }

  // Width selection: target_width = 400 -> 400w=1x, 800w=2x, 1200w=3x
  // fallback_src NOT injected when width descriptors exist
  let c2 = parse_srcset("w800.jpg 800w, w1200.jpg 1200w")
  match select_srcset_candidate(c2, "ignored.jpg", 400.0, 1.0) {
    Some(u) => debug_assert(u == "w800.jpg", "width candidates do not inject fallback_src")
    None => debug_assert(false, "expected w800.jpg")
  }
  match select_srcset_candidate(c2, "ignored.jpg", 400.0, 2.8) {
    Some(u) => debug_assert(u == "w1200.jpg", "w1200.jpg at dpr 2.8")
    None => debug_assert(false, "expected w1200.jpg")
  }

  // Duplicate density: first wins
  let c3 = parse_srcset("first.jpg 2x, second.jpg 2x")
  match select_srcset_candidate(c3, "", 400.0, 2.0) {
    Some(u) => debug_assert(u == "first.jpg", "duplicate density keeps first")
    None => debug_assert(false, "expected first.jpg")
  }

  // Empty candidates + empty fallback -> None
  match select_srcset_candidate([], "", 400.0, 1.0) {
    None => ()
    Some(_) => debug_assert(false, "empty must return None")
  }
}

///|
test "picture_source_selection_and_mime" {
  debug_assert(is_supported_image_mime(""), "empty mime allowed")
  debug_assert(is_supported_image_mime("image/webp"), "webp supported")
  debug_assert(is_supported_image_mime("IMAGE/AVIF; codecs=av01"), "avif with param supported")
  debug_assert(is_supported_image_mime("image/png"), "png supported")
  debug_assert(!is_supported_image_mime("image/jxl"), "jxl unsupported")
  debug_assert(!is_supported_image_mime("video/mp4"), "video unsupported")

  let sources = [
    PictureSource::{ srcset: "dark.jxl 1x", media_matches: true, mime_type: "image/jxl" },
    PictureSource::{ srcset: "wide.avif 1x, wide@2x.avif 2x", media_matches: false, mime_type: "image/avif" },
    PictureSource::{ srcset: "mobile.webp 1x, mobile@2x.webp 2x", media_matches: true, mime_type: "image/webp" },
    PictureSource::{ srcset: "later.png 1x", media_matches: true, mime_type: "image/png" },
  ]
  match select_picture_source(sources, "fb.jpg 1x", "fb.jpg", 400.0, 2.0) {
    Some(u) => debug_assert(u == "mobile@2x.webp", "first matching supported source wins")
    None => debug_assert(false, "expected mobile@2x.webp")
  }

  // When no source matches, fall back to img srcset / img src
  let no_match = [
    PictureSource::{ srcset: "wide.avif 1x", media_matches: false, mime_type: "image/avif" },
    PictureSource::{ srcset: "", media_matches: true, mime_type: "image/png" },
  ]
  match select_picture_source(no_match, "fb2x.jpg 2x", "fb1x.jpg", 400.0, 1.0) {
    Some(u) => debug_assert(u == "fb1x.jpg", "fallback to img src at 1x")
    None => debug_assert(false, "expected fb1x.jpg")
  }
  match select_picture_source(no_match, "fb2x.jpg 2x", "fb1x.jpg", 400.0, 2.0) {
    Some(u) => debug_assert(u == "fb2x.jpg", "fallback to img srcset at 2x")
    None => debug_assert(false, "expected fb2x.jpg")
  }
}

///|
test "srcset_dos_linear_scaling" {
  // 5,000 candidates + pathological commas and parens -> linear O(N), 0 panic
  let sb = StringBuilder::with_capacity(90000)
  let mut i = 0
  while i < 5000 {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string("img")
    sb.write_string(i.to_string())
    sb.write_string(".jpg ")
    sb.write_string((i + 1).to_string())
    sb.write_string("w")
    i = i + 1
  }
  let c = parse_srcset(sb.to_string())
  debug_assert(c.length() == 5000, "5000 candidates parsed")

  // Pathological unclosed parens + commas inside descriptor tokenizer -> 0 candidates, O(N), 0 panic
  let sb2 = StringBuilder::with_capacity(20010)
  sb2.write_string("a.jpg ")
  let mut j = 0
  while j < 10000 {
    sb2.write_string("(,")
    j = j + 1
  }
  let c2 = parse_srcset(sb2.to_string())
  debug_assert(c2.length() == 0, "pathological descriptor commas/parens safe")

  // Pathological commas without whitespace -> single URL candidate per WHATWG §4.8.4.3.1, O(N), 0 panic
  let sb3 = StringBuilder::with_capacity(20000)
  let mut k = 0
  while k < 10000 {
    sb3.write_string(",(")
    k = k + 1
  }
  let c3 = parse_srcset(sb3.to_string())
  debug_assert(c3.length() == 1, "pathological url commas/parens safe")
}
