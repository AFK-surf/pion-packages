///| Red-team differential probe for `packages/html` (batch, length-framed I/O).
///|
///| Input records: `<len>\n<bytes>` repeated. Output records: `<len>\n<bytes>` repeated.
///|   tree <in> <out> doc|frag : html5lib tree-construction dump of `Document::parse` / `parse_fragment`
///|   html <in> <out> doc|frag : `to_html()`
///|   san  <in> <out>          : `sanitize()`
///|   sanc <in> <out>          : `Sanitizer::default().set_strip_comments(false).clean()`
///|   sel  <in> <out>          : records come in pairs (selector, html); output = `ERR` or
///|                              space-separated pre-order element indices of matches (document order)
///|   one  <in> <mode> [reps]  : run one mode on the whole file `reps` times (DoS timing), print a summary

import "html"

///|
fn parse_dec(s : String, start : Int, end : Int) -> Int {
  let mut v = 0
  let mut i = start
  while i < end {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
fn read_records(src : String) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut i = 0
  while i < n {
    let ls = i
    while i < n && src.code_unit_at(i) != 10 {
      i = i + 1
    }
    let len = parse_dec(src, ls, i)
    i = i + 1
    out.push(src.slice(i, i + len))
    i = i + len
  }
  out
}

///|
fn emit(sb : StringBuilder, h : String) -> Unit {
  sb.write_string(h.length().to_string())
  sb.write_byte((10).to_byte())
  sb.write_string(h)
}

///|
fn indent(sb : StringBuilder, depth : Int) -> Unit {
  sb.write_string("| ")
  let mut i = 0
  while i < depth {
    sb.write_string("  ")
    i = i + 1
  }
}

///|
fn sort_attrs(a : Array[html::Attribute]) -> Unit {
  let mut i = 1
  while i < a.length() {
    let cur = a[i]
    let mut j = i - 1
    while j >= 0 && a[j].name > cur.name {
      a[j + 1] = a[j]
      j = j - 1
    }
    a[j + 1] = cur
    i = i + 1
  }
}

///| Iterative html5lib-format dump (pre-order, explicit stack).
fn dump_tree(doc : html::Document) -> String {
  let sb = StringBuilder::with_capacity(256)
  let stack_n : Array[html::Node] = []
  let stack_d : Array[Int] = []
  let kids = doc.root().children()
  let mut k = kids.length() - 1
  while k >= 0 {
    stack_n.push(kids[k])
    stack_d.push(0)
    k = k - 1
  }
  while stack_n.length() > 0 {
    let node = match stack_n.pop() {
      Some(x) => x
      None => break
    }
    let depth = match stack_d.pop() {
      Some(x) => x
      None => 0
    }
    if node.is_element() {
      indent(sb, depth)
      sb.write_string("<" + node.tag_name() + ">\n")
      let attrs = node.attributes()
      sort_attrs(attrs)
      let mut ai = 0
      while ai < attrs.length() {
        indent(sb, depth + 1)
        sb.write_string(attrs[ai].name + "=\"" + attrs[ai].value + "\"\n")
        ai = ai + 1
      }
      let ch = node.children()
      let mut c = ch.length() - 1
      while c >= 0 {
        stack_n.push(ch[c])
        stack_d.push(depth + 1)
        c = c - 1
      }
    } else if node.is_text() {
      indent(sb, depth)
      let t = match node.text() {
        Some(s) => s
        None => ""
      }
      sb.write_string("\"" + t + "\"\n")
    } else if node.is_comment() {
      indent(sb, depth)
      let t = match node.text() {
        Some(s) => s
        None => ""
      }
      sb.write_string("<!-- " + t + " -->\n")
    } else if node.is_doctype() {
      indent(sb, depth)
      let t = match node.text() {
        Some(s) => s
        None => ""
      }
      sb.write_string("<!DOCTYPE " + t + ">\n")
    }
  }
  sb.to_string()
}

///|
fn parse_mode(src : String, frag : Bool) -> Result[html::Document, html::HtmlError] {
  if frag {
    html::Document::parse_fragment(src)
  } else {
    html::Document::parse(src)
  }
}

///| Pre-order element index list of `doc`, used to name selector matches portably.
fn select_indices(doc : html::Document, matches : Array[html::Node]) -> String {
  let order : Map[Int, Int] = Map::new()
  let mut idx = 0
  let stack : Array[html::Node] = [doc.root()]
  while stack.length() > 0 {
    let node = match stack.pop() {
      Some(x) => x
      None => break
    }
    if node.is_element() {
      order.set(node.id, idx)
      idx = idx + 1
    }
    let ch = node.children()
    let mut c = ch.length() - 1
    while c >= 0 {
      stack.push(ch[c])
      c = c - 1
    }
  }
  let sb = StringBuilder::with_capacity(64)
  let mut i = 0
  while i < matches.length() {
    if i > 0 {
      sb.write_byte((32).to_byte())
    }
    match order.get(matches[i].id) {
      Some(v) => sb.write_string(v.to_string())
      None => sb.write_string("?")
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn run_one(mode : String, frag : Bool, rec : String) -> String {
  if mode == "tree" {
    match parse_mode(rec, frag) {
      Ok(d) => dump_tree(d)
      Err(e) => "ERR " + e.to_string()
    }
  } else if mode == "html" {
    match parse_mode(rec, frag) {
      Ok(d) => d.to_html()
      Err(e) => "ERR " + e.to_string()
    }
  } else if mode == "san" {
    html::sanitize(rec)
  } else if mode == "sanc" {
    html::Sanitizer::default().set_strip_comments(false).clean(rec)
  } else {
    "ERR unknown mode"
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: probe tree|html|san|sel|one <in> ...")
    return 2
  }
  let mode = args[1]
  let src = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "read failed")
      return 1
    }
  }
  if mode == "one" {
    // one <in> tree|html|san|parse|frag|sel:<selector> [reps]
    // `sel:` parses the document once and times only `reps` compiled-selector queries.
    let sub = args[3]
    let reps = if args.length() > 4 {
      parse_dec(args[4], 0, args[4].length())
    } else {
      1
    }
    let mut total = 0
    if sub.length() > 4 && sub.slice(0, 4) == "sel:" {
      let s = sub.slice(4, sub.length())
      let d = match html::Document::parse(src) {
        Ok(d) => d
        Err(e) => {
          io_println(world, "ERR " + e.to_string())
          return 0
        }
      }
      let compiled = match html::Selector::parse(s) {
        Ok(c) => c
        Err(e) => {
          io_println(world, "ERR " + e.to_string())
          return 0
        }
      }
      let mut r = 0
      while r < reps {
        total = total + d.select_compiled(compiled).length()
        r = r + 1
      }
      io_println(world, "ok " + total.to_string())
      return 0
    }
    let mut r = 0
    while r < reps {
      if sub == "parse" || sub == "frag" {
        match parse_mode(src, sub == "frag") {
          Ok(d) => total = total + d.node_count()
          Err(e) => {
            io_println(world, "ERR " + e.to_string())
            return 0
          }
        }
      } else {
        total = total + run_one(sub, false, src).length()
      }
      r = r + 1
    }
    io_println(world, "ok " + total.to_string())
    return 0
  }
  let out_path = args[3]
  let frag = args.length() > 4 && args[4] == "frag"
  let recs = read_records(src)
  let out = StringBuilder::with_capacity(src.length() * 2 + 64)
  if mode == "sel" {
    let mut i = 0
    while i + 1 < recs.length() {
      let res = match html::Document::parse(recs[i + 1]) {
        Ok(d) =>
        match d.select(recs[i]) {
          Ok(v) => select_indices(d, v)
          Err(_) => "ERR"
        }
        Err(_) => "ERR parse"
      }
      emit(out, res)
      i = i + 2
    }
  } else {
    let mut i = 0
    while i < recs.length() {
      emit(out, run_one(mode, frag, recs[i]))
      i = i + 1
    }
  }
  match fs_write(world, out_path, out.to_string()) {
    Ok(_) => 0
    Err(_) => {
      io_eprintln(world, "write failed")
      1
    }
  }
}
