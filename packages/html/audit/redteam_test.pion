///| Red-team regression tests for packages/html @ 0df3d6c (branch feat/pkg-html).
///
/// `p1_*` / `p2_*` tests assert what the reference implementations do (Rust scraper =0.22.0 /
/// html5ever 0.29.1, ammonia =4.0.0, WHATWG HTML / CSS Selectors); every expected string below
/// was produced by `rust/` (the oracle) — a FAILURE here is the evidence.
/// `control_*` tests are attacks Pion survived (some where Pion is stricter than ammonia or
/// more robust than scraper); they must keep passing.
/// Timing-only findings (exponential selector backtracking, quadratic end-tag scans) cannot be a
/// unit test that must finish quickly; they are reproduced by run_audit.sh (scripts/dos.py).

import "html"

///|
fn frag_html(src : String) -> String {
  match html::Document::parse_fragment(src) {
    Ok(d) => d.to_html()
    Err(e) => "ERR " + e.to_string()
  }
}

///|
fn doc_html(src : String) -> String {
  match html::Document::parse(src) {
    Ok(d) => d.to_html()
    Err(e) => "ERR " + e.to_string()
  }
}

///|
fn contains(hay : String, needle : String) -> Bool {
  let n = hay.length()
  let m = needle.length()
  let mut i = 0
  while i + m <= n {
    if hay.slice(i, i + m) == needle {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::with_capacity(s.length() * n + 1)
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn sel_count(doc_src : String, css : String) -> Int {
  match html::Document::parse(doc_src) {
    Ok(d) =>
    match d.select(css) {
      Ok(v) => v.length()
      Err(_) => -1
    }
    Err(_) => -2
  }
}

// ===========================================================================
// F-1 (P1) Sanitizer configuration footgun: `add_tags(["script"])` / `add_tags(["style"])`
// silently removes the tag from clean_content_tags and emits it with attacker text inside.
// ammonia 4.0.0 refuses this configuration (`assert!(!self.tags.contains(tag_name))` for every
// clean-content tag, lib.rs:1790) — script/style can only be allowed by an explicit
// `rm_clean_content_tags` call. In Pion one innocent-looking call yields stored XSS.
// ===========================================================================

///|
test "p1_add_tags_script_yields_executable_script" {
  let out = html::Sanitizer::default().add_tags(["script"]).clean("<script>alert(document.cookie)</script>")
  // Pion: "<script>alert(document.cookie)</script>"  (executes in every browser)
  debug_assert(!contains(out, "<script"), "add_tags([script]) must not produce executable <script>: " + out)
}

///|
test "p1_add_tags_style_yields_css_injection" {
  let out = html::Sanitizer::default().add_tags(["style"]).clean("<style>body{background:url(https://evil.test/x)}</style>")
  debug_assert(!contains(out, "<style"), "add_tags([style]) must not produce a live <style>: " + out)
}

// ===========================================================================
// F-2 (P1) Adoption-agency clone amplification (no Noah's-Ark / no 8x3 loop bound).
// "<i>"*500 + "<b>"*500 + "</i>"*500 = 5,000 bytes. html5ever builds 1,004 nodes and ammonia
// emits 7,000 bytes; Pion re-opens every <b> on every </i> -> 251,004 nodes, 31 MB RSS, and
// sanitize() emits 1,757,000 bytes (351x amplification). At 1000x1000 (8 KB) Pion hits
// max_nodes and sanitize() silently returns "" (see P2-1).
// ===========================================================================

///|
test "p1_adoption_agency_node_amplification" {
  let src = repeat("<i>", 500) + repeat("<b>", 500) + repeat("</i>", 500)
  let n = match html::Document::parse(src) {
    Ok(d) => d.node_count()
    Err(_) => -1
  }
  // html5ever: 1004 nodes
  debug_assert(n > 0 && n < 10000, "5 KB input must not build " + n.to_string() + " nodes (html5ever: 1004)")
}

///|
test "p1_adoption_agency_sanitize_output_blowup" {
  let src = repeat("<i>", 500) + repeat("<b>", 500) + repeat("</i>", 500)
  let out = html::sanitize(src)
  // ammonia: 7000 bytes
  debug_assert(out.length() < 50000, "sanitize(5 KB) produced " + out.length().to_string() + " bytes (ammonia: 7000)")
}

///|
test "p1_adoption_agency_limit_wipes_sanitized_output" {
  let src = "<p>important user text</p>" + repeat("<i>", 1000) + repeat("<b>", 1000) + repeat("</i>", 1000)
  let out = html::sanitize(src)
  debug_assert(contains(out, "important user text"), "8 KB input must not make sanitize() return empty: len=" + out.length().to_string())
}

// ===========================================================================
// F-3 (P1) Tokenizer differentials: Pion's tree differs from every browser's for the same bytes,
// so markup that is inert in the browser becomes live elements in Pion's DOM / sanitize output
// (content smuggling), and vice versa.
// ===========================================================================

///|
test "p1_end_tag_attributes_hide_markup" {
  // WHATWG: end tags are tokenized with attributes, `>` inside a quoted value does not end them.
  // html5ever / ammonia: "" ; Pion: "<img src=\"x\">\"&gt;"
  debug_assert(frag_html("</div title=\"><img src=x>\">") == "", "end-tag attribute value must swallow the <img>")
  debug_assert(html::sanitize("</div title=\"><img src=x>\">") == "", "sanitize must agree with ammonia")
}

///|
test "p1_script_double_escaped_state_missing" {
  // html5ever keeps everything inside the script (script data double escaped state).
  let src = "<script><!--<script></script><img src=x>--></script>"
  debug_assert(html::sanitize(src) == "", "ammonia: \"\"; Pion smuggles <img> out of a script: " + html::sanitize(src))
  debug_assert(frag_html("<script><!--<script></script>x--></script>") == "<script><!--<script></script>x--></script>", "html5ever serialization")
}

///|
test "p1_eof_in_tag_drops_token" {
  // WHATWG: EOF in a tag emits nothing. html5ever / ammonia: ""
  debug_assert(html::sanitize("<img src=x onerror=alert(1)//") == "", "EOF-in-tag must drop the token: " + html::sanitize("<img src=x onerror=alert(1)//"))
}

// ===========================================================================
// F-4 (P1) Tree construction: html5lib-tests tree-construction pass rate is 44.17% (697/1578)
// vs html5ever 92.46% / Go x/net/html 96.20% (scripts/html5lib_suite.py). Representative cases:
// ===========================================================================

///|
test "p1_tree_foster_parenting" {
  debug_assert(frag_html("<table>foo<tr><td>bar</td></tr></table>") == "foo<table><tbody><tr><td>bar</td></tr></tbody></table>", "foster parenting")
}

///|
test "p1_tree_stray_p_end_tag" {
  debug_assert(frag_html("</p>") == "<p></p>", "</p> without open <p> inserts an empty <p>")
}

///|
test "p1_tree_reconstruct_active_formatting" {
  debug_assert(frag_html("<p><b>x</p>y") == "<p><b>x</b></p><b>y</b>", "reconstruct active formatting elements")
}

///|
test "p1_tree_adoption_agency_furthest_block" {
  debug_assert(frag_html("<b><p>x</b>y</p>") == "<b></b><p><b>x</b>y</p>", "adoption agency with furthest block")
  debug_assert(frag_html("<b>1<p>2</b>3") == "<b>1</b><p><b>2</b>3</p>", "adoption agency with furthest block (2)")
}

///|
test "p1_tree_nested_a_nobr_form_button" {
  debug_assert(frag_html("<a>1<a>2") == "<a>1</a><a>2</a>", "<a> inside <a> closes the first")
  debug_assert(frag_html("<nobr>a<nobr>b") == "<nobr>a</nobr><nobr>b</nobr>", "<nobr> inside <nobr>")
  debug_assert(frag_html("<form><form>x") == "<form>x</form>", "nested <form> ignored")
  debug_assert(frag_html("<button><p>x<button>y") == "<button><p>x</p></button><button>y</button>", "nested <button>")
}

///|
test "p1_tree_end_tag_scope" {
  // </div> must not close through a table cell
  debug_assert(frag_html("<div><table><tr><td></div>x</td></tr></table>") == "<div><table><tbody><tr><td>x</td></tr></tbody></table></div>", "end tag must respect table scope")
}

///|
test "p1_tree_after_body_and_after_html" {
  debug_assert(doc_html("<html><body>a</body></html><p>x") == "<html><head></head><body>a<p>x</p></body></html>", "content after </html> belongs in <body>, not after the root")
  debug_assert(doc_html("<body>a</body><p>x") == "<html><head></head><body>a<p>x</p></body></html>", "content after </body> belongs in <body>")
}

///|
test "p1_tree_head_after_head" {
  debug_assert(doc_html("<head></head><style>s</style><body>b") == "<html><head><style>s</style></head><body>b</body></html>", "<style> after </head> goes into <head>")
}

///|
test "p1_tree_html_body_attribute_merge_and_frameset" {
  debug_assert(doc_html("<body a=1><body b=2>x") == "<html><head></head><body a=\"1\" b=\"2\">x</body></html>", "second <body> merges attributes")
  debug_assert(doc_html("<frameset><frame></frameset>") == "<html><head></head><frameset><frame></frameset></html>", "frameset")
}

///|
test "p1_tree_textarea_pre_leading_newline" {
  debug_assert(frag_html("<textarea>\nfoo</textarea>") == "<textarea>foo</textarea>", "leading LF in <textarea> is dropped")
  debug_assert(frag_html("<pre>\n\nfoo</pre>") == "<pre>\nfoo</pre>", "first LF in <pre> is dropped")
}

///|
test "p1_tree_br_end_tag_and_image" {
  debug_assert(frag_html("</br>") == "<br>", "</br> is a <br>")
  debug_assert(frag_html("<image src=x>") == "<img src=\"x\">", "<image> is <img>")
}

///|
test "p1_tree_foreign_content_case" {
  debug_assert(frag_html("<svg viewBox=\"0 0 1 1\"><foreignObject></foreignObject></svg>") == "<svg viewBox=\"0 0 1 1\"><foreignObject></foreignObject></svg>", "SVG camelCase tag/attribute adjustment")
}

///|
test "p2_text_nul_and_raw_cr" {
  debug_assert(frag_html("a\u{0}b") == "ab", "NUL in body text is dropped")
  debug_assert(frag_html("<script>a\r\nb</script>") == "<script>a\nb</script>", "CR LF normalized in RAWTEXT too")
}

///|
test "p2_sanitize_emits_raw_nul_in_attributes" {
  // WHATWG: NUL in an attribute value becomes U+FFFD. ammonia: title="a\u{FFFD}b"
  let out = html::sanitize("<a title=\"a\u{0}b\">x</a>")
  debug_assert(!contains(out, "\u{0}"), "sanitize must not emit a raw NUL byte")
}

// ===========================================================================
// F-5 (P1) Named character references: 1,955 / 2,231 WHATWG entries (87.6%) are not decoded
// (scripts/entities.py), including multi-code-point references.
// ===========================================================================

///|
test "p1_entities_missing" {
  debug_assert(frag_html("&rarr;&hellip;&Aacute;&check;&NotEqualTilde;&fjlig;") == "→…Á✓≂̸fj", "WHATWG named references: " + frag_html("&rarr;&hellip;&Aacute;&check;&NotEqualTilde;&fjlig;"))
  debug_assert(frag_html("&Aacute &aacute ") == "Á á ", "legacy no-semicolon references in text")
}

// ===========================================================================
// F-6 (P1) CSS selector engine vs scraper (scripts/css_diff.py: 22 / 141 differ).
// ===========================================================================

///|
let sel_doc : String = "<!DOCTYPE html><html lang=\"en-US\"><body><div id=\"main\"><ul><li lang=\"en\">1</li><li lang=\"en-GB\">2</li><li>3</li></ul><p id=\"123\">d</p><input type=\"TEXT\"><em>e</em></div></body></html>"

///|
test "p1_css_hex_escapes" {
  debug_assert(sel_count(sel_doc, "#\\31 23") == 1, "#\\31 23 is id=\"123\" (CSS hex escape)")
  debug_assert(sel_count(sel_doc, "#\\31\\32\\33") == 1, "#\\31\\32\\33 is id=\"123\"")
}

///|
test "p1_css_invalid_selectors_accepted" {
  debug_assert(sel_count(sel_doc, "#123") == -1, "#123 is not a valid ID selector (ident cannot start with a digit)")
  debug_assert(sel_count(sel_doc, ".1a") == -1, ".1a is invalid")
  debug_assert(sel_count(sel_doc, "123") == -1, "123 is not a type selector")
}

///|
test "p1_css_html_case_insensitive_attribute_values" {
  // Selectors 4 §6.3 / HTML: lang, type, ... values match ASCII case-insensitively in HTML docs.
  debug_assert(sel_count(sel_doc, "[lang|=EN]") == 3, "[lang|=EN] (scraper: html, li, li)")
  debug_assert(sel_count(sel_doc, "[type=text]") == 1, "[type=text] matches type=TEXT")
}

///|
test "p1_css_missing_structural_pseudos" {
  debug_assert(sel_count(sel_doc, "li:nth-last-child(1)") == 1, ":nth-last-child")
  debug_assert(sel_count(sel_doc, "li:nth-of-type(2)") == 1, ":nth-of-type")
  debug_assert(sel_count(sel_doc, "em:only-of-type") == 1, ":only-of-type")
  debug_assert(sel_count(sel_doc, ":is(em, p)") == 2, ":is()")
  debug_assert(sel_count(sel_doc, "div:has(em)") == 1, ":has()")
}

// ===========================================================================
// P2-1 Failure is silent: Sanitizer::clean returns "" on any LimitExceeded, e.g. 250 KB of
// "<table><tr><td>" (depth 4 per repetition > max_depth 65536). html5ever/ammonia succeed.
// ===========================================================================

///|
test "p2_sanitize_silently_empties_on_limit" {
  let src = "<p>keep me</p>" + repeat("<table><tr><td>", 16666)
  debug_assert(contains(html::sanitize(src), "keep me"), "sanitize must not silently drop all content")
}

///|
test "p2_sanitizer_scheme_allowlist_narrower_than_ammonia" {
  // ammonia default url_schemes has 25 schemes (tel, ftp, sms, xmpp, ...); Pion keeps 3.
  let out = html::sanitize("<a href=\"tel:123\">t</a>")
  debug_assert(contains(out, "href=\"tel:123\""), "tel: links are allowed by ammonia's defaults: " + out)
}

// ===========================================================================
// Controls: attacks Pion survived. Must keep passing.
// ===========================================================================

///|
test "control_classic_mxss_vectors_neutralised" {
  let vs = [
    "<form><math><mtext></form><form><mglyph><style></math><img src onerror=alert(1)>",
    "<noscript><p title=\"</noscript><img src=x onerror=alert(1)>\">",
    "<math><mtext><table><mglyph><style><!--</style><img title=\"--&gt;&lt;img src=1 onerror=alert(1)&gt;\">",
    "<svg><desc><![CDATA[</desc><script>alert(1)</script>]]></svg>",
    "<style><!--</style><script>alert(1)</script>",
    "<iframe srcdoc=\"<script>alert(1)</script>\"></iframe>",
    "<textarea></textarea><script>alert(1)</script></textarea>",
    "<!--a--!><img src=x onerror=alert(1)>-->",
    "<svg></p><style><a id=\"</style><img src=1 onerror=alert(1)>\">",
  ]
  let mut i = 0
  while i < vs.length() {
    let out = html::sanitize(vs[i])
    debug_assert(!contains(out, "onerror") && !contains(out, "<script") && !contains(out, "<svg") && !contains(out, "<math"), "mXSS vector leaked: " + out)
    let keep = html::Sanitizer::default().set_strip_comments(false).clean(vs[i])
    debug_assert(!contains(keep, "onerror=") && !contains(keep, "<script"), "keep-comments leaked: " + keep)
    i = i + 1
  }
}

///|
test "control_url_scheme_obfuscations_blocked" {
  let vs = [
    "<a href=\"&#x09;javascript:alert(1)\">x</a>", "<a href=\"java&#x0A;script:alert(1)\">x</a>",
    "<a href=\"&#0000106;avascript:alert(1)\">x</a>", "<a href=\"JaVaScRiPt:alert(1)\">x</a>",
    "<a href=\"javascript&colon;alert(1)\">x</a>", "<a href=\"vbscript:msgbox(1)\">x</a>",
    "<a href=\"data:text/html;base64,PHNjcmlwdD4=\">x</a>", "<img src=\"javascript:alert(1)\">",
    "<a href=\"https://ok\" href=\"javascript:alert(1)\">x</a>", "<area href=\"javascript:alert(1)\">",
    "<a href=\"\u{0}javascript:alert(1)\">x</a>", "<a href=\"java\tscript:alert(1)\">x</a>",
  ]
  let mut i = 0
  while i < vs.length() {
    let out = html::sanitize(vs[i])
    debug_assert(!contains(out, "javascript:") && !contains(out, "vbscript:") && !contains(out, "data:"), "scheme leaked: " + out)
    i = i + 1
  }
}

///|
test "control_pion_stricter_than_ammonia_on_cite" {
  // ammonia 4.0.0 keeps cite="javascript:..." (cite is not in its is_url_attr); Pion drops it.
  debug_assert(html::sanitize("<blockquote cite=\"javascript:alert(1)\">q</blockquote>") == "<blockquote>q</blockquote>", "cite checked")
}

///|
test "control_explicit_on_attrs_still_blocked" {
  let out = html::Sanitizer::default().add_generic_attributes(["onclick"]).clean("<p onclick=\"alert(1)\">x</p>")
  debug_assert(!contains(out, "onclick"), "on* handlers are never emitted")
}

///|
test "control_attribute_escaping" {
  let out = html::sanitize("<a title='a\"b' >x</a><p title=\"&quot;&gt;&lt;img src=x onerror=alert(1)&gt;\">y</p>")
  debug_assert(out == "<a title=\"a&quot;b\" rel=\"noopener noreferrer\">x</a><p title=\"&quot;><img src=x onerror=alert(1)>\">y</p>", out)
}

///|
test "control_legacy_entity_attribute_rule" {
  debug_assert(frag_html("<a title=\"&copy=1&copy;=1&notit;\"></a>") == "<a title=\"&amp;copy=1©=1&amp;notit;\"></a>", frag_html("<a title=\"&copy=1&copy;=1&notit;\"></a>"))
}

///|
test "control_deep_not_nesting_rejected_not_crashing" {
  // scraper/selectors 0.22 aborts the process (stack overflow) on 20k nested :not(); Pion errors.
  let css = repeat(":not(", 20000) + "p" + repeat(")", 20000)
  debug_assert(sel_count("<p>x</p>", css) == -1, "deep :not() must be a clean error")
}

///|
test "control_rawtext_not_escaped_and_void_no_end_tag" {
  debug_assert(frag_html("<style>a>b{}</style><script>if(a<b&&c)x()</script><br><img src=x>") == "<style>a>b{}</style><script>if(a<b&&c)x()</script><br><img src=\"x\">", "raw text kept verbatim")
}
