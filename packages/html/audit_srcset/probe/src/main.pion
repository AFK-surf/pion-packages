///| Self-contained DoS / no-panic probe for `parse_srcset` / `select_srcset_candidate` /
///| `select_picture_source`, identical on Native and wasm32 (the wasm runtime has no
///| stdin, so inputs are generated in-process).
///| Prints `shape<TAB>n<TAB>ms<TAB>result` per run; a panic aborts with a non-zero exit.

import "html"

///|
fn repeat(prefix : String, unit : String, n : Int) -> String {
  let sb = StringBuilder::with_capacity(prefix.length() + unit.length() * n)
  sb.write_string(prefix)
  let mut i = 0
  while i < n {
    sb.write_string(unit)
    i = i + 1
  }
  sb.to_string()
}

///| `a0 <n>x, a1 <n-1>x, ...` (descending densities: worst case for insertion sort)
fn desc_densities(n : Int) -> String {
  let sb = StringBuilder::with_capacity(n * 16)
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string("a")
    sb.write_string(i.to_string())
    sb.write_string(" ")
    sb.write_string((n - i).to_string())
    sb.write_string("x")
    i = i + 1
  }
  sb.to_string()
}

///|
fn run_parse(world : World, name : String, n : Int, input : String) -> Unit {
  let t0 = clock_now_ms(world)
  let c = html::parse_srcset(input).length()
  let t1 = clock_now_ms(world)
  io_print(world, name + "\t" + n.to_string() + "\t" + (t1 - t0).to_string() + "\tcandidates=" + c.to_string() + "\n")
}

///|
fn run_select(world : World, name : String, n : Int, input : String) -> Unit {
  let t0 = clock_now_ms(world)
  let r = match html::select_picture_source(
    [html::PictureSource::{ srcset: input, media_matches: true, mime_type: "image/webp" }],
    "",
    "fb.jpg",
    1000.0,
    2.0,
  ) {
    Some(u) => u
    None => "<none>"
  }
  let t1 = clock_now_ms(world)
  io_print(world, name + "\t" + n.to_string() + "\t" + (t1 - t0).to_string() + "\tpick=" + r + "\n")
}

///|
pub fn main(world : World) -> Int {
  let n = 100000
  run_parse(world, "parse-commas", n, repeat("", ",", n))
  run_parse(world, "parse-spaces", n, repeat("", " ", n))
  run_parse(world, "parse-open-parens", n, repeat("a ", "(", n))
  run_parse(world, "parse-close-parens", n, repeat("a ", ")", n))
  run_parse(world, "parse-balanced-parens", n, repeat("a ", "()", n / 2))
  run_parse(world, "parse-comma-urls", n, repeat("", "a,", n))
  run_parse(world, "parse-descriptors", n, repeat("a", " 1x", n))
  run_parse(world, "parse-candidates", n, repeat("", "a 2x, ", n))
  run_select(world, "select-same-density", n, repeat("", "a 2x, ", n))
  // S-2: quadratic dedupe + insertion sort in select_srcset_candidate (n vs 4n)
  run_select(world, "select-desc-densities", 2500, desc_densities(2500))
  run_select(world, "select-desc-densities", 10000, desc_densities(10000))
  0
}
