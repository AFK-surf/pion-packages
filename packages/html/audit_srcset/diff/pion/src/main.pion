///| Differential driver for the `srcset` red-team audit (Pion side).
///| One case per stdin line: the srcset attribute value as lowercase hex bytes.
///| One output line per case: TAB-separated candidates, each `hex(url) SP w<int>|x<double>`
///| (an empty line means zero candidates). Same protocol as `../ref/srcset_ref.py`.
///| A line prefixed with `s` instead runs `select_srcset_candidate(parse_srcset(v), "fb.jpg",
///| 1000.0, 2.0)` and prints `hex(chosen url)` or `-` (used by the DoS probes).

import "html"

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn unhex(s : String) -> String {
  let n = s.length() / 2
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    let b = hexval(s.code_unit_at(2 * i)) * 16 + hexval(s.code_unit_at(2 * i + 1))
    sb.write_byte(b.to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn write_hex_str(sb : StringBuilder, s : String) -> Unit {
  let digits = "0123456789abcdef"
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    sb.write_byte(digits.code_unit_at(b / 16).to_byte())
    sb.write_byte(digits.code_unit_at(b % 16).to_byte())
    i = i + 1
  }
}

///|
pub fn main(world : World) -> Int {
  let mut sb = StringBuilder::with_capacity(1 << 20)
  while true {
    let line = match io_read_line(world) {
      Some(l) => l
      None => break
    }
    if line.length() > 0 && line.code_unit_at(0) == 115 {
      let cands = html::parse_srcset(unhex(line.slice(1, line.length())))
      match html::select_srcset_candidate(cands, "fb.jpg", 1000.0, 2.0) {
        Some(u) => write_hex_str(sb, u)
        None => sb.write_string("-")
      }
      sb.write_byte((10).to_byte())
      continue
    }
    let cands = html::parse_srcset(unhex(line))
    let mut i = 0
    while i < cands.length() {
      if i > 0 {
        sb.write_byte((9).to_byte())
      }
      write_hex_str(sb, cands[i].url)
      match cands[i].descriptor {
        html::SrcsetDescriptor::Width(w) => {
          sb.write_string(" w")
          sb.write_string(w.to_string())
        }
        html::SrcsetDescriptor::Density(x) => {
          sb.write_string(" x")
          sb.write_string(x.to_string())
        }
      }
      i = i + 1
    }
    sb.write_byte((10).to_byte())
    if sb.length() > (1 << 20) {
      io_print(world, sb.to_string())
      sb = StringBuilder::with_capacity(1 << 20)
    }
  }
  io_print(world, sb.to_string())
  0
}
