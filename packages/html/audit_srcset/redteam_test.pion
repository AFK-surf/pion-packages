///| Red-team tests for `packages/html/src/srcset.pion` @ 67385f72 (feat/enrich-url-html).
///
/// Oracle: WHATWG HTML §4.8.4.3.10 "parse a srcset attribute" and §4.8.4.3.5 "update the
/// source set", ported line by line to `diff/ref/srcset_ref.py` (20,082-case differential
/// incl. 20k seeded fuzz, see ../REPORT.md). `redteam_*` = a FAILURE is the evidence;
/// `control_*` = attacks the implementation survived; they must keep passing.
/// The quadratic-time finding (S-2) is reproduced with timings by `../run_audit.sh`.

// ---------------------------------------------------------------------------
// S-1 (P1) select_picture_source: a matching <source> whose srcset parses to ZERO
// candidates is selected anyway and returns None. Spec (update the source set, step
// "If source set has zero image sources, continue to the next child"): skip it and
// fall through to the next <source>, then to <img srcset>/<img src>. Real pages hit
// this with a typo'd / unsupported descriptor (`a.webp 0w`, `a.avif 1x 2x`): the
// whole <picture> renders no image at all instead of the <img> fallback.
// ---------------------------------------------------------------------------

///|
test "redteam_picture_source_with_no_valid_candidate_falls_through" {
  let got = pick_picture(
    [source("hero.avif 0w", "image/avif"), source("hero.webp 1x", "image/webp")],
    "",
    "hero.jpg",
  )
  expect_eq(got, "hero.webp", "invalid first <source> must be skipped")
}

///|
test "redteam_picture_all_sources_invalid_uses_img_fallback" {
  expect_eq(
    pick_picture([source(",,, ,", "image/webp"), source("a.webp 1x 2x", "")], "", "img.jpg"),
    "img.jpg",
    "fall back to <img src>",
  )
}

// ---------------------------------------------------------------------------
// S-3 (P2) numeric descriptor edges disagree with the spec's parsing rules.
//  - `0x` / `0.0x` / `-0x` / `1e-400x`: spec only errors when density < 0
//    ("If density is 0, the natural dimensions will be infinite") — Pion drops it.
//  - `1e308x` / `1.5e308x`: finite doubles; spec only errors on ±2^1024 — Pion
//    rejects everything >= 1e308.
//  - `2147483648w` and larger: valid non-negative integers — Pion rejects (Int32
//    overflow guard drops the candidate instead of saturating).
// ---------------------------------------------------------------------------

///|
test "redteam_zero_density_is_a_valid_candidate" {
  expect_eq(show("a.jpg 0x"), "a.jpg x0", "0x")
  expect_eq(show("a.jpg -0x"), "a.jpg x0", "-0x")
  expect_eq(show("a.jpg 1e-400x"), "a.jpg x0", "underflow to 0")
}

///|
test "redteam_large_finite_density_is_valid" {
  expect_eq(show("a.jpg 1e308x"), "a.jpg x1e+308", "1e308x")
}

///|
test "redteam_width_above_int32_is_valid" {
  debug_assert(html::parse_srcset("a.jpg 2147483648w").length() == 1, "2147483648w dropped")
}

// ---------------------------------------------------------------------------
// Controls: tokenizer state machine (all agree with the spec reference)
// ---------------------------------------------------------------------------

///|
test "control_commas_in_and_after_urls" {
  expect_eq(
    show("https://cdn/w_400,f_auto/a.jpg 400w"),
    "https://cdn/w_400,f_auto/a.jpg w400",
    "comma inside URL",
  )
  expect_eq(show("a.jpg, b.jpg"), "a.jpg x1 | b.jpg x1", "trailing comma")
  expect_eq(show("a.jpg,b.jpg"), "a.jpg,b.jpg x1", "no space: one URL")
  expect_eq(show(",,,a.jpg,,,"), "a.jpg x1", ",,,a.jpg,,,")
  expect_eq(show(",,,"), "", "only commas")
  expect_eq(show(" \t\n\x0c\r"), "", "only whitespace")
  expect_eq(show(""), "", "empty")
  expect_eq(show("a.jpg\x0b2x"), "a.jpg\x0b2x x1", "VT is not whitespace")
}

///|
test "control_parenthesised_descriptors" {
  expect_eq(show("a.jpg (100w, 200w) 2x"), "", "parens with comma: error drops candidate")
  expect_eq(show("a.jpg (abc, b.jpg 2x"), "", "unclosed paren eats the rest")
  expect_eq(show("a.jpg ((a)) 2x"), "", "nested parens")
  expect_eq(show("a.jpg 100w (x), b.jpg 2x"), "b.jpg x2", "paren descriptor drops only its candidate")
}

///|
test "control_descriptor_validation" {
  expect_eq(show("a.jpg 0w"), "", "0w")
  expect_eq(show("a.jpg -100w"), "", "-100w")
  expect_eq(show("a.jpg 1.5w"), "", "1.5w")
  expect_eq(show("a.jpg +100w"), "", "+100w")
  expect_eq(show("a.jpg 0100w"), "a.jpg w100", "leading zeros")
  expect_eq(show("a.jpg -2x"), "", "-2x")
  expect_eq(show("a.jpg NaNx"), "", "NaNx")
  expect_eq(show("a.jpg Infinityx"), "", "Infinityx")
  expect_eq(show("a.jpg 1e309x"), "", "1e309x overflows")
  expect_eq(show("a.jpg 1.x"), "", "1.x")
  expect_eq(show("a.jpg .5x"), "a.jpg x0.5", ".5x")
  expect_eq(show("a.jpg 2X"), "", "uppercase X")
  expect_eq(show("a.jpg 100w 2x"), "", "w + x")
  expect_eq(show("a.jpg 2x 100w"), "", "x + w")
  expect_eq(show("a.jpg 100w 200w"), "", "w twice")
  expect_eq(show("a.jpg 1x 2x"), "", "x twice")
  expect_eq(show("a.jpg 100w 50h"), "a.jpg w100", "w + h")
  expect_eq(show("a.jpg 50h"), "", "h alone")
  expect_eq(show("a.jpg 2x 50h"), "", "x + h")
}

// ---------------------------------------------------------------------------
// Controls: selection inputs
// ---------------------------------------------------------------------------

///|
test "control_select_degenerate_inputs" {
  expect_eq(pick("", "", 800.0, 1.0), "<none>", "no candidates, no fallback")
  expect_eq(pick("", "fb.jpg", 800.0, 1.0), "fb.jpg", "fallback only")
  expect_eq(pick("a.jpg 2x", "fb.jpg", 800.0, 0.0), "fb.jpg", "dpr 0 -> 1")
  expect_eq(pick("a.jpg 2x", "fb.jpg", 800.0, -3.0), "fb.jpg", "dpr < 0 -> 1")
  expect_eq(pick("a.jpg 2x", "fb.jpg", 800.0, 0.0 / 0.0), "fb.jpg", "dpr NaN -> 1")
  expect_eq(pick("a.jpg 2x", "fb.jpg", 800.0, 1.0 / 0.0), "a.jpg", "dpr +inf -> largest")
  expect_eq(pick("s.jpg 700w, l.jpg 1600w", "fb.jpg", 800.0, 1.0), "s.jpg", "w: geometric-mean rule")
  expect_eq(pick("s.jpg 700w, l.jpg 1600w", "fb.jpg", 800.0, 2.0), "l.jpg", "w at 2x")
  expect_eq(pick("s.jpg 400w, l.jpg 1600w", "", 0.0, 1.0), "s.jpg", "target 0: no panic")
  expect_eq(pick("s.jpg 400w, l.jpg 1600w", "", -1.0, 1.0), "s.jpg", "target < 0: no panic")
  expect_eq(pick("s.jpg 400w, l.jpg 1600w", "", 0.0 / 0.0, 1.0), "s.jpg", "target NaN: no panic")
}

///|
test "control_picture_mime_types" {
  debug_assert(html::is_supported_image_mime("IMAGE/WEBP"), "uppercase")
  debug_assert(html::is_supported_image_mime(" image/webp ; charset=x"), "params")
  debug_assert(!html::is_supported_image_mime("image/webp foo"), "junk after type")
  debug_assert(!html::is_supported_image_mime("image/jxl"), "unsupported")
  debug_assert(!html::is_supported_image_mime("text/html"), "not an image")
  expect_eq(
    pick_picture([source("a.jxl", "image/jxl"), source("a.webp", "Image/WebP;q=1")], "", "a.jpg"),
    "a.webp",
    "unsupported type skipped",
  )
  expect_eq(
    pick_picture(
      [html::PictureSource::{ srcset: "m.webp", media_matches: false, mime_type: "" }],
      "",
      "a.jpg",
    ),
    "a.jpg",
    "non-matching media skipped",
  )
  expect_eq(pick_picture([source("  \t ", "")], "", "a.jpg"), "a.jpg", "blank srcset skipped")
}

///|
test "control_dos_parse_100k_linear_no_panic" {
  let commas = StringBuilder::with_capacity(100000)
  let parens = StringBuilder::with_capacity(100002)
  parens.write_string("a ")
  let spaces = StringBuilder::with_capacity(100000)
  let mut i = 0
  while i < 100000 {
    commas.write_string(",")
    parens.write_string("(")
    spaces.write_string(" ")
    i = i + 1
  }
  expect_eq(show(commas.to_string()), "", "100k commas")
  expect_eq(show(parens.to_string()), "", "100k open parens")
  expect_eq(show(spaces.to_string()), "", "100k spaces")
}
