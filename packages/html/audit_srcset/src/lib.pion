///| Red-team audit helpers for `packages/html/src/srcset.pion` (no production code; see ../REPORT.md).

import "html"

///|
pub fn expect_eq(got : String, want : String, what : String) -> Unit {
  debug_assert(got == want, what + ": got `" + got + "`, want `" + want + "`")
}

///| `url wN | url xD, ...` rendering of `parse_srcset(input)`.
pub fn show(input : String) -> String {
  let cs = html::parse_srcset(input)
  let sb = StringBuilder::with_capacity(64)
  let mut i = 0
  while i < cs.length() {
    if i > 0 {
      sb.write_string(" | ")
    }
    sb.write_string(cs[i].url)
    match cs[i].descriptor {
      html::SrcsetDescriptor::Width(w) => {
        sb.write_string(" w")
        sb.write_string(w.to_string())
      }
      html::SrcsetDescriptor::Density(x) => {
        sb.write_string(" x")
        sb.write_string(x.to_string())
      }
    }
    i = i + 1
  }
  sb.to_string()
}

///| `select_srcset_candidate(parse_srcset(srcset), fallback, w, dpr)` or `<none>`.
pub fn pick(srcset : String, fallback : String, w : Double, dpr : Double) -> String {
  match html::select_srcset_candidate(html::parse_srcset(srcset), fallback, w, dpr) {
    Some(u) => u
    None => "<none>"
  }
}

///| A `<source>` that matches its media query.
pub fn source(srcset : String, mime : String) -> html::PictureSource {
  html::PictureSource::{ srcset: srcset, media_matches: true, mime_type: mime }
}

///| `select_picture_source(...)` or `<none>`.
pub fn pick_picture(
  sources : Array[html::PictureSource],
  img_srcset : String,
  img_src : String,
) -> String {
  match html::select_picture_source(sources, img_srcset, img_src, 1000.0, 1.0) {
    Some(u) => u
    None => "<none>"
  }
}
