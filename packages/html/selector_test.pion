///| CSS Selectors query engine compliance tests (`select`, `select_first`, `Selector::parse`, `matches`).

fn sel_doc() -> Document {
  let src = "<!DOCTYPE html><html><head><title>Test</title></head><body>" +
  "<main id=\"app\" class=\"container primary\" data-env=\"Prod\">" +
  "<header class=\"top-bar\"><h1 id=\"title\">Welcome</h1><p class=\"lead intro\">Hello</p></header>" +
  "<ul class=\"nav-list\" data-tags=\"alpha beta gamma\" lang=\"en-US\">" +
  "<li class=\"item active\" data-id=\"1\"><a href=\"https://example.com/a\" rel=\"noopener\">A</a></li>" +
  "<li class=\"item\" data-id=\"2\"><a href=\"https://example.com/b.pdf\">B</a></li>" +
  "<li class=\"item disabled\" data-id=\"3\"><a href=\"http://other.org/c\">C</a></li>" +
  "<li class=\"item empty-li\" data-id=\"4\"></li>" +
  "</ul>" +
  "<section class=\"cards\">" +
  "<div class=\"card\"><span>Only</span></div>" +
  "<div class=\"card featured\"><p>First</p><p>Second</p><p>Third</p></div>" +
  "</section>" +
  "</main></body></html>"
  match Document::parse(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "sel_doc parse failed: " + e.to_string())
      Document::{ src: "", strings: [], nodes: [], attrs: [] }
    }
  }
}

fn must_select(doc : Document, q : String) -> Array[Node] {
  match doc.select(q) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "select('" + q + "') failed: " + e.to_string())
      []
    }
  }
}

///|
test "css_type_universal_id_class" {
  let doc = sel_doc()
  debug_assert(must_select(doc, "h1").length() == 1, "type h1")
  debug_assert(must_select(doc, "H1").length() == 1, "type case-insensitive H1")
  debug_assert(must_select(doc, "#app").length() == 1, "id #app")
  debug_assert(must_select(doc, "main#app.container.primary").length() == 1, "compound main#app.container.primary")
  debug_assert(must_select(doc, ".item").length() == 4, "class .item")
  debug_assert(must_select(doc, "li.item.active").length() == 1, "li.item.active")
  debug_assert(must_select(doc, "ul.nav-list *").length() == 7, "universal under ul.nav-list (4 li + 3 a)")
}

///|
test "css_attribute_selectors_all_operators_and_case_flag" {
  let doc = sel_doc()
  // Presence [a]
  debug_assert(must_select(doc, "[data-id]").length() == 4, "[data-id]")
  // Exact [a=v]
  debug_assert(must_select(doc, "[data-id=\"2\"]").length() == 1, "[data-id=\"2\"]")
  debug_assert(must_select(doc, "[data-id=3]").length() == 1, "unquoted [data-id=3]")
  // Case-insensitive flag i
  debug_assert(must_select(doc, "[data-env=\"prod\"]").length() == 0, "case-sensitive miss")
  debug_assert(must_select(doc, "[data-env=\"prod\" i]").length() == 1, "case-insensitive hit")
  // Whitespace word [a~=v]
  debug_assert(must_select(doc, "[data-tags~=\"beta\"]").length() == 1, "[data-tags~=beta]")
  debug_assert(must_select(doc, "[data-tags~=\"bet\"]").length() == 0, "[data-tags~=bet] partial miss")
  // Dash match [a|=v]
  debug_assert(must_select(doc, "[lang|=\"en\"]").length() == 1, "[lang|=en] matches en-US")
  debug_assert(must_select(doc, "[lang|=\"fr\"]").length() == 0, "[lang|=fr] miss")
  // Prefix [a^=v]
  debug_assert(must_select(doc, "a[href^=\"https://\"]").length() == 2, "href prefix https://")
  // Suffix [a$=v]
  debug_assert(must_select(doc, "a[href$=\".pdf\"]").length() == 1, "href suffix .pdf")
  // Substring [a*=v]
  debug_assert(must_select(doc, "a[href*=\"example.com\"]").length() == 2, "href substring example.com")
  // Empty value for ^=, $=, *= must never match per CSS Selectors 4
  debug_assert(must_select(doc, "a[href^=\"\"]").length() == 0, "empty prefix never matches")
  debug_assert(must_select(doc, "a[href$=\"\"]").length() == 0, "empty suffix never matches")
  debug_assert(must_select(doc, "a[href*=\"\"]").length() == 0, "empty substring never matches")
}

///|
test "css_combinators_descendant_child_adjacent_general" {
  let doc = sel_doc()
  // Descendant
  debug_assert(must_select(doc, "main a").length() == 3, "descendant main a")
  // Child >
  debug_assert(must_select(doc, "main > a").length() == 0, "main > a has 0 direct children")
  debug_assert(must_select(doc, "ul.nav-list > li > a").length() == 3, "ul > li > a")
  // Adjacent sibling +
  let adj = must_select(doc, "li.active + li")
  debug_assert(adj.length() == 1, "li.active + li matches 1")
  match adj[0].attr("data-id") {
    Some(v) => debug_assert(v == "2", "adjacent sibling is data-id=2")
    None => debug_assert(false, "expected data-id")
  }
  // General sibling ~
  let gen = must_select(doc, "li.active ~ li")
  debug_assert(gen.length() == 3, "li.active ~ li matches 3 following siblings")
}

///|
test "css_selector_list_dedup_and_order" {
  let doc = sel_doc()
  // h1 matches once; #title also matches the same h1 -> must be deduplicated in document order
  let res = must_select(doc, "h1, #title, p.lead, li.active")
  debug_assert(res.length() == 3, "deduplicated 3 elements")
  debug_assert(res[0].tag_name() == "h1", "0 is h1")
  debug_assert(res[1].tag_name() == "p", "1 is p.lead")
  debug_assert(res[2].tag_name() == "li", "2 is li.active")
}

///|
test "css_pseudo_classes" {
  let doc = sel_doc()
  // :first-child, :last-child, :only-child
  let fc = must_select(doc, "ul.nav-list > li:first-child")
  debug_assert(fc.length() == 1 && fc[0].text_content() == "A", ":first-child")
  let lc = must_select(doc, "ul.nav-list > li:last-child")
  debug_assert(lc.length() == 1, ":last-child")
  match lc[0].attr("data-id") {
    Some(v) => debug_assert(v == "4", "last-child is data-id=4")
    None => debug_assert(false, "expected data-id")
  }
  let oc = must_select(doc, ".cards span:only-child")
  debug_assert(oc.length() == 1 && oc[0].text_content() == "Only", ":only-child")
  debug_assert(must_select(doc, ".featured p:only-child").length() == 0, "not only-child")

  // :nth-child(odd|even|an+b)
  let odds = must_select(doc, "ul.nav-list > li:nth-child(odd)")
  debug_assert(odds.length() == 2, "odd li count")
  let evens = must_select(doc, "ul.nav-list > li:nth-child(even)")
  debug_assert(evens.length() == 2, "even li count")
  let nth2 = must_select(doc, ".featured > p:nth-child(2)")
  debug_assert(nth2.length() == 1 && nth2[0].text_content() == "Second", ":nth-child(2)")
  let nth_expr = must_select(doc, "ul.nav-list > li:nth-child(2n+1)")
  debug_assert(nth_expr.length() == 2, ":nth-child(2n+1)")
  let nth_neg = must_select(doc, "ul.nav-list > li:nth-child(-n+2)")
  debug_assert(nth_neg.length() == 2, ":nth-child(-n+2) matches first 2")

  // :empty
  let emp = must_select(doc, "ul.nav-list > li:empty")
  debug_assert(emp.length() == 1, ":empty matches empty-li")
  debug_assert(emp[0].has_class("empty-li"), "empty-li class")

  // :not(...)
  let not_dis = must_select(doc, "ul.nav-list > li:not(.disabled)")
  debug_assert(not_dis.length() == 3, ":not(.disabled) matches 3")
  let not_multi = must_select(doc, "ul.nav-list > li:not(.disabled, .empty-li)")
  debug_assert(not_multi.length() == 2, ":not(.disabled, .empty-li) matches 2")
}

///|
test "css_select_first_node_scoped_and_matches" {
  let doc = sel_doc()
  match doc.select_first("li.item") {
    Ok(Some(n)) => debug_assert(n.text_content() == "A", "select_first returns first li")
    _ => debug_assert(false, "expected Some(li)")
  }
  match doc.select_first(".does-not-exist") {
    Ok(None) => ()
    _ => debug_assert(false, "expected None")
  }
  // Scoped Node::select
  let featured = must_select(doc, "div.featured")[0]
  match featured.select("p") {
    Ok(ps) => debug_assert(ps.length() == 3, "scoped node.select finds 3 p inside .featured")
    Err(e) => debug_assert(false, "node.select error: " + e.to_string())
  }
  // Compiled Selector::parse + Node::matches
  let sel = match Selector::parse("div.card.featured") {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "Selector::parse failed: " + e.to_string())
      Selector::{ items: [] }
    }
  }
  debug_assert(featured.matches(sel), "featured matches div.card.featured")
}

///|
test "css_invalid_selectors_return_err" {
  let bad = ["", "   ", "div >", "> div", "div[unclosed", "div:nth-child(abc)", "div,,span", "div:unknown-pseudo-xyz()"]
  let mut i = 0
  while i < bad.length() {
    match Selector::parse(bad[i]) {
      Ok(_) => debug_assert(false, "expected error for invalid selector: " + bad[i])
      Err(e) => debug_assert(html_error_kind_eq(e.kind, HtmlErrorKind::InvalidSelector), "InvalidSelector error kind")
    }
    i = i + 1
  }
}
