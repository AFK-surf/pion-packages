///| WHATWG HTML5 Tokenizer, Tree-Builder, Entity Decoder, and Serializer compliance tests.

fn must_parse_doc(src : String, label : String) -> Document {
  match Document::parse(src) {
    Ok(doc) => doc
    Err(e) => {
      debug_assert(false, label + ": unexpected parse error: " + e.to_string())
      Document::{ src: "", strings: [], nodes: [], attrs: [] }
    }
  }
}

fn must_parse_frag(src : String, label : String) -> Document {
  match Document::parse_fragment(src) {
    Ok(doc) => doc
    Err(e) => {
      debug_assert(false, label + ": unexpected fragment error: " + e.to_string())
      Document::{ src: "", strings: [], nodes: [], attrs: [] }
    }
  }
}

fn opt_eq(a : Option[String], b : String) -> Bool {
  match a {
    Some(s) => s == b
    None => false
  }
}

fn opt_none(a : Option[String]) -> Bool {
  match a {
    None => true
    Some(_) => false
  }
}

///|
test "html5_void_elements_all_14" {
  let src = "<div><area alt=\"a\"><base href=\"/\"><br><col><embed src=\"e\"><hr><img src=\"i.png\"><input type=\"text\"><link rel=\"s\"><meta charset=\"utf-8\"><param name=\"p\"><source src=\"s\"><track src=\"t\"><wbr><span>after</span></div>"
  let doc = must_parse_frag(src, "void14")
  let root_children = doc.root().element_children()
  debug_assert(root_children.length() == 1, "single div wrapper")
  let div = root_children[0]
  debug_assert(div.tag_name() == "div", "wrapper is div")
  let elems = div.element_children()
  debug_assert(elems.length() == 15, "14 void elements + trailing span")
  debug_assert(elems[0].tag_name() == "area", "0 area")
  debug_assert(elems[1].tag_name() == "base", "1 base")
  debug_assert(elems[2].tag_name() == "br", "2 br")
  debug_assert(elems[3].tag_name() == "col", "3 col")
  debug_assert(elems[4].tag_name() == "embed", "4 embed")
  debug_assert(elems[5].tag_name() == "hr", "5 hr")
  debug_assert(elems[6].tag_name() == "img", "6 img")
  debug_assert(elems[7].tag_name() == "input", "7 input")
  debug_assert(elems[8].tag_name() == "link", "8 link")
  debug_assert(elems[9].tag_name() == "meta", "9 meta")
  debug_assert(elems[10].tag_name() == "param", "10 param")
  debug_assert(elems[11].tag_name() == "source", "11 source")
  debug_assert(elems[12].tag_name() == "track", "12 track")
  debug_assert(elems[13].tag_name() == "wbr", "13 wbr")
  debug_assert(elems[14].tag_name() == "span", "14 span")
  debug_assert(elems[14].text_content() == "after", "span text")
  // Void elements must have no children
  let mut i = 0
  while i < 14 {
    debug_assert(elems[i].children().length() == 0, "void element has no children")
    i = i + 1
  }
}

///|
test "html5_rawtext_script_and_style" {
  let src = "<script>if (a < b && c > d) { var s = \"<div>&amp;</div></scriptx>\"; }</SCRIPT><style>.a > .b::before { content: \"<p>&lt;</p>\"; }</style><p>ok</p>"
  let doc = must_parse_frag(src, "rawtext")
  let elems = doc.root().element_children()
  debug_assert(elems.length() == 3, "script, style, p")
  debug_assert(elems[0].tag_name() == "script", "script tag")
  debug_assert(
    elems[0].text_content() == "if (a < b && c > d) { var s = \"<div>&amp;</div></scriptx>\"; }",
    "script rawtext preserves tags and entities verbatim",
  )
  debug_assert(elems[0].element_children().length() == 0, "script has no element children")
  debug_assert(elems[1].tag_name() == "style", "style tag")
  debug_assert(
    elems[1].text_content() == ".a > .b::before { content: \"<p>&lt;</p>\"; }",
    "style rawtext preserves tags and entities verbatim",
  )
  debug_assert(elems[2].tag_name() == "p", "trailing p")
  debug_assert(elems[2].text_content() == "ok", "trailing p text")
}

///|
test "html5_rcdata_title_and_textarea" {
  let src = "<title><b>Hello</b> &amp; &lt;World&gt;</TITLE><textarea><p>raw</p> &quot;quoted&quot; &#65;</textarea>"
  let doc = must_parse_frag(src, "rcdata")
  let elems = doc.root().element_children()
  debug_assert(elems.length() == 2, "title and textarea")
  debug_assert(elems[0].tag_name() == "title", "title tag")
  debug_assert(elems[0].element_children().length() == 0, "title has no child elements")
  debug_assert(
    elems[0].text_content() == "<b>Hello</b> & <World>",
    "title decodes entities but keeps tags as text",
  )
  debug_assert(elems[1].tag_name() == "textarea", "textarea tag")
  debug_assert(elems[1].element_children().length() == 0, "textarea has no child elements")
  debug_assert(
    elems[1].text_content() == "<p>raw</p> \"quoted\" A",
    "textarea decodes entities but keeps tags as text",
  )
}

///|
test "html5_named_and_numeric_entities" {
  let src = "<p>&amp;&lt;&gt;&quot;&apos;&nbsp;&copy;&mdash;&ndash;&hellip;&reg;&trade;&euro;&times;</p>"
  let doc = must_parse_frag(src, "named_entities")
  let p = doc.root().element_children()[0]
  debug_assert(
    p.text_content() == "&<>\"'\u{00A0}\u{00A9}\u{2014}\u{2013}\u{2026}\u{00AE}\u{2122}\u{20AC}\u{00D7}",
    "common named entities decoded accurately",
  )

  // Numeric decimal & hex + U+0000 -> U+FFFD + Windows-1252 0x80..0x9F
  let num_src = "<p>&#65;&#x42;&#X43;&#0;&#x00;&#128;&#133;&#147;&#148;&#150;&#151;&#153;&#x80;&#x99;&#x1F600;&#x110000;&#xD800;</p>"
  let ndoc = must_parse_frag(num_src, "numeric_entities")
  let np = ndoc.root().element_children()[0]
  debug_assert(
    np.text_content() == "ABC\u{FFFD}\u{FFFD}\u{20AC}\u{2026}\u{201C}\u{201D}\u{2013}\u{2014}\u{2122}\u{20AC}\u{2122}\u{1F600}\u{FFFD}\u{FFFD}",
    "numeric refs, null->FFFD, Win1252 0x80..0x9F, surrogate/overflow->FFFD",
  )

  // Legacy entity without semicolon in text vs attribute
  let leg_src = "<a href=\"https://example.com/?a=1&copy=2&amp=3&amp;b=4\">a&ampb &copy</a>"
  let ldoc = must_parse_frag(leg_src, "legacy_entities")
  let a = ldoc.root().element_children()[0]
  debug_assert(
    opt_eq(a.attr("href"), "https://example.com/?a=1&copy=2&amp=3&b=4"),
    "attribute legacy entity followed by '=' must NOT be decoded",
  )
  debug_assert(
    a.text_content() == "a&b \u{00A9}",
    "text legacy entities without semicolon decoded",
  )
}

///|
test "html5_auto_close_p_li_dt_dd_option" {
  // <p>a<p>b
  let d1 = must_parse_frag("<p>a<p>b", "auto_p")
  let c1 = d1.root().element_children()
  debug_assert(c1.length() == 2, "two sibling p elements")
  debug_assert(c1[0].tag_name() == "p" && c1[0].text_content() == "a", "first p")
  debug_assert(c1[1].tag_name() == "p" && c1[1].text_content() == "b", "second p")

  // <p> auto-closed by block <div>
  let d2 = must_parse_frag("<p>before<div>inside</div>", "p_div")
  let c2 = d2.root().element_children()
  debug_assert(c2.length() == 2, "p then div")
  debug_assert(c2[0].tag_name() == "p" && c2[0].text_content() == "before", "p text")
  debug_assert(c2[1].tag_name() == "div" && c2[1].text_content() == "inside", "div text")

  // <li>1<li>2<li>3
  let d3 = must_parse_frag("<ul><li>1<li>2<li>3</ul>", "auto_li")
  let ul = d3.root().element_children()[0]
  let lis = ul.element_children()
  debug_assert(lis.length() == 3, "three sibling li elements")
  debug_assert(lis[0].text_content() == "1", "li 1")
  debug_assert(lis[1].text_content() == "2", "li 2")
  debug_assert(lis[2].text_content() == "3", "li 3")

  // <dt>/<dd>
  let d4 = must_parse_frag("<dl><dt>k1<dd>v1<dt>k2<dd>v2</dl>", "auto_dt_dd")
  let dl = d4.root().element_children()[0]
  let ditems = dl.element_children()
  debug_assert(ditems.length() == 4, "dt dd dt dd")
  debug_assert(ditems[0].tag_name() == "dt" && ditems[1].tag_name() == "dd", "dt/dd pair 1")
  debug_assert(ditems[2].tag_name() == "dt" && ditems[3].tag_name() == "dd", "dt/dd pair 2")

  // <option>
  let d5 = must_parse_frag("<select><option>a<option>b</select>", "auto_option")
  let sel = d5.root().element_children()[0]
  let opts = sel.element_children()
  debug_assert(opts.length() == 2, "two sibling options")
  debug_assert(opts[0].text_content() == "a" && opts[1].text_content() == "b", "option texts")
}

///|
test "html5_implicit_tbody_and_table_cells" {
  let src = "<table><tr><td>a<td>b<tr><th>c<td>d</table>"
  let doc = must_parse_frag(src, "table_tbody")
  let table = doc.root().element_children()[0]
  debug_assert(table.tag_name() == "table", "table root")
  let tchildren = table.element_children()
  debug_assert(tchildren.length() == 1, "single implicit tbody")
  let tbody = tchildren[0]
  debug_assert(tbody.tag_name() == "tbody", "implicit tbody created")
  let rows = tbody.element_children()
  debug_assert(rows.length() == 2, "two tr rows")
  let r0 = rows[0].element_children()
  debug_assert(r0.length() == 2, "row 0 has 2 cells")
  debug_assert(r0[0].tag_name() == "td" && r0[0].text_content() == "a", "r0c0")
  debug_assert(r0[1].tag_name() == "td" && r0[1].text_content() == "b", "r0c1")
  let r1 = rows[1].element_children()
  debug_assert(r1.length() == 2, "row 1 has 2 cells")
  debug_assert(r1[0].tag_name() == "th" && r1[0].text_content() == "c", "r1c0")
  debug_assert(r1[1].tag_name() == "td" && r1[1].text_content() == "d", "r1c1")
}

///|
test "html5_misnested_formatting_adoption_agency" {
  let doc = must_parse_frag("<b><i>1</b>2</i>", "misnested_bi")
  let elems = doc.root().element_children()
  debug_assert(elems.length() == 2, "b and reopened i")
  debug_assert(elems[0].tag_name() == "b", "first is b")
  let b_kids = elems[0].element_children()
  debug_assert(b_kids.length() == 1 && b_kids[0].tag_name() == "i", "b contains i")
  debug_assert(b_kids[0].text_content() == "1", "inner i has '1'")
  debug_assert(elems[1].tag_name() == "i", "second is reopened i")
  debug_assert(elems[1].text_content() == "2", "reopened i has '2'")
  debug_assert(doc.to_html() == "<b><i>1</i></b><i>2</i>", "serialized adoption agency output")
}

///|
test "html5_comments_and_doctype" {
  let src = "<!DOCTYPE html><!-- normal --><!----><!--><!---><html><head></head><body><!-- inner -->hi</body></html>"
  let doc = must_parse_doc(src, "comments_doctype")
  let top = doc.root().children()
  debug_assert(top.length() >= 6, "doctype + 4 comments + html")
  debug_assert(top[0].is_doctype(), "first is doctype")
  debug_assert(top[1].is_comment() && opt_eq(top[1].text(), " normal "), "normal comment")
  debug_assert(top[2].is_comment() && opt_eq(top[2].text(), ""), "empty comment <!---->")
  debug_assert(top[3].is_comment() && opt_eq(top[3].text(), ""), "abrupt comment <!-->")
  debug_assert(top[4].is_comment() && opt_eq(top[4].text(), ""), "abrupt comment <!--->")

  // Unclosed comment at EOF
  let d2 = must_parse_frag("<!-- unclosed", "unclosed_comment")
  let c2 = d2.root().children()
  debug_assert(c2.length() == 1 && c2[0].is_comment(), "unclosed comment node")
  debug_assert(opt_eq(c2[0].text(), " unclosed"), "unclosed comment text")
}

///|
test "html5_attributes_dedup_case_and_quoting" {
  let src = "<DIV ID=\"first\" id=\"second\" Data-Key='val &amp; 1' unq=hello_world DISABLED></DIV>"
  let doc = must_parse_frag(src, "attrs")
  let el = doc.root().element_children()[0]
  debug_assert(el.tag_name() == "div", "tag lowercased")
  debug_assert(opt_eq(el.attr("id"), "first"), "duplicate attr first wins")
  debug_assert(opt_eq(el.attr("ID"), "first"), "attr lookup is case-insensitive")
  debug_assert(opt_eq(el.attr("data-key"), "val & 1"), "attr name lowercased & entities decoded")
  debug_assert(opt_eq(el.attr("unq"), "hello_world"), "unquoted attr")
  debug_assert(el.has_attr("disabled"), "boolean attr present")
  debug_assert(opt_eq(el.attr("disabled"), ""), "boolean attr value is empty string")
  debug_assert(opt_none(el.attr("missing")), "missing attr is None")
  debug_assert(el.attributes().length() == 4, "4 unique attributes")
}

///|
test "html5_document_implicit_structure_and_serialization" {
  let doc = must_parse_doc("<!DOCTYPE html><p>Hello &amp; <b>Pion</b><br>World</p>", "doc_implicit")
  let html = doc.to_html()
  debug_assert(
    html == "<!DOCTYPE html><html><head></head><body><p>Hello &amp; <b>Pion</b><br>World</p></body></html>",
    "full HTML5 document serialization with implicit html/head/body",
  )
  debug_assert(doc.text_content() == "Hello & PionWorld", "document text_content")
}

///|
test "html5_outer_and_inner_html" {
  let doc = must_parse_frag("<div class=\"box\" data-x=\"a&quot;b\"><span>1 &lt; 2</span><br></div>", "outer_inner")
  let div = doc.root().element_children()[0]
  debug_assert(
    div.inner_html() == "<span>1 &lt; 2</span><br>",
    "inner_html escapes text and omits void end tag",
  )
  debug_assert(
    div.outer_html() == "<div class=\"box\" data-x=\"a&quot;b\"><span>1 &lt; 2</span><br></div>",
    "outer_html escapes attr quotes",
  )
}
