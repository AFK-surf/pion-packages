///| RFC 7468 PEM encoder and decoder compliance test suite.

fn pem_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

test "pem_encode_decode_roundtrip_and_64_col_wrap" {
  // 100 bytes -> 136 base64 chars -> 3 lines (64, 64, 8)
  let payload = Bytes::new(100)
  let mut i = 0
  while i < 100 {
    payload[i] = ((i * 7 + 13) & 0xFF).to_byte()
    i = i + 1
  }
  let encoded = match encode_pem("CERTIFICATE", payload) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, asn1_error_message(e))
      ""
    }
  }
  // Check header/footer and 64-char lines
  let mut line_start = 0
  let mut line_count = 0
  let n = encoded.length()
  let mut p = 0
  while p < n {
    if encoded.code_unit_at(p) == 10 {
      let line_len = p - line_start
      if line_count == 1 || line_count == 2 {
        debug_assert(line_len == 64, "base64 body line must be 64 chars")
      }
      line_count = line_count + 1
      line_start = p + 1
    }
    p = p + 1
  }
  debug_assert(line_count == 5, "header + 3 body lines + footer = 5 lines")

  let block = match parse_pem(encoded) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, asn1_error_message(e))
      PemBlock::{ label: "", data: Bytes::new(0) }
    }
  }
  debug_assert(block.label == "CERTIFICATE", "label match")
  debug_assert(pem_bytes_eq(block.data, payload), "payload roundtrip")
}

test "pem_parse_all_with_preamble_comments_and_crlf" {
  let bundle =
  "Bag Attributes\r\n" +
  "    friendlyName: leaf\r\n" +
  "-----BEGIN CERTIFICATE-----\r\n" +
  "AQIDBA==\r\n" +
  "-----END CERTIFICATE-----\r\n" +
  "Some explanatory text between blocks\n" +
  "-----BEGIN PRIVATE KEY-----\n" +
  "BQYHCA==\n" +
  "-----END PRIVATE KEY-----\n"

  let blocks = match parse_pem_all(bundle) {
    Ok(bs) => bs
    Err(e) => {
      debug_assert(false, asn1_error_message(e))
      []
    }
  }
  debug_assert(blocks.length() == 2, "expected 2 PEM blocks")
  debug_assert(blocks[0].label == "CERTIFICATE", "first label")
  debug_assert(blocks[0].data.length() == 4 && blocks[0].data[0].to_int() == 1 && blocks[0].data[3].to_int() == 4, "first data")
  debug_assert(blocks[1].label == "PRIVATE KEY", "second label")
  debug_assert(blocks[1].data.length() == 4 && blocks[1].data[0].to_int() == 5 && blocks[1].data[3].to_int() == 8, "second data")
}

test "pem_reject_malformed_inputs" {
  // Mismatched END label
  let mismatch = "-----BEGIN CERTIFICATE-----\nAQIDBA==\n-----END PUBLIC KEY-----\n"
  match parse_pem(mismatch) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "mismatched END label must fail")
  }

  // Missing END marker
  let missing_end = "-----BEGIN CERTIFICATE-----\nAQIDBA==\n"
  match parse_pem(missing_end) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "missing END marker must fail")
  }

  // Corrupt base64
  let bad_b64 = "-----BEGIN CERTIFICATE-----\n@@@@\n-----END CERTIFICATE-----\n"
  match parse_pem(bad_b64) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "corrupt base64 must fail")
  }

  // Empty label
  let empty_label = "-----BEGIN -----\nAQIDBA==\n-----END -----\n"
  match parse_pem(empty_label) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "empty label must fail")
  }

  // No PEM block at all
  match parse_pem("just plain text without any pem markers") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "missing PEM block must fail")
  }

  // Invalid label for encode_pem
  match encode_pem("", Bytes::new(1)) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "empty label encode must fail")
  }
  match encode_pem("BAD\nLABEL", Bytes::new(1)) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "control char in label must fail")
  }
}
