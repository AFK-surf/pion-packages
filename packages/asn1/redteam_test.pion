///| Day-1 security red-team test suite: depth bombs, OOM length bombs,
///| DER malleability vectors, duplicate X.509 extensions, and SAN NUL injection.

fn rt_hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    0
  }
}

fn rt_hex(hex : String) -> Bytes {
  let n = hex.length()
  let out = Bytes::new(n / 2)
  let mut i = 0
  while i < n / 2 {
    out[i] = (rt_hex_nibble(hex.code_unit_at(i * 2)) * 16 + rt_hex_nibble(hex.code_unit_at(i * 2 + 1))).to_byte()
    i = i + 1
  }
  out
}

test "redteam_50000_nested_sequence_depth_bomb" {
  // Build 50,000 nested SEQUENCEs iteratively without stack overflow.
  // Outer lengths fit in 4-byte length encoding: 0x30 0x83 <3-byte len> ...
  // Even simpler: each layer wraps inner bytes; for 50,000 layers, inner size is up to ~250,000 bytes.
  let depth = 50000
  // Precompute exact DER for 50,000 nested empty SEQUENCEs:
  // Layer 0 (innermost): 30 00 (2 bytes)
  // For k = 1..depth-1: tag 0x30 + DER length of prev_len
  let lens = Array::new()
  let mut cur_len = 2
  lens.push(0)
  let mut i = 1
  while i < depth {
    lens.push(cur_len)
    let len_hdr = if cur_len < 128 {
      1
    } else if cur_len < 256 {
      2
    } else if cur_len < 65536 {
      3
    } else {
      4
    }
    cur_len = 1 + len_hdr + cur_len
    i = i + 1
  }
  let buf = Bytes::new(cur_len)
  let mut pos = 0
  let mut k = depth - 1
  while k >= 1 {
    let cl = lens[k]
    buf[pos] = (0x30).to_byte()
    pos = pos + 1
    if cl < 128 {
      buf[pos] = cl.to_byte()
      pos = pos + 1
    } else if cl < 256 {
      buf[pos] = (0x81).to_byte()
      buf[pos + 1] = cl.to_byte()
      pos = pos + 2
    } else if cl < 65536 {
      buf[pos] = (0x82).to_byte()
      buf[pos + 1] = (cl >> 8).to_byte()
      buf[pos + 2] = (cl & 0xFF).to_byte()
      pos = pos + 3
    } else {
      buf[pos] = (0x83).to_byte()
      buf[pos + 1] = (cl >> 16).to_byte()
      buf[pos + 2] = ((cl >> 8) & 0xFF).to_byte()
      buf[pos + 3] = (cl & 0xFF).to_byte()
      pos = pos + 4
    }
    k = k - 1
  }
  buf[pos] = (0x30).to_byte()
  buf[pos + 1] = (0x00).to_byte()

  match parse_der_element(buf) {
    Err(Asn1Error::DepthLimitExceeded(_)) => ()
    Err(e) => debug_assert(false, "expected DepthLimitExceeded, got: " + asn1_error_message(e))
    Ok(_) => debug_assert(false, "50,000 nested SEQUENCEs must fail with DepthLimitExceeded")
  }
}

test "redteam_oom_length_bomb_10b_input" {
  // 0x84 0x7F 0xFF 0xFF 0xFF claims 2 GiB on a 10-byte buffer -> immediate Err, zero OOM
  let bomb = rt_hex("04847fffffff01020304")
  let r = DerReader::new(bomb)
  match r.read_header() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "2GiB length bomb must be rejected")
  }
  match parse_der_element(bomb) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "2GiB length bomb must be rejected by tree parser")
  }
  // Length with > 4 length-of-length bytes (0x85 ...)
  let bomb5 = rt_hex("0485010000000000")
  match DerReader::new(bomb5).read_header() {
    Err(_) => ()
    Ok(_) => debug_assert(false, ">4-byte length must be rejected")
  }
}

test "redteam_der_malleability_all_vectors" {
  // 1. Non-canonical BOOLEAN (0x01, 0x02, 0x7F)
  match DerReader::new(rt_hex("010101")).read_bool() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "BOOL 0x01 must be rejected")
  }
  match DerReader::new(rt_hex("01017f")).read_bool() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "BOOL 0x7F must be rejected")
  }
  match DerReader::new(rt_hex("01020000")).read_bool() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "BOOL len 2 must be rejected")
  }

  // 2. Non-minimal INTEGER (0x00 0x7F, 0xFF 0x80, empty 0x02 0x00)
  match DerReader::new(rt_hex("0202007f")).read_integer_bytes() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "INTEGER 00 7F must be rejected")
  }
  match DerReader::new(rt_hex("0202ff80")).read_integer_bytes() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "INTEGER FF 80 must be rejected")
  }
  match DerReader::new(rt_hex("0200")).read_integer_bytes() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "empty INTEGER must be rejected")
  }

  // 3. BIT STRING: unused_bits > 7, empty with unused_bits != 0, non-zero trailing unused bits
  match DerReader::new(rt_hex("030208ff")).read_bit_string() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "BIT STRING unused_bits=8 must be rejected")
  }
  match DerReader::new(rt_hex("030101")).read_bit_string() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "empty BIT STRING with unused_bits=1 must be rejected")
  }
  match DerReader::new(rt_hex("030204ff")).read_bit_string() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "BIT STRING non-zero trailing bits must be rejected")
  }
  match DerReader::new(rt_hex("0300")).read_bit_string() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "0-length BIT STRING must be rejected")
  }

  // 4. NULL with non-zero length
  match DerReader::new(rt_hex("050100")).read_null() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "NULL len 1 must be rejected")
  }

  // 5. BER indefinite length 0x80
  match DerReader::new(rt_hex("30800000")).read_header() {
    Err(Asn1Error::IndefiniteLength(_)) => ()
    Err(_) => debug_assert(false, "expected IndefiniteLength error")
    Ok(_) => debug_assert(false, "BER indefinite length must be rejected")
  }

  // 6. Non-shortest length encodings (0x81 0x05, 0x82 0x00 0x80)
  match DerReader::new(rt_hex("0481050102030405")).read_header() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "non-minimal length 81 05 must be rejected")
  }
  let padded_len = Bytes::new(132)
  padded_len[0] = (0x04).to_byte()
  padded_len[1] = (0x82).to_byte()
  padded_len[2] = (0x00).to_byte()
  padded_len[3] = (0x80).to_byte()
  match DerReader::new(padded_len).read_header() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "non-minimal length 82 00 80 must be rejected")
  }

  // 7. Non-canonical high tag numbers (leading 0x80, or < 31 encoded in high form)
  match DerReader::new(rt_hex("1f801f00")).read_header() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "high tag leading 0x80 must be rejected")
  }
  match DerReader::new(rt_hex("1f1e00")).read_header() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "high tag < 31 must be rejected")
  }

  // 8. OID leading 0x80 subidentifier, empty OID, truncated varint, UInt64 overflow
  match DerReader::new(rt_hex("06032a8001")).read_oid() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "OID leading 0x80 must be rejected")
  }
  match DerReader::new(rt_hex("0600")).read_oid() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "empty OID must be rejected")
  }
  match DerReader::new(rt_hex("06022a81")).read_oid() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "truncated OID varint must be rejected")
  }
  match DerReader::new(rt_hex("060c2affffffffffffffffff01")).read_oid() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "OID UInt64 overflow must be rejected")
  }
}

test "redteam_duplicate_x509_extension_and_san_nul_injection" {
  // Helper to build a minimal X.509 v3 cert with custom extensions sequence bytes
  let build_cert = fn(exts_content : Bytes) -> Bytes {
    let tbs = DerWriter::new()
    // [0] EXPLICIT INTEGER 2 (v3)
    let v_w = DerWriter::new()
    v_w.write_int64(2L)
    tbs.write_explicit_context(0, v_w.to_bytes())
    tbs.write_int64(99L)
    let alg_w = DerWriter::new()
    let _ = alg_w.write_oid_str(oid_ed25519)
    let alg_seq = DerWriter::new()
    alg_seq.write_sequence(alg_w.to_bytes())
    let alg_bytes = alg_seq.to_bytes()
    let atv_w = DerWriter::new()
    let _ = atv_w.write_oid_str(oid_cn)
    atv_w.write_utf8_string("redteam.test")
    let atv_seq = DerWriter::new()
    atv_seq.write_sequence(atv_w.to_bytes())
    let rdn_set = DerWriter::new()
    rdn_set.write_set(atv_seq.to_bytes())
    let name_seq = DerWriter::new()
    name_seq.write_sequence(rdn_set.to_bytes())
    let name_bytes = name_seq.to_bytes()
    let val_w = DerWriter::new()
    val_w.write_tlv(tag_utc_time, "260101000000Z".to_bytes())
    val_w.write_tlv(tag_utc_time, "270101000000Z".to_bytes())
    let val_seq = DerWriter::new()
    val_seq.write_sequence(val_w.to_bytes())
    // SPKI
    let spki_alg = alg_bytes
    let spki_pk = DerWriter::new()
    let _ = spki_pk.write_bit_string(0, Bytes::new(32))
    let spki_seq = DerWriter::new()
    spki_seq.write_sequence(spki_alg.concat(spki_pk.to_bytes()))
    // [3] EXPLICIT SEQUENCE { extensions }
    let exts_seq = DerWriter::new()
    exts_seq.write_sequence(exts_content)
    let exts_ctx = DerWriter::new()
    exts_ctx.write_explicit_context(3, exts_seq.to_bytes())

    let tbs_body = tbs.to_bytes().concat(alg_bytes).concat(name_bytes).concat(val_seq.to_bytes()).concat(name_bytes).concat(spki_seq.to_bytes()).concat(exts_ctx.to_bytes())
    let tbs_seq = DerWriter::new()
    tbs_seq.write_sequence(tbs_body)
    let sig_w = DerWriter::new()
    let _ = sig_w.write_bit_string(0, Bytes::new(64))
    let cert_seq = DerWriter::new()
    cert_seq.write_sequence(tbs_seq.to_bytes().concat(alg_bytes).concat(sig_w.to_bytes()))
    cert_seq.to_bytes()
  }

  // 1. Duplicate BasicConstraints extension (RFC 5280 §4.2 forbids duplicate OIDs)
  let bc_val = DerWriter::new()
  bc_val.write_sequence(Bytes::new(0))
  let ext1 = DerWriter::new()
  let _ = ext1.write_oid_str(oid_ext_basic_constraints)
  ext1.write_octet_string(bc_val.to_bytes())
  let ext1_seq = DerWriter::new()
  ext1_seq.write_sequence(ext1.to_bytes())
  let dup_cert = build_cert(ext1_seq.to_bytes().concat(ext1_seq.to_bytes()))
  match parse_x509_der(dup_cert) {
    Err(Asn1Error::DuplicateExtension(_)) => ()
    Err(e) => debug_assert(false, "expected DuplicateExtension, got: " + asn1_error_message(e))
    Ok(_) => debug_assert(false, "duplicate X.509 extension must be rejected")
  }

  // 2. SAN NUL byte injection: "good.com\0.evil.com"
  let bad_dns = "good.com\u{0000}.evil.com".to_bytes()
  let san_item = DerWriter::new()
  san_item.write_tlv(Tag::context(2, false), bad_dns)
  let san_seq = DerWriter::new()
  san_seq.write_sequence(san_item.to_bytes())
  let san_ext = DerWriter::new()
  let _ = san_ext.write_oid_str(oid_ext_san)
  san_ext.write_octet_string(san_seq.to_bytes())
  let san_ext_seq = DerWriter::new()
  san_ext_seq.write_sequence(san_ext.to_bytes())
  let nul_cert = build_cert(san_ext_seq.to_bytes())
  match parse_x509_der(nul_cert) {
    Err(_) => ()
    Ok(c) => {
      debug_assert(!verify_hostname(c, "good.com"), "SAN NUL injection must never match good.com")
      debug_assert(!verify_hostname(c, "good.com\u{0000}.evil.com"), "SAN NUL injection must never match")
    }
  }

  // 3. Partial wildcard and single-label wildcard must never match
  let wild_item1 = DerWriter::new()
  wild_item1.write_tlv(Tag::context(2, false), "a*.example.com".to_bytes())
  let wild_item2 = DerWriter::new()
  wild_item2.write_tlv(Tag::context(2, false), "*.com".to_bytes())
  let wild_seq = DerWriter::new()
  wild_seq.write_sequence(wild_item1.to_bytes().concat(wild_item2.to_bytes()))
  let wild_ext = DerWriter::new()
  let _ = wild_ext.write_oid_str(oid_ext_san)
  wild_ext.write_octet_string(wild_seq.to_bytes())
  let wild_ext_seq = DerWriter::new()
  wild_ext_seq.write_sequence(wild_ext.to_bytes())
  let wild_cert_der = build_cert(wild_ext_seq.to_bytes())
  match parse_x509_der(wild_cert_der) {
    Ok(c) => {
      debug_assert(!verify_hostname(c, "abc.example.com"), "partial wildcard a*.example.com must not match")
      debug_assert(!verify_hostname(c, "foo.com"), "single-label TLD wildcard *.com must not match")
    }
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
}
