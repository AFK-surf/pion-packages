///| RFC 5280 X.509 v1/v3 certificate parser, hostname verification, and SPKI / PKCS#8 codec (stub for Red phase).

///| Parse a DER-encoded X.509 certificate with default `DecodeLimits`.
pub fn parse_x509_der(der : Bytes) -> Result[X509Certificate, Asn1Error] {
  parse_x509_der_with_limits(der, DecodeLimits::default())
}

///| Parse a DER-encoded X.509 certificate with explicit `DecodeLimits`.
pub fn parse_x509_der_with_limits(der : Bytes, limits : DecodeLimits) -> Result[X509Certificate, Asn1Error] {
  let _ = der
  let _ = limits
  Err(Asn1Error::InvalidX509("not implemented"))
}

///| Parse a PEM-encoded X.509 certificate (`CERTIFICATE` label).
