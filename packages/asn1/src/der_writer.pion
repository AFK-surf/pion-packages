///| Strict ITU-T X.690 DER writer with canonical SET OF sorting and iterative tree encoding.

///| Growable DER byte buffer writer.
pub struct DerWriter {
  mut buf : Bytes
  mut len : Int
}

///| Create a new `DerWriter`.
pub fn DerWriter::new() -> DerWriter {
  DerWriter::{ buf: Bytes::new(256), len: 0 }
}

///| Create a new `DerWriter` with initial capacity.
pub fn DerWriter::with_capacity(cap : Int) -> DerWriter {
  let c = if cap < 16 { 16 } else { cap }
  DerWriter::{ buf: Bytes::new(c), len: 0 }
}

fn DerWriter::ensure(self : DerWriter, extra : Int) -> Unit {
  let need = self.len + extra
  if need <= self.buf.length() {
    return ()
  }
  let mut new_cap = self.buf.length() * 2
  while new_cap < need {
    new_cap = new_cap * 2
  }
  let nb = Bytes::new(new_cap)
  let mut i = 0
  while i < self.len {
    nb[i] = self.buf[i]
    i = i + 1
  }
  self.buf = nb
}

fn DerWriter::push_byte(self : DerWriter, b : Byte) -> Unit {
  self.ensure(1)
  self.buf[self.len] = b
  self.len = self.len + 1
}

fn DerWriter::push_bytes(self : DerWriter, data : Bytes) -> Unit {
  let n = data.length()
  if n == 0 {
    return ()
  }
  self.ensure(n)
  let mut i = 0
  let base = self.len
  while i < n {
    self.buf[base + i] = data[i]
    i = i + 1
  }
  self.len = base + n
}

///| Encode an X.690 §8.1.2 identifier octet for short tags (`0 ≤ num ≤ 30`) or high-tag sentinel (`num = 31`).
#verify
pub fn encode_tag_first_byte(cls : TagClass, constructed : Bool, num : Int) -> Int {
  let prefix = (tag_class_code(cls) << 6) | (if constructed { 0x20 } else { 0 })
  let low = if num < 31 { num & 0x1F } else { 0x1F }
  prefix | low
}

fn DerWriter::write_tag(self : DerWriter, tag : Tag) -> Unit {
  if tag.number < 31 {
    self.push_byte(encode_tag_first_byte(tag.tag_class, tag.constructed, tag.number).to_byte())
  } else {
    self.push_byte(encode_tag_first_byte(tag.tag_class, tag.constructed, 31).to_byte())
    let tmp : FixedArray[Byte] = [b'\x00', b'\x00', b'\x00', b'\x00', b'\x00']
    let mut n = 0
    let mut x = tag.number
    tmp[0] = (x & 0x7F).to_byte()
    x = x >> 7
    n = 1
    while x > 0 {
      tmp[n] = ((x & 0x7F) | 0x80).to_byte()
      x = x >> 7
      n = n + 1
    }
    let mut i = n - 1
    while i >= 0 {
      self.push_byte(tmp[i])
      i = i - 1
    }
  }
}

fn DerWriter::write_length(self : DerWriter, len : Int) -> Unit {
  let nbytes = der_length_encoded_size(len)
  if nbytes == 1 {
    self.push_byte(len.to_byte())
  } else if nbytes == 2 {
    self.ensure(2)
    self.buf[self.len] = (0x81).to_byte()
    self.buf[self.len + 1] = len.to_byte()
    self.len = self.len + 2
  } else if nbytes == 3 {
    self.ensure(3)
    self.buf[self.len] = (0x82).to_byte()
    self.buf[self.len + 1] = (len >> 8).to_byte()
    self.buf[self.len + 2] = (len & 0xFF).to_byte()
    self.len = self.len + 3
  } else if nbytes == 4 {
    self.ensure(4)
    self.buf[self.len] = (0x83).to_byte()
    self.buf[self.len + 1] = (len >> 16).to_byte()
    self.buf[self.len + 2] = ((len >> 8) & 0xFF).to_byte()
    self.buf[self.len + 3] = (len & 0xFF).to_byte()
    self.len = self.len + 4
  } else {
    self.ensure(5)
    self.buf[self.len] = (0x84).to_byte()
    self.buf[self.len + 1] = (len >> 24).to_byte()
    self.buf[self.len + 2] = ((len >> 16) & 0xFF).to_byte()
    self.buf[self.len + 3] = ((len >> 8) & 0xFF).to_byte()
    self.buf[self.len + 4] = (len & 0xFF).to_byte()
    self.len = self.len + 5
  }
}

///| Finalize and return the written DER bytes.
pub fn DerWriter::to_bytes(self : DerWriter) -> Bytes {
  self.buf.slice(0, self.len)
}

///| Write a raw TLV element.
pub fn DerWriter::write_tlv(self : DerWriter, tag : Tag, content : Bytes) -> Unit {
  self.write_tag(tag)
  self.write_length(content.length())
  self.push_bytes(content)
}

///| Write a DER BOOLEAN.
pub fn DerWriter::write_bool(self : DerWriter, v : Bool) -> Unit {
  self.ensure(3)
  self.buf[self.len] = (0x01).to_byte()
  self.buf[self.len + 1] = (0x01).to_byte()
  self.buf[self.len + 2] = (if v { 0xFF } else { 0x00 }).to_byte()
  self.len = self.len + 3
}

///| Write a DER INTEGER from raw big-endian two's-complement bytes (canonicalized).
pub fn DerWriter::write_integer_bytes(self : DerWriter, raw : Bytes) -> Unit {
  let n = raw.length()
  if n == 0 {
    self.write_int64(0L)
    return ()
  }
  let mut start = 0
  while start + 1 < n {
    let b0 = raw[start].to_int()
    let b1 = raw[start + 1].to_int()
    if (b0 == 0x00 && (b1 & 0x80) == 0) || (b0 == 0xFF && (b1 & 0x80) != 0) {
      start = start + 1
    } else {
      break
    }
  }
  self.write_tlv(tag_integer, raw.slice(start, n))
}

///| Write a DER INTEGER from signed `Int64`.
pub fn DerWriter::write_int64(self : DerWriter, v : Int64) -> Unit {
  let tmp : FixedArray[Byte] = [b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00']
  let mut i = 7
  let mut x = v
  while i >= 0 {
    tmp[i] = (x & 0xFFL).to_int().to_byte()
    x = x >> 8
    i = i - 1
  }
  let mut start = 0
  while start < 7 {
    let b0 = tmp[start].to_int()
    let b1 = tmp[start + 1].to_int()
    if (b0 == 0x00 && (b1 & 0x80) == 0) || (b0 == 0xFF && (b1 & 0x80) != 0) {
      start = start + 1
    } else {
      break
    }
  }
  let count = 8 - start
  self.ensure(2 + count)
  self.buf[self.len] = (0x02).to_byte()
  self.buf[self.len + 1] = count.to_byte()
  let mut k = 0
  while k < count {
    self.buf[self.len + 2 + k] = tmp[start + k]
    k = k + 1
  }
  self.len = self.len + 2 + count
}

///| Write a DER INTEGER from unsigned `UInt64`.
pub fn DerWriter::write_uint64(self : DerWriter, v : UInt64) -> Unit {
  let tmp : FixedArray[Byte] = [b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00']
  let mut i = 8
  let mut x = v
  while i >= 1 {
    tmp[i] = (x & 0xFFUL).to_int64().to_int().to_byte()
    x = x >> 8
    i = i - 1
  }
  let mut start = 0
  while start < 8 {
    let b0 = tmp[start].to_int()
    let b1 = tmp[start + 1].to_int()
    if b0 == 0x00 && (b1 & 0x80) == 0 {
      start = start + 1
    } else {
      break
    }
  }
  let count = 9 - start
  self.ensure(2 + count)
  self.buf[self.len] = (0x02).to_byte()
  self.buf[self.len + 1] = count.to_byte()
  let mut k = 0
  while k < count {
    self.buf[self.len + 2 + k] = tmp[start + k]
    k = k + 1
  }
  self.len = self.len + 2 + count
}

///| Write a DER BIT STRING.
pub fn DerWriter::write_bit_string(self : DerWriter, unused_bits : Int, data : Bytes) -> Result[Unit, Asn1Error] {
  if unused_bits < 0 || unused_bits > 7 {
    return Err(Asn1Error::NonCanonical(0, "BIT STRING unused_bits must be 0..=7"))
  }
  let n = data.length()
  if n == 0 && unused_bits != 0 {
    return Err(Asn1Error::NonCanonical(0, "empty BIT STRING must have unused_bits == 0"))
  }
  if n > 0 && unused_bits > 0 {
    let mask = (1 << unused_bits) - 1
    if (data[n - 1].to_int() & mask) != 0 {
      return Err(Asn1Error::NonCanonical(n - 1, "BIT STRING unused trailing bits must be 0"))
    }
  }
  self.write_tag(tag_bit_string)
  self.write_length(n + 1)
  self.push_byte(unused_bits.to_byte())
  self.push_bytes(data)
  Ok(())
}

///| Write a DER OCTET STRING.
pub fn DerWriter::write_octet_string(self : DerWriter, data : Bytes) -> Unit {
  self.write_tlv(tag_octet_string, data)
}

///| Write a DER NULL.
pub fn DerWriter::write_null(self : DerWriter) -> Unit {
  self.ensure(2)
  self.buf[self.len] = (0x05).to_byte()
  self.buf[self.len + 1] = (0x00).to_byte()
  self.len = self.len + 2
}

///| Write a DER OBJECT IDENTIFIER from dotted string.
pub fn DerWriter::write_oid_str(self : DerWriter, oid : String) -> Result[Unit, Asn1Error] {
  let parsed = match parse_oid_str(oid) {
    Ok(o) => o
    Err(e) => return Err(e)
  }
  let raw = match encode_oid_bytes(parsed) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  self.write_tlv(tag_oid, raw)
  Ok(())
}

///| Write a DER UTF8String.
pub fn DerWriter::write_utf8_string(self : DerWriter, s : String) -> Unit {
  self.write_tlv(tag_utf8_string, s.to_bytes())
}

///| Write a DER PrintableString.
pub fn DerWriter::write_printable_string(self : DerWriter, s : String) -> Result[Unit, Asn1Error] {
  let b = s.to_bytes()
  let mut i = 0
  while i < b.length() {
    if !is_printable_byte(b[i].to_int()) {
      return Err(Asn1Error::InvalidString(i, "invalid PrintableString character"))
    }
    i = i + 1
  }
  self.write_tlv(tag_printable_string, b)
  Ok(())
}

///| Write a DER IA5String.
pub fn DerWriter::write_ia5_string(self : DerWriter, s : String) -> Result[Unit, Asn1Error] {
  let b = s.to_bytes()
  let mut i = 0
  while i < b.length() {
    if b[i].to_int() >= 0x80 {
      return Err(Asn1Error::InvalidString(i, "non-ASCII byte in IA5String"))
    }
    i = i + 1
  }
  self.write_tlv(tag_ia5_string, b)
  Ok(())
}

///| Write a DER SEQUENCE wrapping `content`.
pub fn DerWriter::write_sequence(self : DerWriter, content : Bytes) -> Unit {
  self.write_tlv(tag_sequence, content)
}

///| Write a DER SET wrapping `content`.
pub fn DerWriter::write_set(self : DerWriter, content : Bytes) -> Unit {
  self.write_tlv(tag_set, content)
}

fn compare_bytes_lex(a : Bytes, b : Bytes) -> Int {
  let na = a.length()
  let nb = b.length()
  let lim = if na < nb { na } else { nb }
  let mut i = 0
  while i < lim {
    let ba = a[i].to_int()
    let bb = b[i].to_int()
    if ba != bb {
      return ba - bb
    }
    i = i + 1
  }
  na - nb
}

///| Write a DER SET OF with canonical lexicographical sorting of encoded elements (ITU-T X.690 §11.6).
pub fn DerWriter::write_set_of_sorted(self : DerWriter, elements : Array[Bytes]) -> Unit {
  let n = elements.length()
  let sorted : Array[Bytes] = []
  let mut i = 0
  while i < n {
    sorted.push(elements[i])
    i = i + 1
  }
  // Insertion sort (stable, O(n^2) for tiny sets; use mergesort if large)
  i = 1
  while i < n {
    let key = sorted[i]
    let mut j = i - 1
    while j >= 0 && compare_bytes_lex(sorted[j], key) > 0 {
      sorted[j + 1] = sorted[j]
      j = j - 1
    }
    sorted[j + 1] = key
    i = i + 1
  }
  let mut total = 0
  i = 0
  while i < n {
    total = total + sorted[i].length()
    i = i + 1
  }
  self.write_tag(tag_set)
  self.write_length(total)
  i = 0
  while i < n {
    self.push_bytes(sorted[i])
    i = i + 1
  }
}

///| Write an EXPLICIT context-specific `[tag_num]` constructed element.
pub fn DerWriter::write_explicit_context(self : DerWriter, tag_num : Int, content : Bytes) -> Unit {
  self.write_tlv(Tag::context(tag_num, true), content)
}

fn encoded_tag_len(tag : Tag) -> Int {
  if tag.number < 31 {
    return 1
  }
  let mut n = 2
  let mut x = tag.number >> 7
  while x > 0 {
    n = n + 1
    x = x >> 7
  }
  n
}

fn encoded_length_len(len : Int) -> Int {
  if len < 0x80 {
    1
  } else if len <= 0xFF {
    2
  } else if len <= 0xFFFF {
    3
  } else if len <= 0xFFFFFF {
    4
  } else {
    5
  }
}

///| Encode a `DerElement` tree back to DER bytes 100% iteratively in O(N) time and memory.
pub fn encode_der_element(elem : DerElement) -> Bytes {
  if !elem.tag.constructed {
    let total = encoded_tag_len(elem.tag) + encoded_length_len(elem.value.length()) + elem.value.length()
    let w = DerWriter::with_capacity(total)
    w.write_tlv(elem.tag, elem.value)
    return w.to_bytes()
  }
  // Pass 1: iterative pre-order flatten so every parent precedes all its descendants.
  let nodes : Array[DerElement] = []
  let parents : Array[Int] = []
  let content_lens : Array[Int] = []
  let stack_elem : Array[DerElement] = [elem]
  let stack_parent : Array[Int] = [-1]
  while stack_elem.length() > 0 {
    let cur = match stack_elem.pop() {
      Some(e) => e
      None => break
    }
    let par = match stack_parent.pop() {
      Some(p) => p
      None => -1
    }
    let id = nodes.length()
    nodes.push(cur)
    parents.push(par)
    if cur.tag.constructed {
      content_lens.push(0)
      let mut ci = cur.children.length() - 1
      while ci >= 0 {
        stack_elem.push(cur.children[ci])
        stack_parent.push(id)
        ci = ci - 1
      }
    } else {
      content_lens.push(cur.value.length())
    }
  }
  // Bottom-up exact content-length accumulation in reverse pre-order (strictly O(N)).
  let m = nodes.length()
  let mut id = m - 1
  while id >= 1 {
    let cl = content_lens[id]
    let tlv_len = encoded_tag_len(nodes[id].tag) + encoded_length_len(cl) + cl
    let p = parents[id]
    content_lens[p] = content_lens[p] + tlv_len
    id = id - 1
  }
  // Pass 2: single exact-sized forward write in pre-order (zero intermediate buffers).
  let root_cl = content_lens[0]
  let total = encoded_tag_len(nodes[0].tag) + encoded_length_len(root_cl) + root_cl
  let w = DerWriter::with_capacity(total)
  id = 0
  while id < m {
    let node = nodes[id]
    w.write_tag(node.tag)
    w.write_length(content_lens[id])
    if !node.tag.constructed {
      w.push_bytes(node.value)
    }
    id = id + 1
  }
  w.to_bytes()
}
