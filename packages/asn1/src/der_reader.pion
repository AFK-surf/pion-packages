pub fn DerReader::read_bmp_string(self : DerReader) -> Result[String, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read an ASN.1 DirectoryString (UTF8String / PrintableString / IA5String / VisibleString / BMPString / T61String).
pub fn DerReader::read_any_string(self : DerReader) -> Result[String, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

