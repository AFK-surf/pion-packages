pub fn DerReader::read_printable_string(self : DerReader) -> Result[String, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read a strict DER IA5String.
pub fn DerReader::read_ia5_string(self : DerReader) -> Result[String, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
