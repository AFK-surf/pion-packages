///| Strict ITU-T X.690 DER reader and iterative generic element parser (stub for Red phase).

///| Zero-copy slice reader over a DER `Bytes` buffer.
pub struct DerReader {
  data : Bytes
  mut pos : Int
  end : Int
}

///| Create a `DerReader` covering the entire buffer.
pub fn DerReader::new(data : Bytes) -> DerReader {
  DerReader::{ data: data, pos: 0, end: data.length() }
}

///| Create a `DerReader` covering `[start, end)`.
pub fn DerReader::slice(data : Bytes, start : Int, end : Int) -> DerReader {
  DerReader::{ data: data, pos: start, end: end }
}

///| Number of unread bytes remaining.
pub fn DerReader::remaining(self : DerReader) -> Int {
  self.end - self.pos
}

///| Whether the reader has reached its end.
pub fn DerReader::is_eof(self : DerReader) -> Bool {
  self.pos >= self.end
}

///| Peek the next tag without advancing `pos`.
pub fn DerReader::peek_tag(self : DerReader) -> Result[Tag, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read the next strict DER TLV header and advance `pos` to `tlv_end`.
pub fn DerReader::read_header(self : DerReader) -> Result[DerHeader, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read the next TLV and return its full encoded bytes (tag + len + content).
pub fn DerReader::read_tlv_bytes(self : DerReader) -> Result[Bytes, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read a strict DER BOOLEAN (`0x00` or `0xFF` only).
pub fn DerReader::read_bool(self : DerReader) -> Result[Bool, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read a strict DER INTEGER as raw minimal two's-complement big-endian bytes.
pub fn DerReader::read_integer_bytes(self : DerReader) -> Result[Bytes, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read a strict DER INTEGER as signed `Int64`.
pub fn DerReader::read_int64(self : DerReader) -> Result[Int64, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read a strict DER non-negative INTEGER as `UInt64`.
pub fn DerReader::read_uint64(self : DerReader) -> Result[UInt64, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read a strict DER BIT STRING.
pub fn DerReader::read_bit_string(self : DerReader) -> Result[BitString, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read a strict DER OCTET STRING.
pub fn DerReader::read_octet_string(self : DerReader) -> Result[Bytes, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read a strict DER NULL (must have length 0).
pub fn DerReader::read_null(self : DerReader) -> Result[Unit, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read a strict DER OBJECT IDENTIFIER.
pub fn DerReader::read_oid(self : DerReader) -> Result[Oid, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

///| Read a strict DER UTF8String.
pub fn DerReader::read_utf8_string(self : DerReader) -> Result[String, Asn1Error] {
  Err(Asn1Error::InvalidTag(self.pos, "not implemented"))
}

