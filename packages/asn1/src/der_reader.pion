///| Strict ITU-T X.690 DER reader and 100% iterative generic element parser.

///| Zero-copy slice reader over a DER `Bytes` buffer.
pub struct DerReader {
  data : Bytes
  mut pos : Int
  end : Int
}

///| Create a `DerReader` covering the entire buffer.
pub fn DerReader::new(data : Bytes) -> DerReader {
  DerReader::{ data: data, pos: 0, end: data.length() }
}

///| Create a `DerReader` covering `[start, end)`.
pub fn DerReader::slice(data : Bytes, start : Int, end : Int) -> DerReader {
  DerReader::{ data: data, pos: start, end: end }
}

///| Number of unread bytes remaining.
pub fn DerReader::remaining(self : DerReader) -> Int {
  self.end - self.pos
}

///| Whether the reader has reached its end.
pub fn DerReader::is_eof(self : DerReader) -> Bool {
  self.pos >= self.end
}

///| Decode the tag class from an X.690 identifier octet (bits 7..6).
#verify
pub fn decode_tag_class_byte(b0 : Int) -> TagClass {
  tag_class_from_code((b0 >> 6) & 3)
}

///| Decode the constructed/primitive flag from an X.690 identifier octet (bit 5).
#verify
pub fn decode_tag_constructed_byte(b0 : Int) -> Bool {
  (b0 & 0x20) != 0
}

///| Decode the low 5-bit tag number from an X.690 identifier octet (0..30, or 31 for high-tag sentinel).
#verify
pub fn decode_tag_low_byte(b0 : Int) -> Int {
  b0 & 0x1F
}

///| X.690 §11.1 DER BOOLEAN canonical byte check (`0x00` for false, `0xFF` for true).
#verify
pub fn is_canonical_der_bool_byte(v : Int) -> Bool {
  v == 0x00 || v == 0xFF
}

///| X.690 §8.3.2 DER INTEGER minimal two's-complement leading-pair check:
///| rejects redundant leading `0x00` (when next MSB is 0) and `0xFF` (when next MSB is 1).
#verify
pub fn is_canonical_der_int_pair(b0 : Int, b1 : Int) -> Bool {
  if b0 == 0x00 && (b1 & 0x80) == 0 {
    false
  } else if b0 == 0xFF && (b1 & 0x80) != 0 {
    false
  } else {
    true
  }
}

///| X.690 §8.6 / §11.2.2 DER BIT STRING trailing-bit padding check.
#verify
pub fn is_valid_bit_string_padding(data_len : Int, unused_bits : Int, last_byte : Int) -> Bool {
  if unused_bits < 0 || unused_bits > 7 {
    false
  } else if data_len == 0 {
    unused_bits == 0
  } else if unused_bits == 0 {
    true
  } else {
    let mask = (1 << unused_bits) - 1
    (last_byte & mask) == 0
  }
}

///| X.690 §8.1.3 / §10.1 canonical DER length byte count (`1..5` for `0 ≤ len ≤ 2^31 - 1`).
#verify
pub fn der_length_encoded_size(len : Int) -> Int {
  if len < 0x80 {
    1
  } else if len <= 0xFF {
    2
  } else if len <= 0xFFFF {
    3
  } else if len <= 0xFFFFFF {
    4
  } else {
    5
  }
}

fn decode_tag_at(data : Bytes, pos : Int, end : Int) -> Result[(Tag, Int), Asn1Error] {
  if pos >= end {
    return Err(Asn1Error::UnexpectedEof(pos))
  }
  let b0 = data[pos].to_int()
  let tag_class = decode_tag_class_byte(b0)
  let constructed = decode_tag_constructed_byte(b0)
  let low = decode_tag_low_byte(b0)
  if low < 31 {
    return Ok((Tag::{ tag_class: tag_class, constructed: constructed, number: low }, pos + 1))
  }
  // High-tag-number form (ITU-T X.690 §8.1.2.4)
  let mut p = pos + 1
  if p >= end {
    return Err(Asn1Error::UnexpectedEof(p))
  }
  let first = data[p].to_int()
  if first == 0x80 {
    return Err(Asn1Error::NonCanonical(p, "high tag number has leading 0x80"))
  }
  let mut num = 0
  let mut cont = true
  while cont {
    if p >= end {
      return Err(Asn1Error::UnexpectedEof(p))
    }
    let b = data[p].to_int()
    p = p + 1
    if num > (0x7FFFFFFF >> 7) {
      return Err(Asn1Error::InvalidTag(pos, "high tag number overflow"))
    }
    num = (num << 7) | (b & 0x7F)
    cont = (b & 0x80) != 0
  }
  if num < 31 {
    return Err(Asn1Error::NonCanonical(pos, "tag number < 31 encoded in high-tag form"))
  }
  Ok((Tag::{ tag_class: tag_class, constructed: constructed, number: num }, p))
}

fn decode_header_at(data : Bytes, pos : Int, end : Int) -> Result[DerHeader, Asn1Error] {
  if pos >= end {
    return Err(Asn1Error::UnexpectedEof(pos))
  }
  let b0 = data[pos].to_int()
  let low = b0 & 0x1F
  let mut tag : Tag = tag_null
  let mut len_pos = pos + 1
  if low < 31 {
    let cls_code = (b0 >> 6) & 3
    let tag_class = match cls_code {
      0 => TagClass::Universal
      1 => TagClass::Application
      2 => TagClass::ContextSpecific
      _ => TagClass::Private
    }
    tag = Tag::{ tag_class: tag_class, constructed: (b0 & 0x20) != 0, number: low }
  } else {
    match decode_tag_at(data, pos, end) {
      Ok((t, lp)) => {
        tag = t
        len_pos = lp
      }
      Err(e) => return Err(e)
    }
  }
  if len_pos >= end {
    return Err(Asn1Error::UnexpectedEof(len_pos))
  }
  let l0 = data[len_pos].to_int()
  let mut content_start = len_pos + 1
  let mut content_len = 0
  if l0 < 0x80 {
    content_len = l0
  } else if l0 == 0x80 {
    return Err(Asn1Error::IndefiniteLength(len_pos))
  } else {
    let num_octets = l0 & 0x7F
    if num_octets > 4 {
      return Err(Asn1Error::InvalidLength(len_pos, "length exceeds 4 octets"))
    }
    if len_pos + 1 + num_octets > end {
      return Err(Asn1Error::UnexpectedEof(len_pos + 1))
    }
    let first_len_byte = data[len_pos + 1].to_int()
    if first_len_byte == 0 {
      return Err(Asn1Error::NonCanonical(len_pos, "non-minimal length (leading 0x00)"))
    }
    if num_octets == 4 && first_len_byte >= 0x80 {
      return Err(Asn1Error::InvalidLength(len_pos, "length exceeds 2 GiB"))
    }
    let mut acc = 0
    let mut i = 0
    while i < num_octets {
      acc = (acc << 8) | data[len_pos + 1 + i].to_int()
      i = i + 1
    }
    if acc < 0x80 {
      return Err(Asn1Error::NonCanonical(len_pos, "short length encoded in long form"))
    }
    content_len = acc
    content_start = len_pos + 1 + num_octets
  }
  if content_len < 0 || content_len > end - content_start {
    return Err(Asn1Error::UnexpectedEof(content_start))
  }
  Ok(DerHeader::{
    tag: tag,
    tlv_start: pos,
    content_start: content_start,
    content_len: content_len,
    tlv_end: content_start + content_len,
  })
}

///| Peek the next tag without advancing `pos`.
pub fn DerReader::peek_tag(self : DerReader) -> Result[Tag, Asn1Error] {
  match decode_tag_at(self.data, self.pos, self.end) {
    Ok((tag, _)) => Ok(tag)
    Err(e) => Err(e)
  }
}

///| Read the next strict DER TLV header and advance `pos` to `tlv_end`.
pub fn DerReader::read_header(self : DerReader) -> Result[DerHeader, Asn1Error] {
  match decode_header_at(self.data, self.pos, self.end) {
    Ok(h) => {
      self.pos = h.tlv_end
      Ok(h)
    }
    Err(e) => Err(e)
  }
}

///| Read the next TLV and return its full encoded bytes (tag + len + content).
pub fn DerReader::read_tlv_bytes(self : DerReader) -> Result[Bytes, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  Ok(self.data.slice(h.tlv_start, h.tlv_end))
}

///| Read a strict DER BOOLEAN (`0x00` or `0xFF` only).
pub fn DerReader::read_bool(self : DerReader) -> Result[Bool, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_boolean) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected BOOLEAN"))
  }
  if h.content_len != 1 {
    return Err(Asn1Error::NonCanonical(h.content_start, "BOOLEAN length must be 1"))
  }
  let v = self.data[h.content_start].to_int()
  if !is_canonical_der_bool_byte(v) {
    return Err(Asn1Error::NonCanonical(h.content_start, "DER BOOLEAN must be 0x00 or 0xFF"))
  }
  Ok(v == 0xFF)
}

fn validate_der_integer_slice(data : Bytes, start : Int, len : Int) -> Result[Unit, Asn1Error] {
  if len <= 0 {
    return Err(Asn1Error::NonCanonical(start, "INTEGER must not be empty"))
  }
  if len >= 2 {
    let b0 = data[start].to_int()
    let b1 = data[start + 1].to_int()
    if !is_canonical_der_int_pair(b0, b1) {
      if b0 == 0x00 {
        return Err(Asn1Error::NonCanonical(start, "INTEGER has redundant leading 0x00"))
      }
      return Err(Asn1Error::NonCanonical(start, "INTEGER has redundant leading 0xFF"))
    }
  }
  Ok(())
}

///| Read a strict DER INTEGER as raw minimal two's-complement big-endian bytes.
pub fn DerReader::read_integer_bytes(self : DerReader) -> Result[Bytes, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_integer) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected INTEGER"))
  }
  match validate_der_integer_slice(self.data, h.content_start, h.content_len) {
    Ok(_) => Ok(self.data.slice(h.content_start, h.tlv_end))
    Err(e) => Err(e)
  }
}

///| Read a strict DER INTEGER as signed `Int64`.
pub fn DerReader::read_int64(self : DerReader) -> Result[Int64, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_integer) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected INTEGER"))
  }
  match validate_der_integer_slice(self.data, h.content_start, h.content_len) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if h.content_len > 8 {
    return Err(Asn1Error::IntegerOverflow(h.content_start, "INTEGER exceeds Int64"))
  }
  let b0 = self.data[h.content_start].to_int()
  let mut acc : Int64 = if (b0 & 0x80) != 0 { -1L } else { 0L }
  let mut i = 0
  while i < h.content_len {
    acc = (acc << 8) | self.data[h.content_start + i].to_int().to_int64()
    i = i + 1
  }
  Ok(acc)
}

///| Read a strict DER non-negative INTEGER as `UInt64`.
pub fn DerReader::read_uint64(self : DerReader) -> Result[UInt64, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_integer) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected INTEGER"))
  }
  match validate_der_integer_slice(self.data, h.content_start, h.content_len) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let b0 = self.data[h.content_start].to_int()
  if (b0 & 0x80) != 0 {
    return Err(Asn1Error::IntegerOverflow(h.content_start, "negative INTEGER for UInt64"))
  }
  let mut start = h.content_start
  let mut len = h.content_len
  if b0 == 0 && len > 1 {
    start = start + 1
    len = len - 1
  }
  if len > 8 {
    return Err(Asn1Error::IntegerOverflow(h.content_start, "INTEGER exceeds UInt64"))
  }
  let mut acc = 0UL
  let mut i = 0
  while i < len {
    acc = (acc << 8) | self.data[start + i].to_int().to_int64().to_uint64()
    i = i + 1
  }
  Ok(acc)
}

///| Read a strict DER BIT STRING.
pub fn DerReader::read_bit_string(self : DerReader) -> Result[BitString, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_bit_string) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected BIT STRING"))
  }
  if h.content_len < 1 {
    return Err(Asn1Error::NonCanonical(h.content_start, "BIT STRING must have at least 1 byte"))
  }
  let unused = self.data[h.content_start].to_int()
  let payload_len = h.content_len - 1
  let last = if payload_len > 0 { self.data[h.tlv_end - 1].to_int() } else { 0 }
  if !is_valid_bit_string_padding(payload_len, unused, last) {
    return Err(Asn1Error::NonCanonical(h.content_start, "invalid DER BIT STRING padding"))
  }
  if payload_len == 0 {
    return Ok(BitString::{ unused_bits: 0, bytes: Bytes::new(0) })
  }
  Ok(BitString::{
    unused_bits: unused,
    bytes: self.data.slice(h.content_start + 1, h.tlv_end),
  })
}

///| Read a strict DER OCTET STRING.
pub fn DerReader::read_octet_string(self : DerReader) -> Result[Bytes, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_octet_string) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected OCTET STRING"))
  }
  Ok(self.data.slice(h.content_start, h.tlv_end))
}

///| Read a strict DER NULL (must have length 0).
pub fn DerReader::read_null(self : DerReader) -> Result[Unit, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_null) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected NULL"))
  }
  if h.content_len != 0 {
    return Err(Asn1Error::NonCanonical(h.content_start, "NULL must have length 0"))
  }
  Ok(())
}

///| Read a strict DER OBJECT IDENTIFIER.
pub fn DerReader::read_oid(self : DerReader) -> Result[Oid, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_oid) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected OBJECT IDENTIFIER"))
  }
  decode_oid_slice(self.data, h.content_start, h.content_len)
}

///| Fast path: read a strict DER OBJECT IDENTIFIER directly as its dotted string.
pub fn DerReader::read_oid_str(self : DerReader) -> Result[String, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_oid) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected OBJECT IDENTIFIER"))
  }
  decode_oid_str_slice(self.data, h.content_start, h.content_len)
}

///| Strict UTF-8 validation over `[start, end)`.
pub fn is_valid_utf8_slice(data : Bytes, start : Int, end : Int) -> Bool {
  let mut i = start
  while i < end {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
      while i < end && data[i].to_int() < 0x80 {
        i = i + 1
      }
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= end {
        return false
      }
      if (data[i + 1].to_int() & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return false
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

pub fn is_printable_byte(b : Int) -> Bool {
  (b >= 65 && b <= 90) ||
  (b >= 97 && b <= 122) ||
  (b >= 48 && b <= 57) ||
  b == 32 ||
  b == 39 ||
  b == 40 ||
  b == 41 ||
  b == 43 ||
  b == 44 ||
  b == 45 ||
  b == 46 ||
  b == 47 ||
  b == 58 ||
  b == 61 ||
  b == 63
}

pub fn is_numeric_byte(b : Int) -> Bool {
  (b >= 48 && b <= 57) || b == 32
}

pub fn decode_universal_string_slice(data : Bytes, start : Int, end : Int) -> Result[String, Asn1Error] {
  let len = end - start
  if (len & 3) != 0 {
    return Err(Asn1Error::InvalidString(start, "UniversalString must have length multiple of 4"))
  }
  let out : Array[Byte] = []
  let mut i = start
  while i < end {
    let cp = (data[i].to_int() << 24) |
    (data[i + 1].to_int() << 16) |
    (data[i + 2].to_int() << 8) |
    data[i + 3].to_int()
    if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
      return Err(Asn1Error::InvalidString(i, "invalid Unicode scalar in UniversalString"))
    }
    if cp < 0x80 {
      out.push(cp.to_byte())
    } else if cp < 0x800 {
      out.push((0xC0 | (cp >> 6)).to_byte())
      out.push((0x80 | (cp & 0x3F)).to_byte())
    } else if cp < 0x10000 {
      out.push((0xE0 | (cp >> 12)).to_byte())
      out.push((0x80 | ((cp >> 6) & 0x3F)).to_byte())
      out.push((0x80 | (cp & 0x3F)).to_byte())
    } else {
      out.push((0xF0 | (cp >> 18)).to_byte())
      out.push((0x80 | ((cp >> 12) & 0x3F)).to_byte())
      out.push((0x80 | ((cp >> 6) & 0x3F)).to_byte())
      out.push((0x80 | (cp & 0x3F)).to_byte())
    }
    i = i + 4
  }
  let res = Bytes::new(out.length())
  let mut k = 0
  while k < out.length() {
    res[k] = out[k]
    k = k + 1
  }
  Ok(res.to_string())
}

pub fn decode_bmp_string_slice(data : Bytes, start : Int, end : Int) -> Result[String, Asn1Error] {
  let len = end - start
  if (len & 1) != 0 {
    return Err(Asn1Error::InvalidString(start, "BMPString must have even byte length"))
  }
  // Worst case UTF-8 length is 3 bytes per BMP code unit (1.5x input bytes)
  let out : Array[Byte] = []
  let mut i = start
  while i < end {
    let cp = (data[i].to_int() << 8) | data[i + 1].to_int()
    if cp >= 0xD800 && cp <= 0xDFFF {
      return Err(Asn1Error::InvalidString(i, "surrogate code point in BMPString"))
    }
    if cp < 0x80 {
      out.push(cp.to_byte())
    } else if cp < 0x800 {
      out.push((0xC0 | (cp >> 6)).to_byte())
      out.push((0x80 | (cp & 0x3F)).to_byte())
    } else {
      out.push((0xE0 | (cp >> 12)).to_byte())
      out.push((0x80 | ((cp >> 6) & 0x3F)).to_byte())
      out.push((0x80 | (cp & 0x3F)).to_byte())
    }
    i = i + 2
  }
  let res = Bytes::new(out.length())
  let mut k = 0
  while k < out.length() {
    res[k] = out[k]
    k = k + 1
  }
  Ok(res.to_string())
}

///| Read a strict DER UTF8String.
pub fn DerReader::read_utf8_string(self : DerReader) -> Result[String, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_utf8_string) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected UTF8String"))
  }
  if !is_valid_utf8_slice(self.data, h.content_start, h.tlv_end) {
    return Err(Asn1Error::InvalidUtf8(h.content_start))
  }
  Ok(self.data.slice(h.content_start, h.tlv_end).to_string())
}

///| Read a strict DER PrintableString.
pub fn DerReader::read_printable_string(self : DerReader) -> Result[String, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_printable_string) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected PrintableString"))
  }
  let mut i = h.content_start
  while i < h.tlv_end {
    if !is_printable_byte(self.data[i].to_int()) {
      return Err(Asn1Error::InvalidString(i, "invalid PrintableString character"))
    }
    i = i + 1
  }
  Ok(self.data.slice(h.content_start, h.tlv_end).to_string())
}

///| Read a strict DER IA5String.
pub fn DerReader::read_ia5_string(self : DerReader) -> Result[String, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_ia5_string) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected IA5String"))
  }
  let mut i = h.content_start
  while i < h.tlv_end {
    if self.data[i].to_int() >= 0x80 {
      return Err(Asn1Error::InvalidString(i, "non-ASCII byte in IA5String"))
    }
    i = i + 1
  }
  Ok(self.data.slice(h.content_start, h.tlv_end).to_string())
}

///| Read a strict DER VisibleString.
pub fn DerReader::read_visible_string(self : DerReader) -> Result[String, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_visible_string) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected VisibleString"))
  }
  let mut i = h.content_start
  while i < h.tlv_end {
    let b = self.data[i].to_int()
    if b < 0x20 || b > 0x7E {
      return Err(Asn1Error::InvalidString(i, "invalid VisibleString byte"))
    }
    i = i + 1
  }
  Ok(self.data.slice(h.content_start, h.tlv_end).to_string())
}

///| Read a strict DER BMPString (UCS-2 / UTF-16BE).
pub fn DerReader::read_bmp_string(self : DerReader) -> Result[String, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_bmp_string) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected BMPString"))
  }
  decode_bmp_string_slice(self.data, h.content_start, h.tlv_end)
}

///| Read an ASN.1 DirectoryString (UTF8String / PrintableString / IA5String / VisibleString / BMPString / T61String).
pub fn DerReader::read_any_string(self : DerReader) -> Result[String, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !tag_class_equals(h.tag.tag_class, TagClass::Universal) || h.tag.constructed {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected ASN.1 string"))
  }
  if h.tag.number == tag_num_utf8_string {
    if !is_valid_utf8_slice(self.data, h.content_start, h.tlv_end) {
      return Err(Asn1Error::InvalidUtf8(h.content_start))
    }
    return Ok(self.data.slice(h.content_start, h.tlv_end).to_string())
  }
  if h.tag.number == tag_num_printable_string {
    let mut i = h.content_start
    while i < h.tlv_end {
      if !is_printable_byte(self.data[i].to_int()) {
        return Err(Asn1Error::InvalidString(i, "invalid PrintableString character"))
      }
      i = i + 1
    }
    return Ok(self.data.slice(h.content_start, h.tlv_end).to_string())
  }
  if h.tag.number == tag_num_ia5_string {
    let mut i = h.content_start
    while i < h.tlv_end {
      if self.data[i].to_int() >= 0x80 {
        return Err(Asn1Error::InvalidString(i, "non-ASCII byte in IA5String"))
      }
      i = i + 1
    }
    return Ok(self.data.slice(h.content_start, h.tlv_end).to_string())
  }
  if h.tag.number == tag_num_visible_string {
    let mut i = h.content_start
    while i < h.tlv_end {
      let b = self.data[i].to_int()
      if b < 0x20 || b > 0x7E {
        return Err(Asn1Error::InvalidString(i, "invalid VisibleString byte"))
      }
      i = i + 1
    }
    return Ok(self.data.slice(h.content_start, h.tlv_end).to_string())
  }
  if h.tag.number == tag_num_bmp_string {
    return decode_bmp_string_slice(self.data, h.content_start, h.tlv_end)
  }
  if h.tag.number == tag_num_t61_string {
    // Legacy T61String/TeletexString: treat as ISO-8859-1 -> UTF-8
    let out : Array[Byte] = []
    let mut i = h.content_start
    while i < h.tlv_end {
      let b = self.data[i].to_int()
      if b < 0x80 {
        out.push(b.to_byte())
      } else {
        out.push((0xC0 | (b >> 6)).to_byte())
        out.push((0x80 | (b & 0x3F)).to_byte())
      }
      i = i + 1
    }
    let res = Bytes::new(out.length())
    let mut k = 0
    while k < out.length() {
      res[k] = out[k]
      k = k + 1
    }
    return Ok(res.to_string())
  }
  Err(Asn1Error::UnexpectedTag(h.tlv_start, "unsupported ASN.1 string tag"))
}

///| Read a strict DER UTCTime (RFC 5280 `YYMMDDHHMMSSZ`) as Unix seconds.
pub fn DerReader::read_utc_time(self : DerReader) -> Result[Int64, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_utc_time) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected UTCTime"))
  }
  parse_utc_time_slice(self.data, h.content_start, h.content_len)
}

///| Read a strict DER GeneralizedTime (RFC 5280 `YYYYMMDDHHMMSSZ`) as Unix seconds.
pub fn DerReader::read_generalized_time(self : DerReader) -> Result[Int64, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_generalized_time) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected GeneralizedTime"))
  }
  parse_generalized_time_slice(self.data, h.content_start, h.content_len)
}

///| Read either UTCTime or GeneralizedTime as Unix seconds.
pub fn DerReader::read_time(self : DerReader) -> Result[Int64, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if h.tag.equals(tag_utc_time) {
    parse_utc_time_slice(self.data, h.content_start, h.content_len)
  } else if h.tag.equals(tag_generalized_time) {
    parse_generalized_time_slice(self.data, h.content_start, h.content_len)
  } else {
    Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected UTCTime or GeneralizedTime"))
  }
}

///| Read a SEQUENCE and return a sub-`DerReader` over its contents.
pub fn DerReader::read_sequence(self : DerReader) -> Result[DerReader, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_sequence) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected SEQUENCE"))
  }
  Ok(DerReader::{ data: self.data, pos: h.content_start, end: h.tlv_end })
}

///| Read a SET and return a sub-`DerReader` over its contents.
pub fn DerReader::read_set(self : DerReader) -> Result[DerReader, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(tag_set) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected SET"))
  }
  Ok(DerReader::{ data: self.data, pos: h.content_start, end: h.tlv_end })
}

///| Read an EXPLICIT context-specific `[tag_num]` wrapper and return a sub-`DerReader`.
pub fn DerReader::read_explicit_context(self : DerReader, tag_num : Int) -> Result[DerReader, Asn1Error] {
  let h = match self.read_header() {
    Ok(hdr) => hdr
    Err(e) => return Err(e)
  }
  if !h.tag.equals(Tag::context(tag_num, true)) {
    return Err(Asn1Error::UnexpectedTag(h.tlv_start, "expected explicit context tag"))
  }
  Ok(DerReader::{ data: self.data, pos: h.content_start, end: h.tlv_end })
}

///| Skip one TLV element.
pub fn DerReader::skip_element(self : DerReader) -> Result[Unit, Asn1Error] {
  match self.read_header() {
    Ok(_) => Ok(())
    Err(e) => Err(e)
  }
}

struct ParseFrame {
  tag : Tag
  mut pos : Int
  end : Int
  children : Array[DerElement]
}

///| Parse a full DER buffer into a `DerElement` tree using default `DecodeLimits`.
pub fn parse_der_element(data : Bytes) -> Result[DerElement, Asn1Error] {
  parse_der_element_with_limits(data, DecodeLimits::default())
}

fn validate_tree_tag(h : DerHeader) -> Result[Unit, Asn1Error] {
  match h.tag.tag_class {
    TagClass::Universal => {
      if h.tag.number == 0 {
        return Err(Asn1Error::InvalidTag(h.tlv_start, "UNIVERSAL 0 (EOC) is forbidden in DER"))
      }
      if (h.tag.number == tag_num_sequence || h.tag.number == tag_num_set) && !h.tag.constructed {
        return Err(Asn1Error::NonCanonical(h.tlv_start, "SEQUENCE/SET must be constructed in DER"))
      }
    }
    _ => ()
  }
  Ok(())
}

///| Parse a full DER buffer into a `DerElement` tree 100% iteratively under explicit `DecodeLimits`.
pub fn parse_der_element_with_limits(data : Bytes, limits : DecodeLimits) -> Result[DerElement, Asn1Error] {
  let n = data.length()
  if n > limits.max_bytes {
    return Err(Asn1Error::SizeLimitExceeded(n))
  }
  let eff_max_depth = if limits.max_depth > max_safe_depth { max_safe_depth } else { limits.max_depth }
  let root_hdr = match decode_header_at(data, 0, n) {
    Ok(h) => h
    Err(e) => return Err(e)
  }
  match validate_tree_tag(root_hdr) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if root_hdr.tlv_end != n {
    return Err(Asn1Error::TrailingBytes(root_hdr.tlv_end, n - root_hdr.tlv_end))
  }
  if !root_hdr.tag.constructed {
    return Ok(DerElement::{
      tag: root_hdr.tag,
      value: data.slice(root_hdr.content_start, root_hdr.tlv_end),
      children: [],
    })
  }
  if eff_max_depth < 1 {
    return Err(Asn1Error::DepthLimitExceeded(1))
  }
  let stack : Array[ParseFrame] = []
  stack.push(ParseFrame::{
    tag: root_hdr.tag,
    pos: root_hdr.content_start,
    end: root_hdr.tlv_end,
    children: [],
  })
  let mut elem_count = 1
  while stack.length() > 0 {
    let top_idx = stack.length() - 1
    let top = stack[top_idx]
    if top.pos >= top.end {
      let finished = DerElement::{
        tag: top.tag,
        value: Bytes::new(0),
        children: top.children,
      }
      let _ = stack.pop()
      if stack.length() == 0 {
        return Ok(finished)
      }
      stack[stack.length() - 1].children.push(finished)
    } else {
      let h = match decode_header_at(data, top.pos, top.end) {
        Ok(hdr) => hdr
        Err(e) => return Err(e)
      }
      match validate_tree_tag(h) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      top.pos = h.tlv_end
      elem_count = elem_count + 1
      if elem_count > limits.max_elements {
        return Err(Asn1Error::ElementLimitExceeded(elem_count))
      }
      if h.tag.constructed {
        if stack.length() >= eff_max_depth {
          return Err(Asn1Error::DepthLimitExceeded(stack.length() + 1))
        }
        stack.push(ParseFrame::{
          tag: h.tag,
          pos: h.content_start,
          end: h.tlv_end,
          children: [],
        })
      } else {
        top.children.push(DerElement::{
          tag: h.tag,
          value: data.slice(h.content_start, h.tlv_end),
          children: [],
        })
      }
    }
  }
  Err(Asn1Error::UnexpectedEof(0))
}
