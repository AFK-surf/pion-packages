///| RFC 5280 UTCTime and GeneralizedTime parsing and Unix timestamp conversion.

///| Gregorian leap year predicate (4/100/400 rule).
#verify
pub fn is_leap_year(year : Int) -> Bool {
  (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)
}

///| Number of days in Gregorian `(year, month)` (`0` if `month ∉ [1, 12]`).
#verify
pub fn days_in_month(year : Int, month : Int) -> Int {
  if month == 1 || month == 3 || month == 5 || month == 7 || month == 8 || month == 10 || month == 12 {
    31
  } else if month == 4 || month == 6 || month == 9 || month == 11 {
    30
  } else if month == 2 {
    if is_leap_year(year) { 29 } else { 28 }
  } else {
    0
  }
}

///| RFC 5280 §4.1.2.5.1 UTCTime 2-digit year expansion (`50..99 → 1950..1999`, `0..49 → 2000..2049`).
pub fn utc_time_expand_year(yy : Int) -> Int {
  if yy >= 50 { 1900 + yy } else { 2000 + yy }
}

///| Validate clock fields `hour ∈ [0, 23]`, `min ∈ [0, 59]`, `sec ∈ [0, 59]`.
pub fn is_valid_hms(hour : Int, min : Int, sec : Int) -> Bool {
  hour >= 0 && hour <= 23 && min >= 0 && min <= 59 && sec >= 0 && sec <= 59
}

///| Howard Hinnant's civil-from-days inverse: days since 1970-01-01.
fn days_from_civil(year : Int, month : Int, day : Int) -> Int64 {
  let y = (if month <= 2 { year - 1 } else { year }).to_int64()
  let era = (if y >= 0L { y } else { y - 399L }) / 400L
  let yoe = y - era * 400L
  let m = month.to_int64()
  let d = day.to_int64()
  let doy = (153L * (if m > 2L { m - 3L } else { m + 9L }) + 2L) / 5L + d - 1L
  let doe = yoe * 365L + yoe / 4L - yoe / 100L + doy
  era * 146097L + doe - 719468L
}

fn parse_2_digits_bytes(data : Bytes, off : Int) -> Int {
  let c0 = data[off].to_int()
  let c1 = data[off + 1].to_int()
  if c0 < 48 || c0 > 57 || c1 < 48 || c1 > 57 {
    return -1
  }
  (c0 - 48) * 10 + (c1 - 48)
}

fn validate_and_to_unix(
  year : Int,
  month : Int,
  day : Int,
  hour : Int,
  min : Int,
  sec : Int,
  off : Int,
) -> Result[Int64, Asn1Error] {
  if month < 1 || month > 12 {
    return Err(Asn1Error::InvalidTime(off, "month out of range"))
  }
  let dim = days_in_month(year, month)
  if day < 1 || day > dim {
    return Err(Asn1Error::InvalidTime(off, "day out of range"))
  }
  if !is_valid_hms(hour, min, sec) {
    return Err(Asn1Error::InvalidTime(off, "time component out of range"))
  }
  let days = days_from_civil(year, month, day)
  Ok(days * 86400L + hour.to_int64() * 3600L + min.to_int64() * 60L + sec.to_int64())
}

///| Parse RFC 5280 UTCTime (`YYMMDDHHMMSSZ`) from a byte slice `[start, start + len)`.
pub fn parse_utc_time_slice(data : Bytes, start : Int, len : Int) -> Result[Int64, Asn1Error] {
  if len != 13 {
    return Err(Asn1Error::InvalidTime(start, "UTCTime must be 13 bytes (YYMMDDHHMMSSZ)"))
  }
  if data[start + 12].to_int() != 90 {
    return Err(Asn1Error::InvalidTime(start + 12, "UTCTime must end with 'Z'"))
  }
  let yy = parse_2_digits_bytes(data, start)
  let mm = parse_2_digits_bytes(data, start + 2)
  let dd = parse_2_digits_bytes(data, start + 4)
  let hh = parse_2_digits_bytes(data, start + 6)
  let mi = parse_2_digits_bytes(data, start + 8)
  let ss = parse_2_digits_bytes(data, start + 10)
  if yy < 0 || mm < 0 || dd < 0 || hh < 0 || mi < 0 || ss < 0 {
    return Err(Asn1Error::InvalidTime(start, "non-digit in UTCTime"))
  }
  let year = utc_time_expand_year(yy)
  validate_and_to_unix(year, mm, dd, hh, mi, ss, start)
}

///| Parse RFC 5280 GeneralizedTime (`YYYYMMDDHHMMSSZ`) from a byte slice `[start, start + len)`.
pub fn parse_generalized_time_slice(data : Bytes, start : Int, len : Int) -> Result[Int64, Asn1Error] {
  if len != 15 {
    return Err(Asn1Error::InvalidTime(start, "GeneralizedTime must be 15 bytes (YYYYMMDDHHMMSSZ)"))
  }
  if data[start + 14].to_int() != 90 {
    return Err(Asn1Error::InvalidTime(start + 14, "GeneralizedTime must end with 'Z'"))
  }
  let cc = parse_2_digits_bytes(data, start)
  let yy = parse_2_digits_bytes(data, start + 2)
  let mm = parse_2_digits_bytes(data, start + 4)
  let dd = parse_2_digits_bytes(data, start + 6)
  let hh = parse_2_digits_bytes(data, start + 8)
  let mi = parse_2_digits_bytes(data, start + 10)
  let ss = parse_2_digits_bytes(data, start + 12)
  if cc < 0 || yy < 0 || mm < 0 || dd < 0 || hh < 0 || mi < 0 || ss < 0 {
    return Err(Asn1Error::InvalidTime(start, "non-digit in GeneralizedTime"))
  }
  let year = cc * 100 + yy
  validate_and_to_unix(year, mm, dd, hh, mi, ss, start)
}

///| Parse RFC 5280 UTCTime (`YYMMDDHHMMSSZ`, `YY >= 50 -> 19YY`, `YY < 50 -> 20YY`) to Unix seconds.
pub fn parse_utc_time_str(s : String) -> Result[Int64, Asn1Error] {
  let b = s.to_bytes()
  parse_utc_time_slice(b, 0, b.length())
}

///| Parse RFC 5280 GeneralizedTime (`YYYYMMDDHHMMSSZ`) to Unix seconds.
pub fn parse_generalized_time_str(s : String) -> Result[Int64, Asn1Error] {
  let b = s.to_bytes()
  parse_generalized_time_slice(b, 0, b.length())
}
