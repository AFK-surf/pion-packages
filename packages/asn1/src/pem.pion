///| RFC 7468 PEM encoder and decoder built directly on `packages/base64`.

import "base64"

fn is_valid_pem_label_bytes(b : Bytes, start : Int, end : Int) -> Bool {
  if end <= start {
    return false
  }
  // RFC 7468 §2: printable ASCII 0x21..0x7E and space/hyphen (not leading/trailing space or hyphen)
  let first = b[start].to_int()
  let last = b[end - 1].to_int()
  if first == 32 || first == 45 || last == 32 || last == 45 {
    return false
  }
  let mut i = start
  while i < end {
    let c = b[i].to_int()
    if c < 0x20 || c > 0x7E {
      return false
    }
    i = i + 1
  }
  true
}

fn match_bytes_at(data : Bytes, pos : Int, end : Int, pat : Bytes) -> Bool {
  let plen = pat.length()
  if pos + plen > end {
    return false
  }
  let mut i = 0
  while i < plen {
    if data[pos + i] != pat[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn trim_line_end(data : Bytes, start : Int, end : Int) -> Int {
  let mut e = end
  while e > start {
    let c = data[e - 1].to_int()
    if c == 13 || c == 32 || c == 9 {
      e = e - 1
    } else {
      break
    }
  }
  e
}

fn find_line_end(data : Bytes, pos : Int, n : Int) -> Int {
  let mut i = pos
  while i < n && data[i].to_int() != 10 {
    i = i + 1
  }
  i
}

let pem_begin_prefix : Bytes = "-----BEGIN ".to_bytes()
let pem_end_prefix : Bytes = "-----END ".to_bytes()
let pem_suffix : Bytes = "-----".to_bytes()

fn parse_one_pem_from(data : Bytes, start_pos : Int) -> Result[Option[(PemBlock, Int)], Asn1Error] {
  let n = data.length()
  let mut pos = start_pos
  // 1. Scan lines until `-----BEGIN <LABEL>-----`
  let mut label_start = -1
  let mut label_end = -1
  while pos < n {
    let line_end = find_line_end(data, pos, n)
    let trimmed_end = trim_line_end(data, pos, line_end)
    let next_pos = if line_end < n { line_end + 1 } else { n }
    if match_bytes_at(data, pos, trimmed_end, pem_begin_prefix) &&
    trimmed_end - pos >= 16 &&
    match_bytes_at(data, trimmed_end - 5, trimmed_end, pem_suffix) {
      let ls = pos + 11
      let le = trimmed_end - 5
      if !is_valid_pem_label_bytes(data, ls, le) {
        return Err(Asn1Error::InvalidPem("invalid PEM BEGIN label"))
      }
      label_start = ls
      label_end = le
      pos = next_pos
      break
    }
    pos = next_pos
  }
  if label_start < 0 {
    return Ok(None)
  }
  let label_len = label_end - label_start
  let body_start = pos
  // 2. Scan lines until `-----END <LABEL>-----`
  let mut body_end = -1
  let mut after_end = n
  let mut non_ws_count = 0
  while pos < n {
    let line_end = find_line_end(data, pos, n)
    let trimmed_end = trim_line_end(data, pos, line_end)
    let next_pos = if line_end < n { line_end + 1 } else { n }
    if match_bytes_at(data, pos, trimmed_end, pem_end_prefix) &&
    trimmed_end - pos >= 14 &&
    match_bytes_at(data, trimmed_end - 5, trimmed_end, pem_suffix) {
      let es = pos + 9
      let ee = trimmed_end - 5
      if ee - es != label_len {
        return Err(Asn1Error::InvalidPem("mismatched PEM END label"))
      }
      let mut k = 0
      while k < label_len {
        if data[label_start + k] != data[es + k] {
          return Err(Asn1Error::InvalidPem("mismatched PEM END label"))
        }
        k = k + 1
      }
      body_end = pos
      after_end = next_pos
      break
    }
    // Count non-whitespace bytes on this body line
    let mut i = pos
    while i < line_end {
      let c = data[i].to_int()
      if c != 32 && c != 9 && c != 13 && c != 10 {
        non_ws_count = non_ws_count + 1
      }
      i = i + 1
    }
    pos = next_pos
  }
  if body_end < 0 {
    return Err(Asn1Error::InvalidPem("missing PEM END marker"))
  }
  // 3. Compact base64 body into a single pre-sized buffer and decode strictly via packages/base64
  let b64_buf = Bytes::new(non_ws_count)
  let mut di = 0
  let mut si = body_start
  while si < body_end {
    let c = data[si].to_int()
    if c != 32 && c != 9 && c != 13 && c != 10 {
      b64_buf[di] = data[si]
      di = di + 1
    }
    si = si + 1
  }
  let decoded = match base64::decode_bytes(b64_buf) {
    Ok(b) => b
    Err(e) => return Err(Asn1Error::InvalidPem("invalid base64: " + base64::error_message(e)))
  }
  let label = data.slice(label_start, label_end).to_string()
  Ok(Some((PemBlock::{ label: label, data: decoded }, after_end)))
}

///| Parse the first PEM block from `input`.
pub fn parse_pem(input : String) -> Result[PemBlock, Asn1Error] {
  let raw = input.to_bytes()
  match parse_one_pem_from(raw, 0) {
    Ok(Some((block, _))) => Ok(block)
    Ok(None) => Err(Asn1Error::InvalidPem("no PEM block found"))
    Err(e) => Err(e)
  }
}

///| Parse all PEM blocks from `input` (e.g. a certificate chain bundle).
pub fn parse_pem_all(input : String) -> Result[Array[PemBlock], Asn1Error] {
  let raw = input.to_bytes()
  let blocks : Array[PemBlock] = []
  let mut pos = 0
  while pos < raw.length() {
    match parse_one_pem_from(raw, pos) {
      Ok(Some((block, next_pos))) => {
        blocks.push(block)
        pos = next_pos
      }
      Ok(None) => break
      Err(e) => return Err(e)
    }
  }
  if blocks.length() == 0 {
    return Err(Asn1Error::InvalidPem("no PEM block found"))
  }
  Ok(blocks)
}

///| Encode binary data into RFC 7468 PEM with 64-character line wrapping.
pub fn encode_pem(label : String, data : Bytes) -> Result[String, Asn1Error] {
  let lb = label.to_bytes()
  if !is_valid_pem_label_bytes(lb, 0, lb.length()) {
    return Err(Asn1Error::InvalidPem("invalid PEM label"))
  }
  let b64 = base64::encode(data)
  let b64_bytes = b64.to_bytes()
  let n = b64_bytes.length()
  let lines = if n == 0 { 0 } else { (n + 63) / 64 }
  // -----BEGIN <label>-----\n + body + newlines + -----END <label>-----\n
  let total = 17 + lb.length() + n + lines + 15 + lb.length()
  let out = Bytes::new(total)
  let mut p = 0
  let copy = fn(src : Bytes) -> Unit {
    let mut i = 0
    while i < src.length() {
      out[p] = src[i]
      p = p + 1
      i = i + 1
    }
  }
  copy(pem_begin_prefix)
  copy(lb)
  copy(pem_suffix)
  out[p] = (10).to_byte()
  p = p + 1
  let mut i = 0
  while i < n {
    let end = if i + 64 < n { i + 64 } else { n }
    while i < end {
      out[p] = b64_bytes[i]
      p = p + 1
      i = i + 1
    }
    out[p] = (10).to_byte()
    p = p + 1
  }
  copy(pem_end_prefix)
  copy(lb)
  copy(pem_suffix)
  out[p] = (10).to_byte()
  p = p + 1
  Ok(out.to_string())
}
