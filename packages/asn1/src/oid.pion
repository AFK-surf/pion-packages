///| ASN.1 OBJECT IDENTIFIER parsing, encoding, formatting, and fast well-known OID lookup.

///| Well-known algorithm & curve OIDs.
pub let oid_rsa_encryption : String = "1.2.840.113549.1.1.1"
pub let oid_sha256_with_rsa : String = "1.2.840.113549.1.1.11"
pub let oid_sha384_with_rsa : String = "1.2.840.113549.1.1.12"
pub let oid_sha512_with_rsa : String = "1.2.840.113549.1.1.13"
pub let oid_ec_public_key : String = "1.2.840.10045.2.1"
pub let oid_ecdsa_with_sha256 : String = "1.2.840.10045.4.3.2"
pub let oid_ecdsa_with_sha384 : String = "1.2.840.10045.4.3.3"
pub let oid_secp256r1 : String = "1.2.840.10045.3.1.7"
pub let oid_secp384r1 : String = "1.3.132.0.34"
pub let oid_ed25519 : String = "1.3.101.112"
pub let oid_x25519 : String = "1.3.101.110"

///| Well-known X.500 DN attribute OIDs.
pub let oid_cn : String = "2.5.4.3"
pub let oid_c : String = "2.5.4.6"
pub let oid_l : String = "2.5.4.7"
pub let oid_st : String = "2.5.4.8"
pub let oid_o : String = "2.5.4.10"
pub let oid_ou : String = "2.5.4.11"

///| Well-known X.509 v3 extension OIDs.
pub let oid_ext_ski : String = "2.5.29.14"
pub let oid_ext_key_usage : String = "2.5.29.15"
pub let oid_ext_san : String = "2.5.29.17"
pub let oid_ext_basic_constraints : String = "2.5.29.19"
pub let oid_ext_aki : String = "2.5.29.35"
pub let oid_ext_ext_key_usage : String = "2.5.29.37"

///| Well-known ExtendedKeyUsage purpose OIDs.
pub let oid_eku_server_auth : String = "1.3.6.1.5.5.7.3.1"
pub let oid_eku_client_auth : String = "1.3.6.1.5.5.7.3.2"
pub let oid_eku_code_signing : String = "1.3.6.1.5.5.7.3.3"
pub let oid_eku_email_protection : String = "1.3.6.1.5.5.7.3.4"
pub let oid_eku_time_stamping : String = "1.3.6.1.5.5.7.3.8"
pub let oid_eku_ocsp_signing : String = "1.3.6.1.5.5.7.3.9"

///| Fast zero-allocation lookup for common X.509 OID DER content slices.
pub fn fast_oid_str_from_slice(data : Bytes, start : Int, len : Int) -> Option[String] {
  if len == 3 {
    let b0 = data[start].to_int()
    let b1 = data[start + 1].to_int()
    let b2 = data[start + 2].to_int()
    if b0 == 0x55 {
      if b1 == 0x04 {
        if b2 == 3 {
          return Some(oid_cn)
        } else if b2 == 6 {
          return Some(oid_c)
        } else if b2 == 7 {
          return Some(oid_l)
        } else if b2 == 8 {
          return Some(oid_st)
        } else if b2 == 10 {
          return Some(oid_o)
        } else if b2 == 11 {
          return Some(oid_ou)
        }
      } else if b1 == 0x1D {
        if b2 == 14 {
          return Some(oid_ext_ski)
        } else if b2 == 15 {
          return Some(oid_ext_key_usage)
        } else if b2 == 17 {
          return Some(oid_ext_san)
        } else if b2 == 19 {
          return Some(oid_ext_basic_constraints)
        } else if b2 == 35 {
          return Some(oid_ext_aki)
        } else if b2 == 37 {
          return Some(oid_ext_ext_key_usage)
        }
      }
    } else if b0 == 0x2B && b1 == 0x65 {
      if b2 == 112 {
        return Some(oid_ed25519)
      } else if b2 == 110 {
        return Some(oid_x25519)
      }
    }
    return None
  }
  if len == 5 {
    if data[start].to_int() == 0x2B &&
    data[start + 1].to_int() == 0x81 &&
    data[start + 2].to_int() == 0x04 &&
    data[start + 3].to_int() == 0x00 &&
    data[start + 4].to_int() == 0x22 {
      return Some(oid_secp384r1)
    }
    return None
  }
  if len == 7 {
    if data[start].to_int() == 0x2A &&
    data[start + 1].to_int() == 0x86 &&
    data[start + 2].to_int() == 0x48 &&
    data[start + 3].to_int() == 0xCE &&
    data[start + 4].to_int() == 0x3D &&
    data[start + 5].to_int() == 0x02 &&
    data[start + 6].to_int() == 0x01 {
      return Some(oid_ec_public_key)
    }
    return None
  }
  if len == 8 {
    if data[start].to_int() == 0x2A &&
    data[start + 1].to_int() == 0x86 &&
    data[start + 2].to_int() == 0x48 &&
    data[start + 3].to_int() == 0xCE &&
    data[start + 4].to_int() == 0x3D {
      let b5 = data[start + 5].to_int()
      let b6 = data[start + 6].to_int()
      let b7 = data[start + 7].to_int()
      if b5 == 0x03 && b6 == 0x01 && b7 == 0x07 {
        return Some(oid_secp256r1)
      }
      if b5 == 0x04 && b6 == 0x03 {
        if b7 == 0x02 {
          return Some(oid_ecdsa_with_sha256)
        } else if b7 == 0x03 {
          return Some(oid_ecdsa_with_sha384)
        }
      }
    } else if data[start].to_int() == 0x2B &&
    data[start + 1].to_int() == 0x06 &&
    data[start + 2].to_int() == 0x01 &&
    data[start + 3].to_int() == 0x05 &&
    data[start + 4].to_int() == 0x05 &&
    data[start + 5].to_int() == 0x07 &&
    data[start + 6].to_int() == 0x03 {
      let b7 = data[start + 7].to_int()
      if b7 == 1 {
        return Some(oid_eku_server_auth)
      } else if b7 == 2 {
        return Some(oid_eku_client_auth)
      } else if b7 == 3 {
        return Some(oid_eku_code_signing)
      } else if b7 == 4 {
        return Some(oid_eku_email_protection)
      } else if b7 == 8 {
        return Some(oid_eku_time_stamping)
      } else if b7 == 9 {
        return Some(oid_eku_ocsp_signing)
      }
    }
    return None
  }
  if len == 9 {
    if data[start].to_int() == 0x2A &&
    data[start + 1].to_int() == 0x86 &&
    data[start + 2].to_int() == 0x48 &&
    data[start + 3].to_int() == 0x86 &&
    data[start + 4].to_int() == 0xF7 &&
    data[start + 5].to_int() == 0x0D &&
    data[start + 6].to_int() == 0x01 &&
    data[start + 7].to_int() == 0x01 {
      let b8 = data[start + 8].to_int()
      if b8 == 1 {
        return Some(oid_rsa_encryption)
      } else if b8 == 11 {
        return Some(oid_sha256_with_rsa)
      } else if b8 == 12 {
        return Some(oid_sha384_with_rsa)
      } else if b8 == 13 {
        return Some(oid_sha512_with_rsa)
      }
    }
    return None
  }
  None
}

///| Parse a dotted-decimal OID string into an `Oid`.
pub fn parse_oid_str(s : String) -> Result[Oid, Asn1Error] {
  let n = s.length()
  if n == 0 {
    return Err(Asn1Error::InvalidOid(0, "empty OID string"))
  }
  let arcs : Array[UInt64] = []
  let mut i = 0
  while i < n {
    let start = i
    let mut acc = 0UL
    let mut digits = 0
    while i < n && s.code_unit_at(i) != 46 {
      let c = s.code_unit_at(i)
      if c < 48 || c > 57 {
        return Err(Asn1Error::InvalidOid(i, "non-digit in OID"))
      }
      if digits == 1 && acc == 0UL {
        return Err(Asn1Error::InvalidOid(start, "leading zero in OID arc"))
      }
      let d = (c - 48).to_int64().to_uint64()
      if acc > (18446744073709551615UL - d) / 10UL {
        return Err(Asn1Error::InvalidOid(start, "OID arc overflow"))
      }
      acc = acc * 10UL + d
      digits = digits + 1
      i = i + 1
    }
    if digits == 0 {
      return Err(Asn1Error::InvalidOid(start, "empty OID arc"))
    }
    arcs.push(acc)
    if i < n {
      // skip '.'
      i = i + 1
      if i == n {
        return Err(Asn1Error::InvalidOid(i, "trailing dot in OID"))
      }
    }
  }
  if arcs.length() < 2 {
    return Err(Asn1Error::InvalidOid(0, "OID must have at least 2 arcs"))
  }
  let first = arcs[0]
  let second = arcs[1]
  if first > 2UL {
    return Err(Asn1Error::InvalidOid(0, "first OID arc must be 0, 1, or 2"))
  }
  if first < 2UL && second >= 40UL {
    return Err(Asn1Error::InvalidOid(0, "second OID arc must be < 40 when first < 2"))
  }
  if first == 2UL && second > 18446744073709551615UL - 80UL {
    return Err(Asn1Error::InvalidOid(0, "combined first two arcs overflow"))
  }
  Ok(Oid::{ arcs: arcs, text: s })
}

///| Decode strict DER OID content slice `[start, start + len)` into a dotted string.
pub fn decode_oid_str_slice(data : Bytes, start : Int, len : Int) -> Result[String, Asn1Error] {
  match fast_oid_str_from_slice(data, start, len) {
    Some(s) => return Ok(s)
    None => ()
  }
  match decode_oid_slice(data, start, len) {
    Ok(oid) => Ok(oid.text)
    Err(e) => Err(e)
  }
}

///| Decode strict DER OID content slice `[start, start + len)` into an `Oid`.
pub fn decode_oid_slice(data : Bytes, start : Int, len : Int) -> Result[Oid, Asn1Error] {
  if len <= 0 {
    return Err(Asn1Error::InvalidOid(start, "empty OID content"))
  }
  let end = start + len
  let arcs : Array[UInt64] = []
  let mut i = start
  let mut first_sub = true
  while i < end {
    let sub_start = i
    let b0 = data[i].to_int()
    // ITU-T X.690 §8.19.2: subidentifier must be minimally encoded (no leading 0x80)
    if b0 == 0x80 {
      return Err(Asn1Error::InvalidOid(sub_start, "non-minimal OID subidentifier (leading 0x80)"))
    }
    let mut acc = 0UL
    let mut cont = true
    while cont {
      if i >= end {
        return Err(Asn1Error::InvalidOid(sub_start, "truncated OID subidentifier"))
      }
      let b = data[i].to_int()
      i = i + 1
      if acc > (18446744073709551615UL >> 7) {
        return Err(Asn1Error::InvalidOid(sub_start, "OID subidentifier UInt64 overflow"))
      }
      acc = (acc << 7) | (b & 0x7F).to_int64().to_uint64()
      cont = (b & 0x80) != 0
    }
    if first_sub {
      first_sub = false
      if acc < 40UL {
        arcs.push(0UL)
        arcs.push(acc)
      } else if acc < 80UL {
        arcs.push(1UL)
        arcs.push(acc - 40UL)
      } else {
        arcs.push(2UL)
        arcs.push(acc - 80UL)
      }
    } else {
      arcs.push(acc)
    }
  }
  let sb = StringBuilder::new()
  let mut k = 0
  while k < arcs.length() {
    if k > 0 {
      sb.write_string(".")
    }
    sb.write_string(arcs[k].to_string())
    k = k + 1
  }
  Ok(Oid::{ arcs: arcs, text: sb.to_string() })
}

///| Decode strict DER OID content bytes into an `Oid`.
pub fn decode_oid_bytes(raw : Bytes) -> Result[Oid, Asn1Error] {
  decode_oid_slice(raw, 0, raw.length())
}

///| Helper to encode one base-128 subidentifier into an array of bytes.
fn encode_subid(v : UInt64, out : Array[Byte]) -> Unit {
  let tmp : FixedArray[Byte] = [b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00']
  let mut n = 0
  let mut x = v
  tmp[0] = (x & 0x7FUL).to_int64().to_int().to_byte()
  x = x >> 7
  n = 1
  while x > 0UL {
    tmp[n] = (((x & 0x7FUL).to_int64().to_int()) | 0x80).to_byte()
    x = x >> 7
    n = n + 1
  }
  let mut i = n - 1
  while i >= 0 {
    out.push(tmp[i])
    i = i - 1
  }
}

///| Encode an `Oid` into strict DER OID content bytes.
pub fn encode_oid_bytes(oid : Oid) -> Result[Bytes, Asn1Error] {
  if oid.arcs.length() < 2 {
    return Err(Asn1Error::InvalidOid(0, "OID must have at least 2 arcs"))
  }
  let first = oid.arcs[0]
  let second = oid.arcs[1]
  if first > 2UL {
    return Err(Asn1Error::InvalidOid(0, "first OID arc must be 0, 1, or 2"))
  }
  if first < 2UL && second >= 40UL {
    return Err(Asn1Error::InvalidOid(0, "second OID arc must be < 40 when first < 2"))
  }
  if first == 2UL && second > 18446744073709551615UL - 80UL {
    return Err(Asn1Error::InvalidOid(0, "first two OID arcs overflow"))
  }
  let out : Array[Byte] = []
  encode_subid(first * 40UL + second, out)
  let mut i = 2
  while i < oid.arcs.length() {
    encode_subid(oid.arcs[i], out)
    i = i + 1
  }
  let res = Bytes::new(out.length())
  let mut j = 0
  while j < out.length() {
    res[j] = out[j]
    j = j + 1
  }
  Ok(res)
}
