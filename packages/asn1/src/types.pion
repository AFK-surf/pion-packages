///| Core types, errors, tags, limits, PEM, and X.509 / SPKI / PKCS#8 structures for `packages/asn1`.

///| Error returned by ASN.1 DER, PEM, X.509, SPKI, and PKCS#8 operations.
pub enum Asn1Error {
  UnexpectedEof(Int)
  InvalidTag(Int, String)
  InvalidLength(Int, String)
  IndefiniteLength(Int)
  NonCanonical(Int, String)
  UnexpectedTag(Int, String)
  TrailingBytes(Int, Int)
  IntegerOverflow(Int, String)
  InvalidUtf8(Int)
  InvalidString(Int, String)
  InvalidOid(Int, String)
  InvalidTime(Int, String)
  DepthLimitExceeded(Int)
  ElementLimitExceeded(Int)
  SizeLimitExceeded(Int)
  InvalidPem(String)
  DuplicateExtension(String)
  InvalidX509(String)
  InvalidKey(String)
}

///| Human-readable description of an `Asn1Error`.
pub fn asn1_error_message(e : Asn1Error) -> String {
  match e {
    Asn1Error::UnexpectedEof(off) => "unexpected EOF at offset " + off.to_string()
    Asn1Error::InvalidTag(off, msg) => "invalid tag at " + off.to_string() + ": " + msg
    Asn1Error::InvalidLength(off, msg) => "invalid length at " + off.to_string() + ": " + msg
    Asn1Error::IndefiniteLength(off) => "indefinite BER length rejected at " + off.to_string()
    Asn1Error::NonCanonical(off, msg) => "non-canonical DER at " + off.to_string() + ": " + msg
    Asn1Error::UnexpectedTag(off, msg) => "unexpected tag at " + off.to_string() + ": " + msg
    Asn1Error::TrailingBytes(off, rem) =>
    "trailing " + rem.to_string() + " bytes at offset " + off.to_string()
    Asn1Error::IntegerOverflow(off, msg) => "integer overflow at " + off.to_string() + ": " + msg
    Asn1Error::InvalidUtf8(off) => "invalid UTF-8 at offset " + off.to_string()
    Asn1Error::InvalidString(off, msg) => "invalid string at " + off.to_string() + ": " + msg
    Asn1Error::InvalidOid(off, msg) => "invalid OID at " + off.to_string() + ": " + msg
    Asn1Error::InvalidTime(off, msg) => "invalid time at " + off.to_string() + ": " + msg
    Asn1Error::DepthLimitExceeded(d) => "ASN.1 nesting depth limit exceeded: " + d.to_string()
    Asn1Error::ElementLimitExceeded(n) => "ASN.1 element limit exceeded: " + n.to_string()
    Asn1Error::SizeLimitExceeded(n) => "ASN.1 size limit exceeded: " + n.to_string()
    Asn1Error::InvalidPem(msg) => "invalid PEM: " + msg
    Asn1Error::DuplicateExtension(oid) => "duplicate X.509 extension OID: " + oid
    Asn1Error::InvalidX509(msg) => "invalid X.509 certificate: " + msg
    Asn1Error::InvalidKey(msg) => "invalid key structure: " + msg
  }
}

///| ASN.1 tag class (top 2 bits of the identifier octet).
#verify
pub enum TagClass {
  Universal
  Application
  ContextSpecific
  Private
}

///| Return the 2-bit class code (0..3).
#verify
pub fn tag_class_code(c : TagClass) -> Int {
  match c {
    TagClass::Universal => 0
    TagClass::Application => 1
    TagClass::ContextSpecific => 2
    TagClass::Private => 3
  }
}

///| Decode a 2-bit class code (0..3) into `TagClass`.
#verify
pub fn tag_class_from_code(code : Int) -> TagClass {
  if code == 0 {
    TagClass::Universal
  } else if code == 1 {
    TagClass::Application
  } else if code == 2 {
    TagClass::ContextSpecific
  } else {
    TagClass::Private
  }
}

///| Compare two `TagClass` values.
#verify
pub fn tag_class_equals(a : TagClass, b : TagClass) -> Bool {
  tag_class_code(a) == tag_class_code(b)
}

///| Decoded ASN.1 tag.
#verify
pub val struct Tag {
  tag_class : TagClass
  constructed : Bool
  number : Int
}

///| Construct a `Tag`.
#verify
pub fn Tag::new(tag_class : TagClass, constructed : Bool, number : Int) -> Tag {
  Tag::{ tag_class: tag_class, constructed: constructed, number: number }
}

///| Construct a Universal primitive tag.
#verify
pub fn Tag::universal_primitive(number : Int) -> Tag {
  Tag::{ tag_class: TagClass::Universal, constructed: false, number: number }
}

///| Construct a Universal constructed tag.
#verify
pub fn Tag::universal_constructed(number : Int) -> Tag {
  Tag::{ tag_class: TagClass::Universal, constructed: true, number: number }
}

///| Construct a Context-Specific tag.
#verify
pub fn Tag::context(number : Int, constructed : Bool) -> Tag {
  Tag::{ tag_class: TagClass::ContextSpecific, constructed: constructed, number: number }
}

///| Compare two `Tag` values for equality.
#verify
pub fn Tag::equals(self : Tag, other : Tag) -> Bool {
  self.number == other.number &&
  self.constructed == other.constructed &&
  tag_class_code(self.tag_class) == tag_class_code(other.tag_class)
}

///| Universal ASN.1 tag numbers.
pub let tag_num_boolean : Int = 0x01
pub let tag_num_integer : Int = 0x02
pub let tag_num_bit_string : Int = 0x03
pub let tag_num_octet_string : Int = 0x04
pub let tag_num_null : Int = 0x05
pub let tag_num_oid : Int = 0x06
pub let tag_num_utf8_string : Int = 0x0C
pub let tag_num_sequence : Int = 0x10
pub let tag_num_set : Int = 0x11
pub let tag_num_numeric_string : Int = 0x12
pub let tag_num_printable_string : Int = 0x13
pub let tag_num_t61_string : Int = 0x14
pub let tag_num_ia5_string : Int = 0x16
pub let tag_num_utc_time : Int = 0x17
pub let tag_num_generalized_time : Int = 0x18
pub let tag_num_visible_string : Int = 0x1A
pub let tag_num_universal_string : Int = 0x1C
pub let tag_num_bmp_string : Int = 0x1E

///| Common Universal tags.
pub let tag_boolean : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x01 }
pub let tag_integer : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x02 }
pub let tag_bit_string : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x03 }
pub let tag_octet_string : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x04 }
pub let tag_null : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x05 }
pub let tag_oid : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x06 }
pub let tag_utf8_string : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x0C }
pub let tag_sequence : Tag = Tag::{ tag_class: TagClass::Universal, constructed: true, number: 0x10 }
pub let tag_set : Tag = Tag::{ tag_class: TagClass::Universal, constructed: true, number: 0x11 }
pub let tag_printable_string : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x13 }
pub let tag_ia5_string : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x16 }
pub let tag_utc_time : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x17 }
pub let tag_generalized_time : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x18 }
pub let tag_visible_string : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x1A }
pub let tag_bmp_string : Tag = Tag::{ tag_class: TagClass::Universal, constructed: false, number: 0x1E }

///| Hard upper bound on `DerElement` nesting depth to keep recursive RC drop
///| safe from call-stack overflow on both Wasm32 (debug/release) and Native.
pub let max_safe_depth : Int = 2048

///| Safety limits for DER tree / X.509 decoding.
pub val struct DecodeLimits {
  max_depth : Int
  max_elements : Int
  max_bytes : Int
}

///| Default hardened decode limits (max_depth = 64, max_elements = 65536, max_bytes = 16 MiB).
pub fn DecodeLimits::default() -> DecodeLimits {
  DecodeLimits::{ max_depth: 64, max_elements: 65536, max_bytes: 16777216 }
}

///| Decoded TLV header pointing into an input `Bytes` buffer.
pub val struct DerHeader {
  tag : Tag
  tlv_start : Int
  content_start : Int
  content_len : Int
  tlv_end : Int
}

///| Decoded BIT STRING value.
pub struct BitString {
  unused_bits : Int
  bytes : Bytes
}

///| Parsed generic ASN.1 DER element (iterative tree).
pub struct DerElement {
  tag : Tag
  value : Bytes
  children : Array[DerElement]
}

///| Parsed ASN.1 OBJECT IDENTIFIER.
pub struct Oid {
  arcs : Array[UInt64]
  text : String
}

///| Return dotted-decimal string representation (e.g. `"1.2.840.113549.1.1.11"`).
pub fn Oid::to_string(self : Oid) -> String {
  self.text
}

///| Decoded RFC 7468 PEM block.
pub struct PemBlock {
  label : String
  data : Bytes
}

///| ASN.1 AlgorithmIdentifier (RFC 5280 §4.1.1.2).
pub struct AlgorithmIdentifier {
  oid : String
  params : Option[Bytes]
  curve_oid : Option[String]
}

///| Single AttributeTypeAndValue inside a DistinguishedName.
pub struct AttributeTypeAndValue {
  oid : String
  value : String
}

///| X.500 DistinguishedName (Issuer / Subject).
pub struct DistinguishedName {
  common_name : Option[String]
  organization : Option[String]
  organizational_unit : Option[String]
  country : Option[String]
  state_or_province : Option[String]
  locality : Option[String]
  attributes : Array[AttributeTypeAndValue]
}

///| RFC 5280 SubjectPublicKeyInfo (SPKI).
pub struct SubjectPublicKeyInfo {
  algorithm : AlgorithmIdentifier
  public_key : Bytes
  unused_bits : Int
  raw : Bytes
}

///| RFC 5958 PKCS#8 PrivateKeyInfo / OneAsymmetricKey.
pub struct Pkcs8PrivateKeyInfo {
  version : Int
  algorithm : AlgorithmIdentifier
  private_key : Bytes
  attributes : Option[Bytes]
  public_key : Option[BitString]
}

///| X.509 SubjectAlternativeName GeneralName entry.
pub enum GeneralName {
  DnsName(String)
  IpAddress(Bytes)
  Uri(String)
  Email(String)
  Other(Int, Bytes)
}

///| X.509 BasicConstraints extension (OID 2.5.29.19).
pub val struct BasicConstraints {
  is_ca : Bool
  path_len_constraint : Option[Int]
}

///| X.509 KeyUsage extension bitmask (OID 2.5.29.15).
///| Bit 0 = digitalSignature, 1 = contentCommitment, 2 = keyEncipherment,
///| 3 = dataEncipherment, 4 = keyAgreement, 5 = keyCertSign,
///| 6 = cRLSign, 7 = encipherOnly, 8 = decipherOnly.
#verify
pub val struct KeyUsage {
  bits : Int
}

///|
#verify
pub fn KeyUsage::digital_signature(self : KeyUsage) -> Bool {
  (self.bits & 1) != 0
}

///|
#verify
pub fn KeyUsage::content_commitment(self : KeyUsage) -> Bool {
  (self.bits & 2) != 0
}

///|
#verify
pub fn KeyUsage::key_encipherment(self : KeyUsage) -> Bool {
  (self.bits & 4) != 0
}

///|
#verify
pub fn KeyUsage::data_encipherment(self : KeyUsage) -> Bool {
  (self.bits & 8) != 0
}

///|
#verify
pub fn KeyUsage::key_agreement(self : KeyUsage) -> Bool {
  (self.bits & 16) != 0
}

///|
#verify
pub fn KeyUsage::key_cert_sign(self : KeyUsage) -> Bool {
  (self.bits & 32) != 0
}

///|
#verify
pub fn KeyUsage::crl_sign(self : KeyUsage) -> Bool {
  (self.bits & 64) != 0
}

///|
#verify
pub fn KeyUsage::encipher_only(self : KeyUsage) -> Bool {
  (self.bits & 128) != 0
}

///|
#verify
pub fn KeyUsage::decipher_only(self : KeyUsage) -> Bool {
  (self.bits & 256) != 0
}

///| X.509 AuthorityKeyIdentifier extension (OID 2.5.29.35).
pub struct AuthorityKeyIdentifier {
  key_id : Option[Bytes]
  serial_number : Option[Bytes]
}

///| Raw X.509 v3 extension.
pub struct X509Extension {
  oid : String
  critical : Bool
  value : Bytes
}

///| Parsed RFC 5280 X.509 v1/v2/v3 Certificate.
pub struct X509Certificate {
  version : Int
  serial_number : Bytes
  signature_algorithm : AlgorithmIdentifier
  issuer : DistinguishedName
  not_before : Int64
  not_after : Int64
  subject : DistinguishedName
  subject_public_key_info : SubjectPublicKeyInfo
  tbs_bytes : Bytes
  outer_signature_algorithm : AlgorithmIdentifier
  signature_bytes : Bytes
  extensions : Array[X509Extension]
  san : Array[GeneralName]
  basic_constraints : Option[BasicConstraints]
  key_usage : Option[KeyUsage]
  ext_key_usage : Array[String]
  subject_key_identifier : Option[Bytes]
  authority_key_identifier : Option[AuthorityKeyIdentifier]
}
