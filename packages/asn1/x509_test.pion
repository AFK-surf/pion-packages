///| RFC 5280 X.509 v1/v3 certificate, hostname verification (RFC 6125/9525),
///| and SPKI / PKCS#8 compliance test suite with real OpenSSL 3.5.9 vectors.

import "base64"

fn x509_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn b64_must(s : String) -> Bytes {
  match base64::decode(s) {
    Ok(b) => b
    Err(_) => {
      debug_assert(false, "invalid test base64")
      Bytes::new(0)
    }
  }
}

