test "x509_parse_rsa_ca_cert" {
  let cert = match parse_x509_pem(test_ca_cert_pem) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, asn1_error_message(e))
      return ()
    }
  }
  debug_assert(cert.version == 3, "v3")
  debug_assert(cert.serial_number.length() == 8 && cert.serial_number[0].to_int() == 1 && cert.serial_number[7].to_int() == 8, "serial")
  debug_assert(cert.signature_algorithm.oid == oid_sha256_with_rsa, "sig alg")
  debug_assert(cert.outer_signature_algorithm.oid == oid_sha256_with_rsa, "outer sig alg")
  debug_assert(cert.subject_public_key_info.algorithm.oid == oid_rsa_encryption, "spki rsa")
  debug_assert(cert.tbs_bytes.length() > 100, "tbs bytes present")
  debug_assert(cert.signature_bytes.length() == 256, "2048-bit RSA signature")

  // DN fields
  match cert.subject.common_name {
    Some(cn) => debug_assert(cn == "Pion Test Root CA", "CN")
    None => debug_assert(false, "missing CN")
  }
  match cert.subject.country {
    Some(c) => debug_assert(c == "US", "C")
    None => debug_assert(false, "missing C")
  }
  match cert.subject.state_or_province {
    Some(st) => debug_assert(st == "California", "ST")
    None => debug_assert(false, "missing ST")
  }
  match cert.subject.locality {
    Some(l) => debug_assert(l == "San Francisco", "L")
    None => debug_assert(false, "missing L")
  }
  match cert.subject.organization {
    Some(o) => debug_assert(o == "Pion Test Org", "O")
    None => debug_assert(false, "missing O")
  }
  match cert.subject.organizational_unit {
    Some(ou) => debug_assert(ou == "Root CA Unit", "OU")
    None => debug_assert(false, "missing OU")
  }

  // Validity: 2026-11-23T07:42:51Z to 2036-11-20T07:42:51Z
  debug_assert(cert.not_before == 1795419771L, "not_before")
  debug_assert(cert.not_after == 2110779771L, "not_after")

  // BasicConstraints CA:TRUE, pathlen:1
  match cert.basic_constraints {
    Some(bc) => {
      debug_assert(bc.is_ca, "is_ca")
      match bc.path_len_constraint {
        Some(p) => debug_assert(p == 1, "pathlen 1")
        None => debug_assert(false, "expected pathlen 1")
      }
    }
    None => debug_assert(false, "missing BasicConstraints")
  }

  // KeyUsage: keyCertSign | cRLSign
  match cert.key_usage {
    Some(ku) => {
      debug_assert(ku.key_cert_sign(), "keyCertSign")
      debug_assert(ku.crl_sign(), "cRLSign")
      debug_assert(!ku.digital_signature(), "not digitalSignature")
    }
    None => debug_assert(false, "missing KeyUsage")
  }

  // SKI and AKI present and equal for self-signed CA
  match cert.subject_key_identifier {
    Some(ski) => {
      debug_assert(ski.length() == 20, "SHA-1 SKI len 20")
      match cert.authority_key_identifier {
        Some(aki) =>
        match aki.key_id {
          Some(akid) => debug_assert(x509_bytes_eq(ski, akid), "AKI == SKI")
          None => debug_assert(false, "missing AKI key_id")
        }
        None => debug_assert(false, "missing AKI")
      }
    }
    None => debug_assert(false, "missing SKI")
  }
}

test "x509_parse_ec256_leaf_and_hostname_verify" {
  let cert = match parse_x509_pem(test_ec256_cert_pem) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, asn1_error_message(e))
      return ()
    }
  }
  debug_assert(cert.version == 3, "v3")
  debug_assert(cert.subject_public_key_info.algorithm.oid == oid_ec_public_key, "ecPublicKey")
  match cert.subject_public_key_info.algorithm.curve_oid {
    Some(curve) => debug_assert(curve == oid_secp256r1, "P-256 curve OID")
    None => debug_assert(false, "missing curve OID")
  }
  debug_assert(cert.subject_public_key_info.public_key.length() == 65, "uncompressed P-256 pubkey")

  // BasicConstraints CA:FALSE
  match cert.basic_constraints {
    Some(bc) => debug_assert(!bc.is_ca, "not CA")
    None => debug_assert(false, "missing BasicConstraints")
  }

  // KeyUsage: digitalSignature + keyEncipherment
  match cert.key_usage {
    Some(ku) => {
      debug_assert(ku.digital_signature(), "digitalSignature")
      debug_assert(ku.key_encipherment(), "keyEncipherment")
      debug_assert(!ku.key_cert_sign(), "not keyCertSign")
    }
    None => debug_assert(false, "missing KeyUsage")
  }

  // ExtKeyUsage: serverAuth + clientAuth
  debug_assert(cert.ext_key_usage.length() == 2, "2 EKU OIDs")
  debug_assert(cert.ext_key_usage[0] == oid_eku_server_auth, "serverAuth")
  debug_assert(cert.ext_key_usage[1] == oid_eku_client_auth, "clientAuth")

  // SAN: 6 entries (2 DNS, 2 IP, 1 URI, 1 Email)
  debug_assert(cert.san.length() == 6, "6 SAN entries")

  // Hostname verification (RFC 6125 / RFC 9525)
  debug_assert(verify_hostname(cert, "api.example.com"), "exact DNS match")
  debug_assert(verify_hostname(cert, "API.EXAMPLE.COM"), "case-insensitive DNS match")
  debug_assert(verify_hostname(cert, "foo.sub.example.com"), "wildcard match")
  debug_assert(!verify_hostname(cert, "a.b.sub.example.com"), "wildcard must not match multi-label")
  debug_assert(!verify_hostname(cert, "sub.example.com"), "wildcard must not match bare parent")
  debug_assert(!verify_hostname(cert, "evil.com"), "unrelated domain")
  debug_assert(verify_hostname(cert, "192.0.2.1"), "IPv4 SAN match")
  debug_assert(!verify_hostname(cert, "192.0.2.2"), "IPv4 mismatch")
  debug_assert(verify_hostname(cert, "2001:db8::1"), "IPv6 SAN match")
  debug_assert(verify_hostname(cert, "2001:0db8:0000:0000:0000:0000:0000:0001"), "IPv6 expanded match")
  debug_assert(!verify_hostname(cert, "2001:db8::2"), "IPv6 mismatch")
}

test "x509_parse_ed25519_and_pem_chain" {
  let chain_pem = test_ec256_cert_pem + "\n" + test_ca_cert_pem + "\n" + test_ed25519_cert_pem
  let certs = match parse_x509_pem_chain(chain_pem) {
    Ok(cs) => cs
    Err(e) => {
      debug_assert(false, asn1_error_message(e))
      return ()
    }
  }
  debug_assert(certs.length() == 3, "3 certs in chain")
  let ed = certs[2]
  debug_assert(ed.signature_algorithm.oid == oid_ed25519, "ed25519 sig alg")
  debug_assert(ed.subject_public_key_info.algorithm.oid == oid_ed25519, "ed25519 spki")
  debug_assert(ed.subject_public_key_info.public_key.length() == 32, "32-byte ed25519 pubkey")
  debug_assert(ed.signature_bytes.length() == 64, "64-byte ed25519 sig")
  debug_assert(verify_hostname(ed, "ed.pion.dev"), "ed.pion.dev")
  debug_assert(verify_hostname(ed, "x.ed.pion.dev"), "wildcard ed.pion.dev")
}

test "spki_and_pkcs8_roundtrip_all_algorithms" {
  let spkis = [
    ("ec256", oid_ec_public_key, Some(oid_secp256r1), 65, "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEor2JJs14aSFQQn+5GJ8W1kl4C9ztNhRdjEGajy/6QX6Vudr4uvcTGgBEbM1J9dUgmyI23373dTO/CU5iUBcnhw=="),
    ("ec384", oid_ec_public_key, Some(oid_secp384r1), 97, "MHYwEAYHKoZIzj0CAQYFK4EEACIDYgAEXQ9IbQNS6uYuFVGZzHkDLaxz+ENExwQYDq8UO2/mwKCPPlDBvSpt6O+dxR5myLWbMK9a1mBn76x3DwxwxhmCjVeZtbsbBof8+ZxlpBM7nFEmaZRZp7OzoxbyxHaOOoyX"),
    ("ed25519", oid_ed25519, None, 32, "MCowBQYDK2VwAyEAIJHQSGhyZB1rK8Fvv6CU1fqj4GhyQhzVZC49i66USPA="),
    ("x25519", oid_x25519, None, 32, "MCowBQYDK2VuAyEAD1fa9bHNPAy069pxV2ObYQXmVbga/KYvPROVB8za4Rg="),
    ("rsa", oid_rsa_encryption, None, 270, ""),
  ]
  let mut i = 0
  while i < spkis.length() {
    let (_, expected_oid, expected_curve, expected_len, b64) = spkis[i]
    let der = b64_must(b64)
    let spki = match parse_spki_der(der) {
      Ok(s) => s
      Err(e) => {
        debug_assert(false, asn1_error_message(e))
        return ()
      }
    }
    debug_assert(spki.algorithm.oid == expected_oid, "spki oid")
    debug_assert(spki.public_key.length() == expected_len, "spki pubkey len")
    match expected_curve {
      Some(c) =>
      match spki.algorithm.curve_oid {
        Some(actual) => debug_assert(actual == c, "curve oid")
        None => debug_assert(false, "expected curve oid")
      }
      None => ()
    }
    let reenc = match encode_spki_der(spki) {
      Ok(b) => b
      Err(e) => {
        debug_assert(false, asn1_error_message(e))
        Bytes::new(0)
      }
    }
    debug_assert(x509_bytes_eq(der, reenc), "spki DER roundtrip byte-exact")
    i = i + 1
  }

  let pkcs8s = [
    ("ec256", oid_ec_public_key, "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgwe/9ZoozvYShcoiLZbKpf4W3ZrolqsBFahjyuTAxMJuhRANCAASivYkmzXhpIVBCf7kYnxbWSXgL3O02FF2MQZqPL/pBfpW52vi69xMaAERszUn11SCbIjbffvd1M78JTmJQFyeH"),
    ("ed25519", oid_ed25519, "MC4CAQAwBQYDK2VwBCIEIK+waFBLhfvLACm107WXCzbta/cq+nT0TrOIl1vFvNp8"),
    ("x25519", oid_x25519, "MC4CAQAwBQYDK2VuBCIEIIhwXO21VVZD6HWYEeNAKBpXusdBCIOKWa0yaKJ4EfVv"),
    ("ec384", oid_ec_public_key, "MIG2AgEAMBAGByqGSM49AgEGBSuBBAAiBIGeMIGbAgEBBDBhUd7uF2iXRkMq0Fy4XvGIz0UynVdzZFr3pbc2WwOYdBu0oAjS8JNGri7fwImnAMehZANiAARdD0htA1Lq5i4VUZnMeQMtrHP4Q0THBBgOrxQ7b+bAoI8+UMG9Km3o753FHmbItZswr1rWYGfvrHcPDHDGGYKNV5m1uxsGh/z5nGWkEzucUSZplFmns7OjFvLEdo46jJc="),
  ]
  i = 0
  while i < pkcs8s.length() {
    let (_, expected_oid, b64) = pkcs8s[i]
    let der = b64_must(b64)
    let p8 = match parse_pkcs8_der(der) {
      Ok(k) => k
      Err(e) => {
        debug_assert(false, asn1_error_message(e))
        return ()
      }
    }
    debug_assert(p8.version == 0, "pkcs8 v0")
    debug_assert(p8.algorithm.oid == expected_oid, "pkcs8 oid")
    let reenc = match encode_pkcs8_der(p8) {
      Ok(b) => b
      Err(e) => {
        debug_assert(false, asn1_error_message(e))
        Bytes::new(0)
      }
    }
    debug_assert(x509_bytes_eq(der, reenc), "pkcs8 DER roundtrip byte-exact")
    i = i + 1
  }
}

test "x509_v1_cert_without_version_field" {
  // Construct a minimal valid X.509 v1 certificate (no [0] EXPLICIT version, no [3] extensions)
  let tbs = DerWriter::new()
  // serialNumber = 1
  tbs.write_int64(1L)
  // signature AlgorithmIdentifier (ed25519)
  let alg_w = DerWriter::new()
  let _ = alg_w.write_oid_str(oid_ed25519)
  let alg_seq = DerWriter::new()
  alg_seq.write_sequence(alg_w.to_bytes())
  let alg_bytes = alg_seq.to_bytes()
  // issuer = SEQUENCE { SET { SEQUENCE { OID CN, UTF8String "v1.test" } } }
  let atv_w = DerWriter::new()
  let _ = atv_w.write_oid_str(oid_cn)
  atv_w.write_utf8_string("v1.test")
  let atv_seq = DerWriter::new()
  atv_seq.write_sequence(atv_w.to_bytes())
  let rdn_set = DerWriter::new()
  rdn_set.write_set(atv_seq.to_bytes())
  let name_seq = DerWriter::new()
  name_seq.write_sequence(rdn_set.to_bytes())
  let name_bytes = name_seq.to_bytes()
  // validity
  let val_w = DerWriter::new()
  val_w.write_tlv(tag_utc_time, "260101000000Z".to_bytes())
  val_w.write_tlv(tag_utc_time, "270101000000Z".to_bytes())
  let val_seq = DerWriter::new()
  val_seq.write_sequence(val_w.to_bytes())
  // spki (ed25519)
  let spki_bytes = b64_must("MCowBQYDK2VwAyEAIJHQSGhyZB1rK8Fvv6CU1fqj4GhyQhzVZC49i66USPA=")

  let tbs_body = tbs.to_bytes().concat(alg_bytes).concat(name_bytes).concat(val_seq.to_bytes()).concat(name_bytes).concat(spki_bytes)
  let tbs_seq = DerWriter::new()
  tbs_seq.write_sequence(tbs_body)
  let sig_w = DerWriter::new()
  let _ = sig_w.write_bit_string(0, Bytes::new(64))
  let cert_body = tbs_seq.to_bytes().concat(alg_bytes).concat(sig_w.to_bytes())
  let cert_seq = DerWriter::new()
  cert_seq.write_sequence(cert_body)

  let cert = match parse_x509_der(cert_seq.to_bytes()) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, asn1_error_message(e))
      return ()
    }
  }
  debug_assert(cert.version == 1, "implicit v1")
  match cert.subject.common_name {
    Some(cn) => debug_assert(cn == "v1.test", "v1 CN")
    None => debug_assert(false, "missing v1 CN")
  }
}
