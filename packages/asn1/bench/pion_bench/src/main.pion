///| Head-to-head benchmark for `packages/asn1` (Pion Native):
///|   1. pem_chain <certs_100.pem>      : 100 rounds x 100 real X.509 v3 PEM certs = 10,000 certs
///|   2. der_x509_host <certs_100.derbin>: 500 rounds x 100 DER certs + 3x hostname verify = 50,000 certs
///|   3. der_tlv_roundtrip              : 100,000 ASN.1 DER generic TLV encode + decode roundtrips

import "asn1"

fn fmt3(n : Int) -> String {
  let d2 = n / 100
  let d1 = (n / 10) % 10
  let d0 = n % 10
  d2.to_string() + d1.to_string() + d0.to_string()
}

fn run_pem_chain(world : World, path : String) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read pem corpus")
      return 1
    }
  }
  let pem_text = raw.to_string()
  let mut total_certs = 0
  let mut cn_bytes : Int64 = 0L
  let mut san_count : Int64 = 0L
  let mut ca_count = 0
  let mut spki_bytes : Int64 = 0L
  let mut sig_bytes : Int64 = 0L
  let mut time_sum : Int64 = 0L

  let mut r = 0
  while r < 100 {
    let certs = match asn1::parse_x509_pem_chain(pem_text) {
      Ok(cs) => cs
      Err(e) => {
        io_println(world, "parse_x509_pem_chain failed: " + asn1::asn1_error_message(e))
        return 2
      }
    }
    let mut i = 0
    while i < certs.length() {
      let c = certs[i]
      total_certs = total_certs + 1
      match c.subject.common_name {
        Some(cn) => cn_bytes = cn_bytes + cn.length().to_int64()
        None => ()
      }
      san_count = san_count + c.san.length().to_int64()
      match c.basic_constraints {
        Some(bc) => if bc.is_ca { ca_count = ca_count + 1 }
        None => ()
      }
      spki_bytes = spki_bytes + c.subject_public_key_info.raw.length().to_int64()
      sig_bytes = sig_bytes + c.signature_bytes.length().to_int64()
      time_sum = time_sum + c.not_before + c.not_after
      i = i + 1
    }
    r = r + 1
  }

  io_println(world, "certs=" + total_certs.to_string())
  io_println(world, "cn_bytes=" + cn_bytes.to_string())
  io_println(world, "san_count=" + san_count.to_string())
  io_println(world, "ca_count=" + ca_count.to_string())
  io_println(world, "spki_bytes=" + spki_bytes.to_string())
  io_println(world, "sig_bytes=" + sig_bytes.to_string())
  io_println(world, "time_sum=" + time_sum.to_string())
  0
}

fn run_der_x509_host(world : World, path : String) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read derbin corpus")
      return 1
    }
  }
  // Unpack length-prefixed DER records
  let ders : Array[Bytes] = []
  let mut pos = 0
  let n = raw.length()
  while pos + 4 <= n {
    let clen = (raw[pos].to_int() << 24) |
    (raw[pos + 1].to_int() << 16) |
    (raw[pos + 2].to_int() << 8) |
    raw[pos + 3].to_int()
    pos = pos + 4
    ders.push(raw.slice(pos, pos + clen))
    pos = pos + clen
  }
  let exact_hosts : Array[String] = []
  let wild_hosts : Array[String] = []
  let mut idx = 0
  while idx < ders.length() {
    let tag = fmt3(idx)
    exact_hosts.push("svc-" + tag + ".pion.dev")
    wild_hosts.push("api.t" + tag + ".pion.dev")
    idx = idx + 1
  }

  let mut total_certs = 0
  let mut host_ok = 0
  let mut host_fail = 0
  let mut tbs_bytes : Int64 = 0L
  let mut time_sum : Int64 = 0L

  let mut r = 0
  while r < 500 {
    let mut i = 0
    while i < ders.length() {
      let c = match asn1::parse_x509_der(ders[i]) {
        Ok(cert) => cert
        Err(e) => {
          io_println(world, "parse_x509_der failed: " + asn1::asn1_error_message(e))
          return 2
        }
      }
      total_certs = total_certs + 1
      tbs_bytes = tbs_bytes + c.tbs_bytes.length().to_int64()
      time_sum = time_sum + c.not_before
      if asn1::verify_hostname(c, exact_hosts[i]) {
        host_ok = host_ok + 1
      } else {
        host_fail = host_fail + 1
      }
      if asn1::verify_hostname(c, wild_hosts[i]) {
        host_ok = host_ok + 1
      } else {
        host_fail = host_fail + 1
      }
      if asn1::verify_hostname(c, "nope.other.invalid") {
        host_ok = host_ok + 1
      } else {
        host_fail = host_fail + 1
      }
      i = i + 1
    }
    r = r + 1
  }

  io_println(world, "certs=" + total_certs.to_string())
  io_println(world, "host_ok=" + host_ok.to_string())
  io_println(world, "host_fail=" + host_fail.to_string())
  io_println(world, "tbs_bytes=" + tbs_bytes.to_string())
  io_println(world, "time_sum=" + time_sum.to_string())
  0
}

fn run_der_tlv_roundtrip(world : World) -> Int {
  let payloads : Array[Bytes] = []
  let labels : Array[String] = []
  let mut i = 0
  while i < 100 {
    let p = Bytes::new(24)
    let mut k = 0
    while k < 24 {
      p[k] = ((i + k * 7) & 0xFF).to_byte()
      k = k + 1
    }
    payloads.push(p)
    labels.push("asn1-record-" + i.to_string())
    i = i + 1
  }

  let mut ops = 0
  let mut encoded_bytes : Int64 = 0L
  let mut int_sum : Int64 = 0L
  let mut bool_true = 0
  let mut payload_sum : Int64 = 0L
  let mut str_bytes : Int64 = 0L

  let mut r = 0
  while r < 1000 {
    i = 0
    while i < 100 {
      let inner = asn1::DerWriter::with_capacity(96)
      inner.write_int64(i.to_int64() * 100003L + 7L)
      inner.write_bool((i & 1) == 0)
      inner.write_octet_string(payloads[i])
      let _ = inner.write_oid_str(asn1::oid_sha256_with_rsa)
      inner.write_utf8_string(labels[i])
      let sub = asn1::DerWriter::with_capacity(24)
      sub.write_int64(i.to_int64() * 3L)
      sub.write_int64(-(i.to_int64() * 5L) - 1L)
      sub.write_int64(i.to_int64() * 17L + 128L)
      inner.write_sequence(sub.to_bytes())
      let outer = asn1::DerWriter::with_capacity(inner.len + 4)
      outer.write_sequence(inner.to_bytes())
      let der = outer.to_bytes()
      encoded_bytes = encoded_bytes + der.length().to_int64()

      // Decode back strictly
      let rd = asn1::DerReader::new(der)
      let seq = match rd.read_sequence() {
        Ok(s) => s
        Err(_) => return 3
      }
      let id = match seq.read_int64() {
        Ok(v) => v
        Err(_) => return 4
      }
      let active = match seq.read_bool() {
        Ok(b) => b
        Err(_) => return 5
      }
      let os = match seq.read_octet_string() {
        Ok(b) => b
        Err(_) => return 6
      }
      let _oid = match seq.read_oid_str() {
        Ok(o) => o
        Err(_) => return 7
      }
      let lbl = match seq.read_utf8_string() {
        Ok(s) => s
        Err(_) => return 8
      }
      let sub_rd = match seq.read_sequence() {
        Ok(s) => s
        Err(_) => return 9
      }
      let a = match sub_rd.read_int64() {
        Ok(v) => v
        Err(_) => return 10
      }
      let b = match sub_rd.read_int64() {
        Ok(v) => v
        Err(_) => return 11
      }
      let c = match sub_rd.read_int64() {
        Ok(v) => v
        Err(_) => return 12
      }
      int_sum = int_sum + id + a + b + c
      if active {
        bool_true = bool_true + 1
      }
      let mut k = 0
      while k < os.length() {
        payload_sum = payload_sum + os[k].to_int().to_int64()
        k = k + 1
      }
      str_bytes = str_bytes + lbl.length().to_int64()
      ops = ops + 1
      i = i + 1
    }
    r = r + 1
  }

  io_println(world, "ops=" + ops.to_string())
  io_println(world, "encoded_bytes=" + encoded_bytes.to_string())
  io_println(world, "int_sum=" + int_sum.to_string())
  io_println(world, "bool_true=" + bool_true.to_string())
  io_println(world, "payload_sum=" + payload_sum.to_string())
  io_println(world, "str_bytes=" + str_bytes.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: pion_bench <pem_chain|der_x509_host|der_tlv_roundtrip> [corpus]")
    return 1
  }
  let cmd = args[1]
  if cmd == "pem_chain" {
    if args.length() < 3 {
      return 1
    }
    run_pem_chain(world, args[2])
  } else if cmd == "der_x509_host" {
    if args.length() < 3 {
      return 1
    }
    run_der_x509_host(world, args[2])
  } else if cmd == "der_tlv_roundtrip" {
    run_der_tlv_roundtrip(world)
  } else {
    io_println(world, "unknown cmd: " + cmd)
    1
  }
}
