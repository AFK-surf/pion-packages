///| Wasm32 + Native smoke entry for `packages/asn1`.

import "asn1"

let smoke_ec256_pem : String =
"-----BEGIN CERTIFICATE-----\n" +
"MIIDajCCAlKgAwIBAgIEfxI0VjANBgkqhkiG9w0BAQsFADCBhTELMAkGA1UEBhMC\n" +
"VVMxEzARBgNVBAgMCkNhbGlmb3JuaWExFjAUBgNVBAcMDVNhbiBGcmFuY2lzY28x\n" +
"FjAUBgNVBAoMDVBpb24gVGVzdCBPcmcxFTATBgNVBAsMDFJvb3QgQ0EgVW5pdDEa\n" +
"MBgGA1UEAwwRUGlvbiBUZXN0IFJvb3QgQ0EwHhcNMjYxMTIzMDc0MjUxWhcNMjcx\n" +
"MTIzMDc0MjUxWjA8MQswCQYDVQQGEwJKUDETMBEGA1UECgwKUGlvbiBDbG91ZDEY\n" +
"MBYGA1UEAwwPYXBpLmV4YW1wbGUuY29tMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcD\n" +
"QgAEor2JJs14aSFQQn+5GJ8W1kl4C9ztNhRdjEGajy/6QX6Vudr4uvcTGgBEbM1J\n" +
"9dUgmyI23373dTO/CU5iUBcnh6OB9DCB8TAMBgNVHRMBAf8EAjAAMA4GA1UdDwEB\n" +
"/wQEAwIFoDAdBgNVHSUEFjAUBggrBgEFBQcDAQYIKwYBBQUHAwIwHQYDVR0OBBYE\n" +
"FAoEeg3xTWUXwtL74T7iH44Dm/fwMB8GA1UdIwQYMBaAFNDIgZlOKKnbJdh9ALre\n" +
"+J7J6VckMHIGA1UdEQRrMGmCD2FwaS5leGFtcGxlLmNvbYIRKi5zdWIuZXhhbXBs\n" +
"ZS5jb22HBMAAAgGHECABDbgAAAAAAAAAAAAAAAGGGmh0dHBzOi8vYXBpLmV4YW1w\n" +
"bGUuY29tL2lkgQ9vcHNAZXhhbXBsZS5jb20wDQYJKoZIhvcNAQELBQADggEBAGif\n" +
"F3M2w9FjguLF6wfCK7GjwP5VDjOGrf7RBXqh6X2sIquSdmn5vc3yat/bmlx8wzHg\n" +
"OZfRRwr9objzYnoOIKCNXznyU044O7iyVRkkbrMFICwX224svi7OC18W235G4Ok5\n" +
"H/dXm8EfrHeD++DMAFY4r8+PmDi3bKGeICvi7dXZzoMdHM5zkrXemvPX/WyvKwXR\n" +
"E9WdCPE4mPvuXGEX/XVoAvyW87JhXOq11WPlm9Vghb+bfWRqlLPlOsC2PB+H5I1p\n" +
"OTQA1hmqOw4LoGgSl2E+EiZK2rbX9j+NI+ol5b7B8DZtvymKeHoP4EA+iK48NsAU\n" +
"5UzRsu7Lbw/GZq4OrMY=\n" +
"-----END CERTIFICATE-----\n"

///|
pub fn smoke() -> String {
  // 1. Parse real ECDSA P-256 X.509 v3 cert from PEM
  let cert = match asn1::parse_x509_pem(smoke_ec256_pem) {
    Ok(c) => c
    Err(e) => return "FAIL:parse_x509_pem:" + asn1::asn1_error_message(e)
  }
  if cert.version != 3 || cert.san.length() != 6 {
    return "FAIL:cert_fields"
  }
  if !asn1::verify_hostname(cert, "api.example.com") ||
  !asn1::verify_hostname(cert, "foo.sub.example.com") ||
  !asn1::verify_hostname(cert, "192.0.2.1") ||
  !asn1::verify_hostname(cert, "2001:db8::1") ||
  asn1::verify_hostname(cert, "evil.com") {
    return "FAIL:verify_hostname"
  }
  // 2. SPKI DER roundtrip
  let spki_reenc = match asn1::encode_spki_der(cert.subject_public_key_info) {
    Ok(b) => b
    Err(e) => return "FAIL:encode_spki:" + asn1::asn1_error_message(e)
  }
  if spki_reenc.length() != cert.subject_public_key_info.raw.length() {
    return "FAIL:spki_len"
  }
  // 3. DER element tree roundtrip
  let w = asn1::DerWriter::new()
  w.write_int64(20261123L)
  w.write_utf8_string("pion-asn1")
  let seq = asn1::DerWriter::new()
  seq.write_sequence(w.to_bytes())
  let elem = match asn1::parse_der_element(seq.to_bytes()) {
    Ok(e) => e
    Err(e) => return "FAIL:parse_der:" + asn1::asn1_error_message(e)
  }
  let reenc = asn1::encode_der_element(elem)
  if reenc.length() != seq.to_bytes().length() {
    return "FAIL:der_roundtrip"
  }
  // 4. Red-team depth bomb (200 nested SEQUENCEs -> DepthLimitExceeded without trap)
  let mut nested = Bytes::new(2)
  nested[0] = (0x30).to_byte()
  nested[1] = (0x00).to_byte()
  let mut d = 0
  while d < 200 {
    let nw = asn1::DerWriter::with_capacity(nested.length() + 4)
    nw.write_sequence(nested)
    nested = nw.to_bytes()
    d = d + 1
  }
  match asn1::parse_der_element(nested) {
    Err(asn1::Asn1Error::DepthLimitExceeded(_)) => ()
    _ => return "FAIL:depth_bomb"
  }
  // 5. Red-team 2 GiB length bomb -> Err without OOM
  let bomb = Bytes::new(10)
  bomb[0] = (0x04).to_byte()
  bomb[1] = (0x84).to_byte()
  bomb[2] = (0x7F).to_byte()
  bomb[3] = (0xFF).to_byte()
  bomb[4] = (0xFF).to_byte()
  bomb[5] = (0xFF).to_byte()
  match asn1::parse_der_element(bomb) {
    Err(_) => ()
    Ok(_) => return "FAIL:oom_bomb"
  }
  let cn = match cert.subject.common_name {
    Some(s) => s
    None => ""
  }
  "asn1_wasm_smoke: OK version=" +
  cert.version.to_string() +
  " cn=" +
  cn +
  " san=" +
  cert.san.length().to_string() +
  " spki_bytes=" +
  spki_reenc.length().to_string() +
  " tbs_bytes=" +
  cert.tbs_bytes.length().to_string()
}

///|
pub fn main(world : World) -> Int {
  let msg = smoke()
  io_println(world, msg)
  if msg.length() >= 19 && msg.code_unit_at(17) == 79 && msg.code_unit_at(18) == 75 {
    0
  } else {
    1
  }
}
