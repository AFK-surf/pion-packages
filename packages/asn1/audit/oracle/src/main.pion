///| Red-team differential oracle for `packages/asn1` (Pion side).
///|
///| Modes (line-oriented output, diffed against the Go / Rust oracles in ../diff):
///|   vectors <corpus.tsv>        one "<label>\t<result>" line per corpus vector
///|   deep <n> <max_depth> <parse|encode>  n nested SEQUENCEs under DecodeLimits.max_depth (+ re-encode), then drop
///|   bench <shape> <iters>       adversarial-shape throughput probe (see run_bench)
///|   certs <file.derbin> <iters> parse length-prefixed DER certs <iters> times
///|   phases <file.derbin> <iters> wall-clock cost breakdown (generic tree / x509 / x509+host / OIDs)

import "asn1"

///|
let hex_digits : String = "0123456789abcdef"

///|
fn to_hex(b : Bytes) -> String {
  let n = b.length()
  let out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = b[i].to_int()
    out[2 * i] = hex_digits.code_unit_at(v >> 4).to_byte()
    out[2 * i + 1] = hex_digits.code_unit_at(v & 15).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Decode hex from buf[start, end).
fn from_hex(buf : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_val(buf[start + 2 * i].to_int())
    let lo = hex_val(buf[start + 2 * i + 1].to_int())
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn err_of(e : asn1::Asn1Error) -> String {
  "ERR:" + asn1::asn1_error_message(e)
}

///| Decode exactly one value of `kind` occupying all of `der`.
fn run_typed(kind : String, der : Bytes) -> String {
  let r = asn1::DerReader::new(der)
  let res : Result[String, asn1::Asn1Error] = if kind == "bool" {
    match r.read_bool() {
      Ok(v) => Ok(if v { "true" } else { "false" })
      Err(e) => Err(e)
    }
  } else if kind == "int64" {
    match r.read_int64() {
      Ok(v) => Ok(v.to_string())
      Err(e) => Err(e)
    }
  } else if kind == "uint64" {
    match r.read_uint64() {
      Ok(v) => Ok(v.to_string())
      Err(e) => Err(e)
    }
  } else if kind == "bits" {
    match r.read_bit_string() {
      Ok(v) => Ok(v.unused_bits.to_string() + ":" + to_hex(v.bytes))
      Err(e) => Err(e)
    }
  } else if kind == "octet" {
    match r.read_octet_string() {
      Ok(v) => Ok(to_hex(v))
      Err(e) => Err(e)
    }
  } else if kind == "null" {
    match r.read_null() {
      Ok(_) => Ok("null")
      Err(e) => Err(e)
    }
  } else if kind == "oid" {
    match r.read_oid() {
      Ok(v) => Ok(v.to_string())
      Err(e) => Err(e)
    }
  } else if kind == "utf8" {
    match r.read_utf8_string() {
      Ok(v) => Ok(to_hex(v.to_bytes()))
      Err(e) => Err(e)
    }
  } else if kind == "printable" {
    match r.read_printable_string() {
      Ok(v) => Ok(to_hex(v.to_bytes()))
      Err(e) => Err(e)
    }
  } else if kind == "ia5" {
    match r.read_ia5_string() {
      Ok(v) => Ok(to_hex(v.to_bytes()))
      Err(e) => Err(e)
    }
  } else if kind == "bmp" {
    match r.read_bmp_string() {
      Ok(v) => Ok(to_hex(v.to_bytes()))
      Err(e) => Err(e)
    }
  } else if kind == "utc" {
    match r.read_utc_time() {
      Ok(v) => Ok(v.to_string())
      Err(e) => Err(e)
    }
  } else if kind == "gen" {
    match r.read_generalized_time() {
      Ok(v) => Ok(v.to_string())
      Err(e) => Err(e)
    }
  } else {
    Ok("UNKNOWN_KIND")
  }
  match res {
    Ok(s) => if r.is_eof() { "OK:" + s } else { "ERR:trailing bytes" }
    Err(e) => err_of(e)
  }
}

///| Count every node of a parsed tree (iteratively).
fn count_nodes(root : asn1::DerElement) -> Int {
  let stack : Array[asn1::DerElement] = [root]
  let mut n = 0
  while stack.length() > 0 {
    let e = match stack.pop() {
      Some(x) => x
      None => break
    }
    n = n + 1
    let mut i = 0
    while i < e.children.length() {
      stack.push(e.children[i])
      i = i + 1
    }
  }
  n
}

///|
fn x509_summary(c : asn1::X509Certificate) -> String {
  "OK:v=" +
  c.version.to_string() +
  ":tbs=" +
  c.tbs_bytes.length().to_string() +
  ":nb=" +
  c.not_before.to_string() +
  ":na=" +
  c.not_after.to_string() +
  ":ext=" +
  c.extensions.length().to_string() +
  ":san=" +
  san_count(c).to_string()
}

///| Count dNSName / iPAddress / rfc822Name / URI entries (what Go and x509-parser expose).
fn san_count(c : asn1::X509Certificate) -> Int {
  let mut n = 0
  let mut i = 0
  while i < c.san.length() {
    match c.san[i] {
      asn1::GeneralName::Other(_, _) => ()
      _ => n = n + 1
    }
    i = i + 1
  }
  n
}

///|
fn run_one(kind : String, a : Bytes, b : Bytes) -> String {
  if kind == "tree" {
    let limits = asn1::DecodeLimits::{ max_depth: 64, max_elements: 65536, max_bytes: 16777216 }
    match asn1::parse_der_element_with_limits(a, limits) {
      Ok(t) => "OK:" + count_nodes(t).to_string()
      Err(e) => err_of(e)
    }
  } else if kind == "x509" {
    match asn1::parse_x509_der(a) {
      Ok(c) => x509_summary(c)
      Err(e) => err_of(e)
    }
  } else if kind == "host" {
    match asn1::parse_x509_der(a) {
      Ok(c) => if asn1::verify_hostname(c, b.to_string()) { "OK:true" } else { "OK:false" }
      Err(e) => err_of(e)
    }
  } else if kind == "spki" {
    match asn1::parse_spki_der(a) {
      Ok(_) => "OK"
      Err(e) => err_of(e)
    }
  } else if kind == "pkcs8" {
    match asn1::parse_pkcs8_der(a) {
      Ok(_) => "OK"
      Err(e) => err_of(e)
    }
  } else if kind == "pem" {
    match asn1::parse_pem(a.to_string()) {
      Ok(blk) => "OK:" + blk.label + ":" + to_hex(blk.data)
      Err(e) => err_of(e)
    }
  } else {
    run_typed(kind, a)
  }
}

///|
fn find_byte(buf : Bytes, from : Int, end : Int, c : Int) -> Int {
  let mut i = from
  while i < end && buf[i].to_int() != c {
    i = i + 1
  }
  i
}

///|
fn run_vectors(world : World, path : String) -> Int {
  let buf = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "cannot read " + path)
      return 1
    }
  }
  let n = buf.length()
  let sb = StringBuilder::new()
  let mut pos = 0
  let mut count = 0
  while pos < n {
    let le = find_byte(buf, pos, n, 10)
    let t1 = find_byte(buf, pos, le, 9)
    let t2 = find_byte(buf, t1 + 1, le, 9)
    let t3 = find_byte(buf, t2 + 1, le, 9)
    let label = buf.slice(pos, t1).to_string()
    let kind = buf.slice(t1 + 1, t2).to_string()
    let a = from_hex(buf, t2 + 1, t3)
    let b = if t3 < le { from_hex(buf, t3 + 1, le) } else { Bytes::new(0) }
    sb.write_string(label)
    sb.write_string("\t")
    sb.write_string(run_one(kind, a, b))
    sb.write_string("\n")
    count = count + 1
    pos = le + 1
  }
  io_print(world, sb.to_string())
  0
}

///| Build n nested SEQUENCEs (innermost `30 00`).
fn nested_sequences(n : Int) -> Bytes {
  let lens : Array[Int] = []
  let mut cur = 2
  lens.push(0)
  let mut i = 1
  while i < n {
    lens.push(cur)
    let hl = if cur < 128 { 1 } else if cur < 256 { 2 } else if cur < 65536 { 3 } else { 4 }
    cur = 1 + hl + cur
    i = i + 1
  }
  let buf = Bytes::new(cur)
  let mut p = 0
  let mut k = n - 1
  while k >= 1 {
    let cl = lens[k]
    buf[p] = (0x30).to_byte()
    p = p + 1
    if cl < 128 {
      buf[p] = cl.to_byte()
      p = p + 1
    } else if cl < 256 {
      buf[p] = (0x81).to_byte()
      buf[p + 1] = cl.to_byte()
      p = p + 2
    } else if cl < 65536 {
      buf[p] = (0x82).to_byte()
      buf[p + 1] = (cl >> 8).to_byte()
      buf[p + 2] = (cl & 0xFF).to_byte()
      p = p + 3
    } else {
      buf[p] = (0x83).to_byte()
      buf[p + 1] = (cl >> 16).to_byte()
      buf[p + 2] = ((cl >> 8) & 0xFF).to_byte()
      buf[p + 3] = (cl & 0xFF).to_byte()
      p = p + 4
    }
    k = k - 1
  }
  buf[p] = (0x30).to_byte()
  buf[p + 1] = (0).to_byte()
  buf
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///| Deep-nesting probe. phase = parse (parse + drop) | encode (parse + encode_der_element + drop).
fn run_deep(world : World, n : Int, max_depth : Int, phase : String) -> Int {
  let der = nested_sequences(n)
  let limits = asn1::DecodeLimits::{ max_depth: max_depth, max_elements: n + 10, max_bytes: 16777216 }
  match asn1::parse_der_element_with_limits(der, limits) {
    Ok(t) => {
      let mut msg = "deep n=" + n.to_string() + " bytes=" + der.length().to_string() + " parsed"
      if phase == "encode" {
        let enc = asn1::encode_der_element(t)
        msg = msg + " reencode_equal=" + (enc.length() == der.length()).to_string()
      }
      io_println(world, msg)
    }
    Err(e) => io_println(world, "deep n=" + n.to_string() + " ERR " + asn1::asn1_error_message(e))
  }
  io_println(world, "deep dropped ok")
  0
}

///|
fn read_derbin(world : World, path : String) -> Array[Bytes] {
  let out : Array[Bytes] = []
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => return out
  }
  let mut p = 0
  while p + 4 <= raw.length() {
    let l = (raw[p].to_int() << 24) | (raw[p + 1].to_int() << 16) | (raw[p + 2].to_int() << 8) | raw[p + 3].to_int()
    out.push(raw.slice(p + 4, p + 4 + l))
    p = p + 4 + l
  }
  out
}

///| Parse every cert of a derbin file `iters` times; checksum keeps the work observable.
fn run_certs(world : World, path : String, iters : Int) -> Int {
  let certs = read_derbin(world, path)
  let mut ok = 0
  let mut sum : Int64 = 0L
  let mut it = 0
  while it < iters {
    let mut i = 0
    while i < certs.length() {
      match asn1::parse_x509_der(certs[i]) {
        Ok(c) => {
          ok = ok + 1
          sum = sum + c.tbs_bytes.length().to_int64() + c.extensions.length().to_int64()
        }
        Err(_) => ()
      }
      i = i + 1
    }
    it = it + 1
  }
  io_println(world, "ok=" + ok.to_string() + " sum=" + sum.to_string())
  0
}

///| Cost breakdown on a derbin corpus (wall ms per phase, `iters` passes):
///|   tree   = generic parse_der_element of each cert (strict TLV walk + tree allocation)
///|   x509   = parse_x509_der
///|   host3  = parse_x509_der + 3 verify_hostname calls (the README W2 workload shape)
///|   oids   = read_oid_str of every OBJECT IDENTIFIER TLV found in the tree (fast table + slow path)
fn run_phases(world : World, path : String, iters : Int) -> Int {
  let certs = read_derbin(world, path)
  let limits = asn1::DecodeLimits::default()
  let mut sink = 0
  let t0 = clock_now_ms(world)
  let mut it = 0
  while it < iters {
    let mut i = 0
    while i < certs.length() {
      match asn1::parse_der_element_with_limits(certs[i], limits) {
        Ok(t) => sink = sink + t.children.length()
        Err(_) => ()
      }
      i = i + 1
    }
    it = it + 1
  }
  let t1 = clock_now_ms(world)
  it = 0
  while it < iters {
    let mut i = 0
    while i < certs.length() {
      match asn1::parse_x509_der(certs[i]) {
        Ok(c) => sink = sink + c.extensions.length()
        Err(_) => ()
      }
      i = i + 1
    }
    it = it + 1
  }
  let t2 = clock_now_ms(world)
  it = 0
  while it < iters {
    let mut i = 0
    while i < certs.length() {
      match asn1::parse_x509_der(certs[i]) {
        Ok(c) => {
          if asn1::verify_hostname(c, "svc-001.pion.dev") { sink = sink + 1 }
          if asn1::verify_hostname(c, "api.t001.pion.dev") { sink = sink + 1 }
          if asn1::verify_hostname(c, "nope.other.invalid") { sink = sink + 1 }
        }
        Err(_) => ()
      }
      i = i + 1
    }
    it = it + 1
  }
  let t3 = clock_now_ms(world)
  // collect OID TLV positions once, then decode them `iters` times
  let oid_slices : Array[Bytes] = []
  let mut i = 0
  while i < certs.length() {
    let d = certs[i]
    let mut p = 0
    while p + 2 < d.length() {
      if d[p].to_int() == 0x06 && d[p + 1].to_int() < 0x80 && p + 2 + d[p + 1].to_int() <= d.length() {
        let tlv = d.slice(p, p + 2 + d[p + 1].to_int())
        match asn1::DerReader::new(tlv).read_oid_str() {
          Ok(_) => oid_slices.push(tlv)
          Err(_) => ()
        }
      }
      p = p + 1
    }
    i = i + 1
  }
  let t4 = clock_now_ms(world)
  it = 0
  while it < iters {
    let mut k = 0
    while k < oid_slices.length() {
      match asn1::DerReader::new(oid_slices[k]).read_oid_str() {
        Ok(s) => sink = sink + s.length()
        Err(_) => ()
      }
      k = k + 1
    }
    it = it + 1
  }
  let t5 = clock_now_ms(world)
  io_println(world, "certs=" + certs.length().to_string() + " iters=" + iters.to_string() + " oid_tlvs=" + oid_slices.length().to_string())
  io_println(world, "tree_ms=" + (t1 - t0).to_string() + " x509_ms=" + (t2 - t1).to_string() + " x509_host3_ms=" + (t3 - t2).to_string() + " oids_ms=" + (t5 - t4).to_string() + " sink=" + sink.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mode = if args.length() > 1 { args[1] } else { "" }
  if mode == "vectors" && args.length() > 2 {
    run_vectors(world, args[2])
  } else if mode == "deep" && args.length() > 4 {
    run_deep(world, parse_int(args[2]), parse_int(args[3]), args[4])
  } else if mode == "phases" && args.length() > 3 {
    run_phases(world, args[2], parse_int(args[3]))
  } else if mode == "certs" && args.length() > 3 {
    run_certs(world, args[2], parse_int(args[3]))
  } else {
    io_eprintln(world, "usage: oracle vectors <corpus.tsv> | deep <n> <max_depth> <parse|encode> | certs <file.derbin> <iters>")
    2
  }
}
