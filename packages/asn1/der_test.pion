///| ITU-T X.690 strict DER compliance and roundtrip test suite.

fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    debug_assert(false, "invalid hex char")
    0
  }
}

fn hex_to_bytes(hex : String) -> Bytes {
  let n = hex.length()
  debug_assert(n % 2 == 0, "hex length must be even")
  let out = Bytes::new(n / 2)
  let mut i = 0
  while i < n / 2 {
    let hi = hex_nibble(hex.code_unit_at(i * 2))
    let lo = hex_nibble(hex.code_unit_at(i * 2 + 1))
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

test "der_boolean_strict_roundtrip" {
  let w = DerWriter::new()
  w.write_bool(false)
  w.write_bool(true)
  let raw = w.to_bytes()
  debug_assert(bytes_eq(raw, hex_to_bytes("0101000101ff")), "DER boolean bytes")

  let r = DerReader::new(raw)
  match r.read_bool() {
    Ok(v) => debug_assert(!v, "expected false")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_bool() {
    Ok(v) => debug_assert(v, "expected true")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  debug_assert(r.is_eof(), "expected eof")
}

test "der_integer_signed_and_unsigned_roundtrip" {
  let w = DerWriter::new()
  w.write_int64(0L)
  w.write_int64(127L)
  w.write_int64(128L)
  w.write_int64(-1L)
  w.write_int64(-128L)
  w.write_int64(-129L)
  w.write_int64(9223372036854775807L)
  w.write_int64(-9223372036854775807L - 1L)
  w.write_uint64(18446744073709551615UL)
  let raw = w.to_bytes()

  // Verify exact canonical encoding for edge cases
  let w0 = DerWriter::new()
  w0.write_int64(0L)
  debug_assert(bytes_eq(w0.to_bytes(), hex_to_bytes("020100")), "0 encoding")
  let w128 = DerWriter::new()
  w128.write_int64(128L)
  debug_assert(bytes_eq(w128.to_bytes(), hex_to_bytes("02020080")), "128 encoding")
  let wm128 = DerWriter::new()
  wm128.write_int64(-128L)
  debug_assert(bytes_eq(wm128.to_bytes(), hex_to_bytes("020180")), "-128 encoding")
  let wm129 = DerWriter::new()
  wm129.write_int64(-129L)
  debug_assert(bytes_eq(wm129.to_bytes(), hex_to_bytes("0202ff7f")), "-129 encoding")

  let r = DerReader::new(raw)
  match r.read_int64() {
    Ok(v) => debug_assert(v == 0L, "0")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_int64() {
    Ok(v) => debug_assert(v == 127L, "127")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_int64() {
    Ok(v) => debug_assert(v == 128L, "128")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_int64() {
    Ok(v) => debug_assert(v == -1L, "-1")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_int64() {
    Ok(v) => debug_assert(v == -128L, "-128")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_int64() {
    Ok(v) => debug_assert(v == -129L, "-129")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_int64() {
    Ok(v) => debug_assert(v == 9223372036854775807L, "i64 max")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_int64() {
    Ok(v) => debug_assert(v == -9223372036854775807L - 1L, "i64 min")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_uint64() {
    Ok(v) => debug_assert(v == 18446744073709551615UL, "u64 max")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  debug_assert(r.is_eof(), "eof")
}

test "der_bit_string_octet_string_null" {
  let w = DerWriter::new()
  match w.write_bit_string(0, Bytes::new(0)) {
    Ok(_) => ()
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match w.write_bit_string(3, hex_to_bytes("a8")) {
    Ok(_) => ()
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  w.write_octet_string(hex_to_bytes("deadbeef"))
  w.write_null()
  let raw = w.to_bytes()

  let r = DerReader::new(raw)
  match r.read_bit_string() {
    Ok(bs) => debug_assert(bs.unused_bits == 0 && bs.bytes.length() == 0, "empty bit string")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_bit_string() {
    Ok(bs) => debug_assert(bs.unused_bits == 3 && bytes_eq(bs.bytes, hex_to_bytes("a8")), "bit string a8")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_octet_string() {
    Ok(os) => debug_assert(bytes_eq(os, hex_to_bytes("deadbeef")), "octet string")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_null() {
    Ok(_) => ()
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  debug_assert(r.is_eof(), "eof")
}

test "der_oid_parse_format_roundtrip" {
  let oids = [
    "1.2.840.113549.1.1.11",
    "1.2.840.10045.3.1.7",
    "1.3.101.112",
    "2.5.4.3",
    "2.5.29.17",
    "2.999.3",
    "0.0",
  ]
  let mut i = 0
  while i < oids.length() {
    let s = oids[i]
    let oid = match parse_oid_str(s) {
      Ok(o) => o
      Err(e) => {
        debug_assert(false, asn1_error_message(e))
        Oid::{ arcs: [], text: "" }
      }
    }
    debug_assert(oid.to_string() == s, "oid text match")
    let enc = match encode_oid_bytes(oid) {
      Ok(b) => b
      Err(e) => {
        debug_assert(false, asn1_error_message(e))
        Bytes::new(0)
      }
    }
    let dec = match decode_oid_bytes(enc) {
      Ok(o) => o
      Err(e) => {
        debug_assert(false, asn1_error_message(e))
        Oid::{ arcs: [], text: "" }
      }
    }
    debug_assert(dec.to_string() == s, "oid roundtrip")
    i = i + 1
  }

  // Known DER bytes for sha256WithRSAEncryption (1.2.840.113549.1.1.11)
  let sha256_rsa_tlv = hex_to_bytes("06092a864886f70d01010b")
  let r = DerReader::new(sha256_rsa_tlv)
  match r.read_oid() {
    Ok(o) => debug_assert(o.to_string() == "1.2.840.113549.1.1.11", "sha256WithRSA OID")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
}

test "der_strings_and_bmp" {
  let w = DerWriter::new()
  w.write_utf8_string("Hello 世界 🌍")
  match w.write_printable_string("Pion Test Org-1 (CA)") {
    Ok(_) => ()
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match w.write_ia5_string("ops@example.com") {
    Ok(_) => ()
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  // VisibleString "ABC-123"
  w.write_tlv(tag_visible_string, "ABC-123".to_bytes())
  // BMPString "Hi" + U+4E2D ('中') = 00 48 00 69 4E 2D
  w.write_tlv(tag_bmp_string, hex_to_bytes("004800694e2d"))

  let r = DerReader::new(w.to_bytes())
  match r.read_utf8_string() {
    Ok(s) => debug_assert(s == "Hello 世界 🌍", "utf8")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_printable_string() {
    Ok(s) => debug_assert(s == "Pion Test Org-1 (CA)", "printable")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_ia5_string() {
    Ok(s) => debug_assert(s == "ops@example.com", "ia5")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_visible_string() {
    Ok(s) => debug_assert(s == "ABC-123", "visible")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_bmp_string() {
    Ok(s) => debug_assert(s == "Hi中", "bmp")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  debug_assert(r.is_eof(), "eof")
}

test "der_utc_and_generalized_time" {
  // 1999-12-31T23:59:59Z -> 946684799
  match parse_utc_time_str("991231235959Z") {
    Ok(ts) => debug_assert(ts == 946684799L, "1999-12-31")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  // 2000-01-01T00:00:00Z -> 946684800
  match parse_utc_time_str("000101000000Z") {
    Ok(ts) => debug_assert(ts == 946684800L, "2000-01-01")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  // 2026-11-23T07:42:51Z -> 1795419771
  match parse_utc_time_str("261123074251Z") {
    Ok(ts) => debug_assert(ts == 1795419771L, "2026-11-23")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  // Leap year 2024-02-29T12:00:00Z -> 1709208000
  match parse_generalized_time_str("20240229120000Z") {
    Ok(ts) => debug_assert(ts == 1709208000L, "2024-02-29")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  // Non-leap 2023-02-29 must fail
  match parse_generalized_time_str("20230229120000Z") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "2023-02-29 must be rejected")
  }
  // Missing Z must fail
  match parse_utc_time_str("261123074251") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "missing Z must be rejected")
  }
}

test "der_high_tag_and_set_of_canonical_sort" {
  // High tag number 31 (Application, primitive): 0x5F 0x1F 0x01 0xAA
  let w = DerWriter::new()
  let high_tag = Tag::new(TagClass::Application, false, 31)
  w.write_tlv(high_tag, hex_to_bytes("aa"))
  let high_tag2 = Tag::new(TagClass::Private, true, 128)
  w.write_tlv(high_tag2, hex_to_bytes("0500"))
  let raw = w.to_bytes()
  debug_assert(bytes_eq(raw, hex_to_bytes("5f1f01aaff8100020500")), "high tag encoding")

  let r = DerReader::new(raw)
  match r.read_header() {
    Ok(h) => debug_assert(h.tag.equals(high_tag) && h.content_len == 1, "high tag 31")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }
  match r.read_header() {
    Ok(h) => debug_assert(h.tag.equals(high_tag2) && h.content_len == 2, "high tag 128")
    Err(e) => debug_assert(false, asn1_error_message(e))
  }

  // SET OF canonical sorting: elements sorted lexicographically by encoded DER bytes
  let e1 = hex_to_bytes("020105")
  let e2 = hex_to_bytes("020101")
  let e3 = hex_to_bytes("020103")
  let ws = DerWriter::new()
  ws.write_set_of_sorted([e1, e2, e3])
  debug_assert(bytes_eq(ws.to_bytes(), hex_to_bytes("3109020101020103020105")), "SET OF sorted")
}

test "der_element_tree_roundtrip" {
  // SEQUENCE { INTEGER 42, OCTET STRING "hi", [0] EXPLICIT BOOLEAN true }
  let inner = DerWriter::new()
  inner.write_int64(42L)
  inner.write_octet_string("hi".to_bytes())
  let ctx_inner = DerWriter::new()
  ctx_inner.write_bool(true)
  inner.write_explicit_context(0, ctx_inner.to_bytes())
  let outer = DerWriter::new()
  outer.write_sequence(inner.to_bytes())
  let der = outer.to_bytes()

  let elem = match parse_der_element(der) {
    Ok(e) => e
    Err(e) => {
      debug_assert(false, asn1_error_message(e))
      DerElement::{ tag: tag_null, value: Bytes::new(0), children: [] }
    }
  }
  debug_assert(elem.tag.equals(tag_sequence), "root is sequence")
  debug_assert(elem.children.length() == 3, "3 children")
  debug_assert(elem.children[2].tag.equals(Tag::context(0, true)), "context [0]")
  debug_assert(elem.children[2].children.length() == 1, "context [0] has 1 child")
  let reencoded = encode_der_element(elem)
  debug_assert(bytes_eq(der, reencoded), "element roundtrip exact bytes")
}

test "c1_migrated_tag_class_and_key_usage_constants" {
  // TagClass roundtrip & equality
  let classes = [
    TagClass::Universal,
    TagClass::Application,
    TagClass::ContextSpecific,
    TagClass::Private,
  ]
  for i = 0; i < classes.length(); i = i + 1 {
    let c = classes[i]
    let code = tag_class_code(c)
    debug_assert(code == i, "tag_class_code matches index")
    debug_assert(tag_class_equals(tag_class_from_code(code), c), "tag_class roundtrip")
    for j = 0; j < classes.length(); j = j + 1 {
      debug_assert(tag_class_equals(c, classes[j]) == (i == j), "tag_class_equals iff")
    }
  }
  // KeyUsage zero, all-ones, and single-bit orthogonality
  let ku0 = KeyUsage::{ bits: 0 }
  debug_assert(
    !ku0.digital_signature() && !ku0.content_commitment() && !ku0.key_encipherment() &&
    !ku0.data_encipherment() && !ku0.key_agreement() && !ku0.key_cert_sign() &&
    !ku0.crl_sign() && !ku0.encipher_only() && !ku0.decipher_only(),
    "key_usage zero all false",
  )
  let ku_all = KeyUsage::{ bits: 511 }
  debug_assert(
    ku_all.digital_signature() && ku_all.content_commitment() && ku_all.key_encipherment() &&
    ku_all.data_encipherment() && ku_all.key_agreement() && ku_all.key_cert_sign() &&
    ku_all.crl_sign() && ku_all.encipher_only() && ku_all.decipher_only(),
    "key_usage all ones all true",
  )
  for bit = 0; bit < 9; bit = bit + 1 {
    let ku = KeyUsage::{ bits: 1 << bit }
    let flags = [
      ku.digital_signature(),
      ku.content_commitment(),
      ku.key_encipherment(),
      ku.data_encipherment(),
      ku.key_agreement(),
      ku.key_cert_sign(),
      ku.crl_sign(),
      ku.encipher_only(),
      ku.decipher_only(),
    ]
    for k = 0; k < 9; k = k + 1 {
      debug_assert(flags[k] == (k == bit), "key_usage single-bit orthogonality")
    }
  }
}
