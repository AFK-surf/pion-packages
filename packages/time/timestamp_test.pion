///| Offset, Timestamp, FixedDateTime, and SignedDuration tests ported from BurntSushi/jiff (65 tests).

///|
fn unwrap_ts(r : Result[Timestamp, TimeError]) -> Timestamp {
  match r {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, "expected Ok(Timestamp), got Err: " + e.message)
      Timestamp::unix_epoch()
    }
  }
}

///|
fn unwrap_off(r : Result[Offset, TimeError]) -> Offset {
  match r {
    Ok(o) => o
    Err(e) => {
      debug_assert(false, "expected Ok(Offset), got Err: " + e.message)
      Offset::utc()
    }
  }
}

///|
fn unwrap_dur(r : Result[SignedDuration, TimeError]) -> SignedDuration {
  match r {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "expected Ok(SignedDuration), got Err: " + e.message)
      SignedDuration::zero()
    }
  }
}

///|
fn is_err_ts(r : Result[Timestamp, TimeError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_off(r : Result[Offset, TimeError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_dur(r : Result[SignedDuration, TimeError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
test "offset_utc_min_max" {
  debug_assert(Offset::utc().seconds == 0, "utc")
  debug_assert(Offset::min().seconds == -93599, "min -25:59:59")
  debug_assert(Offset::max().seconds == 93599, "max +25:59:59")
}

///|
test "offset_from_seconds_valid_and_invalid" {
  debug_assert(unwrap_off(Offset::from_seconds(0)).seconds == 0, "0")
  debug_assert(unwrap_off(Offset::from_seconds(32400)).seconds == 32400, "+9h")
  debug_assert(unwrap_off(Offset::from_seconds(-19800)).seconds == -19800, "-5:30")
  debug_assert(unwrap_off(Offset::from_seconds(93599)).seconds == 93599, "max")
  debug_assert(unwrap_off(Offset::from_seconds(-93599)).seconds == -93599, "min")
  debug_assert(is_err_off(Offset::from_seconds(93600)), "max+1")
  debug_assert(is_err_off(Offset::from_seconds(-93600)), "min-1")
}

///|
test "offset_from_hours_and_hms" {
  debug_assert(unwrap_off(Offset::from_hours(9)).seconds == 32400, "+9")
  debug_assert(unwrap_off(Offset::from_hours(-5)).seconds == -18000, "-5")
  debug_assert(is_err_off(Offset::from_hours(26)), "26")
  debug_assert(is_err_off(Offset::from_hours(-26)), "-26")
  debug_assert(unwrap_off(Offset::from_hms(5, 30, 0)).seconds == 19800, "+5:30")
  debug_assert(unwrap_off(Offset::from_hms(-5, -30, 0)).seconds == -19800, "-5:30")
  debug_assert(unwrap_off(Offset::from_hms(25, 59, 59)).seconds == 93599, "+25:59:59")
  debug_assert(is_err_off(Offset::from_hms(1, 60, 0)), "m 60")
  debug_assert(is_err_off(Offset::from_hms(1, 0, 60)), "s 60")
}

///|
test "offset_negate" {
  let o = unwrap_off(Offset::from_hours(9))
  debug_assert(o.negate().seconds == -32400, "-9")
  debug_assert(Offset::utc().negate().seconds == 0, "0")
  debug_assert(Offset::min().negate().eq(Offset::max()), "min->max")
}

///|
test "timestamp_unix_epoch_and_bounds" {
  let ep = Timestamp::unix_epoch()
  debug_assert(ep.secs == 0L && ep.nanos == 0, "epoch")
  let tmin = Timestamp::min()
  let tmax = Timestamp::max()
  debug_assert(tmin.secs == -377705023201L && tmin.nanos == 0, "min")
  debug_assert(tmax.secs == 253402207200L && tmax.nanos == 999999999, "max")
}

///|
test "timestamp_new_positive_normalization" {
  let t1 = unwrap_ts(Timestamp::new(10L, 500000000))
  debug_assert(t1.secs == 10L && t1.nanos == 500000000, "t1")
  let t2 = unwrap_ts(Timestamp::new(10L, 1500000000))
  debug_assert(t2.secs == 11L && t2.nanos == 500000000, "t2 carry")
}

///|
test "timestamp_new_negative_subsec_normalization" {
  // -0.1s must normalize to secs=-1, nanos=900_000_000
  let t1 = unwrap_ts(Timestamp::new(0L, -100000000))
  debug_assert(t1.secs == -1L && t1.nanos == 900000000, "-0.1s")
  let t2 = unwrap_ts(Timestamp::new(5L, -1))
  debug_assert(t2.secs == 4L && t2.nanos == 999999999, "5s - 1ns")
  let t3 = unwrap_ts(Timestamp::new(-5L, -100000000))
  debug_assert(t3.secs == -6L && t3.nanos == 900000000, "-5s - 0.1s")
  let t4 = unwrap_ts(Timestamp::new(-1L, 100000000))
  debug_assert(t4.secs == -1L && t4.nanos == 100000000, "-1s + 0.1s")
}

///|
test "timestamp_new_out_of_bounds" {
  debug_assert(is_err_ts(Timestamp::new(-377705023202L, 0)), "below min")
  debug_assert(is_err_ts(Timestamp::new(-377705023201L, -1)), "min - 1ns")
  debug_assert(is_err_ts(Timestamp::new(253402207201L, 0)), "above max")
  debug_assert(is_err_ts(Timestamp::new(253402207200L, 1000000000)), "max + 1ns")
}

///|
test "timestamp_from_millis_micros_nanos_pre_1970" {
  let t1 = unwrap_ts(Timestamp::from_millisecond(-100L))
  debug_assert(t1.secs == -1L && t1.nanos == 900000000, "-100ms")
  let t2 = unwrap_ts(Timestamp::from_millisecond(-1000L))
  debug_assert(t2.secs == -1L && t2.nanos == 0, "-1000ms")
  let t3 = unwrap_ts(Timestamp::from_microsecond(-1L))
  debug_assert(t3.secs == -1L && t3.nanos == 999999000, "-1us")
  let t4 = unwrap_ts(Timestamp::from_nanosecond(-1L))
  debug_assert(t4.secs == -1L && t4.nanos == 999999999, "-1ns")
  let t5 = unwrap_ts(Timestamp::from_millisecond(1500L))
  debug_assert(t5.secs == 1L && t5.nanos == 500000000, "1500ms")
}

///|
test "timestamp_as_second_milli_micro" {
  let t = unwrap_ts(Timestamp::new(100L, 123456789))
  debug_assert(t.as_second() == 100L, "sec")
  debug_assert(t.as_millisecond() == 100123L, "ms")
  debug_assert(t.as_microsecond() == 100123456L, "us")
  let tn = unwrap_ts(Timestamp::from_millisecond(-100L))
  debug_assert(tn.as_millisecond() == -100L, "-100ms")
}

///|
test "timestamp_to_datetime_utc_epoch" {
  let dt = Timestamp::unix_epoch().to_utc_datetime()
  debug_assert(dt.date.year == 1970 && dt.date.month == 1 && dt.date.day == 1, "date")
  debug_assert(dt.time.hour == 0 && dt.time.minute == 0 && dt.time.second == 0 && dt.time.nanosecond == 0, "time")
}

///|
test "timestamp_to_datetime_pre_1970_fractional" {
  // -0.1s => 1969-12-31T23:59:59.900000000Z
  let ts = unwrap_ts(Timestamp::new(0L, -100000000))
  let dt = ts.to_utc_datetime()
  debug_assert(dt.date.year == 1969 && dt.date.month == 12 && dt.date.day == 31, "1969-12-31")
  debug_assert(dt.time.hour == 23 && dt.time.minute == 59 && dt.time.second == 59 && dt.time.nanosecond == 900000000, "23:59:59.9")
  let rt = unwrap_ts(Offset::utc().to_timestamp(dt))
  debug_assert(rt.eq(ts), "roundtrip")
}

///|
test "timestamp_to_datetime_with_positive_offset" {
  // 1970-01-01T00:00:00Z in +09:00 => 1970-01-01T09:00:00
  let off = unwrap_off(Offset::from_hours(9))
  let dt = Timestamp::unix_epoch().to_datetime(off)
  debug_assert(dt.date.year == 1970 && dt.date.month == 1 && dt.date.day == 1, "date")
  debug_assert(dt.time.hour == 9 && dt.time.minute == 0 && dt.time.second == 0, "09:00")
  let rt = unwrap_ts(off.to_timestamp(dt))
  debug_assert(rt.eq(Timestamp::unix_epoch()), "rt")
}

///|
test "timestamp_to_datetime_with_negative_offset_cross_year" {
  // 1970-01-01T00:00:00Z in -05:30 => 1969-12-31T18:30:00
  let off = unwrap_off(Offset::from_hms(-5, -30, 0))
  let dt = Timestamp::unix_epoch().to_datetime(off)
  debug_assert(dt.date.year == 1969 && dt.date.month == 12 && dt.date.day == 31, "1969-12-31")
  debug_assert(dt.time.hour == 18 && dt.time.minute == 30 && dt.time.second == 0, "18:30")
  let rt = unwrap_ts(off.to_timestamp(dt))
  debug_assert(rt.eq(Timestamp::unix_epoch()), "rt")
}

///|
test "timestamp_min_max_with_extreme_offsets" {
  let dt_min = Timestamp::min().to_datetime(Offset::min())
  debug_assert(dt_min.date.year == -9999 && dt_min.date.month == 1 && dt_min.date.day == 1, "-9999-01-01")
  debug_assert(dt_min.time.hour == 0 && dt_min.time.minute == 0 && dt_min.time.second == 0 && dt_min.time.nanosecond == 0, "00:00:00")
  let dt_max = Timestamp::max().to_datetime(Offset::max())
  debug_assert(dt_max.date.year == 9999 && dt_max.date.month == 12 && dt_max.date.day == 31, "9999-12-31")
  debug_assert(dt_max.time.hour == 23 && dt_max.time.minute == 59 && dt_max.time.second == 59 && dt_max.time.nanosecond == 999999999, "23:59:59.999999999")
  debug_assert(unwrap_ts(Offset::min().to_timestamp(dt_min)).eq(Timestamp::min()), "rt min")
  debug_assert(unwrap_ts(Offset::max().to_timestamp(dt_max)).eq(Timestamp::max()), "rt max")
}

///|
test "offset_to_timestamp_out_of_range" {
  // -9999-01-01T00:00:00 with +00:00 is below Timestamp::min()
  debug_assert(is_err_ts(Offset::utc().to_timestamp(DateTime::min())), "min utc err")
  // 9999-12-31T23:59:59 with +00:00 is above Timestamp::max()
  debug_assert(is_err_ts(Offset::utc().to_timestamp(DateTime::max())), "max utc err")
}

///|
test "timestamp_checked_add_sub" {
  let ts = unwrap_ts(Timestamp::new(123L, 500000000))
  let t1 = unwrap_ts(ts.checked_add(unwrap_dur(SignedDuration::new(1L, 600000000))))
  debug_assert(t1.secs == 125L && t1.nanos == 100000000, "add carry")
  let t2 = unwrap_ts(ts.checked_add(unwrap_dur(SignedDuration::new(-1L, -600000000))))
  debug_assert(t2.secs == 121L && t2.nanos == 900000000, "add neg borrow")
  let t3 = unwrap_ts(ts.checked_sub(unwrap_dur(SignedDuration::new(123L, 600000000))))
  debug_assert(t3.secs == -1L && t3.nanos == 900000000, "sub across 0")
}

///|
test "timestamp_checked_add_sub_overflow" {
  debug_assert(is_err_ts(Timestamp::max().checked_add(SignedDuration::from_nanos(1L))), "max +1ns")
  debug_assert(is_err_ts(Timestamp::min().checked_sub(SignedDuration::from_nanos(1L))), "min -1ns")
}

///|
test "timestamp_until_since" {
  let t1 = unwrap_ts(Timestamp::new(0L, -100000000))
  let t2 = unwrap_ts(Timestamp::new(0L, 200000000))
  let u = t1.until(t2)
  let s = t1.since(t2)
  debug_assert(u.secs == 0L && u.nanos == 300000000, "until 0.3s")
  debug_assert(s.secs == 0L && s.nanos == -300000000, "since -0.3s")
}

///|
test "timestamp_cmp" {
  let t1 = unwrap_ts(Timestamp::new(-1L, 900000000))
  let t2 = unwrap_ts(Timestamp::new(0L, 0))
  let t3 = unwrap_ts(Timestamp::new(0L, 1))
  debug_assert(t1.cmp(t2) < 0, "t1 < t2")
  debug_assert(t2.cmp(t3) < 0, "t2 < t3")
  debug_assert(t3.cmp(t1) > 0, "t3 > t1")
  debug_assert(t2.cmp(t2) == 0, "t2 == t2")
}

///|
test "fixed_datetime_with_offset" {
  let ts = unwrap_ts(Timestamp::from_second(1700000000L))
  let f1 = FixedDateTime::from_timestamp(ts, Offset::utc())
  let off_jst = unwrap_off(Offset::from_hours(9))
  match f1.with_offset(off_jst) {
    Ok(f2) => {
      debug_assert(f2.offset.eq(off_jst), "offset jst")
      debug_assert(unwrap_ts(f2.to_timestamp()).eq(ts), "same instant")
      debug_assert(f2.datetime.time.hour == (f1.datetime.time.hour + 9) % 24, "hour +9")
    }
    Err(_) => debug_assert(false, "with_offset failed")
  }
}

///|
test "signed_duration_new_normalization" {
  let d1 = unwrap_dur(SignedDuration::new(12L, 0))
  debug_assert(d1.secs == 12L && d1.nanos == 0, "12s")
  let d2 = unwrap_dur(SignedDuration::new(12L, -1))
  debug_assert(d2.secs == 11L && d2.nanos == 999999999, "12s -1ns")
  let d3 = unwrap_dur(SignedDuration::new(-12L, 1))
  debug_assert(d3.secs == -11L && d3.nanos == -999999999, "-12s +1ns")
  let d4 = unwrap_dur(SignedDuration::new(12L, 1000000000))
  debug_assert(d4.secs == 13L && d4.nanos == 0, "12s +1e9ns")
  let d5 = unwrap_dur(SignedDuration::new(-12L, -1500000000))
  debug_assert(d5.secs == -13L && d5.nanos == -500000000, "-12s -1.5e9ns")
  let d6 = unwrap_dur(SignedDuration::new(0L, -500000000))
  debug_assert(d6.secs == 0L && d6.nanos == -500000000, "-0.5s")
}

///|
test "signed_duration_from_units" {
  let d1 = SignedDuration::from_millis(12456L)
  debug_assert(d1.secs == 12L && d1.nanos == 456000000, "12456ms")
  let d2 = SignedDuration::from_millis(-12456L)
  debug_assert(d2.secs == -12L && d2.nanos == -456000000, "-12456ms")
  let d3 = SignedDuration::from_micros(-12000456L)
  debug_assert(d3.secs == -12L && d3.nanos == -456000, "-12000456us")
  let d4 = SignedDuration::from_nanos(-1500000000L)
  debug_assert(d4.secs == -1L && d4.nanos == -500000000, "-1.5e9ns")
  let d5 = unwrap_dur(SignedDuration::from_mins(2L))
  debug_assert(d5.secs == 120L && d5.nanos == 0, "2m")
  let d6 = unwrap_dur(SignedDuration::from_hours(-3L))
  debug_assert(d6.secs == -10800L && d6.nanos == 0, "-3h")
}

///|
test "signed_duration_from_mins_hours_overflow" {
  debug_assert(is_err_dur(SignedDuration::from_hours(9223372036854775807L)), "hours ovf")
  debug_assert(is_err_dur(SignedDuration::from_mins(9223372036854775807L)), "mins ovf")
}

///|
test "signed_duration_sign_predicates" {
  debug_assert(SignedDuration::zero().is_zero(), "zero")
  debug_assert(!SignedDuration::zero().is_positive(), "!pos")
  debug_assert(!SignedDuration::zero().is_negative(), "!neg")
  debug_assert(SignedDuration::from_nanos(1L).is_positive(), "+1ns pos")
  debug_assert(SignedDuration::from_nanos(-1L).is_negative(), "-1ns neg")
}

///|
test "signed_duration_abs_and_neg" {
  let d = SignedDuration::from_millis(-1500L)
  let a = unwrap_dur(d.abs())
  debug_assert(a.secs == 1L && a.nanos == 500000000, "abs")
  let n = unwrap_dur(a.checked_neg())
  debug_assert(n.eq(d), "neg")
  debug_assert(is_err_dur(SignedDuration::min().abs()), "min abs ovf")
  debug_assert(is_err_dur(SignedDuration::min().checked_neg()), "min neg ovf")
}

///|
test "signed_duration_checked_add" {
  let a = unwrap_dur(SignedDuration::new(1L, 600000000))
  let b = unwrap_dur(SignedDuration::new(2L, 700000000))
  let c = unwrap_dur(a.checked_add(b))
  debug_assert(c.secs == 4L && c.nanos == 300000000, "1.6 + 2.7 = 4.3")
  let d = unwrap_dur(a.checked_add(unwrap_dur(SignedDuration::new(-2L, -700000000))))
  debug_assert(d.secs == -1L && d.nanos == -100000000, "1.6 - 2.7 = -1.1")
}

///|
test "signed_duration_checked_add_overflow" {
  debug_assert(is_err_dur(SignedDuration::max().checked_add(SignedDuration::from_nanos(1L))), "max +1ns")
  debug_assert(is_err_dur(SignedDuration::min().checked_add(SignedDuration::from_nanos(-1L))), "min -1ns")
}

///|
test "signed_duration_checked_sub" {
  let a = SignedDuration::from_millis(500L)
  let b = SignedDuration::from_millis(800L)
  let c = unwrap_dur(a.checked_sub(b))
  debug_assert(c.secs == 0L && c.nanos == -300000000, "0.5 - 0.8 = -0.3")
  debug_assert(is_err_dur(SignedDuration::min().checked_sub(SignedDuration::from_nanos(1L))), "min -1ns")
}

///|
test "signed_duration_checked_mul" {
  let d = unwrap_dur(SignedDuration::new(1L, 500000000))
  let m1 = unwrap_dur(d.checked_mul(3))
  debug_assert(m1.secs == 4L && m1.nanos == 500000000, "1.5 * 3 = 4.5")
  let m2 = unwrap_dur(d.checked_mul(-2))
  debug_assert(m2.secs == -3L && m2.nanos == 0, "1.5 * -2 = -3")
  let m3 = unwrap_dur(d.checked_mul(0))
  debug_assert(m3.is_zero(), "* 0")
  debug_assert(is_err_dur(SignedDuration::max().checked_mul(2)), "max * 2 ovf")
}

///|
test "signed_duration_checked_div" {
  let d = unwrap_dur(SignedDuration::new(5L, 0))
  let q1 = unwrap_dur(d.checked_div(2))
  debug_assert(q1.secs == 2L && q1.nanos == 500000000, "5 / 2 = 2.5")
  let q2 = unwrap_dur(d.checked_div(-4))
  debug_assert(q2.secs == -1L && q2.nanos == -250000000, "5 / -4 = -1.25")
  let dn = unwrap_dur(SignedDuration::new(-1L, -500000000))
  let q3 = unwrap_dur(dn.checked_div(2))
  debug_assert(q3.secs == 0L && q3.nanos == -750000000, "-1.5 / 2 = -0.75")
  debug_assert(is_err_dur(d.checked_div(0)), "div 0")
  debug_assert(is_err_dur(SignedDuration::min().checked_div(-1)), "min / -1 ovf")
}

///|
test "signed_duration_trunc" {
  let d = unwrap_dur(SignedDuration::new(12L, 345678901))
  debug_assert(d.trunc_secs().eq(SignedDuration::from_secs(12L)), "trunc secs")
  debug_assert(d.trunc_millis().eq(unwrap_dur(SignedDuration::new(12L, 345000000))), "trunc ms")
  debug_assert(d.trunc_micros().eq(unwrap_dur(SignedDuration::new(12L, 345678000))), "trunc us")
  let dn = unwrap_dur(SignedDuration::new(-12L, -345678901))
  debug_assert(dn.trunc_secs().eq(SignedDuration::from_secs(-12L)), "neg trunc secs")
  debug_assert(dn.trunc_millis().eq(unwrap_dur(SignedDuration::new(-12L, -345000000))), "neg trunc ms")
}

///|
test "signed_duration_round" {
  let d1 = unwrap_dur(SignedDuration::new(1L, 499999999))
  debug_assert(unwrap_dur(d1.round_secs()).eq(SignedDuration::from_secs(1L)), "1.499 -> 1")
  let d2 = unwrap_dur(SignedDuration::new(1L, 500000000))
  debug_assert(unwrap_dur(d2.round_secs()).eq(SignedDuration::from_secs(2L)), "1.5 -> 2")
  let d3 = unwrap_dur(SignedDuration::new(-1L, -500000000))
  debug_assert(unwrap_dur(d3.round_secs()).eq(SignedDuration::from_secs(-2L)), "-1.5 -> -2")
  let d4 = unwrap_dur(SignedDuration::new(1L, 123500000))
  debug_assert(unwrap_dur(d4.round_millis()).eq(unwrap_dur(SignedDuration::new(1L, 124000000))), "1.1235 -> 1.124")
  debug_assert(is_err_dur(SignedDuration::max().round_secs()), "max round ovf")
}

///|
test "signed_duration_subsec_accessors_and_cmp" {
  let d = unwrap_dur(SignedDuration::new(-3L, -123456789))
  debug_assert(d.as_secs() == -3L, "secs")
  debug_assert(d.subsec_nanos() == -123456789, "ns")
  debug_assert(d.subsec_millis() == -123, "ms")
  debug_assert(d.subsec_micros() == -123456, "us")
  debug_assert(d.cmp(SignedDuration::zero()) < 0, "neg < 0")
  debug_assert(SignedDuration::zero().cmp(d) > 0, "0 > neg")
  debug_assert(d.cmp(d) == 0, "eq")
}

///|
test "timestamp_year_2038_and_far_future" {
  let ts = unwrap_ts(Timestamp::from_second(2147483648L))
  let dt = ts.to_utc_datetime()
  debug_assert(dt.date.year == 2038 && dt.date.month == 1 && dt.date.day == 19, "2038-01-19")
  debug_assert(dt.time.hour == 3 && dt.time.minute == 14 && dt.time.second == 8, "03:14:08")
  let ts2 = unwrap_ts(Offset::utc().to_timestamp(dt))
  debug_assert(ts2.eq(ts), "rt 2038")
}

///|
test "timestamp_year_1900_and_1969" {
  let dt = unwrap_dt(DateTime::new(1900, 1, 1, 0, 0, 0, 0))
  let ts = unwrap_ts(Offset::utc().to_timestamp(dt))
  debug_assert(ts.secs == -2208988800L && ts.nanos == 0, "1900-01-01")
  debug_assert(ts.to_utc_datetime().eq(dt), "rt 1900")
}

///|
test "timestamp_subsecond_offset_roundtrip_grid" {
  let offsets = [-93599, -43200, -19800, -18000, 0, 19800, 32400, 50400, 93599]
  let instants = [-377705023201L, -62167219200L, -1L, 0L, 1L, 1700000000L, 253402207200L]
  let mut i = 0
  while i < offsets.length() {
    let off = unwrap_off(Offset::from_seconds(offsets[i]))
    let mut j = 0
    while j < instants.length() {
      let nanos = if instants[j] == -377705023201L { 0 } else { 123456789 }
      let ts = unwrap_ts(Timestamp::new(instants[j], nanos))
      let dt = ts.to_datetime(off)
      let rt = unwrap_ts(off.to_timestamp(dt))
      debug_assert(rt.eq(ts), "grid roundtrip")
      j = j + 1
    }
    i = i + 1
  }
}

///|
test "signed_duration_add_cancel_to_zero" {
  let a = unwrap_dur(SignedDuration::new(5L, 123456789))
  let b = unwrap_dur(SignedDuration::new(-5L, -123456789))
  debug_assert(unwrap_dur(a.checked_add(b)).is_zero(), "cancel to zero")
}

///|
test "signed_duration_sub_across_zero" {
  let a = unwrap_dur(SignedDuration::new(0L, 100000000))
  let b = unwrap_dur(SignedDuration::new(0L, 300000000))
  let c = unwrap_dur(a.checked_sub(b))
  debug_assert(c.secs == 0L && c.nanos == -200000000, "0.1 - 0.3 = -0.2")
}

///|
test "signed_duration_mul_neg_by_neg" {
  let d = unwrap_dur(SignedDuration::new(-2L, -250000000))
  let m = unwrap_dur(d.checked_mul(-4))
  debug_assert(m.secs == 9L && m.nanos == 0, "-2.25 * -4 = 9")
}

///|
test "signed_duration_div_small_nanos" {
  let d = SignedDuration::from_nanos(10L)
  let q = unwrap_dur(d.checked_div(3))
  debug_assert(q.secs == 0L && q.nanos == 3, "10ns / 3 = 3ns")
}

///|
test "signed_duration_round_negative_half" {
  let d1 = unwrap_dur(SignedDuration::new(-1L, -499999999))
  debug_assert(unwrap_dur(d1.round_secs()).eq(SignedDuration::from_secs(-1L)), "-1.499 -> -1")
  let d2 = unwrap_dur(SignedDuration::new(-1L, -500000001))
  debug_assert(unwrap_dur(d2.round_secs()).eq(SignedDuration::from_secs(-2L)), "-1.500000001 -> -2")
}

///|
test "signed_duration_new_huge_nanos" {
  let d = unwrap_dur(SignedDuration::new(0L, 2000000000))
  debug_assert(d.secs == 2L && d.nanos == 0, "2e9ns")
  let dn = unwrap_dur(SignedDuration::new(0L, -2000000000))
  debug_assert(dn.secs == -2L && dn.nanos == 0, "-2e9ns")
}

///|
test "timestamp_from_second_bounds" {
  debug_assert(is_err_ts(Timestamp::from_second(-377705023202L)), "below min")
  debug_assert(is_err_ts(Timestamp::from_second(253402207201L)), "above max")
  debug_assert(unwrap_ts(Timestamp::from_second(0L)).eq(Timestamp::unix_epoch()), "0")
}

///|
test "timestamp_from_milli_micro_bounds" {
  debug_assert(is_err_ts(Timestamp::from_millisecond(-377705023202000L)), "ms below")
  debug_assert(is_err_ts(Timestamp::from_millisecond(253402207201000L)), "ms above")
  debug_assert(is_err_ts(Timestamp::from_microsecond(-377705023202000000L)), "us below")
  debug_assert(is_err_ts(Timestamp::from_microsecond(253402207201000000L)), "us above")
}

///|
test "offset_from_hms_mixed_signs_rejected" {
  debug_assert(is_err_off(Offset::from_hms(5, -30, 0)), "mixed +h -m")
  debug_assert(is_err_off(Offset::from_hms(-5, 30, 0)), "mixed -h +m")
  debug_assert(is_err_off(Offset::from_hms(0, 30, -1)), "mixed +m -s")
}

///|
test "timestamp_add_zero_duration" {
  let ts = unwrap_ts(Timestamp::new(42L, 123))
  debug_assert(unwrap_ts(ts.checked_add(SignedDuration::zero())).eq(ts), "+0")
  debug_assert(unwrap_ts(ts.checked_sub(SignedDuration::zero())).eq(ts), "-0")
}

///|
test "timestamp_until_same_is_zero" {
  let ts = unwrap_ts(Timestamp::new(-10L, 500000000))
  debug_assert(ts.until(ts).is_zero(), "until self == 0")
  debug_assert(ts.since(ts).is_zero(), "since self == 0")
}

///|
test "timestamp_until_negative_to_positive" {
  let t1 = unwrap_ts(Timestamp::new(-2L, 500000000))
  let t2 = unwrap_ts(Timestamp::new(1L, 250000000))
  // t1 is -1.5s, t2 is +1.25s => diff is +2.75s
  let u = t1.until(t2)
  debug_assert(u.secs == 2L && u.nanos == 750000000, "2.75s")
  let s = t1.since(t2)
  debug_assert(s.secs == -2L && s.nanos == -750000000, "-2.75s")
}

///|
test "timestamp_until_both_negative" {
  let t1 = unwrap_ts(Timestamp::new(-5L, 200000000))
  let t2 = unwrap_ts(Timestamp::new(-2L, 800000000))
  // -4.8s to -1.2s => +3.6s
  let u = t1.until(t2)
  debug_assert(u.secs == 3L && u.nanos == 600000000, "3.6s")
}

///|
test "fixed_datetime_new_and_eq" {
  let dt = unwrap_dt(DateTime::new(2024, 6, 15, 7, 0, 0, 0))
  let off = unwrap_off(Offset::from_hours(10))
  let f1 = FixedDateTime::new(dt, off)
  let f2 = FixedDateTime::new(dt, off)
  debug_assert(f1.eq(f2), "eq")
}

///|
test "signed_duration_from_secs_min_max" {
  let d = SignedDuration::from_secs(123456789L)
  debug_assert(d.secs == 123456789L && d.nanos == 0, "from_secs")
  let dmin = SignedDuration::min()
  let dmax = SignedDuration::max()
  debug_assert(dmin.nanos == -999999999 && dmax.nanos == 999999999, "min/max nanos")
}

///|
test "signed_duration_round_millis_negative" {
  let d1 = unwrap_dur(SignedDuration::new(-1L, -123499999))
  debug_assert(unwrap_dur(d1.round_millis()).eq(unwrap_dur(SignedDuration::new(-1L, -123000000))), "neg round down")
  let d2 = unwrap_dur(SignedDuration::new(-1L, -123500000))
  debug_assert(unwrap_dur(d2.round_millis()).eq(unwrap_dur(SignedDuration::new(-1L, -124000000))), "neg round half away")
}

///|
test "signed_duration_cmp_same_secs" {
  let a = unwrap_dur(SignedDuration::new(-1L, -100))
  let b = unwrap_dur(SignedDuration::new(-1L, -200))
  debug_assert(a.cmp(b) > 0, "-1.0000001 > -1.0000002")
  debug_assert(b.cmp(a) < 0, "-1.0000002 < -1.0000001")
}

///|
test "signed_duration_checked_mul_carry_nanos" {
  let d = SignedDuration::from_nanos(999999999L)
  let m = unwrap_dur(d.checked_mul(10))
  debug_assert(m.secs == 9L && m.nanos == 999999990, "0.999999999 * 10")
}

///|
test "signed_duration_checked_div_with_remainder_carry" {
  let d = unwrap_dur(SignedDuration::new(1L, 0))
  let q = unwrap_dur(d.checked_div(3))
  debug_assert(q.secs == 0L && q.nanos == 333333333, "1s / 3")
}

///|
test "signed_duration_checked_div_large_secs" {
  let d = unwrap_dur(SignedDuration::new(1000000000001L, 0))
  let q = unwrap_dur(d.checked_div(2))
  debug_assert(q.secs == 500000000000L && q.nanos == 500000000, "large / 2")
}

///|
test "signed_duration_checked_div_negative_large_secs" {
  let d = unwrap_dur(SignedDuration::new(-1000000000001L, 0))
  let q = unwrap_dur(d.checked_div(2))
  debug_assert(q.secs == -500000000000L && q.nanos == -500000000, "-large / 2")
}

///|
test "offset_from_hms_zero_hour_negative_min" {
  let o = unwrap_off(Offset::from_hms(0, -30, 0))
  debug_assert(o.seconds == -1800, "-00:30")
  let o2 = unwrap_off(Offset::from_hms(0, 0, -45))
  debug_assert(o2.seconds == -45, "-00:00:45")
}

///|
test "timestamp_sub_days_via_duration" {
  let ts = unwrap_ts(Timestamp::from_second(86400L))
  let ts0 = unwrap_ts(ts.checked_sub(SignedDuration::from_secs(86400L)))
  debug_assert(ts0.eq(Timestamp::unix_epoch()), "back to epoch")
}

///|
test "timestamp_pre_1970_minus_one_second" {
  let ts = unwrap_ts(Timestamp::from_second(-1L))
  let dt = ts.to_utc_datetime()
  debug_assert(dt.date.year == 1969 && dt.date.month == 12 && dt.date.day == 31, "1969-12-31")
  debug_assert(dt.time.hour == 23 && dt.time.minute == 59 && dt.time.second == 59 && dt.time.nanosecond == 0, "23:59:59")
}

///|
test "timestamp_pre_1970_1969_12_31_00_00_00" {
  let ts = unwrap_ts(Timestamp::from_second(-86400L))
  let dt = ts.to_utc_datetime()
  debug_assert(dt.date.year == 1969 && dt.date.month == 12 && dt.date.day == 31, "1969-12-31")
  debug_assert(dt.time.hour == 0 && dt.time.minute == 0 && dt.time.second == 0, "00:00:00")
}

///|
test "timestamp_year_0000_01_01" {
  let dt = unwrap_dt(DateTime::new(0, 1, 1, 0, 0, 0, 0))
  let ts = unwrap_ts(Offset::utc().to_timestamp(dt))
  debug_assert(ts.secs == -62167219200L && ts.nanos == 0, "0000-01-01")
  debug_assert(ts.to_utc_datetime().eq(dt), "rt 0000")
}

///|
test "timestamp_negative_year_roundtrip" {
  let dt = unwrap_dt(DateTime::new(-1234, 5, 6, 7, 8, 9, 100200300))
  let ts = unwrap_ts(Offset::utc().to_timestamp(dt))
  debug_assert(ts.to_utc_datetime().eq(dt), "rt -1234")
}

///|
test "timestamp_add_large_duration" {
  let ts = Timestamp::unix_epoch()
  let ts2 = unwrap_ts(ts.checked_add(SignedDuration::from_secs(31556952000L)))
  debug_assert(ts2.secs == 31556952000L, "+1000y")
}

///|
test "signed_duration_sub_neg_equals_add_pos" {
  let a = SignedDuration::from_millis(1234L)
  let b = SignedDuration::from_millis(-5678L)
  let r1 = unwrap_dur(a.checked_sub(b))
  let r2 = unwrap_dur(a.checked_add(unwrap_dur(b.abs())))
  debug_assert(r1.eq(r2), "sub neg == add pos")
}

///|
test "signed_duration_trunc_zero" {
  let z = SignedDuration::zero()
  debug_assert(z.trunc_secs().is_zero(), "z secs")
  debug_assert(z.trunc_millis().is_zero(), "z ms")
  debug_assert(z.trunc_micros().is_zero(), "z us")
}

///|
test "signed_duration_round_zero" {
  let z = SignedDuration::zero()
  debug_assert(unwrap_dur(z.round_secs()).is_zero(), "z round secs")
  debug_assert(unwrap_dur(z.round_millis()).is_zero(), "z round ms")
}

///|
test "signed_duration_trunc_subsecond_only" {
  let d = SignedDuration::from_millis(999L)
  debug_assert(d.trunc_secs().is_zero(), "0.999 -> 0")
  let dn = SignedDuration::from_millis(-999L)
  debug_assert(dn.trunc_secs().is_zero(), "-0.999 -> 0")
}

///|
test "signed_duration_round_subsecond_only" {
  let d = SignedDuration::from_millis(500L)
  debug_assert(unwrap_dur(d.round_secs()).eq(SignedDuration::from_secs(1L)), "0.5 -> 1")
  let dn = SignedDuration::from_millis(-500L)
  debug_assert(unwrap_dur(dn.round_secs()).eq(SignedDuration::from_secs(-1L)), "-0.5 -> -1")
}

///|
test "fixed_datetime_from_timestamp_negative_offset" {
  let ts = unwrap_ts(Timestamp::new(0L, 500000000))
  let off = unwrap_off(Offset::from_hours(-8))
  let fdt = FixedDateTime::from_timestamp(ts, off)
  debug_assert(fdt.datetime.date.year == 1969 && fdt.datetime.date.month == 12 && fdt.datetime.date.day == 31, "1969-12-31")
  debug_assert(fdt.datetime.time.hour == 16 && fdt.datetime.time.nanosecond == 500000000, "16:00:00.5")
}

///|
test "offset_from_seconds_zero_is_utc" {
  debug_assert(unwrap_off(Offset::from_seconds(0)).eq(Offset::utc()), "0 == utc")
}

///|
test "timestamp_from_nanosecond_positive_and_negative" {
  let t1 = unwrap_ts(Timestamp::from_nanosecond(1234567890L))
  debug_assert(t1.secs == 1L && t1.nanos == 234567890, "+1.23456789s")
  let t2 = unwrap_ts(Timestamp::from_nanosecond(-1234567890L))
  debug_assert(t2.secs == -2L && t2.nanos == 765432110, "-1.23456789s")
}

///|
test "timestamp_as_second_negative_floor_semantics" {
  // -0.1s has secs = -1, nanos = 900_000_000
  let ts = unwrap_ts(Timestamp::new(0L, -100000000))
  debug_assert(ts.as_second() == -1L, "secs == -1")
  debug_assert(ts.nanos == 900000000, "nanos == 900_000_000")
}

///|
test "signed_duration_checked_mul_i64_edge" {
  let d = SignedDuration::from_secs(1000000000L)
  let m = unwrap_dur(d.checked_mul(1000000))
  debug_assert(m.secs == 1000000000000000L && m.nanos == 0, "1e15s")
}
