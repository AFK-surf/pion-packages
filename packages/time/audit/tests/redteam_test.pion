///| Red-team assertion suite for `packages/time` @ b423882 (feat/opt-time).
///| Every assertion encodes the behaviour of the reference implementation (Rust `jiff` 0.2.46,
///| verified by `audit/rust/src/bin/probe.rs`), of Go's stdlib, or of the cited RFC text.
///| EVERY FAILING TEST IS A FINDING. Run: `pionc test --json -p time_redteam_audit packages/time/audit`.

import "time"

///|
fn ts_secs(s : String) -> Int64 {
  match time::Timestamp::parse_rfc3339(s) {
    Ok(t) => t.secs
    Err(e) => {
      debug_assert(false, "parse_rfc3339(\"" + s + "\") = Err(" + e.code + ": " + e.message + ")")
      0L
    }
  }
}

///|
fn ts(secs : Int64) -> time::Timestamp {
  match time::Timestamp::new(secs, 0) {
    Ok(t) => t
    Err(_) => {
      debug_assert(false, "bad fixture")
      time::Timestamp::unix_epoch()
    }
  }
}

///|
fn off(secs : Int) -> time::Offset {
  match time::Offset::from_seconds(secs) {
    Ok(o) => o
    Err(_) => {
      debug_assert(false, "Offset::from_seconds(" + secs.to_string() + ") rejected")
      time::Offset::utc()
    }
  }
}

///|
fn roundtrip(t : time::Timestamp, o : time::Offset) -> Unit {
  let s = t.to_rfc3339_with_offset(o)
  match time::Timestamp::parse_rfc3339(s) {
    Ok(back) =>
    debug_assert(back.eq(t), "round-trip changed value: " + s)
    Err(e) =>
    debug_assert(false, "own output rejected by own parser: to_rfc3339_with_offset -> \"" + s +
      "\" -> parse_rfc3339 = Err(" + e.code + ")")
  }
}

// ---------------------------------------------------------------------------------------------
// P0 — silent wrong values
// ---------------------------------------------------------------------------------------------

///| jiff: `"P4294967297D".parse::<Span>()` = Err (days > 7_304_484). Pion truncates Int64->Int: P1D.
test "p0_iso_duration_days_silently_truncated_mod_2_32" {
  match time::IsoDuration::parse("P4294967297D") {
    Ok(d) =>
    debug_assert(false, "P4294967297D accepted as " + d.to_string() + " (days=" + d.days.to_string() + ")")
    Err(_) => ()
  }
}

///| jiff: Err. Pion: PT4294967297H -> PT1H (attacker-controlled timeout becomes 1 hour).
test "p0_iso_duration_hours_silently_truncated_mod_2_32" {
  match time::IsoDuration::parse("PT4294967297H") {
    Ok(d) => debug_assert(false, "PT4294967297H accepted as " + d.to_string())
    Err(_) => ()
  }
}

///| jiff: Err. Pion: PT2147483648M -> PT-2147483648M (positive input, NEGATIVE result).
test "p0_iso_duration_minutes_sign_flip" {
  match time::IsoDuration::parse("PT2147483648M") {
    Ok(d) => debug_assert(false, "PT2147483648M accepted as " + d.to_string())
    Err(_) => ()
  }
}

///| jiff: Err (years > 19_998). Pion: P99999999999Y -> P1215752191Y.
test "p0_iso_duration_years_silently_truncated" {
  match time::IsoDuration::parse("P99999999999Y") {
    Ok(d) => debug_assert(false, "P99999999999Y accepted as " + d.to_string())
    Err(_) => ()
  }
}

///| jiff: `SignedDuration::MIN.to_string()` = "-PT2562047788015215H30M8.999999999S".
///| Pion negates i64::MIN (overflow) and prints "-PT-8.999999999S", which is not ISO 8601.
test "p0_signed_duration_min_to_iso_string_overflows" {
  let s = time::SignedDuration::min().to_iso_string()
  debug_assert(s == "-PT2562047788015215H30M8.999999999S", "SignedDuration::min().to_iso_string() = " + s)
}

///| jiff: (i64::MIN, 0) -> "-PT2562047788015215H30M8S". Pion: "-PT" (empty body).
test "p0_signed_duration_i64_min_secs_to_iso_string_empty" {
  let d = match time::SignedDuration::new(-9223372036854775807L - 1L, 0) {
    Ok(v) => v
    Err(_) => time::SignedDuration::zero()
  }
  let s = d.to_iso_string()
  debug_assert(s == "-PT2562047788015215H30M8S", "to_iso_string = " + s)
}

// ---------------------------------------------------------------------------------------------
// P1 — the package cannot parse what it prints (format -> parse round-trip broken)
// ---------------------------------------------------------------------------------------------

///| Timestamp::min() formats as "-009999-01-02T01:59:59Z"; parse_rfc3339 only knows 4-digit years.
test "p1_roundtrip_timestamp_min" {
  roundtrip(time::Timestamp::min(), time::Offset::utc())
}

///| Every timestamp before 0000-01-01 is unparseable after formatting (jiff: Ok).
test "p1_roundtrip_negative_year" {
  roundtrip(ts(-62198755200L), time::Offset::utc())
}

///| Offset with seconds: Pion emits "+00:00:01" (not RFC 3339 time-numoffset) and cannot read it back.
///| jiff prints "+00:00" (minute precision, RFC 3339 compliant).
test "p1_rfc3339_output_offset_with_seconds_is_not_rfc3339" {
  let s = ts(0L).to_rfc3339_with_offset(off(20715))
  debug_assert(s == "1970-01-01T05:45:15+05:45", "to_rfc3339_with_offset(+05:45:15) = " + s)
}

///| Offset::max() = +25:59:59 is accepted by Offset::from_seconds but its RFC 3339 output is rejected.
test "p1_roundtrip_offset_max" {
  roundtrip(ts(0L), time::Offset::max())
}

///| +24:00 is a valid Offset (from_hours(24) = Ok) but parse_rfc3339 rejects hour > 23. jiff: Ok.
test "p1_roundtrip_offset_24h" {
  let o = match time::Offset::from_hours(24) {
    Ok(v) => v
    Err(_) => time::Offset::utc()
  }
  roundtrip(ts(0L), o)
}

///| SignedDuration::min() -> to_iso_string -> parse_iso must round-trip (jiff: Ok).
test "p1_roundtrip_signed_duration_min" {
  let s = time::SignedDuration::min().to_iso_string()
  match time::SignedDuration::parse_iso(s) {
    Ok(d) => debug_assert(d.eq(time::SignedDuration::min()), "value changed")
    Err(e) => debug_assert(false, "own output \"" + s + "\" rejected: " + e.code)
  }
}

///| jiff accepts "-PT9223372036854775808S" (= SignedDuration::MIN secs). Pion overflows in parse_u64_at.
test "p1_parse_iso_signed_duration_min_secs" {
  match time::SignedDuration::parse_iso("-PT9223372036854775808S") {
    Ok(d) => debug_assert(d.secs == -9223372036854775807L - 1L, "wrong secs")
    Err(e) => debug_assert(false, "Err(" + e.code + ")")
  }
}

// ---------------------------------------------------------------------------------------------
// P1 — raw / packed APIs added by b423882 trust their inputs blindly
// ---------------------------------------------------------------------------------------------

///| epoch_days_to_packed_date returns -1 on error, and packed_date_add_days(-1, 0) happily
///| returns -1 again, whose fields decode as year -10001 / month 15 / day 31 — not an error signal.
test "p1_packed_error_sentinel_flows_through_as_date" {
  let p = time::epoch_days_to_packed_date(99999999)
  let y = time::packed_date_year(p)
  let m = time::packed_date_month(p)
  debug_assert(m >= 1 && m <= 12, "sentinel decodes as year " + y.to_string() + " month " + m.to_string())
}

///| packed_date_to_packed_iso_week(-1) fabricates "-10000-W13-6" instead of rejecting.
test "p1_packed_iso_week_of_sentinel" {
  let w = time::packed_date_to_packed_iso_week(-1)
  let wk = time::packed_iso_week_week(w)
  let y = time::packed_iso_week_year(w)
  debug_assert(y >= -9999, "iso week of error sentinel = " + y.to_string() + "-W" + wk.to_string())
}

///| format_rfc3339_raw_bytes writes non-digit garbage for out-of-domain input instead of failing.
test "p1_raw_formatter_emits_garbage_nanos_negative" {
  let buf = Bytes::new(64)
  let n = time::format_rfc3339_raw_bytes(0L, -1, 0, buf)
  let mut ok = true
  let mut i = 0
  while i < n {
    let c = buf[i].to_int()
    if !((c >= 48 && c <= 57) || c == 45 || c == 43 || c == 58 || c == 46 || c == 84) {
      ok = false
    }
    i = i + 1
  }
  debug_assert(ok, "format_rfc3339_raw_bytes(0, -1, 0) produced non-RFC-3339 bytes (e.g. '/')")
}

///| Year 10000 (one second past the valid range) prints as ":000-01-01T..." — no range check.
test "p1_raw_formatter_emits_garbage_year_10000" {
  let buf = Bytes::new(64)
  let _ = time::format_rfc3339_raw_bytes(253402300800L, 0, 0, buf)
  debug_assert(buf[0].to_int() != 58, "format_rfc3339_raw_bytes(253402300800,...) starts with ':'")
}

///| Offset of 100h prints "+:0:00".
test "p1_raw_formatter_emits_garbage_offset" {
  let buf = Bytes::new(64)
  let n = time::format_rfc3339_raw_bytes(0L, 0, 360000, buf)
  debug_assert(buf[n - 5].to_int() != 58, "offset 360000s formatted with ':' as an hour digit")
}

///| All value types are `pub val struct` with `pub` fields: invariants are bypassable by literal
///| construction (jiff keeps fields private). Timestamp{nanos:-5} formats as "...00./99999995Z".
test "p1_public_fields_bypass_invariants_timestamp" {
  let t = time::Timestamp::{ secs: 0L, nanos: -5 }
  let s = t.to_rfc3339()
  debug_assert(s.length() == 0 || s.code_unit_at(20) != 47, "Timestamp{0,-5}.to_rfc3339() = " + s)
}

///| Date{2025,2,31} is representable and prints as a real date.
test "p1_public_fields_bypass_invariants_date" {
  let d = time::Date::{ year: 2025, month: 2, day: 31 }
  debug_assert(d.to_string() != "2025-02-31", "invalid Date literal accepted and printed as 2025-02-31")
}

// ---------------------------------------------------------------------------------------------
// P2 — RFC 3339 / RFC 9557 / ISO 8601 inputs jiff accepts and Pion rejects
// ---------------------------------------------------------------------------------------------

///| RFC 9557 time-zone / calendar annotations — jiff Timestamp: Ok (annotation is ignored for Timestamp).
test "p2_rfc9557_annotation_rejected" {
  debug_assert(ts_secs("2025-01-01T00:00:00-05:00[America/New_York]") == 1735707600L, "wrong value")
  debug_assert(ts_secs("2025-01-01T00:00:00Z[UTC]") == 1735689600L, "wrong value")
  debug_assert(ts_secs("2025-01-01T00:00:00+00:00[!Etc/UTC]") == 1735689600L, "wrong value")
  debug_assert(ts_secs("2025-01-01T00:00:00Z[u-ca=iso8601]") == 1735689600L, "wrong value")
}

///| ISO 8601 extended (signed 6-digit) years — needed for Timestamp::MIN. jiff: Ok.
test "p2_extended_years_rejected" {
  debug_assert(ts_secs("-000001-01-01T00:00:00Z") == -62198755200L, "wrong value")
  debug_assert(ts_secs("+002025-01-01T00:00:00Z") == 1735689600L, "wrong value")
  debug_assert(ts_secs("-009999-01-02T01:59:59Z") == -377705023201L, "wrong value")
}

///| Offsets: jiff accepts hours up to 25, seconds, basic format and hour-only.
test "p2_offset_forms_rejected" {
  debug_assert(ts_secs("2025-01-01T00:00:00+24:00") == 1735603200L, "wrong value")
  debug_assert(ts_secs("2025-01-01T00:00:00+05:30:15") == 1735669785L, "wrong value")
  debug_assert(ts_secs("2025-01-01T00:00:00+0530") == 1735669800L, "wrong value")
  debug_assert(ts_secs("2025-01-01T00:00:00-05") == 1735707600L, "wrong value")
}

///| Leap second: jiff (and RFC 3339 §5.6 time-second = 00-60) accept :60 and clamp to :59.
test "p2_leap_second_rejected" {
  debug_assert(ts_secs("2016-12-31T23:59:60Z") == 1483228799L, "wrong value")
}

///| ISO 8601 comma decimal separator (jiff: Ok) and basic format / reduced precision (jiff: Ok).
test "p2_iso8601_forms_rejected" {
  debug_assert(ts_secs("2025-01-01T00:00:00,5Z") == 1735689600L, "wrong value")
  debug_assert(ts_secs("20250101T000000Z") == 1735689600L, "wrong value")
  debug_assert(ts_secs("2025-01-01T00:00Z") == 1735689600L, "wrong value")
}

///| RFC 9110 §5.6.7: "A recipient that parses a timestamp value in an HTTP field MUST accept all
///| three HTTP-date formats." Go's net/http.ParseTime does; Pion accepts IMF-fixdate only.
test "p2_http_date_obsolete_formats_rejected_rfc9110_must" {
  let rfc850 = time::Timestamp::parse_http_date("Sunday, 06-Nov-94 08:49:37 GMT")
  let asctime = time::Timestamp::parse_http_date("Sun Nov  6 08:49:37 1994")
  debug_assert(rfc850 is Ok(_), "RFC 850 date rejected")
  debug_assert(asctime is Ok(_), "asctime date rejected")
}

///| IsoDuration::to_string normalisation: jiff prints PT1.5H as "PT1H30M"; Pion prints "PT1H1800S".
test "p2_iso_duration_fractional_hour_format" {
  match time::IsoDuration::parse("PT1.5H") {
    Ok(d) => debug_assert(d.to_string() == "PT1H30M", "PT1.5H -> " + d.to_string())
    Err(e) => debug_assert(false, e.code)
  }
}

///| jiff `DateTime` parse accepts hour-only, :60 and an (ignored) offset; Pion rejects.
test "p2_civil_datetime_forms_rejected" {
  debug_assert(time::DateTime::parse("2025-01-01T12") is Ok(_), "2025-01-01T12 rejected")
  debug_assert(time::DateTime::parse("2025-01-01T12:34:56+01:00") is Ok(_), "offset suffix rejected")
  debug_assert(time::Date::parse("20250101") is Ok(_), "basic-format date rejected")
}
