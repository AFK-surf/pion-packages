///| W3: ISO 8601 SignedDuration parse (SignedDuration::parse_iso) + format (to_iso_string).
import "time"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let content = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(_) => return 1
  }
  let mut count : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut sum_secs : Int64 = 0L
  let mut sum_nanos : Int64 = 0L
  for line in content.split("\n") {
    if line.length() == 0 {
      continue
    }
    let d = match time::SignedDuration::parse_iso(line) {
      Ok(v) => v
      Err(_) => {
        io_println(world, "parse error: " + line)
        return 1
      }
    }
    let out = d.to_iso_string()
    let olen = out.length()
    let mut j = 0
    while j < olen {
      hash = (hash * 131L + out.code_unit_at(j).to_int64()) % 1000000007L
      j = j + 1
    }
    sum_secs = sum_secs + d.secs
    sum_nanos = sum_nanos + d.nanos.to_int64()
    count = count + 1L
  }
  io_println(world, "count=" + count.to_string())
  io_println(world, "hash=" + hash.to_string())
  io_println(world, "sum_secs=" + sum_secs.to_string())
  io_println(world, "sum_nanos=" + sum_nanos.to_string())
  0
}
