///| W4: RFC 9110 IMF-fixdate parse (Timestamp::parse_http_date) + format (to_http_date).
import "time"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let content = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(_) => return 1
  }
  let mut count : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut sum_secs : Int64 = 0L
  for line in content.split("\n") {
    if line.length() == 0 {
      continue
    }
    let t = match time::Timestamp::parse_http_date(line) {
      Ok(v) => v
      Err(_) => {
        io_println(world, "parse error: " + line)
        return 1
      }
    }
    let out = t.to_http_date()
    let olen = out.length()
    let mut j = 0
    while j < olen {
      hash = (hash * 131L + out.code_unit_at(j).to_int64()) % 1000000007L
      j = j + 1
    }
    sum_secs = sum_secs + t.secs
    count = count + 1L
  }
  io_println(world, "count=" + count.to_string())
  io_println(world, "hash=" + hash.to_string())
  io_println(world, "sum_secs=" + sum_secs.to_string())
  0
}
