///| W5: SignedDuration checked add/sub/mul/div + Timestamp::checked_add/since (5,000,000 iterations).
import "time"

///|
pub fn main(world : World) -> Int {
  let ops = 5000000
  let base = match time::Timestamp::new(1700000000L, 123456789) {
    Ok(t) => t
    Err(_) => return 1
  }
  let mut acc_s : Int64 = 0L
  let mut acc_n : Int64 = 0L
  let mut i = 0
  while i < ops {
    let a = match time::SignedDuration::new((i % 100000).to_int64() - 50000L, (i.to_int64() * 7919L % 1000000000L).to_int() - 500000000) {
      Ok(v) => v
      Err(_) => return 1
    }
    let b = time::SignedDuration::from_millis((i % 86400000).to_int64())
    let c = match a.checked_add(b) {
      Ok(v) => v
      Err(_) => return 1
    }
    let d = match c.checked_mul(3) {
      Ok(v) => v
      Err(_) => return 1
    }
    let e = match d.checked_div(7) {
      Ok(v) => v
      Err(_) => return 1
    }
    let f = match e.checked_sub(a) {
      Ok(v) => v
      Err(_) => return 1
    }
    let t = match base.checked_add(f) {
      Ok(v) => v
      Err(_) => return 1
    }
    let g = t.since(base)
    acc_s = acc_s + g.secs
    acc_n = acc_n + g.nanos.to_int64()
    i = i + 1
  }
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "acc_s=" + acc_s.to_string())
  io_println(world, "acc_n=" + acc_n.to_string())
  0
}
