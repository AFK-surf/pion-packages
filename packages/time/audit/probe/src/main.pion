///| Red-team differential probe for `packages/time` (mirror of audit/rust/src/bin/probe.rs).
///| Output: `kind\tinput\tRESULT` per case. `--civil-all` dumps every day of the supported range.

import "time"

///|
fn p64(s : String) -> Option[Int64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  if i >= n {
    return None
  }
  // Accumulate negatively so that Int64::MIN parses.
  let mut acc : Int64 = 0L
  while i < n {
    let c = s.code_unit_at(i) - 48
    if c < 0 || c > 9 {
      return None
    }
    if acc < (-9223372036854775807L - 1L + c.to_int64()) / 10L {
      return None
    }
    acc = acc * 10L - c.to_int64()
    i = i + 1
  }
  if neg {
    Some(acc)
  } else if acc == -9223372036854775807L - 1L {
    None
  } else {
    Some(-acc)
  }
}

///|
fn words(s : String) -> Array[String] {
  s.split(" ")
}

///|
fn ts_ok(t : time::Timestamp) -> String {
  "OK " + t.secs.to_string() + " " + t.nanos.to_string()
}

///|
fn raw_check(input : String, typed : Result[time::Timestamp, time::TimeError]) -> String {
  // Internal consistency: the zero-alloc raw parser must agree with the typed parser.
  let out : Array[Int64] = [0L, 0L]
  let ok = time::parse_rfc3339_slice_raw(input, 0, input.length(), out)
  match typed {
    Ok(t) =>
    if !ok || out[0] != t.secs || out[1] != t.nanos.to_int64() {
      " !!RAW_MISMATCH"
    } else {
      ""
    }
    Err(_) => if ok { " !!RAW_MISMATCH" } else { "" }
  }
}

///|
fn fmt_raw_check(t : time::Timestamp, off : time::Offset, typed : String) -> String {
  let buf = Bytes::new(64)
  let n = t.write_rfc3339_bytes(off, buf)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_byte(buf[i])
    i = i + 1
  }
  if sb.to_string() != typed {
    " !!RAW_FMT_MISMATCH(" + sb.to_string() + ")"
  } else {
    ""
  }
}

///|
fn run(kind : String, input : String) -> String {
  let w = words(input)
  if kind == "ts" {
    let r = time::Timestamp::parse_rfc3339(input)
    let base = match r {
      Ok(t) => ts_ok(t)
      Err(_) => "ERR"
    }
    return base + raw_check(input, r)
  }
  if kind == "tsfmt" {
    let (s, n, o) = match (p64(w[0]), p64(w[1]), p64(w[2])) {
      (Some(a), Some(b), Some(c)) => (a, b.to_int(), c.to_int())
      _ => return "BADCASE"
    }
    let t = match time::Timestamp::new(s, n) {
      Ok(v) => v
      Err(_) => return "ERR"
    }
    let off = match time::Offset::from_seconds(o) {
      Ok(v) => v
      Err(_) => return "ERR"
    }
    let typed = t.to_rfc3339_with_offset(off)
    return "OK " + typed + fmt_raw_check(t, off, typed)
  }
  if kind == "tsadd" {
    let (s, n, ds, dn) = match (p64(w[0]), p64(w[1]), p64(w[2]), p64(w[3])) {
      (Some(a), Some(b), Some(c), Some(d)) => (a, b.to_int(), c, d.to_int())
      _ => return "BADCASE"
    }
    let t = match time::Timestamp::new(s, n) {
      Ok(v) => v
      Err(_) => return "ERR"
    }
    let d = match time::SignedDuration::new(ds, dn) {
      Ok(v) => v
      Err(_) => return "ERR(SignedDuration::new)"
    }
    return match t.checked_add(d) {
      Ok(r) => ts_ok(r)
      Err(_) => "ERR"
    }
  }
  if kind == "sdur" {
    return match time::SignedDuration::parse_iso(input) {
      Ok(d) =>
      "OK " + d.secs.to_string() + " " + d.nanos.to_string() + " || " + d.to_iso_string()
      Err(_) => "ERR"
    }
  }
  if kind == "sdfmt" {
    let (s, n) = match (p64(w[0]), p64(w[1])) {
      (Some(a), Some(b)) => (a, b.to_int())
      _ => return "BADCASE"
    }
    return match time::SignedDuration::new(s, n) {
      Ok(d) => "OK " + d.to_iso_string()
      Err(_) => "ERR"
    }
  }
  if kind == "span" {
    return match time::IsoDuration::parse(input) {
      Ok(d) => {
        let t = d.hours.to_int64() * 3600000000000L +
        d.minutes.to_int64() * 60000000000L +
        d.seconds * 1000000000L +
        d.nanoseconds.to_int64()
        let any = d.years != 0 || d.months != 0 || d.weeks != 0 || d.days != 0 || t != 0L
        let sign = if d.negative && any { "-" } else { "+" }
        "OK " + sign + " " + d.years.to_string() + " " + d.months.to_string() + " " +
        d.weeks.to_string() + " " + d.days.to_string() + " " + t.to_string() + " || " +
        d.to_string()
      }
      Err(_) => "ERR"
    }
  }
  if kind == "http" {
    return match time::Timestamp::parse_http_date(input) {
      Ok(t) => "OK " + t.secs.to_string()
      Err(_) => "ERR"
    }
  }
  if kind == "r2822" {
    return match time::FixedDateTime::parse_rfc2822(input) {
      Ok(f) =>
      match f.to_timestamp() {
        Ok(t) => "OK " + t.secs.to_string() + " " + f.offset.seconds.to_string()
        Err(_) => "ERR(to_timestamp)"
      }
      Err(_) => "ERR"
    }
  }
  if kind == "date" {
    return match time::Date::parse(input) {
      Ok(d) => "OK " + d.to_string()
      Err(_) => "ERR"
    }
  }
  if kind == "dt" {
    return match time::DateTime::parse(input) {
      Ok(d) => "OK " + d.to_string()
      Err(_) => "ERR"
    }
  }
  if kind == "addm" || kind == "addy" || kind == "addd" {
    let d = match time::Date::parse(w[0]) {
      Ok(v) => v
      Err(_) => return "BADCASE"
    }
    let n = match p64(w[1]) {
      Some(v) => v
      None => return "BADCASE"
    }
    if n > 2147483647L || n < -2147483648L {
      return "ERR"
    }
    let r = if kind == "addm" {
      d.add_months(n.to_int())
    } else if kind == "addy" {
      d.add_years(n.to_int())
    } else {
      d.add_days(n.to_int())
    }
    return match r {
      Ok(v) => "OK " + v.to_string()
      Err(_) => "ERR"
    }
  }
  if kind == "until" {
    return match (time::Date::parse(w[0]), time::Date::parse(w[1])) {
      (Ok(a), Ok(b)) => "OK " + a.until(b).to_string()
      _ => "BADCASE"
    }
  }
  if kind == "dtadd" {
    let d = match time::DateTime::parse(w[0]) {
      Ok(v) => v
      Err(_) => return "BADCASE"
    }
    let (ds, dn) = match (p64(w[1]), p64(w[2])) {
      (Some(a), Some(b)) => (a, b.to_int())
      _ => return "BADCASE"
    }
    let dur = match time::SignedDuration::new(ds, dn) {
      Ok(v) => v
      Err(_) => return "ERR(SignedDuration::new)"
    }
    return match d.add_duration(dur) {
      Ok(v) => "OK " + v.to_string()
      Err(_) => "ERR"
    }
  }
  "BADCASE"
}

///|
fn pad(sb : StringBuilder, v : Int, width : Int) -> Unit {
  let s = v.to_string()
  let mut k = s.length()
  while k < width {
    sb.write_byte((48).to_byte())
    k = k + 1
  }
  sb.write_string(s)
}

///|
fn civil_all(world : World) -> Unit {
  // Typed API and the packed API (b423882) are both dumped; packed mismatches are flagged inline.
  let mut ed = -4371587
  let sb = StringBuilder::new()
  let mut lines = 0
  while ed <= 2932896 {
    let d = match time::Date::from_epoch_days(ed) {
      Ok(v) => v
      Err(_) => {
        io_println(world, "from_epoch_days failed at " + ed.to_string())
        return
      }
    }
    let w = d.iso_week_date()
    sb.write_string(ed.to_string())
    sb.write_byte((32).to_byte())
    sb.write_string(d.to_string())
    sb.write_byte((32).to_byte())
    if w.year < 0 {
      sb.write_byte((45).to_byte())
      pad(sb, -w.year, 4)
    } else {
      pad(sb, w.year, 4)
    }
    sb.write_string("-W")
    pad(sb, w.week, 2)
    sb.write_byte((45).to_byte())
    sb.write_string(time::weekday_to_monday_one_offset(w.weekday).to_string())
    sb.write_byte((32).to_byte())
    sb.write_string(d.day_of_year().to_string())
    // Cross-check the bit-packed API against the typed API.
    let p = time::epoch_days_to_packed_date(ed)
    let pw = time::packed_date_to_packed_iso_week(p)
    if time::packed_date_year(p) != d.year ||
    time::packed_date_month(p) != d.month ||
    time::packed_date_day(p) != d.day ||
    time::packed_date_to_epoch_days(p) != ed ||
    d.to_epoch_days() != ed ||
    time::packed_iso_week_year(pw) != w.year ||
    time::packed_iso_week_week(pw) != w.week ||
    time::packed_iso_week_weekday(pw) !=
    time::weekday_to_monday_one_offset(w.weekday) {
      sb.write_string(" !!PACKED_MISMATCH")
    }
    sb.write_byte((10).to_byte())
    lines = lines + 1
    if lines == 4096 {
      io_print(world, sb.to_string())
      sb.reset()
      lines = 0
    }
    ed = ed + 1
  }
  io_print(world, sb.to_string())
}

///|
fn bytes_str(buf : Bytes, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_byte(buf[i])
    i = i + 1
  }
  sb.to_string()
}

///|
fn robust(world : World) -> Unit {
  // Raw / packed APIs fed values outside their documented domain (incl. their own -1 error sentinel).
  let pa = time::packed_date_add_days(-1, 0)
  io_println(world, "packed_date_add_days(-1 /*error sentinel*/, 0) = " + pa.to_string() +
    " -> y/m/d " + time::packed_date_year(pa).to_string() + "/" +
    time::packed_date_month(pa).to_string() + "/" + time::packed_date_day(pa).to_string())
  io_println(world, "packed_date_to_epoch_days(-1) = " + time::packed_date_to_epoch_days(-1).to_string())
  let pw = time::packed_date_to_packed_iso_week(-1)
  io_println(world, "packed_date_to_packed_iso_week(-1) = " + pw.to_string() + " -> " +
    time::packed_iso_week_year(pw).to_string() + "-W" + time::packed_iso_week_week(pw).to_string() +
    "-" + time::packed_iso_week_weekday(pw).to_string())
  let feb31 = (2025 + 10000) * 512 + 2 * 32 + 31
  io_println(world, "packed 2025-02-31 (never validated) -> epoch_days " +
    time::packed_date_to_epoch_days(feb31).to_string() + " (= 2025-03-03)")
  let buf = Bytes::new(64)
  let cases : Array[(Int64, Int, Int)] = [
    (0L, -1, 0),
    (0L, 1000000000, 0),
    (0L, 0, 360000),
    (0L, 0, -360000),
    (253402300800L, 0, 0),
    (9223372036854775807L, 0, 0),
    (-9223372036854775807L - 1L, 0, 0),
  ]
  for c in cases {
    let n = time::format_rfc3339_raw_bytes(c.0, c.1, c.2, buf)
    io_println(world, "format_rfc3339_raw_bytes(" + c.0.to_string() + ", " + c.1.to_string() + ", " +
      c.2.to_string() + ") = " + bytes_str(buf, n))
  }
  // Invariants are not enforced: every value type exposes `pub` fields.
  let bad_ts = time::Timestamp::{ secs: 0L, nanos: -5 }
  io_println(world, "Timestamp::{secs:0, nanos:-5}.to_rfc3339() = " + bad_ts.to_rfc3339())
  let bad_d = time::Date::{ year: 2025, month: 2, day: 31 }
  io_println(world, "Date::{2025,2,31}.to_string() = " + bad_d.to_string() + ", weekday-ok? to_epoch_days=" +
    bad_d.to_epoch_days().to_string())
  let bad_sd = time::SignedDuration::{ secs: 5L, nanos: -999999999 }
  io_println(world, "SignedDuration::{5, -999999999}.to_iso_string() = " + bad_sd.to_iso_string())
  // Self round-trip: format -> parse with the package's own functions.
  let rt : Array[(Int64, Int)] = [(-377705023201L, 0), (-62198755200L, 0), (0L, 1), (0L, 93599), (0L, -93599), (0L, 86400)]
  for c in rt {
    let t = match time::Timestamp::new(c.0, 0) {
      Ok(v) => v
      Err(_) => continue
    }
    let off = match time::Offset::from_seconds(c.1) {
      Ok(v) => v
      Err(_) => {
        io_println(world, "Offset::from_seconds(" + c.1.to_string() + ") rejected")
        continue
      }
    }
    let s = t.to_rfc3339_with_offset(off)
    let back = match time::Timestamp::parse_rfc3339(s) {
      Ok(v) => if v.eq(t) { "OK" } else { "WRONG VALUE" }
      Err(e) => "ERR " + e.code
    }
    io_println(world, "roundtrip " + s + " -> parse_rfc3339 -> " + back)
  }
  let neg = time::SignedDuration::min().to_iso_string()
  io_println(world, "SignedDuration::min().to_iso_string() = " + neg + " -> parse_iso -> " +
    (match time::SignedDuration::parse_iso(neg) {
      Ok(_) => "OK"
      Err(e) => "ERR " + e.code
  }))
  let huge : Array[String] = ["P4294967297D", "PT4294967297H", "P99999999999Y", "PT2147483648M", "P2147483648W"]
  for h in huge {
    let r = match time::IsoDuration::parse(h) {
      Ok(d) => "Ok(" + d.to_string() + ")"
      Err(e) => "Err(" + e.code + ")"
    }
    io_println(world, "IsoDuration::parse(\"" + h + "\") = " + r)
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: probe <cases.tsv> | --civil-all")
    return 2
  }
  if args[1] == "--robust" {
    robust(world)
    return 0
  }
  if args[1] == "--civil-all" {
    civil_all(world)
    return 0
  }
  let content = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: cannot read cases")
      return 1
    }
  }
  let sb = StringBuilder::new()
  for line in content.split("\n") {
    let parts = line.split("\t")
    if parts.length() < 2 {
      continue
    }
    sb.write_string(parts[0])
    sb.write_byte((9).to_byte())
    sb.write_string(parts[1])
    sb.write_byte((9).to_byte())
    sb.write_string(run(parts[0], parts[1]))
    sb.write_byte((10).to_byte())
  }
  io_print(world, sb.to_string())
  0
}
