}

///|
test "rfc2822_parse_cst_cdt_mst_mdt" {
  let t_cst = unwrap_ts(Timestamp::parse_rfc2822("Wed, 31 Dec 1969 18:00:00 CST"))
  debug_assert(t_cst.eq(Timestamp::unix_epoch()), "CST")
  let t_cdt = unwrap_ts(Timestamp::parse_rfc2822("Wed, 31 Dec 1969 19:00:00 CDT"))
  debug_assert(t_cdt.eq(Timestamp::unix_epoch()), "CDT")
  let t_mst = unwrap_ts(Timestamp::parse_rfc2822("Wed, 31 Dec 1969 17:00:00 MST"))
  debug_assert(t_mst.eq(Timestamp::unix_epoch()), "MST")
  let t_mdt = unwrap_ts(Timestamp::parse_rfc2822("Wed, 31 Dec 1969 18:00:00 MDT"))
  debug_assert(t_mdt.eq(Timestamp::unix_epoch()), "MDT")
}

///|
test "rfc2822_format_positive_offset" {
  let dt = unwrap_dt(DateTime::new(2024, 6, 15, 7, 0, 0, 0))
  let off = unwrap_off(Offset::from_hms(5, 30, 0))
  let fdt = FixedDateTime::new(dt, off)
  debug_assert(fdt.to_rfc2822() == "Sat, 15 Jun 2024 07:00:00 +0530", "+0530")
}

///|
test "rfc2822_format_utc_offset" {
  let dt = unwrap_dt(DateTime::new(2024, 6, 15, 7, 0, 0, 0))
  let fdt = FixedDateTime::new(dt, Offset::utc())
  debug_assert(fdt.to_rfc2822() == "Sat, 15 Jun 2024 07:00:00 +0000", "+0000")
}

///|
test "http_date_roundtrip_multiple" {
  let dates = [
    "Thu, 01 Jan 1970 00:00:00 GMT",
    "Sun, 06 Nov 1994 08:49:37 GMT",
    "Thu, 29 Feb 2024 23:59:59 GMT",
    "Thu, 30 Dec 9999 22:00:00 GMT",
  ]
  let mut i = 0
  while i < dates.length() {
    let ts = unwrap_ts(Timestamp::parse_http_date(dates[i]))
    debug_assert(ts.to_http_date() == dates[i], "http date rt")
    i = i + 1
  }
}

