}

///|
test "rfc2822_parse_case_insensitive" {
  let fdt = unwrap_fdt(FixedDateTime::parse_rfc2822("sat, 13 jul 2024 15:09:59 -0400"))
  debug_assert(fdt.to_rfc3339() == "2024-07-13T15:09:59-04:00", "lower")
  let fdt2 = unwrap_fdt(FixedDateTime::parse_rfc2822("SAT, 13 JUL 2024 15:09:59 -0400"))
  debug_assert(fdt2.to_rfc3339() == "2024-07-13T15:09:59-04:00", "upper")
}

