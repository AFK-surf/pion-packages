///| RFC 3339, ISO 8601, RFC 2822, RFC 9110 HTTP-date, and ISO 8601 Duration tests ported from BurntSushi/jiff (80 tests).

///|
fn unwrap_fdt(r : Result[FixedDateTime, TimeError]) -> FixedDateTime {
  match r {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "expected Ok(FixedDateTime), got Err: " + e.message)
      FixedDateTime::new(DateTime::min(), Offset::utc())
    }
  }
}

///|
fn unwrap_isodur(r : Result[IsoDuration, TimeError]) -> IsoDuration {
  match r {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "expected Ok(IsoDuration), got Err: " + e.message)
      IsoDuration::{
        negative: false,
        years: 0,
        months: 0,
        weeks: 0,
        days: 0,
        hours: 0,
        minutes: 0,
        seconds: 0L,
        nanoseconds: 0,
      }
    }
  }
}

///|
fn is_err_fdt(r : Result[FixedDateTime, TimeError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_dt(r : Result[DateTime, TimeError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_isodur(r : Result[IsoDuration, TimeError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
test "rfc3339_parse_basic_utc_z" {
  let ts = unwrap_ts(Timestamp::parse_rfc3339("1970-01-01T00:00:00Z"))
  debug_assert(ts.eq(Timestamp::unix_epoch()), "epoch Z")
}

///|
test "rfc3339_parse_lowercase_z_and_t" {
  let ts = unwrap_ts(Timestamp::parse_rfc3339("2024-06-15t12:34:56z"))
  debug_assert(ts.to_rfc3339() == "2024-06-15T12:34:56Z", "lowercase t/z")
}

///|
test "rfc3339_parse_space_separator" {
  let ts = unwrap_ts(Timestamp::parse_rfc3339("2024-06-15 12:34:56Z"))
  debug_assert(ts.to_rfc3339() == "2024-06-15T12:34:56Z", "space sep")
}

///|
test "rfc3339_parse_plus_zero_and_minus_zero" {
  let ts1 = unwrap_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56+00:00"))
  let ts2 = unwrap_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56-00:00"))
  let ts3 = unwrap_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56Z"))
  debug_assert(ts1.eq(ts3), "+00:00 == Z")
  debug_assert(ts2.eq(ts3), "-00:00 == Z")
}

///|
test "rfc3339_parse_positive_offset_09_00" {
  let fdt = unwrap_fdt(FixedDateTime::parse_rfc3339("2024-06-15T21:34:56+09:00"))
  debug_assert(fdt.offset.seconds == 32400, "+09:00")
  debug_assert(fdt.datetime.time.hour == 21, "hour 21")
  let ts = unwrap_ts(fdt.to_timestamp())
  debug_assert(ts.to_rfc3339() == "2024-06-15T12:34:56Z", "utc 12:34:56")
}

///|
test "rfc3339_parse_negative_offset_05_30" {
  let fdt = unwrap_fdt(FixedDateTime::parse_rfc3339("2024-06-15T07:04:56-05:30"))
  debug_assert(fdt.offset.seconds == -19800, "-05:30")
  let ts = unwrap_ts(fdt.to_timestamp())
  debug_assert(ts.to_rfc3339() == "2024-06-15T12:34:56Z", "utc 12:34:56")
}

///|
test "rfc3339_parse_fractional_1_to_9_digits" {
  let t1 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.1Z"))
  debug_assert(t1.nanos == 100000000, "1 digit")
  let t2 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.12Z"))
  debug_assert(t2.nanos == 120000000, "2 digits")
  let t3 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.123Z"))
  debug_assert(t3.nanos == 123000000, "3 digits")
  let t4 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.1234Z"))
  debug_assert(t4.nanos == 123400000, "4 digits")
  let t5 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.12345Z"))
  debug_assert(t5.nanos == 123450000, "5 digits")
  let t6 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.123456Z"))
  debug_assert(t6.nanos == 123456000, "6 digits")
  let t7 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.1234567Z"))
  debug_assert(t7.nanos == 123456700, "7 digits")
  let t8 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.12345678Z"))
  debug_assert(t8.nanos == 123456780, "8 digits")
  let t9 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.123456789Z"))
  debug_assert(t9.nanos == 123456789, "9 digits")
}

///|
test "rfc3339_parse_fractional_leading_zeros" {
  let t = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.000000001Z"))
  debug_assert(t.nanos == 1, "1ns")
  debug_assert(t.to_rfc3339() == "2024-01-01T00:00:00.000000001Z", "fmt 1ns")
}

///|
test "rfc3339_format_trims_trailing_zeros" {
  let t1 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.500000000Z"))
  debug_assert(t1.to_rfc3339() == "2024-01-01T00:00:00.5Z", "trim .5")
  let t2 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.000Z"))
  debug_assert(t2.to_rfc3339() == "2024-01-01T00:00:00Z", "trim .000")
  let t3 = unwrap_ts(Timestamp::parse_rfc3339("2024-01-01T00:00:00.123456000Z"))
  debug_assert(t3.to_rfc3339() == "2024-01-01T00:00:00.123456Z", "trim us")
}

///|
test "rfc3339_format_with_offset" {
  let ts = unwrap_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56.789Z"))
  let s1 = ts.to_rfc3339_with_offset(unwrap_off(Offset::from_hours(9)))
  debug_assert(s1 == "2024-06-15T21:34:56.789+09:00", "+09:00")
  let s2 = ts.to_rfc3339_with_offset(unwrap_off(Offset::from_hms(-5, -30, 0)))
  debug_assert(s2 == "2024-06-15T07:04:56.789-05:30", "-05:30")
  let s3 = ts.to_rfc3339_with_offset(Offset::utc())
  debug_assert(s3 == "2024-06-15T12:34:56.789+00:00", "+00:00")
}

///|
test "rfc3339_parse_pre_1970_negative_subsec" {
  let ts = unwrap_ts(Timestamp::parse_rfc3339("1969-12-31T23:59:59.9Z"))
  debug_assert(ts.secs == -1L && ts.nanos == 900000000, "-0.1s")
  debug_assert(ts.to_rfc3339() == "1969-12-31T23:59:59.9Z", "fmt -0.1s")
}

///|
test "rfc3339_reject_invalid_feb_29_2023" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2023-02-29T00:00:00Z")), "2023-02-29")
}

///|
test "rfc3339_reject_invalid_leap_second_60" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2016-12-31T23:59:60Z")), "sec 60")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:61Z")), "sec 61")
}

///|
test "rfc3339_reject_out_of_bounds_offset" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56+24:00")), "+24:00")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56-24:00")), "-24:00")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56+00:60")), "+00:60")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56+99:99")), "+99:99")
}

///|
test "rfc3339_reject_trailing_garbage" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56Zfoo")), "Zfoo")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56Z ")), "Z space")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339(" 2024-06-15T12:34:56Z")), "leading space")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56+09:00x")), "offset x")
}

///|
test "rfc3339_reject_missing_offset" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56")), "no offset")
}

///|
test "rfc3339_reject_missing_time" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15")), "date only")
}

///|
test "rfc3339_reject_empty_fraction" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56.Z")), "dot no digits")
}

///|
test "rfc3339_reject_over_9_fraction_digits" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56.1234567890Z")), "10 digits")
}

///|
test "rfc3339_reject_bad_separators" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024/06/15T12:34:56Z")), "slash")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15X12:34:56Z")), "X sep")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12-34-56Z")), "dash time")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:34:56+0900")), "offset no colon")
}

///|
test "rfc3339_reject_bad_hour_min" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T24:00:00Z")), "24:00")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:60:00Z")), "min 60")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-13-01T00:00:00Z")), "month 13")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-00-01T00:00:00Z")), "month 00")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-01-00T00:00:00Z")), "day 00")
}

///|
test "rfc3339_reject_empty_and_short" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("")), "empty")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024")), "short")
  debug_assert(is_err_fdt(FixedDateTime::parse_rfc3339("not-a-date")), "garbage")
}

///|
test "rfc3339_fixed_datetime_roundtrip" {
  let s = "2024-02-29T23:59:59.987654321-04:00"
  let fdt = unwrap_fdt(FixedDateTime::parse_rfc3339(s))
  debug_assert(fdt.to_rfc3339() == s, "rt")
}

///|
test "rfc3339_year_0000_and_9999" {
  let t1 = unwrap_ts(Timestamp::parse_rfc3339("0000-01-01T00:00:00Z"))
  debug_assert(t1.to_rfc3339() == "0000-01-01T00:00:00Z", "0000")
  let t2 = unwrap_ts(Timestamp::parse_rfc3339("9999-12-30T22:00:00Z"))
  debug_assert(t2.to_rfc3339() == "9999-12-30T22:00:00Z", "9999")
}

///|
test "date_parse_and_to_string" {
  let d = unwrap_date(Date::parse("2024-02-29"))
  debug_assert(d.year == 2024 && d.month == 2 && d.day == 29, "2024-02-29")
  debug_assert(d.to_string() == "2024-02-29", "fmt")
  let dneg = unwrap_date(Date::parse("-009999-01-01"))
  debug_assert(dneg.eq(Date::min()), "neg min")
  debug_assert(dneg.to_string() == "-009999-01-01", "fmt neg min")
  let d0 = unwrap_date(Date::parse("0000-01-01"))
  debug_assert(d0.to_string() == "0000-01-01", "fmt 0")
  debug_assert(is_err_date(Date::parse("-000000-01-01")), "-000000 rejected")
  debug_assert(is_err_date(Date::parse("2023-02-29")), "2023-02-29 rejected")
  debug_assert(is_err_date(Date::parse("2024-02-29x")), "trailing rejected")
}

///|
test "time_parse_and_to_string" {
  let t1 = unwrap_time(Time::parse("12:34:56.789"))
  debug_assert(t1.to_string() == "12:34:56.789", "t1")
  let t2 = unwrap_time(Time::parse("00:00:00"))
  debug_assert(t2.to_string() == "00:00:00", "t2")
  let t3 = unwrap_time(Time::parse("23:59"))
  debug_assert(t3.hour == 23 && t3.minute == 59 && t3.second == 0, "hh:mm")
  debug_assert(is_err_time(Time::parse("24:00:00")), "24:00")
  debug_assert(is_err_time(Time::parse("12:34:60")), "sec 60")
  debug_assert(is_err_time(Time::parse("12:34:56Z")), "trailing Z")
}

///|
test "datetime_parse_and_to_string" {
  let dt = unwrap_dt(DateTime::parse("2024-06-15T07:00:00.123"))
  debug_assert(dt.to_string() == "2024-06-15T07:00:00.123", "dt")
  let dt2 = unwrap_dt(DateTime::parse("2024-06-15 07:00:00"))
  debug_assert(dt2.to_string() == "2024-06-15T07:00:00", "dt space")
  debug_assert(is_err_dt(DateTime::parse("2024-06-15T07:00:00Z")), "Z rejected for civil")
}

///|
test "iso_week_date_parse_and_to_string" {
  let w1 = unwrap_iwd(IsoWeekDate::parse("2024-W24-7"))
  debug_assert(w1.to_string() == "2024-W24-7", "w1")
  debug_assert(w1.to_date().to_string() == "2024-06-16", "w1 date")
  let w2 = unwrap_iwd(IsoWeekDate::parse("2024W241"))
  debug_assert(w2.to_string() == "2024-W24-1", "compact")
  let w3 = unwrap_iwd(IsoWeekDate::parse("2024-w24-2"))
  debug_assert(w3.to_string() == "2024-W24-2", "lower w")
  debug_assert(is_err_iwd(IsoWeekDate::parse("2024W24-1")), "mixed sep 1")
  debug_assert(is_err_iwd(IsoWeekDate::parse("2024-W241")), "mixed sep 2")
  debug_assert(is_err_iwd(IsoWeekDate::parse("2024-W53-1")), "invalid W53")
}

///|
test "offset_to_string" {
  debug_assert(Offset::utc().to_string() == "+00:00", "+00:00")
  debug_assert(unwrap_off(Offset::from_hours(9)).to_string() == "+09:00", "+09:00")
  debug_assert(unwrap_off(Offset::from_hms(-5, -30, 0)).to_string() == "-05:30", "-05:30")
  debug_assert(unwrap_off(Offset::from_hms(1, 2, 3)).to_string() == "+01:02:03", "+01:02:03")
  debug_assert(unwrap_off(Offset::from_hms(0, 0, -45)).to_string() == "-00:00:45", "-00:00:45")
}

///|
test "rfc2822_parse_standard" {
  let fdt = unwrap_fdt(FixedDateTime::parse_rfc2822("Sat, 13 Jul 2024 15:09:59 -0400"))
  debug_assert(fdt.to_rfc3339() == "2024-07-13T15:09:59-04:00", "rfc2822")
  debug_assert(fdt.to_rfc2822() == "Sat, 13 Jul 2024 15:09:59 -0400", "fmt rfc2822")
}

///|
test "rfc2822_parse_single_digit_day" {
  let fdt = unwrap_fdt(FixedDateTime::parse_rfc2822("Thu, 1 Jan 1970 00:00:01 -0000"))
  let ts = unwrap_ts(fdt.to_timestamp())
  debug_assert(ts.secs == 1L && ts.nanos == 0, "1s")
  debug_assert(ts.to_rfc2822() == "Thu, 01 Jan 1970 00:00:01 -0000" || ts.to_rfc2822() == "Thu, 1 Jan 1970 00:00:01 -0000", "fmt")
}

///|
test "rfc2822_parse_without_weekday" {
  let fdt = unwrap_fdt(FixedDateTime::parse_rfc2822("15 Jun 2024 07:00:00 +1000"))
  debug_assert(fdt.to_rfc3339() == "2024-06-15T07:00:00+10:00", "no weekday")
}

///|
test "rfc2822_parse_without_seconds" {
  let fdt = unwrap_fdt(FixedDateTime::parse_rfc2822("Thu, 29 Feb 2024 05:34 -0500"))
  debug_assert(fdt.to_rfc3339() == "2024-02-29T05:34:00-05:00", "no seconds")
}

///|
test "rfc2822_parse_obsolete_zones" {
  let t_gmt = unwrap_ts(Timestamp::parse_rfc2822("Thu, 01 Jan 1970 00:00:00 GMT"))
  debug_assert(t_gmt.eq(Timestamp::unix_epoch()), "GMT")
  let t_ut = unwrap_ts(Timestamp::parse_rfc2822("Thu, 01 Jan 1970 00:00:00 UT"))
  debug_assert(t_ut.eq(Timestamp::unix_epoch()), "UT")
  let t_est = unwrap_ts(Timestamp::parse_rfc2822("Wed, 31 Dec 1969 19:00:00 EST"))
  debug_assert(t_est.eq(Timestamp::unix_epoch()), "EST")
  let t_edt = unwrap_ts(Timestamp::parse_rfc2822("Wed, 31 Dec 1969 20:00:00 EDT"))
  debug_assert(t_edt.eq(Timestamp::unix_epoch()), "EDT")
  let t_pst = unwrap_ts(Timestamp::parse_rfc2822("Wed, 31 Dec 1969 16:00:00 PST"))
  debug_assert(t_pst.eq(Timestamp::unix_epoch()), "PST")
  let t_pdt = unwrap_ts(Timestamp::parse_rfc2822("Wed, 31 Dec 1969 17:00:00 PDT"))
  debug_assert(t_pdt.eq(Timestamp::unix_epoch()), "PDT")
}

///|
test "rfc2822_parse_two_and_three_digit_year" {
  let f1 = unwrap_fdt(FixedDateTime::parse_rfc2822("15 Jun 24 07:00:00 +0000"))
  debug_assert(f1.datetime.date.year == 2024, "24 -> 2024")
  let f2 = unwrap_fdt(FixedDateTime::parse_rfc2822("15 Jun 99 07:00:00 +0000"))
  debug_assert(f2.datetime.date.year == 1999, "99 -> 1999")
  let f3 = unwrap_fdt(FixedDateTime::parse_rfc2822("15 Jun 100 07:00:00 +0000"))
  debug_assert(f3.datetime.date.year == 2000, "100 -> 2000")
}

///|
test "rfc2822_parse_trailing_comment" {
  let fdt = unwrap_fdt(FixedDateTime::parse_rfc2822("Sat, 13 Jul 2024 15:09:59 -0400 (EDT)"))
  debug_assert(fdt.to_rfc3339() == "2024-07-13T15:09:59-04:00", "comment")
}

///|
test "rfc2822_reject_inconsistent_weekday" {
  // 2024-07-13 is Saturday, not Sunday
  debug_assert(is_err_fdt(FixedDateTime::parse_rfc2822("Sun, 13 Jul 2024 15:09:59 -0400")), "wrong weekday")
}

///|
test "rfc2822_reject_invalid_month_and_date" {
  debug_assert(is_err_fdt(FixedDateTime::parse_rfc2822("Sat, 13 Foo 2024 15:09:59 -0400")), "bad month")
  debug_assert(is_err_fdt(FixedDateTime::parse_rfc2822("29 Feb 2023 15:09:59 +0000")), "non-leap feb 29")
  debug_assert(is_err_fdt(FixedDateTime::parse_rfc2822("Sat, 13 Jul 2024 15:09:59 +9999")), "bad offset")
}

///|
test "rfc2822_all_months" {
  let months = [
    "15 Jan 2024 00:00:00 +0000",
    "15 Feb 2024 00:00:00 +0000",
    "15 Mar 2024 00:00:00 +0000",
    "15 Apr 2024 00:00:00 +0000",
    "15 May 2024 00:00:00 +0000",
    "15 Jun 2024 00:00:00 +0000",
    "15 Jul 2024 00:00:00 +0000",
    "15 Aug 2024 00:00:00 +0000",
    "15 Sep 2024 00:00:00 +0000",
    "15 Oct 2024 00:00:00 +0000",
    "15 Nov 2024 00:00:00 +0000",
    "15 Dec 2024 00:00:00 +0000",
  ]
  let mut i = 0
  while i < months.length() {
    let fdt = unwrap_fdt(FixedDateTime::parse_rfc2822(months[i]))
    debug_assert(fdt.datetime.date.month == i + 1, "month index")
    i = i + 1
  }
}

///|
test "http_date_rfc9110_imf_fixdate_format" {
  let ts = unwrap_ts(Timestamp::from_second(1L))
  debug_assert(ts.to_http_date() == "Thu, 01 Jan 1970 00:00:01 GMT", "imf-fixdate 1970")
  let ts2 = unwrap_ts(Timestamp::parse_rfc3339("1994-11-06T08:49:37Z"))
  debug_assert(ts2.to_http_date() == "Sun, 06 Nov 1994 08:49:37 GMT", "rfc9110 example")
}

///|
test "http_date_rfc9110_parse_valid" {
  let ts = unwrap_ts(Timestamp::parse_http_date("Sun, 06 Nov 1994 08:49:37 GMT"))
  debug_assert(ts.to_rfc3339() == "1994-11-06T08:49:37Z", "parse imf-fixdate")
  let ts2 = unwrap_ts(Timestamp::parse_http_date("Thu, 01 Jan 1970 00:00:00 GMT"))
  debug_assert(ts2.eq(Timestamp::unix_epoch()), "epoch http-date")
}

///|
test "http_date_rfc9110_reject_non_gmt_or_bad_format" {
  debug_assert(is_err_ts(Timestamp::parse_http_date("Sun, 06 Nov 1994 08:49:37 +0000")), "must be GMT")
  debug_assert(is_err_ts(Timestamp::parse_http_date("Sun, 6 Nov 1994 08:49:37 GMT")), "day must be 2 digits")
  debug_assert(is_err_ts(Timestamp::parse_http_date("Mon, 06 Nov 1994 08:49:37 GMT")), "wrong weekday")
  debug_assert(is_err_ts(Timestamp::parse_http_date("Sun, 06 Nov 1994 08:49:37 GMT ")), "trailing space")
}

///|
test "iso_duration_signed_pt1h30m45_5s" {
  let d = unwrap_dur(SignedDuration::parse_iso("PT1H30M45.5S"))
  debug_assert(d.secs == 5445L && d.nanos == 500000000, "1h30m45.5s")
  debug_assert(d.to_iso_string() == "PT1H30M45.5S", "fmt")
}

///|
test "iso_duration_signed_negative" {
  let d = unwrap_dur(SignedDuration::parse_iso("-PT1H30M45.5S"))
  debug_assert(d.secs == -5445L && d.nanos == -500000000, "-1h30m45.5s")
  debug_assert(d.to_iso_string() == "-PT1H30M45.5S", "fmt neg")
}

///|
test "iso_duration_signed_zero" {
  let d = unwrap_dur(SignedDuration::parse_iso("PT0S"))
  debug_assert(d.is_zero(), "PT0S")
  debug_assert(d.to_iso_string() == "PT0S", "fmt PT0S")
  let d2 = unwrap_dur(SignedDuration::parse_iso("-PT0S"))
  debug_assert(d2.is_zero(), "-PT0S")
  let d3 = unwrap_dur(SignedDuration::parse_iso("+PT0H0M0S"))
  debug_assert(d3.is_zero(), "+PT0H0M0S")
}

///|
test "iso_duration_signed_subsecond_only" {
  let d = unwrap_dur(SignedDuration::parse_iso("PT0.000000001S"))
  debug_assert(d.secs == 0L && d.nanos == 1, "1ns")
  debug_assert(d.to_iso_string() == "PT0.000000001S", "fmt 1ns")
  let dn = unwrap_dur(SignedDuration::parse_iso("-PT0.5S"))
  debug_assert(dn.secs == 0L && dn.nanos == -500000000, "-0.5s")
  debug_assert(dn.to_iso_string() == "-PT0.5S", "fmt -0.5s")
}

///|
test "iso_duration_signed_lowercase_and_comma" {
  let d1 = unwrap_dur(SignedDuration::parse_iso("pt2h5m10,25s"))
  debug_assert(d1.secs == 7510L && d1.nanos == 250000000, "lower + comma")
}

///|
test "iso_duration_signed_fractional_hours_and_minutes" {
  let d1 = unwrap_dur(SignedDuration::parse_iso("PT1.5H"))
  debug_assert(d1.secs == 5400L && d1.nanos == 0, "1.5H == 5400s")
  let d2 = unwrap_dur(SignedDuration::parse_iso("PT1.5M"))
  debug_assert(d2.secs == 90L && d2.nanos == 0, "1.5M == 90s")
}

///|
test "iso_duration_signed_reject_invalid" {
  debug_assert(is_err_dur(SignedDuration::parse_iso("")), "empty")
  debug_assert(is_err_dur(SignedDuration::parse_iso("P")), "P only")
  debug_assert(is_err_dur(SignedDuration::parse_iso("PT")), "PT only")
  debug_assert(is_err_dur(SignedDuration::parse_iso("P1D")), "calendar unit in SignedDuration")
  debug_assert(is_err_dur(SignedDuration::parse_iso("PT1S2M")), "out of order")
  debug_assert(is_err_dur(SignedDuration::parse_iso("PT1.5H30M")), "unit after fraction")
  debug_assert(is_err_dur(SignedDuration::parse_iso("PT1Sx")), "trailing")
}

///|
test "iso_duration_calendar_full_p1y2m3dt4h5m6s" {
  let d = unwrap_isodur(IsoDuration::parse("P1Y2M3DT4H5M6S"))
  debug_assert(!d.negative, "pos")
  debug_assert(d.years == 1 && d.months == 2 && d.weeks == 0 && d.days == 3, "date")
  debug_assert(d.hours == 4 && d.minutes == 5 && d.seconds == 6L && d.nanoseconds == 0, "time")
  debug_assert(d.to_string() == "P1Y2M3DT4H5M6S", "fmt")
}

///|
test "iso_duration_calendar_negative" {
  let d = unwrap_isodur(IsoDuration::parse("-P1Y2M3DT4H5M6.789S"))
  debug_assert(d.negative, "neg")
  debug_assert(d.years == 1 && d.months == 2 && d.days == 3, "date")
  debug_assert(d.hours == 4 && d.minutes == 5 && d.seconds == 6L && d.nanoseconds == 789000000, "time")
  debug_assert(d.to_string() == "-P1Y2M3DT4H5M6.789S", "fmt")
}

///|
test "iso_duration_calendar_weeks_and_date_only" {
  let d1 = unwrap_isodur(IsoDuration::parse("P2W"))
  debug_assert(d1.weeks == 2 && d1.to_string() == "P2W", "P2W")
  let d2 = unwrap_isodur(IsoDuration::parse("P1Y3M10D"))
  debug_assert(d2.years == 1 && d2.months == 3 && d2.days == 10 && d2.to_string() == "P1Y3M10D", "P1Y3M10D")
}

///|
test "iso_duration_to_signed_duration" {
  let d1 = unwrap_isodur(IsoDuration::parse("PT1H30M45.5S"))
  let sd1 = unwrap_dur(d1.to_signed_duration())
  debug_assert(sd1.secs == 5445L && sd1.nanos == 500000000, "to_signed")
  let d2 = unwrap_isodur(IsoDuration::parse("P1DT1H"))
  debug_assert(is_err_dur(d2.to_signed_duration()), "has days -> err")
}

///|
test "iso_duration_calendar_reject_invalid" {
  debug_assert(is_err_isodur(IsoDuration::parse("")), "empty")
  debug_assert(is_err_isodur(IsoDuration::parse("P")), "P only")
  debug_assert(is_err_isodur(IsoDuration::parse("P1DT")), "trailing T")
  debug_assert(is_err_isodur(IsoDuration::parse("P1D2Y")), "wrong order")
  debug_assert(is_err_isodur(IsoDuration::parse("P1Y1Y")), "duplicate unit")
  debug_assert(is_err_isodur(IsoDuration::parse("1Y")), "missing P")
}

///|
test "rfc3339_parse_various_timezones_roundtrip" {
  let cases = [
    "1970-01-01T00:00:00Z",
    "1969-12-31T23:59:59.999999999Z",
    "2000-02-29T12:00:00+00:00",
    "2024-02-29T23:59:59.5+14:00",
    "2024-07-04T08:15:30.000123-12:00",
    "2038-01-19T03:14:07Z",
    "2099-12-31T23:59:59.999999999+09:00",
    "1900-01-01T00:00:00-05:00",
  ]
  let mut i = 0
  while i < cases.length() {
    let fdt = unwrap_fdt(FixedDateTime::parse_rfc3339(cases[i]))
    let ts = unwrap_ts(fdt.to_timestamp())
    let fdt2 = FixedDateTime::from_timestamp(ts, fdt.offset)
    debug_assert(fdt2.eq(fdt), "roundtrip case")
    i = i + 1
  }
}

///|
test "rfc3339_parse_offset_max_23_59" {
  let f1 = unwrap_fdt(FixedDateTime::parse_rfc3339("2024-06-15T12:00:00+23:59"))
  debug_assert(f1.offset.seconds == 86340, "+23:59")
  let f2 = unwrap_fdt(FixedDateTime::parse_rfc3339("2024-06-15T12:00:00-23:59"))
  debug_assert(f2.offset.seconds == -86340, "-23:59")
}

///|
test "rfc3339_reject_non_digit_in_date_time" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("202a-06-15T12:00:00Z")), "bad year char")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-0a-15T12:00:00Z")), "bad month char")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-1aT12:00:00Z")), "bad day char")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T1a:00:00Z")), "bad hour char")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:0a:00Z")), "bad min char")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:00:0aZ")), "bad sec char")
}

///|
test "rfc3339_reject_fractional_non_digit" {
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:00:00.12aZ")), "bad frac")
}

///|
test "rfc3339_reject_comma_fraction" {
  // Strict RFC 3339 only allows '.' for fractional seconds
  debug_assert(is_err_ts(Timestamp::parse_rfc3339("2024-06-15T12:00:00,5Z")), "comma rejected")
}

///|
test "rfc3339_parse_minus_zero_offset_preserves_zero" {
  let fdt = unwrap_fdt(FixedDateTime::parse_rfc3339("2024-06-15T12:00:00-00:00"))
