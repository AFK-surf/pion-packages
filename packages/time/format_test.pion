///|
test "rfc3339_slice_parse_and_write_zero_alloc" {
  let buf = "prefix|2024-02-29T12:34:56.000456789+09:00|suffix"
  let ts = unwrap_ts(Timestamp::parse_rfc3339_slice(buf, 7, 42))
  let ts_full = unwrap_ts(Timestamp::parse_rfc3339("2024-02-29T12:34:56.000456789+09:00"))
  debug_assert(ts.eq(ts_full), "slice parse matches full parse")
  let fdt = unwrap_fdt(FixedDateTime::parse_rfc3339_slice(buf, 7, 42))
  let fdt_full = unwrap_fdt(FixedDateTime::parse_rfc3339("2024-02-29T12:34:56.000456789+09:00"))
  debug_assert(fdt.eq(fdt_full), "fdt slice parse matches full parse")

  // Reused StringBuilder write_rfc3339 / write_rfc3339_with_offset / FixedDateTime::write_rfc3339
  let sb = StringBuilder::new()
  ts.write_rfc3339(sb)
  debug_assert(sb.to_string() == ts.to_rfc3339(), "write_rfc3339 matches to_rfc3339")
  let jst = unwrap_off(Offset::from_hours(9))
  sb.reset()
  ts.write_rfc3339_with_offset(jst, sb)
  debug_assert(
    sb.to_string() == "2024-02-29T12:34:56.000456789+09:00",
    "write_rfc3339_with_offset",
  )
  sb.reset()
  fdt.write_rfc3339(sb)
  debug_assert(sb.to_string() == fdt.to_rfc3339(), "fdt write_rfc3339")

  // Slice out-of-bounds rejected
  debug_assert(is_err_ts(Timestamp::parse_rfc3339_slice(buf, -1, 20)), "neg start")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339_slice(buf, 20, 10)), "end < start")
  debug_assert(is_err_ts(Timestamp::parse_rfc3339_slice(buf, 0, 100)), "end > len")
  debug_assert(is_err_fdt(FixedDateTime::parse_rfc3339_slice(buf, 7, 25)), "truncated slice")
}

///|
test "rfc3339_raw_slice_and_bytes_roundtrip" {
  let samples = [
    "1970-01-01T00:00:00Z",
    "1969-12-31T23:59:59.9Z",
    "2024-02-29T12:34:56.123+09:00",
    "2024-06-15T00:00:00.000456-05:30",
    "1999-12-31T23:59:59.000000001+14:00",
    "2050-01-01T00:00:00.999999999-12:00",
    "2024-06-15T12:34:56.010Z",
    "0000-01-01T00:00:00Z",
    "9999-12-30T22:00:00.999999999Z",
  ]
  let out : Array[Int64] = [0L, 0L]
  let bytes_buf = Bytes::new(48)
  let jst = unwrap_off(Offset::from_hours(9))
  let mut i = 0
  while i < samples.length() {
    let s = samples[i]
    let ok = parse_rfc3339_slice_raw(s, 0, s.length(), out)
    debug_assert(ok, "raw parse ok")
    let ts = unwrap_ts(Timestamp::parse_rfc3339(s))
    debug_assert(out[0] == ts.secs && out[1].to_int() == ts.nanos, "raw matches Timestamp")
    let n = ts.write_rfc3339_bytes(jst, bytes_buf)
    let expected = ts.to_rfc3339_with_offset(jst)
    debug_assert(n == expected.length(), "bytes len matches")
    let mut j = 0
    while j < n {
      debug_assert(
        bytes_buf[j].to_int() == expected.code_unit_at(j),
        "bytes content matches",
      )
      j = j + 1
    }
    i = i + 1
  }
  debug_assert(!parse_rfc3339_slice_raw("2023-02-29T00:00:00Z", 0, 20, out), "reject leap")
  debug_assert(!parse_rfc3339_slice_raw("2024-01-01T24:00:00Z", 0, 20, out), "reject hour 24")
}
