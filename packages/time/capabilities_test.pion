///| Unit tests for P0/P1/P2 red-team fixes and new capabilities:
///| rounding, POSIX TZ, TZif v1/v2 binary parsing, Zoned + DST disambiguation,
///| RFC 9557, RFC 9110 all 3 HTTP-date formats, and strftime / strptime.

///|
test "p0_iso_duration_overflow_rejected" {
  debug_assert(is_err_isodur(IsoDuration::parse("P4294967297D")), "days > max")
  debug_assert(is_err_isodur(IsoDuration::parse("PT4294967297H")), "hours > max")
  debug_assert(is_err_isodur(IsoDuration::parse("PT2147483648M")), "minutes > i32 max")
  debug_assert(is_err_isodur(IsoDuration::parse("P2147483648W")), "weeks > max")
  debug_assert(is_err_isodur(IsoDuration::parse("P99999999999Y")), "years > max")
  debug_assert(is_err_isodur(IsoDuration::parse("P20000Y")), "years > 19998")
  let ok_max_y = unwrap_isodur(IsoDuration::parse("P19998Y"))
  debug_assert(ok_max_y.years == 19998, "19998Y ok")
}

///|
test "p0_signed_duration_min_roundtrip" {
  let min_s = SignedDuration::min().to_iso_string()
  debug_assert(min_s == "-PT2562047788015215H30M8.999999999S", "min iso")
  let back = unwrap_dur(SignedDuration::parse_iso(min_s))
  debug_assert(back.eq(SignedDuration::min()), "min roundtrip")
  let min_secs = unwrap_dur(SignedDuration::new(-9223372036854775807L - 1L, 0))
  debug_assert(min_secs.to_iso_string() == "-PT2562047788015215H30M8S", "i64_min secs")
  let parsed_min = unwrap_dur(SignedDuration::parse_iso("-PT9223372036854775808S"))
  debug_assert(parsed_min.secs == -9223372036854775807L - 1L && parsed_min.nanos == 0, "parse i64_min")
  let parsed_min_full = unwrap_dur(SignedDuration::parse_iso("-PT9223372036854775808.999999999S"))
  debug_assert(parsed_min_full.eq(SignedDuration::min()), "parse min full")
  debug_assert(is_err_dur(SignedDuration::parse_iso("PT9223372036854775808S")), "pos 2^63 rejected")
}

///|
test "p1_defensive_packed_and_raw_guards" {
  let p = epoch_days_to_packed_date(99999999)
  debug_assert(p == -1, "sentinel -1")
  debug_assert(packed_date_year(p) == 0 && packed_date_month(p) == 0 && packed_date_day(p) == 0, "sentinel fields 0")
  debug_assert(packed_date_add_days(-1, 5) == -1, "add_days sentinel")
  debug_assert(packed_date_to_packed_iso_week(-1) == -1, "iso_week sentinel")
  debug_assert(packed_iso_week_year(-1) == 0 && packed_iso_week_week(-1) == 0, "iso_week fields 0")
  let feb31 = (2025 + 10000) * 512 + 2 * 32 + 31
  debug_assert(packed_date_add_days(feb31, 0) == -1, "invalid packed feb 31 rejected")
  debug_assert(packed_date_to_packed_iso_week(feb31) == -1, "invalid packed iso_week rejected")

  let buf = Bytes::new(64)
  debug_assert(format_rfc3339_raw_bytes(0L, -1, 0, buf) == -1, "neg nanos")
  debug_assert(format_rfc3339_raw_bytes(0L, 1000000000, 0, buf) == -1, "nanos >= 1e9")
  debug_assert(format_rfc3339_raw_bytes(0L, 0, 360000, buf) == -1, "offset out of range")
  debug_assert(format_rfc3339_raw_bytes(253402300800L, 0, 0, buf) == -1, "year 10000")

  // Defensive formatting on bypassed struct literals
  let bad_ts = Timestamp::{ secs: 0L, nanos: -5 }
  debug_assert(bad_ts.to_rfc3339() == "", "bad ts empty")
  let bad_d = Date::{ year: 2025, month: 2, day: 31 }
  debug_assert(bad_d.to_string() == "", "bad date empty")
  let bad_sd = SignedDuration::{ secs: 5L, nanos: -999999999 }
  debug_assert(bad_sd.to_iso_string() == "PT4.000000001S", "bad sd normalized")
}

///|
test "p2_http_date_all_three_rfc9110_formats" {
  let t1 = unwrap_ts(Timestamp::parse_http_date("Sun, 06 Nov 1994 08:49:37 GMT"))
  let t2 = unwrap_ts(Timestamp::parse_http_date("Sunday, 06-Nov-94 08:49:37 GMT"))
  let t3 = unwrap_ts(Timestamp::parse_http_date("Sun Nov  6 08:49:37 1994"))
  let t4 = unwrap_ts(Timestamp::parse_http_date("Sun Nov 06 08:49:37 1994"))
  debug_assert(t1.eq(t2), "RFC 850 == IMF-fixdate")
  debug_assert(t1.eq(t3), "asctime == IMF-fixdate")
  debug_assert(t1.eq(t4), "asctime 06 == IMF-fixdate")
  debug_assert(t1.secs == 784111777L, "exact epoch sec")
  // Reject inconsistent weekday in RFC 850 & asctime
  debug_assert(is_err_ts(Timestamp::parse_http_date("Monday, 06-Nov-94 08:49:37 GMT")), "bad rfc850 wd")
  debug_assert(is_err_ts(Timestamp::parse_http_date("Mon Nov  6 08:49:37 1994")), "bad asctime wd")
}

///|
test "p2_rfc9557_tz_annotation_and_iso8601_forms" {
  let tz1 = match parse_rfc9557_tz_name("2025-01-01T00:00:00-05:00[America/New_York]") {
    Ok(Some(n)) => n
    _ => ""
  }
  debug_assert(tz1 == "America/New_York", "extract America/New_York")
  let tz2 = match parse_rfc9557_tz_name("2025-01-01T00:00:00+00:00[!Etc/UTC][u-ca=iso8601]") {
    Ok(Some(n)) => n
    _ => ""
  }
  debug_assert(tz2 == "Etc/UTC", "extract critical Etc/UTC")
  let d = unwrap_isodur(IsoDuration::parse("PT1.5H"))
  debug_assert(d.to_string() == "PT1H30M", "PT1.5H normalized to PT1H30M")
}

///|
test "round_timestamp_datetime_time_duration" {
  // Exact jiff gaps.rs example: 2024-06-01T12:34:56.789Z -> 15-minute HalfExpand -> 12:30:00Z
  let ts = unwrap_ts(Timestamp::parse_rfc3339("2024-06-01T12:34:56.789Z"))
  let r1 = unwrap_ts(ts.round(TimeUnit::Minute, 15, RoundMode::HalfExpand))
  debug_assert(r1.to_rfc3339() == "2024-06-01T12:30:00Z", "15m HalfExpand")
  let r2 = unwrap_ts(ts.round(TimeUnit::Minute, 15, RoundMode::Ceil))
  debug_assert(r2.to_rfc3339() == "2024-06-01T12:45:00Z", "15m Ceil")

  let dt = unwrap_dt(DateTime::parse("2024-06-01T23:55:00"))
  let dt_ceil = unwrap_dt(dt.round(TimeUnit::Minute, 15, RoundMode::Ceil))
  debug_assert(dt_ceil.to_string() == "2024-06-02T00:00:00", "DateTime round across midnight")

  let t = unwrap_time(Time::parse("12:34:56.5"))
  let t_even = unwrap_time(t.round(TimeUnit::Second, 1, RoundMode::HalfEven))
  debug_assert(t_even.to_string() == "12:34:56", "HalfEven to even 56")

  let sd = unwrap_dur(SignedDuration::parse_iso("PT1H23M45S"))
  let sd_r = unwrap_dur(sd.round(TimeUnit::Minute, 15, RoundMode::HalfExpand))
  debug_assert(sd_r.to_iso_string() == "PT1H30M", "SignedDuration round 15m")
}

///|
test "timezone_posix_dst_gap_fold_and_zoned" {
  let ny = match TimeZone::posix("EST5EDT,M3.2.0,M11.1.0") {
    Ok(z) => z
    Err(_) => {
      debug_assert(false, "posix EST5EDT failed")
      TimeZone::utc()
    }
  }
  // Summer (2024-07-01T12:00:00Z -> 2024-07-01T08:00:00-04:00)
  let summer = unwrap_ts(Timestamp::from_second(1719835200L)).to_zoned(ny)
  debug_assert(summer.to_string() == "2024-07-01T08:00:00-04:00", "summer EDT")
  debug_assert(ny.to_offset_info(summer.timestamp).abbrev == "EDT", "abbrev EDT")
  debug_assert(ny.to_offset_info(summer.timestamp).dst, "is dst")

  // DST Gap: 2024-03-10T02:30:00 does not exist in EST5EDT
  let gap_dt = unwrap_dt(DateTime::parse("2024-03-10T02:30:00"))
  let amb_gap = ny.to_ambiguous_zoned(gap_dt)
  debug_assert(amb_gap.is_gap(), "is gap")
  let gap_compat = match amb_gap.disambiguate(Disambiguation::Compatible) {
    Ok(z) => z
    Err(_) => summer
  }
  debug_assert(gap_compat.to_string() == "2024-03-10T03:30:00-04:00", "gap Compatible -> 03:30-04:00")
  let gap_earlier = match amb_gap.disambiguate(Disambiguation::Earlier) {
    Ok(z) => z
    Err(_) => summer
  }
  debug_assert(gap_earlier.to_string() == "2024-03-10T01:30:00-05:00", "gap Earlier -> 01:30-05:00")
  debug_assert(amb_gap.disambiguate(Disambiguation::Reject) is Err(_), "gap Reject")

  // DST Fold: 2024-11-03T01:30:00 happens twice in EST5EDT
  let fold_dt = unwrap_dt(DateTime::parse("2024-11-03T01:30:00"))
  let amb_fold = ny.to_ambiguous_zoned(fold_dt)
  debug_assert(amb_fold.is_fold(), "is fold")
  let fold_earlier = match amb_fold.disambiguate(Disambiguation::Earlier) {
    Ok(z) => z
    Err(_) => summer
  }
  debug_assert(fold_earlier.to_string() == "2024-11-03T01:30:00-04:00", "fold Earlier -> -04:00")
  let fold_later = match amb_fold.disambiguate(Disambiguation::Later) {
    Ok(z) => z
    Err(_) => summer
  }
  debug_assert(fold_later.to_string() == "2024-11-03T01:30:00-05:00", "fold Later -> -05:00")
  debug_assert(amb_fold.disambiguate(Disambiguation::Reject) is Err(_), "fold Reject")

  // Civil +1 day across spring-forward DST = 23 elapsed hours
  let z_before = match Zoned::parse_with_tz("2024-03-09T12:00:00-05:00[America/New_York]", ny) {
    Ok(z) => z
    Err(_) => {
      debug_assert(false, "parse_with_tz failed")
      summer
    }
  }
  let z_after = match z_before.add_days(1) {
    Ok(z) => z
    Err(_) => summer
  }
  debug_assert(z_after.datetime.to_string() == "2024-03-10T12:00:00", "wall time preserved")
  debug_assert(z_after.offset.seconds == -14400, "shifted to EDT -04:00")
  debug_assert(z_after.duration_since(z_before).to_iso_string() == "PT23H", "elapsed PT23H")

  // Offset conflict detection in RFC 9557
  debug_assert(
    Zoned::parse_with_tz("2024-07-01T12:00-05:00[America/New_York]", ny) is Err(_),
    "offset conflict rejected",
  )
}

///|
test "timezone_tzif_v2_binary_parsing" {
  // Construct a valid minimal TZif v2 binary with 1 transition + POSIX footer (Lord Howe +10:30 / +11:00)
  // v1 block: 44-byte header + 1 ttinfo (6 bytes) + 4-byte abbrev "LHST\0" (5 bytes) = 55 bytes
  // v2 block: 44-byte header + 1 ttinfo (6 bytes) + 5-byte abbrev = 55 bytes
  // footer: "\n<+1030>-10:30<+11>-11,M10.1.0,M4.1.0\n" (37 bytes)
  let footer = "\n<+1030>-10:30<+11>-11,M10.1.0,M4.1.0\n"
  let total = 55 + 55 + footer.length()
  let b = Bytes::new(total)
  // Helper to write header at offset `base`
  let write_hdr = fn(base : Int) -> Unit {
    b[base] = (84).to_byte() // 'T'
    b[base + 1] = (90).to_byte() // 'Z'
    b[base + 2] = (105).to_byte() // 'i'
    b[base + 3] = (102).to_byte() // 'f'
    b[base + 4] = (50).to_byte() // '2'
    // typecnt = 1 at base + 39
    b[base + 39] = (1).to_byte()
    // charcnt = 5 at base + 43
    b[base + 43] = (5).to_byte()
    // ttinfo[0]: utoff = 37800 (0x000093A8), isdst = 0, desig = 0
    b[base + 44] = (0).to_byte()
    b[base + 45] = (0).to_byte()
    b[base + 46] = (147).to_byte()
    b[base + 47] = (168).to_byte()
    b[base + 48] = (0).to_byte()
    b[base + 49] = (0).to_byte()
    // abbrev "LHST\0"
    b[base + 50] = (76).to_byte()
    b[base + 51] = (72).to_byte()
    b[base + 52] = (83).to_byte()
    b[base + 53] = (84).to_byte()
    b[base + 54] = (0).to_byte()
  }
  write_hdr(0)
  write_hdr(55)
  let mut i = 0
  while i < footer.length() {
    b[110 + i] = footer.code_unit_at(i).to_byte()
    i = i + 1
  }
  let lh = match TimeZone::from_tzif("Australia/Lord_Howe", b) {
    Ok(z) => z
    Err(e) => {
      debug_assert(false, "from_tzif failed: " + e.message)
      TimeZone::utc()
    }
  }
  // 2024-01-01T00:00:00Z is southern hemisphere summer -> +11:00 (39600s)
  let ts_jan = unwrap_ts(Timestamp::from_second(1704067200L))
  debug_assert(lh.to_offset(ts_jan).seconds == 39600, "Lord_Howe Jan +11:00")
  // 2024-07-01T00:00:00Z is winter -> +10:30 (37800s)
  let ts_jul = unwrap_ts(Timestamp::from_second(1719792000L))
  debug_assert(lh.to_offset(ts_jul).seconds == 37800, "Lord_Howe Jul +10:30")
  debug_assert(lh.iana_name() == "Australia/Lord_Howe", "iana name")
}

///|
test "strftime_and_strptime" {
  let ny = match TimeZone::posix("EST5EDT,M3.2.0,M11.1.0") {
    Ok(z) => z
    Err(_) => TimeZone::utc()
  }
  let z = match Zoned::parse_with_tz("2024-03-09T12:00:00-05:00[America/New_York]", ny) {
    Ok(v) => v
    Err(_) => Timestamp::unix_epoch().to_zoned(ny)
  }
  let formatted = match strftime_zoned("%A, %B %-d, %Y at %H:%M %Z", z) {
    Ok(s) => s
    Err(_) => ""
  }
  debug_assert(formatted == "Saturday, March 9, 2024 at 12:00 EST", "strftime_zoned: " + formatted)

  let parsed = match strptime("%d/%m/%Y %H:%M", "31/12/2024 23:05") {
    Ok(dt) => dt
    Err(_) => DateTime::min()
  }
  debug_assert(parsed.to_string() == "2024-12-31T23:05:00", "strptime: " + parsed.to_string())

  let parsed_fdt = match strptime_fixed("%Y-%m-%d %I:%M:%S %p %z", "2024-07-04 03:30:15 PM -0400") {
    Ok(f) => f
    Err(_) => FixedDateTime::new(DateTime::min(), Offset::utc())
  }
  debug_assert(parsed_fdt.to_rfc3339() == "2024-07-04T15:30:15-04:00", "strptime_fixed 12h PM + offset")
}
