  debug_assert(is_err_date(Date::new(2024, 1, 32)), "jan 32")
  debug_assert(is_err_date(Date::new(2024, 12, 32)), "dec 32")
}

///|
test "date_add_months_jan_to_feb_non_leap_and_leap" {
  let d1 = unwrap_date(Date::new(2024, 1, 30))
  debug_assert(unwrap_date(d1.add_months(1)).eq(unwrap_date(Date::new(2024, 2, 29))), "30->29")
  let d2 = unwrap_date(Date::new(2023, 1, 30))
  debug_assert(unwrap_date(d2.add_months(1)).eq(unwrap_date(Date::new(2023, 2, 28))), "30->28")
}

///|
test "date_add_months_may_31_minus_1" {
  let d = unwrap_date(Date::new(2024, 5, 31))
  debug_assert(unwrap_date(d.add_months(-1)).eq(unwrap_date(Date::new(2024, 4, 30))), "may31-1m")
}

///|
test "iso_week_date_1948_02_10" {
  let w = IsoWeekDate::from_date(unwrap_date(Date::new(1948, 2, 10)))
  debug_assert(w.year == 1948 && w.week == 7 && weekday_eq(w.weekday, Weekday::Tue), "1948-W07-2")
}

///|
test "iso_week_date_2024_03_09" {
  let w = IsoWeekDate::from_date(unwrap_date(Date::new(2024, 3, 9)))
  debug_assert(w.year == 2024 && w.week == 10 && weekday_eq(w.weekday, Weekday::Sat), "2024-W10-6")
}

///|
test "iso_week_date_2024_06_16" {
  let w = unwrap_iwd(IsoWeekDate::new(2024, 24, Weekday::Sun))
  debug_assert(w.to_date().eq(unwrap_date(Date::new(2024, 6, 16))), "2024-06-16")
}

///|
test "datetime_cmp" {
  let dt1 = unwrap_dt(DateTime::new(2024, 1, 1, 10, 0, 0, 0))
  let dt2 = unwrap_dt(DateTime::new(2024, 1, 1, 10, 0, 0, 1))
  let dt3 = unwrap_dt(DateTime::new(2024, 1, 2, 0, 0, 0, 0))
  debug_assert(dt1.cmp(dt1) == 0, "eq")
  debug_assert(dt1.cmp(dt2) < 0, "lt time")
  debug_assert(dt2.cmp(dt3) < 0, "lt date")
  debug_assert(dt3.cmp(dt1) > 0, "gt")
}

///|
test "datetime_min_max" {
  let dtmin = DateTime::min()
  let dtmax = DateTime::max()
  debug_assert(dtmin.date.eq(Date::min()) && dtmin.time.eq(Time::min()), "dtmin")
  debug_assert(dtmax.date.eq(Date::max()) && dtmax.time.eq(Time::max()), "dtmax")
}
