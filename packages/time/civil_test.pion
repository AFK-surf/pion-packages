///| Civil calendar tests ported from BurntSushi/jiff (75 tests).

///|
fn unwrap_date(r : Result[Date, TimeError]) -> Date {
  match r {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "expected Ok(Date), got Err: " + e.message)
      Date::min()
    }
  }
}

///|
fn unwrap_time(r : Result[Time, TimeError]) -> Time {
  match r {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, "expected Ok(Time), got Err: " + e.message)
      Time::min()
    }
  }
}

///|
fn unwrap_dt(r : Result[DateTime, TimeError]) -> DateTime {
  match r {
    Ok(dt) => dt
    Err(e) => {
      debug_assert(false, "expected Ok(DateTime), got Err: " + e.message)
      DateTime::min()
    }
  }
}

///|
fn unwrap_iwd(r : Result[IsoWeekDate, TimeError]) -> IsoWeekDate {
  match r {
    Ok(w) => w
    Err(e) => {
      debug_assert(false, "expected Ok(IsoWeekDate), got Err: " + e.message)
      IsoWeekDate::min()
    }
  }
}

///|
fn is_err_date(r : Result[Date, TimeError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_time(r : Result[Time, TimeError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_iwd(r : Result[IsoWeekDate, TimeError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn is_err_wd(r : Result[Weekday, TimeError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
test "leap_year_2000_is_leap" {
  debug_assert(is_leap_year(2000), "2000 is leap")
}

///|
test "leap_year_2400_is_leap" {
  debug_assert(is_leap_year(2400), "2400 is leap")
}

///|
test "leap_year_1900_not_leap" {
  debug_assert(!is_leap_year(1900), "1900 is not leap")
}

///|
test "leap_year_2100_not_leap" {
  debug_assert(!is_leap_year(2100), "2100 is not leap")
}

///|
test "leap_year_0_is_leap" {
  debug_assert(is_leap_year(0), "year 0 is leap")
}

///|
test "leap_year_negative_4_is_leap" {
  debug_assert(is_leap_year(-4), "-4 is leap")
}

///|
test "leap_year_negative_100_not_leap" {
  debug_assert(!is_leap_year(-100), "-100 is not leap")
}

///|
test "leap_year_negative_400_is_leap" {
  debug_assert(is_leap_year(-400), "-400 is leap")
}

///|
test "leap_year_negative_1_not_leap" {
  debug_assert(!is_leap_year(-1), "-1 is not leap")
}

///|
test "leap_year_2024_and_2023" {
  debug_assert(is_leap_year(2024), "2024 is leap")
  debug_assert(!is_leap_year(2023), "2023 is not leap")
}

///|
test "days_in_month_common_year" {
  debug_assert(days_in_month_of(2023, 1) == 31, "jan")
  debug_assert(days_in_month_of(2023, 2) == 28, "feb")
  debug_assert(days_in_month_of(2023, 3) == 31, "mar")
  debug_assert(days_in_month_of(2023, 4) == 30, "apr")
  debug_assert(days_in_month_of(2023, 5) == 31, "may")
  debug_assert(days_in_month_of(2023, 6) == 30, "jun")
  debug_assert(days_in_month_of(2023, 7) == 31, "jul")
  debug_assert(days_in_month_of(2023, 8) == 31, "aug")
  debug_assert(days_in_month_of(2023, 9) == 30, "sep")
  debug_assert(days_in_month_of(2023, 10) == 31, "oct")
  debug_assert(days_in_month_of(2023, 11) == 30, "nov")
  debug_assert(days_in_month_of(2023, 12) == 31, "dec")
}

///|
test "days_in_month_leap_feb" {
  debug_assert(days_in_month_of(2024, 2) == 29, "2024 feb")
  debug_assert(days_in_month_of(2000, 2) == 29, "2000 feb")
  debug_assert(days_in_month_of(1900, 2) == 28, "1900 feb")
  debug_assert(days_in_month_of(0, 2) == 29, "0 feb")
}

///|
test "date_min_and_max" {
  let dmin = Date::min()
  let dmax = Date::max()
  debug_assert(dmin.year == -9999 && dmin.month == 1 && dmin.day == 1, "min")
  debug_assert(dmax.year == 9999 && dmax.month == 12 && dmax.day == 31, "max")
}

///|
test "date_new_valid_boundaries" {
  let d1 = unwrap_date(Date::new(-9999, 1, 1))
  let d2 = unwrap_date(Date::new(9999, 12, 31))
  let d3 = unwrap_date(Date::new(0, 2, 29))
  let d4 = unwrap_date(Date::new(2024, 2, 29))
  debug_assert(d1.eq(Date::min()), "d1")
  debug_assert(d2.eq(Date::max()), "d2")
  debug_assert(d3.year == 0 && d3.month == 2 && d3.day == 29, "d3")
  debug_assert(d4.year == 2024 && d4.month == 2 && d4.day == 29, "d4")
}

///|
test "date_new_invalid_year_low" {
  debug_assert(is_err_date(Date::new(-10000, 12, 31)), "-10000")
}

///|
test "date_new_invalid_year_high" {
  debug_assert(is_err_date(Date::new(10000, 1, 1)), "10000")
}

///|
test "date_new_invalid_month" {
  debug_assert(is_err_date(Date::new(2024, 0, 1)), "month 0")
  debug_assert(is_err_date(Date::new(2024, 13, 1)), "month 13")
}

///|
test "date_new_invalid_day_zero" {
  debug_assert(is_err_date(Date::new(2024, 1, 0)), "day 0")
}

///|
test "date_new_invalid_feb_29_non_leap" {
  debug_assert(is_err_date(Date::new(2023, 2, 29)), "2023-02-29")
  debug_assert(is_err_date(Date::new(1900, 2, 29)), "1900-02-29")
  debug_assert(is_err_date(Date::new(2100, 2, 29)), "2100-02-29")
}

///|
test "date_new_invalid_april_31" {
  debug_assert(is_err_date(Date::new(2024, 4, 31)), "apr 31")
  debug_assert(is_err_date(Date::new(2024, 6, 31)), "jun 31")
  debug_assert(is_err_date(Date::new(2024, 9, 31)), "sep 31")
  debug_assert(is_err_date(Date::new(2024, 11, 31)), "nov 31")
}

///|
test "date_new_constrain_clamps_day" {
  let d1 = unwrap_date(Date::new_constrain(2023, 2, 31))
  let d2 = unwrap_date(Date::new_constrain(2024, 2, 31))
  let d3 = unwrap_date(Date::new_constrain(2024, 4, 31))
  debug_assert(d1.day == 28, "2023 feb")
  debug_assert(d2.day == 29, "2024 feb")
  debug_assert(d3.day == 30, "2024 apr")
  debug_assert(is_err_date(Date::new_constrain(2024, 2, 0)), "day 0 err")
}

///|
test "date_epoch_days_unix_epoch" {
  let d = unwrap_date(Date::new(1970, 1, 1))
  debug_assert(d.to_epoch_days() == 0, "1970-01-01 == 0")
  debug_assert(unwrap_date(Date::from_epoch_days(0)).eq(d), "from 0")
}

///|
test "date_epoch_days_known_dates" {
  debug_assert(unwrap_date(Date::new(1969, 12, 31)).to_epoch_days() == -1, "-1")
  debug_assert(unwrap_date(Date::new(1970, 1, 2)).to_epoch_days() == 1, "1")
  debug_assert(unwrap_date(Date::new(2000, 1, 1)).to_epoch_days() == 10957, "2000-01-01")
  debug_assert(unwrap_date(Date::new(2024, 2, 29)).to_epoch_days() == 19782, "2024-02-29")
  debug_assert(unwrap_date(Date::new(0, 1, 1)).to_epoch_days() == -719528, "0000-01-01")
}

///|
test "date_epoch_days_min_max_roundtrip" {
  let min_days = Date::min().to_epoch_days()
  let max_days = Date::max().to_epoch_days()
  debug_assert(min_days == -4371587, "min epoch days")
  debug_assert(max_days == 2932896, "max epoch days")
  debug_assert(unwrap_date(Date::from_epoch_days(min_days)).eq(Date::min()), "rt min")
  debug_assert(unwrap_date(Date::from_epoch_days(max_days)).eq(Date::max()), "rt max")
  debug_assert(is_err_date(Date::from_epoch_days(min_days - 1)), "below min")
  debug_assert(is_err_date(Date::from_epoch_days(max_days + 1)), "above max")
}

///|
test "date_day_of_year_common" {
  debug_assert(unwrap_date(Date::new(2023, 1, 1)).day_of_year() == 1, "jan 1")
  debug_assert(unwrap_date(Date::new(2023, 2, 28)).day_of_year() == 59, "feb 28")
  debug_assert(unwrap_date(Date::new(2023, 3, 1)).day_of_year() == 60, "mar 1")
  debug_assert(unwrap_date(Date::new(2023, 12, 31)).day_of_year() == 365, "dec 31")
}

///|
test "date_day_of_year_leap" {
  debug_assert(unwrap_date(Date::new(2024, 1, 1)).day_of_year() == 1, "jan 1")
  debug_assert(unwrap_date(Date::new(2024, 2, 28)).day_of_year() == 59, "feb 28")
  debug_assert(unwrap_date(Date::new(2024, 2, 29)).day_of_year() == 60, "feb 29")
  debug_assert(unwrap_date(Date::new(2024, 3, 1)).day_of_year() == 61, "mar 1")
  debug_assert(unwrap_date(Date::new(2024, 12, 31)).day_of_year() == 366, "dec 31")
}

///|
test "date_day_of_year_no_leap" {
  let d_feb29 = unwrap_date(Date::new(2024, 2, 29))
  match d_feb29.day_of_year_no_leap() {
    None => ()
    Some(_) => debug_assert(false, "feb 29 should be None")
  }
  let d_mar1 = unwrap_date(Date::new(2024, 3, 1))
  match d_mar1.day_of_year_no_leap() {
    Some(v) => debug_assert(v == 60, "mar 1 no leap == 60")
    None => debug_assert(false, "mar 1 should be Some")
  }
  let d_dec31 = unwrap_date(Date::new(2024, 12, 31))
  match d_dec31.day_of_year_no_leap() {
    Some(v) => debug_assert(v == 365, "dec 31 no leap == 365")
    None => debug_assert(false, "dec 31 should be Some")
  }
}

///|
test "date_from_day_of_year_valid_and_invalid" {
  debug_assert(unwrap_date(Date::from_day_of_year(2024, 60)).eq(unwrap_date(Date::new(2024, 2, 29))), "2024 doy 60")
  debug_assert(unwrap_date(Date::from_day_of_year(2023, 60)).eq(unwrap_date(Date::new(2023, 3, 1))), "2023 doy 60")
  debug_assert(unwrap_date(Date::from_day_of_year(2024, 366)).eq(unwrap_date(Date::new(2024, 12, 31))), "2024 doy 366")
  debug_assert(is_err_date(Date::from_day_of_year(2023, 366)), "2023 doy 366 err")
  debug_assert(is_err_date(Date::from_day_of_year(2024, 0)), "doy 0 err")
  debug_assert(is_err_date(Date::from_day_of_year(2024, 367)), "doy 367 err")
  debug_assert(is_err_date(Date::from_day_of_year(9999, 366)), "9999 doy 366 err")
}

///|
test "date_from_day_of_year_no_leap" {
  debug_assert(unwrap_date(Date::from_day_of_year_no_leap(2024, 59)).eq(unwrap_date(Date::new(2024, 2, 28))), "59")
  debug_assert(unwrap_date(Date::from_day_of_year_no_leap(2024, 60)).eq(unwrap_date(Date::new(2024, 3, 1))), "60")
  debug_assert(unwrap_date(Date::from_day_of_year_no_leap(2024, 365)).eq(unwrap_date(Date::new(2024, 12, 31))), "365")
  debug_assert(is_err_date(Date::from_day_of_year_no_leap(2024, 366)), "366 err")
}

///|
test "date_first_last_month_year" {
  let d = unwrap_date(Date::new(2024, 2, 15))
  debug_assert(d.first_of_month().eq(unwrap_date(Date::new(2024, 2, 1))), "fom")
  debug_assert(d.last_of_month().eq(unwrap_date(Date::new(2024, 2, 29))), "lom")
  debug_assert(d.first_of_year().eq(unwrap_date(Date::new(2024, 1, 1))), "foy")
  debug_assert(d.last_of_year().eq(unwrap_date(Date::new(2024, 12, 31))), "loy")
  debug_assert(d.days_in_year() == 366, "diy")
  debug_assert(d.days_in_month() == 29, "dim")
  debug_assert(d.in_leap_year(), "ily")
}

///|
test "date_yesterday_tomorrow_basic" {
  let d = unwrap_date(Date::new(2024, 3, 1))
  debug_assert(unwrap_date(d.yesterday()).eq(unwrap_date(Date::new(2024, 2, 29))), "yest leap")
  debug_assert(unwrap_date(d.tomorrow()).eq(unwrap_date(Date::new(2024, 3, 2))), "tom")
}

///|
test "date_yesterday_tomorrow_year_boundary" {
  let jan1 = unwrap_date(Date::new(2024, 1, 1))
  let dec31 = unwrap_date(Date::new(2023, 12, 31))
  debug_assert(unwrap_date(jan1.yesterday()).eq(dec31), "jan1 yest")
  debug_assert(unwrap_date(dec31.tomorrow()).eq(jan1), "dec31 tom")
}

///|
test "date_yesterday_tomorrow_min_max_err" {
  debug_assert(is_err_date(Date::min().yesterday()), "min yest err")
  debug_assert(is_err_date(Date::max().tomorrow()), "max tom err")
}

///|
test "date_add_sub_days" {
  let d = unwrap_date(Date::new(2024, 1, 1))
  debug_assert(unwrap_date(d.add_days(366)).eq(unwrap_date(Date::new(2025, 1, 1))), "+366")
  debug_assert(unwrap_date(d.sub_days(365)).eq(unwrap_date(Date::new(2023, 1, 1))), "-365")
  debug_assert(unwrap_date(d.add_days(0)).eq(d), "+0")
  debug_assert(is_err_date(Date::max().add_days(1)), "max +1 err")
  debug_assert(is_err_date(Date::min().sub_days(1)), "min -1 err")
}

///|
test "date_add_months_clamping_leap" {
  let d = unwrap_date(Date::new(2024, 1, 31))
  debug_assert(unwrap_date(d.add_months(1)).eq(unwrap_date(Date::new(2024, 2, 29))), "2024-01-31 + 1m")
}

///|
test "date_add_months_clamping_common" {
  let d = unwrap_date(Date::new(2023, 1, 31))
  debug_assert(unwrap_date(d.add_months(1)).eq(unwrap_date(Date::new(2023, 2, 28))), "2023-01-31 + 1m")
}

///|
test "date_add_months_negative_and_multi_year" {
  let d = unwrap_date(Date::new(2024, 3, 31))
  debug_assert(unwrap_date(d.add_months(-1)).eq(unwrap_date(Date::new(2024, 2, 29))), "-1m")
  debug_assert(unwrap_date(d.add_months(-13)).eq(unwrap_date(Date::new(2023, 2, 28))), "-13m")
  debug_assert(unwrap_date(d.add_months(12)).eq(unwrap_date(Date::new(2025, 3, 31))), "+12m")
  debug_assert(unwrap_date(d.add_months(-24)).eq(unwrap_date(Date::new(2022, 3, 31))), "-24m")
}

///|
test "date_add_months_zero_and_negative_year" {
  let d = unwrap_date(Date::new(0, 1, 31))
  debug_assert(unwrap_date(d.add_months(-1)).eq(unwrap_date(Date::new(-1, 12, 31))), "0-01-31 -1m")
  debug_assert(unwrap_date(d.add_months(1)).eq(unwrap_date(Date::new(0, 2, 29))), "0-01-31 +1m")
}

///|
test "date_add_months_overflow" {
  debug_assert(is_err_date(Date::max().add_months(1)), "max +1m err")
  debug_assert(is_err_date(Date::min().add_months(-1)), "min -1m err")
}

///|
test "date_add_years_leap_clamping" {
  let d = unwrap_date(Date::new(2024, 2, 29))
  debug_assert(unwrap_date(d.add_years(1)).eq(unwrap_date(Date::new(2025, 2, 28))), "+1y")
  debug_assert(unwrap_date(d.add_years(4)).eq(unwrap_date(Date::new(2028, 2, 29))), "+4y")
  debug_assert(unwrap_date(d.add_years(-4)).eq(unwrap_date(Date::new(2020, 2, 29))), "-4y")
  debug_assert(is_err_date(Date::max().add_years(1)), "max +1y err")
}

///|
test "date_until_since" {
  let d1 = unwrap_date(Date::new(2023, 7, 1))
  let d2 = unwrap_date(Date::new(2024, 7, 1))
  debug_assert(d1.until(d2) == 366, "until 366")
  debug_assert(d2.until(d1) == -366, "until -366")
  debug_assert(d2.since(d1) == 366, "since 366")
  debug_assert(d1.since(d2) == -366, "since -366")
  debug_assert(Date::min().until(Date::max()) == 7304483, "min to max")
  debug_assert(Date::max().since(Date::min()) == 7304483, "max since min")
}

///|
test "date_start_and_end_of_day" {
  let d = unwrap_date(Date::new(2024, 6, 15))
  let s = d.start_of_day()
  let e = d.end_of_day()
  debug_assert(s.date.eq(d) && s.time.hour == 0 && s.time.minute == 0 && s.time.second == 0 && s.time.nanosecond == 0, "start")
  debug_assert(e.date.eq(d) && e.time.hour == 23 && e.time.minute == 59 && e.time.second == 59 && e.time.nanosecond == 999999999, "end")
}

///|
test "date_cmp" {
  let d1 = unwrap_date(Date::new(2024, 1, 1))
  let d2 = unwrap_date(Date::new(2024, 1, 2))
  let d3 = unwrap_date(Date::new(2024, 2, 1))
  debug_assert(d1.cmp(d1) == 0, "eq")
  debug_assert(d1.cmp(d2) < 0, "lt day")
  debug_assert(d2.cmp(d1) > 0, "gt day")
  debug_assert(d2.cmp(d3) < 0, "lt month")
  debug_assert(Date::min().cmp(Date::max()) < 0, "min < max")
}

///|
test "weekday_offsets_monday" {
  debug_assert(weekday_to_monday_zero_offset(Weekday::Mon) == 0, "mon 0")
  debug_assert(weekday_to_monday_one_offset(Weekday::Mon) == 1, "mon 1")
  debug_assert(weekday_to_monday_zero_offset(Weekday::Sun) == 6, "sun 6")
  debug_assert(weekday_to_monday_one_offset(Weekday::Sun) == 7, "sun 7")
  debug_assert(weekday_to_monday_zero_offset(Weekday::Thu) == 3, "thu 3")
  debug_assert(weekday_to_monday_one_offset(Weekday::Thu) == 4, "thu 4")
}

///|
test "weekday_offsets_sunday" {
  debug_assert(weekday_to_sunday_zero_offset(Weekday::Sun) == 0, "sun 0")
  debug_assert(weekday_to_sunday_one_offset(Weekday::Sun) == 1, "sun 1")
  debug_assert(weekday_to_sunday_zero_offset(Weekday::Mon) == 1, "mon 1")
  debug_assert(weekday_to_sunday_one_offset(Weekday::Mon) == 2, "mon 2")
  debug_assert(weekday_to_sunday_zero_offset(Weekday::Sat) == 6, "sat 6")
  debug_assert(weekday_to_sunday_one_offset(Weekday::Sat) == 7, "sat 7")
}

///|
test "weekday_from_offsets_valid_and_invalid" {
  match weekday_from_monday_zero_offset(3) {
    Ok(w) => debug_assert(weekday_eq(w, Weekday::Thu), "thu")
    Err(_) => debug_assert(false, "expected Ok")
  }
  match weekday_from_monday_one_offset(7) {
    Ok(w) => debug_assert(weekday_eq(w, Weekday::Sun), "sun")
    Err(_) => debug_assert(false, "expected Ok")
  }
  match weekday_from_sunday_zero_offset(0) {
    Ok(w) => debug_assert(weekday_eq(w, Weekday::Sun), "sun 0")
    Err(_) => debug_assert(false, "expected Ok")
  }
  match weekday_from_sunday_one_offset(5) {
    Ok(w) => debug_assert(weekday_eq(w, Weekday::Thu), "thu 5")
    Err(_) => debug_assert(false, "expected Ok")
  }
  debug_assert(is_err_wd(weekday_from_monday_zero_offset(-1)), "-1")
  debug_assert(is_err_wd(weekday_from_monday_zero_offset(7)), "7")
  debug_assert(is_err_wd(weekday_from_monday_one_offset(0)), "0")
  debug_assert(is_err_wd(weekday_from_monday_one_offset(8)), "8")
  debug_assert(is_err_wd(weekday_from_sunday_zero_offset(-1)), "s -1")
  debug_assert(is_err_wd(weekday_from_sunday_one_offset(8)), "s 8")
}

///|
test "weekday_wrapping_arithmetic" {
  debug_assert(weekday_eq(weekday_next(Weekday::Mon), Weekday::Tue), "mon next")
  debug_assert(weekday_eq(weekday_next(Weekday::Sun), Weekday::Mon), "sun next")
  debug_assert(weekday_eq(weekday_previous(Weekday::Mon), Weekday::Sun), "mon prev")
  debug_assert(weekday_eq(weekday_wrapping_add(Weekday::Wed, 7), Weekday::Wed), "+7")
  debug_assert(weekday_eq(weekday_wrapping_add(Weekday::Wed, -1), Weekday::Tue), "-1")
  debug_assert(weekday_eq(weekday_wrapping_sub(Weekday::Wed, 10), Weekday::Sun), "-10")
  debug_assert(weekday_since(Weekday::Sun, Weekday::Mon) == 6, "sun since mon")
  debug_assert(weekday_until(Weekday::Mon, Weekday::Sun) == 6, "mon until sun")
  debug_assert(weekday_since(Weekday::Mon, Weekday::Sun) == 1, "mon since sun")
}

///|
test "date_weekday_known_dates" {
  debug_assert(weekday_eq(unwrap_date(Date::new(1970, 1, 1)).weekday(), Weekday::Thu), "1970-01-01 Thu")
  debug_assert(weekday_eq(unwrap_date(Date::new(2024, 2, 29)).weekday(), Weekday::Thu), "2024-02-29 Thu")
  debug_assert(weekday_eq(unwrap_date(Date::new(2000, 1, 1)).weekday(), Weekday::Sat), "2000-01-01 Sat")
  debug_assert(weekday_eq(Date::min().weekday(), Weekday::Mon), "-9999-01-01 Mon")
  debug_assert(weekday_eq(Date::max().weekday(), Weekday::Fri), "9999-12-31 Fri")
}

///|
test "iso_week_date_2020_12_31" {
  let w = unwrap_date(Date::new(2020, 12, 31)).iso_week_date()
  debug_assert(w.year == 2020 && w.week == 53 && weekday_eq(w.weekday, Weekday::Thu), "2020-W53-4")
  debug_assert(w.to_date().eq(unwrap_date(Date::new(2020, 12, 31))), "rt")
}

///|
test "iso_week_date_2021_01_01" {
  let w = unwrap_date(Date::new(2021, 1, 1)).iso_week_date()
  debug_assert(w.year == 2020 && w.week == 53 && weekday_eq(w.weekday, Weekday::Fri), "2020-W53-5")
  debug_assert(w.to_date().eq(unwrap_date(Date::new(2021, 1, 1))), "rt")
}

///|
test "iso_week_date_2019_12_30" {
  let w = unwrap_date(Date::new(2019, 12, 30)).iso_week_date()
  debug_assert(w.year == 2020 && w.week == 1 && weekday_eq(w.weekday, Weekday::Mon), "2020-W01-1")
  debug_assert(w.to_date().eq(unwrap_date(Date::new(2019, 12, 30))), "rt")
}

///|
test "iso_week_date_1995_01_01" {
  let w = unwrap_date(Date::new(1995, 1, 1)).iso_week_date()
  debug_assert(w.year == 1994 && w.week == 52 && weekday_eq(w.weekday, Weekday::Sun), "1994-W52-7")
  debug_assert(w.to_date().eq(unwrap_date(Date::new(1995, 1, 1))), "rt")
}

///|
test "iso_week_date_min_max_zero" {
  let wmin = Date::min().iso_week_date()
  let wmax = Date::max().iso_week_date()
  debug_assert(wmin.eq(IsoWeekDate::min()), "min")
  debug_assert(wmin.year == -9999 && wmin.week == 1 && weekday_eq(wmin.weekday, Weekday::Mon), "-9999-W01-1")
  debug_assert(wmax.eq(IsoWeekDate::max()), "max")
  debug_assert(wmax.year == 9999 && wmax.week == 52 && weekday_eq(wmax.weekday, Weekday::Fri), "9999-W52-5")
  let w0 = unwrap_iwd(IsoWeekDate::new(0, 1, Weekday::Mon))
  debug_assert(w0.to_date().eq(unwrap_date(Date::new(0, 1, 3))), "0000-W01-1 == 0000-01-03")
}

///|
test "iso_week_date_new_validation" {
  debug_assert(is_err_iwd(IsoWeekDate::new(1949, 53, Weekday::Mon)), "1949 no W53")
  debug_assert(!is_err_iwd(IsoWeekDate::new(1948, 53, Weekday::Fri)), "1948 has W53")
  debug_assert(is_err_iwd(IsoWeekDate::new(9999, 52, Weekday::Sat)), "9999-W52-6 err")
  debug_assert(is_err_iwd(IsoWeekDate::new(9999, 53, Weekday::Mon)), "9999-W53-1 err")
  debug_assert(is_err_iwd(IsoWeekDate::new(-10000, 52, Weekday::Sun)), "-10000 err")
  debug_assert(is_err_iwd(IsoWeekDate::new(2024, 0, Weekday::Mon)), "W0 err")
  debug_assert(is_err_iwd(IsoWeekDate::new(2024, 54, Weekday::Mon)), "W54 err")
}

///|
test "iso_week_date_long_year_and_weeks" {
  let w2020 = unwrap_iwd(IsoWeekDate::new(2020, 1, Weekday::Mon))
  let w2024 = unwrap_iwd(IsoWeekDate::new(2024, 1, Weekday::Mon))
  debug_assert(w2020.in_long_year(), "2020 long")
  debug_assert(w2020.weeks_in_year() == 53, "2020 53w")
  debug_assert(w2020.days_in_year() == 371, "2020 371d")
  debug_assert(!w2024.in_long_year(), "2024 short")
  debug_assert(w2024.weeks_in_year() == 52, "2024 52w")
  debug_assert(w2024.days_in_year() == 364, "2024 364d")
}

///|
test "iso_week_date_yesterday_tomorrow" {
  let w = unwrap_iwd(IsoWeekDate::new(2020, 53, Weekday::Sun))
  let tom = unwrap_iwd(w.tomorrow())
  debug_assert(tom.year == 2021 && tom.week == 1 && weekday_eq(tom.weekday, Weekday::Mon), "2021-W01-1")
  let yest = unwrap_iwd(tom.yesterday())
  debug_assert(yest.eq(w), "back to 2020-W53-7")
  debug_assert(is_err_iwd(IsoWeekDate::min().yesterday()), "min yest")
  debug_assert(is_err_iwd(IsoWeekDate::max().tomorrow()), "max tom")
}

///|
test "iso_week_date_20th_century_leap_and_long_years" {
  let mut count = 0
  let mut y = 1900
  while y <= 1999 {
    let d = unwrap_date(Date::new(y, 1, 1))
    if d.in_leap_year() && d.iso_week_date().in_long_year() {
      count = count + 1
    }
    y = y + 1
  }
  debug_assert(count == 11, "11 overlapping years in 1900..=1999")
}

///|
test "time_new_valid_and_invalid" {
  let t = unwrap_time(Time::new(23, 59, 59, 999999999))
  debug_assert(t.eq(Time::max()), "max")
  debug_assert(unwrap_time(Time::new(0, 0, 0, 0)).eq(Time::midnight()), "midnight")
  debug_assert(is_err_time(Time::new(-1, 0, 0, 0)), "h -1")
  debug_assert(is_err_time(Time::new(24, 0, 0, 0)), "h 24")
  debug_assert(is_err_time(Time::new(0, 60, 0, 0)), "m 60")
  debug_assert(is_err_time(Time::new(0, 0, 60, 0)), "s 60")
  debug_assert(is_err_time(Time::new(0, 0, 0, -1)), "ns -1")
  debug_assert(is_err_time(Time::new(0, 0, 0, 1000000000)), "ns 1e9")
}

///|
test "time_subsec_parts_and_seconds" {
  let t = unwrap_time(Time::new(12, 34, 56, 123456789))
  debug_assert(t.millisecond() == 123, "ms")
  debug_assert(t.microsecond() == 456, "us")
  debug_assert(t.nanosecond_part() == 789, "ns")
  debug_assert(t.to_second_of_day() == 45296, "sod")
  debug_assert(t.to_nanosecond_of_day() == 45296123456789L, "nsod")
  let t2 = unwrap_time(Time::from_second_of_day(45296))
  debug_assert(t2.hour == 12 && t2.minute == 34 && t2.second == 56 && t2.nanosecond == 0, "from sod")
  debug_assert(is_err_time(Time::from_second_of_day(-1)), "sod -1")
  debug_assert(is_err_time(Time::from_second_of_day(86400)), "sod 86400")
}

///|
test "time_cmp" {
  let t1 = unwrap_time(Time::new(10, 0, 0, 0))
  let t2 = unwrap_time(Time::new(10, 0, 0, 1))
  debug_assert(t1.cmp(t1) == 0, "eq")
  debug_assert(t1.cmp(t2) < 0, "lt")
  debug_assert(t2.cmp(t1) > 0, "gt")
}

///|
test "datetime_new_and_parts" {
  let dt = unwrap_dt(DateTime::new(2024, 2, 29, 21, 30, 5, 123456789))
  debug_assert(dt.date.year == 2024 && dt.date.month == 2 && dt.date.day == 29, "date")
  debug_assert(dt.time.hour == 21 && dt.time.minute == 30 && dt.time.second == 5 && dt.time.nanosecond == 123456789, "time")
}

///|
test "datetime_add_days_months" {
  let dt = unwrap_dt(DateTime::new(2024, 1, 31, 15, 30, 0, 500))
  let dt2 = unwrap_dt(dt.add_months(1))
  debug_assert(dt2.date.eq(unwrap_date(Date::new(2024, 2, 29))), "date clamped")
  debug_assert(dt2.time.eq(dt.time), "time preserved")
  let dt3 = unwrap_dt(dt.add_days(1))
  debug_assert(dt3.date.eq(unwrap_date(Date::new(2024, 2, 1))), "+1d")
}

///|
test "datetime_add_duration_cross_day" {
  let dt = unwrap_dt(DateTime::new(2024, 2, 28, 23, 0, 0, 500000000))
  let dur = SignedDuration::from_millis(7200600L)
  let dt2 = unwrap_dt(dt.add_duration(dur))
  debug_assert(dt2.date.eq(unwrap_date(Date::new(2024, 2, 29))), "next day leap")
  debug_assert(dt2.time.hour == 1 && dt2.time.minute == 0 && dt2.time.second == 1 && dt2.time.nanosecond == 100000000, "time")
}

///|
test "datetime_add_duration_negative_cross_day" {
  let dt = unwrap_dt(DateTime::new(2024, 3, 1, 0, 0, 0, 100000000))
  let dur = SignedDuration::from_millis(-200L)
  let dt2 = unwrap_dt(dt.add_duration(dur))
  debug_assert(dt2.date.eq(unwrap_date(Date::new(2024, 2, 29))), "prev day leap")
  debug_assert(dt2.time.hour == 23 && dt2.time.minute == 59 && dt2.time.second == 59 && dt2.time.nanosecond == 900000000, "time")
}

///|
test "datetime_until_since" {
  let dt1 = unwrap_dt(DateTime::new(2024, 2, 28, 23, 59, 59, 500000000))
  let dt2 = unwrap_dt(DateTime::new(2024, 2, 29, 0, 0, 0, 200000000))
  let u = dt1.until(dt2)
  let s = dt1.since(dt2)
  debug_assert(u.secs == 0L && u.nanos == 700000000, "until 0.7s")
  debug_assert(s.secs == 0L && s.nanos == -700000000, "since -0.7s")
}

///|
test "datetime_start_end_of_day" {
  let dt = unwrap_dt(DateTime::new(2024, 6, 15, 13, 45, 12, 345))
  debug_assert(dt.start_of_day().time.eq(Time::midnight()), "start")
  debug_assert(dt.end_of_day().time.eq(Time::max()), "end")
}

///|
test "date_at_helper" {
  let d = unwrap_date(Date::new(2024, 7, 4))
  let dt = unwrap_dt(d.at(12, 0, 0, 0))
  debug_assert(dt.date.eq(d) && dt.time.hour == 12, "at")
}

///|
test "date_epoch_days_full_400_year_cycle" {
  // Verify every single day in a 400-year Gregorian cycle (1970..2370 = 146097 days)
  let start = unwrap_date(Date::new(1970, 1, 1)).to_epoch_days()
  let mut cur = unwrap_date(Date::new(1970, 1, 1))
  let mut i = 0
  while i < 146097 {
    let ed = cur.to_epoch_days()
    debug_assert(ed == start + i, "epoch day mismatch")
    let rt = unwrap_date(Date::from_epoch_days(ed))
    debug_assert(rt.eq(cur), "roundtrip mismatch")
    cur = unwrap_date(cur.tomorrow())
    i = i + 1
  }
  debug_assert(cur.eq(unwrap_date(Date::new(2370, 1, 1))), "end of 400y cycle")
}

///|
test "date_negative_years_roundtrip" {
  let years = [-9999, -4000, -1000, -400, -100, -4, -1, 0, 1, 4, 100, 400, 1900, 1969, 1970, 2000, 2024, 9999]
  let mut i = 0
  while i < years.length() {
    let y = years[i]
    let d1 = unwrap_date(Date::new(y, 1, 1))
    let d2 = unwrap_date(Date::new(y, 12, 31))
    debug_assert(unwrap_date(Date::from_epoch_days(d1.to_epoch_days())).eq(d1), "jan1 rt")
    debug_assert(unwrap_date(Date::from_epoch_days(d2.to_epoch_days())).eq(d2), "dec31 rt")
    let iwd1 = d1.iso_week_date()
    let iwd2 = d2.iso_week_date()
    debug_assert(iwd1.to_date().eq(d1), "iwd jan1 rt")
    debug_assert(iwd2.to_date().eq(d2), "iwd dec31 rt")
    i = i + 1
  }
}

///|
test "weekday_short_names" {
  debug_assert(weekday_to_short_name(Weekday::Mon) == "Mon", "Mon")
  debug_assert(weekday_to_short_name(Weekday::Tue) == "Tue", "Tue")
  debug_assert(weekday_to_short_name(Weekday::Wed) == "Wed", "Wed")
  debug_assert(weekday_to_short_name(Weekday::Thu) == "Thu", "Thu")
  debug_assert(weekday_to_short_name(Weekday::Fri) == "Fri", "Fri")
  debug_assert(weekday_to_short_name(Weekday::Sat) == "Sat", "Sat")
  debug_assert(weekday_to_short_name(Weekday::Sun) == "Sun", "Sun")
}

