///| `strftime` and `strptime` formatting and parsing (POSIX / BurntSushi/jiff `strtime` compatible).
///| Pure Pion, zero `World`, `wasm32`-compatible.

///|
fn weekday_full_name(w : Weekday) -> String {
  match w {
    Weekday::Mon => "Monday"
    Weekday::Tue => "Tuesday"
    Weekday::Wed => "Wednesday"
    Weekday::Thu => "Thursday"
    Weekday::Fri => "Friday"
    Weekday::Sat => "Saturday"
    Weekday::Sun => "Sunday"
  }
}

///|
fn month_full_name(m : Int) -> String {
  match m {
    1 => "January"
    2 => "February"
    3 => "March"
    4 => "April"
    5 => "May"
    6 => "June"
    7 => "July"
    8 => "August"
    9 => "September"
    10 => "October"
    11 => "November"
    _ => "December"
  }
}

///| Write non-negative `v` with padding mode: `pad_mode` 0 = zero ('0'), 1 = space (' '), 2 = none ('-').
fn write_padded_int(sb : StringBuilder, v : Int, width : Int, pad_mode : Int) -> Unit {
  let s = v.to_string()
  if pad_mode != 2 {
    let pad_ch = if pad_mode == 1 { (32).to_byte() } else { (48).to_byte() }
    let mut k = s.length()
    while k < width {
      sb.write_byte(pad_ch)
      k = k + 1
    }
  }
  sb.write_string(s)
}

///|
fn strftime_core(
  fmt : String,
  dt : DateTime,
  off_opt : Option[Offset],
  tz_abbrev : String,
) -> Result[String, TimeError] {
  let sb = StringBuilder::new()
  let len = fmt.length()
  let mut i = 0
  while i < len {
    let c = fmt.code_unit_at(i)
    if c != 37 {
      sb.write_byte(c.to_byte())
      i = i + 1
      continue
    }
    i = i + 1
    if i >= len {
      return Err(TimeError::new("STRFTIME", "trailing '%' in format string"))
    }
    // Optional flags: '-', '_', '0', ':', '.'
    let mut pad_mode = -1
    let mut has_colon = false
    let mut has_dot = false
    let fch = fmt.code_unit_at(i)
    if fch == 45 {
      pad_mode = 2
      i = i + 1
    } else if fch == 95 {
      pad_mode = 1
      i = i + 1
    } else if fch == 48 {
      pad_mode = 0
      i = i + 1
    } else if fch == 58 {
      has_colon = true
      i = i + 1
    } else if fch == 46 {
      has_dot = true
      i = i + 1
    }
    if i >= len {
      return Err(TimeError::new("STRFTIME", "incomplete '%' directive"))
    }
    let spec = fmt.code_unit_at(i)
    i = i + 1
    if spec == 37 {
      // %%
      sb.write_byte((37).to_byte())
    } else if spec == 89 {
      // %Y
      let pm = if pad_mode < 0 { 0 } else { pad_mode }
      if dt.date.year < 0 {
        sb.write_byte((45).to_byte())
        write_padded_int(sb, -dt.date.year, 4, pm)
      } else {
        write_padded_int(sb, dt.date.year, 4, pm)
      }
    } else if spec == 121 {
      // %y
      let pm = if pad_mode < 0 { 0 } else { pad_mode }
      let yy = if dt.date.year < 0 { (-dt.date.year) % 100 } else { dt.date.year % 100 }
      write_padded_int(sb, yy, 2, pm)
    } else if spec == 67 {
      // %C
      let pm = if pad_mode < 0 { 0 } else { pad_mode }
      write_padded_int(sb, dt.date.year / 100, 2, pm)
    } else if spec == 109 {
      // %m
      let pm = if pad_mode < 0 { 0 } else { pad_mode }
      write_padded_int(sb, dt.date.month, 2, pm)
    } else if spec == 66 {
      // %B
      sb.write_string(month_full_name(dt.date.month))
    } else if spec == 98 || spec == 104 {
      // %b / %h
      sb.write_string(month_short_name(dt.date.month))
    } else if spec == 100 {
      // %d
      let pm = if pad_mode < 0 { 0 } else { pad_mode }
      write_padded_int(sb, dt.date.day, 2, pm)
    } else if spec == 101 {
      // %e
      let pm = if pad_mode < 0 { 1 } else { pad_mode }
      write_padded_int(sb, dt.date.day, 2, pm)
    } else if spec == 106 {
      // %j
      let pm = if pad_mode < 0 { 0 } else { pad_mode }
      write_padded_int(sb, dt.date.day_of_year(), 3, pm)
    } else if spec == 65 {
      // %A
      sb.write_string(weekday_full_name(dt.date.weekday()))
    } else if spec == 97 {
      // %a
      sb.write_string(weekday_to_short_name(dt.date.weekday()))
    } else if spec == 117 {
      // %u (1-7 Mon=1)
      sb.write_string(weekday_to_monday_one_offset(dt.date.weekday()).to_string())
    } else if spec == 119 {
      // %w (0-6 Sun=0)
      sb.write_string(weekday_to_sunday_zero_offset(dt.date.weekday()).to_string())
    } else if spec == 72 {
      // %H
      let pm = if pad_mode < 0 { 0 } else { pad_mode }
      write_padded_int(sb, dt.time.hour, 2, pm)
    } else if spec == 73 {
      // %I (01-12)
      let pm = if pad_mode < 0 { 0 } else { pad_mode }
      let h12 = dt.time.hour % 12
      write_padded_int(sb, if h12 == 0 { 12 } else { h12 }, 2, pm)
    } else if spec == 77 {
      // %M
      let pm = if pad_mode < 0 { 0 } else { pad_mode }
      write_padded_int(sb, dt.time.minute, 2, pm)
    } else if spec == 83 {
      // %S
      let pm = if pad_mode < 0 { 0 } else { pad_mode }
      write_padded_int(sb, dt.time.second, 2, pm)
    } else if spec == 112 {
      // %p
      sb.write_string(if dt.time.hour < 12 { "AM" } else { "PM" })
    } else if spec == 80 {
      // %P
      sb.write_string(if dt.time.hour < 12 { "am" } else { "pm" })
    } else if spec == 102 {
      // %f or %.f
      if has_dot {
        write_fraction_trimmed(sb, dt.time.nanosecond)
      } else {
        write_padded_int(sb, dt.time.nanosecond, 9, 0)
      }
    } else if spec == 122 {
      // %z / %:z
      match off_opt {
        Some(off) =>
        if has_colon {
          write_offset_hm_to(sb, off)
        } else {
          write_offset_to(sb, off, false)
        }
        None => return Err(TimeError::new("STRFTIME", "%z requires an offset"))
      }
    } else if spec == 90 {
      // %Z
      if tz_abbrev.length() > 0 {
        sb.write_string(tz_abbrev)
      } else {
        match off_opt {
          Some(off) =>
          if off.seconds == 0 {
            sb.write_string("UTC")
          } else {
            write_offset_hm_to(sb, off)
          }
          None => return Err(TimeError::new("STRFTIME", "%Z requires a time zone"))
        }
      }
    } else if spec == 70 {
      // %F -> %Y-%m-%d
      write_date_to(sb, dt.date)
    } else if spec == 84 {
      // %T -> %H:%M:%S
      write_2d(sb, dt.time.hour)
      sb.write_byte((58).to_byte())
      write_2d(sb, dt.time.minute)
      sb.write_byte((58).to_byte())
      write_2d(sb, dt.time.second)
    } else if spec == 82 {
      // %R -> %H:%M
      write_2d(sb, dt.time.hour)
      sb.write_byte((58).to_byte())
      write_2d(sb, dt.time.minute)
    } else if spec == 68 {
      // %D -> %m/%d/%y
      write_2d(sb, dt.date.month)
      sb.write_byte((47).to_byte())
      write_2d(sb, dt.date.day)
      sb.write_byte((47).to_byte())
      let yy = if dt.date.year < 0 { (-dt.date.year) % 100 } else { dt.date.year % 100 }
      write_2d(sb, yy)
    } else if spec == 115 {
      // %s (Unix seconds)
      let off_s = match off_opt {
        Some(o) => o.seconds.to_int64()
        None => 0L
      }
      let secs = dt.date.to_epoch_days().to_int64() * 86400L + dt.time.to_second_of_day().to_int64() - off_s
      sb.write_string(secs.to_string())
    } else if spec == 110 {
      sb.write_byte((10).to_byte())
    } else if spec == 116 {
      sb.write_byte((9).to_byte())
    } else {
      return Err(TimeError::new("STRFTIME", "unsupported strftime specifier"))
    }
  }
  Ok(sb.to_string())
}

///|
pub fn strftime(fmt : String, dt : DateTime) -> Result[String, TimeError] {
  strftime_core(fmt, dt, None, "")
}

///|
pub fn strftime_fixed(fmt : String, fdt : FixedDateTime) -> Result[String, TimeError] {
  strftime_core(fmt, fdt.datetime, Some(fdt.offset), "")
}

///|
pub fn strftime_zoned(fmt : String, z : Zoned) -> Result[String, TimeError] {
  let info = z.tz.to_offset_info(z.timestamp)
  strftime_core(fmt, z.datetime, Some(z.offset), info.abbrev)
}

// -----------------------------------------------------------------------------
// strptime
// -----------------------------------------------------------------------------

///|
fn strptime_read_uint(s : String, pos : Int, max_digits : Int) -> Option[(Int, Int)] {
  let len = s.length()
  let mut p = pos
  let mut acc = 0
  let mut count = 0
  while p < len && count < max_digits && is_digit(s.code_unit_at(p)) {
    acc = acc * 10 + (s.code_unit_at(p) - 48)
    count = count + 1
    p = p + 1
  }
  if count == 0 {
    None
  } else {
    Some((acc, p))
  }
}

///|
fn strptime_match_ci(s : String, pos : Int, target : String) -> Bool {
  let tlen = target.length()
  if pos + tlen > s.length() {
    return false
  }
  let mut i = 0
  while i < tlen {
    if to_lower_ascii(s.code_unit_at(pos + i)) != to_lower_ascii(target.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn strptime_parse_month_name(s : String, pos : Int) -> Option[(Int, Int)] {
  let full = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December",
  ]
  let mut i = 0
  while i < 12 {
    if strptime_match_ci(s, pos, full[i]) {
      return Some((i + 1, pos + full[i].length()))
    }
    i = i + 1
  }
  let m3 = parse_month_3(s, pos)
  if m3 > 0 {
    return Some((m3, pos + 3))
  }
  None
}

///|
fn strptime_parse_weekday_name(s : String, pos : Int) -> Option[(Weekday, Int)] {
  let full = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
  let wds = [Weekday::Mon, Weekday::Tue, Weekday::Wed, Weekday::Thu, Weekday::Fri, Weekday::Sat, Weekday::Sun]
  let mut i = 0
  while i < 7 {
    if strptime_match_ci(s, pos, full[i]) {
      return Some((wds[i], pos + full[i].length()))
    }
    i = i + 1
  }
  match parse_weekday_3(s, pos) {
    Some(w) => Some((w, pos + 3))
    None => None
  }
}

///|
fn strptime_core(fmt : String, input : String) -> Result[(DateTime, Option[Offset]), TimeError] {
  let flen = fmt.length()
  let ilen = input.length()
  let mut fi = 0
  let mut ii = 0
  let mut year = 0
  let mut has_year = false
  let mut month = 1
  let mut day = 1
  let mut hour = 0
  let mut hour12 = -1
  let mut ampm = 0 // 0=none, 1=AM, 2=PM
  let mut minute = 0
  let mut second = 0
  let mut nanos = 0
  let mut off_opt : Option[Offset] = None
  let mut parsed_wd : Option[Weekday] = None

  while fi < flen {
    let fc = fmt.code_unit_at(fi)
    if is_ws(fc) {
      fi = skip_ws(fmt, fi)
      ii = skip_ws(input, ii)
      continue
    }
    if fc != 37 {
      if ii >= ilen || input.code_unit_at(ii) != fc {
        return Err(TimeError::new("STRPTIME", "literal character mismatch"))
      }
      fi = fi + 1
      ii = ii + 1
      continue
    }
    fi = fi + 1
    if fi >= flen {
      return Err(TimeError::new("STRPTIME", "trailing '%' in format"))
    }
    let mut has_colon = false
    let mut has_dot = false
    let fch = fmt.code_unit_at(fi)
    if fch == 45 || fch == 95 || fch == 48 {
      fi = fi + 1
    } else if fch == 58 {
      has_colon = true
      fi = fi + 1
    } else if fch == 46 {
      has_dot = true
      fi = fi + 1
    }
    if fi >= flen {
      return Err(TimeError::new("STRPTIME", "incomplete '%' directive"))
    }
    let spec = fmt.code_unit_at(fi)
    fi = fi + 1
    if spec == 37 {
      if ii >= ilen || input.code_unit_at(ii) != 37 {
        return Err(TimeError::new("STRPTIME", "expected '%'"))
      }
      ii = ii + 1
    } else if spec == 89 {
      // %Y
      let mut neg = false
      if ii < ilen && input.code_unit_at(ii) == 45 {
        neg = true
        ii = ii + 1
      } else if ii < ilen && input.code_unit_at(ii) == 43 {
        ii = ii + 1
      }
      match strptime_read_uint(input, ii, 4) {
        Some(p) => {
          year = if neg { -p.0 } else { p.0 }
          has_year = true
          ii = p.1
        }
        None => return Err(TimeError::new("STRPTIME", "expected year for %Y"))
      }
    } else if spec == 121 {
      // %y (69-99 -> 19xx, 00-68 -> 20xx per POSIX)
      match strptime_read_uint(input, ii, 2) {
        Some(p) => {
          year = if p.0 >= 69 { 1900 + p.0 } else { 2000 + p.0 }
          has_year = true
          ii = p.1
        }
        None => return Err(TimeError::new("STRPTIME", "expected 2-digit year for %y"))
      }
    } else if spec == 109 {
      // %m
      match strptime_read_uint(input, ii, 2) {
        Some(p) => {
          month = p.0
          ii = p.1
        }
        None => return Err(TimeError::new("STRPTIME", "expected month for %m"))
      }
    } else if spec == 66 || spec == 98 || spec == 104 {
      // %B / %b / %h
      match strptime_parse_month_name(input, ii) {
        Some(p) => {
          month = p.0
          ii = p.1
        }
        None => return Err(TimeError::new("STRPTIME", "expected month name"))
      }
    } else if spec == 100 || spec == 101 {
      // %d / %e
      if spec == 101 && ii < ilen && input.code_unit_at(ii) == 32 {
        ii = ii + 1
      }
      match strptime_read_uint(input, ii, 2) {
        Some(p) => {
          day = p.0
          ii = p.1
        }
        None => return Err(TimeError::new("STRPTIME", "expected day for %d/%e"))
      }
    } else if spec == 65 || spec == 97 {
      // %A / %a
      match strptime_parse_weekday_name(input, ii) {
        Some(p) => {
          parsed_wd = Some(p.0)
          ii = p.1
        }
        None => return Err(TimeError::new("STRPTIME", "expected weekday name"))
      }
    } else if spec == 72 {
      // %H
      match strptime_read_uint(input, ii, 2) {
        Some(p) => {
          hour = p.0
          ii = p.1
        }
        None => return Err(TimeError::new("STRPTIME", "expected hour for %H"))
      }
    } else if spec == 73 {
      // %I
      match strptime_read_uint(input, ii, 2) {
        Some(p) => {
          if p.0 < 1 || p.0 > 12 {
            return Err(TimeError::new("STRPTIME", "%I hour must be 1..=12"))
          }
          hour12 = p.0
          ii = p.1
        }
        None => return Err(TimeError::new("STRPTIME", "expected hour for %I"))
      }
    } else if spec == 77 {
      // %M
      match strptime_read_uint(input, ii, 2) {
        Some(p) => {
          minute = p.0
          ii = p.1
        }
        None => return Err(TimeError::new("STRPTIME", "expected minute for %M"))
      }
    } else if spec == 83 {
      // %S
      match strptime_read_uint(input, ii, 2) {
        Some(p) => {
          second = if p.0 == 60 { 59 } else { p.0 }
          ii = p.1
        }
        None => return Err(TimeError::new("STRPTIME", "expected second for %S"))
      }
    } else if spec == 112 || spec == 80 {
      // %p / %P
      if strptime_match_ci(input, ii, "am") {
        ampm = 1
        ii = ii + 2
      } else if strptime_match_ci(input, ii, "pm") {
        ampm = 2
        ii = ii + 2
      } else {
        return Err(TimeError::new("STRPTIME", "expected AM/PM"))
      }
    } else if spec == 102 {
      // %f or %.f
      if has_dot {
        if ii < ilen && (input.code_unit_at(ii) == 46 || input.code_unit_at(ii) == 44) {
          match parse_fraction_at_slice(input, ii, ilen, true) {
            Ok(fp) => {
              nanos = fp.0
              ii = fp.1
            }
            Err(e) => return Err(e)
          }
        }
      } else {
        let mut digits = 0
        let mut ns = 0
        let mut scale = 100000000
        while ii < ilen && digits < 9 && is_digit(input.code_unit_at(ii)) {
          ns = ns + (input.code_unit_at(ii) - 48) * scale
          scale = scale / 10
          digits = digits + 1
          ii = ii + 1
        }
        if digits == 0 {
          return Err(TimeError::new("STRPTIME", "expected fractional digits for %f"))
        }
        nanos = ns
      }
    } else if spec == 122 {
      // %z / %:z
      if ii < ilen && (input.code_unit_at(ii) == 90 || input.code_unit_at(ii) == 122) {
        off_opt = Some(Offset::utc())
        ii = ii + 1
      } else {
        let _ = has_colon
        match parse_iso_offset_slice(input, ii, ilen) {
          Ok(op) => {
            off_opt = Some(Offset::{ seconds: op.0 })
            ii = op.1
          }
          Err(e) => return Err(e)
        }
      }
    } else if spec == 70 {
      // %F -> %Y-%m-%d
      match parse_date_at_slice(input, ii, ilen) {
        Ok(dp) => {
          year = dp.0.year
          month = dp.0.month
          day = dp.0.day
          has_year = true
          ii = dp.1
        }
        Err(e) => return Err(e)
      }
    } else if spec == 84 {
      // %T -> %H:%M:%S
      match parse_time_flex_at(input, ii, ilen, true, false, false, false) {
        Ok(tp) => {
          hour = tp.0.hour
          minute = tp.0.minute
          second = tp.0.second
          nanos = tp.0.nanosecond
          ii = tp.1
        }
        Err(e) => return Err(e)
      }
    } else if spec == 82 {
      // %R -> %H:%M
      match parse_time_at(input, ii, false) {
        Ok(tp) => {
          hour = tp.0.hour
          minute = tp.0.minute
          ii = tp.1
        }
        Err(e) => return Err(e)
      }
    } else if spec == 110 || spec == 116 {
      ii = skip_ws(input, ii)
    } else {
      return Err(TimeError::new("STRPTIME", "unsupported strptime specifier"))
    }
  }
  if ii != ilen {
    return Err(TimeError::new("STRPTIME", "trailing input after format"))
  }
  if !has_year {
    return Err(TimeError::new("STRPTIME", "missing year"))
  }
  if hour12 >= 0 {
    if ampm == 1 {
      hour = if hour12 == 12 { 0 } else { hour12 }
    } else if ampm == 2 {
      hour = if hour12 == 12 { 12 } else { hour12 + 12 }
    } else {
      hour = hour12 % 12
    }
  }
  let d = match Date::new(year, month, day) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match parsed_wd {
    Some(w) =>
    if !weekday_eq(w, d.weekday()) {
      return Err(TimeError::new("INCONSISTENT_WEEKDAY", "weekday does not match date"))
    }
    None => ()
  }
  let t = match Time::new(hour, minute, second, nanos) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  Ok((DateTime::{ date: d, time: t }, off_opt))
}

///|
pub fn strptime(fmt : String, input : String) -> Result[DateTime, TimeError] {
  match strptime_core(fmt, input) {
    Ok(pair) => Ok(pair.0)
    Err(e) => Err(e)
  }
}

///|
pub fn strptime_fixed(fmt : String, input : String) -> Result[FixedDateTime, TimeError] {
  match strptime_core(fmt, input) {
    Ok(pair) =>
    match pair.1 {
      Some(off) => Ok(FixedDateTime::{ datetime: pair.0, offset: off })
      None => Err(TimeError::new("STRPTIME", "missing offset for strptime_fixed"))
    }
    Err(e) => Err(e)
  }
}
