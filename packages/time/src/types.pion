///| Core value types and error definitions for the `time` package.

///|
pub struct TimeError {
  pub code : String
  pub message : String
}

///|
pub fn TimeError::new(code : String, message : String) -> TimeError {
  TimeError::{ code: code, message: message }
}

///|
pub enum Weekday {
  Mon
  Tue
  Wed
  Thu
  Fri
  Sat
  Sun
}

///|
pub val struct Date {
  pub year : Int
  pub month : Int
  pub day : Int
}

///|
pub val struct Time {
  pub hour : Int
  pub minute : Int
  pub second : Int
  pub nanosecond : Int
}

///|
pub val struct DateTime {
  pub date : Date
  pub time : Time
}

///|
pub val struct Offset {
  pub seconds : Int
}

///|
pub val struct Timestamp {
  pub secs : Int64
  pub nanos : Int
}

///|
pub val struct SignedDuration {
  pub secs : Int64
  pub nanos : Int
}

///|
pub val struct IsoWeekDate {
  pub year : Int
  pub week : Int
  pub weekday : Weekday
}

///|
pub val struct FixedDateTime {
  pub datetime : DateTime
  pub offset : Offset
}

///|
pub val struct IsoDuration {
  pub negative : Bool
  pub years : Int
  pub months : Int
  pub weeks : Int
  pub days : Int
  pub hours : Int
  pub minutes : Int
  pub seconds : Int64
  pub nanoseconds : Int
}

///|
pub fn stub_err() -> TimeError {
  TimeError::{ code: "UNIMPLEMENTED", message: "not implemented yet" }
}
