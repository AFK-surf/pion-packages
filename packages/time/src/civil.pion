///|
pub fn DateTime::min() -> DateTime {
  DateTime::{ date: Date::min(), time: Time::min() }
}

///|
pub fn DateTime::max() -> DateTime {
  DateTime::{ date: Date::max(), time: Time::max() }
}

///|
pub fn DateTime::new(
  year : Int,
