) -> Result[DateTime, TimeError] {
  let _ = year
  let _ = month
  let _ = day
  let _ = hour
  let _ = minute
  let _ = second
  let _ = nanosecond
  Err(stub_err())
}

///|
pub fn DateTime::from_parts(date : Date, time : Time) -> DateTime {
  DateTime::{ date: date, time: time }
}

///|
pub fn DateTime::start_of_day(self : DateTime) -> DateTime {
  DateTime::{ date: self.date, time: Time::midnight() }
}

///|
pub fn DateTime::end_of_day(self : DateTime) -> DateTime {
  DateTime::{ date: self.date, time: Time::max() }
}

