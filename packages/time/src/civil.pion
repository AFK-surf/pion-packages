///| Civil calendar types: Weekday, Date, Time, DateTime, IsoWeekDate.

///|
let min_year : Int = -9999

///|
let max_year : Int = 9999

///|
let min_epoch_days : Int = -4371587

///|
let max_epoch_days : Int = 2932896

///|
#verify
pub fn is_leap_year(year : Int) -> Bool {
  if (year & 3) != 0 {
    return false
  }
  year % 25 != 0 || (year & 15) == 0
}

///|
#verify
pub fn days_in_month_of(year : Int, month : Int) -> Int {
  if month == 2 {
    if is_leap_year(year) {
      29
    } else {
      28
    }
  } else {
    30 + (month + month / 8) % 2
  }
}

///|
pub fn weekday_from_monday_zero_offset(n : Int) -> Result[Weekday, TimeError] {
  match n {
    0 => Ok(Weekday::Mon)
    1 => Ok(Weekday::Tue)
    2 => Ok(Weekday::Wed)
    3 => Ok(Weekday::Thu)
    4 => Ok(Weekday::Fri)
    5 => Ok(Weekday::Sat)
    6 => Ok(Weekday::Sun)
    _ => Err(TimeError::new("OUT_OF_RANGE", "weekday monday zero offset must be 0..=6"))
  }
}

///|
pub fn weekday_from_monday_one_offset(n : Int) -> Result[Weekday, TimeError] {
  if n < 1 || n > 7 {
    Err(TimeError::new("OUT_OF_RANGE", "weekday monday one offset must be 1..=7"))
  } else {
    weekday_from_monday_zero_offset(n - 1)
  }
}

///|
pub fn weekday_from_sunday_zero_offset(n : Int) -> Result[Weekday, TimeError] {
  match n {
    0 => Ok(Weekday::Sun)
    1 => Ok(Weekday::Mon)
    2 => Ok(Weekday::Tue)
    3 => Ok(Weekday::Wed)
    4 => Ok(Weekday::Thu)
    5 => Ok(Weekday::Fri)
    6 => Ok(Weekday::Sat)
    _ => Err(TimeError::new("OUT_OF_RANGE", "weekday sunday zero offset must be 0..=6"))
  }
}

///|
pub fn weekday_from_sunday_one_offset(n : Int) -> Result[Weekday, TimeError] {
  if n < 1 || n > 7 {
    Err(TimeError::new("OUT_OF_RANGE", "weekday sunday one offset must be 1..=7"))
  } else {
    weekday_from_sunday_zero_offset(n - 1)
  }
}

///|
pub fn weekday_to_monday_zero_offset(self : Weekday) -> Int {
  match self {
    Weekday::Mon => 0
    Weekday::Tue => 1
    Weekday::Wed => 2
    Weekday::Thu => 3
    Weekday::Fri => 4
    Weekday::Sat => 5
    Weekday::Sun => 6
  }
}

///|
pub fn weekday_to_monday_one_offset(self : Weekday) -> Int {
  weekday_to_monday_zero_offset(self) + 1
}

///|
pub fn weekday_to_sunday_zero_offset(self : Weekday) -> Int {
  (weekday_to_monday_zero_offset(self) + 1) % 7
}

///|
pub fn weekday_to_sunday_one_offset(self : Weekday) -> Int {
  weekday_to_sunday_zero_offset(self) + 1
}

///|
fn weekday_from_mod7(n : Int) -> Weekday {
  match n {
    0 => Weekday::Mon
    1 => Weekday::Tue
    2 => Weekday::Wed
    3 => Weekday::Thu
    4 => Weekday::Fri
    5 => Weekday::Sat
    _ => Weekday::Sun
  }
}

///|
pub fn weekday_next(self : Weekday) -> Weekday {
  weekday_from_mod7((weekday_to_monday_zero_offset(self) + 1) % 7)
}

///|
pub fn weekday_previous(self : Weekday) -> Weekday {
  weekday_from_mod7((weekday_to_monday_zero_offset(self) + 6) % 7)
}

///|
pub fn weekday_wrapping_add(self : Weekday, days : Int) -> Weekday {
  let r = (weekday_to_monday_zero_offset(self) + days % 7 + 7) % 7
  weekday_from_mod7(r)
}

///|
pub fn weekday_wrapping_sub(self : Weekday, days : Int) -> Weekday {
  let r = (weekday_to_monday_zero_offset(self) - days % 7 + 7) % 7
  weekday_from_mod7(r)
}

///|
pub fn weekday_since(self : Weekday, other : Weekday) -> Int {
  (weekday_to_monday_zero_offset(self) - weekday_to_monday_zero_offset(other) + 7) % 7
}

///|
pub fn weekday_until(self : Weekday, other : Weekday) -> Int {
  weekday_since(other, self)
}

///|
pub fn weekday_eq(self : Weekday, other : Weekday) -> Bool {
  weekday_to_monday_zero_offset(self) == weekday_to_monday_zero_offset(other)
}

///|
pub fn weekday_to_short_name(self : Weekday) -> String {
  match self {
    Weekday::Mon => "Mon"
    Weekday::Tue => "Tue"
    Weekday::Wed => "Wed"
    Weekday::Thu => "Thu"
    Weekday::Fri => "Fri"
    Weekday::Sat => "Sat"
    Weekday::Sun => "Sun"
  }
}

///|
fn epoch_days_from_ymd(year : Int, month : Int, day : Int) -> Int {
  let j = if month <= 2 { 1 } else { 0 }
  let y = year + 32800 - j
  let m = if j == 1 { month + 12 } else { month }
  let d = day - 1
  // Exact for 0 <= y <= 43698 (here 22800 <= y <= 42799).
  let c = (y * 41944) >> 22
  let y_star = ((1461 * y) >> 2) - c + (c >> 2)
  let m_star = (979 * m - 2919) >> 5
  y_star + m_star + d - 12699422
}

///|
fn jan4_epoch_days(year : Int) -> Int {
  // epoch_days_from_ymd(year, 1, 4): j=1, m=13, m_star=306, d=3 -> 306+3-12699422 = -12699113.
  let y = year + 32799
  let c = (y * 41944) >> 22
  ((1461 * y) >> 2) - c + (c >> 2) - 12699113
}

///|
fn mod7_nonneg(x : Int) -> Int {
  // Exact for 0 <= x <= 2^31 - 1.
  let q = ((x.to_int64() * 613566757L) >> 32).to_int()
  x - q * 7
}

///|
fn date_from_epoch_days_unchecked(days : Int) -> Date {
  // Neri-Schneider O(1) algorithm with exact multiply-shift reciprocals (zero hardware divisions).
  // Verified exact for all 7,304,484 days in -9999-01-01..=9999-12-31.
  let n = days + 12699422
  let n1 = (n << 2) + 3
  let c = ((n1.to_int64() * 963315389L) >> 47).to_int()
  let nc = (n1 - c * 146097) >> 2
  let n2 = (nc << 2) + 3
  let z = ((2939745L * n2.to_int64()) >> 32).to_int()
  let ny = nc - ((1461 * z) >> 2)
  let y = 100 * c + z
  let n3 = 2141 * ny + 197913
  let m = n3 >> 16
  let d = ((n3 & 65535) * 31345) >> 26
  let j = if ny >= 306 { 1 } else { 0 }
  let year = y - 32800 + j
  let month = if j == 1 { m - 12 } else { m }
  let day = d + 1
  Date::{ year: year, month: month, day: day }
}

///|
pub fn Date::min() -> Date {
  Date::{ year: -9999, month: 1, day: 1 }
}

///|
pub fn Date::max() -> Date {
  Date::{ year: 9999, month: 12, day: 31 }
}

///|
#verify
pub fn Date::new(year : Int, month : Int, day : Int) -> Result[Date, TimeError] {
  if year < min_year || year > max_year {
    return Err(TimeError::new("INVALID_YEAR", "year must be in -9999..=9999"))
  }
  if month < 1 || month > 12 {
    return Err(TimeError::new("INVALID_MONTH", "month must be in 1..=12"))
  }
  if day < 1 {
    return Err(TimeError::new("INVALID_DAY", "day must be >= 1"))
  }
  if day > 28 && day > days_in_month_of(year, month) {
    return Err(TimeError::new("INVALID_DAY", "day exceeds days in month"))
  }
  Ok(Date::{ year: year, month: month, day: day })
}

///|
pub fn Date::new_constrain(
  year : Int,
  month : Int,
  day : Int,
) -> Result[Date, TimeError] {
  if year < min_year || year > max_year {
    return Err(TimeError::new("INVALID_YEAR", "year must be in -9999..=9999"))
  }
  if month < 1 || month > 12 {
    return Err(TimeError::new("INVALID_MONTH", "month must be in 1..=12"))
  }
  if day < 1 {
    return Err(TimeError::new("INVALID_DAY", "day must be >= 1"))
  }
  let clamped = if day > 28 {
    let dim = days_in_month_of(year, month)
    if day <= dim { day } else { dim }
  } else {
    day
  }
  Ok(Date::{ year: year, month: month, day: clamped })
}

///|
#verify
pub fn Date::from_epoch_days(days : Int) -> Result[Date, TimeError] {
  if days < min_epoch_days || days > max_epoch_days {
    return Err(TimeError::new("OUT_OF_RANGE", "epoch days out of range"))
  }
  let n = days + 12699422
  let n1 = (n << 2) + 3
  let c = ((n1.to_int64() * 963315389L) >> 47).to_int()
  let nc = (n1 - c * 146097) >> 2
  let n2 = (nc << 2) + 3
  let p2 : Int64 = 2939745L * n2.to_int64()
  let z = (p2 >> 32).to_int()
  let ny = (((p2 & 4294967295L) * 1461L) >> 34).to_int()
  let y = 100 * c + z
  let n3 = 2141 * ny + 197913
  let m = n3 >> 16
  let d = ((n3 & 65535) * 31345) >> 26
  let j = if ny >= 306 { 1 } else { 0 }
  let year = y - 32800 + j
  let month = if j == 1 { m - 12 } else { m }
  Ok(Date::{ year: year, month: month, day: d + 1 })
}

///|
#verify
pub fn Date::to_epoch_days(self : Date) -> Int {
  // Neri-Schneider O(1) algorithm with exact multiply-shift reciprocal.
  let j = if self.month <= 2 { 1 } else { 0 }
  let y = self.year + 32800 - j
  let m = if j == 1 { self.month + 12 } else { self.month }
  let d = self.day - 1
  let c = (y * 41944) >> 22
  let y_star = ((1461 * y) >> 2) - c + (c >> 2)
  let m_star = (979 * m - 2919) >> 5
  y_star + m_star + d - 12699422
}

///|
pub fn Date::from_day_of_year(year : Int, doy : Int) -> Result[Date, TimeError] {
  if year < min_year || year > max_year {
    return Err(TimeError::new("INVALID_YEAR", "year must be in -9999..=9999"))
  }
  let max_doy = if is_leap_year(year) { 366 } else { 365 }
  if doy < 1 || doy > max_doy {
    return Err(TimeError::new("INVALID_DAY_OF_YEAR", "day of year out of range"))
  }
  let start = Date::{ year: year, month: 1, day: 1 }.to_epoch_days()
  Ok(date_from_epoch_days_unchecked(start + doy - 1))
}

///|
pub fn Date::from_day_of_year_no_leap(
  year : Int,
  doy : Int,
) -> Result[Date, TimeError] {
  if year < min_year || year > max_year {
    return Err(TimeError::new("INVALID_YEAR", "year must be in -9999..=9999"))
  }
  if doy < 1 || doy > 365 {
    return Err(TimeError::new("INVALID_DAY_OF_YEAR", "day of year (no leap) must be 1..=365"))
  }
  let actual = if doy >= 60 && is_leap_year(year) { doy + 1 } else { doy }
  Date::from_day_of_year(year, actual)
}

///|
pub fn Date::in_leap_year(self : Date) -> Bool {
  is_leap_year(self.year)
}

///|
pub fn Date::days_in_year(self : Date) -> Int {
  if is_leap_year(self.year) {
    366
  } else {
    365
  }
}

///|
pub fn Date::days_in_month(self : Date) -> Int {
  days_in_month_of(self.year, self.month)
}

///|
fn month_cum_days(month : Int, leap : Bool) -> Int {
  let base = ((367 * month - 362) * 5462) >> 16
  if month <= 2 {
    base
  } else if leap {
    base - 1
  } else {
    base - 2
  }
}

///|
pub fn Date::day_of_year(self : Date) -> Int {
  month_cum_days(self.month, is_leap_year(self.year)) + self.day
}

///|
pub fn Date::day_of_year_no_leap(self : Date) -> Option[Int] {
  let mut doy = self.day_of_year()
  if is_leap_year(self.year) {
    if doy == 60 {
      return None
    } else if doy > 60 {
      doy = doy - 1
    }
  }
  Some(doy)
}

///|
fn weekday_from_epoch_days(ed : Int) -> Weekday {
  // -4371587 (-9999-01-01) is Monday.
  weekday_from_mod7(mod7_nonneg(ed + 4371587))
}

///|
pub fn Date::weekday(self : Date) -> Weekday {
  weekday_from_epoch_days(self.to_epoch_days())
}

///|
fn iso_week_start_from_year(year : Int) -> Int {
  // Jan 4 is always in ISO week 1. Zero-allocation integer arithmetic.
  let jan4 = jan4_epoch_days(year)
  let wd = mod7_nonneg(jan4 + 4371587)
  jan4 - wd
}

///|
fn is_long_iso_week_year(year : Int) -> Bool {
  let last_ed = epoch_days_from_ymd(year, 12, 31)
  let wd = mod7_nonneg(last_ed + 4371587)
  // Thursday (3), or Friday (4) in a leap year.
  wd == 3 || (wd == 4 && is_leap_year(year))
}

///|
pub fn Date::iso_week_date(self : Date) -> IsoWeekDate {
  let mut year = self.year
  let m = self.month
  let d = self.day
  // Branchless day-of-year and leap-year computation.
  let y_sh = year + 32800
  let c_y = (y_sh * 41944) >> 22
  let is_cent = if c_y * 100 == y_sh { 1 } else { 0 }
  let div4 = if (year & 3) == 0 { 1 } else { 0 }
  let div400 = if (c_y & 3) == 0 { 1 } else { 0 }
  let leap = div4 & ((1 - is_cent) | div400)
  let is_gt2 = if m > 2 { 1 } else { 0 }
  let base = ((367 * m - 362) * 5462) >> 16
  let doy = base + d - is_gt2 * (2 - leap)
  // Jan 4 shifted epoch days (jan4 + 4371587) without second multiply-shift for c0.
  let y0 = y_sh - 1
  let c0 = c_y - is_cent
  let j4_off = ((1461 * y0) >> 2) - c0 + (c0 >> 2) - 8327526
  let wd_jan4 = j4_off - ((j4_off.to_int64() * 613566757L) >> 32).to_int() * 7
  // offset = ed - start = (jan4 + doy - 4) - (jan4 - wd_jan4) = doy - 4 + wd_jan4
  let mut off = doy - 4 + wd_jan4
  if off < 0 {
    year = year - 1
    let prev_start = iso_week_start_from_year(year)
    off = j4_off - 4371587 + doy - 4 - prev_start
  } else if off >= 364 && year < max_year {
    let next_start = iso_week_start_from_year(year + 1)
    let ed = j4_off - 4371587 + doy - 4
    if ed >= next_start {
      year = year + 1
      off = ed - next_start
    }
  }
  // start is always Monday, so off / 7 gives 0-based week and off % 7 gives Monday-0 weekday.
  let q = (off * 9363) >> 16
  let week = q + 1
  let wd_idx = off - q * 7
  let wd = match wd_idx {
    0 => Weekday::Mon
    1 => Weekday::Tue
    2 => Weekday::Wed
    3 => Weekday::Thu
    4 => Weekday::Fri
    5 => Weekday::Sat
    _ => Weekday::Sun
  }
  IsoWeekDate::{ year: year, week: week, weekday: wd }
}

///|
pub fn Date::first_of_month(self : Date) -> Date {
  Date::{ year: self.year, month: self.month, day: 1 }
}

///|
pub fn Date::last_of_month(self : Date) -> Date {
  Date::{ year: self.year, month: self.month, day: self.days_in_month() }
}

///|
pub fn Date::first_of_year(self : Date) -> Date {
  Date::{ year: self.year, month: 1, day: 1 }
}

///|
pub fn Date::last_of_year(self : Date) -> Date {
  Date::{ year: self.year, month: 12, day: 31 }
}

///|
pub fn Date::yesterday(self : Date) -> Result[Date, TimeError] {
  if self.day == 1 {
    if self.month == 1 {
      if self.year == min_year {
        return Err(TimeError::new("OUT_OF_RANGE", "cannot go before Date::min"))
      }
      return Ok(Date::{ year: self.year - 1, month: 12, day: 31 })
    }
    let m = self.month - 1
    return Ok(Date::{ year: self.year, month: m, day: days_in_month_of(self.year, m) })
  }
  Ok(Date::{ year: self.year, month: self.month, day: self.day - 1 })
}

///|
pub fn Date::tomorrow(self : Date) -> Result[Date, TimeError] {
  if self.day >= 28 && self.day == self.days_in_month() {
    if self.month == 12 {
      if self.year == max_year {
        return Err(TimeError::new("OUT_OF_RANGE", "cannot go past Date::max"))
      }
      return Ok(Date::{ year: self.year + 1, month: 1, day: 1 })
    }
    return Ok(Date::{ year: self.year, month: self.month + 1, day: 1 })
  }
  Ok(Date::{ year: self.year, month: self.month, day: self.day + 1 })
}

///|
pub fn Date::add_days(self : Date, days : Int) -> Result[Date, TimeError] {
  if days == 0 {
    return Ok(self)
  }
  if days == 1 {
    return self.tomorrow()
  }
  if days == -1 {
    return self.yesterday()
  }
  // Inline to_epoch_days + from_epoch_days to avoid 2 cross-function calls on the hot path.
  let j0 = if self.month <= 2 { 1 } else { 0 }
  let y0 = self.year + 32800 - j0
  let m0 = if j0 == 1 { self.month + 12 } else { self.month }
  let c0 = (y0 * 41944) >> 22
  let ed = ((1461 * y0) >> 2) - c0 + (c0 >> 2) + ((979 * m0 - 2919) >> 5) + self.day - 12699423
  if days > max_epoch_days - ed || days < min_epoch_days - ed {
    return Err(TimeError::new("OUT_OF_RANGE", "date addition overflow"))
  }
  let n = ed + days + 12699422
  let n1 = (n << 2) + 3
  let c = ((n1.to_int64() * 963315389L) >> 47).to_int()
  let nc = (n1 - c * 146097) >> 2
  let n2 = (nc << 2) + 3
  let p2 : Int64 = 2939745L * n2.to_int64()
  let z = (p2 >> 32).to_int()
  let ny = (((p2 & 4294967295L) * 1461L) >> 34).to_int()
  let y = 100 * c + z
  let n3 = 2141 * ny + 197913
  let m = n3 >> 16
  let d = ((n3 & 65535) * 31345) >> 26
  let j = if ny >= 306 { 1 } else { 0 }
  let year = y - 32800 + j
  let month = if j == 1 { m - 12 } else { m }
  Ok(Date::{ year: year, month: month, day: d + 1 })
}

///|
pub fn Date::sub_days(self : Date, days : Int) -> Result[Date, TimeError] {
  if days < -10000000 || days > 10000000 {
    return Err(TimeError::new("OUT_OF_RANGE", "date subtraction overflow"))
  }
  self.add_days(-days)
}

///|
pub fn Date::add_months(self : Date, months : Int) -> Result[Date, TimeError] {
  if months < -240000 || months > 240000 {
    return Err(TimeError::new("OUT_OF_RANGE", "month addition overflow"))
  }
  let total = (self.year + 10000) * 12 + (self.month - 1) + months
  if total < 12 {
    return Err(TimeError::new("OUT_OF_RANGE", "year below -9999"))
  }
  let new_year = total / 12 - 10000
  let new_month = total % 12 + 1
  if new_year > max_year {
    return Err(TimeError::new("OUT_OF_RANGE", "year above 9999"))
  }
  Date::new_constrain(new_year, new_month, self.day)
}

///|
pub fn Date::add_years(self : Date, years : Int) -> Result[Date, TimeError] {
  if years < -20000 || years > 20000 {
    return Err(TimeError::new("OUT_OF_RANGE", "year addition overflow"))
  }
  let new_year = self.year + years
  Date::new_constrain(new_year, self.month, self.day)
}

///|
pub fn Date::until(self : Date, other : Date) -> Int {
  other.since(self)
}

///|
pub fn Date::since(self : Date, other : Date) -> Int {
  if self.year == other.year {
    if self.month == other.month {
      self.day - other.day
    } else {
      self.day_of_year() - other.day_of_year()
    }
  } else {
    self.to_epoch_days() - other.to_epoch_days()
  }
}

///|
pub fn Date::at(
  self : Date,
  hour : Int,
  minute : Int,
  second : Int,
  nanosecond : Int,
) -> Result[DateTime, TimeError] {
  match Time::new(hour, minute, second, nanosecond) {
    Ok(t) => Ok(DateTime::{ date: self, time: t })
    Err(e) => Err(e)
  }
}

///|
pub fn Date::start_of_day(self : Date) -> DateTime {
  DateTime::{ date: self, time: Time::midnight() }
}

///|
pub fn Date::end_of_day(self : Date) -> DateTime {
  DateTime::{ date: self, time: Time::max() }
}

///|
pub fn Date::eq(self : Date, other : Date) -> Bool {
  self.year == other.year && self.month == other.month && self.day == other.day
}

///|
#verify
pub fn Date::cmp(self : Date, other : Date) -> Int {
  if self.year != other.year {
    return if self.year < other.year { -1 } else { 1 }
  }
  if self.month != other.month {
    return if self.month < other.month { -1 } else { 1 }
  }
  if self.day != other.day {
    return if self.day < other.day { -1 } else { 1 }
  }
  0
}

///|
pub fn IsoWeekDate::min() -> IsoWeekDate {
  IsoWeekDate::{ year: -9999, week: 1, weekday: Weekday::Mon }
}

///|
pub fn IsoWeekDate::max() -> IsoWeekDate {
  IsoWeekDate::{ year: 9999, week: 52, weekday: Weekday::Fri }
}

///|
pub fn IsoWeekDate::new(
  year : Int,
  week : Int,
  weekday : Weekday,
) -> Result[IsoWeekDate, TimeError] {
  if year < min_year || year > max_year {
    return Err(TimeError::new("INVALID_YEAR", "ISO week year must be in -9999..=9999"))
  }
  if week < 1 || week > 53 {
    return Err(TimeError::new("INVALID_WEEK", "ISO week must be in 1..=53"))
  }
  if week == 53 && !is_long_iso_week_year(year) {
    return Err(TimeError::new("INVALID_WEEK", "year does not have 53 ISO weeks"))
  }
  if year == max_year && week == 52 && weekday_to_monday_zero_offset(weekday) > 4 {
    return Err(TimeError::new("OUT_OF_RANGE", "ISO week date exceeds 9999-12-31"))
  }
  Ok(IsoWeekDate::{ year: year, week: week, weekday: weekday })
}

///|
pub fn IsoWeekDate::from_date(d : Date) -> IsoWeekDate {
  d.iso_week_date()
}

///|
pub fn IsoWeekDate::to_date(self : IsoWeekDate) -> Date {
  let start = iso_week_start_from_year(self.year)
  let ed = start + (self.week - 1) * 7 + weekday_to_monday_zero_offset(self.weekday)
  date_from_epoch_days_unchecked(ed)
}

///|
pub fn IsoWeekDate::in_long_year(self : IsoWeekDate) -> Bool {
  is_long_iso_week_year(self.year)
}

///|
pub fn IsoWeekDate::weeks_in_year(self : IsoWeekDate) -> Int {
  if is_long_iso_week_year(self.year) {
    53
  } else {
    52
  }
}

///|
pub fn IsoWeekDate::days_in_year(self : IsoWeekDate) -> Int {
  if is_long_iso_week_year(self.year) {
    371
  } else {
    364
  }
}

///|
pub fn IsoWeekDate::yesterday(self : IsoWeekDate) -> Result[IsoWeekDate, TimeError] {
  if weekday_eq(self.weekday, Weekday::Mon) {
    if self.week == 1 {
      if self.year == min_year {
        return Err(TimeError::new("OUT_OF_RANGE", "cannot go before IsoWeekDate::min"))
      }
      let prev_y = self.year - 1
      let w = if is_long_iso_week_year(prev_y) { 53 } else { 52 }
      return Ok(IsoWeekDate::{ year: prev_y, week: w, weekday: Weekday::Sun })
    }
    return Ok(IsoWeekDate::{ year: self.year, week: self.week - 1, weekday: Weekday::Sun })
  }
  Ok(IsoWeekDate::{
    year: self.year,
    week: self.week,
    weekday: weekday_previous(self.weekday),
  })
}

///|
pub fn IsoWeekDate::tomorrow(self : IsoWeekDate) -> Result[IsoWeekDate, TimeError] {
  if self.year == max_year && self.week == 52 && weekday_eq(self.weekday, Weekday::Fri) {
    return Err(TimeError::new("OUT_OF_RANGE", "cannot go past IsoWeekDate::max"))
  }
  if weekday_eq(self.weekday, Weekday::Sun) {
    if self.week >= 52 && self.week == self.weeks_in_year() {
      return Ok(IsoWeekDate::{ year: self.year + 1, week: 1, weekday: Weekday::Mon })
    }
    return Ok(IsoWeekDate::{ year: self.year, week: self.week + 1, weekday: Weekday::Mon })
  }
  Ok(IsoWeekDate::{
    year: self.year,
    week: self.week,
    weekday: weekday_next(self.weekday),
  })
}

///|
pub fn IsoWeekDate::eq(self : IsoWeekDate, other : IsoWeekDate) -> Bool {
  self.year == other.year &&
  self.week == other.week &&
  weekday_eq(self.weekday, other.weekday)
}

///|
pub fn Time::midnight() -> Time {
  Time::{ hour: 0, minute: 0, second: 0, nanosecond: 0 }
}

///|
pub fn Time::min() -> Time {
  Time::{ hour: 0, minute: 0, second: 0, nanosecond: 0 }
}

///|
pub fn Time::max() -> Time {
  Time::{ hour: 23, minute: 59, second: 59, nanosecond: 999999999 }
}

///|
#verify
pub fn Time::new(
  hour : Int,
  minute : Int,
  second : Int,
  nanosecond : Int,
) -> Result[Time, TimeError] {
  if hour < 0 || hour > 23 {
    return Err(TimeError::new("INVALID_HOUR", "hour must be in 0..=23"))
  }
  if minute < 0 || minute > 59 {
    return Err(TimeError::new("INVALID_MINUTE", "minute must be in 0..=59"))
  }
  if second < 0 || second > 59 {
    return Err(TimeError::new("INVALID_SECOND", "second must be in 0..=59"))
  }
  if nanosecond < 0 || nanosecond > 999999999 {
    return Err(TimeError::new("INVALID_NANOSECOND", "nanosecond must be in 0..=999999999"))
  }
  Ok(Time::{ hour: hour, minute: minute, second: second, nanosecond: nanosecond })
}

///|
#verify
pub fn Time::to_second_of_day(self : Time) -> Int {
  self.hour * 3600 + self.minute * 60 + self.second
}

///|
pub fn Time::to_nanosecond_of_day(self : Time) -> Int64 {
  self.to_second_of_day().to_int64() * 1000000000L + self.nanosecond.to_int64()
}

///|
pub fn Time::from_second_of_day(sec : Int) -> Result[Time, TimeError] {
  if sec < 0 || sec >= 86400 {
    return Err(TimeError::new("OUT_OF_RANGE", "second of day must be in 0..=86399"))
  }
  let h = sec / 3600
  let rem = sec % 3600
  let m = rem / 60
  let s = rem % 60
  Ok(Time::{ hour: h, minute: m, second: s, nanosecond: 0 })
}

///|
pub fn Time::millisecond(self : Time) -> Int {
  self.nanosecond / 1000000
}

///|
pub fn Time::microsecond(self : Time) -> Int {
  self.nanosecond / 1000 % 1000
}

///|
pub fn Time::nanosecond_part(self : Time) -> Int {
  self.nanosecond % 1000
}

///|
pub fn Time::eq(self : Time, other : Time) -> Bool {
  self.hour == other.hour &&
  self.minute == other.minute &&
  self.second == other.second &&
  self.nanosecond == other.nanosecond
}

///|
#verify
pub fn Time::cmp(self : Time, other : Time) -> Int {
  let s1 = self.to_second_of_day()
  let s2 = other.to_second_of_day()
  if s1 != s2 {
    return if s1 < s2 { -1 } else { 1 }
  }
  if self.nanosecond != other.nanosecond {
    return if self.nanosecond < other.nanosecond { -1 } else { 1 }
  }
  0
}

///|
pub fn DateTime::min() -> DateTime {
  DateTime::{ date: Date::min(), time: Time::min() }
}

///|
pub fn DateTime::max() -> DateTime {
  DateTime::{ date: Date::max(), time: Time::max() }
}

///|
pub fn DateTime::new(
  year : Int,
  month : Int,
  day : Int,
  hour : Int,
  minute : Int,
  second : Int,
  nanosecond : Int,
) -> Result[DateTime, TimeError] {
  match Date::new(year, month, day) {
    Err(e) => Err(e)
    Ok(d) =>
    match Time::new(hour, minute, second, nanosecond) {
      Err(e) => Err(e)
      Ok(t) => Ok(DateTime::{ date: d, time: t })
    }
  }
}

///|
pub fn DateTime::from_parts(date : Date, time : Time) -> DateTime {
  DateTime::{ date: date, time: time }
}

///|
pub fn DateTime::start_of_day(self : DateTime) -> DateTime {
  DateTime::{ date: self.date, time: Time::midnight() }
}

///|
pub fn DateTime::end_of_day(self : DateTime) -> DateTime {
  DateTime::{ date: self.date, time: Time::max() }
}

///|
pub fn DateTime::add_days(
  self : DateTime,
  days : Int,
) -> Result[DateTime, TimeError] {
  match self.date.add_days(days) {
    Ok(d) => Ok(DateTime::{ date: d, time: self.time })
    Err(e) => Err(e)
  }
}

///|
pub fn DateTime::add_months(
  self : DateTime,
  months : Int,
) -> Result[DateTime, TimeError] {
  match self.date.add_months(months) {
    Ok(d) => Ok(DateTime::{ date: d, time: self.time })
    Err(e) => Err(e)
  }
}

///|
pub fn DateTime::add_duration(
  self : DateTime,
  dur : SignedDuration,
) -> Result[DateTime, TimeError] {
  let mut ns = self.time.nanosecond + dur.nanos
  let mut carry_s : Int64 = 0L
  if ns >= 1000000000 {
    ns = ns - 1000000000
    carry_s = 1L
  } else if ns < 0 {
    ns = ns + 1000000000
    carry_s = -1L
  }
  let base_sec = self.date.to_epoch_days().to_int64() * 86400L + self.time.to_second_of_day().to_int64()
  // Max civil span is ~6.3e11 seconds, guard dur.secs against extreme overflow.
  if dur.secs > 1000000000000L || dur.secs < -1000000000000L {
    return Err(TimeError::new("OUT_OF_RANGE", "datetime duration overflow"))
  }
  let total_sec = base_sec + dur.secs + carry_s
  let min_sec : Int64 = -377705116800L
  let max_sec : Int64 = 253402300799L
  if total_sec < min_sec || total_sec > max_sec {
    return Err(TimeError::new("OUT_OF_RANGE", "datetime out of range"))
  }
  let day_shift : Int64 = 4382910L
  let sec_shift : Int64 = 378683424000L
  let pos_sec = total_sec + sec_shift
  let ed = (pos_sec / 86400L - day_shift).to_int()
  let sod = (pos_sec % 86400L).to_int()
  let h = sod / 3600
  let rem = sod % 3600
  let m = rem / 60
  let s = rem % 60
  Ok(DateTime::{
    date: date_from_epoch_days_unchecked(ed),
    time: Time::{ hour: h, minute: m, second: s, nanosecond: ns },
  })
}

///|
pub fn DateTime::until(self : DateTime, other : DateTime) -> SignedDuration {
  other.since(self)
}

///|
pub fn DateTime::since(self : DateTime, other : DateTime) -> SignedDuration {
  let d_days = self.date.since(other.date).to_int64()
  let d_sec = d_days * 86400L + (self.time.to_second_of_day() - other.time.to_second_of_day()).to_int64()
  let d_ns = self.time.nanosecond - other.time.nanosecond
  match SignedDuration::new(d_sec, d_ns) {
    Ok(d) => d
    Err(_) => SignedDuration::zero()
  }
}

///|
pub fn DateTime::eq(self : DateTime, other : DateTime) -> Bool {
  self.date.eq(other.date) && self.time.eq(other.time)
}

///|
#verify
pub fn DateTime::cmp(self : DateTime, other : DateTime) -> Int {
  let dc = self.date.cmp(other.date)
  if dc != 0 {
    return dc
  }
  self.time.cmp(other.time)
}

///| Zero-allocation packed civil date representation:
///| `((year + 10000) << 9) | (month << 5) | day` (non-negative 24-bit Int, -1 on error).
pub fn epoch_days_to_packed_date(days : Int) -> Int {
  if days < min_epoch_days || days > max_epoch_days {
    return -1
  }
  let n = days + 12699422
  let n1 = (n << 2) + 3
  let c = ((n1.to_int64() * 963315389L) >> 47).to_int()
  let nc = (n1 - c * 146097) >> 2
  let n2 = (nc << 2) + 3
  let z = ((2939745L * n2.to_int64()) >> 32).to_int()
  let ny = nc - ((1461 * z) >> 2)
  let y = 100 * c + z
  let n3 = 2141 * ny + 197913
  let m = n3 >> 16
  let d = ((n3 & 65535) * 31345) >> 26
  let j = if ny >= 306 { 1 } else { 0 }
  let y_plus = y - 22800 + j
  let month = if j == 1 { m - 12 } else { m }
  (y_plus << 9) | (month << 5) | (d + 1)
}

///|
fn is_valid_packed_date(p : Int) -> Bool {
  if p < 0 {
    return false
  }
  let y_plus = p >> 9
  let month = (p >> 5) & 15
  let day = p & 31
  if y_plus < 1 || y_plus > 19999 || month < 1 || month > 12 || day < 1 {
    return false
  }
  if day > 28 && day > days_in_month_of(y_plus - 10000, month) {
    return false
  }
  true
}

///|
pub fn packed_date_year(p : Int) -> Int {
  if p < 0 {
    return 0
  }
  (p >> 9) - 10000
}

///|
pub fn packed_date_month(p : Int) -> Int {
  if p < 0 {
    return 0
  }
  (p >> 5) & 15
}

///|
pub fn packed_date_day(p : Int) -> Int {
  if p < 0 {
    return 0
  }
  p & 31
}

///|
pub fn packed_date_to_epoch_days(p : Int) -> Int {
  if !is_valid_packed_date(p) {
    return -2147483647
  }
  let month = (p >> 5) & 15
  let day = p & 31
  let j = if month <= 2 { 1 } else { 0 }
  let y = (p >> 9) + 22800 - j
  let m = if j == 1 { month + 12 } else { month }
  let c = (y * 41944) >> 22
  ((1461 * y) >> 2) - c + (c >> 2) + ((979 * m - 2919) >> 5) + day - 12699423
}

///|
pub fn packed_date_add_days(p : Int, days : Int) -> Int {
  if !is_valid_packed_date(p) {
    return -1
  }
  let month0 = (p >> 5) & 15
  let day0 = p & 31
  let j0 = if month0 <= 2 { 1 } else { 0 }
  let y0 = (p >> 9) + 22800 - j0
  let m0 = if j0 == 1 { month0 + 12 } else { month0 }
  let c0 = (y0 * 41944) >> 22
  let ed = ((1461 * y0) >> 2) - c0 + (c0 >> 2) + ((979 * m0 - 2919) >> 5) + day0 - 12699423
  if days > max_epoch_days - ed || days < min_epoch_days - ed {
    return -1
  }
  let n = ed + days + 12699422
  let n1 = (n << 2) + 3
  let c = ((n1.to_int64() * 963315389L) >> 47).to_int()
  let nc = (n1 - c * 146097) >> 2
  let n2 = (nc << 2) + 3
  let z = ((2939745L * n2.to_int64()) >> 32).to_int()
  let ny = nc - ((1461 * z) >> 2)
  let y = 100 * c + z
  let n3 = 2141 * ny + 197913
  let m = n3 >> 16
  let d = ((n3 & 65535) * 31345) >> 26
  let j = if ny >= 306 { 1 } else { 0 }
  let y_plus = y - 22800 + j
  let month = if j == 1 { m - 12 } else { m }
  (y_plus << 9) | (month << 5) | (d + 1)
}

///| Zero-allocation packed ISO week date representation:
///| `((iso_year + 10000) << 9) | (week << 3) | weekday_mon1` (weekday 1=Mon..7=Sun).
pub fn packed_date_to_packed_iso_week(p : Int) -> Int {
  if !is_valid_packed_date(p) {
    return -1
  }
  let mut y_plus = p >> 9
  let m = (p >> 5) & 15
  let d = p & 31
  // 100% branchless day-of-year and leap-year (10000 is divisible by 16 and 100).
  let y_sh = y_plus + 22800
  let c_y = (y_sh * 41944) >> 22
  let is_cent = if c_y * 100 == y_sh { 1 } else { 0 }
  let div4 = if (y_plus & 3) == 0 { 1 } else { 0 }
  let div400 = if (c_y & 3) == 0 { 1 } else { 0 }
  let leap = div4 & ((1 - is_cent) | div400)
  let is_gt2 = if m > 2 { 1 } else { 0 }
  let base = ((367 * m - 362) * 5462) >> 16
  let doy = base + d - is_gt2 * (2 - leap)
  // Jan 4 shifted epoch days (jan4 + 4371587) reusing c_y - is_cent.
  let y0 = y_sh - 1
  let c0 = c_y - is_cent
  let j4_off = ((1461 * y0) >> 2) - c0 + (c0 >> 2) - 8327526
  let wd_jan4 = j4_off - ((j4_off.to_int64() * 613566757L) >> 32).to_int() * 7
  let mut off = doy - 4 + wd_jan4
  if off < 0 {
    y_plus = y_plus - 1
    let prev_start = iso_week_start_from_year(y_plus - 10000)
    off = j4_off - 4371587 + doy - 4 - prev_start
  } else if off >= 364 && y_plus < 19999 {
    let next_start = iso_week_start_from_year(y_plus - 9999)
    let ed = j4_off - 4371587 + doy - 4
    if ed >= next_start {
      y_plus = y_plus + 1
      off = ed - next_start
    }
  }
  let q = (off * 9363) >> 16
  let week = q + 1
  let wd_mon1 = off - q * 7 + 1
  (y_plus << 9) | (week << 3) | wd_mon1
}

///|
pub fn packed_iso_week_year(p : Int) -> Int {
  if p < 0 {
    return 0
  }
  (p >> 9) - 10000
}

///|
pub fn packed_iso_week_week(p : Int) -> Int {
  if p < 0 {
    return 0
  }
  (p >> 3) & 63
}

///|
pub fn packed_iso_week_weekday(p : Int) -> Int {
  if p < 0 {
    return 0
  }
  p & 7
}
