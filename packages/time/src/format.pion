///| Parsing and formatting: RFC 3339, ISO 8601, RFC 2822, RFC 9110 HTTP-date, ISO 8601 Duration.

///|
fn is_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

///|
fn to_lower_ascii(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

///|
fn is_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

///|
fn parse_2_digits(s : String, pos : Int) -> Int {
  let c0 = s.code_unit_at(pos) - 48
  let c1 = s.code_unit_at(pos + 1) - 48
  if (c0 | (9 - c0) | c1 | (9 - c1)) < 0 {
    return -1
  }
  c0 * 10 + c1
}

///|
fn parse_4_digits(s : String, pos : Int) -> Int {
  let c0 = s.code_unit_at(pos) - 48
  let c1 = s.code_unit_at(pos + 1) - 48
  let c2 = s.code_unit_at(pos + 2) - 48
  let c3 = s.code_unit_at(pos + 3) - 48
  if (c0 | (9 - c0) | c1 | (9 - c1) | c2 | (9 - c2) | c3 | (9 - c3)) < 0 {
    return -1
  }
  c0 * 1000 + c1 * 100 + c2 * 10 + c3
}

///|
fn parse_6_digits(s : String, pos : Int) -> Int {
  let hi = parse_2_digits(s, pos)
  let lo = parse_4_digits(s, pos + 2)
  if hi < 0 || lo < 0 {
    return -1
  }
  hi * 10000 + lo
}

///|
fn write_2d(sb : StringBuilder, v : Int) -> Unit {
  // Exact for 0 <= v <= 99.
  let q = (v * 205) >> 11
  let r = v - q * 10
  sb.write_byte((48 + q).to_byte())
  sb.write_byte((48 + r).to_byte())
}

///|
fn write_4d(sb : StringBuilder, v : Int) -> Unit {
  // Exact for 0 <= v <= 9999.
  let hi = (v * 41944) >> 22
  let lo = v - hi * 100
  let q0 = (hi * 205) >> 11
  let r0 = hi - q0 * 10
  let q1 = (lo * 205) >> 11
  let r1 = lo - q1 * 10
  sb.write_byte((48 + q0).to_byte())
  sb.write_byte((48 + r0).to_byte())
  sb.write_byte((48 + q1).to_byte())
  sb.write_byte((48 + r1).to_byte())
}

///|
fn write_year(sb : StringBuilder, year : Int) -> Unit {
  if year < 0 {
    sb.write_byte((45).to_byte())
    sb.write_byte((48).to_byte())
    sb.write_byte((48).to_byte())
    write_4d(sb, -year)
  } else {
    write_4d(sb, year)
  }
}

///|
fn write_date_to(sb : StringBuilder, d : Date) -> Unit {
  write_year(sb, d.year)
  sb.write_byte((45).to_byte())
  write_2d(sb, d.month)
  sb.write_byte((45).to_byte())
  write_2d(sb, d.day)
}

///|
fn write_3d_full(sb : StringBuilder, v : Int) -> Unit {
  // Exact for 0 <= v <= 999.
  let d0 = (v * 41944) >> 22
  let r0 = v - d0 * 100
  let d1 = (r0 * 205) >> 11
  let d2 = r0 - d1 * 10
  sb.write_byte((48 + d0).to_byte())
  sb.write_byte((48 + d1).to_byte())
  sb.write_byte((48 + d2).to_byte())
}

///|
fn write_3d_trimmed(sb : StringBuilder, v : Int) -> Unit {
  // Exact for 1 <= v <= 999, omits trailing zeros.
  let d0 = (v * 41944) >> 22
  let r0 = v - d0 * 100
  sb.write_byte((48 + d0).to_byte())
  if r0 != 0 {
    let d1 = (r0 * 205) >> 11
    let d2 = r0 - d1 * 10
    sb.write_byte((48 + d1).to_byte())
    if d2 != 0 {
      sb.write_byte((48 + d2).to_byte())
    }
  }
}

///|
fn write_fraction_trimmed(sb : StringBuilder, nanos : Int) -> Unit {
  if nanos == 0 {
    return
  }
  sb.write_byte((46).to_byte())
  let hi3 = ((nanos.to_int64() * 1125899907L) >> 50).to_int()
  let r6 = nanos - hi3 * 1000000
  if r6 == 0 {
    write_3d_trimmed(sb, hi3)
    return
  }
  write_3d_full(sb, hi3)
  let mid3 = ((r6.to_int64() * 4294968L) >> 32).to_int()
  let lo3 = r6 - mid3 * 1000
  if lo3 == 0 {
    write_3d_trimmed(sb, mid3)
    return
  }
  write_3d_full(sb, mid3)
  write_3d_trimmed(sb, lo3)
}

///|
fn write_time_to(sb : StringBuilder, t : Time) -> Unit {
  write_2d(sb, t.hour)
  sb.write_byte((58).to_byte())
  write_2d(sb, t.minute)
  sb.write_byte((58).to_byte())
  write_2d(sb, t.second)
  write_fraction_trimmed(sb, t.nanosecond)
}

///|
fn write_offset_hm_to(sb : StringBuilder, off : Offset) -> Unit {
  let mut secs = off.seconds
  if secs < 0 {
    sb.write_byte((45).to_byte())
    secs = -secs
  } else {
    sb.write_byte((43).to_byte())
  }
  let h = ((secs >> 4) * 9321) >> 21
  let rem = secs - h * 3600
  let m = (rem * 17477) >> 20
  write_2d(sb, h)
  sb.write_byte((58).to_byte())
  write_2d(sb, m)
}

///|
fn write_offset_to(sb : StringBuilder, off : Offset, with_colon : Bool) -> Unit {
  let mut secs = off.seconds
  if secs < 0 {
    sb.write_byte((45).to_byte())
    secs = -secs
  } else {
    sb.write_byte((43).to_byte())
  }
  let h = ((secs >> 4) * 9321) >> 21
  let rem = secs - h * 3600
  let m = (rem * 17477) >> 20
  let s = rem - m * 60
  write_2d(sb, h)
  if with_colon {
    sb.write_byte((58).to_byte())
  }
  write_2d(sb, m)
  if s != 0 && with_colon {
    sb.write_byte((58).to_byte())
    write_2d(sb, s)
  }
}

///|
fn month_short_name(month : Int) -> String {
  match month {
    1 => "Jan"
    2 => "Feb"
    3 => "Mar"
    4 => "Apr"
    5 => "May"
    6 => "Jun"
    7 => "Jul"
    8 => "Aug"
    9 => "Sep"
    10 => "Oct"
    11 => "Nov"
    _ => "Dec"
  }
}

///|
fn parse_date_at_slice(
  s : String,
  start : Int,
  end : Int,
) -> Result[(Date, Int), TimeError] {
  if start >= end {
    return Err(TimeError::new("PARSE_DATE", "empty date"))
  }
  let first = s.code_unit_at(start)
  let mut pos = start
  let mut year = 0
  if first == 43 || first == 45 {
    // Signed 6-digit year (+YYYYYY / -YYYYYY)
    if pos + 7 > end {
      return Err(TimeError::new("PARSE_DATE", "expected 6-digit signed year"))
    }
    let y = parse_6_digits(s, pos + 1)
    if y < 0 {
      return Err(TimeError::new("PARSE_DATE", "invalid signed year digits"))
    }
    if first == 45 {
      if y == 0 {
        return Err(TimeError::new("PARSE_DATE", "-000000 is not a valid year"))
      }
      year = -y
    } else {
      year = y
    }
    pos = pos + 7
  } else {
    if pos + 4 > end {
      return Err(TimeError::new("PARSE_DATE", "expected 4-digit year"))
    }
    let y = parse_4_digits(s, pos)
    if y < 0 {
      return Err(TimeError::new("PARSE_DATE", "invalid year digits"))
    }
    year = y
    pos = pos + 4
  }
  if pos < end && s.code_unit_at(pos) == 45 {
    // Extended format: -MM-DD
    if pos + 6 > end {
      return Err(TimeError::new("PARSE_DATE", "truncated date"))
    }
    if s.code_unit_at(pos + 3) != 45 {
      return Err(TimeError::new("PARSE_DATE", "expected '-' date separator"))
    }
    let month = parse_2_digits(s, pos + 1)
    let day = parse_2_digits(s, pos + 4)
    if month < 0 || day < 0 {
      return Err(TimeError::new("PARSE_DATE", "invalid month/day digits"))
    }
    match Date::new(year, month, day) {
      Ok(d) => Ok((d, pos + 6))
      Err(e) => Err(e)
    }
  } else {
    // Basic format: MMDD
    if pos + 4 > end {
      return Err(TimeError::new("PARSE_DATE", "truncated basic date"))
    }
    let month = parse_2_digits(s, pos)
    let day = parse_2_digits(s, pos + 2)
    if month < 0 || day < 0 {
      return Err(TimeError::new("PARSE_DATE", "invalid basic month/day digits"))
    }
    match Date::new(year, month, day) {
      Ok(d) => Ok((d, pos + 4))
      Err(e) => Err(e)
    }
  }
}

///|
fn parse_date_at(s : String, start : Int) -> Result[(Date, Int), TimeError] {
  parse_date_at_slice(s, start, s.length())
}

///|
fn parse_fraction_at_slice(
  s : String,
  start : Int,
  end : Int,
  allow_comma : Bool,
) -> Result[(Int, Int), TimeError] {
  if start >= end {
    return Ok((0, start))
  }
  let sep = s.code_unit_at(start)
  if sep != 46 && !(allow_comma && sep == 44) {
    return Ok((0, start))
  }
  let mut pos = start + 1
  let mut digits = 0
  let mut nanos = 0
  let mut scale = 100000000
  while pos < end {
    let c = s.code_unit_at(pos)
    if !is_digit(c) {
      break
    }
    if digits >= 9 {
      return Err(TimeError::new("PARSE_FRACTION", "fractional seconds exceed 9 digits"))
    }
    nanos = nanos + (c - 48) * scale
    scale = scale / 10
    digits = digits + 1
    pos = pos + 1
  }
  if digits == 0 {
    return Err(TimeError::new("PARSE_FRACTION", "expected at least one fractional digit"))
  }
  Ok((nanos, pos))
}

///|
fn parse_fraction_at(
  s : String,
  start : Int,
  allow_comma : Bool,
) -> Result[(Int, Int), TimeError] {
  parse_fraction_at_slice(s, start, s.length(), allow_comma)
}

///|
fn parse_time_flex_at(
  s : String,
  start : Int,
  end : Int,
  allow_leap_sec : Bool,
  allow_basic : Bool,
  allow_hour_only : Bool,
  allow_comma : Bool,
) -> Result[(Time, Int), TimeError] {
  if start + 2 > end {
    return Err(TimeError::new("PARSE_TIME", "truncated time"))
  }
  let hour = parse_2_digits(s, start)
  if hour < 0 {
    return Err(TimeError::new("PARSE_TIME", "invalid hour digits"))
  }
  let mut pos = start + 2
  let mut minute = 0
  let mut second = 0
  let mut nanos = 0
  if pos < end && s.code_unit_at(pos) == 58 {
    // Extended time: HH:MM(:SS)?
    if pos + 3 > end {
      return Err(TimeError::new("PARSE_TIME", "truncated minute"))
    }
    let m = parse_2_digits(s, pos + 1)
    if m < 0 {
      return Err(TimeError::new("PARSE_TIME", "invalid minute digits"))
    }
    minute = m
    pos = pos + 3
    if pos < end && s.code_unit_at(pos) == 58 {
      if pos + 3 > end {
        return Err(TimeError::new("PARSE_TIME", "truncated seconds"))
      }
      let mut sec = parse_2_digits(s, pos + 1)
      if sec < 0 {
        return Err(TimeError::new("PARSE_TIME", "invalid second digits"))
      }
      if allow_leap_sec && sec == 60 {
        sec = 59
      }
      second = sec
      pos = pos + 3
      match parse_fraction_at_slice(s, pos, end, allow_comma) {
        Ok(pair) => {
          nanos = pair.0
          pos = pair.1
        }
        Err(e) => return Err(e)
      }
    }
  } else if allow_basic && pos + 2 <= end && is_digit(s.code_unit_at(pos)) {
    // Basic time: HHMM(SS)?
    let m = parse_2_digits(s, pos)
    if m < 0 {
      return Err(TimeError::new("PARSE_TIME", "invalid basic minute digits"))
    }
    minute = m
    pos = pos + 2
    if pos + 2 <= end && is_digit(s.code_unit_at(pos)) {
      let mut sec = parse_2_digits(s, pos)
      if sec < 0 {
        return Err(TimeError::new("PARSE_TIME", "invalid basic second digits"))
      }
      if allow_leap_sec && sec == 60 {
        sec = 59
      }
      second = sec
      pos = pos + 2
      match parse_fraction_at_slice(s, pos, end, allow_comma) {
        Ok(pair) => {
          nanos = pair.0
          pos = pair.1
        }
        Err(e) => return Err(e)
      }
    }
  } else if !allow_hour_only {
    return Err(TimeError::new("PARSE_TIME", "expected ':' between hour and minute"))
  }
  match Time::new(hour, minute, second, nanos) {
    Ok(t) => Ok((t, pos))
    Err(e) => Err(e)
  }
}

///|
fn parse_time_at(
  s : String,
  start : Int,
  require_seconds : Bool,
) -> Result[(Time, Int), TimeError] {
  let len = s.length()
  if start + 5 > len {
    return Err(TimeError::new("PARSE_TIME", "truncated time"))
  }
  let hour = parse_2_digits(s, start)
  if hour < 0 {
    return Err(TimeError::new("PARSE_TIME", "invalid hour digits"))
  }
  if s.code_unit_at(start + 2) != 58 {
    return Err(TimeError::new("PARSE_TIME", "expected ':' between hour and minute"))
  }
  let minute = parse_2_digits(s, start + 3)
  if minute < 0 {
    return Err(TimeError::new("PARSE_TIME", "invalid minute digits"))
  }
  let mut pos = start + 5
  let mut second = 0
  let mut nanos = 0
  if pos < len && s.code_unit_at(pos) == 58 {
    if pos + 3 > len {
      return Err(TimeError::new("PARSE_TIME", "truncated seconds"))
    }
    let sec = parse_2_digits(s, pos + 1)
    if sec < 0 {
      return Err(TimeError::new("PARSE_TIME", "invalid second digits"))
    }
    second = sec
    pos = pos + 3
    match parse_fraction_at(s, pos, false) {
      Ok(pair) => {
        nanos = pair.0
        pos = pair.1
      }
      Err(e) => return Err(e)
    }
  } else if require_seconds {
    return Err(TimeError::new("PARSE_TIME", "expected ':SS' in time"))
  }
  match Time::new(hour, minute, second, nanos) {
    Ok(t) => Ok((t, pos))
    Err(e) => Err(e)
  }
}

///|
fn is_rfc9557_tz_char(c : Int) -> Bool {
  (c >= 65 && c <= 90) ||
  (c >= 97 && c <= 122) ||
  (c >= 48 && c <= 57) ||
  c == 47 ||
  c == 95 ||
  c == 45 ||
  c == 43 ||
  c == 46 ||
  c == 58
}

///|
fn is_rfc9557_kv_char(c : Int) -> Bool {
  (c >= 65 && c <= 90) ||
  (c >= 97 && c <= 122) ||
  (c >= 48 && c <= 57) ||
  c == 95 ||
  c == 45
}

///| Parse zero or more RFC 9557 bracketed annotations `[tz][k=v]...` from `start` to `end`.
///| Returns `Ok(Some(tz_name))` if a time zone annotation was present, else `Ok(None)`.
fn parse_rfc9557_annotations_slice(
  s : String,
  start : Int,
  end : Int,
) -> Result[Option[String], TimeError] {
  let mut pos = start
  let mut tz_name : Option[String] = None
  let mut first_bracket = true
  while pos < end {
    if s.code_unit_at(pos) != 91 {
      return Err(TimeError::new("PARSE_RFC9557", "expected '[' for annotation"))
    }
    pos = pos + 1
    if pos < end && s.code_unit_at(pos) == 33 {
      // Optional critical flag '!'
      pos = pos + 1
    }
    let content_start = pos
    let mut eq_pos = -1
    while pos < end && s.code_unit_at(pos) != 93 {
      let c = s.code_unit_at(pos)
      if c == 61 && eq_pos < 0 {
        eq_pos = pos
      }
      pos = pos + 1
    }
    if pos >= end || s.code_unit_at(pos) != 93 {
      return Err(TimeError::new("PARSE_RFC9557", "unclosed '[' annotation"))
    }
    let content_end = pos
    pos = pos + 1
    if content_end <= content_start {
      return Err(TimeError::new("PARSE_RFC9557", "empty annotation"))
    }
    if eq_pos >= 0 {
      // key=value annotation
      if eq_pos == content_start || eq_pos + 1 >= content_end {
        return Err(TimeError::new("PARSE_RFC9557", "empty key or value in annotation"))
      }
      let mut i = content_start
      while i < eq_pos {
        let c = s.code_unit_at(i)
        if !((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45) {
          return Err(TimeError::new("PARSE_RFC9557", "invalid annotation key char"))
        }
        i = i + 1
      }
      let mut j = eq_pos + 1
      while j < content_end {
        if !is_rfc9557_kv_char(s.code_unit_at(j)) {
          return Err(TimeError::new("PARSE_RFC9557", "invalid annotation value char"))
        }
        j = j + 1
      }
    } else {
      // Time zone annotation (only allowed as the first bracket)
      if !first_bracket {
        return Err(TimeError::new("PARSE_RFC9557", "duplicate or misplaced time zone annotation"))
      }
      let sb = StringBuilder::new()
      let mut i = content_start
      while i < content_end {
        let c = s.code_unit_at(i)
        if !is_rfc9557_tz_char(c) {
          return Err(TimeError::new("PARSE_RFC9557", "invalid time zone annotation char"))
        }
        sb.write_byte(c.to_byte())
        i = i + 1
      }
      tz_name = Some(sb.to_string())
    }
    first_bracket = false
  }
  Ok(tz_name)
}

///| Parse an ISO 8601 / RFC 3339 numeric offset (`±HH`, `±HH:MM`, `±HHMM`, `±HH:MM:SS[.frac]`, `±HHMMSS[.frac]`).
fn parse_iso_offset_slice(
  s : String,
  start : Int,
  end : Int,
) -> Result[(Int, Int), TimeError] {
  if start >= end {
    return Err(TimeError::new("PARSE_RFC3339", "missing offset"))
  }
  let sign = s.code_unit_at(start)
  if sign != 43 && sign != 45 {
    return Err(TimeError::new("PARSE_RFC3339", "expected '+' or '-' in offset"))
  }
  if start + 3 > end {
    return Err(TimeError::new("PARSE_RFC3339", "truncated offset hour"))
  }
  let oh = parse_2_digits(s, start + 1)
  if oh < 0 || oh > 25 {
    return Err(TimeError::new("PARSE_RFC3339", "invalid offset hour"))
  }
  let mut pos = start + 3
  let mut om = 0
  let mut os = 0
  let mut round_up = false
  if pos < end && s.code_unit_at(pos) == 58 {
    // Extended offset: ±HH:MM(:SS([.,]frac)?)?
    if pos + 3 > end {
      return Err(TimeError::new("PARSE_RFC3339", "truncated offset minute"))
    }
    let m = parse_2_digits(s, pos + 1)
    if m < 0 || m > 59 {
      return Err(TimeError::new("PARSE_RFC3339", "invalid offset minute"))
    }
    om = m
    pos = pos + 3
    if pos < end && s.code_unit_at(pos) == 58 {
      if pos + 3 > end {
        return Err(TimeError::new("PARSE_RFC3339", "truncated offset second"))
      }
      let sec = parse_2_digits(s, pos + 1)
      if sec < 0 || sec > 59 {
        return Err(TimeError::new("PARSE_RFC3339", "invalid offset second"))
      }
      os = sec
      pos = pos + 3
      if pos < end && (s.code_unit_at(pos) == 46 || s.code_unit_at(pos) == 44) {
        match parse_fraction_at_slice(s, pos, end, true) {
          Ok(fp) => {
            if fp.0 >= 500000000 {
              round_up = true
            }
            pos = fp.1
          }
          Err(e) => return Err(e)
        }
      }
    }
  } else if pos + 2 <= end && is_digit(s.code_unit_at(pos)) {
    // Basic offset: ±HHMM(SS([.,]frac)?)?
    let m = parse_2_digits(s, pos)
    if m < 0 || m > 59 {
      return Err(TimeError::new("PARSE_RFC3339", "invalid basic offset minute"))
    }
    om = m
    pos = pos + 2
    if pos + 2 <= end && is_digit(s.code_unit_at(pos)) {
      let sec = parse_2_digits(s, pos)
      if sec < 0 || sec > 59 {
        return Err(TimeError::new("PARSE_RFC3339", "invalid basic offset second"))
      }
      os = sec
      pos = pos + 2
      if pos < end && (s.code_unit_at(pos) == 46 || s.code_unit_at(pos) == 44) {
        match parse_fraction_at_slice(s, pos, end, true) {
          Ok(fp) => {
            if fp.0 >= 500000000 {
              round_up = true
            }
            pos = fp.1
          }
          Err(e) => return Err(e)
        }
      }
    }
  }
  let mut mag = oh * 3600 + om * 60 + os
  if round_up {
    mag = mag + 1
  }
  if mag > offset_max_secs {
    return Err(TimeError::new("INVALID_OFFSET", "offset out of range"))
  }
  let off_secs = if sign == 45 { -mag } else { mag }
  Ok((off_secs, pos))
}

///|
pub fn Date::parse(s : String) -> Result[Date, TimeError] {
  match parse_date_at(s, 0) {
    Err(e) => Err(e)
    Ok(pair) => {
      if pair.1 != s.length() {
        return Err(TimeError::new("TRAILING_INPUT", "unexpected trailing characters in date"))
      }
      Ok(pair.0)
    }
  }
}

///|
pub fn Date::to_string(self : Date) -> String {
  if self.year < min_year ||
  self.year > max_year ||
  self.month < 1 ||
  self.month > 12 ||
  self.day < 1 ||
  self.day > days_in_month_of(self.year, self.month) {
    return ""
  }
  let sb = StringBuilder::new()
  write_date_to(sb, self)
  sb.to_string()
}

///|
pub fn Time::parse(s : String) -> Result[Time, TimeError] {
  match parse_time_at(s, 0, false) {
    Err(e) => Err(e)
    Ok(pair) => {
      if pair.1 != s.length() {
        return Err(TimeError::new("TRAILING_INPUT", "unexpected trailing characters in time"))
      }
      Ok(pair.0)
    }
  }
}

///|
pub fn Time::to_string(self : Time) -> String {
  if self.hour < 0 ||
  self.hour > 23 ||
  self.minute < 0 ||
  self.minute > 59 ||
  self.second < 0 ||
  self.second > 59 ||
  self.nanosecond < 0 ||
  self.nanosecond > 999999999 {
    return ""
  }
  let sb = StringBuilder::new()
  write_time_to(sb, self)
  sb.to_string()
}

///|
pub fn DateTime::parse(s : String) -> Result[DateTime, TimeError] {
  let len = s.length()
  match parse_date_at_slice(s, 0, len) {
    Err(e) => Err(e)
    Ok(dp) => {
      let d = dp.0
      let mut pos = dp.1
      if pos >= len {
        return Err(TimeError::new("PARSE_DATETIME", "missing time separator"))
      }
      let sep = s.code_unit_at(pos)
      if sep != 84 && sep != 116 && sep != 32 {
        return Err(TimeError::new("PARSE_DATETIME", "expected 'T', 't', or ' ' separator"))
      }
      match parse_time_flex_at(s, pos + 1, len, true, true, true, true) {
        Err(e) => Err(e)
        Ok(tp) => {
          pos = tp.1
          if pos < len {
            let c = s.code_unit_at(pos)
            if c == 90 || c == 122 {
              return Err(TimeError::new("PARSE_DATETIME", "Z offset not allowed in civil DateTime"))
            }
            if c == 43 || c == 45 {
              match parse_iso_offset_slice(s, pos, len) {
                Ok(op) => pos = op.1
                Err(e) => return Err(e)
              }
            }
            if pos < len && s.code_unit_at(pos) == 91 {
              match parse_rfc9557_annotations_slice(s, pos, len) {
                Ok(_) => pos = len
                Err(e) => return Err(e)
              }
            }
          }
          if pos != len {
            return Err(TimeError::new("TRAILING_INPUT", "unexpected trailing characters in datetime"))
          }
          Ok(DateTime::{ date: d, time: tp.0 })
        }
      }
    }
  }
}

///|
pub fn DateTime::to_string(self : DateTime) -> String {
  let sb = StringBuilder::new()
  write_date_to(sb, self.date)
  sb.write_byte((84).to_byte())
  write_time_to(sb, self.time)
  sb.to_string()
}

///|
pub fn IsoWeekDate::parse(s : String) -> Result[IsoWeekDate, TimeError] {
  let len = s.length()
  if len == 0 {
    return Err(TimeError::new("PARSE_ISO_WEEK", "empty ISO week date"))
  }
  let mut pos = 0
  let first = s.code_unit_at(0)
  let mut year = 0
  if first == 43 || first == 45 {
    if len < 7 {
      return Err(TimeError::new("PARSE_ISO_WEEK", "expected 6-digit signed year"))
    }
    let y = parse_6_digits(s, 1)
    if y < 0 {
      return Err(TimeError::new("PARSE_ISO_WEEK", "invalid signed year"))
    }
    if first == 45 {
      if y == 0 {
        return Err(TimeError::new("PARSE_ISO_WEEK", "-000000 invalid"))
      }
      year = -y
    } else {
      year = y
    }
    pos = 7
  } else {
    if len < 4 {
      return Err(TimeError::new("PARSE_ISO_WEEK", "expected 4-digit year"))
    }
    let y = parse_4_digits(s, 0)
    if y < 0 {
      return Err(TimeError::new("PARSE_ISO_WEEK", "invalid year"))
    }
    year = y
    pos = 4
  }
  let extended = pos < len && s.code_unit_at(pos) == 45
  if extended {
    pos = pos + 1
  }
  if pos >= len {
    return Err(TimeError::new("PARSE_ISO_WEEK", "expected 'W'"))
  }
  let wch = s.code_unit_at(pos)
  if wch != 87 && wch != 119 {
    return Err(TimeError::new("PARSE_ISO_WEEK", "expected 'W' or 'w'"))
  }
  pos = pos + 1
  if pos + 2 > len {
    return Err(TimeError::new("PARSE_ISO_WEEK", "truncated week number"))
  }
  let week = parse_2_digits(s, pos)
  if week < 0 {
    return Err(TimeError::new("PARSE_ISO_WEEK", "invalid week digits"))
  }
  pos = pos + 2
  if extended {
    if pos >= len || s.code_unit_at(pos) != 45 {
      return Err(TimeError::new("PARSE_ISO_WEEK", "expected '-' before weekday"))
    }
    pos = pos + 1
  }
  if pos + 1 != len {
    return Err(TimeError::new("PARSE_ISO_WEEK", "expected single weekday digit at end"))
  }
  let wd_num = s.code_unit_at(pos) - 48
  match weekday_from_monday_one_offset(wd_num) {
    Err(e) => Err(e)
    Ok(wd) => IsoWeekDate::new(year, week, wd)
  }
}

///|
pub fn IsoWeekDate::to_string(self : IsoWeekDate) -> String {
  let sb = StringBuilder::new()
  write_year(sb, self.year)
  sb.write_byte((45).to_byte())
  sb.write_byte((87).to_byte())
  write_2d(sb, self.week)
  sb.write_byte((45).to_byte())
  sb.write_byte((48 + weekday_to_monday_one_offset(self.weekday)).to_byte())
  sb.to_string()
}

///|
pub fn Offset::to_string(self : Offset) -> String {
  let sb = StringBuilder::new()
  write_offset_to(sb, self, true)
  sb.to_string()
}

///| General ISO 8601 / RFC 3339 / RFC 9557 timestamp parser (supports 6-digit extended years,
///| basic/reduced-precision dates & times, comma decimal, leap second :60, extended offsets ±25:59:59[.frac],
///| and RFC 9557 bracketed annotations). Returns `(FixedDateTime, Option[String])` (optional tz annotation).
fn parse_rfc3339_general_slice(
  s : String,
  start : Int,
  end : Int,
) -> Result[(FixedDateTime, Option[String]), TimeError] {
  let dp = match parse_date_at_slice(s, start, end) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let d = dp.0
  let mut pos = dp.1
  if pos >= end {
    return Err(TimeError::new("PARSE_RFC3339", "missing time separator"))
  }
  let sep = s.code_unit_at(pos)
  if sep != 84 && sep != 116 && sep != 32 {
    return Err(TimeError::new("PARSE_RFC3339", "expected 'T', 't', or ' ' separator"))
  }
  let tp = match parse_time_flex_at(s, pos + 1, end, true, true, true, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let t = tp.0
  pos = tp.1
  if pos >= end {
    return Err(TimeError::new("PARSE_RFC3339", "missing UTC offset"))
  }
  let tz = s.code_unit_at(pos)
  let mut off_secs = 0
  if tz == 90 || tz == 122 {
    pos = pos + 1
  } else if tz == 43 || tz == 45 {
    match parse_iso_offset_slice(s, pos, end) {
      Ok(op) => {
        off_secs = op.0
        pos = op.1
      }
      Err(e) => return Err(e)
    }
  } else {
    return Err(TimeError::new("PARSE_RFC3339", "invalid offset designator"))
  }
  let mut tz_name : Option[String] = None
  if pos < end {
    if s.code_unit_at(pos) == 91 {
      match parse_rfc9557_annotations_slice(s, pos, end) {
        Ok(tn) => {
          tz_name = tn
          pos = end
        }
        Err(e) => return Err(e)
      }
    } else {
      return Err(TimeError::new("PARSE_RFC3339", "trailing characters after offset"))
    }
  }
  Ok((
    FixedDateTime::{
      datetime: DateTime::{ date: d, time: t },
      offset: Offset::{ seconds: off_secs },
    },
    tz_name,
  ))
}

///| Extract the optional RFC 9557 time zone annotation (e.g. `"America/New_York"`) from a timestamp string.
pub fn parse_rfc9557_tz_name(s : String) -> Result[Option[String], TimeError] {
  match parse_rfc3339_general_slice(s, 0, s.length()) {
    Ok(pair) => Ok(pair.1)
    Err(e) => Err(e)
  }
}

///|
pub fn FixedDateTime::parse_rfc3339_slice(
  s : String,
  start : Int,
  end : Int,
) -> Result[FixedDateTime, TimeError] {
  let slen = s.length()
  if start < 0 || end < start || end > slen {
    return Err(TimeError::new("PARSE_RFC3339", "slice out of bounds"))
  }
  let n = end - start
  // Fast path: standard 4-digit extended YYYY-MM-DDTHH:MM:SS[.frac](Z|±HH:MM) with no annotations
  if n >= 20 &&
  s.code_unit_at(start + 4) == 45 &&
  s.code_unit_at(start + 7) == 45 &&
  s.code_unit_at(start + 13) == 58 &&
  s.code_unit_at(start + 16) == 58 {
    let y0 = s.code_unit_at(start) - 48
    let y1 = s.code_unit_at(start + 1) - 48
    let y2 = s.code_unit_at(start + 2) - 48
    let y3 = s.code_unit_at(start + 3) - 48
    let m0 = s.code_unit_at(start + 5) - 48
    let m1 = s.code_unit_at(start + 6) - 48
    let d0 = s.code_unit_at(start + 8) - 48
    let d1 = s.code_unit_at(start + 9) - 48
    let sep = s.code_unit_at(start + 10)
    let h0 = s.code_unit_at(start + 11) - 48
    let h1 = s.code_unit_at(start + 12) - 48
    let mi0 = s.code_unit_at(start + 14) - 48
    let mi1 = s.code_unit_at(start + 15) - 48
    let s0 = s.code_unit_at(start + 17) - 48
    let s1 = s.code_unit_at(start + 18) - 48
    if (y0 | (9 - y0) | y1 | (9 - y1) | y2 | (9 - y2) | y3 | (9 - y3) |
      m0 | (9 - m0) | m1 | (9 - m1) | d0 | (9 - d0) | d1 | (9 - d1) |
      h0 | (9 - h0) | h1 | (9 - h1) | mi0 | (9 - mi0) | mi1 | (9 - mi1) |
      s0 | (9 - s0) | s1 | (9 - s1)) >= 0 &&
    (sep == 84 || sep == 116 || sep == 32) {
      let mut pos = start + 19
      let mut nanos = 0
      let mut fast_ok = true
      if pos < end && s.code_unit_at(pos) == 46 {
        pos = pos + 1
        let mut digits = 0
        while pos < end {
          let d = s.code_unit_at(pos) - 48
          if (d | (9 - d)) < 0 {
            break
          }
          if digits >= 9 {
            return Err(TimeError::new("PARSE_RFC3339", "fractional seconds exceed 9 digits"))
          }
          nanos = nanos * 10 + d
          digits = digits + 1
          pos = pos + 1
        }
        if digits == 0 {
          return Err(TimeError::new("PARSE_RFC3339", "empty fractional seconds"))
        }
        nanos = match digits {
          9 => nanos
          8 => nanos * 10
          7 => nanos * 100
          6 => nanos * 1000
          5 => nanos * 10000
          4 => nanos * 100000
          3 => nanos * 1000000
          2 => nanos * 10000000
          _ => nanos * 100000000
        }
      } else if pos < end && s.code_unit_at(pos) == 44 {
        fast_ok = false
      }
      if fast_ok && pos < end {
        let tz = s.code_unit_at(pos)
        let mut off_secs = 0
        if (tz == 90 || tz == 122) && pos + 1 == end {
          off_secs = 0
        } else if (tz == 43 || tz == 45) && pos + 6 == end && s.code_unit_at(pos + 3) == 58 {
          let oh0 = s.code_unit_at(pos + 1) - 48
          let oh1 = s.code_unit_at(pos + 2) - 48
          let om0 = s.code_unit_at(pos + 4) - 48
          let om1 = s.code_unit_at(pos + 5) - 48
          if (oh0 | (9 - oh0) | oh1 | (9 - oh1) | om0 | (9 - om0) | om1 | (9 - om1)) >= 0 {
            let oh = oh0 * 10 + oh1
            let om = om0 * 10 + om1
            if oh <= 25 && om <= 59 {
              let mag = oh * 3600 + om * 60
              off_secs = if tz == 45 { -mag } else { mag }
            } else {
              return Err(TimeError::new("PARSE_RFC3339", "invalid offset hour or minute"))
            }
          } else {
            fast_ok = false
          }
        } else {
          fast_ok = false
        }
        if fast_ok {
          let year = y0 * 1000 + y1 * 100 + y2 * 10 + y3
          let month = m0 * 10 + m1
          let day = d0 * 10 + d1
          let hour = h0 * 10 + h1
          let minute = mi0 * 10 + mi1
          let mut second = s0 * 10 + s1
          if second == 60 {
            second = 59
          }
          if month < 1 || month > 12 {
            return Err(TimeError::new("INVALID_MONTH", "month must be in 1..=12"))
          }
          if day < 1 || (day > 28 && day > days_in_month_of(year, month)) {
            return Err(TimeError::new("INVALID_DAY", "day exceeds days in month"))
          }
          if hour > 23 {
            return Err(TimeError::new("INVALID_HOUR", "hour must be in 0..=23"))
          }
          if minute > 59 {
            return Err(TimeError::new("INVALID_MINUTE", "minute must be in 0..=59"))
          }
          if second > 59 {
            return Err(TimeError::new("INVALID_SECOND", "second must be in 0..=59"))
          }
          return Ok(FixedDateTime::{
            datetime: DateTime::{
              date: Date::{ year: year, month: month, day: day },
              time: Time::{ hour: hour, minute: minute, second: second, nanosecond: nanos },
            },
            offset: Offset::{ seconds: off_secs },
          })
        }
      }
    }
  }
  match parse_rfc3339_general_slice(s, start, end) {
    Ok(pair) => Ok(pair.0)
    Err(e) => Err(e)
  }
}

///|
pub fn FixedDateTime::parse_rfc3339(
  s : String,
) -> Result[FixedDateTime, TimeError] {
  FixedDateTime::parse_rfc3339_slice(s, 0, s.length())
}

///|
pub fn Timestamp::parse_rfc3339_slice(
  s : String,
  start : Int,
  end : Int,
) -> Result[Timestamp, TimeError] {
  let slen = s.length()
  if start < 0 || end < start || end > slen {
    return Err(TimeError::new("PARSE_RFC3339", "slice out of bounds"))
  }
  let n = end - start
  // Fast path: standard 4-digit extended YYYY-MM-DDTHH:MM:SS[.frac](Z|±HH:MM)
  if n >= 20 &&
  s.code_unit_at(start + 4) == 45 &&
  s.code_unit_at(start + 7) == 45 &&
  s.code_unit_at(start + 13) == 58 &&
  s.code_unit_at(start + 16) == 58 {
    let y0 = s.code_unit_at(start) - 48
    let y1 = s.code_unit_at(start + 1) - 48
    let y2 = s.code_unit_at(start + 2) - 48
    let y3 = s.code_unit_at(start + 3) - 48
    let m0 = s.code_unit_at(start + 5) - 48
    let m1 = s.code_unit_at(start + 6) - 48
    let d0 = s.code_unit_at(start + 8) - 48
    let d1 = s.code_unit_at(start + 9) - 48
    let sep = s.code_unit_at(start + 10)
    let h0 = s.code_unit_at(start + 11) - 48
    let h1 = s.code_unit_at(start + 12) - 48
    let mi0 = s.code_unit_at(start + 14) - 48
    let mi1 = s.code_unit_at(start + 15) - 48
    let s0 = s.code_unit_at(start + 17) - 48
    let s1 = s.code_unit_at(start + 18) - 48
    if (y0 | (9 - y0) | y1 | (9 - y1) | y2 | (9 - y2) | y3 | (9 - y3) |
      m0 | (9 - m0) | m1 | (9 - m1) | d0 | (9 - d0) | d1 | (9 - d1) |
      h0 | (9 - h0) | h1 | (9 - h1) | mi0 | (9 - mi0) | mi1 | (9 - mi1) |
      s0 | (9 - s0) | s1 | (9 - s1)) >= 0 &&
    (sep == 84 || sep == 116 || sep == 32) {
      let mut pos = start + 19
      let mut nanos = 0
      let mut fast_ok = true
      if pos < end && s.code_unit_at(pos) == 46 {
        pos = pos + 1
        let mut digits = 0
        while pos < end {
          let d = s.code_unit_at(pos) - 48
          if (d | (9 - d)) < 0 {
            break
          }
          if digits >= 9 {
            return Err(TimeError::new("PARSE_RFC3339", "fractional seconds exceed 9 digits"))
          }
          nanos = nanos * 10 + d
          digits = digits + 1
          pos = pos + 1
        }
        if digits == 0 {
          return Err(TimeError::new("PARSE_RFC3339", "empty fractional seconds"))
        }
        nanos = match digits {
          9 => nanos
          8 => nanos * 10
          7 => nanos * 100
          6 => nanos * 1000
          5 => nanos * 10000
          4 => nanos * 100000
          3 => nanos * 1000000
          2 => nanos * 10000000
          _ => nanos * 100000000
        }
      } else if pos < end && s.code_unit_at(pos) == 44 {
        fast_ok = false
      }
      if fast_ok && pos < end {
        let tz = s.code_unit_at(pos)
        let mut off_secs = 0
        if (tz == 90 || tz == 122) && pos + 1 == end {
          off_secs = 0
        } else if (tz == 43 || tz == 45) && pos + 6 == end && s.code_unit_at(pos + 3) == 58 {
          let oh0 = s.code_unit_at(pos + 1) - 48
          let oh1 = s.code_unit_at(pos + 2) - 48
          let om0 = s.code_unit_at(pos + 4) - 48
          let om1 = s.code_unit_at(pos + 5) - 48
          if (oh0 | (9 - oh0) | oh1 | (9 - oh1) | om0 | (9 - om0) | om1 | (9 - om1)) >= 0 {
            let oh = oh0 * 10 + oh1
            let om = om0 * 10 + om1
            if oh <= 25 && om <= 59 {
              let mag = oh * 3600 + om * 60
              off_secs = if tz == 45 { -mag } else { mag }
            } else {
              return Err(TimeError::new("PARSE_RFC3339", "invalid offset hour or minute"))
            }
          } else {
            fast_ok = false
          }
        } else {
          fast_ok = false
        }
        if fast_ok {
          let year = y0 * 1000 + y1 * 100 + y2 * 10 + y3
          let month = m0 * 10 + m1
          let day = d0 * 10 + d1
          let hour = h0 * 10 + h1
          let minute = mi0 * 10 + mi1
          let mut second = s0 * 10 + s1
          if second == 60 {
            second = 59
          }
          if month < 1 || month > 12 {
            return Err(TimeError::new("INVALID_MONTH", "month must be in 1..=12"))
          }
          if day < 1 || (day > 28 && day > days_in_month_of(year, month)) {
            return Err(TimeError::new("INVALID_DAY", "day exceeds days in month"))
          }
          if hour > 23 {
            return Err(TimeError::new("INVALID_HOUR", "hour must be in 0..=23"))
          }
          if minute > 59 {
            return Err(TimeError::new("INVALID_MINUTE", "minute must be in 0..=59"))
          }
          if second > 59 {
            return Err(TimeError::new("INVALID_SECOND", "second must be in 0..=59"))
          }
          let j = if month <= 2 { 1 } else { 0 }
          let y = year + 32800 - j
          let m = if j == 1 { month + 12 } else { month }
          let c = (y * 41944) >> 22
          let ed = ((1461 * y) >> 2) - c + (c >> 2) + ((979 * m - 2919) >> 5) + day - 12699423
          let secs = ed.to_int64() * 86400L + (hour * 3600 + minute * 60 + second - off_secs).to_int64()
          if secs < ts_min_secs || secs > ts_max_secs {
            return Err(TimeError::new("OUT_OF_RANGE", "timestamp out of supported range"))
          }
          return Ok(Timestamp::{ secs: secs, nanos: nanos })
        }
      }
    }
  }
  match parse_rfc3339_general_slice(s, start, end) {
    Ok(pair) => pair.0.to_timestamp()
    Err(e) => Err(e)
  }
}

///|
pub fn Timestamp::parse_rfc3339(s : String) -> Result[Timestamp, TimeError] {
  Timestamp::parse_rfc3339_slice(s, 0, s.length())
}

///|
fn write_timestamp_ymd_hms(
  sb : StringBuilder,
  secs : Int64,
  nanos : Int,
  off_secs : Int,
) -> Unit {
  let day_shift : Int64 = 4382910L
  let sec_shift : Int64 = 378683424000L
  let pos_sec = secs + off_secs.to_int64() + sec_shift
  let ed_pos = pos_sec / 86400L
  let ed = (ed_pos - day_shift).to_int()
  let sod = (pos_sec - ed_pos * 86400L).to_int()
  // Inline Neri-Schneider date decomposition -> zero Date/Time/DateTime allocations.
  let n = ed + 12699422
  let n1 = (n << 2) + 3
  let c = ((n1.to_int64() * 963315389L) >> 47).to_int()
  let nc = (n1 - c * 146097) >> 2
  let n2 = (nc << 2) + 3
  let z = ((2939745L * n2.to_int64()) >> 32).to_int()
  let ny = nc - ((1461 * z) >> 2)
  let y = 100 * c + z
  let n3 = 2141 * ny + 197913
  let m_raw = n3 >> 16
  let d = ((n3 & 65535) * 31345) >> 26
  let j = if ny >= 306 { 1 } else { 0 }
  let year = y - 32800 + j
  let month = if j == 1 { m_raw - 12 } else { m_raw }
  let day = d + 1
  let h = ((sod >> 4) * 9321) >> 21
  let rem = sod - h * 3600
  let mi = (rem * 17477) >> 20
  let sec = rem - mi * 60
  write_year(sb, year)
  sb.write_byte((45).to_byte())
  write_2d(sb, month)
  sb.write_byte((45).to_byte())
  write_2d(sb, day)
  sb.write_byte((84).to_byte())
  write_2d(sb, h)
  sb.write_byte((58).to_byte())
  write_2d(sb, mi)
  sb.write_byte((58).to_byte())
  write_2d(sb, sec)
  write_fraction_trimmed(sb, nanos)
}

///|
pub fn Timestamp::write_rfc3339(self : Timestamp, sb : StringBuilder) -> Unit {
  if self.secs < ts_min_secs ||
  self.secs > ts_max_secs ||
  self.nanos < 0 ||
  self.nanos > 999999999 {
    return
  }
  write_timestamp_ymd_hms(sb, self.secs, self.nanos, 0)
  sb.write_byte((90).to_byte())
}

///|
pub fn Timestamp::write_rfc3339_with_offset(
  self : Timestamp,
  offset : Offset,
  sb : StringBuilder,
) -> Unit {
  if self.secs < ts_min_secs ||
  self.secs > ts_max_secs ||
  self.nanos < 0 ||
  self.nanos > 999999999 ||
  offset.seconds < offset_min_secs ||
  offset.seconds > offset_max_secs {
    return
  }
  write_timestamp_ymd_hms(sb, self.secs, self.nanos, offset.seconds)
  write_offset_hm_to(sb, offset)
}

///| Zero-allocation RFC 3339 slice parser writing `(secs, nanos)` into `out[0..2]`.
///| Returns `true` on success, `false` on any syntax or range error.
pub fn parse_rfc3339_slice_raw(
  s : String,
  start : Int,
  end : Int,
  out : Array[Int64],
) -> Bool {
  let slen = s.length()
  if start < 0 || end < start || end > slen || out.length() < 2 {
    return false
  }
  let n = end - start
  // Fast path: standard 4-digit extended YYYY-MM-DDTHH:MM:SS[.frac](Z|±HH:MM)
  if n >= 20 &&
  s.code_unit_at(start + 4) == 45 &&
  s.code_unit_at(start + 7) == 45 &&
  s.code_unit_at(start + 13) == 58 &&
  s.code_unit_at(start + 16) == 58 {
    let y0 = s.code_unit_at(start) - 48
    let y1 = s.code_unit_at(start + 1) - 48
    let y2 = s.code_unit_at(start + 2) - 48
    let y3 = s.code_unit_at(start + 3) - 48
    let m0 = s.code_unit_at(start + 5) - 48
    let m1 = s.code_unit_at(start + 6) - 48
    let d0 = s.code_unit_at(start + 8) - 48
    let d1 = s.code_unit_at(start + 9) - 48
    let sep = s.code_unit_at(start + 10)
    let h0 = s.code_unit_at(start + 11) - 48
    let h1 = s.code_unit_at(start + 12) - 48
    let mi0 = s.code_unit_at(start + 14) - 48
    let mi1 = s.code_unit_at(start + 15) - 48
    let s0 = s.code_unit_at(start + 17) - 48
    let s1 = s.code_unit_at(start + 18) - 48
    if (y0 | (9 - y0) | y1 | (9 - y1) | y2 | (9 - y2) | y3 | (9 - y3) |
      m0 | (9 - m0) | m1 | (9 - m1) | d0 | (9 - d0) | d1 | (9 - d1) |
      h0 | (9 - h0) | h1 | (9 - h1) | mi0 | (9 - mi0) | mi1 | (9 - mi1) |
      s0 | (9 - s0) | s1 | (9 - s1)) >= 0 &&
    (sep == 84 || sep == 116 || sep == 32) {
      let mut pos = start + 19
      let mut nanos = 0
      let mut fast_ok = true
      if pos < end && s.code_unit_at(pos) == 46 {
        pos = pos + 1
        let mut digits = 0
        while pos < end {
          let d = s.code_unit_at(pos) - 48
          if (d | (9 - d)) < 0 {
            break
          }
          if digits >= 9 {
            return false
          }
          nanos = nanos * 10 + d
          digits = digits + 1
          pos = pos + 1
        }
        if digits == 0 {
          return false
        }
        nanos = match digits {
          9 => nanos
          8 => nanos * 10
          7 => nanos * 100
          6 => nanos * 1000
          5 => nanos * 10000
          4 => nanos * 100000
          3 => nanos * 1000000
          2 => nanos * 10000000
          _ => nanos * 100000000
        }
      } else if pos < end && s.code_unit_at(pos) == 44 {
        fast_ok = false
      }
      if fast_ok && pos < end {
        let tz = s.code_unit_at(pos)
        let mut off_secs = 0
        if (tz == 90 || tz == 122) && pos + 1 == end {
          off_secs = 0
        } else if (tz == 43 || tz == 45) && pos + 6 == end && s.code_unit_at(pos + 3) == 58 {
          let oh0 = s.code_unit_at(pos + 1) - 48
          let oh1 = s.code_unit_at(pos + 2) - 48
          let om0 = s.code_unit_at(pos + 4) - 48
          let om1 = s.code_unit_at(pos + 5) - 48
          if (oh0 | (9 - oh0) | oh1 | (9 - oh1) | om0 | (9 - om0) | om1 | (9 - om1)) >= 0 {
            let oh = oh0 * 10 + oh1
            let om = om0 * 10 + om1
            if oh <= 25 && om <= 59 {
              let mag = oh * 3600 + om * 60
              off_secs = if tz == 45 { -mag } else { mag }
            } else {
              return false
            }
          } else {
            fast_ok = false
          }
        } else {
          fast_ok = false
        }
        if fast_ok {
          let year = y0 * 1000 + y1 * 100 + y2 * 10 + y3
          let month = m0 * 10 + m1
          let day = d0 * 10 + d1
          let hour = h0 * 10 + h1
          let minute = mi0 * 10 + mi1
          let mut second = s0 * 10 + s1
          if second == 60 {
            second = 59
          }
          if month < 1 || month > 12 || day < 1 {
            return false
          }
          if day > 28 {
            let dim = if month == 2 {
              if (year & 3) == 0 && (year % 25 != 0 || (year & 15) == 0) {
                29
              } else {
                28
              }
            } else {
              30 + ((month + (month >> 3)) & 1)
            }
            if day > dim {
              return false
            }
          }
          if hour > 23 || minute > 59 || second > 59 {
            return false
          }
          let j = if month <= 2 { 1 } else { 0 }
          let y = year + 32800 - j
          let m = if j == 1 { month + 12 } else { month }
          let c = (y * 41944) >> 22
          let ed = ((1461 * y) >> 2) - c + (c >> 2) + ((979 * m - 2919) >> 5) + day - 12699423
          let secs = ed.to_int64() * 86400L + (hour * 3600 + minute * 60 + second - off_secs).to_int64()
          if secs < ts_min_secs || secs > ts_max_secs {
            return false
          }
          out[0] = secs
          out[1] = nanos.to_int64()
          return true
        }
      }
    }
  }
  match parse_rfc3339_general_slice(s, start, end) {
    Ok(pair) =>
    match pair.0.to_timestamp() {
      Ok(ts) => {
        out[0] = ts.secs
        out[1] = ts.nanos.to_int64()
        true
      }
      Err(_) => false
    }
    Err(_) => false
  }
}

///| Zero-allocation RFC 3339 formatter from raw `(secs, nanos, offset_secs)` into `buf : Bytes`.
///| Returns the number of bytes written, or `-1` if any input is out of range or `buf` is too small.
pub fn format_rfc3339_raw_bytes(
  secs : Int64,
  nanos : Int,
  offset_secs : Int,
  buf : Bytes,
) -> Int {
  if secs < ts_min_secs ||
  secs > ts_max_secs ||
  nanos < 0 ||
  nanos > 999999999 ||
  offset_secs < offset_min_secs ||
  offset_secs > offset_max_secs ||
  buf.length() < 40 {
    return -1
  }
  let day_shift : Int64 = 4382910L
  let sec_shift : Int64 = 378683424000L
  let pos_sec = secs + offset_secs.to_int64() + sec_shift
  let ed_pos = pos_sec / 86400L
  let ed = (ed_pos - day_shift).to_int()
  let sod = (pos_sec - ed_pos * 86400L).to_int()
  let n = ed + 12699422
  let n1 = (n << 2) + 3
  let c = ((n1.to_int64() * 963315389L) >> 47).to_int()
  let nc = (n1 - c * 146097) >> 2
  let n2 = (nc << 2) + 3
  let z = ((2939745L * n2.to_int64()) >> 32).to_int()
  let ny = nc - ((1461 * z) >> 2)
  let y = 100 * c + z
  let n3 = 2141 * ny + 197913
  let m_raw = n3 >> 16
  let d = ((n3 & 65535) * 31345) >> 26
  let j = if ny >= 306 { 1 } else { 0 }
  let year = y - 32800 + j
  let month = if j == 1 { m_raw - 12 } else { m_raw }
  let day = d + 1
  let h = ((sod >> 4) * 9321) >> 21
  let rem = sod - h * 3600
  let mi = (rem * 17477) >> 20
  let sec = rem - mi * 60
  let mut p = 0
  let ay = if year < 0 {
    buf[0] = (45).to_byte()
    buf[1] = (48).to_byte()
    buf[2] = (48).to_byte()
    p = 3
    -year
  } else {
    year
  }
  let yhi = (ay * 41944) >> 22
  let ylo = ay - yhi * 100
  let yq0 = (yhi * 205) >> 11
  let yq1 = (ylo * 205) >> 11
  buf[p] = (48 + yq0).to_byte()
  buf[p + 1] = (48 + yhi - yq0 * 10).to_byte()
  buf[p + 2] = (48 + yq1).to_byte()
  buf[p + 3] = (48 + ylo - yq1 * 10).to_byte()
  buf[p + 4] = (45).to_byte()
  let mq = (month * 205) >> 11
  buf[p + 5] = (48 + mq).to_byte()
  buf[p + 6] = (48 + month - mq * 10).to_byte()
  buf[p + 7] = (45).to_byte()
  let dq = (day * 205) >> 11
  buf[p + 8] = (48 + dq).to_byte()
  buf[p + 9] = (48 + day - dq * 10).to_byte()
  buf[p + 10] = (84).to_byte()
  let hq = (h * 205) >> 11
  buf[p + 11] = (48 + hq).to_byte()
  buf[p + 12] = (48 + h - hq * 10).to_byte()
  buf[p + 13] = (58).to_byte()
  let miq = (mi * 205) >> 11
  buf[p + 14] = (48 + miq).to_byte()
  buf[p + 15] = (48 + mi - miq * 10).to_byte()
  buf[p + 16] = (58).to_byte()
  let sq = (sec * 205) >> 11
  buf[p + 17] = (48 + sq).to_byte()
  buf[p + 18] = (48 + sec - sq * 10).to_byte()
  p = p + 19
  if nanos != 0 {
    buf[p] = (46).to_byte()
    p = p + 1
    let hi3 = ((nanos.to_int64() * 1125899907L) >> 50).to_int()
    let r6 = nanos - hi3 * 1000000
    let hd0 = (hi3 * 41944) >> 22
    let hr0 = hi3 - hd0 * 100
    let hd1 = (hr0 * 205) >> 11
    let hd2 = hr0 - hd1 * 10
    if r6 == 0 {
      buf[p] = (48 + hd0).to_byte()
      p = p + 1
      if hr0 != 0 {
        buf[p] = (48 + hd1).to_byte()
        p = p + 1
        if hd2 != 0 {
          buf[p] = (48 + hd2).to_byte()
          p = p + 1
        }
      }
    } else {
      buf[p] = (48 + hd0).to_byte()
      buf[p + 1] = (48 + hd1).to_byte()
      buf[p + 2] = (48 + hd2).to_byte()
      p = p + 3
      let mid3 = ((r6.to_int64() * 4294968L) >> 32).to_int()
      let lo3 = r6 - mid3 * 1000
      let md0 = (mid3 * 41944) >> 22
      let mr0 = mid3 - md0 * 100
      let md1 = (mr0 * 205) >> 11
      let md2 = mr0 - md1 * 10
      if lo3 == 0 {
        buf[p] = (48 + md0).to_byte()
        p = p + 1
        if mr0 != 0 {
          buf[p] = (48 + md1).to_byte()
          p = p + 1
          if md2 != 0 {
            buf[p] = (48 + md2).to_byte()
            p = p + 1
          }
        }
      } else {
        buf[p] = (48 + md0).to_byte()
        buf[p + 1] = (48 + md1).to_byte()
        buf[p + 2] = (48 + md2).to_byte()
        p = p + 3
        let ld0 = (lo3 * 41944) >> 22
        let lr0 = lo3 - ld0 * 100
        let ld1 = (lr0 * 205) >> 11
        let ld2 = lr0 - ld1 * 10
        buf[p] = (48 + ld0).to_byte()
        p = p + 1
        if lr0 != 0 {
          buf[p] = (48 + ld1).to_byte()
          p = p + 1
          if ld2 != 0 {
            buf[p] = (48 + ld2).to_byte()
            p = p + 1
          }
        }
      }
    }
  }
  let mut osecs = offset_secs
  if osecs < 0 {
    buf[p] = (45).to_byte()
    osecs = -osecs
  } else {
    buf[p] = (43).to_byte()
  }
  let oh = ((osecs >> 4) * 9321) >> 21
  let orem = osecs - oh * 3600
  let om = (orem * 17477) >> 20
  let ohq = (oh * 205) >> 11
  buf[p + 1] = (48 + ohq).to_byte()
  buf[p + 2] = (48 + oh - ohq * 10).to_byte()
  buf[p + 3] = (58).to_byte()
  let omq = (om * 205) >> 11
  buf[p + 4] = (48 + omq).to_byte()
  buf[p + 5] = (48 + om - omq * 10).to_byte()
  p + 6
}

///|
pub fn Timestamp::write_rfc3339_bytes(
  self : Timestamp,
  offset : Offset,
  buf : Bytes,
) -> Int {
  format_rfc3339_raw_bytes(self.secs, self.nanos, offset.seconds, buf)
}

///|
pub fn Timestamp::to_rfc3339(self : Timestamp) -> String {
  let sb = StringBuilder::new()
  self.write_rfc3339(sb)
  sb.to_string()
}

///|
pub fn Timestamp::to_rfc3339_with_offset(
  self : Timestamp,
  offset : Offset,
) -> String {
  let sb = StringBuilder::new()
  self.write_rfc3339_with_offset(offset, sb)
  sb.to_string()
}

///|
pub fn FixedDateTime::write_rfc3339(
  self : FixedDateTime,
  sb : StringBuilder,
) -> Unit {
  write_date_to(sb, self.datetime.date)
  sb.write_byte((84).to_byte())
  write_time_to(sb, self.datetime.time)
  write_offset_hm_to(sb, self.offset)
}

///|
pub fn FixedDateTime::to_rfc3339(self : FixedDateTime) -> String {
  let sb = StringBuilder::new()
  self.write_rfc3339(sb)
  sb.to_string()
}

///|
fn parse_weekday_3(s : String, pos : Int) -> Option[Weekday] {
  if pos + 3 > s.length() {
    return None
  }
  let a = to_lower_ascii(s.code_unit_at(pos))
  let b = to_lower_ascii(s.code_unit_at(pos + 1))
  let c = to_lower_ascii(s.code_unit_at(pos + 2))
  if a == 109 && b == 111 && c == 110 {
    return Some(Weekday::Mon)
  }
  if a == 116 && b == 117 && c == 101 {
    return Some(Weekday::Tue)
  }
  if a == 119 && b == 101 && c == 100 {
    return Some(Weekday::Wed)
  }
  if a == 116 && b == 104 && c == 117 {
    return Some(Weekday::Thu)
  }
  if a == 102 && b == 114 && c == 105 {
    return Some(Weekday::Fri)
  }
  if a == 115 && b == 97 && c == 116 {
    return Some(Weekday::Sat)
  }
  if a == 115 && b == 117 && c == 110 {
    return Some(Weekday::Sun)
  }
  None
}

///|
fn parse_month_3(s : String, pos : Int) -> Int {
  if pos + 3 > s.length() {
    return -1
  }
  let a = to_lower_ascii(s.code_unit_at(pos))
  let b = to_lower_ascii(s.code_unit_at(pos + 1))
  let c = to_lower_ascii(s.code_unit_at(pos + 2))
  if a == 106 && b == 97 && c == 110 {
    return 1
  }
  if a == 102 && b == 101 && c == 98 {
    return 2
  }
  if a == 109 && b == 97 && c == 114 {
    return 3
  }
  if a == 97 && b == 112 && c == 114 {
    return 4
  }
  if a == 109 && b == 97 && c == 121 {
    return 5
  }
  if a == 106 && b == 117 && c == 110 {
    return 6
  }
  if a == 106 && b == 117 && c == 108 {
    return 7
  }
  if a == 97 && b == 117 && c == 103 {
    return 8
  }
  if a == 115 && b == 101 && c == 112 {
    return 9
  }
  if a == 111 && b == 99 && c == 116 {
    return 10
  }
  if a == 110 && b == 111 && c == 118 {
    return 11
  }
  if a == 100 && b == 101 && c == 99 {
    return 12
  }
  -1
}

///|
fn skip_ws(s : String, start : Int) -> Int {
  let len = s.length()
  let mut pos = start
  while pos < len && is_ws(s.code_unit_at(pos)) {
    pos = pos + 1
  }
  pos
}

///|
fn skip_rfc2822_comment(s : String, start : Int) -> Result[Int, TimeError] {
  let len = s.length()
  if start >= len || s.code_unit_at(start) != 40 {
    return Ok(start)
  }
  let mut pos = start + 1
  let mut depth = 1
  let mut esc = false
  while pos < len && depth > 0 {
    let c = s.code_unit_at(pos)
    pos = pos + 1
    if esc {
      esc = false
    } else if c == 92 {
      esc = true
    } else if c == 40 {
      depth = depth + 1
    } else if c == 41 {
      depth = depth - 1
    }
  }
  if depth != 0 {
    return Err(TimeError::new("PARSE_RFC2822", "unclosed comment"))
  }
  Ok(pos)
}

///|
fn parse_rfc2822_zone(s : String, start : Int) -> Result[(Offset, Int), TimeError] {
  let len = s.length()
  if start >= len {
    return Err(TimeError::new("PARSE_RFC2822", "missing time zone"))
  }
  let c0 = s.code_unit_at(start)
  if c0 == 43 || c0 == 45 {
    if start + 5 > len {
      return Err(TimeError::new("PARSE_RFC2822", "truncated numeric offset"))
    }
    let hh = parse_2_digits(s, start + 1)
    let mm = parse_2_digits(s, start + 3)
    if hh < 0 || hh > 25 || mm < 0 || mm > 59 {
      return Err(TimeError::new("PARSE_RFC2822", "invalid numeric offset"))
    }
    let mag = hh * 3600 + mm * 60
    let secs = if c0 == 45 { -mag } else { mag }
    return match Offset::from_seconds(secs) {
      Ok(o) => Ok((o, start + 5))
      Err(e) => Err(e)
    }
  }
  // Obsolete named zone (1..5 ASCII letters)
  let mut pos = start
  while pos < len && !is_ws(s.code_unit_at(pos)) && s.code_unit_at(pos) != 40 {
    let ch = to_lower_ascii(s.code_unit_at(pos))
    if ch < 97 || ch > 122 {
      return Err(TimeError::new("PARSE_RFC2822", "invalid obsolete zone character"))
    }
    pos = pos + 1
  }
  let zlen = pos - start
  if zlen == 0 || zlen > 5 {
    return Err(TimeError::new("PARSE_RFC2822", "invalid obsolete zone length"))
  }
  let a = to_lower_ascii(s.code_unit_at(start))
  if zlen == 1 {
    if a == 106 {
      return Err(TimeError::new("PARSE_RFC2822", "invalid military zone J"))
    }
    return Ok((Offset::utc(), pos))
  }
  let b = to_lower_ascii(s.code_unit_at(start + 1))
  if zlen == 2 {
    if a == 117 && b == 116 {
      return Ok((Offset::utc(), pos))
    }
    return Err(TimeError::new("PARSE_RFC2822", "unknown 2-letter zone"))
  }
  let c = to_lower_ascii(s.code_unit_at(start + 2))
  if zlen == 3 {
    // gmt, utc -> 0
    if a == 103 && b == 109 && c == 116 {
      return Ok((Offset::utc(), pos))
    }
    if a == 101 && b == 115 && c == 116 {
      return Ok((Offset::{ seconds: -18000 }, pos))
    }
    if a == 101 && b == 100 && c == 116 {
      return Ok((Offset::{ seconds: -14400 }, pos))
    }
    if a == 99 && b == 115 && c == 116 {
      return Ok((Offset::{ seconds: -21600 }, pos))
    }
    if a == 99 && b == 100 && c == 116 {
      return Ok((Offset::{ seconds: -18000 }, pos))
    }
    if a == 109 && b == 115 && c == 116 {
      return Ok((Offset::{ seconds: -25200 }, pos))
    }
    if a == 109 && b == 100 && c == 116 {
      return Ok((Offset::{ seconds: -21600 }, pos))
    }
    if a == 112 && b == 115 && c == 116 {
      return Ok((Offset::{ seconds: -28800 }, pos))
    }
    if a == 112 && b == 100 && c == 116 {
      return Ok((Offset::{ seconds: -25200 }, pos))
    }
  }
  // Per RFC 2822 §4.3, unknown 3..5 letter alphabetic zones map to -0000 (UTC)
  Ok((Offset::utc(), pos))
}

///|
pub fn FixedDateTime::parse_rfc2822(
  s : String,
) -> Result[FixedDateTime, TimeError] {
  let len = s.length()
  let mut pos = skip_ws(s, 0)
  if pos >= len {
    return Err(TimeError::new("PARSE_RFC2822", "empty input"))
  }
  // Optional weekday
  let mut parsed_wd : Option[Weekday] = None
  if !is_digit(s.code_unit_at(pos)) {
    match parse_weekday_3(s, pos) {
      None => return Err(TimeError::new("PARSE_RFC2822", "invalid weekday"))
      Some(wd) => {
        parsed_wd = Some(wd)
        pos = skip_ws(s, pos + 3)
        if pos >= len || s.code_unit_at(pos) != 44 {
          return Err(TimeError::new("PARSE_RFC2822", "expected ',' after weekday"))
        }
        pos = skip_ws(s, pos + 1)
      }
    }
  }
  // 1 or 2 digit day
  if pos >= len || !is_digit(s.code_unit_at(pos)) {
    return Err(TimeError::new("PARSE_RFC2822", "expected day"))
  }
  let mut day = s.code_unit_at(pos) - 48
  pos = pos + 1
  if pos < len && is_digit(s.code_unit_at(pos)) {
    day = day * 10 + (s.code_unit_at(pos) - 48)
    pos = pos + 1
  }
  let pos_after_day = skip_ws(s, pos)
  if pos_after_day == pos {
    return Err(TimeError::new("PARSE_RFC2822", "expected whitespace after day"))
  }
  pos = pos_after_day
  // 3-letter month
  let month = parse_month_3(s, pos)
  if month < 0 {
    return Err(TimeError::new("PARSE_RFC2822", "invalid month"))
  }
  pos = pos + 3
  let pos_after_mon = skip_ws(s, pos)
  if pos_after_mon == pos {
    return Err(TimeError::new("PARSE_RFC2822", "expected whitespace after month"))
  }
  pos = pos_after_mon
  // 2, 3, or 4 digit year
  let mut ydigits = 0
  let mut year = 0
  while pos < len && ydigits < 4 && is_digit(s.code_unit_at(pos)) {
    year = year * 10 + (s.code_unit_at(pos) - 48)
    ydigits = ydigits + 1
    pos = pos + 1
  }
  if ydigits < 2 {
    return Err(TimeError::new("PARSE_RFC2822", "year must be 2..=4 digits"))
  }
  if ydigits == 2 {
    if year <= 49 {
      year = year + 2000
    } else {
      year = year + 1900
    }
  } else if ydigits == 3 {
    year = year + 1900
  }
  let pos_after_yr = skip_ws(s, pos)
  if pos_after_yr == pos {
    return Err(TimeError::new("PARSE_RFC2822", "expected whitespace after year"))
  }
  pos = pos_after_yr
  // HH:MM(:SS)?
  if pos + 2 > len {
    return Err(TimeError::new("PARSE_RFC2822", "truncated hour"))
  }
  let hour = parse_2_digits(s, pos)
  if hour < 0 {
    return Err(TimeError::new("PARSE_RFC2822", "invalid hour"))
  }
  pos = skip_ws(s, pos + 2)
  if pos >= len || s.code_unit_at(pos) != 58 {
    return Err(TimeError::new("PARSE_RFC2822", "expected ':' after hour"))
  }
  pos = skip_ws(s, pos + 1)
  if pos + 2 > len {
    return Err(TimeError::new("PARSE_RFC2822", "truncated minute"))
  }
  let minute = parse_2_digits(s, pos)
  if minute < 0 {
    return Err(TimeError::new("PARSE_RFC2822", "invalid minute"))
  }
  pos = pos + 2
  let ws_after_min = skip_ws(s, pos)
  let mut second = 0
  if ws_after_min < len && s.code_unit_at(ws_after_min) == 58 {
    pos = skip_ws(s, ws_after_min + 1)
    if pos + 2 > len {
      return Err(TimeError::new("PARSE_RFC2822", "truncated second"))
    }
    let mut sec = parse_2_digits(s, pos)
    if sec < 0 || sec > 60 {
      return Err(TimeError::new("PARSE_RFC2822", "invalid second"))
    }
    if sec == 60 {
      sec = 59
    }
    second = sec
    pos = pos + 2
    let ws_after_sec = skip_ws(s, pos)
    if ws_after_sec == pos {
      return Err(TimeError::new("PARSE_RFC2822", "expected whitespace after time"))
    }
    pos = ws_after_sec
  } else {
    if ws_after_min == pos {
      return Err(TimeError::new("PARSE_RFC2822", "expected whitespace after time"))
    }
    pos = ws_after_min
  }
  let zpair = match parse_rfc2822_zone(s, pos) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let offset = zpair.0
  pos = skip_ws(s, zpair.1)
  while pos < len && s.code_unit_at(pos) == 40 {
    match skip_rfc2822_comment(s, pos) {
      Ok(np) => pos = skip_ws(s, np)
      Err(e) => return Err(e)
    }
  }
  if pos != len {
    return Err(TimeError::new("PARSE_RFC2822", "trailing characters in RFC 2822"))
  }
  let d = match Date::new(year, month, day) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let t = match Time::new(hour, minute, second, 0) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match parsed_wd {
    Some(wd) =>
    if !weekday_eq(wd, d.weekday()) {
      return Err(TimeError::new("INCONSISTENT_WEEKDAY", "weekday does not match date"))
    }
    None => ()
  }
  Ok(FixedDateTime::{ datetime: DateTime::{ date: d, time: t }, offset: offset })
}

///|
pub fn Timestamp::parse_rfc2822(s : String) -> Result[Timestamp, TimeError] {
  match FixedDateTime::parse_rfc2822(s) {
    Ok(fdt) => fdt.to_timestamp()
    Err(e) => Err(e)
  }
}

///|
fn write_rfc2822_core(sb : StringBuilder, dt : DateTime) -> Unit {
  sb.write_string(weekday_to_short_name(dt.date.weekday()))
  sb.write_string(", ")
  write_2d(sb, dt.date.day)
  sb.write_byte((32).to_byte())
  sb.write_string(month_short_name(dt.date.month))
  sb.write_byte((32).to_byte())
  write_4d(sb, dt.date.year)
  sb.write_byte((32).to_byte())
  write_2d(sb, dt.time.hour)
  sb.write_byte((58).to_byte())
  write_2d(sb, dt.time.minute)
  sb.write_byte((58).to_byte())
  write_2d(sb, dt.time.second)
  sb.write_byte((32).to_byte())
}

///|
pub fn Timestamp::to_rfc2822(self : Timestamp) -> String {
  let dt = Offset::utc().to_datetime(self)
  let sb = StringBuilder::new()
  write_rfc2822_core(sb, dt)
  sb.write_string("-0000")
  sb.to_string()
}

///|
pub fn FixedDateTime::to_rfc2822(self : FixedDateTime) -> String {
  let sb = StringBuilder::new()
  write_rfc2822_core(sb, self.datetime)
  write_offset_to(sb, self.offset, false)
  sb.to_string()
}

///|
fn parse_weekday_full(s : String, pos : Int) -> Option[(Weekday, Int)] {
  let len = s.length()
  if pos + 6 <= len &&
  s.code_unit_at(pos) == 77 &&
  s.code_unit_at(pos + 1) == 111 &&
  s.code_unit_at(pos + 2) == 110 &&
  s.code_unit_at(pos + 3) == 100 &&
  s.code_unit_at(pos + 4) == 97 &&
  s.code_unit_at(pos + 5) == 121 {
    return Some((Weekday::Mon, pos + 6))
  }
  if pos + 7 <= len &&
  s.code_unit_at(pos) == 84 &&
  s.code_unit_at(pos + 1) == 117 &&
  s.code_unit_at(pos + 2) == 101 &&
  s.code_unit_at(pos + 3) == 115 &&
  s.code_unit_at(pos + 4) == 100 &&
  s.code_unit_at(pos + 5) == 97 &&
  s.code_unit_at(pos + 6) == 121 {
    return Some((Weekday::Tue, pos + 7))
  }
  if pos + 9 <= len &&
  s.code_unit_at(pos) == 87 &&
  s.code_unit_at(pos + 1) == 101 &&
  s.code_unit_at(pos + 2) == 100 &&
  s.code_unit_at(pos + 3) == 110 &&
  s.code_unit_at(pos + 4) == 101 &&
  s.code_unit_at(pos + 5) == 115 &&
  s.code_unit_at(pos + 6) == 100 &&
  s.code_unit_at(pos + 7) == 97 &&
  s.code_unit_at(pos + 8) == 121 {
    return Some((Weekday::Wed, pos + 9))
  }
  if pos + 8 <= len &&
  s.code_unit_at(pos) == 84 &&
  s.code_unit_at(pos + 1) == 104 &&
  s.code_unit_at(pos + 2) == 117 &&
  s.code_unit_at(pos + 3) == 114 &&
  s.code_unit_at(pos + 4) == 115 &&
  s.code_unit_at(pos + 5) == 100 &&
  s.code_unit_at(pos + 6) == 97 &&
  s.code_unit_at(pos + 7) == 121 {
    return Some((Weekday::Thu, pos + 8))
  }
  if pos + 6 <= len &&
  s.code_unit_at(pos) == 70 &&
  s.code_unit_at(pos + 1) == 114 &&
  s.code_unit_at(pos + 2) == 105 &&
  s.code_unit_at(pos + 3) == 100 &&
  s.code_unit_at(pos + 4) == 97 &&
  s.code_unit_at(pos + 5) == 121 {
    return Some((Weekday::Fri, pos + 6))
  }
  if pos + 8 <= len &&
  s.code_unit_at(pos) == 83 &&
  s.code_unit_at(pos + 1) == 97 &&
  s.code_unit_at(pos + 2) == 116 &&
  s.code_unit_at(pos + 3) == 117 &&
  s.code_unit_at(pos + 4) == 114 &&
  s.code_unit_at(pos + 5) == 100 &&
  s.code_unit_at(pos + 6) == 97 &&
  s.code_unit_at(pos + 7) == 121 {
    return Some((Weekday::Sat, pos + 8))
  }
  if pos + 6 <= len &&
  s.code_unit_at(pos) == 83 &&
  s.code_unit_at(pos + 1) == 117 &&
  s.code_unit_at(pos + 2) == 110 &&
  s.code_unit_at(pos + 3) == 100 &&
  s.code_unit_at(pos + 4) == 97 &&
  s.code_unit_at(pos + 5) == 121 {
    return Some((Weekday::Sun, pos + 6))
  }
  None
}

///| Parse all three RFC 9110 §5.6.7 HTTP-date formats:
///| 1. IMF-fixdate: `Sun, 06 Nov 1994 08:49:37 GMT`
///| 2. Obsolete RFC 850: `Sunday, 06-Nov-94 08:49:37 GMT`
///| 3. ANSI C asctime(): `Sun Nov  6 08:49:37 1994`
pub fn Timestamp::parse_http_date(s : String) -> Result[Timestamp, TimeError] {
  let len = s.length()
  // 1. IMF-fixdate (always 29 bytes)
  if len == 29 && s.code_unit_at(3) == 44 && s.code_unit_at(4) == 32 {
    let wd = match parse_weekday_3(s, 0) {
      Some(w) => w
      None => return Err(TimeError::new("PARSE_HTTP_DATE", "invalid weekday"))
    }
    let day = parse_2_digits(s, 5)
    if day < 0 || s.code_unit_at(7) != 32 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "invalid 2-digit day"))
    }
    let month = parse_month_3(s, 8)
    if month < 0 || s.code_unit_at(11) != 32 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "invalid month"))
    }
    let year = parse_4_digits(s, 12)
    if year < 0 || s.code_unit_at(16) != 32 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "invalid 4-digit year"))
    }
    let hour = parse_2_digits(s, 17)
    if hour < 0 || s.code_unit_at(19) != 58 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "invalid hour"))
    }
    let minute = parse_2_digits(s, 20)
    if minute < 0 || s.code_unit_at(22) != 58 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "invalid minute"))
    }
    let second = parse_2_digits(s, 23)
    if second < 0 || s.code_unit_at(25) != 32 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "invalid second"))
    }
    if s.code_unit_at(26) != 71 || s.code_unit_at(27) != 77 || s.code_unit_at(28) != 84 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "IMF-fixdate must end with 'GMT'"))
    }
    let d = match Date::new(year, month, day) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !weekday_eq(wd, d.weekday()) {
      return Err(TimeError::new("INCONSISTENT_WEEKDAY", "weekday does not match date"))
    }
    let t = match Time::new(hour, minute, second, 0) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Offset::utc().to_timestamp(DateTime::{ date: d, time: t })
  }
  // 2. ANSI C asctime(): "Sun Nov  6 08:49:37 1994" (24 bytes)
  if len == 24 && s.code_unit_at(3) == 32 && s.code_unit_at(7) == 32 {
    let wd = match parse_weekday_3(s, 0) {
      Some(w) => w
      None => return Err(TimeError::new("PARSE_HTTP_DATE", "invalid asctime weekday"))
    }
    let month = parse_month_3(s, 4)
    if month < 0 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "invalid asctime month"))
    }
    let d0 = s.code_unit_at(8)
    let d1 = s.code_unit_at(9) - 48
    let day = if d0 == 32 {
      if d1 < 0 || d1 > 9 {
        return Err(TimeError::new("PARSE_HTTP_DATE", "invalid asctime day"))
      }
      d1
    } else {
      let dd = parse_2_digits(s, 8)
      if dd < 0 {
        return Err(TimeError::new("PARSE_HTTP_DATE", "invalid asctime day"))
      }
      dd
    }
    if s.code_unit_at(10) != 32 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "expected space after asctime day"))
    }
    let hour = parse_2_digits(s, 11)
    if hour < 0 || s.code_unit_at(13) != 58 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "invalid asctime hour"))
    }
    let minute = parse_2_digits(s, 14)
    if minute < 0 || s.code_unit_at(16) != 58 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "invalid asctime minute"))
    }
    let second = parse_2_digits(s, 17)
    if second < 0 || s.code_unit_at(19) != 32 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "invalid asctime second"))
    }
    let year = parse_4_digits(s, 20)
    if year < 0 {
      return Err(TimeError::new("PARSE_HTTP_DATE", "invalid asctime year"))
    }
    let d = match Date::new(year, month, day) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !weekday_eq(wd, d.weekday()) {
      return Err(TimeError::new("INCONSISTENT_WEEKDAY", "weekday does not match date"))
    }
    let t = match Time::new(hour, minute, second, 0) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return Offset::utc().to_timestamp(DateTime::{ date: d, time: t })
  }
  // 3. Obsolete RFC 850: "Sunday, 06-Nov-94 08:49:37 GMT"
  match parse_weekday_full(s, 0) {
    Some(pair) => {
      let wd = pair.0
      let p = pair.1
      // Remaining must be ", DD-Mon-YY HH:MM:SS GMT" (24 bytes)
      if p + 24 != len {
        return Err(TimeError::new("PARSE_HTTP_DATE", "invalid RFC 850 length"))
      }
      if s.code_unit_at(p) != 44 || s.code_unit_at(p + 1) != 32 {
        return Err(TimeError::new("PARSE_HTTP_DATE", "expected ', ' after RFC 850 weekday"))
      }
      let day = parse_2_digits(s, p + 2)
      if day < 0 || s.code_unit_at(p + 4) != 45 {
        return Err(TimeError::new("PARSE_HTTP_DATE", "invalid RFC 850 day"))
      }
      let month = parse_month_3(s, p + 5)
      if month < 0 || s.code_unit_at(p + 8) != 45 {
        return Err(TimeError::new("PARSE_HTTP_DATE", "invalid RFC 850 month"))
      }
      let yy = parse_2_digits(s, p + 9)
      if yy < 0 || s.code_unit_at(p + 11) != 32 {
        return Err(TimeError::new("PARSE_HTTP_DATE", "invalid RFC 850 2-digit year"))
      }
      let year = if yy <= 69 { 2000 + yy } else { 1900 + yy }
      let hour = parse_2_digits(s, p + 12)
      if hour < 0 || s.code_unit_at(p + 14) != 58 {
        return Err(TimeError::new("PARSE_HTTP_DATE", "invalid RFC 850 hour"))
      }
      let minute = parse_2_digits(s, p + 15)
      if minute < 0 || s.code_unit_at(p + 17) != 58 {
        return Err(TimeError::new("PARSE_HTTP_DATE", "invalid RFC 850 minute"))
      }
      let second = parse_2_digits(s, p + 18)
      if second < 0 || s.code_unit_at(p + 20) != 32 {
        return Err(TimeError::new("PARSE_HTTP_DATE", "invalid RFC 850 second"))
      }
      if s.code_unit_at(p + 21) != 71 ||
      s.code_unit_at(p + 22) != 77 ||
      s.code_unit_at(p + 23) != 84 {
        return Err(TimeError::new("PARSE_HTTP_DATE", "RFC 850 date must end with 'GMT'"))
      }
      let d = match Date::new(year, month, day) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if !weekday_eq(wd, d.weekday()) {
        return Err(TimeError::new("INCONSISTENT_WEEKDAY", "weekday does not match date"))
      }
      let t = match Time::new(hour, minute, second, 0) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      Offset::utc().to_timestamp(DateTime::{ date: d, time: t })
    }
    None => Err(TimeError::new("PARSE_HTTP_DATE", "unrecognized HTTP-date format"))
  }
}

///|
pub fn Timestamp::to_http_date(self : Timestamp) -> String {
  let dt = Offset::utc().to_datetime(self)
  let sb = StringBuilder::new()
  write_rfc2822_core(sb, dt)
  sb.write_string("GMT")
  sb.to_string()
}

///|
fn parse_u64_at(s : String, start : Int) -> Result[(Int64, Int, Int), TimeError] {
  let len = s.length()
  let mut pos = start
  let mut acc : Int64 = 0L
  let mut digits = 0
  while pos < len && is_digit(s.code_unit_at(pos)) {
    let d = (s.code_unit_at(pos) - 48).to_int64()
    if acc > (i64_max - d) / 10L {
      return Err(TimeError::new("OVERFLOW", "integer overflow in ISO duration"))
    }
    acc = acc * 10L + d
    digits = digits + 1
    pos = pos + 1
  }
  Ok((acc, digits, pos))
}

///| Accumulate unsigned digits negatively into `Int64` so `i64_min` (-9223372036854775808) fits without overflow.
fn parse_neg_i64_at(s : String, start : Int) -> Result[(Int64, Int, Int), TimeError] {
  let len = s.length()
  let mut pos = start
  let mut acc : Int64 = 0L
  let mut digits = 0
  while pos < len && is_digit(s.code_unit_at(pos)) {
    let d = (s.code_unit_at(pos) - 48).to_int64()
    if acc < (i64_min + d) / 10L {
      return Err(TimeError::new("OVERFLOW", "integer overflow in ISO duration"))
    }
    acc = acc * 10L - d
    digits = digits + 1
    pos = pos + 1
  }
  Ok((acc, digits, pos))
}

///|
pub fn SignedDuration::parse_iso(
  s : String,
) -> Result[SignedDuration, TimeError] {
  let len = s.length()
  if len < 3 {
    return Err(TimeError::new("PARSE_DURATION", "ISO duration too short"))
  }
  let mut pos = 0
  let mut neg = false
  let first = s.code_unit_at(0)
  if first == 45 {
    neg = true
    pos = 1
  } else if first == 43 {
    pos = 1
  }
  if pos >= len {
    return Err(TimeError::new("PARSE_DURATION", "expected 'P'"))
  }
  let p = s.code_unit_at(pos)
  if p != 80 && p != 112 {
    return Err(TimeError::new("PARSE_DURATION", "expected 'P' designator"))
  }
  pos = pos + 1
  if pos >= len {
    return Err(TimeError::new("PARSE_DURATION", "expected 'T' designator"))
  }
  let t = s.code_unit_at(pos)
  if t != 84 && t != 116 {
    return Err(TimeError::new("PARSE_DURATION", "SignedDuration only accepts time units (PT...)"))
  }
  pos = pos + 1
  if pos >= len {
    return Err(TimeError::new("PARSE_DURATION", "expected time units after 'PT'"))
  }
  let mut total_secs : Int64 = 0L
  let mut total_nanos : Int = 0
  // order: H=1, M=2, S=3
  let mut last_unit = 0
  let mut any_unit = false
  while pos < len {
    // Accumulate negatively so -PT9223372036854775808S / SignedDuration::min() never overflows.
    let up = match parse_neg_i64_at(s, pos) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let neg_num = up.0
    let digits = up.1
    pos = up.2
    if digits == 0 {
      return Err(TimeError::new("PARSE_DURATION", "expected number in ISO duration"))
    }
    let mut frac = 0
    let mut has_frac = false
    if pos < len && (s.code_unit_at(pos) == 46 || s.code_unit_at(pos) == 44) {
      has_frac = true
      match parse_fraction_at(s, pos, true) {
        Ok(fp) => {
          frac = fp.0
          pos = fp.1
        }
        Err(e) => return Err(e)
      }
    }
    if pos >= len {
      return Err(TimeError::new("PARSE_DURATION", "missing unit designator"))
    }
    let u = to_lower_ascii(s.code_unit_at(pos))
    pos = pos + 1
    let cur_unit = if u == 104 {
      1
    } else if u == 109 {
      2
    } else if u == 115 {
      3
    } else {
      return Err(TimeError::new("PARSE_DURATION", "invalid time unit designator"))
    }
    if cur_unit <= last_unit {
      return Err(TimeError::new("PARSE_DURATION", "duration units out of order or duplicated"))
    }
    last_unit = cur_unit
    any_unit = true
    if cur_unit == 1 {
      let s_add = match checked_mul_i64(neg_num, 3600L) {
        Some(v) => v
        None => return Err(TimeError::new("OVERFLOW", "hours overflow"))
      }
      total_secs = match checked_add_i64(total_secs, s_add) {
        Some(v) => v
        None => return Err(TimeError::new("OVERFLOW", "duration overflow"))
      }
      if has_frac {
        let f_ns = frac.to_int64() * 3600L
        let f_s = f_ns / 1000000000L
        let f_r = (f_ns % 1000000000L).to_int()
        total_secs = match checked_sub_i64(total_secs, f_s) {
          Some(v) => v
          None => return Err(TimeError::new("OVERFLOW", "duration overflow"))
        }
        total_nanos = total_nanos - f_r
      }
    } else if cur_unit == 2 {
      let s_add = match checked_mul_i64(neg_num, 60L) {
        Some(v) => v
        None => return Err(TimeError::new("OVERFLOW", "minutes overflow"))
      }
      total_secs = match checked_add_i64(total_secs, s_add) {
        Some(v) => v
        None => return Err(TimeError::new("OVERFLOW", "duration overflow"))
      }
      if has_frac {
        let f_ns = frac.to_int64() * 60L
        let f_s = f_ns / 1000000000L
        let f_r = (f_ns % 1000000000L).to_int()
        total_secs = match checked_sub_i64(total_secs, f_s) {
          Some(v) => v
          None => return Err(TimeError::new("OVERFLOW", "duration overflow"))
        }
        total_nanos = total_nanos - f_r
      }
    } else {
      total_secs = match checked_add_i64(total_secs, neg_num) {
        Some(v) => v
        None => return Err(TimeError::new("OVERFLOW", "duration overflow"))
      }
      total_nanos = total_nanos - frac
    }
    if has_frac && pos < len {
      return Err(TimeError::new("PARSE_DURATION", "unexpected units after fractional unit"))
    }
  }
  if !any_unit {
    return Err(TimeError::new("PARSE_DURATION", "empty duration"))
  }
  let neg_dur = match SignedDuration::new(total_secs, total_nanos) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  if neg {
    Ok(neg_dur)
  } else {
    neg_dur.checked_neg()
  }
}

///|
fn write_i64_digits(sb : StringBuilder, v : Int64) -> Unit {
  sb.write_string(v.to_string())
}

///|
pub fn SignedDuration::to_iso_string(self : SignedDuration) -> String {
  // Defensively normalize mismatched signs (e.g. direct struct literal construction).
  let mut s = self.secs
  let mut n = self.nanos
  if n <= -1000000000 || n >= 1000000000 || (s < 0L && n > 0) || (s > 0L && n < 0) {
    match SignedDuration::new(s, n) {
      Ok(norm) => {
        s = norm.secs
        n = norm.nanos
      }
      Err(_) => return ""
    }
  }
  if s == 0L && n == 0 {
    return "PT0S"
  }
  let sb = StringBuilder::new()
  let is_neg = s < 0L || n < 0
  if is_neg {
    sb.write_byte((45).to_byte())
  }
  sb.write_string("PT")
  // Divide before negating so i64::MIN (-9223372036854775808) never overflows.
  let hours = if is_neg { -(s / 3600L) } else { s / 3600L }
  let rem = if is_neg { -(s % 3600L) } else { s % 3600L }
  let mins = rem / 60L
  let secs = rem % 60L
  let abs_n = if is_neg { -n } else { n }
  if hours > 0L {
    write_i64_digits(sb, hours)
    sb.write_byte((72).to_byte())
  }
  if mins > 0L {
    write_i64_digits(sb, mins)
    sb.write_byte((77).to_byte())
  }
  if secs > 0L || abs_n > 0 {
    write_i64_digits(sb, secs)
    write_fraction_trimmed(sb, abs_n)
    sb.write_byte((83).to_byte())
  }
  sb.to_string()
}

///|
pub fn IsoDuration::parse(s : String) -> Result[IsoDuration, TimeError] {
  let len = s.length()
  if len < 2 {
    return Err(TimeError::new("PARSE_ISO_DURATION", "ISO duration too short"))
  }
  let mut pos = 0
  let mut neg = false
  let first = s.code_unit_at(0)
  if first == 45 {
    neg = true
    pos = 1
  } else if first == 43 {
    pos = 1
  }
  if pos >= len || (s.code_unit_at(pos) != 80 && s.code_unit_at(pos) != 112) {
    return Err(TimeError::new("PARSE_ISO_DURATION", "expected 'P'"))
  }
  pos = pos + 1
  if pos >= len {
    return Err(TimeError::new("PARSE_ISO_DURATION", "empty duration after 'P'"))
  }
  let mut years = 0
  let mut months = 0
  let mut weeks = 0
  let mut days = 0
  let mut hours = 0
  let mut minutes = 0
  let mut seconds : Int64 = 0L
  let mut nanos = 0
  let mut in_time = false
  let mut last_date_unit = 0
  let mut last_time_unit = 0
  let mut any_unit = false
  let mut any_time_unit = false
  while pos < len {
    let ch = s.code_unit_at(pos)
    if !in_time && (ch == 84 || ch == 116) {
      in_time = true
      pos = pos + 1
      if pos >= len {
        return Err(TimeError::new("PARSE_ISO_DURATION", "expected time units after 'T'"))
      }
      continue
    }
    let up = match parse_u64_at(s, pos) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let num = up.0
    let digits = up.1
    pos = up.2
    if digits == 0 {
      return Err(TimeError::new("PARSE_ISO_DURATION", "expected digits in duration"))
    }
    let mut frac = 0
    let mut has_frac = false
    if in_time && pos < len && (s.code_unit_at(pos) == 46 || s.code_unit_at(pos) == 44) {
      has_frac = true
      match parse_fraction_at(s, pos, true) {
        Ok(fp) => {
          frac = fp.0
          pos = fp.1
        }
        Err(e) => return Err(e)
      }
    }
    if pos >= len {
      return Err(TimeError::new("PARSE_ISO_DURATION", "missing unit designator"))
    }
    let u = to_lower_ascii(s.code_unit_at(pos))
    pos = pos + 1
    if !in_time {
      let cur = if u == 121 {
        1
      } else if u == 109 {
        2
      } else if u == 119 {
        3
      } else if u == 100 {
        4
      } else {
        return Err(TimeError::new("PARSE_ISO_DURATION", "invalid date unit"))
      }
      if cur <= last_date_unit {
        return Err(TimeError::new("PARSE_ISO_DURATION", "date units out of order or duplicated"))
      }
      last_date_unit = cur
      any_unit = true
      if cur == 1 {
        if num > 19998L {
          return Err(TimeError::new("OUT_OF_RANGE", "years exceed maximum 19998"))
        }
        years = num.to_int()
      } else if cur == 2 {
        if num > 239976L {
          return Err(TimeError::new("OUT_OF_RANGE", "months exceed maximum 239976"))
        }
        months = num.to_int()
      } else if cur == 3 {
        if num > 1043497L {
          return Err(TimeError::new("OUT_OF_RANGE", "weeks exceed maximum 1043497"))
        }
        weeks = num.to_int()
      } else {
        if num > 7304484L {
          return Err(TimeError::new("OUT_OF_RANGE", "days exceed maximum 7304484"))
        }
        days = num.to_int()
      }
    } else {
      let cur = if u == 104 {
        1
      } else if u == 109 {
        2
      } else if u == 115 {
        3
      } else {
        return Err(TimeError::new("PARSE_ISO_DURATION", "invalid time unit"))
      }
      if cur <= last_time_unit {
        return Err(TimeError::new("PARSE_ISO_DURATION", "time units out of order or duplicated"))
      }
      last_time_unit = cur
      any_unit = true
      any_time_unit = true
      if cur == 1 {
        if num > 175307616L {
          return Err(TimeError::new("OUT_OF_RANGE", "hours exceed maximum 175307616"))
        }
        hours = num.to_int()
        if has_frac {
          let f_ns = frac.to_int64() * 3600L
          let f_secs = f_ns / 1000000000L
          let f_mins = (f_secs / 60L).to_int()
          let rem_secs = f_secs % 60L
          minutes = minutes + f_mins
          seconds = seconds + rem_secs
          nanos = (f_ns % 1000000000L).to_int()
        }
      } else if cur == 2 {
        if num > 2147483647L {
          return Err(TimeError::new("OUT_OF_RANGE", "minutes exceed maximum Int"))
        }
        minutes = num.to_int()
        if has_frac {
          let f_ns = frac.to_int64() * 60L
          seconds = seconds + f_ns / 1000000000L
          nanos = (f_ns % 1000000000L).to_int()
        }
      } else {
        if num > 631107417600L {
          return Err(TimeError::new("OUT_OF_RANGE", "seconds exceed maximum 631107417600"))
        }
        seconds = num
        nanos = frac
      }
      if has_frac && pos < len {
        return Err(TimeError::new("PARSE_ISO_DURATION", "unexpected units after fraction"))
      }
    }
  }
  if !any_unit || (in_time && !any_time_unit) {
    return Err(TimeError::new("PARSE_ISO_DURATION", "incomplete ISO duration"))
  }
  let all_zero = years == 0 && months == 0 && weeks == 0 && days == 0 && hours == 0 && minutes == 0 && seconds == 0L && nanos == 0
  Ok(IsoDuration::{
    negative: if all_zero { false } else { neg },
    years: years,
    months: months,
    weeks: weeks,
    days: days,
    hours: hours,
    minutes: minutes,
    seconds: seconds,
    nanoseconds: nanos,
  })
}

///|
pub fn IsoDuration::to_string(self : IsoDuration) -> String {
  let has_date = self.years != 0 || self.months != 0 || self.weeks != 0 || self.days != 0
  let has_time = self.hours != 0 || self.minutes != 0 || self.seconds != 0L || self.nanoseconds != 0
  if !has_date && !has_time {
    return "PT0S"
  }
  let sb = StringBuilder::new()
  if self.negative {
    sb.write_byte((45).to_byte())
  }
  sb.write_byte((80).to_byte())
  if self.years != 0 {
    sb.write_string(self.years.to_string())
    sb.write_byte((89).to_byte())
  }
  if self.months != 0 {
    sb.write_string(self.months.to_string())
    sb.write_byte((77).to_byte())
  }
  if self.weeks != 0 {
    sb.write_string(self.weeks.to_string())
    sb.write_byte((87).to_byte())
  }
  if self.days != 0 {
    sb.write_string(self.days.to_string())
    sb.write_byte((68).to_byte())
  }
  if has_time {
    sb.write_byte((84).to_byte())
    if self.hours != 0 {
      sb.write_string(self.hours.to_string())
      sb.write_byte((72).to_byte())
    }
    if self.minutes != 0 {
      sb.write_string(self.minutes.to_string())
      sb.write_byte((77).to_byte())
    }
    if self.seconds != 0L || self.nanoseconds != 0 {
      write_i64_digits(sb, self.seconds)
      write_fraction_trimmed(sb, self.nanoseconds)
      sb.write_byte((83).to_byte())
    }
  }
  sb.to_string()
}

///|
pub fn IsoDuration::to_signed_duration(
  self : IsoDuration,
) -> Result[SignedDuration, TimeError] {
  if self.years != 0 || self.months != 0 || self.weeks != 0 || self.days != 0 {
    return Err(TimeError::new("CALENDAR_UNITS", "cannot convert calendar units to SignedDuration"))
  }
  let total_s = self.hours.to_int64() * 3600L + self.minutes.to_int64() * 60L + self.seconds
  let d = match SignedDuration::new(total_s, self.nanoseconds) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if self.negative {
    d.checked_neg()
  } else {
    Ok(d)
  }
}

///|
pub fn IsoDuration::eq(self : IsoDuration, other : IsoDuration) -> Bool {
  self.negative == other.negative &&
  self.years == other.years &&
  self.months == other.months &&
  self.weeks == other.weeks &&
  self.days == other.days &&
  self.hours == other.hours &&
  self.minutes == other.minutes &&
  self.seconds == other.seconds &&
  self.nanoseconds == other.nanoseconds
}
