///| Offset, Timestamp, FixedDateTime, and SignedDuration implementations.

///|
let offset_min_secs : Int = -93599

///|
let offset_max_secs : Int = 93599

///|
let ts_min_secs : Int64 = -377705023201L

///|
let ts_max_secs : Int64 = 253402207200L

///|
let i64_max : Int64 = 9223372036854775807L

///|
let i64_min : Int64 = -9223372036854775807L - 1L

///|
#verify
fn checked_add_i64(a : Int64, b : Int64) -> Option[Int64] {
  if b > 0L && a > i64_max - b {
    return None
  }
  if b < 0L && a < (-9223372036854775807L - 1L) - b {
    return None
  }
  Some(a + b)
}

///|
#verify
fn checked_sub_i64(a : Int64, b : Int64) -> Option[Int64] {
  if b < 0L && a > i64_max + b {
    return None
  }
  if b > 0L && a < (-9223372036854775807L - 1L) + b {
    return None
  }
  Some(a - b)
}

///|
fn checked_mul_i64(a : Int64, b : Int64) -> Option[Int64] {
  if a == 0L || b == 0L {
    return Some(0L)
  }
  if a == i64_min && b == -1L {
    return None
  }
  if b == i64_min && a == -1L {
    return None
  }
  let res = a * b
  if res / b != a {
    return None
  }
  Some(res)
}

///|
pub fn Offset::utc() -> Offset {
  Offset::{ seconds: 0 }
}

///|
pub fn Offset::min() -> Offset {
  Offset::{ seconds: offset_min_secs }
}

///|
pub fn Offset::max() -> Offset {
  Offset::{ seconds: offset_max_secs }
}

///|
pub fn Offset::from_seconds(seconds : Int) -> Result[Offset, TimeError] {
  if seconds < offset_min_secs || seconds > offset_max_secs {
    return Err(TimeError::new("INVALID_OFFSET", "offset seconds must be in -93599..=93599"))
  }
  Ok(Offset::{ seconds: seconds })
}

///|
pub fn Offset::from_hours(hours : Int) -> Result[Offset, TimeError] {
  if hours < -25 || hours > 25 {
    return Err(TimeError::new("INVALID_OFFSET", "offset hours must be in -25..=25"))
  }
  Ok(Offset::{ seconds: hours * 3600 })
}

///|
pub fn Offset::from_hms(
  hours : Int,
  minutes : Int,
  seconds : Int,
) -> Result[Offset, TimeError] {
  if hours < -25 || hours > 25 {
    return Err(TimeError::new("INVALID_OFFSET", "offset hours must be in -25..=25"))
  }
  if minutes < -59 || minutes > 59 {
    return Err(TimeError::new("INVALID_OFFSET", "offset minutes must be in -59..=59"))
  }
  if seconds < -59 || seconds > 59 {
    return Err(TimeError::new("INVALID_OFFSET", "offset seconds must be in -59..=59"))
  }
  let has_pos = hours > 0 || minutes > 0 || seconds > 0
  let has_neg = hours < 0 || minutes < 0 || seconds < 0
  if has_pos && has_neg {
    return Err(TimeError::new("INVALID_OFFSET", "offset components must have consistent signs"))
  }
  Offset::from_seconds(hours * 3600 + minutes * 60 + seconds)
}

///|
pub fn Offset::negate(self : Offset) -> Offset {
  Offset::{ seconds: -self.seconds }
}

///|
pub fn Offset::to_datetime(self : Offset, ts : Timestamp) -> DateTime {
  // Shift comfortably into positive domain: 30 * 400 years = 4,382,910 days.
  let day_shift : Int64 = 4382910L
  let sec_shift : Int64 = 378683424000L
  let pos_sec = ts.secs + self.seconds.to_int64() + sec_shift
  let ed_pos = pos_sec / 86400L
  let ed = (ed_pos - day_shift).to_int()
  let sod = (pos_sec - ed_pos * 86400L).to_int()
  let h = ((sod >> 4) * 9321) >> 21
  let rem = sod - h * 3600
  let m = (rem * 17477) >> 20
  let s = rem - m * 60
  DateTime::{
    date: date_from_epoch_days_unchecked(ed),
    time: Time::{ hour: h, minute: m, second: s, nanosecond: ts.nanos },
  }
}

///|
pub fn Offset::to_timestamp(
  self : Offset,
  dt : DateTime,
) -> Result[Timestamp, TimeError] {
  let ed = dt.date.to_epoch_days().to_int64()
  let secs = ed * 86400L + dt.time.to_second_of_day().to_int64() - self.seconds.to_int64()
  if secs < ts_min_secs || secs > ts_max_secs {
    return Err(TimeError::new("OUT_OF_RANGE", "timestamp out of supported range"))
  }
  Ok(Timestamp::{ secs: secs, nanos: dt.time.nanosecond })
}

///|
pub fn Offset::eq(self : Offset, other : Offset) -> Bool {
  self.seconds == other.seconds
}

///|
pub fn Timestamp::unix_epoch() -> Timestamp {
  Timestamp::{ secs: 0L, nanos: 0 }
}

///|
pub fn Timestamp::min() -> Timestamp {
  Timestamp::{ secs: ts_min_secs, nanos: 0 }
}

///|
pub fn Timestamp::max() -> Timestamp {
  Timestamp::{ secs: ts_max_secs, nanos: 999999999 }
}

///|
pub fn Timestamp::new(secs : Int64, nanos : Int) -> Result[Timestamp, TimeError] {
  let mut s = secs
  let mut n = nanos
  if n < 0 || n >= 1000000000 {
    let mut q = n / 1000000000
    let mut r = n % 1000000000
    if r < 0 {
      r = r + 1000000000
      q = q - 1
    }
    match checked_add_i64(s, q.to_int64()) {
      Some(ns) => s = ns
      None => return Err(TimeError::new("OUT_OF_RANGE", "timestamp seconds overflow"))
    }
    n = r
  }
  if s < ts_min_secs || s > ts_max_secs {
    return Err(TimeError::new("OUT_OF_RANGE", "timestamp out of supported range"))
  }
  Ok(Timestamp::{ secs: s, nanos: n })
}

///|
pub fn Timestamp::from_second(secs : Int64) -> Result[Timestamp, TimeError] {
  if secs < ts_min_secs || secs > ts_max_secs {
    return Err(TimeError::new("OUT_OF_RANGE", "timestamp seconds out of range"))
  }
  Ok(Timestamp::{ secs: secs, nanos: 0 })
}

///|
pub fn Timestamp::from_millisecond(ms : Int64) -> Result[Timestamp, TimeError] {
  let mut q = ms / 1000L
  let mut r = (ms % 1000L).to_int()
  if r < 0 {
    r = r + 1000
    q = q - 1L
  }
  if q < ts_min_secs || q > ts_max_secs {
    return Err(TimeError::new("OUT_OF_RANGE", "timestamp milliseconds out of range"))
  }
  Ok(Timestamp::{ secs: q, nanos: r * 1000000 })
}

///|
pub fn Timestamp::from_microsecond(us : Int64) -> Result[Timestamp, TimeError] {
  let mut q = us / 1000000L
  let mut r = (us % 1000000L).to_int()
  if r < 0 {
    r = r + 1000000
    q = q - 1L
  }
  if q < ts_min_secs || q > ts_max_secs {
    return Err(TimeError::new("OUT_OF_RANGE", "timestamp microseconds out of range"))
  }
  Ok(Timestamp::{ secs: q, nanos: r * 1000 })
}

///|
pub fn Timestamp::from_nanosecond(ns : Int64) -> Result[Timestamp, TimeError] {
  let mut q = ns / 1000000000L
  let mut r = (ns % 1000000000L).to_int()
  if r < 0 {
    r = r + 1000000000
    q = q - 1L
  }
  if q < ts_min_secs || q > ts_max_secs {
    return Err(TimeError::new("OUT_OF_RANGE", "timestamp nanoseconds out of range"))
  }
  Ok(Timestamp::{ secs: q, nanos: r })
}

///|
pub fn Timestamp::as_second(self : Timestamp) -> Int64 {
  self.secs
}

///|
pub fn Timestamp::as_millisecond(self : Timestamp) -> Int64 {
  self.secs * 1000L + (self.nanos / 1000000).to_int64()
}

///|
pub fn Timestamp::as_microsecond(self : Timestamp) -> Int64 {
  self.secs * 1000000L + (self.nanos / 1000).to_int64()
}

///|
pub fn Timestamp::to_datetime(self : Timestamp, offset : Offset) -> DateTime {
  offset.to_datetime(self)
}

///|
pub fn Timestamp::to_utc_datetime(self : Timestamp) -> DateTime {
  Offset::utc().to_datetime(self)
}

///|
pub fn Timestamp::checked_add(
  self : Timestamp,
  dur : SignedDuration,
) -> Result[Timestamp, TimeError] {
  let mut n = self.nanos + dur.nanos
  let mut carry : Int64 = 0L
  if n >= 1000000000 {
    n = n - 1000000000
    carry = 1L
  } else if n < 0 {
    n = n + 1000000000
    carry = -1L
  }
  let s1 = match checked_add_i64(self.secs, dur.secs) {
    Some(v) => v
    None => return Err(TimeError::new("OVERFLOW", "timestamp addition overflow"))
  }
  let s2 = match checked_add_i64(s1, carry) {
    Some(v) => v
    None => return Err(TimeError::new("OVERFLOW", "timestamp addition overflow"))
  }
  if s2 < ts_min_secs || s2 > ts_max_secs {
    return Err(TimeError::new("OUT_OF_RANGE", "timestamp out of range"))
  }
  Ok(Timestamp::{ secs: s2, nanos: n })
}

///|
pub fn Timestamp::checked_sub(
  self : Timestamp,
  dur : SignedDuration,
) -> Result[Timestamp, TimeError] {
  match dur.checked_neg() {
    Ok(neg) => self.checked_add(neg)
    Err(e) => Err(e)
  }
}

///|
pub fn Timestamp::until(self : Timestamp, other : Timestamp) -> SignedDuration {
  other.since(self)
}

///|
pub fn Timestamp::since(self : Timestamp, other : Timestamp) -> SignedDuration {
  let ds = self.secs - other.secs
  let dn = self.nanos - other.nanos
  match SignedDuration::new(ds, dn) {
    Ok(d) => d
    Err(_) => SignedDuration::zero()
  }
}

///|
pub fn Timestamp::eq(self : Timestamp, other : Timestamp) -> Bool {
  self.secs == other.secs && self.nanos == other.nanos
}

///|
#verify
pub fn Timestamp::cmp(self : Timestamp, other : Timestamp) -> Int {
  if self.secs != other.secs {
    return if self.secs < other.secs { -1 } else { 1 }
  }
  if self.nanos != other.nanos {
    return if self.nanos < other.nanos { -1 } else { 1 }
  }
  0
}

///|
pub fn FixedDateTime::new(
  datetime : DateTime,
  offset : Offset,
) -> FixedDateTime {
  FixedDateTime::{ datetime: datetime, offset: offset }
}

///|
pub fn FixedDateTime::from_timestamp(
  ts : Timestamp,
  offset : Offset,
) -> FixedDateTime {
  FixedDateTime::{ datetime: offset.to_datetime(ts), offset: offset }
}

///|
pub fn FixedDateTime::to_timestamp(
  self : FixedDateTime,
) -> Result[Timestamp, TimeError] {
  self.offset.to_timestamp(self.datetime)
}

///|
pub fn FixedDateTime::with_offset(
  self : FixedDateTime,
  offset : Offset,
) -> Result[FixedDateTime, TimeError] {
  match self.to_timestamp() {
    Ok(ts) => Ok(FixedDateTime::from_timestamp(ts, offset))
    Err(e) => Err(e)
  }
}

///|
pub fn FixedDateTime::eq(self : FixedDateTime, other : FixedDateTime) -> Bool {
  self.datetime.eq(other.datetime) && self.offset.eq(other.offset)
}

///|
pub fn SignedDuration::zero() -> SignedDuration {
  SignedDuration::{ secs: 0L, nanos: 0 }
}

///|
pub fn SignedDuration::min() -> SignedDuration {
  SignedDuration::{ secs: -9223372036854775807L - 1L, nanos: -999999999 }
}

///|
pub fn SignedDuration::max() -> SignedDuration {
  SignedDuration::{ secs: i64_max, nanos: 999999999 }
}

///|
#verify
pub fn SignedDuration::new(
  secs : Int64,
  nanos : Int,
) -> Result[SignedDuration, TimeError] {
  let mut s = secs
  let mut n = nanos
  if n <= -1000000000 || n >= 1000000000 {
    let add_s = (n / 1000000000).to_int64()
    match checked_add_i64(s, add_s) {
      Some(v) => s = v
      None => return Err(TimeError::new("OVERFLOW", "duration seconds overflow"))
    }
    n = n % 1000000000
  }
  if n == 0 || s == 0L {
    return Ok(SignedDuration::{ secs: s, nanos: n })
  }
  if s < 0L && n > 0 {
    s = s + 1L
    n = n - 1000000000
  } else if s > 0L && n < 0 {
    s = s - 1L
    n = n + 1000000000
  }
  Ok(SignedDuration::{ secs: s, nanos: n })
}

///|
pub fn SignedDuration::from_secs(secs : Int64) -> SignedDuration {
  SignedDuration::{ secs: secs, nanos: 0 }
}

///|
pub fn SignedDuration::from_millis(millis : Int64) -> SignedDuration {
  let s = millis / 1000L
  let n = (millis % 1000L).to_int() * 1000000
  SignedDuration::{ secs: s, nanos: n }
}

///|
pub fn SignedDuration::from_micros(micros : Int64) -> SignedDuration {
  let s = micros / 1000000L
  let n = (micros % 1000000L).to_int() * 1000
  SignedDuration::{ secs: s, nanos: n }
}

///|
pub fn SignedDuration::from_nanos(nanos : Int64) -> SignedDuration {
  let s = nanos / 1000000000L
  let n = (nanos % 1000000000L).to_int()
  SignedDuration::{ secs: s, nanos: n }
}

///|
pub fn SignedDuration::from_mins(
  mins : Int64,
) -> Result[SignedDuration, TimeError] {
  match checked_mul_i64(mins, 60L) {
    Some(s) => Ok(SignedDuration::{ secs: s, nanos: 0 })
    None => Err(TimeError::new("OVERFLOW", "minutes overflow i64 seconds"))
  }
}

///|
pub fn SignedDuration::from_hours(
  hours : Int64,
) -> Result[SignedDuration, TimeError] {
  match checked_mul_i64(hours, 3600L) {
    Some(s) => Ok(SignedDuration::{ secs: s, nanos: 0 })
    None => Err(TimeError::new("OVERFLOW", "hours overflow i64 seconds"))
  }
}

///|
pub fn SignedDuration::is_zero(self : SignedDuration) -> Bool {
  self.secs == 0L && self.nanos == 0
}

///|
pub fn SignedDuration::is_positive(self : SignedDuration) -> Bool {
  self.secs > 0L || self.nanos > 0
}

///|
pub fn SignedDuration::is_negative(self : SignedDuration) -> Bool {
  self.secs < 0L || self.nanos < 0
}

///|
pub fn SignedDuration::abs(
  self : SignedDuration,
) -> Result[SignedDuration, TimeError] {
  if self.secs == i64_min {
    return Err(TimeError::new("OVERFLOW", "cannot take abs of SignedDuration::min"))
  }
  let s = if self.secs < 0L { -self.secs } else { self.secs }
  let n = if self.nanos < 0 { -self.nanos } else { self.nanos }
  Ok(SignedDuration::{ secs: s, nanos: n })
}

///|
#verify
pub fn SignedDuration::checked_neg(
  self : SignedDuration,
) -> Result[SignedDuration, TimeError] {
  if self.secs == (-9223372036854775807L - 1L) {
    return Err(TimeError::new("OVERFLOW", "cannot negate SignedDuration::min"))
  }
  Ok(SignedDuration::{ secs: -self.secs, nanos: -self.nanos })
}

///|
#verify
pub fn SignedDuration::checked_add(
  self : SignedDuration,
  rhs : SignedDuration,
) -> Result[SignedDuration, TimeError] {
  let mut s = match checked_add_i64(self.secs, rhs.secs) {
    Some(v) => v
    None => return Err(TimeError::new("OVERFLOW", "duration add overflow"))
  }
  let mut n = self.nanos + rhs.nanos
  if n >= 1000000000 {
    n = n - 1000000000
    match checked_add_i64(s, 1L) {
      Some(v) => s = v
      None => return Err(TimeError::new("OVERFLOW", "duration add overflow"))
    }
  } else if n <= -1000000000 {
    n = n + 1000000000
    match checked_add_i64(s, -1L) {
      Some(v) => s = v
      None => return Err(TimeError::new("OVERFLOW", "duration add overflow"))
    }
  }
  if s < 0L && n > 0 {
    s = s + 1L
    n = n - 1000000000
  } else if s > 0L && n < 0 {
    s = s - 1L
    n = n + 1000000000
  }
  Ok(SignedDuration::{ secs: s, nanos: n })
}

///|
#verify
pub fn SignedDuration::checked_sub(
  self : SignedDuration,
  rhs : SignedDuration,
) -> Result[SignedDuration, TimeError] {
  if rhs.secs == (-9223372036854775807L - 1L) {
    // Handle subtracting MIN carefully: a - (-2^63 + rhs.nanos / 1e9)
    if self.secs == 0L && self.nanos < rhs.nanos {
      return Ok(SignedDuration::{ secs: i64_max, nanos: 1000000000 + self.nanos - rhs.nanos })
    }
    let s1 = match checked_sub_i64(self.secs, rhs.secs) {
      Some(v) => v
      None => return Err(TimeError::new("OVERFLOW", "duration sub overflow"))
    }
    return SignedDuration::new(s1, self.nanos - rhs.nanos)
  }
  self.checked_add(SignedDuration::{ secs: -rhs.secs, nanos: -rhs.nanos })
}

///|
pub fn SignedDuration::checked_mul(
  self : SignedDuration,
  rhs : Int,
) -> Result[SignedDuration, TimeError] {
  let r64 = rhs.to_int64()
  if r64 == 0L || self.is_zero() {
    return Ok(SignedDuration::zero())
  }
  let total_ns = match checked_mul_i64(self.nanos.to_int64(), r64) {
    Some(v) => v
    None => return Err(TimeError::new("OVERFLOW", "duration mul overflow"))
  }
  let carry_s = total_ns / 1000000000L
  let rem_ns = (total_ns % 1000000000L).to_int()
  let prod_s = match checked_mul_i64(self.secs, r64) {
    Some(v) => v
    None => return Err(TimeError::new("OVERFLOW", "duration mul overflow"))
  }
  let final_s = match checked_add_i64(prod_s, carry_s) {
    Some(v) => v
    None => return Err(TimeError::new("OVERFLOW", "duration mul overflow"))
  }
  SignedDuration::new(final_s, rem_ns)
}

///|
pub fn SignedDuration::checked_div(
  self : SignedDuration,
  rhs : Int,
) -> Result[SignedDuration, TimeError] {
  if rhs == 0 {
    return Err(TimeError::new("DIV_BY_ZERO", "cannot divide duration by zero"))
  }
  let r64 = rhs.to_int64()
  if self.secs == i64_min && r64 == -1L {
    return Err(TimeError::new("OVERFLOW", "duration division overflow"))
  }
  let q_s = self.secs / r64
  let rem_s = self.secs % r64
  // rem_s * 1_000_000_000 + nanos could overflow i64 if |rem_s| > 9e9,
  // so split carefully if needed.
  let ns_from_rem = if rem_s > 9000000000L || rem_s < -9000000000L {
    // Use long division in two steps: (rem_s * 1_000_000) / r64 * 1000 ...
    // Actually for |r64| <= 2^63, split rem_s = q1*... or use 1000-step
    let mut acc_q : Int64 = 0L
    let mut acc_r = rem_s
    let mut step = 0
    while step < 3 {
      let scaled = acc_r * 1000L
      acc_q = acc_q * 1000L + scaled / r64
      acc_r = scaled % r64
      step = step + 1
    }
    let extra = (acc_r + self.nanos.to_int64()) / r64
    acc_q + extra
  } else {
    (rem_s * 1000000000L + self.nanos.to_int64()) / r64
  }
  SignedDuration::new(q_s, ns_from_rem.to_int())
}

///|
pub fn SignedDuration::trunc_secs(self : SignedDuration) -> SignedDuration {
  SignedDuration::{ secs: self.secs, nanos: 0 }
}

///|
pub fn SignedDuration::trunc_millis(self : SignedDuration) -> SignedDuration {
  SignedDuration::{ secs: self.secs, nanos: self.nanos / 1000000 * 1000000 }
}

///|
pub fn SignedDuration::trunc_micros(self : SignedDuration) -> SignedDuration {
  SignedDuration::{ secs: self.secs, nanos: self.nanos / 1000 * 1000 }
}

///|
pub fn SignedDuration::round_secs(
  self : SignedDuration,
) -> Result[SignedDuration, TimeError] {
  if self.nanos >= 500000000 {
    match checked_add_i64(self.secs, 1L) {
      Some(s) => Ok(SignedDuration::{ secs: s, nanos: 0 })
      None => Err(TimeError::new("OVERFLOW", "round_secs overflow"))
    }
  } else if self.nanos <= -500000000 {
    match checked_add_i64(self.secs, -1L) {
      Some(s) => Ok(SignedDuration::{ secs: s, nanos: 0 })
      None => Err(TimeError::new("OVERFLOW", "round_secs overflow"))
    }
  } else {
    Ok(SignedDuration::{ secs: self.secs, nanos: 0 })
  }
}

///|
pub fn SignedDuration::round_millis(
  self : SignedDuration,
) -> Result[SignedDuration, TimeError] {
  let rem = self.nanos % 1000000
  let base = self.nanos - rem
  if rem >= 500000 {
    SignedDuration::new(self.secs, base + 1000000)
  } else if rem <= -500000 {
    SignedDuration::new(self.secs, base - 1000000)
  } else {
    Ok(SignedDuration::{ secs: self.secs, nanos: base })
  }
}

///|
pub fn SignedDuration::as_secs(self : SignedDuration) -> Int64 {
  self.secs
}

///|
pub fn SignedDuration::subsec_nanos(self : SignedDuration) -> Int {
  self.nanos
}

///|
pub fn SignedDuration::subsec_millis(self : SignedDuration) -> Int {
  self.nanos / 1000000
}

///|
pub fn SignedDuration::subsec_micros(self : SignedDuration) -> Int {
  self.nanos / 1000
}

///|
pub fn SignedDuration::eq(
  self : SignedDuration,
  other : SignedDuration,
) -> Bool {
  self.secs == other.secs && self.nanos == other.nanos
}

///|
#verify
pub fn SignedDuration::cmp(self : SignedDuration, other : SignedDuration) -> Int {
  if self.secs != other.secs {
    return if self.secs < other.secs { -1 } else { 1 }
  }
  if self.nanos != other.nanos {
    return if self.nanos < other.nanos { -1 } else { 1 }
  }
  0
}
