///| Offset, Timestamp, FixedDateTime, and SignedDuration (Red-stage stubs).

///|
pub fn Offset::utc() -> Offset {
  Offset::{ seconds: 0 }
}

///|
pub fn Offset::min() -> Offset {
  Offset::{ seconds: 0 }
}

///|
pub fn Offset::max() -> Offset {
  Offset::{ seconds: 0 }
}

///|
pub fn Offset::from_seconds(seconds : Int) -> Result[Offset, TimeError] {
  let _ = seconds
  Err(stub_err())
}

///|
pub fn Offset::from_hours(hours : Int) -> Result[Offset, TimeError] {
  let _ = hours
  Err(stub_err())
}

///|
pub fn Offset::from_hms(
  hours : Int,
  minutes : Int,
  seconds : Int,
) -> Result[Offset, TimeError] {
  let _ = hours
  let _ = minutes
  let _ = seconds
  Err(stub_err())
}

///|
pub fn Offset::negate(self : Offset) -> Offset {
  let _ = self
  Offset::{ seconds: 0 }
}

///|
pub fn Offset::to_datetime(self : Offset, ts : Timestamp) -> DateTime {
  let _ = self
  let _ = ts
  DateTime::min()
}

///|
pub fn Offset::to_timestamp(
  self : Offset,
  dt : DateTime,
) -> Result[Timestamp, TimeError] {
  let _ = self
  let _ = dt
  Err(stub_err())
}

///|
pub fn Offset::eq(self : Offset, other : Offset) -> Bool {
  self.seconds == other.seconds
}

///|
pub fn Timestamp::unix_epoch() -> Timestamp {
  Timestamp::{ secs: 0L, nanos: 0 }
}

///|
pub fn Timestamp::min() -> Timestamp {
  Timestamp::{ secs: 0L, nanos: 0 }
}

///|
pub fn Timestamp::max() -> Timestamp {
  Timestamp::{ secs: 0L, nanos: 0 }
}

///|
pub fn Timestamp::new(secs : Int64, nanos : Int) -> Result[Timestamp, TimeError] {
  let _ = secs
  let _ = nanos
  Err(stub_err())
}

///|
pub fn Timestamp::from_second(secs : Int64) -> Result[Timestamp, TimeError] {
  let _ = secs
  Err(stub_err())
}

///|
pub fn Timestamp::from_millisecond(ms : Int64) -> Result[Timestamp, TimeError] {
  let _ = ms
  Err(stub_err())
}

///|
pub fn Timestamp::from_microsecond(us : Int64) -> Result[Timestamp, TimeError] {
  let _ = us
  Err(stub_err())
}

///|
pub fn Timestamp::from_nanosecond(ns : Int64) -> Result[Timestamp, TimeError] {
  let _ = ns
  Err(stub_err())
}

///|
pub fn Timestamp::as_second(self : Timestamp) -> Int64 {
  let _ = self
  0L
}

///|
pub fn Timestamp::as_millisecond(self : Timestamp) -> Int64 {
  let _ = self
  0L
}

///|
pub fn Timestamp::as_microsecond(self : Timestamp) -> Int64 {
  let _ = self
  0L
}

///|
pub fn Timestamp::to_datetime(self : Timestamp, offset : Offset) -> DateTime {
  let _ = self
  let _ = offset
  DateTime::min()
}

///|
pub fn Timestamp::to_utc_datetime(self : Timestamp) -> DateTime {
  let _ = self
  DateTime::min()
}

///|
pub fn Timestamp::checked_add(
  self : Timestamp,
  dur : SignedDuration,
) -> Result[Timestamp, TimeError] {
  let _ = self
  let _ = dur
  Err(stub_err())
}

///|
pub fn Timestamp::checked_sub(
  self : Timestamp,
  dur : SignedDuration,
) -> Result[Timestamp, TimeError] {
  let _ = self
  let _ = dur
  Err(stub_err())
}

///|
pub fn Timestamp::until(self : Timestamp, other : Timestamp) -> SignedDuration {
  let _ = self
  let _ = other
  SignedDuration::{ secs: 0L, nanos: 0 }
}

///|
pub fn Timestamp::since(self : Timestamp, other : Timestamp) -> SignedDuration {
  let _ = self
  let _ = other
  SignedDuration::{ secs: 0L, nanos: 0 }
}

///|
pub fn Timestamp::eq(self : Timestamp, other : Timestamp) -> Bool {
  self.secs == other.secs && self.nanos == other.nanos
}

///|
pub fn Timestamp::cmp(self : Timestamp, other : Timestamp) -> Int {
  let _ = self
  let _ = other
  0
}

///|
pub fn FixedDateTime::new(
  datetime : DateTime,
  offset : Offset,
) -> FixedDateTime {
  FixedDateTime::{ datetime: datetime, offset: offset }
}

///|
pub fn FixedDateTime::from_timestamp(
  ts : Timestamp,
  offset : Offset,
) -> FixedDateTime {
  FixedDateTime::{ datetime: offset.to_datetime(ts), offset: offset }
}

///|
pub fn FixedDateTime::to_timestamp(
  self : FixedDateTime,
) -> Result[Timestamp, TimeError] {
  self.offset.to_timestamp(self.datetime)
}

///|
pub fn FixedDateTime::with_offset(
  self : FixedDateTime,
  offset : Offset,
) -> Result[FixedDateTime, TimeError] {
  let _ = self
  let _ = offset
  Err(stub_err())
}

///|
pub fn FixedDateTime::eq(self : FixedDateTime, other : FixedDateTime) -> Bool {
  self.datetime.eq(other.datetime) && self.offset.eq(other.offset)
}

