///| Rounding modes, time units, and `round` methods for `Timestamp`, `DateTime`, `Time`, and `SignedDuration`.

///|
pub enum TimeUnit {
  Year
  Month
  Week
  Day
  Hour
  Minute
  Second
  Millisecond
  Microsecond
  Nanosecond
}

///|
pub enum RoundMode {
  Ceil
  Floor
  Expand
  Trunc
  HalfCeil
  HalfFloor
  HalfExpand
  HalfTrunc
  HalfEven
}

///| Round `value` (in nanoseconds) to a multiple of positive `inc_ns` using `mode`.
///| Uses integer math without floating point; `value` may be negative.
fn round_i64_to_increment(value : Int64, inc : Int64, mode : RoundMode) -> Int64 {
  if inc <= 1L {
    return value
  }
  let q = value / inc
  let r = value % inc
  if r == 0L {
    return value
  }
  let is_neg = value < 0L
  let abs_r = if r < 0L { -r } else { r }
  let cmp_half = {
    // Compare 2 * abs_r vs inc without overflow:
    // abs_r < inc, so compare abs_r with inc / 2 and inc % 2
    let half = inc / 2L
    let odd = inc % 2L
    if abs_r < half {
      -1
    } else if abs_r > half {
      1
    } else if odd == 0L {
      0
    } else {
      -1
    }
  }
  let step : Int64 = match mode {
    RoundMode::Trunc => 0L
    RoundMode::Expand => if is_neg { -1L } else { 1L }
    RoundMode::Floor => if is_neg { -1L } else { 0L }
    RoundMode::Ceil => if is_neg { 0L } else { 1L }
    RoundMode::HalfTrunc =>
    if cmp_half > 0 {
      if is_neg { -1L } else { 1L }
    } else {
      0L
    }
    RoundMode::HalfExpand =>
    if cmp_half >= 0 {
      if is_neg { -1L } else { 1L }
    } else {
      0L
    }
    RoundMode::HalfFloor =>
    if cmp_half > 0 {
      if is_neg { -1L } else { 1L }
    } else if cmp_half == 0 {
      if is_neg { -1L } else { 0L }
    } else {
      0L
    }
    RoundMode::HalfCeil =>
    if cmp_half > 0 {
      if is_neg { -1L } else { 1L }
    } else if cmp_half == 0 {
      if is_neg { 0L } else { 1L }
    } else {
      0L
    }
    RoundMode::HalfEven =>
    if cmp_half > 0 {
      if is_neg { -1L } else { 1L }
    } else if cmp_half == 0 {
      if (q & 1L) != 0L {
        if is_neg { -1L } else { 1L }
      } else {
        0L
      }
    } else {
      0L
    }
  }
  (q + step) * inc
}

///| Validate `(smallest, increment)` for time-of-day / timestamp rounding and return increment in nanoseconds.
///| Returns `Err` if unit is larger than `Hour` (unless `allow_day` is true) or increment doesn't divide the parent unit.
fn time_unit_increment_ns(
  smallest : TimeUnit,
  increment : Int,
  allow_day : Bool,
) -> Result[Int64, TimeError] {
  if increment <= 0 {
    return Err(TimeError::new("INVALID_INCREMENT", "rounding increment must be positive"))
  }
  let inc64 = increment.to_int64()
  match smallest {
    TimeUnit::Day => {
      if !allow_day {
        return Err(TimeError::new("INVALID_UNIT", "Day unit not supported for this type"))
      }
      if increment != 1 {
        return Err(TimeError::new("INVALID_INCREMENT", "Day increment must be 1"))
      }
      Ok(86400000000000L)
    }
    TimeUnit::Hour => {
      if 24 % increment != 0 {
        return Err(TimeError::new("INVALID_INCREMENT", "hour increment must divide 24"))
      }
      Ok(inc64 * 3600000000000L)
    }
    TimeUnit::Minute => {
      if 60 % increment != 0 {
        return Err(TimeError::new("INVALID_INCREMENT", "minute increment must divide 60"))
      }
      Ok(inc64 * 60000000000L)
    }
    TimeUnit::Second => {
      if 60 % increment != 0 {
        return Err(TimeError::new("INVALID_INCREMENT", "second increment must divide 60"))
      }
      Ok(inc64 * 1000000000L)
    }
    TimeUnit::Millisecond => {
      if 1000 % increment != 0 {
        return Err(TimeError::new("INVALID_INCREMENT", "millisecond increment must divide 1000"))
      }
      Ok(inc64 * 1000000L)
    }
    TimeUnit::Microsecond => {
      if 1000 % increment != 0 {
        return Err(TimeError::new("INVALID_INCREMENT", "microsecond increment must divide 1000"))
      }
      Ok(inc64 * 1000L)
    }
    TimeUnit::Nanosecond => {
      if 1000 % increment != 0 {
        return Err(TimeError::new("INVALID_INCREMENT", "nanosecond increment must divide 1000"))
      }
      Ok(inc64)
    }
    _ => Err(TimeError::new("INVALID_UNIT", "calendar units Year/Month/Week are not supported for rounding"))
  }
}

///| Round a `Time` to the given `smallest` unit and `increment`, wrapping modulo 24h (matching jiff).
pub fn Time::round(
  self : Time,
  smallest : TimeUnit,
  increment : Int,
  mode : RoundMode,
) -> Result[Time, TimeError] {
  let inc_ns = match time_unit_increment_ns(smallest, increment, false) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let ns_of_day = self.to_nanosecond_of_day()
  let mut rounded = round_i64_to_increment(ns_of_day, inc_ns, mode)
  let day_ns : Int64 = 86400000000000L
  if rounded >= day_ns {
    rounded = rounded % day_ns
  } else if rounded < 0L {
    rounded = 0L
  }
  let secs = (rounded / 1000000000L).to_int()
  let ns = (rounded % 1000000000L).to_int()
  let h = secs / 3600
  let rem = secs % 3600
  let m = rem / 60
  let s = rem % 60
  Ok(Time::{ hour: h, minute: m, second: s, nanosecond: ns })
}

///| Round a `DateTime` to the given `smallest` unit (`Day`..`Nanosecond`) and `increment`.
pub fn DateTime::round(
  self : DateTime,
  smallest : TimeUnit,
  increment : Int,
  mode : RoundMode,
) -> Result[DateTime, TimeError] {
  let inc_ns = match time_unit_increment_ns(smallest, increment, true) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let ns_of_day = self.time.to_nanosecond_of_day()
  let rounded = round_i64_to_increment(ns_of_day, inc_ns, mode)
  let day_ns : Int64 = 86400000000000L
  if rounded >= day_ns {
    let next_date = match self.date.tomorrow() {
      Ok(d) => d
      Err(e) => return Err(e)
    }
    let rem_ns = rounded - day_ns
    let secs = (rem_ns / 1000000000L).to_int()
    let ns = (rem_ns % 1000000000L).to_int()
    let h = secs / 3600
    let rem = secs % 3600
    let m = rem / 60
    let s = rem % 60
    Ok(DateTime::{
      date: next_date,
      time: Time::{ hour: h, minute: m, second: s, nanosecond: ns },
    })
  } else {
    let secs = (rounded / 1000000000L).to_int()
    let ns = (rounded % 1000000000L).to_int()
    let h = secs / 3600
    let rem = secs % 3600
    let m = rem / 60
    let s = rem % 60
    Ok(DateTime::{
      date: self.date,
      time: Time::{ hour: h, minute: m, second: s, nanosecond: ns },
    })
  }
}

///| Round a `Timestamp` to the given `smallest` unit (`Hour`..`Nanosecond`) and `increment`.
pub fn Timestamp::round(
  self : Timestamp,
  smallest : TimeUnit,
  increment : Int,
  mode : RoundMode,
) -> Result[Timestamp, TimeError] {
  let inc_ns = match time_unit_increment_ns(smallest, increment, false) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  // Round within the UTC day (since every valid increment divides 24h) to avoid i64 nanosecond overflow!
  let dt = self.to_utc_datetime()
  let ns_of_day = dt.time.to_nanosecond_of_day()
  let rounded = round_i64_to_increment(ns_of_day, inc_ns, mode)
  let delta_ns = rounded - ns_of_day
  let delta_s = delta_ns / 1000000000L
  let delta_r = (delta_ns % 1000000000L).to_int()
  let dur = match SignedDuration::new(delta_s, delta_r) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  self.checked_add(dur)
}

///| Round a `SignedDuration` to the given `smallest` unit (`Hour`..`Nanosecond`) and `increment`.
pub fn SignedDuration::round(
  self : SignedDuration,
  smallest : TimeUnit,
  increment : Int,
  mode : RoundMode,
) -> Result[SignedDuration, TimeError] {
  if increment <= 0 {
    return Err(TimeError::new("INVALID_INCREMENT", "rounding increment must be positive"))
  }
  let inc64 = increment.to_int64()
  match smallest {
    TimeUnit::Hour | TimeUnit::Minute | TimeUnit::Second => {
      let unit_secs : Int64 = match smallest {
        TimeUnit::Hour => 3600L
        TimeUnit::Minute => 60L
        _ => 1L
      }
      let inc_s = match checked_mul_i64(inc64, unit_secs) {
        Some(v) => v
        None => return Err(TimeError::new("OVERFLOW", "rounding increment overflow"))
      }
      let q = self.secs / inc_s
      let rem_s = self.secs % inc_s
      if rem_s == 0L && self.nanos == 0 {
        return Ok(self)
      }
      let is_neg = self.is_negative()
      let abs_rem_s = if rem_s < 0L { -rem_s } else { rem_s }
      let abs_n = if self.nanos < 0 { -self.nanos } else { self.nanos }
      let half_s = inc_s / 2L
      let odd_s = inc_s % 2L
      let cmp_half = if abs_rem_s < half_s {
        -1
      } else if abs_rem_s > half_s {
        1
      } else if odd_s == 0L {
        if abs_n == 0 { 0 } else { 1 }
      } else {
        if abs_n < 500000000 {
          -1
        } else if abs_n > 500000000 {
          1
        } else {
          0
        }
      }
      let step : Int64 = match mode {
        RoundMode::Trunc => 0L
        RoundMode::Expand => if is_neg { -1L } else { 1L }
        RoundMode::Floor => if is_neg { -1L } else { 0L }
        RoundMode::Ceil => if is_neg { 0L } else { 1L }
        RoundMode::HalfTrunc => if cmp_half > 0 { if is_neg { -1L } else { 1L } } else { 0L }
        RoundMode::HalfExpand => if cmp_half >= 0 { if is_neg { -1L } else { 1L } } else { 0L }
        RoundMode::HalfFloor =>
        if cmp_half > 0 {
          if is_neg { -1L } else { 1L }
        } else if cmp_half == 0 {
          if is_neg { -1L } else { 0L }
        } else {
          0L
        }
        RoundMode::HalfCeil =>
        if cmp_half > 0 {
          if is_neg { -1L } else { 1L }
        } else if cmp_half == 0 {
          if is_neg { 0L } else { 1L }
        } else {
          0L
        }
        RoundMode::HalfEven =>
        if cmp_half > 0 {
          if is_neg { -1L } else { 1L }
        } else if cmp_half == 0 && (q & 1L) != 0L {
          if is_neg { -1L } else { 1L }
        } else {
          0L
        }
      }
      let q_final = match checked_add_i64(q, step) {
        Some(v) => v
        None => return Err(TimeError::new("OVERFLOW", "round overflow"))
      }
      let final_s = match checked_mul_i64(q_final, inc_s) {
        Some(v) => v
        None => return Err(TimeError::new("OVERFLOW", "round overflow"))
      }
      Ok(SignedDuration::{ secs: final_s, nanos: 0 })
    }
    TimeUnit::Millisecond | TimeUnit::Microsecond | TimeUnit::Nanosecond => {
      let inc_ns = match time_unit_increment_ns(smallest, increment, false) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let rounded_ns = round_i64_to_increment(self.nanos.to_int64(), inc_ns, mode)
      let carry_s = rounded_ns / 1000000000L
      let rem_ns = (rounded_ns % 1000000000L).to_int()
      let new_s = match checked_add_i64(self.secs, carry_s) {
        Some(v) => v
        None => return Err(TimeError::new("OVERFLOW", "round overflow"))
      }
      SignedDuration::new(new_s, rem_ns)
    }
    _ => Err(TimeError::new("INVALID_UNIT", "calendar units not supported for SignedDuration::round"))
  }
}
