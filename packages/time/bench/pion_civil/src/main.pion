///| Benchmark Workload 2: 2,000,000 civil calendar & epoch roundtrips.

import "time"

///|
pub fn main(world : World) -> Int {
  let ops = 2000000
  let mut acc_ymd : Int64 = 0L
  let mut acc_iwd : Int64 = 0L
  let mut acc_ed : Int64 = 0L
  let mut i = 0
  while i < ops {
    let day = (i.to_int64() * 2654435761L % 1000001L).to_int() - 500000
    let delta = i % 731 - 365
    let d0 = match time::Date::from_epoch_days(day) {
      Ok(v) => v
      Err(_) => return 1
    }
    let iwd = d0.iso_week_date()
    let d1 = match d0.add_days(delta) {
      Ok(v) => v
      Err(_) => return 1
    }
    let ed1 = d1.to_epoch_days()
    acc_ymd = acc_ymd + (d0.year * 10000 + d0.month * 100 + d0.day).to_int64()
    let wd1 = time::weekday_to_monday_one_offset(iwd.weekday)
    acc_iwd = acc_iwd + (iwd.year * 1000 + iwd.week * 10 + wd1).to_int64()
    acc_ed = acc_ed + ed1.to_int64()
    i = i + 1
  }
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "acc_ymd=" + acc_ymd.to_string())
  io_println(world, "acc_iwd=" + acc_iwd.to_string())
  io_println(world, "acc_ed=" + acc_ed.to_string())
  0
}
