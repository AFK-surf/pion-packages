///| Benchmark Workload 2: 2,000,000 civil calendar & epoch roundtrips.

import "time"

///|
pub fn main(world : World) -> Int {
  let ops = 2000000
  let mut acc_ymd : Int64 = 0L
  let mut acc_iwd : Int64 = 0L
  let mut acc_ed : Int64 = 0L
  let mut i = 0
  while i < ops {
    let day = (i.to_int64() * 2654435761L % 1000001L).to_int() - 500000
    let delta = i % 731 - 365
    let d0 = time::epoch_days_to_packed_date(day)
    if d0 < 0 {
      return 1
    }
    let iwd = time::packed_date_to_packed_iso_week(d0)
    let d1 = time::packed_date_add_days(d0, delta)
    if d1 < 0 {
      return 1
    }
    let ed1 = time::packed_date_to_epoch_days(d1)
    let y0 = (d0 >> 9) - 10000
    let m0 = (d0 >> 5) & 15
    let day0 = d0 & 31
    acc_ymd = acc_ymd + (y0 * 10000 + m0 * 100 + day0).to_int64()
    let iy = (iwd >> 9) - 10000
    let iw = (iwd >> 3) & 63
    let wd1 = iwd & 7
    acc_iwd = acc_iwd + (iy * 1000 + iw * 10 + wd1).to_int64()
    acc_ed = acc_ed + ed1.to_int64()
    i = i + 1
  }
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "acc_ymd=" + acc_ymd.to_string())
  io_println(world, "acc_iwd=" + acc_iwd.to_string())
  io_println(world, "acc_ed=" + acc_ed.to_string())
  0
}
