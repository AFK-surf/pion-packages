///| Benchmark Workload 1: 200,000 RFC 3339 parse + offset shift (+09:00) + format.

import "time"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 { args[1] } else { "/tmp/time-bench-rfc3339.txt" }
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input file")
      return 1
    }
  }
  let jst = match time::Offset::from_hours(9) {
    Ok(o) => o
    Err(_) => return 1
  }
  let mut count : Int64 = 0L
  let mut total_bytes : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut sum_secs : Int64 = 0L
  let mut sum_nanos : Int64 = 0L
  let mut first_out = ""
  let mut last_secs : Int64 = 0L
  let mut last_nanos = 0
  let buf = Bytes::new(48)
  let ts_out : Array[Int64] = [0L, 0L]
  let jst_secs = jst.seconds
  let clen = content.length()
  let mut pos = 0
  while pos < clen {
    let mut end = pos
    while end < clen && content.code_unit_at(end) != 10 {
      end = end + 1
    }
    if end > pos {
      if !time::parse_rfc3339_slice_raw(content, pos, end, ts_out) {
        io_println(world, "parse error")
        return 1
      }
      let secs = ts_out[0]
      let nanos = ts_out[1].to_int()
      let olen = time::format_rfc3339_raw_bytes(secs, nanos, jst_secs, buf)
      if count == 0L {
        first_out = time::Timestamp::{ secs: secs, nanos: nanos }.to_rfc3339_with_offset(jst)
      }
      last_secs = secs
      last_nanos = nanos
      count = count + 1L
      total_bytes = total_bytes + olen.to_int64()
      sum_secs = sum_secs + secs
      sum_nanos = sum_nanos + nanos.to_int64()
      let mut j = 0
      while j < olen {
        hash = (hash * 131L + buf[j].to_int().to_int64()) % 1000000007L
        j = j + 1
      }
    }
    pos = end + 1
  }
  let last_out = if count > 0L {
    time::Timestamp::{ secs: last_secs, nanos: last_nanos }.to_rfc3339_with_offset(jst)
  } else {
    ""
  }
  io_println(world, "count=" + count.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  io_println(world, "sum_secs=" + sum_secs.to_string())
  io_println(world, "sum_nanos=" + sum_nanos.to_string())
  io_println(world, "first=" + first_out)
  io_println(world, "last=" + last_out)
  0
}
