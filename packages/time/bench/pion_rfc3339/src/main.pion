///| Benchmark Workload 1: 200,000 RFC 3339 parse + offset shift (+09:00) + format.

import "time"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 { args[1] } else { "/tmp/time-bench-rfc3339.txt" }
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input file")
      return 1
    }
  }
  let lines = content.split("\n")
  let jst = match time::Offset::from_hours(9) {
    Ok(o) => o
    Err(_) => return 1
  }
  let mut count : Int64 = 0L
  let mut total_bytes : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut sum_secs : Int64 = 0L
  let mut sum_nanos : Int64 = 0L
  let mut first_out = ""
  let mut last_out = ""
  let mut i = 0
  let n = lines.length()
  while i < n {
    let line = lines[i]
    if line.length() > 0 {
      let ts = match time::Timestamp::parse_rfc3339(line) {
        Ok(v) => v
        Err(e) => {
          io_println(world, "parse error: " + e.message)
          return 1
        }
      }
      let out = ts.to_rfc3339_with_offset(jst)
      if count == 0L {
        first_out = out
      }
      last_out = out
      count = count + 1L
      let olen = out.length()
      total_bytes = total_bytes + olen.to_int64()
      sum_secs = sum_secs + ts.secs
      sum_nanos = sum_nanos + ts.nanos.to_int64()
      let mut j = 0
      while j < olen {
        hash = (hash * 131L + out.code_unit_at(j).to_int64()) % 1000000007L
        j = j + 1
      }
    }
    i = i + 1
  }
  io_println(world, "count=" + count.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  io_println(world, "sum_secs=" + sum_secs.to_string())
  io_println(world, "sum_nanos=" + sum_nanos.to_string())
  io_println(world, "first=" + first_out)
  io_println(world, "last=" + last_out)
  0
}
