///| Wasm32 smoke entry for the `time` package.

import "time"

///|
pub fn smoke() -> Int {
  let d = match time::Date::new(2024, 2, 29) {
    Ok(v) => v
    Err(_) => return 1
  }
  let ed = d.to_epoch_days()
  let iwd = d.iso_week_date()
  let ts = match time::Timestamp::parse_rfc3339("2024-02-29T12:34:56.789Z") {
    Ok(v) => v
    Err(_) => return 2
  }
  let s = ts.to_rfc3339()
  let h = ts.to_http_date()
  let dur = match time::SignedDuration::parse_iso("PT1H30M45.5S") {
    Ok(v) => v
    Err(_) => return 3
  }
  ed + iwd.week + s.length() + h.length() + dur.secs.to_int()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
