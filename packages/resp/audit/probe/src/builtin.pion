import "resp"

///| Built-in encoder injection, roundtrip, StreamDecoder state & aliasing checks.

///|
fn enc_canon(f : resp::RespFrame) -> String {
  match resp::encode(f) {
    Ok(b) => "OK " + esc(b)
    Err(e) => "ERR " + err_name(e)
  }
}

///|
fn ss(s : String) -> resp::RespFrame {
  resp::RespFrame::SimpleString(s)
}

///| Double encode -> decode bit-exact roundtrip over tricky values.
fn double_roundtrip() -> String {
  let vals : Array[Double] = [
    0.1, -0.0, 0.0, 1.0e21, 1.0e22, 1.0e-7, 123456789012345678.0, 1.7976931348623157e308,
    2.2250738585072014e-308, 0.30000000000000004, -1.5, 3.14159,
  ]
  vals.push(Double::from_bits(1L))
  vals.push(Double::from_bits(0x7FF0000000000000L))
  vals.push(Double::from_bits(-4503599627370496L))
  vals.push(Double::from_bits(0x7FF8000000000000L))
  let bad : Array[String] = []
  let mut i = 0
  while i < vals.length() {
    let v = vals[i]
    match resp::encode(resp::RespFrame::Double(v)) {
      Ok(w) =>
      match resp::decode_default(w) {
        Ok(Double(back)) =>
        if dbl_canon(back) != dbl_canon(v) {
          bad.push(dbl_canon(v) + "->" + esc(w))
        }
        _ => bad.push(dbl_canon(v) + "->" + esc(w) + "(decode)")
      }
      Err(_) => bad.push(dbl_canon(v) + "(encode)")
    }
    i = i + 1
  }
  if bad.length() == 0 {
    "OK"
  } else {
    "BAD " + join(bad, ",")
  }
}

///|
fn builtin_checks() -> Array[String] {
  let out : Array[String] = []
  // --- Encoder CRLF / frame injection ---
  out.push("enc_ss_crlf_inject\t" + enc_canon(ss("OK\r\n+INJECTED")))
  out.push("enc_ss_cr\t" + enc_canon(ss("a\rb")))
  out.push("enc_ss_lf\t" + enc_canon(ss("a\nb")))
  out.push("enc_se_crlf\t" + enc_canon(resp::RespFrame::SimpleError("ERR\r\n:1")))
  out.push("enc_big_crlf\t" + enc_canon(resp::RespFrame::BigNumber("1\r\n+X")))
  out.push("enc_big_alpha\t" + enc_canon(resp::RespFrame::BigNumber("12a")))
  out.push("enc_big_empty\t" + enc_canon(resp::RespFrame::BigNumber("")))
  out.push("enc_big_plus\t" + enc_canon(resp::RespFrame::BigNumber("+12")))
  out.push("enc_verb_tag_crlf\t" + enc_canon(resp::RespFrame::VerbatimString("t\r\n", "x".to_bytes())))
  out.push("enc_verb_tag_colon\t" + enc_canon(resp::RespFrame::VerbatimString("a:b", "x".to_bytes())))
  out.push("enc_verb_tag_len\t" + enc_canon(resp::RespFrame::VerbatimString("txtx", "x".to_bytes())))
  out.push("enc_verb_payload_crlf\t" + enc_canon(resp::RespFrame::VerbatimString("txt", "a\r\nb".to_bytes())))
  out.push("enc_bulk_crlf\t" + enc_canon(resp::RespFrame::BulkString("a\r\n+X\r\n".to_bytes())))
  out.push("enc_berr_crlf\t" + enc_canon(resp::RespFrame::BulkError("a\r\nb".to_bytes())))
  out.push("enc_nested_inject\t" + enc_canon(resp::RespFrame::Array([ss("ok"), ss("x\r\n")])))
  out.push("enc_map_key_inject\t" + enc_canon(resp::RespFrame::Map([(ss("k\n"), resp::RespFrame::Integer(1L))])))
  out.push(
    "enc_attr_inject\t" +
    enc_canon(resp::RespFrame::Attribute([(ss("a\r"), ss("b"))], resp::RespFrame::Null)),
  )
  out.push(
    "enc_attr_target_inject\t" +
    enc_canon(resp::RespFrame::Attribute([(ss("a"), ss("b"))], ss("c\r\n"))),
  )
  out.push("enc_int_min\t" + enc_canon(resp::RespFrame::Integer(-9223372036854775807L - 1L)))
  out.push("enc_int_max\t" + enc_canon(resp::RespFrame::Integer(9223372036854775807L)))
  out.push("enc_nulls\t" + enc_canon(resp::RespFrame::Array([resp::RespFrame::Null, resp::RespFrame::NullBulk, resp::RespFrame::NullArray])))
  out.push("enc_double_roundtrip\t" + double_roundtrip())
  // PipelineBuilder rollback on a rejected frame: no partial bytes may leak into the pipeline.
  let pb = resp::PipelineBuilder::new()
  pb.push_command_strings(["SET", "k", "v"])
  let rej = match pb.push_frame(resp::RespFrame::Array([ss("ok"), ss("bad\r\n")])) {
    Ok(_) => "accepted"
    Err(_) => "rejected"
  }
  out.push(
    "enc_pipeline_rollback\t" +
    rej +
    " count=" +
    pb.command_count().to_string() +
    " " +
    esc(pb.finish()),
  )
  // encode_command binary safety: CR/LF inside arguments is length-prefixed, never framed.
  out.push("enc_command_binary\t" + esc(resp::encode_command(["SET".to_bytes(), "k\r\n*1".to_bytes(), Bytes::new(1)])))

  // --- StreamDecoder state machine ---
  let d1 = resp::StreamDecoder::default()
  d1.set_allow_inline(false)
  let _ = d1.feed("x\r\n+OK\r\n".to_bytes())
  let e1 = match d1.next_frame() {
    Ok(Some(f)) => canon(f, false)
    Ok(None) => "NONE"
    Err(e) => "ERR " + err_name(e)
  }
  let e2 = match d1.next_frame() {
    Ok(Some(f)) => canon(f, false)
    Ok(None) => "NONE"
    Err(e) => "ERR " + err_name(e)
  }
  d1.reset()
  let _ = d1.feed("+OK\r\n".to_bytes())
  let e3 = match d1.next_frame() {
    Ok(Some(f)) => canon(f, false)
    Ok(None) => "NONE"
    Err(e) => "ERR " + err_name(e)
  }
  out.push("st_error_sticky_then_reset\t" + e1 + " | " + e2 + " | " + e3 + " buffered=" + d1.buffered_len().to_string())

  // Caller mutates its chunk after feed(): decoder must have copied it.
  let d2 = resp::StreamDecoder::default()
  let chunk = "$5\r\nhello\r\n".to_bytes()
  let _ = d2.feed(chunk)
  chunk[4] = (88).to_byte()
  let a2 = match d2.next_frame() {
    Ok(Some(f)) => canon(f, false)
    _ => "NONE"
  }
  out.push("st_chunk_alias\t" + a2)

  // Decoded frame must not alias the internal ring buffer across compaction / overwrite.
  let d3 = resp::StreamDecoder::default()
  let _ = d3.feed("$5\r\nhello\r\n".to_bytes())
  let held = match d3.next_frame() {
    Ok(Some(f)) => f
    _ => resp::RespFrame::Null
  }
  let filler = repeat_bytes("$5\r\nXXXXX\r\n", 2000, "")
  let mut k = 0
  while k < 4 {
    let _ = d3.feed(filler)
    let _ = d3.drain_frames()
    k = k + 1
  }
  out.push("st_frame_alias\t" + canon(held, false) + " cap<=" + (if d3.buffer_capacity() <= 65536 { "64k" } else { d3.buffer_capacity().to_string() }))

  // decode_prefix input mutated after decode.
  let src = "*1\r\n$3\r\nabc\r\n".to_bytes()
  let held2 = match resp::decode_prefix(src, 0, resp::RespLimits::default()) {
    Ok((f, _)) => f
    Err(_) => resp::RespFrame::Null
  }
  src[8] = (90).to_byte()
  out.push("st_input_alias\t" + canon(held2, false))

  // Default StreamDecoder (client-side reply parsing): garbage reply line must not become a command Array.
  let d4 = resp::StreamDecoder::default()
  let _ = d4.feed("hello world\r\n".to_bytes())
  out.push(
    "st_default_rejects_garbage\t" +
    (match d4.next_frame() {
      Ok(Some(f)) => "OK " + canon(f, false)
      Ok(None) => "NONE"
      Err(e) => "ERR " + err_name(e)
    }),
  )

  // Explicit inline mode: inline + RESP mixed pipeline (server side).
  let d5 = resp::StreamDecoder::default()
  d5.set_allow_inline(true)
  let _ = d5.feed("PING\r\n*1\r\n$4\r\nPING\r\nECHO \"a b\"\n".to_bytes())
  out.push(
    "st_inline_pipeline\t" +
    (match d5.drain_frames() {
      Ok(fs) => canon_list(fs, false, false)
      Err(e) => "ERR " + err_name(e)
    }),
  )

  // max_buffer_bytes: overflowing feed is rejected without corrupting already-buffered data.
  let d6 = resp::StreamDecoder::new(resp::RespLimits::new(16, 1024, 64, 32, 128))
  let f1 = match d6.feed("+OK\r\n".to_bytes()) {
    Ok(_) => "ok"
    Err(e) => "ERR " + err_name(e)
  }
  let f2 = match d6.feed(repeat_bytes("A", 40, "")) {
    Ok(_) => "ok"
    Err(e) => "ERR " + err_name(e)
  }
  let f3 = match d6.next_frame() {
    Ok(Some(f)) => canon(f, false)
    Ok(None) => "NONE"
    Err(e) => "ERR " + err_name(e)
  }
  out.push("st_buffer_limit\t" + f1 + " | " + f2 + " | " + f3)

  // A BulkString of exactly max_bulk_len must be decodable by a StreamDecoder whose max_buffer_bytes
  // equals max_bulk_len (the RespLimits::default() relation: both 64 MiB).
  let d7 = resp::StreamDecoder::new(resp::RespLimits::new(16, 1024, 64, 1024, 128))
  let at_limit = concat_bytes(["$1024\r\n".to_bytes(), repeat_bytes("x", 1024, "\r\n")])
  let r7 = match d7.feed(at_limit) {
    Ok(_) =>
    match d7.next_frame() {
      Ok(Some(BulkString(b))) => "OK len=" + b.length().to_string()
      Ok(Some(f)) => "OK " + canon(f, false)
      Ok(None) => "NONE"
      Err(e) => "ERR " + err_name(e)
    }
    Err(e) => "ERR feed " + err_name(e)
  }
  out.push("st_bulk_at_limit\t" + r7)

  // Nested streamed BulkString split at every byte boundary must equal whole decode (spot check).
  let w = "*2\r\n$?\r\n;3\r\nab\n\r\n;0\r\n|1\r\n+a\r\n+b\r\n%?\r\n+k\r\n:1\r\n.\r\n".to_bytes()
  out.push("st_split_complex\t" + split_check(w))
  out
}
