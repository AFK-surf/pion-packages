import "resp"

///| Cluster probes: key_slot, MOVED/ASK, CLUSTER SLOTS + ClusterRouter.

///|
fn node_canon(n : resp::ClusterNode) -> String {
  esc(n.host.to_bytes()) + ":" + n.port.to_string()
}

///|
fn route_canon(r : resp::ClusterRouter, slot : Int) -> String {
  match r.route_slot(slot) {
    Some(n) => slot.to_string() + ":" + node_canon(n)
    None => slot.to_string() + ":-"
  }
}

///|
fn slots_canon(frame : resp::RespFrame) -> String {
  let ranges = match resp::parse_cluster_slots(frame) {
    Ok(r) => r
    Err(e) => return "ERR " + err_name(e)
  }
  let router = match resp::ClusterRouter::from_slots(ranges) {
    Ok(r) => r
    Err(e) => return "ERR " + err_name(e)
  }
  let parts : Array[String] = []
  let mut i = 0
  while i < ranges.length() {
    let r = ranges[i]
    parts.push(
      r.start.to_string() +
      "-" +
      r.end.to_string() +
      "@" +
      node_canon(r.primary) +
      "#" +
      esc(r.primary.node_id.to_bytes()) +
      "+" +
      r.replicas.length().to_string(),
    )
    i = i + 1
  }
  let probes = [0, 5460, 5461, 10922, 10923, 16383]
  let routes : Array[String] = []
  let mut j = 0
  while j < probes.length() {
    routes.push(route_canon(router, probes[j]))
    j = j + 1
  }
  "OK ranges=[" +
  join(parts, ",") +
  "] covered=" +
  router.covered_slots().to_string() +
  " route=[" +
  join(routes, ",") +
  "]"
}

///|
fn redirect_canon(msg : Bytes) -> String {
  match resp::parse_cluster_redirect(msg.to_string()) {
    Some(Moved(s, h, p)) => "MOVED " + s.to_string() + " " + esc(h.to_bytes()) + " " + p.to_string()
    Some(Ask(s, h, p)) => "ASK " + s.to_string() + " " + esc(h.to_bytes()) + " " + p.to_string()
    None => "NONE"
  }
}

///| Router hot-update / atomicity / MOVED application.
fn router_checks() -> Array[String] {
  let out : Array[String] = []
  let a = resp::ClusterNode::new("a", 1, "na")
  let b = resp::ClusterNode::new("b", 2, "nb")
  let z = resp::ClusterNode::new("z", 9, "nz")
  let r1 : Array[resp::SlotRange] = [
    resp::SlotRange::{ start: 0, end: 8191, primary: a, replicas: [] },
    resp::SlotRange::{ start: 8192, end: 16383, primary: b, replicas: [] },
  ]
  let router = match resp::ClusterRouter::from_slots(r1) {
    Ok(r) => r
    Err(_) => {
      out.push("rt_hot_update\tERR from_slots")
      return out
    }
  }
  let sb = StringBuilder::new()
  sb.write_string(route_canon(router, 0) + " " + route_canon(router, 16383))
  let r2 : Array[resp::SlotRange] = [
    resp::SlotRange::{ start: 0, end: 16383, primary: z, replicas: [] },
  ]
  match router.update_from_slots(r2) {
    Ok(_) => sb.write_string(" upd=ok")
    Err(_) => sb.write_string(" upd=ERR")
  }
  sb.write_string(" " + route_canon(router, 0) + " " + route_canon(router, 16383))
  match router.apply_moved(5, "m", 7) {
    Ok(_) => sb.write_string(" moved=ok")
    Err(_) => sb.write_string(" moved=ERR")
  }
  sb.write_string(" " + route_canon(router, 5) + " covered=" + router.covered_slots().to_string())
  let bad : Array[resp::SlotRange] = [
    resp::SlotRange::{ start: 0, end: 100, primary: a, replicas: [] },
    resp::SlotRange::{ start: 50, end: 20000, primary: b, replicas: [] },
  ]
  match router.update_from_slots(bad) {
    Ok(_) => sb.write_string(" bad=ok")
    Err(_) => sb.write_string(" bad=ERR")
  }
  sb.write_string(" " + route_canon(router, 0) + " " + route_canon(router, 5))
  out.push("rt_hot_update\t" + sb.to_string())

  let bounds : Array[String] = []
  match router.apply_moved(16384, "x", 1) {
    Ok(_) => bounds.push("ok")
    Err(_) => bounds.push("ERR")
  }
  match router.apply_moved(-1, "x", 1) {
    Ok(_) => bounds.push("ok")
    Err(_) => bounds.push("ERR")
  }
  match router.apply_moved(1, "x", 0) {
    Ok(_) => bounds.push("ok")
    Err(_) => bounds.push("ERR")
  }
  match router.apply_moved(1, "x", 65536) {
    Ok(_) => bounds.push("ok")
    Err(_) => bounds.push("ERR")
  }
  bounds.push(
    match router.route_slot(16384) {
      Some(_) => "some"
      None => "none"
    },
  )
  bounds.push(
    match router.route_slot(-1) {
      Some(_) => "some"
      None => "none"
    },
  )
  out.push("rt_bounds\t" + join(bounds, ","))

  let std = resp::ClusterRouter::new()
  let _ = std.update_from_slots([
    resp::SlotRange::{ start: 0, end: 5460, primary: a, replicas: [] },
    resp::SlotRange::{ start: 5461, end: 16383, primary: b, replicas: [] },
  ])
  let k1 = match std.route_key_string("{user1000}.following") {
    Some(n) => node_canon(n)
    None => "-"
  }
  let k2 = match std.route_key_string("{user1000}.followers") {
    Some(n) => node_canon(n)
    None => "-"
  }
  out.push("rt_route_key\t" + k1 + " " + k2 + " " + resp::key_slot_string("{user1000}.following").to_string())
  out
}
