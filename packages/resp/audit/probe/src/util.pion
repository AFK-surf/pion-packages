import "resp"

///| Shared helpers for the `resp` red-team probe: hex, canonical escaping, TSV IO, LCG.

///|
fn hex_nib(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

///|
fn hex_ch(v : Int) -> Byte {
  if v < 10 {
    (48 + v).to_byte()
  } else {
    (87 + v).to_byte()
  }
}

///| Decode hex digits in `src[start .. end]`.
fn hex_decode(src : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let h = hex_nib(src[start + i * 2].to_int())
    let l = hex_nib(src[start + i * 2 + 1].to_int())
    out[i] = ((h << 4) | l).to_byte()
    i = i + 1
  }
  out
}

///| Canonical quoted escaping: printable ASCII except `"` and `\` verbatim, everything else `\xHH`.
fn esc_into(sb : StringBuilder, b : Bytes) -> Unit {
  sb.write_byte((34).to_byte())
  let n = b.length()
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c >= 32 && c <= 126 && c != 34 && c != 92 {
      sb.write_byte(b[i])
    } else {
      sb.write_byte((92).to_byte())
      sb.write_byte((120).to_byte())
      sb.write_byte(hex_ch((c >> 4) & 15))
      sb.write_byte(hex_ch(c & 15))
    }
    i = i + 1
  }
  sb.write_byte((34).to_byte())
}

///|
fn esc(b : Bytes) -> String {
  let sb = StringBuilder::new()
  esc_into(sb, b)
  sb.to_string()
}

///|
fn esc_hex(b : Bytes) -> String {
  let sb = StringBuilder::new()
  let n = b.length()
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    sb.write_byte(hex_ch((c >> 4) & 15))
    sb.write_byte(hex_ch(c & 15))
    i = i + 1
  }
  sb.to_string()
}

///| Lexicographic byte comparison of two strings: true if a < b.
fn str_lt(a : String, b : String) -> Bool {
  let x = a.to_bytes()
  let y = b.to_bytes()
  let n = if x.length() < y.length() { x.length() } else { y.length() }
  let mut i = 0
  while i < n {
    let p = x[i].to_int()
    let q = y[i].to_int()
    if p != q {
      return p < q
    }
    i = i + 1
  }
  x.length() < y.length()
}

///| Insertion sort (inputs are tiny).
fn sort_strings(xs : Array[String]) -> Unit {
  let mut i = 1
  while i < xs.length() {
    let cur = xs[i]
    let mut j = i - 1
    while j >= 0 && str_lt(cur, xs[j]) {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = cur
    i = i + 1
  }
}

///|
fn join(xs : Array[String], sep : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(xs[i])
    i = i + 1
  }
  sb.to_string()
}

///| A TSV row of hex-encoded cases: `id \t hex`.
struct HexCase {
  id : String
  data : Bytes
}

///| Parse `id<TAB>hex` lines (as produced by tools/prep.py).
fn parse_hex_cases(raw : Bytes) -> Array[HexCase] {
  let out : Array[HexCase] = []
  let n = raw.length()
  let mut pos = 0
  while pos < n {
    let mut eol = pos
    while eol < n && raw[eol].to_int() != 10 {
      eol = eol + 1
    }
    let mut tab = pos
    while tab < eol && raw[tab].to_int() != 9 {
      tab = tab + 1
    }
    if tab < eol {
      let id = raw.slice(pos, tab).to_string()
      out.push(HexCase::{ id: id, data: hex_decode(raw, tab + 1, eol) })
    }
    pos = eol + 1
  }
  out
}

///| Deterministic 31-bit LCG.
struct Lcg {
  mut s : Int
}

///|
fn Lcg::next(self : Lcg, bound : Int) -> Int {
  self.s = (self.s * 1103515245 + 12345) & 0x7FFFFFFF
  (self.s >> 8) % bound
}

///|
fn bytes_of(s : String) -> Bytes {
  s.to_bytes()
}

///| Repeat `unit` `n` times followed by `tail`.
fn repeat_bytes(unit : String, n : Int, tail : String) -> Bytes {
  let u = unit.to_bytes()
  let t = tail.to_bytes()
  let ul = u.length()
  let out = Bytes::new(ul * n + t.length())
  let mut i = 0
  while i < n {
    let mut j = 0
    while j < ul {
      out[i * ul + j] = u[j]
      j = j + 1
    }
    i = i + 1
  }
  let mut k = 0
  while k < t.length() {
    out[ul * n + k] = t[k]
    k = k + 1
  }
  out
}

///| Concatenate byte arrays.
fn concat_bytes(parts : Array[Bytes]) -> Bytes {
  let mut total = 0
  let mut i = 0
  while i < parts.length() {
    total = total + parts[i].length()
    i = i + 1
  }
  let out = Bytes::new(total)
  let mut off = 0
  i = 0
  while i < parts.length() {
    let p = parts[i]
    let mut j = 0
    while j < p.length() {
      out[off + j] = p[j]
      j = j + 1
    }
    off = off + p.length()
    i = i + 1
  }
  out
}
