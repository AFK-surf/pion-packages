import "resp"

///| Red-team audit probe for `packages/resp` (see ../REPORT.md). Deterministic stdout per mode
///| so run_audit.sh can diff Native/Wasm32 x debug/release byte-for-byte.

///|
fn load(world : World, path : String) -> Array[HexCase] {
  match fs_read_bytes(world, path) {
    Ok(b) => parse_hex_cases(b)
    Err(_) => []
  }
}

///|
fn usage(world : World) -> Int {
  io_println(world, "usage: probe decode|inline|keys|redirect|slots <hex.tsv> | builtin | dos-list | dos <id> | stress <n> | cx <id> | w3split | fuzz <hex.tsv> <seed> <iters>")
  1
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    return usage(world)
  }
  let mode = args[1]
  let sb = StringBuilder::new()
  if mode == "decode" || mode == "inline" || mode == "keys" || mode == "redirect" || mode == "slots" {
    if args.length() < 3 {
      return usage(world)
    }
    let cases = load(world, args[2])
    if cases.length() == 0 {
      io_println(world, "no cases loaded from " + args[2])
      return 2
    }
    let mut i = 0
    while i < cases.length() {
      let c = cases[i]
      sb.write_string(c.id)
      sb.write_string("\t")
      if mode == "decode" {
        let r = resp::decode(c.data, resp::RespLimits::default())
        sb.write_string(result_canon(r, false))
        sb.write_string("\t")
        sb.write_string(result_canon(r, true))
        sb.write_string("\t")
        sb.write_string(split_check(c.data))
      } else if mode == "inline" {
        match resp::decode_inline(c.data, resp::RespLimits::default()) {
          Ok(argv) => {
            let parts : Array[String] = []
            let mut j = 0
            while j < argv.length() {
              parts.push(esc(argv[j]))
              j = j + 1
            }
            sb.write_string("OK [" + join(parts, ",") + "]")
          }
          Err(e) => sb.write_string("ERR " + err_name(e))
        }
      } else if mode == "keys" {
        sb.write_string(resp::key_slot(c.data).to_string())
      } else if mode == "redirect" {
        sb.write_string(redirect_canon(c.data))
      } else {
        match resp::decode_default(c.data) {
          Ok(f) => sb.write_string(slots_canon(f))
          Err(e) => sb.write_string("ERR wire " + err_name(e))
        }
      }
      sb.write_string("\n")
      i = i + 1
    }
    io_print(world, sb.to_string())
    0
  } else if mode == "builtin" {
    let rows = builtin_checks()
    let rr = router_checks()
    let mut i = 0
    while i < rr.length() {
      rows.push(rr[i])
      i = i + 1
    }
    io_println(world, join(rows, "\n"))
    0
  } else if mode == "dos-list" {
    io_println(world, join(dos_ids(), "\n"))
    0
  } else if mode == "dos" {
    if args.length() < 3 {
      return usage(world)
    }
    io_println(world, args[2] + "\t" + run_dos(args[2]))
    0
  } else if mode == "stress" {
    if args.length() < 3 {
      return usage(world)
    }
    let n = match args[2].to_int() {
      Some(v) => v
      None => 100000
    }
    run_stress(world, n)
  } else if mode == "cx" {
    if args.length() < 3 {
      return usage(world)
    }
    run_cx(world, args[2])
  } else if mode == "w3split" {
    run_w3split(world)
  } else if mode == "fuzz" {
    if args.length() < 5 {
      return usage(world)
    }
    let seed = match args[3].to_int() {
      Some(v) => v
      None => 1
    }
    let iters = match args[4].to_int() {
      Some(v) => v
      None => 1000
    }
    run_fuzz(world, load(world, args[2]), seed, iters)
  } else {
    usage(world)
  }
}
