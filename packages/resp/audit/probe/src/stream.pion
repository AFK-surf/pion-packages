import "resp"

///| Split-feed consistency: StreamDecoder event sequences vs repeated `decode_prefix()`.

///|
fn audit_limits() -> resp::RespLimits {
  resp::RespLimits::default()
}

///| Reference event sequence: repeated `decode_prefix()` over the whole buffer.
fn ref_events(data : Bytes) -> String {
  let ev : Array[String] = []
  let n = data.length()
  let mut off = 0
  while off < n {
    match resp::decode_prefix(data, off, audit_limits()) {
      Ok((f, next)) => {
        ev.push(canon(f, false))
        off = next
      }
      Err(Incomplete) => {
        ev.push("INC" + (n - off).to_string())
        return join(ev, ";")
      }
      Err(_) => {
        ev.push("ERR")
        return join(ev, ";")
      }
    }
  }
  join(ev, ";")
}

///| Feed `data` into a fresh StreamDecoder (inline disabled) using a chunk pattern:
///| `pattern > 0` fixed chunk size; `pattern <= 0` LCG random 1..17 sizes seeded by `1 - pattern`;
///| `use_drain` pulls with `drain_frames()` instead of `next_frame()`.
fn stream_events(data : Bytes, pattern : Int, use_drain : Bool) -> String {
  let dec = resp::StreamDecoder::new(audit_limits())
  dec.set_allow_inline(false)
  let ev : Array[String] = []
  let rng = Lcg::{ s: 1 - pattern }
  let n = data.length()
  let mut off = 0
  while off < n {
    let step = if pattern > 0 { pattern } else { 1 + rng.next(17) }
    let take = if step < n - off { step } else { n - off }
    match dec.feed(data.slice(off, off + take)) {
      Ok(_) => ()
      Err(_) => {
        ev.push("FEEDERR")
        return join(ev, ";")
      }
    }
    off = off + take
    if use_drain {
      match dec.drain_frames() {
        Ok(fs) => {
          let mut j = 0
          while j < fs.length() {
            ev.push(canon(fs[j], false))
            j = j + 1
          }
        }
        Err(_) => {
          ev.push("ERR")
          return join(ev, ";")
        }
      }
    } else {
      let mut more = true
      while more {
        match dec.next_frame() {
          Ok(Some(f)) => ev.push(canon(f, false))
          Ok(None) => more = false
          Err(_) => {
            ev.push("ERR")
            return join(ev, ";")
          }
        }
      }
    }
  }
  if dec.buffered_len() > 0 {
    ev.push("INC" + dec.buffered_len().to_string())
  }
  join(ev, ";")
}

///| `ok` when every split pattern reproduces the reference sequence, else the first difference.
fn split_check(data : Bytes) -> String {
  let want = ref_events(data)
  let patterns = [1, 2, 3, 7, 64, 0, -1, -2]
  let mut i = 0
  while i < patterns.length() {
    let got = stream_events(data, patterns[i], false)
    if got != want {
      return "DIFF p=" + patterns[i].to_string() + " want=" + want + " got=" + got
    }
    i = i + 1
  }
  let got_d = stream_events(data, 0, true)
  if got_d != want {
    return "DIFF p=drain want=" + want + " got=" + got_d
  }
  "ok"
}
