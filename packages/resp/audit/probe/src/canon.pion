import "resp"

///| Canonical frame rendering shared with the Rust `redis-protocol` oracle and tools/judge.py.
///| `o = true` renders the oracle-comparable form: every null variant as `_`, Map/Set/Attribute
///| entries sorted (redis-protocol stores them in hash containers).

///|
fn dbl_canon(d : Double) -> String {
  if d != d {
    return "nan"
  }
  let bits = d.to_bits().to_uint64()
  let sb = StringBuilder::new()
  sb.write_string("0x")
  let mut shift = 60
  while shift >= 0 {
    sb.write_byte(hex_ch(((bits >> shift) & 15UL).to_int()))
    shift = shift - 4
  }
  sb.to_string()
}

///|
fn canon_list(xs : Array[resp::RespFrame], o : Bool, sorted : Bool) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < xs.length() {
    parts.push(canon(xs[i], o))
    i = i + 1
  }
  if sorted && o {
    sort_strings(parts)
  }
  join(parts, ",")
}

///|
fn canon_pairs(ps : Array[(resp::RespFrame, resp::RespFrame)], o : Bool) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < ps.length() {
    let (k, v) = ps[i]
    parts.push(canon(k, o) + ":" + canon(v, o))
    i = i + 1
  }
  if o {
    sort_strings(parts)
  }
  join(parts, ",")
}

///| Canonical text for a decoded frame.
fn canon(f : resp::RespFrame, o : Bool) -> String {
  match f {
    SimpleString(s) => "+" + esc(s.to_bytes())
    SimpleError(s) => "-" + esc(s.to_bytes())
    Integer(v) => ":" + v.to_string()
    BulkString(b) => "$" + esc(b)
    Array(xs) => "*[" + canon_list(xs, o, false) + "]"
    Null => "_"
    NullBulk => if o { "_" } else { "$null" }
    NullArray => if o { "_" } else { "*null" }
    Boolean(v) => if v { "#t" } else { "#f" }
    Double(d) => "," + dbl_canon(d)
    BigNumber(s) => "(" + esc(s.to_bytes())
    BulkError(b) => "!" + esc(b)
    VerbatimString(t, p) => "=" + esc(t.to_bytes()) + ":" + esc(p)
    Map(ps) => "%{" + canon_pairs(ps, o) + "}"
    Set(xs) => "~[" + canon_list(xs, o, true) + "]"
    Attribute(ps, t) => "|{" + canon_pairs(ps, o) + "}" + canon(t, o)
    Push(xs) => ">[" + canon_list(xs, o, false) + "]"
  }
}

///| Short stable name for a `RespError` variant.
fn err_name(e : resp::RespError) -> String {
  match e {
    Incomplete => "Incomplete"
    InvalidPrefix(_, _) => "InvalidPrefix"
    InvalidCrlf(_) => "InvalidCrlf"
    InvalidInteger(_) => "InvalidInteger"
    InvalidDouble(_) => "InvalidDouble"
    InvalidBoolean(_) => "InvalidBoolean"
    InvalidBigNumber(_) => "InvalidBigNumber"
    InvalidBulkLength(_, _) => "InvalidBulkLength"
    InvalidCollectionLength(_, _) => "InvalidCollectionLength"
    InvalidVerbatimFormat(_) => "InvalidVerbatimFormat"
    InvalidChunkLength(_) => "InvalidChunkLength"
    InvalidInlineQuote(_) => "InvalidInlineQuote"
    UnexpectedEndMarker(_) => "UnexpectedEndMarker"
    DanglingAttribute(_) => "DanglingAttribute"
    MaxDepthExceeded(_) => "MaxDepthExceeded"
    MaxBulkLenExceeded(_) => "MaxBulkLenExceeded"
    MaxCollectionLenExceeded(_) => "MaxCollectionLenExceeded"
    MaxBufferBytesExceeded(_) => "MaxBufferBytesExceeded"
    MaxTotalNodesExceeded(_) => "MaxTotalNodesExceeded"
    TrailingBytes(_) => "TrailingBytes"
    InvalidClusterReply(_) => "InvalidClusterReply"
    EncodeError(_) => "EncodeError"
  }
}

///| `OK <canon>` / `INC` / `ERR <name>` for a whole-buffer decode result.
fn result_canon(r : Result[resp::RespFrame, resp::RespError], o : Bool) -> String {
  match r {
    Ok(f) => "OK " + canon(f, o)
    Err(Incomplete) => "INC"
    Err(e) => "ERR " + err_name(e)
  }
}
