import "resp"

///| DoS / memory-safety probes. Each case runs in its own process (run_audit.sh) so a panic,
///| trap or stack overflow is attributed to exactly one case.

///|
fn permissive() -> resp::RespLimits {
  resp::RespLimits::new(128, 2147483647, 2147483647, 2147483647, 2147483647)
}

///|
fn dos_ids() -> Array[String] {
  [
    "dos_bulk_i32max", "dos_bulk_20digits", "dos_bulk_i64max", "dos_arr_1e9", "dos_map_5e8",
    "dos_set_1e9", "dos_bulk_neg2", "dos_arr_neg999", "dos_chunk_huge", "dos_deep_array_10k",
    "dos_deep_map_10k", "dos_deep_set_10k", "dos_deep_push_10k", "dos_deep_attr_value_10k",
    "dos_deep_attr_chain_10k", "dos_deep_stream_10k", "dos_deep_mixed_10k", "dos_deep_stream_decoder_10k",
    "dos_deep_unlimited_100k", "dos_encode_deep_200k", "dos_wide_1m", "dos_wide_at_limit", "dos_long_double",
    "dos_huge_exponent", "dos_long_bignum", "dos_ovf_bulk", "dos_ovf_bulk_error", "dos_ovf_verbatim",
    "dos_ovf_chunk", "dos_ovf_chunk_accum", "dos_ovf_stream_decoder", "dos_inline_unbounded",
  ]
}

///|
fn r_canon(r : Result[resp::RespFrame, resp::RespError]) -> String {
  match r {
    Ok(_) => "OK"
    Err(Incomplete) => "INC"
    Err(e) => "ERR " + err_name(e)
  }
}

///|
fn deep(unit : String, n : Int, tail : String, lim : resp::RespLimits) -> String {
  r_canon(resp::decode(repeat_bytes(unit, n, tail), lim))
}

///|
fn run_dos(id : String) -> String {
  let d = resp::RespLimits::default()
  if id == "dos_bulk_i32max" {
    r_canon(resp::decode("$2147483647\r\n".to_bytes(), d))
  } else if id == "dos_bulk_20digits" {
    r_canon(resp::decode("$99999999999999999999\r\n".to_bytes(), d))
  } else if id == "dos_bulk_i64max" {
    r_canon(resp::decode("$9223372036854775807\r\n".to_bytes(), d))
  } else if id == "dos_arr_1e9" {
    r_canon(resp::decode("*1000000000\r\n".to_bytes(), d))
  } else if id == "dos_map_5e8" {
    r_canon(resp::decode("%500000000\r\n".to_bytes(), d))
  } else if id == "dos_set_1e9" {
    r_canon(resp::decode("~1000000000\r\n".to_bytes(), d))
  } else if id == "dos_bulk_neg2" {
    r_canon(resp::decode("$-2\r\n".to_bytes(), d))
  } else if id == "dos_arr_neg999" {
    r_canon(resp::decode("*-999\r\n".to_bytes(), d))
  } else if id == "dos_chunk_huge" {
    r_canon(resp::decode("$?\r\n;9999999999\r\n".to_bytes(), d))
  } else if id == "dos_deep_array_10k" {
    deep("*1\r\n", 10000, ":1\r\n", d)
  } else if id == "dos_deep_map_10k" {
    deep("%1\r\n+k\r\n", 10000, ":1\r\n", d)
  } else if id == "dos_deep_set_10k" {
    deep("~1\r\n", 10000, ":1\r\n", d)
  } else if id == "dos_deep_push_10k" {
    deep(">1\r\n", 10000, ":1\r\n", d)
  } else if id == "dos_deep_attr_value_10k" {
    deep("|1\r\n+k\r\n", 10000, ":1\r\n:1\r\n", d)
  } else if id == "dos_deep_attr_chain_10k" {
    deep("|0\r\n", 10000, ":1\r\n", d)
  } else if id == "dos_deep_stream_10k" {
    deep("*?\r\n", 10000, "", d)
  } else if id == "dos_deep_mixed_10k" {
    deep("*1\r\n%1\r\n~1\r\n|1\r\n+a\r\n+b\r\n>1\r\n*?\r\n", 2000, ":1\r\n", d)
  } else if id == "dos_deep_stream_decoder_10k" {
    let dec = resp::StreamDecoder::default()
    let w = repeat_bytes("*1\r\n", 10000, ":1\r\n")
    let mut off = 0
    let mut res = "NONE"
    while off < w.length() && res == "NONE" {
      let end = if off + 4096 < w.length() { off + 4096 } else { w.length() }
      let _ = dec.feed(w.slice(off, end))
      res = match dec.next_frame() {
        Ok(Some(_)) => "OK"
        Ok(None) => "NONE"
        Err(e) => "ERR " + err_name(e)
      }
      off = end
    }
    res
  } else if id == "dos_deep_unlimited_100k" {
    // README claims 0 stack overflow on deep payloads: decode, encode, compare and drop a
    // 100,000-deep frame with an unlimited depth budget on every target.
    let lim = resp::RespLimits::new(1000000, 1024, 1024, 100000000, 100000000)
    let w = repeat_bytes("*1\r\n", 100000, "_\r\n")
    match resp::decode(w, lim) {
      Ok(f) => {
        let enc_ok = match resp::encode(f) {
          Ok(b) => resp::bytes_equal(b, w)
          Err(_) => false
        }
        "OK enc=" + enc_ok.to_string() + " eq=" + resp::resp_equals(f, f).to_string()
      }
      Err(e) => "ERR " + err_name(e)
    }
  } else if id == "dos_encode_deep_200k" {
    let mut f = resp::RespFrame::Null
    let mut i = 0
    while i < 200000 {
      f = resp::RespFrame::Array([f])
      i = i + 1
    }
    match resp::encode(f) {
      Ok(b) => "OK len=" + b.length().to_string()
      Err(e) => "ERR " + err_name(e)
    }
  } else if id == "dos_wide_1m" {
    r_canon(resp::decode(concat_bytes(["*1048575\r\n".to_bytes(), repeat_bytes("_\r\n", 1048575, "")]), d))
  } else if id == "dos_wide_at_limit" {
    // An Array of exactly max_collection_len (1,048,576) elements must decode with default limits.
    r_canon(resp::decode(concat_bytes(["*1048576\r\n".to_bytes(), repeat_bytes("_\r\n", 1048576, "")]), d))
  } else if id == "dos_long_double" {
    r_canon(resp::decode(concat_bytes([",1".to_bytes(), repeat_bytes("0", 200000, ".5\r\n")]), d))
  } else if id == "dos_huge_exponent" {
    r_canon(resp::decode(",1e2147483648\r\n".to_bytes(), d)) +
    "/" +
    r_canon(resp::decode(",1e-99999999999999999999\r\n".to_bytes(), d))
  } else if id == "dos_long_bignum" {
    r_canon(resp::decode(concat_bytes(["(".to_bytes(), repeat_bytes("9", 4000000, "\r\n")]), d))
  } else if id == "dos_ovf_bulk" {
    r_canon(resp::decode("$2147483646\r\nab".to_bytes(), permissive()))
  } else if id == "dos_ovf_bulk_error" {
    r_canon(resp::decode("!2147483640\r\nab".to_bytes(), permissive()))
  } else if id == "dos_ovf_verbatim" {
    r_canon(resp::decode("=2147483646\r\ntxt:ab".to_bytes(), permissive()))
  } else if id == "dos_ovf_chunk" {
    r_canon(resp::decode("$?\r\n;2147483646\r\nab".to_bytes(), permissive()))
  } else if id == "dos_ovf_chunk_accum" {
    r_canon(resp::decode("$?\r\n;8\r\nAAAAAAAA\r\n;2147483644\r\nab".to_bytes(), permissive()))
  } else if id == "dos_ovf_stream_decoder" {
    let dec = resp::StreamDecoder::new(permissive())
    let _ = dec.feed("$2147483646\r\nab".to_bytes())
    match dec.next_frame() {
      Ok(Some(_)) => "OK"
      Ok(None) => "INC"
      Err(e) => "ERR " + err_name(e)
    }
  } else if id == "dos_inline_unbounded" {
    // Redis caps inline requests at PROTO_INLINE_MAX_SIZE (64 KiB): "too big inline request".
    let dec = resp::StreamDecoder::default()
    let chunk = repeat_bytes("a", 4096, "")
    let mut fed = 0
    let mut res = "NONE"
    while fed < 1048576 && res == "NONE" {
      match dec.feed(chunk) {
        Ok(_) => ()
        Err(e) => res = "ERR " + err_name(e)
      }
      fed = fed + 4096
      if res == "NONE" {
        res = match dec.next_frame() {
          Ok(Some(_)) => "OK"
          Ok(None) => "NONE"
          Err(e) => "ERR " + err_name(e)
        }
      }
    }
    res + " buffered=" + dec.buffered_len().to_string()
  } else {
    "UNKNOWN"
  }
}
