///| Security, DoS protection, malformed wire input, and iterative stack-safety tests.

///|
test "security_dos_limits_depth_bulk_collection_buffer_nodes" {
  // 1. Deep nesting (20,000 nested arrays) must NOT stack-overflow and must fail with MaxDepthExceeded
  let depth_n = 20000
  let deep = Bytes::new(depth_n * 4 + 5)
  let mut i = 0
  while i < depth_n {
    deep[i * 4] = (42).to_byte() // '*'
    deep[i * 4 + 1] = (49).to_byte() // '1'
    deep[i * 4 + 2] = (13).to_byte() // '\r'
    deep[i * 4 + 3] = (10).to_byte() // '\n'
    i = i + 1
  }
  let base = depth_n * 4
  deep[base] = (43).to_byte() // '+'
  deep[base + 1] = (79).to_byte() // 'O'
  deep[base + 2] = (75).to_byte() // 'K'
  deep[base + 3] = (13).to_byte()
  deep[base + 4] = (10).to_byte()

  match decode_default(deep) {
    Err(MaxDepthExceeded(128)) => ()
    _ => debug_assert(false, "20,000 nested arrays must fail with MaxDepthExceeded(128)")
  }

  // 2. BulkString pre-allocation OOM bomb ($999999999\r\n) rejected before any allocation
  let small_limits = RespLimits::new(16, 1024, 64, 4096, 128)
  match decode("$999999999\r\nabc\r\n".to_bytes(), small_limits) {
    Err(MaxBulkLenExceeded(1024)) => ()
    _ => debug_assert(false, "oversized bulk length must fail with MaxBulkLenExceeded")
  }

  // 3. Collection pre-allocation OOM bomb (*999999999\r\n) rejected before any allocation
  match decode("*999999999\r\n".to_bytes(), small_limits) {
    Err(MaxCollectionLenExceeded(64)) => ()
    _ => debug_assert(false, "oversized array length must fail with MaxCollectionLenExceeded")
  }
  match decode("%999999999\r\n".to_bytes(), small_limits) {
    Err(MaxCollectionLenExceeded(64)) => ()
    _ => debug_assert(false, "oversized map length must fail with MaxCollectionLenExceeded")
  }

  // 4. StreamDecoder max_buffer_bytes limit
  let dec = StreamDecoder::new(RespLimits::new(16, 1024, 64, 32, 128))
  match dec.feed("$100\r\n0123456789012345678901234567890123456789".to_bytes()) {
    Err(MaxBufferBytesExceeded(32)) => ()
    _ => debug_assert(false, "oversized stream feed must fail with MaxBufferBytesExceeded")
  }

  // 5. max_total_nodes limit across nested containers
  let node_limits = RespLimits::new(16, 1024, 64, 4096, 5)
  match decode("*6\r\n:1\r\n:2\r\n:3\r\n:4\r\n:5\r\n:6\r\n".to_bytes(), node_limits) {
    Err(MaxTotalNodesExceeded(5)) => ()
    _ => debug_assert(false, "exceeding max_total_nodes must fail with MaxTotalNodesExceeded")
  }
}

///|
test "security_malformed_inputs_and_encode_validation" {
  // Invalid bulk length (< -1)
  match decode_default("$-2\r\n".to_bytes()) {
    Err(InvalidBulkLength(n, _)) => debug_assert(n == -2L, "expected bulk length -2")
    _ => debug_assert(false, "$-2 must fail with InvalidBulkLength")
  }

  // Invalid array length (< -1)
  match decode_default("*-2\r\n".to_bytes()) {
    Err(InvalidCollectionLength(n, _)) => debug_assert(n == -2L, "expected array length -2")
    _ => debug_assert(false, "*-2 must fail with InvalidCollectionLength")
  }

  // Missing CRLF after bulk payload
  match decode_default("$3\r\nabcXX".to_bytes()) {
    Err(InvalidCrlf(_)) => ()
    _ => debug_assert(false, "missing CRLF after bulk payload must fail")
  }

  // Invalid boolean
  match decode_default("#x\r\n".to_bytes()) {
    Err(InvalidBoolean(_)) => ()
    _ => debug_assert(false, "#x must fail with InvalidBoolean")
  }

  // Invalid integer
  match decode_default(":12a3\r\n".to_bytes()) {
    Err(InvalidInteger(_)) => ()
    _ => debug_assert(false, ":12a3 must fail with InvalidInteger")
  }

  // Invalid double
  match decode_default(",not_a_num\r\n".to_bytes()) {
    Err(InvalidDouble(_)) => ()
    _ => debug_assert(false, ",not_a_num must fail with InvalidDouble")
  }

  // Invalid BigNumber
  match decode_default("(123abc\r\n".to_bytes()) {
    Err(InvalidBigNumber(_)) => ()
    _ => debug_assert(false, "(123abc must fail with InvalidBigNumber")
  }

  // Invalid VerbatimString (length < 4 or missing ':')
  match decode_default("=3\r\nabc\r\n".to_bytes()) {
    Err(InvalidVerbatimFormat(_)) => ()
    _ => debug_assert(false, "=3 must fail with InvalidVerbatimFormat")
  }
  match decode_default("=5\r\ntxt!a\r\n".to_bytes()) {
    Err(InvalidVerbatimFormat(_)) => ()
    _ => debug_assert(false, "missing ':' in verbatim string must fail")
  }

  // Trailing bytes rejected by decode()
  match decode_default("+OK\r\n+EXTRA\r\n".to_bytes()) {
    Err(TrailingBytes(5)) => ()
    _ => debug_assert(false, "trailing bytes must fail with TrailingBytes(5)")
  }

  // CRLF injection prevented in SimpleString / SimpleError encode()
  match encode(RespFrame::SimpleString("OK\r\n+INJECTED")) {
    Err(EncodeError(_)) => ()
    _ => debug_assert(false, "CRLF in SimpleString must be rejected on encode")
  }
  match encode(RespFrame::SimpleError("ERR\nbad")) {
    Err(EncodeError(_)) => ()
    _ => debug_assert(false, "LF in SimpleError must be rejected on encode")
  }
}

///|
test "redteam_p1_p2_regressions" {
  // P1-01: Int32 length addition overflow with permissive RespLimits must return Incomplete/Err (zero panic)
  let perm = RespLimits::new(128, 2147483647, 2147483647, 2147483647, 2147483647)
  match decode("$2147483646\r\nab".to_bytes(), perm) {
    Err(Incomplete) => ()
    _ => debug_assert(false, "P1-01 bulk overflow must return Incomplete")
  }
  match decode("!2147483640\r\nab".to_bytes(), perm) {
    Err(Incomplete) => ()
    _ => debug_assert(false, "P1-01 bulk error overflow must return Incomplete")
  }
  match decode("=2147483646\r\ntxt:ab".to_bytes(), perm) {
    Err(Incomplete) => ()
    _ => debug_assert(false, "P1-01 verbatim overflow must return Incomplete")
  }
  match decode("$?\r\n;2147483646\r\nab".to_bytes(), perm) {
    Err(Incomplete) => ()
    _ => debug_assert(false, "P1-01 chunk overflow must return Incomplete")
  }
  match decode("$?\r\n;8\r\nAAAAAAAA\r\n;2147483644\r\nab".to_bytes(), perm) {
    Err(MaxBulkLenExceeded(_)) => ()
    _ => debug_assert(false, "P1-01 chunk accum overflow must return MaxBulkLenExceeded")
  }

  // P1-02: Incremental StreamDecoder handles fragmented aggregates and streamed bulk cleanly
  let dec_inc = StreamDecoder::default()
  let frag_wire = "*4\r\n:1\r\n$?\r\n;2\r\nhi\r\n;3\r\n!!!\r\n;0\r\n%?\r\n+a\r\n:2\r\n.\r\n+ok\r\n".to_bytes()
  let mut fi = 0
  let mut got_frag = false
  while fi < frag_wire.length() {
    let b1 = Bytes::new(1)
    b1[0] = frag_wire[fi]
    match dec_inc.feed(b1) {
      Ok(_) => ()
      Err(e) => debug_assert(false, "P1-02 feed failed: " + error_message(e))
    }
    match dec_inc.next_frame() {
      Ok(Some(_)) => got_frag = true
      Ok(None) => ()
      Err(e) => debug_assert(false, "P1-02 next_frame failed: " + error_message(e))
    }
    fi = fi + 1
  }
  debug_assert(got_frag && dec_inc.buffered_len() == 0, "P1-02 incremental frame decoded")

  // P1-03: Inline length cap enforced (default 65536 = 64 KiB)
  let dec_inl = StreamDecoder::new(RespLimits::default().with_max_inline_len(32)).with_allow_inline(true)
  match dec_inl.feed("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa".to_bytes()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, error_message(e))
  }
  match dec_inl.next_frame() {
    Err(MaxBufferBytesExceeded(32)) => ()
    _ => debug_assert(false, "P1-03 inline over max_inline_len must fail")
  }

  // P2-01: SimpleString / SimpleError reject embedded lone CR or LF
  match decode_default("+a\nb\r\n".to_bytes()) {
    Err(InvalidCrlf(_)) => ()
    _ => debug_assert(false, "P2-01 SimpleString lone LF must fail")
  }
  match decode_default("+a\rb\r\n".to_bytes()) {
    Err(InvalidCrlf(_)) => ()
    _ => debug_assert(false, "P2-01 SimpleString lone CR must fail")
  }
  match decode_default("-ERR\nx\r\n".to_bytes()) {
    Err(InvalidCrlf(_)) => ()
    _ => debug_assert(false, "P2-01 SimpleError lone LF must fail")
  }
  match decode_default("-ERR\rx\r\n".to_bytes()) {
    Err(InvalidCrlf(_)) => ()
    _ => debug_assert(false, "P2-01 SimpleError lone CR must fail")
  }

  // P2-02: Strict Double grammar
  match decode_default(",.5\r\n".to_bytes()) {
    Err(InvalidDouble(_)) => ()
    _ => debug_assert(false, "P2-02 ,.5 must fail")
  }
  match decode_default(",1.\r\n".to_bytes()) {
    Err(InvalidDouble(_)) => ()
    _ => debug_assert(false, "P2-02 ,1. must fail")
  }
  match decode_default(",Inf\r\n".to_bytes()) {
    Err(InvalidDouble(_)) => ()
    _ => debug_assert(false, "P2-02 ,Inf must fail")
  }
  match decode_default(",INF\r\n".to_bytes()) {
    Err(InvalidDouble(_)) => ()
    _ => debug_assert(false, "P2-02 ,INF must fail")
  }
  match decode_default(",NaN\r\n".to_bytes()) {
    Err(InvalidDouble(_)) => ()
    _ => debug_assert(false, "P2-02 ,NaN must fail")
  }

  // P2-03: BigNumber accepts leading '+' on both decode and encode
  match decode_default("(+12345\r\n".to_bytes()) {
    Ok(BigNumber(s)) => debug_assert(s == "+12345", "P2-03 decode BigNumber +12345")
    _ => debug_assert(false, "P2-03 decode BigNumber +12345 must succeed")
  }
  match encode(RespFrame::BigNumber("+12345")) {
    Ok(b) => debug_assert(bytes_equal(b, "(+12345\r\n".to_bytes()), "P2-03 encode BigNumber +12345")
    Err(e) => debug_assert(false, "P2-03 encode BigNumber failed: " + error_message(e))
  }

  // P2-04: decode_inline matches Redis sdssplitargs
  let lim = RespLimits::default()
  match decode_inline("'a\\\\b'\r\n".to_bytes(), lim) {
    Ok(args) => debug_assert(args.length() == 1 && bytes_equal(args[0], "a\\\\b".to_bytes()), "P2-04 single-quote \\\\")
    Err(e) => debug_assert(false, "P2-04 single-quote failed: " + error_message(e))
  }
  match decode_inline("a\"b c\" key'x y'\r\n".to_bytes(), lim) {
    Ok(args) => {
      debug_assert(args.length() == 2, "P2-04 mid-token quotes len")
      debug_assert(bytes_equal(args[0], "ab c".to_bytes()), "P2-04 mid-token dq")
      debug_assert(bytes_equal(args[1], "keyx y".to_bytes()), "P2-04 mid-token sq")
    }
    Err(e) => debug_assert(false, "P2-04 mid-token quotes failed: " + error_message(e))
  }
  let vtab = Bytes::new(7)
  vtab[0] = (11).to_byte() // \v
  vtab[1] = (80).to_byte() // P
  vtab[2] = (73).to_byte() // I
  vtab[3] = (78).to_byte() // N
  vtab[4] = (71).to_byte() // G
  vtab[5] = (13).to_byte()
  vtab[6] = (10).to_byte()
  match decode_inline(vtab, lim) {
    Ok(args) => debug_assert(args.length() == 1 && bytes_equal(args[0], "PING".to_bytes()), "P2-04 leading \\v")
    Err(e) => debug_assert(false, "P2-04 leading \\v failed: " + error_message(e))
  }

  // P2-05: StreamDecoder::default() rejects garbage reply line (inline disabled by default)
  let dec_def = StreamDecoder::default()
  let _ = dec_def.feed("hello world\r\n".to_bytes())
  match dec_def.next_frame() {
    Err(InvalidPrefix(_, _)) => ()
    _ => debug_assert(false, "P2-05 default StreamDecoder must reject non-RESP line")
  }

  // P2-06: MOVED / ASK empty endpoint `:6380`
  match parse_cluster_redirect("MOVED 123 :6380") {
    Some(Moved(123, h, 6380)) => debug_assert(h == "", "P2-06 MOVED empty host")
    _ => debug_assert(false, "P2-06 MOVED :6380 must succeed")
  }
  match parse_cluster_redirect("ASK 456 :6380") {
    Some(Ask(456, h, 6380)) => debug_assert(h == "", "P2-06 ASK empty host")
    _ => debug_assert(false, "P2-06 ASK :6380 must succeed")
  }

  // P2-07: CLUSTER SLOTS NULL preferred endpoint
  let null_ep = RespFrame::Array([
    RespFrame::Array([
      RespFrame::Integer(0L),
      RespFrame::Integer(16383L),
      RespFrame::Array([RespFrame::Null, RespFrame::Integer(6379L), bulk_string("n1")]),
    ]),
  ])
  match parse_cluster_slots(null_ep) {
    Ok(rs) => debug_assert(rs.length() == 1 && rs[0].primary.host == "", "P2-07 null endpoint -> empty host")
    Err(e) => debug_assert(false, "P2-07 failed: " + error_message(e))
  }

  // P2-08: CLUSTER SLOTS rejects overlapping/duplicate slot ranges
  let overlap_ranges : Array[SlotRange] = [
    SlotRange::{ start: 0, end: 10000, primary: ClusterNode::new("a", 1, ""), replicas: [] },
    SlotRange::{ start: 5000, end: 16383, primary: ClusterNode::new("b", 2, ""), replicas: [] },
  ]
  match ClusterRouter::from_slots(overlap_ranges) {
    Err(InvalidClusterReply(_)) => ()
    _ => debug_assert(false, "P2-08 overlapping slot ranges must be rejected")
  }

  // P2-09: RespLimits::default() consistency
  let dl = RespLimits::default()
  debug_assert(dl.max_buffer_bytes >= dl.max_bulk_len + 16, "P2-09 default max_buffer_bytes covers max_bulk_len + framing")
  debug_assert(dl.max_total_nodes > dl.max_collection_len, "P2-09 default max_total_nodes > max_collection_len")
}
