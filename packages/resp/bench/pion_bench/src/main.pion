///| Head-to-head benchmark binary for `packages/resp` (Pion Native):
///| - w1 <file> : 200,000 mixed RESP3 responses streamed in 137-byte chunks
///| - w2        : 500,000 pipelined commands (SET/GET/HSET/MGET) encode + decode roundtrip
///| - w3        : 2,000,000 Cluster key_slot ({hash_tag} edge cases) + 500,000 MOVED redirect parses

import "resp"

fn walk_frame(f : resp::RespFrame) -> (Int64, UInt64) {
  match f {
    SimpleString(s) => {
      let b = s.to_bytes()
      let n = b.length()
      let mut h : UInt64 = n.to_int64().to_uint64() * 11UL + 1UL
      if n > 0 {
        h = h + b[0].to_int().to_int64().to_uint64() + b[n - 1].to_int().to_int64().to_uint64()
      }
      (1L, h)
    }
    SimpleError(s) => {
      let b = s.to_bytes()
      let n = b.length()
      let mut h : UInt64 = n.to_int64().to_uint64() * 13UL + 2UL
      if n > 0 {
        h = h + b[0].to_int().to_int64().to_uint64()
      }
      (1L, h)
    }
    Integer(v) => (1L, v.to_uint64() * 17UL + 3UL)
    BulkString(b) => {
      let n = b.length()
      let mut h : UInt64 = n.to_int64().to_uint64() * 19UL + 4UL
      if n > 0 {
        h = h + b[0].to_int().to_int64().to_uint64() + b[n - 1].to_int().to_int64().to_uint64()
      }
      (1L, h)
    }
    Double(d) => (1L, d.to_bits().to_uint64() + 5UL)
    Boolean(v) => (1L, if v { 61UL } else { 67UL })
    Null => (1L, 71UL)
    NullBulk => (1L, 73UL)
    NullArray => (1L, 79UL)
    BigNumber(s) => (1L, s.length().to_int64().to_uint64() * 23UL + 83UL)
    BulkError(b) => (1L, b.length().to_int64().to_uint64() * 29UL + 89UL)
    VerbatimString(_, b) => (1L, b.length().to_int64().to_uint64() * 31UL + 97UL)
    Array(items) => {
      let n = items.length()
      let mut nodes : Int64 = 1L
      let mut sum : UInt64 = n.to_int64().to_uint64() * 37UL
      let mut i = 0
      while i < n {
        let (cn, ch) = walk_frame(items[i])
        nodes = nodes + cn
        sum = sum + ch
        i = i + 1
      }
      (nodes, sum)
    }
    Set(items) => {
      let n = items.length()
      let mut nodes : Int64 = 1L
      let mut sum : UInt64 = n.to_int64().to_uint64() * 41UL
      let mut i = 0
      while i < n {
        let (cn, ch) = walk_frame(items[i])
        nodes = nodes + cn
        sum = sum + ch
        i = i + 1
      }
      (nodes, sum)
    }
    Push(items) => {
      let n = items.length()
      let mut nodes : Int64 = 1L
      let mut sum : UInt64 = n.to_int64().to_uint64() * 43UL
      let mut i = 0
      while i < n {
        let (cn, ch) = walk_frame(items[i])
        nodes = nodes + cn
        sum = sum + ch
        i = i + 1
      }
      (nodes, sum)
    }
    Map(pairs) => {
      let n = pairs.length()
      let mut nodes : Int64 = 1L
      let mut sum : UInt64 = n.to_int64().to_uint64() * 47UL
      let mut i = 0
      while i < n {
        let (k, v) = pairs[i]
        let (kn, kh) = walk_frame(k)
        let (vn, vh) = walk_frame(v)
        nodes = nodes + kn + vn
        // Commutative across map entries for HashMap/BTreeMap parity
        sum = sum + kh * 131UL + vh
        i = i + 1
      }
      (nodes, sum)
    }
    Attribute(attrs, target) => {
      let (tn, th) = walk_frame(target)
      let mut nodes : Int64 = tn + 1L
      let mut sum : UInt64 = th + attrs.length().to_int64().to_uint64() * 53UL
      let mut i = 0
      while i < attrs.length() {
        let (k, v) = attrs[i]
        let (kn, kh) = walk_frame(k)
        let (vn, vh) = walk_frame(v)
        nodes = nodes + kn + vn
        sum = sum + kh * 131UL + vh
        i = i + 1
      }
      (nodes, sum)
    }
  }
}

fn run_w1(world : World, path : String) -> Int {
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read w1 corpus")
      return 1
    }
  }
  let dec = resp::StreamDecoder::default()
  let total_len = data.length()
  let mut off = 0
  let mut frames : Int64 = 0L
  let mut nodes : Int64 = 0L
  let mut checksum : UInt64 = 0UL
  let chunk_buf = Bytes::new(137)

  while off < total_len {
    let rem = total_len - off
    let step = if rem < 137 { rem } else { 137 }
    let chunk = if step == 137 {
      let mut i = 0
      while i < 137 {
        chunk_buf[i] = data[off + i]
        i = i + 1
      }
      chunk_buf
    } else {
      let tail = Bytes::new(step)
      let mut i = 0
      while i < step {
        tail[i] = data[off + i]
        i = i + 1
      }
      tail
    }
    match dec.feed(chunk) {
      Ok(_) => ()
      Err(e) => {
        io_println(world, "feed error: " + resp::error_message(e))
        return 2
      }
    }
    match dec.drain_frames() {
      Ok(fs) => {
        let mut j = 0
        while j < fs.length() {
          let (n, h) = walk_frame(fs[j])
          frames = frames + 1L
          nodes = nodes + n
          checksum = checksum + h
          j = j + 1
        }
      }
      Err(e) => {
        io_println(world, "decode error: " + resp::error_message(e))
        return 3
      }
    }
    off = off + step
  }

  io_println(world, "frames=" + frames.to_string())
  io_println(world, "nodes=" + nodes.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

fn run_w2(world : World) -> Int {
  // 500 batches x 1,000 commands = 500,000 SET/GET/HSET/MGET pipeline encode + decode roundtrips
  let batches = 500
  let batch_size = 1000
  let pb = resp::PipelineBuilder::with_capacity(65536)
  let dec = resp::StreamDecoder::default()

  let cmd_set = "SET".to_bytes()
  let cmd_get = "GET".to_bytes()
  let cmd_hset = "HSET".to_bytes()
  let cmd_mget = "MGET".to_bytes()
  let f1 = "f1".to_bytes()
  let f2 = "f2".to_bytes()

  // Pre-build 64 key/value byte slices to avoid measuring string formatting overhead
  let keys : Array[Bytes] = []
  let vals : Array[Bytes] = []
  let mut p = 0
  while p < 64 {
    keys.push(("user:session:key:" + p.to_string()).to_bytes())
    vals.push(("payload-value-item-" + p.to_string()).to_bytes())
    p = p + 1
  }

  let mut total_cmds : Int64 = 0L
  let mut total_bytes : Int64 = 0L
  let mut checksum : UInt64 = 0UL

  let mut b = 0
  while b < batches {
    pb.clear()
    let mut i = 0
    while i < batch_size {
      let idx = (b * 13 + i) & 63
      let idx2 = (idx + 1) & 63
      let idx3 = (idx + 2) & 63
      let kind = i & 3
      if kind == 0 {
        pb.push_command([cmd_set, keys[idx], vals[idx]])
      } else if kind == 1 {
        pb.push_command([cmd_get, keys[idx]])
      } else if kind == 2 {
        pb.push_command([cmd_hset, keys[idx], f1, vals[idx], f2, vals[idx2]])
      } else {
        pb.push_command([cmd_mget, keys[idx], keys[idx2], keys[idx3]])
      }
      i = i + 1
    }
    let wire = pb.finish()
    total_bytes = total_bytes + wire.length().to_int64()
    match dec.feed(wire) {
      Ok(_) => ()
      Err(e) => {
        io_println(world, "w2 feed error: " + resp::error_message(e))
        return 2
      }
    }
    match dec.drain_frames() {
      Ok(fs) => {
        let mut j = 0
        while j < fs.length() {
          let (_, h) = walk_frame(fs[j])
          total_cmds = total_cmds + 1L
          checksum = checksum + h
          j = j + 1
        }
      }
      Err(e) => {
        io_println(world, "w2 decode error: " + resp::error_message(e))
        return 3
      }
    }
    b = b + 1
  }

  io_println(world, "cmds=" + total_cmds.to_string())
  io_println(world, "bytes=" + total_bytes.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

fn run_w3(world : World) -> Int {
  // 2,000,000 Cluster key_slot (with {hash_tag} edge cases) + 500,000 MOVED redirect parses
  let keys : Array[Bytes] = [
    "foo".to_bytes(),
    "bar".to_bytes(),
    "123456789".to_bytes(),
    "{user1000}.following".to_bytes(),
    "{user1000}.followers".to_bytes(),
    "foo{}{bar}".to_bytes(),
    "foo{{bar}}zap".to_bytes(),
    "foo{bar}{zap}".to_bytes(),
    "{}foo".to_bytes(),
    "session:{tenant-99}:tok".to_bytes(),
    "order:{acct-42}:items".to_bytes(),
    "a{b}c".to_bytes(),
    "a{b".to_bytes(),
    "a}b".to_bytes(),
    "cache:v2:homepage:en-US".to_bytes(),
    "rate:{ip-10.0.0.1}:minute".to_bytes(),
  ]
  let redirects : Array[String] = [
    "MOVED 3999 127.0.0.1:6381",
    "ASK 12182 10.0.0.3:6379",
    "MOVED 5061 [::1]:7002",
    "ASK 3443 redis-node-1:6379",
  ]
  let ops = 2000000
  let mut slot_sum : UInt64 = 0UL
  let mut moved_sum : UInt64 = 0UL
  let mut i = 0
  while i < ops {
    let s = resp::key_slot(keys[i & 15])
    slot_sum = slot_sum + s.to_int64().to_uint64()
    if (i & 3) == 0 {
      match resp::parse_cluster_redirect(redirects[(i >> 2) & 3]) {
        Some(resp::ClusterRedirect::Moved(ms, host, port)) => {
          moved_sum = moved_sum + 1UL + ms.to_int64().to_uint64() + host.length().to_int64().to_uint64() + port.to_int64().to_uint64()
        }
        Some(resp::ClusterRedirect::Ask(ms, host, port)) => {
          moved_sum = moved_sum + 2UL + ms.to_int64().to_uint64() + host.length().to_int64().to_uint64() + port.to_int64().to_uint64()
        }
        None => return 4
      }
    }
    i = i + 1
  }
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "slot_sum=" + slot_sum.to_string())
  io_println(world, "moved_sum=" + moved_sum.to_string())
  0
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: resp_bench_pion <w1 <path>|w2|w3>")
    return 1
  }
  let mode = args[1]
  if mode == "w1" {
    if args.length() < 3 {
      return 1
    }
    run_w1(world, args[2])
  } else if mode == "w2" {
    run_w2(world)
  } else if mode == "w3" {
    run_w3(world)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
