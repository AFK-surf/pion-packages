///| Command builder, PipelineBuilder, CRC16-XMODEM official vectors, Redis `{hash_tag}`
///| slot computation, and MOVED / ASK / CLUSTER SLOTS routing table tests.

///|
test "command_encoder_and_pipeline_builder" {
  let cmd = encode_command_strings(["SET", "mykey", "hello world"])
  let expected = "*3\r\n$3\r\nSET\r\n$5\r\nmykey\r\n$11\r\nhello world\r\n".to_bytes()
  debug_assert(bytes_equal(cmd, expected), "encode_command_strings SET")

  let bin_val = Bytes::new(3)
  bin_val[0] = (0x00).to_byte()
  bin_val[1] = (0xFF).to_byte()
  bin_val[2] = (0x0A).to_byte()
  let bin_cmd = encode_command(["SET".to_bytes(), "k".to_bytes(), bin_val])
  match decode_default(bin_cmd) {
    Ok(RespFrame::Array(items)) => {
      debug_assert(items.length() == 3, "binary cmd len 3")
      debug_assert(resp_equals(items[2], RespFrame::BulkString(bin_val)), "binary value preserved")
    }
    _ => debug_assert(false, "decode binary command failed")
  }

  // PipelineBuilder roundtrip through StreamDecoder
  let pb = PipelineBuilder::with_capacity(256)
  pb.push_command_strings(["SET", "k1", "v1"])
  pb.push_command_strings(["GET", "k1"])
  pb.push_command_strings(["HSET", "h1", "f1", "val1", "f2", "val2"])
  pb.push_command_strings(["MGET", "k1", "k2", "k3"])
  debug_assert(pb.command_count() == 4, "pipeline count == 4")
  let wire = pb.finish()
  debug_assert(wire.length() == pb.byte_len(), "byte_len matches finish length")

  let dec = StreamDecoder::default()
  match dec.feed(wire) {
    Ok(_) => ()
    Err(e) => debug_assert(false, error_message(e))
  }
  match dec.drain_frames() {
    Ok(frames) => {
      debug_assert(frames.length() == 4, "decoded 4 pipelined commands")
      debug_assert(
        resp_equals(frames[1], RespFrame::Array([bulk_string("GET"), bulk_string("k1")])),
        "cmd 1 GET k1",
      )
      debug_assert(
        resp_equals(
          frames[3],
          RespFrame::Array([
            bulk_string("MGET"),
            bulk_string("k1"),
            bulk_string("k2"),
            bulk_string("k3"),
          ]),
        ),
        "cmd 3 MGET",
      )
    }
    Err(e) => debug_assert(false, error_message(e))
  }

  pb.clear()
  debug_assert(pb.command_count() == 0, "cleared pipeline count == 0")
  debug_assert(pb.byte_len() == 0, "cleared pipeline byte_len == 0")
}

///|
test "crc16_xmodem_and_redis_hash_tag_slots" {
  // Official CRC16-XMODEM check value: "123456789" -> 0x31C3 (12739)
  debug_assert(crc16_xmodem_string("") == 0x0000, "crc16 empty")
  debug_assert(crc16_xmodem_string("123456789") == 0x31C3, "crc16 123456789 == 0x31C3")
  debug_assert(crc16_xmodem_string("foo") == 0xAF96, "crc16 foo")
  debug_assert(crc16_xmodem_string("bar") == 0x93C5, "crc16 bar")

  // Official Redis Cluster slot vectors
  debug_assert(key_slot_string("") == 0, "slot empty")
  debug_assert(key_slot_string("123456789") == 12739, "slot 123456789")
  debug_assert(key_slot_string("foo") == 12182, "slot foo")
  debug_assert(key_slot_string("bar") == 5061, "slot bar")
  debug_assert(key_slot_string("hello") == 866, "slot hello")

  // Official Redis {hash_tag} specification edge cases
  let u_slot = key_slot_string("user1000")
  debug_assert(u_slot == 3443, "slot user1000 == 3443")
  debug_assert(key_slot_string("{user1000}.following") == u_slot, "{user1000}.following")
  debug_assert(key_slot_string("{user1000}.followers") == u_slot, "{user1000}.followers")

  // Empty {} means hash the WHOLE key (do NOT look for later {bar})
  debug_assert(key_slot_string("foo{}{bar}") == 8363, "foo{}{bar} hashes whole key")
  debug_assert(key_slot_string("{}foo") == 9500, "{}foo hashes whole key")

  // Nested {{bar}} -> first '{' to first '}' hashes "{bar"
  debug_assert(key_slot_string("foo{{bar}}zap") == 4015, "foo{{bar}}zap hashes {bar")
  debug_assert(key_slot_string("foo{{bar}}zap") == key_slot_string("{bar"), "matches {bar")

  // Multiple tags -> first non-empty tag "bar" wins
  debug_assert(key_slot_string("foo{bar}{zap}") == 5061, "foo{bar}{zap} hashes bar")
  debug_assert(key_slot_string("foo{bar}{zap}") == key_slot_string("bar"), "matches bar")

  // Unmatched braces -> hash whole key
  debug_assert(key_slot_string("a{b") == 13340, "a{b hashes whole key")
  debug_assert(key_slot_string("a}b") == 7866, "a}b hashes whole key")
}

///|
test "cluster_moved_ask_and_slots_router" {
  // MOVED & ASK parsing (IPv4, hostname, IPv6)
  match parse_cluster_redirect("MOVED 3999 127.0.0.1:6381") {
    Some(ClusterRedirect::Moved(slot, host, port)) => {
      debug_assert(slot == 3999, "moved slot")
      debug_assert(host == "127.0.0.1", "moved host")
      debug_assert(port == 6381, "moved port")
    }
    _ => debug_assert(false, "failed to parse MOVED")
  }

  match parse_cluster_redirect("ASK 12182 [::1]:7002") {
    Some(ClusterRedirect::Ask(slot, host, port)) => {
      debug_assert(slot == 12182, "ask slot")
      debug_assert(host == "::1", "ask ipv6 host")
      debug_assert(port == 7002, "ask port")
    }
    _ => debug_assert(false, "failed to parse ASK IPv6")
  }

  match parse_cluster_redirect_frame(RespFrame::SimpleError("MOVED 5061 redis-node-2.internal:6379")) {
    Some(ClusterRedirect::Moved(slot, host, port)) => {
      debug_assert(slot == 5061, "frame moved slot")
      debug_assert(host == "redis-node-2.internal", "frame moved host")
      debug_assert(port == 6379, "frame moved port")
    }
    _ => debug_assert(false, "failed to parse MOVED from frame")
  }

  // Invalid slot (>= 16384) or non-redirect error must return None
  match parse_cluster_redirect("MOVED 16384 127.0.0.1:6379") {
    None => ()
    Some(_) => debug_assert(false, "slot 16384 must be rejected")
  }
  match parse_cluster_redirect("ERR wrong number of arguments") {
    None => ()
    Some(_) => debug_assert(false, "ERR is not a cluster redirect")
  }

  // CLUSTER SLOTS response parsing & O(1) routing table
  let slots_frame = RespFrame::Array([
    RespFrame::Array([
      RespFrame::Integer(0L),
      RespFrame::Integer(5460L),
      RespFrame::Array([bulk_string("10.0.0.1"), RespFrame::Integer(6379L), bulk_string("node-a")]),
      RespFrame::Array([bulk_string("10.0.0.11"), RespFrame::Integer(6379L), bulk_string("node-a-rep")]),
    ]),
    RespFrame::Array([
      RespFrame::Integer(5461L),
      RespFrame::Integer(10922L),
      RespFrame::Array([bulk_string("10.0.0.2"), RespFrame::Integer(6379L), bulk_string("node-b")]),
    ]),
    RespFrame::Array([
      RespFrame::Integer(10923L),
      RespFrame::Integer(16383L),
      RespFrame::Array([bulk_string("10.0.0.3"), RespFrame::Integer(6379L), bulk_string("node-c")]),
    ]),
  ])

  let ranges = match parse_cluster_slots(slots_frame) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "parse_cluster_slots failed: " + error_message(e))
      []
    }
  }
  debug_assert(ranges.length() == 3, "3 slot ranges")
  debug_assert(ranges[0].replicas.length() == 1, "range 0 has 1 replica")
  debug_assert(ranges[0].replicas[0].host == "10.0.0.11", "replica host")

  let router = match ClusterRouter::from_slots(ranges) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "ClusterRouter::from_slots failed: " + error_message(e))
      ClusterRouter::new()
    }
  }
  debug_assert(router.covered_slots() == 16384, "all 16384 slots covered")

  // "bar" -> slot 5061 -> 10.0.0.1:6379
  match router.route_key_string("bar") {
    Some(n) => debug_assert(n.host == "10.0.0.1" && n.port == 6379, "route bar -> node-a")
    None => debug_assert(false, "bar must route")
  }
  // "foo" -> slot 12182 -> 10.0.0.3:6379
  match router.route_key_string("foo") {
    Some(n) => debug_assert(n.host == "10.0.0.3" && n.port == 6379, "route foo -> node-c")
    None => debug_assert(false, "foo must route")
  }

  // Apply MOVED on slot 12182 -> 10.0.0.9:6380
  match router.apply_moved(12182, "10.0.0.9", 6380) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "apply_moved failed: " + error_message(e))
  }
  match router.route_key_string("foo") {
    Some(n) => debug_assert(n.host == "10.0.0.9" && n.port == 6380, "foo rerouted after MOVED")
    None => debug_assert(false, "foo must route after MOVED")
  }
}

test "c1_migrated_resp_constants" {
  debug_assert(crc16_bit_step(0) == 0 && crc16_bit_step(32768) == 4129, "crc16_bit_step constants")
  debug_assert(is_valid_cluster_slot(0) && is_valid_cluster_slot(16383) && !is_valid_cluster_slot(-1) && !is_valid_cluster_slot(16384), "cluster slot boundaries")
  let lim = RespLimits::default()
  debug_assert(lim.max_depth == 128 && lim.max_bulk_len == 67108864 && lim.max_inline_len == 65536, "RespLimits::default")
}
