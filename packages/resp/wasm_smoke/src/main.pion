///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/resp`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "resp"

fn fnv1a_64_bytes(b : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = b.length()
  let mut i = 0
  while i < n {
    h = (h ^ b[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

pub fn main(world : World) -> Int {
  // 1. RESP3 rich frame encode + decode roundtrip (Map, Set, Double inf, BigNumber, Attribute, Push)
  let sample = resp::RespFrame::Attribute(
    [(resp::RespFrame::SimpleString("ttl"), resp::RespFrame::Integer(120L))],
    resp::RespFrame::Map([
      (resp::bulk_string("ok"), resp::RespFrame::Boolean(true)),
      (resp::bulk_string("score"), resp::RespFrame::Double(3.14159)),
      (resp::bulk_string("inf"), resp::RespFrame::Double(Double::from_bits(0x7FF0000000000000L))),
      (resp::bulk_string("big"), resp::RespFrame::BigNumber("349289032840923850932485094385")),
      (resp::bulk_string("verb"), resp::RespFrame::VerbatimString("txt", "hello".to_bytes())),
      (
        resp::bulk_string("tags"),
        resp::RespFrame::Set([resp::RespFrame::SimpleString("a"), resp::RespFrame::SimpleString("b")]),
      ),
    ]),
  )
  let encoded = match resp::encode(sample) {
    Ok(b) => b
    Err(_) => return 1
  }
  let decoded = match resp::decode_default(encoded) {
    Ok(f) => f
    Err(_) => return 2
  }
  if !resp::resp_equals(decoded, sample) {
    return 3
  }

  // 2. Streamed chunked BulkString + PipelineBuilder + StreamDecoder
  let pb = resp::PipelineBuilder::with_capacity(256)
  pb.push_command_strings(["SET", "{user:42}:name", "alice"])
  pb.push_command_strings(["GET", "{user:42}:name"])
  pb.push_command_strings(["HSET", "{user:42}:meta", "role", "admin"])
  let pipe = pb.finish()

  let dec = resp::StreamDecoder::default()
  // Feed in 7-byte chunks to exercise fragmentation
  let mut off = 0
  let mut total_frames = 0
  while off < pipe.length() {
    let rem = pipe.length() - off
    let step = if rem < 7 { rem } else { 7 }
    let chunk = Bytes::new(step)
    let mut k = 0
    while k < step {
      chunk[k] = pipe[off + k]
      k = k + 1
    }
    match dec.feed(chunk) {
      Ok(_) => ()
      Err(_) => return 4
    }
    match dec.drain_frames() {
      Ok(fs) => total_frames = total_frames + fs.length()
      Err(_) => return 5
    }
    off = off + step
  }
  if total_frames != 3 || dec.buffered_len() != 0 {
    return 6
  }

  // 3. Streamed BulkString + Inline command
  match resp::decode_default("$?\r\n;3\r\nfoo\r\n;3\r\nbar\r\n;0\r\n".to_bytes()) {
    Ok(f) => if !resp::resp_equals(f, resp::bulk_string("foobar")) { return 7 }
    Err(_) => return 8
  }
  match resp::decode_inline("SET \"a b\" 'c\\'d'\r\n".to_bytes(), resp::RespLimits::default()) {
    Ok(args) => if args.length() != 3 { return 9 }
    Err(_) => return 10
  }

  // 4. CRC16-XMODEM + {hash_tag} + ClusterRouter + MOVED
  let s1 = resp::key_slot_string("{user1000}.following")
  let s2 = resp::key_slot_string("foo{}{bar}")
  let s3 = resp::key_slot_string("foo{{bar}}zap")
  if s1 != 3443 || s2 != 8363 || s3 != 4015 {
    return 11
  }
  let router = resp::ClusterRouter::new()
  match resp::parse_cluster_redirect("MOVED 3443 10.0.0.7:6379") {
    Some(resp::ClusterRedirect::Moved(slot, host, port)) => {
      match router.apply_moved(slot, host, port) {
        Ok(_) => ()
        Err(_) => return 12
      }
    }
    _ => return 13
  }
  let routed_host = match router.route_key_string("{user1000}.followers") {
    Some(n) => n.host + ":" + n.port.to_string()
    None => return 14
  }

  let digest = hex_u64(fnv1a_64_bytes(encoded))
  io_println(world, "resp_wasm_smoke:ok")
  io_println(
    world,
    "encoded_len=" +
    encoded.length().to_string() +
    " frames=" +
    total_frames.to_string() +
    " slots=" +
    s1.to_string() +
    "," +
    s2.to_string() +
    "," +
    s3.to_string() +
    " routed=" +
    routed_host +
    " fnv64=" +
    digest,
  )
  0
}
