///| Core Redis RESP2 & RESP3 frame types, limits, errors, internal byte buffer, and structural equality.

///| Complete Redis RESP2 & RESP3 frame model (all 15 protocol frame types
///| plus explicit RESP2 NullBulk `$-1` and NullArray `*-1` for lossless roundtrips).
pub enum RespFrame {
  SimpleString(String)
  SimpleError(String)
  Integer(Int64)
  BulkString(Bytes)
  Array(Array[RespFrame])
  Null
  NullBulk
  NullArray
  Boolean(Bool)
  Double(Double)
  BigNumber(String)
  BulkError(Bytes)
  VerbatimString(String, Bytes)
  Map(Array[(RespFrame, RespFrame)])
  Set(Array[RespFrame])
  Attribute(Array[(RespFrame, RespFrame)], RespFrame)
  Push(Array[RespFrame])
}

///| Security and resource limits enforced during RESP decoding and streaming.
#verify
pub val struct RespLimits {
  pub max_depth : Int
  pub max_bulk_len : Int
  pub max_collection_len : Int
  pub max_buffer_bytes : Int
  pub max_total_nodes : Int
  pub max_inline_len : Int
}

///| Default conservative limits safe for both Native and Wasm32 targets.
///| Ensures `max_buffer_bytes` accommodates a full `max_bulk_len` frame (including header/CRLF)
///| and `max_total_nodes` accommodates a full `max_collection_len` collection (including map pairs).
#verify
pub fn RespLimits::default() -> RespLimits {
  RespLimits::{
    max_depth: 128,
    max_bulk_len: 67108864,
    max_collection_len: 1048576,
    max_buffer_bytes: 67108928,
    max_total_nodes: 2097153,
    max_inline_len: 65536,
  }
}

///| Construct custom `RespLimits` (uses default 64 KiB `max_inline_len`).
#verify
pub fn RespLimits::new(
  max_depth : Int,
  max_bulk_len : Int,
  max_collection_len : Int,
  max_buffer_bytes : Int,
  max_total_nodes : Int,
) -> RespLimits {
  RespLimits::{
    max_depth: max_depth,
    max_bulk_len: max_bulk_len,
    max_collection_len: max_collection_len,
    max_buffer_bytes: max_buffer_bytes,
    max_total_nodes: max_total_nodes,
    max_inline_len: 65536,
  }
}

///| Return a copy of `RespLimits` with a custom `max_inline_len` (default 65536 = 64 KiB).
#verify
pub fn RespLimits::with_max_inline_len(self : RespLimits, max_inline_len : Int) -> RespLimits {
  RespLimits::{
    max_depth: self.max_depth,
    max_bulk_len: self.max_bulk_len,
    max_collection_len: self.max_collection_len,
    max_buffer_bytes: self.max_buffer_bytes,
    max_total_nodes: self.max_total_nodes,
    max_inline_len: max_inline_len,
  }
}

///| Explicit protocol, limit, cluster, and encoding error variants.
pub enum RespError {
  Incomplete
  InvalidPrefix(Int, Int)
  InvalidCrlf(Int)
  InvalidInteger(Int)
  InvalidDouble(Int)
  InvalidBoolean(Int)
  InvalidBigNumber(Int)
  InvalidBulkLength(Int64, Int)
  InvalidCollectionLength(Int64, Int)
  InvalidVerbatimFormat(Int)
  InvalidChunkLength(Int)
  InvalidInlineQuote(Int)
  UnexpectedEndMarker(Int)
  DanglingAttribute(Int)
  MaxDepthExceeded(Int)
  MaxBulkLenExceeded(Int)
  MaxCollectionLenExceeded(Int)
  MaxBufferBytesExceeded(Int)
  MaxTotalNodesExceeded(Int)
  TrailingBytes(Int)
  InvalidClusterReply(String)
  EncodeError(String)
}

///| Human-readable description of a `RespError`.
pub fn error_message(err : RespError) -> String {
  match err {
    Incomplete => "resp: incomplete frame"
    InvalidPrefix(b, pos) =>
    "resp: invalid prefix byte " + b.to_string() + " at offset " + pos.to_string()
    InvalidCrlf(pos) => "resp: invalid CRLF terminator at offset " + pos.to_string()
    InvalidInteger(pos) => "resp: invalid integer at offset " + pos.to_string()
    InvalidDouble(pos) => "resp: invalid double at offset " + pos.to_string()
    InvalidBoolean(pos) => "resp: invalid boolean at offset " + pos.to_string()
    InvalidBigNumber(pos) => "resp: invalid big number at offset " + pos.to_string()
    InvalidBulkLength(n, pos) =>
    "resp: invalid bulk length " + n.to_string() + " at offset " + pos.to_string()
    InvalidCollectionLength(n, pos) =>
    "resp: invalid collection length " + n.to_string() + " at offset " + pos.to_string()
    InvalidVerbatimFormat(pos) =>
    "resp: invalid verbatim string format at offset " + pos.to_string()
    InvalidChunkLength(pos) =>
    "resp: invalid streamed chunk length at offset " + pos.to_string()
    InvalidInlineQuote(pos) =>
    "resp: invalid inline command quote at offset " + pos.to_string()
    UnexpectedEndMarker(pos) =>
    "resp: unexpected streamed end marker '.' at offset " + pos.to_string()
    DanglingAttribute(pos) =>
    "resp: dangling attribute without target frame at offset " + pos.to_string()
    MaxDepthExceeded(limit) =>
    "resp: max nesting depth exceeded (" + limit.to_string() + ")"
    MaxBulkLenExceeded(limit) =>
    "resp: max bulk length exceeded (" + limit.to_string() + ")"
    MaxCollectionLenExceeded(limit) =>
    "resp: max collection length exceeded (" + limit.to_string() + ")"
    MaxBufferBytesExceeded(limit) =>
    "resp: max stream buffer bytes exceeded (" + limit.to_string() + ")"
    MaxTotalNodesExceeded(limit) =>
    "resp: max total nodes exceeded (" + limit.to_string() + ")"
    TrailingBytes(pos) => "resp: trailing bytes at offset " + pos.to_string()
    InvalidClusterReply(msg) => "resp: invalid cluster reply: " + msg
    EncodeError(msg) => "resp: encode error: " + msg
  }
}

///| Convenience helper: construct a `BulkString` from a `String`.
pub fn bulk_string(s : String) -> RespFrame {
  RespFrame::BulkString(s.to_bytes())
}

///| Return true if `frame` is any null representation (`Null`, `NullBulk`, or `NullArray`).
pub fn is_null(frame : RespFrame) -> Bool {
  match frame {
    Null => true
    NullBulk => true
    NullArray => true
    _ => false
  }
}

///| Byte-for-byte equality for `Bytes`.
pub fn bytes_equal(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Unrolled byte slice copy helper.
fn copy_bytes(dst : Bytes, dst_off : Int, src : Bytes, src_off : Int, len : Int) -> Unit {
  let mut di = dst_off
  let mut si = src_off
  let end = src_off + len
  while si + 8 <= end {
    dst[di] = src[si]
    dst[di + 1] = src[si + 1]
    dst[di + 2] = src[si + 2]
    dst[di + 3] = src[si + 3]
    dst[di + 4] = src[si + 4]
    dst[di + 5] = src[si + 5]
    dst[di + 6] = src[si + 6]
    dst[di + 7] = src[si + 7]
    di = di + 8
    si = si + 8
  }
  while si < end {
    dst[di] = src[si]
    di = di + 1
    si = si + 1
  }
}

///| Slice a `Bytes` range `[start .. start + len]` into a fresh `Bytes`.
fn slice_bytes(src : Bytes, start : Int, len : Int) -> Bytes {
  let out = Bytes::new(len)
  if len > 0 {
    copy_bytes(out, 0, src, start, len)
  }
  out
}

///| Internal growable byte buffer with zero-allocation ASCII integer formatting.
struct ByteBuf {
  mut data : Bytes
  mut len : Int
}

///|
fn ByteBuf::with_capacity(cap : Int) -> ByteBuf {
  let c = if cap < 16 { 16 } else { cap }
  ByteBuf::{ data: Bytes::new(c), len: 0 }
}

///|
fn ByteBuf::reserve(self : ByteBuf, extra : Int) -> Unit {
  let need = self.len + extra
  let cur_cap = self.data.length()
  if need <= cur_cap {
    return ()
  }
  let mut next_cap = if cur_cap < 32 { 32 } else { cur_cap }
  while next_cap < need {
    if next_cap > 1073741823 {
      next_cap = need
      break
    }
    next_cap = next_cap * 2
  }
  let next = Bytes::new(next_cap)
  if self.len > 0 {
    copy_bytes(next, 0, self.data, 0, self.len)
  }
  self.data = next
}

///|
fn ByteBuf::push_byte(self : ByteBuf, b : Int) -> Unit {
  self.reserve(1)
  self.data[self.len] = b.to_byte()
  self.len = self.len + 1
}

///|
fn ByteBuf::push_crlf(self : ByteBuf) -> Unit {
  self.reserve(2)
  let p = self.len
  self.data[p] = (13).to_byte()
  self.data[p + 1] = (10).to_byte()
  self.len = p + 2
}

///|
fn ByteBuf::push_bytes(self : ByteBuf, src : Bytes) -> Unit {
  let n = src.length()
  if n == 0 {
    return ()
  }
  self.reserve(n)
  copy_bytes(self.data, self.len, src, 0, n)
  self.len = self.len + n
}

///|
fn ByteBuf::push_bytes_slice(self : ByteBuf, src : Bytes, start : Int, n : Int) -> Unit {
  if n <= 0 {
    return ()
  }
  self.reserve(n)
  copy_bytes(self.data, self.len, src, start, n)
  self.len = self.len + n
}

///|
fn ByteBuf::push_str(self : ByteBuf, s : String) -> Unit {
  let b = s.to_bytes()
  self.push_bytes(b)
}

///| Write a non-negative `Int` directly as ASCII decimal digits (no String allocation).
fn ByteBuf::push_uint_ascii(self : ByteBuf, n : Int) -> Unit {
  if n < 10 {
    self.push_byte(48 + n)
    return ()
  }
  if n < 100 {
    self.reserve(2)
    let p = self.len
    self.data[p] = (48 + n / 10).to_byte()
    self.data[p + 1] = (48 + n % 10).to_byte()
    self.len = p + 2
    return ()
  }
  self.reserve(12)
  let tmp = Bytes::new(12)
  let mut v = n
  let mut k = 0
  while v > 0 {
    tmp[k] = (48 + v % 10).to_byte()
    v = v / 10
    k = k + 1
  }
  let mut p = self.len
  let mut i = k - 1
  while i >= 0 {
    self.data[p] = tmp[i]
    p = p + 1
    i = i - 1
  }
  self.len = p
}

///| Write a signed `Int64` directly as ASCII decimal digits (handles Int64::MIN safely).
fn ByteBuf::push_int64_ascii(self : ByteBuf, v : Int64) -> Unit {
  if v == 0L {
    self.push_byte(48)
    return ()
  }
  if v == -9223372036854775807L - 1L {
    self.push_str("-9223372036854775808")
    return ()
  }
  self.reserve(21)
  let mut x = v
  if x < 0L {
    self.data[self.len] = (45).to_byte()
    self.len = self.len + 1
    x = 0L - x
  }
  let tmp = Bytes::new(20)
  let mut k = 0
  while x > 0L {
    let d = (x % 10L).to_int()
    tmp[k] = (48 + d).to_byte()
    x = x / 10L
    k = k + 1
  }
  let mut p = self.len
  let mut i = k - 1
  while i >= 0 {
    self.data[p] = tmp[i]
    p = p + 1
    i = i - 1
  }
  self.len = p
}

///|
fn ByteBuf::to_bytes(self : ByteBuf) -> Bytes {
  if self.len == self.data.length() {
    let out = Bytes::new(self.len)
    if self.len > 0 {
      copy_bytes(out, 0, self.data, 0, self.len)
    }
    return out
  }
  slice_bytes(self.data, 0, self.len)
}

///|
fn ByteBuf::clear(self : ByteBuf) -> Unit {
  self.len = 0
}

///| Check whether a Double is NaN.
fn is_double_nan(d : Double) -> Bool {
  d != d
}

///| Structural equality for `RespFrame` (iterative, stack-safe; treats NaN == NaN).
pub fn resp_equals(a : RespFrame, b : RespFrame) -> Bool {
  let stack_a : Array[RespFrame] = [a]
  let stack_b : Array[RespFrame] = [b]
  while stack_a.length() > 0 {
    let fa = match stack_a.pop() {
      Some(v) => v
      None => break
    }
    let fb = match stack_b.pop() {
      Some(v) => v
      None => return false
    }
    match (fa, fb) {
      (SimpleString(x), SimpleString(y)) => if x != y { return false }
      (SimpleError(x), SimpleError(y)) => if x != y { return false }
      (Integer(x), Integer(y)) => if x != y { return false }
      (BulkString(x), BulkString(y)) => if !bytes_equal(x, y) { return false }
      (Null, Null) => ()
      (NullBulk, NullBulk) => ()
      (NullArray, NullArray) => ()
      (Boolean(x), Boolean(y)) => if x != y { return false }
      (Double(x), Double(y)) => {
        if is_double_nan(x) && is_double_nan(y) {
          ()
        } else if x.to_bits() != y.to_bits() {
          if !(x == 0.0 && y == 0.0) {
            return false
          }
        }
      }
      (BigNumber(x), BigNumber(y)) => if x != y { return false }
      (BulkError(x), BulkError(y)) => if !bytes_equal(x, y) { return false }
      (VerbatimString(ex, px), VerbatimString(ey, py)) => {
        if ex != ey || !bytes_equal(px, py) {
          return false
        }
      }
      (Array(xs), Array(ys)) => {
        if xs.length() != ys.length() {
          return false
        }
        let mut i = xs.length() - 1
        while i >= 0 {
          stack_a.push(xs[i])
          stack_b.push(ys[i])
          i = i - 1
        }
      }
      (Set(xs), Set(ys)) => {
        if xs.length() != ys.length() {
          return false
        }
        let mut i = xs.length() - 1
        while i >= 0 {
          stack_a.push(xs[i])
          stack_b.push(ys[i])
          i = i - 1
        }
      }
      (Push(xs), Push(ys)) => {
        if xs.length() != ys.length() {
          return false
        }
        let mut i = xs.length() - 1
        while i >= 0 {
          stack_a.push(xs[i])
          stack_b.push(ys[i])
          i = i - 1
        }
      }
      (Map(xs), Map(ys)) => {
        if xs.length() != ys.length() {
          return false
        }
        let mut i = xs.length() - 1
        while i >= 0 {
          let (kx, vx) = xs[i]
          let (ky, vy) = ys[i]
          stack_a.push(vx)
          stack_b.push(vy)
          stack_a.push(kx)
          stack_b.push(ky)
          i = i - 1
        }
      }
      (Attribute(ax, tx), Attribute(ay, ty)) => {
        if ax.length() != ay.length() {
          return false
        }
        stack_a.push(tx)
        stack_b.push(ty)
        let mut i = ax.length() - 1
        while i >= 0 {
          let (kx, vx) = ax[i]
          let (ky, vy) = ay[i]
          stack_a.push(vx)
          stack_b.push(vy)
          stack_a.push(kx)
          stack_b.push(ky)
          i = i - 1
        }
      }
      _ => return false
    }
  }
  true
}
