///| Redis Cluster CRC16-XMODEM (poly 0x1021) hash-slot calculator,
///| MOVED / ASK / CLUSTER SLOTS response parser, and O(1) 16384-slot router.

///| Redis Cluster node endpoint.
pub val struct ClusterNode {
  pub host : String
  pub port : Int
  pub node_id : String
}

///| Construct a `ClusterNode`.
pub fn ClusterNode::new(host : String, port : Int, node_id : String) -> ClusterNode {
  ClusterNode::{ host: host, port: port, node_id: node_id }
}

///| Redis Cluster slot range `[start, end]` (inclusive) owned by `primary` with optional `replicas`.
pub struct SlotRange {
  pub start : Int
  pub end : Int
  pub primary : ClusterNode
  pub replicas : Array[ClusterNode]
}

///| Parsed Redis Cluster redirection (`MOVED` or `ASK`).
pub enum ClusterRedirect {
  Moved(Int, String, Int)
  Ask(Int, String, Int)
}

///| Single MSB-first bit step of CRC16-XMODEM (polynomial 0x1021, 16-bit masked).
#verify
pub fn crc16_bit_step(crc : Int) -> Int {
  if (crc & 0x8000) != 0 {
    ((crc << 1) ^ 0x1021) & 0xFFFF
  } else {
    (crc << 1) & 0xFFFF
  }
}

///| Map a 16-bit CRC16-XMODEM value into a Redis Cluster hash slot (`0..16383`).
#verify
pub fn crc16_to_slot(crc : Int) -> Int {
  crc & 16383
}

///| True iff `slot` is a valid Redis Cluster hash slot (`0..16383`).
#verify
pub fn is_valid_cluster_slot(slot : Int) -> Bool {
  slot >= 0 && slot <= 16383
}

///| True iff `[start, end]` is a valid inclusive Redis Cluster slot range (`0 <= start <= end <= 16383`).
pub fn is_valid_slot_range(start : Int, end : Int) -> Bool {
  start >= 0 && end <= 16383 && start <= end
}

///| Generate the 256-entry CRC16-XMODEM lookup table (polynomial 0x1021, MSB-first).
fn make_crc16_table() -> FixedArray[Int] {
  let tbl = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    let mut crc = i << 8
    let mut bit = 0
    while bit < 8 {
      crc = crc16_bit_step(crc)
      bit = bit + 1
    }
    tbl[i] = crc
    i = i + 1
  }
  tbl
}

///| Module-level precomputed CRC16-XMODEM lookup table.
let crc16_lut : FixedArray[Int] = make_crc16_table()

///| Compute standard CRC16-XMODEM (poly 0x1021, init 0x0000) over `data[start .. start + len]`.
pub fn crc16_xmodem_slice(data : Bytes, start : Int, len : Int) -> Int {
  let end = start + len
  let mut crc = 0
  let mut i = start
  while i < end {
    let idx = ((crc >> 8) ^ data[i].to_int()) & 0xFF
    crc = ((crc << 8) ^ crc16_lut[idx]) & 0xFFFF
    i = i + 1
  }
  crc
}

///| Compute standard CRC16-XMODEM over all bytes of `data`.
pub fn crc16_xmodem(data : Bytes) -> Int {
  crc16_xmodem_slice(data, 0, data.length())
}

///| Compute standard CRC16-XMODEM over UTF-8 bytes of `s` without allocating.
pub fn crc16_xmodem_string(s : String) -> Int {
  let n = s.length()
  let mut crc = 0
  let mut i = 0
  while i < n {
    let idx = ((crc >> 8) ^ s.code_unit_at(i)) & 0xFF
    crc = ((crc << 8) ^ crc16_lut[idx]) & 0xFFFF
    i = i + 1
  }
  crc
}

///| Compute Redis Cluster hash slot (`0..16383`) for `key`, strictly following Redis `{hash_tag}` rules:
///| only the substring between the first `{` and the first `}` after it is hashed, and only if non-empty.
///| Single-pass scan: computes full-key CRC16 on the fly and switches to tag CRC16 upon first `{`.
pub fn key_slot(key : Bytes) -> Int {
  let n = key.length()
  let mut crc = 0
  let mut i = 0
  while i < n {
    let b = key[i].to_int()
    if b == 123 { // '{'
      let mut tag_crc = 0
      let mut e = i + 1
      while e < n {
        let eb = key[e].to_int()
        if eb == 125 { // '}'
          if e > i + 1 {
            return crc16_to_slot(tag_crc)
          }
          break
        }
        let tidx = ((tag_crc >> 8) ^ eb) & 0xFF
        tag_crc = ((tag_crc << 8) ^ crc16_lut[tidx]) & 0xFFFF
        e = e + 1
      }
      // Empty `{}` or unclosed `{`: finish full-key CRC from `i` onward
      while i < n {
        let idx = ((crc >> 8) ^ key[i].to_int()) & 0xFF
        crc = ((crc << 8) ^ crc16_lut[idx]) & 0xFFFF
        i = i + 1
      }
      return crc16_to_slot(crc)
    }
    let idx = ((crc >> 8) ^ b) & 0xFF
    crc = ((crc << 8) ^ crc16_lut[idx]) & 0xFFFF
    i = i + 1
  }
  crc16_to_slot(crc)
}

///| Compute Redis Cluster hash slot (`0..16383`) for string `key` without `String -> Bytes` allocation.
pub fn key_slot_string(key : String) -> Int {
  let n = key.length()
  let mut crc = 0
  let mut i = 0
  while i < n {
    let b = key.code_unit_at(i)
    if b == 123 { // '{'
      let mut tag_crc = 0
      let mut e = i + 1
      while e < n {
        let eb = key.code_unit_at(e)
        if eb == 125 { // '}'
          if e > i + 1 {
            return crc16_to_slot(tag_crc)
          }
          break
        }
        let tidx = ((tag_crc >> 8) ^ eb) & 0xFF
        tag_crc = ((tag_crc << 8) ^ crc16_lut[tidx]) & 0xFFFF
        e = e + 1
      }
      while i < n {
        let idx = ((crc >> 8) ^ key.code_unit_at(i)) & 0xFF
        crc = ((crc << 8) ^ crc16_lut[idx]) & 0xFFFF
        i = i + 1
      }
      return crc16_to_slot(crc)
    }
    let idx = ((crc >> 8) ^ b) & 0xFF
    crc = ((crc << 8) ^ crc16_lut[idx]) & 0xFFFF
    i = i + 1
  }
  crc16_to_slot(crc)
}

///| Parse non-negative ASCII integer from `s[start .. end]`, or -1 on error.
fn parse_small_uint_str(s : String, start : Int, end : Int) -> Int {
  if start >= end {
    return -1
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return -1
    }
    acc = acc * 10 + (c - 48)
    if acc > 100000 {
      return -1
    }
    i = i + 1
  }
  acc
}

///| Slice a substring `s[start .. end]` with a single copy (no intermediate `Bytes`).
fn slice_str_range(s : String, start : Int, end : Int) -> String {
  if end <= start {
    return ""
  }
  s.slice(start, end)
}

///| Parse `<host>:<port>`, `[<ipv6>]:<port>`, or `:<port>` (Redis 7 unknown-endpoint) from `s[start .. end]`.
fn parse_host_port_str(s : String, start : Int, end : Int) -> Option[(String, Int)] {
  if start >= end {
    return None
  }
  if s.code_unit_at(start) == 91 { // '[' IPv6
    let mut close = start + 1
    while close < end && s.code_unit_at(close) != 93 { // ']'
      close = close + 1
    }
    if close >= end || close + 1 >= end || s.code_unit_at(close + 1) != 58 { // ':'
      return None
    }
    let port = parse_small_uint_str(s, close + 2, end)
    if port < 1 || port > 65535 {
      return None
    }
    let host = slice_str_range(s, start + 1, close)
    return Some((host, port))
  }
  // Find last ':' for host:port (allows empty host `:6380` per Redis 7 unknown-endpoint)
  let mut colon = end - 1
  while colon >= start && s.code_unit_at(colon) != 58 {
    colon = colon - 1
  }
  if colon < start {
    return None
  }
  let port = parse_small_uint_str(s, colon + 1, end)
  if port < 1 || port > 65535 {
    return None
  }
  let host = slice_str_range(s, start, colon)
  Some((host, port))
}

///| Parse a `MOVED <slot> <host>:<port>` or `ASK <slot> <host>:<port>` error message.
///| Supports IPv4, hostname, bracketed/unbracketed IPv6, and Redis 7 empty endpoint (`:<port>`).
pub fn parse_cluster_redirect(err_msg : String) -> Option[ClusterRedirect] {
  let n = err_msg.length()
  let mut is_moved = false
  let mut pos = 0
  if n >= 6 &&
  err_msg.code_unit_at(0) == 77 &&
  err_msg.code_unit_at(1) == 79 &&
  err_msg.code_unit_at(2) == 86 &&
  err_msg.code_unit_at(3) == 69 &&
  err_msg.code_unit_at(4) == 68 &&
  err_msg.code_unit_at(5) == 32 {
    is_moved = true
    pos = 6
  } else if n >= 4 &&
  err_msg.code_unit_at(0) == 65 &&
  err_msg.code_unit_at(1) == 83 &&
  err_msg.code_unit_at(2) == 75 &&
  err_msg.code_unit_at(3) == 32 {
    is_moved = false
    pos = 4
  } else {
    return None
  }
  // Parse slot up to next space in one pass
  let mut sp = pos
  let mut slot = 0
  while sp < n {
    let c = err_msg.code_unit_at(sp)
    if c == 32 {
      break
    }
    if c < 48 || c > 57 {
      return None
    }
    slot = slot * 10 + (c - 48)
    if slot > 16383 {
      return None
    }
    sp = sp + 1
  }
  if sp == pos || sp >= n {
    return None
  }
  match parse_host_port_str(err_msg, sp + 1, n) {
    Some((host, port)) =>
    if is_moved {
      Some(ClusterRedirect::Moved(slot, host, port))
    } else {
      Some(ClusterRedirect::Ask(slot, host, port))
    }
    None => None
  }
}

///| Parse a `MOVED` or `ASK` redirection from a `RespFrame` (`SimpleError` or `BulkError`).
pub fn parse_cluster_redirect_frame(frame : RespFrame) -> Option[ClusterRedirect] {
  match frame {
    SimpleError(s) => parse_cluster_redirect(s)
    BulkError(b) => parse_cluster_redirect(b.to_string())
    _ => None
  }
}

///| Extract a String from a BulkString or SimpleString frame.
fn frame_to_string(f : RespFrame) -> Option[String] {
  match f {
    BulkString(b) => Some(b.to_string())
    SimpleString(s) => Some(s)
    _ => None
  }
}

///| Parse a single node entry `[host, port, (optional node_id, ...)]` in `CLUSTER SLOTS`.
fn parse_slot_node(f : RespFrame) -> Result[ClusterNode, RespError] {
  let elems = match f {
    Array(a) => a
    _ => return Err(RespError::InvalidClusterReply("node entry must be an array"))
  }
  if elems.length() < 2 {
    return Err(RespError::InvalidClusterReply("node entry requires at least [host, port]"))
  }
  let host = match elems[0] {
    BulkString(b) => b.to_string()
    SimpleString(s) => s
    Null => ""
    NullBulk => ""
    _ => return Err(RespError::InvalidClusterReply("node host must be string or null"))
  }
  let port = match elems[1] {
    Integer(p) =>
    if p < 1L || p > 65535L {
      return Err(RespError::InvalidClusterReply("node port out of range"))
    } else {
      p.to_int()
    }
    _ => return Err(RespError::InvalidClusterReply("node port must be integer"))
  }
  let node_id = if elems.length() >= 3 {
    match frame_to_string(elems[2]) {
      Some(id) => id
      None => ""
    }
  } else {
    ""
  }
  Ok(ClusterNode::new(host, port, node_id))
}

///| Parse a Redis `CLUSTER SLOTS` RESP response into `Array[SlotRange]`.
pub fn parse_cluster_slots(frame : RespFrame) -> Result[Array[SlotRange], RespError] {
  let outer = match frame {
    Array(a) => a
    _ => return Err(RespError::InvalidClusterReply("CLUSTER SLOTS must be an array"))
  }
  let ranges : Array[SlotRange] = []
  let mut i = 0
  while i < outer.length() {
    let entry = match outer[i] {
      Array(a) => a
      _ => return Err(RespError::InvalidClusterReply("slot range entry must be an array"))
    }
    if entry.length() < 3 {
      return Err(RespError::InvalidClusterReply("slot range entry requires [start, end, primary]"))
    }
    let start_slot = match entry[0] {
      Integer(v) =>
      if v < 0L || v > 16383L {
        return Err(RespError::InvalidClusterReply("start slot out of range"))
      } else {
        v.to_int()
      }
      _ => return Err(RespError::InvalidClusterReply("start slot must be integer"))
    }
    let end_slot = match entry[1] {
      Integer(v) =>
      if v < start_slot.to_int64() || v > 16383L {
        return Err(RespError::InvalidClusterReply("end slot out of range"))
      } else {
        v.to_int()
      }
      _ => return Err(RespError::InvalidClusterReply("end slot must be integer"))
    }
    let primary = match parse_slot_node(entry[2]) {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let replicas : Array[ClusterNode] = []
    let mut r = 3
    while r < entry.length() {
      let rep = match parse_slot_node(entry[r]) {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      replicas.push(rep)
      r = r + 1
    }
    ranges.push(SlotRange::{
      start: start_slot,
      end: end_slot,
      primary: primary,
      replicas: replicas,
    })
    i = i + 1
  }
  Ok(ranges)
}

///| O(1) Redis Cluster 16384-slot routing table.
pub struct ClusterRouter {
  slots : FixedArray[Int]
  nodes : Array[ClusterNode]
  mut covered : Int
}

///| Create an empty `ClusterRouter`.
pub fn ClusterRouter::new() -> ClusterRouter {
  ClusterRouter::{
    slots: FixedArray::make(16384, -1),
    nodes: [],
    covered: 0,
  }
}

///| Intern a `ClusterNode` in `self.nodes` and return its index.
fn ClusterRouter::intern_node(self : ClusterRouter, node : ClusterNode) -> Int {
  let mut i = 0
  while i < self.nodes.length() {
    let cur = self.nodes[i]
    if cur.host == node.host && cur.port == node.port && cur.node_id == node.node_id {
      return i
    }
    i = i + 1
  }
  let idx = self.nodes.length()
  self.nodes.push(node)
  idx
}

///| Replace routing table entries with new `CLUSTER SLOTS` ranges.
pub fn ClusterRouter::update_from_slots(
  self : ClusterRouter,
  ranges : Array[SlotRange],
) -> Result[Unit, RespError] {
  // Validate bounds and reject overlapping/duplicate ranges before mutating
  let seen = Bytes::new(16384)
  let mut i = 0
  while i < ranges.length() {
    let r = ranges[i]
    if !is_valid_slot_range(r.start, r.end) {
      return Err(RespError::InvalidClusterReply("invalid slot range bounds"))
    }
    let mut s = r.start
    while s <= r.end {
      if seen[s].to_int() != 0 {
        return Err(RespError::InvalidClusterReply("overlapping slot range"))
      }
      seen[s] = (1).to_byte()
      s = s + 1
    }
    i = i + 1
  }
  let mut s = 0
  while s < 16384 {
    self.slots[s] = -1
    s = s + 1
  }
  self.covered = 0
  i = 0
  while i < ranges.length() {
    let r = ranges[i]
    let node_idx = self.intern_node(r.primary)
    let mut slot = r.start
    while slot <= r.end {
      if self.slots[slot] == -1 {
        self.covered = self.covered + 1
      }
      self.slots[slot] = node_idx
      slot = slot + 1
    }
    i = i + 1
  }
  Ok(())
}

///| Build a `ClusterRouter` from parsed `CLUSTER SLOTS` ranges.
pub fn ClusterRouter::from_slots(ranges : Array[SlotRange]) -> Result[ClusterRouter, RespError] {
  let router = ClusterRouter::new()
  match router.update_from_slots(ranges) {
    Ok(_) => Ok(router)
    Err(e) => Err(e)
  }
}

///| Apply a `MOVED` redirection to a single slot (`0..16383`).
pub fn ClusterRouter::apply_moved(
  self : ClusterRouter,
  slot : Int,
  host : String,
  port : Int,
) -> Result[Unit, RespError] {
  if !is_valid_cluster_slot(slot) {
    return Err(RespError::InvalidClusterReply("slot out of range"))
  }
  if port < 1 || port > 65535 {
    return Err(RespError::InvalidClusterReply("port out of range"))
  }
  let node_idx = self.intern_node(ClusterNode::new(host, port, ""))
  if self.slots[slot] == -1 {
    self.covered = self.covered + 1
  }
  self.slots[slot] = node_idx
  Ok(())
}

///| Look up the primary node for a slot (`0..16383`).
pub fn ClusterRouter::route_slot(self : ClusterRouter, slot : Int) -> Option[ClusterNode] {
  if !is_valid_cluster_slot(slot) {
    return None
  }
  let idx = self.slots[slot]
  if idx < 0 {
    return None
  }
  Some(self.nodes[idx])
}

///| Look up the primary node for a binary key (computes `key_slot`).
pub fn ClusterRouter::route_key(self : ClusterRouter, key : Bytes) -> Option[ClusterNode] {
  self.route_slot(key_slot(key))
}

///| Look up the primary node for a string key.
pub fn ClusterRouter::route_key_string(self : ClusterRouter, key : String) -> Option[ClusterNode] {
  self.route_slot(key_slot_string(key))
}

///| Return how many of the 16384 slots currently have an assigned primary node.
pub fn ClusterRouter::covered_slots(self : ClusterRouter) -> Int {
  self.covered
}
