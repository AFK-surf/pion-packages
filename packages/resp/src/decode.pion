///| Iterative, stack-safe Redis RESP2 & RESP3 decoder, inline command parser,
///| and O(n) incremental Sans-IO streaming pipeline `StreamDecoder` with bounded buffer compaction.

///| Find `\r\n` starting at `pos` within `data[0 .. end]`, strictly rejecting lone `\r` or `\n`.
///| Returns `Ok(index_of_cr)`, `Err(Incomplete)` if more bytes are needed, or `Err(InvalidCrlf(pos))`.
fn find_crlf_strict(data : Bytes, pos : Int, end : Int) -> Result[Int, RespError] {
  let mut i = pos
  while i < end {
    let c = data[i].to_int()
    if c == 13 {
      if i + 1 >= end {
        return Err(RespError::Incomplete)
      }
      if data[i + 1].to_int() == 10 {
        return Ok(i)
      }
      return Err(RespError::InvalidCrlf(i))
    }
    if c == 10 {
      return Err(RespError::InvalidCrlf(i))
    }
    i = i + 1
  }
  Err(RespError::Incomplete)
}

///| Parse a signed 64-bit integer from `data[start .. end]` (optional leading `+` or `-`).
fn parse_int64_slice(data : Bytes, start : Int, end : Int, err_pos : Int) -> Result[Int64, RespError] {
  if start >= end {
    return Err(RespError::InvalidInteger(err_pos))
  }
  let mut i = start
  let mut neg = false
  let first = data[i].to_int()
  if first == 45 {
    neg = true
    i = i + 1
  } else if first == 43 {
    i = i + 1
  }
  if i >= end {
    return Err(RespError::InvalidInteger(err_pos))
  }
  let mut acc : Int64 = 0L
  while i < end {
    let c = data[i].to_int()
    if c < 48 || c > 57 {
      return Err(RespError::InvalidInteger(err_pos))
    }
    let d = (c - 48).to_int64()
    if neg {
      // Check against Int64::MIN (-9223372036854775808)
      if acc < -922337203685477580L || (acc == -922337203685477580L && d > 8L) {
        return Err(RespError::InvalidInteger(err_pos))
      }
      acc = acc * 10L - d
    } else {
      // Check against Int64::MAX (9223372036854775807)
      if acc > 922337203685477580L || (acc == 922337203685477580L && d > 7L) {
        return Err(RespError::InvalidInteger(err_pos))
      }
      acc = acc * 10L + d
    }
    i = i + 1
  }
  Ok(acc)
}

///| Parse a RESP3 Double from `data[start .. end]`.
///| Strictly follows RESP3 grammar: `[+|-]<integral>[.<fractional>][<E|e>[+|-]<exponent>]`,
///| plus the exact lowercase tokens `inf`, `+inf`, `-inf`, and `nan`.
fn parse_double_slice(data : Bytes, start : Int, end : Int, err_pos : Int) -> Result[Double, RespError] {
  let n = end - start
  if n <= 0 {
    return Err(RespError::InvalidDouble(err_pos))
  }
  // Exact special tokens: "inf", "+inf", "-inf", "nan"
  if n == 3 {
    let b0 = data[start].to_int()
    let b1 = data[start + 1].to_int()
    let b2 = data[start + 2].to_int()
    if b0 == 105 && b1 == 110 && b2 == 102 { // "inf"
      return Ok(Double::from_bits(0x7FF0000000000000L))
    }
    if b0 == 110 && b1 == 97 && b2 == 110 { // "nan"
      return Ok(Double::from_bits(0x7FF8000000000000L))
    }
  } else if n == 4 {
    let b0 = data[start].to_int()
    let b1 = data[start + 1].to_int()
    let b2 = data[start + 2].to_int()
    let b3 = data[start + 3].to_int()
    if b1 == 105 && b2 == 110 && b3 == 102 {
      if b0 == 43 { // "+inf"
        return Ok(Double::from_bits(0x7FF0000000000000L))
      }
      if b0 == 45 { // "-inf"
        return Ok(Double::from_bits(-4503599627370496L))
      }
    }
  }

  // Strict decimal/scientific grammar validation: [+|-][0-9]+(\.[0-9]+)?([eE][+|-]?[0-9]+)?
  let mut i = start
  let first = data[i].to_int()
  if first == 43 || first == 45 {
    i = i + 1
  }
  let int_start = i
  while i < end {
    let c = data[i].to_int()
    if c >= 48 && c <= 57 {
      i = i + 1
    } else {
      break
    }
  }
  if i == int_start {
    return Err(RespError::InvalidDouble(err_pos))
  }
  if i < end && data[i].to_int() == 46 { // '.'
    i = i + 1
    let frac_start = i
    while i < end {
      let c = data[i].to_int()
      if c >= 48 && c <= 57 {
        i = i + 1
      } else {
        break
      }
    }
    if i == frac_start {
      return Err(RespError::InvalidDouble(err_pos))
    }
  }
  if i < end {
    let ec = data[i].to_int()
    if ec == 101 || ec == 69 { // 'e' or 'E'
      i = i + 1
      if i < end {
        let sc = data[i].to_int()
        if sc == 43 || sc == 45 {
          i = i + 1
        }
      }
      let exp_start = i
      while i < end {
        let c = data[i].to_int()
        if c >= 48 && c <= 57 {
          i = i + 1
        } else {
          break
        }
      }
      if i == exp_start {
        return Err(RespError::InvalidDouble(err_pos))
      }
    }
  }
  if i != end {
    return Err(RespError::InvalidDouble(err_pos))
  }
  let s = slice_bytes(data, start, n).to_string()
  match s.to_double() {
    Some(v) => Ok(v)
    None => Err(RespError::InvalidDouble(err_pos))
  }
}

///| Validate BigNumber bytes: optional `+` or `-` followed by >= 1 ASCII digits.
fn validate_bignum_slice(data : Bytes, start : Int, end : Int, err_pos : Int) -> Result[String, RespError] {
  if start >= end {
    return Err(RespError::InvalidBigNumber(err_pos))
  }
  let mut i = start
  let first = data[i].to_int()
  if first == 45 || first == 43 {
    i = i + 1
    if i >= end {
      return Err(RespError::InvalidBigNumber(err_pos))
    }
  }
  while i < end {
    let c = data[i].to_int()
    if c < 48 || c > 57 {
      return Err(RespError::InvalidBigNumber(err_pos))
    }
    i = i + 1
  }
  Ok(slice_bytes(data, start, end - start).to_string())
}

///| Decode a RESP3 streamed BulkString starting right after `$?\r\n` (overflow-safe).
fn decode_streamed_bulk(
  data : Bytes,
  start : Int,
  end : Int,
  limits : RespLimits,
) -> Result[(Bytes, Int), RespError] {
  let out = ByteBuf::with_capacity(64)
  let mut pos = start
  while true {
    if pos >= end {
      return Err(RespError::Incomplete)
    }
    if data[pos].to_int() != 59 { // ';'
      return Err(RespError::InvalidChunkLength(pos))
    }
    let cr = match find_crlf_strict(data, pos + 1, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let chunk_len64 = match parse_int64_slice(data, pos + 1, cr, pos) {
      Ok(v) => v
      Err(_) => return Err(RespError::InvalidChunkLength(pos))
    }
    if chunk_len64 < 0L {
      return Err(RespError::InvalidChunkLength(pos))
    }
    if chunk_len64 > limits.max_bulk_len.to_int64() {
      return Err(RespError::MaxBulkLenExceeded(limits.max_bulk_len))
    }
    let chunk_len = chunk_len64.to_int()
    pos = cr + 2
    if chunk_len == 0 {
      return Ok((out.to_bytes(), pos))
    }
    if chunk_len > limits.max_bulk_len - out.len {
      return Err(RespError::MaxBulkLenExceeded(limits.max_bulk_len))
    }
    let avail = end - pos
    if avail < 2 || chunk_len > avail - 2 {
      return Err(RespError::Incomplete)
    }
    if data[pos + chunk_len].to_int() != 13 || data[pos + chunk_len + 1].to_int() != 10 {
      return Err(RespError::InvalidCrlf(pos + chunk_len))
    }
    out.push_bytes_slice(data, pos, chunk_len)
    pos = pos + chunk_len + 2
  }
  Err(RespError::Incomplete)
}

///| Hex digit value or -1.
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

///| Check whether a byte is ASCII whitespace per C `isspace()` (` `, `\t`, `\n`, `\v`, `\f`, `\r`).
fn is_inline_space(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13
}

///| Check whether a byte is one of the 15 RESP2/RESP3 frame prefix bytes.
fn is_resp_prefix(b : Int) -> Bool {
  b == 43 || // '+'
  b == 45 || // '-'
  b == 58 || // ':'
  b == 36 || // '$'
  b == 42 || // '*'
  b == 95 || // '_'
  b == 35 || // '#'
  b == 44 || // ','
  b == 40 || // '('
  b == 33 || // '!'
  b == 61 || // '='
  b == 37 || // '%'
  b == 126 || // '~'
  b == 124 || // '|'
  b == 62 // '>'
}

///| Parse a Redis inline command line (strictly matching Redis `src/sds.c` `sdssplitargs`).
pub fn decode_inline(line : Bytes, limits : RespLimits) -> Result[Array[Bytes], RespError] {
  let n = line.length()
  if n > limits.max_inline_len {
    return Err(RespError::MaxBufferBytesExceeded(limits.max_inline_len))
  }
  let mut end = n
  if end > 0 && line[end - 1].to_int() == 10 {
    end = end - 1
    if end > 0 && line[end - 1].to_int() == 13 {
      end = end - 1
    }
  }
  let args : Array[Bytes] = []
  let mut i = 0
  while i < end {
    // Skip C `isspace()` whitespace
    while i < end && is_inline_space(line[i].to_int()) {
      i = i + 1
    }
    if i >= end {
      break
    }
    if args.length() >= limits.max_collection_len {
      return Err(RespError::MaxCollectionLenExceeded(limits.max_collection_len))
    }
    let cur = ByteBuf::with_capacity(16)
    let mut in_dquote = false
    let mut in_squote = false
    let mut done = false
    while i < end && !done {
      let c = line[i].to_int()
      if in_dquote {
        if c == 92 && i + 1 < end { // '\'
          let nx = line[i + 1].to_int()
          if nx == 120 && i + 3 < end { // \xHH
            let h1 = hex_nibble(line[i + 2].to_int())
            let h2 = hex_nibble(line[i + 3].to_int())
            if h1 >= 0 && h2 >= 0 {
              cur.push_byte((h1 << 4) | h2)
              i = i + 4
              continue
            }
          }
          if nx == 110 { // \n
            cur.push_byte(10)
          } else if nx == 114 { // \r
            cur.push_byte(13)
          } else if nx == 116 { // \t
            cur.push_byte(9)
          } else if nx == 98 { // \b
            cur.push_byte(8)
          } else if nx == 97 { // \a
            cur.push_byte(7)
          } else {
            cur.push_byte(nx)
          }
          i = i + 2
        } else if c == 34 { // '"'
          if i + 1 < end && !is_inline_space(line[i + 1].to_int()) {
            return Err(RespError::InvalidInlineQuote(i))
          }
          in_dquote = false
          i = i + 1
          done = true
        } else {
          cur.push_byte(c)
          i = i + 1
        }
      } else if in_squote {
        // Redis sdssplitargs: inside single quotes ONLY `\'` is an escape; `\\` stays two bytes.
        if c == 92 && i + 1 < end && line[i + 1].to_int() == 39 { // \'
          cur.push_byte(39)
          i = i + 2
        } else if c == 39 { // '\''
          if i + 1 < end && !is_inline_space(line[i + 1].to_int()) {
            return Err(RespError::InvalidInlineQuote(i))
          }
          in_squote = false
          i = i + 1
          done = true
        } else {
          cur.push_byte(c)
          i = i + 1
        }
      } else {
        if is_inline_space(c) {
          done = true
        } else if c == 34 { // '"' opens a double-quoted section (allowed mid-token per sdssplitargs)
          in_dquote = true
          i = i + 1
        } else if c == 39 { // '\'' opens a single-quoted section (allowed mid-token per sdssplitargs)
          in_squote = true
          i = i + 1
        } else {
          cur.push_byte(c)
          i = i + 1
        }
      }
      if cur.len > limits.max_bulk_len {
        return Err(RespError::MaxBulkLenExceeded(limits.max_bulk_len))
      }
    }
    if in_dquote || in_squote {
      return Err(RespError::InvalidInlineQuote(i))
    }
    args.push(cur.to_bytes())
  }
  Ok(args)
}

///| Internal container state for iterative stack-safe RESP2/RESP3 decoding.
///| `kind`:
///|   0 = Array, 1 = Set, 2 = Push, 3 = Map, 4 = Attribute (collecting pairs),
///|   5 = AttributeTarget (waiting for the single target frame after pairs are collected)
struct DecodeContainer {
  kind : Int
  streamed : Bool
  remaining : Int
  items : Array[RespFrame]
  pairs : Array[(RespFrame, RespFrame)]
  mut pending_key : Option[RespFrame]
}

///| Propagate a completed child frame up `stack`.
///| Returns `Ok(Some(root))` if the top-level frame is complete, `Ok(None)` if more elements are needed.
fn unwind_frame(
  stack : Array[DecodeContainer],
  initial : RespFrame,
  limits : RespLimits,
) -> Result[Option[RespFrame], RespError] {
  let mut completed = initial
  while true {
    if stack.length() == 0 {
      return Ok(Some(completed))
    }
    let parent = stack[stack.length() - 1]
    if parent.kind == 5 {
      let attr_c = match stack.pop() {
        Some(c) => c
        None => break
      }
      completed = RespFrame::Attribute(attr_c.pairs, completed)
      continue
    }
    if parent.kind == 3 || parent.kind == 4 {
      match parent.pending_key {
        None => {
          parent.pending_key = Some(completed)
          return Ok(None)
        }
        Some(k) => {
          parent.pending_key = None
          parent.pairs.push((k, completed))
          if !parent.streamed && parent.pairs.length() == parent.remaining {
            let p_fin = match stack.pop() {
              Some(c) => c
              None => break
            }
            if p_fin.kind == 4 {
              stack.push(DecodeContainer::{
                kind: 5,
                streamed: false,
                remaining: 1,
                items: [],
                pairs: p_fin.pairs,
                pending_key: None,
              })
              return Ok(None)
            }
            completed = RespFrame::Map(p_fin.pairs)
            continue
          }
          if parent.streamed && parent.pairs.length() > limits.max_collection_len {
            return Err(RespError::MaxCollectionLenExceeded(limits.max_collection_len))
          }
          return Ok(None)
        }
      }
    } else {
      parent.items.push(completed)
      if !parent.streamed && parent.items.length() == parent.remaining {
        let p_fin = match stack.pop() {
          Some(c) => c
          None => break
        }
        completed = if p_fin.kind == 0 {
          RespFrame::Array(p_fin.items)
        } else if p_fin.kind == 1 {
          RespFrame::Set(p_fin.items)
        } else {
          RespFrame::Push(p_fin.items)
        }
        continue
      }
      if parent.streamed && parent.items.length() > limits.max_collection_len {
        return Err(RespError::MaxCollectionLenExceeded(limits.max_collection_len))
      }
      return Ok(None)
    }
  }
  Ok(None)
}

///| Iterative RESP2/RESP3 prefix decoder over `data[offset .. end]`.
fn decode_prefix_range(
  data : Bytes,
  offset : Int,
  end : Int,
  limits : RespLimits,
  allow_inline : Bool,
) -> Result[(RespFrame, Int), RespError] {
  if offset >= end {
    return Err(RespError::Incomplete)
  }

  // Inline command fast check (only at top level when enabled and first byte is not a RESP prefix)
  let first_b = data[offset].to_int()
  if allow_inline && !is_resp_prefix(first_b) {
    let mut lf = offset
    while lf < end && data[lf].to_int() != 10 {
      if lf - offset + 1 > limits.max_inline_len {
        return Err(RespError::MaxBufferBytesExceeded(limits.max_inline_len))
      }
      lf = lf + 1
    }
    if lf >= end {
      return Err(RespError::Incomplete)
    }
    let line_len = lf - offset + 1
    if line_len > limits.max_inline_len {
      return Err(RespError::MaxBufferBytesExceeded(limits.max_inline_len))
    }
    let line = slice_bytes(data, offset, line_len)
    let args = match decode_inline(line, limits) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let frames : Array[RespFrame] = []
    let mut ai = 0
    while ai < args.length() {
      frames.push(RespFrame::BulkString(args[ai]))
      ai = ai + 1
    }
    return Ok((RespFrame::Array(frames), lf + 1))
  }

  let stack : Array[DecodeContainer] = []
  let mut pos = offset
  let mut total_nodes = 0

  while true {
    // Check if top container is a streamed container seeing the `.` end marker `.\r\n`.
    if stack.length() > 0 {
      let top = stack[stack.length() - 1]
      if top.streamed && top.kind != 5 {
        if pos >= end {
          return Err(RespError::Incomplete)
        }
        if data[pos].to_int() == 46 { // '.'
          if pos + 1 < end && data[pos + 1].to_int() != 13 {
            return Err(RespError::InvalidCrlf(pos + 1))
          }
          if pos + 2 >= end {
            return Err(RespError::Incomplete)
          }
          if data[pos + 2].to_int() != 10 {
            return Err(RespError::InvalidCrlf(pos + 1))
          }
          if top.kind == 3 || top.kind == 4 {
            match top.pending_key {
              Some(_) => return Err(RespError::UnexpectedEndMarker(pos))
              None => ()
            }
          }
          pos = pos + 3
          let finished = match stack.pop() {
            Some(c) => c
            None => return Err(RespError::UnexpectedEndMarker(pos))
          }
          if finished.kind == 4 {
            stack.push(DecodeContainer::{
              kind: 5,
              streamed: false,
              remaining: 1,
              items: [],
              pairs: finished.pairs,
              pending_key: None,
            })
            continue
          }
          let done_frame = if finished.kind == 0 {
            RespFrame::Array(finished.items)
          } else if finished.kind == 1 {
            RespFrame::Set(finished.items)
          } else if finished.kind == 2 {
            RespFrame::Push(finished.items)
          } else {
            RespFrame::Map(finished.pairs)
          }
          match unwind_frame(stack, done_frame, limits) {
            Ok(Some(root)) => return Ok((root, pos))
            Ok(None) => continue
            Err(e) => return Err(e)
          }
        }
      }
    }

    if pos >= end {
      return Err(RespError::Incomplete)
    }

    if total_nodes >= limits.max_total_nodes {
      return Err(RespError::MaxTotalNodesExceeded(limits.max_total_nodes))
    }

    let prefix = data[pos].to_int()
    if prefix == 46 { // '.' outside streamed container
      if stack.length() > 0 && stack[stack.length() - 1].kind == 5 {
        return Err(RespError::DanglingAttribute(pos))
      }
      return Err(RespError::UnexpectedEndMarker(pos))
    }
    if !is_resp_prefix(prefix) {
      return Err(RespError::InvalidPrefix(prefix, pos))
    }

    let cr = match find_crlf_strict(data, pos + 1, end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }

    let mut frame_opt : Option[RespFrame] = None
    let line_start = pos + 1
    let next_after_line = cr + 2

    if prefix == 43 { // '+' SimpleString
      frame_opt = Some(RespFrame::SimpleString(slice_bytes(data, line_start, cr - line_start).to_string()))
      pos = next_after_line
    } else if prefix == 45 { // '-' SimpleError
      frame_opt = Some(RespFrame::SimpleError(slice_bytes(data, line_start, cr - line_start).to_string()))
      pos = next_after_line
    } else if prefix == 58 { // ':' Integer
      let iv = match parse_int64_slice(data, line_start, cr, pos) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      frame_opt = Some(RespFrame::Integer(iv))
      pos = next_after_line
    } else if prefix == 95 { // '_' Null
      if cr != line_start {
        return Err(RespError::InvalidCrlf(line_start))
      }
      frame_opt = Some(RespFrame::Null)
      pos = next_after_line
    } else if prefix == 35 { // '#' Boolean
      if cr - line_start != 1 {
        return Err(RespError::InvalidBoolean(pos))
      }
      let bc = data[line_start].to_int()
      if bc == 116 { // 't'
        frame_opt = Some(RespFrame::Boolean(true))
      } else if bc == 102 { // 'f'
        frame_opt = Some(RespFrame::Boolean(false))
      } else {
        return Err(RespError::InvalidBoolean(pos))
      }
      pos = next_after_line
    } else if prefix == 44 { // ',' Double
      let dv = match parse_double_slice(data, line_start, cr, pos) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      frame_opt = Some(RespFrame::Double(dv))
      pos = next_after_line
    } else if prefix == 40 { // '(' BigNumber
      let bn = match validate_bignum_slice(data, line_start, cr, pos) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      frame_opt = Some(RespFrame::BigNumber(bn))
      pos = next_after_line
    } else if prefix == 36 || prefix == 33 || prefix == 61 {
      // '$' BulkString (or streamed `$?`), '!' BulkError, '=' VerbatimString
      if prefix == 36 && cr - line_start == 1 && data[line_start].to_int() == 63 { // '?'
        let (bs, npos) = match decode_streamed_bulk(data, next_after_line, end, limits) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        frame_opt = Some(RespFrame::BulkString(bs))
        pos = npos
      } else {
        let len64 = match parse_int64_slice(data, line_start, cr, pos) {
          Ok(v) => v
          Err(_) => return Err(RespError::InvalidBulkLength(-1L, pos))
        }
        if prefix == 36 && len64 == -1L {
          frame_opt = Some(RespFrame::NullBulk)
          pos = next_after_line
        } else if len64 < 0L {
          return Err(RespError::InvalidBulkLength(len64, pos))
        } else if len64 > limits.max_bulk_len.to_int64() {
          return Err(RespError::MaxBulkLenExceeded(limits.max_bulk_len))
        } else {
          let blen = len64.to_int()
          if prefix == 61 && blen < 4 {
            return Err(RespError::InvalidVerbatimFormat(pos))
          }
          let avail = end - next_after_line
          if avail < 2 || blen > avail - 2 {
            return Err(RespError::Incomplete)
          }
          if data[next_after_line + blen].to_int() != 13 || data[next_after_line + blen + 1].to_int() != 10 {
            return Err(RespError::InvalidCrlf(next_after_line + blen))
          }
          if prefix == 36 {
            frame_opt = Some(RespFrame::BulkString(slice_bytes(data, next_after_line, blen)))
          } else if prefix == 33 {
            frame_opt = Some(RespFrame::BulkError(slice_bytes(data, next_after_line, blen)))
          } else {
            if data[next_after_line + 3].to_int() != 58 { // ':'
              return Err(RespError::InvalidVerbatimFormat(next_after_line))
            }
            let enc_tag = slice_bytes(data, next_after_line, 3).to_string()
            let payload = slice_bytes(data, next_after_line + 4, blen - 4)
            frame_opt = Some(RespFrame::VerbatimString(enc_tag, payload))
          }
          pos = next_after_line + blen + 2
        }
      }
    } else if prefix == 42 || prefix == 126 || prefix == 62 || prefix == 37 || prefix == 124 {
      // Containers: '*' Array, '~' Set, '>' Push, '%' Map, '|' Attribute
      let kind = if prefix == 42 {
        0
      } else if prefix == 126 {
        1
      } else if prefix == 62 {
        2
      } else if prefix == 37 {
        3
      } else {
        4
      }
      let is_streamed = cr - line_start == 1 && data[line_start].to_int() == 63 // '?'
      if is_streamed {
        if stack.length() >= limits.max_depth {
          return Err(RespError::MaxDepthExceeded(limits.max_depth))
        }
        total_nodes = total_nodes + 1
        stack.push(DecodeContainer::{
          kind: kind,
          streamed: true,
          remaining: 0,
          items: [],
          pairs: [],
          pending_key: None,
        })
        pos = next_after_line
        continue
      }
      let len64 = match parse_int64_slice(data, line_start, cr, pos) {
        Ok(v) => v
        Err(_) => return Err(RespError::InvalidCollectionLength(-1L, pos))
      }
      if prefix == 42 && len64 == -1L {
        frame_opt = Some(RespFrame::NullArray)
        pos = next_after_line
      } else if len64 < 0L {
        return Err(RespError::InvalidCollectionLength(len64, pos))
      } else if len64 > limits.max_collection_len.to_int64() {
        return Err(RespError::MaxCollectionLenExceeded(limits.max_collection_len))
      } else {
        let clen = len64.to_int()
        pos = next_after_line
        if clen == 0 {
          if kind == 4 {
            if stack.length() >= limits.max_depth {
              return Err(RespError::MaxDepthExceeded(limits.max_depth))
            }
            total_nodes = total_nodes + 1
            stack.push(DecodeContainer::{
              kind: 5,
              streamed: false,
              remaining: 1,
              items: [],
              pairs: [],
              pending_key: None,
            })
            continue
          }
          frame_opt = Some(
            if kind == 0 {
              RespFrame::Array([])
            } else if kind == 1 {
              RespFrame::Set([])
            } else if kind == 2 {
              RespFrame::Push([])
            } else {
              RespFrame::Map([])
            },
          )
        } else {
          if stack.length() >= limits.max_depth {
            return Err(RespError::MaxDepthExceeded(limits.max_depth))
          }
          total_nodes = total_nodes + 1
          stack.push(DecodeContainer::{
            kind: kind,
            streamed: false,
            remaining: clen,
            items: [],
            pairs: [],
            pending_key: None,
          })
          continue
        }
      }
    } else {
      return Err(RespError::InvalidPrefix(prefix, pos))
    }

    total_nodes = total_nodes + 1
    let completed = match frame_opt {
      Some(f) => f
      None => continue
    }
    match unwind_frame(stack, completed, limits) {
      Ok(Some(root)) => return Ok((root, pos))
      Ok(None) => ()
      Err(e) => return Err(e)
    }
  }
  Err(RespError::Incomplete)
}

///| Decode a single complete `RespFrame` from `data` starting at `offset`.
///| Returns `(frame, next_offset)`.
pub fn decode_prefix(
  data : Bytes,
  offset : Int,
  limits : RespLimits,
) -> Result[(RespFrame, Int), RespError] {
  decode_prefix_range(data, offset, data.length(), limits, false)
}

///| Decode a single complete `RespFrame` from `data`, rejecting trailing bytes.
pub fn decode(data : Bytes, limits : RespLimits) -> Result[RespFrame, RespError] {
  let (frame, next_off) = match decode_prefix_range(data, 0, data.length(), limits, false) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  if next_off < data.length() {
    return Err(RespError::TrailingBytes(next_off))
  }
  Ok(frame)
}

///| Decode a single complete `RespFrame` using `RespLimits::default()`.
pub fn decode_default(data : Bytes) -> Result[RespFrame, RespError] {
  decode(data, RespLimits::default())
}

///| Compute the effective stream buffer cap, ensuring a single `max_bulk_len` frame
///| (including `$len\r\n` header and trailing `\r\n`, up to 16 B) fits when
///| `max_buffer_bytes >= max_bulk_len`.
fn effective_max_buffer_bytes(limits : RespLimits) -> Int {
  if limits.max_buffer_bytes >= limits.max_bulk_len &&
  limits.max_bulk_len <= 2147483647 - 16 &&
  limits.max_buffer_bytes < limits.max_bulk_len + 16 {
    limits.max_bulk_len + 16
  } else {
    limits.max_buffer_bytes
  }
}

///| Sans-IO incremental O(n) streaming RESP2/RESP3 pipeline decoder with bounded buffer
///| and automatic compaction. Inline command parsing is disabled by default (client-safe);
///| call `set_allow_inline(true)` or `with_allow_inline(true)` for server-side decoding.
pub struct StreamDecoder {
  limits : RespLimits
  mut allow_inline : Bool
  mut buf : Bytes
  mut read_pos : Int
  mut write_pos : Int
  mut parse_pos : Int
  mut stack : Array[DecodeContainer]
  mut total_nodes : Int
  mut in_sbulk : Bool
  mut sbulk_buf : ByteBuf
  mut in_inline : Bool
  mut inline_scan : Int
  mut sticky_err : Option[RespError]
}

///| Create a new `StreamDecoder` with explicit `RespLimits` (`allow_inline` defaults to `false`).
pub fn StreamDecoder::new(limits : RespLimits) -> StreamDecoder {
  StreamDecoder::{
    limits: limits,
    allow_inline: false,
    buf: Bytes::new(256),
    read_pos: 0,
    write_pos: 0,
    parse_pos: 0,
    stack: [],
    total_nodes: 0,
    in_sbulk: false,
    sbulk_buf: ByteBuf::with_capacity(64),
    in_inline: false,
    inline_scan: 0,
    sticky_err: None,
  }
}

///| Create a new `StreamDecoder` with `RespLimits::default()` (`allow_inline` defaults to `false`).
pub fn StreamDecoder::default() -> StreamDecoder {
  StreamDecoder::new(RespLimits::default())
}

///| Enable or disable inline command parsing on top-level frames.
pub fn StreamDecoder::set_allow_inline(self : StreamDecoder, allow : Bool) -> Unit {
  self.allow_inline = allow
}

///| Builder helper to enable or disable inline command parsing on top-level frames.
pub fn StreamDecoder::with_allow_inline(self : StreamDecoder, allow : Bool) -> StreamDecoder {
  self.allow_inline = allow
  self
}

///| Clear incremental per-frame state after completing a frame or resetting.
fn StreamDecoder::clear_frame_state(self : StreamDecoder) -> Unit {
  if self.stack.length() > 0 {
    self.stack = []
  }
  self.total_nodes = 0
  self.in_sbulk = false
  self.sbulk_buf.clear()
  if self.sbulk_buf.data.length() > 65536 {
    self.sbulk_buf = ByteBuf::with_capacity(64)
  }
  self.in_inline = false
  self.parse_pos = self.read_pos
  self.inline_scan = self.read_pos
}

///| Compact the internal buffer to reclaim consumed prefix bytes and shrink if oversized.
fn StreamDecoder::maybe_compact(self : StreamDecoder) -> Unit {
  let unread = self.write_pos - self.read_pos
  if unread == 0 {
    self.read_pos = 0
    self.write_pos = 0
    self.parse_pos = 0
    self.inline_scan = 0
    if self.buf.length() > 65536 {
      self.buf = Bytes::new(4096)
    }
    return ()
  }
  if self.read_pos >= 4096 && self.read_pos * 2 >= self.buf.length() {
    let shift = self.read_pos
    copy_bytes(self.buf, 0, self.buf, shift, unread)
    self.read_pos = 0
    self.write_pos = unread
    self.parse_pos = self.parse_pos - shift
    self.inline_scan = self.inline_scan - shift
  }
}

///| Append raw bytes from the network into the internal stream buffer.
pub fn StreamDecoder::feed(self : StreamDecoder, chunk : Bytes) -> Result[Unit, RespError] {
  let clen = chunk.length()
  if clen == 0 {
    return Ok(())
  }
  let unread = self.write_pos - self.read_pos
  let max_buf = effective_max_buffer_bytes(self.limits)
  if clen > max_buf - unread {
    return Err(RespError::MaxBufferBytesExceeded(self.limits.max_buffer_bytes))
  }
  // If unread == 0, reset cursors to 0 immediately
  if unread == 0 {
    self.read_pos = 0
    self.write_pos = 0
    self.parse_pos = 0
    self.inline_scan = 0
  }
  // If tail space is insufficient, first compact if that makes room
  if clen > self.buf.length() - self.write_pos {
    if self.read_pos > 0 && clen <= self.buf.length() - unread {
      let shift = self.read_pos
      if unread > 0 {
        copy_bytes(self.buf, 0, self.buf, shift, unread)
      }
      self.read_pos = 0
      self.write_pos = unread
      self.parse_pos = self.parse_pos - shift
      self.inline_scan = self.inline_scan - shift
    } else {
      let need = unread + clen
      let mut next_cap = self.buf.length()
      if next_cap < 256 {
        next_cap = 256
      }
      while next_cap < need {
        if next_cap > 1073741823 {
          next_cap = need
          break
        }
        next_cap = next_cap * 2
      }
      if next_cap > max_buf {
        next_cap = max_buf
      }
      let next_buf = Bytes::new(next_cap)
      let shift = self.read_pos
      if unread > 0 {
        copy_bytes(next_buf, 0, self.buf, shift, unread)
      }
      self.buf = next_buf
      self.read_pos = 0
      self.write_pos = unread
      self.parse_pos = self.parse_pos - shift
      self.inline_scan = self.inline_scan - shift
    }
  }
  copy_bytes(self.buf, self.write_pos, chunk, 0, clen)
  self.write_pos = self.write_pos + clen
  Ok(())
}

///| Record a sticky protocol/limit error on `StreamDecoder` and return it.
fn StreamDecoder::fail(self : StreamDecoder, err : RespError) -> Result[Option[RespFrame], RespError] {
  self.sticky_err = Some(err)
  Err(err)
}

///| Advance the incremental parser by as many bytes as are currently buffered.
///| Returns `Ok(Some(frame))` when a complete frame finishes, `Ok(None)` when more bytes are needed,
///| or `Err(e)` on a protocol or limit violation (sticky until `reset()`).
fn StreamDecoder::step_frame(self : StreamDecoder) -> Result[Option[RespFrame], RespError] {
  match self.sticky_err {
    Some(e) => return Err(e)
    None => ()
  }
  let end = self.write_pos
  if self.read_pos >= end {
    return Ok(None)
  }

  let data = self.buf
  let limits = self.limits

  // Start-of-frame inline check
  if !self.in_inline && !self.in_sbulk && self.stack.length() == 0 && self.parse_pos == self.read_pos {
    let first_b = data[self.read_pos].to_int()
    if self.allow_inline && !is_resp_prefix(first_b) {
      self.in_inline = true
      self.inline_scan = self.read_pos
    }
  }

  // Incremental inline command line scan (O(n), capped at `limits.max_inline_len`)
  if self.in_inline {
    let mut i = self.inline_scan
    while i < end {
      let line_len = i - self.read_pos + 1
      if data[i].to_int() == 10 { // '\n'
        if line_len > limits.max_inline_len {
          return self.fail(RespError::MaxBufferBytesExceeded(limits.max_inline_len))
        }
        let line = slice_bytes(data, self.read_pos, line_len)
        let args = match decode_inline(line, limits) {
          Ok(a) => a
          Err(e) => return self.fail(e)
        }
        let frames : Array[RespFrame] = []
        let mut ai = 0
        while ai < args.length() {
          frames.push(RespFrame::BulkString(args[ai]))
          ai = ai + 1
        }
        self.read_pos = i + 1
        self.clear_frame_state()
        return Ok(Some(RespFrame::Array(frames)))
      }
      if line_len > limits.max_inline_len {
        return self.fail(RespError::MaxBufferBytesExceeded(limits.max_inline_len))
      }
      i = i + 1
    }
    self.inline_scan = end
    return Ok(None)
  }

  // Main incremental RESP2/RESP3 loop
  while true {
    // Resume in-progress `$?` streamed BulkString
    if self.in_sbulk {
      let pos = self.parse_pos
      if pos >= end {
        return Ok(None)
      }
      if data[pos].to_int() != 59 { // ';'
        return self.fail(RespError::InvalidChunkLength(pos))
      }
      let cr = match find_crlf_strict(data, pos + 1, end) {
        Ok(v) => v
        Err(Incomplete) => return Ok(None)
        Err(e) => return self.fail(e)
      }
      let chunk_len64 = match parse_int64_slice(data, pos + 1, cr, pos) {
        Ok(v) => v
        Err(_) => return self.fail(RespError::InvalidChunkLength(pos))
      }
      if chunk_len64 < 0L {
        return self.fail(RespError::InvalidChunkLength(pos))
      }
      if chunk_len64 > limits.max_bulk_len.to_int64() {
        return self.fail(RespError::MaxBulkLenExceeded(limits.max_bulk_len))
      }
      let chunk_len = chunk_len64.to_int()
      let data_start = cr + 2
      if chunk_len == 0 {
        self.parse_pos = data_start
        let bs = self.sbulk_buf.to_bytes()
        self.sbulk_buf.clear()
        if self.sbulk_buf.data.length() > 65536 {
          self.sbulk_buf = ByteBuf::with_capacity(64)
        }
        self.in_sbulk = false
        match unwind_frame(self.stack, RespFrame::BulkString(bs), limits) {
          Ok(Some(root)) => {
            self.read_pos = self.parse_pos
            self.clear_frame_state()
            return Ok(Some(root))
          }
          Ok(None) => continue
          Err(e) => return self.fail(e)
        }
      }
      if chunk_len > limits.max_bulk_len - self.sbulk_buf.len {
        return self.fail(RespError::MaxBulkLenExceeded(limits.max_bulk_len))
      }
      let avail = end - data_start
      if avail < 2 || chunk_len > avail - 2 {
        return Ok(None)
      }
      if data[data_start + chunk_len].to_int() != 13 || data[data_start + chunk_len + 1].to_int() != 10 {
        return self.fail(RespError::InvalidCrlf(data_start + chunk_len))
      }
      self.sbulk_buf.push_bytes_slice(data, data_start, chunk_len)
      self.parse_pos = data_start + chunk_len + 2
      continue
    }

    let pos = self.parse_pos

    // Check if top container is a streamed container seeing the `.` end marker `.\r\n`.
    if self.stack.length() > 0 {
      let top = self.stack[self.stack.length() - 1]
      if top.streamed && top.kind != 5 {
        if pos >= end {
          return Ok(None)
        }
        if data[pos].to_int() == 46 { // '.'
          if pos + 1 < end && data[pos + 1].to_int() != 13 {
            return self.fail(RespError::InvalidCrlf(pos + 1))
          }
          if pos + 2 >= end {
            return Ok(None)
          }
          if data[pos + 2].to_int() != 10 {
            return self.fail(RespError::InvalidCrlf(pos + 1))
          }
          if top.kind == 3 || top.kind == 4 {
            match top.pending_key {
              Some(_) => return self.fail(RespError::UnexpectedEndMarker(pos))
              None => ()
            }
          }
          self.parse_pos = pos + 3
          let finished = match self.stack.pop() {
            Some(c) => c
            None => return self.fail(RespError::UnexpectedEndMarker(pos))
          }
          if finished.kind == 4 {
            self.stack.push(DecodeContainer::{
              kind: 5,
              streamed: false,
              remaining: 1,
              items: [],
              pairs: finished.pairs,
              pending_key: None,
            })
            continue
          }
          let done_frame = if finished.kind == 0 {
            RespFrame::Array(finished.items)
          } else if finished.kind == 1 {
            RespFrame::Set(finished.items)
          } else if finished.kind == 2 {
            RespFrame::Push(finished.items)
          } else {
            RespFrame::Map(finished.pairs)
          }
          match unwind_frame(self.stack, done_frame, limits) {
            Ok(Some(root)) => {
              self.read_pos = self.parse_pos
              self.clear_frame_state()
              return Ok(Some(root))
            }
            Ok(None) => continue
            Err(e) => return self.fail(e)
          }
        }
      }
    }

    if pos >= end {
      return Ok(None)
    }

    if self.total_nodes >= limits.max_total_nodes {
      return self.fail(RespError::MaxTotalNodesExceeded(limits.max_total_nodes))
    }

    let prefix = data[pos].to_int()
    if prefix == 46 { // '.' outside streamed container
      if self.stack.length() > 0 && self.stack[self.stack.length() - 1].kind == 5 {
        return self.fail(RespError::DanglingAttribute(pos))
      }
      return self.fail(RespError::UnexpectedEndMarker(pos))
    }
    if !is_resp_prefix(prefix) {
      return self.fail(RespError::InvalidPrefix(prefix, pos))
    }

    let cr = match find_crlf_strict(data, pos + 1, end) {
      Ok(v) => v
      Err(Incomplete) => return Ok(None)
      Err(e) => return self.fail(e)
    }

    let mut frame_opt : Option[RespFrame] = None
    let line_start = pos + 1
    let next_after_line = cr + 2

    if prefix == 43 { // '+' SimpleString
      frame_opt = Some(RespFrame::SimpleString(slice_bytes(data, line_start, cr - line_start).to_string()))
      self.parse_pos = next_after_line
    } else if prefix == 45 { // '-' SimpleError
      frame_opt = Some(RespFrame::SimpleError(slice_bytes(data, line_start, cr - line_start).to_string()))
      self.parse_pos = next_after_line
    } else if prefix == 58 { // ':' Integer
      let iv = match parse_int64_slice(data, line_start, cr, pos) {
        Ok(v) => v
        Err(e) => return self.fail(e)
      }
      frame_opt = Some(RespFrame::Integer(iv))
      self.parse_pos = next_after_line
    } else if prefix == 95 { // '_' Null
      if cr != line_start {
        return self.fail(RespError::InvalidCrlf(line_start))
      }
      frame_opt = Some(RespFrame::Null)
      self.parse_pos = next_after_line
    } else if prefix == 35 { // '#' Boolean
      if cr - line_start != 1 {
        return self.fail(RespError::InvalidBoolean(pos))
      }
      let bc = data[line_start].to_int()
      if bc == 116 { // 't'
        frame_opt = Some(RespFrame::Boolean(true))
      } else if bc == 102 { // 'f'
        frame_opt = Some(RespFrame::Boolean(false))
      } else {
        return self.fail(RespError::InvalidBoolean(pos))
      }
      self.parse_pos = next_after_line
    } else if prefix == 44 { // ',' Double
      let dv = match parse_double_slice(data, line_start, cr, pos) {
        Ok(v) => v
        Err(e) => return self.fail(e)
      }
      frame_opt = Some(RespFrame::Double(dv))
      self.parse_pos = next_after_line
    } else if prefix == 40 { // '(' BigNumber
      let bn = match validate_bignum_slice(data, line_start, cr, pos) {
        Ok(v) => v
        Err(e) => return self.fail(e)
      }
      frame_opt = Some(RespFrame::BigNumber(bn))
      self.parse_pos = next_after_line
    } else if prefix == 36 || prefix == 33 || prefix == 61 {
      // '$' BulkString (or streamed `$?`), '!' BulkError, '=' VerbatimString
      if prefix == 36 && cr - line_start == 1 && data[line_start].to_int() == 63 { // '?'
        self.total_nodes = self.total_nodes + 1
        self.parse_pos = next_after_line
        self.in_sbulk = true
        self.sbulk_buf.clear()
        continue
      }
      let len64 = match parse_int64_slice(data, line_start, cr, pos) {
        Ok(v) => v
        Err(_) => return self.fail(RespError::InvalidBulkLength(-1L, pos))
      }
      if prefix == 36 && len64 == -1L {
        frame_opt = Some(RespFrame::NullBulk)
        self.parse_pos = next_after_line
      } else if len64 < 0L {
        return self.fail(RespError::InvalidBulkLength(len64, pos))
      } else if len64 > limits.max_bulk_len.to_int64() {
        return self.fail(RespError::MaxBulkLenExceeded(limits.max_bulk_len))
      } else {
        let blen = len64.to_int()
        if prefix == 61 && blen < 4 {
          return self.fail(RespError::InvalidVerbatimFormat(pos))
        }
        let avail = end - next_after_line
        if avail < 2 || blen > avail - 2 {
          return Ok(None)
        }
        if data[next_after_line + blen].to_int() != 13 || data[next_after_line + blen + 1].to_int() != 10 {
          return self.fail(RespError::InvalidCrlf(next_after_line + blen))
        }
        if prefix == 36 {
          frame_opt = Some(RespFrame::BulkString(slice_bytes(data, next_after_line, blen)))
        } else if prefix == 33 {
          frame_opt = Some(RespFrame::BulkError(slice_bytes(data, next_after_line, blen)))
        } else {
          if data[next_after_line + 3].to_int() != 58 { // ':'
            return self.fail(RespError::InvalidVerbatimFormat(next_after_line))
          }
          let enc_tag = slice_bytes(data, next_after_line, 3).to_string()
          let payload = slice_bytes(data, next_after_line + 4, blen - 4)
          frame_opt = Some(RespFrame::VerbatimString(enc_tag, payload))
        }
        self.parse_pos = next_after_line + blen + 2
      }
    } else if prefix == 42 || prefix == 126 || prefix == 62 || prefix == 37 || prefix == 124 {
      // Containers: '*' Array, '~' Set, '>' Push, '%' Map, '|' Attribute
      let kind = if prefix == 42 {
        0
      } else if prefix == 126 {
        1
      } else if prefix == 62 {
        2
      } else if prefix == 37 {
        3
      } else {
        4
      }
      let is_streamed = cr - line_start == 1 && data[line_start].to_int() == 63 // '?'
      if is_streamed {
        if self.stack.length() >= limits.max_depth {
          return self.fail(RespError::MaxDepthExceeded(limits.max_depth))
        }
        self.total_nodes = self.total_nodes + 1
        self.stack.push(DecodeContainer::{
          kind: kind,
          streamed: true,
          remaining: 0,
          items: [],
          pairs: [],
          pending_key: None,
        })
        self.parse_pos = next_after_line
        continue
      }
      let len64 = match parse_int64_slice(data, line_start, cr, pos) {
        Ok(v) => v
        Err(_) => return self.fail(RespError::InvalidCollectionLength(-1L, pos))
      }
      if prefix == 42 && len64 == -1L {
        frame_opt = Some(RespFrame::NullArray)
        self.parse_pos = next_after_line
      } else if len64 < 0L {
        return self.fail(RespError::InvalidCollectionLength(len64, pos))
      } else if len64 > limits.max_collection_len.to_int64() {
        return self.fail(RespError::MaxCollectionLenExceeded(limits.max_collection_len))
      } else {
        let clen = len64.to_int()
        self.parse_pos = next_after_line
        if clen == 0 {
          if kind == 4 {
            if self.stack.length() >= limits.max_depth {
              return self.fail(RespError::MaxDepthExceeded(limits.max_depth))
            }
            self.total_nodes = self.total_nodes + 1
            self.stack.push(DecodeContainer::{
              kind: 5,
              streamed: false,
              remaining: 1,
              items: [],
              pairs: [],
              pending_key: None,
            })
            continue
          }
          frame_opt = Some(
            if kind == 0 {
              RespFrame::Array([])
            } else if kind == 1 {
              RespFrame::Set([])
            } else if kind == 2 {
              RespFrame::Push([])
            } else {
              RespFrame::Map([])
            },
          )
        } else {
          if self.stack.length() >= limits.max_depth {
            return self.fail(RespError::MaxDepthExceeded(limits.max_depth))
          }
          self.total_nodes = self.total_nodes + 1
          self.stack.push(DecodeContainer::{
            kind: kind,
            streamed: false,
            remaining: clen,
            items: [],
            pairs: [],
            pending_key: None,
          })
          continue
        }
      }
    } else {
      return self.fail(RespError::InvalidPrefix(prefix, pos))
    }

    self.total_nodes = self.total_nodes + 1
    let completed = match frame_opt {
      Some(f) => f
      None => continue
    }
    match unwind_frame(self.stack, completed, limits) {
      Ok(Some(root)) => {
        self.read_pos = self.parse_pos
        self.clear_frame_state()
        return Ok(Some(root))
      }
      Ok(None) => ()
      Err(e) => return self.fail(e)
    }
  }
  Ok(None)
}

///| Decode the next complete frame from the buffer, or `Ok(None)` if more bytes are needed.
pub fn StreamDecoder::next_frame(self : StreamDecoder) -> Result[Option[RespFrame], RespError] {
  match self.step_frame() {
    Ok(Some(frame)) => {
      self.maybe_compact()
      Ok(Some(frame))
    }
    Ok(None) => Ok(None)
    Err(e) => Err(e)
  }
}

///| Drain all currently complete frames from the buffer.
pub fn StreamDecoder::drain_frames(self : StreamDecoder) -> Result[Array[RespFrame], RespError] {
  let out : Array[RespFrame] = []
  while self.read_pos < self.write_pos {
    match self.step_frame() {
      Ok(Some(frame)) => out.push(frame)
      Ok(None) => break
      Err(e) => {
        self.maybe_compact()
        return Err(e)
      }
    }
  }
  self.maybe_compact()
  Ok(out)
}

///| Return the number of unread bytes currently buffered.
pub fn StreamDecoder::buffered_len(self : StreamDecoder) -> Int {
  self.write_pos - self.read_pos
}

///| Return the current backing buffer capacity in bytes.
pub fn StreamDecoder::buffer_capacity(self : StreamDecoder) -> Int {
  self.buf.length()
}

///| Reset the stream decoder, discarding buffered bytes and any sticky error state.
pub fn StreamDecoder::reset(self : StreamDecoder) -> Unit {
  self.read_pos = 0
  self.write_pos = 0
  self.sticky_err = None
  self.clear_frame_state()
  if self.buf.length() > 65536 {
    self.buf = Bytes::new(256)
  }
}
