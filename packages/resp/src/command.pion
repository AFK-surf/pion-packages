///| High-speed Redis command encoder and `PipelineBuilder` (stub for Red phase).

///| Encode a single Redis command (`Array[Bytes]`) as a RESP Array of BulkStrings.
pub fn encode_command(args : Array[Bytes]) -> Bytes {
  let _ = args
  Bytes::new(0)
}

///| Encode a single Redis command (`Array[String]`) as a RESP Array of BulkStrings.
pub fn encode_command_strings(args : Array[String]) -> Bytes {
  let _ = args
  Bytes::new(0)
}

///| Reusable command pipeline encoder writing directly into a growable byte buffer.
pub struct PipelineBuilder {
  mut count : Int
}

///| Create a new `PipelineBuilder`.
pub fn PipelineBuilder::new() -> PipelineBuilder {
  PipelineBuilder::{ count: 0 }
}

///| Create a new `PipelineBuilder` with initial byte capacity hint.
pub fn PipelineBuilder::with_capacity(cap : Int) -> PipelineBuilder {
  let _ = cap
  PipelineBuilder::{ count: 0 }
}

///| Append a binary-safe Redis command to the pipeline.
pub fn PipelineBuilder::push_command(self : PipelineBuilder, args : Array[Bytes]) -> Unit {
  let _ = self
  let _ = args
}

///| Append a UTF-8 string Redis command to the pipeline.
pub fn PipelineBuilder::push_command_strings(self : PipelineBuilder, args : Array[String]) -> Unit {
  let _ = self
  let _ = args
}

///| Append an arbitrary `RespFrame` to the pipeline.
pub fn PipelineBuilder::push_frame(
  self : PipelineBuilder,
  frame : RespFrame,
) -> Result[Unit, RespError] {
  let _ = self
  let _ = frame
  Err(RespError::EncodeError("unimplemented"))
}

///| Number of commands/frames currently queued in the pipeline.
pub fn PipelineBuilder::command_count(self : PipelineBuilder) -> Int {
  self.count
}

///| Number of wire bytes currently queued in the pipeline.
pub fn PipelineBuilder::byte_len(self : PipelineBuilder) -> Int {
  let _ = self
  0
}

///| Return the encoded pipeline bytes.
pub fn PipelineBuilder::finish(self : PipelineBuilder) -> Bytes {
  let _ = self
  Bytes::new(0)
}

///| Reset the pipeline for reuse.
pub fn PipelineBuilder::clear(self : PipelineBuilder) -> Unit {
  self.count = 0
}
