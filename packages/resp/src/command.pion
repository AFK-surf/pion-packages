///| High-speed Redis command encoder and reusable `PipelineBuilder`.

///| Write a RESP command (`Array[Bytes]`) directly into `buf` with a single capacity reservation
///| and hoisted buffer writes.
fn write_command_bytes(buf : ByteBuf, args : Array[Bytes]) -> Unit {
  let n = args.length()
  let mut extra = 16
  let mut i = 0
  while i < n {
    extra = extra + 16 + args[i].length()
    i = i + 1
  }
  buf.reserve(extra)
  let dst = buf.data
  let mut p = buf.len
  dst[p] = (42).to_byte() // '*'
  p = write_uint_ascii_at(dst, p + 1, n)
  dst[p] = (13).to_byte()
  dst[p + 1] = (10).to_byte()
  p = p + 2
  i = 0
  while i < n {
    let arg = args[i]
    let alen = arg.length()
    dst[p] = (36).to_byte() // '$'
    p = write_uint_ascii_at(dst, p + 1, alen)
    dst[p] = (13).to_byte()
    dst[p + 1] = (10).to_byte()
    p = p + 2
    let mut j = 0
    while j + 8 <= alen {
      dst[p] = arg[j]
      dst[p + 1] = arg[j + 1]
      dst[p + 2] = arg[j + 2]
      dst[p + 3] = arg[j + 3]
      dst[p + 4] = arg[j + 4]
      dst[p + 5] = arg[j + 5]
      dst[p + 6] = arg[j + 6]
      dst[p + 7] = arg[j + 7]
      p = p + 8
      j = j + 8
    }
    while j < alen {
      dst[p] = arg[j]
      p = p + 1
      j = j + 1
    }
    dst[p] = (13).to_byte()
    dst[p + 1] = (10).to_byte()
    p = p + 2
    i = i + 1
  }
  buf.len = p
}

///| Write a RESP command (`Array[String]`) directly into `buf` without intermediate `Bytes` allocations.
fn write_command_strings(buf : ByteBuf, args : Array[String]) -> Unit {
  let n = args.length()
  let mut extra = 16
  let mut i = 0
  while i < n {
    extra = extra + 16 + args[i].length()
    i = i + 1
  }
  buf.reserve(extra)
  let dst = buf.data
  let mut p = buf.len
  dst[p] = (42).to_byte() // '*'
  p = write_uint_ascii_at(dst, p + 1, n)
  dst[p] = (13).to_byte()
  dst[p + 1] = (10).to_byte()
  p = p + 2
  i = 0
  while i < n {
    let s = args[i]
    let slen = s.length()
    dst[p] = (36).to_byte() // '$'
    p = write_uint_ascii_at(dst, p + 1, slen)
    dst[p] = (13).to_byte()
    dst[p + 1] = (10).to_byte()
    p = p + 2
    let mut j = 0
    while j < slen {
      dst[p] = s.code_unit_at(j).to_byte()
      p = p + 1
      j = j + 1
    }
    dst[p] = (13).to_byte()
    dst[p + 1] = (10).to_byte()
    p = p + 2
    i = i + 1
  }
  buf.len = p
}

///| Encode a single Redis command (`Array[Bytes]`) as a RESP Array of BulkStrings.
pub fn encode_command(args : Array[Bytes]) -> Bytes {
  let buf = ByteBuf::with_capacity(64)
  write_command_bytes(buf, args)
  buf.to_bytes()
}

///| Encode a single Redis command (`Array[String]`) as a RESP Array of BulkStrings.
pub fn encode_command_strings(args : Array[String]) -> Bytes {
  let buf = ByteBuf::with_capacity(64)
  write_command_strings(buf, args)
  buf.to_bytes()
}

///| Reusable command pipeline encoder writing directly into a growable byte buffer.
pub struct PipelineBuilder {
  buf : ByteBuf
  mut count : Int
}

///| Create a new `PipelineBuilder`.
pub fn PipelineBuilder::new() -> PipelineBuilder {
  PipelineBuilder::{ buf: ByteBuf::with_capacity(256), count: 0 }
}

///| Create a new `PipelineBuilder` with initial byte capacity hint.
pub fn PipelineBuilder::with_capacity(cap : Int) -> PipelineBuilder {
  PipelineBuilder::{ buf: ByteBuf::with_capacity(cap), count: 0 }
}

///| Append a binary-safe Redis command to the pipeline.
pub fn PipelineBuilder::push_command(self : PipelineBuilder, args : Array[Bytes]) -> Unit {
  write_command_bytes(self.buf, args)
  self.count = self.count + 1
}

///| Append a UTF-8 string Redis command to the pipeline.
pub fn PipelineBuilder::push_command_strings(self : PipelineBuilder, args : Array[String]) -> Unit {
  write_command_strings(self.buf, args)
  self.count = self.count + 1
}

///| Append an arbitrary `RespFrame` to the pipeline.
pub fn PipelineBuilder::push_frame(
  self : PipelineBuilder,
  frame : RespFrame,
) -> Result[Unit, RespError] {
  let saved_len = self.buf.len
  match encode_into_buf(self.buf, frame) {
    Ok(_) => {
      self.count = self.count + 1
      Ok(())
    }
    Err(e) => {
      self.buf.len = saved_len
      Err(e)
    }
  }
}

///| Number of commands/frames currently queued in the pipeline.
pub fn PipelineBuilder::command_count(self : PipelineBuilder) -> Int {
  self.count
}

///| Number of wire bytes currently queued in the pipeline.
pub fn PipelineBuilder::byte_len(self : PipelineBuilder) -> Int {
  self.buf.len
}

///| Return the encoded pipeline bytes.
pub fn PipelineBuilder::finish(self : PipelineBuilder) -> Bytes {
  self.buf.to_bytes()
}

///| Reset the pipeline for reuse.
pub fn PipelineBuilder::clear(self : PipelineBuilder) -> Unit {
  self.buf.clear()
  self.count = 0
}
