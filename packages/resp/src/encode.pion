///| Iterative, stack-safe Redis RESP2 & RESP3 wire encoder.

///| Check whether `s` contains CR (`\r`) or LF (`\n`).
fn contains_crlf(s : String) -> Bool {
  let b = s.to_bytes()
  let n = b.length()
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    if c == 13 || c == 10 {
      return true
    }
    i = i + 1
  }
  false
}

///| Validate a RESP3 BigNumber string: optional leading `-` followed by >= 1 ASCII digits.
fn is_valid_bignum_str(s : String) -> Bool {
  let b = s.to_bytes()
  let n = b.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  if b[0].to_int() == 45 {
    if n == 1 {
      return false
    }
    i = 1
  }
  while i < n {
    let c = b[i].to_int()
    if c < 48 || c > 57 {
      return false
    }
    i = i + 1
  }
  true
}

///| Encode a `RespFrame` directly into `buf` using an explicit work stack (0 call-stack recursion).
fn encode_into_buf(buf : ByteBuf, root : RespFrame) -> Result[Unit, RespError] {
  let work : Array[RespFrame] = [root]
  while work.length() > 0 {
    let cur = match work.pop() {
      Some(f) => f
      None => break
    }
    match cur {
      SimpleString(s) => {
        if contains_crlf(s) {
          return Err(RespError::EncodeError("SimpleString must not contain CR or LF"))
        }
        buf.push_byte(43) // '+'
        buf.push_str(s)
        buf.push_crlf()
      }
      SimpleError(s) => {
        if contains_crlf(s) {
          return Err(RespError::EncodeError("SimpleError must not contain CR or LF"))
        }
        buf.push_byte(45) // '-'
        buf.push_str(s)
        buf.push_crlf()
      }
      Integer(v) => {
        buf.push_byte(58) // ':'
        buf.push_int64_ascii(v)
        buf.push_crlf()
      }
      BulkString(b) => {
        buf.push_byte(36) // '$'
        buf.push_uint_ascii(b.length())
        buf.push_crlf()
        buf.push_bytes(b)
        buf.push_crlf()
      }
      Null => {
        buf.push_byte(95) // '_'
        buf.push_crlf()
      }
      NullBulk => {
        buf.push_str("$-1\r\n")
      }
      NullArray => {
        buf.push_str("*-1\r\n")
      }
      Boolean(v) => {
        buf.push_byte(35) // '#'
        buf.push_byte(if v { 116 } else { 102 }) // 't' / 'f'
        buf.push_crlf()
      }
      Double(d) => {
        buf.push_byte(44) // ','
        let bits = d.to_bits()
        if is_double_nan(d) {
          buf.push_str("nan")
        } else if bits == 0x7FF0000000000000L {
          buf.push_str("inf")
        } else if bits == -4503599627370496L {
          buf.push_str("-inf")
        } else {
          buf.push_str(d.to_string())
        }
        buf.push_crlf()
      }
      BigNumber(s) => {
        if !is_valid_bignum_str(s) {
          return Err(RespError::EncodeError("BigNumber must be optional '-' followed by ASCII digits"))
        }
        buf.push_byte(40) // '('
        buf.push_str(s)
        buf.push_crlf()
      }
      BulkError(b) => {
        buf.push_byte(33) // '!'
        buf.push_uint_ascii(b.length())
        buf.push_crlf()
        buf.push_bytes(b)
        buf.push_crlf()
      }
      VerbatimString(enc, payload) => {
        let enc_bytes = enc.to_bytes()
        if enc_bytes.length() != 3 {
          return Err(RespError::EncodeError("VerbatimString encoding tag must be exactly 3 bytes"))
        }
        let mut ei = 0
        while ei < 3 {
          let ec = enc_bytes[ei].to_int()
          if ec == 58 || ec == 13 || ec == 10 {
            return Err(RespError::EncodeError("VerbatimString encoding tag contains invalid byte"))
          }
          ei = ei + 1
        }
        buf.push_byte(61) // '='
        buf.push_uint_ascii(4 + payload.length())
        buf.push_crlf()
        buf.push_bytes(enc_bytes)
        buf.push_byte(58) // ':'
        buf.push_bytes(payload)
        buf.push_crlf()
      }
      Array(items) => {
        let n = items.length()
        buf.push_byte(42) // '*'
        buf.push_uint_ascii(n)
        buf.push_crlf()
        let mut i = n - 1
        while i >= 0 {
          work.push(items[i])
          i = i - 1
        }
      }
      Set(items) => {
        let n = items.length()
        buf.push_byte(126) // '~'
        buf.push_uint_ascii(n)
        buf.push_crlf()
        let mut i = n - 1
        while i >= 0 {
          work.push(items[i])
          i = i - 1
        }
      }
      Push(items) => {
        let n = items.length()
        buf.push_byte(62) // '>'
        buf.push_uint_ascii(n)
        buf.push_crlf()
        let mut i = n - 1
        while i >= 0 {
          work.push(items[i])
          i = i - 1
        }
      }
      Map(pairs) => {
        let n = pairs.length()
        buf.push_byte(37) // '%'
        buf.push_uint_ascii(n)
        buf.push_crlf()
        let mut i = n - 1
        while i >= 0 {
          let (k, v) = pairs[i]
          work.push(v)
          work.push(k)
          i = i - 1
        }
      }
      Attribute(attrs, target) => {
        let n = attrs.length()
        buf.push_byte(124) // '|'
        buf.push_uint_ascii(n)
        buf.push_crlf()
        work.push(target)
        let mut i = n - 1
        while i >= 0 {
          let (k, v) = attrs[i]
          work.push(v)
          work.push(k)
          i = i - 1
        }
      }
    }
  }
  Ok(())
}

///| Encode a `RespFrame` to RESP2/RESP3 wire bytes.
pub fn encode(frame : RespFrame) -> Result[Bytes, RespError] {
  let buf = ByteBuf::with_capacity(64)
  match encode_into_buf(buf, frame) {
    Ok(_) => Ok(buf.to_bytes())
    Err(e) => Err(e)
  }
}
