///| Comprehensive Redis RESP2 & RESP3 specification compliance tests:
///| - All 15 RESP2/RESP3 frame types (SimpleString, SimpleError, Integer, BulkString, Array,
///|   Null + RESP2 NullBulk/NullArray, Boolean, Double incl. inf/-inf/nan, BigNumber,
///|   BulkError, VerbatimString, Map, Set, Attribute attachment, Push)
///| - Streamed chunked BulkString (`$?` + `;len` + `;0`), Array (`*?`), Map (`%?`), Set (`~?`),
///|   and streamed Attribute (`|?`)
///| - Redis Inline commands (plain, double-quoted escapes, single-quoted escapes, errors)
///| - Sans-IO `StreamDecoder`: 1-byte trickle, multi-frame pipelined粘包, compaction (0 memory leak)

///|
fn unwrap_frame(res : Result[RespFrame, RespError]) -> RespFrame {
  match res {
    Ok(f) => f
    Err(e) => {
      debug_assert(false, "expected Ok(RespFrame), got: " + error_message(e))
      RespFrame::Null
    }
  }
}

///|
fn unwrap_bytes(res : Result[Bytes, RespError]) -> Bytes {
  match res {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "expected Ok(Bytes), got: " + error_message(e))
      Bytes::new(0)
    }
  }
}

///|
fn assert_roundtrip(wire : String, expected : RespFrame) -> Unit {
  let raw = wire.to_bytes()
  let decoded = unwrap_frame(decode_default(raw))
  debug_assert(resp_equals(decoded, expected), "decode mismatch for wire: " + wire)
  let reencoded = unwrap_bytes(encode(decoded))
  debug_assert(bytes_equal(reencoded, raw), "re-encode mismatch for wire: " + wire)
}

///|
test "resp2_simple_string_error_integer_null" {
  assert_roundtrip("+OK\r\n", RespFrame::SimpleString("OK"))
  assert_roundtrip("+\r\n", RespFrame::SimpleString(""))
  assert_roundtrip("-ERR unknown command 'foobar'\r\n", RespFrame::SimpleError("ERR unknown command 'foobar'"))
  assert_roundtrip(":0\r\n", RespFrame::Integer(0L))
  assert_roundtrip(":1000\r\n", RespFrame::Integer(1000L))
  assert_roundtrip(":-123456789012345\r\n", RespFrame::Integer(-123456789012345L))
  assert_roundtrip(":9223372036854775807\r\n", RespFrame::Integer(9223372036854775807L))
  assert_roundtrip(":-9223372036854775808\r\n", RespFrame::Integer(-9223372036854775807L - 1L))
  // Leading '+' on Integer is accepted by RESP2/RESP3 spec
  let plus_int = unwrap_frame(decode_default(":+42\r\n".to_bytes()))
  debug_assert(resp_equals(plus_int, RespFrame::Integer(42L)), "leading + integer")

  // RESP3 Null and RESP2 NullBulk / NullArray
  assert_roundtrip("_\r\n", RespFrame::Null)
  assert_roundtrip("$-1\r\n", RespFrame::NullBulk)
  assert_roundtrip("*-1\r\n", RespFrame::NullArray)
  debug_assert(is_null(RespFrame::Null), "Null is_null")
  debug_assert(is_null(RespFrame::NullBulk), "NullBulk is_null")
  debug_assert(is_null(RespFrame::NullArray), "NullArray is_null")
  debug_assert(!is_null(RespFrame::Integer(0L)), "Integer not is_null")
}

///|
test "resp2_bulk_string_binary_and_arrays" {
  assert_roundtrip("$5\r\nhello\r\n", bulk_string("hello"))
  assert_roundtrip("$0\r\n\r\n", bulk_string(""))
  // Binary-safe bulk string containing embedded \r\n and NUL bytes
  let bin = Bytes::new(6)
  bin[0] = (0x00).to_byte()
  bin[1] = (0x0D).to_byte()
  bin[2] = (0x0A).to_byte()
  bin[3] = (0xFF).to_byte()
  bin[4] = (0xFE).to_byte()
  bin[5] = (0x41).to_byte()
  let encoded_bin = unwrap_bytes(encode(RespFrame::BulkString(bin)))
  let decoded_bin = unwrap_frame(decode_default(encoded_bin))
  debug_assert(resp_equals(decoded_bin, RespFrame::BulkString(bin)), "binary bulk string roundtrip")

  // Empty & nested arrays
  assert_roundtrip("*0\r\n", RespFrame::Array([]))
  assert_roundtrip(
    "*2\r\n$5\r\nhello\r\n$5\r\nworld\r\n",
    RespFrame::Array([bulk_string("hello"), bulk_string("world")]),
  )
  assert_roundtrip(
    "*2\r\n*3\r\n:1\r\n:2\r\n:3\r\n*2\r\n+Hello\r\n-World\r\n",
    RespFrame::Array([
      RespFrame::Array([RespFrame::Integer(1L), RespFrame::Integer(2L), RespFrame::Integer(3L)]),
      RespFrame::Array([RespFrame::SimpleString("Hello"), RespFrame::SimpleError("World")]),
    ]),
  )
}

///|
test "resp3_boolean_double_bignumber_bulk_error_verbatim" {
  // Boolean
  assert_roundtrip("#t\r\n", RespFrame::Boolean(true))
  assert_roundtrip("#f\r\n", RespFrame::Boolean(false))

  // Double: normal, negative, exponent, +inf, -inf, nan
  let d1 = unwrap_frame(decode_default(",1.23\r\n".to_bytes()))
  debug_assert(resp_equals(d1, RespFrame::Double(1.23)), "double 1.23")
  let d2 = unwrap_frame(decode_default(",-10.5\r\n".to_bytes()))
  debug_assert(resp_equals(d2, RespFrame::Double(-10.5)), "double -10.5")
  let d3 = unwrap_frame(decode_default(",10\r\n".to_bytes()))
  debug_assert(resp_equals(d3, RespFrame::Double(10.0)), "double 10")
  let d_inf = unwrap_frame(decode_default(",inf\r\n".to_bytes()))
  let pos_inf = Double::from_bits(0x7FF0000000000000L)
  debug_assert(resp_equals(d_inf, RespFrame::Double(pos_inf)), "double inf")
  debug_assert(bytes_equal(unwrap_bytes(encode(d_inf)), ",inf\r\n".to_bytes()), "encode inf")

  let d_ninf = unwrap_frame(decode_default(",-inf\r\n".to_bytes()))
  let neg_inf = Double::from_bits(-4503599627370496L)
  debug_assert(resp_equals(d_ninf, RespFrame::Double(neg_inf)), "double -inf")
  debug_assert(bytes_equal(unwrap_bytes(encode(d_ninf)), ",-inf\r\n".to_bytes()), "encode -inf")

  let d_nan = unwrap_frame(decode_default(",nan\r\n".to_bytes()))
  let nan_v = Double::from_bits(0x7FF8000000000000L)
  debug_assert(resp_equals(d_nan, RespFrame::Double(nan_v)), "double nan")
  debug_assert(bytes_equal(unwrap_bytes(encode(d_nan)), ",nan\r\n".to_bytes()), "encode nan")

  // BigNumber
  assert_roundtrip(
    "(3492890328409238509324850943850943825024385\r\n",
    RespFrame::BigNumber("3492890328409238509324850943850943825024385"),
  )
  assert_roundtrip(
    "(-999999999999999999999999999999999999\r\n",
    RespFrame::BigNumber("-999999999999999999999999999999999999"),
  )

  // BulkError
  assert_roundtrip(
    "!21\r\nSYNTAX invalid syntax\r\n",
    RespFrame::BulkError("SYNTAX invalid syntax".to_bytes()),
  )

  // VerbatimString (length includes 3-byte encoding + ':')
  assert_roundtrip(
    "=15\r\ntxt:Some string\r\n",
    RespFrame::VerbatimString("txt", "Some string".to_bytes()),
  )
  assert_roundtrip(
    "=14\r\nmkd:# Heading\n\r\n",
    RespFrame::VerbatimString("mkd", "# Heading\n".to_bytes()),
  )
}

///|
test "resp3_map_set_push" {
  // Map
  assert_roundtrip(
    "%2\r\n+first\r\n:1\r\n+second\r\n:2\r\n",
    RespFrame::Map([
      (RespFrame::SimpleString("first"), RespFrame::Integer(1L)),
      (RespFrame::SimpleString("second"), RespFrame::Integer(2L)),
    ]),
  )
  assert_roundtrip("%0\r\n", RespFrame::Map([]))

  // Set
  assert_roundtrip(
    "~3\r\n+orange\r\n+apple\r\n#t\r\n",
    RespFrame::Set([
      RespFrame::SimpleString("orange"),
      RespFrame::SimpleString("apple"),
      RespFrame::Boolean(true),
    ]),
  )
  assert_roundtrip("~0\r\n", RespFrame::Set([]))

  // Push
  assert_roundtrip(
    ">3\r\n$7\r\nmessage\r\n$4\r\nnews\r\n$5\r\nhello\r\n",
    RespFrame::Push([bulk_string("message"), bulk_string("news"), bulk_string("hello")]),
  )
}

///|
test "resp3_attributes_attachment" {
  // Official RESP3 spec example: attribute attached to top-level array
  let wire = "|1\r\n+key-popularity\r\n%2\r\n$1\r\na\r\n,0.1923\r\n$1\r\nb\r\n,0.0012\r\n*2\r\n:2039123\r\n:9543892\r\n"
  let expected = RespFrame::Attribute(
    [
      (
        RespFrame::SimpleString("key-popularity"),
        RespFrame::Map([
          (bulk_string("a"), RespFrame::Double(0.1923)),
          (bulk_string("b"), RespFrame::Double(0.0012)),
        ]),
      ),
    ],
    RespFrame::Array([RespFrame::Integer(2039123L), RespFrame::Integer(9543892L)]),
  )
  assert_roundtrip(wire, expected)

  // Attribute attached to an element nested inside an Array
  let nested_wire = "*2\r\n|1\r\n+ttl\r\n:30\r\n$3\r\nval\r\n:99\r\n"
  let expected_nested = RespFrame::Array([
    RespFrame::Attribute(
      [(RespFrame::SimpleString("ttl"), RespFrame::Integer(30L))],
      bulk_string("val"),
    ),
    RespFrame::Integer(99L),
  ])
  assert_roundtrip(nested_wire, expected_nested)

  // Dangling attribute (no target frame) must return Incomplete on EOF
  match decode_default("|1\r\n+k\r\n:1\r\n".to_bytes()) {
    Err(Incomplete) => ()
    _ => debug_assert(false, "attribute without following frame must be Incomplete")
  }
}

///|
test "resp3_streamed_chunked_bulk_array_map_set_attr" {
  // Streamed BulkString: $? + ;len + ;0
  let s_bulk = "$?\r\n;4\r\nHell\r\n;5\r\no Wld\r\n;0\r\n"
  let decoded_bulk = unwrap_frame(decode_default(s_bulk.to_bytes()))
  debug_assert(resp_equals(decoded_bulk, bulk_string("Hello Wld")), "streamed bulk string")

  // Empty streamed BulkString
  let s_empty_bulk = "$?\r\n;0\r\n"
  debug_assert(
    resp_equals(unwrap_frame(decode_default(s_empty_bulk.to_bytes())), bulk_string("")),
    "empty streamed bulk string",
  )

  // Streamed Array: *? ... .
  let s_arr = "*?\r\n:1\r\n:2\r\n:3\r\n.\r\n"
  debug_assert(
    resp_equals(
      unwrap_frame(decode_default(s_arr.to_bytes())),
      RespFrame::Array([RespFrame::Integer(1L), RespFrame::Integer(2L), RespFrame::Integer(3L)]),
    ),
    "streamed array",
  )

  // Streamed Map: %? ... .
  let s_map = "%?\r\n+a\r\n:1\r\n+b\r\n:2\r\n.\r\n"
  debug_assert(
    resp_equals(
      unwrap_frame(decode_default(s_map.to_bytes())),
      RespFrame::Map([
        (RespFrame::SimpleString("a"), RespFrame::Integer(1L)),
        (RespFrame::SimpleString("b"), RespFrame::Integer(2L)),
      ]),
    ),
    "streamed map",
  )

  // Streamed Map with odd number of items must fail with UnexpectedEndMarker
  match decode_default("%?\r\n+a\r\n.\r\n".to_bytes()) {
    Err(UnexpectedEndMarker(_)) => ()
    _ => debug_assert(false, "odd streamed map must fail with UnexpectedEndMarker")
  }

  // Streamed Set: ~? ... .
  let s_set = "~?\r\n+x\r\n+y\r\n.\r\n"
  debug_assert(
    resp_equals(
      unwrap_frame(decode_default(s_set.to_bytes())),
      RespFrame::Set([RespFrame::SimpleString("x"), RespFrame::SimpleString("y")]),
    ),
    "streamed set",
  )

  // Streamed Attribute: |? ... . followed by target frame
  let s_attr = "|?\r\n+meta\r\n:7\r\n.\r\n+OK\r\n"
  debug_assert(
    resp_equals(
      unwrap_frame(decode_default(s_attr.to_bytes())),
      RespFrame::Attribute(
        [(RespFrame::SimpleString("meta"), RespFrame::Integer(7L))],
        RespFrame::SimpleString("OK"),
      ),
    ),
    "streamed attribute",
  )
}

///|
test "redis_inline_commands_quotes_and_escapes" {
  let limits = RespLimits::default()
  // Simple inline
  match decode_inline("PING\r\n".to_bytes(), limits) {
    Ok(args) => {
      debug_assert(args.length() == 1, "PING 1 arg")
      debug_assert(bytes_equal(args[0], "PING".to_bytes()), "PING text")
    }
    Err(e) => debug_assert(false, "PING failed: " + error_message(e))
  }

  // Double quotes with escapes (\n, \r, \t, \x41, \", \\) and single quotes
  let line = "SET \"my key\" \"line1\\nline2\\t\\x41\\\"\\\\\" 'it\\'s ok'\r\n"
  match decode_inline(line.to_bytes(), limits) {
    Ok(args) => {
      debug_assert(args.length() == 4, "inline 4 args")
      debug_assert(bytes_equal(args[0], "SET".to_bytes()), "arg0 SET")
      debug_assert(bytes_equal(args[1], "my key".to_bytes()), "arg1 my key")
      debug_assert(bytes_equal(args[2], "line1\nline2\tA\"\\".to_bytes()), "arg2 escapes")
      debug_assert(bytes_equal(args[3], "it's ok".to_bytes()), "arg3 single quote")
    }
    Err(e) => debug_assert(false, "quoted inline failed: " + error_message(e))
  }

  // Unclosed quote must fail with InvalidInlineQuote
  match decode_inline("SET \"unterminated\r\n".to_bytes(), limits) {
    Err(InvalidInlineQuote(_)) => ()
    _ => debug_assert(false, "unterminated quote must fail")
  }

  // Inline command through StreamDecoder (explicitly opt-in for server-side decoding)
  let dec = StreamDecoder::default()
  dec.set_allow_inline(true)
  match dec.feed("PING\r\nGET foo\r\n".to_bytes()) {
    Ok(_) => ()
    Err(e) => debug_assert(false, error_message(e))
  }
  match dec.drain_frames() {
    Ok(frames) => {
      debug_assert(frames.length() == 2, "2 inline frames")
      debug_assert(resp_equals(frames[0], RespFrame::Array([bulk_string("PING")])), "frame 0 PING")
      debug_assert(
        resp_equals(frames[1], RespFrame::Array([bulk_string("GET"), bulk_string("foo")])),
        "frame 1 GET foo",
      )
    }
    Err(e) => debug_assert(false, error_message(e))
  }
}

///|
test "stream_decoder_1byte_trickle_pipelining_and_compaction" {
  // Multi-frame mixed RESP3 pipeline fed 1 byte at a time
  let stream_str = "+OK\r\n:42\r\n$5\r\nhello\r\n%1\r\n+k\r\n,3.5\r\n|1\r\n+a\r\n#t\r\n>2\r\n+pub\r\n$3\r\nmsg\r\n$?\r\n;2\r\nhi\r\n;0\r\n"
  let stream_bytes = stream_str.to_bytes()
  let dec = StreamDecoder::default()
  let collected : Array[RespFrame] = []

  let mut i = 0
  while i < stream_bytes.length() {
    let one = Bytes::new(1)
    one[0] = stream_bytes[i]
    match dec.feed(one) {
      Ok(_) => ()
      Err(e) => debug_assert(false, "feed 1B failed: " + error_message(e))
    }
    match dec.next_frame() {
      Ok(Some(f)) => collected.push(f)
      Ok(None) => ()
      Err(e) => debug_assert(false, "next_frame 1B failed: " + error_message(e))
    }
    i = i + 1
  }

  debug_assert(collected.length() == 6, "expected 6 frames from 1B trickle")
  debug_assert(dec.buffered_len() == 0, "buffer empty after full stream")
  debug_assert(resp_equals(collected[0], RespFrame::SimpleString("OK")), "f0")
  debug_assert(resp_equals(collected[1], RespFrame::Integer(42L)), "f1")
  debug_assert(resp_equals(collected[2], bulk_string("hello")), "f2")
  debug_assert(
    resp_equals(collected[3], RespFrame::Map([(RespFrame::SimpleString("k"), RespFrame::Double(3.5))])),
    "f3",
  )
  debug_assert(
    resp_equals(
      collected[4],
      RespFrame::Attribute(
        [(RespFrame::SimpleString("a"), RespFrame::Boolean(true))],
        RespFrame::Push([RespFrame::SimpleString("pub"), bulk_string("msg")]),
      ),
    ),
    "f4",
  )
  debug_assert(resp_equals(collected[5], bulk_string("hi")), "f5")

  // Compaction / zero memory leak test: feed 2,000 frames in batches, capacity stays bounded
  let dec2 = StreamDecoder::new(RespLimits::new(64, 4096, 1024, 16384, 10000))
  let chunk = "$16\r\n0123456789abcdef\r\n".to_bytes()
  let mut k = 0
  while k < 2000 {
    match dec2.feed(chunk) {
      Ok(_) => ()
      Err(e) => debug_assert(false, "compaction feed failed at " + k.to_string() + ": " + error_message(e))
    }
    match dec2.next_frame() {
      Ok(Some(_)) => ()
      _ => debug_assert(false, "expected frame at " + k.to_string())
    }
    k = k + 1
  }
  debug_assert(dec2.buffered_len() == 0, "buffered_len == 0 after 2000 frames")
  debug_assert(dec2.buffer_capacity() <= 16384, "buffer capacity must remain bounded (no memory leak)")
}
