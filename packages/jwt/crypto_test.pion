///| FIPS 180-4 SHA-256 / SHA-384 / SHA-512 official & block-boundary vectors,
///| RFC 4231 HMAC-SHA256 / HMAC-SHA384 / HMAC-SHA512 all 7 official test cases,
///| and constant-time equality tests.

///|
fn ascii_bytes(s : String) -> Bytes {
  s.to_bytes()
}

///|
fn repeat_b(b : Int, n : Int) -> Bytes {
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = b.to_byte()
    i = i + 1
  }
  out
}

///|
fn hex_to_bytes(hex : String) -> Bytes {
  let n = hex.length() / 2
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nibble(hex.code_unit_at(i * 2))
    let lo = hex_nibble(hex.code_unit_at(i * 2 + 1))
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    0
  }
}

///|
fn bytes_to_hex(b : Bytes) -> String {
  let digits = "0123456789abcdef"
  let n = b.length()
  let mut out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = b[i].to_int()
    out[i * 2] = digits.code_unit_at((v >> 4) & 0xF).to_byte()
    out[i * 2 + 1] = digits.code_unit_at(v & 0xF).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
test "sha256_fips180_4_and_boundaries" {
  debug_assert(
    bytes_to_hex(sha256(ascii_bytes(""))) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "sha256 empty",
  )
  debug_assert(
    bytes_to_hex(sha256(ascii_bytes("abc"))) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    "sha256 abc",
  )
  debug_assert(
    bytes_to_hex(
      sha256(
        ascii_bytes(
          "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
        ),
      ),
    ) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
    "sha256 448bit",
  )
  debug_assert(
    bytes_to_hex(
      sha256(
        ascii_bytes(
          "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
        ),
      ),
    ) == "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1",
    "sha256 896bit",
  )
  debug_assert(
    bytes_to_hex(sha256(repeat_b(97, 55))) == "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318",
    "sha256 55B",
  )
  debug_assert(
    bytes_to_hex(sha256(repeat_b(97, 56))) == "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a",
    "sha256 56B",
  )
  debug_assert(
    bytes_to_hex(sha256(repeat_b(97, 64))) == "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb",
    "sha256 64B",
  )
  debug_assert(
    bytes_to_hex(sha256(repeat_b(97, 111))) == "6374f73208854473827f6f6a3f43b1f53eaa3b82c21c1a6d69a2110b2a79baad",
    "sha256 111B",
  )
  debug_assert(
    bytes_to_hex(sha256(repeat_b(97, 112))) == "f54353008a2553262ecdc4a34749563ba0950e8b0fc8652780b0a614b99683c1",
    "sha256 112B",
  )
  debug_assert(
    bytes_to_hex(sha256(repeat_b(97, 128))) == "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e",
    "sha256 128B",
  )
  debug_assert(
    bytes_to_hex(sha256(repeat_b(97, 1048576))) == "9bc1b2a288b26af7257a36277ae3816a7d4f16e89c1e7e77d0a5c48bad62b360",
    "sha256 1MiB",
  )
}

///|
test "sha384_fips180_4_and_boundaries" {
  debug_assert(
    bytes_to_hex(sha384(ascii_bytes(""))) == "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b",
    "sha384 empty",
  )
  debug_assert(
    bytes_to_hex(sha384(ascii_bytes("abc"))) == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7",
    "sha384 abc",
  )
  debug_assert(
    bytes_to_hex(
      sha384(
        ascii_bytes(
          "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
        ),
      ),
    ) == "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039",
    "sha384 896bit",
  )
  debug_assert(
    bytes_to_hex(sha384(repeat_b(97, 55))) == "5d91ac7e74e62b5c728904b40f10784d66b7af9cb6302123e48c92f0432ceb8d2a92c02de77dcb29ed75c4b42bde46f4",
    "sha384 55B",
  )
  debug_assert(
    bytes_to_hex(sha384(repeat_b(97, 56))) == "8a8d9649ea04e993a6ca7135af7e3392cc5fca84f8531cac7aa3feed4eb98f55dcbe0f3284b61c6f35f98b02cc644b4c",
    "sha384 56B",
  )
  debug_assert(
    bytes_to_hex(sha384(repeat_b(97, 64))) == "2e404b9339da795776e510d96930b3be2904c500395b8cb7413334b82d4dec413b4b8113045a05bbbcff846f027423f6",
    "sha384 64B",
  )
  debug_assert(
    bytes_to_hex(sha384(repeat_b(97, 111))) == "3c37955051cb5c3026f94d551d5b5e2ac38d572ae4e07172085fed81f8466b8f90dc23a8ffcdea0b8d8e58e8fdacc80a",
    "sha384 111B",
  )
  debug_assert(
    bytes_to_hex(sha384(repeat_b(97, 112))) == "187d4e07cb306103c69967bf544d0dfbe9042577599c73c330abc0cb64c61236d5ed565ee19119d8c31779a38f791fcd",
    "sha384 112B",
  )
  debug_assert(
    bytes_to_hex(sha384(repeat_b(97, 128))) == "edb12730a366098b3b2beac75a3bef1b0969b15c48e2163c23d96994f8d1bef760c7e27f3c464d3829f56c0d53808b0b",
    "sha384 128B",
  )
  debug_assert(
    bytes_to_hex(sha384(repeat_b(97, 1048576))) == "ca5f19365048f25575c940a3c32a60cef4b9c9f46588d364845df15d6d92ebb4b9abe7ea3d65a381f4079c06deac8c2d",
    "sha384 1MiB",
  )
}

///|
test "sha512_fips180_4_and_boundaries" {
  debug_assert(
    bytes_to_hex(sha512(ascii_bytes(""))) == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e",
    "sha512 empty",
  )
  debug_assert(
    bytes_to_hex(sha512(ascii_bytes("abc"))) == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
    "sha512 abc",
  )
  debug_assert(
    bytes_to_hex(
      sha512(
        ascii_bytes(
          "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
        ),
      ),
    ) == "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909",
    "sha512 896bit",
  )
  debug_assert(
    bytes_to_hex(sha512(repeat_b(97, 55))) == "b0220c772cbf6c1822e2cb38a437d0e1d58772417a4bbb21c961364f8b6143e05aa6316dca8d1d7b19e16448419076395f6086cb55101fbd6d5497b148e1745f",
    "sha512 55B",
  )
  debug_assert(
    bytes_to_hex(sha512(repeat_b(97, 56))) == "962b64aae357d2a4fee3ded8b539bdc9d325081822b0bfc55583133aab44f18bafe11d72a7ae16c79ce2ba620ae2242d5144809161945f1367f41b3972e26e04",
    "sha512 56B",
  )
  debug_assert(
    bytes_to_hex(sha512(repeat_b(97, 64))) == "01d35c10c6c38c2dcf48f7eebb3235fb5ad74a65ec4cd016e2354c637a8fb49b695ef3c1d6f7ae4cd74d78cc9c9bcac9d4f23a73019998a7f73038a5c9b2dbde",
    "sha512 64B",
  )
  debug_assert(
    bytes_to_hex(sha512(repeat_b(97, 111))) == "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2",
    "sha512 111B",
  )
  debug_assert(
    bytes_to_hex(sha512(repeat_b(97, 112))) == "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca",
    "sha512 112B",
  )
  debug_assert(
    bytes_to_hex(sha512(repeat_b(97, 128))) == "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321",
    "sha512 128B",
  )
  debug_assert(
    bytes_to_hex(sha512(repeat_b(97, 1048576))) == "f083039442f4a8cee2985641fa49cada4ca54d9bf3de03f9ef9f1f726dbb655d2a844aa1014e54fd239a5b3f37ae46d64744fee51ab2d7f5fe9b209e90b5ad52",
    "sha512 1MiB",
  )
}

///|
test "hmac_rfc4231_all_7_vectors" {
  // TC 1
  let k1 = repeat_b(0x0b, 20)
  let d1 = ascii_bytes("Hi There")
  debug_assert(
    bytes_to_hex(hmac_sha256(k1, d1)) == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
    "rfc4231 tc1 hs256",
  )
  debug_assert(
    bytes_to_hex(hmac_sha384(k1, d1)) == "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6",
    "rfc4231 tc1 hs384",
  )
  debug_assert(
    bytes_to_hex(hmac_sha512(k1, d1)) == "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854",
    "rfc4231 tc1 hs512",
  )

  // TC 2
  let k2 = ascii_bytes("Jefe")
  let d2 = ascii_bytes("what do ya want for nothing?")
  debug_assert(
    bytes_to_hex(hmac_sha256(k2, d2)) == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",
    "rfc4231 tc2 hs256",
  )
  debug_assert(
    bytes_to_hex(hmac_sha384(k2, d2)) == "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649",
    "rfc4231 tc2 hs384",
  )
  debug_assert(
    bytes_to_hex(hmac_sha512(k2, d2)) == "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737",
    "rfc4231 tc2 hs512",
  )

  // TC 3
  let k3 = repeat_b(0xaa, 20)
  let d3 = repeat_b(0xdd, 50)
  debug_assert(
    bytes_to_hex(hmac_sha256(k3, d3)) == "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe",
    "rfc4231 tc3 hs256",
  )
  debug_assert(
    bytes_to_hex(hmac_sha384(k3, d3)) == "88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27",
    "rfc4231 tc3 hs384",
  )
  debug_assert(
    bytes_to_hex(hmac_sha512(k3, d3)) == "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb",
    "rfc4231 tc3 hs512",
  )

  // TC 4
  let k4 = hex_to_bytes("0102030405060708090a0b0c0d0e0f10111213141516171819")
  let d4 = repeat_b(0xcd, 50)
  debug_assert(
    bytes_to_hex(hmac_sha256(k4, d4)) == "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b",
    "rfc4231 tc4 hs256",
  )
  debug_assert(
    bytes_to_hex(hmac_sha384(k4, d4)) == "3e8a69b7783c25851933ab6290af6ca77a9981480850009cc5577c6e1f573b4e6801dd23c4a7d679ccf8a386c674cffb",
    "rfc4231 tc4 hs384",
  )
  debug_assert(
    bytes_to_hex(hmac_sha512(k4, d4)) == "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd",
    "rfc4231 tc4 hs512",
  )

  // TC 5
  let k5 = repeat_b(0x0c, 20)
  let d5 = ascii_bytes("Test With Truncation")
  debug_assert(
    bytes_to_hex(hmac_sha256(k5, d5)) == "a3b6167473100ee06e0c796c2955552bfa6f7c0a6a8aef8b93f860aab0cd20c5",
    "rfc4231 tc5 hs256",
  )
  debug_assert(
    bytes_to_hex(hmac_sha384(k5, d5)) == "3abf34c3503b2a23a46efc619baef897f4c8e42c934ce55ccbae9740fcbc1af4ca62269e2a37cd88ba926341efe4aeea",
    "rfc4231 tc5 hs384",
  )
  debug_assert(
    bytes_to_hex(hmac_sha512(k5, d5)) == "415fad6271580a531d4179bc891d87a650188707922a4fbb36663a1eb16da008711c5b50ddd0fc235084eb9d3364a1454fb2ef67cd1d29fe6773068ea266e96b",
    "rfc4231 tc5 hs512",
  )

  // TC 6 (131-byte key > 64B and > 128B block size!)
  let k6 = repeat_b(0xaa, 131)
  let d6 = ascii_bytes("Test Using Larger Than Block-Size Key - Hash Key First")
  debug_assert(
    bytes_to_hex(hmac_sha256(k6, d6)) == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54",
    "rfc4231 tc6 hs256",
  )
  debug_assert(
    bytes_to_hex(hmac_sha384(k6, d6)) == "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952",
    "rfc4231 tc6 hs384",
  )
  debug_assert(
    bytes_to_hex(hmac_sha512(k6, d6)) == "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598",
    "rfc4231 tc6 hs512",
  )

  // TC 7 (131-byte key + multi-block data)
  let k7 = repeat_b(0xaa, 131)
  let d7 = ascii_bytes(
    "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.",
  )
  debug_assert(
    bytes_to_hex(hmac_sha256(k7, d7)) == "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2",
    "rfc4231 tc7 hs256",
  )
  debug_assert(
    bytes_to_hex(hmac_sha384(k7, d7)) == "6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e",
    "rfc4231 tc7 hs384",
  )
  debug_assert(
    bytes_to_hex(hmac_sha512(k7, d7)) == "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58",
    "rfc4231 tc7 hs512",
  )
}

///|
test "constant_time_eq_properties" {
  debug_assert(constant_time_eq(Bytes::new(0), Bytes::new(0)), "empty equal")
  debug_assert(
    constant_time_eq(ascii_bytes("abcdef"), ascii_bytes("abcdef")),
    "equal",
  )
  debug_assert(
    !constant_time_eq(ascii_bytes("abcdef"), ascii_bytes("abcdeg")),
    "last byte diff",
  )
  debug_assert(
    !constant_time_eq(ascii_bytes("abcdef"), ascii_bytes("bbcdef")),
    "first byte diff",
  )
  debug_assert(
    !constant_time_eq(ascii_bytes("abcdef"), ascii_bytes("abcde")),
    "len diff",
  )
}
