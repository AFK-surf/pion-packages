///| RFC 7515 Appendix A.1, RFC 7519 JWT/Validation, RFC 7517 JWK,
///| and extensible Signer/Verifier compliance tests.

///|
fn opt_str_is(opt : Option[String], expected : String) -> Bool {
  match opt {
    Some(s) => s == expected
    None => false
  }
}

///|
fn opt_i64_is(opt : Option[Int64], expected : Int64) -> Bool {
  match opt {
    Some(v) => v == expected
    None => false
  }
}

///|
test "rfc7515_appendix_a1_hs256_official_vector" {
  // Official JWK from RFC 7515 Appendix A.1.1
  let jwk_json = "{\"kty\":\"oct\",\"k\":\"AyM1SysPpbyDfgZld3umj1qzKObwVMkoqQ-EstJQLr_T-1qS0gZH75aKtMN3Yj0iPS4hcgUuTwjAzZr1Z9CAow\"}"
  let key = match Jwk::from_json(jwk_json) {
    Ok(jwk) => match Jwk::to_secret_bytes(jwk) {
      Ok(k) => k
      Err(_) => {
        debug_assert(false, "jwk to_secret_bytes failed")
        Bytes::new(0)
      }
    }
    Err(_) => {
      debug_assert(false, "jwk from_json failed")
      Bytes::new(0)
    }
  }
  debug_assert(key.length() == 64, "rfc7515 key length 64")

  // Official compact JWS from RFC 7515 Appendix A.1.2
  let token = "eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ.dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"

  // Header preview
  match decode_header(token) {
    Ok(hdr) => {
      debug_assert(algorithm_equals(hdr.alg, Algorithm::HS256), "hdr alg HS256")
      debug_assert(opt_str_is(hdr.typ, "JWT"), "hdr typ JWT")
    }
    Err(_) => debug_assert(false, "decode_header failed")
  }

  // Decode with now_unix before exp (1300819380)
  let base_v = Validation::new(Algorithm::HS256)
  let validation = Validation::{
    algorithms: base_v.algorithms,
    leeway: 0L,
    validate_exp: true,
    validate_nbf: true,
    required_spec_claims: ["iss", "exp"],
    iss: Some(["joe"]),
    aud: None,
    sub: None,
    max_token_bytes: base_v.max_token_bytes,
    max_json_depth: base_v.max_json_depth,
  }
  match decode(token, key, validation, 1300819300L) {
    Ok(td) => {
      debug_assert(algorithm_equals(td.header.alg, Algorithm::HS256), "td alg")
      debug_assert(opt_str_is(td.claims.iss, "joe"), "td iss")
      debug_assert(opt_i64_is(td.claims.exp, 1300819380L), "td exp")
      match td.claims.custom.get("http://example.com/is_root") {
        Some(JsonValue::Bool(true)) => ()
        _ => debug_assert(false, "custom is_root claim")
      }
    }
    Err(_) => debug_assert(false, "rfc7515 decode failed")
  }

  // Expired at now_unix == exp
  match decode(token, key, validation, 1300819380L) {
    Err(JwtError::ExpiredSignature) => ()
    _ => debug_assert(false, "must expire at now == exp")
  }
}

///|
test "jwt_hs256_hs384_hs512_roundtrip" {
  let key = "super-secret-symmetric-key-for-testing-jwt-0123456789".to_bytes()
  let custom : Map[String, JsonValue] = Map::new()
  custom.set("role", JsonValue::Str("admin"))
  custom.set("level", JsonValue::Int(42L))
  custom.set("active", JsonValue::Bool(true))

  let claims = Claims::{
    iss: Some("https://auth.example.com"),
    sub: Some("user-123"),
    aud: Some(Audience::Many(["api", "web"])),
    exp: Some(2000000000L),
    nbf: Some(1999990000L),
    iat: Some(1999990000L),
    jti: Some("tok-001"),
    custom: custom,
  }

  let algs = [Algorithm::HS256, Algorithm::HS384, Algorithm::HS512]
  let mut i = 0
  while i < algs.length() {
    let alg = algs[i]
    let hdr = Header::{
      alg: alg,
      typ: Some("JWT"),
      kid: Some("key-2026"),
      cty: Some("application/json"),
      crit: None,
      extra: Map::new(),
    }
    let token = match encode(hdr, claims, key) {
      Ok(t) => t
      Err(_) => {
        debug_assert(false, "encode failed")
        ""
      }
    }
    let validation = Validation::{
      algorithms: [alg],
      leeway: 0L,
      validate_exp: true,
      validate_nbf: true,
      required_spec_claims: ["iss", "sub", "aud", "exp", "nbf", "iat", "jti"],
      iss: Some(["https://auth.example.com"]),
      aud: Some(["web"]),
      sub: Some("user-123"),
      max_token_bytes: 16384,
      max_json_depth: 32,
    }
    match decode(token, key, validation, 1999995000L) {
      Ok(td) => {
        debug_assert(algorithm_equals(td.header.alg, alg), "alg match")
        debug_assert(opt_str_is(td.header.kid, "key-2026"), "kid match")
        debug_assert(opt_str_is(td.header.cty, "application/json"), "cty match")
        debug_assert(opt_str_is(td.claims.sub, "user-123"), "sub match")
        debug_assert(opt_str_is(td.claims.jti, "tok-001"), "jti match")
        match td.claims.custom.get("role") {
          Some(JsonValue::Str("admin")) => ()
          _ => debug_assert(false, "custom role")
        }
        match td.claims.custom.get("level") {
          Some(JsonValue::Int(lv)) => debug_assert(lv == 42L, "custom level")
          _ => debug_assert(false, "custom level")
        }
      }
      Err(_) => debug_assert(false, "roundtrip decode failed")
    }
    i = i + 1
  }
}

///|
test "jwt_validation_leeway_and_claims" {
  let key = "leeway-secret".to_bytes()
  let claims = Claims::{
    iss: Some("issuer-a"),
    sub: Some("alice"),
    aud: Some(Audience::Single("svc-1")),
    exp: Some(1000L),
    nbf: Some(500L),
    iat: Some(500L),
    jti: None,
    custom: Map::new(),
  }
  let token = match encode(Header::new(Algorithm::HS256), claims, key) {
    Ok(t) => t
    Err(_) => {
      debug_assert(false, "encode failed")
      ""
    }
  }

  // With leeway 60: valid at 440..1059, invalid at 439 and 1060
  let v_leeway = Validation::{
    algorithms: [Algorithm::HS256],
    leeway: 60L,
    validate_exp: true,
    validate_nbf: true,
    required_spec_claims: [],
    iss: None,
    aud: None,
    sub: None,
    max_token_bytes: 16384,
    max_json_depth: 32,
  }
  match decode(token, key, v_leeway, 439L) {
    Err(JwtError::ImmatureSignature) => ()
    _ => debug_assert(false, "must be immature at 439")
  }
  match decode(token, key, v_leeway, 440L) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "must be valid at 440 with leeway 60")
  }
  match decode(token, key, v_leeway, 1059L) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "must be valid at 1059 with leeway 60")
  }
  match decode(token, key, v_leeway, 1060L) {
    Err(JwtError::ExpiredSignature) => ()
    _ => debug_assert(false, "must be expired at 1060 with leeway 60")
  }

  // Wrong issuer / audience / subject / missing required claim
  let v_bad_iss = Validation::{
    algorithms: [Algorithm::HS256],
    leeway: 0L,
    validate_exp: false,
    validate_nbf: false,
    required_spec_claims: [],
    iss: Some(["issuer-b"]),
    aud: None,
    sub: None,
    max_token_bytes: 16384,
    max_json_depth: 32,
  }
  match decode(token, key, v_bad_iss, 700L) {
    Err(JwtError::InvalidIssuer) => ()
    _ => debug_assert(false, "must reject wrong iss")
  }

  let v_bad_aud = Validation::{
    algorithms: [Algorithm::HS256],
    leeway: 0L,
    validate_exp: false,
    validate_nbf: false,
    required_spec_claims: [],
    iss: None,
    aud: Some(["svc-2"]),
    sub: None,
    max_token_bytes: 16384,
    max_json_depth: 32,
  }
  match decode(token, key, v_bad_aud, 700L) {
    Err(JwtError::InvalidAudience) => ()
    _ => debug_assert(false, "must reject wrong aud")
  }

  let v_bad_sub = Validation::{
    algorithms: [Algorithm::HS256],
    leeway: 0L,
    validate_exp: false,
    validate_nbf: false,
    required_spec_claims: [],
    iss: None,
    aud: None,
    sub: Some("bob"),
    max_token_bytes: 16384,
    max_json_depth: 32,
  }
  match decode(token, key, v_bad_sub, 700L) {
    Err(JwtError::InvalidSubject) => ()
    _ => debug_assert(false, "must reject wrong sub")
  }

  let v_req_jti = Validation::{
    algorithms: [Algorithm::HS256],
    leeway: 0L,
    validate_exp: false,
    validate_nbf: false,
    required_spec_claims: ["jti"],
    iss: None,
    aud: None,
    sub: None,
    max_token_bytes: 16384,
    max_json_depth: 32,
  }
  match decode(token, key, v_req_jti, 700L) {
    Err(JwtError::MissingRequiredClaim(_)) => ()
    _ => debug_assert(false, "must reject missing jti")
  }
}

///|
test "jwk_oct_roundtrip_and_signer_verifier" {
  let raw_key = "0123456789abcdef0123456789abcdef".to_bytes()
  let jwk = Jwk::from_oct_key(
    raw_key,
    Some("k-1"),
    Some(Algorithm::HS256),
    Some("sig"),
  )
  let js = Jwk::to_json(jwk)
  match Jwk::from_json(js) {
    Ok(parsed) => {
      debug_assert(parsed.kty == "oct", "kty oct")
      debug_assert(opt_str_is(parsed.kid, "k-1"), "kid k-1")
      debug_assert(opt_str_is(parsed.alg, "HS256"), "alg HS256")
      debug_assert(opt_str_is(parsed.key_use, "sig"), "use sig")
      debug_assert(constant_time_eq(parsed.k, raw_key), "k bytes match")
    }
    Err(_) => debug_assert(false, "jwk roundtrip failed")
  }

  // Signer / Verifier extensible interface
  let signer = Signer::hmac(Algorithm::HS256, raw_key)
  let verifier = Verifier::hmac(Algorithm::HS256, raw_key)
  let claims = Claims::{
    iss: Some("custom-signer"),
    sub: Some("s1"),
    aud: None,
    exp: Some(5000L),
    nbf: None,
    iat: None,
    jti: None,
    custom: Map::new(),
  }
  let tok = match encode_with_signer(Header::new(Algorithm::HS256), claims, signer) {
    Ok(t) => t
    Err(_) => {
      debug_assert(false, "encode_with_signer failed")
      ""
    }
  }
  match decode_with_verifier(tok, verifier, Validation::new(Algorithm::HS256), 1000L) {
    Ok(td) => debug_assert(opt_str_is(td.claims.iss, "custom-signer"), "verifier ok")
    Err(_) => debug_assert(false, "decode_with_verifier failed")
  }
}
