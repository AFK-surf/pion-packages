///| Shared helpers for the `packages/jwt` red-team suite.

import "jwt"

///|
let now : Int64 = 1795400000L

///|
let fut : Int64 = 4000000000L

///|
let audit_key : String = "red-team-audit-secret-key-0123456789abcdef"

///|
fn key() -> Bytes {
  audit_key.to_bytes()
}

///|
fn bytes_of(vals : Array[Int]) -> Bytes {
  let b = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn cat(parts : Array[Bytes]) -> Bytes {
  let mut n = 0
  let mut i = 0
  while i < parts.length() {
    n = n + parts[i].length()
    i = i + 1
  }
  let out = Bytes::new(n)
  let mut off = 0
  i = 0
  while i < parts.length() {
    let p = parts[i]
    let mut j = 0
    while j < p.length() {
      out[off + j] = p[j]
      j = j + 1
    }
    off = off + p.length()
    i = i + 1
  }
  out
}

///|
fn repeat_byte(v : Int, n : Int) -> Bytes {
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = v.to_byte()
    i = i + 1
  }
  b
}

///| HS256-sign arbitrary raw header / payload bytes (bypasses Pion's serializer).
fn tok_raw(hdr : Bytes, pay : Bytes, k : Bytes) -> String {
  let si = jwt::base64url_encode(hdr) + "." + jwt::base64url_encode(pay)
  si + "." + jwt::base64url_encode(jwt::hmac_sha256(k, si.to_bytes()))
}

///|
fn tok(pay_json : String) -> String {
  tok_raw("{\"alg\":\"HS256\",\"typ\":\"JWT\"}".to_bytes(), pay_json.to_bytes(), key())
}

///|
fn tok_hdr(hdr_json : String, pay_json : String) -> String {
  tok_raw(hdr_json.to_bytes(), pay_json.to_bytes(), key())
}

///|
fn v256() -> jwt::Validation {
  jwt::Validation::new(jwt::Algorithm::HS256)
}

///|
fn accepts(token : String) -> Bool {
  match jwt::decode(token, key(), v256(), now) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn rejects(token : String) -> Bool {
  !accepts(token)
}

///|
fn sub_of(token : String) -> String {
  match jwt::decode(token, key(), v256(), now) {
    Ok(td) =>
    match td.claims.sub {
      Some(s) => s
      None => "<none>"
    }
    Err(_) => "<err>"
  }
}

///|
fn nested_arrays(n : Int) -> Bytes {
  let b = Bytes::new(2 * n)
  let mut i = 0
  while i < n {
    b[i] = (91).to_byte()
    b[2 * n - 1 - i] = (93).to_byte()
    i = i + 1
  }
  b
}

///|
fn claims_with(
  sub : Option[String],
  aud : Option[jwt::Audience],
  exp : Option[Int64],
  custom : Map[String, jwt::JsonValue],
) -> jwt::Claims {
  jwt::Claims::{
    iss: None,
    sub: sub,
    aud: aud,
    exp: exp,
    nbf: None,
    iat: None,
    jti: None,
    custom: custom,
  }
}
