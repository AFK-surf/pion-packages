///| Red-team CONTROLS for `packages/jwt`: attack surface that was probed and found
///| sound. Every `control_*` test is expected to PASS; a failure here is a regression.

import "jwt"

// ---------------------------------------------------------------------------
// Unicode-escape duplicate-key smuggling (the bitmask fast path vs escaped keys)
// ---------------------------------------------------------------------------

///|
test "control_escaped_duplicate_standard_claims_rejected" {
  let cases = [
    "{\"sub\":\"guest\",\"\\u0073ub\":\"admin\",\"exp\":4000000000}",
    "{\"\\u0073ub\":\"admin\",\"sub\":\"guest\",\"exp\":4000000000}",
    "{\"sub\":\"guest\",\"\\u0073\\u0075\\u0062\":\"admin\",\"exp\":4000000000}",
    "{\"sub\":\"guest\",\"\\u0053ub\":\"admin\",\"exp\":4000000000}", // "Sub" is a different key: control below
    "{\"exp\":4000000000,\"\\u0065xp\":1}",
    "{\"\\u0065xp\":1,\"exp\":4000000000}",
    "{\"exp\":4000000000,\"e\\u0078p\":1}",
    "{\"nbf\":1,\"\\u006ebf\":4000000000,\"exp\":4000000000}",
    "{\"aud\":\"a\",\"\\u0061ud\":\"b\",\"exp\":4000000000}",
    "{\"iss\":\"a\",\"\\u0069ss\":\"b\",\"exp\":4000000000}",
    "{\"iat\":1,\"\\u0069at\":2,\"exp\":4000000000}",
    "{\"jti\":\"a\",\"\\u006ati\":\"b\",\"exp\":4000000000}",
    "{\"sub\":\"guest\",\"sub\":\"admin\",\"exp\":4000000000}",
    "{\"role\":\"user\",\"\\u0072ole\":\"admin\",\"exp\":4000000000}",
    "{\"x\":{\"a\":1,\"\\u0061\":2},\"exp\":4000000000}",
    "{\"a/b\":1,\"a\\/b\":2,\"exp\":4000000000}",
    "{\"\\ud83d\\ude00\":1,\"😀\":2,\"exp\":4000000000}",
  ]
  let mut i = 0
  while i < cases.length() {
    let t = tok(cases[i])
    if i == 3 {
      // \u0053 is 'S': "Sub" is a custom claim, sub stays "guest"
      debug_assert(sub_of(t) == "guest", "Sub must not override sub")
    } else {
      debug_assert(rejects(t), "duplicate-key smuggling accepted: " + cases[i])
    }
    i = i + 1
  }
}

///|
test "control_escaped_duplicate_header_members_rejected" {
  let pay = "{\"sub\":\"a\",\"exp\":4000000000}"
  let hdrs = [
    "{\"alg\":\"HS256\",\"\\u0061lg\":\"HS512\"}",
    "{\"\\u0061lg\":\"HS512\",\"alg\":\"HS256\"}",
    "{\"alg\":\"HS256\",\"alg\":\"HS256\"}",
    "{\"alg\":\"HS256\",\"kid\":\"a\",\"\\u006bid\":\"b\"}",
    "{\"alg\":\"HS256\",\"typ\":\"JWT\",\"\\u0074yp\":\"x\"}",
    "{\"alg\":\"HS256\",\"cty\":\"a\",\"\\u0063ty\":\"b\"}",
    "{\"alg\":\"HS256\",\"x5u\":\"a\",\"\\u0078\\u0035\\u0075\":\"b\"}",
    "{\"alg\":\"HS256\",\"\\u0063rit\":[\"exp\"]}",
  ]
  let mut i = 0
  while i < hdrs.length() {
    debug_assert(rejects(tok_hdr(hdrs[i], pay)), "header smuggling accepted: " + hdrs[i])
    i = i + 1
  }
  // Escaped spelling of a single alg member is legal JSON and must still work.
  debug_assert(accepts(tok_hdr("{\"\\u0061lg\":\"\\u0048S256\"}", pay)), "escaped alg rejected")
}

// ---------------------------------------------------------------------------
// alg / crit / header shape
// ---------------------------------------------------------------------------

///|
test "control_alg_none_and_malformed_alg_rejected" {
  let pay = "{\"sub\":\"admin\",\"exp\":4000000000}"
  let p64 = jwt::base64url_encode(pay.to_bytes())
  let nones = ["none", "None", "NONE", "nOnE"]
  let mut i = 0
  while i < nones.length() {
    let h64 = jwt::base64url_encode(("{\"alg\":\"" + nones[i] + "\"}").to_bytes())
    debug_assert(rejects(h64 + "." + p64 + "."), "alg=" + nones[i] + " with empty sig accepted")
    debug_assert(rejects(tok_hdr("{\"alg\":\"" + nones[i] + "\"}", pay)), "alg=" + nones[i] + " accepted")
    i = i + 1
  }
  let bad = [
    "{\"typ\":\"JWT\"}", "{\"alg\":256}", "{\"alg\":null}", "{\"alg\":[\"HS256\"]}", "{\"alg\":\"hs256\"}",
    "{\"alg\":\"HS256 \"}", "{\"alg\":\"HS256\\u0000\"}", "{\"alg\":\"RS256\"}", "{}", "[]", "\"HS256\"", "{\"alg\":\"HS512\"}",
  ]
  let mut j = 0
  while j < bad.length() {
    debug_assert(rejects(tok_hdr(bad[j], pay)), "malformed/foreign alg accepted: " + bad[j])
    j = j + 1
  }
}

///|
test "control_crit_rejected_in_all_shapes" {
  let pay = "{\"sub\":\"a\",\"exp\":4000000000}"
  let crits = [
    "{\"alg\":\"HS256\",\"crit\":[]}", "{\"alg\":\"HS256\",\"crit\":[\"exp\"]}", "{\"alg\":\"HS256\",\"crit\":[\"alg\"]}",
    "{\"alg\":\"HS256\",\"crit\":[\"foo\"],\"foo\":1}", "{\"alg\":\"HS256\",\"crit\":\"exp\"}", "{\"alg\":\"HS256\",\"crit\":null}",
    "{\"alg\":\"HS256\",\"crit\":[1]}",
  ]
  let mut i = 0
  while i < crits.length() {
    debug_assert(rejects(tok_hdr(crits[i], pay)), "crit accepted: " + crits[i])
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// RFC 8259 strictness
// ---------------------------------------------------------------------------

///|
test "control_json_strictness" {
  let bad = [
    "{\"sub\":\"a\",\"exp\":4000000000,}", "{\"aud\":[\"a\",],\"exp\":4000000000}", "{\"x\":01,\"exp\":4000000000}",
    "{\"x\":-01,\"exp\":4000000000}", "{\"x\":+1,\"exp\":4000000000}", "{\"x\":.5,\"exp\":4000000000}",
    "{\"x\":1.,\"exp\":4000000000}", "{\"x\":1e,\"exp\":4000000000}", "{\"x\":0x10,\"exp\":4000000000}",
    "{\"x\":NaN,\"exp\":4000000000}", "{\"x\":Infinity,\"exp\":4000000000}", "{'sub':'a','exp':4000000000}",
    "{\"sub\":\"a\",/*c*/\"exp\":4000000000}", "{\"exp\":4000000000}x", "{\"exp\":4000000000}{\"sub\":\"admin\"}",
    "[{\"exp\":4000000000}]", "\"exp\"", "123", "null", "{\"sub\":\"\\x41\",\"exp\":4000000000}",
    "{\"sub\":\"\\u004\",\"exp\":4000000000}", "{\"sub\":\"\\ud800\",\"exp\":4000000000}",
    "{\"sub\":\"\\udc00\",\"exp\":4000000000}", "{\"sub\":\"\\udc00\\ud800\",\"exp\":4000000000}",
    "{\"sub\":\"\\ud800\\u0041\",\"exp\":4000000000}", "{\"x\":tru,\"exp\":4000000000}", "{\"x\":nul,\"exp\":4000000000}",
    "{\"sub\" \"a\",\"exp\":4000000000}", "{\"sub\":\"a\" \"exp\":4000000000}", "{\"exp\":4000000000", "",
  ]
  let mut i = 0
  while i < bad.length() {
    debug_assert(rejects(tok(bad[i])), "invalid JSON accepted: " + bad[i])
    i = i + 1
  }
  // raw control bytes / invalid UTF-8 inside strings
  let raw_bad = [
    [0], [31], [0xFF], [0xC0, 0xAF], [0xED, 0xA0, 0x80], [0xE2, 0x82], [0xF4, 0x90, 0x80, 0x80], [0xF8, 0x88, 0x80, 0x80, 0x80],
    [0x80],
  ]
  let mut j = 0
  while j < raw_bad.length() {
    let pay = cat(["{\"sub\":\"a".to_bytes(), bytes_of(raw_bad[j]), "\",\"exp\":4000000000}".to_bytes()])
    debug_assert(rejects(tok_raw("{\"alg\":\"HS256\"}".to_bytes(), pay, key())), "raw invalid byte accepted")
    j = j + 1
  }
  // UTF-8 BOM before the object
  let bom = cat([bytes_of([0xEF, 0xBB, 0xBF]), "{\"exp\":4000000000}".to_bytes()])
  debug_assert(rejects(tok_raw("{\"alg\":\"HS256\"}".to_bytes(), bom, key())), "BOM accepted")
  // ... and the legal spellings still work
  debug_assert(sub_of(tok("{\"sub\":\"\\ud83d\\ude00\",\"exp\":4000000000}")) == "😀", "surrogate pair")
  debug_assert(sub_of(tok("{\"sub\":\"😀\",\"exp\":4000000000}")) == "😀", "raw emoji")
  debug_assert(sub_of(tok("{\"sub\":\"a\u{007f}b\",\"exp\":4000000000}")) == "a\u{007f}b", "DEL is legal")
  debug_assert(
    sub_of(tok(" \t\r\n{ \"sub\" : \"a\" , \"exp\" : 4000000000 } \n")) == "a",
    "insignificant whitespace",
  )
}

///|
test "control_numericdate_int64_edges" {
  debug_assert(accepts(tok("{\"exp\":9223372036854775807}")), "exp=i64::MAX")
  debug_assert(rejects(tok("{\"exp\":9223372036854775808}")), "exp=i64::MAX+1 must not wrap")
  debug_assert(rejects(tok("{\"exp\":18446744073709551615}")), "exp=u64::MAX must not wrap")
  debug_assert(rejects(tok("{\"exp\":-9223372036854775808}")), "exp=i64::MIN is in the past")
  debug_assert(rejects(tok("{\"exp\":-9223372036854775809}")), "exp=i64::MIN-1")
  debug_assert(rejects(tok("{\"exp\":99999999999999999999999}")), "exp=1e23 as integer")
  debug_assert(rejects(tok("{\"exp\":0}")), "exp=0 is in the past (golang-jwt MapClaims treats 0 as absent!)")
  debug_assert(rejects(tok("{\"exp\":-0}")), "exp=-0 is in the past")
  debug_assert(rejects(tok("{\"exp\":\"4000000000\"}")), "string exp")
  debug_assert(rejects(tok("{\"exp\":null}")), "null exp")
  debug_assert(rejects(tok("{\"exp\":true}")), "bool exp")
  debug_assert(rejects(tok("{\"exp\":[4000000000]}")), "array exp")
  // RFC 7519 4.1.4: "current date/time MUST be before the expiration date/time"
  let at_now = tok("{\"exp\":" + now.to_string() + "}")
  debug_assert(rejects(at_now), "exp == now must be expired (Go agrees; jsonwebtoken accepts)")
  debug_assert(accepts(tok("{\"exp\":4000000000,\"nbf\":" + now.to_string() + "}")), "nbf == now is valid")
  debug_assert(rejects(tok("{\"exp\":4000000000,\"nbf\":" + (now + 1L).to_string() + "}")), "nbf == now+1")
}

///|
test "control_leeway_semantics" {
  let t = tok("{\"exp\":" + (now - 10L).to_string() + "}")
  debug_assert(rejects(t), "expired 10s ago")
  let v11 = jwt::Validation::{ ..v256(), leeway: 11L }
  match jwt::decode(t, key(), v11, now) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "leeway 11 must cover 10s")
  }
  // negative leeway must not *shrink* into accepting nor wrap
  let vneg = jwt::Validation::{ ..v256(), leeway: -9223372036854775807L - 1L }
  match jwt::decode(t, key(), vneg, now) {
    Ok(_) => debug_assert(false, "i64::MIN leeway accepted an expired token")
    Err(_) => ()
  }
  match jwt::decode(tok("{\"exp\":4000000000}"), key(), vneg, now) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "i64::MIN leeway rejected a valid token")
  }
  // exp side with i64::MAX leeway: now - MAX does not wrap (stays >= i64::MIN), so an
  // exp of 0 is accepted and only exp values below now - MAX stay expired.
  let vmax = jwt::Validation::{ ..v256(), leeway: 9223372036854775807L }
  match jwt::decode(tok("{\"exp\":0}"), key(), vmax, now) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "i64::MAX leeway, exp side")
  }
  match jwt::decode(tok("{\"exp\":-9223372036854775808}"), key(), vmax, now) {
    Ok(_) => debug_assert(false, "now - leeway wrapped on the exp side")
    Err(_) => ()
  }
}

///|
test "control_claim_types_and_validation" {
  let bad = [
    "{\"aud\":[123],\"exp\":4000000000}", "{\"aud\":123,\"exp\":4000000000}", "{\"aud\":{},\"exp\":4000000000}",
    "{\"sub\":1,\"exp\":4000000000}", "{\"iss\":[\"a\"],\"exp\":4000000000}", "{\"jti\":7,\"exp\":4000000000}",
    "{\"iat\":\"x\",\"exp\":4000000000}",
  ]
  let mut i = 0
  while i < bad.length() {
    debug_assert(rejects(tok(bad[i])), "mistyped registered claim accepted: " + bad[i])
    i = i + 1
  }
  let va = jwt::Validation::{ ..v256(), aud: Some(["api"]) }
  let aud_cases : Array[(String, Bool)] = [
    ("{\"aud\":\"api\",\"exp\":4000000000}", true),
    ("{\"aud\":[\"x\",\"api\"],\"exp\":4000000000}", true),
    ("{\"aud\":[],\"exp\":4000000000}", false),
    ("{\"aud\":\"API\",\"exp\":4000000000}", false),
    ("{\"aud\":\"api \",\"exp\":4000000000}", false),
    ("{\"exp\":4000000000}", false),
  ]
  let mut j = 0
  while j < aud_cases.length() {
    let (p, want) = aud_cases[j]
    let got = match jwt::decode(tok(p), key(), va, now) {
      Ok(_) => true
      Err(_) => false
    }
    debug_assert(got == want, "aud validation wrong for " + p)
    j = j + 1
  }
  let vi = jwt::Validation::{ ..v256(), iss: Some([]) }
  debug_assert(
    match jwt::decode(tok("{\"iss\":\"a\",\"exp\":4000000000}"), key(), vi, now) {
      Ok(_) => false
      Err(_) => true
    },
    "empty iss allowlist must reject",
  )
}

// ---------------------------------------------------------------------------
// Signature / structure
// ---------------------------------------------------------------------------

///|
fn b64_alphabet() -> String {
  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
}

///|
fn prefix(b : Bytes, n : Int) -> String {
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = b[i]
    i = i + 1
  }
  out.to_string()
}

///|
fn alpha_index(c : Int) -> Int {
  let a = b64_alphabet()
  let mut i = 0
  while i < 64 {
    if a.code_unit_at(i) == c {
      return i
    }
    i = i + 1
  }
  -1
}

///|
test "control_signature_every_char_flip_and_malleability" {
  let good = tok("{\"sub\":\"alice\",\"exp\":4000000000}")
  debug_assert(accepts(good), "baseline")
  let tb = good.to_bytes()
  let n = tb.length()
  let mut dot2 = n - 1
  while tb[dot2].to_int() != 46 {
    dot2 = dot2 - 1
  }
  let a = b64_alphabet()
  // every single-character substitution anywhere in the token
  let mut i = 0
  while i < n {
    if tb[i].to_int() != 46 {
      let idx = alpha_index(tb[i].to_int())
      let mut d = 1
      while d < 64 {
        let m = Bytes::new(n)
        let mut k = 0
        while k < n {
          m[k] = tb[k]
          k = k + 1
        }
        m[i] = a.code_unit_at((idx + d) % 64).to_byte()
        debug_assert(rejects(m.to_string()), "mutated token accepted at " + i.to_string())
        d = d + 21
      }
    }
    i = i + 1
  }
  // non-canonical trailing bits of the 43-char HS256 signature (malleability)
  let last = alpha_index(tb[n - 1].to_int())
  let mut b = 1
  while b < 4 {
    let m = Bytes::new(n)
    let mut k = 0
    while k < n {
      m[k] = tb[k]
      k = k + 1
    }
    m[n - 1] = a.code_unit_at((last & 0x3C) | ((last + b) & 3)).to_byte()
    debug_assert(rejects(m.to_string()), "non-canonical signature tail accepted")
    b = b + 1
  }
  let base = good
  let variants = [
    base + "A", base + "AAAA", base + "=", base + "\n", " " + base, prefix(tb, n - 1), prefix(tb, dot2 + 1),
    prefix(tb, dot2), base + ".AAAA", "." + base,
  ]
  let mut v = 0
  while v < variants.length() {
    debug_assert(rejects(variants[v]), "structural variant accepted #" + v.to_string())
    v = v + 1
  }
  // signature from a different key / algorithm
  let other = tok_raw(
    "{\"alg\":\"HS256\"}".to_bytes(),
    "{\"sub\":\"alice\",\"exp\":4000000000}".to_bytes(),
    "other".to_bytes(),
  )
  debug_assert(rejects(other), "foreign key accepted")
}

// ---------------------------------------------------------------------------
// Base64URL: exhaustive tails, every byte value
// ---------------------------------------------------------------------------

///|
test "control_base64url_exhaustive_canonical_tails" {
  let a = b64_alphabet()
  // remainder 2: 4096 strings; canonical iff re-encoding is identical
  let mut accepted2 = 0
  let mut i = 0
  while i < 64 {
    let mut j = 0
    while j < 64 {
      let s = Bytes::new(2)
      s[0] = a.code_unit_at(i).to_byte()
      s[1] = a.code_unit_at(j).to_byte()
      match jwt::base64url_decode_bytes(s) {
        Ok(d) => {
          accepted2 = accepted2 + 1
          debug_assert(jwt::base64url_encode(d) == s.to_string(), "non-canonical r2 accepted")
        }
        Err(_) => debug_assert((j & 15) != 0, "canonical r2 rejected")
      }
      j = j + 1
    }
    i = i + 1
  }
  debug_assert(accepted2 == 256, "exactly 256 canonical 2-char tails")
  // remainder 3: 262144 strings
  let mut accepted3 = 0
  let mut x = 0
  while x < 64 * 64 * 64 {
    let s = Bytes::new(3)
    s[0] = a.code_unit_at(x >> 12).to_byte()
    s[1] = a.code_unit_at((x >> 6) & 63).to_byte()
    s[2] = a.code_unit_at(x & 63).to_byte()
    match jwt::base64url_decode_bytes(s) {
      Ok(d) => {
        accepted3 = accepted3 + 1
        debug_assert(jwt::base64url_encode(d) == s.to_string(), "non-canonical r3 accepted")
      }
      Err(_) => debug_assert((x & 3) != 0, "canonical r3 rejected")
    }
    x = x + 1
  }
  debug_assert(accepted3 == 65536, "exactly 65536 canonical 3-char tails")
}

///|
test "control_base64url_every_byte_value_and_shapes" {
  let mut v = 0
  while v < 256 {
    let ok_char = alpha_index(v) >= 0
    let mut pos = 0
    while pos < 4 {
      let q = "QUJD".to_bytes()
      q[pos] = v.to_byte()
      let acc = match jwt::base64url_decode_bytes(q) {
        Ok(_) => true
        Err(_) => false
      }
      debug_assert(acc == ok_char, "byte " + v.to_string() + " misclassified at " + pos.to_string())
      pos = pos + 1
    }
    v = v + 1
  }
  let bad = ["A", "AAAAA", "AA==", "AA=", "AAA=", "+/+/", "AB+C", "AB/C", " AAA", "AA\nAA", "AA\rAA", "=AAA", "A=AA"]
  let mut i = 0
  while i < bad.length() {
    match jwt::base64url_decode(bad[i]) {
      Ok(_) => debug_assert(false, "accepted invalid base64url #" + i.to_string())
      Err(_) => ()
    }
    i = i + 1
  }
  match jwt::base64url_decode("") {
    Ok(b) => debug_assert(b.length() == 0, "empty")
    Err(_) => debug_assert(false, "empty input is valid")
  }
}

///|
test "control_constant_time_eq_semantics" {
  let a = repeat_byte(0x5A, 64)
  debug_assert(jwt::constant_time_eq(a, repeat_byte(0x5A, 64)), "equal")
  debug_assert(!jwt::constant_time_eq(a, repeat_byte(0x5A, 63)), "shorter")
  debug_assert(!jwt::constant_time_eq(a, repeat_byte(0x5A, 65)), "longer")
  debug_assert(jwt::constant_time_eq(Bytes::new(0), Bytes::new(0)), "empty")
  let mut i = 0
  while i < 64 {
    let mut bit = 0
    while bit < 8 {
      let b = repeat_byte(0x5A, 64)
      b[i] = (0x5A ^ (1 << bit)).to_byte()
      debug_assert(!jwt::constant_time_eq(a, b), "single-bit difference missed")
      bit = bit + 1
    }
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// JWK
// ---------------------------------------------------------------------------

///|
test "control_jwk_parsing_edges" {
  let bad = [
    "{\"kty\":\"RSA\",\"k\":\"AAAA\"}", "{\"kty\":\"OCT\",\"k\":\"AAAA\"}", "{\"k\":\"AAAA\"}", "{\"kty\":\"oct\"}",
    "{\"kty\":\"oct\",\"k\":1}", "{\"kty\":\"oct\",\"k\":\"AB\"}", "{\"kty\":\"oct\",\"k\":\"AA==\"}",
    "{\"kty\":\"oct\",\"k\":\"AB+/\"}", "{\"kty\":\"oct\",\"k\":\"AAAA\",\"k\":\"BBBB\"}",
    "{\"kty\":\"oct\",\"k\":\"AAAA\",\"\\u006b\":\"BBBB\"}", "{\"kty\":\"oct\",\"k\":\"AAAA\",\"kid\":1}",
    "{\"kty\":\"oct\",\"k\":\"AAAA\",\"use\":[]}", "[{\"kty\":\"oct\",\"k\":\"AAAA\"}]", "{\"kty\":\"oct\",\"k\":\"AAAA\"",
  ]
  let mut i = 0
  while i < bad.length() {
    match jwt::Jwk::from_json(bad[i]) {
      Ok(_) => debug_assert(false, "bad JWK accepted: " + bad[i])
      Err(_) => ()
    }
    i = i + 1
  }
  match jwt::Jwk::from_json("{\"kty\":\"oct\",\"k\":\"AQID\",\"x5t\":\"ignored\",\"ext\":true,\"key_ops\":[\"sign\"]}") {
    Ok(j) =>
    match jwt::Jwk::to_secret_bytes(j) {
      Ok(k) => debug_assert(k.length() == 3 && k[2].to_int() == 3, "k bytes")
      Err(_) => debug_assert(false, "to_secret_bytes")
    }
    Err(_) => debug_assert(false, "unknown JWK members must be ignored (RFC 7517 4)")
  }
}

// ---------------------------------------------------------------------------
// DoS: default limits hold
// ---------------------------------------------------------------------------

///|
test "control_default_limits_stop_nesting_bombs_without_crashing" {
  let bomb = cat(["{\"exp\":4000000000,\"d\":".to_bytes(), nested_arrays(8000), "}".to_bytes()])
  let t = tok_raw("{\"alg\":\"HS256\"}".to_bytes(), bomb, key())
  // > 16 KiB default token limit
  match jwt::decode(t, key(), v256(), now) {
    Err(jwt::JwtError::TokenTooLarge(_, _)) => ()
    _ => debug_assert(false, "default max_token_bytes must stop the bomb")
  }
  // limit lifted, depth limit still default (32)
  let v = jwt::Validation::{ ..v256(), max_token_bytes: 1 << 30 }
  match jwt::decode(t, key(), v, now) {
    Err(jwt::JwtError::JsonDepthExceeded(_)) => ()
    _ => debug_assert(false, "default max_json_depth must stop the bomb")
  }
  match jwt::json_parse(nested_arrays(50000), 32) {
    Err(jwt::JwtError::JsonDepthExceeded(_)) => ()
    _ => debug_assert(false, "json_parse depth 32 vs 50k bomb")
  }
  // header-side bomb through decode_header (fixed 16 KiB / depth 32)
  let hb = cat(["{\"alg\":\"HS256\",\"x\":".to_bytes(), nested_arrays(4000), "}".to_bytes()])
  let ht = tok_raw(hb, "{}".to_bytes(), key())
  match jwt::decode_header(ht) {
    Ok(_) => debug_assert(false, "header bomb accepted")
    Err(_) => ()
  }
}

// ---------------------------------------------------------------------------
// Round-trip of hostile-but-legal content through Pion's own serializer
// ---------------------------------------------------------------------------

///|
test "control_serializer_roundtrip_hostile_strings" {
  let subs = [
    "用户-é-😀", "quote\"back\\slash", "ctl\u{0001}\t\n\r\u{001f}\u{0000}", "line\u{2028}sep\u{2029}", "/solidus/", "",
    "\u{007f}\u{0080}\u{07ff}\u{0800}\u{ffff}\u{10000}\u{10ffff}",
  ]
  let mut i = 0
  while i < subs.length() {
    let m : Map[String, jwt::JsonValue] = Map::new()
    m.set(subs[i], jwt::JsonValue::Str(subs[i]))
    let claims = claims_with(Some(subs[i]), Some(jwt::Audience::Many([subs[i], "x"])), Some(fut), m)
    let h = jwt::Header::{
      ..jwt::Header::new(jwt::Algorithm::HS512),
      kid: Some(subs[i]),
    }
    match jwt::encode(h, claims, key()) {
      Ok(t) =>
      match jwt::decode(t, key(), jwt::Validation::new(jwt::Algorithm::HS512), now) {
        Ok(td) => {
          debug_assert(
            match td.claims.sub {
              Some(s) => s == subs[i]
              None => false
            },
            "sub roundtrip #" + i.to_string(),
          )
          debug_assert(
            match td.header.kid {
              Some(s) => s == subs[i]
              None => false
            },
            "kid roundtrip #" + i.to_string(),
          )
        }
        Err(_) => debug_assert(false, "own token rejected #" + i.to_string())
      }
      Err(_) => debug_assert(false, "encode failed #" + i.to_string())
    }
    i = i + 1
  }
}
