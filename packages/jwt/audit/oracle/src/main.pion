///| Red-team differential oracle for `packages/jwt` (Pion side).
///|
///| Modes (all output is line-oriented so Rust / Go oracles can be diffed byte-for-byte):
///|   vectors <file>          run a gen_vectors.py corpus, one "<label>\t<result>" line per input
///|   sign                    emit Pion-signed interop tokens as JWTV corpus lines
///|   bench <file> <iters>    decode every JWTV line <iters> times, print ok/err counts
///|   parse <file> <iters>    base64url + json_parse of every payload only (no HMAC)
///|   deep <n> <max_depth>    json_parse("[" * n + "]" * n, max_depth)
///|   deepjwt <n> <max_depth> decode a token whose payload nests n arrays, with
///|                           Validation.max_json_depth = max_depth (token size limit lifted)

import "jwt"

///|
let hex_digits : String = "0123456789abcdef"

///|
let audit_now : Int64 = 1795400000L

///|
fn to_hex(b : Bytes) -> String {
  let n = b.length()
  let out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = b[i].to_int()
    out[2 * i] = hex_digits.code_unit_at(v >> 4).to_byte()
    out[2 * i + 1] = hex_digits.code_unit_at(v & 15).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Decode hex from buf[start, end).
fn from_hex(buf : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_val(buf[start + 2 * i].to_int())
    let lo = hex_val(buf[start + 2 * i + 1].to_int())
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn slice_str(buf : Bytes, start : Int, end : Int) -> String {
  let n = end - start
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = buf[start + i]
    i = i + 1
  }
  out.to_string()
}

///|
fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

///|
fn alg_of(s : String) -> jwt::Algorithm {
  if s == "HS384" {
    jwt::Algorithm::HS384
  } else if s == "HS512" {
    jwt::Algorithm::HS512
  } else {
    jwt::Algorithm::HS256
  }
}

///| Tab-separated field boundaries of buf[start, end): returns flat [s0, e0, s1, e1, ...].
fn fields(buf : Bytes, start : Int, end : Int) -> Array[Int] {
  let out : Array[Int] = []
  let mut fs = start
  let mut i = start
  while i < end {
    if buf[i].to_int() == 9 {
      out.push(fs)
      out.push(i)
      fs = i + 1
    }
    i = i + 1
  }
  out.push(fs)
  out.push(end)
  out
}

///| Verdict shared by all three oracles for JWTV lines:
///| Validation::new(alg) (exp/nbf checked, nothing required, aud not checked), now = audit_now.
fn jwt_verdict(alg : jwt::Algorithm, key : Bytes, token : String) -> String {
  match jwt::decode(token, key, jwt::Validation::new(alg), audit_now) {
    Ok(td) =>
    match td.claims.sub {
      Some(s) => "OK sub=" + to_hex(s.to_bytes())
      None => "OK sub=-"
    }
    Err(_) => "ERR"
  }
}

///|
fn run_line(buf : Bytes, start : Int, end : Int) -> String {
  let f = fields(buf, start, end)
  let op = slice_str(buf, f[0], f[1])
  let label = slice_str(buf, f[2], f[3])
  let res = if op == "H256" {
    to_hex(jwt::sha256(from_hex(buf, f[4], f[5])))
  } else if op == "H384" {
    to_hex(jwt::sha384(from_hex(buf, f[4], f[5])))
  } else if op == "H512" {
    to_hex(jwt::sha512(from_hex(buf, f[4], f[5])))
  } else if op == "M256" {
    to_hex(jwt::hmac_sha256(from_hex(buf, f[4], f[5]), from_hex(buf, f[6], f[7])))
  } else if op == "M384" {
    to_hex(jwt::hmac_sha384(from_hex(buf, f[4], f[5]), from_hex(buf, f[6], f[7])))
  } else if op == "M512" {
    to_hex(jwt::hmac_sha512(from_hex(buf, f[4], f[5]), from_hex(buf, f[6], f[7])))
  } else if op == "B64E" {
    jwt::base64url_encode(from_hex(buf, f[4], f[5]))
  } else if op == "B64D" {
    match jwt::base64url_decode_bytes(from_hex(buf, f[4], f[5])) {
      Ok(b) => "OK " + to_hex(b)
      Err(_) => "ERR"
    }
  } else if op == "JWTV" {
    let alg = alg_of(slice_str(buf, f[4], f[5]))
    let key = from_hex(buf, f[6], f[7])
    let tok_bytes = from_hex(buf, f[8], f[9])
    // Tokens are ASCII in a well-formed world; hostile bytes go through the same
    // String conversion every caller of `decode(token : String, ...)` must use.
    jwt_verdict(alg, key, tok_bytes.to_string())
  } else {
    "UNKNOWN_OP"
  }
  label + "\t" + res
}

///|
fn run_vectors(world : World, path : String) -> Int {
  let buf = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "error: cannot read " + path)
      return 2
    }
  }
  let n = buf.length()
  let sb = StringBuilder::new()
  let mut pos = 0
  let mut lines = 0
  while pos < n {
    let mut nl = pos
    while nl < n && buf[nl].to_int() != 10 {
      nl = nl + 1
    }
    if nl > pos {
      sb.write_string(run_line(buf, pos, nl))
      sb.write_string("\n")
      lines = lines + 1
      if lines % 4096 == 0 {
        io_print(world, sb.to_string())
        sb.reset()
      }
    }
    pos = nl + 1
  }
  io_print(world, sb.to_string())
  0
}

///|
fn str_map(pairs : Array[(String, jwt::JsonValue)]) -> Map[String, jwt::JsonValue] {
  let m : Map[String, jwt::JsonValue] = Map::new()
  let mut i = 0
  while i < pairs.length() {
    let (k, v) = pairs[i]
    m.set(k, v)
    i = i + 1
  }
  m
}

///|
fn emit_jwtv(
  world : World,
  label : String,
  alg_s : String,
  key : Bytes,
  hdr : jwt::Header,
  claims : jwt::Claims,
) -> Unit {
  match jwt::encode(hdr, claims, key) {
    Ok(t) =>
    io_println(
      world,
      "JWTV\t" + label + "\t" + alg_s + "\t" + to_hex(key) + "\t" + to_hex(t.to_bytes()),
    )
    Err(_) => io_eprintln(world, "encode failed: " + label)
  }
}

///| Pion-signed interop corpus (verified afterwards by Rust and Go `vectors`).
fn run_sign(world : World) -> Int {
  let key = "red-team-audit-secret-key-0123456789abcdef".to_bytes()
  let nested = jwt::JsonValue::Obj(
    str_map([
      (
        "k",
        jwt::JsonValue::Arr([
          jwt::JsonValue::Int(1L),
          jwt::JsonValue::Float(2.5),
          jwt::JsonValue::Null,
          jwt::JsonValue::Bool(true),
          jwt::JsonValue::Obj(str_map([("z", jwt::JsonValue::Str("ü"))])),
        ]),
      ),
      ("neg", jwt::JsonValue::Int(-9223372036854775807L - 1L)),
    ]),
  )
  let subjects = [
    "alice", "用户-é-😀", "quote\"back\\slash", "ctl\u{0001}\t\n\r\u{001f}", "line\u{2028}sep",
    "/solidus/", "",
  ]
  let algs = ["HS256", "HS384", "HS512"]
  let mut i = 0
  while i < subjects.length() {
    let mut a = 0
    while a < algs.length() {
      let alg = alg_of(algs[a])
      let hdr = jwt::Header::new(alg)
      let claims = jwt::Claims::{
        iss: Some("https://issuer.example/é"),
        sub: Some(subjects[i]),
        aud: Some(jwt::Audience::Many(["api", "β-svc"])),
        exp: Some(4000000000L),
        nbf: Some(1000000000L),
        iat: Some(1000000000L),
        jti: Some("jti-" + i.to_string()),
        custom: str_map([("nested", nested), ("role", jwt::JsonValue::Str("admin"))]),
      }
      emit_jwtv(world, "pion_sign/sub" + i.to_string() + "/" + algs[a], algs[a], key, hdr, claims)
      a = a + 1
    }
    i = i + 1
  }
  // Header with kid + extra member, and a long key (> SHA-512 block)
  let long_key = Bytes::new(300)
  let mut j = 0
  while j < 300 {
    long_key[j] = ((j * 7 + 3) & 255).to_byte()
    j = j + 1
  }
  let mut a = 0
  while a < algs.length() {
    let hdr = jwt::Header::{
      alg: alg_of(algs[a]),
      typ: Some("JWT"),
      kid: Some("kid-ключ"),
      cty: None,
      crit: None,
      extra: str_map([("x-ext", jwt::JsonValue::Str("v"))]),
    }
    let claims = jwt::Claims::{
      iss: None,
      sub: Some("long-key"),
      aud: Some(jwt::Audience::Single("api")),
      exp: Some(4000000000L),
      nbf: None,
      iat: None,
      jti: None,
      custom: Map::new(),
    }
    emit_jwtv(world, "pion_sign/longkey/" + algs[a], algs[a], long_key, hdr, claims)
    a = a + 1
  }
  // Floats that Pion's own serializer has to render (inf / nan / -0.0 / 0.1)
  let float_cases : Array[(String, Double)] = [
    ("f_0_1", 0.1),
    ("f_neg_zero", -0.0),
    ("f_1e300", 1.0e300),
    ("f_inf", 1.0 / 0.0),
    ("f_nan", 0.0 / 0.0),
  ]
  let mut k = 0
  while k < float_cases.length() {
    let (name, fv) = float_cases[k]
    let claims = jwt::Claims::{
      iss: None,
      sub: Some(name),
      aud: None,
      exp: Some(4000000000L),
      nbf: None,
      iat: None,
      jti: None,
      custom: str_map([("f", jwt::JsonValue::Float(fv))]),
    }
    emit_jwtv(
      world,
      "pion_sign/float/" + name,
      "HS256",
      key,
      jwt::Header::new(jwt::Algorithm::HS256),
      claims,
    )
    k = k + 1
  }
  // Empty HMAC key: Pion signs without complaint
  emit_jwtv(
    world,
    "pion_sign/empty_key",
    "HS256",
    Bytes::new(0),
    jwt::Header::new(jwt::Algorithm::HS256),
    jwt::Claims::{
      iss: None,
      sub: Some("empty-key"),
      aud: None,
      exp: Some(4000000000L),
      nbf: None,
      iat: None,
      jti: None,
      custom: Map::new(),
    },
  )
  0
}

///|
fn run_bench(world : World, path : String, iters : Int) -> Int {
  let buf = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "error: cannot read " + path)
      return 2
    }
  }
  let n = buf.length()
  let algs : Array[jwt::Algorithm] = []
  let keys : Array[Bytes] = []
  let toks : Array[String] = []
  let mut pos = 0
  while pos < n {
    let mut nl = pos
    while nl < n && buf[nl].to_int() != 10 {
      nl = nl + 1
    }
    if nl > pos {
      let f = fields(buf, pos, nl)
      algs.push(alg_of(slice_str(buf, f[4], f[5])))
      keys.push(from_hex(buf, f[6], f[7]))
      toks.push(from_hex(buf, f[8], f[9]).to_string())
    }
    pos = nl + 1
  }
  let vals : Array[jwt::Validation] = []
  let mut t = 0
  while t < toks.length() {
    let v = jwt::Validation::new(algs[t])
    vals.push(jwt::Validation::{ ..v, max_token_bytes: 1 << 30 })
    t = t + 1
  }
  let mut ok = 0
  let mut err = 0
  let mut claims_seen = 0
  let mut r = 0
  while r < iters {
    let mut i = 0
    while i < toks.length() {
      match jwt::decode(toks[i], keys[i], vals[i], audit_now) {
        Ok(td) => {
          ok = ok + 1
          claims_seen = claims_seen + td.claims.custom.length()
        }
        Err(_) => err = err + 1
      }
      i = i + 1
    }
    r = r + 1
  }
  io_println(world, "tokens=" + toks.length().to_string())
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "ok=" + ok.to_string())
  io_println(world, "err=" + err.to_string())
  0
}

///| JSON-only bench: base64url-decode the payload segment and json_parse it (no HMAC),
///| isolating the parser from the SHA-2 hardware gap.
fn run_parse(world : World, path : String, iters : Int) -> Int {
  let buf = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_eprintln(world, "error: cannot read " + path)
      return 2
    }
  }
  let n = buf.length()
  let pays : Array[Bytes] = []
  let mut pos = 0
  while pos < n {
    let mut nl = pos
    while nl < n && buf[nl].to_int() != 10 {
      nl = nl + 1
    }
    if nl > pos {
      let f = fields(buf, pos, nl)
      let t = from_hex(buf, f[8], f[9])
      let mut d1 = 0
      while t[d1].to_int() != 46 {
        d1 = d1 + 1
      }
      let mut d2 = d1 + 1
      while t[d2].to_int() != 46 {
        d2 = d2 + 1
      }
      let seg = Bytes::new(d2 - d1 - 1)
      let mut k = 0
      while k < seg.length() {
        seg[k] = t[d1 + 1 + k]
        k = k + 1
      }
      pays.push(seg)
    }
    pos = nl + 1
  }
  let mut ok = 0
  let mut err = 0
  let mut r = 0
  while r < iters {
    let mut i = 0
    while i < pays.length() {
      match jwt::base64url_decode_bytes(pays[i]) {
        Ok(raw) =>
        match jwt::json_parse(raw, 128) {
          Ok(_) => ok = ok + 1
          Err(_) => err = err + 1
        }
        Err(_) => err = err + 1
      }
      i = i + 1
    }
    r = r + 1
  }
  io_println(world, "tokens=" + pays.length().to_string())
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "ok=" + ok.to_string())
  io_println(world, "err=" + err.to_string())
  0
}

///|
fn nested_arrays(n : Int) -> Bytes {
  let b = Bytes::new(2 * n)
  let mut i = 0
  while i < n {
    b[i] = (91).to_byte()
    b[2 * n - 1 - i] = (93).to_byte()
    i = i + 1
  }
  b
}

///|
fn run_deep(world : World, n : Int, max_depth : Int) -> Int {
  match jwt::json_parse(nested_arrays(n), max_depth) {
    Ok(_) => io_println(world, "deep n=" + n.to_string() + " OK")
    Err(_) => io_println(world, "deep n=" + n.to_string() + " ERR")
  }
  0
}

///|
fn run_deepjwt(world : World, n : Int, max_depth : Int) -> Int {
  let inner = nested_arrays(n)
  let pre = "{\"exp\":4000000000,\"d\":".to_bytes()
  let pay = Bytes::new(pre.length() + inner.length() + 1)
  let mut i = 0
  while i < pre.length() {
    pay[i] = pre[i]
    i = i + 1
  }
  let mut j = 0
  while j < inner.length() {
    pay[pre.length() + j] = inner[j]
    j = j + 1
  }
  pay[pay.length() - 1] = (125).to_byte()
  let key = "red-team-audit-secret-key-0123456789abcdef".to_bytes()
  let si = jwt::base64url_encode("{\"alg\":\"HS256\"}".to_bytes()) + "." + jwt::base64url_encode(pay)
  let tok = si + "." + jwt::base64url_encode(jwt::hmac_sha256(key, si.to_bytes()))
  let v = jwt::Validation::new(jwt::Algorithm::HS256)
  let v2 = jwt::Validation::{ ..v, max_token_bytes: 1 << 30, max_json_depth: max_depth }
  match jwt::decode(tok, key, v2, audit_now) {
    Ok(_) => io_println(world, "deepjwt n=" + n.to_string() + " OK")
    Err(_) => io_println(world, "deepjwt n=" + n.to_string() + " ERR")
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mode = if args.length() > 1 { args[1] } else { "" }
  if mode == "vectors" && args.length() > 2 {
    run_vectors(world, args[2])
  } else if mode == "sign" {
    run_sign(world)
  } else if mode == "bench" && args.length() > 3 {
    run_bench(world, args[2], parse_int(args[3]))
  } else if mode == "parse" && args.length() > 3 {
    run_parse(world, args[2], parse_int(args[3]))
  } else if mode == "deep" && args.length() > 3 {
    run_deep(world, parse_int(args[2]), parse_int(args[3]))
  } else if mode == "deepjwt" && args.length() > 3 {
    run_deepjwt(world, parse_int(args[2]), parse_int(args[3]))
  } else {
    io_eprintln(
      world, "usage: oracle vectors <file> | sign | bench <file> <iters> | parse <file> <iters> | deep <n> <max_depth> | deepjwt <n> <max_depth>",
    )
    2
  }
}
