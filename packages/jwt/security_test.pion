///| Day-1 Red-Team JWT Security Suite:
///| Covers alg=none (all cases), algorithm confusion, crit header rejection,
///| duplicate JSON key smuggling, nesting bombs, oversized token DoS,
///| non-integer/overflow timestamps, 3-segment structure, non-canonical Base64URL,
///| and signature tampering.

///|
fn make_signed_raw(
  hdr_json : String,
  pay_json : String,
  key : Bytes,
) -> String {
  let h = base64url_encode(hdr_json.to_bytes())
  let p = base64url_encode(pay_json.to_bytes())
  let signing_input = h + "." + p
  let sig = hmac_sha256(key, signing_input.to_bytes())
  signing_input + "." + base64url_encode(sig)
}

///|
test "security_reject_alg_none_all_variants" {
  let key = "secret".to_bytes()
  let validation = Validation::new(Algorithm::HS256)
  let variants = ["none", "None", "NONE", "nOnE"]
  let mut i = 0
  while i < variants.length() {
    let alg = variants[i]
    let h = base64url_encode(("{\"alg\":\"" + alg + "\",\"typ\":\"JWT\"}").to_bytes())
    let p = base64url_encode("{\"sub\":\"admin\"}".to_bytes())
    // Unsigned (empty signature)
    let tok_empty = h + "." + p + "."
    match decode(tok_empty, key, validation, 0L) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "must reject alg=none empty sig")
    }
    // Even with a non-empty signature
    let tok_sig = h + "." + p + ".AAAA"
    match decode(tok_sig, key, validation, 0L) {
      Err(JwtError::AlgorithmNoneNotAllowed) => ()
      _ => debug_assert(false, "must reject alg=none with AlgorithmNoneNotAllowed")
    }
    match algorithm_from_str(alg) {
      Err(JwtError::AlgorithmNoneNotAllowed) => ()
      _ => debug_assert(false, "Algorithm::from_str must reject none")
    }
    i = i + 1
  }
}

///|
test "security_reject_algorithm_confusion_and_empty_allowlist" {
  let key = "confusion-secret".to_bytes()
  let claims = Claims::{
    iss: None,
    sub: Some("alice"),
    aud: None,
    exp: Some(9999999999L),
    nbf: None,
    iat: None,
    jti: None,
    custom: Map::new(),
  }
  let tok_hs256 = match encode(Header::new(Algorithm::HS256), claims, key) {
    Ok(t) => t
    Err(_) => {
      debug_assert(false, "encode hs256 failed")
      ""
    }
  }

  // Must reject when allowlist only permits HS512
  match decode(tok_hs256, key, Validation::new(Algorithm::HS512), 100L) {
    Err(JwtError::AlgorithmMismatch(_)) => ()
    _ => debug_assert(false, "must reject HS256 token when only HS512 allowed")
  }

  // Must reject empty allowlist
  match decode(tok_hs256, key, Validation::with_algorithms([]), 100L) {
    Err(JwtError::EmptyAllowedAlgorithms) => ()
    _ => debug_assert(false, "must reject empty allowlist")
  }

  // Must reject unsupported asymmetric alg (e.g. RS256)
  let rs_tok = make_signed_raw("{\"alg\":\"RS256\",\"typ\":\"JWT\"}", "{\"sub\":\"alice\"}", key)
  match decode(rs_tok, key, Validation::new(Algorithm::HS256), 100L) {
    Err(JwtError::UnsupportedAlgorithm(_)) => ()
    _ => debug_assert(false, "must reject unsupported RS256")
  }
}

///|
test "security_reject_unrecognized_crit_header" {
  let key = "crit-secret".to_bytes()
  let validation = Validation::new(Algorithm::HS256)

  let tok1 = make_signed_raw(
    "{\"alg\":\"HS256\",\"crit\":[\"exp\"]}",
    "{\"sub\":\"alice\"}",
    key,
  )
  match decode(tok1, key, validation, 100L) {
    Err(JwtError::UnsupportedCriticalHeader(_)) => ()
    _ => debug_assert(false, "must reject crit header")
  }

  // RFC 7515 §4.1.11: empty crit array is also invalid
  let tok2 = make_signed_raw(
    "{\"alg\":\"HS256\",\"crit\":[]}",
    "{\"sub\":\"alice\"}",
    key,
  )
  match decode(tok2, key, validation, 100L) {
    Err(JwtError::UnsupportedCriticalHeader(_)) => ()
    Err(JwtError::InvalidHeader(_)) => ()
    _ => debug_assert(false, "must reject empty crit array")
  }
}

///|
test "security_reject_duplicate_json_keys_smuggling" {
  let key = "dup-secret".to_bytes()
  let validation = Validation::new(Algorithm::HS256)

  // Duplicate key in claims: claim smuggling
  let tok_dup_claim = make_signed_raw(
    "{\"alg\":\"HS256\",\"typ\":\"JWT\"}",
    "{\"sub\":\"user\",\"sub\":\"admin\"}",
    key,
  )
  match decode(tok_dup_claim, key, validation, 100L) {
    Err(JwtError::DuplicateJsonKey(_)) => ()
    _ => debug_assert(false, "must reject duplicate claim key")
  }

  // Duplicate key in header
  let tok_dup_hdr = make_signed_raw(
    "{\"alg\":\"HS256\",\"alg\":\"HS256\"}",
    "{\"sub\":\"user\"}",
    key,
  )
  match decode(tok_dup_hdr, key, validation, 100L) {
    Err(JwtError::DuplicateJsonKey(_)) => ()
    _ => debug_assert(false, "must reject duplicate header key")
  }
}

///|
test "security_reject_json_nesting_bomb_and_oversized_token" {
  let key = "dos-secret".to_bytes()
  let validation = Validation::new(Algorithm::HS256)

  // Nesting depth > 32
  let sb = StringBuilder::new()
  sb.write_string("{\"a\":")
  let mut d = 0
  while d < 40 {
    sb.write_string("[")
    d = d + 1
  }
  sb.write_string("1")
  d = 0
  while d < 40 {
    sb.write_string("]")
    d = d + 1
  }
  sb.write_string("}")
  let tok_deep = make_signed_raw("{\"alg\":\"HS256\"}", sb.to_string(), key)
  match decode(tok_deep, key, validation, 100L) {
    Err(JwtError::JsonDepthExceeded(_)) => ()
    _ => debug_assert(false, "must reject deep json bomb")
  }

  // Oversized token DoS (> max_token_bytes)
  let small_val = Validation::{
    algorithms: [Algorithm::HS256],
    leeway: 0L,
    validate_exp: false,
    validate_nbf: false,
    validate_aud: true,
    required_spec_claims: [],
    iss: None,
    aud: None,
    sub: None,
    max_token_bytes: 64,
    max_json_depth: 32,
  }
  let tok_ok = make_signed_raw("{\"alg\":\"HS256\"}", "{\"sub\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}", key)
  match decode(tok_ok, key, small_val, 100L) {
    Err(JwtError::TokenTooLarge(_, _)) => ()
    _ => debug_assert(false, "must reject oversized token")
  }
}

///|
test "security_reject_invalid_timestamps" {
  let key = "ts-secret".to_bytes()
  let validation = Validation::new(Algorithm::HS256)

  // RFC 7519 §2 fractional NumericDate: floor(exp), ceil(nbf)
  let tok_float = make_signed_raw("{\"alg\":\"HS256\"}", "{\"exp\":1700000000.5,\"nbf\":100.25}", key)
  match decode(tok_float, key, validation, 100L) {
    Err(JwtError::ImmatureSignature) => ()
    _ => debug_assert(false, "nbf=100.25 must ceil to 101 and be immature at 100")
  }
  match decode(tok_float, key, validation, 101L) {
    Ok(td) => {
      debug_assert(match td.claims.exp { Some(v) => v == 1700000000L None => false }, "exp floor")
      debug_assert(match td.claims.nbf { Some(v) => v == 101L None => false }, "nbf ceil")
    }
    Err(_) => debug_assert(false, "valid fractional NumericDate must be accepted")
  }
  match decode(tok_float, key, validation, 1700000000L) {
    Err(JwtError::ExpiredSignature) => ()
    _ => debug_assert(false, "exp=1700000000.5 floored to 1700000000 must expire at 1700000000")
  }

  // 64-bit overflow timestamp
  let tok_ovf = make_signed_raw(
    "{\"alg\":\"HS256\"}",
    "{\"exp\":99999999999999999999999}",
    key,
  )
  match decode(tok_ovf, key, validation, 100L) {
    Err(JwtError::InvalidClaims(_)) => ()
    Err(JwtError::InvalidJson(_)) => ()
    _ => debug_assert(false, "must reject overflow exp")
  }

  // String timestamp
  let tok_str = make_signed_raw("{\"alg\":\"HS256\"}", "{\"exp\":\"1700000000\"}", key)
  match decode(tok_str, key, validation, 100L) {
    Err(JwtError::InvalidClaims(_)) => ()
    _ => debug_assert(false, "must reject string exp")
  }
}

///|
test "security_strict_3_segments_and_tampering" {
  let key = "seg-secret".to_bytes()
  let validation = Validation::new(Algorithm::HS256)

  // Structural malformations
  let bad_tokens = [
    "",
    "abc",
    "a.b",
    "a.b.c.d",
    ".b.c",
    "a..c",
    "a.b.",
    " eyJhbGciOiJIUzI1NiJ9.e30.AAAA",
    "eyJhbGciOiJIUzI1NiJ9.e30.AAAA\n",
  ]
  let mut i = 0
  while i < bad_tokens.length() {
    match decode(bad_tokens[i], key, validation, 0L) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "must reject malformed segment token")
    }
    i = i + 1
  }

  // Non-canonical Base64URL signature malleability
  let valid_tok = make_signed_raw("{\"alg\":\"HS256\"}", "{\"sub\":\"alice\",\"exp\":4000000000}", key)
  match decode(valid_tok, key, validation, 0L) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "valid_tok must verify before tampering")
  }
  // HS256 signature is 32 bytes -> 43 Base64URL chars (rem == 3, low 2 bits of last char must be 0).
  // Flipping the lowest bit of the last char produces a non-canonical encoding of the SAME 32 bytes!
  let tb = valid_tok.to_bytes()
  let tlen = tb.length()
  let mut malleated = Bytes::new(tlen)
  let mut j = 0
  while j < tlen {
    malleated[j] = tb[j]
    j = j + 1
  }
  // Last char of 43-char b64url has value with low 2 bits == 0 (multiple of 4 in alphabet).
  // Moving it by +1 in the Base64URL alphabet sets bit 0 to 1 while keeping the top 4 bits identical!
  let last_c = malleated[tlen - 1].to_int()
  let next_c = if last_c == 90 { // 'Z' (25) -> shouldn't happen for mult of 4, handle generally
    97
  } else if last_c == 122 { // 'z'
    48
  } else if last_c == 57 { // '9'
    45
  } else if last_c == 45 { // '-'
    95
  } else if last_c == 95 { // '_'
    45
  } else {
    last_c + 1
  }
  malleated[tlen - 1] = next_c.to_byte()
  match decode(malleated.to_string(), key, validation, 0L) {
    Err(JwtError::InvalidBase64Url(_)) => ()
    Err(JwtError::InvalidSignature) => ()
    _ => debug_assert(false, "must reject malleated signature")
  }

  // Wrong key
  match decode(valid_tok, "wrong-secret".to_bytes(), validation, 0L) {
    Err(JwtError::InvalidSignature) => ()
    _ => debug_assert(false, "must reject wrong key")
  }
}

///|
test "security_redteam_f1_to_f9_regressions" {
  let key = "hardened-secret-key-0123456789abcdef".to_bytes()
  let now : Int64 = 1795400000L
  let fut : Int64 = 4000000000L

  // F1: empty HMAC secret rejected everywhere
  let base_claims = Claims::{
    iss: None,
    sub: Some("admin"),
    aud: None,
    exp: Some(fut),
    nbf: None,
    iat: None,
    jti: None,
    custom: Map::new(),
  }
  match encode(Header::new(Algorithm::HS256), base_claims, Bytes::new(0)) {
    Err(JwtError::InvalidKey(_)) => ()
    _ => debug_assert(false, "F1: encode must reject empty key")
  }
  let empty_signer = Signer::hmac(Algorithm::HS256, Bytes::new(0))
  match encode_with_signer(Header::new(Algorithm::HS256), base_claims, empty_signer) {
    Err(JwtError::InvalidKey(_)) => ()
    _ => debug_assert(false, "F1: Signer::hmac must reject empty key")
  }
  let forged = make_signed_raw("{\"alg\":\"HS256\"}", "{\"sub\":\"admin\",\"exp\":4000000000}", Bytes::new(0))
  match decode(forged, Bytes::new(0), Validation::new(Algorithm::HS256), now) {
    Err(JwtError::InvalidKey(_)) => ()
    _ => debug_assert(false, "F1: decode must reject empty key")
  }
  let empty_verifier = Verifier::hmac(Algorithm::HS256, Bytes::new(0))
  match decode_with_verifier(forged, empty_verifier, Validation::new(Algorithm::HS256), now) {
    Err(JwtError::InvalidKey(_)) => ()
    _ => debug_assert(false, "F1: Verifier::hmac must reject empty key")
  }
  match Jwk::from_json("{\"kty\":\"oct\",\"k\":\"\"}") {
    Err(JwtError::InvalidJwk(_)) => ()
    _ => debug_assert(false, "F1: Jwk::from_json must reject empty k")
  }
  let empty_jwk = Jwk::from_oct_key(Bytes::new(0), None, None, None)
  match Jwk::to_secret_bytes(empty_jwk) {
    Err(JwtError::InvalidJwk(_)) => ()
    _ => debug_assert(false, "F1: Jwk::to_secret_bytes must reject empty k")
  }

  // F2: Validation::new() requires exp by default
  let no_exp = make_signed_raw("{\"alg\":\"HS256\"}", "{\"sub\":\"admin\"}", key)
  match decode(no_exp, key, Validation::new(Algorithm::HS256), now) {
    Err(JwtError::MissingRequiredClaim(c)) => debug_assert(c == "exp", "F2: missing exp")
    _ => debug_assert(false, "F2: Validation::new must require exp")
  }

  // F3: Validation::new() rejects unexpected aud by default (RFC 7519 §4.1.3)
  let with_aud = make_signed_raw("{\"alg\":\"HS256\"}", "{\"sub\":\"alice\",\"aud\":\"billing\",\"exp\":4000000000}", key)
  match decode(with_aud, key, Validation::new(Algorithm::HS256), now) {
    Err(JwtError::InvalidAudience) => ()
    _ => debug_assert(false, "F3: Validation::new must reject unexpected aud")
  }
  let v_no_aud = Validation::{ ..Validation::new(Algorithm::HS256), validate_aud: false }
  match decode(with_aud, key, v_no_aud, now) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "F3: validate_aud=false must allow aud")
  }

  // F4: non-finite floats rejected on parse and encode; json_stringify emits valid JSON null
  match json_parse("1e400".to_bytes(), 8) {
    Err(JwtError::InvalidJson(_)) => ()
    _ => debug_assert(false, "F4: json_parse must reject 1e400")
  }
  debug_assert(json_stringify(JsonValue::Float(1.0 / 0.0)) == "null", "F4: +inf -> null")
  debug_assert(json_stringify(JsonValue::Float(-1.0 / 0.0)) == "null", "F4: -inf -> null")
  debug_assert(json_stringify(JsonValue::Float(0.0 / 0.0)) == "null", "F4: nan -> null")
  let nan_custom : Map[String, JsonValue] = Map::new()
  nan_custom.set("f", JsonValue::Float(0.0 / 0.0))
  match encode(Header::new(Algorithm::HS256), Claims::{ ..base_claims, custom: nan_custom }, key) {
    Err(JwtError::InvalidJson(_)) => ()
    _ => debug_assert(false, "F4: encode must reject non-finite float")
  }

  // F5: exact float rounding, -0.0 sign preservation, Float(1.0) roundtrip
  match json_parse("0.3".to_bytes(), 8) {
    Ok(JsonValue::Float(f)) => debug_assert(f == 0.3, "F5: 0.3 exact")
    _ => debug_assert(false, "F5: 0.3 parse")
  }
  match json_parse("1.7976931348623157e308".to_bytes(), 8) {
    Ok(JsonValue::Float(f)) => debug_assert(f == 1.7976931348623157e308, "F5: DBL_MAX exact")
    _ => debug_assert(false, "F5: DBL_MAX parse")
  }
  match json_parse("-0.0".to_bytes(), 8) {
    Ok(JsonValue::Float(f)) => debug_assert(1.0 / f < 0.0, "F5: -0.0 sign")
    _ => debug_assert(false, "F5: -0.0 parse")
  }
  debug_assert(json_stringify(JsonValue::Float(1.0)) == "1.0", "F5: Float(1.0) keeps .0")
  debug_assert(json_stringify(JsonValue::Float(-0.0)) == "-0.0", "F5: Float(-0.0) keeps -0.0")

  // F6: custom claim integer > i64::MAX falls back to Float
  let u64_tok = make_signed_raw("{\"alg\":\"HS256\"}", "{\"sub\":\"u\",\"id\":18446744073709551615,\"exp\":4000000000}", key)
  match decode(u64_tok, key, Validation::new(Algorithm::HS256), now) {
    Ok(td) =>
    match td.claims.custom.get("id") {
      Some(JsonValue::Float(_)) => ()
      _ => debug_assert(false, "F6: u64::MAX custom claim must parse as Float")
    }
    Err(_) => debug_assert(false, "F6: u64::MAX custom claim must not reject token")
  }

  // F8: huge leeway must not overflow now_unix + leeway
  let nbf_tok = make_signed_raw("{\"alg\":\"HS256\"}", "{\"sub\":\"a\",\"exp\":4000000000,\"nbf\":1000000000}", key)
  let v_huge_leeway = Validation::{ ..Validation::new(Algorithm::HS256), leeway: 9223372036854775807L }
  match decode(nbf_tok, key, v_huge_leeway, now) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "F8: i64::MAX leeway must not overflow nbf check")
  }

  // F9: hard nesting depth cap even when caller passes huge max_depth
  let deep = Bytes::new(400)
  let mut di = 0
  while di < 200 {
    deep[di] = (91).to_byte()
    deep[399 - di] = (93).to_byte()
    di = di + 1
  }
  match json_parse(deep, 2147483647) {
    Err(JwtError::JsonDepthExceeded(cap)) => debug_assert(cap == 128, "F9: hard cap 128")
    _ => debug_assert(false, "F9: json_parse must enforce hard depth cap")
  }
}
