///| Strict RFC 4648 §5 unpadded Base64URL compliance and malleability defense tests.

///|
test "base64url_rfc4648_vectors" {
  debug_assert(base64url_encode(Bytes::new(0)) == "", "empty")
  debug_assert(base64url_encode("f".to_bytes()) == "Zg", "f")
  debug_assert(base64url_encode("fo".to_bytes()) == "Zm8", "fo")
  debug_assert(base64url_encode("foo".to_bytes()) == "Zm9v", "foo")
  debug_assert(base64url_encode("foob".to_bytes()) == "Zm9vYg", "foob")
  debug_assert(base64url_encode("fooba".to_bytes()) == "Zm9vYmE", "fooba")
  debug_assert(base64url_encode("foobar".to_bytes()) == "Zm9vYmFy", "foobar")

  // Verify URL-safe alphabet (- and _ instead of + and /)
  let mut special = Bytes::new(3)
  special[0] = (0xFB).to_byte()
  special[1] = (0xFF).to_byte()
  special[2] = (0xBF).to_byte()
  debug_assert(base64url_encode(special) == "-_-_", "url-safe alphabet")

  // Round-trip all 256 byte values
  let mut all = Bytes::new(256)
  let mut i = 0
  while i < 256 {
    all[i] = i.to_byte()
    i = i + 1
  }
  let enc = base64url_encode(all)
  match base64url_decode(enc) {
    Ok(dec) => debug_assert(constant_time_eq(dec, all), "256-byte roundtrip")
    Err(_) => debug_assert(false, "256-byte decode failed")
  }
}

///|
test "base64url_strict_rejections" {
  // Reject standard Base64 '+' and '/'
  match base64url_decode("ab+c") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject +")
  }
  match base64url_decode("ab/c") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject /")
  }

  // Reject padding '='
  match base64url_decode("Zg==") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject ==")
  }
  match base64url_decode("Zm8=") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject =")
  }

  // Reject invalid length (len % 4 == 1)
  match base64url_decode("A") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject len 1")
  }
  match base64url_decode("AAAAA") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject len 5")
  }

  // Reject whitespace / non-ASCII
  match base64url_decode("Zm9v\n") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject newline")
  }
  match base64url_decode("Zm 9v") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject space")
  }
  let mut non_ascii = Bytes::new(4)
  non_ascii[0] = (65).to_byte()
  non_ascii[1] = (65).to_byte()
  non_ascii[2] = (65).to_byte()
  non_ascii[3] = (0x80).to_byte()
  match base64url_decode_bytes(non_ascii) {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject non-ASCII")
  }

  // Reject non-canonical trailing bits (rem == 2: low 4 bits of char[1] must be 0)
  // "AA" -> 0x00 (canonical), "AB".."AP" -> non-canonical!
  match base64url_decode("AA") {
    Ok(b) => debug_assert(b.length() == 1 && b[0].to_int() == 0, "AA canonical")
    Err(_) => debug_assert(false, "AA should decode")
  }
  match base64url_decode("AB") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject non-canonical AB")
  }
  match base64url_decode("AP") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject non-canonical AP")
  }
  match base64url_decode("Zh") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject non-canonical Zh (vs Zg)")
  }

  // Reject non-canonical trailing bits (rem == 3: low 2 bits of char[2] must be 0)
  // "AAA" -> 0x00, 0x00 (canonical), "AAB", "AAC", "AAD" -> non-canonical!
  match base64url_decode("AAA") {
    Ok(b) => debug_assert(b.length() == 2, "AAA canonical")
    Err(_) => debug_assert(false, "AAA should decode")
  }
  match base64url_decode("AAB") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject non-canonical AAB")
  }
  match base64url_decode("AAC") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject non-canonical AAC")
  }
  match base64url_decode("AAD") {
    Err(JwtError::InvalidBase64Url(_)) => ()
    _ => debug_assert(false, "must reject non-canonical AAD")
  }
}

test "c1_migrated_jwt_constants" {
  let algs = [Algorithm::HS256, Algorithm::HS384, Algorithm::HS512]
  for i = 0; i < algs.length(); i = i + 1 {
    for j = 0; j < algs.length(); j = j + 1 {
      debug_assert(algorithm_equals(algs[i], algs[j]) == (i == j), "algorithm_equals iff")
    }
    match algorithm_from_str(algorithm_as_str(algs[i])) {
      Ok(a) => debug_assert(algorithm_equals(a, algs[i]), "algorithm_from_str roundtrip")
      Err(_) => debug_assert(false, "expected Ok")
    }
  }
  debug_assert(!hmac_key_valid("".to_bytes()) && hmac_key_valid("k".to_bytes()), "hmac_key_valid")
  debug_assert(b64url_decode_byte((43).to_byte()) == -1 && b64url_decode_byte((47).to_byte()) == -1 && b64url_decode_byte((61).to_byte()) == -1, "b64url rejects invalid")
}
