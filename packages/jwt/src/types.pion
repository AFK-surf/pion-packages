///| Core types, errors, headers, claims, validation, JWK, and signer/verifier interfaces
///| for pure-Pion RFC 7515 (JWS), RFC 7517 (JWK), and RFC 7519 (JWT).

///|
pub enum Algorithm {
  HS256
  HS384
  HS512
}

///|
pub fn algorithm_as_str(a : Algorithm) -> String {
  match a {
    Algorithm::HS256 => "HS256"
    Algorithm::HS384 => "HS384"
    Algorithm::HS512 => "HS512"
  }
}

///|
pub fn algorithm_equals(a : Algorithm, b : Algorithm) -> Bool {
  match (a, b) {
    (Algorithm::HS256, Algorithm::HS256) => true
    (Algorithm::HS384, Algorithm::HS384) => true
    (Algorithm::HS512, Algorithm::HS512) => true
    _ => false
  }
}

///|
pub enum JsonValue {
  Null
  Bool(Bool)
  Int(Int64)
  Float(Double)
  Str(String)
  Arr(Array[JsonValue])
  Obj(Map[String, JsonValue])
}

///|
pub enum Audience {
  Single(String)
  Many(Array[String])
}

///|
pub struct Header {
  pub alg : Algorithm
  pub typ : Option[String]
  pub kid : Option[String]
  pub cty : Option[String]
  pub crit : Option[Array[String]]
  pub extra : Map[String, JsonValue]
}

///|
pub fn Header::new(alg : Algorithm) -> Header {
  Header::{
    alg: alg,
    typ: Some("JWT"),
    kid: None,
    cty: None,
    crit: None,
    extra: Map::new(),
  }
}

///|
pub struct Claims {
  pub iss : Option[String]
  pub sub : Option[String]
  pub aud : Option[Audience]
  pub exp : Option[Int64]
  pub nbf : Option[Int64]
  pub iat : Option[Int64]
  pub jti : Option[String]
  pub custom : Map[String, JsonValue]
}

///|
pub fn Claims::new() -> Claims {
  Claims::{
    iss: None,
    sub: None,
    aud: None,
    exp: None,
    nbf: None,
    iat: None,
    jti: None,
    custom: Map::new(),
  }
}

///|
pub struct Validation {
  pub algorithms : Array[Algorithm]
  pub leeway : Int64
  pub validate_exp : Bool
  pub validate_nbf : Bool
  pub required_spec_claims : Array[String]
  pub iss : Option[Array[String]]
  pub aud : Option[Array[String]]
  pub sub : Option[String]
  pub max_token_bytes : Int
  pub max_json_depth : Int
}

///|
pub fn Validation::new(alg : Algorithm) -> Validation {
  Validation::{
    algorithms: [alg],
    leeway: 0L,
    validate_exp: true,
    validate_nbf: true,
    required_spec_claims: [],
    iss: None,
    aud: None,
    sub: None,
    max_token_bytes: 16384,
    max_json_depth: 32,
  }
}

///|
pub fn Validation::with_algorithms(algs : Array[Algorithm]) -> Validation {
  Validation::{
    algorithms: algs,
    leeway: 0L,
    validate_exp: true,
    validate_nbf: true,
    required_spec_claims: [],
    iss: None,
    aud: None,
    sub: None,
    max_token_bytes: 16384,
    max_json_depth: 32,
  }
}

///|
pub struct TokenData {
  pub header : Header
  pub claims : Claims
}

///|
pub struct Jwk {
  pub kty : String
  pub k : Bytes
  pub kid : Option[String]
  pub alg : Option[String]
  pub key_use : Option[String]
}

///|
pub enum JwtError {
  InvalidTokenFormat(String)
  TokenTooLarge(Int, Int)
  InvalidBase64Url(String)
  InvalidUtf8(String)
  InvalidJson(String)
  DuplicateJsonKey(String)
  JsonDepthExceeded(Int)
  InvalidHeader(String)
  InvalidClaims(String)
  AlgorithmNoneNotAllowed
  UnsupportedAlgorithm(String)
  AlgorithmMismatch(String)
  EmptyAllowedAlgorithms
  UnsupportedCriticalHeader(String)
  InvalidSignature
  ExpiredSignature
  ImmatureSignature
  InvalidIssuer
  InvalidAudience
  InvalidSubject
  MissingRequiredClaim(String)
  InvalidJwk(String)
}

///|
pub struct Signer {
  pub alg : Algorithm
  pub sign_fn : (Bytes) -> Result[Bytes, JwtError]
}

///|
pub struct Verifier {
  pub alg : Algorithm
  pub verify_fn : (Bytes, Bytes) -> Result[Bool, JwtError]
}

///|
pub fn algorithm_from_str(s : String) -> Result[Algorithm, JwtError] {
  let _ = s
  Err(JwtError::UnsupportedAlgorithm("unimplemented"))
}
