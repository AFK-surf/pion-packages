///| Pure-Pion FIPS 180-4 SHA-256 / SHA-384 / SHA-512, RFC 4231 HMAC-SHA2,
///| and constant-time byte comparison.
///| Zero-copy block streaming with hoisted FixedArray round constants.

///|
let sha256_k : FixedArray[UInt] = [
  0x428a2f98U, 0x71374491U, 0xb5c0fbcfU, 0xe9b5dba5U, 0x3956c25bU, 0x59f111f1U, 0x923f82a4U,
  0xab1c5ed5U, 0xd807aa98U, 0x12835b01U, 0x243185beU, 0x550c7dc3U, 0x72be5d74U, 0x80deb1feU,
  0x9bdc06a7U, 0xc19bf174U, 0xe49b69c1U, 0xefbe4786U, 0x0fc19dc6U, 0x240ca1ccU, 0x2de92c6fU,
  0x4a7484aaU, 0x5cb0a9dcU, 0x76f988daU, 0x983e5152U, 0xa831c66dU, 0xb00327c8U, 0xbf597fc7U,
  0xc6e00bf3U, 0xd5a79147U, 0x06ca6351U, 0x14292967U, 0x27b70a85U, 0x2e1b2138U, 0x4d2c6dfcU,
  0x53380d13U, 0x650a7354U, 0x766a0abbU, 0x81c2c92eU, 0x92722c85U, 0xa2bfe8a1U, 0xa81a664bU,
  0xc24b8b70U, 0xc76c51a3U, 0xd192e819U, 0xd6990624U, 0xf40e3585U, 0x106aa070U, 0x19a4c116U,
  0x1e376c08U, 0x2748774cU, 0x34b0bcb5U, 0x391c0cb3U, 0x4ed8aa4aU, 0x5b9cca4fU, 0x682e6ff3U,
  0x748f82eeU, 0x78a5636fU, 0x84c87814U, 0x8cc70208U, 0x90befffaU, 0xa4506cebU, 0xbef9a3f7U,
  0xc67178f2U,
]

///|
let sha512_k : FixedArray[UInt64] = [
  0x428a2f98d728ae22UL, 0x7137449123ef65cdUL, 0xb5c0fbcfec4d3b2fUL, 0xe9b5dba58189dbbcUL,
  0x3956c25bf348b538UL, 0x59f111f1b605d019UL, 0x923f82a4af194f9bUL, 0xab1c5ed5da6d8118UL,
  0xd807aa98a3030242UL, 0x12835b0145706fbeUL, 0x243185be4ee4b28cUL, 0x550c7dc3d5ffb4e2UL,
  0x72be5d74f27b896fUL, 0x80deb1fe3b1696b1UL, 0x9bdc06a725c71235UL, 0xc19bf174cf692694UL,
  0xe49b69c19ef14ad2UL, 0xefbe4786384f25e3UL, 0x0fc19dc68b8cd5b5UL, 0x240ca1cc77ac9c65UL,
  0x2de92c6f592b0275UL, 0x4a7484aa6ea6e483UL, 0x5cb0a9dcbd41fbd4UL, 0x76f988da831153b5UL,
  0x983e5152ee66dfabUL, 0xa831c66d2db43210UL, 0xb00327c898fb213fUL, 0xbf597fc7beef0ee4UL,
  0xc6e00bf33da88fc2UL, 0xd5a79147930aa725UL, 0x06ca6351e003826fUL, 0x142929670a0e6e70UL,
  0x27b70a8546d22ffcUL, 0x2e1b21385c26c926UL, 0x4d2c6dfc5ac42aedUL, 0x53380d139d95b3dfUL,
  0x650a73548baf63deUL, 0x766a0abb3c77b2a8UL, 0x81c2c92e47edaee6UL, 0x92722c851482353bUL,
  0xa2bfe8a14cf10364UL, 0xa81a664bbc423001UL, 0xc24b8b70d0f89791UL, 0xc76c51a30654be30UL,
  0xd192e819d6ef5218UL, 0xd69906245565a910UL, 0xf40e35855771202aUL, 0x106aa07032bbd1b8UL,
  0x19a4c116b8d2d0c8UL, 0x1e376c085141ab53UL, 0x2748774cdf8eeb99UL, 0x34b0bcb5e19b48a8UL,
  0x391c0cb3c5c95a63UL, 0x4ed8aa4ae3418acbUL, 0x5b9cca4f7763e373UL, 0x682e6ff3d6b2b8a3UL,
  0x748f82ee5defb2fcUL, 0x78a5636f43172f60UL, 0x84c87814a1f0ab72UL, 0x8cc702081a6439ecUL,
  0x90befffa23631e28UL, 0xa4506cebde82bde9UL, 0xbef9a3f7b2c67915UL, 0xc67178f2e372532bUL,
  0xca273eceea26619cUL, 0xd186b8c721c0c207UL, 0xeada7dd6cde0eb1eUL, 0xf57d4f7fee6ed178UL,
  0x06f067aa72176fbaUL, 0x0a637dc5a2c898a6UL, 0x113f9804bef90daeUL, 0x1b710b35131c471bUL,
  0x28db77f523047d84UL, 0x32caab7b40c72493UL, 0x3c9ebe0a15c9bebcUL, 0x431d67c49c100d4cUL,
  0x4cc5d4becb3e42b6UL, 0x597f299cfc657e2aUL, 0x5fcb6fab3ad6faecUL, 0x6c44198c4a475817UL,
]

///|
fn rotr32(x : UInt, n : UInt) -> UInt {
  (x >> n) | (x << (32U - n))
}

///|
fn rotr64(x : UInt64, n : Int) -> UInt64 {
  let s : Int = 64 - n
  (x >> n) | (x << s)
}

///|
fn sha256_compress(
  state : FixedArray[UInt],
  buf : Bytes,
  off : Int,
  w : FixedArray[UInt],
) -> Unit {
  let k = sha256_k
  let mut i = 0
  while i < 16 {
    let p = off + i * 4
    let b0 = buf[p].to_int().to_uint()
    let b1 = buf[p + 1].to_int().to_uint()
    let b2 = buf[p + 2].to_int().to_uint()
    let b3 = buf[p + 3].to_int().to_uint()
    w[i] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    i = i + 1
  }
  while i < 64 {
    let w15 = w[i - 15]
    let s0 = rotr32(w15, 7U) ^ rotr32(w15, 18U) ^ (w15 >> 3U)
    let w2 = w[i - 2]
    let s1 = rotr32(w2, 17U) ^ rotr32(w2, 19U) ^ (w2 >> 10U)
    w[i] = w[i - 16] + s0 + w[i - 7] + s1
    i = i + 1
  }

  let mut a = state[0]
  let mut b = state[1]
  let mut c = state[2]
  let mut d = state[3]
  let mut e = state[4]
  let mut f = state[5]
  let mut g = state[6]
  let mut h = state[7]

  let mut r = 0
  while r < 64 {
    let s1 = rotr32(e, 6U) ^ rotr32(e, 11U) ^ rotr32(e, 25U)
    let ch = (e & f) ^ ((e ^ 0xFFFFFFFFU) & g)
    let temp1 = h + s1 + ch + k[r] + w[r]
    let s0 = rotr32(a, 2U) ^ rotr32(a, 13U) ^ rotr32(a, 22U)
    let maj = (a & b) ^ (a & c) ^ (b & c)
    let temp2 = s0 + maj

    h = g
    g = f
    f = e
    e = d + temp1
    d = c
    c = b
    b = a
    a = temp1 + temp2
    r = r + 1
  }

  state[0] = state[0] + a
  state[1] = state[1] + b
  state[2] = state[2] + c
  state[3] = state[3] + d
  state[4] = state[4] + e
  state[5] = state[5] + f
  state[6] = state[6] + g
  state[7] = state[7] + h
}

///|
fn sha256_finish(
  state : FixedArray[UInt],
  data : Bytes,
  start : Int,
  len : Int,
  total_bytes : Int64,
  w : FixedArray[UInt],
) -> Bytes {
  let mut off = start
  let end = start + len
  while off + 64 <= end {
    sha256_compress(state, data, off, w)
    off = off + 64
  }

  let rem = end - off
  let tail_len = if rem < 56 { 64 } else { 128 }
  let mut tail = Bytes::new(tail_len)
  let mut i = 0
  while i < rem {
    tail[i] = data[off + i]
    i = i + 1
  }
  tail[rem] = (0x80).to_byte()
  let bit_len : UInt64 = total_bytes.to_uint64() << 3
  tail[tail_len - 8] = ((bit_len >> 56) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 7] = ((bit_len >> 48) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 6] = ((bit_len >> 40) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 5] = ((bit_len >> 32) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 4] = ((bit_len >> 24) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 3] = ((bit_len >> 16) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 2] = ((bit_len >> 8) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 1] = (bit_len & 0xFFUL).to_int().to_byte()

  sha256_compress(state, tail, 0, w)
  if tail_len == 128 {
    sha256_compress(state, tail, 64, w)
  }

  let mut digest = Bytes::new(32)
  let mut wi = 0
  while wi < 8 {
    let v = state[wi]
    digest[wi * 4] = ((v >> 24U) & 0xFFU).to_int().to_byte()
    digest[wi * 4 + 1] = ((v >> 16U) & 0xFFU).to_int().to_byte()
    digest[wi * 4 + 2] = ((v >> 8U) & 0xFFU).to_int().to_byte()
    digest[wi * 4 + 3] = (v & 0xFFU).to_int().to_byte()
    wi = wi + 1
  }
  digest
}

///|
pub fn sha256(data : Bytes) -> Bytes {
  let state : FixedArray[UInt] = [
    0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU, 0x510e527fU, 0x9b05688cU, 0x1f83d9abU,
    0x5be0cd19U,
  ]
  let w : FixedArray[UInt] = FixedArray::make(64, 0U)
  sha256_finish(state, data, 0, data.length(), data.length().to_int64(), w)
}

///|
fn sha512_compress(
  state : FixedArray[UInt64],
  buf : Bytes,
  off : Int,
  w : FixedArray[UInt64],
) -> Unit {
  let k = sha512_k
  let mut i = 0
  while i < 16 {
    let p = off + i * 8
    let b0 = buf[p].to_int().to_int64().to_uint64()
    let b1 = buf[p + 1].to_int().to_int64().to_uint64()
    let b2 = buf[p + 2].to_int().to_int64().to_uint64()
    let b3 = buf[p + 3].to_int().to_int64().to_uint64()
    let b4 = buf[p + 4].to_int().to_int64().to_uint64()
    let b5 = buf[p + 5].to_int().to_int64().to_uint64()
    let b6 = buf[p + 6].to_int().to_int64().to_uint64()
    let b7 = buf[p + 7].to_int().to_int64().to_uint64()
    w[i] = (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7
    i = i + 1
  }
  while i < 80 {
    let w15 = w[i - 15]
    let s0 = rotr64(w15, 1) ^ rotr64(w15, 8) ^ (w15 >> 7)
    let w2 = w[i - 2]
    let s1 = rotr64(w2, 19) ^ rotr64(w2, 61) ^ (w2 >> 6)
    w[i] = w[i - 16] + s0 + w[i - 7] + s1
    i = i + 1
  }

  let mut a = state[0]
  let mut b = state[1]
  let mut c = state[2]
  let mut d = state[3]
  let mut e = state[4]
  let mut f = state[5]
  let mut g = state[6]
  let mut h = state[7]

  let mut r = 0
  while r < 80 {
    let s1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)
    let ch = (e & f) ^ ((e ^ 0xFFFFFFFFFFFFFFFFUL) & g)
    let temp1 = h + s1 + ch + k[r] + w[r]
    let s0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)
    let maj = (a & b) ^ (a & c) ^ (b & c)
    let temp2 = s0 + maj

    h = g
    g = f
    f = e
    e = d + temp1
    d = c
    c = b
    b = a
    a = temp1 + temp2
    r = r + 1
  }

  state[0] = state[0] + a
  state[1] = state[1] + b
  state[2] = state[2] + c
  state[3] = state[3] + d
  state[4] = state[4] + e
  state[5] = state[5] + f
  state[6] = state[6] + g
  state[7] = state[7] + h
}

///|
fn sha512_finish(
  state : FixedArray[UInt64],
  data : Bytes,
  start : Int,
  len : Int,
  total_bytes : Int64,
  w : FixedArray[UInt64],
  out_words : Int,
) -> Bytes {
  let mut off = start
  let end = start + len
  while off + 128 <= end {
    sha512_compress(state, data, off, w)
    off = off + 128
  }

  let rem = end - off
  let tail_len = if rem < 112 { 128 } else { 256 }
  let mut tail = Bytes::new(tail_len)
  let mut i = 0
  while i < rem {
    tail[i] = data[off + i]
    i = i + 1
  }
  tail[rem] = (0x80).to_byte()
  let bit_len_lo : UInt64 = total_bytes.to_uint64() << 3
  let bit_len_hi : UInt64 = total_bytes.to_uint64() >> 61
  tail[tail_len - 16] = ((bit_len_hi >> 56) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 15] = ((bit_len_hi >> 48) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 14] = ((bit_len_hi >> 40) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 13] = ((bit_len_hi >> 32) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 12] = ((bit_len_hi >> 24) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 11] = ((bit_len_hi >> 16) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 10] = ((bit_len_hi >> 8) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 9] = (bit_len_hi & 0xFFUL).to_int().to_byte()
  tail[tail_len - 8] = ((bit_len_lo >> 56) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 7] = ((bit_len_lo >> 48) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 6] = ((bit_len_lo >> 40) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 5] = ((bit_len_lo >> 32) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 4] = ((bit_len_lo >> 24) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 3] = ((bit_len_lo >> 16) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 2] = ((bit_len_lo >> 8) & 0xFFUL).to_int().to_byte()
  tail[tail_len - 1] = (bit_len_lo & 0xFFUL).to_int().to_byte()

  sha512_compress(state, tail, 0, w)
  if tail_len == 256 {
    sha512_compress(state, tail, 128, w)
  }

  let mut digest = Bytes::new(out_words * 8)
  let mut wi = 0
  while wi < out_words {
    let v = state[wi]
    digest[wi * 8] = ((v >> 56) & 0xFFUL).to_int().to_byte()
    digest[wi * 8 + 1] = ((v >> 48) & 0xFFUL).to_int().to_byte()
    digest[wi * 8 + 2] = ((v >> 40) & 0xFFUL).to_int().to_byte()
    digest[wi * 8 + 3] = ((v >> 32) & 0xFFUL).to_int().to_byte()
    digest[wi * 8 + 4] = ((v >> 24) & 0xFFUL).to_int().to_byte()
    digest[wi * 8 + 5] = ((v >> 16) & 0xFFUL).to_int().to_byte()
    digest[wi * 8 + 6] = ((v >> 8) & 0xFFUL).to_int().to_byte()
    digest[wi * 8 + 7] = (v & 0xFFUL).to_int().to_byte()
    wi = wi + 1
  }
  digest
}

///|
pub fn sha384(data : Bytes) -> Bytes {
  let state : FixedArray[UInt64] = [
    0xcbbb9d5dc1059ed8UL, 0x629a292a367cd507UL, 0x9159015a3070dd17UL, 0x152fecd8f70e5939UL,
    0x67332667ffc00b31UL, 0x8eb44a8768581511UL, 0xdb0c2e0d64f98fa7UL, 0x47b5481dbefa4fa4UL,
  ]
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)
  sha512_finish(state, data, 0, data.length(), data.length().to_int64(), w, 6)
}

///|
pub fn sha512(data : Bytes) -> Bytes {
  let state : FixedArray[UInt64] = [
    0x6a09e667f3bcc908UL, 0xbb67ae8584caa73bUL, 0x3c6ef372fe94f82bUL, 0xa54ff53a5f1d36f1UL,
    0x510e527fade682d1UL, 0x9b05688c2b3e6c1fUL, 0x1f83d9abfb41bd6bUL, 0x5be0cd19137e2179UL,
  ]
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)
  sha512_finish(state, data, 0, data.length(), data.length().to_int64(), w, 8)
}

///|
fn hmac_sha256_slice(key : Bytes, data : Bytes, start : Int, len : Int) -> Bytes {
  let k = if key.length() > 64 { sha256(key) } else { key }
  let klen = k.length()
  let mut ipad = Bytes::new(64)
  let mut opad = Bytes::new(64)
  let mut i = 0
  while i < 64 {
    let kb = if i < klen { k[i].to_int() } else { 0 }
    ipad[i] = (kb ^ 0x36).to_byte()
    opad[i] = (kb ^ 0x5C).to_byte()
    i = i + 1
  }

  let w : FixedArray[UInt] = FixedArray::make(64, 0U)
  // Inner hash: SHA256(ipad || data[start..start+len])
  let inner_state : FixedArray[UInt] = [
    0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU, 0x510e527fU, 0x9b05688cU, 0x1f83d9abU,
    0x5be0cd19U,
  ]
  sha256_compress(inner_state, ipad, 0, w)
  let inner_hash = sha256_finish(
    inner_state,
    data,
    start,
    len,
    (64 + len).to_int64(),
    w,
  )

  // Outer hash: SHA256(opad || inner_hash)
  let outer_state : FixedArray[UInt] = [
    0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU, 0x510e527fU, 0x9b05688cU, 0x1f83d9abU,
    0x5be0cd19U,
  ]
  sha256_compress(outer_state, opad, 0, w)
  sha256_finish(outer_state, inner_hash, 0, 32, 96L, w)
}

///|
fn hmac_sha512_family_slice(
  key : Bytes,
  data : Bytes,
  start : Int,
  len : Int,
  is_384 : Bool,
) -> Bytes {
  let k = if key.length() > 128 {
    if is_384 {
      sha384(key)
    } else {
      sha512(key)
    }
  } else {
    key
  }
  let klen = k.length()
  let mut ipad = Bytes::new(128)
  let mut opad = Bytes::new(128)
  let mut i = 0
  while i < 128 {
    let kb = if i < klen { k[i].to_int() } else { 0 }
    ipad[i] = (kb ^ 0x36).to_byte()
    opad[i] = (kb ^ 0x5C).to_byte()
    i = i + 1
  }

  let out_words = if is_384 { 6 } else { 8 }
  let hash_len = out_words * 8
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)

  let inner_state : FixedArray[UInt64] = if is_384 {
    [
      0xcbbb9d5dc1059ed8UL, 0x629a292a367cd507UL, 0x9159015a3070dd17UL, 0x152fecd8f70e5939UL,
      0x67332667ffc00b31UL, 0x8eb44a8768581511UL, 0xdb0c2e0d64f98fa7UL, 0x47b5481dbefa4fa4UL,
    ]
  } else {
    [
      0x6a09e667f3bcc908UL, 0xbb67ae8584caa73bUL, 0x3c6ef372fe94f82bUL, 0xa54ff53a5f1d36f1UL,
      0x510e527fade682d1UL, 0x9b05688c2b3e6c1fUL, 0x1f83d9abfb41bd6bUL, 0x5be0cd19137e2179UL,
    ]
  }
  sha512_compress(inner_state, ipad, 0, w)
  let inner_hash = sha512_finish(
    inner_state,
    data,
    start,
    len,
    (128 + len).to_int64(),
    w,
    out_words,
  )

  let outer_state : FixedArray[UInt64] = if is_384 {
    [
      0xcbbb9d5dc1059ed8UL, 0x629a292a367cd507UL, 0x9159015a3070dd17UL, 0x152fecd8f70e5939UL,
      0x67332667ffc00b31UL, 0x8eb44a8768581511UL, 0xdb0c2e0d64f98fa7UL, 0x47b5481dbefa4fa4UL,
    ]
  } else {
    [
      0x6a09e667f3bcc908UL, 0xbb67ae8584caa73bUL, 0x3c6ef372fe94f82bUL, 0xa54ff53a5f1d36f1UL,
      0x510e527fade682d1UL, 0x9b05688c2b3e6c1fUL, 0x1f83d9abfb41bd6bUL, 0x5be0cd19137e2179UL,
    ]
  }
  sha512_compress(outer_state, opad, 0, w)
  sha512_finish(
    outer_state,
    inner_hash,
    0,
    hash_len,
    (128 + hash_len).to_int64(),
    w,
    out_words,
  )
}

///|
pub fn hmac_sha256(key : Bytes, data : Bytes) -> Bytes {
  hmac_sha256_slice(key, data, 0, data.length())
}

///|
pub fn hmac_sha384(key : Bytes, data : Bytes) -> Bytes {
  hmac_sha512_family_slice(key, data, 0, data.length(), true)
}

///|
pub fn hmac_sha512(key : Bytes, data : Bytes) -> Bytes {
  hmac_sha512_family_slice(key, data, 0, data.length(), false)
}

///|
pub fn constant_time_eq(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut diff = 0
  let mut i = 0
  while i < n {
    diff = diff | (a[i].to_int() ^ b[i].to_int())
    i = i + 1
  }
  diff == 0
}
