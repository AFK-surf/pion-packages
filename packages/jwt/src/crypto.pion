///| Pure-Pion FIPS 180-4 SHA-256 / SHA-384 / SHA-512, RFC 4231 HMAC-SHA2,
///| and constant-time byte comparison.
///| Optimized with 8-way register-unrolled compression, hoisted FixedArray LUTs,
///| and zero-intermediate-buffer HMAC inner->outer chaining.

///|
let sha256_k : FixedArray[UInt] = [
  0x428a2f98U, 0x71374491U, 0xb5c0fbcfU, 0xe9b5dba5U, 0x3956c25bU, 0x59f111f1U, 0x923f82a4U,
  0xab1c5ed5U, 0xd807aa98U, 0x12835b01U, 0x243185beU, 0x550c7dc3U, 0x72be5d74U, 0x80deb1feU,
  0x9bdc06a7U, 0xc19bf174U, 0xe49b69c1U, 0xefbe4786U, 0x0fc19dc6U, 0x240ca1ccU, 0x2de92c6fU,
  0x4a7484aaU, 0x5cb0a9dcU, 0x76f988daU, 0x983e5152U, 0xa831c66dU, 0xb00327c8U, 0xbf597fc7U,
  0xc6e00bf3U, 0xd5a79147U, 0x06ca6351U, 0x14292967U, 0x27b70a85U, 0x2e1b2138U, 0x4d2c6dfcU,
  0x53380d13U, 0x650a7354U, 0x766a0abbU, 0x81c2c92eU, 0x92722c85U, 0xa2bfe8a1U, 0xa81a664bU,
  0xc24b8b70U, 0xc76c51a3U, 0xd192e819U, 0xd6990624U, 0xf40e3585U, 0x106aa070U, 0x19a4c116U,
  0x1e376c08U, 0x2748774cU, 0x34b0bcb5U, 0x391c0cb3U, 0x4ed8aa4aU, 0x5b9cca4fU, 0x682e6ff3U,
  0x748f82eeU, 0x78a5636fU, 0x84c87814U, 0x8cc70208U, 0x90befffaU, 0xa4506cebU, 0xbef9a3f7U,
  0xc67178f2U,
]

///|
let sha512_k : FixedArray[UInt64] = [
  0x428a2f98d728ae22UL, 0x7137449123ef65cdUL, 0xb5c0fbcfec4d3b2fUL, 0xe9b5dba58189dbbcUL,
  0x3956c25bf348b538UL, 0x59f111f1b605d019UL, 0x923f82a4af194f9bUL, 0xab1c5ed5da6d8118UL,
  0xd807aa98a3030242UL, 0x12835b0145706fbeUL, 0x243185be4ee4b28cUL, 0x550c7dc3d5ffb4e2UL,
  0x72be5d74f27b896fUL, 0x80deb1fe3b1696b1UL, 0x9bdc06a725c71235UL, 0xc19bf174cf692694UL,
  0xe49b69c19ef14ad2UL, 0xefbe4786384f25e3UL, 0x0fc19dc68b8cd5b5UL, 0x240ca1cc77ac9c65UL,
  0x2de92c6f592b0275UL, 0x4a7484aa6ea6e483UL, 0x5cb0a9dcbd41fbd4UL, 0x76f988da831153b5UL,
  0x983e5152ee66dfabUL, 0xa831c66d2db43210UL, 0xb00327c898fb213fUL, 0xbf597fc7beef0ee4UL,
  0xc6e00bf33da88fc2UL, 0xd5a79147930aa725UL, 0x06ca6351e003826fUL, 0x142929670a0e6e70UL,
  0x27b70a8546d22ffcUL, 0x2e1b21385c26c926UL, 0x4d2c6dfc5ac42aedUL, 0x53380d139d95b3dfUL,
  0x650a73548baf63deUL, 0x766a0abb3c77b2a8UL, 0x81c2c92e47edaee6UL, 0x92722c851482353bUL,
  0xa2bfe8a14cf10364UL, 0xa81a664bbc423001UL, 0xc24b8b70d0f89791UL, 0xc76c51a30654be30UL,
  0xd192e819d6ef5218UL, 0xd69906245565a910UL, 0xf40e35855771202aUL, 0x106aa07032bbd1b8UL,
  0x19a4c116b8d2d0c8UL, 0x1e376c085141ab53UL, 0x2748774cdf8eeb99UL, 0x34b0bcb5e19b48a8UL,
  0x391c0cb3c5c95a63UL, 0x4ed8aa4ae3418acbUL, 0x5b9cca4f7763e373UL, 0x682e6ff3d6b2b8a3UL,
  0x748f82ee5defb2fcUL, 0x78a5636f43172f60UL, 0x84c87814a1f0ab72UL, 0x8cc702081a6439ecUL,
  0x90befffa23631e28UL, 0xa4506cebde82bde9UL, 0xbef9a3f7b2c67915UL, 0xc67178f2e372532bUL,
  0xca273eceea26619cUL, 0xd186b8c721c0c207UL, 0xeada7dd6cde0eb1eUL, 0xf57d4f7fee6ed178UL,
  0x06f067aa72176fbaUL, 0x0a637dc5a2c898a6UL, 0x113f9804bef90daeUL, 0x1b710b35131c471bUL,
  0x28db77f523047d84UL, 0x32caab7b40c72493UL, 0x3c9ebe0a15c9bebcUL, 0x431d67c49c100d4cUL,
  0x4cc5d4becb3e42b6UL, 0x597f299cfc657e2aUL, 0x5fcb6fab3ad6faecUL, 0x6c44198c4a475817UL,
]

///|
fn sha256_compress_w(state : FixedArray[UInt], w : FixedArray[UInt]) -> Unit {
  let k = sha256_k
  let mut i = 16
  while i < 64 {
    let w15 = w[i - 15]
    let s0 = ((w15 >> 7U) | (w15 << 25U)) ^ ((w15 >> 18U) | (w15 << 14U)) ^ (w15 >> 3U)
    let w2 = w[i - 2]
    let s1 = ((w2 >> 17U) | (w2 << 15U)) ^ ((w2 >> 19U) | (w2 << 13U)) ^ (w2 >> 10U)
    w[i] = w[i - 16] + s0 + w[i - 7] + s1
    i = i + 1
  }

  let mut a = state[0]
  let mut b = state[1]
  let mut c = state[2]
  let mut d = state[3]
  let mut e = state[4]
  let mut f = state[5]
  let mut g = state[6]
  let mut h = state[7]

  let mut r = 0
  while r < 64 {
    // Round r + 0
    let t1_0 = h + (((e >> 6U) | (e << 26U)) ^ ((e >> 11U) | (e << 21U)) ^ ((e >> 25U) | (e << 7U))) + ((e & f) ^ ((e ^ 0xFFFFFFFFU) & g)) + k[r] + w[r]
    let t2_0 = (((a >> 2U) | (a << 30U)) ^ ((a >> 13U) | (a << 19U)) ^ ((a >> 22U) | (a << 10U))) + ((a & b) ^ (a & c) ^ (b & c))
    d = d + t1_0
    h = t1_0 + t2_0
    // Round r + 1
    let t1_1 = g + (((d >> 6U) | (d << 26U)) ^ ((d >> 11U) | (d << 21U)) ^ ((d >> 25U) | (d << 7U))) + ((d & e) ^ ((d ^ 0xFFFFFFFFU) & f)) + k[r + 1] + w[r + 1]
    let t2_1 = (((h >> 2U) | (h << 30U)) ^ ((h >> 13U) | (h << 19U)) ^ ((h >> 22U) | (h << 10U))) + ((h & a) ^ (h & b) ^ (a & b))
    c = c + t1_1
    g = t1_1 + t2_1
    // Round r + 2
    let t1_2 = f + (((c >> 6U) | (c << 26U)) ^ ((c >> 11U) | (c << 21U)) ^ ((c >> 25U) | (c << 7U))) + ((c & d) ^ ((c ^ 0xFFFFFFFFU) & e)) + k[r + 2] + w[r + 2]
    let t2_2 = (((g >> 2U) | (g << 30U)) ^ ((g >> 13U) | (g << 19U)) ^ ((g >> 22U) | (g << 10U))) + ((g & h) ^ (g & a) ^ (h & a))
    b = b + t1_2
    f = t1_2 + t2_2
    // Round r + 3
    let t1_3 = e + (((b >> 6U) | (b << 26U)) ^ ((b >> 11U) | (b << 21U)) ^ ((b >> 25U) | (b << 7U))) + ((b & c) ^ ((b ^ 0xFFFFFFFFU) & d)) + k[r + 3] + w[r + 3]
    let t2_3 = (((f >> 2U) | (f << 30U)) ^ ((f >> 13U) | (f << 19U)) ^ ((f >> 22U) | (f << 10U))) + ((f & g) ^ (f & h) ^ (g & h))
    a = a + t1_3
    e = t1_3 + t2_3
    // Round r + 4
    let t1_4 = d + (((a >> 6U) | (a << 26U)) ^ ((a >> 11U) | (a << 21U)) ^ ((a >> 25U) | (a << 7U))) + ((a & b) ^ ((a ^ 0xFFFFFFFFU) & c)) + k[r + 4] + w[r + 4]
    let t2_4 = (((e >> 2U) | (e << 30U)) ^ ((e >> 13U) | (e << 19U)) ^ ((e >> 22U) | (e << 10U))) + ((e & f) ^ (e & g) ^ (f & g))
    h = h + t1_4
    d = t1_4 + t2_4
    // Round r + 5
    let t1_5 = c + (((h >> 6U) | (h << 26U)) ^ ((h >> 11U) | (h << 21U)) ^ ((h >> 25U) | (h << 7U))) + ((h & a) ^ ((h ^ 0xFFFFFFFFU) & b)) + k[r + 5] + w[r + 5]
    let t2_5 = (((d >> 2U) | (d << 30U)) ^ ((d >> 13U) | (d << 19U)) ^ ((d >> 22U) | (d << 10U))) + ((d & e) ^ (d & f) ^ (e & f))
    g = g + t1_5
    c = t1_5 + t2_5
    // Round r + 6
    let t1_6 = b + (((g >> 6U) | (g << 26U)) ^ ((g >> 11U) | (g << 21U)) ^ ((g >> 25U) | (g << 7U))) + ((g & h) ^ ((g ^ 0xFFFFFFFFU) & a)) + k[r + 6] + w[r + 6]
    let t2_6 = (((c >> 2U) | (c << 30U)) ^ ((c >> 13U) | (c << 19U)) ^ ((c >> 22U) | (c << 10U))) + ((c & d) ^ (c & e) ^ (d & e))
    f = f + t1_6
    b = t1_6 + t2_6
    // Round r + 7
    let t1_7 = a + (((f >> 6U) | (f << 26U)) ^ ((f >> 11U) | (f << 21U)) ^ ((f >> 25U) | (f << 7U))) + ((f & g) ^ ((f ^ 0xFFFFFFFFU) & h)) + k[r + 7] + w[r + 7]
    let t2_7 = (((b >> 2U) | (b << 30U)) ^ ((b >> 13U) | (b << 19U)) ^ ((b >> 22U) | (b << 10U))) + ((b & c) ^ (b & d) ^ (c & d))
    e = e + t1_7
    a = t1_7 + t2_7

    r = r + 8
  }

  state[0] = state[0] + a
  state[1] = state[1] + b
  state[2] = state[2] + c
  state[3] = state[3] + d
  state[4] = state[4] + e
  state[5] = state[5] + f
  state[6] = state[6] + g
  state[7] = state[7] + h
}

///|
fn sha256_load_block(buf : Bytes, off : Int, w : FixedArray[UInt]) -> Unit {
  let mut i = 0
  while i < 16 {
    let p = off + (i << 2)
    let b0 = buf[p].to_int().to_uint()
    let b1 = buf[p + 1].to_int().to_uint()
    let b2 = buf[p + 2].to_int().to_uint()
    let b3 = buf[p + 3].to_int().to_uint()
    w[i] = (b0 << 24U) | (b1 << 16U) | (b2 << 8U) | b3
    i = i + 1
  }
}

///|
fn sha256_update_final_state(
  state : FixedArray[UInt],
  data : Bytes,
  start : Int,
  len : Int,
  total_bytes : Int64,
  w : FixedArray[UInt],
) -> Unit {
  let mut off = start
  let end = start + len
  while off + 64 <= end {
    sha256_load_block(data, off, w)
    sha256_compress_w(state, w)
    off = off + 64
  }

  let rem = end - off
  let mut i = 0
  while i < 16 {
    w[i] = 0U
    i = i + 1
  }
  let mut j = 0
  while j < rem {
    let shift : UInt = (24 - ((j & 3) << 3)).to_uint()
    w[j >> 2] = w[j >> 2] | (data[off + j].to_int().to_uint() << shift)
    j = j + 1
  }
  let pad_shift : UInt = (24 - ((rem & 3) << 3)).to_uint()
  w[rem >> 2] = w[rem >> 2] | (0x80U << pad_shift)

  let bit_len : UInt64 = total_bytes.to_uint64() << 3
  if rem >= 56 {
    sha256_compress_w(state, w)
    let mut k = 0
    while k < 14 {
      w[k] = 0U
      k = k + 1
    }
  }
  w[14] = ((bit_len >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
  w[15] = (bit_len & 0xFFFFFFFFUL).to_int().to_uint()
  sha256_compress_w(state, w)
}

///|
fn sha256_state_to_bytes(state : FixedArray[UInt]) -> Bytes {
  let mut digest = Bytes::new(32)
  let mut wi = 0
  while wi < 8 {
    let v = state[wi]
    let p = wi << 2
    digest[p] = ((v >> 24U) & 0xFFU).to_int().to_byte()
    digest[p + 1] = ((v >> 16U) & 0xFFU).to_int().to_byte()
    digest[p + 2] = ((v >> 8U) & 0xFFU).to_int().to_byte()
    digest[p + 3] = (v & 0xFFU).to_int().to_byte()
    wi = wi + 1
  }
  digest
}

///|
pub fn sha256(data : Bytes) -> Bytes {
  let state : FixedArray[UInt] = [
    0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU, 0x510e527fU, 0x9b05688cU, 0x1f83d9abU,
    0x5be0cd19U,
  ]
  let w : FixedArray[UInt] = FixedArray::make(64, 0U)
  sha256_update_final_state(
    state,
    data,
    0,
    data.length(),
    data.length().to_int64(),
    w,
  )
  sha256_state_to_bytes(state)
}

///|
fn sha512_compress_w(state : FixedArray[UInt64], w : FixedArray[UInt64]) -> Unit {
  let k = sha512_k
  let mut i = 16
  while i < 80 {
    let w15 = w[i - 15]
    let s0 = ((w15 >> 1) | (w15 << 63)) ^ ((w15 >> 8) | (w15 << 56)) ^ (w15 >> 7)
    let w2 = w[i - 2]
    let s1 = ((w2 >> 19) | (w2 << 45)) ^ ((w2 >> 61) | (w2 << 3)) ^ (w2 >> 6)
    w[i] = w[i - 16] + s0 + w[i - 7] + s1
    i = i + 1
  }

  let mut a = state[0]
  let mut b = state[1]
  let mut c = state[2]
  let mut d = state[3]
  let mut e = state[4]
  let mut f = state[5]
  let mut g = state[6]
  let mut h = state[7]

  let mut r = 0
  while r < 80 {
    // Round r + 0
    let t1_0 = h + (((e >> 14) | (e << 50)) ^ ((e >> 18) | (e << 46)) ^ ((e >> 41) | (e << 23))) + ((e & f) ^ ((e ^ 0xFFFFFFFFFFFFFFFFUL) & g)) + k[r] + w[r]
    let t2_0 = (((a >> 28) | (a << 36)) ^ ((a >> 34) | (a << 30)) ^ ((a >> 39) | (a << 25))) + ((a & b) ^ (a & c) ^ (b & c))
    d = d + t1_0
    h = t1_0 + t2_0
    // Round r + 1
    let t1_1 = g + (((d >> 14) | (d << 50)) ^ ((d >> 18) | (d << 46)) ^ ((d >> 41) | (d << 23))) + ((d & e) ^ ((d ^ 0xFFFFFFFFFFFFFFFFUL) & f)) + k[r + 1] + w[r + 1]
    let t2_1 = (((h >> 28) | (h << 36)) ^ ((h >> 34) | (h << 30)) ^ ((h >> 39) | (h << 25))) + ((h & a) ^ (h & b) ^ (a & b))
    c = c + t1_1
    g = t1_1 + t2_1
    // Round r + 2
    let t1_2 = f + (((c >> 14) | (c << 50)) ^ ((c >> 18) | (c << 46)) ^ ((c >> 41) | (c << 23))) + ((c & d) ^ ((c ^ 0xFFFFFFFFFFFFFFFFUL) & e)) + k[r + 2] + w[r + 2]
    let t2_2 = (((g >> 28) | (g << 36)) ^ ((g >> 34) | (g << 30)) ^ ((g >> 39) | (g << 25))) + ((g & h) ^ (g & a) ^ (h & a))
    b = b + t1_2
    f = t1_2 + t2_2
    // Round r + 3
    let t1_3 = e + (((b >> 14) | (b << 50)) ^ ((b >> 18) | (b << 46)) ^ ((b >> 41) | (b << 23))) + ((b & c) ^ ((b ^ 0xFFFFFFFFFFFFFFFFUL) & d)) + k[r + 3] + w[r + 3]
    let t2_3 = (((f >> 28) | (f << 36)) ^ ((f >> 34) | (f << 30)) ^ ((f >> 39) | (f << 25))) + ((f & g) ^ (f & h) ^ (g & h))
    a = a + t1_3
    e = t1_3 + t2_3
    // Round r + 4
    let t1_4 = d + (((a >> 14) | (a << 50)) ^ ((a >> 18) | (a << 46)) ^ ((a >> 41) | (a << 23))) + ((a & b) ^ ((a ^ 0xFFFFFFFFFFFFFFFFUL) & c)) + k[r + 4] + w[r + 4]
    let t2_4 = (((e >> 28) | (e << 36)) ^ ((e >> 34) | (e << 30)) ^ ((e >> 39) | (e << 25))) + ((e & f) ^ (e & g) ^ (f & g))
    h = h + t1_4
    d = t1_4 + t2_4
    // Round r + 5
    let t1_5 = c + (((h >> 14) | (h << 50)) ^ ((h >> 18) | (h << 46)) ^ ((h >> 41) | (h << 23))) + ((h & a) ^ ((h ^ 0xFFFFFFFFFFFFFFFFUL) & b)) + k[r + 5] + w[r + 5]
    let t2_5 = (((d >> 28) | (d << 36)) ^ ((d >> 34) | (d << 30)) ^ ((d >> 39) | (d << 25))) + ((d & e) ^ (d & f) ^ (e & f))
    g = g + t1_5
    c = t1_5 + t2_5
    // Round r + 6
    let t1_6 = b + (((g >> 14) | (g << 50)) ^ ((g >> 18) | (g << 46)) ^ ((g >> 41) | (g << 23))) + ((g & h) ^ ((g ^ 0xFFFFFFFFFFFFFFFFUL) & a)) + k[r + 6] + w[r + 6]
    let t2_6 = (((c >> 28) | (c << 36)) ^ ((c >> 34) | (c << 30)) ^ ((c >> 39) | (c << 25))) + ((c & d) ^ (c & e) ^ (d & e))
    f = f + t1_6
    b = t1_6 + t2_6
    // Round r + 7
    let t1_7 = a + (((f >> 14) | (f << 50)) ^ ((f >> 18) | (f << 46)) ^ ((f >> 41) | (f << 23))) + ((f & g) ^ ((f ^ 0xFFFFFFFFFFFFFFFFUL) & h)) + k[r + 7] + w[r + 7]
    let t2_7 = (((b >> 28) | (b << 36)) ^ ((b >> 34) | (b << 30)) ^ ((b >> 39) | (b << 25))) + ((b & c) ^ (b & d) ^ (c & d))
    e = e + t1_7
    a = t1_7 + t2_7

    r = r + 8
  }

  state[0] = state[0] + a
  state[1] = state[1] + b
  state[2] = state[2] + c
  state[3] = state[3] + d
  state[4] = state[4] + e
  state[5] = state[5] + f
  state[6] = state[6] + g
  state[7] = state[7] + h
}

///|
fn sha512_load_block(buf : Bytes, off : Int, w : FixedArray[UInt64]) -> Unit {
  let mut i = 0
  while i < 16 {
    let p = off + (i << 3)
    let b0 = buf[p].to_int().to_int64().to_uint64()
    let b1 = buf[p + 1].to_int().to_int64().to_uint64()
    let b2 = buf[p + 2].to_int().to_int64().to_uint64()
    let b3 = buf[p + 3].to_int().to_int64().to_uint64()
    let b4 = buf[p + 4].to_int().to_int64().to_uint64()
    let b5 = buf[p + 5].to_int().to_int64().to_uint64()
    let b6 = buf[p + 6].to_int().to_int64().to_uint64()
    let b7 = buf[p + 7].to_int().to_int64().to_uint64()
    w[i] = (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7
    i = i + 1
  }
}

///|
fn sha512_update_final_state(
  state : FixedArray[UInt64],
  data : Bytes,
  start : Int,
  len : Int,
  total_bytes : Int64,
  w : FixedArray[UInt64],
) -> Unit {
  let mut off = start
  let end = start + len
  while off + 128 <= end {
    sha512_load_block(data, off, w)
    sha512_compress_w(state, w)
    off = off + 128
  }

  let rem = end - off
  let mut i = 0
  while i < 16 {
    w[i] = 0UL
    i = i + 1
  }
  let mut j = 0
  while j < rem {
    let shift = 56 - ((j & 7) << 3)
    w[j >> 3] = w[j >> 3] | (data[off + j].to_int().to_int64().to_uint64() << shift)
    j = j + 1
  }
  let pad_shift = 56 - ((rem & 7) << 3)
  w[rem >> 3] = w[rem >> 3] | (0x80UL << pad_shift)

  let bit_len_lo : UInt64 = total_bytes.to_uint64() << 3
  let bit_len_hi : UInt64 = total_bytes.to_uint64() >> 61
  if rem >= 112 {
    sha512_compress_w(state, w)
    let mut k = 0
    while k < 14 {
      w[k] = 0UL
      k = k + 1
    }
  }
  w[14] = bit_len_hi
  w[15] = bit_len_lo
  sha512_compress_w(state, w)
}

///|
fn sha512_state_to_bytes(state : FixedArray[UInt64], out_words : Int) -> Bytes {
  let mut digest = Bytes::new(out_words * 8)
  let mut wi = 0
  while wi < out_words {
    let v = state[wi]
    let p = wi << 3
    digest[p] = ((v >> 56) & 0xFFUL).to_int().to_byte()
    digest[p + 1] = ((v >> 48) & 0xFFUL).to_int().to_byte()
    digest[p + 2] = ((v >> 40) & 0xFFUL).to_int().to_byte()
    digest[p + 3] = ((v >> 32) & 0xFFUL).to_int().to_byte()
    digest[p + 4] = ((v >> 24) & 0xFFUL).to_int().to_byte()
    digest[p + 5] = ((v >> 16) & 0xFFUL).to_int().to_byte()
    digest[p + 6] = ((v >> 8) & 0xFFUL).to_int().to_byte()
    digest[p + 7] = (v & 0xFFUL).to_int().to_byte()
    wi = wi + 1
  }
  digest
}

///|
pub fn sha384(data : Bytes) -> Bytes {
  let state : FixedArray[UInt64] = [
    0xcbbb9d5dc1059ed8UL, 0x629a292a367cd507UL, 0x9159015a3070dd17UL, 0x152fecd8f70e5939UL,
    0x67332667ffc00b31UL, 0x8eb44a8768581511UL, 0xdb0c2e0d64f98fa7UL, 0x47b5481dbefa4fa4UL,
  ]
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)
  sha512_update_final_state(
    state,
    data,
    0,
    data.length(),
    data.length().to_int64(),
    w,
  )
  sha512_state_to_bytes(state, 6)
}

///|
pub fn sha512(data : Bytes) -> Bytes {
  let state : FixedArray[UInt64] = [
    0x6a09e667f3bcc908UL, 0xbb67ae8584caa73bUL, 0x3c6ef372fe94f82bUL, 0xa54ff53a5f1d36f1UL,
    0x510e527fade682d1UL, 0x9b05688c2b3e6c1fUL, 0x1f83d9abfb41bd6bUL, 0x5be0cd19137e2179UL,
  ]
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)
  sha512_update_final_state(
    state,
    data,
    0,
    data.length(),
    data.length().to_int64(),
    w,
  )
  sha512_state_to_bytes(state, 8)
}

///|
fn hmac_sha256_slice(key : Bytes, data : Bytes, start : Int, len : Int) -> Bytes {
  let k = if key.length() > 64 { sha256(key) } else { key }
  let klen = k.length()
  let w : FixedArray[UInt] = FixedArray::make(64, 0U)
  let state : FixedArray[UInt] = [
    0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU, 0x510e527fU, 0x9b05688cU, 0x1f83d9abU,
    0x5be0cd19U,
  ]

  // Build ipad block directly into w[0..16]
  let mut i = 0
  while i < 16 {
    let p = i << 2
    let b0 = if p < klen { k[p].to_int() } else { 0 }
    let b1 = if p + 1 < klen { k[p + 1].to_int() } else { 0 }
    let b2 = if p + 2 < klen { k[p + 2].to_int() } else { 0 }
    let b3 = if p + 3 < klen { k[p + 3].to_int() } else { 0 }
    w[i] = (((b0 ^ 0x36).to_uint() << 24U) | ((b1 ^ 0x36).to_uint() << 16U) | ((b2 ^ 0x36).to_uint() << 8U) | (b3 ^ 0x36).to_uint())
    i = i + 1
  }
  sha256_compress_w(state, w)
  sha256_update_final_state(state, data, start, len, (64 + len).to_int64(), w)

  // Save inner hash in local registers, then run outer hash directly via w[]
  let h0 = state[0]
  let h1 = state[1]
  let h2 = state[2]
  let h3 = state[3]
  let h4 = state[4]
  let h5 = state[5]
  let h6 = state[6]
  let h7 = state[7]

  state[0] = 0x6a09e667U
  state[1] = 0xbb67ae85U
  state[2] = 0x3c6ef372U
  state[3] = 0xa54ff53aU
  state[4] = 0x510e527fU
  state[5] = 0x9b05688cU
  state[6] = 0x1f83d9abU
  state[7] = 0x5be0cd19U

  let mut j = 0
  while j < 16 {
    let p = j << 2
    let b0 = if p < klen { k[p].to_int() } else { 0 }
    let b1 = if p + 1 < klen { k[p + 1].to_int() } else { 0 }
    let b2 = if p + 2 < klen { k[p + 2].to_int() } else { 0 }
    let b3 = if p + 3 < klen { k[p + 3].to_int() } else { 0 }
    w[j] = (((b0 ^ 0x5C).to_uint() << 24U) | ((b1 ^ 0x5C).to_uint() << 16U) | ((b2 ^ 0x5C).to_uint() << 8U) | (b3 ^ 0x5C).to_uint())
    j = j + 1
  }
  sha256_compress_w(state, w)

  // Outer final block: 32-byte inner hash + 0x80 + 0s + bit_len (96 * 8 = 768)
  w[0] = h0
  w[1] = h1
  w[2] = h2
  w[3] = h3
  w[4] = h4
  w[5] = h5
  w[6] = h6
  w[7] = h7
  w[8] = 0x80000000U
  w[9] = 0U
  w[10] = 0U
  w[11] = 0U
  w[12] = 0U
  w[13] = 0U
  w[14] = 0U
  w[15] = 768U
  sha256_compress_w(state, w)
  sha256_state_to_bytes(state)
}

///|
fn hmac_sha512_family_slice(
  key : Bytes,
  data : Bytes,
  start : Int,
  len : Int,
  is_384 : Bool,
) -> Bytes {
  let k = if key.length() > 128 {
    if is_384 {
      sha384(key)
    } else {
      sha512(key)
    }
  } else {
    key
  }
  let klen = k.length()
  let w : FixedArray[UInt64] = FixedArray::make(80, 0UL)
  let state : FixedArray[UInt64] = if is_384 {
    [
      0xcbbb9d5dc1059ed8UL, 0x629a292a367cd507UL, 0x9159015a3070dd17UL, 0x152fecd8f70e5939UL,
      0x67332667ffc00b31UL, 0x8eb44a8768581511UL, 0xdb0c2e0d64f98fa7UL, 0x47b5481dbefa4fa4UL,
    ]
  } else {
    [
      0x6a09e667f3bcc908UL, 0xbb67ae8584caa73bUL, 0x3c6ef372fe94f82bUL, 0xa54ff53a5f1d36f1UL,
      0x510e527fade682d1UL, 0x9b05688c2b3e6c1fUL, 0x1f83d9abfb41bd6bUL, 0x5be0cd19137e2179UL,
    ]
  }

  // Build ipad block directly into w[0..16]
  let mut i = 0
  while i < 16 {
    let p = i << 3
    let b0 = (if p < klen { k[p].to_int() } else { 0 }) ^ 0x36
    let b1 = (if p + 1 < klen { k[p + 1].to_int() } else { 0 }) ^ 0x36
    let b2 = (if p + 2 < klen { k[p + 2].to_int() } else { 0 }) ^ 0x36
    let b3 = (if p + 3 < klen { k[p + 3].to_int() } else { 0 }) ^ 0x36
    let b4 = (if p + 4 < klen { k[p + 4].to_int() } else { 0 }) ^ 0x36
    let b5 = (if p + 5 < klen { k[p + 5].to_int() } else { 0 }) ^ 0x36
    let b6 = (if p + 6 < klen { k[p + 6].to_int() } else { 0 }) ^ 0x36
    let b7 = (if p + 7 < klen { k[p + 7].to_int() } else { 0 }) ^ 0x36
    w[i] = (b0.to_int64().to_uint64() << 56) | (b1.to_int64().to_uint64() << 48) | (b2.to_int64().to_uint64() << 40) | (b3.to_int64().to_uint64() << 32) | (b4.to_int64().to_uint64() << 24) | (b5.to_int64().to_uint64() << 16) | (b6.to_int64().to_uint64() << 8) | b7.to_int64().to_uint64()
    i = i + 1
  }
  sha512_compress_w(state, w)
  sha512_update_final_state(state, data, start, len, (128 + len).to_int64(), w)

  let h0 = state[0]
  let h1 = state[1]
  let h2 = state[2]
  let h3 = state[3]
  let h4 = state[4]
  let h5 = state[5]
  let h6 = state[6]
  let h7 = state[7]

  if is_384 {
    state[0] = 0xcbbb9d5dc1059ed8UL
    state[1] = 0x629a292a367cd507UL
    state[2] = 0x9159015a3070dd17UL
    state[3] = 0x152fecd8f70e5939UL
    state[4] = 0x67332667ffc00b31UL
    state[5] = 0x8eb44a8768581511UL
    state[6] = 0xdb0c2e0d64f98fa7UL
    state[7] = 0x47b5481dbefa4fa4UL
  } else {
    state[0] = 0x6a09e667f3bcc908UL
    state[1] = 0xbb67ae8584caa73bUL
    state[2] = 0x3c6ef372fe94f82bUL
    state[3] = 0xa54ff53a5f1d36f1UL
    state[4] = 0x510e527fade682d1UL
    state[5] = 0x9b05688c2b3e6c1fUL
    state[6] = 0x1f83d9abfb41bd6bUL
    state[7] = 0x5be0cd19137e2179UL
  }

  let mut j = 0
  while j < 16 {
    let p = j << 3
    let b0 = (if p < klen { k[p].to_int() } else { 0 }) ^ 0x5C
    let b1 = (if p + 1 < klen { k[p + 1].to_int() } else { 0 }) ^ 0x5C
    let b2 = (if p + 2 < klen { k[p + 2].to_int() } else { 0 }) ^ 0x5C
    let b3 = (if p + 3 < klen { k[p + 3].to_int() } else { 0 }) ^ 0x5C
    let b4 = (if p + 4 < klen { k[p + 4].to_int() } else { 0 }) ^ 0x5C
    let b5 = (if p + 5 < klen { k[p + 5].to_int() } else { 0 }) ^ 0x5C
    let b6 = (if p + 6 < klen { k[p + 6].to_int() } else { 0 }) ^ 0x5C
    let b7 = (if p + 7 < klen { k[p + 7].to_int() } else { 0 }) ^ 0x5C
    w[j] = (b0.to_int64().to_uint64() << 56) | (b1.to_int64().to_uint64() << 48) | (b2.to_int64().to_uint64() << 40) | (b3.to_int64().to_uint64() << 32) | (b4.to_int64().to_uint64() << 24) | (b5.to_int64().to_uint64() << 16) | (b6.to_int64().to_uint64() << 8) | b7.to_int64().to_uint64()
    j = j + 1
  }
  sha512_compress_w(state, w)

  w[0] = h0
  w[1] = h1
  w[2] = h2
  w[3] = h3
  w[4] = h4
  w[5] = h5
  if is_384 {
    w[6] = 0x8000000000000000UL
    w[7] = 0UL
    w[8] = 0UL
    w[9] = 0UL
    w[10] = 0UL
    w[11] = 0UL
    w[12] = 0UL
    w[13] = 0UL
    w[14] = 0UL
    w[15] = 1408UL // (128 + 48) * 8
    sha512_compress_w(state, w)
    sha512_state_to_bytes(state, 6)
  } else {
    w[6] = h6
    w[7] = h7
    w[8] = 0x8000000000000000UL
    w[9] = 0UL
    w[10] = 0UL
    w[11] = 0UL
    w[12] = 0UL
    w[13] = 0UL
    w[14] = 0UL
    w[15] = 1536UL // (128 + 64) * 8
    sha512_compress_w(state, w)
    sha512_state_to_bytes(state, 8)
  }
}

///|
pub fn hmac_sha256(key : Bytes, data : Bytes) -> Bytes {
  hmac_sha256_slice(key, data, 0, data.length())
}

///|
pub fn hmac_sha384(key : Bytes, data : Bytes) -> Bytes {
  hmac_sha512_family_slice(key, data, 0, data.length(), true)
}

///|
pub fn hmac_sha512(key : Bytes, data : Bytes) -> Bytes {
  hmac_sha512_family_slice(key, data, 0, data.length(), false)
}

///|
#verify
pub fn sha256_rotr(x : UInt, n : UInt) -> UInt {
  (x >> n) | (x << (32U - n))
}

///|
#verify
pub fn sha256_ch(x : UInt, y : UInt, z : UInt) -> UInt {
  (x & y) ^ ((x ^ 0xFFFFFFFFU) & z)
}

///|
#verify
pub fn sha256_maj(x : UInt, y : UInt, z : UInt) -> UInt {
  (x & y) ^ (x & z) ^ (y & z)
}

///|
#verify
pub fn sha256_sigma0(x : UInt) -> UInt {
  sha256_rotr(x, 2U) ^ sha256_rotr(x, 13U) ^ sha256_rotr(x, 22U)
}

///|
#verify
pub fn sha256_sigma1(x : UInt) -> UInt {
  sha256_rotr(x, 6U) ^ sha256_rotr(x, 11U) ^ sha256_rotr(x, 25U)
}

///|
#verify
pub fn sha256_lsigma0(x : UInt) -> UInt {
  sha256_rotr(x, 7U) ^ sha256_rotr(x, 18U) ^ (x >> 3U)
}

///|
#verify
pub fn sha256_lsigma1(x : UInt) -> UInt {
  sha256_rotr(x, 17U) ^ sha256_rotr(x, 19U) ^ (x >> 10U)
}

///|
#verify
pub fn constant_time_eq(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut diff = 0
  let mut i = 0
  while i < n {
    diff = diff | (a[i].to_int() ^ b[i].to_int())
    i = i + 1
  }
  diff == 0
}
