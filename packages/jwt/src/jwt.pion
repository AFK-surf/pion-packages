///| RFC 7515 JWS / RFC 7519 JWT / RFC 7517 JWK encoding, decoding, and validation.

///|
fn hmac_for_alg(alg : Algorithm, key : Bytes, data : Bytes, start : Int, len : Int) -> Bytes {
  match alg {
    Algorithm::HS256 => hmac_sha256_slice(key, data, start, len)
    Algorithm::HS384 => hmac_sha512_family_slice(key, data, start, len, true)
    Algorithm::HS512 => hmac_sha512_family_slice(key, data, start, len, false)
  }
}

///|
pub fn Signer::hmac(alg : Algorithm, key : Bytes) -> Signer {
  Signer::{
    alg: alg,
    sign_fn: fn(msg : Bytes) -> Result[Bytes, JwtError] {
      if !hmac_key_valid(key) {
        return Err(JwtError::InvalidKey("HMAC key must not be empty"))
      }
      Ok(hmac_for_alg(alg, key, msg, 0, msg.length()))
    },
  }
}

///|
pub fn Verifier::hmac(alg : Algorithm, key : Bytes) -> Verifier {
  Verifier::{
    alg: alg,
    verify_fn: fn(msg : Bytes, sig : Bytes) -> Result[Bool, JwtError] {
      if !hmac_key_valid(key) {
        return Err(JwtError::InvalidKey("HMAC key must not be empty"))
      }
      let expected = hmac_for_alg(alg, key, msg, 0, msg.length())
      Ok(constant_time_eq(expected, sig))
    },
  }
}

///|
fn serialize_header(header : Header) -> Result[String, JwtError] {
  let sb = StringBuilder::new()
  sb.write_string("{\"alg\":")
  write_json_string(sb, algorithm_as_str(header.alg))
  match header.typ {
    Some(t) => {
      sb.write_string(",\"typ\":")
      write_json_string(sb, t)
    }
    None => ()
  }
  match header.kid {
    Some(k) => {
      sb.write_string(",\"kid\":")
      write_json_string(sb, k)
    }
    None => ()
  }
  match header.cty {
    Some(c) => {
      sb.write_string(",\"cty\":")
      write_json_string(sb, c)
    }
    None => ()
  }
  match header.crit {
    Some(cs) => {
      sb.write_string(",\"crit\":[")
      let mut i = 0
      while i < cs.length() {
        if i > 0 {
          sb.write_string(",")
        }
        write_json_string(sb, cs[i])
        i = i + 1
      }
      sb.write_string("]")
    }
    None => ()
  }
  if header.extra.length() > 0 {
    let eks = header.extra.keys()
    let mut i = 0
    while i < eks.length() {
      let k = eks[i]
      if k != "alg" && k != "typ" && k != "kid" && k != "cty" && k != "crit" {
        sb.write_string(",")
        write_json_string(sb, k)
        sb.write_string(":")
        match header.extra.get(k) {
          Some(v) =>
          match write_json_value_checked(sb, v) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          None => sb.write_string("null")
        }
      }
      i = i + 1
    }
  }
  sb.write_string("}")
  Ok(sb.to_string())
}

///|
fn serialize_claims(claims : Claims) -> Result[String, JwtError] {
  let sb = StringBuilder::new()
  sb.write_string("{")
  let mut first = true
  match claims.iss {
    Some(s) => {
      first = false
      sb.write_string("\"iss\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  match claims.sub {
    Some(s) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"sub\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  match claims.aud {
    Some(Audience::Single(s)) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"aud\":")
      write_json_string(sb, s)
    }
    Some(Audience::Many(arr)) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"aud\":[")
      let mut i = 0
      while i < arr.length() {
        if i > 0 {
          sb.write_string(",")
        }
        write_json_string(sb, arr[i])
        i = i + 1
      }
      sb.write_string("]")
    }
    None => ()
  }
  match claims.exp {
    Some(v) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"exp\":")
      sb.write_string(v.to_string())
    }
    None => ()
  }
  match claims.nbf {
    Some(v) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"nbf\":")
      sb.write_string(v.to_string())
    }
    None => ()
  }
  match claims.iat {
    Some(v) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"iat\":")
      sb.write_string(v.to_string())
    }
    None => ()
  }
  match claims.jti {
    Some(s) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"jti\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  if claims.custom.length() > 0 {
    let cks = claims.custom.keys()
    let mut i = 0
    while i < cks.length() {
      let k = cks[i]
      if k != "iss" && k != "sub" && k != "aud" && k != "exp" && k != "nbf" && k != "iat" && k != "jti" {
        if !first {
          sb.write_string(",")
        }
        first = false
        write_json_string(sb, k)
        sb.write_string(":")
        match claims.custom.get(k) {
          Some(v) =>
          match write_json_value_checked(sb, v) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          None => sb.write_string("null")
        }
      }
      i = i + 1
    }
  }
  sb.write_string("}")
  Ok(sb.to_string())
}

///|
fn build_signing_input(h_b64 : Bytes, p_b64 : Bytes) -> Bytes {
  let hlen = h_b64.length()
  let plen = p_b64.length()
  let mut out = Bytes::new(hlen + 1 + plen)
  let mut i = 0
  while i < hlen {
    out[i] = h_b64[i]
    i = i + 1
  }
  out[hlen] = (46).to_byte()
  let mut j = 0
  while j < plen {
    out[hlen + 1 + j] = p_b64[j]
    j = j + 1
  }
  out
}

///|
fn append_sig_to_token(signing_input : Bytes, sig_b64 : Bytes) -> String {
  let slen = signing_input.length()
  let tlen = sig_b64.length()
  let mut out = Bytes::new(slen + 1 + tlen)
  let mut i = 0
  while i < slen {
    out[i] = signing_input[i]
    i = i + 1
  }
  out[slen] = (46).to_byte()
  let mut j = 0
  while j < tlen {
    out[slen + 1 + j] = sig_b64[j]
    j = j + 1
  }
  out.to_string()
}

///|
pub fn encode(
  header : Header,
  claims : Claims,
  key : Bytes,
) -> Result[String, JwtError] {
  if !hmac_key_valid(key) {
    return Err(JwtError::InvalidKey("HMAC key must not be empty"))
  }
  let h_str = match serialize_header(header) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let p_str = match serialize_claims(claims) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let h_json = h_str.to_bytes()
  let p_json = p_str.to_bytes()
  let h_len = base64url_encoded_len(h_json.length())
  let p_len = base64url_encoded_len(p_json.length())
  let sig_raw_len = match header.alg {
    Algorithm::HS256 => 32
    Algorithm::HS384 => 48
    Algorithm::HS512 => 64
  }
  let sig_len = base64url_encoded_len(sig_raw_len)
  let total_len = h_len + 1 + p_len + 1 + sig_len
  let out = Bytes::new(total_len)
  let _ = base64url_encode_into(h_json, out, 0)
  out[h_len] = (46).to_byte()
  let _ = base64url_encode_into(p_json, out, h_len + 1)
  let dot2 = h_len + 1 + p_len
  let sig = hmac_for_alg(header.alg, key, out, 0, dot2)
  out[dot2] = (46).to_byte()
  let _ = base64url_encode_into(sig, out, dot2 + 1)
  Ok(out.to_string())
}

///|
pub fn encode_with_signer(
  header : Header,
  claims : Claims,
  signer : Signer,
) -> Result[String, JwtError] {
  if !algorithm_equals(header.alg, signer.alg) {
    return Err(JwtError::AlgorithmMismatch(algorithm_as_str(header.alg)))
  }
  let h_str = match serialize_header(header) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let p_str = match serialize_claims(claims) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let h_b64 = base64url_encode_bytes(h_str.to_bytes())
  let p_b64 = base64url_encode_bytes(p_str.to_bytes())
  let signing_input = build_signing_input(h_b64, p_b64)
  let sig = match (signer.sign_fn)(signing_input) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let sig_b64 = base64url_encode_bytes(sig)
  Ok(append_sig_to_token(signing_input, sig_b64))
}

///|
fn split_three_segments(tb : Bytes) -> Result[(Int, Int), JwtError] {
  let n = tb.length()
  let mut dot1 = -1
  let mut dot2 = -1
  let mut i = 0
  while i < n {
    if tb[i].to_int() == 46 {
      if dot1 < 0 {
        dot1 = i
      } else if dot2 < 0 {
        dot2 = i
      } else {
        return Err(JwtError::InvalidTokenFormat("more than 2 dots"))
      }
    }
    i = i + 1
  }
  if dot1 <= 0 || dot2 <= dot1 + 1 || dot2 >= n - 1 {
    return Err(JwtError::InvalidTokenFormat("expected 3 non-empty segments"))
  }
  Ok((dot1, dot2))
}

///|
///| Fast zero-allocation key scanner for standard 3-letter/4-letter JWT keys.
///| Returns:
///|   -1 = escaped or non-standard key (caller falls back to parse_string)
///|   1=alg, 2=typ, 3=kid, 4=cty, 5=crit
///|   11=iss, 12=sub, 13=aud, 14=exp, 15=nbf, 16=iat, 17=jti
fn scan_std_key(p : JsonParser, is_header : Bool) -> Int {
  let pos = p.pos
  if pos + 5 > p.len || p.buf[pos].to_int() != 34 {
    return -1
  }
  let c0 = p.buf[pos + 1].to_int()
  let c1 = p.buf[pos + 2].to_int()
  let c2 = p.buf[pos + 3].to_int()
  let c3 = p.buf[pos + 4].to_int()
  if c3 == 34 {
    if is_header {
      if c0 == 97 && c1 == 108 && c2 == 103 {
        p.pos = pos + 5
        return 1 // "alg"
      }
      if c0 == 116 && c1 == 121 && c2 == 112 {
        p.pos = pos + 5
        return 2 // "typ"
      }
      if c0 == 107 && c1 == 105 && c2 == 100 {
        p.pos = pos + 5
        return 3 // "kid"
      }
      if c0 == 99 && c1 == 116 && c2 == 121 {
        p.pos = pos + 5
        return 4 // "cty"
      }
    } else {
      if c0 == 105 && c1 == 115 && c2 == 115 {
        p.pos = pos + 5
        return 11 // "iss"
      }
      if c0 == 115 && c1 == 117 && c2 == 98 {
        p.pos = pos + 5
        return 12 // "sub"
      }
      if c0 == 97 && c1 == 117 && c2 == 100 {
        p.pos = pos + 5
        return 13 // "aud"
      }
      if c0 == 101 && c1 == 120 && c2 == 112 {
        p.pos = pos + 5
        return 14 // "exp"
      }
      if c0 == 110 && c1 == 98 && c2 == 102 {
        p.pos = pos + 5
        return 15 // "nbf"
      }
      if c0 == 105 && c1 == 97 && c2 == 116 {
        p.pos = pos + 5
        return 16 // "iat"
      }
      if c0 == 106 && c1 == 116 && c2 == 105 {
        p.pos = pos + 5
        return 17 // "jti"
      }
    }
    return -1
  }
  if is_header && pos + 6 <= p.len && p.buf[pos + 5].to_int() == 34 {
    if c0 == 99 && c1 == 114 && c2 == 105 && c3 == 116 {
      p.pos = pos + 6
      return 5 // "crit"
    }
  }
  -1
}

///|
fn parse_header_json(raw : Bytes, max_depth : Int) -> Result[Header, JwtError] {
  if !validate_utf8(raw) {
    return Err(JwtError::InvalidUtf8("invalid UTF-8 sequence"))
  }
  let p = JsonParser::{
    buf: raw,
    len: raw.length(),
    pos: 0,
    max_depth: clamp_json_depth(max_depth),
  }
  skip_ws(p)
  if p.pos >= p.len || p.buf[p.pos].to_int() != 123 {
    return Err(JwtError::InvalidHeader("header must be a JSON object"))
  }
  p.pos = p.pos + 1
  skip_ws(p)

  let mut alg_opt : Option[Algorithm] = None
  let mut typ : Option[String] = None
  let mut kid : Option[String] = None
  let mut cty : Option[String] = None
  let mut seen_std = 0
  let extra : Map[String, JsonValue] = Map::new()

  if p.pos < p.len && p.buf[p.pos].to_int() == 125 {
    p.pos = p.pos + 1
  } else {
    while true {
      skip_ws(p)
      let std_id = scan_std_key(p, true)
      let key = if std_id > 0 {
        ""
      } else {
        match parse_string(p) {
          Ok(k) => k
          Err(e) => return Err(e)
        }
      }
      skip_ws(p)
      if p.pos >= p.len || p.buf[p.pos].to_int() != 58 {
        return Err(JwtError::InvalidJson("expected ':'"))
      }
      p.pos = p.pos + 1
      skip_ws(p)

      let kid_num = if std_id > 0 {
        std_id
      } else if key == "alg" {
        1
      } else if key == "typ" {
        2
      } else if key == "kid" {
        3
      } else if key == "cty" {
        4
      } else if key == "crit" {
        5
      } else {
        0
      }

      if kid_num == 1 {
        if (seen_std & 1) != 0 {
          return Err(JwtError::DuplicateJsonKey("alg"))
        }
        seen_std = seen_std | 1
        let s = match parse_string(p) {
          Ok(s) => s
          Err(_) => return Err(JwtError::InvalidHeader("missing or non-string 'alg'"))
        }
        match algorithm_from_str(s) {
          Ok(a) => alg_opt = Some(a)
          Err(e) => return Err(e)
        }
      } else if kid_num == 2 {
        if (seen_std & 2) != 0 {
          return Err(JwtError::DuplicateJsonKey("typ"))
        }
        seen_std = seen_std | 2
        let s = match parse_string(p) {
          Ok(s) => s
          Err(_) => return Err(JwtError::InvalidHeader("'typ' must be a string"))
        }
        typ = Some(s)
      } else if kid_num == 3 {
        if (seen_std & 4) != 0 {
          return Err(JwtError::DuplicateJsonKey("kid"))
        }
        seen_std = seen_std | 4
        let s = match parse_string(p) {
          Ok(s) => s
          Err(_) => return Err(JwtError::InvalidHeader("'kid' must be a string"))
        }
        kid = Some(s)
      } else if kid_num == 4 {
        if (seen_std & 8) != 0 {
          return Err(JwtError::DuplicateJsonKey("cty"))
        }
        seen_std = seen_std | 8
        let s = match parse_string(p) {
          Ok(s) => s
          Err(_) => return Err(JwtError::InvalidHeader("'cty' must be a string"))
        }
        cty = Some(s)
      } else if kid_num == 5 {
        if (seen_std & 16) != 0 {
          return Err(JwtError::DuplicateJsonKey("crit"))
        }
        seen_std = seen_std | 16
        let v = match parse_value(p, 1) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        match v {
          JsonValue::Arr(arr) => {
            if arr.length() == 0 {
              return Err(JwtError::UnsupportedCriticalHeader("empty crit array"))
            }
            match arr[0] {
              JsonValue::Str(first_ext) => return Err(JwtError::UnsupportedCriticalHeader(first_ext))
              _ => return Err(JwtError::UnsupportedCriticalHeader("invalid crit entry"))
            }
          }
          _ => return Err(JwtError::UnsupportedCriticalHeader("crit must be an array"))
        }
      } else {
        if extra.contains(key) {
          return Err(JwtError::DuplicateJsonKey(key))
        }
        let v = match parse_value(p, 1) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        extra.set(key, v)
      }

      skip_ws(p)
      if p.pos >= p.len {
        return Err(JwtError::InvalidJson("unterminated object"))
      }
      let sep = p.buf[p.pos].to_int()
      if sep == 44 {
        p.pos = p.pos + 1
      } else if sep == 125 {
        p.pos = p.pos + 1
        break
      } else {
        return Err(JwtError::InvalidJson("expected ',' or '}'"))
      }
    }
  }

  skip_ws(p)
  if p.pos != p.len {
    return Err(JwtError::InvalidJson("trailing data after JSON value"))
  }

  let alg = match alg_opt {
    Some(a) => a
    None => return Err(JwtError::InvalidHeader("missing or non-string 'alg'"))
  }

  Ok(Header::{
    alg: alg,
    typ: typ,
    kid: kid,
    cty: cty,
    crit: None,
    extra: extra,
  })
}

///|
///| Convert a finite IEEE 754 Double NumericDate (RFC 7519 §2) into Int64 with
///| conservative rounding: floor for `exp`/`iat`, ceil for `nbf`.
///| Rejects non-finite values and anything outside Int64 range.
fn numeric_date_from_float(f : Double, round_up : Bool, name : String) -> Result[Int64, JwtError] {
  if !is_finite_double(f) || f <= -9223372036854775808.0 || f >= 9223372036854775808.0 {
    return Err(JwtError::InvalidClaims("'" + name + "' NumericDate out of Int64 range"))
  }
  let t = f.to_int64()
  let tf = t.to_double()
  if round_up {
    Ok(if f > tf { t + 1L } else { t })
  } else {
    Ok(if f < tf { t - 1L } else { t })
  }
}

///|
fn parse_claims_json(raw : Bytes, max_depth : Int) -> Result[Claims, JwtError] {
  if !validate_utf8(raw) {
    return Err(JwtError::InvalidUtf8("invalid UTF-8 sequence"))
  }
  let p = JsonParser::{
    buf: raw,
    len: raw.length(),
    pos: 0,
    max_depth: clamp_json_depth(max_depth),
  }
  skip_ws(p)
  if p.pos >= p.len || p.buf[p.pos].to_int() != 123 {
    return Err(JwtError::InvalidClaims("claims must be a JSON object"))
  }
  p.pos = p.pos + 1
  skip_ws(p)

  let mut iss : Option[String] = None
  let mut sub : Option[String] = None
  let mut aud : Option[Audience] = None
  let mut exp : Option[Int64] = None
  let mut nbf : Option[Int64] = None
  let mut iat : Option[Int64] = None
  let mut jti : Option[String] = None
  let mut seen_std = 0
  let custom : Map[String, JsonValue] = Map::new()

  if p.pos < p.len && p.buf[p.pos].to_int() == 125 {
    p.pos = p.pos + 1
  } else {
    while true {
      skip_ws(p)
      let std_id = scan_std_key(p, false)
      let key = if std_id > 0 {
        ""
      } else {
        match parse_string(p) {
          Ok(k) => k
          Err(e) => return Err(e)
        }
      }
      skip_ws(p)
      if p.pos >= p.len || p.buf[p.pos].to_int() != 58 {
        return Err(JwtError::InvalidJson("expected ':'"))
      }
      p.pos = p.pos + 1
      skip_ws(p)

      let cid = if std_id > 0 {
        std_id
      } else if key == "iss" {
        11
      } else if key == "sub" {
        12
      } else if key == "aud" {
        13
      } else if key == "exp" {
        14
      } else if key == "nbf" {
        15
      } else if key == "iat" {
        16
      } else if key == "jti" {
        17
      } else {
        0
      }

      if cid == 11 {
        if (seen_std & 1) != 0 {
          return Err(JwtError::DuplicateJsonKey("iss"))
        }
        seen_std = seen_std | 1
        match parse_string(p) {
          Ok(s) => iss = Some(s)
          Err(_) => return Err(JwtError::InvalidClaims("'iss' must be a string"))
        }
      } else if cid == 12 {
        if (seen_std & 2) != 0 {
          return Err(JwtError::DuplicateJsonKey("sub"))
        }
        seen_std = seen_std | 2
        match parse_string(p) {
          Ok(s) => sub = Some(s)
          Err(_) => return Err(JwtError::InvalidClaims("'sub' must be a string"))
        }
      } else if cid == 13 {
        if (seen_std & 4) != 0 {
          return Err(JwtError::DuplicateJsonKey("aud"))
        }
        seen_std = seen_std | 4
        if p.pos < p.len && p.buf[p.pos].to_int() == 34 {
          match parse_string(p) {
            Ok(s) => aud = Some(Audience::Single(s))
            Err(e) => return Err(e)
          }
        } else {
          let v = match parse_value(p, 1) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match v {
            JsonValue::Arr(arr) => {
              let out : Array[String] = []
              let mut i = 0
              while i < arr.length() {
                match arr[i] {
                  JsonValue::Str(s) => out.push(s)
                  _ => return Err(JwtError::InvalidClaims("'aud' array must contain strings"))
                }
                i = i + 1
              }
              aud = Some(Audience::Many(out))
            }
            _ => return Err(JwtError::InvalidClaims("'aud' must be string or string array"))
          }
        }
      } else if cid == 14 {
        if (seen_std & 8) != 0 {
          return Err(JwtError::DuplicateJsonKey("exp"))
        }
        seen_std = seen_std | 8
        match parse_value(p, 1) {
          Ok(JsonValue::Int(n)) => exp = Some(n)
          Ok(JsonValue::Float(f)) =>
          match numeric_date_from_float(f, false, "exp") {
            Ok(n) => exp = Some(n)
            Err(e) => return Err(e)
          }
          Ok(_) => return Err(JwtError::InvalidClaims("'exp' must be a NumericDate"))
          Err(e) => return Err(e)
        }
      } else if cid == 15 {
        if (seen_std & 16) != 0 {
          return Err(JwtError::DuplicateJsonKey("nbf"))
        }
        seen_std = seen_std | 16
        match parse_value(p, 1) {
          Ok(JsonValue::Int(n)) => nbf = Some(n)
          Ok(JsonValue::Float(f)) =>
          match numeric_date_from_float(f, true, "nbf") {
            Ok(n) => nbf = Some(n)
            Err(e) => return Err(e)
          }
          Ok(_) => return Err(JwtError::InvalidClaims("'nbf' must be a NumericDate"))
          Err(e) => return Err(e)
        }
      } else if cid == 16 {
        if (seen_std & 32) != 0 {
          return Err(JwtError::DuplicateJsonKey("iat"))
        }
        seen_std = seen_std | 32
        match parse_value(p, 1) {
          Ok(JsonValue::Int(n)) => iat = Some(n)
          Ok(JsonValue::Float(f)) =>
          match numeric_date_from_float(f, false, "iat") {
            Ok(n) => iat = Some(n)
            Err(e) => return Err(e)
          }
          Ok(_) => return Err(JwtError::InvalidClaims("'iat' must be a NumericDate"))
          Err(e) => return Err(e)
        }
      } else if cid == 17 {
        if (seen_std & 64) != 0 {
          return Err(JwtError::DuplicateJsonKey("jti"))
        }
        seen_std = seen_std | 64
        match parse_string(p) {
          Ok(s) => jti = Some(s)
          Err(_) => return Err(JwtError::InvalidClaims("'jti' must be a string"))
        }
      } else {
        if custom.contains(key) {
          return Err(JwtError::DuplicateJsonKey(key))
        }
        let v = match parse_value(p, 1) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        custom.set(key, v)
      }

      skip_ws(p)
      if p.pos >= p.len {
        return Err(JwtError::InvalidJson("unterminated object"))
      }
      let sep = p.buf[p.pos].to_int()
      if sep == 44 {
        p.pos = p.pos + 1
      } else if sep == 125 {
        p.pos = p.pos + 1
        break
      } else {
        return Err(JwtError::InvalidJson("expected ',' or '}'"))
      }
    }
  }

  skip_ws(p)
  if p.pos != p.len {
    return Err(JwtError::InvalidJson("trailing data after JSON value"))
  }

  Ok(Claims::{
    iss: iss,
    sub: sub,
    aud: aud,
    exp: exp,
    nbf: nbf,
    iat: iat,
    jti: jti,
    custom: custom,
  })
}

///|
#verify
pub fn hmac_key_valid(key : Bytes) -> Bool {
  key.length() > 0
}

///|
#verify
pub fn alg_in_allowlist(alg : Algorithm, list : Array[Algorithm]) -> Bool {
  let mut i = 0
  while i < list.length() {
    if algorithm_equals(alg, list[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
#verify
pub fn check_verifier_alg(
  header_alg : Algorithm,
  verifier_alg : Algorithm,
  allowlist : Array[Algorithm],
) -> Bool {
  alg_in_allowlist(header_alg, allowlist) && algorithm_equals(header_alg, verifier_alg)
}

///|
fn str_in_array(target : String, arr : Array[String]) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

///| Saturating `a + b` for `b >= 0`.
#verify
pub fn saturating_add_nonneg(a : Int64, b : Int64) -> Int64 {
  let max_i64 : Int64 = 9223372036854775807L
  if a > max_i64 - b {
    max_i64
  } else {
    a + b
  }
}

///| Saturating `a - b` for `b >= 0`.
#verify
pub fn saturating_sub_nonneg(a : Int64, b : Int64) -> Int64 {
  let min_i64 : Int64 = -9223372036854775807L - 1L
  if a < min_i64 + b {
    min_i64
  } else {
    a - b
  }
}

///|
#verify
pub fn normalize_leeway(leeway : Int64) -> Int64 {
  if leeway < 0L {
    0L
  } else {
    leeway
  }
}

///|
#verify
pub fn is_expired(now_unix : Int64, exp_ts : Int64, leeway : Int64) -> Bool {
  let lw = normalize_leeway(leeway)
  saturating_sub_nonneg(now_unix, lw) >= exp_ts
}

///|
#verify
pub fn is_immature(now_unix : Int64, nbf_ts : Int64, leeway : Int64) -> Bool {
  let lw = normalize_leeway(leeway)
  saturating_add_nonneg(now_unix, lw) < nbf_ts
}

///|
fn validate_claims(
  claims : Claims,
  validation : Validation,
  now_unix : Int64,
) -> Result[Unit, JwtError] {
  // Required spec claims
  let mut i = 0
  while i < validation.required_spec_claims.length() {
    let req = validation.required_spec_claims[i]
    let ok = if req == "exp" {
      match claims.exp {
        Some(_) => true
        None => false
      }
    } else if req == "nbf" {
      match claims.nbf {
        Some(_) => true
        None => false
      }
    } else if req == "iat" {
      match claims.iat {
        Some(_) => true
        None => false
      }
    } else if req == "iss" {
      match claims.iss {
        Some(_) => true
        None => false
      }
    } else if req == "sub" {
      match claims.sub {
        Some(_) => true
        None => false
      }
    } else if req == "aud" {
      match claims.aud {
        Some(_) => true
        None => false
      }
    } else if req == "jti" {
      match claims.jti {
        Some(_) => true
        None => false
      }
    } else {
      claims.custom.contains(req)
    }
    if !ok {
      return Err(JwtError::MissingRequiredClaim(req))
    }
    i = i + 1
  }

  if validation.validate_exp {
    match claims.exp {
      Some(exp_ts) => {
        if is_expired(now_unix, exp_ts, validation.leeway) {
          return Err(JwtError::ExpiredSignature)
        }
      }
      None => ()
    }
  }

  if validation.validate_nbf {
    match claims.nbf {
      Some(nbf_ts) => {
        if is_immature(now_unix, nbf_ts, validation.leeway) {
          return Err(JwtError::ImmatureSignature)
        }
      }
      None => ()
    }
  }

  match validation.iss {
    Some(allowed_iss) => {
      match claims.iss {
        Some(actual_iss) => {
          if !str_in_array(actual_iss, allowed_iss) {
            return Err(JwtError::InvalidIssuer)
          }
        }
        None => return Err(JwtError::InvalidIssuer)
      }
    }
    None => ()
  }

  if validation.validate_aud {
    match validation.aud {
      Some(allowed_aud) => {
        match claims.aud {
          Some(Audience::Single(s)) => {
            if !str_in_array(s, allowed_aud) {
              return Err(JwtError::InvalidAudience)
            }
          }
          Some(Audience::Many(arr)) => {
            let mut matched = false
            let mut ai = 0
            while ai < arr.length() {
              if str_in_array(arr[ai], allowed_aud) {
                matched = true
                break
              }
              ai = ai + 1
            }
            if !matched {
              return Err(JwtError::InvalidAudience)
            }
          }
          None => return Err(JwtError::InvalidAudience)
        }
      }
      None => {
        match claims.aud {
          Some(_) => return Err(JwtError::InvalidAudience)
          None => ()
        }
      }
    }
  }

  match validation.sub {
    Some(expected_sub) => {
      match claims.sub {
        Some(actual_sub) => {
          if actual_sub != expected_sub {
            return Err(JwtError::InvalidSubject)
          }
        }
        None => return Err(JwtError::InvalidSubject)
      }
    }
    None => ()
  }

  Ok(())
}

///|
///| Unverified header preview (DO NOT trust `header.alg` to choose a verification key/algorithm).
pub fn decode_header(token : String) -> Result[Header, JwtError] {
  let tb = token.to_bytes()
  if tb.length() > 16384 {
    return Err(JwtError::TokenTooLarge(tb.length(), 16384))
  }
  let (dot1, _) = match split_three_segments(tb) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let hdr_raw = match base64url_decode_slice(tb, 0, dot1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  parse_header_json(hdr_raw, 32)
}

///|
pub fn decode(
  token : String,
  key : Bytes,
  validation : Validation,
  now_unix : Int64,
) -> Result[TokenData, JwtError] {
  if validation.algorithms.length() == 0 {
    return Err(JwtError::EmptyAllowedAlgorithms)
  }
  if !hmac_key_valid(key) {
    return Err(JwtError::InvalidKey("HMAC key must not be empty"))
  }
  let tb = token.to_bytes()
  if tb.length() > validation.max_token_bytes {
    return Err(JwtError::TokenTooLarge(tb.length(), validation.max_token_bytes))
  }
  let (dot1, dot2) = match split_three_segments(tb) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let hdr_raw = match base64url_decode_slice(tb, 0, dot1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let header = match parse_header_json(hdr_raw, validation.max_json_depth) {
    Ok(h) => h
    Err(e) => return Err(e)
  }
  if !alg_in_allowlist(header.alg, validation.algorithms) {
    return Err(JwtError::AlgorithmMismatch(algorithm_as_str(header.alg)))
  }

  let sig_raw = match base64url_decode_slice(tb, dot2 + 1, tb.length() - dot2 - 1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let expected_sig = hmac_for_alg(header.alg, key, tb, 0, dot2)
  if !constant_time_eq(expected_sig, sig_raw) {
    return Err(JwtError::InvalidSignature)
  }

  let pay_raw = match base64url_decode_slice(tb, dot1 + 1, dot2 - dot1 - 1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let claims = match parse_claims_json(pay_raw, validation.max_json_depth) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  match validate_claims(claims, validation, now_unix) {
    Ok(_) => Ok(TokenData::{ header: header, claims: claims })
    Err(e) => Err(e)
  }
}

///|
pub fn decode_with_verifier(
  token : String,
  verifier : Verifier,
  validation : Validation,
  now_unix : Int64,
) -> Result[TokenData, JwtError] {
  if validation.algorithms.length() == 0 {
    return Err(JwtError::EmptyAllowedAlgorithms)
  }
  let tb = token.to_bytes()
  if tb.length() > validation.max_token_bytes {
    return Err(JwtError::TokenTooLarge(tb.length(), validation.max_token_bytes))
  }
  let (dot1, dot2) = match split_three_segments(tb) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let hdr_raw = match base64url_decode_slice(tb, 0, dot1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let header = match parse_header_json(hdr_raw, validation.max_json_depth) {
    Ok(h) => h
    Err(e) => return Err(e)
  }
  if !check_verifier_alg(header.alg, verifier.alg, validation.algorithms) {
    return Err(JwtError::AlgorithmMismatch(algorithm_as_str(header.alg)))
  }

  let sig_raw = match base64url_decode_slice(tb, dot2 + 1, tb.length() - dot2 - 1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let mut signing_input = Bytes::new(dot2)
  let mut i = 0
  while i < dot2 {
    signing_input[i] = tb[i]
    i = i + 1
  }
  match (verifier.verify_fn)(signing_input, sig_raw) {
    Ok(true) => ()
    Ok(false) => return Err(JwtError::InvalidSignature)
    Err(e) => return Err(e)
  }

  let pay_raw = match base64url_decode_slice(tb, dot1 + 1, dot2 - dot1 - 1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let claims = match parse_claims_json(pay_raw, validation.max_json_depth) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  match validate_claims(claims, validation, now_unix) {
    Ok(_) => Ok(TokenData::{ header: header, claims: claims })
    Err(e) => Err(e)
  }
}

///|
pub fn Jwk::from_oct_key(
  key : Bytes,
  kid : Option[String],
  alg : Option[Algorithm],
  key_use : Option[String],
) -> Jwk {
  let alg_str = match alg {
    Some(a) => Some(algorithm_as_str(a))
    None => None
  }
  Jwk::{ kty: "oct", k: key, kid: kid, alg: alg_str, key_use: key_use }
}

///|
pub fn Jwk::to_json(self : Jwk) -> String {
  let sb = StringBuilder::new()
  sb.write_string("{\"kty\":")
  write_json_string(sb, self.kty)
  sb.write_string(",\"k\":")
  write_json_string(sb, base64url_encode(self.k))
  match self.kid {
    Some(s) => {
      sb.write_string(",\"kid\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  match self.alg {
    Some(s) => {
      sb.write_string(",\"alg\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  match self.key_use {
    Some(s) => {
      sb.write_string(",\"use\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  sb.write_string("}")
  sb.to_string()
}

///|
pub fn Jwk::from_json(json_str : String) -> Result[Jwk, JwtError] {
  let root = match json_parse(json_str.to_bytes(), 16) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let obj = match root {
    JsonValue::Obj(m) => m
    _ => return Err(JwtError::InvalidJwk("JWK must be a JSON object"))
  }
  let kty = match obj.get("kty") {
    Some(JsonValue::Str(s)) => s
    _ => return Err(JwtError::InvalidJwk("missing or non-string 'kty'"))
  }
  if kty != "oct" {
    return Err(JwtError::InvalidJwk("only 'oct' symmetric JWK is supported"))
  }
  let k_b64 = match obj.get("k") {
    Some(JsonValue::Str(s)) => s
    _ => return Err(JwtError::InvalidJwk("missing or non-string 'k'"))
  }
  let k_bytes = match base64url_decode(k_b64) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  if k_bytes.length() == 0 {
    return Err(JwtError::InvalidJwk("JWK 'k' secret must not be empty"))
  }
  let kid = match obj.get("kid") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidJwk("'kid' must be a string"))
    None => None
  }
  let alg = match obj.get("alg") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidJwk("'alg' must be a string"))
    None => None
  }
  let key_use = match obj.get("use") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidJwk("'use' must be a string"))
    None => None
  }
  Ok(Jwk::{ kty: kty, k: k_bytes, kid: kid, alg: alg, key_use: key_use })
}

///|
pub fn Jwk::to_secret_bytes(self : Jwk) -> Result[Bytes, JwtError] {
  if self.kty != "oct" {
    return Err(JwtError::InvalidJwk("not an 'oct' JWK"))
  }
  if self.k.length() == 0 {
    return Err(JwtError::InvalidJwk("JWK 'k' secret must not be empty"))
  }
  Ok(self.k)
}
