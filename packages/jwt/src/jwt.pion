///| RFC 7515 JWS / RFC 7519 JWT / RFC 7517 JWK encoding, decoding, and validation.

///|
fn hmac_for_alg(alg : Algorithm, key : Bytes, data : Bytes, start : Int, len : Int) -> Bytes {
  match alg {
    Algorithm::HS256 => hmac_sha256_slice(key, data, start, len)
    Algorithm::HS384 => hmac_sha512_family_slice(key, data, start, len, true)
    Algorithm::HS512 => hmac_sha512_family_slice(key, data, start, len, false)
  }
}

///|
pub fn Signer::hmac(alg : Algorithm, key : Bytes) -> Signer {
  Signer::{
    alg: alg,
    sign_fn: fn(msg : Bytes) -> Result[Bytes, JwtError] {
      Ok(hmac_for_alg(alg, key, msg, 0, msg.length()))
    },
  }
}

///|
pub fn Verifier::hmac(alg : Algorithm, key : Bytes) -> Verifier {
  Verifier::{
    alg: alg,
    verify_fn: fn(msg : Bytes, sig : Bytes) -> Result[Bool, JwtError] {
      let expected = hmac_for_alg(alg, key, msg, 0, msg.length())
      Ok(constant_time_eq(expected, sig))
    },
  }
}

///|
fn serialize_header(header : Header) -> String {
  let sb = StringBuilder::new()
  sb.write_string("{\"alg\":")
  write_json_string(sb, algorithm_as_str(header.alg))
  match header.typ {
    Some(t) => {
      sb.write_string(",\"typ\":")
      write_json_string(sb, t)
    }
    None => ()
  }
  match header.kid {
    Some(k) => {
      sb.write_string(",\"kid\":")
      write_json_string(sb, k)
    }
    None => ()
  }
  match header.cty {
    Some(c) => {
      sb.write_string(",\"cty\":")
      write_json_string(sb, c)
    }
    None => ()
  }
  match header.crit {
    Some(cs) => {
      sb.write_string(",\"crit\":[")
      let mut i = 0
      while i < cs.length() {
        if i > 0 {
          sb.write_string(",")
        }
        write_json_string(sb, cs[i])
        i = i + 1
      }
      sb.write_string("]")
    }
    None => ()
  }
  let eks = header.extra.keys()
  let mut i = 0
  while i < eks.length() {
    let k = eks[i]
    if k != "alg" && k != "typ" && k != "kid" && k != "cty" && k != "crit" {
      sb.write_string(",")
      write_json_string(sb, k)
      sb.write_string(":")
      match header.extra.get(k) {
        Some(v) => write_json_value(sb, v)
        None => sb.write_string("null")
      }
    }
    i = i + 1
  }
  sb.write_string("}")
  sb.to_string()
}

///|
fn serialize_claims(claims : Claims) -> String {
  let sb = StringBuilder::new()
  sb.write_string("{")
  let mut first = true
  match claims.iss {
    Some(s) => {
      first = false
      sb.write_string("\"iss\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  match claims.sub {
    Some(s) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"sub\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  match claims.aud {
    Some(Audience::Single(s)) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"aud\":")
      write_json_string(sb, s)
    }
    Some(Audience::Many(arr)) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"aud\":[")
      let mut i = 0
      while i < arr.length() {
        if i > 0 {
          sb.write_string(",")
        }
        write_json_string(sb, arr[i])
        i = i + 1
      }
      sb.write_string("]")
    }
    None => ()
  }
  match claims.exp {
    Some(v) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"exp\":")
      sb.write_string(v.to_string())
    }
    None => ()
  }
  match claims.nbf {
    Some(v) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"nbf\":")
      sb.write_string(v.to_string())
    }
    None => ()
  }
  match claims.iat {
    Some(v) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"iat\":")
      sb.write_string(v.to_string())
    }
    None => ()
  }
  match claims.jti {
    Some(s) => {
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string("\"jti\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  let cks = claims.custom.keys()
  let mut i = 0
  while i < cks.length() {
    let k = cks[i]
    if k != "iss" && k != "sub" && k != "aud" && k != "exp" && k != "nbf" && k != "iat" && k != "jti" {
      if !first {
        sb.write_string(",")
      }
      first = false
      write_json_string(sb, k)
      sb.write_string(":")
      match claims.custom.get(k) {
        Some(v) => write_json_value(sb, v)
        None => sb.write_string("null")
      }
    }
    i = i + 1
  }
  sb.write_string("}")
  sb.to_string()
}

///|
fn build_signing_input(h_b64 : Bytes, p_b64 : Bytes) -> Bytes {
  let hlen = h_b64.length()
  let plen = p_b64.length()
  let mut out = Bytes::new(hlen + 1 + plen)
  let mut i = 0
  while i < hlen {
    out[i] = h_b64[i]
    i = i + 1
  }
  out[hlen] = (46).to_byte()
  let mut j = 0
  while j < plen {
    out[hlen + 1 + j] = p_b64[j]
    j = j + 1
  }
  out
}

///|
fn append_sig_to_token(signing_input : Bytes, sig_b64 : Bytes) -> String {
  let slen = signing_input.length()
  let tlen = sig_b64.length()
  let mut out = Bytes::new(slen + 1 + tlen)
  let mut i = 0
  while i < slen {
    out[i] = signing_input[i]
    i = i + 1
  }
  out[slen] = (46).to_byte()
  let mut j = 0
  while j < tlen {
    out[slen + 1 + j] = sig_b64[j]
    j = j + 1
  }
  out.to_string()
}

///|
pub fn encode(
  header : Header,
  claims : Claims,
  key : Bytes,
) -> Result[String, JwtError] {
  let h_b64 = base64url_encode_bytes(serialize_header(header).to_bytes())
  let p_b64 = base64url_encode_bytes(serialize_claims(claims).to_bytes())
  let signing_input = build_signing_input(h_b64, p_b64)
  let sig = hmac_for_alg(header.alg, key, signing_input, 0, signing_input.length())
  let sig_b64 = base64url_encode_bytes(sig)
  Ok(append_sig_to_token(signing_input, sig_b64))
}

///|
pub fn encode_with_signer(
  header : Header,
  claims : Claims,
  signer : Signer,
) -> Result[String, JwtError] {
  if !algorithm_equals(header.alg, signer.alg) {
    return Err(JwtError::AlgorithmMismatch(algorithm_as_str(header.alg)))
  }
  let h_b64 = base64url_encode_bytes(serialize_header(header).to_bytes())
  let p_b64 = base64url_encode_bytes(serialize_claims(claims).to_bytes())
  let signing_input = build_signing_input(h_b64, p_b64)
  let sig = match (signer.sign_fn)(signing_input) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let sig_b64 = base64url_encode_bytes(sig)
  Ok(append_sig_to_token(signing_input, sig_b64))
}

///|
fn split_three_segments(tb : Bytes) -> Result[(Int, Int), JwtError] {
  let n = tb.length()
  let mut dot1 = -1
  let mut dot2 = -1
  let mut i = 0
  while i < n {
    if tb[i].to_int() == 46 {
      if dot1 < 0 {
        dot1 = i
      } else if dot2 < 0 {
        dot2 = i
      } else {
        return Err(JwtError::InvalidTokenFormat("more than 2 dots"))
      }
    }
    i = i + 1
  }
  if dot1 <= 0 || dot2 <= dot1 + 1 || dot2 >= n - 1 {
    return Err(JwtError::InvalidTokenFormat("expected 3 non-empty segments"))
  }
  Ok((dot1, dot2))
}

///|
fn parse_header_json(raw : Bytes, max_depth : Int) -> Result[Header, JwtError] {
  let root = match json_parse(raw, max_depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let obj = match root {
    JsonValue::Obj(m) => m
    _ => return Err(JwtError::InvalidHeader("header must be a JSON object"))
  }

  let alg = match obj.get("alg") {
    Some(JsonValue::Str(s)) => match algorithm_from_str(s) {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    _ => return Err(JwtError::InvalidHeader("missing or non-string 'alg'"))
  }

  // RFC 7515 §4.1.11: reject any crit header (unrecognized critical extensions or empty array)
  match obj.get("crit") {
    Some(JsonValue::Arr(arr)) => {
      if arr.length() == 0 {
        return Err(JwtError::UnsupportedCriticalHeader("empty crit array"))
      }
      match arr[0] {
        JsonValue::Str(first_ext) => return Err(JwtError::UnsupportedCriticalHeader(first_ext))
        _ => return Err(JwtError::UnsupportedCriticalHeader("invalid crit entry"))
      }
    }
    Some(_) => return Err(JwtError::UnsupportedCriticalHeader("crit must be an array"))
    None => ()
  }

  let typ = match obj.get("typ") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidHeader("'typ' must be a string"))
    None => None
  }
  let kid = match obj.get("kid") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidHeader("'kid' must be a string"))
    None => None
  }
  let cty = match obj.get("cty") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidHeader("'cty' must be a string"))
    None => None
  }

  let extra : Map[String, JsonValue] = Map::new()
  let ks = obj.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    if k != "alg" && k != "typ" && k != "kid" && k != "cty" && k != "crit" {
      match obj.get(k) {
        Some(v) => extra.set(k, v)
        None => ()
      }
    }
    i = i + 1
  }

  Ok(Header::{
    alg: alg,
    typ: typ,
    kid: kid,
    cty: cty,
    crit: None,
    extra: extra,
  })
}

///|
fn parse_claims_json(raw : Bytes, max_depth : Int) -> Result[Claims, JwtError] {
  let root = match json_parse(raw, max_depth) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let obj = match root {
    JsonValue::Obj(m) => m
    _ => return Err(JwtError::InvalidClaims("claims must be a JSON object"))
  }

  let iss = match obj.get("iss") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidClaims("'iss' must be a string"))
    None => None
  }
  let sub = match obj.get("sub") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidClaims("'sub' must be a string"))
    None => None
  }
  let aud = match obj.get("aud") {
    Some(JsonValue::Str(s)) => Some(Audience::Single(s))
    Some(JsonValue::Arr(arr)) => {
      let out : Array[String] = []
      let mut i = 0
      while i < arr.length() {
        match arr[i] {
          JsonValue::Str(s) => out.push(s)
          _ => return Err(JwtError::InvalidClaims("'aud' array must contain strings"))
        }
        i = i + 1
      }
      Some(Audience::Many(out))
    }
    Some(_) => return Err(JwtError::InvalidClaims("'aud' must be string or string array"))
    None => None
  }
  let exp = match obj.get("exp") {
    Some(JsonValue::Int(n)) => Some(n)
    Some(_) => return Err(JwtError::InvalidClaims("'exp' must be an integer NumericDate"))
    None => None
  }
  let nbf = match obj.get("nbf") {
    Some(JsonValue::Int(n)) => Some(n)
    Some(_) => return Err(JwtError::InvalidClaims("'nbf' must be an integer NumericDate"))
    None => None
  }
  let iat = match obj.get("iat") {
    Some(JsonValue::Int(n)) => Some(n)
    Some(_) => return Err(JwtError::InvalidClaims("'iat' must be an integer NumericDate"))
    None => None
  }
  let jti = match obj.get("jti") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidClaims("'jti' must be a string"))
    None => None
  }

  let custom : Map[String, JsonValue] = Map::new()
  let ks = obj.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    if k != "iss" && k != "sub" && k != "aud" && k != "exp" && k != "nbf" && k != "iat" && k != "jti" {
      match obj.get(k) {
        Some(v) => custom.set(k, v)
        None => ()
      }
    }
    i = i + 1
  }

  Ok(Claims::{
    iss: iss,
    sub: sub,
    aud: aud,
    exp: exp,
    nbf: nbf,
    iat: iat,
    jti: jti,
    custom: custom,
  })
}

///|
fn alg_in_allowlist(alg : Algorithm, list : Array[Algorithm]) -> Bool {
  let mut i = 0
  while i < list.length() {
    if algorithm_equals(alg, list[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn str_in_array(target : String, arr : Array[String]) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn validate_claims(
  claims : Claims,
  validation : Validation,
  now_unix : Int64,
) -> Result[Unit, JwtError] {
  // Required spec claims
  let mut i = 0
  while i < validation.required_spec_claims.length() {
    let req = validation.required_spec_claims[i]
    let ok = if req == "exp" {
      match claims.exp {
        Some(_) => true
        None => false
      }
    } else if req == "nbf" {
      match claims.nbf {
        Some(_) => true
        None => false
      }
    } else if req == "iat" {
      match claims.iat {
        Some(_) => true
        None => false
      }
    } else if req == "iss" {
      match claims.iss {
        Some(_) => true
        None => false
      }
    } else if req == "sub" {
      match claims.sub {
        Some(_) => true
        None => false
      }
    } else if req == "aud" {
      match claims.aud {
        Some(_) => true
        None => false
      }
    } else if req == "jti" {
      match claims.jti {
        Some(_) => true
        None => false
      }
    } else {
      claims.custom.contains(req)
    }
    if !ok {
      return Err(JwtError::MissingRequiredClaim(req))
    }
    i = i + 1
  }

  let leeway = if validation.leeway < 0L { 0L } else { validation.leeway }

  if validation.validate_exp {
    match claims.exp {
      Some(exp_ts) => {
        if now_unix - leeway >= exp_ts {
          return Err(JwtError::ExpiredSignature)
        }
      }
      None => ()
    }
  }

  if validation.validate_nbf {
    match claims.nbf {
      Some(nbf_ts) => {
        if now_unix + leeway < nbf_ts {
          return Err(JwtError::ImmatureSignature)
        }
      }
      None => ()
    }
  }

  match validation.iss {
    Some(allowed_iss) => {
      match claims.iss {
        Some(actual_iss) => {
          if !str_in_array(actual_iss, allowed_iss) {
            return Err(JwtError::InvalidIssuer)
          }
        }
        None => return Err(JwtError::InvalidIssuer)
      }
    }
    None => ()
  }

  match validation.aud {
    Some(allowed_aud) => {
      match claims.aud {
        Some(Audience::Single(s)) => {
          if !str_in_array(s, allowed_aud) {
            return Err(JwtError::InvalidAudience)
          }
        }
        Some(Audience::Many(arr)) => {
          let mut matched = false
          let mut ai = 0
          while ai < arr.length() {
            if str_in_array(arr[ai], allowed_aud) {
              matched = true
              break
            }
            ai = ai + 1
          }
          if !matched {
            return Err(JwtError::InvalidAudience)
          }
        }
        None => return Err(JwtError::InvalidAudience)
      }
    }
    None => ()
  }

  match validation.sub {
    Some(expected_sub) => {
      match claims.sub {
        Some(actual_sub) => {
          if actual_sub != expected_sub {
            return Err(JwtError::InvalidSubject)
          }
        }
        None => return Err(JwtError::InvalidSubject)
      }
    }
    None => ()
  }

  Ok(())
}

///|
///| Unverified header preview (DO NOT trust `header.alg` to choose a verification key/algorithm).
pub fn decode_header(token : String) -> Result[Header, JwtError] {
  let tb = token.to_bytes()
  if tb.length() > 16384 {
    return Err(JwtError::TokenTooLarge(tb.length(), 16384))
  }
  let (dot1, _) = match split_three_segments(tb) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let hdr_raw = match base64url_decode_slice(tb, 0, dot1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  parse_header_json(hdr_raw, 32)
}

///|
pub fn decode(
  token : String,
  key : Bytes,
  validation : Validation,
  now_unix : Int64,
) -> Result[TokenData, JwtError] {
  if validation.algorithms.length() == 0 {
    return Err(JwtError::EmptyAllowedAlgorithms)
  }
  let tb = token.to_bytes()
  if tb.length() > validation.max_token_bytes {
    return Err(JwtError::TokenTooLarge(tb.length(), validation.max_token_bytes))
  }
  let (dot1, dot2) = match split_three_segments(tb) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let hdr_raw = match base64url_decode_slice(tb, 0, dot1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let header = match parse_header_json(hdr_raw, validation.max_json_depth) {
    Ok(h) => h
    Err(e) => return Err(e)
  }
  if !alg_in_allowlist(header.alg, validation.algorithms) {
    return Err(JwtError::AlgorithmMismatch(algorithm_as_str(header.alg)))
  }

  let sig_raw = match base64url_decode_slice(tb, dot2 + 1, tb.length() - dot2 - 1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let expected_sig = hmac_for_alg(header.alg, key, tb, 0, dot2)
  if !constant_time_eq(expected_sig, sig_raw) {
    return Err(JwtError::InvalidSignature)
  }

  let pay_raw = match base64url_decode_slice(tb, dot1 + 1, dot2 - dot1 - 1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let claims = match parse_claims_json(pay_raw, validation.max_json_depth) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  match validate_claims(claims, validation, now_unix) {
    Ok(_) => Ok(TokenData::{ header: header, claims: claims })
    Err(e) => Err(e)
  }
}

///|
pub fn decode_with_verifier(
  token : String,
  verifier : Verifier,
  validation : Validation,
  now_unix : Int64,
) -> Result[TokenData, JwtError] {
  if validation.algorithms.length() == 0 {
    return Err(JwtError::EmptyAllowedAlgorithms)
  }
  let tb = token.to_bytes()
  if tb.length() > validation.max_token_bytes {
    return Err(JwtError::TokenTooLarge(tb.length(), validation.max_token_bytes))
  }
  let (dot1, dot2) = match split_three_segments(tb) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let hdr_raw = match base64url_decode_slice(tb, 0, dot1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let header = match parse_header_json(hdr_raw, validation.max_json_depth) {
    Ok(h) => h
    Err(e) => return Err(e)
  }
  if !alg_in_allowlist(header.alg, validation.algorithms) || !algorithm_equals(header.alg, verifier.alg) {
    return Err(JwtError::AlgorithmMismatch(algorithm_as_str(header.alg)))
  }

  let sig_raw = match base64url_decode_slice(tb, dot2 + 1, tb.length() - dot2 - 1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let mut signing_input = Bytes::new(dot2)
  let mut i = 0
  while i < dot2 {
    signing_input[i] = tb[i]
    i = i + 1
  }
  match (verifier.verify_fn)(signing_input, sig_raw) {
    Ok(true) => ()
    Ok(false) => return Err(JwtError::InvalidSignature)
    Err(e) => return Err(e)
  }

  let pay_raw = match base64url_decode_slice(tb, dot1 + 1, dot2 - dot1 - 1) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let claims = match parse_claims_json(pay_raw, validation.max_json_depth) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  match validate_claims(claims, validation, now_unix) {
    Ok(_) => Ok(TokenData::{ header: header, claims: claims })
    Err(e) => Err(e)
  }
}

///|
pub fn Jwk::from_oct_key(
  key : Bytes,
  kid : Option[String],
  alg : Option[Algorithm],
  key_use : Option[String],
) -> Jwk {
  let alg_str = match alg {
    Some(a) => Some(algorithm_as_str(a))
    None => None
  }
  Jwk::{ kty: "oct", k: key, kid: kid, alg: alg_str, key_use: key_use }
}

///|
pub fn Jwk::to_json(self : Jwk) -> String {
  let sb = StringBuilder::new()
  sb.write_string("{\"kty\":")
  write_json_string(sb, self.kty)
  sb.write_string(",\"k\":")
  write_json_string(sb, base64url_encode(self.k))
  match self.kid {
    Some(s) => {
      sb.write_string(",\"kid\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  match self.alg {
    Some(s) => {
      sb.write_string(",\"alg\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  match self.key_use {
    Some(s) => {
      sb.write_string(",\"use\":")
      write_json_string(sb, s)
    }
    None => ()
  }
  sb.write_string("}")
  sb.to_string()
}

///|
pub fn Jwk::from_json(json_str : String) -> Result[Jwk, JwtError] {
  let root = match json_parse(json_str.to_bytes(), 16) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let obj = match root {
    JsonValue::Obj(m) => m
    _ => return Err(JwtError::InvalidJwk("JWK must be a JSON object"))
  }
  let kty = match obj.get("kty") {
    Some(JsonValue::Str(s)) => s
    _ => return Err(JwtError::InvalidJwk("missing or non-string 'kty'"))
  }
  if kty != "oct" {
    return Err(JwtError::InvalidJwk("only 'oct' symmetric JWK is supported"))
  }
  let k_b64 = match obj.get("k") {
    Some(JsonValue::Str(s)) => s
    _ => return Err(JwtError::InvalidJwk("missing or non-string 'k'"))
  }
  let k_bytes = match base64url_decode(k_b64) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let kid = match obj.get("kid") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidJwk("'kid' must be a string"))
    None => None
  }
  let alg = match obj.get("alg") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidJwk("'alg' must be a string"))
    None => None
  }
  let key_use = match obj.get("use") {
    Some(JsonValue::Str(s)) => Some(s)
    Some(_) => return Err(JwtError::InvalidJwk("'use' must be a string"))
    None => None
  }
  Ok(Jwk::{ kty: kty, k: k_bytes, kid: kid, alg: alg, key_use: key_use })
}

///|
pub fn Jwk::to_secret_bytes(self : Jwk) -> Result[Bytes, JwtError] {
  if self.kty != "oct" {
    return Err(JwtError::InvalidJwk("not an 'oct' JWK"))
  }
  Ok(self.k)
}
