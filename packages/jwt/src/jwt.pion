///| RFC 7515 JWS / RFC 7519 JWT / RFC 7517 JWK encoding, decoding, and validation.

///|
pub fn Signer::hmac(alg : Algorithm, key : Bytes) -> Signer {
  let _ = key
  Signer::{
    alg: alg,
    sign_fn: fn(msg : Bytes) -> Result[Bytes, JwtError] {
      let _ = msg
      Err(JwtError::InvalidSignature)
    },
  }
}

///|
pub fn Verifier::hmac(alg : Algorithm, key : Bytes) -> Verifier {
  let _ = key
  Verifier::{
    alg: alg,
    verify_fn: fn(msg : Bytes, sig : Bytes) -> Result[Bool, JwtError] {
      let _ = msg
      let _ = sig
      Err(JwtError::InvalidSignature)
    },
  }
}

///|
pub fn encode(
  header : Header,
  claims : Claims,
  key : Bytes,
) -> Result[String, JwtError] {
  let _ = header
  let _ = claims
  let _ = key
  Err(JwtError::InvalidSignature)
}

///|
pub fn encode_with_signer(
  header : Header,
  claims : Claims,
  signer : Signer,
) -> Result[String, JwtError] {
  let _ = header
  let _ = claims
  let _ = signer
  Err(JwtError::InvalidSignature)
}

///|
///| Unverified header preview (DO NOT trust `header.alg` to choose a verification key/algorithm).
pub fn decode_header(token : String) -> Result[Header, JwtError] {
  let _ = token
  Err(JwtError::InvalidHeader("unimplemented"))
}

///|
pub fn decode(
  token : String,
  key : Bytes,
  validation : Validation,
  now_unix : Int64,
) -> Result[TokenData, JwtError] {
  let _ = token
  let _ = key
  let _ = validation
  let _ = now_unix
  Err(JwtError::InvalidSignature)
}

///|
pub fn decode_with_verifier(
  token : String,
  verifier : Verifier,
  validation : Validation,
  now_unix : Int64,
) -> Result[TokenData, JwtError] {
  let _ = token
  let _ = verifier
  let _ = validation
  let _ = now_unix
  Err(JwtError::InvalidSignature)
}

///|
pub fn Jwk::from_oct_key(
  key : Bytes,
  kid : Option[String],
  alg : Option[Algorithm],
  key_use : Option[String],
) -> Jwk {
  let alg_str = match alg {
    Some(a) => Some(algorithm_as_str(a))
    None => None
  }
  Jwk::{ kty: "oct", k: key, kid: kid, alg: alg_str, key_use: key_use }
}

///|
pub fn Jwk::to_json(self : Jwk) -> String {
  let _ = self
  ""
}

///|
pub fn Jwk::from_json(json_str : String) -> Result[Jwk, JwtError] {
  let _ = json_str
  Err(JwtError::InvalidJwk("unimplemented"))
}

///|
pub fn Jwk::to_secret_bytes(self : Jwk) -> Result[Bytes, JwtError] {
  let _ = self
  Err(JwtError::InvalidJwk("unimplemented"))
}
