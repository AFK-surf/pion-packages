///| Head-to-head benchmark for packages/jwt (Pion Native).
///| Modes:
///|   sign [count]     -- batch sign count/2 HS256 + count/2 HS512 JWTs
///|   verify <path>    -- batch verify & validate Claims (exp/nbf/iss/aud)

import "jwt"

///|
fn fnv1a_update_str(h_in : UInt64, s : String) -> UInt64 {
  let b = s.to_bytes()
  let n = b.length()
  let mut h = h_in
  let mut i = 0
  while i < n {
    h = (h ^ b[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn run_sign(world : World, count : Int) -> Int {
  let key = "pion-jwt-benchmark-secret-key-2026-0123456789abcdef".to_bytes()
  let hdr256 = jwt::Header::{
    alg: jwt::Algorithm::HS256,
    typ: None,
    kid: None,
    cty: None,
    crit: None,
    extra: Map::new(),
  }
  let hdr512 = jwt::Header::{
    alg: jwt::Algorithm::HS512,
    typ: None,
    kid: None,
    cty: None,
    crit: None,
    extra: Map::new(),
  }
  let empty_custom : Map[String, jwt::JsonValue] = Map::new()

  let mut hash : UInt64 = 14695981039346656037UL
  let mut total_bytes : Int64 = 0L
  let mut first = ""
  let mut second = ""
  let mut last = ""

  let mut i = 0
  while i < count {
    let is_256 = (i & 1) == 0
    let idx_s = i.to_string()
    let claims = jwt::Claims::{
      iss: Some("https://auth.pion.dev"),
      sub: Some("user-" + idx_s),
      aud: Some(jwt::Audience::Single("api-gateway")),
      exp: Some(2000000000L + (i % 3600).to_int64()),
      nbf: Some(1700000000L),
      iat: Some(1700000000L),
      jti: Some("tok-" + idx_s),
      custom: empty_custom,
    }
    let tok = match jwt::encode(if is_256 { hdr256 } else { hdr512 }, claims, key) {
      Ok(t) => t
      Err(_) => {
        io_println(world, "encode error")
        return 1
      }
    }
    total_bytes = total_bytes + tok.length().to_int64()
    hash = fnv1a_update_str(hash, tok)
    if i == 0 {
      first = tok
    } else if i == 1 {
      second = tok
    }
    if i == count - 1 {
      last = tok
    }
    i = i + 1
  }

  io_println(world, "mode=sign")
  io_println(world, "count=" + count.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  io_println(world, "first=" + first)
  io_println(world, "second=" + second)
  io_println(world, "last=" + last)
  0
}

///|
fn slice_str(b : Bytes, start : Int, end : Int) -> String {
  let n = end - start
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = b[start + i]
    i = i + 1
  }
  out.to_string()
}

///|
fn run_verify(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read corpus")
      return 1
    }
  }
  let key = "pion-jwt-benchmark-secret-key-2026-0123456789abcdef".to_bytes()
  let v256 = jwt::Validation::{
    algorithms: [jwt::Algorithm::HS256],
    leeway: 0L,
    validate_exp: true,
    validate_nbf: true,
    validate_aud: true,
    required_spec_claims: ["exp", "nbf", "iss", "aud"],
    iss: Some(["https://auth.pion.dev"]),
    aud: Some(["api-gateway"]),
    sub: None,
    max_token_bytes: 16384,
    max_json_depth: 32,
  }
  let v512 = jwt::Validation::{
    algorithms: [jwt::Algorithm::HS512],
    leeway: 0L,
    validate_exp: true,
    validate_nbf: true,
    validate_aud: true,
    required_spec_claims: ["exp", "nbf", "iss", "aud"],
    iss: Some(["https://auth.pion.dev"]),
    aud: Some(["api-gateway"]),
    sub: None,
    max_token_bytes: 16384,
    max_json_depth: 32,
  }
  let now_unix = 1795384400L

  let cb = content.to_bytes()
  let clen = cb.length()
  let mut pos = 0
  let mut count = 0
  let mut ok_count = 0
  let mut exp_sum : Int64 = 0L
  let mut hash : UInt64 = 14695981039346656037UL

  while pos < clen {
    let mut nl = pos
    while nl < clen && cb[nl].to_int() != 10 {
      nl = nl + 1
    }
    let line_end = if nl > pos && cb[nl - 1].to_int() == 13 { nl - 1 } else { nl }
    if line_end > pos + 4 {
      let is_256 = cb[pos].to_int() == 50 // '2'
      let tok = slice_str(cb, pos + 4, line_end)
      count = count + 1
      match jwt::decode(tok, key, if is_256 { v256 } else { v512 }, now_unix) {
        Ok(td) => {
          ok_count = ok_count + 1
          match td.claims.exp {
            Some(e) => exp_sum = exp_sum + e
            None => ()
          }
          match td.claims.sub {
            Some(s) => hash = fnv1a_update_str(hash, s)
            None => ()
          }
          match td.claims.jti {
            Some(j) => hash = fnv1a_update_str(hash, j)
            None => ()
          }
        }
        Err(_) => {
          io_println(world, "verify failed at line " + count.to_string())
          return 1
        }
      }
    }
    pos = nl + 1
  }

  io_println(world, "mode=verify")
  io_println(world, "count=" + count.to_string())
  io_println(world, "ok=" + ok_count.to_string())
  io_println(world, "exp_sum=" + exp_sum.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mode = if args.length() > 1 { args[1] } else { "sign" }
  if mode == "sign" {
    run_sign(world, 50000)
  } else if mode == "verify" {
    let path = if args.length() > 2 { args[2] } else { "/tmp/pion-jwt-bench/tokens_50000.txt" }
    run_verify(world, path)
  } else {
    io_println(world, "usage: jwt_bench [sign|verify <path>]")
    1
  }
}
