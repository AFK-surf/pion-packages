///| Wasm32 smoke entry for the `jwt` package.

import "jwt"

///|
pub fn smoke() -> Int {
  let key = "wasm-smoke-secret-key-0123456789".to_bytes()
  let claims = jwt::Claims::{
    iss: Some("pion-wasm"),
    sub: Some("user-42"),
    aud: Some(jwt::Audience::Single("api")),
    exp: Some(2000000000L),
    nbf: Some(1000000000L),
    iat: Some(1000000000L),
    jti: Some("jti-wasm"),
    custom: Map::new(),
  }
  let tok = match jwt::encode(jwt::Header::new(jwt::Algorithm::HS256), claims, key) {
    Ok(t) => t
    Err(_) => return 1
  }
  let v = jwt::Validation::{
    algorithms: [jwt::Algorithm::HS256],
    leeway: 0L,
    validate_exp: true,
    validate_nbf: true,
    validate_aud: true,
    required_spec_claims: ["iss", "sub", "exp"],
    iss: Some(["pion-wasm"]),
    aud: Some(["api"]),
    sub: Some("user-42"),
    max_token_bytes: 16384,
    max_json_depth: 32,
  }
  match jwt::decode(tok, key, v, 1500000000L) {
    Ok(td) => {
      match td.claims.sub {
        Some(s) => if s == "user-42" { 0 } else { 2 }
        None => 3
      }
    }
    Err(_) => 4
  }
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  smoke()
}
