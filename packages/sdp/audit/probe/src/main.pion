///|
fn extreme_num(r : Rng) -> String {
  let xs = [
    "0", "1", "-1", "127", "128", "255", "256", "4095", "4096", "65535", "65536", "2147483647",
    "2147483648", "4294967295", "4294967296", "9223372036854775807", "9223372036854775808",
    "99999999999999999999", "", "00", "+1", "1e3",
  ]
  xs[r.below(xs.length())]
}

///| Replace one run of ASCII digits in `line` by an extreme number.
fn mutate_number(line : String, r : Rng) -> String {
  let starts : Array[Int] = []
  let mut i = 0
  while i < line.length() {
    let c = line.code_unit_at(i)
    let prev_digit = i > 0 && line.code_unit_at(i - 1) >= 48 && line.code_unit_at(i - 1) <= 57
    if c >= 48 && c <= 57 && !prev_digit {
      starts.push(i)
    }
    i = i + 1
  }
  if starts.length() == 0 {
    return line
  }
  let st = starts[r.below(starts.length())]
  let mut en = st
  while en < line.length() && line.code_unit_at(en) >= 48 && line.code_unit_at(en) <= 57 {
    en = en + 1
  }
  line.slice(0, st) + extreme_num(r) + line.slice(en, line.length())
}

///|
fn mutate_byte(line : String, r : Rng) -> String {
  if line.length() == 0 {
    return line
  }
  let specials = [0, 9, 13, 10, 32, 32, 58, 47, 59, 44, 126, 127, 128, 195, 255, 61, 42, 45]
  let pos = r.below(line.length())
  let b = Bytes::new(1)
  b[0] = (if r.below(4) == 0 { r.below(256) } else { specials[r.below(specials.length())] }).to_byte()
  let ins = b.to_string()
  let k = r.below(3)
  if k == 0 {
    line.slice(0, pos) + ins + line.slice(pos, line.length())
  } else if k == 1 {
    line.slice(0, pos) + ins + line.slice(pos + 1, line.length())
  } else {
    line.slice(0, pos) + line.slice(pos + 1, line.length())
  }
}

///|
fn arr_insert(a : Array[String], at : Int, v : String) -> Unit {
  a.push(v)
  let mut i = a.length() - 1
  while i > at {
    a[i] = a[i - 1]
    i = i - 1
  }
  a[at] = v
}

///|
fn arr_remove(a : Array[String], at : Int) -> Unit {
  let mut i = at
  while i + 1 < a.length() {
    a[i] = a[i + 1]
    i = i + 1
  }
  let _ = a.pop()
}

///|
fn mutate(seed : String, r : Rng) -> String {
  let lines = split_lines(seed)
  let rounds = 1 + r.below(4)
  let mut k = 0
  while k < rounds && lines.length() > 0 {
    let op = r.below(10)
    let li = r.below(lines.length())
    if op == 0 || op == 1 {
      lines[li] = mutate_number(lines[li], r)
    } else if op == 2 || op == 3 {
      lines[li] = mutate_byte(lines[li], r)
    } else if op == 4 {
      let d = dict()
      arr_insert(lines, li, d[r.below(d.length())])
    } else if op == 5 {
      arr_insert(lines, li, lines[r.below(lines.length())])
    } else if op == 6 {
      arr_remove(lines, li)
    } else if op == 7 {
      let lj = r.below(lines.length())
      let t = lines[li]
      lines[li] = lines[lj]
      lines[lj] = t
    } else if op == 8 {
      let d = dict()
      lines[li] = d[r.below(d.length())]
    } else {
      // random bytes line
      let n = r.below(24)
      let b = Bytes::new(n)
      let mut j = 0
      while j < n {
        b[j] = (32 + r.below(95)).to_byte()
        j = j + 1
      }
      lines[li] = (if r.below(2) == 0 { "a=" } else { "" }) + b.to_string()
    }
    k = k + 1
  }
  let sep = if r.below(5) == 0 { "\n" } else { "\r\n" }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    sb.write_string(lines[i])
    sb.write_string(sep)
    i = i + 1
  }
  let out = sb.to_string()
  if r.below(20) == 0 && out.length() > 0 {
    out.slice(0, r.below(out.length()))
  } else {
    out
  }
}

///|
fn run_fuzz(world : World, cases : Int, seed : Int) -> Int {
  let r = Rng::{ s: seed.to_int64() * 2654435761L + 1L }
  let seeds = [seed_chrome(), seed_firefox(), seed_safari()]
  let mut h : UInt64 = 14695981039346656037UL
  let mut ok = 0
  let mut err = 0
  let mut sum_ok = 0
  let mut sum_err = 0
  let mut bad = 0
  let mut i = 0
  while i < cases {
    let text = if r.below(16) == 0 {
      let n = r.below(200)
      let b = Bytes::new(n)
      let mut j = 0
      while j < n {
        b[j] = r.below(256).to_byte()
        j = j + 1
      }
      "v=0\r\n" + b.to_string()
    } else {
      mutate(seeds[r.below(seeds.length())], r)
    }
    let v = verdict(text)
    h = fnv(h, v)
    if v.slice(0, 2) == "OK" {
      ok = ok + 1
      if v.contains("sum=ok") {
        sum_ok = sum_ok + 1
      } else {
        sum_err = sum_err + 1
      }
      if !v.contains("rt=stable") {
        bad = bad + 1
        if bad <= 8 {
          io_println(world, "VIOLATION case=" + i.to_string() + " " + v)
          io_println(world, "  input=" + esc(text))
        }
      }
    } else {
      err = err + 1
    }
    i = i + 1
  }
  io_println(
    world,
    "fuzz cases=" +
    cases.to_string() +
    " seed=" +
    seed.to_string() +
    " parse_ok=" +
    ok.to_string() +
    " parse_err=" +
    err.to_string() +
    " summary_ok=" +
    sum_ok.to_string() +
    " summary_err=" +
    sum_err.to_string() +
    " roundtrip_violations=" +
    bad.to_string() +
    " verdict_fnv=" +
    hex_u64(h),
  )
  0
}

// ---------------------------------------------------------------------------
// amplification and performance
// ---------------------------------------------------------------------------

///| `media` m-lines under one huge session-level attribute of `tokens` items.
fn build_amp(media : Int, tokens : Int, kind : String) -> String {
  let sb = StringBuilder::new()
  sb.write_string("v=0\r\no=- 1 1 IN IP4 0.0.0.0\r\ns=-\r\nt=0 0\r\n")
  if kind == "ice-options" {
    sb.write_string("a=ice-options:")
    let mut i = 0
    while i < tokens {
      sb.write_string("x ")
      i = i + 1
    }
    sb.write_string("x\r\n")
  } else {
    // fingerprint: one huge value, copied per media section by `fingerprint()`
    sb.write_string("a=fingerprint:sha-256 ")
    let mut i = 0
    while i < tokens {
      sb.write_string("AB")
      i = i + 1
    }
    sb.write_string("\r\n")
  }
  let mut m = 0
  while m < media {
    sb.write_string("m=a 9 P 0\r\n")
    m = m + 1
  }
  sb.to_string()
}

///|
fn run_amp(world : World, media : Int, tokens : Int, kind : String) -> Int {
  let text = build_amp(media, tokens, kind)
  let t0 = clock_now_ms(world)
  let d = match sdp::parse(text) {
    Ok(d) => d
    Err(e) => {
      io_println(world, "parse err " + sdp::sdp_error_message(e))
      return 0
    }
  }
  let t1 = clock_now_ms(world)
  match sdp::extract_webrtc_summary(d) {
    Ok(s) => {
      let t2 = clock_now_ms(world)
      let mut strings = 0
      let mut bytes = 0
      let mut i = 0
      while i < s.media.length() {
        strings = strings + s.media[i].ice.options.length()
        match s.media[i].fingerprint {
          Some(fp) => bytes = bytes + fp.value.length()
          None => ()
        }
        i = i + 1
      }
      io_println(
        world,
        "amp kind=" +
        kind +
        " input_bytes=" +
        text.length().to_string() +
        " media=" +
        media.to_string() +
        " summary_option_strings=" +
        strings.to_string() +
        " summary_fingerprint_bytes=" +
        bytes.to_string() +
        " parse_ms=" +
        (t1 - t0).to_string() +
        " summary_ms=" +
        (t2 - t1).to_string(),
      )
    }
    Err(e) => io_println(world, "summary err " + sdp::sdp_error_message(e))
  }
  0
}

///|
fn build_perf(kind : String, n : Int) -> String {
  let sb = StringBuilder::new()
  sb.write_string("v=0\r\no=- 1 1 IN IP4 0.0.0.0\r\ns=-\r\nt=0 0\r\n")
  if kind == "attrs" {
    sb.write_string("m=video 9 UDP/TLS/RTP/SAVPF 96\r\n")
    let mut i = 0
    while i < n {
      sb.write_string("a=rtcp-fb:96 nack pli\r\n")
      i = i + 1
    }
  } else if kind == "media" {
    let mut i = 0
    while i < n {
      sb.write_string("m=audio 9 UDP/TLS/RTP/SAVPF 111\r\na=mid:" + i.to_string() + "\r\n")
      sb.write_string("a=rtpmap:111 opus/48000/2\r\na=sendrecv\r\n")
      i = i + 1
    }
  } else if kind == "cands" {
    sb.write_string("m=audio 9 UDP/TLS/RTP/SAVPF 111\r\n")
    let mut i = 0
    while i < n {
      sb.write_string(
        "a=candidate:" +
        i.to_string() +
        " 1 udp 2122260223 192.168.1.10 54321 typ host generation 0 network-id 1\r\n",
      )
      i = i + 1
    }
  } else {
    // bundle: one a=group:BUNDLE with n mids
    sb.write_string("a=group:BUNDLE")
    let mut i = 0
    while i < n {
      sb.write_string(" m" + i.to_string())
      i = i + 1
    }
    sb.write_string("\r\nm=audio 9 UDP/TLS/RTP/SAVPF 111\r\n")
  }
  sb.to_string()
}

///|
fn run_perf(world : World, kind : String, n : Int) -> Int {
  let text = build_perf(kind, n)
  let limits = sdp::ParseLimits::new(64 * 1048576, 4194304, 1048576, 4194304)
  let reps = 5
  let t0 = clock_now_ms(world)
  let mut r = 0
  let mut last : Option[sdp::SessionDescription] = None
  while r < reps {
    match sdp::parse_with_limits(text, limits) {
      Ok(d) => last = Some(d)
      Err(e) => {
        io_println(world, "parse err " + sdp::sdp_error_message(e))
        return 0
      }
    }
    r = r + 1
  }
  let t1 = clock_now_ms(world)
  let d = match last {
    Some(d) => d
    None => return 1
  }
  r = 0
  let mut nm = 0
  while r < reps {
    match sdp::extract_webrtc_summary(d) {
      Ok(s) => nm = s.media.length()
      Err(_) => nm = -1
    }
    r = r + 1
  }
  let t2 = clock_now_ms(world)
  r = 0
  let mut out_len = 0
  while r < reps {
    out_len = sdp::serialize(d).length()
    r = r + 1
  }
  let t3 = clock_now_ms(world)
  io_println(
    world,
    "perf kind=" +
    kind +
    " n=" +
    n.to_string() +
    " bytes=" +
    text.length().to_string() +
    " media=" +
    nm.to_string() +
    " out=" +
    out_len.to_string() +
    " reps=" +
    reps.to_string() +
    " parse_ms=" +
    (t1 - t0).to_string() +
    " summary_ms=" +
    (t2 - t1).to_string() +
    " serialize_ms=" +
    (t3 - t2).to_string(),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: probe diff <tsv> | fuzz <cases> <seed> | amp <m> <t> <kind> | perf <kind> <n>")
    return 2
  }
  let mode = args[1]
  if mode == "diff" {
    run_diff(world, args[2])
  } else if mode == "fuzz" {
    run_fuzz(world, parse_dec(args[2]), parse_dec(args[3]))
  } else if mode == "amp" {
    run_amp(world, parse_dec(args[2]), parse_dec(args[3]), args[4])
  } else if mode == "perf" {
    run_perf(world, args[2], parse_dec(args[3]))
  } else {
    io_eprintln(world, "unknown mode")
    2
  }
}
