///|
fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut st = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 10 {
      let e = if i > st && s.code_unit_at(i - 1) == 13 { i - 1 } else { i }
      out.push(s.slice(st, e))
      st = i + 1
    }
    i = i + 1
  }
  if st < n {
    out.push(s.slice(st, n))
  }
  out
}

