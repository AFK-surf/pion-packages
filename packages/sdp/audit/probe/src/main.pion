///| Red-team probe for `packages/sdp` (branch audit/redteam-sdp).
///|
///|   probe diff <corpus.tsv>            one canonical verdict line per `name<TAB>hex` case
///|   probe fuzz <cases> <seed>          structure-aware mutation fuzz + roundtrip invariants
///|   probe amp <media> <tokens> <kind>  session-level attribute x media summary amplification
///|   probe perf <kind> <n>              wall-clock phases (parse / summary / serialize)
///|
///| Every mode prints deterministic text except the `ms=` fields, so native and wasm32
///| builds can be compared byte for byte after stripping timings.

import "sdp"

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

///|
struct Rng {
  mut s : Int64
}

///|
fn Rng::next(self : Rng) -> Int {
  self.s = self.s * 6364136223846793005L + 1442695040888963407L
  ((self.s >> 33) & 0x7FFFFFFFL).to_int()
}

///|
fn Rng::below(self : Rng, n : Int) -> Int {
  if n <= 0 {
    0
  } else {
    self.next() % n
  }
}

///|
fn parse_dec(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn hexv(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Decode a lowercase/uppercase hex string into a byte string.
fn unhex(s : String) -> String {
  let n = s.length() / 2
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = (hexv(s.code_unit_at(2 * i)) * 16 + hexv(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  b.to_string()
}

///|
fn fnv(h : UInt64, s : String) -> UInt64 {
  let mut x = h
  let mut i = 0
  while i < s.length() {
    x = (x ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  (x ^ 10UL) * 1099511628211UL
}

///|
fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    out[i] = (if nib < 10 { 48 + nib } else { 87 + nib }).to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

///| Printable form of a value: bytes outside 0x21..0x7E are shown as `\xHH`.
fn esc(s : String) -> String {
  let sb = StringBuilder::new()
  let digits = "0123456789abcdef"
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i) & 255
    if c < 33 || c > 126 || c == 92 || c == 124 {
      sb.write_string("\\x")
      sb.write_byte(digits.code_unit_at(c / 16).to_byte())
      sb.write_byte(digits.code_unit_at(c % 16).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn opt(s : Option[String]) -> String {
  match s {
    Some(v) => esc(v)
    None => "-"
  }
}

///|
fn join_s(a : Array[String], sep : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < a.length() {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(esc(a[i]))
    i = i + 1
  }
  sb.to_string()
}

///|
fn err_class(e : sdp::SdpError) -> String {
  match e {
    sdp::SdpError::EmptyInput => "Empty"
    sdp::SdpError::LimitExceeded(_) => "Limit"
    sdp::SdpError::InvalidLine(_, _) => "Line"
    sdp::SdpError::InvalidSyntax(_, _) => "Syntax"
    sdp::SdpError::MissingRequiredField(_) => "Missing"
  }
}

// ---------------------------------------------------------------------------
// canonical verdicts
// ---------------------------------------------------------------------------

///| Structural digest of a parsed description (field counts per section).
fn structure(d : sdp::SessionDescription) -> String {
  let sb = StringBuilder::new()
  sb.write_string("m=" + d.media.length().to_string())
  sb.write_string(" sa=" + d.attributes.length().to_string())
  sb.write_string(" ma=")
  let mut i = 0
  while i < d.media.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(d.media[i].attributes.length().to_string())
    i = i + 1
  }
  sb.to_string()
}

///| Digest of `extract_webrtc_summary`.
fn summary_str(d : sdp::SessionDescription) -> String {
  match sdp::extract_webrtc_summary(d) {
    Err(e) => "sum=err:" + err_class(e)
    Ok(s) => {
      let sb = StringBuilder::new()
      sb.write_string("sum=ok bundle=" + join_s(s.bundle_mids, ","))
      sb.write_string(" lite=" + (if s.ice_lite { "1" } else { "0" }))
      let mut i = 0
      while i < s.media.length() {
        let m = s.media[i]
        sb.write_string(" [" + esc(m.media_type) + " mid=" + opt(m.mid))
        sb.write_string(" dir=" + sdp::direction_to_string(m.direction))
        sb.write_string(" uf=" + opt(m.ice.ufrag) + " opts=" + m.ice.options.length().to_string())
        match m.fingerprint {
          Some(fp) =>
          sb.write_string(" fp=" + esc(fp.algorithm) + "/" + fp.value.length().to_string())
          None => sb.write_string(" fp=-")
        }
        match m.setup {
          Some(st) => sb.write_string(" setup=" + sdp::dtls_setup_to_string(st))
          None => sb.write_string(" setup=-")
        }
        sb.write_string(" rtpmap=" + m.rtpmaps.length().to_string())
        sb.write_string(" cand=" + m.candidates.length().to_string())
        let ext_ids : Array[String] = []
        let mut k = 0
        while k < m.extmaps.length() {
          ext_ids.push(m.extmaps[k].id.to_string())
          k = k + 1
        }
        sb.write_string(" ext=" + join_s(ext_ids, ","))
        match m.simulcast {
          Some(sim) =>
          sb.write_string(
            " sim=send:" + join_s(sim.send_rids, ",") + "/recv:" + join_s(sim.recv_rids, ","),
          )
          None => sb.write_string(" sim=-")
        }
        sb.write_string("]")
        i = i + 1
      }
      sb.to_string()
    }
  }
}

///| `parse` -> `serialize` -> `parse` -> `serialize` invariants.
fn roundtrip(d : sdp::SessionDescription) -> String {
  let s1 = sdp::serialize(d)
  match sdp::parse(s1) {
    Err(e) => "rt=reparse_err:" + err_class(e)
    Ok(d2) => {
      let s2 = sdp::serialize(d2)
      if s1 != s2 {
        "rt=unstable"
      } else if structure(d) != structure(d2) {
        "rt=struct_diff"
      } else if summary_str(d) != summary_str(d2) {
        "rt=summary_diff"
      } else {
        "rt=stable"
      }
    }
  }
}

///|
fn verdict(text : String) -> String {
  match sdp::parse(text) {
    Err(e) => "ERR " + err_class(e)
    Ok(d) => "OK " + structure(d) + " " + roundtrip(d) + " " + summary_str(d)
  }
}

// ---------------------------------------------------------------------------
// diff mode
// ---------------------------------------------------------------------------

///|
fn run_diff(world : World, path : String) -> Int {
  let data = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "read failed")
      return 1
    }
  }
  let n = data.length()
  let mut ls = 0
  let mut i = 0
  while i <= n {
    if i == n || data.code_unit_at(i) == 10 {
      if i > ls {
        let line = data.slice(ls, i)
        let mut tab = 0
        while tab < line.length() && line.code_unit_at(tab) != 9 {
          tab = tab + 1
        }
        if tab < line.length() {
          let name = line.slice(0, tab)
          let text = unhex(line.slice(tab + 1, line.length()))
          io_println(world, name + "\t" + verdict(text))
        }
      }
      ls = i + 1
    }
    i = i + 1
  }
  0
}

