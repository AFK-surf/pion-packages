///| Red-team prosecution suite for `packages/sdp` v0.1.0 (origin/feat/pkg-sdp @ 7a49948).
///|
///| `redteam_p0_*` / `redteam_p1_*` / `redteam_p2_*` assert what RFC 8866 / 8829 / 8839 / 8285 /
///| 8853 / 8122 require, or what the reference parsers (webrtc-rs `sdp` =0.9.0, Mozilla
///| `webrtc-sdp` =0.3.17; see `audit/diff`) do on the same bytes. A FAILING redteam test is the
///| evidence against the package; it should PASS once the defect is fixed.
///| `control_*` tests document attack surface that was probed and found sound: they must PASS.

import "sdp"

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

///|
fn hdr() -> String {
  "v=0\r\no=- 4611731400430051336 2 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n"
}

///|
fn video(extra : String) -> String {
  hdr() + "m=video 9 UDP/TLS/RTP/SAVPF 96\r\nc=IN IP4 0.0.0.0\r\na=mid:0\r\na=rtpmap:96 VP8/90000\r\n" +
  extra
}

///|
fn contains(hay : String, needle : String) -> Bool {
  let n = hay.length()
  let m = needle.length()
  let mut i = 0
  while i + m <= n {
    if hay.slice(i, i + m) == needle {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn is_s(a : Option[String], b : String) -> Bool {
  match a {
    Some(x) => x == b
    None => false
  }
}

///|
fn is_i(a : Option[Int], b : Int) -> Bool {
  match a {
    Some(x) => x == b
    None => false
  }
}

///|
fn is_i64(a : Option[Int64], b : Int64) -> Bool {
  match a {
    Some(x) => x == b
    None => false
  }
}

///|
fn must_parse(text : String) -> sdp::SessionDescription {
  match sdp::parse(text) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "unexpected parse error: " + sdp::sdp_error_message(e))
      panic()
    }
  }
}

///|
fn must_summary(d : sdp::SessionDescription) -> sdp::WebRtcSummary {
  match sdp::extract_webrtc_summary(d) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "unexpected summary error: " + sdp::sdp_error_message(e))
      panic()
    }
  }
}

///|
fn parses(text : String) -> Bool {
  match sdp::parse(text) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn parses_with(text : String, l : sdp::ParseLimits) -> Bool {
  match sdp::parse_with_limits(text, l) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn summary_ok(text : String) -> Bool {
  match sdp::parse(text) {
    Ok(d) =>
    match sdp::extract_webrtc_summary(d) {
      Ok(_) => true
      Err(_) => false
    }
    Err(_) => false
  }
}

///| Same description with a different session name and session attributes.
fn with_session(
  d : sdp::SessionDescription,
  name : String,
  attrs : Array[sdp::Attribute],
) -> sdp::SessionDescription {
  sdp::SessionDescription::{
    version: d.version,
    origin: d.origin,
    session_name: name,
    session_info: d.session_info,
    uri: d.uri,
    connection: d.connection,
    bandwidths: d.bandwidths,
    timings: d.timings,
    attributes: attrs,
    media: d.media,
  }
}

///| Same media section with a different attribute list.
fn with_media_attrs(
  m : sdp::MediaDescription,
  attrs : Array[sdp::Attribute],
) -> sdp::MediaDescription {
  sdp::MediaDescription::{
    media_type: m.media_type,
    port: m.port,
    port_count: m.port_count,
    protocol: m.protocol,
    formats: m.formats,
    title: m.title,
    connection: m.connection,
    bandwidths: m.bandwidths,
    attributes: attrs,
  }
}

///|
fn chrome_offer() -> String {
  hdr() +
  "a=group:BUNDLE 0 1 2\r\na=extmap-allow-mixed\r\na=msid-semantic: WMS stream1\r\n" +
  "m=audio 9 UDP/TLS/RTP/SAVPF 111 0\r\nc=IN IP4 0.0.0.0\r\na=rtcp:9 IN IP4 0.0.0.0\r\n" +
  "a=candidate:1467250027 1 udp 2122260223 192.168.1.10 54321 typ host generation 0 network-id 1 network-cost 10\r\n" +
  "a=candidate:842163049 1 udp 1677729535 203.0.113.5 60001 typ srflx raddr 192.168.1.10 rport 54321 generation 0 network-id 1\r\n" +
  "a=candidate:3 1 udp 2122194687 4a1b2c3d-0000-4000-8000-123456789abc.local 50000 typ host generation 0\r\n" +
  "a=candidate:4 1 tcp 1518280447 2001:db8::1 9 typ host tcptype active generation 0 network-id 2\r\n" +
  "a=ice-ufrag:Ab3d\r\na=ice-pwd:0123456789abcdefghijklmn\r\na=ice-options:trickle\r\n" +
  "a=fingerprint:sha-256 AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99\r\n" +
  "a=setup:actpass\r\na=mid:0\r\na=extmap:1 urn:ietf:params:rtp-hdrext:ssrc-audio-level\r\n" +
  "a=sendrecv\r\na=msid:stream1 track-a\r\na=rtcp-mux\r\na=rtpmap:111 opus/48000/2\r\n" +
  "a=rtcp-fb:111 transport-cc\r\na=fmtp:111 minptime=10;useinbandfec=1\r\na=rtpmap:0 PCMU/8000\r\n" +
  "m=video 9 UDP/TLS/RTP/SAVPF 96 97\r\nc=IN IP4 0.0.0.0\r\nb=AS:1500\r\nb=TIAS:2000000\r\n" +
  "a=ice-ufrag:Ab3d\r\na=ice-pwd:0123456789abcdefghijklmn\r\n" +
  "a=fingerprint:sha-256 AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99\r\n" +
  "a=setup:actpass\r\na=mid:1\r\na=extmap:14 urn:ietf:params:rtp-hdrext:toffset\r\n" +
  "a=extmap:3/sendonly urn:3gpp:video-orientation\r\na=sendonly\r\na=msid:stream1 track-v\r\n" +
  "a=rtcp-mux\r\na=rtcp-rsize\r\na=rtpmap:96 VP8/90000\r\na=rtcp-fb:96 nack pli\r\n" +
  "a=rtcp-fb:* transport-cc\r\na=rtpmap:97 rtx/90000\r\na=fmtp:97 apt=96\r\n" +
  "a=rid:h send pt=96;max-width=1280\r\na=rid:q send\r\na=rid:f send\r\na=simulcast:send h;q;f\r\n" +
  "a=ssrc-group:FID 2001 2002\r\na=ssrc-group:SIM 2001 2003 2005\r\na=ssrc:2001 cname:abcdEFGH\r\n" +
  "m=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\nc=IN IP6 ::1\r\na=ice-ufrag:Ab3d\r\n" +
  "a=ice-pwd:0123456789abcdefghijklmn\r\na=setup:actpass\r\na=mid:2\r\na=sctp-port:5000\r\n" +
  "a=max-message-size:262144\r\n"
}

