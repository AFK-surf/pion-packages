  "v=0\r\no=mozilla...THIS_IS_SDPARTA-99.0 7051458624451127011 0 IN IP4 0.0.0.0\r\ns=-\r\nt=0 0\r\n" +
  "a=fingerprint:sha-256 6C:3F:0C:40:E8:6B:7A:2B:6E:8B:3B:6E:4B:6B:6E:8B:3B:6E:4B:6B:6E:8B:3B:6E:4B:6B:6E:8B:3B:6E:4B:6B\r\n" +
  "a=group:BUNDLE 0 1\r\na=ice-options:trickle\r\na=msid-semantic:WMS *\r\n" +
  "m=audio 9 UDP/TLS/RTP/SAVPF 109 101\r\nc=IN IP4 0.0.0.0\r\n" +
  "a=candidate:0 1 UDP 2122252543 192.0.2.1 49170 typ host\r\n" +
  "a=candidate:1 1 TCP 2105524479 192.0.2.1 9 typ host tcptype active\r\na=sendrecv\r\n" +
  "a=end-of-candidates\r\na=extmap:2/recvonly urn:ietf:params:rtp-hdrext:csrc-audio-level\r\n" +
  "a=fmtp:109 maxplaybackrate=48000;stereo=1;useinbandfec=1\r\na=fmtp:101 0-15\r\n" +
  "a=ice-pwd:b9e1a2c3d4e5f60718293a4b5c6d7e8f\r\na=ice-ufrag:5a1b2c3d\r\na=mid:0\r\n" +
  "a=msid:{7a1b} {8c2d}\r\na=rtcp-mux\r\na=rtpmap:109 opus/48000/2\r\n" +
  "a=rtpmap:101 telephone-event/8000/1\r\na=setup:actpass\r\na=ssrc:3735928559 cname:{0f1e2d3c}\r\n" +
  "m=video 9 UDP/TLS/RTP/SAVPF 120 124\r\nc=IN IP4 0.0.0.0\r\na=sendonly\r\n" +
  "a=ice-pwd:b9e1a2c3d4e5f60718293a4b5c6d7e8f\r\na=ice-ufrag:5a1b2c3d\r\na=mid:1\r\n" +
  "a=rid:a send\r\na=rid:b send\r\na=simulcast:send a;b\r\na=rtcp-fb:120 ccm fir\r\n" +
  "a=rtpmap:120 VP8/90000\r\na=rtpmap:124 rtx/90000\r\na=fmtp:124 apt=120\r\na=setup:actpass\r\n"
}

// ===========================================================================
// P0
// ===========================================================================

///| `extract_webrtc_summary` re-splits the session-level `a=ice-options` value for every
///| media section (jsep.pion:279 + :291-294 via ice_credentials at :857). One session line of
///| T tokens and M m-lines yields M*T heap strings: 800 KB of SDP (inside the default 1 MiB /
///| 256-section limits) retains 102,400,256 strings = 4.9 GB RSS native, and traps wasm32
///| (`WebAssembly.Memory.grow(): Unable to grow`) — see `run_audit.sh amp`.
///| Here: 1,000 tokens x 256 m-lines (8 KB of input) must not yield 256,000 summary entries.
test "redteam_p0_summary_ice_options_amplification" {
  let sb = StringBuilder::new()
  sb.write_string(hdr())
  sb.write_string("a=ice-options:")
  let mut i = 0
  while i < 999 {
    sb.write_string("x ")
    i = i + 1
  }
  sb.write_string("x\r\n")
  i = 0
  while i < 256 {
    sb.write_string("m=a 9 P 0\r\n")
    i = i + 1
  }
  let text = sb.to_string()
  match sdp::parse(text) {
    Err(_) => () // rejecting the oversize ice-options line is an acceptable fix
    Ok(d) =>
    match sdp::extract_webrtc_summary(d) {
      Err(_) => () // so is refusing to build the summary
      Ok(s) => {
        let mut entries = 0
        let mut m = 0
        while m < s.media.length() {
          entries = entries + s.media[m].ice.options.length()
          m = m + 1
        }
        debug_assert(
          entries <= text.length(),
          "summary holds " + entries.to_string() + " ice-options strings for " +
          text.length().to_string() + " input bytes (O(media x tokens) amplification)",
        )
      }
    }
  }
}

// ===========================================================================
// P1
// ===========================================================================

///| Same O(media x bytes) shape through `fingerprint()` (jsep.pion:300-323): the session-level
///| value is re-sliced (copied) for each m-line and never length-checked. 800 KB -> 205 MB.
test "redteam_p1_summary_fingerprint_amplification" {
  let sb = StringBuilder::new()
  sb.write_string(hdr())
  sb.write_string("a=fingerprint:sha-256 ")
  let mut i = 0
  while i < 2000 {
    sb.write_string("AB")
    i = i + 1
  }
  sb.write_string("\r\n")
  i = 0
  while i < 256 {
    sb.write_string("m=a 9 P 0\r\n")
    i = i + 1
  }
  let text = sb.to_string()
  match sdp::parse(text) {
    Err(_) => ()
    Ok(d) =>
    match sdp::extract_webrtc_summary(d) {
      Err(_) => ()
      Ok(s) => {
        let mut bytes = 0
        let mut m = 0
        while m < s.media.length() {
          match s.media[m].fingerprint {
            Some(fp) => bytes = bytes + fp.value.length()
            None => ()
          }
          m = m + 1
        }
        debug_assert(
          bytes <= text.length(),
          "summary copies " + bytes.to_string() + " fingerprint bytes for " +
          text.length().to_string() + " input bytes",
        )
      }
    }
  }
}

///| `serialize` (sdp.pion:626-745) writes every field verbatim. A session name carrying CRLF
///| (e.g. a room title taken from a client) smuggles a forged `a=fingerprint` line that the
///| peer's parser accepts as a genuine session-level DTLS fingerprint.
test "redteam_p1_serialize_crlf_injection_session_name" {
  let d = must_parse(video(""))
  let evil = with_session(d, "room\r\na=fingerprint:sha-256 EV:IL", d.attributes)
  let wire = sdp::serialize(evil)
  match sdp::parse(wire) {
    Ok(d2) => {
      let fp = sdp::fingerprint(d2, 0)
      debug_assert(
        match fp {
          Some(_) => false
          None => true
        },
        "serialize() let a CRLF in session_name inject `a=fingerprint:sha-256 EV:IL`",
      )
    }
    Err(_) => () // refusing / producing an unparsable document is fail-closed
  }
}

///| Media-level variant: an `a=msid` value (track ids are routinely client-chosen) carrying
///| CRLF injects a fingerprint that `fingerprint()` returns ahead of the real one, because the
///| first `a=fingerprint` in the m-section wins (jsep.pion:238-249) — a DTLS MITM primitive
///| for any SFU / signaling server that rebuilds SDP from client fields with this package.
test "redteam_p1_serialize_crlf_injection_media_attr_overrides_fingerprint" {
  let d = must_parse(
    video(
      "a=fingerprint:sha-256 AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99\r\n",
    ),
  )
  let m = d.media[0]
  let attrs : Array[sdp::Attribute] = [
    sdp::Attribute::{ key: "msid", value: Some("s t\r\na=fingerprint:sha-256 EV:IL") },
  ]
  let mut i = 0
  while i < m.attributes.length() {
    attrs.push(m.attributes[i])
    i = i + 1
  }
  let evil = sdp::SessionDescription::{
    version: d.version,
    origin: d.origin,
    session_name: d.session_name,
    session_info: d.session_info,
    uri: d.uri,
    connection: d.connection,
    bandwidths: d.bandwidths,
    timings: d.timings,
    attributes: d.attributes,
    media: [with_media_attrs(m, attrs)],
  }
  match sdp::parse(sdp::serialize(evil)) {
    Ok(d2) =>
    match sdp::fingerprint(d2, 0) {
      Some(fp) =>
      debug_assert(fp.value != "EV:IL", "injected fingerprint EV:IL replaced the real one")
      None => ()
    }
    Err(_) => ()
  }
}

///| RFC 8853 §5.1: `sc-alt-list = sc-id *("," sc-id)`, `sc-id = [sc-id-paused] rid-id` with
///| `sc-id-paused = "~"`. jsep.pion:770 only splits on `;`, so `1,2` and `~3` are returned as
///| RID ids that match no `a=rid` line (Mozilla webrtc-sdp: ids 1,2 | ~3 paused).
test "redteam_p1_simulcast_alternatives_and_paused_ids" {
  let d = must_parse(
    video("a=rid:1 send\r\na=rid:2 send\r\na=rid:3 send\r\na=simulcast:send 1,2;~3\r\n"),
  )
  let rids = match sdp::rids(d.media[0]) {
    Ok(r) => r
    Err(_) => []
  }
  match sdp::simulcast(d.media[0]) {
    Ok(Some(sim)) => {
      let mut i = 0
      while i < sim.send_rids.length() {
        let id = sim.send_rids[i]
        let mut found = false
        let mut j = 0
        while j < rids.length() {
          if rids[j].id == id {
            found = true
          }
          j = j + 1
        }
        debug_assert(found, "simulcast send rid `" + id + "` matches no a=rid line")
        i = i + 1
      }
    }
    _ => debug_assert(false, "valid RFC 8853 simulcast rejected")
  }
}

// ===========================================================================
// P2
// ===========================================================================

///| `format_ice_candidate` (jsep.pion:153-213) joins fields with spaces unescaped: a ufrag
///| containing spaces re-parses as an extra `raddr` the caller never set.
test "redteam_p2_format_ice_candidate_token_smuggling" {
  let c = match sdp::parse_ice_candidate("1 1 udp 2122260223 10.0.0.1 9 typ host") {
    Ok(c) => c
    Err(_) => panic()
  }
  let forged = sdp::IceCandidate::{
    foundation: c.foundation,
    component: c.component,
    transport: c.transport,
    priority: c.priority,
    address: c.address,
    port: c.port,
    typ: c.typ,
    raddr: None,
    rport: None,
    tcptype: None,
    generation: None,
    ufrag: Some("abcd raddr 6.6.6.6"),
    extensions: [],
  }
  match sdp::parse_ice_candidate(sdp::format_ice_candidate(forged)) {
    Ok(c2) =>
    debug_assert(
      match c2.raddr {
        None => true
        Some(_) => false
      },
      "format_ice_candidate smuggled raddr from the ufrag field",
    )
    Err(_) => ()
  }
}

///| `Attribute.key` containing ':' is written raw and re-splits differently on parse.
test "redteam_p2_serialize_attribute_key_resplit" {
  let d = must_parse(hdr())
  let evil = with_session(d, d.session_name, [
    sdp::Attribute::{ key: "setup:active x", value: Some("y") },
  ])
  let d2 = must_parse(sdp::serialize(evil))
  debug_assert(d2.attributes.length() == 1, "one attribute")
  debug_assert(d2.attributes[0].key == "setup:active x", "attribute key changed on roundtrip")
}

///| RFC 8285 §5 / §6: IDs 1-14 (one-byte) and 1-255 (two-byte); 4096-4351 only in offers.
///| jsep.pion:482/488 accept 256..4095 — ids that cannot be put on the wire (a consumer
///| narrowing to u8 maps 257 onto 1) — yet reject the RFC's 4096 range.
test "redteam_p2_extmap_id_range" {
  debug_assert(!summary_ok(video("a=extmap:256 urn:x\r\n")), "extmap id 256 accepted")
  debug_assert(!summary_ok(video("a=extmap:4095 urn:x\r\n")), "extmap id 4095 accepted")
}

///| RFC 8122 §5: fingerprint is `2UHEX *(":" 2UHEX)` of the hash's length. Not validated:
///| `sha-256 zz:zz` is returned as a usable fingerprint (Mozilla webrtc-sdp rejects it).
test "redteam_p2_fingerprint_not_validated" {
  let d = must_parse(video("a=fingerprint:sha-256 zz:zz\r\n"))
  debug_assert(
    match sdp::fingerprint(d, 0) {
      None => true
      Some(_) => false
    },
    "non-hex / wrong-length sha-256 fingerprint returned as valid",
  )
}

///| A malformed media-level `a=fingerprint` is silently skipped and the session-level one
///| used instead (jsep.pion:304-305 + 316-322); the media's own declaration is lost.
test "redteam_p2_fingerprint_malformed_media_falls_back_to_session" {
  let d = must_parse(
    hdr() + "a=fingerprint:sha-256 AA:BB\r\nm=video 9 UDP/TLS/RTP/SAVPF 96\r\na=fingerprint:sha-256\r\n",
  )
  debug_assert(
    match sdp::fingerprint(d, 0) {
      None => true
      Some(_) => false
    },
    "malformed media-level fingerprint replaced by session-level fingerprint",
  )
}

///| RFC 8122 §5 / RFC 8827 §6.5: several fingerprints (different hashes) may be offered; the
///| API exposes only the first, so a sha-1 listed first hides the sha-256 one.
test "redteam_p2_fingerprint_only_first_of_several" {
  let d = must_parse(
    video(
      "a=fingerprint:sha-1 01:02:03:04:05:06:07:08:09:0A:0B:0C:0D:0E:0F:10:11:12:13:14\r\n" +
      "a=fingerprint:sha-256 AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99\r\n",
    ),
  )
  match sdp::fingerprint(d, 0) {
    Some(fp) => debug_assert(fp.algorithm != "sha-1", "sha-1 chosen over the sha-256 fingerprint")
    None => debug_assert(false, "no fingerprint")
  }
}

///| README: "100% lossless roundtrip". `r=`, `z=`, `k=`, `e=`, `p=` are dropped by the parser
///| (sdp.pion:536-540), so repeat times / time-zone adjustments vanish (webrtc-rs keeps them).
test "redteam_p2_roundtrip_drops_r_z_k_e_p" {
  let text = "v=0\r\no=- 1 1 IN IP4 x\r\ns=-\r\ne=a@b.example\r\np=+1 617 555 6011\r\n" +
  "t=2873397496 2873404696\r\nr=7d 1h 0 25h\r\nz=2882844526 -1h\r\n"
  let out = sdp::serialize(must_parse(text))
  debug_assert(contains(out, "r=7d 1h 0 25h"), "r= repeat time lost")
  debug_assert(contains(out, "z=2882844526 -1h"), "z= time zone lost")
  debug_assert(contains(out, "e=a@b.example"), "e= lost")
}

///| RFC 8866 §9: `text = byte-string` = 1*(%x01-09 / %x0B-0C / %x0E-FF): TAB and DEL are
///| legal in s=/i=/a= values. sdp.pion:365 rejects every control byte (both oracles accept).
test "redteam_p2_text_fields_reject_tab_and_del" {
  debug_assert(parses("v=0\r\no=- 1 1 IN IP4 x\r\ns=a\tb\r\nt=0 0\r\n"), "TAB in s= rejected")
  debug_assert(parses(hdr() + "a=x:a\tb\r\n"), "TAB in attribute value rejected")
  debug_assert(parses("v=0\r\no=- 1 1 IN IP4 x\r\ns=a\x7Fb\r\nt=0 0\r\n"), "DEL in s= rejected")
}

///| A trailing empty line (common in hand-built / SIP-gateway SDP) fails the whole parse
///| (sdp.pion:373); webrtc-rs and Mozilla webrtc-sdp both accept it.
test "redteam_p2_trailing_empty_line_rejected" {
  debug_assert(parses(hdr() + "\r\n"), "trailing CRLF line rejected")
}

///| RFC 8866 §5 fixes the session-level order (v o s i u e p c b t r z k a). Out-of-order
///| documents are accepted (both oracles reject) and silently reordered by serialize.
test "redteam_p2_field_order_not_enforced" {
  debug_assert(!parses("v=0\r\nt=0 0\r\no=- 1 1 IN IP4 x\r\ns=-\r\n"), "t= before o= accepted")
  debug_assert(!parses("v=0\r\no=- 1 1 IN IP4 x\r\na=x\r\ns=-\r\nt=0 0\r\n"), "a= before s= accepted")
}

///| Duplicate `i=` overwrites silently (sdp.pion:431-438); duplicate media `c=` keeps only the
///| last (RFC 8866 §5.7 allows several media-level c= for layered multicast) -> lossy.
test "redteam_p2_duplicate_i_and_c_silently_overwritten" {
  let d = must_parse("v=0\r\no=- 1 1 IN IP4 x\r\ns=-\r\ni=one\r\ni=two\r\nt=0 0\r\n")
  debug_assert(
    match d.session_info {
      Some(v) => v == "one"
      None => false
    },
    "duplicate i= replaced the first value",
  )
}

///| `e=` / `p=` / `k=` / `z=` inside a media section are accepted and dropped (sdp.pion:536-540);
///| RFC 8866 only allows `k=` there (webrtc-rs and Mozilla reject `e=` in media).
test "redteam_p2_session_only_fields_in_media_accepted" {
  debug_assert(!parses(video("e=a@b\r\n")), "e= inside media accepted")
}

///| RFC 8853 §5.1: at most one `send` and one `recv` list; duplicates / empty lists accepted.
test "redteam_p2_simulcast_duplicate_direction_and_empty" {
  let d = must_parse(video("a=simulcast:send a send b\r\n"))
  debug_assert(
    match sdp::simulcast(d.media[0]) {
      Err(_) => true
      Ok(_) => false
    },
    "duplicate simulcast send direction accepted",
  )
  let d2 = must_parse(video("a=simulcast:send ;;\r\n"))
  debug_assert(
    match sdp::simulcast(d2.media[0]) {
      Err(_) => true
      Ok(_) => false
    },
    "empty simulcast RID list accepted",
  )
}

///| All JSEP-layer errors carry line 0 (jsep.pion:70-829): the caller cannot locate the bad line.
test "redteam_p2_jsep_errors_have_no_line_number" {
  let d = must_parse(video("a=rtpmap:128 X/90000\r\n"))
  match sdp::extract_webrtc_summary(d) {
    Err(sdp::SdpError::InvalidSyntax(line, _)) => debug_assert(line > 0, "error reports line 0")
    _ => debug_assert(false, "expected InvalidSyntax")
  }
}

///| One malformed attribute anywhere — even on a rejected (port 0) m-line — fails the whole
///| summary (jsep.pion:813-848). RFC 8866 §5.13 / JSEP §5.8 ignore what they cannot use;
///| Mozilla drops the bad candidate with a warning.
test "redteam_p2_summary_all_or_nothing" {
  let t = video("") + "m=audio 0 UDP/TLS/RTP/SAVPF 0\r\na=mid:1\r\na=candidate:1 1 udp 1 1.2.3.4 9 typ host foo\r\n"
  debug_assert(summary_ok(t), "one bad candidate on a rejected m-line failed the whole summary")
}

///| RFC 8866 §5.14: port + count must stay in range; `65535/2` describes port 65536.
test "redteam_p2_port_count_overflow" {
  debug_assert(!parses(hdr() + "m=video 65535/2 RTP/AVP 0\r\n"), "65535/2 accepted")
}

///| RFC 8839 §5.4: ice-ufrag is 4..256 ice-chars, ice-pwd 22..256; unchecked here.
test "redteam_p2_ice_credentials_not_validated" {
  let d = must_parse(video("a=ice-ufrag:a\r\na=ice-pwd:b\r\n"))
  let c = sdp::ice_credentials(d, 0)
  debug_assert(
    match c.ufrag {
      Some(u) => u.length() >= 4
      None => true
    },
    "1-char ice-ufrag accepted",
  )
}

///| `a=sctp-port:65536` / `a=max-message-size` overflow silently become `None` (= "absent").
test "redteam_p2_sctp_values_out_of_range_become_absent" {
  let t = hdr() + "m=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\na=sctp-port:65536\r\n"
  debug_assert(!summary_ok(t), "sctp-port 65536 reported as absent instead of an error")
}

// ===========================================================================
// controls (must PASS)
// ===========================================================================

///|
test "control_browser_offers_parse_summarize_roundtrip" {
  let texts = [chrome_offer(), firefox_offer(), chrome_offer().replace("\r\n", "\n")]
  let mut i = 0
  while i < texts.length() {
    let d = must_parse(texts[i])
    let s = must_summary(d)
    let w1 = sdp::serialize(d)
    let w2 = sdp::serialize(must_parse(w1))
    debug_assert(w1 == w2, "serialize not idempotent")
    debug_assert(s.media.length() == d.media.length(), "summary media count")
    i = i + 1
  }
  let s = must_summary(must_parse(chrome_offer()))
  debug_assert(s.media[0].candidates.length() == 4, "4 chrome candidates (mDNS, IPv6, tcptype)")
  debug_assert(s.media[0].candidates[2].address == "4a1b2c3d-0000-4000-8000-123456789abc.local", "mdns")
  debug_assert(is_s(s.media[0].candidates[3].tcptype, "active"), "tcptype")
  match s.media[1].simulcast {
    Some(sim) => debug_assert(sim.send_rids.length() == 3, "h;q;f")
    None => debug_assert(false, "simulcast")
  }
  debug_assert(s.media[1].ssrc_groups.length() == 2, "FID + SIM")
  debug_assert(is_i(s.media[2].sctp_port, 5000), "sctp-port")
  debug_assert(s.bundle_mids.length() == 3, "bundle")
}

///|
test "control_parse_limits_exact_boundaries" {
  let t = video("")
  let n = t.length()
  let lines = 8
  debug_assert(parses_with(t, sdp::ParseLimits::new(n, 64, 4, 8)), "max_bytes exact")
  debug_assert(!parses_with(t, sdp::ParseLimits::new(n - 1, 64, 4, 8)), "max_bytes exact-1")
  debug_assert(!parses_with(t, sdp::ParseLimits::new(0, 64, 4, 8)), "max_bytes 0")
  debug_assert(!parses_with(t, sdp::ParseLimits::new(-1, 64, 4, 8)), "max_bytes -1")
  debug_assert(parses_with(t, sdp::ParseLimits::new(n, lines, 4, 8)), "max_lines exact")
  debug_assert(!parses_with(t, sdp::ParseLimits::new(n, lines - 1, 4, 8)), "max_lines exact-1")
  debug_assert(!parses_with(t, sdp::ParseLimits::new(n, -1, 4, 8)), "max_lines -1")
  debug_assert(parses_with(t, sdp::ParseLimits::new(n, 64, 1, 8)), "max_media exact")
  debug_assert(!parses_with(t, sdp::ParseLimits::new(n, 64, 0, 8)), "max_media 0")
  debug_assert(!parses_with(t, sdp::ParseLimits::new(n, 64, -1, 8)), "max_media -1")
  debug_assert(parses_with(t, sdp::ParseLimits::new(n, 64, 1, 2)), "max_attrs exact")
  debug_assert(!parses_with(t, sdp::ParseLimits::new(n, 64, 1, 1)), "max_attrs exact-1")
  debug_assert(!parses_with(t, sdp::ParseLimits::new(n, 64, 1, -1)), "max_attrs -1")
  debug_assert(parses_with(hdr(), sdp::ParseLimits::new(200, 4, 0, 0)), "zero media/attrs ok")
}

///|
test "control_rejects_nul_bare_cr_and_line_shape" {
  debug_assert(!parses(hdr() + "a=x:\x00\r\n"), "NUL")
  debug_assert(!parses(hdr() + "a=x\ra=y\r\n"), "bare CR")
  debug_assert(!parses(hdr() + "x=1\r\n"), "unknown type")
  debug_assert(!parses(hdr() + "A=1\r\n"), "uppercase type")
  debug_assert(!parses(hdr() + "a=\r\n"), "empty a=")
  debug_assert(!parses(""), "empty")
  debug_assert(!parses("o=- 1 1 IN IP4 x\r\nv=0\r\n"), "v= not first")
}

///|
test "control_required_and_duplicate_fields" {
  debug_assert(!parses("v=0\r\nv=0\r\no=- 1 1 IN IP4 x\r\ns=-\r\nt=0 0\r\n"), "dup v")
  debug_assert(!parses("v=1\r\no=- 1 1 IN IP4 x\r\ns=-\r\nt=0 0\r\n"), "v=1")
  debug_assert(!parses("v=0\r\no=- 1 1 IN IP4\r\ns=-\r\nt=0 0\r\n"), "o= 5 fields")
  debug_assert(!parses("v=0\r\no=- -1 1 IN IP4 x\r\ns=-\r\nt=0 0\r\n"), "negative sess-id")
  debug_assert(!parses(hdr() + "s=again\r\n"), "dup s")
  debug_assert(!parses(hdr() + "o=- 1 1 IN IP4 x\r\n"), "dup o")
  debug_assert(!parses("v=0\r\no=- 1 1 IN IP4 x\r\ns=-\r\n"), "missing t")
  debug_assert(!parses("v=0\r\no=- 1 1 IN IP4 x\r\ns=-\r\nt=-1 0\r\n"), "negative t")
  debug_assert(!parses(video("t=0 0\r\n")), "t in media")
  debug_assert(!parses(video("o=- 1 1 IN IP4 x\r\n")), "o in media")
  debug_assert(!parses(video("s=x\r\n")), "s in media")
  debug_assert(!parses(video("u=http://x\r\n")), "u in media")
}

///|
test "control_integer_bounds_no_overflow" {
  debug_assert(!parses(hdr() + "m=video 65536 RTP/AVP 0\r\n"), "port 65536")
  debug_assert(!parses(hdr() + "m=video 99999999999999999999 RTP/AVP 0\r\n"), "port huge")
  debug_assert(!parses(hdr() + "m=video 49170/0 RTP/AVP 0\r\n"), "port count 0")
  debug_assert(!parses(hdr() + "b=AS:99999999999999999999\r\n"), "b= overflow")
  debug_assert(!parses("v=0\r\no=- 1 1 IN IP4 x\r\ns=-\r\nt=99999999999999999999 0\r\n"), "t overflow")
  debug_assert(!summary_ok(video("a=rtpmap:128 X/90000\r\n")), "pt 128")
  debug_assert(!summary_ok(video("a=fmtp:-1 x\r\n")), "pt -1")
  debug_assert(!summary_ok(video("a=ssrc:4294967296 cname:x\r\n")), "ssrc 2^32")
  debug_assert(summary_ok(video("a=ssrc:4294967295 cname:x\r\n")), "ssrc 2^32-1")
  debug_assert(!summary_ok(video("a=ssrc-group:FID 1 99999999999999999999\r\n")), "ssrc-group")
  debug_assert(!summary_ok(video("a=candidate:1 1 udp 4294967296 1.2.3.4 1 typ host\r\n")), "prio")
  debug_assert(summary_ok(video("a=candidate:1 1 udp 4294967295 ::1 65535 typ host\r\n")), "prio max")
  debug_assert(!summary_ok(video("a=candidate:1 1 udp 1 1.2.3.4 65536 typ host\r\n")), "cand port")
  debug_assert(!summary_ok(video("a=extmap:0 urn:x\r\n")), "extmap 0")
  debug_assert(summary_ok(video("a=extmap:14 urn:x\r\n")), "extmap 14")
  let d = must_parse(hdr() + "m=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\na=max-message-size:9223372036854775807\r\n")
  debug_assert(is_i64(sdp::max_message_size(d.media[0]), 9223372036854775807L), "i64 max")
}

///|
test "control_utf8_and_high_bytes_kept_verbatim" {
  let d = must_parse("v=0\r\no=- 1 1 IN IP4 x\r\ns=caf\u{e9} \u{4f1a}\u{8bae}\r\nt=0 0\r\n")
  debug_assert(d.session_name == "caf\u{e9} \u{4f1a}\u{8bae}", "utf-8 session name")
  debug_assert(must_parse(sdp::serialize(d)).session_name == d.session_name, "utf-8 roundtrip")
}

///|
test "control_parsed_values_cannot_carry_line_breaks" {
  // Whatever parse() accepts, serialize(parse(x)) re-parses to the same structure.
  let d = must_parse(chrome_offer())
  let d2 = must_parse(sdp::serialize(d))
  debug_assert(d2.attributes.length() == d.attributes.length(), "session attrs")
  let mut i = 0
  while i < d.media.length() {
    debug_assert(d2.media[i].attributes.length() == d.media[i].attributes.length(), "media attrs")
    i = i + 1
  }
}

///|
test "control_ice_session_fallback_and_media_override" {
  let t = hdr() + "a=ice-ufrag:sess\r\na=ice-pwd:sesspwdsesspwdsesspwd00\r\n" +
  "m=audio 9 UDP/TLS/RTP/SAVPF 0\r\na=ice-ufrag:med1\r\n" + "m=audio 9 UDP/TLS/RTP/SAVPF 0\r\n"
  let d = must_parse(t)
  debug_assert(is_s(sdp::ice_credentials(d, 0).ufrag, "med1"), "media override")
  debug_assert(is_s(sdp::ice_credentials(d, 0).pwd, "sesspwdsesspwdsesspwd00"), "pwd fallback")
  debug_assert(is_s(sdp::ice_credentials(d, 1).ufrag, "sess"), "session fallback")
  debug_assert(is_s(sdp::ice_credentials(d, 7).ufrag, "sess"), "out-of-range index safe")
  debug_assert(is_s(sdp::ice_credentials(d, -1).ufrag, "sess"), "negative index safe")
}
