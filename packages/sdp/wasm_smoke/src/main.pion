///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/sdp`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "sdp"

fn fnv1a_64_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

fn smoke_offer() -> String {
  "v=0\r\n" +
  "o=- 4611731400430051336 2 IN IP4 127.0.0.1\r\n" +
  "s=-\r\n" +
  "t=0 0\r\n" +
  "a=group:BUNDLE 0 1 2\r\n" +
  "a=extmap-allow-mixed\r\n" +
  "a=ice-options:trickle renomination\r\n" +
  "a=fingerprint:sha-256 AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99\r\n" +
  "m=audio 9 UDP/TLS/RTP/SAVPF 111 0\r\n" +
  "c=IN IP4 0.0.0.0\r\n" +
  "b=AS:128\r\n" +
  "a=candidate:1467250027 1 udp 2122260223 192.168.1.10 54321 typ host generation 0 ufrag abcd network-id 1 network-cost 10\r\n" +
  "a=ice-ufrag:abcd\r\n" +
  "a=ice-pwd:supersecretpassword123456\r\n" +
  "a=setup:actpass\r\n" +
  "a=mid:0\r\n" +
  "a=extmap:1 urn:ietf:params:rtp-hdrext:ssrc-audio-level\r\n" +
  "a=sendrecv\r\n" +
  "a=rtcp-mux\r\n" +
  "a=rtpmap:111 opus/48000/2\r\n" +
  "a=fmtp:111 minptime=10;useinbandfec=1\r\n" +
  "a=rtpmap:0 PCMU/8000\r\n" +
  "m=video 9 UDP/TLS/RTP/SAVPF 96 98 99\r\n" +
  "c=IN IP4 0.0.0.0\r\n" +
  "a=ice-ufrag:abcd\r\n" +
  "a=ice-pwd:supersecretpassword123456\r\n" +
  "a=setup:actpass\r\n" +
  "a=mid:1\r\n" +
  "a=extmap:3 http://www.ietf.org/id/draft-holmer-rmcat-transport-wide-cc-extensions-01\r\n" +
  "a=sendonly\r\n" +
  "a=rtcp-mux\r\n" +
  "a=rtcp-rsize\r\n" +
  "a=rtpmap:96 VP8/90000\r\n" +
  "a=rtcp-fb:96 nack pli\r\n" +
  "a=rtcp-fb:* nack\r\n" +
  "a=rtpmap:98 VP9/90000\r\n" +
  "a=rtpmap:99 H264/90000\r\n" +
  "a=rid:q send pt=96\r\n" +
  "a=rid:h send pt=96\r\n" +
  "a=simulcast:send q;h\r\n" +
  "a=ssrc-group:FID 2002001 2002002\r\n" +
  "a=ssrc:2002001 cname:meet-cname-01\r\n" +
  "m=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\n" +
  "c=IN IP4 0.0.0.0\r\n" +
  "a=ice-ufrag:abcd\r\n" +
  "a=ice-pwd:supersecretpassword123456\r\n" +
  "a=setup:actpass\r\n" +
  "a=mid:2\r\n" +
  "a=sctp-port:5000\r\n" +
  "a=max-message-size:262144\r\n"
}

pub fn main(world : World) -> Int {
  let raw = smoke_offer()
  let desc = match sdp::parse(raw) {
    Ok(d) => d
    Err(e) => {
      io_println(world, "ERR parse: " + sdp::sdp_error_message(e))
      return 1
    }
  }
  let ser = sdp::serialize(desc)
  if ser != raw {
    io_println(world, "ERR roundtrip mismatch")
    return 2
  }
  let summary = match sdp::extract_webrtc_summary(desc) {
    Ok(s) => s
    Err(e) => {
      io_println(world, "ERR summary: " + sdp::sdp_error_message(e))
      return 3
    }
  }
  // Verify ParseLimits rejection
  let lim_ok = match sdp::parse_with_limits(raw, sdp::ParseLimits::new(65536, 1000, 1, 100)) {
    Err(sdp::SdpError::LimitExceeded(_)) => true
    _ => false
  }
  if !lim_ok {
    io_println(world, "ERR limit not enforced")
    return 4
  }
  let cand_fmt = sdp::format_ice_candidate(summary.media[0].candidates[0])
  io_println(world, "sdp_wasm_smoke:ok")
  io_println(
    world,
    "bytes=" + ser.length().to_string() +
    " fnv64=" + hex_u64(fnv1a_64_str(ser)) +
    " bundle=" + summary.bundle_mids.length().to_string() +
    " media=" + summary.media.length().to_string() +
    " video_rtpmaps=" + summary.media[1].rtpmaps.length().to_string() +
    " video_rids=" + summary.media[1].rids.length().to_string(),
  )
  io_println(world, "cand=" + cand_fmt)
  0
}
