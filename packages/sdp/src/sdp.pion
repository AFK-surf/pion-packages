///| RFC 8866 SDP parser and strict CRLF (`\r\n`) canonical serializer.

///| Parse a non-negative base-10 `Int64` from `s[start..end)`.
///| Returns `None` on empty slice, non-digit characters, or `Int64` overflow.
fn parse_u63_slice(s : String, start : Int, end : Int) -> Option[Int64] {
  if start >= end {
    return None
  }
  let mut acc : Int64 = 0L
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    let digit = (c - 48).to_int64()
    if acc > (9223372036854775807L - digit) / 10L {
      return None
    }
    acc = acc * 10L + digit
    i = i + 1
  }
  Some(acc)
}

///| Parse a non-negative base-10 `Int` within `[min_val, max_val]` from `s[start..end)`.
fn parse_int_range_slice(
  s : String,
  start : Int,
  end : Int,
  min_val : Int,
  max_val : Int,
) -> Option[Int] {
  match parse_u63_slice(s, start, end) {
    Some(v) => {
      if v < min_val.to_int64() || v > max_val.to_int64() {
        None
      } else {
        Some(v.to_int())
      }
    }
    None => None
  }
}

///| Check whether `s[start..end)` consists of one or more ASCII digits.
fn is_ascii_digits(s : String, start : Int, end : Int) -> Bool {
  if start >= end {
    return false
  }
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return false
    }
    i = i + 1
  }
  true
}

///| Find the first occurrence of ASCII byte `target` in `s[start..end)`. Returns `-1` if absent.
fn find_byte_slice(s : String, start : Int, end : Int, target : Int) -> Int {
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == target {
      return i
    }
    i = i + 1
  }
  -1
}

///| Check whether `s` contains NUL (`0x00`), CR (`0x0D`), or LF (`0x0A`).
fn has_line_break_or_nul(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 0 || c == 10 || c == 13 {
      return true
    }
    i = i + 1
  }
  false
}

///| Check whether `s` is a valid non-empty single SDP token (no NUL, CR, LF, or ASCII space).
fn is_valid_single_token(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 0 || c == 10 || c == 13 || c == 32 {
      return false
    }
    i = i + 1
  }
  true
}

///| Check whether `s` is a valid attribute key (non-empty, no NUL/CR/LF/space/colon).
fn is_valid_attr_key(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 0 || c == 10 || c == 13 || c == 32 || c == 58 {
      return false
    }
    i = i + 1
  }
  true
}

///| Split `s[start..end)` by single ASCII spaces (`0x20`).
///| Returns `None` if there are leading, trailing, or consecutive spaces, or empty input.
fn split_single_spaces_strict(s : String, start : Int, end : Int) -> Option[Array[String]] {
  if start >= end {
    return None
  }
  let parts : Array[String] = []
  let mut tok_start = start
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == 32 {
      if i == tok_start {
        return None
      }
      parts.push(s.slice(tok_start, i))
      tok_start = i + 1
    }
    i = i + 1
  }
  if tok_start >= end {
    return None
  }
  parts.push(s.slice(tok_start, end))
  Some(parts)
}

///| Parse `o=<username> <sess-id> <sess-version> <nettype> <addrtype> <unicast-address>`.
fn parse_origin(
  s : String,
  start : Int,
  end : Int,
  line_no : Int,
) -> Result[Origin, SdpError] {
  match split_single_spaces_strict(s, start, end) {
    Some(parts) => {
      if parts.length() != 6 {
        return Err(SdpError::InvalidSyntax(line_no, "o= requires exactly 6 space-separated fields"))
      }
      let sid = parts[1]
      let sver = parts[2]
      if !is_ascii_digits(sid, 0, sid.length()) {
        return Err(SdpError::InvalidSyntax(line_no, "o= session_id must be ASCII digits"))
      }
      if !is_ascii_digits(sver, 0, sver.length()) {
        return Err(SdpError::InvalidSyntax(line_no, "o= session_version must be ASCII digits"))
      }
      Ok(
        Origin::{
          username: parts[0],
          session_id: sid,
          session_version: sver,
          net_type: parts[3],
          addr_type: parts[4],
          unicast_address: parts[5],
        },
      )
    }
    None => Err(SdpError::InvalidSyntax(line_no, "malformed o= line"))
  }
}

///| Parse `c=<nettype> <addrtype> <connection-address>`.
fn parse_connection(
  s : String,
  start : Int,
  end : Int,
  line_no : Int,
) -> Result[Connection, SdpError] {
  match split_single_spaces_strict(s, start, end) {
    Some(parts) => {
      if parts.length() != 3 {
        return Err(SdpError::InvalidSyntax(line_no, "c= requires exactly 3 space-separated fields"))
      }
      Ok(Connection::{ net_type: parts[0], addr_type: parts[1], address: parts[2] })
    }
    None => Err(SdpError::InvalidSyntax(line_no, "malformed c= line"))
  }
}

///| Parse `b=<bwtype>:<bandwidth>`.
fn parse_bandwidth(
  s : String,
  start : Int,
  end : Int,
  line_no : Int,
) -> Result[Bandwidth, SdpError] {
  let colon = find_byte_slice(s, start, end, 58)
  if colon <= start || colon + 1 >= end {
    return Err(SdpError::InvalidSyntax(line_no, "b= requires <bwtype>:<bandwidth>"))
  }
  let bwtype = s.slice(start, colon)
  if find_byte_slice(bwtype, 0, bwtype.length(), 32) >= 0 {
    return Err(SdpError::InvalidSyntax(line_no, "b= bwtype must not contain spaces"))
  }
  match parse_u63_slice(s, colon + 1, end) {
    Some(bw) => Ok(Bandwidth::{ bwtype: bwtype, bandwidth: bw })
    None => Err(SdpError::InvalidSyntax(line_no, "b= bandwidth must be a non-negative integer"))
  }
}

///| Parse `t=<start-time> <stop-time>`.
fn parse_timing(
  s : String,
  start : Int,
  end : Int,
  line_no : Int,
) -> Result[(Int64, Int64), SdpError] {
  let sp = find_byte_slice(s, start, end, 32)
  if sp <= start || sp + 1 >= end {
    return Err(SdpError::InvalidSyntax(line_no, "t= requires <start-time> <stop-time>"))
  }
  if find_byte_slice(s, sp + 1, end, 32) >= 0 {
    return Err(SdpError::InvalidSyntax(line_no, "t= has unexpected extra fields"))
  }
  let start_t = match parse_u63_slice(s, start, sp) {
    Some(v) => v
    None => return Err(SdpError::InvalidSyntax(line_no, "t= invalid start-time"))
  }
  let stop_t = match parse_u63_slice(s, sp + 1, end) {
    Some(v) => v
    None => return Err(SdpError::InvalidSyntax(line_no, "t= invalid stop-time"))
  }
  Ok((start_t, stop_t))
}

///| Parse `a=<attribute>` or `a=<attribute>:<value>`.
fn parse_attribute(
  s : String,
  start : Int,
  end : Int,
  line_no : Int,
) -> Result[Attribute, SdpError] {
  if start >= end {
    return Err(SdpError::InvalidSyntax(line_no, "empty a= line"))
  }
  let colon = find_byte_slice(s, start, end, 58)
  if colon < 0 {
    if find_byte_slice(s, start, end, 32) >= 0 {
      return Err(SdpError::InvalidSyntax(line_no, "property attribute name must not contain spaces"))
    }
    Ok(Attribute::{ key: s.slice(start, end), value: None })
  } else {
    if colon == start {
      return Err(SdpError::InvalidSyntax(line_no, "attribute name must not be empty"))
    }
    if find_byte_slice(s, start, colon, 32) >= 0 {
      return Err(SdpError::InvalidSyntax(line_no, "attribute name must not contain spaces"))
    }
    Ok(Attribute::{ key: s.slice(start, colon), value: Some(s.slice(colon + 1, end)) })
  }
}

///| Parse `m=<media> <port>[/<number of ports>] <proto> <fmt> ...`.
fn parse_media_header(
  s : String,
  start : Int,
  end : Int,
  line_no : Int,
) -> Result[(String, Int, Option[Int], String, Array[String]), SdpError] {
  match split_single_spaces_strict(s, start, end) {
    Some(parts) => {
      if parts.length() < 4 {
        return Err(
          SdpError::InvalidSyntax(line_no, "m= requires <media> <port> <proto> <fmt>..."),
        )
      }
      let media_type = parts[0]
      let port_tok = parts[1]
      let slash = find_byte_slice(port_tok, 0, port_tok.length(), 47)
      let (port, port_count) = if slash < 0 {
        match parse_int_range_slice(port_tok, 0, port_tok.length(), 0, 65535) {
          Some(p) => (p, None)
          None => return Err(SdpError::InvalidSyntax(line_no, "m= port must be in 0..65535"))
        }
      } else {
        let p = match parse_int_range_slice(port_tok, 0, slash, 0, 65535) {
          Some(v) => v
          None => return Err(SdpError::InvalidSyntax(line_no, "m= port must be in 0..65535"))
        }
        let cnt = match
        parse_int_range_slice(port_tok, slash + 1, port_tok.length(), 1, 65535) {
          Some(v) => v
          None => return Err(SdpError::InvalidSyntax(line_no, "m= port count must be in 1..65535"))
        }
        if p + cnt - 1 > 65535 {
          return Err(SdpError::InvalidSyntax(line_no, "m= port + port_count exceeds 65535"))
        }
        (p, Some(cnt))
      }
      let protocol = parts[2]
      let formats : Array[String] = []
      let mut i = 3
      while i < parts.length() {
        formats.push(parts[i])
        i = i + 1
      }
      Ok((media_type, port, port_count, protocol, formats))
    }
    None => Err(SdpError::InvalidSyntax(line_no, "malformed m= line"))
  }
}

///| Check whether `text[pos..total_len)` consists exclusively of valid line endings (`\r\n` or `\n`).
fn is_only_trailing_empty_lines(text : String, pos : Int, total_len : Int) -> Bool {
  let mut i = pos
  while i < total_len {
    let c = text.code_unit_at(i)
    if c == 13 {
      if i + 1 < total_len && text.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        return false
      }
    } else if c == 10 {
      i = i + 1
    } else {
      return false
    }
  }
  true
}

///| Return preserved session-level `e=` email lines.
pub fn session_emails(desc : SessionDescription) -> Array[String] {
  if desc.timings.length() > 0 {
    desc.timings[0].emails
  } else {
    []
  }
}

///| Return preserved session-level `p=` phone lines.
pub fn session_phones(desc : SessionDescription) -> Array[String] {
  if desc.timings.length() > 0 {
    desc.timings[0].phones
  } else {
    []
  }
}

///| Return preserved session-level `z=` time-zone adjustment line.
pub fn session_time_zones(desc : SessionDescription) -> Option[String] {
  if desc.timings.length() > 0 {
    desc.timings[0].time_zones
  } else {
    None
  }
}

///| Return preserved session-level `k=` encryption key line.
pub fn session_encryption_key(desc : SessionDescription) -> Option[String] {
  if desc.timings.length() > 0 {
    desc.timings[0].encryption_key
  } else {
    None
  }
}

///| Parse an SDP string using `ParseLimits::default()`.
pub fn parse(text : String) -> Result[SessionDescription, SdpError] {
  parse_with_limits(text, ParseLimits::default())
}

///| Parse an SDP string enforcing explicit `ParseLimits`, RFC 8866 §5 field order,
///| and RFC 8866 §9 byte-string rules.
pub fn parse_with_limits(
  text : String,
  limits : ParseLimits,
) -> Result[SessionDescription, SdpError] {
  if limits.max_bytes < 0 {
    return Err(SdpError::LimitExceeded("max_bytes cannot be negative"))
  }
  if limits.max_lines < 0 {
    return Err(SdpError::LimitExceeded("max_lines cannot be negative"))
  }
  if limits.max_media_sections < 0 {
    return Err(SdpError::LimitExceeded("max_media_sections cannot be negative"))
  }
  if limits.max_attributes_per_section < 0 {
    return Err(SdpError::LimitExceeded("max_attributes_per_section cannot be negative"))
  }

  let total_len = text.length()
  if total_len == 0 {
    return Err(SdpError::EmptyInput)
  }
  if total_len > limits.max_bytes {
    return Err(SdpError::LimitExceeded("input exceeds max_bytes"))
  }

  let mut seen_v = false
  let mut version = 0
  let mut seen_o = false
  let mut origin = Origin::{
    username: "",
    session_id: "",
    session_version: "",
    net_type: "",
    addr_type: "",
    unicast_address: "",
  }
  let mut seen_s = false
  let mut session_name = ""
  let mut session_info : Option[String] = None
  let mut uri : Option[String] = None
  let session_emails_buf : Array[String] = []
  let session_phones_buf : Array[String] = []
  let mut session_conn : Option[Connection] = None
  let session_bws : Array[Bandwidth] = []
  let timing_starts : Array[Int64] = []
  let timing_stops : Array[Int64] = []
  let timing_repeats : Array[Array[String]] = []
  let mut session_tz : Option[String] = None
  let mut session_key : Option[String] = None
  let session_attrs : Array[Attribute] = []
  let media : Array[MediaDescription] = []

  // RFC 8866 §5 monotonic stage tracking:
  // Session: v(0) o(1) s(2) i(3) u(4) e(5) p(6) c(7) b(8) t(9)/r(10) z(11) k(12) a(13)
  let mut sess_stage = -1
  // Media: m(0) i(1) c(2) b(3) k(4) a(5)
  let mut media_stage = -1

  // Current media section builder state
  let mut in_media = false
  let mut cur_m_type = ""
  let mut cur_m_port = 0
  let mut cur_m_port_count : Option[Int] = None
  let mut cur_m_proto = ""
  let mut cur_m_formats : Array[String] = []
  let mut cur_m_title : Option[String] = None
  let mut cur_m_conn : Option[Connection] = None
  let mut cur_m_bws : Array[Bandwidth] = []
  let mut cur_m_attrs : Array[Attribute] = []

  let mut pos = 0
  let mut line_no = 0
  while pos < total_len {
    // Allow trailing empty line(s) after at least one content line
    if line_no > 0 && is_only_trailing_empty_lines(text, pos, total_len) {
      break
    }
    line_no = line_no + 1
    if line_no > limits.max_lines {
      return Err(SdpError::LimitExceeded("exceeded max_lines"))
    }
    // Scan to LF or CRLF while rejecting NUL and bare CR (RFC 8866 §9 byte-string allows TAB/DEL).
    let line_start = pos
    let mut line_end = total_len
    let mut next_pos = total_len
    let mut i = pos
    while i < total_len {
      let c = text.code_unit_at(i)
      if c == 13 {
        if i + 1 < total_len && text.code_unit_at(i + 1) == 10 {
          line_end = i
          next_pos = i + 2
          break
        } else {
          return Err(SdpError::InvalidLine(line_no, "bare CR not allowed"))
        }
      } else if c == 10 {
        line_end = i
        next_pos = i + 1
        break
      } else if c == 0 {
        return Err(SdpError::InvalidLine(line_no, "NUL byte not allowed"))
      } else if c < 32 && c != 9 {
        return Err(SdpError::InvalidLine(line_no, "control character not allowed"))
      }
      i = i + 1
    }
    pos = next_pos

    if line_end <= line_start {
      return Err(SdpError::InvalidLine(line_no, "empty line not allowed"))
    }
    if line_end - line_start < 2 {
      return Err(SdpError::InvalidLine(line_no, "line must be <type>=<value>"))
    }
    let key_ch = text.code_unit_at(line_start)
    if key_ch < 97 || key_ch > 122 {
      return Err(SdpError::InvalidLine(line_no, "field type must be a single lowercase letter"))
    }
    if text.code_unit_at(line_start + 1) != 61 {
      return Err(SdpError::InvalidLine(line_no, "expected '=' after field type"))
    }
    let val_start = line_start + 2
    let val_end = line_end

    if line_no == 1 && key_ch != 118 {
      return Err(SdpError::MissingRequiredField("v="))
    }

    if key_ch == 118 {
      // 'v' (stage 0)
      if seen_v {
        return Err(SdpError::InvalidSyntax(line_no, "duplicate v= line"))
      }
      if val_end - val_start != 1 || text.code_unit_at(val_start) != 48 {
        return Err(SdpError::InvalidSyntax(line_no, "v= version must be 0"))
      }
      seen_v = true
      version = 0
      sess_stage = 0
    } else if key_ch == 111 {
      // 'o' (stage 1)
      if in_media {
        return Err(SdpError::InvalidSyntax(line_no, "o= not allowed inside media section"))
      }
      if seen_o {
        return Err(SdpError::InvalidSyntax(line_no, "duplicate o= line"))
      }
      if sess_stage > 1 {
        return Err(SdpError::InvalidSyntax(line_no, "o= out of RFC 8866 field order"))
      }
      match parse_origin(text, val_start, val_end, line_no) {
        Ok(o) => {
          origin = o
          seen_o = true
          sess_stage = 1
        }
        Err(e) => return Err(e)
      }
    } else if key_ch == 115 {
      // 's' (stage 2)
      if in_media {
        return Err(SdpError::InvalidSyntax(line_no, "s= not allowed inside media section"))
      }
      if seen_s {
        return Err(SdpError::InvalidSyntax(line_no, "duplicate s= line"))
      }
      if sess_stage > 2 {
        return Err(SdpError::InvalidSyntax(line_no, "s= out of RFC 8866 field order"))
      }
      if val_start >= val_end {
        return Err(SdpError::InvalidSyntax(line_no, "s= session name must not be empty"))
      }
      session_name = text.slice(val_start, val_end)
      seen_s = true
      sess_stage = 2
    } else if key_ch == 105 {
      // 'i' (session stage 3, media stage 1; first-wins if repeated)
      let info = text.slice(val_start, val_end)
      if in_media {
        if media_stage > 1 {
          return Err(SdpError::InvalidSyntax(line_no, "media i= out of RFC 8866 field order"))
        }
        match cur_m_title {
          None => cur_m_title = Some(info)
          Some(_) => ()
        }
        media_stage = 1
      } else {
        if sess_stage > 3 {
          return Err(SdpError::InvalidSyntax(line_no, "i= out of RFC 8866 field order"))
        }
        match session_info {
          None => session_info = Some(info)
          Some(_) => ()
        }
        sess_stage = 3
      }
    } else if key_ch == 117 {
      // 'u' (session stage 4)
      if in_media {
        return Err(SdpError::InvalidSyntax(line_no, "u= not allowed inside media section"))
      }
      if sess_stage > 4 {
        return Err(SdpError::InvalidSyntax(line_no, "u= out of RFC 8866 field order"))
      }
      if val_start >= val_end {
        return Err(SdpError::InvalidSyntax(line_no, "u= URI must not be empty"))
      }
      uri = Some(text.slice(val_start, val_end))
      sess_stage = 4
    } else if key_ch == 101 {
      // 'e' (session stage 5, repeatable)
      if in_media {
        return Err(SdpError::InvalidSyntax(line_no, "e= not allowed inside media section"))
      }
      if sess_stage > 5 {
        return Err(SdpError::InvalidSyntax(line_no, "e= out of RFC 8866 field order"))
      }
      if val_start >= val_end {
        return Err(SdpError::InvalidSyntax(line_no, "e= must not be empty"))
      }
      session_emails_buf.push(text.slice(val_start, val_end))
      sess_stage = 5
    } else if key_ch == 112 {
      // 'p' (session stage 6, repeatable)
      if in_media {
        return Err(SdpError::InvalidSyntax(line_no, "p= not allowed inside media section"))
      }
      if sess_stage > 6 {
        return Err(SdpError::InvalidSyntax(line_no, "p= out of RFC 8866 field order"))
      }
      if val_start >= val_end {
        return Err(SdpError::InvalidSyntax(line_no, "p= must not be empty"))
      }
      session_phones_buf.push(text.slice(val_start, val_end))
      sess_stage = 6
    } else if key_ch == 99 {
      // 'c' (session stage 7, media stage 2; first-wins if repeated)
      match parse_connection(text, val_start, val_end, line_no) {
        Ok(c) => {
          if in_media {
            if media_stage > 2 {
              return Err(SdpError::InvalidSyntax(line_no, "media c= out of RFC 8866 field order"))
            }
            match cur_m_conn {
              None => cur_m_conn = Some(c)
              Some(_) => ()
            }
            media_stage = 2
          } else {
            if sess_stage > 7 {
              return Err(SdpError::InvalidSyntax(line_no, "c= out of RFC 8866 field order"))
            }
            match session_conn {
              None => session_conn = Some(c)
              Some(_) => ()
            }
            sess_stage = 7
          }
        }
        Err(e) => return Err(e)
      }
    } else if key_ch == 98 {
      // 'b' (session stage 8, media stage 3)
      match parse_bandwidth(text, val_start, val_end, line_no) {
        Ok(bw) => {
          if in_media {
            if media_stage > 3 {
              return Err(SdpError::InvalidSyntax(line_no, "media b= out of RFC 8866 field order"))
            }
            cur_m_bws.push(bw)
            media_stage = 3
          } else {
            if sess_stage > 8 {
              return Err(SdpError::InvalidSyntax(line_no, "b= out of RFC 8866 field order"))
            }
            session_bws.push(bw)
            sess_stage = 8
          }
        }
        Err(e) => return Err(e)
      }
    } else if key_ch == 116 {
      // 't' (session stage 9, repeatable after t or r)
      if in_media {
        return Err(SdpError::InvalidSyntax(line_no, "t= not allowed inside media section"))
      }
      if sess_stage > 10 {
        return Err(SdpError::InvalidSyntax(line_no, "t= out of RFC 8866 field order"))
      }
      match parse_timing(text, val_start, val_end, line_no) {
        Ok((st, sp)) => {
          timing_starts.push(st)
          timing_stops.push(sp)
          timing_repeats.push([])
          sess_stage = 9
        }
        Err(e) => return Err(e)
      }
    } else if key_ch == 114 {
      // 'r' (session stage 10, must follow t=)
      if in_media {
        return Err(SdpError::InvalidSyntax(line_no, "r= not allowed inside media section"))
      }
      if timing_starts.length() == 0 || sess_stage > 10 {
        return Err(SdpError::InvalidSyntax(line_no, "r= must immediately follow t="))
      }
      if val_start >= val_end {
        return Err(SdpError::InvalidSyntax(line_no, "r= must not be empty"))
      }
      timing_repeats[timing_repeats.length() - 1].push(text.slice(val_start, val_end))
      sess_stage = 10
    } else if key_ch == 122 {
      // 'z' (session stage 11)
      if in_media {
        return Err(SdpError::InvalidSyntax(line_no, "z= not allowed inside media section"))
      }
      if sess_stage > 11 {
        return Err(SdpError::InvalidSyntax(line_no, "z= out of RFC 8866 field order"))
      }
      if val_start >= val_end {
        return Err(SdpError::InvalidSyntax(line_no, "z= must not be empty"))
      }
      session_tz = Some(text.slice(val_start, val_end))
      sess_stage = 11
    } else if key_ch == 107 {
      // 'k' (session stage 12, media stage 4)
      if val_start >= val_end {
        return Err(SdpError::InvalidSyntax(line_no, "k= must not be empty"))
      }
      if in_media {
        if media_stage > 4 {
          return Err(SdpError::InvalidSyntax(line_no, "media k= out of RFC 8866 field order"))
        }
        media_stage = 4
      } else {
        if sess_stage > 12 {
          return Err(SdpError::InvalidSyntax(line_no, "k= out of RFC 8866 field order"))
        }
        session_key = Some(text.slice(val_start, val_end))
        sess_stage = 12
      }
    } else if key_ch == 109 {
      // 'm'
      if in_media {
        media.push(
          MediaDescription::{
            media_type: cur_m_type,
            port: cur_m_port,
            port_count: cur_m_port_count,
            protocol: cur_m_proto,
            formats: cur_m_formats,
            title: cur_m_title,
            connection: cur_m_conn,
            bandwidths: cur_m_bws,
            attributes: cur_m_attrs,
          },
        )
      }
      if media.length() >= limits.max_media_sections {
        return Err(SdpError::LimitExceeded("exceeded max_media_sections"))
      }
      match parse_media_header(text, val_start, val_end, line_no) {
        Ok((mt, mp, mpc, mproto, mfmts)) => {
          in_media = true
          media_stage = 0
          cur_m_type = mt
          cur_m_port = mp
          cur_m_port_count = mpc
          cur_m_proto = mproto
          cur_m_formats = mfmts
          cur_m_title = None
          cur_m_conn = None
          cur_m_bws = []
          cur_m_attrs = []
        }
        Err(e) => return Err(e)
      }
    } else if key_ch == 97 {
      // 'a' (session stage 13, media stage 5)
      if in_media {
        if cur_m_attrs.length() >= limits.max_attributes_per_section {
          return Err(SdpError::LimitExceeded("exceeded max_attributes_per_section"))
        }
        media_stage = 5
      } else {
        if session_attrs.length() >= limits.max_attributes_per_section {
          return Err(SdpError::LimitExceeded("exceeded max_attributes_per_section"))
        }
        sess_stage = 13
      }
      match parse_attribute(text, val_start, val_end, line_no) {
        Ok(attr) => {
          if in_media {
            cur_m_attrs.push(attr)
          } else {
            session_attrs.push(attr)
          }
        }
        Err(e) => return Err(e)
      }
    } else {
      return Err(SdpError::InvalidLine(line_no, "unknown SDP field type"))
    }
  }

  if in_media {
    media.push(
      MediaDescription::{
        media_type: cur_m_type,
        port: cur_m_port,
        port_count: cur_m_port_count,
        protocol: cur_m_proto,
        formats: cur_m_formats,
        title: cur_m_title,
        connection: cur_m_conn,
        bandwidths: cur_m_bws,
        attributes: cur_m_attrs,
      },
    )
  }

  if !seen_v {
    return Err(SdpError::MissingRequiredField("v="))
  }
  if !seen_o {
    return Err(SdpError::MissingRequiredField("o="))
  }
  if !seen_s {
    return Err(SdpError::MissingRequiredField("s="))
  }
  if timing_starts.length() == 0 {
    return Err(SdpError::MissingRequiredField("t="))
  }

  let timings : Array[Timing] = []
  let mut ti = 0
  while ti < timing_starts.length() {
    if ti == 0 {
      timings.push(
        Timing::{
          start_time: timing_starts[ti],
          stop_time: timing_stops[ti],
          repeats: timing_repeats[ti],
          emails: session_emails_buf,
          phones: session_phones_buf,
          time_zones: session_tz,
          encryption_key: session_key,
        },
      )
    } else {
      timings.push(
        Timing::{
          start_time: timing_starts[ti],
          stop_time: timing_stops[ti],
          repeats: timing_repeats[ti],
          emails: [],
          phones: [],
          time_zones: None,
          encryption_key: None,
        },
      )
    }
    ti = ti + 1
  }

  Ok(
    SessionDescription::{
      version: version,
      origin: origin,
      session_name: session_name,
      session_info: session_info,
      uri: uri,
      connection: session_conn,
      bandwidths: session_bws,
      timings: timings,
      attributes: session_attrs,
      media: media,
    },
  )
}

///| Write a `Connection` line (`c=...`) with CRLF to `sb`.
fn write_connection(sb : StringBuilder, c : Connection) -> Unit {
  sb.write_string("c=")
  sb.write_string(c.net_type)
  sb.write_byte((32).to_byte())
  sb.write_string(c.addr_type)
  sb.write_byte((32).to_byte())
  sb.write_string(c.address)
  sb.write_string("\r\n")
}

///| Write a `Bandwidth` line (`b=...`) with CRLF to `sb`.
fn write_bandwidth(sb : StringBuilder, b : Bandwidth) -> Unit {
  sb.write_string("b=")
  sb.write_string(b.bwtype)
  sb.write_byte((58).to_byte())
  sb.write_string(b.bandwidth.to_string())
  sb.write_string("\r\n")
}

///| Write an `Attribute` line (`a=...`) with CRLF to `sb`.
fn write_attribute(sb : StringBuilder, a : Attribute) -> Unit {
  sb.write_string("a=")
  sb.write_string(a.key)
  match a.value {
    Some(v) => {
      sb.write_byte((58).to_byte())
      sb.write_string(v)
    }
    None => ()
  }
  sb.write_string("\r\n")
}

///| Validate a `Connection` before serialization.
fn validate_connection(c : Connection) -> Result[Unit, SdpError] {
  if !is_valid_single_token(c.net_type) ||
  !is_valid_single_token(c.addr_type) ||
  !is_valid_single_token(c.address) {
    return Err(SdpError::InvalidSyntax(0, "invalid c= field token"))
  }
  Ok(())
}

///| Validate a `Bandwidth` before serialization.
fn validate_bandwidth(b : Bandwidth) -> Result[Unit, SdpError] {
  if !is_valid_single_token(b.bwtype) ||
  find_byte_slice(b.bwtype, 0, b.bwtype.length(), 58) >= 0 ||
  b.bandwidth < 0L {
    return Err(SdpError::InvalidSyntax(0, "invalid b= field"))
  }
  Ok(())
}

///| Validate an `Attribute` before serialization (prevents CRLF/NUL injection and key re-split).
fn validate_attribute(a : Attribute) -> Result[Unit, SdpError] {
  if !is_valid_attr_key(a.key) {
    return Err(SdpError::InvalidSyntax(0, "invalid attribute key"))
  }
  match a.value {
    Some(v) => {
      if has_line_break_or_nul(v) {
        return Err(SdpError::InvalidSyntax(0, "attribute value contains CR/LF/NUL"))
      }
    }
    None => ()
  }
  Ok(())
}

///| Validate and serialize a `SessionDescription` with strict RFC 8866 CRLF (`\r\n`) line endings.
///| Rejects any CR/LF/NUL injection, invalid `Attribute.key` (containing `:` or space),
///| invalid single-token fields, `version != 0`, or empty `session_name`.
pub fn serialize_checked(desc : SessionDescription) -> Result[String, SdpError] {
  if desc.version != 0 {
    return Err(SdpError::InvalidSyntax(0, "v= version must be 0"))
  }
  if !is_valid_single_token(desc.origin.username) ||
  !is_ascii_digits(desc.origin.session_id, 0, desc.origin.session_id.length()) ||
  !is_ascii_digits(desc.origin.session_version, 0, desc.origin.session_version.length()) ||
  !is_valid_single_token(desc.origin.net_type) ||
  !is_valid_single_token(desc.origin.addr_type) ||
  !is_valid_single_token(desc.origin.unicast_address) {
    return Err(SdpError::InvalidSyntax(0, "invalid o= field"))
  }
  if desc.session_name.length() == 0 || has_line_break_or_nul(desc.session_name) {
    return Err(SdpError::InvalidSyntax(0, "invalid s= session_name"))
  }
  match desc.session_info {
    Some(info) => {
      if has_line_break_or_nul(info) {
        return Err(SdpError::InvalidSyntax(0, "i= contains CR/LF/NUL"))
      }
    }
    None => ()
  }
  match desc.uri {
    Some(u) => {
      if u.length() == 0 || has_line_break_or_nul(u) {
        return Err(SdpError::InvalidSyntax(0, "invalid u= URI"))
      }
    }
    None => ()
  }
  match desc.connection {
    Some(c) => {
      match validate_connection(c) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    None => ()
  }
  if desc.timings.length() == 0 {
    return Err(SdpError::MissingRequiredField("t="))
  }

  let sb = StringBuilder::new()
  // v=
  sb.write_string("v=0\r\n")
  // o=
  sb.write_string("o=")
  sb.write_string(desc.origin.username)
  sb.write_byte((32).to_byte())
  sb.write_string(desc.origin.session_id)
  sb.write_byte((32).to_byte())
  sb.write_string(desc.origin.session_version)
  sb.write_byte((32).to_byte())
  sb.write_string(desc.origin.net_type)
  sb.write_byte((32).to_byte())
  sb.write_string(desc.origin.addr_type)
  sb.write_byte((32).to_byte())
  sb.write_string(desc.origin.unicast_address)
  sb.write_string("\r\n")
  // s=
  sb.write_string("s=")
  sb.write_string(desc.session_name)
  sb.write_string("\r\n")
  // i=
  match desc.session_info {
    Some(info) => {
      sb.write_string("i=")
      sb.write_string(info)
      sb.write_string("\r\n")
    }
    None => ()
  }
  // u=
  match desc.uri {
    Some(u) => {
      sb.write_string("u=")
      sb.write_string(u)
      sb.write_string("\r\n")
    }
    None => ()
  }
  // e=
  let emails = session_emails(desc)
  let mut i = 0
  while i < emails.length() {
    if emails[i].length() == 0 || has_line_break_or_nul(emails[i]) {
      return Err(SdpError::InvalidSyntax(0, "invalid e= line"))
    }
    sb.write_string("e=")
    sb.write_string(emails[i])
    sb.write_string("\r\n")
    i = i + 1
  }
  // p=
  let phones = session_phones(desc)
  i = 0
  while i < phones.length() {
    if phones[i].length() == 0 || has_line_break_or_nul(phones[i]) {
      return Err(SdpError::InvalidSyntax(0, "invalid p= line"))
    }
    sb.write_string("p=")
    sb.write_string(phones[i])
    sb.write_string("\r\n")
    i = i + 1
  }
  // c=
  match desc.connection {
    Some(c) => write_connection(sb, c)
    None => ()
  }
  // b=
  i = 0
  while i < desc.bandwidths.length() {
    match validate_bandwidth(desc.bandwidths[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    write_bandwidth(sb, desc.bandwidths[i])
    i = i + 1
  }
  // t= and r=
  i = 0
  while i < desc.timings.length() {
    let t = desc.timings[i]
    if t.start_time < 0L || t.stop_time < 0L {
      return Err(SdpError::InvalidSyntax(0, "negative t= time"))
    }
    sb.write_string("t=")
    sb.write_string(t.start_time.to_string())
    sb.write_byte((32).to_byte())
    sb.write_string(t.stop_time.to_string())
    sb.write_string("\r\n")
    let mut ri = 0
    while ri < t.repeats.length() {
      if t.repeats[ri].length() == 0 || has_line_break_or_nul(t.repeats[ri]) {
        return Err(SdpError::InvalidSyntax(0, "invalid r= line"))
      }
      sb.write_string("r=")
      sb.write_string(t.repeats[ri])
      sb.write_string("\r\n")
      ri = ri + 1
    }
    i = i + 1
  }
  // z=
  match session_time_zones(desc) {
    Some(tz) => {
      if tz.length() == 0 || has_line_break_or_nul(tz) {
        return Err(SdpError::InvalidSyntax(0, "invalid z= line"))
      }
      sb.write_string("z=")
      sb.write_string(tz)
      sb.write_string("\r\n")
    }
    None => ()
  }
  // k=
  match session_encryption_key(desc) {
    Some(k) => {
      if k.length() == 0 || has_line_break_or_nul(k) {
        return Err(SdpError::InvalidSyntax(0, "invalid k= line"))
      }
      sb.write_string("k=")
      sb.write_string(k)
      sb.write_string("\r\n")
    }
    None => ()
  }
  // session a=
  i = 0
  while i < desc.attributes.length() {
    match validate_attribute(desc.attributes[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    write_attribute(sb, desc.attributes[i])
    i = i + 1
  }
  // media sections
  let mut mi = 0
  while mi < desc.media.length() {
    let m = desc.media[mi]
    if !is_valid_single_token(m.media_type) ||
    m.port < 0 ||
    m.port > 65535 ||
    !is_valid_single_token(m.protocol) ||
    m.formats.length() == 0 {
      return Err(SdpError::InvalidSyntax(0, "invalid m= header"))
    }
    match m.port_count {
      Some(pc) => {
        if pc < 1 || m.port + pc - 1 > 65535 {
          return Err(SdpError::InvalidSyntax(0, "invalid m= port_count"))
        }
      }
      None => ()
    }
    sb.write_string("m=")
    sb.write_string(m.media_type)
    sb.write_byte((32).to_byte())
    sb.write_string(m.port.to_string())
    match m.port_count {
      Some(pc) => {
        sb.write_byte((47).to_byte())
        sb.write_string(pc.to_string())
      }
      None => ()
    }
    sb.write_byte((32).to_byte())
    sb.write_string(m.protocol)
    let mut fi = 0
    while fi < m.formats.length() {
      if !is_valid_single_token(m.formats[fi]) {
        return Err(SdpError::InvalidSyntax(0, "invalid m= format token"))
      }
      sb.write_byte((32).to_byte())
      sb.write_string(m.formats[fi])
      fi = fi + 1
    }
    sb.write_string("\r\n")
    match m.title {
      Some(title) => {
        if has_line_break_or_nul(title) {
          return Err(SdpError::InvalidSyntax(0, "media i= contains CR/LF/NUL"))
        }
        sb.write_string("i=")
        sb.write_string(title)
        sb.write_string("\r\n")
      }
      None => ()
    }
    match m.connection {
      Some(c) => {
        match validate_connection(c) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        write_connection(sb, c)
      }
      None => ()
    }
    let mut bi = 0
    while bi < m.bandwidths.length() {
      match validate_bandwidth(m.bandwidths[bi]) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      write_bandwidth(sb, m.bandwidths[bi])
      bi = bi + 1
    }
    let mut ai = 0
    while ai < m.attributes.length() {
      match validate_attribute(m.attributes[ai]) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      write_attribute(sb, m.attributes[ai])
      ai = ai + 1
    }
    mi = mi + 1
  }
  Ok(sb.to_string())
}

///| Serialize a `SessionDescription` with strict RFC 8866 CRLF (`\r\n`) line endings.
///| Fails closed (returns `""`) if any field contains CR/LF/NUL injection or invalid tokens;
///| use `serialize_checked` for explicit `Result[String, SdpError]`.
pub fn serialize(desc : SessionDescription) -> String {
  match serialize_checked(desc) {
    Ok(s) => s
    Err(_) => ""
  }
}
