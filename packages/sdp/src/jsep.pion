///| RFC 8829 (JSEP), RFC 8839 (ICE), RFC 8843 (BUNDLE), RFC 8122 (DTLS fingerprint),
///| RFC 8285 (extmap), and RFC 8851/8853 (Simulcast) structured attribute parsers
///| and WebRTC summary extractor.

let max_ice_option_tokens : Int = 32
let max_ice_options_bytes : Int = 256

///| Split `s` by ASCII spaces (`0x20`), ignoring consecutive/leading/trailing spaces.
fn split_ws(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    while i < n && s.code_unit_at(i) == 32 {
      i = i + 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && s.code_unit_at(i) != 32 {
      i = i + 1
    }
    out.push(s.slice(start, i))
  }
  out
}

///| Check whether `c` is an RFC 8839 `ice-char` (`ALPHA / DIGIT / "+" / "/"`).
fn is_ice_char(c : Int) -> Bool {
  (c >= 65 && c <= 90) ||
  (c >= 97 && c <= 122) ||
  (c >= 48 && c <= 57) ||
  c == 43 ||
  c == 47
}

///| Check whether `c` is a valid `ice-option-tag` character (`ice-char` or `-`).
fn is_ice_option_char(c : Int) -> Bool {
  is_ice_char(c) || c == 45
}

///| Validate RFC 8839 §5.4 `ice-ufrag` (4..256 `ice-char`s).
fn is_valid_ice_ufrag(s : String) -> Bool {
  let n = s.length()
  if n < 4 || n > 256 {
    return false
  }
  let mut i = 0
  while i < n {
    if !is_ice_char(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Validate RFC 8839 §5.4 `ice-pwd` (22..256 `ice-char`s).
fn is_valid_ice_pwd(s : String) -> Bool {
  let n = s.length()
  if n < 22 || n > 256 {
    return false
  }
  let mut i = 0
  while i < n {
    if !is_ice_char(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Validate RFC 8851 `rid-id` (`1*(ALPHA / DIGIT / "-" / "_")`).
fn is_valid_rid_id(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    let ok = (c >= 65 && c <= 90) ||
    (c >= 97 && c <= 122) ||
    (c >= 48 && c <= 57) ||
    c == 45 ||
    c == 95
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

///| Check whether `c` is an ASCII hex digit (`0-9`, `A-F`, `a-f`).
fn is_hex_digit(c : Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

///| ASCII case-insensitive equality against a lowercase literal.
fn eq_ignore_ascii_case(s : String, lower : String) -> Bool {
  let n = s.length()
  if n != lower.length() {
    return false
  }
  let mut i = 0
  while i < n {
    let mut c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      c = c + 32
    }
    if c != lower.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Return `(expected_bytes, strength_rank)` for an RFC 8122 hash algorithm, or `(-1, -1)` if unknown.
fn fingerprint_alg_info(alg : String) -> (Int, Int) {
  if eq_ignore_ascii_case(alg, "sha-256") {
    (32, 6)
  } else if eq_ignore_ascii_case(alg, "sha-384") {
    (48, 5)
  } else if eq_ignore_ascii_case(alg, "sha-512") {
    (64, 4)
  } else if eq_ignore_ascii_case(alg, "sha-224") {
    (28, 3)
  } else if eq_ignore_ascii_case(alg, "sha-1") {
    (20, 2)
  } else if eq_ignore_ascii_case(alg, "md5") {
    (16, 1)
  } else if eq_ignore_ascii_case(alg, "md2") {
    (16, 0)
  } else {
    (-1, -1)
  }
}

///| Validate an RFC 8122 §5 fingerprint value (`2HEX *(":" 2HEX)` with exact byte count).
fn is_valid_fingerprint_hex(hex_str : String, expected_bytes : Int) -> Bool {
  let expected_len = expected_bytes * 3 - 1
  if hex_str.length() != expected_len {
    return false
  }
  let mut i = 0
  while i < expected_len {
    let rem = i % 3
    let c = hex_str.code_unit_at(i)
    if rem == 2 {
      if c != 58 {
        return false
      }
    } else if !is_hex_digit(c) {
      return false
    }
    i = i + 1
  }
  true
}

///| Parse a `Direction` token.
fn parse_direction_token(tok : String) -> Option[Direction] {
  if tok == "sendrecv" {
    Some(Direction::SendRecv)
  } else if tok == "sendonly" {
    Some(Direction::SendOnly)
  } else if tok == "recvonly" {
    Some(Direction::RecvOnly)
  } else if tok == "inactive" {
    Some(Direction::Inactive)
  } else {
    None
  }
}

///| Internal ICE candidate parser carrying a 1-based line number for error reporting.
fn parse_ice_candidate_at(value : String, line_no : Int) -> Result[IceCandidate, SdpError] {
  let body = if value.length() >= 10 && value.slice(0, 10) == "candidate:" {
    value.slice(10, value.length())
  } else {
    value
  }
  let parts = split_ws(body)
  if parts.length() < 8 {
    return Err(SdpError::InvalidSyntax(line_no, "ICE candidate requires at least 8 tokens"))
  }
  let foundation = parts[0]
  let component = match parse_int_range_slice(parts[1], 0, parts[1].length(), 1, 256) {
    Some(v) => v
    None => return Err(SdpError::InvalidSyntax(line_no, "invalid ICE candidate component"))
  }
  let transport = parts[2]
  let priority = match parse_u63_slice(parts[3], 0, parts[3].length()) {
    Some(v) => {
      if v > 4294967295L {
        return Err(SdpError::InvalidSyntax(line_no, "ICE candidate priority exceeds uint32"))
      }
      v
    }
    None => return Err(SdpError::InvalidSyntax(line_no, "invalid ICE candidate priority"))
  }
  let address = parts[4]
  let port = match parse_int_range_slice(parts[5], 0, parts[5].length(), 0, 65535) {
    Some(v) => v
    None => return Err(SdpError::InvalidSyntax(line_no, "invalid ICE candidate port"))
  }
  if parts[6] != "typ" {
    return Err(SdpError::InvalidSyntax(line_no, "ICE candidate missing 'typ' keyword"))
  }
  let typ = parts[7]

  let mut raddr : Option[String] = None
  let mut rport : Option[Int] = None
  let mut tcptype : Option[String] = None
  let mut generation : Option[Int] = None
  let mut ufrag : Option[String] = None
  let extensions : Array[IceExtension] = []

  if (parts.length() - 8) % 2 != 0 {
    return Err(SdpError::InvalidSyntax(line_no, "ICE candidate trailing extension key without value"))
  }
  let mut i = 8
  while i < parts.length() {
    let k = parts[i]
    let v = parts[i + 1]
    if k == "raddr" {
      raddr = Some(v)
    } else if k == "rport" {
      match parse_int_range_slice(v, 0, v.length(), 0, 65535) {
        Some(p) => rport = Some(p)
        None => return Err(SdpError::InvalidSyntax(line_no, "invalid ICE candidate rport"))
      }
    } else if k == "tcptype" {
      tcptype = Some(v)
    } else if k == "generation" {
      match parse_int_range_slice(v, 0, v.length(), 0, 2147483647) {
        Some(g) => generation = Some(g)
        None => return Err(SdpError::InvalidSyntax(line_no, "invalid ICE candidate generation"))
      }
    } else if k == "ufrag" {
      ufrag = Some(v)
    } else {
      extensions.push(IceExtension::{ key: k, value: v })
    }
    i = i + 2
  }

  Ok(
    IceCandidate::{
      foundation: foundation,
      component: component,
      transport: transport,
      priority: priority,
      address: address,
      port: port,
      typ: typ,
      raddr: raddr,
      rport: rport,
      tcptype: tcptype,
      generation: generation,
      ufrag: ufrag,
      extensions: extensions,
    },
  )
}

///| Parse an ICE candidate attribute value (with or without leading `candidate:`).
pub fn parse_ice_candidate(value : String) -> Result[IceCandidate, SdpError] {
  parse_ice_candidate_at(value, 1)
}

///| Validate and format an `IceCandidate` into its canonical SDP attribute value.
///| Rejects any token containing spaces, CR, LF, NUL, or out-of-range numeric fields.
pub fn format_ice_candidate_checked(cand : IceCandidate) -> Result[String, SdpError] {
  if !is_valid_single_token(cand.foundation) ||
  cand.component < 1 ||
  cand.component > 256 ||
  !is_valid_single_token(cand.transport) ||
  cand.priority < 0L ||
  cand.priority > 4294967295L ||
  !is_valid_single_token(cand.address) ||
  cand.port < 0 ||
  cand.port > 65535 ||
  !is_valid_single_token(cand.typ) {
    return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate field"))
  }
  let sb = StringBuilder::new()
  sb.write_string(cand.foundation)
  sb.write_byte((32).to_byte())
  sb.write_string(cand.component.to_string())
  sb.write_byte((32).to_byte())
  sb.write_string(cand.transport)
  sb.write_byte((32).to_byte())
  sb.write_string(cand.priority.to_string())
  sb.write_byte((32).to_byte())
  sb.write_string(cand.address)
  sb.write_byte((32).to_byte())
  sb.write_string(cand.port.to_string())
  sb.write_string(" typ ")
  sb.write_string(cand.typ)
  match cand.raddr {
    Some(ra) => {
      if !is_valid_single_token(ra) {
        return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate raddr"))
      }
      sb.write_string(" raddr ")
      sb.write_string(ra)
    }
    None => ()
  }
  match cand.rport {
    Some(rp) => {
      if rp < 0 || rp > 65535 {
        return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate rport"))
      }
      sb.write_string(" rport ")
      sb.write_string(rp.to_string())
    }
    None => ()
  }
  match cand.tcptype {
    Some(tt) => {
      if !is_valid_single_token(tt) {
        return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate tcptype"))
      }
      sb.write_string(" tcptype ")
      sb.write_string(tt)
    }
    None => ()
  }
  match cand.generation {
    Some(gen) => {
      if gen < 0 {
        return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate generation"))
      }
      sb.write_string(" generation ")
      sb.write_string(gen.to_string())
    }
    None => ()
  }
  match cand.ufrag {
    Some(uf) => {
      if !is_valid_single_token(uf) {
        return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate ufrag"))
      }
      sb.write_string(" ufrag ")
      sb.write_string(uf)
    }
    None => ()
  }
  let mut i = 0
  while i < cand.extensions.length() {
    let ext = cand.extensions[i]
    if !is_valid_single_token(ext.key) || !is_valid_single_token(ext.value) {
      return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate extension"))
    }
    sb.write_byte((32).to_byte())
    sb.write_string(ext.key)
    sb.write_byte((32).to_byte())
    sb.write_string(ext.value)
    i = i + 1
  }
  Ok(sb.to_string())
}

///| Format an `IceCandidate` into its canonical SDP attribute value (without `a=candidate:`).
///| Fails closed (returns `""`) on any token containing spaces or CR/LF/NUL; use
///| `format_ice_candidate_checked` for explicit `Result[String, SdpError]`.
pub fn format_ice_candidate(cand : IceCandidate) -> String {
  match format_ice_candidate_checked(cand) {
    Ok(s) => s
    Err(_) => ""
  }
}

///| Internal `a=candidate:` parser with 1-based attribute base line number.
fn ice_candidates_at(
  media : MediaDescription,
  attr_base_line : Int,
  ignore_errors : Bool,
) -> Result[Array[IceCandidate], SdpError] {
  let out : Array[IceCandidate] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "candidate" {
      let line_no = attr_base_line + i
      match attr.value {
        Some(v) => {
          match parse_ice_candidate_at(v, line_no) {
            Ok(c) => out.push(c)
            Err(e) => if !ignore_errors { return Err(e) }
          }
        }
        None => if !ignore_errors {
          return Err(SdpError::InvalidSyntax(line_no, "a=candidate requires a value"))
        }
      }
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=candidate:` attributes on a media section.
pub fn ice_candidates(media : MediaDescription) -> Result[Array[IceCandidate], SdpError] {
  ice_candidates_at(media, 1, false)
}

///| Find the first attribute matching `key` in `attrs`: returns `(found, value)`.
fn find_attr_entry(attrs : Array[Attribute], key : String) -> (Bool, Option[String]) {
  let mut i = 0
  while i < attrs.length() {
    if attrs[i].key == key {
      return (true, attrs[i].value)
    }
    i = i + 1
  }
  (false, None)
}

///| Find the first value attribute matching `key` in `attrs`.
fn find_attr_value(attrs : Array[Attribute], key : String) -> Option[String] {
  let mut i = 0
  while i < attrs.length() {
    if attrs[i].key == key {
      match attrs[i].value {
        Some(v) => return Some(v)
        None => ()
      }
    }
    i = i + 1
  }
  None
}

///| Extract and bound `ice-options` tokens from an attribute list.
///| Enforces RFC 8839 §5.6 token syntax and a strict cap (`max_ice_option_tokens`, `max_ice_options_bytes`).
fn extract_ice_options_checked(
  attrs : Array[Attribute],
  attr_base_line : Int,
) -> Result[Array[String], SdpError] {
  let out : Array[String] = []
  let mut total_bytes = 0
  let mut i = 0
  while i < attrs.length() {
    if attrs[i].key == "ice-options" {
      let line_no = attr_base_line + i
      match attrs[i].value {
        Some(v) => {
          total_bytes = total_bytes + v.length()
          if total_bytes > max_ice_options_bytes {
            return Err(SdpError::LimitExceeded("ice-options exceeds 256-byte limit"))
          }
          let n = v.length()
          let mut p = 0
          while p < n {
            while p < n && v.code_unit_at(p) == 32 {
              p = p + 1
            }
            if p >= n {
              break
            }
            let start = p
            while p < n && v.code_unit_at(p) != 32 {
              if !is_ice_option_char(v.code_unit_at(p)) {
                return Err(SdpError::InvalidSyntax(line_no, "invalid ice-options token character"))
              }
              p = p + 1
            }
            if out.length() >= max_ice_option_tokens {
              return Err(SdpError::LimitExceeded("ice-options exceeds 32-token limit"))
            }
            out.push(v.slice(start, p))
          }
        }
        None => ()
      }
    }
    i = i + 1
  }
  Ok(out)
}

///| Extract `ice-options` tokens with strict bounds (returns empty array if over limit).
fn extract_ice_options_bounded(attrs : Array[Attribute]) -> Array[String] {
  match extract_ice_options_checked(attrs, 1) {
    Ok(opts) => opts
    Err(_) => []
  }
}

///| Validate an optional `ice-ufrag` attribute value.
fn validated_ufrag(v : Option[String]) -> Option[String] {
  match v {
    Some(s) => if is_valid_ice_ufrag(s) { Some(s) } else { None }
    None => None
  }
}

///| Validate an optional `ice-pwd` attribute value.
fn validated_pwd(v : Option[String]) -> Option[String] {
  match v {
    Some(s) => if is_valid_ice_pwd(s) { Some(s) } else { None }
    None => None
  }
}

///| Extract ICE credentials for `media_idx` (media-level preferred, session-level fallback).
///| Validates RFC 8839 §5.4 `ice-ufrag` (4..256) and `ice-pwd` (22..256) lengths and character sets,
///| and bounds `ice-options` to 32 tokens / 256 bytes.
pub fn ice_credentials(session : SessionDescription, media_idx : Int) -> IceCredentials {
  let mut ufrag = validated_ufrag(find_attr_value(session.attributes, "ice-ufrag"))
  let mut pwd = validated_pwd(find_attr_value(session.attributes, "ice-pwd"))
  let mut options = extract_ice_options_bounded(session.attributes)

  if media_idx >= 0 && media_idx < session.media.length() {
    let mattrs = session.media[media_idx].attributes
    let (has_mu, mu_val) = find_attr_entry(mattrs, "ice-ufrag")
    if has_mu {
      ufrag = validated_ufrag(mu_val)
    }
    let (has_mp, mp_val) = find_attr_entry(mattrs, "ice-pwd")
    if has_mp {
      pwd = validated_pwd(mp_val)
    }
    let mopts = extract_ice_options_bounded(mattrs)
    if mopts.length() > 0 {
      options = mopts
    }
  }
  IceCredentials::{ ufrag: ufrag, pwd: pwd, options: options }
}

///| Parse and validate all RFC 8122 `a=fingerprint:` attributes in `attrs`.
///| Returns `(has_any_fingerprint_attr, valid_fingerprints)`.
fn collect_fingerprints(attrs : Array[Attribute]) -> (Bool, Array[DtlsFingerprint]) {
  let out : Array[DtlsFingerprint] = []
  let mut has_any = false
  let mut i = 0
  while i < attrs.length() {
    if attrs[i].key == "fingerprint" {
      has_any = true
      match attrs[i].value {
        Some(v) => {
          let sp = find_byte_slice(v, 0, v.length(), 32)
          if sp > 0 && sp + 1 < v.length() {
            let alg = v.slice(0, sp)
            let fp_val = v.slice(sp + 1, v.length())
            let (expected_bytes, _) = fingerprint_alg_info(alg)
            if expected_bytes > 0 && is_valid_fingerprint_hex(fp_val, expected_bytes) {
              out.push(DtlsFingerprint::{ algorithm: alg, value: fp_val })
            }
          }
        }
        None => ()
      }
    }
    i = i + 1
  }
  (has_any, out)
}

///| Select the strongest validated fingerprint (preferring `sha-256` over weaker hashes like `sha-1`).
fn best_fingerprint(fps : Array[DtlsFingerprint]) -> Option[DtlsFingerprint] {
  if fps.length() == 0 {
    return None
  }
  let mut best = fps[0]
  let (_, best_rank0) = fingerprint_alg_info(best.algorithm)
  let mut best_rank = best_rank0
  let mut i = 1
  while i < fps.length() {
    let (_, r) = fingerprint_alg_info(fps[i].algorithm)
    if r > best_rank {
      best = fps[i]
      best_rank = r
    }
    i = i + 1
  }
  Some(best)
}

///| Extract all valid RFC 8122 DTLS fingerprints for `media_idx` (media-level overrides session-level;
///| if media-level declares any `a=fingerprint`, session-level fallback is not used).
pub fn fingerprints(session : SessionDescription, media_idx : Int) -> Array[DtlsFingerprint] {
  if media_idx >= 0 && media_idx < session.media.length() {
    let (has_media_fp, media_fps) = collect_fingerprints(session.media[media_idx].attributes)
    if has_media_fp {
      return media_fps
    }
  }
  let (_, sess_fps) = collect_fingerprints(session.attributes)
  sess_fps
}

///| Extract the strongest valid RFC 8122 DTLS fingerprint for `media_idx`
///| (media-level preferred, session-level fallback only if media has no `a=fingerprint` attribute).
pub fn fingerprint(session : SessionDescription, media_idx : Int) -> Option[DtlsFingerprint] {
  best_fingerprint(fingerprints(session, media_idx))
}

///| Extract DTLS setup role (`a=setup:...`) on a media section.
pub fn dtls_setup(media : MediaDescription) -> Option[DtlsSetup] {
  match find_attr_value(media.attributes, "setup") {
    Some(v) => {
      if eq_ignore_ascii_case(v, "active") {
        Some(DtlsSetup::Active)
      } else if eq_ignore_ascii_case(v, "passive") {
        Some(DtlsSetup::Passive)
      } else if eq_ignore_ascii_case(v, "actpass") {
        Some(DtlsSetup::Actpass)
      } else if eq_ignore_ascii_case(v, "holdconn") {
        Some(DtlsSetup::Holdconn)
      } else {
        None
      }
    }
    None => None
  }
}

///| Internal `a=rtpmap:` parser with 1-based attribute base line number.
fn rtpmaps_at(
  media : MediaDescription,
  attr_base_line : Int,
  ignore_errors : Bool,
) -> Result[Array[RtpMap], SdpError] {
  let out : Array[RtpMap] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "rtpmap" {
      let line_no = attr_base_line + i
      let v = match attr.value {
        Some(s) => s
        None => {
          if ignore_errors {
            i = i + 1
            continue
          }
          return Err(SdpError::InvalidSyntax(line_no, "a=rtpmap requires a value"))
        }
      }
      let sp = find_byte_slice(v, 0, v.length(), 32)
      if sp <= 0 || sp + 1 >= v.length() {
        if ignore_errors {
          i = i + 1
          continue
        }
        return Err(SdpError::InvalidSyntax(line_no, "a=rtpmap requires <pt> <enc>/<clock>[/<ch>]"))
      }
      let pt = match parse_int_range_slice(v, 0, sp, 0, 127) {
        Some(p) => p
        None => {
          if ignore_errors {
            i = i + 1
            continue
          }
          return Err(SdpError::InvalidSyntax(line_no, "rtpmap payload type must be 0..127"))
        }
      }
      let rest = v.slice(sp + 1, v.length())
      let slash1 = find_byte_slice(rest, 0, rest.length(), 47)
      if slash1 <= 0 || slash1 + 1 >= rest.length() {
        if ignore_errors {
          i = i + 1
          continue
        }
        return Err(SdpError::InvalidSyntax(line_no, "rtpmap missing encoding/clock_rate"))
      }
      let enc = rest.slice(0, slash1)
      let slash2 = find_byte_slice(rest, slash1 + 1, rest.length(), 47)
      let (clock, channels) = if slash2 < 0 {
        let clk = match parse_int_range_slice(rest, slash1 + 1, rest.length(), 1, 2147483647) {
          Some(c) => c
          None => {
            if ignore_errors {
              i = i + 1
              continue
            }
            return Err(SdpError::InvalidSyntax(line_no, "rtpmap invalid clock_rate"))
          }
        }
        (clk, None)
      } else {
        let clk = match parse_int_range_slice(rest, slash1 + 1, slash2, 1, 2147483647) {
          Some(c) => c
          None => {
            if ignore_errors {
              i = i + 1
              continue
            }
            return Err(SdpError::InvalidSyntax(line_no, "rtpmap invalid clock_rate"))
          }
        }
        let ch = match parse_int_range_slice(rest, slash2 + 1, rest.length(), 1, 65535) {
          Some(c) => c
          None => {
            if ignore_errors {
              i = i + 1
              continue
            }
            return Err(SdpError::InvalidSyntax(line_no, "rtpmap invalid channels"))
          }
        }
        (clk, Some(ch))
      }
      out.push(
        RtpMap::{ payload_type: pt, encoding_name: enc, clock_rate: clock, channels: channels },
      )
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=rtpmap:` attributes on a media section.
pub fn rtpmaps(media : MediaDescription) -> Result[Array[RtpMap], SdpError] {
  rtpmaps_at(media, 1, false)
}

///| Internal `a=fmtp:` parser with 1-based attribute base line number.
fn fmtps_at(
  media : MediaDescription,
  attr_base_line : Int,
  ignore_errors : Bool,
) -> Result[Array[Fmtp], SdpError] {
  let out : Array[Fmtp] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "fmtp" {
      let line_no = attr_base_line + i
      let v = match attr.value {
        Some(s) => s
        None => {
          if ignore_errors {
            i = i + 1
            continue
          }
          return Err(SdpError::InvalidSyntax(line_no, "a=fmtp requires a value"))
        }
      }
      let sp = find_byte_slice(v, 0, v.length(), 32)
      if sp <= 0 || sp + 1 >= v.length() {
        if ignore_errors {
          i = i + 1
          continue
        }
        return Err(SdpError::InvalidSyntax(line_no, "a=fmtp requires <pt> <parameters>"))
      }
      let pt = match parse_int_range_slice(v, 0, sp, 0, 127) {
        Some(p) => p
        None => {
          if ignore_errors {
            i = i + 1
            continue
          }
          return Err(SdpError::InvalidSyntax(line_no, "fmtp payload type must be 0..127"))
        }
      }
      out.push(Fmtp::{ payload_type: pt, parameters: v.slice(sp + 1, v.length()) })
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=fmtp:` attributes on a media section.
pub fn fmtps(media : MediaDescription) -> Result[Array[Fmtp], SdpError] {
  fmtps_at(media, 1, false)
}

///| Internal `a=rtcp-fb:` parser with 1-based attribute base line number.
fn rtcp_fbs_at(
  media : MediaDescription,
  attr_base_line : Int,
  ignore_errors : Bool,
) -> Result[Array[RtcpFb], SdpError] {
  let out : Array[RtcpFb] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "rtcp-fb" {
      let line_no = attr_base_line + i
      let v = match attr.value {
        Some(s) => s
        None => {
          if ignore_errors {
            i = i + 1
            continue
          }
          return Err(SdpError::InvalidSyntax(line_no, "a=rtcp-fb requires a value"))
        }
      }
      let sp1 = find_byte_slice(v, 0, v.length(), 32)
      if sp1 <= 0 || sp1 + 1 >= v.length() {
        if ignore_errors {
          i = i + 1
          continue
        }
        return Err(SdpError::InvalidSyntax(line_no, "a=rtcp-fb requires <pt|*> <type>[ <param>]"))
      }
      let pt : Option[Int] = if sp1 == 1 && v.code_unit_at(0) == 42 {
        None
      } else {
        match parse_int_range_slice(v, 0, sp1, 0, 127) {
          Some(p) => Some(p)
          None => {
            if ignore_errors {
              i = i + 1
              continue
            }
            return Err(
              SdpError::InvalidSyntax(line_no, "rtcp-fb payload type must be '*' or 0..127"),
            )
          }
        }
      }
      let sp2 = find_byte_slice(v, sp1 + 1, v.length(), 32)
      let (fb_type, param) = if sp2 < 0 {
        (v.slice(sp1 + 1, v.length()), None)
      } else {
        let p_str = v.slice(sp2 + 1, v.length())
        let opt_p = if p_str.length() > 0 { Some(p_str) } else { None }
        (v.slice(sp1 + 1, sp2), opt_p)
      }
      if fb_type.length() == 0 {
        if ignore_errors {
          i = i + 1
          continue
        }
        return Err(SdpError::InvalidSyntax(line_no, "rtcp-fb feedback type must not be empty"))
      }
      out.push(RtcpFb::{ payload_type: pt, feedback_type: fb_type, parameter: param })
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=rtcp-fb:` attributes on a media section.
pub fn rtcp_fbs(media : MediaDescription) -> Result[Array[RtcpFb], SdpError] {
  rtcp_fbs_at(media, 1, false)
}

///| Validate RFC 8285 extmap ID: `1..255` (one/two-byte header) or `4096..4351` (offer-only).
fn is_valid_extmap_id(id : Int) -> Bool {
  (id >= 1 && id <= 255) || (id >= 4096 && id <= 4351)
}

///| Internal `a=extmap:` parser with 1-based attribute base line number.
fn extmaps_at(
  media : MediaDescription,
  attr_base_line : Int,
  ignore_errors : Bool,
) -> Result[Array[ExtMap], SdpError] {
  let out : Array[ExtMap] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "extmap" {
      let line_no = attr_base_line + i
      let v = match attr.value {
        Some(s) => s
        None => {
          if ignore_errors {
            i = i + 1
            continue
          }
          return Err(SdpError::InvalidSyntax(line_no, "a=extmap requires a value"))
        }
      }
      let sp1 = find_byte_slice(v, 0, v.length(), 32)
      if sp1 <= 0 || sp1 + 1 >= v.length() {
        if ignore_errors {
          i = i + 1
          continue
        }
        return Err(
          SdpError::InvalidSyntax(line_no, "a=extmap requires <id>[/<dir>] <uri>[ <params>]"),
        )
      }
      let id_part = v.slice(0, sp1)
      let slash = find_byte_slice(id_part, 0, id_part.length(), 47)
      let (id, direction) = if slash < 0 {
        let parsed_id = match parse_int_range_slice(id_part, 0, id_part.length(), 1, 4351) {
          Some(n) => {
            if !is_valid_extmap_id(n) {
              if ignore_errors {
                i = i + 1
                continue
              }
              return Err(
                SdpError::InvalidSyntax(line_no, "extmap id must be in 1..255 or 4096..4351"),
              )
            }
            n
          }
          None => {
            if ignore_errors {
              i = i + 1
              continue
            }
            return Err(
              SdpError::InvalidSyntax(line_no, "extmap id must be in 1..255 or 4096..4351"),
            )
          }
        }
        (parsed_id, None)
      } else {
        let parsed_id = match parse_int_range_slice(id_part, 0, slash, 1, 4351) {
          Some(n) => {
            if !is_valid_extmap_id(n) {
              if ignore_errors {
                i = i + 1
                continue
              }
              return Err(
                SdpError::InvalidSyntax(line_no, "extmap id must be in 1..255 or 4096..4351"),
              )
            }
            n
          }
          None => {
            if ignore_errors {
              i = i + 1
              continue
            }
            return Err(
              SdpError::InvalidSyntax(line_no, "extmap id must be in 1..255 or 4096..4351"),
            )
          }
        }
        let dir_tok = id_part.slice(slash + 1, id_part.length())
        match parse_direction_token(dir_tok) {
          Some(d) => (parsed_id, Some(d))
          None => {
            if ignore_errors {
              i = i + 1
              continue
            }
            return Err(SdpError::InvalidSyntax(line_no, "extmap invalid direction"))
          }
        }
      }
      let sp2 = find_byte_slice(v, sp1 + 1, v.length(), 32)
      let (uri, params) = if sp2 < 0 {
        (v.slice(sp1 + 1, v.length()), None)
      } else {
        let p_str = v.slice(sp2 + 1, v.length())
        let opt_p = if p_str.length() > 0 { Some(p_str) } else { None }
        (v.slice(sp1 + 1, sp2), opt_p)
      }
      if uri.length() == 0 {
        if ignore_errors {
          i = i + 1
          continue
        }
        return Err(SdpError::InvalidSyntax(line_no, "extmap URI must not be empty"))
      }
      out.push(ExtMap::{ id: id, direction: direction, uri: uri, params: params })
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=extmap:` attributes on a media section.
pub fn extmaps(media : MediaDescription) -> Result[Array[ExtMap], SdpError] {
  extmaps_at(media, 1, false)
}

///| Internal `a=ssrc:` parser with 1-based attribute base line number.
fn ssrcs_at(
  media : MediaDescription,
  attr_base_line : Int,
  ignore_errors : Bool,
) -> Result[Array[SsrcAttr], SdpError] {
  let out : Array[SsrcAttr] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "ssrc" {
      let line_no = attr_base_line + i
      let v = match attr.value {
        Some(s) => s
        None => {
          if ignore_errors {
            i = i + 1
            continue
          }
          return Err(SdpError::InvalidSyntax(line_no, "a=ssrc requires a value"))
        }
      }
      let sp = find_byte_slice(v, 0, v.length(), 32)
      if sp <= 0 || sp + 1 >= v.length() {
        if ignore_errors {
          i = i + 1
          continue
        }
        return Err(SdpError::InvalidSyntax(line_no, "a=ssrc requires <ssrc> <attr>[:<value>]"))
      }
      let ssrc_id = match parse_u63_slice(v, 0, sp) {
        Some(n) => {
          if n > 4294967295L {
            if ignore_errors {
              i = i + 1
              continue
            }
            return Err(SdpError::InvalidSyntax(line_no, "ssrc exceeds uint32"))
          }
          n
        }
        None => {
          if ignore_errors {
            i = i + 1
            continue
          }
          return Err(SdpError::InvalidSyntax(line_no, "invalid ssrc integer"))
        }
      }
      let colon = find_byte_slice(v, sp + 1, v.length(), 58)
      if colon < 0 {
        out.push(SsrcAttr::{ ssrc: ssrc_id, attribute: v.slice(sp + 1, v.length()), value: None })
      } else {
        if colon == sp + 1 {
          if ignore_errors {
            i = i + 1
            continue
          }
          return Err(SdpError::InvalidSyntax(line_no, "ssrc attribute name must not be empty"))
        }
        out.push(
          SsrcAttr::{
            ssrc: ssrc_id,
            attribute: v.slice(sp + 1, colon),
            value: Some(v.slice(colon + 1, v.length())),
          },
        )
      }
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=ssrc:` attributes on a media section.
pub fn ssrcs(media : MediaDescription) -> Result[Array[SsrcAttr], SdpError] {
  ssrcs_at(media, 1, false)
}

///| Internal `a=ssrc-group:` parser with 1-based attribute base line number.
fn ssrc_groups_at(
  media : MediaDescription,
  attr_base_line : Int,
  ignore_errors : Bool,
) -> Result[Array[SsrcGroup], SdpError] {
  let out : Array[SsrcGroup] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "ssrc-group" {
      let line_no = attr_base_line + i
      let v = match attr.value {
        Some(s) => s
        None => {
          if ignore_errors {
            i = i + 1
            continue
          }
          return Err(SdpError::InvalidSyntax(line_no, "a=ssrc-group requires a value"))
        }
      }
      let parts = split_ws(v)
      if parts.length() < 2 {
        if ignore_errors {
          i = i + 1
          continue
        }
        return Err(SdpError::InvalidSyntax(line_no, "a=ssrc-group requires <semantics> <ssrc>..."))
      }
      let sem = parts[0]
      let ids : Array[Int64] = []
      let mut bad = false
      let mut j = 1
      while j < parts.length() {
        match parse_u63_slice(parts[j], 0, parts[j].length()) {
          Some(n) => {
            if n > 4294967295L {
              if ignore_errors {
                bad = true
                break
              }
              return Err(SdpError::InvalidSyntax(line_no, "ssrc-group id exceeds uint32"))
            }
            ids.push(n)
          }
          None => {
            if ignore_errors {
              bad = true
              break
            }
            return Err(SdpError::InvalidSyntax(line_no, "invalid ssrc-group id"))
          }
        }
        j = j + 1
      }
      if !bad {
        out.push(SsrcGroup::{ semantics: sem, ssrcs: ids })
      }
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=ssrc-group:` attributes on a media section.
pub fn ssrc_groups(media : MediaDescription) -> Result[Array[SsrcGroup], SdpError] {
  ssrc_groups_at(media, 1, false)
}

///| Find a direction attribute in `attrs`.
fn find_direction(attrs : Array[Attribute]) -> Option[Direction] {
  let mut i = 0
  while i < attrs.length() {
    match attrs[i].value {
      None => {
        match parse_direction_token(attrs[i].key) {
          Some(d) => return Some(d)
          None => ()
        }
      }
      Some(_) => ()
    }
    i = i + 1
  }
  None
}

///| Determine effective media direction (media-level preferred, session-level fallback, default `SendRecv`).
pub fn media_direction(session : SessionDescription, media_idx : Int) -> Direction {
  if media_idx >= 0 && media_idx < session.media.length() {
    match find_direction(session.media[media_idx].attributes) {
      Some(d) => return d
      None => ()
    }
  }
  match find_direction(session.attributes) {
    Some(d) => d
    None => Direction::SendRecv
  }
}

///| Extract all `a=group:BUNDLE ...` groups from the session description.
pub fn bundle_groups(session : SessionDescription) -> Array[BundleGroup] {
  let out : Array[BundleGroup] = []
  let mut i = 0
  while i < session.attributes.length() {
    let attr = session.attributes[i]
    if attr.key == "group" {
      match attr.value {
        Some(v) => {
          let parts = split_ws(v)
          if parts.length() >= 1 && parts[0] == "BUNDLE" {
            let mids : Array[String] = []
            let mut j = 1
            while j < parts.length() {
              mids.push(parts[j])
              j = j + 1
            }
            out.push(BundleGroup::{ mids: mids })
          }
        }
        None => ()
      }
    }
    i = i + 1
  }
  out
}

///| Extract `a=mid:<value>` from a media section.
pub fn media_mid(media : MediaDescription) -> Option[String] {
  find_attr_value(media.attributes, "mid")
}

///| Extract all `a=msid:<value>` entries from a media section.
pub fn media_msids(media : MediaDescription) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < media.attributes.length() {
    if media.attributes[i].key == "msid" {
      match media.attributes[i].value {
        Some(v) => out.push(v)
        None => ()
      }
    }
    i = i + 1
  }
  out
}

///| Check whether a property attribute with `key` is present.
fn has_property_attr(attrs : Array[Attribute], key : String) -> Bool {
  let mut i = 0
  while i < attrs.length() {
    if attrs[i].key == key {
      return true
    }
    i = i + 1
  }
  false
}

///| Check whether `a=rtcp-mux` is present on a media section.
pub fn has_rtcp_mux(media : MediaDescription) -> Bool {
  has_property_attr(media.attributes, "rtcp-mux")
}

///| Check whether `a=rtcp-rsize` is present on a media section.
pub fn has_rtcp_rsize(media : MediaDescription) -> Bool {
  has_property_attr(media.attributes, "rtcp-rsize")
}

///| Parse `a=sctp-port:<port>` or legacy `a=sctpmap:<port> ...` with strict validation.
fn sctp_port_at(
  media : MediaDescription,
  attr_base_line : Int,
  ignore_errors : Bool,
) -> Result[Option[Int], SdpError] {
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "sctp-port" {
      let line_no = attr_base_line + i
      match attr.value {
        Some(v) => {
          match parse_int_range_slice(v, 0, v.length(), 0, 65535) {
            Some(p) => return Ok(Some(p))
            None => {
              if !ignore_errors {
                return Err(SdpError::InvalidSyntax(line_no, "sctp-port must be in 0..65535"))
              }
            }
          }
        }
        None => {
          if !ignore_errors {
            return Err(SdpError::InvalidSyntax(line_no, "a=sctp-port requires a value"))
          }
        }
      }
    }
    i = i + 1
  }
  // Fallback to legacy RFC draft `a=sctpmap:<port> <app>[ <max-streams>]`
  i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "sctpmap" {
      let line_no = attr_base_line + i
      match attr.value {
        Some(v) => {
          let sp = find_byte_slice(v, 0, v.length(), 32)
          let port_end = if sp < 0 { v.length() } else { sp }
          match parse_int_range_slice(v, 0, port_end, 0, 65535) {
            Some(p) => return Ok(Some(p))
            None => {
              if !ignore_errors {
                return Err(SdpError::InvalidSyntax(line_no, "sctpmap port must be in 0..65535"))
              }
            }
          }
        }
        None => {
          if !ignore_errors {
            return Err(SdpError::InvalidSyntax(line_no, "a=sctpmap requires a value"))
          }
        }
      }
    }
    i = i + 1
  }
  Ok(None)
}

///| Extract `a=sctp-port:<port>` (or legacy `a=sctpmap:<port> ...`) from a media section.
pub fn sctp_port(media : MediaDescription) -> Option[Int] {
  match sctp_port_at(media, 1, false) {
    Ok(v) => v
    Err(_) => None
  }
}

///| Parse `a=max-message-size:<bytes>` with strict validation.
fn max_message_size_at(
  media : MediaDescription,
  attr_base_line : Int,
  ignore_errors : Bool,
) -> Result[Option[Int64], SdpError] {
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "max-message-size" {
      let line_no = attr_base_line + i
      match attr.value {
        Some(v) => {
          match parse_u63_slice(v, 0, v.length()) {
            Some(n) => return Ok(Some(n))
            None => {
              if !ignore_errors {
                return Err(SdpError::InvalidSyntax(line_no, "invalid max-message-size integer"))
              }
            }
          }
        }
        None => {
          if !ignore_errors {
            return Err(SdpError::InvalidSyntax(line_no, "a=max-message-size requires a value"))
          }
        }
      }
    }
    i = i + 1
  }
  Ok(None)
}

///| Extract `a=max-message-size:<bytes>` from a media section.
pub fn max_message_size(media : MediaDescription) -> Option[Int64] {
  match max_message_size_at(media, 1, false) {
    Ok(v) => v
    Err(_) => None
  }
}

///| Internal `a=rid:` parser with 1-based attribute base line number.
fn rids_at(
  media : MediaDescription,
  attr_base_line : Int,
  ignore_errors : Bool,
) -> Result[Array[Rid], SdpError] {
  let out : Array[Rid] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "rid" {
      let line_no = attr_base_line + i
      let v = match attr.value {
        Some(s) => s
        None => {
          if ignore_errors {
            i = i + 1
            continue
          }
          return Err(SdpError::InvalidSyntax(line_no, "a=rid requires a value"))
        }
      }
      let sp1 = find_byte_slice(v, 0, v.length(), 32)
      if sp1 <= 0 || sp1 + 1 >= v.length() {
        if ignore_errors {
          i = i + 1
          continue
        }
        return Err(SdpError::InvalidSyntax(line_no, "a=rid requires <id> <send|recv>[ <params>]"))
      }
      let id = v.slice(0, sp1)
      let sp2 = find_byte_slice(v, sp1 + 1, v.length(), 32)
      let (dir, params) = if sp2 < 0 {
        (v.slice(sp1 + 1, v.length()), None)
      } else {
        let p_str = v.slice(sp2 + 1, v.length())
        let opt_p = if p_str.length() > 0 { Some(p_str) } else { None }
        (v.slice(sp1 + 1, sp2), opt_p)
      }
      if dir != "send" && dir != "recv" {
        if ignore_errors {
          i = i + 1
          continue
        }
        return Err(SdpError::InvalidSyntax(line_no, "a=rid direction must be 'send' or 'recv'"))
      }
      out.push(Rid::{ id: id, direction: dir, params: params })
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=rid:` attributes on a media section.
pub fn rids(media : MediaDescription) -> Result[Array[Rid], SdpError] {
  rids_at(media, 1, false)
}

///| Parse an RFC 8853 §5.1 `sc-str-list = sc-alt-list *(";" sc-alt-list)` where
///| `sc-alt-list = sc-id *("," sc-id)` and `sc-id = ["~"] rid-id`.
fn parse_simulcast_list(
  raw : String,
  line_no : Int,
) -> Result[(Array[String], Array[Array[SimulcastRid]]), SdpError] {
  let n = raw.length()
  if n == 0 {
    return Err(SdpError::InvalidSyntax(line_no, "empty simulcast RID list"))
  }
  let flat : Array[String] = []
  let streams : Array[Array[SimulcastRid]] = []
  let mut stream_start = 0
  let mut i = 0
  while i <= n {
    if i == n || raw.code_unit_at(i) == 59 {
      if i == stream_start {
        return Err(SdpError::InvalidSyntax(line_no, "empty simulcast stream entry"))
      }
      let alts : Array[SimulcastRid] = []
      let mut alt_start = stream_start
      let mut j = stream_start
      while j <= i {
        if j == i || raw.code_unit_at(j) == 44 {
          if j == alt_start {
            return Err(SdpError::InvalidSyntax(line_no, "empty simulcast alternative entry"))
          }
          let mut id_start = alt_start
          let mut paused = false
          if raw.code_unit_at(id_start) == 126 {
            paused = true
            id_start = id_start + 1
          }
          let rid_id = raw.slice(id_start, j)
          if !is_valid_rid_id(rid_id) {
            return Err(SdpError::InvalidSyntax(line_no, "invalid simulcast rid-id"))
          }
          alts.push(SimulcastRid::{ id: rid_id, paused: paused })
          flat.push(rid_id)
          alt_start = j + 1
        }
        j = j + 1
      }
      streams.push(alts)
      stream_start = i + 1
    }
    i = i + 1
  }
  if streams.length() == 0 {
    return Err(SdpError::InvalidSyntax(line_no, "empty simulcast RID list"))
  }
  Ok((flat, streams))
}

///| Internal `a=simulcast:` parser with 1-based attribute base line number.
fn simulcast_at(
  media : MediaDescription,
  attr_base_line : Int,
  ignore_errors : Bool,
) -> Result[Option[Simulcast], SdpError] {
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "simulcast" {
      let line_no = attr_base_line + i
      let v = match attr.value {
        Some(s) => s
        None => {
          if ignore_errors {
            return Ok(None)
          }
          return Err(SdpError::InvalidSyntax(line_no, "a=simulcast requires a value"))
        }
      }
      let parts = split_ws(v)
      if parts.length() != 2 && parts.length() != 4 {
        if ignore_errors {
          return Ok(None)
        }
        return Err(SdpError::InvalidSyntax(line_no, "malformed a=simulcast attribute"))
      }
      let mut seen_send = false
      let mut seen_recv = false
      let mut send_rids : Array[String] = []
      let mut recv_rids : Array[String] = []
      let mut send_streams : Array[Array[SimulcastRid]] = []
      let mut recv_streams : Array[Array[SimulcastRid]] = []
      let mut j = 0
      while j < parts.length() {
        let dir = parts[j]
        let list_raw = parts[j + 1]
        if dir == "send" {
          if seen_send {
            if ignore_errors {
              return Ok(None)
            }
            return Err(SdpError::InvalidSyntax(line_no, "duplicate simulcast 'send' direction"))
          }
          seen_send = true
          match parse_simulcast_list(list_raw, line_no) {
            Ok((flat, streams)) => {
              send_rids = flat
              send_streams = streams
            }
            Err(e) => {
              if ignore_errors {
                return Ok(None)
              }
              return Err(e)
            }
          }
        } else if dir == "recv" {
          if seen_recv {
            if ignore_errors {
              return Ok(None)
            }
            return Err(SdpError::InvalidSyntax(line_no, "duplicate simulcast 'recv' direction"))
          }
          seen_recv = true
          match parse_simulcast_list(list_raw, line_no) {
            Ok((flat, streams)) => {
              recv_rids = flat
              recv_streams = streams
            }
            Err(e) => {
              if ignore_errors {
                return Ok(None)
              }
              return Err(e)
            }
          }
        } else {
          if ignore_errors {
            return Ok(None)
          }
          return Err(
            SdpError::InvalidSyntax(line_no, "a=simulcast direction must be 'send' or 'recv'"),
          )
        }
        j = j + 2
      }
      return Ok(
        Some(
          Simulcast::{
            send_rids: send_rids,
            recv_rids: recv_rids,
            send_streams: send_streams,
            recv_streams: recv_streams,
          },
        ),
      )
    }
    i = i + 1
  }
  Ok(None)
}

///| Parse `a=simulcast:` attribute on a media section per RFC 8853 §5.1.
pub fn simulcast(media : MediaDescription) -> Result[Option[Simulcast], SdpError] {
  simulcast_at(media, 1, false)
}

///| Compute the 1-based line number of the first session `a=` attribute.
fn session_attr_base_line(desc : SessionDescription) -> Int {
  let mut line = 4 // v= (1), o= (2), s= (3) -> next is 4
  match desc.session_info {
    Some(_) => line = line + 1
    None => ()
  }
  match desc.uri {
    Some(_) => line = line + 1
    None => ()
  }
  line = line + session_emails(desc).length() + session_phones(desc).length()
  match desc.connection {
    Some(_) => line = line + 1
    None => ()
  }
  line = line + desc.bandwidths.length()
  let mut ti = 0
  while ti < desc.timings.length() {
    line = line + 1 + desc.timings[ti].repeats.length()
    ti = ti + 1
  }
  match session_time_zones(desc) {
    Some(_) => line = line + 1
    None => ()
  }
  match session_encryption_key(desc) {
    Some(_) => line = line + 1
    None => ()
  }
  line
}

///| Extract a high-level WebRTC / JSEP negotiation summary from a `SessionDescription`.
///|
///| Resolves session-level ICE credentials, `ice-options`, DTLS fingerprint, and direction ONCE
///| outside the media loop (eliminating O(media * tokens) amplification), enforces strict
///| `ice-options` and RFC 8122 `fingerprint` bounds, reports 1-based line numbers on errors,
///| and tolerates malformed attributes on rejected (`port == 0`) media sections.
pub fn extract_webrtc_summary(desc : SessionDescription) -> Result[WebRtcSummary, SdpError] {
  let sess_attr_base = session_attr_base_line(desc)
  let sess_options = match extract_ice_options_checked(desc.attributes, sess_attr_base) {
    Ok(opts) => opts
    Err(e) => return Err(e)
  }
  let sess_ufrag = validated_ufrag(find_attr_value(desc.attributes, "ice-ufrag"))
  let sess_pwd = validated_pwd(find_attr_value(desc.attributes, "ice-pwd"))
  let (_, sess_fps) = collect_fingerprints(desc.attributes)
  let sess_fp = best_fingerprint(sess_fps)
  let sess_dir = match find_direction(desc.attributes) {
    Some(d) => d
    None => Direction::SendRecv
  }

  let bundles = bundle_groups(desc)
  let bundle_mids : Array[String] = []
  let mut bi = 0
  while bi < bundles.length() {
    let mut mj = 0
    while mj < bundles[bi].mids.length() {
      bundle_mids.push(bundles[bi].mids[mj])
      mj = mj + 1
    }
    bi = bi + 1
  }
  let ice_lite = has_property_attr(desc.attributes, "ice-lite")
  let summaries : Array[MediaSummary] = []

  let mut cur_line = sess_attr_base + desc.attributes.length()
  let mut i = 0
  while i < desc.media.length() {
    let m = desc.media[i]
    let mut attr_base = cur_line + 1 // m= line
    match m.title {
      Some(_) => attr_base = attr_base + 1
      None => ()
    }
    match m.connection {
      Some(_) => attr_base = attr_base + 1
      None => ()
    }
    attr_base = attr_base + m.bandwidths.length()
    let rejected = m.port == 0

    // Per-media ICE credentials using pre-resolved session fallback (no O(M*T) re-splitting)
    let (has_mu, mu_val) = find_attr_entry(m.attributes, "ice-ufrag")
    let m_ufrag = if has_mu { validated_ufrag(mu_val) } else { sess_ufrag }
    let (has_mp, mp_val) = find_attr_entry(m.attributes, "ice-pwd")
    let m_pwd = if has_mp { validated_pwd(mp_val) } else { sess_pwd }
    let m_opts = match extract_ice_options_checked(m.attributes, attr_base) {
      Ok(opts) => if opts.length() > 0 { opts } else { sess_options }
      Err(e) => {
        if rejected {
          sess_options
        } else {
          return Err(e)
        }
      }
    }
    let m_ice = IceCredentials::{ ufrag: m_ufrag, pwd: m_pwd, options: m_opts }

    // Per-media DTLS fingerprint using pre-resolved session fallback (no fallback if media declares one)
    let (has_mfp, m_fps) = collect_fingerprints(m.attributes)
    let m_fp = if has_mfp { best_fingerprint(m_fps) } else { sess_fp }

    let m_dir = match find_direction(m.attributes) {
      Some(d) => d
      None => sess_dir
    }

    let m_rtpmaps = match rtpmaps_at(m, attr_base, rejected) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_fmtps = match fmtps_at(m, attr_base, rejected) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_rtcp_fbs = match rtcp_fbs_at(m, attr_base, rejected) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_extmaps = match extmaps_at(m, attr_base, rejected) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_cands = match ice_candidates_at(m, attr_base, rejected) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_ssrcs = match ssrcs_at(m, attr_base, rejected) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_ssrc_groups = match ssrc_groups_at(m, attr_base, rejected) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_rids = match rids_at(m, attr_base, rejected) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_sim = match simulcast_at(m, attr_base, rejected) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_sctp_port = match sctp_port_at(m, attr_base, rejected) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_max_msg = match max_message_size_at(m, attr_base, rejected) {
      Ok(v) => v
      Err(e) => return Err(e)
    }

    summaries.push(
      MediaSummary::{
        index: i,
        media_type: m.media_type,
        mid: media_mid(m),
        protocol: m.protocol,
        port: m.port,
        direction: m_dir,
        ice: m_ice,
        fingerprint: m_fp,
        setup: dtls_setup(m),
        rtcp_mux: has_rtcp_mux(m),
        rtcp_rsize: has_rtcp_rsize(m),
        rtpmaps: m_rtpmaps,
        fmtps: m_fmtps,
        rtcp_fbs: m_rtcp_fbs,
        extmaps: m_extmaps,
        candidates: m_cands,
        ssrcs: m_ssrcs,
        ssrc_groups: m_ssrc_groups,
        rids: m_rids,
        simulcast: m_sim,
        msids: media_msids(m),
        sctp_port: m_sctp_port,
        max_message_size: m_max_msg,
      },
    )
    cur_line = attr_base + m.attributes.length()
    i = i + 1
  }
  Ok(WebRtcSummary::{ bundle_mids: bundle_mids, ice_lite: ice_lite, media: summaries })
}
