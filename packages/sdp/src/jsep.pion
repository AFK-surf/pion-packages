///| RFC 8829 (JSEP), RFC 8839 (ICE), RFC 8843 (BUNDLE), and RFC 8851/8853 (Simulcast)
///| structured attribute parsers and WebRTC summary extractor.

///| Split `s` by ASCII spaces (`0x20`), ignoring consecutive/leading/trailing spaces.
fn split_ws(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    while i < n && s.code_unit_at(i) == 32 {
      i = i + 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && s.code_unit_at(i) != 32 {
      i = i + 1
    }
    out.push(s.slice(start, i))
  }
  out
}

///| Split `s` by a single delimiter byte `delim`, keeping non-empty parts.
fn split_by_byte(s : String, delim : Int) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == delim {
      if i > start {
        out.push(s.slice(start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(s.slice(start, n))
  }
  out
}

///| Parse a `Direction` token.
fn parse_direction_token(tok : String) -> Option[Direction] {
  if tok == "sendrecv" {
    Some(Direction::SendRecv)
  } else if tok == "sendonly" {
    Some(Direction::SendOnly)
  } else if tok == "recvonly" {
    Some(Direction::RecvOnly)
  } else if tok == "inactive" {
    Some(Direction::Inactive)
  } else {
    None
  }
}

///| Parse an ICE candidate attribute value (with or without leading `candidate:`).
pub fn parse_ice_candidate(value : String) -> Result[IceCandidate, SdpError] {
  let body = if value.length() >= 10 && value.slice(0, 10) == "candidate:" {
    value.slice(10, value.length())
  } else {
    value
  }
  let parts = split_ws(body)
  if parts.length() < 8 {
    return Err(SdpError::InvalidSyntax(0, "ICE candidate requires at least 8 tokens"))
  }
  let foundation = parts[0]
  let component = match parse_int_range_slice(parts[1], 0, parts[1].length(), 1, 256) {
    Some(v) => v
    None => return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate component"))
  }
  let transport = parts[2]
  let priority = match parse_u63_slice(parts[3], 0, parts[3].length()) {
    Some(v) => {
      if v > 4294967295L {
        return Err(SdpError::InvalidSyntax(0, "ICE candidate priority exceeds uint32"))
      }
      v
    }
    None => return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate priority"))
  }
  let address = parts[4]
  let port = match parse_int_range_slice(parts[5], 0, parts[5].length(), 0, 65535) {
    Some(v) => v
    None => return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate port"))
  }
  if parts[6] != "typ" {
    return Err(SdpError::InvalidSyntax(0, "ICE candidate missing 'typ' keyword"))
  }
  let typ = parts[7]

  let mut raddr : Option[String] = None
  let mut rport : Option[Int] = None
  let mut tcptype : Option[String] = None
  let mut generation : Option[Int] = None
  let mut ufrag : Option[String] = None
  let extensions : Array[IceExtension] = []

  if (parts.length() - 8) % 2 != 0 {
    return Err(SdpError::InvalidSyntax(0, "ICE candidate trailing extension key without value"))
  }
  let mut i = 8
  while i < parts.length() {
    let k = parts[i]
    let v = parts[i + 1]
    if k == "raddr" {
      raddr = Some(v)
    } else if k == "rport" {
      match parse_int_range_slice(v, 0, v.length(), 0, 65535) {
        Some(p) => rport = Some(p)
        None => return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate rport"))
      }
    } else if k == "tcptype" {
      tcptype = Some(v)
    } else if k == "generation" {
      match parse_int_range_slice(v, 0, v.length(), 0, 2147483647) {
        Some(g) => generation = Some(g)
        None => return Err(SdpError::InvalidSyntax(0, "invalid ICE candidate generation"))
      }
    } else if k == "ufrag" {
      ufrag = Some(v)
    } else {
      extensions.push(IceExtension::{ key: k, value: v })
    }
    i = i + 2
  }

  Ok(
    IceCandidate::{
      foundation: foundation,
      component: component,
      transport: transport,
      priority: priority,
      address: address,
      port: port,
      typ: typ,
      raddr: raddr,
      rport: rport,
      tcptype: tcptype,
      generation: generation,
      ufrag: ufrag,
      extensions: extensions,
    },
  )
}

///| Format an `IceCandidate` into its canonical SDP attribute value (without `a=candidate:`).
pub fn format_ice_candidate(cand : IceCandidate) -> String {
  let sb = StringBuilder::new()
  sb.write_string(cand.foundation)
  sb.write_byte((32).to_byte())
  sb.write_string(cand.component.to_string())
  sb.write_byte((32).to_byte())
  sb.write_string(cand.transport)
  sb.write_byte((32).to_byte())
  sb.write_string(cand.priority.to_string())
  sb.write_byte((32).to_byte())
  sb.write_string(cand.address)
  sb.write_byte((32).to_byte())
  sb.write_string(cand.port.to_string())
  sb.write_string(" typ ")
  sb.write_string(cand.typ)
  match cand.raddr {
    Some(ra) => {
      sb.write_string(" raddr ")
      sb.write_string(ra)
    }
    None => ()
  }
  match cand.rport {
    Some(rp) => {
      sb.write_string(" rport ")
      sb.write_string(rp.to_string())
    }
    None => ()
  }
  match cand.tcptype {
    Some(tt) => {
      sb.write_string(" tcptype ")
      sb.write_string(tt)
    }
    None => ()
  }
  match cand.generation {
    Some(gen) => {
      sb.write_string(" generation ")
      sb.write_string(gen.to_string())
    }
    None => ()
  }
  match cand.ufrag {
    Some(uf) => {
      sb.write_string(" ufrag ")
      sb.write_string(uf)
    }
    None => ()
  }
  let mut i = 0
  while i < cand.extensions.length() {
    let ext = cand.extensions[i]
    sb.write_byte((32).to_byte())
    sb.write_string(ext.key)
    sb.write_byte((32).to_byte())
    sb.write_string(ext.value)
    i = i + 1
  }
  sb.to_string()
}

///| Parse all `a=candidate:` attributes on a media section.
pub fn ice_candidates(media : MediaDescription) -> Result[Array[IceCandidate], SdpError] {
  let out : Array[IceCandidate] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "candidate" {
      match attr.value {
        Some(v) => {
          match parse_ice_candidate(v) {
            Ok(c) => out.push(c)
            Err(e) => return Err(e)
          }
        }
        None => return Err(SdpError::InvalidSyntax(0, "a=candidate requires a value"))
      }
    }
    i = i + 1
  }
  Ok(out)
}

///| Find the first value attribute matching `key` in `attrs`.
fn find_attr_value(attrs : Array[Attribute], key : String) -> Option[String] {
  let mut i = 0
  while i < attrs.length() {
    if attrs[i].key == key {
      match attrs[i].value {
        Some(v) => return Some(v)
        None => ()
      }
    }
    i = i + 1
  }
  None
}

///| Extract `ice-options` tokens from an attribute list.
fn extract_ice_options(attrs : Array[Attribute]) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < attrs.length() {
    if attrs[i].key == "ice-options" {
      match attrs[i].value {
        Some(v) => {
          let toks = split_ws(v)
          let mut j = 0
          while j < toks.length() {
            out.push(toks[j])
            j = j + 1
          }
        }
        None => ()
      }
    }
    i = i + 1
  }
  out
}

///| Extract ICE credentials for `media_idx` (media-level preferred, session-level fallback).
pub fn ice_credentials(session : SessionDescription, media_idx : Int) -> IceCredentials {
  let mut ufrag = find_attr_value(session.attributes, "ice-ufrag")
  let mut pwd = find_attr_value(session.attributes, "ice-pwd")
  let mut options = extract_ice_options(session.attributes)

  if media_idx >= 0 && media_idx < session.media.length() {
    let mattrs = session.media[media_idx].attributes
    match find_attr_value(mattrs, "ice-ufrag") {
      Some(u) => ufrag = Some(u)
      None => ()
    }
    match find_attr_value(mattrs, "ice-pwd") {
      Some(p) => pwd = Some(p)
      None => ()
    }
    let mopts = extract_ice_options(mattrs)
    if mopts.length() > 0 {
      options = mopts
    }
  }
  IceCredentials::{ ufrag: ufrag, pwd: pwd, options: options }
}

///| Extract DTLS fingerprint from an attribute list.
fn find_fingerprint(attrs : Array[Attribute]) -> Option[DtlsFingerprint] {
  match find_attr_value(attrs, "fingerprint") {
    Some(v) => {
      let sp = find_byte_slice(v, 0, v.length(), 32)
      if sp <= 0 || sp + 1 >= v.length() {
        None
      } else {
        Some(DtlsFingerprint::{ algorithm: v.slice(0, sp), value: v.slice(sp + 1, v.length()) })
      }
    }
    None => None
  }
}

///| Extract DTLS fingerprint for `media_idx` (media-level preferred, session-level fallback).
pub fn fingerprint(session : SessionDescription, media_idx : Int) -> Option[DtlsFingerprint] {
  if media_idx >= 0 && media_idx < session.media.length() {
    match find_fingerprint(session.media[media_idx].attributes) {
      Some(fp) => return Some(fp)
      None => ()
    }
  }
  find_fingerprint(session.attributes)
}

///| Extract DTLS setup role (`a=setup:...`) on a media section.
pub fn dtls_setup(media : MediaDescription) -> Option[DtlsSetup] {
  match find_attr_value(media.attributes, "setup") {
    Some(v) => {
      if v == "active" {
        Some(DtlsSetup::Active)
      } else if v == "passive" {
        Some(DtlsSetup::Passive)
      } else if v == "actpass" {
        Some(DtlsSetup::Actpass)
      } else if v == "holdconn" {
        Some(DtlsSetup::Holdconn)
      } else {
        None
      }
    }
    None => None
  }
}

///| Parse all `a=rtpmap:` attributes on a media section.
pub fn rtpmaps(media : MediaDescription) -> Result[Array[RtpMap], SdpError] {
  let out : Array[RtpMap] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "rtpmap" {
      let v = match attr.value {
        Some(s) => s
        None => return Err(SdpError::InvalidSyntax(0, "a=rtpmap requires a value"))
      }
      let sp = find_byte_slice(v, 0, v.length(), 32)
      if sp <= 0 || sp + 1 >= v.length() {
        return Err(SdpError::InvalidSyntax(0, "a=rtpmap requires <pt> <enc>/<clock>[/<ch>]"))
      }
      let pt = match parse_int_range_slice(v, 0, sp, 0, 127) {
        Some(p) => p
        None => return Err(SdpError::InvalidSyntax(0, "rtpmap payload type must be 0..127"))
      }
      let rest = v.slice(sp + 1, v.length())
      let slash1 = find_byte_slice(rest, 0, rest.length(), 47)
      if slash1 <= 0 || slash1 + 1 >= rest.length() {
        return Err(SdpError::InvalidSyntax(0, "rtpmap missing encoding/clock_rate"))
      }
      let enc = rest.slice(0, slash1)
      let slash2 = find_byte_slice(rest, slash1 + 1, rest.length(), 47)
      let (clock, channels) = if slash2 < 0 {
        let clk = match parse_int_range_slice(rest, slash1 + 1, rest.length(), 1, 2147483647) {
          Some(c) => c
          None => return Err(SdpError::InvalidSyntax(0, "rtpmap invalid clock_rate"))
        }
        (clk, None)
      } else {
        let clk = match parse_int_range_slice(rest, slash1 + 1, slash2, 1, 2147483647) {
          Some(c) => c
          None => return Err(SdpError::InvalidSyntax(0, "rtpmap invalid clock_rate"))
        }
        let ch = match parse_int_range_slice(rest, slash2 + 1, rest.length(), 1, 65535) {
          Some(c) => c
          None => return Err(SdpError::InvalidSyntax(0, "rtpmap invalid channels"))
        }
        (clk, Some(ch))
      }
      out.push(
        RtpMap::{ payload_type: pt, encoding_name: enc, clock_rate: clock, channels: channels },
      )
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=fmtp:` attributes on a media section.
pub fn fmtps(media : MediaDescription) -> Result[Array[Fmtp], SdpError] {
  let out : Array[Fmtp] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "fmtp" {
      let v = match attr.value {
        Some(s) => s
        None => return Err(SdpError::InvalidSyntax(0, "a=fmtp requires a value"))
      }
      let sp = find_byte_slice(v, 0, v.length(), 32)
      if sp <= 0 || sp + 1 >= v.length() {
        return Err(SdpError::InvalidSyntax(0, "a=fmtp requires <pt> <parameters>"))
      }
      let pt = match parse_int_range_slice(v, 0, sp, 0, 127) {
        Some(p) => p
        None => return Err(SdpError::InvalidSyntax(0, "fmtp payload type must be 0..127"))
      }
      out.push(Fmtp::{ payload_type: pt, parameters: v.slice(sp + 1, v.length()) })
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=rtcp-fb:` attributes on a media section.
pub fn rtcp_fbs(media : MediaDescription) -> Result[Array[RtcpFb], SdpError] {
  let out : Array[RtcpFb] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "rtcp-fb" {
      let v = match attr.value {
        Some(s) => s
        None => return Err(SdpError::InvalidSyntax(0, "a=rtcp-fb requires a value"))
      }
      let sp1 = find_byte_slice(v, 0, v.length(), 32)
      if sp1 <= 0 || sp1 + 1 >= v.length() {
        return Err(SdpError::InvalidSyntax(0, "a=rtcp-fb requires <pt|*> <type>[ <param>]"))
      }
      let pt : Option[Int] = if sp1 == 1 && v.code_unit_at(0) == 42 {
        None
      } else {
        match parse_int_range_slice(v, 0, sp1, 0, 127) {
          Some(p) => Some(p)
          None => return Err(SdpError::InvalidSyntax(0, "rtcp-fb payload type must be '*' or 0..127"))
        }
      }
      let sp2 = find_byte_slice(v, sp1 + 1, v.length(), 32)
      let (fb_type, param) = if sp2 < 0 {
        (v.slice(sp1 + 1, v.length()), None)
      } else {
        let p_str = v.slice(sp2 + 1, v.length())
        let opt_p = if p_str.length() > 0 { Some(p_str) } else { None }
        (v.slice(sp1 + 1, sp2), opt_p)
      }
      if fb_type.length() == 0 {
        return Err(SdpError::InvalidSyntax(0, "rtcp-fb feedback type must not be empty"))
      }
      out.push(RtcpFb::{ payload_type: pt, feedback_type: fb_type, parameter: param })
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=extmap:` attributes on a media section.
pub fn extmaps(media : MediaDescription) -> Result[Array[ExtMap], SdpError] {
  let out : Array[ExtMap] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "extmap" {
      let v = match attr.value {
        Some(s) => s
        None => return Err(SdpError::InvalidSyntax(0, "a=extmap requires a value"))
      }
      let sp1 = find_byte_slice(v, 0, v.length(), 32)
      if sp1 <= 0 || sp1 + 1 >= v.length() {
        return Err(SdpError::InvalidSyntax(0, "a=extmap requires <id>[/<dir>] <uri>[ <params>]"))
      }
      let id_part = v.slice(0, sp1)
      let slash = find_byte_slice(id_part, 0, id_part.length(), 47)
      let (id, direction) = if slash < 0 {
        let parsed_id = match parse_int_range_slice(id_part, 0, id_part.length(), 1, 4095) {
          Some(n) => n
          None => return Err(SdpError::InvalidSyntax(0, "extmap id must be in 1..4095"))
        }
        (parsed_id, None)
      } else {
        let parsed_id = match parse_int_range_slice(id_part, 0, slash, 1, 4095) {
          Some(n) => n
          None => return Err(SdpError::InvalidSyntax(0, "extmap id must be in 1..4095"))
        }
        let dir_tok = id_part.slice(slash + 1, id_part.length())
        match parse_direction_token(dir_tok) {
          Some(d) => (parsed_id, Some(d))
          None => return Err(SdpError::InvalidSyntax(0, "extmap invalid direction"))
        }
      }
      let sp2 = find_byte_slice(v, sp1 + 1, v.length(), 32)
      let (uri, params) = if sp2 < 0 {
        (v.slice(sp1 + 1, v.length()), None)
      } else {
        let p_str = v.slice(sp2 + 1, v.length())
        let opt_p = if p_str.length() > 0 { Some(p_str) } else { None }
        (v.slice(sp1 + 1, sp2), opt_p)
      }
      if uri.length() == 0 {
        return Err(SdpError::InvalidSyntax(0, "extmap URI must not be empty"))
      }
      out.push(ExtMap::{ id: id, direction: direction, uri: uri, params: params })
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=ssrc:` attributes on a media section.
pub fn ssrcs(media : MediaDescription) -> Result[Array[SsrcAttr], SdpError] {
  let out : Array[SsrcAttr] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "ssrc" {
      let v = match attr.value {
        Some(s) => s
        None => return Err(SdpError::InvalidSyntax(0, "a=ssrc requires a value"))
      }
      let sp = find_byte_slice(v, 0, v.length(), 32)
      if sp <= 0 || sp + 1 >= v.length() {
        return Err(SdpError::InvalidSyntax(0, "a=ssrc requires <ssrc> <attr>[:<value>]"))
      }
      let ssrc_id = match parse_u63_slice(v, 0, sp) {
        Some(n) => {
          if n > 4294967295L {
            return Err(SdpError::InvalidSyntax(0, "ssrc exceeds uint32"))
          }
          n
        }
        None => return Err(SdpError::InvalidSyntax(0, "invalid ssrc integer"))
      }
      let colon = find_byte_slice(v, sp + 1, v.length(), 58)
      if colon < 0 {
        out.push(SsrcAttr::{ ssrc: ssrc_id, attribute: v.slice(sp + 1, v.length()), value: None })
      } else {
        if colon == sp + 1 {
          return Err(SdpError::InvalidSyntax(0, "ssrc attribute name must not be empty"))
        }
        out.push(
          SsrcAttr::{
            ssrc: ssrc_id,
            attribute: v.slice(sp + 1, colon),
            value: Some(v.slice(colon + 1, v.length())),
          },
        )
      }
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse all `a=ssrc-group:` attributes on a media section.
pub fn ssrc_groups(media : MediaDescription) -> Result[Array[SsrcGroup], SdpError] {
  let out : Array[SsrcGroup] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "ssrc-group" {
      let v = match attr.value {
        Some(s) => s
        None => return Err(SdpError::InvalidSyntax(0, "a=ssrc-group requires a value"))
      }
      let parts = split_ws(v)
      if parts.length() < 2 {
        return Err(SdpError::InvalidSyntax(0, "a=ssrc-group requires <semantics> <ssrc>..."))
      }
      let sem = parts[0]
      let ids : Array[Int64] = []
      let mut j = 1
      while j < parts.length() {
        match parse_u63_slice(parts[j], 0, parts[j].length()) {
          Some(n) => {
            if n > 4294967295L {
              return Err(SdpError::InvalidSyntax(0, "ssrc-group id exceeds uint32"))
            }
            ids.push(n)
          }
          None => return Err(SdpError::InvalidSyntax(0, "invalid ssrc-group id"))
        }
        j = j + 1
      }
      out.push(SsrcGroup::{ semantics: sem, ssrcs: ids })
    }
    i = i + 1
  }
  Ok(out)
}

///| Find a direction attribute in `attrs`.
fn find_direction(attrs : Array[Attribute]) -> Option[Direction] {
  let mut i = 0
  while i < attrs.length() {
    match attrs[i].value {
      None => {
        match parse_direction_token(attrs[i].key) {
          Some(d) => return Some(d)
          None => ()
        }
      }
      Some(_) => ()
    }
    i = i + 1
  }
  None
}

///| Determine effective media direction (media-level preferred, session-level fallback, default `SendRecv`).
pub fn media_direction(session : SessionDescription, media_idx : Int) -> Direction {
  if media_idx >= 0 && media_idx < session.media.length() {
    match find_direction(session.media[media_idx].attributes) {
      Some(d) => return d
      None => ()
    }
  }
  match find_direction(session.attributes) {
    Some(d) => d
    None => Direction::SendRecv
  }
}

///| Extract all `a=group:BUNDLE ...` groups from the session description.
pub fn bundle_groups(session : SessionDescription) -> Array[BundleGroup] {
  let out : Array[BundleGroup] = []
  let mut i = 0
  while i < session.attributes.length() {
    let attr = session.attributes[i]
    if attr.key == "group" {
      match attr.value {
        Some(v) => {
          let parts = split_ws(v)
          if parts.length() >= 1 && parts[0] == "BUNDLE" {
            let mids : Array[String] = []
            let mut j = 1
            while j < parts.length() {
              mids.push(parts[j])
              j = j + 1
            }
            out.push(BundleGroup::{ mids: mids })
          }
        }
        None => ()
      }
    }
    i = i + 1
  }
  out
}

///| Extract `a=mid:<value>` from a media section.
pub fn media_mid(media : MediaDescription) -> Option[String] {
  find_attr_value(media.attributes, "mid")
}

///| Extract all `a=msid:<value>` entries from a media section.
pub fn media_msids(media : MediaDescription) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < media.attributes.length() {
    if media.attributes[i].key == "msid" {
      match media.attributes[i].value {
        Some(v) => out.push(v)
        None => ()
      }
    }
    i = i + 1
  }
  out
}

///| Check whether a property attribute with `key` is present.
fn has_property_attr(attrs : Array[Attribute], key : String) -> Bool {
  let mut i = 0
  while i < attrs.length() {
    if attrs[i].key == key {
      return true
    }
    i = i + 1
  }
  false
}

///| Check whether `a=rtcp-mux` is present on a media section.
pub fn has_rtcp_mux(media : MediaDescription) -> Bool {
  has_property_attr(media.attributes, "rtcp-mux")
}

///| Check whether `a=rtcp-rsize` is present on a media section.
pub fn has_rtcp_rsize(media : MediaDescription) -> Bool {
  has_property_attr(media.attributes, "rtcp-rsize")
}

///| Extract `a=sctp-port:<port>` from a media section.
pub fn sctp_port(media : MediaDescription) -> Option[Int] {
  match find_attr_value(media.attributes, "sctp-port") {
    Some(v) => parse_int_range_slice(v, 0, v.length(), 0, 65535)
    None => None
  }
}

///| Extract `a=max-message-size:<bytes>` from a media section.
pub fn max_message_size(media : MediaDescription) -> Option[Int64] {
  match find_attr_value(media.attributes, "max-message-size") {
    Some(v) => parse_u63_slice(v, 0, v.length())
    None => None
  }
}

///| Parse all `a=rid:` attributes on a media section.
pub fn rids(media : MediaDescription) -> Result[Array[Rid], SdpError] {
  let out : Array[Rid] = []
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "rid" {
      let v = match attr.value {
        Some(s) => s
        None => return Err(SdpError::InvalidSyntax(0, "a=rid requires a value"))
      }
      let sp1 = find_byte_slice(v, 0, v.length(), 32)
      if sp1 <= 0 || sp1 + 1 >= v.length() {
        return Err(SdpError::InvalidSyntax(0, "a=rid requires <id> <send|recv>[ <params>]"))
      }
      let id = v.slice(0, sp1)
      let sp2 = find_byte_slice(v, sp1 + 1, v.length(), 32)
      let (dir, params) = if sp2 < 0 {
        (v.slice(sp1 + 1, v.length()), None)
      } else {
        let p_str = v.slice(sp2 + 1, v.length())
        let opt_p = if p_str.length() > 0 { Some(p_str) } else { None }
        (v.slice(sp1 + 1, sp2), opt_p)
      }
      if dir != "send" && dir != "recv" {
        return Err(SdpError::InvalidSyntax(0, "a=rid direction must be 'send' or 'recv'"))
      }
      out.push(Rid::{ id: id, direction: dir, params: params })
    }
    i = i + 1
  }
  Ok(out)
}

///| Parse `a=simulcast:` attribute on a media section.
pub fn simulcast(media : MediaDescription) -> Result[Option[Simulcast], SdpError] {
  let mut i = 0
  while i < media.attributes.length() {
    let attr = media.attributes[i]
    if attr.key == "simulcast" {
      let v = match attr.value {
        Some(s) => s
        None => return Err(SdpError::InvalidSyntax(0, "a=simulcast requires a value"))
      }
      let parts = split_ws(v)
      if parts.length() < 2 || parts.length() % 2 != 0 {
        return Err(SdpError::InvalidSyntax(0, "malformed a=simulcast attribute"))
      }
      let send_rids : Array[String] = []
      let recv_rids : Array[String] = []
      let mut j = 0
      while j < parts.length() {
        let dir = parts[j]
        let list_toks = split_by_byte(parts[j + 1], 59)
        if dir == "send" {
          let mut k = 0
          while k < list_toks.length() {
            send_rids.push(list_toks[k])
            k = k + 1
          }
        } else if dir == "recv" {
          let mut k = 0
          while k < list_toks.length() {
            recv_rids.push(list_toks[k])
            k = k + 1
          }
        } else {
          return Err(SdpError::InvalidSyntax(0, "a=simulcast direction must be 'send' or 'recv'"))
        }
        j = j + 2
      }
      return Ok(Some(Simulcast::{ send_rids: send_rids, recv_rids: recv_rids }))
    }
    i = i + 1
  }
  Ok(None)
}

///| Extract a high-level WebRTC / JSEP negotiation summary from a `SessionDescription`.
pub fn extract_webrtc_summary(desc : SessionDescription) -> Result[WebRtcSummary, SdpError] {
  let bundles = bundle_groups(desc)
  let bundle_mids : Array[String] = []
  let mut bi = 0
  while bi < bundles.length() {
    let mut mj = 0
    while mj < bundles[bi].mids.length() {
      bundle_mids.push(bundles[bi].mids[mj])
      mj = mj + 1
    }
    bi = bi + 1
  }
  let ice_lite = has_property_attr(desc.attributes, "ice-lite")
  let summaries : Array[MediaSummary] = []
  let mut i = 0
  while i < desc.media.length() {
    let m = desc.media[i]
    let m_rtpmaps = match rtpmaps(m) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_fmtps = match fmtps(m) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_rtcp_fbs = match rtcp_fbs(m) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_extmaps = match extmaps(m) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_cands = match ice_candidates(m) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_ssrcs = match ssrcs(m) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_ssrc_groups = match ssrc_groups(m) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_rids = match rids(m) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let m_sim = match simulcast(m) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    summaries.push(
      MediaSummary::{
        index: i,
        media_type: m.media_type,
        mid: media_mid(m),
        protocol: m.protocol,
        port: m.port,
        direction: media_direction(desc, i),
        ice: ice_credentials(desc, i),
        fingerprint: fingerprint(desc, i),
        setup: dtls_setup(m),
        rtcp_mux: has_rtcp_mux(m),
        rtcp_rsize: has_rtcp_rsize(m),
        rtpmaps: m_rtpmaps,
        fmtps: m_fmtps,
        rtcp_fbs: m_rtcp_fbs,
        extmaps: m_extmaps,
        candidates: m_cands,
        ssrcs: m_ssrcs,
        ssrc_groups: m_ssrc_groups,
        rids: m_rids,
        simulcast: m_sim,
        msids: media_msids(m),
        sctp_port: sctp_port(m),
        max_message_size: max_message_size(m),
      },
    )
    i = i + 1
  }
  Ok(WebRtcSummary::{ bundle_mids: bundle_mids, ice_lite: ice_lite, media: summaries })
}
