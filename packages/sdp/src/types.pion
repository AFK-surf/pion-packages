///| Core RFC 8866 SDP and RFC 8829 (JSEP) WebRTC types, parse limits, and errors.

///| Resource limits enforced during SDP parsing to prevent allocation bombs.
///|
///| Semantics:
///| - Any negative limit field is immediately rejected with `SdpError::LimitExceeded`.
///| - A value of `0` strictly means 0 items/bytes/lines are allowed (not unlimited).
pub val struct ParseLimits {
  pub max_bytes : Int
  pub max_lines : Int
  pub max_media_sections : Int
  pub max_attributes_per_section : Int
}

///| Default parse limits suitable for large WebRTC / Google Meet SDPs.
pub fn ParseLimits::default() -> ParseLimits {
  ParseLimits::{
    max_bytes: 1048576,
    max_lines: 16384,
    max_media_sections: 256,
    max_attributes_per_section: 4096,
  }
}

///| Construct custom parse limits.
pub fn ParseLimits::new(
  max_bytes : Int,
  max_lines : Int,
  max_media_sections : Int,
  max_attributes_per_section : Int,
) -> ParseLimits {
  ParseLimits::{
    max_bytes: max_bytes,
    max_lines: max_lines,
    max_media_sections: max_media_sections,
    max_attributes_per_section: max_attributes_per_section,
  }
}

///| Explicit SDP parsing and JSEP attribute extraction errors.
pub enum SdpError {
  EmptyInput
  LimitExceeded(String)
  InvalidLine(Int, String)
  InvalidSyntax(Int, String)
  MissingRequiredField(String)
}

///| Human-readable message for an `SdpError`.
pub fn sdp_error_message(err : SdpError) -> String {
  match err {
    SdpError::EmptyInput => "empty SDP input"
    SdpError::LimitExceeded(msg) => "limit exceeded: " + msg
    SdpError::InvalidLine(line, msg) => "line " + line.to_string() + ": invalid line: " + msg
    SdpError::InvalidSyntax(line, msg) => "line " + line.to_string() + ": invalid syntax: " + msg
    SdpError::MissingRequiredField(field) => "missing required field: " + field
  }
}

///| RFC 8866 §5.2 Origin (`o=`).
pub val struct Origin {
  pub username : String
  pub session_id : String
  pub session_version : String
  pub net_type : String
  pub addr_type : String
  pub unicast_address : String
}

///| RFC 8866 §5.7 Connection Information (`c=`).
pub val struct Connection {
  pub net_type : String
  pub addr_type : String
  pub address : String
}

///| RFC 8866 §5.8 Bandwidth Information (`b=`).
pub val struct Bandwidth {
  pub bwtype : String
  pub bandwidth : Int64
}

///| RFC 8866 §5.9 Timing (`t=`).
pub val struct Timing {
  pub start_time : Int64
  pub stop_time : Int64
}

///| RFC 8866 §5.13 Attribute (`a=<key>` or `a=<key>:<value>`).
pub val struct Attribute {
  pub key : String
  pub value : Option[String]
}

///| RFC 8866 §5.14 Media Description (`m=` section).
pub struct MediaDescription {
  pub media_type : String
  pub port : Int
  pub port_count : Option[Int]
  pub protocol : String
  pub formats : Array[String]
  pub title : Option[String]
  pub connection : Option[Connection]
  pub bandwidths : Array[Bandwidth]
  pub attributes : Array[Attribute]
}

///| RFC 8866 Session Description.
pub struct SessionDescription {
  pub version : Int
  pub origin : Origin
  pub session_name : String
  pub session_info : Option[String]
  pub uri : Option[String]
  pub connection : Option[Connection]
  pub bandwidths : Array[Bandwidth]
  pub timings : Array[Timing]
  pub attributes : Array[Attribute]
  pub media : Array[MediaDescription]
}

///| Extension key-value pair on an ICE candidate (`a=candidate:...`).
pub val struct IceExtension {
  pub key : String
  pub value : String
}

///| RFC 8839 / Chrome ICE candidate (`a=candidate:...`).
pub struct IceCandidate {
  pub foundation : String
  pub component : Int
  pub transport : String
  pub priority : Int64
  pub address : String
  pub port : Int
  pub typ : String
  pub raddr : Option[String]
  pub rport : Option[Int]
  pub tcptype : Option[String]
  pub generation : Option[Int]
  pub ufrag : Option[String]
  pub extensions : Array[IceExtension]
}

///| ICE credentials extracted with JSEP media-level override / session-level fallback.
pub struct IceCredentials {
  pub ufrag : Option[String]
  pub pwd : Option[String]
  pub options : Array[String]
}

///| RFC 8122 / JSEP DTLS certificate fingerprint (`a=fingerprint:<alg> <val>`).
pub val struct DtlsFingerprint {
  pub algorithm : String
  pub value : String
}

///| RFC 4145 / JSEP DTLS setup role (`a=setup:...`).
pub enum DtlsSetup {
  Active
  Passive
  Actpass
  Holdconn
}

///| Format `DtlsSetup` as its canonical SDP token.
pub fn dtls_setup_to_string(s : DtlsSetup) -> String {
  match s {
    DtlsSetup::Active => "active"
    DtlsSetup::Passive => "passive"
    DtlsSetup::Actpass => "actpass"
    DtlsSetup::Holdconn => "holdconn"
  }
}

///| RFC 8866 §6.6 RTP payload mapping (`a=rtpmap:<pt> <enc>/<clock>[/<ch>]`).
pub val struct RtpMap {
  pub payload_type : Int
  pub encoding_name : String
  pub clock_rate : Int
  pub channels : Option[Int]
}

///| RFC 8866 §6.15 Format-specific parameters (`a=fmtp:<pt> <params>`).
pub val struct Fmtp {
  pub payload_type : Int
  pub parameters : String
}

///| RFC 4585 RTCP feedback (`a=rtcp-fb:<pt|*> <type>[ <param>]`).
///| `payload_type: None` denotes wildcard `*`.
pub val struct RtcpFb {
  pub payload_type : Option[Int]
  pub feedback_type : String
  pub parameter : Option[String]
}

///| RFC 8866 §6.7 Media direction.
pub enum Direction {
  SendRecv
  SendOnly
  RecvOnly
  Inactive
}

///| Format `Direction` as its canonical SDP attribute name.
pub fn direction_to_string(d : Direction) -> String {
  match d {
    Direction::SendRecv => "sendrecv"
    Direction::SendOnly => "sendonly"
    Direction::RecvOnly => "recvonly"
    Direction::Inactive => "inactive"
  }
}

///| RFC 8285 RTP header extension mapping (`a=extmap:<id>[/<dir>] <uri>[ <params>]`).
pub val struct ExtMap {
  pub id : Int
  pub direction : Option[Direction]
  pub uri : String
  pub params : Option[String]
}

///| RFC 5576 SSRC attribute (`a=ssrc:<ssrc> <attr>[:<value>]`).
pub val struct SsrcAttr {
  pub ssrc : Int64
  pub attribute : String
  pub value : Option[String]
}

///| RFC 5576 SSRC group (`a=ssrc-group:<semantics> <ssrc1> ...`).
pub struct SsrcGroup {
  pub semantics : String
  pub ssrcs : Array[Int64]
}

///| RFC 8843 BUNDLE group (`a=group:BUNDLE <mid1> <mid2> ...`).
pub struct BundleGroup {
  pub mids : Array[String]
}

///| RFC 8851 Restriction Identifier (`a=rid:<id> <send|recv>[ <params>]`).
pub val struct Rid {
  pub id : String
  pub direction : String
  pub params : Option[String]
}

///| RFC 8853 Simulcast (`a=simulcast:send <rids> recv <rids>`).
pub struct Simulcast {
  pub send_rids : Array[String]
  pub recv_rids : Array[String]
}

///| Per-media-section WebRTC / JSEP negotiation summary.
pub struct MediaSummary {
  pub index : Int
  pub media_type : String
  pub mid : Option[String]
  pub protocol : String
  pub port : Int
  pub direction : Direction
  pub ice : IceCredentials
  pub fingerprint : Option[DtlsFingerprint]
  pub setup : Option[DtlsSetup]
  pub rtcp_mux : Bool
  pub rtcp_rsize : Bool
  pub rtpmaps : Array[RtpMap]
  pub fmtps : Array[Fmtp]
  pub rtcp_fbs : Array[RtcpFb]
  pub extmaps : Array[ExtMap]
  pub candidates : Array[IceCandidate]
  pub ssrcs : Array[SsrcAttr]
  pub ssrc_groups : Array[SsrcGroup]
  pub rids : Array[Rid]
  pub simulcast : Option[Simulcast]
  pub msids : Array[String]
  pub sctp_port : Option[Int]
  pub max_message_size : Option[Int64]
}

///| High-level WebRTC / JSEP Offer/Answer negotiation summary.
pub struct WebRtcSummary {
  pub bundle_mids : Array[String]
  pub ice_lite : Bool
  pub media : Array[MediaSummary]
}
