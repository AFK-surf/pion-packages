///| Pion Native head-to-head benchmark for `packages/sdp`.
///| Usage: pion_sdp_bench <mode: parse|roundtrip> <sdp_file> <iters>

import "sdp"
import "crypto"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn sha256_str(s : String) -> String {
  let hasher = crypto::Sha256::new()
  hasher.update(s.to_bytes())
  hasher.finalize_hex()
}

fn canonical_summary(desc : sdp::SessionDescription) -> String {
  let sb = StringBuilder::new()
  sb.write_string("v=")
  sb.write_string(desc.version.to_string())
  sb.write_string("|o=")
  sb.write_string(desc.origin.username)
  sb.write_string(" ")
  sb.write_string(desc.origin.session_id)
  sb.write_string(" ")
  sb.write_string(desc.origin.session_version)
  sb.write_string(" ")
  sb.write_string(desc.origin.net_type)
  sb.write_string(" ")
  sb.write_string(desc.origin.addr_type)
  sb.write_string(" ")
  sb.write_string(desc.origin.unicast_address)
  sb.write_string("|s=")
  sb.write_string(desc.session_name)
  sb.write_string("|t=")
  sb.write_string(desc.timings.length().to_string())
  sb.write_string("|sa=")
  sb.write_string(desc.attributes.length().to_string())
  sb.write_string("|m=")
  sb.write_string(desc.media.length().to_string())
  let mut i = 0
  while i < desc.media.length() {
    let m = desc.media[i]
    sb.write_string("|[")
    sb.write_string(m.media_type)
    sb.write_string(":")
    sb.write_string(m.port.to_string())
    sb.write_string(":")
    sb.write_string(m.protocol)
    sb.write_string(":fmts=")
    sb.write_string(m.formats.length().to_string())
    sb.write_string(":attrs=")
    sb.write_string(m.attributes.length().to_string())
    sb.write_string("]")
    i = i + 1
  }
  sb.to_string()
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_sdp_bench <parse|roundtrip> <sdp_file> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_int(args[3])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b.to_string()
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }

  let mut last_desc : Option[sdp::SessionDescription] = None
  let mut last_ser = ""
  let mut i = 0
  while i < iters {
    let d = match sdp::parse(data) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "parse error: " + sdp::sdp_error_message(e))
        return 1
      }
    }
    if mode == "roundtrip" {
      last_ser = sdp::serialize(d)
    }
    last_desc = Some(d)
    i = i + 1
  }

  let desc = match last_desc {
    Some(d) => d
    None => return 1
  }
  let summary = canonical_summary(desc)
  let summary_sha = sha256_str(summary)
  if mode == "roundtrip" {
    let ser_sha = sha256_str(last_ser)
    io_println(
      world,
      "mode=roundtrip iters=" + iters.to_string() +
      " summary_sha256=" + summary_sha +
      " ser_bytes=" + last_ser.length().to_string() +
      " ser_sha256=" + ser_sha,
    )
  } else {
    io_println(
      world,
      "mode=parse iters=" + iters.to_string() +
      " summary_sha256=" + summary_sha,
    )
  }
  0
}
