///| Comprehensive RFC 8866 / RFC 8829 (JSEP) / RFC 8843 (BUNDLE) / RFC 8839 (ICE) /
///| RFC 8851-8853 (Simulcast) specification, security, and Chrome/Google Meet SDP tests.

fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn opt_int_eq(a : Option[Int], b : Option[Int]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn opt_i64_eq(a : Option[Int64], b : Option[Int64]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn dir_eq(a : Direction, b : Direction) -> Bool {
  direction_to_string(a) == direction_to_string(b)
}

fn setup_eq(a : Option[DtlsSetup], b : Option[DtlsSetup]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => dtls_setup_to_string(x) == dtls_setup_to_string(y)
    _ => false
  }
}

fn sample_meet_offer() -> String {
  "v=0\r\n" +
  "o=- 4611731400430051336 2 IN IP4 127.0.0.1\r\n" +
  "s=-\r\n" +
  "t=0 0\r\n" +
  "a=group:BUNDLE 0 1 2\r\n" +
  "a=extmap-allow-mixed\r\n" +
  "a=msid-semantic: WMS meet-stream-001\r\n" +
  "a=ice-options:trickle renomination\r\n" +
  "a=fingerprint:sha-256 AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99\r\n" +
  "m=audio 9 UDP/TLS/RTP/SAVPF 111 63 9 0 8\r\n" +
  "c=IN IP4 0.0.0.0\r\n" +
  "b=AS:128\r\n" +
  "a=rtcp:9 IN IP4 0.0.0.0\r\n" +
  "a=candidate:1467250027 1 udp 2122260223 192.168.1.10 54321 typ host generation 0 ufrag abcd network-id 1 network-cost 10\r\n" +
  "a=candidate:842163049 1 udp 1677729535 203.0.113.5 60001 typ srflx raddr 192.168.1.10 rport 54321 generation 0 ufrag abcd network-id 1\r\n" +
  "a=candidate:310293847 1 tcp 1518280447 192.168.1.10 9 typ host tcptype active generation 0 ufrag abcd\r\n" +
  "a=ice-ufrag:abcd\r\n" +
  "a=ice-pwd:supersecretpassword123456\r\n" +
  "a=setup:actpass\r\n" +
  "a=mid:0\r\n" +
  "a=extmap:1 urn:ietf:params:rtp-hdrext:ssrc-audio-level\r\n" +
  "a=extmap:2/sendonly http://www.webrtc.org/experiments/rtp-hdrext/abs-send-time\r\n" +
  "a=sendrecv\r\n" +
  "a=msid:meet-stream-001 audio-track-01\r\n" +
  "a=rtcp-mux\r\n" +
  "a=rtpmap:111 opus/48000/2\r\n" +
  "a=rtcp-fb:111 transport-cc\r\n" +
  "a=fmtp:111 minptime=10;useinbandfec=1\r\n" +
  "a=rtpmap:63 red/48000/2\r\n" +
  "a=rtpmap:9 G722/8000\r\n" +
  "a=rtpmap:0 PCMU/8000\r\n" +
  "a=rtpmap:8 PCMA/8000\r\n" +
  "a=ssrc:1001001 cname:meet-cname-01\r\n" +
  "a=ssrc:1001001 msid:meet-stream-001 audio-track-01\r\n" +
  "m=video 9 UDP/TLS/RTP/SAVPF 96 97 98 99 100 101\r\n" +
  "c=IN IP4 0.0.0.0\r\n" +
  "b=AS:2500\r\n" +
  "a=ice-ufrag:abcd\r\n" +
  "a=ice-pwd:supersecretpassword123456\r\n" +
  "a=fingerprint:sha-256 11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00\r\n" +
  "a=setup:actpass\r\n" +
  "a=mid:1\r\n" +
  "a=extmap:3 http://www.ietf.org/id/draft-holmer-rmcat-transport-wide-cc-extensions-01\r\n" +
  "a=extmap:4 urn:3gpp:video-orientation\r\n" +
  "a=extmap:5 http://www.webrtc.org/experiments/rtp-hdrext/playout-delay\r\n" +
  "a=sendonly\r\n" +
  "a=msid:meet-stream-001 video-track-01\r\n" +
  "a=rtcp-mux\r\n" +
  "a=rtcp-rsize\r\n" +
  "a=rtpmap:96 VP8/90000\r\n" +
  "a=rtcp-fb:96 goog-remb\r\n" +
  "a=rtcp-fb:96 transport-cc\r\n" +
  "a=rtcp-fb:96 ccm fir\r\n" +
  "a=rtcp-fb:96 nack\r\n" +
  "a=rtcp-fb:96 nack pli\r\n" +
  "a=rtcp-fb:* nack\r\n" +
  "a=rtpmap:97 rtx/90000\r\n" +
  "a=fmtp:97 apt=96\r\n" +
  "a=rtpmap:98 VP9/90000\r\n" +
  "a=fmtp:98 profile-id=0\r\n" +
  "a=rtpmap:99 H264/90000\r\n" +
  "a=fmtp:99 level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42e01f\r\n" +
  "a=rtpmap:100 AV1/90000\r\n" +
  "a=rtpmap:101 rtx/90000\r\n" +
  "a=fmtp:101 apt=99\r\n" +
  "a=rid:q send pt=96;max-width=320;max-height=180\r\n" +
  "a=rid:h send pt=96;max-width=640;max-height=360\r\n" +
  "a=rid:f send pt=96;max-width=1280;max-height=720\r\n" +
  "a=simulcast:send q;h;f\r\n" +
  "a=ssrc-group:FID 2002001 2002002\r\n" +
  "a=ssrc-group:SIM 2002001 2002003 2002005\r\n" +
  "a=ssrc:2002001 cname:meet-cname-01\r\n" +
  "a=ssrc:2002002 cname:meet-cname-01\r\n" +
  "m=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\n" +
  "c=IN IP4 0.0.0.0\r\n" +
  "a=ice-ufrag:abcd\r\n" +
  "a=ice-pwd:supersecretpassword123456\r\n" +
  "a=setup:actpass\r\n" +
  "a=mid:2\r\n" +
  "a=sctp-port:5000\r\n" +
  "a=max-message-size:262144\r\n"
}

test "rfc8866_minimal_and_lf_crlf" {
  let sdp_lf = "v=0\no=alice 2890844526 2890844526 IN IP4 host.example.com\ns=Session SDP\ni=A Seminar on the session description protocol\nu=http://www.example.com/seminars/sdp.pdf\nc=IN IP4 224.2.17.12/127\nb=AS:512\nt=2873397496 2873404696\na=recvonly\nm=audio 49170/2 RTP/AVP 0 8\ni=Main Audio\nc=IN IP4 224.2.17.13/127\nb=TIAS:64000\na=rtpmap:0 PCMU/8000\n"
  match parse(sdp_lf) {
    Ok(desc) => {
      debug_assert(desc.version == 0, "version 0")
      debug_assert(desc.origin.username == "alice", "origin username")
      debug_assert(desc.origin.session_id == "2890844526", "origin session_id")
      debug_assert(desc.origin.session_version == "2890844526", "origin session_version")
      debug_assert(desc.origin.net_type == "IN", "origin net_type")
      debug_assert(desc.origin.addr_type == "IP4", "origin addr_type")
      debug_assert(desc.origin.unicast_address == "host.example.com", "origin addr")
      debug_assert(desc.session_name == "Session SDP", "session_name")
      debug_assert(
        opt_str_eq(desc.session_info, Some("A Seminar on the session description protocol")),
        "session_info",
      )
      debug_assert(
        opt_str_eq(desc.uri, Some("http://www.example.com/seminars/sdp.pdf")),
        "uri",
      )
      match desc.connection {
        Some(c) => {
          debug_assert(c.net_type == "IN", "c net")
          debug_assert(c.addr_type == "IP4", "c addr_type")
          debug_assert(c.address == "224.2.17.12/127", "c address")
        }
        None => debug_assert(false, "expected session connection")
      }
      debug_assert(desc.bandwidths.length() == 1, "1 session bw")
      debug_assert(desc.bandwidths[0].bwtype == "AS", "bwtype AS")
      debug_assert(desc.bandwidths[0].bandwidth == 512L, "bw 512")
      debug_assert(desc.timings.length() == 1, "1 timing")
      debug_assert(desc.timings[0].start_time == 2873397496L, "start_time")
      debug_assert(desc.timings[0].stop_time == 2873404696L, "stop_time")
      debug_assert(desc.attributes.length() == 1, "1 session attr")
      debug_assert(desc.attributes[0].key == "recvonly", "recvonly key")
      debug_assert(opt_str_eq(desc.attributes[0].value, None), "property attr has None value")
      debug_assert(desc.media.length() == 1, "1 media section")
      let m = desc.media[0]
      debug_assert(m.media_type == "audio", "audio")
      debug_assert(m.port == 49170, "port 49170")
      debug_assert(opt_int_eq(m.port_count, Some(2)), "port_count 2")
      debug_assert(m.protocol == "RTP/AVP", "proto")
      debug_assert(m.formats.length() == 2 && m.formats[0] == "0" && m.formats[1] == "8", "formats")
      debug_assert(opt_str_eq(m.title, Some("Main Audio")), "media title")
      // Session-level direction inherited by media
      debug_assert(dir_eq(media_direction(desc, 0), Direction::RecvOnly), "inherited recvonly")

      // Serialize must use CRLF strictly and roundtrip cleanly
      let out = serialize(desc)
      debug_assert(out.length() > 0, "non-empty serialized")
      // Check every LF is preceded by CR
      let mut i = 0
      let mut lf_count = 0
      while i < out.length() {
        if out.code_unit_at(i) == 10 {
          debug_assert(i > 0 && out.code_unit_at(i - 1) == 13, "strict CRLF")
          lf_count = lf_count + 1
        }
        i = i + 1
      }
      debug_assert(lf_count == 14, "expected 14 CRLF lines")
      match parse(out) {
        Ok(desc2) => {
          debug_assert(serialize(desc2) == out, "idempotent roundtrip")
        }
        Err(e) => debug_assert(false, "roundtrip parse failed: " + sdp_error_message(e))
      }
    }
    Err(e) => debug_assert(false, "parse failed: " + sdp_error_message(e))
  }
}

test "meet_offer_full_jsep_and_roundtrip" {
  let raw = sample_meet_offer()
  let desc = match parse(raw) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "meet offer parse failed: " + sdp_error_message(e))
      return
    }
  }
  debug_assert(desc.media.length() == 3, "3 media sections")
  // Roundtrip lossless
  let ser = serialize(desc)
  let desc2 = match parse(ser) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "reparse failed: " + sdp_error_message(e))
      return
    }
  }
  debug_assert(serialize(desc2) == ser, "canonical roundtrip")

  // BUNDLE
  let bundles = bundle_groups(desc)
  debug_assert(bundles.length() == 1, "1 bundle group")
  debug_assert(bundles[0].mids.length() == 3, "3 bundle mids")
  debug_assert(
    bundles[0].mids[0] == "0" && bundles[0].mids[1] == "1" && bundles[0].mids[2] == "2",
    "bundle mids 0 1 2",
  )

  // Audio section (index 0): fingerprint falls back to session-level
  let fp0 = fingerprint(desc, 0)
  match fp0 {
    Some(fp) => {
      debug_assert(fp.algorithm == "sha-256", "fp0 alg")
      debug_assert(
        fp.value == "AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99",
        "fp0 fallback value",
      )
    }
    None => debug_assert(false, "expected session-level fingerprint fallback")
  }
  // Video section (index 1): media-level fingerprint overrides session-level
  let fp1 = fingerprint(desc, 1)
  match fp1 {
    Some(fp) => {
      debug_assert(fp.algorithm == "sha-256", "fp1 alg")
      debug_assert(
        fp.value == "11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00",
        "fp1 override value",
      )
    }
    None => debug_assert(false, "expected media-level fingerprint override")
  }

  // ICE credentials
  let ice0 = ice_credentials(desc, 0)
  debug_assert(opt_str_eq(ice0.ufrag, Some("abcd")), "ice0 ufrag")
  debug_assert(opt_str_eq(ice0.pwd, Some("supersecretpassword123456")), "ice0 pwd")
  debug_assert(ice0.options.length() == 2, "ice0 options from session")
  debug_assert(ice0.options[0] == "trickle" && ice0.options[1] == "renomination", "ice0 options")

  // ICE candidates on audio
  match ice_candidates(desc.media[0]) {
    Ok(cands) => {
      debug_assert(cands.length() == 3, "3 candidates")
      debug_assert(cands[0].foundation == "1467250027", "c0 foundation")
      debug_assert(cands[0].component == 1, "c0 component")
      debug_assert(cands[0].transport == "udp", "c0 transport")
      debug_assert(cands[0].priority == 2122260223L, "c0 priority")
      debug_assert(cands[0].address == "192.168.1.10", "c0 addr")
      debug_assert(cands[0].port == 54321, "c0 port")
      debug_assert(cands[0].typ == "host", "c0 typ")
      debug_assert(opt_int_eq(cands[0].generation, Some(0)), "c0 generation")
      debug_assert(opt_str_eq(cands[0].ufrag, Some("abcd")), "c0 ufrag")
      debug_assert(cands[0].extensions.length() == 2, "c0 2 extensions")
      debug_assert(
        cands[0].extensions[0].key == "network-id" && cands[0].extensions[0].value == "1",
        "c0 network-id",
      )
      debug_assert(
        cands[0].extensions[1].key == "network-cost" && cands[0].extensions[1].value == "10",
        "c0 network-cost",
      )

      // Candidate 1: srflx with raddr & rport
      debug_assert(cands[1].typ == "srflx", "c1 srflx")
      debug_assert(opt_str_eq(cands[1].raddr, Some("192.168.1.10")), "c1 raddr")
      debug_assert(opt_int_eq(cands[1].rport, Some(54321)), "c1 rport")

      // Candidate 2: tcp with tcptype
      debug_assert(cands[2].transport == "tcp", "c2 tcp")
      debug_assert(opt_str_eq(cands[2].tcptype, Some("active")), "c2 tcptype")

      // Format & re-parse candidate roundtrip
      let formatted = format_ice_candidate(cands[0])
      match parse_ice_candidate(formatted) {
        Ok(reparsed) => {
          debug_assert(format_ice_candidate(reparsed) == formatted, "candidate format roundtrip")
        }
        Err(e) => debug_assert(false, "candidate reparse failed: " + sdp_error_message(e))
      }
    }
    Err(e) => debug_assert(false, "ice_candidates failed: " + sdp_error_message(e))
  }

  // Video section: simulcast, rid, ssrc-group, rtcp-fb wildcard, extmaps, codecs
  let m1 = desc.media[1]
  debug_assert(dir_eq(media_direction(desc, 1), Direction::SendOnly), "video sendonly")
  debug_assert(setup_eq(dtls_setup(m1), Some(DtlsSetup::Actpass)), "video actpass")
  debug_assert(has_rtcp_mux(m1), "video rtcp-mux")
  debug_assert(has_rtcp_rsize(m1), "video rtcp-rsize")
  debug_assert(opt_str_eq(media_mid(m1), Some("1")), "video mid 1")
  let msids1 = media_msids(m1)
  debug_assert(msids1.length() == 1 && msids1[0] == "meet-stream-001 video-track-01", "video msid")

  match rtpmaps(m1) {
    Ok(maps) => {
      debug_assert(maps.length() == 6, "6 video rtpmaps")
      debug_assert(maps[0].payload_type == 96 && maps[0].encoding_name == "VP8" && maps[0].clock_rate == 90000, "VP8")
      debug_assert(maps[3].payload_type == 99 && maps[3].encoding_name == "H264", "H264")
      debug_assert(maps[4].payload_type == 100 && maps[4].encoding_name == "AV1", "AV1")
    }
    Err(e) => debug_assert(false, "rtpmaps failed: " + sdp_error_message(e))
  }

  match rtcp_fbs(m1) {
    Ok(fbs) => {
      debug_assert(fbs.length() == 6, "6 rtcp-fb entries")
      debug_assert(opt_int_eq(fbs[2].payload_type, Some(96)) && fbs[2].feedback_type == "ccm" && opt_str_eq(fbs[2].parameter, Some("fir")), "ccm fir")
      debug_assert(opt_int_eq(fbs[5].payload_type, None) && fbs[5].feedback_type == "nack", "wildcard * nack")
    }
    Err(e) => debug_assert(false, "rtcp_fbs failed: " + sdp_error_message(e))
  }

  match rids(m1) {
    Ok(rs) => {
      debug_assert(rs.length() == 3, "3 rids")
      debug_assert(rs[0].id == "q" && rs[0].direction == "send", "rid q")
      debug_assert(opt_str_eq(rs[2].params, Some("pt=96;max-width=1280;max-height=720")), "rid f params")
    }
    Err(e) => debug_assert(false, "rids failed: " + sdp_error_message(e))
  }

  match simulcast(m1) {
    Ok(Some(sim)) => {
      debug_assert(sim.send_rids.length() == 3, "3 send rids")
      debug_assert(sim.send_rids[0] == "q" && sim.send_rids[1] == "h" && sim.send_rids[2] == "f", "q h f")
      debug_assert(sim.recv_rids.length() == 0, "0 recv rids")
    }
    _ => debug_assert(false, "expected simulcast")
  }

  match ssrc_groups(m1) {
    Ok(gs) => {
      debug_assert(gs.length() == 2, "2 ssrc groups")
      debug_assert(gs[0].semantics == "FID" && gs[0].ssrcs.length() == 2 && gs[0].ssrcs[0] == 2002001L, "FID group")
      debug_assert(gs[1].semantics == "SIM" && gs[1].ssrcs.length() == 3, "SIM group")
    }
    Err(e) => debug_assert(false, "ssrc_groups failed: " + sdp_error_message(e))
  }

  // DataChannel section (index 2)
  let m2 = desc.media[2]
  debug_assert(opt_int_eq(sctp_port(m2), Some(5000)), "sctp-port 5000")
  debug_assert(opt_i64_eq(max_message_size(m2), Some(262144L)), "max-message-size 262144")

  // High-level summary
  match extract_webrtc_summary(desc) {
    Ok(summary) => {
      debug_assert(summary.bundle_mids.length() == 3, "summary bundle mids")
      debug_assert(!summary.ice_lite, "not ice-lite")
      debug_assert(summary.media.length() == 3, "3 media summaries")
      debug_assert(summary.media[0].rtpmaps.length() == 5, "audio 5 rtpmaps")
      debug_assert(summary.media[0].extmaps.length() == 2, "audio 2 extmaps")
      debug_assert(summary.media[0].candidates.length() == 3, "audio 3 candidates")
      debug_assert(opt_int_eq(summary.media[2].sctp_port, Some(5000)), "summary sctp-port")
    }
    Err(e) => debug_assert(false, "extract_webrtc_summary failed: " + sdp_error_message(e))
  }
}

test "extmap_direction_and_params" {
  let sdp = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\nm=audio 9 UDP/TLS/RTP/SAVPF 111\r\na=extmap:1/recvonly urn:ietf:params:rtp-hdrext:ssrc-audio-level vad=on\r\n"
  let desc = match parse(sdp) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  match extmaps(desc.media[0]) {
    Ok(exts) => {
      debug_assert(exts.length() == 1, "1 extmap")
      debug_assert(exts[0].id == 1, "id 1")
      match exts[0].direction {
        Some(d) => debug_assert(dir_eq(d, Direction::RecvOnly), "recvonly extmap")
        None => debug_assert(false, "expected extmap direction")
      }
      debug_assert(exts[0].uri == "urn:ietf:params:rtp-hdrext:ssrc-audio-level", "uri")
      debug_assert(opt_str_eq(exts[0].params, Some("vad=on")), "params vad=on")
    }
    Err(e) => debug_assert(false, "extmaps failed: " + sdp_error_message(e))
  }
}

test "parse_ice_candidate_with_prefix" {
  let raw = "candidate:842163049 1 udp 1677729535 203.0.113.5 60001 typ srflx raddr 10.0.0.1 rport 50000 generation 0"
  match parse_ice_candidate(raw) {
    Ok(c) => {
      debug_assert(c.foundation == "842163049", "foundation")
      debug_assert(c.port == 60001, "port")
      debug_assert(c.typ == "srflx", "typ")
      debug_assert(opt_str_eq(c.raddr, Some("10.0.0.1")), "raddr")
      debug_assert(opt_int_eq(c.rport, Some(50000)), "rport")
      debug_assert(opt_int_eq(c.generation, Some(0)), "gen")
    }
    Err(e) => debug_assert(false, "parse_ice_candidate failed: " + sdp_error_message(e))
  }
}

test "simulcast_send_and_recv" {
  let sdp = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\nm=video 9 UDP/TLS/RTP/SAVPF 96\r\na=simulcast:send h;~m;l recv r1;r2\r\n"
  let desc = match parse(sdp) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  match simulcast(desc.media[0]) {
    Ok(Some(sim)) => {
      debug_assert(sim.send_rids.length() == 3 && sim.send_rids[1] == "m", "send rids clean id")
      debug_assert(
        sim.send_streams.length() == 3 && sim.send_streams[1][0].id == "m" && sim.send_streams[1][0].paused,
        "paused rid preserved in send_streams",
      )
      debug_assert(sim.recv_rids.length() == 2 && sim.recv_rids[0] == "r1" && sim.recv_rids[1] == "r2", "recv rids")
    }
    _ => debug_assert(false, "expected send+recv simulcast")
  }
}

test "limits_strict_zero_and_negative" {
  let minimal = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n"
  let with_media = minimal + "m=audio 9 UDP/TLS/RTP/SAVPF 111\r\na=rtcp-mux\r\n"

  // Negative limits immediately rejected
  match parse_with_limits(minimal, ParseLimits::new(-1, 100, 10, 10)) {
    Err(SdpError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "negative max_bytes must fail")
  }
  match parse_with_limits(minimal, ParseLimits::new(1024, -1, 10, 10)) {
    Err(SdpError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "negative max_lines must fail")
  }
  match parse_with_limits(minimal, ParseLimits::new(1024, 100, -1, 10)) {
    Err(SdpError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "negative max_media_sections must fail")
  }
  match parse_with_limits(minimal, ParseLimits::new(1024, 100, 10, -1)) {
    Err(SdpError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "negative max_attributes_per_section must fail")
  }

  // Zero strictly means 0 allowed
  match parse_with_limits(minimal, ParseLimits::new(0, 100, 10, 10)) {
    Err(SdpError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_bytes=0 must reject non-empty")
  }
  match parse_with_limits(minimal, ParseLimits::new(1024, 0, 10, 10)) {
    Err(SdpError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_lines=0 must reject")
  }
  // max_media_sections=0 allows 0 media sections, rejects 1
  match parse_with_limits(minimal, ParseLimits::new(1024, 100, 0, 0)) {
    Ok(d) => debug_assert(d.media.length() == 0, "0 media allowed")
    Err(e) => debug_assert(false, "minimal with 0 media/attrs should pass: " + sdp_error_message(e))
  }
  match parse_with_limits(with_media, ParseLimits::new(1024, 100, 0, 10)) {
    Err(SdpError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_media_sections=0 must reject m=")
  }
  match parse_with_limits(with_media, ParseLimits::new(1024, 100, 1, 0)) {
    Err(SdpError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "max_attributes_per_section=0 must reject a=")
  }
}

test "security_and_validation_errors" {
  // Empty input
  match parse("") {
    Err(SdpError::EmptyInput) => ()
    _ => debug_assert(false, "empty input")
  }

  // Missing required fields
  match parse("v=0\r\ns=-\r\nt=0 0\r\n") {
    Err(SdpError::MissingRequiredField(_)) => ()
    _ => debug_assert(false, "missing o=")
  }
  match parse("v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\nt=0 0\r\n") {
    Err(SdpError::MissingRequiredField(_)) => ()
    _ => debug_assert(false, "missing s=")
  }
  match parse("v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\n") {
    Err(SdpError::MissingRequiredField(_)) => ()
    _ => debug_assert(false, "missing t=")
  }

  // Invalid version
  match parse("v=1\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n") {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "v=1 must fail")
  }

  // Uppercase line type rejected
  match parse("V=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n") {
    Err(SdpError::InvalidLine(_, _)) => ()
    _ => debug_assert(false, "uppercase V= must fail")
  }

  // Missing '=' rejected
  match parse("v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\nbadline\r\n") {
    Err(SdpError::InvalidLine(_, _)) => ()
    _ => debug_assert(false, "missing = must fail")
  }

  // NUL injection rejected
  let nul_bytes = Bytes::new(1)
  nul_bytes[0] = (0).to_byte()
  let nul_sdp = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-" + nul_bytes.to_string() + "\r\nt=0 0\r\n"
  match parse(nul_sdp) {
    Err(SdpError::InvalidLine(_, _)) => ()
    _ => debug_assert(false, "NUL byte must be rejected")
  }

  // Bare CR rejected
  match parse("v=0\ro=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n") {
    Err(SdpError::InvalidLine(_, _)) => ()
    _ => debug_assert(false, "bare CR must be rejected")
  }

  // Port out of range (>65535 and negative)
  match parse("v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\nm=audio 65536 RTP/AVP 0\r\n") {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "port 65536 must fail")
  }
  match parse("v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\nm=audio -1 RTP/AVP 0\r\n") {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "port -1 must fail")
  }

  // Invalid payload type in rtpmap (>127)
  let bad_pt = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\nm=audio 9 RTP/AVP 128\r\na=rtpmap:128 opus/48000/2\r\n"
  match parse(bad_pt) {
    Ok(d) => {
      match rtpmaps(d.media[0]) {
        Err(SdpError::InvalidSyntax(_, _)) => ()
        _ => debug_assert(false, "payload type 128 must fail")
      }
    }
    Err(_) => debug_assert(false, "parse should succeed; rtpmaps should fail")
  }

  // Invalid ICE candidate priority / port
  match parse_ice_candidate("1 1 udp -5 127.0.0.1 5000 typ host") {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "negative priority must fail")
  }
  match parse_ice_candidate("1 1 udp 2122260223 127.0.0.1 70000 typ host") {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "port 70000 must fail")
  }
}

test "ipv6_ice_lite_and_dtls_setups" {
  let sdp = "v=0\r\n" +
  "o=sfu 12345 1 IN IP6 2001:db8::1\r\n" +
  "s=Meet SFU\r\n" +
  "t=0 0\r\n" +
  "a=ice-lite\r\n" +
  "a=ice-ufrag:sessufrag\r\n" +
  "a=ice-pwd:sesspassword123456789012\r\n" +
  "m=audio 9 UDP/TLS/RTP/SAVPF 111\r\n" +
  "a=setup:active\r\n" +
  "a=candidate:2001 1 udp 2130706430 2001:4860:4864:5::14 19305 typ host generation 0\r\n" +
  "m=video 9 UDP/TLS/RTP/SAVPF 96\r\n" +
  "a=setup:passive\r\n" +
  "a=inactive\r\n" +
  "m=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\n" +
  "a=setup:holdconn"
  let desc = match parse(sdp) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse failed: " + sdp_error_message(e))
      return
    }
  }
  let summary = match extract_webrtc_summary(desc) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "summary failed: " + sdp_error_message(e))
      return
    }
  }
  debug_assert(summary.ice_lite, "ice-lite true")
  debug_assert(opt_str_eq(summary.media[0].ice.ufrag, Some("sessufrag")), "session ufrag fallback")
  debug_assert(opt_str_eq(summary.media[0].ice.pwd, Some("sesspassword123456789012")), "session pwd fallback")
  debug_assert(setup_eq(summary.media[0].setup, Some(DtlsSetup::Active)), "active")
  debug_assert(setup_eq(summary.media[1].setup, Some(DtlsSetup::Passive)), "passive")
  debug_assert(dir_eq(summary.media[1].direction, Direction::Inactive), "inactive")
  debug_assert(setup_eq(summary.media[2].setup, Some(DtlsSetup::Holdconn)), "holdconn")
  debug_assert(dir_eq(summary.media[0].direction, Direction::SendRecv), "default sendrecv")
  debug_assert(summary.media[0].candidates.length() == 1, "1 ipv6 candidate")
  debug_assert(summary.media[0].candidates[0].address == "2001:4860:4864:5::14", "ipv6 address")
}

test "jsep_malformed_attributes_rejected" {
  let sdp = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\nm=video 9 UDP/TLS/RTP/SAVPF 96\r\na=extmap:0 urn:bad\r\na=rid:1 invalid_dir\r\na=simulcast:bogus q\r\na=ssrc-group:FID\r\n"
  let desc = match parse(sdp) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "base sdp parse should succeed")
      return
    }
  }
  let m = desc.media[0]
  match extmaps(m) {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "extmap id 0 must fail")
  }
  match rids(m) {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "rid invalid dir must fail")
  }
  match simulcast(m) {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "simulcast bogus dir must fail")
  }
  match ssrc_groups(m) {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "ssrc-group without ssrcs must fail")
  }
}

test "checked_serialize_and_candidate_hardening" {
  let d = match parse("v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "base parse failed")
      return
    }
  }
  // CRLF injection in session_name rejected by serialize_checked & fails closed in serialize
  let evil_name = SessionDescription::{
    version: d.version,
    origin: d.origin,
    session_name: "room\r\na=fingerprint:sha-256 EV:IL",
    session_info: d.session_info,
    uri: d.uri,
    connection: d.connection,
    bandwidths: d.bandwidths,
    timings: d.timings,
    attributes: d.attributes,
    media: d.media,
  }
  match serialize_checked(evil_name) {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "serialize_checked must reject CRLF in session_name")
  }
  debug_assert(serialize(evil_name) == "", "serialize must fail closed on CRLF")

  // Attribute.key containing ':' or space rejected by serialize_checked & fails closed in serialize
  let evil_key = SessionDescription::{
    version: d.version,
    origin: d.origin,
    session_name: d.session_name,
    session_info: d.session_info,
    uri: d.uri,
    connection: d.connection,
    bandwidths: d.bandwidths,
    timings: d.timings,
    attributes: [Attribute::{ key: "setup:active x", value: Some("y") }],
    media: d.media,
  }
  match serialize_checked(evil_key) {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "serialize_checked must reject ':'/space in Attribute.key")
  }
  debug_assert(serialize(evil_key) == "", "serialize must fail closed on invalid Attribute.key")

  // format_ice_candidate_checked rejects space smuggling
  let bad_cand = IceCandidate::{
    foundation: "1",
    component: 1,
    transport: "udp",
    priority: 100L,
    address: "10.0.0.1",
    port: 9,
    typ: "host",
    raddr: None,
    rport: None,
    tcptype: None,
    generation: None,
    ufrag: Some("abcd raddr 6.6.6.6"),
    extensions: [],
  }
  match format_ice_candidate_checked(bad_cand) {
    Err(SdpError::InvalidSyntax(_, _)) => ()
    _ => debug_assert(false, "format_ice_candidate_checked must reject spaces in ufrag")
  }
  debug_assert(format_ice_candidate(bad_cand) == "", "format_ice_candidate must fail closed")

  // Legacy sctpmap and RFC 8285 offer-only extmap 4096..4351
  let legacy = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\nm=video 9 UDP/TLS/RTP/SAVPF 96\r\na=extmap:4096 urn:ietf:params:rtp-hdrext:toffset\r\nm=application 9 DTLS/SCTP 5000\r\na=sctpmap:5000 webrtc-datachannel 1024\r\n"
  match parse(legacy) {
    Ok(ld) => {
      match extract_webrtc_summary(ld) {
        Ok(s) => {
          debug_assert(s.media[0].extmaps.length() == 1 && s.media[0].extmaps[0].id == 4096, "extmap 4096")
          debug_assert(opt_int_eq(s.media[1].sctp_port, Some(5000)), "legacy sctpmap 5000")
        }
        Err(e) => debug_assert(false, "legacy summary failed: " + sdp_error_message(e))
      }
    }
    Err(e) => debug_assert(false, "legacy parse failed: " + sdp_error_message(e))
  }
}
