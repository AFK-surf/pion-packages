///|
test "redteam_w2_reserved_nonzero_must_decode" {
  // P2-1 conform-mustNotUseReservedValue (vector `w2/reserved!=0`)
  let data = rt_hex(
    "774f463200010000000001180006000100001114000000d8000100000000000000000000000000000000000000000000" +
    "01360224031404200aa00081280b18001b3501f8af0a6c63d468effa144a9620e74b8787d48c7f381b0fd4daefedee1d" +
    "e21ea296681a1a4d345412a5fde9970236fd7f880cc92e05a8fd0baeafff49e171263db35e713ac3069c412216b8863a" +
    "009c0014800002190edb57bf35a7aab79caaa98a240a08a48972a42aa4aa0000c8e316719bb853b6fb7c7b250139c782" +
    "5c40133274611a0be841865042c8527d266fcdfaef9b2ffe6a7cbc2a6fcd148a189f9a7a6e3eebd7efeb1156ceb3b28e" +
    "67140aa68554fdcf9290d74d7022fcd46d9a101e841037c1a605942f7f8f4529c7ad34510995fa0e",
  )
  match woff2::decode(data) {
    Ok(out) => debug_assert(rt_whole_checksum_ok(out), "decoded SFNT has a bad whole-font checksum")
    Err(e) => debug_assert(false, "valid input rejected: " + woff2::woff_error_message(e))
  }
}

