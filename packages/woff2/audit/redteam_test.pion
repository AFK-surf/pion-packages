///|
test "redteam_limits_zero_max_output_consistent_across_formats" {
  // P2-6: `max_output_bytes <= 0` disables the WOFF1 output cap but makes every WOFF2 decode fail
  // (`brotli::DecodeLimits` treats 0 as a 0-byte cap).
  let lim = woff2::DecodeLimits::new(0, 256, 65536)
  let a = match woff2::decode_with_limits(rt_hex(""), lim) {
    Ok(_) => true
    Err(_) => false
  }
  let b = match woff2::decode_with_limits(rt_hex(""), lim) {
    Ok(_) => true
    Err(_) => false
  }
  debug_assert(a == b, "max_output_bytes = 0: WOFF2 ok=" + a.to_string() + " but WOFF1 ok=" + b.to_string())
}
