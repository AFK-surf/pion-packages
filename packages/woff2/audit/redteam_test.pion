///| Red-team unit tests for `packages/woff2` (generated by `gen_redteam_test.py` from `difftest.py`).
///| `redteam_*` assert the *correct* behaviour and FAIL while the defect exists; `control_*` already PASS.
///| A P0 test aborts the whole native test process with `pion panic` while the defect exists, so
///| `run_audit.sh unit` runs every test in its own process.

import "woff2"

///|
fn rt_hex(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = rt_nib(s.code_unit_at(2 * i))
    let lo = rt_nib(s.code_unit_at(2 * i + 1))
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn rt_nib(c : Int) -> Int {
  if c >= 97 {
    c - 87
  } else {
    c - 48
  }
}

///|
fn rt_whole_checksum_ok(s : Bytes) -> Bool {
  let mut sum : UInt = 0U
  let mut i = 0
  while i + 3 < s.length() {
    sum = sum +
    ((s[i].to_int().to_uint() << 24) |
      (s[i + 1].to_int().to_uint() << 16) |
      (s[i + 2].to_int().to_uint() << 8) |
      s[i + 3].to_int().to_uint())
    i = i + 4
  }
  sum == 0xB1B0AFBAU
}

///|
test "redteam_p0_hmtx_null_glyf_loca_int_min_must_not_panic" {
  // P0-1: loca[0] = 0x80000000 -> negative index panic in extract_xmins_from_raw_glyf (vector `w2/hmtx-null-glyf-loca-0x80000000`)
  let data = rt_hex(
    "774f463200010000000000a4000600000000014c00000065000100000000000000000000000000000000000000000000" +
    "01360224430c070420ca48cb101bd800f81f07b969f43631bd33ba1a4f1f177bfb174f24c00cb3228ce110fef885cd25" +
    "4f96563fe010ed830d3883c02cf4c470b053000466407827def839ba0000d0eda24610fab8a50b5d010034f39a6641b5" +
    "4320d79c4a92402e98937fc83de70b3cf9010000",
  )
  match woff2::decode(data) {
    Ok(_) => debug_assert(false, "malformed input accepted")
    Err(_) => ()
  }
}

///|
test "redteam_p0_hmtx_null_glyf_loca_wrap_must_not_panic" {
  // P0-1: g_start + 4 wraps Int32, bounds check passes, index panics (vector `w2/hmtx-null-glyf-loca-0x7FFFFFFC`)
  let data = rt_hex(
    "774f463200010000000000a8000600000000014c00000069000100000000000000000000000000000000000000000000" +
    "01360224430c070420ca48cb101bd800f81f89b12d8a7d1327de4089e78b8bbdbf8b41a001669815592c87b0e31755b3" +
    "c993a5553844b00167100da48b2dc4136f370002203003841a9e571f971eddd9d3835682d0b7450ff40800a0538faa16" +
    "347608e4ac4393249013eae01fd92fe7bdfb538bbb5f0000",
  )
  match woff2::decode(data) {
    Ok(_) => debug_assert(false, "malformed input accepted")
    Err(_) => ()
  }
}

