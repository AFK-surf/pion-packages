    "01360224430c070420ca48cb101bd800f89f07764c980c118d1af8bbc5d3f7f7ecec5d4c24c00cb302828f70c77fd8bc" +
    "e4c9d2ca0722cec2d9870d3883c02ca1756118ec0e6000046680f04e7cf879740100a0db458d20f479d085ae00009a79" +
    "4fb3a0da25907b2e25492037ccc53fe4e4e0d0f1d22f0000",
  )
  match woff2::decode(data) {
    Ok(_) => debug_assert(false, "malformed input accepted")
    Err(_) => ()
  }
}

