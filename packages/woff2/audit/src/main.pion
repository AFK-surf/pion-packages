///| Red-team differential harness CLI for `packages/woff2`.
///| Batch file format: repeated `[u32 LE length][payload]` records.
///| Canonical result line (shared with `diff/rust` wuff harness, byte-for-byte):
///|   `OK <len> ck=<ok|bad> <tag>:<len>:<fnv64> ...` (directory order; head.checkSumAdjustment zeroed)
///|   `ERR <Variant>`
///| Modes:
///|   batch <cases.bin> <max_out> <max_tables> <max_glyphs>   -> one line per case
///|   file <in> <max_out> <max_tables> <max_glyphs> [out]     -> single input (bombs / differential dump)
///|   bench <in> <iters>                                      -> timed decode loop (default limits)
///|   brotli <in> <iters>                                     -> only the Brotli stage of a WOFF2 file
///|   zlib <in> <iters>                                       -> only the per-table zlib stage of a WOFF1 file

import "woff2"
import "brotli"
import "flate"

///|
fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut neg = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 45 && i == 0 {
      neg = true
    } else if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  if neg {
    0 - acc
  } else {
    acc
  }
}

///|
fn err_name(e : woff2::WoffError) -> String {
  match e {
    InvalidSignature(_) => "InvalidSignature"
    TruncatedHeader(_) => "TruncatedHeader"
    UnsupportedCollection => "UnsupportedCollection"
    InvalidTableDirectory(_) => "InvalidTableDirectory"
    InvalidVarInt(_) => "InvalidVarInt"
    BoundsExceeded(_) => "BoundsExceeded"
    BrotliError(_) => "BrotliError"
    ZlibError(_) => "ZlibError"
    GlyfReconstructionError(_) => "GlyfReconstructionError"
    HmtxReconstructionError(_) => "HmtxReconstructionError"
    LimitExceeded(_) => "LimitExceeded"
  }
}

///|
fn read_u32le(b : Bytes, p : Int) -> Int {
  b[p].to_int() |
  (b[p + 1].to_int() << 8) |
  (b[p + 2].to_int() << 16) |
  (b[p + 3].to_int() << 24)
}

///|
fn rd16(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 8) | b[off + 1].to_int()
}

///|
fn rd32(b : Bytes, off : Int) -> UInt {
  (b[off].to_int().to_uint() << 24) |
  (b[off + 1].to_int().to_uint() << 16) |
  (b[off + 2].to_int().to_uint() << 8) |
  b[off + 3].to_int().to_uint()
}

///|
fn hex(v : UInt64, digits : Int) -> String {
  let out = Bytes::new(digits)
  let mut i = 0
  let mut shift = (digits - 1) * 4
  while i < digits {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

///|
fn tag_str(t : UInt) -> String {
  let out = Bytes::new(4)
  let mut i = 0
  while i < 4 {
    let sh = 24 - i * 8
    let c = ((t >> sh) & 0xFFU).to_int()
    out[i] = (if c >= 33 && c < 127 { c } else { 95 }).to_byte()
    i = i + 1
  }
  out.to_string()
}

///| Canonical, layout-independent description of an SFNT (same algorithm as `diff/rust/src/main.rs`).
fn canon(s : Bytes) -> String {
  let n = s.length()
  if n < 12 {
    return "OK " + n.to_string() + " short"
  }
  // whole-font checksum over the zero-padded file
  let mut sum : UInt = 0U
  let mut i = 0
  while i < n {
    let mut w : UInt = 0U
    let mut k = 0
    while k < 4 {
      let v = if i + k < n { s[i + k].to_int() } else { 0 }
      w = (w << 8) | v.to_uint()
      k = k + 1
    }
    sum = sum + w
    i = i + 4
  }
  let nt = rd16(s, 4)
  let sb = StringBuilder::new()
  sb.write_string("OK " + n.to_string() + " ck=" + (if sum == 0xB1B0AFBAU { "ok" } else { "bad" }))
  let mut t = 0
  while t < nt {
    let rec = 12 + t * 16
    if rec + 16 > n {
      sb.write_string(" dirtrunc")
      return sb.to_string()
    }
    let tag = rd32(s, rec)
    let off = rd32(s, rec + 8).to_int()
    let len = rd32(s, rec + 12).to_int()
    sb.write_string(" " + tag_str(tag) + ":" + len.to_string() + ":")
    if off < 0 || len < 0 || off.to_int64() + len.to_int64() > n.to_int64() {
      sb.write_string("oob")
    } else {
      let mut h : UInt64 = 14695981039346656037UL
      let mut j = 0
      while j < len {
        let v = if tag == 0x68656164U && j >= 8 && j < 12 { 0 } else { s[off + j].to_int() }
        h = (h ^ v.to_int64().to_uint64()) * 1099511628211UL
        j = j + 1
      }
      sb.write_string(hex(h, 16))
    }
    t = t + 1
  }
  sb.to_string()
}

///|
fn result_line(r : Result[Bytes, woff2::WoffError]) -> String {
  match r {
    Ok(out) => canon(out)
    Err(e) => "ERR " + err_name(e)
  }
}

///|
fn limits_from(args : Array[String], at : Int) -> woff2::DecodeLimits {
  if args.length() >= at + 3 {
    woff2::DecodeLimits::new(parse_int(args[at]), parse_int(args[at + 1]), parse_int(args[at + 2]))
  } else {
    woff2::DecodeLimits::default()
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: woff2_audit <batch|file|bench|brotli|zlib> ...")
    return 2
  }
  let mode = args[1]
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => return 3
  }
  if mode == "batch" {
    let lim = limits_from(args, 3)
    let n = data.length()
    let mut p = 0
    while p + 4 <= n {
      let len = read_u32le(data, p)
      p = p + 4
      let rec = data.slice(p, p + len)
      p = p + len
      io_println(world, result_line(woff2::decode_with_limits(rec, lim)))
    }
    return 0
  }
  if mode == "file" {
    let r = woff2::decode_with_limits(data, limits_from(args, 3))
    match r {
      Ok(_) => io_println(world, result_line(r))
      Err(e) => io_println(world, result_line(r) + " " + woff2::woff_error_message(e))
    }
    if args.length() >= 7 {
      match r {
        Ok(out) => {
          let _ = fs_write_bytes(world, args[6], out)
        }
        Err(_) => ()
      }
    }
    return 0
  }
  let iters = if args.length() >= 4 { parse_int(args[3]) } else { 1 }
  if mode == "bench" {
    let mut last = Bytes::new(0)
    let mut i = 0
    while i < iters {
      match woff2::decode(data) {
        Ok(out) => last = out
        Err(e) => {
          io_println(world, "ERR " + err_name(e))
          return 1
        }
      }
      i = i + 1
    }
    io_println(world, canon(last))
    return 0
  }
  if mode == "brotli" {
    // WOFF2: skip the table directory and Brotli-decode only the compressed stream.
    let nt = rd16(data, 12)
    let comp = rd32(data, 20).to_int()
    let mut p = 48
    let mut t = 0
    while t < nt {
      let f = data[p].to_int()
      p = p + 1
      if (f & 0x3F) == 0x3F {
        p = p + 4
      }
      let tag_idx = f & 0x3F
      let ver = (f >> 6) & 3
      let mut reads = 1
      if (tag_idx == 10 || tag_idx == 11) && ver == 0 {
        reads = 2
      } else if tag_idx == 3 && ver == 1 {
        reads = 2
      }
      while reads > 0 {
        while (data[p].to_int() & 0x80) != 0 {
          p = p + 1
        }
        p = p + 1
        reads = reads - 1
      }
      t = t + 1
    }
    let slice = data.slice(p, p + comp)
    let mut total = 0
    let mut i = 0
    while i < iters {
      match brotli::decode(slice) {
        Ok(out) => total = out.length()
        Err(_) => return 1
      }
      i = i + 1
    }
    io_println(world, "brotli " + total.to_string())
    return 0
  }
  if mode == "zlib" {
    let nt = rd16(data, 12)
    let mut total = 0
    let mut i = 0
    while i < iters {
      let mut t = 0
      while t < nt {
        let rec = 44 + t * 20
        let off = rd32(data, rec + 4).to_int()
        let comp = rd32(data, rec + 8).to_int()
        let orig = rd32(data, rec + 12).to_int()
        if comp < orig {
          match flate::zlib_decompress_with_limit(data.slice(off, off + comp), orig) {
            Ok(out) => total = total + out.length()
            Err(_) => return 1
          }
        }
        t = t + 1
      }
      i = i + 1
    }
    io_println(world, "zlib " + total.to_string())
    return 0
  }
  2
}
