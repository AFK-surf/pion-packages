///| WOFF 2.0 and WOFF 1.0 specification compliance, reconstruction, and security tests.

import "flate"

struct IdentityDecompressor {
  dummy : Int
}

impl Decompressor for IdentityDecompressor {
  fn brotli_decode(
    self : IdentityDecompressor,
    data : Bytes,
    max_output_bytes : Int,
  ) -> Result[Bytes, WoffError] {
    let _ = self.dummy
    if max_output_bytes > 0 && data.length() > max_output_bytes {
      return Err(WoffError::LimitExceeded("identity brotli limit"))
    }
    Ok(data)
  }

  fn zlib_decompress(
    self : IdentityDecompressor,
    data : Bytes,
    max_output_bytes : Int,
  ) -> Result[Bytes, WoffError] {
    let _ = self.dummy
    if max_output_bytes > 0 && data.length() > max_output_bytes {
      return Err(WoffError::LimitExceeded("identity zlib limit"))
    }
    Ok(data)
  }
}

fn push_u8(w : Array[Int], v : Int) -> Unit {
  w.push(v & 255)
}

fn push_u16_be(w : Array[Int], v : Int) -> Unit {
  w.push((v >> 8) & 255)
  w.push(v & 255)
}

fn push_u32_be(w : Array[Int], v : Int) -> Unit {
  push_u16_be(w, (v >> 16) & 0xFFFF)
  push_u16_be(w, v & 0xFFFF)
}

fn push_u32_u(w : Array[Int], v : UInt) -> Unit {
  w.push(((v >> 24) & 0xFFU).to_int())
  w.push(((v >> 16) & 0xFFU).to_int())
  w.push(((v >> 8) & 0xFFU).to_int())
  w.push((v & 0xFFU).to_int())
}

fn push_base128(w : Array[Int], v : Int) -> Unit {
  if v < 0x80 {
    w.push(v)
  } else if v < 0x4000 {
    w.push(((v >> 7) & 0x7F) | 0x80)
    w.push(v & 0x7F)
  } else if v < 0x200000 {
    w.push(((v >> 14) & 0x7F) | 0x80)
    w.push(((v >> 7) & 0x7F) | 0x80)
    w.push(v & 0x7F)
  } else {
    w.push(((v >> 21) & 0x7F) | 0x80)
    w.push(((v >> 14) & 0x7F) | 0x80)
    w.push(((v >> 7) & 0x7F) | 0x80)
    w.push(v & 0x7F)
  }
}

fn push_bytes(w : Array[Int], b : Bytes) -> Unit {
  let mut i = 0
  while i < b.length() {
    w.push(b[i].to_int())
    i = i + 1
  }
}

fn arr_to_bytes(a : Array[Int]) -> Bytes {
  let b = Bytes::new(a.length())
  let mut i = 0
  while i < a.length() {
    b[i] = (a[i] & 255).to_byte()
    i = i + 1
  }
  b
}

fn read_u16_be(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 8) | b[off + 1].to_int()
}

fn read_i16_be(b : Bytes, off : Int) -> Int {
  let v = read_u16_be(b, off)
  if v >= 32768 {
    v - 65536
  } else {
    v
  }
}

fn read_u32_be(b : Bytes, off : Int) -> UInt {
  (b[off].to_int().to_uint() << 24) |
  (b[off + 1].to_int().to_uint() << 16) |
  (b[off + 2].to_int().to_uint() << 8) |
  b[off + 3].to_int().to_uint()
}

///| Compute SFNT table checksum (sum of big-endian u32 words, zero-padded to 4 bytes).
fn sfnt_checksum(b : Bytes, start : Int, len : Int) -> UInt {
  let mut sum : UInt = 0U
  let mut i = 0
  while i + 4 <= len {
    sum = sum + read_u32_be(b, start + i)
    i = i + 4
  }
  if i < len {
    let mut tail : UInt = 0U
    let mut k = 0
    while i + k < len {
      let shift = 24 - k * 8
      tail = tail | (b[start + i + k].to_int().to_uint() << shift)
      k = k + 1
    }
    sum = sum + tail
  }
  sum
}

///| Wrap `payload` into a valid uncompressed Brotli stream (RFC 7932 ISUNCOMPRESSED meta-block).
fn brotli_uncompressed(payload : Bytes) -> Bytes {
  let out : Array[Int] = []
  // WBITS=16 (1 bit: 0), ISLAST=0 (1 bit: 0)
  // For simplicity, write chunks of up to 65535 bytes using 2-byte MLEN (MNIBBLES=4 -> bits 00).
  // Bit layout for first meta-block:
  //   bit 0: WBITS=0 (16)
  //   bit 1: ISLAST=0
  //   bits 2..3: MNIBBLES=00 (4 nibbles = 16-bit MLEN-1)
  //   bits 4..19: MLEN-1 (16 bits)
  //   bit 20: ISUNCOMPRESSED=1
  //   bits 21..23: 0 padding to byte boundary
  //   then raw bytes
  //   then final empty meta-block: ISLAST=1, ISLASTEMPTY=1 -> byte 0x03
  let n = payload.length()
  if n == 0 {
    // WBITS=0, ISLAST=1, ISLASTEMPTY=1 -> 0b00000110 = 0x06
    out.push(0x06)
    return arr_to_bytes(out)
  }
  let mlen_minus1 = n - 1
  // Pack 24 bits (LSB first):
  // bit 0 = 0 (WBITS=16)
  // bit 1 = 0 (ISLAST=0)
  // bits 2..3 = 0 (MNIBBLES=4)
  // bits 4..19 = mlen_minus1
  // bit 20 = 1 (ISUNCOMPRESSED=1)
  // bits 21..23 = 0
  let hdr = (mlen_minus1 << 4) | (1 << 20)
  out.push(hdr & 0xFF)
  out.push((hdr >> 8) & 0xFF)
  out.push((hdr >> 16) & 0xFF)
  push_bytes(out, payload)
  // Final empty meta-block: ISLAST=1, ISLASTEMPTY=1 -> 0x03
  out.push(0x03)
  arr_to_bytes(out)
}

///| Make a valid 54-byte `head` table with `indexToLocFormat`.
fn make_head_table(index_to_loc_format : Int) -> Bytes {
  let b = Bytes::new(54)
  // majorVersion=1, minorVersion=0
  b[1] = (1).to_byte()
  // magicNumber = 0x5F0F3CF5 at offset 12..16
  b[12] = (0x5F).to_byte()
  b[13] = (0x0F).to_byte()
  b[14] = (0x3C).to_byte()
  b[15] = (0xF5).to_byte()
  // unitsPerEm = 1000 (0x03E8) at offset 18..20
  b[18] = (0x03).to_byte()
  b[19] = (0xE8).to_byte()
  // indexToLocFormat at offset 50..52
  b[50] = ((index_to_loc_format >> 8) & 255).to_byte()
  b[51] = (index_to_loc_format & 255).to_byte()
  b
}

///| Make a valid 36-byte `hhea` table with `numOfLongHorMetrics`.
fn make_hhea_table(num_h_metrics : Int) -> Bytes {
  let b = Bytes::new(36)
  b[1] = (1).to_byte()
  b[34] = ((num_h_metrics >> 8) & 255).to_byte()
  b[35] = (num_h_metrics & 255).to_byte()
  b
}

///| Make a valid 6-byte `maxp` v0.5 table with `numGlyphs`.
fn make_maxp_table(num_glyphs : Int) -> Bytes {
  let b = Bytes::new(6)
  b[1] = (1).to_byte()
  b[4] = ((num_glyphs >> 8) & 255).to_byte()
  b[5] = (num_glyphs & 255).to_byte()
  b
}

///| Build a WOFF2 container with given table entries (flags, custom_tag_opt, orig_len, trans_len_opt) and raw uncompressed stream (auto-wrapped in Brotli).
fn build_woff2_header(
  flavor : UInt,
  num_tables : Int,
  total_sfnt_size : Int,
  compressed_len : Int,
  dir_len : Int,
) -> Array[Int] {
  let buf : Array[Int] = []
  let total_len = 48 + dir_len + compressed_len
  push_u32_u(buf, 0x774F4632U) // "wOF2"
  push_u32_u(buf, flavor)
  push_u32_be(buf, total_len)
  push_u16_be(buf, num_tables)
  push_u16_be(buf, 0) // reserved
  push_u32_be(buf, total_sfnt_size)
  push_u32_be(buf, compressed_len)
  push_u16_be(buf, 1) // majorVersion
  push_u16_be(buf, 0) // minorVersion
  push_u32_be(buf, 0) // metaOffset
  push_u32_be(buf, 0) // metaLength
  push_u32_be(buf, 0) // metaOrigLength
  push_u32_be(buf, 0) // privOffset
  push_u32_be(buf, 0) // privLength
  buf
}

// --- 1. Header & Signature Validation Tests ---

test "rejects truncated header and invalid signature" {
  let empty = Bytes::new(0)
  match decode(empty) {
    Err(WoffError::TruncatedHeader(_)) => ()
    _ => debug_assert(false, "expected TruncatedHeader for empty input")
  }

  let raw_ttf = Bytes::new(64)
  raw_ttf[1] = (1).to_byte() // 0x00010000 TrueType
  match decode(raw_ttf) {
    Err(WoffError::InvalidSignature(_)) => ()
    _ => debug_assert(false, "expected InvalidSignature for raw TTF")
  }

  // Truncated WOFF1 (< 44 bytes)
  let short_w1 = Bytes::new(40)
  short_w1[0] = (0x77).to_byte()
  short_w1[1] = (0x4F).to_byte()
  short_w1[2] = (0x46).to_byte()
  short_w1[3] = (0x46).to_byte()
  match decode(short_w1) {
    Err(WoffError::TruncatedHeader(_)) => ()
    _ => debug_assert(false, "expected TruncatedHeader for short WOFF1")
  }

  // Truncated WOFF2 (< 48 bytes)
  let short_w2 = Bytes::new(44)
  short_w2[0] = (0x77).to_byte()
  short_w2[1] = (0x4F).to_byte()
  short_w2[2] = (0x46).to_byte()
  short_w2[3] = (0x32).to_byte()
  match decode(short_w2) {
    Err(WoffError::TruncatedHeader(_)) => ()
    _ => debug_assert(false, "expected TruncatedHeader for short WOFF2")
  }
}

test "woff2 rejects collection flavor ttcf" {
  let buf : Array[Int] = []
  push_u32_u(buf, 0x774F4632U) // "wOF2"
  push_u32_u(buf, 0x74746366U) // "ttcf"
  let mut i = 0
  while i < 40 {
    buf.push(0)
    i = i + 1
  }
  match decode(arr_to_bytes(buf)) {
    Err(WoffError::UnsupportedCollection) => ()
    _ => debug_assert(false, "expected UnsupportedCollection for ttcf")
  }
}

test "woff2 rejects zero tables and non-zero reserved" {
  let buf = build_woff2_header(0x00010000U, 0, 12, 0, 0)
  match decode(arr_to_bytes(buf)) {
    Err(WoffError::InvalidTableDirectory(_)) => ()
    _ => debug_assert(false, "expected InvalidTableDirectory for numTables=0")
  }

  let buf2 = build_woff2_header(0x00010000U, 1, 32, 1, 2)
  // Set reserved != 0 at offset 14..15
  buf2[15] = 1
  buf2.push(0)
  buf2.push(0)
  buf2.push(0x06)
  match decode(arr_to_bytes(buf2)) {
    Err(WoffError::TruncatedHeader(_)) => ()
    Err(WoffError::InvalidTableDirectory(_)) => ()
    _ => debug_assert(false, "expected error for reserved != 0")
  }
}

// --- 2. WOFF 1.0 Tests (Uncompressed + Real Zlib Compressed + Checksums) ---

test "woff1 uncompressed and zlib compressed tables with sorting and checksums" {
  // Tables: "name" (uncompressed, 5 bytes -> padded to 8), "head" (zlib compressed, 54 bytes), "cmap" (zlib compressed, 64 bytes)
  let head_raw = make_head_table(0)
  let head_z = flate::zlib_compress_default(head_raw)
  let cmap_raw = Bytes::new(64)
  cmap_raw[3] = (1).to_byte()
  cmap_raw[4] = (0xAA).to_byte()
  cmap_raw[5] = (0xBB).to_byte()
  cmap_raw[6] = (0xCC).to_byte()
  cmap_raw[7] = (0xDD).to_byte()
  let cmap_z = flate::zlib_compress_default(cmap_raw)
  let name_raw = arr_to_bytes([0x11, 0x22, 0x33, 0x44, 0x55])

  // Header = 44 bytes, 3 directory entries * 20 = 60 bytes -> data starts at 104
  let off_name = 104
  let off_head = off_name + ((name_raw.length() + 3) / 4) * 4
  let off_cmap = off_head + ((head_z.length() + 3) / 4) * 4
  let total_len = off_cmap + ((cmap_z.length() + 3) / 4) * 4

  let buf : Array[Int] = []
  push_u32_u(buf, 0x774F4646U) // "wOFF"
  push_u32_u(buf, 0x00010000U) // TrueType flavor
  push_u32_be(buf, total_len)
  push_u16_be(buf, 3) // numTables
  push_u16_be(buf, 0) // reserved
  push_u32_be(buf, 12 + 3 * 16 + 8 + 56 + 8) // totalSfntSize
  push_u16_be(buf, 1)
  push_u16_be(buf, 0)
  push_u32_be(buf, 0)
  push_u32_be(buf, 0)
  push_u32_be(buf, 0)
  push_u32_be(buf, 0)
  push_u32_be(buf, 0)

  // Intentionally unsorted directory: name, head, cmap
  // Entry 0: "name" (uncompressed: comp == orig)
  push_u32_u(buf, 0x6E616D65U)
  push_u32_be(buf, off_name)
  push_u32_be(buf, name_raw.length())
  push_u32_be(buf, name_raw.length())
  push_u32_be(buf, 0)

  // Entry 1: "head" (zlib compressed)
  push_u32_u(buf, 0x68656164U)
  push_u32_be(buf, off_head)
  push_u32_be(buf, head_z.length())
  push_u32_be(buf, head_raw.length())
  push_u32_be(buf, 0)

  // Entry 2: "cmap" (zlib compressed)
  push_u32_u(buf, 0x636D6170U)
  push_u32_be(buf, off_cmap)
  push_u32_be(buf, cmap_z.length())
  push_u32_be(buf, cmap_raw.length())
  push_u32_be(buf, 0)

  push_bytes(buf, name_raw)
  while buf.length() % 4 != 0 {
    buf.push(0)
  }
  push_bytes(buf, head_z)
  while buf.length() % 4 != 0 {
    buf.push(0)
  }
  push_bytes(buf, cmap_z)
  while buf.length() % 4 != 0 {
    buf.push(0)
  }

  let woff = arr_to_bytes(buf)
  let sfnt = match decode(woff) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "woff1 decode failed: " + woff_error_message(e))
      Bytes::new(0)
    }
  }

  // Verify SFNT header
  debug_assert(read_u32_be(sfnt, 0) == 0x00010000U, "sfnt flavor")
  debug_assert(read_u16_be(sfnt, 4) == 3, "3 tables")
  debug_assert(read_u16_be(sfnt, 6) == 32, "searchRange = 2 * 16")
  debug_assert(read_u16_be(sfnt, 8) == 1, "entrySelector = 1")
  debug_assert(read_u16_be(sfnt, 10) == 16, "rangeShift = 3*16 - 32")

  // Sorted order: cmap (12), head (28), name (44)
  debug_assert(read_u32_be(sfnt, 12) == 0x636D6170U, "table 0 cmap")
  debug_assert(read_u32_be(sfnt, 28) == 0x68656164U, "table 1 head")
  debug_assert(read_u32_be(sfnt, 44) == 0x6E616D65U, "table 2 name")

  // Verify each table's payload and 4-byte alignment
  let cmap_off = read_u32_be(sfnt, 20).to_int()
  let cmap_len = read_u32_be(sfnt, 24).to_int()
  debug_assert(cmap_off % 4 == 0 && cmap_len == 64, "cmap aligned and len 64")
  debug_assert(sfnt[cmap_off + 4].to_int() == 0xAA, "cmap byte 4")
  debug_assert(
    read_u32_be(sfnt, 16) == sfnt_checksum(sfnt, cmap_off, cmap_len),
    "cmap checksum exact",
  )

  let name_off = read_u32_be(sfnt, 52).to_int()
  let name_len = read_u32_be(sfnt, 56).to_int()
  debug_assert(name_off % 4 == 0 && name_len == 5, "name aligned and len 5")
  debug_assert(sfnt[name_off + 4].to_int() == 0x55, "name byte 4")
  debug_assert(
    read_u32_be(sfnt, 48) == sfnt_checksum(sfnt, name_off, name_len),
    "name checksum exact",
  )

  // Verify whole-font SFNT checksum == 0xB1B0AFBA
  let total_cs = sfnt_checksum(sfnt, 0, sfnt.length())
  debug_assert(total_cs == 0xB1B0AFBAU, "whole font checkSumAdjustment == 0xB1B0AFBA")
}

test "woff1 rejects bad zlib stream and compLength > origLength" {
  let buf : Array[Int] = []
  push_u32_u(buf, 0x774F4646U)
  push_u32_u(buf, 0x00010000U)
  push_u32_be(buf, 72)
  push_u16_be(buf, 1)
  push_u16_be(buf, 0)
  push_u32_be(buf, 64)
  push_u16_be(buf, 1)
  push_u16_be(buf, 0)
  push_u32_be(buf, 0)
  push_u32_be(buf, 0)
  push_u32_be(buf, 0)
  push_u32_be(buf, 0)
  push_u32_be(buf, 0)
  // Entry: comp=8 > orig=4 -> BoundsExceeded / InvalidTableDirectory
  push_u32_u(buf, 0x636D6170U)
  push_u32_be(buf, 64)
  push_u32_be(buf, 8)
  push_u32_be(buf, 4)
  push_u32_be(buf, 0)
  let mut i = 0
  while i < 8 {
    buf.push(0xFF)
    i = i + 1
  }
  match decode(arr_to_bytes(buf)) {
    Err(WoffError::InvalidTableDirectory(_)) => ()
    Err(WoffError::BoundsExceeded(_)) => ()
    _ => debug_assert(false, "expected error for compLength > origLength")
  }

  // Corrupted zlib payload (comp < orig, invalid zlib FCHECK)
  let buf2 : Array[Int] = []
  push_u32_u(buf2, 0x774F4646U)
  push_u32_u(buf2, 0x00010000U)
  push_u32_be(buf2, 72)
  push_u16_be(buf2, 1)
  push_u16_be(buf2, 0)
  push_u32_be(buf2, 128)
  push_u16_be(buf2, 1)
  push_u16_be(buf2, 0)
  push_u32_be(buf2, 0)
  push_u32_be(buf2, 0)
  push_u32_be(buf2, 0)
  push_u32_be(buf2, 0)
  push_u32_be(buf2, 0)
  push_u32_u(buf2, 0x636D6170U)
  push_u32_be(buf2, 64)
  push_u32_be(buf2, 8)
  push_u32_be(buf2, 32)
  push_u32_be(buf2, 0)
  i = 0
  while i < 8 {
    buf2.push(0xFF)
    i = i + 1
  }
  match decode(arr_to_bytes(buf2)) {
    Err(WoffError::ZlibError(_)) => ()
    _ => debug_assert(false, "expected ZlibError for corrupted zlib table")
  }
}

// --- 3. WOFF 2.0 Known/Custom Tags & UIntBase128 Strictness ---

test "woff2 known tags, custom tag, and real brotli stream" {
  let payload = arr_to_bytes([
    0xDE, 0xAD, 0xBE, 0xEF, // cmap (known tag 0)
    0x01, 0x02, 0x03, 0x04, // Sill (known tag 62)
    0xCA, 0xFE, 0xBA, 0xBE, // custom tag "TEST"
  ])
  let br = brotli_uncompressed(payload)
  let dir : Array[Int] = []
  // Entry 0: custom tag "TEST" (0x3F), origLen=4
  dir.push(0x3F)
  push_u32_u(dir, 0x54455354U)
  push_base128(dir, 4)
  // Entry 1: known tag 62 ("Sill"), origLen=4
  dir.push(62)
  push_base128(dir, 4)
  // Entry 2: known tag 0 ("cmap"), origLen=4
  dir.push(0)
  push_base128(dir, 4)

  // Reorder payload to match directory order: TEST, Sill, cmap
  let payload2 = arr_to_bytes([
    0xCA, 0xFE, 0xBA, 0xBE,
    0x01, 0x02, 0x03, 0x04,
    0xDE, 0xAD, 0xBE, 0xEF,
  ])
  let br2 = brotli_uncompressed(payload2)
  let _ = br
  let buf = build_woff2_header(0x4F54544FU, 3, 12 + 48 + 12, br2.length(), dir.length())
  push_bytes(buf, arr_to_bytes(dir))
  push_bytes(buf, br2)

  let sfnt = match decode(arr_to_bytes(buf)) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "woff2 decode failed: " + woff_error_message(e))
      Bytes::new(0)
    }
  }

  // OTF flavor "OTTO"
  debug_assert(read_u32_be(sfnt, 0) == 0x4F54544FU, "OTTO flavor")
  debug_assert(read_u16_be(sfnt, 4) == 3, "3 tables")
  // Sorted ASCII tag order: "Sill" (0x53696C6C) < "TEST" (0x54455354) < "cmap" (0x636D6170)
  debug_assert(read_u32_be(sfnt, 12) == 0x53696C6CU, "table 0 Sill")
  debug_assert(read_u32_be(sfnt, 28) == 0x54455354U, "table 1 TEST")
  debug_assert(read_u32_be(sfnt, 44) == 0x636D6170U, "table 2 cmap")
  let sill_off = read_u32_be(sfnt, 20).to_int()
  let test_off = read_u32_be(sfnt, 36).to_int()
  let cmap_off = read_u32_be(sfnt, 52).to_int()
  debug_assert(sfnt[sill_off].to_int() == 0x01, "Sill byte 0")
  debug_assert(sfnt[test_off].to_int() == 0xCA, "TEST byte 0")
  debug_assert(sfnt[cmap_off].to_int() == 0xDE, "cmap byte 0")
}

test "woff2 rejects UIntBase128 leading zero, overflow, and >5 bytes" {
  // Leading zero: 0x80 0x04
  let dir1 = arr_to_bytes([0, 0x80, 0x04])
  let br = brotli_uncompressed(arr_to_bytes([1, 2, 3, 4]))
  let buf1 = build_woff2_header(0x00010000U, 1, 32, br.length(), dir1.length())
  push_bytes(buf1, dir1)
  push_bytes(buf1, br)
  match decode(arr_to_bytes(buf1)) {
    Err(WoffError::InvalidVarInt(_)) => ()
    _ => debug_assert(false, "expected InvalidVarInt for UIntBase128 leading zero")
  }

  // Overflow (> 0xFFFFFFFF): 0x90 0x80 0x80 0x80 0x00
  let dir2 = arr_to_bytes([0, 0x90, 0x80, 0x80, 0x80, 0x00])
  let buf2 = build_woff2_header(0x00010000U, 1, 32, br.length(), dir2.length())
  push_bytes(buf2, dir2)
  push_bytes(buf2, br)
  match decode(arr_to_bytes(buf2)) {
    Err(WoffError::InvalidVarInt(_)) => ()
    _ => debug_assert(false, "expected InvalidVarInt for UIntBase128 uint32 overflow")
  }

  // More than 5 bytes: 0x81 0x81 0x81 0x81 0x81 0x00
  let dir3 = arr_to_bytes([0, 0x81, 0x81, 0x81, 0x81, 0x81, 0x00])
  let buf3 = build_woff2_header(0x00010000U, 1, 32, br.length(), dir3.length())
  push_bytes(buf3, dir3)
  push_bytes(buf3, br)
  match decode(arr_to_bytes(buf3)) {
    Err(WoffError::InvalidVarInt(_)) => ()
    _ => debug_assert(false, "expected InvalidVarInt for UIntBase128 >5 bytes")
  }
}

// --- 4. WOFF 2.0 glyf + loca + hmtx Transformation Reconstruction ---

///| Build a transformed glyf stream with 3 glyphs:
///|   glyph 0: empty (0 contours)
///|   glyph 1: simple glyph (1 contour, 3 points: (10, 20) on-curve, (110, 20) on-curve, (60, 120) off-curve, 2-byte instructions [0xAA, 0xBB], overlap=true)
///|   glyph 2: composite glyph referencing glyph 1 with explicit bbox (0, 0, 120, 130) and 1-byte instruction [0xCC]
fn make_transformed_glyf(index_format : Int) -> Bytes {
  // 0: nContourStream (3 * i16): 0, 1, -1
  let s_ncont : Array[Int] = []
  push_u16_be(s_ncont, 0)
  push_u16_be(s_ncont, 1)
  push_u16_be(s_ncont, 0xFFFF)

  // 1: nPointsStream (255UInt16): glyph 1 has 3 points
  let s_npts : Array[Int] = [3]

  // 2: flagStream + 3: glyphStream
  // Point 0: (10, 20) on-curve -> dx=+10, dy=+20
  //   triplet f=23 (b0=3: dx_sign=1, dy_sign=1, dx_hi=0, dy_hi=0):
  //   Wait: for f in 20..83: b0 = f - 20.
  //   dx = sign(f, 1 + (b0 & 0x30) + (b1 >> 4)), dy = sign(f>>1, 1 + ((b0 & 0x0c) << 2) + (b1 & 0x0f))
  //   Let's use f=87 (range 84..119, 2 extra bytes):
  //     b0 = 87 - 84 = 3 -> dx_sign = 87&1 = 1 (+), dy_sign = (87>>1)&1 = 1 (+),
  //     b0/12 = 0, (b0%12)>>2 = 0 -> dx = 1 + a, dy = 1 + c2 -> a=9 (dx=10), c2=19 (dy=20)
  //     on-curve => bit 7 = 0 -> flag byte = 87
  // Point 1: (110, 20) on-curve -> dx=+100, dy=0
  //   range 10..19: f=11 -> dx = +( ((1 & 14)<<7) + b0 ) = +b0 -> b0=100, on-curve => flag byte = 11
  // Point 2: (60, 120) off-curve -> dx=-50, dy=+100
  //   range 84..119: f=86 -> b0=2, dx_sign=0 (-), dy_sign=1 (+), a=49 (dx=-50), c2=99 (dy=+100)
  //   off-curve => bit 7 = 1 -> flag byte = 0x80 | 86 = 214
  let s_flags : Array[Int] = [87, 11, 214]
  let s_glyph : Array[Int] = [
    9, 19, // point 0
    100, // point 1
    49, 99, // point 2
    2, // glyph 1 instruction length (255UInt16)
    1, // glyph 2 composite instruction length (255UInt16)
  ]

  // 4: compositeStream: flags = 0x0102 (WE_HAVE_INSTRUCTIONS | ARGS_ARE_XY_VALUES), glyphIndex = 1, arg1=5, arg2=10
  let s_comp : Array[Int] = []
  push_u16_be(s_comp, 0x0102)
  push_u16_be(s_comp, 1)
  s_comp.push(5)
  s_comp.push(10)

  // 5: bboxStream: bitmap_len = ((3 + 31) >> 5) << 2 = 4 bytes
  //   Only glyph 2 has explicit bbox -> bit 2 (0x80 >> 2 = 0x20) in byte 0
  let s_bbox : Array[Int] = [0x20, 0x00, 0x00, 0x00]
  push_u16_be(s_bbox, 5) // xMin = 5
  push_u16_be(s_bbox, 0) // yMin = 0
  push_u16_be(s_bbox, 120) // xMax = 120
  push_u16_be(s_bbox, 130) // yMax = 130

  // 6: instructionStream: 2 bytes for glyph 1 + 1 byte for glyph 2
  let s_instr : Array[Int] = [0xAA, 0xBB, 0xCC]

  // overlapSimpleBitmap (optionFlags bit 0 = 1): ceil(3/8) = 1 byte
  //   glyph 1 has overlap -> bit 1 (0x80 >> 1 = 0x40)
  let s_overlap : Array[Int] = [0x40]

  let out : Array[Int] = []
  push_u16_be(out, 0) // reserved = 0
  push_u16_be(out, 1) // optionFlags = 1 (overlapSimpleBitmap present)
  push_u16_be(out, 3) // numGlyphs = 3
  push_u16_be(out, index_format) // 0=short loca, 1=long loca
  push_u32_be(out, s_ncont.length())
  push_u32_be(out, s_npts.length())
  push_u32_be(out, s_flags.length())
  push_u32_be(out, s_glyph.length())
  push_u32_be(out, s_comp.length())
  push_u32_be(out, s_bbox.length())
  push_u32_be(out, s_instr.length())
  push_bytes(out, arr_to_bytes(s_ncont))
  push_bytes(out, arr_to_bytes(s_npts))
  push_bytes(out, arr_to_bytes(s_flags))
  push_bytes(out, arr_to_bytes(s_glyph))
  push_bytes(out, arr_to_bytes(s_comp))
  push_bytes(out, arr_to_bytes(s_bbox))
  push_bytes(out, arr_to_bytes(s_instr))
  push_bytes(out, arr_to_bytes(s_overlap))
  arr_to_bytes(out)
}

test "woff2 transformed glyf, short/long loca, and transformed hmtx" {
  // Test both indexFormat=0 (short loca) and indexFormat=1 (long loca)
  let mut fmt_idx = 0
  while fmt_idx < 2 {
    let head = make_head_table(fmt_idx)
    let hhea = make_hhea_table(2) // 2 proportional metrics, 1 monospace
    let maxp = make_maxp_table(3) // 3 glyphs
    let glyf_t = make_transformed_glyf(fmt_idx)

    // Transformed hmtx: flags = 3 (both proportional and monospace lsb taken from glyf xMins: [0, 10, 5])
    // advanceWidths for 2 proportional metrics: [500, 600]
    let hmtx_arr : Array[Int] = [3]
    push_u16_be(hmtx_arr, 500)
    push_u16_be(hmtx_arr, 600)
    let hmtx_t = arr_to_bytes(hmtx_arr)

    let raw_stream : Array[Int] = []
    push_bytes(raw_stream, head)
    push_bytes(raw_stream, hhea)
    push_bytes(raw_stream, hmtx_t)
    push_bytes(raw_stream, maxp)
    push_bytes(raw_stream, glyf_t)
    let br = brotli_uncompressed(arr_to_bytes(raw_stream))

    // Table directory (6 tables: head, hhea, hmtx(transformed v1), maxp, glyf(transformed v0), loca(transformed v0))
    let dir : Array[Int] = []
    // head (tag idx 1, v0 untransformed)
    dir.push(1)
    push_base128(dir, head.length())
    // hhea (tag idx 2, v0 untransformed)
    dir.push(2)
    push_base128(dir, hhea.length())
    // hmtx (tag idx 3, v1 transformed -> flags = (1 << 6) | 3 = 67)
    dir.push(67)
    push_base128(dir, 10) // origLen = 2*4 + 1*2 = 10
    push_base128(dir, hmtx_t.length())
    // maxp (tag idx 4, v0 untransformed)
    dir.push(4)
    push_base128(dir, maxp.length())
    // glyf (tag idx 10, v0 transformed)
    dir.push(10)
    push_base128(dir, 128) // origLen estimate
    push_base128(dir, glyf_t.length())
    // loca (tag idx 11, v0 transformed, transformLength MUST be 0)
    dir.push(11)
    push_base128(dir, if fmt_idx == 0 { 8 } else { 16 })
    push_base128(dir, 0)

    let buf = build_woff2_header(0x00010000U, 6, 512, br.length(), dir.length())
    push_bytes(buf, arr_to_bytes(dir))
    push_bytes(buf, br)

    let sfnt = match decode(arr_to_bytes(buf)) {
      Ok(s) => s
      Err(e) => {
        debug_assert(false, "woff2 glyf/hmtx decode failed: " + woff_error_message(e))
        Bytes::new(0)
      }
    }

    // Locate tables in sorted SFNT directory: glyf, head, hhea, hmtx, loca, maxp
    debug_assert(read_u16_be(sfnt, 4) == 6, "6 tables")
    debug_assert(read_u32_be(sfnt, 12) == 0x676C7966U, "table 0 glyf")
    debug_assert(read_u32_be(sfnt, 28) == 0x68656164U, "table 1 head")
    debug_assert(read_u32_be(sfnt, 44) == 0x68686561U, "table 2 hhea")
    debug_assert(read_u32_be(sfnt, 60) == 0x686D7478U, "table 3 hmtx")
    debug_assert(read_u32_be(sfnt, 76) == 0x6C6F6361U, "table 4 loca")
    debug_assert(read_u32_be(sfnt, 92) == 0x6D617870U, "table 5 maxp")

    let glyf_off = read_u32_be(sfnt, 20).to_int()
    let head_off = read_u32_be(sfnt, 36).to_int()
    let hmtx_off = read_u32_be(sfnt, 68).to_int()
    let hmtx_len = read_u32_be(sfnt, 72).to_int()
    let loca_off = read_u32_be(sfnt, 84).to_int()
    let loca_len = read_u32_be(sfnt, 88).to_int()

    // Check head.indexToLocFormat matches fmt_idx
    debug_assert(read_u16_be(sfnt, head_off + 50) == fmt_idx, "head.indexToLocFormat")

    // Check loca length and offsets
    let (g0, g1, g2, g3) = if fmt_idx == 0 {
      debug_assert(loca_len == 8, "short loca len = (3+1)*2")
      (
        read_u16_be(sfnt, loca_off) * 2,
        read_u16_be(sfnt, loca_off + 2) * 2,
        read_u16_be(sfnt, loca_off + 4) * 2,
        read_u16_be(sfnt, loca_off + 6) * 2,
      )
    } else {
      debug_assert(loca_len == 16, "long loca len = (3+1)*4")
      (
        read_u32_be(sfnt, loca_off).to_int(),
        read_u32_be(sfnt, loca_off + 4).to_int(),
        read_u32_be(sfnt, loca_off + 8).to_int(),
        read_u32_be(sfnt, loca_off + 12).to_int(),
      )
    }
    debug_assert(g0 == 0 && g1 == 0, "glyph 0 is empty")
    debug_assert(g2 > g1 && g3 > g2, "glyph 1 and glyph 2 non-empty")

    // Check glyph 1 (simple): nContours=1, computed bbox=(10, 20, 110, 120), overlap bit 0x40 on flag 0
    debug_assert(read_i16_be(sfnt, glyf_off + g1) == 1, "g1 nContours")
    debug_assert(read_i16_be(sfnt, glyf_off + g1 + 2) == 10, "g1 xMin")
    debug_assert(read_i16_be(sfnt, glyf_off + g1 + 4) == 20, "g1 yMin")
    debug_assert(read_i16_be(sfnt, glyf_off + g1 + 6) == 110, "g1 xMax")
    debug_assert(read_i16_be(sfnt, glyf_off + g1 + 8) == 120, "g1 yMax")
    // endPtsOfContours[0] = 2, instrLen = 2, instrs = 0xAA, 0xBB, flag[0] has 0x40 (overlap) | 0x01 (on-curve)
    debug_assert(read_u16_be(sfnt, glyf_off + g1 + 10) == 2, "g1 endPt")
    debug_assert(read_u16_be(sfnt, glyf_off + g1 + 12) == 2, "g1 instrLen")
    debug_assert(sfnt[glyf_off + g1 + 14].to_int() == 0xAA, "g1 instr 0")
    debug_assert((sfnt[glyf_off + g1 + 16].to_int() & 0x41) == 0x41, "g1 overlap + on-curve")

    // Check glyph 2 (composite): nContours=-1, bbox=(5, 0, 120, 130)
    debug_assert(read_i16_be(sfnt, glyf_off + g2) == -1, "g2 composite")
    debug_assert(read_i16_be(sfnt, glyf_off + g2 + 2) == 5, "g2 xMin")
    debug_assert(read_u16_be(sfnt, glyf_off + g2 + 10) == 0x0102, "g2 comp flags")
    debug_assert(read_u16_be(sfnt, glyf_off + g2 + 12) == 1, "g2 comp glyphIdx")
    // instruction length = 1, instruction = 0xCC
    debug_assert(read_u16_be(sfnt, glyf_off + g2 + 16) == 1, "g2 instrLen")
    debug_assert(sfnt[glyf_off + g2 + 18].to_int() == 0xCC, "g2 instr 0")

    // Check reconstructed hmtx: (500, 0), (600, 10), (lsb=5)
    debug_assert(hmtx_len == 10, "hmtx length = 10")
    debug_assert(read_u16_be(sfnt, hmtx_off) == 500, "adv 0")
    debug_assert(read_i16_be(sfnt, hmtx_off + 2) == 0, "lsb 0 from xMin 0")
    debug_assert(read_u16_be(sfnt, hmtx_off + 4) == 600, "adv 1")
    debug_assert(read_i16_be(sfnt, hmtx_off + 6) == 10, "lsb 1 from xMin 1")
    debug_assert(read_i16_be(sfnt, hmtx_off + 8) == 5, "lsb 2 from xMin 2")

    // Verify whole-font checksum == 0xB1B0AFBA
    debug_assert(
      sfnt_checksum(sfnt, 0, sfnt.length()) == 0xB1B0AFBAU,
      "woff2 whole font checkSumAdjustment == 0xB1B0AFBA",
    )

    fmt_idx = fmt_idx + 1
  }
}

// --- 5. DecodeLimits & Font-Bomb Security Tests ---

test "decode_with_limits enforces max_tables, max_glyphs, and max_output_bytes" {
  // 1. max_tables exceeded in WOFF2
  let br = brotli_uncompressed(arr_to_bytes([1, 2, 3, 4, 5, 6, 7, 8]))
  let dir = arr_to_bytes([0, 4, 1, 4])
  let buf = build_woff2_header(0x00010000U, 2, 64, br.length(), dir.length())
  push_bytes(buf, dir)
  push_bytes(buf, br)
  match decode_with_limits(arr_to_bytes(buf), DecodeLimits::new(65536, 1, 1000)) {
    Err(WoffError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_tables=1")
  }

  // 2. max_output_bytes exceeded in WOFF1 zlib bomb
  let big_raw = Bytes::new(4096)
  let big_z = flate::zlib_compress_default(big_raw)
  let w1 : Array[Int] = []
  push_u32_u(w1, 0x774F4646U)
  push_u32_u(w1, 0x00010000U)
  push_u32_be(w1, 64 + big_z.length())
  push_u16_be(w1, 1)
  push_u16_be(w1, 0)
  push_u32_be(w1, 4128)
  push_u16_be(w1, 1)
  push_u16_be(w1, 0)
  push_u32_be(w1, 0)
  push_u32_be(w1, 0)
  push_u32_be(w1, 0)
  push_u32_be(w1, 0)
  push_u32_be(w1, 0)
  push_u32_u(w1, 0x636D6170U)
  push_u32_be(w1, 64)
  push_u32_be(w1, big_z.length())
  push_u32_be(w1, 4096)
  push_u32_be(w1, 0)
  push_bytes(w1, big_z)
  match decode_with_limits(arr_to_bytes(w1), DecodeLimits::new(1024, 16, 1000)) {
    Err(WoffError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for WOFF1 output limit")
  }

  // 3. max_glyphs exceeded in WOFF2 glyf
  let glyf_t = make_transformed_glyf(1)
  let br_g = brotli_uncompressed(glyf_t)
  let dir_g : Array[Int] = [10]
  push_base128(dir_g, 128)
  push_base128(dir_g, glyf_t.length())
  dir_g.push(11)
  push_base128(dir_g, 16)
  push_base128(dir_g, 0)
  let buf_g = build_woff2_header(0x00010000U, 2, 256, br_g.length(), dir_g.length())
  push_bytes(buf_g, arr_to_bytes(dir_g))
  push_bytes(buf_g, br_g)
  match decode_with_limits(arr_to_bytes(buf_g), DecodeLimits::new(65536, 16, 2)) {
    Err(WoffError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_glyphs=2")
  }
}

test "decode_using supports custom Decompressor" {
  let payload = arr_to_bytes([0x12, 0x34, 0x56, 0x78])
  let dir = arr_to_bytes([0, 4])
  let buf = build_woff2_header(0x00010000U, 1, 32, payload.length(), dir.length())
  push_bytes(buf, dir)
  push_bytes(buf, payload)
  let dec = IdentityDecompressor::{ dummy: 0 }
  match decode_using(arr_to_bytes(buf), dec, DecodeLimits::default()) {
    Ok(sfnt) => {
      let off = read_u32_be(sfnt, 20).to_int()
      debug_assert(sfnt[off].to_int() == 0x12 && sfnt[off + 3].to_int() == 0x78, "custom dec")
    }
    Err(e) => debug_assert(false, woff_error_message(e))
  }
}

test "woff2 rejects composite glyph without explicit bbox and duplicate tags" {
  // Duplicate tag "cmap" (index 0 twice)
  let br = brotli_uncompressed(arr_to_bytes([1, 2, 3, 4, 5, 6, 7, 8]))
  let dir = arr_to_bytes([0, 4, 0, 4])
  let buf = build_woff2_header(0x00010000U, 2, 64, br.length(), dir.length())
  push_bytes(buf, dir)
  push_bytes(buf, br)
  match decode(arr_to_bytes(buf)) {
    Err(WoffError::InvalidTableDirectory(_)) => ()
    _ => debug_assert(false, "expected InvalidTableDirectory for duplicate tag")
  }

  // Composite glyph without explicit bbox
  let g = make_transformed_glyf(1)
  // Clear bbox bitmap byte (first byte of stream 5) -> find offset:
  // Header = 8 + 7*4 = 36, s_ncont=6, s_npts=1, s_flags=3, s_glyph=7, s_comp=6 -> stream 5 starts at 36+23 = 59
  let g_bad = g.slice(0, g.length())
  g_bad[59] = (0).to_byte()
  let br_b = brotli_uncompressed(g_bad)
  let dir_b : Array[Int] = [10]
  push_base128(dir_b, 128)
  push_base128(dir_b, g_bad.length())
  dir_b.push(11)
  push_base128(dir_b, 16)
  push_base128(dir_b, 0)
  let buf_b = build_woff2_header(0x00010000U, 2, 256, br_b.length(), dir_b.length())
  push_bytes(buf_b, arr_to_bytes(dir_b))
  push_bytes(buf_b, br_b)
  match decode(arr_to_bytes(buf_b)) {
    Err(WoffError::GlyfReconstructionError(_)) => ()
    _ => debug_assert(false, "expected GlyfReconstructionError for composite without bbox")
  }
}

test "woff2 rejects corrupted brotli stream and tests all triplet ranges + explicit simple bbox" {
  // 1. Corrupted Brotli stream
  let bad_br = arr_to_bytes([0xFF, 0xFF, 0xFF, 0xFF])
  let dir0 = arr_to_bytes([0, 4])
  let buf0 = build_woff2_header(0x00010000U, 1, 32, bad_br.length(), dir0.length())
  push_bytes(buf0, dir0)
  push_bytes(buf0, bad_br)
  match decode(arr_to_bytes(buf0)) {
    Err(WoffError::BrotliError(_)) => ()
    _ => debug_assert(false, "expected BrotliError for corrupted brotli stream")
  }

  // 2. Simple glyph exercising all 6 triplet flag ranges (<10, <20, <84, <120, <124, >=124) + explicit bbox
  let s_ncont : Array[Int] = []
  push_u16_be(s_ncont, 1) // 1 contour
  let s_npts : Array[Int] = [6] // 6 points
  // Pt0: f=1 (<10: dx=0, dy=+50) -> b0=50
  // Pt1: f=11 (<20: dx=+40, dy=0) -> b0=40
  // Pt2: f=23 (<84: b0=3 -> dx=+(1+0+2)=+3, dy=+(1+0+4)=+5) -> b1=0x24
  // Pt3: f=87 (<120: b0=3 -> dx=+(1+10)=+11, dy=+(1+20)=+21) -> a=10, c2=20
  // Pt4: f=123 (<124: dx=+(0x123)=+291, dy=+(0x456)=+1110) -> a=0x12, b2=0x34, c2=0x56
  // Pt5: f=127 (>=124: dx=+300, dy=+400) -> u16(300), u16(400)
  let s_flags : Array[Int] = [1, 11, 23, 87, 123, 127]
  let s_glyph : Array[Int] = [
    50,
    40,
    0x24,
    10, 20,
    0x12, 0x34, 0x56,
    1, 44, 1, 144, // 300, 400
    0, // 0 instructions
  ]
  let s_comp : Array[Int] = []
  // Explicit bbox on glyph 0 (bit 0 = 0x80)
  let s_bbox : Array[Int] = [0x80, 0x00, 0x00, 0x00]
  push_u16_be(s_bbox, -10)
  push_u16_be(s_bbox, -20)
  push_u16_be(s_bbox, 800)
  push_u16_be(s_bbox, 1600)
  let s_instr : Array[Int] = []

  let gt : Array[Int] = []
  push_u16_be(gt, 0)
  push_u16_be(gt, 0)
  push_u16_be(gt, 1) // 1 glyph
  push_u16_be(gt, 0) // short loca
  push_u32_be(gt, s_ncont.length())
  push_u32_be(gt, s_npts.length())
  push_u32_be(gt, s_flags.length())
  push_u32_be(gt, s_glyph.length())
  push_u32_be(gt, s_comp.length())
  push_u32_be(gt, s_bbox.length())
  push_u32_be(gt, s_instr.length())
  push_bytes(gt, arr_to_bytes(s_ncont))
  push_bytes(gt, arr_to_bytes(s_npts))
  push_bytes(gt, arr_to_bytes(s_flags))
  push_bytes(gt, arr_to_bytes(s_glyph))
  push_bytes(gt, arr_to_bytes(s_bbox))

  let glyf_bytes = arr_to_bytes(gt)
  let br = brotli_uncompressed(glyf_bytes)
  let dir : Array[Int] = [10]
  push_base128(dir, 128)
  push_base128(dir, glyf_bytes.length())
  dir.push(11)
  push_base128(dir, 4)
  push_base128(dir, 0)
  let buf = build_woff2_header(0x00010000U, 2, 256, br.length(), dir.length())
  push_bytes(buf, arr_to_bytes(dir))
  push_bytes(buf, br)

  let sfnt = match decode(arr_to_bytes(buf)) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "all triplet ranges failed: " + woff_error_message(e))
      Bytes::new(0)
    }
  }
  let glyf_off = read_u32_be(sfnt, 20).to_int()
  debug_assert(read_i16_be(sfnt, glyf_off) == 1, "1 contour")
  debug_assert(read_i16_be(sfnt, glyf_off + 2) == -10, "explicit xMin = -10")
  debug_assert(read_i16_be(sfnt, glyf_off + 4) == -20, "explicit yMin = -20")
  debug_assert(read_i16_be(sfnt, glyf_off + 6) == 800, "explicit xMax = 800")
  debug_assert(read_i16_be(sfnt, glyf_off + 8) == 1600, "explicit yMax = 1600")
  debug_assert(read_u16_be(sfnt, glyf_off + 10) == 5, "endPt = 5")
}
