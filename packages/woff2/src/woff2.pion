  0x56444D58U, // 22: "VDMX"
  0x76686561U, // 23: "vhea"
  0x766D7478U, // 24: "vmtx"
  0x42415345U, // 25: "BASE"
  0x47444546U, // 26: "GDEF"
  0x47504F53U, // 27: "GPOS"
  0x47535542U, // 28: "GSUB"
  0x45425343U, // 29: "EBSC"
  0x4A535446U, // 30: "JSTF"
  0x4D415448U, // 31: "MATH"
  0x43424454U, // 32: "CBDT"
  0x43424C43U, // 33: "CBLC"
  0x434F4C52U, // 34: "COLR"
