///| W3C WOFF 2.0 and WOFF 1.0 font container decoder to TrueType/OpenType (SFNT).
///| Pure Pion implementation with zero `extern "C"` and no `World` dependency.
///| Directly reuses `packages/brotli` and `packages/flate` with strict `DecodeLimits`.

import "brotli"
import "flate"

// --- Tag & Runtime Limit Constants ---

let tag_woff1 : UInt = 0x774F4646U // "wOFF"
let tag_woff2 : UInt = 0x774F4632U // "wOF2"
let tag_ttcf : UInt = 0x74746366U // "ttcf"
let tag_head : UInt = 0x68656164U // "head"
let tag_hhea : UInt = 0x68686561U // "hhea"
let tag_hmtx : UInt = 0x686D7478U // "hmtx"
let tag_maxp : UInt = 0x6D617870U // "maxp"
let tag_glyf : UInt = 0x676C7966U // "glyf"
let tag_loca : UInt = 0x6C6F6361U // "loca"

let sfnt_checksum_magic : UInt = 0xB1B0AFBAU

///| Runtime maximum `Bytes` container length (2^31 - 17), matching `packages/brotli`.
let max_container_bytes : Int = 2147483631

///| Normalize `max_output_bytes`: values `<= 0` mean unlimited (clamped to runtime max).
fn effective_max_output(limit : Int) -> Int {
  if limit <= 0 || limit > max_container_bytes {
    max_container_bytes
  } else {
    limit
  }
}

