// --- 128-Entry WOFF 2.0 Triplet Lookup Tables (§5.2 Table 2) ---

fn build_triplet_nbytes() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(128, 1)
  let mut f = 0
  while f < 128 {
    a[f] = if f < 84 {
      1
    } else if f < 120 {
      2
    } else if f < 124 {
      3
    } else {
      4
    }
    f = f + 1
  }
  a
}

fn build_triplet_kind() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(128, 0)
  let mut f = 0
  while f < 128 {
    a[f] = if f < 10 {
      0
    } else if f < 20 {
      1
    } else if f < 84 {
      2
    } else if f < 120 {
      3
    } else if f < 124 {
      4
    } else {
      5
    }
    f = f + 1
  }
  a
}

fn build_triplet_xdelta() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(128, 0)
  let mut f = 0
  while f < 128 {
    a[f] = if f < 10 {
      0
    } else if f < 20 {
      ((f - 10) & 14) << 7
    } else if f < 84 {
      1 + ((f - 20) & 0x30)
    } else if f < 120 {
      1 + (((f - 84) / 12) << 8)
    } else {
      0
    }
    f = f + 1
  }
  a
}

fn build_triplet_ydelta() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(128, 0)
  let mut f = 0
  while f < 128 {
    a[f] = if f < 10 {
      (f & 14) << 7
    } else if f < 20 {
      0
    } else if f < 84 {
      1 + (((f - 20) & 0x0C) << 2)
    } else if f < 120 {
      1 + ((((f - 84) % 12) >> 2) << 8)
    } else {
      0
    }
    f = f + 1
  }
  a
}

fn build_triplet_xsign() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(128, 1)
  let mut f = 0
  while f < 128 {
    a[f] = if (f & 1) == 1 { 1 } else { -1 }
    f = f + 1
  }
  a
}

fn build_triplet_ysign() -> FixedArray[Int] {
  let a : FixedArray[Int] = FixedArray::make(128, 1)
  let mut f = 0
  while f < 128 {
    let bit = if f < 10 { f & 1 } else { (f >> 1) & 1 }
    a[f] = if bit == 1 { 1 } else { -1 }
    f = f + 1
  }
  a
}

let triplet_nbytes : FixedArray[Int] = build_triplet_nbytes()
let triplet_kind : FixedArray[Int] = build_triplet_kind()
let triplet_xdelta : FixedArray[Int] = build_triplet_xdelta()
let triplet_ydelta : FixedArray[Int] = build_triplet_ydelta()
let triplet_xsign : FixedArray[Int] = build_triplet_xsign()
let triplet_ysign : FixedArray[Int] = build_triplet_ysign()

// --- Default Pure-Pion Decompressor ---

struct DefaultDecompressor {
  dummy : Int
}

impl Decompressor for DefaultDecompressor {
  fn brotli_decode(
    self : DefaultDecompressor,
    data : Bytes,
    max_output_bytes : Int,
  ) -> Result[Bytes, WoffError] {
    let _ = self.dummy
    let cap = if max_output_bytes < 0 || max_output_bytes > max_container_bytes {
      max_container_bytes
    } else {
      max_output_bytes
    }
    let lim = brotli::DecodeLimits::new(cap, brotli::default_max_window_bits)
    match brotli::decode_with_limits(data, lim) {
      Ok(b) => Ok(b)
      Err(brotli::BrotliError::OutputLimitExceeded(n)) =>
      Err(WoffError::LimitExceeded("brotli output exceeded " + n.to_string() + " bytes"))
      Err(e) => Err(WoffError::BrotliError(brotli::brotli_error_message(e)))
    }
  }

  fn zlib_decompress(
    self : DefaultDecompressor,
    data : Bytes,
    max_output_bytes : Int,
  ) -> Result[Bytes, WoffError] {
    let _ = self.dummy
    let cap = effective_max_output(max_output_bytes)
    match flate::zlib_decompress_with_limit(data, cap) {
      Ok(b) => Ok(b)
      Err(flate::FlateError::OutputLimitExceeded(n)) =>
      Err(WoffError::LimitExceeded("zlib output exceeded " + n.to_string() + " bytes"))
      Err(e) => Err(WoffError::ZlibError(flate::flate_error_message(e)))
    }
  }
}

// --- Zero-Copy Sub-Slice Reader ---

struct Reader {
  data : Bytes
  mut at : Int
  end : Int
}

fn Reader::from_bytes(data : Bytes) -> Reader {
  Reader::{ data: data, at: 0, end: data.length() }
}

fn Reader::sub(data : Bytes, start : Int, len : Int) -> Result[Reader, WoffError] {
  if start < 0 || len < 0 {
    return Err(WoffError::BoundsExceeded("negative stream offset or length"))
  }
  let end64 = start.to_int64() + len.to_int64()
  if end64 > data.length().to_int64() {
    return Err(WoffError::BoundsExceeded("stream range exceeds buffer"))
  }
  Ok(Reader::{ data: data, at: start, end: start + len })
}

fn Reader::remaining(self : Reader) -> Int {
  self.end - self.at
}

fn Reader::u8(self : Reader) -> Result[Int, WoffError] {
  if self.at >= self.end {
    return Err(WoffError::BoundsExceeded("unexpected EOF reading u8"))
  }
  let v = self.data[self.at].to_int()
  self.at = self.at + 1
  Ok(v)
}

fn Reader::u16(self : Reader) -> Result[Int, WoffError] {
  if self.at + 2 > self.end {
    return Err(WoffError::BoundsExceeded("unexpected EOF reading u16"))
  }
  let v = (self.data[self.at].to_int() << 8) | self.data[self.at + 1].to_int()
  self.at = self.at + 2
  Ok(v)
}

///| Self-contained inline `i16` read (no nested `self.u16()?` call).
fn Reader::i16(self : Reader) -> Result[Int, WoffError] {
  if self.at + 2 > self.end {
    return Err(WoffError::BoundsExceeded("unexpected EOF reading i16"))
  }
  let v = (self.data[self.at].to_int() << 8) | self.data[self.at + 1].to_int()
  self.at = self.at + 2
  if v >= 32768 {
    Ok(v - 65536)
  } else {
    Ok(v)
  }
}

fn Reader::u32_u(self : Reader) -> Result[UInt, WoffError] {
  if self.at + 4 > self.end {
    return Err(WoffError::BoundsExceeded("unexpected EOF reading u32"))
  }
  let b0 = self.data[self.at].to_int().to_uint()
  let b1 = self.data[self.at + 1].to_int().to_uint()
  let b2 = self.data[self.at + 2].to_int().to_uint()
  let b3 = self.data[self.at + 3].to_int().to_uint()
  self.at = self.at + 4
  Ok((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
}

fn Reader::u32_int(self : Reader) -> Result[Int, WoffError] {
  if self.at + 4 > self.end {
    return Err(WoffError::BoundsExceeded("unexpected EOF reading u32"))
  }
  let b0 = self.data[self.at].to_int()
  if b0 >= 128 {
    return Err(WoffError::BoundsExceeded("u32 value exceeds Int range"))
  }
  let v = (b0 << 24) |
  (self.data[self.at + 1].to_int() << 16) |
  (self.data[self.at + 2].to_int() << 8) |
  self.data[self.at + 3].to_int()
  self.at = self.at + 4
  Ok(v)
}

///| Strict WOFF 2.0 UIntBase128 decoder (§2.5.2):
///| rejects leading zero (0x80), uint32 overflow, and encodings longer than 5 bytes.
fn Reader::base128(self : Reader) -> Result[UInt, WoffError] {
  let data = self.data
  let end = self.end
  let mut at = self.at
  let mut accum : UInt = 0U
  let mut i = 0
  while i < 5 {
    if at >= end {
      self.at = at
      return Err(WoffError::InvalidVarInt("unexpected EOF in UIntBase128"))
    }
    let b = data[at].to_int()
    at = at + 1
    if i == 0 && b == 0x80 {
      self.at = at
      return Err(WoffError::InvalidVarInt("UIntBase128 has leading zero"))
    }
    if (accum & 0xFE000000U) != 0U {
      self.at = at
      return Err(WoffError::InvalidVarInt("UIntBase128 overflows uint32"))
    }
    accum = (accum << 7) | (b & 0x7F).to_uint()
    if (b & 0x80) == 0 {
      self.at = at
      return Ok(accum)
    }
    i = i + 1
  }
  self.at = at
  Err(WoffError::InvalidVarInt("UIntBase128 exceeds 5 bytes"))
}

///| Inline WOFF 2.0 255UInt16 decoder (§2.5.1).
fn Reader::u255(self : Reader) -> Result[Int, WoffError] {
  let at = self.at
  let end = self.end
  if at >= end {
    return Err(WoffError::InvalidVarInt("unexpected EOF in 255UInt16"))
  }
  let data = self.data
  let code = data[at].to_int()
  if code < 253 {
    self.at = at + 1
    Ok(code)
  } else if code == 253 {
    if at + 3 > end {
      return Err(WoffError::InvalidVarInt("unexpected EOF in 255UInt16 u16"))
    }
    let v = (data[at + 1].to_int() << 8) | data[at + 2].to_int()
    self.at = at + 3
    Ok(v)
  } else if code == 255 {
    if at + 2 > end {
      return Err(WoffError::InvalidVarInt("unexpected EOF in 255UInt16 +253"))
    }
    let v = data[at + 1].to_int() + 253
    self.at = at + 2
    Ok(v)
  } else {
    if at + 2 > end {
      return Err(WoffError::InvalidVarInt("unexpected EOF in 255UInt16 +506"))
    }
    let v = data[at + 1].to_int() + 506
    self.at = at + 2
    Ok(v)
  }
}

// --- Growable Output Writer with Limit Guard ---

struct Writer {
  mut buf : Bytes
  mut n : Int
  max_bytes : Int
}

fn Writer::with_capacity(cap : Int, max_bytes : Int) -> Writer {
  let init_cap = if cap < 64 {
    64
  } else if max_bytes > 0 && cap > max_bytes {
    max_bytes
  } else {
    cap
  }
  Writer::{ buf: Bytes::new(init_cap), n: 0, max_bytes: max_bytes }
}

fn copy_bytes_fast(dst : Bytes, dst_off : Int, src : Bytes, src_off : Int, len : Int) -> Unit {
  let mut di = dst_off
  let mut si = src_off
  let end8 = src_off + (len - (len & 7))
  while si < end8 {
    dst[di] = src[si]
    dst[di + 1] = src[si + 1]
    dst[di + 2] = src[si + 2]
    dst[di + 3] = src[si + 3]
    dst[di + 4] = src[si + 4]
    dst[di + 5] = src[si + 5]
    dst[di + 6] = src[si + 6]
    dst[di + 7] = src[si + 7]
    di = di + 8
    si = si + 8
  }
  let end = src_off + len
  while si < end {
    dst[di] = src[si]
    di = di + 1
    si = si + 1
  }
}

fn Writer::ensure(self : Writer, extra : Int) -> Result[Unit, WoffError] {
  let need64 = self.n.to_int64() + extra.to_int64()
  if need64 > self.max_bytes.to_int64() {
    return Err(
      WoffError::LimitExceeded(
        "output size exceeded max_output_bytes (" + self.max_bytes.to_string() + ")",
      ),
    )
  }
  let need = need64.to_int()
  if need <= self.buf.length() {
    return Ok(())
  }
  let mut new_cap64 = self.buf.length().to_int64() * 2L
  if new_cap64 < need64 {
    new_cap64 = need64
  }
  if new_cap64 > self.max_bytes.to_int64() {
    new_cap64 = self.max_bytes.to_int64()
  }
  let bigger = Bytes::new(new_cap64.to_int())
  copy_bytes_fast(bigger, 0, self.buf, 0, self.n)
  self.buf = bigger
  Ok(())
}

fn Writer::pad4(self : Writer) -> Result[Unit, WoffError] {
  let rem = self.n & 3
  if rem != 0 {
    let pad = 4 - rem
    self.ensure(pad)?
    let dst = self.buf
    let mut p = self.n
    let mut k = 0
    while k < pad {
      dst[p] = (0).to_byte()
      p = p + 1
      k = k + 1
    }
    self.n = p
  }
  Ok(())
}

fn Writer::done(self : Writer) -> Bytes {
  if self.n == self.buf.length() {
    self.buf
  } else {
    self.buf.slice(0, self.n)
  }
}

// --- Helpers ---

fn read_u16_at(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 8) | b[off + 1].to_int()
}

fn read_u32_at(b : Bytes, off : Int) -> UInt {
  (b[off].to_int().to_uint() << 24) |
  (b[off + 1].to_int().to_uint() << 16) |
  (b[off + 2].to_int().to_uint() << 8) |
  b[off + 3].to_int().to_uint()
}

fn write_u32_at(b : Bytes, off : Int, v : UInt) -> Unit {
  b[off] = ((v >> 24) & 0xFFU).to_int().to_byte()
  b[off + 1] = ((v >> 16) & 0xFFU).to_int().to_byte()
  b[off + 2] = ((v >> 8) & 0xFFU).to_int().to_byte()
  b[off + 3] = (v & 0xFFU).to_int().to_byte()
}

fn write_u16_at(b : Bytes, off : Int, v : Int) -> Unit {
  b[off] = ((v >> 8) & 255).to_byte()
  b[off + 1] = (v & 255).to_byte()
}

///| Compute SFNT checksum over a 4-byte-aligned, zero-padded slice `[start, start + padded_len)`.
fn calc_checksum_aligned(b : Bytes, start : Int, padded_len : Int) -> UInt {
  let mut sum : UInt = 0U
  let mut i = start
  let end = start + padded_len
  while i < end {
    let w = (b[i].to_int().to_uint() << 24) |
    (b[i + 1].to_int().to_uint() << 16) |
    (b[i + 2].to_int().to_uint() << 8) |
    b[i + 3].to_int().to_uint()
    sum = sum + w
    i = i + 4
  }
  sum
}

// --- O(n log n) Merge Sorts & Duplicate / Overlap Checks ---

///| Bottom-up O(n log n) merge sort for `FixedArray[UInt]`.
fn sort_uints(arr : FixedArray[UInt], n : Int) -> Unit {
  if n <= 1 {
    return ()
  }
  if n <= 32 {
    let mut i = 1
    while i < n {
      let v = arr[i]
      let mut j = i - 1
      while j >= 0 && arr[j] > v {
        arr[j + 1] = arr[j]
        j = j - 1
      }
      arr[j + 1] = v
      i = i + 1
    }
    return ()
  }
  let tmp : FixedArray[UInt] = FixedArray::make(n, 0U)
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut i = left
      let mut j = mid
      let mut k = left
      while i < mid && j < right {
        if arr[i] <= arr[j] {
          tmp[k] = arr[i]
          i = i + 1
        } else {
          tmp[k] = arr[j]
          j = j + 1
        }
        k = k + 1
      }
      while i < mid {
        tmp[k] = arr[i]
        i = i + 1
        k = k + 1
      }
      while j < right {
        tmp[k] = arr[j]
        j = j + 1
        k = k + 1
      }
      left = left + width * 2
    }
    let mut c = 0
    while c < n {
      arr[c] = tmp[c]
      c = c + 1
    }
    width = width * 2
  }
}

///| Check whether `tags[0..n)` contains any duplicate tag in O(n log n).
fn has_duplicate_tags(tags : FixedArray[UInt], n : Int) -> Bool {
  if n <= 1 {
    return false
  }
  sort_uints(tags, n)
  let mut i = 1
  while i < n {
    if tags[i] == tags[i - 1] {
      return true
    }
    i = i + 1
  }
  false
}

///| Bottom-up O(n log n) merge sort for `(starts, ends)` spans by `starts`, then check overlap.
fn has_overlapping_spans(
  starts : FixedArray[Int],
  ends : FixedArray[Int],
  n : Int,
) -> Bool {
  if n <= 1 {
    return false
  }
  if n <= 32 {
    let mut i = 1
    while i < n {
      let s = starts[i]
      let e = ends[i]
      let mut j = i - 1
      while j >= 0 && (starts[j] > s || (starts[j] == s && ends[j] > e)) {
        starts[j + 1] = starts[j]
        ends[j + 1] = ends[j]
        j = j - 1
      }
      starts[j + 1] = s
      ends[j + 1] = e
      i = i + 1
    }
  } else {
    let tmp_s : FixedArray[Int] = FixedArray::make(n, 0)
    let tmp_e : FixedArray[Int] = FixedArray::make(n, 0)
    let mut width = 1
    while width < n {
      let mut left = 0
      while left < n {
        let mid = if left + width < n { left + width } else { n }
        let right = if left + width * 2 < n { left + width * 2 } else { n }
        let mut i = left
        let mut j = mid
        let mut k = left
        while i < mid && j < right {
          if starts[i] < starts[j] || (starts[i] == starts[j] && ends[i] <= ends[j]) {
            tmp_s[k] = starts[i]
            tmp_e[k] = ends[i]
            i = i + 1
          } else {
            tmp_s[k] = starts[j]
            tmp_e[k] = ends[j]
            j = j + 1
          }
          k = k + 1
        }
        while i < mid {
          tmp_s[k] = starts[i]
          tmp_e[k] = ends[i]
          i = i + 1
          k = k + 1
        }
        while j < right {
          tmp_s[k] = starts[j]
          tmp_e[k] = ends[j]
          j = j + 1
          k = k + 1
        }
        left = left + width * 2
      }
      let mut c = 0
      while c < n {
        starts[c] = tmp_s[c]
        ends[c] = tmp_e[c]
        c = c + 1
      }
      width = width * 2
    }
  }
  let mut i = 1
  while i < n {
    if ends[i - 1] > starts[i] {
      return true
    }
    i = i + 1
  }
  false
}

// --- Table Structures ---

struct Table {
  tag : UInt
  mut data : Bytes
  mut start : Int
  mut len : Int
}

struct TableEntry {
  tag : UInt
  orig_len : Int
  stream_len : Int
  transformed : Bool
  transform_version : Int
}

///| Bottom-up O(n log n) merge sort for `Array[Table]` by unsigned `tag`.
fn sort_tables(tables : Array[Table]) -> Unit {
  let n = tables.length()
  if n <= 1 {
    return ()
  }
  if n <= 32 {
    let mut i = 1
    while i < n {
      let cur = tables[i]
      let cur_tag = cur.tag
      let mut j = i - 1
      while j >= 0 && tables[j].tag > cur_tag {
        tables[j + 1] = tables[j]
        j = j - 1
      }
      tables[j + 1] = cur
      i = i + 1
    }
    return ()
  }
  let dummy = tables[0]
  let tmp : FixedArray[Table] = FixedArray::make(n, dummy)
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + width * 2 < n { left + width * 2 } else { n }
      let mut i = left
      let mut j = mid
      let mut k = left
      while i < mid && j < right {
        if tables[i].tag <= tables[j].tag {
          tmp[k] = tables[i]
          i = i + 1
        } else {
          tmp[k] = tables[j]
          j = j + 1
        }
        k = k + 1
      }
      while i < mid {
        tmp[k] = tables[i]
        i = i + 1
        k = k + 1
      }
      while j < right {
        tmp[k] = tables[j]
        j = j + 1
        k = k + 1
      }
      left = left + width * 2
    }
    let mut c = 0
    while c < n {
      tables[c] = tmp[c]
      c = c + 1
    }
    width = width * 2
  }
}

///| Assemble sorted SFNT font in a single exact allocation with 4-byte alignment,
///| fused single-pass copy + big-endian u32 checksum, and exact `head.checkSumAdjustment`.
fn assemble_sfnt(
  flavor : UInt,
  tables : Array[Table],
  eff_max_output : Int,
  patch_head_loca_format : Int,
) -> Result[Bytes, WoffError] {
  sort_tables(tables)
  let n = tables.length()
  let dir_size = 12 + n * 16
  let mut total_size64 : Int64 = dir_size.to_int64()
  let max64 = eff_max_output.to_int64()
  let mut i = 0
  while i < n {
    let padded = ((tables[i].len + 3) / 4) * 4
    total_size64 = total_size64 + padded.to_int64()
    if total_size64 > max64 {
      return Err(
        WoffError::LimitExceeded(
          "assembled SFNT exceeds max_output_bytes (" + eff_max_output.to_string() + ")",
        ),
      )
    }
    i = i + 1
  }
  let total_size = total_size64.to_int()
  let out = Bytes::new(total_size)

  // SFNT Offset Table (12 bytes)
  write_u32_at(out, 0, flavor)
  write_u16_at(out, 4, n)
  let mut p = 0
  while (1 << (p + 1)) <= n {
    p = p + 1
  }
  let search_range = (1 << p) * 16
  write_u16_at(out, 6, search_range)
  write_u16_at(out, 8, p)
  write_u16_at(out, 10, n * 16 - search_range)

  // Write table payloads & directory records, fusing copy + checksum into one pass
  let mut table_off = dir_size
  let mut head_off = -1
  let mut head_len = 0
  let mut tables_checksum : UInt = 0U
  i = 0
  while i < n {
    let t = tables[i]
    let tlen = t.len
    let padded = ((tlen + 3) / 4) * 4
    let src = t.data
    let mut si = t.start
    let mut di = table_off
    let mut csum : UInt = 0U

    if t.tag != tag_head {
      let full4 = tlen - (tlen & 3)
      let send4 = si + full4
      while si < send4 {
        let b0 = src[si]
        let b1 = src[si + 1]
        let b2 = src[si + 2]
        let b3 = src[si + 3]
        out[di] = b0
        out[di + 1] = b1
        out[di + 2] = b2
        out[di + 3] = b3
        let w = (b0.to_int().to_uint() << 24) |
        (b1.to_int().to_uint() << 16) |
        (b2.to_int().to_uint() << 8) |
        b3.to_int().to_uint()
        csum = csum + w
        si = si + 4
        di = di + 4
      }
      let rem = tlen - full4
      if rem > 0 {
        let mut tail : UInt = 0U
        let mut k = 0
        while k < rem {
          let b = src[si + k]
          out[di + k] = b
          let shift = 24 - k * 8
          tail = tail | (b.to_int().to_uint() << shift)
          k = k + 1
        }
        csum = csum + tail
      }
    } else {
      copy_bytes_fast(out, di, src, si, tlen)
      head_off = table_off
      head_len = tlen
      if tlen >= 54 && patch_head_loca_format >= 0 {
        write_u16_at(out, table_off + 50, patch_head_loca_format)
      }
      if tlen >= 12 {
        // Zero checkSumAdjustment before computing head checksum
        write_u32_at(out, table_off + 8, 0U)
      }
      csum = calc_checksum_aligned(out, table_off, padded)
    }

    tables_checksum = tables_checksum + csum

    let rec_off = 12 + i * 16
    write_u32_at(out, rec_off, t.tag)
    write_u32_at(out, rec_off + 4, csum)
    write_u32_at(out, rec_off + 8, table_off.to_uint())
    write_u32_at(out, rec_off + 12, tlen.to_uint())

    table_off = table_off + padded
    i = i + 1
  }

  // Compute header + directory checksum and write head.checkSumAdjustment
  if head_off >= 0 && head_len >= 12 {
    let header_csum = calc_checksum_aligned(out, 0, dir_size)
    let font_csum = header_csum + tables_checksum
    write_u32_at(out, head_off + 8, sfnt_checksum_magic - font_csum)
  }

  Ok(out)
}

// --- WOFF 2.0 glyf + loca Reconstruction ---

struct GlyfScratch {
  mut ends : FixedArray[Int]
  mut dxs : FixedArray[Int]
  mut dys : FixedArray[Int]
  mut rle : Bytes
}

fn GlyfScratch::new() -> GlyfScratch {
  GlyfScratch::{
    ends: FixedArray::make(64, 0),
    dxs: FixedArray::make(256, 0),
    dys: FixedArray::make(256, 0),
    rle: Bytes::new(256),
  }
}

fn GlyfScratch::ensure_ends(self : GlyfScratch, need : Int) -> Unit {
  if need <= self.ends.length() {
    return ()
  }
  let mut cap = self.ends.length() * 2
  while cap < need {
    cap = cap * 2
  }
  self.ends = FixedArray::make(cap, 0)
}

fn GlyfScratch::ensure_points(self : GlyfScratch, need : Int) -> Unit {
  if need <= self.dxs.length() {
    return ()
  }
  let mut cap = self.dxs.length() * 2
  while cap < need {
    cap = cap * 2
  }
  self.dxs = FixedArray::make(cap, 0)
  self.dys = FixedArray::make(cap, 0)
  self.rle = Bytes::new(cap)
}

fn simple_glyph(
  out : Writer,
  ncont : Int,
  npoints : Reader,
  flags : Reader,
  glyphs : Reader,
  instrs : Reader,
  bbox : Option[Reader],
  overlap : Bool,
  scratch : GlyfScratch,
) -> Result[Int, WoffError] {
  scratch.ensure_ends(ncont)
  let ends = scratch.ends
  let mut total = 0
  let mut c = 0
  while c < ncont {
    let np = match npoints.u255() {
      Ok(v) => v
      Err(_) => return Err(WoffError::GlyfReconstructionError("truncated nPointsStream"))
    }
    total = total + np
    if total > 65536 {
      return Err(WoffError::GlyfReconstructionError("glyph point count exceeds 65536"))
    }
    ends[c] = total - 1
    c = c + 1
  }

  let flag_data = flags.data
  let flag_start = flags.at
  let flag_end = flag_start + total
  if flag_end > flags.end {
    return Err(WoffError::GlyfReconstructionError("truncated flagStream"))
  }

  // Check glyphStream bounds once per glyph; skip pre-sum when >= 4 bytes/pt remain
  let glyph_data = glyphs.data
  let mut gi = glyphs.at
  if gi + total * 4 > glyphs.end {
    let nbytes_lut = triplet_nbytes
    let mut need_g = 0
    let mut fi0 = flag_start
    while fi0 < flag_end {
      need_g = need_g + nbytes_lut[flag_data[fi0].to_int() & 0x7F]
      fi0 = fi0 + 1
    }
    if gi + need_g > glyphs.end {
      return Err(WoffError::GlyfReconstructionError("truncated glyphStream"))
    }
  }

  scratch.ensure_points(total)
  let dxs = scratch.dxs
  let dys = scratch.dys
  let rle_buf = scratch.rle

  let kind_lut = triplet_kind
  let xdelta_lut = triplet_xdelta
  let ydelta_lut = triplet_ydelta
  let xsign_lut = triplet_xsign
  let ysign_lut = triplet_ysign

  let check_ov = total > 32767
  let mut x64 : Int64 = 0L
  let mut y64 : Int64 = 0L
  let mut xi = 0
  let mut yi = 0
  let mut min_x = 0
  let mut min_y = 0
  let mut max_x = 0
  let mut max_y = 0
  let mut x_bytes = 0
  let mut y_bytes = 0
  let mut last_flag = -1
  let mut repeat_count = 0
  let mut rle_len = 0

  let mut i = 0
  let mut fi = flag_start
  while i < total {
    let fl = flag_data[fi].to_int()
    fi = fi + 1
    let idx = fl & 0x7F
    let k = kind_lut[idx]
    let mut dx = 0
    let mut dy = 0
    if k == 2 {
      let b1 = glyph_data[gi].to_int()
      gi = gi + 1
      dx = (xdelta_lut[idx] + (b1 >> 4)) * xsign_lut[idx]
      dy = (ydelta_lut[idx] + (b1 & 0x0F)) * ysign_lut[idx]
    } else if k == 0 {
      let b0 = glyph_data[gi].to_int()
      gi = gi + 1
      dy = (ydelta_lut[idx] + b0) * ysign_lut[idx]
    } else if k == 1 {
      let b0 = glyph_data[gi].to_int()
      gi = gi + 1
      dx = (xdelta_lut[idx] + b0) * xsign_lut[idx]
    } else if k == 3 {
      let a = glyph_data[gi].to_int()
      let c2 = glyph_data[gi + 1].to_int()
      gi = gi + 2
      dx = (xdelta_lut[idx] + a) * xsign_lut[idx]
      dy = (ydelta_lut[idx] + c2) * ysign_lut[idx]
    } else if k == 4 {
      let a = glyph_data[gi].to_int()
      let b2 = glyph_data[gi + 1].to_int()
      let c2 = glyph_data[gi + 2].to_int()
      gi = gi + 3
      dx = ((a << 4) + (b2 >> 4)) * xsign_lut[idx]
      dy = (((b2 & 0x0F) << 8) + c2) * ysign_lut[idx]
    } else {
      let a = (glyph_data[gi].to_int() << 8) | glyph_data[gi + 1].to_int()
      let c2 = (glyph_data[gi + 2].to_int() << 8) | glyph_data[gi + 3].to_int()
      gi = gi + 4
      dx = a * xsign_lut[idx]
      dy = c2 * ysign_lut[idx]
    }

    if check_ov {
      x64 = x64 + dx.to_int64()
      y64 = y64 + dy.to_int64()
      if x64 < -2147483648L || x64 > 2147483647L || y64 < -2147483648L || y64 > 2147483647L {
        return Err(WoffError::GlyfReconstructionError("glyph coordinate overflow"))
      }
      xi = x64.to_int()
      yi = y64.to_int()
    } else {
      xi = xi + dx
      yi = yi + dy
    }
    if i == 0 {
      min_x = xi
      max_x = xi
      min_y = yi
      max_y = yi
    } else {
      if xi < min_x {
        min_x = xi
      } else if xi > max_x {
        max_x = xi
      }
      if yi < min_y {
        min_y = yi
      } else if yi > max_y {
        max_y = yi
      }
    }

    dxs[i] = dx
    dys[i] = dy

    let mut pf = if (fl & 0x80) == 0 { 1 } else { 0 }
    if i == 0 && overlap {
      pf = pf | 0x40
    }
    if dx == 0 {
      pf = pf | 0x10
    } else if dx > -256 && dx < 256 {
      pf = pf | 0x02 | (if dx > 0 { 0x10 } else { 0 })
      x_bytes = x_bytes + 1
    } else {
      x_bytes = x_bytes + 2
    }
    if dy == 0 {
      pf = pf | 0x20
    } else if dy > -256 && dy < 256 {
      pf = pf | 0x04 | (if dy > 0 { 0x20 } else { 0 })
      y_bytes = y_bytes + 1
    } else {
      y_bytes = y_bytes + 2
    }

    // OpenType REPEAT_FLAG (0x08) run-length encoding matching google/woff2 & wuff
    if pf == last_flag && repeat_count < 255 {
      repeat_count = repeat_count + 1
    } else {
      if last_flag >= 0 {
        if repeat_count > 0 {
          rle_buf[rle_len] = (last_flag | 0x08).to_byte()
          rle_buf[rle_len + 1] = repeat_count.to_byte()
          rle_len = rle_len + 2
        } else {
          rle_buf[rle_len] = last_flag.to_byte()
          rle_len = rle_len + 1
        }
      }
      last_flag = pf
      repeat_count = 0
    }
    i = i + 1
  }

  if last_flag >= 0 {
    if repeat_count > 0 {
      rle_buf[rle_len] = (last_flag | 0x08).to_byte()
      rle_buf[rle_len + 1] = repeat_count.to_byte()
      rle_len = rle_len + 2
    } else {
      rle_buf[rle_len] = last_flag.to_byte()
      rle_len = rle_len + 1
    }
  }

  flags.at = fi
  glyphs.at = gi

  let ilen = match glyphs.u255() {
    Ok(v) => v
    Err(_) => return Err(WoffError::GlyfReconstructionError("truncated instruction length"))
  }
  if instrs.remaining() < ilen {
    return Err(WoffError::GlyfReconstructionError("truncated instructionStream"))
  }

  let mut x0 = min_x
  let mut y0 = min_y
  let mut x1 = max_x
  let mut y1 = max_y
  match bbox {
    Some(r) => {
      x0 = match r.i16() {
        Ok(v) => v
        Err(_) => return Err(WoffError::GlyfReconstructionError("truncated bboxStream"))
      }
      y0 = match r.i16() {
        Ok(v) => v
        Err(_) => return Err(WoffError::GlyfReconstructionError("truncated bboxStream"))
      }
      x1 = match r.i16() {
        Ok(v) => v
        Err(_) => return Err(WoffError::GlyfReconstructionError("truncated bboxStream"))
      }
      y1 = match r.i16() {
        Ok(v) => v
        Err(_) => return Err(WoffError::GlyfReconstructionError("truncated bboxStream"))
      }
    }
    None => ()
  }

  // Reserve exact simple glyph bytes in one check and write directly via local cursor
  let glyph_bytes = 10 + ncont * 2 + 2 + ilen + rle_len + x_bytes + y_bytes
  out.ensure(glyph_bytes)?

  let dst = out.buf
  let mut p = out.n

  dst[p] = ((ncont >> 8) & 255).to_byte()
  dst[p + 1] = (ncont & 255).to_byte()
  dst[p + 2] = ((x0 >> 8) & 255).to_byte()
  dst[p + 3] = (x0 & 255).to_byte()
  dst[p + 4] = ((y0 >> 8) & 255).to_byte()
  dst[p + 5] = (y0 & 255).to_byte()
  dst[p + 6] = ((x1 >> 8) & 255).to_byte()
  dst[p + 7] = (x1 & 255).to_byte()
  dst[p + 8] = ((y1 >> 8) & 255).to_byte()
  dst[p + 9] = (y1 & 255).to_byte()
  p = p + 10

  let mut ei = 0
  while ei < ncont {
    let ep = ends[ei]
    dst[p] = ((ep >> 8) & 255).to_byte()
    dst[p + 1] = (ep & 255).to_byte()
    p = p + 2
    ei = ei + 1
  }

  dst[p] = ((ilen >> 8) & 255).to_byte()
  dst[p + 1] = (ilen & 255).to_byte()
  p = p + 2
  if ilen > 0 {
    copy_bytes_fast(dst, p, instrs.data, instrs.at, ilen)
    p = p + ilen
    instrs.at = instrs.at + ilen
  }

  if rle_len > 0 {
    copy_bytes_fast(dst, p, rle_buf, 0, rle_len)
    p = p + rle_len
  }

  i = 0
  while i < total {
    let dx = dxs[i]
    if dx != 0 {
      if dx > -256 && dx < 256 {
        let adx = if dx < 0 { 0 - dx } else { dx }
        dst[p] = adx.to_byte()
        p = p + 1
      } else {
        dst[p] = ((dx >> 8) & 255).to_byte()
        dst[p + 1] = (dx & 255).to_byte()
        p = p + 2
      }
    }
    i = i + 1
  }

  i = 0
  while i < total {
    let dy = dys[i]
    if dy != 0 {
      if dy > -256 && dy < 256 {
        let ady = if dy < 0 { 0 - dy } else { dy }
        dst[p] = ady.to_byte()
        p = p + 1
      } else {
        dst[p] = ((dy >> 8) & 255).to_byte()
        dst[p + 1] = (dy & 255).to_byte()
        p = p + 2
      }
    }
    i = i + 1
  }

  out.n = p
  Ok(x0)
}

fn rebuild_glyf(
  data : Bytes,
  start : Int,
  len : Int,
  orig_glyf_len : Int,
  limits : DecodeLimits,
  eff_max_output : Int,
) -> Result[(Bytes, Bytes, FixedArray[Int], Int), WoffError] {
  let h = Reader::sub(data, start, len)?
  let version = match h.u16() {
    Ok(v) => v
    Err(_) => return Err(WoffError::GlyfReconstructionError("truncated glyf header"))
  }
  let _ = version
  let options = match h.u16() {
    Ok(v) => v
    Err(_) => return Err(WoffError::GlyfReconstructionError("truncated glyf optionFlags"))
  }
  let count = match h.u16() {
    Ok(v) => v
    Err(_) => return Err(WoffError::GlyfReconstructionError("truncated glyf numGlyphs"))
  }
  let index_format = match h.u16() {
    Ok(v) => v
    Err(_) => return Err(WoffError::GlyfReconstructionError("truncated glyf indexFormat"))
  }
  if index_format != 0 && index_format != 1 {
    return Err(
      WoffError::GlyfReconstructionError(
        "invalid glyf indexFormat: " + index_format.to_string(),
      ),
    )
  }
  if limits.max_glyphs > 0 && count > limits.max_glyphs {
    return Err(
      WoffError::LimitExceeded(
        "glyph count " + count.to_string() + " exceeds max_glyphs (" + limits.max_glyphs.to_string() + ")",
      ),
    )
  }

  let sizes : FixedArray[Int] = [0, 0, 0, 0, 0, 0, 0]
  let mut i = 0
  while i < 7 {
    sizes[i] = match h.u32_int() {
      Ok(v) => v
      Err(_) => return Err(WoffError::GlyfReconstructionError("truncated glyf stream size"))
    }
    i = i + 1
  }

  let mut at = h.at
  let end = start + len
  let streams : Array[Reader] = []
  i = 0
  while i < 7 {
    let sz = sizes[i]
    if sz < 0 || at.to_int64() + sz.to_int64() > end.to_int64() {
      return Err(WoffError::GlyfReconstructionError("glyf substream out of bounds"))
    }
    streams.push(Reader::{ data: data, at: at, end: at + sz })
    at = at + sz
    i = i + 1
  }

  let has_overlap_bitmap = (options & 1) != 0
  let overlap_start = at
  if has_overlap_bitmap {
    let ov_len = (count + 7) >> 3
    if at.to_int64() + ov_len.to_int64() > end.to_int64() {
      return Err(WoffError::GlyfReconstructionError("overlapSimpleBitmap out of bounds"))
    }
  }

  let ncont = streams[0]
  let npoints = streams[1]
  let flags = streams[2]
  let glyphs = streams[3]
  let comps = streams[4]
  let bbox_all = streams[5]
  let instrs = streams[6]

  let bitmap_len = ((count + 31) >> 5) << 2
  if bbox_all.remaining() < bitmap_len {
    return Err(WoffError::GlyfReconstructionError("bboxBitmap truncated"))
  }
  let bitmap_start = bbox_all.at
  bbox_all.at = bbox_all.at + bitmap_len

  // Evidence-based initial capacity (never blindly trust attacker-controlled origLength)
  let est64 = len.to_int64() * 4L + count.to_int64() * 16L + 256L
  let cap_limit64 : Int64 = 4194304L
  let mut init64 = if est64 < 256L {
    256L
  } else if est64 > cap_limit64 {
    cap_limit64
  } else {
    est64
  }
  if orig_glyf_len > 0 && orig_glyf_len.to_int64() < init64 {
    init64 = orig_glyf_len.to_int64()
  }
  if init64 > eff_max_output.to_int64() {
    init64 = eff_max_output.to_int64()
  }
  let out = Writer::with_capacity(init64.to_int(), eff_max_output)

  let loca_entry_bytes = if index_format == 0 { 2 } else { 4 }
  let loca_total_bytes = (count + 1) * loca_entry_bytes
  if loca_total_bytes.to_int64() > eff_max_output.to_int64() {
    return Err(WoffError::LimitExceeded("loca table exceeds max_output_bytes"))
  }
  let loca = Bytes::new(loca_total_bytes)
  let xmins : FixedArray[Int] = FixedArray::make(count, 0)

  let scratch = GlyfScratch::new()
  i = 0
  while i < count {
    let cur_off = out.n
    if index_format == 0 {
      if (cur_off & 1) != 0 || (cur_off >> 1) > 0xFFFF {
        return Err(WoffError::GlyfReconstructionError("short loca offset overflow"))
      }
      write_u16_at(loca, i * 2, cur_off >> 1)
    } else {
      write_u32_at(loca, i * 4, cur_off.to_uint())
    }

    let n = match ncont.i16() {
      Ok(v) => v
      Err(_) => return Err(WoffError::GlyfReconstructionError("truncated nContourStream"))
    }
    let has_bb = (data[bitmap_start + (i >> 3)].to_int() & (0x80 >> (i & 7))) != 0
    if n == 0 {
      if has_bb {
        return Err(WoffError::GlyfReconstructionError("empty glyph cannot have explicit bbox"))
      }
    } else if n < 0 {
      if n != -1 {
        return Err(WoffError::GlyfReconstructionError("invalid negative nContours != -1"))
      }
      if !has_bb {
        return Err(WoffError::GlyfReconstructionError("composite glyph missing explicit bbox"))
      }
      let x0 = match bbox_all.i16() {
        Ok(v) => v
        Err(_) => return Err(WoffError::GlyfReconstructionError("truncated composite bbox"))
      }
      let y0 = match bbox_all.i16() {
        Ok(v) => v
        Err(_) => return Err(WoffError::GlyfReconstructionError("truncated composite bbox"))
      }
      let x1 = match bbox_all.i16() {
        Ok(v) => v
        Err(_) => return Err(WoffError::GlyfReconstructionError("truncated composite bbox"))
      }
      let y1 = match bbox_all.i16() {
        Ok(v) => v
        Err(_) => return Err(WoffError::GlyfReconstructionError("truncated composite bbox"))
      }
      xmins[i] = x0
      out.ensure(10)?
      let dst0 = out.buf
      let p0 = out.n
      dst0[p0] = (0xFF).to_byte()
      dst0[p0 + 1] = (0xFF).to_byte()
      dst0[p0 + 2] = ((x0 >> 8) & 255).to_byte()
      dst0[p0 + 3] = (x0 & 255).to_byte()
      dst0[p0 + 4] = ((y0 >> 8) & 255).to_byte()
      dst0[p0 + 5] = (y0 & 255).to_byte()
      dst0[p0 + 6] = ((x1 >> 8) & 255).to_byte()
      dst0[p0 + 7] = (x1 & 255).to_byte()
      dst0[p0 + 8] = ((y1 >> 8) & 255).to_byte()
      dst0[p0 + 9] = (y1 & 255).to_byte()
      out.n = p0 + 10

      let mut more = true
      let mut instructions = false
      while more {
        let f = match comps.u16() {
          Ok(v) => v
          Err(_) => return Err(WoffError::GlyfReconstructionError("truncated compositeStream flags"))
        }
        let gidx = match comps.u16() {
          Ok(v) => v
          Err(_) => return Err(WoffError::GlyfReconstructionError("truncated compositeStream glyphIndex"))
        }
        let n_args = if (f & 1) != 0 { 4 } else { 2 }
        let n_scale = if (f & 0x08) != 0 {
          2
        } else if (f & 0x40) != 0 {
          4
        } else if (f & 0x80) != 0 {
          8
        } else {
          0
        }
        let n_tot = n_args + n_scale
        if comps.remaining() < n_tot {
          return Err(WoffError::GlyfReconstructionError("truncated compositeStream args"))
        }
        out.ensure(4 + n_tot)?
        let dstc = out.buf
        let pc = out.n
        dstc[pc] = ((f >> 8) & 255).to_byte()
        dstc[pc + 1] = (f & 255).to_byte()
        dstc[pc + 2] = ((gidx >> 8) & 255).to_byte()
        dstc[pc + 3] = (gidx & 255).to_byte()
        copy_bytes_fast(dstc, pc + 4, comps.data, comps.at, n_tot)
        out.n = pc + 4 + n_tot
        comps.at = comps.at + n_tot
        if (f & 0x100) != 0 {
          instructions = true
        }
        more = (f & 0x20) != 0
      }
      if instructions {
        let ilen = match glyphs.u255() {
          Ok(v) => v
          Err(_) => return Err(WoffError::GlyfReconstructionError("truncated composite instruction length"))
        }
        if instrs.remaining() < ilen {
          return Err(WoffError::GlyfReconstructionError("truncated composite instructionStream"))
        }
        out.ensure(2 + ilen)?
        let dsti = out.buf
        let pi = out.n
        dsti[pi] = ((ilen >> 8) & 255).to_byte()
        dsti[pi + 1] = (ilen & 255).to_byte()
        if ilen > 0 {
          copy_bytes_fast(dsti, pi + 2, instrs.data, instrs.at, ilen)
          instrs.at = instrs.at + ilen
        }
        out.n = pi + 2 + ilen
      }
      out.pad4()?
    } else {
      let bb : Option[Reader] = if has_bb { Some(bbox_all) } else { None }
      let overlap = if has_overlap_bitmap {
        (data[overlap_start + (i >> 3)].to_int() & (0x80 >> (i & 7))) != 0
      } else {
        false
      }
      let xm = simple_glyph(out, n, npoints, flags, glyphs, instrs, bb, overlap, scratch)?
      xmins[i] = xm
      out.pad4()?
    }
    i = i + 1
  }

  let final_off = out.n
  if index_format == 0 {
    if (final_off & 1) != 0 || (final_off >> 1) > 0xFFFF {
      return Err(WoffError::GlyfReconstructionError("short loca final offset overflow"))
    }
    write_u16_at(loca, count * 2, final_off >> 1)
  } else {
    write_u32_at(loca, count * 4, final_off.to_uint())
  }

  Ok((out.done(), loca, xmins, index_format))
}

///| Reconstruct WOFF 2.0 transformed `hmtx` table (§5.4).
fn rebuild_hmtx(
  data : Bytes,
  start : Int,
  len : Int,
  metrics : Int,
  count : Int,
  xmins : FixedArray[Int],
  eff_max_output : Int,
) -> Result[Bytes, WoffError] {
  if metrics < 1 || metrics > count {
    return Err(WoffError::HmtxReconstructionError("invalid numOfLongHorMetrics vs numGlyphs"))
  }
  if xmins.length() != count {
    return Err(WoffError::HmtxReconstructionError("maxp numGlyphs does not match glyf numGlyphs"))
  }
  let r = Reader::sub(data, start, len)?
  let flags = match r.u8() {
    Ok(v) => v
    Err(_) => return Err(WoffError::HmtxReconstructionError("truncated hmtx flags"))
  }
  if (flags & 0xFC) != 0 {
    return Err(WoffError::HmtxReconstructionError("reserved bits set in hmtx flags"))
  }
  if (flags & 3) == 0 {
    return Err(WoffError::HmtxReconstructionError("hmtx transform requires proportional or monospace lsb omitted"))
  }

  let out_size = metrics * 4 + (count - metrics) * 2
  if out_size.to_int64() > eff_max_output.to_int64() {
    return Err(WoffError::LimitExceeded("reconstructed hmtx exceeds max_output_bytes"))
  }

  let adv : FixedArray[Int] = FixedArray::make(metrics, 0)
  let mut i = 0
  while i < metrics {
    let a = match r.u16() {
      Ok(v) => v
      Err(_) => return Err(WoffError::HmtxReconstructionError("truncated hmtx advanceWidth"))
    }
    adv[i] = a
    i = i + 1
  }

  let out = Bytes::new(out_size)
  let mut pos = 0
  i = 0
  while i < metrics {
    let lsb = if (flags & 1) == 0 {
      match r.i16() {
        Ok(v) => v
        Err(_) => return Err(WoffError::HmtxReconstructionError("truncated hmtx proportional lsb"))
      }
    } else {
      xmins[i]
    }
    write_u16_at(out, pos, adv[i])
    write_u16_at(out, pos + 2, lsb)
    pos = pos + 4
    i = i + 1
  }

  i = metrics
  while i < count {
    let lsb = if (flags & 2) == 0 {
      match r.i16() {
        Ok(v) => v
        Err(_) => return Err(WoffError::HmtxReconstructionError("truncated hmtx monospace lsb"))
      }
    } else {
      xmins[i]
    }
    write_u16_at(out, pos, lsb)
    pos = pos + 2
    i = i + 1
  }

  Ok(out)
}

// --- WOFF 1.0 Decoder ---

fn decode_woff1(
  data : Bytes,
  dec : dyn Decompressor,
  limits : DecodeLimits,
) -> Result[Bytes, WoffError] {
  if data.length() < 44 {
    return Err(WoffError::TruncatedHeader("WOFF 1.0 header shorter than 44 bytes"))
  }
  let eff_max = effective_max_output(limits.max_output_bytes)
  let eff_max64 = eff_max.to_int64()
  let r = Reader::from_bytes(data)
  let _ = r.u32_u()? // signature already verified
  let flavor = r.u32_u()?
  let file_len = r.u32_u()?
  let num_tables = r.u16()?
  let reserved = r.u16()?
  let _ = r.u32_u()? // totalSfntSize (enforced on actual cumulative/assembled size)

  if reserved != 0 {
    return Err(WoffError::TruncatedHeader("WOFF 1.0 reserved field must be 0"))
  }
  if file_len.to_int64() != data.length().to_int64() {
    return Err(WoffError::BoundsExceeded("WOFF 1.0 length does not match input buffer"))
  }
  if num_tables == 0 {
    return Err(WoffError::InvalidTableDirectory("WOFF 1.0 numTables is 0"))
  }
  if limits.max_tables > 0 && num_tables > limits.max_tables {
    return Err(
      WoffError::LimitExceeded(
        "table count " + num_tables.to_string() + " exceeds max_tables (" + limits.max_tables.to_string() + ")",
      ),
    )
  }

  let dir_end64 = 44L + num_tables.to_int64() * 20L
  if dir_end64 > data.length().to_int64() {
    return Err(WoffError::InvalidTableDirectory("WOFF 1.0 table directory truncated"))
  }
  r.at = 44

  let tags : FixedArray[UInt] = FixedArray::make(num_tables, 0U)
  let offs : FixedArray[Int] = FixedArray::make(num_tables, 0)
  let comps : FixedArray[Int] = FixedArray::make(num_tables, 0)
  let origs : FixedArray[Int] = FixedArray::make(num_tables, 0)
  let span_starts : FixedArray[Int] = FixedArray::make(num_tables, 0)
  let span_ends : FixedArray[Int] = FixedArray::make(num_tables, 0)
  let raw_tags : FixedArray[UInt] = FixedArray::make(num_tables, 0U)

  let data_len64 = data.length().to_int64()
  let mut cumulative_bytes : Int64 = (12L + num_tables.to_int64() * 16L)
  if cumulative_bytes > eff_max64 {
    return Err(WoffError::LimitExceeded("WOFF 1.0 directory size exceeds max_output_bytes"))
  }

  let mut i = 0
  while i < num_tables {
    let tag = r.u32_u()?
    let off = r.u32_u()?
    let comp = r.u32_u()?
    let orig = r.u32_u()?
    let _ = r.u32_u()? // origChecksum (recomputed on assembly)

    if comp > orig {
      return Err(WoffError::InvalidTableDirectory("WOFF 1.0 compLength exceeds origLength"))
    }
    let off64 = off.to_int64()
    let comp64 = comp.to_int64()
    let orig64 = orig.to_int64()
    if off64 < dir_end64 {
      return Err(WoffError::InvalidTableDirectory("WOFF 1.0 table offset inside header/directory"))
    }
    if off64 + comp64 > data_len64 {
      return Err(WoffError::BoundsExceeded("WOFF 1.0 table data out of bounds"))
    }
    let padded_orig64 = ((orig64 + 3L) / 4L) * 4L
    cumulative_bytes = cumulative_bytes + padded_orig64
    if cumulative_bytes > eff_max64 {
      return Err(WoffError::LimitExceeded("WOFF 1.0 cumulative table size exceeds max_output_bytes"))
    }

    let off_i = off64.to_int()
    let comp_i = comp64.to_int()
    let orig_i = orig64.to_int()
    raw_tags[i] = tag
    tags[i] = tag
    offs[i] = off_i
    comps[i] = comp_i
    origs[i] = orig_i
    span_starts[i] = off_i
    span_ends[i] = off_i + comp_i
    i = i + 1
  }

  if has_duplicate_tags(tags, num_tables) {
    return Err(WoffError::InvalidTableDirectory("duplicate table tag in WOFF 1.0"))
  }
  if has_overlapping_spans(span_starts, span_ends, num_tables) {
    return Err(WoffError::InvalidTableDirectory("overlapping table data in WOFF 1.0"))
  }

  let tables : Array[Table] = []
  i = 0
  while i < num_tables {
    let tag = raw_tags[i]
    let off_i = offs[i]
    let comp_i = comps[i]
    let orig_i = origs[i]
    if comp_i < orig_i {
      let max_for_table = if orig_i > eff_max { eff_max } else { orig_i }
      let compressed_slice = data.slice(off_i, off_i + comp_i)
      let body = dec.zlib_decompress(compressed_slice, max_for_table)?
      if body.length() != orig_i {
        return Err(
          WoffError::BoundsExceeded(
            "WOFF 1.0 decompressed table length mismatch",
          ),
        )
      }
      tables.push(Table::{ tag: tag, data: body, start: 0, len: body.length() })
    } else {
      tables.push(Table::{ tag: tag, data: data, start: off_i, len: orig_i })
    }
    i = i + 1
  }

  assemble_sfnt(flavor, tables, eff_max, -1)
}

// --- WOFF 2.0 Decoder ---

fn decode_woff2(
  data : Bytes,
  dec : dyn Decompressor,
  limits : DecodeLimits,
) -> Result[Bytes, WoffError] {
  if data.length() < 48 {
    return Err(WoffError::TruncatedHeader("WOFF 2.0 header shorter than 48 bytes"))
  }
  let eff_max = effective_max_output(limits.max_output_bytes)
  let eff_max64 = eff_max.to_int64()
  let r = Reader::from_bytes(data)
  let _ = r.u32_u()? // signature already verified
  let flavor = r.u32_u()?
  let file_len = r.u32_u()?
  let num_tables = r.u16()?
  let _ = r.u16()? // reserved: WOFF 2.0 spec requires decoders to ignore it
  let _ = r.u32_u()? // totalSfntSize: advisory hint only
  let total_compressed_size = r.u32_u()?

  if flavor == tag_ttcf {
    return Err(WoffError::UnsupportedCollection)
  }
  if file_len.to_int64() != data.length().to_int64() {
    return Err(WoffError::BoundsExceeded("WOFF 2.0 length does not match input buffer"))
  }
  if num_tables == 0 {
    return Err(WoffError::InvalidTableDirectory("WOFF 2.0 numTables is 0"))
  }
  if limits.max_tables > 0 && num_tables > limits.max_tables {
    return Err(
      WoffError::LimitExceeded(
        "table count " + num_tables.to_string() + " exceeds max_tables (" + limits.max_tables.to_string() + ")",
      ),
    )
  }

  r.at = 48
  let entries : Array[TableEntry] = []
  let dir_tags : FixedArray[UInt] = FixedArray::make(num_tables, 0U)
  let mut has_glyf = false
  let mut has_loca = false
  let mut glyf_transformed = false
  let mut loca_transformed = false
  let mut has_hmtx_transformed = false
  let mut glyf_idx = -1
  let mut loca_idx = -1
  let mut hmtx_idx = -1
  let mut hhea_idx = -1
  let mut maxp_idx = -1
  let mut total_stream_bytes : Int64 = 0L

  let mut i = 0
  while i < num_tables {
    let f = match r.u8() {
      Ok(v) => v
      Err(_) => return Err(WoffError::InvalidTableDirectory("truncated table directory flags"))
    }
    let tag_idx = f & 0x3F
    let tag = if tag_idx == 0x3F {
      match r.u32_u() {
        Ok(v) => v
        Err(_) => return Err(WoffError::InvalidTableDirectory("truncated custom table tag"))
      }
    } else {
      known_tags[tag_idx]
    }
    dir_tags[i] = tag

    let version = (f >> 6) & 3
    let orig_u = r.base128()?
    if orig_u > 0x7FFFFFFFU {
      return Err(WoffError::BoundsExceeded("table origLength exceeds Int range"))
    }
    let orig_len = orig_u.to_int()

    let is_glyf_or_loca = tag == tag_glyf || tag == tag_loca
    let transformed = if is_glyf_or_loca {
      if version == 0 {
        true
      } else if version == 3 {
        false
      } else {
        return Err(WoffError::InvalidTableDirectory("invalid transform version for glyf/loca"))
      }
    } else if tag == tag_hmtx {
      if version == 0 {
        false
      } else if version == 1 {
        true
      } else {
        return Err(WoffError::InvalidTableDirectory("invalid transform version for hmtx"))
      }
    } else {
      if version != 0 {
        return Err(WoffError::InvalidTableDirectory("invalid non-zero transform version"))
      }
      false
    }

    let stream_len = if transformed {
      let tl_u = r.base128()?
      if tl_u > 0x7FFFFFFFU {
        return Err(WoffError::BoundsExceeded("table transformLength exceeds Int range"))
      }
      tl_u.to_int()
    } else {
      orig_len
    }

    if tag == tag_glyf {
      has_glyf = true
      glyf_transformed = transformed
      glyf_idx = i
    } else if tag == tag_loca {
      has_loca = true
      loca_transformed = transformed
      loca_idx = i
      if transformed && stream_len != 0 {
        return Err(WoffError::InvalidTableDirectory("transformed loca must have transformLength == 0"))
      }
    } else if tag == tag_hmtx {
      hmtx_idx = i
      if transformed {
        has_hmtx_transformed = true
      }
    } else if tag == tag_hhea {
      hhea_idx = i
    } else if tag == tag_maxp {
      maxp_idx = i
    }

    total_stream_bytes = total_stream_bytes + stream_len.to_int64()
    if total_stream_bytes > eff_max64 {
      return Err(WoffError::LimitExceeded("WOFF 2.0 decompressed stream exceeds max_output_bytes"))
    }

    entries.push(TableEntry::{
      tag: tag,
      orig_len: orig_len,
      stream_len: stream_len,
      transformed: transformed,
      transform_version: version,
    })
    i = i + 1
  }

  if has_duplicate_tags(dir_tags, num_tables) {
    return Err(WoffError::InvalidTableDirectory("duplicate table tag in WOFF 2.0"))
  }

  if has_glyf != has_loca {
    return Err(WoffError::InvalidTableDirectory("glyf and loca tables must both be present or both absent"))
  }
  if has_glyf && glyf_transformed != loca_transformed {
    return Err(WoffError::InvalidTableDirectory("glyf and loca transform flags must match"))
  }
  if has_hmtx_transformed && !(has_glyf && glyf_transformed) {
    return Err(WoffError::InvalidTableDirectory("transformed hmtx requires transformed glyf"))
  }

  let comp64 = total_compressed_size.to_int64()
  if r.at.to_int64() + comp64 > data.length().to_int64() {
    return Err(WoffError::BoundsExceeded("WOFF 2.0 compressed stream out of bounds"))
  }

  let comp_slice = data.slice(r.at, r.at + comp64.to_int())
  let expected_stream = total_stream_bytes.to_int()
  let all = dec.brotli_decode(comp_slice, expected_stream)?
  if all.length().to_int64() != total_stream_bytes {
    return Err(WoffError::BoundsExceeded("WOFF 2.0 decompressed stream length does not match table directory sum"))
  }

  // Build zero-copy Table views into `all`
  let tables : Array[Table] = []
  let mut at = 0
  i = 0
  while i < num_tables {
    let e = entries[i]
    tables.push(Table::{ tag: e.tag, data: all, start: at, len: e.stream_len })
    at = at + e.stream_len
    i = i + 1
  }

  // Reconstruct transformed glyf + loca
  let mut xmins : FixedArray[Int] = FixedArray::make(0, 0)
  let mut patch_head_loca_format = -1
  if glyf_idx >= 0 && glyf_transformed {
    let e = entries[glyf_idx]
    let (glyf_bytes, loca_bytes, x, idx_fmt) = rebuild_glyf(
      tables[glyf_idx].data,
      tables[glyf_idx].start,
      tables[glyf_idx].len,
      e.orig_len,
      limits,
      eff_max,
    )?
    xmins = x
    patch_head_loca_format = idx_fmt
    tables[glyf_idx].data = glyf_bytes
    tables[glyf_idx].start = 0
    tables[glyf_idx].len = glyf_bytes.length()
    if loca_idx >= 0 {
      if entries[loca_idx].orig_len != loca_bytes.length() {
        return Err(WoffError::GlyfReconstructionError("transformed loca origLength does not match reconstructed size"))
      }
      tables[loca_idx].data = loca_bytes
      tables[loca_idx].start = 0
      tables[loca_idx].len = loca_bytes.length()
    }
  }

  // Reconstruct transformed hmtx
  if hmtx_idx >= 0 && has_hmtx_transformed {
    if hhea_idx < 0 || tables[hhea_idx].len < 36 {
      return Err(WoffError::HmtxReconstructionError("missing or truncated hhea table"))
    }
    let metrics = read_u16_at(tables[hhea_idx].data, tables[hhea_idx].start + 34)

    if maxp_idx < 0 || tables[maxp_idx].len < 6 {
      return Err(WoffError::HmtxReconstructionError("missing or truncated maxp table"))
    }
    let count = read_u16_at(tables[maxp_idx].data, tables[maxp_idx].start + 4)
    if limits.max_glyphs > 0 && count > limits.max_glyphs {
      return Err(WoffError::LimitExceeded("maxp numGlyphs exceeds max_glyphs"))
    }
    if count != xmins.length() {
      return Err(WoffError::HmtxReconstructionError("maxp numGlyphs does not match glyf numGlyphs"))
    }

    let hmtx_bytes = rebuild_hmtx(
      tables[hmtx_idx].data,
      tables[hmtx_idx].start,
      tables[hmtx_idx].len,
      metrics,
      count,
      xmins,
      eff_max,
    )?
    tables[hmtx_idx].data = hmtx_bytes
    tables[hmtx_idx].start = 0
    tables[hmtx_idx].len = hmtx_bytes.length()
  }

  assemble_sfnt(flavor, tables, eff_max, patch_head_loca_format)
}

// --- Public API ---

///| Decode a WOFF2 (`wOF2`) or WOFF1 (`wOFF`) container using default limits and
///| built-in pure-Pion `brotli` and `flate` decompressors.
pub fn decode(data : Bytes) -> Result[Bytes, WoffError] {
  decode_with_limits(data, DecodeLimits::default())
}

///| Decode a WOFF2 (`wOF2`) or WOFF1 (`wOFF`) container with custom `DecodeLimits`.
pub fn decode_with_limits(
  data : Bytes,
  limits : DecodeLimits,
) -> Result[Bytes, WoffError] {
  let dec = DefaultDecompressor::{ dummy: 0 }
  decode_using(data, dec, limits)
}

///| Decode a WOFF2 (`wOF2`) or WOFF1 (`wOFF`) container using a custom `Decompressor`
///| and custom `DecodeLimits`.
pub fn decode_using(
  data : Bytes,
  dec : dyn Decompressor,
  limits : DecodeLimits,
) -> Result[Bytes, WoffError] {
  if data.length() < 4 {
    return Err(WoffError::TruncatedHeader("input shorter than 4-byte signature"))
  }
  let sig = read_u32_at(data, 0)
  if sig == tag_woff2 {
    decode_woff2(data, dec, limits)
  } else if sig == tag_woff1 {
    decode_woff1(data, dec, limits)
  } else {
    Err(WoffError::InvalidSignature("expected wOF2 or wOFF signature"))
  }
}
