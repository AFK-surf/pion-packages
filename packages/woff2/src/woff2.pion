  0x6670676DU, // 9:  "fpgm"
  0x676C7966U, // 10: "glyf"
  0x6C6F6361U, // 11: "loca"
  0x70726570U, // 12: "prep"
  0x43464620U, // 13: "CFF "
  0x564F5247U, // 14: "VORG"
  0x45424454U, // 15: "EBDT"
  0x45424C43U, // 16: "EBLC"
  0x67617370U, // 17: "gasp"
