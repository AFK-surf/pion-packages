///| Pion Native head-to-head benchmark for `packages/woff2`.
///| Usage: woff2_bench <woff_file> <iters> [dump_path]

import "woff2"
import "crypto"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn read_u16_be(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 8) | b[off + 1].to_int()
}

fn read_u32_be(b : Bytes, off : Int) -> UInt {
  (b[off].to_int().to_uint() << 24) |
  (b[off + 1].to_int().to_uint() << 16) |
  (b[off + 2].to_int().to_uint() << 8) |
  b[off + 3].to_int().to_uint()
}

fn fnv_byte(h : UInt64, v : Int) -> UInt64 {
  (h ^ (v & 255).to_int64().to_uint64()) * 1099511628211UL
}

fn fnv_slice(h0 : UInt64, b : Bytes, start : Int, len : Int) -> UInt64 {
  let mut h = h0
  let mut i = start
  let end = start + len
  while i < end {
    h = (h ^ b[i].to_int().to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn hex_u32(v : UInt) -> String {
  let out = Bytes::new(8)
  let mut i = 0
  let mut shift = 28
  while i < 8 {
    let nib = ((v >> shift) & 15U).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

///| Compute deterministic SFNT semantic summary across all tables and all glyph headers.
fn summarize_sfnt(sfnt : Bytes) -> (UInt, Int, UInt64, Int, Int, UInt64) {
  let flavor = read_u32_be(sfnt, 0)
  let num_tables = read_u16_be(sfnt, 4)
  let mut tables_h : UInt64 = 14695981039346656037UL
  let mut glyf_off = -1
  let mut loca_off = -1
  let mut head_off = -1
  let mut maxp_off = -1

  let mut i = 0
  while i < num_tables {
    let rec = 12 + i * 16
    let tag = read_u32_be(sfnt, rec)
    let off = read_u32_be(sfnt, rec + 8).to_int()
    let len = read_u32_be(sfnt, rec + 12).to_int()
    tables_h = fnv_slice(tables_h, sfnt, rec, 4)
    if tag == 0x676C7966U {
      glyf_off = off
    } else if tag == 0x6C6F6361U {
      loca_off = off
    } else if tag == 0x68656164U {
      head_off = off
      // Hash head table excluding checkSumAdjustment (bytes 8..12)
      if len >= 12 {
        tables_h = fnv_slice(tables_h, sfnt, off, 8)
        tables_h = fnv_slice(tables_h, sfnt, off + 12, len - 12)
      }
    } else {
      if tag == 0x6D617870U {
        maxp_off = off
      }
      tables_h = fnv_slice(tables_h, sfnt, off, len)
    }
    i = i + 1
  }

  let mut num_glyphs = 0
  let mut non_empty = 0
  let mut glyf_h : UInt64 = 14695981039346656037UL
  if glyf_off >= 0 && loca_off >= 0 && head_off >= 0 && maxp_off >= 0 {
    num_glyphs = read_u16_be(sfnt, maxp_off + 4)
    let idx_fmt = read_u16_be(sfnt, head_off + 50)
    let mut g = 0
    while g < num_glyphs {
      let (g0, g1) = if idx_fmt == 0 {
        (
          read_u16_be(sfnt, loca_off + g * 2) * 2,
          read_u16_be(sfnt, loca_off + (g + 1) * 2) * 2,
        )
      } else {
        (
          read_u32_be(sfnt, loca_off + g * 4).to_int(),
          read_u32_be(sfnt, loca_off + (g + 1) * 4).to_int(),
        )
      }
      if g1 > g0 {
        non_empty = non_empty + 1
        // Hash 10-byte glyph header (nContours, xMin, yMin, xMax, yMax)
        glyf_h = fnv_slice(glyf_h, sfnt, glyf_off + g0, 10)
      } else {
        glyf_h = fnv_byte(glyf_h, 0)
      }
      g = g + 1
    }
  }
  (flavor, num_tables, tables_h, num_glyphs, non_empty, glyf_h)
}

///| Compute full canonical SFNT SHA-256 across EVERY table payload (including full `glyf` and `loca`,
///| with `head.checkSumAdjustment` zeroed so physical table layout order does not affect identity).
fn canonical_sfnt_sha256(sfnt : Bytes) -> String {
  let hasher = crypto::Sha256::new()
  hasher.update_slice(sfnt, 0, 6) // flavor + numTables
  let num_tables = read_u16_be(sfnt, 4)
  let zeros4 = Bytes::new(4)
  let mut i = 0
  while i < num_tables {
    let rec = 12 + i * 16
    let tag = read_u32_be(sfnt, rec)
    let off = read_u32_be(sfnt, rec + 8).to_int()
    let len = read_u32_be(sfnt, rec + 12).to_int()
    hasher.update_slice(sfnt, rec, rec + 4) // tag
    hasher.update_slice(sfnt, rec + 12, rec + 16) // length
    if tag == 0x68656164U && len >= 12 {
      hasher.update_slice(sfnt, off, off + 8)
      hasher.update(zeros4)
      hasher.update_slice(sfnt, off + 12, off + len)
    } else {
      hasher.update_slice(sfnt, off, off + len)
    }
    i = i + 1
  }
  hasher.finalize_hex()
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: woff2_bench <woff_file> <iters> [dump_path]")
    return 1
  }
  let path = args[1]
  let iters = parse_int(args[2])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }

  let mut last_out = Bytes::new(0)
  let mut i = 0
  while i < iters {
    match woff2::decode(data) {
      Ok(out) => last_out = out
      Err(e) => {
        io_println(world, "decode error: " + woff2::woff_error_message(e))
        return 1
      }
    }
    i = i + 1
  }

  if args.length() >= 4 {
    let _ = fs_write_bytes(world, args[3], last_out)
  }

  let (flavor, num_tables, tables_h, num_glyphs, non_empty, glyf_h) = summarize_sfnt(last_out)
  let sfnt_sha256 = canonical_sfnt_sha256(last_out)
  io_println(
    world,
    "iters=" + iters.to_string() +
    " flavor=" + hex_u32(flavor) +
    " tables=" + num_tables.to_string() +
    " tables_fnv64=" + hex_u64(tables_h) +
    " glyphs=" + num_glyphs.to_string() +
    " non_empty=" + non_empty.to_string() +
    " glyf_hdr_fnv64=" + hex_u64(glyf_h) +
    " sfnt_bytes=" + last_out.length().to_string() +
    " full_sfnt_sha256=" + sfnt_sha256,
  )
  0
}
