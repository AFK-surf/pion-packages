///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/woff2`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "woff2"
import "flate"

fn push_u16(w : Array[Int], v : Int) -> Unit {
  w.push((v >> 8) & 255)
  w.push(v & 255)
}

fn push_u32(w : Array[Int], v : UInt) -> Unit {
  w.push(((v >> 24) & 0xFFU).to_int())
  w.push(((v >> 16) & 0xFFU).to_int())
  w.push(((v >> 8) & 0xFFU).to_int())
  w.push((v & 0xFFU).to_int())
}

fn push_b128(w : Array[Int], v : Int) -> Unit {
  if v < 0x80 {
    w.push(v)
  } else if v < 0x4000 {
    w.push(((v >> 7) & 0x7F) | 0x80)
    w.push(v & 0x7F)
  } else {
    w.push(((v >> 14) & 0x7F) | 0x80)
    w.push(((v >> 7) & 0x7F) | 0x80)
    w.push(v & 0x7F)
  }
}

fn push_bytes(w : Array[Int], b : Bytes) -> Unit {
  let mut i = 0
  while i < b.length() {
    w.push(b[i].to_int())
    i = i + 1
  }
}

fn to_bytes(a : Array[Int]) -> Bytes {
  let b = Bytes::new(a.length())
  let mut i = 0
  while i < a.length() {
    b[i] = (a[i] & 255).to_byte()
    i = i + 1
  }
  b
}

fn fnv1a_32(data : Bytes) -> UInt {
  let mut h : UInt = 2166136261U
  let mut i = 0
  let n = data.length()
  while i < n {
    h = (h ^ data[i].to_int().to_uint()) * 16777619U
    i = i + 1
  }
  h
}

fn brotli_uncompressed(payload : Bytes) -> Bytes {
  let out : Array[Int] = []
  let mlen_minus1 = payload.length() - 1
  let hdr = (mlen_minus1 << 4) | (1 << 20)
  out.push(hdr & 0xFF)
  out.push((hdr >> 8) & 0xFF)
  out.push((hdr >> 16) & 0xFF)
  push_bytes(out, payload)
  out.push(0x03)
  to_bytes(out)
}

fn make_head(idx_fmt : Int) -> Bytes {
  let b = Bytes::new(54)
  b[1] = (1).to_byte()
  b[12] = (0x5F).to_byte()
  b[13] = (0x0F).to_byte()
  b[14] = (0x3C).to_byte()
  b[15] = (0xF5).to_byte()
  b[18] = (0x03).to_byte()
  b[19] = (0xE8).to_byte()
  b[50] = ((idx_fmt >> 8) & 255).to_byte()
  b[51] = (idx_fmt & 255).to_byte()
  b
}

fn build_smoke_woff2() -> Bytes {
  let head = make_head(0)
  let hhea = Bytes::new(36)
  hhea[1] = (1).to_byte()
  hhea[35] = (2).to_byte()
  let maxp = Bytes::new(6)
  maxp[1] = (1).to_byte()
  maxp[5] = (2).to_byte()

  // 2 glyphs: glyph 0 empty, glyph 1 simple triangle
  let s_ncont : Array[Int] = []
  push_u16(s_ncont, 0)
  push_u16(s_ncont, 1)
  let s_npts : Array[Int] = [3]
  let s_flags : Array[Int] = [87, 11, 214]
  let s_glyph : Array[Int] = [9, 19, 100, 49, 99, 0]
  let s_bbox : Array[Int] = [0, 0, 0, 0]
  let gt : Array[Int] = []
  push_u16(gt, 0)
  push_u16(gt, 0)
  push_u16(gt, 2)
  push_u16(gt, 0)
  push_u32(gt, s_ncont.length().to_uint())
  push_u32(gt, s_npts.length().to_uint())
  push_u32(gt, s_flags.length().to_uint())
  push_u32(gt, s_glyph.length().to_uint())
  push_u32(gt, 0U)
  push_u32(gt, s_bbox.length().to_uint())
  push_u32(gt, 0U)
  push_bytes(gt, to_bytes(s_ncont))
  push_bytes(gt, to_bytes(s_npts))
  push_bytes(gt, to_bytes(s_flags))
  push_bytes(gt, to_bytes(s_glyph))
  push_bytes(gt, to_bytes(s_bbox))
  let glyf_t = to_bytes(gt)

  let hmtx_arr : Array[Int] = [1]
  push_u16(hmtx_arr, 500)
  push_u16(hmtx_arr, 600)
  let hmtx_t = to_bytes(hmtx_arr)

  let raw : Array[Int] = []
  push_bytes(raw, head)
  push_bytes(raw, hhea)
  push_bytes(raw, hmtx_t)
  push_bytes(raw, maxp)
  push_bytes(raw, glyf_t)
  let br = brotli_uncompressed(to_bytes(raw))

  let dir : Array[Int] = []
  dir.push(1)
  push_b128(dir, head.length())
  dir.push(2)
  push_b128(dir, hhea.length())
  dir.push(67)
  push_b128(dir, 8)
  push_b128(dir, hmtx_t.length())
  dir.push(4)
  push_b128(dir, maxp.length())
  dir.push(10)
  push_b128(dir, 64)
  push_b128(dir, glyf_t.length())
  dir.push(11)
  push_b128(dir, 6)
  push_b128(dir, 0)

  let buf : Array[Int] = []
  let total_len = 48 + dir.length() + br.length()
  push_u32(buf, 0x774F4632U)
  push_u32(buf, 0x00010000U)
  push_u32(buf, total_len.to_uint())
  push_u16(buf, 6)
  push_u16(buf, 0)
  push_u32(buf, 256U)
  push_u32(buf, br.length().to_uint())
  push_u16(buf, 1)
  push_u16(buf, 0)
  push_u32(buf, 0U)
  push_u32(buf, 0U)
  push_u32(buf, 0U)
  push_u32(buf, 0U)
  push_u32(buf, 0U)
  push_bytes(buf, to_bytes(dir))
  push_bytes(buf, br)
  to_bytes(buf)
}

fn build_smoke_woff1() -> Bytes {
  let head = make_head(0)
  let head_z = flate::zlib_compress_default(head)
  let name = to_bytes([0x11, 0x22, 0x33, 0x44, 0x55])
  let off_name = 84
  let off_head = off_name + 8
  let total_len = off_head + ((head_z.length() + 3) / 4) * 4

  let buf : Array[Int] = []
  push_u32(buf, 0x774F4646U)
  push_u32(buf, 0x00010000U)
  push_u32(buf, total_len.to_uint())
  push_u16(buf, 2)
  push_u16(buf, 0)
  push_u32(buf, 128U)
  push_u16(buf, 1)
  push_u16(buf, 0)
  push_u32(buf, 0U)
  push_u32(buf, 0U)
  push_u32(buf, 0U)
  push_u32(buf, 0U)
  push_u32(buf, 0U)
  // Entry 0: name (uncompressed)
  push_u32(buf, 0x6E616D65U)
  push_u32(buf, off_name.to_uint())
  push_u32(buf, name.length().to_uint())
  push_u32(buf, name.length().to_uint())
  push_u32(buf, 0U)
  // Entry 1: head (zlib compressed)
  push_u32(buf, 0x68656164U)
  push_u32(buf, off_head.to_uint())
  push_u32(buf, head_z.length().to_uint())
  push_u32(buf, head.length().to_uint())
  push_u32(buf, 0U)

  push_bytes(buf, name)
  while buf.length() % 4 != 0 {
    buf.push(0)
  }
  push_bytes(buf, head_z)
  while buf.length() % 4 != 0 {
    buf.push(0)
  }
  to_bytes(buf)
}

pub fn main(world : World) -> Int {
  let w2 = build_smoke_woff2()
  let sfnt2 = match woff2::decode(w2) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR woff2: " + woff2::woff_error_message(e))
      return 1
    }
  }

  let w1 = build_smoke_woff1()
  let sfnt1 = match woff2::decode(w1) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR woff1: " + woff2::woff_error_message(e))
      return 2
    }
  }

  // Verify DecodeLimits rejection
  let lim_ok = match woff2::decode_with_limits(w2, woff2::DecodeLimits::new(65536, 2, 100)) {
    Err(woff2::WoffError::LimitExceeded(_)) => true
    _ => false
  }
  if !lim_ok {
    io_println(world, "ERR limit not enforced")
    return 3
  }

  io_println(world, "woff2_wasm_smoke:ok")
  io_println(
    world,
    "woff2_len=" + sfnt2.length().to_string() +
    " woff2_fnv=" + fnv1a_32(sfnt2).to_int64().to_string(),
  )
  io_println(
    world,
    "woff1_len=" + sfnt1.length().to_string() +
    " woff1_fnv=" + fnv1a_32(sfnt1).to_int64().to_string(),
  )
  0
}
