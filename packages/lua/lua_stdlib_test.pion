///| Lua 5.4 compliance tests: standard libraries `base`, `table`, `string` (incl. patterns),
///| `math`, and `utf8`.

test "lua_stdlib_base" {
  let src = "local t = {a = 1, b = 2}\nrawset(t, 'c', 3)\nlocal ok1 = type(nil) == 'nil' and type(true) == 'boolean' and type(1) == 'number' and type('x') == 'string' and type(t) == 'table' and type(print) == 'function'\nlocal ok2 = tonumber('42') == 42 and tonumber('ff', 16) == 255 and tonumber('1010', 2) == 10 and tonumber('nope') == nil\nlocal ok3 = rawget(t, 'c') == 3 and rawequal(1, 1) and not rawequal({}, {}) and rawlen('abcd') == 4\nlocal ok4 = assert(123) == 123\nlocal k, v = next({only = 99})\nlocal ok5 = (k == 'only' and v == 99)\nreturn ok1 and ok2 and ok3 and ok4 and ok5"
  assert_lua_bool(src, true, "base stdlib functions")
}

test "lua_stdlib_table" {
  let src = "local t = {30, 10, 40, 20}\ntable.insert(t, 50)\ntable.insert(t, 2, 15)\nlocal rem = table.remove(t, 2)\ntable.sort(t)\nlocal s1 = table.concat(t, ',')\ntable.sort(t, function(a, b) return a > b end)\nlocal s2 = table.concat(t, '-', 1, 3)\nlocal dst = {}\ntable.move(t, 1, 3, 1, dst)\nlocal p = table.pack(7, 8, 9)\nlocal u1, u2, u3 = table.unpack(p, 1, p.n)\nreturn rem == 15 and s1 == '10,20,30,40,50' and s2 == '50-40-30' and #dst == 3 and (u1 + u2 + u3 == 24)"
  assert_lua_bool(src, true, "table stdlib functions")
}

test "lua_stdlib_string_basic_and_format" {
  let src = "local s = 'Hello, Lua!'\nlocal ok1 = string.len(s) == 11 and s:sub(1, 5) == 'Hello' and s:sub(-4, -2) == 'Lua'\nlocal ok2 = string.byte('ABC', 2) == 66 and string.char(65, 66, 67) == 'ABC'\nlocal ok3 = string.rep('ab', 3, '-') == 'ab-ab-ab' and string.reverse('abcd') == 'dcba'\nlocal ok4 = string.lower('AbC') == 'abc' and string.upper('AbC') == 'ABC'\nlocal f1 = string.format('%s=%04d hex=%x %.2f %%', 'id', 7, 255, 3.14159)\nlocal ok5 = (f1 == 'id=0007 hex=ff 3.14 %')\nreturn ok1 and ok2 and ok3 and ok4 and ok5"
  assert_lua_bool(src, true, "string basic + methods + format")
}

test "lua_stdlib_string_patterns_find_match_gmatch_gsub" {
  // find, match, captures, character classes, %b(), sets
  let src1 = "local i, j, k, v = string.find('key=12345;', '(%a+)=(%d+)')\nlocal bal = string.match('a(b(c)d)e', '%b()')\nlocal non_greedy = string.match('<a><b>', '<.->')\nreturn i == 1 and j == 9 and k == 'key' and v == '12345' and bal == '(b(c)d)' and non_greedy == '<a>'"
  assert_lua_bool(src1, true, "string.find/match classes, captures, %b(), lazy -")

  // gmatch iterator
  let src2 = "local sum = 0\nfor num in string.gmatch('x=10, y=20, z=30', '%d+') do\n  sum = sum + tonumber(num)\nend\nreturn sum"
  assert_lua_int(src2, 60L, "string.gmatch")

  // gsub with string template, table, and function
  let src3 = "local s1, n1 = string.gsub('hello world', '(%w+)', '%1-%1')\nlocal s2 = string.gsub('$a + $b', '%$(%w+)', {a = '1', b = '2'})\nlocal s3 = string.gsub('1,2,3', '%d+', function(d) return tostring(tonumber(d) * 10) end)\nreturn s1 == 'hello-hello world-world' and n1 == 2 and s2 == '1 + 2' and s3 == '10,20,30'"
  assert_lua_bool(src3, true, "string.gsub string/table/function")
}

test "lua_stdlib_math_and_utf8" {
  let src_math = "local ok1 = math.abs(-42) == 42 and math.floor(3.7) == 3 and math.ceil(3.2) == 4\nlocal ok2 = math.min(5, 2, 9) == 2 and math.max(5, 2, 9) == 9\nlocal ok3 = math.abs(math.sqrt(9) - 3) < 1e-9 and math.abs(math.sin(0)) < 1e-9 and math.abs(math.cos(0) - 1) < 1e-9\nlocal ok4 = math.abs(math.log(math.exp(2)) - 2) < 1e-9 and math.abs(math.log(8, 2) - 3) < 1e-9\nlocal intp, fracp = math.modf(3.25)\nlocal ok5 = intp == 3 and math.abs(fracp - 0.25) < 1e-9 and math.abs(math.fmod(7.5, 2) - 1.5) < 1e-9\nlocal ok6 = math.type(1) == 'integer' and math.type(1.0) == 'float' and math.tointeger(5.0) == 5 and math.ult(1, -1)\nreturn ok1 and ok2 and ok3 and ok4 and ok5 and ok6"
  assert_lua_bool(src_math, true, "math stdlib")

  let src_utf8 = "local s = 'A中文😀'\nlocal ok1 = utf8.len(s) == 4\nlocal c1, c2, c3, c4 = utf8.codepoint(s, 1, #s)\nlocal ok2 = c1 == 65 and c2 == 0x4E2D and c3 == 0x6587 and c4 == 0x1F600\nlocal ok3 = utf8.char(65, 0x4E2D, 0x6587, 0x1F600) == s\nlocal cnt = 0\nfor pos, cp in utf8.codes(s) do cnt = cnt + 1 end\nlocal ok4 = cnt == 4 and utf8.offset(s, 3) == 5\nreturn ok1 and ok2 and ok3 and ok4"
  assert_lua_bool(src_utf8, true, "utf8 stdlib")
}
