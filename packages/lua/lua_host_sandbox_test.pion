///| Lua 5.4 compliance tests: host interop (globals, tables, `register_fn`, `Chunk` reuse,
///| `print` buffer) and deterministic `LuaLimits` sandbox DoS protections.

test "lua_host_interop_globals_tables_callbacks_and_chunk_reuse" {
  let vm = LuaVm::new()
  vm.set_global("host_x", LuaValue::int(21L))
  let tid = vm.new_table()
  let _ = vm.table_set(tid, LuaValue::str("factor"), LuaValue::int(2L))
  vm.set_global("cfg", LuaValue::table(tid))
  vm.register_fn("host_add", fn(_v, args) {
    let mut sum = 0L
    let mut i = 0
    while i < args.length() {
      match args[i].as_int() {
        Some(n) => sum = sum + n
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "expected int", 0))
      }
      i = i + 1
    }
    Ok([LuaValue::int(sum)])
  })

  let chunk = match compile("print('res', host_add(host_x, cfg.factor)); return host_x * cfg.factor") {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "compile failed: " + e.to_string())
      return
    }
  }
  match vm.exec_chunk(chunk) {
    Ok(vals) => {
      debug_assert(vals.length() == 1, "chunk exec len")
      debug_assert(value_strict_eq(vals[0], LuaValue::int(42L)), "chunk exec result == 42")
    }
    Err(e) => debug_assert(false, "exec_chunk failed: " + e.to_string())
  }
  debug_assert(vm.output() == "res\t23\n", "print buffer mismatch: " + vm.output())
  debug_assert(vm.fuel_used() > 0L, "fuel_used should be positive")

  // Re-execute same compiled chunk with updated global
  vm.clear_output()
  vm.set_global("host_x", LuaValue::int(100L))
  match vm.exec_chunk(chunk) {
    Ok(vals) => debug_assert(value_strict_eq(vals[0], LuaValue::int(200L)), "chunk reuse == 200")
    Err(e) => debug_assert(false, "chunk reuse failed: " + e.to_string())
  }
  debug_assert(vm.output() == "res\t102\n", "print buffer after reuse")
}

test "lua_sandbox_limits_fuel_stack_memory_output_and_pcall_unbypassable" {
  // 1. Infinite loop fuel bomb (even wrapped in pcall!)
  let tight_fuel = LuaLimits::new(2000L, 64, 1024, 1048576, 4096)
  match eval_with_limits("pcall(function() while true do end end)", tight_fuel) {
    Ok(_) => debug_assert(false, "infinite loop must fail with FuelLimit")
    Err(e) => debug_assert(e.is_kind(LuaErrorKind::FuelLimit), "expected FuelLimit, got " + e.to_string())
  }

  // 2. Pattern backtracking bomb must hit FuelLimit
  match eval_with_limits("return string.find(string.rep('a', 30) .. 'b', 'a*a*a*a*a*a*c')", tight_fuel) {
    Ok(_) => debug_assert(false, "pattern backtracking bomb must fail with FuelLimit")
    Err(e) => debug_assert(e.is_kind(LuaErrorKind::FuelLimit), "expected FuelLimit on pattern bomb, got " + e.to_string())
  }

  // 3. Non-tail recursion stack bomb (unbypassable by pcall)
  let tight_stack = LuaLimits::new(500000L, 32, 1024, 1048576, 4096)
  match eval_with_limits("local function f(n) return 1 + f(n + 1) end; pcall(f, 0)", tight_stack) {
    Ok(_) => debug_assert(false, "non-tail recursion bomb must fail with StackLimit")
    Err(e) => debug_assert(e.is_kind(LuaErrorKind::StackLimit), "expected StackLimit, got " + e.to_string())
  }

  // 4. Memory allocation bomb
  let tight_mem = LuaLimits::new(500000L, 64, 1024, 4096, 4096)
  match eval_with_limits("local s = '12345678'; for i = 1, 20 do s = s .. s end", tight_mem) {
    Ok(_) => debug_assert(false, "memory bomb must fail with MemoryLimit")
    Err(e) => debug_assert(e.is_kind(LuaErrorKind::MemoryLimit), "expected MemoryLimit, got " + e.to_string())
  }

  // 5. Output buffer flood
  let tight_out = LuaLimits::new(500000L, 64, 1024, 1048576, 64)
  match eval_with_limits("for i = 1, 50 do print('0123456789') end", tight_out) {
    Ok(_) => debug_assert(false, "output flood must fail with OutputLimit")
    Err(e) => debug_assert(e.is_kind(LuaErrorKind::OutputLimit), "expected OutputLimit, got " + e.to_string())
  }
}
