///| Lua 5.4 compliance tests: 64-bit int & IEEE-754 float arithmetic, bitwise ops,
///| tables (array + hash + `#t`), closures & open/closed upvalues, `pcall`/`xpcall`/`error`.

test "lua_arithmetic_int64_float_idiv_mod_pow_bitwise" {
  // Integer-preserving ops
  assert_lua_int("return 7 + 8 * 2", 23L, "int add mul")
  assert_lua_int("return 7 // 2", 3L, "int idiv pos")
  assert_lua_int("return -7 // 2", -4L, "int idiv floor neg")
  assert_lua_int("return 7 // -2", -4L, "int idiv floor neg divisor")
  assert_lua_int("return -7 % 3", 2L, "lua modulo neg")
  assert_lua_int("return 7 % -3", -2L, "lua modulo neg divisor")
  // Float division & power always return Float
  assert_lua_float_near("return 7 / 2", 3.5, 0.000001, "float div")
  assert_lua_float_near("return 4 / 2", 2.0, 0.000001, "4/2 is float")
  assert_lua_float_near("return 2 ^ 10", 1024.0, 0.000001, "pow is float")
  assert_lua_float_near("return 7.5 // 2", 3.0, 0.000001, "float idiv")
  // Bitwise ops
  assert_lua_int("return 0xF0 & 0x3C", 0x30L, "band")
  assert_lua_int("return 0xF0 | 0x0F", 0xFFL, "bor")
  assert_lua_int("return 0xFF ~ 0x0F", 0xF0L, "bxor")
  assert_lua_int("return ~0", -1L, "bnot 0")
  assert_lua_int("return 1 << 10", 1024L, "shl")
  assert_lua_int("return 1024 >> 3", 128L, "shr")
  assert_lua_int("return (-1) >> 60", 15L, "logical shr on negative int64")
  assert_lua_int("return 1 << -2", 0L, "negative shift")
  assert_lua_int("return 16 << -2", 4L, "negative shl acts as shr")
  // Coercions
  assert_lua_int("return '10' + 5", 15L, "str+int coercion")
  assert_lua_float_near("return '3.5' * 2", 7.0, 0.000001, "str*int float coercion")
  assert_lua_str("return 'v' .. 42", "v42", "concat number coercion")
  // Division by zero on integer
  assert_lua_err("return 1 // 0", LuaErrorKind::RuntimeError, "int idiv by zero")
  assert_lua_err("return 1 % 0", LuaErrorKind::RuntimeError, "int mod by zero")
}

test "lua_tables_array_hash_len_and_keys" {
  let src = "local t = {10, 20, 30, a = 1, b = 2}\nt[4] = 40\nt['c'] = 3\nreturn #t, t[1] + t[4] + t.a + t.b + t.c"
  match eval(src) {
    Ok(vals) => {
      debug_assert(vals.length() == 2, "table: expected 2 return values")
      debug_assert(value_strict_eq(vals[0], LuaValue::int(4L)), "table len == 4")
      debug_assert(value_strict_eq(vals[1], LuaValue::int(56L)), "table sum == 56")
    }
    Err(e) => debug_assert(false, "table test failed: " + e.to_string())
  }

  // Table and function as table keys + nil deletion
  let src_keys = "local k1, k2 = {}, {}\nlocal map = {[k1] = 'one', [k2] = 'two', [true] = 'yes'}\nmap[k1] = nil\nreturn (map[k1] == nil) and (map[k2] == 'two') and (map[true] == 'yes')"
  assert_lua_bool(src_keys, true, "table and bool keys + nil delete")

  // Integer / Float key equivalence: t[1] and t[1.0] refer to the same slot
  let src_numkey = "local t = {}\nt[1.0] = 'hello'\nreturn t[1]"
  assert_lua_str(src_numkey, "hello", "1.0 and 1 are identical table keys")
}

test "lua_closures_and_shared_mutable_upvalues" {
  // Classic counter factory (closed upvalue)
  let src_counter = "local function make_counter(start)\n  local n = start\n  return function(step)\n    n = n + (step or 1)\n    return n\n  end\nend\nlocal c1 = make_counter(10)\nlocal c2 = make_counter(100)\nreturn c1() + c1(5) + c2()"
  assert_lua_int(src_counter, 128L, "independent closed upvalues")

  // Two closures sharing the SAME mutable upvalue (open -> closed)
  let src_shared = "local function make_pair()\n  local x = 0\n  local function inc(d) x = x + d end\n  local function get() return x end\n  return inc, get\nend\nlocal inc, get = make_pair()\ninc(3)\ninc(4)\nreturn get()"
  assert_lua_int(src_shared, 7L, "shared mutable upvalue across two closures")

  // Loop-scoped upvalues: each iteration of `for` must close its own fresh upvalue!
  let src_loop = "local fns = {}\nfor i = 1, 5 do\n  local v = i * 10\n  fns[i] = function() return v end\nend\nreturn fns[1]() + fns[3]() + fns[5]()"
  assert_lua_int(src_loop, 90L, "per-iteration closed upvalues in for loop")

  // Nested 3-level upvalue forwarding (grandparent -> parent -> child)
  let src_deep = "local function a(x)\n  return function(y)\n    return function(z)\n      x = x + y + z\n      return x\n    end\n  end\nend\nlocal f = a(1)(2)\nreturn f(3) + f(4)"
  assert_lua_int(src_deep, 18L, "3-level nested upvalue mutation")
}

test "lua_pcall_xpcall_and_error_handling" {
  let src_ok = "local ok, a, b = pcall(function(x) return x + 1, x + 2 end, 10)\nreturn ok and a == 11 and b == 12"
  assert_lua_bool(src_ok, true, "pcall success with multireturn")

  let src_err = "local ok, msg = pcall(function() error('kaboom') end)\nreturn (not ok) and (string.find(msg, 'kaboom', 1, true) ~= nil)"
  assert_lua_bool(src_err, true, "pcall catches user error")

  let src_rt = "local ok, msg = pcall(function() local x = nil; return x + 1 end)\nreturn (not ok) and (type(msg) == 'string')"
  assert_lua_bool(src_rt, true, "pcall catches runtime type error")

  let src_xp = "local ok, msg = xpcall(function() error('oops') end, function(e) return 'handled:' .. tostring(e) end)\nreturn (not ok) and (string.find(msg, 'handled:', 1, true) == 1)"
  assert_lua_bool(src_xp, true, "xpcall invokes message handler")
}
