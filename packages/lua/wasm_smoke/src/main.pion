///| Wasm32 + Native 4-mode smoke entry for `packages/lua`.

import "lua"

///|
pub fn smoke() -> Int {
  // 1. Closures, shared upvalues, metatable OOP, Lua patterns, and UTF-8
  let s1 = "local Vec = {}\nVec.__index = Vec\nfunction Vec.new(x, y) return setmetatable({x = x, y = y}, Vec) end\nfunction Vec.__add(a, b) return Vec.new(a.x + b.x, a.y + b.y) end\nfunction Vec:__tostring() return string.format('(%d,%d)', self.x, self.y) end\nlocal v = Vec.new(3, 4) + Vec.new(7, 6)\nlocal out = string.gsub('a=10, b=20', '(%a+)=(%d+)', function(k, n) return k .. ':' .. tostring(tonumber(n) * 2) end)\nreturn tostring(v) .. '|' .. out .. '|' .. tostring(utf8.len('A中文😀'))"
  match lua::eval(s1) {
    Ok(vals) => {
      if vals.length() != 1 || !lua::value_strict_eq(vals[0], lua::LuaValue::str("(10,10)|a:20, b:40|4")) {
        return -1
      }
    }
    Err(_) => return -2
  }

  // 2. 100,000-deep tail recursion under tight max_call_depth = 64 (0 stack overflow on Wasm32)
  let s2 = "local function tco(n, acc)\n  if n == 0 then return acc end\n  return tco(n - 1, acc + 1)\nend\nreturn tco(100000, 0)"
  let tco_limits = lua::LuaLimits::new(50000000L, 64, 1024, 16777216, 65536)
  match lua::eval_with_limits(s2, tco_limits) {
    Ok(vals) => {
      if vals.length() != 1 || !lua::value_strict_eq(vals[0], lua::LuaValue::int(100000L)) {
        return -3
      }
    }
    Err(_) => return -4
  }

  // 3. Sandbox DoS limits (fuel bomb, backtracking bomb, stack bomb, memory bomb, output bomb)
  let tight_fuel = lua::LuaLimits::new(2000L, 64, 1024, 1048576, 4096)
  match lua::eval_with_limits("pcall(function() while true do end end)", tight_fuel) {
    Ok(_) => return -5
    Err(e) => if !e.is_kind(lua::LuaErrorKind::FuelLimit) { return -6 }
  }
  match lua::eval_with_limits("return string.find(string.rep('a', 30) .. 'b', 'a*a*a*a*a*a*c')", tight_fuel) {
    Ok(_) => return -7
    Err(e) => if !e.is_kind(lua::LuaErrorKind::FuelLimit) { return -8 }
  }
  let tight_stack = lua::LuaLimits::new(500000L, 32, 1024, 1048576, 4096)
  match lua::eval_with_limits("local function f(n) return 1 + f(n + 1) end; pcall(f, 0)", tight_stack) {
    Ok(_) => return -9
    Err(e) => if !e.is_kind(lua::LuaErrorKind::StackLimit) { return -10 }
  }
  let tight_mem = lua::LuaLimits::new(500000L, 64, 1024, 4096, 4096)
  match lua::eval_with_limits("local s = '12345678'; for i = 1, 20 do s = s .. s end", tight_mem) {
    Ok(_) => return -11
    Err(e) => if !e.is_kind(lua::LuaErrorKind::MemoryLimit) { return -12 }
  }
  let tight_out = lua::LuaLimits::new(500000L, 64, 1024, 1048576, 64)
  match lua::eval_with_limits("for i = 1, 50 do print('0123456789') end", tight_out) {
    Ok(_) => return -13
    Err(e) => if !e.is_kind(lua::LuaErrorKind::OutputLimit) { return -14 }
  }

  // 4. Compiled Chunk reuse + host register_fn + print capture
  let vm = lua::LuaVm::new()
  vm.register_fn("mul2", fn(_v, args) {
    match args[0].as_int() {
      Some(n) => Ok([lua::LuaValue::int(n * 2L)])
      None => Err(lua::LuaError::new(lua::LuaErrorKind::TypeError, "int expected", 0))
    }
  })
  let chunk = match lua::compile("print(mul2(x)); return mul2(x) + 1") {
    Ok(c) => c
    Err(_) => return -15
  }
  vm.set_global("x", lua::LuaValue::int(20L))
  match vm.exec_chunk(chunk) {
    Ok(vals) => {
      if vals.length() != 1 || !lua::value_strict_eq(vals[0], lua::LuaValue::int(41L)) {
        return -16
      }
    }
    Err(_) => return -17
  }
  if vm.output() != "40\n" {
    return -18
  }
  4
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "lua_wasm_smoke: OK checks=" + r.to_string())
    0
  } else {
    io_println(world, "lua_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
