///| Compact 64-bit register bytecode instruction encoding and function prototype (`Proto`).
///|
///| Instruction layout (64-bit `Int64`):
///| - bits  0..7 : opcode (0..255)
///| - bits  8..23: A (unsigned 16-bit: 0..65535)
///| - bits 24..39: B (unsigned 16-bit: 0..65535)
///| - bits 40..55: C (unsigned 16-bit: 0..65535)
///| - OR sBx in bits 24..47 (24-bit signed offset biased by 8388608)

let OP_MOVE : Int = 0
let OP_LOADK : Int = 1
let OP_LOADNIL : Int = 2
let OP_LOADBOOL : Int = 3
let OP_LOADI : Int = 4
let OP_GETUPVAL : Int = 5
let OP_SETUPVAL : Int = 6
let OP_GETTABUP : Int = 7
let OP_SETTABUP : Int = 8
let OP_GETTABLE : Int = 9
let OP_SETTABLE : Int = 10
let OP_GETFIELD : Int = 11
let OP_SETFIELD : Int = 12
let OP_NEWTABLE : Int = 13
let OP_SETLIST : Int = 14
let OP_SELF : Int = 15
let OP_ADD : Int = 16
let OP_SUB : Int = 17
let OP_MUL : Int = 18
let OP_DIV : Int = 19
let OP_IDIV : Int = 20
let OP_MOD : Int = 21
let OP_POW : Int = 22
let OP_BAND : Int = 23
let OP_BOR : Int = 24
let OP_BXOR : Int = 25
let OP_SHL : Int = 26
let OP_SHR : Int = 27
let OP_UNM : Int = 28
let OP_BNOT : Int = 29
let OP_NOT : Int = 30
let OP_LEN : Int = 31
let OP_CONCAT : Int = 32
let OP_EQ : Int = 33
let OP_LT : Int = 34
let OP_LE : Int = 35
let OP_TEST : Int = 36
let OP_TESTSET : Int = 37
let OP_JMP : Int = 38
let OP_CALL : Int = 39
let OP_TAILCALL : Int = 40
let OP_RETURN : Int = 41
let OP_FORPREP : Int = 42
let OP_FORLOOP : Int = 43
let OP_TFORCALL : Int = 44
let OP_TFORLOOP : Int = 45
let OP_CLOSURE : Int = 46
let OP_VARARG : Int = 47
let OP_CLOSE : Int = 48
let OP_LOADKX : Int = 49
let OP_EXTRAARG : Int = 50
let OP_TBC : Int = 51

let SBX_BIAS : Int = 8388608

///|
fn enc_abc(op : Int, a : Int, b : Int, c : Int) -> Int64 {
  let op64 = (op & 0xFF).to_int64()
  let a64 = (a & 0xFFFF).to_int64()
  let b64 = (b & 0xFFFF).to_int64()
  let c64 = (c & 0xFFFF).to_int64()
  op64 | (a64 << 8) | (b64 << 24) | (c64 << 40)
}

///|
fn enc_asbx(op : Int, a : Int, sbx : Int) -> Int64 {
  let op64 = (op & 0xFF).to_int64()
  let a64 = (a & 0xFFFF).to_int64()
  let bx64 = ((sbx + SBX_BIAS) & 0xFFFFFF).to_int64()
  op64 | (a64 << 8) | (bx64 << 24)
}

///|
fn enc_ax(op : Int, ax : Int) -> Int64 {
  let op64 = (op & 0xFF).to_int64()
  let ax64 = ax.to_int64() & 0xFFFFFFFFL
  op64 | (ax64 << 8)
}

///|
fn dec_op(inst : Int64) -> Int {
  (inst & 0xFFL).to_int()
}

///|
fn dec_a(inst : Int64) -> Int {
  ((inst >> 8) & 0xFFFFL).to_int()
}

///|
fn dec_b(inst : Int64) -> Int {
  ((inst >> 24) & 0xFFFFL).to_int()
}

///|
fn dec_c(inst : Int64) -> Int {
  ((inst >> 40) & 0xFFFFL).to_int()
}

///|
fn dec_sbx(inst : Int64) -> Int {
  ((inst >> 24) & 0xFFFFFFL).to_int() - SBX_BIAS
}

///|
fn dec_ax(inst : Int64) -> Int {
  ((inst >> 8) & 0xFFFFFFFFL).to_int()
}

///| Descriptor for an upvalue captured by a `Proto`.
pub struct UpvalDesc {
  pub in_stack : Bool
  pub index : Int
}

///| Compiled function prototype.
pub struct Proto {
  pub code : Array[Int64]
  pub lines : Array[Int]
  pub consts : Array[LuaValue]
  pub protos : Array[Proto]
  pub upvals : Array[UpvalDesc]
  pub num_params : Int
  pub is_vararg : Bool
  pub max_stack : Int
  pub source_name : String
}

///|
pub fn Proto::empty() -> Proto {
  Proto::{
    code: [],
    lines: [],
    consts: [],
    protos: [],
    upvals: [],
    num_params: 0,
    is_vararg: false,
    max_stack: 2,
    source_name: "[string]",
  }
}
