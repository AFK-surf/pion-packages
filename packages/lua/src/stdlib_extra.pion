///| Extended Lua 5.4 standard library modules:
///| - `coroutine` (`create`, `resume`, `yield`, `status`, `wrap`, `isyieldable`, `running`)
///| - `string.pack`, `string.unpack`, `string.packsize`

///| Swap VM execution state with thread `thid` for cooperative coroutine resume/yield.
fn LuaVm::resume_thread(self : LuaVm, thid : Int, args : Array[LuaValue]) -> Result[Array[LuaValue], LuaError] {
  if thid < 0 || thid >= self.threads.length() {
    return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid thread handle", 0))
  }
  let th = self.threads[thid]
  if th.status == 3 {
    return Ok([LuaValue::Bool(false), LuaValue::Str("cannot resume dead coroutine")])
  }
  if th.status == 1 || th.status == 2 {
    return Ok([LuaValue::Bool(false), LuaValue::Str("cannot resume non-suspended coroutine")])
  }

  // Save caller thread state
  let prev_thread = self.current_thread
  let prev_stack = self.stack
  let prev_top = self.top
  let prev_frames = self.frames
  let prev_open_uvs = self.open_upvalues
  if prev_thread >= 0 {
    self.threads[prev_thread].status = 2 // normal
  }

  // Switch VM to coroutine `th`
  self.current_thread = thid
  self.stack = th.stack
  self.top = th.top
  self.frames = th.frames
  self.open_upvalues = th.open_upvalues
  th.status = 1 // running
  th.did_yield = false
  th.yield_vals = []

  let res : Result[Array[LuaValue], LuaError] = if !th.started {
    th.started = true
    self.call_value(th.entry_fn, args)
  } else {
    // Resuming from a yield inside `OP_CALL` (or `OP_TAILCALL`):
    // Deliver `args` as the return values of the `coroutine.yield(...)` call!
    if self.frames.length() > 0 {
      let fr = self.frames[self.frames.length() - 1]
      let cl = self.closures[fr.closure_id]
      let prev_inst = cl.proto.code[fr.pc - 1]
      let op = dec_op(prev_inst)
      let a = dec_a(prev_inst)
      let c = dec_c(prev_inst)
      if op == OP_CALL {
        let dst_slot = fr.base + a
        let want = c - 1
        if want < 0 {
          let _ = self.ensure_stack(dst_slot + args.length() + 2)
          let mut i = 0
          while i < args.length() {
            self.stack[dst_slot + i] = args[i]
            i = i + 1
          }
          self.top = dst_slot + args.length()
        } else {
          let mut i = 0
          while i < want {
            self.stack[dst_slot + i] = if i < args.length() { args[i] } else { LuaValue::Nil }
            i = i + 1
          }
        }
      } else if op == OP_TAILCALL {
        // Yield was a tailcall; return args directly from popped frame
        let popped = self.frames[self.frames.length() - 1]
        let _ = self.frames.pop()
        self.close_upvalues(popped.base)
        if popped.want_results < 0 {
          let _ = self.ensure_stack(popped.ret_reg + args.length() + 2)
          let mut i = 0
          while i < args.length() {
            self.stack[popped.ret_reg + i] = args[i]
            i = i + 1
          }
          self.top = popped.ret_reg + args.length()
        } else {
          let mut i = 0
          while i < popped.want_results {
            self.stack[popped.ret_reg + i] = if i < args.length() { args[i] } else { LuaValue::Nil }
            i = i + 1
          }
        }
      }
    }
    if self.frames.length() == 0 {
      let out : Array[LuaValue] = []
      let mut r = 0
      while r < self.top {
        out.push(self.stack[r])
        r = r + 1
      }
      Ok(out)
    } else {
      match self.run_loop(0) {
        Ok(_) => {
          if th.did_yield {
            Ok([])
          } else {
            let out : Array[LuaValue] = []
            let mut r = 0
            while r < self.top {
              out.push(self.stack[r])
              r = r + 1
            }
            Ok(out)
          }
        }
        Err(e) => Err(e)
      }
    }
  }

  // Save updated coroutine state
  th.top = self.top

  // Restore caller thread state
  self.current_thread = prev_thread
  self.stack = prev_stack
  self.top = prev_top
  self.frames = prev_frames
  self.open_upvalues = prev_open_uvs
  if prev_thread >= 0 {
    self.threads[prev_thread].status = 1 // running
  }

  match res {
    Ok(vals) => {
      if th.did_yield {
        th.status = 0 // suspended
        th.did_yield = false
        let out : Array[LuaValue] = [LuaValue::Bool(true)]
        let mut i = 0
        while i < th.yield_vals.length() {
          out.push(th.yield_vals[i])
          i = i + 1
        }
        th.yield_vals = []
        Ok(out)
      } else {
        th.status = 3 // dead
        let out : Array[LuaValue] = [LuaValue::Bool(true)]
        let mut i = 0
        while i < vals.length() {
          out.push(vals[i])
          i = i + 1
        }
        Ok(out)
      }
    }
    Err(e) => {
      th.status = 3 // dead
      if is_sandbox_limit_error(e.kind) {
        return Err(e)
      }
      let err_obj = if e.is_kind(LuaErrorKind::UserError) && !self.last_error_val.is_nil() {
        self.last_error_val
      } else {
        LuaValue::Str(e.message)
      }
      Ok([LuaValue::Bool(false), err_obj])
    }
  }
}

///| Register Lua 5.4 `coroutine` library (P1-17).
fn register_coroutine_lib(vm : LuaVm, g : Int) -> Unit {
  let co_lib = match vm.alloc_table() {
    Ok(id) => id
    Err(_) => return
  }
  let _ = vm.tables[g].raw_set(LuaValue::Str("coroutine"), LuaValue::Table(co_lib))

  reg_tbl_fn(vm, co_lib, "create", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'coroutine.create' (function expected)", 0))
    }
    match args[0] {
      LuaValue::Closure(_) | LuaValue::NativeFn(_) => ()
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'coroutine.create' (function expected)", 0))
    }
    match v.charge_mem(128) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let thid = v.threads.length()
    v.threads.push(
      LuaThread::{
        status: 0,
        entry_fn: args[0],
        started: false,
        stack: [],
        top: 0,
        frames: [],
        open_upvalues: [],
        yield_vals: [],
        did_yield: false,
      },
    )
    Ok([LuaValue::Thread(thid)])
  })

  reg_tbl_fn(vm, co_lib, "resume", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'coroutine.resume' (thread expected)", 0))
    }
    let thid = match args[0] {
      LuaValue::Thread(id) => id
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'coroutine.resume' (thread expected)", 0))
    }
    let pass_args : Array[LuaValue] = []
    let mut i = 1
    while i < args.length() {
      pass_args.push(args[i])
      i = i + 1
    }
    v.resume_thread(thid, pass_args)
  })

  reg_tbl_fn(vm, co_lib, "yield", fn(v, args) {
    if v.current_thread < 0 {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "attempt to yield from outside a coroutine", 0))
    }
    let th = v.threads[v.current_thread]
    th.yield_vals = args
    th.did_yield = true
    Ok([])
  })

  reg_tbl_fn(vm, co_lib, "status", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'coroutine.status' (thread expected)", 0))
    }
    let thid = match args[0] {
      LuaValue::Thread(id) => id
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'coroutine.status' (thread expected)", 0))
    }
    if thid < 0 || thid >= v.threads.length() {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid thread handle", 0))
    }
    let st = v.threads[thid].status
    let s = if st == 0 {
      "suspended"
    } else if st == 1 {
      "running"
    } else if st == 2 {
      "normal"
    } else {
      "dead"
    }
    Ok([LuaValue::Str(s)])
  })

  reg_tbl_fn(vm, co_lib, "isyieldable", fn(v, _args) {
    Ok([LuaValue::Bool(v.current_thread >= 0)])
  })

  reg_tbl_fn(vm, co_lib, "running", fn(v, _args) {
    if v.current_thread >= 0 {
      Ok([LuaValue::Thread(v.current_thread), LuaValue::Bool(false)])
    } else {
      Ok([LuaValue::Nil, LuaValue::Bool(true)])
    }
  })

  reg_tbl_fn(vm, co_lib, "wrap", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'coroutine.wrap' (function expected)", 0))
    }
    match args[0] {
      LuaValue::Closure(_) | LuaValue::NativeFn(_) => ()
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'coroutine.wrap' (function expected)", 0))
    }
    match v.charge_mem(128) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let thid = v.threads.length()
    v.threads.push(
      LuaThread::{
        status: 0,
        entry_fn: args[0],
        started: false,
        stack: [],
        top: 0,
        frames: [],
        open_upvalues: [],
        yield_vals: [],
        did_yield: false,
      },
    )
    let wrapper = v.alloc_native(fn(vm_in, wargs) {
      match vm_in.resume_thread(thid, wargs) {
        Ok(res) => {
          if res.length() > 0 && res[0].is_truthy() {
            let out : Array[LuaValue] = []
            let mut i = 1
            while i < res.length() {
              out.push(res[i])
              i = i + 1
            }
            Ok(out)
          } else {
            let err_v = if res.length() > 1 { res[1] } else { LuaValue::Str("coroutine error") }
            vm_in.last_error_val = err_v
            Err(LuaError::new(LuaErrorKind::UserError, lua_value_to_string_raw(err_v), 0))
          }
        }
        Err(e) => Err(e)
      }
    })
    Ok([wrapper])
  })
}

///| Write an integer `val_u` of `size` bytes (1..8) in little-endian or big-endian.
fn pack_write_uint(out : Array[Byte], val_u : UInt64, size : Int, little : Bool) -> Unit {
  if little {
    let mut i = 0
    while i < size {
      out.push(((val_u >> (i * 8)) & 0xFFUL).reinterpret_as_int64().to_int().to_byte())
      i = i + 1
    }
  } else {
    let mut i = size - 1
    while i >= 0 {
      out.push(((val_u >> (i * 8)) & 0xFFUL).reinterpret_as_int64().to_int().to_byte())
      i = i - 1
    }
  }
}

///| Read `size` bytes (1..8) as unsigned or signed Int64.
fn pack_read_int(s : String, pos : Int, size : Int, little : Bool, signed : Bool) -> Int64 {
  let mut u : UInt64 = 0UL
  if little {
    let mut i = size - 1
    while i >= 0 {
      u = (u << 8) | s.code_unit_at(pos + i).to_int().to_int64().reinterpret_as_uint64()
      i = i - 1
    }
  } else {
    let mut i = 0
    while i < size {
      u = (u << 8) | s.code_unit_at(pos + i).to_int().to_int64().reinterpret_as_uint64()
      i = i + 1
    }
  }
  if signed && size < 8 {
    let sign_bit = 1UL << (size * 8 - 1)
    if (u & sign_bit) != 0UL {
      let mask = 0xFFFFFFFFFFFFFFFFUL << (size * 8)
      u = u | mask
    }
  }
  u.reinterpret_as_int64()
}

///| Register `string.pack`, `string.unpack`, `string.packsize` (P1-17).
fn register_string_pack(vm : LuaVm, str_lib : Int) -> Unit {
  reg_tbl_fn(vm, str_lib, "pack", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'string.pack' (string expected)", 0))
    }
    let fmt = match args[0] {
      LuaValue::Str(s) => s
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let flen = fmt.length()
    let out : Array[Byte] = []
    let mut little = true
    let mut i = 0
    let mut arg_i = 1
    while i < flen {
      let c = fmt.code_unit_at(i).to_int()
      i = i + 1
      if c == 32 {
        continue
      } else if c == 60 {
        little = true
      } else if c == 62 {
        little = false
      } else if c == 61 {
        little = true
      } else if c == 120 {
        // 'x': one padding byte
        match v.charge_mem(1) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        out.push((0).to_byte())
      } else if c == 98 || c == 66 || c == 104 || c == 72 || c == 108 || c == 76 || c == 106 || c == 74 || c == 84 || c == 105 || c == 73 {
        let mut sz = if c == 98 || c == 66 {
          1
        } else if c == 104 || c == 72 {
          2
        } else if c == 105 || c == 73 {
          4
        } else {
          8
        }
        if c == 105 || c == 73 {
          let mut n_sz = 0
          let mut has_d = false
          while i < flen && fmt.code_unit_at(i).to_int() >= 48 && fmt.code_unit_at(i).to_int() <= 57 {
            n_sz = n_sz * 10 + (fmt.code_unit_at(i).to_int() - 48)
            has_d = true
            i = i + 1
          }
          if has_d {
            if n_sz < 1 || n_sz > 16 {
              return Err(LuaError::new(LuaErrorKind::RuntimeError, "integral size out of limits", 0))
            }
            sz = if n_sz > 8 { 8 } else { n_sz }
          }
        }
        if arg_i >= args.length() {
          return Err(LuaError::new(LuaErrorKind::TypeError, "missing argument for 'string.pack'", 0))
        }
        let iv = match to_lua_int(args[arg_i]) {
          Some(k) => k
          None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected in 'string.pack'", 0))
        }
        arg_i = arg_i + 1
        match v.charge_mem(sz) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        pack_write_uint(out, iv.reinterpret_as_uint64(), sz, little)
      } else if c == 100 || c == 110 {
        // 'd' / 'n': IEEE-754 double (8 bytes)
        if arg_i >= args.length() {
          return Err(LuaError::new(LuaErrorKind::TypeError, "missing argument for 'string.pack'", 0))
        }
        let fv = match to_lua_number(args[arg_i]) {
          Some(LuaValue::Float(f)) => f
          Some(LuaValue::Int(k)) => k.to_double()
          _ => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected in 'string.pack'", 0))
        }
        arg_i = arg_i + 1
        match v.charge_mem(8) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        pack_write_uint(out, fv.to_bits().reinterpret_as_uint64(), 8, little)
      } else if c == 122 {
        // 'z': zero-terminated string
        if arg_i >= args.length() {
          return Err(LuaError::new(LuaErrorKind::TypeError, "missing argument for 'string.pack'", 0))
        }
        let sv = match args[arg_i] {
          LuaValue::Str(s) => s
          _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
        }
        arg_i = arg_i + 1
        match v.charge_mem(sv.length() + 1) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let mut k = 0
        while k < sv.length() {
          let b = sv.code_unit_at(k).to_int()
          if b == 0 {
            return Err(LuaError::new(LuaErrorKind::RuntimeError, "string contains zeros", 0))
          }
          out.push(b.to_byte())
          k = k + 1
        }
        out.push((0).to_byte())
      } else if c == 115 {
        // 's[n]': length-prefixed string
        let mut sz = 8
        let mut n_sz = 0
        let mut has_d = false
        while i < flen && fmt.code_unit_at(i).to_int() >= 48 && fmt.code_unit_at(i).to_int() <= 57 {
          n_sz = n_sz * 10 + (fmt.code_unit_at(i).to_int() - 48)
          has_d = true
          i = i + 1
        }
        if has_d {
          sz = if n_sz < 1 || n_sz > 8 { 8 } else { n_sz }
        }
        if arg_i >= args.length() {
          return Err(LuaError::new(LuaErrorKind::TypeError, "missing argument for 'string.pack'", 0))
        }
        let sv = match args[arg_i] {
          LuaValue::Str(s) => s
          _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
        }
        arg_i = arg_i + 1
        match v.charge_mem(sz + sv.length()) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        pack_write_uint(out, sv.length().to_int64().reinterpret_as_uint64(), sz, little)
        let mut k = 0
        while k < sv.length() {
          out.push(sv.code_unit_at(k).to_byte())
          k = k + 1
        }
      } else if c == 99 {
        // 'cn': fixed-size string
        let mut sz = 0
        while i < flen && fmt.code_unit_at(i).to_int() >= 48 && fmt.code_unit_at(i).to_int() <= 57 {
          sz = sz * 10 + (fmt.code_unit_at(i).to_int() - 48)
          i = i + 1
        }
        if arg_i >= args.length() {
          return Err(LuaError::new(LuaErrorKind::TypeError, "missing argument for 'string.pack'", 0))
        }
        let sv = match args[arg_i] {
          LuaValue::Str(s) => s
          _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
        }
        arg_i = arg_i + 1
        if sv.length() > sz {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "string longer than given size", 0))
        }
        match v.charge_mem(sz) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let mut k = 0
        while k < sv.length() {
          out.push(sv.code_unit_at(k).to_byte())
          k = k + 1
        }
        while k < sz {
          out.push((0).to_byte())
          k = k + 1
        }
      } else {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid format option in 'string.pack'", 0))
      }
    }
    match utf8_bytes_to_string(bytes_from_array(out)) {
      Some(s) => Ok([LuaValue::Str(s)])
      None => Ok([LuaValue::Str("")])
    }
  })

  reg_tbl_fn(vm, str_lib, "unpack", fn(_v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'string.unpack'", 0))
    }
    let fmt = match args[0] {
      LuaValue::Str(s) => s
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let data = match args[1] {
      LuaValue::Str(s) => s
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let dlen = data.length()
    let mut pos = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => lua_str_pos_i64(k, dlen) - 1
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      0
    }
    if pos < 0 || pos > dlen {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "initial position out of string", 0))
    }
    let flen = fmt.length()
    let out : Array[LuaValue] = []
    let mut little = true
    let mut i = 0
    while i < flen {
      let c = fmt.code_unit_at(i).to_int()
      i = i + 1
      if c == 32 {
        continue
      } else if c == 60 {
        little = true
      } else if c == 62 {
        little = false
      } else if c == 61 {
        little = true
      } else if c == 120 {
        if pos + 1 > dlen {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "data string too short", 0))
        }
        pos = pos + 1
      } else if c == 98 || c == 66 || c == 104 || c == 72 || c == 108 || c == 76 || c == 106 || c == 74 || c == 84 || c == 105 || c == 73 {
        let signed = c == 98 || c == 104 || c == 108 || c == 106 || c == 105
        let mut sz = if c == 98 || c == 66 {
          1
        } else if c == 104 || c == 72 {
          2
        } else if c == 105 || c == 73 {
          4
        } else {
          8
        }
        if c == 105 || c == 73 {
          let mut n_sz = 0
          let mut has_d = false
          while i < flen && fmt.code_unit_at(i).to_int() >= 48 && fmt.code_unit_at(i).to_int() <= 57 {
            n_sz = n_sz * 10 + (fmt.code_unit_at(i).to_int() - 48)
            has_d = true
            i = i + 1
          }
          if has_d {
            sz = if n_sz < 1 || n_sz > 8 { 8 } else { n_sz }
          }
        }
        if pos + sz > dlen {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "data string too short", 0))
        }
        out.push(LuaValue::Int(pack_read_int(data, pos, sz, little, signed)))
        pos = pos + sz
      } else if c == 100 || c == 110 {
        if pos + 8 > dlen {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "data string too short", 0))
        }
        let bits = pack_read_int(data, pos, 8, little, false)
        out.push(LuaValue::Float(Double::from_bits(bits)))
        pos = pos + 8
      } else if c == 122 {
        let start = pos
        while pos < dlen && data.code_unit_at(pos).to_int() != 0 {
          pos = pos + 1
        }
        if pos >= dlen {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "unfinished string for format 'z'", 0))
        }
        out.push(LuaValue::Str(data.slice(start, pos)))
        pos = pos + 1
      } else if c == 115 {
        let mut sz = 8
        let mut n_sz = 0
        let mut has_d = false
        while i < flen && fmt.code_unit_at(i).to_int() >= 48 && fmt.code_unit_at(i).to_int() <= 57 {
          n_sz = n_sz * 10 + (fmt.code_unit_at(i).to_int() - 48)
          has_d = true
          i = i + 1
        }
        if has_d {
          sz = if n_sz < 1 || n_sz > 8 { 8 } else { n_sz }
        }
        if pos + sz > dlen {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "data string too short", 0))
        }
        let slen = pack_read_int(data, pos, sz, little, false).to_int()
        pos = pos + sz
        if slen < 0 || pos + slen > dlen {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "data string too short", 0))
        }
        out.push(LuaValue::Str(data.slice(pos, pos + slen)))
        pos = pos + slen
      } else if c == 99 {
        let mut sz = 0
        while i < flen && fmt.code_unit_at(i).to_int() >= 48 && fmt.code_unit_at(i).to_int() <= 57 {
          sz = sz * 10 + (fmt.code_unit_at(i).to_int() - 48)
          i = i + 1
        }
        if pos + sz > dlen {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "data string too short", 0))
        }
        out.push(LuaValue::Str(data.slice(pos, pos + sz)))
        pos = pos + sz
      } else {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid format option in 'string.unpack'", 0))
      }
    }
    out.push(LuaValue::Int((pos + 1).to_int64()))
    Ok(out)
  })

  reg_tbl_fn(vm, str_lib, "packsize", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let fmt = match args[0] {
      LuaValue::Str(s) => s
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let flen = fmt.length()
    let mut total = 0
    let mut i = 0
    while i < flen {
      let c = fmt.code_unit_at(i).to_int()
      i = i + 1
      if c == 32 || c == 60 || c == 62 || c == 61 {
        continue
      } else if c == 120 || c == 98 || c == 66 {
        total = total + 1
      } else if c == 104 || c == 72 {
        total = total + 2
      } else if c == 108 || c == 76 || c == 106 || c == 74 || c == 84 || c == 100 || c == 110 {
        total = total + 8
      } else if c == 105 || c == 73 {
        let mut sz = 4
        let mut n_sz = 0
        let mut has_d = false
        while i < flen && fmt.code_unit_at(i).to_int() >= 48 && fmt.code_unit_at(i).to_int() <= 57 {
          n_sz = n_sz * 10 + (fmt.code_unit_at(i).to_int() - 48)
          has_d = true
          i = i + 1
        }
        if has_d {
          sz = n_sz
        }
        total = total + sz
      } else if c == 99 {
        let mut sz = 0
        while i < flen && fmt.code_unit_at(i).to_int() >= 48 && fmt.code_unit_at(i).to_int() <= 57 {
          sz = sz * 10 + (fmt.code_unit_at(i).to_int() - 48)
          i = i + 1
        }
        total = total + sz
      } else {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "variable-length format", 0))
      }
    }
    Ok([LuaValue::Int(total.to_int64())])
  })
}
