///| Lua 5.4 Abstract Syntax Tree (AST) for bytecode compilation.

///|
enum BinOp {
  Add
  Sub
  Mul
  Div
  IDiv
  Mod
  Pow
  BAnd
  BOr
  BXor
  Shl
  Shr
  Concat
  Eq
  Ne
  Lt
  Le
  Gt
  Ge
  And
  Or
}

///|
enum UnOp {
  Neg
  BNot
  Not
  Len
}

///|
struct TableField {
  key : Option[Expr] // None = array element, Some(k) = [k] = v or name = v
  val_expr : Expr
}

///|
struct FuncBody {
  params : Array[String]
  is_vararg : Bool
  body : Array[Stmt]
  line : Int
}

///|
enum Expr {
  Nil(Int)
  Bool(Bool, Int)
  Int(Int64, Int)
  Float(Double, Int)
  Str(String, Int)
  Vararg(Int)
  Ident(String, Int)
  Paren(Expr, Int) // Parenthesized expr: forces single return value!
  Unary(UnOp, Expr, Int)
  Binary(BinOp, Expr, Expr, Int)
  Index(Expr, Expr, Int) // t[k]
  Field(Expr, String, Int) // t.k
  Call(Expr, Array[Expr], Int) // f(args...)
  MethodCall(Expr, String, Array[Expr], Int) // t:m(args...)
  TableCtor(Array[TableField], Int)
  FuncExpr(FuncBody)
}

///|
struct IfBranch {
  cond : Expr
  body : Array[Stmt]
  line : Int
}

///|
enum Stmt {
  Empty
  Block(Array[Stmt], Int)
  Assign(Array[Expr], Array[Expr], Int)
  LocalDecl(Array[String], Array[Expr], Int)
  LocalFunc(String, FuncBody, Int)
  ExprCall(Expr, Int)
  If(Array[IfBranch], Option[Array[Stmt]], Int)
  While(Expr, Array[Stmt], Int)
  Repeat(Array[Stmt], Expr, Int)
  ForNum(String, Expr, Expr, Option[Expr], Array[Stmt], Int)
  ForGen(Array[String], Array[Expr], Array[Stmt], Int)
  Break(Int)
  Return(Array[Expr], Int)
}

///|
fn expr_line(e : Expr) -> Int {
  match e {
    Expr::Nil(l) => l
    Expr::Bool(_, l) => l
    Expr::Int(_, l) => l
    Expr::Float(_, l) => l
    Expr::Str(_, l) => l
    Expr::Vararg(l) => l
    Expr::Ident(_, l) => l
    Expr::Paren(_, l) => l
    Expr::Unary(_, _, l) => l
    Expr::Binary(_, _, _, l) => l
    Expr::Index(_, _, l) => l
    Expr::Field(_, _, l) => l
    Expr::Call(_, _, l) => l
    Expr::MethodCall(_, _, _, l) => l
    Expr::TableCtor(_, l) => l
    Expr::FuncExpr(fb) => fb.line
  }
}
