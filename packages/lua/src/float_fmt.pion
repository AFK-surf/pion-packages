///| Pure-Pion exact IEEE-754 BigInt decimal-to-double parser (Clinger + BigUInt, 0-ULP),
///| exact double-to-decimal formatter (`%.14g`, `%f`, `%e`, `%g`, `%a`, `%q`),
///| and Payne-Hanek trigonometric range reduction.

///| Unsigned arbitrary-precision integer in base 2^30 (little-endian limbs).
struct BigUInt {
  limbs : Array[Int64]
}

let BIG_BASE : Int64 = 1073741824L // 2^30
let BIG_MASK : Int64 = 1073741823L // 2^30 - 1

///|
fn BigUInt::zero() -> BigUInt {
  BigUInt::{ limbs: [] }
}

///|
fn BigUInt::from_u64(v : UInt64) -> BigUInt {
  let limbs : Array[Int64] = []
  let mut cur = v
  while cur > 0UL {
    limbs.push((cur & 0x3FFFFFFFUL).reinterpret_as_int64())
    cur = cur >> 30
  }
  BigUInt::{ limbs: limbs }
}

///|
fn BigUInt::clone_big(self : BigUInt) -> BigUInt {
  let out : Array[Int64] = []
  let mut i = 0
  while i < self.limbs.length() {
    out.push(self.limbs[i])
    i = i + 1
  }
  BigUInt::{ limbs: out }
}

///|
fn BigUInt::trim(self : BigUInt) -> Unit {
  while self.limbs.length() > 0 && self.limbs[self.limbs.length() - 1] == 0L {
    let _ = self.limbs.pop()
  }
}

///|
fn BigUInt::is_zero(self : BigUInt) -> Bool {
  self.limbs.length() == 0
}

///|
fn BigUInt::bit_len(self : BigUInt) -> Int {
  let n = self.limbs.length()
  if n == 0 {
    return 0
  }
  let mut top = self.limbs[n - 1]
  let mut bits = (n - 1) * 30
  while top > 0L {
    top = top >> 1
    bits = bits + 1
  }
  bits
}

///| Multiply in-place by small non-negative integer `m` and add `add`.
fn BigUInt::mul_add(self : BigUInt, m : Int64, add : Int64) -> Unit {
  let mut carry = add
  let mut i = 0
  while i < self.limbs.length() {
    let prod = self.limbs[i] * m + carry
    self.limbs[i] = prod & BIG_MASK
    carry = prod >> 30
    i = i + 1
  }
  while carry > 0L {
    self.limbs.push(carry & BIG_MASK)
    carry = carry >> 30
  }
  self.trim()
}

///| Divide in-place by small positive integer `d` (d <= 10^9); returns remainder.
fn BigUInt::div_small(self : BigUInt, d : Int64) -> Int64 {
  let mut rem = 0L
  let mut i = self.limbs.length() - 1
  while i >= 0 {
    let cur = (rem << 30) | self.limbs[i]
    self.limbs[i] = cur / d
    rem = cur % d
    i = i - 1
  }
  self.trim()
  rem
}

///| Left-shift in-place by `bits >= 0`.
fn BigUInt::shl(self : BigUInt, bits : Int) -> Unit {
  if self.is_zero() || bits <= 0 {
    return
  }
  let word_shift = bits / 30
  let bit_shift = bits % 30
  if bit_shift > 0 {
    let mut carry = 0L
    let mut i = 0
    while i < self.limbs.length() {
      let v = (self.limbs[i] << bit_shift) | carry
      self.limbs[i] = v & BIG_MASK
      carry = v >> 30
      i = i + 1
    }
    if carry > 0L {
      self.limbs.push(carry)
    }
  }
  if word_shift > 0 {
    let old_len = self.limbs.length()
    let mut i = 0
    while i < word_shift {
      self.limbs.push(0L)
      i = i + 1
    }
    let mut j = old_len - 1
    while j >= 0 {
      self.limbs[j + word_shift] = self.limbs[j]
      j = j - 1
    }
    i = 0
    while i < word_shift {
      self.limbs[i] = 0L
      i = i + 1
    }
  }
  self.trim()
}

///| Multiply in-place by `5^p` (p >= 0).
fn BigUInt::mul_pow5(self : BigUInt, p : Int) -> Unit {
  let mut rem = p
  while rem >= 13 {
    self.mul_add(1220703125L, 0L) // 5^13
    rem = rem - 13
  }
  while rem > 0 {
    self.mul_add(5L, 0L)
    rem = rem - 1
  }
}

///| Compare `self` vs `other`: -1, 0, or 1.
fn BigUInt::cmp(self : BigUInt, other : BigUInt) -> Int {
  let na = self.limbs.length()
  let nb = other.limbs.length()
  if na != nb {
    return if na < nb { -1 } else { 1 }
  }
  let mut i = na - 1
  while i >= 0 {
    if self.limbs[i] != other.limbs[i] {
      return if self.limbs[i] < other.limbs[i] { -1 } else { 1 }
    }
    i = i - 1
  }
  0
}

///| Subtract `other` from `self` in-place (caller guarantees `self >= other`).
fn BigUInt::sub_assign(self : BigUInt, other : BigUInt) -> Unit {
  let mut borrow = 0L
  let mut i = 0
  while i < other.limbs.length() || borrow != 0L {
    let ob = if i < other.limbs.length() { other.limbs[i] } else { 0L }
    let mut diff = self.limbs[i] - ob - borrow
    if diff < 0L {
      diff = diff + BIG_BASE
      borrow = 1L
    } else {
      borrow = 0L
    }
    self.limbs[i] = diff
    i = i + 1
  }
  self.trim()
}

///| Convert `BigUInt` to base-10 decimal string (for non-negative integer).
fn BigUInt::to_dec_string(self : BigUInt) -> String {
  if self.is_zero() {
    return "0"
  }
  let tmp = self.clone_big()
  let chunks : Array[Int64] = []
  while !tmp.is_zero() {
    chunks.push(tmp.div_small(1000000000L))
  }
  let sb = StringBuilder::new()
  let top = chunks.length() - 1
  sb.write_string(chunks[top].to_string())
  let mut i = top - 1
  while i >= 0 {
    let s = chunks[i].to_string()
    let mut pad = 9 - s.length()
    while pad > 0 {
      sb.write_string("0")
      pad = pad - 1
    }
    sb.write_string(s)
    i = i - 1
  }
  sb.to_string()
}

///| Exact 0-ULP decimal string -> Double using BigUInt round-half-to-even (P1-2).
///| `digits` contains ASCII digit values 0..9 (no leading zeros), `exp10` is power of 10
///| such that value = (digits as integer) * 10^exp10.
fn decimal_digits_to_f64(digits : Array[Int], exp10 : Int, neg : Bool) -> Double {
  let sign_bit = if neg { -9223372036854775807L - 1L } else { 0L }
  let nd = digits.length()
  if nd == 0 {
    return Double::from_bits(sign_bit)
  }
  // Quick overflow/underflow bounds (max double ~1.7976931348623157e308, min subnormal ~4.94e-324)
  let top_exp = exp10 + nd - 1
  if top_exp > 309 {
    return Double::from_bits(sign_bit | 0x7FF0000000000000L)
  }
  if top_exp < -326 {
    return Double::from_bits(sign_bit)
  }
  // Build exact BigUInt significand (cap at 770 digits + sticky digit)
  let keep = if nd > 770 { 770 } else { nd }
  let mut sticky = false
  let mut k = keep
  while k < nd {
    if digits[k] != 0 {
      sticky = true
      break
    }
    k = k + 1
  }
  let eff_exp10 = exp10 + (nd - keep)
  let num = BigUInt::zero()
  let mut i = 0
  while i < keep {
    num.mul_add(10L, digits[i].to_int64())
    i = i + 1
  }
  if sticky {
    num.mul_add(10L, 1L)
  }
  let e10 = if sticky { eff_exp10 - 1 } else { eff_exp10 }
  let den = BigUInt::from_u64(1UL)
  if e10 >= 0 {
    num.mul_pow5(e10)
    num.shl(e10)
  } else {
    den.mul_pow5(-e10)
    den.shl(-e10)
  }
  // Find binary exponent `exp2` so that 2^52 <= (num/den) * 2^(-exp2) < 2^53
  let mut exp2 = num.bit_len() - den.bit_len() - 53
  // Clamp exp2 to IEEE-754 minimum subnormal exponent (-1074)
  if exp2 < -1074 {
    exp2 = -1074
  }
  let mut n_work = num.clone_big()
  let mut d_work = den.clone_big()
  if exp2 > 0 {
    d_work.shl(exp2)
  } else if exp2 < 0 {
    n_work.shl(-exp2)
  }
  // Adjust exp2 so that for normal numbers, 2^52 <= n_work / d_work < 2^53
  // Compute quotient q = n_work / d_work (at most ~55 bits)
  let mut q : UInt64 = 0UL
  let mut shift = n_work.bit_len() - d_work.bit_len()
  if shift < 0 {
    shift = 0
  }
  // If normal and quotient would be >= 2^53, bump exp2 up
  while shift >= 53 {
    d_work.shl(1)
    exp2 = exp2 + 1
    shift = shift - 1
  }
  let mut b = shift
  while b >= 0 {
    let shifted_d = d_work.clone_big()
    shifted_d.shl(b)
    if n_work.cmp(shifted_d) >= 0 {
      n_work.sub_assign(shifted_d)
      q = q | (1UL << b)
    }
    b = b - 1
  }
  // Now q = floor(n_work_orig / d_work), n_work = remainder.
  // If q >= 2^53 (can happen if shift was 52 and n_work was slightly >= 2^53 * d_work), shift right by 1
  if q >= 9007199254740992UL {
    let low_bit = (q & 1UL) != 0UL
    q = q >> 1
    exp2 = exp2 + 1
    // remainder becomes (low_bit * d_work + rem) / (2 * d_work)
    let rem2 = n_work.clone_big()
    rem2.shl(1)
    let cmp_half = if low_bit {
      // low_bit * d_work + rem vs d_work => always >= d_work; > d_work iff rem > 0
      if !n_work.is_zero() { 1 } else { 0 }
    } else {
      // rem vs d_work => always < d_work
      -1
    }
    if cmp_half > 0 || (cmp_half == 0 && (q & 1UL) != 0UL) {
      q = q + 1UL
      if q >= 9007199254740992UL {
        q = q >> 1
        exp2 = exp2 + 1
      }
    }
  } else if q < 4503599627370496UL && exp2 > -1074 {
    // q < 2^52 and not subnormal: pull in 1 more bit!
    n_work.shl(1)
    q = q << 1
    exp2 = exp2 - 1
    if n_work.cmp(d_work) >= 0 {
      n_work.sub_assign(d_work)
      q = q | 1UL
    }
    // Round half-to-even
    let rem2 = n_work.clone_big()
    rem2.shl(1)
    let cmp_half = rem2.cmp(d_work)
    if cmp_half > 0 || (cmp_half == 0 && (q & 1UL) != 0UL) {
      q = q + 1UL
      if q >= 9007199254740992UL {
        q = q >> 1
        exp2 = exp2 + 1
      }
    }
  } else {
    // Standard round half-to-even
    let rem2 = n_work.clone_big()
    rem2.shl(1)
    let cmp_half = rem2.cmp(d_work)
    if cmp_half > 0 || (cmp_half == 0 && (q & 1UL) != 0UL) {
      q = q + 1UL
      if q >= 9007199254740992UL {
        q = q >> 1
        exp2 = exp2 + 1
      }
    }
  }

  if q == 0UL {
    return Double::from_bits(sign_bit)
  }
  // Encode IEEE-754 double: value = q * 2^exp2
  if q < 4503599627370496UL {
    // Subnormal (biased_exp = 0, mantissa = q)
    return Double::from_bits(sign_bit | q.reinterpret_as_int64())
  }
  let biased_exp = exp2 + 1023 + 52
  if biased_exp >= 2047 {
    return Double::from_bits(sign_bit | 0x7FF0000000000000L)
  }
  let mant = (q & 0x000FFFFFFFFFFFFFUL).reinterpret_as_int64()
  Double::from_bits(sign_bit | (biased_exp.to_int64() << 52) | mant)
}

///| Round an array of decimal digits `digs` (MSB first) to `keep` digits using round-half-to-even.
///| `has_more` indicates whether there are non-zero digits beyond `digs`.
///| Returns `true` if rounding carried out the top (e.g. 999 -> 1000, incrementing exponent by 1).
fn round_dec_digits(digs : Array[Int], keep : Int, has_more : Bool) -> Bool {
  let n = digs.length()
  if keep >= n {
    return false
  }
  let round_up = if keep < 0 {
    false
  } else {
    let next_d = digs[keep]
    if next_d > 5 {
      true
    } else if next_d < 5 {
      false
    } else {
      let mut any_after = has_more
      let mut j = keep + 1
      while j < n {
        if digs[j] != 0 {
          any_after = true
          break
        }
        j = j + 1
      }
      if any_after {
        true
      } else {
        // Exact tie: round to even
        keep > 0 && (digs[keep - 1] & 1) == 1
      }
    }
  }
  while digs.length() > keep {
    let _ = digs.pop()
  }
  if !round_up {
    return false
  }
  let mut i = digs.length() - 1
  while i >= 0 {
    if digs[i] < 9 {
      digs[i] = digs[i] + 1
      return false
    }
    digs[i] = 0
    i = i - 1
  }
  // Carry out of MSB: insert 1 at front (caller adjusts exponent)
  true
}

///| Decompose a positive finite `Double` into `(sig_digits, dec_exp)` where value ≈ 0.<sig_digits> * 10^(dec_exp+1)
///| i.e. first digit is at 10^dec_exp, with at least `need_digits` digits + `has_more` sticky flag.
fn f64_to_exact_dec(x_pos : Double, need_digits : Int) -> (Array[Int], Int, Bool) {
  let bits = x_pos.to_bits()
  let raw_exp = ((bits >> 52) & 0x7FFL).to_int()
  let raw_mant = bits & 0x000FFFFFFFFFFFFFL
  let mant : UInt64 = if raw_exp == 0 {
    raw_mant.reinterpret_as_uint64()
  } else {
    (raw_mant | 0x0010000000000000L).reinterpret_as_uint64()
  }
  let exp2 = if raw_exp == 0 { -1074 } else { raw_exp - 1023 - 52 }

  if exp2 >= 0 {
    let b = BigUInt::from_u64(mant)
    b.shl(exp2)
    let s = b.to_dec_string()
    let digs : Array[Int] = []
    let mut i = 0
    while i < s.length() {
      digs.push(s.code_unit_at(i).to_int() - 48)
      i = i + 1
    }
    let dec_exp = digs.length() - 1
    return (digs, dec_exp, false)
  }

  // exp2 < 0: value = mant / 2^(-exp2)
  let shift = -exp2
  let num = BigUInt::from_u64(mant)
  let den = BigUInt::from_u64(1UL)
  den.shl(shift)

  // Integer part (if mant >= 2^shift)
  let digs : Array[Int] = []
  let mut dec_exp = -1
  if num.cmp(den) >= 0 {
    // Integer part is mant >> shift (fits in UInt64 since shift > 0!)
    let int_val = if shift < 64 { mant >> shift } else { 0UL }
    let int_s = int_val.to_string()
    let mut i = 0
    while i < int_s.length() {
      digs.push(int_s.code_unit_at(i).to_int() - 48)
      i = i + 1
    }
    dec_exp = digs.length() - 1
    // Subtract int_val * 2^shift from num
    let int_big = BigUInt::from_u64(int_val)
    int_big.shl(shift)
    num.sub_assign(int_big)
  }

  // Fractional part: num / den < 1
  if digs.length() == 0 {
    // Skip leading zeros after decimal point to find dec_exp
    // Fast jump: multiply num by 10 until num >= den
    while !num.is_zero() {
      num.mul_add(10L, 0L)
      if num.cmp(den) >= 0 {
        // Extract first non-zero digit
        let mut d = 0
        while num.cmp(den) >= 0 {
          num.sub_assign(den)
          d = d + 1
        }
        digs.push(d)
        break
      }
      dec_exp = dec_exp - 1
    }
  }
  while digs.length() < need_digits && !num.is_zero() {
    num.mul_add(10L, 0L)
    let mut d = 0
    while num.cmp(den) >= 0 {
      num.sub_assign(den)
      d = d + 1
    }
    digs.push(d)
  }
  (digs, dec_exp, !num.is_zero())
}

///| Format exact fixed-point `%f` with `prec` fractional digits (round-half-to-even, P1-9).
fn format_f64_fixed(val_in : Double, prec : Int, alt_form : Bool) -> (Bool, String) {
  let bits = val_in.to_bits()
  let neg = (bits >> 63) != 0L
  if val_in != val_in {
    return (false, "nan")
  }
  if val_in == 1.0 / 0.0 {
    return (false, "inf")
  }
  if val_in == -1.0 / 0.0 {
    return (true, "inf")
  }
  let abs_v = Double::from_bits(bits & 0x7FFFFFFFFFFFFFFFL)
  if abs_v == 0.0 {
    let sb = StringBuilder::new()
    sb.write_string("0")
    if prec > 0 || alt_form {
      sb.write_string(".")
      let mut i = 0
      while i < prec {
        sb.write_string("0")
        i = i + 1
      }
    }
    return (neg, sb.to_string())
  }
  // Determine how many significant digits we need: dec_exp + 1 + prec + 2
  let (digs, dec_exp, has_more) = f64_to_exact_dec(abs_v, 1)
  let total_need = dec_exp + 1 + prec
  let (digs2, dec_exp2, has_more2) = if total_need + 2 > digs.length() && has_more {
    f64_to_exact_dec(abs_v, total_need + 2)
  } else {
    (digs, dec_exp, has_more)
  }
  let mut eff_exp = dec_exp2
  let keep = eff_exp + 1 + prec
  if keep < 0 {
    // Rounds to 0.000...
    let sb = StringBuilder::new()
    sb.write_string("0")
    if prec > 0 || alt_form {
      sb.write_string(".")
      let mut i = 0
      while i < prec {
        sb.write_string("0")
        i = i + 1
      }
    }
    return (neg, sb.to_string())
  }
  let carry = if keep == 0 {
    // Rounding at position 0 (e.g. 0.5 with prec=0): check if digs2[0] > 5 or (==5 and more)
    let d0 = if digs2.length() > 0 { digs2[0] } else { 0 }
    let mut any_after = has_more2
    let mut j = 1
    while j < digs2.length() {
      if digs2[j] != 0 {
        any_after = true
        break
      }
      j = j + 1
    }
    let up = d0 > 5 || (d0 == 5 && any_after) // half-even: 0 is even, so exact 0.5 rounds to 0!
    while digs2.length() > 0 {
      let _ = digs2.pop()
    }
    up
  } else {
    round_dec_digits(digs2, keep, has_more2)
  }
  if carry {
    let new_d : Array[Int] = [1]
    let mut i = 0
    while i < digs2.length() {
      new_d.push(digs2[i])
      i = i + 1
    }
    // Truncate if we had extra
    eff_exp = eff_exp + 1
    return (neg, render_fixed_digits(new_d, eff_exp, prec, alt_form))
  }
  (neg, render_fixed_digits(digs2, eff_exp, prec, alt_form))
}

///|
fn render_fixed_digits(digs : Array[Int], dec_exp : Int, prec : Int, alt_form : Bool) -> String {
  let sb = StringBuilder::new()
  if dec_exp < 0 {
    sb.write_string("0")
    if prec > 0 || alt_form {
      sb.write_string(".")
      let lead_zeros = -dec_exp - 1
      let mut emitted = 0
      let mut z = 0
      while z < lead_zeros && emitted < prec {
        sb.write_string("0")
        z = z + 1
        emitted = emitted + 1
      }
      let mut i = 0
      while i < digs.length() && emitted < prec {
        sb.write_byte((digs[i] + 48).to_byte())
        i = i + 1
        emitted = emitted + 1
      }
      while emitted < prec {
        sb.write_string("0")
        emitted = emitted + 1
      }
    }
  } else {
    let int_len = dec_exp + 1
    let mut i = 0
    while i < int_len {
      let d = if i < digs.length() { digs[i] } else { 0 }
      sb.write_byte((d + 48).to_byte())
      i = i + 1
    }
    if prec > 0 || alt_form {
      sb.write_string(".")
      let mut f = 0
      while f < prec {
        let idx = int_len + f
        let d = if idx < digs.length() { digs[idx] } else { 0 }
        sb.write_byte((d + 48).to_byte())
        f = f + 1
      }
    }
  }
  sb.to_string()
}

///| Format scientific `%e`/`%E` with `prec` fractional digits (P1-10).
fn format_f64_sci(val_in : Double, prec : Int, upper : Bool, alt_form : Bool) -> (Bool, String) {
  let bits = val_in.to_bits()
  let neg = (bits >> 63) != 0L
  if val_in != val_in {
    return (false, if upper { "NAN" } else { "nan" })
  }
  if val_in == 1.0 / 0.0 {
    return (false, if upper { "INF" } else { "inf" })
  }
  if val_in == -1.0 / 0.0 {
    return (true, if upper { "INF" } else { "inf" })
  }
  let exp_ch = if upper { "E" } else { "e" }
  let abs_v = Double::from_bits(bits & 0x7FFFFFFFFFFFFFFFL)
  if abs_v == 0.0 {
    let sb = StringBuilder::new()
    sb.write_string("0")
    if prec > 0 || alt_form {
      sb.write_string(".")
      let mut i = 0
      while i < prec {
        sb.write_string("0")
        i = i + 1
      }
    }
    sb.write_string(exp_ch)
    sb.write_string("+00")
    return (neg, sb.to_string())
  }
  let keep = prec + 1
  let (digs, dec_exp, has_more) = f64_to_exact_dec(abs_v, keep + 2)
  let mut eff_exp = dec_exp
  let carry = round_dec_digits(digs, keep, has_more)
  let final_d : Array[Int] = if carry {
    eff_exp = eff_exp + 1
    let a : Array[Int] = [1]
    let mut i = 0
    while i < prec {
      a.push(0)
      i = i + 1
    }
    a
  } else {
    digs
  }
  let sb = StringBuilder::new()
  sb.write_byte(((if final_d.length() > 0 { final_d[0] } else { 0 }) + 48).to_byte())
  if prec > 0 || alt_form {
    sb.write_string(".")
    let mut i = 1
    while i <= prec {
      let d = if i < final_d.length() { final_d[i] } else { 0 }
      sb.write_byte((d + 48).to_byte())
      i = i + 1
    }
  }
  sb.write_string(exp_ch)
  if eff_exp >= 0 {
    sb.write_string("+")
    if eff_exp < 10 {
      sb.write_string("0")
    }
    sb.write_string(eff_exp.to_string())
  } else {
    sb.write_string("-")
    let ae = -eff_exp
    if ae < 10 {
      sb.write_string("0")
    }
    sb.write_string(ae.to_string())
  }
  (neg, sb.to_string())
}

///| Format general `%g`/`%G` with `prec_in` significant digits (default 6, Lua tostring uses 14, P1-1 & P1-10).
fn format_f64_general(val_in : Double, prec_in : Int, upper : Bool, alt_form : Bool) -> (Bool, String) {
  let bits = val_in.to_bits()
  let neg = (bits >> 63) != 0L
  if val_in != val_in {
    return (false, if upper { "NAN" } else { "nan" })
  }
  if val_in == 1.0 / 0.0 {
    return (false, if upper { "INF" } else { "inf" })
  }
  if val_in == -1.0 / 0.0 {
    return (true, if upper { "INF" } else { "inf" })
  }
  let p = if prec_in <= 0 { 1 } else { prec_in }
  let abs_v = Double::from_bits(bits & 0x7FFFFFFFFFFFFFFFL)
  if abs_v == 0.0 {
    if alt_form {
      let sb = StringBuilder::new()
      sb.write_string("0.")
      let mut i = 1
      while i < p {
        sb.write_string("0")
        i = i + 1
      }
      return (neg, sb.to_string())
    }
    return (neg, "0")
  }
  let (digs, dec_exp, has_more) = f64_to_exact_dec(abs_v, p + 2)
  let mut eff_exp = dec_exp
  let carry = round_dec_digits(digs, p, has_more)
  let final_d : Array[Int] = if carry {
    eff_exp = eff_exp + 1
    let a : Array[Int] = [1]
    let mut i = 1
    while i < p {
      a.push(0)
      i = i + 1
    }
    a
  } else {
    digs
  }
  // Pad final_d to length p if alt_form, else trim trailing zeros
  let mut sig_len = final_d.length()
  if !alt_form {
    while sig_len > 1 && final_d[sig_len - 1] == 0 {
      sig_len = sig_len - 1
    }
  }
  if eff_exp < -4 || eff_exp >= p {
    // Scientific notation
    let sb = StringBuilder::new()
    sb.write_byte(((if sig_len > 0 { final_d[0] } else { 0 }) + 48).to_byte())
    let frac_len = if alt_form { p - 1 } else { sig_len - 1 }
    if frac_len > 0 || alt_form {
      sb.write_string(".")
      let mut i = 1
      while i <= frac_len {
        let d = if i < final_d.length() { final_d[i] } else { 0 }
        sb.write_byte((d + 48).to_byte())
        i = i + 1
      }
    }
    sb.write_string(if upper { "E" } else { "e" })
    if eff_exp >= 0 {
      sb.write_string("+")
      if eff_exp < 10 {
        sb.write_string("0")
      }
      sb.write_string(eff_exp.to_string())
    } else {
      sb.write_string("-")
      let ae = -eff_exp
      if ae < 10 {
        sb.write_string("0")
      }
      sb.write_string(ae.to_string())
    }
    return (neg, sb.to_string())
  }
  // Fixed notation
  let sb = StringBuilder::new()
  if eff_exp < 0 {
    sb.write_string("0.")
    let mut z = 0
    while z < -eff_exp - 1 {
      sb.write_string("0")
      z = z + 1
    }
    let want = if alt_form { p } else { sig_len }
    let mut i = 0
    while i < want {
      let d = if i < final_d.length() { final_d[i] } else { 0 }
      sb.write_byte((d + 48).to_byte())
      i = i + 1
    }
  } else {
    let int_len = eff_exp + 1
    let mut i = 0
    while i < int_len {
      let d = if i < final_d.length() { final_d[i] } else { 0 }
      sb.write_byte((d + 48).to_byte())
      i = i + 1
    }
    let want = if alt_form { p } else { sig_len }
    if want > int_len || alt_form {
      sb.write_string(".")
      let mut j = int_len
      while j < want {
        let d = if j < final_d.length() { final_d[j] } else { 0 }
        sb.write_byte((d + 48).to_byte())
        j = j + 1
      }
    }
  }
  (neg, sb.to_string())
}

///| Format hexadecimal float `%a`/`%A` (P1-10).
fn format_f64_hex(val_in : Double, prec : Int, upper : Bool, alt_form : Bool) -> (Bool, String) {
  let bits = val_in.to_bits()
  let neg = (bits >> 63) != 0L
  if val_in != val_in {
    return (false, if upper { "NAN" } else { "nan" })
  }
  if val_in == 1.0 / 0.0 {
    return (false, if upper { "INF" } else { "inf" })
  }
  if val_in == -1.0 / 0.0 {
    return (true, if upper { "INF" } else { "inf" })
  }
  let hex_chars = if upper { "0123456789ABCDEF" } else { "0123456789abcdef" }
  let raw_exp = ((bits >> 52) & 0x7FFL).to_int()
  let raw_mant = bits & 0x000FFFFFFFFFFFFFL
  let sb = StringBuilder::new()
  sb.write_string(if upper { "0X" } else { "0x" })
  if raw_exp == 0 && raw_mant == 0L {
    sb.write_string("0")
    if prec > 0 || alt_form {
      sb.write_string(".")
      let mut i = 0
      while i < prec {
        sb.write_string("0")
        i = i + 1
      }
    }
    sb.write_string(if upper { "P+0" } else { "p+0" })
    return (neg, sb.to_string())
  }
  let lead_digit = if raw_exp == 0 { "0" } else { "1" }
  let exp2 = if raw_exp == 0 { -1022 } else { raw_exp - 1023 }
  // 13 hex nibbles from 52-bit raw_mant
  let nibs : Array[Int] = []
  let mut k = 12
  while k >= 0 {
    nibs.push(((raw_mant >> (k * 4)) & 0xFL).to_int())
    k = k - 1
  }
  let mut nlen = 13
  if prec < 0 {
    while nlen > 0 && nibs[nlen - 1] == 0 {
      nlen = nlen - 1
    }
  } else {
    nlen = prec
  }
  sb.write_string(lead_digit)
  if nlen > 0 || alt_form {
    sb.write_string(".")
    let mut i = 0
    while i < nlen {
      let nib = if i < 13 { nibs[i] } else { 0 }
      sb.write_byte(hex_chars.code_unit_at(nib).to_byte())
      i = i + 1
    }
  }
  sb.write_string(if upper { "P" } else { "p" })
  if exp2 >= 0 {
    sb.write_string("+")
    sb.write_string(exp2.to_string())
  } else {
    sb.write_string(exp2.to_string())
  }
  (neg, sb.to_string())
}

///| 2/pi in base 2^30 (40 limbs = 1200 bits of precision for Payne-Hanek reduction up to 2^1023).
fn two_over_pi_limb(idx : Int) -> Int64 {
  match idx {
    0 => 683565275L
    1 => 618938706L
    2 => 670080351L
    3 => 301282525L
    4 => 808900773L
    5 => 429114425L
    6 => 17299781L
    7 => 598466235L
    8 => 827878857L
    9 => 115581988L
    10 => 927694873L
    11 => 154069513L
    12 => 879003455L
    13 => 568242635L
    14 => 78028027L
    15 => 679622133L
    16 => 196006177L
    17 => 244958978L
    18 => 449936889L
    19 => 20550102L
    20 => 241226958L
    21 => 524929093L
    22 => 1043265508L
    23 => 674963448L
    24 => 637532033L
    25 => 427884274L
    26 => 1011232104L
    27 => 174923629L
    28 => 228570057L
    29 => 1018207092L
    30 => 1025047962L
    31 => 509602349L
    32 => 491384497L
    33 => 1052663575L
    34 => 754195687L
    35 => 931811986L
    36 => 983236311L
    37 => 991033557L
    38 => 874600460L
    39 => 809958523L
    _ => 0L
  }
}

///| Payne-Hanek range reduction: reduces finite `x >= 0` modulo `pi/2`.
///| Returns `(quadrant & 3, r)` with `r` in `[0, pi/2)`.
fn payne_hanek_reduce(x_pos : Double) -> (Int, Double) {
  let pio2_1 = 1.57079632673412561417
  let pio2_2 = 6.07710050650619224932e-11
  let pio2_3 = 2.02226624879595063154e-21
  if x_pos < 1048576.0 {
    let k_f = f64_floor(x_pos / 1.57079632679489661923)
    let q = (k_f.to_int64() & 3L).to_int()
    let r = ((x_pos - k_f * pio2_1) - k_f * pio2_2) - k_f * pio2_3
    return (q, r)
  }
  // Exact Payne-Hanek: x = mant * 2^exp2 (exp2 >= -32)
  let bits = x_pos.to_bits()
  let raw_exp = ((bits >> 52) & 0x7FFL).to_int()
  let mant = ((bits & 0x000FFFFFFFFFFFFFL) | 0x0010000000000000L)
  let exp2 = raw_exp - 1023 - 52
  // We want (mant * 2^exp2) * (2/pi) mod 4.
  // Construct 2/pi * 2^(30*40) as BigUInt (or take limbs around bit position exp2)
  // Using BigUInt on the 40 limbs of 2/pi:
  // 2/pi ≈ sum_{k=0..39} limb[k] * 2^(-30*(k+1))
  // So x * (2/pi) = mant * sum_{k} limb[k] * 2^(exp2 - 30*(k+1))
  // We only need bits with weight in [2^-120, 2^1].
  let mut k_start = (exp2 - 60) / 30
  if k_start < 0 {
    k_start = 0
  }
  let mut k_end = (exp2 + 180) / 30
  if k_end > 39 {
    k_end = 39
  }
  // Build slice_val = sum_{k=k_start..k_end} limb[k] * 2^(30*(k_end - k))
  let slice = BigUInt::zero()
  let mut k = k_start
  while k <= k_end {
    slice.shl(30)
    slice.mul_add(1L, two_over_pi_limb(k))
    k = k + 1
  }
  // Multiply slice by mant (53 bits = hi23 * 2^30 + lo30)
  let m_hi = mant >> 30
  let m_lo = mant & BIG_MASK
  let p_hi = slice.clone_big()
  p_hi.mul_add(m_hi, 0L)
  p_hi.shl(30)
  let p_lo = slice.clone_big()
  p_lo.mul_add(m_lo, 0L)
  // Add p_hi + p_lo
  let mut carry = 0L
  let max_l = if p_hi.limbs.length() > p_lo.limbs.length() { p_hi.limbs.length() } else { p_lo.limbs.length() }
  let sum_limbs : Array[Int64] = []
  let mut i = 0
  while i < max_l || carry > 0L {
    let a = if i < p_hi.limbs.length() { p_hi.limbs[i] } else { 0L }
    let b = if i < p_lo.limbs.length() { p_lo.limbs[i] } else { 0L }
    let s = a + b + carry
    sum_limbs.push(s & BIG_MASK)
    carry = s >> 30
    i = i + 1
  }
  let prod = BigUInt::{ limbs: sum_limbs }
  // The binary point is at bit index `bp = 30 * (k_end + 1) - exp2` from LSB of prod!
  let bp = 30 * (k_end + 1) - exp2
  // Extract 2 bits at [bp, bp+1] for quadrant, and 64 bits below bp for fractional part!
  let get_bit = fn(bit_idx : Int) -> Int64 {
    if bit_idx < 0 {
      return 0L
    }
    let wi = bit_idx / 30
    let bi = bit_idx % 30
    if wi >= prod.limbs.length() {
      0L
    } else {
      (prod.limbs[wi] >> bi) & 1L
    }
  }
  let q = (get_bit(bp) | (get_bit(bp + 1) << 1)).to_int()
  // Extract 60 fractional bits below bp: top 30 bits + next 30 bits
  let mut frac_hi = 0L
  let mut j = 1
  while j <= 30 {
    frac_hi = (frac_hi << 1) | get_bit(bp - j)
    j = j + 1
  }
  let mut frac_lo = 0L
  while j <= 60 {
    frac_lo = (frac_lo << 1) | get_bit(bp - j)
    j = j + 1
  }
  let frac = frac_hi.to_double() / 1073741824.0 + frac_lo.to_double() / 1152921504606846976.0
  let r = frac * 1.57079632679489661923
  (q, r)
}
