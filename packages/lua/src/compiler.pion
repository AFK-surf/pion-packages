///| Bytecode compiler from Lua 5.4 AST to compact 64-bit register instructions (`Proto`).
///| Supports lexical closures with multi-level open/closed upvalues, `_ENV` upvalue 0,
///| multi-return expansion, tail-call optimization (`OP_TAILCALL`), and `break` patching.

///|
struct LocalVar {
  name : String
  reg : Int
  depth : Int
  mut is_captured : Bool
  is_const : Bool
  is_close : Bool
}

///|
struct LoopCtx {
  depth : Int
  base_reg : Int
  break_jumps : Array[Int]
}

///|
struct LabelDesc {
  name : String
  pc : Int
  depth : Int
  num_locals : Int
  line : Int
}

///|
struct GotoDesc {
  name : String
  jmp_pc : Int
  mut depth : Int
  mut num_locals : Int
  mut close_reg : Int // -1 if none, else lowest reg to close
  line : Int
}

///|
enum SuffixStep {
  Field(String, Int)
  Index(Expr, Int)
  Call(Array[Expr], Int)
  MethodCall(String, Array[Expr], Int)
}

///|
struct FuncCompiler {
  parent : Option[FuncCompiler]
  code : Array[Int64]
  lines : Array[Int]
  consts : Array[LuaValue]
  const_str_map : Map[String, Int]
  const_int_map : Map[Int64, Int]
  const_flt_map : Map[Int64, Int]
  protos : Array[Proto]
  upvals : Array[UpvalDesc]
  upval_names : Array[String]
  upval_const : Array[Bool]
  locals : Array[LocalVar]
  loops : Array[LoopCtx]
  labels : Array[LabelDesc]
  pending_gotos : Array[GotoDesc]
  mut scope_depth : Int
  mut free_reg : Int
  mut max_stack : Int
  num_params : Int
  is_vararg : Bool
  source_name : String
}

///|
fn FuncCompiler::new(
  parent : Option[FuncCompiler],
  num_params : Int,
  is_vararg : Bool,
  source_name : String,
) -> FuncCompiler {
  FuncCompiler::{
    parent: parent,
    code: [],
    lines: [],
    consts: [],
    const_str_map: Map::new(),
    const_int_map: Map::new(),
    const_flt_map: Map::new(),
    protos: [],
    upvals: [],
    upval_names: [],
    upval_const: [],
    locals: [],
    loops: [],
    labels: [],
    pending_gotos: [],
    scope_depth: 0,
    free_reg: 0,
    max_stack: 2,
    num_params: num_params,
    is_vararg: is_vararg,
    source_name: source_name,
  }
}

///|
fn FuncCompiler::reserve_reg(self : FuncCompiler, r : Int) -> Unit {
  if r + 1 > self.max_stack {
    self.max_stack = r + 1
  }
}

///|
fn FuncCompiler::alloc_reg(self : FuncCompiler) -> Int {
  let r = self.free_reg
  self.free_reg = r + 1
  self.reserve_reg(r)
  r
}

///|
fn FuncCompiler::emit(self : FuncCompiler, inst : Int64, line : Int) -> Int {
  let idx = self.code.length()
  self.code.push(inst)
  self.lines.push(line)
  idx
}

///|
fn FuncCompiler::emit_loadk(self : FuncCompiler, dst : Int, k : Int, line : Int) -> Unit {
  if k <= 65535 {
    let _ = self.emit(enc_abc(OP_LOADK, dst, k, 0), line)
  } else {
    let _ = self.emit(enc_abc(OP_LOADKX, dst, 0, 0), line)
    let _ = self.emit(enc_ax(OP_EXTRAARG, k), line)
  }
}

///|
fn FuncCompiler::emit_getfield(self : FuncCompiler, dst : Int, obj_reg : Int, field : String, line : Int) -> Unit {
  let k = self.add_const(LuaValue::Str(field))
  if k <= 65535 {
    let _ = self.emit(enc_abc(OP_GETFIELD, dst, obj_reg, k), line)
  } else {
    let saved = self.free_reg
    let kreg = self.alloc_reg()
    self.emit_loadk(kreg, k, line)
    let _ = self.emit(enc_abc(OP_GETTABLE, dst, obj_reg, kreg), line)
    self.free_reg = saved
  }
}

///|
fn FuncCompiler::emit_setfield(self : FuncCompiler, obj_reg : Int, field : String, val_reg : Int, line : Int) -> Unit {
  let k = self.add_const(LuaValue::Str(field))
  if k <= 65535 {
    let _ = self.emit(enc_abc(OP_SETFIELD, obj_reg, k, val_reg), line)
  } else {
    let saved = self.free_reg
    let kreg = self.alloc_reg()
    self.emit_loadk(kreg, k, line)
    let _ = self.emit(enc_abc(OP_SETTABLE, obj_reg, kreg, val_reg), line)
    self.free_reg = saved
  }
}

///|
fn FuncCompiler::emit_gettabup(self : FuncCompiler, dst : Int, uv : Int, field : String, line : Int) -> Unit {
  let k = self.add_const(LuaValue::Str(field))
  if k <= 65535 {
    let _ = self.emit(enc_abc(OP_GETTABUP, dst, uv, k), line)
  } else {
    let saved = self.free_reg
    let treg = self.alloc_reg()
    let kreg = self.alloc_reg()
    let _ = self.emit(enc_abc(OP_GETUPVAL, treg, uv, 0), line)
    self.emit_loadk(kreg, k, line)
    let _ = self.emit(enc_abc(OP_GETTABLE, dst, treg, kreg), line)
    self.free_reg = saved
  }
}

///|
fn FuncCompiler::emit_settabup(self : FuncCompiler, uv : Int, field : String, val_reg : Int, line : Int) -> Unit {
  let k = self.add_const(LuaValue::Str(field))
  if k <= 65535 {
    let _ = self.emit(enc_abc(OP_SETTABUP, uv, k, val_reg), line)
  } else {
    let saved = self.free_reg
    let treg = self.alloc_reg()
    let kreg = self.alloc_reg()
    let _ = self.emit(enc_abc(OP_GETUPVAL, treg, uv, 0), line)
    self.emit_loadk(kreg, k, line)
    let _ = self.emit(enc_abc(OP_SETTABLE, treg, kreg, val_reg), line)
    self.free_reg = saved
  }
}

///|
fn FuncCompiler::emit_self(self : FuncCompiler, base : Int, obj_reg : Int, method_name : String, line : Int) -> Unit {
  let mk = self.add_const(LuaValue::Str(method_name))
  if mk <= 65535 {
    let _ = self.emit(enc_abc(OP_SELF, base, obj_reg, mk), line)
  } else {
    let saved = self.free_reg
    let kreg = self.alloc_reg()
    if base + 1 != obj_reg {
      let _ = self.emit(enc_abc(OP_MOVE, base + 1, obj_reg, 0), line)
    }
    self.emit_loadk(kreg, mk, line)
    let _ = self.emit(enc_abc(OP_GETTABLE, base, base + 1, kreg), line)
    self.free_reg = saved
  }
}

///|
fn FuncCompiler::emit_jmp(self : FuncCompiler, close_a : Int, line : Int) -> Int {
  self.emit(enc_asbx(OP_JMP, close_a, 0), line)
}

///|
fn FuncCompiler::patch_jmp(self : FuncCompiler, jmp_pc : Int, target_pc : Int) -> Unit {
  let old = self.code[jmp_pc]
  let op = dec_op(old)
  let a = dec_a(old)
  let offset = target_pc - (jmp_pc + 1)
  self.code[jmp_pc] = enc_asbx(op, a, offset)
}

///|
fn FuncCompiler::patch_jmp_with_close(self : FuncCompiler, jmp_pc : Int, close_a : Int, target_pc : Int) -> Unit {
  let old = self.code[jmp_pc]
  let op = dec_op(old)
  let offset = target_pc - (jmp_pc + 1)
  self.code[jmp_pc] = enc_asbx(op, close_a, offset)
}

///| O(1) deduplicated constant pool insertion (P0-6).
fn FuncCompiler::add_const(self : FuncCompiler, v : LuaValue) -> Int {
  match v {
    LuaValue::Str(s) => {
      match self.const_str_map.get(s) {
        Some(idx) => return idx
        None => {
          let n = self.consts.length()
          self.consts.push(v)
          self.const_str_map.set(s, n)
          return n
        }
      }
    }
    LuaValue::Int(iv) => {
      match self.const_int_map.get(iv) {
        Some(idx) => return idx
        None => {
          let n = self.consts.length()
          self.consts.push(v)
          self.const_int_map.set(iv, n)
          return n
        }
      }
    }
    LuaValue::Float(fv) => {
      let bits = fv.to_bits()
      match self.const_flt_map.get(bits) {
        Some(idx) => return idx
        None => {
          let n = self.consts.length()
          self.consts.push(v)
          self.const_flt_map.set(bits, n)
          return n
        }
      }
    }
    _ => {
      let mut i = 0
      let n = self.consts.length()
      while i < n {
        if value_strict_eq(self.consts[i], v) {
          return i
        }
        i = i + 1
      }
      self.consts.push(v)
      n
    }
  }
}

///|
fn FuncCompiler::declare_local_attr(
  self : FuncCompiler,
  name : String,
  is_const : Bool,
  is_close : Bool,
  line : Int,
) -> Result[Int, LuaError] {
  if self.locals.length() >= 200 {
    return Err(LuaError::new(LuaErrorKind::SyntaxError, "too many local variables (limit is 200)", line))
  }
  let r = self.alloc_reg()
  self.locals.push(
    LocalVar::{
      name: name,
      reg: r,
      depth: self.scope_depth,
      is_captured: false,
      is_const: is_const || is_close,
      is_close: is_close,
    },
  )
  Ok(r)
}

///|
fn FuncCompiler::declare_local(self : FuncCompiler, name : String, line : Int) -> Result[Int, LuaError] {
  self.declare_local_attr(name, false, false, line)
}

///|
fn FuncCompiler::enter_scope(self : FuncCompiler) -> Unit {
  self.scope_depth = self.scope_depth + 1
}

///|
fn FuncCompiler::leave_scope(self : FuncCompiler, line : Int) -> Unit {
  let mut need_close = false
  let mut lowest_reg = self.free_reg
  while self.locals.length() > 0 && self.locals[self.locals.length() - 1].depth == self.scope_depth {
    let lv = self.locals[self.locals.length() - 1]
    if lv.is_captured || lv.is_close {
      need_close = true
    }
    if lv.reg < lowest_reg {
      lowest_reg = lv.reg
    }
    let _ = self.locals.pop()
  }
  if need_close {
    let _ = self.emit(enc_abc(OP_CLOSE, lowest_reg, 0, 0), line)
  }
  // Remove labels declared in this scope
  while self.labels.length() > 0 && self.labels[self.labels.length() - 1].depth == self.scope_depth {
    let _ = self.labels.pop()
  }
  // Propagate pending gotos from this scope to enclosing scope, recording any close needed
  let mut gi = 0
  while gi < self.pending_gotos.length() {
    let g = self.pending_gotos[gi]
    if g.depth == self.scope_depth {
      g.depth = self.scope_depth - 1
      g.num_locals = self.locals.length()
      if need_close {
        if g.close_reg < 0 || lowest_reg < g.close_reg {
          g.close_reg = lowest_reg
        }
      }
    }
    gi = gi + 1
  }
  self.free_reg = lowest_reg
  self.scope_depth = self.scope_depth - 1
}

///|
fn FuncCompiler::resolve_local_idx(self : FuncCompiler, name : String) -> Int {
  let mut i = self.locals.length() - 1
  while i >= 0 {
    if self.locals[i].name == name {
      return i
    }
    i = i - 1
  }
  -1
}

///|
fn FuncCompiler::resolve_local(self : FuncCompiler, name : String) -> Int {
  let idx = self.resolve_local_idx(name)
  if idx >= 0 {
    self.locals[idx].reg
  } else {
    -1
  }
}

///|
fn FuncCompiler::mark_local_captured(self : FuncCompiler, reg : Int) -> Unit {
  let mut i = self.locals.length() - 1
  while i >= 0 {
    if self.locals[i].reg == reg {
      self.locals[i].is_captured = true
      return
    }
    i = i - 1
  }
}

///|
fn FuncCompiler::add_upval(
  self : FuncCompiler,
  name : String,
  in_stack : Bool,
  index : Int,
  is_const : Bool,
  line : Int,
) -> Result[Int, LuaError] {
  let mut i = 0
  while i < self.upvals.length() {
    let u = self.upvals[i]
    if u.in_stack == in_stack && u.index == index {
      return Ok(i)
    }
    i = i + 1
  }
  if self.upvals.length() >= 255 {
    return Err(LuaError::new(LuaErrorKind::SyntaxError, "too many upvalues (limit is 255)", line))
  }
  self.upvals.push(UpvalDesc::{ in_stack: in_stack, index: index })
  self.upval_names.push(name)
  self.upval_const.push(is_const)
  Ok(self.upvals.length() - 1)
}

///|
fn FuncCompiler::resolve_upval(self : FuncCompiler, name : String, line : Int) -> Result[Int, LuaError] {
  match self.parent {
    None => {
      // Top-level chunk has `_ENV` at upval 0
      if name == "_ENV" {
        Ok(0)
      } else {
        Ok(-1)
      }
    }
    Some(p) => {
      let local_idx = p.resolve_local_idx(name)
      if local_idx >= 0 {
        let lv = p.locals[local_idx]
        p.mark_local_captured(lv.reg)
        return self.add_upval(name, true, lv.reg, lv.is_const, line)
      }
      let parent_uv = match p.resolve_upval(name, line) {
        Ok(u) => u
        Err(e) => return Err(e)
      }
      if parent_uv >= 0 {
        let pconst = if parent_uv < p.upval_const.length() { p.upval_const[parent_uv] } else { false }
        return self.add_upval(name, false, parent_uv, pconst, line)
      }
      Ok(-1)
    }
  }
}

///| Check whether a goto at `g` can jump to `lbl` without crossing an active local declaration.
fn FuncCompiler::resolve_goto_to_label(
  self : FuncCompiler,
  g : GotoDesc,
  lbl : LabelDesc,
  is_end_of_block : Bool,
) -> Result[Unit, LuaError] {
  if lbl.num_locals > g.num_locals && !is_end_of_block {
    let var_name = if g.num_locals < self.locals.length() {
      self.locals[g.num_locals].name
    } else {
      "?"
    }
    return Err(
      LuaError::new(
        LuaErrorKind::SyntaxError,
        "goto '" + g.name + "' jumps into the scope of local '" + var_name + "'",
        g.line,
      ),
    )
  }
  let close_a = if g.close_reg >= 0 { g.close_reg + 1 } else { 0 }
  self.patch_jmp_with_close(g.jmp_pc, close_a, lbl.pc)
  Ok(())
}

///| Check whether an expression can return multiple values when in last position.
fn is_multiret_expr(e : Expr) -> Bool {
  match e {
    Expr::Call(_, _, _) | Expr::MethodCall(_, _, _, _) | Expr::Vararg(_) => true
    _ => false
  }
}

///| Extracted iterative suffix chain compiler (keeps `compile_expr_inner` stack frame tiny for Wasm32).
fn FuncCompiler::compile_suffix_chain(
  self : FuncCompiler,
  e : Expr,
  dst : Int,
  nresults : Int,
) -> Result[Unit, LuaError] {
  let steps : Array[SuffixStep] = []
  let mut cur = e
  while true {
    match cur {
      Expr::Field(obj, field, line) => {
        steps.push(SuffixStep::Field(field, line))
        cur = obj
      }
      Expr::Index(obj, idx, line) => {
        steps.push(SuffixStep::Index(idx, line))
        cur = obj
      }
      Expr::Call(callee, args, line) => {
        steps.push(SuffixStep::Call(args, line))
        cur = callee
      }
      Expr::MethodCall(obj, mname, args, line) => {
        steps.push(SuffixStep::MethodCall(mname, args, line))
        cur = obj
      }
      _ => break
    }
  }
  let saved = self.free_reg
  let work = if nresults == 0 || nresults > 1 { dst } else { self.alloc_reg() }
  self.reserve_reg(work)
  if self.free_reg <= work {
    self.free_reg = work + 1
  }
  match self.compile_expr_to(cur, work) {
    Ok(_) => ()
    Err(err) => return Err(err)
  }
  let mut si = steps.length() - 1
  while si >= 0 {
    let is_last = si == 0
    let target_reg = if is_last { dst } else { work }
    match steps[si] {
      SuffixStep::Field(field, line) => {
        self.emit_getfield(target_reg, work, field, line)
      }
      SuffixStep::Index(idx, line) => {
        let saved_idx = self.free_reg
        let idx_reg = self.alloc_reg()
        match self.compile_expr_to(idx, idx_reg) {
          Ok(_) => ()
          Err(err) => return Err(err)
        }
        let _ = self.emit(enc_abc(OP_GETTABLE, target_reg, work, idx_reg), line)
        self.free_reg = saved_idx
      }
      SuffixStep::Call(args, line) => {
        let call_base = if is_last { dst } else { work }
        if call_base != work {
          let _ = self.emit(enc_abc(OP_MOVE, call_base, work, 0), line)
        }
        let saved_call = self.free_reg
        self.reserve_reg(call_base)
        if self.free_reg <= call_base {
          self.free_reg = call_base + 1
        }
        let nargs = args.length()
        let mut last_is_multi = false
        let mut ai = 0
        while ai < nargs {
          let arg_reg = call_base + 1 + ai
          self.reserve_reg(arg_reg)
          self.free_reg = arg_reg + 1
          if ai == nargs - 1 && is_multiret_expr(args[ai]) {
            match self.compile_expr_inner(args[ai], arg_reg, 0) {
              Ok(_) => ()
              Err(err) => return Err(err)
            }
            last_is_multi = true
          } else {
            match self.compile_expr_to(args[ai], arg_reg) {
              Ok(_) => ()
              Err(err) => return Err(err)
            }
          }
          ai = ai + 1
        }
        let b = if last_is_multi { 0 } else { nargs + 1 }
        let want = if is_last { nresults } else { 1 }
        let c = if want == 0 { 0 } else { want + 1 }
        let _ = self.emit(enc_abc(OP_CALL, call_base, b, c), line)
        self.free_reg = saved_call
      }
      SuffixStep::MethodCall(method_name, args, line) => {
        let call_base = if is_last { dst } else { work }
        let saved_call = self.free_reg
        self.reserve_reg(call_base + 1)
        if self.free_reg <= call_base + 1 {
          self.free_reg = call_base + 2
        }
        self.emit_self(call_base, work, method_name, line)
        let nargs = args.length()
        let mut last_is_multi = false
        let mut ai = 0
        while ai < nargs {
          let arg_reg = call_base + 2 + ai
          self.reserve_reg(arg_reg)
          self.free_reg = arg_reg + 1
          if ai == nargs - 1 && is_multiret_expr(args[ai]) {
            match self.compile_expr_inner(args[ai], arg_reg, 0) {
              Ok(_) => ()
              Err(err) => return Err(err)
            }
            last_is_multi = true
          } else {
            match self.compile_expr_to(args[ai], arg_reg) {
              Ok(_) => ()
              Err(err) => return Err(err)
            }
          }
          ai = ai + 1
        }
        let b = if last_is_multi { 0 } else { nargs + 2 }
        let want = if is_last { nresults } else { 1 }
        let c = if want == 0 { 0 } else { want + 1 }
        let _ = self.emit(enc_abc(OP_CALL, call_base, b, c), line)
        self.free_reg = saved_call
      }
    }
    si = si - 1
  }
  self.free_reg = saved
  Ok(())
}

///| Extracted iterative binary chain compiler (keeps `compile_expr_inner` stack frame tiny for Wasm32).
fn FuncCompiler::compile_binary_chain(self : FuncCompiler, e : Expr, dst : Int) -> Result[Unit, LuaError] {
  let ops : Array[BinOp] = []
  let rhss : Array[Expr] = []
  let lines_b : Array[Int] = []
  let mut cur = e
  while true {
    match cur {
      Expr::Binary(op, lhs, rhs, line) => {
        ops.push(op)
        rhss.push(rhs)
        lines_b.push(line)
        cur = lhs
      }
      _ => break
    }
  }
  let saved = self.free_reg
  let acc = self.alloc_reg()
  let r2 = self.alloc_reg()
  match self.compile_expr_to(cur, acc) {
    Ok(_) => ()
    Err(err) => return Err(err)
  }
  let mut bi = ops.length() - 1
  while bi >= 0 {
    let op = ops[bi]
    let rhs = rhss[bi]
    let line = lines_b[bi]
    let out_reg = if bi == 0 { dst } else { acc }
    match op {
      BinOp::And => {
        let _ = self.emit(enc_abc(OP_TEST, acc, 0, 1), line)
        let jmp = self.emit_jmp(0, line)
        match self.compile_expr_to(rhs, acc) {
          Ok(_) => ()
          Err(err) => return Err(err)
        }
        self.patch_jmp(jmp, self.code.length())
        if out_reg != acc {
          let _ = self.emit(enc_abc(OP_MOVE, out_reg, acc, 0), line)
        }
      }
      BinOp::Or => {
        let _ = self.emit(enc_abc(OP_TEST, acc, 0, 0), line)
        let jmp = self.emit_jmp(0, line)
        match self.compile_expr_to(rhs, acc) {
          Ok(_) => ()
          Err(err) => return Err(err)
        }
        self.patch_jmp(jmp, self.code.length())
        if out_reg != acc {
          let _ = self.emit(enc_abc(OP_MOVE, out_reg, acc, 0), line)
        }
      }
      BinOp::Concat => {
        match self.compile_expr_to(rhs, r2) {
          Ok(_) => ()
          Err(err) => return Err(err)
        }
        let _ = self.emit(enc_abc(OP_CONCAT, out_reg, acc, r2), line)
      }
      BinOp::Eq | BinOp::Ne | BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge => {
        match self.compile_expr_to(rhs, r2) {
          Ok(_) => ()
          Err(err) => return Err(err)
        }
        match op {
          BinOp::Eq => {
            let _ = self.emit(enc_abc(OP_EQ, 1, acc, r2), line)
          }
          BinOp::Ne => {
            let _ = self.emit(enc_abc(OP_EQ, 0, acc, r2), line)
          }
          BinOp::Lt => {
            let _ = self.emit(enc_abc(OP_LT, 1, acc, r2), line)
          }
          BinOp::Le => {
            let _ = self.emit(enc_abc(OP_LE, 1, acc, r2), line)
          }
          BinOp::Gt => {
            let _ = self.emit(enc_abc(OP_LT, 1, r2, acc), line)
          }
          BinOp::Ge => {
            let _ = self.emit(enc_abc(OP_LE, 1, r2, acc), line)
          }
          _ => ()
        }
        let _ = self.emit(enc_asbx(OP_JMP, 0, 1), line)
        let _ = self.emit(enc_abc(OP_LOADBOOL, out_reg, 0, 1), line)
        let _ = self.emit(enc_abc(OP_LOADBOOL, out_reg, 1, 0), line)
      }
      _ => {
        match self.compile_expr_to(rhs, r2) {
          Ok(_) => ()
          Err(err) => return Err(err)
        }
        let opc = match op {
          BinOp::Add => OP_ADD
          BinOp::Sub => OP_SUB
          BinOp::Mul => OP_MUL
          BinOp::Div => OP_DIV
          BinOp::IDiv => OP_IDIV
          BinOp::Mod => OP_MOD
          BinOp::Pow => OP_POW
          BinOp::BAnd => OP_BAND
          BinOp::BOr => OP_BOR
          BinOp::BXor => OP_BXOR
          BinOp::Shl => OP_SHL
          BinOp::Shr => OP_SHR
          _ => OP_ADD
        }
        let _ = self.emit(enc_abc(opc, out_reg, acc, r2), line)
      }
    }
    bi = bi - 1
  }
  self.free_reg = saved
  Ok(())
}

///| Compile a single expression into target register `dst`.
fn FuncCompiler::compile_expr_to(self : FuncCompiler, e : Expr, dst : Int) -> Result[Unit, LuaError] {
  self.reserve_reg(dst)
  let saved_free = self.free_reg
  if self.free_reg <= dst {
    self.free_reg = dst + 1
  }
  let res = self.compile_expr_inner(e, dst, 1)
  self.free_reg = saved_free
  res
}

///| Compile an expression expecting `nresults` values into `dst..dst+nresults-1`
///| (`nresults == 0` means all available values, updating VM `top`).
fn FuncCompiler::compile_expr_inner(
  self : FuncCompiler,
  e : Expr,
  dst : Int,
  nresults : Int,
) -> Result[Unit, LuaError] {
  self.reserve_reg(dst)
  match e {
    Expr::Nil(line) => {
      let _ = self.emit(enc_abc(OP_LOADNIL, dst, 0, 0), line)
    }
    Expr::Bool(b, line) => {
      let _ = self.emit(enc_abc(OP_LOADBOOL, dst, if b { 1 } else { 0 }, 0), line)
    }
    Expr::Int(n, line) => {
      if n >= -8000000L && n <= 8000000L {
        let _ = self.emit(enc_asbx(OP_LOADI, dst, n.to_int()), line)
      } else {
        let k = self.add_const(LuaValue::Int(n))
        self.emit_loadk(dst, k, line)
      }
    }
    Expr::Float(f, line) => {
      let k = self.add_const(LuaValue::Float(f))
      self.emit_loadk(dst, k, line)
    }
    Expr::Str(s, line) => {
      let k = self.add_const(LuaValue::Str(s))
      self.emit_loadk(dst, k, line)
    }
    Expr::Vararg(line) => {
      if !self.is_vararg {
        return Err(LuaError::new(LuaErrorKind::SyntaxError, "cannot use '...' outside a vararg function", line))
      }
      let b = if nresults == 0 { 0 } else { nresults + 1 }
      let _ = self.emit(enc_abc(OP_VARARG, dst, b, 0), line)
    }
    Expr::Paren(inner, _line) => {
      match self.compile_expr_to(inner, dst) {
        Ok(_) => ()
        Err(err) => return Err(err)
      }
    }
    Expr::Ident(name, line) => {
      let lreg = self.resolve_local(name)
      if lreg >= 0 {
        if lreg != dst {
          let _ = self.emit(enc_abc(OP_MOVE, dst, lreg, 0), line)
        }
      } else {
        let uv = match self.resolve_upval(name, line) {
          Ok(u) => u
          Err(err) => return Err(err)
        }
        if uv >= 0 {
          let _ = self.emit(enc_abc(OP_GETUPVAL, dst, uv, 0), line)
        } else {
          // P1-3: resolve `_ENV` lexically (local first, then upvalue)
          let env_reg = self.resolve_local("_ENV")
          if env_reg >= 0 {
            self.emit_getfield(dst, env_reg, name, line)
          } else {
            let env_uv = match self.resolve_upval("_ENV", line) {
              Ok(u) => u
              Err(err) => return Err(err)
            }
            self.emit_gettabup(dst, env_uv, name, line)
          }
        }
      }
    }
    Expr::Field(_, _, _) | Expr::Index(_, _, _) | Expr::Call(_, _, _) | Expr::MethodCall(_, _, _, _) => {
      return self.compile_suffix_chain(e, dst, nresults)
    }
    Expr::Unary(op, sub, line) => {
      let saved = self.free_reg
      let sub_reg = self.alloc_reg()
      match self.compile_expr_to(sub, sub_reg) {
        Ok(_) => ()
        Err(err) => return Err(err)
      }
      let opc = match op {
        UnOp::Neg => OP_UNM
        UnOp::BNot => OP_BNOT
        UnOp::Not => OP_NOT
        UnOp::Len => OP_LEN
      }
      let _ = self.emit(enc_abc(opc, dst, sub_reg, 0), line)
      self.free_reg = saved
    }
    Expr::Binary(_, _, _, _) => {
      return self.compile_binary_chain(e, dst)
    }
    Expr::TableCtor(fields, line) => {
      let saved = self.free_reg
      let tbl_reg = dst
      if self.free_reg <= tbl_reg {
        self.free_reg = tbl_reg + 1
      }
      self.reserve_reg(tbl_reg)
      let _ = self.emit(enc_abc(OP_NEWTABLE, tbl_reg, 0, 0), line)
      let mut array_batch = 0
      let mut batch_num = 1
      let mut i = 0
      let n = fields.length()
      while i < n {
        let f = fields[i]
        match f.key {
          Some(kexpr) => {
            let kreg = self.alloc_reg()
            match self.compile_expr_to(kexpr, kreg) {
              Ok(_) => ()
              Err(err) => return Err(err)
            }
            let vreg = self.alloc_reg()
            match self.compile_expr_to(f.val_expr, vreg) {
              Ok(_) => ()
              Err(err) => return Err(err)
            }
            let _ = self.emit(enc_abc(OP_SETTABLE, tbl_reg, kreg, vreg), line)
            self.free_reg = tbl_reg + 1 + array_batch
          }
          None => {
            let elem_reg = tbl_reg + 1 + array_batch
            self.reserve_reg(elem_reg)
            self.free_reg = elem_reg + 1
            if i == n - 1 && is_multiret_expr(f.val_expr) {
              match self.compile_expr_inner(f.val_expr, elem_reg, 0) {
                Ok(_) => ()
                Err(err) => return Err(err)
              }
              let _ = self.emit(enc_abc(OP_SETLIST, tbl_reg, 0, batch_num), line)
              array_batch = 0
              self.free_reg = tbl_reg + 1
            } else {
              match self.compile_expr_to(f.val_expr, elem_reg) {
                Ok(_) => ()
                Err(err) => return Err(err)
              }
              array_batch = array_batch + 1
              if array_batch == 50 {
                let _ = self.emit(enc_abc(OP_SETLIST, tbl_reg, 50, batch_num), line)
                batch_num = batch_num + 1
                array_batch = 0
                self.free_reg = tbl_reg + 1
              }
            }
          }
        }
        i = i + 1
      }
      if array_batch > 0 {
        let _ = self.emit(enc_abc(OP_SETLIST, tbl_reg, array_batch, batch_num), line)
      }
      self.free_reg = saved
    }
    Expr::FuncExpr(fb) => {
      let child_proto = match self.compile_func_body(fb) {
        Ok(p) => p
        Err(err) => return Err(err)
      }
      let p_idx = self.protos.length()
      self.protos.push(child_proto)
      let _ = self.emit(enc_abc(OP_CLOSURE, dst, p_idx, 0), fb.line)
    }
  }
  Ok(())
}

///|
fn FuncCompiler::compile_func_body(self : FuncCompiler, fb : FuncBody) -> Result[Proto, LuaError] {
  let fc = FuncCompiler::new(Some(self), fb.params.length(), fb.is_vararg, self.source_name)
  fc.enter_scope()
  let mut i = 0
  while i < fb.params.length() {
    match fc.declare_local(fb.params[i], fb.line) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  match fc.compile_stmts(fb.body) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  fc.leave_scope(fb.line)
  if fc.pending_gotos.length() > 0 {
    let g = fc.pending_gotos[0]
    return Err(LuaError::new(LuaErrorKind::SyntaxError, "no visible label '" + g.name + "' for <goto>", g.line))
  }
  let _ = fc.emit(enc_abc(OP_RETURN, 0, 1, 0), fb.line)
  Ok(
    Proto::{
      code: fc.code,
      lines: fc.lines,
      consts: fc.consts,
      protos: fc.protos,
      upvals: fc.upvals,
      num_params: fc.num_params,
      is_vararg: fc.is_vararg,
      max_stack: fc.max_stack,
      source_name: fc.source_name,
    },
  )
}

///| Check whether remaining statements after index `idx` are only labels/empty statements (Lua 5.4 end-of-block rule).
fn is_block_tail_labels(stmts : Array[Stmt], start_idx : Int) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    match stmts[i] {
      Stmt::Empty | Stmt::Label(_, _) => ()
      _ => return false
    }
    i = i + 1
  }
  true
}

///|
fn FuncCompiler::compile_stmts(self : FuncCompiler, stmts : Array[Stmt]) -> Result[Unit, LuaError] {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      Stmt::Label(name, line) => {
        // Check for duplicate label in the same block/scope
        let mut li = self.labels.length() - 1
        while li >= 0 && self.labels[li].depth == self.scope_depth {
          if self.labels[li].name == name {
            return Err(LuaError::new(LuaErrorKind::SyntaxError, "label '" + name + "' already defined", line))
          }
          li = li - 1
        }
        let lbl = LabelDesc::{
          name: name,
          pc: self.code.length(),
          depth: self.scope_depth,
          num_locals: self.locals.length(),
          line: line,
        }
        self.labels.push(lbl)
        let is_eob = is_block_tail_labels(stmts, i + 1)
        // Resolve matching pending gotos at current scope depth
        let mut gi = 0
        while gi < self.pending_gotos.length() {
          let g = self.pending_gotos[gi]
          if g.name == name && g.depth == self.scope_depth {
            match self.resolve_goto_to_label(g, lbl, is_eob) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            // Swap-remove resolved goto
            let last = self.pending_gotos.length() - 1
            self.pending_gotos[gi] = self.pending_gotos[last]
            let _ = self.pending_gotos.pop()
          } else {
            gi = gi + 1
          }
        }
      }
      _ => {
        match self.compile_stmt(stmts[i]) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
    }
    i = i + 1
  }
  Ok(())
}

///| Compile a list of RHS expressions into contiguous registers `base .. base+count-1`.
fn FuncCompiler::compile_rhs_list(
  self : FuncCompiler,
  exprs : Array[Expr],
  base : Int,
  count : Int,
  line : Int,
) -> Result[Unit, LuaError] {
  let n = exprs.length()
  let mut i = 0
  while i < n {
    let reg = base + i
    self.reserve_reg(reg)
    if self.free_reg <= reg {
      self.free_reg = reg + 1
    }
    if i == n - 1 && is_multiret_expr(exprs[i]) && count > i {
      let want = count - i
      match self.compile_expr_inner(exprs[i], reg, want) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      return Ok(())
    } else if i < count {
      match self.compile_expr_to(exprs[i], reg) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      // Extra RHS expression evaluated for side effects
      let tmp = self.alloc_reg()
      match self.compile_expr_to(exprs[i], tmp) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    i = i + 1
  }
  if n < count {
    let _ = self.emit(enc_abc(OP_LOADNIL, base + n, count - n - 1, 0), line)
  }
  Ok(())
}

///|
fn FuncCompiler::compile_stmt(self : FuncCompiler, st : Stmt) -> Result[Unit, LuaError] {
  match st {
    Stmt::Empty => Ok(())
    Stmt::Block(body, line) => {
      self.enter_scope()
      match self.compile_stmts(body) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      self.leave_scope(line)
      Ok(())
    }
    Stmt::ExprCall(call_e, _line) => {
      let saved = self.free_reg
      let tmp = self.alloc_reg()
      match self.compile_expr_inner(call_e, tmp, 1) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      self.free_reg = saved
      Ok(())
    }
    Stmt::LocalDecl(names, init_exprs, line) => {
      let count = names.length()
      let base = self.free_reg
      let mut i = 0
      while i < count {
        self.reserve_reg(base + i)
        i = i + 1
      }
      // Evaluate RHS before declaring new local names (so `local x = x` sees outer `x`)
      self.free_reg = base + count
      match self.compile_rhs_list(init_exprs, base, count, line) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      self.free_reg = base
      i = 0
      while i < count {
        let (nm, attr) = names[i]
        let is_const = match attr {
          LocalAttrib::Const | LocalAttrib::Close => true
          LocalAttrib::None => false
        }
        let is_close = match attr {
          LocalAttrib::Close => true
          _ => false
        }
        let reg = match self.declare_local_attr(nm, is_const, is_close, line) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if is_close {
          let _ = self.emit(enc_abc(OP_TBC, reg, 0, 0), line)
        }
        i = i + 1
      }
      Ok(())
    }
    Stmt::LocalFunc(name, fb, line) => {
      // Declare local BEFORE compiling body so recursive `local function f()` captures itself!
      let reg = match self.declare_local(name, line) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      let child_proto = match self.compile_func_body(fb) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      let p_idx = self.protos.length()
      self.protos.push(child_proto)
      let _ = self.emit(enc_abc(OP_CLOSURE, reg, p_idx, 0), fb.line)
      Ok(())
    }
    Stmt::Assign(lhs, rhs, line) => {
      let saved = self.free_reg
      let n = lhs.length()
      // Evaluate any table/index subexpressions of LHS first, then RHS into temp regs, then assign right-to-left
      let obj_regs : Array[Int] = []
      let key_regs : Array[Int] = []
      let mut i = 0
      while i < n {
        match lhs[i] {
          Expr::Index(obj, idx, _) => {
            let oreg = self.alloc_reg()
            match self.compile_expr_to(obj, oreg) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            let kreg = self.alloc_reg()
            match self.compile_expr_to(idx, kreg) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            obj_regs.push(oreg)
            key_regs.push(kreg)
          }
          Expr::Field(obj, _, _) => {
            let oreg = self.alloc_reg()
            match self.compile_expr_to(obj, oreg) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            obj_regs.push(oreg)
            key_regs.push(-1)
          }
          _ => {
            obj_regs.push(-1)
            key_regs.push(-1)
          }
        }
        i = i + 1
      }
      let rhs_base = self.free_reg
      self.free_reg = rhs_base + n
      self.reserve_reg(rhs_base + n - 1)
      match self.compile_rhs_list(rhs, rhs_base, n, line) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      // Perform assignments
      i = n - 1
      while i >= 0 {
        let vreg = rhs_base + i
        match lhs[i] {
          Expr::Ident(name, l) => {
            let lidx = self.resolve_local_idx(name)
            if lidx >= 0 {
              if self.locals[lidx].is_const {
                return Err(LuaError::new(LuaErrorKind::SyntaxError, "attempt to assign to const variable '" + name + "'", l))
              }
              let lreg = self.locals[lidx].reg
              if lreg != vreg {
                let _ = self.emit(enc_abc(OP_MOVE, lreg, vreg, 0), l)
              }
            } else {
              let uv = match self.resolve_upval(name, l) {
                Ok(u) => u
                Err(e) => return Err(e)
              }
              if uv >= 0 {
                if uv < self.upval_const.length() && self.upval_const[uv] {
                  return Err(LuaError::new(LuaErrorKind::SyntaxError, "attempt to assign to const variable '" + name + "'", l))
                }
                let _ = self.emit(enc_abc(OP_SETUPVAL, vreg, uv, 0), l)
              } else {
                // P1-3: resolve `_ENV` lexically
                let env_reg = self.resolve_local("_ENV")
                if env_reg >= 0 {
                  self.emit_setfield(env_reg, name, vreg, l)
                } else {
                  let env_uv = match self.resolve_upval("_ENV", l) {
                    Ok(u) => u
                    Err(e) => return Err(e)
                  }
                  self.emit_settabup(env_uv, name, vreg, l)
                }
              }
            }
          }
          Expr::Field(_, field, l) => {
            self.emit_setfield(obj_regs[i], field, vreg, l)
          }
          Expr::Index(_, _, l) => {
            let _ = self.emit(enc_abc(OP_SETTABLE, obj_regs[i], key_regs[i], vreg), l)
          }
          _ => ()
        }
        i = i - 1
      }
      self.free_reg = saved
      Ok(())
    }
    Stmt::If(branches, else_body, line) => {
      let end_jumps : Array[Int] = []
      let mut i = 0
      while i < branches.length() {
        let br = branches[i]
        let saved = self.free_reg
        let creg = self.alloc_reg()
        match self.compile_expr_to(br.cond, creg) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let _ = self.emit(enc_abc(OP_TEST, creg, 0, 1), br.line)
        let false_jmp = self.emit_jmp(0, br.line)
        self.free_reg = saved

        self.enter_scope()
        match self.compile_stmts(br.body) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        self.leave_scope(br.line)

        if i + 1 < branches.length() || else_body.is_some() {
          end_jumps.push(self.emit_jmp(0, br.line))
        }
        self.patch_jmp(false_jmp, self.code.length())
        i = i + 1
      }
      match else_body {
        Some(eb) => {
          self.enter_scope()
          match self.compile_stmts(eb) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          self.leave_scope(line)
        }
        None => ()
      }
      let end_pc = self.code.length()
      i = 0
      while i < end_jumps.length() {
        self.patch_jmp(end_jumps[i], end_pc)
        i = i + 1
      }
      Ok(())
    }
    Stmt::While(cond, body, line) => {
      let loop_start = self.code.length()
      let saved = self.free_reg
      let creg = self.alloc_reg()
      match self.compile_expr_to(cond, creg) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let _ = self.emit(enc_abc(OP_TEST, creg, 0, 1), line)
      let exit_jmp = self.emit_jmp(0, line)
      self.free_reg = saved

      self.enter_scope()
      self.loops.push(LoopCtx::{ depth: self.scope_depth, base_reg: self.free_reg, break_jumps: [] })
      match self.compile_stmts(body) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let lctx = match self.loops.pop() {
        Some(lc) => lc
        None => LoopCtx::{ depth: 0, base_reg: 0, break_jumps: [] }
      }
      self.leave_scope(line)

      let back_jmp = self.emit_jmp(0, line)
      self.patch_jmp(back_jmp, loop_start)
      let after_pc = self.code.length()
      self.patch_jmp(exit_jmp, after_pc)
      let mut j = 0
      while j < lctx.break_jumps.length() {
        self.patch_jmp(lctx.break_jumps[j], after_pc)
        j = j + 1
      }
      Ok(())
    }
    Stmt::Repeat(body, cond, line) => {
      let loop_start = self.code.length()
      self.enter_scope()
      self.loops.push(LoopCtx::{ depth: self.scope_depth, base_reg: self.free_reg, break_jumps: [] })
      match self.compile_stmts(body) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let lctx = match self.loops.pop() {
        Some(lc) => lc
        None => LoopCtx::{ depth: 0, base_reg: 0, break_jumps: [] }
      }
      // `until` condition sees locals declared inside `repeat`!
      let saved = self.free_reg
      let creg = self.alloc_reg()
      match self.compile_expr_to(cond, creg) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      self.free_reg = saved
      // Check if any locals in repeat scope were captured
      let mut close_reg = -1
      let mut li = self.locals.length() - 1
      while li >= 0 && self.locals[li].depth == self.scope_depth {
        if self.locals[li].is_captured || self.locals[li].is_close {
          close_reg = self.locals[li].reg
        }
        li = li - 1
      }
      let _ = self.emit(enc_abc(OP_TEST, creg, 0, 1), line)
      let back_jmp = self.emit_jmp(if close_reg >= 0 { close_reg + 1 } else { 0 }, line)
      self.patch_jmp(back_jmp, loop_start)
      self.leave_scope(line)
      let after_pc = self.code.length()
      let mut j = 0
      while j < lctx.break_jumps.length() {
        self.patch_jmp(lctx.break_jumps[j], after_pc)
        j = j + 1
      }
      Ok(())
    }
    Stmt::ForNum(var_name, init_e, limit_e, step_opt, body, line) => {
      self.enter_scope()
      let base = self.free_reg
      let r_idx = match self.declare_local("(for index)", line) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      let r_lim = match self.declare_local("(for limit)", line) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      let r_stp = match self.declare_local("(for step)", line) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      match self.compile_expr_to(init_e, r_idx) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match self.compile_expr_to(limit_e, r_lim) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match step_opt {
        Some(se) => {
          match self.compile_expr_to(se, r_stp) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        None => {
          let _ = self.emit(enc_asbx(OP_LOADI, r_stp, 1), line)
        }
      }
      let prep_pc = self.emit(enc_asbx(OP_FORPREP, base, 0), line)

      self.enter_scope()
      match self.declare_local(var_name, line) { // base + 3
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      self.loops.push(LoopCtx::{ depth: self.scope_depth, base_reg: base + 3, break_jumps: [] })
      match self.compile_stmts(body) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let lctx = match self.loops.pop() {
        Some(lc) => lc
        None => LoopCtx::{ depth: 0, base_reg: 0, break_jumps: [] }
      }
      self.leave_scope(line)

      let loop_pc = self.code.length()
      self.patch_jmp(prep_pc, loop_pc)
      let _ = self.emit(enc_asbx(OP_FORLOOP, base, prep_pc + 1 - (loop_pc + 1)), line)
      let after_pc = self.code.length()
      let mut j = 0
      while j < lctx.break_jumps.length() {
        self.patch_jmp(lctx.break_jumps[j], after_pc)
        j = j + 1
      }
      self.leave_scope(line)
      Ok(())
    }
    Stmt::ForGen(names, iters, body, line) => {
      self.enter_scope()
      let base = self.free_reg
      match self.declare_local("(for generator)", line) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match self.declare_local("(for state)", line) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match self.declare_local("(for control)", line) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match self.compile_rhs_list(iters, base, 3, line) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let prep_jmp = self.emit_jmp(0, line)
      let body_start = self.code.length()

      self.enter_scope()
      let mut i = 0
      while i < names.length() {
        match self.declare_local(names[i], line) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      self.loops.push(LoopCtx::{ depth: self.scope_depth, base_reg: base + 3, break_jumps: [] })
      match self.compile_stmts(body) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let lctx = match self.loops.pop() {
        Some(lc) => lc
        None => LoopCtx::{ depth: 0, base_reg: 0, break_jumps: [] }
      }
      self.leave_scope(line)

      let call_pc = self.code.length()
      self.patch_jmp(prep_jmp, call_pc)
      let _ = self.emit(enc_abc(OP_TFORCALL, base, 0, names.length()), line)
      let tloop_pc = self.code.length()
      let _ = self.emit(enc_asbx(OP_TFORLOOP, base, body_start - (tloop_pc + 1)), line)
      let after_pc = self.code.length()
      let mut j = 0
      while j < lctx.break_jumps.length() {
        self.patch_jmp(lctx.break_jumps[j], after_pc)
        j = j + 1
      }
      self.leave_scope(line)
      Ok(())
    }
    Stmt::Break(line) => {
      if self.loops.length() == 0 {
        return Err(LuaError::new(LuaErrorKind::SyntaxError, "no loop to break", line))
      }
      let lctx = self.loops[self.loops.length() - 1]
      // Close any captured or <close> locals at or above loop depth
      let mut close_a = 0
      let mut li = self.locals.length() - 1
      while li >= 0 && self.locals[li].depth >= lctx.depth {
        if self.locals[li].is_captured || self.locals[li].is_close {
          close_a = self.locals[li].reg + 1
        }
        li = li - 1
      }
      let jmp = self.emit_jmp(close_a, line)
      lctx.break_jumps.push(jmp)
      Ok(())
    }
    Stmt::Label(_, _) => Ok(())
    Stmt::Goto(name, line) => {
      // Search backward in visible labels first (innermost scope first)
      let mut li = self.labels.length() - 1
      while li >= 0 {
        let lbl = self.labels[li]
        if lbl.name == name {
          // Check if any locals between lbl.num_locals and current locals need closing
          let mut close_a = 0
          let mut k = self.locals.length() - 1
          while k >= lbl.num_locals {
            if self.locals[k].is_captured || self.locals[k].is_close {
              close_a = self.locals[k].reg + 1
            }
            k = k - 1
          }
          let jmp = self.emit_jmp(close_a, line)
          self.patch_jmp(jmp, lbl.pc)
          return Ok(())
        }
        li = li - 1
      }
      // Forward goto: emit placeholder jump and record as pending
      let jmp = self.emit_jmp(0, line)
      self.pending_gotos.push(
        GotoDesc::{
          name: name,
          jmp_pc: jmp,
          depth: self.scope_depth,
          num_locals: self.locals.length(),
          close_reg: -1,
          line: line,
        },
      )
      Ok(())
    }
    Stmt::Return(exprs, line) => {
      let n = exprs.length()
      if n == 0 {
        let _ = self.emit(enc_abc(OP_RETURN, 0, 1, 0), line)
        return Ok(())
      }
      // Tail-call optimization: `return f(...)` or `return obj:m(...)` (not parenthesized!)
      if n == 1 {
        match exprs[0] {
          Expr::Call(callee, args, cl) => {
            let base = self.free_reg
            self.reserve_reg(base)
            match self.compile_expr_to(callee, base) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            let nargs = args.length()
            let mut last_multi = false
            let mut i = 0
            while i < nargs {
              let ar = base + 1 + i
              self.reserve_reg(ar)
              self.free_reg = ar + 1
              if i == nargs - 1 && is_multiret_expr(args[i]) {
                match self.compile_expr_inner(args[i], ar, 0) {
                  Ok(_) => ()
                  Err(e) => return Err(e)
                }
                last_multi = true
              } else {
                match self.compile_expr_to(args[i], ar) {
                  Ok(_) => ()
                  Err(e) => return Err(e)
                }
              }
              i = i + 1
            }
            let b = if last_multi { 0 } else { nargs + 1 }
            let _ = self.emit(enc_abc(OP_TAILCALL, base, b, 0), cl)
            let _ = self.emit(enc_abc(OP_RETURN, base, 0, 0), cl)
            self.free_reg = base
            return Ok(())
          }
          Expr::MethodCall(obj, method_name, args, cl) => {
            let base = self.free_reg
            self.reserve_reg(base + 1)
            self.free_reg = base + 2
            let obj_tmp = self.alloc_reg()
            match self.compile_expr_to(obj, obj_tmp) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            self.emit_self(base, obj_tmp, method_name, cl)
            let nargs = args.length()
            let mut last_multi = false
            let mut i = 0
            while i < nargs {
              let ar = base + 2 + i
              self.reserve_reg(ar)
              self.free_reg = ar + 1
              if i == nargs - 1 && is_multiret_expr(args[i]) {
                match self.compile_expr_inner(args[i], ar, 0) {
                  Ok(_) => ()
                  Err(e) => return Err(e)
                }
                last_multi = true
              } else {
                match self.compile_expr_to(args[i], ar) {
                  Ok(_) => ()
                  Err(e) => return Err(e)
                }
              }
              i = i + 1
            }
            let b = if last_multi { 0 } else { nargs + 2 }
            let _ = self.emit(enc_abc(OP_TAILCALL, base, b, 0), cl)
            let _ = self.emit(enc_abc(OP_RETURN, base, 0, 0), cl)
            self.free_reg = base
            return Ok(())
          }
          _ => ()
        }
      }
      let base = self.free_reg
      let mut last_multi = false
      let mut i = 0
      while i < n {
        let r = base + i
        self.reserve_reg(r)
        self.free_reg = r + 1
        if i == n - 1 && is_multiret_expr(exprs[i]) {
          match self.compile_expr_inner(exprs[i], r, 0) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          last_multi = true
        } else {
          match self.compile_expr_to(exprs[i], r) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        i = i + 1
      }
      let b = if last_multi { 0 } else { n + 1 }
      let _ = self.emit(enc_abc(OP_RETURN, base, b, 0), line)
      self.free_reg = base
      Ok(())
    }
  }
}

///| Compile Lua 5.4 source code into a top-level `Proto`.
fn compile_lua_proto(source : String, max_depth : Int) -> Result[Proto, LuaError] {
  compile_lua_proto_named(source, "[string]", max_depth, true)
}

///| Compile Lua 5.4 source code with explicit chunk name and shebang mode.
fn compile_lua_proto_named(
  source : String,
  source_name : String,
  max_depth : Int,
  allow_shebang : Bool,
) -> Result[Proto, LuaError] {
  let stmts = match parse_lua(source, max_depth, allow_shebang) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let fc = FuncCompiler::new(None, 0, true, source_name)
  // Top-level chunk has `_ENV` at upvalue 0
  let _ = fc.add_upval("_ENV", false, 0, false, 0)
  fc.enter_scope()
  match fc.compile_stmts(stmts) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  fc.leave_scope(0)
  if fc.pending_gotos.length() > 0 {
    let g = fc.pending_gotos[0]
    return Err(LuaError::new(LuaErrorKind::SyntaxError, "no visible label '" + g.name + "' for <goto>", g.line))
  }
  let _ = fc.emit(enc_abc(OP_RETURN, 0, 1, 0), 0)
  Ok(
    Proto::{
      code: fc.code,
      lines: fc.lines,
      consts: fc.consts,
      protos: fc.protos,
      upvals: fc.upvals,
      num_params: 0,
      is_vararg: true,
      max_stack: fc.max_stack,
      source_name: source_name,
    },
  )
}
