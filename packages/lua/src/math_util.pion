///| Pure-Pion IEEE 754 math, Lua 5.4 integer/float arithmetic, number parsing, and formatting.

///| Convert a Pion `String` into raw UTF-8 `Bytes`.
fn string_to_bytes(s : String) -> Bytes {
  let n = s.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  out
}

///| Convert `Array[Byte]` to `Bytes`.
fn bytes_from_array(arr : Array[Byte]) -> Bytes {
  let n = arr.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = arr[i]
    i = i + 1
  }
  out
}

///| Decode `Bytes` to a Pion `String` (Lua strings may contain arbitrary bytes; we write bytes directly).
fn utf8_bytes_to_string(bs : Bytes) -> Option[String] {
  let n = bs.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_byte(bs[i])
    i = i + 1
  }
  Some(sb.to_string())
}

///|
fn f64_is_nan(x : Double) -> Bool {
  x != x
}

///|
fn f64_is_finite(x : Double) -> Bool {
  x == x && x != 1.0 / 0.0 && x != -1.0 / 0.0
}

///| Exact IEEE-754 `abs(x)` clearing the sign bit (P2-7: `math.abs(-0.0) == 0.0`).
fn f64_abs(x : Double) -> Double {
  Double::from_bits(x.to_bits() & 0x7FFFFFFFFFFFFFFFL)
}

///|
fn f64_trunc(x : Double) -> Double {
  if !f64_is_finite(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  x.to_int64().to_double()
}

///|
fn f64_floor(x : Double) -> Double {
  if !f64_is_finite(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  let t = x.to_int64().to_double()
  if t > x {
    t - 1.0
  } else {
    t
  }
}

///|
fn f64_ceil(x : Double) -> Double {
  if !f64_is_finite(x) {
    return x
  }
  if x >= 4503599627370496.0 || x <= -4503599627370496.0 {
    return x
  }
  let t = x.to_int64().to_double()
  if t < x {
    t + 1.0
  } else {
    t
  }
}

///|
fn f64_sqrt(x : Double) -> Double {
  if x != x || x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 || x == 1.0 / 0.0 {
    return x
  }
  let mut m = x
  let mut scale = 1.0
  while m >= 2.0 {
    m = m * 0.25
    scale = scale * 2.0
  }
  while m < 0.5 {
    m = m * 4.0
    scale = scale * 0.5
  }
  let mut g = 0.5 * (m + 1.0)
  let mut i = 0
  while i < 8 {
    g = 0.5 * (g + m / g)
    i = i + 1
  }
  g * scale
}

///|
fn f64_ln(x : Double) -> Double {
  if x != x || x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return -1.0 / 0.0
  }
  if x == 1.0 / 0.0 {
    return 1.0 / 0.0
  }
  let ln2 = 0.693147180559945309417232121458176568
  let mut m = x
  let mut k = 0
  while m >= 1.4142135623730951 {
    m = m * 0.5
    k = k + 1
  }
  while m < 0.7071067811865476 {
    m = m * 2.0
    k = k - 1
  }
  let t = (m - 1.0) / (m + 1.0)
  let t2 = t * t
  let mut term = t
  let mut sum = t
  let mut n = 3
  while n <= 31 {
    term = term * t2
    sum = sum + term / n.to_double()
    n = n + 2
  }
  2.0 * sum + k.to_double() * ln2
}

///|
fn f64_exp(x : Double) -> Double {
  if x != x {
    return x
  }
  if x > 709.782712893384 {
    return 1.0 / 0.0
  }
  if x < -745.1332191019412 {
    return 0.0
  }
  let ln2 = 0.693147180559945309417232121458176568
  let ln2_hi = 0.693147180369123816490
  let ln2_lo = 1.90821492927058770002e-10
  let kf = f64_floor(x / ln2 + 0.5)
  let k = kf.to_int64().to_int()
  let r = (x - kf * ln2_hi) - kf * ln2_lo
  let mut term = 1.0
  let mut sum = 1.0
  let mut i = 1
  while i <= 25 {
    term = term * r / i.to_double()
    sum = sum + term
    i = i + 1
  }
  let mut res = sum
  if k > 0 {
    let mut rem = k
    while rem > 0 {
      res = res * 2.0
      rem = rem - 1
    }
  } else if k < 0 {
    let mut rem = -k
    while rem > 0 {
      res = res * 0.5
      rem = rem - 1
    }
  }
  res
}

///|
fn f64_pow(x : Double, y : Double) -> Double {
  if y == 0.0 {
    return 1.0
  }
  if x == 1.0 {
    return 1.0
  }
  if x != x || y != y {
    return 0.0 / 0.0
  }
  if f64_is_finite(y) && y == f64_trunc(y) && y >= -1074.0 && y <= 1074.0 {
    let mut exp_i = y.to_int64().to_int()
    let neg_exp = exp_i < 0
    if neg_exp {
      exp_i = -exp_i
    }
    let mut base = x
    let mut acc = 1.0
    while exp_i > 0 {
      if (exp_i & 1) != 0 {
        acc = acc * base
      }
      exp_i = exp_i >> 1
      if exp_i > 0 {
        base = base * base
      }
    }
    return if neg_exp { 1.0 / acc } else { acc }
  }
  if x < 0.0 {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return if y > 0.0 { 0.0 } else { 1.0 / 0.0 }
  }
  f64_exp(y * f64_ln(x))
}

///| Kernel sin(r) on [0, pi/2].
fn f64_sin_kernel(r : Double) -> Double {
  let r2 = r * r
  let mut term = r
  let mut sum = r
  let mut k = 1
  while k <= 14 {
    term = -term * r2 / ((2 * k) * (2 * k + 1)).to_double()
    sum = sum + term
    k = k + 1
  }
  sum
}

///| Kernel cos(r) on [0, pi/2].
fn f64_cos_kernel(r : Double) -> Double {
  let r2 = r * r
  let mut term = 1.0
  let mut sum = 1.0
  let mut k = 1
  while k <= 14 {
    term = -term * r2 / ((2 * k - 1) * (2 * k)).to_double()
    sum = sum + term
    k = k + 1
  }
  sum
}

///| High-precision `sin(x)` with Payne-Hanek range reduction (P1-16).
fn f64_sin(x : Double) -> Double {
  if !f64_is_finite(x) {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return x
  }
  let neg = x < 0.0
  let ax = f64_abs(x)
  let (q, r) = payne_hanek_reduce(ax)
  let v = if q == 0 {
    f64_sin_kernel(r)
  } else if q == 1 {
    f64_cos_kernel(r)
  } else if q == 2 {
    -f64_sin_kernel(r)
  } else {
    -f64_cos_kernel(r)
  }
  if neg { -v } else { v }
}

///| High-precision `cos(x)` with Payne-Hanek range reduction (P1-16).
fn f64_cos(x : Double) -> Double {
  if !f64_is_finite(x) {
    return 0.0 / 0.0
  }
  let ax = f64_abs(x)
  let (q, r) = payne_hanek_reduce(ax)
  if q == 0 {
    f64_cos_kernel(r)
  } else if q == 1 {
    -f64_sin_kernel(r)
  } else if q == 2 {
    -f64_cos_kernel(r)
  } else {
    f64_sin_kernel(r)
  }
}

///| High-precision `tan(x)` with Payne-Hanek range reduction (P1-17).
fn f64_tan(x : Double) -> Double {
  if !f64_is_finite(x) {
    return 0.0 / 0.0
  }
  if x == 0.0 {
    return x
  }
  f64_sin(x) / f64_cos(x)
}

///| High-precision `atan(x)` (P1-17).
fn f64_atan(x : Double) -> Double {
  if x != x {
    return x
  }
  let pi = 3.14159265358979323846264338327950288
  let pio2 = 1.57079632679489661923132169163975144
  if x == 1.0 / 0.0 {
    return pio2
  }
  if x == -1.0 / 0.0 {
    return -pio2
  }
  let neg = x < 0.0
  let mut ax = f64_abs(x)
  let mut invert = false
  if ax > 1.0 {
    ax = 1.0 / ax
    invert = true
  }
  // Range reduce further: if ax > tan(pi/12) ≈ 0.2679491924311227, use atan(x) = pi/6 + atan((sqrt3*x - 1)/(sqrt3 + x))
  let mut shift_pi6 = false
  let sqrt3 = 1.73205080756887729352744634150587237
  if ax > 0.2679491924311227 {
    ax = (sqrt3 * ax - 1.0) / (sqrt3 + ax)
    shift_pi6 = true
  }
  let x2 = ax * ax
  let mut term = ax
  let mut sum = ax
  let mut k = 1
  while k <= 20 {
    term = -term * x2
    sum = sum + term / (2 * k + 1).to_double()
    k = k + 1
  }
  let mut res = if shift_pi6 { pi / 6.0 + sum } else { sum }
  if invert {
    res = pio2 - res
  }
  if neg { -res } else { res }
}

///| High-precision `atan2(y, x)` (P1-17).
fn f64_atan2(y : Double, x : Double) -> Double {
  if y != y || x != x {
    return 0.0 / 0.0
  }
  let pi = 3.14159265358979323846264338327950288
  let pio2 = 1.57079632679489661923132169163975144
  if x > 0.0 {
    f64_atan(y / x)
  } else if x < 0.0 {
    if y >= 0.0 {
      f64_atan(y / x) + pi
    } else {
      f64_atan(y / x) - pi
    }
  } else {
    if y > 0.0 {
      pio2
    } else if y < 0.0 {
      -pio2
    } else {
      0.0
    }
  }
}

///| `asin(x)` (P1-17).
fn f64_asin(x : Double) -> Double {
  if x != x || x < -1.0 || x > 1.0 {
    return 0.0 / 0.0
  }
  f64_atan2(x, f64_sqrt(1.0 - x * x))
}

///| `acos(x)` (P1-17).
fn f64_acos(x : Double) -> Double {
  if x != x || x < -1.0 || x > 1.0 {
    return 0.0 / 0.0
  }
  f64_atan2(f64_sqrt(1.0 - x * x), x)
}

///| Exact IEEE-754 `fmod(x, y)` via bit-level binary long division (P1-8).
fn f64_fmod(x : Double, y : Double) -> Double {
  if !f64_is_finite(x) || y != y || y == 0.0 {
    return 0.0 / 0.0
  }
  if !f64_is_finite(y) {
    return x
  }
  let xbits = x.to_bits()
  let ybits = y.to_bits()
  let xsign = xbits & (-9223372036854775807L - 1L)
  let ax = xbits & 0x7FFFFFFFFFFFFFFFL
  let ay = ybits & 0x7FFFFFFFFFFFFFFFL
  if ax < ay {
    return x
  }
  if ax == ay {
    return Double::from_bits(xsign)
  }
  // Unpack x
  let mut ex = ((ax >> 52) & 0x7FFL).to_int()
  let mut mx : UInt64 = (ax & 0x000FFFFFFFFFFFFFL).reinterpret_as_uint64()
  if ex == 0 {
    ex = -1021
    while (mx & 0x0010000000000000UL) == 0UL {
      mx = mx << 1
      ex = ex - 1
    }
  } else {
    ex = ex - 1023
    mx = mx | 0x0010000000000000UL
  }
  // Unpack y
  let mut ey = ((ay >> 52) & 0x7FFL).to_int()
  let mut my : UInt64 = (ay & 0x000FFFFFFFFFFFFFL).reinterpret_as_uint64()
  if ey == 0 {
    ey = -1021
    while (my & 0x0010000000000000UL) == 0UL {
      my = my << 1
      ey = ey - 1
    }
  } else {
    ey = ey - 1023
    my = my | 0x0010000000000000UL
  }
  // Binary long division
  while ex > ey {
    if mx >= my {
      mx = mx - my
    }
    mx = mx << 1
    ex = ex - 1
  }
  if mx >= my {
    mx = mx - my
  }
  if mx == 0UL {
    return Double::from_bits(xsign)
  }
  // Re-normalize mx at exponent ey
  while (mx & 0x0010000000000000UL) == 0UL {
    mx = mx << 1
    ey = ey - 1
  }
  if ey <= -1023 {
    let shift = -1022 - ey
    mx = mx >> shift
    return Double::from_bits(xsign | mx.reinterpret_as_int64())
  }
  let biased = (ey + 1023).to_int64()
  let frac = (mx & 0x000FFFFFFFFFFFFFUL).reinterpret_as_int64()
  Double::from_bits(xsign | (biased << 52) | frac)
}

///| Lua 5.4 integer floor division `a // b` (caller ensures `b != 0`).
fn lua_idiv_i64(a : Int64, b : Int64) -> Int64 {
  let min_i64 = -9223372036854775807L - 1L
  if a == min_i64 && b == -1L {
    return min_i64
  }
  let q = a / b
  let r = a - q * b
  if r != 0L && ((a < 0L) != (b < 0L)) {
    q - 1L
  } else {
    q
  }
}

///| Lua 5.4 integer modulo `a % b` (caller ensures `b != 0`).
fn lua_mod_i64(a : Int64, b : Int64) -> Int64 {
  let min_i64 = -9223372036854775807L - 1L
  if a == min_i64 && b == -1L {
    return 0L
  }
  let r = a % b
  if r != 0L && ((r < 0L) != (b < 0L)) {
    r + b
  } else {
    r
  }
}

///| Exact Lua 5.4 float modulo using `f64_fmod` (P1-8).
fn lua_mod_f64(a : Double, b : Double) -> Double {
  if b == 0.0 || !f64_is_finite(a) || f64_is_nan(b) {
    return 0.0 / 0.0
  }
  let mut m = f64_fmod(a, b)
  if m > 0.0 {
    if b < 0.0 {
      m = m + b
    }
  } else if m < 0.0 {
    if b > 0.0 {
      m = m + b
    }
  }
  m
}

///| Lua 5.4 left shift `a << b` (negative shifts right logically; |b| >= 64 gives 0, P0-1).
fn lua_shl_i64(a : Int64, b : Int64) -> Int64 {
  if b <= -64L || b >= 64L {
    return 0L
  }
  if b < 0L {
    return lua_shr_i64(a, -b)
  }
  let s = b.to_int()
  (a.reinterpret_as_uint64() << s).reinterpret_as_int64()
}

///| Lua 5.4 logical right shift `a >> b` (negative shifts left; |b| >= 64 gives 0, P0-1).
fn lua_shr_i64(a : Int64, b : Int64) -> Int64 {
  if b <= -64L || b >= 64L {
    return 0L
  }
  if b < 0L {
    return lua_shl_i64(a, -b)
  }
  let s = b.to_int()
  (a.reinterpret_as_uint64() >> s).reinterpret_as_int64()
}

///| Convert a `Double` to `Int64` only if it is an exact integer within `Int64` range.
fn f64_to_exact_i64(x : Double) -> Option[Int64] {
  if !f64_is_finite(x) {
    return None
  }
  if x < -9223372036854775808.0 || x >= 9223372036854775808.0 {
    return None
  }
  let t = f64_trunc(x)
  if t != x {
    return None
  }
  let n = t.to_int64()
  if n.to_double() == x {
    Some(n)
  } else {
    None
  }
}

///|
fn is_ascii_space(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12
}

///|
fn hex_digit_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

///|
fn base_digit_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 90 {
    b - 55
  } else if b >= 97 && b <= 122 {
    b - 87
  } else {
    -1
  }
}

///| Parse a Lua 5.4 numeral string (decimal int/float, hex int/float) into `LuaValue::Int` or `LuaValue::Float`.
fn lua_parse_number(s : String) -> Option[LuaValue] {
  let bs = string_to_bytes(s)
  let n = bs.length()
  let mut i = 0
  while i < n && is_ascii_space(bs[i].to_int()) {
    i = i + 1
  }
  let mut end = n
  while end > i && is_ascii_space(bs[end - 1].to_int()) {
    end = end - 1
  }
  if i >= end {
    return None
  }
  let mut neg = false
  let first = bs[i].to_int()
  if first == 45 {
    neg = true
    i = i + 1
  } else if first == 43 {
    i = i + 1
  }
  if i >= end {
    return None
  }

  // Hexadecimal integer or hex float (0x / 0X)
  if i + 1 < end && bs[i].to_int() == 48 && (bs[i + 1].to_int() == 120 || bs[i + 1].to_int() == 88) {
    i = i + 2
    let mut is_float = false
    let mut j = i
    while j < end {
      let c = bs[j].to_int()
      if c == 46 || c == 112 || c == 80 {
        is_float = true
        break
      }
      j = j + 1
    }
    if !is_float {
      if i >= end {
        return None
      }
      let mut acc : UInt64 = 0UL
      while i < end {
        let d = hex_digit_val(bs[i].to_int())
        if d < 0 {
          return None
        }
        acc = (acc << 4) | d.to_int64().reinterpret_as_uint64()
        i = i + 1
      }
      let signed = acc.reinterpret_as_int64()
      return Some(LuaValue::Int(if neg { 0L - signed } else { signed }))
    }
    // Hex float: 0x[hex][.hex][p[+-]dec]
    let mut mant = 0.0
    let mut has_digits = false
    while i < end {
      let d = hex_digit_val(bs[i].to_int())
      if d < 0 {
        break
      }
      has_digits = true
      mant = mant * 16.0 + d.to_double()
      i = i + 1
    }
    if i < end && bs[i].to_int() == 46 {
      i = i + 1
      let mut frac_scale = 1.0 / 16.0
      while i < end {
        let d = hex_digit_val(bs[i].to_int())
        if d < 0 {
          break
        }
        has_digits = true
        mant = mant + d.to_double() * frac_scale
        frac_scale = frac_scale / 16.0
        i = i + 1
      }
    }
    if !has_digits {
      return None
    }
    let mut exp2 = 0
    if i < end && (bs[i].to_int() == 112 || bs[i].to_int() == 80) {
      i = i + 1
      let mut eneg = false
      if i < end && bs[i].to_int() == 45 {
        eneg = true
        i = i + 1
      } else if i < end && bs[i].to_int() == 43 {
        i = i + 1
      }
      if i >= end {
        return None
      }
      let mut has_exp = false
      while i < end {
        let c = bs[i].to_int()
        if c < 48 || c > 57 {
          return None
        }
        has_exp = true
        if exp2 < 100000 {
          exp2 = exp2 * 10 + (c - 48)
        }
        i = i + 1
      }
      if !has_exp {
        return None
      }
      if eneg {
        exp2 = -exp2
      }
    }
    if i != end {
      return None
    }
    let mut res = mant
    if exp2 > 0 {
      let mut k = exp2
      while k > 0 {
        res = res * 2.0
        k = k - 1
      }
    } else if exp2 < 0 {
      let mut k = -exp2
      while k > 0 {
        res = res * 0.5
        k = k - 1
      }
    }
    return Some(LuaValue::Float(if neg { -res } else { res }))
  }

  // Decimal integer or float
  let mut is_float = false
  let mut j = i
  while j < end {
    let c = bs[j].to_int()
    if c == 46 || c == 101 || c == 69 {
      is_float = true
      break
    }
    j = j + 1
  }

  if !is_float {
    let mut acc : UInt64 = 0UL
    let max_pos : UInt64 = 9223372036854775807UL
    let max_neg : UInt64 = 9223372036854775808UL
    let limit = if neg { max_neg } else { max_pos }
    let mut overflow = false
    let mut k = i
    while k < end {
      let c = bs[k].to_int()
      if c < 48 || c > 57 {
        return None
      }
      let d = (c - 48).to_int64().reinterpret_as_uint64()
      if acc > (limit - d) / 10UL {
        overflow = true
        break
      }
      acc = acc * 10UL + d
      k = k + 1
    }
    if !overflow {
      let signed = if neg {
        if acc == max_neg {
          -9223372036854775807L - 1L
        } else {
          0L - acc.reinterpret_as_int64()
        }
      } else {
        acc.reinterpret_as_int64()
      }
      return Some(LuaValue::Int(signed))
    }
  }

  // Decimal float (0-ULP correctly rounded via BigUInt, P1-2)
  let digits : Array[Int] = []
  let mut has_digits = false
  let mut frac_digits = 0
  while i < end {
    let c = bs[i].to_int()
    if c < 48 || c > 57 {
      break
    }
    has_digits = true
    let d = c - 48
    if d != 0 || digits.length() > 0 {
      digits.push(d)
    }
    i = i + 1
  }
  if i < end && bs[i].to_int() == 46 {
    i = i + 1
    while i < end {
      let c = bs[i].to_int()
      if c < 48 || c > 57 {
        break
      }
      has_digits = true
      let d = c - 48
      if d != 0 || digits.length() > 0 {
        digits.push(d)
      }
      frac_digits = frac_digits + 1
      i = i + 1
    }
  }
  if !has_digits {
    return None
  }
  // Trim trailing zeros from digits while adjusting exp10
  let mut exp10 = -frac_digits
  while digits.length() > 0 && digits[digits.length() - 1] == 0 {
    let _ = digits.pop()
    exp10 = exp10 + 1
  }
  if i < end && (bs[i].to_int() == 101 || bs[i].to_int() == 69) {
    i = i + 1
    let mut eneg = false
    if i < end && bs[i].to_int() == 45 {
      eneg = true
      i = i + 1
    } else if i < end && bs[i].to_int() == 43 {
      i = i + 1
    }
    if i >= end {
      return None
    }
    let mut e = 0
    while i < end {
      let c = bs[i].to_int()
      if c < 48 || c > 57 {
        return None
      }
      if e < 100000 {
        e = e * 10 + (c - 48)
      }
      i = i + 1
    }
    if eneg {
      exp10 = exp10 - e
    } else {
      exp10 = exp10 + e
    }
  }
  if i != end {
    return None
  }
  Some(LuaValue::Float(decimal_digits_to_f64(digits, exp10, neg)))
}

///| Parse integer string in base 2..36 (for `tonumber(s, base)`).
fn lua_parse_int_base(s : String, base : Int) -> Option[Int64] {
  if base < 2 || base > 36 {
    return None
  }
  let bs = string_to_bytes(s)
  let n = bs.length()
  let mut i = 0
  while i < n && is_ascii_space(bs[i].to_int()) {
    i = i + 1
  }
  let mut end = n
  while end > i && is_ascii_space(bs[end - 1].to_int()) {
    end = end - 1
  }
  if i >= end {
    return None
  }
  let mut neg = false
  if bs[i].to_int() == 45 {
    neg = true
    i = i + 1
  } else if bs[i].to_int() == 43 {
    i = i + 1
  }
  if i >= end {
    return None
  }
  let mut acc : UInt64 = 0UL
  let b64 = base.to_int64().reinterpret_as_uint64()
  while i < end {
    let d = base_digit_val(bs[i].to_int())
    if d < 0 || d >= base {
      return None
    }
    acc = acc * b64 + d.to_int64().reinterpret_as_uint64()
    i = i + 1
  }
  let signed = acc.reinterpret_as_int64()
  Some(if neg { 0L - signed } else { signed })
}

///| Format a `Double` following Lua 5.4 `tostring` conventions (`"%.14g"` + `.0`, P1-1).
fn lua_float_to_string(f : Double) -> String {
  if f != f {
    return "nan"
  }
  if f == 1.0 / 0.0 {
    return "inf"
  }
  if f == -1.0 / 0.0 {
    return "-inf"
  }
  let (neg, body) = format_f64_general(f, 14, false, false)
  let s = if neg { "-" + body } else { body }
  // Lua 5.4 appends ".0" to integer-looking floats if no '.' or 'e'/'E' present
  let mut has_dot_or_exp = false
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c == 46 || c == 101 || c == 69 {
      has_dot_or_exp = true
      break
    }
    i = i + 1
  }
  if has_dot_or_exp {
    s
  } else {
    s + ".0"
  }
}

///| Default string formatting of a `LuaValue` (without metamethod dispatch).
fn lua_value_to_string_raw(v : LuaValue) -> String {
  match v {
    LuaValue::Nil => "nil"
    LuaValue::Bool(b) => if b { "true" } else { "false" }
    LuaValue::Int(n) => n.to_string()
    LuaValue::Float(f) => lua_float_to_string(f)
    LuaValue::Str(s) => s
    LuaValue::Table(id) => "table: 0x" + id.to_string()
    LuaValue::Closure(id) => "function: 0x" + id.to_string()
    LuaValue::NativeFn(id) => "function: builtin#" + id.to_string()
    LuaValue::Thread(id) => "thread: 0x" + id.to_string()
  }
}
