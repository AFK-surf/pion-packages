///| Recursive-descent + Pratt parser for Lua 5.4.

///|
struct Parser {
  tokens : Array[Token]
  mut pos : Int
  mut depth : Int
  max_depth : Int
}

///|
fn Parser::new(tokens : Array[Token], max_depth : Int) -> Parser {
  Parser::{ tokens: tokens, pos: 0, depth: 0, max_depth: max_depth }
}

///|
fn Parser::peek(self : Parser) -> Token {
  if self.pos < self.tokens.length() {
    self.tokens[self.pos]
  } else {
    self.tokens[self.tokens.length() - 1]
  }
}

///|
fn Parser::peek_at(self : Parser, offset : Int) -> Token {
  let idx = self.pos + offset
  if idx < self.tokens.length() {
    self.tokens[idx]
  } else {
    self.tokens[self.tokens.length() - 1]
  }
}

///|
fn Parser::advance(self : Parser) -> Token {
  let t = self.peek()
  if self.pos + 1 < self.tokens.length() {
    self.pos = self.pos + 1
  }
  t
}

///|
fn tok_is(t : Token, k : TokKind) -> Bool {
  match (t.kind, k) {
    (TokKind::Eof, TokKind::Eof) => true
    (TokKind::Ident, TokKind::Ident) => true
    (TokKind::IntLit, TokKind::IntLit) => true
    (TokKind::FloatLit, TokKind::FloatLit) => true
    (TokKind::StrLit, TokKind::StrLit) => true
    (TokKind::KwAnd, TokKind::KwAnd) => true
    (TokKind::KwBreak, TokKind::KwBreak) => true
    (TokKind::KwDo, TokKind::KwDo) => true
    (TokKind::KwElse, TokKind::KwElse) => true
    (TokKind::KwElseif, TokKind::KwElseif) => true
    (TokKind::KwEnd, TokKind::KwEnd) => true
    (TokKind::KwFalse, TokKind::KwFalse) => true
    (TokKind::KwFor, TokKind::KwFor) => true
    (TokKind::KwFunction, TokKind::KwFunction) => true
    (TokKind::KwGoto, TokKind::KwGoto) => true
    (TokKind::KwIf, TokKind::KwIf) => true
    (TokKind::KwIn, TokKind::KwIn) => true
    (TokKind::KwLocal, TokKind::KwLocal) => true
    (TokKind::KwNil, TokKind::KwNil) => true
    (TokKind::KwNot, TokKind::KwNot) => true
    (TokKind::KwOr, TokKind::KwOr) => true
    (TokKind::KwRepeat, TokKind::KwRepeat) => true
    (TokKind::KwReturn, TokKind::KwReturn) => true
    (TokKind::KwThen, TokKind::KwThen) => true
    (TokKind::KwTrue, TokKind::KwTrue) => true
    (TokKind::KwUntil, TokKind::KwUntil) => true
    (TokKind::KwWhile, TokKind::KwWhile) => true
    (TokKind::Plus, TokKind::Plus) => true
    (TokKind::Minus, TokKind::Minus) => true
    (TokKind::Star, TokKind::Star) => true
    (TokKind::Slash, TokKind::Slash) => true
    (TokKind::SlashSlash, TokKind::SlashSlash) => true
    (TokKind::Percent, TokKind::Percent) => true
    (TokKind::Caret, TokKind::Caret) => true
    (TokKind::Hash, TokKind::Hash) => true
    (TokKind::Amp, TokKind::Amp) => true
    (TokKind::Tilde, TokKind::Tilde) => true
    (TokKind::Pipe, TokKind::Pipe) => true
    (TokKind::Shl, TokKind::Shl) => true
    (TokKind::Shr, TokKind::Shr) => true
    (TokKind::EqEq, TokKind::EqEq) => true
    (TokKind::TildeEq, TokKind::TildeEq) => true
    (TokKind::LtEq, TokKind::LtEq) => true
    (TokKind::GtEq, TokKind::GtEq) => true
    (TokKind::Lt, TokKind::Lt) => true
    (TokKind::Gt, TokKind::Gt) => true
    (TokKind::Assign, TokKind::Assign) => true
    (TokKind::LParen, TokKind::LParen) => true
    (TokKind::RParen, TokKind::RParen) => true
    (TokKind::LBrace, TokKind::LBrace) => true
    (TokKind::RBrace, TokKind::RBrace) => true
    (TokKind::LBracket, TokKind::LBracket) => true
    (TokKind::RBracket, TokKind::RBracket) => true
    (TokKind::DoubleColon, TokKind::DoubleColon) => true
    (TokKind::Semi, TokKind::Semi) => true
    (TokKind::Colon, TokKind::Colon) => true
    (TokKind::Comma, TokKind::Comma) => true
    (TokKind::Dot, TokKind::Dot) => true
    (TokKind::DotDot, TokKind::DotDot) => true
    (TokKind::DotDotDot, TokKind::DotDotDot) => true
    _ => false
  }
}

///|
fn Parser::check(self : Parser, k : TokKind) -> Bool {
  tok_is(self.peek(), k)
}

///|
fn Parser::eat(self : Parser, k : TokKind) -> Bool {
  if self.check(k) {
    let _ = self.advance()
    true
  } else {
    false
  }
}

///|
fn Parser::expect(self : Parser, k : TokKind, msg : String) -> Result[Token, LuaError] {
  if self.check(k) {
    Ok(self.advance())
  } else {
    let t = self.peek()
    Err(LuaError::new(LuaErrorKind::SyntaxError, "expected " + msg, t.line))
  }
}

///|
fn Parser::enter(self : Parser) -> Result[Unit, LuaError] {
  self.depth = self.depth + 1
  if self.depth > self.max_depth {
    return Err(LuaError::new(LuaErrorKind::StackLimit, "syntax nesting depth exceeded", self.peek().line))
  }
  Ok(())
}

///|
fn Parser::leave(self : Parser) -> Unit {
  self.depth = self.depth - 1
}

///|
fn is_block_follow(k : TokKind) -> Bool {
  match k {
    TokKind::Eof | TokKind::KwElse | TokKind::KwElseif | TokKind::KwEnd | TokKind::KwUntil => true
    _ => false
  }
}

///|
fn Parser::parse_block(self : Parser) -> Result[Array[Stmt], LuaError] {
  match self.enter() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let stmts : Array[Stmt] = []
  while !is_block_follow(self.peek().kind) {
    if self.check(TokKind::KwReturn) {
      match self.parse_return() {
        Ok(st) => {
          stmts.push(st)
          let _ = self.eat(TokKind::Semi)
          break
        }
        Err(e) => {
          self.leave()
          return Err(e)
        }
      }
    }
    match self.parse_stmt() {
      Ok(st) => stmts.push(st)
      Err(e) => {
        self.leave()
        return Err(e)
      }
    }
  }
  self.leave()
  Ok(stmts)
}

///|
fn Parser::parse_return(self : Parser) -> Result[Stmt, LuaError] {
  let line = self.advance().line
  let exprs : Array[Expr] = []
  if !is_block_follow(self.peek().kind) && !self.check(TokKind::Semi) {
    match self.parse_expr_list() {
      Ok(es) => {
        let mut i = 0
        while i < es.length() {
          exprs.push(es[i])
          i = i + 1
        }
      }
      Err(e) => return Err(e)
    }
  }
  Ok(Stmt::Return(exprs, line))
}

///|
fn Parser::parse_stmt(self : Parser) -> Result[Stmt, LuaError] {
  let t = self.peek()
  match t.kind {
    TokKind::Semi => {
      let _ = self.advance()
      Ok(Stmt::Empty)
    }
    TokKind::KwDo => {
      let _ = self.advance()
      let body = match self.parse_block() {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      match self.expect(TokKind::KwEnd, "'end'") {
        Ok(_) => Ok(Stmt::Block(body, t.line))
        Err(e) => Err(e)
      }
    }
    TokKind::KwWhile => {
      let _ = self.advance()
      let cond = match self.parse_expr(0) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      match self.expect(TokKind::KwDo, "'do'") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let body = match self.parse_block() {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      match self.expect(TokKind::KwEnd, "'end'") {
        Ok(_) => Ok(Stmt::While(cond, body, t.line))
        Err(e) => Err(e)
      }
    }
    TokKind::KwRepeat => {
      let _ = self.advance()
      let body = match self.parse_block() {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      match self.expect(TokKind::KwUntil, "'until'") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let cond = match self.parse_expr(0) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      Ok(Stmt::Repeat(body, cond, t.line))
    }
    TokKind::KwIf => self.parse_if()
    TokKind::KwFor => self.parse_for()
    TokKind::KwFunction => self.parse_func_stmt()
    TokKind::KwLocal => self.parse_local_stmt()
    TokKind::KwBreak => {
      let _ = self.advance()
      Ok(Stmt::Break(t.line))
    }
    TokKind::KwGoto => {
      let _ = self.advance()
      let nm = match self.expect(TokKind::Ident, "label name") {
        Ok(tok) => tok.text
        Err(e) => return Err(e)
      }
      Ok(Stmt::Goto(nm, t.line))
    }
    TokKind::DoubleColon => {
      let _ = self.advance()
      let nm = match self.expect(TokKind::Ident, "label name") {
        Ok(tok) => tok.text
        Err(e) => return Err(e)
      }
      match self.expect(TokKind::DoubleColon, "'::'") {
        Ok(_) => Ok(Stmt::Label(nm, t.line))
        Err(e) => Err(e)
      }
    }
    _ => self.parse_assign_or_call()
  }
}

///|
fn Parser::parse_if(self : Parser) -> Result[Stmt, LuaError] {
  let start_line = self.advance().line
  let branches : Array[IfBranch] = []
  let mut cur_line = start_line
  while true {
    let cond = match self.parse_expr(0) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    match self.expect(TokKind::KwThen, "'then'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let body = match self.parse_block() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    branches.push(IfBranch::{ cond: cond, body: body, line: cur_line })
    if self.check(TokKind::KwElseif) {
      cur_line = self.advance().line
    } else {
      break
    }
  }
  let mut else_body : Option[Array[Stmt]] = None
  if self.eat(TokKind::KwElse) {
    match self.parse_block() {
      Ok(b) => else_body = Some(b)
      Err(e) => return Err(e)
    }
  }
  match self.expect(TokKind::KwEnd, "'end'") {
    Ok(_) => Ok(Stmt::If(branches, else_body, start_line))
    Err(e) => Err(e)
  }
}

///|
fn Parser::parse_for(self : Parser) -> Result[Stmt, LuaError] {
  let line = self.advance().line
  let first_name = match self.expect(TokKind::Ident, "variable name") {
    Ok(t) => t.text
    Err(e) => return Err(e)
  }
  if self.eat(TokKind::Assign) {
    // Numeric for: for i = init, limit[, step] do ... end
    let init_e = match self.parse_expr(0) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    match self.expect(TokKind::Comma, "','") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let limit_e = match self.parse_expr(0) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    let mut step_e : Option[Expr] = None
    if self.eat(TokKind::Comma) {
      match self.parse_expr(0) {
        Ok(e) => step_e = Some(e)
        Err(e) => return Err(e)
      }
    }
    match self.expect(TokKind::KwDo, "'do'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let body = match self.parse_block() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    match self.expect(TokKind::KwEnd, "'end'") {
      Ok(_) => Ok(Stmt::ForNum(first_name, init_e, limit_e, step_e, body, line))
      Err(e) => Err(e)
    }
  } else {
    // Generic for: for k, v in explist do ... end
    let names : Array[String] = [first_name]
    while self.eat(TokKind::Comma) {
      match self.expect(TokKind::Ident, "variable name") {
        Ok(t) => names.push(t.text)
        Err(e) => return Err(e)
      }
    }
    match self.expect(TokKind::KwIn, "'in'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let iters = match self.parse_expr_list() {
      Ok(es) => es
      Err(e) => return Err(e)
    }
    match self.expect(TokKind::KwDo, "'do'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let body = match self.parse_block() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    match self.expect(TokKind::KwEnd, "'end'") {
      Ok(_) => Ok(Stmt::ForGen(names, iters, body, line))
      Err(e) => Err(e)
    }
  }
}

///|
fn Parser::parse_func_stmt(self : Parser) -> Result[Stmt, LuaError] {
  let line = self.advance().line
  let base_tok = match self.expect(TokKind::Ident, "function name") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let mut target = Expr::Ident(base_tok.text, base_tok.line)
  while self.eat(TokKind::Dot) {
    let field_tok = match self.expect(TokKind::Ident, "field name") {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    target = Expr::Field(target, field_tok.text, field_tok.line)
  }
  let mut is_method = false
  if self.eat(TokKind::Colon) {
    let method_tok = match self.expect(TokKind::Ident, "method name") {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    target = Expr::Field(target, method_tok.text, method_tok.line)
    is_method = true
  }
  let fb = match self.parse_func_body(is_method, line) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  Ok(Stmt::Assign([target], [Expr::FuncExpr(fb)], line))
}

///|
fn Parser::parse_local_stmt(self : Parser) -> Result[Stmt, LuaError] {
  let line = self.advance().line
  if self.eat(TokKind::KwFunction) {
    let name_tok = match self.expect(TokKind::Ident, "function name") {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let fb = match self.parse_func_body(false, line) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    return Ok(Stmt::LocalFunc(name_tok.text, fb, line))
  }
  let names : Array[(String, LocalAttrib)] = []
  let first = match self.expect(TokKind::Ident, "variable name") {
    Ok(t) => t.text
    Err(e) => return Err(e)
  }
  let first_attr = match self.parse_local_attrib() {
    Ok(a) => a
    Err(e) => return Err(e)
  }
  names.push((first, first_attr))
  while self.eat(TokKind::Comma) {
    let nm = match self.expect(TokKind::Ident, "variable name") {
      Ok(t) => t.text
      Err(e) => return Err(e)
    }
    let attr = match self.parse_local_attrib() {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    names.push((nm, attr))
  }
  let mut init_exprs : Array[Expr] = []
  if self.eat(TokKind::Assign) {
    init_exprs = match self.parse_expr_list() {
      Ok(es) => es
      Err(e) => return Err(e)
    }
  }
  Ok(Stmt::LocalDecl(names, init_exprs, line))
}

///| Parse optional Lua 5.4 local variable attribute `<const>` or `<close>`.
fn Parser::parse_local_attrib(self : Parser) -> Result[LocalAttrib, LuaError] {
  if !self.eat(TokKind::Lt) {
    return Ok(LocalAttrib::None)
  }
  let tok = match self.expect(TokKind::Ident, "attribute name") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match self.expect(TokKind::Gt, "'>'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if tok.text == "const" {
    Ok(LocalAttrib::Const)
  } else if tok.text == "close" {
    Ok(LocalAttrib::Close)
  } else {
    Err(LuaError::new(LuaErrorKind::SyntaxError, "unknown attribute '" + tok.text + "'", tok.line))
  }
}

///|
fn Parser::parse_func_body(self : Parser, is_method : Bool, line : Int) -> Result[FuncBody, LuaError] {
  match self.expect(TokKind::LParen, "'('") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let params : Array[String] = []
  if is_method {
    params.push("self")
  }
  let mut is_vararg = false
  if !self.check(TokKind::RParen) {
    while true {
      if self.eat(TokKind::DotDotDot) {
        is_vararg = true
        break
      }
      let pt = match self.expect(TokKind::Ident, "parameter name") {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      params.push(pt.text)
      if !self.eat(TokKind::Comma) {
        break
      }
    }
  }
  match self.expect(TokKind::RParen, "')'") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let body = match self.parse_block() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  match self.expect(TokKind::KwEnd, "'end'") {
    Ok(_) => Ok(FuncBody::{ params: params, is_vararg: is_vararg, body: body, line: line })
    Err(e) => Err(e)
  }
}

///|
fn is_lvalue(e : Expr) -> Bool {
  match e {
    Expr::Ident(_, _) | Expr::Index(_, _, _) | Expr::Field(_, _, _) => true
    _ => false
  }
}

///|
fn is_call_expr(e : Expr) -> Bool {
  match e {
    Expr::Call(_, _, _) | Expr::MethodCall(_, _, _, _) => true
    _ => false
  }
}

///|
fn Parser::parse_assign_or_call(self : Parser) -> Result[Stmt, LuaError] {
  let line = self.peek().line
  let first = match self.parse_suffixed_expr() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  if self.check(TokKind::Assign) || self.check(TokKind::Comma) {
    if !is_lvalue(first) {
      return Err(LuaError::new(LuaErrorKind::SyntaxError, "invalid assignment target", line))
    }
    let lhs : Array[Expr] = [first]
    while self.eat(TokKind::Comma) {
      let next_e = match self.parse_suffixed_expr() {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      if !is_lvalue(next_e) {
        return Err(LuaError::new(LuaErrorKind::SyntaxError, "invalid assignment target", expr_line(next_e)))
      }
      lhs.push(next_e)
    }
    match self.expect(TokKind::Assign, "'='") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let rhs = match self.parse_expr_list() {
      Ok(es) => es
      Err(e) => return Err(e)
    }
    Ok(Stmt::Assign(lhs, rhs, line))
  } else {
    if !is_call_expr(first) {
      return Err(LuaError::new(LuaErrorKind::SyntaxError, "unexpected expression statement", line))
    }
    Ok(Stmt::ExprCall(first, line))
  }
}

///|
fn Parser::parse_expr_list(self : Parser) -> Result[Array[Expr], LuaError] {
  let list : Array[Expr] = []
  let first = match self.parse_expr(0) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  list.push(first)
  while self.eat(TokKind::Comma) {
    let e = match self.parse_expr(0) {
      Ok(ex) => ex
      Err(err) => return Err(err)
    }
    list.push(e)
  }
  Ok(list)
}

///| Binary operator precedence table: returns `(left_prec, right_prec, BinOp)`.
fn binop_info(k : TokKind) -> Option[(Int, Int, BinOp)] {
  match k {
    TokKind::KwOr => Some((1, 2, BinOp::Or))
    TokKind::KwAnd => Some((3, 4, BinOp::And))
    TokKind::Lt => Some((5, 6, BinOp::Lt))
    TokKind::Gt => Some((5, 6, BinOp::Gt))
    TokKind::LtEq => Some((5, 6, BinOp::Le))
    TokKind::GtEq => Some((5, 6, BinOp::Ge))
    TokKind::TildeEq => Some((5, 6, BinOp::Ne))
    TokKind::EqEq => Some((5, 6, BinOp::Eq))
    TokKind::Pipe => Some((7, 8, BinOp::BOr))
    TokKind::Tilde => Some((9, 10, BinOp::BXor))
    TokKind::Amp => Some((11, 12, BinOp::BAnd))
    TokKind::Shl => Some((13, 14, BinOp::Shl))
    TokKind::Shr => Some((13, 14, BinOp::Shr))
    TokKind::DotDot => Some((16, 15, BinOp::Concat)) // Right-associative!
    TokKind::Plus => Some((17, 18, BinOp::Add))
    TokKind::Minus => Some((17, 18, BinOp::Sub))
    TokKind::Star => Some((19, 20, BinOp::Mul))
    TokKind::Slash => Some((19, 20, BinOp::Div))
    TokKind::SlashSlash => Some((19, 20, BinOp::IDiv))
    TokKind::Percent => Some((19, 20, BinOp::Mod))
    TokKind::Caret => Some((24, 23, BinOp::Pow)) // Right-associative, tighter than unary (22)!
    _ => None
  }
}

///|
fn Parser::parse_expr(self : Parser, min_prec : Int) -> Result[Expr, LuaError] {
  match self.enter() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let t = self.peek()
  let mut lhs = match t.kind {
    TokKind::Minus => {
      let _ = self.advance()
      match self.parse_expr(22) {
        Ok(sub) => Expr::Unary(UnOp::Neg, sub, t.line)
        Err(e) => {
          self.leave()
          return Err(e)
        }
      }
    }
    TokKind::KwNot => {
      let _ = self.advance()
      match self.parse_expr(22) {
        Ok(sub) => Expr::Unary(UnOp::Not, sub, t.line)
        Err(e) => {
          self.leave()
          return Err(e)
        }
      }
    }
    TokKind::Hash => {
      let _ = self.advance()
      match self.parse_expr(22) {
        Ok(sub) => Expr::Unary(UnOp::Len, sub, t.line)
        Err(e) => {
          self.leave()
          return Err(e)
        }
      }
    }
    TokKind::Tilde => {
      let _ = self.advance()
      match self.parse_expr(22) {
        Ok(sub) => Expr::Unary(UnOp::BNot, sub, t.line)
        Err(e) => {
          self.leave()
          return Err(e)
        }
      }
    }
    _ => {
      match self.parse_simple_expr() {
        Ok(e) => e
        Err(e) => {
          self.leave()
          return Err(e)
        }
      }
    }
  }

  while true {
    let op_tok = self.peek()
    match binop_info(op_tok.kind) {
      Some((lprec, rprec, bop)) => {
        if lprec < min_prec {
          break
        }
        let _ = self.advance()
        let rhs = match self.parse_expr(rprec) {
          Ok(e) => e
          Err(e) => {
            self.leave()
            return Err(e)
          }
        }
        lhs = Expr::Binary(bop, lhs, rhs, op_tok.line)
      }
      None => break
    }
  }

  self.leave()
  Ok(lhs)
}

///|
fn Parser::parse_simple_expr(self : Parser) -> Result[Expr, LuaError] {
  let t = self.peek()
  match t.kind {
    TokKind::KwNil => {
      let _ = self.advance()
      Ok(Expr::Nil(t.line))
    }
    TokKind::KwTrue => {
      let _ = self.advance()
      Ok(Expr::Bool(true, t.line))
    }
    TokKind::KwFalse => {
      let _ = self.advance()
      Ok(Expr::Bool(false, t.line))
    }
    TokKind::IntLit => {
      let _ = self.advance()
      Ok(Expr::Int(t.int_val, t.line))
    }
    TokKind::FloatLit => {
      let _ = self.advance()
      Ok(Expr::Float(t.float_val, t.line))
    }
    TokKind::StrLit => {
      let _ = self.advance()
      Ok(Expr::Str(t.text, t.line))
    }
    TokKind::DotDotDot => {
      let _ = self.advance()
      Ok(Expr::Vararg(t.line))
    }
    TokKind::LBrace => self.parse_table_ctor()
    TokKind::KwFunction => {
      let _ = self.advance()
      match self.parse_func_body(false, t.line) {
        Ok(fb) => Ok(Expr::FuncExpr(fb))
        Err(e) => Err(e)
      }
    }
    _ => self.parse_suffixed_expr()
  }
}

///|
fn Parser::parse_suffixed_expr(self : Parser) -> Result[Expr, LuaError] {
  let t = self.peek()
  let mut expr = match t.kind {
    TokKind::Ident => {
      let _ = self.advance()
      Expr::Ident(t.text, t.line)
    }
    TokKind::LParen => {
      let _ = self.advance()
      let inner = match self.parse_expr(0) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      match self.expect(TokKind::RParen, "')'") {
        Ok(_) => Expr::Paren(inner, t.line)
        Err(e) => return Err(e)
      }
    }
    _ => return Err(LuaError::new(LuaErrorKind::SyntaxError, "unexpected token in expression", t.line))
  }

  while true {
    let nt = self.peek()
    match nt.kind {
      TokKind::Dot => {
        let _ = self.advance()
        let fld = match self.expect(TokKind::Ident, "field name") {
          Ok(ft) => ft
          Err(e) => return Err(e)
        }
        expr = Expr::Field(expr, fld.text, nt.line)
      }
      TokKind::LBracket => {
        let _ = self.advance()
        let idx = match self.parse_expr(0) {
          Ok(e) => e
          Err(e) => return Err(e)
        }
        match self.expect(TokKind::RBracket, "']'") {
          Ok(_) => expr = Expr::Index(expr, idx, nt.line)
          Err(e) => return Err(e)
        }
      }
      TokKind::Colon => {
        let _ = self.advance()
        let m = match self.expect(TokKind::Ident, "method name") {
          Ok(mt) => mt
          Err(e) => return Err(e)
        }
        let args = match self.parse_call_args() {
          Ok(a) => a
          Err(e) => return Err(e)
        }
        expr = Expr::MethodCall(expr, m.text, args, nt.line)
      }
      TokKind::LParen | TokKind::LBrace | TokKind::StrLit => {
        let args = match self.parse_call_args() {
          Ok(a) => a
          Err(e) => return Err(e)
        }
        expr = Expr::Call(expr, args, nt.line)
      }
      _ => break
    }
  }
  Ok(expr)
}

///|
fn Parser::parse_call_args(self : Parser) -> Result[Array[Expr], LuaError] {
  let t = self.peek()
  match t.kind {
    TokKind::LParen => {
      let _ = self.advance()
      let args : Array[Expr] = []
      if !self.check(TokKind::RParen) {
        match self.parse_expr_list() {
          Ok(es) => {
            let mut i = 0
            while i < es.length() {
              args.push(es[i])
              i = i + 1
            }
          }
          Err(e) => return Err(e)
        }
      }
      match self.expect(TokKind::RParen, "')'") {
        Ok(_) => Ok(args)
        Err(e) => Err(e)
      }
    }
    TokKind::LBrace => {
      match self.parse_table_ctor() {
        Ok(tbl) => Ok([tbl])
        Err(e) => Err(e)
      }
    }
    TokKind::StrLit => {
      let _ = self.advance()
      Ok([Expr::Str(t.text, t.line)])
    }
    _ => Err(LuaError::new(LuaErrorKind::SyntaxError, "expected function arguments", t.line))
  }
}

///|
fn Parser::parse_table_ctor(self : Parser) -> Result[Expr, LuaError] {
  let line = self.advance().line // consume '{'
  let fields : Array[TableField] = []
  while !self.check(TokKind::RBrace) {
    if self.eat(TokKind::LBracket) {
      let k = match self.parse_expr(0) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      match self.expect(TokKind::RBracket, "']'") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match self.expect(TokKind::Assign, "'='") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let v = match self.parse_expr(0) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      fields.push(TableField::{ key: Some(k), val_expr: v })
    } else if self.check(TokKind::Ident) && tok_is(self.peek_at(1), TokKind::Assign) {
      let name_tok = self.advance()
      let _ = self.advance() // '='
      let v = match self.parse_expr(0) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      fields.push(TableField::{ key: Some(Expr::Str(name_tok.text, name_tok.line)), val_expr: v })
    } else {
      let v = match self.parse_expr(0) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      fields.push(TableField::{ key: None, val_expr: v })
    }
    if !self.eat(TokKind::Comma) && !self.eat(TokKind::Semi) {
      break
    }
  }
  match self.expect(TokKind::RBrace, "'}'") {
    Ok(_) => Ok(Expr::TableCtor(fields, line))
    Err(e) => Err(e)
  }
}

///|
fn parse_lua(source : String, max_depth : Int, allow_shebang : Bool) -> Result[Array[Stmt], LuaError] {
  let tokens = match lex_lua(source, allow_shebang) {
    Ok(ts) => ts
    Err(e) => return Err(e)
  }
  let capped_depth = if max_depth > 200 { 200 } else if max_depth < 16 { 16 } else { max_depth }
  let p = Parser::new(tokens, capped_depth)
  let stmts = match p.parse_block() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if !p.check(TokKind::Eof) {
    return Err(LuaError::new(LuaErrorKind::SyntaxError, "unexpected token after end of chunk", p.peek().line))
  }
  Ok(stmts)
}
