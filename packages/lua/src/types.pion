///| Core public types and VM runtime structures for `lua`
///| (Pure-Pion Lua 5.4 bytecode compiler & sandboxed register VM).

///| Categorized Lua error kinds covering syntax, runtime, types, user errors, and sandbox limits.
pub enum LuaErrorKind {
  SyntaxError
  RuntimeError
  TypeError
  FuelLimit
  StackLimit
  MemoryLimit
  OutputLimit
  UserError
  Unimplemented
}

///|
pub fn error_kind_as_str(kind : LuaErrorKind) -> String {
  match kind {
    LuaErrorKind::SyntaxError => "SyntaxError"
    LuaErrorKind::RuntimeError => "RuntimeError"
    LuaErrorKind::TypeError => "TypeError"
    LuaErrorKind::FuelLimit => "FuelLimit"
    LuaErrorKind::StackLimit => "StackLimit"
    LuaErrorKind::MemoryLimit => "MemoryLimit"
    LuaErrorKind::OutputLimit => "OutputLimit"
    LuaErrorKind::UserError => "UserError"
    LuaErrorKind::Unimplemented => "Unimplemented"
  }
}

///|
pub fn error_kind_eq(a : LuaErrorKind, b : LuaErrorKind) -> Bool {
  error_kind_as_str(a) == error_kind_as_str(b)
}

///| Returns true for sandbox limit errors that `pcall`/`xpcall` MUST NOT catch.
fn is_sandbox_limit_error(kind : LuaErrorKind) -> Bool {
  match kind {
    LuaErrorKind::FuelLimit
    | LuaErrorKind::StackLimit
    | LuaErrorKind::MemoryLimit
    | LuaErrorKind::OutputLimit => true
    _ => false
  }
}

///| Structured Lua error with kind, message, and 1-based source line (0 if unknown).
pub struct LuaError {
  pub kind : LuaErrorKind
  pub message : String
  pub line : Int
}

///|
pub fn LuaError::new(kind : LuaErrorKind, message : String, line : Int) -> LuaError {
  LuaError::{ kind: kind, message: message, line: line }
}

///|
pub fn LuaError::unimplemented(what : String) -> LuaError {
  LuaError::{ kind: LuaErrorKind::Unimplemented, message: "not implemented: " + what, line: 0 }
}

///|
pub fn LuaError::is_kind(self : LuaError, expected : LuaErrorKind) -> Bool {
  error_kind_eq(self.kind, expected)
}

///|
pub fn LuaError::to_string(self : LuaError) -> String {
  let sb = StringBuilder::new()
  sb.write_string(error_kind_as_str(self.kind))
  if self.line > 0 {
    sb.write_string(" (line ")
    sb.write_string(self.line.to_string())
    sb.write_string(")")
  }
  sb.write_string(": ")
  sb.write_string(self.message)
  sb.to_string()
}

///| Deterministic sandbox budgets enforced by `LuaVm`.
pub struct LuaLimits {
  pub max_fuel : Int64
  pub max_call_depth : Int
  pub max_stack_slots : Int
  pub max_memory_bytes : Int
  pub max_output_bytes : Int
}

///|
pub fn LuaLimits::default() -> LuaLimits {
  LuaLimits::{
    max_fuel: 50000000L,
    max_call_depth: 200,
    max_stack_slots: 16384,
    max_memory_bytes: 33554432,
    max_output_bytes: 1048576,
  }
}

///|
pub fn LuaLimits::new(
  max_fuel : Int64,
  max_call_depth : Int,
  max_stack_slots : Int,
  max_memory_bytes : Int,
  max_output_bytes : Int,
) -> LuaLimits {
  LuaLimits::{
    max_fuel: max_fuel,
    max_call_depth: max_call_depth,
    max_stack_slots: max_stack_slots,
    max_memory_bytes: max_memory_bytes,
    max_output_bytes: max_output_bytes,
  }
}

///| Runtime Lua 5.4 value. Heap objects (`Table`, `Closure`, `NativeFn`) are
///| represented by VM arena handles for O(1) identity equality and clean memory tracking.
pub enum LuaValue {
  Nil
  Bool(Bool)
  Int(Int64)
  Float(Double)
  Str(String)
  Table(Int)
  Closure(Int)
  NativeFn(Int)
  Thread(Int)
}

///|
pub fn LuaValue::nil() -> LuaValue {
  LuaValue::Nil
}

///|
pub fn LuaValue::bool(v : Bool) -> LuaValue {
  LuaValue::Bool(v)
}

///|
pub fn LuaValue::int(v : Int64) -> LuaValue {
  LuaValue::Int(v)
}

///|
pub fn LuaValue::float(v : Double) -> LuaValue {
  LuaValue::Float(v)
}

///|
pub fn LuaValue::str(v : String) -> LuaValue {
  LuaValue::Str(v)
}

///|
pub fn LuaValue::table(id : Int) -> LuaValue {
  LuaValue::Table(id)
}

///|
pub fn LuaValue::is_nil(self : LuaValue) -> Bool {
  match self {
    LuaValue::Nil => true
    _ => false
  }
}

///| In Lua, only `nil` and `false` are falsy.
pub fn LuaValue::is_truthy(self : LuaValue) -> Bool {
  match self {
    LuaValue::Nil => false
    LuaValue::Bool(b) => b
    _ => true
  }
}

///|
pub fn LuaValue::type_name(self : LuaValue) -> String {
  match self {
    LuaValue::Nil => "nil"
    LuaValue::Bool(_) => "boolean"
    LuaValue::Int(_) | LuaValue::Float(_) => "number"
    LuaValue::Str(_) => "string"
    LuaValue::Table(_) => "table"
    LuaValue::Closure(_) | LuaValue::NativeFn(_) => "function"
    LuaValue::Thread(_) => "thread"
  }
}

///|
pub fn LuaValue::as_bool(self : LuaValue) -> Option[Bool] {
  match self {
    LuaValue::Bool(b) => Some(b)
    _ => None
  }
}

///|
pub fn LuaValue::as_int(self : LuaValue) -> Option[Int64] {
  match self {
    LuaValue::Int(n) => Some(n)
    _ => None
  }
}

///|
pub fn LuaValue::as_float(self : LuaValue) -> Option[Double] {
  match self {
    LuaValue::Float(f) => Some(f)
    LuaValue::Int(n) => Some(n.to_double())
    _ => None
  }
}

///|
pub fn LuaValue::as_str(self : LuaValue) -> Option[String] {
  match self {
    LuaValue::Str(s) => Some(s)
    _ => None
  }
}

///|
pub fn LuaValue::as_table(self : LuaValue) -> Option[Int] {
  match self {
    LuaValue::Table(id) => Some(id)
    _ => None
  }
}

///| Strict value equality for tests (distinguishes `Int(1L)` from `Float(1.0)`).
pub fn value_strict_eq(a : LuaValue, b : LuaValue) -> Bool {
  match (a, b) {
    (LuaValue::Nil, LuaValue::Nil) => true
    (LuaValue::Bool(x), LuaValue::Bool(y)) => x == y
    (LuaValue::Int(x), LuaValue::Int(y)) => x == y
    (LuaValue::Float(x), LuaValue::Float(y)) => {
      if x != x && y != y {
        true
      } else {
        x == y
      }
    }
    (LuaValue::Str(x), LuaValue::Str(y)) => x == y
    (LuaValue::Table(x), LuaValue::Table(y)) => x == y
    (LuaValue::Closure(x), LuaValue::Closure(y)) => x == y
    (LuaValue::NativeFn(x), LuaValue::NativeFn(y)) => x == y
    (LuaValue::Thread(x), LuaValue::Thread(y)) => x == y
    _ => false
  }
}

///| Compiled bytecode chunk (reusable across `LuaVm` instances).
pub struct Chunk {
  pub source : String
  pub proto : Proto
}

///| Unboxed VM value tag constants (mirrors `LuaValue` variants for zero-allocation stack/array ops).
let TAG_NIL : Int = 0
let TAG_BOOL : Int = 1
let TAG_INT : Int = 2
let TAG_FLOAT : Int = 3
let TAG_STR : Int = 4
let TAG_TABLE : Int = 5
let TAG_CLOSURE : Int = 6
let TAG_NATIVE : Int = 7
let TAG_THREAD : Int = 8

///| Upvalue cell: open (points to `stack[slot]`) or closed (stores unboxed tag/num/str_val).
struct Upvalue {
  mut is_open : Bool
  mut slot : Int
  mut tag : Int
  mut num : Int64
  mut str_val : String
}

///| Runtime Lua closure pairing a `Proto` with its captured upvalue IDs.
struct LuaClosure {
  mut proto : Proto
  upval_ids : Array[Int]
}

///| Active call frame on the VM call stack (reused in-place via `frame_count` high-water pool).
struct CallFrame {
  mut closure_id : Int
  mut pc : Int
  mut base : Int
  mut varargs : Option[Array[LuaValue]]
  mut ret_reg : Int // absolute stack slot where results go (-1 for top-level call)
  mut want_results : Int // -1 = all (sets vm.top), >=0 = exact count
  mut tbc_slots : Option[Array[Int]] // lazy to-be-closed absolute stack slots in this frame
}

///| Cooperative coroutine state (`thread`).
///| status: 0 = suspended (initial or yielded), 1 = running, 2 = normal, 3 = dead
struct LuaThread {
  mut status : Int
  mut entry_fn : LuaValue
  mut started : Bool
  stack_tag : Array[Int]
  stack_num : Array[Int64]
  stack_str : Array[String]
  mut top : Int
  frames : Array[CallFrame]
  mut frame_count : Int
  open_upvalues : Array[Int]
  mut yield_vals : Array[LuaValue]
  mut did_yield : Bool
}

///| Sandboxed Lua 5.4 register virtual machine.
pub struct LuaVm {
  pub limits : LuaLimits
  pub mut fuel_used_count : Int64
  pub mut memory_used_bytes : Int
  tables : Array[LuaTable]
  table_free : Array[Bool]
  table_free_list : Array[Int]
  host_table_roots : Array[Int]
  closures : Array[LuaClosure]
  closure_free : Array[Bool]
  closure_free_list : Array[Int]
  upvalues : Array[Upvalue]
  upval_free : Array[Bool]
  upval_free_list : Array[Int]
  mut open_upvalues : Array[Int]
  native_fns : Array[(LuaVm, Array[LuaValue]) -> Result[Array[LuaValue], LuaError]]
  threads : Array[LuaThread]
  mut current_thread : Int // -1 = main thread
  mut globals_id : Int
  mut string_mt_id : Int
  mut stack_tag : Array[Int]
  mut stack_num : Array[Int64]
  mut stack_str : Array[String]
  mut top : Int
  mut frames : Array[CallFrame]
  mut frame_count : Int
  mut host_depth : Int
  mut gc_threshold : Int
  mut gc_running : Bool
  mut pinned_mem_bytes : Int
  mut rng_s0 : UInt64
  mut rng_s1 : UInt64
  mut rng_s2 : UInt64
  mut rng_s3 : UInt64
  mut out_buf : StringBuilder
  mut out_bytes : Int
  mut last_error_val : LuaValue
}
