///| Core public types for `lua` (Pure-Pion Lua 5.4 bytecode compiler & sandboxed register VM).

///| Categorized Lua error kinds covering syntax, runtime, types, user errors, and sandbox limits.
pub enum LuaErrorKind {
  SyntaxError
  RuntimeError
  TypeError
  FuelLimit
  StackLimit
  MemoryLimit
  OutputLimit
  UserError
  Unimplemented
}

///|
pub fn error_kind_as_str(kind : LuaErrorKind) -> String {
  match kind {
    LuaErrorKind::SyntaxError => "SyntaxError"
    LuaErrorKind::RuntimeError => "RuntimeError"
    LuaErrorKind::TypeError => "TypeError"
    LuaErrorKind::FuelLimit => "FuelLimit"
    LuaErrorKind::StackLimit => "StackLimit"
    LuaErrorKind::MemoryLimit => "MemoryLimit"
    LuaErrorKind::OutputLimit => "OutputLimit"
    LuaErrorKind::UserError => "UserError"
    LuaErrorKind::Unimplemented => "Unimplemented"
  }
}

///|
pub fn error_kind_eq(a : LuaErrorKind, b : LuaErrorKind) -> Bool {
  error_kind_as_str(a) == error_kind_as_str(b)
}

///| Structured Lua error with kind, message, and 1-based source line (0 if unknown).
pub struct LuaError {
  pub kind : LuaErrorKind
  pub message : String
  pub line : Int
}

///|
pub fn LuaError::new(kind : LuaErrorKind, message : String, line : Int) -> LuaError {
  LuaError::{ kind: kind, message: message, line: line }
}

///|
pub fn LuaError::unimplemented(what : String) -> LuaError {
  LuaError::{ kind: LuaErrorKind::Unimplemented, message: "not implemented: " + what, line: 0 }
}

///|
pub fn LuaError::is_kind(self : LuaError, expected : LuaErrorKind) -> Bool {
  error_kind_eq(self.kind, expected)
}

///|
pub fn LuaError::to_string(self : LuaError) -> String {
  let sb = StringBuilder::new()
  sb.write_string(error_kind_as_str(self.kind))
  if self.line > 0 {
    sb.write_string(" (line ")
    sb.write_string(self.line.to_string())
    sb.write_string(")")
  }
  sb.write_string(": ")
  sb.write_string(self.message)
  sb.to_string()
}

///| Deterministic sandbox budgets enforced by `LuaVm`.
pub struct LuaLimits {
  pub max_fuel : Int64
  pub max_call_depth : Int
  pub max_stack_slots : Int
  pub max_memory_bytes : Int
  pub max_output_bytes : Int
}

///|
pub fn LuaLimits::default() -> LuaLimits {
  LuaLimits::{
    max_fuel: 50000000L,
    max_call_depth: 200,
    max_stack_slots: 16384,
    max_memory_bytes: 33554432,
    max_output_bytes: 1048576,
  }
}

///|
pub fn LuaLimits::new(
  max_fuel : Int64,
  max_call_depth : Int,
  max_stack_slots : Int,
  max_memory_bytes : Int,
  max_output_bytes : Int,
) -> LuaLimits {
  LuaLimits::{
    max_fuel: max_fuel,
    max_call_depth: max_call_depth,
    max_stack_slots: max_stack_slots,
    max_memory_bytes: max_memory_bytes,
    max_output_bytes: max_output_bytes,
  }
}

///| Runtime Lua 5.4 value. Heap objects (`Table`, `Closure`, `NativeFn`) are
///| represented by VM arena handles for O(1) identity equality and clean memory tracking.
pub enum LuaValue {
  Nil
  Bool(Bool)
  Int(Int64)
  Float(Double)
  Str(String)
  Table(Int)
  Closure(Int)
  NativeFn(Int)
}

///|
pub fn LuaValue::nil() -> LuaValue {
  LuaValue::Nil
}

///|
pub fn LuaValue::bool(v : Bool) -> LuaValue {
  LuaValue::Bool(v)
}

///|
pub fn LuaValue::int(v : Int64) -> LuaValue {
  LuaValue::Int(v)
}

///|
pub fn LuaValue::float(v : Double) -> LuaValue {
  LuaValue::Float(v)
}

///|
pub fn LuaValue::str(v : String) -> LuaValue {
  LuaValue::Str(v)
}

///|
pub fn LuaValue::table(id : Int) -> LuaValue {
  LuaValue::Table(id)
}

///|
pub fn LuaValue::is_nil(self : LuaValue) -> Bool {
  match self {
    LuaValue::Nil => true
    _ => false
  }
}

///| In Lua, only `nil` and `false` are falsy.
pub fn LuaValue::is_truthy(self : LuaValue) -> Bool {
  match self {
    LuaValue::Nil => false
    LuaValue::Bool(b) => b
    _ => true
  }
}

///|
pub fn LuaValue::type_name(self : LuaValue) -> String {
  match self {
    LuaValue::Nil => "nil"
    LuaValue::Bool(_) => "boolean"
    LuaValue::Int(_) | LuaValue::Float(_) => "number"
    LuaValue::Str(_) => "string"
    LuaValue::Table(_) => "table"
    LuaValue::Closure(_) | LuaValue::NativeFn(_) => "function"
  }
}

///|
pub fn LuaValue::as_bool(self : LuaValue) -> Option[Bool] {
  match self {
    LuaValue::Bool(b) => Some(b)
    _ => None
  }
}

///|
pub fn LuaValue::as_int(self : LuaValue) -> Option[Int64] {
  match self {
    LuaValue::Int(n) => Some(n)
    _ => None
  }
}

///|
pub fn LuaValue::as_float(self : LuaValue) -> Option[Double] {
  match self {
    LuaValue::Float(f) => Some(f)
    LuaValue::Int(n) => Some(n.to_double())
    _ => None
  }
}

///|
pub fn LuaValue::as_str(self : LuaValue) -> Option[String] {
  match self {
    LuaValue::Str(s) => Some(s)
    _ => None
  }
}

///|
pub fn LuaValue::as_table(self : LuaValue) -> Option[Int] {
  match self {
    LuaValue::Table(id) => Some(id)
    _ => None
  }
}

///| Strict value equality for tests (distinguishes `Int(1L)` from `Float(1.0)`).
pub fn value_strict_eq(a : LuaValue, b : LuaValue) -> Bool {
  match (a, b) {
    (LuaValue::Nil, LuaValue::Nil) => true
    (LuaValue::Bool(x), LuaValue::Bool(y)) => x == y
    (LuaValue::Int(x), LuaValue::Int(y)) => x == y
    (LuaValue::Float(x), LuaValue::Float(y)) => {
      if x != x && y != y {
        true
      } else {
        x == y
      }
    }
    (LuaValue::Str(x), LuaValue::Str(y)) => x == y
    (LuaValue::Table(x), LuaValue::Table(y)) => x == y
    (LuaValue::Closure(x), LuaValue::Closure(y)) => x == y
    (LuaValue::NativeFn(x), LuaValue::NativeFn(y)) => x == y
    _ => false
  }
}

///| Compiled bytecode chunk (reusable across `LuaVm` instances).
pub struct Chunk {
  pub source : String
}

///| Sandboxed Lua 5.4 register virtual machine.
pub struct LuaVm {
  pub limits : LuaLimits
  pub mut fuel_used_count : Int64
  pub mut memory_used_bytes : Int
}
