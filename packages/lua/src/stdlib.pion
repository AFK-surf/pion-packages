///| Pure-Pion Lua 5.4 Standard Library: `base`, `table`, `string`, `math`, `utf8`.

///| Helper to register a native function in a table.
fn reg_tbl_fn(
  vm : LuaVm,
  tid : Int,
  name : String,
  f : (LuaVm, Array[LuaValue]) -> Result[Array[LuaValue], LuaError],
) -> Unit {
  let fn_val = vm.alloc_native(f)
  let _ = vm.tables[tid].raw_set(LuaValue::Str(name), fn_val)
}

///| Normalize a 1-based Lua string index (supporting negative indices from end).
fn lua_str_pos(pos : Int, len : Int) -> Int {
  if pos >= 0 {
    pos
  } else {
    len + pos + 1
  }
}

///| Format a single `string.format` specifier.
fn format_int_base(n_in : Int64, base : Int, upper : Bool, unsigned_mode : Bool) -> String {
  let digits = if upper { "0123456789ABCDEF" } else { "0123456789abcdef" }
  let dbytes = string_to_bytes(digits)
  let mut u = n_in.reinterpret_as_uint64()
  let mut neg = false
  if !unsigned_mode && n_in < 0L {
    neg = true
    u = 0UL - u
  }
  if u == 0UL {
    return "0"
  }
  let buf : Array[Byte] = []
  let b64 = base.to_int64().reinterpret_as_uint64()
  while u > 0UL {
    let rem = (u % b64).reinterpret_as_int64().to_int()
    buf.push(dbytes[rem])
    u = u / b64
  }
  if neg {
    buf.push((45).to_byte())
  }
  // Reverse
  let out : Array[Byte] = []
  let mut i = buf.length() - 1
  while i >= 0 {
    out.push(buf[i])
    i = i - 1
  }
  match utf8_bytes_to_string(bytes_from_array(out)) {
    Some(s) => s
    None => ""
  }
}

///| Format a `Double` with fixed `prec` fractional digits (`%.2f`).
fn format_fixed_f64(val_in : Double, prec : Int) -> String {
  if val_in != val_in {
    return "nan"
  }
  if val_in == 1.0 / 0.0 {
    return "inf"
  }
  if val_in == -1.0 / 0.0 {
    return "-inf"
  }
  let neg = val_in < 0.0
  let v = if neg { -val_in } else { val_in }
  let scale = f64_pow(10.0, prec.to_double())
  let rounded = f64_floor(v * scale + 0.5)
  let int_part = f64_floor(rounded / scale).to_int64()
  let frac_part = (rounded - int_part.to_double() * scale).to_int64()
  let sb = StringBuilder::new()
  if neg {
    sb.write_string("-")
  }
  sb.write_string(int_part.to_string())
  if prec > 0 {
    sb.write_string(".")
    let fs = frac_part.to_string()
    let mut pad = prec - fs.length()
    while pad > 0 {
      sb.write_string("0")
      pad = pad - 1
    }
    sb.write_string(fs)
  }
  sb.to_string()
}

///| Stable mergesort for `table.sort`.
fn lua_merge_sort(
  vm : LuaVm,
  arr : Array[LuaValue],
  lo : Int,
  hi : Int,
  cmp_opt : Option[LuaValue],
) -> Result[Unit, LuaError] {
  if hi - lo <= 1 {
    return Ok(())
  }
  let mid = lo + (hi - lo) / 2
  match lua_merge_sort(vm, arr, lo, mid, cmp_opt) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match lua_merge_sort(vm, arr, mid, hi, cmp_opt) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let tmp : Array[LuaValue] = []
  let mut i = lo
  let mut j = mid
  while i < mid && j < hi {
    let take_right = match cmp_opt {
      Some(cmp_fn) => {
        match vm.call_value(cmp_fn, [arr[j], arr[i]]) {
          Ok(res) => res.length() > 0 && res[0].is_truthy()
          Err(e) => return Err(e)
        }
      }
      None => {
        match vm.lua_lt(arr[j], arr[i]) {
          Ok(b) => b
          Err(e) => return Err(e)
        }
      }
    }
    if take_right {
      tmp.push(arr[j])
      j = j + 1
    } else {
      tmp.push(arr[i])
      i = i + 1
    }
  }
  while i < mid {
    tmp.push(arr[i])
    i = i + 1
  }
  while j < hi {
    tmp.push(arr[j])
    j = j + 1
  }
  let mut k = 0
  while k < tmp.length() {
    arr[lo + k] = tmp[k]
    k = k + 1
  }
  Ok(())
}

///| Decode a single UTF-8 codepoint starting at `bs[pos]`. Returns `Some((cp, byte_len))`.
fn utf8_decode_at(bs : Bytes, pos : Int) -> Option[(Int, Int)] {
  let n = bs.length()
  if pos >= n {
    return None
  }
  let b0 = bs[pos].to_int()
  if b0 < 0x80 {
    return Some((b0, 1))
  } else if (b0 & 0xE0) == 0xC0 {
    if pos + 1 >= n {
      return None
    }
    let b1 = bs[pos + 1].to_int()
    if (b1 & 0xC0) != 0x80 {
      return None
    }
    let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
    if cp < 0x80 {
      return None
    }
    Some((cp, 2))
  } else if (b0 & 0xF0) == 0xE0 {
    if pos + 2 >= n {
      return None
    }
    let b1 = bs[pos + 1].to_int()
    let b2 = bs[pos + 2].to_int()
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
      return None
    }
    let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
    if cp < 0x800 {
      return None
    }
    Some((cp, 3))
  } else if (b0 & 0xF8) == 0xF0 {
    if pos + 3 >= n {
      return None
    }
    let b1 = bs[pos + 1].to_int()
    let b2 = bs[pos + 2].to_int()
    let b3 = bs[pos + 3].to_int()
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
      return None
    }
    let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
    if cp < 0x10000 || cp > 0x10FFFF {
      return None
    }
    Some((cp, 4))
  } else {
    None
  }
}

///| Populate `_G` with `base`, `table`, `string`, `math`, and `utf8` standard libraries.
fn register_stdlib(vm : LuaVm) -> Unit {
  let g = vm.globals_id
  let _ = vm.tables[g].raw_set(LuaValue::Str("_G"), LuaValue::Table(g))
  let _ = vm.tables[g].raw_set(LuaValue::Str("_VERSION"), LuaValue::Str("Lua 5.4"))

  // ---------------- base ----------------
  reg_tbl_fn(vm, g, "type", fn(_v, args) {
    let val_arg = if args.length() > 0 { args[0] } else { LuaValue::Nil }
    Ok([LuaValue::Str(val_arg.type_name())])
  })

  reg_tbl_fn(vm, g, "tostring", fn(v, args) {
    let val_arg = if args.length() > 0 { args[0] } else { LuaValue::Nil }
    match v.value_to_string(val_arg) {
      Ok(s) => Ok([LuaValue::Str(s)])
      Err(e) => Err(e)
    }
  })

  reg_tbl_fn(vm, g, "tonumber", fn(_v, args) {
    if args.length() == 0 {
      return Ok([LuaValue::Nil])
    }
    if args.length() >= 2 && !args[1].is_nil() {
      let base_i = match to_lua_int(args[1]) {
        Some(b) => b.to_int()
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "bad base to 'tonumber'", 0))
      }
      match args[0] {
        LuaValue::Str(s) => {
          match lua_parse_int_base(s, base_i) {
            Some(n) => return Ok([LuaValue::Int(n)])
            None => return Ok([LuaValue::Nil])
          }
        }
        _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected in 'tonumber' with base", 0))
      }
    }
    match to_lua_number(args[0]) {
      Some(nv) => Ok([nv])
      None => Ok([LuaValue::Nil])
    }
  })

  reg_tbl_fn(vm, g, "print", fn(v, args) {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < args.length() {
      if i > 0 {
        sb.write_string("\t")
      }
      match v.value_to_string(args[i]) {
        Ok(s) => sb.write_string(s)
        Err(e) => return Err(e)
      }
      i = i + 1
    }
    sb.write_string("\n")
    match v.append_output(sb.to_string()) {
      Ok(_) => Ok([])
      Err(e) => Err(e)
    }
  })

  reg_tbl_fn(vm, g, "error", fn(v, args) {
    let err_v = if args.length() > 0 { args[0] } else { LuaValue::Nil }
    v.last_error_val = err_v
    let msg = lua_value_to_string_raw(err_v)
    Err(LuaError::new(LuaErrorKind::UserError, msg, 0))
  })

  reg_tbl_fn(vm, g, "assert", fn(v, args) {
    let cond = if args.length() > 0 { args[0] } else { LuaValue::Nil }
    if cond.is_truthy() {
      Ok(args)
    } else {
      let msg_v = if args.length() > 1 { args[1] } else { LuaValue::Str("assertion failed!") }
      v.last_error_val = msg_v
      Err(LuaError::new(LuaErrorKind::UserError, lua_value_to_string_raw(msg_v), 0))
    }
  })

  reg_tbl_fn(vm, g, "pcall", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'pcall'", 0))
    }
    let f = args[0]
    let call_args : Array[LuaValue] = []
    let mut i = 1
    while i < args.length() {
      call_args.push(args[i])
      i = i + 1
    }
    v.last_error_val = LuaValue::Nil
    match v.call_value(f, call_args) {
      Ok(res) => {
        let out : Array[LuaValue] = [LuaValue::Bool(true)]
        let mut j = 0
        while j < res.length() {
          out.push(res[j])
          j = j + 1
        }
        Ok(out)
      }
      Err(e) => {
        if is_sandbox_limit_error(e.kind) {
          return Err(e)
        }
        let err_obj = if e.is_kind(LuaErrorKind::UserError) && !v.last_error_val.is_nil() {
          v.last_error_val
        } else {
          LuaValue::Str(e.message)
        }
        Ok([LuaValue::Bool(false), err_obj])
      }
    }
  })

  reg_tbl_fn(vm, g, "xpcall", fn(v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'xpcall'", 0))
    }
    let f = args[0]
    let msgh = args[1]
    let call_args : Array[LuaValue] = []
    let mut i = 2
    while i < args.length() {
      call_args.push(args[i])
      i = i + 1
    }
    v.last_error_val = LuaValue::Nil
    match v.call_value(f, call_args) {
      Ok(res) => {
        let out : Array[LuaValue] = [LuaValue::Bool(true)]
        let mut j = 0
        while j < res.length() {
          out.push(res[j])
          j = j + 1
        }
        Ok(out)
      }
      Err(e) => {
        if is_sandbox_limit_error(e.kind) {
          return Err(e)
        }
        let err_obj = if e.is_kind(LuaErrorKind::UserError) && !v.last_error_val.is_nil() {
          v.last_error_val
        } else {
          LuaValue::Str(e.message)
        }
        match v.call_value(msgh, [err_obj]) {
          Ok(hres) => {
            let handled = if hres.length() > 0 { hres[0] } else { LuaValue::Nil }
            Ok([LuaValue::Bool(false), handled])
          }
          Err(he) => {
            if is_sandbox_limit_error(he.kind) {
              return Err(he)
            }
            Ok([LuaValue::Bool(false), LuaValue::Str("error in error handling")])
          }
        }
      }
    }
  })

  reg_tbl_fn(vm, g, "select", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'select'", 0))
    }
    let n = args.length() - 1
    match args[0] {
      LuaValue::Str(s) => {
        if s == "#" {
          return Ok([LuaValue::Int(n.to_int64())])
        }
      }
      _ => ()
    }
    let mut idx = match to_lua_int(args[0]) {
      Some(k) => k.to_int()
      None => return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'select'", 0))
    }
    if idx < 0 {
      idx = n + idx + 1
    }
    if idx < 1 {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "index out of range in 'select'", 0))
    }
    let out : Array[LuaValue] = []
    let mut i = idx
    while i <= n {
      out.push(args[i])
      i = i + 1
    }
    Ok(out)
  })

  reg_tbl_fn(vm, g, "rawget", fn(v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'rawget'", 0))
    }
    match args[0] {
      LuaValue::Table(tid) => Ok([v.tables[tid].raw_get(args[1])])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'rawget'", 0))
    }
  })

  reg_tbl_fn(vm, g, "rawset", fn(v, args) {
    if args.length() < 3 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'rawset'", 0))
    }
    match args[0] {
      LuaValue::Table(tid) => {
        match v.tables[tid].raw_set(args[1], args[2]) {
          Ok(bytes) => {
            match v.charge_mem(bytes) {
              Ok(_) => Ok([args[0]])
              Err(e) => Err(e)
            }
          }
          Err(e) => Err(e)
        }
      }
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'rawset'", 0))
    }
  })

  reg_tbl_fn(vm, g, "rawequal", fn(_v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'rawequal'", 0))
    }
    Ok([LuaValue::Bool(lua_raw_eq(args[0], args[1]))])
  })

  reg_tbl_fn(vm, g, "rawlen", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'rawlen'", 0))
    }
    match args[0] {
      LuaValue::Str(s) => Ok([LuaValue::Int(s.length().to_int64())])
      LuaValue::Table(tid) => Ok([LuaValue::Int(v.tables[tid].raw_len().to_int64())])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "table or string expected in 'rawlen'", 0))
    }
  })

  reg_tbl_fn(vm, g, "setmetatable", fn(v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'setmetatable'", 0))
    }
    let tid = match args[0] {
      LuaValue::Table(id) => id
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'setmetatable'", 0))
    }
    match args[1] {
      LuaValue::Nil => v.tables[tid].metatable = -1
      LuaValue::Table(mtid) => v.tables[tid].metatable = mtid
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "nil or table expected as metatable", 0))
    }
    Ok([args[0]])
  })

  reg_tbl_fn(vm, g, "getmetatable", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'getmetatable'", 0))
    }
    match args[0] {
      LuaValue::Table(tid) => {
        let mt = v.tables[tid].metatable
        if mt >= 0 {
          Ok([LuaValue::Table(mt)])
        } else {
          Ok([LuaValue::Nil])
        }
      }
      LuaValue::Str(_) => Ok([LuaValue::Table(v.string_mt_id)])
      _ => Ok([LuaValue::Nil])
    }
  })

  let next_fn = vm.alloc_native(fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'next'", 0))
    }
    let tid = match args[0] {
      LuaValue::Table(id) => id
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'next'", 0))
    }
    let k = if args.length() > 1 { args[1] } else { LuaValue::Nil }
    match v.tables[tid].next_entry(k) {
      Ok((nk, nv)) => {
        if nk.is_nil() {
          Ok([LuaValue::Nil])
        } else {
          Ok([nk, nv])
        }
      }
      Err(e) => Err(e)
    }
  })
  let _ = vm.tables[g].raw_set(LuaValue::Str("next"), next_fn)

  reg_tbl_fn(vm, g, "pairs", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "value expected in 'pairs'", 0))
    }
    match v.get_metamethod(args[0], "__pairs") {
      Some(mm) => v.call_value(mm, [args[0]])
      None => Ok([next_fn, args[0], LuaValue::Nil])
    }
  })

  let ipairs_aux = vm.alloc_native(fn(v, args) {
    if args.length() < 2 {
      return Ok([LuaValue::Nil])
    }
    let idx = match to_lua_int(args[1]) {
      Some(n) => n + 1L
      None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected in ipairs", 0))
    }
    match v.index_get(args[0], LuaValue::Int(idx)) {
      Ok(val_at) => {
        if val_at.is_nil() {
          Ok([LuaValue::Nil])
        } else {
          Ok([LuaValue::Int(idx), val_at])
        }
      }
      Err(e) => Err(e)
    }
  })
  reg_tbl_fn(vm, g, "ipairs", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "value expected in 'ipairs'", 0))
    }
    Ok([ipairs_aux, args[0], LuaValue::Int(0L)])
  })

  // ---------------- table ----------------
  let tbl_lib = match vm.alloc_table() {
    Ok(id) => id
    Err(_) => return
  }
  let _ = vm.tables[g].raw_set(LuaValue::Str("table"), LuaValue::Table(tbl_lib))

  reg_tbl_fn(vm, tbl_lib, "insert", fn(v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'table.insert'", 0))
    }
    let tid = match args[0] {
      LuaValue::Table(id) => id
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'table.insert'", 0))
    }
    let n = v.tables[tid].raw_len()
    if args.length() == 2 {
      match v.tables[tid].raw_set(LuaValue::Int((n + 1).to_int64()), args[1]) {
        Ok(b) => {
          match v.charge_mem(b) {
            Ok(_) => Ok([])
            Err(e) => Err(e)
          }
        }
        Err(e) => Err(e)
      }
    } else {
      let pos = match to_lua_int(args[1]) {
        Some(p) => p.to_int()
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "position must be integer", 0))
      }
      if pos < 1 || pos > n + 1 {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "position out of bounds in 'table.insert'", 0))
      }
      let mut i = n
      while i >= pos {
        let cur = v.tables[tid].raw_get(LuaValue::Int(i.to_int64()))
        match v.tables[tid].raw_set(LuaValue::Int((i + 1).to_int64()), cur) {
          Ok(b) => {
            match v.charge_mem(b) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
          }
          Err(e) => return Err(e)
        }
        i = i - 1
      }
      match v.tables[tid].raw_set(LuaValue::Int(pos.to_int64()), args[2]) {
        Ok(b) => {
          match v.charge_mem(b) {
            Ok(_) => Ok([])
            Err(e) => Err(e)
          }
        }
        Err(e) => Err(e)
      }
    }
  })

  reg_tbl_fn(vm, tbl_lib, "remove", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'table.remove'", 0))
    }
    let tid = match args[0] {
      LuaValue::Table(id) => id
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'table.remove'", 0))
    }
    let n = v.tables[tid].raw_len()
    let pos = if args.length() >= 2 && !args[1].is_nil() {
      match to_lua_int(args[1]) {
        Some(p) => p.to_int()
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "position must be integer", 0))
      }
    } else {
      n
    }
    if pos == n && n == 0 {
      return Ok([LuaValue::Nil])
    }
    if pos < 1 || pos > n + 1 {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "position out of bounds in 'table.remove'", 0))
    }
    let removed = v.tables[tid].raw_get(LuaValue::Int(pos.to_int64()))
    let mut i = pos
    while i < n {
      let nxt = v.tables[tid].raw_get(LuaValue::Int((i + 1).to_int64()))
      let _ = v.tables[tid].raw_set(LuaValue::Int(i.to_int64()), nxt)
      i = i + 1
    }
    let _ = v.tables[tid].raw_set(LuaValue::Int(n.to_int64()), LuaValue::Nil)
    Ok([removed])
  })

  reg_tbl_fn(vm, tbl_lib, "concat", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'table.concat'", 0))
    }
    let tid = match args[0] {
      LuaValue::Table(id) => id
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'table.concat'", 0))
    }
    let sep = if args.length() >= 2 && !args[1].is_nil() {
      match args[1] {
        LuaValue::Str(s) => s
        LuaValue::Int(n) => n.to_string()
        LuaValue::Float(f) => lua_float_to_string(f)
        _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected for separator", 0))
      }
    } else {
      ""
    }
    let start_i = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => k.to_int()
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      1
    }
    let end_i = if args.length() >= 4 && !args[3].is_nil() {
      match to_lua_int(args[3]) {
        Some(k) => k.to_int()
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      v.tables[tid].raw_len()
    }
    let sb = StringBuilder::new()
    let mut i = start_i
    let mut total_bytes = 0
    while i <= end_i {
      if i > start_i {
        sb.write_string(sep)
        total_bytes = total_bytes + sep.length()
      }
      let elem = v.tables[tid].raw_get(LuaValue::Int(i.to_int64()))
      let es = match elem {
        LuaValue::Str(s) => s
        LuaValue::Int(n) => n.to_string()
        LuaValue::Float(f) => lua_float_to_string(f)
        _ => return Err(LuaError::new(LuaErrorKind::TypeError, "invalid value (" + elem.type_name() + ") in table.concat", 0))
      }
      sb.write_string(es)
      total_bytes = total_bytes + es.length()
      match v.charge_fuel(1L) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      i = i + 1
    }
    match v.charge_mem(total_bytes) {
      Ok(_) => Ok([LuaValue::Str(sb.to_string())])
      Err(e) => Err(e)
    }
  })

  reg_tbl_fn(vm, tbl_lib, "sort", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'table.sort'", 0))
    }
    let tid = match args[0] {
      LuaValue::Table(id) => id
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'table.sort'", 0))
    }
    let cmp_opt = if args.length() >= 2 && !args[1].is_nil() { Some(args[1]) } else { None }
    let n = v.tables[tid].raw_len()
    let arr : Array[LuaValue] = []
    let mut i = 1
    while i <= n {
      arr.push(v.tables[tid].raw_get(LuaValue::Int(i.to_int64())))
      i = i + 1
    }
    match lua_merge_sort(v, arr, 0, n, cmp_opt) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = 0
    while i < n {
      let _ = v.tables[tid].raw_set(LuaValue::Int((i + 1).to_int64()), arr[i])
      i = i + 1
    }
    Ok([])
  })

  reg_tbl_fn(vm, tbl_lib, "move", fn(v, args) {
    if args.length() < 4 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'table.move'", 0))
    }
    let src_id = match args[0] {
      LuaValue::Table(id) => id
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "table expected", 0))
    }
    let f_idx = match to_lua_int(args[1]) {
      Some(k) => k
      None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
    }
    let e_idx = match to_lua_int(args[2]) {
      Some(k) => k
      None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
    }
    let t_idx = match to_lua_int(args[3]) {
      Some(k) => k
      None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
    }
    let dst_id = if args.length() >= 5 && !args[4].is_nil() {
      match args[4] {
        LuaValue::Table(id) => id
        _ => return Err(LuaError::new(LuaErrorKind::TypeError, "table expected for destination", 0))
      }
    } else {
      src_id
    }
    if e_idx >= f_idx {
      let count = e_idx - f_idx + 1L
      if t_idx > f_idx && src_id == dst_id {
        let mut i = count - 1L
        while i >= 0L {
          let val_m = v.tables[src_id].raw_get(LuaValue::Int(f_idx + i))
          let _ = v.tables[dst_id].raw_set(LuaValue::Int(t_idx + i), val_m)
          i = i - 1L
        }
      } else {
        let mut i = 0L
        while i < count {
          let val_m = v.tables[src_id].raw_get(LuaValue::Int(f_idx + i))
          let _ = v.tables[dst_id].raw_set(LuaValue::Int(t_idx + i), val_m)
          i = i + 1L
        }
      }
    }
    Ok([LuaValue::Table(dst_id)])
  })

  reg_tbl_fn(vm, tbl_lib, "pack", fn(v, args) {
    let tid = match v.alloc_table() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    let mut i = 0
    while i < args.length() {
      let _ = v.tables[tid].raw_set(LuaValue::Int((i + 1).to_int64()), args[i])
      i = i + 1
    }
    let _ = v.tables[tid].raw_set(LuaValue::Str("n"), LuaValue::Int(args.length().to_int64()))
    Ok([LuaValue::Table(tid)])
  })

  reg_tbl_fn(vm, tbl_lib, "unpack", fn(v, args) {
