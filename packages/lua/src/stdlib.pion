///| Pure-Pion Lua 5.4 Standard Library: `base`, `table`, `string`, `math`, `utf8`.

///| Helper to register a native function in a table.
fn reg_tbl_fn(
  vm : LuaVm,
  tid : Int,
  name : String,
  f : (LuaVm, Array[LuaValue]) -> Result[Array[LuaValue], LuaError],
) -> Unit {
  let fn_val = vm.alloc_native(f)
  let _ = vm.tables[tid].raw_set(LuaValue::Str(name), fn_val)
}

///| Normalize a 1-based Lua string index from `Int64` without Int32 truncation (P1-12).
///| Returns a clamped 1-based position in `0 .. len + 1`.
fn lua_str_pos_i64(pos : Int64, len : Int) -> Int {
  let len64 = len.to_int64()
  let p = if pos >= 0L { pos } else { len64 + pos + 1L }
  if p < 0L {
    0
  } else if p > len64 + 1L {
    len + 1
  } else {
    p.to_int()
  }
}

///| Normalize a 1-based Lua string index (supporting negative indices from end).
fn lua_str_pos(pos : Int, len : Int) -> Int {
  lua_str_pos_i64(pos.to_int64(), len)
}

///| Format a single `string.format` specifier.
fn format_int_base(n_in : Int64, base : Int, upper : Bool, unsigned_mode : Bool) -> String {
  let digits = if upper { "0123456789ABCDEF" } else { "0123456789abcdef" }
  let dbytes = string_to_bytes(digits)
  let mut u = n_in.reinterpret_as_uint64()
  let mut neg = false
  if !unsigned_mode && n_in < 0L {
    neg = true
    u = 0UL - u
  }
  if u == 0UL {
    return "0"
  }
  let buf : Array[Byte] = []
  let b64 = base.to_int64().reinterpret_as_uint64()
  while u > 0UL {
    let rem = (u % b64).reinterpret_as_int64().to_int()
    buf.push(dbytes[rem])
    u = u / b64
  }
  if neg {
    buf.push((45).to_byte())
  }
  // Reverse
  let out : Array[Byte] = []
  let mut i = buf.length() - 1
  while i >= 0 {
    out.push(buf[i])
    i = i - 1
  }
  match utf8_bytes_to_string(bytes_from_array(out)) {
    Some(s) => s
    None => ""
  }
}

///| Format a `Double` with fixed `prec` fractional digits (`%.2f`).
fn format_fixed_f64(val_in : Double, prec : Int) -> String {
  if val_in != val_in {
    return "nan"
  }
  if val_in == 1.0 / 0.0 {
    return "inf"
  }
  if val_in == -1.0 / 0.0 {
    return "-inf"
  }
  let neg = val_in < 0.0
  let v = if neg { -val_in } else { val_in }
  let scale = f64_pow(10.0, prec.to_double())
  let rounded = f64_floor(v * scale + 0.5)
  let int_part = f64_floor(rounded / scale).to_int64()
  let frac_part = (rounded - int_part.to_double() * scale).to_int64()
  let sb = StringBuilder::new()
  if neg {
    sb.write_string("-")
  }
  sb.write_string(int_part.to_string())
  if prec > 0 {
    sb.write_string(".")
    let fs = frac_part.to_string()
    let mut pad = prec - fs.length()
    while pad > 0 {
      sb.write_string("0")
      pad = pad - 1
    }
    sb.write_string(fs)
  }
  sb.to_string()
}

///| Stable mergesort for `table.sort` with shared scratch buffer `tmp`.
fn lua_merge_sort(
  vm : LuaVm,
  arr : Array[LuaValue],
  tmp : Array[LuaValue],
  lo : Int,
  hi : Int,
  cmp_opt : Option[LuaValue],
) -> Result[Unit, LuaError] {
  if hi - lo <= 1 {
    return Ok(())
  }
  let mid = lo + (hi - lo) / 2
  match lua_merge_sort(vm, arr, tmp, lo, mid, cmp_opt) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match lua_merge_sort(vm, arr, tmp, mid, hi, cmp_opt) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut i = lo
  let mut j = mid
  let mut w = lo
  while i < mid && j < hi {
    match vm.charge_fuel(1L) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let take_right = match cmp_opt {
      Some(cmp_fn) => {
        match vm.call_value(cmp_fn, [arr[j], arr[i]]) {
          Ok(res) => res.length() > 0 && res[0].is_truthy()
          Err(e) => return Err(e)
        }
      }
      None => {
        match (arr[j], arr[i]) {
          (LuaValue::Int(x), LuaValue::Int(y)) => x < y
          (LuaValue::Float(x), LuaValue::Float(y)) => x < y
          _ => {
            match vm.lua_lt(arr[j], arr[i]) {
              Ok(b) => b
              Err(e) => return Err(e)
            }
          }
        }
      }
    }
    if take_right {
      tmp[w] = arr[j]
      j = j + 1
    } else {
      tmp[w] = arr[i]
      i = i + 1
    }
    w = w + 1
  }
  while i < mid {
    tmp[w] = arr[i]
    i = i + 1
    w = w + 1
  }
  while j < hi {
    tmp[w] = arr[j]
    j = j + 1
    w = w + 1
  }
  let mut k = lo
  while k < hi {
    arr[k] = tmp[k]
    k = k + 1
  }
  Ok(())
}

///| Lightweight mutable iterator state for `string.gmatch` (avoids per-call table allocation).
struct GmatchState {
  mut cur_pos : Int
  mut last_end : Int
}

///| Decode a single UTF-8 codepoint starting at `bs[pos]`. Returns `Some((cp, byte_len))`.
///| When `lax` is false (default), rejects UTF-16 surrogates (0xD800..0xDFFF) and >0x10FFFF (P2-5).
///| When `lax` is true, accepts surrogates and Lua 5.4 extended 5/6-byte UTF-8 up to 0x7FFFFFFF.
fn utf8_decode_at(bs : Bytes, pos : Int, lax : Bool) -> Option[(Int, Int)] {
  let n = bs.length()
  if pos >= n {
    return None
  }
  let b0 = bs[pos].to_int()
  if b0 < 0x80 {
    return Some((b0, 1))
  } else if (b0 & 0xE0) == 0xC0 {
    if pos + 1 >= n {
      return None
    }
    let b1 = bs[pos + 1].to_int()
    if (b1 & 0xC0) != 0x80 {
      return None
    }
    let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
    if cp < 0x80 {
      return None
    }
    Some((cp, 2))
  } else if (b0 & 0xF0) == 0xE0 {
    if pos + 2 >= n {
      return None
    }
    let b1 = bs[pos + 1].to_int()
    let b2 = bs[pos + 2].to_int()
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
      return None
    }
    let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
    if cp < 0x800 {
      return None
    }
    if !lax && cp >= 0xD800 && cp <= 0xDFFF {
      return None
    }
    Some((cp, 3))
  } else if (b0 & 0xF8) == 0xF0 {
    if pos + 3 >= n {
      return None
    }
    let b1 = bs[pos + 1].to_int()
    let b2 = bs[pos + 2].to_int()
    let b3 = bs[pos + 3].to_int()
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
      return None
    }
    let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
    if cp < 0x10000 || (!lax && cp > 0x10FFFF) {
      return None
    }
    Some((cp, 4))
  } else if lax && (b0 & 0xFC) == 0xF8 {
    if pos + 4 >= n {
      return None
    }
    let b1 = bs[pos + 1].to_int()
    let b2 = bs[pos + 2].to_int()
    let b3 = bs[pos + 3].to_int()
    let b4 = bs[pos + 4].to_int()
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 || (b4 & 0xC0) != 0x80 {
      return None
    }
    let cp = ((b0 & 0x03) << 24) | ((b1 & 0x3F) << 18) | ((b2 & 0x3F) << 12) | ((b3 & 0x3F) << 6) | (b4 & 0x3F)
    if cp < 0x200000 {
      return None
    }
    Some((cp, 5))
  } else if lax && (b0 & 0xFE) == 0xFC {
    if pos + 5 >= n {
      return None
    }
    let b1 = bs[pos + 1].to_int()
    let b2 = bs[pos + 2].to_int()
    let b3 = bs[pos + 3].to_int()
    let b4 = bs[pos + 4].to_int()
    let b5 = bs[pos + 5].to_int()
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 || (b4 & 0xC0) != 0x80 || (b5 & 0xC0) != 0x80 {
      return None
    }
    let cp = ((b0 & 0x01) << 30) | ((b1 & 0x3F) << 24) | ((b2 & 0x3F) << 18) | ((b3 & 0x3F) << 12) | ((b4 & 0x3F) << 6) | (b5 & 0x3F)
    if cp < 0x4000000 {
      return None
    }
    Some((cp, 6))
  } else {
    None
  }
}

///| xoshiro256** step for `math.random` (Lua 5.4 PRNG).
fn rotl64(x : UInt64, k : Int) -> UInt64 {
  let rk = 64 - k
  (x << k) | (x >> rk)
}

///|
fn LuaVm::rng_next(self : LuaVm) -> UInt64 {
  let result = rotl64(self.rng_s1 * 5UL, 7) * 9UL
  let t = self.rng_s1 << 17
  self.rng_s2 = self.rng_s2 ^ self.rng_s0
  self.rng_s3 = self.rng_s3 ^ self.rng_s1
  self.rng_s1 = self.rng_s1 ^ self.rng_s2
  self.rng_s0 = self.rng_s0 ^ self.rng_s3
  self.rng_s2 = self.rng_s2 ^ t
  self.rng_s3 = rotl64(self.rng_s3, 45)
  result
}

///| Populate `_G` with `base`, `table`, `string`, `math`, and `utf8` standard libraries.
fn register_stdlib(vm : LuaVm) -> Unit {
  let g = vm.globals_id
  let _ = vm.tables[g].raw_set(LuaValue::Str("_G"), LuaValue::Table(g))
  let _ = vm.tables[g].raw_set(LuaValue::Str("_VERSION"), LuaValue::Str("Lua 5.4"))

  // ---------------- base ----------------
  reg_tbl_fn(vm, g, "type", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'type' (value expected)", 0))
    }
    Ok([LuaValue::Str(args[0].type_name())])
  })

  reg_tbl_fn(vm, g, "tostring", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'tostring' (value expected)", 0))
    }
    match v.value_to_string(args[0]) {
      Ok(s) => Ok([LuaValue::Str(s)])
      Err(e) => Err(e)
    }
  })

  reg_tbl_fn(vm, g, "tonumber", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'tonumber' (value expected)", 0))
    }
    if args.length() >= 2 && !args[1].is_nil() {
      let base_i = match to_lua_int(args[1]) {
        Some(b) => b
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #2 to 'tonumber' (number expected)", 0))
      }
      if base_i < 2L || base_i > 36L {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "bad argument #2 to 'tonumber' (base out of range)", 0))
      }
      match args[0] {
        LuaValue::Str(s) => {
          match lua_parse_int_base(s, base_i.to_int()) {
            Some(n) => return Ok([LuaValue::Int(n)])
            None => return Ok([LuaValue::Nil])
          }
        }
        _ => return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'tonumber' (string expected)", 0))
      }
    }
    match to_lua_number(args[0]) {
      Some(nv) => Ok([nv])
      None => Ok([LuaValue::Nil])
    }
  })

  reg_tbl_fn(vm, g, "print", fn(v, args) {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < args.length() {
      if i > 0 {
        sb.write_string("\t")
      }
      match v.value_to_string(args[i]) {
        Ok(s) => sb.write_string(s)
        Err(e) => return Err(e)
      }
      i = i + 1
    }
    sb.write_string("\n")
    match v.append_output(sb.to_string()) {
      Ok(_) => Ok([])
      Err(e) => Err(e)
    }
  })

  reg_tbl_fn(vm, g, "error", fn(v, args) {
    let err_v = if args.length() > 0 { args[0] } else { LuaValue::Nil }
    let level = if args.length() >= 2 && !args[1].is_nil() {
      match to_lua_int(args[1]) {
        Some(lv) => lv.to_int()
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #2 to 'error' (number expected)", 0))
      }
    } else {
      1
    }
    match err_v {
      LuaValue::Str(s) => {
        if level > 0 {
          let (prefix, line) = v.frame_where(level)
          let full = prefix + s
          v.last_error_val = LuaValue::Str(full)
          return Err(LuaError::new(LuaErrorKind::UserError, full, line))
        }
        v.last_error_val = err_v
        Err(LuaError::new(LuaErrorKind::UserError, s, 0))
      }
      _ => {
        v.last_error_val = err_v
        Err(LuaError::new(LuaErrorKind::UserError, lua_value_to_string_raw(err_v), 0))
      }
    }
  })

  reg_tbl_fn(vm, g, "assert", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'assert' (value expected)", 0))
    }
    let cond = args[0]
    if cond.is_truthy() {
      Ok(args)
    } else if args.length() > 1 {
      let msg_v = args[1]
      match msg_v {
        LuaValue::Str(s) => {
          let (prefix, line) = v.frame_where(1)
          let full = prefix + s
          v.last_error_val = LuaValue::Str(full)
          Err(LuaError::new(LuaErrorKind::UserError, full, line))
        }
        _ => {
          v.last_error_val = msg_v
          Err(LuaError::new(LuaErrorKind::UserError, lua_value_to_string_raw(msg_v), 0))
        }
      }
    } else {
      let (prefix, line) = v.frame_where(1)
      let full = prefix + "assertion failed!"
      v.last_error_val = LuaValue::Str(full)
      Err(LuaError::new(LuaErrorKind::UserError, full, line))
    }
  })

  reg_tbl_fn(vm, g, "load", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'load' (string or function expected)", 0))
    }
    let src = match args[0] {
      LuaValue::Str(s) => s
      LuaValue::Int(n) => n.to_string()
      LuaValue::Float(f) => lua_float_to_string(f)
      LuaValue::Closure(_) | LuaValue::NativeFn(_) | LuaValue::Table(_) => {
        let sb = StringBuilder::new()
        let mut total = 0
        while true {
          match v.charge_fuel(1L) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          match v.call_value(args[0], []) {
            Ok(res) => {
              if res.length() == 0 || res[0].is_nil() {
                break
              }
              let piece = match res[0] {
                LuaValue::Str(ps) => ps
                LuaValue::Int(n) => n.to_string()
                LuaValue::Float(f) => lua_float_to_string(f)
                _ => return Ok([LuaValue::Nil, LuaValue::Str("reader function must return a string")])
              }
              if piece.length() == 0 {
                break
              }
              total = total + piece.length()
              match v.charge_mem(piece.length()) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              sb.write_string(piece)
            }
            Err(e) => {
              if is_sandbox_limit_error(e.kind) {
                return Err(e)
              }
              return Ok([LuaValue::Nil, LuaValue::Str(e.message)])
            }
          }
        }
        sb.to_string()
      }
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'load' (string or function expected)", 0))
    }
    let cname = if args.length() >= 2 && !args[1].is_nil() {
      match args[1] {
        LuaValue::Str(s) => s
        _ => "[string]"
      }
    } else {
      "[string]"
    }
    let mode = if args.length() >= 3 && !args[2].is_nil() {
      match args[2] {
        LuaValue::Str(s) => s
        _ => "bt"
      }
    } else {
      "bt"
    }
    // Check that 't' is allowed in mode
    let mut allows_text = false
    let mut mi = 0
    while mi < mode.length() {
      if mode.code_unit_at(mi).to_int() == 116 {
        allows_text = true
        break
      }
      mi = mi + 1
    }
    if !allows_text {
      return Ok([LuaValue::Nil, LuaValue::Str("attempt to load a text chunk (mode is '" + mode + "')")])
    }
    let env = if args.length() >= 4 {
      args[3]
    } else {
      LuaValue::Table(v.globals_id)
    }
    match compile_lua_proto_named(src, cname, v.limits.max_call_depth, false) {
      Ok(proto) => Ok([v.make_chunk_closure(proto, env)])
      Err(e) => {
        if is_sandbox_limit_error(e.kind) {
          return Err(e)
        }
        Ok([LuaValue::Nil, LuaValue::Str(e.message)])
      }
    }
  })

  reg_tbl_fn(vm, g, "collectgarbage", fn(v, args) {
    let opt = if args.length() > 0 && !args[0].is_nil() {
      match args[0] {
        LuaValue::Str(s) => s
        _ => return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'collectgarbage' (string expected)", 0))
      }
    } else {
      "collect"
    }
    if opt == "collect" {
      v.collect_garbage()
      Ok([LuaValue::Int(0L)])
    } else if opt == "count" {
      Ok([LuaValue::Float(v.memory_used_bytes.to_double() / 1024.0)])
    } else if opt == "isrunning" {
      Ok([LuaValue::Bool(true)])
    } else if opt == "step" {
      v.collect_garbage()
      Ok([LuaValue::Bool(true)])
    } else if opt == "stop" || opt == "restart" {
      Ok([LuaValue::Int(0L)])
    } else if opt == "incremental" || opt == "generational" {
      Ok([LuaValue::Str("incremental")])
    } else {
      Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid option '" + opt + "' to 'collectgarbage'", 0))
    }
  })

  register_coroutine_lib(vm, g)

  reg_tbl_fn(vm, g, "pcall", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'pcall'", 0))
    }
    let f = args[0]
    let call_args : Array[LuaValue] = []
    let mut i = 1
    while i < args.length() {
      call_args.push(args[i])
      i = i + 1
    }
    v.last_error_val = LuaValue::Nil
    match v.call_value(f, call_args) {
      Ok(res) => {
        let out : Array[LuaValue] = [LuaValue::Bool(true)]
        let mut j = 0
        while j < res.length() {
          out.push(res[j])
          j = j + 1
        }
        Ok(out)
      }
      Err(e) => {
        if is_sandbox_limit_error(e.kind) {
          return Err(e)
        }
        let err_obj = if e.is_kind(LuaErrorKind::UserError) {
          v.last_error_val
        } else {
          LuaValue::Str(e.message)
        }
        Ok([LuaValue::Bool(false), err_obj])
      }
    }
  })

  reg_tbl_fn(vm, g, "xpcall", fn(v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'xpcall'", 0))
    }
    let f = args[0]
    let msgh = args[1]
    let call_args : Array[LuaValue] = []
    let mut i = 2
    while i < args.length() {
      call_args.push(args[i])
      i = i + 1
    }
    v.last_error_val = LuaValue::Nil
    match v.call_value(f, call_args) {
      Ok(res) => {
        let out : Array[LuaValue] = [LuaValue::Bool(true)]
        let mut j = 0
        while j < res.length() {
          out.push(res[j])
          j = j + 1
        }
        Ok(out)
      }
      Err(e) => {
        if is_sandbox_limit_error(e.kind) {
          return Err(e)
        }
        let err_obj = if e.is_kind(LuaErrorKind::UserError) {
          v.last_error_val
        } else {
          LuaValue::Str(e.message)
        }
        match v.call_value(msgh, [err_obj]) {
          Ok(hres) => {
            let handled = if hres.length() > 0 { hres[0] } else { LuaValue::Nil }
            Ok([LuaValue::Bool(false), handled])
          }
          Err(he) => {
            if is_sandbox_limit_error(he.kind) {
              return Err(he)
            }
            Ok([LuaValue::Bool(false), LuaValue::Str("error in error handling")])
          }
        }
      }
    }
  })

  reg_tbl_fn(vm, g, "select", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'select'", 0))
    }
    let n = args.length() - 1
    match args[0] {
      LuaValue::Str(s) => {
        if s == "#" {
          return Ok([LuaValue::Int(n.to_int64())])
        }
      }
      _ => ()
    }
    let mut idx = match to_lua_int(args[0]) {
      Some(k) => k.to_int()
      None => return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #1 to 'select'", 0))
    }
    if idx < 0 {
      idx = n + idx + 1
    }
    if idx < 1 {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "index out of range in 'select'", 0))
    }
    let out : Array[LuaValue] = []
    let mut i = idx
    while i <= n {
      out.push(args[i])
      i = i + 1
    }
    Ok(out)
  })

  reg_tbl_fn(vm, g, "rawget", fn(v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'rawget'", 0))
    }
    match args[0] {
      LuaValue::Table(tid) => {
        if !v.valid_table(tid) {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid table handle", 0))
        }
        Ok([v.tables[tid].raw_get(args[1])])
      }
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "table expected in 'rawget'", 0))
    }
  })

  reg_tbl_fn(vm, g, "rawset", fn(v, args) {
    if args.length() < 3 {
