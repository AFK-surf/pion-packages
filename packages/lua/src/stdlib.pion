          Err(e) => return Err(e)
        }
        sb.write_string("%")
        i = i + 1
        continue
      }
      // Flags: -, +, space, #, 0
      let mut left_align = false
      let mut zero_pad = false
      let mut plus_sign = false
      let mut space_sign = false
      let mut alt_form = false
      let mut has_mod = false
      while i < n {
        let fc = fmt.code_unit_at(i).to_int()
        if fc == 45 {
          left_align = true
          has_mod = true
          i = i + 1
        } else if fc == 48 {
          zero_pad = true
          has_mod = true
          i = i + 1
        } else if fc == 43 {
          plus_sign = true
          has_mod = true
          i = i + 1
        } else if fc == 32 {
          space_sign = true
          has_mod = true
          i = i + 1
        } else if fc == 35 {
