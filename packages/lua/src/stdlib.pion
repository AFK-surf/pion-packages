    Err(_) => return
  }
  let _ = vm.tables[g].raw_set(LuaValue::Str("string"), LuaValue::Table(str_lib))
  // Set up string metatable so `s:sub(...)`, `s:upper()` work!
  let str_mt = match vm.alloc_table() {
