    Err(_) => return
  }
  let _ = vm.tables[str_mt].raw_set(LuaValue::Str("__index"), LuaValue::Table(str_lib))
  vm.string_mt_id = str_mt

  reg_tbl_fn(vm, str_lib, "len", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected in 'string.len'", 0))
    }
    match args[0] {
      LuaValue::Str(s) => Ok([LuaValue::Int(s.length().to_int64())])
      LuaValue::Int(n) => Ok([LuaValue::Int(n.to_string().length().to_int64())])
      LuaValue::Float(f) => Ok([LuaValue::Int(lua_float_to_string(f).length().to_int64())])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "string expected in 'string.len'", 0))
    }
  })

  reg_tbl_fn(vm, str_lib, "sub", fn(_v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'string.sub'", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      LuaValue::Int(n) => n.to_string()
      LuaValue::Float(f) => lua_float_to_string(f)
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let n = s.length()
    let mut i = match to_lua_int(args[1]) {
      Some(k) => lua_str_pos(k.to_int(), n)
      None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
    }
    let mut j = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => lua_str_pos(k.to_int(), n)
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      n
    }
    if i < 1 {
      i = 1
    }
    if j > n {
      j = n
    }
    if i > j {
      Ok([LuaValue::Str("")])
    } else {
      Ok([LuaValue::Str(s.slice(i - 1, j))])
    }
  })

  reg_tbl_fn(vm, str_lib, "byte", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let bs = string_to_bytes(s)
    let n = bs.length()
    let mut i = if args.length() >= 2 && !args[1].is_nil() {
      match to_lua_int(args[1]) {
        Some(k) => lua_str_pos(k.to_int(), n)
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      1
    }
    let mut j = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => lua_str_pos(k.to_int(), n)
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      i
    }
    if i < 1 {
      i = 1
    }
    if j > n {
      j = n
    }
    let out : Array[LuaValue] = []
    let mut k = i
    while k <= j {
      out.push(LuaValue::Int(bs[k - 1].to_int().to_int64()))
      k = k + 1
    }
    Ok(out)
  })

  reg_tbl_fn(vm, str_lib, "char", fn(_v, args) {
    let out : Array[Byte] = []
    let mut i = 0
    while i < args.length() {
      let c = match to_lua_int(args[i]) {
        Some(k) => k.to_int()
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected in 'string.char'", 0))
      }
      if c < 0 || c > 255 {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "value out of range in 'string.char'", 0))
      }
      out.push(c.to_byte())
      i = i + 1
    }
    match utf8_bytes_to_string(bytes_from_array(out)) {
      Some(s) => Ok([LuaValue::Str(s)])
      None => Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid UTF-8 in 'string.char'", 0))
    }
  })

  reg_tbl_fn(vm, str_lib, "rep", fn(v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'string.rep'", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => lua_value_to_string_raw(args[0])
    }
    let count = match to_lua_int(args[1]) {
      Some(k) => k.to_int()
      None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
    }
    let sep = if args.length() >= 3 && !args[2].is_nil() {
      match args[2] {
        LuaValue::Str(sv) => sv
        _ => lua_value_to_string_raw(args[2])
      }
    } else {
      ""
    }
    if count <= 0 {
      return Ok([LuaValue::Str("")])
    }
    let total = count * s.length() + (count - 1) * sep.length()
    match v.charge_mem(total) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match v.charge_fuel(count.to_int64()) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let sb = StringBuilder::new()
    let mut i = 0
    while i < count {
      if i > 0 && sep.length() > 0 {
        sb.write_string(sep)
      }
      sb.write_string(s)
      i = i + 1
    }
    Ok([LuaValue::Str(sb.to_string())])
  })

  reg_tbl_fn(vm, str_lib, "reverse", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => lua_value_to_string_raw(args[0])
    }
    let bs = string_to_bytes(s)
    let out : Array[Byte] = []
    let mut i = bs.length() - 1
    while i >= 0 {
      out.push(bs[i])
      i = i - 1
    }
    match utf8_bytes_to_string(bytes_from_array(out)) {
      Some(rs) => Ok([LuaValue::Str(rs)])
      None => Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid UTF-8 in reverse", 0))
    }
  })

  reg_tbl_fn(vm, str_lib, "lower", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => lua_value_to_string_raw(args[0])
    }
    let bs = string_to_bytes(s)
    let out : Array[Byte] = []
    let mut i = 0
    while i < bs.length() {
      let c = bs[i].to_int()
      if c >= 65 && c <= 90 {
        out.push((c + 32).to_byte())
      } else {
        out.push(bs[i])
      }
      i = i + 1
    }
    match utf8_bytes_to_string(bytes_from_array(out)) {
      Some(rs) => Ok([LuaValue::Str(rs)])
      None => Ok([LuaValue::Str(s)])
    }
  })

  reg_tbl_fn(vm, str_lib, "upper", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => lua_value_to_string_raw(args[0])
    }
    let bs = string_to_bytes(s)
    let out : Array[Byte] = []
    let mut i = 0
    while i < bs.length() {
      let c = bs[i].to_int()
      if c >= 97 && c <= 122 {
        out.push((c - 32).to_byte())
      } else {
        out.push(bs[i])
      }
      i = i + 1
    }
    match utf8_bytes_to_string(bytes_from_array(out)) {
      Some(rs) => Ok([LuaValue::Str(rs)])
      None => Ok([LuaValue::Str(s)])
    }
  })

  reg_tbl_fn(vm, str_lib, "find", fn(v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'string.find'", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => lua_value_to_string_raw(args[0])
    }
    let pat = match args[1] {
      LuaValue::Str(pv) => pv
      _ => lua_value_to_string_raw(args[1])
    }
    let n = s.length()
    let init = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => {
          let p = lua_str_pos(k.to_int(), n)
          if p < 1 { 0 } else { p - 1 }
        }
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      0
    }
    let plain = args.length() >= 4 && args[3].is_truthy()
    if plain {
      let sbs = string_to_bytes(s)
      let pbs = string_to_bytes(pat)
      let plen = pbs.length()
      if plen == 0 {
        if init <= n {
          return Ok([LuaValue::Int((init + 1).to_int64()), LuaValue::Int(init.to_int64())])
        } else {
          return Ok([LuaValue::Nil])
        }
      }
      let mut i = init
      while i + plen <= n {
        let mut ok = true
        let mut j = 0
        while j < plen {
          if sbs[i + j].to_int() != pbs[j].to_int() {
            ok = false
            break
          }
          j = j + 1
        }
        if ok {
          return Ok([LuaValue::Int((i + 1).to_int64()), LuaValue::Int((i + plen).to_int64())])
        }
        i = i + 1
      }
      return Ok([LuaValue::Nil])
    }
    match pat_search(v, s, pat, init) {
      Ok(Some((ms, me, caps))) => {
        let out : Array[LuaValue] = [LuaValue::Int((ms + 1).to_int64()), LuaValue::Int(me.to_int64())]
        let mut i = 0
        while i < caps.length() {
          out.push(caps[i])
          i = i + 1
        }
        Ok(out)
      }
      Ok(None) => Ok([LuaValue::Nil])
      Err(e) => Err(e)
    }
  })

  reg_tbl_fn(vm, str_lib, "match", fn(v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'string.match'", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => lua_value_to_string_raw(args[0])
    }
    let pat = match args[1] {
      LuaValue::Str(pv) => pv
      _ => lua_value_to_string_raw(args[1])
    }
    let n = s.length()
    let init = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => {
          let p = lua_str_pos(k.to_int(), n)
          if p < 1 { 0 } else { p - 1 }
        }
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      0
    }
    match pat_search(v, s, pat, init) {
      Ok(Some((ms, me, caps))) => {
        if caps.length() > 0 {
          Ok(caps)
        } else {
          Ok([LuaValue::Str(s.slice(ms, me))])
        }
      }
      Ok(None) => Ok([LuaValue::Nil])
      Err(e) => Err(e)
    }
  })

  reg_tbl_fn(vm, str_lib, "gmatch", fn(v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'string.gmatch'", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => lua_value_to_string_raw(args[0])
    }
    let pat = match args[1] {
      LuaValue::Str(pv) => pv
      _ => lua_value_to_string_raw(args[1])
    }
    let state_tid = match v.alloc_table() {
      Ok(id) => id
      Err(e) => return Err(e)
    }
    let _ = v.tables[state_tid].raw_set(LuaValue::Int(1L), LuaValue::Int(0L))
    let iter_fn = v.alloc_native(fn(vm_in, _a) {
      let cur_pos = match vm_in.tables[state_tid].raw_get(LuaValue::Int(1L)) {
        LuaValue::Int(p) => p.to_int()
        _ => 0
      }
      if cur_pos > s.length() {
        return Ok([LuaValue::Nil])
      }
      match pat_search(vm_in, s, pat, cur_pos) {
        Ok(Some((ms, me, caps))) => {
          let next_pos = if me == cur_pos { me + 1 } else { me }
          let _ = vm_in.tables[state_tid].raw_set(LuaValue::Int(1L), LuaValue::Int(next_pos.to_int64()))
          if caps.length() > 0 {
            Ok(caps)
          } else {
            Ok([LuaValue::Str(s.slice(ms, me))])
          }
        }
        Ok(None) => {
          let _ = vm_in.tables[state_tid].raw_set(LuaValue::Int(1L), LuaValue::Int((s.length() + 1).to_int64()))
          Ok([LuaValue::Nil])
        }
        Err(e) => Err(e)
      }
    })
    Ok([iter_fn])
  })

  reg_tbl_fn(vm, str_lib, "gsub", fn(v, args) {
    if args.length() < 3 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'string.gsub'", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => lua_value_to_string_raw(args[0])
    }
    let pat = match args[1] {
      LuaValue::Str(pv) => pv
      _ => lua_value_to_string_raw(args[1])
    }
    let repl = args[2]
    let max_n = if args.length() >= 4 && !args[3].is_nil() {
      match to_lua_int(args[3]) {
        Some(k) => k.to_int()
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      s.length() + 1
    }
    let sb = StringBuilder::new()
    let slen = s.length()
    let mut pos = 0
    let mut count = 0
    let mut last_match_end = -1
    let anchored = pat.length() > 0 && string_to_bytes(pat)[0].to_int() == 94

    while count < max_n && pos <= slen {
      match pat_search(v, s, pat, pos) {
        Ok(Some((ms, me, caps))) => {
          if ms == me && me == last_match_end {
            if pos < slen {
              sb.write_string(s.slice(pos, pos + 1))
              pos = pos + 1
              continue
            } else {
              break
            }
          }
          if ms > pos {
            sb.write_string(s.slice(pos, ms))
          }
          count = count + 1
          last_match_end = me
          let rep_str = match repl {
            LuaValue::Str(rstr) => {
              match pat_expand_repl(rstr, s, ms, me, caps) {
                Ok(ex) => ex
                Err(e) => return Err(e)
              }
            }
            LuaValue::Table(_) => {
              let key = if caps.length() > 0 { caps[0] } else { LuaValue::Str(s.slice(ms, me)) }
              match v.index_get(repl, key) {
                Ok(rv) => {
                  if rv.is_truthy() {
                    lua_value_to_string_raw(rv)
                  } else {
                    s.slice(ms, me)
                  }
                }
                Err(e) => return Err(e)
              }
            }
            _ => {
              let fargs = if caps.length() > 0 { caps } else { [LuaValue::Str(s.slice(ms, me))] }
              match v.call_value(repl, fargs) {
                Ok(fres) => {
                  if fres.length() > 0 && fres[0].is_truthy() {
                    lua_value_to_string_raw(fres[0])
                  } else {
                    s.slice(ms, me)
                  }
                }
                Err(e) => return Err(e)
              }
            }
          }
          sb.write_string(rep_str)
          if me == ms {
            if pos < slen {
              sb.write_string(s.slice(pos, pos + 1))
              pos = pos + 1
            } else {
              break
            }
          } else {
            pos = me
          }
          if anchored {
            break
          }
        }
        Ok(None) => break
        Err(e) => return Err(e)
      }
    }
    if pos < slen {
      sb.write_string(s.slice(pos, slen))
    }
    let out_s = sb.to_string()
    match v.charge_mem(out_s.length()) {
      Ok(_) => Ok([LuaValue::Str(out_s), LuaValue::Int(count.to_int64())])
      Err(e) => Err(e)
    }
  })

  reg_tbl_fn(vm, str_lib, "format", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected in 'string.format'", 0))
    }
    let fmt = match args[0] {
      LuaValue::Str(s) => s
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected in 'string.format'", 0))
    }
    let bs = string_to_bytes(fmt)
    let n = bs.length()
    let sb = StringBuilder::new()
    let mut i = 0
    let mut arg_i = 1
    while i < n {
      let b = bs[i].to_int()
      if b != 37 {
        let start = i
        while i < n && bs[i].to_int() != 37 {
          i = i + 1
        }
        sb.write_string(fmt.slice(start, i))
        continue
      }
      i = i + 1
      if i >= n {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid format string", 0))
      }
      if bs[i].to_int() == 37 {
        sb.write_string("%")
        i = i + 1
        continue
      }
      // Flags: -, +, space, 0
      let mut left_align = false
      let mut zero_pad = false
      let mut plus_sign = false
      while i < n {
        let fc = bs[i].to_int()
        if fc == 45 {
          left_align = true
          i = i + 1
        } else if fc == 48 {
          zero_pad = true
          i = i + 1
        } else if fc == 43 {
          plus_sign = true
          i = i + 1
        } else if fc == 32 || fc == 35 {
          i = i + 1
        } else {
          break
        }
      }
      // Width
      let mut width = 0
      while i < n && bs[i].to_int() >= 48 && bs[i].to_int() <= 57 {
        width = width * 10 + (bs[i].to_int() - 48)
        i = i + 1
      }
      // Precision
      let mut prec = -1
      if i < n && bs[i].to_int() == 46 {
        i = i + 1
        prec = 0
        while i < n && bs[i].to_int() >= 48 && bs[i].to_int() <= 57 {
          prec = prec * 10 + (bs[i].to_int() - 48)
          i = i + 1
        }
      }
      if i >= n {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid format specifier", 0))
      }
      let spec = bs[i].to_int()
      i = i + 1
      let aval = if arg_i < args.length() { args[arg_i] } else { LuaValue::Nil }
      arg_i = arg_i + 1

      let raw = if spec == 115 {
        // %s
        match v.value_to_string(aval) {
          Ok(sv) => if prec >= 0 && prec < sv.length() { sv.slice(0, prec) } else { sv }
          Err(e) => return Err(e)
        }
      } else if spec == 100 || spec == 105 {
        // %d / %i
        let iv = match to_lua_int(aval) {
          Some(k) => k
          None => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %d", 0))
        }
        let s = format_int_base(iv, 10, false, false)
        if plus_sign && iv >= 0L { "+" + s } else { s }
      } else if spec == 117 {
        let iv = match to_lua_int(aval) {
          Some(k) => k
          None => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %u", 0))
        }
        format_int_base(iv, 10, false, true)
      } else if spec == 120 || spec == 88 {
        let iv = match to_lua_int(aval) {
          Some(k) => k
          None => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %x", 0))
        }
        format_int_base(iv, 16, spec == 88, true)
      } else if spec == 111 {
        let iv = match to_lua_int(aval) {
          Some(k) => k
          None => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %o", 0))
        }
        format_int_base(iv, 8, false, true)
      } else if spec == 102 {
        let fv = match to_lua_number(aval) {
          Some(LuaValue::Float(f)) => f
          Some(LuaValue::Int(k)) => k.to_double()
          _ => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %f", 0))
        }
        format_fixed_f64(fv, if prec >= 0 { prec } else { 6 })
      } else if spec == 103 || spec == 71 || spec == 101 || spec == 69 {
        let fv = match to_lua_number(aval) {
          Some(LuaValue::Float(f)) => f
          Some(LuaValue::Int(k)) => k.to_double()
          _ => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for float format", 0))
        }
        fv.to_string()
      } else if spec == 99 {
        let iv = match to_lua_int(aval) {
          Some(k) => k.to_int() & 0xFF
          None => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %c", 0))
        }
        match utf8_bytes_to_string(bytes_from_array([iv.to_byte()])) {
          Some(cs) => cs
          None => ""
        }
      } else if spec == 113 {
        match aval {
          LuaValue::Str(sv) => "\"" + sv + "\""
          _ => lua_value_to_string_raw(aval)
        }
      } else {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid format option", 0))
      }

      if width > raw.length() {
        let pad_len = width - raw.length()
        let pad_ch = if zero_pad && !left_align { "0" } else { " " }
        if left_align {
          sb.write_string(raw)
          let mut p = 0
          while p < pad_len {
            sb.write_string(" ")
            p = p + 1
          }
        } else {
          let mut p = 0
          while p < pad_len {
            sb.write_string(pad_ch)
            p = p + 1
          }
          sb.write_string(raw)
        }
      } else {
        sb.write_string(raw)
      }
    }
    Ok([LuaValue::Str(sb.to_string())])
  })

  // ---------------- math ----------------
  let math_lib = match vm.alloc_table() {
    Ok(id) => id
    Err(_) => return
  }
  let _ = vm.tables[g].raw_set(LuaValue::Str("math"), LuaValue::Table(math_lib))
  let _ = vm.tables[math_lib].raw_set(LuaValue::Str("pi"), LuaValue::Float(3.14159265358979323846264338327950288))
  let _ = vm.tables[math_lib].raw_set(LuaValue::Str("huge"), LuaValue::Float(1.0 / 0.0))
  let _ = vm.tables[math_lib].raw_set(LuaValue::Str("maxinteger"), LuaValue::Int(9223372036854775807L))
  let _ = vm.tables[math_lib].raw_set(LuaValue::Str("mininteger"), LuaValue::Int(-9223372036854775807L - 1L))

  reg_tbl_fn(vm, math_lib, "abs", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Int(if n < 0L { 0L - n } else { n })])
      Some(LuaValue::Float(f)) => Ok([LuaValue::Float(f64_abs(f))])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "floor", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Int(n)])
      Some(LuaValue::Float(f)) => {
        let fl = f64_floor(f)
        match f64_to_exact_i64(fl) {
          Some(n) => Ok([LuaValue::Int(n)])
          None => Ok([LuaValue::Float(fl)])
        }
      }
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "ceil", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Int(n)])
      Some(LuaValue::Float(f)) => {
        let cl = f64_ceil(f)
        match f64_to_exact_i64(cl) {
          Some(n) => Ok([LuaValue::Int(n)])
          None => Ok([LuaValue::Float(cl)])
        }
      }
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "min", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "value expected in 'math.min'", 0))
    }
    let mut best = args[0]
    let mut i = 1
    while i < args.length() {
      match v.lua_lt(args[i], best) {
        Ok(true) => best = args[i]
        Ok(false) => ()
        Err(e) => return Err(e)
      }
      i = i + 1
    }
    Ok([best])
  })

  reg_tbl_fn(vm, math_lib, "max", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "value expected in 'math.max'", 0))
    }
    let mut best = args[0]
    let mut i = 1
    while i < args.length() {
      match v.lua_lt(best, args[i]) {
        Ok(true) => best = args[i]
        Ok(false) => ()
        Err(e) => return Err(e)
      }
      i = i + 1
    }
    Ok([best])
  })

  reg_tbl_fn(vm, math_lib, "sqrt", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Float(f64_sqrt(n.to_double()))])
      Some(LuaValue::Float(f)) => Ok([LuaValue::Float(f64_sqrt(f))])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "sin", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Float(f64_sin(n.to_double()))])
      Some(LuaValue::Float(f)) => Ok([LuaValue::Float(f64_sin(f))])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "cos", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Float(f64_cos(n.to_double()))])
      Some(LuaValue::Float(f)) => Ok([LuaValue::Float(f64_cos(f))])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "exp", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Float(f64_exp(n.to_double()))])
      Some(LuaValue::Float(f)) => Ok([LuaValue::Float(f64_exp(f))])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "log", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    let fx = match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => n.to_double()
      Some(LuaValue::Float(f)) => f
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    if args.length() >= 2 && !args[1].is_nil() {
      let fb = match to_lua_number(args[1]) {
        Some(LuaValue::Int(n)) => n.to_double()
        Some(LuaValue::Float(f)) => f
        _ => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for base", 0))
      }
      Ok([LuaValue::Float(f64_ln(fx) / f64_ln(fb))])
    } else {
      Ok([LuaValue::Float(f64_ln(fx))])
    }
  })

  reg_tbl_fn(vm, math_lib, "fmod", fn(_v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "numbers expected", 0))
    }
    match (to_lua_number(args[0]), to_lua_number(args[1])) {
      (Some(LuaValue::Int(x)), Some(LuaValue::Int(y))) => {
        if y == 0L {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "zero in math.fmod", 0))
        }
        Ok([LuaValue::Int(x % y)])
      }
      (Some(nx), Some(ny)) => {
        let fx = match nx {
          LuaValue::Float(f) => f
          LuaValue::Int(n) => n.to_double()
          _ => 0.0
        }
        let fy = match ny {
          LuaValue::Float(f) => f
          LuaValue::Int(n) => n.to_double()
          _ => 0.0
        }
        Ok([LuaValue::Float(f64_fmod(fx, fy))])
      }
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "numbers expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "modf", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Int(n), LuaValue::Float(0.0)])
      Some(LuaValue::Float(f)) => {
        let t = f64_trunc(f)
        let frac = if !f64_is_finite(f) { 0.0 } else { f - t }
        match f64_to_exact_i64(t) {
          Some(n) => Ok([LuaValue::Int(n), LuaValue::Float(frac)])
          None => Ok([LuaValue::Float(t), LuaValue::Float(frac)])
        }
      }
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "type", fn(_v, args) {
    if args.length() == 0 {
      return Ok([LuaValue::Nil])
    }
    match args[0] {
      LuaValue::Int(_) => Ok([LuaValue::Str("integer")])
      LuaValue::Float(_) => Ok([LuaValue::Str("float")])
      _ => Ok([LuaValue::Nil])
    }
  })

  reg_tbl_fn(vm, math_lib, "tointeger", fn(_v, args) {
    if args.length() == 0 {
      return Ok([LuaValue::Nil])
    }
    match to_lua_int(args[0]) {
      Some(n) => Ok([LuaValue::Int(n)])
      None => Ok([LuaValue::Nil])
    }
  })

  reg_tbl_fn(vm, math_lib, "ult", fn(_v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "integers expected", 0))
    }
    match (to_lua_int(args[0]), to_lua_int(args[1])) {
      (Some(a), Some(b)) => Ok([LuaValue::Bool(a.reinterpret_as_uint64() < b.reinterpret_as_uint64())])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "integers expected", 0))
    }
  })

  // ---------------- utf8 ----------------
  let utf8_lib = match vm.alloc_table() {
    Ok(id) => id
    Err(_) => return
  }
  let _ = vm.tables[g].raw_set(LuaValue::Str("utf8"), LuaValue::Table(utf8_lib))

  reg_tbl_fn(vm, utf8_lib, "len", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let bs = string_to_bytes(s)
    let n = bs.length()
    let mut i = if args.length() >= 2 && !args[1].is_nil() {
      match to_lua_int(args[1]) {
        Some(k) => lua_str_pos(k.to_int(), n) - 1
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      0
    }
    let j = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => lua_str_pos(k.to_int(), n)
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      n
    }
    if i < 0 {
      i = 0
    }
    let mut count = 0
    while i < j && i < n {
      match utf8_decode_at(bs, i) {
        Some((_, step)) => {
          i = i + step
          count = count + 1
        }
        None => return Ok([LuaValue::Nil, LuaValue::Int((i + 1).to_int64())])
      }
    }
    Ok([LuaValue::Int(count.to_int64())])
  })

  reg_tbl_fn(vm, utf8_lib, "codepoint", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let bs = string_to_bytes(s)
    let n = bs.length()
    let mut i = if args.length() >= 2 && !args[1].is_nil() {
      match to_lua_int(args[1]) {
        Some(k) => lua_str_pos(k.to_int(), n) - 1
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      0
    }
    let j = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => lua_str_pos(k.to_int(), n)
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      i + 1
    }
    let out : Array[LuaValue] = []
    while i < j && i < n {
      match utf8_decode_at(bs, i) {
        Some((cp, step)) => {
          out.push(LuaValue::Int(cp.to_int64()))
          i = i + step
        }
        None => return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid UTF-8 code", 0))
      }
    }
    Ok(out)
  })

  reg_tbl_fn(vm, utf8_lib, "char", fn(_v, args) {
    let out : Array[Byte] = []
    let mut i = 0
    while i < args.length() {
      let cp = match to_lua_int(args[i]) {
        Some(k) => k.to_int()
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
      if cp < 0 || cp > 0x10FFFF {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "codepoint out of range", 0))
      }
      push_utf8_cp(out, cp)
      i = i + 1
    }
    match utf8_bytes_to_string(bytes_from_array(out)) {
      Some(s) => Ok([LuaValue::Str(s)])
      None => Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid UTF-8", 0))
    }
  })

  let utf8_iter = vm.alloc_native(fn(_v, args) {
    if args.length() < 2 {
      return Ok([LuaValue::Nil])
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => return Ok([LuaValue::Nil])
    }
    let bs = string_to_bytes(s)
    let n = bs.length()
    let pos = match args[1] {
      LuaValue::Int(p) => {
        let p0 = p.to_int() - 1
        if p0 < 0 {
          0
        } else {
          match utf8_decode_at(bs, p0) {
            Some((_, step)) => p0 + step
            None => n
          }
        }
      }
      _ => 0
    }
    if pos >= n {
      return Ok([LuaValue::Nil])
    }
    match utf8_decode_at(bs, pos) {
      Some((cp, _)) => Ok([LuaValue::Int((pos + 1).to_int64()), LuaValue::Int(cp.to_int64())])
      None => Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid UTF-8 code", 0))
    }
  })
  reg_tbl_fn(vm, utf8_lib, "codes", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    Ok([utf8_iter, args[0], LuaValue::Nil])
  })

  reg_tbl_fn(vm, utf8_lib, "offset", fn(_v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'utf8.offset'", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let mut n_chars = match to_lua_int(args[1]) {
      Some(k) => k.to_int()
      None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
    }
    let bs = string_to_bytes(s)
    let slen = bs.length()
    let mut i = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => lua_str_pos(k.to_int(), slen) - 1
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else if n_chars >= 0 {
      0
    } else {
      slen
    }
    if n_chars == 0 {
      while i > 0 && (bs[i].to_int() & 0xC0) == 0x80 {
        i = i - 1
      }
      return Ok([LuaValue::Int((i + 1).to_int64())])
    }
    if n_chars > 0 {
      n_chars = n_chars - 1
      while n_chars > 0 && i < slen {
        match utf8_decode_at(bs, i) {
          Some((_, step)) => {
            i = i + step
            n_chars = n_chars - 1
          }
          None => return Ok([LuaValue::Nil])
        }
      }
      if n_chars == 0 {
        Ok([LuaValue::Int((i + 1).to_int64())])
      } else {
        Ok([LuaValue::Nil])
      }
    } else {
      while n_chars < 0 && i > 0 {
        i = i - 1
        while i > 0 && (bs[i].to_int() & 0xC0) == 0x80 {
          i = i - 1
        }
        n_chars = n_chars + 1
      }
      if n_chars == 0 {
        Ok([LuaValue::Int((i + 1).to_int64())])
      } else {
        Ok([LuaValue::Nil])
      }
    }
  })
}
