        i = i + 1
      }
      // Precision (Lua 5.4 allows at most 2 digits, 0..99)
      let mut prec = -1
      if i < n && fmt.code_unit_at(i).to_int() == 46 {
        has_mod = true
        i = i + 1
        prec = 0
        let mut p_digits = 0
        while i < n && fmt.code_unit_at(i).to_int() >= 48 && fmt.code_unit_at(i).to_int() <= 57 {
          p_digits = p_digits + 1
          if p_digits > 2 {
            return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid format (width or precision too long)", 0))
          }
          prec = prec * 10 + (fmt.code_unit_at(i).to_int() - 48)
          i = i + 1
        }
      }
      if i >= n {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid format specifier", 0))
      }
      let spec = fmt.code_unit_at(i).to_int()
      i = i + 1
      if arg_i >= args.length() {
        return Err(LuaError::new(LuaErrorKind::TypeError, "bad argument #" + (arg_i + 1).to_string() + " to 'format' (no value)", 0))
      }
      let aval = args[arg_i]
      arg_i = arg_i + 1

      // Build `(sign_or_prefix, body)` so `0`-padding inserts zeros AFTER sign/0x prefix
      let mut prefix = ""
      let mut body = ""
      let mut is_numeric = false

      if spec == 115 {
        // %s
        let sv = match v.value_to_string(aval) {
          Ok(s_val) => s_val
          Err(e) => return Err(e)
        }
        if has_mod {
          // Lua 5.4 rejects embedded NUL in %s when width/precision/flags are present
          let mut k = 0
          while k < sv.length() {
            if sv.code_unit_at(k).to_int() == 0 {
              return Err(LuaError::new(LuaErrorKind::RuntimeError, "bad argument to 'format' (string contains zeros)", 0))
            }
            k = k + 1
          }
        }
        body = if prec >= 0 && prec < sv.length() { sv.slice(0, prec) } else { sv }
      } else if spec == 100 || spec == 105 {
        // %d / %i
        is_numeric = true
        let iv = match to_lua_int(aval) {
          Some(k) => k
          None => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %d", 0))
        }
        let raw_s = iv.to_string()
        if iv < 0L {
          prefix = "-"
          body = raw_s.slice(1, raw_s.length())
        } else {
          if plus_sign {
            prefix = "+"
          } else if space_sign {
            prefix = " "
          }
          body = raw_s
        }
        if prec >= 0 {
          if prec == 0 && iv == 0L {
            body = ""
          } else if prec > body.length() {
            let psb = StringBuilder::new()
            let mut z = prec - body.length()
            while z > 0 {
              psb.write_string("0")
              z = z - 1
            }
            psb.write_string(body)
            body = psb.to_string()
          }
          zero_pad = false
        }
      } else if spec == 117 {
        is_numeric = true
        let iv = match to_lua_int(aval) {
          Some(k) => k
          None => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %u", 0))
        }
        body = format_int_base(iv, 10, false, true)
      } else if spec == 120 || spec == 88 {
        is_numeric = true
        let iv = match to_lua_int(aval) {
          Some(k) => k
          None => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %x", 0))
        }
        body = format_int_base(iv, 16, spec == 88, true)
        if alt_form && iv != 0L {
          prefix = if spec == 88 { "0X" } else { "0x" }
        }
      } else if spec == 111 {
        is_numeric = true
        let iv = match to_lua_int(aval) {
          Some(k) => k
          None => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %o", 0))
        }
        body = format_int_base(iv, 8, false, true)
        if alt_form && iv != 0L {
          prefix = "0"
        }
      } else if spec == 102 {
        is_numeric = true
        let fv = match to_lua_number(aval) {
          Some(LuaValue::Float(f)) => f
          Some(LuaValue::Int(k)) => k.to_double()
          _ => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %f", 0))
        }
        let (neg, bstr) = format_f64_fixed(fv, if prec >= 0 { prec } else { 6 }, alt_form)
        if neg {
          prefix = "-"
        } else if plus_sign {
          prefix = "+"
        } else if space_sign {
          prefix = " "
        }
        body = bstr
      } else if spec == 101 || spec == 69 {
        is_numeric = true
        let fv = match to_lua_number(aval) {
          Some(LuaValue::Float(f)) => f
          Some(LuaValue::Int(k)) => k.to_double()
          _ => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %e", 0))
        }
        let (neg, bstr) = format_f64_sci(fv, if prec >= 0 { prec } else { 6 }, spec == 69, alt_form)
        if neg {
          prefix = "-"
        } else if plus_sign {
          prefix = "+"
        } else if space_sign {
          prefix = " "
        }
        body = bstr
      } else if spec == 103 || spec == 71 {
        is_numeric = true
        let fv = match to_lua_number(aval) {
          Some(LuaValue::Float(f)) => f
          Some(LuaValue::Int(k)) => k.to_double()
          _ => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %g", 0))
        }
        let (neg, bstr) = format_f64_general(fv, if prec >= 0 { prec } else { 6 }, spec == 71, alt_form)
        if neg {
          prefix = "-"
        } else if plus_sign {
          prefix = "+"
        } else if space_sign {
          prefix = " "
        }
        body = bstr
      } else if spec == 97 || spec == 65 {
        is_numeric = true
        let fv = match to_lua_number(aval) {
          Some(LuaValue::Float(f)) => f
          Some(LuaValue::Int(k)) => k.to_double()
          _ => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %a", 0))
        }
        let (neg, bstr) = format_f64_hex(fv, prec, spec == 65, alt_form)
        if neg {
          prefix = "-"
        } else if plus_sign {
          prefix = "+"
        } else if space_sign {
          prefix = " "
        }
        body = bstr
      } else if spec == 99 {
        let iv = match to_lua_int(aval) {
          Some(k) => k.to_int() & 0xFF
          None => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for %c", 0))
        }
        match utf8_bytes_to_string(bytes_from_array([iv.to_byte()])) {
          Some(cs) => body = cs
          None => body = ""
        }
      } else if spec == 113 {
        if has_mod {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "specifier '%q' cannot have modifiers", 0))
        }
        match aval {
          LuaValue::Str(sv) => {
            let qsb = StringBuilder::new()
            qsb.write_string("\"")
            let slen = sv.length()
            let mut k = 0
            while k < slen {
              let ch = sv.code_unit_at(k).to_int()
              if ch == 34 || ch == 92 || ch == 10 {
                qsb.write_string("\\")
                qsb.write_byte(ch.to_byte())
              } else if ch < 32 || ch == 127 {
                // Escape control character as \ddd if followed by ASCII digit, else \d
                let next_is_digit = k + 1 < slen && sv.code_unit_at(k + 1).to_int() >= 48 && sv.code_unit_at(k + 1).to_int() <= 57
                qsb.write_string("\\")
                if next_is_digit {
                  if ch < 10 {
                    qsb.write_string("00")
                  } else if ch < 100 {
                    qsb.write_string("0")
                  }
                }
                qsb.write_string(ch.to_string())
              } else {
                qsb.write_byte(ch.to_byte())
              }
              k = k + 1
            }
            qsb.write_string("\"")
            body = qsb.to_string()
          }
          LuaValue::Int(iv) => {
            if iv == -9223372036854775807L - 1L {
              body = "0x8000000000000000"
            } else {
              body = iv.to_string()
            }
          }
          LuaValue::Float(fv) => {
            if fv != fv {
              body = "(0/0)"
            } else if fv == 1.0 / 0.0 {
              body = "1e9999"
            } else if fv == -1.0 / 0.0 {
              body = "-1e9999"
            } else {
              let (neg, hstr) = format_f64_hex(fv, -1, false, false)
              body = if neg { "-" + hstr } else { hstr }
            }
          }
          LuaValue::Bool(bv) => body = if bv { "true" } else { "false" }
          LuaValue::Nil => body = "nil"
          _ => return Err(LuaError::new(LuaErrorKind::TypeError, "value has no literal form", 0))
        }
      } else {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid format option", 0))
      }

      let raw_len = prefix.length() + body.length()
      let out_len = if width > raw_len { width } else { raw_len }
      match v.charge_mem(out_len) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if width > raw_len {
        let pad_len = width - raw_len
        if left_align {
          sb.write_string(prefix)
          sb.write_string(body)
          let mut p = 0
          while p < pad_len {
            sb.write_string(" ")
            p = p + 1
          }
        } else if zero_pad && is_numeric {
          sb.write_string(prefix)
          let mut p = 0
          while p < pad_len {
            sb.write_string("0")
            p = p + 1
          }
          sb.write_string(body)
        } else {
          let mut p = 0
          while p < pad_len {
            sb.write_string(" ")
            p = p + 1
          }
          sb.write_string(prefix)
          sb.write_string(body)
        }
      } else {
        sb.write_string(prefix)
        sb.write_string(body)
      }
    }
    Ok([LuaValue::Str(sb.to_string())])
  })

  register_string_pack(vm, str_lib)

  // ---------------- math ----------------
  let math_lib = match vm.alloc_table() {
    Ok(id) => id
    Err(_) => return
  }
  let _ = vm.tables[g].raw_set(LuaValue::Str("math"), LuaValue::Table(math_lib))
  let _ = vm.tables[math_lib].raw_set(LuaValue::Str("pi"), LuaValue::Float(3.14159265358979323846264338327950288))
  let _ = vm.tables[math_lib].raw_set(LuaValue::Str("huge"), LuaValue::Float(1.0 / 0.0))
  let _ = vm.tables[math_lib].raw_set(LuaValue::Str("maxinteger"), LuaValue::Int(9223372036854775807L))
  let _ = vm.tables[math_lib].raw_set(LuaValue::Str("mininteger"), LuaValue::Int(-9223372036854775807L - 1L))

  reg_tbl_fn(vm, math_lib, "abs", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Int(if n < 0L { 0L - n } else { n })])
      Some(LuaValue::Float(f)) => Ok([LuaValue::Float(f64_abs(f))])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "floor", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Int(n)])
      Some(LuaValue::Float(f)) => {
        let fl = f64_floor(f)
        match f64_to_exact_i64(fl) {
          Some(n) => Ok([LuaValue::Int(n)])
          None => Ok([LuaValue::Float(fl)])
        }
      }
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "ceil", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Int(n)])
      Some(LuaValue::Float(f)) => {
        let cl = f64_ceil(f)
        match f64_to_exact_i64(cl) {
          Some(n) => Ok([LuaValue::Int(n)])
          None => Ok([LuaValue::Float(cl)])
        }
      }
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "min", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "value expected in 'math.min'", 0))
    }
    let mut best = args[0]
    let mut i = 1
    while i < args.length() {
      match v.lua_lt(args[i], best) {
        Ok(true) => best = args[i]
        Ok(false) => ()
        Err(e) => return Err(e)
      }
      i = i + 1
    }
    Ok([best])
  })

  reg_tbl_fn(vm, math_lib, "max", fn(v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "value expected in 'math.max'", 0))
    }
    let mut best = args[0]
    let mut i = 1
    while i < args.length() {
      match v.lua_lt(best, args[i]) {
        Ok(true) => best = args[i]
        Ok(false) => ()
        Err(e) => return Err(e)
      }
      i = i + 1
    }
    Ok([best])
  })

