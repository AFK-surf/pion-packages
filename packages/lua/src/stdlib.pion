    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Float(n.to_double() * 0.0174532925199432957692)])
      Some(LuaValue::Float(f)) => Ok([LuaValue::Float(f * 0.0174532925199432957692)])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "randomseed", fn(v, args) {
    let s1 = if args.length() >= 1 && !args[0].is_nil() {
      match to_lua_int(args[0]) {
        Some(k) => k.reinterpret_as_uint64()
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      0x123456789ABCDEF0UL
    }
    let s2 = if args.length() >= 2 && !args[1].is_nil() {
      match to_lua_int(args[1]) {
        Some(k) => k.reinterpret_as_uint64()
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      0UL
    }
    v.rng_s0 = s1
    v.rng_s1 = 0xFFUL
    v.rng_s2 = s2
    v.rng_s3 = 0UL
    let mut k = 0
    while k < 16 {
      let _ = v.rng_next()
      k = k + 1
    }
    Ok([LuaValue::Int(s1.reinterpret_as_int64()), LuaValue::Int(s2.reinterpret_as_int64())])
  })

  reg_tbl_fn(vm, math_lib, "random", fn(v, args) {
    let r = v.rng_next()
    if args.length() == 0 {
      // Float in [0, 1) using top 53 bits
      let f = (r >> 11).reinterpret_as_int64().to_double() * (1.0 / 9007199254740992.0)
      return Ok([LuaValue::Float(f)])
    }
    let lo : Int64 = if args.length() == 1 {
      1L
    } else {
      match to_lua_int(args[0]) {
        Some(k) => k
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    }
    let hi : Int64 = if args.length() == 1 {
      match to_lua_int(args[0]) {
        Some(k) => k
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else if args.length() == 2 {
      match to_lua_int(args[1]) {
        Some(k) => k
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "wrong number of arguments to 'random'", 0))
    }
    if args.length() == 1 && hi == 0L {
      return Ok([LuaValue::Int(r.reinterpret_as_int64())])
    }
    if lo > hi {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "interval is empty", 0))
    }
    let span = hi.reinterpret_as_uint64() - lo.reinterpret_as_uint64()
    if span == 0xFFFFFFFFFFFFFFFFUL {
      return Ok([LuaValue::Int(r.reinterpret_as_int64())])
    }
    let res = lo.reinterpret_as_uint64() + (r % (span + 1UL))
    Ok([LuaValue::Int(res.reinterpret_as_int64())])
  })

  reg_tbl_fn(vm, math_lib, "exp", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Float(f64_exp(n.to_double()))])
      Some(LuaValue::Float(f)) => Ok([LuaValue::Float(f64_exp(f))])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "log", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    let fx = match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => n.to_double()
      Some(LuaValue::Float(f)) => f
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    if args.length() >= 2 && !args[1].is_nil() {
      let fb = match to_lua_number(args[1]) {
        Some(LuaValue::Int(n)) => n.to_double()
        Some(LuaValue::Float(f)) => f
        _ => return Err(LuaError::new(LuaErrorKind::TypeError, "number expected for base", 0))
      }
      Ok([LuaValue::Float(f64_ln(fx) / f64_ln(fb))])
    } else {
      Ok([LuaValue::Float(f64_ln(fx))])
    }
  })

  reg_tbl_fn(vm, math_lib, "fmod", fn(_v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "numbers expected", 0))
    }
    match (to_lua_number(args[0]), to_lua_number(args[1])) {
      (Some(LuaValue::Int(x)), Some(LuaValue::Int(y))) => {
        if y == 0L {
          return Err(LuaError::new(LuaErrorKind::RuntimeError, "zero in math.fmod", 0))
        }
        let min_i64 = -9223372036854775807L - 1L
        if x == min_i64 && y == -1L {
          return Ok([LuaValue::Int(0L)])
        }
        Ok([LuaValue::Int(x % y)])
      }
      (Some(nx), Some(ny)) => {
        let fx = match nx {
          LuaValue::Float(f) => f
          LuaValue::Int(n) => n.to_double()
          _ => 0.0
        }
        let fy = match ny {
          LuaValue::Float(f) => f
          LuaValue::Int(n) => n.to_double()
          _ => 0.0
        }
        Ok([LuaValue::Float(f64_fmod(fx, fy))])
      }
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "numbers expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "modf", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
    match to_lua_number(args[0]) {
      Some(LuaValue::Int(n)) => Ok([LuaValue::Int(n), LuaValue::Float(0.0)])
      Some(LuaValue::Float(f)) => {
        let t = f64_trunc(f)
        let frac = if !f64_is_finite(f) { 0.0 } else { f - t }
        match f64_to_exact_i64(t) {
          Some(n) => Ok([LuaValue::Int(n), LuaValue::Float(frac)])
          None => Ok([LuaValue::Float(t), LuaValue::Float(frac)])
        }
      }
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "number expected", 0))
    }
  })

  reg_tbl_fn(vm, math_lib, "type", fn(_v, args) {
    if args.length() == 0 {
      return Ok([LuaValue::Nil])
    }
    match args[0] {
      LuaValue::Int(_) => Ok([LuaValue::Str("integer")])
      LuaValue::Float(_) => Ok([LuaValue::Str("float")])
      _ => Ok([LuaValue::Nil])
    }
  })

  reg_tbl_fn(vm, math_lib, "tointeger", fn(_v, args) {
    if args.length() == 0 {
      return Ok([LuaValue::Nil])
    }
    match to_lua_int(args[0]) {
      Some(n) => Ok([LuaValue::Int(n)])
      None => Ok([LuaValue::Nil])
    }
  })

  reg_tbl_fn(vm, math_lib, "ult", fn(_v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "integers expected", 0))
    }
    match (to_lua_int(args[0]), to_lua_int(args[1])) {
      (Some(a), Some(b)) => Ok([LuaValue::Bool(a.reinterpret_as_uint64() < b.reinterpret_as_uint64())])
      _ => Err(LuaError::new(LuaErrorKind::TypeError, "integers expected", 0))
    }
  })

  // ---------------- utf8 ----------------
  let utf8_lib = match vm.alloc_table() {
    Ok(id) => id
    Err(_) => return
  }
  let _ = vm.tables[g].raw_set(LuaValue::Str("utf8"), LuaValue::Table(utf8_lib))
  // Lua 5.4 `utf8.charpattern` = "[\0-\x7F\xC2-\xFD][\x80-\xBF]*"
  let cp_bytes : Array[Byte] = [
    (91).to_byte(),
    (0).to_byte(),
    (45).to_byte(),
    (0x7F).to_byte(),
    (0xC2).to_byte(),
    (45).to_byte(),
    (0xFD).to_byte(),
    (93).to_byte(),
    (91).to_byte(),
    (0x80).to_byte(),
    (45).to_byte(),
    (0xBF).to_byte(),
    (93).to_byte(),
    (42).to_byte(),
  ]
  match utf8_bytes_to_string(bytes_from_array(cp_bytes)) {
    Some(cp_str) => {
      let _ = vm.tables[utf8_lib].raw_set(LuaValue::Str("charpattern"), LuaValue::Str(cp_str))
    }
    None => ()
  }

  reg_tbl_fn(vm, utf8_lib, "len", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let bs = string_to_bytes(s)
    let n = bs.length()
    let raw_i = if args.length() >= 2 && !args[1].is_nil() {
      match to_lua_int(args[1]) {
        Some(k) => if k >= 0L { k } else { n.to_int64() + k + 1L }
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      1L
    }
    if raw_i < 1L || raw_i > (n + 1).to_int64() {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "initial position out of bounds", 0))
    }
    let raw_j = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => if k >= 0L { k } else { n.to_int64() + k + 1L }
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      n.to_int64()
    }
    if raw_j > n.to_int64() {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "final position out of bounds", 0))
    }
    let lax = args.length() >= 4 && args[3].is_truthy()
    let mut i = raw_i.to_int() - 1
    let j = if raw_j < 0L { 0 } else { raw_j.to_int() }
    let mut count = 0
    while i < j && i < n {
      match utf8_decode_at(bs, i, lax) {
        Some((_, step)) => {
          i = i + step
          count = count + 1
        }
        None => return Ok([LuaValue::Nil, LuaValue::Int((i + 1).to_int64())])
      }
    }
    Ok([LuaValue::Int(count.to_int64())])
  })

  reg_tbl_fn(vm, utf8_lib, "codepoint", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let bs = string_to_bytes(s)
    let n = bs.length()
    let raw_i = if args.length() >= 2 && !args[1].is_nil() {
      match to_lua_int(args[1]) {
        Some(k) => if k >= 0L { k } else { n.to_int64() + k + 1L }
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      1L
    }
    let raw_j = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => if k >= 0L { k } else { n.to_int64() + k + 1L }
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else {
      raw_i
    }
    if raw_i < 1L {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "out of bounds", 0))
    }
    if raw_j > n.to_int64() {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "out of bounds", 0))
    }
    let lax = args.length() >= 4 && args[3].is_truthy()
    let mut i = raw_i.to_int() - 1
    let j = raw_j.to_int()
    if i >= j {
      return Ok([])
    }
    let out : Array[LuaValue] = []
    while i < j && i < n {
      match utf8_decode_at(bs, i, lax) {
        Some((cp, step)) => {
          out.push(LuaValue::Int(cp.to_int64()))
          i = i + step
        }
        None => return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid UTF-8 code", 0))
      }
    }
    Ok(out)
  })

  reg_tbl_fn(vm, utf8_lib, "char", fn(_v, args) {
    let out : Array[Byte] = []
    let mut i = 0
    while i < args.length() {
      let cp = match to_lua_int(args[i]) {
        Some(k) => k
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
      // P2-5: Lua 5.4 accepts extended UTF-8 codepoints 0..0x7FFFFFFF
      if cp < 0L || cp > 0x7FFFFFFFL {
        return Err(LuaError::new(LuaErrorKind::RuntimeError, "value out of range", 0))
      }
      push_utf8_cp(out, cp.to_int())
      i = i + 1
    }
    match utf8_bytes_to_string(bytes_from_array(out)) {
      Some(s) => Ok([LuaValue::Str(s)])
      None => Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid UTF-8", 0))
    }
  })

  let utf8_iter = vm.alloc_native(fn(_v, args) {
    if args.length() < 2 {
      return Ok([LuaValue::Nil])
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => return Ok([LuaValue::Nil])
    }
    let bs = string_to_bytes(s)
    let n = bs.length()
    let pos = match args[1] {
      LuaValue::Int(p) => {
        let p0 = p.to_int() - 1
        if p0 < 0 {
          0
        } else {
          match utf8_decode_at(bs, p0, false) {
            Some((_, step)) => p0 + step
            None => n
          }
        }
      }
      _ => 0
    }
    if pos >= n {
      return Ok([LuaValue::Nil])
    }
    match utf8_decode_at(bs, pos, false) {
      Some((cp, _)) => Ok([LuaValue::Int((pos + 1).to_int64()), LuaValue::Int(cp.to_int64())])
      None => Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid UTF-8 code", 0))
    }
  })
  reg_tbl_fn(vm, utf8_lib, "codes", fn(_v, args) {
    if args.length() == 0 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    Ok([utf8_iter, args[0], LuaValue::Nil])
  })

  reg_tbl_fn(vm, utf8_lib, "offset", fn(_v, args) {
    if args.length() < 2 {
      return Err(LuaError::new(LuaErrorKind::TypeError, "bad arguments to 'utf8.offset'", 0))
    }
    let s = match args[0] {
      LuaValue::Str(sv) => sv
      _ => return Err(LuaError::new(LuaErrorKind::TypeError, "string expected", 0))
    }
    let mut n_chars = match to_lua_int(args[1]) {
      Some(k) => k.to_int()
      None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
    }
    let bs = string_to_bytes(s)
    let slen = bs.length()
    let raw_i = if args.length() >= 3 && !args[2].is_nil() {
      match to_lua_int(args[2]) {
        Some(k) => if k >= 0L { k } else { slen.to_int64() + k + 1L }
        None => return Err(LuaError::new(LuaErrorKind::TypeError, "integer expected", 0))
      }
    } else if n_chars >= 0 {
      1L
    } else {
      (slen + 1).to_int64()
    }
    if raw_i < 1L || raw_i > (slen + 1).to_int64() {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "position out of bounds", 0))
    }
    let mut i = raw_i.to_int() - 1
    if n_chars == 0 {
      while i > 0 && i < slen && (bs[i].to_int() & 0xC0) == 0x80 {
        i = i - 1
      }
      return Ok([LuaValue::Int((i + 1).to_int64())])
    }
    // P2-5: reject continuation byte as initial position when n != 0
    if i < slen && (bs[i].to_int() & 0xC0) == 0x80 {
      return Err(LuaError::new(LuaErrorKind::RuntimeError, "initial position is a continuation byte", 0))
    }
    if n_chars > 0 {
      n_chars = n_chars - 1
      while n_chars > 0 && i < slen {
        i = i + 1
        while i < slen && (bs[i].to_int() & 0xC0) == 0x80 {
          i = i + 1
        }
        n_chars = n_chars - 1
      }
      if n_chars == 0 {
        Ok([LuaValue::Int((i + 1).to_int64())])
      } else {
        Ok([LuaValue::Nil])
      }
    } else {
      while n_chars < 0 && i > 0 {
        i = i - 1
        while i > 0 && (bs[i].to_int() & 0xC0) == 0x80 {
          i = i - 1
        }
        n_chars = n_chars + 1
      }
      if n_chars == 0 {
        Ok([LuaValue::Int((i + 1).to_int64())])
      } else {
        Ok([LuaValue::Nil])
      }
    }
  })
}
