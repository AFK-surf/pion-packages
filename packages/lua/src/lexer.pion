///| Lua 5.4 Lexer supporting short/long strings, all Lua 5.4 escape sequences,
///| decimal/hex integers & floats, line/long comments, keywords, and operators.

///|
enum TokKind {
  Eof
  Ident
  IntLit
  FloatLit
  StrLit
  // Keywords
  KwAnd
  KwBreak
  KwDo
  KwElse
  KwElseif
  KwEnd
  KwFalse
  KwFor
  KwFunction
  KwGoto
  KwIf
  KwIn
  KwLocal
  KwNil
  KwNot
  KwOr
  KwRepeat
  KwReturn
  KwThen
  KwTrue
  KwUntil
  KwWhile
  // Operators & punctuation
  Plus
  Minus
  Star
  Slash
  SlashSlash
  Percent
  Caret
  Hash
  Amp
  Tilde
  Pipe
  Shl
  Shr
  EqEq
  TildeEq
  LtEq
  GtEq
  Lt
  Gt
  Assign
  LParen
  RParen
  LBrace
  RBrace
  LBracket
  RBracket
  DoubleColon
  Semi
  Colon
  Comma
  Dot
  DotDot
  DotDotDot
}

///|
struct Token {
  kind : TokKind
  text : String
  int_val : Int64
  float_val : Double
  line : Int
}

///|
fn tok_simple(kind : TokKind, line : Int) -> Token {
  Token::{ kind: kind, text: "", int_val: 0L, float_val: 0.0, line: line }
}

///|
fn is_lua_ident_start(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

///|
fn is_lua_ident_cont(b : Int) -> Bool {
  is_lua_ident_start(b) || (b >= 48 && b <= 57)
}

///|
fn is_lua_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

///|
fn push_utf8_cp(out : Array[Byte], cp : Int) -> Unit {
  if cp <= 0x7F {
    out.push(cp.to_byte())
  } else if cp <= 0x7FF {
    out.push((0xC0 | (cp >> 6)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0xFFFF {
    out.push((0xE0 | (cp >> 12)).to_byte())
    out.push((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  } else {
    out.push((0xF0 | (cp >> 18)).to_byte())
    out.push((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    out.push((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    out.push((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Check if `src` at `pos` starts a long bracket `[===[`. Returns number of `=` signs or -1.
fn check_long_bracket(src : Bytes, pos : Int) -> Int {
  let n = src.length()
  if pos >= n || src[pos].to_int() != 91 {
    return -1
  }
  let mut i = pos + 1
  let mut eqs = 0
  while i < n && src[i].to_int() == 61 {
    eqs = eqs + 1
    i = i + 1
  }
  if i < n && src[i].to_int() == 91 {
    eqs
  } else {
    -1
  }
}

///| Scan a long string or long comment starting at `[` with `eqs` equals signs.
///| Returns `(content_string, next_pos, new_line)`.
fn scan_long_bracket(
  src : Bytes,
  source : String,
  pos : Int,
  eqs : Int,
  start_line : Int,
) -> Result[(String, Int, Int), LuaError] {
  let n = src.length()
  let mut i = pos + 2 + eqs
  let mut line = start_line
  // Strip immediate newline after opening bracket
  if i < n && (src[i].to_int() == 10 || src[i].to_int() == 13) {
    let c = src[i].to_int()
    i = i + 1
    if i < n && ((c == 13 && src[i].to_int() == 10) || (c == 10 && src[i].to_int() == 13)) {
      i = i + 1
    }
    line = line + 1
  }
  let content_start = i
  while i < n {
    let b = src[i].to_int()
    if b == 93 {
      let mut j = i + 1
      let mut k = 0
      while k < eqs && j < n && src[j].to_int() == 61 {
        j = j + 1
        k = k + 1
      }
      if k == eqs && j < n && src[j].to_int() == 93 {
        let s = source.slice(content_start, i)
        return Ok((s, j + 1, line))
      }
    } else if b == 10 {
      line = line + 1
    } else if b == 13 {
      line = line + 1
      if i + 1 < n && src[i + 1].to_int() == 10 {
        i = i + 1
      }
    }
    i = i + 1
  }
  Err(LuaError::new(LuaErrorKind::SyntaxError, "unfinished long string or comment", start_line))
}

///|
fn keyword_or_ident(s : String) -> TokKind {
  if s == "and" {
    TokKind::KwAnd
  } else if s == "break" {
    TokKind::KwBreak
  } else if s == "do" {
    TokKind::KwDo
  } else if s == "else" {
    TokKind::KwElse
  } else if s == "elseif" {
    TokKind::KwElseif
  } else if s == "end" {
    TokKind::KwEnd
  } else if s == "false" {
    TokKind::KwFalse
  } else if s == "for" {
    TokKind::KwFor
  } else if s == "function" {
    TokKind::KwFunction
  } else if s == "goto" {
    TokKind::KwGoto
  } else if s == "if" {
    TokKind::KwIf
  } else if s == "in" {
    TokKind::KwIn
  } else if s == "local" {
    TokKind::KwLocal
  } else if s == "nil" {
    TokKind::KwNil
  } else if s == "not" {
    TokKind::KwNot
  } else if s == "or" {
    TokKind::KwOr
  } else if s == "repeat" {
    TokKind::KwRepeat
  } else if s == "return" {
    TokKind::KwReturn
  } else if s == "then" {
    TokKind::KwThen
  } else if s == "true" {
    TokKind::KwTrue
  } else if s == "until" {
    TokKind::KwUntil
  } else if s == "while" {
    TokKind::KwWhile
  } else {
    TokKind::Ident
  }
}

///| Tokenize a Lua 5.4 source string.
fn lex_lua(source : String) -> Result[Array[Token], LuaError] {
  let src = string_to_bytes(source)
  let n = src.length()
  let tokens : Array[Token] = []
  let mut i = 0
  let mut line = 1

  // Skip optional Unix shebang on line 1
  if n >= 2 && src[0].to_int() == 35 && src[1].to_int() == 33 {
    while i < n && src[i].to_int() != 10 {
      i = i + 1
    }
  }

  while i < n {
    let b = src[i].to_int()

    // Whitespace
    if b == 32 || b == 9 || b == 11 || b == 12 {
      i = i + 1
      continue
    }
    if b == 10 {
      line = line + 1
      i = i + 1
      continue
    }
    if b == 13 {
      line = line + 1
      i = i + 1
      if i < n && src[i].to_int() == 10 {
        i = i + 1
      }
      continue
    }

    // Comments: `--` or `--[=[...]=]`
    if b == 45 && i + 1 < n && src[i + 1].to_int() == 45 {
      i = i + 2
      let eqs = check_long_bracket(src, i)
      if eqs >= 0 {
        match scan_long_bracket(src, source, i, eqs, line) {
          Ok((_, next_i, new_line)) => {
            i = next_i
            line = new_line
          }
          Err(e) => return Err(e)
        }
      } else {
        while i < n && src[i].to_int() != 10 && src[i].to_int() != 13 {
          i = i + 1
        }
      }
      continue
    }

    // Identifiers and keywords
    if is_lua_ident_start(b) {
      let start = i
      i = i + 1
      while i < n && is_lua_ident_cont(src[i].to_int()) {
        i = i + 1
      }
      let word = source.slice(start, i)
      let kind = keyword_or_ident(word)
      tokens.push(Token::{ kind: kind, text: word, int_val: 0L, float_val: 0.0, line: line })
      continue
    }

    // Numbers: starts with digit or `.digit`
    if is_lua_digit(b) || (b == 46 && i + 1 < n && is_lua_digit(src[i + 1].to_int())) {
      let start = i
      let is_hex = b == 48 && i + 1 < n && (src[i + 1].to_int() == 120 || src[i + 1].to_int() == 88)
      if is_hex {
        i = i + 2
      }
      while i < n {
        let c = src[i].to_int()
        if is_hex {
          if hex_digit_val(c) >= 0 || c == 46 {
            i = i + 1
          } else if c == 112 || c == 80 {
            i = i + 1
            if i < n && (src[i].to_int() == 43 || src[i].to_int() == 45) {
              i = i + 1
            }
          } else {
            break
          }
        } else {
          if is_lua_digit(c) || c == 46 {
            i = i + 1
          } else if c == 101 || c == 69 {
            i = i + 1
            if i < n && (src[i].to_int() == 43 || src[i].to_int() == 45) {
              i = i + 1
            }
          } else {
            break
          }
        }
      }
      let num_str = source.slice(start, i)
      match lua_parse_number(num_str) {
        Some(LuaValue::Int(iv)) =>
        tokens.push(Token::{ kind: TokKind::IntLit, text: num_str, int_val: iv, float_val: 0.0, line: line })
        Some(LuaValue::Float(fv)) =>
        tokens.push(Token::{ kind: TokKind::FloatLit, text: num_str, int_val: 0L, float_val: fv, line: line })
        _ => return Err(LuaError::new(LuaErrorKind::SyntaxError, "malformed number '" + num_str + "'", line))
      }
      continue
    }

    // Short strings: `'...'` or `"..."`
    if b == 34 || b == 39 {
      let quote = b
      let start_line = line
      i = i + 1
      let out : Array[Byte] = []
      let mut closed = false
      while i < n {
        let c = src[i].to_int()
        if c == quote {
          i = i + 1
          closed = true
          break
        }
        if c == 10 || c == 13 {
          return Err(LuaError::new(LuaErrorKind::SyntaxError, "unfinished string", start_line))
        }
        if c == 92 {
          i = i + 1
          if i >= n {
            return Err(LuaError::new(LuaErrorKind::SyntaxError, "unfinished string escape", start_line))
          }
          let e = src[i].to_int()
          if e == 97 {
            out.push((7).to_byte())
            i = i + 1
          } else if e == 98 {
            out.push((8).to_byte())
            i = i + 1
          } else if e == 102 {
            out.push((12).to_byte())
            i = i + 1
          } else if e == 110 {
            out.push((10).to_byte())
            i = i + 1
          } else if e == 114 {
            out.push((13).to_byte())
            i = i + 1
          } else if e == 116 {
            out.push((9).to_byte())
            i = i + 1
          } else if e == 118 {
            out.push((11).to_byte())
            i = i + 1
          } else if e == 92 || e == 34 || e == 39 {
            out.push(e.to_byte())
            i = i + 1
          } else if e == 10 || e == 13 {
            out.push((10).to_byte())
            i = i + 1
            if i < n && ((e == 13 && src[i].to_int() == 10) || (e == 10 && src[i].to_int() == 13)) {
              i = i + 1
            }
            line = line + 1
          } else if e == 122 {
            // \z skips following whitespace
            i = i + 1
            while i < n && is_ascii_space(src[i].to_int()) {
              if src[i].to_int() == 10 {
                line = line + 1
              }
              i = i + 1
            }
          } else if e == 120 {
            // \xHH
            if i + 2 >= n {
              return Err(LuaError::new(LuaErrorKind::SyntaxError, "hex escape too short", line))
            }
            let h1 = hex_digit_val(src[i + 1].to_int())
            let h2 = hex_digit_val(src[i + 2].to_int())
            if h1 < 0 || h2 < 0 {
              return Err(LuaError::new(LuaErrorKind::SyntaxError, "invalid hex escape", line))
            }
            out.push(((h1 << 4) | h2).to_byte())
            i = i + 3
          } else if e == 117 {
            // \u{XXXX}
            if i + 1 >= n || src[i + 1].to_int() != 123 {
              return Err(LuaError::new(LuaErrorKind::SyntaxError, "missing '{' in \\u escape", line))
            }
            i = i + 2
            let mut cp = 0
            let mut digits = 0
            while i < n && src[i].to_int() != 125 {
              let hd = hex_digit_val(src[i].to_int())
              if hd < 0 {
                return Err(LuaError::new(LuaErrorKind::SyntaxError, "invalid \\u hex digit", line))
              }
              cp = (cp << 4) | hd
              digits = digits + 1
              if cp > 0x10FFFF {
                return Err(LuaError::new(LuaErrorKind::SyntaxError, "UTF-8 value too large", line))
              }
              i = i + 1
            }
            if digits == 0 || i >= n || src[i].to_int() != 125 {
              return Err(LuaError::new(LuaErrorKind::SyntaxError, "unterminated \\u escape", line))
            }
            i = i + 1
            push_utf8_cp(out, cp)
          } else if is_lua_digit(e) {
            // \ddd (up to 3 decimal digits)
            let mut val_d = e - 48
            i = i + 1
            if i < n && is_lua_digit(src[i].to_int()) {
              val_d = val_d * 10 + (src[i].to_int() - 48)
              i = i + 1
              if i < n && is_lua_digit(src[i].to_int()) {
                val_d = val_d * 10 + (src[i].to_int() - 48)
                i = i + 1
              }
            }
            if val_d > 255 {
              return Err(LuaError::new(LuaErrorKind::SyntaxError, "decimal escape too large", line))
            }
            out.push(val_d.to_byte())
          } else {
            return Err(LuaError::new(LuaErrorKind::SyntaxError, "invalid escape sequence", line))
          }
        } else {
          out.push(c.to_byte())
          i = i + 1
        }
      }
      if !closed {
        return Err(LuaError::new(LuaErrorKind::SyntaxError, "unfinished string", start_line))
      }
      let s = match utf8_bytes_to_string(bytes_from_array(out)) {
        Some(str_v) => str_v
        None => return Err(LuaError::new(LuaErrorKind::SyntaxError, "invalid UTF-8 in string", start_line))
      }
      tokens.push(Token::{ kind: TokKind::StrLit, text: s, int_val: 0L, float_val: 0.0, line: start_line })
      continue
    }

    // Long string `[[...]]` / `[=[...]=]` or `[`
    if b == 91 {
      let eqs = check_long_bracket(src, i)
      if eqs >= 0 {
        match scan_long_bracket(src, source, i, eqs, line) {
          Ok((s, next_i, new_line)) => {
            tokens.push(Token::{ kind: TokKind::StrLit, text: s, int_val: 0L, float_val: 0.0, line: line })
            i = next_i
            line = new_line
          }
          Err(e) => return Err(e)
        }
      } else {
        tokens.push(tok_simple(TokKind::LBracket, line))
        i = i + 1
      }
      continue
    }

    // Operators & punctuation
    if b == 43 {
      tokens.push(tok_simple(TokKind::Plus, line))
      i = i + 1
    } else if b == 45 {
      tokens.push(tok_simple(TokKind::Minus, line))
      i = i + 1
    } else if b == 42 {
      tokens.push(tok_simple(TokKind::Star, line))
      i = i + 1
    } else if b == 47 {
      if i + 1 < n && src[i + 1].to_int() == 47 {
        tokens.push(tok_simple(TokKind::SlashSlash, line))
        i = i + 2
      } else {
        tokens.push(tok_simple(TokKind::Slash, line))
        i = i + 1
      }
    } else if b == 37 {
      tokens.push(tok_simple(TokKind::Percent, line))
      i = i + 1
    } else if b == 94 {
      tokens.push(tok_simple(TokKind::Caret, line))
      i = i + 1
    } else if b == 35 {
      tokens.push(tok_simple(TokKind::Hash, line))
      i = i + 1
    } else if b == 38 {
      tokens.push(tok_simple(TokKind::Amp, line))
      i = i + 1
    } else if b == 124 {
      tokens.push(tok_simple(TokKind::Pipe, line))
      i = i + 1
    } else if b == 126 {
      if i + 1 < n && src[i + 1].to_int() == 61 {
        tokens.push(tok_simple(TokKind::TildeEq, line))
        i = i + 2
      } else {
        tokens.push(tok_simple(TokKind::Tilde, line))
        i = i + 1
      }
    } else if b == 61 {
      if i + 1 < n && src[i + 1].to_int() == 61 {
        tokens.push(tok_simple(TokKind::EqEq, line))
        i = i + 2
      } else {
        tokens.push(tok_simple(TokKind::Assign, line))
        i = i + 1
      }
    } else if b == 60 {
      if i + 1 < n && src[i + 1].to_int() == 61 {
        tokens.push(tok_simple(TokKind::LtEq, line))
        i = i + 2
      } else if i + 1 < n && src[i + 1].to_int() == 60 {
        tokens.push(tok_simple(TokKind::Shl, line))
        i = i + 2
      } else {
        tokens.push(tok_simple(TokKind::Lt, line))
        i = i + 1
      }
    } else if b == 62 {
      if i + 1 < n && src[i + 1].to_int() == 61 {
        tokens.push(tok_simple(TokKind::GtEq, line))
        i = i + 2
      } else if i + 1 < n && src[i + 1].to_int() == 62 {
        tokens.push(tok_simple(TokKind::Shr, line))
        i = i + 2
      } else {
        tokens.push(tok_simple(TokKind::Gt, line))
        i = i + 1
      }
    } else if b == 40 {
      tokens.push(tok_simple(TokKind::LParen, line))
      i = i + 1
    } else if b == 41 {
      tokens.push(tok_simple(TokKind::RParen, line))
      i = i + 1
    } else if b == 123 {
      tokens.push(tok_simple(TokKind::LBrace, line))
      i = i + 1
    } else if b == 125 {
      tokens.push(tok_simple(TokKind::RBrace, line))
      i = i + 1
    } else if b == 93 {
      tokens.push(tok_simple(TokKind::RBracket, line))
      i = i + 1
    } else if b == 59 {
      tokens.push(tok_simple(TokKind::Semi, line))
      i = i + 1
    } else if b == 44 {
      tokens.push(tok_simple(TokKind::Comma, line))
      i = i + 1
    } else if b == 58 {
      if i + 1 < n && src[i + 1].to_int() == 58 {
        tokens.push(tok_simple(TokKind::DoubleColon, line))
        i = i + 2
      } else {
        tokens.push(tok_simple(TokKind::Colon, line))
        i = i + 1
      }
    } else if b == 46 {
      if i + 2 < n && src[i + 1].to_int() == 46 && src[i + 2].to_int() == 46 {
        tokens.push(tok_simple(TokKind::DotDotDot, line))
        i = i + 3
      } else if i + 1 < n && src[i + 1].to_int() == 46 {
        tokens.push(tok_simple(TokKind::DotDot, line))
        i = i + 2
      } else {
        tokens.push(tok_simple(TokKind::Dot, line))
        i = i + 1
      }
    } else {
      return Err(LuaError::new(LuaErrorKind::SyntaxError, "unexpected character code " + b.to_string(), line))
    }
  }

  tokens.push(tok_simple(TokKind::Eof, line))
  Ok(tokens)
}
