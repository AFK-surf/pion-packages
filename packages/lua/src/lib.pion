///| Public entrypoints for `lua` (Pure-Pion Lua 5.4 bytecode compiler & sandboxed register VM).

///| Compile Lua 5.4 source code into a reusable bytecode `Chunk`.
pub fn compile(source : String) -> Result[Chunk, LuaError] {
  compile_with_limits(source, LuaLimits::default())
}

///| Compile Lua 5.4 source code with explicit limits.
pub fn compile_with_limits(source : String, limits : LuaLimits) -> Result[Chunk, LuaError] {
  match compile_lua_proto(source, limits.max_call_depth) {
    Ok(proto) => Ok(Chunk::{ source: source, proto: proto })
    Err(e) => Err(e)
  }
}

///| Create a new sandboxed Lua 5.4 VM with default limits and standard libraries loaded.
pub fn LuaVm::new() -> LuaVm {
  LuaVm::with_limits(LuaLimits::default())
}

///| Create a new sandboxed Lua 5.4 VM with explicit limits and standard libraries loaded.
pub fn LuaVm::with_limits(limits : LuaLimits) -> LuaVm {
  let mut gc_thresh = limits.max_memory_bytes / 4
  if gc_thresh < 262144 {
    gc_thresh = 262144
  }
  if gc_thresh > 4194304 {
    gc_thresh = 4194304
  }
  let vm = LuaVm::{
    limits: limits,
    fuel_used_count: 0L,
    memory_used_bytes: 0,
    tables: [],
    table_free: [],
    table_free_list: [],
    host_table_roots: [],
    closures: [],
    closure_free: [],
    closure_free_list: [],
    upvalues: [],
    upval_free: [],
    upval_free_list: [],
    open_upvalues: [],
    native_fns: [],
    threads: [],
    current_thread: -1,
    globals_id: -1,
    string_mt_id: -1,
    stack: [],
    top: 0,
    frames: [],
    host_depth: 0,
    gc_threshold: gc_thresh,
    gc_running: false,
    pinned_mem_bytes: 0,
    rng_s0: 0x123456789ABCDEF0UL,
    rng_s1: 0x0FEDCBA987654321UL,
    rng_s2: 0xA5A5A5A55A5A5A5AUL,
    rng_s3: 0x3C3C3C3CC3C3C3C3UL,
    out_buf: StringBuilder::new(),
    out_bytes: 0,
    last_error_val: LuaValue::Nil,
  }
  let g = LuaTable::new()
  vm.tables.push(g)
  vm.table_free.push(false)
  vm.globals_id = 0
  register_stdlib(vm)
  // Reset startup memory baseline so tight sandbox limits measure user script allocations
  vm.memory_used_bytes = 0
  vm
}

///| Set a global variable in `_G`.
pub fn LuaVm::set_global(self : LuaVm, name : String, v : LuaValue) -> Unit {
  let _ = self.tables[self.globals_id].raw_set(LuaValue::Str(name), v)
}

///| Get a global variable from `_G`.
pub fn LuaVm::get_global(self : LuaVm, name : String) -> LuaValue {
  self.tables[self.globals_id].raw_get_str(name)
}

///| Register a host callback function as a global in `_G`.
pub fn LuaVm::register_fn(
  self : LuaVm,
  name : String,
  f : (LuaVm, Array[LuaValue]) -> Result[Array[LuaValue], LuaError],
) -> Unit {
  let fn_val = self.alloc_native(f)
  let _ = self.tables[self.globals_id].raw_set(LuaValue::Str(name), fn_val)
}

///| Allocate a new empty Lua table in this VM and return its handle id.
pub fn LuaVm::new_table(self : LuaVm) -> Int {
  let id = if self.table_free_list.length() > 0 {
    let reuse = self.table_free_list[self.table_free_list.length() - 1]
    let _ = self.table_free_list.pop()
    self.tables[reuse] = LuaTable::new()
    self.table_free[reuse] = false
    reuse
  } else {
    let nid = self.tables.length()
    self.tables.push(LuaTable::new())
    self.table_free.push(false)
    nid
  }
  self.host_table_roots.push(id)
  id
}

///| Raw-get a key from a Lua table by handle id.
pub fn LuaVm::table_get(self : LuaVm, tid : Int, key : LuaValue) -> LuaValue {
  if !self.valid_table(tid) {
    return LuaValue::Nil
  }
  self.tables[tid].raw_get(key)
}

///| Raw-set a key/value in a Lua table by handle id.
pub fn LuaVm::table_set(
  self : LuaVm,
  tid : Int,
  key : LuaValue,
  v : LuaValue,
) -> Result[Unit, LuaError] {
  if !self.valid_table(tid) {
    return Err(LuaError::new(LuaErrorKind::RuntimeError, "invalid table handle", 0))
  }
  match self.tables[tid].raw_set(key, v) {
    Ok(bytes) => self.charge_mem(bytes)
    Err(e) => Err(e)
  }
}

///| Raw length (`#t`) of a Lua table by handle id.
pub fn LuaVm::table_len(self : LuaVm, tid : Int) -> Int {
  if !self.valid_table(tid) {
    return 0
  }
  self.tables[tid].raw_len()
}

///| Compile and execute a Lua chunk string, returning its return values.
pub fn LuaVm::exec(self : LuaVm, source : String) -> Result[Array[LuaValue], LuaError] {
  let chunk = match compile_with_limits(source, self.limits) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  self.exec_chunk(chunk)
}

///| Execute a pre-compiled `Chunk` in this VM, returning its return values.
pub fn LuaVm::exec_chunk(self : LuaVm, chunk : Chunk) -> Result[Array[LuaValue], LuaError] {
  self.exec_proto(chunk.proto)
}

///| Evaluate a single Lua expression and return its first result.
pub fn LuaVm::eval_expr(self : LuaVm, expr : String) -> Result[LuaValue, LuaError] {
  match self.exec("return " + expr) {
    Ok(vals) => {
      if vals.length() > 0 {
        Ok(vals[0])
      } else {
        Ok(LuaValue::Nil)
      }
    }
    Err(e) => Err(e)
  }
}

///| Call a global Lua function by name with host arguments.
pub fn LuaVm::call_global(
  self : LuaVm,
  name : String,
  args : Array[LuaValue],
) -> Result[Array[LuaValue], LuaError] {
  let callee = self.get_global(name)
  self.call_value(callee, args)
}

///| Return accumulated `print(...)` output buffer.
pub fn LuaVm::output(self : LuaVm) -> String {
  self.out_buf.to_string()
}

///| Clear accumulated `print(...)` output buffer.
pub fn LuaVm::clear_output(self : LuaVm) -> Unit {
  self.out_buf = StringBuilder::new()
  self.out_bytes = 0
}

///| Return total instruction/operation fuel consumed by this VM.
pub fn LuaVm::fuel_used(self : LuaVm) -> Int64 {
  self.fuel_used_count
}

///| Return estimated heap memory bytes allocated in this VM.
pub fn LuaVm::memory_used(self : LuaVm) -> Int {
  self.memory_used_bytes
}

///| One-shot execute a Lua script with default limits.
pub fn eval(source : String) -> Result[Array[LuaValue], LuaError] {
  eval_with_limits(source, LuaLimits::default())
}

///| One-shot execute a Lua script with explicit limits.
pub fn eval_with_limits(source : String, limits : LuaLimits) -> Result[Array[LuaValue], LuaError] {
  let vm = LuaVm::with_limits(limits)
  vm.exec(source)
}

///| One-shot execute a Lua script and return its captured `print(...)` output.
pub fn run_output(source : String) -> Result[String, LuaError] {
  let vm = LuaVm::new()
  match vm.exec(source) {
    Ok(_) => Ok(vm.output())
    Err(e) => Err(e)
  }
}
