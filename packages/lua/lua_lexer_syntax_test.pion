///| Lua 5.4 compliance tests: lexer, literals, syntax, precedence, control flow,
///| multi-return, varargs (`...`), and tail-call optimization (TCO).

fn assert_lua_int(src : String, expected : Int64, msg : String) -> Unit {
  match eval(src) {
    Ok(vals) => {
      debug_assert(vals.length() >= 1, msg + ": expected >= 1 return value")
      debug_assert(
        value_strict_eq(vals[0], LuaValue::int(expected)),
        msg + ": expected Int(" + expected.to_string() + "), got " + vals[0].type_name(),
      )
    }
    Err(e) => debug_assert(false, msg + ": unexpected error " + e.to_string())
  }
}

fn assert_lua_float_near(src : String, expected : Double, eps : Double, msg : String) -> Unit {
  match eval(src) {
    Ok(vals) => {
      debug_assert(vals.length() >= 1, msg + ": expected >= 1 return value")
      match vals[0] {
        LuaValue::Float(got) => {
          let diff = if got > expected { got - expected } else { expected - got }
          debug_assert(diff <= eps, msg + ": float mismatch")
        }
        _ => debug_assert(false, msg + ": expected Float, got " + vals[0].type_name())
      }
    }
    Err(e) => debug_assert(false, msg + ": unexpected error " + e.to_string())
  }
}

fn assert_lua_str(src : String, expected : String, msg : String) -> Unit {
  match eval(src) {
    Ok(vals) => {
      debug_assert(vals.length() >= 1, msg + ": expected >= 1 return value")
      match vals[0] {
        LuaValue::Str(got) =>
        debug_assert(got == expected, msg + ": expected '" + expected + "', got '" + got + "'")
        _ => debug_assert(false, msg + ": expected Str, got " + vals[0].type_name())
      }
    }
    Err(e) => debug_assert(false, msg + ": unexpected error " + e.to_string())
  }
}

fn assert_lua_bool(src : String, expected : Bool, msg : String) -> Unit {
  match eval(src) {
    Ok(vals) => {
      debug_assert(vals.length() >= 1, msg + ": expected >= 1 return value")
      debug_assert(value_strict_eq(vals[0], LuaValue::bool(expected)), msg + ": bool mismatch")
    }
    Err(e) => debug_assert(false, msg + ": unexpected error " + e.to_string())
  }
}

fn assert_lua_err(src : String, expected_kind : LuaErrorKind, msg : String) -> Unit {
  match eval(src) {
    Ok(_) => debug_assert(false, msg + ": expected error " + error_kind_as_str(expected_kind))
    Err(e) =>
    debug_assert(
      e.is_kind(expected_kind),
      msg + ": expected " + error_kind_as_str(expected_kind) + ", got " + e.to_string(),
    )
  }
}

test "lua_lexer_strings_long_brackets_and_escapes" {
  // Single, double, escapes, \z, \x, \ddd, \u{}
  assert_lua_str("return 'hello\\nworld'", "hello\nworld", "newline escape")
  assert_lua_str("return \"a\\tb\\\\c\\\"d\\'e\"", "a\tb\\c\"d'e", "basic escapes")
  assert_lua_str("return '\\x41\\66\\u{43}'", "ABC", "hex dec unicode escapes")
  assert_lua_str("return '\\u{1F600}'", "😀", "4-byte utf8 escape")
  assert_lua_str("return 'foo\\z   \n   bar'", "foobar", "\\z whitespace skip")
  // Long strings & comments
  assert_lua_str("return [[hello]]", "hello", "basic long string")
  assert_lua_str("return [[\nfirst line\nsecond]]", "first line\nsecond", "long string strips leading newline")
  assert_lua_str("return [=[a [[nested]] b]=]", "a [[nested]] b", "level-1 long string")
  assert_lua_str(
    "-- line comment\n--[==[ block\ncomment ]==]\nreturn 'ok'",
    "ok",
    "line and long comments",
  )
  assert_lua_err("return 'unterminated", LuaErrorKind::SyntaxError, "unterminated string")
  assert_lua_err("return [=[unterminated", LuaErrorKind::SyntaxError, "unterminated long string")
}

test "lua_lexer_numbers_decimal_hex_and_hex_float" {
  assert_lua_int("return 0", 0L, "zero")
  assert_lua_int("return 42", 42L, "dec int")
  assert_lua_int("return 0xff", 255L, "hex int lower")
  assert_lua_int("return 0X100", 256L, "hex int upper")
  assert_lua_float_near("return 3.14159", 3.14159, 0.000001, "dec float")
  assert_lua_float_near("return .5 + 5.", 5.5, 0.000001, "dot floats")
  assert_lua_float_near("return 1.5e-2", 0.015, 0.0000001, "sci float")
  assert_lua_float_near("return 0x1p-2", 0.25, 0.0000001, "hex float 0x1p-2")
  assert_lua_float_near("return 0x1.8p1", 3.0, 0.0000001, "hex float 0x1.8p1")
  assert_lua_float_near("return 0x0.1p4", 1.0, 0.0000001, "hex float 0x0.1p4")
}

test "lua_operator_precedence_and_associativity" {
  // ^ is right-associative and tighter than unary -
  assert_lua_float_near("return -2^2", -4.0, 0.000001, "-2^2 == -4")
  assert_lua_float_near("return 2^3^2", 512.0, 0.000001, "2^(3^2) == 512")
  assert_lua_int("return 1 + 2 * 3", 7L, "mul before add")
  assert_lua_int("return 10 - 3 - 2", 5L, "left assoc sub")
  assert_lua_str("return 'a' .. 'b' .. 'c'", "abc", "concat")
  // Short-circuit and/or return operand values, not just bool
  assert_lua_int("return nil or 42", 42L, "nil or 42")
  assert_lua_int("return false or 99", 99L, "false or 99")
  assert_lua_int("return 0 or 99", 0L, "0 is truthy in Lua")
  assert_lua_str("return '' or 'no'", "", "empty string is truthy")
  assert_lua_int("return 1 and 2 and 3", 3L, "chained and")
  assert_lua_bool("return false and error('boom')", false, "short-circuit and")
  assert_lua_bool("return true or error('boom')", true, "short-circuit or")
  assert_lua_bool("return not nil and not false and not (not 0)", true, "not semantics")
}

test "lua_control_flow_loops_and_scoping" {
  // if / elseif / else
  let src_if = "local x = 15\nif x < 10 then return 1 elseif x < 20 then return 2 else return 3 end"
  assert_lua_int(src_if, 2L, "if elseif else")
  // while + break
  let src_while = "local s, i = 0, 1\nwhile i <= 10 do\n  if i == 6 then break end\n  s = s + i\n  i = i + 1\nend\nreturn s"
  assert_lua_int(src_while, 15L, "while with break")
  // repeat .. until sees inner local!
  let src_repeat = "local acc = 0\nlocal n = 0\nrepeat\n  n = n + 1\n  local done = (n == 5)\n  acc = acc + n\nuntil done\nreturn acc"
  assert_lua_int(src_repeat, 15L, "repeat until sees inner local")
  // numeric for positive and negative step
  let src_for = "local s = 0\nfor i = 1, 10, 2 do s = s + i end\nfor j = 5, 1, -1 do s = s + j end\nreturn s"
  assert_lua_int(src_for, 40L, "numeric for pos & neg step")
  // generic for with ipairs and pairs
  let src_gfor = "local t = {10, 20, 30}\nlocal s = 0\nfor i, v in ipairs(t) do s = s + i * v end\nreturn s"
  assert_lua_int(src_gfor, 140L, "generic for ipairs")
  // do .. end block scoping
  let src_do = "local x = 1\ndo local x = 2; x = x + 10 end\nreturn x"
  assert_lua_int(src_do, 1L, "block scoping")
}

test "lua_multireturn_varargs_and_parallel_assignment" {
  let src = "local function multi() return 10, 20, 30 end\nlocal a, b, c = multi()\nlocal d = (multi())\nlocal x, y = 1, 2\nx, y = y, x\nreturn a + b + c + d + x * 100 + y"
  assert_lua_int(src, 271L, "multireturn + parens truncate + swap")

  // Varargs ...
  let src_va = "local function sum(...)\n  local args = {...}\n  local s = 0\n  for i = 1, #args do s = s + args[i] end\n  return s, select('#', ...)\nend\nlocal total, cnt = sum(3, 4, 5, 6)\nreturn total * 10 + cnt"
  assert_lua_int(src_va, 184L, "varargs pack and select")

  // Multireturn expansion in call args & table constructor
  let src_exp = "local function two() return 7, 8 end\nlocal t = {1, two()}\nlocal function add3(a, b, c) return a + b + c end\nreturn t[1] + t[2] + t[3] + add3(2, two())"
  assert_lua_int(src_exp, 33L, "multireturn expansion in table and call")
}

test "lua_tail_call_optimization_100k_depth" {
  // 100,000-deep tail recursion must succeed even with max_call_depth = 64!
  let src = "local function countdown(n, acc)\n  if n == 0 then return acc end\n  return countdown(n - 1, acc + 1)\nend\nreturn countdown(100000, 0)"
  let limits = LuaLimits::new(50000000L, 64, 1024, 16777216, 65536)
  match eval_with_limits(src, limits) {
    Ok(vals) => {
      debug_assert(vals.length() == 1, "tco: expected 1 return value")
      debug_assert(value_strict_eq(vals[0], LuaValue::int(100000L)), "tco: expected 100000")
    }
    Err(e) => debug_assert(false, "tco 100k failed: " + e.to_string())
  }
}
