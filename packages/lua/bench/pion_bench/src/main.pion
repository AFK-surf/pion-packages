///| Head-to-head benchmark binary for `packages/lua` (W1 / W2 / W3).

import "lua"

fn w1_script() -> String {
  "local function sieve(n)\n" +
  "  local is_p = {}\n" +
  "  for i = 2, n do is_p[i] = true end\n" +
  "  local i = 2\n" +
  "  while i * i <= n do\n" +
  "    if is_p[i] then\n" +
  "      for j = i * i, n, i do is_p[j] = false end\n" +
  "    end\n" +
  "    i = i + 1\n" +
  "  end\n" +
  "  local primes = {}\n" +
  "  local cnt = 0\n" +
  "  for k = 2, n do\n" +
  "    if is_p[k] then\n" +
  "      cnt = cnt + 1\n" +
  "      primes[cnt] = k\n" +
  "    end\n" +
  "  end\n" +
  "  return primes\n" +
  "end\n" +
  "local function fib(n)\n" +
  "  if n < 2 then return n end\n" +
  "  return fib(n - 1) + fib(n - 2)\n" +
  "end\n" +
  "local total = 0\n" +
  "for r = 1, 20 do\n" +
  "  local ps = sieve(4000)\n" +
  "  local arr = {}\n" +
  "  for i = 1, 250 do\n" +
  "    arr[i] = (ps[i] * 37 + r * 13) % 997\n" +
  "  end\n" +
  "  table.sort(arr)\n" +
  "  total = total + #ps + arr[1] + arr[125] + arr[250]\n" +
  "end\n" +
  "local f24 = fib(24)\n" +
  "print(string.format('w1:%d:%d', total, f24))\n"
}

fn w2_script() -> String {
  "local Rec = {}\n" +
  "Rec.__index = Rec\n" +
  "function Rec.new(id, score)\n" +
  "  return setmetatable({id = id, score = score}, Rec)\n" +
  "end\n" +
  "function Rec:__add(other)\n" +
  "  return Rec.new(self.id + other.id, self.score + other.score)\n" +
  "end\n" +
  "function Rec:render(tag)\n" +
  "  return string.format('[%s#%d=%d]', tag, self.id, self.score)\n" +
  "end\n" +
  "local function make_adder(base)\n" +
  "  local acc = base\n" +
  "  return function(d)\n" +
  "    acc = acc + d\n" +
  "    return acc\n" +
  "  end\n" +
  "end\n" +
  "local add = make_adder(0)\n" +
  "local line = 'user=alice score=42 role=admin; user=bob score=17 role=dev; user=carol score=88 role=ops'\n" +
  "local checksum = 0\n" +
  "local last = ''\n" +
  "for i = 1, 1500 do\n" +
  "  local transformed = string.gsub(line, '(%a+)=(%w+)', function(k, v)\n" +
  "    if k == 'score' then\n" +
  "      return k .. ':' .. tostring(tonumber(v) + (i % 7))\n" +
  "    end\n" +
  "    return k .. ':' .. string.upper(v)\n" +
  "  end)\n" +
  "  local sum = 0\n" +
  "  for num in string.gmatch(transformed, 'score:(%d+)') do\n" +
  "    sum = sum + tonumber(num)\n" +
  "  end\n" +
  "  local r = Rec.new(i, sum) + Rec.new(1, add(1) % 100)\n" +
  "  checksum = checksum + r.score\n" +
  "  if i == 1500 then last = r:render('OK') .. '|' .. transformed end\n" +
  "end\n" +
  "print(string.format('w2:%d:%s', checksum, last))\n"
}

fn run_w1(world : World) -> Int {
  let vm = lua::LuaVm::with_limits(lua::LuaLimits::new(500000000L, 200, 16384, 67108864, 1048576))
  match vm.exec(w1_script()) {
    Ok(_) => {
      io_print(world, vm.output())
      0
    }
    Err(e) => {
      io_println(world, "ERR: " + e.to_string())
      1
    }
  }
}

fn run_w2(world : World) -> Int {
  let vm = lua::LuaVm::with_limits(lua::LuaLimits::new(500000000L, 200, 16384, 67108864, 1048576))
  match vm.exec(w2_script()) {
    Ok(_) => {
      io_print(world, vm.output())
      0
    }
    Err(e) => {
      io_println(world, "ERR: " + e.to_string())
      1
    }
  }
}

fn run_w3(world : World) -> Int {
  let mut acc = 0L
  let mut i = 1
  while i <= 2000 {
    let vm = lua::LuaVm::new()
    let script =
    "local k = " +
    i.to_string() +
    "\nlocal t = {a = k, b = k * 3 + 7}\nlocal function f(x) return x + t.a + t.b end\nreturn f(k % 11)\n"
    match vm.exec(script) {
      Ok(vals) => {
        if vals.length() > 0 {
          match vals[0].as_int() {
            Some(n) => acc = acc + n
            None => ()
          }
        }
      }
      Err(e) => {
        io_println(world, "ERR: " + e.to_string())
        return 1
      }
    }
    i = i + 1
  }
  io_println(world, "w3:2000:" + acc.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mode = if args.length() >= 2 { args[1] } else { "w1" }
  if mode == "w1" {
    run_w1(world)
  } else if mode == "w2" {
    run_w2(world)
  } else if mode == "w3" {
    run_w3(world)
  } else {
    io_println(world, "usage: pion_lua <w1|w2|w3>")
    1
  }
}
