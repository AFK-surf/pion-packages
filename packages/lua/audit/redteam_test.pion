///| RT-lua red-team assertions for `packages/lua` @ 89f41b6.
///| Naming: `p0_*` / `p1_*` / `p2_*` assert the Lua 5.4 / sandbox-correct behaviour and FAIL on the
///| audited commit (each one is evidence for the finding of the same id in AUDIT_REPORT.md);
///| `control_*` must PASS (things the package gets right). Probes that SIGSEGV / abort / hang the
///| host (P0-1..P0-4, P0-7) cannot live in a test binary and are reproduced by `dos/probes.py`.

import "lua"

///| Run `src` in a fresh VM and return `print()` output plus `=> OK` / `=> ERR <Kind>`.
fn run_lim(src : String, lim : lua::LuaLimits) -> String {
  let vm = lua::LuaVm::with_limits(lim)
  match vm.exec(src) {
    Ok(_) => vm.output() + "=> OK"
    Err(e) => vm.output() + "=> ERR " + lua::error_kind_as_str(e.kind)
  }
}

///|
fn run(src : String) -> String {
  run_lim(src, lua::LuaLimits::default())
}

///|
fn tight_fuel(f : Int64) -> lua::LuaLimits {
  lua::LuaLimits::new(f, 200, 16384, 33554432, 1048576)
}

///|
fn check(got : String, want : String, what : String) -> Unit {
  debug_assert(got == want, what + "\n  want: " + want + "\n  got:  " + got)
}

// ===================================================================================== P0

///| P0-5: a native callback (`tostring` -> `__tostring`, sort comparator, gsub fn, `__index` fn)
///| runs its Lua frame at `vm.top`, which an earlier multret call left *below* the caller's live
///| registers, so the callee silently overwrites the caller's locals.
test "p0_5_native_callback_frame_clobbers_caller_locals" {
  let src = "local t = setmetatable({}, {__tostring = function() local a, b, c, d, e, f = 1, 2, 3, 4, 5, 6 return 'T' end})\n" +
  "local function multi() return 1, 2, 3 end\n" +
  "local r = {multi()}\n" +
  "local secret, keep = 'secret', 'keep'\n" +
  "print(secret, keep, tostring(t), keep)"
  check(run(src), "secret\tkeep\tT\tkeep\n=> OK", "locals clobbered by metamethod frame")
}

///| P0-5 (variant): the clobbered register is the staged callee, the call itself then fails.
test "p0_5b_clobbered_callee_register" {
  let src = "local t = setmetatable({}, {__tostring = function() local a, b, c, d, e, f = 1, 2, 3, 4, 5, 6 return 'T' end})\n" +
  "local r = {tostring(t)}\n" +
  "local keep = 'keep'\n" +
  "print(keep, tostring(t))"
  check(run(src), "keep\tT\n=> OK", "print register clobbered")
}

///| P0-6: constant / register / jump operands are masked to 16 bits (`enc_abc` `& 0xFFFF`) with
///| no limit check, so constant #65536 silently aliases constant #0: `s = "EVIL"` loads "print".
test "p0_6_constant_index_wraps_silent_miscompile" {
  let sb = StringBuilder::new()
  sb.write_string("local p = print local s0 = 'SAFE' local t = {")
  let mut i = 1
  while i < 65535 {
    if i > 1 {
      sb.write_string(",")
    }
    sb.write_string("'x" + i.to_string() + "'")
    i = i + 1
  }
  sb.write_string("} local s = 'EVIL' p(s, #t)")
  let got = run(sb.to_string())
  // Lua 5.4.7: "EVIL\t65534". (A compile-time SyntaxError/limit error would also be acceptable.)
  let rejected = got.length() >= 6 && got.code_unit_at(0).to_int() == 61 && got.code_unit_at(3).to_int() == 69
  debug_assert(got == "EVIL\t65534\n=> OK" || rejected, "miscompile: " + got)
}

///| P0-8: `table.move` copies element by element without charging fuel.
test "p0_8_table_move_fuel_bypass" {
  check(run_lim("table.move({}, 1, 10000000, 2)", tight_fuel(10000L)), "=> ERR FuelLimit", "table.move 1e7 under fuel 1e4")
}

///| P0-9: plain `string.find` is O(n*m) with no fuel.
test "p0_9_plain_find_fuel_bypass" {
  let src = "local s = ('a'):rep(20000) local p = ('a'):rep(10000) .. 'b' return s:find(p, 1, true)"
  check(run_lim(src, tight_fuel(100000L)), "=> ERR FuelLimit", "plain find 1e8 compares under fuel 1e5")
}

///| P0-10: `%b()` balance scanning is not fuelled (O(n^2) per find).
test "p0_10_balance_pattern_fuel_bypass" {
  check(run_lim("return string.find(('('):rep(8000), '%b()')", tight_fuel(100000L)), "=> ERR FuelLimit", "%b scan under fuel 1e5")
}

///| P0-11: `string.rep` truncates its Int64 count to 32-bit Int: rep('x', 2^32 + 3) == 'xxx'.
test "p0_11_string_rep_count_truncated_to_int32" {
  let got = run("return #('x'):rep(2^32 + 3)")
  debug_assert(got != "=> OK", "must not succeed")
  check(run("print(#('x'):rep(2^32 + 3))"), "=> ERR MemoryLimit", "rep(2^32+3) must hit MemoryLimit")
}

// ===================================================================================== P1

///| P1-1: tostring/print/.. of floats uses shortest round-trip, not Lua's "%.14g".
test "p1_1_float_tostring_not_lua_14g" {
  check(run("print(0.1 + 0.2, 1 / 3, 2^53, 100 / 3, 2^63)"), "0.3\t0.33333333333333\t9.007199254741e+15\t33.333333333333\t9.2233720368548e+18\n=> OK", "float formatting")
}

///| P1-2: decimal float literals / tonumber are not correctly rounded.
test "p1_2_float_literal_parse_not_correctly_rounded" {
  check(run("print(1e100 == 0x1.249ad2594c37dp+332, 9223372036854775808 == 0x1p63, 5e-324 > 0, tonumber('1e100') == 0x1.249ad2594c37dp+332)"), "true\ttrue\ttrue\ttrue\n=> OK", "decimal parse off by ulp / denormals flushed")
}

///| P1-3: `local _ENV` / `_ENV` parameter are ignored: globals still go to the real `_G`.
test "p1_3_local_env_ignored" {
  check(run("local function f() local _ENV = {} y = 2 end f() print(y)"), "nil\n=> OK", "local _ENV write")
  check(run("local _ENV = {print = print, v = 'from_env'} print(v)"), "from_env\n=> OK", "local _ENV read")
}

///| P1-4: assigning nil to fields during `pairs` traversal (explicitly allowed by the manual)
///| raises "invalid key to 'next'".
test "p1_4_clear_fields_during_traversal" {
  check(run("local t = {} for i = 1, 100 do t['k' .. i] = i end for k in pairs(t) do t[k] = nil end print(next(t))"), "nil\n=> OK", "clear during pairs")
}

///| P1-5: `goto` / labels are not parsed at all.
test "p1_5_goto_unsupported" {
  check(run("local s = 0 for i = 1, 10 do if i % 2 == 0 then goto cont end s = s + i ::cont:: end print(s)"), "25\n=> OK", "goto continue")
}

///| P1-6: integer `for` loops near maxinteger overflow and never terminate.
test "p1_6_for_loop_overflow_at_maxinteger" {
  check(run_lim("local n = 0 for i = math.maxinteger - 2, math.maxinteger do n = n + 1 end print(n)", tight_fuel(100000L)), "3\n=> OK", "for to maxinteger")
  check(run_lim("local n = 0 for i = 1, math.maxinteger, math.maxinteger // 2 do n = n + 1 end print(n)", tight_fuel(100000L)), "3\n=> OK", "large step")
}

///| P1-7: int/float comparisons convert the integer to float (Lua compares exactly).
test "p1_7_int_float_compare_exact" {
  check(run("print(math.maxinteger < 2^63, math.maxinteger + 0.0 == 2^63, 2^53 + 1 > 2^53 + 0.0)"), "true\ttrue\ttrue\n=> OK", "exact int/float compare")
}

///| P1-8: float `%` is a - floor(a/b)*b: wrong for infinite divisors and large operands.
test "p1_8_float_mod_wrong" {
  check(run("print(5 % math.huge, -5 % math.huge, 1e308 % 3, 2^60 % 7.0)"), "5.0\tinf\t2.0\t1.0\n=> OK", "float mod")
}

///| P1-9: `string.format('%f')` saturates through Int64 and emits garbage digits.
test "p1_9_format_f_garbage" {
  check(run("print(string.format('%.0f', 2^63), string.format('%.20f', 0.1), string.format('%f', 1e20))"), "9223372036854775808\t0.10000000000000000555\t100000000000000000000.000000\n=> OK", "%f")
  check(run("print(string.format('%.2f %.0f %.0f', 2.675, 0.5, 2.5))"), "2.67 0 2\n=> OK", "%f rounding (binary value, half-even)")
}

///| P1-10: `%e` / `%g` / `%a` / `%q` / flags are not implemented as in C/Lua (silently wrong).
test "p1_10_format_e_g_q_flags" {
  check(run("print(string.format('%e|%g|%g|%.3g', 12345.678, 123456789, 2^53, math.pi))"), "1.234568e+04|1.23457e+08|9.0072e+15|3.14\n=> OK", "%e/%g")
  check(run("print(string.format('%q', 'a\\nb\"c\\0d'))"), "\"a\\\nb\\\"c\\0d\"\n=> OK", "%q escaping")
  check(run("print(string.format('%#x|% d|%5.1s|', 255, 5, 'abc'))"), "0xff| 5|    a|\n=> OK", "flags")
}

///| P1-11: `gsub` with an empty frontier match duplicates the subject.
test "p1_11_gsub_frontier_empty_match_corrupts" {
  check(run("print((('aXb'):gsub('%f[%u]', '|')), (('ab'):gsub('%f[^%a]', '#')))"), "a|Xb\tab#\n=> OK", "frontier gsub")
}

///| P1-12: string index arguments are truncated Int64 -> Int32.
test "p1_12_string_index_int32_truncation" {
  check(run("print(('abc'):byte(math.maxinteger), ('abc'):sub(2^62) == '', ('abc'):sub(-2^62, 2))"), "nil\ttrue\tab\n=> OK", "byte/sub huge index")
}

///| P1-13: `__metatable` protection is ignored by getmetatable/setmetatable.
test "p1_13_metatable_protection_ignored" {
  check(run("local t = setmetatable({}, {__metatable = 'locked'}) print(getmetatable(t), (pcall(setmetatable, t, {})))"), "locked\tfalse\n=> OK", "__metatable")
}

///| P1-14: `<close>` never calls `__close`; `<const>` reassignment and unknown attribs accepted.
test "p1_14_close_const_attributes" {
  check(run("do local x <close> = setmetatable({}, {__close = function() print('closed') end}) end"), "closed\n=> OK", "__close")
  check(run("local y <const> = 1 y = 2"), "=> ERR SyntaxError", "const assignment")
  check(run("local x <foo> = 1"), "=> ERR SyntaxError", "unknown attribute")
}

///| P1-15: no GC / no reclamation: memory_used only grows, so ordinary allocation churn kills a
///| script under the default 32 MiB budget (Lua needs ~0 live memory for this loop).
test "p1_15_no_memory_reclamation" {
  check(run("for i = 1, 1000000 do local t = {} end print('ok')"), "ok\n=> OK", "short-lived tables")
}

///| P1-16: custom libm: no range reduction for large arguments.
test "p1_16_sin_cos_large_argument" {
  check(run("print(string.format('%.6f %.6f', math.sin(1e22), math.sin(1e10)))"), "-0.852201 -0.487506\n=> OK", "sin range reduction")
}

///| P1-17: missing standard functions (README claims a full Lua 5.4 subset for scripting).
test "p1_17_missing_stdlib" {
  check(run("print(type(coroutine), type(load), type(math.random), type(math.tan), type(string.pack), type(utf8.charpattern))"), "table\tfunction\tfunction\tfunction\tfunction\tstring\n=> OK", "stdlib presence")
}

///| P1-18: `table.unpack` with an empty overflowing range returns nothing instead of erroring.
test "p1_18_unpack_range_overflow" {
  check(run("print(pcall(table.unpack, {}, math.mininteger, math.maxinteger))"), "false\ttoo many results to unpack\n=> OK", "unpack overflow")
}

///| P1-19: `__index` chain limit is 100 (Lua: 2000), legit inheritance depth fails.
test "p1_19_index_chain_limit_too_low" {
  check(run("local cur = {v = 'deep'} for i = 1, 100 do cur = setmetatable({}, {__index = cur}) end print(cur.v)"), "deep\n=> OK", "__index depth 100")
}

// ===================================================================================== P2

///| P2-1: runtime errors carry no `chunk:line:` position (error(), arithmetic, index).
test "p2_1_error_positions_missing" {
  check(run("local ok, e = pcall(function() error('msg') end) print((e:gsub('^[^:]*:', 'C:')))"), "C:1: msg\n=> OK", "error position")
}

///| P2-2: argument checking: missing-argument / bad-type errors are silently accepted.
test "p2_2_argument_checks" {
  check(run("print((pcall(type)), (pcall(tostring)), (pcall(tonumber, '10', 1)), (pcall(tonumber, 10, 16)), (pcall(table.insert, {}, 1, 2, 3)), (pcall(utf8.codepoint, 'abc', 4)))"), "false\tfalse\tfalse\tfalse\tfalse\tfalse\n=> OK", "argument errors")
}

///| P2-3: bitwise operators accept strings (Lua 5.4 raises).
test "p2_3_bitwise_on_strings" {
  check(run("print((pcall(function() return '3' | 0 end)))"), "false\n=> OK", "string bitwise")
}

///| P2-4: `gmatch` ignores 5.4 `init` and treats `^` as an anchor.
test "p2_4_gmatch_init_and_anchor" {
  check(run("local r = {} for w in string.gmatch('abcd', '.', 3) do r[#r + 1] = w end local n = 0 for w in ('aaa'):gmatch('^a') do n = n + 1 end print(table.concat(r), n)"), "cd\t0\n=> OK", "gmatch")
}

///| P2-5: utf8 strictness: surrogates accepted, continuation-byte offsets accepted, \u{7FFFFFFF} rejected.
test "p2_5_utf8_strictness" {
  check(run("print(utf8.len('\\xed\\xa0\\x80'), (pcall(utf8.offset, '\\xe4\\xb8\\xad', 1, 2)))"), "nil\tfalse\n=> OK", "utf8 surrogate / continuation")
  check(run("print(#'\\u{7FFFFFFF}')"), "6\n=> OK", "\\u{7FFFFFFF} escape")
}

///| P2-6: CRLF inside long strings is not normalised; `#!` first line not skipped... (Pion skips it, Lua's load does not:
///| only the CRLF half is asserted).
test "p2_6_long_string_crlf" {
  check(run("local s = [[\r\nab\r\ncd]] print(#s)"), "5\n=> OK", "CRLF in long string")
}

///| P2-7: `math.abs(-0.0)` returns -0.0; integer-valued `for` with float limit yields floats.
test "p2_7_minor_numeric" {
  check(run("print(math.abs(-0.0), math.type((function() for i = 1, 3.7 do return i end end)()))"), "0.0\tinteger\n=> OK", "abs / for type")
}

///| P2-8: `tostring` honours `__name`; `__tostring` may return a number (5.4.7 accepts).
test "p2_8_tostring_name_and_number" {
  check(run("print(tostring(setmetatable({}, {__name = 'My'})):match('^My: ') ~= nil)"), "true\n=> OK", "__name")
  check(run("print(tostring(setmetatable({}, {__tostring = function() return 42 end})))"), "42\n=> OK", "__tostring returning a number")
}

// ===================================================================================== controls

///|
test "control_tco_100k_under_depth_64" {
  check(run_lim("local function f(n) if n == 0 then return 'done' end return f(n - 1) end print(f(100000))", lua::LuaLimits::new(50000000L, 64, 1024, 16777216, 65536)), "done\n=> OK", "TCO")
}

///|
test "control_pcall_cannot_swallow_limits" {
  check(run_lim("print(pcall(function() while true do end end)) print('after')", tight_fuel(100000L)), "=> ERR FuelLimit", "fuel")
  check(run("print(pcall(string.rep, 'x', 100000000)) print('after')"), "=> ERR MemoryLimit", "mem")
  check(run("local function f() return f() + 1 end print(xpcall(f, function(m) return 'h' end)) print('after')"), "=> ERR StackLimit", "stack")
  check(run_lim("print(pcall(table.sort, {3, 2, 1}, function(a, b) while true do end end)) print('after')", tight_fuel(100000L)), "=> ERR FuelLimit", "sort cmp fuel")
}

///|
test "control_closures_upvalues_multret" {
  check(run("local fs = {} for i = 1, 3 do fs[i] = function() return i end end print(fs[1](), fs[2](), fs[3]())"), "1\t2\t3\n=> OK", "per-iteration upvalue")
  check(run("local g pcall(function() local a = 41 g = function() a = a + 1 return a end error('x') end) local p, q, r, s = 9, 9, 9, 9 print(g(), g())"), "42\t43\n=> OK", "upvalue closed on error")
  check(run("local function f() return 1, 2, 3 end print(#{f(), f()}, #{f(), 1}, (f()), select('#', f()))"), "4\t2\t1\t3\n=> OK", "multret rules")
}

///|
test "control_integer_edge_arith" {
  check(run("print(math.mininteger // -1, math.mininteger % -1, -math.mininteger == math.mininteger, 1 << 64, 1 << 63, -1 >> 63, 7 // 0.0)"), "-9223372036854775808\t0\ttrue\t0\t-9223372036854775808\t1\tinf\n=> OK", "int edges")
  check(run("print(pcall(function() local z = 0 return 1 // z end))"), "false\tattempt to divide by zero\n=> OK", "idiv by zero")
}

///|
test "control_parser_nesting_rejected_not_crash" {
  let sb = StringBuilder::new()
  sb.write_string("return ")
  let mut i = 0
  while i < 100000 {
    sb.write_string("(")
    i = i + 1
  }
  check(run(sb.to_string()), "=> ERR StackLimit", "100k parens")
}

///|
test "control_string_metatable_isolated_per_vm" {
  let a = lua::LuaVm::new()
  let _ = a.exec("getmetatable('').__index = function() return 'pwned' end")
  check(run("print(('x').len == string.len)"), "true\n=> OK", "fresh VM unaffected")
}

///|
test "control_chunk_reuse_across_vms" {
  match lua::compile("x = (x or 0) + 1 return x") {
    Ok(c) => {
      let v1 = lua::LuaVm::new()
      let v2 = lua::LuaVm::new()
      let _ = v1.exec_chunk(c)
      let _ = v1.exec_chunk(c)
      match v2.exec_chunk(c) {
        Ok(r) => debug_assert(lua::value_strict_eq(r[0], lua::LuaValue::int(1L)), "v2 must start clean")
        Err(e) => debug_assert(false, e.to_string())
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///|
test "control_sort_invalid_comparator_terminates" {
  check(run("local t = {} for i = 1, 200 do t[i] = i end local x = 1 pcall(table.sort, t, function(a, b) x = (x * 1103515245 + 12345) % 2147483648 return x % 2 == 0 end) print(#t)"), "200\n=> OK", "random comparator")
}

///|
test "control_index_newindex_loops_bounded" {
  check(run("local t = {} setmetatable(t, {__index = t}) print((pcall(function() return t.x end)))"), "false\n=> OK", "__index loop")
  check(run("local a, b = {}, {} setmetatable(a, {__newindex = b}) setmetatable(b, {__newindex = a}) print((pcall(function() a.x = 1 end)))"), "false\n=> OK", "__newindex loop")
}

///| Host reuse: an error escaping the top-level chunk must not leave upvalues open on the shared
///| VM stack (the next `exec` on the same VM would otherwise read its own registers through them).
test "control_toplevel_error_closes_upvalues_across_exec" {
  let vm = lua::LuaVm::new()
  let _ = vm.exec("local secret = 'mine' g = function() return secret end error('boom')")
  match vm.exec("local a, b, c, d = 'X', 'X', 'X', 'X' return g()") {
    Ok(r) => debug_assert(lua::value_strict_eq(r[0], lua::LuaValue::str("mine")), "stale open upvalue")
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| Host API: a `LuaValue::Table` handle from another VM / out of range must not crash the host.
test "p2_9_foreign_table_handle" {
  let vm = lua::LuaVm::new()
  vm.set_global("t", lua::LuaValue::table(99999))
  check(run_lim_vm(vm, "return (pcall(function() return t.x end))"), "=> OK", "foreign handle")
}

///|
fn run_lim_vm(vm : lua::LuaVm, src : String) -> String {
  match vm.exec(src) {
    Ok(_) => vm.output() + "=> OK"
    Err(e) => vm.output() + "=> ERR " + lua::error_kind_as_str(e.kind)
  }
}
