///| Fairness / adversarial benchmark driver for Pion `packages/lua` (mirror of audit/bench/go).
///| usage: bench <mode> <script.lua> [reps]
///|   run   : one LuaVm (limits raised so only the workload is measured), stdout = print() output
///|   fresh : reps x { LuaVm::new(); set_global K=i; exec(src) }  -> "fresh:<reps>:<sum>"
///|   chunk : compile once, reps x { LuaVm::new(); set_global K=i; exec_chunk }

import "lua"

///|
fn parse_int(s : String) -> Int {
  let mut n = 0
  let mut i = 0
  while i < s.length() {
    n = n * 10 + (s.code_unit_at(i).to_int() - 48)
    i = i + 1
  }
  n
}

///|
fn first_int(vals : Array[lua::LuaValue]) -> Int64 {
  if vals.length() == 0 {
    return 0L
  }
  match vals[0] {
    lua::LuaValue::Int(n) => n
    lua::LuaValue::Float(f) => f.to_int64()
    _ => 0L
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: bench run|fresh|chunk <script.lua> [reps]")
    return 2
  }
  let mode = args[1]
  let src = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => return 2
  }
  let reps = if args.length() > 3 { parse_int(args[3]) } else { 1 }
  if mode == "run" {
    let vm = lua::LuaVm::with_limits(
      lua::LuaLimits::new(100000000000L, 200, 1000000, 2000000000, 100000000),
    )
    match vm.exec(src) {
      Ok(_) => {
        io_print(world, vm.output())
        return 0
      }
      Err(e) => {
        io_eprintln(world, "ERR: " + e.to_string())
        return 1
      }
    }
  }
  let mut acc = 0L
  if mode == "chunk" {
    let chunk = match lua::compile(src) {
      Ok(c) => c
      Err(e) => {
        io_eprintln(world, "ERR: " + e.to_string())
        return 1
      }
    }
    let mut i = 1
    while i <= reps {
      let vm = lua::LuaVm::new()
      vm.set_global("K", lua::LuaValue::int(i.to_int64()))
      match vm.exec_chunk(chunk) {
        Ok(vals) => acc = acc + first_int(vals)
        Err(e) => {
          io_eprintln(world, "ERR: " + e.to_string())
          return 1
        }
      }
      i = i + 1
    }
  } else {
    let mut i = 1
    while i <= reps {
      let vm = lua::LuaVm::new()
      vm.set_global("K", lua::LuaValue::int(i.to_int64()))
      match vm.exec(src) {
        Ok(vals) => acc = acc + first_int(vals)
        Err(e) => {
          io_eprintln(world, "ERR: " + e.to_string())
          return 1
        }
      }
      i = i + 1
    }
  }
  io_println(world, "fresh:" + reps.to_string() + ":" + acc.to_string())
  0
}
