///| Red-team differential driver for Pion `packages/lua` (Native + wasm32).
///| Usage:
///|   driver run <f.lua>...                                  : each file in a fresh LuaVm (default limits)
///|   driver lim <fuel> <depth> <slots> <mem> <out> <f.lua>... : same with explicit LuaLimits
///| Per file prints `## <path>`, the captured print() buffer, then `=> OK` or `=> ERR <Kind>`
///| followed by `#msg <message>` (ignored by the comparator) and stats.

import "lua"

///|
fn parse_i64(s : String) -> Int64 {
  let mut n = 0L
  let mut i = 0
  let len = s.length()
  while i < len {
    let c = s.code_unit_at(i).to_int()
    if c >= 48 && c <= 57 {
      n = n * 10L + (c - 48).to_int64()
    }
    i = i + 1
  }
  n
}

///|
fn run_one(world : World, path : String, limits : lua::LuaLimits) -> Unit {
  io_println(world, "## " + path)
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "=> ERR ReadError")
      return
    }
  }
  let vm = lua::LuaVm::with_limits(limits)
  let res = vm.exec(src)
  let out = vm.output()
  io_print(world, out)
  if out.length() > 0 && out.code_unit_at(out.length() - 1).to_int() != 10 {
    io_println(world, "")
  }
  match res {
    Ok(_) => io_println(world, "=> OK")
    Err(e) => {
      io_println(world, "=> ERR " + lua::error_kind_as_str(e.kind))
      io_println(world, "#msg " + e.to_string())
    }
  }
  io_println(
    world,
    "#stats fuel=" + vm.fuel_used().to_string() + " mem=" + vm.memory_used().to_string(),
  )
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: driver run <f.lua>... | lim <fuel> <depth> <slots> <mem> <out> <f.lua>...")
    return 2
  }
  let mut limits = lua::LuaLimits::default()
  let mut first = 2
  if args[1] == "lim" {
    if args.length() < 8 {
      return 2
    }
    limits = lua::LuaLimits::new(
      parse_i64(args[2]),
      parse_i64(args[3]).to_int(),
      parse_i64(args[4]).to_int(),
      parse_i64(args[5]).to_int(),
      parse_i64(args[6]).to_int(),
    )
    first = 7
  }
  let mut i = first
  while i < args.length() {
    run_one(world, args[i], limits)
    i = i + 1
  }
  0
}
