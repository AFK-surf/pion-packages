///| Lua 5.4 compliance tests: all 17 core metamethods and OOP metatable patterns.

test "lua_metamethods_index_newindex_call_tostring_len" {
  // __index (table) + OOP method dispatch + __tostring + __len
  let src_oop = "local Vec = {}\nVec.__index = Vec\nfunction Vec.new(x, y) return setmetatable({x = x, y = y}, Vec) end\nfunction Vec:mag2() return self.x * self.x + self.y * self.y end\nfunction Vec:__tostring() return '(' .. self.x .. ',' .. self.y .. ')' end\nfunction Vec:__len() return 2 end\nlocal v = Vec.new(3, 4)\nreturn tostring(v) .. ':' .. v:mag2() .. ':' .. #v"
  assert_lua_str(src_oop, "(3,4):25:2", "OOP __index table, __tostring, __len")

  // __index (function) + __newindex (function) + __call
  let src_fn = "local log = {}\nlocal proxy = setmetatable({}, {\n  __index = function(t, k) return k .. '_val' end,\n  __newindex = function(t, k, v) log[k] = v * 2 end,\n  __call = function(t, a, b) return a + b end,\n})\nproxy.foo = 21\nreturn proxy.bar .. ':' .. log.foo .. ':' .. proxy(10, 5)"
  assert_lua_str(src_fn, "bar_val:42:15", "__index fn, __newindex fn, __call")
}

test "lua_metamethods_arithmetic_concat_and_comparisons" {
  let src = "local mt = {}\nmt.__add = function(a, b) return setmetatable({v = a.v + b.v}, mt) end\nmt.__sub = function(a, b) return setmetatable({v = a.v - b.v}, mt) end\nmt.__mul = function(a, b) return setmetatable({v = a.v * b.v}, mt) end\nmt.__div = function(a, b) return setmetatable({v = a.v / b.v}, mt) end\nmt.__idiv = function(a, b) return setmetatable({v = a.v // b.v}, mt) end\nmt.__mod = function(a, b) return setmetatable({v = a.v % b.v}, mt) end\nmt.__pow = function(a, b) return setmetatable({v = a.v ^ b.v}, mt) end\nmt.__unm = function(a) return setmetatable({v = -a.v}, mt) end\nmt.__concat = function(a, b) return tostring(a.v) .. '+' .. tostring(b.v) end\nmt.__eq = function(a, b) return a.v == b.v end\nmt.__lt = function(a, b) return a.v < b.v end\nmt.__le = function(a, b) return a.v <= b.v end\nlocal function N(x) return setmetatable({v = x}, mt) end\nlocal a, b = N(10), N(3)\nlocal r_add = (a + b).v\nlocal r_sub = (a - b).v\nlocal r_mul = (a * b).v\nlocal r_idiv = (a // b).v\nlocal r_mod = (a % b).v\nlocal r_unm = (-a).v\nlocal r_cat = a .. b\nlocal r_cmp = (b < a) and (b <= a) and (N(10) == a) and not (a < b)\nlocal r_div = math.floor((a / N(2)).v)\nlocal r_pow = math.floor((N(2) ^ b).v)\nreturn r_add == 13 and r_sub == 7 and r_mul == 30 and r_div == 5 and r_idiv == 3 and r_mod == 1 and r_pow == 8 and r_unm == -10 and r_cat == '10+3' and r_cmp"
  assert_lua_bool(src, true, "all arithmetic, concat, and comparison metamethods")
}
