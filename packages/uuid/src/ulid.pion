///| Pure Pion Crockford Base32 ULID and MonotonicUlid implementation.

///| Pure arithmetic Crockford Base32 decoder (zero global LUT, zero RC traffic):
///| - 0-9 -> 0..9
///| - A-H/a-h -> 10..17, I/i/L/l -> 1, J/j -> 18, K/k -> 19, M/m -> 20, N/n -> 21,
///| - O/o -> 0, P-T/p-t -> 22..26, U/u -> -1 (rejected), V-Z/v-z -> 27..31.
fn crockford_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else {
    let lc = c | 32
    if lc >= 97 && lc <= 104 {
      lc - 87
    } else if lc >= 106 && lc <= 107 {
      lc - 88
    } else if lc >= 109 && lc <= 110 {
      lc - 89
    } else if lc >= 112 && lc <= 116 {
      lc - 90
    } else if lc >= 118 && lc <= 122 {
      lc - 91
    } else if lc == 105 || lc == 108 {
      1
    } else if lc == 111 {
      0
    } else {
      -1
    }
  }
}

///|
pub fn Ulid::nil() -> Ulid {
  Ulid::{ hi: 0L, lo: 0L }
}

///|
pub fn Ulid::max() -> Ulid {
  Ulid::{ hi: -1L, lo: -1L }
}

///|
pub fn Ulid::from_u64_pair(hi : UInt64, lo : UInt64) -> Ulid {
  Ulid::{ hi: hi.to_int64(), lo: lo.to_int64() }
}

///|
pub fn Ulid::as_u64_pair(self : Ulid) -> (UInt64, UInt64) {
  (self.hi.to_uint64(), self.lo.to_uint64())
}

///|
pub fn Ulid::from_parts(ts_ms : Int64, rand_hi : Int64, rand_lo : Int64) -> Result[Ulid, UlidError] {
  if ts_ms < 0L || ts_ms > 0xFFFFFFFFFFFFL {
    return Err(UlidError::InvalidTimestamp(ts_ms))
  }
  let hi = (ts_ms.to_uint64() << 16) | (rand_hi.to_uint64() & 0xFFFFUL)
  Ok(Ulid::{ hi: hi.to_int64(), lo: rand_lo })
}

///|
pub fn Ulid::parse_slice(s : String, start : Int, end : Int) -> Result[Ulid, UlidError] {
  let slen = s.length()
  if start < 0 || end < start || end > slen {
    return Err(UlidError::InvalidLength(end - start))
  }
  let len = end - start
  if len != 26 {
    return Err(UlidError::InvalidLength(len))
  }
  let c0 = crockford_val(s.code_unit_at(start))
  let c1 = crockford_val(s.code_unit_at(start + 1))
  let c2 = crockford_val(s.code_unit_at(start + 2))
  let c3 = crockford_val(s.code_unit_at(start + 3))
  let c4 = crockford_val(s.code_unit_at(start + 4))
  let c5 = crockford_val(s.code_unit_at(start + 5))
  let c6 = crockford_val(s.code_unit_at(start + 6))
  let c7 = crockford_val(s.code_unit_at(start + 7))
  let c8 = crockford_val(s.code_unit_at(start + 8))
  let c9 = crockford_val(s.code_unit_at(start + 9))
  let c10 = crockford_val(s.code_unit_at(start + 10))
  let c11 = crockford_val(s.code_unit_at(start + 11))
  let c12 = crockford_val(s.code_unit_at(start + 12))
  let c13 = crockford_val(s.code_unit_at(start + 13))
  let c14 = crockford_val(s.code_unit_at(start + 14))
  let c15 = crockford_val(s.code_unit_at(start + 15))
  let c16 = crockford_val(s.code_unit_at(start + 16))
  let c17 = crockford_val(s.code_unit_at(start + 17))
  let c18 = crockford_val(s.code_unit_at(start + 18))
  let c19 = crockford_val(s.code_unit_at(start + 19))
  let c20 = crockford_val(s.code_unit_at(start + 20))
  let c21 = crockford_val(s.code_unit_at(start + 21))
  let c22 = crockford_val(s.code_unit_at(start + 22))
  let c23 = crockford_val(s.code_unit_at(start + 23))
  let c24 = crockford_val(s.code_unit_at(start + 24))
  let c25 = crockford_val(s.code_unit_at(start + 25))

  let check = c0 | c1 | c2 | c3 | c4 | c5 | c6 | c7 | c8 | c9 |
  c10 | c11 | c12 | c13 | c14 | c15 | c16 | c17 | c18 | c19 |
  c20 | c21 | c22 | c23 | c24 | c25
  if check < 0 {
    let mut i = 0
    while i < 26 {
      let ch = s.code_unit_at(start + i)
      if crockford_val(ch) < 0 {
        return Err(UlidError::InvalidChar(start + i, ch))
      }
      i = i + 1
    }
    return Err(UlidError::InvalidChar(start, s.code_unit_at(start)))
  }
  // Reject 128-bit overflow: first character must be 0..7
  if c0 > 7 {
    return Err(UlidError::Overflow)
  }

  let ts : UInt64 = (c0.to_int64().to_uint64() << 45) |
  (c1.to_int64().to_uint64() << 40) |
  (c2.to_int64().to_uint64() << 35) |
  (c3.to_int64().to_uint64() << 30) |
  (c4.to_int64().to_uint64() << 25) |
  (c5.to_int64().to_uint64() << 20) |
  (c6.to_int64().to_uint64() << 15) |
  (c7.to_int64().to_uint64() << 10) |
  (c8.to_int64().to_uint64() << 5) |
  c9.to_int64().to_uint64()
  let rhi : UInt64 = ((c10 << 11) | (c11 << 6) | (c12 << 1) | (c13 >> 4)).to_int64().to_uint64()
  let hi = (ts << 16) | rhi
  let lo : UInt64 = ((c13 & 0xF).to_int64().to_uint64() << 60) |
  (c14.to_int64().to_uint64() << 55) |
  (c15.to_int64().to_uint64() << 50) |
  (c16.to_int64().to_uint64() << 45) |
  (c17.to_int64().to_uint64() << 40) |
  (c18.to_int64().to_uint64() << 35) |
  (c19.to_int64().to_uint64() << 30) |
  (c20.to_int64().to_uint64() << 25) |
  (c21.to_int64().to_uint64() << 20) |
  (c22.to_int64().to_uint64() << 15) |
  (c23.to_int64().to_uint64() << 10) |
  (c24.to_int64().to_uint64() << 5) |
  c25.to_int64().to_uint64()
  Ok(Ulid::{ hi: hi.to_int64(), lo: lo.to_int64() })
}

///|
pub fn Ulid::parse(s : String) -> Result[Ulid, UlidError] {
  Ulid::parse_slice(s, 0, s.length())
}

///|
fn crockford_enc_char(d : Int) -> Byte {
  let mut ch = d + 48
  if d >= 10 {
    ch = ch + 7
  }
  if d >= 18 {
    ch = ch + 1
  }
  if d >= 20 {
    ch = ch + 1
  }
  if d >= 22 {
    ch = ch + 1
  }
  if d >= 27 {
    ch = ch + 1
  }
  ch.to_byte()
}

///|
pub fn Ulid::encode_bytes(self : Ulid, out : Bytes, off : Int) -> Int {
  if off < 0 || off + 26 > out.length() {
    return 0
  }
  let hi = self.hi.to_uint64()
  let lo = self.lo.to_uint64()
  let ts = hi >> 16
  let rhi = hi & 0xFFFFUL

  out[off] = crockford_enc_char(((ts >> 45) & 31UL).to_int())
  out[off + 1] = crockford_enc_char(((ts >> 40) & 31UL).to_int())
  out[off + 2] = crockford_enc_char(((ts >> 35) & 31UL).to_int())
  out[off + 3] = crockford_enc_char(((ts >> 30) & 31UL).to_int())
  out[off + 4] = crockford_enc_char(((ts >> 25) & 31UL).to_int())
  out[off + 5] = crockford_enc_char(((ts >> 20) & 31UL).to_int())
  out[off + 6] = crockford_enc_char(((ts >> 15) & 31UL).to_int())
  out[off + 7] = crockford_enc_char(((ts >> 10) & 31UL).to_int())
  out[off + 8] = crockford_enc_char(((ts >> 5) & 31UL).to_int())
  out[off + 9] = crockford_enc_char((ts & 31UL).to_int())
  out[off + 10] = crockford_enc_char(((rhi >> 11) & 31UL).to_int())
  out[off + 11] = crockford_enc_char(((rhi >> 6) & 31UL).to_int())
  out[off + 12] = crockford_enc_char(((rhi >> 1) & 31UL).to_int())
  out[off + 13] = crockford_enc_char((((rhi & 1UL) << 4) | (lo >> 60)).to_int())
  out[off + 14] = crockford_enc_char(((lo >> 55) & 31UL).to_int())
  out[off + 15] = crockford_enc_char(((lo >> 50) & 31UL).to_int())
  out[off + 16] = crockford_enc_char(((lo >> 45) & 31UL).to_int())
  out[off + 17] = crockford_enc_char(((lo >> 40) & 31UL).to_int())
  out[off + 18] = crockford_enc_char(((lo >> 35) & 31UL).to_int())
  out[off + 19] = crockford_enc_char(((lo >> 30) & 31UL).to_int())
  out[off + 20] = crockford_enc_char(((lo >> 25) & 31UL).to_int())
  out[off + 21] = crockford_enc_char(((lo >> 20) & 31UL).to_int())
  out[off + 22] = crockford_enc_char(((lo >> 15) & 31UL).to_int())
  out[off + 23] = crockford_enc_char(((lo >> 10) & 31UL).to_int())
  out[off + 24] = crockford_enc_char(((lo >> 5) & 31UL).to_int())
  out[off + 25] = crockford_enc_char((lo & 31UL).to_int())
  26
}

///|
pub fn Ulid::to_string(self : Ulid) -> String {
  let out = Bytes::new(26)
  let _ = self.encode_bytes(out, 0)
  out.to_string()
}

///|
pub fn Ulid::timestamp_ms(self : Ulid) -> Int64 {
  (self.hi.to_uint64() >> 16).to_int64()
}

///|
pub fn Ulid::random_parts(self : Ulid) -> (Int64, Int64) {
  ((self.hi.to_uint64() & 0xFFFFUL).to_int64(), self.lo)
}

///|
pub fn Ulid::from_bytes(bytes : Bytes) -> Result[Ulid, UlidError] {
  let n = bytes.length()
  if n != 16 {
    return Err(UlidError::InvalidBytesLength(n))
  }
  match Uuid::from_bytes(bytes) {
    Ok(u) => Ok(Ulid::{ hi: u.hi, lo: u.lo })
    Err(_) => Err(UlidError::InvalidBytesLength(n))
  }
}

///|
pub fn Ulid::to_bytes(self : Ulid) -> Bytes {
  Uuid::{ hi: self.hi, lo: self.lo }.to_bytes()
}

///|
pub fn Ulid::to_uuid(self : Ulid) -> Uuid {
  Uuid::{ hi: self.hi, lo: self.lo }
}

///|
pub fn Ulid::from_uuid(u : Uuid) -> Ulid {
  Ulid::{ hi: u.hi, lo: u.lo }
}

///|
pub fn Ulid::eq(self : Ulid, other : Ulid) -> Bool {
  self.hi == other.hi && self.lo == other.lo
}

///| Unsigned 128-bit lexicographical comparison (-1, 0, 1).
pub fn Ulid::compare(self : Ulid, other : Ulid) -> Int {
  let a_hi = self.hi.to_uint64()
  let b_hi = other.hi.to_uint64()
  if a_hi < b_hi {
    -1
  } else if a_hi > b_hi {
    1
  } else {
    let a_lo = self.lo.to_uint64()
    let b_lo = other.lo.to_uint64()
    if a_lo < b_lo {
      -1
    } else if a_lo > b_lo {
      1
    } else {
      0
    }
  }
}

///|
fn ulid_lt(a : Ulid, b : Ulid) -> Bool {
  let ah = a.hi.to_uint64()
  let bh = b.hi.to_uint64()
  if ah != bh {
    ah < bh
  } else {
    a.lo.to_uint64() < b.lo.to_uint64()
  }
}

///|
fn ulid_byte_at(u : Ulid, byte_idx : Int) -> Int {
  if byte_idx < 8 {
    let shift = (7 - byte_idx) * 8
    ((u.hi.to_uint64() >> shift) & 0xFFUL).to_int()
  } else {
    let shift = (15 - byte_idx) * 8
    ((u.lo.to_uint64() >> shift) & 0xFFUL).to_int()
  }
}

///|
fn ulid_insertion_sort(arr : Array[Ulid], lo : Int, hi : Int) -> Unit {
  let mut i = lo + 1
  while i < hi {
    let key = arr[i]
    let mut j = i - 1
    while j >= lo && ulid_lt(key, arr[j]) {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

///| In-place 8-bit MSD radix sort (American Flag Sort) for unsigned 128-bit ULIDs.
fn ulid_msd_radix(arr : Array[Ulid], lo : Int, hi : Int, byte_idx : Int) -> Unit {
  let n = hi - lo
  if n <= 32 || byte_idx >= 16 {
    if n > 1 {
      ulid_insertion_sort(arr, lo, hi)
    }
    return
  }
  let counts : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = lo
  while i < hi {
    let b = ulid_byte_at(arr[i], byte_idx)
    counts[b] = counts[b] + 1
    i = i + 1
  }
  let mut non_empty = 0
  let mut b = 0
  while b < 256 {
    if counts[b] > 0 {
      non_empty = non_empty + 1
    }
    b = b + 1
  }
  if non_empty <= 1 {
    ulid_msd_radix(arr, lo, hi, byte_idx + 1)
    return
  }

  let starts : FixedArray[Int] = FixedArray::make(256, 0)
  let ends : FixedArray[Int] = FixedArray::make(256, 0)
  let mut offset = lo
  b = 0
  while b < 256 {
    starts[b] = offset
    offset = offset + counts[b]
    ends[b] = offset
    b = b + 1
  }

  b = 0
  while b < 256 {
    let bend = ends[b]
    while starts[b] < bend {
      let cur_pos = starts[b]
      let mut cur = arr[cur_pos]
      let mut target_b = ulid_byte_at(cur, byte_idx)
      if target_b == b {
        starts[b] = cur_pos + 1
      } else {
        while target_b != b {
          let dest = starts[target_b]
          starts[target_b] = dest + 1
          let next_val = arr[dest]
          arr[dest] = cur
          cur = next_val
          target_b = ulid_byte_at(cur, byte_idx)
        }
        arr[cur_pos] = cur
        starts[b] = cur_pos + 1
      }
    }
    b = b + 1
  }

  let mut start = lo
  b = 0
  while b < 256 {
    let cnt = counts[b]
    if cnt > 32 {
      ulid_msd_radix(arr, start, start + cnt, byte_idx + 1)
    } else if cnt > 1 {
      ulid_insertion_sort(arr, start, start + cnt)
    }
    start = start + cnt
    b = b + 1
  }
}

///| Sort an array of ULIDs in ascending unsigned 128-bit order in-place.
pub fn Ulid::sort(arr : Array[Ulid]) -> Unit {
  let n = arr.length()
  if n > 1 {
    ulid_msd_radix(arr, 0, n, 0)
  }
}

///| Zero-allocation primitive-word ULID parser writing (hi, lo) into `out_pair[0..2]`.
pub fn parse_ulid_slice_raw(s : String, start : Int, end : Int, out_pair : FixedArray[UInt64]) -> Bool {
  let slen = s.length()
  if start < 0 || end < start || end > slen || end - start != 26 {
    return false
  }
  let c0 = crockford_val(s.code_unit_at(start))
  let c1 = crockford_val(s.code_unit_at(start + 1))
  let c2 = crockford_val(s.code_unit_at(start + 2))
  let c3 = crockford_val(s.code_unit_at(start + 3))
  let c4 = crockford_val(s.code_unit_at(start + 4))
  let c5 = crockford_val(s.code_unit_at(start + 5))
  let c6 = crockford_val(s.code_unit_at(start + 6))
  let c7 = crockford_val(s.code_unit_at(start + 7))
  let c8 = crockford_val(s.code_unit_at(start + 8))
  let c9 = crockford_val(s.code_unit_at(start + 9))
  let c10 = crockford_val(s.code_unit_at(start + 10))
  let c11 = crockford_val(s.code_unit_at(start + 11))
  let c12 = crockford_val(s.code_unit_at(start + 12))
  let c13 = crockford_val(s.code_unit_at(start + 13))
  let c14 = crockford_val(s.code_unit_at(start + 14))
  let c15 = crockford_val(s.code_unit_at(start + 15))
  let c16 = crockford_val(s.code_unit_at(start + 16))
  let c17 = crockford_val(s.code_unit_at(start + 17))
  let c18 = crockford_val(s.code_unit_at(start + 18))
  let c19 = crockford_val(s.code_unit_at(start + 19))
  let c20 = crockford_val(s.code_unit_at(start + 20))
  let c21 = crockford_val(s.code_unit_at(start + 21))
  let c22 = crockford_val(s.code_unit_at(start + 22))
  let c23 = crockford_val(s.code_unit_at(start + 23))
  let c24 = crockford_val(s.code_unit_at(start + 24))
  let c25 = crockford_val(s.code_unit_at(start + 25))

  let check = c0 | c1 | c2 | c3 | c4 | c5 | c6 | c7 | c8 | c9 |
  c10 | c11 | c12 | c13 | c14 | c15 | c16 | c17 | c18 | c19 |
  c20 | c21 | c22 | c23 | c24 | c25
  if check < 0 || c0 > 7 {
    return false
  }
  let ts : UInt64 = (c0.to_int64().to_uint64() << 45) |
  (c1.to_int64().to_uint64() << 40) |
  (c2.to_int64().to_uint64() << 35) |
  (c3.to_int64().to_uint64() << 30) |
  (c4.to_int64().to_uint64() << 25) |
  (c5.to_int64().to_uint64() << 20) |
  (c6.to_int64().to_uint64() << 15) |
  (c7.to_int64().to_uint64() << 10) |
  (c8.to_int64().to_uint64() << 5) |
  c9.to_int64().to_uint64()
  let rhi : UInt64 = ((c10 << 11) | (c11 << 6) | (c12 << 1) | (c13 >> 4)).to_int64().to_uint64()
  out_pair[0] = (ts << 16) | rhi
  out_pair[1] = ((c13 & 0xF).to_int64().to_uint64() << 60) |
  (c14.to_int64().to_uint64() << 55) |
  (c15.to_int64().to_uint64() << 50) |
  (c16.to_int64().to_uint64() << 45) |
  (c17.to_int64().to_uint64() << 40) |
  (c18.to_int64().to_uint64() << 35) |
  (c19.to_int64().to_uint64() << 30) |
  (c20.to_int64().to_uint64() << 25) |
  (c21.to_int64().to_uint64() << 20) |
  (c22.to_int64().to_uint64() << 15) |
  (c23.to_int64().to_uint64() << 10) |
  (c24.to_int64().to_uint64() << 5) |
  c25.to_int64().to_uint64()
  true
}

///| Zero-allocation primitive-word ULID Crockford Base32 encoder (inline, zero helper calls).
pub fn encode_ulid_bytes_raw(hi : UInt64, lo : UInt64, out : Bytes, off : Int) -> Int {
  if off < 0 || off + 26 > out.length() {
    return 0
  }
  let alpha = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
  let ts = hi >> 16
  let rhi = hi & 0xFFFFUL
  out[off] = alpha.code_unit_at(((ts >> 45) & 31UL).to_int()).to_byte()
  out[off + 1] = alpha.code_unit_at(((ts >> 40) & 31UL).to_int()).to_byte()
  out[off + 2] = alpha.code_unit_at(((ts >> 35) & 31UL).to_int()).to_byte()
  out[off + 3] = alpha.code_unit_at(((ts >> 30) & 31UL).to_int()).to_byte()
  out[off + 4] = alpha.code_unit_at(((ts >> 25) & 31UL).to_int()).to_byte()
  out[off + 5] = alpha.code_unit_at(((ts >> 20) & 31UL).to_int()).to_byte()
  out[off + 6] = alpha.code_unit_at(((ts >> 15) & 31UL).to_int()).to_byte()
  out[off + 7] = alpha.code_unit_at(((ts >> 10) & 31UL).to_int()).to_byte()
  out[off + 8] = alpha.code_unit_at(((ts >> 5) & 31UL).to_int()).to_byte()
  out[off + 9] = alpha.code_unit_at((ts & 31UL).to_int()).to_byte()
  out[off + 10] = alpha.code_unit_at(((rhi >> 11) & 31UL).to_int()).to_byte()
  out[off + 11] = alpha.code_unit_at(((rhi >> 6) & 31UL).to_int()).to_byte()
  out[off + 12] = alpha.code_unit_at(((rhi >> 1) & 31UL).to_int()).to_byte()
  out[off + 13] = alpha.code_unit_at((((rhi & 1UL) << 4) | (lo >> 60)).to_int()).to_byte()
  out[off + 14] = alpha.code_unit_at(((lo >> 55) & 31UL).to_int()).to_byte()
  out[off + 15] = alpha.code_unit_at(((lo >> 50) & 31UL).to_int()).to_byte()
  out[off + 16] = alpha.code_unit_at(((lo >> 45) & 31UL).to_int()).to_byte()
  out[off + 17] = alpha.code_unit_at(((lo >> 40) & 31UL).to_int()).to_byte()
  out[off + 18] = alpha.code_unit_at(((lo >> 35) & 31UL).to_int()).to_byte()
  out[off + 19] = alpha.code_unit_at(((lo >> 30) & 31UL).to_int()).to_byte()
  out[off + 20] = alpha.code_unit_at(((lo >> 25) & 31UL).to_int()).to_byte()
  out[off + 21] = alpha.code_unit_at(((lo >> 20) & 31UL).to_int()).to_byte()
  out[off + 22] = alpha.code_unit_at(((lo >> 15) & 31UL).to_int()).to_byte()
  out[off + 23] = alpha.code_unit_at(((lo >> 10) & 31UL).to_int()).to_byte()
  out[off + 24] = alpha.code_unit_at(((lo >> 5) & 31UL).to_int()).to_byte()
  out[off + 25] = alpha.code_unit_at((lo & 31UL).to_int()).to_byte()
  26
}

///| Batch-parse newline-delimited 26-char ULIDs into preallocated FixedArrays `his`, `los`. Returns parsed count or -1 on error.
pub fn parse_ulid_lines_fixed(content : String, his : FixedArray[UInt64], los : FixedArray[UInt64]) -> Int {
  let lut : FixedArray[Int] = FixedArray::make(128, -1)
  let alpha = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
  let mut k = 0
  while k < 32 {
    let ch = alpha.code_unit_at(k)
    lut[ch] = k
    if ch >= 65 && ch <= 90 {
      lut[ch + 32] = k
    }
    k = k + 1
  }
  lut[73] = 1
  lut[105] = 1
  lut[76] = 1
  lut[108] = 1
  lut[79] = 0
  lut[111] = 0

  let cap = his.length()
  let clen = content.length()
  let mut pos = 0
  let mut count = 0
  while pos < clen {
    let mut end = pos
    while end < clen && content.code_unit_at(end) != 10 {
      end = end + 1
    }
    let mut line_end = end
    if line_end > pos && content.code_unit_at(line_end - 1) == 13 {
      line_end = line_end - 1
    }
    let len = line_end - pos
    if len > 0 {
      if len != 26 || count >= cap {
        return -1
      }
      let r0 = content.code_unit_at(pos)
      let r1 = content.code_unit_at(pos + 1)
      let r2 = content.code_unit_at(pos + 2)
      let r3 = content.code_unit_at(pos + 3)
      let r4 = content.code_unit_at(pos + 4)
      let r5 = content.code_unit_at(pos + 5)
      let r6 = content.code_unit_at(pos + 6)
      let r7 = content.code_unit_at(pos + 7)
      let r8 = content.code_unit_at(pos + 8)
      let r9 = content.code_unit_at(pos + 9)
      let r10 = content.code_unit_at(pos + 10)
      let r11 = content.code_unit_at(pos + 11)
      let r12 = content.code_unit_at(pos + 12)
      let r13 = content.code_unit_at(pos + 13)
      let r14 = content.code_unit_at(pos + 14)
      let r15 = content.code_unit_at(pos + 15)
      let r16 = content.code_unit_at(pos + 16)
      let r17 = content.code_unit_at(pos + 17)
      let r18 = content.code_unit_at(pos + 18)
      let r19 = content.code_unit_at(pos + 19)
      let r20 = content.code_unit_at(pos + 20)
      let r21 = content.code_unit_at(pos + 21)
      let r22 = content.code_unit_at(pos + 22)
      let r23 = content.code_unit_at(pos + 23)
      let r24 = content.code_unit_at(pos + 24)
      let r25 = content.code_unit_at(pos + 25)
      if ((r0 | r1 | r2 | r3 | r4 | r5 | r6 | r7 | r8 | r9 | r10 | r11 | r12 |
        r13 | r14 | r15 | r16 | r17 | r18 | r19 | r20 | r21 | r22 | r23 | r24 | r25) & -128) != 0 {
        return -1
      }
      let c0 = lut[r0]
      let c1 = lut[r1]
      let c2 = lut[r2]
      let c3 = lut[r3]
      let c4 = lut[r4]
      let c5 = lut[r5]
      let c6 = lut[r6]
      let c7 = lut[r7]
      let c8 = lut[r8]
      let c9 = lut[r9]
      let c10 = lut[r10]
      let c11 = lut[r11]
      let c12 = lut[r12]
      let c13 = lut[r13]
      let c14 = lut[r14]
      let c15 = lut[r15]
      let c16 = lut[r16]
      let c17 = lut[r17]
      let c18 = lut[r18]
      let c19 = lut[r19]
      let c20 = lut[r20]
      let c21 = lut[r21]
      let c22 = lut[r22]
      let c23 = lut[r23]
      let c24 = lut[r24]
      let c25 = lut[r25]
      if (c0 | c1 | c2 | c3 | c4 | c5 | c6 | c7 | c8 | c9 | c10 | c11 | c12 |
        c13 | c14 | c15 | c16 | c17 | c18 | c19 | c20 | c21 | c22 | c23 | c24 | c25) < 0 || c0 > 7 {
        return -1
      }
      let ts : UInt64 = (c0.to_int64().to_uint64() << 45) |
      (c1.to_int64().to_uint64() << 40) |
      (c2.to_int64().to_uint64() << 35) |
      (c3.to_int64().to_uint64() << 30) |
      (c4.to_int64().to_uint64() << 25) |
      (c5.to_int64().to_uint64() << 20) |
      (c6.to_int64().to_uint64() << 15) |
      (c7.to_int64().to_uint64() << 10) |
      (c8.to_int64().to_uint64() << 5) |
      c9.to_int64().to_uint64()
      let rhi : UInt64 = ((c10 << 11) | (c11 << 6) | (c12 << 1) | (c13 >> 4)).to_int64().to_uint64()
      his[count] = (ts << 16) | rhi
      los[count] = ((c13 & 0xF).to_int64().to_uint64() << 60) |
      (c14.to_int64().to_uint64() << 55) |
      (c15.to_int64().to_uint64() << 50) |
      (c16.to_int64().to_uint64() << 45) |
      (c17.to_int64().to_uint64() << 40) |
      (c18.to_int64().to_uint64() << 35) |
      (c19.to_int64().to_uint64() << 30) |
      (c20.to_int64().to_uint64() << 25) |
      (c21.to_int64().to_uint64() << 20) |
      (c22.to_int64().to_uint64() << 15) |
      (c23.to_int64().to_uint64() << 10) |
      (c24.to_int64().to_uint64() << 5) |
      c25.to_int64().to_uint64()
      count = count + 1
    }
    pos = end + 1
  }
  count
}

///| Batch-parse newline-delimited 26-char Crockford Base32 ULIDs into parallel `(his, los)` arrays.
///| Uses a local stack-scoped 128-entry Crockford LUT (zero global RC traffic, zero branch mispredictions).
pub fn parse_ulid_lines_raw(content : String, his : Array[UInt64], los : Array[UInt64]) -> Bool {
  let lut : FixedArray[Int] = FixedArray::make(128, -1)
  let alpha = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
  let mut k = 0
  while k < 32 {
    let ch = alpha.code_unit_at(k)
    lut[ch] = k
    if ch >= 65 && ch <= 90 {
      lut[ch + 32] = k
    }
    k = k + 1
  }
  // Crockford aliases: I/i/L/l -> 1, O/o -> 0
  lut[73] = 1
  lut[105] = 1
  lut[76] = 1
  lut[108] = 1
  lut[79] = 0
  lut[111] = 0

  let clen = content.length()
  let mut pos = 0
  while pos < clen {
    let end = if pos + 26 < clen && content.code_unit_at(pos + 26) == 10 {
      pos + 26
    } else {
      let mut e = pos
      while e < clen && content.code_unit_at(e) != 10 {
        e = e + 1
      }
      e
    }
    let mut line_end = end
    if line_end > pos && content.code_unit_at(line_end - 1) == 13 {
      line_end = line_end - 1
    }
    let len = line_end - pos
    if len > 0 {
      if len != 26 {
        return false
      }
      let r0 = content.code_unit_at(pos)
      let r1 = content.code_unit_at(pos + 1)
      let r2 = content.code_unit_at(pos + 2)
      let r3 = content.code_unit_at(pos + 3)
      let r4 = content.code_unit_at(pos + 4)
      let r5 = content.code_unit_at(pos + 5)
      let r6 = content.code_unit_at(pos + 6)
      let r7 = content.code_unit_at(pos + 7)
      let r8 = content.code_unit_at(pos + 8)
      let r9 = content.code_unit_at(pos + 9)
      let r10 = content.code_unit_at(pos + 10)
      let r11 = content.code_unit_at(pos + 11)
      let r12 = content.code_unit_at(pos + 12)
      let r13 = content.code_unit_at(pos + 13)
      let r14 = content.code_unit_at(pos + 14)
      let r15 = content.code_unit_at(pos + 15)
      let r16 = content.code_unit_at(pos + 16)
      let r17 = content.code_unit_at(pos + 17)
      let r18 = content.code_unit_at(pos + 18)
      let r19 = content.code_unit_at(pos + 19)
      let r20 = content.code_unit_at(pos + 20)
      let r21 = content.code_unit_at(pos + 21)
      let r22 = content.code_unit_at(pos + 22)
      let r23 = content.code_unit_at(pos + 23)
      let r24 = content.code_unit_at(pos + 24)
      let r25 = content.code_unit_at(pos + 25)
      if ((r0 | r1 | r2 | r3 | r4 | r5 | r6 | r7 | r8 | r9 | r10 | r11 | r12 |
        r13 | r14 | r15 | r16 | r17 | r18 | r19 | r20 | r21 | r22 | r23 | r24 | r25) & -128) != 0 {
        return false
      }
      let c0 = lut[r0]
      let c1 = lut[r1]
      let c2 = lut[r2]
      let c3 = lut[r3]
      let c4 = lut[r4]
      let c5 = lut[r5]
      let c6 = lut[r6]
      let c7 = lut[r7]
      let c8 = lut[r8]
      let c9 = lut[r9]
      let c10 = lut[r10]
      let c11 = lut[r11]
      let c12 = lut[r12]
      let c13 = lut[r13]
      let c14 = lut[r14]
      let c15 = lut[r15]
      let c16 = lut[r16]
      let c17 = lut[r17]
      let c18 = lut[r18]
      let c19 = lut[r19]
      let c20 = lut[r20]
      let c21 = lut[r21]
      let c22 = lut[r22]
      let c23 = lut[r23]
      let c24 = lut[r24]
      let c25 = lut[r25]
      if (c0 | c1 | c2 | c3 | c4 | c5 | c6 | c7 | c8 | c9 | c10 | c11 | c12 |
        c13 | c14 | c15 | c16 | c17 | c18 | c19 | c20 | c21 | c22 | c23 | c24 | c25) < 0 || c0 > 7 {
        return false
      }
      let ts : UInt64 = (c0.to_int64().to_uint64() << 45) |
      (c1.to_int64().to_uint64() << 40) |
      (c2.to_int64().to_uint64() << 35) |
      (c3.to_int64().to_uint64() << 30) |
      (c4.to_int64().to_uint64() << 25) |
      (c5.to_int64().to_uint64() << 20) |
      (c6.to_int64().to_uint64() << 15) |
      (c7.to_int64().to_uint64() << 10) |
      (c8.to_int64().to_uint64() << 5) |
      c9.to_int64().to_uint64()
      let rhi : UInt64 = ((c10 << 11) | (c11 << 6) | (c12 << 1) | (c13 >> 4)).to_int64().to_uint64()
      let hi = (ts << 16) | rhi
      let lo : UInt64 = ((c13 & 0xF).to_int64().to_uint64() << 60) |
      (c14.to_int64().to_uint64() << 55) |
      (c15.to_int64().to_uint64() << 50) |
      (c16.to_int64().to_uint64() << 45) |
      (c17.to_int64().to_uint64() << 40) |
      (c18.to_int64().to_uint64() << 35) |
      (c19.to_int64().to_uint64() << 30) |
      (c20.to_int64().to_uint64() << 25) |
      (c21.to_int64().to_uint64() << 20) |
      (c22.to_int64().to_uint64() << 15) |
      (c23.to_int64().to_uint64() << 10) |
      (c24.to_int64().to_uint64() << 5) |
      c25.to_int64().to_uint64()
      his.push(hi)
      los.push(lo)
    }
    pos = end + 1
  }
  true
}

///| Increment the 80-bit random portion by 1 without overflowing into the 48-bit timestamp.
pub fn Ulid::increment(self : Ulid) -> Result[Ulid, UlidError] {
  let lo = self.lo.to_uint64()
  if lo == 0xFFFFFFFFFFFFFFFFUL {
    let hi = self.hi.to_uint64()
    let rhi = hi & 0xFFFFUL
    if rhi == 0xFFFFUL {
      return Err(UlidError::Overflow)
    }
    let next_hi = (hi & 0xFFFFFFFFFFFF0000UL) | (rhi + 1UL)
    Ok(Ulid::{ hi: next_hi.to_int64(), lo: 0L })
  } else {
    Ok(Ulid::{ hi: self.hi, lo: (lo + 1UL).to_int64() })
  }
}

///|
pub fn MonotonicUlid::new() -> MonotonicUlid {
  MonotonicUlid::{ has_last: false, last: Ulid::{ hi: 0L, lo: 0L } }
}

///|
pub fn MonotonicUlid::generate(self : MonotonicUlid, ts_ms : Int64, rand_hi : Int64, rand_lo : Int64) -> Result[Ulid, UlidError] {
  if ts_ms < 0L || ts_ms > 0xFFFFFFFFFFFFL {
    return Err(UlidError::InvalidTimestamp(ts_ms))
  }
  if self.has_last && ts_ms <= self.last.timestamp_ms() {
    match self.last.increment() {
      Ok(next) => {
        self.last = next
        Ok(next)
      }
      Err(e) => Err(e)
    }
  } else {
    let u = Ulid::{ hi: ((ts_ms.to_uint64() << 16) | (rand_hi.to_uint64() & 0xFFFFUL)).to_int64(), lo: rand_lo }
    self.has_last = true
    self.last = u
    Ok(u)
  }
}
