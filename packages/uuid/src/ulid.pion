      let r6 = content.code_unit_at(pos + 6)
      let r7 = content.code_unit_at(pos + 7)
      let r8 = content.code_unit_at(pos + 8)
      let r9 = content.code_unit_at(pos + 9)
      let r10 = content.code_unit_at(pos + 10)
      let r11 = content.code_unit_at(pos + 11)
      let r12 = content.code_unit_at(pos + 12)
      let r13 = content.code_unit_at(pos + 13)
      let r14 = content.code_unit_at(pos + 14)
      let r15 = content.code_unit_at(pos + 15)
      let r16 = content.code_unit_at(pos + 16)
      let r17 = content.code_unit_at(pos + 17)
      let r18 = content.code_unit_at(pos + 18)
      let r19 = content.code_unit_at(pos + 19)
      let r20 = content.code_unit_at(pos + 20)
      let r21 = content.code_unit_at(pos + 21)
      let r22 = content.code_unit_at(pos + 22)
      let r23 = content.code_unit_at(pos + 23)
      let r24 = content.code_unit_at(pos + 24)
      let r25 = content.code_unit_at(pos + 25)
      if ((r0 | r1 | r2 | r3 | r4 | r5 | r6 | r7 | r8 | r9 | r10 | r11 | r12 |
        r13 | r14 | r15 | r16 | r17 | r18 | r19 | r20 | r21 | r22 | r23 | r24 | r25) & -128) != 0 {
        return rollback_ulid_pairs(his, los, orig_h, orig_l)
      }
      let c0 = lut[r0 & 127]
      let c1 = lut[r1 & 127]
      let c2 = lut[r2 & 127]
      let c3 = lut[r3 & 127]
      let c4 = lut[r4 & 127]
      let c5 = lut[r5 & 127]
      let c6 = lut[r6 & 127]
      let c7 = lut[r7 & 127]
      let c8 = lut[r8 & 127]
      let c9 = lut[r9 & 127]
      let c10 = lut[r10 & 127]
      let c11 = lut[r11 & 127]
      let c12 = lut[r12 & 127]
      let c13 = lut[r13 & 127]
      let c14 = lut[r14 & 127]
      let c15 = lut[r15 & 127]
      let c16 = lut[r16 & 127]
      let c17 = lut[r17 & 127]
      let c18 = lut[r18 & 127]
      let c19 = lut[r19 & 127]
      let c20 = lut[r20 & 127]
      let c21 = lut[r21 & 127]
      let c22 = lut[r22 & 127]
      let c23 = lut[r23 & 127]
      let c24 = lut[r24 & 127]
      let c25 = lut[r25 & 127]
      if (c0 | c1 | c2 | c3 | c4 | c5 | c6 | c7 | c8 | c9 | c10 | c11 | c12 |
        c13 | c14 | c15 | c16 | c17 | c18 | c19 | c20 | c21 | c22 | c23 | c24 | c25) < 0 || c0 > 7 {
        return rollback_ulid_pairs(his, los, orig_h, orig_l)
      }
      let ts : UInt64 = (c0.to_int64().to_uint64() << 45) |
      (c1.to_int64().to_uint64() << 40) |
      (c2.to_int64().to_uint64() << 35) |
      (c3.to_int64().to_uint64() << 30) |
      (c4.to_int64().to_uint64() << 25) |
      (c5.to_int64().to_uint64() << 20) |
      (c6.to_int64().to_uint64() << 15) |
      (c7.to_int64().to_uint64() << 10) |
      (c8.to_int64().to_uint64() << 5) |
      c9.to_int64().to_uint64()
      let rhi : UInt64 = ((c10 << 11) | (c11 << 6) | (c12 << 1) | (c13 >> 4)).to_int64().to_uint64()
      let hi = (ts << 16) | rhi
      let lo : UInt64 = ((c13 & 0xF).to_int64().to_uint64() << 60) |
      (c14.to_int64().to_uint64() << 55) |
      (c15.to_int64().to_uint64() << 50) |
      (c16.to_int64().to_uint64() << 45) |
      (c17.to_int64().to_uint64() << 40) |
      (c18.to_int64().to_uint64() << 35) |
      (c19.to_int64().to_uint64() << 30) |
      (c20.to_int64().to_uint64() << 25) |
      (c21.to_int64().to_uint64() << 20) |
      (c22.to_int64().to_uint64() << 15) |
      (c23.to_int64().to_uint64() << 10) |
      (c24.to_int64().to_uint64() << 5) |
      c25.to_int64().to_uint64()
      his.push(hi)
      los.push(lo)
    }
    pos = end + 1
  }
  true
}

///| Increment the 80-bit random portion by 1 without overflowing into the 48-bit timestamp.
#verify
pub fn Ulid::increment(self : Ulid) -> Result[Ulid, UlidError] {
  let lo = self.lo.to_uint64()
  if lo == 0xFFFFFFFFFFFFFFFFUL {
    let hi = self.hi.to_uint64()
    let rhi = hi & 0xFFFFUL
    if rhi == 0xFFFFUL {
      return Err(UlidError::Overflow)
    }
    let next_hi = (hi & 0xFFFFFFFFFFFF0000UL) | (rhi + 1UL)
    Ok(Ulid::{ hi: next_hi.to_int64(), lo: 0L })
  } else {
    Ok(Ulid::{ hi: self.hi, lo: (lo + 1UL).to_int64() })
  }
}

///|
pub fn MonotonicUlid::new() -> MonotonicUlid {
  MonotonicUlid::{ has_last: false, last: Ulid::{ hi: 0L, lo: 0L } }
}

///|
pub fn MonotonicUlid::generate(self : MonotonicUlid, ts_ms : Int64, rand_hi : Int64, rand_lo : Int64) -> Result[Ulid, UlidError] {
  if ts_ms < 0L || ts_ms > 0xFFFFFFFFFFFFL {
    return Err(UlidError::InvalidTimestamp(ts_ms))
  }
  if self.has_last && ts_ms <= self.last.timestamp_ms() {
    match self.last.increment() {
      Ok(next) => {
        self.last = next
        Ok(next)
      }
      Err(e) => Err(e)
    }
  } else {
    let u = Ulid::{ hi: ((ts_ms.to_uint64() << 16) | (rand_hi.to_uint64() & 0xFFFFUL)).to_int64(), lo: rand_lo }
    self.has_last = true
    self.last = u
    Ok(u)
  }
}
