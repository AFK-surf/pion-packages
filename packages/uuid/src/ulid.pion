///| Crockford Base32 ULID & MonotonicUlid public API stubs (Red phase).

///|
pub fn Ulid::nil() -> Ulid {
  Ulid::{ hi: 0L, lo: 0L }
}

///|
pub fn Ulid::max() -> Ulid {
  Ulid::{ hi: 0L, lo: 0L }
}

///|
pub fn Ulid::from_u64_pair(hi : UInt64, lo : UInt64) -> Ulid {
  let _ = hi
  let _ = lo
  Ulid::{ hi: 0L, lo: 0L }
}

///|
pub fn Ulid::as_u64_pair(self : Ulid) -> (UInt64, UInt64) {
  let _ = self
  (0UL, 0UL)
}

///|
pub fn Ulid::from_parts(ts_ms : Int64, rand_hi : Int64, rand_lo : Int64) -> Result[Ulid, UlidError] {
  let _ = ts_ms
  let _ = rand_hi
  let _ = rand_lo
  Err(UlidError::InvalidTimestamp(0L))
}

///|
pub fn Ulid::parse(s : String) -> Result[Ulid, UlidError] {
  let _ = s
  Err(UlidError::InvalidLength(0))
}

///|
pub fn Ulid::parse_slice(s : String, start : Int, end : Int) -> Result[Ulid, UlidError] {
  let _ = s
  let _ = start
  let _ = end
  Err(UlidError::InvalidLength(0))
}

///|
pub fn Ulid::to_string(self : Ulid) -> String {
  let _ = self
  ""
}

///|
pub fn Ulid::encode_bytes(self : Ulid, out : Bytes, off : Int) -> Int {
  let _ = self
  let _ = out
  let _ = off
  0
}

///|
pub fn Ulid::timestamp_ms(self : Ulid) -> Int64 {
  let _ = self
  0L
}

///|
pub fn Ulid::random_parts(self : Ulid) -> (Int64, Int64) {
  let _ = self
  (0L, 0L)
}

///|
pub fn Ulid::from_bytes(bytes : Bytes) -> Result[Ulid, UlidError] {
  let _ = bytes
  Err(UlidError::InvalidBytesLength(0))
}

///|
pub fn Ulid::to_bytes(self : Ulid) -> Bytes {
  let _ = self
  Bytes::new(16)
}

///|
pub fn Ulid::to_uuid(self : Ulid) -> Uuid {
  let _ = self
  Uuid::{ hi: 0L, lo: 0L }
}

///|
pub fn Ulid::from_uuid(u : Uuid) -> Ulid {
  let _ = u
  Ulid::{ hi: 0L, lo: 0L }
}

///|
pub fn Ulid::eq(self : Ulid, other : Ulid) -> Bool {
  let _ = self
  let _ = other
  false
}

///|
pub fn Ulid::compare(self : Ulid, other : Ulid) -> Int {
  let _ = self
  let _ = other
  0
}

///|
pub fn Ulid::increment(self : Ulid) -> Result[Ulid, UlidError] {
  let _ = self
  Err(UlidError::Overflow)
}

///|
pub fn MonotonicUlid::new() -> MonotonicUlid {
  MonotonicUlid::{ has_last: false, last: Ulid::{ hi: 0L, lo: 0L } }
}

///|
pub fn MonotonicUlid::generate(self : MonotonicUlid, ts_ms : Int64, rand_hi : Int64, rand_lo : Int64) -> Result[Ulid, UlidError] {
  let _ = self
  let _ = ts_ms
  let _ = rand_hi
  let _ = rand_lo
  Err(UlidError::InvalidTimestamp(0L))
}
