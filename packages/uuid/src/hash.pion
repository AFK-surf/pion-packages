///| Pure Pion RFC 1321 MD5 and FIPS 180-4 SHA-1 hash implementations.
///| Zero-copy block streaming: processes full 64-byte blocks directly from input
///| and only pads the final 1-2 blocks in a small 128-byte buffer.

///|
fn rotl32(x : UInt, n : UInt) -> UInt {
  ((x << n) | (x >> (32U - n))) & 0xFFFFFFFFU
}

///|
let md5_k : FixedArray[UInt] = [
  0xd76aa478U, 0xe8c7b756U, 0x242070dbU, 0xc1bdceeeU,
  0xf57c0fafU, 0x4787c62aU, 0xa8304613U, 0xfd469501U,
  0x698098d8U, 0x8b44f7afU, 0xffff5bb1U, 0x895cd7beU,
  0x6b901122U, 0xfd987193U, 0xa679438eU, 0x49b40821U,
  0xf61e2562U, 0xc040b340U, 0x265e5a51U, 0xe9b6c7aaU,
  0xd62f105dU, 0x02441453U, 0xd8a1e681U, 0xe7d3fbc8U,
  0x21e1cde6U, 0xc33707d6U, 0xf4d50d87U, 0x455a14edU,
  0xa9e3e905U, 0xfcefa3f8U, 0x676f02d9U, 0x8d2a4c8aU,
  0xfffa3942U, 0x8771f681U, 0x6d9d6122U, 0xfde5380cU,
  0xa4beea44U, 0x4bdecfa9U, 0xf6bb4b60U, 0xbebfbc70U,
  0x289b7ec6U, 0xeaa127faU, 0xd4ef3085U, 0x04881d05U,
  0xd9d4d039U, 0xe6db99e5U, 0x1fa27cf8U, 0xc4ac5665U,
  0xf4292244U, 0x432aff97U, 0xab9423a7U, 0xfc93a039U,
  0x655b59c3U, 0x8f0ccc92U, 0xffeff47dU, 0x85845dd1U,
  0x6fa87e4fU, 0xfe2ce6e0U, 0xa3014314U, 0x4e0811a1U,
  0xf7537e82U, 0xbd3af235U, 0x2ad7d2bbU, 0xeb86d391U,
]

///|
let md5_s : FixedArray[UInt] = [
  7U, 12U, 17U, 22U, 7U, 12U, 17U, 22U, 7U, 12U, 17U, 22U, 7U, 12U, 17U, 22U,
  5U, 9U, 14U, 20U, 5U, 9U, 14U, 20U, 5U, 9U, 14U, 20U, 5U, 9U, 14U, 20U,
  4U, 11U, 16U, 23U, 4U, 11U, 16U, 23U, 4U, 11U, 16U, 23U, 4U, 11U, 16U, 23U,
  6U, 10U, 15U, 21U, 6U, 10U, 15U, 21U, 6U, 10U, 15U, 21U, 6U, 10U, 15U, 21U,
]

///|
fn md5_compress(state : FixedArray[UInt], m : FixedArray[UInt]) -> Unit {
  let mut a = state[0]
  let mut b = state[1]
  let mut c = state[2]
  let mut d = state[3]

  let mut i = 0
  while i < 16 {
    let f = (b & c) | ((b ^ 0xFFFFFFFFU) & d)
    let tmp = (a + f + md5_k[i] + m[i]) & 0xFFFFFFFFU
    let na = d
    d = c
    c = b
    b = (b + rotl32(tmp, md5_s[i])) & 0xFFFFFFFFU
    a = na
    i = i + 1
  }
  while i < 32 {
    let f = (d & b) | ((d ^ 0xFFFFFFFFU) & c)
    let g = (5 * i + 1) & 15
    let tmp = (a + f + md5_k[i] + m[g]) & 0xFFFFFFFFU
    let na = d
    d = c
    c = b
    b = (b + rotl32(tmp, md5_s[i])) & 0xFFFFFFFFU
    a = na
    i = i + 1
  }
  while i < 48 {
    let f = b ^ c ^ d
    let g = (3 * i + 5) & 15
    let tmp = (a + f + md5_k[i] + m[g]) & 0xFFFFFFFFU
    let na = d
    d = c
    c = b
    b = (b + rotl32(tmp, md5_s[i])) & 0xFFFFFFFFU
    a = na
    i = i + 1
  }
  while i < 64 {
    let f = c ^ (b | (d ^ 0xFFFFFFFFU))
    let g = (7 * i) & 15
    let tmp = (a + f + md5_k[i] + m[g]) & 0xFFFFFFFFU
    let na = d
    d = c
    c = b
    b = (b + rotl32(tmp, md5_s[i])) & 0xFFFFFFFFU
    a = na
    i = i + 1
  }

  state[0] = (state[0] + a) & 0xFFFFFFFFU
  state[1] = (state[1] + b) & 0xFFFFFFFFU
  state[2] = (state[2] + c) & 0xFFFFFFFFU
  state[3] = (state[3] + d) & 0xFFFFFFFFU
}

///|
fn md5_load_le(buf : Bytes, off : Int, m : FixedArray[UInt]) -> Unit {
  let mut i = 0
  while i < 16 {
    let p = off + i * 4
    let b0 = buf[p].to_int().to_uint()
    let b1 = buf[p + 1].to_int().to_uint()
    let b2 = buf[p + 2].to_int().to_uint()
    let b3 = buf[p + 3].to_int().to_uint()
    m[i] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    i = i + 1
  }
}

///|
fn md5_state_to_u64_pair(state : FixedArray[UInt]) -> (UInt64, UInt64) {
  // Each 32-bit word is output little-endian into the 16-byte digest,
  // then read big-endian as (hi, lo).
  let s0 = state[0]
  let s1 = state[1]
  let s2 = state[2]
  let s3 = state[3]
  let w0 = ((s0 & 0xFFU) << 24) | ((s0 & 0xFF00U) << 8) | ((s0 >> 8) & 0xFF00U) | ((s0 >> 24) & 0xFFU)
  let w1 = ((s1 & 0xFFU) << 24) | ((s1 & 0xFF00U) << 8) | ((s1 >> 8) & 0xFF00U) | ((s1 >> 24) & 0xFFU)
  let w2 = ((s2 & 0xFFU) << 24) | ((s2 & 0xFF00U) << 8) | ((s2 >> 8) & 0xFF00U) | ((s2 >> 24) & 0xFFU)
  let w3 = ((s3 & 0xFFU) << 24) | ((s3 & 0xFF00U) << 8) | ((s3 >> 8) & 0xFF00U) | ((s3 >> 24) & 0xFFU)
  let hi = (w0.to_uint64() << 32) | w1.to_uint64()
  let lo = (w2.to_uint64() << 32) | w3.to_uint64()
  (hi, lo)
}

///| Compute RFC 1321 MD5 16-byte digest.
pub fn md5(data : Bytes) -> Bytes {
  let len = data.length()
  let state : FixedArray[UInt] = [0x67452301U, 0xefcdab89U, 0x98badcfeU, 0x10325476U]
  let m : FixedArray[UInt] = FixedArray::make(16, 0U)

  let mut off = 0
  while off + 64 <= len {
    md5_load_le(data, off, m)
    md5_compress(state, m)
    off = off + 64
  }

  let rem = len - off
  let tail_blocks = if rem < 56 { 64 } else { 128 }
  let mut tail = Bytes::new(tail_blocks)
  let mut i = 0
  while i < rem {
    tail[i] = data[off + i]
    i = i + 1
  }
  tail[rem] = (0x80).to_byte()
  let bit_len : UInt64 = len.to_int64().to_uint64() << 3
  let mut bi = 0
  while bi < 8 {
    tail[tail_blocks - 8 + bi] = ((bit_len >> (bi * 8)) & 0xFFUL).to_int().to_byte()
    bi = bi + 1
  }
  md5_load_le(tail, 0, m)
  md5_compress(state, m)
  if tail_blocks == 128 {
    md5_load_le(tail, 64, m)
    md5_compress(state, m)
  }

  let mut digest = Bytes::new(16)
  let mut wi = 0
  while wi < 4 {
    let w = state[wi]
    digest[wi * 4] = (w & 0xFFU).to_int().to_byte()
    digest[wi * 4 + 1] = ((w >> 8) & 0xFFU).to_int().to_byte()
    digest[wi * 4 + 2] = ((w >> 16) & 0xFFU).to_int().to_byte()
    digest[wi * 4 + 3] = ((w >> 24) & 0xFFU).to_int().to_byte()
    wi = wi + 1
  }
  digest
}

///| Compute MD5(namespace_be16 || name) returning raw 128-bit (hi, lo) without concatenating buffers.
fn md5_ns_name(ns_hi : UInt64, ns_lo : UInt64, name : Bytes) -> (UInt64, UInt64) {
  let nlen = name.length()
  let total_len = 16 + nlen
  let state : FixedArray[UInt] = [0x67452301U, 0xefcdab89U, 0x98badcfeU, 0x10325476U]
  let m : FixedArray[UInt] = FixedArray::make(16, 0U)

  // Fast path: 16 + nlen < 56 -> single 64-byte block
  let mut blk = Bytes::new(64)
  blk[0] = ((ns_hi >> 56) & 0xFFUL).to_int().to_byte()
  blk[1] = ((ns_hi >> 48) & 0xFFUL).to_int().to_byte()
  blk[2] = ((ns_hi >> 40) & 0xFFUL).to_int().to_byte()
  blk[3] = ((ns_hi >> 32) & 0xFFUL).to_int().to_byte()
  blk[4] = ((ns_hi >> 24) & 0xFFUL).to_int().to_byte()
  blk[5] = ((ns_hi >> 16) & 0xFFUL).to_int().to_byte()
  blk[6] = ((ns_hi >> 8) & 0xFFUL).to_int().to_byte()
  blk[7] = (ns_hi & 0xFFUL).to_int().to_byte()
  blk[8] = ((ns_lo >> 56) & 0xFFUL).to_int().to_byte()
  blk[9] = ((ns_lo >> 48) & 0xFFUL).to_int().to_byte()
  blk[10] = ((ns_lo >> 40) & 0xFFUL).to_int().to_byte()
  blk[11] = ((ns_lo >> 32) & 0xFFUL).to_int().to_byte()
  blk[12] = ((ns_lo >> 24) & 0xFFUL).to_int().to_byte()
  blk[13] = ((ns_lo >> 16) & 0xFFUL).to_int().to_byte()
  blk[14] = ((ns_lo >> 8) & 0xFFUL).to_int().to_byte()
  blk[15] = (ns_lo & 0xFFUL).to_int().to_byte()

  if total_len < 56 {
    let mut i = 0
    while i < nlen {
      blk[16 + i] = name[i]
      i = i + 1
    }
    blk[total_len] = (0x80).to_byte()
    let bit_len : UInt64 = total_len.to_int64().to_uint64() << 3
    let mut bi = 0
    while bi < 8 {
      blk[56 + bi] = ((bit_len >> (bi * 8)) & 0xFFUL).to_int().to_byte()
      bi = bi + 1
    }
    md5_load_le(blk, 0, m)
    md5_compress(state, m)
    return md5_state_to_u64_pair(state)
  }

  // General path: fill first 64-byte block, then stream remaining full blocks
  let first_take = if nlen < 48 { nlen } else { 48 }
  let mut i = 0
  while i < first_take {
    blk[16 + i] = name[i]
    i = i + 1
  }
  if first_take < 48 {
    // 56 <= total_len < 64: pad across two blocks
    blk[16 + first_take] = (0x80).to_byte()
    md5_load_le(blk, 0, m)
    md5_compress(state, m)
    let mut blk2 = Bytes::new(64)
    let bit_len : UInt64 = total_len.to_int64().to_uint64() << 3
    let mut bi = 0
    while bi < 8 {
      blk2[56 + bi] = ((bit_len >> (bi * 8)) & 0xFFUL).to_int().to_byte()
      bi = bi + 1
    }
    md5_load_le(blk2, 0, m)
    md5_compress(state, m)
    return md5_state_to_u64_pair(state)
  }

  md5_load_le(blk, 0, m)
  md5_compress(state, m)

  let mut off = 48
  while off + 64 <= nlen {
    md5_load_le(name, off, m)
    md5_compress(state, m)
    off = off + 64
  }
  let rem = nlen - off
  let tail_blocks = if rem < 56 { 64 } else { 128 }
  let mut tail = Bytes::new(tail_blocks)
  let mut j = 0
  while j < rem {
    tail[j] = name[off + j]
    j = j + 1
  }
  tail[rem] = (0x80).to_byte()
  let bit_len : UInt64 = total_len.to_int64().to_uint64() << 3
  let mut bi = 0
  while bi < 8 {
    tail[tail_blocks - 8 + bi] = ((bit_len >> (bi * 8)) & 0xFFUL).to_int().to_byte()
    bi = bi + 1
  }
  md5_load_le(tail, 0, m)
  md5_compress(state, m)
  if tail_blocks == 128 {
    md5_load_le(tail, 64, m)
    md5_compress(state, m)
  }
  md5_state_to_u64_pair(state)
}

///| SHA-1 compression function on 16 initial big-endian words in `w[0..16]` (expands into `w[16..80]`).
fn sha1_compress(state : FixedArray[UInt], w : FixedArray[UInt]) -> Unit {
  let mut t = 16
  while t < 80 {
    w[t] = rotl32(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1U)
    t = t + 1
  }

  let mut a = state[0]
  let mut b = state[1]
  let mut c = state[2]
  let mut d = state[3]
  let mut e = state[4]

  t = 0
  while t < 20 {
    let f = (b & c) | ((b ^ 0xFFFFFFFFU) & d)
    let tmp = (rotl32(a, 5U) + f + e + 0x5A827999U + w[t]) & 0xFFFFFFFFU
    e = d
    d = c
    c = rotl32(b, 30U)
    b = a
    a = tmp
    t = t + 1
  }
  while t < 40 {
    let f = b ^ c ^ d
    let tmp = (rotl32(a, 5U) + f + e + 0x6ED9EBA1U + w[t]) & 0xFFFFFFFFU
    e = d
    d = c
    c = rotl32(b, 30U)
    b = a
    a = tmp
    t = t + 1
  }
  while t < 60 {
    let f = (b & c) | (b & d) | (c & d)
    let tmp = (rotl32(a, 5U) + f + e + 0x8F1BBCDCU + w[t]) & 0xFFFFFFFFU
    e = d
    d = c
    c = rotl32(b, 30U)
    b = a
    a = tmp
    t = t + 1
  }
  while t < 80 {
    let f = b ^ c ^ d
    let tmp = (rotl32(a, 5U) + f + e + 0xCA62C1D6U + w[t]) & 0xFFFFFFFFU
    e = d
    d = c
    c = rotl32(b, 30U)
    b = a
    a = tmp
    t = t + 1
  }

  state[0] = (state[0] + a) & 0xFFFFFFFFU
  state[1] = (state[1] + b) & 0xFFFFFFFFU
  state[2] = (state[2] + c) & 0xFFFFFFFFU
  state[3] = (state[3] + d) & 0xFFFFFFFFU
  state[4] = (state[4] + e) & 0xFFFFFFFFU
}

///|
fn sha1_load_be(buf : Bytes, off : Int, w : FixedArray[UInt]) -> Unit {
  let mut t = 0
  while t < 16 {
    let p = off + t * 4
    let b0 = buf[p].to_int().to_uint()
    let b1 = buf[p + 1].to_int().to_uint()
    let b2 = buf[p + 2].to_int().to_uint()
    let b3 = buf[p + 3].to_int().to_uint()
    w[t] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    t = t + 1
  }
}

///| Compute FIPS 180-4 SHA-1 20-byte digest.
pub fn sha1(data : Bytes) -> Bytes {
  let len = data.length()
  let state : FixedArray[UInt] = [0x67452301U, 0xEFCDAB89U, 0x98BADCFEU, 0x10325476U, 0xC3D2E1F0U]
  let w : FixedArray[UInt] = FixedArray::make(80, 0U)

  let mut off = 0
  while off + 64 <= len {
    sha1_load_be(data, off, w)
    sha1_compress(state, w)
    off = off + 64
  }

  let rem = len - off
  let tail_blocks = if rem < 56 { 64 } else { 128 }
  let mut tail = Bytes::new(tail_blocks)
  let mut i = 0
  while i < rem {
    tail[i] = data[off + i]
    i = i + 1
  }
  tail[rem] = (0x80).to_byte()
  let bit_len : UInt64 = len.to_int64().to_uint64() << 3
  let mut bi = 0
  while bi < 8 {
    let shift : Int = (7 - bi) * 8
    tail[tail_blocks - 8 + bi] = ((bit_len >> shift) & 0xFFUL).to_int().to_byte()
    bi = bi + 1
  }
  sha1_load_be(tail, 0, w)
  sha1_compress(state, w)
  if tail_blocks == 128 {
    sha1_load_be(tail, 64, w)
    sha1_compress(state, w)
  }

  let mut digest = Bytes::new(20)
  let mut hi = 0
  while hi < 5 {
    let hv = state[hi]
    digest[hi * 4] = ((hv >> 24) & 0xFFU).to_int().to_byte()
    digest[hi * 4 + 1] = ((hv >> 16) & 0xFFU).to_int().to_byte()
    digest[hi * 4 + 2] = ((hv >> 8) & 0xFFU).to_int().to_byte()
    digest[hi * 4 + 3] = (hv & 0xFFU).to_int().to_byte()
    hi = hi + 1
  }
  digest
}

///| Compute SHA-1(namespace_be16 || name) returning the first 16 bytes as (hi, lo) without concatenating buffers.
fn sha1_ns_name(ns_hi : UInt64, ns_lo : UInt64, name : Bytes) -> (UInt64, UInt64) {
  let nlen = name.length()
  let total_len = 16 + nlen
  let state : FixedArray[UInt] = [0x67452301U, 0xEFCDAB89U, 0x98BADCFEU, 0x10325476U, 0xC3D2E1F0U]
  let w : FixedArray[UInt] = FixedArray::make(80, 0U)

  // Fast path: 16 + nlen < 56 -> single 64-byte block directly into w[0..16] (no blk Bytes alloc!)
  if total_len < 56 {
    w[0] = ((ns_hi >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
    w[1] = (ns_hi & 0xFFFFFFFFUL).to_int().to_uint()
    w[2] = ((ns_lo >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
    w[3] = (ns_lo & 0xFFFFFFFFUL).to_int().to_uint()
    let mut wi = 4
    while wi < 14 {
      w[wi] = 0U
      wi = wi + 1
    }
    let mut i = 0
    while i < nlen {
      let pos = 16 + i
      let idx = pos >> 2
      let shift = (3 - (pos & 3)) * 8
      w[idx] = w[idx] | (name[i].to_int().to_uint() << shift.to_uint())
      i = i + 1
    }
    let pad_idx = total_len >> 2
    let pad_shift = (3 - (total_len & 3)) * 8
    w[pad_idx] = w[pad_idx] | (0x80U << pad_shift.to_uint())
    let bit_len : UInt64 = total_len.to_int64().to_uint64() << 3
    w[14] = ((bit_len >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
    w[15] = (bit_len & 0xFFFFFFFFUL).to_int().to_uint()
    sha1_compress(state, w)
    let hi = (state[0].to_uint64() << 32) | state[1].to_uint64()
    let lo = (state[2].to_uint64() << 32) | state[3].to_uint64()
    return (hi, lo)
  }

  let mut blk = Bytes::new(64)
  blk[0] = ((ns_hi >> 56) & 0xFFUL).to_int().to_byte()
  blk[1] = ((ns_hi >> 48) & 0xFFUL).to_int().to_byte()
  blk[2] = ((ns_hi >> 40) & 0xFFUL).to_int().to_byte()
  blk[3] = ((ns_hi >> 32) & 0xFFUL).to_int().to_byte()
  blk[4] = ((ns_hi >> 24) & 0xFFUL).to_int().to_byte()
  blk[5] = ((ns_hi >> 16) & 0xFFUL).to_int().to_byte()
  blk[6] = ((ns_hi >> 8) & 0xFFUL).to_int().to_byte()
  blk[7] = (ns_hi & 0xFFUL).to_int().to_byte()
  blk[8] = ((ns_lo >> 56) & 0xFFUL).to_int().to_byte()
  blk[9] = ((ns_lo >> 48) & 0xFFUL).to_int().to_byte()
  blk[10] = ((ns_lo >> 40) & 0xFFUL).to_int().to_byte()
  blk[11] = ((ns_lo >> 32) & 0xFFUL).to_int().to_byte()
  blk[12] = ((ns_lo >> 24) & 0xFFUL).to_int().to_byte()
  blk[13] = ((ns_lo >> 16) & 0xFFUL).to_int().to_byte()
  blk[14] = ((ns_lo >> 8) & 0xFFUL).to_int().to_byte()
  blk[15] = (ns_lo & 0xFFUL).to_int().to_byte()

  let first_take = if nlen < 48 { nlen } else { 48 }
  let mut i = 0
  while i < first_take {
    blk[16 + i] = name[i]
    i = i + 1
  }
  if first_take < 48 {
    blk[16 + first_take] = (0x80).to_byte()
    sha1_load_be(blk, 0, w)
    sha1_compress(state, w)
    let mut wi = 0
    while wi < 14 {
      w[wi] = 0U
      wi = wi + 1
    }
    let bit_len : UInt64 = total_len.to_int64().to_uint64() << 3
    w[14] = ((bit_len >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
    w[15] = (bit_len & 0xFFFFFFFFUL).to_int().to_uint()
    sha1_compress(state, w)
    let hi = (state[0].to_uint64() << 32) | state[1].to_uint64()
    let lo = (state[2].to_uint64() << 32) | state[3].to_uint64()
    return (hi, lo)
  }

  sha1_load_be(blk, 0, w)
  sha1_compress(state, w)

  let mut off = 48
  while off + 64 <= nlen {
    sha1_load_be(name, off, w)
    sha1_compress(state, w)
    off = off + 64
  }
  let rem = nlen - off
  let tail_blocks = if rem < 56 { 64 } else { 128 }
  let mut tail = Bytes::new(tail_blocks)
  let mut j = 0
  while j < rem {
    tail[j] = name[off + j]
    j = j + 1
  }
  tail[rem] = (0x80).to_byte()
  let bit_len : UInt64 = total_len.to_int64().to_uint64() << 3
  let mut bi = 0
  while bi < 8 {
    let shift : Int = (7 - bi) * 8
    tail[tail_blocks - 8 + bi] = ((bit_len >> shift) & 0xFFUL).to_int().to_byte()
    bi = bi + 1
  }
  sha1_load_be(tail, 0, w)
  sha1_compress(state, w)
  if tail_blocks == 128 {
    sha1_load_be(tail, 64, w)
    sha1_compress(state, w)
  }
  let hi = (state[0].to_uint64() << 32) | state[1].to_uint64()
  let lo = (state[2].to_uint64() << 32) | state[3].to_uint64()
  (hi, lo)
}
