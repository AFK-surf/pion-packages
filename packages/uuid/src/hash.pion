///| Pure Pion RFC 1321 MD5 and FIPS 180-4 SHA-1 hash implementations.
///| Zero-copy block streaming: processes full 64-byte blocks directly from input
///| and only pads the final 1-2 blocks in a small 128-byte buffer.

///|
fn rotl32(x : UInt, n : UInt) -> UInt {
  (x << n) | (x >> (32U - n))
}

///|
let md5_k : FixedArray[UInt] = [
  0xd76aa478U, 0xe8c7b756U, 0x242070dbU, 0xc1bdceeeU,
  0xf57c0fafU, 0x4787c62aU, 0xa8304613U, 0xfd469501U,
  0x698098d8U, 0x8b44f7afU, 0xffff5bb1U, 0x895cd7beU,
  0x6b901122U, 0xfd987193U, 0xa679438eU, 0x49b40821U,
  0xf61e2562U, 0xc040b340U, 0x265e5a51U, 0xe9b6c7aaU,
  0xd62f105dU, 0x02441453U, 0xd8a1e681U, 0xe7d3fbc8U,
  0x21e1cde6U, 0xc33707d6U, 0xf4d50d87U, 0x455a14edU,
  0xa9e3e905U, 0xfcefa3f8U, 0x676f02d9U, 0x8d2a4c8aU,
  0xfffa3942U, 0x8771f681U, 0x6d9d6122U, 0xfde5380cU,
  0xa4beea44U, 0x4bdecfa9U, 0xf6bb4b60U, 0xbebfbc70U,
  0x289b7ec6U, 0xeaa127faU, 0xd4ef3085U, 0x04881d05U,
  0xd9d4d039U, 0xe6db99e5U, 0x1fa27cf8U, 0xc4ac5665U,
  0xf4292244U, 0x432aff97U, 0xab9423a7U, 0xfc93a039U,
  0x655b59c3U, 0x8f0ccc92U, 0xffeff47dU, 0x85845dd1U,
  0x6fa87e4fU, 0xfe2ce6e0U, 0xa3014314U, 0x4e0811a1U,
  0xf7537e82U, 0xbd3af235U, 0x2ad7d2bbU, 0xeb86d391U,
]

///|
let md5_s : FixedArray[UInt] = [
  7U, 12U, 17U, 22U, 7U, 12U, 17U, 22U, 7U, 12U, 17U, 22U, 7U, 12U, 17U, 22U,
  5U, 9U, 14U, 20U, 5U, 9U, 14U, 20U, 5U, 9U, 14U, 20U, 5U, 9U, 14U, 20U,
  4U, 11U, 16U, 23U, 4U, 11U, 16U, 23U, 4U, 11U, 16U, 23U, 4U, 11U, 16U, 23U,
  6U, 10U, 15U, 21U, 6U, 10U, 15U, 21U, 6U, 10U, 15U, 21U, 6U, 10U, 15U, 21U,
]

///|
fn md5_compress(state : FixedArray[UInt], m : FixedArray[UInt]) -> Unit {
  let mut a = state[0]
  let mut b = state[1]
  let mut c = state[2]
  let mut d = state[3]

  let mut i = 0
  while i < 16 {
    let f = (b & c) | ((b ^ 0xFFFFFFFFU) & d)
    let tmp = (a + f + md5_k[i] + m[i]) & 0xFFFFFFFFU
    let na = d
    d = c
    c = b
    b = (b + rotl32(tmp, md5_s[i])) & 0xFFFFFFFFU
    a = na
    i = i + 1
  }
  while i < 32 {
    let f = (d & b) | ((d ^ 0xFFFFFFFFU) & c)
    let g = (5 * i + 1) & 15
    let tmp = (a + f + md5_k[i] + m[g]) & 0xFFFFFFFFU
    let na = d
    d = c
    c = b
    b = (b + rotl32(tmp, md5_s[i])) & 0xFFFFFFFFU
    a = na
    i = i + 1
  }
  while i < 48 {
    let f = b ^ c ^ d
    let g = (3 * i + 5) & 15
    let tmp = (a + f + md5_k[i] + m[g]) & 0xFFFFFFFFU
    let na = d
    d = c
    c = b
    b = (b + rotl32(tmp, md5_s[i])) & 0xFFFFFFFFU
    a = na
    i = i + 1
  }
  while i < 64 {
    let f = c ^ (b | (d ^ 0xFFFFFFFFU))
    let g = (7 * i) & 15
    let tmp = (a + f + md5_k[i] + m[g]) & 0xFFFFFFFFU
    let na = d
    d = c
    c = b
    b = (b + rotl32(tmp, md5_s[i])) & 0xFFFFFFFFU
    a = na
    i = i + 1
  }

  state[0] = (state[0] + a) & 0xFFFFFFFFU
  state[1] = (state[1] + b) & 0xFFFFFFFFU
  state[2] = (state[2] + c) & 0xFFFFFFFFU
  state[3] = (state[3] + d) & 0xFFFFFFFFU
}

///|
fn md5_load_le(buf : Bytes, off : Int, m : FixedArray[UInt]) -> Unit {
  let mut i = 0
  while i < 16 {
    let p = off + i * 4
    let b0 = buf[p].to_int().to_uint()
    let b1 = buf[p + 1].to_int().to_uint()
    let b2 = buf[p + 2].to_int().to_uint()
    let b3 = buf[p + 3].to_int().to_uint()
    m[i] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    i = i + 1
  }
}

///|
fn md5_state_to_u64_pair(state : FixedArray[UInt]) -> (UInt64, UInt64) {
  // Each 32-bit word is output little-endian into the 16-byte digest,
  // then read big-endian as (hi, lo).
  let s0 = state[0]
  let s1 = state[1]
  let s2 = state[2]
  let s3 = state[3]
  let w0 = ((s0 & 0xFFU) << 24) | ((s0 & 0xFF00U) << 8) | ((s0 >> 8) & 0xFF00U) | ((s0 >> 24) & 0xFFU)
  let w1 = ((s1 & 0xFFU) << 24) | ((s1 & 0xFF00U) << 8) | ((s1 >> 8) & 0xFF00U) | ((s1 >> 24) & 0xFFU)
  let w2 = ((s2 & 0xFFU) << 24) | ((s2 & 0xFF00U) << 8) | ((s2 >> 8) & 0xFF00U) | ((s2 >> 24) & 0xFFU)
  let w3 = ((s3 & 0xFFU) << 24) | ((s3 & 0xFF00U) << 8) | ((s3 >> 8) & 0xFF00U) | ((s3 >> 24) & 0xFFU)
  let hi = (w0.to_uint64() << 32) | w1.to_uint64()
  let lo = (w2.to_uint64() << 32) | w3.to_uint64()
  (hi, lo)
}

///| Compute RFC 1321 MD5 16-byte digest.
pub fn md5(data : Bytes) -> Bytes {
  let len = data.length()
  let state : FixedArray[UInt] = [0x67452301U, 0xefcdab89U, 0x98badcfeU, 0x10325476U]
  let m : FixedArray[UInt] = FixedArray::make(16, 0U)

  let mut off = 0
  while off + 64 <= len {
    md5_load_le(data, off, m)
    md5_compress(state, m)
    off = off + 64
  }

  let rem = len - off
  let tail_blocks = if rem < 56 { 64 } else { 128 }
  let mut tail = Bytes::new(tail_blocks)
  let mut i = 0
  while i < rem {
    tail[i] = data[off + i]
    i = i + 1
  }
  tail[rem] = (0x80).to_byte()
  let bit_len : UInt64 = len.to_int64().to_uint64() << 3
  let mut bi = 0
  while bi < 8 {
    tail[tail_blocks - 8 + bi] = ((bit_len >> (bi * 8)) & 0xFFUL).to_int().to_byte()
    bi = bi + 1
  }
  md5_load_le(tail, 0, m)
  md5_compress(state, m)
  if tail_blocks == 128 {
    md5_load_le(tail, 64, m)
    md5_compress(state, m)
  }

  let mut digest = Bytes::new(16)
  let mut wi = 0
  while wi < 4 {
    let w = state[wi]
    digest[wi * 4] = (w & 0xFFU).to_int().to_byte()
    digest[wi * 4 + 1] = ((w >> 8) & 0xFFU).to_int().to_byte()
    digest[wi * 4 + 2] = ((w >> 16) & 0xFFU).to_int().to_byte()
    digest[wi * 4 + 3] = ((w >> 24) & 0xFFU).to_int().to_byte()
    wi = wi + 1
  }
  digest
}

///| Compute MD5(namespace_be16 || name) returning raw 128-bit (hi, lo) without concatenating buffers.
fn md5_ns_name(ns_hi : UInt64, ns_lo : UInt64, name : Bytes) -> (UInt64, UInt64) {
  let nlen = name.length()
  let total_len = 16 + nlen
  let state : FixedArray[UInt] = [0x67452301U, 0xefcdab89U, 0x98badcfeU, 0x10325476U]
  let m : FixedArray[UInt] = FixedArray::make(16, 0U)

  // Fast path: 16 + nlen < 56 -> single 64-byte block
  let mut blk = Bytes::new(64)
  blk[0] = ((ns_hi >> 56) & 0xFFUL).to_int().to_byte()
  blk[1] = ((ns_hi >> 48) & 0xFFUL).to_int().to_byte()
  blk[2] = ((ns_hi >> 40) & 0xFFUL).to_int().to_byte()
  blk[3] = ((ns_hi >> 32) & 0xFFUL).to_int().to_byte()
  blk[4] = ((ns_hi >> 24) & 0xFFUL).to_int().to_byte()
  blk[5] = ((ns_hi >> 16) & 0xFFUL).to_int().to_byte()
  blk[6] = ((ns_hi >> 8) & 0xFFUL).to_int().to_byte()
  blk[7] = (ns_hi & 0xFFUL).to_int().to_byte()
  blk[8] = ((ns_lo >> 56) & 0xFFUL).to_int().to_byte()
  blk[9] = ((ns_lo >> 48) & 0xFFUL).to_int().to_byte()
  blk[10] = ((ns_lo >> 40) & 0xFFUL).to_int().to_byte()
  blk[11] = ((ns_lo >> 32) & 0xFFUL).to_int().to_byte()
  blk[12] = ((ns_lo >> 24) & 0xFFUL).to_int().to_byte()
  blk[13] = ((ns_lo >> 16) & 0xFFUL).to_int().to_byte()
  blk[14] = ((ns_lo >> 8) & 0xFFUL).to_int().to_byte()
  blk[15] = (ns_lo & 0xFFUL).to_int().to_byte()

  if total_len < 56 {
    let mut i = 0
    while i < nlen {
      blk[16 + i] = name[i]
      i = i + 1
    }
    blk[total_len] = (0x80).to_byte()
    let bit_len : UInt64 = total_len.to_int64().to_uint64() << 3
    let mut bi = 0
    while bi < 8 {
      blk[56 + bi] = ((bit_len >> (bi * 8)) & 0xFFUL).to_int().to_byte()
      bi = bi + 1
    }
    md5_load_le(blk, 0, m)
    md5_compress(state, m)
    return md5_state_to_u64_pair(state)
  }

  // General path: fill first 64-byte block, then stream remaining full blocks
  let first_take = if nlen < 48 { nlen } else { 48 }
  let mut i = 0
  while i < first_take {
    blk[16 + i] = name[i]
    i = i + 1
  }
  if first_take < 48 {
    // 56 <= total_len < 64: pad across two blocks
    blk[16 + first_take] = (0x80).to_byte()
    md5_load_le(blk, 0, m)
    md5_compress(state, m)
    let mut blk2 = Bytes::new(64)
    let bit_len : UInt64 = total_len.to_int64().to_uint64() << 3
    let mut bi = 0
    while bi < 8 {
      blk2[56 + bi] = ((bit_len >> (bi * 8)) & 0xFFUL).to_int().to_byte()
      bi = bi + 1
    }
    md5_load_le(blk2, 0, m)
    md5_compress(state, m)
    return md5_state_to_u64_pair(state)
  }

  md5_load_le(blk, 0, m)
  md5_compress(state, m)

  let mut off = 48
  while off + 64 <= nlen {
    md5_load_le(name, off, m)
    md5_compress(state, m)
    off = off + 64
  }
  let rem = nlen - off
  let tail_blocks = if rem < 56 { 64 } else { 128 }
  let mut tail = Bytes::new(tail_blocks)
  let mut j = 0
  while j < rem {
    tail[j] = name[off + j]
    j = j + 1
  }
  tail[rem] = (0x80).to_byte()
  let bit_len : UInt64 = total_len.to_int64().to_uint64() << 3
  let mut bi = 0
  while bi < 8 {
    tail[tail_blocks - 8 + bi] = ((bit_len >> (bi * 8)) & 0xFFUL).to_int().to_byte()
    bi = bi + 1
  }
  md5_load_le(tail, 0, m)
  md5_compress(state, m)
  if tail_blocks == 128 {
    md5_load_le(tail, 64, m)
    md5_compress(state, m)
  }
  md5_state_to_u64_pair(state)
}

///| SHA-1 compression function on 16 initial big-endian words in `w[0..16]` (expands into `w[16..80]`).
fn sha1_compress(state : FixedArray[UInt], w : FixedArray[UInt]) -> Unit {
  let mut t = 16
  while t < 80 {
    w[t] = rotl32(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1U)
    t = t + 1
  }

  let mut a = state[0]
  let mut b = state[1]
  let mut c = state[2]
  let mut d = state[3]
  let mut e = state[4]

  t = 0
  while t < 20 {
    let f = (b & c) | ((b ^ 0xFFFFFFFFU) & d)
    let tmp = (rotl32(a, 5U) + f + e + 0x5A827999U + w[t]) & 0xFFFFFFFFU
    e = d
    d = c
    c = rotl32(b, 30U)
    b = a
    a = tmp
    t = t + 1
  }
  while t < 40 {
    let f = b ^ c ^ d
    let tmp = (rotl32(a, 5U) + f + e + 0x6ED9EBA1U + w[t]) & 0xFFFFFFFFU
    e = d
    d = c
    c = rotl32(b, 30U)
    b = a
    a = tmp
    t = t + 1
  }
  while t < 60 {
    let f = (b & c) | (b & d) | (c & d)
    let tmp = (rotl32(a, 5U) + f + e + 0x8F1BBCDCU + w[t]) & 0xFFFFFFFFU
    e = d
    d = c
    c = rotl32(b, 30U)
    b = a
    a = tmp
    t = t + 1
  }
  while t < 80 {
    let f = b ^ c ^ d
    let tmp = (rotl32(a, 5U) + f + e + 0xCA62C1D6U + w[t]) & 0xFFFFFFFFU
    e = d
    d = c
    c = rotl32(b, 30U)
    b = a
    a = tmp
    t = t + 1
  }

  state[0] = (state[0] + a) & 0xFFFFFFFFU
  state[1] = (state[1] + b) & 0xFFFFFFFFU
  state[2] = (state[2] + c) & 0xFFFFFFFFU
  state[3] = (state[3] + d) & 0xFFFFFFFFU
  state[4] = (state[4] + e) & 0xFFFFFFFFU
}

///|
fn sha1_load_be(buf : Bytes, off : Int, w : FixedArray[UInt]) -> Unit {
  let mut t = 0
  while t < 16 {
    let p = off + t * 4
    let b0 = buf[p].to_int().to_uint()
    let b1 = buf[p + 1].to_int().to_uint()
    let b2 = buf[p + 2].to_int().to_uint()
    let b3 = buf[p + 3].to_int().to_uint()
    w[t] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    t = t + 1
  }
}

///| Compute FIPS 180-4 SHA-1 20-byte digest.
pub fn sha1(data : Bytes) -> Bytes {
  let len = data.length()
  let state : FixedArray[UInt] = [0x67452301U, 0xEFCDAB89U, 0x98BADCFEU, 0x10325476U, 0xC3D2E1F0U]
  let w : FixedArray[UInt] = FixedArray::make(80, 0U)

  let mut off = 0
  while off + 64 <= len {
    sha1_load_be(data, off, w)
    sha1_compress(state, w)
    off = off + 64
  }

  let rem = len - off
  let tail_blocks = if rem < 56 { 64 } else { 128 }
  let mut tail = Bytes::new(tail_blocks)
  let mut i = 0
  while i < rem {
    tail[i] = data[off + i]
    i = i + 1
  }
  tail[rem] = (0x80).to_byte()
  let bit_len : UInt64 = len.to_int64().to_uint64() << 3
  let mut bi = 0
  while bi < 8 {
    let shift : Int = (7 - bi) * 8
    tail[tail_blocks - 8 + bi] = ((bit_len >> shift) & 0xFFUL).to_int().to_byte()
    bi = bi + 1
  }
  sha1_load_be(tail, 0, w)
  sha1_compress(state, w)
  if tail_blocks == 128 {
    sha1_load_be(tail, 64, w)
    sha1_compress(state, w)
  }

  let mut digest = Bytes::new(20)
  let mut hi = 0
  while hi < 5 {
    let hv = state[hi]
    digest[hi * 4] = ((hv >> 24) & 0xFFU).to_int().to_byte()
    digest[hi * 4 + 1] = ((hv >> 16) & 0xFFU).to_int().to_byte()
    digest[hi * 4 + 2] = ((hv >> 8) & 0xFFU).to_int().to_byte()
    digest[hi * 4 + 3] = (hv & 0xFFU).to_int().to_byte()
    hi = hi + 1
  }
  digest
}

///| Zero-allocation register-only SHA-1 single-block compression returning first 16 bytes as (hi, lo).
fn sha1_single_block(
  w0_in : UInt,
  w1_in : UInt,
  w2_in : UInt,
  w3_in : UInt,
  w4_in : UInt,
  w5_in : UInt,
  w6_in : UInt,
  w7_in : UInt,
  w8_in : UInt,
  w9_in : UInt,
  w10_in : UInt,
  w11_in : UInt,
  w12_in : UInt,
  w13_in : UInt,
  w14_in : UInt,
  w15_in : UInt,
) -> (UInt64, UInt64) {
  let mut w0 = w0_in
  let mut w1 = w1_in
  let mut w2 = w2_in
  let mut w3 = w3_in
  let mut w4 = w4_in
  let mut w5 = w5_in
  let mut w6 = w6_in
  let mut w7 = w7_in
  let mut w8 = w8_in
  let mut w9 = w9_in
  let mut w10 = w10_in
  let mut w11 = w11_in
  let mut w12 = w12_in
  let mut w13 = w13_in
  let mut w14 = w14_in
  let mut w15 = w15_in

  let mut a : UInt = 0x67452301U
  let mut b : UInt = 0xEFCDAB89U
  let mut c : UInt = 0x98BADCFEU
  let mut d : UInt = 0x10325476U
  let mut e : UInt = 0xC3D2E1F0U

  // Rounds 0..15 (Ch)
  e = e + rotl32(a, 5U) + ((b & c) | ((b ^ 0xFFFFFFFFU) & d)) + 0x5A827999U + w0; b = rotl32(b, 30U)
  d = d + rotl32(e, 5U) + ((a & b) | ((a ^ 0xFFFFFFFFU) & c)) + 0x5A827999U + w1; a = rotl32(a, 30U)
  c = c + rotl32(d, 5U) + ((e & a) | ((e ^ 0xFFFFFFFFU) & b)) + 0x5A827999U + w2; e = rotl32(e, 30U)
  b = b + rotl32(c, 5U) + ((d & e) | ((d ^ 0xFFFFFFFFU) & a)) + 0x5A827999U + w3; d = rotl32(d, 30U)
  a = a + rotl32(b, 5U) + ((c & d) | ((c ^ 0xFFFFFFFFU) & e)) + 0x5A827999U + w4; c = rotl32(c, 30U)
  e = e + rotl32(a, 5U) + ((b & c) | ((b ^ 0xFFFFFFFFU) & d)) + 0x5A827999U + w5; b = rotl32(b, 30U)
  d = d + rotl32(e, 5U) + ((a & b) | ((a ^ 0xFFFFFFFFU) & c)) + 0x5A827999U + w6; a = rotl32(a, 30U)
  c = c + rotl32(d, 5U) + ((e & a) | ((e ^ 0xFFFFFFFFU) & b)) + 0x5A827999U + w7; e = rotl32(e, 30U)
  b = b + rotl32(c, 5U) + ((d & e) | ((d ^ 0xFFFFFFFFU) & a)) + 0x5A827999U + w8; d = rotl32(d, 30U)
  a = a + rotl32(b, 5U) + ((c & d) | ((c ^ 0xFFFFFFFFU) & e)) + 0x5A827999U + w9; c = rotl32(c, 30U)
  e = e + rotl32(a, 5U) + ((b & c) | ((b ^ 0xFFFFFFFFU) & d)) + 0x5A827999U + w10; b = rotl32(b, 30U)
  d = d + rotl32(e, 5U) + ((a & b) | ((a ^ 0xFFFFFFFFU) & c)) + 0x5A827999U + w11; a = rotl32(a, 30U)
  c = c + rotl32(d, 5U) + ((e & a) | ((e ^ 0xFFFFFFFFU) & b)) + 0x5A827999U + w12; e = rotl32(e, 30U)
  b = b + rotl32(c, 5U) + ((d & e) | ((d ^ 0xFFFFFFFFU) & a)) + 0x5A827999U + w13; d = rotl32(d, 30U)
  a = a + rotl32(b, 5U) + ((c & d) | ((c ^ 0xFFFFFFFFU) & e)) + 0x5A827999U + w14; c = rotl32(c, 30U)
  e = e + rotl32(a, 5U) + ((b & c) | ((b ^ 0xFFFFFFFFU) & d)) + 0x5A827999U + w15; b = rotl32(b, 30U)

  // Rounds 16..19 (Ch)
  w0 = rotl32(w13 ^ w8 ^ w2 ^ w0, 1U); d = d + rotl32(e, 5U) + ((a & b) | ((a ^ 0xFFFFFFFFU) & c)) + 0x5A827999U + w0; a = rotl32(a, 30U)
  w1 = rotl32(w14 ^ w9 ^ w3 ^ w1, 1U); c = c + rotl32(d, 5U) + ((e & a) | ((e ^ 0xFFFFFFFFU) & b)) + 0x5A827999U + w1; e = rotl32(e, 30U)
  w2 = rotl32(w15 ^ w10 ^ w4 ^ w2, 1U); b = b + rotl32(c, 5U) + ((d & e) | ((d ^ 0xFFFFFFFFU) & a)) + 0x5A827999U + w2; d = rotl32(d, 30U)
  w3 = rotl32(w0 ^ w11 ^ w5 ^ w3, 1U); a = a + rotl32(b, 5U) + ((c & d) | ((c ^ 0xFFFFFFFFU) & e)) + 0x5A827999U + w3; c = rotl32(c, 30U)

  // Rounds 20..39 (Parity)
  w4 = rotl32(w1 ^ w12 ^ w6 ^ w4, 1U); e = e + rotl32(a, 5U) + (b ^ c ^ d) + 0x6ED9EBA1U + w4; b = rotl32(b, 30U)
  w5 = rotl32(w2 ^ w13 ^ w7 ^ w5, 1U); d = d + rotl32(e, 5U) + (a ^ b ^ c) + 0x6ED9EBA1U + w5; a = rotl32(a, 30U)
  w6 = rotl32(w3 ^ w14 ^ w8 ^ w6, 1U); c = c + rotl32(d, 5U) + (e ^ a ^ b) + 0x6ED9EBA1U + w6; e = rotl32(e, 30U)
  w7 = rotl32(w4 ^ w15 ^ w9 ^ w7, 1U); b = b + rotl32(c, 5U) + (d ^ e ^ a) + 0x6ED9EBA1U + w7; d = rotl32(d, 30U)
  w8 = rotl32(w5 ^ w0 ^ w10 ^ w8, 1U); a = a + rotl32(b, 5U) + (c ^ d ^ e) + 0x6ED9EBA1U + w8; c = rotl32(c, 30U)
  w9 = rotl32(w6 ^ w1 ^ w11 ^ w9, 1U); e = e + rotl32(a, 5U) + (b ^ c ^ d) + 0x6ED9EBA1U + w9; b = rotl32(b, 30U)
  w10 = rotl32(w7 ^ w2 ^ w12 ^ w10, 1U); d = d + rotl32(e, 5U) + (a ^ b ^ c) + 0x6ED9EBA1U + w10; a = rotl32(a, 30U)
  w11 = rotl32(w8 ^ w3 ^ w13 ^ w11, 1U); c = c + rotl32(d, 5U) + (e ^ a ^ b) + 0x6ED9EBA1U + w11; e = rotl32(e, 30U)
  w12 = rotl32(w9 ^ w4 ^ w14 ^ w12, 1U); b = b + rotl32(c, 5U) + (d ^ e ^ a) + 0x6ED9EBA1U + w12; d = rotl32(d, 30U)
  w13 = rotl32(w10 ^ w5 ^ w15 ^ w13, 1U); a = a + rotl32(b, 5U) + (c ^ d ^ e) + 0x6ED9EBA1U + w13; c = rotl32(c, 30U)
  w14 = rotl32(w11 ^ w6 ^ w0 ^ w14, 1U); e = e + rotl32(a, 5U) + (b ^ c ^ d) + 0x6ED9EBA1U + w14; b = rotl32(b, 30U)
  w15 = rotl32(w12 ^ w7 ^ w1 ^ w15, 1U); d = d + rotl32(e, 5U) + (a ^ b ^ c) + 0x6ED9EBA1U + w15; a = rotl32(a, 30U)
  w0 = rotl32(w13 ^ w8 ^ w2 ^ w0, 1U); c = c + rotl32(d, 5U) + (e ^ a ^ b) + 0x6ED9EBA1U + w0; e = rotl32(e, 30U)
  w1 = rotl32(w14 ^ w9 ^ w3 ^ w1, 1U); b = b + rotl32(c, 5U) + (d ^ e ^ a) + 0x6ED9EBA1U + w1; d = rotl32(d, 30U)
  w2 = rotl32(w15 ^ w10 ^ w4 ^ w2, 1U); a = a + rotl32(b, 5U) + (c ^ d ^ e) + 0x6ED9EBA1U + w2; c = rotl32(c, 30U)
  w3 = rotl32(w0 ^ w11 ^ w5 ^ w3, 1U); e = e + rotl32(a, 5U) + (b ^ c ^ d) + 0x6ED9EBA1U + w3; b = rotl32(b, 30U)
  w4 = rotl32(w1 ^ w12 ^ w6 ^ w4, 1U); d = d + rotl32(e, 5U) + (a ^ b ^ c) + 0x6ED9EBA1U + w4; a = rotl32(a, 30U)
  w5 = rotl32(w2 ^ w13 ^ w7 ^ w5, 1U); c = c + rotl32(d, 5U) + (e ^ a ^ b) + 0x6ED9EBA1U + w5; e = rotl32(e, 30U)
  w6 = rotl32(w3 ^ w14 ^ w8 ^ w6, 1U); b = b + rotl32(c, 5U) + (d ^ e ^ a) + 0x6ED9EBA1U + w6; d = rotl32(d, 30U)
  w7 = rotl32(w4 ^ w15 ^ w9 ^ w7, 1U); a = a + rotl32(b, 5U) + (c ^ d ^ e) + 0x6ED9EBA1U + w7; c = rotl32(c, 30U)

  // Rounds 40..59 (Maj)
  w8 = rotl32(w5 ^ w0 ^ w10 ^ w8, 1U); e = e + rotl32(a, 5U) + ((b & c) | (b & d) | (c & d)) + 0x8F1BBCDCU + w8; b = rotl32(b, 30U)
  w9 = rotl32(w6 ^ w1 ^ w11 ^ w9, 1U); d = d + rotl32(e, 5U) + ((a & b) | (a & c) | (b & c)) + 0x8F1BBCDCU + w9; a = rotl32(a, 30U)
  w10 = rotl32(w7 ^ w2 ^ w12 ^ w10, 1U); c = c + rotl32(d, 5U) + ((e & a) | (e & b) | (a & b)) + 0x8F1BBCDCU + w10; e = rotl32(e, 30U)
  w11 = rotl32(w8 ^ w3 ^ w13 ^ w11, 1U); b = b + rotl32(c, 5U) + ((d & e) | (d & a) | (e & a)) + 0x8F1BBCDCU + w11; d = rotl32(d, 30U)
  w12 = rotl32(w9 ^ w4 ^ w14 ^ w12, 1U); a = a + rotl32(b, 5U) + ((c & d) | (c & e) | (d & e)) + 0x8F1BBCDCU + w12; c = rotl32(c, 30U)
  w13 = rotl32(w10 ^ w5 ^ w15 ^ w13, 1U); e = e + rotl32(a, 5U) + ((b & c) | (b & d) | (c & d)) + 0x8F1BBCDCU + w13; b = rotl32(b, 30U)
  w14 = rotl32(w11 ^ w6 ^ w0 ^ w14, 1U); d = d + rotl32(e, 5U) + ((a & b) | (a & c) | (b & c)) + 0x8F1BBCDCU + w14; a = rotl32(a, 30U)
  w15 = rotl32(w12 ^ w7 ^ w1 ^ w15, 1U); c = c + rotl32(d, 5U) + ((e & a) | (e & b) | (a & b)) + 0x8F1BBCDCU + w15; e = rotl32(e, 30U)
  w0 = rotl32(w13 ^ w8 ^ w2 ^ w0, 1U); b = b + rotl32(c, 5U) + ((d & e) | (d & a) | (e & a)) + 0x8F1BBCDCU + w0; d = rotl32(d, 30U)
  w1 = rotl32(w14 ^ w9 ^ w3 ^ w1, 1U); a = a + rotl32(b, 5U) + ((c & d) | (c & e) | (d & e)) + 0x8F1BBCDCU + w1; c = rotl32(c, 30U)
  w2 = rotl32(w15 ^ w10 ^ w4 ^ w2, 1U); e = e + rotl32(a, 5U) + ((b & c) | (b & d) | (c & d)) + 0x8F1BBCDCU + w2; b = rotl32(b, 30U)
  w3 = rotl32(w0 ^ w11 ^ w5 ^ w3, 1U); d = d + rotl32(e, 5U) + ((a & b) | (a & c) | (b & c)) + 0x8F1BBCDCU + w3; a = rotl32(a, 30U)
  w4 = rotl32(w1 ^ w12 ^ w6 ^ w4, 1U); c = c + rotl32(d, 5U) + ((e & a) | (e & b) | (a & b)) + 0x8F1BBCDCU + w4; e = rotl32(e, 30U)
  w5 = rotl32(w2 ^ w13 ^ w7 ^ w5, 1U); b = b + rotl32(c, 5U) + ((d & e) | (d & a) | (e & a)) + 0x8F1BBCDCU + w5; d = rotl32(d, 30U)
  w6 = rotl32(w3 ^ w14 ^ w8 ^ w6, 1U); a = a + rotl32(b, 5U) + ((c & d) | (c & e) | (d & e)) + 0x8F1BBCDCU + w6; c = rotl32(c, 30U)
  w7 = rotl32(w4 ^ w15 ^ w9 ^ w7, 1U); e = e + rotl32(a, 5U) + ((b & c) | (b & d) | (c & d)) + 0x8F1BBCDCU + w7; b = rotl32(b, 30U)
  w8 = rotl32(w5 ^ w0 ^ w10 ^ w8, 1U); d = d + rotl32(e, 5U) + ((a & b) | (a & c) | (b & c)) + 0x8F1BBCDCU + w8; a = rotl32(a, 30U)
  w9 = rotl32(w6 ^ w1 ^ w11 ^ w9, 1U); c = c + rotl32(d, 5U) + ((e & a) | (e & b) | (a & b)) + 0x8F1BBCDCU + w9; e = rotl32(e, 30U)
  w10 = rotl32(w7 ^ w2 ^ w12 ^ w10, 1U); b = b + rotl32(c, 5U) + ((d & e) | (d & a) | (e & a)) + 0x8F1BBCDCU + w10; d = rotl32(d, 30U)
  w11 = rotl32(w8 ^ w3 ^ w13 ^ w11, 1U); a = a + rotl32(b, 5U) + ((c & d) | (c & e) | (d & e)) + 0x8F1BBCDCU + w11; c = rotl32(c, 30U)

  // Rounds 60..79 (Parity)
  w12 = rotl32(w9 ^ w4 ^ w14 ^ w12, 1U); e = e + rotl32(a, 5U) + (b ^ c ^ d) + 0xCA62C1D6U + w12; b = rotl32(b, 30U)
  w13 = rotl32(w10 ^ w5 ^ w15 ^ w13, 1U); d = d + rotl32(e, 5U) + (a ^ b ^ c) + 0xCA62C1D6U + w13; a = rotl32(a, 30U)
  w14 = rotl32(w11 ^ w6 ^ w0 ^ w14, 1U); c = c + rotl32(d, 5U) + (e ^ a ^ b) + 0xCA62C1D6U + w14; e = rotl32(e, 30U)
  w15 = rotl32(w12 ^ w7 ^ w1 ^ w15, 1U); b = b + rotl32(c, 5U) + (d ^ e ^ a) + 0xCA62C1D6U + w15; d = rotl32(d, 30U)
  w0 = rotl32(w13 ^ w8 ^ w2 ^ w0, 1U); a = a + rotl32(b, 5U) + (c ^ d ^ e) + 0xCA62C1D6U + w0; c = rotl32(c, 30U)
  w1 = rotl32(w14 ^ w9 ^ w3 ^ w1, 1U); e = e + rotl32(a, 5U) + (b ^ c ^ d) + 0xCA62C1D6U + w1; b = rotl32(b, 30U)
  w2 = rotl32(w15 ^ w10 ^ w4 ^ w2, 1U); d = d + rotl32(e, 5U) + (a ^ b ^ c) + 0xCA62C1D6U + w2; a = rotl32(a, 30U)
  w3 = rotl32(w0 ^ w11 ^ w5 ^ w3, 1U); c = c + rotl32(d, 5U) + (e ^ a ^ b) + 0xCA62C1D6U + w3; e = rotl32(e, 30U)
  w4 = rotl32(w1 ^ w12 ^ w6 ^ w4, 1U); b = b + rotl32(c, 5U) + (d ^ e ^ a) + 0xCA62C1D6U + w4; d = rotl32(d, 30U)
  w5 = rotl32(w2 ^ w13 ^ w7 ^ w5, 1U); a = a + rotl32(b, 5U) + (c ^ d ^ e) + 0xCA62C1D6U + w5; c = rotl32(c, 30U)
  w6 = rotl32(w3 ^ w14 ^ w8 ^ w6, 1U); e = e + rotl32(a, 5U) + (b ^ c ^ d) + 0xCA62C1D6U + w6; b = rotl32(b, 30U)
  w7 = rotl32(w4 ^ w15 ^ w9 ^ w7, 1U); d = d + rotl32(e, 5U) + (a ^ b ^ c) + 0xCA62C1D6U + w7; a = rotl32(a, 30U)
  w8 = rotl32(w5 ^ w0 ^ w10 ^ w8, 1U); c = c + rotl32(d, 5U) + (e ^ a ^ b) + 0xCA62C1D6U + w8; e = rotl32(e, 30U)
  w9 = rotl32(w6 ^ w1 ^ w11 ^ w9, 1U); b = b + rotl32(c, 5U) + (d ^ e ^ a) + 0xCA62C1D6U + w9; d = rotl32(d, 30U)
  w10 = rotl32(w7 ^ w2 ^ w12 ^ w10, 1U); a = a + rotl32(b, 5U) + (c ^ d ^ e) + 0xCA62C1D6U + w10; c = rotl32(c, 30U)
  w11 = rotl32(w8 ^ w3 ^ w13 ^ w11, 1U); e = e + rotl32(a, 5U) + (b ^ c ^ d) + 0xCA62C1D6U + w11; b = rotl32(b, 30U)
  w12 = rotl32(w9 ^ w4 ^ w14 ^ w12, 1U); d = d + rotl32(e, 5U) + (a ^ b ^ c) + 0xCA62C1D6U + w12; a = rotl32(a, 30U)
  w13 = rotl32(w10 ^ w5 ^ w15 ^ w13, 1U); c = c + rotl32(d, 5U) + (e ^ a ^ b) + 0xCA62C1D6U + w13; e = rotl32(e, 30U)
  w14 = rotl32(w11 ^ w6 ^ w0 ^ w14, 1U); b = b + rotl32(c, 5U) + (d ^ e ^ a) + 0xCA62C1D6U + w14; d = rotl32(d, 30U)
  w15 = rotl32(w12 ^ w7 ^ w1 ^ w15, 1U); a = a + rotl32(b, 5U) + (c ^ d ^ e) + 0xCA62C1D6U + w15; c = rotl32(c, 30U)

  let h0 = (0x67452301U + a) & 0xFFFFFFFFU
  let h1 = (0xEFCDAB89U + b) & 0xFFFFFFFFU
  let h2 = (0x98BADCFEU + c) & 0xFFFFFFFFU
  let h3 = (0x10325476U + d) & 0xFFFFFFFFU
  ((h0.to_uint64() << 32) | h1.to_uint64(), (h2.to_uint64() << 32) | h3.to_uint64())
}

///| Compute SHA-1(namespace_be16 || name) writing first 16 bytes into out_pair[0..2] with ZERO heap allocation on fast path.
fn sha1_ns_name_into(ns_hi : UInt64, ns_lo : UInt64, name : Bytes, out_pair : FixedArray[UInt64]) -> Unit {
  if out_pair.length() < 2 {
    return
  }
  let (h, l) = sha1_ns_name(ns_hi, ns_lo, name)
  out_pair[0] = h
  out_pair[1] = l
}

///| Compute SHA-1(namespace_be16 || name) returning the first 16 bytes as (hi, lo) with ZERO heap allocation on fast path.
fn sha1_ns_name(ns_hi : UInt64, ns_lo : UInt64, name : Bytes) -> (UInt64, UInt64) {
  let nlen = name.length()
  let total_len = 16 + nlen

  if total_len < 56 {
    let w0 = ((ns_hi >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
    let w1 = (ns_hi & 0xFFFFFFFFUL).to_int().to_uint()
    let w2 = ((ns_lo >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
    let w3 = (ns_lo & 0xFFFFFFFFUL).to_int().to_uint()
    let mut w4 = 0U
    let mut w5 = 0U
    let mut w6 = 0U
    let mut w7 = 0U
    let mut w8 = 0U
    let mut w9 = 0U
    let mut w10 = 0U
    let mut w11 = 0U
    let mut w12 = 0U
    let mut w13 = 0U
    let full_words = nlen >> 2
    if full_words >= 1 {
      w4 = (name[0].to_int().to_uint() << 24) | (name[1].to_int().to_uint() << 16) | (name[2].to_int().to_uint() << 8) | name[3].to_int().to_uint()
    }
    if full_words >= 2 {
      w5 = (name[4].to_int().to_uint() << 24) | (name[5].to_int().to_uint() << 16) | (name[6].to_int().to_uint() << 8) | name[7].to_int().to_uint()
    }
    if full_words >= 3 {
      w6 = (name[8].to_int().to_uint() << 24) | (name[9].to_int().to_uint() << 16) | (name[10].to_int().to_uint() << 8) | name[11].to_int().to_uint()
    }
    if full_words >= 4 {
      w7 = (name[12].to_int().to_uint() << 24) | (name[13].to_int().to_uint() << 16) | (name[14].to_int().to_uint() << 8) | name[15].to_int().to_uint()
    }
    if full_words >= 5 {
      w8 = (name[16].to_int().to_uint() << 24) | (name[17].to_int().to_uint() << 16) | (name[18].to_int().to_uint() << 8) | name[19].to_int().to_uint()
    }
    if full_words >= 6 {
      w9 = (name[20].to_int().to_uint() << 24) | (name[21].to_int().to_uint() << 16) | (name[22].to_int().to_uint() << 8) | name[23].to_int().to_uint()
    }
    if full_words >= 7 {
      w10 = (name[24].to_int().to_uint() << 24) | (name[25].to_int().to_uint() << 16) | (name[26].to_int().to_uint() << 8) | name[27].to_int().to_uint()
    }
    if full_words >= 8 {
      w11 = (name[28].to_int().to_uint() << 24) | (name[29].to_int().to_uint() << 16) | (name[30].to_int().to_uint() << 8) | name[31].to_int().to_uint()
    }
    if full_words >= 9 {
      w12 = (name[32].to_int().to_uint() << 24) | (name[33].to_int().to_uint() << 16) | (name[34].to_int().to_uint() << 8) | name[35].to_int().to_uint()
    }
    let tail_off = full_words << 2
    let rem = nlen - tail_off
    let tail_w = if rem == 0 {
      0x80000000U
    } else if rem == 1 {
      (name[tail_off].to_int().to_uint() << 24) | 0x00800000U
    } else if rem == 2 {
      (name[tail_off].to_int().to_uint() << 24) | (name[tail_off + 1].to_int().to_uint() << 16) | 0x00008000U
    } else {
      (name[tail_off].to_int().to_uint() << 24) | (name[tail_off + 1].to_int().to_uint() << 16) | (name[tail_off + 2].to_int().to_uint() << 8) | 0x00000080U
    }
    if full_words == 0 {
      w4 = tail_w
    } else if full_words == 1 {
      w5 = tail_w
    } else if full_words == 2 {
      w6 = tail_w
    } else if full_words == 3 {
      w7 = tail_w
    } else if full_words == 4 {
      w8 = tail_w
    } else if full_words == 5 {
      w9 = tail_w
    } else if full_words == 6 {
      w10 = tail_w
    } else if full_words == 7 {
      w11 = tail_w
    } else if full_words == 8 {
      w12 = tail_w
    } else {
      w13 = tail_w
    }
    let bit_len = (total_len << 3).to_uint()
    return sha1_single_block(w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, 0U, bit_len)
  }

  let state : FixedArray[UInt] = [0x67452301U, 0xEFCDAB89U, 0x98BADCFEU, 0x10325476U, 0xC3D2E1F0U]
  let w : FixedArray[UInt] = FixedArray::make(80, 0U)

  let mut blk = Bytes::new(64)
  blk[0] = ((ns_hi >> 56) & 0xFFUL).to_int().to_byte()
  blk[1] = ((ns_hi >> 48) & 0xFFUL).to_int().to_byte()
  blk[2] = ((ns_hi >> 40) & 0xFFUL).to_int().to_byte()
  blk[3] = ((ns_hi >> 32) & 0xFFUL).to_int().to_byte()
  blk[4] = ((ns_hi >> 24) & 0xFFUL).to_int().to_byte()
  blk[5] = ((ns_hi >> 16) & 0xFFUL).to_int().to_byte()
  blk[6] = ((ns_hi >> 8) & 0xFFUL).to_int().to_byte()
  blk[7] = (ns_hi & 0xFFUL).to_int().to_byte()
  blk[8] = ((ns_lo >> 56) & 0xFFUL).to_int().to_byte()
  blk[9] = ((ns_lo >> 48) & 0xFFUL).to_int().to_byte()
  blk[10] = ((ns_lo >> 40) & 0xFFUL).to_int().to_byte()
  blk[11] = ((ns_lo >> 32) & 0xFFUL).to_int().to_byte()
  blk[12] = ((ns_lo >> 24) & 0xFFUL).to_int().to_byte()
  blk[13] = ((ns_lo >> 16) & 0xFFUL).to_int().to_byte()
  blk[14] = ((ns_lo >> 8) & 0xFFUL).to_int().to_byte()
  blk[15] = (ns_lo & 0xFFUL).to_int().to_byte()

  let first_take = if nlen < 48 { nlen } else { 48 }
  let mut i = 0
  while i < first_take {
    blk[16 + i] = name[i]
    i = i + 1
  }
  if first_take < 48 {
    blk[16 + first_take] = (0x80).to_byte()
    sha1_load_be(blk, 0, w)
    sha1_compress(state, w)
    let mut wi = 0
    while wi < 14 {
      w[wi] = 0U
      wi = wi + 1
    }
    let bit_len : UInt64 = total_len.to_int64().to_uint64() << 3
    w[14] = ((bit_len >> 32) & 0xFFFFFFFFUL).to_int().to_uint()
    w[15] = (bit_len & 0xFFFFFFFFUL).to_int().to_uint()
    sha1_compress(state, w)
    let hi = (state[0].to_uint64() << 32) | state[1].to_uint64()
    let lo = (state[2].to_uint64() << 32) | state[3].to_uint64()
    return (hi, lo)
  }

  sha1_load_be(blk, 0, w)
  sha1_compress(state, w)

  let mut off = 48
  while off + 64 <= nlen {
    sha1_load_be(name, off, w)
    sha1_compress(state, w)
    off = off + 64
  }
  let rem = nlen - off
  let tail_blocks = if rem < 56 { 64 } else { 128 }
  let mut tail = Bytes::new(tail_blocks)
  let mut j = 0
  while j < rem {
    tail[j] = name[off + j]
    j = j + 1
  }
  tail[rem] = (0x80).to_byte()
  let bit_len : UInt64 = total_len.to_int64().to_uint64() << 3
  let mut bi = 0
  while bi < 8 {
    let shift : Int = (7 - bi) * 8
    tail[tail_blocks - 8 + bi] = ((bit_len >> shift) & 0xFFUL).to_int().to_byte()
    bi = bi + 1
  }
  sha1_load_be(tail, 0, w)
  sha1_compress(state, w)
  if tail_blocks == 128 {
    sha1_load_be(tail, 64, w)
    sha1_compress(state, w)
  }
  let hi = (state[0].to_uint64() << 32) | state[1].to_uint64()
  let lo = (state[2].to_uint64() << 32) | state[3].to_uint64()
  (hi, lo)
}
