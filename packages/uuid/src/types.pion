///| Core value types, error definitions, and stateful monotonic contexts for `uuid` (RFC 9562) and `ulid` (Crockford Base32).

///|
pub enum UuidError {
  InvalidLength(Int)
  InvalidChar(Int, Int)
  InvalidGroup(Int)
  InvalidPrefix
  InvalidTimestamp(Int64)
  InvalidBytesLength(Int)
  SequenceOverflow
}

///|
pub enum UuidVersion {
  Nil
  Mac
  Dce
  Md5
  Random
  Sha1
  SortMac
  SortRand
  Custom
  Max
  Unknown(Int)
}

///|
pub enum UuidVariant {
  Ncs
  Rfc4122
  Microsoft
  Future
}

///| 128-bit zero-heap-allocation UUID value type (big-endian hi/lo words).
pub val struct Uuid {
  pub hi : Int64
  pub lo : Int64
}

///|
pub enum UlidError {
  InvalidLength(Int)
  InvalidChar(Int, Int)
  Overflow
  InvalidTimestamp(Int64)
  InvalidBytesLength(Int)
}

///| 128-bit zero-heap-allocation ULID value type (big-endian hi/lo words: 48-bit ms ts + 80-bit random).
pub val struct Ulid {
  pub hi : Int64
  pub lo : Int64
}

///| Stateful monotonic context for UUIDv7 generation (RFC 9562 §6.2 Method 1).
pub struct V7Context {
  mut has_last : Bool
  mut last_ts_ms : Int64
  mut counter : Int
}

///| Stateful monotonic ULID generator (strictly +1 on 80-bit random within same ms; explicit Overflow on saturation).
pub struct MonotonicUlid {
  mut has_last : Bool
  mut last : Ulid
}
