  let _ = hi
  let _ = lo
  Uuid::{ hi: 0L, lo: 0L }
}

///|
pub fn Uuid::as_u64_pair(self : Uuid) -> (UInt64, UInt64) {
  let _ = self
  (0UL, 0UL)
}

