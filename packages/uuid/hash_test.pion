///| Official RFC 1321 MD5 and FIPS 180-4 SHA-1 compliance test vectors,
///| including 55/56/63/64/65/119/120/128-byte block boundary tests.

///|
fn bytes_from_ascii(s : String) -> Bytes {
  let n = s.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  b
}

///|
fn repeat_byte(ch : Int, count : Int) -> Bytes {
  let mut b = Bytes::new(count)
  let mut i = 0
  while i < count {
    b[i] = ch.to_byte()
    i = i + 1
  }
  b
}

///|
fn to_hex_lower(b : Bytes) -> String {
  let digits = "0123456789abcdef"
  let n = b.length()
  let mut out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = b[i].to_int()
    out[i * 2] = digits.code_unit_at((v >> 4) & 0xF).to_byte()
    out[i * 2 + 1] = digits.code_unit_at(v & 0xF).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
test "md5_rfc1321_official_vectors" {
  debug_assert(to_hex_lower(md5(bytes_from_ascii(""))) == "d41d8cd98f00b204e9800998ecf8427e", "md5 empty")
  debug_assert(to_hex_lower(md5(bytes_from_ascii("a"))) == "0cc175b9c0f1b6a831c399e269772661", "md5 a")
  debug_assert(to_hex_lower(md5(bytes_from_ascii("abc"))) == "900150983cd24fb0d6963f7d28e17f72", "md5 abc")
  debug_assert(to_hex_lower(md5(bytes_from_ascii("message digest"))) == "f96b697d7cb7938d525a2f31aaf161d0", "md5 message digest")
  debug_assert(to_hex_lower(md5(bytes_from_ascii("abcdefghijklmnopqrstuvwxyz"))) == "c3fcd3d76192e4007dfb496cca67e13b", "md5 a-z")
  debug_assert(
    to_hex_lower(md5(bytes_from_ascii("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"))) == "d174ab98d277d9f5a5611c2c9f419d9f",
    "md5 alnum",
  )
  debug_assert(
    to_hex_lower(md5(bytes_from_ascii("12345678901234567890123456789012345678901234567890123456789012345678901234567890"))) == "57edf4a22be3c955ac49da2e2107b67a",
    "md5 80 digits",
  )
}

///|
test "md5_block_boundaries" {
  debug_assert(to_hex_lower(md5(repeat_byte(97, 55))) == "ef1772b6dff9a122358552954ad0df65", "md5 55B")
  debug_assert(to_hex_lower(md5(repeat_byte(97, 56))) == "3b0c8ac703f828b04c6c197006d17218", "md5 56B")
  debug_assert(to_hex_lower(md5(repeat_byte(97, 63))) == "b06521f39153d618550606be297466d5", "md5 63B")
  debug_assert(to_hex_lower(md5(repeat_byte(97, 64))) == "014842d480b571495a4a0363793f7367", "md5 64B")
  debug_assert(to_hex_lower(md5(repeat_byte(97, 65))) == "c743a45e0d2e6a95cb859adae0248435", "md5 65B")
  debug_assert(to_hex_lower(md5(repeat_byte(97, 119))) == "8a7bd0732ed6a28ce75f6dabc90e1613", "md5 119B")
  debug_assert(to_hex_lower(md5(repeat_byte(97, 120))) == "5f61c0ccad4cac44c75ff505e1f1e537", "md5 120B")
  debug_assert(to_hex_lower(md5(repeat_byte(97, 128))) == "e510683b3f5ffe4093d021808bc6ff70", "md5 128B")
}

///|
test "sha1_fips180_4_official_vectors" {
  debug_assert(to_hex_lower(sha1(bytes_from_ascii(""))) == "da39a3ee5e6b4b0d3255bfef95601890afd80709", "sha1 empty")
  debug_assert(to_hex_lower(sha1(bytes_from_ascii("abc"))) == "a9993e364706816aba3e25717850c26c9cd0d89d", "sha1 abc")
  debug_assert(
    to_hex_lower(sha1(bytes_from_ascii("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))) == "84983e441c3bd26ebaae4aa1f95129e5e54670f1",
    "sha1 56B two-block",
  )
  debug_assert(to_hex_lower(sha1(repeat_byte(97, 1000))) == "291e9a6c66994949b57ba5e650361e98fc36b1ba", "sha1 1000x a")
}

///|
test "sha1_block_boundaries" {
  debug_assert(to_hex_lower(sha1(repeat_byte(97, 55))) == "c1c8bbdc22796e28c0e15163d20899b65621d65a", "sha1 55B")
  debug_assert(to_hex_lower(sha1(repeat_byte(97, 56))) == "c2db330f6083854c99d4b5bfb6e8f29f201be699", "sha1 56B")
  debug_assert(to_hex_lower(sha1(repeat_byte(97, 63))) == "03f09f5b158a7a8cdad920bddc29b81c18a551f5", "sha1 63B")
  debug_assert(to_hex_lower(sha1(repeat_byte(97, 64))) == "0098ba824b5c16427bd7a1122a5a442a25ec644d", "sha1 64B")
  debug_assert(to_hex_lower(sha1(repeat_byte(97, 65))) == "11655326c708d70319be2610e8a57d9a5b959d3b", "sha1 65B")
  debug_assert(to_hex_lower(sha1(repeat_byte(97, 119))) == "ee971065aaa017e0632a8ca6c77bb3bf8b1dfc56", "sha1 119B")
  debug_assert(to_hex_lower(sha1(repeat_byte(97, 120))) == "f34c1488385346a55709ba056ddd08280dd4c6d6", "sha1 120B")
  debug_assert(to_hex_lower(sha1(repeat_byte(97, 128))) == "ad5b3fdbcb526778c2839d2f151ea753995e26a0", "sha1 128B")
}
