///| RFC 9562 Appendix A/B official test vectors and uuid-rs compliance test suite.

///|
fn unwrap_uuid(r : Result[Uuid, UuidError]) -> Uuid {
  match r {
    Ok(u) => u
    Err(_) => {
      debug_assert(false, "expected Ok(Uuid)")
      Uuid::nil()
    }
  }
}

///|
fn is_err_uuid(r : Result[Uuid, UuidError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn hex_to_bytes(hex : String) -> Bytes {
  let n = hex.length() / 2
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nibble(hex.code_unit_at(i * 2))
    let lo = hex_nibble(hex.code_unit_at(i * 2 + 1))
    b[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  b
}

///|
fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    0
  }
}

///|
test "uuid_nil_max_and_namespaces" {
  let n = Uuid::nil()
  debug_assert(n.is_nil(), "nil is_nil")
  debug_assert(!n.is_max(), "nil !is_max")
  debug_assert(n.to_hyphenated() == "00000000-0000-0000-0000-000000000000", "nil str")
  debug_assert(n.to_simple() == "00000000000000000000000000000000", "nil simple")
  match n.version() {
    UuidVersion::Nil => ()
    _ => debug_assert(false, "nil version")
  }

  let m = Uuid::max()
  debug_assert(m.is_max(), "max is_max")
  debug_assert(!m.is_nil(), "max !is_nil")
  debug_assert(m.to_hyphenated() == "ffffffff-ffff-ffff-ffff-ffffffffffff", "max str")
  debug_assert(m.to_hyphenated_upper() == "FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF", "max upper")
  match m.version() {
    UuidVersion::Max => ()
    _ => debug_assert(false, "max version")
  }

  debug_assert(NAMESPACE_DNS.to_hyphenated() == "6ba7b810-9dad-11d1-80b4-00c04fd430c8", "NAMESPACE_DNS")
  debug_assert(NAMESPACE_URL.to_hyphenated() == "6ba7b811-9dad-11d1-80b4-00c04fd430c8", "NAMESPACE_URL")
  debug_assert(NAMESPACE_OID.to_hyphenated() == "6ba7b812-9dad-11d1-80b4-00c04fd430c8", "NAMESPACE_OID")
  debug_assert(NAMESPACE_X500.to_hyphenated() == "6ba7b814-9dad-11d1-80b4-00c04fd430c8", "NAMESPACE_X500")
}

///|
test "uuid_parse_all_four_formats_and_formatting" {
  let canon = "67e55044-10b1-426f-9247-bb680e5fe0c8"
  let u_hyph = unwrap_uuid(Uuid::parse(canon))
  let u_hyph_up = unwrap_uuid(Uuid::parse("67E55044-10B1-426F-9247-BB680E5FE0C8"))
  let u_simple = unwrap_uuid(Uuid::parse("67e5504410b1426f9247bb680e5fe0c8"))
  let u_simple_up = unwrap_uuid(Uuid::parse("67E5504410B1426F9247BB680E5FE0C8"))
  let u_braced = unwrap_uuid(Uuid::parse("{67e55044-10b1-426f-9247-bb680e5fe0c8}"))
  let u_braced_up = unwrap_uuid(Uuid::parse("{67E55044-10B1-426F-9247-BB680E5FE0C8}"))
  let u_urn = unwrap_uuid(Uuid::parse("urn:uuid:67e55044-10b1-426f-9247-bb680e5fe0c8"))
  let u_urn_up = unwrap_uuid(Uuid::parse("URN:UUID:67E55044-10B1-426F-9247-BB680E5FE0C8"))

  debug_assert(u_hyph.eq(u_hyph_up), "hyph upper")
  debug_assert(u_hyph.eq(u_simple), "simple")
  debug_assert(u_hyph.eq(u_simple_up), "simple upper")
  debug_assert(u_hyph.eq(u_braced), "braced")
  debug_assert(u_hyph.eq(u_braced_up), "braced upper")
  debug_assert(u_hyph.eq(u_urn), "urn")
  debug_assert(u_hyph.eq(u_urn_up), "urn upper")

  debug_assert(u_hyph.to_hyphenated() == "67e55044-10b1-426f-9247-bb680e5fe0c8", "fmt hyph")
  debug_assert(u_hyph.to_hyphenated_upper() == "67E55044-10B1-426F-9247-BB680E5FE0C8", "fmt hyph upper")
  debug_assert(u_hyph.to_simple() == "67e5504410b1426f9247bb680e5fe0c8", "fmt simple")
  debug_assert(u_hyph.to_simple_upper() == "67E5504410B1426F9247BB680E5FE0C8", "fmt simple upper")
  debug_assert(u_hyph.to_braced() == "{67e55044-10b1-426f-9247-bb680e5fe0c8}", "fmt braced")
  debug_assert(u_hyph.to_braced_upper() == "{67E55044-10B1-426F-9247-BB680E5FE0C8}", "fmt braced upper")
  debug_assert(u_hyph.to_urn() == "urn:uuid:67e55044-10b1-426f-9247-bb680e5fe0c8", "fmt urn")
  debug_assert(u_hyph.to_urn_upper() == "urn:uuid:67E55044-10B1-426F-9247-BB680E5FE0C8", "fmt urn upper")

  let buf = Bytes::new(40)
  let written = u_hyph.encode_hyphenated(buf, 2)
  debug_assert(written == 36, "encode_hyphenated len")
  let parsed_back = unwrap_uuid(Uuid::parse_slice("xx67e55044-10b1-426f-9247-bb680e5fe0c8yy", 2, 38))
  debug_assert(parsed_back.eq(u_hyph), "parse_slice")
}

///|
test "uuid_parse_invalid_inputs_rejected" {
  // Empty and bad lengths
  debug_assert(is_err_uuid(Uuid::parse("")), "empty")
  debug_assert(is_err_uuid(Uuid::parse("!")), "single")
  debug_assert(is_err_uuid(Uuid::parse("67e5504410b1426f9247bb680e5fe0c")), "31 chars")
  debug_assert(is_err_uuid(Uuid::parse("67e5504410b1426f9247bb680e5fe0c80")), "33 chars")
  debug_assert(is_err_uuid(Uuid::parse("67e55044-10b1-426f-9247-bb680e5fe0c")), "35 chars")
  debug_assert(is_err_uuid(Uuid::parse("67e55044-10b1-426f-9247-bb680e5fe0c80")), "37 chars")
  debug_assert(is_err_uuid(Uuid::parse(" 67e55044-10b1-426f-9247-bb680e5fe0c8")), "leading space")
  debug_assert(is_err_uuid(Uuid::parse("67e55044-10b1-426f-9247-bb680e5fe0c8 ")), "trailing space")

  // Misplaced or wrong hyphens
  debug_assert(is_err_uuid(Uuid::parse("67e550441-0b1-426f-9247-bb680e5fe0c8")), "misplaced hyphen 1")
  debug_assert(is_err_uuid(Uuid::parse("67e55044_10b1_426f_9247_bb680e5fe0c8")), "underscores")
  debug_assert(is_err_uuid(Uuid::parse("67e55044-10b1-426f-92470bb680e5fe0c8")), "missing 4th hyphen")
  debug_assert(is_err_uuid(Uuid::parse("67e55044--10b1-426f-9247-bb680e5fe0c")), "double hyphen")

  // Invalid hex chars
  debug_assert(is_err_uuid(Uuid::parse("67e55044-10b1-426f-9247-bb680e5fe0cg")), "char g")
  debug_assert(is_err_uuid(Uuid::parse("67e55044-10b1-426f-9247-bb680e5fe0cG")), "char G")
  debug_assert(is_err_uuid(Uuid::parse("67e55044-10b1-426f-9247-bb680e5fe0c/")), "char /")
  debug_assert(is_err_uuid(Uuid::parse("67e55044-10b1-426f-9247-bb680e5fe0c:")), "char :")
  debug_assert(is_err_uuid(Uuid::parse("67e55044-10b1-426f-9247-bb680e5fe0c@")), "char @")
  debug_assert(is_err_uuid(Uuid::parse("67e55044-10b1-426f-9247-bb680e5fe0c`")), "char `")
  debug_assert(is_err_uuid(Uuid::parse("67e5504410b1426f9247bb680e5fe0cz")), "simple char z")

  // Bad braces & URN
  debug_assert(is_err_uuid(Uuid::parse("{67e55044-10b1-426f-9247-bb680e5fe0c8")), "unclosed brace")
  debug_assert(is_err_uuid(Uuid::parse("67e55044-10b1-426f-9247-bb680e5fe0c8}")), "unopened brace")
  debug_assert(is_err_uuid(Uuid::parse("[67e55044-10b1-426f-9247-bb680e5fe0c8]")), "brackets")
  debug_assert(is_err_uuid(Uuid::parse("{67e5504410b1426f9247bb680e5fe0c8}")), "braced simple")
  debug_assert(is_err_uuid(Uuid::parse("urn:xxxx:67e55044-10b1-426f-9247-bb680e5fe0c8")), "bad urn prefix")
  debug_assert(is_err_uuid(Uuid::parse("urn:uuid:67e5504410b1426f9247bb680e5fe0c8")), "urn simple")
}

///|
test "uuid_bytes_and_u64_pair_roundtrip" {
  let raw = hex_to_bytes("017f22e279b07cc398c4dc0c0c07398f")
  let u = unwrap_uuid(Uuid::from_bytes(raw))
  debug_assert(u.to_hyphenated() == "017f22e2-79b0-7cc3-98c4-dc0c0c07398f", "from_bytes")
  let back = u.to_bytes()
  debug_assert(back.length() == 16, "to_bytes len")
  let mut i = 0
  while i < 16 {
    debug_assert(back[i] == raw[i], "byte match")
    i = i + 1
  }
  let (hi, lo) = u.as_u64_pair()
  debug_assert(hi == 0x017f22e279b07cc3UL, "as_u64_pair hi")
  debug_assert(lo == 0x98c4dc0c0c07398fUL, "as_u64_pair lo")
  let u2 = Uuid::from_u64_pair(hi, lo)
  debug_assert(u2.eq(u), "from_u64_pair eq")
  debug_assert(is_err_uuid(Uuid::from_bytes(Bytes::new(15))), "15 bytes err")
  debug_assert(is_err_uuid(Uuid::from_bytes(Bytes::new(17))), "17 bytes err")
}

///|
test "uuid_rfc9562_appendix_a_v1_and_v6" {
  // RFC 9562 Appendix A.1 (UUIDv1) & A.5 (UUIDv6):
  // timestamp = 0x1EC9414C232AB00, clock_seq = 0x33C8, node = 9F6BDECED846
  let ticks = 0x1EC9414C232AB00L
  let clock_seq = 0x33C8
  let node = hex_to_bytes("9f6bdeced846")
  let v1 = unwrap_uuid(Uuid::new_v1(ticks, clock_seq, node))
  debug_assert(v1.to_hyphenated_upper() == "C232AB00-9414-11EC-B3C8-9F6BDECED846", "RFC 9562 A.1 v1")
  match v1.version() {
    UuidVersion::Mac => ()
    _ => debug_assert(false, "v1 version")
  }
  match v1.variant() {
    UuidVariant::Rfc4122 => ()
    _ => debug_assert(false, "v1 variant")
  }

  let v6 = unwrap_uuid(Uuid::new_v6(ticks, clock_seq, node))
  debug_assert(v6.to_hyphenated_upper() == "1EC9414C-232A-6B00-B3C8-9F6BDECED846", "RFC 9562 A.5 v6")
  match v6.version() {
    UuidVersion::SortMac => ()
    _ => debug_assert(false, "v6 version")
  }
  match v6.variant() {
    UuidVariant::Rfc4122 => ()
    _ => debug_assert(false, "v6 variant")
  }

  // Reject invalid ticks, clock_seq, node length
  debug_assert(is_err_uuid(Uuid::new_v1(-1L, 0, node)), "v1 neg ticks")
  debug_assert(is_err_uuid(Uuid::new_v1(0x1000000000000000L, 0, node)), "v1 >60bit ticks")
  debug_assert(is_err_uuid(Uuid::new_v1(0L, 0x4000, node)), "v1 >14bit clock_seq")
  debug_assert(is_err_uuid(Uuid::new_v1(0L, 0, Bytes::new(5))), "v1 5B node")
  debug_assert(is_err_uuid(Uuid::new_v6(-1L, 0, node)), "v6 neg ticks")
}

///|
test "uuid_rfc9562_appendix_a_v3_and_v5" {
  // RFC 9562 Appendix A.2 (UUIDv3) & A.4 (UUIDv5)
  let v3_ex = Uuid::new_v3(NAMESPACE_DNS, bytes_from_ascii("www.example.com"))
  debug_assert(v3_ex.to_hyphenated() == "5df41881-3aed-3515-88a7-2f4a814cf09e", "RFC 9562 A.2 v3")
  match v3_ex.version() {
    UuidVersion::Md5 => ()
    _ => debug_assert(false, "v3 version")
  }
  let v3_py = Uuid::new_v3(NAMESPACE_DNS, bytes_from_ascii("python.org"))
  debug_assert(v3_py.to_hyphenated() == "6fa459ea-ee8a-3ca4-894e-db77e160355e", "v3 python.org")

  let v5_ex = Uuid::new_v5(NAMESPACE_DNS, bytes_from_ascii("www.example.com"))
  debug_assert(v5_ex.to_hyphenated() == "2ed6657d-e927-568b-95e1-2665a8aea6a2", "RFC 9562 A.4 v5")
  match v5_ex.version() {
    UuidVersion::Sha1 => ()
    _ => debug_assert(false, "v5 version")
  }
  let v5_py = Uuid::new_v5(NAMESPACE_DNS, bytes_from_ascii("python.org"))
  debug_assert(v5_py.to_hyphenated() == "886313e1-3b8a-5372-9b90-0c9aee199e5d", "v5 python.org")
  let v5_url = Uuid::new_v5(NAMESPACE_URL, bytes_from_ascii("https://example.com"))
  debug_assert(v5_url.to_hyphenated() == "4fd35a71-71ef-5a55-a9d9-aa75c889a6d0", "v5 url")
  let v5_oid = Uuid::new_v5(NAMESPACE_OID, bytes_from_ascii("1.3.6.1.4.1"))
  debug_assert(v5_oid.to_hyphenated() == "106dd502-8b3e-50db-80ed-1134f5c18eae", "v5 oid")
  let v5_x500 = Uuid::new_v5(NAMESPACE_X500, bytes_from_ascii("cn=example"))
  debug_assert(v5_x500.to_hyphenated() == "3ecc4f45-80bb-593a-be98-00e146377827", "v5 x500")
}

///|
test "uuid_rfc9562_appendix_a_v4_v7_v8" {
  // A.3 UUIDv4
  let r4 = hex_to_bytes("919108f752d143209bacf847db4148a8")
  let v4 = unwrap_uuid(Uuid::from_random_bytes_v4(r4))
  debug_assert(v4.to_hyphenated() == "919108f7-52d1-4320-9bac-f847db4148a8", "RFC 9562 A.3 v4")
  match v4.version() {
    UuidVersion::Random => ()
    _ => debug_assert(false, "v4 version")
  }
  // Ensure version & variant bits are forced even if input bytes have 0xFF
  let all_ff = hex_to_bytes("ffffffffffffffffffffffffffffffff")
  let v4_ff = unwrap_uuid(Uuid::from_random_bytes_v4(all_ff))
  debug_assert(v4_ff.to_hyphenated() == "ffffffff-ffff-4fff-bfff-ffffffffffff", "v4 masks version+variant")

  // A.6 UUIDv7: ts_ms = 0x017F22E279B0 (1645557742000), rand10 = 0x0cc3_18c4dc0c0c07398f
  let rand10 = hex_to_bytes("0cc318c4dc0c0c07398f")
  let v7 = unwrap_uuid(Uuid::new_v7(1645557742000L, rand10))
  debug_assert(v7.to_hyphenated_upper() == "017F22E2-79B0-7CC3-98C4-DC0C0C07398F", "RFC 9562 A.6 v7")
  match v7.version() {
    UuidVersion::SortRand => ()
    _ => debug_assert(false, "v7 version")
  }
  match v7.timestamp_ms() {
    Some(ms) => debug_assert(ms == 1645557742000L, "v7 ts_ms")
    None => debug_assert(false, "v7 timestamp_ms expected Some")
  }
  // Non-v7 returns None for timestamp_ms
  match v4.timestamp_ms() {
    None => ()
    Some(_) => debug_assert(false, "v4 timestamp_ms should be None")
  }
  // Reject negative or >48-bit timestamp and wrong rand10 length
  debug_assert(is_err_uuid(Uuid::new_v7(-1L, rand10)), "v7 neg ts")
  debug_assert(is_err_uuid(Uuid::new_v7(0x1000000000000L, rand10)), "v7 >48bit ts")
  debug_assert(is_err_uuid(Uuid::new_v7(0L, Bytes::new(9))), "v7 9B rand")

  // A.7 UUIDv8
  let custom = hex_to_bytes("2489e9ad2ee20e000ec932d5f69181c0")
  let v8 = unwrap_uuid(Uuid::new_v8(custom))
  debug_assert(v8.to_hyphenated_upper() == "2489E9AD-2EE2-8E00-8EC9-32D5F69181C0", "RFC 9562 A.7 v8")
  match v8.version() {
    UuidVersion::Custom => ()
    _ => debug_assert(false, "v8 version")
  }
}

///|
test "uuid_v7_monotonic_context" {
  let ctx = V7Context::new()
  let ts = 1700000000000L
  let mut prev = unwrap_uuid(ctx.generate_parts(ts, 0x100, 0x123456L))
  let mut i = 0
  while i < 5000 {
    let cur = unwrap_uuid(ctx.generate_parts(ts, 0x0, 0x999999L))
    debug_assert(prev.compare(cur) < 0, "v7 monotonic strictly increasing across rollover")
    prev = cur
    i = i + 1
  }
  // Clock rollback still strictly monotonic
  let rolled = unwrap_uuid(ctx.generate_parts(ts - 1000L, 0x0, 0x1L))
  debug_assert(prev.compare(rolled) < 0, "v7 rollback stays monotonic")

  // Max timestamp rollover overflows explicitly
  let ctx_max = V7Context::new()
  let max_ts = 0xFFFFFFFFFFFFL
  let _ = unwrap_uuid(ctx_max.generate_parts(max_ts, 0x7FF, 0L))
  let mut k = 0
  let mut saw_overflow = false
  while k < 3000 {
    match ctx_max.generate_parts(max_ts, 0, 0L) {
      Ok(_) => ()
      Err(UuidError::SequenceOverflow) => {
        saw_overflow = true
        break
      }
      Err(_) => debug_assert(false, "unexpected err")
    }
    k = k + 1
  }
  debug_assert(saw_overflow, "v7 max ts sequence overflow")
}

///|
test "uuid_variants_and_unsigned_128bit_compare" {
  // All 4 variant classifications
  let v_ncs = unwrap_uuid(Uuid::parse("00000000-0000-0000-7fff-000000000000"))
  let v_rfc = unwrap_uuid(Uuid::parse("00000000-0000-0000-8000-000000000000"))
  let v_ms = unwrap_uuid(Uuid::parse("00000000-0000-0000-c000-000000000000"))
  let v_fut = unwrap_uuid(Uuid::parse("00000000-0000-0000-e000-000000000000"))
  match v_ncs.variant() {
    UuidVariant::Ncs => ()
    _ => debug_assert(false, "NCS")
  }
  match v_rfc.variant() {
    UuidVariant::Rfc4122 => ()
    _ => debug_assert(false, "RFC4122")
  }
  match v_ms.variant() {
    UuidVariant::Microsoft => ()
    _ => debug_assert(false, "Microsoft")
  }
  match v_fut.variant() {
    UuidVariant::Future => ()
    _ => debug_assert(false, "Future")
  }

  // Unsigned 128-bit ordering across all 4 sign quadrants (MSB=0 vs MSB=1 in hi and lo)
  let a = Uuid::from_u64_pair(0x0000000000000000UL, 0x0000000000000000UL)
  let b = Uuid::from_u64_pair(0x7fffffffffffffffUL, 0x7fffffffffffffffUL)
  let c = Uuid::from_u64_pair(0x7fffffffffffffffUL, 0x8000000000000000UL)
  let d = Uuid::from_u64_pair(0x7fffffffffffffffUL, 0xffffffffffffffffUL)
  let e = Uuid::from_u64_pair(0x8000000000000000UL, 0x0000000000000000UL)
  let f = Uuid::from_u64_pair(0x8000000000000000UL, 0x8000000000000000UL)
  let g = Uuid::from_u64_pair(0xffffffffffffffffUL, 0xffffffffffffffffUL)

  debug_assert(a.compare(b) < 0 && b.compare(a) > 0, "a < b")
  debug_assert(b.compare(c) < 0 && c.compare(b) > 0, "b < c (lo MSB flip)")
  debug_assert(c.compare(d) < 0 && d.compare(c) > 0, "c < d")
  debug_assert(d.compare(e) < 0 && e.compare(d) > 0, "d < e (hi MSB flip)")
  debug_assert(e.compare(f) < 0 && f.compare(e) > 0, "e < f")
  debug_assert(f.compare(g) < 0 && g.compare(f) > 0, "f < g")
  debug_assert(e.compare(e) == 0, "e == e")
}

///|
test "uuid_redteam_regression_batch_sort_and_v1_v6_ts" {
  // P1-1: blank lines before simple UUID and blank-line runs
  let his : Array[UInt64] = []
  let los : Array[UInt64] = []
  debug_assert(parse_uuid_lines_raw("\n\n\n\n67e5504410b1426f9247bb680e5fe0c8\n", his, los), "blank lines + simple")
  debug_assert(his.length() == 1, "1 parsed")
  // P2-8: bare CR without LF rejected
  let his_cr : Array[UInt64] = []
  let los_cr : Array[UInt64] = []
  debug_assert(!parse_uuid_lines_raw("\r", his_cr, los_cr), "bare CR rejected")
  // P2-1: rollback on error leaves arrays untouched
  let his_rb : Array[UInt64] = [42UL]
  let los_rb : Array[UInt64] = [99UL]
  debug_assert(
    !parse_uuid_lines_raw("67e55044-10b1-426f-9247-bb680e5fe0c8\nnot-a-uuid\n", his_rb, los_rb),
    "invalid line fails",
  )
  debug_assert(his_rb.length() == 1 && los_rb.length() == 1 && his_rb[0] == 42UL, "rollback preserves prefix")
  // P2-2: length mismatch / n > cap sorts common prefix
  let mh : Array[UInt64] = [3UL, 2UL, 1UL]
  let ml : Array[UInt64] = [0UL, 0UL]
  sort_u128_pairs_raw(mh, ml)
  debug_assert(mh[0] == 2UL && mh[1] == 3UL, "raw sort common prefix")
  let fh : FixedArray[UInt64] = [3UL, 2UL, 1UL]
  let fl : FixedArray[UInt64] = [0UL, 0UL, 0UL]
  sort_u128_pairs_fixed(fh, fl, 10)
  debug_assert(fh[0] == 1UL && fh[2] == 3UL, "fixed sort clamped")
  // P2-3: short out_pair returns false instead of panic
  let short_pair : FixedArray[UInt64] = FixedArray::make(1, 0UL)
  debug_assert(!parse_uuid_slice_raw("67e55044-10b1-426f-9247-bb680e5fe0c8", 0, 36, short_pair), "short pair slice")
  debug_assert(!uuid_v7_raw(1L, Bytes::new(10), short_pair), "short pair v7")
  uuid_v5_raw(0UL, 0UL, Bytes::new(3), short_pair)
  // P2-5 & P2-6: variant-agnostic version() + v1/v6 timestamp_ms()
  let ncs = Uuid::from_u64_pair(0x123456789ABC4DEFUL, 0x0012345678ABCDEFUL)
  match ncs.version() {
    UuidVersion::Random => ()
    _ => debug_assert(false, "variant-agnostic version()")
  }
  let ticks = 1700000000000L * 10000L + 0x01B21DD213814000L
  let v1 = unwrap_uuid(Uuid::new_v1(ticks, 0, Bytes::new(6)))
  let v6 = unwrap_uuid(Uuid::new_v6(ticks, 0, Bytes::new(6)))
  match v1.timestamp_ms() {
    Some(ms) => debug_assert(ms == 1700000000000L, "v1 timestamp_ms")
    None => debug_assert(false, "v1 timestamp_ms expected Some")
  }
  match v6.timestamp_ms() {
    Some(ms) => debug_assert(ms == 1700000000000L, "v6 timestamp_ms")
    None => debug_assert(false, "v6 timestamp_ms expected Some")
  }
  // V7Context42: 100k same-ms burst with 0 ms drift
  let ctx42 = V7Context42::new()
  let mut prev42 = unwrap_uuid(ctx42.generate_parts(1700000000000L, 0x123, 0L))
  let mut k = 0
  while k < 100000 {
    let cur = unwrap_uuid(ctx42.generate_parts(1700000000000L, 0x123, 0L))
    debug_assert(prev42.compare(cur) < 0, "ctx42 strictly monotonic")
    prev42 = cur
    k = k + 1
  }
  match prev42.timestamp_ms() {
    Some(ms) => debug_assert(ms == 1700000000000L, "ctx42 0 ms drift at 100k")
    None => debug_assert(false, "ctx42 ts")
  }
}
