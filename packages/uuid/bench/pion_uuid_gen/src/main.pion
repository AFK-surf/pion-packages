///| Benchmark 2: 200,000 UUID v5 (SHA-1) + v7 generation and hyphenated formatting.

import "uuid"

///|
fn splitmix64(x_in : UInt64) -> UInt64 {
  let x = x_in + 0x9E3779B97F4A7C15UL
  let mut z = x
  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9UL
  z = (z ^ (z >> 27)) * 0x94D049BB133111EBUL
  z ^ (z >> 31)
}

///|
fn parse_u64_arg(s : String) -> Int64 {
  let n = s.length()
  let mut acc : Int64 = 0L
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i) - 48
    if c >= 0 && c <= 9 {
      acc = acc * 10L + c.to_int64()
    }
    i = i + 1
  }
  acc
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let count : Int64 = if args.length() > 1 { parse_u64_arg(args[1]) } else { 200000L }

  let mut hash : UInt64 = 14695981039346656037UL
  let mut total_bytes : Int64 = 0L
  let buf = Bytes::new(36)
  let pair : FixedArray[UInt64] = FixedArray::make(2, 0UL)
  let ns_hi = uuid::NAMESPACE_DNS.hi.to_uint64()
  let ns_lo = uuid::NAMESPACE_DNS.lo.to_uint64()
  let tmpl = "svc-00000000.example.com"
  let name = Bytes::new(24)
  let mut k = 0
  while k < 24 {
    name[k] = tmpl.code_unit_at(k).to_byte()
    k = k + 1
  }
  let rand10 = Bytes::new(10)
  let mut first_v5 = ""
  let mut last_v5 = ""
  let mut first_v7 = ""
  let mut last_v7 = ""

  let mut i : Int64 = 0L
  while i < count {
    let mut x = i
    let mut d = 11
    while d >= 4 {
      name[d] = (48 + (x % 10L).to_int()).to_byte()
      x = x / 10L
      d = d - 1
    }
    uuid::uuid_v5_raw(ns_hi, ns_lo, name, pair)
    let v5_hi = pair[0]
    let v5_lo = pair[1]

    let iu = i.to_uint64()
    let r1 = splitmix64(iu)
    let r2 = splitmix64(iu + 1000000UL)
    rand10[0] = ((r1 >> 8) & 0xFFUL).to_int().to_byte()
    rand10[1] = (r1 & 0xFFUL).to_int().to_byte()
    rand10[2] = ((r2 >> 56) & 0xFFUL).to_int().to_byte()
    rand10[3] = ((r2 >> 48) & 0xFFUL).to_int().to_byte()
    rand10[4] = ((r2 >> 40) & 0xFFUL).to_int().to_byte()
    rand10[5] = ((r2 >> 32) & 0xFFUL).to_int().to_byte()
    rand10[6] = ((r2 >> 24) & 0xFFUL).to_int().to_byte()
    rand10[7] = ((r2 >> 16) & 0xFFUL).to_int().to_byte()
    rand10[8] = ((r2 >> 8) & 0xFFUL).to_int().to_byte()
    rand10[9] = (r2 & 0xFFUL).to_int().to_byte()
    let ts_ms = 1700000000000L + (i / 100L)
    if !uuid::uuid_v7_raw(ts_ms, rand10, pair) {
      return 1
    }
    let v7_hi = pair[0]
    let v7_lo = pair[1]

    let _ = uuid::encode_uuid_hyphenated_raw(v5_hi, v5_lo, buf, 0)
    let mut j = 0
    while j < 36 {
      hash = (hash ^ buf[j].to_int().to_int64().to_uint64()) * 1099511628211UL
      j = j + 1
    }
    total_bytes = total_bytes + 36L

    let _ = uuid::encode_uuid_hyphenated_raw(v7_hi, v7_lo, buf, 0)
    j = 0
    while j < 36 {
      hash = (hash ^ buf[j].to_int().to_int64().to_uint64()) * 1099511628211UL
      j = j + 1
    }
    total_bytes = total_bytes + 36L

    if i == 0L {
      first_v5 = uuid::Uuid::from_u64_pair(v5_hi, v5_lo).to_hyphenated()
      first_v7 = uuid::Uuid::from_u64_pair(v7_hi, v7_lo).to_hyphenated()
    }
    if i + 1L == count {
      last_v5 = uuid::Uuid::from_u64_pair(v5_hi, v5_lo).to_hyphenated()
      last_v7 = uuid::Uuid::from_u64_pair(v7_hi, v7_lo).to_hyphenated()
    }
    i = i + 1L
  }

  io_println(world, "count=" + count.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  io_println(world, "first_v5=" + first_v5)
  io_println(world, "last_v5=" + last_v5)
  io_println(world, "first_v7=" + first_v7)
  io_println(world, "last_v7=" + last_v7)
  0
}
