///| Wasm32 smoke entry for the `uuid` package.

import "uuid"

///|
pub fn smoke() -> Int {
  let u = match uuid::Uuid::parse("67e55044-10b1-426f-9247-bb680e5fe0c8") {
    Ok(v) => v
    Err(_) => return 1
  }
  if u.to_hyphenated() != "67e55044-10b1-426f-9247-bb680e5fe0c8" {
    return 2
  }
  let name = Bytes::new(3)
  name[0] = (97).to_byte()
  name[1] = (98).to_byte()
  name[2] = (99).to_byte()
  let v5 = uuid::Uuid::new_v5(uuid::NAMESPACE_DNS, name)
  if v5.to_simple().length() != 32 {
    return 3
  }
  let ctx = uuid::V7Context::new()
  let v7a = match ctx.generate_parts(1700000000000L, 1, 100L) {
    Ok(v) => v
    Err(_) => return 4
  }
  let v7b = match ctx.generate_parts(1700000000000L, 0, 100L) {
    Ok(v) => v
    Err(_) => return 5
  }
  if v7a.compare(v7b) >= 0 {
    return 6
  }
  let ul = match uuid::Ulid::parse("01AN4Z07BY79KA1307SR9X4MV3") {
    Ok(v) => v
    Err(_) => return 7
  }
  if ul.timestamp_ms() != 1465824320894L {
    return 8
  }
  if ul.to_string() != "01AN4Z07BY79KA1307SR9X4MV3" {
    return 9
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  smoke()
}
