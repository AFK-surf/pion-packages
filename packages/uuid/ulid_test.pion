///| ULID official specification & rust-ulid compliance test suite.

///|
fn unwrap_ulid(r : Result[Ulid, UlidError]) -> Ulid {
  match r {
    Ok(u) => u
    Err(_) => {
      debug_assert(false, "expected Ok(Ulid)")
      Ulid::nil()
    }
  }
}

///|
fn is_err_ulid(r : Result[Ulid, UlidError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
test "ulid_nil_max_and_spec_vector" {
  let nil = Ulid::nil()
  debug_assert(nil.to_string() == "00000000000000000000000000", "nil str")
  debug_assert(nil.timestamp_ms() == 0L, "nil ts")

  let max = Ulid::max()
  debug_assert(max.to_string() == "7ZZZZZZZZZZZZZZZZZZZZZZZZZ", "max str")
  debug_assert(max.timestamp_ms() == 0xFFFFFFFFFFFFL, "max ts")

  let parsed_nil = unwrap_ulid(Ulid::parse("00000000000000000000000000"))
  debug_assert(parsed_nil.eq(nil), "parse nil")
  let parsed_max = unwrap_ulid(Ulid::parse("7ZZZZZZZZZZZZZZZZZZZZZZZZZ"))
  debug_assert(parsed_max.eq(max), "parse max")

  // Official ULID spec examples:
  // 01AN4Z07BY79KA1307SR9X4MV3 -> ts = 1465824320894
  // 01ARYZ6S41TSV4RRFFQ69G5FAV -> ts = 1469918176385
  let spec = unwrap_ulid(Ulid::parse("01AN4Z07BY79KA1307SR9X4MV3"))
  debug_assert(spec.timestamp_ms() == 1465824320894L, "spec ts_ms 01AN4Z07BY")
  debug_assert(spec.to_string() == "01AN4Z07BY79KA1307SR9X4MV3", "spec roundtrip")
  let spec2 = unwrap_ulid(Ulid::parse("01ARYZ6S41TSV4RRFFQ69G5FAV"))
  debug_assert(spec2.timestamp_ms() == 1469918176385L, "spec ts_ms 01ARYZ6S41")
  debug_assert(spec2.to_string() == "01ARYZ6S41TSV4RRFFQ69G5FAV", "spec2 roundtrip")
}

///|
test "ulid_crockford_case_and_aliases" {
  // Lowercase + Crockford aliases: i/I/l/L -> 1, o/O -> 0
  let u1 = unwrap_ulid(Ulid::parse("01an4z07by79ka1307sr9x4mv3"))
  debug_assert(u1.to_string() == "01AN4Z07BY79KA1307SR9X4MV3", "lowercase")

  let u_alias = unwrap_ulid(Ulid::parse("oIan4zO7by79kaL3o7sr9x4mv3"))
  debug_assert(u_alias.to_string() == "01AN4Z07BY79KA1307SR9X4MV3", "crockford aliases i/I/l/L/o/O")

  let u_all_zero = unwrap_ulid(Ulid::parse("oOoOoOoOoOoOoOoOoOoOoOoOoO"))
  debug_assert(u_all_zero.eq(Ulid::nil()), "o/O -> 0")

  let u_ones = unwrap_ulid(Ulid::parse("iIlLiIlLiIlLiIlLiIlLiIlLiI"))
  debug_assert(u_ones.to_string() == "11111111111111111111111111", "i/I/l/L -> 1")
}

///|
test "ulid_reject_invalid_and_overflow" {
  // Wrong length
  debug_assert(is_err_ulid(Ulid::parse("")), "empty")
  debug_assert(is_err_ulid(Ulid::parse("01AN4Z07BY79KA1307SR9X4MV")), "25 chars")
  debug_assert(is_err_ulid(Ulid::parse("01AN4Z07BY79KA1307SR9X4MV30")), "27 chars")

  // Invalid characters: U / u, hyphen, space, symbol
  debug_assert(is_err_ulid(Ulid::parse("01AN4Z07BY79KA1307SR9X4MVU")), "char U at end")
  debug_assert(is_err_ulid(Ulid::parse("01AN4Z07BY79KA1307SR9X4MVu")), "char u at end")
  debug_assert(is_err_ulid(Ulid::parse("U0000000000000000000000000")), "char U at start")
  debug_assert(is_err_ulid(Ulid::parse("01AN4Z07BY-9KA1307SR9X4MV3")), "hyphen")
  debug_assert(is_err_ulid(Ulid::parse("01AN4Z07BY 9KA1307SR9X4MV3")), "space")
  debug_assert(is_err_ulid(Ulid::parse("01AN4Z07BY@9KA1307SR9X4MV3")), "symbol @")

  // 128-bit overflow: first character > '7' (8..9, A..Z except I,L,O,U)
  match Ulid::parse("80000000000000000000000000") {
    Err(UlidError::Overflow) => ()
    _ => debug_assert(false, "8000... must be Overflow")
  }
  match Ulid::parse("ZZZZZZZZZZZZZZZZZZZZZZZZZZ") {
    Err(UlidError::Overflow) => ()
    _ => debug_assert(false, "ZZZZ... must be Overflow")
  }
  match Ulid::parse("90000000000000000000000000") {
    Err(UlidError::Overflow) => ()
    _ => debug_assert(false, "9000... must be Overflow")
  }
  match Ulid::parse("A0000000000000000000000000") {
    Err(UlidError::Overflow) => ()
    _ => debug_assert(false, "A000... must be Overflow")
  }

  // Invalid timestamp in from_parts
  debug_assert(is_err_ulid(Ulid::from_parts(-1L, 0L, 0L)), "neg ts")
  debug_assert(is_err_ulid(Ulid::from_parts(0x1000000000000L, 0L, 0L)), ">48bit ts")
}

///|
test "ulid_bytes_uuid_conversion_and_unsigned_compare" {
  let u = unwrap_ulid(Ulid::from_parts(1469918176385L, 0xBEEFL, -1L))
  debug_assert(u.timestamp_ms() == 1469918176385L, "from_parts ts")
  let (rhi, rlo) = u.random_parts()
  debug_assert(rhi == 0xBEEFL && rlo == -1L, "random_parts")

  let b = u.to_bytes()
  debug_assert(b.length() == 16, "ulid bytes len")
  let u2 = unwrap_ulid(Ulid::from_bytes(b))
  debug_assert(u2.eq(u), "bytes roundtrip")
  debug_assert(is_err_ulid(Ulid::from_bytes(Bytes::new(15))), "15B err")

  let as_uuid = u.to_uuid()
  let back_ulid = Ulid::from_uuid(as_uuid)
  debug_assert(back_ulid.eq(u), "uuid roundtrip")

  // Unsigned 128-bit ordering across sign boundary
  let x1 = Ulid::from_u64_pair(0x7fffffffffffffffUL, 0x7fffffffffffffffUL)
  let x2 = Ulid::from_u64_pair(0x7fffffffffffffffUL, 0x8000000000000000UL)
  let x3 = Ulid::from_u64_pair(0x8000000000000000UL, 0x0000000000000000UL)
  let x4 = Ulid::from_u64_pair(0xffffffffffffffffUL, 0xffffffffffffffffUL)
  debug_assert(x1.compare(x2) < 0, "ulid lo MSB flip")
  debug_assert(x2.compare(x3) < 0, "ulid hi MSB flip")
  debug_assert(x3.compare(x4) < 0, "ulid hi max")
  // String lexicographical order matches 128-bit compare
  debug_assert(x1.to_string() < x2.to_string(), "str order 1 < 2")
  debug_assert(x2.to_string() < x3.to_string(), "str order 2 < 3")
  debug_assert(x3.to_string() < x4.to_string(), "str order 3 < 4")
}

///|
test "ulid_monotonic_generator_and_overflow" {
  let gen = MonotonicUlid::new()
  let ts = 1700000000000L
  // Start near 64-bit carry boundary: rand_hi = 0x0001, rand_lo = 0xFFFFFFFFFFFFFFFE (-2L)
  let a = unwrap_ulid(gen.generate(ts, 1L, -2L))
  let b = unwrap_ulid(gen.generate(ts, 0L, 0L))
  let c = unwrap_ulid(gen.generate(ts, 0L, 0L))
  debug_assert(a.compare(b) < 0 && b.compare(c) < 0, "strictly increasing across 64-bit carry")
  let (b_rhi, b_rlo) = b.random_parts()
  let (c_rhi, c_rlo) = c.random_parts()
  debug_assert(b_rhi == 1L && b_rlo == -1L, "b = (1, 0xFFFF...FFFF)")
  debug_assert(c_rhi == 2L && c_rlo == 0L, "c carried into rand_hi = 2, rand_lo = 0")
  debug_assert(c.timestamp_ms() == ts, "same ts preserved")

  // Clock rollback still increments monotonically
  let d = unwrap_ulid(gen.generate(ts - 500L, 0L, 0L))
  debug_assert(c.compare(d) < 0 && d.timestamp_ms() == ts, "rollback stays monotonic")

  // 80-bit saturation must return Err(UlidError::Overflow) and NOT wrap into timestamp
  let gen_sat = MonotonicUlid::new()
  let sat = unwrap_ulid(gen_sat.generate(ts, 0xFFFFL, -1L))
  debug_assert(sat.timestamp_ms() == ts, "sat ts")
  match gen_sat.generate(ts, 0L, 0L) {
    Err(UlidError::Overflow) => ()
    _ => debug_assert(false, "80-bit saturation must return Overflow")
  }
  // Advancing timestamp after overflow succeeds cleanly
  let next_ms = unwrap_ulid(gen_sat.generate(ts + 1L, 0L, 0L))
  debug_assert(next_ms.timestamp_ms() == ts + 1L, "next ms ok after overflow")
}

///|
test "ulid_strict_mode_and_batch_regressions" {
  // Ulid::parse_strict rejects Crockford I/L/O aliases (matching Rust ulid 1.2.1)
  debug_assert(unwrap_ulid(Ulid::parse_strict("01AN4Z07BY79KA1307SR9X4MV3")).timestamp_ms() == 1465824320894L, "strict valid")
  debug_assert(is_err_ulid(Ulid::parse_strict("0IAN4Z07BY79KA1307SR9X4MV3")), "strict rejects I")
  debug_assert(is_err_ulid(Ulid::parse_strict("01AN4Z07BY79KA13O7SR9X4MV3")), "strict rejects O")
  debug_assert(is_err_ulid(Ulid::parse_strict("01AN4Z07BY79KA1307SR9X4MVL")), "strict rejects L")
  // P1-1 & P2-1 & P2-8: blank lines, rollback, bare CR
  let his : Array[UInt64] = []
  let los : Array[UInt64] = []
  debug_assert(!parse_ulid_lines_raw("\r", his, los), "ulid bare CR rejected")
  debug_assert(!parse_ulid_lines_raw("01AN4Z07BY79KA1307SR9X4MV3\nbad\n", his, los), "ulid batch error")
  debug_assert(his.length() == 0 && los.length() == 0, "ulid batch rollback")
  // P2-3: short out_pair returns false
  let short_pair : FixedArray[UInt64] = FixedArray::make(1, 0UL)
  debug_assert(!parse_ulid_slice_raw("01AN4Z07BY79KA1307SR9X4MV3", 0, 26, short_pair), "ulid short out_pair")
}
