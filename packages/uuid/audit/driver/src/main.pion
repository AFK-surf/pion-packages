///| Red-team differential driver: runs the same corpus as `audit/oracle` (Rust uuid 1.29.3 / ulid 1.2.1)
///| through the Pion `uuid` package and prints `<line_no>\t<op>\t<result>` in the identical format.
///| Where several Pion entry points exist for one operation (typed vs raw), they are cross-checked and any
///| disagreement is printed as `INTERNAL_MISMATCH ...`.

import "uuid"

///|
fn splitmix64(x_in : UInt64) -> UInt64 {
  let x = x_in + 0x9E3779B97F4A7C15UL
  let mut z = x
  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9UL
  z = (z ^ (z >> 27)) * 0x94D049BB133111EBUL
  z ^ (z >> 31)
}

///|
fn signed_edge(k : UInt64) -> UInt64 {
  let i = (k % 6UL).to_int()
  if i == 0 {
    0x7FFFFFFFFFFFFFFFUL
  } else if i == 1 {
    0x8000000000000000UL
  } else if i == 2 {
    0UL
  } else if i == 3 {
    0xFFFFFFFFFFFFFFFFUL
  } else if i == 4 {
    0x7FFFFFFFFFFFFFFEUL
  } else {
    0x8000000000000001UL
  }
}

///| Mirror of `gen_pair` in `audit/oracle/src/common.rs`; writes into out[0], out[1].
fn gen_pair(kind : String, i : UInt64, n : UInt64, seed : UInt64, out : FixedArray[UInt64]) -> Unit {
  let base = seed * 1000003UL
  let r1 = splitmix64(base + i * 2UL)
  let r2 = splitmix64(base + i * 2UL + 1UL)
  if kind == "random" {
    out[0] = r1
    out[1] = r2
  } else if kind == "equal" {
    out[0] = 0xDEADBEEF00000001UL
    out[1] = 0x8000000000000000UL
  } else if kind == "sorted" {
    out[0] = i
    out[1] = i
  } else if kind == "reverse" {
    out[0] = 0xFFFFFFFFFFFFFFFFUL - i
    out[1] = 0xFFFFFFFFFFFFFFFFUL - i
  } else if kind == "lo64" {
    out[0] = 0x0123456789ABCDEFUL
    out[1] = r2
  } else if kind == "lastbyte" {
    out[0] = 0x0123456789ABCDEFUL
    out[1] = 0xFEDCBA9876543200UL | (r2 & 0xFFUL)
  } else if kind == "signed" {
    out[0] = signed_edge(r1)
    out[1] = signed_edge(r2)
  } else if kind == "dup33" {
    let g = i / 33UL
    out[0] = splitmix64(seed ^ g)
    out[1] = splitmix64(g + 0x5555UL)
  } else if kind == "deep33" {
    let g = i / 33UL
    out[0] = splitmix64(seed ^ g)
    out[1] = (splitmix64(g) & 0xFFFFFFFFFFFFFF00UL) | (i % 33UL)
  } else {
    // sawtooth
    out[0] = (i % 257UL) << 56
    out[1] = n - i
  }
}

///|
fn fnv_word(h_in : UInt64, w : UInt64) -> UInt64 {
  let mut h = h_in
  let mut s = 56
  while s >= 0 {
    h = (h ^ ((w >> s) & 0xFFUL)) * 1099511628211UL
    s = s - 8
  }
  h
}

///|
fn hex_u64(x : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    let sh : Int = (15 - i) * 4
    let d = ((x >> sh) & 0xFUL).to_int()
    out[i] = (if d < 10 { d + 48 } else { d + 87 }).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
fn nib(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///|
fn unhex(s : String) -> Bytes {
  let n = s.length() / 2
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = ((nib(s.code_unit_at(2 * i)) << 4) | nib(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  b
}

///|
fn u64_be(b : Bytes, off : Int, len : Int) -> UInt64 {
  let mut acc = 0UL
  let mut i = 0
  while i < len {
    acc = (acc << 8) | b[off + i].to_int().to_int64().to_uint64()
    i = i + 1
  }
  acc
}

///|
fn parse_u64(s : String) -> UInt64 {
  let mut acc = 0UL
  let mut i = 0
  while i < s.length() {
    acc = acc * 10UL + (s.code_unit_at(i) - 48).to_int64().to_uint64()
    i = i + 1
  }
  acc
}

///|
fn gen_name(len : Int, seed : UInt64) -> Bytes {
  let b = Bytes::new(len)
  let base = seed * 7919UL
  let mut k = 0
  while k < len {
    b[k] = (splitmix64(base + k.to_int64().to_uint64()) & 0xFFUL).to_int().to_byte()
    k = k + 1
  }
  b
}

///|
fn ns_of(hex : String) -> uuid::Uuid {
  let b = unhex(hex)
  uuid::Uuid::from_u64_pair(u64_be(b, 0, 8), u64_be(b, 8, 8))
}

///|
fn uuid_of(hex : String) -> uuid::Uuid {
  ns_of(hex)
}

///|
fn var_name(v : uuid::UuidVariant) -> String {
  match v {
    uuid::UuidVariant::Ncs => "Ncs"
    uuid::UuidVariant::Rfc4122 => "Rfc4122"
    uuid::UuidVariant::Microsoft => "Microsoft"
    uuid::UuidVariant::Future => "Future"
  }
}

///|
fn ver_name(v : uuid::UuidVersion) -> String {
  match v {
    uuid::UuidVersion::Nil => "Nil"
    uuid::UuidVersion::Mac => "Mac"
    uuid::UuidVersion::Dce => "Dce"
    uuid::UuidVersion::Md5 => "Md5"
    uuid::UuidVersion::Random => "Random"
    uuid::UuidVersion::Sha1 => "Sha1"
    uuid::UuidVersion::SortMac => "SortMac"
    uuid::UuidVersion::SortRand => "SortRand"
    uuid::UuidVersion::Custom => "Custom"
    uuid::UuidVersion::Max => "Max"
    uuid::UuidVersion::Unknown(_) => "none"
  }
}

///|
fn res_uuid(r : Result[uuid::Uuid, uuid::UuidError]) -> String {
  match r {
    Ok(u) => u.to_hyphenated()
    Err(_) => "err"
  }
}

///|
fn res_ulid_ok(r : Result[uuid::Ulid, uuid::UlidError]) -> String {
  match r {
    Ok(u) => "ok " + u.to_string()
    Err(_) => "err"
  }
}

///|
fn pairs_hash_result(his : Array[UInt64], los : Array[UInt64]) -> String {
  let mut h : UInt64 = 14695981039346656037UL
  let mut i = 0
  while i < his.length() {
    h = fnv_word(h, his[i])
    h = fnv_word(h, los[i])
    i = i + 1
  }
  "n=" + his.length().to_string() + " h=" + hex_u64(h)
}

///|
fn sort_case(op : String, kind : String, n : Int, seed : UInt64) -> String {
  let nn = n.to_int64().to_uint64()
  let p : FixedArray[UInt64] = FixedArray::make(2, 0UL)
  let his : Array[UInt64] = []
  let los : Array[UInt64] = []
  if op == "sort_uuid" {
    let arr : Array[uuid::Uuid] = []
    let mut i = 0
    while i < n {
      gen_pair(kind, i.to_int64().to_uint64(), nn, seed, p)
      arr.push(uuid::Uuid::from_u64_pair(p[0], p[1]))
      i = i + 1
    }
    uuid::Uuid::sort(arr)
    i = 0
    while i < n {
      let (h, l) = arr[i].as_u64_pair()
      his.push(h)
      los.push(l)
      i = i + 1
    }
  } else if op == "sort_ulid" {
    let arr : Array[uuid::Ulid] = []
    let mut i = 0
    while i < n {
      gen_pair(kind, i.to_int64().to_uint64(), nn, seed, p)
      arr.push(uuid::Ulid::from_u64_pair(p[0], p[1]))
      i = i + 1
    }
    uuid::Ulid::sort(arr)
    i = 0
    while i < n {
      let (h, l) = arr[i].as_u64_pair()
      his.push(h)
      los.push(l)
      i = i + 1
    }
  } else if op == "sort_raw" {
    let mut i = 0
    while i < n {
      gen_pair(kind, i.to_int64().to_uint64(), nn, seed, p)
      his.push(p[0])
      los.push(p[1])
      i = i + 1
    }
    uuid::sort_u128_pairs_raw(his, los)
  } else {
    let fh : FixedArray[UInt64] = FixedArray::make(n + 1, 0UL)
    let fl : FixedArray[UInt64] = FixedArray::make(n + 1, 0UL)
    let mut i = 0
    while i < n {
      gen_pair(kind, i.to_int64().to_uint64(), nn, seed, p)
      fh[i] = p[0]
      fl[i] = p[1]
      i = i + 1
    }
    uuid::sort_u128_pairs_fixed(fh, fl, n)
    i = 0
    while i < n {
      his.push(fh[i])
      los.push(fl[i])
      i = i + 1
    }
  }
  pairs_hash_result(his, los)
}

///|
fn lines_case(op : String, content : String) -> String {
  let his : Array[UInt64] = []
  let los : Array[UInt64] = []
  if op == "lines" || op == "ullines" {
    let ok = if op == "lines" {
      uuid::parse_uuid_lines_raw(content, his, los)
    } else {
      uuid::parse_ulid_lines_raw(content, his, los)
    }
    if ok {
      "ok " + pairs_hash_result(his, los)
    } else {
      "err"
    }
  } else {
    let cap = content.length() + 1
    let fh : FixedArray[UInt64] = FixedArray::make(cap, 0UL)
    let fl : FixedArray[UInt64] = FixedArray::make(cap, 0UL)
    let cnt = if op == "lines_fixed" {
      uuid::parse_uuid_lines_fixed(content, fh, fl)
    } else {
      uuid::parse_ulid_lines_fixed(content, fh, fl)
    }
    if cnt < 0 {
      "err"
    } else {
      let mut i = 0
      while i < cnt {
        his.push(fh[i])
        los.push(fl[i])
        i = i + 1
      }
      "ok " + pairs_hash_result(his, los)
    }
  }
}

///|
fn run(op : String, a : Array[String]) -> String {
  if op == "uparse" {
    let b = unhex(a[0])
    let s = b.to_string()
    let typed = match uuid::Uuid::parse(s) {
      Ok(u) => "ok " + u.to_hyphenated()
      Err(_) => "err"
    }
    let via_bytes = match uuid::Uuid::parse_bytes(b) {
      Ok(u) => "ok " + u.to_hyphenated()
      Err(_) => "err"
    }
    let pair : FixedArray[UInt64] = FixedArray::make(2, 0UL)
    let raw = if uuid::parse_uuid_slice_raw(s, 0, s.length(), pair) {
      "ok " + uuid::Uuid::from_u64_pair(pair[0], pair[1]).to_hyphenated()
    } else {
      "err"
    }
    if typed != via_bytes || typed != raw {
      "INTERNAL_MISMATCH typed=" + typed + " parse_bytes=" + via_bytes + " raw=" + raw
    } else {
      typed
    }
  } else if op == "v3" {
    uuid::Uuid::new_v3(ns_of(a[0]), unhex(a[1])).to_hyphenated()
  } else if op == "v5" || op == "v5len" {
    let ns = ns_of(a[0])
    let name = if op == "v5" { unhex(a[1]) } else { gen_name(parse_u64(a[1]).to_int(), parse_u64(a[2])) }
    let typed = uuid::Uuid::new_v5(ns, name).to_hyphenated()
    let pair : FixedArray[UInt64] = FixedArray::make(2, 0UL)
    let (nh, nl) = ns.as_u64_pair()
    uuid::uuid_v5_raw(nh, nl, name, pair)
    let raw = uuid::Uuid::from_u64_pair(pair[0], pair[1]).to_hyphenated()
    if typed != raw {
      "INTERNAL_MISMATCH typed=" + typed + " raw=" + raw
    } else {
      typed
    }
  } else if op == "v3len" {
    uuid::Uuid::new_v3(ns_of(a[0]), gen_name(parse_u64(a[1]).to_int(), parse_u64(a[2]))).to_hyphenated()
  } else if op == "v7" {
    let ts = parse_u64(a[0]).to_int64()
    let r = unhex(a[1])
    let typed = res_uuid(uuid::Uuid::new_v7(ts, r))
    let pair : FixedArray[UInt64] = FixedArray::make(2, 0UL)
    let raw = if uuid::uuid_v7_raw(ts, r, pair) {
      uuid::Uuid::from_u64_pair(pair[0], pair[1]).to_hyphenated()
    } else {
      "err"
    }
    if typed != raw {
      "INTERNAL_MISMATCH typed=" + typed + " raw=" + raw
    } else {
      typed
    }
  } else if op == "v1" {
    res_uuid(uuid::Uuid::new_v1(parse_u64(a[0]).to_int64(), parse_u64(a[1]).to_int(), unhex(a[2])))
  } else if op == "v6" {
    res_uuid(uuid::Uuid::new_v6(parse_u64(a[0]).to_int64(), parse_u64(a[1]).to_int(), unhex(a[2])))
  } else if op == "v4" {
    res_uuid(uuid::Uuid::from_random_bytes_v4(unhex(a[0])))
  } else if op == "v8" {
    res_uuid(uuid::Uuid::new_v8(unhex(a[0])))
  } else if op == "uinfo" {
    let u = uuid_of(a[0])
    let ts = match u.timestamp_ms() {
      Some(t) => t.to_string()
      None => "none"
    }
    "vnum=" + u.version_num().to_string() + " var=" + var_name(u.variant()) + " ver=" + ver_name(u.version()) + " ts=" + ts
  } else if op == "ulparse" {
    let s = unhex(a[0]).to_string()
    let typed = res_ulid_ok(uuid::Ulid::parse(s))
    let pair : FixedArray[UInt64] = FixedArray::make(2, 0UL)
    let raw = if uuid::parse_ulid_slice_raw(s, 0, s.length(), pair) {
      "ok " + uuid::Ulid::from_u64_pair(pair[0], pair[1]).to_string()
    } else {
      "err"
    }
    if typed != raw {
      "INTERNAL_MISMATCH typed=" + typed + " raw=" + raw
    } else {
      typed
    }
  } else if op == "ulfmt" {
    let b = unhex(a[0])
    let u = uuid::Ulid::from_u64_pair(u64_be(b, 0, 8), u64_be(b, 8, 8))
    let typed = u.to_string()
    let buf = Bytes::new(26)
    let _ = uuid::encode_ulid_bytes_raw(u64_be(b, 0, 8), u64_be(b, 8, 8), buf, 0)
    let raw = buf.to_string()
    if typed != raw {
      "INTERNAL_MISMATCH typed=" + typed + " raw=" + raw
    } else {
      typed
    }
  } else if op == "ulinc" {
    let b = unhex(a[0])
    res_ulid_ok(uuid::Ulid::from_u64_pair(u64_be(b, 0, 8), u64_be(b, 8, 8)).increment())
  } else if op == "ulparts" {
    let r = unhex(a[1])
    res_ulid_ok(uuid::Ulid::from_parts(parse_u64(a[0]).to_int64(), u64_be(r, 0, 2).to_int64(), u64_be(r, 2, 8).to_int64()))
  } else if op == "sort_uuid" || op == "sort_raw" || op == "sort_fixed" || op == "sort_ulid" {
    sort_case(op, a[0], parse_u64(a[1]).to_int(), parse_u64(a[2]))
  } else if op == "lines" || op == "lines_fixed" || op == "ullines" || op == "ullines_fixed" {
    lines_case(op, unhex(a[0]).to_string())
  } else {
    "unknown-op " + op
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: driver <corpus.tsv>")
    return 2
  }
  let content = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: cannot read corpus")
      return 1
    }
  }
  let clen = content.length()
  let mut pos = 0
  let mut line_no = 0
  while pos < clen {
    let mut end = pos
    while end < clen && content.code_unit_at(end) != 10 {
      end = end + 1
    }
    line_no = line_no + 1
    if end > pos && content.code_unit_at(pos) != 35 {
      // split on TAB
      let fields : Array[String] = []
      let mut fs = pos
      let mut k = pos
      while k <= end {
        if k == end || content.code_unit_at(k) == 9 {
          let fb = Bytes::new(k - fs)
          let mut j = 0
          while j < k - fs {
            fb[j] = content.code_unit_at(fs + j).to_byte()
            j = j + 1
          }
          fields.push(fb.to_string())
          fs = k + 1
        }
        k = k + 1
      }
      let op = fields[0]
      let rest : Array[String] = []
      let mut fi = 1
      while fi < fields.length() {
        rest.push(fields[fi])
        fi = fi + 1
      }
      io_println(world, line_no.to_string() + "\t" + op + "\t" + run(op, rest))
    }
    pos = end + 1
  }
  0
}
