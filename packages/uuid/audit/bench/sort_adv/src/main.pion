///| Red-team sort benchmark on adversarial distributions (random / dup33 / deep33 / lastbyte / equal / ...).
///| Usage: sort_adv <kind> <n> <api: sort_uuid|sort_raw|sort_fixed|sort_ulid>
///| stdout is byte-identical to `audit/oracle` bin `sort_adv` (Rust `sort_unstable`).

import "uuid"

///|
fn splitmix64(x_in : UInt64) -> UInt64 {
  let x = x_in + 0x9E3779B97F4A7C15UL
  let mut z = x
  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9UL
  z = (z ^ (z >> 27)) * 0x94D049BB133111EBUL
  z ^ (z >> 31)
}

///|
fn signed_edge(k : UInt64) -> UInt64 {
  let i = (k % 6UL).to_int()
  if i == 0 {
    0x7FFFFFFFFFFFFFFFUL
  } else if i == 1 {
    0x8000000000000000UL
  } else if i == 2 {
    0UL
  } else if i == 3 {
    0xFFFFFFFFFFFFFFFFUL
  } else if i == 4 {
    0x7FFFFFFFFFFFFFFEUL
  } else {
    0x8000000000000001UL
  }
}

///| Mirror of `gen_pair` in `audit/oracle/src/common.rs`; writes into out[0], out[1].
fn gen_pair(kind : String, i : UInt64, n : UInt64, seed : UInt64, out : FixedArray[UInt64]) -> Unit {
  let base = seed * 1000003UL
  let r1 = splitmix64(base + i * 2UL)
  let r2 = splitmix64(base + i * 2UL + 1UL)
  if kind == "random" {
    out[0] = r1
    out[1] = r2
  } else if kind == "equal" {
    out[0] = 0xDEADBEEF00000001UL
    out[1] = 0x8000000000000000UL
  } else if kind == "sorted" {
    out[0] = i
    out[1] = i
  } else if kind == "reverse" {
    out[0] = 0xFFFFFFFFFFFFFFFFUL - i
    out[1] = 0xFFFFFFFFFFFFFFFFUL - i
  } else if kind == "lo64" {
    out[0] = 0x0123456789ABCDEFUL
    out[1] = r2
  } else if kind == "lastbyte" {
    out[0] = 0x0123456789ABCDEFUL
    out[1] = 0xFEDCBA9876543200UL | (r2 & 0xFFUL)
  } else if kind == "signed" {
    out[0] = signed_edge(r1)
    out[1] = signed_edge(r2)
  } else if kind == "dup33" {
    let g = i / 33UL
    out[0] = splitmix64(seed ^ g)
    out[1] = splitmix64(g + 0x5555UL)
  } else if kind == "deep33" {
    let g = i / 33UL
    out[0] = splitmix64(seed ^ g)
    out[1] = (splitmix64(g) & 0xFFFFFFFFFFFFFF00UL) | (i % 33UL)
  } else {
    // sawtooth
    out[0] = (i % 257UL) << 56
    out[1] = n - i
  }
}

///|
fn fnv_word(h_in : UInt64, w : UInt64) -> UInt64 {
  let mut h = h_in
  let mut s = 56
  while s >= 0 {
    h = (h ^ ((w >> s) & 0xFFUL)) * 1099511628211UL
    s = s - 8
  }
  h
}

///|
fn hex_u64(x : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    let sh : Int = (15 - i) * 4
    let d = ((x >> sh) & 0xFUL).to_int()
    out[i] = (if d < 10 { d + 48 } else { d + 87 }).to_byte()
    i = i + 1
  }
  out.to_string()
}

///|
fn parse_u64(s : String) -> UInt64 {
  let mut acc = 0UL
  let mut i = 0
  while i < s.length() {
    acc = acc * 10UL + (s.code_unit_at(i) - 48).to_int64().to_uint64()
    i = i + 1
  }
  acc
}

///|
fn pairs_hash_result(his : Array[UInt64], los : Array[UInt64]) -> String {
  let mut h : UInt64 = 14695981039346656037UL
  let mut i = 0
  while i < his.length() {
    h = fnv_word(h, his[i])
    h = fnv_word(h, los[i])
    i = i + 1
  }
  "n=" + his.length().to_string() + " h=" + hex_u64(h)
}

///|
fn sort_case(op : String, kind : String, n : Int, seed : UInt64) -> String {
  let nn = n.to_int64().to_uint64()
  let p : FixedArray[UInt64] = FixedArray::make(2, 0UL)
  let his : Array[UInt64] = []
  let los : Array[UInt64] = []
  if op == "sort_uuid" {
    let arr : Array[uuid::Uuid] = []
    let mut i = 0
    while i < n {
      gen_pair(kind, i.to_int64().to_uint64(), nn, seed, p)
      arr.push(uuid::Uuid::from_u64_pair(p[0], p[1]))
      i = i + 1
    }
    uuid::Uuid::sort(arr)
    i = 0
    while i < n {
      let (h, l) = arr[i].as_u64_pair()
      his.push(h)
      los.push(l)
      i = i + 1
    }
  } else if op == "sort_ulid" {
    let arr : Array[uuid::Ulid] = []
    let mut i = 0
    while i < n {
      gen_pair(kind, i.to_int64().to_uint64(), nn, seed, p)
      arr.push(uuid::Ulid::from_u64_pair(p[0], p[1]))
      i = i + 1
    }
    uuid::Ulid::sort(arr)
    i = 0
    while i < n {
      let (h, l) = arr[i].as_u64_pair()
      his.push(h)
      los.push(l)
      i = i + 1
    }
  } else if op == "sort_raw" {
    let mut i = 0
    while i < n {
      gen_pair(kind, i.to_int64().to_uint64(), nn, seed, p)
      his.push(p[0])
      los.push(p[1])
      i = i + 1
    }
    uuid::sort_u128_pairs_raw(his, los)
  } else {
    let fh : FixedArray[UInt64] = FixedArray::make(n + 1, 0UL)
    let fl : FixedArray[UInt64] = FixedArray::make(n + 1, 0UL)
    let mut i = 0
    while i < n {
      gen_pair(kind, i.to_int64().to_uint64(), nn, seed, p)
      fh[i] = p[0]
      fl[i] = p[1]
      i = i + 1
    }
    uuid::sort_u128_pairs_fixed(fh, fl, n)
    i = 0
    while i < n {
      his.push(fh[i])
      los.push(fl[i])
      i = i + 1
    }
  }
  pairs_hash_result(his, los)
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: sort_adv <kind> <n> <api>")
    return 2
  }
  io_println(world, sort_case(args[3], args[1], parse_u64(args[2]).to_int(), 7UL))
  0
}
