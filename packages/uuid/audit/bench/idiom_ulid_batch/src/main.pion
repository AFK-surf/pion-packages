///| Red-team Bench 3 (idiomatic typed API): `Ulid::parse_slice` per line, `Array[Ulid]`, `Ulid::sort`,
///| then `encode_bytes` (mode `buf`) or `to_string()` (mode `str`).
///| stdout is byte-identical to `packages/uuid/bench/rust/src/bin/bench_ulid_batch.rs`.

import "uuid"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 { args[1] } else { "/tmp/pion-uuid-bench/ulids_500000.txt" }
  let mode = if args.length() > 2 { args[2] } else { "buf" }
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }
  let ulids : Array[uuid::Ulid] = []
  let clen = content.length()
  let mut pos = 0
  while pos < clen {
    let mut end = pos
    while end < clen && content.code_unit_at(end) != 10 {
      end = end + 1
    }
    let mut line_end = end
    if line_end > pos && content.code_unit_at(line_end - 1) == 13 {
      line_end = line_end - 1
    }
    if line_end > pos {
      match uuid::Ulid::parse_slice(content, pos, line_end) {
        Ok(u) => ulids.push(u)
        Err(_) => {
          io_println(world, "parse error")
          return 1
        }
      }
    }
    pos = end + 1
  }
  uuid::Ulid::sort(ulids)

  let n = ulids.length()
  let mut hash : UInt64 = 14695981039346656037UL
  let mut total_bytes : Int64 = 0L
  let buf = Bytes::new(26)
  let mut i = 0
  while i < n {
    if mode == "str" {
      let s = ulids[i].to_string()
      let olen = s.length()
      total_bytes = total_bytes + olen.to_int64()
      let mut j = 0
      while j < olen {
        hash = (hash ^ s.code_unit_at(j).to_int64().to_uint64()) * 1099511628211UL
        j = j + 1
      }
    } else {
      let olen = ulids[i].encode_bytes(buf, 0)
      total_bytes = total_bytes + olen.to_int64()
      let mut j = 0
      while j < olen {
        hash = (hash ^ buf[j].to_int().to_int64().to_uint64()) * 1099511628211UL
        j = j + 1
      }
    }
    i = i + 1
  }
  let first = if n > 0 { ulids[0].to_string() } else { "" }
  let mid = if n > 0 { ulids[n / 2].to_string() } else { "" }
  let last = if n > 0 { ulids[n - 1].to_string() } else { "" }
  io_println(world, "count=" + n.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  io_println(world, "first=" + first)
  io_println(world, "mid=" + mid)
  io_println(world, "last=" + last)
  0
}
