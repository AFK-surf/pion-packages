///| Red-team tests for `packages/uuid` (audit of ffba5a1 against Rust uuid 1.29.3 / ulid 1.2.1).
///|
///| Naming:
///| - `p1_*` / `p2_*`: assert the EXPECTED correct behaviour; they FAIL while the defect exists and PASS once fixed.
///| - `div_*`: assert the upstream (Rust) behaviour where Pion intentionally or unintentionally diverges; FAIL = divergence present.
///| - `ctl_*`: control tests that probe suspected weak spots and are expected to PASS (Pion is correct there).

import "uuid"

///|
let u36 : String = "67e55044-10b1-426f-9247-bb680e5fe0c8"

///|
let s32 : String = "67e5504410b1426f9247bb680e5fe0c8"

///|
let ulid0 : String = "01AN4Z07BY79KA1307SR9X4MV3"

///|
fn rep(c : Int, n : Int) -> String {
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = c.to_byte()
    i = i + 1
  }
  b.to_string()
}

///|
fn bytes_of(s : String) -> Bytes {
  let b = Bytes::new(s.length())
  let mut i = 0
  while i < s.length() {
    b[i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  b
}

///|
fn with_byte(s : String, i : Int, v : Int) -> String {
  let b = bytes_of(s)
  b[i] = v.to_byte()
  b.to_string()
}

///|
fn is_ok_uuid(r : Result[uuid::Uuid, uuid::UuidError]) -> Bool {
  match r {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn is_ok_ulid(r : Result[uuid::Ulid, uuid::UlidError]) -> Bool {
  match r {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn ulid_of(r : Result[uuid::Ulid, uuid::UlidError]) -> uuid::Ulid {
  match r {
    Ok(u) => u
    Err(_) => uuid::Ulid::nil()
  }
}

///|
fn ts_or(u : uuid::Uuid) -> Int64 {
  match u.timestamp_ms() {
    Some(t) => t
    None => -1L
  }
}

///|
fn uuid_of(r : Result[uuid::Uuid, uuid::UuidError]) -> uuid::Uuid {
  match r {
    Ok(u) => u
    Err(_) => uuid::Uuid::nil()
  }
}

// ---------------------------------------------------------------------------
// P1: batch line parsers reject valid input (36/26-byte look-ahead fast path)
// ---------------------------------------------------------------------------

///| `parse_uuid_lines_raw` peeks at `pos + 36`; when that byte is `\n` it treats the whole
///| 36-byte window as ONE line even if it already contains earlier `\n` (blank lines).
///| "\n\n\n\n" + simple32 + "\n" is 4 blank lines + one valid simple UUID (Rust: Ok, 1 UUID).
test "p1_parse_uuid_lines_raw_blank_lines_before_simple" {
  let his : Array[UInt64] = []
  let los : Array[UInt64] = []
  let ok = uuid::parse_uuid_lines_raw("\n\n\n\n" + s32 + "\n", his, los)
  debug_assert(ok, "4 blank lines + simple UUID must parse (Rust uuid: Ok)")
  debug_assert(his.length() == 1, "exactly one UUID expected")
}

///| CRLF blank-line run whose 37th byte is the LF of a CRLF pair: window ends with '\r' -> len 35 -> rejected.
test "p1_parse_uuid_lines_raw_crlf_blank_run" {
  let mut content = "\n"
  let mut i = 0
  while i < 18 {
    content = content + "\r\n"
    i = i + 1
  }
  let his : Array[UInt64] = []
  let los : Array[UInt64] = []
  let ok = uuid::parse_uuid_lines_raw(content + s32 + "\r\n", his, los)
  debug_assert(ok, "LF + 18 CRLF blank lines + simple UUID must parse (Rust uuid: Ok)")
}

///| 37 blank lines: Rust `content.lines()` yields only empty lines -> Ok(0).
test "p1_parse_uuid_lines_raw_only_blank_lines" {
  let his : Array[UInt64] = []
  let los : Array[UInt64] = []
  debug_assert(uuid::parse_uuid_lines_raw(rep(10, 37), his, los), "37 blank lines must be accepted as 0 UUIDs")
}

///| The `_fixed` variant has no fast path and is correct: control.
test "ctl_parse_uuid_lines_fixed_blank_lines_ok" {
  let fh : FixedArray[UInt64] = FixedArray::make(4, 0UL)
  let fl : FixedArray[UInt64] = FixedArray::make(4, 0UL)
  debug_assert(uuid::parse_uuid_lines_fixed("\n\n\n\n" + s32 + "\n", fh, fl) == 1, "fixed variant parses")
  debug_assert(uuid::parse_uuid_lines_fixed(rep(10, 37), fh, fl) == 0, "fixed variant: blank only")
}

///| Same defect in `parse_ulid_lines_raw` (look-ahead at `pos + 26`).
test "p1_parse_ulid_lines_raw_blank_lines" {
  let his : Array[UInt64] = []
  let los : Array[UInt64] = []
  debug_assert(uuid::parse_ulid_lines_raw(rep(10, 27), his, los), "27 blank lines must be accepted (Rust ulid: Ok)")
  let his2 : Array[UInt64] = []
  let los2 : Array[UInt64] = []
  let ok2 = uuid::parse_ulid_lines_raw(rep(10, 26) + ulid0 + "\n", his2, los2)
  debug_assert(ok2, "26 blank lines + ULID must parse")
  debug_assert(his2.length() == 1, "one ULID expected")
}

///|
test "ctl_parse_ulid_lines_fixed_blank_lines_ok" {
  let fh : FixedArray[UInt64] = FixedArray::make(4, 0UL)
  let fl : FixedArray[UInt64] = FixedArray::make(4, 0UL)
  debug_assert(uuid::parse_ulid_lines_fixed(rep(10, 26) + ulid0 + "\n", fh, fl) == 1, "fixed variant parses")
}

// ---------------------------------------------------------------------------
// P2: API hazards of the raw batch / out-parameter APIs
// ---------------------------------------------------------------------------

///| On failure the raw batch parser leaves the already-parsed prefix pushed into the caller's arrays.
test "p2_parse_uuid_lines_raw_no_partial_output_on_error" {
  let his : Array[UInt64] = []
  let los : Array[UInt64] = []
  let ok = uuid::parse_uuid_lines_raw(u36 + "\n" + u36 + "\nnot-a-uuid\n", his, los)
  debug_assert(!ok, "must report failure")
  debug_assert(his.length() == 0 && los.length() == 0, "outputs must not contain a partial batch on error")
}

///| Length-mismatched inputs are silently NOT sorted (no error channel).
test "p2_sort_u128_pairs_raw_len_mismatch_is_silent_noop" {
  let his : Array[UInt64] = [3UL, 2UL, 1UL]
  let los : Array[UInt64] = [0UL, 0UL]
  uuid::sort_u128_pairs_raw(his, los)
  // Expected: either sort the common prefix or report the misuse. Today it does neither.
  debug_assert(his[0] == 2UL || his[0] == 1UL, "length mismatch silently ignored: nothing sorted, no error")
}

///|
test "p2_sort_u128_pairs_fixed_n_too_large_is_silent_noop" {
  let fh : FixedArray[UInt64] = [3UL, 2UL, 1UL]
  let fl : FixedArray[UInt64] = [0UL, 0UL, 0UL]
  uuid::sort_u128_pairs_fixed(fh, fl, 4)
  debug_assert(fh[0] == 1UL, "n > capacity silently ignored: nothing sorted, no error")
}

// ---------------------------------------------------------------------------
// Divergences from Rust uuid 1.29.3 / ulid 1.2.1 (differential-confirmed)
// ---------------------------------------------------------------------------

///| ulid 1.2.1 rejects I/L/O (LOOKUP = NO_VALUE); Pion maps them to 1/1/0, so distinct strings alias one ULID.
test "div_ulid_parse_rejects_ilo_like_rust" {
  debug_assert(!is_ok_ulid(uuid::Ulid::parse("0IAN4Z07BY79KA1307SR9X4MV3")), "'I' rejected by Rust ulid")
  debug_assert(!is_ok_ulid(uuid::Ulid::parse("01AN4Z07BY79KA13O7SR9X4MV3")), "'O' rejected by Rust ulid")
  debug_assert(!is_ok_ulid(uuid::Ulid::parse("01AN4Z07BY79KA1307SR9X4MVL")), "'L' rejected by Rust ulid")
}

///| Rust `Uuid::get_version()` only looks at the version nibble (variant-agnostic); Pion requires the RFC variant.
test "div_uuid_version_ignores_variant_like_rust" {
  // version nibble 4, variant byte 0x00 (NCS) / 0xC0 (Microsoft)
  let ncs = uuid::Uuid::from_u64_pair(0x123456789ABC4DEFUL, 0x0012345678ABCDEFUL)
  let ms = uuid::Uuid::from_u64_pair(0x123456789ABC4DEFUL, 0xC012345678ABCDEFUL)
  let ok_ncs = match ncs.version() {
    uuid::UuidVersion::Random => true
    _ => false
  }
  let ok_ms = match ms.version() {
    uuid::UuidVersion::Random => true
    _ => false
  }
  debug_assert(ok_ncs && ok_ms, "Rust get_version() == Some(Random) for any variant")
}

///| Rust `get_timestamp()` decodes v1/v6 (gregorian) timestamps; Pion `timestamp_ms()` only handles v7.
test "div_uuid_timestamp_v1_v6" {
  let node = Bytes::new(6)
  // 2023-11-14T22:13:20Z = 1700000000000 ms -> gregorian ticks
  let ticks = 1700000000000L * 10000L + 0x01B21DD213814000L
  let v1 = uuid_of(uuid::Uuid::new_v1(ticks, 0, node))
  let v6 = uuid_of(uuid::Uuid::new_v6(ticks, 0, node))
  debug_assert(ts_or(v1) == 1700000000000L, "v1 timestamp (Rust: Some)")
  debug_assert(ts_or(v6) == 1700000000000L, "v6 timestamp (Rust: Some)")
}

// ---------------------------------------------------------------------------
// Controls (expected PASS): suspected weak spots that turned out correct
// ---------------------------------------------------------------------------

///| High bytes whose low 7 bits are a hex digit / '-' must be rejected at every position (no `& 0x7F` aliasing).
test "ctl_uuid_parse_high_byte_aliases_rejected_everywhere" {
  let aliases : Array[Int] = [0x80, 0xB0, 0xB9, 0xC1, 0xE1, 0xE6, 0xAD, 0xFF]
  let mut a = 0
  while a < aliases.length() {
    let mut i = 0
    while i < 36 {
      let s = with_byte(u36, i, aliases[a])
      debug_assert(!is_ok_uuid(uuid::Uuid::parse(s)), "high byte accepted in hyphenated")
      let his : Array[UInt64] = []
      let los : Array[UInt64] = []
      debug_assert(!uuid::parse_uuid_lines_raw(s + "\n", his, los), "high byte accepted by raw lines")
      i = i + 1
    }
    i = 0
    while i < 32 {
      debug_assert(!is_ok_uuid(uuid::Uuid::parse(with_byte(s32, i, aliases[a]))), "high byte accepted in simple")
      i = i + 1
    }
    a = a + 1
  }
}

///|
test "ctl_uuid_parse_shapes" {
  debug_assert(is_ok_uuid(uuid::Uuid::parse("URN:UUID:" + u36)), "uppercase URN accepted (Rust 1.29.3 too)")
  debug_assert(!is_ok_uuid(uuid::Uuid::parse("urn:uuid:" + s32)), "urn + simple rejected")
  debug_assert(!is_ok_uuid(uuid::Uuid::parse("{" + s32 + "}")), "braced simple rejected")
  debug_assert(!is_ok_uuid(uuid::Uuid::parse("{" + u36)), "half brace rejected")
  debug_assert(!is_ok_uuid(uuid::Uuid::parse(" " + u36)), "leading space rejected")
  debug_assert(!is_ok_uuid(uuid::Uuid::parse(u36 + "\n")), "trailing LF rejected")
  debug_assert(!is_ok_uuid(uuid::Uuid::parse("67e5504-410b1-426f-9247-bb680e5fe0c8")), "shifted hyphen")
  debug_assert(!is_ok_uuid(uuid::Uuid::parse_slice(u36, 5, 2)), "end < start")
  debug_assert(!is_ok_uuid(uuid::Uuid::parse_slice(u36, -1, 35)), "negative start")
  debug_assert(!is_ok_uuid(uuid::Uuid::parse_slice(u36, 0, 37)), "end > len")
  let invalid_utf8 = Bytes::new(36)
  let mut i = 0
  while i < 36 {
    invalid_utf8[i] = (0xC0).to_byte()
    i = i + 1
  }
  debug_assert(!is_ok_uuid(uuid::Uuid::parse_bytes(invalid_utf8)), "invalid UTF-8 rejected without panic")
}

///| Generators must reject bad inputs with `Err` (never panic / never truncate silently).
test "ctl_generators_reject_bad_inputs" {
  debug_assert(!is_ok_uuid(uuid::Uuid::new_v7(-1L, Bytes::new(10))), "negative ts")
  debug_assert(!is_ok_uuid(uuid::Uuid::new_v7(0x1000000000000L, Bytes::new(10))), ">48-bit ts")
  debug_assert(is_ok_uuid(uuid::Uuid::new_v7(0xFFFFFFFFFFFFL, Bytes::new(10))), "max 48-bit ts ok")
  debug_assert(!is_ok_uuid(uuid::Uuid::new_v7(1L, Bytes::new(9))), "rand10 short")
  debug_assert(!is_ok_uuid(uuid::Uuid::new_v7(1L, Bytes::new(0))), "rand10 empty")
  debug_assert(!is_ok_uuid(uuid::Uuid::new_v7(1L, Bytes::new(11))), "rand10 long")
  let ctx = uuid::V7Context::new()
  debug_assert(!is_ok_uuid(ctx.generate(1L, Bytes::new(9))), "ctx rand10 short")
  debug_assert(!is_ok_uuid(ctx.generate(-5L, Bytes::new(10))), "ctx negative ts")
  debug_assert(!is_ok_uuid(uuid::Uuid::from_bytes(Bytes::new(15))), "from_bytes 15")
  debug_assert(!is_ok_uuid(uuid::Uuid::from_bytes(Bytes::new(17))), "from_bytes 17")
  debug_assert(!is_ok_uuid(uuid::Uuid::new_v8(Bytes::new(0))), "v8 empty")
  debug_assert(!is_ok_uuid(uuid::Uuid::from_random_bytes_v4(Bytes::new(3))), "v4 short")
  debug_assert(!is_ok_uuid(uuid::Uuid::new_v1(-1L, 0, Bytes::new(6))), "v1 negative ticks")
  debug_assert(!is_ok_uuid(uuid::Uuid::new_v1(0L, 0, Bytes::new(5))), "v1 short node")
  debug_assert(!is_ok_uuid(uuid::Uuid::new_v6(0L, 0x4000, Bytes::new(6))), "v6 clock_seq > 14 bits")
  debug_assert(!is_ok_ulid(uuid::Ulid::from_parts(-1L, 0L, 0L)), "ulid negative ts")
  debug_assert(!is_ok_ulid(uuid::Ulid::from_parts(0x1000000000000L, 0L, 0L)), "ulid >48-bit ts")
  debug_assert(!is_ok_ulid(uuid::Ulid::from_bytes(Bytes::new(15))), "ulid from_bytes 15")
  let out = Bytes::new(35)
  debug_assert(uuid::Uuid::nil().encode_hyphenated(out, 0) == 0, "short buffer -> 0")
  debug_assert(uuid::Uuid::nil().encode_hyphenated(Bytes::new(40), -1) == 0, "negative offset -> 0")
  debug_assert(!uuid::Uuid::nil().write_bytes(Bytes::new(16), 1), "write_bytes overflow -> false")
}

///| V7Context: clock rollback, 12-bit counter exhaustion, and end-of-time must stay strictly monotonic.
test "ctl_v7context_monotonic_under_rollback_and_exhaustion" {
  let ctx = uuid::V7Context::new()
  let mut prev = uuid_of(ctx.generate_parts(1000L, 0xFFF, 0L))
  let mut k = 0
  let mut x = 12345UL
  while k < 20000 {
    x = x * 6364136223846793005UL + 1442695040888963407UL
    // mostly the same ms, sometimes rollback by up to 3 ms, sometimes forward
    let jitter = ((x >> 33) % 7UL).to_int64() - 3L
    let ts = 1000L + jitter
    let cur = match ctx.generate_parts(ts, ((x >> 20) & 0xFFFUL).to_int(), (x >> 1).to_int64()) {
      Ok(u) => u
      Err(_) => {
        debug_assert(false, "unexpected error")
        prev
      }
    }
    debug_assert(cur.compare(prev) > 0, "V7Context not strictly monotonic")
    prev = cur
    k = k + 1
  }
  let end = uuid::V7Context::new()
  let _ = end.generate_parts(0xFFFFFFFFFFFFL, 0x7FF, 0L)
  let mut c = 0
  let mut overflow = false
  while c < 5000 {
    match end.generate_parts(0xFFFFFFFFFFFFL, 0, 0L) {
      Ok(_) => ()
      Err(_) => overflow = true
    }
    c = c + 1
  }
  debug_assert(overflow, "end-of-time counter exhaustion must surface SequenceOverflow")
}

///| MonotonicUlid: rollback, 64-bit carry into rand_hi, 80-bit saturation.
test "ctl_monotonic_ulid_carry_and_saturation" {
  let g = uuid::MonotonicUlid::new()
  let a = ulid_of(g.generate(100L, 0x0000L, -1L))
  let b = ulid_of(g.generate(99L, 0L, 0L))
  // rollback -> increment: lo wraps to 0 and carries into rand_hi
  debug_assert(b.timestamp_ms() == 100L, "rollback keeps last ts")
  let (rh, rl) = b.random_parts()
  debug_assert(rh == 1L && rl == 0L, "carry from rand_lo into rand_hi")
  debug_assert(b.compare(a) > 0, "monotonic")
  let s = uuid::MonotonicUlid::new()
  let _ = s.generate(5L, 0xFFFFL, -1L)
  let ovf = match s.generate(5L, 0L, 0L) {
    Ok(_) => false
    Err(uuid::UlidError::Overflow) => true
    Err(_) => false
  }
  debug_assert(ovf, "80-bit saturation -> Overflow, no wrap into timestamp")
  // state is not corrupted after overflow: a later ms recovers
  let rec = ulid_of(s.generate(6L, 1L, 2L))
  debug_assert(rec.timestamp_ms() == 6L, "recovers on later ms")
}

///| ULID 128-bit overflow ('8'..'Z' first char) is rejected; Rust ulid 1.2.1 silently truncates (Pion is stricter).
test "ctl_ulid_overflow_rejected" {
  debug_assert(!is_ok_ulid(uuid::Ulid::parse("8ZZZZZZZZZZZZZZZZZZZZZZZZZ")), "8.. rejected")
  debug_assert(!is_ok_ulid(uuid::Ulid::parse("ZZZZZZZZZZZZZZZZZZZZZZZZZZ")), "Z.. rejected")
  debug_assert(is_ok_ulid(uuid::Ulid::parse("7ZZZZZZZZZZZZZZZZZZZZZZZZZ")), "7Z.. max accepted")
  debug_assert(!is_ok_ulid(uuid::Ulid::parse("01AN4Z07BY79KA1307SR9X4MVU")), "U rejected")
  debug_assert(!is_ok_ulid(uuid::Ulid::parse(with_byte(ulid0, 3, 0xB0))), "high byte rejected")
}

///| Sorting: all four APIs on the adversarial shapes agree with a reference compare-based sort.
test "ctl_sort_adversarial_shapes_match_reference" {
  let n = 2000
  let shapes = 6
  let mut sh = 0
  while sh < shapes {
    let arr : Array[uuid::Uuid] = []
    let his : Array[UInt64] = []
    let los : Array[UInt64] = []
    let mut i = 0
    let mut x = 99UL + sh.to_int64().to_uint64()
    while i < n {
      x = x * 6364136223846793005UL + 1442695040888963407UL
      let iu = i.to_int64().to_uint64()
      let (h, l) = if sh == 0 {
        (x, x * 31UL)
      } else if sh == 1 {
        (5UL, 5UL)
      } else if sh == 2 {
        (0x7FFFFFFFFFFFFFFFUL + (x >> 63), 0x7FFFFFFFFFFFFFFFUL + ((x >> 62) & 1UL))
      } else if sh == 3 {
        (1UL, 0xFFUL & x)
      } else if sh == 4 {
        (iu / 33UL * 0x0101010101010101UL, 0UL)
      } else {
        (0xFFFFFFFFFFFFFFFFUL - iu, 0UL)
      }
      arr.push(uuid::Uuid::from_u64_pair(h, l))
      his.push(h)
      los.push(l)
      i = i + 1
    }
    uuid::Uuid::sort(arr)
    uuid::sort_u128_pairs_raw(his, los)
    i = 1
    while i < n {
      debug_assert(arr[i - 1].compare(arr[i]) <= 0, "Uuid::sort order")
      let (h, l) = arr[i].as_u64_pair()
      debug_assert(h == his[i] && l == los[i], "raw sort disagrees with typed sort")
      i = i + 1
    }
    sh = sh + 1
  }
  let empty : Array[uuid::Uuid] = []
  uuid::Uuid::sort(empty)
  debug_assert(empty.length() == 0, "empty")
}

///| Rust `ContextV7` packs a 42-bit counter (rand_a + 30 bits of rand_b): 100k / 1M UUIDs in one millisecond keep
///| drift_ms = 0 (see `audit/oracle` bin `v7ctx`). Pion `V7Context` only has the 12-bit rand_a counter, so the
///| embedded timestamp runs ahead of the real clock by ~n/4096 ms under bursts.
test "div_v7context_counter_capacity_no_drift" {
  let ctx = uuid::V7Context::new()
  let mut last = uuid::Uuid::nil()
  let mut k = 0
  while k < 100000 {
    last = uuid_of(ctx.generate_parts(1700000000000L, 0x123, 0L))
    k = k + 1
  }
  let drift = ts_or(last) - 1700000000000L
  debug_assert(drift == 0L, "V7Context timestamp drifted forward under a same-ms burst (Rust ContextV7: 0 ms)")
}

///| Out-parameter APIs index `out_pair[1]` without checking its length: a 1-element buffer aborts the
///| process with an OOB panic instead of returning `false`.
test "p2_parse_uuid_slice_raw_short_out_pair_returns_false" {
  let short : FixedArray[UInt64] = FixedArray::make(1, 0UL)
  debug_assert(!uuid::parse_uuid_slice_raw(u36, 0, 36, short), "short out_pair must be rejected, not panic")
}
