///| Tests for OpenAPI 3.0.x & 3.1.0 JSON/YAML parsing, `$ref` resolution,
///| OpenAPI 3.1 sibling preservation, RFC 6901 escapes, cycle detection, and DoS limits.

import "json5"

let petstore_30_json : String =
"{\n" +
"  \"openapi\": \"3.0.3\",\n" +
"  \"info\": {\n" +
"    \"title\": \"Swagger Petstore\",\n" +
"    \"version\": \"1.0.0\",\n" +
"    \"description\": \"A sample Petstore API\",\n" +
"    \"contact\": { \"name\": \"API Team\", \"email\": \"api@petstore.example\" },\n" +
"    \"license\": { \"name\": \"MIT\", \"url\": \"https://opensource.org/licenses/MIT\" }\n" +
"  },\n" +
"  \"servers\": [\n" +
"    {\n" +
"      \"url\": \"https://{env}.petstore.example/v1\",\n" +
"      \"description\": \"Main server\",\n" +
"      \"variables\": {\n" +
"        \"env\": { \"default\": \"api\", \"enum\": [\"api\", \"staging\"] }\n" +
"      }\n" +
"    }\n" +
"  ],\n" +
"  \"tags\": [{ \"name\": \"pets\", \"description\": \"Pet operations\" }],\n" +
"  \"paths\": {\n" +
"    \"/pets\": {\n" +
"      \"get\": {\n" +
"        \"operationId\": \"listPets\",\n" +
"        \"summary\": \"List all pets\",\n" +
"        \"tags\": [\"pets\"],\n" +
"        \"parameters\": [\n" +
"          {\n" +
"            \"name\": \"limit\",\n" +
"            \"in\": \"query\",\n" +
"            \"required\": false,\n" +
"            \"schema\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 100 }\n" +
"          }\n" +
"        ],\n" +
"        \"responses\": {\n" +
"          \"200\": {\n" +
"            \"description\": \"A paged array of pets\",\n" +
"            \"content\": {\n" +
"              \"application/json\": {\n" +
"                \"schema\": { \"$ref\": \"#/components/schemas/Pets\" }\n" +
"              }\n" +
"            }\n" +
"          },\n" +
"          \"default\": { \"$ref\": \"#/components/responses/ErrorResp\" }\n" +
"        }\n" +
"      },\n" +
"      \"post\": {\n" +
"        \"operationId\": \"createPet\",\n" +
"        \"summary\": \"Create a pet\",\n" +
"        \"requestBody\": { \"$ref\": \"#/components/requestBodies/NewPetBody\" },\n" +
"        \"responses\": {\n" +
"          \"201\": { \"description\": \"Created\" }\n" +
"        }\n" +
"      }\n" +
"    },\n" +
"    \"/pets/{petId}\": {\n" +
"      \"parameters\": [\n" +
"        { \"$ref\": \"#/components/parameters/PetIdParam\" }\n" +
"      ],\n" +
"      \"get\": {\n" +
"        \"operationId\": \"showPetById\",\n" +
"        \"summary\": \"Info for a specific pet\",\n" +
"        \"responses\": {\n" +
"          \"200\": {\n" +
"            \"description\": \"Expected response\",\n" +
"            \"content\": {\n" +
"              \"application/json\": {\n" +
"                \"schema\": { \"$ref\": \"#/components/schemas/Pet\" }\n" +
"              }\n" +
"            }\n" +
"          }\n" +
"        }\n" +
"      }\n" +
"    }\n" +
"  },\n" +
"  \"components\": {\n" +
"    \"parameters\": {\n" +
"      \"PetIdParam\": {\n" +
"        \"name\": \"petId\",\n" +
"        \"in\": \"path\",\n" +
"        \"required\": true,\n" +
"        \"schema\": { \"type\": \"integer\", \"minimum\": 1 }\n" +
"      }\n" +
"    },\n" +
"    \"requestBodies\": {\n" +
"      \"NewPetBody\": {\n" +
"        \"required\": true,\n" +
"        \"content\": {\n" +
"          \"application/json\": {\n" +
"            \"schema\": { \"$ref\": \"#/components/schemas/Pet\" }\n" +
"          }\n" +
"        }\n" +
"      }\n" +
"    },\n" +
"    \"responses\": {\n" +
"      \"ErrorResp\": {\n" +
"        \"description\": \"unexpected error\",\n" +
"        \"content\": {\n" +
"          \"application/json\": {\n" +
"            \"schema\": { \"$ref\": \"#/components/schemas/Error\" }\n" +
"          }\n" +
"        }\n" +
"      }\n" +
"    },\n" +
"    \"schemas\": {\n" +
"      \"Pet\": {\n" +
"        \"type\": \"object\",\n" +
"        \"required\": [\"id\", \"name\"],\n" +
"        \"properties\": {\n" +
"          \"id\": { \"type\": \"integer\" },\n" +
"          \"name\": { \"type\": \"string\", \"minLength\": 1 },\n" +
"          \"tag\": { \"type\": \"string\", \"nullable\": true }\n" +
"        }\n" +
"      },\n" +
"      \"Pets\": {\n" +
"        \"type\": \"array\",\n" +
"        \"items\": { \"$ref\": \"#/components/schemas/Pet\" }\n" +
"      },\n" +
"      \"Error\": {\n" +
"        \"type\": \"object\",\n" +
"        \"required\": [\"code\", \"message\"],\n" +
"        \"properties\": {\n" +
"          \"code\": { \"type\": \"integer\" },\n" +
"          \"message\": { \"type\": \"string\" }\n" +
"        }\n" +
"      }\n" +
"    }\n" +
"  }\n" +
"}"

let github_31_yaml : String =
"openapi: 3.1.0\n" +
"jsonSchemaDialect: https://json-schema.org/draft/2020-12/schema\n" +
"info:\n" +
"  title: GitHub Mini API\n" +
"  summary: Subset of GitHub REST API\n" +
"  version: 2022-11-28\n" +
"  license:\n" +
"    name: MIT\n" +
"    identifier: MIT\n" +
"servers:\n" +
"  - url: https://api.github.com\n" +
"    description: Production\n" +
"paths:\n" +
"  /repos/{owner}/{repo}:\n" +
"    get:\n" +
"      operationId: repos/get\n" +
"      summary: Get a repository\n" +
"      parameters:\n" +
"        - name: owner\n" +
"          in: path\n" +
"          required: true\n" +
"          schema:\n" +
"            type: string\n" +
"        - name: repo\n" +
"          in: path\n" +
"          required: true\n" +
"          schema:\n" +
"            type: string\n" +
"      responses:\n" +
"        '200':\n" +
"          description: Repository details\n" +
"          content:\n" +
"            application/json:\n" +
"              schema:\n" +
"                $ref: '#/components/schemas/Repository'\n" +
"webhooks:\n" +
"  pushEvent:\n" +
"    post:\n" +
"      operationId: webhookPush\n" +
"      summary: Git push webhook\n" +
"      requestBody:\n" +
"        required: true\n" +
"        content:\n" +
"          application/json:\n" +
"            schema:\n" +
"              $ref: '#/components/schemas/Repository'\n" +
"              summary: Overridden webhook repo summary\n" +
"              description: Overridden webhook repo description\n" +
"      responses:\n" +
"        '200':\n" +
"          description: Accepted\n" +
"components:\n" +
"  schemas:\n" +
"    Repository:\n" +
"      type: object\n" +
"      summary: Base repo summary\n" +
"      description: Base repo description\n" +
"      required:\n" +
"        - id\n" +
"        - full_name\n" +
"      properties:\n" +
"        id:\n" +
"          type: integer\n" +
"        full_name:\n" +
"          type: string\n" +
"        homepage:\n" +
"          type:\n" +
"            - string\n" +
"            - 'null'\n"

test "parse_petstore_30_json" {
  let doc = match parse_json(petstore_30_json) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "expected Ok, got: " + e.message)
      return
    }
  }
  debug_assert(doc.openapi.is_30(), "expected 3.0.x")
  debug_assert(!doc.openapi.is_31(), "not 3.1")
  debug_assert(doc.openapi.patch == 3, "patch == 3")
  debug_assert(doc.info.title == "Swagger Petstore", "title mismatch")
  debug_assert(doc.info.version == "1.0.0", "version mismatch")
  debug_assert(doc.servers.length() == 1, "1 server")
  debug_assert(doc.servers[0].variables.length() == 1, "1 server var")
  debug_assert(doc.paths.length() == 2, "2 paths")
  debug_assert(doc.components.schemas.length() == 3, "3 schemas")
  debug_assert(doc.tags.length() == 1, "1 tag")
  match doc.find_operation_by_id("showPetById") {
    Some(op) => {
      debug_assert(op.path == "/pets/{petId}", "path mismatch")
      debug_assert(http_method_eq(op.method, HttpMethod::Get), "method GET")
      debug_assert(op.parameters.length() == 1, "inherited path-level parameter")
      debug_assert(op.parameters[0].name == "petId", "petId param")
      debug_assert(op.parameters[0].required, "petId required")
    }
    None => debug_assert(false, "showPetById not found")
  }
}

test "parse_github_31_yaml_and_webhooks" {
  let doc = match parse_yaml(github_31_yaml) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "expected Ok YAML, got: " + e.message)
      return
    }
  }
  debug_assert(doc.openapi.is_31(), "expected 3.1.0")
  debug_assert(doc.info.title == "GitHub Mini API", "title")
  match doc.json_schema_dialect {
    Some(d) => debug_assert(d == "https://json-schema.org/draft/2020-12/schema", "dialect")
    None => debug_assert(false, "expected jsonSchemaDialect")
  }
  debug_assert(doc.paths.length() == 1, "1 path")
  debug_assert(doc.webhooks.length() == 1, "1 webhook")
  let (wh_name, wh_item) = doc.webhooks[0]
  debug_assert(wh_name == "pushEvent", "webhook name")
  debug_assert(wh_item.operations.length() == 1, "webhook post op")
}

test "parse_auto_detect_json_and_yaml" {
  match parse(petstore_30_json) {
    Ok(d) => debug_assert(d.info.title == "Swagger Petstore", "auto JSON")
    Err(e) => debug_assert(false, "auto JSON failed: " + e.message)
  }
  match parse(github_31_yaml) {
    Ok(d) => debug_assert(d.info.title == "GitHub Mini API", "auto YAML")
    Err(e) => debug_assert(false, "auto YAML failed: " + e.message)
  }
}

test "reject_invalid_openapi_versions" {
  let cases = [
    "{\"swagger\":\"2.0\",\"info\":{\"title\":\"Old\",\"version\":\"1\"},\"paths\":{}}",
    "{\"openapi\":\"2.0.0\",\"info\":{\"title\":\"Old\",\"version\":\"1\"},\"paths\":{}}",
    "{\"openapi\":\"3.2.0\",\"info\":{\"title\":\"Future\",\"version\":\"1\"},\"paths\":{}}",
    "{\"openapi\":\"4.0.0\",\"info\":{\"title\":\"Future\",\"version\":\"1\"},\"paths\":{}}",
    "{\"openapi\":\"invalid\",\"info\":{\"title\":\"Bad\",\"version\":\"1\"},\"paths\":{}}",
    "{\"info\":{\"title\":\"Missing\",\"version\":\"1\"},\"paths\":{}}",
  ]
  let mut i = 0
  while i < cases.length() {
    match parse_json(cases[i]) {
      Ok(_) => debug_assert(false, "should reject invalid version case " + i.to_string())
      Err(e) => {
        debug_assert(
          e.is_kind(OpenApiErrorKind::UnsupportedVersion) ||
          e.is_kind(OpenApiErrorKind::InvalidDocument),
          "expected UnsupportedVersion or InvalidDocument",
        )
      }
    }
    i = i + 1
  }
}

test "ref_resolution_rfc6901_escapes_and_31_siblings" {
  let src =
  "{\n" +
  "  \"openapi\": \"3.1.0\",\n" +
  "  \"info\": { \"title\": \"Ref Test\", \"version\": \"1.0\" },\n" +
  "  \"paths\": {},\n" +
  "  \"components\": {\n" +
  "    \"schemas\": {\n" +
  "      \"a/b~c\": {\n" +
  "        \"type\": \"string\",\n" +
  "        \"summary\": \"Base summary\",\n" +
  "        \"description\": \"Base desc\"\n" +
  "      },\n" +
  "      \"Alias\": {\n" +
  "        \"$ref\": \"#/components/schemas/a~1b~0c\",\n" +
  "        \"summary\": \"Sibling summary\",\n" +
  "        \"description\": \"Sibling desc\"\n" +
  "      },\n" +
  "      \"Chained\": {\n" +
  "        \"$ref\": \"#/components/schemas/Alias\"\n" +
  "      }\n" +
  "    }\n" +
  "  }\n" +
  "}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      return
    }
  }
  // Direct RFC 6901 ~1 and ~0 resolution
  match doc.resolve_ref("#/components/schemas/a~1b~0c") {
    Ok(v) => {
      match json5::get(v, "type") {
        Some(json5::Json5Value::Str(t)) => debug_assert(t == "string", "type string")
        _ => debug_assert(false, "missing type")
      }
    }
    Err(e) => debug_assert(false, "resolve_ref failed: " + e.message)
  }
  // OpenAPI 3.1 sibling summary & description preservation
  let alias_val = match doc.resolve_ref("#/components/schemas/Alias") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "resolve Alias failed: " + e.message)
      return
    }
  }
  match json5::get(alias_val, "summary") {
    Some(json5::Json5Value::Str(s)) => debug_assert(s == "Sibling summary", "sibling summary preserved")
    _ => debug_assert(false, "missing sibling summary")
  }
  match json5::get(alias_val, "description") {
    Some(json5::Json5Value::Str(s)) => debug_assert(s == "Sibling desc", "sibling description preserved")
    _ => debug_assert(false, "missing sibling description")
  }
  match json5::get(alias_val, "type") {
    Some(json5::Json5Value::Str(t)) => debug_assert(t == "string", "target type preserved")
    _ => debug_assert(false, "missing target type")
  }
  // Chained ref resolution
  match doc.resolve_ref("#/components/schemas/Chained") {
    Ok(v) => {
      match json5::get(v, "summary") {
        Some(json5::Json5Value::Str(s)) => debug_assert(s == "Sibling summary", "chained summary")
        _ => debug_assert(false, "missing chained summary")
      }
    }
    Err(e) => debug_assert(false, "resolve Chained failed: " + e.message)
  }
}

test "ref_cycle_detection_direct_and_mutual" {
  let src =
  "{\n" +
  "  \"openapi\": \"3.1.0\",\n" +
  "  \"info\": { \"title\": \"Cycle Test\", \"version\": \"1.0\" },\n" +
  "  \"paths\": {},\n" +
  "  \"components\": {\n" +
  "    \"schemas\": {\n" +
  "      \"SelfCycle\": { \"$ref\": \"#/components/schemas/SelfCycle\" },\n" +
  "      \"MutualA\": { \"$ref\": \"#/components/schemas/MutualB\" },\n" +
  "      \"MutualB\": { \"$ref\": \"#/components/schemas/MutualA\" }\n" +
  "    }\n" +
  "  }\n" +
  "}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      return
    }
  }
  match doc.resolve_ref("#/components/schemas/SelfCycle") {
    Ok(_) => debug_assert(false, "SelfCycle must fail")
    Err(e) => debug_assert(e.is_kind(OpenApiErrorKind::RefCycle), "expected RefCycle for SelfCycle")
  }
  match doc.resolve_ref("#/components/schemas/MutualA") {
    Ok(_) => debug_assert(false, "MutualA must fail")
    Err(e) => debug_assert(e.is_kind(OpenApiErrorKind::RefCycle), "expected RefCycle for MutualA")
  }
}

test "recursive_schema_dereference_safe_no_crash" {
  let src =
  "{\n" +
  "  \"openapi\": \"3.1.0\",\n" +
  "  \"info\": { \"title\": \"Recursive\", \"version\": \"1.0\" },\n" +
  "  \"paths\": {},\n" +
  "  \"components\": {\n" +
  "    \"schemas\": {\n" +
  "      \"TreeNode\": {\n" +
  "        \"type\": \"object\",\n" +
  "        \"required\": [\"name\"],\n" +
  "        \"properties\": {\n" +
  "          \"name\": { \"type\": \"string\" },\n" +
  "          \"children\": {\n" +
  "            \"type\": \"array\",\n" +
  "            \"items\": { \"$ref\": \"#/components/schemas/TreeNode\" }\n" +
  "          }\n" +
  "        }\n" +
  "      }\n" +
  "    }\n" +
  "  }\n" +
  "}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      return
    }
  }
  let ref_obj = json5::Json5Value::Object([
    ("$ref", json5::Json5Value::Str("#/components/schemas/TreeNode")),
  ])
  match doc.dereference_schema(ref_obj) {
    Ok(deref) => {
      // Must succeed with finite output and local $defs for the recursive cycle
      match json5::get(deref, "type") {
        Some(json5::Json5Value::Str(t)) => debug_assert(t == "object", "deref root is object")
        _ => debug_assert(false, "expected object type")
      }
    }
    Err(e) => debug_assert(false, "recursive schema deref should succeed cleanly, got: " + e.message)
  }
}

test "dos_limits_ref_expansion_bomb_and_depth" {
  // Build exponential $ref bomb: L0 -> 2x L1 -> 4x L2 -> ... -> 2^18 L18
  let sb = StringBuilder::new()
  sb.write_string("{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"Bomb\",\"version\":\"1\"},\"paths\":{},\"components\":{\"schemas\":{")
  let mut i = 0
  while i < 18 {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("\"L")
    sb.write_string(i.to_string())
    sb.write_string("\":{\"type\":\"object\",\"properties\":{\"a\":{\"$ref\":\"#/components/schemas/L")
    sb.write_string((i + 1).to_string())
    sb.write_string("\"},\"b\":{\"$ref\":\"#/components/schemas/L")
    sb.write_string((i + 1).to_string())
    sb.write_string("\"}}}")
    i = i + 1
  }
  sb.write_string(",\"L18\":{\"type\":\"string\"}}}}")
  let limits = OpenApiLimits::new(64, 64, 128, 200000)
  let doc = match parse_json_with_limits(sb.to_string(), limits) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse bomb failed: " + e.message)
      return
    }
  }
  let root_ref = json5::Json5Value::Object([
    ("$ref", json5::Json5Value::Str("#/components/schemas/L0")),
  ])
  match doc.dereference_schema(root_ref) {
    Ok(_) => debug_assert(false, "exponential $ref bomb must hit LimitExceeded")
    Err(e) => debug_assert(e.is_kind(OpenApiErrorKind::LimitExceeded), "expected LimitExceeded")
  }

  // Deep JSON nesting exceeding max_depth
  let deep = StringBuilder::new()
  deep.write_string("{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"Deep\",\"version\":\"1\"},\"paths\":{},\"x-deep\":")
  i = 0
  while i < 40 {
    deep.write_string("[")
    i = i + 1
  }
  deep.write_string("1")
  i = 0
  while i < 40 {
    deep.write_string("]")
    i = i + 1
  }
  deep.write_string("}")
  let tight = OpenApiLimits::new(16, 16, 128, 10000)
  match parse_json_with_limits(deep.to_string(), tight) {
    Ok(_) => debug_assert(false, "deep nesting must fail with LimitExceeded")
    Err(e) => {
      debug_assert(
        e.is_kind(OpenApiErrorKind::LimitExceeded) || e.is_kind(OpenApiErrorKind::ParseError),
        "expected LimitExceeded or ParseError",
      )
    }
  }
}
