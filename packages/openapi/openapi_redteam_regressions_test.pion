///| Regression tests for Wave 15 RT-openapi red-team findings (1 P0 + 12 P1 + 11 P2).

import "json5"
import "jsonschema"

test "rt_p0_fanout_hoisting_and_p1_11_acyclic_dag_budget" {
  // 1. Fan-out: A0 has 2000 refs to A1 (60 props). Shared $defs hoisting keeps node count tiny.
  let sb = StringBuilder::new()
  sb.write_string("{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"f\",\"version\":\"1\"},\"paths\":{\"/b\":{\"post\":{\"operationId\":\"op0\",\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/A0\"}}}},\"responses\":{\"200\":{\"description\":\"ok\"}}}}},\"components\":{\"schemas\":{\"A0\":{\"type\":\"object\",\"properties\":{")
  let mut i = 0
  while i < 2000 {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("\"p" + i.to_string() + "\":{\"$ref\":\"#/components/schemas/A1\"}")
    i = i + 1
  }
  sb.write_string("}},\"A1\":{\"type\":\"object\",\"properties\":{")
  i = 0
  while i < 60 {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("\"q" + i.to_string() + "\":{\"type\":\"string\"}")
    i = i + 1
  }
  sb.write_string("}}}}}")
  let doc = match parse_json(sb.to_string()) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse fanout failed: " + e.message)
      return
    }
  }
  match Validator::from_doc(doc) {
    Ok(v) => debug_assert(v.compiled_schemas.length() == 1, "compiled 1 schema")
    Err(e) => debug_assert(false, "fanout from_doc failed: " + e.message)
  }
  match doc.export_tool("op0") {
    Ok(t) => debug_assert(t.name == "op0", "export fanout ok")
    Err(e) => debug_assert(false, "fanout export_tool failed: " + e.message)
  }

  // 2. Ordinary acyclic 7-schema DAG (5^6 = 15625 paths) must succeed under default limits.
  let dsb = StringBuilder::new()
  dsb.write_string("{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"d\",\"version\":\"1\"},\"paths\":{\"/o\":{\"post\":{\"operationId\":\"op0\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/N0\"}}}},\"responses\":{\"200\":{\"description\":\"ok\"}}}}},\"components\":{\"schemas\":{")
  i = 0
  while i < 6 {
    if i > 0 {
      dsb.write_string(",")
    }
    dsb.write_string("\"N" + i.to_string() + "\":{\"type\":\"object\",\"properties\":{")
    let mut k = 0
    while k < 5 {
      if k > 0 {
        dsb.write_string(",")
      }
      dsb.write_string("\"f" + k.to_string() + "\":{\"$ref\":\"#/components/schemas/N" + (i + 1).to_string() + "\"}")
      k = k + 1
    }
    dsb.write_string("}}")
    i = i + 1
  }
  dsb.write_string(",\"N6\":{\"type\":\"string\"}}}}")
  let dag_doc = match parse_json(dsb.to_string()) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse dag failed: " + e.message)
      return
    }
  }
  match Validator::from_doc(dag_doc) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "acyclic 7-schema DAG should succeed: " + e.message)
  }
}

test "rt_p1_readonly_writeonly_and_p2_8_rejection" {
  let src =
  "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"t\",\"version\":\"1\"},\"paths\":{\"/p\":{\"post\":{\"operationId\":\"p\",\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/P\"}}}},\"responses\":{\"200\":{\"description\":\"ok\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/P\"}}}}}}}},\"components\":{\"schemas\":{\"P\":{\"type\":\"object\",\"required\":[\"id\",\"name\",\"pw\"],\"properties\":{\"id\":{\"type\":\"integer\",\"readOnly\":true},\"name\":{\"type\":\"string\"},\"pw\":{\"type\":\"string\",\"writeOnly\":true}}}}}}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  let v = match Validator::from_doc(doc) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "from_doc failed: " + e.message)
      return
    }
  }
  // Request omitting readOnly `id` is valid; sending `id` is rejected
  let ok_req = HttpRequest::{
    method: HttpMethod::Post,
    path: "/p",
    query: [],
    headers: [],
    cookies: [],
    content_type: Some("application/json"),
    body: Some("{\"name\":\"rex\",\"pw\":\"secret\"}"),
  }
  debug_assert(v.validate_request(ok_req).length() == 0, "request omitting readOnly id must pass")
  let bad_req = HttpRequest::{
    method: HttpMethod::Post,
    path: "/p",
    query: [],
    headers: [],
    cookies: [],
    content_type: Some("application/json"),
    body: Some("{\"id\":1,\"name\":\"rex\",\"pw\":\"secret\"}"),
  }
  debug_assert(v.validate_request(bad_req).length() > 0, "request sending readOnly id must fail")

  // Response omitting writeOnly `pw` is valid; returning `pw` is rejected
  let ok_resp = HttpResponse::{
    status: 200,
    headers: [],
    content_type: Some("application/json"),
    body: Some("{\"id\":1,\"name\":\"rex\"}"),
  }
  debug_assert(v.validate_response(HttpMethod::Post, "/p", ok_resp).length() == 0, "response omitting writeOnly pw must pass")
  let bad_resp = HttpResponse::{
    status: 200,
    headers: [],
    content_type: Some("application/json"),
    body: Some("{\"id\":1,\"name\":\"rex\",\"pw\":\"secret\"}"),
  }
  debug_assert(v.validate_response(HttpMethod::Post, "/p", bad_resp).length() > 0, "response sending writeOnly pw must fail")
}

test "rt_p1_non_json_bodies_content_params_and_object_styles" {
  let src =
  "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"t\",\"version\":\"1\"},\"paths\":{\"/c\":{\"post\":{\"operationId\":\"c\",\"parameters\":[{\"name\":\"q\",\"in\":\"query\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[\"a\"]}}}},{\"name\":\"filter\",\"in\":\"query\",\"style\":\"deepObject\",\"explode\":true,\"schema\":{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"integer\"}}}},{\"name\":\"o\",\"in\":\"query\",\"style\":\"form\",\"explode\":false,\"schema\":{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"integer\"}}}},{\"name\":\"s\",\"in\":\"query\",\"allowEmptyValue\":true,\"schema\":{\"type\":\"string\",\"minLength\":1}}],\"requestBody\":{\"required\":true,\"content\":{\"application/x-www-form-urlencoded\":{\"schema\":{\"type\":\"object\",\"required\":[\"a\"],\"properties\":{\"a\":{\"type\":\"integer\"}}}},\"text/plain\":{\"schema\":{\"type\":\"string\",\"maxLength\":3}}}},\"responses\":{\"200\":{\"description\":\"ok\"}}}}}}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  let v = match Validator::from_doc(doc) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "from_doc failed: " + e.message)
      return
    }
  }
  let ok_form = HttpRequest::{
    method: HttpMethod::Post,
    path: "/c",
    query: [("q", "{\"a\":1}"), ("filter[a]", "7"), ("o", "a,9"), ("s", "")],
    headers: [],
    cookies: [],
    content_type: Some("application/x-www-form-urlencoded"),
    body: Some("a=42"),
  }
  debug_assert(v.validate_request(ok_form).length() == 0, "valid form + deepObject + form object + content + allowEmptyValue")

  let bad_form = HttpRequest::{
    method: HttpMethod::Post,
    path: "/c",
    query: [("q", "{\"b\":1}"), ("filter[a]", "nope"), ("o", "a,bad")],
    headers: [],
    cookies: [],
    content_type: Some("application/x-www-form-urlencoded"),
    body: Some("a=not-int"),
  }
  debug_assert(v.validate_request(bad_form).length() >= 4, "invalid form + content + deepObject + form object must fail")

  let bad_text = HttpRequest::{
    method: HttpMethod::Post,
    path: "/c",
    query: [],
    headers: [],
    cookies: [],
    content_type: Some("text/plain"),
    body: Some("too long"),
  }
  debug_assert(v.validate_request(bad_text).length() > 0, "text/plain maxLength violation must fail")
}

test "rt_p1_router_servers_slashes_and_p2_path_styles_method_case" {
  // Case-sensitive HttpMethod::parse
  debug_assert(HttpMethod::parse("GET") is Some(_), "uppercase GET")
  debug_assert(HttpMethod::parse("get") is None, "lowercase get rejected")

  let src =
  "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"t\",\"version\":\"1\"},\"servers\":[{\"url\":\"https://api.example.com/{ver}\",\"variables\":{\"ver\":{\"default\":\"v1\",\"enum\":[\"v1\",\"v2\"]}}}],\"paths\":{\"/l/{id}\":{\"get\":{\"operationId\":\"l\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"style\":\"label\",\"schema\":{\"type\":\"integer\"}}],\"responses\":{\"200\":{\"description\":\"ok\"}}}},\"/m/{id}\":{\"get\":{\"operationId\":\"m\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"style\":\"matrix\",\"schema\":{\"type\":\"integer\"}}],\"responses\":{\"200\":{\"description\":\"ok\"}}}},\"/users\":{\"get\":{\"operationId\":\"u\",\"responses\":{\"200\":{\"description\":\"ok\"}}}}}}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  let v = match Validator::from_doc(doc) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "from_doc failed: " + e.message)
      return
    }
  }
  debug_assert(v.validate_request(HttpRequest::new(HttpMethod::Get, "/v1/l/.5")).length() == 0, "server v1 + label")
  debug_assert(v.validate_request(HttpRequest::new(HttpMethod::Get, "/v2/m/;id=9")).length() == 0, "server v2 + matrix")
  debug_assert(v.validate_request(HttpRequest::new(HttpMethod::Get, "/users")).length() > 0, "missing server base path 404")
  debug_assert(v.validate_request(HttpRequest::new(HttpMethod::Get, "/v1/users/")).length() > 0, "trailing slash 404")
  debug_assert(v.validate_request(HttpRequest::new(HttpMethod::Get, "/v1//users")).length() > 0, "empty segment 404")
}

test "rt_p1_31_siblings_defs_collision_literals_and_p2_tool_export" {
  // 3.1 $ref siblings apply in addition (AND)
  let s31 =
  "{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"t\",\"version\":\"1\"},\"paths\":{\"/c\":{\"post\":{\"operationId\":\"list users/v2 (beta)\",\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\"}},{\"name\":\"id\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}},{\"name\":\"body\",\"in\":\"header\",\"schema\":{\"type\":\"string\"}}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/A\",\"required\":[\"b\"]}}}},\"responses\":{\"200\":{\"description\":\"ok\"}}}}},\"components\":{\"schemas\":{\"A\":{\"type\":\"object\",\"required\":[\"a\"],\"example\":{\"$ref\":\"#/not/a/ref\"}}}}}"
  let doc = match parse_json(s31) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  debug_assert(doc.validate().length() == 1, "only path param id not in template /c")
  let v = match Validator::from_doc(doc) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "from_doc failed: " + e.message)
      return
    }
  }
  let missing_a = HttpRequest::{
    method: HttpMethod::Post,
    path: "/c",
    query: [],
    headers: [],
    cookies: [],
    content_type: Some("application/json"),
    body: Some("{\"b\":1}"),
  }
  debug_assert(v.validate_request(missing_a).length() > 0, "3.1 $ref target required 'a' must still be enforced")

  match doc.export_tool("list users/v2 (beta)") {
    Ok(t) => {
      debug_assert(t.name == "list_users_v2__beta_", "tool name sanitized")
      match json5::get(t.input_schema, "properties") {
        Some(props) => {
          debug_assert(json5::get(props, "path_id") is Some(_), "namespaced path_id")
          debug_assert(json5::get(props, "query_id") is Some(_), "namespaced query_id")
          debug_assert(json5::get(props, "header_body") is Some(_), "namespaced header_body")
          debug_assert(json5::get(props, "body") is Some(_), "requestBody body")
        }
        None => debug_assert(false, "missing properties")
      }
    }
    Err(e) => debug_assert(false, "export_tool failed: " + e.message)
  }
}
