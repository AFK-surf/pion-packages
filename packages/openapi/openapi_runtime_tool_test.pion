///| Tests for runtime request/response validation (path/query/header/cookie params,
///| explode/form/simple styles, JSON body, 2XX/default responses) and AI Tool / MCP Schema export.

import "json5"
import "jsonschema"

let stripe_style_spec : String =
"{\n" +
"  \"openapi\": \"3.0.3\",\n" +
"  \"info\": { \"title\": \"Payments API\", \"version\": \"2024-01\" },\n" +
"  \"paths\": {\n" +
"    \"/v1/charges/{chargeId}\": {\n" +
"      \"post\": {\n" +
"        \"operationId\": \"captureCharge\",\n" +
"        \"summary\": \"Capture an authorized charge\",\n" +
"        \"description\": \"Captures the payment of an existing, uncaptured charge.\",\n" +
"        \"parameters\": [\n" +
"          {\n" +
"            \"name\": \"chargeId\",\n" +
"            \"in\": \"path\",\n" +
"            \"required\": true,\n" +
"            \"schema\": { \"type\": \"string\", \"pattern\": \"^ch_[a-z0-9]+$\" }\n" +
"          },\n" +
"          {\n" +
"            \"name\": \"expand\",\n" +
"            \"in\": \"query\",\n" +
"            \"required\": false,\n" +
"            \"style\": \"form\",\n" +
"            \"explode\": true,\n" +
"            \"schema\": { \"type\": \"array\", \"items\": { \"type\": \"string\", \"enum\": [\"customer\", \"invoice\", \"balance_transaction\"] } }\n" +
"          },\n" +
"          {\n" +
"            \"name\": \"tags\",\n" +
"            \"in\": \"query\",\n" +
"            \"required\": false,\n" +
"            \"style\": \"form\",\n" +
"            \"explode\": false,\n" +
"            \"schema\": { \"type\": \"array\", \"minItems\": 1, \"items\": { \"type\": \"string\" } }\n" +
"          },\n" +
"          {\n" +
"            \"name\": \"Idempotency-Key\",\n" +
"            \"in\": \"header\",\n" +
"            \"required\": true,\n" +
"            \"schema\": { \"type\": \"string\", \"minLength\": 8 }\n" +
"          },\n" +
"          {\n" +
"            \"name\": \"session_id\",\n" +
"            \"in\": \"cookie\",\n" +
"            \"required\": false,\n" +
"            \"schema\": { \"type\": \"string\", \"minLength\": 4 }\n" +
"          }\n" +
"        ],\n" +
"        \"requestBody\": {\n" +
"          \"required\": true,\n" +
"          \"content\": {\n" +
"            \"application/json\": {\n" +
"              \"schema\": { \"$ref\": \"#/components/schemas/CaptureRequest\" }\n" +
"            }\n" +
"          }\n" +
"        },\n" +
"        \"responses\": {\n" +
"          \"200\": {\n" +
"            \"description\": \"Captured charge\",\n" +
"            \"headers\": {\n" +
"              \"X-Request-Id\": {\n" +
"                \"required\": true,\n" +
"                \"schema\": { \"type\": \"string\", \"minLength\": 4 }\n" +
"              }\n" +
"            },\n" +
"            \"content\": {\n" +
"              \"application/json\": {\n" +
"                \"schema\": { \"$ref\": \"#/components/schemas/Charge\" }\n" +
"              }\n" +
"            }\n" +
"          },\n" +
"          \"4XX\": {\n" +
"            \"description\": \"Client error\",\n" +
"            \"content\": {\n" +
"              \"application/json\": {\n" +
"                \"schema\": { \"$ref\": \"#/components/schemas/ApiError\" }\n" +
"              }\n" +
"            }\n" +
"          },\n" +
"          \"default\": {\n" +
"            \"description\": \"Fallback error\",\n" +
"            \"content\": {\n" +
"              \"application/json\": {\n" +
"                \"schema\": { \"$ref\": \"#/components/schemas/ApiError\" }\n" +
"              }\n" +
"            }\n" +
"          }\n" +
"        }\n" +
"      }\n" +
"    }\n" +
"  },\n" +
"  \"components\": {\n" +
"    \"schemas\": {\n" +
"      \"CaptureRequest\": {\n" +
"        \"type\": \"object\",\n" +
"        \"required\": [\"amount\"],\n" +
"        \"properties\": {\n" +
"          \"amount\": { \"type\": \"integer\", \"minimum\": 50 },\n" +
"          \"receipt_email\": { \"type\": \"string\", \"nullable\": true },\n" +
"          \"metadata\": { \"$ref\": \"#/components/schemas/Metadata\" }\n" +
"        }\n" +
"      },\n" +
"      \"Metadata\": {\n" +
"        \"type\": \"object\",\n" +
"        \"properties\": {\n" +
"          \"order_id\": { \"type\": \"string\" }\n" +
"        }\n" +
"      },\n" +
"      \"Charge\": {\n" +
"        \"type\": \"object\",\n" +
"        \"required\": [\"id\", \"captured\", \"amount\"],\n" +
"        \"properties\": {\n" +
"          \"id\": { \"type\": \"string\" },\n" +
"          \"captured\": { \"type\": \"boolean\" },\n" +
"          \"amount\": { \"type\": \"integer\", \"minimum\": 0 }\n" +
"        }\n" +
"      },\n" +
"      \"ApiError\": {\n" +
"        \"type\": \"object\",\n" +
"        \"required\": [\"code\", \"message\"],\n" +
"        \"properties\": {\n" +
"          \"code\": { \"type\": \"string\" },\n" +
"          \"message\": { \"type\": \"string\" }\n" +
"        }\n" +
"      }\n" +
"    }\n" +
"  }\n" +
"}"

fn has_runtime_err(errs : Array[RuntimeValidationError], kind : RuntimeErrorKind) -> Bool {
  let mut i = 0
  while i < errs.length() {
    if runtime_error_kind_eq(errs[i].kind, kind) {
      return true
    }
    i = i + 1
  }
  false
}

test "validate_request_valid_and_param_styles" {
  let doc = match parse_json(stripe_style_spec) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      return
    }
  }
  let validator = match Validator::from_doc(doc) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "validator build failed: " + e.message)
      return
    }
  }

  // Valid request with explode=true repeated query, explode=false comma query, case-insensitive header, nullable=true field
  let req = HttpRequest::{
    method: HttpMethod::Post,
    path: "/v1/charges/ch_abc123",
    query: [("expand", "customer"), ("expand", "invoice"), ("tags", "vip,urgent")],
    headers: [("idempotency-key", "idem-12345678")],
    cookies: [("session_id", "sess99")],
    content_type: Some("application/json; charset=utf-8"),
    body: Some("{\"amount\":1500,\"receipt_email\":null,\"metadata\":{\"order_id\":\"ord_1\"}}"),
  }
  let errs = validator.validate_request(req)
  debug_assert(errs.length() == 0, "valid request should have 0 errors")
}

test "validate_request_rejects_bad_params_header_body" {
  let doc = match parse_json(stripe_style_spec) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  let validator = match Validator::from_doc(doc) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "validator build failed")
      return
    }
  }

  // 1. Missing required header + bad path pattern + invalid query enum + body schema violation
  let bad_req = HttpRequest::{
    method: HttpMethod::Post,
    path: "/v1/charges/invalid_id",
    query: [("expand", "unknown_field")],
    headers: [],
    cookies: [("session_id", "ab")],
    content_type: Some("application/json"),
    body: Some("{\"amount\":10}"),
  }
  let errs = validator.validate_request(bad_req)
  debug_assert(has_runtime_err(errs, RuntimeErrorKind::MissingParameter), "missing Idempotency-Key")
  debug_assert(has_runtime_err(errs, RuntimeErrorKind::InvalidParameter), "invalid path/query/cookie param")
  debug_assert(has_runtime_err(errs, RuntimeErrorKind::SchemaViolation), "amount < 50")

  // 2. Unsupported media type
  let bad_ct = HttpRequest::{
    method: HttpMethod::Post,
    path: "/v1/charges/ch_abc123",
    query: [],
    headers: [("Idempotency-Key", "idem-12345678")],
    cookies: [],
    content_type: Some("text/plain"),
    body: Some("hello"),
  }
  let errs_ct = validator.validate_request(bad_ct)
  debug_assert(has_runtime_err(errs_ct, RuntimeErrorKind::UnsupportedMediaType), "unsupported media type")

  // 3. Missing required requestBody
  let no_body = HttpRequest::{
    method: HttpMethod::Post,
    path: "/v1/charges/ch_abc123",
    query: [],
    headers: [("Idempotency-Key", "idem-12345678")],
    cookies: [],
    content_type: Some("application/json"),
    body: None,
  }
  let errs_nb = validator.validate_request(no_body)
  debug_assert(has_runtime_err(errs_nb, RuntimeErrorKind::MissingRequestBody), "missing required body")
}

test "validate_response_exact_2xx_and_default" {
  let doc = match parse_json(stripe_style_spec) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  let validator = match Validator::from_doc(doc) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "validator build failed")
      return
    }
  }

  // Exact 200 valid
  let ok_resp = HttpResponse::{
    status: 200,
    headers: [("x-request-id", "req_9999")],
    content_type: Some("application/json"),
    body: Some("{\"id\":\"ch_abc123\",\"captured\":true,\"amount\":1500}"),
  }
  debug_assert(
    validator.validate_response(HttpMethod::Post, "/v1/charges/ch_abc123", ok_resp).length() == 0,
    "valid 200 response",
  )

  // Missing required response header + schema violation
  let bad_200 = HttpResponse::{
    status: 200,
    headers: [],
    content_type: Some("application/json"),
    body: Some("{\"id\":\"ch_abc123\",\"captured\":\"yes\",\"amount\":-5}"),
  }
  let errs_200 = validator.validate_response(HttpMethod::Post, "/v1/charges/ch_abc123", bad_200)
  debug_assert(has_runtime_err(errs_200, RuntimeErrorKind::MissingResponseHeader), "missing X-Request-Id")
  debug_assert(has_runtime_err(errs_200, RuntimeErrorKind::SchemaViolation), "bad charge body")

  // 4XX wildcard match (422)
  let resp_422 = HttpResponse::{
    status: 422,
    headers: [],
    content_type: Some("application/json"),
    body: Some("{\"code\":\"invalid_amount\",\"message\":\"Too small\"}"),
  }
  debug_assert(
    validator.validate_response(HttpMethod::Post, "/v1/charges/ch_abc123", resp_422).length() == 0,
    "4XX matches 422",
  )

  // default fallback match (503) with invalid body
  let resp_503 = HttpResponse::{
    status: 503,
    headers: [],
    content_type: Some("application/json"),
    body: Some("{\"code\":123}"),
  }
  let errs_503 = validator.validate_response(HttpMethod::Post, "/v1/charges/ch_abc123", resp_503)
  debug_assert(has_runtime_err(errs_503, RuntimeErrorKind::SchemaViolation), "default response validates ApiError")
}

fn contains_ref_key(v : json5::Json5Value) -> Bool {
  match v {
    json5::Json5Value::Object(entries) => {
      let mut i = 0
      while i < entries.length() {
        let (k, sub) = entries[i]
        if k == "$ref" {
          return true
        }
        if contains_ref_key(sub) {
          return true
        }
        i = i + 1
      }
      false
    }
    json5::Json5Value::Array(items) => {
      let mut i = 0
      while i < items.length() {
        if contains_ref_key(items[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

test "export_ai_tool_schema_standalone_no_dangling_refs" {
  let doc = match parse_json(stripe_style_spec) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  let tool = match doc.export_tool("captureCharge") {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, "export_tool failed: " + e.message)
      return
    }
  }
  debug_assert(tool.name == "captureCharge", "tool name")
  debug_assert(!contains_ref_key(tool.input_schema), "flattened non-cyclic tool schema must have zero $ref")

  // Standalone exported input_schema must compile and validate directly in packages/jsonschema!
  let compiled = match jsonschema::compile(tool.input_schema) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "exported tool schema failed jsonschema::compile: " + e.message)
      return
    }
  }
  let good_call =
  "{\"chargeId\":\"ch_123\",\"Idempotency-Key\":\"idem-12345678\",\"body\":{\"amount\":500,\"metadata\":{\"order_id\":\"o1\"}}}"
  match compiled.is_valid_str(good_call) {
    Ok(valid) => debug_assert(valid, "good tool call must validate")
    Err(e) => debug_assert(false, "is_valid_str error: " + e.message)
  }
  let bad_call = "{\"chargeId\":\"ch_123\"}"
  match compiled.is_valid_str(bad_call) {
    Ok(valid) => debug_assert(!valid, "missing required header/body must fail")
    Err(_) => debug_assert(false, "unexpected parse error")
  }

  // JSON serialization
  match tool.to_json() {
    Ok(js) => debug_assert(js.length() > 20, "non-empty tool json")
    Err(e) => debug_assert(false, "to_json failed: " + e.message)
  }

  // Export all tools from Petstore
  let pet_doc = match parse_json(petstore_30_json) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "petstore parse failed")
      return
    }
  }
  match pet_doc.export_all_tools() {
    Ok(tools) => debug_assert(tools.length() == 3, "3 operations in Petstore")
    Err(e) => debug_assert(false, "export_all_tools failed: " + e.message)
  }
}

test "export_ai_tool_schema_with_recursive_component_compiles" {
  let src =
  "{\n" +
  "  \"openapi\": \"3.1.0\",\n" +
  "  \"info\": { \"title\": \"Tree API\", \"version\": \"1.0\" },\n" +
  "  \"paths\": {\n" +
  "    \"/tree\": {\n" +
  "      \"post\": {\n" +
  "        \"operationId\": \"saveTree\",\n" +
  "        \"summary\": \"Save a tree\",\n" +
  "        \"requestBody\": {\n" +
  "          \"required\": true,\n" +
  "          \"content\": {\n" +
  "            \"application/json\": {\n" +
  "              \"schema\": { \"$ref\": \"#/components/schemas/TreeNode\" }\n" +
  "            }\n" +
  "          }\n" +
  "        },\n" +
  "        \"responses\": { \"200\": { \"description\": \"ok\" } }\n" +
  "      }\n" +
  "    }\n" +
  "  },\n" +
  "  \"components\": {\n" +
  "    \"schemas\": {\n" +
  "      \"TreeNode\": {\n" +
  "        \"type\": \"object\",\n" +
  "        \"required\": [\"name\"],\n" +
  "        \"properties\": {\n" +
  "          \"name\": { \"type\": \"string\" },\n" +
  "          \"children\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/components/schemas/TreeNode\" } }\n" +
  "        }\n" +
  "      }\n" +
  "    }\n" +
  "  }\n" +
  "}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  let tool = match doc.export_tool("saveTree") {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, "export recursive tool failed: " + e.message)
      return
    }
  }
  // Must compile cleanly as a standalone JSON Schema with NO dangling #/components/... ref!
  let compiled = match jsonschema::compile(tool.input_schema) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "recursive exported tool failed compile: " + e.message)
      return
    }
  }
  match compiled.is_valid_str("{\"body\":{\"name\":\"root\",\"children\":[{\"name\":\"leaf\"}]}}") {
    Ok(ok) => debug_assert(ok, "valid recursive tree")
    Err(_) => debug_assert(false, "unexpected error")
  }
  match compiled.is_valid_str("{\"body\":{\"name\":\"root\",\"children\":[{\"children\":[]}]}}") {
    Ok(ok) => debug_assert(!ok, "invalid recursive tree missing child name")
    Err(_) => debug_assert(false, "unexpected error")
  }
}
