///| Tests for static structural validation and RFC 6570 path template routing.

import "json5"

fn opt_str_eq(a : Option[String], expected : String) -> Bool {
  match a {
    Some(s) => s == expected
    None => false
  }
}

fn has_issue_code(issues : Array[ValidationIssue], code : IssueCode) -> Bool {
  let mut i = 0
  while i < issues.length() {
    if issue_code_eq(issues[i].code, code) {
      return true
    }
    i = i + 1
  }
  false
}

test "validate_valid_documents_zero_issues" {
  let doc30 = match parse_json(petstore_30_json) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse 3.0 failed: " + e.message)
      return
    }
  }
  let issues30 = doc30.validate()
  debug_assert(issues30.length() == 0, "valid Petstore 3.0 should have 0 issues")

  let doc31 = match parse_yaml(github_31_yaml) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse 3.1 failed: " + e.message)
      return
    }
  }
  let issues31 = doc31.validate()
  debug_assert(issues31.length() == 0, "valid GitHub 3.1 YAML should have 0 issues")
}

test "validate_duplicate_operation_id" {
  let src =
  "{\n" +
  "  \"openapi\": \"3.0.3\",\n" +
  "  \"info\": { \"title\": \"DupOp\", \"version\": \"1.0\" },\n" +
  "  \"paths\": {\n" +
  "    \"/a\": { \"get\": { \"operationId\": \"sameId\", \"responses\": { \"200\": { \"description\": \"ok\" } } } },\n" +
  "    \"/b\": { \"post\": { \"operationId\": \"sameId\", \"responses\": { \"200\": { \"description\": \"ok\" } } } }\n" +
  "  }\n" +
  "}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  let issues = doc.validate()
  debug_assert(has_issue_code(issues, IssueCode::DuplicateOperationId), "expected DuplicateOperationId")
}

test "validate_missing_path_param_and_not_required" {
  let src =
  "{\n" +
  "  \"openapi\": \"3.0.3\",\n" +
  "  \"info\": { \"title\": \"MissingParam\", \"version\": \"1.0\" },\n" +
  "  \"paths\": {\n" +
  "    \"/users/{userId}/posts/{postId}\": {\n" +
  "      \"get\": {\n" +
  "        \"operationId\": \"getPost\",\n" +
  "        \"parameters\": [\n" +
  "          { \"name\": \"userId\", \"in\": \"path\", \"required\": false, \"schema\": { \"type\": \"string\" } }\n" +
  "        ],\n" +
  "        \"responses\": { \"200\": { \"description\": \"ok\" } }\n" +
  "      }\n" +
  "    }\n" +
  "  }\n" +
  "}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  let issues = doc.validate()
  debug_assert(has_issue_code(issues, IssueCode::MissingPathParameter), "missing postId declaration")
  debug_assert(has_issue_code(issues, IssueCode::InvalidPathParameter), "userId must have required: true")
}

test "validate_invalid_http_method_allows_extensions" {
  let src =
  "{\n" +
  "  \"openapi\": \"3.1.0\",\n" +
  "  \"info\": { \"title\": \"MethodCheck\", \"version\": \"1.0\" },\n" +
  "  \"paths\": {\n" +
  "    \"/items\": {\n" +
  "      \"x-rate-limit\": 100,\n" +
  "      \"brew\": { \"responses\": { \"200\": { \"description\": \"coffee\" } } },\n" +
  "      \"get\": { \"responses\": { \"200\": { \"description\": \"ok\" } } }\n" +
  "    }\n" +
  "  }\n" +
  "}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  let issues = doc.validate()
  debug_assert(has_issue_code(issues, IssueCode::InvalidHttpMethod), "expected InvalidHttpMethod for 'brew'")
  debug_assert(issues.length() == 1, "x-rate-limit must be allowed, only 1 issue")
}

test "validate_dangling_ref_and_ambiguous_paths" {
  let src =
  "{\n" +
  "  \"openapi\": \"3.0.3\",\n" +
  "  \"info\": { \"title\": \"AmbiguousAndRef\", \"version\": \"1.0\" },\n" +
  "  \"paths\": {\n" +
  "    \"/users/{id}\": {\n" +
  "      \"get\": {\n" +
  "        \"parameters\": [{ \"name\": \"id\", \"in\": \"path\", \"required\": true, \"schema\": { \"type\": \"string\" } }],\n" +
  "        \"responses\": {\n" +
  "          \"200\": {\n" +
  "            \"description\": \"ok\",\n" +
  "            \"content\": { \"application/json\": { \"schema\": { \"$ref\": \"#/components/schemas/Ghost\" } } }\n" +
  "          }\n" +
  "        }\n" +
  "      }\n" +
  "    },\n" +
  "    \"/users/{name}\": {\n" +
  "      \"get\": {\n" +
  "        \"parameters\": [{ \"name\": \"name\", \"in\": \"path\", \"required\": true, \"schema\": { \"type\": \"string\" } }],\n" +
  "        \"responses\": { \"200\": { \"description\": \"ok\" } }\n" +
  "      }\n" +
  "    }\n" +
  "  }\n" +
  "}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(_) => {
      debug_assert(false, "parse failed")
      return
    }
  }
  let issues = doc.validate()
  debug_assert(has_issue_code(issues, IssueCode::DanglingRef), "expected DanglingRef for Ghost")
  debug_assert(has_issue_code(issues, IssueCode::AmbiguousPathTemplate), "expected AmbiguousPathTemplate")
}

test "router_static_priority_over_template_and_405" {
  // Declare /users/{id} BEFORE /users/me to prove static beats template regardless of order
  let src =
  "{\n" +
  "  \"openapi\": \"3.1.0\",\n" +
  "  \"info\": { \"title\": \"RouterTest\", \"version\": \"1.0\" },\n" +
  "  \"paths\": {\n" +
  "    \"/users/{id}\": {\n" +
  "      \"get\": {\n" +
  "        \"operationId\": \"getUserById\",\n" +
  "        \"parameters\": [{ \"name\": \"id\", \"in\": \"path\", \"required\": true, \"schema\": { \"type\": \"integer\" } }],\n" +
  "        \"responses\": { \"200\": { \"description\": \"ok\" } }\n" +
  "      },\n" +
  "      \"delete\": {\n" +
  "        \"operationId\": \"deleteUser\",\n" +
  "        \"parameters\": [{ \"name\": \"id\", \"in\": \"path\", \"required\": true, \"schema\": { \"type\": \"integer\" } }],\n" +
  "        \"responses\": { \"204\": { \"description\": \"deleted\" } }\n" +
  "      }\n" +
  "    },\n" +
  "    \"/users/me\": {\n" +
  "      \"get\": {\n" +
  "        \"operationId\": \"getCurrentUser\",\n" +
  "        \"responses\": { \"200\": { \"description\": \"me\" } }\n" +
  "      }\n" +
  "    },\n" +
  "    \"/orgs/{org}/repos/{repo}/issues/{num}\": {\n" +
  "      \"get\": {\n" +
  "        \"operationId\": \"getIssue\",\n" +
  "        \"parameters\": [\n" +
  "          { \"name\": \"org\", \"in\": \"path\", \"required\": true, \"schema\": { \"type\": \"string\" } },\n" +
  "          { \"name\": \"repo\", \"in\": \"path\", \"required\": true, \"schema\": { \"type\": \"string\" } },\n" +
  "          { \"name\": \"num\", \"in\": \"path\", \"required\": true, \"schema\": { \"type\": \"integer\" } }\n" +
  "        ],\n" +
  "        \"responses\": { \"200\": { \"description\": \"issue\" } }\n" +
  "      }\n" +
  "    },\n" +
  "    \"/files/{name}.{ext}\": {\n" +
  "      \"get\": {\n" +
  "        \"operationId\": \"getFile\",\n" +
  "        \"parameters\": [\n" +
  "          { \"name\": \"name\", \"in\": \"path\", \"required\": true, \"schema\": { \"type\": \"string\" } },\n" +
  "          { \"name\": \"ext\", \"in\": \"path\", \"required\": true, \"schema\": { \"type\": \"string\" } }\n" +
  "        ],\n" +
  "        \"responses\": { \"200\": { \"description\": \"file\" } }\n" +
  "      }\n" +
  "    }\n" +
  "  }\n" +
  "}"
  let doc = match parse_json(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      return
    }
  }
  let router = doc.build_router()

  // /users/me must match static route getCurrentUser
  match router.find(HttpMethod::Get, "/users/me") {
    Ok(m) => {
      debug_assert(m.path_template == "/users/me", "static route wins")
      match m.operation.operation_id {
        Some(id) => debug_assert(id == "getCurrentUser", "opId getCurrentUser")
        None => debug_assert(false, "missing opId")
      }
      debug_assert(m.path_params.length() == 0, "no path params")
    }
    Err(_) => debug_assert(false, "/users/me should match")
  }

  // /users/42?expand=true strips query and extracts id=42, plus typed coercion -> Number(42.0)
  match router.find(HttpMethod::Get, "/users/42?expand=true") {
    Ok(m) => {
      debug_assert(m.path_template == "/users/{id}", "template route")
      match m.param("id") {
        Some(v) => debug_assert(v == "42", "raw id == 42")
        None => debug_assert(false, "missing id")
      }
      match m.typed_path_params() {
        Ok(typed) => {
          debug_assert(typed.length() == 1, "1 typed param")
          let (k, v) = typed[0]
          debug_assert(k == "id", "typed key id")
          match v {
            json5::Json5Value::Number(n) => debug_assert(n == 42.0, "coerced to 42.0")
            _ => debug_assert(false, "expected Number")
          }
        }
        Err(e) => debug_assert(false, "typed coercion failed: " + e.message)
      }
    }
    Err(_) => debug_assert(false, "/users/42 should match")
  }

  // Percent-decoded multi-segment match
  match router.find(HttpMethod::Get, "/orgs/AFK-surf/repos/pion%20packages/issues/15") {
    Ok(m) => {
      debug_assert(opt_str_eq(m.param("org"), "AFK-surf"), "org")
      debug_assert(opt_str_eq(m.param("repo"), "pion packages"), "percent-decoded repo")
      debug_assert(opt_str_eq(m.param("num"), "15"), "num")
    }
    Err(_) => debug_assert(false, "multi-segment should match")
  }

  // Inline template segment /files/{name}.{ext}
  match router.find(HttpMethod::Get, "/files/report.pdf") {
    Ok(m) => {
      debug_assert(opt_str_eq(m.param("name"), "report"), "name")
      debug_assert(opt_str_eq(m.param("ext"), "pdf"), "ext")
    }
    Err(_) => debug_assert(false, "/files/report.pdf should match")
  }

  // 405 Method Not Allowed
  match router.find(HttpMethod::Post, "/users/42") {
    Ok(_) => debug_assert(false, "POST /users/42 should be 405")
    Err(RouteError::MethodNotAllowed(_, allowed)) => {
      debug_assert(allowed.length() == 2, "GET and DELETE allowed")
    }
    Err(RouteError::NotFound(_)) => debug_assert(false, "expected MethodNotAllowed, got NotFound")
  }

  // 404 Not Found
  match router.find(HttpMethod::Get, "/nonexistent/path") {
    Ok(_) => debug_assert(false, "should be 404")
    Err(RouteError::NotFound(_)) => ()
    Err(_) => debug_assert(false, "expected NotFound")
  }
}
