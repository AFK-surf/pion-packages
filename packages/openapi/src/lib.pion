///| Pure Pion OpenAPI 3.1 / 3.0 parser, `$ref` resolver, RFC 6570 router,
///| request/response validator, and AI Tool / MCP function-calling schema extractor.

import "json5"

///| Parse an OpenAPI 3.0.x or 3.1.x document from JSON or YAML (auto-detected).
pub fn parse(src : String) -> Result[OpenApiDoc, OpenApiError] {
  parse_with_limits(src, OpenApiLimits::default())
}

///| Parse an OpenAPI document from JSON or YAML with explicit resource limits.
pub fn parse_with_limits(
  src : String,
  limits : OpenApiLimits,
) -> Result[OpenApiDoc, OpenApiError] {
  parse_with_limits_impl(src, limits)
}

///| Parse an OpenAPI document from strict JSON.
pub fn parse_json(src : String) -> Result[OpenApiDoc, OpenApiError] {
  parse_json_with_limits(src, OpenApiLimits::default())
}

///| Parse an OpenAPI document from strict JSON with explicit resource limits.
pub fn parse_json_with_limits(
  src : String,
  limits : OpenApiLimits,
) -> Result[OpenApiDoc, OpenApiError] {
  parse_json_with_limits_impl(src, limits)
}

///| Parse an OpenAPI document from YAML 1.2 (via `packages/yaml`).
pub fn parse_yaml(src : String) -> Result[OpenApiDoc, OpenApiError] {
  parse_yaml_with_limits(src, OpenApiLimits::default())
}

///| Parse an OpenAPI document from YAML 1.2 with explicit resource limits.
pub fn parse_yaml_with_limits(
  src : String,
  limits : OpenApiLimits,
) -> Result[OpenApiDoc, OpenApiError] {
  parse_yaml_with_limits_impl(src, limits)
}

///| Decode an `OpenApiDoc` from a pre-parsed `Json5Value`.
pub fn from_value(
  value : json5::Json5Value,
) -> Result[OpenApiDoc, OpenApiError] {
  from_value_with_limits(value, OpenApiLimits::default())
}

///| Decode an `OpenApiDoc` from a pre-parsed `Json5Value` with explicit limits.
pub fn from_value_with_limits(
  value : json5::Json5Value,
  limits : OpenApiLimits,
) -> Result[OpenApiDoc, OpenApiError] {
  from_value_with_limits_impl(value, limits)
}

///| Resolve an internal JSON Pointer `$ref` (e.g. `#/components/schemas/Pet`).
pub fn OpenApiDoc::resolve_ref(
  self : OpenApiDoc,
  ref_str : String,
) -> Result[json5::Json5Value, OpenApiError] {
  resolve_ref_raw(self.raw, ref_str, self.openapi.is_31(), self.limits.max_ref_depth)
}

///| Resolve a JSON value that may contain `$ref` (preserving OpenAPI 3.1 sibling `summary`/`description`).
pub fn OpenApiDoc::resolve_value(
  self : OpenApiDoc,
  value : json5::Json5Value,
) -> Result[json5::Json5Value, OpenApiError] {
  resolve_value_raw(self.raw, value, self.openapi.is_31(), self.limits.max_ref_depth)
}

///| Deeply dereference a schema value with cycle detection and `OpenApiLimits` expansion budget.
pub fn OpenApiDoc::dereference_schema(
  self : OpenApiDoc,
  schema : json5::Json5Value,
) -> Result[json5::Json5Value, OpenApiError] {
  dereference_schema_impl(self, schema)
}

///| Run static structural validation on the OpenAPI document.
pub fn OpenApiDoc::validate(self : OpenApiDoc) -> Array[ValidationIssue] {
  validate_doc_impl(self)
}

///| Find an `Operation` by its `operationId`.
pub fn OpenApiDoc::find_operation_by_id(
  self : OpenApiDoc,
  operation_id : String,
) -> Option[Operation] {
  find_operation_by_id_impl(self, operation_id)
}

///| Build an RFC 6570 path template `Router` from this document.
pub fn OpenApiDoc::build_router(self : OpenApiDoc) -> Router {
  build_router_impl(self)
}

///| Match an HTTP method and request path against the router.
pub fn Router::find(
  self : Router,
  method : HttpMethod,
  path : String,
) -> Result[RouteMatch, RouteError] {
  router_find_impl(self, method, path)
}

///| Coerce extracted string path parameters according to their OpenAPI schemas.
pub fn RouteMatch::typed_path_params(
  self : RouteMatch,
) -> Result[Array[(String, json5::Json5Value)], RuntimeValidationError] {
  typed_path_params_impl(self)
}

///| Build a pre-compiled request/response `Validator` from an `OpenApiDoc`.
pub fn Validator::from_doc(doc : OpenApiDoc) -> Result[Validator, OpenApiError] {
  validator_from_doc_impl(doc)
}

///| Validate an incoming `HttpRequest` against the OpenAPI specification.
pub fn Validator::validate_request(
  self : Validator,
  req : HttpRequest,
) -> Array[RuntimeValidationError] {
  validate_request_impl(self, req)
}

///| Validate an outgoing `HttpResponse` for a given `(method, path)` against the OpenAPI specification.
pub fn Validator::validate_response(
  self : Validator,
  method : HttpMethod,
  path : String,
  resp : HttpResponse,
) -> Array[RuntimeValidationError] {
  validate_response_impl(self, method, path, resp)
}

///| Export a single Operation (by `operationId`) as a standalone AI Agent Tool / MCP schema.
pub fn OpenApiDoc::export_tool(
  self : OpenApiDoc,
  operation_id : String,
) -> Result[ToolSchema, OpenApiError] {
  export_tool_impl(self, operation_id)
}

///| Export all Operations in `paths` as standalone AI Agent Tool / MCP schemas.
pub fn OpenApiDoc::export_all_tools(
  self : OpenApiDoc,
) -> Result[Array[ToolSchema], OpenApiError] {
  export_all_tools_impl(self)
}

///| Serialize a `ToolSchema` to compact MCP/OpenAI-compatible JSON.
pub fn ToolSchema::to_json(self : ToolSchema) -> Result[String, OpenApiError] {
  tool_to_json_impl(self)
}
