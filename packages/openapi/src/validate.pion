///| Static structural validation of OpenAPI 3.0.x & 3.1.x documents.

import "json5"
import "jsonschema"

///| Extract `{param}` names from a path template and compute its canonical
///| ambiguity key (replacing every `{param}` with `{}`).
fn parse_path_template_meta(
  path : String,
) -> Result[(Array[String], String), String] {
  let n = path.length()
  if n == 0 || path.code_unit_at(0) != 47 {
    return Err("path template must start with '/'")
  }
  let params : Array[String] = []
  let canon = StringBuilder::new()
  let mut i = 0
  while i < n {
    let b = path.code_unit_at(i)
    if b == 123 {
      let start = i + 1
      let mut end = start
      while end < n && path.code_unit_at(end) != 125 {
        if path.code_unit_at(end) == 123 || path.code_unit_at(end) == 47 {
          return Err("invalid '{' or '/' inside path parameter template")
        }
        end = end + 1
      }
      if end >= n {
        return Err("unclosed '{' in path template")
      }
      let pname = path.slice(start, end)
      if pname.length() == 0 {
        return Err("empty path parameter '{}' in path template")
      }
      if str_arr_contains(params, pname) {
        return Err("duplicate path parameter '{" + pname + "}' in path template")
      }
      params.push(pname)
      canon.write_string("{}")
      i = end + 1
    } else if b == 125 {
      return Err("unmatched '}' in path template")
    } else {
      canon.write_byte(b.to_byte())
      i = i + 1
    }
  }
  Ok((params, canon.to_string()))
}

fn is_valid_status_code(code : String) -> Bool {
  if code == "default" {
    return true
  }
  if code.length() != 3 {
    return false
  }
  let c0 = code.code_unit_at(0)
  let c1 = code.code_unit_at(1)
  let c2 = code.code_unit_at(2)
  if c0 < 49 || c0 > 53 {
    return false
  }
  if (c1 == 88 || c1 == 120) && (c2 == 88 || c2 == 120) {
    return true
  }
  c1 >= 48 && c1 <= 57 && c2 >= 48 && c2 <= 57
}

fn is_valid_schema_type(t : String) -> Bool {
  t == "null" ||
  t == "boolean" ||
  t == "object" ||
  t == "array" ||
  t == "number" ||
  t == "string" ||
  t == "integer"
}

fn is_literal_data_key(k : String) -> Bool {
  k == "example" || k == "examples" || k == "default" || k == "enum" || k == "const"
}

///| Validate a Schema Object statically (invalid `type`, invalid regex `pattern`, bad numeric constraints).
fn validate_schema_object(
  v : json5::Json5Value,
  loc : String,
  depth : Int,
  max_depth : Int,
  issues : Array[ValidationIssue],
) -> Unit {
  if depth > max_depth {
    return
  }
  match v {
    json5::Json5Value::Object(entries) => {
      if get_ref_str(v) is Some(_) {
        return
      }
      let mut i = 0
      while i < entries.length() {
        let (k, sub) = entries[i]
        if k == "type" {
          match sub {
            json5::Json5Value::Str(t) => {
              if !is_valid_schema_type(t) {
                issues.push(
                  ValidationIssue::new(
                    IssueCode::InvalidSchema,
                    loc + "/type",
                    "invalid schema type: " + t,
                  ),
                )
              }
            }
            json5::Json5Value::Array(items) => {
              let mut j = 0
              while j < items.length() {
                match items[j] {
                  json5::Json5Value::Str(t) => {
                    if !is_valid_schema_type(t) {
                      issues.push(
                        ValidationIssue::new(
                          IssueCode::InvalidSchema,
                          loc + "/type/" + j.to_string(),
                          "invalid schema type: " + t,
                        ),
                      )
                    }
                  }
                  _ => {
                    issues.push(
                      ValidationIssue::new(
                        IssueCode::InvalidSchema,
                        loc + "/type/" + j.to_string(),
                        "schema type array element must be a string",
                      ),
                    )
                  }
                }
                j = j + 1
              }
            }
            _ => {
              issues.push(
                ValidationIssue::new(
                  IssueCode::InvalidSchema,
                  loc + "/type",
                  "schema 'type' must be a string or array of strings",
                ),
              )
            }
          }
        } else if k == "pattern" {
          match sub {
            json5::Json5Value::Str(pat) => {
              let probe = json5::Json5Value::Object([("pattern", json5::Json5Value::Str(pat))])
              match jsonschema::compile(probe) {
                Ok(_) => ()
                Err(e) => {
                  issues.push(
                    ValidationIssue::new(
                      IssueCode::InvalidSchema,
                      loc + "/pattern",
                      "invalid regex pattern '" + pat + "': " + e.message,
                    ),
                  )
                }
              }
            }
            _ => {
              issues.push(
                ValidationIssue::new(
                  IssueCode::InvalidSchema,
                  loc + "/pattern",
                  "schema 'pattern' must be a string",
                ),
              )
            }
          }
        } else if is_schema_map_keyword(k) {
          match sub {
            json5::Json5Value::Object(map_entries) => {
              let mut mi = 0
              while mi < map_entries.length() {
                let (mk, mv) = map_entries[mi]
                if k == "patternProperties" {
                  let probe = json5::Json5Value::Object([("pattern", json5::Json5Value::Str(mk))])
                  match jsonschema::compile(probe) {
                    Ok(_) => ()
                    Err(e) => {
                      issues.push(
                        ValidationIssue::new(
                          IssueCode::InvalidSchema,
                          loc + "/patternProperties/" + mk,
                          "invalid regex in patternProperties: " + e.message,
                        ),
                      )
                    }
                  }
                }
                validate_schema_object(mv, loc + "/" + k + "/" + mk, depth + 1, max_depth, issues)
                mi = mi + 1
              }
            }
            _ => ()
          }
        } else if is_schema_array_keyword(k) {
          match sub {
            json5::Json5Value::Array(items) => {
              let mut ai = 0
              while ai < items.length() {
                validate_schema_object(items[ai], loc + "/" + k + "/" + ai.to_string(), depth + 1, max_depth, issues)
                ai = ai + 1
              }
            }
            _ => ()
          }
        } else if is_single_schema_keyword(k) {
          match sub {
            json5::Json5Value::Array(items) => {
              let mut ai = 0
              while ai < items.length() {
                validate_schema_object(items[ai], loc + "/" + k + "/" + ai.to_string(), depth + 1, max_depth, issues)
                ai = ai + 1
              }
            }
            json5::Json5Value::Object(_) => {
              validate_schema_object(sub, loc + "/" + k, depth + 1, max_depth, issues)
            }
            _ => ()
          }
        }
        i = i + 1
      }
    }
    _ => ()
  }
}

///| Walk raw JSON tree to verify every `$ref` resolves cleanly (O(1) dedup + O(1) component lookup),
///| skipping literal data keys (`example`, `examples`, `default`, `enum`, `const`).
fn validate_refs_walk(
  doc : OpenApiDoc,
  comp_idx : ComponentsIndex,
  v : json5::Json5Value,
  loc : String,
  depth : Int,
  max_depth : Int,
  checked : StrHashMap,
  issues : Array[ValidationIssue],
) -> Unit {
  if depth > max_depth {
    return
  }
  match v {
    json5::Json5Value::Object(entries) => {
      match get_ref_str(v) {
        Some(r) => {
          if !checked.contains(r) {
            checked.set(r, 1)
            match resolve_ref_indexed(doc.raw, comp_idx, r, doc.openapi.is_31(), doc.limits.max_ref_depth) {
              Ok(_) => ()
              Err(e) => {
                let code = match e.kind {
                  OpenApiErrorKind::RefCycle => IssueCode::RefCycle
                  OpenApiErrorKind::LimitExceeded => IssueCode::LimitExceeded
                  _ => IssueCode::DanglingRef
                }
                issues.push(ValidationIssue::new(code, loc, e.message))
              }
            }
          }
        }
        None => ()
      }
      let mut i = 0
      while i < entries.length() {
        let (k, sub) = entries[i]
        if k != "$ref" && !is_literal_data_key(k) {
          validate_refs_walk(doc, comp_idx, sub, loc + "/" + k, depth + 1, max_depth, checked, issues)
        }
        i = i + 1
      }
    }
    json5::Json5Value::Array(items) => {
      let mut i = 0
      while i < items.length() {
        validate_refs_walk(doc, comp_idx, items[i], loc + "/" + i.to_string(), depth + 1, max_depth, checked, issues)
        i = i + 1
      }
    }
    _ => ()
  }
}

fn validate_doc_impl(doc : OpenApiDoc) -> Array[ValidationIssue] {
  let issues : Array[ValidationIssue] = []
  let max_d = clamp_safe_depth(doc.limits.max_depth)

  // 1. Info required fields
  if doc.info.title.length() == 0 {
    issues.push(
      ValidationIssue::new(
        IssueCode::MissingRequiredField,
        "#/info/title",
        "info.title must be a non-empty string",
      ),
    )
  }
  if doc.info.version.length() == 0 {
    issues.push(
      ValidationIssue::new(
        IssueCode::MissingRequiredField,
        "#/info/version",
        "info.version must be a non-empty string",
      ),
    )
  }

  // 2. Top-level paths / webhooks / components requirement
  if doc.openapi.is_30() {
    if !doc.has_paths {
      issues.push(
        ValidationIssue::new(
          IssueCode::MissingRequiredField,
          "#/paths",
          "OpenAPI 3.0 requires top-level 'paths' object",
        ),
      )
    }
  } else if !doc.has_paths && !doc.has_webhooks && !doc.has_components {
    issues.push(
      ValidationIssue::new(
        IssueCode::MissingRequiredField,
        "#",
        "OpenAPI 3.1 requires at least one of 'paths', 'webhooks', or 'components'",
      ),
    )
  }

  // 3. Paths, operations, operationId uniqueness, path params, ambiguous templates, schema checks
  let seen_op_ids = StrHashMap::new()
  let seen_canon_map = StrHashMap::new()
  let seen_canon_paths : Array[String] = []

  let mut pi = 0
  while pi < doc.paths.length() {
    let (path_key, item) = doc.paths[pi]
    let path_loc = "#/paths/" + path_key

    // Check unknown / invalid HTTP methods on PathItem
    let mut ui = 0
    while ui < item.unknown_keys.length() {
      let uk = item.unknown_keys[ui]
      issues.push(
        ValidationIssue::new(
          IssueCode::InvalidHttpMethod,
          path_loc + "/" + uk,
          "invalid HTTP method or unknown PathItem key: " + uk,
        ),
      )
      ui = ui + 1
    }

    // Parse path template & detect ambiguous path templates (O(1) via StrHashMap)
    let template_params = match parse_path_template_meta(path_key) {
      Ok((tparams, canon)) => {
        let prev_idx = seen_canon_map.get(canon)
        if prev_idx >= 0 {
          issues.push(
            ValidationIssue::new(
              IssueCode::AmbiguousPathTemplate,
              path_loc,
              "ambiguous path template '" + path_key + "' conflicts with '" + seen_canon_paths[prev_idx] + "'",
            ),
          )
        } else {
          let idx = seen_canon_paths.length()
          seen_canon_paths.push(path_key)
          seen_canon_map.set(canon, idx)
        }
        tparams
      }
      Err(msg) => {
        issues.push(ValidationIssue::new(IssueCode::InvalidPathTemplate, path_loc, msg))
        []
      }
    }

    // Validate each operation on this path
    let mut oi = 0
    while oi < item.operations.length() {
      let (method, op) = item.operations[oi]
      let op_loc = path_loc + "/" + method.to_lower()

      // Duplicate operationId check
      match op.operation_id {
        Some(op_id) => {
          if op_id.length() > 0 {
            if seen_op_ids.contains(op_id) {
              issues.push(
                ValidationIssue::new(
                  IssueCode::DuplicateOperationId,
                  op_loc + "/operationId",
                  "duplicate operationId: " + op_id,
                ),
              )
            } else {
              seen_op_ids.set(op_id, 1)
            }
          }
        }
        None => ()
      }

      // Check parameter location, duplicates, path parameter validity, and parameter schemas
      let mut p_idx = 0
      while p_idx < op.parameters.length() {
        let p = op.parameters[p_idx]
        if p.ref_error is None {
          match p.raw_in {
            None => {
              issues.push(
                ValidationIssue::new(
                  IssueCode::InvalidParameterLocation,
                  op_loc + "/parameters/" + p.name,
                  "parameter '" + p.name + "' is missing required 'in' field",
                ),
              )
            }
            Some(in_str) => {
              if ParamIn::parse(in_str) is None {
                issues.push(
                  ValidationIssue::new(
                    IssueCode::InvalidParameterLocation,
                    op_loc + "/parameters/" + p.name,
                    "invalid parameter location 'in': " + in_str,
                  ),
                )
              }
            }
          }
        }
        let mut p_idx2 = p_idx + 1
        while p_idx2 < op.parameters.length() {
          let p2 = op.parameters[p_idx2]
          if p.name == p2.name && param_in_eq(p.location, p2.location) {
            issues.push(
              ValidationIssue::new(
                IssueCode::DuplicateParameter,
                op_loc + "/parameters/" + p.name,
                "duplicate parameter '" + p.name + "' in " + p.location.to_string(),
              ),
            )
          }
          p_idx2 = p_idx2 + 1
        }
        if param_in_eq(p.location, ParamIn::Path) {
          if !p.required {
            issues.push(
              ValidationIssue::new(
                IssueCode::InvalidPathParameter,
                op_loc + "/parameters/" + p.name,
                "path parameter '" + p.name + "' must have required: true",
              ),
            )
          }
          if !str_arr_contains(template_params, p.name) {
            issues.push(
              ValidationIssue::new(
                IssueCode::InvalidPathParameter,
                op_loc + "/parameters/" + p.name,
                "path parameter '" + p.name + "' is not present in template '" + path_key + "'",
              ),
            )
          }
        }
        match p.schema {
          Some(ps) => validate_schema_object(ps, op_loc + "/parameters/" + p.name + "/schema", 0, max_d, issues)
          None => ()
        }
        let mut pci = 0
        while pci < p.content.length() {
          let (pct, pmt) = p.content[pci]
          match pmt.schema {
            Some(pcs) => validate_schema_object(pcs, op_loc + "/parameters/" + p.name + "/content/" + pct + "/schema", 0, max_d, issues)
            None => ()
          }
          pci = pci + 1
        }
        p_idx = p_idx + 1
      }

      // Check every template {param} is declared as in: path
      let mut ti = 0
      while ti < template_params.length() {
        let tname = template_params[ti]
        let mut declared = false
        let mut k = 0
        while k < op.parameters.length() {
          let p = op.parameters[k]
          if p.name == tname && param_in_eq(p.location, ParamIn::Path) {
            declared = true
            break
          }
          k = k + 1
        }
        if !declared {
          issues.push(
            ValidationIssue::new(
              IssueCode::MissingPathParameter,
              op_loc,
              "path template parameter '{" + tname + "}' is not declared in parameters",
            ),
          )
        }
        ti = ti + 1
      }

      // RequestBody schema checks
      match op.request_body {
        Some(rb) => {
          let mut ci = 0
          while ci < rb.content.length() {
            let (ct, mt) = rb.content[ci]
            match mt.schema {
              Some(s) => validate_schema_object(s, op_loc + "/requestBody/content/" + ct + "/schema", 0, max_d, issues)
              None => ()
            }
            ci = ci + 1
          }
        }
        None => ()
      }

      // Responses check
      if doc.openapi.is_30() && op.responses.length() == 0 {
        issues.push(
          ValidationIssue::new(
            IssueCode::MissingRequiredField,
            op_loc + "/responses",
            "OpenAPI 3.0 operation requires at least one response",
          ),
        )
      }
      let mut ri = 0
      while ri < op.responses.length() {
        let (code, resp) = op.responses[ri]
        if !is_valid_status_code(code) {
          issues.push(
            ValidationIssue::new(
              IssueCode::InvalidStatusCode,
              op_loc + "/responses/" + code,
              "invalid HTTP response status code: " + code,
            ),
          )
        }
        let mut hi = 0
        while hi < resp.headers.length() {
          let (hname, hp) = resp.headers[hi]
          match hp.schema {
            Some(hs) => validate_schema_object(hs, op_loc + "/responses/" + code + "/headers/" + hname + "/schema", 0, max_d, issues)
            None => ()
          }
          hi = hi + 1
        }
        let mut ci = 0
        while ci < resp.content.length() {
          let (ct, mt) = resp.content[ci]
          match mt.schema {
            Some(rs) => validate_schema_object(rs, op_loc + "/responses/" + code + "/content/" + ct + "/schema", 0, max_d, issues)
            None => ()
          }
          ci = ci + 1
        }
        ri = ri + 1
      }
      oi = oi + 1
    }
    pi = pi + 1
  }

  // 4. Check webhook operationIds for duplicates too
  let mut wi = 0
  while wi < doc.webhooks.length() {
    let (wk, item) = doc.webhooks[wi]
    let mut oi = 0
    while oi < item.operations.length() {
      let (method, op) = item.operations[oi]
      match op.operation_id {
        Some(op_id) => {
          if op_id.length() > 0 {
            if seen_op_ids.contains(op_id) {
              issues.push(
                ValidationIssue::new(
                  IssueCode::DuplicateOperationId,
                  "#/webhooks/" + wk + "/" + method.to_lower() + "/operationId",
                  "duplicate operationId: " + op_id,
                ),
              )
            } else {
              seen_op_ids.set(op_id, 1)
            }
          }
        }
        None => ()
      }
      oi = oi + 1
    }
    wi = wi + 1
  }

  // 5. Check component schemas
  let mut sci = 0
  while sci < doc.components.schemas.length() {
    let (sname, sval) = doc.components.schemas[sci]
    validate_schema_object(sval, "#/components/schemas/" + sname, 0, max_d, issues)
    sci = sci + 1
  }

  // 6. Verify all $ref pointers across the raw document (O(1) dedup + O(1) components index)
  let comp_idx = ComponentsIndex::from_root(doc.raw)
  let checked_refs = StrHashMap::new()
  validate_refs_walk(
    doc,
    comp_idx,
    doc.raw,
    "#",
    0,
    max_d,
    checked_refs,
    issues,
  )

  issues
}
