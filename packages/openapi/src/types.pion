///| Core public types, options, errors, and document model for `packages/openapi`.

import "json5"

///| Parsed OpenAPI semantic version (`3.0.x` or `3.1.x`).
pub struct OpenApiVersion {
  pub major : Int
  pub minor : Int
  pub patch : Int
  pub raw : String
}

///| Construct an `OpenApiVersion`.
pub fn OpenApiVersion::new(
  major : Int,
  minor : Int,
  patch : Int,
  raw : String,
) -> OpenApiVersion {
  OpenApiVersion::{ major: major, minor: minor, patch: patch, raw: raw }
}

///| Return whether this document uses OpenAPI 3.0.x.
pub fn OpenApiVersion::is_30(self : OpenApiVersion) -> Bool {
  self.major == 3 && self.minor == 0
}

///| Return whether this document uses OpenAPI 3.1.x.
pub fn OpenApiVersion::is_31(self : OpenApiVersion) -> Bool {
  self.major == 3 && self.minor == 1
}

///| Resource and DoS protection limits for parsing, `$ref` resolution, and export.
pub struct OpenApiLimits {
  pub max_depth : Int
  pub max_ref_depth : Int
  pub max_ref_expansions : Int
  pub max_nodes : Int
  pub max_paths : Int
  pub max_operations : Int
}

///| Default safe resource limits.
pub fn OpenApiLimits::default() -> OpenApiLimits {
  OpenApiLimits::{
    max_depth: 64,
    max_ref_depth: 64,
    max_ref_expansions: 4096,
    max_nodes: 200000,
    max_paths: 10000,
    max_operations: 50000,
  }
}

///| Construct custom `OpenApiLimits`.
pub fn OpenApiLimits::new(
  max_depth : Int,
  max_ref_depth : Int,
  max_ref_expansions : Int,
  max_nodes : Int,
) -> OpenApiLimits {
  OpenApiLimits::{
    max_depth: max_depth,
    max_ref_depth: max_ref_depth,
    max_ref_expansions: max_ref_expansions,
    max_nodes: max_nodes,
    max_paths: 10000,
    max_operations: 50000,
  }
}

///| Category of an OpenAPI parse, `$ref`, or export error.
pub enum OpenApiErrorKind {
  ParseError
  UnsupportedVersion
  InvalidDocument
  UnresolvedRef
  RefCycle
  InvalidPointer
  LimitExceeded
  NotFound
  SchemaError
}

///| Compare two `OpenApiErrorKind` values for equality.
pub fn error_kind_eq(a : OpenApiErrorKind, b : OpenApiErrorKind) -> Bool {
  match (a, b) {
    (OpenApiErrorKind::ParseError, OpenApiErrorKind::ParseError) => true
    (OpenApiErrorKind::UnsupportedVersion, OpenApiErrorKind::UnsupportedVersion) => true
    (OpenApiErrorKind::InvalidDocument, OpenApiErrorKind::InvalidDocument) => true
    (OpenApiErrorKind::UnresolvedRef, OpenApiErrorKind::UnresolvedRef) => true
    (OpenApiErrorKind::RefCycle, OpenApiErrorKind::RefCycle) => true
    (OpenApiErrorKind::InvalidPointer, OpenApiErrorKind::InvalidPointer) => true
    (OpenApiErrorKind::LimitExceeded, OpenApiErrorKind::LimitExceeded) => true
    (OpenApiErrorKind::NotFound, OpenApiErrorKind::NotFound) => true
    (OpenApiErrorKind::SchemaError, OpenApiErrorKind::SchemaError) => true
    _ => false
  }
}

///| Structured error returned by OpenAPI parsing, `$ref` resolution, or export.
pub struct OpenApiError {
  pub kind : OpenApiErrorKind
  pub path : String
  pub message : String
}

///| Construct an `OpenApiError`.
pub fn OpenApiError::new(
  kind : OpenApiErrorKind,
  path : String,
  message : String,
) -> OpenApiError {
  OpenApiError::{ kind: kind, path: path, message: message }
}

///| Check whether this error has the given `OpenApiErrorKind`.
pub fn OpenApiError::is_kind(self : OpenApiError, kind : OpenApiErrorKind) -> Bool {
  error_kind_eq(self.kind, kind)
}

///| Standard OpenAPI HTTP methods.
pub enum HttpMethod {
  Get
  Put
  Post
  Delete
  Options
  Head
  Patch
  Trace
}

///| Compare two `HttpMethod` values for equality.
pub fn http_method_eq(a : HttpMethod, b : HttpMethod) -> Bool {
  match (a, b) {
    (HttpMethod::Get, HttpMethod::Get) => true
    (HttpMethod::Put, HttpMethod::Put) => true
    (HttpMethod::Post, HttpMethod::Post) => true
    (HttpMethod::Delete, HttpMethod::Delete) => true
    (HttpMethod::Options, HttpMethod::Options) => true
    (HttpMethod::Head, HttpMethod::Head) => true
    (HttpMethod::Patch, HttpMethod::Patch) => true
    (HttpMethod::Trace, HttpMethod::Trace) => true
    _ => false
  }
}

///| Parse an HTTP method string (case-insensitive).
pub fn HttpMethod::parse(s : String) -> Option[HttpMethod] {
  let lower = ascii_lower_str(s)
  if lower == "get" {
    Some(HttpMethod::Get)
  } else if lower == "put" {
    Some(HttpMethod::Put)
  } else if lower == "post" {
    Some(HttpMethod::Post)
  } else if lower == "delete" {
    Some(HttpMethod::Delete)
  } else if lower == "options" {
    Some(HttpMethod::Options)
  } else if lower == "head" {
    Some(HttpMethod::Head)
  } else if lower == "patch" {
    Some(HttpMethod::Patch)
  } else if lower == "trace" {
    Some(HttpMethod::Trace)
  } else {
    None
  }
}

///| Format an `HttpMethod` as an uppercase string (`"GET"`, `"POST"`, ...).
pub fn HttpMethod::to_upper(self : HttpMethod) -> String {
  match self {
    HttpMethod::Get => "GET"
    HttpMethod::Put => "PUT"
    HttpMethod::Post => "POST"
    HttpMethod::Delete => "DELETE"
    HttpMethod::Options => "OPTIONS"
    HttpMethod::Head => "HEAD"
    HttpMethod::Patch => "PATCH"
    HttpMethod::Trace => "TRACE"
  }
}

///| Format an `HttpMethod` as a lowercase OpenAPI key (`"get"`, `"post"`, ...).
pub fn HttpMethod::to_lower(self : HttpMethod) -> String {
  match self {
    HttpMethod::Get => "get"
    HttpMethod::Put => "put"
    HttpMethod::Post => "post"
    HttpMethod::Delete => "delete"
    HttpMethod::Options => "options"
    HttpMethod::Head => "head"
    HttpMethod::Patch => "patch"
    HttpMethod::Trace => "trace"
  }
}

///| Parameter location (`in` field).
pub enum ParamIn {
  Path
  Query
  Header
  Cookie
}

///| Compare two `ParamIn` values for equality.
pub fn param_in_eq(a : ParamIn, b : ParamIn) -> Bool {
  match (a, b) {
    (ParamIn::Path, ParamIn::Path) => true
    (ParamIn::Query, ParamIn::Query) => true
    (ParamIn::Header, ParamIn::Header) => true
    (ParamIn::Cookie, ParamIn::Cookie) => true
    _ => false
  }
}

///| Parse a parameter `in` string.
pub fn ParamIn::parse(s : String) -> Option[ParamIn] {
  if s == "path" {
    Some(ParamIn::Path)
  } else if s == "query" {
    Some(ParamIn::Query)
  } else if s == "header" {
    Some(ParamIn::Header)
  } else if s == "cookie" {
    Some(ParamIn::Cookie)
  } else {
    None
  }
}

///| Format a `ParamIn` as its OpenAPI string.
pub fn ParamIn::to_string(self : ParamIn) -> String {
  match self {
    ParamIn::Path => "path"
    ParamIn::Query => "query"
    ParamIn::Header => "header"
    ParamIn::Cookie => "cookie"
  }
}

///| Contact metadata in `info.contact`.
pub struct Contact {
  pub name : Option[String]
  pub url : Option[String]
  pub email : Option[String]
}

///| License metadata in `info.license`.
pub struct License {
  pub name : String
  pub identifier : Option[String]
  pub url : Option[String]
}

///| Document `info` object.
pub struct Info {
  pub title : String
  pub version : String
  pub summary : Option[String]
  pub description : Option[String]
  pub terms_of_service : Option[String]
  pub contact : Option[Contact]
  pub license : Option[License]
}

///| Server variable definition.
pub struct ServerVariable {
  pub default_value : String
  pub enum_values : Array[String]
  pub description : Option[String]
}

///| Document or path-level `server` entry.
pub struct Server {
  pub url : String
  pub description : Option[String]
  pub variables : Array[(String, ServerVariable)]
}

///| External documentation reference.
pub struct ExternalDocs {
  pub url : String
  pub description : Option[String]
}

///| Tag metadata.
pub struct Tag {
  pub name : String
  pub description : Option[String]
  pub external_docs : Option[ExternalDocs]
}

///| Security requirement entry (scheme name -> required scopes).
pub struct SecurityRequirement {
  pub schemes : Array[(String, Array[String])]
}

///| Media type entry inside `content`.
pub struct MediaType {
  pub schema : Option[json5::Json5Value]
}

///| Parameter object (resolved or with `ref_str`).
pub struct Parameter {
  pub name : String
  pub location : ParamIn
  pub description : Option[String]
  pub required : Bool
  pub deprecated : Bool
  pub style : Option[String]
  pub explode : Option[Bool]
  pub schema : Option[json5::Json5Value]
  pub ref_str : Option[String]
}

///| RequestBody object.
pub struct RequestBody {
  pub description : Option[String]
  pub required : Bool
  pub content : Array[(String, MediaType)]
  pub ref_str : Option[String]
}

///| Response object.
pub struct ResponseObj {
  pub description : String
  pub headers : Array[(String, Parameter)]
  pub content : Array[(String, MediaType)]
  pub ref_str : Option[String]
}

///| Operation object bound to a `(method, path)` pair.
pub struct Operation {
  pub method : HttpMethod
  pub path : String
  pub operation_id : Option[String]
  pub summary : Option[String]
  pub description : Option[String]
  pub tags : Array[String]
  pub deprecated : Bool
  pub parameters : Array[Parameter]
  pub request_body : Option[RequestBody]
  pub responses : Array[(String, ResponseObj)]
  pub security : Option[Array[SecurityRequirement]]
}

///| PathItem object containing path-level parameters and HTTP operations.
pub struct PathItem {
  pub ref_str : Option[String]
  pub summary : Option[String]
  pub description : Option[String]
  pub servers : Array[Server]
  pub parameters : Array[Parameter]
  pub operations : Array[(HttpMethod, Operation)]
  pub unknown_keys : Array[String]
}

///| Reusable `components` section (stored as raw `Json5Value` tables).
pub struct Components {
  pub schemas : Array[(String, json5::Json5Value)]
  pub responses : Array[(String, json5::Json5Value)]
  pub parameters : Array[(String, json5::Json5Value)]
  pub examples : Array[(String, json5::Json5Value)]
  pub request_bodies : Array[(String, json5::Json5Value)]
  pub headers : Array[(String, json5::Json5Value)]
  pub security_schemes : Array[(String, json5::Json5Value)]
  pub links : Array[(String, json5::Json5Value)]
  pub callbacks : Array[(String, json5::Json5Value)]
  pub path_items : Array[(String, json5::Json5Value)]
}

///| Empty `Components`.
pub fn Components::empty() -> Components {
  Components::{
    schemas: [],
    responses: [],
    parameters: [],
    examples: [],
    request_bodies: [],
    headers: [],
    security_schemes: [],
    links: [],
    callbacks: [],
    path_items: [],
  }
}

///| Parsed OpenAPI 3.0.x / 3.1.x document.
pub struct OpenApiDoc {
  pub openapi : OpenApiVersion
  pub info : Info
  pub json_schema_dialect : Option[String]
  pub servers : Array[Server]
  pub paths : Array[(String, PathItem)]
  pub webhooks : Array[(String, PathItem)]
  pub components : Components
  pub security : Array[SecurityRequirement]
  pub tags : Array[Tag]
  pub external_docs : Option[ExternalDocs]
  pub raw : json5::Json5Value
  pub limits : OpenApiLimits
  pub has_paths : Bool
  pub has_webhooks : Bool
  pub has_components : Bool
}

///| Static structural validation issue code.
pub enum IssueCode {
  MissingRequiredField
  InvalidVersion
  DuplicateOperationId
  MissingPathParameter
  InvalidPathParameter
  InvalidHttpMethod
  DanglingRef
  RefCycle
  AmbiguousPathTemplate
  InvalidPathTemplate
  DuplicateParameter
  InvalidStatusCode
  LimitExceeded
}

///| Compare two `IssueCode` values for equality.
pub fn issue_code_eq(a : IssueCode, b : IssueCode) -> Bool {
  match (a, b) {
    (IssueCode::MissingRequiredField, IssueCode::MissingRequiredField) => true
    (IssueCode::InvalidVersion, IssueCode::InvalidVersion) => true
    (IssueCode::DuplicateOperationId, IssueCode::DuplicateOperationId) => true
    (IssueCode::MissingPathParameter, IssueCode::MissingPathParameter) => true
    (IssueCode::InvalidPathParameter, IssueCode::InvalidPathParameter) => true
    (IssueCode::InvalidHttpMethod, IssueCode::InvalidHttpMethod) => true
    (IssueCode::DanglingRef, IssueCode::DanglingRef) => true
    (IssueCode::RefCycle, IssueCode::RefCycle) => true
    (IssueCode::AmbiguousPathTemplate, IssueCode::AmbiguousPathTemplate) => true
    (IssueCode::InvalidPathTemplate, IssueCode::InvalidPathTemplate) => true
    (IssueCode::DuplicateParameter, IssueCode::DuplicateParameter) => true
    (IssueCode::InvalidStatusCode, IssueCode::InvalidStatusCode) => true
    (IssueCode::LimitExceeded, IssueCode::LimitExceeded) => true
    _ => false
  }
}

///| Single static validation diagnostic.
pub struct ValidationIssue {
  pub code : IssueCode
  pub path : String
  pub message : String
}

///| Construct a `ValidationIssue`.
pub fn ValidationIssue::new(
  code : IssueCode,
  path : String,
  message : String,
) -> ValidationIssue {
  ValidationIssue::{ code: code, path: path, message: message }
}

///| Route lookup error.
pub enum RouteError {
  NotFound(String)
  MethodNotAllowed(String, Array[HttpMethod])
}

///| Matched route with extracted path parameters.
pub struct RouteMatch {
  pub path_template : String
  pub method : HttpMethod
  pub operation : Operation
  pub path_params : Array[(String, String)]
  pub route_id : Int
}

///| Get an extracted path parameter by name.
pub fn RouteMatch::param(self : RouteMatch, name : String) -> Option[String] {
  let mut i = 0
  let n = self.path_params.length()
  while i < n {
    let (k, v) = self.path_params[i]
    if k == name {
      return Some(v)
    }
    i = i + 1
  }
  None
}

///| Compiled RFC 6570 path template router.
pub struct Router {
  pub routes : Array[RouteEntry]
  pub root_node : Int
  pub nodes : Array[TrieNode]
}

///| Internal route entry stored in `Router`.
pub struct RouteEntry {
  pub route_id : Int
  pub path_template : String
  pub method : HttpMethod
  pub operation : Operation
}

///| Internal segment matcher for inline templates (e.g. `{name}.{ext}`).
pub struct InlineTemplateEdge {
  pub literals : Array[String]
  pub param_names : Array[String]
  pub child : Int
}

///| Internal radix/trie node for `Router`.
pub struct TrieNode {
  pub static_keys : Array[String]
  pub static_children : Array[Int]
  pub param_name : Option[String]
  pub param_child : Int
  pub inline_edges : Array[InlineTemplateEdge]
  pub route_methods : Array[HttpMethod]
  pub route_ids : Array[Int]
}

///| Incoming HTTP request for runtime OpenAPI validation.
pub struct HttpRequest {
  pub method : HttpMethod
  pub path : String
  pub query : Array[(String, String)]
  pub headers : Array[(String, String)]
  pub cookies : Array[(String, String)]
  pub content_type : Option[String]
  pub body : Option[String]
}

///| Construct a minimal `HttpRequest`.
pub fn HttpRequest::new(method : HttpMethod, path : String) -> HttpRequest {
  HttpRequest::{
    method: method,
    path: path,
    query: [],
    headers: [],
    cookies: [],
    content_type: None,
    body: None,
  }
}

///| Outgoing HTTP response for runtime OpenAPI validation.
pub struct HttpResponse {
  pub status : Int
  pub headers : Array[(String, String)]
  pub content_type : Option[String]
  pub body : Option[String]
}

///| Construct a minimal `HttpResponse`.
pub fn HttpResponse::new(status : Int) -> HttpResponse {
  HttpResponse::{
    status: status,
    headers: [],
    content_type: None,
    body: None,
  }
}

///| Category of a runtime request/response validation error.
pub enum RuntimeErrorKind {
  RouteNotFound
  MethodNotAllowed
  MissingParameter
  InvalidParameter
  MissingRequestBody
  UnsupportedMediaType
  InvalidJson
  SchemaViolation
  UndocumentedStatus
  MissingResponseHeader
  InvalidResponseHeader
}

///| Compare two `RuntimeErrorKind` values for equality.
pub fn runtime_error_kind_eq(a : RuntimeErrorKind, b : RuntimeErrorKind) -> Bool {
  match (a, b) {
    (RuntimeErrorKind::RouteNotFound, RuntimeErrorKind::RouteNotFound) => true
    (RuntimeErrorKind::MethodNotAllowed, RuntimeErrorKind::MethodNotAllowed) => true
    (RuntimeErrorKind::MissingParameter, RuntimeErrorKind::MissingParameter) => true
    (RuntimeErrorKind::InvalidParameter, RuntimeErrorKind::InvalidParameter) => true
    (RuntimeErrorKind::MissingRequestBody, RuntimeErrorKind::MissingRequestBody) => true
    (RuntimeErrorKind::UnsupportedMediaType, RuntimeErrorKind::UnsupportedMediaType) => true
    (RuntimeErrorKind::InvalidJson, RuntimeErrorKind::InvalidJson) => true
    (RuntimeErrorKind::SchemaViolation, RuntimeErrorKind::SchemaViolation) => true
    (RuntimeErrorKind::UndocumentedStatus, RuntimeErrorKind::UndocumentedStatus) => true
    (RuntimeErrorKind::MissingResponseHeader, RuntimeErrorKind::MissingResponseHeader) => true
    (RuntimeErrorKind::InvalidResponseHeader, RuntimeErrorKind::InvalidResponseHeader) => true
    _ => false
  }
}

///| Single runtime request/response validation failure.
pub struct RuntimeValidationError {
  pub kind : RuntimeErrorKind
  pub location : String
  pub message : String
}

///| Construct a `RuntimeValidationError`.
pub fn RuntimeValidationError::new(
  kind : RuntimeErrorKind,
  location : String,
  message : String,
) -> RuntimeValidationError {
  RuntimeValidationError::{
    kind: kind,
    location: location,
    message: message,
  }
}

///| Exported AI Agent Tool / MCP Function-Calling schema for one Operation.
pub struct ToolSchema {
  pub name : String
  pub description : String
  pub method : HttpMethod
  pub path : String
  pub input_schema : json5::Json5Value
}

///| Pre-compiled OpenAPI request/response validator.
pub struct Validator {
  pub doc : OpenApiDoc
  pub router : Router
  pub route_validators : Array[CompiledRouteValidator]
}

///| Pre-compiled schemas for one route (internal).
pub struct CompiledRouteValidator {
  pub param_schemas : Array[Option[CompiledSchemaEntry]]
  pub body_schemas : Array[(String, Option[CompiledSchemaEntry])]
  pub response_validators : Array[(String, CompiledResponseValidator)]
}

///| Pre-compiled response validator (internal).
pub struct CompiledResponseValidator {
  pub header_schemas : Array[(String, Bool, Option[CompiledSchemaEntry])]
  pub body_schemas : Array[(String, Option[CompiledSchemaEntry])]
}

///| Wrapper holding a compiled `jsonschema` schema and raw schema JSON.
pub struct CompiledSchemaEntry {
  pub raw_schema : json5::Json5Value
  pub compiled_id : Int
}

///| ASCII lowercase helper shared across modules.
fn ascii_lower_str(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}
