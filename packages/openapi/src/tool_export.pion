///| AI Agent Tool / MCP Function-Calling Schema exporter.
///| Flattens any OpenAPI Operation into a standalone JSON Schema with zero dangling `$ref`s,
///| MCP-safe tool names (`^[a-zA-Z0-9_-]{1,64}$`), and collision-free property keys.

import "json5"

fn sanitize_tool_name(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let max_n = if n > 64 { 64 } else { n }
  let mut i = 0
  while i < max_n {
    let b = s.code_unit_at(i)
    let ok =
    (b >= 48 && b <= 57) ||
    (b >= 65 && b <= 90) ||
    (b >= 97 && b <= 122) ||
    b == 95 ||
    b == 45
    if ok {
      sb.write_byte(b.to_byte())
    } else {
      sb.write_byte((95).to_byte())
    }
    i = i + 1
  }
  let res = sb.to_string()
  if res.length() == 0 {
    "tool"
  } else {
    res
  }
}

fn find_operation_by_id_impl(
  doc : OpenApiDoc,
  operation_id : String,
) -> Option[Operation] {
  let mut pi = 0
  while pi < doc.paths.length() {
    let (_, item) = doc.paths[pi]
    let mut oi = 0
    while oi < item.operations.length() {
      let (_, op) = item.operations[oi]
      match op.operation_id {
        Some(id) => {
          if id == operation_id {
            return Some(op)
          }
        }
        None => ()
      }
      oi = oi + 1
    }
    pi = pi + 1
  }
  None
}

fn add_description_if_missing(
  schema : json5::Json5Value,
  desc : Option[String],
) -> json5::Json5Value {
  match desc {
    None => schema
    Some(d) => {
      match schema {
        json5::Json5Value::Object(entries) => {
          match json5::get(schema, "description") {
            Some(_) => schema
            None => {
              let out : Array[(String, json5::Json5Value)] = []
              let mut i = 0
              while i < entries.length() {
                out.push(entries[i])
                i = i + 1
              }
              out.push(("description", json5::Json5Value::Str(d)))
              json5::Json5Value::Object(out)
            }
          }
        }
        _ => schema
      }
    }
  }
}

fn pick_unique_prop_key(base : String, used : StrHashMap) -> String {
  if !used.contains(base) {
    used.set(base, 1)
    return base
  }
  let mut suffix = 2
  while true {
    let cand = base + "_" + suffix.to_string()
    if !used.contains(cand) {
      used.set(cand, 1)
      return cand
    }
    suffix = suffix + 1
  }
  base
}

fn export_operation_tool_ctx(
  doc : OpenApiDoc,
  comp_idx : ComponentsIndex,
  node_budget : Array[Int],
  op : Operation,
) -> Result[ToolSchema, OpenApiError] {
  let raw_name = match op.operation_id {
    Some(id) => if id.length() > 0 { id } else { op.method.to_lower() + "_" + op.path }
    None => op.method.to_lower() + "_" + op.path
  }
  let name = sanitize_tool_name(raw_name)
  let desc = match op.description {
    Some(d) => d
    None => {
      match op.summary {
        Some(s) => s
        None => op.method.to_upper() + " " + op.path
      }
    }
  }

  // Detect JSON requestBody ahead of time so parameters named "body" are safely namespaced
  let mut body_schema_opt : Option[json5::Json5Value] = None
  let mut body_required = false
  let mut body_desc : Option[String] = None
  match op.request_body {
    Some(rb) => {
      match rb.ref_error {
        Some(e) => return Err(e)
        None => ()
      }
      body_required = rb.required
      body_desc = rb.description
      let mut ci = 0
      while ci < rb.content.length() {
        let (ct, mt) = rb.content[ci]
        if is_json_media_type(base_media_type(ct)) {
          body_schema_opt = mt.schema
          break
        }
        ci = ci + 1
      }
    }
    None => ()
  }

  // Count parameter name occurrences (plus "body" if JSON body present) to detect collisions
  let name_counts = StrHashMap::new()
  if body_schema_opt is Some(_) {
    name_counts.set("body", 1)
  }
  let mut pi = 0
  while pi < op.parameters.length() {
    let p = op.parameters[pi]
    let cur = name_counts.get(p.name)
    name_counts.set(p.name, if cur < 0 { 1 } else { cur + 1 })
    pi = pi + 1
  }

  let st = DerefState::new_with_view(doc, comp_idx, SchemaView::Neutral, node_budget)
  let props : Array[(String, json5::Json5Value)] = []
  let req_keys : Array[json5::Json5Value] = []
  let used_keys = StrHashMap::new()
  if body_schema_opt is Some(_) {
    // Reserve "body" for the requestBody property
    used_keys.set("body", 1)
  }

  // 1. Add all parameters as top-level properties (namespacing any colliding names)
  pi = 0
  while pi < op.parameters.length() {
    let p = op.parameters[pi]
    match p.ref_error {
      Some(e) => return Err(e)
      None => ()
    }
    let raw_s = match p.schema {
      Some(sv) => sv
      None => {
        if p.content.length() > 0 {
          let (_, mt) = p.content[0]
          match mt.schema {
            Some(cs) => cs
            None => json5::Json5Value::Object([("type", json5::Json5Value::Str("string"))])
          }
        } else {
          json5::Json5Value::Object([("type", json5::Json5Value::Str("string"))])
        }
      }
    }
    let (flat_raw, _) = match deref_schema_walk(st, raw_s, 0) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let flat_s = add_description_if_missing(flat_raw, p.description)
    let cnt = name_counts.get(p.name)
    let base_key = if cnt > 1 {
      p.location.to_string() + "_" + p.name
    } else {
      p.name
    }
    let prop_key = pick_unique_prop_key(base_key, used_keys)
    props.push((prop_key, flat_s))
    if p.required {
      req_keys.push(json5::Json5Value::Str(prop_key))
    }
    pi = pi + 1
  }

  // 2. Add JSON requestBody as `body` property
  match body_schema_opt {
    Some(bs) => {
      let (flat_raw, _) = match deref_schema_walk(st, bs, 0) {
        Ok(r) => r
        Err(e) => return Err(e)
      }
      let flat_b = add_description_if_missing(flat_raw, body_desc)
      props.push(("body", flat_b))
      if body_required {
        req_keys.push(json5::Json5Value::Str("body"))
      }
    }
    None => ()
  }

  let root_entries : Array[(String, json5::Json5Value)] = [
    ("type", json5::Json5Value::Str("object")),
    ("properties", json5::Json5Value::Object(props)),
  ]
  if req_keys.length() > 0 {
    root_entries.push(("required", json5::Json5Value::Array(req_keys)))
  }
  if st.hoisted_defs.length() > 0 {
    root_entries.push(("$defs", json5::Json5Value::Object(st.hoisted_defs)))
  }

  Ok(
    ToolSchema::{
      name: name,
      description: desc,
      method: op.method,
      path: op.path,
      input_schema: json5::Json5Value::Object(root_entries),
    },
  )
}

fn export_tool_impl(
  doc : OpenApiDoc,
  operation_id : String,
) -> Result[ToolSchema, OpenApiError] {
  match find_operation_by_id_impl(doc, operation_id) {
    Some(op) => export_operation_tool_ctx(doc, ComponentsIndex::from_root(doc.raw), [0], op)
    None => {
      Err(
        OpenApiError::new(
          OpenApiErrorKind::NotFound,
          operation_id,
          "operationId not found: " + operation_id,
        ),
      )
    }
  }
}

fn export_all_tools_impl(doc : OpenApiDoc) -> Result[Array[ToolSchema], OpenApiError] {
  let out : Array[ToolSchema] = []
  let comp_idx = ComponentsIndex::from_root(doc.raw)
  let node_budget : Array[Int] = [0]
  let mut pi = 0
  while pi < doc.paths.length() {
    let (_, item) = doc.paths[pi]
    let mut oi = 0
    while oi < item.operations.length() {
      let (_, op) = item.operations[oi]
      match export_operation_tool_ctx(doc, comp_idx, node_budget, op) {
        Ok(t) => out.push(t)
        Err(e) => return Err(e)
      }
      oi = oi + 1
    }
    pi = pi + 1
  }
  Ok(out)
}

fn tool_to_json_impl(tool : ToolSchema) -> Result[String, OpenApiError] {
  let obj = json5::Json5Value::Object([
    ("name", json5::Json5Value::Str(tool.name)),
    ("description", json5::Json5Value::Str(tool.description)),
    ("inputSchema", tool.input_schema),
  ])
  match json5::to_json_string(obj) {
    Ok(s) => Ok(s)
    Err(e) => Err(OpenApiError::new(OpenApiErrorKind::InvalidDocument, tool.name, e.message))
  }
}
