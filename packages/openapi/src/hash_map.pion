///| Fast O(1) open-addressed String -> Int hash map (FNV-1a), zero dependencies.

fn fnv1a_str(s : String) -> Int {
  let n = s.length()
  let mut h : Int = -2128831035
  let mut i = 0
  while i < n {
    h = (h ^ s.code_unit_at(i)) * 16777619
    i = i + 1
  }
  h
}

struct StrHashMap {
  keys : Array[String]
  vals : Array[Int]
  mut buckets : FixedArray[Int]
  mut mask : Int
}

fn StrHashMap::new() -> StrHashMap {
  StrHashMap::{
    keys: [],
    vals: [],
    buckets: FixedArray::make(16, -1),
    mask: 15,
  }
}

fn StrHashMap::with_capacity(cap_hint : Int) -> StrHashMap {
  let mut cap = 16
  let target = cap_hint * 2 + 2
  while cap < target {
    cap = cap * 2
  }
  StrHashMap::{
    keys: [],
    vals: [],
    buckets: FixedArray::make(cap, -1),
    mask: cap - 1,
  }
}

fn StrHashMap::grow(self : StrHashMap) -> Unit {
  let new_cap = (self.mask + 1) * 2
  let new_mask = new_cap - 1
  let new_buckets = FixedArray::make(new_cap, -1)
  let mut i = 0
  let n = self.keys.length()
  while i < n {
    let mut slot = fnv1a_str(self.keys[i]) & new_mask
    while new_buckets[slot] >= 0 {
      slot = (slot + 1) & new_mask
    }
    new_buckets[slot] = i
    i = i + 1
  }
  self.buckets = new_buckets
  self.mask = new_mask
}

fn StrHashMap::get(self : StrHashMap, key : String) -> Int {
  if self.keys.length() == 0 {
    return -1
  }
  let mut slot = fnv1a_str(key) & self.mask
  while true {
    let idx = self.buckets[slot]
    if idx < 0 {
      return -1
    }
    if self.keys[idx] == key {
      return self.vals[idx]
    }
    slot = (slot + 1) & self.mask
  }
  -1
}

fn StrHashMap::contains(self : StrHashMap, key : String) -> Bool {
  self.get(key) >= 0
}

fn StrHashMap::set(self : StrHashMap, key : String, v : Int) -> Unit {
  if (self.keys.length() + 1) * 2 > self.mask + 1 {
    self.grow()
  }
  let mut slot = fnv1a_str(key) & self.mask
  while true {
    let idx = self.buckets[slot]
    if idx < 0 {
      let new_idx = self.keys.length()
      self.keys.push(key)
      self.vals.push(v)
      self.buckets[slot] = new_idx
      return
    }
    if self.keys[idx] == key {
      self.vals[idx] = v
      return
    }
    slot = (slot + 1) & self.mask
  }
}
