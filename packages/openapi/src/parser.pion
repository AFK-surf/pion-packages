///| OpenAPI 3.0.x & 3.1.x JSON/YAML parser and typed document decoder.

import "json5"
import "yaml"

///| Convert a `yaml::YamlValue` into `json5::Json5Value` while enforcing depth & node limits.
fn yaml_to_json5(
  v : yaml::YamlValue,
  depth : Int,
  max_depth : Int,
  max_nodes : Int,
  node_count : Array[Int],
) -> Result[json5::Json5Value, OpenApiError] {
  if depth > max_depth {
    return Err(
      OpenApiError::new(
        OpenApiErrorKind::LimitExceeded,
        "#",
        "YAML nesting depth exceeded max_depth",
      ),
    )
  }
  node_count[0] = node_count[0] + 1
  if node_count[0] > max_nodes {
    return Err(
      OpenApiError::new(
        OpenApiErrorKind::LimitExceeded,
        "#",
        "YAML node count exceeded max_nodes",
      ),
    )
  }
  match v {
    yaml::YamlValue::Null => Ok(json5::Json5Value::Null)
    yaml::YamlValue::Bool(b) => Ok(json5::Json5Value::Bool(b))
    yaml::YamlValue::Int(i) => Ok(json5::Json5Value::Number(i.to_double()))
    yaml::YamlValue::Float(f) => Ok(json5::Json5Value::Number(f))
    yaml::YamlValue::Str(s) => Ok(json5::Json5Value::Str(s))
    yaml::YamlValue::Seq(items) => {
      let out : Array[json5::Json5Value] = []
      let mut i = 0
      while i < items.length() {
        match yaml_to_json5(items[i], depth + 1, max_depth, max_nodes, node_count) {
          Ok(jv) => out.push(jv)
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      Ok(json5::Json5Value::Array(out))
    }
    yaml::YamlValue::Map(entries) => {
      let out : Array[(String, json5::Json5Value)] = []
      let mut i = 0
      while i < entries.length() {
        let (k, mv) = entries[i]
        let ks = match k {
          yaml::YamlValue::Str(s) => s
          yaml::YamlValue::Int(iv) => iv.to_string()
          yaml::YamlValue::Bool(b) => if b { "true" } else { "false" }
          yaml::YamlValue::Float(fv) => fv.to_string()
          yaml::YamlValue::Null => "null"
          _ => yaml::to_canonical_json(k)
        }
        match yaml_to_json5(mv, depth + 1, max_depth, max_nodes, node_count) {
          Ok(jv) => out.push((ks, jv))
          Err(e) => return Err(e)
        }
        i = i + 1
      }
      Ok(json5::Json5Value::Object(out))
    }
  }
}

fn str_contains(haystack : String, needle : String) -> Bool {
  let hn = haystack.length()
  let nn = needle.length()
  if nn == 0 {
    return true
  }
  if nn > hn {
    return false
  }
  let mut i = 0
  while i <= hn - nn {
    let mut j = 0
    while j < nn && haystack.code_unit_at(i + j) == needle.code_unit_at(j) {
      j = j + 1
    }
    if j == nn {
      return true
    }
    i = i + 1
  }
  false
}

fn parse_nonneg_int(s : String) -> Option[Int] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    if acc > 100000000 {
      return None
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  Some(acc)
}

///| Parse and validate `openapi` semantic version (`3.0.x` or `3.1.x`).
fn parse_openapi_version(raw : String) -> Result[OpenApiVersion, OpenApiError] {
  let n = raw.length()
  let mut dot1 = -1
  let mut dot2 = -1
  let mut i = 0
  while i < n {
    if raw.code_unit_at(i) == 46 {
      if dot1 < 0 {
        dot1 = i
      } else if dot2 < 0 {
        dot2 = i
      } else {
        return Err(
          OpenApiError::new(
            OpenApiErrorKind::UnsupportedVersion,
            "#/openapi",
            "invalid OpenAPI version: " + raw,
          ),
        )
      }
    }
    i = i + 1
  }
  if dot1 < 0 || dot2 < 0 {
    return Err(
      OpenApiError::new(
        OpenApiErrorKind::UnsupportedVersion,
        "#/openapi",
        "invalid OpenAPI version (expected 3.0.x or 3.1.x): " + raw,
      ),
    )
  }
  let maj = match parse_nonneg_int(raw.slice(0, dot1)) {
    Some(x) => x
    None => {
      return Err(
        OpenApiError::new(
          OpenApiErrorKind::UnsupportedVersion,
          "#/openapi",
          "invalid OpenAPI major version: " + raw,
        ),
      )
    }
  }
  let min = match parse_nonneg_int(raw.slice(dot1 + 1, dot2)) {
    Some(x) => x
    None => {
      return Err(
        OpenApiError::new(
          OpenApiErrorKind::UnsupportedVersion,
          "#/openapi",
          "invalid OpenAPI minor version: " + raw,
        ),
      )
    }
  }
  let pat = match parse_nonneg_int(raw.slice(dot2 + 1, n)) {
    Some(x) => x
    None => {
      return Err(
        OpenApiError::new(
          OpenApiErrorKind::UnsupportedVersion,
          "#/openapi",
          "invalid OpenAPI patch version: " + raw,
        ),
      )
    }
  }
  if maj != 3 || (min != 0 && min != 1) {
    return Err(
      OpenApiError::new(
        OpenApiErrorKind::UnsupportedVersion,
        "#/openapi",
        "unsupported OpenAPI version (only 3.0.x and 3.1.x supported): " + raw,
      ),
    )
  }
  Ok(OpenApiVersion::new(maj, min, pat, raw))
}

fn opt_str_field(obj : json5::Json5Value, key : String) -> Option[String] {
  match json5::get(obj, key) {
    Some(json5::Json5Value::Str(s)) => Some(s)
    _ => None
  }
}

fn opt_bool_field(obj : json5::Json5Value, key : String) -> Option[Bool] {
  match json5::get(obj, key) {
    Some(json5::Json5Value::Bool(b)) => Some(b)
    _ => None
  }
}

fn str_array_field(obj : json5::Json5Value, key : String) -> Array[String] {
  let out : Array[String] = []
  match json5::get(obj, key) {
    Some(json5::Json5Value::Array(items)) => {
      let mut i = 0
      while i < items.length() {
        match items[i] {
          json5::Json5Value::Str(s) => out.push(s)
          _ => ()
        }
        i = i + 1
      }
    }
    _ => ()
  }
  out
}

fn decode_external_docs(v : json5::Json5Value) -> Option[ExternalDocs] {
  match opt_str_field(v, "url") {
    Some(u) => Some(ExternalDocs::{ url: u, description: opt_str_field(v, "description") })
    None => None
  }
}

fn decode_info(v : json5::Json5Value) -> Result[Info, OpenApiError] {
  match v {
    json5::Json5Value::Object(_) => ()
    _ => {
      return Err(
        OpenApiError::new(OpenApiErrorKind::InvalidDocument, "#/info", "info must be an object"),
      )
    }
  }
  let title = match opt_str_field(v, "title") {
    Some(s) => s
    None => ""
  }
  let version = match opt_str_field(v, "version") {
    Some(s) => s
    None => ""
  }
  let contact = match json5::get(v, "contact") {
    Some(cv) => {
      match cv {
        json5::Json5Value::Object(_) => {
          Some(
            Contact::{
              name: opt_str_field(cv, "name"),
              url: opt_str_field(cv, "url"),
              email: opt_str_field(cv, "email"),
            },
          )
        }
        _ => None
      }
    }
    None => None
  }
  let license = match json5::get(v, "license") {
    Some(lv) => {
      match opt_str_field(lv, "name") {
        Some(lname) => {
          Some(
            License::{
              name: lname,
              identifier: opt_str_field(lv, "identifier"),
              url: opt_str_field(lv, "url"),
            },
          )
        }
        None => None
      }
    }
    None => None
  }
  Ok(
    Info::{
      title: title,
      version: version,
      summary: opt_str_field(v, "summary"),
      description: opt_str_field(v, "description"),
      terms_of_service: opt_str_field(v, "termsOfService"),
      contact: contact,
      license: license,
    },
  )
}

fn decode_servers(v : Option[json5::Json5Value]) -> Array[Server] {
  let out : Array[Server] = []
  match v {
    Some(json5::Json5Value::Array(items)) => {
      let mut i = 0
      while i < items.length() {
        let item = items[i]
        match opt_str_field(item, "url") {
          Some(u) => {
            let vars : Array[(String, ServerVariable)] = []
            match json5::get(item, "variables") {
              Some(json5::Json5Value::Object(ventries)) => {
                let mut j = 0
                while j < ventries.length() {
                  let (vk, vv) = ventries[j]
                  let def = match opt_str_field(vv, "default") {
                    Some(d) => d
                    None => ""
                  }
                  vars.push((
                    vk,
                    ServerVariable::{
                      default_value: def,
                      enum_values: str_array_field(vv, "enum"),
                      description: opt_str_field(vv, "description"),
                    },
                  ))
                  j = j + 1
                }
              }
              _ => ()
            }
            out.push(
              Server::{
                url: u,
                description: opt_str_field(item, "description"),
                variables: vars,
              },
            )
          }
          None => ()
        }
        i = i + 1
      }
    }
    _ => ()
  }
  out
}

fn decode_security(v : Option[json5::Json5Value]) -> Array[SecurityRequirement] {
  let out : Array[SecurityRequirement] = []
  match v {
    Some(json5::Json5Value::Array(items)) => {
      let mut i = 0
      while i < items.length() {
        match items[i] {
          json5::Json5Value::Object(entries) => {
            let schemes : Array[(String, Array[String])] = []
            let mut j = 0
            while j < entries.length() {
              let (sk, sv) = entries[j]
              let scopes : Array[String] = []
              match sv {
                json5::Json5Value::Array(sitems) => {
                  let mut k = 0
                  while k < sitems.length() {
                    match sitems[k] {
                      json5::Json5Value::Str(s) => scopes.push(s)
                      _ => ()
                    }
                    k = k + 1
                  }
                }
                _ => ()
              }
              schemes.push((sk, scopes))
              j = j + 1
            }
            out.push(SecurityRequirement::{ schemes: schemes })
          }
          _ => ()
        }
        i = i + 1
      }
    }
    _ => ()
  }
  out
}

fn decode_content(v : Option[json5::Json5Value]) -> Array[(String, MediaType)] {
  let out : Array[(String, MediaType)] = []
  match v {
    Some(json5::Json5Value::Object(entries)) => {
      let mut i = 0
      while i < entries.length() {
        let (ct, mv) = entries[i]
        out.push((ct, MediaType::{ schema: json5::get(mv, "schema") }))
        i = i + 1
      }
    }
    _ => ()
  }
  out
}

fn decode_parameter(
  root : json5::Json5Value,
  raw_param : json5::Json5Value,
  is_31 : Bool,
  max_ref_depth : Int,
) -> Parameter {
  let ref_s = get_ref_str(raw_param)
  let mut ref_err : Option[OpenApiError] = None
  let resolved = match ref_s {
    Some(_) => {
      match resolve_value_raw(root, raw_param, is_31, max_ref_depth) {
        Ok(v) => v
        Err(e) => {
          ref_err = Some(e)
          raw_param
        }
      }
    }
    None => raw_param
  }
  let name = match opt_str_field(resolved, "name") {
    Some(s) => s
    None => ""
  }
  let raw_in = opt_str_field(resolved, "in")
  let loc = match raw_in {
    Some(s) => {
      match ParamIn::parse(s) {
        Some(p) => p
        None => ParamIn::Query
      }
    }
    None => ParamIn::Query
  }
  let req = match opt_bool_field(resolved, "required") {
    Some(b) => b
    None => false
  }
  let dep = match opt_bool_field(resolved, "deprecated") {
    Some(b) => b
    None => false
  }
  let aev = match opt_bool_field(resolved, "allowEmptyValue") {
    Some(b) => b
    None => false
  }
  Parameter::{
    name: name,
    location: loc,
    description: opt_str_field(resolved, "description"),
    required: req,
    deprecated: dep,
    allow_empty_value: aev,
    style: opt_str_field(resolved, "style"),
    explode: opt_bool_field(resolved, "explode"),
    schema: json5::get(resolved, "schema"),
    content: decode_content(json5::get(resolved, "content")),
    ref_str: ref_s,
    raw_in: raw_in,
    ref_error: ref_err,
  }
}

fn decode_parameters(
  root : json5::Json5Value,
  v : Option[json5::Json5Value],
  is_31 : Bool,
  max_ref_depth : Int,
) -> Array[Parameter] {
  let out : Array[Parameter] = []
  match v {
    Some(json5::Json5Value::Array(items)) => {
      let mut i = 0
      while i < items.length() {
        out.push(decode_parameter(root, items[i], is_31, max_ref_depth))
        i = i + 1
      }
    }
    _ => ()
  }
  out
}

fn decode_request_body(
  root : json5::Json5Value,
  raw_rb : json5::Json5Value,
  is_31 : Bool,
  max_ref_depth : Int,
) -> RequestBody {
  let ref_s = get_ref_str(raw_rb)
  let mut ref_err : Option[OpenApiError] = None
  let resolved = match ref_s {
    Some(_) => {
      match resolve_value_raw(root, raw_rb, is_31, max_ref_depth) {
        Ok(v) => v
        Err(e) => {
          ref_err = Some(e)
          raw_rb
        }
      }
    }
    None => raw_rb
  }
  let req = match opt_bool_field(resolved, "required") {
    Some(b) => b
    None => false
  }
  RequestBody::{
    description: opt_str_field(resolved, "description"),
    required: req,
    content: decode_content(json5::get(resolved, "content")),
    ref_str: ref_s,
    ref_error: ref_err,
  }
}

fn decode_response(
  root : json5::Json5Value,
  raw_resp : json5::Json5Value,
  is_31 : Bool,
  max_ref_depth : Int,
) -> ResponseObj {
  let ref_s = get_ref_str(raw_resp)
  let mut ref_err : Option[OpenApiError] = None
  let resolved = match ref_s {
    Some(_) => {
      match resolve_value_raw(root, raw_resp, is_31, max_ref_depth) {
        Ok(v) => v
        Err(e) => {
          ref_err = Some(e)
          raw_resp
        }
      }
    }
    None => raw_resp
  }
  let desc = match opt_str_field(resolved, "description") {
    Some(s) => s
    None => ""
  }
  let headers : Array[(String, Parameter)] = []
  match json5::get(resolved, "headers") {
    Some(json5::Json5Value::Object(hentries)) => {
      let mut i = 0
      while i < hentries.length() {
        let (hname, hraw) = hentries[i]
        let href = get_ref_str(hraw)
        let mut href_err : Option[OpenApiError] = None
        let hres = match href {
          Some(_) => {
            match resolve_value_raw(root, hraw, is_31, max_ref_depth) {
              Ok(hv) => hv
              Err(e) => {
                href_err = Some(e)
                hraw
              }
            }
          }
          None => hraw
        }
        let hreq = match opt_bool_field(hres, "required") {
          Some(b) => b
          None => false
        }
        let hdep = match opt_bool_field(hres, "deprecated") {
          Some(b) => b
          None => false
        }
        headers.push((
          hname,
          Parameter::{
            name: hname,
            location: ParamIn::Header,
            description: opt_str_field(hres, "description"),
            required: hreq,
            deprecated: hdep,
            allow_empty_value: false,
            style: opt_str_field(hres, "style"),
            explode: opt_bool_field(hres, "explode"),
            schema: json5::get(hres, "schema"),
            content: decode_content(json5::get(hres, "content")),
            ref_str: href,
            raw_in: Some("header"),
            ref_error: href_err,
          },
        ))
        i = i + 1
      }
    }
    _ => ()
  }
  ResponseObj::{
    description: desc,
    headers: headers,
    content: decode_content(json5::get(resolved, "content")),
    ref_str: ref_s,
    ref_error: ref_err,
  }
}

///| Merge path-level parameters with operation-level parameters (operation overrides path).
fn merge_parameters(
  path_params : Array[Parameter],
  op_params : Array[Parameter],
) -> Array[Parameter] {
  if path_params.length() == 0 {
    return op_params
  }
  if op_params.length() == 0 {
    return path_params
  }
  let out : Array[Parameter] = []
  let mut i = 0
  while i < path_params.length() {
    let pp = path_params[i]
    let mut overridden = false
    let mut j = 0
    while j < op_params.length() {
      let op = op_params[j]
      if op.name == pp.name && param_in_eq(op.location, pp.location) {
        overridden = true
        break
      }
      j = j + 1
    }
    if !overridden {
      out.push(pp)
    }
    i = i + 1
  }
  let mut j = 0
  while j < op_params.length() {
    out.push(op_params[j])
    j = j + 1
  }
  out
}

fn decode_operation(
  root : json5::Json5Value,
  path_key : String,
  method : HttpMethod,
  op_val : json5::Json5Value,
  path_params : Array[Parameter],
  is_31 : Bool,
  max_ref_depth : Int,
) -> Operation {
  let op_own_params = decode_parameters(root, json5::get(op_val, "parameters"), is_31, max_ref_depth)
  let eff_params = merge_parameters(path_params, op_own_params)
  let rb = match json5::get(op_val, "requestBody") {
    Some(rbv) => Some(decode_request_body(root, rbv, is_31, max_ref_depth))
    None => None
  }
  let resps : Array[(String, ResponseObj)] = []
  match json5::get(op_val, "responses") {
    Some(json5::Json5Value::Object(rentries)) => {
      let mut i = 0
      while i < rentries.length() {
        let (code, rv) = rentries[i]
        resps.push((code, decode_response(root, rv, is_31, max_ref_depth)))
        i = i + 1
      }
    }
    _ => ()
  }
  let sec = match json5::get(op_val, "security") {
    Some(sv) => Some(decode_security(Some(sv)))
    None => None
  }
  let dep = match opt_bool_field(op_val, "deprecated") {
    Some(b) => b
    None => false
  }
  Operation::{
    method: method,
    path: path_key,
    operation_id: opt_str_field(op_val, "operationId"),
    summary: opt_str_field(op_val, "summary"),
    description: opt_str_field(op_val, "description"),
    tags: str_array_field(op_val, "tags"),
    deprecated: dep,
    parameters: eff_params,
    request_body: rb,
    responses: resps,
    security: sec,
  }
}

fn is_path_item_keyword(k : String) -> Bool {
  k == "$ref" ||
  k == "summary" ||
  k == "description" ||
  k == "servers" ||
  k == "parameters" ||
  (k.length() >= 2 && k.code_unit_at(0) == 120 && k.code_unit_at(1) == 45)
}

fn decode_path_item(
  root : json5::Json5Value,
  path_key : String,
  raw_pi : json5::Json5Value,
  is_31 : Bool,
  max_ref_depth : Int,
  op_counter : Array[Int],
  max_ops : Int,
) -> Result[PathItem, OpenApiError] {
  let ref_s = get_ref_str(raw_pi)
  let resolved = match ref_s {
    Some(_) => {
      match resolve_value_raw(root, raw_pi, is_31, max_ref_depth) {
        Ok(v) => v
        Err(_) => raw_pi
      }
    }
    None => raw_pi
  }
  let path_params = decode_parameters(root, json5::get(resolved, "parameters"), is_31, max_ref_depth)
  let ops : Array[(HttpMethod, Operation)] = []
  let unknown : Array[String] = []
  match resolved {
    json5::Json5Value::Object(entries) => {
      let mut i = 0
      while i < entries.length() {
        let (k, v) = entries[i]
        match parse_openapi_method_key(k) {
          Some(m) => {
            op_counter[0] = op_counter[0] + 1
            if op_counter[0] > max_ops {
              return Err(
                OpenApiError::new(
                  OpenApiErrorKind::LimitExceeded,
                  "#/paths/" + path_key,
                  "operation count exceeded max_operations",
                ),
              )
            }
            ops.push((m, decode_operation(root, path_key, m, v, path_params, is_31, max_ref_depth)))
          }
          None => {
            if !is_path_item_keyword(k) {
              unknown.push(k)
            }
          }
        }
        i = i + 1
      }
    }
    _ => ()
  }
  Ok(
    PathItem::{
      ref_str: ref_s,
      summary: opt_str_field(resolved, "summary"),
      description: opt_str_field(resolved, "description"),
      servers: decode_servers(json5::get(resolved, "servers")),
      parameters: path_params,
      operations: ops,
      unknown_keys: unknown,
    },
  )
}

fn obj_entries_field(obj : json5::Json5Value, key : String) -> Array[(String, json5::Json5Value)] {
  match json5::get(obj, key) {
    Some(json5::Json5Value::Object(entries)) => entries
    _ => []
  }
}

fn decode_components(v : Option[json5::Json5Value]) -> Components {
  match v {
    Some(cv) => {
      Components::{
        schemas: obj_entries_field(cv, "schemas"),
        responses: obj_entries_field(cv, "responses"),
        parameters: obj_entries_field(cv, "parameters"),
        examples: obj_entries_field(cv, "examples"),
        request_bodies: obj_entries_field(cv, "requestBodies"),
        headers: obj_entries_field(cv, "headers"),
        security_schemes: obj_entries_field(cv, "securitySchemes"),
        links: obj_entries_field(cv, "links"),
        callbacks: obj_entries_field(cv, "callbacks"),
        path_items: obj_entries_field(cv, "pathItems"),
      }
    }
    None => Components::empty()
  }
}

fn decode_tags(v : Option[json5::Json5Value]) -> Array[Tag] {
  let out : Array[Tag] = []
  match v {
    Some(json5::Json5Value::Array(items)) => {
      let mut i = 0
      while i < items.length() {
        let item = items[i]
        match opt_str_field(item, "name") {
          Some(tname) => {
            let ed = match json5::get(item, "externalDocs") {
              Some(edv) => decode_external_docs(edv)
              None => None
            }
            out.push(
              Tag::{
                name: tname,
                description: opt_str_field(item, "description"),
                external_docs: ed,
              },
            )
          }
          None => ()
        }
        i = i + 1
      }
    }
    _ => ()
  }
  out
}

fn from_value_with_limits_impl(
  root : json5::Json5Value,
  limits : OpenApiLimits,
) -> Result[OpenApiDoc, OpenApiError] {
  match root {
    json5::Json5Value::Object(_) => ()
    _ => {
      return Err(
        OpenApiError::new(
          OpenApiErrorKind::InvalidDocument,
          "#",
          "OpenAPI document root must be an object",
        ),
      )
    }
  }
  let version_str = match opt_str_field(root, "openapi") {
    Some(s) => s
    None => {
      return Err(
        OpenApiError::new(
          OpenApiErrorKind::InvalidDocument,
          "#/openapi",
          "missing required 'openapi' version field",
        ),
      )
    }
  }
  let ver = match parse_openapi_version(version_str) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let info = match json5::get(root, "info") {
    Some(iv) => {
      match decode_info(iv) {
        Ok(inf) => inf
        Err(e) => return Err(e)
      }
    }
    None => {
      return Err(
        OpenApiError::new(
          OpenApiErrorKind::InvalidDocument,
          "#/info",
          "missing required 'info' object",
        ),
      )
    }
  }
  let is_31 = ver.is_31()
  let max_rd = clamp_safe_depth(limits.max_ref_depth)
  let max_paths = if limits.max_paths <= 0 { 10000 } else { limits.max_paths }
  let max_ops = if limits.max_operations <= 0 { 50000 } else { limits.max_operations }
  let op_counter : Array[Int] = [0]

  let paths : Array[(String, PathItem)] = []
  let mut has_paths = false
  match json5::get(root, "paths") {
    Some(json5::Json5Value::Object(pentries)) => {
      has_paths = true
      if pentries.length() > max_paths {
        return Err(
          OpenApiError::new(
            OpenApiErrorKind::LimitExceeded,
            "#/paths",
            "paths count exceeded max_paths",
          ),
        )
      }
      let mut i = 0
      while i < pentries.length() {
        let (pk, pv) = pentries[i]
        match decode_path_item(root, pk, pv, is_31, max_rd, op_counter, max_ops) {
          Ok(pi) => paths.push((pk, pi))
          Err(e) => return Err(e)
        }
        i = i + 1
      }
    }
    _ => ()
  }

  let webhooks : Array[(String, PathItem)] = []
  let mut has_webhooks = false
  match json5::get(root, "webhooks") {
    Some(json5::Json5Value::Object(wentries)) => {
      has_webhooks = true
      let mut i = 0
      while i < wentries.length() {
        let (wk, wv) = wentries[i]
        match decode_path_item(root, wk, wv, is_31, max_rd, op_counter, max_ops) {
          Ok(pi) => webhooks.push((wk, pi))
          Err(e) => return Err(e)
        }
        i = i + 1
      }
    }
    _ => ()
  }

  let comp_opt = json5::get(root, "components")
  let has_components = match comp_opt {
    Some(json5::Json5Value::Object(_)) => true
    _ => false
  }
  let components = decode_components(comp_opt)
  let ext_docs = match json5::get(root, "externalDocs") {
    Some(edv) => decode_external_docs(edv)
    None => None
  }

  Ok(
    OpenApiDoc::{
      openapi: ver,
      info: info,
      json_schema_dialect: opt_str_field(root, "jsonSchemaDialect"),
      servers: decode_servers(json5::get(root, "servers")),
      paths: paths,
      webhooks: webhooks,
      components: components,
      security: decode_security(json5::get(root, "security")),
      tags: decode_tags(json5::get(root, "tags")),
      external_docs: ext_docs,
      raw: root,
      limits: limits,
      has_paths: has_paths,
      has_webhooks: has_webhooks,
      has_components: has_components,
    },
  )
}

fn parse_json_with_limits_impl(
  src : String,
  limits : OpenApiLimits,
) -> Result[OpenApiDoc, OpenApiError] {
  let safe_d = clamp_safe_depth(limits.max_depth)
  let max_n = if limits.max_nodes <= 0 { 200000 } else { limits.max_nodes }
  let opts = json5::ParseOptions::{
    max_depth: safe_d,
    max_nodes: max_n,
    duplicate_keys: json5::DuplicateKeyPolicy::LastWins,
    allow_json5: false,
    allow_comments: false,
    allow_trailing_commas: false,
    reject_overflow: true,
  }
  match json5::parse_with_options(src, opts) {
    Ok(v) => from_value_with_limits_impl(v, limits)
    Err(e) => {
      let kind = if str_contains(e.message, "depth") || str_contains(e.message, "limit") || str_contains(e.message, "nodes") {
        OpenApiErrorKind::LimitExceeded
      } else {
        OpenApiErrorKind::ParseError
      }
      Err(OpenApiError::new(kind, "#", e.message))
    }
  }
}

fn parse_yaml_with_limits_impl(
  src : String,
  limits : OpenApiLimits,
) -> Result[OpenApiDoc, OpenApiError] {
  let yv = match yaml::parse(src) {
    Ok(v) => v
    Err(e) => {
      return Err(
        OpenApiError::new(
          OpenApiErrorKind::ParseError,
          "#",
          "YAML error at line " + e.line.to_string() + ":" + e.col.to_string() + ": " + e.message,
        ),
      )
    }
  }
  let safe_d = clamp_safe_depth(limits.max_depth)
  let max_n = if limits.max_nodes <= 0 { 200000 } else { limits.max_nodes }
  let counter : Array[Int] = [0]
  let jv = match yaml_to_json5(yv, 0, safe_d, max_n, counter) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  from_value_with_limits_impl(jv, limits)
}

fn looks_like_json_object(src : String) -> Bool {
  let n = src.length()
  let mut i = 0
  // Skip UTF-8 BOM if present
  if n >= 3 && src.code_unit_at(0) == 239 && src.code_unit_at(1) == 187 && src.code_unit_at(2) == 191 {
    i = 3
  }
  while i < n {
    let b = src.code_unit_at(i)
    if b == 32 || b == 9 || b == 10 || b == 13 {
      i = i + 1
    } else {
      return b == 123
    }
  }
  false
}

fn parse_with_limits_impl(
  src : String,
  limits : OpenApiLimits,
) -> Result[OpenApiDoc, OpenApiError] {
  if looks_like_json_object(src) {
    parse_json_with_limits_impl(src, limits)
  } else {
    parse_yaml_with_limits_impl(src, limits)
  }
}
