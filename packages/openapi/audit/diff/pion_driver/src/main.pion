///| Differential driver for `packages/openapi` (red-team audit), mirroring `diff/go_oracle`.
///| Usage: openapi_audit_driver <cases.jsonl>
///| Output per case: id \t load=ok|err \t valid=ok|err \t op results joined by '|'
///|   route: op:<operationId>[,k=v...] | 404 | 405 ; req/resp: ok | err (R<route> when routing failed)

import "openapi"
import "json5"

fn split_lines(src : String) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if src.code_unit_at(i) == 10 {
      if i > start {
        out.push(src.slice(start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(src.slice(start, n))
  }
  out
}

fn line_opts() -> json5::ParseOptions {
  json5::ParseOptions::{
    max_depth: 512,
    max_nodes: 100000000,
    duplicate_keys: json5::DuplicateKeyPolicy::LastWins,
    allow_json5: false,
    allow_comments: false,
    allow_trailing_commas: false,
    reject_overflow: true,
  }
}

fn str_field(v : json5::Json5Value, k : String) -> Option[String] {
  match json5::get(v, k) {
    Some(json5::Json5Value::Str(s)) => Some(s)
    _ => None
  }
}

fn int_field(v : json5::Json5Value, k : String) -> Int {
  match json5::get(v, k) {
    Some(json5::Json5Value::Number(x)) => x.to_int()
    _ => 0
  }
}

fn pairs_field(v : json5::Json5Value, k : String) -> Array[(String, String)] {
  let out : Array[(String, String)] = []
  match json5::get(v, k) {
    Some(json5::Json5Value::Array(items)) => {
      let mut i = 0
      while i < items.length() {
        match items[i] {
          json5::Json5Value::Array(kv) => {
            if kv.length() == 2 {
              match (kv[0], kv[1]) {
                (json5::Json5Value::Str(a), json5::Json5Value::Str(b)) => out.push((a, b))
                _ => ()
              }
            }
          }
          _ => ()
        }
        i = i + 1
      }
    }
    _ => ()
  }
  out
}

fn route_str(m : openapi::RouteMatch) -> String {
  let ps : Array[(String, String)] = []
  let mut i = 0
  while i < m.path_params.length() {
    ps.push(m.path_params[i])
    i = i + 1
  }
  // insertion sort by key (byte order, like Go sort.Strings for ASCII keys)
  i = 1
  while i < ps.length() {
    let mut j = i
    while j > 0 {
      let (ka, _) = ps[j - 1]
      let (kb, _) = ps[j]
      if ka > kb {
        let t = ps[j - 1]
        ps[j - 1] = ps[j]
        ps[j] = t
        j = j - 1
      } else {
        break
      }
    }
    i = i + 1
  }
  let sb = StringBuilder::new()
  sb.write_string("op:")
  match m.operation.operation_id {
    Some(id) => sb.write_string(id)
    None => ()
  }
  i = 0
  while i < ps.length() {
    let (k, v) = ps[i]
    sb.write_string(",")
    sb.write_string(k)
    sb.write_string("=")
    sb.write_string(v)
    i = i + 1
  }
  sb.to_string()
}

fn run_case(case : json5::Json5Value) -> String {
  let id = match str_field(case, "id") {
    Some(s) => s
    None => "?"
  }
  let spec = match str_field(case, "spec") {
    Some(s) => s
    None => ""
  }
  let doc = match openapi::parse(spec) {
    Ok(d) => d
    Err(_) => return id + "\tload=err\tvalid=-\t-"
  }
  let valid = if doc.validate().length() == 0 { "ok" } else { "err" }
  let router = doc.build_router()
  let validator : Option[openapi::Validator] = match openapi::Validator::from_doc(doc) {
    Ok(v) => Some(v)
    Err(_) => None
  }
  let res : Array[String] = []
  match json5::get(case, "ops") {
    Some(json5::Json5Value::Array(ops)) => {
      let mut oi = 0
      while oi < ops.length() {
        let o = ops[oi]
        let k = match str_field(o, "k") {
          Some(s) => s
          None => "route"
        }
        let mstr = match str_field(o, "m") {
          Some(s) => s
          None => "GET"
        }
        let path = match str_field(o, "p") {
          Some(s) => s
          None => "/"
        }
        match openapi::HttpMethod::parse(mstr) {
          None => res.push("badmethod")
          Some(method) => {
            let rs = match router.find(method, path) {
              Ok(m) => route_str(m)
              Err(openapi::RouteError::NotFound(_)) => "404"
              Err(openapi::RouteError::MethodNotAllowed(_, _)) => "405"
            }
            if k == "route" {
              res.push(rs)
            } else if rs.length() < 3 || rs.slice(0, 3) != "op:" {
              res.push("R" + rs)
            } else {
              match validator {
                None => res.push("verr")
                Some(v) => {
                  let req = openapi::HttpRequest::{
                    method: method,
                    path: path,
                    query: pairs_field(o, "q"),
                    headers: pairs_field(o, "h"),
                    cookies: pairs_field(o, "c"),
                    content_type: str_field(o, "ct"),
                    body: str_field(o, "b"),
                  }
                  if k == "req" {
                    res.push(if v.validate_request(req).length() == 0 { "ok" } else { "err" })
                  } else {
                    let resp = openapi::HttpResponse::{
                      status: int_field(o, "st"),
                      headers: pairs_field(o, "rh"),
                      content_type: str_field(o, "rct"),
                      body: str_field(o, "rb"),
                    }
                    res.push(
                      if v.validate_response(method, path, resp).length() == 0 {
                        "ok"
                      } else {
                        "err"
                      },
                    )
                  }
                }
              }
            }
          }
        }
        oi = oi + 1
      }
    }
    _ => ()
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < res.length() {
    if i > 0 {
      sb.write_string("|")
    }
    sb.write_string(res[i])
    i = i + 1
  }
  id + "\tload=ok\tvalid=" + valid + "\t" + sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: openapi_audit_driver <cases.jsonl>")
    return 2
  }
  let src = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: cannot read cases")
      return 2
    }
  }
  let lines = split_lines(src)
  let mut li = 0
  while li < lines.length() {
    match json5::parse_with_options(lines[li], line_opts()) {
      Ok(c) => io_println(world, run_case(c))
      Err(e) => io_println(world, "line" + li.to_string() + "\tbadcase " + e.message)
    }
    li = li + 1
  }
  0
}
