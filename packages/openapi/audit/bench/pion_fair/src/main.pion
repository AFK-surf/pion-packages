///| Fairness variant of bench/pion_bench (copied verbatim + mode `w1full` = W1 plus `Validator::from_doc`).
///| Head-to-head benchmark driver for `packages/openapi` vs Go `github.com/getkin/kin-openapi`.

import "openapi"

fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn fnv1a_str(seed : Int64, s : String) -> Int64 {
  let mut h = seed
  let n = s.length()
  let mut i = 0
  while i < n {
    h = ((h ^ s.code_unit_at(i).to_int64()) * 16777619L) & 0xFFFFFFFFL
    i = i + 1
  }
  h
}

fn hex32(v : Int64) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut shift = 28
  while shift >= 0 {
    let nib = ((v >> shift.to_int64()) & 15L).to_int()
    sb.write_byte(digits.code_unit_at(nib).to_byte())
    shift = shift - 4
  }
  sb.to_string()
}

///| Deterministically generate a large realistic OpenAPI 3.0.3 JSON spec:
///| `num_resources` resources * 5 operations = 250 operations across 150 paths,
///| with dense `#/components/schemas/...`, `#/components/parameters/...`, and `#/components/responses/...` `$ref`s.
fn build_large_openapi_spec(num_resources : Int) -> String {
  let sb = StringBuilder::new()
  sb.write_string("{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Cloud Platform API\",\"version\":\"2.1.0\"},\"paths\":{")
  let mut i = 0
  while i < num_resources {
    if i > 0 {
      sb.write_string(",")
    }
    let idx = i.to_string()
    // 1. /v1/res{i} (GET + POST)
    sb.write_string("\"/v1/res")
    sb.write_string(idx)
    sb.write_string("\":{")
    sb.write_string("\"get\":{\"operationId\":\"listRes")
    sb.write_string(idx)
    sb.write_string("\",\"parameters\":[{\"$ref\":\"#/components/parameters/PageLimit\"},{\"$ref\":\"#/components/parameters/ApiKeyHeader\"}],\"responses\":{\"200\":{\"description\":\"ok\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/components/schemas/Item")
    sb.write_string(idx)
    sb.write_string("\"}}}}},\"default\":{\"$ref\":\"#/components/responses/ApiError\"}}},")
    sb.write_string("\"post\":{\"operationId\":\"createRes")
    sb.write_string(idx)
    sb.write_string("\",\"parameters\":[{\"$ref\":\"#/components/parameters/PageLimit\"},{\"$ref\":\"#/components/parameters/ApiKeyHeader\"}],\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/CreateItem")
    sb.write_string(idx)
    sb.write_string("\"}}}},\"responses\":{\"201\":{\"description\":\"created\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/Item")
    sb.write_string(idx)
    sb.write_string("\"}}}},\"default\":{\"$ref\":\"#/components/responses/ApiError\"}}}")
    sb.write_string("},")

    // 2. /v1/res{i}/featured (GET - static priority over /{id})
    sb.write_string("\"/v1/res")
    sb.write_string(idx)
    sb.write_string("/featured\":{\"get\":{\"operationId\":\"featuredRes")
    sb.write_string(idx)
    sb.write_string("\",\"responses\":{\"200\":{\"description\":\"featured\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/Item")
    sb.write_string(idx)
    sb.write_string("\"}}}}}}},")

    // 3. /v1/res{i}/{id} (GET + DELETE)
    sb.write_string("\"/v1/res")
    sb.write_string(idx)
    sb.write_string("/{id}\":{\"parameters\":[{\"name\":\"id\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"integer\",\"minimum\":1}}],")
    sb.write_string("\"get\":{\"operationId\":\"getRes")
    sb.write_string(idx)
    sb.write_string("\",\"parameters\":[{\"$ref\":\"#/components/parameters/PageLimit\"},{\"$ref\":\"#/components/parameters/ApiKeyHeader\"}],\"responses\":{\"200\":{\"description\":\"item\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/Item")
    sb.write_string(idx)
    sb.write_string("\"}}}},\"default\":{\"$ref\":\"#/components/responses/ApiError\"}}},")
    sb.write_string("\"delete\":{\"operationId\":\"deleteRes")
    sb.write_string(idx)
    sb.write_string("\",\"responses\":{\"204\":{\"description\":\"deleted\"}}}}")

    i = i + 1
  }
  sb.write_string("},\"components\":{")
  sb.write_string("\"parameters\":{")
  sb.write_string("\"PageLimit\":{\"name\":\"limit\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":100}},")
  sb.write_string("\"ApiKeyHeader\":{\"name\":\"X-Api-Key\",\"in\":\"header\",\"required\":true,\"schema\":{\"type\":\"string\",\"minLength\":8}}")
  sb.write_string("},\"responses\":{")
  sb.write_string("\"ApiError\":{\"description\":\"error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/Error\"}}}}")
  sb.write_string("},\"schemas\":{")
  sb.write_string("\"Error\":{\"type\":\"object\",\"required\":[\"code\",\"message\"],\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}}}")
  i = 0
  while i < num_resources {
    let idx = i.to_string()
    sb.write_string(",\"Item")
    sb.write_string(idx)
    sb.write_string("\":{\"type\":\"object\",\"required\":[\"id\",\"name\",\"count\"],\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":1},\"name\":{\"type\":\"string\",\"minLength\":1},\"count\":{\"type\":\"integer\",\"minimum\":1},\"tag\":{\"type\":\"string\"}}}")
    sb.write_string(",\"CreateItem")
    sb.write_string(idx)
    sb.write_string("\":{\"type\":\"object\",\"required\":[\"name\",\"count\"],\"properties\":{\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":64},\"count\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":10000},\"tag\":{\"type\":\"string\"}}}")
    i = i + 1
  }
  sb.write_string("}}}")
  sb.to_string()
}

let FULL : Array[Bool] = [false]

fn run_w1(iters : Int) -> String {
  let spec = build_large_openapi_spec(50)
  let mut valid_count = 0
  let mut paths_cnt = 0
  let mut ops_cnt = 0
  let mut h : Int64 = 2166136261L
  let mut it = 0
  while it < iters {
    match openapi::parse_json(spec) {
      Ok(doc) => {
        let issues = doc.validate()
        let full_ok = if FULL[0] {
          match openapi::Validator::from_doc(doc) {
            Ok(_) => true
            Err(_) => false
          }
        } else {
          true
        }
        if issues.length() == 0 && full_ok {
          valid_count = valid_count + 1
        }
        paths_cnt = doc.paths.length()
        let mut ops = 0
        let mut pi = 0
        while pi < doc.paths.length() {
          let (_, item) = doc.paths[pi]
          ops = ops + item.operations.length()
          pi = pi + 1
        }
        ops_cnt = ops
        h = fnv1a_str(h, doc.info.title)
        h = ((h ^ ops.to_int64()) * 16777619L) & 0xFFFFFFFFL
      }
      Err(e) => return "W1 ERROR: " + e.message
    }
    it = it + 1
  }
  "W1 iters=" +
  iters.to_string() +
  " paths=" +
  paths_cnt.to_string() +
  " ops=" +
  ops_cnt.to_string() +
  " valid=" +
  valid_count.to_string() +
  " hash=" +
  hex32(h)
}

fn run_w2(ops : Int) -> String {
  let spec = build_large_openapi_spec(50)
  let doc = match openapi::parse_json(spec) {
    Ok(d) => d
    Err(e) => return "W2 PARSE ERROR: " + e.message
  }
  let router = doc.build_router()
  let mut matched = 0
  let mut not_found = 0
  let mut h : Int64 = 2166136261L
  let mut i = 0
  while i < ops {
    let r = i % 50
    let kind = i % 5
    let rs = r.to_string()
    let id_s = (i + 1).to_string()
    let res = if kind == 0 {
      router.find(openapi::HttpMethod::Get, "/v1/res" + rs + "/featured")
    } else if kind == 1 {
      router.find(openapi::HttpMethod::Get, "/v1/res" + rs + "/" + id_s)
    } else if kind == 2 {
      router.find(openapi::HttpMethod::Post, "/v1/res" + rs)
    } else if kind == 3 {
      router.find(openapi::HttpMethod::Delete, "/v1/res" + rs + "/" + id_s)
    } else {
      router.find(openapi::HttpMethod::Get, "/v1/unknown/" + id_s)
    }
    match res {
      Ok(m) => {
        matched = matched + 1
        match m.operation.operation_id {
          Some(oid) => h = fnv1a_str(h, oid)
          None => ()
        }
        match m.param("id") {
          Some(pv) => h = fnv1a_str(h, pv)
          None => ()
        }
      }
      Err(_) => {
        not_found = not_found + 1
        h = fnv1a_str(h, "404")
      }
    }
    i = i + 1
  }
  "W2 ops=" +
  ops.to_string() +
  " matched=" +
  matched.to_string() +
  " not_found=" +
  not_found.to_string() +
  " hash=" +
  hex32(h)
}

fn run_w3(ops : Int) -> String {
  let spec = build_large_openapi_spec(50)
  let doc = match openapi::parse_json(spec) {
    Ok(d) => d
    Err(e) => return "W3 PARSE ERROR: " + e.message
  }
  let validator = match openapi::Validator::from_doc(doc) {
    Ok(v) => v
    Err(e) => return "W3 VALIDATOR ERROR: " + e.message
  }
  let mut passed = 0
  let mut failed = 0
  let mut h : Int64 = 2166136261L
  let mut i = 0
  while i < ops {
    let r = i % 50
    let rs = r.to_string()
    let kind = i % 4
    let req = if kind == 0 {
      // Valid POST with query, header, and JSON body
      openapi::HttpRequest::{
        method: openapi::HttpMethod::Post,
        path: "/v1/res" + rs,
        query: [("limit", "25")],
        headers: [("X-Api-Key", "key-12345678")],
        cookies: [],
        content_type: Some("application/json"),
        body: Some("{\"name\":\"item-" + i.to_string() + "\",\"count\":10,\"tag\":\"alpha\"}"),
      }
    } else if kind == 1 {
      // Invalid POST: missing required X-Api-Key header
      openapi::HttpRequest::{
        method: openapi::HttpMethod::Post,
        path: "/v1/res" + rs,
        query: [("limit", "25")],
        headers: [],
        cookies: [],
        content_type: Some("application/json"),
        body: Some("{\"name\":\"item\",\"count\":10}"),
      }
    } else if kind == 2 {
      // Invalid POST: schema violation (empty name + negative count)
      openapi::HttpRequest::{
        method: openapi::HttpMethod::Post,
        path: "/v1/res" + rs,
        query: [],
        headers: [("X-Api-Key", "key-12345678")],
        cookies: [],
        content_type: Some("application/json"),
        body: Some("{\"name\":\"\",\"count\":-5}"),
      }
    } else {
      // Valid GET with integer path param + query + header
      openapi::HttpRequest::{
        method: openapi::HttpMethod::Get,
        path: "/v1/res" + rs + "/" + (i + 1).to_string(),
        query: [("limit", "10")],
        headers: [("X-Api-Key", "key-12345678")],
        cookies: [],
        content_type: None,
        body: None,
      }
    }
    let errs = validator.validate_request(req)
    if errs.length() == 0 {
      passed = passed + 1
      h = fnv1a_str(h, "1")
    } else {
      failed = failed + 1
      h = fnv1a_str(h, "0")
    }
    i = i + 1
  }
  "W3 ops=" +
  ops.to_string() +
  " passed=" +
  passed.to_string() +
  " failed=" +
  failed.to_string() +
  " hash=" +
  hex32(h)
}

///|
pub fn main(world : World) -> Int {
  let argv = args_get(world)
  let argc = argv.length()
  let mode = if argc >= 2 { argv[1] } else { "w1" }
  if mode == "w1full" {
    FULL[0] = true
    io_println(world, run_w1(10))
  } else if mode == "w1" {
    let iters = if argc >= 3 { parse_int_arg(argv[2], 10) } else { 10 }
    io_println(world, run_w1(iters))
  } else if mode == "w2" {
    let ops = if argc >= 3 { parse_int_arg(argv[2], 50000) } else { 50000 }
    io_println(world, run_w2(ops))
  } else if mode == "w3" {
    let ops = if argc >= 3 { parse_int_arg(argv[2], 10000) } else { 10000 }
    io_println(world, run_w3(ops))
  } else {
    io_println(world, "unknown mode: " + mode)
    return 1
  }
  0
}
