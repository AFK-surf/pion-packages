///| DoS probe driver for `packages/openapi` (red-team audit), default `OpenApiLimits` everywhere.
///| Usage: openapi_audit_dos <stage> <spec-file> [operationId] [request-path]
///|   stage: parse | validate | from_doc | export | export_all | route
///| Runs every stage up to and including <stage>; prints `stage\tOK|ERR:<kind>\tdetail`.

import "openapi"
import "json5"

fn kind_name(k : openapi::OpenApiErrorKind) -> String {
  match k {
    openapi::OpenApiErrorKind::ParseError => "ParseError"
    openapi::OpenApiErrorKind::UnsupportedVersion => "UnsupportedVersion"
    openapi::OpenApiErrorKind::InvalidDocument => "InvalidDocument"
    openapi::OpenApiErrorKind::UnresolvedRef => "UnresolvedRef"
    openapi::OpenApiErrorKind::RefCycle => "RefCycle"
    openapi::OpenApiErrorKind::InvalidPointer => "InvalidPointer"
    openapi::OpenApiErrorKind::LimitExceeded => "LimitExceeded"
    openapi::OpenApiErrorKind::NotFound => "NotFound"
    openapi::OpenApiErrorKind::SchemaError => "SchemaError"
  }
}

fn count_nodes(v : json5::Json5Value) -> Int {
  match v {
    json5::Json5Value::Object(es) => {
      let mut n = 1
      let mut i = 0
      while i < es.length() {
        let (_, sv) = es[i]
        n = n + count_nodes(sv)
        i = i + 1
      }
      n
    }
    json5::Json5Value::Array(items) => {
      let mut n = 1
      let mut i = 0
      while i < items.length() {
        n = n + count_nodes(items[i])
        i = i + 1
      }
      n
    }
    _ => 1
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: openapi_audit_dos <stage> <spec-file> [operationId] [path]")
    return 2
  }
  let stage = args[1]
  let src = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: cannot read spec")
      return 2
    }
  }
  let op_id = if args.length() >= 4 { args[3] } else { "op0" }
  let doc = match openapi::parse(src) {
    Ok(d) => d
    Err(e) => {
      io_println(world, "parse\tERR:" + kind_name(e.kind) + "\t" + e.message)
      return 0
    }
  }
  if stage == "parse" {
    io_println(world, "parse\tOK\tpaths=" + doc.paths.length().to_string())
    return 0
  }
  if stage == "validate" {
    let issues = doc.validate()
    io_println(world, "validate\tOK\tissues=" + issues.length().to_string())
    return 0
  }
  if stage == "from_doc" {
    match openapi::Validator::from_doc(doc) {
      Ok(v) => {
        let mut total = 0
        let mut i = 0
        while i < v.route_validators.length() {
          let rv = v.route_validators[i]
          let mut j = 0
          while j < rv.body_schemas.length() {
            let (_, e) = rv.body_schemas[j]
            match e {
              Some(entry) => total = total + count_nodes(entry.raw_schema)
              None => ()
            }
            j = j + 1
          }
          i = i + 1
        }
        io_println(world, "from_doc\tOK\tschemas=" + v.compiled_schemas.length().to_string() + " body_nodes=" + total.to_string())
      }
      Err(e) => io_println(world, "from_doc\tERR:" + kind_name(e.kind) + "\t" + e.message)
    }
    return 0
  }
  if stage == "export" {
    match doc.export_tool(op_id) {
      Ok(t) => {
        match t.to_json() {
          Ok(js) => io_println(world, "export\tOK\tjson_bytes=" + js.length().to_string() + " nodes=" + count_nodes(t.input_schema).to_string())
          Err(e) => io_println(world, "export\tERR:" + kind_name(e.kind) + "\t" + e.message)
        }
      }
      Err(e) => io_println(world, "export\tERR:" + kind_name(e.kind) + "\t" + e.message)
    }
    return 0
  }
  if stage == "export_all" {
    match doc.export_all_tools() {
      Ok(ts) => {
        let mut n = 0
        let mut i = 0
        while i < ts.length() {
          n = n + count_nodes(ts[i].input_schema)
          i = i + 1
        }
        io_println(world, "export_all\tOK\ttools=" + ts.length().to_string() + " nodes=" + n.to_string())
      }
      Err(e) => io_println(world, "export_all\tERR:" + kind_name(e.kind) + "\t" + e.message)
    }
    return 0
  }
  if stage == "route" {
    let path = if args.length() >= 5 { args[4] } else { "/" }
    let r = doc.build_router()
    let mut hits = 0
    let mut i = 0
    while i < 1000 {
      match r.find(openapi::HttpMethod::Get, path) {
        Ok(_) => hits = hits + 1
        Err(_) => ()
      }
      i = i + 1
    }
    io_println(world, "route\tOK\thits=" + hits.to_string())
    return 0
  }
  io_println(world, "unknown stage " + stage)
  2
}
