///| Wasm32 + Native 4-mode smoke entry for `packages/openapi`.

import "openapi"
import "json5"
import "jsonschema"

///|
pub fn smoke() -> Int {
  // 1. Parse OpenAPI 3.0.3 JSON + static validate + $ref resolution
  let spec30 =
  "{\n" +
  "  \"openapi\": \"3.0.3\",\n" +
  "  \"info\": { \"title\": \"Smoke API\", \"version\": \"1.0.0\" },\n" +
  "  \"paths\": {\n" +
  "    \"/users/{id}\": {\n" +
  "      \"get\": {\n" +
  "        \"operationId\": \"getUser\",\n" +
  "        \"parameters\": [\n" +
  "          { \"name\": \"id\", \"in\": \"path\", \"required\": true, \"schema\": { \"type\": \"integer\", \"minimum\": 1 } },\n" +
  "          { \"name\": \"fields\", \"in\": \"query\", \"style\": \"form\", \"explode\": false, \"schema\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } } }\n" +
  "        ],\n" +
  "        \"responses\": {\n" +
  "          \"200\": { \"description\": \"ok\", \"content\": { \"application/json\": { \"schema\": { \"$ref\": \"#/components/schemas/User\" } } } },\n" +
  "          \"4XX\": { \"description\": \"err\" }\n" +
  "        }\n" +
  "      },\n" +
  "      \"post\": {\n" +
  "        \"operationId\": \"updateUser\",\n" +
  "        \"parameters\": [{ \"name\": \"id\", \"in\": \"path\", \"required\": true, \"schema\": { \"type\": \"integer\", \"minimum\": 1 } }],\n" +
  "        \"requestBody\": { \"required\": true, \"content\": { \"application/json\": { \"schema\": { \"$ref\": \"#/components/schemas/User\" } } } },\n" +
  "        \"responses\": { \"200\": { \"description\": \"updated\" } }\n" +
  "      }\n" +
  "    },\n" +
  "    \"/users/me\": {\n" +
  "      \"get\": {\n" +
  "        \"operationId\": \"getMe\",\n" +
  "        \"responses\": { \"200\": { \"description\": \"me\" } }\n" +
  "      }\n" +
  "    }\n" +
  "  },\n" +
  "  \"components\": {\n" +
  "    \"schemas\": {\n" +
  "      \"User\": {\n" +
  "        \"type\": \"object\",\n" +
  "        \"required\": [\"name\"],\n" +
  "        \"properties\": {\n" +
  "          \"name\": { \"type\": \"string\", \"minLength\": 1 },\n" +
  "          \"bio\": { \"type\": \"string\", \"nullable\": true }\n" +
  "        }\n" +
  "      }\n" +
  "    }\n" +
  "  }\n" +
  "}"
  let doc30 = match openapi::parse_json(spec30) {
    Ok(d) => d
    Err(_) => return -1
  }
  if doc30.validate().length() != 0 {
    return -2
  }

  // 2. OpenAPI 3.1.0 YAML + webhooks + sibling summary/description
  let spec31 =
  "openapi: 3.1.0\n" +
  "info:\n" +
  "  title: YAML API\n" +
  "  version: '2.0'\n" +
  "webhooks:\n" +
  "  ping:\n" +
  "    post:\n" +
  "      operationId: onPing\n" +
  "      responses:\n" +
  "        '200':\n" +
  "          description: pong\n" +
  "components:\n" +
  "  schemas:\n" +
  "    Node:\n" +
  "      type: object\n" +
  "      required: [id]\n" +
  "      properties:\n" +
  "        id:\n" +
  "          type: string\n" +
  "        next:\n" +
  "          $ref: '#/components/schemas/Node'\n"
  let doc31 = match openapi::parse_yaml(spec31) {
    Ok(d) => d
    Err(_) => return -3
  }
  if !doc31.openapi.is_31() || doc31.webhooks.length() != 1 || doc31.validate().length() != 0 {
    return -4
  }

  // 3. RFC 6570 routing (static priority + param extraction + typed coercion)
  let router = doc30.build_router()
  match router.find(openapi::HttpMethod::Get, "/users/me") {
    Ok(m) => {
      if m.path_template != "/users/me" {
        return -5
      }
    }
    Err(_) => return -6
  }
  match router.find(openapi::HttpMethod::Get, "/users/42") {
    Ok(m) => {
      match m.typed_path_params() {
        Ok(tp) => {
          if tp.length() != 1 {
            return -7
          }
        }
        Err(_) => return -8
      }
    }
    Err(_) => return -9
  }

  // 4. Request + Response validation via packages/jsonschema
  let validator = match openapi::Validator::from_doc(doc30) {
    Ok(v) => v
    Err(_) => return -10
  }
  let ok_req = openapi::HttpRequest::{
    method: openapi::HttpMethod::Post,
    path: "/users/7",
    query: [],
    headers: [],
    cookies: [],
    content_type: Some("application/json; charset=utf-8"),
    body: Some("{\"name\":\"Ada\",\"bio\":null}"),
  }
  if validator.validate_request(ok_req).length() != 0 {
    return -11
  }
  let bad_req = openapi::HttpRequest::{
    method: openapi::HttpMethod::Post,
    path: "/users/0",
    query: [],
    headers: [],
    cookies: [],
    content_type: Some("application/json"),
    body: Some("{\"name\":\"\"}"),
  }
  if validator.validate_request(bad_req).length() < 2 {
    return -12
  }
  let ok_resp = openapi::HttpResponse::{
    status: 200,
    headers: [],
    content_type: Some("application/json"),
    body: Some("{\"name\":\"Ada\"}"),
  }
  if validator.validate_response(openapi::HttpMethod::Get, "/users/7", ok_resp).length() != 0 {
    return -13
  }

  // 5. AI Tool / MCP Schema export + jsonschema::compile check
  let tool = match doc30.export_tool("updateUser") {
    Ok(t) => t
    Err(_) => return -14
  }
  match jsonschema::compile(tool.input_schema) {
    Ok(c) => {
      match c.is_valid_str("{\"id\":7,\"body\":{\"name\":\"Ada\"}}") {
        Ok(true) => ()
        _ => return -15
      }
    }
    Err(_) => return -16
  }

  // 6. DoS safety: cyclic $ref + expansion bomb (0 trap on Wasm32)
  let cyc_doc = match openapi::parse_json(
    "{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"C\",\"version\":\"1\"},\"paths\":{},\"components\":{\"schemas\":{\"A\":{\"$ref\":\"#/components/schemas/B\"},\"B\":{\"$ref\":\"#/components/schemas/A\"}}}}",
  ) {
    Ok(d) => d
    Err(_) => return -17
  }
  match cyc_doc.resolve_ref("#/components/schemas/A") {
    Ok(_) => return -18
    Err(e) => {
      if !e.is_kind(openapi::OpenApiErrorKind::RefCycle) {
        return -19
      }
    }
  }
  6
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "openapi_wasm_smoke: OK checks=" + r.to_string())
    0
  } else {
    io_println(world, "openapi_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
