///| AWS Cedar expression evaluation tests:
///| short-circuit logic, checked 64-bit arithmetic overflow, equality across types,
///| `like` wildcards, `has`/`.attr`/`["attr"]`, `is`/`is..in`, Sets, Records, and v4 tags.

fn eval_when_expr(
  expr_src : String,
  entities : Entities,
  context : Array[(String, Value)],
) -> Response {
  let pol_src = "@id(\"eval\") permit(principal, action, resource) when { " + expr_src + " };"
  let ps = match parse_policy_set(pol_src) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse failed for expr `" + expr_src + "`: " + e.to_string())
      PolicySet::{ policies: [] }
    }
  }
  let req = Request::new(
    EntityUid::new("User", "alice"),
    EntityUid::new("Action", "view"),
    EntityUid::new("Photo", "p1"),
    context,
  )
  let auth = Authorizer::new()
  match auth.is_authorized(req, ps, entities) {
    Ok(resp) => resp
    Err(e) => {
      debug_assert(false, "is_authorized failed: " + e.to_string())
      Response::{
        decision: Decision::Deny,
        diagnostics: Diagnostics::{ reason: [], errors: [] },
      }
    }
  }
}

fn assert_expr_true(expr_src : String, entities : Entities, ctx : Array[(String, Value)], msg : String) -> Unit {
  let r = eval_when_expr(expr_src, entities, ctx)
  debug_assert(
    decision_eq(r.decision, Decision::Allow) && r.diagnostics.errors.length() == 0,
    msg + " (expected Allow with 0 errors)",
  )
}

fn assert_expr_false(expr_src : String, entities : Entities, ctx : Array[(String, Value)], msg : String) -> Unit {
  let r = eval_when_expr(expr_src, entities, ctx)
  debug_assert(
    decision_eq(r.decision, Decision::Deny) && r.diagnostics.errors.length() == 0,
    msg + " (expected Deny with 0 errors)",
  )
}

fn assert_expr_err_kind(
  expr_src : String,
  entities : Entities,
  ctx : Array[(String, Value)],
  kind : CedarErrorKind,
  msg : String,
) -> Unit {
  let r = eval_when_expr(expr_src, entities, ctx)
  debug_assert(decision_eq(r.decision, Decision::Deny), msg + " (expected Deny on error)")
  debug_assert(r.diagnostics.errors.length() == 1, msg + " (expected 1 policy error)")
  if r.diagnostics.errors.length() == 1 {
    debug_assert(
      r.diagnostics.errors[0].error.is_kind(kind),
      msg + " (expected " + cedar_error_kind_as_str(kind) + ", got " + r.diagnostics.errors[0].error.to_string() + ")",
    )
  }
}

///|
test "cedar_eval_short_circuit_and_if" {
  let empty = Entities::empty()
  // Short-circuit && and || must not evaluate failing RHS
  assert_expr_true("true || (1 + \"bad\" == 0)", empty, [], "|| short-circuit")
  assert_expr_false("false && (1 + \"bad\" == 0)", empty, [], "&& short-circuit")
  // if-then-else must only evaluate selected branch
  assert_expr_true("if true then 1 + 2 == 3 else (1 + \"bad\" == 0)", empty, [], "if true branch")
  assert_expr_true("if false then (1 + \"bad\" == 0) else 2 * 3 == 6", empty, [], "if false branch")
  // Non-bool condition is TypeError
  assert_expr_err_kind("1 && true", empty, [], CedarErrorKind::TypeError, "non-bool && lhs")
  assert_expr_err_kind("if 1 then true else false", empty, [], CedarErrorKind::TypeError, "non-bool if cond")
}

///|
test "cedar_eval_checked_i64_arithmetic" {
  let empty = Entities::empty()
  assert_expr_true("1 + 2 * 3 == 7", empty, [], "precedence mul over add")
  assert_expr_true("(1 + 2) * 3 == 9", empty, [], "parenthesized add")
  assert_expr_true("-5 + 12 - 3 == 4", empty, [], "unary neg and sub")
  assert_expr_true("9223372036854775807 - 1 == 9223372036854775806", empty, [], "near max ok")
  assert_expr_true("-9223372036854775808 + 1 == -9223372036854775807", empty, [], "near min ok")
  assert_expr_true("-9223372036854775808 * 0 == 0", empty, [], "min * 0 == 0")
  assert_expr_true("-9223372036854775808 * 1 == -9223372036854775808", empty, [], "min * 1 == min")

  // Strict overflow detection (never wrap!)
  assert_expr_err_kind("9223372036854775807 + 1 == 0", empty, [], CedarErrorKind::IntegerOverflow, "i64::MAX + 1")
  assert_expr_err_kind("-9223372036854775808 - 1 == 0", empty, [], CedarErrorKind::IntegerOverflow, "i64::MIN - 1")
  assert_expr_err_kind("-(-9223372036854775808) == 0", empty, [], CedarErrorKind::IntegerOverflow, "-i64::MIN")
  assert_expr_err_kind("-9223372036854775808 * -1 == 0", empty, [], CedarErrorKind::IntegerOverflow, "i64::MIN * -1")
  assert_expr_err_kind("4611686018427387904 * 2 == 0", empty, [], CedarErrorKind::IntegerOverflow, "2^62 * 2 overflow")
}

///|
test "cedar_eval_equality_like_sets_records" {
  let empty = Entities::empty()
  // Cross-type equality returns false (NOT an error)
  assert_expr_true("1 != \"1\"", empty, [], "int != string")
  assert_expr_false("1 == true", empty, [], "int == bool is false")
  assert_expr_false("\"a\" == User::\"a\"", empty, [], "string == entity is false")
  // Ordering on non-Long is TypeError
  assert_expr_err_kind("\"a\" < \"b\"", empty, [], CedarErrorKind::TypeError, "string < string is TypeError")

  // Sets: unordered & deduplicated
  assert_expr_true("[1, 2, 1] == [2, 1]", empty, [], "set equality dedup & order independent")
  assert_expr_true("[1, 2, 3].contains(2)", empty, [], "set contains true")
  assert_expr_false("[1, 2, 3].contains(\"2\")", empty, [], "set contains cross-type false")
  assert_expr_true("[1, 2, 3].containsAll([3, 1])", empty, [], "set containsAll true")
  assert_expr_false("[1, 2].containsAll([1, 3])", empty, [], "set containsAll false")
  assert_expr_true("[1, 2].containsAny([2, 9])", empty, [], "set containsAny true")
  assert_expr_false("[1, 2].containsAny([8, 9])", empty, [], "set containsAny false")
  assert_expr_true("[].isEmpty()", empty, [], "empty set isEmpty")
  assert_expr_false("[1].isEmpty()", empty, [], "non-empty set isEmpty")

  // Records: key-order-independent equality, has, .attr, ["attr"]
  assert_expr_true("{ b: 2, a: 1 } == { a: 1, b: 2 }", empty, [], "record equality order independent")
  assert_expr_true("{ \"k-1\": 42 } has \"k-1\" && { \"k-1\": 42 }[\"k-1\"] == 42", empty, [], "record bracket access")
  assert_expr_false("{ a: 1 } has b", empty, [], "record has missing")
  assert_expr_err_kind("{ a: 1 }.b == 1", empty, [], CedarErrorKind::AttrNotFound, "record missing attr error")

  // `like` wildcards and escaped \*
  assert_expr_true("\"hello-world\" like \"hello*\"", empty, [], "prefix wildcard")
  assert_expr_true("\"hello-world\" like \"*world\"", empty, [], "suffix wildcard")
  assert_expr_true("\"hello-world\" like \"h*o*d\"", empty, [], "multi wildcard")
  assert_expr_true("\"a*b\" like \"a\\*b\"", empty, [], "escaped literal star matches *")
  assert_expr_false("\"axb\" like \"a\\*b\"", empty, [], "escaped literal star rejects x")
  assert_expr_true("\"\" like \"*\"", empty, [], "empty string matches *")
  assert_expr_false("\"abc\" like \"ab\"", empty, [], "exact mismatch")
}

///|
test "cedar_eval_entity_attrs_is_and_v4_tags" {
  let alice = Entity::with_tags(
    EntityUid::new("User", "alice"),
    [("level", Value::Long(5L)), ("dept", Value::String("eng"))],
    [EntityUid::new("Group", "staff")],
    [("clearance", Value::String("top-secret")), ("tier", Value::Long(3L))],
  )
  let staff = Entity::new(EntityUid::new("Group", "staff"), [], [])
  let entities = match Entities::from_array([alice, staff]) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "Entities::from_array failed: " + e.to_string())
      Entities::empty()
    }
  }

  assert_expr_true("principal is User", entities, [], "is User")
  assert_expr_false("principal is Admin", entities, [], "is Admin false")
  assert_expr_true("principal is User in Group::\"staff\"", entities, [], "is User in Group::staff")
  assert_expr_false("principal is Admin in Group::\"staff\"", entities, [], "is Admin in Group::staff false")

  // Entity attrs & missing entity `has` vs `.attr`
  assert_expr_true("principal has level && principal.level == 5", entities, [], "entity has + get")
  assert_expr_false("resource has owner", entities, [], "missing entity has -> false (no error)")
  assert_expr_err_kind("resource.owner == principal", entities, [], CedarErrorKind::EntityDoesNotExist, "missing entity .attr -> EntityDoesNotExist")

  // Cedar v4 tags: .hasTag / .getTag
  assert_expr_true("principal.hasTag(\"clearance\") && principal.getTag(\"clearance\") == \"top-secret\"", entities, [], "v4 hasTag + getTag")
  assert_expr_false("principal.hasTag(\"missing\")", entities, [], "v4 hasTag missing false")
  assert_expr_false("resource.hasTag(\"any\")", entities, [], "v4 hasTag on missing entity -> false")
  assert_expr_err_kind("principal.getTag(\"missing\") == \"x\"", entities, [], CedarErrorKind::TagNotFound, "v4 getTag missing -> TagNotFound")
  assert_expr_err_kind("resource.getTag(\"any\") == \"x\"", entities, [], CedarErrorKind::EntityDoesNotExist, "v4 getTag missing entity -> EntityDoesNotExist")
}
