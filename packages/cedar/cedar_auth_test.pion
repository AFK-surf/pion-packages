///| AWS Cedar Authorizer semantics tests:
///| Default Deny, Forbid Overrides Permit, diagnostics.reason & diagnostics.errors,
///| Entity DAG transitive closure, cycle safety, and Cedar JSON Entities/Request loading.

///|
test "cedar_auth_default_deny_and_forbid_overrides_permit" {
  let src = "@id(\"p-allow-1\")\npermit(principal == User::\"alice\", action == Action::\"view\", resource);\n\n@id(\"p-allow-2\")\npermit(principal in Group::\"eng\", action == Action::\"view\", resource);\n\n@id(\"p-forbid-secret\")\nforbid(principal, action, resource == Doc::\"secret\");\n"
  let ps = match parse_policy_set(src) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse_policy_set failed: " + e.to_string())
      PolicySet::{ policies: [] }
    }
  }
  let entities = match
  Entities::from_array([
    Entity::new(EntityUid::new("User", "alice"), [], [EntityUid::new("Group", "eng")]),
    Entity::new(EntityUid::new("Group", "eng"), [], []),
  ]) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "Entities::from_array failed: " + e.to_string())
      Entities::empty()
    }
  }
  let auth = Authorizer::new()

  // 1. Default Deny: bob has no matching permit
  let r_bob = match
  auth.is_authorized(
    Request::new(EntityUid::new("User", "bob"), EntityUid::new("Action", "view"), EntityUid::new("Doc", "public"), []),
    ps,
    entities,
  ) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "bob auth failed: " + e.to_string())
      Response::{ decision: Decision::Allow, diagnostics: Diagnostics::{ reason: [], errors: [] } }
    }
  }
  debug_assert(decision_eq(r_bob.decision, Decision::Deny), "default deny")
  debug_assert(r_bob.diagnostics.reason.length() == 0, "no determining policies on default deny")

  // 2. Multiple permits satisfied -> Allow with both policy IDs in reason
  let r_allow = match
  auth.is_authorized(
    Request::new(EntityUid::new("User", "alice"), EntityUid::new("Action", "view"), EntityUid::new("Doc", "public"), []),
    ps,
    entities,
  ) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "alice public auth failed: " + e.to_string())
      Response::{ decision: Decision::Deny, diagnostics: Diagnostics::{ reason: [], errors: [] } }
    }
  }
  debug_assert(decision_eq(r_allow.decision, Decision::Allow), "alice public allow")
  debug_assert(r_allow.diagnostics.reason.length() == 2, "two permit policies matched")

  // 3. Forbid overrides Permit -> Deny with only forbid policy ID in reason
  let r_forbid = match
  auth.is_authorized(
    Request::new(EntityUid::new("User", "alice"), EntityUid::new("Action", "view"), EntityUid::new("Doc", "secret"), []),
    ps,
    entities,
  ) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "alice secret auth failed: " + e.to_string())
      Response::{ decision: Decision::Allow, diagnostics: Diagnostics::{ reason: [], errors: [] } }
    }
  }
  debug_assert(decision_eq(r_forbid.decision, Decision::Deny), "forbid overrides permit")
  debug_assert(
    r_forbid.diagnostics.reason.length() == 1 && r_forbid.diagnostics.reason[0] == "p-forbid-secret",
    "reason contains forbid id",
  )
}

///|
test "cedar_auth_per_policy_error_isolation" {
  // Policy 1 errors (missing attr), Policy 2 permits, Policy 3 forbids on resource == Doc::"x"
  let src = "@id(\"p-err\")\npermit(principal, action, resource) when { principal.nonexistent > 0 };\n\n@id(\"p-ok\")\npermit(principal == User::\"alice\", action, resource);\n\n@id(\"p-forbid\")\nforbid(principal, action, resource == Doc::\"x\");\n"
  let ps = match parse_policy_set(src) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse failed: " + e.to_string())
      PolicySet::{ policies: [] }
    }
  }
  let entities = match
  Entities::from_array([Entity::new(EntityUid::new("User", "alice"), [], [])]) {
    Ok(es) => es
    Err(_) => Entities::empty()
  }
  let auth = Authorizer::new()

  // Doc::"y": p-err fails (recorded in diagnostics.errors), p-ok still allows!
  let r1 = match
  auth.is_authorized(
    Request::new(EntityUid::new("User", "alice"), EntityUid::new("Action", "read"), EntityUid::new("Doc", "y"), []),
    ps,
    entities,
  ) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "auth failed: " + e.to_string())
      Response::{ decision: Decision::Deny, diagnostics: Diagnostics::{ reason: [], errors: [] } }
    }
  }
  debug_assert(decision_eq(r1.decision, Decision::Allow), "p-ok allows despite p-err")
  debug_assert(r1.diagnostics.reason.length() == 1 && r1.diagnostics.reason[0] == "p-ok", "reason is p-ok")
  debug_assert(r1.diagnostics.errors.length() == 1 && r1.diagnostics.errors[0].policy_id == "p-err", "error recorded for p-err")

  // Doc::"x": p-err fails, p-ok permits, p-forbid STILL overrides -> Deny + error recorded
  let r2 = match
  auth.is_authorized(
    Request::new(EntityUid::new("User", "alice"), EntityUid::new("Action", "read"), EntityUid::new("Doc", "x"), []),
    ps,
    entities,
  ) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "auth failed: " + e.to_string())
      Response::{ decision: Decision::Allow, diagnostics: Diagnostics::{ reason: [], errors: [] } }
    }
  }
  debug_assert(decision_eq(r2.decision, Decision::Deny), "forbid overrides despite error in other policy")
  debug_assert(r2.diagnostics.reason.length() == 1 && r2.diagnostics.reason[0] == "p-forbid", "reason is p-forbid")
  debug_assert(r2.diagnostics.errors.length() == 1, "error still recorded")
}

///|
test "cedar_entity_dag_transitivity_and_cycle_safety" {
  // Cycle: A -> B -> C -> A, plus D -> A
  let a = EntityUid::new("Group", "A")
  let b = EntityUid::new("Group", "B")
  let c = EntityUid::new("Group", "C")
  let d = EntityUid::new("User", "D")
  let z = EntityUid::new("Group", "Z")
  let unknown = EntityUid::new("User", "ghost")

  let entities = match
  Entities::from_array([
    Entity::new(a, [], [b]),
    Entity::new(b, [], [c]),
    Entity::new(c, [], [a]),
    Entity::new(d, [], [a]),
    Entity::new(z, [], []),
  ]) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "cyclic entities must load safely: " + e.to_string())
      Entities::empty()
    }
  }

  // Reflexivity (even for entities not in store!)
  debug_assert(entities.is_in(unknown, unknown), "reflexive unknown in unknown")
  debug_assert(entities.is_in(a, a), "reflexive a in a")
  // Transitivity across cycle
  debug_assert(entities.is_in(d, a), "d in a")
  debug_assert(entities.is_in(d, b), "d in b (2 hops)")
  debug_assert(entities.is_in(d, c), "d in c (3 hops)")
  debug_assert(entities.is_in(c, b), "c in b via cycle")
  // Non-member terminates cleanly
  debug_assert(!entities.is_in(d, z), "d not in z")
  debug_assert(!entities.is_in(z, a), "z not in a")
}

///|
test "cedar_json_entities_and_request_deserialization" {
  let entities_json = "[\n  {\n    \"uid\": { \"type\": \"User\", \"id\": \"alice\" },\n    \"attrs\": {\n      \"age\": 31,\n      \"active\": true,\n      \"roles\": [\"admin\", \"dev\"],\n      \"manager\": { \"__entity\": { \"type\": \"User\", \"id\": \"bob\" } },\n      \"net\": { \"__extn\": { \"fn\": \"ip\", \"arg\": \"10.20.0.0/16\" } },\n      \"limit\": { \"__extn\": { \"fn\": \"decimal\", \"arg\": \"100.50\" } }\n    },\n    \"parents\": [{ \"type\": \"Group\", \"id\": \"eng\" }],\n    \"tags\": { \"env\": \"prod\" }\n  },\n  {\n    \"uid\": { \"type\": \"Group\", \"id\": \"eng\" },\n    \"attrs\": {},\n    \"parents\": []\n  }\n]"
  let entities = match entities_from_json(entities_json) {
    Ok(es) => es
    Err(e) => {
      debug_assert(false, "entities_from_json failed: " + e.to_string())
      Entities::empty()
    }
  }
  debug_assert(entities.len() == 2, "loaded 2 entities")

  let req_json = "{\n  \"principal\": { \"type\": \"User\", \"id\": \"alice\" },\n  \"action\": { \"type\": \"Action\", \"id\": \"deploy\" },\n  \"resource\": { \"type\": \"Service\", \"id\": \"billing\" },\n  \"context\": {\n    \"client_ip\": { \"__extn\": { \"fn\": \"ip\", \"arg\": \"10.20.3.4\" } },\n    \"amount\": { \"__extn\": { \"fn\": \"decimal\", \"arg\": \"49.99\" } }\n  }\n}"
  let req = match request_from_json(req_json) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "request_from_json failed: " + e.to_string())
      Request::new(EntityUid::new("U", "x"), EntityUid::new("A", "x"), EntityUid::new("R", "x"), [])
    }
  }

  let pol_src = "@id(\"deploy-prod\")\npermit(principal in Group::\"eng\", action == Action::\"deploy\", resource is Service)\nwhen {\n  principal.active &&\n  principal.age >= 21 &&\n  principal.roles.contains(\"dev\") &&\n  principal.manager == User::\"bob\" &&\n  principal.getTag(\"env\") == \"prod\" &&\n  context.client_ip.isInRange(principal.net) &&\n  context.amount.lessThan(principal.limit)\n};\n"
  let ps = match parse_policy_set(pol_src) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse_policy_set failed: " + e.to_string())
      PolicySet::{ policies: [] }
    }
  }

  let auth = Authorizer::new()
  let resp = match auth.is_authorized(req, ps, entities) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "is_authorized failed: " + e.to_string())
      Response::{ decision: Decision::Deny, diagnostics: Diagnostics::{ reason: [], errors: [] } }
    }
  }
  debug_assert(decision_eq(resp.decision, Decision::Allow), "json e2e allow")
  debug_assert(
    resp.diagnostics.reason.length() == 1 && resp.diagnostics.reason[0] == "deploy-prod",
    "json e2e reason",
  )

  // Invalid JSON (float attribute rejected by Cedar)
  match entities_from_json("[{\"uid\":{\"type\":\"User\",\"id\":\"a\"},\"attrs\":{\"x\":1.5},\"parents\":[]}]") {
    Ok(_) => debug_assert(false, "float in Cedar JSON must be rejected")
    Err(e) => debug_assert(!e.is_kind(CedarErrorKind::Unimplemented), "real json error for float")
  }
}
