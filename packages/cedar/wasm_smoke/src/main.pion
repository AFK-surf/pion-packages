///| Wasm32 + Native smoke entry for `packages/cedar`.

import "cedar"

///|
pub fn smoke() -> Int {
  // 1. Multi-policy PolicySet parse + canonical format + idempotent round-trip
  let pol_src = "@id(\"allow-eng\")\npermit(\n  principal in Group::\"eng\",\n  action in [Action::\"read\", Action::\"deploy\"],\n  resource is Service\n)\nwhen {\n  principal.active &&\n  context.client_ip.isInRange(ip(\"10.0.0.0/8\")) &&\n  context.cost.lessThanOrEqual(decimal(\"500.00\")) &&\n  resource.name like \"svc-*\"\n};\n\n@id(\"forbid-frozen\")\nforbid(principal, action == Action::\"deploy\", resource)\nwhen {\n  resource.hasTag(\"frozen\") && resource.getTag(\"frozen\") == \"true\"\n};\n\n@id(\"err-policy\")\npermit(principal, action, resource) when { principal.missing_attr > 0 };\n"
  let ps = match cedar::parse_policy_set(pol_src) {
    Ok(p) => p
    Err(_) => return -1
  }
  if ps.len() != 3 {
    return -2
  }
  let fmt1 = cedar::format_policy_set(ps)
  let ps2 = match cedar::parse_policy_set(fmt1) {
    Ok(p) => p
    Err(_) => return -3
  }
  if cedar::format_policy_set(ps2) != fmt1 {
    return -4
  }

  // 2. JSON Entities + Request deserialization
  let ent_json = "[\n  {\"uid\":{\"type\":\"User\",\"id\":\"alice\"},\"attrs\":{\"active\":true},\"parents\":[{\"type\":\"Group\",\"id\":\"eng\"}]},\n  {\"uid\":{\"type\":\"Group\",\"id\":\"eng\"},\"attrs\":{},\"parents\":[{\"type\":\"Group\",\"id\":\"all\"}]},\n  {\"uid\":{\"type\":\"Group\",\"id\":\"all\"},\"attrs\":{},\"parents\":[{\"type\":\"Group\",\"id\":\"eng\"}]},\n  {\"uid\":{\"type\":\"Service\",\"id\":\"api\"},\"attrs\":{\"name\":\"svc-api\"},\"parents\":[],\"tags\":{\"frozen\":\"false\"}},\n  {\"uid\":{\"type\":\"Service\",\"id\":\"legacy\"},\"attrs\":{\"name\":\"svc-legacy\"},\"parents\":[],\"tags\":{\"frozen\":\"true\"}}\n]"
  let entities = match cedar::entities_from_json(ent_json) {
    Ok(e) => e
    Err(_) => return -5
  }
  // Cycle-safe transitive membership
  if !entities.is_in(cedar::EntityUid::new("User", "alice"), cedar::EntityUid::new("Group", "all")) {
    return -6
  }

  // 3. Authorizer: Allow + Forbid Overrides Permit + per-policy error isolation
  let req_allow_json = "{\"principal\":{\"type\":\"User\",\"id\":\"alice\"},\"action\":{\"type\":\"Action\",\"id\":\"deploy\"},\"resource\":{\"type\":\"Service\",\"id\":\"api\"},\"context\":{\"client_ip\":{\"__extn\":{\"fn\":\"ip\",\"arg\":\"10.1.2.3\"}},\"cost\":{\"__extn\":{\"fn\":\"decimal\",\"arg\":\"120.50\"}}}}"
  let req_allow = match cedar::request_from_json(req_allow_json) {
    Ok(r) => r
    Err(_) => return -7
  }
  let auth = cedar::Authorizer::new()
  match auth.is_authorized(req_allow, ps, entities) {
    Ok(resp) => {
      if !cedar::decision_eq(resp.decision, cedar::Decision::Allow) {
        return -8
      }
      if resp.diagnostics.reason.length() != 1 || resp.diagnostics.reason[0] != "allow-eng" {
        return -9
      }
      if resp.diagnostics.errors.length() != 1 {
        return -10
      }
    }
    Err(_) => return -11
  }

  let req_forbid_json = "{\"principal\":{\"type\":\"User\",\"id\":\"alice\"},\"action\":{\"type\":\"Action\",\"id\":\"deploy\"},\"resource\":{\"type\":\"Service\",\"id\":\"legacy\"},\"context\":{\"client_ip\":{\"__extn\":{\"fn\":\"ip\",\"arg\":\"10.1.2.3\"}},\"cost\":{\"__extn\":{\"fn\":\"decimal\",\"arg\":\"120.50\"}}}}"
  let req_forbid = match cedar::request_from_json(req_forbid_json) {
    Ok(r) => r
    Err(_) => return -12
  }
  match auth.is_authorized(req_forbid, ps, entities) {
    Ok(resp) => {
      if !cedar::decision_eq(resp.decision, cedar::Decision::Deny) {
        return -13
      }
      if resp.diagnostics.reason.length() != 1 || resp.diagnostics.reason[0] != "forbid-frozen" {
        return -14
      }
    }
    Err(_) => return -15
  }

  // 4. Depth bomb guard (0 trap on Wasm32)
  let sb = StringBuilder::new()
  sb.write_string("permit(principal, action, resource) when { ")
  let mut i = 0
  while i < 120 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("true")
  i = 0
  while i < 120 {
    sb.write_string(")")
    i = i + 1
  }
  sb.write_string(" };")
  let tight = cedar::CedarLimits::new(32, 65536, 100, 100, 10000)
  match cedar::parse_policy_with_limits(sb.to_string(), tight) {
    Ok(_) => return -16
    Err(e) =>
    if !e.is_kind(cedar::CedarErrorKind::LimitExceeded) {
      return -17
    }
  }
  4
}

///|
pub fn main(world : World) -> Int {
  let r = smoke()
  if r > 0 {
    io_println(world, "cedar_wasm_smoke: OK checks=" + r.to_string())
    0
  } else {
    io_println(world, "cedar_wasm_smoke: FAIL code=" + r.to_string())
    1
  }
}
