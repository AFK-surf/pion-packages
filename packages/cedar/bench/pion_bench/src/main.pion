///| Head-to-head benchmark driver for `packages/cedar` vs Rust `cedar-policy --release`.

import "cedar"

fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn sort_strings_asc(arr : Array[String]) -> Unit {
  let n = arr.length()
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && arr[j] > key {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

fn format_decision_line(sb : StringBuilder, idx : Int, resp : cedar::Response) -> Unit {
  sb.write_string(idx.to_string())
  if cedar::decision_eq(resp.decision, cedar::Decision::Allow) {
    sb.write_string(":Allow:")
  } else {
    sb.write_string(":Deny:")
  }
  let reasons : Array[String] = []
  let mut i = 0
  while i < resp.diagnostics.reason.length() {
    reasons.push(resp.diagnostics.reason[i])
    i = i + 1
  }
  sort_strings_asc(reasons)
  i = 0
  while i < reasons.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(reasons[i])
    i = i + 1
  }
  sb.write_string("\n")
}

// ---------------------------------------------------------------------------
// W1: Policy Set Parse + Format Round-Trip (200 policies x N rounds)
// ---------------------------------------------------------------------------

fn build_w1_corpus() -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 200 {
    let tid = (i % 20).to_string()
    let fid = (i % 12).to_string()
    let lvl = (1 + (i % 5)).to_string()
    if i % 10 < 7 {
      sb.write_string("permit(\n  principal in Team::\"t")
      sb.write_string(tid)
      sb.write_string("\",\n  action in [Action::\"read\", Action::\"write\"],\n  resource is Doc in Folder::\"f")
      sb.write_string(fid)
      sb.write_string("\"\n)\nwhen {\n  principal.active && principal.level >= ")
      sb.write_string(lvl)
      sb.write_string(" && (resource.tenant == \"t")
      sb.write_string((i % 5).to_string())
      sb.write_string("\" || resource.owner == principal)\n};\n")
    } else {
      sb.write_string("forbid(\n  principal in Org::\"acme\",\n  action == Action::\"delete\",\n  resource is Doc in Folder::\"f")
      sb.write_string(fid)
      sb.write_string("\"\n)\nwhen {\n  resource.locked || !(context.mfa && principal.clearance >= ")
      sb.write_string((i % 4).to_string())
      sb.write_string(")\n};\n")
    }
    i = i + 1
  }
  sb.to_string()
}

fn run_w1(world : World, rounds : Int) -> Int {
  let corpus = build_w1_corpus()
  let mut total_policies = 0
  let mut total_permits = 0
  let mut total_forbids = 0
  let mut total_rt_ok = 0
  let mut r = 0
  while r < rounds {
    let ps = match cedar::parse_policy_set(corpus) {
      Ok(p) => p
      Err(e) => {
        io_println(world, "ERR w1 parse: " + e.to_string())
        return 1
      }
    }
    let n = ps.len()
    total_policies = total_policies + n
    let mut i = 0
    while i < n {
      let pol = ps.policies[i]
      if cedar::effect_eq(pol.effect, cedar::Effect::Permit) {
        total_permits = total_permits + 1
      } else {
        total_forbids = total_forbids + 1
      }
      let fmt = cedar::format_policy(pol)
      if fmt.length() > 0 {
        total_rt_ok = total_rt_ok + 1
      }
      i = i + 1
    }
    r = r + 1
  }
  io_println(
    world,
    "w1 rounds=" + rounds.to_string() +
    " policies=" + total_policies.to_string() +
    " permits=" + total_permits.to_string() +
    " forbids=" + total_forbids.to_string() +
    " formatted=" + total_rt_ok.to_string(),
  )
  0
}

// ---------------------------------------------------------------------------
// W2: Large-Scale Authorization (60 policies, 250-node Entity DAG, N requests)
// ---------------------------------------------------------------------------

fn build_w2_policies() -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 60 {
    let t = (i % 20).to_string()
    let d = (i % 5).to_string()
    let f = (i % 24).to_string()
    if i < 20 {
      // Team read/write in folder with level & active check
      sb.write_string("permit(principal in Team::\"t")
      sb.write_string(t)
      sb.write_string("\", action in [Action::\"read\", Action::\"write\"], resource in Folder::\"f")
      sb.write_string(f)
      sb.write_string("\") when { principal.active && principal.level >= ")
      sb.write_string((1 + (i % 3)).to_string())
      sb.write_string(" };\n")
    } else if i < 32 {
      // Dept-level read in Org
      sb.write_string("permit(principal in Dept::\"d")
      sb.write_string(d)
      sb.write_string("\", action == Action::\"read\", resource in Org::\"acme\") when { principal.active && principal.clearance >= resource.classification };\n")
    } else if i < 42 {
      // Owner full access (read/write/delete/share)
      sb.write_string("permit(principal is User in Org::\"acme\", action in [Action::\"read\", Action::\"write\", Action::\"delete\", Action::\"share\"], resource is Doc in Folder::\"f")
      sb.write_string((i % 12).to_string())
      sb.write_string("\") when { resource.owner == principal && context.risk_score < 80 };\n")
    } else if i < 52 {
      // Forbid locked documents on write/delete
      sb.write_string("forbid(principal, action in [Action::\"write\", Action::\"delete\"], resource in Folder::\"f")
      sb.write_string((i % 12).to_string())
      sb.write_string("\") when { resource.locked };\n")
    } else {
      // Forbid delete/share without MFA or high risk
      sb.write_string("forbid(principal in Dept::\"d")
      sb.write_string(d)
      sb.write_string("\", action in [Action::\"delete\", Action::\"share\"], resource) when { !context.mfa || context.risk_score >= 70 };\n")
    }
    i = i + 1
  }
  sb.to_string()
}

fn build_w2_entities() -> Result[cedar::Entities, cedar::CedarError] {
  let list : Array[cedar::Entity] = []
  let org = cedar::EntityUid::new("Org", "acme")
  list.push(cedar::Entity::new(org, [], []))

  let mut i = 0
  while i < 5 {
    list.push(cedar::Entity::new(cedar::EntityUid::new("Dept", "d" + i.to_string()), [], [org]))
    i = i + 1
  }
  i = 0
  while i < 20 {
    let dept = cedar::EntityUid::new("Dept", "d" + (i % 5).to_string())
    list.push(cedar::Entity::new(cedar::EntityUid::new("Team", "t" + i.to_string()), [], [dept]))
    i = i + 1
  }
  i = 0
  while i < 100 {
    let team = cedar::EntityUid::new("Team", "t" + (i % 20).to_string())
    let attrs : Array[(String, cedar::Value)] = [
      ("level", cedar::Value::Long((1 + (i % 5)).to_int64())),
      ("active", cedar::Value::Bool(i % 10 != 0)),
      ("clearance", cedar::Value::Long((i % 4).to_int64())),
    ]
    list.push(cedar::Entity::new(cedar::EntityUid::new("User", "u" + i.to_string()), attrs, [team]))
    i = i + 1
  }
  i = 0
  while i < 24 {
    let parent = if i < 12 {
      org
    } else {
      cedar::EntityUid::new("Folder", "f" + (i - 12).to_string())
    }
    list.push(cedar::Entity::new(cedar::EntityUid::new("Folder", "f" + i.to_string()), [], [parent]))
    i = i + 1
  }
  i = 0
  while i < 100 {
    let folder = cedar::EntityUid::new("Folder", "f" + (i % 24).to_string())
    let attrs : Array[(String, cedar::Value)] = [
      ("owner", cedar::Value::Entity(cedar::EntityUid::new("User", "u" + i.to_string()))),
      ("classification", cedar::Value::Long((i % 4).to_int64())),
      ("locked", cedar::Value::Bool(i % 13 == 0)),
    ]
    list.push(cedar::Entity::new(cedar::EntityUid::new("Doc", "doc" + i.to_string()), attrs, [folder]))
    i = i + 1
  }
  cedar::Entities::from_array(list)
}

fn run_w2(world : World, num_reqs : Int) -> Int {
  let ps = match cedar::parse_policy_set(build_w2_policies()) {
    Ok(p) => p
    Err(e) => {
      io_println(world, "ERR w2 policies: " + e.to_string())
      return 1
    }
  }
  let entities = match build_w2_entities() {
    Ok(es) => es
    Err(e) => {
      io_println(world, "ERR w2 entities: " + e.to_string())
      return 1
    }
  }
  let actions = [
    cedar::EntityUid::new("Action", "read"),
    cedar::EntityUid::new("Action", "write"),
    cedar::EntityUid::new("Action", "delete"),
    cedar::EntityUid::new("Action", "share"),
  ]
  let auth = cedar::Authorizer::new()
  let out = StringBuilder::new()
  let mut i = 0
  while i < num_reqs {
    let u = (i * 7 + 3) % 100
    let a = (i * 3 + 1) % 4
    let d = (i * 11 + 5) % 100
    let mfa = (i % 3) != 0
    let risk = ((i * 17) % 100).to_int64()
    let req = cedar::Request::new(
      cedar::EntityUid::new("User", "u" + u.to_string()),
      actions[a],
      cedar::EntityUid::new("Doc", "doc" + d.to_string()),
      [("mfa", cedar::Value::Bool(mfa)), ("risk_score", cedar::Value::Long(risk))],
    )
    let resp = match auth.is_authorized(req, ps, entities) {
      Ok(r) => r
      Err(e) => {
        io_println(world, "ERR w2 auth: " + e.to_string())
        return 1
      }
    }
    format_decision_line(out, i, resp)
    i = i + 1
  }
  io_print(world, out.to_string())
  0
}

// ---------------------------------------------------------------------------
// W3: Extension & Predicate Heavy Evaluation (decimal, ip CIDR, like, Sets)
// ---------------------------------------------------------------------------

fn build_w3_policies() -> String {
  let sb = StringBuilder::new()
  sb.write_string("permit(principal, action == Action::\"pay\", resource) when { context.client_ip.isIpv4() && context.client_ip.isInRange(ip(\"10.0.0.0/8\")) && context.amount.lessThanOrEqual(decimal(\"1000.00\")) && context.path like \"/api/v*/pay*\" && context.scopes.contains(\"payments:write\") };\n")
  sb.write_string("permit(principal, action == Action::\"pay\", resource) when { context.client_ip.isIpv6() && context.client_ip.isInRange(ip(\"2001:db8::/32\")) && context.amount.lessThan(decimal(\"500.00\")) && context.scopes.containsAll([\"payments:write\", \"ipv6:ok\"]) };\n")
  sb.write_string("permit(principal, action == Action::\"refund\", resource) when { context.amount.greaterThanOrEqual(decimal(\"0.01\")) && context.amount.lessThanOrEqual(decimal(\"250.50\")) && context.path like \"/api/v1/refund\\*/*\" && context.scopes.containsAny([\"admin\", \"finance\"]) };\n")
  sb.write_string("permit(principal, action == Action::\"audit\", resource) when { !context.scopes.isEmpty() && (context.client_ip.isLoopback() || context.client_ip.isInRange(ip(\"192.168.0.0/16\"))) };\n")
  sb.write_string("forbid(principal, action, resource) when { context.client_ip.isInRange(ip(\"10.99.0.0/16\")) || context.amount.greaterThan(decimal(\"900.00\")) };\n")
  sb.write_string("forbid(principal, action == Action::\"pay\", resource) when { context.path like \"*blocked*\" };\n")
  sb.to_string()
}

fn run_w3(world : World, num_reqs : Int) -> Int {
  let ps = match cedar::parse_policy_set(build_w3_policies()) {
    Ok(p) => p
    Err(e) => {
      io_println(world, "ERR w3 policies: " + e.to_string())
      return 1
    }
  }
  let entities = cedar::Entities::empty()
  let actions = [
    cedar::EntityUid::new("Action", "pay"),
    cedar::EntityUid::new("Action", "refund"),
    cedar::EntityUid::new("Action", "audit"),
  ]
  let ip_strs = [
    "10.1.2.3",
    "10.99.4.5",
    "192.168.10.20",
    "127.0.0.1",
    "2001:db8::42",
    "2001:dead::1",
    "172.16.0.1",
  ]
  let ips : Array[cedar::IpAddrVal] = []
  let mut k = 0
  while k < ip_strs.length() {
    match cedar::parse_ip(ip_strs[k]) {
      Ok(v) => ips.push(v)
      Err(e) => {
        io_println(world, "ERR w3 ip: " + e.to_string())
        return 1
      }
    }
    k = k + 1
  }
  let dec_strs = ["10.00", "250.50", "499.99", "850.00", "950.00", "0.01", "1200.00"]
  let decs : Array[cedar::DecimalVal] = []
  k = 0
  while k < dec_strs.length() {
    match cedar::parse_decimal(dec_strs[k]) {
      Ok(v) => decs.push(v)
      Err(e) => {
        io_println(world, "ERR w3 dec: " + e.to_string())
        return 1
      }
    }
    k = k + 1
  }
  let paths = [
    "/api/v2/payments/create",
    "/api/v1/refund*/order-9",
    "/api/v2/pay-blocked-item",
    "/api/v1/refund/normal",
    "/internal/audit/log",
  ]
  let scope_sets : Array[cedar::Value] = [
    cedar::Value::Set([cedar::Value::String("payments:write"), cedar::Value::String("ipv6:ok")]),
    cedar::Value::Set([cedar::Value::String("payments:write")]),
    cedar::Value::Set([cedar::Value::String("finance"), cedar::Value::String("read")]),
    cedar::Value::Set([]),
  ]

  let auth = cedar::Authorizer::new()
  let out = StringBuilder::new()
  let mut i = 0
  while i < num_reqs {
    let req = cedar::Request::new(
      cedar::EntityUid::new("User", "u" + (i % 50).to_string()),
      actions[i % 3],
      cedar::EntityUid::new("Account", "acct" + (i % 10).to_string()),
      [
        ("client_ip", cedar::Value::IpAddr(ips[i % 7])),
        ("amount", cedar::Value::Decimal(decs[(i * 3) % 7])),
        ("path", cedar::Value::String(paths[(i * 2) % 5])),
        ("scopes", scope_sets[i % 4]),
      ],
    )
    let resp = match auth.is_authorized(req, ps, entities) {
      Ok(r) => r
      Err(e) => {
        io_println(world, "ERR w3 auth: " + e.to_string())
        return 1
      }
    }
    format_decision_line(out, i, resp)
    i = i + 1
  }
  io_print(world, out.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: pion_cedar <w1|w2|w3> [count]")
    return 1
  }
  let mode = args[1]
  if mode == "w1" {
    let count = if args.length() >= 3 { parse_int_arg(args[2], 50) } else { 50 }
    run_w1(world, count)
  } else if mode == "w2" {
    let count = if args.length() >= 3 { parse_int_arg(args[2], 3000) } else { 3000 }
    run_w2(world, count)
  } else if mode == "w3" {
    let count = if args.length() >= 3 { parse_int_arg(args[2], 2000) } else { 2000 }
    run_w3(world, count)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
