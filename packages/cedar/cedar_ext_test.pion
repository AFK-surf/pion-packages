///| AWS Cedar extension tests: `decimal("...")` and `ip("...")` parsing,
///| canonical formatting, bounds, invalid inputs, and extension methods in policies.

fn eval_ext_expr(expr_src : String) -> Response {
  let pol_src = "@id(\"ext\") permit(principal, action, resource) when { " + expr_src + " };"
  let ps = match parse_policy_set(pol_src) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse failed for `" + expr_src + "`: " + e.to_string())
      PolicySet::{ policies: [] }
    }
  }
  let req = Request::new(
    EntityUid::new("User", "u"),
    EntityUid::new("Action", "a"),
    EntityUid::new("Resource", "r"),
    [],
  )
  match Authorizer::new().is_authorized(req, ps, Entities::empty()) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "auth failed: " + e.to_string())
      Response::{ decision: Decision::Deny, diagnostics: Diagnostics::{ reason: [], errors: [] } }
    }
  }
}

///|
test "cedar_ext_decimal_parse_and_methods" {
  // Valid decimals
  match parse_decimal("0.0") {
    Ok(d) => debug_assert(d.raw == 0L, "0.0 == 0")
    Err(e) => debug_assert(false, "0.0 failed: " + e.to_string())
  }
  match parse_decimal("-0.0000") {
    Ok(d) => debug_assert(d.raw == 0L, "-0.0000 == 0")
    Err(e) => debug_assert(false, "-0.0000 failed: " + e.to_string())
  }
  match parse_decimal("12.34") {
    Ok(d) => {
      debug_assert(d.raw == 123400L, "12.34 raw")
      debug_assert(format_decimal(d) == "12.3400", "format 12.3400")
    }
    Err(e) => debug_assert(false, "12.34 failed: " + e.to_string())
  }
  match parse_decimal("-12.0005") {
    Ok(d) => {
      debug_assert(d.raw == -120005L, "-12.0005 raw")
      debug_assert(format_decimal(d) == "-12.0005", "format -12.0005")
    }
    Err(e) => debug_assert(false, "-12.0005 failed: " + e.to_string())
  }
  // Exact min/max boundaries
  match parse_decimal("922337203685477.5807") {
    Ok(d) => debug_assert(d.raw == 9223372036854775807L, "decimal max")
    Err(e) => debug_assert(false, "decimal max failed: " + e.to_string())
  }
  match parse_decimal("-922337203685477.5808") {
    Ok(d) => debug_assert(d.raw == -9223372036854775807L - 1L, "decimal min")
    Err(e) => debug_assert(false, "decimal min failed: " + e.to_string())
  }

  // Invalid decimals
  let bad_decimals = [
    "",
    "123",
    "12.",
    ".5",
    "1.23456",
    " 1.0",
    "1.0 ",
    "+1.0",
    "1.2.3",
    "922337203685477.5808",
    "-922337203685477.5809",
    "abc.def",
  ]
  let mut i = 0
  while i < bad_decimals.length() {
    match parse_decimal(bad_decimals[i]) {
      Ok(_) => debug_assert(false, "expected invalid decimal: " + bad_decimals[i])
      Err(e) =>
      debug_assert(
        !e.is_kind(CedarErrorKind::Unimplemented),
        "real error for invalid decimal: " + bad_decimals[i],
      )
    }
    i = i + 1
  }

  // Policy evaluation with decimal methods
  let r1 = eval_ext_expr(
    "decimal(\"1.23\") == decimal(\"1.2300\") && decimal(\"1.23\").lessThan(decimal(\"1.24\")) && decimal(\"1.23\").lessThanOrEqual(decimal(\"1.2300\")) && decimal(\"2.0\").greaterThan(decimal(\"-5.5\")) && decimal(\"-1.5\").greaterThanOrEqual(decimal(\"-1.50\"))",
  )
  debug_assert(decision_eq(r1.decision, Decision::Allow), "decimal methods allow")

  let r2 = eval_ext_expr("decimal(\"1.23\").lessThan(decimal(\"1.23\"))")
  debug_assert(decision_eq(r2.decision, Decision::Deny) && r2.diagnostics.errors.length() == 0, "1.23 < 1.23 is false")
}

///|
test "cedar_ext_ip_parse_and_methods" {
  // IPv4 & CIDR
  let v4 = match parse_ip("192.168.1.42/24") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse_ip v4 failed: " + e.to_string())
      IpAddrVal::{ is_v6: false, hi: 0L, lo: 0L, prefix_len: 0 }
    }
  }
  debug_assert(ip_is_ipv4(v4) && !ip_is_ipv6(v4), "isIpv4")
  debug_assert(!ip_is_loopback(v4) && !ip_is_multicast(v4), "not loopback/multicast")

  let lo4 = match parse_ip("127.0.0.1") {
    Ok(v) => v
    Err(_) => IpAddrVal::{ is_v6: false, hi: 0L, lo: 0L, prefix_len: 0 }
  }
  debug_assert(ip_is_loopback(lo4), "127.0.0.1 isLoopback")

  let mc4 = match parse_ip("224.0.0.1/24") {
    Ok(v) => v
    Err(_) => IpAddrVal::{ is_v6: false, hi: 0L, lo: 0L, prefix_len: 0 }
  }
  debug_assert(ip_is_multicast(mc4), "224.0.0.1/24 isMulticast")

  // IPv6 & CIDR
  let lo6 = match parse_ip("::1") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "::1 failed: " + e.to_string())
      IpAddrVal::{ is_v6: false, hi: 0L, lo: 0L, prefix_len: 0 }
    }
  }
  debug_assert(ip_is_ipv6(lo6) && !ip_is_ipv4(lo6) && ip_is_loopback(lo6), "::1 isIpv6 & isLoopback")

  let mc6 = match parse_ip("ff02::1/128") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "ff02::1/128 failed: " + e.to_string())
      IpAddrVal::{ is_v6: false, hi: 0L, lo: 0L, prefix_len: 0 }
    }
  }
  debug_assert(ip_is_multicast(mc6), "ff02::1/128 isMulticast")

  // Invalid IPs
  let bad_ips = [
    "",
    "256.0.0.1",
    "1.2.3",
    "1.2.3.4.5",
    "1.2.3.4/33",
    "1.2.3.4/-1",
    "1.2.3.4/01",
    "01.2.3.4",
    "::1/129",
    "1::2::3",
    "gggg::1",
    "127.0.0.1/",
  ]
  let mut i = 0
  while i < bad_ips.length() {
    match parse_ip(bad_ips[i]) {
      Ok(_) => debug_assert(false, "expected invalid ip: " + bad_ips[i])
      Err(e) =>
      debug_assert(
        !e.is_kind(CedarErrorKind::Unimplemented),
        "real error for invalid ip: " + bad_ips[i],
      )
    }
    i = i + 1
  }

  // Policy evaluation with ip methods
  let r1 = eval_ext_expr(
    "ip(\"10.0.1.5\").isInRange(ip(\"10.0.0.0/16\")) && !ip(\"10.1.0.1\").isInRange(ip(\"10.0.0.0/16\")) && ip(\"192.168.1.1/24\") == ip(\"192.168.1.254/24\") && ip(\"10.0.0.1/32\") == ip(\"10.0.0.1\") && !ip(\"127.0.0.1\").isInRange(ip(\"::/0\")) && ip(\"2001:db8::1\").isInRange(ip(\"2001:db8::/32\"))",
  )
  debug_assert(decision_eq(r1.decision, Decision::Allow), "ip methods allow")
}
