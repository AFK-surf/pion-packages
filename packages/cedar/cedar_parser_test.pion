///| AWS Cedar lexer, parser, string escapes, precedence, reserved words,
///| annotations, scopes, and canonical formatter round-trip tests.

fn assert_policy_ok(src : String, msg : String) -> Policy {
  match parse_policy(src) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, msg + " (unexpected error: " + e.to_string() + ")")
      Policy::{
        id: "",
        annotations: [],
        effect: Effect::Permit,
        policy_scope: PolicyScope::{
          principal: PrincipalConstraint::Any,
          action: ActionConstraint::Any,
          resource: ResourceConstraint::Any,
        },
        conditions: [],
      }
    }
  }
}

fn assert_policy_err(src : String, msg : String) -> Unit {
  match parse_policy(src) {
    Ok(_) => debug_assert(false, msg + " (expected error, got Ok)")
    Err(e) =>
    debug_assert(
      !e.is_kind(CedarErrorKind::Unimplemented),
      msg + " (got Unimplemented instead of real parse/syntax error)",
    )
  }
}

fn assert_policy_set_ok(src : String, expected_len : Int, msg : String) -> PolicySet {
  match parse_policy_set(src) {
    Ok(ps) => {
      debug_assert(
        ps.len() == expected_len,
        msg + " (expected " + expected_len.to_string() + " policies, got " + ps.len().to_string() + ")",
      )
      ps
    }
    Err(e) => {
      debug_assert(false, msg + " (unexpected error: " + e.to_string() + ")")
      PolicySet::{ policies: [] }
    }
  }
}

///|
test "cedar_parser_scopes_and_effects" {
  // Unrestricted permit & forbid
  let p1 = assert_policy_ok("permit(principal, action, resource);", "basic permit")
  debug_assert(effect_eq(p1.effect, Effect::Permit), "effect permit")
  let p2 = assert_policy_ok("forbid(principal, action, resource);", "basic forbid")
  debug_assert(effect_eq(p2.effect, Effect::Forbid), "effect forbid")

  // Eq, In, InSet, Is, IsIn
  let _ = assert_policy_ok(
    "permit(principal == User::\"alice\", action == Action::\"view\", resource == Photo::\"p1\");",
    "eq scopes",
  )
  let _ = assert_policy_ok(
    "permit(principal in Group::\"eng\", action in [Action::\"read\", Action::\"write\"], resource in Album::\"a1\");",
    "in and inset scopes",
  )
  let _ = assert_policy_ok(
    "permit(principal in Org::Team::\"core\", action in Action::\"all\", resource in Org::Folder::\"root\",);",
    "namespaced in + trailing comma",
  )
  let _ = assert_policy_ok(
    "permit(principal is PhotoApp::User, action in [], resource is PhotoApp::Photo in PhotoApp::Album::\"vac\");",
    "is and is..in + empty action list",
  )
  let _ = assert_policy_ok(
    "forbid(principal is User in Group::\"blocked\", action, resource is Doc);",
    "principal is..in",
  )

  // Invalid scopes
  assert_policy_err("permit(principal, action);", "missing resource")
  assert_policy_err("permit(action, principal, resource);", "wrong scope order")
  assert_policy_err("permit(principal, action, resource)", "missing semicolon")
  assert_policy_err("allow(principal, action, resource);", "invalid effect")
  assert_policy_err("permit(principal == User, action, resource);", "entity type instead of uid")
}

///|
test "cedar_parser_annotations_and_comments" {
  let src = "// Leading comment\n@id(\"p-allow-view\")\n@advice(\"grant view access\")\npermit(\n  // inside scope\n  principal == User::\"alice\",\n  action == Action::\"view\",\n  resource\n) // before when\nwhen {\n  principal.active == true // inline\n};\n"
  let p = assert_policy_ok(src, "annotations and comments")
  debug_assert(p.id == "p-allow-view", "policy id from @id")
  debug_assert(p.annotations.length() == 2, "two annotations")
  debug_assert(p.annotations[0].key == "id" && p.annotations[0].value == "p-allow-view", "first annotation")
  debug_assert(p.annotations[1].key == "advice" && p.annotations[1].value == "grant view access", "second annotation")

  // Cedar v4 valueless annotation
  let p_v4 = assert_policy_ok("@deprecated\npermit(principal, action, resource);", "v4 empty annotation")
  debug_assert(p_v4.annotations.length() == 1 && p_v4.annotations[0].key == "deprecated", "v4 annotation key")

  // Duplicate annotation key must fail
  assert_policy_err(
    "@id(\"a\")\n@id(\"b\")\npermit(principal, action, resource);",
    "duplicate annotation key",
  )
  // Block comments are NOT valid in Cedar
  assert_policy_err("/* block */ permit(principal, action, resource);", "block comment rejected")
}

///|
test "cedar_parser_string_escapes_and_unicode" {
  let src = "permit(principal == User::\"a\\nb\\tc\\\"d\\\\e\\'f\\0g\\x41\\u{1F600}\", action, resource);"
  let p = assert_policy_ok(src, "valid escapes")
  match p.policy_scope.principal {
    PrincipalConstraint::Eq(uid) => {
      debug_assert(uid.entity_type == "User", "entity type User")
      debug_assert(uid.id.length() > 10, "decoded id length")
    }
    _ => debug_assert(false, "expected PrincipalConstraint::Eq")
  }

  // Invalid escapes & UTF-16 surrogates must be rejected
  assert_policy_err("permit(principal == User::\"\\u{D800}\", action, resource);", "high surrogate rejected")
  assert_policy_err("permit(principal == User::\"\\u{DFFF}\", action, resource);", "low surrogate rejected")
  assert_policy_err("permit(principal == User::\"\\u{110000}\", action, resource);", "out-of-range unicode rejected")
  assert_policy_err("permit(principal == User::\"\\u{}\", action, resource);", "empty unicode escape rejected")
  assert_policy_err("permit(principal == User::\"\\x80\", action, resource);", "non-ascii \\x80 rejected")
  assert_policy_err("permit(principal == User::\"\\q\", action, resource);", "unknown escape rejected")
  assert_policy_err("permit(principal == User::\"unterminated, action, resource);", "unterminated string")
  // \* is only valid in `like` patterns, not ordinary string literals
  assert_policy_err("permit(principal == User::\"a\\*b\", action, resource);", "\\* rejected in normal string")
  // \* IS valid in `like` pattern
  let _ = assert_policy_ok(
    "permit(principal, action, resource) when { resource.name like \"foo\\*bar*\" };",
    "\\* allowed in like pattern",
  )
}

///|
test "cedar_parser_integers_precedence_and_non_associative" {
  // i64::MAX and i64::MIN
  let _ = assert_policy_ok(
    "permit(principal, action, resource) when { 9223372036854775807 > -9223372036854775808 };",
    "i64 max and min",
  )
  // Overflow literal (> i64::MAX) must fail
  assert_policy_err(
    "permit(principal, action, resource) when { 9223372036854775808 > 0 };",
    "i64 literal overflow",
  )
  assert_policy_err(
    "permit(principal, action, resource) when { -9223372036854775809 < 0 };",
    "i64 negative literal overflow",
  )

  // Non-associative relational operators must fail
  assert_policy_err(
    "permit(principal, action, resource) when { 1 < 2 < 3 };",
    "chained < rejected",
  )
  assert_policy_err(
    "permit(principal, action, resource) when { 1 == 2 == 3 };",
    "chained == rejected",
  )
  // Division and modulo do not exist in Cedar
  assert_policy_err(
    "permit(principal, action, resource) when { 10 / 2 == 5 };",
    "division rejected",
  )
  assert_policy_err(
    "permit(principal, action, resource) when { 10 % 2 == 0 };",
    "modulo rejected",
  )

  // Duplicate keys in record literal must fail
  assert_policy_err(
    "permit(principal, action, resource) when { { a: 1, a: 2 }.a == 1 };",
    "duplicate record key rejected",
  )

  // Reserved keywords cannot be used as entity types
  assert_policy_err(
    "permit(principal == true::\"x\", action, resource);",
    "reserved keyword as entity type",
  )
  assert_policy_err(
    "permit(principal == __cedar::\"x\", action, resource);",
    "__cedar reserved namespace",
  )
}

///|
test "cedar_parser_policy_set_and_format_roundtrip" {
  let src = "@id(\"p1\")\npermit(\n  principal in Group::\"admins\",\n  action in [Action::\"read\", Action::\"write\"],\n  resource is Doc in Folder::\"public\"\n)\nwhen {\n  context.mfa == true && (principal.level >= 3 || resource.name like \"pub-*\")\n}\nunless {\n  resource.locked\n};\n\nforbid(principal, action == Action::\"delete\", resource)\nwhen {\n  !(principal == resource.owner)\n};\n"
  let ps = assert_policy_set_ok(src, 2, "two-policy set")
  debug_assert(ps.policies[0].id == "p1", "first policy explicit id")
  debug_assert(ps.policies[1].id == "policy1", "second policy auto id")

  let formatted = format_policy_set(ps)
  debug_assert(formatted.length() > 0, "formatted non-empty")
  let ps2 = assert_policy_set_ok(formatted, 2, "round-trip reparse")
  debug_assert(format_policy_set(ps2) == formatted, "idempotent canonical format")

  // EntityUid parse and format round-trip
  match parse_entity_uid("App::V2::User::\"alice@example.com\"") {
    Ok(uid) => {
      debug_assert(uid.entity_type == "App::V2::User", "namespaced type")
      debug_assert(uid.id == "alice@example.com", "uid id")
      debug_assert(
        format_entity_uid(uid) == "App::V2::User::\"alice@example.com\"",
        "formatted uid",
      )
    }
    Err(e) => debug_assert(false, "parse_entity_uid failed: " + e.to_string())
  }
}
