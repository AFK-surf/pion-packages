///| Pure, zero-global-state string hash map and UTF-8 / utility helpers for `packages/cedar`.

fn hash_string(s : String) -> UInt64 {
  let n = s.length()
  let mut h : UInt64 = 0xCBF29CE484222325UL ^ (n.to_int64().reinterpret_as_uint64() * 0x9E3779B97F4A7C15UL)
  let mut i = 0
  while i + 4 <= n {
    let w = s.code_unit_at(i).to_int64().reinterpret_as_uint64() |
    (s.code_unit_at(i + 1).to_int64().reinterpret_as_uint64() << 8UL) |
    (s.code_unit_at(i + 2).to_int64().reinterpret_as_uint64() << 16UL) |
    (s.code_unit_at(i + 3).to_int64().reinterpret_as_uint64() << 24UL)
    h = (h ^ w) * 0xBF58476D1CE4E5B9UL
    h = h ^ (h >> 27UL)
    i = i + 4
  }
  while i < n {
    h = (h ^ s.code_unit_at(i).to_int64().reinterpret_as_uint64()) * 0x94D049BB133111EBUL
    h = h ^ (h >> 31UL)
    i = i + 1
  }
  h = (h ^ (h >> 30UL)) * 0xBF58476D1CE4E5B9UL
  h = (h ^ (h >> 27UL)) * 0x94D049BB133111EBUL
  h ^ (h >> 31UL)
}

///| Canonical lookup key for an `EntityUid` (`entity_type + "\x00" + id`).
///| Uses NUL separator (unambiguous since type names are ASCII identifiers/::).
fn entity_uid_key(uid : EntityUid) -> String {
  uid.entity_type + "\u{0}" + uid.id
}

///| Encode a valid Unicode scalar value (`0..0x10FFFF`, non-surrogate) as UTF-8 into `sb`.
fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp <= 0x7F {
    sb.write_byte(cp.to_byte())
  } else if cp <= 0x7FF {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp <= 0xFFFF {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Write a Cedar-escaped string literal (without surrounding quotes) into `sb`.
fn write_cedar_escaped(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 {
      sb.write_string("\\\"")
    } else if b == 92 {
      sb.write_string("\\\\")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 9 {
      sb.write_string("\\t")
    } else if b == 0 {
      sb.write_string("\\0")
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
}

///| Validate `CedarLimits`.
fn validate_limits_impl(limits : CedarLimits) -> Result[Unit, CedarError] {
  if limits.max_depth <= 0 {
    return Err(CedarError::new(CedarErrorKind::InvalidLimits, -1, "max_depth must be positive"))
  }
  if limits.max_depth > max_safe_depth() {
    return Err(
      CedarError::new(
        CedarErrorKind::InvalidLimits,
        -1,
        "max_depth exceeds safe ceiling (" + max_safe_depth().to_string() + ")",
      ),
    )
  }
  if limits.max_tokens <= 0 {
    return Err(CedarError::new(CedarErrorKind::InvalidLimits, -1, "max_tokens must be positive"))
  }
  if limits.max_policies <= 0 {
    return Err(CedarError::new(CedarErrorKind::InvalidLimits, -1, "max_policies must be positive"))
  }
  if limits.max_entities <= 0 {
    return Err(CedarError::new(CedarErrorKind::InvalidLimits, -1, "max_entities must be positive"))
  }
  if limits.max_steps <= 0 {
    return Err(CedarError::new(CedarErrorKind::InvalidLimits, -1, "max_steps must be positive"))
  }
  Ok(())
}

///| Decode a single UTF-8 code point starting at byte `pos` in `s`.
///| Returns `(codepoint, next_pos)`.
fn decode_utf8_at(s : String, pos : Int) -> (Int, Int) {
  let n = s.length()
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    (b0, pos + 1)
  } else if (b0 & 0xE0) == 0xC0 && pos + 1 < n {
    let b1 = s.code_unit_at(pos + 1)
    (((b0 & 0x1F) << 6) | (b1 & 0x3F), pos + 2)
  } else if (b0 & 0xF0) == 0xE0 && pos + 2 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), pos + 3)
  } else if (b0 & 0xF8) == 0xF0 && pos + 3 < n {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    (
      ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F),
      pos + 4,
    )
  } else {
    (b0, pos + 1)
  }
}

///| Fast open-addressed `String -> Int` hash map (no global mutable state).
struct StrIntMap {
  mut cap : Int
  mut len : Int
  mut keys : FixedArray[String]
  mut used : FixedArray[Bool]
  mut vals : FixedArray[Int]
}

fn StrIntMap::new(initial_cap : Int) -> StrIntMap {
  let mut c = 16
  while c < initial_cap * 2 {
    c = c << 1
  }
  StrIntMap::{
    cap: c,
    len: 0,
    keys: FixedArray::make(c, ""),
    used: FixedArray::make(c, false),
    vals: FixedArray::make(c, 0),
  }
}

fn StrIntMap::grow(self : StrIntMap) -> Unit {
  let old_cap = self.cap
  let old_keys = self.keys
  let old_used = self.used
  let old_vals = self.vals
  let new_cap = old_cap << 1
  let new_keys = FixedArray::make(new_cap, "")
  let new_used = FixedArray::make(new_cap, false)
  let new_vals = FixedArray::make(new_cap, 0)
  let mask = new_cap - 1
  let mut i = 0
  while i < old_cap {
    if old_used[i] {
      let k = old_keys[i]
      let mut slot = hash_string(k).to_int64().to_int() & mask
      while new_used[slot] {
        slot = (slot + 1) & mask
      }
      new_used[slot] = true
      new_keys[slot] = k
      new_vals[slot] = old_vals[i]
    }
    i = i + 1
  }
  self.cap = new_cap
  self.keys = new_keys
  self.used = new_used
  self.vals = new_vals
}

fn StrIntMap::get(self : StrIntMap, key : String) -> Int {
  let mask = self.cap - 1
  let mut slot = hash_string(key).to_int64().to_int() & mask
  while self.used[slot] {
    if self.keys[slot] == key {
      return self.vals[slot]
    }
    slot = (slot + 1) & mask
  }
  -1
}

///| Insert `key -> val`. Returns `true` if newly inserted, `false` if key already existed.
fn StrIntMap::insert(self : StrIntMap, key : String, v : Int) -> Bool {
  if (self.len + 1) * 10 >= self.cap * 7 {
    self.grow()
  }
  let mask = self.cap - 1
  let mut slot = hash_string(key).to_int64().to_int() & mask
  while self.used[slot] {
    if self.keys[slot] == key {
      self.vals[slot] = v
      return false
    }
    slot = (slot + 1) & mask
  }
  self.used[slot] = true
  self.keys[slot] = key
  self.vals[slot] = v
  self.len = self.len + 1
  true
}
