///| Core types, AST, values, entities, authorization responses, limits, and errors
///| for `packages/cedar` (AWS Cedar policy language & authorization engine).

///| Category of a `CedarError`.
pub enum CedarErrorKind {
  SyntaxError
  ParseError
  EntityError
  JsonError
  EvalError
  TypeError
  IntegerOverflow
  EntityDoesNotExist
  AttrNotFound
  TagNotFound
  ExtensionError
  LimitExceeded
  InvalidLimits
  Unimplemented
}

///| Structured error returned by Cedar parsing, entity loading, and evaluation.
pub val struct CedarError {
  pub kind : CedarErrorKind
  pub pos : Int
  pub message : String
}

///| Construct a `CedarError`.
pub fn CedarError::new(
  kind : CedarErrorKind,
  pos : Int,
  message : String,
) -> CedarError {
  CedarError::{ kind, pos, message }
}

///| Check whether `self` has the expected `CedarErrorKind`.
pub fn CedarError::is_kind(self : CedarError, expected : CedarErrorKind) -> Bool {
  cedar_error_kind_code(self.kind) == cedar_error_kind_code(expected)
}

///| Format a `CedarError` as a human-readable string.
pub fn CedarError::to_string(self : CedarError) -> String {
  let prefix = cedar_error_kind_as_str(self.kind)
  if self.pos >= 0 {
    prefix + " at offset " + self.pos.to_string() + ": " + self.message
  } else {
    prefix + ": " + self.message
  }
}

fn cedar_error_kind_code(k : CedarErrorKind) -> Int {
  match k {
    CedarErrorKind::SyntaxError => 1
    CedarErrorKind::ParseError => 2
    CedarErrorKind::EntityError => 3
    CedarErrorKind::JsonError => 4
    CedarErrorKind::EvalError => 5
    CedarErrorKind::TypeError => 6
    CedarErrorKind::IntegerOverflow => 7
    CedarErrorKind::EntityDoesNotExist => 8
    CedarErrorKind::AttrNotFound => 9
    CedarErrorKind::TagNotFound => 10
    CedarErrorKind::ExtensionError => 11
    CedarErrorKind::LimitExceeded => 12
    CedarErrorKind::InvalidLimits => 13
    CedarErrorKind::Unimplemented => 14
  }
}

///| Return a short string name for a `CedarErrorKind`.
pub fn cedar_error_kind_as_str(k : CedarErrorKind) -> String {
  match k {
    CedarErrorKind::SyntaxError => "syntax error"
    CedarErrorKind::ParseError => "parse error"
    CedarErrorKind::EntityError => "entity error"
    CedarErrorKind::JsonError => "json error"
    CedarErrorKind::EvalError => "eval error"
    CedarErrorKind::TypeError => "type error"
    CedarErrorKind::IntegerOverflow => "integer overflow"
    CedarErrorKind::EntityDoesNotExist => "entity does not exist"
    CedarErrorKind::AttrNotFound => "attribute not found"
    CedarErrorKind::TagNotFound => "tag not found"
    CedarErrorKind::ExtensionError => "extension error"
    CedarErrorKind::LimitExceeded => "limit exceeded"
    CedarErrorKind::InvalidLimits => "invalid limits"
    CedarErrorKind::Unimplemented => "unimplemented"
  }
}

///| Configurable resource and recursion limits for Cedar parsing, entity loading,
///| and evaluation to prevent stack overflow and DoS on Native and Wasm32.
pub val struct CedarLimits {
  pub max_depth : Int
  pub max_tokens : Int
  pub max_policies : Int
  pub max_entities : Int
  pub max_steps : Int
}

///| Default safety limits.
pub fn CedarLimits::default() -> CedarLimits {
  CedarLimits::{
    max_depth: 128,
    max_tokens: 131072,
    max_policies: 10000,
    max_entities: 100000,
    max_steps: 1000000,
  }
}

///| Construct custom `CedarLimits`.
pub fn CedarLimits::new(
  max_depth : Int,
  max_tokens : Int,
  max_policies : Int,
  max_entities : Int,
  max_steps : Int,
) -> CedarLimits {
  CedarLimits::{ max_depth, max_tokens, max_policies, max_entities, max_steps }
}

///| Maximum safe nesting depth across Native and Wasm32.
pub fn max_safe_depth() -> Int {
  256
}

///| Cedar Entity UID: `Namespace::Type::"id"` (e.g. `User::"alice"`).
pub val struct EntityUid {
  pub entity_type : String
  pub id : String
}

///| Construct an `EntityUid`.
pub fn EntityUid::new(entity_type : String, id : String) -> EntityUid {
  EntityUid::{ entity_type, id }
}

///| Structural equality on `EntityUid`.
pub fn EntityUid::equals(self : EntityUid, other : EntityUid) -> Bool {
  self.entity_type == other.entity_type && self.id == other.id
}

///| Fixed-point decimal extension value (4 fractional digits, scaled by 10^4).
///| Range: `-922337203685477.5808` to `922337203685477.5807`.
pub val struct DecimalVal {
  pub raw : Int64
}

///| Construct a `DecimalVal` from raw scaled `Int64` (value * 10000).
pub fn DecimalVal::from_raw(raw : Int64) -> DecimalVal {
  DecimalVal::{ raw }
}

///| IP address / CIDR range extension value (IPv4 or IPv6).
///| Host bits are normalized (masked to 0) according to `prefix_len`.
pub val struct IpAddrVal {
  pub is_v6 : Bool
  pub hi : Int64
  pub lo : Int64
  pub prefix_len : Int
}

///| Policy effect: `permit` or `forbid`.
pub enum Effect {
  Permit
  Forbid
}

///| Structural equality on `Effect`.
pub fn effect_eq(a : Effect, b : Effect) -> Bool {
  match (a, b) {
    (Effect::Permit, Effect::Permit) => true
    (Effect::Forbid, Effect::Forbid) => true
    _ => false
  }
}

///| Scope constraint on `principal`.
pub enum PrincipalConstraint {
  Any
  Eq(EntityUid)
  In(EntityUid)
  Is(String)
  IsIn(String, EntityUid)
}

///| Scope constraint on `action`.
pub enum ActionConstraint {
  Any
  Eq(EntityUid)
  In(EntityUid)
  InSet(Array[EntityUid])
}

///| Scope constraint on `resource`.
pub enum ResourceConstraint {
  Any
  Eq(EntityUid)
  In(EntityUid)
  Is(String)
  IsIn(String, EntityUid)
}

///| Policy scope triple (`principal`, `action`, `resource`).
pub struct PolicyScope {
  pub principal : PrincipalConstraint
  pub action : ActionConstraint
  pub resource : ResourceConstraint
}

///| Policy annotation (`@id("...")`, `@key("value")`, or `@key`).
pub val struct Annotation {
  pub key : String
  pub value : String
}

///| Condition clause kind (`when` or `unless`).
pub enum ConditionKind {
  When
  Unless
}

///| Policy condition clause (`when { expr }` or `unless { expr }`).
pub struct Condition {
  pub kind : ConditionKind
  pub expr : Expr
}

///| Built-in Cedar variables.
pub enum Var {
  Principal
  Action
  Resource
  Context
}

///| Unary operators.
pub enum UnaryOp {
  Not
  Neg
}

///| Binary operators.
pub enum BinaryOp {
  Or
  And
  Eq
  Neq
  Lt
  Le
  Gt
  Ge
  In
  Add
  Sub
  Mul
}

///| Element of a compiled `like` pattern.
pub enum PatternElem {
  Wildcard
  Literal(Int)
}

///| Cedar expression AST.
pub enum Expr {
  BoolLit(Bool)
  LongLit(Int64)
  StrLit(String)
  EntityLit(EntityUid)
  Var(Var)
  Unary(UnaryOp, Expr)
  Binary(BinaryOp, Expr, Expr)
  If(Expr, Expr, Expr)
  GetAttr(Expr, String)
  HasAttr(Expr, String)
  Like(Expr, Array[PatternElem], String)
  Is(Expr, String)
  IsIn(Expr, String, Expr)
  SetLit(Array[Expr])
  RecordLit(Array[(String, Expr)])
  MethodCall(Expr, String, Array[Expr])
  ExtCall(String, Array[Expr])
}

///| A single parsed Cedar policy.
pub struct Policy {
  pub id : String
  pub annotations : Array[Annotation]
  pub effect : Effect
  pub policy_scope : PolicyScope
  pub conditions : Array[Condition]
}

///| A collection of Cedar policies.
pub struct PolicySet {
  pub policies : Array[Policy]
}

///| Return the number of policies in a `PolicySet`.
pub fn PolicySet::len(self : PolicySet) -> Int {
  self.policies.length()
}

///| Runtime Cedar value.
pub enum Value {
  Bool(Bool)
  Long(Int64)
  String(String)
  Entity(EntityUid)
  Set(Array[Value])
  Record(Array[(String, Value)])
  Decimal(DecimalVal)
  IpAddr(IpAddrVal)
}

///| A single entity in the Cedar entity store.
pub struct Entity {
  pub uid : EntityUid
  pub attrs : Array[(String, Value)]
  pub parents : Array[EntityUid]
  pub tags : Array[(String, Value)]
}

///| Construct an `Entity` without tags.
pub fn Entity::new(
  uid : EntityUid,
  attrs : Array[(String, Value)],
  parents : Array[EntityUid],
) -> Entity {
  Entity::{ uid, attrs, parents, tags: [] }
}

///| Construct an `Entity` with Cedar v4 tags.
pub fn Entity::with_tags(
  uid : EntityUid,
  attrs : Array[(String, Value)],
  parents : Array[EntityUid],
  tags : Array[(String, Value)],
) -> Entity {
  Entity::{ uid, attrs, parents, tags }
}

///| Indexed Cedar entity store with precomputed cycle-safe transitive closure.
pub struct Entities {
  pub items : Array[Entity]
  uid_keys : Array[String]
  uid_buckets : Array[Int]
  uid_next : Array[Int]
  ancestors : Array[Array[Int]]
}

///| Return the number of entities in the store.
pub fn Entities::len(self : Entities) -> Int {
  self.items.length()
}

///| Cedar authorization request.
pub struct Request {
  pub principal : EntityUid
  pub action : EntityUid
  pub resource : EntityUid
  pub context : Array[(String, Value)]
}

///| Construct a `Request`.
pub fn Request::new(
  principal : EntityUid,
  action : EntityUid,
  resource : EntityUid,
  context : Array[(String, Value)],
) -> Request {
  Request::{ principal, action, resource, context }
}

///| Authorization decision: `Allow` or `Deny`.
pub enum Decision {
  Allow
  Deny
}

///| Structural equality on `Decision`.
pub fn decision_eq(a : Decision, b : Decision) -> Bool {
  match (a, b) {
    (Decision::Allow, Decision::Allow) => true
    (Decision::Deny, Decision::Deny) => true
    _ => false
  }
}

///| Error encountered while evaluating a single policy during authorization.
pub val struct PolicyEvalError {
  pub policy_id : String
  pub error : CedarError
}

///| Authorization diagnostics: determining policy IDs and per-policy errors.
pub struct Diagnostics {
  pub reason : Array[String]
  pub errors : Array[PolicyEvalError]
}

///| Result of `Authorizer::is_authorized`.
pub struct Response {
  pub decision : Decision
  pub diagnostics : Diagnostics
}

///| Cedar authorization engine.
pub val struct Authorizer {
  pub limits : CedarLimits
}

///| Construct an `Authorizer` with default limits.
pub fn Authorizer::new() -> Authorizer {
  Authorizer::{ limits: CedarLimits::default() }
}

///| Construct an `Authorizer` with custom limits.
pub fn Authorizer::with_limits(limits : CedarLimits) -> Authorizer {
  Authorizer::{ limits }
}
