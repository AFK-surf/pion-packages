///| AWS Cedar `decimal` extension: fixed-point 4-decimal-place signed 64-bit value.
///| Range: `-922337203685477.5808` .. `922337203685477.5807` (raw * 10^-4).

fn parse_decimal_impl(input : String) -> Result[DecimalVal, CedarError] {
  let n = input.length()
  if n == 0 {
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "empty decimal string"))
  }
  let mut pos = 0
  let mut neg = false
  if input.code_unit_at(pos) == 45 {
    // '-'
    neg = true
    pos = pos + 1
  }
  if pos >= n {
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "invalid decimal string: " + input))
  }

  // Parse integer part (must have at least 1 ASCII digit)
  let int_start = pos
  let mut int_part : UInt64 = 0UL
  let max_int_abs : UInt64 = 922337203685477UL
  while pos < n {
    let b = input.code_unit_at(pos)
    if b >= 48 && b <= 57 {
      let d = (b - 48).to_int64().reinterpret_as_uint64()
      if int_part > max_int_abs {
        return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "decimal overflow: " + input))
      }
      int_part = int_part * 10UL + d
      if int_part > max_int_abs {
        return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "decimal overflow: " + input))
      }
      pos = pos + 1
    } else {
      break
    }
  }
  if pos == int_start {
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "decimal missing integer digits: " + input))
  }
  if pos >= n || input.code_unit_at(pos) != 46 {
    // '.'
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "decimal missing '.' separator: " + input))
  }
  pos = pos + 1

  // Parse fractional part (1 to 4 ASCII digits)
  let frac_start = pos
  let mut frac_part : UInt64 = 0UL
  let mut frac_digits = 0
  while pos < n {
    let b = input.code_unit_at(pos)
    if b >= 48 && b <= 57 {
      frac_digits = frac_digits + 1
      if frac_digits > 4 {
        return Err(
          CedarError::new(CedarErrorKind::ExtensionError, -1, "decimal has more than 4 fractional digits: " + input),
        )
      }
      frac_part = frac_part * 10UL + (b - 48).to_int64().reinterpret_as_uint64()
      pos = pos + 1
    } else {
      return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "invalid character in decimal: " + input))
    }
  }
  if pos == frac_start {
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "decimal missing fractional digits: " + input))
  }
  // Scale fractional part to 4 digits
  while frac_digits < 4 {
    frac_part = frac_part * 10UL
    frac_digits = frac_digits + 1
  }

  let mag : UInt64 = int_part * 10000UL + frac_part
  let max_pos : UInt64 = 9223372036854775807UL
  let max_neg : UInt64 = 9223372036854775808UL
  if neg {
    if mag > max_neg {
      return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "decimal underflow: " + input))
    }
    if mag == max_neg {
      Ok(DecimalVal::{ raw: -9223372036854775807L - 1L })
    } else if mag == 0UL {
      Ok(DecimalVal::{ raw: 0L })
    } else {
      Ok(DecimalVal::{ raw: 0L - mag.reinterpret_as_int64() })
    }
  } else {
    if mag > max_pos {
      return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "decimal overflow: " + input))
    }
    Ok(DecimalVal::{ raw: mag.reinterpret_as_int64() })
  }
}

fn format_decimal_impl(d : DecimalVal) -> String {
  let sb = StringBuilder::new()
  let mut mag : UInt64 = 0UL
  if d.raw < 0L {
    sb.write_string("-")
    if d.raw == -9223372036854775807L - 1L {
      mag = 9223372036854775808UL
    } else {
      mag = (0L - d.raw).reinterpret_as_uint64()
    }
  } else {
    mag = d.raw.reinterpret_as_uint64()
  }
  let int_part = mag / 10000UL
  let frac_part = (mag % 10000UL).to_int64().to_int()
  sb.write_string(int_part.to_string())
  sb.write_string(".")
  let d3 = frac_part / 1000
  let d2 = (frac_part / 100) % 10
  let d1 = (frac_part / 10) % 10
  let d0 = frac_part % 10
  sb.write_byte((48 + d3).to_byte())
  sb.write_byte((48 + d2).to_byte())
  sb.write_byte((48 + d1).to_byte())
  sb.write_byte((48 + d0).to_byte())
  sb.to_string()
}
