///| Indexed Cedar Entity Store with cycle-safe precomputed transitive closure
///| and Cedar JSON Entities / Request deserialization via `packages/json5`.

import "json5"

fn entities_lookup_idx(es : Entities, key : String) -> Int {
  let nb = es.uid_buckets.length()
  if nb == 0 {
    return -1
  }
  let mask = nb - 1
  let b = hash_string(key).to_int64().to_int() & mask
  let mut cur = es.uid_buckets[b]
  while cur >= 0 {
    if es.uid_keys[cur] == key {
      return cur
    }
    cur = es.uid_next[cur]
  }
  -1
}

fn sort_ints_asc(arr : Array[Int]) -> Unit {
  let n = arr.length()
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && arr[j] > key {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

fn binary_search_int(arr : Array[Int], target : Int) -> Bool {
  let mut lo = 0
  let mut hi = arr.length() - 1
  while lo <= hi {
    let mid = lo + ((hi - lo) >> 1)
    let v = arr[mid]
    if v == target {
      return true
    } else if v < target {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  false
}

fn entities_from_array_impl(
  entities : Array[Entity],
  limits : CedarLimits,
) -> Result[Entities, CedarError] {
  let _ = match validate_limits_impl(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = entities.length()
  if n > limits.max_entities {
    return Err(CedarError::new(CedarErrorKind::LimitExceeded, -1, "entity count exceeds max_entities"))
  }
  if n == 0 {
    return Ok(Entities::empty())
  }

  // Assign indices 0..n-1 to real entities, and n..m-1 to parent-only virtual UIDs.
  let uid_keys : Array[String] = []
  let idx_map = StrIntMap::new(n * 2)
  let mut i = 0
  while i < n {
    let k = entity_uid_key(entities[i].uid)
    if !idx_map.insert(k, i) {
      return Err(
        CedarError::new(
          CedarErrorKind::EntityError,
          -1,
          "duplicate entity uid: " + format_entity_uid_impl(entities[i].uid),
        ),
      )
    }
    uid_keys.push(k)
    i = i + 1
  }

  // Build direct parent adjacency list (indices into uid_keys)
  let direct_parents : Array[Array[Int]] = []
  i = 0
  while i < n {
    let ps = entities[i].parents
    let p_idxs : Array[Int] = []
    let mut j = 0
    while j < ps.length() {
      let pk = entity_uid_key(ps[j])
      let mut pidx = idx_map.get(pk)
      if pidx < 0 {
        pidx = uid_keys.length()
        let _ = idx_map.insert(pk, pidx)
        uid_keys.push(pk)
      }
      p_idxs.push(pidx)
      j = j + 1
    }
    direct_parents.push(p_idxs)
    i = i + 1
  }

  // Build chained hash table for fast zero-alloc lookups on immutable `Entities`
  let total_uids = uid_keys.length()
  let mut nb = 16
  while nb < total_uids * 2 {
    nb = nb << 1
  }
  let uid_buckets : Array[Int] = []
  let mut b = 0
  while b < nb {
    uid_buckets.push(-1)
    b = b + 1
  }
  let uid_next : Array[Int] = []
  let mask = nb - 1
  i = 0
  while i < total_uids {
    let slot = hash_string(uid_keys[i]).to_int64().to_int() & mask
    uid_next.push(uid_buckets[slot])
    uid_buckets[slot] = i
    i = i + 1
  }

  // Precompute cycle-safe transitive ancestor closure for each real entity `0..n-1`
  // using iterative BFS with stamp array (O(1) reset per entity).
  let visited = FixedArray::make(total_uids, 0)
  let ancestors : Array[Array[Int]] = []
  let queue : Array[Int] = []
  let mut stamp = 0
  i = 0
  while i < n {
    stamp = stamp + 1
    visited[i] = stamp
    let anc : Array[Int] = []
    let mut qhead = 0
    queue.clear()
    let dps = direct_parents[i]
    let mut j = 0
    while j < dps.length() {
      let p = dps[j]
      if visited[p] != stamp {
        visited[p] = stamp
        anc.push(p)
        if p < n {
          queue.push(p)
        }
      }
      j = j + 1
    }
    while qhead < queue.length() {
      let cur = queue[qhead]
      qhead = qhead + 1
      let cps = direct_parents[cur]
      let mut k = 0
      while k < cps.length() {
        let p = cps[k]
        if visited[p] != stamp {
          visited[p] = stamp
          anc.push(p)
          if p < n {
            queue.push(p)
          }
        }
        k = k + 1
      }
    }
    sort_ints_asc(anc)
    ancestors.push(anc)
    i = i + 1
  }

  Ok(Entities::{ items: entities, uid_keys, uid_buckets, uid_next, ancestors })
}

fn entities_get_impl(es : Entities, uid : EntityUid) -> Option[Entity] {
  let idx = entities_lookup_idx(es, entity_uid_key(uid))
  if idx >= 0 && idx < es.items.length() {
    Some(es.items[idx])
  } else {
    None
  }
}

fn entities_is_in_impl(es : Entities, child : EntityUid, parent : EntityUid) -> Bool {
  if child.equals(parent) {
    return true
  }
  let c_idx = entities_lookup_idx(es, entity_uid_key(child))
  if c_idx < 0 || c_idx >= es.items.length() {
    return false
  }
  let p_idx = entities_lookup_idx(es, entity_uid_key(parent))
  if p_idx < 0 {
    return false
  }
  binary_search_int(es.ancestors[c_idx], p_idx)
}

// ---------------------------------------------------------------------------
// Cedar JSON Entities & Request Deserialization (reusing `packages/json5`)
// ---------------------------------------------------------------------------

fn json_obj_find(entries : Array[(String, json5::Json5Value)], key : String) -> Option[json5::Json5Value] {
  let mut i = entries.length() - 1
  while i >= 0 {
    let (k, v) = entries[i]
    if k == key {
      return Some(v)
    }
    i = i - 1
  }
  None
}

fn json_parse_uid(jval : json5::Json5Value) -> Result[EntityUid, CedarError] {
  match jval {
    json5::Json5Value::Object(entries) => {
      // Allow `{ "__entity": { "type": ..., "id": ... } }` or `{ "type": ..., "id": ... }`
      match json_obj_find(entries, "__entity") {
        Some(inner) => json_parse_uid(inner)
        None => {
          let ty = match json_obj_find(entries, "type") {
            Some(json5::Json5Value::Str(s)) => s
            _ => return Err(CedarError::new(CedarErrorKind::JsonError, -1, "entity uid missing string 'type'"))
          }
          let id = match json_obj_find(entries, "id") {
            Some(json5::Json5Value::Str(s)) => s
            _ => return Err(CedarError::new(CedarErrorKind::JsonError, -1, "entity uid missing string 'id'"))
          }
          Ok(EntityUid::new(ty, id))
        }
      }
    }
    _ => Err(CedarError::new(CedarErrorKind::JsonError, -1, "expected JSON object for EntityUid"))
  }
}

fn json_to_cedar_value(
  jval : json5::Json5Value,
  depth : Int,
  max_depth : Int,
) -> Result[Value, CedarError] {
  if depth > max_depth {
    return Err(CedarError::new(CedarErrorKind::LimitExceeded, -1, "JSON value nesting exceeds max_depth"))
  }
  match jval {
    json5::Json5Value::Bool(b) => Ok(Value::Bool(b))
    json5::Json5Value::Str(s) => Ok(Value::String(s))
    json5::Json5Value::Null =>
    Err(CedarError::new(CedarErrorKind::JsonError, -1, "Cedar does not support JSON null values"))
    json5::Json5Value::Number(d) => {
      if d != d || d > 9007199254740992.0 || d < -9007199254740992.0 {
        return Err(CedarError::new(CedarErrorKind::JsonError, -1, "JSON number out of exact integer range"))
      }
      let i64_v = d.to_int64()
      if i64_v.to_double() != d {
        return Err(CedarError::new(CedarErrorKind::JsonError, -1, "Cedar does not support floating-point numbers"))
      }
      Ok(Value::Long(i64_v))
    }
    json5::Json5Value::Array(arr) => {
      let out : Array[Value] = []
      let mut i = 0
      while i < arr.length() {
        let v = match json_to_cedar_value(arr[i], depth + 1, max_depth) {
          Ok(cv) => cv
          Err(e) => return Err(e)
        }
        set_insert_unique(out, v)
        i = i + 1
      }
      Ok(Value::Set(out))
    }
    json5::Json5Value::Object(entries) => {
      // Check for `__entity` escape
      if entries.length() == 1 {
        let (k0, v0) = entries[0]
        if k0 == "__entity" {
          let uid = match json_parse_uid(v0) {
            Ok(u) => u
            Err(e) => return Err(e)
          }
          return Ok(Value::Entity(uid))
        }
        if k0 == "__extn" {
          return json_parse_extn(v0)
        }
      }
      let rec : Array[(String, Value)] = []
      let mut i = 0
      while i < entries.length() {
        let (k, v) = entries[i]
        let cv = match json_to_cedar_value(v, depth + 1, max_depth) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        rec.push((k, cv))
        i = i + 1
      }
      Ok(Value::Record(rec))
    }
  }
}

fn json_parse_extn(jval : json5::Json5Value) -> Result[Value, CedarError] {
  match jval {
    json5::Json5Value::Object(entries) => {
      let fn_name = match json_obj_find(entries, "fn") {
        Some(json5::Json5Value::Str(s)) => s
        _ => return Err(CedarError::new(CedarErrorKind::JsonError, -1, "__extn missing string 'fn'"))
      }
      let arg_str = match json_obj_find(entries, "arg") {
        Some(json5::Json5Value::Str(s)) => s
        _ => return Err(CedarError::new(CedarErrorKind::JsonError, -1, "__extn missing string 'arg'"))
      }
      if fn_name == "ip" {
        match parse_ip_impl(arg_str) {
          Ok(ip) => Ok(Value::IpAddr(ip))
          Err(e) => Err(e)
        }
      } else if fn_name == "decimal" {
        match parse_decimal_impl(arg_str) {
          Ok(dec) => Ok(Value::Decimal(dec))
          Err(e) => Err(e)
        }
      } else {
        Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "unknown extension function: " + fn_name))
      }
    }
    _ => Err(CedarError::new(CedarErrorKind::JsonError, -1, "__extn must be a JSON object"))
  }
}

fn json_parse_record_attrs(
  jval : json5::Json5Value,
  max_depth : Int,
) -> Result[Array[(String, Value)], CedarError] {
  match jval {
    json5::Json5Value::Object(entries) => {
      let out : Array[(String, Value)] = []
      let mut i = 0
      while i < entries.length() {
        let (k, v) = entries[i]
        let cv = match json_to_cedar_value(v, 1, max_depth) {
          Ok(x) => x
          Err(e) => return Err(e)
        }
        out.push((k, cv))
        i = i + 1
      }
      Ok(out)
    }
    _ => Err(CedarError::new(CedarErrorKind::JsonError, -1, "expected JSON object for attrs/tags/context"))
  }
}

fn entities_from_json5_impl(
  jval : json5::Json5Value,
  limits : CedarLimits,
) -> Result[Entities, CedarError] {
  let _ = match validate_limits_impl(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match jval {
    json5::Json5Value::Array(items) => {
      if items.length() > limits.max_entities {
        return Err(CedarError::new(CedarErrorKind::LimitExceeded, -1, "entity count exceeds max_entities"))
      }
      let out : Array[Entity] = []
      let mut i = 0
      while i < items.length() {
        match items[i] {
          json5::Json5Value::Object(entries) => {
            let uid = match json_obj_find(entries, "uid") {
              Some(u) =>
              match json_parse_uid(u) {
                Ok(uid_v) => uid_v
                Err(e) => return Err(e)
              }
              None => return Err(CedarError::new(CedarErrorKind::JsonError, -1, "entity missing 'uid'"))
            }
            let attrs = match json_obj_find(entries, "attrs") {
              Some(a) =>
              match json_parse_record_attrs(a, limits.max_depth) {
                Ok(vs) => vs
                Err(e) => return Err(e)
              }
              None => []
            }
            let parents : Array[EntityUid] = []
            match json_obj_find(entries, "parents") {
              Some(json5::Json5Value::Array(ps)) => {
                let mut j = 0
                while j < ps.length() {
                  let pu = match json_parse_uid(ps[j]) {
                    Ok(u) => u
                    Err(e) => return Err(e)
                  }
                  parents.push(pu)
                  j = j + 1
                }
              }
              None => ()
              _ => return Err(CedarError::new(CedarErrorKind::JsonError, -1, "entity 'parents' must be a JSON array"))
            }
            let tags = match json_obj_find(entries, "tags") {
              Some(t) =>
              match json_parse_record_attrs(t, limits.max_depth) {
                Ok(vs) => vs
                Err(e) => return Err(e)
              }
              None => []
            }
            out.push(Entity::with_tags(uid, attrs, parents, tags))
          }
          _ => return Err(CedarError::new(CedarErrorKind::JsonError, -1, "entity entry must be a JSON object"))
        }
        i = i + 1
      }
      entities_from_array_impl(out, limits)
    }
    _ => Err(CedarError::new(CedarErrorKind::JsonError, -1, "Cedar entities JSON must be an array"))
  }
}

fn entities_from_json_impl(src : String, limits : CedarLimits) -> Result[Entities, CedarError] {
  let _ = match validate_limits_impl(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let opts = json5::ParseOptions::strict_json()
  let jval = match json5::parse_with_options(src, opts) {
    Ok(v) => v
    Err(e) => return Err(CedarError::new(CedarErrorKind::JsonError, e.offset, e.message))
  }
  entities_from_json5_impl(jval, limits)
}

fn request_from_json5_impl(
  jval : json5::Json5Value,
  limits : CedarLimits,
) -> Result[Request, CedarError] {
  let _ = match validate_limits_impl(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match jval {
    json5::Json5Value::Object(entries) => {
      let principal = match json_obj_find(entries, "principal") {
        Some(v) =>
        match json_parse_uid(v) {
          Ok(u) => u
          Err(e) => return Err(e)
        }
        None => return Err(CedarError::new(CedarErrorKind::JsonError, -1, "request missing 'principal'"))
      }
      let action = match json_obj_find(entries, "action") {
        Some(v) =>
        match json_parse_uid(v) {
          Ok(u) => u
          Err(e) => return Err(e)
        }
        None => return Err(CedarError::new(CedarErrorKind::JsonError, -1, "request missing 'action'"))
      }
      let resource = match json_obj_find(entries, "resource") {
        Some(v) =>
        match json_parse_uid(v) {
          Ok(u) => u
          Err(e) => return Err(e)
        }
        None => return Err(CedarError::new(CedarErrorKind::JsonError, -1, "request missing 'resource'"))
      }
      let context = match json_obj_find(entries, "context") {
        Some(v) =>
        match json_parse_record_attrs(v, limits.max_depth) {
          Ok(c) => c
          Err(e) => return Err(e)
        }
        None => []
      }
      Ok(Request::new(principal, action, resource, context))
    }
    _ => Err(CedarError::new(CedarErrorKind::JsonError, -1, "Cedar request JSON must be an object"))
  }
}

fn request_from_json_impl(src : String, limits : CedarLimits) -> Result[Request, CedarError] {
  let _ = match validate_limits_impl(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let opts = json5::ParseOptions::strict_json()
  let jval = match json5::parse_with_options(src, opts) {
    Ok(v) => v
    Err(e) => return Err(CedarError::new(CedarErrorKind::JsonError, e.offset, e.message))
  }
  request_from_json5_impl(jval, limits)
}
