///| AWS Cedar v4/v3 lexer with strict string escape validation (`\x00..\x7F`,
///| `\u{...}` rejecting UTF-16 surrogates, raw `like` pattern retention for `\*`),
///| `//` comments, and `max_tokens` DoS enforcement.

enum TokKind {
  Eof
  Ident
  IntLit
  StrLit
  LParen
  RParen
  LBrace
  RBrace
  LBracket
  RBracket
  Comma
  Semicolon
  Colon
  ColonColon
  Dot
  At
  Plus
  Minus
  Star
  Bang
  EqEq
  BangEq
  Lt
  Le
  Gt
  Ge
  AndAnd
  OrOr
}

struct Tok {
  kind : TokKind
  pos : Int
  ///| For Ident/IntLit: lexeme slice; for StrLit: raw content between quotes (unescaped on demand).
  text : String
}

fn is_cedar_ws(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 13
}

fn is_cedar_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_cedar_ident_start(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

fn is_cedar_ident_cont(b : Int) -> Bool {
  is_cedar_ident_start(b) || is_cedar_digit(b)
}

fn hex_val_lex(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

///| Decode a Cedar string literal's raw interior (between `"` and `"`).
///| Does NOT allow `\*` (use `decode_cedar_pattern` for `like` RHS).
fn decode_cedar_string(raw : String, pos : Int) -> Result[String, CedarError] {
  let n = raw.length()
  // Fast path: no backslash
  let mut has_bs = false
  let mut k = 0
  while k < n {
    if raw.code_unit_at(k) == 92 {
      has_bs = true
      break
    }
    k = k + 1
  }
  if !has_bs {
    return Ok(raw)
  }

  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let b = raw.code_unit_at(i)
    if b != 92 {
      sb.write_byte(b.to_byte())
      i = i + 1
      continue
    }
    if i + 1 >= n {
      return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "trailing backslash in string"))
    }
    let esc = raw.code_unit_at(i + 1)
    if esc == 110 {
      // \n
      sb.write_byte(10.to_byte())
      i = i + 2
    } else if esc == 114 {
      // \r
      sb.write_byte(13.to_byte())
      i = i + 2
    } else if esc == 116 {
      // \t
      sb.write_byte(9.to_byte())
      i = i + 2
    } else if esc == 92 {
      // \\
      sb.write_byte(92.to_byte())
      i = i + 2
    } else if esc == 39 {
      // \'
      sb.write_byte(39.to_byte())
      i = i + 2
    } else if esc == 34 {
      // \"
      sb.write_byte(34.to_byte())
      i = i + 2
    } else if esc == 48 {
      // \0
      sb.write_byte(0.to_byte())
      i = i + 2
    } else if esc == 120 {
      // \xNN (strictly 0x00..0x7F ASCII in Cedar!)
      if i + 3 >= n {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "truncated \\x escape"))
      }
      let h1 = hex_val_lex(raw.code_unit_at(i + 2))
      let h2 = hex_val_lex(raw.code_unit_at(i + 3))
      if h1 < 0 || h2 < 0 {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "invalid hex in \\x escape"))
      }
      let cp = (h1 << 4) | h2
      if cp > 0x7F {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "\\x escape out of ASCII range (0x00..0x7F)"))
      }
      sb.write_byte(cp.to_byte())
      i = i + 4
    } else if esc == 117 {
      // \u{H..H} (1..6 hex digits, valid Unicode scalar value, no surrogates)
      if i + 2 >= n || raw.code_unit_at(i + 2) != 123 {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "expected '{' after \\u"))
      }
      let mut j = i + 3
      let mut cp = 0
      let mut digits = 0
      while j < n && raw.code_unit_at(j) != 125 {
        let hv = hex_val_lex(raw.code_unit_at(j))
        if hv < 0 {
          return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + j, "invalid hex digit in \\u{...}"))
        }
        digits = digits + 1
        if digits > 6 {
          return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + j, "too many hex digits in \\u{...}"))
        }
        cp = (cp << 4) | hv
        j = j + 1
      }
      if j >= n || raw.code_unit_at(j) != 125 {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "unterminated \\u{...} escape"))
      }
      if digits == 0 {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "empty \\u{} escape"))
      }
      if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "invalid Unicode scalar value in \\u{...}"))
      }
      write_utf8_cp(sb, cp)
      i = j + 1
    } else {
      return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "invalid string escape sequence"))
    }
  }
  Ok(sb.to_string())
}

///| Decode a Cedar `like` pattern string literal into `Array[PatternElem]`.
///| Unescaped `*` becomes `PatternElem::Wildcard`; `\*` becomes `PatternElem::Literal(42)`.
fn decode_cedar_pattern(raw : String, pos : Int) -> Result[Array[PatternElem], CedarError] {
  let elems : Array[PatternElem] = []
  let n = raw.length()
  let mut i = 0
  while i < n {
    let b = raw.code_unit_at(i)
    if b == 42 {
      // unescaped '*'
      elems.push(PatternElem::Wildcard)
      i = i + 1
    } else if b == 92 {
      if i + 1 >= n {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "trailing backslash in pattern"))
      }
      let esc = raw.code_unit_at(i + 1)
      if esc == 42 {
        // \* -> literal '*'
        elems.push(PatternElem::Literal(42))
        i = i + 2
      } else if esc == 110 {
        elems.push(PatternElem::Literal(10))
        i = i + 2
      } else if esc == 114 {
        elems.push(PatternElem::Literal(13))
        i = i + 2
      } else if esc == 116 {
        elems.push(PatternElem::Literal(9))
        i = i + 2
      } else if esc == 92 {
        elems.push(PatternElem::Literal(92))
        i = i + 2
      } else if esc == 39 {
        elems.push(PatternElem::Literal(39))
        i = i + 2
      } else if esc == 34 {
        elems.push(PatternElem::Literal(34))
        i = i + 2
      } else if esc == 48 {
        elems.push(PatternElem::Literal(0))
        i = i + 2
      } else if esc == 120 {
        if i + 3 >= n {
          return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "truncated \\x escape in pattern"))
        }
        let h1 = hex_val_lex(raw.code_unit_at(i + 2))
        let h2 = hex_val_lex(raw.code_unit_at(i + 3))
        if h1 < 0 || h2 < 0 {
          return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "invalid hex in \\x escape"))
        }
        let cp = (h1 << 4) | h2
        if cp > 0x7F {
          return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "\\x out of ASCII range"))
        }
        elems.push(PatternElem::Literal(cp))
        i = i + 4
      } else if esc == 117 {
        if i + 2 >= n || raw.code_unit_at(i + 2) != 123 {
          return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "expected '{' after \\u"))
        }
        let mut j = i + 3
        let mut cp = 0
        let mut digits = 0
        while j < n && raw.code_unit_at(j) != 125 {
          let hv = hex_val_lex(raw.code_unit_at(j))
          if hv < 0 {
            return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + j, "invalid hex in \\u{...}"))
          }
          digits = digits + 1
          if digits > 6 {
            return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + j, "too many hex digits in \\u{...}"))
          }
          cp = (cp << 4) | hv
          j = j + 1
        }
        if j >= n || raw.code_unit_at(j) != 125 || digits == 0 {
          return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "invalid \\u{...} escape"))
        }
        if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
          return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "invalid Unicode scalar in \\u{...}"))
        }
        elems.push(PatternElem::Literal(cp))
        i = j + 1
      } else {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, pos + i, "invalid escape in like pattern"))
      }
    } else {
      let (cp, next_i) = decode_utf8_at(raw, i)
      elems.push(PatternElem::Literal(cp))
      i = next_i
    }
  }
  Ok(elems)
}

///| Lex a Cedar input string into tokens, enforcing `limits.max_tokens`.
fn lex_cedar(input : String, limits : CedarLimits) -> Result[Array[Tok], CedarError] {
  let toks : Array[Tok] = []
  let n = input.length()
  let mut i = 0
  let max_toks = limits.max_tokens

  while i < n {
    let b = input.code_unit_at(i)
    if is_cedar_ws(b) {
      i = i + 1
      continue
    }
    // Line comment `// ...`
    if b == 47 {
      if i + 1 < n && input.code_unit_at(i + 1) == 47 {
        i = i + 2
        while i < n && input.code_unit_at(i) != 10 {
          i = i + 1
        }
        continue
      }
      return Err(CedarError::new(CedarErrorKind::SyntaxError, i, "unexpected '/' (Cedar does not support division or block comments)"))
    }

    if toks.length() >= max_toks {
      return Err(CedarError::new(CedarErrorKind::LimitExceeded, i, "token count exceeds max_tokens"))
    }

    if is_cedar_ident_start(b) {
      let start = i
      i = i + 1
      while i < n && is_cedar_ident_cont(input.code_unit_at(i)) {
        i = i + 1
      }
      toks.push(Tok::{ kind: TokKind::Ident, pos: start, text: input.slice(start, i) })
    } else if is_cedar_digit(b) {
      let start = i
      i = i + 1
      while i < n && is_cedar_digit(input.code_unit_at(i)) {
        i = i + 1
      }
      toks.push(Tok::{ kind: TokKind::IntLit, pos: start, text: input.slice(start, i) })
    } else if b == 34 {
      // String literal "..."
      let start = i
      i = i + 1
      let content_start = i
      let mut closed = false
      while i < n {
        let c = input.code_unit_at(i)
        if c == 92 {
          i = i + 2
        } else if c == 34 {
          closed = true
          break
        } else {
          i = i + 1
        }
      }
      if !closed {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, start, "unterminated string literal"))
      }
      let raw = input.slice(content_start, i)
      i = i + 1
      toks.push(Tok::{ kind: TokKind::StrLit, pos: start, text: raw })
    } else if b == 40 {
      toks.push(Tok::{ kind: TokKind::LParen, pos: i, text: "(" })
      i = i + 1
    } else if b == 41 {
      toks.push(Tok::{ kind: TokKind::RParen, pos: i, text: ")" })
      i = i + 1
    } else if b == 123 {
      toks.push(Tok::{ kind: TokKind::LBrace, pos: i, text: "{" })
      i = i + 1
    } else if b == 125 {
      toks.push(Tok::{ kind: TokKind::RBrace, pos: i, text: "}" })
      i = i + 1
    } else if b == 91 {
      toks.push(Tok::{ kind: TokKind::LBracket, pos: i, text: "[" })
      i = i + 1
    } else if b == 93 {
      toks.push(Tok::{ kind: TokKind::RBracket, pos: i, text: "]" })
      i = i + 1
    } else if b == 44 {
      toks.push(Tok::{ kind: TokKind::Comma, pos: i, text: "," })
      i = i + 1
    } else if b == 59 {
      toks.push(Tok::{ kind: TokKind::Semicolon, pos: i, text: ";" })
      i = i + 1
    } else if b == 46 {
      toks.push(Tok::{ kind: TokKind::Dot, pos: i, text: "." })
      i = i + 1
    } else if b == 64 {
      toks.push(Tok::{ kind: TokKind::At, pos: i, text: "@" })
      i = i + 1
    } else if b == 43 {
      toks.push(Tok::{ kind: TokKind::Plus, pos: i, text: "+" })
      i = i + 1
    } else if b == 45 {
      toks.push(Tok::{ kind: TokKind::Minus, pos: i, text: "-" })
      i = i + 1
    } else if b == 42 {
      toks.push(Tok::{ kind: TokKind::Star, pos: i, text: "*" })
      i = i + 1
    } else if b == 58 {
      if i + 1 < n && input.code_unit_at(i + 1) == 58 {
        toks.push(Tok::{ kind: TokKind::ColonColon, pos: i, text: "::" })
        i = i + 2
      } else {
        toks.push(Tok::{ kind: TokKind::Colon, pos: i, text: ":" })
        i = i + 1
      }
    } else if b == 61 {
      if i + 1 < n && input.code_unit_at(i + 1) == 61 {
        toks.push(Tok::{ kind: TokKind::EqEq, pos: i, text: "==" })
        i = i + 2
      } else {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, i, "unexpected '=' (expected '==')"))
      }
    } else if b == 33 {
      if i + 1 < n && input.code_unit_at(i + 1) == 61 {
        toks.push(Tok::{ kind: TokKind::BangEq, pos: i, text: "!=" })
        i = i + 2
      } else {
        toks.push(Tok::{ kind: TokKind::Bang, pos: i, text: "!" })
        i = i + 1
      }
    } else if b == 60 {
      if i + 1 < n && input.code_unit_at(i + 1) == 61 {
        toks.push(Tok::{ kind: TokKind::Le, pos: i, text: "<=" })
        i = i + 2
      } else {
        toks.push(Tok::{ kind: TokKind::Lt, pos: i, text: "<" })
        i = i + 1
      }
    } else if b == 62 {
      if i + 1 < n && input.code_unit_at(i + 1) == 61 {
        toks.push(Tok::{ kind: TokKind::Ge, pos: i, text: ">=" })
        i = i + 2
      } else {
        toks.push(Tok::{ kind: TokKind::Gt, pos: i, text: ">" })
        i = i + 1
      }
    } else if b == 38 {
      if i + 1 < n && input.code_unit_at(i + 1) == 38 {
        toks.push(Tok::{ kind: TokKind::AndAnd, pos: i, text: "&&" })
        i = i + 2
      } else {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, i, "unexpected '&' (expected '&&')"))
      }
    } else if b == 124 {
      if i + 1 < n && input.code_unit_at(i + 1) == 124 {
        toks.push(Tok::{ kind: TokKind::OrOr, pos: i, text: "||" })
        i = i + 2
      } else {
        return Err(CedarError::new(CedarErrorKind::SyntaxError, i, "unexpected '|' (expected '||')"))
      }
    } else {
      return Err(CedarError::new(CedarErrorKind::SyntaxError, i, "unexpected character in Cedar input"))
    }
  }

  toks.push(Tok::{ kind: TokKind::Eof, pos: n, text: "" })
  Ok(toks)
}
