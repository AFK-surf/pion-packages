///| AWS Cedar `ip` extension: IPv4 & IPv6 addresses and CIDR ranges.
///| Host bits beyond `prefix_len` are masked to zero for canonical equality and range checks.

fn mask_u64_top(bits : Int) -> UInt64 {
  if bits <= 0 {
    0UL
  } else if bits >= 64 {
    0xFFFFFFFFFFFFFFFFUL
  } else {
    0xFFFFFFFFFFFFFFFFUL << (64 - bits).to_int64().reinterpret_as_uint64()
  }
}

fn mask_u32_top(bits : Int) -> UInt64 {
  if bits <= 0 {
    0UL
  } else if bits >= 32 {
    0xFFFFFFFFUL
  } else {
    (0xFFFFFFFFUL << (32 - bits).to_int64().reinterpret_as_uint64()) & 0xFFFFFFFFUL
  }
}

fn parse_prefix_len(s : String, start : Int, max_bits : Int) -> Result[Int, CedarError] {
  let n = s.length()
  if start >= n {
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "empty CIDR prefix length"))
  }
  // Reject leading zero like "/01" (only "/0" is valid with leading 0)
  if n - start > 1 && s.code_unit_at(start) == 48 {
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "leading zero in CIDR prefix length"))
  }
  let mut v = 0
  let mut i = start
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "invalid digit in CIDR prefix"))
    }
    v = v * 10 + (b - 48)
    if v > max_bits {
      return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "CIDR prefix out of range"))
    }
    i = i + 1
  }
  Ok(v)
}

fn parse_ipv4_addr(s : String, start : Int, end : Int) -> Result[UInt64, CedarError] {
  let mut pos = start
  let mut octets = 0
  let mut acc : UInt64 = 0UL
  while pos < end {
    let oct_start = pos
    let mut val_i = 0
    while pos < end && s.code_unit_at(pos) != 46 {
      let b = s.code_unit_at(pos)
      if b < 48 || b > 57 {
        return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "invalid IPv4 digit"))
      }
      val_i = val_i * 10 + (b - 48)
      if val_i > 255 {
        return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "IPv4 octet > 255"))
      }
      pos = pos + 1
    }
    let oct_len = pos - oct_start
    if oct_len == 0 || (oct_len > 1 && s.code_unit_at(oct_start) == 48) {
      return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "invalid IPv4 octet"))
    }
    acc = (acc << 8UL) | val_i.to_int64().reinterpret_as_uint64()
    octets = octets + 1
    if pos < end {
      // '.'
      pos = pos + 1
      if pos == end {
        return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "trailing dot in IPv4"))
      }
    }
  }
  if octets != 4 {
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "IPv4 must have 4 octets"))
  }
  Ok(acc)
}

fn hex_val_ip(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn parse_ipv6_addr(s : String, start : Int, end : Int) -> Result[(UInt64, UInt64), CedarError] {
  if start >= end {
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "empty IPv6"))
  }
  let left_groups : Array[Int] = []
  let right_groups : Array[Int] = []
  let mut seen_double_colon = false
  let mut pos = start

  if pos + 1 < end && s.code_unit_at(pos) == 58 && s.code_unit_at(pos + 1) == 58 {
    seen_double_colon = true
    pos = pos + 2
  } else if s.code_unit_at(pos) == 58 {
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "single leading colon in IPv6"))
  }

  while pos < end {
    // Check if remaining segment contains '.' (IPv4-embedded IPv6 suffix)
    let seg_start = pos
    let mut has_dot = false
    let mut scan = pos
    while scan < end && s.code_unit_at(scan) != 58 {
      if s.code_unit_at(scan) == 46 {
        has_dot = true
      }
      scan = scan + 1
    }
    if has_dot {
      // Must reach `end`
      if scan != end {
        return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "IPv4 suffix not at end of IPv6"))
      }
      let v4 = match parse_ipv4_addr(s, seg_start, end) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let g_hi = ((v4 >> 16UL) & 0xFFFFUL).to_int64().to_int()
      let g_lo = (v4 & 0xFFFFUL).to_int64().to_int()
      if seen_double_colon {
        right_groups.push(g_hi)
        right_groups.push(g_lo)
      } else {
        left_groups.push(g_hi)
        left_groups.push(g_lo)
      }
      pos = end
      break
    }

    // Parse 1..4 hex digits
    let grp_len = scan - seg_start
    if grp_len == 0 || grp_len > 4 {
      return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "invalid IPv6 hextet length"))
    }
    let mut g = 0
    let mut k = seg_start
    while k < scan {
      let hv = hex_val_ip(s.code_unit_at(k))
      if hv < 0 {
        return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "invalid hex digit in IPv6"))
      }
      g = (g << 4) | hv
      k = k + 1
    }
    if seen_double_colon {
      right_groups.push(g)
    } else {
      left_groups.push(g)
    }
    pos = scan
    if pos < end {
      // Must be ':'
      if pos + 1 < end && s.code_unit_at(pos + 1) == 58 {
        if seen_double_colon {
          return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "multiple '::' in IPv6"))
        }
        seen_double_colon = true
        pos = pos + 2
      } else {
        pos = pos + 1
        if pos == end {
          return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "trailing colon in IPv6"))
        }
      }
    }
  }

  let total = left_groups.length() + right_groups.length()
  if seen_double_colon {
    if total >= 8 {
      return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "too many groups in compressed IPv6"))
    }
  } else if total != 8 {
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "IPv6 must have 8 groups"))
  }

  let groups = FixedArray::make(8, 0)
  let mut i = 0
  while i < left_groups.length() {
    groups[i] = left_groups[i]
    i = i + 1
  }
  let right_offset = 8 - right_groups.length()
  i = 0
  while i < right_groups.length() {
    groups[right_offset + i] = right_groups[i]
    i = i + 1
  }

  let hi : UInt64 = (groups[0].to_int64().reinterpret_as_uint64() << 48UL) |
  (groups[1].to_int64().reinterpret_as_uint64() << 32UL) |
  (groups[2].to_int64().reinterpret_as_uint64() << 16UL) |
  groups[3].to_int64().reinterpret_as_uint64()
  let lo : UInt64 = (groups[4].to_int64().reinterpret_as_uint64() << 48UL) |
  (groups[5].to_int64().reinterpret_as_uint64() << 32UL) |
  (groups[6].to_int64().reinterpret_as_uint64() << 16UL) |
  groups[7].to_int64().reinterpret_as_uint64()
  Ok((hi, lo))
}

fn parse_ip_impl(input : String) -> Result[IpAddrVal, CedarError] {
  let n = input.length()
  if n == 0 {
    return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "empty ip string"))
  }
  let mut slash = -1
  let mut has_colon = false
  let mut i = 0
  while i < n {
    let b = input.code_unit_at(i)
    if b == 47 {
      // '/'
      if slash >= 0 {
        return Err(CedarError::new(CedarErrorKind::ExtensionError, -1, "multiple '/' in ip"))
      }
      slash = i
    } else if b == 58 {
      has_colon = true
    }
    i = i + 1
  }
  let addr_end = if slash >= 0 { slash } else { n }
  if has_colon {
    let (hi_raw, lo_raw) = match parse_ipv6_addr(input, 0, addr_end) {
      Ok(pair) => pair
      Err(e) => return Err(e)
    }
    let prefix = if slash >= 0 {
      match parse_prefix_len(input, slash + 1, 128) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
    } else {
      128
    }
    let hi_masked = if prefix >= 64 {
      hi_raw
    } else {
      hi_raw & mask_u64_top(prefix)
    }
    let lo_masked = if prefix <= 64 {
      0UL
    } else {
      lo_raw & mask_u64_top(prefix - 64)
    }
    Ok(
      IpAddrVal::{
        is_v6: true,
        hi: hi_masked.reinterpret_as_int64(),
        lo: lo_masked.reinterpret_as_int64(),
        prefix_len: prefix,
      },
    )
  } else {
    let v4_raw = match parse_ipv4_addr(input, 0, addr_end) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let prefix = if slash >= 0 {
      match parse_prefix_len(input, slash + 1, 32) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
    } else {
      32
    }
    let v4_masked = v4_raw & mask_u32_top(prefix)
    Ok(
      IpAddrVal::{
        is_v6: false,
        hi: 0L,
        lo: v4_masked.reinterpret_as_int64(),
        prefix_len: prefix,
      },
    )
  }
}

fn hex_digit_lower(n : Int) -> Byte {
  if n < 10 { (48 + n).to_byte() } else { (87 + n).to_byte() }
}

fn write_u16_hex(sb : StringBuilder, v : Int) -> Unit {
  if v == 0 {
    sb.write_string("0")
    return
  }
  let mut started = false
  let mut shift = 12
  while shift >= 0 {
    let d = (v >> shift) & 0xF
    if d != 0 || started {
      sb.write_byte(hex_digit_lower(d))
      started = true
    }
    shift = shift - 4
  }
}

fn format_ip_impl(ip : IpAddrVal) -> String {
  let sb = StringBuilder::new()
  if !ip.is_v6 {
    let v = ip.lo.reinterpret_as_uint64()
    sb.write_string(((v >> 24UL) & 0xFFUL).to_string())
    sb.write_string(".")
    sb.write_string(((v >> 16UL) & 0xFFUL).to_string())
    sb.write_string(".")
    sb.write_string(((v >> 8UL) & 0xFFUL).to_string())
    sb.write_string(".")
    sb.write_string((v & 0xFFUL).to_string())
    sb.write_string("/")
    sb.write_string(ip.prefix_len.to_string())
    return sb.to_string()
  }
  let hi = ip.hi.reinterpret_as_uint64()
  let lo = ip.lo.reinterpret_as_uint64()
  let groups = [
    ((hi >> 48UL) & 0xFFFFUL).to_int64().to_int(),
    ((hi >> 32UL) & 0xFFFFUL).to_int64().to_int(),
    ((hi >> 16UL) & 0xFFFFUL).to_int64().to_int(),
    (hi & 0xFFFFUL).to_int64().to_int(),
    ((lo >> 48UL) & 0xFFFFUL).to_int64().to_int(),
    ((lo >> 32UL) & 0xFFFFUL).to_int64().to_int(),
    ((lo >> 16UL) & 0xFFFFUL).to_int64().to_int(),
    (lo & 0xFFFFUL).to_int64().to_int(),
  ]
  // RFC 5952 longest zero run compression
  let mut best_start = -1
  let mut best_len = 0
  let mut cur_start = -1
  let mut cur_len = 0
  let mut i = 0
  while i < 8 {
    if groups[i] == 0 {
      if cur_start < 0 {
        cur_start = i
        cur_len = 1
      } else {
        cur_len = cur_len + 1
      }
      if cur_len > best_len && cur_len >= 2 {
        best_start = cur_start
        best_len = cur_len
      }
    } else {
      cur_start = -1
      cur_len = 0
    }
    i = i + 1
  }
  i = 0
  while i < 8 {
    if i == best_start {
      sb.write_string("::")
      i = i + best_len
      continue
    }
    if i > 0 && i != best_start + best_len {
      sb.write_string(":")
    }
    write_u16_hex(sb, groups[i])
    i = i + 1
  }
  sb.write_string("/")
  sb.write_string(ip.prefix_len.to_string())
  sb.to_string()
}

fn ip_is_ipv4_impl(ip : IpAddrVal) -> Bool {
  !ip.is_v6
}

fn ip_is_ipv6_impl(ip : IpAddrVal) -> Bool {
  ip.is_v6
}

fn ip_is_in_range_impl(ip : IpAddrVal, other : IpAddrVal) -> Bool {
  if ip.is_v6 != other.is_v6 {
    return false
  }
  if ip.prefix_len < other.prefix_len {
    return false
  }
  if !ip.is_v6 {
    let m = mask_u32_top(other.prefix_len)
    (ip.lo.reinterpret_as_uint64() & m) == (other.lo.reinterpret_as_uint64() & m)
  } else {
    let p = other.prefix_len
    if p <= 64 {
      let mh = mask_u64_top(p)
      (ip.hi.reinterpret_as_uint64() & mh) == (other.hi.reinterpret_as_uint64() & mh)
    } else {
      let ml = mask_u64_top(p - 64)
      ip.hi == other.hi &&
      (ip.lo.reinterpret_as_uint64() & ml) == (other.lo.reinterpret_as_uint64() & ml)
    }
  }
}

fn ip_is_loopback_impl(ip : IpAddrVal) -> Bool {
  if !ip.is_v6 {
    // 127.0.0.0/8
    ip_is_in_range_impl(ip, IpAddrVal::{ is_v6: false, hi: 0L, lo: 0x7F000000L, prefix_len: 8 })
  } else {
    // ::1/128
    ip.prefix_len == 128 && ip.hi == 0L && ip.lo == 1L
  }
}

fn ip_is_multicast_impl(ip : IpAddrVal) -> Bool {
  if !ip.is_v6 {
    // 224.0.0.0/4
    ip_is_in_range_impl(ip, IpAddrVal::{ is_v6: false, hi: 0L, lo: 0xE0000000L, prefix_len: 4 })
  } else {
    // ff00::/8
    let hi_ff : UInt64 = 0xFF00000000000000UL
    ip_is_in_range_impl(
      ip,
      IpAddrVal::{ is_v6: true, hi: hi_ff.reinterpret_as_int64(), lo: 0L, prefix_len: 8 },
    )
  }
}

fn ip_eq_impl(a : IpAddrVal, b : IpAddrVal) -> Bool {
  a.is_v6 == b.is_v6 && a.prefix_len == b.prefix_len && a.hi == b.hi && a.lo == b.lo
}
