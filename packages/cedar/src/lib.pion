///| Top-level public API for `packages/cedar`.
///|
///| Pure-Pion AWS Cedar v4/v3 policy language parser, canonical formatter,
///| entity store with transitive DAG closure, extension functions (`decimal`, `ip`),
///| JSON entity/request loader, and authorization engine.

import "json5"

///| Validate `CedarLimits`.
pub fn validate_limits(limits : CedarLimits) -> Result[Unit, CedarError] {
  validate_limits_impl(limits)
}

///| Parse a single Cedar policy with default limits.
pub fn parse_policy(input : String) -> Result[Policy, CedarError] {
  parse_policy_with_limits(input, CedarLimits::default())
}

///| Parse a single Cedar policy with explicit limits.
pub fn parse_policy_with_limits(
  input : String,
  limits : CedarLimits,
) -> Result[Policy, CedarError] {
  parse_policy_impl(input, limits)
}

///| Parse a Cedar policy set (zero or more policies) with default limits.
pub fn parse_policy_set(input : String) -> Result[PolicySet, CedarError] {
  parse_policy_set_with_limits(input, CedarLimits::default())
}

///| Parse a Cedar policy set with explicit limits.
pub fn parse_policy_set_with_limits(
  input : String,
  limits : CedarLimits,
) -> Result[PolicySet, CedarError] {
  parse_policy_set_impl(input, limits)
}

///| Parse a Cedar Entity UID literal (e.g. `PhotoApp::User::"alice"`).
pub fn parse_entity_uid(input : String) -> Result[EntityUid, CedarError] {
  parse_entity_uid_impl(input)
}

///| Format an `EntityUid` in canonical Cedar syntax.
pub fn format_entity_uid(uid : EntityUid) -> String {
  format_entity_uid_impl(uid)
}

///| Format a single `Policy` into canonical Cedar syntax.
pub fn format_policy(policy : Policy) -> String {
  format_policy_impl(policy)
}

///| Format a `PolicySet` into canonical Cedar syntax.
pub fn format_policy_set(policies : PolicySet) -> String {
  format_policy_set_impl(policies)
}

///| Format an `Expr` into canonical Cedar syntax.
pub fn format_expr(expr : Expr) -> String {
  format_expr_impl(expr)
}

///| Parse a Cedar `decimal` extension literal string.
pub fn parse_decimal(input : String) -> Result[DecimalVal, CedarError] {
  parse_decimal_impl(input)
}

///| Format a `DecimalVal` into canonical string form.
pub fn format_decimal(d : DecimalVal) -> String {
  format_decimal_impl(d)
}

///| Parse a Cedar `ip` extension literal string (IPv4/IPv6 with optional CIDR prefix).
pub fn parse_ip(input : String) -> Result[IpAddrVal, CedarError] {
  parse_ip_impl(input)
}

///| Format an `IpAddrVal` into canonical string form.
pub fn format_ip(ip : IpAddrVal) -> String {
  format_ip_impl(ip)
}

///| Check whether an `IpAddrVal` is IPv4.
pub fn ip_is_ipv4(ip : IpAddrVal) -> Bool {
  ip_is_ipv4_impl(ip)
}

///| Check whether an `IpAddrVal` is IPv6.
pub fn ip_is_ipv6(ip : IpAddrVal) -> Bool {
  ip_is_ipv6_impl(ip)
}

///| Check whether an `IpAddrVal` is in the loopback range.
pub fn ip_is_loopback(ip : IpAddrVal) -> Bool {
  ip_is_loopback_impl(ip)
}

///| Check whether an `IpAddrVal` is in the multicast range.
pub fn ip_is_multicast(ip : IpAddrVal) -> Bool {
  ip_is_multicast_impl(ip)
}

///| Check whether `ip` is contained within CIDR range `other`.
pub fn ip_is_in_range(ip : IpAddrVal, other : IpAddrVal) -> Bool {
  ip_is_in_range_impl(ip, other)
}

///| Structural equality on Cedar `Value` (set order-independent, record key-order-independent).
pub fn value_eq(a : Value, b : Value) -> Bool {
  value_eq_impl(a, b)
}

///| Construct an empty `Entities` store.
pub fn Entities::empty() -> Entities {
  Entities::{ items: [], uid_keys: [], uid_buckets: [], uid_next: [], ancestors: [] }
}

///| Build an indexed `Entities` store from an array of `Entity` with default limits.
pub fn Entities::from_array(entities : Array[Entity]) -> Result[Entities, CedarError] {
  Entities::from_array_with_limits(entities, CedarLimits::default())
}

///| Build an indexed `Entities` store with explicit limits.
pub fn Entities::from_array_with_limits(
  entities : Array[Entity],
  limits : CedarLimits,
) -> Result[Entities, CedarError] {
  entities_from_array_impl(entities, limits)
}

///| Look up an entity by `EntityUid`.
pub fn Entities::get(self : Entities, uid : EntityUid) -> Option[Entity] {
  entities_get_impl(self, uid)
}

///| Evaluate `child in parent` (reflexive + transitive, cycle-safe).
pub fn Entities::is_in(self : Entities, child : EntityUid, parent : EntityUid) -> Bool {
  entities_is_in_impl(self, child, parent)
}

///| Deserialize a Cedar Entities JSON array string using `packages/json5` (strict JSON).
pub fn entities_from_json(src : String) -> Result[Entities, CedarError] {
  entities_from_json_with_limits(src, CedarLimits::default())
}

///| Deserialize a Cedar Entities JSON array string with explicit limits.
pub fn entities_from_json_with_limits(
  src : String,
  limits : CedarLimits,
) -> Result[Entities, CedarError] {
  entities_from_json_impl(src, limits)
}

///| Deserialize a Cedar Entities store from a parsed `json5::Json5Value`.
pub fn entities_from_json5(
  jval : json5::Json5Value,
  limits : CedarLimits,
) -> Result[Entities, CedarError] {
  entities_from_json5_impl(jval, limits)
}

///| Deserialize a Cedar Request JSON object string using `packages/json5` (strict JSON).
pub fn request_from_json(src : String) -> Result[Request, CedarError] {
  request_from_json_with_limits(src, CedarLimits::default())
}

///| Deserialize a Cedar Request JSON object string with explicit limits.
pub fn request_from_json_with_limits(
  src : String,
  limits : CedarLimits,
) -> Result[Request, CedarError] {
  request_from_json_impl(src, limits)
}

///| Deserialize a Cedar Request from a parsed `json5::Json5Value`.
pub fn request_from_json5(
  jval : json5::Json5Value,
  limits : CedarLimits,
) -> Result[Request, CedarError] {
  request_from_json5_impl(jval, limits)
}

///| Evaluate an authorization request against a `PolicySet` and `Entities`.
pub fn Authorizer::is_authorized(
  self : Authorizer,
  request : Request,
  policies : PolicySet,
  entities : Entities,
) -> Result[Response, CedarError] {
  is_authorized_impl(self, request, policies, entities)
}
