///| AWS Cedar v4/v3 recursive-descent parser with explicit depth/policy budgets,
///| non-associative relation checks, duplicate annotation/record-key validation,
///| reserved keyword validation, and exact `i64::MIN` literal handling.

struct Parser {
  toks : Array[Tok]
  mut pos : Int
  limits : CedarLimits
}

fn Parser::new(toks : Array[Tok], limits : CedarLimits) -> Parser {
  Parser::{ toks, pos: 0, limits }
}

fn Parser::peek(self : Parser) -> Tok {
  if self.pos < self.toks.length() {
    self.toks[self.pos]
  } else {
    self.toks[self.toks.length() - 1]
  }
}

fn Parser::peek_at(self : Parser, offset : Int) -> Tok {
  let idx = self.pos + offset
  if idx < self.toks.length() {
    self.toks[idx]
  } else {
    self.toks[self.toks.length() - 1]
  }
}

fn Parser::advance(self : Parser) -> Tok {
  let t = self.peek()
  if self.pos + 1 < self.toks.length() {
    self.pos = self.pos + 1
  }
  t
}

fn is_tok_kind(t : Tok, k : TokKind) -> Bool {
  tok_kind_code(t.kind) == tok_kind_code(k)
}

fn tok_kind_code(k : TokKind) -> Int {
  match k {
    TokKind::Eof => 0
    TokKind::Ident => 1
    TokKind::IntLit => 2
    TokKind::StrLit => 3
    TokKind::LParen => 4
    TokKind::RParen => 5
    TokKind::LBrace => 6
    TokKind::RBrace => 7
    TokKind::LBracket => 8
    TokKind::RBracket => 9
    TokKind::Comma => 10
    TokKind::Semicolon => 11
    TokKind::Colon => 12
    TokKind::ColonColon => 13
    TokKind::Dot => 14
    TokKind::At => 15
    TokKind::Plus => 16
    TokKind::Minus => 17
    TokKind::Star => 18
    TokKind::Bang => 19
    TokKind::EqEq => 20
    TokKind::BangEq => 21
    TokKind::Lt => 22
    TokKind::Le => 23
    TokKind::Gt => 24
    TokKind::Ge => 25
    TokKind::AndAnd => 26
    TokKind::OrOr => 27
  }
}

fn Parser::is_ident(self : Parser, kw : String) -> Bool {
  let t = self.peek()
  is_tok_kind(t, TokKind::Ident) && t.text == kw
}

fn Parser::expect_kind(self : Parser, k : TokKind, label : String) -> Result[Tok, CedarError] {
  let t = self.peek()
  if is_tok_kind(t, k) {
    Ok(self.advance())
  } else {
    Err(CedarError::new(CedarErrorKind::ParseError, t.pos, "expected " + label + ", found '" + t.text + "'"))
  }
}

fn Parser::expect_ident_kw(self : Parser, kw : String) -> Result[Tok, CedarError] {
  let t = self.peek()
  if is_tok_kind(t, TokKind::Ident) && t.text == kw {
    Ok(self.advance())
  } else {
    Err(CedarError::new(CedarErrorKind::ParseError, t.pos, "expected '" + kw + "', found '" + t.text + "'"))
  }
}

fn is_reserved_keyword(s : String) -> Bool {
  s == "true" ||
  s == "false" ||
  s == "if" ||
  s == "then" ||
  s == "else" ||
  s == "in" ||
  s == "is" ||
  s == "like" ||
  s == "has" ||
  s == "__cedar"
}

fn parse_i64_literal(text : String, neg : Bool, pos : Int) -> Result[Int64, CedarError] {
  let n = text.length()
  let mut acc : UInt64 = 0UL
  let limit : UInt64 = if neg { 9223372036854775808UL } else { 9223372036854775807UL }
  let mut i = 0
  while i < n {
    let d = (text.code_unit_at(i) - 48).to_int64().reinterpret_as_uint64()
    if acc > (limit - d) / 10UL {
      return Err(CedarError::new(CedarErrorKind::ParseError, pos, "integer literal overflows 64-bit signed integer"))
    }
    acc = acc * 10UL + d
    i = i + 1
  }
  if neg {
    if acc == 9223372036854775808UL {
      Ok(-9223372036854775807L - 1L)
    } else {
      Ok(0L - acc.reinterpret_as_int64())
    }
  } else {
    Ok(acc.reinterpret_as_int64())
  }
}

///| Parse a non-reserved identifier segment for entity types / namespaces.
fn Parser::parse_name_ident(self : Parser) -> Result[String, CedarError] {
  let t = self.peek()
  if !is_tok_kind(t, TokKind::Ident) {
    return Err(CedarError::new(CedarErrorKind::ParseError, t.pos, "expected identifier"))
  }
  if is_reserved_keyword(t.text) {
    return Err(CedarError::new(CedarErrorKind::ParseError, t.pos, "reserved keyword '" + t.text + "' cannot be used here"))
  }
  let _ = self.advance()
  Ok(t.text)
}

///| Parse a Cedar path (`Ident ('::' Ident)*`).
fn Parser::parse_path(self : Parser) -> Result[String, CedarError] {
  let first = match self.parse_name_ident() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let sb = StringBuilder::new()
  sb.write_string(first)
  while is_tok_kind(self.peek(), TokKind::ColonColon) && is_tok_kind(self.peek_at(1), TokKind::Ident) {
    let _ = self.advance() // '::'
    let seg = match self.parse_name_ident() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    sb.write_string("::")
    sb.write_string(seg)
  }
  Ok(sb.to_string())
}

///| Parse an EntityUid (`Path '::' StringLit`).
fn Parser::parse_entity_uid(self : Parser) -> Result[EntityUid, CedarError] {
  let entity_type = match self.parse_path() {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let _ = match self.expect_kind(TokKind::ColonColon, "'::'") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let id_tok = match self.expect_kind(TokKind::StrLit, "entity id string") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let id_str = match decode_cedar_string(id_tok.text, id_tok.pos) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok(EntityUid::new(entity_type, id_str))
}

fn Parser::parse_policy(self : Parser, default_id : String) -> Result[Policy, CedarError] {
  // 1. Annotations
  let annotations : Array[Annotation] = []
  let seen_ann = StrIntMap::new(4)
  let mut explicit_id = ""
  let mut has_explicit_id = false
  while is_tok_kind(self.peek(), TokKind::At) {
    let _ = self.advance()
    let key_tok = match self.expect_kind(TokKind::Ident, "annotation name") {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if is_reserved_keyword(key_tok.text) {
      return Err(CedarError::new(CedarErrorKind::ParseError, key_tok.pos, "reserved keyword in annotation"))
    }
    if !seen_ann.insert(key_tok.text, 1) {
      return Err(CedarError::new(CedarErrorKind::ParseError, key_tok.pos, "duplicate annotation @" + key_tok.text))
    }
    let mut ann_val = ""
    if is_tok_kind(self.peek(), TokKind::LParen) {
      let _ = self.advance()
      let val_tok = match self.expect_kind(TokKind::StrLit, "annotation string value") {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      ann_val = match decode_cedar_string(val_tok.text, val_tok.pos) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      let _ = match self.expect_kind(TokKind::RParen, "')'") {
        Ok(t) => t
        Err(e) => return Err(e)
      }
    }
    if key_tok.text == "id" {
      explicit_id = ann_val
      has_explicit_id = true
    }
    annotations.push(Annotation::{ key: key_tok.text, value: ann_val })
  }

  // 2. Effect: permit | forbid
  let eff_tok = self.peek()
  let effect = if is_tok_kind(eff_tok, TokKind::Ident) && eff_tok.text == "permit" {
    let _ = self.advance()
    Effect::Permit
  } else if is_tok_kind(eff_tok, TokKind::Ident) && eff_tok.text == "forbid" {
    let _ = self.advance()
    Effect::Forbid
  } else {
    return Err(CedarError::new(CedarErrorKind::ParseError, eff_tok.pos, "expected 'permit' or 'forbid'"))
  }

  // 3. Scope: ( principal_c, action_c, resource_c [,] )
  let _ = match self.expect_kind(TokKind::LParen, "'('") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let p_cons = match self.parse_principal_constraint() {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let _ = match self.expect_kind(TokKind::Comma, "','") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let a_cons = match self.parse_action_constraint() {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let _ = match self.expect_kind(TokKind::Comma, "','") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let r_cons = match self.parse_resource_constraint() {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  if is_tok_kind(self.peek(), TokKind::Comma) {
    let _ = self.advance()
  }
  let _ = match self.expect_kind(TokKind::RParen, "')'") {
    Ok(t) => t
    Err(e) => return Err(e)
  }

  // 4. Conditions: (when | unless) { expr }
  let conditions : Array[Condition] = []
  while self.is_ident("when") || self.is_ident("unless") {
    let kind = if self.peek().text == "when" {
      ConditionKind::When
    } else {
      ConditionKind::Unless
    }
    let _ = self.advance()
    let _ = match self.expect_kind(TokKind::LBrace, "'{'") {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let expr = match self.parse_expr(0) {
      Ok(ex) => ex
      Err(e) => return Err(e)
    }
    let _ = match self.expect_kind(TokKind::RBrace, "'}'") {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    conditions.push(Condition::{ kind, expr })
  }

  let _ = match self.expect_kind(TokKind::Semicolon, "';'") {
    Ok(t) => t
    Err(e) => return Err(e)
  }

  let policy_id = if has_explicit_id { explicit_id } else { default_id }
  Ok(
    Policy::{
      id: policy_id,
      annotations,
      effect,
      policy_scope: PolicyScope::{ principal: p_cons, action: a_cons, resource: r_cons },
      conditions,
    },
  )
}

fn Parser::parse_principal_constraint(self : Parser) -> Result[PrincipalConstraint, CedarError] {
  let _ = match self.expect_ident_kw("principal") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if is_tok_kind(self.peek(), TokKind::EqEq) {
    let _ = self.advance()
    let uid = match self.parse_entity_uid() {
      Ok(u) => u
      Err(e) => return Err(e)
    }
    Ok(PrincipalConstraint::Eq(uid))
  } else if self.is_ident("in") {
    let _ = self.advance()
    let uid = match self.parse_entity_uid() {
      Ok(u) => u
      Err(e) => return Err(e)
    }
    Ok(PrincipalConstraint::In(uid))
  } else if self.is_ident("is") {
    let _ = self.advance()
    let ty = match self.parse_path() {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    if self.is_ident("in") {
      let _ = self.advance()
      let uid = match self.parse_entity_uid() {
        Ok(u) => u
        Err(e) => return Err(e)
      }
      Ok(PrincipalConstraint::IsIn(ty, uid))
    } else {
      Ok(PrincipalConstraint::Is(ty))
    }
  } else {
    Ok(PrincipalConstraint::Any)
  }
}

fn Parser::parse_action_constraint(self : Parser) -> Result[ActionConstraint, CedarError] {
  let _ = match self.expect_ident_kw("action") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if is_tok_kind(self.peek(), TokKind::EqEq) {
    let _ = self.advance()
    let uid = match self.parse_entity_uid() {
      Ok(u) => u
      Err(e) => return Err(e)
    }
    Ok(ActionConstraint::Eq(uid))
  } else if self.is_ident("in") {
    let _ = self.advance()
    if is_tok_kind(self.peek(), TokKind::LBracket) {
      let _ = self.advance()
      let uids : Array[EntityUid] = []
      while !is_tok_kind(self.peek(), TokKind::RBracket) && !is_tok_kind(self.peek(), TokKind::Eof) {
        let uid = match self.parse_entity_uid() {
          Ok(u) => u
          Err(e) => return Err(e)
        }
        uids.push(uid)
        if is_tok_kind(self.peek(), TokKind::Comma) {
          let _ = self.advance()
        } else {
          break
        }
      }
      let _ = match self.expect_kind(TokKind::RBracket, "']'") {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      Ok(ActionConstraint::InSet(uids))
    } else {
      let uid = match self.parse_entity_uid() {
        Ok(u) => u
        Err(e) => return Err(e)
      }
      Ok(ActionConstraint::In(uid))
    }
  } else {
    Ok(ActionConstraint::Any)
  }
}

fn Parser::parse_resource_constraint(self : Parser) -> Result[ResourceConstraint, CedarError] {
  let _ = match self.expect_ident_kw("resource") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  if is_tok_kind(self.peek(), TokKind::EqEq) {
    let _ = self.advance()
    let uid = match self.parse_entity_uid() {
      Ok(u) => u
      Err(e) => return Err(e)
    }
    Ok(ResourceConstraint::Eq(uid))
  } else if self.is_ident("in") {
    let _ = self.advance()
    let uid = match self.parse_entity_uid() {
      Ok(u) => u
      Err(e) => return Err(e)
    }
    Ok(ResourceConstraint::In(uid))
  } else if self.is_ident("is") {
    let _ = self.advance()
    let ty = match self.parse_path() {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    if self.is_ident("in") {
      let _ = self.advance()
      let uid = match self.parse_entity_uid() {
        Ok(u) => u
        Err(e) => return Err(e)
      }
      Ok(ResourceConstraint::IsIn(ty, uid))
    } else {
      Ok(ResourceConstraint::Is(ty))
    }
  } else {
    Ok(ResourceConstraint::Any)
  }
}

fn Parser::check_depth(self : Parser, depth : Int) -> Result[Unit, CedarError] {
  if depth > self.limits.max_depth {
    Err(CedarError::new(CedarErrorKind::LimitExceeded, self.peek().pos, "expression nesting depth exceeds max_depth"))
  } else {
    Ok(())
  }
}

fn Parser::parse_expr(self : Parser, depth : Int) -> Result[Expr, CedarError] {
  let _ = match self.check_depth(depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.is_ident("if") {
    let _ = self.advance()
    let cond = match self.parse_expr(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    let _ = match self.expect_ident_kw("then") {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let then_e = match self.parse_expr(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    let _ = match self.expect_ident_kw("else") {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    let else_e = match self.parse_expr(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    Ok(Expr::If(cond, then_e, else_e))
  } else {
    self.parse_or(depth)
  }
}

fn Parser::parse_or(self : Parser, depth : Int) -> Result[Expr, CedarError] {
  let mut left = match self.parse_and(depth) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while is_tok_kind(self.peek(), TokKind::OrOr) {
    let _ = self.advance()
    let right = match self.parse_and(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = Expr::Binary(BinaryOp::Or, left, right)
  }
  Ok(left)
}

fn Parser::parse_and(self : Parser, depth : Int) -> Result[Expr, CedarError] {
  let mut left = match self.parse_relation(depth) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while is_tok_kind(self.peek(), TokKind::AndAnd) {
    let _ = self.advance()
    let right = match self.parse_relation(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = Expr::Binary(BinaryOp::And, left, right)
  }
  Ok(left)
}

fn Parser::is_rel_op_next(self : Parser) -> Bool {
  let t = self.peek()
  is_tok_kind(t, TokKind::EqEq) ||
  is_tok_kind(t, TokKind::BangEq) ||
  is_tok_kind(t, TokKind::Lt) ||
  is_tok_kind(t, TokKind::Le) ||
  is_tok_kind(t, TokKind::Gt) ||
  is_tok_kind(t, TokKind::Ge) ||
  (is_tok_kind(t, TokKind::Ident) &&
    (t.text == "in" || t.text == "has" || t.text == "like" || t.text == "is"))
}

fn Parser::parse_relation(self : Parser, depth : Int) -> Result[Expr, CedarError] {
  let left = match self.parse_add(depth) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  let t = self.peek()
  let res = if is_tok_kind(t, TokKind::EqEq) {
    let _ = self.advance()
    let right = match self.parse_add(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    Expr::Binary(BinaryOp::Eq, left, right)
  } else if is_tok_kind(t, TokKind::BangEq) {
    let _ = self.advance()
    let right = match self.parse_add(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    Expr::Binary(BinaryOp::Neq, left, right)
  } else if is_tok_kind(t, TokKind::Lt) {
    let _ = self.advance()
    let right = match self.parse_add(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    Expr::Binary(BinaryOp::Lt, left, right)
  } else if is_tok_kind(t, TokKind::Le) {
    let _ = self.advance()
    let right = match self.parse_add(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    Expr::Binary(BinaryOp::Le, left, right)
  } else if is_tok_kind(t, TokKind::Gt) {
    let _ = self.advance()
    let right = match self.parse_add(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    Expr::Binary(BinaryOp::Gt, left, right)
  } else if is_tok_kind(t, TokKind::Ge) {
    let _ = self.advance()
    let right = match self.parse_add(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    Expr::Binary(BinaryOp::Ge, left, right)
  } else if self.is_ident("in") {
    let _ = self.advance()
    let right = match self.parse_add(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    Expr::Binary(BinaryOp::In, left, right)
  } else if self.is_ident("has") {
    let _ = self.advance()
    let attr_tok = self.peek()
    let attr_name = if is_tok_kind(attr_tok, TokKind::Ident) {
      let _ = self.advance()
      attr_tok.text
    } else if is_tok_kind(attr_tok, TokKind::StrLit) {
      let _ = self.advance()
      match decode_cedar_string(attr_tok.text, attr_tok.pos) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
    } else {
      return Err(CedarError::new(CedarErrorKind::ParseError, attr_tok.pos, "expected attribute name or string after 'has'"))
    }
    Expr::HasAttr(left, attr_name)
  } else if self.is_ident("like") {
    let _ = self.advance()
    let pat_tok = match self.expect_kind(TokKind::StrLit, "pattern string after 'like'") {
      Ok(pt) => pt
      Err(e) => return Err(e)
    }
    let pat_elems = match decode_cedar_pattern(pat_tok.text, pat_tok.pos) {
      Ok(ps) => ps
      Err(e) => return Err(e)
    }
    Expr::Like(left, pat_elems, pat_tok.text)
  } else if self.is_ident("is") {
    let _ = self.advance()
    let ty = match self.parse_path() {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    if self.is_ident("in") {
      let _ = self.advance()
      let rhs = match self.parse_add(depth + 1) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      Expr::IsIn(left, ty, rhs)
    } else {
      Expr::Is(left, ty)
    }
  } else {
    return Ok(left)
  }

  // Cedar relational operators are strictly non-associative
  if self.is_rel_op_next() {
    return Err(
      CedarError::new(
        CedarErrorKind::ParseError,
        self.peek().pos,
        "relational operators cannot be chained without parentheses",
      ),
    )
  }
  Ok(res)
}

fn Parser::parse_add(self : Parser, depth : Int) -> Result[Expr, CedarError] {
  let mut left = match self.parse_mult(depth) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while is_tok_kind(self.peek(), TokKind::Plus) || is_tok_kind(self.peek(), TokKind::Minus) {
    let op = if is_tok_kind(self.peek(), TokKind::Plus) {
      BinaryOp::Add
    } else {
      BinaryOp::Sub
    }
    let _ = self.advance()
    let right = match self.parse_mult(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = Expr::Binary(op, left, right)
  }
  Ok(left)
}

fn Parser::parse_mult(self : Parser, depth : Int) -> Result[Expr, CedarError] {
  let mut left = match self.parse_unary(depth) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while is_tok_kind(self.peek(), TokKind::Star) {
    let _ = self.advance()
    let right = match self.parse_unary(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = Expr::Binary(BinaryOp::Mul, left, right)
  }
  Ok(left)
}

fn Parser::parse_unary(self : Parser, depth : Int) -> Result[Expr, CedarError] {
  let _ = match self.check_depth(depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if is_tok_kind(self.peek(), TokKind::Bang) {
    let _ = self.advance()
    let inner = match self.parse_unary(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    Ok(Expr::Unary(UnaryOp::Not, inner))
  } else if is_tok_kind(self.peek(), TokKind::Minus) {
    let minus_tok = self.advance()
    // Direct `-IntLit` folds into `LongLit` so `-9223372036854775808` parses as `i64::MIN`!
    if is_tok_kind(self.peek(), TokKind::IntLit) &&
    !is_tok_kind(self.peek_at(1), TokKind::Dot) &&
    !is_tok_kind(self.peek_at(1), TokKind::LBracket) {
      let lit_tok = self.advance()
      let v = match parse_i64_literal(lit_tok.text, true, minus_tok.pos) {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      Ok(Expr::LongLit(v))
    } else {
      let inner = match self.parse_unary(depth + 1) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      Ok(Expr::Unary(UnaryOp::Neg, inner))
    }
  } else {
    self.parse_member(depth)
  }
}

fn Parser::parse_arg_list(self : Parser, depth : Int) -> Result[Array[Expr], CedarError] {
  let _ = match self.expect_kind(TokKind::LParen, "'('") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let args : Array[Expr] = []
  while !is_tok_kind(self.peek(), TokKind::RParen) && !is_tok_kind(self.peek(), TokKind::Eof) {
    let arg = match self.parse_expr(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    args.push(arg)
    if is_tok_kind(self.peek(), TokKind::Comma) {
      let _ = self.advance()
    } else {
      break
    }
  }
  let _ = match self.expect_kind(TokKind::RParen, "')'") {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  Ok(args)
}

fn Parser::parse_member(self : Parser, depth : Int) -> Result[Expr, CedarError] {
  let mut expr = match self.parse_primary(depth) {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while true {
    if is_tok_kind(self.peek(), TokKind::Dot) {
      let _ = self.advance()
      let name_tok = match self.expect_kind(TokKind::Ident, "attribute or method name") {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if is_tok_kind(self.peek(), TokKind::LParen) {
        let args = match self.parse_arg_list(depth + 1) {
          Ok(a) => a
          Err(e) => return Err(e)
        }
        expr = Expr::MethodCall(expr, name_tok.text, args)
      } else {
        expr = Expr::GetAttr(expr, name_tok.text)
      }
    } else if is_tok_kind(self.peek(), TokKind::LBracket) {
      let _ = self.advance()
      let key_tok = match self.expect_kind(TokKind::StrLit, "string attribute key") {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let key = match decode_cedar_string(key_tok.text, key_tok.pos) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      let _ = match self.expect_kind(TokKind::RBracket, "']'") {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      expr = Expr::GetAttr(expr, key)
    } else {
      break
    }
  }
  Ok(expr)
}

fn Parser::parse_primary(self : Parser, depth : Int) -> Result[Expr, CedarError] {
  let _ = match self.check_depth(depth) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let t = self.peek()
  if is_tok_kind(t, TokKind::IntLit) {
    let _ = self.advance()
    let v = match parse_i64_literal(t.text, false, t.pos) {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    Ok(Expr::LongLit(v))
  } else if is_tok_kind(t, TokKind::StrLit) {
    let _ = self.advance()
    let s = match decode_cedar_string(t.text, t.pos) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    Ok(Expr::StrLit(s))
  } else if is_tok_kind(t, TokKind::LParen) {
    let _ = self.advance()
    let inner = match self.parse_expr(depth + 1) {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    let _ = match self.expect_kind(TokKind::RParen, "')'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    Ok(inner)
  } else if is_tok_kind(t, TokKind::LBracket) {
    let _ = self.advance()
    let elems : Array[Expr] = []
    while !is_tok_kind(self.peek(), TokKind::RBracket) && !is_tok_kind(self.peek(), TokKind::Eof) {
      let el = match self.parse_expr(depth + 1) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      elems.push(el)
      if is_tok_kind(self.peek(), TokKind::Comma) {
        let _ = self.advance()
      } else {
        break
      }
    }
    let _ = match self.expect_kind(TokKind::RBracket, "']'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    Ok(Expr::SetLit(elems))
  } else if is_tok_kind(t, TokKind::LBrace) {
    let _ = self.advance()
    let entries : Array[(String, Expr)] = []
    let seen = StrIntMap::new(4)
    while !is_tok_kind(self.peek(), TokKind::RBrace) && !is_tok_kind(self.peek(), TokKind::Eof) {
      let kt = self.peek()
      let key = if is_tok_kind(kt, TokKind::Ident) {
        let _ = self.advance()
        kt.text
      } else if is_tok_kind(kt, TokKind::StrLit) {
        let _ = self.advance()
        match decode_cedar_string(kt.text, kt.pos) {
          Ok(s) => s
          Err(e) => return Err(e)
        }
      } else {
        return Err(CedarError::new(CedarErrorKind::ParseError, kt.pos, "expected record key"))
      }
      if !seen.insert(key, 1) {
        return Err(CedarError::new(CedarErrorKind::ParseError, kt.pos, "duplicate record key '" + key + "'"))
      }
      let _ = match self.expect_kind(TokKind::Colon, "':'") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let ve = match self.parse_expr(depth + 1) {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      entries.push((key, ve))
      if is_tok_kind(self.peek(), TokKind::Comma) {
        let _ = self.advance()
      } else {
        break
      }
    }
    let _ = match self.expect_kind(TokKind::RBrace, "'}'") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    Ok(Expr::RecordLit(entries))
  } else if is_tok_kind(t, TokKind::Ident) {
    if t.text == "true" {
      let _ = self.advance()
      return Ok(Expr::BoolLit(true))
    }
    if t.text == "false" {
      let _ = self.advance()
      return Ok(Expr::BoolLit(false))
    }
    // Check if followed by `::` (EntityUid or namespaced ExtCall) or `(` (ExtCall)
    if !is_tok_kind(self.peek_at(1), TokKind::ColonColon) && !is_tok_kind(self.peek_at(1), TokKind::LParen) {
      if t.text == "principal" {
        let _ = self.advance()
        return Ok(Expr::Var(Var::Principal))
      } else if t.text == "action" {
        let _ = self.advance()
        return Ok(Expr::Var(Var::Action))
      } else if t.text == "resource" {
        let _ = self.advance()
        return Ok(Expr::Var(Var::Resource))
      } else if t.text == "context" {
        let _ = self.advance()
        return Ok(Expr::Var(Var::Context))
      } else {
        return Err(CedarError::new(CedarErrorKind::ParseError, t.pos, "unexpected identifier '" + t.text + "'"))
      }
    }
    // Parse Path then either `:: "id"` (EntityUid) or `(args)` (ExtCall)
    let path = match self.parse_path() {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    if is_tok_kind(self.peek(), TokKind::ColonColon) {
      let _ = self.advance()
      let id_tok = match self.expect_kind(TokKind::StrLit, "entity id string") {
        Ok(st) => st
        Err(e) => return Err(e)
      }
      let id_s = match decode_cedar_string(id_tok.text, id_tok.pos) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      Ok(Expr::EntityLit(EntityUid::new(path, id_s)))
    } else if is_tok_kind(self.peek(), TokKind::LParen) {
      let args = match self.parse_arg_list(depth + 1) {
        Ok(a) => a
        Err(e) => return Err(e)
      }
      Ok(Expr::ExtCall(path, args))
    } else {
      Err(CedarError::new(CedarErrorKind::ParseError, self.peek().pos, "expected '::\"id\"' or '(...)' after path '" + path + "'"))
    }
  } else {
    Err(CedarError::new(CedarErrorKind::ParseError, t.pos, "expected expression, found '" + t.text + "'"))
  }
}

fn parse_policy_impl(input : String, limits : CedarLimits) -> Result[Policy, CedarError] {
  let _ = match validate_limits_impl(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let toks = match lex_cedar(input, limits) {
    Ok(ts) => ts
    Err(e) => return Err(e)
  }
  let p = Parser::new(toks, limits)
  let pol = match p.parse_policy("policy0") {
    Ok(pl) => pl
    Err(e) => return Err(e)
  }
  if !is_tok_kind(p.peek(), TokKind::Eof) {
    return Err(CedarError::new(CedarErrorKind::ParseError, p.peek().pos, "unexpected trailing tokens after policy"))
  }
  Ok(pol)
}

fn parse_policy_set_impl(input : String, limits : CedarLimits) -> Result[PolicySet, CedarError] {
  let _ = match validate_limits_impl(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let toks = match lex_cedar(input, limits) {
    Ok(ts) => ts
    Err(e) => return Err(e)
  }
  let p = Parser::new(toks, limits)
  let policies : Array[Policy] = []
  let seen_ids = StrIntMap::new(16)
  while !is_tok_kind(p.peek(), TokKind::Eof) {
    if policies.length() >= limits.max_policies {
      return Err(CedarError::new(CedarErrorKind::LimitExceeded, p.peek().pos, "policy count exceeds max_policies"))
    }
    let idx = policies.length()
    let pol = match p.parse_policy("policy" + idx.to_string()) {
      Ok(pl) => pl
      Err(e) => return Err(e)
    }
    if !seen_ids.insert(pol.id, idx) {
      return Err(CedarError::new(CedarErrorKind::ParseError, p.peek().pos, "duplicate policy id '" + pol.id + "'"))
    }
    policies.push(pol)
  }
  Ok(PolicySet::{ policies })
}

fn parse_entity_uid_impl(input : String) -> Result[EntityUid, CedarError] {
  let limits = CedarLimits::default()
  let toks = match lex_cedar(input, limits) {
    Ok(ts) => ts
    Err(e) => return Err(e)
  }
  let p = Parser::new(toks, limits)
  let uid = match p.parse_entity_uid() {
    Ok(u) => u
    Err(e) => return Err(e)
  }
  if !is_tok_kind(p.peek(), TokKind::Eof) {
    return Err(CedarError::new(CedarErrorKind::ParseError, p.peek().pos, "unexpected trailing tokens after EntityUid"))
  }
  Ok(uid)
}
