///| Canonical AWS Cedar formatter for EntityUid, Expr, Policy, and PolicySet.
///| Guarantees idempotent parse -> format -> parse -> format round-trips.

fn write_entity_uid(sb : StringBuilder, uid : EntityUid) -> Unit {
  sb.write_string(uid.entity_type)
  sb.write_string("::\"")
  write_cedar_escaped(sb, uid.id)
  sb.write_string("\"")
}

fn format_entity_uid_impl(uid : EntityUid) -> String {
  let sb = StringBuilder::new()
  write_entity_uid(sb, uid)
  sb.to_string()
}

fn is_simple_ident(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  if !is_cedar_ident_start(s.code_unit_at(0)) {
    return false
  }
  let mut i = 1
  while i < n {
    if !is_cedar_ident_cont(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

fn write_expr(sb : StringBuilder, expr : Expr) -> Unit {
  match expr {
    Expr::BoolLit(b) => sb.write_string(if b { "true" } else { "false" })
    Expr::LongLit(v) => sb.write_string(v.to_string())
    Expr::StrLit(s) => {
      sb.write_string("\"")
      write_cedar_escaped(sb, s)
      sb.write_string("\"")
    }
    Expr::EntityLit(uid) => write_entity_uid(sb, uid)
    Expr::Var(v) =>
    match v {
      Var::Principal => sb.write_string("principal")
      Var::Action => sb.write_string("action")
      Var::Resource => sb.write_string("resource")
      Var::Context => sb.write_string("context")
    }
    Expr::Unary(op, inner) => {
      match op {
        UnaryOp::Not => sb.write_string("!(")
        UnaryOp::Neg => sb.write_string("-(")
      }
      write_expr(sb, inner)
      sb.write_string(")")
    }
    Expr::Binary(op, l, r) => {
      sb.write_string("(")
      write_expr(sb, l)
      let op_s = match op {
        BinaryOp::Or => " || "
        BinaryOp::And => " && "
        BinaryOp::Eq => " == "
        BinaryOp::Neq => " != "
        BinaryOp::Lt => " < "
        BinaryOp::Le => " <= "
        BinaryOp::Gt => " > "
        BinaryOp::Ge => " >= "
        BinaryOp::In => " in "
        BinaryOp::Add => " + "
        BinaryOp::Sub => " - "
        BinaryOp::Mul => " * "
      }
      sb.write_string(op_s)
      write_expr(sb, r)
      sb.write_string(")")
    }
    Expr::If(c, t, e) => {
      sb.write_string("(if ")
      write_expr(sb, c)
      sb.write_string(" then ")
      write_expr(sb, t)
      sb.write_string(" else ")
      write_expr(sb, e)
      sb.write_string(")")
    }
    Expr::GetAttr(obj, attr) => {
      write_expr_member_target(sb, obj)
      if is_simple_ident(attr) {
        sb.write_string(".")
        sb.write_string(attr)
      } else {
        sb.write_string("[\"")
        write_cedar_escaped(sb, attr)
        sb.write_string("\"]")
      }
    }
    Expr::HasAttr(obj, attr) => {
      sb.write_string("(")
      write_expr(sb, obj)
      sb.write_string(" has ")
      if is_simple_ident(attr) {
        sb.write_string(attr)
      } else {
        sb.write_string("\"")
        write_cedar_escaped(sb, attr)
        sb.write_string("\"")
      }
      sb.write_string(")")
    }
    Expr::Like(obj, _, raw_pat) => {
      sb.write_string("(")
      write_expr(sb, obj)
      sb.write_string(" like \"")
      sb.write_string(raw_pat)
      sb.write_string("\")")
    }
    Expr::Is(obj, ty) => {
      sb.write_string("(")
      write_expr(sb, obj)
      sb.write_string(" is ")
      sb.write_string(ty)
      sb.write_string(")")
    }
    Expr::IsIn(obj, ty, rhs) => {
      sb.write_string("(")
      write_expr(sb, obj)
      sb.write_string(" is ")
      sb.write_string(ty)
      sb.write_string(" in ")
      write_expr(sb, rhs)
      sb.write_string(")")
    }
    Expr::SetLit(elems) => {
      sb.write_string("[")
      let mut i = 0
      while i < elems.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_expr(sb, elems[i])
        i = i + 1
      }
      sb.write_string("]")
    }
    Expr::RecordLit(entries) => {
      sb.write_string("{")
      let mut i = 0
      while i < entries.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        let (k, v) = entries[i]
        if is_simple_ident(k) {
          sb.write_string(k)
        } else {
          sb.write_string("\"")
          write_cedar_escaped(sb, k)
          sb.write_string("\"")
        }
        sb.write_string(": ")
        write_expr(sb, v)
        i = i + 1
      }
      sb.write_string("}")
    }
    Expr::MethodCall(recv, name, args) => {
      write_expr_member_target(sb, recv)
      sb.write_string(".")
      sb.write_string(name)
      sb.write_string("(")
      let mut i = 0
      while i < args.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_expr(sb, args[i])
        i = i + 1
      }
      sb.write_string(")")
    }
    Expr::ExtCall(name, args) => {
      sb.write_string(name)
      sb.write_string("(")
      let mut i = 0
      while i < args.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        write_expr(sb, args[i])
        i = i + 1
      }
      sb.write_string(")")
    }
  }
}

fn write_expr_member_target(sb : StringBuilder, expr : Expr) -> Unit {
  match expr {
    Expr::Var(_)
    | Expr::EntityLit(_)
    | Expr::SetLit(_)
    | Expr::RecordLit(_)
    | Expr::GetAttr(_, _)
    | Expr::MethodCall(_, _, _)
    | Expr::ExtCall(_, _) => write_expr(sb, expr)
    _ => {
      sb.write_string("(")
      write_expr(sb, expr)
      sb.write_string(")")
    }
  }
}

fn format_expr_impl(expr : Expr) -> String {
  let sb = StringBuilder::new()
  write_expr(sb, expr)
  sb.to_string()
}

fn write_policy(sb : StringBuilder, p : Policy) -> Unit {
  let mut i = 0
  while i < p.annotations.length() {
    let ann = p.annotations[i]
    sb.write_string("@")
    sb.write_string(ann.key)
    sb.write_string("(\"")
    write_cedar_escaped(sb, ann.value)
    sb.write_string("\")\n")
    i = i + 1
  }
  match p.effect {
    Effect::Permit => sb.write_string("permit(\n  ")
    Effect::Forbid => sb.write_string("forbid(\n  ")
  }
  match p.policy_scope.principal {
    PrincipalConstraint::Any => sb.write_string("principal")
    PrincipalConstraint::Eq(u) => {
      sb.write_string("principal == ")
      write_entity_uid(sb, u)
    }
    PrincipalConstraint::In(u) => {
      sb.write_string("principal in ")
      write_entity_uid(sb, u)
    }
    PrincipalConstraint::Is(ty) => {
      sb.write_string("principal is ")
      sb.write_string(ty)
    }
    PrincipalConstraint::IsIn(ty, u) => {
      sb.write_string("principal is ")
      sb.write_string(ty)
      sb.write_string(" in ")
      write_entity_uid(sb, u)
    }
  }
  sb.write_string(",\n  ")
  match p.policy_scope.action {
    ActionConstraint::Any => sb.write_string("action")
    ActionConstraint::Eq(u) => {
      sb.write_string("action == ")
      write_entity_uid(sb, u)
    }
    ActionConstraint::In(u) => {
      sb.write_string("action in ")
      write_entity_uid(sb, u)
    }
    ActionConstraint::InSet(us) => {
      sb.write_string("action in [")
      let mut k = 0
      while k < us.length() {
        if k > 0 {
          sb.write_string(", ")
        }
        write_entity_uid(sb, us[k])
        k = k + 1
      }
      sb.write_string("]")
    }
  }
  sb.write_string(",\n  ")
  match p.policy_scope.resource {
    ResourceConstraint::Any => sb.write_string("resource")
    ResourceConstraint::Eq(u) => {
      sb.write_string("resource == ")
      write_entity_uid(sb, u)
    }
    ResourceConstraint::In(u) => {
      sb.write_string("resource in ")
      write_entity_uid(sb, u)
    }
    ResourceConstraint::Is(ty) => {
      sb.write_string("resource is ")
      sb.write_string(ty)
    }
    ResourceConstraint::IsIn(ty, u) => {
      sb.write_string("resource is ")
      sb.write_string(ty)
      sb.write_string(" in ")
      write_entity_uid(sb, u)
    }
  }
  sb.write_string("\n)")
  i = 0
  while i < p.conditions.length() {
    let cond = p.conditions[i]
    match cond.kind {
      ConditionKind::When => sb.write_string("\nwhen {\n  ")
      ConditionKind::Unless => sb.write_string("\nunless {\n  ")
    }
    write_expr(sb, cond.expr)
    sb.write_string("\n}")
    i = i + 1
  }
  sb.write_string(";")
}

fn format_policy_impl(p : Policy) -> String {
  let sb = StringBuilder::new()
  write_policy(sb, p)
  sb.to_string()
}

fn format_policy_set_impl(ps : PolicySet) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ps.policies.length() {
    if i > 0 {
      sb.write_string("\n\n")
    }
    write_policy(sb, ps.policies[i])
    i = i + 1
  }
  sb.to_string()
}
