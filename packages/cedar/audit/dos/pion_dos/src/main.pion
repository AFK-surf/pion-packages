///| DoS / complexity / stack probes for `packages/cedar` (Pion side).
///| Twin of `audit/rust/src/bin/dos.rs` (Rust `cedar-policy =4.15.0`): for the same
///| `<probe> <n> [m]` both print the same single line, so `dos/run_dos.py` can gate on
///| byte-identical output AND on wall time relative to the reference.
///|
///| Probes (all inputs are generated in-process, deterministic):
///|   chain_rev n     n-entity parent chain, entity i -> parent i-1 (ancestor list built in
///|                   DESCENDING index order); load + `e(n-1) in e(0)`
///|   chain_fwd n     same chain, entity i -> parent i+1 (ascending order)
///|   star n          n children of one root; load + one membership query
///|   ctx_set n       request_from_json with a context set of n distinct longs; `contains`
///|   ent_set n       entities_from_json with one attribute set of n distinct longs
///|   set_lit n       policy literal `[0, .., n-1].contains(n-1)` (parsed with raised max_tokens)
///|   contains_all n  `context.a.containsAll(context.b)` on two n-element sets
///|   set_eq n        `context.a == context.b` on two n-element sets (b reversed)
///|   like n m        `context.s like "*a*a..(m)..*b"` on a string of n 'a'
///|   fmt_chain n     parse an n-term `||` chain (raised max_tokens) and format it; print length
///|   parse_chain n   the same parse without formatting
///|   fmt_chain_default n  fmt_chain under DEFAULT limits (max_tokens 131072 => n <= 65536)
///|   budget n        permit-all + n false permits (~100 eval steps each) + a satisfied forbid,
///|                   authorized with DEFAULT limits: Deny in cedar-policy
///|   deep_parse n    deep_eval without authorizing
///|   deep_eval n     max_depth = max_safe_depth(); `((..(n)..(true)..))` parse + authorize;
///|                   n = 0 means max_safe_depth() - 6 (the documented "safe on Native and Wasm32" ceiling)

import "cedar"

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

fn uid(t : String, id : String) -> cedar::EntityUid {
  cedar::EntityUid::new(t, id)
}

fn req0(ctx : Array[(String, cedar::Value)]) -> cedar::Request {
  cedar::Request::new(uid("User", "alice"), uid("Action", "view"), uid("Doc", "d"), ctx)
}

fn big_limits() -> cedar::CedarLimits {
  cedar::CedarLimits::new(128, 100000000, 100000, 1000000, 1000000)
}

fn show_auth(r : Result[cedar::Response, cedar::CedarError]) -> String {
  match r {
    Ok(resp) => {
      let d = if cedar::decision_eq(resp.decision, cedar::Decision::Allow) {
        "Allow"
      } else {
        "Deny"
      }
      d + " errors=" + resp.diagnostics.errors.length().to_string()
    }
    Err(e) => "AERR " + e.to_string()
  }
}

fn auth_src(src : String, ctx : Array[(String, cedar::Value)]) -> String {
  match cedar::parse_policy_set_with_limits(src, big_limits()) {
    Ok(ps) => show_auth(cedar::Authorizer::new().is_authorized(req0(ctx), ps, cedar::Entities::empty()))
    Err(e) => "PERR " + kind_name(e)
  }
}

fn kind_name(e : cedar::CedarError) -> String {
  cedar::cedar_error_kind_as_str(e.kind)
}

fn long_set(n : Int, rev : Bool) -> cedar::Value {
  let out : Array[cedar::Value] = []
  let mut i = 0
  while i < n {
    let v = if rev { n - 1 - i } else { i }
    out.push(cedar::Value::Long(v.to_int64()))
    i = i + 1
  }
  cedar::Value::Set(out)
}

fn json_long_array(n : Int) -> String {
  let sb = StringBuilder::new()
  sb.write_string("[")
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(i.to_string())
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

fn chain(n : Int, rev : Bool) -> String {
  let ents : Array[cedar::Entity] = []
  let mut i = 0
  while i < n {
    let parents : Array[cedar::EntityUid] = []
    if rev && i > 0 {
      parents.push(uid("G", "g" + (i - 1).to_string()))
    }
    if !rev && i + 1 < n {
      parents.push(uid("G", "g" + (i + 1).to_string()))
    }
    ents.push(cedar::Entity::new(uid("G", "g" + i.to_string()), [], parents))
    i = i + 1
  }
  match cedar::Entities::from_array_with_limits(ents, big_limits()) {
    Ok(es) => {
      let (c, p) = if rev { (n - 1, 0) } else { (0, n - 1) }
      "in=" + es.is_in(uid("G", "g" + c.to_string()), uid("G", "g" + p.to_string())).to_string()
    }
    Err(e) => "EERR " + kind_name(e)
  }
}

fn run(probe : String, n : Int, m : Int) -> String {
  if probe == "chain_rev" {
    return chain(n, true)
  }
  if probe == "chain_fwd" {
    return chain(n, false)
  }
  if probe == "star" {
    let ents : Array[cedar::Entity] = [cedar::Entity::new(uid("G", "root"), [], [])]
    let mut i = 0
    while i < n {
      ents.push(cedar::Entity::new(uid("U", "u" + i.to_string()), [], [uid("G", "root")]))
      i = i + 1
    }
    return match cedar::Entities::from_array_with_limits(ents, big_limits()) {
      Ok(es) => "in=" + es.is_in(uid("U", "u" + (n - 1).to_string()), uid("G", "root")).to_string()
      Err(e) => "EERR " + kind_name(e)
    }
  }
  if probe == "ctx_set" {
    let src = "{\"principal\":{\"type\":\"User\",\"id\":\"alice\"},\"action\":{\"type\":\"Action\",\"id\":\"view\"},\"resource\":{\"type\":\"Doc\",\"id\":\"d\"},\"context\":{\"s\":" +
    json_long_array(n) +
    "}}"
    let req = match cedar::request_from_json_with_limits(src, big_limits()) {
      Ok(r) => r
      Err(e) => return "RERR " + kind_name(e)
    }
    let ps = match cedar::parse_policy_set("permit(principal, action, resource) when { context.s.contains(" + (n - 1).to_string() + ") };") {
      Ok(p) => p
      Err(e) => return "PERR " + kind_name(e)
    }
    return show_auth(cedar::Authorizer::new().is_authorized(req, ps, cedar::Entities::empty()))
  }
  if probe == "ent_set" {
    let src = "[{\"uid\":{\"type\":\"User\",\"id\":\"alice\"},\"attrs\":{\"s\":" + json_long_array(n) + "},\"parents\":[]}]"
    return match cedar::entities_from_json_with_limits(src, big_limits()) {
      Ok(es) => "entities=" + es.len().to_string()
      Err(e) => "EERR " + kind_name(e)
    }
  }
  if probe == "set_lit" {
    let sb = StringBuilder::new()
    sb.write_string("permit(principal, action, resource) when { [")
    let mut i = 0
    while i < n {
      if i > 0 {
        sb.write_string(",")
      }
      sb.write_string(i.to_string())
      i = i + 1
    }
    sb.write_string("].contains(" + (n - 1).to_string() + ") };")
    return auth_src(sb.to_string(), [])
  }
  if probe == "contains_all" || probe == "set_eq" {
    let ctx = [("a", long_set(n, false)), ("b", long_set(n, true))]
    let src = if probe == "set_eq" {
      "permit(principal, action, resource) when { context.a == context.b };"
    } else {
      "permit(principal, action, resource) when { context.a.containsAll(context.b) };"
    }
    return auth_src(src, ctx)
  }
  if probe == "like" {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < n {
      sb.write_string("a")
      i = i + 1
    }
    let pat = StringBuilder::new()
    i = 0
    while i < m {
      pat.write_string("*a")
      i = i + 1
    }
    pat.write_string("*b")
    return auth_src(
      "permit(principal, action, resource) when { !(context.s like \"" + pat.to_string() + "\") };",
      [("s", cedar::Value::String(sb.to_string()))],
    )
  }
  if probe == "fmt_chain" || probe == "parse_chain" || probe == "fmt_chain_default" {
    let sb = StringBuilder::new()
    sb.write_string("permit(principal, action, resource) when { true")
    let mut i = 1
    while i < n {
      sb.write_string(" || true")
      i = i + 1
    }
    sb.write_string(" };")
    let lim = if probe == "fmt_chain_default" { cedar::CedarLimits::default() } else { big_limits() }
    return match cedar::parse_policy_set_with_limits(sb.to_string(), lim) {
      Ok(ps) =>
      if probe == "parse_chain" {
        "parsed policies=" + ps.len().to_string()
      } else {
        "parsed policies=" + ps.len().to_string() + " formatted_nonempty=" + (cedar::format_policy_set(ps).length() > 0).to_string()
      }
      Err(e) => "PERR " + kind_name(e)
    }
  }
  if probe == "budget" {
    let sb = StringBuilder::new()
    sb.write_string("permit(principal, action, resource);\n")
    let mut i = 0
    while i < n {
      sb.write_string("permit(principal, action, resource) when { context.n == 0")
      let mut k = 1
      while k < 33 {
        sb.write_string(" || context.n == " + k.to_string())
        k = k + 1
      }
      sb.write_string(" };\n")
      i = i + 1
    }
    sb.write_string("forbid(principal, action, resource) when { context.n == 99 };\n")
    return auth_src(sb.to_string(), [("n", cedar::Value::Long(99L))])
  }
  if probe == "deep_eval" || probe == "deep_parse" {
    let lim = cedar::CedarLimits::new(cedar::max_safe_depth(), 1000000, 10000, 100000, 1000000)
    // n == 0: probe the documented ceiling itself (max_safe_depth() - 6 nested parentheses)
    let n = if n == 0 { cedar::max_safe_depth() - 6 } else { n }
    let sb = StringBuilder::new()
    sb.write_string("permit(principal, action, resource) when { ")
    let mut i = 0
    while i < n {
      sb.write_string("(")
      i = i + 1
    }
    sb.write_string("true")
    i = 0
    while i < n {
      sb.write_string(")")
      i = i + 1
    }
    sb.write_string(" };")
    return match cedar::parse_policy_set_with_limits(sb.to_string(), lim) {
      Ok(ps) =>
      if probe == "deep_parse" {
        "parsed policies=" + ps.len().to_string()
      } else {
        show_auth(cedar::Authorizer::with_limits(lim).is_authorized(req0([]), ps, cedar::Entities::empty()))
      }
      Err(e) => "PERR " + kind_name(e)
    }
  }
  "unknown probe"
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: cedar_rt_dos <probe> <n> [m]")
    return 2
  }
  let m = if args.length() > 3 { parse_int(args[3]) } else { 0 }
  io_println(world, "probe=" + args[1] + " n=" + args[2] + " " + run(args[1], parse_int(args[2]), m))
  0
}
