///| Control tests: behaviour where `packages/cedar` v0.1.0 already matches Rust
///| `cedar-policy =4.15.0` (expected lines are the reference's answers; same inputs as the
///| `ctl.*` cases in `diff/gen_cases.py`). These must pass before AND after any fix.

import "cedar"

///| ctl.auth.*: default deny, forbid overrides permit, error isolation in both directions.
test "control_authorizer_core_semantics" {
  debug_assert(decide_std("") == "Deny r= e=", "default deny")
  let fp = "permit(principal, action, resource);\nforbid(principal, action, resource);"
  debug_assert(decide_std(fp) == "Deny r=1 e=", "forbid overrides permit")
  let fe = "permit(principal, action, resource);\nforbid(principal, action, resource) when { principal.missing == 1 };"
  debug_assert(decide_std(fe) == "Allow r=0 e=1", "erroring forbid is skipped (Cedar semantics)")
  let pe = "forbid(principal, action, resource) when { true };\npermit(principal, action, resource) when { principal.missing };"
  debug_assert(decide_std(pe) == "Deny r=0 e=1", "erroring permit isolated")
  let ov = "permit(principal, action, resource);\nforbid(principal, action, resource) when { 9223372036854775807 + context.n > 0 };"
  debug_assert(decide_std(ov) == "Allow r=0 e=1", "overflow is a per-policy error")
}

///| ctl.sc.*: short-circuit never evaluates the dead branch.
test "control_short_circuit" {
  debug_assert(probe("false && (1 + \"a\" == 2)") == "Deny r= e=", "false && <type error>")
  debug_assert(probe("true || principal.missing") == "Allow r=0 e=", "true || <missing attr>")
  debug_assert(probe("true || 1") == "Allow r=0 e=", "true || <non-bool>")
  debug_assert(probe("if true then true else principal.missing") == "Allow r=0 e=", "dead else")
  debug_assert(probe("principal has missing && principal.missing == 1") == "Deny r= e=", "has guard")
  debug_assert(probe("true && 1") == "Deny r= e=0", "true && <non-bool> errors")
}

///| ctl.in.*: reflexive / transitive / namespaced membership and `is .. in`.
test "control_entity_membership" {
  debug_assert(probe("User::\"ghost\" in User::\"ghost\"") == "Allow r=0 e=", "reflexive on unknown entity")
  debug_assert(probe("principal in Group::\"eng\"") == "Allow r=0 e=", "direct parent")
  debug_assert(probe("principal is Group in 1") == "Deny r= e=", "is .. in short-circuits on type")
  debug_assert(probe("principal in [Group::\"eng\", 1]") == "Deny r= e=0", "non-entity in rhs set errors")
  debug_assert(probe("User::\"ghost\" has name") == "Deny r= e=", "has on unknown entity is false")
  debug_assert(probe("User::\"ghost\".getTag(\"t\") == 1") == "Deny r= e=0", "getTag on unknown entity errors")
}

///| ctl.int.*: exact 64-bit literal bounds and checked arithmetic.
test "control_integer_bounds" {
  debug_assert(probe("-9223372036854775808 == -9223372036854775807 - 1") == "Allow r=0 e=", "i64::MIN literal")
  debug_assert(probe("9223372036854775808 == 0") == "PERR", "i64::MAX + 1 literal")
  debug_assert(probe("-(-9223372036854775808) == 0") == "Deny r= e=0", "negating i64::MIN errors")
  debug_assert(probe("-9223372036854775808 * -1 == 0") == "Deny r= e=0", "MIN * -1 errors")
  debug_assert(probe("--1 == 1") == "Allow r=0 e=", "double negation")
}

///| ctl.dec.*: decimal grammar and bounds.
test "control_decimal" {
  debug_assert(probe("decimal(\"-922337203685477.5808\").lessThan(decimal(\"0.0\"))") == "Allow r=0 e=", "decimal min")
  debug_assert(probe("decimal(\"922337203685477.5808\") == decimal(\"0.0\")") == "Deny r= e=0", "decimal max + 1")
  debug_assert(probe("decimal(\"1.00000\") == decimal(\"1.0\")") == "Deny r= e=0", "5 fraction digits")
  debug_assert(probe("decimal(\"1\") == decimal(\"1.0\")") == "Deny r= e=0", "no dot")
  debug_assert(probe("decimal(\"-0.0\") == decimal(\"0.0\")") == "Allow r=0 e=", "-0.0 == 0.0")
}

///| ctl.ip.*: address grammar, ranges and predicates where Pion agrees.
test "control_ip" {
  debug_assert(probe("ip(\"10.0.0.1\").isInRange(ip(\"10.0.0.0/24\"))") == "Allow r=0 e=", "in range")
  debug_assert(probe("ip(\"01.2.3.4\") == ip(\"1.2.3.4\")") == "Deny r= e=0", "leading zero octet")
  debug_assert(probe("ip(\"1.2.3.4/01\") == ip(\"1.2.3.4/1\")") == "Deny r= e=0", "leading zero prefix")
  debug_assert(probe("ip(\"1.2.3.4\").isInRange(ip(\"::/0\"))") == "Deny r= e=", "cross-family range")
  debug_assert(probe("ip(\"127.0.0.1/7\").isLoopback()") == "Deny r= e=", "loopback needs /8")
}

///| ctl.like.*: wildcard semantics and the non-backtracking matcher.
test "control_like" {
  debug_assert(probe("\"a\\nb\" like \"a*b\"") == "Allow r=0 e=", "* spans newline")
  debug_assert(probe("\"a*\" like \"a\\*\"") == "Allow r=0 e=", "\\* literal star")
  debug_assert(probe("\"x\" like \"\\*\"") == "Deny r= e=", "\\* is not a wildcard")
  let s = rep("a", "", 5000)
  let p = rep("*a", "", 60) + "*b"
  debug_assert(probe("\"" + s + "\" like \"" + p + "\"") == "Deny r= e=", "backtracking bomb is linear")
}

///| ctl.fmt.*: typical policies round-trip through the formatter.
test "control_format_roundtrip" {
  let src = "@id(\"x\\\"y\") permit(principal == User::\"al\\\"ice\\n\", action in [Action::\"read\"], resource is Doc in Folder::\"f\") when { context.s like \"a\\*b*\" && -context.n == -5 } unless { principal has \"na me\" };"
  match cedar::parse_policy_set(src) {
    Ok(ps) => {
      let f1 = cedar::format_policy_set(ps)
      match cedar::parse_policy_set(f1) {
        Ok(ps2) => debug_assert(cedar::format_policy_set(ps2) == f1, "idempotent")
        Err(e) => debug_assert(false, "re-parse: " + e.to_string())
      }
    }
    Err(e) => debug_assert(false, "parse: " + e.to_string())
  }
}
