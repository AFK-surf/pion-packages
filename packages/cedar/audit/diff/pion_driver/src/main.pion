///| Differential driver for `packages/cedar` (Pion side). Twin of `audit/rust/src/bin/oracle.rs`
///| (official Rust `cedar-policy =4.15.0`); both print byte-identical transcripts when Pion is right.
///|
///| Case file, one case per line (`#` comments allowed):
///|   `<id>\t<mode>\t<hex policies>\t<hex entities json>\t<hex request json>`
///| Modes: `A` = parse + load + authorize, `P` = parse only, `F` = parse -> `format_policy_set`
///| -> re-parse -> authorize the RE-PARSED set (the oracle authorizes the original; any
///| difference is a formatter round-trip defect).
///| Result line per case (after `## <id>`):
///|   `PERR` | `EERR` | `RERR` | `FERR` (formatted text no longer parses) | `FIDEM` (format not
///|   idempotent) | `OK n=<k>` | `<Allow|Deny> r=<sorted idx> e=<sorted idx>`
///| Policy indices are positional, so `@id(..)` naming never skews the comparison.
///| `--fmt <cases>` instead prints `<id>\t<hex format_policy_set(..)>` for every parsable case.

import "cedar"

fn hexval(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    0
  }
}

fn unhex(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length() / 2
  let mut i = 0
  while i < n {
    let v = hexval(s.code_unit_at(2 * i)) * 16 + hexval(s.code_unit_at(2 * i + 1))
    sb.write_byte(v.to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn hex_str(s : String) -> String {
  let digits = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    sb.write_byte(digits.code_unit_at(b / 16).to_byte())
    sb.write_byte(digits.code_unit_at(b % 16).to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn split_fields(s : String, sep : Int) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == sep {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(start, s.length()))
  out
}

fn join_sorted(xs : Array[Int]) -> String {
  let mut i = 1
  while i < xs.length() {
    let x = xs[i]
    let mut j = i - 1
    while j >= 0 && xs[j] > x {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = x
    i = i + 1
  }
  let sb = StringBuilder::new()
  let mut last = -1
  let mut first = true
  i = 0
  while i < xs.length() {
    if xs[i] != last {
      if !first {
        sb.write_string(",")
      }
      sb.write_string(xs[i].to_string())
      first = false
      last = xs[i]
    }
    i = i + 1
  }
  sb.to_string()
}

fn idx_of(ps : cedar::PolicySet, id : String) -> Int {
  let mut i = 0
  while i < ps.policies.length() {
    if ps.policies[i].id == id {
      return i
    }
    i = i + 1
  }
  -1
}

fn authorize(ps : cedar::PolicySet, ents : String, req : String) -> String {
  let ents_src = if ents.length() == 0 { "[]" } else { ents }
  let entities = match cedar::entities_from_json(ents_src) {
    Ok(e) => e
    Err(_) => return "EERR"
  }
  let request = match cedar::request_from_json(req) {
    Ok(r) => r
    Err(_) => return "RERR"
  }
  let resp = match cedar::Authorizer::new().is_authorized(request, ps, entities) {
    Ok(r) => r
    Err(e) => return "AERR\t" + e.to_string()
  }
  let reasons : Array[Int] = []
  let mut i = 0
  while i < resp.diagnostics.reason.length() {
    reasons.push(idx_of(ps, resp.diagnostics.reason[i]))
    i = i + 1
  }
  let errors : Array[Int] = []
  i = 0
  while i < resp.diagnostics.errors.length() {
    errors.push(idx_of(ps, resp.diagnostics.errors[i].policy_id))
    i = i + 1
  }
  let dec = if cedar::decision_eq(resp.decision, cedar::Decision::Allow) {
    "Allow"
  } else {
    "Deny"
  }
  dec + " r=" + join_sorted(reasons) + " e=" + join_sorted(errors)
}

fn run_case(mode : String, pol : String, ents : String, req : String) -> String {
  let ps = match cedar::parse_policy_set(pol) {
    Ok(p) => p
    Err(_) => return "PERR"
  }
  if mode == "P" {
    return "OK n=" + ps.len().to_string()
  }
  if mode == "F" {
    let f1 = cedar::format_policy_set(ps)
    let ps2 = match cedar::parse_policy_set(f1) {
      Ok(p) => p
      Err(_) => return "FERR"
    }
    if cedar::format_policy_set(ps2) != f1 {
      return "FIDEM"
    }
    return authorize(ps2, ents, req)
  }
  authorize(ps, ents, req)
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mut fmt_mode = false
  let mut path = ""
  let mut a = 1
  while a < args.length() {
    if args[a] == "--fmt" {
      fmt_mode = true
    } else {
      path = args[a]
    }
    a = a + 1
  }
  if path.length() == 0 {
    io_println(world, "usage: cedar_rt_driver [--fmt] <cases>")
    return 2
  }
  let data = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: cannot read " + path)
      return 2
    }
  }
  let lines = split_fields(data, 10)
  let out = StringBuilder::new()
  let mut idx = 0
  while idx < lines.length() {
    let line = lines[idx]
    idx = idx + 1
    if line.length() == 0 || line.code_unit_at(0) == 35 {
      continue
    }
    let f = split_fields(line, 9)
    if f.length() < 5 {
      continue
    }
    if fmt_mode {
      match cedar::parse_policy_set(unhex(f[2])) {
        Ok(ps) => {
          out.write_string(f[0])
          out.write_string("\t")
          out.write_string(hex_str(cedar::format_policy_set(ps)))
          out.write_string("\n")
        }
        Err(_) => ()
      }
    } else {
      out.write_string("## ")
      out.write_string(f[0])
      out.write_string("\n")
      out.write_string(run_case(f[1], unhex(f[2]), unhex(f[3]), unhex(f[4])))
      out.write_string("\n")
    }
  }
  io_print(world, out.to_string())
  0
}
