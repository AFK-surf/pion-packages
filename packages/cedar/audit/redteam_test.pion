///| Red-team evidence for `packages/cedar` v0.1.0 vs official Rust `cedar-policy =4.15.0`.
///| Every expected transcript line below is the reference's answer for the same input (the
///| identical case is in `diff/gen_cases.py`; ids in the comments) - run the Rust oracle to
///| re-derive it. Each test asserts the CORRECT behaviour: it FAILS while the defect exists and
///| PASSES once fixed. Where a fail-closed alternative is an acceptable fix (rejecting at parse
///| time under the documented `max_depth`, or refusing the whole request), the test says so.
///| Test names carry the finding id from REPORT.md.

import "cedar"

fn one_of(got : String, a : String, b : String) -> Bool {
  got == a || got == b
}

fn has_sub(s : String, sub : String) -> Bool {
  let n = s.length()
  let m = sub.length()
  let mut i = 0
  while i + m <= n {
    if s.slice(i, i + m) == sub {
      return true
    }
    i = i + 1
  }
  false
}

fn forbid_head() -> String {
  "permit(principal, action, resource);\nforbid(principal, action, resource)"
}

// ------------------------------------------------------------------ P0-1 evaluation-depth fail-open

///| p0.depth_or.0200: a 200-entry deny-list forbid is silently dropped => Allow.
test "p0_1_forbid_denylist_200_terms_must_deny" {
  let got = decide_std(forbid_head() + " when { " + deny_list(200) + " };")
  debug_assert(one_of(got, "Deny r=1 e=", "PERR"), "200-term || deny-list forbid => " + got + ", cedar-policy: Deny r=1 e=")
}

///| p0.depth_or.0129: the cliff is at 129 terms (128 binary nodes) - one more user than 128.
test "p0_1_forbid_denylist_129_terms_must_deny" {
  let got = decide_std(forbid_head() + " when { " + deny_list(129) + " };")
  debug_assert(one_of(got, "Deny r=1 e=", "PERR"), "129-term deny-list forbid => " + got + ", cedar-policy: Deny r=1 e=")
}

///| p0.depth_add.0129: any left-associative chain (`+`, `&&`, `||`, `in`, `like` ...) trips it.
test "p0_1_forbid_add_chain_must_deny" {
  let got = decide_std(forbid_head() + " when { " + rep("1", " + ", 129) + " == 129 };")
  debug_assert(one_of(got, "Deny r=1 e=", "PERR"), "129-term + chain forbid => " + got + ", cedar-policy: Deny r=1 e=")
}

///| p0.depth_and_unless.0129: `unless { p != a && p != b && ... }` exemption lists.
test "p0_1_forbid_unless_and_chain_must_deny" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 128 {
    sb.write_string("principal != User::\"u" + i.to_string() + "\" && ")
    i = i + 1
  }
  sb.write_string("principal != User::\"alice\"")
  let got = decide_std(forbid_head() + " unless { " + sb.to_string() + " };")
  debug_assert(one_of(got, "Deny r=1 e=", "PERR"), "unless && chain forbid => " + got + ", cedar-policy: Deny r=1 e=")
}

///| p1.depth_permit_allowlist.0200: the same shape on a permit fails closed (availability).
test "p0_1_permit_allowlist_200_terms_must_allow" {
  let got = decide_std("permit(principal, action, resource) when { " + deny_list(200) + " };")
  debug_assert(one_of(got, "Allow r=0 e=", "PERR"), "200-term allow-list permit => " + got + ", cedar-policy: Allow r=0 e=")
}

// ------------------------------------------------------------------ P0-2 unknown calls accepted

///| p1.unknown_fn.forbid_typo: a misspelled method in a forbid is a parse error in cedar-policy;
///| Pion parses it, the forbid errors at evaluation and is ignored => Allow.
test "p0_2_forbid_with_misspelled_method_must_not_parse" {
  let got = decide_std(forbid_head() + " when { context.ip.isInRnage(ip(\"192.168.0.0/16\")) };")
  debug_assert(got == "PERR", "forbid with isInRnage(..) => " + got + ", cedar-policy: PERR")
}

///| p1.unknown_fn.forbid_custom: unknown free function.
test "p0_2_forbid_with_unknown_function_must_not_parse" {
  let got = decide_std(forbid_head() + " when { isBlocked(principal) };")
  debug_assert(got == "PERR", "forbid with isBlocked(..) => " + got + ", cedar-policy: PERR")
}

///| p1.unknown_fn.00 / .07: unknown methods anywhere.
test "p0_2_unknown_methods_must_not_parse" {
  debug_assert(probe("[1].foo()") == "PERR", "[1].foo() => " + probe("[1].foo()") + ", cedar-policy: PERR")
  debug_assert(probe("\"a\".length() == 1") == "PERR", "\"a\".length() => " + probe("\"a\".length() == 1") + ", cedar-policy: PERR")
}

///| gap.datetime.forbid: `datetime` / `duration` are default-on in cedar-policy 4.15; Pion
///| accepts the call, the forbid errors and is dropped => Allow. Either implement or reject.
test "p0_2_datetime_forbid_must_not_fail_open" {
  let got = decide_std(forbid_head() + " when { datetime(\"2026-01-01\") < datetime(\"2027-01-01\") };")
  debug_assert(one_of(got, "Deny r=1 e=", "PERR"), "datetime forbid => " + got + ", cedar-policy: Deny r=1 e=")
  let got2 = decide_std(forbid_head() + " when { duration(\"1h\") > duration(\"30m\") };")
  debug_assert(one_of(got2, "Deny r=1 e=", "PERR"), "duration forbid => " + got2 + ", cedar-policy: Deny r=1 e=")
}

// ------------------------------------------------------------------ P1-1 shared max_steps budget

///| dos budget 7000: one request-wide step counter; enough earlier (false) permits exhaust it
///| and every later policy - including a satisfied forbid - errors and is ignored => Allow.
test "p1_1_step_budget_must_not_drop_later_forbid" {
  let sb = StringBuilder::new()
  sb.write_string("permit(principal, action, resource);\n")
  let mut i = 0
  while i < 7000 {
    sb.write_string("permit(principal, action, resource) when { context.n == 100")
    let mut k = 1
    while k < 33 {
      sb.write_string(" || context.n == " + (100 + k).to_string())
      k = k + 1
    }
    sb.write_string(" };\n")
    i = i + 1
  }
  sb.write_string("forbid(principal, action, resource) when { context.n == 5 };\n")
  let lim = cedar::CedarLimits::new(128, 100000000, 100000, 100000, 1000000)
  let got = match cedar::parse_policy_set_with_limits(sb.to_string(), lim) {
    Ok(ps) => decide_ps(ps, std_entities(), std_request(), cedar::Authorizer::new())
    Err(e) => "PERR " + e.to_string()
  }
  debug_assert(
    got.slice(0, 4) == "Deny" || got == "AERR",
    "7002-policy set, satisfied forbid last => " + got.slice(0, 12) + ", cedar-policy: Deny",
  )
}

// ------------------------------------------------------------------ P1-2 entity identity

///| p1.json_type.nul / bad_*: entity type names from JSON are never validated.
test "p1_2_invalid_entity_type_names_must_be_rejected" {
  let bad = ["User\\u0000x", "user name", "NS::", "1User", "if", "User::\\\"x\\\""]
  let mut i = 0
  while i < bad.length() {
    let ents = "[{\"uid\":{\"type\":\"" + bad[i] + "\",\"id\":\"y\"},\"attrs\":{},\"parents\":[]}]"
    let got = decide("permit(principal, action, resource);", ents, std_request())
    debug_assert(got == "EERR", "entity type '" + bad[i] + "' => " + got + ", cedar-policy: EERR")
    i = i + 1
  }
  let req = "{\"principal\":{\"type\":\"not a type\",\"id\":\"x\"},\"action\":{\"type\":\"Action\",\"id\":\"view\"},\"resource\":{\"type\":\"Doc\",\"id\":\"d1\"}}"
  let got = decide("permit(principal, action, resource);", std_entities(), req)
  debug_assert(got == "RERR", "request principal type 'not a type' => " + got + ", cedar-policy: RERR")
}

///| p1.uid_collision.in / .attr: `type + "\0" + id` lookup keys collide, so principal
///| (`User\0a`, "b") inherits the ancestors and attributes of entity User::"a\0b".
test "p1_2_uid_key_collision_must_not_grant_membership" {
  let ents = "[{\"uid\":{\"type\":\"User\",\"id\":\"a\\u0000b\"},\"attrs\":{\"admin\":true},\"parents\":[{\"type\":\"Group\",\"id\":\"admins\"}]}]"
  let req = "{\"principal\":{\"type\":\"User\\u0000a\",\"id\":\"b\"},\"action\":{\"type\":\"Action\",\"id\":\"view\"},\"resource\":{\"type\":\"Doc\",\"id\":\"d1\"},\"context\":{}}"
  let got = decide("permit(principal in Group::\"admins\", action, resource);", ents, req)
  debug_assert(got == "RERR", "collided principal in Group::admins => " + got + ", cedar-policy: RERR")
  let got2 = decide("permit(principal, action, resource) when { principal.admin };", ents, req)
  debug_assert(got2 == "RERR", "collided principal.admin => " + got2 + ", cedar-policy: RERR")
}

// ------------------------------------------------------------------ P1-3 JSON loader laxity

fn ent_attr(attrs : String) -> String {
  "[{\"uid\":{\"type\":\"User\",\"id\":\"alice\"},\"attrs\":" + attrs + ",\"parents\":[]}]"
}

///| p1.json_attr.00..03, p1.json_ent.00..02/16/17, p1.cycle.*: cedar-policy rejects all of these.
test "p1_3_json_entities_strictness" {
  let pol = "permit(principal, action, resource) when { principal has a && principal.a == 1 };"
  let cases = [
    ent_attr("{\"a\":1,\"a\":2}"),
    ent_attr("{\"a\":1.0}"),
    ent_attr("{\"a\":1e0}"),
    ent_attr("{\"a\":-0}"),
    "[{\"uid\":{\"type\":\"User\",\"id\":\"alice\"},\"parents\":[]}]",
    "[{\"uid\":{\"type\":\"User\",\"id\":\"alice\"},\"attrs\":{\"a\":1}}]",
    "[{\"uid\":{\"type\":\"User\",\"id\":\"alice\"},\"uid\":{\"type\":\"User\",\"id\":\"bob\"},\"attrs\":{\"a\":1},\"parents\":[]}]",
    "[{\"uid\":{\"type\":\"User\",\"id\":\"alice\"},\"attrs\":{\"a\":1},\"parents\":[{\"type\":\"User\",\"id\":\"alice\"}]}]",
    "[{\"uid\":{\"type\":\"G\",\"id\":\"x\"},\"attrs\":{},\"parents\":[{\"type\":\"G\",\"id\":\"y\"}]},{\"uid\":{\"type\":\"G\",\"id\":\"y\"},\"attrs\":{},\"parents\":[{\"type\":\"G\",\"id\":\"x\"}]}]",
  ]
  let mut i = 0
  while i < cases.length() {
    let got = decide(pol, cases[i], std_request())
    debug_assert(got == "EERR", "entities case " + i.to_string() + " => " + got + ", cedar-policy: EERR")
    i = i + 1
  }
}

///| gap.json_bigint.00/.02: integers beyond 2^53 are silently rounded (wrong answer), where
///| the documented gap promises rejection. Exact value (Allow) or rejection (EERR) are fine.
test "p1_3_json_big_integers_must_not_be_rounded" {
  let got = decide(
    "permit(principal, action, resource) when { principal.a == 9007199254740993 };",
    ent_attr("{\"a\":9007199254740993}"),
    std_request(),
  )
  debug_assert(one_of(got, "Allow r=0 e=", "EERR"), "a == 9007199254740993 => " + got + ", cedar-policy: Allow r=0 e=")
}

// ------------------------------------------------------------------ P1-4 ip host bits

///| p1.ip_hostbits.*: cedar-policy keeps the address as written (`10.0.0.1/24` != `10.0.0.0/24`);
///| Pion masks host bits at parse time, flipping ==, != and set membership.
test "p1_4_ip_equality_keeps_host_bits" {
  debug_assert(
    probe("ip(\"10.0.0.1/24\") == ip(\"10.0.0.0/24\")") == "Deny r= e=",
    "ip(10.0.0.1/24) == ip(10.0.0.0/24) => " + probe("ip(\"10.0.0.1/24\") == ip(\"10.0.0.0/24\")") + ", cedar-policy: false",
  )
  debug_assert(
    probe("ip(\"192.168.1.77/16\") != ip(\"192.168.0.0/16\")") == "Allow r=0 e=",
    "ip(192.168.1.77/16) != ip(192.168.0.0/16) => " + probe("ip(\"192.168.1.77/16\") != ip(\"192.168.0.0/16\")") + ", cedar-policy: true",
  )
  debug_assert(
    probe("[ip(\"10.0.0.1/24\")].contains(ip(\"10.0.0.0/24\"))") == "Deny r= e=",
    "[ip(10.0.0.1/24)].contains(ip(10.0.0.0/24)) => " + probe("[ip(\"10.0.0.1/24\")].contains(ip(\"10.0.0.0/24\"))") + ", cedar-policy: false",
  )
}

// ------------------------------------------------------------------ P1-5 formatter round-trip

///| p1.fmt_depth.if_070.fmt: `format_policy_set` doubles the nesting of `if` chains, so its own
///| output no longer parses under the limits the input parsed with.
test "p1_5_format_output_must_reparse" {
  let mut e = "true"
  let mut k = 0
  while k < 70 {
    e = "if context.n == " + k.to_string() + " then false else " + e
    k = k + 1
  }
  let src = forbid_head() + " when { " + e + " };"
  match cedar::parse_policy_set(src) {
    Ok(ps) => {
      let f1 = cedar::format_policy_set(ps)
      match cedar::parse_policy_set(f1) {
        Ok(ps2) => debug_assert(cedar::format_policy_set(ps2) == f1, "format not idempotent")
        Err(err) => debug_assert(false, "format_policy_set output fails to re-parse: " + err.to_string())
      }
    }
    Err(err) => debug_assert(false, "70 nested ifs must parse (they do in v0.1.0): " + err.to_string())
  }
}

// ------------------------------------------------------------------ P2 grammar / extension parity

///| p2.has_path.00: Cedar 4 `e has a.b.c`.
test "p2_1_has_attribute_path" {
  debug_assert(probe("principal has nested.a.b") == "Allow r=0 e=", "has nested.a.b => " + probe("principal has nested.a.b"))
}

///| p2.unary_limit.*: cedar-policy rejects more than 4 chained `!` / `-`.
test "p2_2_unary_operator_limit" {
  debug_assert(probe("!!!!!true") == "PERR", "!!!!!true => " + probe("!!!!!true") + ", cedar-policy: PERR")
  debug_assert(probe("-----1 == -1") == "PERR", "-----1 => " + probe("-----1 == -1") + ", cedar-policy: PERR")
  debug_assert(probe("!!!!true") == "Allow r=0 e=", "!!!!true (4) must still parse")
}

///| p2.ident.*, p2.scope.00-02: reserved words are not identifiers (attrs, record keys, `has`),
///| but ARE valid annotation keys.
test "p2_3_reserved_identifiers" {
  debug_assert(probe("{if: 1} == {if: 1}") == "PERR", "{if: 1} => " + probe("{if: 1} == {if: 1}"))
  debug_assert(probe("principal has if") == "PERR", "has if => " + probe("principal has if"))
  debug_assert(probe("context.in == 1") == "PERR", "context.in => " + probe("context.in == 1"))
  debug_assert(probe("{__cedar: 1} == {__cedar: 1}") == "PERR", "{__cedar: 1} => " + probe("{__cedar: 1} == {__cedar: 1}"))
  let a = decide_std("@if(\"x\") permit(principal, action, resource);")
  debug_assert(a == "Allow r=0 e=", "@if(\"x\") => " + a + ", cedar-policy: Allow r=0 e=")
  let b = decide_std("@in permit(principal, action, resource);")
  debug_assert(b == "Allow r=0 e=", "@in => " + b + ", cedar-policy: Allow r=0 e=")
}

///| p2.fmt_ident.*: formatter must keep reserved-word keys quoted.
test "p2_3_formatter_quotes_reserved_keys" {
  match cedar::parse_policy_set("permit(principal, action, resource) when { {\"if\": 1}[\"if\"] == 1 };") {
    Ok(ps) => {
      let f = cedar::format_policy_set(ps)
      debug_assert(!has_sub(f, "{if:") && !has_sub(f, ".if"), "formatter emitted a bare reserved key: " + f)
    }
    Err(e) => debug_assert(false, "{\"if\": 1}[\"if\"] is valid Cedar: " + e.to_string())
  }
}

///| p2.scope.09-11: action scope constraints must name `Action` entities.
test "p2_4_action_scope_type" {
  let got = decide_std("permit(principal, action == User::\"view\", resource);")
  debug_assert(got == "PERR", "action == User::\"view\" => " + got + ", cedar-policy: PERR")
  let got2 = decide_std("permit(principal, action in [Action::\"read\", User::\"x\"], resource);")
  debug_assert(got2 == "PERR", "action in [.., User::\"x\"] => " + got2 + ", cedar-policy: PERR")
}

///| p2.like_escape.*: only `\*` is a literal star; `\u{2a}` / `\x2a` are wildcards.
test "p2_5_like_unicode_escape_is_wildcard" {
  debug_assert(probe("\"x\" like \"\\u{2a}\"") == "Allow r=0 e=", "\"x\" like \"\\u{2a}\" => " + probe("\"x\" like \"\\u{2a}\""))
  debug_assert(probe("\"abc\" like \"\\x2a\"") == "Allow r=0 e=", "\"abc\" like \"\\x2a\" => " + probe("\"abc\" like \"\\x2a\""))
}

///| p2.policy_id.*: `@id(..)` is an annotation, not the policy id; duplicates are legal.
test "p2_6_duplicate_id_annotations" {
  let got = decide_std("@id(\"a\") permit(principal, action, resource);\n@id(\"a\") forbid(principal, action, resource);")
  debug_assert(got == "Deny r=1 e=", "two @id(\"a\") => " + got + ", cedar-policy: Deny r=1 e=")
  let got2 = decide_std("@id(\"policy1\") forbid(principal, action, resource);\npermit(principal, action, resource);")
  debug_assert(got2 == "Deny r=0 e=", "@id(\"policy1\") + auto id => " + got2 + ", cedar-policy: Deny r=0 e=")
}

///| p2.ip_embedded.*: cedar-policy refuses IPv4-embedded IPv6 text forms.
test "p2_7_ip_rejects_ipv4_embedded_ipv6" {
  debug_assert(probe("ip(\"::ffff:192.0.2.1\").isIpv6()") == "Deny r= e=0", "::ffff:192.0.2.1 => " + probe("ip(\"::ffff:192.0.2.1\").isIpv6()"))
  debug_assert(probe("ip(\"::1.2.3.4\").isIpv6()") == "Deny r= e=0", "::1.2.3.4 => " + probe("ip(\"::1.2.3.4\").isIpv6()"))
}
