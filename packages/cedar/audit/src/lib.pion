///| Helpers for the `packages/cedar` red-team tests (`redteam_test.pion`, `control_test.pion`).
///| `decide` prints the same canonical transcript line as `audit/diff/pion_driver` and the Rust
///| oracle (`audit/rust/src/bin/oracle.rs`, `cedar-policy =4.15.0`), so every expected string in
///| the tests can be checked against the reference by running the same input through the oracle.

import "cedar"

///| Standard entity store used by most tests (acyclic, mirrors `diff/gen_cases.py` STD_ENTITIES
///| in the parts the tests rely on).
pub fn std_entities() -> String {
  "[{\"uid\":{\"type\":\"User\",\"id\":\"alice\"},\"attrs\":{\"name\":\"alice\",\"nested\":{\"a\":{\"b\":1}}},\"parents\":[{\"type\":\"Group\",\"id\":\"eng\"}]},{\"uid\":{\"type\":\"Group\",\"id\":\"eng\"},\"attrs\":{},\"parents\":[]}]"
}

///| Standard request: `User::"alice"` / `Action::"view"` / `Doc::"d1"`, context `{n: 5, s: "hello"}`.
pub fn std_request() -> String {
  "{\"principal\":{\"type\":\"User\",\"id\":\"alice\"},\"action\":{\"type\":\"Action\",\"id\":\"view\"},\"resource\":{\"type\":\"Doc\",\"id\":\"d1\"},\"context\":{\"n\":5,\"s\":\"hello\",\"ip\":{\"__extn\":{\"fn\":\"ip\",\"arg\":\"192.168.1.7\"}}}}"
}

fn join_sorted(xs : Array[Int]) -> String {
  let mut i = 1
  while i < xs.length() {
    let x = xs[i]
    let mut j = i - 1
    while j >= 0 && xs[j] > x {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = x
    i = i + 1
  }
  let sb = StringBuilder::new()
  let mut last = -1
  i = 0
  while i < xs.length() {
    if xs[i] != last {
      if sb.to_string().length() > 0 {
        sb.write_string(",")
      }
      sb.write_string(xs[i].to_string())
      last = xs[i]
    }
    i = i + 1
  }
  sb.to_string()
}

fn idx_of(ps : cedar::PolicySet, id : String) -> Int {
  let mut i = 0
  while i < ps.policies.length() {
    if ps.policies[i].id == id {
      return i
    }
    i = i + 1
  }
  -1
}

///| Authorize an already parsed set with explicit limits: `EERR` | `RERR` | `AERR` |
///| `<Allow|Deny> r=<positional idx> e=<positional idx>`.
pub fn decide_ps(
  ps : cedar::PolicySet,
  ents : String,
  req : String,
  auth : cedar::Authorizer,
) -> String {
  let entities = match cedar::entities_from_json(ents) {
    Ok(e) => e
    Err(_) => return "EERR"
  }
  let request = match cedar::request_from_json(req) {
    Ok(r) => r
    Err(_) => return "RERR"
  }
  let resp = match auth.is_authorized(request, ps, entities) {
    Ok(r) => r
    Err(_) => return "AERR"
  }
  let reasons : Array[Int] = []
  let mut i = 0
  while i < resp.diagnostics.reason.length() {
    reasons.push(idx_of(ps, resp.diagnostics.reason[i]))
    i = i + 1
  }
  let errors : Array[Int] = []
  i = 0
  while i < resp.diagnostics.errors.length() {
    errors.push(idx_of(ps, resp.diagnostics.errors[i].policy_id))
    i = i + 1
  }
  let d = if cedar::decision_eq(resp.decision, cedar::Decision::Allow) {
    "Allow"
  } else {
    "Deny"
  }
  d + " r=" + join_sorted(reasons) + " e=" + join_sorted(errors)
}

///| Parse with default limits and authorize with `Authorizer::new()`; `PERR` on parse failure.
pub fn decide(pol : String, ents : String, req : String) -> String {
  match cedar::parse_policy_set(pol) {
    Ok(ps) => decide_ps(ps, ents, req, cedar::Authorizer::new())
    Err(_) => "PERR"
  }
}

///| `decide` with the standard entities and request.
pub fn decide_std(pol : String) -> String {
  decide(pol, std_entities(), std_request())
}

///| Single-permit expression probe on the standard store: `Allow r=0 e=` = true,
///| `Deny r= e=` = false, `Deny r= e=0` = evaluation error, `PERR` = rejected by the parser.
pub fn probe(e : String) -> String {
  decide_std("permit(principal, action, resource) when { " + e + " };")
}

///| `unit` repeated `n` times joined by `sep`.
pub fn rep(unit : String, sep : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(unit)
    i = i + 1
  }
  sb.to_string()
}

///| `principal == User::"u0" || ... || principal == User::"u<n-2>" || principal == User::"alice"`.
pub fn deny_list(n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n - 1 {
    sb.write_string("principal == User::\"u" + i.to_string() + "\" || ")
    i = i + 1
  }
  sb.write_string("principal == User::\"alice\"")
  sb.to_string()
}

///| Does `pionc`-side parsing accept `src`?
pub fn parses(src : String) -> Bool {
  match cedar::parse_policy_set(src) {
    Ok(_) => true
    Err(_) => false
  }
}
