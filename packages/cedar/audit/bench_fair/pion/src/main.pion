///| Blind-spot benchmark workloads for `packages/cedar` (twin of `audit/rust/src/bin/bench_fair.rs`
///| w4 / w5 / w6; stdout must be byte-identical). Request contexts are pre-built on both sides.
///|   w4 <rounds>  parse + index a 2,000-entity JSON DAG (`entities_from_json`), 20 auths per round
///|   w5 <n>       large-set predicates: containsAll / containsAny / contains / set == (1,000 elems)
///|   w6 <n>       12 `like`-heavy policies on URL / host strings

import "cedar"

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

fn sort_strings(xs : Array[String]) -> Unit {
  let mut i = 1
  while i < xs.length() {
    let x = xs[i]
    let mut j = i - 1
    while j >= 0 && xs[j] > x {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = x
    i = i + 1
  }
}

fn line(sb : StringBuilder, idx : Int, resp : cedar::Response) -> Unit {
  sb.write_string(idx.to_string())
  if cedar::decision_eq(resp.decision, cedar::Decision::Allow) {
    sb.write_string(":Allow:")
  } else {
    sb.write_string(":Deny:")
  }
  let rs : Array[String] = []
  let mut i = 0
  while i < resp.diagnostics.reason.length() {
    rs.push(resp.diagnostics.reason[i])
    i = i + 1
  }
  sort_strings(rs)
  i = 0
  while i < rs.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(rs[i])
    i = i + 1
  }
  sb.write_string("\n")
}

fn w4_json() -> String {
  let sb = StringBuilder::new()
  sb.write_string("[")
  let mut first = true
  let mut o = 0
  while o < 20 {
    if !first {
      sb.write_string(",")
    }
    first = false
    sb.write_string("{\"uid\":{\"type\":\"Org\",\"id\":\"o" + o.to_string() + "\"},\"attrs\":{\"name\":\"org " + o.to_string() + "\"},\"parents\":[]}")
    o = o + 1
  }
  let mut g = 0
  while g < 200 {
    sb.write_string(",{\"uid\":{\"type\":\"Group\",\"id\":\"g" + g.to_string() + "\"},\"attrs\":{\"rank\":" + g.to_string() + "},\"parents\":[{\"type\":\"Org\",\"id\":\"o" + (g % 20).to_string() + "\"}]}")
    g = g + 1
  }
  let mut u = 0
  while u < 1780 {
    sb.write_string(",{\"uid\":{\"type\":\"User\",\"id\":\"u" + u.to_string() + "\"},\"attrs\":{\"level\":" + (u % 7).to_string())
    sb.write_string(",\"tags\":[\"t" + (u % 5).to_string() + "\",\"t" + (u % 11).to_string() + "\",\"t" + (u % 13).to_string() + "\"]")
    sb.write_string(",\"ip\":{\"__extn\":{\"fn\":\"ip\",\"arg\":\"10." + (u % 250).to_string() + "." + (u % 200).to_string() + ".1\"}}")
    sb.write_string(",\"mgr\":{\"__entity\":{\"type\":\"User\",\"id\":\"u" + ((u + 1) % 1780).to_string() + "\"}}}")
    sb.write_string(",\"parents\":[{\"type\":\"Group\",\"id\":\"g" + (u % 200).to_string() + "\"},{\"type\":\"Group\",\"id\":\"g" + (u * 7 % 200).to_string() + "\"}]}")
    u = u + 1
  }
  sb.write_string("]")
  sb.to_string()
}

fn uid(t : String, id : String) -> cedar::EntityUid {
  cedar::EntityUid::new(t, id)
}

fn run_w4(world : World, rounds : Int) -> Int {
  let src = w4_json()
  let ps = match cedar::parse_policy_set("permit(principal in Org::\"o3\", action, resource) when { principal.level > 2 };") {
    Ok(p) => p
    Err(_) => return 1
  }
  let mut allows = 0
  let mut count = 0
  let mut r = 0
  while r < rounds {
    let es = match cedar::entities_from_json(src) {
      Ok(e) => e
      Err(e) => {
        io_println(world, "ERR w4: " + e.to_string())
        return 1
      }
    }
    count = es.len()
    let mut k = 0
    while k < 20 {
      let req = cedar::Request::new(uid("User", "u" + (k * 89).to_string()), uid("Action", "view"), uid("Doc", "d"), [])
      match cedar::Authorizer::new().is_authorized(req, ps, es) {
        Ok(resp) => if cedar::decision_eq(resp.decision, cedar::Decision::Allow) { allows = allows + 1 }
        Err(_) => return 1
      }
      k = k + 1
    }
    r = r + 1
  }
  io_println(world, "w4 rounds=" + rounds.to_string() + " entities=" + count.to_string() + " allows=" + allows.to_string())
  0
}

fn strs(lo : Int, hi : Int, step : Int) -> cedar::Value {
  let out : Array[cedar::Value] = []
  let mut k = lo
  while k < hi {
    out.push(cedar::Value::String("s" + k.to_string()))
    k = k + step
  }
  cedar::Value::Set(out)
}

fn authorize_all(world : World, src : String, ctxs : Array[Array[(String, cedar::Value)]], n : Int) -> Int {
  let ps = match cedar::parse_policy_set(src) {
    Ok(p) => p
    Err(e) => {
      io_println(world, "ERR policies: " + e.to_string())
      return 1
    }
  }
  let auth = cedar::Authorizer::new()
  let es = cedar::Entities::empty()
  let out = StringBuilder::new()
  let mut i = 0
  while i < n {
    let req = cedar::Request::new(uid("User", "alice"), uid("Action", "view"), uid("Doc", "d"), ctxs[i % ctxs.length()])
    match auth.is_authorized(req, ps, es) {
      Ok(resp) => line(out, i, resp)
      Err(_) => return 1
    }
    i = i + 1
  }
  io_print(world, out.to_string())
  0
}

fn run_w5(world : World, n : Int) -> Int {
  let src = "permit(principal, action, resource) when { context.granted.containsAll(context.required) };\npermit(principal, action, resource) when { context.granted.containsAny(context.flagged) && context.granted.contains(\"s7\") };\nforbid(principal, action, resource) when { context.revoked == context.required };\n"
  let ctxs : Array[Array[(String, cedar::Value)]] = []
  let mut v = 0
  while v < 10 {
    ctxs.push([
      ("granted", strs(0, 1000 - v * 37, 1)),
      ("required", strs(v * 50, v * 50 + 200, 1)),
      ("flagged", strs(1000 + v, 1300, 3)),
      ("revoked", strs(v * 50 + v % 2, v * 50 + 200, 1)),
    ])
    v = v + 1
  }
  authorize_all(world, src, ctxs, n)
}

fn run_w6(world : World, n : Int) -> Int {
  let pats = [
    "*/api/*/v*/*", "*.example.com", "*admin*", "/static/*.js", "*a*b*c*d*e*", "*-prod-*-*", "/users/*/settings",
    "*\\**", "*%2e%2e*", "*.internal*", "/v1/*/*/*/*", "*?*=*&*=*",
  ]
  let sb = StringBuilder::new()
  let mut k = 0
  while k < pats.length() {
    let eff = if k % 4 == 3 { "forbid" } else { "permit" }
    sb.write_string(eff + "(principal, action, resource) when { context.url like \"" + pats[k] + "\" || context.host like \"" + pats[k] + "\" };\n")
    k = k + 1
  }
  let ctxs : Array[Array[(String, cedar::Value)]] = []
  let mut v = 0
  while v < 64 {
    let seg = StringBuilder::new()
    let mut r = 0
    while r < 1 + v % 5 {
      seg.write_string("abcdefghij")
      r = r + 1
    }
    let s = seg.to_string()
    let q = if v % 3 == 0 { "?q=" + (v * 7).to_string() + "&r=" + (v % 9).to_string() } else { "" }
    let star = if v % 8 == 0 { "*" } else { "" }
    let url = "/api/" + s + "/v" + (v % 3).to_string() + "/" + s + "-prod-" + v.to_string() + "-x" + q + star
    let host = (if v % 2 == 0 { "admin-" } else { "" }) + s + "." + (if v % 3 == 0 { "example.com" } else { "internal.net" })
    ctxs.push([("url", cedar::Value::String(url)), ("host", cedar::Value::String(host))])
    v = v + 1
  }
  authorize_all(world, sb.to_string(), ctxs, n)
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: cedar_rt_bench_fair <w4|w5|w6> <n>")
    return 2
  }
  let n = parse_int(args[2])
  if args[1] == "w4" {
    run_w4(world, n)
  } else if args[1] == "w5" {
    run_w5(world, n)
  } else if args[1] == "w6" {
    run_w6(world, n)
  } else {
    2
  }
}
