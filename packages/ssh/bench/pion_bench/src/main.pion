///| Head-to-head benchmark for `packages/ssh` (Pion Native vs Go `golang.org/x/crypto/ssh`).
///| Modes:
///|   w1 -- 20,000x authorized_keys parse + SHA-256 fingerprint
///|   w2 -- 5,000x known_hosts (|1| HMAC-SHA1) parse+match + 1,000x OpenSSH cert parse + Ed25519 CA verify
///|   w3 -- 1,000x SSHSIG parse + Ed25519 verify + 50,000x RFC 4253 binary packet encode/decode roundtrip

import "ssh"

let ak_line_0 : String = "restrict,command=\"/usr/bin/git-shell -c \\\"git-upload-pack 'repo'\\\"\",from=\"10.0.0.0/8,192.168.1.*\",no-port-forwarding ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHiojgVRI/bzT9/KdnJv9QzVjj6cRUQldIZUq76+c0ib alice@pion.dev"
let ak_line_1 : String = "cert-authority,principals=\"alice,deploy\" ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBJ5Vkt3rF98orgYpBgu1VeYbkpFn+JxK3kLrGdcgIkbW4FuOgOMruOUrOCSG5gRz3wNx8/f1OR6oH7VAC0rEecE= bob@pion.dev"
let ak_line_2 : String = "restrict,from=\"192.0.2.0/24\" ssh-rsa  carol@pion.dev"

let kh_hashed_text : String =
"|1|zP5Wl+PoTJSeV9cix6XxaqulQ7M=|YnLSroYfQzHTHxXKM4KAkUi7ZNw= ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHiojgVRI/bzT9/KdnJv9QzVjj6cRUQldIZUq76+c0ib alice@pion.dev\n" +
"|1|PMPIYQ5YLxw3fRIAFQ6NbUaW4Is=|bOJwh25t84NL1ELNSbtjk7IgRuU= ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBJ5Vkt3rF98orgYpBgu1VeYbkpFn+JxK3kLrGdcgIkbW4FuOgOMruOUrOCSG5gRz3wNx8/f1OR6oH7VAC0rEecE= bob@pion.dev\n"

let ca_ed25519_pub : String = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBp7Jq67dwdZ0voEX708CVgPQflZQuO31qAs0FKyvEdo ca-ed25519@pion.dev"
let alice_cert_line : String = "ssh-ed25519-cert-v01@openssh.com  alice@pion.dev"

let sshsig_msg : String = "tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904\nauthor Alice <alice@pion.dev> 1795425279 +0000\n\nfeat(ssh): initial commit\n"
let sshsig_ed25519_armor : String =
"-----BEGIN SSH SIGNATURE-----\n" +
"U1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgeKiOBVEj9vNP38p2cm/1DNWOPp\n" +
"xFRCV0hlSrvr5zSJsAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\n" +
"AAAAQNSkOF9ZsHasFNO6oD0y5+h0VkiVplRnFH8Vwj0H91m15i/aCUUzqelK/6vIIutxFk\n" +
"8CpMb4ePdGj7lh/sJSnAQ=\n" +
"-----END SSH SIGNATURE-----\n"

///|
fn fnv1a_bytes(h_in : UInt64, b : Bytes) -> UInt64 {
  let mut h = h_in
  let n = b.length()
  let mut i = 0
  while i < n {
    h = (h ^ (b[i].to_int() & 0xFF).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn run_w1(world : World) -> Int {
  let lines = [ak_line_0, ak_line_1, ak_line_2]
  let mut hash : UInt64 = 14695981039346656037UL
  let mut opt_total = 0
  let mut last_fp = ""
  let mut i = 0
  while i < 20000 {
    let line = lines[i % 3]
    match ssh::parse_authorized_key_line(line) {
      Ok(Some(ak)) => {
        opt_total = opt_total + ak.options.length()
        let fp = match ak.key {
          ssh::AuthorizedKeyMaterial::Key(pk) => ssh::public_key_fingerprint_sha256(pk)
          ssh::AuthorizedKeyMaterial::Cert(c) => ssh::public_key_fingerprint_sha256(c.key)
        }
        hash = fnv1a_bytes(hash, fp.to_bytes())
        last_fp = fp
      }
      _ => {
        io_println(world, "FAIL:w1")
        return 1
      }
    }
    i = i + 1
  }
  io_println(world, "mode=w1")
  io_println(world, "count=20000")
  io_println(world, "opt_total=" + opt_total.to_string())
  io_println(world, "last_fp=" + last_fp)
  io_println(world, "hash=" + hash.to_string())
  0
}

///|
fn run_w2(world : World) -> Int {
  let (ca_pk, _) = match ssh::parse_public_key_openssh(ca_ed25519_pub) {
    Ok(v) => v
    Err(_) => {
      io_println(world, "FAIL:w2_ca")
      return 1
    }
  }
  let mut kh_hits = 0
  let mut hash : UInt64 = 14695981039346656037UL
  let mut i = 0
  while i < 5000 {
    let entries = match ssh::parse_known_hosts(kh_hashed_text) {
      Ok(xs) => xs
      Err(_) => {
        io_println(world, "FAIL:w2_kh")
        return 1
      }
    }
    let h1 = ssh::find_known_hosts(entries, "github.com").length()
    let h2 = ssh::find_known_hosts(entries, "[git.example.com]:2222").length()
    let h3 = ssh::find_known_hosts(entries, "other.example.com").length()
    kh_hits = kh_hits + h1 + h2 + h3
    i = i + 1
  }
  let mut cert_ok = 0
  let mut serial_sum : UInt64 = 0UL
  let mut j = 0
  while j < 1000 {
    let (cert, _) = match ssh::Certificate::from_openssh(alice_cert_line) {
      Ok(v) => v
      Err(_) => {
        io_println(world, "FAIL:w2_cert_parse")
        return 1
      }
    }
    match cert.verify(ca_pk, ssh::CertType::User, "alice", 1800000000UL) {
      Ok(_) => {
        cert_ok = cert_ok + 1
        serial_sum = serial_sum + cert.serial
        hash = fnv1a_bytes(hash, cert.key_id.to_bytes())
      }
      Err(_) => {
        io_println(world, "FAIL:w2_cert_verify")
        return 1
      }
    }
    j = j + 1
  }
  io_println(world, "mode=w2")
  io_println(world, "kh_hits=" + kh_hits.to_string())
  io_println(world, "cert_ok=" + cert_ok.to_string())
  io_println(world, "serial_sum=" + serial_sum.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}

///|
fn run_w3(world : World) -> Int {
  let msg = sshsig_msg.to_bytes()
  let mut sig_ok = 0
  let mut hash : UInt64 = 14695981039346656037UL
  let mut i = 0
  while i < 1000 {
    let s = match ssh::parse_sshsig(sshsig_ed25519_armor) {
      Ok(v) => v
      Err(_) => {
        io_println(world, "FAIL:w3_sshsig_parse")
        return 1
      }
    }
    match ssh::sshsig_verify(s, "git", msg) {
      Ok(_) => {
        sig_ok = sig_ok + 1
        hash = fnv1a_bytes(hash, s.namespace.to_bytes())
      }
      Err(_) => {
        io_println(world, "FAIL:w3_sshsig_verify")
        return 1
      }
    }
    i = i + 1
  }

  let payload = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef".to_bytes()
  let limits = ssh::Limits::default()
  let mut pkt_bytes_total = 0
  let mut j = 0
  while j < 50000 {
    let enc = match ssh::encode_binary_packet(payload, 8, 4) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "FAIL:w3_pkt_enc")
        return 1
      }
    }
    let (dec, consumed) = match ssh::decode_binary_packet(enc, limits) {
      Ok(v) => v
      Err(_) => {
        io_println(world, "FAIL:w3_pkt_dec")
        return 1
      }
    }
    pkt_bytes_total = pkt_bytes_total + consumed
    hash = fnv1a_bytes(hash, dec.payload)
    j = j + 1
  }
  io_println(world, "mode=w3")
  io_println(world, "sig_ok=" + sig_ok.to_string())
  io_println(world, "pkt_bytes=" + pkt_bytes_total.to_string())
  io_println(world, "hash=" + hash.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mode = if args.length() > 1 { args[1] } else { "w1" }
  if mode == "w1" {
    run_w1(world)
  } else if mode == "w2" {
    run_w2(world)
  } else if mode == "w3" {
    run_w3(world)
  } else {
    io_println(world, "usage: ssh_bench [w1|w2|w3]")
    1
  }
}
