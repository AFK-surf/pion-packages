"AAAEAggOWoa4xADJLQ3pGjjL1gf/UPQLJm1w1PazePup8p4niojgVRI/bzT9/KdnJv9QzV\n" +
"jj6cRUQldIZUq76+c0ibAAAADmFsaWNlQHBpb24uZGV2AQIDBAUGBw==\n" +
"-----END OPENSSH PRIVATE KEY-----\n"

let vec_bob_priv : String =
"-----BEGIN OPENSSH PRIVATE KEY-----\n" +
"b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAaAAAABNlY2RzYS\n" +
