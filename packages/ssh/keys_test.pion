let vec_alice_fp : String = "SHA256:/qjJWRy8QUCo3C4H7pEmjFSVrY+SrgXh6CrKUeBL39Q"

let vec_bob_pub : String = "ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBJ5Vkt3rF98orgYpBgu1VeYbkpFn+JxK3kLrGdcgIkbW4FuOgOMruOUrOCSG5gRz3wNx8/f1OR6oH7VAC0rEecE= bob@pion.dev"
let vec_bob_fp : String = "SHA256:av7hsI/Wnbkb/uOVXPuQABYL/TVITvtM5MT72cNEWh8"

let vec_carol_pub : String = "ssh-rsa  carol@pion.dev"
let vec_carol_fp : String = "SHA256:hKXW8Xvc7tZWREDZTr7Sf4W1EXKbZDZramc3DwFXtB8"

