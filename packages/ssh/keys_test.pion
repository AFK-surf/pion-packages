///|
test "keys: parse Ed25519 / P-256 / RSA public keys and match OpenSSH SHA256 fingerprints" {
  match parse_public_key_openssh(vec_alice_pub) {
    Ok((pk, comment)) => {
      debug_assert(public_key_algorithm(pk) == "ssh-ed25519", "alice alg")
      debug_assert(comment == "alice@pion.dev", "alice comment")
      debug_assert(public_key_fingerprint_sha256(pk) == vec_alice_fp, "alice fp")
      debug_assert(public_key_fingerprint_eq(pk, vec_alice_fp), "alice fp eq")
      debug_assert(!public_key_fingerprint_eq(pk, vec_bob_fp), "alice fp ne bob")
      debug_assert(public_key_to_openssh(pk, comment) == vec_alice_pub, "alice roundtrip")
    }
    Err(_) => debug_assert(false, "parse alice pub failed")
  }

  match parse_public_key_openssh(vec_bob_pub) {
    Ok((pk, comment)) => {
      debug_assert(public_key_algorithm(pk) == "ecdsa-sha2-nistp256", "bob alg")
      debug_assert(comment == "bob@pion.dev", "bob comment")
      debug_assert(public_key_fingerprint_sha256(pk) == vec_bob_fp, "bob fp")
      debug_assert(public_key_to_openssh(pk, comment) == vec_bob_pub, "bob roundtrip")
    }
    Err(_) => debug_assert(false, "parse bob pub failed")
  }

  match parse_public_key_openssh(vec_carol_pub) {
    Ok((pk, comment)) => {
      debug_assert(public_key_algorithm(pk) == "ssh-rsa", "carol alg")
      debug_assert(comment == "carol@pion.dev", "carol comment")
      debug_assert(public_key_fingerprint_sha256(pk) == vec_carol_fp, "carol fp")
      debug_assert(public_key_to_openssh(pk, comment) == vec_carol_pub, "carol roundtrip")
    }
    Err(_) => debug_assert(false, "parse carol pub failed")
  }
}

///|
test "keys: parse, sign, verify, and roundtrip real OpenSSH Ed25519 and P-256 private keys" {
  match parse_openssh_private_key(vec_alice_priv) {
    Ok(kf) => {
      debug_assert(kf.cipher == "none" && kf.kdf == "none", "alice cipher/kdf")
      debug_assert(kf.comment == "alice@pion.dev", "alice priv comment")
      debug_assert(public_key_fingerprint_sha256(kf.public_key) == vec_alice_fp, "alice priv fp")
      let msg = "pion-ssh-ed25519-sign-test".to_bytes()
      let sig = match private_key_sign(kf.private_key, msg) {
        Ok(s) => s
        Err(_) => {
          debug_assert(false, "ed25519 sign failed")
          Signature::{ algorithm: "", blob: Bytes::new(0) }
        }
      }
      debug_assert(sig.algorithm == "ssh-ed25519", "ed25519 sig alg")
      match public_key_verify(kf.public_key, msg, sig) {
        Ok(_) => ()
        Err(_) => debug_assert(false, "ed25519 verify failed")
      }
      match public_key_verify(kf.public_key, "tampered".to_bytes(), sig) {
        Err(SshError::SignatureVerificationFailed) => ()
        _ => debug_assert(false, "ed25519 tampered should fail")
      }
      let re_pem = match encode_openssh_private_key(kf.private_key, kf.comment, 0x11223344U) {
        Ok(p) => p
        Err(_) => {
          debug_assert(false, "encode alice priv failed")
          ""
        }
      }
      match parse_openssh_private_key(re_pem) {
        Ok(kf2) => {
          debug_assert(
            public_key_fingerprint_sha256(kf2.public_key) == vec_alice_fp,
            "alice re-parse fp",
          )
          debug_assert(kf2.comment == "alice@pion.dev", "alice re-parse comment")
        }
        Err(_) => debug_assert(false, "re-parse alice priv failed")
      }
    }
    Err(_) => debug_assert(false, "parse alice priv failed")
  }

  match parse_openssh_private_key(vec_bob_priv) {
    Ok(kf) => {
      debug_assert(public_key_fingerprint_sha256(kf.public_key) == vec_bob_fp, "bob priv fp")
      debug_assert(kf.comment == "bob@pion.dev", "bob priv comment")
      let msg = "pion-ssh-p256-sign-test".to_bytes()
      let sig = match private_key_sign(kf.private_key, msg) {
        Ok(s) => s
        Err(_) => {
          debug_assert(false, "p256 sign failed")
          Signature::{ algorithm: "", blob: Bytes::new(0) }
        }
      }
      debug_assert(sig.algorithm == "ecdsa-sha2-nistp256", "p256 sig alg")
      match public_key_verify(kf.public_key, msg, sig) {
        Ok(_) => ()
        Err(_) => debug_assert(false, "p256 verify failed")
      }
      let re_pem = match encode_openssh_private_key(kf.private_key, kf.comment, 0x55667788U) {
        Ok(p) => p
        Err(_) => {
          debug_assert(false, "encode bob priv failed")
          ""
        }
      }
      match parse_openssh_private_key(re_pem) {
        Ok(kf2) =>
        debug_assert(public_key_fingerprint_sha256(kf2.public_key) == vec_bob_fp, "bob re-parse fp")
        Err(_) => debug_assert(false, "re-parse bob priv failed")
      }
    }
    Err(_) => debug_assert(false, "parse bob priv failed")
  }
}

///|
test "keys: encrypted OpenSSH key returns EncryptedKeyUnsupported and exposes header metadata" {
  match parse_openssh_private_key(vec_enc_priv) {
    Err(SshError::EncryptedKeyUnsupported(cipher)) =>
    debug_assert(cipher == "aes256-ctr", "enc cipher")
    _ => debug_assert(false, "expected EncryptedKeyUnsupported")
  }
  match parse_openssh_private_key_header(vec_enc_priv) {
    Ok(info) => {
      debug_assert(info.cipher == "aes256-ctr", "header cipher")
      debug_assert(info.kdf == "bcrypt", "header kdf")
      debug_assert(public_key_algorithm(info.public_key) == "ssh-ed25519", "header alg")
    }
    Err(_) => debug_assert(false, "parse_openssh_private_key_header failed")
  }
}

///|
test "keys: rejects checkint mismatch and non-canonical padding in openssh-key-v1" {
  let kf = match parse_openssh_private_key(vec_alice_priv) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse alice priv failed")
      return
    }
  }
  let (seed, pk32) = match kf.private_key {
    PrivateKey::Ed25519(s, p) => (s, p)
    _ => {
      debug_assert(false, "expected ed25519 private key")
      return
    }
  }
  let pub_blob = public_key_to_wire(kf.public_key)

  let inner_bad_ci = SshWriter::new()
  inner_bad_ci.write_u32(0x11111111U)
  inner_bad_ci.write_u32(0x22222222U)
  inner_bad_ci.write_string("ssh-ed25519")
  inner_bad_ci.write_bytes(pk32)
  let sk64 = SshWriter::new()
  sk64.write_raw(seed)
  sk64.write_raw(pk32)
  inner_bad_ci.write_bytes(sk64.to_bytes())
  inner_bad_ci.write_string("bad")
  let mut pad = 1
  while inner_bad_ci.length() % 8 != 0 {
    inner_bad_ci.write_byte(pad.to_byte())
    pad = pad + 1
  }
  let outer1 = SshWriter::new()
  outer1.write_raw("openssh-key-v1\u{00}".to_bytes())
  outer1.write_string("none")
  outer1.write_string("none")
  outer1.write_bytes(Bytes::new(0))
  outer1.write_u32(1U)
  outer1.write_bytes(pub_blob)
  outer1.write_bytes(inner_bad_ci.to_bytes())
  let pem1 = "-----BEGIN OPENSSH PRIVATE KEY-----\n" +
  base64::encode(outer1.to_bytes()) +
  "\n-----END OPENSSH PRIVATE KEY-----\n"
  match parse_openssh_private_key(pem1) {
    Err(SshError::CheckintMismatch) => ()
    _ => debug_assert(false, "expected CheckintMismatch")
  }

  let inner_bad_pad = SshWriter::new()
  inner_bad_pad.write_u32(0x33333333U)
  inner_bad_pad.write_u32(0x33333333U)
  inner_bad_pad.write_string("ssh-ed25519")
  inner_bad_pad.write_bytes(pk32)
  inner_bad_pad.write_bytes(sk64.to_bytes())
  inner_bad_pad.write_string("bad")
  let mut pad2 = 1
  while inner_bad_pad.length() % 8 != 0 {
    if inner_bad_pad.length() % 8 == 7 {
      inner_bad_pad.write_byte((0x99).to_byte())
    } else {
      inner_bad_pad.write_byte(pad2.to_byte())
    }
    pad2 = pad2 + 1
  }
  let outer2 = SshWriter::new()
  outer2.write_raw("openssh-key-v1\u{00}".to_bytes())
  outer2.write_string("none")
  outer2.write_string("none")
  outer2.write_bytes(Bytes::new(0))
  outer2.write_u32(1U)
  outer2.write_bytes(pub_blob)
  outer2.write_bytes(inner_bad_pad.to_bytes())
  let pem2 = "-----BEGIN OPENSSH PRIVATE KEY-----\n" +
  base64::encode(outer2.to_bytes()) +
  "\n-----END OPENSSH PRIVATE KEY-----\n"
  match parse_openssh_private_key(pem2) {
    Err(SshError::InvalidPadding) => ()
    _ => debug_assert(false, "expected InvalidPadding")
  }
}
