///| Dual-target Native + Wasm32 smoke entry for `packages/ssh`.

import "ssh"

let smoke_ca_pub : String = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBp7Jq67dwdZ0voEX708CVgPQflZQuO31qAs0FKyvEdo ca-ed25519@pion.dev"
let smoke_cert : String = "ssh-ed25519-cert-v01@openssh.com  alice@pion.dev"
let smoke_sig : String =
"-----BEGIN SSH SIGNATURE-----\n" +
"U1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgeKiOBVEj9vNP38p2cm/1DNWOPp\n" +
"xFRCV0hlSrvr5zSJsAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\n" +
"AAAAQNSkOF9ZsHasFNO6oD0y5+h0VkiVplRnFH8Vwj0H91m15i/aCUUzqelK/6vIIutxFk\n" +
"8CpMb4ePdGj7lh/sJSnAQ=\n" +
"-----END SSH SIGNATURE-----\n"
let smoke_msg : String = "tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904\nauthor Alice <alice@pion.dev> 1795425279 +0000\n\nfeat(ssh): initial commit\n"
let smoke_kh : String = "|1|zP5Wl+PoTJSeV9cix6XxaqulQ7M=|YnLSroYfQzHTHxXKM4KAkUi7ZNw= ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHiojgVRI/bzT9/KdnJv9QzVjj6cRUQldIZUq76+c0ib alice@pion.dev\n"

///|
pub fn smoke() -> String {
  let (ca_pk, _) = match ssh::parse_public_key_openssh(smoke_ca_pub) {
    Ok(v) => v
    Err(e) => return "FAIL:ca_pub:" + ssh::ssh_error_message(e)
  }
  let (cert, _) = match ssh::Certificate::from_openssh(smoke_cert) {
    Ok(v) => v
    Err(e) => return "FAIL:cert:" + ssh::ssh_error_message(e)
  }
  match cert.verify_with_options(
    ca_pk,
    ssh::CertType::User,
    "alice",
    1800000000UL,
    ssh::CertVerifyOptions::with_client_ip("192.0.2.42"),
  ) {
    Ok(_) => ()
    Err(e) => return "FAIL:cert_verify:" + ssh::ssh_error_message(e)
  }
  let sig = match ssh::parse_sshsig(smoke_sig) {
    Ok(s) => s
    Err(e) => return "FAIL:sshsig:" + ssh::ssh_error_message(e)
  }
  match ssh::sshsig_verify(sig, "git", smoke_msg.to_bytes()) {
    Ok(_) => ()
    Err(e) => return "FAIL:sshsig_verify:" + ssh::ssh_error_message(e)
  }
  let kh = match ssh::parse_known_hosts(smoke_kh) {
    Ok(xs) => xs
    Err(e) => return "FAIL:kh:" + ssh::ssh_error_message(e)
  }
  let matched = ssh::find_known_hosts(kh, "github.com").length()
  let pkt = match ssh::encode_binary_packet("ping".to_bytes(), 8, 4) {
    Ok(b) => b
    Err(e) => return "FAIL:pkt:" + ssh::ssh_error_message(e)
  }
  let (dec, consumed) = match ssh::decode_binary_packet(pkt, ssh::Limits::default()) {
    Ok(v) => v
    Err(e) => return "FAIL:pkt_dec:" + ssh::ssh_error_message(e)
  }
  "ssh_wasm_smoke: OK fp=" +
  ssh::public_key_fingerprint_sha256(cert.key) +
  " serial=" +
  cert.serial.to_string() +
  " kh=" +
  matched.to_string() +
  " pkt=" +
  consumed.to_string() +
  "/" +
  dec.payload.length().to_string()
}

///|
pub fn main(world : World) -> Int {
  let msg = smoke()
  io_println(world, msg)
  if msg.length() >= 18 && msg.code_unit_at(16) == 79 && msg.code_unit_at(17) == 75 {
    0
  } else {
    1
  }
}
