///| Sans-IO RFC 4253 SSH Transport: Version Exchange, Binary Packet, and KEXINIT.

///|
pub struct VersionExchange {
  proto : String
  software : String
  comments : String
}

///|
pub struct BinaryPacket {
  payload : Bytes
  padding_len : Int
}

///|
pub struct KexInit {
  cookie : Bytes
  kex_algorithms : Array[String]
  server_host_key_algorithms : Array[String]
  encryption_c2s : Array[String]
  encryption_s2c : Array[String]
  mac_c2s : Array[String]
  mac_s2c : Array[String]
  compression_c2s : Array[String]
  compression_s2c : Array[String]
  languages_c2s : Array[String]
  languages_s2c : Array[String]
  first_kex_packet_follows : Bool
  reserved : UInt
}

///|
pub struct NegotiatedAlgorithms {
  kex : String
  host_key : String
  cipher_c2s : String
  cipher_s2c : String
  mac_c2s : String
  mac_s2c : String
  compression_c2s : String
  compression_s2c : String
}

///| Parse RFC 4253 §4.2 identification string (`SSH-2.0-software[ comments]\r\n`).
pub fn parse_version_line(line : Bytes) -> Result[VersionExchange, SshError] {
  let n = line.length()
  if n == 0 || n > 255 {
    return Err(SshError::InvalidVersion("version line length out of range"))
  }
  let mut end = n
  if end >= 1 && (line[end - 1].to_int() & 0xFF) == 10 {
    end = end - 1
    if end >= 1 && (line[end - 1].to_int() & 0xFF) == 13 {
      end = end - 1
    }
  } else {
    return Err(SshError::InvalidVersion("version line must end with LF/CRLF"))
  }
  if end < 9 {
    return Err(SshError::InvalidVersion("version line too short"))
  }
  // Must begin with "SSH-"
  if (line[0].to_int() & 0xFF) != 83 ||
  (line[1].to_int() & 0xFF) != 83 ||
  (line[2].to_int() & 0xFF) != 72 ||
  (line[3].to_int() & 0xFF) != 45 {
    return Err(SshError::InvalidVersion("missing SSH- prefix"))
  }
  let mut dash2 = -1
  let mut i = 4
  while i < end {
    if (line[i].to_int() & 0xFF) == 45 {
      dash2 = i
      break
    }
    i = i + 1
  }
  if dash2 <= 4 || dash2 + 1 >= end {
    return Err(SshError::InvalidVersion("missing second '-' in version string"))
  }
  let proto = line.slice(4, dash2).to_string()
  if proto != "2.0" && proto != "1.99" {
    return Err(SshError::InvalidVersion("only SSH protocol 2.0/1.99 is supported, got: " + proto))
  }
  let rest_start = dash2 + 1
  let mut sp = -1
  let mut j = rest_start
  while j < end {
    let c = line[j].to_int() & 0xFF
    if c < 0x20 || c >= 0x7F {
      return Err(SshError::InvalidVersion("non-printable or non-ASCII byte in version string"))
    }
    if c == 32 && sp < 0 {
      sp = j
    }
    j = j + 1
  }
  if sp < 0 {
    let software = line.slice(rest_start, end).to_string()
    if software.length() == 0 {
      return Err(SshError::InvalidVersion("empty software version"))
    }
    Ok(VersionExchange::{ proto, software, comments: "" })
  } else {
    let software = line.slice(rest_start, sp).to_string()
    if software.length() == 0 {
      return Err(SshError::InvalidVersion("empty software version"))
    }
    let comments = line.slice(sp + 1, end).to_string()
    Ok(VersionExchange::{ proto, software, comments })
  }
}

///|
pub fn encode_version_line(v : VersionExchange) -> Bytes {
  let base = "SSH-" + v.proto + "-" + v.software
  let full = if v.comments.length() > 0 {
    base + " " + v.comments + "\r\n"
  } else {
    base + "\r\n"
  }
  full.to_bytes()
}

///| Encode an unencrypted RFC 4253 §6 binary packet.
pub fn encode_binary_packet(
  payload : Bytes,
  block_size : Int,
  min_padding : Int,
) -> Result[Bytes, SshError] {
  let bs = if block_size < 8 { 8 } else { block_size }
  let min_pad = if min_padding < 4 { 4 } else { min_padding }
  let plen = payload.length()
  // total = 4 (packet_length) + 1 (padding_length) + plen + pad_len
  let base = 5 + plen
  let mut pad_len = bs - (base % bs)
  if pad_len < min_pad {
    pad_len = pad_len + bs
  }
  while pad_len < min_pad {
    pad_len = pad_len + bs
  }
  if pad_len > 255 {
    return Err(SshError::InvalidPacket("padding exceeds 255 bytes"))
  }
  let packet_len = 1 + plen + pad_len
  let total = 4 + packet_len
  let mut out = Bytes::new(total)
  let pl_u = packet_len.to_uint()
  out[0] = ((pl_u >> 24) & 0xFFU).to_int().to_byte()
  out[1] = ((pl_u >> 16) & 0xFFU).to_int().to_byte()
  out[2] = ((pl_u >> 8) & 0xFFU).to_int().to_byte()
  out[3] = (pl_u & 0xFFU).to_int().to_byte()
  out[4] = pad_len.to_byte()
  let mut i = 0
  while i < plen {
    out[5 + i] = payload[i]
    i = i + 1
  }
  // Zero-filled padding (caller may randomize when encrypting)
  Ok(out)
}

///| Decode one unencrypted RFC 4253 §6 binary packet from a streaming buffer.
pub fn decode_binary_packet(
  data : Bytes,
  limits : Limits,
) -> Result[(BinaryPacket, Int), SshError] {
  let n = data.length()
  if n < 5 {
    return Err(SshError::UnexpectedEof)
  }
  let b0 = (data[0].to_int() & 0xFF).to_uint()
  let b1 = (data[1].to_int() & 0xFF).to_uint()
  let b2 = (data[2].to_int() & 0xFF).to_uint()
  let b3 = (data[3].to_int() & 0xFF).to_uint()
  let pkt_len_u = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
  if pkt_len_u > limits.max_packet_len.to_uint() {
    return Err(SshError::LimitExceeded("packet_length exceeds max_packet_len"))
  }
  let pkt_len = pkt_len_u.to_int()
  if pkt_len < 5 {
    return Err(SshError::InvalidPacket("packet_length too small"))
  }
  let total = 4 + pkt_len
  if n < total {
    return Err(SshError::UnexpectedEof)
  }
  if total % 8 != 0 {
    return Err(SshError::InvalidPacket("binary packet length must be a multiple of 8"))
  }
  let pad_len = data[4].to_int() & 0xFF
  if pad_len < 4 {
    return Err(SshError::InvalidPacket("padding_length must be >= 4"))
  }
  if pad_len >= pkt_len {
    return Err(SshError::InvalidPacket("padding_length exceeds packet_length"))
  }
  let payload_len = pkt_len - 1 - pad_len
  let payload = data.slice(5, 5 + payload_len)
  Ok((BinaryPacket::{ payload, padding_len: pad_len }, total))
}

///| Validate every name in a KEXINIT algorithm/language name-list (RFC 4251 §6: non-empty printable US-ASCII, no comma).
fn validate_kex_name_list(names : Array[String]) -> Result[Unit, SshError] {
  let mut i = 0
  while i < names.length() {
    let b = names[i].to_bytes()
    if !is_valid_ssh_name_bytes(b, 0, b.length()) {
      return Err(SshError::InvalidPacket("invalid algorithm name in KEXINIT name-list"))
    }
    i = i + 1
  }
  Ok(())
}

///|
pub fn KexInit::to_payload(self : KexInit) -> Result[Bytes, SshError] {
  if self.cookie.length() != 16 {
    return Err(SshError::InvalidPacket("KEXINIT cookie must be 16 bytes"))
  }
  match validate_kex_name_list(self.kex_algorithms) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match validate_kex_name_list(self.server_host_key_algorithms) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match validate_kex_name_list(self.encryption_c2s) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match validate_kex_name_list(self.encryption_s2c) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match validate_kex_name_list(self.mac_c2s) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match validate_kex_name_list(self.mac_s2c) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match validate_kex_name_list(self.compression_c2s) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match validate_kex_name_list(self.compression_s2c) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match validate_kex_name_list(self.languages_c2s) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match validate_kex_name_list(self.languages_s2c) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let w = SshWriter::new()
  w.write_byte((20).to_byte())
  w.write_raw(self.cookie)
  w.write_name_list(self.kex_algorithms)
  w.write_name_list(self.server_host_key_algorithms)
  w.write_name_list(self.encryption_c2s)
  w.write_name_list(self.encryption_s2c)
  w.write_name_list(self.mac_c2s)
  w.write_name_list(self.mac_s2c)
  w.write_name_list(self.compression_c2s)
  w.write_name_list(self.compression_s2c)
  w.write_name_list(self.languages_c2s)
  w.write_name_list(self.languages_s2c)
  w.write_bool(self.first_kex_packet_follows)
  w.write_u32(self.reserved)
  Ok(w.to_bytes())
}

///|
pub fn KexInit::from_payload(payload : Bytes, limits : Limits) -> Result[KexInit, SshError] {
  let r = SshReader::with_limits(payload, limits)
  let msg_code = match r.read_byte() {
    Ok(b) => b.to_int() & 0xFF
    Err(e) => return Err(e)
  }
  if msg_code != 20 {
    return Err(SshError::InvalidPacket("expected SSH_MSG_KEXINIT (20), got: " + msg_code.to_string()))
  }
  let cookie = match r.read_exact(16) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let kex_algorithms = match r.read_name_list() {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let server_host_key_algorithms = match r.read_name_list() {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let encryption_c2s = match r.read_name_list() {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let encryption_s2c = match r.read_name_list() {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mac_c2s = match r.read_name_list() {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let mac_s2c = match r.read_name_list() {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let compression_c2s = match r.read_name_list() {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let compression_s2c = match r.read_name_list() {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let languages_c2s = match r.read_name_list() {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let languages_s2c = match r.read_name_list() {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let first_kex_packet_follows = match r.read_bool() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let reserved = match r.read_u32() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match r.expect_eof() {
    Ok(_) => {
      Ok(KexInit::{
        cookie,
        kex_algorithms,
        server_host_key_algorithms,
        encryption_c2s,
        encryption_s2c,
        mac_c2s,
        mac_s2c,
        compression_c2s,
        compression_s2c,
        languages_c2s,
        languages_s2c,
        first_kex_packet_follows,
        reserved,
      })
    }
    Err(e) => Err(e)
  }
}

///|
fn pick_first_common(
  label : String,
  client : Array[String],
  server : Array[String],
) -> Result[String, SshError] {
  let mut i = 0
  while i < client.length() {
    let cand = client[i]
    let mut j = 0
    while j < server.length() {
      if server[j] == cand {
        return Ok(cand)
      }
      j = j + 1
    }
    i = i + 1
  }
  Err(SshError::NoCommonAlgorithm(label))
}

///| RFC 4253 §7.1 client-preference algorithm negotiation.
pub fn negotiate_kex(client : KexInit, server : KexInit) -> Result[NegotiatedAlgorithms, SshError] {
  let kex = match pick_first_common("kex", client.kex_algorithms, server.kex_algorithms) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let host_key = match pick_first_common(
    "host_key",
    client.server_host_key_algorithms,
    server.server_host_key_algorithms,
  ) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let cipher_c2s = match pick_first_common(
    "encryption_c2s",
    client.encryption_c2s,
    server.encryption_c2s,
  ) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let cipher_s2c = match pick_first_common(
    "encryption_s2c",
    client.encryption_s2c,
    server.encryption_s2c,
  ) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let mac_c2s = match pick_first_common("mac_c2s", client.mac_c2s, server.mac_c2s) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let mac_s2c = match pick_first_common("mac_s2c", client.mac_s2c, server.mac_s2c) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let compression_c2s = match pick_first_common(
    "compression_c2s",
    client.compression_c2s,
    server.compression_c2s,
  ) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let compression_s2c = match pick_first_common(
    "compression_s2c",
    client.compression_s2c,
    server.compression_s2c,
  ) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok(NegotiatedAlgorithms::{
    kex,
    host_key,
    cipher_c2s,
    cipher_s2c,
    mac_c2s,
    mac_s2c,
    compression_c2s,
    compression_s2c,
  })
}
