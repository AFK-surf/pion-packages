///| OpenSSH `SSHSIG` (`-----BEGIN SSH SIGNATURE-----`) signing and verification.
///| Implements PROTOCOL.sshsig (Git commit/tag SSH signatures).

import "crypto"

///|
pub enum HashAlgorithm {
  Sha256
  Sha512
}

///|
pub struct SshSig {
  version : UInt
  public_key : PublicKey
  namespace : String
  reserved : Bytes
  hash_algorithm : HashAlgorithm
  signature : Signature
}

///|
fn hash_alg_name(h : HashAlgorithm) -> String {
  match h {
    HashAlgorithm::Sha256 => "sha256"
    HashAlgorithm::Sha512 => "sha512"
  }
}

///|
pub fn sshsig_signed_data(
  namespace : String,
  reserved : Bytes,
  hash_alg : HashAlgorithm,
  message : Bytes,
) -> Bytes {
  let digest = match hash_alg {
    HashAlgorithm::Sha256 => crypto::sha256(message)
    HashAlgorithm::Sha512 => crypto::sha512(message)
  }
  let w = SshWriter::new()
  w.write_raw("SSHSIG".to_bytes())
  w.write_string(namespace)
  w.write_bytes(reserved)
  w.write_string(hash_alg_name(hash_alg))
  w.write_bytes(digest)
  w.to_bytes()
}

///|
pub fn parse_sshsig(armored : String) -> Result[SshSig, SshError] {
  let blob = match decode_armor(
    armored,
    "-----BEGIN SSH SIGNATURE-----",
    "-----END SSH SIGNATURE-----",
  ) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let r = SshReader::new(blob)
  let magic = match r.read_exact(6) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  if !ssh_bytes_eq(magic, "SSHSIG".to_bytes()) {
    return Err(SshError::InvalidSignature("invalid SSHSIG magic preamble"))
  }
  let version = match r.read_u32() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if version != 1U {
    return Err(SshError::InvalidSignature("unsupported SSHSIG version: " + version.to_string()))
  }
  let pk_blob = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let public_key = match parse_public_key_wire(pk_blob) {
    Ok(k) => k
    Err(e) => return Err(e)
  }
  let namespace = match r.read_string() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if namespace.length() == 0 {
    return Err(SshError::InvalidSignature("empty SSHSIG namespace"))
  }
  let reserved = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let hash_name = match r.read_string() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let hash_algorithm = if hash_name == "sha256" {
    HashAlgorithm::Sha256
  } else if hash_name == "sha512" {
    HashAlgorithm::Sha512
  } else {
    return Err(SshError::UnsupportedAlgorithm(hash_name))
  }
  let sig_blob = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let signature = match Signature::from_wire(sig_blob) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  match r.expect_eof() {
    Ok(_) => {
      Ok(SshSig::{ version, public_key, namespace, reserved, hash_algorithm, signature })
    }
    Err(e) => Err(e)
  }
}

///|
pub fn encode_sshsig(sig : SshSig) -> String {
  let w = SshWriter::new()
  w.write_raw("SSHSIG".to_bytes())
  w.write_u32(sig.version)
  w.write_bytes(public_key_to_wire(sig.public_key))
  w.write_string(sig.namespace)
  w.write_bytes(sig.reserved)
  w.write_string(hash_alg_name(sig.hash_algorithm))
  w.write_bytes(sig.signature.to_wire())
  encode_armor(
    w.to_bytes(),
    "-----BEGIN SSH SIGNATURE-----",
    "-----END SSH SIGNATURE-----",
  )
}

///|
pub fn sshsig_sign(
  key : PrivateKey,
  namespace : String,
  hash_alg : HashAlgorithm,
  message : Bytes,
) -> Result[SshSig, SshError] {
  if namespace.length() == 0 {
    return Err(SshError::InvalidSignature("empty SSHSIG namespace"))
  }
  let reserved = Bytes::new(0)
  let signed = sshsig_signed_data(namespace, reserved, hash_alg, message)
  let signature = match private_key_sign(key, signed) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok(SshSig::{
    version: 1U,
    public_key: private_key_public_key(key),
    namespace,
    reserved,
    hash_algorithm: hash_alg,
    signature,
  })
}

///| Self-contained SSHSIG cryptographic check (like `ssh-keygen -Y check-novalidate`).
///| Note: does NOT establish signer trust; callers verifying authenticity MUST use
///| `sshsig_verify_with_key` or `sshsig_verify_allowed` with a trusted public key anchor.
pub fn sshsig_verify(
  sig : SshSig,
  expected_namespace : String,
  message : Bytes,
) -> Result[Unit, SshError] {
  if sig.version != 1U {
    return Err(SshError::InvalidSignature("unsupported SSHSIG version"))
  }
  if sig.namespace != expected_namespace {
    return Err(SshError::NamespaceMismatch)
  }
  let signed = sshsig_signed_data(sig.namespace, sig.reserved, sig.hash_algorithm, message)
  public_key_verify(sig.public_key, signed, sig.signature)
}

///| Verify an SSHSIG against a specific trusted public key (trust anchor).
pub fn sshsig_verify_with_key(
  sig : SshSig,
  trusted_key : PublicKey,
  expected_namespace : String,
  message : Bytes,
) -> Result[Unit, SshError] {
  if !crypto::constant_time_eq(public_key_to_wire(sig.public_key), public_key_to_wire(trusted_key)) {
    return Err(SshError::SignatureVerificationFailed)
  }
  sshsig_verify(sig, expected_namespace, message)
}

///| Verify an SSHSIG against a non-empty list of allowed signer public keys (like `ssh-keygen -Y verify`).
pub fn sshsig_verify_allowed(
  sig : SshSig,
  allowed_keys : Array[PublicKey],
  expected_namespace : String,
  message : Bytes,
) -> Result[Unit, SshError] {
  let sig_wire = public_key_to_wire(sig.public_key)
  let mut matched = false
  let mut i = 0
  while i < allowed_keys.length() {
    if crypto::constant_time_eq(sig_wire, public_key_to_wire(allowed_keys[i])) {
      matched = true
      break
    }
    i = i + 1
  }
  if !matched {
    return Err(SshError::SignatureVerificationFailed)
  }
  sshsig_verify(sig, expected_namespace, message)
}
