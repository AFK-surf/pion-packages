///| OpenSSH `SSHSIG` (`-----BEGIN SSH SIGNATURE-----`) signing and verification.
///| Stub implementation for Red phase.

///|
pub enum HashAlgorithm {
  Sha256
  Sha512
}

///|
pub struct SshSig {
  version : UInt
  public_key : PublicKey
  namespace : String
  reserved : Bytes
  hash_algorithm : HashAlgorithm
  signature : Signature
}

///|
pub fn sshsig_signed_data(
  namespace : String,
  reserved : Bytes,
  hash_alg : HashAlgorithm,
  message : Bytes,
) -> Bytes {
  let _ = namespace
  let _ = reserved
  let _ = hash_alg
  let _ = message
  Bytes::new(0)
}

///|
pub fn parse_sshsig(armored : String) -> Result[SshSig, SshError] {
  let _ = armored
  Err(SshError::InvalidWireFormat("not implemented"))
}

///|
pub fn encode_sshsig(sig : SshSig) -> String {
  let _ = sig
  ""
}

///|
pub fn sshsig_sign(
  key : PrivateKey,
