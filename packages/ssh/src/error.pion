///| Error types for `packages/ssh`.
///| Immutable value type (`Send`), zero `World` dependencies, no panics.

///|
pub enum SshError {
  UnexpectedEof
  TrailingBytes(Int)
  LimitExceeded(String)
  InvalidUtf8
  InvalidBase64(String)
  InvalidWireFormat(String)
  NonCanonicalMpint
  NegativeMpint
  UnsupportedAlgorithm(String)
  InvalidKey(String)
  EncryptedKeyUnsupported(String)
  CheckintMismatch
  InvalidPadding
  InvalidCertificate(String)
  CertificateExpired
  CertificateNotYetValid
  PrincipalMismatch
  CertTypeMismatch
  InvalidSignature(String)
  SignatureVerificationFailed
  InvalidArmor(String)
  NamespaceMismatch
  InvalidAuthorizedKey(String)
  InvalidKnownHost(String)
  InvalidPacket(String)
  InvalidVersion(String)
  NoCommonAlgorithm(String)
}

///|
pub fn ssh_error_eq(a : SshError, b : SshError) -> Bool {
  match (a, b) {
    (SshError::UnexpectedEof, SshError::UnexpectedEof) => true
    (SshError::TrailingBytes(x), SshError::TrailingBytes(y)) => x == y
    (SshError::LimitExceeded(x), SshError::LimitExceeded(y)) => x == y
    (SshError::InvalidUtf8, SshError::InvalidUtf8) => true
    (SshError::InvalidBase64(x), SshError::InvalidBase64(y)) => x == y
    (SshError::InvalidWireFormat(x), SshError::InvalidWireFormat(y)) => x == y
    (SshError::NonCanonicalMpint, SshError::NonCanonicalMpint) => true
    (SshError::NegativeMpint, SshError::NegativeMpint) => true
    (SshError::UnsupportedAlgorithm(x), SshError::UnsupportedAlgorithm(y)) => x == y
    (SshError::InvalidKey(x), SshError::InvalidKey(y)) => x == y
    (SshError::EncryptedKeyUnsupported(x), SshError::EncryptedKeyUnsupported(y)) => x == y
    (SshError::CheckintMismatch, SshError::CheckintMismatch) => true
    (SshError::InvalidPadding, SshError::InvalidPadding) => true
    (SshError::InvalidCertificate(x), SshError::InvalidCertificate(y)) => x == y
    (SshError::CertificateExpired, SshError::CertificateExpired) => true
    (SshError::CertificateNotYetValid, SshError::CertificateNotYetValid) => true
    (SshError::PrincipalMismatch, SshError::PrincipalMismatch) => true
    (SshError::CertTypeMismatch, SshError::CertTypeMismatch) => true
    (SshError::InvalidSignature(x), SshError::InvalidSignature(y)) => x == y
    (SshError::SignatureVerificationFailed, SshError::SignatureVerificationFailed) => true
    (SshError::InvalidArmor(x), SshError::InvalidArmor(y)) => x == y
    (SshError::NamespaceMismatch, SshError::NamespaceMismatch) => true
    (SshError::InvalidAuthorizedKey(x), SshError::InvalidAuthorizedKey(y)) => x == y
    (SshError::InvalidKnownHost(x), SshError::InvalidKnownHost(y)) => x == y
    (SshError::InvalidPacket(x), SshError::InvalidPacket(y)) => x == y
    (SshError::InvalidVersion(x), SshError::InvalidVersion(y)) => x == y
    (SshError::NoCommonAlgorithm(x), SshError::NoCommonAlgorithm(y)) => x == y
    _ => false
  }
}

///|
pub fn ssh_error_message(e : SshError) -> String {
  match e {
    SshError::UnexpectedEof => "unexpected end of SSH input"
    SshError::TrailingBytes(n) => "unexpected trailing bytes: " + n.to_string()
    SshError::LimitExceeded(s) => "SSH limit exceeded: " + s
    SshError::InvalidUtf8 => "invalid UTF-8 string in SSH wire format"
    SshError::InvalidBase64(s) => "invalid base64: " + s
    SshError::InvalidWireFormat(s) => "invalid SSH wire format: " + s
    SshError::NonCanonicalMpint => "non-canonical mpint encoding"
    SshError::NegativeMpint => "negative mpint is not allowed"
    SshError::UnsupportedAlgorithm(s) => "unsupported SSH algorithm: " + s
    SshError::InvalidKey(s) => "invalid SSH key: " + s
    SshError::EncryptedKeyUnsupported(s) => "encrypted OpenSSH private key unsupported: " + s
    SshError::CheckintMismatch => "OpenSSH private key checkint mismatch"
    SshError::InvalidPadding => "invalid OpenSSH private key padding"
    SshError::InvalidCertificate(s) => "invalid OpenSSH certificate: " + s
    SshError::CertificateExpired => "OpenSSH certificate expired"
    SshError::CertificateNotYetValid => "OpenSSH certificate not yet valid"
    SshError::PrincipalMismatch => "OpenSSH certificate principal mismatch"
    SshError::CertTypeMismatch => "OpenSSH certificate type mismatch"
    SshError::InvalidSignature(s) => "invalid SSH signature: " + s
    SshError::SignatureVerificationFailed => "SSH signature verification failed"
    SshError::InvalidArmor(s) => "invalid PEM/SSHSIG armor: " + s
    SshError::NamespaceMismatch => "SSHSIG namespace mismatch"
    SshError::InvalidAuthorizedKey(s) => "invalid authorized_keys entry: " + s
    SshError::InvalidKnownHost(s) => "invalid known_hosts entry: " + s
    SshError::InvalidPacket(s) => "invalid SSH binary packet: " + s
    SshError::InvalidVersion(s) => "invalid SSH protocol version exchange: " + s
    SshError::NoCommonAlgorithm(s) => "no common SSH algorithm for: " + s
  }
}
