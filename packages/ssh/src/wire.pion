///| RFC 4251 SSH binary wire codec (`SshReader`, `SshWriter`, `Limits`).
///| Zero `World` dependencies, strict canonical `mpint` checks, DoS bounds via `Limits`.

///|
#verify
pub struct Limits {
  max_string_len : Int
  max_packet_len : Int
  max_list_items : Int
}

///|
#verify
pub fn Limits::default() -> Limits {
  Limits::{ max_string_len: 1048576, max_packet_len: 35000, max_list_items: 256 }
}

///| Validate UTF-8 byte sequence strictly (RFC 3629).
fn is_valid_utf8(data : Bytes, start : Int, end : Int) -> Bool {
  let mut i = start
  while i < end {
    let b0 = data[i].to_int() & 0xFF
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= end {
        return false
      }
      let b1 = data[i + 1].to_int() & 0xFF
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int() & 0xFF
      let b2 = data[i + 2].to_int() & 0xFF
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int() & 0xFF
      let b2 = data[i + 2].to_int() & 0xFF
      let b3 = data[i + 3].to_int() & 0xFF
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return false
      }
      if b0 == 0xF4 && b1 >= 0x90 {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///|
fn ssh_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
pub struct SshReader {
  data : Bytes
  mut pos : Int
  limits : Limits
}

///|
pub fn SshReader::new(data : Bytes) -> SshReader {
  SshReader::{ data, pos: 0, limits: Limits::default() }
}

///|
pub fn SshReader::with_limits(data : Bytes, limits : Limits) -> SshReader {
  SshReader::{ data, pos: 0, limits }
}

///|
pub fn SshReader::remaining(self : SshReader) -> Int {
  self.data.length() - self.pos
}

///|
pub fn SshReader::position(self : SshReader) -> Int {
  self.pos
}

///|
pub fn SshReader::is_empty(self : SshReader) -> Bool {
  self.pos >= self.data.length()
}

///|
pub fn SshReader::expect_eof(self : SshReader) -> Result[Unit, SshError] {
  let rem = self.remaining()
  if rem == 0 {
    Ok(())
  } else {
    Err(SshError::TrailingBytes(rem))
  }
}

///|
pub fn SshReader::read_byte(self : SshReader) -> Result[Byte, SshError] {
  if self.pos >= self.data.length() {
    return Err(SshError::UnexpectedEof)
  }
  let b = self.data[self.pos]
  self.pos = self.pos + 1
  Ok(b)
}

///|
pub fn SshReader::read_bool(self : SshReader) -> Result[Bool, SshError] {
  match self.read_byte() {
    Ok(b) => Ok((b.to_int() & 0xFF) != 0)
    Err(e) => Err(e)
  }
}

///|
pub fn SshReader::read_u32(self : SshReader) -> Result[UInt, SshError] {
  if self.remaining() < 4 {
    return Err(SshError::UnexpectedEof)
  }
  let p = self.pos
  let b0 = (self.data[p].to_int() & 0xFF).to_uint()
  let b1 = (self.data[p + 1].to_int() & 0xFF).to_uint()
  let b2 = (self.data[p + 2].to_int() & 0xFF).to_uint()
  let b3 = (self.data[p + 3].to_int() & 0xFF).to_uint()
  self.pos = p + 4
  Ok((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
}

///|
pub fn SshReader::read_u64(self : SshReader) -> Result[UInt64, SshError] {
  if self.remaining() < 8 {
    return Err(SshError::UnexpectedEof)
  }
  let p = self.pos
  let mut v = 0UL
  let mut i = 0
  while i < 8 {
    v = (v << 8) | (self.data[p + i].to_int() & 0xFF).to_int64().to_uint64()
    i = i + 1
  }
  self.pos = p + 8
  Ok(v)
}

///|
pub fn SshReader::read_exact(self : SshReader, n : Int) -> Result[Bytes, SshError] {
  if n < 0 {
    return Err(SshError::InvalidWireFormat("negative length"))
  }
  if n > self.limits.max_string_len {
    return Err(SshError::LimitExceeded("length exceeds max_string_len"))
  }
  if self.remaining() < n {
    return Err(SshError::UnexpectedEof)
  }
  let start = self.pos
  self.pos = start + n
  Ok(self.data.slice(start, start + n))
}

///|
pub fn SshReader::read_bytes(self : SshReader) -> Result[Bytes, SshError] {
  let len_u = match self.read_u32() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if len_u > self.limits.max_string_len.to_uint() {
    return Err(SshError::LimitExceeded("string length exceeds max_string_len"))
  }
  let len = len_u.to_int()
  if self.remaining() < len {
    return Err(SshError::UnexpectedEof)
  }
  let start = self.pos
  self.pos = start + len
  Ok(self.data.slice(start, start + len))
}

///|
pub fn SshReader::read_string(self : SshReader) -> Result[String, SshError] {
  let len_u = match self.read_u32() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if len_u > self.limits.max_string_len.to_uint() {
    return Err(SshError::LimitExceeded("string length exceeds max_string_len"))
  }
  let len = len_u.to_int()
  if self.remaining() < len {
    return Err(SshError::UnexpectedEof)
  }
  let start = self.pos
  let end = start + len
  if !is_valid_utf8(self.data, start, end) {
    return Err(SshError::InvalidUtf8)
  }
  self.pos = end
  Ok(self.data.slice(start, end).to_string())
}

///| Strict RFC 4251 §5 unsigned mpint reader.
///| Rejects negative values (MSB >= 0x80) and non-canonical leading zeros.
///| Returns canonical big-endian unsigned bytes (empty for zero, no leading zero byte).
pub fn SshReader::read_mpint_unsigned(self : SshReader) -> Result[Bytes, SshError] {
  let raw = match self.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let n = raw.length()
  if n == 0 {
    return Ok(raw)
  }
  let first = raw[0].to_int() & 0xFF
  if (first & 0x80) != 0 {
    return Err(SshError::NegativeMpint)
  }
  if first == 0 {
    if n == 1 {
      return Err(SshError::NonCanonicalMpint)
    }
    let second = raw[1].to_int() & 0xFF
    if (second & 0x80) == 0 {
      return Err(SshError::NonCanonicalMpint)
    }
    return Ok(raw.slice(1, n))
  }
  Ok(raw)
}

///| RFC 4251 §6 printable non-space US-ASCII check for algorithm/method names (no comma, no whitespace, no control/non-ASCII).
fn is_valid_ssh_name_bytes(data : Bytes, start : Int, end : Int) -> Bool {
  if end <= start {
    return false
  }
  let mut i = start
  while i < end {
    let c = data[i].to_int() & 0xFF
    if c < 0x21 || c > 0x7E || c == 44 {
      return false
    }
    i = i + 1
  }
  true
}

///| RFC 4251 §5 / §6 name-list reader (enforces printable US-ASCII names).
pub fn SshReader::read_name_list(self : SshReader) -> Result[Array[String], SshError] {
  let raw = match self.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let n = raw.length()
  let out : Array[String] = []
  if n == 0 {
    return Ok(out)
  }
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || (raw[i].to_int() & 0xFF) == 44 {
      if i == start {
        return Err(SshError::InvalidWireFormat("empty element in name-list"))
      }
      if out.length() >= self.limits.max_list_items {
        return Err(SshError::LimitExceeded("name-list exceeds max_list_items"))
      }
      if !is_valid_ssh_name_bytes(raw, start, i) {
        return Err(SshError::InvalidWireFormat("non-ASCII or non-printable algorithm name in name-list"))
      }
      out.push(raw.slice(start, i).to_string())
      start = i + 1
    }
    i = i + 1
  }
  Ok(out)
}

///|
pub struct SshWriter {
  buf : Array[Byte]
}

///|
pub fn SshWriter::new() -> SshWriter {
  SshWriter::{ buf: [] }
}

///|
pub fn SshWriter::with_capacity(cap : Int) -> SshWriter {
  let _ = cap
  SshWriter::{ buf: [] }
}

///|
pub fn SshWriter::length(self : SshWriter) -> Int {
  self.buf.length()
}

///|
pub fn SshWriter::write_byte(self : SshWriter, b : Byte) -> Unit {
  self.buf.push(b)
}

///|
pub fn SshWriter::write_bool(self : SshWriter, v : Bool) -> Unit {
  self.buf.push(if v { (1).to_byte() } else { (0).to_byte() })
}

///|
pub fn SshWriter::write_u32(self : SshWriter, v : UInt) -> Unit {
  self.buf.push(((v >> 24) & 0xFFU).to_int().to_byte())
  self.buf.push(((v >> 16) & 0xFFU).to_int().to_byte())
  self.buf.push(((v >> 8) & 0xFFU).to_int().to_byte())
  self.buf.push((v & 0xFFU).to_int().to_byte())
}

///|
pub fn SshWriter::write_u64(self : SshWriter, v : UInt64) -> Unit {
  self.buf.push(((v >> 56) & 0xFFUL).to_int64().to_int().to_byte())
  self.buf.push(((v >> 48) & 0xFFUL).to_int64().to_int().to_byte())
  self.buf.push(((v >> 40) & 0xFFUL).to_int64().to_int().to_byte())
  self.buf.push(((v >> 32) & 0xFFUL).to_int64().to_int().to_byte())
  self.buf.push(((v >> 24) & 0xFFUL).to_int64().to_int().to_byte())
  self.buf.push(((v >> 16) & 0xFFUL).to_int64().to_int().to_byte())
  self.buf.push(((v >> 8) & 0xFFUL).to_int64().to_int().to_byte())
  self.buf.push((v & 0xFFUL).to_int64().to_int().to_byte())
}

///|
pub fn SshWriter::write_raw(self : SshWriter, data : Bytes) -> Unit {
  let n = data.length()
  let mut i = 0
  while i < n {
    self.buf.push(data[i])
    i = i + 1
  }
}

///|
pub fn SshWriter::write_bytes(self : SshWriter, data : Bytes) -> Unit {
  self.write_u32(data.length().to_uint())
  self.write_raw(data)
}

///|
pub fn SshWriter::write_string(self : SshWriter, s : String) -> Unit {
  self.write_bytes(s.to_bytes())
}

///|
pub fn SshWriter::write_mpint_unsigned(self : SshWriter, be_bytes : Bytes) -> Unit {
  let n = be_bytes.length()
  let mut first = 0
  while first < n && (be_bytes[first].to_int() & 0xFF) == 0 {
    first = first + 1
  }
  if first == n {
    self.write_u32(0U)
    return
  }
  let sig_len = n - first
  let need_zero = ((be_bytes[first].to_int() & 0xFF) & 0x80) != 0
  if need_zero {
    self.write_u32((sig_len + 1).to_uint())
    self.buf.push((0).to_byte())
  } else {
    self.write_u32(sig_len.to_uint())
  }
  let mut i = first
  while i < n {
    self.buf.push(be_bytes[i])
    i = i + 1
  }
}

///|
pub fn SshWriter::write_name_list(self : SshWriter, names : Array[String]) -> Unit {
  let count = names.length()
  if count == 0 {
    self.write_u32(0U)
    return
  }
  let mut total = count - 1
  let mut i = 0
  while i < count {
    total = total + names[i].to_bytes().length()
    i = i + 1
  }
  self.write_u32(total.to_uint())
  let mut j = 0
  while j < count {
    if j > 0 {
      self.buf.push((44).to_byte())
    }
    self.write_raw(names[j].to_bytes())
    j = j + 1
  }
}

///|
pub fn SshWriter::to_bytes(self : SshWriter) -> Bytes {
  let n = self.buf.length()
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = self.buf[i]
    i = i + 1
  }
  out
}
