///| OpenSSH Certificates (`*-cert-v01@openssh.com`) parser, serializer, and verifier.

import "base64"

///|
#verify
pub enum CertType {
  User
  Host
}

///| Encode an OpenSSH `CertType` to its wire uint32 (`1` = User, `2` = Host).
#verify
pub fn cert_type_code(ct : CertType) -> UInt {
  match ct {
    CertType::User => 1U
    CertType::Host => 2U
  }
}

///| Decode an OpenSSH wire uint32 into a `CertType`.
#verify
pub fn cert_type_from_code(raw : UInt) -> Option[CertType] {
  if raw == 1U {
    Some(CertType::User)
  } else if raw == 2U {
    Some(CertType::Host)
  } else {
    None
  }
}

///| Check OpenSSH certificate validity window `[valid_after, valid_before)` (`UINT64_MAX` = forever):
///| 0 = valid, 1 = not yet valid, 2 = expired.
#verify
pub fn cert_time_valid_code(now_unix : UInt64, valid_after : UInt64, valid_before : UInt64) -> Int {
  if now_unix < valid_after {
    1
  } else if valid_before != 0xFFFFFFFFFFFFFFFFUL && now_unix >= valid_before {
    2
  } else {
    0
  }
}

///|
pub struct CertOption {
  name : String
  value : Bytes
}

///|
pub struct Certificate {
  cert_type_name : String
  nonce : Bytes
  key : PublicKey
  serial : UInt64
  cert_type : CertType
  key_id : String
  valid_principals : Array[String]
  valid_after : UInt64
  valid_before : UInt64
  critical_options : Array[CertOption]
  extensions : Array[CertOption]
  reserved : Bytes
  signature_key : PublicKey
  signature : Signature
}

///| Decode an OpenSSH cert option's inner SSH string value (e.g. `force-command`).
pub fn CertOption::value_string(self : CertOption) -> Result[String, SshError] {
  if self.value.length() == 0 {
    return Ok("")
  }
  let r = SshReader::new(self.value)
  let s = match r.read_string() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match r.expect_eof() {
    Ok(_) => Ok(s)
    Err(e) => Err(e)
  }
}

///|
fn parse_cert_options(blob : Bytes, reject_duplicates : Bool) -> Result[Array[CertOption], SshError] {
  let r = SshReader::new(blob)
  let out : Array[CertOption] = []
  while !r.is_empty() {
    let name = match r.read_string() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if name.length() == 0 {
      return Err(SshError::InvalidCertificate("empty certificate option name"))
    }
    if reject_duplicates {
      let mut j = 0
      while j < out.length() {
        if out[j].name == name {
          return Err(SshError::InvalidCertificate("duplicate critical option: " + name))
        }
        j = j + 1
      }
    }
    let value = match r.read_bytes() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    if value.length() > 0 {
      // PROTOCOL.certkeys: non-empty option data is a single packed SSH string with no trailing bytes.
      let vr = SshReader::new(value)
      match vr.read_bytes() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match vr.expect_eof() {
        Ok(_) => ()
        Err(_) => return Err(SshError::InvalidCertificate("trailing data in certificate option: " + name))
      }
    }
    out.push(CertOption::{ name, value })
  }
  Ok(out)
}

///|
fn encode_cert_options(opts : Array[CertOption]) -> Bytes {
  let w = SshWriter::new()
  let mut i = 0
  while i < opts.length() {
    w.write_string(opts[i].name)
    w.write_bytes(opts[i].value)
    i = i + 1
  }
  w.to_bytes()
}

///|
pub fn Certificate::from_wire(blob : Bytes) -> Result[Certificate, SshError] {
  let r = SshReader::new(blob)
  let cert_type_name = match r.read_string() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let nonce = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let key = if cert_type_name == "ssh-ed25519-cert-v01@openssh.com" {
    match parse_public_key_body("ssh-ed25519", r) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
  } else if cert_type_name == "ecdsa-sha2-nistp256-cert-v01@openssh.com" {
    match parse_public_key_body("ecdsa-sha2-nistp256", r) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
  } else if cert_type_name == "ssh-rsa-cert-v01@openssh.com" {
    match parse_public_key_body("ssh-rsa", r) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
  } else {
    return Err(SshError::UnsupportedAlgorithm(cert_type_name))
  }
  let serial = match r.read_u64() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let ct_raw = match r.read_u32() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let cert_type = match cert_type_from_code(ct_raw) {
    Some(ct) => ct
    None => return Err(SshError::InvalidCertificate("unknown cert type: " + ct_raw.to_string()))
  }
  let key_id = match r.read_string() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let principals_blob = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let pr = SshReader::new(principals_blob)
  let valid_principals : Array[String] = []
  while !pr.is_empty() {
    let p = match pr.read_string() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    valid_principals.push(p)
  }
  let valid_after = match r.read_u64() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let valid_before = match r.read_u64() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let crit_blob = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let critical_options = match parse_cert_options(crit_blob, false) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let ext_blob = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let extensions = match parse_cert_options(ext_blob, false) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let reserved = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let sig_key_blob = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let signature_key = match parse_public_key_wire(sig_key_blob) {
    Ok(k) => k
    Err(e) => return Err(e)
  }
  let sig_blob = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let signature = match Signature::from_wire(sig_blob) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  match r.expect_eof() {
    Ok(_) => {
      Ok(Certificate::{
        cert_type_name,
        nonce,
        key,
        serial,
        cert_type,
        key_id,
        valid_principals,
        valid_after,
        valid_before,
        critical_options,
        extensions,
        reserved,
        signature_key,
        signature,
      })
    }
    Err(e) => Err(e)
  }
}

///|
pub fn Certificate::tbs_bytes(self : Certificate) -> Bytes {
  let w = SshWriter::new()
  w.write_string(self.cert_type_name)
  w.write_bytes(self.nonce)
  match self.key {
    PublicKey::Ed25519(raw) => w.write_bytes(raw)
    PublicKey::EcdsaP256(point) => {
      w.write_string("nistp256")
      w.write_bytes(point)
    }
    PublicKey::Rsa(e, n) => {
      w.write_mpint_unsigned(e)
      w.write_mpint_unsigned(n)
    }
  }
  w.write_u64(self.serial)
  w.write_u32(match self.cert_type {
    CertType::User => 1U
    CertType::Host => 2U
  })
  w.write_string(self.key_id)
  let pw = SshWriter::new()
  let mut i = 0
  while i < self.valid_principals.length() {
    pw.write_string(self.valid_principals[i])
    i = i + 1
  }
  w.write_bytes(pw.to_bytes())
  w.write_u64(self.valid_after)
  w.write_u64(self.valid_before)
  w.write_bytes(encode_cert_options(self.critical_options))
  w.write_bytes(encode_cert_options(self.extensions))
  w.write_bytes(self.reserved)
  w.write_bytes(public_key_to_wire(self.signature_key))
  w.to_bytes()
}

///|
pub fn Certificate::to_wire(self : Certificate) -> Bytes {
  let w = SshWriter::new()
  w.write_raw(self.tbs_bytes())
  w.write_bytes(self.signature.to_wire())
  w.to_bytes()
}

///|
pub fn Certificate::from_openssh(line : String) -> Result[(Certificate, String), SshError] {
  let trimmed = trim_ascii(line)
  if trimmed.length() == 0 {
    return Err(SshError::InvalidCertificate("empty certificate line"))
  }
  let (alg, rest1) = split_first_field(trimmed)
  if rest1.length() == 0 {
    return Err(SshError::InvalidCertificate("missing base64 certificate blob"))
  }
  let (b64, comment) = split_first_field(rest1)
  let blob = match base64::decode(b64) {
    Ok(d) => d
    Err(e) => return Err(SshError::InvalidBase64(base64::error_message(e)))
  }
  let cert = match Certificate::from_wire(blob) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  if cert.cert_type_name != alg {
    return Err(SshError::InvalidCertificate("certificate type prefix mismatch"))
  }
  Ok((cert, comment))
}

///|
pub fn Certificate::to_openssh(self : Certificate, comment : String) -> String {
  let head = self.cert_type_name + " " + base64::encode(self.to_wire())
  let clean_comment = sanitize_openssh_comment(comment)
  if clean_comment.length() == 0 {
    head
  } else {
    head + " " + clean_comment
  }
}

///|
pub fn Certificate::verify_signature(self : Certificate) -> Result[Unit, SshError] {
  public_key_verify(self.signature_key, self.tbs_bytes(), self.signature)
}

///|
fn cert_type_eq(a : CertType, b : CertType) -> Bool {
  match (a, b) {
    (CertType::User, CertType::User) => true
    (CertType::Host, CertType::Host) => true
    _ => false
  }
}

///| Verification options for `Certificate::verify_with_options`.
pub struct CertVerifyOptions {
  client_ip : Option[String]
  supported_critical_options : Array[String]
  require_principal : Bool
}

///| Default strict verification options (PROTOCOL.certkeys / OpenSSH sshd semantics):
///| - Recognizes `force-command` as a supported critical option;
///| - Rejects `source-address` unless `client_ip` is provided and matches;
///| - Rejects any other critical option (including `verify-required`) unless caller explicitly enables it;
///| - Requires non-empty `valid_principals` for User certificates.
pub fn CertVerifyOptions::default() -> CertVerifyOptions {
  CertVerifyOptions::{
    client_ip: None,
    supported_critical_options: ["force-command"],
    require_principal: true,
  }
}

///| Convenience constructor enabling `source-address` enforcement for a known client IPv4/IPv6 address.
pub fn CertVerifyOptions::with_client_ip(client_ip : String) -> CertVerifyOptions {
  CertVerifyOptions::{
    client_ip: Some(client_ip),
    supported_critical_options: ["force-command"],
    require_principal: true,
  }
}

///|
fn array_contains_string(xs : Array[String], target : String) -> Bool {
  let mut i = 0
  while i < xs.length() {
    if xs[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

///|
pub fn Certificate::verify_with_options(
  self : Certificate,
  ca_key : PublicKey,
  expected_type : CertType,
  principal : String,
  now_unix : UInt64,
  opts : CertVerifyOptions,
) -> Result[Unit, SshError] {
  if !cert_type_eq(self.cert_type, expected_type) {
    return Err(SshError::CertTypeMismatch)
  }
  if !ssh_bytes_eq(public_key_to_wire(self.signature_key), public_key_to_wire(ca_key)) {
    return Err(SshError::SignatureVerificationFailed)
  }
  let time_err = cert_time_valid_code(now_unix, self.valid_after, self.valid_before)
  if time_err == 1 {
    return Err(SshError::CertificateNotYetValid)
  }
  if time_err == 2 {
    return Err(SshError::CertificateExpired)
  }
  // Validate critical_options (PROTOCOL.certkeys): reject duplicates, unknown options, malformed values,
  // and enforce source-address CIDR restrictions.
  let mut ci = 0
  while ci < self.critical_options.length() {
    let opt = self.critical_options[ci]
    if opt.name.length() == 0 {
      return Err(SshError::InvalidCertificate("empty critical option name"))
    }
    let mut cj = 0
    while cj < ci {
      if self.critical_options[cj].name == opt.name {
        return Err(SshError::InvalidCertificate("duplicate critical option: " + opt.name))
      }
      cj = cj + 1
    }
    if opt.name == "source-address" {
      if opt.value.length() == 0 {
        return Err(SshError::InvalidCertificate("empty source-address critical option"))
      }
      let csv = match opt.value_string() {
        Ok(s) => s
        Err(_) => return Err(SshError::InvalidCertificate("malformed source-address option value"))
      }
      let cidrs = match parse_source_address_list(csv) {
        Ok(xs) => xs
        Err(e) => return Err(e)
      }
      match opts.client_ip {
        Some(ip_str) => match parse_ip_addr(ip_str) {
          Some(ip) => {
            if !ip_matches_cidrs(ip, cidrs) {
              return Err(SshError::InvalidCertificate("client IP not permitted by source-address"))
            }
          }
          None => return Err(SshError::InvalidCertificate("invalid client IP address: " + ip_str))
        }
        None => return Err(SshError::InvalidCertificate("certificate requires source-address verification"))
      }
    } else if opt.name == "force-command" {
      if !array_contains_string(opts.supported_critical_options, "force-command") {
        return Err(SshError::InvalidCertificate("unsupported critical option: force-command"))
      }
      if opt.value.length() == 0 {
        return Err(SshError::InvalidCertificate("empty force-command critical option"))
      }
      match opt.value_string() {
        Ok(_) => ()
        Err(_) => return Err(SshError::InvalidCertificate("malformed force-command option value"))
      }
    } else if opt.name == "verify-required" {
      if !array_contains_string(opts.supported_critical_options, "verify-required") {
        return Err(SshError::InvalidCertificate("unsupported critical option: verify-required"))
      }
      if opt.value.length() != 0 {
        return Err(SshError::InvalidCertificate("verify-required must have empty value"))
      }
    } else {
      if !array_contains_string(opts.supported_critical_options, opt.name) {
        return Err(SshError::InvalidCertificate("unsupported critical option: " + opt.name))
      }
    }
    ci = ci + 1
  }
  if self.valid_principals.length() == 0 {
    if cert_type_eq(self.cert_type, CertType::User) && opts.require_principal {
      return Err(SshError::PrincipalMismatch)
    }
  } else {
    let mut matched = false
    let mut i = 0
    while i < self.valid_principals.length() {
      let pat = self.valid_principals[i]
      let ok = match self.cert_type {
        CertType::Host => match_host_pattern(pat, principal)
        CertType::User => pat == principal
      }
      if ok {
        matched = true
        break
      }
      i = i + 1
    }
    if !matched {
      return Err(SshError::PrincipalMismatch)
    }
  }
  public_key_verify(ca_key, self.tbs_bytes(), self.signature)
}

///|
pub fn Certificate::verify(
  self : Certificate,
  ca_key : PublicKey,
  expected_type : CertType,
  principal : String,
  now_unix : UInt64,
) -> Result[Unit, SshError] {
  self.verify_with_options(ca_key, expected_type, principal, now_unix, CertVerifyOptions::default())
}

///|
pub fn Certificate::sign(self : Certificate, ca_key : PrivateKey) -> Result[Certificate, SshError] {
  let ca_pk = private_key_public_key(ca_key)
  let unsigned = Certificate::{
    cert_type_name: self.cert_type_name,
    nonce: self.nonce,
    key: self.key,
    serial: self.serial,
    cert_type: self.cert_type,
    key_id: self.key_id,
    valid_principals: self.valid_principals,
    valid_after: self.valid_after,
    valid_before: self.valid_before,
    critical_options: self.critical_options,
    extensions: self.extensions,
    reserved: self.reserved,
    signature_key: ca_pk,
    signature: Signature::{ algorithm: "", blob: Bytes::new(0) },
  }
  let sig = match private_key_sign(ca_key, unsigned.tbs_bytes()) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  Ok(Certificate::{
    cert_type_name: unsigned.cert_type_name,
    nonce: unsigned.nonce,
    key: unsigned.key,
    serial: unsigned.serial,
    cert_type: unsigned.cert_type,
    key_id: unsigned.key_id,
    valid_principals: unsigned.valid_principals,
    valid_after: unsigned.valid_after,
    valid_before: unsigned.valid_before,
    critical_options: unsigned.critical_options,
    extensions: unsigned.extensions,
    reserved: unsigned.reserved,
    signature_key: ca_pk,
    signature: sig,
  })
}
