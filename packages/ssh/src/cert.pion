///| OpenSSH Certificates (`*-cert-v01@openssh.com`).
///| Stub implementation for Red phase.

///|
pub enum CertType {
  User
  Host
}

///|
pub struct CertOption {
  name : String
  value : Bytes
}

///|
pub struct Certificate {
  cert_type_name : String
  nonce : Bytes
  key : PublicKey
  serial : UInt64
  cert_type : CertType
  key_id : String
  valid_principals : Array[String]
  valid_after : UInt64
  valid_before : UInt64
  critical_options : Array[CertOption]
  extensions : Array[CertOption]
  reserved : Bytes
  signature_key : PublicKey
  signature : Signature
}

