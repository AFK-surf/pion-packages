///| IPv4 / IPv6 address and CIDR list parsing & matching for OpenSSH `source-address` critical option.
///| Zero `World` dependencies, no panics.

///|
enum IpAddr {
  V4(Bytes)
  V6(Bytes)
}

///|
struct IpCidr {
  addr : IpAddr
  prefix_len : Int
}

///| Parse a strict dotted-decimal IPv4 address into 4 bytes.
fn parse_ipv4(s : String) -> Option[Bytes] {
  let b = s.to_bytes()
  let n = b.length()
  if n < 7 || n > 15 {
    return None
  }
  let mut out = Bytes::new(4)
  let mut octet = 0
  let mut i = 0
  while octet < 4 {
    if i >= n {
      return None
    }
    let start = i
    let mut acc = 0
    while i < n {
      let c = b[i].to_int() & 0xFF
      if c >= 48 && c <= 57 {
        acc = acc * 10 + (c - 48)
        if acc > 255 {
          return None
        }
        i = i + 1
      } else {
        break
      }
    }
    let digits = i - start
    if digits == 0 || (digits > 1 && (b[start].to_int() & 0xFF) == 48) {
      return None
    }
    out[octet] = acc.to_byte()
    if octet < 3 {
      if i >= n || (b[i].to_int() & 0xFF) != 46 {
        return None
      }
      i = i + 1
    }
    octet = octet + 1
  }
  if i != n {
    return None
  }
  Some(out)
}

///| Parse a single 1..4 hex-digit IPv6 group.
fn parse_hex_u16(b : Bytes, start : Int, end : Int) -> Option[Int] {
  let len = end - start
  if len < 1 || len > 4 {
    return None
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let c = b[i].to_int() & 0xFF
    let d = if c >= 48 && c <= 57 {
      c - 48
    } else if c >= 97 && c <= 102 {
      c - 87
    } else if c >= 65 && c <= 70 {
      c - 55
    } else {
      return None
    }
    acc = (acc << 4) | d
    i = i + 1
  }
  Some(acc)
}

///| Parse a standard IPv6 address (with optional `::` compression and embedded IPv4 tail) into 16 bytes.
fn parse_ipv6(s : String) -> Option[Bytes] {
  let b = s.to_bytes()
  let n = b.length()
  if n < 2 || n > 45 {
    return None
  }
  let left : Array[Int] = []
  let right : Array[Int] = []
  let mut seen_dcolon = false
  let mut i = 0
  if (b[0].to_int() & 0xFF) == 58 {
    if n < 2 || (b[1].to_int() & 0xFF) != 58 {
      return None
    }
    seen_dcolon = true
    i = 2
    if i == n {
      return Some(Bytes::new(16))
    }
  }
  while i < n {
    let seg_start = i
    let mut has_dot = false
    while i < n && (b[i].to_int() & 0xFF) != 58 {
      if (b[i].to_int() & 0xFF) == 46 {
        has_dot = true
      }
      i = i + 1
    }
    if has_dot {
      // Must be the final embedded IPv4 suffix
      if i != n {
        return None
      }
      match parse_ipv4(b.slice(seg_start, n).to_string()) {
        Some(v4) => {
          let g0 = ((v4[0].to_int() & 0xFF) << 8) | (v4[1].to_int() & 0xFF)
          let g1 = ((v4[2].to_int() & 0xFF) << 8) | (v4[3].to_int() & 0xFF)
          if seen_dcolon {
            right.push(g0)
            right.push(g1)
          } else {
            left.push(g0)
            left.push(g1)
          }
          break
        }
        None => return None
      }
    }
    match parse_hex_u16(b, seg_start, i) {
      Some(g) => {
        if seen_dcolon {
          right.push(g)
        } else {
          left.push(g)
        }
      }
      None => return None
    }
    if i == n {
      break
    }
    // b[i] == ':'
    i = i + 1
    if i == n {
      return None
    }
    if (b[i].to_int() & 0xFF) == 58 {
      if seen_dcolon {
        return None
      }
      seen_dcolon = true
      i = i + 1
      if i == n {
        break
      }
    }
  }
  let total = left.length() + right.length()
  if seen_dcolon {
    if total >= 8 {
      return None
    }
  } else if total != 8 {
    return None
  }
  let zeros = 8 - total
  let mut out = Bytes::new(16)
  let mut gi = 0
  let mut j = 0
  while j < left.length() {
    out[2 * gi] = ((left[j] >> 8) & 0xFF).to_byte()
    out[2 * gi + 1] = (left[j] & 0xFF).to_byte()
    gi = gi + 1
    j = j + 1
  }
  gi = gi + zeros
  j = 0
  while j < right.length() {
    out[2 * gi] = ((right[j] >> 8) & 0xFF).to_byte()
    out[2 * gi + 1] = (right[j] & 0xFF).to_byte()
    gi = gi + 1
    j = j + 1
  }
  Some(out)
}

///| Parse an IPv4 or IPv6 address (also stripping optional `[...]` brackets).
fn parse_ip_addr(s : String) -> Option[IpAddr] {
  let b = s.to_bytes()
  let n = b.length()
  let clean = if n >= 2 && (b[0].to_int() & 0xFF) == 91 && (b[n - 1].to_int() & 0xFF) == 93 {
    b.slice(1, n - 1).to_string()
  } else {
    s
  }
  match parse_ipv4(clean) {
    Some(v4) => Some(IpAddr::V4(v4))
    None => match parse_ipv6(clean) {
      Some(v6) => Some(IpAddr::V6(v6))
      None => None
    }
  }
}

///| Parse a non-negative decimal prefix length `0..max_bits`.
fn parse_prefix_len(s : String, max_bits : Int) -> Option[Int] {
  let b = s.to_bytes()
  let n = b.length()
  if n == 0 || n > 3 {
    return None
  }
  if n > 1 && (b[0].to_int() & 0xFF) == 48 {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if c < 48 || c > 57 {
      return None
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  if acc < 0 || acc > max_bits {
    return None
  }
  Some(acc)
}

///| Parse a single CIDR entry (`ip/prefix` or bare `ip`).
fn parse_cidr_entry(entry : String) -> Option[IpCidr] {
  let b = entry.to_bytes()
  let n = b.length()
  if n == 0 {
    return None
  }
  let mut slash = -1
  let mut i = 0
  while i < n {
    if (b[i].to_int() & 0xFF) == 47 {
      if slash >= 0 {
        return None
      }
      slash = i
    }
    i = i + 1
  }
  if slash < 0 {
    match parse_ip_addr(entry) {
      Some(IpAddr::V4(v4)) => Some(IpCidr::{ addr: IpAddr::V4(v4), prefix_len: 32 })
      Some(IpAddr::V6(v6)) => Some(IpCidr::{ addr: IpAddr::V6(v6), prefix_len: 128 })
      None => None
    }
  } else {
    let ip_part = b.slice(0, slash).to_string()
    let mask_part = b.slice(slash + 1, n).to_string()
    match parse_ip_addr(ip_part) {
      Some(IpAddr::V4(v4)) => match parse_prefix_len(mask_part, 32) {
        Some(plen) => Some(IpCidr::{ addr: IpAddr::V4(v4), prefix_len: plen })
        None => None
      }
      Some(IpAddr::V6(v6)) => match parse_prefix_len(mask_part, 128) {
        Some(plen) => Some(IpCidr::{ addr: IpAddr::V6(v6), prefix_len: plen })
        None => None
      }
      None => None
    }
  }
}

///| Parse a comma-separated OpenSSH `source-address` CIDR list (non-empty, no empty elements).
fn parse_source_address_list(csv : String) -> Result[Array[IpCidr], SshError] {
  let b = csv.to_bytes()
  let n = b.length()
  if n == 0 {
    return Err(SshError::InvalidCertificate("empty source-address option"))
  }
  let out : Array[IpCidr] = []
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || (b[i].to_int() & 0xFF) == 44 {
      if i == start {
        return Err(SshError::InvalidCertificate("empty entry in source-address list"))
      }
      let item = b.slice(start, i).to_string()
      match parse_cidr_entry(item) {
        Some(cidr) => out.push(cidr)
        None => return Err(SshError::InvalidCertificate("invalid source-address CIDR: " + item))
      }
      start = i + 1
    }
    i = i + 1
  }
  Ok(out)
}

///| Compute the 8-bit CIDR prefix mask for `rem_bits` in `1..7` (top `rem_bits` bits set).
#verify
pub fn cidr_rem_mask(rem_bits : Int) -> Int {
  (0xFF << (8 - rem_bits)) & 0xFF
}

///| Check whether two bytes match on their top `rem_bits` bits (`1..7`).
pub fn cidr_byte_match(ip_byte : Int, net_byte : Int, rem_bits : Int) -> Bool {
  let mask = cidr_rem_mask(rem_bits)
  ((ip_byte & 0xFF) & mask) == ((net_byte & 0xFF) & mask)
}

///| Check whether `ip_bytes` matches `net_bytes` on the top `prefix_len` bits.
fn bytes_match_prefix(ip_bytes : Bytes, net_bytes : Bytes, prefix_len : Int) -> Bool {
  let full_bytes = prefix_len / 8
  let rem_bits = prefix_len % 8
  let mut i = 0
  while i < full_bytes {
    if ip_bytes[i] != net_bytes[i] {
      return false
    }
    i = i + 1
  }
  if rem_bits > 0 {
    if !cidr_byte_match(ip_bytes[full_bytes].to_int(), net_bytes[full_bytes].to_int(), rem_bits) {
      return false
    }
  }
  true
}

///| Check whether `ip` matches any CIDR in `cidrs`.
fn ip_matches_cidrs(ip : IpAddr, cidrs : Array[IpCidr]) -> Bool {
  let mut i = 0
  while i < cidrs.length() {
    let c = cidrs[i]
    let matched = match (ip, c.addr) {
      (IpAddr::V4(a), IpAddr::V4(b)) => bytes_match_prefix(a, b, c.prefix_len)
      (IpAddr::V6(a), IpAddr::V6(b)) => bytes_match_prefix(a, b, c.prefix_len)
      _ => false
    }
    if matched {
      return true
    }
    i = i + 1
  }
  false
}
