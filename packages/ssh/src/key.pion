///| SSH public keys, fingerprints, signatures, and OpenSSH private keys (`openssh-key-v1`).
///| Cryptographic operations delegate to `packages/crypto` v0.2.0 and `packages/base64`.

import "base64"
import "crypto"

///|
pub enum PublicKey {
  Ed25519(Bytes)
  EcdsaP256(Bytes)
  Rsa(Bytes, Bytes)
}

///|
pub struct Signature {
  algorithm : String
  blob : Bytes
}

///|
pub enum PrivateKey {
  Ed25519(Bytes, Bytes)
  EcdsaP256(Bytes, Bytes)
  Rsa(Bytes, Bytes, Bytes, Bytes, Bytes, Bytes)
}

///|
pub struct OpenSshKeyFile {
  cipher : String
  kdf : String
  kdf_options : Bytes
  public_key : PublicKey
  private_key : PrivateKey
  comment : String
}

///|
pub struct EncryptedKeyInfo {
  cipher : String
  kdf : String
  kdf_options : Bytes
  public_key : PublicKey
}

///|
pub fn public_key_algorithm(pk : PublicKey) -> String {
  match pk {
    PublicKey::Ed25519(_) => "ssh-ed25519"
    PublicKey::EcdsaP256(_) => "ecdsa-sha2-nistp256"
    PublicKey::Rsa(_, _) => "ssh-rsa"
  }
}

///|
pub fn public_key_to_wire(pk : PublicKey) -> Bytes {
  let w = SshWriter::new()
  match pk {
    PublicKey::Ed25519(raw) => {
      w.write_string("ssh-ed25519")
      w.write_bytes(raw)
    }
    PublicKey::EcdsaP256(point) => {
      w.write_string("ecdsa-sha2-nistp256")
      w.write_string("nistp256")
      w.write_bytes(point)
    }
    PublicKey::Rsa(e, n) => {
      w.write_string("ssh-rsa")
      w.write_mpint_unsigned(e)
      w.write_mpint_unsigned(n)
    }
  }
  w.to_bytes()
}

///|
fn parse_public_key_body(alg : String, r : SshReader) -> Result[PublicKey, SshError] {
  if alg == "ssh-ed25519" {
    let raw = match r.read_bytes() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    if raw.length() != 32 {
      return Err(SshError::InvalidKey("ed25519 public key must be 32 bytes"))
    }
    Ok(PublicKey::Ed25519(raw))
  } else if alg == "ecdsa-sha2-nistp256" {
    let curve = match r.read_string() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if curve != "nistp256" {
      return Err(SshError::InvalidKey("expected curve nistp256, got: " + curve))
    }
    let pt = match r.read_bytes() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    if !p256_point_is_valid(pt) {
      return Err(SshError::InvalidKey("invalid P-256 curve point"))
    }
    Ok(PublicKey::EcdsaP256(pt))
  } else if alg == "ssh-rsa" {
    let e = match r.read_mpint_unsigned() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    let n = match r.read_mpint_unsigned() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    if !rsa_public_key_params_valid(e, n) {
      return Err(SshError::InvalidKey("invalid RSA public key parameters"))
    }
    Ok(PublicKey::Rsa(e, n))
  } else {
    Err(SshError::UnsupportedAlgorithm(alg))
  }
}

///|
pub fn parse_public_key_wire(blob : Bytes) -> Result[PublicKey, SshError] {
  let r = SshReader::new(blob)
  let alg = match r.read_string() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let pk = match parse_public_key_body(alg, r) {
    Ok(k) => k
    Err(e) => return Err(e)
  }
  match r.expect_eof() {
    Ok(_) => Ok(pk)
    Err(e) => Err(e)
  }
}

///|
pub fn public_key_fingerprint_sha256(pk : PublicKey) -> String {
  let digest = crypto::sha256(public_key_to_wire(pk))
  "SHA256:" + base64::encode_no_pad(digest)
}

///|
pub fn public_key_fingerprint_eq(pk : PublicKey, expected : String) -> Bool {
  let actual = public_key_fingerprint_sha256(pk)
  crypto::constant_time_eq(actual.to_bytes(), expected.to_bytes())
}

///| Replace CR, LF, and NUL bytes so single-line OpenSSH formats cannot be split into extra lines.
fn sanitize_openssh_comment(s : String) -> String {
  let b = s.to_bytes()
  let n = b.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if c == 10 || c == 13 || c == 0 {
      sb.write_char(' ')
      i = i + 1
    } else {
      let seg = i
      while i < n {
        let ch = b[i].to_int() & 0xFF
        if ch == 10 || ch == 13 || ch == 0 {
          break
        }
        i = i + 1
      }
      sb.write_string(b.slice(seg, i).to_string())
    }
  }
  sb.to_string()
}

///|
pub fn public_key_to_openssh(pk : PublicKey, comment : String) -> String {
  let head = public_key_algorithm(pk) + " " + base64::encode(public_key_to_wire(pk))
  let clean_comment = sanitize_openssh_comment(comment)
  if clean_comment.length() == 0 {
    head
  } else {
    head + " " + clean_comment
  }
}

///| Trim ASCII whitespace (space, tab, CR, LF) from both ends of `s`.
fn trim_ascii(s : String) -> String {
  let b = s.to_bytes()
  let n = b.length()
  let mut start = 0
  while start < n {
    let c = b[start].to_int() & 0xFF
    if c == 32 || c == 9 || c == 13 || c == 10 {
      start = start + 1
    } else {
      break
    }
  }
  let mut end = n
  while end > start {
    let c = b[end - 1].to_int() & 0xFF
    if c == 32 || c == 9 || c == 13 || c == 10 {
      end = end - 1
    } else {
      break
    }
  }
  b.slice(start, end).to_string()
}

///| Split `s` into `(first_token, rest_after_ws)` on ASCII space/tab.
fn split_first_field(s : String) -> (String, String) {
  let b = s.to_bytes()
  let n = b.length()
  let mut i = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if c == 32 || c == 9 {
      break
    }
    i = i + 1
  }
  let first = b.slice(0, i).to_string()
  let mut j = i
  while j < n {
    let c = b[j].to_int() & 0xFF
    if c == 32 || c == 9 {
      j = j + 1
    } else {
      break
    }
  }
  let rest = b.slice(j, n).to_string()
  (first, rest)
}

///|
pub fn parse_public_key_openssh(line : String) -> Result[(PublicKey, String), SshError] {
  let trimmed = trim_ascii(line)
  if trimmed.length() == 0 {
    return Err(SshError::InvalidKey("empty public key line"))
  }
  let (alg, rest1) = split_first_field(trimmed)
  if rest1.length() == 0 {
    return Err(SshError::InvalidKey("missing base64 key blob"))
  }
  let (b64, comment) = split_first_field(rest1)
  let blob = match base64::decode(b64) {
    Ok(d) => d
    Err(e) => return Err(SshError::InvalidBase64(base64::error_message(e)))
  }
  let pk = match parse_public_key_wire(blob) {
    Ok(k) => k
    Err(e) => return Err(e)
  }
  if public_key_algorithm(pk) != alg {
    return Err(SshError::InvalidKey("key type prefix mismatch"))
  }
  Ok((pk, comment))
}

///| Left-pad big-endian unsigned integer bytes to exact `target_len`.
fn left_pad_be(src : Bytes, target_len : Int) -> Result[Bytes, SshError] {
  let n = src.length()
  if n > target_len {
    return Err(SshError::InvalidSignature("integer exceeds target length"))
  }
  let mut out = Bytes::new(target_len)
  let offset = target_len - n
  let mut i = 0
  while i < n {
    out[offset + i] = src[i]
    i = i + 1
  }
  Ok(out)
}

///|
pub fn public_key_verify(
  pk : PublicKey,
  data : Bytes,
  sig : Signature,
) -> Result[Unit, SshError] {
  match pk {
    PublicKey::Ed25519(raw_pk) => {
      if sig.algorithm != "ssh-ed25519" {
        return Err(SshError::InvalidSignature("expected ssh-ed25519 signature"))
      }
      if sig.blob.length() != 64 {
        return Err(SshError::InvalidSignature("ed25519 signature must be 64 bytes"))
      }
      match crypto::ed25519_verify_strict(raw_pk, data, sig.blob) {
        Ok(_) => Ok(())
        Err(_) => Err(SshError::SignatureVerificationFailed)
      }
    }
    PublicKey::EcdsaP256(point) => {
      if sig.algorithm != "ecdsa-sha2-nistp256" {
        return Err(SshError::InvalidSignature("expected ecdsa-sha2-nistp256 signature"))
      }
      let sr = SshReader::new(sig.blob)
      let r_bytes = match sr.read_mpint_unsigned() {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      let s_bytes = match sr.read_mpint_unsigned() {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      match sr.expect_eof() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let r32 = match left_pad_be(r_bytes, 32) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      let s32 = match left_pad_be(s_bytes, 32) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      let mut rs = Bytes::new(64)
      let mut i = 0
      while i < 32 {
        rs[i] = r32[i]
        rs[32 + i] = s32[i]
        i = i + 1
      }
      match crypto::p256_verify_es256(point, data, rs) {
        Ok(_) => Ok(())
        Err(_) => Err(SshError::SignatureVerificationFailed)
      }
    }
    PublicKey::Rsa(e, n) => {
      if sig.algorithm == "rsa-sha2-256" {
        let rsa_pk = match crypto::RsaPublicKey::from_components(n, e) {
          Ok(k) => k
          Err(_) => return Err(SshError::InvalidKey("invalid RSA public key components"))
        }
        let sig_padded = match left_pad_be(sig.blob, rsa_pk.size) {
          Ok(b) => b
          Err(_) => return Err(SshError::SignatureVerificationFailed)
        }
        match crypto::rsa_verify_rs256(rsa_pk, data, sig_padded) {
          Ok(_) => Ok(())
          Err(_) => Err(SshError::SignatureVerificationFailed)
        }
      } else if sig.algorithm == "rsa-sha2-512" {
        rsa_verify_rs512(n, e, data, sig.blob)
      } else {
        Err(SshError::UnsupportedAlgorithm(sig.algorithm))
      }
    }
  }
}

///|
pub fn Signature::to_wire(self : Signature) -> Bytes {
  let w = SshWriter::new()
  w.write_string(self.algorithm)
  w.write_bytes(self.blob)
  w.to_bytes()
}

///|
pub fn Signature::from_wire(blob : Bytes) -> Result[Signature, SshError] {
  let r = SshReader::new(blob)
  let alg = match r.read_string() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let sig_blob = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  match r.expect_eof() {
    Ok(_) => Ok(Signature::{ algorithm: alg, blob: sig_blob })
    Err(e) => Err(e)
  }
}

///|
pub fn private_key_public_key(sk : PrivateKey) -> PublicKey {
  match sk {
    PrivateKey::Ed25519(_, pk) => PublicKey::Ed25519(pk)
    PrivateKey::EcdsaP256(_, pk) => PublicKey::EcdsaP256(pk)
    PrivateKey::Rsa(n, e, _, _, _, _) => PublicKey::Rsa(e, n)
  }
}

///|
pub fn private_key_sign(sk : PrivateKey, data : Bytes) -> Result[Signature, SshError] {
  match sk {
    PrivateKey::Ed25519(seed, _) => {
      let raw_sig = match crypto::ed25519_sign(seed, data) {
        Ok(s) => s
        Err(_) => return Err(SshError::InvalidKey("ed25519 sign failed"))
      }
      Ok(Signature::{ algorithm: "ssh-ed25519", blob: raw_sig })
    }
    PrivateKey::EcdsaP256(scalar, _) => {
      let rs = match crypto::p256_sign_es256(scalar, data) {
        Ok(s) => s
        Err(_) => return Err(SshError::InvalidKey("p256 sign failed"))
      }
      let w = SshWriter::new()
      w.write_mpint_unsigned(rs.slice(0, 32))
      w.write_mpint_unsigned(rs.slice(32, 64))
      Ok(Signature::{ algorithm: "ecdsa-sha2-nistp256", blob: w.to_bytes() })
    }
    PrivateKey::Rsa(_, _, _, _, _, _) => {
      Err(SshError::UnsupportedAlgorithm("ssh-rsa signing not implemented"))
    }
  }
}

///| Decode PEM-like armor block with exact begin/end markers.
fn decode_armor(armored : String, begin_marker : String, end_marker : String) -> Result[Bytes, SshError] {
  let b = armored.to_bytes()
  let n = b.length()
  let lines : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || (b[i].to_int() & 0xFF) == 10 {
      let mut end = i
      if end > start && (b[end - 1].to_int() & 0xFF) == 13 {
        end = end - 1
      }
      lines.push(b.slice(start, end).to_string())
      start = i + 1
    }
    i = i + 1
  }
  let mut idx = 0
  while idx < lines.length() && trim_ascii(lines[idx]).length() == 0 {
    idx = idx + 1
  }
  if idx >= lines.length() || trim_ascii(lines[idx]) != begin_marker {
    return Err(SshError::InvalidArmor("missing begin marker: " + begin_marker))
  }
  idx = idx + 1
  let sb = StringBuilder::new()
  let mut found_end = false
  while idx < lines.length() {
    let line = trim_ascii(lines[idx])
    if line == end_marker {
      found_end = true
      break
    }
    if line.length() > 0 {
      sb.write_string(line)
    }
    idx = idx + 1
  }
  if !found_end {
    return Err(SshError::InvalidArmor("missing end marker: " + end_marker))
  }
  match base64::decode(sb.to_string()) {
    Ok(raw) => Ok(raw)
    Err(e) => Err(SshError::InvalidBase64(base64::error_message(e)))
  }
}

///| Encode bytes into 70-character line-wrapped OpenSSH armor.
fn encode_armor(data : Bytes, begin_marker : String, end_marker : String) -> String {
  let b64 = base64::encode(data)
  let raw = b64.to_bytes()
  let n = raw.length()
  let sb = StringBuilder::new()
  sb.write_string(begin_marker)
  sb.write_char('\n')
  let mut i = 0
  while i < n {
    let end = if i + 70 < n { i + 70 } else { n }
    sb.write_string(raw.slice(i, end).to_string())
    sb.write_char('\n')
    i = end
  }
  sb.write_string(end_marker)
  sb.write_char('\n')
  sb.to_string()
}

///|
fn parse_openssh_outer(
  pem : String,
) -> Result[(String, String, Bytes, PublicKey, Bytes), SshError] {
  let blob = match decode_armor(
    pem,
    "-----BEGIN OPENSSH PRIVATE KEY-----",
    "-----END OPENSSH PRIVATE KEY-----",
  ) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let r = SshReader::new(blob)
  let magic = match r.read_exact(15) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  if !ssh_bytes_eq(magic, "openssh-key-v1\u{00}".to_bytes()) {
    return Err(SshError::InvalidKey("invalid openssh-key-v1 magic"))
  }
  let cipher = match r.read_string() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let kdf = match r.read_string() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let kdf_options = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let num_keys = match r.read_u32() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if num_keys != 1U {
    return Err(SshError::InvalidKey("expected exactly 1 key in openssh-key-v1"))
  }
  let pub_blob = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let public_key = match parse_public_key_wire(pub_blob) {
    Ok(k) => k
    Err(e) => return Err(e)
  }
  let priv_blob = match r.read_bytes() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  match r.expect_eof() {
    Ok(_) => Ok((cipher, kdf, kdf_options, public_key, priv_blob))
    Err(e) => Err(e)
  }
}

///|
pub fn parse_openssh_private_key_header(pem : String) -> Result[EncryptedKeyInfo, SshError] {
  match parse_openssh_outer(pem) {
    Ok((cipher, kdf, kdf_options, public_key, _)) => {
      Ok(EncryptedKeyInfo::{ cipher, kdf, kdf_options, public_key })
    }
    Err(e) => Err(e)
  }
}

///|
pub fn parse_openssh_private_key(pem : String) -> Result[OpenSshKeyFile, SshError] {
  let (cipher, kdf, kdf_options, header_pk, priv_blob) = match parse_openssh_outer(pem) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if cipher != "none" || kdf != "none" {
    return Err(SshError::EncryptedKeyUnsupported(cipher))
  }
  if priv_blob.length() % 8 != 0 {
    return Err(SshError::InvalidPadding)
  }
  let r = SshReader::new(priv_blob)
  let check1 = match r.read_u32() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let check2 = match r.read_u32() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if check1 != check2 {
    return Err(SshError::CheckintMismatch)
  }
  let key_type = match r.read_string() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let priv_key = if key_type == "ssh-ed25519" {
    let pk32 = match r.read_bytes() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    let sk64 = match r.read_bytes() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    if pk32.length() != 32 || sk64.length() != 64 {
      return Err(SshError::InvalidKey("invalid ed25519 private key lengths"))
    }
    let seed = sk64.slice(0, 32)
    let sk_pub = sk64.slice(32, 64)
    if !ssh_bytes_eq(pk32, sk_pub) {
      return Err(SshError::InvalidKey("ed25519 public/private key mismatch"))
    }
    let derived = match crypto::ed25519_public_key(seed) {
      Ok(d) => d
      Err(_) => return Err(SshError::InvalidKey("ed25519 seed derivation failed"))
    }
    if !ssh_bytes_eq(derived, pk32) {
      return Err(SshError::InvalidKey("ed25519 derived public key mismatch"))
    }
    PrivateKey::Ed25519(seed, pk32)
  } else if key_type == "ecdsa-sha2-nistp256" {
    let curve = match r.read_string() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if curve != "nistp256" {
      return Err(SshError::InvalidKey("expected nistp256 curve"))
    }
    let q = match r.read_bytes() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    let d_raw = match r.read_mpint_unsigned() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    let d32 = match left_pad_be(d_raw, 32) {
      Ok(b) => b
      Err(_) => return Err(SshError::InvalidKey("p256 scalar exceeds 32 bytes"))
    }
    let derived = match crypto::p256_public_key(d32) {
      Ok(d) => d
      Err(_) => return Err(SshError::InvalidKey("p256 scalar derivation failed"))
    }
    if !ssh_bytes_eq(derived, q) {
      return Err(SshError::InvalidKey("p256 derived public key mismatch"))
    }
    PrivateKey::EcdsaP256(d32, q)
  } else if key_type == "ssh-rsa" {
    let n = match r.read_mpint_unsigned() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    let e = match r.read_mpint_unsigned() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    let d = match r.read_mpint_unsigned() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    let iqmp = match r.read_mpint_unsigned() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    let p = match r.read_mpint_unsigned() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    let q = match r.read_mpint_unsigned() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    if !rsa_private_key_params_valid(n, e, d, iqmp, p, q) {
      return Err(SshError::InvalidKey("inconsistent RSA private key CRT parameters"))
    }
    PrivateKey::Rsa(n, e, d, iqmp, p, q)
  } else {
    return Err(SshError::UnsupportedAlgorithm(key_type))
  }
  let comment = match r.read_string() {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  // Verify strict ascending padding 1, 2, 3, ...
  let rem = r.remaining()
  if rem >= 8 {
    return Err(SshError::InvalidPadding)
  }
  let mut expected_pad = 1
  while expected_pad <= rem {
    let b = match r.read_byte() {
      Ok(v) => v.to_int() & 0xFF
      Err(e) => return Err(e)
    }
    if b != expected_pad {
      return Err(SshError::InvalidPadding)
    }
    expected_pad = expected_pad + 1
  }
  // Verify header public key matches private key's public key
  let derived_pk = private_key_public_key(priv_key)
  if !ssh_bytes_eq(public_key_to_wire(header_pk), public_key_to_wire(derived_pk)) {
    return Err(SshError::InvalidKey("header public key does not match private key"))
  }
  Ok(OpenSshKeyFile::{
    cipher,
    kdf,
    kdf_options,
    public_key: derived_pk,
    private_key: priv_key,
    comment,
  })
}

///|
pub fn encode_openssh_private_key(
  key : PrivateKey,
  comment : String,
  checkint : UInt,
) -> Result[String, SshError] {
  let pk = private_key_public_key(key)
  let pub_blob = public_key_to_wire(pk)
  let inner = SshWriter::new()
  inner.write_u32(checkint)
  inner.write_u32(checkint)
  match key {
    PrivateKey::Ed25519(seed, pk32) => {
      if seed.length() != 32 || pk32.length() != 32 {
        return Err(SshError::InvalidKey("invalid ed25519 key lengths"))
      }
      inner.write_string("ssh-ed25519")
      inner.write_bytes(pk32)
      let sk64 = SshWriter::new()
      sk64.write_raw(seed)
      sk64.write_raw(pk32)
      inner.write_bytes(sk64.to_bytes())
    }
    PrivateKey::EcdsaP256(scalar, q) => {
      if scalar.length() != 32 || q.length() != 65 {
        return Err(SshError::InvalidKey("invalid p256 key lengths"))
      }
      inner.write_string("ecdsa-sha2-nistp256")
      inner.write_string("nistp256")
      inner.write_bytes(q)
      inner.write_mpint_unsigned(scalar)
    }
    PrivateKey::Rsa(n, e, d, iqmp, p, q) => {
      inner.write_string("ssh-rsa")
      inner.write_mpint_unsigned(n)
      inner.write_mpint_unsigned(e)
      inner.write_mpint_unsigned(d)
      inner.write_mpint_unsigned(iqmp)
      inner.write_mpint_unsigned(p)
      inner.write_mpint_unsigned(q)
    }
  }
  inner.write_string(comment)
  let mut pad = 1
  while inner.length() % 8 != 0 {
    inner.write_byte(pad.to_byte())
    pad = pad + 1
  }
  let outer = SshWriter::new()
  outer.write_raw("openssh-key-v1\u{00}".to_bytes())
  outer.write_string("none")
  outer.write_string("none")
  outer.write_bytes(Bytes::new(0))
  outer.write_u32(1U)
  outer.write_bytes(pub_blob)
  outer.write_bytes(inner.to_bytes())
  Ok(encode_armor(
    outer.to_bytes(),
    "-----BEGIN OPENSSH PRIVATE KEY-----",
    "-----END OPENSSH PRIVATE KEY-----",
  ))
}
