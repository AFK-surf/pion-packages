///| SSH public keys, fingerprints, signatures, and OpenSSH private keys (`openssh-key-v1`).
///| Stub implementation for Red phase.

///|
pub enum PublicKey {
  Ed25519(Bytes)
  EcdsaP256(Bytes)
  Rsa(Bytes, Bytes)
}

///|
pub struct Signature {
  algorithm : String
  blob : Bytes
}

///|
pub enum PrivateKey {
  Ed25519(Bytes, Bytes)
  EcdsaP256(Bytes, Bytes)
  Rsa(Bytes, Bytes, Bytes, Bytes, Bytes, Bytes)
}

///|
pub struct OpenSshKeyFile {
  cipher : String
  kdf : String
  kdf_options : Bytes
  public_key : PublicKey
  private_key : PrivateKey
  comment : String
}

///|
pub struct EncryptedKeyInfo {
  cipher : String
  kdf : String
  kdf_options : Bytes
  public_key : PublicKey
}

///|
pub fn public_key_algorithm(pk : PublicKey) -> String {
  let _ = pk
  ""
}

///|
pub fn public_key_to_wire(pk : PublicKey) -> Bytes {
  let _ = pk
  Bytes::new(0)
}

///|
pub fn parse_public_key_wire(blob : Bytes) -> Result[PublicKey, SshError] {
  let _ = blob
  Err(SshError::InvalidWireFormat("not implemented"))
}

///|
pub fn public_key_fingerprint_sha256(pk : PublicKey) -> String {
  let _ = pk
  ""
}

///|
pub fn public_key_fingerprint_eq(pk : PublicKey, expected : String) -> Bool {
  let _ = pk
  let _ = expected
  false
}

///|
pub fn public_key_to_openssh(pk : PublicKey, comment : String) -> String {
  let _ = pk
  let _ = comment
  ""
}

///|
pub fn parse_public_key_openssh(line : String) -> Result[(PublicKey, String), SshError] {
  let _ = line
  Err(SshError::InvalidWireFormat("not implemented"))
}

///|
pub fn public_key_verify(
  pk : PublicKey,
  data : Bytes,
  sig : Signature,
) -> Result[Unit, SshError] {
  let _ = pk
  let _ = data
  let _ = sig
  Err(SshError::InvalidWireFormat("not implemented"))
}

///|
pub fn Signature::to_wire(self : Signature) -> Bytes {
  let _ = self
  Bytes::new(0)
}

///|
pub fn Signature::from_wire(blob : Bytes) -> Result[Signature, SshError] {
  let _ = blob
  Err(SshError::InvalidWireFormat("not implemented"))
}

///|
pub fn private_key_public_key(sk : PrivateKey) -> PublicKey {
  match sk {
    PrivateKey::Ed25519(_, pk) => PublicKey::Ed25519(pk)
    PrivateKey::EcdsaP256(_, pk) => PublicKey::EcdsaP256(pk)
    PrivateKey::Rsa(n, e, _, _, _, _) => PublicKey::Rsa(e, n)
  }
}

///|
pub fn private_key_sign(sk : PrivateKey, data : Bytes) -> Result[Signature, SshError] {
  let _ = sk
  let _ = data
  Err(SshError::InvalidWireFormat("not implemented"))
}

///|
pub fn parse_openssh_private_key(pem : String) -> Result[OpenSshKeyFile, SshError] {
  let _ = pem
  Err(SshError::InvalidWireFormat("not implemented"))
}

///|
pub fn parse_openssh_private_key_header(pem : String) -> Result[EncryptedKeyInfo, SshError] {
  let _ = pem
  Err(SshError::InvalidWireFormat("not implemented"))
}

///|
pub fn encode_openssh_private_key(
  key : PrivateKey,
  comment : String,
  checkint : UInt,
) -> Result[String, SshError] {
  let _ = key
  let _ = comment
  let _ = checkint
  Err(SshError::InvalidWireFormat("not implemented"))
}
