///| OpenSSH `known_hosts` parser, matcher, and `|1|` HMAC-SHA1 hostname hashing.
///| Stub implementation for Red phase.

///|
pub enum KnownHostMarker {
  None
  CertAuthority
  Revoked
}

///|
pub struct KnownHostEntry {
  marker : KnownHostMarker
  patterns : Array[String]
  key : PublicKey
  comment : String
}

///|
pub fn hmac_sha1(key : Bytes, data : Bytes) -> Bytes {
