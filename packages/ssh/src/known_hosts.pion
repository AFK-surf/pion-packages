///| OpenSSH `known_hosts` parser, wildcard/negation matcher, and `|1|` HMAC-SHA1 hashed hosts.

import "base64"
import "crypto"

///|
pub enum KnownHostMarker {
  None
  CertAuthority
  Revoked
}

///|
pub struct KnownHostEntry {
  marker : KnownHostMarker
  patterns : Array[String]
  key : PublicKey
  comment : String
}

///| RFC 2104 HMAC-SHA1 built on `packages/crypto` `Sha1`.
pub fn hmac_sha1(key : Bytes, data : Bytes) -> Bytes {
  let k = if key.length() > 64 { crypto::sha1(key) } else { key }
  let mut ipad = Bytes::new(64)
  let mut opad = Bytes::new(64)
  let mut i = 0
  while i < 64 {
    let kb = if i < k.length() { k[i].to_int() & 0xFF } else { 0 }
    ipad[i] = (kb ^ 0x36).to_byte()
    opad[i] = (kb ^ 0x5C).to_byte()
    i = i + 1
  }
  let inner = crypto::Sha1::new()
  inner.update(ipad)
  inner.update(data)
  let inner_hash = inner.finalize()
  let outer = crypto::Sha1::new()
  outer.update(opad)
  outer.update(inner_hash)
  outer.finalize()
}

///| Format an OpenSSH `|1|<base64(salt)>|<base64(HMAC-SHA1(salt, hostname))>` entry.
pub fn hash_hostname(hostname : String, salt : Bytes) -> Result[String, SshError] {
  if salt.length() != 20 {
    return Err(SshError::InvalidKnownHost("known_hosts |1| salt must be 20 bytes"))
  }
  let digest = hmac_sha1(salt, hostname.to_bytes())
  Ok("|1|" + base64::encode(salt) + "|" + base64::encode(digest))
}

///| Match an OpenSSH `|1|<salt>|<hash>` pattern against `hostname` in constant time.
pub fn match_hashed_hostname(pattern : String, hostname : String) -> Bool {
  let pb = pattern.to_bytes()
  let n = pb.length()
  if n < 5 {
    return false
  }
  if (pb[0].to_int() & 0xFF) != 124 || (pb[1].to_int() & 0xFF) != 49 || (pb[2].to_int() & 0xFF) != 124 {
    return false
  }
  let mut sep = -1
  let mut i = 3
  while i < n {
    if (pb[i].to_int() & 0xFF) == 124 {
      sep = i
      break
    }
    i = i + 1
  }
  if sep <= 3 || sep + 1 >= n {
    return false
  }
  let salt_b64 = pb.slice(3, sep).to_string()
  let hash_b64 = pb.slice(sep + 1, n).to_string()
  let salt = match base64::decode(salt_b64) {
    Ok(s) => s
    Err(_) => return false
  }
  let expected = match base64::decode(hash_b64) {
    Ok(h) => h
    Err(_) => return false
  }
  if salt.length() != 20 || expected.length() != 20 {
    return false
  }
  let actual = hmac_sha1(salt, hostname.to_bytes())
  crypto::constant_time_eq(actual, expected)
}

///| Iterative O(N*M) wildcard matcher supporting `*` and `?` (ASCII case-insensitive for hostnames).
fn wildcard_match(pattern : Bytes, text : Bytes) -> Bool {
  let plen = pattern.length()
  let tlen = text.length()
  let mut pi = 0
  let mut ti = 0
  let mut star_pi = -1
  let mut star_ti = 0
  while ti < tlen {
    if pi < plen && (pattern[pi].to_int() & 0xFF) == 42 {
      // '*'
      star_pi = pi
      star_ti = ti
      pi = pi + 1
    } else if pi < plen &&
    ((pattern[pi].to_int() & 0xFF) == 63 ||
      to_lower_ascii(pattern[pi].to_int() & 0xFF) == to_lower_ascii(text[ti].to_int() & 0xFF)) {
      pi = pi + 1
      ti = ti + 1
    } else if star_pi >= 0 {
      pi = star_pi + 1
      star_ti = star_ti + 1
      ti = star_ti
    } else {
      return false
    }
  }
  while pi < plen && (pattern[pi].to_int() & 0xFF) == 42 {
    pi = pi + 1
  }
  pi == plen
}

///|
fn to_lower_ascii(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

///|
pub fn match_host_pattern(pattern : String, hostname : String) -> Bool {
  let pb = pattern.to_bytes()
  if pb.length() >= 3 && (pb[0].to_int() & 0xFF) == 124 {
    return match_hashed_hostname(pattern, hostname)
  }
  wildcard_match(pb, hostname.to_bytes())
}

///| Match a comma-separated list of `known_hosts` patterns with OpenSSH `!negated` precedence.
pub fn match_known_host_patterns(patterns : Array[String], hostname : String) -> Bool {
  let mut matched = false
  let mut i = 0
  while i < patterns.length() {
    let p = patterns[i]
    let pb = p.to_bytes()
    if pb.length() > 0 && (pb[0].to_int() & 0xFF) == 33 {
      // '!' negation overrides any positive match
      let sub = pb.slice(1, pb.length()).to_string()
      if match_host_pattern(sub, hostname) {
        return false
      }
    } else if !matched && match_host_pattern(p, hostname) {
      matched = true
    }
    i = i + 1
  }
  matched
}

///|
fn split_commas(s : String) -> Array[String] {
  let b = s.to_bytes()
  let n = b.length()
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || (b[i].to_int() & 0xFF) == 44 {
      if i > start {
        out.push(b.slice(start, i).to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  out
}

///|
pub fn parse_known_hosts_line(line : String) -> Result[Option[KnownHostEntry], SshError] {
  let trimmed = trim_ascii(line)
  if trimmed.length() == 0 {
    return Ok(None)
  }
  let b = trimmed.to_bytes()
  if (b[0].to_int() & 0xFF) == 35 {
    return Ok(None)
  }
  let (tok0, rest0) = split_first_field(trimmed)
  let (marker, host_field, key_rest) = if tok0 == "@cert-authority" {
    let (hf, kr) = split_first_field(rest0)
    (KnownHostMarker::CertAuthority, hf, kr)
  } else if tok0 == "@revoked" {
    let (hf, kr) = split_first_field(rest0)
    (KnownHostMarker::Revoked, hf, kr)
  } else {
    (KnownHostMarker::None, tok0, rest0)
  }
  if host_field.length() == 0 || key_rest.length() == 0 {
    return Err(SshError::InvalidKnownHost("incomplete known_hosts line"))
  }
  let patterns = split_commas(host_field)
  if patterns.length() == 0 {
    return Err(SshError::InvalidKnownHost("empty host patterns"))
  }
  let (key, comment) = match parse_public_key_openssh(key_rest) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  Ok(Some(KnownHostEntry::{ marker, patterns, key, comment }))
}

///| Parse a `known_hosts` file following OpenSSH / Go semantics:
///| unsupported key algorithms or malformed lines are skipped rather than rejecting the whole file.
pub fn parse_known_hosts(text : String) -> Result[Array[KnownHostEntry], SshError] {
  let b = text.to_bytes()
  let n = b.length()
  let out : Array[KnownHostEntry] = []
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || (b[i].to_int() & 0xFF) == 10 {
      let mut end = i
      if end > start && (b[end - 1].to_int() & 0xFF) == 13 {
        end = end - 1
      }
      let line = b.slice(start, end).to_string()
      match parse_known_hosts_line(line) {
        Ok(Some(entry)) => out.push(entry)
        Ok(None) => ()
        Err(_) => ()
      }
      start = i + 1
    }
    i = i + 1
  }
  Ok(out)
}

///| Strict `known_hosts` file parser: returns `Err` on the first invalid or unsupported line.
pub fn parse_known_hosts_strict(text : String) -> Result[Array[KnownHostEntry], SshError] {
  let b = text.to_bytes()
  let n = b.length()
  let out : Array[KnownHostEntry] = []
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || (b[i].to_int() & 0xFF) == 10 {
      let mut end = i
      if end > start && (b[end - 1].to_int() & 0xFF) == 13 {
        end = end - 1
      }
      let line = b.slice(start, end).to_string()
      match parse_known_hosts_line(line) {
        Ok(Some(entry)) => out.push(entry)
        Ok(None) => ()
        Err(e) => return Err(e)
      }
      start = i + 1
    }
    i = i + 1
  }
  Ok(out)
}

///|
pub fn find_known_hosts(entries : Array[KnownHostEntry], hostname : String) -> Array[KnownHostEntry] {
  let out : Array[KnownHostEntry] = []
  let mut i = 0
  while i < entries.length() {
    if match_known_host_patterns(entries[i].patterns, hostname) {
      out.push(entries[i])
    }
    i = i + 1
  }
  out
}
