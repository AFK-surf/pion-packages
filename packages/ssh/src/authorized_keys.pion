///| OpenSSH `authorized_keys` parser and serializer.
///| Handles quoted option values with `\"` and `\\` escapes, public keys, and certificates.

///|
pub struct AuthorizedKeyOption {
  name : String
  value : Option[String]
}

///|
pub enum AuthorizedKeyMaterial {
  Key(PublicKey)
  Cert(Certificate)
}

///|
pub struct AuthorizedKey {
  options : Array[AuthorizedKeyOption]
  key : AuthorizedKeyMaterial
  comment : String
}

///|
fn is_known_key_or_cert_type(s : String) -> Bool {
  s == "ssh-ed25519" ||
  s == "ecdsa-sha2-nistp256" ||
  s == "ssh-rsa" ||
  s == "ssh-ed25519-cert-v01@openssh.com" ||
  s == "ecdsa-sha2-nistp256-cert-v01@openssh.com" ||
  s == "ssh-rsa-cert-v01@openssh.com"
}

///|
fn is_cert_type(s : String) -> Bool {
  s == "ssh-ed25519-cert-v01@openssh.com" ||
  s == "ecdsa-sha2-nistp256-cert-v01@openssh.com" ||
  s == "ssh-rsa-cert-v01@openssh.com"
}

///| Lowercase an ASCII string for OpenSSH case-insensitive authorized_keys option matching.
fn ak_to_lower_ascii(s : String) -> String {
  let b = s.to_bytes()
  let n = b.length()
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    out[i] = (if c >= 65 && c <= 90 { c + 32 } else { c }).to_byte()
    i = i + 1
  }
  out.to_string()
}

///| Check whether `s` contains CR, LF, or NUL.
fn has_ctrl_line_break(s : String) -> Bool {
  let b = s.to_bytes()
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if c == 0 || c == 10 || c == 13 {
      return true
    }
    i = i + 1
  }
  false
}

///| OpenSSH `sshd(8)` authorized_keys flag options (no `="..."` value).
fn is_ak_flag_option(lower : String) -> Bool {
  lower == "restrict" ||
  lower == "cert-authority" ||
  lower == "no-agent-forwarding" ||
  lower == "no-port-forwarding" ||
  lower == "no-pty" ||
  lower == "no-user-rc" ||
  lower == "no-x11-forwarding" ||
  lower == "agent-forwarding" ||
  lower == "port-forwarding" ||
  lower == "pty" ||
  lower == "user-rc" ||
  lower == "x11-forwarding" ||
  lower == "no-touch-required" ||
  lower == "verify-required"
}

///| OpenSSH `sshd(8)` authorized_keys value options (require `="..."` value).
fn is_ak_value_option(lower : String) -> Bool {
  lower == "command" ||
  lower == "environment" ||
  lower == "expiry-time" ||
  lower == "from" ||
  lower == "permitlisten" ||
  lower == "permitopen" ||
  lower == "principals" ||
  lower == "tunnel"
}

///| Parse the leading options field of an `authorized_keys` line following OpenSSH `auth-options.c`:
///| - Skips empty comma-separated segments (e.g. `,no-pty` or `no-pty, `);
///| - Rejects unknown option names (fail-closed) and flag/value arity mismatches;
///| - Inside double-quoted values, `opt_dequote()` only unescapes `\"` (NOT `\\`).
fn parse_ak_options(line_bytes : Bytes) -> Result[(Array[AuthorizedKeyOption], String), SshError] {
  let n = line_bytes.length()
  let opts : Array[AuthorizedKeyOption] = []
  let mut i = 0
  while i < n {
    let c0 = line_bytes[i].to_int() & 0xFF
    if c0 == 44 {
      // Skip leading/consecutive/trailing comma just like OpenSSH sshauthopt_parse
      i = i + 1
      continue
    }
    if c0 == 32 || c0 == 9 {
      while i < n && ((line_bytes[i].to_int() & 0xFF) == 32 || (line_bytes[i].to_int() & 0xFF) == 9) {
        i = i + 1
      }
      return Ok((opts, line_bytes.slice(i, n).to_string()))
    }
    let name_start = i
    while i < n {
      let c = line_bytes[i].to_int() & 0xFF
      if c == 61 || c == 44 || c == 32 || c == 9 {
        break
      }
      if c == 0 || c == 10 || c == 13 {
        return Err(SshError::InvalidAuthorizedKey("control character in option name"))
      }
      i = i + 1
    }
    let name = line_bytes.slice(name_start, i).to_string()
    let lower = ak_to_lower_ascii(name)
    let is_flag = is_ak_flag_option(lower)
    let is_val = is_ak_value_option(lower)
    if !is_flag && !is_val {
      return Err(SshError::InvalidAuthorizedKey("unknown authorized_keys option: " + name))
    }
    let mut opt_val : Option[String] = None
    if i < n && (line_bytes[i].to_int() & 0xFF) == 61 {
      if !is_val {
        return Err(SshError::InvalidAuthorizedKey("flag option cannot have a value: " + name))
      }
      // '='
      i = i + 1
      if i >= n || (line_bytes[i].to_int() & 0xFF) != 34 {
        return Err(SshError::InvalidAuthorizedKey("option value must be double-quoted"))
      }
      i = i + 1
      let sb = StringBuilder::new()
      let mut closed = false
      while i < n {
        let c = line_bytes[i].to_int() & 0xFF
        if c == 0 || c == 10 || c == 13 {
          return Err(SshError::InvalidAuthorizedKey("control character in option value"))
        }
        if c == 92 {
          // OpenSSH opt_dequote(): only `\"` is unescaped; any other `\x` keeps the `\` and advances by 1.
          if i + 1 < n && (line_bytes[i + 1].to_int() & 0xFF) == 34 {
            sb.write_char('"')
            i = i + 2
          } else {
            sb.write_char('\\')
            i = i + 1
          }
        } else if c == 34 {
          i = i + 1
          closed = true
          break
        } else {
          let seg_start = i
          while i < n {
            let ch = line_bytes[i].to_int() & 0xFF
            if ch == 92 || ch == 34 || ch == 0 || ch == 10 || ch == 13 {
              break
            }
            i = i + 1
          }
          sb.write_string(line_bytes.slice(seg_start, i).to_string())
        }
      }
      if !closed {
        return Err(SshError::InvalidAuthorizedKey("unterminated quoted option value"))
      }
      opt_val = Some(sb.to_string())
    } else if is_val {
      return Err(SshError::InvalidAuthorizedKey("option requires a value: " + name))
    }
    opts.push(AuthorizedKeyOption::{ name, value: opt_val })
    if i < n && (line_bytes[i].to_int() & 0xFF) == 44 {
      // ',' -> next option
      i = i + 1
    } else if i < n && ((line_bytes[i].to_int() & 0xFF) == 32 || (line_bytes[i].to_int() & 0xFF) == 9) {
      while i < n && ((line_bytes[i].to_int() & 0xFF) == 32 || (line_bytes[i].to_int() & 0xFF) == 9) {
        i = i + 1
      }
      return Ok((opts, line_bytes.slice(i, n).to_string()))
    } else {
      return Err(SshError::InvalidAuthorizedKey("missing key after options"))
    }
  }
  Err(SshError::InvalidAuthorizedKey("missing key after options"))
}

///|
pub fn parse_authorized_key_line(line : String) -> Result[Option[AuthorizedKey], SshError] {
  let trimmed = trim_ascii(line)
  if trimmed.length() == 0 {
    return Ok(None)
  }
  let b = trimmed.to_bytes()
  if (b[0].to_int() & 0xFF) == 35 {
    // '#' comment
    return Ok(None)
  }
  let (first_tok, _) = split_first_field(trimmed)
  let (options, key_part) = if is_known_key_or_cert_type(first_tok) {
    ([], trimmed)
  } else {
    match parse_ak_options(b) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
  }
  let (kt, _) = split_first_field(key_part)
  if is_cert_type(kt) {
    match Certificate::from_openssh(key_part) {
      Ok((cert, comment)) => {
        Ok(Some(AuthorizedKey::{ options, key: AuthorizedKeyMaterial::Cert(cert), comment }))
      }
      Err(e) => Err(e)
    }
  } else {
    match parse_public_key_openssh(key_part) {
      Ok((pk, comment)) => {
        Ok(Some(AuthorizedKey::{ options, key: AuthorizedKeyMaterial::Key(pk), comment }))
      }
      Err(e) => Err(e)
    }
  }
}

///| Parse an `authorized_keys` file following OpenSSH `sshd` / Go semantics:
///| unsupported key algorithms or malformed lines are skipped rather than rejecting the whole file.
pub fn parse_authorized_keys(text : String) -> Result[Array[AuthorizedKey], SshError] {
  let b = text.to_bytes()
  let n = b.length()
  let out : Array[AuthorizedKey] = []
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || (b[i].to_int() & 0xFF) == 10 {
      let mut end = i
      if end > start && (b[end - 1].to_int() & 0xFF) == 13 {
        end = end - 1
      }
      let line = b.slice(start, end).to_string()
      match parse_authorized_key_line(line) {
        Ok(Some(entry)) => out.push(entry)
        Ok(None) => ()
        Err(_) => ()
      }
      start = i + 1
    }
    i = i + 1
  }
  Ok(out)
}

///| Strict `authorized_keys` file parser: returns `Err` on the first invalid or unsupported line.
pub fn parse_authorized_keys_strict(text : String) -> Result[Array[AuthorizedKey], SshError] {
  let b = text.to_bytes()
  let n = b.length()
  let out : Array[AuthorizedKey] = []
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || (b[i].to_int() & 0xFF) == 10 {
      let mut end = i
      if end > start && (b[end - 1].to_int() & 0xFF) == 13 {
        end = end - 1
      }
      let line = b.slice(start, end).to_string()
      match parse_authorized_key_line(line) {
        Ok(Some(entry)) => out.push(entry)
        Ok(None) => ()
        Err(e) => return Err(e)
      }
      start = i + 1
    }
    i = i + 1
  }
  Ok(out)
}

///| Strip CR, LF, and NUL from option names.
fn sanitize_ak_name(s : String) -> String {
  let b = s.to_bytes()
  let n = b.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if c == 0 || c == 10 || c == 13 {
      i = i + 1
    } else {
      let seg = i
      while i < n {
        let ch = b[i].to_int() & 0xFF
        if ch == 0 || ch == 10 || ch == 13 {
          break
        }
        i = i + 1
      }
      sb.write_string(b.slice(seg, i).to_string())
    }
  }
  sb.to_string()
}

///| Checked `authorized_keys` encoder that rejects CR, LF, or NUL in option names, values, or comments.
pub fn encode_authorized_key_checked(ak : AuthorizedKey) -> Result[String, SshError] {
  if has_ctrl_line_break(ak.comment) {
    return Err(SshError::InvalidAuthorizedKey("CR/LF/NUL not allowed in authorized_keys comment"))
  }
  let mut i = 0
  while i < ak.options.length() {
    if has_ctrl_line_break(ak.options[i].name) {
      return Err(SshError::InvalidAuthorizedKey("CR/LF/NUL not allowed in option name"))
    }
    match ak.options[i].value {
      Some(v) => {
        if has_ctrl_line_break(v) {
          return Err(SshError::InvalidAuthorizedKey("CR/LF/NUL not allowed in option value"))
        }
      }
      None => ()
    }
    i = i + 1
  }
  Ok(encode_authorized_key(ak))
}

///| Encode an `AuthorizedKey` as a single `authorized_keys` line.
///| Neutralizes CR, LF, and NUL in option names, option values, and comments so a caller-supplied
///| value can never split the entry into multiple lines (preventing newline key injection).
pub fn encode_authorized_key(ak : AuthorizedKey) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ak.options.length() {
    if i > 0 {
      sb.write_char(',')
    }
    sb.write_string(sanitize_ak_name(ak.options[i].name))
    match ak.options[i].value {
      Some(v) => {
        sb.write_string("=\"")
        let vb = v.to_bytes()
        let mut j = 0
        while j < vb.length() {
          let c = vb[j].to_int() & 0xFF
          if c == 34 {
            sb.write_string("\\\"")
            j = j + 1
          } else if c == 10 || c == 13 || c == 0 {
            sb.write_char(' ')
            j = j + 1
          } else {
            let seg = j
            while j < vb.length() {
              let ch = vb[j].to_int() & 0xFF
              if ch == 34 || ch == 10 || ch == 13 || ch == 0 {
                break
              }
              j = j + 1
            }
            sb.write_string(vb.slice(seg, j).to_string())
          }
        }
        sb.write_char('"')
      }
      None => ()
    }
    i = i + 1
  }
  if ak.options.length() > 0 {
    sb.write_char(' ')
  }
  let key_str = match ak.key {
    AuthorizedKeyMaterial::Key(pk) => public_key_to_openssh(pk, ak.comment)
    AuthorizedKeyMaterial::Cert(c) => c.to_openssh(ak.comment)
  }
  sb.write_string(key_str)
  sb.to_string()
}
