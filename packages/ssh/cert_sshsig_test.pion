///|
test "cert: parse, verify, and roundtrip real OpenSSH Ed25519 user certificate" {
  let (ca_pk, _) = match parse_public_key_openssh(vec_ca_ed25519_pub) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse ca_ed25519 failed")
      return
    }
  }
  let (cert, comment) = match Certificate::from_openssh(vec_alice_cert) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse alice cert failed")
      return
    }
  }
  debug_assert(comment == "alice@pion.dev", "cert comment")
  debug_assert(cert.cert_type_name == "ssh-ed25519-cert-v01@openssh.com", "cert type name")
  debug_assert(cert.serial == 42UL, "cert serial")
  debug_assert(cert.key_id == "alice-cert-01", "cert key_id")
  debug_assert(cert.valid_principals.length() == 2, "principals len")
  debug_assert(cert.valid_principals[0] == "alice" && cert.valid_principals[1] == "deploy", "principals")
  debug_assert(cert.valid_after == 1767193200UL, "valid_after")
  debug_assert(cert.valid_before == 1893423600UL, "valid_before")
  debug_assert(cert.critical_options.length() == 2, "critical_options len")
  debug_assert(cert.critical_options[0].name == "force-command", "critical_options[0]")
  match cert.critical_options[0].value_string() {
    Ok(s) => debug_assert(s == "/usr/bin/git-shell", "force-command val")
    Err(_) => debug_assert(false, "force-command value_string failed")
  }
  debug_assert(cert.extensions.length() == 2, "extensions len")
  debug_assert(cert.extensions[0].name == "permit-pty", "extensions[0]")
  debug_assert(cert.to_openssh(comment) == vec_alice_cert, "cert roundtrip")

  // vec_alice_cert carries critical option source-address=192.0.2.0/24:
  // verify() without client IP must reject; verify_with_options() with matching IP must succeed.
  match cert.verify(ca_pk, CertType::User, "alice", 1800000000UL) {
    Err(SshError::InvalidCertificate(_)) => ()
    _ => debug_assert(false, "expected InvalidCertificate without client_ip for source-address cert")
  }
  let ok_opts = CertVerifyOptions::with_client_ip("192.0.2.42")
  let bad_ip_opts = CertVerifyOptions::with_client_ip("198.51.100.1")
  match cert.verify_with_options(ca_pk, CertType::User, "alice", 1800000000UL, ok_opts) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "verify alice cert with matching client_ip failed")
  }
  match cert.verify_with_options(ca_pk, CertType::User, "alice", 1800000000UL, bad_ip_opts) {
    Err(SshError::InvalidCertificate(_)) => ()
    _ => debug_assert(false, "expected InvalidCertificate for non-matching client_ip")
  }
  match cert.verify_with_options(ca_pk, CertType::User, "deploy", 1800000000UL, ok_opts) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "verify deploy principal failed")
  }
  match cert.verify_with_options(ca_pk, CertType::User, "alice", 1893423600UL, ok_opts) {
    Err(SshError::CertificateExpired) => ()
    _ => debug_assert(false, "expected CertificateExpired")
  }
  match cert.verify_with_options(ca_pk, CertType::User, "alice", 1767193199UL, ok_opts) {
    Err(SshError::CertificateNotYetValid) => ()
    _ => debug_assert(false, "expected CertificateNotYetValid")
  }
  match cert.verify_with_options(ca_pk, CertType::User, "root", 1800000000UL, ok_opts) {
    Err(SshError::PrincipalMismatch) => ()
    _ => debug_assert(false, "expected PrincipalMismatch")
  }
  match cert.verify_with_options(ca_pk, CertType::Host, "alice", 1800000000UL, ok_opts) {
    Err(SshError::CertTypeMismatch) => ()
    _ => debug_assert(false, "expected CertTypeMismatch")
  }
  let (wrong_ca, _) = match parse_public_key_openssh(vec_alice_pub) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse alice pub failed")
      return
    }
  }
  match cert.verify_with_options(wrong_ca, CertType::User, "alice", 1800000000UL, ok_opts) {
    Err(SshError::SignatureVerificationFailed) => ()
    _ => debug_assert(false, "expected SignatureVerificationFailed for wrong CA")
  }
}

///|
test "cert: verify real OpenSSH P-256 host certificate and RSA-SHA2-256 user certificate" {
  let (ca_p256, _) = match parse_public_key_openssh(vec_ca_p256_pub) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse ca_p256 failed")
      return
    }
  }
  let (host_cert, _) = match Certificate::from_openssh(vec_bob_cert) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse bob cert failed")
      return
    }
  }
  debug_assert(host_cert.serial == 99UL, "host cert serial")
  debug_assert(host_cert.key_id == "host-prod-01", "host cert key_id")
  match host_cert.verify(ca_p256, CertType::Host, "prod.example.com", 1800000000UL) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "verify prod.example.com failed")
  }
  match host_cert.verify(ca_p256, CertType::Host, "db01.internal.example.com", 1800000000UL) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "verify wildcard host failed")
  }
  match host_cert.verify(ca_p256, CertType::Host, "evil.example.com", 1800000000UL) {
    Err(SshError::PrincipalMismatch) => ()
    _ => debug_assert(false, "expected PrincipalMismatch for evil host")
  }

  let (ca_rsa, _) = match parse_public_key_openssh(vec_ca_rsa_pub) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse ca_rsa failed")
      return
    }
  }
  let (rsa_cert, _) = match Certificate::from_openssh(vec_carol_cert) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse carol cert failed")
      return
    }
  }
  debug_assert(rsa_cert.serial == 7UL, "rsa cert serial")
  debug_assert(rsa_cert.key_id == "carol-rsa-cert", "rsa cert key_id")
  match rsa_cert.verify(ca_rsa, CertType::User, "carol", 1800000000UL) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "verify rsa cert failed")
  }

  let mut bad_sig_blob = Bytes::new(rsa_cert.signature.blob.length())
  let mut i = 0
  while i < rsa_cert.signature.blob.length() {
    bad_sig_blob[i] = rsa_cert.signature.blob[i]
    i = i + 1
  }
  bad_sig_blob[0] = (bad_sig_blob[0].to_int() ^ 0xFF).to_byte()
  let forged = Certificate::{
    cert_type_name: rsa_cert.cert_type_name,
    nonce: rsa_cert.nonce,
    key: rsa_cert.key,
    serial: rsa_cert.serial,
    cert_type: rsa_cert.cert_type,
    key_id: rsa_cert.key_id,
    valid_principals: rsa_cert.valid_principals,
    valid_after: rsa_cert.valid_after,
    valid_before: rsa_cert.valid_before,
    critical_options: rsa_cert.critical_options,
    extensions: rsa_cert.extensions,
    reserved: rsa_cert.reserved,
    signature_key: rsa_cert.signature_key,
    signature: Signature::{ algorithm: rsa_cert.signature.algorithm, blob: bad_sig_blob },
  }
  match forged.verify(ca_rsa, CertType::User, "carol", 1800000000UL) {
    Err(SshError::SignatureVerificationFailed) => ()
    _ => debug_assert(false, "expected SignatureVerificationFailed for forged cert")
  }
}

///|
test "sshsig: verify all 5 real ssh-keygen -Y sign vectors (Ed25519, P-256, RSA-SHA2-256)" {
  let msg = vec_sshsig_msg.to_bytes()

  let s1 = match parse_sshsig(vec_sig_ed25519_sha512) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse sig_ed25519_sha512 failed")
      return
    }
  }
  debug_assert(s1.namespace == "git", "s1 namespace")
  debug_assert(public_key_fingerprint_sha256(s1.public_key) == vec_alice_fp, "s1 fp")
  match sshsig_verify(s1, "git", msg) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "verify s1 failed")
  }
  match sshsig_verify(s1, "file", msg) {
    Err(SshError::NamespaceMismatch) => ()
    _ => debug_assert(false, "expected NamespaceMismatch")
  }
  match sshsig_verify(s1, "git", "tampered".to_bytes()) {
    Err(SshError::SignatureVerificationFailed) => ()
    _ => debug_assert(false, "expected SignatureVerificationFailed for tampered msg")
  }

  match parse_sshsig(vec_sig_ed25519_sha256) {
    Ok(s2) => {
      match sshsig_verify(s2, "file", msg) {
        Ok(_) => ()
        Err(_) => debug_assert(false, "verify s2 failed")
      }
    }
    Err(_) => debug_assert(false, "parse s2 failed")
  }

  match parse_sshsig(vec_sig_p256_sha512) {
    Ok(s3) => {
      debug_assert(public_key_fingerprint_sha256(s3.public_key) == vec_bob_fp, "s3 fp")
      match sshsig_verify(s3, "git", msg) {
        Ok(_) => ()
        Err(_) => debug_assert(false, "verify s3 failed")
      }
    }
    Err(_) => debug_assert(false, "parse s3 failed")
  }

  match parse_sshsig(vec_sig_p256_sha256) {
    Ok(s4) => {
      match sshsig_verify(s4, "file", msg) {
        Ok(_) => ()
        Err(_) => debug_assert(false, "verify s4 failed")
      }
    }
    Err(_) => debug_assert(false, "parse s4 failed")
  }

  match parse_sshsig(vec_sig_rsa_sha256) {
    Ok(s5) => {
      debug_assert(public_key_fingerprint_sha256(s5.public_key) == vec_carol_fp, "s5 fp")
      match sshsig_verify(s5, "git", msg) {
        Ok(_) => ()
        Err(_) => debug_assert(false, "verify s5 failed")
      }
    }
    Err(_) => debug_assert(false, "parse s5 failed")
  }
}

///|
test "sshsig: sign, armor encode, parse, and verify roundtrip (Ed25519 + P-256)" {
  let msg = "pion-sshsig-roundtrip-payload".to_bytes()
  let alice_kf = match parse_openssh_private_key(vec_alice_priv) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse alice priv failed")
      return
    }
  }
  let sig_ed = match sshsig_sign(alice_kf.private_key, "git", HashAlgorithm::Sha512, msg) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "sshsig_sign ed25519 failed")
      return
    }
  }
  let armored = encode_sshsig(sig_ed)
  match parse_sshsig(armored) {
    Ok(parsed) => {
      match sshsig_verify(parsed, "git", msg) {
        Ok(_) => ()
        Err(_) => debug_assert(false, "sshsig_verify ed25519 roundtrip failed")
      }
    }
    Err(_) => debug_assert(false, "parse_sshsig ed25519 roundtrip failed")
  }

  let bob_kf = match parse_openssh_private_key(vec_bob_priv) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse bob priv failed")
      return
    }
  }
  let sig_p256 = match sshsig_sign(bob_kf.private_key, "release", HashAlgorithm::Sha256, msg) {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "sshsig_sign p256 failed")
      return
    }
  }
  let armored_p256 = encode_sshsig(sig_p256)
  match parse_sshsig(armored_p256) {
    Ok(parsed) => {
      match sshsig_verify(parsed, "release", msg) {
        Ok(_) => ()
        Err(_) => debug_assert(false, "sshsig_verify p256 roundtrip failed")
      }
      match sshsig_verify_with_key(parsed, bob_kf.public_key, "release", msg) {
        Ok(_) => ()
        Err(_) => debug_assert(false, "sshsig_verify_with_key bob failed")
      }
      match sshsig_verify_with_key(parsed, alice_kf.public_key, "release", msg) {
        Err(SshError::SignatureVerificationFailed) => ()
        _ => debug_assert(false, "sshsig_verify_with_key must reject wrong key")
      }
      match sshsig_verify_allowed(parsed, [alice_kf.public_key, bob_kf.public_key], "release", msg) {
        Ok(_) => ()
        Err(_) => debug_assert(false, "sshsig_verify_allowed should accept bob")
      }
      match sshsig_verify_allowed(parsed, [alice_kf.public_key], "release", msg) {
        Err(SshError::SignatureVerificationFailed) => ()
        _ => debug_assert(false, "sshsig_verify_allowed must reject untrusted signer")
      }
    }
    Err(_) => debug_assert(false, "parse_sshsig p256 roundtrip failed")
  }
}

///|
test "cert: IPv4 and IPv6 source-address CIDR enforcement" {
  match parse_source_address_list("10.0.0.0/8,2001:db8::/32,::1/128") {
    Ok(cidrs) => {
      match parse_ip_addr("10.42.1.9") {
        Some(ip) => debug_assert(ip_matches_cidrs(ip, cidrs), "ipv4 match")
        None => debug_assert(false, "parse ipv4")
      }
      match parse_ip_addr("192.168.1.1") {
        Some(ip) => debug_assert(!ip_matches_cidrs(ip, cidrs), "ipv4 mismatch")
        None => debug_assert(false, "parse ipv4 2")
      }
      match parse_ip_addr("2001:db8:abcd::1") {
        Some(ip) => debug_assert(ip_matches_cidrs(ip, cidrs), "ipv6 match")
        None => debug_assert(false, "parse ipv6")
      }
      match parse_ip_addr("2001:db9::1") {
        Some(ip) => debug_assert(!ip_matches_cidrs(ip, cidrs), "ipv6 mismatch")
        None => debug_assert(false, "parse ipv6 2")
      }
      match parse_ip_addr("::1") {
        Some(ip) => debug_assert(ip_matches_cidrs(ip, cidrs), "ipv6 loopback")
        None => debug_assert(false, "parse ::1")
      }
    }
    Err(_) => debug_assert(false, "parse_source_address_list failed")
  }
  match parse_source_address_list("10.0.0.0/33") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "invalid ipv4 prefix /33 must fail")
  }
  match parse_source_address_list("2001:db8::/129") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "invalid ipv6 prefix /129 must fail")
  }
}
