///| Wasm32 smoke entry for the `xml` package.

import "xml"

///|
pub fn smoke() -> Int {
  let src = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\"><g id=\"g1\"><text>Hello &amp; Pion</text></g></svg>"
  let doc = match xml::Document::parse(src) {
    Ok(d) => d
    Err(_) => return -1
  }
  let root = doc.root_element()
  if !root.has_tag_name_ns("http://www.w3.org/2000/svg", "svg") {
    return -2
  }
  let w = xml::Writer::new()
  match w.write_document(doc) {
    Ok(()) => ()
    Err(_) => return -3
  }
  let out = w.into_string()
  let r = xml::Reader::new(out)
  let mut events = 0
  let mut done = false
  while !done {
    match r.next_event() {
      Ok(xml::Event::Eof) => done = true
      Ok(_) => events = events + 1
      Err(_) => return -4
    }
  }
  doc.node_count() + events + out.length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  if smoke() > 0 {
    0
  } else {
    1
  }
}
