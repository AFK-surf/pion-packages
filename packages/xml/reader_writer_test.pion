///| Streaming Reader (pull parser) and Writer (serializer) compliance & roundtrip tests.

///|
test "reader_event_sequence" {
  let src = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><!--top--><root a=\"1\" b=\"&lt;2&gt;\">hi<![CDATA[raw]]><?pi val?><empty/></root>"
  let r = Reader::new(src)
  let tags : Array[String] = []
  let mut saw_decl = false
  let mut saw_comment = false
  let mut saw_text = false
  let mut saw_cdata = false
  let mut saw_pi = false
  let mut saw_empty = false
  let mut done = false
  while !done {
    match r.next_event() {
      Ok(ev) => {
        match ev {
          Event::XmlDecl(d) => {
            saw_decl = true
            debug_assert(d.version == "1.0", "decl version")
          }
          Event::Comment(c) => {
            saw_comment = true
            debug_assert(c == "top", "comment text")
          }
          Event::StartElement(se) => {
            tags.push("start:" + se.name())
            let attrs = se.attributes()
            debug_assert(attrs.length() == 2, "2 attrs on root")
            debug_assert(attrs[0].name == "a" && attrs[0].value == "1", "attr a")
            debug_assert(attrs[1].name == "b" && attrs[1].value == "<2>", "attr b unescaped")
          }
          Event::EmptyElement(ee) => {
            saw_empty = true
            tags.push("empty:" + ee.name())
          }
          Event::EndElement(end) => tags.push("end:" + end.name())
          Event::Text(t) => {
            saw_text = true
            debug_assert(t == "hi", "text event")
          }
          Event::CData(cd) => {
            saw_cdata = true
            debug_assert(cd == "raw", "cdata event")
          }
          Event::ProcessingInstruction(pi) => {
            saw_pi = true
            debug_assert(pi.target == "pi", "pi target")
          }
          Event::DocType(_) => ()
          Event::Eof => done = true
        }
      }
      Err(e) => {
        debug_assert(false, "reader error: " + e.to_string())
        return ()
      }
    }
  }
  debug_assert(saw_decl, "saw decl")
  debug_assert(saw_comment, "saw comment")
  debug_assert(saw_text, "saw text")
  debug_assert(saw_cdata, "saw cdata")
  debug_assert(saw_pi, "saw pi")
  debug_assert(saw_empty, "saw empty")
  debug_assert(tags.length() == 3, "start, empty, end")
  debug_assert(tags[0] == "start:root", "tags[0]")
  debug_assert(tags[1] == "empty:empty", "tags[1]")
  debug_assert(tags[2] == "end:root", "tags[2]")
}

///|
test "writer_compact_and_escaping_roundtrip" {
  let w = Writer::new()
  debug_assert(
    w.write_xml_decl("1.0", Some("UTF-8"), None).is_ok(),
    "write decl",
  )
  debug_assert(
    w.write_start_element("root", [("a", "1 & \"2\" <3>"), ("b", "x\ty\nz")]).is_ok(),
    "write root",
  )
  debug_assert(w.write_text("hello <world> & ]]>").is_ok(), "write text")
  debug_assert(w.write_cdata("<raw>&amp;").is_ok(), "write cdata")
  debug_assert(w.write_comment(" a note ").is_ok(), "write comment")
  debug_assert(w.write_pi("target", Some("data")).is_ok(), "write pi")
  debug_assert(w.write_empty_element("item", [("id", "42")]).is_ok(), "write empty")
  debug_assert(w.write_end_element("root").is_ok(), "write end root")
  let xml_str = w.into_string()
  let doc = match Document::parse(xml_str) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "roundtrip parse failed: " + e.to_string() + "\n" + xml_str)
      return ()
    }
  }
  let root = doc.root_element()
  debug_assert(root.tag_name().name() == "root", "rt root")
  match root.attribute("a") {
    Some(v) => debug_assert(v == "1 & \"2\" <3>", "rt attr a")
    None => debug_assert(false, "missing attr a")
  }
  match root.attribute("b") {
    Some(v) => debug_assert(v == "x\ty\nz", "rt attr b preserves tab/nl")
    None => debug_assert(false, "missing attr b")
  }
  match root.text() {
    Some(v) => debug_assert(v == "hello <world> & ]]><raw>&amp;", "rt text+cdata")
    None => debug_assert(false, "missing text")
  }
}

///|
test "writer_pretty_indent" {
  let w = Writer::new_with_indent((32).to_byte(), 2)
  debug_assert(w.write_start_element("root", []).is_ok(), "start root")
  debug_assert(w.write_start_element("child", [("k", "v")]).is_ok(), "start child")
  debug_assert(w.write_text("hi").is_ok(), "text")
  debug_assert(w.write_end_element("child").is_ok(), "end child")
  debug_assert(w.write_empty_element("leaf", []).is_ok(), "empty leaf")
  debug_assert(w.write_end_element("root").is_ok(), "end root")
  let out = w.into_string()
  let expected = "<root>\n  <child k=\"v\">hi</child>\n  <leaf/>\n</root>"
  debug_assert(out == expected, "pretty output mismatch:\n" + out)
}

///|
test "writer_rejects_injections_and_illegal_chars" {
  let w = Writer::new()
  // Illegal control chars in text & attr
  match w.write_text("\u{0000}") {
    Ok(_) => debug_assert(false, "should reject NUL in text")
    Err(e) => match e.kind {
      XmlErrorKind::Unimplemented => debug_assert(false, "unimplemented")
      _ => ()
    }
  }
  match w.write_empty_element("a", [("k", "\u{000B}")]) {
    Ok(_) => debug_assert(false, "should reject VT in attr")
    Err(e) => match e.kind {
      XmlErrorKind::Unimplemented => debug_assert(false, "unimplemented")
      _ => ()
    }
  }
  // CDATA injection ]]>
  match w.write_cdata("abc]]>def") {
    Ok(_) => debug_assert(false, "should reject ]]> in cdata")
    Err(e) => match e.kind {
      XmlErrorKind::Unimplemented => debug_assert(false, "unimplemented")
      _ => ()
    }
  }
  // Comment injection -- and trailing -
  match w.write_comment("a -- b") {
    Ok(_) => debug_assert(false, "should reject -- in comment")
    Err(e) => match e.kind {
      XmlErrorKind::Unimplemented => debug_assert(false, "unimplemented")
      _ => ()
    }
  }
  match w.write_comment("trailing-") {
    Ok(_) => debug_assert(false, "should reject trailing - in comment")
    Err(e) => match e.kind {
      XmlErrorKind::Unimplemented => debug_assert(false, "unimplemented")
      _ => ()
    }
  }
  // PI target xml / value ?>
  match w.write_pi("xml", Some("x")) {
    Ok(_) => debug_assert(false, "should reject xml PI target")
    Err(e) => match e.kind {
      XmlErrorKind::Unimplemented => debug_assert(false, "unimplemented")
      _ => ()
    }
  }
  match w.write_pi("ok", Some("a?>b")) {
    Ok(_) => debug_assert(false, "should reject ?> in PI value")
    Err(e) => match e.kind {
      XmlErrorKind::Unimplemented => debug_assert(false, "unimplemented")
      _ => ()
    }
  }
  // Invalid tag name & mismatched end tag
  match w.write_start_element("1bad", []) {
    Ok(_) => debug_assert(false, "should reject invalid tag name")
    Err(e) => match e.kind {
      XmlErrorKind::Unimplemented => debug_assert(false, "unimplemented")
      _ => ()
    }
  }
  let w2 = Writer::new()
  debug_assert(w2.write_start_element("a", []).is_ok(), "start a")
  match w2.write_end_element("b") {
    Ok(_) => debug_assert(false, "should reject mismatched end tag")
    Err(e) => match e.kind {
      XmlErrorKind::Unimplemented => debug_assert(false, "unimplemented")
      _ => ()
    }
  }
}

///|
test "writer_write_document_roundtrip" {
  let src = "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"100\"><g id=\"g1\"><text>a &amp; b</text><!--note--></g></svg>"
  let doc = match Document::parse(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse failed: " + e.to_string())
      return ()
    }
  }
  let w = Writer::new()
  debug_assert(w.write_document(doc).is_ok(), "write_document ok")
  let out = w.into_string()
  let doc2 = match Document::parse(out) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "reparse failed: " + e.to_string() + "\n" + out)
      return ()
    }
  }
  debug_assert(doc2.root_element().tag_name().name() == "svg", "rt svg")
  debug_assert(doc2.node_count() == doc.node_count(), "same node count")
}
