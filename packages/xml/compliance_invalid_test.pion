///| W3C XML 1.0 (Fifth Edition) & roxmltree well-formedness error compliance tests.

fn must_fail(src : String, label : String) -> Unit {
  match Document::parse(src) {
    Ok(_) => debug_assert(false, label + ": expected Err, got Ok")
    Err(e) => {
      match e.kind {
        XmlErrorKind::Unimplemented =>
        debug_assert(false, label + ": still Unimplemented")
        _ => ()
      }
    }
  }
}

///|
test "invalid_document_structure" {
  must_fail("", "empty doc")
  must_fail("   \n\t  ", "whitespace only")
  must_fail("<!-- only comment -->", "only comment")
  must_fail("<?pi only?>", "only pi")
  must_fail("<a/><b/>", "two root elements")
  must_fail("<a></a><b></b>", "two roots start/end")
  must_fail("text<a/>", "text before root")
  must_fail("<a/>text", "text after root")
  must_fail("<![CDATA[hi]]><a/>", "cdata before root")
  must_fail("<a/><![CDATA[hi]]>", "cdata after root")
  must_fail("</a>", "stray end tag")
  must_fail("<a/></a>", "trailing end tag")
}

///|
test "invalid_tags_and_nesting" {
  must_fail("<a>", "unclosed tag")
  must_fail("<a><b></a></b>", "crossed tags")
  must_fail("<a></b>", "mismatched tag")
  must_fail("<a/> <", "trailing lt")
  must_fail("<>", "empty tag name")
  must_fail("< a/>", "space after lt")
  must_fail("<a / >", "space in empty close")
  must_fail("<a></ a>", "space in end tag")
  must_fail("<a/b>", "slash in tag")
  must_fail("<1a/>", "digit name start")
  must_fail("<-a/>", "hyphen name start")
  must_fail("<.a/>", "dot name start")
}

///|
test "invalid_attributes" {
  must_fail("<a k=\"1\" k=\"2\"/>", "duplicate attr")
  must_fail("<a k=1/>", "unquoted attr")
  must_fail("<a k=\"1\"m=\"2\"/>", "missing space between attrs")
  must_fail("<a k=\"a<b\"/>", "raw lt in attr")
  must_fail("<a k=\"unterminated/>", "unterminated attr")
  must_fail("<a k='unterminated\"/>", "mismatched quotes")
  must_fail("<a =\"1\"/>", "missing attr name")
  must_fail("<a k/>", "missing attr value")
}

///|
test "invalid_xml_decl_and_pi" {
  must_fail(" <?xml version=\"1.0\"?><a/>", "space before xmldecl")
  must_fail("<!-- c --><?xml version=\"1.0\"?><a/>", "comment before xmldecl")
  must_fail("<?xml?><a/>", "xmldecl without version")
  must_fail("<?xml version=\"2.0\"?><a/>", "xmldecl version 2.0")
  must_fail("<?xml version=\"1.1\"?><a/>", "xmldecl version 1.1")
  must_fail("<?xml encoding=\"UTF-8\" version=\"1.0\"?><a/>", "xmldecl wrong order")
  must_fail("<?xml version=\"1.0\" standalone=\"maybe\"?><a/>", "xmldecl bad standalone")
  must_fail("<?xml version=\"1.0\" foo=\"bar\"?><a/>", "xmldecl unknown pseudo-attr")
  must_fail("<?XML version=\"1.0\"?><a/>", "uppercase XML PI target")
  must_fail("<?Xml foo?><a/>", "mixed case Xml PI target")
  must_fail("<r><?xml foo?></r>", "xml PI inside element")
  must_fail("<?pi unclosed<r/>", "unclosed PI")
  must_fail("<?1pi?><r/>", "invalid PI target")
}

///|
test "invalid_comments_and_cdata" {
  must_fail("<!-- a -- b --><r/>", "double hyphen in comment")
  must_fail("<!---><r/>", "three hyphen comment")
  must_fail("<!-- a ---><r/>", "triple hyphen end comment")
  must_fail("<!-- unclosed<r/>", "unclosed comment")
  must_fail("<r>abc]]>def</r>", "cdata close seq in text")
  must_fail("<r><![CDATA[unclosed</r>", "unclosed cdata")
}

///|
test "invalid_entities_and_char_refs" {
  must_fail("<r>&unknown;</r>", "unknown entity in text")
  must_fail("<r a=\"&unknown;\"/>", "unknown entity in attr")
  must_fail("<r>&amp</r>", "unterminated entity")
  must_fail("<r>&;</r>", "empty entity")
  must_fail("<r>&#;</r>", "empty dec char ref")
  must_fail("<r>&#x;</r>", "empty hex char ref")
  must_fail("<r>&#X41;</r>", "uppercase X in hex char ref")
  must_fail("<r>&#0;</r>", "null char ref")
  must_fail("<r>&#x0;</r>", "hex null char ref")
  must_fail("<r>&#1;</r>", "SOH control char ref")
  must_fail("<r>&#xB;</r>", "VT control char ref")
  must_fail("<r>&#xC;</r>", "FF control char ref")
  must_fail("<r>&#x1F;</r>", "US control char ref")
  must_fail("<r>&#xD800;</r>", "high surrogate char ref")
  must_fail("<r>&#xDFFF;</r>", "low surrogate char ref")
  must_fail("<r>&#xFFFE;</r>", "FFFE char ref")
  must_fail("<r>&#xFFFF;</r>", "FFFF char ref")
  must_fail("<r>&#x110000;</r>", "out of range char ref")
  must_fail("<r>&#99999999999999999999;</r>", "overflow dec char ref")
  must_fail("<r>&#xFFFFFFFFFFFF;</r>", "overflow hex char ref")
}

///|
test "invalid_raw_control_chars" {
  must_fail("<r>\u{0000}</r>", "raw NUL")
  must_fail("<r>\u{0001}</r>", "raw SOH")
  must_fail("<r>\u{0008}</r>", "raw BS")
  must_fail("<r>\u{000B}</r>", "raw VT")
  must_fail("<r>\u{000C}</r>", "raw FF")
  must_fail("<r>\u{001F}</r>", "raw US")
  must_fail("<r>\u{FFFE}</r>", "raw FFFE")
  must_fail("<r>\u{FFFF}</r>", "raw FFFF")
  must_fail("<!--\u{0001}--><r/>", "raw ctrl in comment")
  must_fail("<r><![CDATA[\u{0001}]]></r>", "raw ctrl in cdata")
}

///|
test "invalid_dtd_rejected_by_default" {
  must_fail("<!DOCTYPE root><root/>", "dtd rejected by default")
  must_fail(
    "<!DOCTYPE root [ <!ENTITY a \"1\"> ]><root>&a;</root>",
    "internal dtd rejected by default",
  )
}
