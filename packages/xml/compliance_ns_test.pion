///| XML Namespaces 1.0 compliance tests (valid resolution + invalid namespace rejection).

fn ns_must_parse(src : String, label : String) -> Document {
  match Document::parse(src) {
    Ok(doc) => doc
    Err(e) => {
      debug_assert(false, label + ": unexpected error: " + e.to_string())
      Document::{
        src: "",
        strings: [],
        nodes: [],
        attrs: [],
        namespaces: [],
        root_elem_id: -1,
      }
    }
  }
}

fn ns_must_fail(src : String, label : String) -> Unit {
  match Document::parse(src) {
    Ok(_) => debug_assert(false, label + ": expected Err, got Ok")
    Err(e) => {
      match e.kind {
        XmlErrorKind::Unimplemented =>
        debug_assert(false, label + ": still Unimplemented")
        _ => ()
      }
    }
  }
}

fn ns_opt_eq(a : Option[String], b : String) -> Bool {
  match a {
    Some(s) => s == b
    None => false
  }
}

fn ns_opt_none(a : Option[String]) -> Bool {
  match a {
    None => true
    Some(_) => false
  }
}

///|
test "ns_default_and_unbind" {
  let src = "<root xmlns=\"urn:default\"><child><reset xmlns=\"\"><plain/></reset></child></root>"
  let doc = ns_must_parse(src, "default-unbind")
  let root = doc.root_element()
  debug_assert(ns_opt_eq(root.namespace(), "urn:default"), "root ns")
  debug_assert(root.has_tag_name_ns("urn:default", "root"), "root has_tag_name_ns")
  let child = match root.first_element_child() {
    Some(n) => n
    None => {
      debug_assert(false, "no child")
      return ()
    }
  }
  debug_assert(ns_opt_eq(child.namespace(), "urn:default"), "child inherits default ns")
  let reset = match child.first_element_child() {
    Some(n) => n
    None => {
      debug_assert(false, "no reset")
      return ()
    }
  }
  debug_assert(ns_opt_none(reset.namespace()), "reset unbound default ns")
  let plain = match reset.first_element_child() {
    Some(n) => n
    None => {
      debug_assert(false, "no plain")
      return ()
    }
  }
  debug_assert(ns_opt_none(plain.namespace()), "plain has no ns")
}

///|
test "ns_prefixed_shadowing_and_attributes" {
  let src = "<p:root xmlns=\"urn:def\" xmlns:p=\"urn:one\" a=\"1\" p:a=\"2\"><p:child xmlns:p=\"urn:two\" p:k=\"v\" u=\"x\"/></p:root>"
  let doc = ns_must_parse(src, "prefixed")
  let root = doc.root_element()
  debug_assert(root.tag_name().name() == "root", "root local")
  debug_assert(ns_opt_eq(root.tag_name().prefix(), "p"), "root prefix")
  debug_assert(ns_opt_eq(root.namespace(), "urn:one"), "root ns")
  // Unprefixed attribute does NOT inherit default namespace!
  debug_assert(ns_opt_eq(root.attribute("a"), "1"), "unprefixed attr a")
  debug_assert(ns_opt_eq(root.attribute_ns("urn:one", "a"), "2"), "prefixed attr p:a")
  debug_assert(ns_opt_none(root.attribute_ns("urn:def", "a")), "default ns does not apply to attr")
  debug_assert(root.attribute_count() == 2, "xmlns decls are not regular attributes")

  let child = match root.first_element_child() {
    Some(n) => n
    None => {
      debug_assert(false, "no child")
      return ()
    }
  }
  debug_assert(ns_opt_eq(child.namespace(), "urn:two"), "shadowed p ns")
  debug_assert(ns_opt_eq(child.attribute_ns("urn:two", "k"), "v"), "child p:k")
  debug_assert(ns_opt_eq(child.attribute("u"), "x"), "child u")
  debug_assert(
    ns_opt_eq(child.lookup_namespace_uri(Some("p")), "urn:two"),
    "lookup p",
  )
  debug_assert(
    ns_opt_eq(child.lookup_namespace_uri(None), "urn:def"),
    "lookup default",
  )
  debug_assert(
    ns_opt_eq(child.lookup_prefix("urn:two"), "p"),
    "lookup_prefix urn:two",
  )
}

///|
test "ns_builtin_xml_prefix" {
  let src = "<root xml:lang=\"en\" xml:space=\"preserve\"/>"
  let doc = ns_must_parse(src, "xml-prefix")
  let root = doc.root_element()
  let xml_uri = "http://www.w3.org/XML/1998/namespace"
  debug_assert(ns_opt_eq(root.attribute_ns(xml_uri, "lang"), "en"), "xml:lang")
  debug_assert(
    ns_opt_eq(root.attribute_ns(xml_uri, "space"), "preserve"),
    "xml:space",
  )
  debug_assert(
    ns_opt_eq(root.lookup_namespace_uri(Some("xml")), xml_uri),
    "lookup xml",
  )
  // Explicit valid binding of xml prefix is allowed
  let doc2 = ns_must_parse(
    "<root xmlns:xml=\"http://www.w3.org/XML/1998/namespace\" xml:id=\"i1\"/>",
    "xml-prefix-explicit",
  )
  debug_assert(
    ns_opt_eq(doc2.root_element().attribute_ns(xml_uri, "id"), "i1"),
    "explicit xml:id",
  )
}

///|
test "ns_invalid_cases" {
  // Unbound element prefix
  ns_must_fail("<p:root/>", "unbound elem prefix")
  // Unbound attribute prefix
  ns_must_fail("<root p:a=\"1\"/>", "unbound attr prefix")
  // Empty prefixed namespace URI (forbidden in XML Namespaces 1.0)
  ns_must_fail("<root xmlns:p=\"\"/>", "empty prefixed xmlns")
  // Duplicate expanded attribute name via different prefixes
  ns_must_fail(
    "<root xmlns:a=\"urn:x\" xmlns:b=\"urn:x\" a:k=\"1\" b:k=\"2\"/>",
    "duplicate expanded attr",
  )
  // Duplicate xmlns declaration
  ns_must_fail("<root xmlns=\"urn:a\" xmlns=\"urn:b\"/>", "dup default xmlns")
  ns_must_fail("<root xmlns:p=\"urn:a\" xmlns:p=\"urn:b\"/>", "dup prefixed xmlns")
  // Reserved xml / xmlns violations
  ns_must_fail("<root xmlns:xml=\"urn:wrong\"/>", "xml bound to wrong uri")
  ns_must_fail(
    "<root xmlns:other=\"http://www.w3.org/XML/1998/namespace\"/>",
    "other prefix bound to xml uri",
  )
  ns_must_fail("<root xmlns:xmlns=\"urn:any\"/>", "xmlns prefix declared")
  ns_must_fail(
    "<root xmlns:p=\"http://www.w3.org/2000/xmlns/\"/>",
    "prefix bound to xmlns uri",
  )
  ns_must_fail(
    "<root xmlns=\"http://www.w3.org/2000/xmlns/\"/>",
    "default bound to xmlns uri",
  )
  ns_must_fail("<xmlns:root/>", "element with xmlns prefix")
  // Invalid QNames
  ns_must_fail("<a:b:c/>", "multiple colons in elem")
  ns_must_fail("<:a/>", "leading colon in elem")
  ns_must_fail("<a:/>", "trailing colon in elem")
  ns_must_fail("<r a:b:c=\"1\"/>", "multiple colons in attr")
  ns_must_fail("<r :a=\"1\"/>", "leading colon in attr")
  ns_must_fail("<r a:=\"1\"/>", "trailing colon in attr")
  // Colon in PI target (forbidden by Namespaces 1.0)
  ns_must_fail("<?a:b data?><r/>", "colon in PI target")
}
