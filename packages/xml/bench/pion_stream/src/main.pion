///| Benchmark 2: Streaming Pull Parse (5 steady-state rounds).

import "xml"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 {
    args[1]
  } else {
    "/tmp/pion-xml-bench/mixed_corpus.xml"
  }
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }
  let rounds = 10
  let mut starts : Int64 = 0L
  let mut empties : Int64 = 0L
  let mut ends : Int64 = 0L
  let mut texts : Int64 = 0L
  let mut cdatas : Int64 = 0L
  let mut comments : Int64 = 0L
  let mut pis : Int64 = 0L
  let mut decls : Int64 = 0L
  let mut attrs : Int64 = 0L
  let mut name_bytes : Int64 = 0L
  let mut text_bytes : Int64 = 0L

  let mut r = 0
  while r < rounds {
    let reader = xml::Reader::new(src)
    let mut done = false
    while !done {
      match reader.next_event() {
        Ok(xml::Event::StartElement(se)) => {
          starts = starts + 1L
          name_bytes = name_bytes + (se.name_end - se.name_start).to_int64()
          attrs = attrs + se.raw_attrs.length().to_int64()
        }
        Ok(xml::Event::EmptyElement(ee)) => {
          empties = empties + 1L
          name_bytes = name_bytes + (ee.name_end - ee.name_start).to_int64()
          attrs = attrs + ee.raw_attrs.length().to_int64()
        }
        Ok(xml::Event::EndElement(end)) => {
          ends = ends + 1L
          name_bytes = name_bytes + (end.name_end - end.name_start).to_int64()
        }
        Ok(xml::Event::Text(t)) => {
          texts = texts + 1L
          text_bytes = text_bytes + t.length().to_int64()
        }
        Ok(xml::Event::CData(c)) => {
          cdatas = cdatas + 1L
          text_bytes = text_bytes + c.length().to_int64()
        }
        Ok(xml::Event::Comment(_)) => comments = comments + 1L
        Ok(xml::Event::ProcessingInstruction(_)) => pis = pis + 1L
        Ok(xml::Event::XmlDecl(_)) => decls = decls + 1L
        Ok(xml::Event::DocType(_)) => ()
        Ok(xml::Event::Eof) => done = true
        Err(e) => {
          io_println(world, "stream error: " + e.to_string())
          return 1
        }
      }
    }
    r = r + 1
  }

  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "starts=" + starts.to_string())
  io_println(world, "empties=" + empties.to_string())
  io_println(world, "ends=" + ends.to_string())
  io_println(world, "texts=" + texts.to_string())
  io_println(world, "cdatas=" + cdatas.to_string())
  io_println(world, "comments=" + comments.to_string())
  io_println(world, "pis=" + pis.to_string())
  io_println(world, "decls=" + decls.to_string())
  io_println(world, "attrs=" + attrs.to_string())
  io_println(world, "name_bytes=" + name_bytes.to_string())
  io_println(world, "text_bytes=" + text_bytes.to_string())
  0
}
