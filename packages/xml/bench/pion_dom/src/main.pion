///| Benchmark 1: DOM Parse + Full Tree Traverse (5 steady-state rounds).

import "xml"

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let path = if args.length() > 1 {
    args[1]
  } else {
    "/tmp/pion-xml-bench/mixed_corpus.xml"
  }
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }
  let rounds = 10
  let mut elements : Int64 = 0L
  let mut text_nodes : Int64 = 0L
  let mut comments : Int64 = 0L
  let mut pis : Int64 = 0L
  let mut attrs : Int64 = 0L
  let mut ns_elems : Int64 = 0L
  let mut tag_bytes : Int64 = 0L
  let mut attr_val_bytes : Int64 = 0L
  let mut text_bytes : Int64 = 0L

  let mut r = 0
  while r < rounds {
    let doc = match xml::Document::parse(src) {
      Ok(d) => d
      Err(e) => {
        io_println(world, "parse error: " + e.to_string())
        return 1
      }
    }
    let n = doc.node_count()
    let mut i = 0
    while i < n {
      let k = doc.node_kind_at(i)
      if k == 1 {
        elements = elements + 1L
        tag_bytes = tag_bytes + doc.tag_name_len_at(i).to_int64()
        if doc.has_namespace_at(i) {
          ns_elems = ns_elems + 1L
        }
        let (a_start, a_end) = doc.attrs_range_at(i)
        attrs = attrs + (a_end - a_start).to_int64()
        let mut j = a_start
        while j < a_end {
          attr_val_bytes = attr_val_bytes + doc.attr_value_len_raw(j).to_int64()
          j = j + 1
        }
      } else if k == 2 {
        text_nodes = text_nodes + 1L
        text_bytes = text_bytes + doc.text_len_at(i).to_int64()
      } else if k == 3 {
        comments = comments + 1L
      } else if k == 4 {
        pis = pis + 1L
      }
      i = i + 1
    }
    r = r + 1
  }

  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "elements=" + elements.to_string())
  io_println(world, "text_nodes=" + text_nodes.to_string())
  io_println(world, "comments=" + comments.to_string())
  io_println(world, "pis=" + pis.to_string())
  io_println(world, "attributes=" + attrs.to_string())
  io_println(world, "ns_elements=" + ns_elems.to_string())
  io_println(world, "tag_name_bytes=" + tag_bytes.to_string())
  io_println(world, "attr_val_bytes=" + attr_val_bytes.to_string())
  io_println(world, "text_bytes=" + text_bytes.to_string())
  0
}
