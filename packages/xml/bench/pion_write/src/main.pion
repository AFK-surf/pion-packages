///| Benchmark 3: Structured XML Serialization (5 steady-state rounds x 3,000 items).

import "xml"

///|
pub fn main(world : World) -> Int {
  let rounds = 5
  let items = 3000
  let mut total_bytes : Int64 = 0L
  let mut hash : Int64 = 0L
  let mut sample = ""

  let mut r = 0
  while r < rounds {
    let w = xml::Writer::with_capacity(1024 * 1024)
    let _ = w.write_xml_decl("1.0", Some("UTF-8"), None)
    let _ = w.write_start_element("catalog", [("xmlns", "urn:pion:catalog"), ("version", "1.0")])
    let mut i = 0
    while i < items {
      let id_s = i.to_string()
      let _ = w.write_start_element(
        "item",
        [
          ("id", id_s),
          ("category", "books & media"),
          ("title", "Item <" + id_s + "> \"quoted\""),
        ],
      )
      let _ = w.write_start_element("summary", [])
      let _ = w.write_text("Fast pure-Pion XML writer & serializer for record #" + id_s + " <ok>")
      let _ = w.write_end_element("summary")
      let _ = w.write_empty_element("meta", [("rank", id_s), ("active", "true")])
      let _ = w.write_comment(" end item " + id_s + " ")
      let _ = w.write_end_element("item")
      i = i + 1
    }
    let _ = w.write_end_element("catalog")
    let out = w.into_string()
    let olen = out.length()
    total_bytes = total_bytes + olen.to_int64()
    if r == 0 {
      sample = out.slice(0, 160)
    }
    let mut j = 0
    while j < olen {
      hash = (hash * 131L + out.code_unit_at(j).to_int64()) % 1000000007L
      j = j + 1
    }
    r = r + 1
  }

  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "hash=" + hash.to_string())
  io_println(world, "sample=" + sample)
  0
}
