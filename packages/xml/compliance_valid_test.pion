///| W3C XML 1.0 (Fifth Edition) & roxmltree valid compliance tests.

fn must_parse(src : String, label : String) -> Document {
  match Document::parse(src) {
    Ok(doc) => doc
    Err(e) => {
      debug_assert(false, label + ": unexpected error: " + e.to_string())
      Document::{
        src: "",
        strings: [],
        nodes: [],
        attrs: [],
        namespaces: [],
        root_elem_id: -1,
      }
    }
  }
}

fn must_parse_opts(
  src : String,
  opts : ParseOptions,
  label : String,
) -> Document {
  match Document::parse_with_options(src, opts) {
    Ok(doc) => doc
    Err(e) => {
      debug_assert(false, label + ": unexpected error: " + e.to_string())
      Document::{
        src: "",
        strings: [],
        nodes: [],
        attrs: [],
        namespaces: [],
        root_elem_id: -1,
      }
    }
  }
}

fn opt_str_eq(a : Option[String], b : String) -> Bool {
  match a {
    Some(s) => s == b
    None => false
  }
}

fn opt_is_none(a : Option[String]) -> Bool {
  match a {
    None => true
    Some(_) => false
  }
}

///|
test "valid_minimal_empty_element" {
  let doc = must_parse("<a/>", "empty")
  let root = doc.root_element()
  debug_assert(root.is_element(), "root is element")
  debug_assert(root.tag_name().name() == "a", "tag name is a")
  debug_assert(root.has_tag_name("a"), "has_tag_name a")
  debug_assert(!root.has_children(), "no children")
  debug_assert(opt_is_none(root.text()), "no text")
}

///|
test "valid_minimal_start_end_element" {
  let doc = must_parse("<a></a>", "start-end")
  let root = doc.root_element()
  debug_assert(root.tag_name().name() == "a", "tag name is a")
  debug_assert(!root.has_children(), "no children")
}

///|
test "valid_xml_decl_variants" {
  let d1 = must_parse("<?xml version=\"1.0\"?><a/>", "decl1")
  debug_assert(d1.root_element().tag_name().name() == "a", "decl1 root")

  let d2 = must_parse(
    "<?xml version='1.0' encoding='UTF-8' standalone='yes'?>\n<a/>",
    "decl2",
  )
  debug_assert(d2.root_element().tag_name().name() == "a", "decl2 root")

  let d3 = must_parse(
    "<?xml version = \"1.0\" encoding = \"utf-8\" standalone = \"no\" ?><a/>",
    "decl3",
  )
  debug_assert(d3.root_element().tag_name().name() == "a", "decl3 root")
}

///|
test "valid_utf8_bom" {
  let src = "\u{FEFF}<?xml version=\"1.0\" encoding=\"UTF-8\"?><root>ok</root>"
  let doc = must_parse(src, "bom")
  debug_assert(doc.root_element().tag_name().name() == "root", "bom root")
  debug_assert(opt_str_eq(doc.root_element().text(), "ok"), "bom text")
}

///|
test "valid_prolog_and_epilog_misc" {
  let src = "<?xml version=\"1.0\"?>\n<!-- before -->\n<?pi-before val?>\n  <root>hi</root>\n<!-- after -->\n<?pi-after?>\n  "
  let doc = must_parse(src, "misc")
  let children = doc.root().children()
  debug_assert(children.length() == 5, "5 top-level nodes (comment, pi, elem, comment, pi)")
  debug_assert(children[0].is_comment(), "0 is comment")
  debug_assert(opt_str_eq(children[0].text(), " before "), "comment 0 text")
  debug_assert(children[1].is_pi(), "1 is pi")
  match children[1].pi() {
    Some(pi) => {
      debug_assert(pi.target == "pi-before", "pi target")
      debug_assert(opt_str_eq(pi.value, "val"), "pi value")
    }
    None => debug_assert(false, "expected pi")
  }
  debug_assert(children[2].is_element(), "2 is element")
  debug_assert(children[3].is_comment(), "3 is comment")
  debug_assert(children[4].is_pi(), "4 is pi")
  match children[4].pi() {
    Some(pi) => {
      debug_assert(pi.target == "pi-after", "pi4 target")
      debug_assert(opt_is_none(pi.value), "pi4 value none")
    }
    None => debug_assert(false, "expected pi4")
  }
}

///|
test "valid_attributes_quotes_and_normalization" {
  let src = "<e a='single' b=\"double\" c=\"tab\there\nline\r\ncr\rend\" d=\"&#x9;&#xA;&#xD;\" e=\"&lt;&gt;&amp;&quot;&apos;\"/>"
  let doc = must_parse(src, "attrs")
  let r = doc.root_element()
  debug_assert(r.attribute_count() == 5, "5 attributes")
  debug_assert(opt_str_eq(r.attribute("a"), "single"), "attr a")
  debug_assert(opt_str_eq(r.attribute("b"), "double"), "attr b")
  // XML 1.0 §3.3.3: literal \t, \n, \r\n, \r in attr values become single space 0x20
  debug_assert(opt_str_eq(r.attribute("c"), "tab here line cr end"), "attr c normalized")
  // Character references preserve \t, \n, \r
  debug_assert(opt_str_eq(r.attribute("d"), "\t\n\r"), "attr d char refs preserved")
  debug_assert(opt_str_eq(r.attribute("e"), "<>&\"'"), "attr e entities")
  debug_assert(r.has_attribute("a"), "has_attribute a")
  debug_assert(!r.has_attribute("missing"), "not has_attribute missing")
}

///|
test "valid_eol_normalization_text_cdata_comment_pi" {
  let src = "<r>a\r\nb\rc<![CDATA[x\r\ny\rz]]><!--c\r\nd\re--><?p v\r\nw\rx?></r>"
  let doc = must_parse(src, "eol")
  let r = doc.root_element()
  let ch = r.children()
  // Adjacent text + CDATA merged into one Text node (roxmltree semantics)
  debug_assert(ch.length() == 3, "merged text + comment + pi")
  debug_assert(ch[0].is_text(), "ch[0] text")
  debug_assert(opt_str_eq(ch[0].text(), "a\nb\ncx\ny\nz"), "merged text + cdata EOL normalized")
  debug_assert(ch[1].is_comment(), "ch[1] comment")
  debug_assert(opt_str_eq(ch[1].text(), "c\nd\ne"), "comment EOL normalized")
  debug_assert(ch[2].is_pi(), "ch[2] pi")
  match ch[2].pi() {
    Some(pi) => debug_assert(opt_str_eq(pi.value, "v\nw\nx"), "pi EOL normalized")
    None => debug_assert(false, "expected pi")
  }
}

///|
test "valid_entities_and_char_refs" {
  let src = "<r>&lt;&gt;&amp;&quot;&apos;&#65;&#x42;&#x0043;&#x1F600;&#9;&#10;&#13;</r>"
  let doc = must_parse(src, "entities")
  debug_assert(
    opt_str_eq(doc.root_element().text(), "<>&\"'ABC\u{1F600}\t\n\r"),
    "entities and char refs",
  )
}

///|
test "valid_cdata_special_chars" {
  let src = "<r><![CDATA[<tag>&amp;\"']]>mid<![CDATA[]]]]>tail</r>"
  let doc = must_parse(src, "cdata")
  debug_assert(
    opt_str_eq(doc.root_element().text(), "<tag>&amp;\"'mid]]tail"),
    "cdata contents merged",
  )
}

///|
test "valid_unicode_names_and_content" {
  let src = "<数据 版本=\"一\">你好世界 🌍 <Ελληνικά _id=\"α1\">Ω</Ελληνικά></数据>"
  let doc = must_parse(src, "unicode")
  let r = doc.root_element()
  debug_assert(r.tag_name().name() == "数据", "cjk tag")
  debug_assert(opt_str_eq(r.attribute("版本"), "一"), "cjk attr")
  match r.first_element_child() {
    Some(c) => {
      debug_assert(c.tag_name().name() == "Ελληνικά", "greek tag")
      debug_assert(opt_str_eq(c.attribute("_id"), "α1"), "greek attr")
      debug_assert(opt_str_eq(c.text(), "Ω"), "greek text")
    }
    None => debug_assert(false, "expected greek child")
  }
}

///|
test "valid_dom_navigation_tree" {
  let src = "<root><a id='1'>one</a><!--c--><b id='2'><c>two</c><d/></b></root>"
  let doc = must_parse(src, "nav")
  let root = doc.root_element()
  debug_assert(root.parent().is_some(), "root elem parent is doc root")
  let ch = root.children()
  debug_assert(ch.length() == 3, "3 children of root")
  let a = match root.first_child() {
    Some(n) => n
    None => {
      debug_assert(false, "no first child")
      return ()
    }
  }
  debug_assert(a.tag_name().name() == "a", "first child a")
  debug_assert(opt_str_eq(a.text(), "one"), "a text")
  let b = match a.next_sibling_element() {
    Some(n) => n
    None => {
      debug_assert(false, "no next sibling element")
      return ()
    }
  }
  debug_assert(b.tag_name().name() == "b", "next sibling element b")
  match root.last_child() {
    Some(lc) => debug_assert(lc.id() == b.id(), "last child is b")
    None => debug_assert(false, "no last child")
  }
  match b.prev_sibling() {
    Some(ps) => debug_assert(ps.is_comment(), "prev sibling of b is comment")
    None => debug_assert(false, "no prev sibling")
  }
  let desc = root.descendants()
  // root, a, "one", comment, b, c, "two", d => 8 nodes
  debug_assert(desc.length() == 8, "8 descendants including self")
}

///|
test "valid_internal_dtd_entities_when_allowed" {
  let src = "<!DOCTYPE doc [ <!ENTITY greet \"Hello &who;\"> <!ENTITY who \"Pion\"> ]><doc attr=\"&greet;\">&greet;!</doc>"
  let opts = ParseOptions::{ allow_dtd: true, limits: Limits::default() }
  let doc = must_parse_opts(src, opts, "internal-dtd")
  let r = doc.root_element()
  debug_assert(opt_str_eq(r.attribute("attr"), "Hello Pion"), "attr entity expanded")
  debug_assert(opt_str_eq(r.text(), "Hello Pion!"), "text entity expanded")
}

///|
test "valid_dtd_empty_or_declarations_when_allowed" {
  let src = "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\"><html><body>ok</body></html>"
  let opts = ParseOptions::{ allow_dtd: true, limits: Limits::default() }
  let doc = must_parse_opts(src, opts, "doctype-public")
  debug_assert(doc.root_element().tag_name().name() == "html", "html root")
}
