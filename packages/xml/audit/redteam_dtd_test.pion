///| DTD / internal-entity red-team tests for `xml` (allow_dtd = true). Each P-test asserts the
///| XML 1.0 §4.4/§4.5 behaviour that roxmltree 0.21.2 and the W3C suite expect.

import "xml"

///| P1-1: an internal entity's replacement text is *content* (§4.4.2 "Included"): markup inside it
///| must become elements. pion returns the literal string "<p/>" as text.
test "p1_entity_markup_is_parsed_as_elements" {
  let src = "<!DOCTYPE r [<!ENTITY p \"<p a='1'>x</p>\">]><r>&p;</r>"
  debug_assert(
    dtd_element_count(src) == 2,
    "expected <r><p a='1'>x</p></r>; got text " + show(dtd_text(src)),
  )
}

///| P1-2: replacement text must be balanced (§4.3.2 WFC "Parsed Entity"). W3C not-wf-sa-074.
test "p1_entity_unbalanced_markup_rejected" {
  debug_assert(
    !dtd_ok("<!DOCTYPE d [<!ENTITY e \"</foo><foo>\">]><d><foo>&e;</foo></d>"),
    "not-wf-sa-074 accepted",
  )
  debug_assert(!dtd_ok("<!DOCTYPE r [<!ENTITY p '</p>'>]><r>&p;</r>"), "roxmltree entity_err_003 accepted")
  debug_assert(!dtd_ok("<!DOCTYPE r [<!ENTITY p '<p>'>]><r>&p;</r>"), "unclosed start tag in entity accepted")
}

///| P1-3: a char reference in an entity *value* is expanded at declaration time (§4.5), so
///| `<!ENTITY e "&#60;">` puts a literal '<' into the replacement text, which is forbidden in an
///| attribute value (§3.1 WFC "No < in Attribute Values"). W3C not-wf-sa-090 shape.
test "p1_entity_charref_lt_in_attribute_rejected" {
  debug_assert(
    !dtd_ok("<!DOCTYPE a [<!ENTITY e \"&#60;\">]><a k=\"&e;\"/>"),
    "attribute received a raw '<' via entity",
  )
}

///| Control: a literal '<' in the replacement text used in an attribute is rejected.
test "control_entity_literal_lt_in_attribute_rejected" {
  debug_assert(!dtd_ok("<!DOCTYPE a [<!ENTITY e \"a<b\">]><a k=\"&e;\"/>"), "accepted")
}

///| P1-5: entity values are not checked against Char (§2.2): U+0001 reaches the DOM.
test "p1_entity_value_illegal_char_rejected" {
  let src = "<!DOCTYPE a [<!ENTITY e \"\u{1}\">]><a>&e;</a>"
  debug_assert(!dtd_ok(src), "U+0001 delivered as text " + show(dtd_text(src)))
}

///| P1-6: `]]>` delivered through an entity is CharData containing ']]>' (§2.4) — roxmltree rejects.
test "p1_entity_value_cdata_end_in_content_rejected" {
  debug_assert(!dtd_ok("<!DOCTYPE a [<!ENTITY e \"]]>\">]><a>&e;</a>"), "accepted ']]>' text")
}

///| P1-7: W3C valid-sa-114: a CDATA section inside replacement text is valid; its `&foo;` is data.
///| pion re-scans the CDATA body as text and fails with UnknownEntity.
test "p1_entity_with_cdata_section_is_valid" {
  let src = "<!DOCTYPE doc [<!ENTITY e \"<![CDATA[&foo;]]>\">]><doc>&e;</doc>"
  debug_assert(dtd_text(src) == "&foo;", "got " + show(dtd_text(src)))
}

///| P1-8: §3.3.3: whitespace *characters* in replacement text are normalised to #x20 in
///| attributes, including ones that came from char refs in the entity value (W3C valid-sa-110,
///| roxmltree entity_003). pion keeps the raw CR/LF/TAB.
test "p1_entity_replacement_whitespace_normalised_in_attribute" {
  let v = dtd_root_attr("<!DOCTYPE a [<!ENTITY e \"&#13;&#10;\">]><a k=\"x&e;y\"/>", "k")
  debug_assert(v == "x  y", "valid-sa-110: got " + show(v))
  let t = dtd_root_attr("<!DOCTYPE a [<!ENTITY e \"x&#9;y\">]><a k=\"&e;\"/>", "k")
  debug_assert(t == "x y", "tab via entity: got " + show(t))
}

///| Control: char refs written directly in the attribute keep their exact code points (§3.3.3).
test "control_direct_charref_whitespace_preserved_in_attribute" {
  match xml::Document::parse("<a k=\"&#x9;&#xA;&#xD;\" j=\"\t\n\r\n\"/>") {
    Ok(doc) => {
      let r = doc.root_element()
      let k = match r.attribute("k") {
        Some(v) => v
        None => ""
      }
      let j = match r.attribute("j") {
        Some(v) => v
        None => ""
      }
      debug_assert(k == "\t\n\r", "k=" + show(k))
      debug_assert(j == "   ", "j=" + show(j))
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| P2-1: an entity whose replacement text is empty yields an empty Text node in the DOM (W3C
///| valid-sa-023 / rmt-e2e-15a); roxmltree and pion's own Reader produce no text.
test "p2_empty_entity_creates_no_text_node" {
  match xml::Document::parse_with_options("<!DOCTYPE a [<!ENTITY e \"\">]><a>&e;</a>", dtd_opts()) {
    Ok(doc) =>
    debug_assert(
      !doc.root_element().has_children(),
      "<a>&e;</a> with empty e has " +
      doc.root_element().children().length().to_string() +
      " child (empty text node)",
    )
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| P2-2: declaring (not referencing) an external or unparsed entity, or a parameter entity, is
///| well-formed and harmless; pion rejects the whole document (14 W3C valid/invalid cases, e.g.
///| valid-sa-082, o-p75pass1, valid-sa-091). Referencing it must still fail (control below).
test "p2_unreferenced_external_entity_declaration_accepted" {
  debug_assert(
    dtd_ok("<!DOCTYPE d [<!ENTITY ent SYSTEM \"nop.ent\">]><d/>"),
    "o-p75pass1 shape rejected",
  )
  debug_assert(
    dtd_ok("<!DOCTYPE d [<!NOTATION n SYSTEM \"x\"><!ENTITY e SYSTEM \"x\" NDATA n>]><d/>"),
    "valid-sa-091 shape (unparsed entity) rejected",
  )
  debug_assert(dtd_ok("<!DOCTYPE d [<!ENTITY % e SYSTEM \"e.dtd\">]><d/>"), "valid-sa-082 shape rejected")
}

///|
test "control_external_entity_reference_rejected" {
  debug_assert(!dtd_ok("<!DOCTYPE d [<!ENTITY ent SYSTEM \"nop.ent\">]><d>&ent;</d>"), "XXE")
  debug_assert(!dtd_ok("<!DOCTYPE d [<!ENTITY ent SYSTEM \"nop.ent\">]><d k=\"&ent;\"/>"), "XXE attr")
}

///| P2-3: the internal-subset scanner skips any `<!...>` it does not know: unknown keywords,
///| lowercase keywords, conditional sections and missing required whitespace are accepted
///| (W3C not-wf-sa-063/107, o-p29fail1, o-p45fail1, o-p71fail1/3, ibm45n08/09, ibm52n04, ibm75n07/09).
test "p2_dtd_unknown_or_malformed_declarations_rejected" {
  let bad = [
    "<!DOCTYPE d [<!DUNNO x>]><d/>", "<!DOCTYPE d [<!element d EMPTY>]><d/>", "<!DOCTYPE d [<!Attlist d a CDATA #IMPLIED>]><d/>",
    "<!DOCTYPE d [<![INCLUDE[ ]]>]><d/>", "<!DOCTYPE d [<![CDATA[]]>]><d/>", "<!DOCTYPE d [<!ENTITY e\"x\">]><d/>",
    "<!DOCTYPE d [<! ENTITY e \"x\">]><d/>", "<!DOCTYPE d PUBLIC \"-//W3C//DTD//EN\"\"e.dtd\"><d/>", "<!DOCTYPE d PUBLIC\"-//W3C//DTD//EN\" \"e.dtd\"><d/>",
  ]
  let accepted : Array[String] = []
  let mut i = 0
  while i < bad.length() {
    if dtd_ok(bad[i]) {
      accepted.push(bad[i])
    }
    i = i + 1
  }
  debug_assert(
    accepted.length() == 0,
    accepted.length().to_string() +
    "/" +
    bad.length().to_string() +
    " not-wf DTDs accepted, first: " +
    (if accepted.length() > 0 { accepted[0] } else { "" }),
  )
}

///| P2-4: two-level escaping (§4.5 / spec Appendix D): `&#38;#60;` in an entity value becomes
///| `&#60;` in the replacement text, which is then parsed as a char ref -> "<". pion (and
///| roxmltree) return the literal "&#60;".
test "p2_entity_double_escaped_charref_reparsed" {
  let t = dtd_text("<!DOCTYPE a [<!ENTITY e \"1 &#38;#60; 2\">]><a>&e;</a>")
  debug_assert(t == "1 < 2", "got " + show(t))
}

///| Control: char-ref-produced CR inside an internal entity survives into text content
///| (W3C valid-sa-068; roxmltree turns it into LF — pion is right here).
test "control_entity_charref_cr_preserved_in_text" {
  let t = dtd_text("<!DOCTYPE doc [<!ENTITY e \"&#13;\">]><doc>&e;</doc>")
  debug_assert(t == "\r", "got " + show(t))
}
