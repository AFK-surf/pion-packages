///| Well-formedness, normalisation and character-level red-team tests for `xml`
///| (default options; mostly controls that pion passes and roxmltree 0.21.2 partly fails).

import "xml"

///| Build a String from raw bytes (lets tests inject invalid UTF-8).
fn bytes_str(parts : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < parts.length() {
    sb.write_byte(parts[i].to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Control: non-well-formed documents from the brief are all rejected (DOM and Reader).
test "control_not_wellformed_rejected" {
  let bad = [
    "<a>x]]>y</a>", "<a k=\"<\"/>", " <?xml version=\"1.0\"?><a/>", "<!--c--><?xml version=\"1.0\"?><a/>",
    "<?xml version=\"1.0\" encoding=\"8bit\"?><a/>", "<?xml version=\"1.0\" encoding=\"\"?><a/>",
    "<?xml version=\"1.0\" standalone=\"YES\"?><a/>", "<?xml version=\"1.0\" standalone=\"maybe\"?><a/>",
    "<a/><b/>", "<a/>x", "x<a/>", "<a><!-- x---></a>", "<a><!-- a -- b --></a>", "<?XML x?><a/>",
    "<?xMl x?><a/>", "<a><?xml x?></a>", "<?a:b?><a/>", "<a>&#99999999999999999999;</a>",
    "<a>&#4294967361;</a>", "<a>&#18446744073709551681;</a>", "<a>&#x100000041;</a>",
    "<a>&#x10000000000000041;</a>", "<a>&#x110000;</a>", "<a>&#xD800;</a>", "<a>&#0;</a>",
    "<a>&#X41;</a>", "<a>&#x;</a>", "<a k=\"&#x110000;\"/>", "<\u{300}a/>", "<a \u{300}k=\"1\"/>",
    "<a>1 < 2</a>", "<a>1 & 2</a>", "<a k=\"1\" k=\"2\"/>", "<a></A>", "<a", "<a>", "<a></a  x>",
    "<![CDATA[x]]><a/>", "<a/>&#32;", "",
  ]
  let mut i = 0
  while i < bad.length() {
    debug_assert(!dom_ok(bad[i]), "DOM accepted " + show(bad[i]))
    debug_assert(!reader_ok(bad[i]), "Reader accepted " + show(bad[i]))
    i = i + 1
  }
}

///| Control: invalid UTF-8 (overlong '<', surrogates, > U+10FFFF, truncated) is rejected.
test "control_invalid_utf8_rejected" {
  let seqs : Array[Array[Int]] = [
    [0xC0, 0xBC], [0xE0, 0x80, 0xBC], [0xF0, 0x80, 0x80, 0xBC], [0xED, 0xA0, 0x80], [0xF4, 0x90, 0x80, 0x80],
    [0xFF], [0x80], [0xC3], [0xE2, 0x82],
  ]
  let mut i = 0
  while i < seqs.length() {
    let text = "<a>" + bytes_str(seqs[i]) + "</a>"
    let attr = "<a k=\"" + bytes_str(seqs[i]) + "\"/>"
    let name = "<a" + bytes_str(seqs[i]) + "/>"
    debug_assert(!dom_ok(text) && !dom_ok(attr) && !dom_ok(name), "UTF-8 seq #" + i.to_string())
    debug_assert(!reader_ok(text) && !reader_ok(attr), "Reader UTF-8 seq #" + i.to_string())
    i = i + 1
  }
}

///| Control: U+0300 is a NameChar but not a NameStartChar; U+00B7 likewise; U+037E never.
test "control_unicode_name_boundaries" {
  debug_assert(dom_ok("<a\u{300}/>"), "U+0300 as NameChar")
  debug_assert(!dom_ok("<\u{300}/>"), "U+0300 as NameStartChar")
  debug_assert(dom_ok("<a\u{B7}/>"), "U+00B7 as NameChar")
  debug_assert(!dom_ok("<\u{B7}/>"), "U+00B7 as NameStartChar")
  debug_assert(!dom_ok("<a\u{37E}/>"), "U+037E")
  debug_assert(dom_ok("<\u{10000}/>"), "U+10000")
  debug_assert(!dom_ok("<\u{F0000}/>"), "U+F0000")
}

///| Control: EOL normalisation applies to *every* construct (§2.11) — roxmltree leaves CR in
///| comments and PIs, pion normalises (correct).
test "control_eol_normalised_in_all_constructs" {
  match xml::Document::parse("<a>x\r\ny\rz<![CDATA[\r\n\r]]><!--c\r\nd\re--><?t p\r\nq\rr?></a>") {
    Ok(doc) => {
      let kids = doc.root_element().children()
      debug_assert(kids.length() == 3, "text, comment, pi")
      debug_assert(
        match kids[0].text() {
          Some(t) => t == "x\ny\nz\n\n"
          None => false
        },
        "text+cdata",
      )
      debug_assert(
        match kids[1].text() {
          Some(t) => t == "c\nd\ne"
          None => false
        },
        "comment",
      )
      debug_assert(
        match kids[2].pi() {
          Some(p) =>
          match p.value {
            Some(v) => v == "p\nq\nr"
            None => false
          }
          None => false
        },
        "pi",
      )
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| P2-5: XML 1.0 *Fifth Edition* §2.8: VersionNum is '1.' [0-9]+ and a 1.0 processor must
///| accept 1.x documents (W3C x-rmt-008b, `version="1.7"`). pion only accepts "1.0".
test "p2_fifth_edition_version_1x_accepted" {
  debug_assert(dom_ok("<?xml version=\"1.7\"?><a/>"), "version 1.7 rejected")
  debug_assert(reader_ok("<?xml version=\"1.1\"?><a/>"), "Reader: version 1.1 rejected")
  debug_assert(!dom_ok("<?xml version=\"2.0\"?><a/>"), "2.0 must stay rejected")
}

///| P2-6: the Reader hands out a `StartElement` event for a start tag that never terminates
///| (`<a` / `<a k="1"` at EOF) and only errors on the *next* call; consumers act on a tag the
///| DOM rejects.
test "p2_reader_truncated_start_tag_errors_immediately" {
  let r = xml::Reader::new("<a k=\"1\"")
  match r.next_event() {
    Ok(xml::Event::StartElement(_)) => debug_assert(false, "StartElement emitted for unterminated <a k=\"1\"")
    Ok(_) => debug_assert(false, "unexpected event")
    Err(_) => ()
  }
}
