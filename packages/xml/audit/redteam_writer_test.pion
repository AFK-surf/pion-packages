///| `Writer` injection / round-trip red-team tests for `xml`.

import "xml"

///| Control: names that would break out of markup are refused (element, attribute, PI target).
test "control_writer_rejects_injection_names" {
  let bad = ["a b", "a>", "a<", "a\"", "a=", "a/", "1a", "-a", ":a", "a:", "a:b:c", "", "a\u{0}", "a&"]
  let mut i = 0
  while i < bad.length() {
    let w = xml::Writer::new()
    debug_assert(w.write_start_element(bad[i], []).is_err(), "start " + show(bad[i]))
    debug_assert(w.write_empty_element("a", [(bad[i], "v")]).is_err(), "attr " + show(bad[i]))
    debug_assert(w.write_pi(bad[i], None).is_err() || bad[i] == "a:", "pi " + show(bad[i]))
    i = i + 1
  }
}

///| Control: content that cannot be represented is refused or escaped.
test "control_writer_rejects_or_escapes_content" {
  let w = xml::Writer::new()
  debug_assert(w.write_cdata("a]]>b").is_err(), "cdata ]]>")
  debug_assert(w.write_comment("a--b").is_err(), "comment --")
  debug_assert(w.write_comment("a-").is_err(), "comment trailing -")
  debug_assert(w.write_pi("t", Some("a?>b")).is_err(), "pi ?>")
  debug_assert(w.write_pi("xml", None).is_err(), "pi xml")
  debug_assert(w.write_pi("XmL", None).is_err(), "pi XmL")
  debug_assert(w.write_text("\u{1}").is_err(), "text U+0001")
  debug_assert(w.write_text("\u{FFFE}").is_err(), "text U+FFFE")
  debug_assert(w.write_end_element("a").is_err(), "end without start")
  let w2 = xml::Writer::new()
  let _ = w2.write_start_element("a", [("k", "<&>\"'\t\n\r")])
  let _ = w2.write_text("x]]>y<&")
  let _ = w2.write_end_element("a")
  let out = w2.into_string()
  match xml::Document::parse(out) {
    Ok(doc) => {
      let r = doc.root_element()
      debug_assert(
        match r.attribute("k") {
          Some(v) => v == "<&>\"'\t\n\r"
          None => false
        },
        "attr roundtrip " + out,
      )
      debug_assert(
        match r.text() {
          Some(t) => t == "x]]>y<&"
          None => false
        },
        "text roundtrip " + out,
      )
    }
    Err(e) => debug_assert(false, "reparse " + out + ": " + e.to_string())
  }
}

///| P1-9: `write_start_element` / `write_empty_element` do not check for duplicate attribute
///| names, so the "strict" Writer emits a non-well-formed document.
test "p1_writer_duplicate_attribute_rejected" {
  let w = xml::Writer::new()
  let res = w.write_empty_element("a", [("k", "1"), ("k", "2")])
  let out = w.into_string()
  debug_assert(res.is_err() || dom_ok(out), "wrote non-well-formed " + out)
}

///| P1-10: on a bad attribute name/value the Writer has already emitted `<name ...` and returns
///| Err without rolling back: the buffer now holds a dangling, unclosed start tag that is not
///| tracked by `tag_stack`; subsequent writes produce corrupt XML.
test "p1_writer_error_leaves_no_partial_output" {
  let w = xml::Writer::new()
  let _ = w.write_start_element("root", [])
  let before = w.sb.to_string()
  let res = w.write_empty_element("item", [("ok", "1"), ("bad name", "x")])
  debug_assert(res.is_err(), "bad name must be refused")
  let after = w.sb.to_string()
  debug_assert(after == before, "buffer changed on error: " + show(after))
}

///| P2-7: namespace well-formedness is not checked by the Writer (`xmlns:xml` rebinding,
///| `xmlns:xmlns`, `xmlns:p=""`, duplicate expanded names) — output is rejected by its own DOM.
test "p2_writer_output_is_namespace_wellformed" {
  let attrs_list : Array[Array[(String, String)]] = [
    [("xmlns:xml", "http://wrong")], [("xmlns:xmlns", "urn:x")], [("xmlns:p", "")], [
      ("xmlns:a", "urn:x"),
      ("xmlns:b", "urn:x"),
      ("a:k", "1"),
      ("b:k", "2"),
    ],
  ]
  let mut i = 0
  while i < attrs_list.length() {
    let w = xml::Writer::new()
    let res = w.write_empty_element("e", attrs_list[i])
    let out = w.into_string()
    debug_assert(res.is_err() || dom_ok(out), "Writer produced NS-ill-formed " + out)
    i = i + 1
  }
  let w2 = xml::Writer::new()
  let res2 = w2.write_empty_element("p:e", [])
  let out2 = w2.into_string()
  debug_assert(res2.is_err() || dom_ok(out2), "Writer produced unbound prefix " + out2)
}

///| P2-8: a text CR is written raw, so the parser's EOL normalisation turns it into LF on
///| re-read (attributes escape it as &#xD;, text does not).
test "p2_writer_text_cr_roundtrip" {
  let w = xml::Writer::new()
  let _ = w.write_start_element("a", [])
  let _ = w.write_text("x\ry\r\nz")
  let _ = w.write_end_element("a")
  match xml::Document::parse(w.into_string()) {
    Ok(doc) => {
      let t = match doc.root_element().text() {
        Some(t) => t
        None => ""
      }
      debug_assert(t == "x\ry\r\nz", "re-read " + show(t))
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| P2-9: PI values: leading whitespace and the empty value are lost on round-trip
///| (`Some("")` -> `<?t ?>` -> `None`, `Some("  v")` -> "v").
test "p2_writer_pi_value_roundtrip" {
  let w = xml::Writer::new()
  let _ = w.write_start_element("a", [])
  let _ = w.write_pi("t", Some("  v"))
  let _ = w.write_end_element("a")
  let out = w.into_string()
  match xml::Document::parse(out) {
    Ok(doc) => {
      let v = match doc.root_element().first_child() {
        Some(n) =>
        match n.pi() {
          Some(p) =>
          match p.value {
            Some(s) => s
            None => "<none>"
          }
          None => "<no pi>"
        }
        None => "<no child>"
      }
      debug_assert(v == "  v", out + " re-read as " + show(v))
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| P2-10: the Writer accepts sequences that cannot form a document: two root elements,
///| text before the root, a second XML declaration after content.
test "p2_writer_rejects_document_structure_violations" {
  let w = xml::Writer::new()
  let _ = w.write_empty_element("a", [])
  debug_assert(w.write_empty_element("b", []).is_err(), "second root accepted: " + w.sb.to_string())
  let w2 = xml::Writer::new()
  debug_assert(w2.write_text("loose").is_err(), "text outside root accepted")
  let w3 = xml::Writer::new()
  let _ = w3.write_empty_element("a", [])
  debug_assert(
    w3.write_xml_decl("1.0", None, None).is_err(),
    "XML declaration after content accepted: " + w3.sb.to_string(),
  )
}

///| P2-11: `new_with_indent` takes any byte as the indent character; `<` (or a non-ASCII byte)
///| is copied verbatim into the output.
test "p2_writer_indent_char_must_be_whitespace" {
  let w = xml::Writer::new_with_indent((60).to_byte(), 1)
  let _ = w.write_start_element("a", [])
  let _ = w.write_empty_element("b", [])
  let _ = w.write_end_element("a")
  let out = w.into_string()
  debug_assert(dom_ok(out), "indent output not well-formed: " + show(out))
}

///| P2-12: pretty printing inserts whitespace into mixed content, changing the text of the
///| document it was asked to serialise (`write_document` of `<a>x<b/>y</a>`).
test "p2_writer_pretty_preserves_mixed_content" {
  match xml::Document::parse("<a>x<b/>y</a>") {
    Ok(doc) => {
      let w = xml::Writer::new_with_indent((32).to_byte(), 2)
      let _ = w.write_document(doc)
      let out = w.into_string()
      match xml::Document::parse(out) {
        Ok(d2) => {
          let t = match d2.root_element().text() {
            Some(s) => s
            None => ""
          }
          debug_assert(t == "x", "first text became " + show(t) + " in " + show(out))
        }
        Err(e) => debug_assert(false, e.to_string())
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| Control: compact `write_document` round-trips namespaces, attributes, comments, PIs, CDATA
///| (as text) and escapes byte-exactly on re-parse.
test "control_write_document_compact_roundtrip" {
  let src = "<r xmlns=\"urn:d\" xmlns:x=\"urn:x\"><x:a x:k=\"&lt;1&gt;\" k=\"2\">t&amp;<![CDATA[c<]]><!--m--><?p v?>u</x:a><b/></r>"
  match xml::Document::parse(src) {
    Ok(doc) => {
      let w = xml::Writer::new()
      let _ = w.write_document(doc)
      let out = w.into_string()
      match xml::Document::parse(out) {
        Ok(d2) => {
          let w2 = xml::Writer::new()
          let _ = w2.write_document(d2)
          debug_assert(w2.into_string() == out, "not idempotent: " + out)
          debug_assert(d2.node_count() == doc.node_count(), "node count")
        }
        Err(e) => debug_assert(false, "reparse " + out + ": " + e.to_string())
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}
