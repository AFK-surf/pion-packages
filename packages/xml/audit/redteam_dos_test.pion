///| P0/P1 resource-exhaustion red-team tests for `xml` (assert the *correct* behaviour:
///| they FAIL while the defect exists and PASS once it is fixed).

import "xml"

///| Build `<a>` + `xx<![CDATA[yy]]>` * n + `</a>`.
fn merge_doc(n : Int) -> String {
  let sb = StringBuilder::new()
  sb.write_string("<a>")
  let mut i = 0
  while i < n {
    sb.write_string("xx<![CDATA[yy]]>")
    i = i + 1
  }
  sb.write_string("</a>")
  sb.to_string()
}

///| P0-1: adjacent Text/CDATA merging re-concatenates the whole accumulated text and keeps every
///| intermediate copy in `Document.strings`: O(n^2) time *and retained memory* with default
///| options (no DTD needed). 640 KB input -> 6.7 GiB RSS (see REPORT.md P0-1).
test "p0_text_cdata_merge_retains_quadratic_memory" {
  let n = 4000
  let src = merge_doc(n)
  match xml::Document::parse(src) {
    Ok(doc) => {
      let text = match doc.root_element().text() {
        Some(t) => t
        None => ""
      }
      debug_assert(text.length() == n * 4, "merged text length")
      let mut pool_bytes = 0
      let mut i = 0
      while i < doc.strings.length() {
        pool_bytes = pool_bytes + doc.strings[i].length()
        i = i + 1
      }
      // A linear implementation keeps at most a small constant multiple of the input.
      debug_assert(
        pool_bytes <= 4 * src.length(),
        "string pool holds " +
        pool_bytes.to_string() +
        " bytes in " +
        doc.strings.length().to_string() +
        " strings for a " +
        src.length().to_string() +
        "-byte input (quadratic retention)",
      )
    }
    Err(e) => debug_assert(false, "must parse: " + e.to_string())
  }
}

///| Control: the same amount of text without CDATA boundaries stays linear.
test "control_single_text_scan_is_linear" {
  let sb = StringBuilder::new()
  sb.write_string("<a>")
  let mut i = 0
  while i < 4000 {
    sb.write_string("xx&amp;yy")
    i = i + 1
  }
  sb.write_string("</a>")
  let src = sb.to_string()
  match xml::Document::parse(src) {
    Ok(doc) => {
      let mut pool_bytes = 0
      let mut k = 0
      while k < doc.strings.length() {
        pool_bytes = pool_bytes + doc.strings[k].length()
        k = k + 1
      }
      debug_assert(pool_bytes <= 4 * src.length(), "linear pool")
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| Control: 50,000-deep nesting with raised limits parses, walks, serialises and re-parses
///| without recursion (no SIGSEGV), on both the DOM and the Reader.
test "control_deep_50k_dom_reader_writer_no_crash" {
  let depth = 50000
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_string("<a>")
    i = i + 1
  }
  sb.write_string("x")
  i = 0
  while i < depth {
    sb.write_string("</a>")
    i = i + 1
  }
  let src = sb.to_string()
  match xml::Document::parse_with_options(src, big_opts(false)) {
    Ok(doc) => {
      debug_assert(doc.descendants().length() == depth + 2, "descendants")
      let w = xml::Writer::new()
      match w.write_document(doc) {
        Ok(()) => debug_assert(w.into_string() == src, "writer roundtrip")
        Err(e) => debug_assert(false, "writer: " + e.to_string())
      }
    }
    Err(e) => debug_assert(false, "dom: " + e.to_string())
  }
  debug_assert(reader_ok_with(src, big_opts(false)), "reader")
}

///| Control: billion laughs / quadratic blow-up / cycles are cut off by the entity budget.
test "control_entity_bombs_rejected" {
  let mut decls = "<!ENTITY lol \"lol\">"
  let mut prev = "lol"
  let mut lvl = 1
  while lvl <= 9 {
    let name = "lol" + lvl.to_string()
    let mut v = ""
    let mut k = 0
    while k < 10 {
      v = v + "&" + prev + ";"
      k = k + 1
    }
    decls = decls + "<!ENTITY " + name + " \"" + v + "\">"
    prev = name
    lvl = lvl + 1
  }
  debug_assert(!dtd_ok("<!DOCTYPE a [" + decls + "]><a>&lol9;</a>"), "billion laughs (text)")
  debug_assert(!dtd_ok("<!DOCTYPE a [" + decls + "]><a k=\"&lol9;\"/>"), "billion laughs (attr)")
  debug_assert(
    !reader_ok_with("<!DOCTYPE a [" + decls + "]><a>&lol9;</a>", dtd_opts()),
    "billion laughs (reader)",
  )
  let big = StringBuilder::new()
  let mut j = 0
  while j < 100000 {
    big.write_byte((120).to_byte())
    j = j + 1
  }
  let refs = StringBuilder::new()
  j = 0
  while j < 200 {
    refs.write_string("&big;")
    j = j + 1
  }
  debug_assert(
    !dtd_ok(
      "<!DOCTYPE a [<!ENTITY big \"" + big.to_string() + "\">]><a>" + refs.to_string() + "</a>",
    ),
    "quadratic blow-up",
  )
  debug_assert(!dtd_ok("<!DOCTYPE a [<!ENTITY e \"&e;\">]><a>&e;</a>"), "self loop")
  debug_assert(
    !dtd_ok("<!DOCTYPE a [<!ENTITY a \"&b;\"><!ENTITY b \"&a;\">]><a>&a;</a>"),
    "indirect loop",
  )
  debug_assert(!dtd_ok("<!DOCTYPE a [<!ENTITY e \"&e;\">]><a k=\"&e;\"/>"), "attr loop")
}

///| Control: XXE is never fetched or expanded; DTD is off by default.
test "control_xxe_and_default_dtd_off" {
  debug_assert(!dom_ok("<!DOCTYPE a [<!ENTITY e \"x\">]><a>&e;</a>"), "DTD off by default")
  debug_assert(!reader_ok("<!DOCTYPE a [<!ENTITY e \"x\">]><a>&e;</a>"), "reader DTD off")
  debug_assert(
    !dtd_ok("<!DOCTYPE a [<!ENTITY e SYSTEM \"file:///etc/passwd\">]><a>&e;</a>"),
    "SYSTEM entity reference",
  )
  debug_assert(
    !dtd_ok("<!DOCTYPE a [<!ENTITY e PUBLIC \"-//X\" \"http://x/\">]><a>&e;</a>"),
    "PUBLIC entity reference",
  )
}
