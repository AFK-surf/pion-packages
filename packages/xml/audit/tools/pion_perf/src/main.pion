///| Pion side of the `packages/xml` red-team adversarial benchmarks.
///|
///| usage: pion_perf MODE FILE ROUNDS
///|   dom      Document::parse_with_options (generous limits, DTD off), indexed zero-alloc walk
///|   dom_dtd  same with allow_dtd = true
///|   dom_api  Document::parse + walk through the *public* Node API (descendants/attributes/text)
///|   rd       Reader pull loop (events counted like the DOM walk where comparable)
///| Prints the same summary lines as tools/rust_ref `rust_perf` so bench_compare.py can verify
///| stdout SHA-256 byte-for-byte.

import "xml"

///|
fn opts(dtd : Bool) -> xml::ParseOptions {
  xml::ParseOptions::{
    allow_dtd: dtd,
    limits: xml::Limits::{
      max_depth: 1000000,
      max_nodes: 100000000,
      max_attributes: 1000000,
      max_entity_expansions: 100000000,
      max_entity_bytes: 1073741824,
    },
  }
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_eprintln(world, "usage: pion_perf MODE FILE ROUNDS")
    return 2
  }
  let mode = args[1]
  let src = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "cannot read input")
      return 2
    }
  }
  let rounds = parse_int(args[3])
  let mut elements : Int64 = 0L
  let mut attrs : Int64 = 0L
  let mut texts : Int64 = 0L
  let mut text_bytes : Int64 = 0L
  let mut attr_bytes : Int64 = 0L
  let mut r = 0
  while r < rounds {
    if mode == "rd" {
      let rd = xml::Reader::with_options(src, opts(false))
      let mut done = false
      let mut in_text = false
      while !done {
        match rd.next_event() {
          Ok(xml::Event::StartElement(se)) => {
            in_text = false
            elements = elements + 1L
            let a = se.attributes()
            let mut k = 0
            while k < a.length() {
              let n = a[k].name
              if !(n == "xmlns" || (n.length() > 6 && n.slice(0, 6) == "xmlns:")) {
                attrs = attrs + 1L
                attr_bytes = attr_bytes + a[k].value.length().to_int64()
              }
              k = k + 1
            }
          }
          Ok(xml::Event::EmptyElement(se)) => {
            in_text = false
            elements = elements + 1L
            let a = se.attributes()
            let mut k = 0
            while k < a.length() {
              let n = a[k].name
              if !(n == "xmlns" || (n.length() > 6 && n.slice(0, 6) == "xmlns:")) {
                attrs = attrs + 1L
                attr_bytes = attr_bytes + a[k].value.length().to_int64()
              }
              k = k + 1
            }
          }
          Ok(xml::Event::Text(t)) => {
            if !in_text && t.length() > 0 {
              texts = texts + 1L
              in_text = true
            }
            text_bytes = text_bytes + t.length().to_int64()
          }
          Ok(xml::Event::CData(t)) => {
            if !in_text && t.length() > 0 {
              texts = texts + 1L
              in_text = true
            }
            text_bytes = text_bytes + t.length().to_int64()
          }
          Ok(xml::Event::Eof) => done = true
          Ok(xml::Event::EndElement(_)) => in_text = false
          Ok(xml::Event::Comment(_)) => in_text = false
          Ok(xml::Event::ProcessingInstruction(_)) => in_text = false
          Ok(_) => ()
          Err(e) => {
            io_println(world, "error: " + e.to_string())
            return 1
          }
        }
      }
    } else {
      let doc = match xml::Document::parse_with_options(src, opts(mode == "dom_dtd")) {
        Ok(d) => d
        Err(e) => {
          io_println(world, "error: " + e.to_string())
          return 1
        }
      }
      if mode == "dom_api" {
        let all = doc.descendants()
        let mut i = 0
        while i < all.length() {
          let nd = all[i]
          if nd.is_element() {
            elements = elements + 1L
            let a = nd.attributes()
            let mut k = 0
            while k < a.length() {
              attrs = attrs + 1L
              attr_bytes = attr_bytes + a[k].value().length().to_int64()
              k = k + 1
            }
          } else if nd.is_text() {
            texts = texts + 1L
            text_bytes = text_bytes +
            (match nd.text() {
              Some(t) => t.length()
              None => 0
            }).to_int64()
          }
          i = i + 1
        }
      } else {
        let n = doc.node_count()
        let mut i = 0
        while i < n {
          let k = doc.node_kind_at(i)
          if k == 1 {
            elements = elements + 1L
            let (a0, a1) = doc.attrs_range_at(i)
            attrs = attrs + (a1 - a0).to_int64()
            let mut j = a0
            while j < a1 {
              attr_bytes = attr_bytes + doc.attr_value_len_raw(j).to_int64()
              j = j + 1
            }
          } else if k == 2 {
            texts = texts + 1L
            text_bytes = text_bytes + doc.text_len_at(i).to_int64()
          }
          i = i + 1
        }
      }
    }
    r = r + 1
  }
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "elements=" + elements.to_string())
  io_println(world, "attributes=" + attrs.to_string())
  io_println(world, "text_nodes=" + texts.to_string())
  io_println(world, "text_bytes=" + text_bytes.to_string())
  io_println(world, "attr_val_bytes=" + attr_bytes.to_string())
  0
}
