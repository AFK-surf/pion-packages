///| Pion side of the `packages/xml` red-team differential harness.
///|
///| usage: pion_dump MODE PACK
///|   PACK: repeated records `@@CASE <name> <byte_len>\n<bytes>\n`
///|   MODE:
///|     dom        Document::parse (defaults)                -> canonical tree dump
///|     dom_dtd    Document::parse_with_options(allow_dtd)    -> canonical tree dump
///|     raw        Document::parse, qname-level dump (no namespace resolution)
///|     raw_dtd    same with allow_dtd
///|     rd         Reader::new pull events folded into the same qname-level dump
///|     rd_dtd     Reader::with_options(allow_dtd)
///| Output per case: `=== <name>` then `OK` + dump lines, or `ERR <kind>`.
///| Bytes < 0x20, 0x7F, `\` are escaped identically to the Rust oracle (`tools/rust_ref`).

import "xml"

///|
fn hex1(d : Int) -> Int {
  if d < 10 {
    48 + d
  } else {
    87 + d
  }
}

///|
fn esc(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 0x5C {
      sb.write_string("\\\\")
    } else if b == 0x0A {
      sb.write_string("\\n")
    } else if b == 0x0D {
      sb.write_string("\\r")
    } else if b == 0x09 {
      sb.write_string("\\t")
    } else if b < 0x20 || b == 0x7F {
      sb.write_string("\\x")
      sb.write_byte(hex1(b >> 4).to_byte())
      sb.write_byte(hex1(b & 15).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
}

///|
fn kind_name(k : xml::XmlErrorKind) -> String {
  match k {
    xml::XmlErrorKind::UnexpectedEof => "UnexpectedEof"
    xml::XmlErrorKind::InvalidSyntax => "InvalidSyntax"
    xml::XmlErrorKind::InvalidName => "InvalidName"
    xml::XmlErrorKind::InvalidChar => "InvalidChar"
    xml::XmlErrorKind::InvalidCharRef => "InvalidCharRef"
    xml::XmlErrorKind::UnknownEntity => "UnknownEntity"
    xml::XmlErrorKind::EntityLoop => "EntityLoop"
    xml::XmlErrorKind::DuplicateAttribute => "DuplicateAttribute"
    xml::XmlErrorKind::MismatchedTag => "MismatchedTag"
    xml::XmlErrorKind::UnclosedTag => "UnclosedTag"
    xml::XmlErrorKind::NoRootNode => "NoRootNode"
    xml::XmlErrorKind::MultipleRootNodes => "MultipleRootNodes"
    xml::XmlErrorKind::InvalidXmlDecl => "InvalidXmlDecl"
    xml::XmlErrorKind::InvalidComment => "InvalidComment"
    xml::XmlErrorKind::InvalidCData => "InvalidCData"
    xml::XmlErrorKind::InvalidPI => "InvalidPI"
    xml::XmlErrorKind::DtdDetected => "DtdDetected"
    xml::XmlErrorKind::ExternalEntityNotAllowed => "ExternalEntityNotAllowed"
    xml::XmlErrorKind::InvalidNamespace => "InvalidNamespace"
    xml::XmlErrorKind::UnboundNamespacePrefix => "UnboundNamespacePrefix"
    xml::XmlErrorKind::LimitExceeded => "LimitExceeded"
    xml::XmlErrorKind::Unimplemented => "Unimplemented"
  }
}

///| Generous limits so that differences come from XML rules, not from resource caps.
fn audit_opts(allow_dtd : Bool) -> xml::ParseOptions {
  xml::ParseOptions::{
    allow_dtd: allow_dtd,
    limits: xml::Limits::{
      max_depth: 100000,
      max_nodes: 10000000,
      max_attributes: 100000,
      max_entity_expansions: 100000,
      max_entity_bytes: 16777216,
    },
  }
}

///|
fn depth_of(n : xml::Node) -> Int {
  let mut d = 0
  let mut cur = n.parent()
  while true {
    match cur {
      Some(p) => {
        d = d + 1
        cur = p.parent()
      }
      None => break
    }
  }
  d
}

///|
fn ns_tag(sb : StringBuilder, ns : Option[String], local : String) -> Unit {
  match ns {
    Some(u) => {
      sb.write_string("{")
      esc(sb, u)
      sb.write_string("}")
    }
    None => ()
  }
  esc(sb, local)
}

///|
fn qname(prefix : Option[String], local : String) -> String {
  match prefix {
    Some(p) => p + ":" + local
    None => local
  }
}

///| Canonical DOM dump. `raw = true` prints qualified names instead of expanded names.
fn dump_dom(sb : StringBuilder, doc : xml::Document, raw : Bool) -> Unit {
  let all = doc.descendants()
  let mut i = 1
  while i < all.length() {
    let nd = all[i]
    let d = depth_of(nd).to_string()
    match nd.node_type() {
      xml::NodeType::Element => {
        sb.write_string("E" + d + " ")
        let tn = nd.tag_name()
        if raw {
          esc(sb, qname(tn.prefix(), tn.name()))
        } else {
          ns_tag(sb, tn.namespace(), tn.name())
        }
        sb.write_string("\n")
        let attrs = nd.attributes()
        let mut k = 0
        while k < attrs.length() {
          let a = attrs[k]
          sb.write_string("A" + d + " ")
          if raw {
            esc(sb, qname(a.prefix(), a.name()))
          } else {
            ns_tag(sb, a.namespace(), a.name())
          }
          sb.write_string("=")
          esc(sb, a.value())
          sb.write_string("\n")
          k = k + 1
        }
      }
      xml::NodeType::Text => {
        sb.write_string("T" + d + " ")
        esc(sb, match nd.text() { Some(t) => t, None => "" })
        sb.write_string("\n")
      }
      xml::NodeType::Comment => {
        sb.write_string("C" + d + " ")
        esc(sb, match nd.text() { Some(t) => t, None => "" })
        sb.write_string("\n")
      }
      xml::NodeType::PI => {
        match nd.pi() {
          Some(p) => {
            sb.write_string("P" + d + " ")
            esc(sb, p.target)
            match p.value {
              Some(v) => {
                sb.write_string(" =")
                esc(sb, v)
              }
              None => ()
            }
            sb.write_string("\n")
          }
          None => ()
        }
      }
      xml::NodeType::Root => ()
    }
    i = i + 1
  }
}

///|
fn flush_text(sb : StringBuilder, pending : StringBuilder, depth : Int) -> Unit {
  let t = pending.to_string()
  if t.length() > 0 {
    sb.write_string("T" + depth.to_string() + " ")
    esc(sb, t)
    sb.write_string("\n")
  }
}

///|
fn is_xmlns(name : String) -> Bool {
  name == "xmlns" || (name.length() > 6 && name.slice(0, 6) == "xmlns:")
}

///| Fold Reader events into the qname-level dump used by `raw` mode.
fn dump_reader(sb : StringBuilder, r : xml::Reader) -> String {
  let mut depth = 1
  let mut pending = StringBuilder::new()
  let mut steps = 0
  while steps < 50000000 {
    steps = steps + 1
    match r.next_event() {
      Err(e) => return "ERR " + kind_name(e.kind)
      Ok(ev) => {
        match ev {
          xml::Event::Text(t) => pending.write_string(t)
          xml::Event::CData(t) => pending.write_string(t)
          xml::Event::Eof => {
            flush_text(sb, pending, depth)
            return "OK"
          }
          _ => {
            flush_text(sb, pending, depth)
            pending = StringBuilder::new()
            match ev {
              xml::Event::StartElement(se) => {
                write_start(sb, se, depth)
                depth = depth + 1
              }
              xml::Event::EmptyElement(se) => write_start(sb, se, depth)
              xml::Event::EndElement(_) => depth = depth - 1
              xml::Event::Comment(c) => {
                sb.write_string("C" + depth.to_string() + " ")
                esc(sb, c)
                sb.write_string("\n")
              }
              xml::Event::ProcessingInstruction(p) => {
                sb.write_string("P" + depth.to_string() + " ")
                esc(sb, p.target)
                match p.value {
                  Some(v) => {
                    sb.write_string(" =")
                    esc(sb, v)
                  }
                  None => ()
                }
                sb.write_string("\n")
              }
              _ => ()
            }
          }
        }
      }
    }
  }
  "ERR Steps"
}

///|
fn write_start(sb : StringBuilder, se : xml::StartElement, depth : Int) -> Unit {
  let d = depth.to_string()
  sb.write_string("E" + d + " ")
  esc(sb, se.name())
  sb.write_string("\n")
  let attrs = se.attributes()
  let mut k = 0
  while k < attrs.length() {
    let a = attrs[k]
    if !is_xmlns(a.name) {
      sb.write_string("A" + d + " ")
      esc(sb, a.name)
      sb.write_string("=")
      esc(sb, a.value)
      sb.write_string("\n")
    }
    k = k + 1
  }
}

///|
fn run_case(mode : String, src : String) -> String {
  let dtd = mode == "dom_dtd" || mode == "raw_dtd" || mode == "rd_dtd"
  let opts = audit_opts(dtd)
  let sb = StringBuilder::new()
  if mode == "rd" || mode == "rd_dtd" {
    let status = dump_reader(sb, xml::Reader::with_options(src, opts))
    if status == "OK" {
      return "OK\n" + sb.to_string()
    }
    return status + "\n"
  }
  match xml::Document::parse_with_options(src, opts) {
    Ok(doc) => {
      dump_dom(sb, doc, mode == "raw" || mode == "raw_dtd")
      "OK\n" + sb.to_string()
    }
    Err(e) => "ERR " + kind_name(e.kind) + "\n"
  }
}

///|
fn parse_int(s : String, start : Int, end : Int) -> Int {
  let mut v = 0
  let mut i = start
  while i < end {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: pion_dump MODE PACK")
    return 2
  }
  let mode = args[1]
  let pack = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "cannot read pack")
      return 2
    }
  }
  let n = pack.length()
  let out = StringBuilder::new()
  let mut pos = 0
  while pos < n {
    // header: "@@CASE <name> <len>\n"
    let mut eol = pos
    while eol < n && pack.code_unit_at(eol) != 0x0A {
      eol = eol + 1
    }
    let mut sp = eol - 1
    while sp > pos && pack.code_unit_at(sp) != 0x20 {
      sp = sp - 1
    }
    let name = pack.slice(pos + 7, sp)
    let blen = parse_int(pack, sp + 1, eol)
    let body = pack.slice(eol + 1, eol + 1 + blen)
    pos = eol + 1 + blen + 1
    out.write_string("=== " + name + "\n")
    out.write_string(run_case(mode, body))
  }
  io_print(world, out.to_string())
  0
}
