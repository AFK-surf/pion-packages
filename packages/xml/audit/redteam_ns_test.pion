///| Namespaces 1.0 and DOM-vs-Reader consistency red-team tests for `xml`.

import "xml"

///| Every Namespaces-1.0 violation from the audit brief; the DOM rejects them all (control).
fn ns_violations() -> Array[String] {
  [
    "<a xmlns:xml=\"http://wrong\"/>", "<a xmlns:xmlns=\"urn:x\"/>", "<a xmlns:xmlns=\"http://www.w3.org/2000/xmlns/\"/>",
    "<a xmlns:p=\"http://www.w3.org/2000/xmlns/\"/>", "<a xmlns:p=\"http://www.w3.org/XML/1998/namespace\"/>",
    "<a xmlns=\"http://www.w3.org/XML/1998/namespace\"/>", "<a xmlns=\"http://www.w3.org/2000/xmlns/\"/>",
    "<a xmlns:p=\"urn:x\"><b xmlns:p=\"\"/></a>", "<a xmlns:a=\"urn:x\" xmlns:b=\"urn:x\" a:k=\"1\" b:k=\"2\"/>",
    "<a xmlns:a=\"urn:x\" xmlns:b=\"urn:&#120;\" a:k=\"1\" b:k=\"2\"/>", "<p:a/>", "<a p:k=\"1\"/>",
    "<xmlns:a/>", "<a:b:c xmlns:a=\"urn:x\"/>", "<:a/>", "<?a:b?><r/>", "<a xmlns:p=\"x\" xmlns:p=\"y\"/>",
    "<a xmlns=\"x\" xmlns=\"y\"/>",
  ]
}

///| Control: DOM rejects every Namespaces 1.0 violation.
test "control_dom_rejects_namespace_violations" {
  let cases = ns_violations()
  let mut i = 0
  while i < cases.length() {
    debug_assert(!dom_ok(cases[i]), "DOM accepted " + cases[i])
    i = i + 1
  }
}

///| P1-4: the streaming `Reader` performs no Namespaces 1.0 processing, so a document the DOM
///| rejects streams through `Reader` without error (and events carry no namespace URI).
test "p1_reader_rejects_unbound_prefix" {
  debug_assert(!reader_ok("<p:a/>"), "Reader accepted unbound element prefix <p:a/>")
}

///|
test "p1_reader_rejects_reserved_prefix_rebinding" {
  debug_assert(
    !reader_ok("<a xmlns:xml=\"http://wrong\"/>"),
    "Reader accepted xmlns:xml rebinding",
  )
}

///|
test "p1_reader_rejects_duplicate_expanded_attribute" {
  debug_assert(
    !reader_ok("<a xmlns:a=\"urn:x\" xmlns:b=\"urn:x\" a:k=\"1\" b:k=\"2\"/>"),
    "Reader accepted a duplicate expanded attribute name",
  )
}

///| P1-4 (aggregate): DOM and Reader must agree on acceptance for every violation.
test "p1_dom_reader_agree_on_namespace_violations" {
  let cases = ns_violations()
  let disagree : Array[String] = []
  let mut i = 0
  while i < cases.length() {
    if dom_ok(cases[i]) != reader_ok(cases[i]) {
      disagree.push(cases[i])
    }
    i = i + 1
  }
  debug_assert(
    disagree.length() == 0,
    disagree.length().to_string() +
    "/" +
    cases.length().to_string() +
    " documents accepted by Reader but rejected by DOM, e.g. " +
    (if disagree.length() > 0 { disagree[0] } else { "" }),
  )
}

///| Control: shadowing and restoring prefixes across siblings/empty elements resolves correctly
///| (the 1-entry prefix cache is invalidated on every scope change).
test "control_prefix_cache_shadow_restore" {
  let src = "<r xmlns:p=\"urn:1\" xmlns:pp=\"urn:2\"><p:a/><x xmlns:p=\"urn:9\"><p:a/></x><p:a/><y xmlns:p=\"urn:8\"/><p:a/><pp:a/><p:a/></r>"
  match xml::Document::parse(src) {
    Ok(doc) => {
      let got : Array[String] = []
      let all = doc.descendants()
      let mut i = 0
      while i < all.length() {
        let n = all[i]
        if n.is_element() && n.tag_name().name() == "a" {
          got.push(
            match n.namespace() {
              Some(u) => u
              None => "-"
            },
          )
        }
        i = i + 1
      }
      let want = ["urn:1", "urn:9", "urn:1", "urn:1", "urn:2", "urn:1"]
      debug_assert(got.length() == want.length(), "count")
      let mut k = 0
      while k < want.length() {
        debug_assert(got[k] == want[k], "element #" + k.to_string() + ": " + got[k])
        k = k + 1
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| Control: xmlns="" unbinds the default namespace (pion reports None; roxmltree reports Some("")).
test "control_default_namespace_unbinding" {
  match xml::Document::parse("<a xmlns=\"urn:x\"><b xmlns=\"\"><c/></b><d/></a>") {
    Ok(doc) => {
      let r = doc.root_element()
      let b = match r.first_element_child() {
        Some(n) => n
        None => r
      }
      debug_assert(
        match b.namespace() {
          Some(_) => false
          None => true
        },
        "b has no namespace",
      )
      match b.next_sibling_element() {
        Some(d) =>
        debug_assert(
          match d.namespace() {
            Some(u) => u == "urn:x"
            None => false
          },
          "d back in urn:x",
        )
        None => debug_assert(false, "d missing")
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}
