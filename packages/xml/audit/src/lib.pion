///| Helpers shared by the `packages/xml` red-team tests (test-only package; see REPORT.md).

import "xml"

///| `ParseOptions` with DTD enabled and the package's default limits.
pub fn dtd_opts() -> xml::ParseOptions {
  xml::ParseOptions::{ allow_dtd: true, limits: xml::Limits::default() }
}

///| `ParseOptions` with generous limits (resource caps out of the way).
pub fn big_opts(allow_dtd : Bool) -> xml::ParseOptions {
  xml::ParseOptions::{
    allow_dtd: allow_dtd,
    limits: xml::Limits::{
      max_depth: 1000000,
      max_nodes: 100000000,
      max_attributes: 1000000,
      max_entity_expansions: 1000000,
      max_entity_bytes: 1073741824,
    },
  }
}

///| True when the DOM parser accepts `src` with default options.
pub fn dom_ok(src : String) -> Bool {
  match xml::Document::parse(src) {
    Ok(_) => true
    Err(_) => false
  }
}

///| True when the DOM parser accepts `src` with `allow_dtd = true`.
pub fn dtd_ok(src : String) -> Bool {
  match xml::Document::parse_with_options(src, dtd_opts()) {
    Ok(_) => true
    Err(_) => false
  }
}

///| Drain a `Reader`; true when it reaches `Eof` without an error.
pub fn reader_ok_with(src : String, opts : xml::ParseOptions) -> Bool {
  let r = xml::Reader::with_options(src, opts)
  let mut steps = 0
  while steps < 10000000 {
    match r.next_event() {
      Ok(xml::Event::Eof) => return true
      Ok(_) => ()
      Err(_) => return false
    }
    steps = steps + 1
  }
  false
}

///|
pub fn reader_ok(src : String) -> Bool {
  reader_ok_with(src, xml::ParseOptions::default())
}

///| Error kind name of a DOM parse (`"OK"` when accepted).
pub fn dom_kind(src : String, opts : xml::ParseOptions) -> String {
  match xml::Document::parse_with_options(src, opts) {
    Ok(_) => "OK"
    Err(e) => e.message
  }
}

///| Concatenated text of all Text descendants of the root element (DTD enabled).
pub fn dtd_text(src : String) -> String {
  match xml::Document::parse_with_options(src, dtd_opts()) {
    Ok(doc) => {
      let sb = StringBuilder::new()
      let all = doc.root_element().descendants()
      let mut i = 0
      while i < all.length() {
        if all[i].is_text() {
          match all[i].text() {
            Some(t) => sb.write_string(t)
            None => ()
          }
        }
        i = i + 1
      }
      sb.to_string()
    }
    Err(e) => "ERR " + e.to_string()
  }
}

///| Number of element descendants of the root element, including itself (DTD enabled).
pub fn dtd_element_count(src : String) -> Int {
  match xml::Document::parse_with_options(src, dtd_opts()) {
    Ok(doc) => {
      let all = doc.root_element().descendants()
      let mut n = 0
      let mut i = 0
      while i < all.length() {
        if all[i].is_element() {
          n = n + 1
        }
        i = i + 1
      }
      n
    }
    Err(_) => -1
  }
}

///| Value of attribute `name` on the root element (DTD enabled).
pub fn dtd_root_attr(src : String, name : String) -> String {
  match xml::Document::parse_with_options(src, dtd_opts()) {
    Ok(doc) =>
    match doc.root_element().attribute(name) {
      Some(v) => v
      None => "<none>"
    }
    Err(e) => "ERR " + e.to_string()
  }
}

///| Escape control characters so assertion messages stay readable.
pub fn show(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b == 0x0A {
      sb.write_string("\\n")
    } else if b == 0x0D {
      sb.write_string("\\r")
    } else if b == 0x09 {
      sb.write_string("\\t")
    } else if b < 0x20 {
      sb.write_string("\\x" + b.to_string())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  "\"" + sb.to_string() + "\""
}
