///| Flat-array read-only XML 1.0 + XML Namespaces 1.0 DOM parser and accessors (inspired by roxmltree).

let node_kind_root : Int = 0

let node_kind_element : Int = 1

let node_kind_text : Int = 2

let node_kind_comment : Int = 3

let node_kind_pi : Int = 4

let xml_ns_uri : String = "http://www.w3.org/XML/1998/namespace"

let xmlns_ns_uri : String = "http://www.w3.org/2000/xmlns/"

fn pack_kind_ns(kind : Int, ns_idx : Int) -> Int {
  (kind & 7) | ((ns_idx + 2) << 3)
}

fn unpack_kind(kind_ns : Int) -> Int {
  kind_ns & 7
}

fn unpack_ns(kind_ns : Int) -> Int {
  (kind_ns >> 3) - 2
}

///| Look up a namespace prefix in the active namespace stack.
///| Returns `ns_idx` (`>= 0` in `namespaces`, `-2` for built-in `xml`, `-1` for unbound/none).
fn resolve_ns_prefix(
  src : String,
  namespaces : Array[NsData],
  active_ns : Array[Int],
  p_start : Int,
  p_end : Int,
) -> Int {
  let plen = p_end - p_start
  let p0 = src.code_unit_at(p_start)
  if plen == 3 && p0 == 0x78 && raw_slice_eq_str(src, p_start, p_end, "xml") {
    return -2
  }
  let mut k = active_ns.length() - 1
  while k >= 0 {
    let ns_idx = active_ns[k]
    let ns = namespaces[ns_idx]
    if ns.has_prefix &&
    ns.prefix_span.end - ns.prefix_span.start == plen &&
    src.code_unit_at(ns.prefix_span.start) == p0 &&
    raw_slice_eq(
      src,
      ns.prefix_span.start,
      ns.prefix_span.end,
      p_start,
      p_end,
    ) {
      return ns_idx
    }
    k = k - 1
  }
  -1
}

///| Update previous sibling's `next_sibling` link in `nodes`.
fn set_next_sibling(nodes : Array[NodeData], prev : Int, child_id : Int) -> Unit {
  let pn = nodes[prev]
  nodes[prev] = NodeData::{
    kind_ns: pn.kind_ns,
    parent: pn.parent,
    prev_sibling: pn.prev_sibling,
    next_sibling: child_id,
    first_child: pn.first_child,
    last_child: pn.last_child,
    s1_start: pn.s1_start,
    s1_end: pn.s1_end,
    s2_start: pn.s2_start,
    s2_end: pn.s2_end,
    attrs_start: pn.attrs_start,
    attrs_end: pn.attrs_end,
    ns_start: pn.ns_start,
    ns_end: pn.ns_end,
  }
}

///| Write deferred `first_child` and `last_child` onto `node_id` once when closing it.
fn finalize_children(
  nodes : Array[NodeData],
  node_id : Int,
  fc : Int,
  lc : Int,
) -> Unit {
  if fc >= 0 {
    let nd = nodes[node_id]
    nodes[node_id] = NodeData::{
      kind_ns: nd.kind_ns,
      parent: nd.parent,
      prev_sibling: nd.prev_sibling,
      next_sibling: nd.next_sibling,
      first_child: fc,
      last_child: lc,
      s1_start: nd.s1_start,
      s1_end: nd.s1_end,
      s2_start: nd.s2_start,
      s2_end: nd.s2_end,
      attrs_start: nd.attrs_start,
      attrs_end: nd.attrs_end,
      ns_start: nd.ns_start,
      ns_end: nd.ns_end,
    }
  }
}

///| Append or merge a text chunk into the current parent element (roxmltree merges adjacent text + CDATA).
///| Returns the new `cur_last_child`.
fn append_or_merge_text_slow(
  src : String,
  strings : Array[String],
  nodes : Array[NodeData],
  parent_id : Int,
  last_id : Int,
  s_start : Int,
  s_end : Int,
  max_nodes : Int,
  err_offset : Int,
) -> Result[Int, XmlError] {
  if s_start >= 0 && s_start == s_end {
    return Ok(last_id)
  }
  if last_id >= 0 && unpack_kind(nodes[last_id].kind_ns) == node_kind_text {
    let prev_node = nodes[last_id]
    let merged = span_to_string(
      src,
      strings,
      TextSpan::{ start: prev_node.s1_start, end: prev_node.s1_end },
    ) +
    span_to_string(src, strings, TextSpan::{ start: s_start, end: s_end })
    let pool_idx = strings.length()
    strings.push(merged)
    nodes[last_id] = NodeData::{
      kind_ns: prev_node.kind_ns,
      parent: prev_node.parent,
      prev_sibling: prev_node.prev_sibling,
      next_sibling: prev_node.next_sibling,
      first_child: prev_node.first_child,
      last_child: prev_node.last_child,
      s1_start: -(pool_idx + 1),
      s1_end: 0,
      s2_start: 0,
      s2_end: 0,
      attrs_start: 0,
      attrs_end: 0,
      ns_start: 0,
      ns_end: 0,
    }
    return Ok(last_id)
  }
  if nodes.length() >= max_nodes {
    return Err(
      make_err(src, err_offset, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"),
    )
  }
  let child_id = nodes.length()
  nodes.push(
    NodeData::{
      kind_ns: pack_kind_ns(node_kind_text, -1),
      parent: parent_id,
      prev_sibling: last_id,
      next_sibling: -1,
      first_child: -1,
      last_child: -1,
      s1_start: s_start,
      s1_end: s_end,
      s2_start: 0,
      s2_end: 0,
      attrs_start: 0,
      attrs_end: 0,
      ns_start: 0,
      ns_end: 0,
    },
  )
  if last_id >= 0 {
    set_next_sibling(nodes, last_id, child_id)
  }
  Ok(child_id)
}

///| Parse an XML 1.0 document with default security options (DTD disabled, bounded limits).
pub fn Document::parse(src : String) -> Result[Document, XmlError] {
  Document::parse_with_options(src, ParseOptions::default())
}

///| Parse an XML 1.0 document into a flat-array read-only DOM with custom options.
pub fn Document::parse_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Document, XmlError] {
  let len = src.length()
  let mut pos = 0
  // Strip optional UTF-8 BOM (EF BB BF)
  if len >= 3 &&
  src.code_unit_at(0) == 0xEF &&
  src.code_unit_at(1) == 0xBB &&
  src.code_unit_at(2) == 0xBF {
    pos = 3
  }

  let est_nodes = if len > 64 { len / 32 + 16 } else { 16 }
  let est_attrs = if len > 64 { len / 28 + 16 } else { 16 }
  let nodes : Array[NodeData] = Array::with_capacity(est_nodes)
  let attrs : Array[AttrData] = Array::with_capacity(est_attrs)
  let namespaces : Array[NsData] = Array::with_capacity(16)
  let strings : Array[String] = []
  let entities : Array[EntityDef] = []
  let budget = EntityBudget::new(opts.limits)

  // Node 0: Document Root
  nodes.push(
    NodeData::{
      kind_ns: pack_kind_ns(node_kind_root, -1),
      parent: -1,
      prev_sibling: -1,
      next_sibling: -1,
      first_child: -1,
      last_child: -1,
      s1_start: 0,
      s1_end: 0,
      s2_start: 0,
      s2_end: 0,
      attrs_start: 0,
      attrs_end: 0,
      ns_start: 0,
      ns_end: 0,
    },
  )

  // Optional XML declaration at exact start (after optional BOM)
  if pos + 5 <= len && raw_slice_eq_str(src, pos, pos + 5, "<?xml") {
    let next_b = if pos + 5 < len { src.code_unit_at(pos + 5) } else { 0 }
    if next_b == 0x20 ||
    next_b == 0x09 ||
    next_b == 0x0A ||
    next_b == 0x0D ||
    next_b == 0x3F {
      match parse_xml_decl(src, pos, len) {
        Ok((_, ni)) => pos = ni
        Err(e) => return Err(e)
      }
    }
  }

  // Explicit stacks (zero recursion!). Top of stack is kept in registers (`cur_parent`, `cur_fc`, `cur_lc`, `depth`).
  let lut = xml_lut
  let elem_stack : Array[Int] = []
  let first_child_stack : Array[Int] = []
  let last_child_stack : Array[Int] = []
  let ns_scope_stack : Array[Int] = []
  let default_ns_stack : Array[Int] = []
  let active_ns : Array[Int] = []
  let mut depth = 0
  let mut cur_parent = 0
  let mut cur_fc = -1
  let mut cur_lc = -1
  let mut cur_default_ns = -1
  let mut cached_ns_p_start = 0
  let mut cached_ns_p_end = 0
  let mut cached_ns_idx = -1
  let mut root_elem_id = -1
  let mut saw_doctype = false
  let max_depth = opts.limits.max_depth
  let max_nodes = opts.limits.max_nodes
  let max_attributes = opts.limits.max_attributes

  while pos < len {
    if depth == 0 {
      // Prolog or Epilog: only whitespace, comments, PIs, (and 1 DOCTYPE + 1 root element in prolog)
      if src.code_unit_at(pos) <= 0x20 {
        pos = skip_ws(src, pos, len)
        if pos >= len {
          break
        }
      }
      if src.code_unit_at(pos) != 0x3C {
        return Err(
          make_err(src, pos, XmlErrorKind::InvalidSyntax, "unexpected text outside root element"),
        )
      }
      if pos + 1 >= len {
        return Err(make_err(src, pos, XmlErrorKind::UnexpectedEof, "unexpected EOF after '<'"))
      }
      let b1 = src.code_unit_at(pos + 1)
      if b1 == 0x21 {
        if pos + 4 <= len && src.code_unit_at(pos + 2) == 0x2D && src.code_unit_at(pos + 3) == 0x2D {
          match scan_comment(src, pos + 4, len) {
            Ok((cs, ce, has_cr, ni)) => {
              if nodes.length() >= max_nodes {
                return Err(make_err(src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
              }
              let mut vs = cs
              let mut ve = ce
              if has_cr {
                let idx = strings.length()
                strings.push(normalize_eol(src, cs, ce))
                vs = -(idx + 1)
                ve = 0
              }
              let cid = nodes.length()
              nodes.push(
                NodeData::{
                  kind_ns: pack_kind_ns(node_kind_comment, -1),
                  parent: 0,
                  prev_sibling: cur_lc,
                  next_sibling: -1,
                  first_child: -1,
                  last_child: -1,
                  s1_start: vs,
                  s1_end: ve,
                  s2_start: 0,
                  s2_end: 0,
                  attrs_start: 0,
                  attrs_end: 0,
                  ns_start: 0,
                  ns_end: 0,
                },
              )
              if cur_lc >= 0 {
                set_next_sibling(nodes, cur_lc, cid)
              } else {
                cur_fc = cid
              }
              cur_lc = cid
              pos = ni
              continue
            }
            Err(e) => return Err(e)
          }
        } else if pos + 9 <= len && raw_slice_eq_str(src, pos, pos + 9, "<!DOCTYPE") {
          if root_elem_id >= 0 {
            return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "DOCTYPE not allowed after root element"))
          }
          if saw_doctype {
            return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "multiple DOCTYPE declarations"))
          }
          if !opts.allow_dtd {
            return Err(make_err(src, pos, XmlErrorKind::DtdDetected, "DTD is disabled by default"))
          }
          saw_doctype = true
          match parse_doctype(src, pos + 9, len, entities) {
            Ok((_, _, ni)) => {
              pos = ni
              continue
            }
            Err(e) => return Err(e)
          }
        } else if pos + 9 <= len && raw_slice_eq_str(src, pos, pos + 9, "<![CDATA[") {
          return Err(make_err(src, pos, XmlErrorKind::InvalidCData, "CDATA not allowed outside root element"))
        } else {
          return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "invalid markup in prolog/epilog"))
        }
      } else if b1 == 0x3F {
        match scan_pi(src, pos + 2, len) {
          Ok((ts, te, vs_raw, ve_raw, has_val, has_cr, ni)) => {
            if nodes.length() >= max_nodes {
              return Err(make_err(src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
            }
            let mut vs = 0
            let mut ve = 0
            if has_val {
              if has_cr {
                let idx = strings.length()
                strings.push(normalize_eol(src, vs_raw, ve_raw))
                vs = -(idx + 1)
                ve = 0
              } else {
                vs = vs_raw
                ve = ve_raw
              }
            }
            let cid = nodes.length()
            nodes.push(
              NodeData::{
                kind_ns: pack_kind_ns(node_kind_pi, if has_val { 1 } else { 0 }),
                parent: 0,
                prev_sibling: cur_lc,
                next_sibling: -1,
                first_child: -1,
                last_child: -1,
                s1_start: ts,
                s1_end: te,
                s2_start: vs,
                s2_end: ve,
                attrs_start: 0,
                attrs_end: 0,
                ns_start: 0,
                ns_end: 0,
              },
            )
            if cur_lc >= 0 {
              set_next_sibling(nodes, cur_lc, cid)
            } else {
              cur_fc = cid
            }
            cur_lc = cid
            pos = ni
            continue
          }
          Err(e) => return Err(e)
        }
      } else if b1 == 0x2F {
        return Err(make_err(src, pos, XmlErrorKind::MismatchedTag, "unexpected end tag at root level"))
      } else if root_elem_id >= 0 {
        return Err(make_err(src, pos, XmlErrorKind::MultipleRootNodes, "multiple root elements"))
      }
    }

    // Inside element (or starting root element at '<')
    if src.code_unit_at(pos) != 0x3C {
      // Fast text scan until '<'
      let text_start = pos
      let mut i = pos
      let mut needs_unescape = false
      while i < len {
        while i <= len - 4 {
          let m0 = lut[src.code_unit_at(i)]
          let m1 = lut[src.code_unit_at(i + 1)]
          let m2 = lut[src.code_unit_at(i + 2)]
          let m3 = lut[src.code_unit_at(i + 3)]
          if ((m0 & m1 & m2 & m3) & mask_text_fast) != 0 {
            i = i + 4
          } else {
            break
          }
        }
        if i >= len {
          break
        }
        let b = src.code_unit_at(i)
        if b == 0x3C {
          break
        }
        if b < 0x80 {
          let m = lut[b]
          if (m & mask_text_fast) != 0 {
            i = i + 1
          } else if b == 0x26 || b == 0x0D {
            needs_unescape = true
            i = i + 1
          } else if b == 0x5D {
            if i + 2 < len &&
            src.code_unit_at(i + 1) == 0x5D &&
            src.code_unit_at(i + 2) == 0x3E {
              return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "']]>' is not allowed in text content"))
            }
            i = i + 1
          } else {
            return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in text"))
          }
        } else {
          let (cp, blen) = decode_utf8(src, i, len)
          if cp < 0 || !is_xml_char(cp) {
            return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in text"))
          }
          i = i + blen
        }
      }
      let mut ts = text_start
      let mut te = i
      if needs_unescape {
        match unescape_span(src, text_start, i, false, entities, budget) {
          Ok(s) => {
            let idx = strings.length()
            strings.push(s)
            ts = -(idx + 1)
            te = 0
          }
          Err(e) => return Err(e)
        }
      }
      if cur_lc < 0 {
        if !(ts >= 0 && ts == te) {
          if nodes.length() >= max_nodes {
            return Err(
              make_err(src, text_start, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"),
            )
          }
          let cid = nodes.length()
          nodes.push(
            NodeData::{
              kind_ns: pack_kind_ns(node_kind_text, -1),
              parent: cur_parent,
              prev_sibling: -1,
              next_sibling: -1,
              first_child: -1,
              last_child: -1,
              s1_start: ts,
              s1_end: te,
              s2_start: 0,
              s2_end: 0,
              attrs_start: 0,
              attrs_end: 0,
              ns_start: 0,
              ns_end: 0,
            },
          )
          cur_fc = cid
          cur_lc = cid
        }
      } else {
        match append_or_merge_text_slow(
          src,
          strings,
          nodes,
          cur_parent,
          cur_lc,
          ts,
          te,
          max_nodes,
          text_start,
        ) {
          Ok(new_lc) => cur_lc = new_lc
          Err(e) => return Err(e)
        }
      }
      pos = i
      continue
    }

    // Current byte is '<'
    if pos + 1 >= len {
      return Err(make_err(src, pos, XmlErrorKind::UnexpectedEof, "unexpected EOF after '<'"))
    }
    let b1 = src.code_unit_at(pos + 1)
    if b1 == 0x2F {
      // End tag `</name>`
      if depth == 0 {
        return Err(make_err(src, pos, XmlErrorKind::MismatchedTag, "unexpected end tag"))
      }
      let open_id = cur_parent
      let open_node = nodes[open_id]
      let name_start = pos + 2
      let p_len = open_node.s2_end - open_node.s2_start
      let l_len = open_node.s1_end - open_node.s1_start
      let expected_end = if p_len > 0 {
        name_start + p_len + 1 + l_len
      } else {
        name_start + l_len
      }
      let mut fast_ok = false
      if expected_end < len && src.code_unit_at(expected_end) == 0x3E {
        if p_len == 0 {
          fast_ok = raw_slice_eq(
            src,
            name_start,
            expected_end,
            open_node.s1_start,
            open_node.s1_end,
          )
        } else if src.code_unit_at(name_start + p_len) == 0x3A {
          fast_ok = raw_slice_eq(
            src,
            name_start,
            name_start + p_len,
            open_node.s2_start,
            open_node.s2_end,
          ) &&
          raw_slice_eq(
            src,
            name_start + p_len + 1,
            expected_end,
            open_node.s1_start,
            open_node.s1_end,
          )
        }
      }
      if fast_ok {
        finalize_children(nodes, open_id, cur_fc, cur_lc)
        depth = depth - 1
        cur_parent = match elem_stack.pop() {
          Some(v) => v
          None => 0
        }
        cur_fc = match first_child_stack.pop() {
          Some(v) => v
          None => -1
        }
        cur_lc = match last_child_stack.pop() {
          Some(v) => v
          None => -1
        }
        let prev_ns_len = match ns_scope_stack.pop() {
          Some(v) => v
          None => 0
        }
        while active_ns.length() > prev_ns_len {
          let _ = active_ns.pop()
          cached_ns_idx = -1
        }
        cur_default_ns = match default_ns_stack.pop() {
          Some(v) => v
          None => -1
        }
        pos = expected_end + 1
        continue
      }
      let (name_end, colon_pos) = scan_qname(src, name_start, len)
      if name_end < 0 {
        return Err(make_err(src, name_start, XmlErrorKind::InvalidName, "invalid end tag name"))
      }
      let after_ws = skip_ws(src, name_end, len)
      if after_ws >= len || src.code_unit_at(after_ws) != 0x3E {
        return Err(make_err(src, after_ws, XmlErrorKind::InvalidSyntax, "expected '>' closing end tag"))
      }
      let open_has_prefix = p_len > 0
      let end_has_prefix = colon_pos >= 0
      let end_ls = if end_has_prefix { colon_pos + 1 } else { name_start }
      if open_has_prefix != end_has_prefix ||
      !raw_slice_eq(src, open_node.s1_start, open_node.s1_end, end_ls, name_end) ||
      (open_has_prefix &&
        !raw_slice_eq(src, open_node.s2_start, open_node.s2_end, name_start, colon_pos)) {
        return Err(make_err(src, name_start, XmlErrorKind::MismatchedTag, "mismatched end tag"))
      }
      finalize_children(nodes, open_id, cur_fc, cur_lc)
      depth = depth - 1
      cur_parent = match elem_stack.pop() {
        Some(v) => v
        None => 0
      }
      cur_fc = match first_child_stack.pop() {
        Some(v) => v
        None => -1
      }
      cur_lc = match last_child_stack.pop() {
        Some(v) => v
        None => -1
      }
      let prev_ns_len = match ns_scope_stack.pop() {
        Some(v) => v
        None => 0
      }
      while active_ns.length() > prev_ns_len {
        let _ = active_ns.pop()
        cached_ns_idx = -1
      }
      cur_default_ns = match default_ns_stack.pop() {
        Some(v) => v
        None => -1
      }
      pos = after_ws + 1
      continue
    } else if b1 == 0x21 {
      // Comment or CDATA inside element
      if pos + 4 <= len && src.code_unit_at(pos + 2) == 0x2D && src.code_unit_at(pos + 3) == 0x2D {
        match scan_comment(src, pos + 4, len) {
          Ok((cs, ce, has_cr, ni)) => {
            if nodes.length() >= max_nodes {
              return Err(make_err(src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
            }
            let mut vs = cs
            let mut ve = ce
            if has_cr {
              let idx = strings.length()
              strings.push(normalize_eol(src, cs, ce))
              vs = -(idx + 1)
              ve = 0
            }
            let cid = nodes.length()
            nodes.push(
              NodeData::{
                kind_ns: pack_kind_ns(node_kind_comment, -1),
                parent: cur_parent,
                prev_sibling: cur_lc,
                next_sibling: -1,
                first_child: -1,
                last_child: -1,
                s1_start: vs,
                s1_end: ve,
                s2_start: 0,
                s2_end: 0,
                attrs_start: 0,
                attrs_end: 0,
                ns_start: 0,
                ns_end: 0,
              },
            )
            if cur_lc >= 0 {
              set_next_sibling(nodes, cur_lc, cid)
            } else {
              cur_fc = cid
            }
            cur_lc = cid
            pos = ni
            continue
          }
          Err(e) => return Err(e)
        }
      } else if pos + 9 <= len && src.code_unit_at(pos + 2) == 0x5B && raw_slice_eq_str(src, pos, pos + 9, "<![CDATA[") {
        match scan_cdata(src, pos + 9, len) {
          Ok((cs, ce, has_cr, ni)) => {
            let mut vs = cs
            let mut ve = ce
            if has_cr {
              let idx = strings.length()
              strings.push(normalize_eol(src, cs, ce))
              vs = -(idx + 1)
              ve = 0
            }
            if cur_lc < 0 {
              if !(vs >= 0 && vs == ve) {
                if nodes.length() >= max_nodes {
                  return Err(make_err(src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
                }
                let cid = nodes.length()
                nodes.push(
                  NodeData::{
                    kind_ns: pack_kind_ns(node_kind_text, -1),
                    parent: cur_parent,
                    prev_sibling: -1,
                    next_sibling: -1,
                    first_child: -1,
                    last_child: -1,
                    s1_start: vs,
                    s1_end: ve,
                    s2_start: 0,
                    s2_end: 0,
                    attrs_start: 0,
                    attrs_end: 0,
                    ns_start: 0,
                    ns_end: 0,
                  },
                )
                cur_fc = cid
                cur_lc = cid
              }
            } else {
              match append_or_merge_text_slow(
                src,
                strings,
                nodes,
                cur_parent,
                cur_lc,
                vs,
                ve,
                max_nodes,
                pos,
              ) {
                Ok(new_lc) => cur_lc = new_lc
                Err(e) => return Err(e)
              }
            }
            pos = ni
            continue
          }
          Err(e) => return Err(e)
        }
      } else {
        return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "unexpected '<!' inside element"))
      }
    } else if b1 == 0x3F {
      // PI inside element
      match scan_pi(src, pos + 2, len) {
        Ok((ts, te, vs_raw, ve_raw, has_val, has_cr, ni)) => {
          if nodes.length() >= max_nodes {
            return Err(make_err(src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
          }
          let mut vs = 0
          let mut ve = 0
          if has_val {
            if has_cr {
              let idx = strings.length()
              strings.push(normalize_eol(src, vs_raw, ve_raw))
              vs = -(idx + 1)
              ve = 0
            } else {
              vs = vs_raw
              ve = ve_raw
            }
          }
          let cid = nodes.length()
          nodes.push(
            NodeData::{
              kind_ns: pack_kind_ns(node_kind_pi, if has_val { 1 } else { 0 }),
              parent: cur_parent,
              prev_sibling: cur_lc,
              next_sibling: -1,
              first_child: -1,
              last_child: -1,
              s1_start: ts,
              s1_end: te,
              s2_start: vs,
              s2_end: ve,
              attrs_start: 0,
              attrs_end: 0,
              ns_start: 0,
              ns_end: 0,
            },
          )
          if cur_lc >= 0 {
            set_next_sibling(nodes, cur_lc, cid)
          } else {
            cur_fc = cid
          }
          cur_lc = cid
          pos = ni
          continue
        }
        Err(e) => return Err(e)
      }
    }

    // Start or Empty element tag `<name ...>` / `<name .../>`
    if depth >= max_depth {
      return Err(make_err(src, pos, XmlErrorKind::LimitExceeded, "max_depth limit exceeded"))
    }
    if nodes.length() >= max_nodes {
      return Err(make_err(src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
    }
    let tag_start = pos + 1
    // Inline fast ASCII QName scan for tag name
    let mut tag_end = tag_start
    let mut tag_colon = -1
    if tag_start < len && b1 < 0x80 && (lut[b1] & mask_ncname_start) != 0 {
      tag_end = tag_start + 1
      while tag_end < len {
        let tb = src.code_unit_at(tag_end)
        if tb < 0x80 && (lut[tb] & mask_ncname_char) != 0 {
          tag_end = tag_end + 1
        } else {
          break
        }
      }
      if tag_end < len {
        let tb = src.code_unit_at(tag_end)
        if tb == 0x3A {
          tag_colon = tag_end
          tag_end = tag_end + 1
          if tag_end < len && src.code_unit_at(tag_end) < 0x80 && (lut[src.code_unit_at(tag_end)] & mask_ncname_start) != 0 {
            tag_end = tag_end + 1
            while tag_end < len {
              let tb2 = src.code_unit_at(tag_end)
              if tb2 < 0x80 && (lut[tb2] & mask_ncname_char) != 0 {
                tag_end = tag_end + 1
              } else {
                break
              }
            }
            if tag_end < len && (src.code_unit_at(tag_end) >= 0x80 || src.code_unit_at(tag_end) == 0x3A) {
              let (te2, tc2) = scan_qname(src, tag_start, len)
              tag_end = te2
              tag_colon = tc2
            }
          } else {
            let (te2, tc2) = scan_qname(src, tag_start, len)
            tag_end = te2
            tag_colon = tc2
          }
        } else if tb >= 0x80 {
          let (te2, tc2) = scan_qname(src, tag_start, len)
          tag_end = te2
          tag_colon = tc2
        }
      }
    } else {
      let (te2, tc2) = scan_qname(src, tag_start, len)
      tag_end = te2
      tag_colon = tc2
    }
    if tag_end < 0 {
      return Err(make_err(src, tag_start, XmlErrorKind::InvalidName, "invalid element tag name"))
    }
    let tag_has_prefix = tag_colon >= 0
    let tag_p_start = if tag_has_prefix { tag_start } else { 0 }
    let tag_p_end = if tag_has_prefix { tag_colon } else { 0 }
    let tag_l_start = if tag_has_prefix { tag_colon + 1 } else { tag_start }
    let tag_l_end = tag_end
    if tag_has_prefix &&
    tag_colon - tag_start == 5 &&
    b1 == 0x78 &&
    raw_slice_eq_str(src, tag_start, tag_colon, "xmlns") {
      return Err(
        make_err(src, tag_start, XmlErrorKind::InvalidNamespace, "element cannot use 'xmlns' prefix"),
      )
    }

    // Parse attributes and xmlns declarations directly into `attrs` / `namespaces`
    let mut i = tag_end
    let ns_start = namespaces.length()
    let prev_active_ns_len = active_ns.length()
    let prev_default_ns = cur_default_ns
    let attrs_start = attrs.length()
    let mut is_empty = false
    let mut attr_count = 0
    let mut has_prefixed_attr = false

    // Fast path for zero-attribute tags (`<tag>` or `<tag/>`)
    let mut scan_attrs = true
    if i < len {
      let nb = src.code_unit_at(i)
      if nb == 0x3E {
        i = i + 1
        scan_attrs = false
      } else if nb == 0x2F {
        if i + 1 >= len || src.code_unit_at(i + 1) != 0x3E {
          return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected '>' after '/' in empty tag"))
        }
        is_empty = true
        i = i + 2
        scan_attrs = false
      }
    }

    while scan_attrs && i < len {
      let ws_before = i
      let b_ws = src.code_unit_at(i)
      if b_ws == 0x20 {
        i = i + 1
        if i < len && src.code_unit_at(i) <= 0x20 {
          i = skip_ws(src, i, len)
        }
      } else if b_ws <= 0x20 {
        i = skip_ws(src, i, len)
      }
      if i >= len {
        return Err(make_err(src, i, XmlErrorKind::UnexpectedEof, "unterminated start tag"))
      }
      let cb = src.code_unit_at(i)
      if cb == 0x3E {
        i = i + 1
        break
      }
      if cb == 0x2F {
        if i + 1 >= len || src.code_unit_at(i + 1) != 0x3E {
          return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected '>' after '/' in empty tag"))
        }
        is_empty = true
        i = i + 2
        break
      }
      if i == ws_before {
        return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected whitespace before attribute"))
      }
      attr_count = attr_count + 1
      if attr_count > max_attributes {
        return Err(make_err(src, i, XmlErrorKind::LimitExceeded, "max_attributes limit exceeded"))
      }
      let aname_start = i
      // Inline fast ASCII QName scan for attribute name
      let mut aname_end = aname_start
      let mut acolon = -1
      if cb < 0x80 && (lut[cb] & mask_ncname_start) != 0 {
        aname_end = aname_start + 1
        while aname_end < len {
          let ab = src.code_unit_at(aname_end)
          if ab < 0x80 && (lut[ab] & mask_ncname_char) != 0 {
            aname_end = aname_end + 1
          } else {
            break
          }
        }
        if aname_end < len {
          let ab = src.code_unit_at(aname_end)
          if ab == 0x3A {
            acolon = aname_end
            aname_end = aname_end + 1
            if aname_end < len && src.code_unit_at(aname_end) < 0x80 && (lut[src.code_unit_at(aname_end)] & mask_ncname_start) != 0 {
              aname_end = aname_end + 1
              while aname_end < len {
                let ab2 = src.code_unit_at(aname_end)
                if ab2 < 0x80 && (lut[ab2] & mask_ncname_char) != 0 {
                  aname_end = aname_end + 1
                } else {
                  break
                }
              }
              if aname_end < len && (src.code_unit_at(aname_end) >= 0x80 || src.code_unit_at(aname_end) == 0x3A) {
                let (ae2, ac2) = scan_qname(src, aname_start, len)
                aname_end = ae2
                acolon = ac2
              }
            } else {
              let (ae2, ac2) = scan_qname(src, aname_start, len)
              aname_end = ae2
              acolon = ac2
            }
          } else if ab >= 0x80 {
            let (ae2, ac2) = scan_qname(src, aname_start, len)
            aname_end = ae2
            acolon = ac2
          }
        }
      } else {
        let (ae2, ac2) = scan_qname(src, aname_start, len)
        aname_end = ae2
        acolon = ac2
      }
      if aname_end < 0 {
        return Err(make_err(src, aname_start, XmlErrorKind::InvalidName, "invalid attribute name"))
      }
      i = aname_end
      if i < len && src.code_unit_at(i) <= 0x20 {
        i = skip_ws(src, i, len)
      }
      if i >= len || src.code_unit_at(i) != 0x3D {
        return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected '=' after attribute name"))
      }
      i = i + 1
      if i < len && src.code_unit_at(i) <= 0x20 {
        i = skip_ws(src, i, len)
      }
      if i >= len {
        return Err(make_err(src, i, XmlErrorKind::UnexpectedEof, "expected attribute value quote"))
      }
      let quote = src.code_unit_at(i)
      if quote != 0x22 && quote != 0x27 {
        return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "attribute value must be quoted"))
      }
      i = i + 1
      let aval_start = i
      let fast_mask = if quote == 0x22 { mask_attr_dq_fast } else { mask_attr_sq_fast }
      let mut needs_unescape = false
      while i < len {
        while i <= len - 4 {
          let m0 = lut[src.code_unit_at(i)]
          let m1 = lut[src.code_unit_at(i + 1)]
          let m2 = lut[src.code_unit_at(i + 2)]
          let m3 = lut[src.code_unit_at(i + 3)]
          if ((m0 & m1 & m2 & m3) & fast_mask) != 0 {
            i = i + 4
          } else {
            break
          }
        }
        if i >= len {
          break
        }
        let ab = src.code_unit_at(i)
        if ab == quote {
          break
        }
        if ab < 0x80 {
          if (lut[ab] & fast_mask) != 0 {
            i = i + 1
          } else if ab == 0x26 || ab == 0x09 || ab == 0x0A || ab == 0x0D {
            needs_unescape = true
            i = i + 1
          } else if ab == 0x3C {
            return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "'<' not allowed in attribute value"))
          } else {
            return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in attribute value"))
          }
        } else {
          let (cp, blen) = decode_utf8(src, i, len)
          if cp < 0 || !is_xml_char(cp) {
            return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in attribute value"))
          }
          i = i + blen
        }
      }
      if i >= len || src.code_unit_at(i) != quote {
        return Err(make_err(src, aval_start, XmlErrorKind::UnexpectedEof, "unterminated attribute value"))
      }
      let aval_end = i
      i = i + 1

      let mut vs = aval_start
      let mut ve = aval_end
      if needs_unescape {
        match unescape_span(src, aval_start, aval_end, true, entities, budget) {
          Ok(s) => {
            let idx = strings.length()
            strings.push(s)
            vs = -(idx + 1)
            ve = 0
          }
          Err(e) => return Err(e)
        }
      }

      let a_has_prefix = acolon >= 0
      let is_default_xmlns = !a_has_prefix &&
      aname_end - aname_start == 5 &&
      cb == 0x78 &&
      raw_slice_eq_str(src, aname_start, aname_end, "xmlns")
      let is_prefixed_xmlns = a_has_prefix &&
      acolon - aname_start == 5 &&
      cb == 0x78 &&
      raw_slice_eq_str(src, aname_start, acolon, "xmlns")

      if is_default_xmlns {
        let aval_span = TextSpan::{ start: vs, end: ve }
        let mut k = ns_start
        while k < namespaces.length() {
          if !namespaces[k].has_prefix {
            return Err(make_err(src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate xmlns attribute"))
          }
          k = k + 1
        }
        if span_eq_str(src, strings, aval_span, xml_ns_uri) ||
        span_eq_str(src, strings, aval_span, xmlns_ns_uri) {
          return Err(make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "cannot bind default namespace to reserved URI"))
        }
        let ns_idx = namespaces.length()
        namespaces.push(
          NsData::{
            prefix_span: TextSpan::empty(),
            uri_span: aval_span,
            has_prefix: false,
          },
        )
        active_ns.push(ns_idx)
        cur_default_ns = if aval_span.is_empty() { -1 } else { ns_idx }
      } else if is_prefixed_xmlns {
        let aval_span = TextSpan::{ start: vs, end: ve }
        let pspan = TextSpan::from_range(acolon + 1, aname_end)
        let mut k = ns_start
        while k < namespaces.length() {
          if namespaces[k].has_prefix &&
          span_eq_span(src, strings, namespaces[k].prefix_span, pspan) {
            return Err(make_err(src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate xmlns prefix declaration"))
          }
          k = k + 1
        }
        if aval_span.is_empty() {
          return Err(make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "prefixed namespace URI cannot be empty"))
        }
        if span_eq_str(src, strings, pspan, "xmlns") {
          return Err(make_err(src, aname_start, XmlErrorKind::InvalidNamespace, "cannot declare prefix 'xmlns'"))
        }
        if span_eq_str(src, strings, pspan, "xml") {
          if !span_eq_str(src, strings, aval_span, xml_ns_uri) {
            return Err(make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "prefix 'xml' can only be bound to XML namespace"))
          }
        } else {
          if span_eq_str(src, strings, aval_span, xml_ns_uri) {
            return Err(make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "only prefix 'xml' may bind to XML namespace"))
          }
        }
        if span_eq_str(src, strings, aval_span, xmlns_ns_uri) {
          return Err(make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "no prefix may bind to xmlns namespace"))
        }
        let ns_idx = namespaces.length()
        namespaces.push(
          NsData::{
            prefix_span: pspan,
            uri_span: aval_span,
            has_prefix: true,
          },
        )
        active_ns.push(ns_idx)
        cached_ns_idx = -1
      } else if !a_has_prefix {
        let alen = aname_end - aname_start
        let mut aj = attrs_start
        let cur_alen = attrs.length()
        while aj < cur_alen {
          let prev_a = attrs[aj]
          if prev_a.ns_idx == -1 &&
          prev_a.local_end - prev_a.local_start == alen &&
          src.code_unit_at(prev_a.local_start) == cb &&
          raw_slice_eq(
            src,
            prev_a.local_start,
            prev_a.local_end,
            aname_start,
            aname_end,
          ) {
            return Err(
              make_err(src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"),
            )
          }
          aj = aj + 1
        }
        attrs.push(
          AttrData::{
            local_start: aname_start,
            local_end: aname_end,
            prefix_start: 0,
            prefix_end: 0,
            val_start: vs,
            val_end: ve,
            ns_idx: -1,
          },
        )
      } else {
        has_prefixed_attr = true
        attrs.push(
          AttrData::{
            local_start: acolon + 1,
            local_end: aname_end,
            prefix_start: aname_start,
            prefix_end: acolon,
            val_start: vs,
            val_end: ve,
            ns_idx: -3,
          },
        )
      }
    }

    // Resolve element namespace (O(1) for unprefixed and 1-entry cache for prefixed!)
    let elem_ns_idx = if tag_has_prefix {
      if cached_ns_idx >= 0 &&
      cached_ns_p_end - cached_ns_p_start == tag_p_end - tag_p_start &&
      src.code_unit_at(cached_ns_p_start) == b1 &&
      raw_slice_eq(src, cached_ns_p_start, cached_ns_p_end, tag_p_start, tag_p_end) {
        cached_ns_idx
      } else {
        let r = resolve_ns_prefix(src, namespaces, active_ns, tag_p_start, tag_p_end)
        if r == -1 {
          return Err(
            make_err(src, tag_start, XmlErrorKind::UnboundNamespacePrefix, "unbound namespace prefix on element"),
          )
        }
        cached_ns_p_start = tag_p_start
        cached_ns_p_end = tag_p_end
        cached_ns_idx = r
        r
      }
    } else {
      cur_default_ns
    }

    let attrs_end = attrs.length()
    if has_prefixed_attr {
      let mut ai = attrs_start
      while ai < attrs_end {
        let cur_a = attrs[ai]
        if cur_a.ns_idx == -3 {
          let ans_idx = resolve_ns_prefix(
            src,
            namespaces,
            active_ns,
            cur_a.prefix_start,
            cur_a.prefix_end,
          )
          if ans_idx == -1 {
            return Err(
              make_err(src, cur_a.prefix_start, XmlErrorKind::UnboundNamespacePrefix, "unbound namespace prefix on attribute"),
            )
          }
          attrs[ai] = AttrData::{
            local_start: cur_a.local_start,
            local_end: cur_a.local_end,
            prefix_start: cur_a.prefix_start,
            prefix_end: cur_a.prefix_end,
            val_start: cur_a.val_start,
            val_end: cur_a.val_end,
            ns_idx: ans_idx,
          }
          let llen = cur_a.local_end - cur_a.local_start
          let l0 = src.code_unit_at(cur_a.local_start)
          let mut aj = attrs_start
          while aj < ai {
            let prev_a = attrs[aj]
            if prev_a.ns_idx != -1 &&
            prev_a.local_end - prev_a.local_start == llen &&
            src.code_unit_at(prev_a.local_start) == l0 &&
            raw_slice_eq(
              src,
              prev_a.local_start,
              prev_a.local_end,
              cur_a.local_start,
              cur_a.local_end,
            ) {
              let same_ns = if prev_a.ns_idx == ans_idx {
                true
              } else if prev_a.ns_idx >= 0 && ans_idx >= 0 {
                span_eq_span(
                  src,
                  strings,
                  namespaces[prev_a.ns_idx].uri_span,
                  namespaces[ans_idx].uri_span,
                )
              } else {
                false
              }
              if same_ns {
                return Err(
                  make_err(src, cur_a.prefix_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"),
                )
              }
            }
            aj = aj + 1
          }
        }
        ai = ai + 1
      }
    }
    let ns_end = namespaces.length()

    let elem_id = nodes.length()
    nodes.push(
      NodeData::{
        kind_ns: pack_kind_ns(node_kind_element, elem_ns_idx),
        parent: cur_parent,
        prev_sibling: cur_lc,
        next_sibling: -1,
        first_child: -1,
        last_child: -1,
        s1_start: tag_l_start,
        s1_end: tag_l_end,
        s2_start: tag_p_start,
        s2_end: tag_p_end,
        attrs_start: attrs_start,
        attrs_end: attrs_end,
        ns_start: ns_start,
        ns_end: ns_end,
      },
    )
    if cur_lc >= 0 {
      set_next_sibling(nodes, cur_lc, elem_id)
    } else {
      cur_fc = elem_id
    }
    cur_lc = elem_id
    if root_elem_id < 0 {
      root_elem_id = elem_id
    }
    if is_empty {
      while active_ns.length() > prev_active_ns_len {
        let _ = active_ns.pop()
        cached_ns_idx = -1
      }
      cur_default_ns = prev_default_ns
    } else {
      elem_stack.push(cur_parent)
      first_child_stack.push(cur_fc)
      last_child_stack.push(cur_lc)
      ns_scope_stack.push(prev_active_ns_len)
      default_ns_stack.push(prev_default_ns)
      depth = depth + 1
      cur_parent = elem_id
      cur_fc = -1
      cur_lc = -1
    }
    pos = i
  }

  if depth > 0 {
    return Err(make_err(src, len, XmlErrorKind::UnclosedTag, "unclosed element tag"))
  }
  if root_elem_id < 0 {
    return Err(make_err(src, len, XmlErrorKind::NoRootNode, "document has no root element"))
  }
  finalize_children(nodes, 0, cur_fc, cur_lc)
  Ok(
    Document::{
      src: src,
      strings: strings,
      nodes: nodes,
      attrs: attrs,
      namespaces: namespaces,
      root_elem_id: root_elem_id,
    },
  )
}

///| Resolve a `ns_idx` stored in `NodeData` or `AttrData` into `Option[String]`.
fn doc_ns_uri(doc : Document, ns_idx : Int) -> Option[String] {
  if ns_idx == -2 {
    Some(xml_ns_uri)
  } else if ns_idx >= 0 {
    Some(span_to_string(doc.src, doc.strings, doc.namespaces[ns_idx].uri_span))
  } else {
    None
  }
}

///| Check whether `ns_idx` equals a target URI string without allocating.
fn doc_ns_uri_eq(doc : Document, ns_idx : Int, target : String) -> Bool {
  if ns_idx == -2 {
    target == xml_ns_uri
  } else if ns_idx >= 0 {
    span_eq_str(doc.src, doc.strings, doc.namespaces[ns_idx].uri_span, target)
  } else {
    false
  }
}

///|
pub fn Document::root(self : Document) -> Node {
  Node::{ doc: self, id: 0 }
}

///|
pub fn Document::root_element(self : Document) -> Node {
  Node::{ doc: self, id: self.root_elem_id }
}

///| Zero-allocation indexed DOM traversal helpers on `Document`.
pub fn Document::node_kind_at(self : Document, id : Int) -> Int {
  unpack_kind(self.nodes[id].kind_ns)
}

///|
pub fn Document::tag_name_len_at(self : Document, id : Int) -> Int {
  let nd = self.nodes[id]
  nd.s1_end - nd.s1_start
}

///|
pub fn Document::has_namespace_at(self : Document, id : Int) -> Bool {
  unpack_ns(self.nodes[id].kind_ns) != -1
}

///|
pub fn Document::attrs_range_at(self : Document, id : Int) -> (Int, Int) {
  let nd = self.nodes[id]
  (nd.attrs_start, nd.attrs_end)
}

///|
pub fn Document::attr_value_len_raw(self : Document, attr_idx : Int) -> Int {
  let a = self.attrs[attr_idx]
  if a.val_start < 0 {
    self.strings[-(a.val_start + 1)].length()
  } else {
    a.val_end - a.val_start
  }
}

///|
pub fn Document::text_len_at(self : Document, id : Int) -> Int {
  let nd = self.nodes[id]
  if nd.s1_start < 0 {
    self.strings[-(nd.s1_start + 1)].length()
  } else {
    nd.s1_end - nd.s1_start
  }
}

///|
pub fn Document::node_count(self : Document) -> Int {
  self.nodes.length()
}

///|
pub fn Document::node(self : Document, id : Int) -> Option[Node] {
  if id >= 0 && id < self.nodes.length() {
    Some(Node::{ doc: self, id: id })
  } else {
    None
  }
}

///|
pub fn Document::descendants(self : Document) -> Array[Node] {
  self.root().descendants()
}

///|
pub fn Node::id(self : Node) -> Int {
  self.id
}

///|
pub fn Node::node_type(self : Node) -> NodeType {
  let k = unpack_kind(self.doc.nodes[self.id].kind_ns)
  if k == node_kind_root {
    NodeType::Root
  } else if k == node_kind_element {
    NodeType::Element
  } else if k == node_kind_text {
    NodeType::Text
  } else if k == node_kind_comment {
    NodeType::Comment
  } else {
    NodeType::PI
  }
}

///|
pub fn Node::is_root(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_root
}

///|
pub fn Node::is_element(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_element
}

///|
pub fn Node::is_text(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_text
}

///|
pub fn Node::is_comment(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_comment
}

///|
pub fn Node::is_pi(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_pi
}

///|
pub fn Node::tag_name(self : Node) -> ExpandedName {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_element {
    return ExpandedName::{ local: "", ns_uri: None, prefix: None }
  }
  let local = span_to_string(
    self.doc.src,
    self.doc.strings,
    TextSpan::{ start: nd.s1_start, end: nd.s1_end },
  )
  let prefix = if nd.s2_start >= 0 && nd.s2_start == nd.s2_end {
    None
  } else {
    Some(
      span_to_string(
        self.doc.src,
        self.doc.strings,
        TextSpan::{ start: nd.s2_start, end: nd.s2_end },
      ),
    )
  }
  let ns_uri = doc_ns_uri(self.doc, unpack_ns(nd.kind_ns))
  ExpandedName::{ local: local, ns_uri: ns_uri, prefix: prefix }
}

///|
pub fn Node::has_tag_name(self : Node, name : String) -> Bool {
  let nd = self.doc.nodes[self.id]
  unpack_kind(nd.kind_ns) == node_kind_element &&
  span_eq_str(
    self.doc.src,
    self.doc.strings,
    TextSpan::{ start: nd.s1_start, end: nd.s1_end },
    name,
  )
}

///|
pub fn Node::has_tag_name_ns(self : Node, ns : String, local : String) -> Bool {
  let nd = self.doc.nodes[self.id]
  unpack_kind(nd.kind_ns) == node_kind_element &&
  doc_ns_uri_eq(self.doc, unpack_ns(nd.kind_ns), ns) &&
  span_eq_str(
    self.doc.src,
    self.doc.strings,
    TextSpan::{ start: nd.s1_start, end: nd.s1_end },
    local,
  )
}

///|
pub fn Node::namespace(self : Node) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_element {
    return None
  }
  doc_ns_uri(self.doc, unpack_ns(nd.kind_ns))
}

///|
pub fn Node::default_namespace(self : Node) -> Option[String] {
  self.lookup_namespace_uri(None)
}

///|
pub fn Node::lookup_namespace_uri(
  self : Node,
  prefix : Option[String],
) -> Option[String] {
  match prefix {
    Some(p) => {
      if p == "xml" {
        return Some(xml_ns_uri)
      }
      let mut cur = self.id
      while cur >= 0 {
        let nd = self.doc.nodes[cur]
        let mut k = nd.ns_end - 1
        while k >= nd.ns_start {
          let ns = self.doc.namespaces[k]
          if ns.has_prefix &&
          span_eq_str(self.doc.src, self.doc.strings, ns.prefix_span, p) {
            return Some(span_to_string(self.doc.src, self.doc.strings, ns.uri_span))
          }
          k = k - 1
        }
        cur = nd.parent
      }
      None
    }
    None => {
      let mut cur = self.id
      while cur >= 0 {
        let nd = self.doc.nodes[cur]
        let mut k = nd.ns_end - 1
        while k >= nd.ns_start {
          let ns = self.doc.namespaces[k]
          if !ns.has_prefix {
            if ns.uri_span.is_empty() {
              return None
            }
            return Some(span_to_string(self.doc.src, self.doc.strings, ns.uri_span))
          }
          k = k - 1
        }
        cur = nd.parent
      }
      None
    }
  }
}

///|
pub fn Node::lookup_prefix(self : Node, uri : String) -> Option[String] {
  if uri == xml_ns_uri {
    return Some("xml")
  }
  let mut cur = self.id
  while cur >= 0 {
    let nd = self.doc.nodes[cur]
    let mut k = nd.ns_end - 1
    while k >= nd.ns_start {
      let ns = self.doc.namespaces[k]
      if ns.has_prefix &&
      span_eq_str(self.doc.src, self.doc.strings, ns.uri_span, uri) {
        return Some(span_to_string(self.doc.src, self.doc.strings, ns.prefix_span))
      }
      k = k - 1
    }
    cur = nd.parent
  }
  None
}

///|
pub fn Node::namespaces(self : Node) -> Array[Namespace] {
  let nd = self.doc.nodes[self.id]
  let out : Array[Namespace] = []
  let mut k = nd.ns_start
  while k < nd.ns_end {
    let ns = self.doc.namespaces[k]
    let p = if ns.has_prefix {
      Some(span_to_string(self.doc.src, self.doc.strings, ns.prefix_span))
    } else {
      None
    }
    let u = span_to_string(self.doc.src, self.doc.strings, ns.uri_span)
    out.push(Namespace::{ prefix: p, uri: u })
    k = k + 1
  }
  out
}

///|
pub fn Node::attribute(self : Node, name : String) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let a = self.doc.attrs[i]
    if a.ns_idx == -1 &&
    raw_slice_eq_str(self.doc.src, a.local_start, a.local_end, name) {
      return Some(
        span_to_string(
          self.doc.src,
          self.doc.strings,
          TextSpan::{ start: a.val_start, end: a.val_end },
        ),
      )
    }
    i = i + 1
  }
  None
}

///|
pub fn Node::attribute_ns(
  self : Node,
  ns : String,
  local : String,
) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let a = self.doc.attrs[i]
    if doc_ns_uri_eq(self.doc, a.ns_idx, ns) &&
    raw_slice_eq_str(self.doc.src, a.local_start, a.local_end, local) {
      return Some(
        span_to_string(
          self.doc.src,
          self.doc.strings,
          TextSpan::{ start: a.val_start, end: a.val_end },
        ),
      )
    }
    i = i + 1
  }
  None
}

///|
pub fn Node::has_attribute(self : Node, name : String) -> Bool {
  let nd = self.doc.nodes[self.id]
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let a = self.doc.attrs[i]
    if a.ns_idx == -1 &&
    raw_slice_eq_str(self.doc.src, a.local_start, a.local_end, name) {
      return true
    }
    i = i + 1
  }
  false
}

///|
pub fn Node::attributes(self : Node) -> Array[Attribute] {
  let nd = self.doc.nodes[self.id]
  let out : Array[Attribute] = Array::with_capacity(nd.attrs_end - nd.attrs_start)
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let a = self.doc.attrs[i]
    let local = self.doc.src.slice(a.local_start, a.local_end)
    let prefix = if a.prefix_start == a.prefix_end {
      None
    } else {
      Some(self.doc.src.slice(a.prefix_start, a.prefix_end))
    }
    let ns_uri = doc_ns_uri(self.doc, a.ns_idx)
    let value = span_to_string(
      self.doc.src,
      self.doc.strings,
      TextSpan::{ start: a.val_start, end: a.val_end },
    )
    out.push(Attribute::{ local: local, ns_uri: ns_uri, prefix: prefix, value: value })
    i = i + 1
  }
  out
}

///|
pub fn Node::attribute_count(self : Node) -> Int {
  let nd = self.doc.nodes[self.id]
  nd.attrs_end - nd.attrs_start
}

///| Zero-allocation byte length of an element's local tag name.
pub fn Node::tag_name_len(self : Node) -> Int {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_element {
    return 0
  }
  nd.s1_end - nd.s1_start
}

///| Zero-allocation check whether an element has a resolved namespace.
pub fn Node::has_namespace(self : Node) -> Bool {
  let nd = self.doc.nodes[self.id]
  unpack_kind(nd.kind_ns) == node_kind_element && unpack_ns(nd.kind_ns) != -1
}

///| Zero-allocation byte length of the `idx`-th attribute's value on this node.
pub fn Node::attr_value_len(self : Node, idx : Int) -> Int {
  let nd = self.doc.nodes[self.id]
  let pos = nd.attrs_start + idx
  if idx < 0 || pos >= nd.attrs_end {
    return 0
  }
  let a = self.doc.attrs[pos]
  if a.val_start < 0 {
    self.doc.strings[-(a.val_start + 1)].length()
  } else {
    a.val_end - a.val_start
  }
}

///| Zero-allocation byte length of a text/comment node (or an element's first text child).
pub fn Node::text_len(self : Node) -> Int {
  let nd = self.doc.nodes[self.id]
  let k = unpack_kind(nd.kind_ns)
  if k == node_kind_text || k == node_kind_comment {
    return if nd.s1_start < 0 {
      self.doc.strings[-(nd.s1_start + 1)].length()
    } else {
      nd.s1_end - nd.s1_start
    }
  }
  if k == node_kind_element {
    let fc = nd.first_child
    if fc >= 0 && unpack_kind(self.doc.nodes[fc].kind_ns) == node_kind_text {
      let fn_nd = self.doc.nodes[fc]
      return if fn_nd.s1_start < 0 {
        self.doc.strings[-(fn_nd.s1_start + 1)].length()
      } else {
        fn_nd.s1_end - fn_nd.s1_start
      }
    }
  }
  0
}

///|
pub fn Node::text(self : Node) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  let k = unpack_kind(nd.kind_ns)
  if k == node_kind_text || k == node_kind_comment {
    return Some(
      span_to_string(
        self.doc.src,
        self.doc.strings,
        TextSpan::{ start: nd.s1_start, end: nd.s1_end },
      ),
    )
  }
  if k == node_kind_element {
    let fc = nd.first_child
    if fc >= 0 && unpack_kind(self.doc.nodes[fc].kind_ns) == node_kind_text {
      let fnd = self.doc.nodes[fc]
      return Some(
        span_to_string(
          self.doc.src,
          self.doc.strings,
          TextSpan::{ start: fnd.s1_start, end: fnd.s1_end },
        ),
      )
    }
  }
  None
}

///|
pub fn Node::pi(self : Node) -> Option[PI] {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_pi {
    return None
  }
  let target = self.doc.src.slice(nd.s1_start, nd.s1_end)
  let value = if unpack_ns(nd.kind_ns) != 0 {
    Some(
      span_to_string(
        self.doc.src,
        self.doc.strings,
        TextSpan::{ start: nd.s2_start, end: nd.s2_end },
      ),
    )
  } else {
    None
  }
  Some(PI::{ target: target, value: value })
}

///|
pub fn Node::parent(self : Node) -> Option[Node] {
  let p = self.doc.nodes[self.id].parent
  if p >= 0 {
    Some(Node::{ doc: self.doc, id: p })
  } else {
    None
  }
}

///|
pub fn Node::first_child(self : Node) -> Option[Node] {
  let fc = self.doc.nodes[self.id].first_child
  if fc >= 0 {
    Some(Node::{ doc: self.doc, id: fc })
  } else {
    None
  }
}

///|
pub fn Node::last_child(self : Node) -> Option[Node] {
  let lc = self.doc.nodes[self.id].last_child
  if lc >= 0 {
    Some(Node::{ doc: self.doc, id: lc })
  } else {
    None
  }
}

///|
pub fn Node::prev_sibling(self : Node) -> Option[Node] {
  let ps = self.doc.nodes[self.id].prev_sibling
  if ps >= 0 {
    Some(Node::{ doc: self.doc, id: ps })
  } else {
    None
  }
}

///|
pub fn Node::next_sibling(self : Node) -> Option[Node] {
  let ns = self.doc.nodes[self.id].next_sibling
  if ns >= 0 {
    Some(Node::{ doc: self.doc, id: ns })
  } else {
    None
  }
}

///|
pub fn Node::first_element_child(self : Node) -> Option[Node] {
  let mut cur = self.doc.nodes[self.id].first_child
  while cur >= 0 {
    if unpack_kind(self.doc.nodes[cur].kind_ns) == node_kind_element {
      return Some(Node::{ doc: self.doc, id: cur })
    }
    cur = self.doc.nodes[cur].next_sibling
  }
  None
}

///|
pub fn Node::next_sibling_element(self : Node) -> Option[Node] {
  let mut cur = self.doc.nodes[self.id].next_sibling
  while cur >= 0 {
    if unpack_kind(self.doc.nodes[cur].kind_ns) == node_kind_element {
      return Some(Node::{ doc: self.doc, id: cur })
    }
    cur = self.doc.nodes[cur].next_sibling
  }
  None
}

///|
pub fn Node::children(self : Node) -> Array[Node] {
  let out : Array[Node] = []
  let mut cur = self.doc.nodes[self.id].first_child
  while cur >= 0 {
    out.push(Node::{ doc: self.doc, id: cur })
    cur = self.doc.nodes[cur].next_sibling
  }
  out
}

///| Iterative pre-order descendants (including `self`), zero recursion.
pub fn Node::descendants(self : Node) -> Array[Node] {
  let out : Array[Node] = []
  let root_id = self.id
  let mut cur = root_id
  while cur >= 0 {
    out.push(Node::{ doc: self.doc, id: cur })
    let nd = self.doc.nodes[cur]
    if nd.first_child >= 0 {
      cur = nd.first_child
    } else if cur == root_id {
      break
    } else if nd.next_sibling >= 0 {
      cur = nd.next_sibling
    } else {
      let mut p = nd.parent
      let mut next = -1
      while p >= 0 && p != root_id {
        if self.doc.nodes[p].next_sibling >= 0 {
          next = self.doc.nodes[p].next_sibling
          break
        }
        p = self.doc.nodes[p].parent
      }
      cur = next
    }
  }
  out
}

///|
pub fn Node::has_children(self : Node) -> Bool {
  self.doc.nodes[self.id].first_child >= 0
}
