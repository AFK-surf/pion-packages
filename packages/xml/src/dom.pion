///| Flat-array read-only XML 1.0 + XML Namespaces 1.0 DOM parser and accessors (inspired by roxmltree).

let node_kind_root : Int = 0

let node_kind_element : Int = 1

let node_kind_text : Int = 2

let node_kind_comment : Int = 3

let node_kind_pi : Int = 4

let xml_ns_uri : String = "http://www.w3.org/XML/1998/namespace"

let xmlns_ns_uri : String = "http://www.w3.org/2000/xmlns/"

fn pack_kind_ns(kind : Int, ns_idx : Int) -> Int {
  (kind & 7) | ((ns_idx + 2) << 3)
}

fn unpack_kind(kind_ns : Int) -> Int {
  kind_ns & 7
}

fn unpack_ns(kind_ns : Int) -> Int {
  (kind_ns >> 3) - 2
}

///| Look up a namespace prefix in the active namespace stack (O(1) via `ns_map` when >8 active bindings,
///| zero-allocation linear scan when <=8).
///| Returns `ns_idx` (`>= 0` in `namespaces`, `-2` for built-in `xml`, `-1` for unbound/none).
fn resolve_ns_prefix(
  doc_src : String,
  cur_src : String,
  strings : Array[String],
  namespaces : Array[NsData],
  active_ns : Array[Int],
  ns_map_active : Bool,
  ns_map : Map[String, Int],
  p_start : Int,
  p_end : Int,
) -> Int {
  let plen = p_end - p_start
  let p0 = cur_src.code_unit_at(p_start)
  if plen == 3 && p0 == 0x78 && raw_slice_eq_str(cur_src, p_start, p_end, "xml") {
    return -2
  }
  if ns_map_active {
    return match ns_map.get(cur_src.slice(p_start, p_end)) {
      Some(idx) => idx
      None => -1
    }
  }
  let mut k = active_ns.length() - 1
  while k >= 0 {
    let ns_idx = active_ns[k]
    let ns = namespaces[ns_idx]
    if ns.has_prefix {
      if ns.prefix_span.start >= 0 {
        if ns.prefix_span.end - ns.prefix_span.start == plen &&
        doc_src.code_unit_at(ns.prefix_span.start) == p0 &&
        str_slice_eq(
          doc_src,
          ns.prefix_span.start,
          ns.prefix_span.end,
          cur_src,
          p_start,
          p_end,
        ) {
          return ns_idx
        }
      } else {
        let pstr = strings[-(ns.prefix_span.start + 1)]
        if pstr.length() == plen && raw_slice_eq_str(cur_src, p_start, p_end, pstr) {
          return ns_idx
        }
      }
    }
    k = k - 1
  }
  -1
}

///| Intern a slice from `cur_src` into `strings` when parsing inside an entity frame;
///| zero-copy `(s, e)` when parsing from the main document `doc_src`.
fn maybe_intern(
  cur_src : String,
  in_entity : Bool,
  strings : Array[String],
  s : Int,
  e : Int,
) -> (Int, Int) {
  if !in_entity {
    return (s, e)
  }
  let idx = strings.length()
  strings.push(cur_src.slice(s, e))
  (-(idx + 1), 0)
}

///| Update previous sibling's `next_sibling` link in `nodes`.
fn set_next_sibling(nodes : Array[NodeData], prev : Int, child_id : Int) -> Unit {
  let pn = nodes[prev]
  nodes[prev] = NodeData::{
    kind_ns: pn.kind_ns,
    parent: pn.parent,
    prev_sibling: pn.prev_sibling,
    next_sibling: child_id,
    first_child: pn.first_child,
    last_child: pn.last_child,
    s1_start: pn.s1_start,
    s1_end: pn.s1_end,
    s2_start: pn.s2_start,
    s2_end: pn.s2_end,
    attrs_start: pn.attrs_start,
    attrs_end: pn.attrs_end,
    ns_start: pn.ns_start,
    ns_end: pn.ns_end,
  }
}

///| Write deferred `first_child` and `last_child` onto `node_id` once when closing it.
fn finalize_children(
  nodes : Array[NodeData],
  node_id : Int,
  fc : Int,
  lc : Int,
) -> Unit {
  if fc >= 0 {
    let nd = nodes[node_id]
    nodes[node_id] = NodeData::{
      kind_ns: nd.kind_ns,
      parent: nd.parent,
      prev_sibling: nd.prev_sibling,
      next_sibling: nd.next_sibling,
      first_child: fc,
      last_child: lc,
      s1_start: nd.s1_start,
      s1_end: nd.s1_end,
      s2_start: nd.s2_start,
      s2_end: nd.s2_end,
      attrs_start: nd.attrs_start,
      attrs_end: nd.attrs_end,
      ns_start: nd.ns_start,
      ns_end: nd.ns_end,
    }
  }
}

///| Update a Text node's `s1_start`/`s1_end` once when flushing a merged text run.
fn update_text_node_span(
  nodes : Array[NodeData],
  node_id : Int,
  s_start : Int,
  s_end : Int,
) -> Unit {
  let prev_node = nodes[node_id]
  nodes[node_id] = NodeData::{
    kind_ns: prev_node.kind_ns,
    parent: prev_node.parent,
    prev_sibling: prev_node.prev_sibling,
    next_sibling: prev_node.next_sibling,
    first_child: prev_node.first_child,
    last_child: prev_node.last_child,
    s1_start: s_start,
    s1_end: s_end,
    s2_start: 0,
    s2_end: 0,
    attrs_start: 0,
    attrs_end: 0,
    ns_start: 0,
    ns_end: 0,
  }
}

///| Parse an XML 1.0 document with default security options (DTD disabled, bounded limits).
pub fn Document::parse(src : String) -> Result[Document, XmlError] {
  Document::parse_with_options(src, ParseOptions::default())
}

///| Parse an XML 1.0 document into a flat-array read-only DOM with custom options.
pub fn Document::parse_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Document, XmlError] {
  let main_len = src.length()
  let mut pos = 0
  // Strip optional UTF-8 BOM (EF BB BF)
  if main_len >= 3 &&
  src.code_unit_at(0) == 0xEF &&
  src.code_unit_at(1) == 0xBB &&
  src.code_unit_at(2) == 0xBF {
    pos = 3
  }

  let est_nodes = if main_len > 64 { main_len / 32 + 16 } else { 16 }
  let est_attrs = if main_len > 64 { main_len / 28 + 16 } else { 16 }
  let nodes : Array[NodeData] = Array::with_capacity(est_nodes)
  let attrs : Array[AttrData] = Array::with_capacity(est_attrs)
  let namespaces : Array[NsData] = Array::with_capacity(16)
  let strings : Array[String] = []
  let entities = EntityTable::new()
  let budget = EntityBudget::new(opts.limits)

  // Node 0: Document Root
  nodes.push(
    NodeData::{
      kind_ns: pack_kind_ns(node_kind_root, -1),
      parent: -1,
      prev_sibling: -1,
      next_sibling: -1,
      first_child: -1,
      last_child: -1,
      s1_start: 0,
      s1_end: 0,
      s2_start: 0,
      s2_end: 0,
      attrs_start: 0,
      attrs_end: 0,
      ns_start: 0,
      ns_end: 0,
    },
  )

  // Optional XML declaration at exact start (after optional BOM)
  if pos + 5 <= main_len && raw_slice_eq_str(src, pos, pos + 5, "<?xml") {
    let next_b = if pos + 5 < main_len { src.code_unit_at(pos + 5) } else { 0 }
    if next_b == 0x20 ||
    next_b == 0x09 ||
    next_b == 0x0A ||
    next_b == 0x0D ||
    next_b == 0x3F {
      match parse_xml_decl(src, pos, main_len) {
        Ok((_, ni)) => pos = ni
        Err(e) => return Err(e)
      }
    }
  }

  // Explicit stacks (zero recursion!). Top of stack is kept in registers (`cur_parent`, `cur_fc`, `cur_lc`, `depth`).
  let lut = xml_lut
  let elem_stack : Array[Int] = []
  let first_child_stack : Array[Int] = []
  let last_child_stack : Array[Int] = []
  let ns_scope_stack : Array[Int] = []
  let default_ns_stack : Array[Int] = []
  let active_ns : Array[Int] = []
  let mut ns_map_active = false
  let ns_map : Map[String, Int] = Map::new()
  let ns_prev_stack : Array[(String, Int)] = []
  let input_stack : Array[InputFrame] = []
  let mut cur_src = src
  let mut len = main_len
  let mut cur_entity_idx = -1
  let mut cur_base_depth = 0
  let mut depth = 0
  let mut cur_parent = 0
  let mut cur_fc = -1
  let mut cur_lc = -1
  let mut cur_default_ns = -1
  let mut cached_ns_p_start = 0
  let mut cached_ns_p_end = 0
  let mut cached_ns_idx = -1
  let mut root_elem_id = -1
  let mut saw_doctype = false
  let mut text_run_active = false
  let mut text_run_sb = StringBuilder::new()
  let max_depth = opts.limits.max_depth
  let max_nodes = opts.limits.max_nodes
  let max_attributes = opts.limits.max_attributes

  while true {
    if pos >= len {
      if cur_entity_idx >= 0 {
        if depth != cur_base_depth {
          return Err(
            make_err(cur_src, pos, XmlErrorKind::UnclosedTag, "unbalanced markup inside entity replacement text"),
          )
        }
        match input_stack.pop() {
          Some(prev) => {
            cur_src = prev.src
            pos = prev.pos
            len = prev.len
            cur_entity_idx = prev.entity_idx
            cur_base_depth = prev.base_depth
            cached_ns_idx = -1
            continue
          }
          None => break
        }
      }
      break
    }

    let in_entity = cur_entity_idx >= 0

    if depth == 0 {
      // Prolog or Epilog: only whitespace, comments, PIs, (and 1 DOCTYPE + 1 root element in prolog)
      if cur_src.code_unit_at(pos) <= 0x20 {
        pos = skip_ws(cur_src, pos, len)
        if pos >= len {
          continue
        }
      }
      if cur_src.code_unit_at(pos) != 0x3C {
        return Err(
          make_err(cur_src, pos, XmlErrorKind::InvalidSyntax, "unexpected text outside root element"),
        )
      }
      if pos + 1 >= len {
        return Err(make_err(cur_src, pos, XmlErrorKind::UnexpectedEof, "unexpected EOF after '<'"))
      }
      let b1 = cur_src.code_unit_at(pos + 1)
      if b1 == 0x21 {
        if pos + 4 <= len && cur_src.code_unit_at(pos + 2) == 0x2D && cur_src.code_unit_at(pos + 3) == 0x2D {
          match scan_comment(cur_src, pos + 4, len) {
            Ok((cs, ce, has_cr, ni)) => {
              if nodes.length() >= max_nodes {
                return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
              }
              let mut vs = cs
              let mut ve = ce
              if has_cr {
                let idx = strings.length()
                strings.push(normalize_eol(cur_src, cs, ce))
                vs = -(idx + 1)
                ve = 0
              }
              let cid = nodes.length()
              nodes.push(
                NodeData::{
                  kind_ns: pack_kind_ns(node_kind_comment, -1),
                  parent: 0,
                  prev_sibling: cur_lc,
                  next_sibling: -1,
                  first_child: -1,
                  last_child: -1,
                  s1_start: vs,
                  s1_end: ve,
                  s2_start: 0,
                  s2_end: 0,
                  attrs_start: 0,
                  attrs_end: 0,
                  ns_start: 0,
                  ns_end: 0,
                },
              )
              if cur_lc >= 0 {
                set_next_sibling(nodes, cur_lc, cid)
              } else {
                cur_fc = cid
              }
              cur_lc = cid
              pos = ni
              continue
            }
            Err(e) => return Err(e)
          }
        } else if pos + 9 <= len && raw_slice_eq_str(cur_src, pos, pos + 9, "<!DOCTYPE") {
          if root_elem_id >= 0 {
            return Err(make_err(cur_src, pos, XmlErrorKind::InvalidSyntax, "DOCTYPE not allowed after root element"))
          }
          if saw_doctype {
            return Err(make_err(cur_src, pos, XmlErrorKind::InvalidSyntax, "multiple DOCTYPE declarations"))
          }
          if !opts.allow_dtd {
            return Err(make_err(cur_src, pos, XmlErrorKind::DtdDetected, "DTD is disabled by default"))
          }
          saw_doctype = true
          match parse_doctype(cur_src, pos + 9, len, entities) {
            Ok((_, _, ni)) => {
              pos = ni
              continue
            }
            Err(e) => return Err(e)
          }
        } else if pos + 9 <= len && raw_slice_eq_str(cur_src, pos, pos + 9, "<![CDATA[") {
          return Err(make_err(cur_src, pos, XmlErrorKind::InvalidCData, "CDATA not allowed outside root element"))
        } else {
          return Err(make_err(cur_src, pos, XmlErrorKind::InvalidSyntax, "invalid markup in prolog/epilog"))
        }
      } else if b1 == 0x3F {
        match scan_pi(cur_src, pos + 2, len) {
          Ok((ts, te, vs_raw, ve_raw, has_val, has_cr, ni)) => {
            if nodes.length() >= max_nodes {
              return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
            }
            let mut vs = 0
            let mut ve = 0
            if has_val {
              if has_cr {
                let idx = strings.length()
                strings.push(normalize_eol(cur_src, vs_raw, ve_raw))
                vs = -(idx + 1)
                ve = 0
              } else {
                vs = vs_raw
                ve = ve_raw
              }
            }
            let cid = nodes.length()
            nodes.push(
              NodeData::{
                kind_ns: pack_kind_ns(node_kind_pi, if has_val { 1 } else { 0 }),
                parent: 0,
                prev_sibling: cur_lc,
                next_sibling: -1,
                first_child: -1,
                last_child: -1,
                s1_start: ts,
                s1_end: te,
                s2_start: vs,
                s2_end: ve,
                attrs_start: 0,
                attrs_end: 0,
                ns_start: 0,
                ns_end: 0,
              },
            )
            if cur_lc >= 0 {
              set_next_sibling(nodes, cur_lc, cid)
            } else {
              cur_fc = cid
            }
            cur_lc = cid
            pos = ni
            continue
          }
          Err(e) => return Err(e)
        }
      } else if b1 == 0x2F {
        return Err(make_err(cur_src, pos, XmlErrorKind::MismatchedTag, "unexpected end tag at root level"))
      } else if root_elem_id >= 0 {
        return Err(make_err(cur_src, pos, XmlErrorKind::MultipleRootNodes, "multiple root elements"))
      }
    }

    // Inside element (or starting root element at '<')
    if cur_src.code_unit_at(pos) != 0x3C {
      // Fast text scan until '<' (or custom DTD entity reference when DTD entities exist)
      let has_custom_entities = !entities.is_empty()
      let text_start = pos
      let mut i = pos
      let mut needs_unescape = false
      let mut custom_ent_idx = -1
      let mut custom_ent_after = -1
      while i < len {
        while i <= len - 4 {
          let m0 = lut[cur_src.code_unit_at(i)]
          let m1 = lut[cur_src.code_unit_at(i + 1)]
          let m2 = lut[cur_src.code_unit_at(i + 2)]
          let m3 = lut[cur_src.code_unit_at(i + 3)]
          if ((m0 & m1 & m2 & m3) & mask_text_fast) != 0 {
            i = i + 4
          } else {
            break
          }
        }
        if i >= len {
          break
        }
        let b = cur_src.code_unit_at(i)
        if b == 0x3C {
          break
        }
        if b < 0x80 {
          let m = lut[b]
          if (m & mask_text_fast) != 0 {
            i = i + 1
          } else if b == 0x26 {
            if has_custom_entities && i + 1 < len && cur_src.code_unit_at(i + 1) != 0x23 {
              let mut semi = i + 1
              while semi < len && cur_src.code_unit_at(semi) != 0x3B {
                semi = semi + 1
              }
              if semi < len && semi > i + 1 && lookup_predefined_entity(cur_src, i + 1, semi) < 0 {
                match entities.lookup(cur_src, i + 1, semi) {
                  Some(eidx) => {
                    custom_ent_idx = eidx
                    custom_ent_after = semi + 1
                    break
                  }
                  None =>
                  return Err(make_err(cur_src, i, XmlErrorKind::UnknownEntity, "unknown entity reference"))
                }
              }
            }
            needs_unescape = true
            i = i + 1
          } else if b == 0x0D {
            if !in_entity {
              needs_unescape = true
            }
            i = i + 1
          } else if b == 0x5D {
            if i + 2 < len &&
            cur_src.code_unit_at(i + 1) == 0x5D &&
            cur_src.code_unit_at(i + 2) == 0x3E {
              return Err(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "']]>' is not allowed in text content"))
            }
            i = i + 1
          } else {
            return Err(make_err(cur_src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in text"))
          }
        } else {
          let (cp, blen) = decode_utf8(cur_src, i, len)
          if cp < 0 || !is_xml_char(cp) {
            return Err(make_err(cur_src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in text"))
          }
          i = i + blen
        }
      }

      if i > text_start {
        let mut ts = text_start
        let mut te = i
        let mut chunk_non_empty = true
        if needs_unescape {
          match unescape_span(
            cur_src,
            text_start,
            i,
            false,
            entities,
            budget,
            cur_entity_idx,
            input_stack,
          ) {
            Ok(s) => {
              if s.length() == 0 {
                chunk_non_empty = false
              } else if cur_lc >= 0 && unpack_kind(nodes[cur_lc].kind_ns) == node_kind_text {
                if !text_run_active {
                  text_run_active = true
                  text_run_sb = StringBuilder::new()
                  let prev_n = nodes[cur_lc]
                  if prev_n.s1_start < 0 {
                    let pidx = -(prev_n.s1_start + 1)
                    text_run_sb.write_string(strings[pidx])
                    if pidx == strings.length() - 1 {
                      let _ = strings.pop()
                    } else {
                      strings[pidx] = ""
                    }
                  } else {
                    text_run_sb.write_substring(src, prev_n.s1_start, prev_n.s1_end)
                  }
                }
                text_run_sb.write_string(s)
                chunk_non_empty = false
              } else {
                let idx = strings.length()
                strings.push(s)
                ts = -(idx + 1)
                te = 0
              }
            }
            Err(e) => return Err(e)
          }
        }
        if chunk_non_empty {
          if cur_lc >= 0 && unpack_kind(nodes[cur_lc].kind_ns) == node_kind_text {
            if !text_run_active {
              text_run_active = true
              text_run_sb = StringBuilder::new()
              let prev_n = nodes[cur_lc]
              if prev_n.s1_start < 0 {
                let pidx = -(prev_n.s1_start + 1)
                text_run_sb.write_string(strings[pidx])
                if pidx == strings.length() - 1 {
                  let _ = strings.pop()
                } else {
                  strings[pidx] = ""
                }
              } else {
                text_run_sb.write_substring(src, prev_n.s1_start, prev_n.s1_end)
              }
            }
            if ts < 0 {
              let nidx = -(ts + 1)
              text_run_sb.write_string(strings[nidx])
              if nidx == strings.length() - 1 {
                let _ = strings.pop()
              } else {
                strings[nidx] = ""
              }
            } else {
              text_run_sb.write_substring(cur_src, ts, te)
            }
          } else {
            if nodes.length() >= max_nodes {
              return Err(
                make_err(cur_src, text_start, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"),
              )
            }
            let (final_ts, final_te) = if ts >= 0 && in_entity {
              maybe_intern(cur_src, true, strings, ts, te)
            } else {
              (ts, te)
            }
            let cid = nodes.length()
            nodes.push(
              NodeData::{
                kind_ns: pack_kind_ns(node_kind_text, -1),
                parent: cur_parent,
                prev_sibling: cur_lc,
                next_sibling: -1,
                first_child: -1,
                last_child: -1,
                s1_start: final_ts,
                s1_end: final_te,
                s2_start: 0,
                s2_end: 0,
                attrs_start: 0,
                attrs_end: 0,
                ns_start: 0,
                ns_end: 0,
              },
            )
            if cur_lc >= 0 {
              set_next_sibling(nodes, cur_lc, cid)
            } else {
              cur_fc = cid
            }
            cur_lc = cid
          }
        }
      }

      if custom_ent_idx >= 0 {
        let ent = entities.defs[custom_ent_idx]
        if ent.is_external {
          return Err(
            make_err(cur_src, i, XmlErrorKind::ExternalEntityNotAllowed, "external entity reference is not allowed"),
          )
        }
        if cur_entity_idx == custom_ent_idx {
          return Err(make_err(cur_src, i, XmlErrorKind::EntityLoop, "circular entity reference"))
        }
        let mut ek = 0
        while ek < input_stack.length() {
          if input_stack[ek].entity_idx == custom_ent_idx {
            return Err(make_err(cur_src, i, XmlErrorKind::EntityLoop, "circular entity reference"))
          }
          ek = ek + 1
        }
        budget.expansions = budget.expansions + 1
        budget.bytes = budget.bytes + ent.value.length()
        if budget.expansions > budget.max_expansions || budget.bytes > budget.max_bytes {
          return Err(
            make_err(cur_src, i, XmlErrorKind::LimitExceeded, "entity expansion limit exceeded"),
          )
        }
        input_stack.push(
          InputFrame::{
            src: cur_src,
            pos: custom_ent_after,
            len: len,
            entity_idx: cur_entity_idx,
            base_depth: cur_base_depth,
          },
        )
        cur_src = ent.value
        pos = 0
        len = ent.value.length()
        cur_entity_idx = custom_ent_idx
        cur_base_depth = depth
        cached_ns_idx = -1
        continue
      }

      pos = i
      continue
    }

    // Current byte is '<'
    if pos + 1 >= len {
      return Err(make_err(cur_src, pos, XmlErrorKind::UnexpectedEof, "unexpected EOF after '<'"))
    }
    let b1 = cur_src.code_unit_at(pos + 1)
    if b1 == 0x2F {
      // End tag `</name>`
      if depth == 0 {
        return Err(make_err(cur_src, pos, XmlErrorKind::MismatchedTag, "unexpected end tag"))
      }
      if in_entity && depth <= cur_base_depth {
        return Err(make_err(cur_src, pos, XmlErrorKind::MismatchedTag, "unbalanced end tag inside entity"))
      }
      // Flush any open merged text run before closing element
      if text_run_active {
        let pool_idx = strings.length()
        strings.push(text_run_sb.to_string())
        update_text_node_span(nodes, cur_lc, -(pool_idx + 1), 0)
        text_run_active = false
        text_run_sb = StringBuilder::new()
      }
      let open_id = cur_parent
      let open_node = nodes[open_id]
      let name_start = pos + 2
      let mut fast_ok = false
      let mut fast_end = 0
      if !in_entity && open_node.s1_start >= 0 && open_node.s2_start >= 0 {
        let p_len = open_node.s2_end - open_node.s2_start
        let l_len = open_node.s1_end - open_node.s1_start
        let expected_end = if p_len > 0 {
          name_start + p_len + 1 + l_len
        } else {
          name_start + l_len
        }
        if expected_end < len && cur_src.code_unit_at(expected_end) == 0x3E {
          if p_len == 0 {
            fast_ok = raw_slice_eq(
              src,
              name_start,
              expected_end,
              open_node.s1_start,
              open_node.s1_end,
            )
          } else if cur_src.code_unit_at(name_start + p_len) == 0x3A {
            fast_ok = raw_slice_eq(
              src,
              name_start,
              name_start + p_len,
              open_node.s2_start,
              open_node.s2_end,
            ) &&
            raw_slice_eq(
              src,
              name_start + p_len + 1,
              expected_end,
              open_node.s1_start,
              open_node.s1_end,
            )
          }
        }
        fast_end = expected_end
      }
      if fast_ok {
        finalize_children(nodes, open_id, cur_fc, cur_lc)
        depth = depth - 1
        cur_parent = match elem_stack.pop() {
          Some(v) => v
          None => 0
        }
        cur_fc = match first_child_stack.pop() {
          Some(v) => v
          None => -1
        }
        cur_lc = match last_child_stack.pop() {
          Some(v) => v
          None => -1
        }
        let prev_ns_len = match ns_scope_stack.pop() {
          Some(v) => v
          None => 0
        }
        while active_ns.length() > prev_ns_len {
          let _ = active_ns.pop()
          if ns_map_active {
            match ns_prev_stack.pop() {
              Some((ps, prev_i)) => {
                if ps.length() > 0 {
                  if prev_i == -1 {
                    ns_map.remove(ps)
                  } else {
                    ns_map.set(ps, prev_i)
                  }
                }
              }
              None => ()
            }
          }
          cached_ns_idx = -1
        }
        cur_default_ns = match default_ns_stack.pop() {
          Some(v) => v
          None => -1
        }
        pos = fast_end + 1
        continue
      }
      let (name_end, colon_pos) = scan_qname(cur_src, name_start, len)
      if name_end < 0 {
        return Err(make_err(cur_src, name_start, XmlErrorKind::InvalidName, "invalid end tag name"))
      }
      let after_ws = skip_ws(cur_src, name_end, len)
      if after_ws >= len || cur_src.code_unit_at(after_ws) != 0x3E {
        return Err(make_err(cur_src, after_ws, XmlErrorKind::InvalidSyntax, "expected '>' closing end tag"))
      }
      let open_has_prefix = open_node.s2_start < 0 || open_node.s2_end > open_node.s2_start
      let end_has_prefix = colon_pos >= 0
      let end_ls = if end_has_prefix { colon_pos + 1 } else { name_start }
      let local_eq = if open_node.s1_start < 0 {
        raw_slice_eq_str(cur_src, end_ls, name_end, strings[-(open_node.s1_start + 1)])
      } else {
        str_slice_eq(src, open_node.s1_start, open_node.s1_end, cur_src, end_ls, name_end)
      }
      let prefix_eq = if !open_has_prefix {
        true
      } else if open_node.s2_start < 0 {
        raw_slice_eq_str(cur_src, name_start, colon_pos, strings[-(open_node.s2_start + 1)])
      } else {
        str_slice_eq(src, open_node.s2_start, open_node.s2_end, cur_src, name_start, colon_pos)
      }
      if open_has_prefix != end_has_prefix || !local_eq || !prefix_eq {
        return Err(make_err(cur_src, name_start, XmlErrorKind::MismatchedTag, "mismatched end tag"))
      }
      finalize_children(nodes, open_id, cur_fc, cur_lc)
      depth = depth - 1
      cur_parent = match elem_stack.pop() {
        Some(v) => v
        None => 0
      }
      cur_fc = match first_child_stack.pop() {
        Some(v) => v
        None => -1
      }
      cur_lc = match last_child_stack.pop() {
        Some(v) => v
        None => -1
      }
      let prev_ns_len = match ns_scope_stack.pop() {
        Some(v) => v
        None => 0
      }
      while active_ns.length() > prev_ns_len {
        let _ = active_ns.pop()
        if ns_map_active {
          match ns_prev_stack.pop() {
            Some((ps, prev_i)) => {
              if ps.length() > 0 {
                if prev_i == -1 {
                  ns_map.remove(ps)
                } else {
                  ns_map.set(ps, prev_i)
                }
              }
            }
            None => ()
          }
        }
        cached_ns_idx = -1
      }
      cur_default_ns = match default_ns_stack.pop() {
        Some(v) => v
        None => -1
      }
      pos = after_ws + 1
      continue
    } else if b1 == 0x21 {
      // Comment or CDATA inside element
      if pos + 4 <= len && cur_src.code_unit_at(pos + 2) == 0x2D && cur_src.code_unit_at(pos + 3) == 0x2D {
        if text_run_active {
          let pool_idx = strings.length()
          strings.push(text_run_sb.to_string())
          update_text_node_span(nodes, cur_lc, -(pool_idx + 1), 0)
          text_run_active = false
          text_run_sb = StringBuilder::new()
        }
        match scan_comment(cur_src, pos + 4, len) {
          Ok((cs, ce, has_cr, ni)) => {
            if nodes.length() >= max_nodes {
              return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
            }
            let (vs, ve) = if has_cr {
              let idx = strings.length()
              strings.push(normalize_eol(cur_src, cs, ce))
              (-(idx + 1), 0)
            } else {
              maybe_intern(cur_src, in_entity, strings, cs, ce)
            }
            let cid = nodes.length()
            nodes.push(
              NodeData::{
                kind_ns: pack_kind_ns(node_kind_comment, -1),
                parent: cur_parent,
                prev_sibling: cur_lc,
                next_sibling: -1,
                first_child: -1,
                last_child: -1,
                s1_start: vs,
                s1_end: ve,
                s2_start: 0,
                s2_end: 0,
                attrs_start: 0,
                attrs_end: 0,
                ns_start: 0,
                ns_end: 0,
              },
            )
            if cur_lc >= 0 {
              set_next_sibling(nodes, cur_lc, cid)
            } else {
              cur_fc = cid
            }
            cur_lc = cid
            pos = ni
            continue
          }
          Err(e) => return Err(e)
        }
      } else if pos + 9 <= len && cur_src.code_unit_at(pos + 2) == 0x5B && raw_slice_eq_str(cur_src, pos, pos + 9, "<![CDATA[") {
        match scan_cdata(cur_src, pos + 9, len) {
          Ok((cs, ce, has_cr, ni)) => {
            if ce > cs {
              if cur_lc >= 0 && unpack_kind(nodes[cur_lc].kind_ns) == node_kind_text {
                if !text_run_active {
                  text_run_active = true
                  text_run_sb = StringBuilder::new()
                  let prev_n = nodes[cur_lc]
                  if prev_n.s1_start < 0 {
                    let pidx = -(prev_n.s1_start + 1)
                    text_run_sb.write_string(strings[pidx])
                    if pidx == strings.length() - 1 {
                      let _ = strings.pop()
                    } else {
                      strings[pidx] = ""
                    }
                  } else {
                    text_run_sb.write_substring(src, prev_n.s1_start, prev_n.s1_end)
                  }
                }
                if has_cr {
                  text_run_sb.write_string(normalize_eol(cur_src, cs, ce))
                } else {
                  text_run_sb.write_substring(cur_src, cs, ce)
                }
              } else {
                if nodes.length() >= max_nodes {
                  return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
                }
                let (vs, ve) = if has_cr {
                  let idx = strings.length()
                  strings.push(normalize_eol(cur_src, cs, ce))
                  (-(idx + 1), 0)
                } else {
                  maybe_intern(cur_src, in_entity, strings, cs, ce)
                }
                let cid = nodes.length()
                nodes.push(
                  NodeData::{
                    kind_ns: pack_kind_ns(node_kind_text, -1),
                    parent: cur_parent,
                    prev_sibling: cur_lc,
                    next_sibling: -1,
                    first_child: -1,
                    last_child: -1,
                    s1_start: vs,
                    s1_end: ve,
                    s2_start: 0,
                    s2_end: 0,
                    attrs_start: 0,
                    attrs_end: 0,
                    ns_start: 0,
                    ns_end: 0,
                  },
                )
                if cur_lc >= 0 {
                  set_next_sibling(nodes, cur_lc, cid)
                } else {
                  cur_fc = cid
                }
                cur_lc = cid
              }
            }
            pos = ni
            continue
          }
          Err(e) => return Err(e)
        }
      } else {
        return Err(make_err(cur_src, pos, XmlErrorKind::InvalidSyntax, "unexpected '<!' inside element"))
      }
    } else if b1 == 0x3F {
      // PI inside element
      if text_run_active {
        let pool_idx = strings.length()
        strings.push(text_run_sb.to_string())
        update_text_node_span(nodes, cur_lc, -(pool_idx + 1), 0)
        text_run_active = false
        text_run_sb = StringBuilder::new()
      }
      match scan_pi(cur_src, pos + 2, len) {
        Ok((ts, te, vs_raw, ve_raw, has_val, has_cr, ni)) => {
          if nodes.length() >= max_nodes {
            return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
          }
          let (its, ite) = maybe_intern(cur_src, in_entity, strings, ts, te)
          let mut vs = 0
          let mut ve = 0
          if has_val {
            if has_cr {
              let idx = strings.length()
              strings.push(normalize_eol(cur_src, vs_raw, ve_raw))
              vs = -(idx + 1)
              ve = 0
            } else {
              let (ivs, ive) = maybe_intern(cur_src, in_entity, strings, vs_raw, ve_raw)
              vs = ivs
              ve = ive
            }
          }
          let cid = nodes.length()
          nodes.push(
            NodeData::{
              kind_ns: pack_kind_ns(node_kind_pi, if has_val { 1 } else { 0 }),
              parent: cur_parent,
              prev_sibling: cur_lc,
              next_sibling: -1,
              first_child: -1,
              last_child: -1,
              s1_start: its,
              s1_end: ite,
              s2_start: vs,
              s2_end: ve,
              attrs_start: 0,
              attrs_end: 0,
              ns_start: 0,
              ns_end: 0,
            },
          )
          if cur_lc >= 0 {
            set_next_sibling(nodes, cur_lc, cid)
          } else {
            cur_fc = cid
          }
          cur_lc = cid
          pos = ni
          continue
        }
        Err(e) => return Err(e)
      }
    }

    // Flush any open merged text run before starting child element
    if text_run_active {
      let pool_idx = strings.length()
      strings.push(text_run_sb.to_string())
      update_text_node_span(nodes, cur_lc, -(pool_idx + 1), 0)
      text_run_active = false
      text_run_sb = StringBuilder::new()
    }

    // Start or Empty element tag `<name ...>` / `<name .../>`
    if depth >= max_depth {
      return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_depth limit exceeded"))
    }
    if nodes.length() >= max_nodes {
      return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
    }
    let tag_start = pos + 1
    // Inline fast ASCII QName scan for tag name
    let mut tag_end = tag_start
    let mut tag_colon = -1
    if tag_start < len && b1 < 0x80 && (lut[b1] & mask_ncname_start) != 0 {
      tag_end = tag_start + 1
      while tag_end < len {
        let tb = cur_src.code_unit_at(tag_end)
        if tb < 0x80 && (lut[tb] & mask_ncname_char) != 0 {
          tag_end = tag_end + 1
        } else {
          break
        }
      }
      if tag_end < len {
        let tb = cur_src.code_unit_at(tag_end)
        if tb == 0x3A {
          tag_colon = tag_end
          tag_end = tag_end + 1
          if tag_end < len && cur_src.code_unit_at(tag_end) < 0x80 && (lut[cur_src.code_unit_at(tag_end)] & mask_ncname_start) != 0 {
            tag_end = tag_end + 1
            while tag_end < len {
              let tb2 = cur_src.code_unit_at(tag_end)
              if tb2 < 0x80 && (lut[tb2] & mask_ncname_char) != 0 {
                tag_end = tag_end + 1
              } else {
                break
              }
            }
            if tag_end < len && (cur_src.code_unit_at(tag_end) >= 0x80 || cur_src.code_unit_at(tag_end) == 0x3A) {
              let (te2, tc2) = scan_qname(cur_src, tag_start, len)
              tag_end = te2
              tag_colon = tc2
            }
          } else {
            let (te2, tc2) = scan_qname(cur_src, tag_start, len)
            tag_end = te2
            tag_colon = tc2
          }
        } else if tb >= 0x80 {
          let (te2, tc2) = scan_qname(cur_src, tag_start, len)
          tag_end = te2
          tag_colon = tc2
        }
      }
    } else {
      let (te2, tc2) = scan_qname(cur_src, tag_start, len)
      tag_end = te2
      tag_colon = tc2
    }
    if tag_end < 0 {
      return Err(make_err(cur_src, tag_start, XmlErrorKind::InvalidName, "invalid element tag name"))
    }
    let tag_has_prefix = tag_colon >= 0
    let tag_p_start = if tag_has_prefix { tag_start } else { 0 }
    let tag_p_end = if tag_has_prefix { tag_colon } else { 0 }
    let tag_l_start = if tag_has_prefix { tag_colon + 1 } else { tag_start }
    let tag_l_end = tag_end
    if tag_has_prefix &&
    tag_colon - tag_start == 5 &&
    b1 == 0x78 &&
    raw_slice_eq_str(cur_src, tag_start, tag_colon, "xmlns") {
      return Err(
        make_err(cur_src, tag_start, XmlErrorKind::InvalidNamespace, "element cannot use 'xmlns' prefix"),
      )
    }

    // Parse attributes and xmlns declarations directly into `attrs` / `namespaces`
    let mut i = tag_end
    let ns_start = namespaces.length()
    let prev_active_ns_len = active_ns.length()
    let prev_default_ns = cur_default_ns
    let attrs_start = attrs.length()
    let mut is_empty = false
    let mut tag_closed = false
    let mut attr_count = 0
    let mut has_prefixed_attr = false
    let mut seen_unprefixed_attrs : Map[String, Bool] = Map::new()
    let mut use_attr_dedup_map = false

    // Fast path for zero-attribute tags (`<tag>` or `<tag/>`)
    let mut scan_attrs = true
    if i < len {
      let nb = cur_src.code_unit_at(i)
      if nb == 0x3E {
        i = i + 1
        scan_attrs = false
        tag_closed = true
      } else if nb == 0x2F {
        if i + 1 >= len || cur_src.code_unit_at(i + 1) != 0x3E {
          return Err(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "expected '>' after '/' in empty tag"))
        }
        is_empty = true
        i = i + 2
        scan_attrs = false
        tag_closed = true
      }
    }

    while scan_attrs && i < len {
      let ws_before = i
      let b_ws = cur_src.code_unit_at(i)
      if b_ws == 0x20 {
        i = i + 1
        if i < len && cur_src.code_unit_at(i) <= 0x20 {
          i = skip_ws(cur_src, i, len)
        }
      } else if b_ws <= 0x20 {
        i = skip_ws(cur_src, i, len)
      }
      if i >= len {
        return Err(make_err(cur_src, i, XmlErrorKind::UnexpectedEof, "unterminated start tag"))
      }
      let cb = cur_src.code_unit_at(i)
      if cb == 0x3E {
        i = i + 1
        tag_closed = true
        break
      }
      if cb == 0x2F {
        if i + 1 >= len || cur_src.code_unit_at(i + 1) != 0x3E {
          return Err(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "expected '>' after '/' in empty tag"))
        }
        is_empty = true
        i = i + 2
        tag_closed = true
        break
      }
      if i == ws_before {
        return Err(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "expected whitespace before attribute"))
      }
      attr_count = attr_count + 1
      if attr_count > max_attributes {
        return Err(make_err(cur_src, i, XmlErrorKind::LimitExceeded, "max_attributes limit exceeded"))
      }
      let aname_start = i
      // Inline fast ASCII QName scan for attribute name
      let mut aname_end = aname_start
      let mut acolon = -1
      if cb < 0x80 && (lut[cb] & mask_ncname_start) != 0 {
        aname_end = aname_start + 1
        while aname_end < len {
          let ab = cur_src.code_unit_at(aname_end)
          if ab < 0x80 && (lut[ab] & mask_ncname_char) != 0 {
            aname_end = aname_end + 1
          } else {
            break
          }
        }
        if aname_end < len {
          let ab = cur_src.code_unit_at(aname_end)
          if ab == 0x3A {
            acolon = aname_end
            aname_end = aname_end + 1
            if aname_end < len && cur_src.code_unit_at(aname_end) < 0x80 && (lut[cur_src.code_unit_at(aname_end)] & mask_ncname_start) != 0 {
              aname_end = aname_end + 1
              while aname_end < len {
                let ab2 = cur_src.code_unit_at(aname_end)
                if ab2 < 0x80 && (lut[ab2] & mask_ncname_char) != 0 {
                  aname_end = aname_end + 1
                } else {
                  break
                }
              }
              if aname_end < len && (cur_src.code_unit_at(aname_end) >= 0x80 || cur_src.code_unit_at(aname_end) == 0x3A) {
                let (ae2, ac2) = scan_qname(cur_src, aname_start, len)
                aname_end = ae2
                acolon = ac2
              }
            } else {
              let (ae2, ac2) = scan_qname(cur_src, aname_start, len)
              aname_end = ae2
              acolon = ac2
            }
          } else if ab >= 0x80 {
            let (ae2, ac2) = scan_qname(cur_src, aname_start, len)
            aname_end = ae2
            acolon = ac2
          }
        }
      } else {
        let (ae2, ac2) = scan_qname(cur_src, aname_start, len)
        aname_end = ae2
        acolon = ac2
      }
      if aname_end < 0 {
        return Err(make_err(cur_src, aname_start, XmlErrorKind::InvalidName, "invalid attribute name"))
      }
      i = aname_end
      if i < len && cur_src.code_unit_at(i) <= 0x20 {
        i = skip_ws(cur_src, i, len)
      }
      if i >= len || cur_src.code_unit_at(i) != 0x3D {
        return Err(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "expected '=' after attribute name"))
      }
      i = i + 1
      if i < len && cur_src.code_unit_at(i) <= 0x20 {
        i = skip_ws(cur_src, i, len)
      }
      if i >= len {
        return Err(make_err(cur_src, i, XmlErrorKind::UnexpectedEof, "expected attribute value quote"))
      }
      let quote = cur_src.code_unit_at(i)
      if quote != 0x22 && quote != 0x27 {
        return Err(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "attribute value must be quoted"))
      }
      i = i + 1
      let aval_start = i
      let fast_mask = if quote == 0x22 { mask_attr_dq_fast } else { mask_attr_sq_fast }
      let mut needs_unescape = false
      while i < len {
        while i <= len - 4 {
          let m0 = lut[cur_src.code_unit_at(i)]
          let m1 = lut[cur_src.code_unit_at(i + 1)]
          let m2 = lut[cur_src.code_unit_at(i + 2)]
          let m3 = lut[cur_src.code_unit_at(i + 3)]
          if ((m0 & m1 & m2 & m3) & fast_mask) != 0 {
            i = i + 4
          } else {
            break
          }
        }
        if i >= len {
          break
        }
        let ab = cur_src.code_unit_at(i)
        if ab == quote {
          break
        }
        if ab < 0x80 {
          if (lut[ab] & fast_mask) != 0 {
            i = i + 1
          } else if ab == 0x26 || ab == 0x09 || ab == 0x0A || ab == 0x0D {
            needs_unescape = true
            i = i + 1
          } else if ab == 0x3C {
            return Err(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "'<' not allowed in attribute value"))
          } else {
            return Err(make_err(cur_src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in attribute value"))
          }
        } else {
          let (cp, blen) = decode_utf8(cur_src, i, len)
          if cp < 0 || !is_xml_char(cp) {
            return Err(make_err(cur_src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in attribute value"))
          }
          i = i + blen
        }
      }
      if i >= len || cur_src.code_unit_at(i) != quote {
        return Err(make_err(cur_src, aval_start, XmlErrorKind::UnexpectedEof, "unterminated attribute value"))
      }
      let aval_end = i
      i = i + 1

      let (vs, ve) = if needs_unescape {
        match unescape_span(
          cur_src,
          aval_start,
          aval_end,
          true,
          entities,
          budget,
          cur_entity_idx,
          input_stack,
        ) {
          Ok(s) => {
            let idx = strings.length()
            strings.push(s)
            (-(idx + 1), 0)
          }
          Err(e) => return Err(e)
        }
      } else {
        maybe_intern(cur_src, in_entity, strings, aval_start, aval_end)
      }

      let a_has_prefix = acolon >= 0
      let is_default_xmlns = !a_has_prefix &&
      aname_end - aname_start == 5 &&
      cb == 0x78 &&
      raw_slice_eq_str(cur_src, aname_start, aname_end, "xmlns")
      let is_prefixed_xmlns = a_has_prefix &&
      acolon - aname_start == 5 &&
      cb == 0x78 &&
      raw_slice_eq_str(cur_src, aname_start, acolon, "xmlns")

      if is_default_xmlns {
        let aval_span = TextSpan::{ start: vs, end: ve }
        let mut k = ns_start
        while k < namespaces.length() {
          if !namespaces[k].has_prefix {
            return Err(make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate xmlns attribute"))
          }
          k = k + 1
        }
        if span_eq_str(src, strings, aval_span, xml_ns_uri) ||
        span_eq_str(src, strings, aval_span, xmlns_ns_uri) {
          return Err(make_err(cur_src, aval_start, XmlErrorKind::InvalidNamespace, "cannot bind default namespace to reserved URI"))
        }
        let ns_idx = namespaces.length()
        namespaces.push(
          NsData::{
            prefix_span: TextSpan::empty(),
            uri_span: aval_span,
            has_prefix: false,
          },
        )
        if ns_map_active {
          ns_prev_stack.push(("", -1))
        }
        active_ns.push(ns_idx)
        cur_default_ns = if span_len(strings, aval_span) == 0 { -1 } else { ns_idx }
      } else if is_prefixed_xmlns {
        let aval_span = TextSpan::{ start: vs, end: ve }
        let (ps_i, pe_i) = maybe_intern(cur_src, in_entity, strings, acolon + 1, aname_end)
        let pspan = TextSpan::{ start: ps_i, end: pe_i }
        if !ns_map_active && active_ns.length() >= 8 {
          // Promote to O(1) prefix map
          ns_map_active = true
          let mut m = 0
          while m < active_ns.length() {
            let existing_idx = active_ns[m]
            let existing_ns = namespaces[existing_idx]
            if existing_ns.has_prefix {
              let eps = span_to_string(src, strings, existing_ns.prefix_span)
              let old_i = match ns_map.get(eps) {
                Some(v) => v
                None => -1
              }
              ns_prev_stack.push((eps, old_i))
              ns_map.set(eps, existing_idx)
            } else {
              ns_prev_stack.push(("", -1))
            }
            m = m + 1
          }
        }
        if ns_map_active {
          let pstr = cur_src.slice(acolon + 1, aname_end)
          match ns_map.get(pstr) {
            Some(prev_i) => {
              if prev_i >= ns_start {
                return Err(make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate xmlns prefix declaration"))
              }
            }
            None => ()
          }
        } else {
          let mut k = ns_start
          while k < namespaces.length() {
            if namespaces[k].has_prefix &&
            span_eq_span(src, strings, namespaces[k].prefix_span, pspan) {
              return Err(make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate xmlns prefix declaration"))
            }
            k = k + 1
          }
        }
        if span_len(strings, aval_span) == 0 {
          return Err(make_err(cur_src, aval_start, XmlErrorKind::InvalidNamespace, "prefixed namespace URI cannot be empty"))
        }
        if span_eq_str(src, strings, pspan, "xmlns") {
          return Err(make_err(cur_src, aname_start, XmlErrorKind::InvalidNamespace, "cannot declare prefix 'xmlns'"))
        }
        if span_eq_str(src, strings, pspan, "xml") {
          if !span_eq_str(src, strings, aval_span, xml_ns_uri) {
            return Err(make_err(cur_src, aval_start, XmlErrorKind::InvalidNamespace, "prefix 'xml' can only be bound to XML namespace"))
          }
        } else {
          if span_eq_str(src, strings, aval_span, xml_ns_uri) {
            return Err(make_err(cur_src, aval_start, XmlErrorKind::InvalidNamespace, "only prefix 'xml' may bind to XML namespace"))
          }
        }
        if span_eq_str(src, strings, aval_span, xmlns_ns_uri) {
          return Err(make_err(cur_src, aval_start, XmlErrorKind::InvalidNamespace, "no prefix may bind to xmlns namespace"))
        }
        let ns_idx = namespaces.length()
        namespaces.push(
          NsData::{
            prefix_span: pspan,
            uri_span: aval_span,
            has_prefix: true,
          },
        )
        if ns_map_active {
          let pstr = cur_src.slice(acolon + 1, aname_end)
          let old_i = match ns_map.get(pstr) {
            Some(v) => v
            None => -1
          }
          ns_prev_stack.push((pstr, old_i))
          ns_map.set(pstr, ns_idx)
        }
        active_ns.push(ns_idx)
        cached_ns_idx = -1
      } else if !a_has_prefix {
        let cur_alen = attrs.length()
        if !use_attr_dedup_map {
          if cur_alen - attrs_start >= 16 {
            use_attr_dedup_map = true
            seen_unprefixed_attrs = Map::new()
            let mut aj = attrs_start
            while aj < cur_alen {
              let pa = attrs[aj]
              if pa.ns_idx == -1 {
                seen_unprefixed_attrs.set(
                  span_to_string(src, strings, TextSpan::{ start: pa.local_start, end: pa.local_end }),
                  true,
                )
              }
              aj = aj + 1
            }
            let astr = cur_src.slice(aname_start, aname_end)
            match seen_unprefixed_attrs.get(astr) {
              Some(_) =>
              return Err(make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
              None => seen_unprefixed_attrs.set(astr, true)
            }
          } else {
            let alen = aname_end - aname_start
            let mut aj = attrs_start
            while aj < cur_alen {
              let prev_a = attrs[aj]
              if prev_a.ns_idx == -1 {
                let is_dup = if prev_a.local_start < 0 {
                  let pstr = strings[-(prev_a.local_start + 1)]
                  pstr.length() == alen && raw_slice_eq_str(cur_src, aname_start, aname_end, pstr)
                } else {
                  prev_a.local_end - prev_a.local_start == alen &&
                  src.code_unit_at(prev_a.local_start) == cb &&
                  str_slice_eq(src, prev_a.local_start, prev_a.local_end, cur_src, aname_start, aname_end)
                }
                if is_dup {
                  return Err(
                    make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"),
                  )
                }
              }
              aj = aj + 1
            }
          }
        } else {
          let astr = cur_src.slice(aname_start, aname_end)
          match seen_unprefixed_attrs.get(astr) {
            Some(_) =>
            return Err(make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
            None => seen_unprefixed_attrs.set(astr, true)
          }
        }
        let (ls_i, le_i) = maybe_intern(cur_src, in_entity, strings, aname_start, aname_end)
        attrs.push(
          AttrData::{
            local_start: ls_i,
            local_end: le_i,
            prefix_start: 0,
            prefix_end: 0,
            val_start: vs,
            val_end: ve,
            ns_idx: -1,
          },
        )
      } else {
        has_prefixed_attr = true
        let (ls_i, le_i) = maybe_intern(cur_src, in_entity, strings, acolon + 1, aname_end)
        let (ps_i, pe_i) = maybe_intern(cur_src, in_entity, strings, aname_start, acolon)
        attrs.push(
          AttrData::{
            local_start: ls_i,
            local_end: le_i,
            prefix_start: ps_i,
            prefix_end: pe_i,
            val_start: vs,
            val_end: ve,
            ns_idx: -3,
          },
        )
      }
    }

    if !tag_closed {
      return Err(make_err(cur_src, i, XmlErrorKind::UnexpectedEof, "unterminated start tag"))
    }

    // Resolve element namespace (O(1) for unprefixed, 1-entry cache, and O(1) prefix map when >8 active!)
    let elem_ns_idx = if tag_has_prefix {
      if !in_entity &&
      cached_ns_idx >= 0 &&
      cached_ns_p_end - cached_ns_p_start == tag_p_end - tag_p_start &&
      src.code_unit_at(cached_ns_p_start) == b1 &&
      raw_slice_eq(src, cached_ns_p_start, cached_ns_p_end, tag_p_start, tag_p_end) {
        cached_ns_idx
      } else {
        let r = resolve_ns_prefix(
          src,
          cur_src,
          strings,
          namespaces,
          active_ns,
          ns_map_active,
          ns_map,
          tag_p_start,
          tag_p_end,
        )
        if r == -1 {
          return Err(
            make_err(cur_src, tag_start, XmlErrorKind::UnboundNamespacePrefix, "unbound namespace prefix on element"),
          )
        }
        if !in_entity {
          cached_ns_p_start = tag_p_start
          cached_ns_p_end = tag_p_end
          cached_ns_idx = r
        }
        r
      }
    } else {
      cur_default_ns
    }

    let attrs_end = attrs.length()
    if has_prefixed_attr {
      let mut ai = attrs_start
      while ai < attrs_end {
        let cur_a = attrs[ai]
        if cur_a.ns_idx == -3 {
          let ans_idx = if cur_a.prefix_start < 0 {
            let pstr = strings[-(cur_a.prefix_start + 1)]
            resolve_ns_prefix(
              src,
              pstr,
              strings,
              namespaces,
              active_ns,
              ns_map_active,
              ns_map,
              0,
              pstr.length(),
            )
          } else {
            resolve_ns_prefix(
              src,
              src,
              strings,
              namespaces,
              active_ns,
              ns_map_active,
              ns_map,
              cur_a.prefix_start,
              cur_a.prefix_end,
            )
          }
          if ans_idx == -1 {
            return Err(
              make_err(cur_src, pos, XmlErrorKind::UnboundNamespacePrefix, "unbound namespace prefix on attribute"),
            )
          }
          attrs[ai] = AttrData::{
            local_start: cur_a.local_start,
            local_end: cur_a.local_end,
            prefix_start: cur_a.prefix_start,
            prefix_end: cur_a.prefix_end,
            val_start: cur_a.val_start,
            val_end: cur_a.val_end,
            ns_idx: ans_idx,
          }
          let cur_lspan = TextSpan::{ start: cur_a.local_start, end: cur_a.local_end }
          let mut aj = attrs_start
          while aj < ai {
            let prev_a = attrs[aj]
            if prev_a.ns_idx != -1 &&
            span_eq_span(
              src,
              strings,
              TextSpan::{ start: prev_a.local_start, end: prev_a.local_end },
              cur_lspan,
            ) {
              let same_ns = if prev_a.ns_idx == ans_idx {
                true
              } else if prev_a.ns_idx >= 0 && ans_idx >= 0 {
                span_eq_span(
                  src,
                  strings,
                  namespaces[prev_a.ns_idx].uri_span,
                  namespaces[ans_idx].uri_span,
                )
              } else {
                false
              }
              if same_ns {
                return Err(
                  make_err(cur_src, pos, XmlErrorKind::DuplicateAttribute, "duplicate attribute"),
                )
              }
            }
            aj = aj + 1
          }
        }
        ai = ai + 1
      }
    }
    let ns_end = namespaces.length()

    let (final_l_start, final_l_end) = maybe_intern(cur_src, in_entity, strings, tag_l_start, tag_l_end)
    let (final_p_start, final_p_end) = if tag_has_prefix {
      maybe_intern(cur_src, in_entity, strings, tag_p_start, tag_p_end)
    } else {
      (0, 0)
    }

    let elem_id = nodes.length()
    nodes.push(
      NodeData::{
        kind_ns: pack_kind_ns(node_kind_element, elem_ns_idx),
        parent: cur_parent,
        prev_sibling: cur_lc,
        next_sibling: -1,
        first_child: -1,
        last_child: -1,
        s1_start: final_l_start,
        s1_end: final_l_end,
        s2_start: final_p_start,
        s2_end: final_p_end,
        attrs_start: attrs_start,
        attrs_end: attrs_end,
        ns_start: ns_start,
        ns_end: ns_end,
      },
    )
    if cur_lc >= 0 {
      set_next_sibling(nodes, cur_lc, elem_id)
    } else {
      cur_fc = elem_id
    }
    cur_lc = elem_id
    if root_elem_id < 0 {
      root_elem_id = elem_id
    }
    if is_empty {
      while active_ns.length() > prev_active_ns_len {
        let _ = active_ns.pop()
        if ns_map_active {
          match ns_prev_stack.pop() {
            Some((ps, prev_i)) => {
              if ps.length() > 0 {
                if prev_i == -1 {
                  ns_map.remove(ps)
                } else {
                  ns_map.set(ps, prev_i)
                }
              }
            }
            None => ()
          }
        }
        cached_ns_idx = -1
      }
      cur_default_ns = prev_default_ns
    } else {
      elem_stack.push(cur_parent)
      first_child_stack.push(cur_fc)
      last_child_stack.push(cur_lc)
      ns_scope_stack.push(prev_active_ns_len)
      default_ns_stack.push(prev_default_ns)
      depth = depth + 1
      cur_parent = elem_id
      cur_fc = -1
      cur_lc = -1
    }
    pos = i
  }

  if depth > 0 {
    return Err(make_err(src, main_len, XmlErrorKind::UnclosedTag, "unclosed element tag"))
  }
  if root_elem_id < 0 {
    return Err(make_err(src, main_len, XmlErrorKind::NoRootNode, "document has no root element"))
  }
  finalize_children(nodes, 0, cur_fc, cur_lc)
  Ok(
    Document::{
      src: src,
      strings: strings,
      nodes: nodes,
      attrs: attrs,
      namespaces: namespaces,
      root_elem_id: root_elem_id,
    },
  )
}

///| Resolve a `ns_idx` stored in `NodeData` or `AttrData` into `Option[String]`.
fn doc_ns_uri(doc : Document, ns_idx : Int) -> Option[String] {
  if ns_idx == -2 {
    Some(xml_ns_uri)
  } else if ns_idx >= 0 {
    Some(span_to_string(doc.src, doc.strings, doc.namespaces[ns_idx].uri_span))
  } else {
    None
  }
}

///| Check whether `ns_idx` equals a target URI string without allocating.
fn doc_ns_uri_eq(doc : Document, ns_idx : Int, target : String) -> Bool {
  if ns_idx == -2 {
    target == xml_ns_uri
  } else if ns_idx >= 0 {
    span_eq_str(doc.src, doc.strings, doc.namespaces[ns_idx].uri_span, target)
  } else {
    false
  }
}

///|
pub fn Document::root(self : Document) -> Node {
  Node::{ doc: self, id: 0 }
}

///|
pub fn Document::root_element(self : Document) -> Node {
  Node::{ doc: self, id: self.root_elem_id }
}

///| Zero-allocation indexed DOM traversal helpers on `Document`.
pub fn Document::node_kind_at(self : Document, id : Int) -> Int {
  unpack_kind(self.nodes[id].kind_ns)
}

///|
pub fn Document::tag_name_len_at(self : Document, id : Int) -> Int {
  let nd = self.nodes[id]
  if nd.s1_start < 0 {
    self.strings[-(nd.s1_start + 1)].length()
  } else {
    nd.s1_end - nd.s1_start
  }
}

///|
pub fn Document::has_namespace_at(self : Document, id : Int) -> Bool {
  unpack_ns(self.nodes[id].kind_ns) != -1
}

///|
pub fn Document::attrs_range_at(self : Document, id : Int) -> (Int, Int) {
  let nd = self.nodes[id]
  (nd.attrs_start, nd.attrs_end)
}

///|
pub fn Document::attr_value_len_raw(self : Document, attr_idx : Int) -> Int {
  let a = self.attrs[attr_idx]
  if a.val_start < 0 {
    self.strings[-(a.val_start + 1)].length()
  } else {
    a.val_end - a.val_start
  }
}

///|
pub fn Document::text_len_at(self : Document, id : Int) -> Int {
  let nd = self.nodes[id]
  if nd.s1_start < 0 {
    self.strings[-(nd.s1_start + 1)].length()
  } else {
    nd.s1_end - nd.s1_start
  }
}

///|
pub fn Document::node_count(self : Document) -> Int {
  self.nodes.length()
}

///|
pub fn Document::node(self : Document, id : Int) -> Option[Node] {
  if id >= 0 && id < self.nodes.length() {
    Some(Node::{ doc: self, id: id })
  } else {
    None
  }
}

///|
pub fn Document::descendants(self : Document) -> Array[Node] {
  self.root().descendants()
}

///|
pub fn Node::id(self : Node) -> Int {
  self.id
}

///|
pub fn Node::node_type(self : Node) -> NodeType {
  let k = unpack_kind(self.doc.nodes[self.id].kind_ns)
  if k == node_kind_root {
    NodeType::Root
  } else if k == node_kind_element {
    NodeType::Element
  } else if k == node_kind_text {
    NodeType::Text
  } else if k == node_kind_comment {
    NodeType::Comment
  } else {
    NodeType::PI
  }
}

///|
pub fn Node::is_root(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_root
}

///|
pub fn Node::is_element(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_element
}

///|
pub fn Node::is_text(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_text
}

///|
pub fn Node::is_comment(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_comment
}

///|
pub fn Node::is_pi(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_pi
}

///|
pub fn Node::tag_name(self : Node) -> ExpandedName {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_element {
    return ExpandedName::{ local: "", ns_uri: None, prefix: None }
  }
  let local = span_to_string(
    self.doc.src,
    self.doc.strings,
    TextSpan::{ start: nd.s1_start, end: nd.s1_end },
  )
  let prefix = if nd.s2_start >= 0 && nd.s2_start == nd.s2_end {
    None
  } else {
    Some(
      span_to_string(
        self.doc.src,
        self.doc.strings,
        TextSpan::{ start: nd.s2_start, end: nd.s2_end },
      ),
    )
  }
  let ns_uri = doc_ns_uri(self.doc, unpack_ns(nd.kind_ns))
  ExpandedName::{ local: local, ns_uri: ns_uri, prefix: prefix }
}

///|
pub fn Node::has_tag_name(self : Node, name : String) -> Bool {
  let nd = self.doc.nodes[self.id]
  unpack_kind(nd.kind_ns) == node_kind_element &&
  span_eq_str(
    self.doc.src,
    self.doc.strings,
    TextSpan::{ start: nd.s1_start, end: nd.s1_end },
    name,
  )
}

///|
pub fn Node::has_tag_name_ns(self : Node, ns : String, local : String) -> Bool {
  let nd = self.doc.nodes[self.id]
  unpack_kind(nd.kind_ns) == node_kind_element &&
  doc_ns_uri_eq(self.doc, unpack_ns(nd.kind_ns), ns) &&
  span_eq_str(
    self.doc.src,
    self.doc.strings,
    TextSpan::{ start: nd.s1_start, end: nd.s1_end },
    local,
  )
}

///|
pub fn Node::namespace(self : Node) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_element {
    return None
  }
  doc_ns_uri(self.doc, unpack_ns(nd.kind_ns))
}

///|
pub fn Node::default_namespace(self : Node) -> Option[String] {
  self.lookup_namespace_uri(None)
}

///|
pub fn Node::lookup_namespace_uri(
  self : Node,
  prefix : Option[String],
) -> Option[String] {
  match prefix {
    Some(p) => {
      if p == "xml" {
        return Some(xml_ns_uri)
      }
      let mut cur = self.id
      while cur >= 0 {
        let nd = self.doc.nodes[cur]
        let mut k = nd.ns_end - 1
        while k >= nd.ns_start {
          let ns = self.doc.namespaces[k]
          if ns.has_prefix &&
          span_eq_str(self.doc.src, self.doc.strings, ns.prefix_span, p) {
            return Some(span_to_string(self.doc.src, self.doc.strings, ns.uri_span))
          }
          k = k - 1
        }
        cur = nd.parent
      }
      None
    }
    None => {
      let mut cur = self.id
      while cur >= 0 {
        let nd = self.doc.nodes[cur]
        let mut k = nd.ns_end - 1
        while k >= nd.ns_start {
          let ns = self.doc.namespaces[k]
          if !ns.has_prefix {
            if span_len(self.doc.strings, ns.uri_span) == 0 {
              return None
            }
            return Some(span_to_string(self.doc.src, self.doc.strings, ns.uri_span))
          }
          k = k - 1
        }
        cur = nd.parent
      }
      None
    }
  }
}

///|
pub fn Node::lookup_prefix(self : Node, uri : String) -> Option[String] {
  if uri == xml_ns_uri {
    return Some("xml")
  }
  let mut cur = self.id
  while cur >= 0 {
    let nd = self.doc.nodes[cur]
    let mut k = nd.ns_end - 1
    while k >= nd.ns_start {
      let ns = self.doc.namespaces[k]
      if ns.has_prefix &&
      span_eq_str(self.doc.src, self.doc.strings, ns.uri_span, uri) {
        return Some(span_to_string(self.doc.src, self.doc.strings, ns.prefix_span))
      }
      k = k - 1
    }
    cur = nd.parent
  }
  None
}

///|
pub fn Node::namespaces(self : Node) -> Array[Namespace] {
  let nd = self.doc.nodes[self.id]
  let out : Array[Namespace] = []
  let mut k = nd.ns_start
  while k < nd.ns_end {
    let ns = self.doc.namespaces[k]
    let p = if ns.has_prefix {
      Some(span_to_string(self.doc.src, self.doc.strings, ns.prefix_span))
    } else {
      None
    }
    let u = span_to_string(self.doc.src, self.doc.strings, ns.uri_span)
    out.push(Namespace::{ prefix: p, uri: u })
    k = k + 1
  }
  out
}

///|
pub fn Node::attribute(self : Node, name : String) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let a = self.doc.attrs[i]
    if a.ns_idx == -1 &&
    span_eq_str(
      self.doc.src,
      self.doc.strings,
      TextSpan::{ start: a.local_start, end: a.local_end },
      name,
    ) {
      return Some(
        span_to_string(
          self.doc.src,
          self.doc.strings,
          TextSpan::{ start: a.val_start, end: a.val_end },
        ),
      )
    }
    i = i + 1
  }
  None
}

///|
pub fn Node::attribute_ns(
  self : Node,
  ns : String,
  local : String,
) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let a = self.doc.attrs[i]
    if doc_ns_uri_eq(self.doc, a.ns_idx, ns) &&
    span_eq_str(
      self.doc.src,
      self.doc.strings,
      TextSpan::{ start: a.local_start, end: a.local_end },
      local,
    ) {
      return Some(
        span_to_string(
          self.doc.src,
          self.doc.strings,
          TextSpan::{ start: a.val_start, end: a.val_end },
        ),
      )
    }
    i = i + 1
  }
  None
}

///|
pub fn Node::has_attribute(self : Node, name : String) -> Bool {
  let nd = self.doc.nodes[self.id]
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let a = self.doc.attrs[i]
    if a.ns_idx == -1 &&
    span_eq_str(
      self.doc.src,
      self.doc.strings,
      TextSpan::{ start: a.local_start, end: a.local_end },
      name,
    ) {
      return true
    }
    i = i + 1
  }
  false
}

///|
pub fn Node::attributes(self : Node) -> Array[Attribute] {
  let nd = self.doc.nodes[self.id]
  let out : Array[Attribute] = Array::with_capacity(nd.attrs_end - nd.attrs_start)
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let a = self.doc.attrs[i]
    let local = span_to_string(
      self.doc.src,
      self.doc.strings,
      TextSpan::{ start: a.local_start, end: a.local_end },
    )
    let prefix = if a.prefix_start >= 0 && a.prefix_start == a.prefix_end {
      None
    } else {
      Some(
        span_to_string(
          self.doc.src,
          self.doc.strings,
          TextSpan::{ start: a.prefix_start, end: a.prefix_end },
        ),
      )
    }
    let ns_uri = doc_ns_uri(self.doc, a.ns_idx)
    let value = span_to_string(
      self.doc.src,
      self.doc.strings,
      TextSpan::{ start: a.val_start, end: a.val_end },
    )
    out.push(Attribute::{ local: local, ns_uri: ns_uri, prefix: prefix, value: value })
    i = i + 1
  }
  out
}

///|
pub fn Node::attribute_count(self : Node) -> Int {
  let nd = self.doc.nodes[self.id]
  nd.attrs_end - nd.attrs_start
}

///| Zero-allocation byte length of an element's local tag name.
pub fn Node::tag_name_len(self : Node) -> Int {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_element {
    return 0
  }
  if nd.s1_start < 0 {
    self.doc.strings[-(nd.s1_start + 1)].length()
  } else {
    nd.s1_end - nd.s1_start
  }
}

///| Zero-allocation check whether an element has a resolved namespace.
pub fn Node::has_namespace(self : Node) -> Bool {
  let nd = self.doc.nodes[self.id]
  unpack_kind(nd.kind_ns) == node_kind_element && unpack_ns(nd.kind_ns) != -1
}

///| Zero-allocation byte length of the `idx`-th attribute's value on this node.
pub fn Node::attr_value_len(self : Node, idx : Int) -> Int {
  let nd = self.doc.nodes[self.id]
  let pos = nd.attrs_start + idx
  if idx < 0 || pos >= nd.attrs_end {
    return 0
  }
  let a = self.doc.attrs[pos]
  if a.val_start < 0 {
    self.doc.strings[-(a.val_start + 1)].length()
  } else {
    a.val_end - a.val_start
  }
}

///| Zero-allocation byte length of a text/comment node (or an element's first text child).
pub fn Node::text_len(self : Node) -> Int {
  let nd = self.doc.nodes[self.id]
  let k = unpack_kind(nd.kind_ns)
  if k == node_kind_text || k == node_kind_comment {
    return if nd.s1_start < 0 {
      self.doc.strings[-(nd.s1_start + 1)].length()
    } else {
      nd.s1_end - nd.s1_start
    }
  }
  if k == node_kind_element {
    let fc = nd.first_child
    if fc >= 0 && unpack_kind(self.doc.nodes[fc].kind_ns) == node_kind_text {
      let fn_nd = self.doc.nodes[fc]
      return if fn_nd.s1_start < 0 {
        self.doc.strings[-(fn_nd.s1_start + 1)].length()
      } else {
        fn_nd.s1_end - fn_nd.s1_start
      }
    }
  }
  0
}

///|
pub fn Node::text(self : Node) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  let k = unpack_kind(nd.kind_ns)
  if k == node_kind_text || k == node_kind_comment {
    return Some(
      span_to_string(
        self.doc.src,
        self.doc.strings,
        TextSpan::{ start: nd.s1_start, end: nd.s1_end },
      ),
    )
  }
  if k == node_kind_element {
    let fc = nd.first_child
    if fc >= 0 && unpack_kind(self.doc.nodes[fc].kind_ns) == node_kind_text {
      let fnd = self.doc.nodes[fc]
      return Some(
        span_to_string(
          self.doc.src,
          self.doc.strings,
          TextSpan::{ start: fnd.s1_start, end: fnd.s1_end },
        ),
      )
    }
  }
  None
}

///|
pub fn Node::pi(self : Node) -> Option[PI] {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_pi {
    return None
  }
  let target = span_to_string(
    self.doc.src,
    self.doc.strings,
    TextSpan::{ start: nd.s1_start, end: nd.s1_end },
  )
  let value = if unpack_ns(nd.kind_ns) != 0 {
    Some(
      span_to_string(
        self.doc.src,
        self.doc.strings,
        TextSpan::{ start: nd.s2_start, end: nd.s2_end },
      ),
    )
  } else {
    None
  }
  Some(PI::{ target: target, value: value })
}

///|
pub fn Node::parent(self : Node) -> Option[Node] {
  let p = self.doc.nodes[self.id].parent
  if p >= 0 {
    Some(Node::{ doc: self.doc, id: p })
  } else {
    None
  }
}

///|
pub fn Node::first_child(self : Node) -> Option[Node] {
  let fc = self.doc.nodes[self.id].first_child
  if fc >= 0 {
    Some(Node::{ doc: self.doc, id: fc })
  } else {
    None
  }
}

///|
pub fn Node::last_child(self : Node) -> Option[Node] {
  let lc = self.doc.nodes[self.id].last_child
  if lc >= 0 {
    Some(Node::{ doc: self.doc, id: lc })
  } else {
    None
  }
}

///|
pub fn Node::prev_sibling(self : Node) -> Option[Node] {
  let ps = self.doc.nodes[self.id].prev_sibling
  if ps >= 0 {
    Some(Node::{ doc: self.doc, id: ps })
  } else {
    None
  }
}

///|
pub fn Node::next_sibling(self : Node) -> Option[Node] {
  let ns = self.doc.nodes[self.id].next_sibling
  if ns >= 0 {
    Some(Node::{ doc: self.doc, id: ns })
  } else {
    None
  }
}

///|
pub fn Node::first_element_child(self : Node) -> Option[Node] {
  let mut cur = self.doc.nodes[self.id].first_child
  while cur >= 0 {
    if unpack_kind(self.doc.nodes[cur].kind_ns) == node_kind_element {
      return Some(Node::{ doc: self.doc, id: cur })
    }
    cur = self.doc.nodes[cur].next_sibling
  }
  None
}

///|
pub fn Node::next_sibling_element(self : Node) -> Option[Node] {
  let mut cur = self.doc.nodes[self.id].next_sibling
  while cur >= 0 {
    if unpack_kind(self.doc.nodes[cur].kind_ns) == node_kind_element {
      return Some(Node::{ doc: self.doc, id: cur })
    }
    cur = self.doc.nodes[cur].next_sibling
  }
  None
}

///|
pub fn Node::children(self : Node) -> Array[Node] {
  let out : Array[Node] = []
  let mut cur = self.doc.nodes[self.id].first_child
  while cur >= 0 {
    out.push(Node::{ doc: self.doc, id: cur })
    cur = self.doc.nodes[cur].next_sibling
  }
  out
}

///| Iterative pre-order descendants (including `self`), zero recursion.
pub fn Node::descendants(self : Node) -> Array[Node] {
  let out : Array[Node] = []
  let root_id = self.id
  let mut cur = root_id
  while cur >= 0 {
    out.push(Node::{ doc: self.doc, id: cur })
    let nd = self.doc.nodes[cur]
    if nd.first_child >= 0 {
      cur = nd.first_child
    } else if cur == root_id {
      break
    } else if nd.next_sibling >= 0 {
      cur = nd.next_sibling
    } else {
      let mut p = nd.parent
      let mut next = -1
      while p >= 0 && p != root_id {
        if self.doc.nodes[p].next_sibling >= 0 {
          next = self.doc.nodes[p].next_sibling
          break
        }
        p = self.doc.nodes[p].parent
      }
      cur = next
    }
  }
  out
}

///|
pub fn Node::has_children(self : Node) -> Bool {
  self.doc.nodes[self.id].first_child >= 0
}
