///| Flat-array read-only XML 1.0 + XML Namespaces 1.0 DOM parser and accessors (inspired by roxmltree).

let node_kind_root : Int = 0

let node_kind_element : Int = 1

let node_kind_text : Int = 2

let node_kind_comment : Int = 3

let node_kind_pi : Int = 4

let xml_ns_uri : String = "http://www.w3.org/XML/1998/namespace"

let xmlns_ns_uri : String = "http://www.w3.org/2000/xmlns/"

fn pack_kind_ns(kind : Int, ns_idx : Int) -> Int {
  (kind & 7) | ((ns_idx + 2) << 3)
}

fn unpack_kind(kind_ns : Int) -> Int {
  kind_ns & 7
}

fn unpack_ns(kind_ns : Int) -> Int {
  (kind_ns >> 3) - 2
}

///| Look up a namespace prefix in the active namespace stack (O(1) via `ns_map` when >8 active bindings,
///| zero-allocation linear scan when <=8).
///| Returns `ns_idx` (`>= 0` in `namespaces`, `-2` for built-in `xml`, `-1` for unbound/none).
fn resolve_ns_prefix(
  doc_src : String,
  cur_src : String,
  strings : Array[String],
  namespaces : Array[NsData],
  active_ns : Array[Int],
  ns_map_active : Bool,
  ns_map : Map[String, Int],
  p_start : Int,
  p_end : Int,
) -> Int {
  let plen = p_end - p_start
  let p0 = cur_src.code_unit_at(p_start)
  if plen == 3 && p0 == 0x78 && raw_slice_eq_str(cur_src, p_start, p_end, "xml") {
    return -2
  }
  if ns_map_active {
    return match ns_map.get(cur_src.slice(p_start, p_end)) {
      Some(idx) => idx
      None => -1
    }
  }
  let mut k = active_ns.length() - 1
  while k >= 0 {
    let ns_idx = active_ns[k]
    let ns = namespaces[ns_idx]
    if ns.has_prefix {
      if ns.prefix_span.start >= 0 {
        if ns.prefix_span.end - ns.prefix_span.start == plen &&
        doc_src.code_unit_at(ns.prefix_span.start) == p0 &&
        str_slice_eq(
          doc_src,
          ns.prefix_span.start,
          ns.prefix_span.end,
          cur_src,
          p_start,
          p_end,
        ) {
          return ns_idx
        }
      } else {
        let pstr = strings[-(ns.prefix_span.start + 1)]
        if pstr.length() == plen && raw_slice_eq_str(cur_src, p_start, p_end, pstr) {
          return ns_idx
        }
      }
    }
    k = k - 1
  }
  -1
}

///| Intern a slice from `cur_src` into `strings` and return its negative pool index `-(idx + 1)`.
fn intern_slice(
  cur_src : String,
  strings : Array[String],
  s : Int,
  e : Int,
) -> Int {
  let idx = strings.length()
  strings.push(cur_src.slice(s, e))
  -(idx + 1)
}

///| Update previous sibling's `next_sibling` link in `nodes`.
fn set_next_sibling(nodes : Array[NodeData], prev : Int, child_id : Int) -> Unit {
  let pn = nodes[prev]
  nodes[prev] = NodeData::{
    kind_ns: pn.kind_ns,
    parent: pn.parent,
    prev_sibling: pn.prev_sibling,
    next_sibling: child_id,
    first_child: pn.first_child,
    last_child: pn.last_child,
    s1_start: pn.s1_start,
    s1_end: pn.s1_end,
    s2_start: pn.s2_start,
    s2_end: pn.s2_end,
    attrs_start: pn.attrs_start,
    attrs_end: pn.attrs_end,
    ns_start: pn.ns_start,
    ns_end: pn.ns_end,
  }
}

///| Write deferred `first_child` and `last_child` onto `node_id` once when closing it.
fn finalize_children(
  nodes : Array[NodeData],
  node_id : Int,
  fc : Int,
  lc : Int,
) -> Unit {
  if fc >= 0 {
    let nd = nodes[node_id]
    nodes[node_id] = NodeData::{
      kind_ns: nd.kind_ns,
      parent: nd.parent,
      prev_sibling: nd.prev_sibling,
      next_sibling: nd.next_sibling,
      first_child: fc,
      last_child: lc,
      s1_start: nd.s1_start,
      s1_end: nd.s1_end,
      s2_start: nd.s2_start,
      s2_end: nd.s2_end,
      attrs_start: nd.attrs_start,
      attrs_end: nd.attrs_end,
      ns_start: nd.ns_start,
      ns_end: nd.ns_end,
    }
  }
}

///| Update a Text node's `s1_start`/`s1_end` once when flushing a merged text run.
fn update_text_node_span(
  nodes : Array[NodeData],
  node_id : Int,
  s_start : Int,
  s_end : Int,
) -> Unit {
  let prev_node = nodes[node_id]
  nodes[node_id] = NodeData::{
    kind_ns: prev_node.kind_ns,
    parent: prev_node.parent,
    prev_sibling: prev_node.prev_sibling,
    next_sibling: prev_node.next_sibling,
    first_child: prev_node.first_child,
    last_child: prev_node.last_child,
    s1_start: s_start,
    s1_end: s_end,
    s2_start: 0,
    s2_end: 0,
    attrs_start: 0,
    attrs_end: 0,
    ns_start: 0,
    ns_end: 0,
  }
}

///| Cold helper state passed by reference to out-of-line cold handlers so the hot loop stays register-resident.
struct DomCold {
  src : String
  opts : ParseOptions
  nodes : Array[NodeData]
  attrs : Array[AttrData]
  namespaces : Array[NsData]
  strings : Array[String]
  entities : EntityTable
  budget : EntityBudget
  active_ns : Array[Int]
  mut ns_map_active : Bool
  ns_map : Map[String, Int]
  ns_prev_stack : Array[(String, Int)]
  input_stack : Array[InputFrame]
  mut cur_src : String
  mut len : Int
  mut cur_entity_idx : Int
  mut cur_base_depth : Int
  mut cur_default_ns : Int
  mut cached_ns_idx : Int
  mut root_elem_id : Int
  mut saw_doctype : Bool
  mut text_run_active : Bool
  mut text_run_sb : StringBuilder
  mut last_err : Option[XmlError]
}

///| Flush an open merged text/CDATA run into `strings` and update `cur_lc`.
fn DomCold::flush_text_run(self : DomCold, cur_lc : Int) -> Unit {
  let pool_idx = self.strings.length()
  self.strings.push(self.text_run_sb.to_string())
  update_text_node_span(self.nodes, cur_lc, -(pool_idx + 1), 0)
  self.text_run_active = false
  self.text_run_sb = StringBuilder::new()
}

///| Initialize `text_run_sb` from the previous text node `cur_lc` if not already active.
fn DomCold::ensure_text_run(self : DomCold, cur_lc : Int) -> Unit {
  if !self.text_run_active {
    self.text_run_active = true
    self.text_run_sb = StringBuilder::new()
    let prev_n = self.nodes[cur_lc]
    if prev_n.s1_start < 0 {
      let pidx = -(prev_n.s1_start + 1)
      self.text_run_sb.write_string(self.strings[pidx])
      if pidx == self.strings.length() - 1 {
        let _ = self.strings.pop()
      } else {
        self.strings[pidx] = ""
      }
    } else {
      self.text_run_sb.write_substring(self.src, prev_n.s1_start, prev_n.s1_end)
    }
  }
}

///| Pop active namespace bindings back to `prev_ns_len`.
fn DomCold::pop_ns_scope(self : DomCold, prev_ns_len : Int) -> Unit {
  while self.active_ns.length() > prev_ns_len {
    let _ = self.active_ns.pop()
    if self.ns_map_active {
      match self.ns_prev_stack.pop() {
        Some((ps, prev_i)) => {
          if ps.length() > 0 {
            if prev_i == -1 {
              self.ns_map.remove(ps)
            } else {
              self.ns_map.set(ps, prev_i)
            }
          }
        }
        None => ()
      }
    }
    self.cached_ns_idx = -1
  }
}

///| Cold helper: handle prolog/epilog (`depth == 0`).
///| Returns `Ok((handled, next_pos, new_fc, new_lc))`.
fn DomCold::handle_prolog_epilog(
  self : DomCold,
  start_pos : Int,
  cur_fc : Int,
  cur_lc : Int,
) -> Result[(Bool, Int, Int, Int), XmlError] {
  let cur_src = self.cur_src
  let len = self.len
  let mut pos = start_pos
  if cur_src.code_unit_at(pos) <= 0x20 {
    pos = skip_ws(cur_src, pos, len)
    if pos >= len {
      return Ok((true, pos, cur_fc, cur_lc))
    }
  }
  if cur_src.code_unit_at(pos) != 0x3C {
    return Err(
      make_err(cur_src, pos, XmlErrorKind::InvalidSyntax, "unexpected text outside root element"),
    )
  }
  if pos + 1 >= len {
    return Err(make_err(cur_src, pos, XmlErrorKind::UnexpectedEof, "unexpected EOF after '<'"))
  }
  let b1 = cur_src.code_unit_at(pos + 1)
  if b1 == 0x21 {
    if pos + 4 <= len && cur_src.code_unit_at(pos + 2) == 0x2D && cur_src.code_unit_at(pos + 3) == 0x2D {
      match scan_comment(cur_src, pos + 4, len) {
        Ok((cs, ce, has_cr, ni)) => {
          if self.nodes.length() >= self.opts.limits.max_nodes {
            return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
          }
          let mut vs = cs
          let mut ve = ce
          if has_cr {
            let idx = self.strings.length()
            self.strings.push(normalize_eol(cur_src, cs, ce))
            vs = -(idx + 1)
            ve = 0
          }
          let cid = self.nodes.length()
          self.nodes.push(
            NodeData::{
              kind_ns: pack_kind_ns(node_kind_comment, -1),
              parent: 0,
              prev_sibling: cur_lc,
              next_sibling: -1,
              first_child: -1,
              last_child: -1,
              s1_start: vs,
              s1_end: ve,
              s2_start: 0,
              s2_end: 0,
              attrs_start: 0,
              attrs_end: 0,
              ns_start: 0,
              ns_end: 0,
            },
          )
          let mut nfc = cur_fc
          if cur_lc >= 0 {
            set_next_sibling(self.nodes, cur_lc, cid)
          } else {
            nfc = cid
          }
          return Ok((true, ni, nfc, cid))
        }
        Err(e) => return Err(e)
      }
    } else if pos + 9 <= len && raw_slice_eq_str(cur_src, pos, pos + 9, "<!DOCTYPE") {
      if self.root_elem_id >= 0 {
        return Err(make_err(cur_src, pos, XmlErrorKind::InvalidSyntax, "DOCTYPE not allowed after root element"))
      }
      if self.saw_doctype {
        return Err(make_err(cur_src, pos, XmlErrorKind::InvalidSyntax, "multiple DOCTYPE declarations"))
      }
      if !self.opts.allow_dtd {
        return Err(make_err(cur_src, pos, XmlErrorKind::DtdDetected, "DTD is disabled by default"))
      }
      self.saw_doctype = true
      match parse_doctype(cur_src, pos + 9, len, self.entities) {
        Ok((_, _, ni)) => return Ok((true, ni, cur_fc, cur_lc))
        Err(e) => return Err(e)
      }
    } else if pos + 9 <= len && raw_slice_eq_str(cur_src, pos, pos + 9, "<![CDATA[") {
      return Err(make_err(cur_src, pos, XmlErrorKind::InvalidCData, "CDATA not allowed outside root element"))
    } else {
      return Err(make_err(cur_src, pos, XmlErrorKind::InvalidSyntax, "invalid markup in prolog/epilog"))
    }
  } else if b1 == 0x3F {
    match scan_pi(cur_src, pos + 2, len) {
      Ok((ts, te, vs_raw, ve_raw, has_val, has_cr, ni)) => {
        if self.nodes.length() >= self.opts.limits.max_nodes {
          return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
        }
        let mut vs = 0
        let mut ve = 0
        if has_val {
          if has_cr {
            let idx = self.strings.length()
            self.strings.push(normalize_eol(cur_src, vs_raw, ve_raw))
            vs = -(idx + 1)
            ve = 0
          } else {
            vs = vs_raw
            ve = ve_raw
          }
        }
        let cid = self.nodes.length()
        self.nodes.push(
          NodeData::{
            kind_ns: pack_kind_ns(node_kind_pi, if has_val { 1 } else { 0 }),
            parent: 0,
            prev_sibling: cur_lc,
            next_sibling: -1,
            first_child: -1,
            last_child: -1,
            s1_start: ts,
            s1_end: te,
            s2_start: vs,
            s2_end: ve,
            attrs_start: 0,
            attrs_end: 0,
            ns_start: 0,
            ns_end: 0,
          },
        )
        let mut nfc = cur_fc
        if cur_lc >= 0 {
          set_next_sibling(self.nodes, cur_lc, cid)
        } else {
          nfc = cid
        }
        return Ok((true, ni, nfc, cid))
      }
      Err(e) => return Err(e)
    }
  } else if b1 == 0x2F {
    return Err(make_err(cur_src, pos, XmlErrorKind::MismatchedTag, "unexpected end tag at root level"))
  } else if self.root_elem_id >= 0 {
    return Err(make_err(cur_src, pos, XmlErrorKind::MultipleRootNodes, "multiple root elements"))
  }
  Ok((false, pos, cur_fc, cur_lc))
}

///| Cold helper: handle Comment, CDATA, or PI inside an element.
///| Returns `Ok((next_pos, new_fc, new_lc))`.
fn DomCold::handle_bang_or_pi(
  self : DomCold,
  pos : Int,
  b1 : Int,
  cur_parent : Int,
  cur_fc : Int,
  cur_lc : Int,
) -> Result[(Int, Int, Int), XmlError] {
  let cur_src = self.cur_src
  let len = self.len
  let in_entity = self.cur_entity_idx >= 0
  let max_nodes = self.opts.limits.max_nodes
  let mut nfc = cur_fc
  let mut nlc = cur_lc
  if b1 == 0x21 {
    if pos + 4 <= len && cur_src.code_unit_at(pos + 2) == 0x2D && cur_src.code_unit_at(pos + 3) == 0x2D {
      if self.text_run_active {
        self.flush_text_run(nlc)
      }
      let sc = scan_comment_fast(cur_src, pos + 4, len)
      if sc.next < 0 {
        return match scan_comment(cur_src, pos + 4, len) {
          Ok(_) => Err(make_err(cur_src, pos, XmlErrorKind::InvalidComment, "invalid comment"))
          Err(e) => Err(e)
        }
      }
      if self.nodes.length() >= max_nodes {
        return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
      }
      let mut vs = sc.start
      let mut ve = sc.end
      if sc.has_cr {
        let idx = self.strings.length()
        self.strings.push(normalize_eol(cur_src, sc.start, sc.end))
        vs = -(idx + 1)
        ve = 0
      } else if in_entity {
        vs = intern_slice(cur_src, self.strings, sc.start, sc.end)
        ve = 0
      }
      let cid = self.nodes.length()
      self.nodes.push(
        NodeData::{
          kind_ns: pack_kind_ns(node_kind_comment, -1),
          parent: cur_parent,
          prev_sibling: nlc,
          next_sibling: -1,
          first_child: -1,
          last_child: -1,
          s1_start: vs,
          s1_end: ve,
          s2_start: 0,
          s2_end: 0,
          attrs_start: 0,
          attrs_end: 0,
          ns_start: 0,
          ns_end: 0,
        },
      )
      if nlc >= 0 {
        set_next_sibling(self.nodes, nlc, cid)
      } else {
        nfc = cid
      }
      nlc = cid
      return Ok((sc.next, nfc, nlc))
    } else if pos + 9 <= len && cur_src.code_unit_at(pos + 2) == 0x5B && raw_slice_eq_str(cur_src, pos, pos + 9, "<![CDATA[") {
      let sc = scan_cdata_fast(cur_src, pos + 9, len)
      if sc.next < 0 {
        return match scan_cdata(cur_src, pos + 9, len) {
          Ok(_) => Err(make_err(cur_src, pos, XmlErrorKind::InvalidCData, "invalid CDATA"))
          Err(e) => Err(e)
        }
      }
      if sc.end > sc.start {
        if nlc >= 0 && unpack_kind(self.nodes[nlc].kind_ns) == node_kind_text {
          self.ensure_text_run(nlc)
          if sc.has_cr {
            self.text_run_sb.write_string(normalize_eol(cur_src, sc.start, sc.end))
          } else {
            self.text_run_sb.write_substring(cur_src, sc.start, sc.end)
          }
        } else {
          if self.nodes.length() >= max_nodes {
            return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
          }
          let mut vs = sc.start
          let mut ve = sc.end
          if sc.has_cr {
            let idx = self.strings.length()
            self.strings.push(normalize_eol(cur_src, sc.start, sc.end))
            vs = -(idx + 1)
            ve = 0
          } else if in_entity {
            vs = intern_slice(cur_src, self.strings, sc.start, sc.end)
            ve = 0
          }
          let cid = self.nodes.length()
          self.nodes.push(
            NodeData::{
              kind_ns: pack_kind_ns(node_kind_text, -1),
              parent: cur_parent,
              prev_sibling: nlc,
              next_sibling: -1,
              first_child: -1,
              last_child: -1,
              s1_start: vs,
              s1_end: ve,
              s2_start: 0,
              s2_end: 0,
              attrs_start: 0,
              attrs_end: 0,
              ns_start: 0,
              ns_end: 0,
            },
          )
          if nlc >= 0 {
            set_next_sibling(self.nodes, nlc, cid)
          } else {
            nfc = cid
          }
          nlc = cid
        }
      }
      return Ok((sc.next, nfc, nlc))
    } else {
      return Err(make_err(cur_src, pos, XmlErrorKind::InvalidSyntax, "unexpected '<!' inside element"))
    }
  }
  // PI inside element
  if self.text_run_active {
    self.flush_text_run(nlc)
  }
  match scan_pi(cur_src, pos + 2, len) {
    Ok((ts, te, vs_raw, ve_raw, has_val, has_cr, ni)) => {
      if self.nodes.length() >= max_nodes {
        return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
      }
      let its = if in_entity { intern_slice(cur_src, self.strings, ts, te) } else { ts }
      let ite = if in_entity { 0 } else { te }
      let mut vs = 0
      let mut ve = 0
      if has_val {
        if has_cr {
          let idx = self.strings.length()
          self.strings.push(normalize_eol(cur_src, vs_raw, ve_raw))
          vs = -(idx + 1)
          ve = 0
        } else if in_entity {
          vs = intern_slice(cur_src, self.strings, vs_raw, ve_raw)
          ve = 0
        } else {
          vs = vs_raw
          ve = ve_raw
        }
      }
      let cid = self.nodes.length()
      self.nodes.push(
        NodeData::{
          kind_ns: pack_kind_ns(node_kind_pi, if has_val { 1 } else { 0 }),
          parent: cur_parent,
          prev_sibling: nlc,
          next_sibling: -1,
          first_child: -1,
          last_child: -1,
          s1_start: its,
          s1_end: ite,
          s2_start: vs,
          s2_end: ve,
          attrs_start: 0,
          attrs_end: 0,
          ns_start: 0,
          ns_end: 0,
        },
      )
      if nlc >= 0 {
        set_next_sibling(self.nodes, nlc, cid)
      } else {
        nfc = cid
      }
      nlc = cid
      Ok((ni, nfc, nlc))
    }
    Err(e) => Err(e)
  }
}

///| Cold helper: slow end tag validation (`</name ...>`). Returns `Ok(pos_after_gt)`.
fn DomCold::validate_end_tag_slow(
  self : DomCold,
  name_start : Int,
  open_node : NodeData,
) -> Result[Int, XmlError] {
  let cur_src = self.cur_src
  let len = self.len
  let qn = scan_qname(cur_src, name_start, len)
  let name_end = qn.end
  let colon_pos = qn.colon
  if name_end < 0 {
    return Err(make_err(cur_src, name_start, XmlErrorKind::InvalidName, "invalid end tag name"))
  }
  let after_ws = skip_ws(cur_src, name_end, len)
  if after_ws >= len || cur_src.code_unit_at(after_ws) != 0x3E {
    return Err(make_err(cur_src, after_ws, XmlErrorKind::InvalidSyntax, "expected '>' closing end tag"))
  }
  let open_has_prefix = open_node.s2_start < 0 || open_node.s2_end > open_node.s2_start
  let end_has_prefix = colon_pos >= 0
  let end_ls = if end_has_prefix { colon_pos + 1 } else { name_start }
  let local_eq = if open_node.s1_start < 0 {
    raw_slice_eq_str(cur_src, end_ls, name_end, self.strings[-(open_node.s1_start + 1)])
  } else {
    str_slice_eq(self.src, open_node.s1_start, open_node.s1_end, cur_src, end_ls, name_end)
  }
  let prefix_eq = if !open_has_prefix {
    true
  } else if open_node.s2_start < 0 {
    raw_slice_eq_str(cur_src, name_start, colon_pos, self.strings[-(open_node.s2_start + 1)])
  } else {
    str_slice_eq(self.src, open_node.s2_start, open_node.s2_end, cur_src, name_start, colon_pos)
  }
  if open_has_prefix != end_has_prefix || !local_eq || !prefix_eq {
    return Err(make_err(cur_src, name_start, XmlErrorKind::MismatchedTag, "mismatched end tag"))
  }
  Ok(after_ws + 1)
}

///| Cold helper: handle `xmlns` or `xmlns:prefix` attribute declaration.
fn DomCold::handle_xmlns_attr(
  self : DomCold,
  aname_start : Int,
  aname_end : Int,
  acolon : Int,
  aval_start : Int,
  vs : Int,
  ve : Int,
  ns_start : Int,
) -> Result[Unit, XmlError] {
  let cur_src = self.cur_src
  let in_entity = self.cur_entity_idx >= 0
  let aval_span = TextSpan::{ start: vs, end: ve }
  if acolon < 0 {
    let mut k = ns_start
    while k < self.namespaces.length() {
      if !self.namespaces[k].has_prefix {
        return Err(make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate xmlns attribute"))
      }
      k = k + 1
    }
    if span_eq_str(self.src, self.strings, aval_span, xml_ns_uri) ||
    span_eq_str(self.src, self.strings, aval_span, xmlns_ns_uri) {
      return Err(make_err(cur_src, aval_start, XmlErrorKind::InvalidNamespace, "cannot bind default namespace to reserved URI"))
    }
    let ns_idx = self.namespaces.length()
    self.namespaces.push(
      NsData::{
        prefix_span: TextSpan::empty(),
        uri_span: aval_span,
        has_prefix: false,
      },
    )
    if self.ns_map_active {
      self.ns_prev_stack.push(("", -1))
    }
    self.active_ns.push(ns_idx)
    self.cur_default_ns = if span_len(self.strings, aval_span) == 0 { -1 } else { ns_idx }
    return Ok(())
  }
  let ps_i = if in_entity { intern_slice(cur_src, self.strings, acolon + 1, aname_end) } else { acolon + 1 }
  let pe_i = if in_entity { 0 } else { aname_end }
  let pspan = TextSpan::{ start: ps_i, end: pe_i }
  if !self.ns_map_active && self.active_ns.length() >= 8 {
    self.ns_map_active = true
    let mut m = 0
    while m < self.active_ns.length() {
      let existing_idx = self.active_ns[m]
      let existing_ns = self.namespaces[existing_idx]
      if existing_ns.has_prefix {
        let eps = span_to_string(self.src, self.strings, existing_ns.prefix_span)
        let old_i = match self.ns_map.get(eps) {
          Some(v) => v
          None => -1
        }
        self.ns_prev_stack.push((eps, old_i))
        self.ns_map.set(eps, existing_idx)
      } else {
        self.ns_prev_stack.push(("", -1))
      }
      m = m + 1
    }
  }
  if self.ns_map_active {
    let pstr = cur_src.slice(acolon + 1, aname_end)
    match self.ns_map.get(pstr) {
      Some(prev_i) => {
        if prev_i >= ns_start {
          return Err(make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate xmlns prefix declaration"))
        }
      }
      None => ()
    }
  } else {
    let mut k = ns_start
    while k < self.namespaces.length() {
      if self.namespaces[k].has_prefix &&
      span_eq_span(self.src, self.strings, self.namespaces[k].prefix_span, pspan) {
        return Err(make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate xmlns prefix declaration"))
      }
      k = k + 1
    }
  }
  if span_len(self.strings, aval_span) == 0 {
    return Err(make_err(cur_src, aval_start, XmlErrorKind::InvalidNamespace, "prefixed namespace URI cannot be empty"))
  }
  if span_eq_str(self.src, self.strings, pspan, "xmlns") {
    return Err(make_err(cur_src, aname_start, XmlErrorKind::InvalidNamespace, "cannot declare prefix 'xmlns'"))
  }
  if span_eq_str(self.src, self.strings, pspan, "xml") {
    if !span_eq_str(self.src, self.strings, aval_span, xml_ns_uri) {
      return Err(make_err(cur_src, aval_start, XmlErrorKind::InvalidNamespace, "prefix 'xml' can only be bound to XML namespace"))
    }
  } else {
    if span_eq_str(self.src, self.strings, aval_span, xml_ns_uri) {
      return Err(make_err(cur_src, aval_start, XmlErrorKind::InvalidNamespace, "only prefix 'xml' may bind to XML namespace"))
    }
  }
  if span_eq_str(self.src, self.strings, aval_span, xmlns_ns_uri) {
    return Err(make_err(cur_src, aval_start, XmlErrorKind::InvalidNamespace, "no prefix may bind to xmlns namespace"))
  }
  let ns_idx = self.namespaces.length()
  self.namespaces.push(
    NsData::{
      prefix_span: pspan,
      uri_span: aval_span,
      has_prefix: true,
    },
  )
  if self.ns_map_active {
    let pstr = cur_src.slice(acolon + 1, aname_end)
    let old_i = match self.ns_map.get(pstr) {
      Some(v) => v
      None => -1
    }
    self.ns_prev_stack.push((pstr, old_i))
    self.ns_map.set(pstr, ns_idx)
  }
  self.active_ns.push(ns_idx)
  self.cached_ns_idx = -1
  Ok(())
}

///| Cold helper: resolve namespaces and check duplicates for prefixed attributes.
fn DomCold::resolve_prefixed_attrs(
  self : DomCold,
  attrs_start : Int,
  attrs_end : Int,
  err_pos : Int,
) -> Result[Unit, XmlError] {
  let mut ai = attrs_start
  while ai < attrs_end {
    let cur_a = self.attrs[ai]
    if cur_a.ns_idx == -3 {
      let ans_idx = if cur_a.prefix_start < 0 {
        let pstr = self.strings[-(cur_a.prefix_start + 1)]
        resolve_ns_prefix(
          self.src,
          pstr,
          self.strings,
          self.namespaces,
          self.active_ns,
          self.ns_map_active,
          self.ns_map,
          0,
          pstr.length(),
        )
      } else {
        resolve_ns_prefix(
          self.src,
          self.src,
          self.strings,
          self.namespaces,
          self.active_ns,
          self.ns_map_active,
          self.ns_map,
          cur_a.prefix_start,
          cur_a.prefix_end,
        )
      }
      if ans_idx == -1 {
        return Err(
          make_err(self.cur_src, err_pos, XmlErrorKind::UnboundNamespacePrefix, "unbound namespace prefix on attribute"),
        )
      }
      self.attrs[ai] = AttrData::{
        local_start: cur_a.local_start,
        local_end: cur_a.local_end,
        prefix_start: cur_a.prefix_start,
        prefix_end: cur_a.prefix_end,
        val_start: cur_a.val_start,
        val_end: cur_a.val_end,
        ns_idx: ans_idx,
      }
      let cur_lspan = TextSpan::{ start: cur_a.local_start, end: cur_a.local_end }
      let mut aj = attrs_start
      while aj < ai {
        let prev_a = self.attrs[aj]
        if prev_a.ns_idx != -1 &&
        span_eq_span(
          self.src,
          self.strings,
          TextSpan::{ start: prev_a.local_start, end: prev_a.local_end },
          cur_lspan,
        ) {
          let same_ns = if prev_a.ns_idx == ans_idx {
            true
          } else if prev_a.ns_idx >= 0 && ans_idx >= 0 {
            span_eq_span(
              self.src,
              self.strings,
              self.namespaces[prev_a.ns_idx].uri_span,
              self.namespaces[ans_idx].uri_span,
            )
          } else {
            false
          }
          if same_ns {
            return Err(
              make_err(self.cur_src, err_pos, XmlErrorKind::DuplicateAttribute, "duplicate attribute"),
            )
          }
        }
        aj = aj + 1
      }
    }
    ai = ai + 1
  }
  Ok(())
}

///| Cold helper: push a custom DTD entity frame onto `input_stack`.
fn DomCold::push_custom_entity(
  self : DomCold,
  err_pos : Int,
  custom_ent_idx : Int,
  custom_ent_after : Int,
  depth : Int,
) -> Result[Unit, XmlError] {
  let ent = self.entities.defs[custom_ent_idx]
  if ent.is_external {
    return Err(
      make_err(self.cur_src, err_pos, XmlErrorKind::ExternalEntityNotAllowed, "external entity reference is not allowed"),
    )
  }
  if self.cur_entity_idx == custom_ent_idx {
    return Err(make_err(self.cur_src, err_pos, XmlErrorKind::EntityLoop, "circular entity reference"))
  }
  let mut ek = 0
  while ek < self.input_stack.length() {
    if self.input_stack[ek].entity_idx == custom_ent_idx {
      return Err(make_err(self.cur_src, err_pos, XmlErrorKind::EntityLoop, "circular entity reference"))
    }
    ek = ek + 1
  }
  self.budget.expansions = self.budget.expansions + 1
  self.budget.bytes = self.budget.bytes + ent.value.length()
  if self.budget.expansions > self.budget.max_expansions || self.budget.bytes > self.budget.max_bytes {
    return Err(
      make_err(self.cur_src, err_pos, XmlErrorKind::LimitExceeded, "entity expansion limit exceeded"),
    )
  }
  self.input_stack.push(
    InputFrame::{
      src: self.cur_src,
      pos: custom_ent_after,
      len: self.len,
      entity_idx: self.cur_entity_idx,
      base_depth: self.cur_base_depth,
    },
  )
  self.cur_src = ent.value
  self.len = ent.value.length()
  self.cur_entity_idx = custom_ent_idx
  self.cur_base_depth = depth
  self.cached_ns_idx = -1
  Ok(())
}

///| Helper: parse attributes of a start or empty tag starting at `start_i` (after tag name),
///| push into `self.attrs` / `self.namespaces`, and resolve any prefixed attributes.
///| Zero `Result` boxing: returns `next_pos >= 0` for `<tag ...>`, `-(next_pos + 2)` (`<= -2`) for `<tag .../>`,
///| or `-1` on error (error stored in `self.last_err`).
fn DomCold::parse_tag_attrs(
  self : DomCold,
  start_i : Int,
  ns_start : Int,
  attrs_start : Int,
  tag_pos : Int,
  lut : FixedArray[Int],
) -> Int {
  let src = self.src
  let cur_src = self.cur_src
  let len = self.len
  let attrs = self.attrs
  let strings = self.strings
  let entities = self.entities
  let in_entity = self.cur_entity_idx >= 0
  let no_custom_entities = entities.is_empty()
  let max_attributes = self.opts.limits.max_attributes
  let mut i = start_i
  let mut is_empty = false
  let mut tag_closed = false
  let mut attr_count = 0
  let mut has_prefixed_attr = false
  let mut seen_unprefixed_attrs : Option[Map[String, Bool]] = None

  while i < len {
    let ws_before = i
    let b_ws = cur_src.code_unit_at(i)
    if b_ws == 0x20 {
      i = i + 1
      if i < len && cur_src.code_unit_at(i) <= 0x20 {
        i = skip_ws(cur_src, i, len)
      }
    } else if b_ws <= 0x20 {
      i = skip_ws(cur_src, i, len)
    }
    if i >= len {
      self.last_err = Some(make_err(cur_src, i, XmlErrorKind::UnexpectedEof, "unterminated start tag"))
      return -1
    }
    let cb = cur_src.code_unit_at(i)
    if cb == 0x3E {
      i = i + 1
      tag_closed = true
      break
    }
    if cb == 0x2F {
      if i + 1 >= len || cur_src.code_unit_at(i + 1) != 0x3E {
        self.last_err = Some(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "expected '>' after '/' in empty tag"))
        return -1
      }
      is_empty = true
      i = i + 2
      tag_closed = true
      break
    }
    if i == ws_before {
      self.last_err = Some(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "expected whitespace before attribute"))
      return -1
    }
    attr_count = attr_count + 1
    if attr_count > max_attributes {
      self.last_err = Some(make_err(cur_src, i, XmlErrorKind::LimitExceeded, "max_attributes limit exceeded"))
      return -1
    }
    let aname_start = i
    // Inline fast ASCII QName scan for attribute name (lut[128..255] == 0)
    let mut aname_end = aname_start
    let mut acolon = -1
    if (lut[cb] & mask_ncname_start) != 0 {
      aname_end = aname_start + 1
      while aname_end < len {
        if (lut[cur_src.code_unit_at(aname_end)] & mask_ncname_char) != 0 {
          aname_end = aname_end + 1
        } else {
          break
        }
      }
      if aname_end < len {
        let ab = cur_src.code_unit_at(aname_end)
        if ab == 0x3A {
          acolon = aname_end
          aname_end = aname_end + 1
          if aname_end < len && (lut[cur_src.code_unit_at(aname_end)] & mask_ncname_start) != 0 {
            aname_end = aname_end + 1
            while aname_end < len {
              if (lut[cur_src.code_unit_at(aname_end)] & mask_ncname_char) != 0 {
                aname_end = aname_end + 1
              } else {
                break
              }
            }
            if aname_end < len && (cur_src.code_unit_at(aname_end) >= 0x80 || cur_src.code_unit_at(aname_end) == 0x3A) {
              let qn = scan_qname(cur_src, aname_start, len)
              aname_end = qn.end
              acolon = qn.colon
            }
          } else {
            let qn = scan_qname(cur_src, aname_start, len)
            aname_end = qn.end
            acolon = qn.colon
          }
        } else if ab >= 0x80 {
          let qn = scan_qname(cur_src, aname_start, len)
          aname_end = qn.end
          acolon = qn.colon
        }
      }
    } else {
      let qn = scan_qname(cur_src, aname_start, len)
      aname_end = qn.end
      acolon = qn.colon
    }
    if aname_end < 0 {
      self.last_err = Some(make_err(cur_src, aname_start, XmlErrorKind::InvalidName, "invalid attribute name"))
      return -1
    }
    i = aname_end
    if i < len && cur_src.code_unit_at(i) <= 0x20 {
      i = skip_ws(cur_src, i, len)
    }
    if i >= len || cur_src.code_unit_at(i) != 0x3D {
      self.last_err = Some(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "expected '=' after attribute name"))
      return -1
    }
    i = i + 1
    if i < len && cur_src.code_unit_at(i) <= 0x20 {
      i = skip_ws(cur_src, i, len)
    }
    if i >= len {
      self.last_err = Some(make_err(cur_src, i, XmlErrorKind::UnexpectedEof, "expected attribute value quote"))
      return -1
    }
    let quote = cur_src.code_unit_at(i)
    if quote != 0x22 && quote != 0x27 {
      self.last_err = Some(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "attribute value must be quoted"))
      return -1
    }
    i = i + 1
    let aval_start = i
    let fast_mask = if quote == 0x22 { mask_attr_dq_fast } else { mask_attr_sq_fast }
    let mut needs_unescape = false
    let mut vs = 0
    let mut ve = 0
    let mut aval_done = false
    while i < len {
      while i <= len - 4 {
        let m0 = lut[cur_src.code_unit_at(i)]
        let m1 = lut[cur_src.code_unit_at(i + 1)]
        let m2 = lut[cur_src.code_unit_at(i + 2)]
        let m3 = lut[cur_src.code_unit_at(i + 3)]
        if ((m0 & m1 & m2 & m3) & fast_mask) != 0 {
          i = i + 4
        } else {
          break
        }
      }
      while i < len {
        if (lut[cur_src.code_unit_at(i)] & fast_mask) != 0 {
          i = i + 1
        } else {
          break
        }
      }
      if i >= len {
        break
      }
      let ab = cur_src.code_unit_at(i)
      if ab == quote {
        break
      }
      if ab < 0x80 {
        if ab == 0x26 || ab == 0x09 || ab == 0x0A || ab == 0x0D {
          if no_custom_entities {
            match scan_and_unescape_attr_no_dtd(cur_src, aval_start, i, len, quote, in_entity) {
              Ok((s, next_i)) => {
                let idx = strings.length()
                strings.push(s)
                vs = -(idx + 1)
                ve = 0
                i = next_i
                aval_done = true
                break
              }
              Err(e) => {
                self.last_err = Some(e)
                return -1
              }
            }
          }
          needs_unescape = true
          i = i + 1
        } else if ab == 0x3C {
          self.last_err = Some(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "'<' not allowed in attribute value"))
          return -1
        } else {
          self.last_err = Some(make_err(cur_src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in attribute value"))
          return -1
        }
      } else {
        let dec = decode_utf8_packed(cur_src, i, len)
        if dec < 0 || !is_xml_char(dec >> 3) {
          self.last_err = Some(make_err(cur_src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in attribute value"))
          return -1
        }
        i = i + (dec & 7)
      }
    }
    if !aval_done {
      if i >= len || cur_src.code_unit_at(i) != quote {
        self.last_err = Some(make_err(cur_src, aval_start, XmlErrorKind::UnexpectedEof, "unterminated attribute value"))
        return -1
      }
      let aval_end = i
      i = i + 1
      if needs_unescape {
        match unescape_span(
          cur_src,
          aval_start,
          aval_end,
          true,
          entities,
          self.budget,
          self.cur_entity_idx,
          self.input_stack,
        ) {
          Ok(s) => {
            let idx = strings.length()
            strings.push(s)
            vs = -(idx + 1)
            ve = 0
          }
          Err(e) => {
            self.last_err = Some(e)
            return -1
          }
        }
      } else if in_entity {
        vs = intern_slice(cur_src, strings, aval_start, aval_end)
        ve = 0
      } else {
        vs = aval_start
        ve = aval_end
      }
    }

    if cb == 0x78 &&
    ((acolon < 0 && aname_end - aname_start == 5 && raw_slice_eq_str(cur_src, aname_start, aname_end, "xmlns")) ||
      (acolon >= 0 && acolon - aname_start == 5 && raw_slice_eq_str(cur_src, aname_start, acolon, "xmlns"))) {
      match self.handle_xmlns_attr(aname_start, aname_end, acolon, aval_start, vs, ve, ns_start) {
        Ok(()) => ()
        Err(e) => {
          self.last_err = Some(e)
          return -1
        }
      }
    } else if acolon < 0 {
      let cur_alen = attrs.length()
      if cur_alen > attrs_start {
        match seen_unprefixed_attrs {
          None => {
            if cur_alen - attrs_start >= 16 {
              let m : Map[String, Bool] = Map::new()
              let mut aj = attrs_start
              while aj < cur_alen {
                let pa = attrs[aj]
                if pa.ns_idx == -1 {
                  m.set(
                    span_to_string(src, strings, TextSpan::{ start: pa.local_start, end: pa.local_end }),
                    true,
                  )
                }
                aj = aj + 1
              }
              let astr = cur_src.slice(aname_start, aname_end)
              match m.get(astr) {
                Some(_) => {
                  self.last_err = Some(make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
                  return -1
                }
                None => m.set(astr, true)
              }
              seen_unprefixed_attrs = Some(m)
            } else {
              let alen = aname_end - aname_start
              let mut aj = attrs_start
              while aj < cur_alen {
                let prev_a = attrs[aj]
                if prev_a.ns_idx == -1 {
                  let is_dup = if prev_a.local_start < 0 {
                    let pstr = strings[-(prev_a.local_start + 1)]
                    pstr.length() == alen && raw_slice_eq_str(cur_src, aname_start, aname_end, pstr)
                  } else {
                    prev_a.local_end - prev_a.local_start == alen &&
                    src.code_unit_at(prev_a.local_start) == cb &&
                    (if !in_entity {
                      raw_slice_eq(src, prev_a.local_start, prev_a.local_end, aname_start, aname_end)
                    } else {
                      str_slice_eq(src, prev_a.local_start, prev_a.local_end, cur_src, aname_start, aname_end)
                    })
                  }
                  if is_dup {
                    self.last_err = Some(
                      make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"),
                    )
                    return -1
                  }
                }
                aj = aj + 1
              }
            }
          }
          Some(m) => {
            let astr = cur_src.slice(aname_start, aname_end)
            match m.get(astr) {
              Some(_) => {
                self.last_err = Some(make_err(cur_src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
                return -1
              }
              None => m.set(astr, true)
            }
          }
        }
      }
      let ls_i = if in_entity { intern_slice(cur_src, strings, aname_start, aname_end) } else { aname_start }
      let le_i = if in_entity { 0 } else { aname_end }
      attrs.push(
        AttrData::{
          local_start: ls_i,
          local_end: le_i,
          prefix_start: 0,
          prefix_end: 0,
          val_start: vs,
          val_end: ve,
          ns_idx: -1,
        },
      )
    } else {
      has_prefixed_attr = true
      let ls_i = if in_entity { intern_slice(cur_src, strings, acolon + 1, aname_end) } else { acolon + 1 }
      let le_i = if in_entity { 0 } else { aname_end }
      let ps_i = if in_entity { intern_slice(cur_src, strings, aname_start, acolon) } else { aname_start }
      let pe_i = if in_entity { 0 } else { acolon }
      attrs.push(
        AttrData::{
          local_start: ls_i,
          local_end: le_i,
          prefix_start: ps_i,
          prefix_end: pe_i,
          val_start: vs,
          val_end: ve,
          ns_idx: -3,
        },
      )
    }
  }

  if !tag_closed {
    self.last_err = Some(make_err(cur_src, i, XmlErrorKind::UnexpectedEof, "unterminated start tag"))
    return -1
  }

  if has_prefixed_attr {
    match self.resolve_prefixed_attrs(attrs_start, attrs.length(), tag_pos) {
      Ok(()) => ()
      Err(e) => {
        self.last_err = Some(e)
        return -1
      }
    }
  }

  if is_empty {
    -(i + 2)
  } else {
    i
  }
}

///| Parse an XML 1.0 document with default security options (DTD disabled, bounded limits).
pub fn Document::parse(src : String) -> Result[Document, XmlError] {
  Document::parse_with_options(src, ParseOptions::default())
}

///| Parse an XML 1.0 document into a flat-array read-only DOM with custom options.
pub fn Document::parse_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Document, XmlError] {
  let main_len = src.length()
  let mut pos = 0
  // Strip optional UTF-8 BOM (EF BB BF)
  if main_len >= 3 &&
  src.code_unit_at(0) == 0xEF &&
  src.code_unit_at(1) == 0xBB &&
  src.code_unit_at(2) == 0xBF {
    pos = 3
  }

  let est_nodes = if main_len > 64 { main_len / 32 + 16 } else { 16 }
  let est_attrs = if main_len > 64 { main_len / 28 + 16 } else { 16 }
  let nodes : Array[NodeData] = Array::with_capacity(est_nodes)
  let attrs : Array[AttrData] = Array::with_capacity(est_attrs)
  let namespaces : Array[NsData] = Array::with_capacity(16)
  let strings : Array[String] = []
  let entities = EntityTable::new()

  // Node 0: Document Root
  nodes.push(
    NodeData::{
      kind_ns: pack_kind_ns(node_kind_root, -1),
      parent: -1,
      prev_sibling: -1,
      next_sibling: -1,
      first_child: -1,
      last_child: -1,
      s1_start: 0,
      s1_end: 0,
      s2_start: 0,
      s2_end: 0,
      attrs_start: 0,
      attrs_end: 0,
      ns_start: 0,
      ns_end: 0,
    },
  )

  // Optional XML declaration at exact start (after optional BOM)
  if pos + 5 <= main_len && raw_slice_eq_str(src, pos, pos + 5, "<?xml") {
    let next_b = if pos + 5 < main_len { src.code_unit_at(pos + 5) } else { 0 }
    if next_b == 0x20 ||
    next_b == 0x09 ||
    next_b == 0x0A ||
    next_b == 0x0D ||
    next_b == 0x3F {
      match parse_xml_decl(src, pos, main_len) {
        Ok((_, ni)) => pos = ni
        Err(e) => return Err(e)
      }
    }
  }

  let cold = DomCold::{
    src: src,
    opts: opts,
    nodes: nodes,
    attrs: attrs,
    namespaces: namespaces,
    strings: strings,
    entities: entities,
    budget: EntityBudget::new(opts.limits),
    active_ns: [],
    ns_map_active: false,
    ns_map: Map::new(),
    ns_prev_stack: [],
    input_stack: [],
    cur_src: src,
    len: main_len,
    cur_entity_idx: -1,
    cur_base_depth: 0,
    cur_default_ns: -1,
    cached_ns_idx: -1,
    root_elem_id: -1,
    saw_doctype: false,
    text_run_active: false,
    text_run_sb: StringBuilder::new(),
    last_err: None,
  }

  // Hot registers
  let lut = xml_lut
  let first_child_stack : Array[Int] = Array::with_capacity(64)
  let last_child_stack : Array[Int] = Array::with_capacity(64)
  let ns_scope_stack : Array[Int] = []
  let default_ns_stack : Array[Int] = []
  let mut cur_src = src
  let mut len = main_len
  let mut depth = 0
  let mut cur_parent = 0
  let mut cur_fc = -1
  let mut cur_lc = -1
  let mut cached_ns_p_start = 0
  let mut cached_ns_p_end = 0
  let max_depth = opts.limits.max_depth
  let max_nodes = opts.limits.max_nodes

  while true {
    if pos >= len {
      if cold.cur_entity_idx >= 0 {
        if depth != cold.cur_base_depth {
          return Err(
            make_err(cur_src, pos, XmlErrorKind::UnclosedTag, "unbalanced markup inside entity replacement text"),
          )
        }
        match cold.input_stack.pop() {
          Some(prev) => {
            cur_src = prev.src
            cold.cur_src = prev.src
            pos = prev.pos
            len = prev.len
            cold.len = prev.len
            cold.cur_entity_idx = prev.entity_idx
            cold.cur_base_depth = prev.base_depth
            cold.cached_ns_idx = -1
            continue
          }
          None => break
        }
      }
      break
    }

    let in_entity = cold.cur_entity_idx >= 0

    if depth == 0 {
      match cold.handle_prolog_epilog(pos, cur_fc, cur_lc) {
        Ok((handled, ni, nfc, nlc)) => {
          pos = ni
          cur_fc = nfc
          cur_lc = nlc
          if handled {
            continue
          }
        }
        Err(e) => return Err(e)
      }
    }

    // Inside element (or starting root element at '<')
    if cur_src.code_unit_at(pos) != 0x3C {
      let has_custom_entities = !entities.is_empty()
      let text_start = pos
      let mut i = pos
      let mut needs_unescape = false
      let mut unescaped_direct = ""
      let mut did_direct_unescape = false
      let mut custom_ent_idx = -1
      let mut custom_ent_after = -1
      while i < len {
        while i <= len - 4 {
          let m0 = lut[cur_src.code_unit_at(i)]
          let m1 = lut[cur_src.code_unit_at(i + 1)]
          let m2 = lut[cur_src.code_unit_at(i + 2)]
          let m3 = lut[cur_src.code_unit_at(i + 3)]
          if ((m0 & m1 & m2 & m3) & mask_text_fast) != 0 {
            i = i + 4
          } else {
            break
          }
        }
        while i < len {
          if (lut[cur_src.code_unit_at(i)] & mask_text_fast) != 0 {
            i = i + 1
          } else {
            break
          }
        }
        if i >= len {
          break
        }
        let b = cur_src.code_unit_at(i)
        if b == 0x3C {
          break
        }
        if b < 0x80 {
          if b == 0x26 {
            if !has_custom_entities {
              match scan_and_unescape_text_no_dtd(cur_src, text_start, i, len, in_entity) {
                Ok((s, end_i)) => {
                  unescaped_direct = s
                  did_direct_unescape = true
                  i = end_i
                  break
                }
                Err(e) => return Err(e)
              }
            }
            if i + 1 < len && cur_src.code_unit_at(i + 1) != 0x23 {
              let mut semi = i + 1
              while semi < len && cur_src.code_unit_at(semi) != 0x3B {
                semi = semi + 1
              }
              if semi < len && semi > i + 1 && lookup_predefined_entity(cur_src, i + 1, semi) < 0 {
                match entities.lookup(cur_src, i + 1, semi) {
                  Some(eidx) => {
                    custom_ent_idx = eidx
                    custom_ent_after = semi + 1
                    break
                  }
                  None =>
                  return Err(make_err(cur_src, i, XmlErrorKind::UnknownEntity, "unknown entity reference"))
                }
              }
            }
            needs_unescape = true
            i = i + 1
          } else if b == 0x0D {
            if !in_entity {
              if !has_custom_entities {
                match scan_and_unescape_text_no_dtd(cur_src, text_start, i, len, false) {
                  Ok((s, end_i)) => {
                    unescaped_direct = s
                    did_direct_unescape = true
                    i = end_i
                    break
                  }
                  Err(e) => return Err(e)
                }
              }
              needs_unescape = true
            }
            i = i + 1
          } else if b == 0x5D {
            if i + 2 < len &&
            cur_src.code_unit_at(i + 1) == 0x5D &&
            cur_src.code_unit_at(i + 2) == 0x3E {
              return Err(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "']]>' is not allowed in text content"))
            }
            i = i + 1
          } else {
            return Err(make_err(cur_src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in text"))
          }
        } else {
          let dec = decode_utf8_packed(cur_src, i, len)
          if dec < 0 || !is_xml_char(dec >> 3) {
            return Err(make_err(cur_src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in text"))
          }
          i = i + (dec & 7)
        }
      }

      if i > text_start {
        let mut ts = text_start
        let mut te = i
        let mut chunk_non_empty = true
        if did_direct_unescape || needs_unescape {
          let s = if did_direct_unescape {
            unescaped_direct
          } else {
            match unescape_span(
              cur_src,
              text_start,
              i,
              false,
              entities,
              cold.budget,
              cold.cur_entity_idx,
              cold.input_stack,
            ) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
          }
          if s.length() == 0 {
            chunk_non_empty = false
          } else if cur_lc >= 0 && unpack_kind(nodes[cur_lc].kind_ns) == node_kind_text {
            cold.ensure_text_run(cur_lc)
            cold.text_run_sb.write_string(s)
            chunk_non_empty = false
          } else {
            let idx = strings.length()
            strings.push(s)
            ts = -(idx + 1)
            te = 0
          }
        }
        if chunk_non_empty {
          if cur_lc >= 0 && unpack_kind(nodes[cur_lc].kind_ns) == node_kind_text {
            cold.ensure_text_run(cur_lc)
            if ts < 0 {
              let nidx = -(ts + 1)
              cold.text_run_sb.write_string(strings[nidx])
              if nidx == strings.length() - 1 {
                let _ = strings.pop()
              } else {
                strings[nidx] = ""
              }
            } else {
              cold.text_run_sb.write_substring(cur_src, ts, te)
            }
          } else {
            if nodes.length() >= max_nodes {
              return Err(
                make_err(cur_src, text_start, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"),
              )
            }
            let final_ts = if ts >= 0 && in_entity { intern_slice(cur_src, strings, ts, te) } else { ts }
            let final_te = if ts >= 0 && in_entity { 0 } else { te }
            let cid = nodes.length()
            nodes.push(
              NodeData::{
                kind_ns: pack_kind_ns(node_kind_text, -1),
                parent: cur_parent,
                prev_sibling: cur_lc,
                next_sibling: -1,
                first_child: -1,
                last_child: -1,
                s1_start: final_ts,
                s1_end: final_te,
                s2_start: 0,
                s2_end: 0,
                attrs_start: 0,
                attrs_end: 0,
                ns_start: 0,
                ns_end: 0,
              },
            )
            if cur_lc >= 0 {
              set_next_sibling(nodes, cur_lc, cid)
            } else {
              cur_fc = cid
            }
            cur_lc = cid
          }
        }
      }

      if custom_ent_idx >= 0 {
        match cold.push_custom_entity(i, custom_ent_idx, custom_ent_after, depth) {
          Ok(()) => {
            cur_src = cold.cur_src
            len = cold.len
            pos = 0
            continue
          }
          Err(e) => return Err(e)
        }
      }

      pos = i
      continue
    }

    // Current byte is '<'
    if pos + 1 >= len {
      return Err(make_err(cur_src, pos, XmlErrorKind::UnexpectedEof, "unexpected EOF after '<'"))
    }
    let b1 = cur_src.code_unit_at(pos + 1)
    if b1 == 0x2F {
      // End tag `</name>`
      if depth == 0 {
        return Err(make_err(cur_src, pos, XmlErrorKind::MismatchedTag, "unexpected end tag"))
      }
      if in_entity && depth <= cold.cur_base_depth {
        return Err(make_err(cur_src, pos, XmlErrorKind::MismatchedTag, "unbalanced end tag inside entity"))
      }
      if cold.text_run_active {
        cold.flush_text_run(cur_lc)
      }
      let open_id = cur_parent
      let open_node = nodes[open_id]
      let name_start = pos + 2
      let mut fast_ok = false
      let mut next_pos = 0
      if !in_entity && open_node.s1_start >= 0 && open_node.s2_start >= 0 {
        let p_len = open_node.s2_end - open_node.s2_start
        let l_len = open_node.s1_end - open_node.s1_start
        let expected_end = if p_len > 0 {
          name_start + p_len + 1 + l_len
        } else {
          name_start + l_len
        }
        if expected_end < len && cur_src.code_unit_at(expected_end) == 0x3E {
          if p_len == 0 {
            fast_ok = raw_slice_eq(
              src,
              name_start,
              expected_end,
              open_node.s1_start,
              open_node.s1_end,
            )
          } else if cur_src.code_unit_at(name_start + p_len) == 0x3A {
            fast_ok = raw_slice_eq(
              src,
              name_start,
              name_start + p_len,
              open_node.s2_start,
              open_node.s2_end,
            ) &&
            raw_slice_eq(
              src,
              name_start + p_len + 1,
              expected_end,
              open_node.s1_start,
              open_node.s1_end,
            )
          }
        }
        next_pos = expected_end + 1
      }
      if !fast_ok {
        match cold.validate_end_tag_slow(name_start, open_node) {
          Ok(np) => next_pos = np
          Err(e) => return Err(e)
        }
      }
      finalize_children(nodes, open_id, cur_fc, cur_lc)
      let nsl = ns_scope_stack.length()
      if nsl > 0 && ns_scope_stack[nsl - 1] == depth {
        let _ = ns_scope_stack.pop()
        let prev_ns_len = match ns_scope_stack.pop() {
          Some(v) => v
          None => 0
        }
        if cold.active_ns.length() > prev_ns_len {
          cold.pop_ns_scope(prev_ns_len)
        }
        cold.cur_default_ns = match default_ns_stack.pop() {
          Some(v) => v
          None => -1
        }
      }
      depth = depth - 1
      cur_parent = open_node.parent
      cur_fc = first_child_stack[depth]
      cur_lc = last_child_stack[depth]
      pos = next_pos
      continue
    }
    if b1 == 0x21 || b1 == 0x3F {
      match cold.handle_bang_or_pi(pos, b1, cur_parent, cur_fc, cur_lc) {
        Ok((ni, nfc, nlc)) => {
          pos = ni
          cur_fc = nfc
          cur_lc = nlc
          continue
        }
        Err(e) => return Err(e)
      }
    }

    // Flush any open merged text run before starting child element
    if cold.text_run_active {
      cold.flush_text_run(cur_lc)
    }

    // Start or Empty element tag `<name ...>` / `<name .../>`
    if depth >= max_depth {
      return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_depth limit exceeded"))
    }
    if nodes.length() >= max_nodes {
      return Err(make_err(cur_src, pos, XmlErrorKind::LimitExceeded, "max_nodes limit exceeded"))
    }
    let tag_start = pos + 1
    // Inline fast ASCII QName scan for tag name (lut[128..255] == 0)
    let mut tag_end = tag_start
    let mut tag_colon = -1
    if (lut[b1] & mask_ncname_start) != 0 {
      tag_end = tag_start + 1
      while tag_end < len {
        if (lut[cur_src.code_unit_at(tag_end)] & mask_ncname_char) != 0 {
          tag_end = tag_end + 1
        } else {
          break
        }
      }
      if tag_end < len {
        let tb = cur_src.code_unit_at(tag_end)
        if tb == 0x3A {
          tag_colon = tag_end
          tag_end = tag_end + 1
          if tag_end < len && (lut[cur_src.code_unit_at(tag_end)] & mask_ncname_start) != 0 {
            tag_end = tag_end + 1
            while tag_end < len {
              if (lut[cur_src.code_unit_at(tag_end)] & mask_ncname_char) != 0 {
                tag_end = tag_end + 1
              } else {
                break
              }
            }
            if tag_end < len && (cur_src.code_unit_at(tag_end) >= 0x80 || cur_src.code_unit_at(tag_end) == 0x3A) {
              let qn = scan_qname(cur_src, tag_start, len)
              tag_end = qn.end
              tag_colon = qn.colon
            }
          } else {
            let qn = scan_qname(cur_src, tag_start, len)
            tag_end = qn.end
            tag_colon = qn.colon
          }
        } else if tb >= 0x80 {
          let qn = scan_qname(cur_src, tag_start, len)
          tag_end = qn.end
          tag_colon = qn.colon
        }
      }
    } else {
      let qn = scan_qname(cur_src, tag_start, len)
      tag_end = qn.end
      tag_colon = qn.colon
    }
    if tag_end < 0 {
      return Err(make_err(cur_src, tag_start, XmlErrorKind::InvalidName, "invalid element tag name"))
    }
    let tag_has_prefix = tag_colon >= 0
    let tag_p_start = if tag_has_prefix { tag_start } else { 0 }
    let tag_p_end = if tag_has_prefix { tag_colon } else { 0 }
    let tag_l_start = if tag_has_prefix { tag_colon + 1 } else { tag_start }
    let tag_l_end = tag_end
    if tag_has_prefix &&
    tag_colon - tag_start == 5 &&
    b1 == 0x78 &&
    raw_slice_eq_str(cur_src, tag_start, tag_colon, "xmlns") {
      return Err(
        make_err(cur_src, tag_start, XmlErrorKind::InvalidNamespace, "element cannot use 'xmlns' prefix"),
      )
    }

    // Parse attributes and xmlns declarations directly into `attrs` / `namespaces`
    let mut i = tag_end
    let ns_start = namespaces.length()
    let prev_active_ns_len = cold.active_ns.length()
    let prev_default_ns = cold.cur_default_ns
    let attrs_start = attrs.length()
    let mut is_empty = false

    // Fast path for zero-attribute tags (`<tag>` or `<tag/>`)
    if i < len && cur_src.code_unit_at(i) == 0x3E {
      i = i + 1
    } else if i < len && cur_src.code_unit_at(i) == 0x2F {
      if i + 1 >= len || cur_src.code_unit_at(i + 1) != 0x3E {
        return Err(make_err(cur_src, i, XmlErrorKind::InvalidSyntax, "expected '>' after '/' in empty tag"))
      }
      is_empty = true
      i = i + 2
    } else {
      let res_i = cold.parse_tag_attrs(i, ns_start, attrs_start, pos, lut)
      if res_i == -1 {
        return match cold.last_err {
          Some(e) => Err(e)
          None => Err(make_err(cur_src, pos, XmlErrorKind::InvalidSyntax, "attribute error"))
        }
      }
      if res_i < 0 {
        is_empty = true
        i = -(res_i + 2)
      } else {
        i = res_i
      }
    }

    // Resolve element namespace
    let elem_ns_idx = if tag_has_prefix {
      if !in_entity &&
      cold.cached_ns_idx >= 0 &&
      cached_ns_p_end - cached_ns_p_start == tag_p_end - tag_p_start &&
      src.code_unit_at(cached_ns_p_start) == b1 &&
      raw_slice_eq(src, cached_ns_p_start, cached_ns_p_end, tag_p_start, tag_p_end) {
        cold.cached_ns_idx
      } else {
        let r = resolve_ns_prefix(
          src,
          cur_src,
          strings,
          namespaces,
          cold.active_ns,
          cold.ns_map_active,
          cold.ns_map,
          tag_p_start,
          tag_p_end,
        )
        if r == -1 {
          return Err(
            make_err(cur_src, tag_start, XmlErrorKind::UnboundNamespacePrefix, "unbound namespace prefix on element"),
          )
        }
        if !in_entity {
          cached_ns_p_start = tag_p_start
          cached_ns_p_end = tag_p_end
          cold.cached_ns_idx = r
        }
        r
      }
    } else {
      cold.cur_default_ns
    }

    let attrs_end = attrs.length()
    let ns_end = namespaces.length()

    let final_l_start = if in_entity { intern_slice(cur_src, strings, tag_l_start, tag_l_end) } else { tag_l_start }
    let final_l_end = if in_entity { 0 } else { tag_l_end }
    let final_p_start = if tag_has_prefix {
      if in_entity { intern_slice(cur_src, strings, tag_p_start, tag_p_end) } else { tag_p_start }
    } else {
      0
    }
    let final_p_end = if tag_has_prefix && !in_entity { tag_p_end } else { 0 }

    let elem_id = nodes.length()
    nodes.push(
      NodeData::{
        kind_ns: pack_kind_ns(node_kind_element, elem_ns_idx),
        parent: cur_parent,
        prev_sibling: cur_lc,
        next_sibling: -1,
        first_child: -1,
        last_child: -1,
        s1_start: final_l_start,
        s1_end: final_l_end,
        s2_start: final_p_start,
        s2_end: final_p_end,
        attrs_start: attrs_start,
        attrs_end: attrs_end,
        ns_start: ns_start,
        ns_end: ns_end,
      },
    )
    if cur_lc >= 0 {
      set_next_sibling(nodes, cur_lc, elem_id)
    } else {
      cur_fc = elem_id
    }
    cur_lc = elem_id
    if cold.root_elem_id < 0 {
      cold.root_elem_id = elem_id
    }
    if is_empty {
      if ns_end > ns_start {
        if cold.active_ns.length() > prev_active_ns_len {
          cold.pop_ns_scope(prev_active_ns_len)
        }
        cold.cur_default_ns = prev_default_ns
      }
    } else {
      if depth < first_child_stack.length() {
        first_child_stack[depth] = cur_fc
        last_child_stack[depth] = cur_lc
      } else {
        first_child_stack.push(cur_fc)
        last_child_stack.push(cur_lc)
      }
      depth = depth + 1
      if ns_end > ns_start {
        ns_scope_stack.push(prev_active_ns_len)
        ns_scope_stack.push(depth)
        default_ns_stack.push(prev_default_ns)
      }
      cur_parent = elem_id
      cur_fc = -1
      cur_lc = -1
    }
    pos = i
  }

  if depth > 0 {
    return Err(make_err(src, main_len, XmlErrorKind::UnclosedTag, "unclosed element tag"))
  }
  if cold.root_elem_id < 0 {
    return Err(make_err(src, main_len, XmlErrorKind::NoRootNode, "document has no root element"))
  }
  finalize_children(nodes, 0, cur_fc, cur_lc)
  Ok(
    Document::{
      src: src,
      strings: strings,
      nodes: nodes,
      attrs: attrs,
      namespaces: namespaces,
      root_elem_id: cold.root_elem_id,
    },
  )
}

///| Resolve a `ns_idx` stored in `NodeData` or `AttrData` into `Option[String]`.
fn doc_ns_uri(doc : Document, ns_idx : Int) -> Option[String] {
  if ns_idx == -2 {
    Some(xml_ns_uri)
  } else if ns_idx >= 0 {
    Some(span_to_string(doc.src, doc.strings, doc.namespaces[ns_idx].uri_span))
  } else {
    None
  }
}

///| Check whether `ns_idx` equals a target URI string without allocating.
fn doc_ns_uri_eq(doc : Document, ns_idx : Int, target : String) -> Bool {
  if ns_idx == -2 {
    target == xml_ns_uri
  } else if ns_idx >= 0 {
    span_eq_str(doc.src, doc.strings, doc.namespaces[ns_idx].uri_span, target)
  } else {
    false
  }
}

///|
pub fn Document::root(self : Document) -> Node {
  Node::{ doc: self, id: 0 }
}

///|
pub fn Document::root_element(self : Document) -> Node {
  Node::{ doc: self, id: self.root_elem_id }
}

///| Zero-allocation indexed DOM traversal helpers on `Document`.
pub fn Document::node_kind_at(self : Document, id : Int) -> Int {
  unpack_kind(self.nodes[id].kind_ns)
}

///|
pub fn Document::tag_name_len_at(self : Document, id : Int) -> Int {
  let nd = self.nodes[id]
  if nd.s1_start < 0 {
    self.strings[-(nd.s1_start + 1)].length()
  } else {
    nd.s1_end - nd.s1_start
  }
}

///|
pub fn Document::has_namespace_at(self : Document, id : Int) -> Bool {
  unpack_ns(self.nodes[id].kind_ns) != -1
}

///|
pub fn Document::attrs_range_at(self : Document, id : Int) -> (Int, Int) {
  let nd = self.nodes[id]
  (nd.attrs_start, nd.attrs_end)
}

///|
pub fn Document::attr_value_len_raw(self : Document, attr_idx : Int) -> Int {
  let a = self.attrs[attr_idx]
  if a.val_start < 0 {
    self.strings[-(a.val_start + 1)].length()
  } else {
    a.val_end - a.val_start
  }
}

///|
pub fn Document::text_len_at(self : Document, id : Int) -> Int {
  let nd = self.nodes[id]
  if nd.s1_start < 0 {
    self.strings[-(nd.s1_start + 1)].length()
  } else {
    nd.s1_end - nd.s1_start
  }
}

///|
pub fn Document::node_count(self : Document) -> Int {
  self.nodes.length()
}

///|
pub fn Document::node(self : Document, id : Int) -> Option[Node] {
  if id >= 0 && id < self.nodes.length() {
    Some(Node::{ doc: self, id: id })
  } else {
    None
  }
}

///|
pub fn Document::descendants(self : Document) -> Array[Node] {
  self.root().descendants()
}

///|
pub fn Node::id(self : Node) -> Int {
  self.id
}

///|
pub fn Node::node_type(self : Node) -> NodeType {
  let k = unpack_kind(self.doc.nodes[self.id].kind_ns)
  if k == node_kind_root {
    NodeType::Root
  } else if k == node_kind_element {
    NodeType::Element
  } else if k == node_kind_text {
    NodeType::Text
  } else if k == node_kind_comment {
    NodeType::Comment
  } else {
    NodeType::PI
  }
}

///|
pub fn Node::is_root(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_root
}

///|
pub fn Node::is_element(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_element
}

///|
pub fn Node::is_text(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_text
}

///|
pub fn Node::is_comment(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_comment
}

///|
pub fn Node::is_pi(self : Node) -> Bool {
  unpack_kind(self.doc.nodes[self.id].kind_ns) == node_kind_pi
}

///|
pub fn Node::tag_name(self : Node) -> ExpandedName {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_element {
    return ExpandedName::{ local: "", ns_uri: None, prefix: None }
  }
  let local = span_to_string(
    self.doc.src,
    self.doc.strings,
    TextSpan::{ start: nd.s1_start, end: nd.s1_end },
  )
  let prefix = if nd.s2_start >= 0 && nd.s2_start == nd.s2_end {
    None
  } else {
    Some(
      span_to_string(
        self.doc.src,
        self.doc.strings,
        TextSpan::{ start: nd.s2_start, end: nd.s2_end },
      ),
    )
  }
  let ns_uri = doc_ns_uri(self.doc, unpack_ns(nd.kind_ns))
  ExpandedName::{ local: local, ns_uri: ns_uri, prefix: prefix }
}

///|
pub fn Node::has_tag_name(self : Node, name : String) -> Bool {
  let nd = self.doc.nodes[self.id]
  unpack_kind(nd.kind_ns) == node_kind_element &&
  span_eq_str(
    self.doc.src,
    self.doc.strings,
    TextSpan::{ start: nd.s1_start, end: nd.s1_end },
    name,
  )
}

///|
pub fn Node::has_tag_name_ns(self : Node, ns : String, local : String) -> Bool {
  let nd = self.doc.nodes[self.id]
  unpack_kind(nd.kind_ns) == node_kind_element &&
  doc_ns_uri_eq(self.doc, unpack_ns(nd.kind_ns), ns) &&
  span_eq_str(
    self.doc.src,
    self.doc.strings,
    TextSpan::{ start: nd.s1_start, end: nd.s1_end },
    local,
  )
}

///|
pub fn Node::namespace(self : Node) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_element {
    return None
  }
  doc_ns_uri(self.doc, unpack_ns(nd.kind_ns))
}

///|
pub fn Node::default_namespace(self : Node) -> Option[String] {
  self.lookup_namespace_uri(None)
}

///|
pub fn Node::lookup_namespace_uri(
  self : Node,
  prefix : Option[String],
) -> Option[String] {
  match prefix {
    Some(p) => {
      if p == "xml" {
        return Some(xml_ns_uri)
      }
      let mut cur = self.id
      while cur >= 0 {
        let nd = self.doc.nodes[cur]
        let mut k = nd.ns_end - 1
        while k >= nd.ns_start {
          let ns = self.doc.namespaces[k]
          if ns.has_prefix &&
          span_eq_str(self.doc.src, self.doc.strings, ns.prefix_span, p) {
            return Some(span_to_string(self.doc.src, self.doc.strings, ns.uri_span))
          }
          k = k - 1
        }
        cur = nd.parent
      }
      None
    }
    None => {
      let mut cur = self.id
      while cur >= 0 {
        let nd = self.doc.nodes[cur]
        let mut k = nd.ns_end - 1
        while k >= nd.ns_start {
          let ns = self.doc.namespaces[k]
          if !ns.has_prefix {
            if span_len(self.doc.strings, ns.uri_span) == 0 {
              return None
            }
            return Some(span_to_string(self.doc.src, self.doc.strings, ns.uri_span))
          }
          k = k - 1
        }
        cur = nd.parent
      }
      None
    }
  }
}

///|
pub fn Node::lookup_prefix(self : Node, uri : String) -> Option[String] {
  if uri == xml_ns_uri {
    return Some("xml")
  }
  let mut cur = self.id
  while cur >= 0 {
    let nd = self.doc.nodes[cur]
    let mut k = nd.ns_end - 1
    while k >= nd.ns_start {
      let ns = self.doc.namespaces[k]
      if ns.has_prefix &&
      span_eq_str(self.doc.src, self.doc.strings, ns.uri_span, uri) {
        return Some(span_to_string(self.doc.src, self.doc.strings, ns.prefix_span))
      }
      k = k - 1
    }
    cur = nd.parent
  }
  None
}

///|
pub fn Node::namespaces(self : Node) -> Array[Namespace] {
  let nd = self.doc.nodes[self.id]
  let out : Array[Namespace] = []
  let mut k = nd.ns_start
  while k < nd.ns_end {
    let ns = self.doc.namespaces[k]
    let p = if ns.has_prefix {
      Some(span_to_string(self.doc.src, self.doc.strings, ns.prefix_span))
    } else {
      None
    }
    let u = span_to_string(self.doc.src, self.doc.strings, ns.uri_span)
    out.push(Namespace::{ prefix: p, uri: u })
    k = k + 1
  }
  out
}

///|
pub fn Node::attribute(self : Node, name : String) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let a = self.doc.attrs[i]
    if a.ns_idx == -1 &&
    span_eq_str(
      self.doc.src,
      self.doc.strings,
      TextSpan::{ start: a.local_start, end: a.local_end },
      name,
    ) {
      return Some(
        span_to_string(
          self.doc.src,
          self.doc.strings,
          TextSpan::{ start: a.val_start, end: a.val_end },
        ),
      )
    }
    i = i + 1
  }
  None
}

///|
pub fn Node::attribute_ns(
  self : Node,
  ns : String,
  local : String,
) -> Option[String] {
  let nd = self.doc.nodes[self.id]
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let a = self.doc.attrs[i]
    if doc_ns_uri_eq(self.doc, a.ns_idx, ns) &&
    span_eq_str(
      self.doc.src,
      self.doc.strings,
      TextSpan::{ start: a.local_start, end: a.local_end },
      local,
    ) {
      return Some(
        span_to_string(
          self.doc.src,
          self.doc.strings,
          TextSpan::{ start: a.val_start, end: a.val_end },
        ),
      )
    }
    i = i + 1
  }
  None
}

///|
pub fn Node::has_attribute(self : Node, name : String) -> Bool {
  let nd = self.doc.nodes[self.id]
  let mut i = nd.attrs_start
  while i < nd.attrs_end {
    let a = self.doc.attrs[i]
    if a.ns_idx == -1 &&
    span_eq_str(
      self.doc.src,
      self.doc.strings,
      TextSpan::{ start: a.local_start, end: a.local_end },
      name,
    ) {
      return true
    }
    i = i + 1
  }
  false
}

///|
pub fn Node::attributes(self : Node) -> Array[Attribute] {
  let doc = self.doc
  let nd = doc.nodes[self.id]
  let start = nd.attrs_start
  let end = nd.attrs_end
  if start >= end {
    return []
  }
  let src = doc.src
  let strings = doc.strings
  let attrs = doc.attrs
  let out : Array[Attribute] = Array::with_capacity(end - start)
  let mut i = start
  while i < end {
    let a = attrs[i]
    let local = if a.local_start < 0 {
      strings[-(a.local_start + 1)]
    } else {
      src.slice(a.local_start, a.local_end)
    }
    let prefix = if a.prefix_start >= 0 && a.prefix_start == a.prefix_end {
      None
    } else if a.prefix_start < 0 {
      Some(strings[-(a.prefix_start + 1)])
    } else {
      Some(src.slice(a.prefix_start, a.prefix_end))
    }
    let ns_uri = if a.ns_idx == -1 { None } else { doc_ns_uri(doc, a.ns_idx) }
    let value = if a.val_start < 0 {
      strings[-(a.val_start + 1)]
    } else {
      src.slice(a.val_start, a.val_end)
    }
    out.push(Attribute::{ local: local, ns_uri: ns_uri, prefix: prefix, value: value })
    i = i + 1
  }
  out
}

///|
pub fn Node::attribute_count(self : Node) -> Int {
  let nd = self.doc.nodes[self.id]
  nd.attrs_end - nd.attrs_start
}

///| Zero-allocation byte length of an element's local tag name.
pub fn Node::tag_name_len(self : Node) -> Int {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_element {
    return 0
  }
  if nd.s1_start < 0 {
    self.doc.strings[-(nd.s1_start + 1)].length()
  } else {
    nd.s1_end - nd.s1_start
  }
}

///| Zero-allocation check whether an element has a resolved namespace.
pub fn Node::has_namespace(self : Node) -> Bool {
  let nd = self.doc.nodes[self.id]
  unpack_kind(nd.kind_ns) == node_kind_element && unpack_ns(nd.kind_ns) != -1
}

///| Zero-allocation byte length of the `idx`-th attribute's value on this node.
pub fn Node::attr_value_len(self : Node, idx : Int) -> Int {
  let nd = self.doc.nodes[self.id]
  let pos = nd.attrs_start + idx
  if idx < 0 || pos >= nd.attrs_end {
    return 0
  }
  let a = self.doc.attrs[pos]
  if a.val_start < 0 {
    self.doc.strings[-(a.val_start + 1)].length()
  } else {
    a.val_end - a.val_start
  }
}

///| Zero-allocation byte length of a text/comment node (or an element's first text child).
pub fn Node::text_len(self : Node) -> Int {
  let nd = self.doc.nodes[self.id]
  let k = unpack_kind(nd.kind_ns)
  if k == node_kind_text || k == node_kind_comment {
    return if nd.s1_start < 0 {
      self.doc.strings[-(nd.s1_start + 1)].length()
    } else {
      nd.s1_end - nd.s1_start
    }
  }
  if k == node_kind_element {
    let fc = nd.first_child
    if fc >= 0 && unpack_kind(self.doc.nodes[fc].kind_ns) == node_kind_text {
      let fn_nd = self.doc.nodes[fc]
      return if fn_nd.s1_start < 0 {
        self.doc.strings[-(fn_nd.s1_start + 1)].length()
      } else {
        fn_nd.s1_end - fn_nd.s1_start
      }
    }
  }
  0
}

///|
pub fn Node::text(self : Node) -> Option[String] {
  let doc = self.doc
  let nd = doc.nodes[self.id]
  let k = unpack_kind(nd.kind_ns)
  if k == node_kind_text || k == node_kind_comment {
    if nd.s1_start < 0 {
      return Some(doc.strings[-(nd.s1_start + 1)])
    }
    return Some(doc.src.slice(nd.s1_start, nd.s1_end))
  }
  if k == node_kind_element {
    let fc = nd.first_child
    if fc >= 0 && unpack_kind(doc.nodes[fc].kind_ns) == node_kind_text {
      let fnd = doc.nodes[fc]
      if fnd.s1_start < 0 {
        return Some(doc.strings[-(fnd.s1_start + 1)])
      }
      return Some(doc.src.slice(fnd.s1_start, fnd.s1_end))
    }
  }
  None
}

///|
pub fn Node::pi(self : Node) -> Option[PI] {
  let nd = self.doc.nodes[self.id]
  if unpack_kind(nd.kind_ns) != node_kind_pi {
    return None
  }
  let target = span_to_string(
    self.doc.src,
    self.doc.strings,
    TextSpan::{ start: nd.s1_start, end: nd.s1_end },
  )
  let value = if unpack_ns(nd.kind_ns) != 0 {
    Some(
      span_to_string(
        self.doc.src,
        self.doc.strings,
        TextSpan::{ start: nd.s2_start, end: nd.s2_end },
      ),
    )
  } else {
    None
  }
  Some(PI::{ target: target, value: value })
}

///|
pub fn Node::parent(self : Node) -> Option[Node] {
  let p = self.doc.nodes[self.id].parent
  if p >= 0 {
    Some(Node::{ doc: self.doc, id: p })
  } else {
    None
  }
}

///|
pub fn Node::first_child(self : Node) -> Option[Node] {
  let fc = self.doc.nodes[self.id].first_child
  if fc >= 0 {
    Some(Node::{ doc: self.doc, id: fc })
  } else {
    None
  }
}

///|
pub fn Node::last_child(self : Node) -> Option[Node] {
  let lc = self.doc.nodes[self.id].last_child
  if lc >= 0 {
    Some(Node::{ doc: self.doc, id: lc })
  } else {
    None
  }
}

///|
pub fn Node::prev_sibling(self : Node) -> Option[Node] {
  let ps = self.doc.nodes[self.id].prev_sibling
  if ps >= 0 {
    Some(Node::{ doc: self.doc, id: ps })
  } else {
    None
  }
}

///|
pub fn Node::next_sibling(self : Node) -> Option[Node] {
  let ns = self.doc.nodes[self.id].next_sibling
  if ns >= 0 {
    Some(Node::{ doc: self.doc, id: ns })
  } else {
    None
  }
}

///|
pub fn Node::first_element_child(self : Node) -> Option[Node] {
  let mut cur = self.doc.nodes[self.id].first_child
  while cur >= 0 {
    if unpack_kind(self.doc.nodes[cur].kind_ns) == node_kind_element {
      return Some(Node::{ doc: self.doc, id: cur })
    }
    cur = self.doc.nodes[cur].next_sibling
  }
  None
}

///|
pub fn Node::next_sibling_element(self : Node) -> Option[Node] {
  let mut cur = self.doc.nodes[self.id].next_sibling
  while cur >= 0 {
    if unpack_kind(self.doc.nodes[cur].kind_ns) == node_kind_element {
      return Some(Node::{ doc: self.doc, id: cur })
    }
    cur = self.doc.nodes[cur].next_sibling
  }
  None
}

///|
pub fn Node::children(self : Node) -> Array[Node] {
  let out : Array[Node] = []
  let mut cur = self.doc.nodes[self.id].first_child
  while cur >= 0 {
    out.push(Node::{ doc: self.doc, id: cur })
    cur = self.doc.nodes[cur].next_sibling
  }
  out
}

///| Iterative pre-order descendants (including `self`), zero recursion.
pub fn Node::descendants(self : Node) -> Array[Node] {
  let doc = self.doc
  let root_id = self.id
  if root_id == 0 {
    let n = doc.nodes.length()
    let out : Array[Node] = Array::with_capacity(n)
    let mut i = 0
    while i < n {
      out.push(Node::{ doc: doc, id: i })
      i = i + 1
    }
    return out
  }
  let nodes = doc.nodes
  let out : Array[Node] = Array::with_capacity(16)
  let mut cur = root_id
  while cur >= 0 {
    out.push(Node::{ doc: doc, id: cur })
    let nd = nodes[cur]
    if nd.first_child >= 0 {
      cur = nd.first_child
    } else if cur == root_id {
      break
    } else if nd.next_sibling >= 0 {
      cur = nd.next_sibling
    } else {
      let mut p = nd.parent
      let mut next = -1
      while p >= 0 && p != root_id {
        if nodes[p].next_sibling >= 0 {
          next = nodes[p].next_sibling
          break
        }
        p = nodes[p].parent
      }
      cur = next
    }
  }
  out
}

///|
pub fn Node::has_children(self : Node) -> Bool {
  self.doc.nodes[self.id].first_child >= 0
}
