///| XML 1.0 (Fifth Edition) character classification LUTs, UTF-8 helpers, and zero-copy span utilities.

let mask_ws : Int = 1

let mask_name_start : Int = 2

let mask_name_char : Int = 4

let mask_text_fast : Int = 8

let mask_attr_dq_fast : Int = 16

let mask_attr_sq_fast : Int = 32

let mask_valid_ascii : Int = 64

let mask_ncname_start : Int = 128

let mask_ncname_char : Int = 256

let mask_write_text_safe : Int = 512

let mask_write_attr_safe : Int = 1024

///| Build the 256-byte XML 1.0 ASCII classification lookup table.
fn build_xml_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut b = 0
  while b < 256 {
    let mut m = 0
    let is_ws = b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0D
    if is_ws {
      m = m | mask_ws
    }
    let is_valid = is_ws || (b >= 0x20 && b <= 0x7F)
    if is_valid {
      m = m | mask_valid_ascii
    }
    let is_nc_start = (b >= 0x41 && b <= 0x5A) ||
    (b >= 0x61 && b <= 0x7A) ||
    b == 0x5F
    if is_nc_start {
      m = m | mask_ncname_start | mask_name_start
    }
    if b == 0x3A {
      m = m | mask_name_start
    }
    let is_nc_char = is_nc_start ||
    (b >= 0x30 && b <= 0x39) ||
    b == 0x2D ||
    b == 0x2E
    if is_nc_char {
      m = m | mask_ncname_char | mask_name_char
    }
    if b == 0x3A {
      m = m | mask_name_char
    }
    // Text fast scan: valid ASCII except '<' (0x3C), '&' (0x26), '\r' (0x0D), ']' (0x5D)
    if is_valid && b != 0x3C && b != 0x26 && b != 0x0D && b != 0x5D {
      m = m | mask_text_fast
    }
    // Attr fast scan (double quote): valid ASCII except '"', '<', '&', '\r', '\n', '\t'
    if b >= 0x20 && b <= 0x7F && b != 0x22 && b != 0x3C && b != 0x26 {
      m = m | mask_attr_dq_fast
    }
    // Attr fast scan (single quote): valid ASCII except '\'', '<', '&', '\r', '\n', '\t'
    if b >= 0x20 && b <= 0x7F && b != 0x27 && b != 0x3C && b != 0x26 {
      m = m | mask_attr_sq_fast
    }
    // Writer text safe: valid ASCII except '<', '>', '&', ']', '\r'
    if is_valid && b != 0x3C && b != 0x3E && b != 0x26 && b != 0x5D && b != 0x0D {
      m = m | mask_write_text_safe
    }
    // Writer attr safe: printable ASCII except '<', '>', '&', '"', '\''
    if b >= 0x20 &&
    b <= 0x7F &&
    b != 0x3C &&
    b != 0x3E &&
    b != 0x26 &&
    b != 0x22 &&
    b != 0x27 {
      m = m | mask_write_attr_safe
    }
    lut[b] = m
    b = b + 1
  }
  lut
}

let xml_lut : FixedArray[Int] = build_xml_lut()

///| Decode a single UTF-8 codepoint at `pos`. Returns `(cp, byte_len)` or `(-1, 1)` on invalid UTF-8.
fn decode_utf8(s : String, pos : Int, len : Int) -> (Int, Int) {
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0, 1)
  }
  if (b0 & 0xE0) == 0xC0 {
    if pos + 1 >= len {
      return (-1, 1)
    }
    let b1 = s.code_unit_at(pos + 1)
    if (b1 & 0xC0) != 0x80 {
      return (-1, 1)
    }
    let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
    if cp < 0x80 {
      return (-1, 1)
    }
    return (cp, 2)
  }
  if (b0 & 0xF0) == 0xE0 {
    if pos + 2 >= len {
      return (-1, 1)
    }
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
      return (-1, 1)
    }
    let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
    if cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF) {
      return (-1, 1)
    }
    return (cp, 3)
  }
  if (b0 & 0xF8) == 0xF0 {
    if pos + 3 >= len {
      return (-1, 1)
    }
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
      return (-1, 1)
    }
    let cp = ((b0 & 0x07) << 18) |
    ((b1 & 0x3F) << 12) |
    ((b2 & 0x3F) << 6) |
    (b3 & 0x3F)
    if cp < 0x10000 || cp > 0x10FFFF {
      return (-1, 1)
    }
    return (cp, 4)
  }
  (-1, 1)
}

///| Encode a valid Unicode scalar value into `sb` as UTF-8 bytes.
fn encode_utf8(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| XML 1.0 (Fifth Edition) §2.2 Char production.
fn is_xml_char(cp : Int) -> Bool {
  if cp < 0x20 {
    cp == 0x09 || cp == 0x0A || cp == 0x0D
  } else if cp <= 0xD7FF {
    true
  } else if cp >= 0xE000 && cp <= 0xFFFD {
    true
  } else {
    cp >= 0x10000 && cp <= 0x10FFFF
  }
}

///| XML 1.0 (Fifth Edition) §2.3 NameStartChar (non-ASCII).
fn is_unicode_name_start(cp : Int) -> Bool {
  (cp >= 0xC0 && cp <= 0xD6) ||
  (cp >= 0xD8 && cp <= 0xF6) ||
  (cp >= 0xF8 && cp <= 0x2FF) ||
  (cp >= 0x370 && cp <= 0x37D) ||
  (cp >= 0x37F && cp <= 0x1FFF) ||
  (cp >= 0x200C && cp <= 0x200D) ||
  (cp >= 0x2070 && cp <= 0x218F) ||
  (cp >= 0x2C00 && cp <= 0x2FEF) ||
  (cp >= 0x3001 && cp <= 0xD7FF) ||
  (cp >= 0xF900 && cp <= 0xFDCF) ||
  (cp >= 0xFDF0 && cp <= 0xFFFD) ||
  (cp >= 0x10000 && cp <= 0xEFFFF)
}

///| XML 1.0 (Fifth Edition) §2.3 NameChar (non-ASCII).
fn is_unicode_name_char(cp : Int) -> Bool {
  is_unicode_name_start(cp) ||
  cp == 0xB7 ||
  (cp >= 0x0300 && cp <= 0x036F) ||
  (cp >= 0x203F && cp <= 0x2040)
}

///| Compute 1-based `(line, col)` for a byte offset (only called on error).
fn line_col_at(src : String, offset : Int) -> (Int, Int) {
  let limit = if offset < src.length() { offset } else { src.length() }
  let mut line = 1
  let mut col = 1
  let mut i = 0
  while i < limit {
    let b = src.code_unit_at(i)
    if b == 0x0A {
      line = line + 1
      col = 1
    } else if b == 0x0D {
      line = line + 1
      col = 1
      if i + 1 < limit && src.code_unit_at(i + 1) == 0x0A {
        i = i + 1
      }
    } else if (b & 0xC0) != 0x80 {
      col = col + 1
    }
    i = i + 1
  }
  (line, col)
}

///| Construct an XmlError with lazily computed line/col.
fn make_err(
  src : String,
  offset : Int,
  kind : XmlErrorKind,
  msg : String,
) -> XmlError {
  let (line, col) = line_col_at(src, offset)
  XmlError::new(kind, offset, line, col, msg)
}

///| Validate an XML 1.0 Name (and optionally NCName / QName).
fn is_valid_xml_name(s : String, allow_colon : Bool) -> Bool {
  let len = s.length()
  if len == 0 {
    return false
  }
  let b0 = s.code_unit_at(0)
  let mut pos = 0
  let mut seen_colon = false
  if b0 < 0x80 {
    if (xml_lut[b0] & mask_ncname_start) == 0 {
      return false
    }
    pos = 1
    // Fast ASCII inner loop
    while pos < len {
      let b = s.code_unit_at(pos)
      if b < 0x80 && (xml_lut[b] & mask_ncname_char) != 0 {
        pos = pos + 1
      } else {
        break
      }
    }
    if pos == len {
      return true
    }
  } else {
    let (cp, blen) = decode_utf8(s, 0, len)
    if cp < 0 || !is_unicode_name_start(cp) {
      return false
    }
    pos = blen
  }
  while pos < len {
    let b = s.code_unit_at(pos)
    if b < 0x80 {
      if b == 0x3A {
        if !allow_colon || seen_colon || pos + 1 >= len {
          return false
        }
        seen_colon = true
        let nb = s.code_unit_at(pos + 1)
        if nb < 0x80 {
          if (xml_lut[nb] & mask_ncname_start) == 0 {
            return false
          }
          pos = pos + 2
        } else {
          let (ncp, nblen) = decode_utf8(s, pos + 1, len)
          if ncp < 0 || !is_unicode_name_start(ncp) {
            return false
          }
          pos = pos + 1 + nblen
        }
      } else {
        if (xml_lut[b] & mask_ncname_char) == 0 {
          return false
        }
        pos = pos + 1
      }
    } else {
      let (cp, blen) = decode_utf8(s, pos, len)
      if cp < 0 || !is_unicode_name_char(cp) {
        return false
      }
      pos = pos + blen
    }
  }
  true
}

///| Compare `src[a_start..a_end]` with `src[b_start..b_end]` with zero allocation.
fn raw_slice_eq(
  src : String,
  a_start : Int,
  a_end : Int,
  b_start : Int,
  b_end : Int,
) -> Bool {
  let alen = a_end - a_start
  if alen != b_end - b_start {
    return false
  }
  let mut i = 0
  while i < alen {
    if src.code_unit_at(a_start + i) != src.code_unit_at(b_start + i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Compare `src[start..end]` with `target` with zero allocation.
fn raw_slice_eq_str(
  src : String,
  start : Int,
  end : Int,
  target : String,
) -> Bool {
  let slen = end - start
  if slen != target.length() {
    return false
  }
  let mut i = 0
  while i < slen {
    if src.code_unit_at(start + i) != target.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Return the byte length of a `TextSpan` with zero allocation.
fn span_len(strings : Array[String], sp : TextSpan) -> Int {
  if sp.start < 0 {
    strings[-(sp.start + 1)].length()
  } else {
    sp.end - sp.start
  }
}

///| Materialize a `TextSpan` to `String`.
fn span_to_string(
  src : String,
  strings : Array[String],
  sp : TextSpan,
) -> String {
  if sp.start < 0 {
    strings[-(sp.start + 1)]
  } else {
    src.slice(sp.start, sp.end)
  }
}

///| Compare a `TextSpan` against a `String` without allocating.
fn span_eq_str(
  src : String,
  strings : Array[String],
  sp : TextSpan,
  target : String,
) -> Bool {
  if sp.start < 0 {
    strings[-(sp.start + 1)] == target
  } else {
    raw_slice_eq_str(src, sp.start, sp.end, target)
  }
}

///| Compare two `TextSpan`s without allocating.
fn span_eq_span(
  src : String,
  strings : Array[String],
  a : TextSpan,
  b : TextSpan,
) -> Bool {
  if a.start >= 0 && b.start >= 0 {
    raw_slice_eq(src, a.start, a.end, b.start, b.end)
  } else if a.start < 0 && b.start < 0 {
    strings[-(a.start + 1)] == strings[-(b.start + 1)]
  } else if a.start < 0 {
    raw_slice_eq_str(src, b.start, b.end, strings[-(a.start + 1)])
  } else {
    raw_slice_eq_str(src, a.start, a.end, strings[-(b.start + 1)])
  }
}

///| Scan a QName at `pos`. Returns `(end_pos, colon_pos)` where `colon_pos == -1` if no colon.
///| Returns `(-1, -1)` on invalid QName.
fn scan_qname(src : String, pos : Int, len : Int) -> (Int, Int) {
  if pos >= len {
    return (-1, -1)
  }
  let mut i = pos
  let b0 = src.code_unit_at(i)
  if b0 < 0x80 {
    if (xml_lut[b0] & mask_ncname_start) == 0 {
      return (-1, -1)
    }
    i = i + 1
  } else {
    let (cp, blen) = decode_utf8(src, i, len)
    if cp < 0 || !is_unicode_name_start(cp) {
      return (-1, -1)
    }
    i = i + blen
  }
  // Fast ASCII NCName scan before any colon or non-ASCII
  while i < len {
    let b = src.code_unit_at(i)
    if b < 0x80 && (xml_lut[b] & mask_ncname_char) != 0 {
      i = i + 1
    } else {
      break
    }
  }
  if i >= len {
    return (i, -1)
  }
  let b_stop = src.code_unit_at(i)
  if b_stop < 0x80 && b_stop != 0x3A {
    return (i, -1)
  }
  let mut colon_pos = -1
  while i < len {
    let b = src.code_unit_at(i)
    if b < 0x80 {
      let m = xml_lut[b]
      if (m & mask_ncname_char) != 0 {
        i = i + 1
      } else if b == 0x3A {
        if colon_pos >= 0 {
          return (-1, -1)
        }
        colon_pos = i
        i = i + 1
        if i >= len {
          return (-1, -1)
        }
        let nb = src.code_unit_at(i)
        if nb < 0x80 {
          if (xml_lut[nb] & mask_ncname_start) == 0 {
            return (-1, -1)
          }
          i = i + 1
          while i < len {
            let b2 = src.code_unit_at(i)
            if b2 < 0x80 && (xml_lut[b2] & mask_ncname_char) != 0 {
              i = i + 1
            } else {
              break
            }
          }
        } else {
          let (ncp, nblen) = decode_utf8(src, i, len)
          if ncp < 0 || !is_unicode_name_start(ncp) {
            return (-1, -1)
          }
          i = i + nblen
        }
      } else {
        break
      }
    } else {
      let (cp, blen) = decode_utf8(src, i, len)
      if cp < 0 || !is_unicode_name_char(cp) {
        break
      }
      i = i + blen
    }
  }
  (i, colon_pos)
}

///| Scan an NCName (no colons allowed) at `pos`. Returns `end_pos` or `-1`.
fn scan_ncname(src : String, pos : Int, len : Int) -> Int {
  if pos >= len {
    return -1
  }
  let mut i = pos
  let b0 = src.code_unit_at(i)
  if b0 < 0x80 {
    if (xml_lut[b0] & mask_ncname_start) == 0 {
      return -1
    }
    i = i + 1
  } else {
    let (cp, blen) = decode_utf8(src, i, len)
    if cp < 0 || !is_unicode_name_start(cp) {
      return -1
    }
    i = i + blen
  }
  while i < len {
    let b = src.code_unit_at(i)
    if b < 0x80 {
      if (xml_lut[b] & mask_ncname_char) != 0 {
        i = i + 1
      } else {
        break
      }
    } else {
      let (cp, blen) = decode_utf8(src, i, len)
      if cp < 0 || !is_unicode_name_char(cp) {
        break
      }
      i = i + blen
    }
  }
  i
}

///| Skip XML 1.0 whitespace (`0x20`, `0x09`, `0x0A`, `0x0D`).
fn skip_ws(src : String, pos : Int, len : Int) -> Int {
  let mut i = pos
  while i < len {
    let b = src.code_unit_at(i)
    if b <= 0x20 && (xml_lut[b] & mask_ws) != 0 {
      i = i + 1
    } else {
      break
    }
  }
  i
}
