///| Shared XML 1.0 low-level scanners for XMLDecl, Comment, PI, CDATA, and DOCTYPE/Entities.

///| Check if `src[start..end]` equals `"xml"` case-insensitively.
fn is_xml_ci(src : String, start : Int, end : Int) -> Bool {
  if end - start != 3 {
    return false
  }
  let b0 = src.code_unit_at(start) | 0x20
  let b1 = src.code_unit_at(start + 1) | 0x20
  let b2 = src.code_unit_at(start + 2) | 0x20
  b0 == 0x78 && b1 == 0x6D && b2 == 0x6C
}

///| Validate XML 1.0 (Fifth Edition) §2.8 VersionNum: `'1.' [0-9]+`.
fn is_valid_xml_version(src : String, start : Int, end : Int) -> Bool {
  if end - start < 3 {
    return false
  }
  if src.code_unit_at(start) != 0x31 || src.code_unit_at(start + 1) != 0x2E {
    return false
  }
  let mut i = start + 2
  while i < end {
    let b = src.code_unit_at(i)
    if b < 0x30 || b > 0x39 {
      return false
    }
    i = i + 1
  }
  true
}

///| Validate an EncName (`[A-Za-z][A-Za-z0-9._-]*`).
fn is_valid_enc_name(src : String, start : Int, end : Int) -> Bool {
  if start >= end {
    return false
  }
  let b0 = src.code_unit_at(start)
  if !((b0 >= 0x41 && b0 <= 0x5A) || (b0 >= 0x61 && b0 <= 0x7A)) {
    return false
  }
  let mut i = start + 1
  while i < end {
    let b = src.code_unit_at(i)
    let ok = (b >= 0x41 && b <= 0x5A) ||
    (b >= 0x61 && b <= 0x7A) ||
    (b >= 0x30 && b <= 0x39) ||
    b == 0x2E ||
    b == 0x5F ||
    b == 0x2D
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

///| Validate a PubidChar per XML 1.0 §2.3: `#x20 | #xD | #xA | [a-zA-Z0-9] | [-'()+,./:=?;!*#@$_%]`.
fn is_pubid_char(b : Int) -> Bool {
  if (b >= 0x41 && b <= 0x5A) || (b >= 0x61 && b <= 0x7A) || (b >= 0x30 && b <= 0x39) {
    return true
  }
  b == 0x20 ||
  b == 0x0D ||
  b == 0x0A ||
  b == 0x2D ||
  b == 0x27 ||
  b == 0x28 ||
  b == 0x29 ||
  b == 0x2B ||
  b == 0x2C ||
  b == 0x2E ||
  b == 0x2F ||
  b == 0x3A ||
  b == 0x3D ||
  b == 0x3F ||
  b == 0x3B ||
  b == 0x21 ||
  b == 0x2A ||
  b == 0x23 ||
  b == 0x40 ||
  b == 0x24 ||
  b == 0x5F ||
  b == 0x25
}

///| Parse a quoted pseudo-attribute value in XMLDecl (`=` ws quote val quote).
///| Returns `(val_start, val_end, next_pos)`.
fn parse_decl_attr_val(
  src : String,
  pos : Int,
  len : Int,
) -> Result[(Int, Int, Int), XmlError] {
  let mut i = skip_ws(src, pos, len)
  if i >= len || src.code_unit_at(i) != 0x3D {
    return Err(
      make_err(src, i, XmlErrorKind::InvalidXmlDecl, "expected '=' in XML declaration"),
    )
  }
  i = skip_ws(src, i + 1, len)
  if i >= len {
    return Err(
      make_err(src, i, XmlErrorKind::InvalidXmlDecl, "expected quote in XML declaration"),
    )
  }
  let q = src.code_unit_at(i)
  if q != 0x22 && q != 0x27 {
    return Err(
      make_err(src, i, XmlErrorKind::InvalidXmlDecl, "expected quote in XML declaration"),
    )
  }
  i = i + 1
  let vstart = i
  while i < len && src.code_unit_at(i) != q {
    i = i + 1
  }
  if i >= len {
    return Err(
      make_err(src, vstart, XmlErrorKind::InvalidXmlDecl, "unterminated quote in XML declaration"),
    )
  }
  Ok((vstart, i, i + 1))
}

///| Parse `<?xml ...?>` starting at `pos` (pointing to `<`).
///| Returns `(XmlDecl, next_pos)`.
fn parse_xml_decl(
  src : String,
  pos : Int,
  len : Int,
) -> Result[(XmlDecl, Int), XmlError] {
  // Caller verified `<?xml` followed by whitespace or `?`
  let mut i = pos + 5
  let ws_start = i
  i = skip_ws(src, i, len)
  if i == ws_start {
    return Err(
      make_err(src, i, XmlErrorKind::InvalidXmlDecl, "expected whitespace after '<?xml'"),
    )
  }
  // Must have `version`
  if i + 7 > len || !raw_slice_eq_str(src, i, i + 7, "version") {
    return Err(
      make_err(src, i, XmlErrorKind::InvalidXmlDecl, "expected 'version' in XML declaration"),
    )
  }
  let (ver_s, ver_e, next_i) = match parse_decl_attr_val(src, i + 7, len) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if !is_valid_xml_version(src, ver_s, ver_e) {
    return Err(
      make_err(src, ver_s, XmlErrorKind::InvalidXmlDecl, "XML version must match '1.[0-9]+'"),
    )
  }
  let version = src.slice(ver_s, ver_e)
  i = next_i
  let mut encoding : Option[String] = None
  let mut standalone : Option[Bool] = None
  let mut saw_ws = false
  let w1 = i
  i = skip_ws(src, i, len)
  if i > w1 {
    saw_ws = true
  }
  // Optional `encoding`
  if i + 8 <= len && raw_slice_eq_str(src, i, i + 8, "encoding") {
    if !saw_ws {
      return Err(
        make_err(src, i, XmlErrorKind::InvalidXmlDecl, "expected whitespace before 'encoding'"),
      )
    }
    let (enc_s, enc_e, ni) = match parse_decl_attr_val(src, i + 8, len) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if !is_valid_enc_name(src, enc_s, enc_e) {
      return Err(
        make_err(src, enc_s, XmlErrorKind::InvalidXmlDecl, "invalid encoding name"),
      )
    }
    encoding = Some(src.slice(enc_s, enc_e))
    i = ni
    let w2 = i
    i = skip_ws(src, i, len)
    saw_ws = i > w2
  }
  // Optional `standalone`
  if i + 10 <= len && raw_slice_eq_str(src, i, i + 10, "standalone") {
    if !saw_ws {
      return Err(
        make_err(src, i, XmlErrorKind::InvalidXmlDecl, "expected whitespace before 'standalone'"),
      )
    }
    let (st_s, st_e, ni) = match parse_decl_attr_val(src, i + 10, len) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if raw_slice_eq_str(src, st_s, st_e, "yes") {
      standalone = Some(true)
    } else if raw_slice_eq_str(src, st_s, st_e, "no") {
      standalone = Some(false)
    } else {
      return Err(
        make_err(src, st_s, XmlErrorKind::InvalidXmlDecl, "standalone must be 'yes' or 'no'"),
      )
    }
    i = ni
    i = skip_ws(src, i, len)
  }
  if i + 2 > len || src.code_unit_at(i) != 0x3F || src.code_unit_at(i + 1) != 0x3E {
    return Err(
      make_err(src, i, XmlErrorKind::InvalidXmlDecl, "expected '?>' closing XML declaration"),
    )
  }
  Ok((XmlDecl::{ version: version, encoding: encoding, standalone: standalone }, i + 2))
}

///| Scan a Comment starting after `<!--` (at `pos`).
///| Returns `(content_start, content_end, needs_eol_norm, next_pos)`.
fn scan_comment(
  src : String,
  pos : Int,
  len : Int,
) -> Result[(Int, Int, Bool, Int), XmlError] {
  let lut = xml_lut
  let start = pos
  let mut i = pos
  let mut has_cr = false
  while i < len {
    while i <= len - 4 {
      let b0 = src.code_unit_at(i)
      let b1 = src.code_unit_at(i + 1)
      let b2 = src.code_unit_at(i + 2)
      let b3 = src.code_unit_at(i + 3)
      if ((lut[b0] & lut[b1] & lut[b2] & lut[b3]) & mask_valid_ascii) != 0 &&
      b0 != 0x2D &&
      b1 != 0x2D &&
      b2 != 0x2D &&
      b3 != 0x2D &&
      b0 != 0x0D &&
      b1 != 0x0D &&
      b2 != 0x0D &&
      b3 != 0x0D {
        i = i + 4
      } else {
        break
      }
    }
    if i >= len {
      break
    }
    let b = src.code_unit_at(i)
    if b == 0x2D {
      // '-'
      if i + 1 < len && src.code_unit_at(i + 1) == 0x2D {
        if i + 2 < len && src.code_unit_at(i + 2) == 0x3E {
          return Ok((start, i, has_cr, i + 3))
        }
        return Err(
          make_err(src, i, XmlErrorKind::InvalidComment, "'--' is not allowed inside XML comments"),
        )
      }
      i = i + 1
    } else if b == 0x0D {
      has_cr = true
      i = i + 1
    } else if b < 0x80 {
      if (xml_lut[b] & mask_valid_ascii) == 0 {
        return Err(
          make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in comment"),
        )
      }
      i = i + 1
    } else {
      let (cp, blen) = decode_utf8(src, i, len)
      if cp < 0 || !is_xml_char(cp) {
        return Err(
          make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in comment"),
        )
      }
      i = i + blen
    }
  }
  Err(make_err(src, pos, XmlErrorKind::InvalidComment, "unterminated XML comment"))
}

///| Scan a Processing Instruction starting after `<?` (at `pos`).
///| Consumes a single whitespace separator after PITarget so PI values with leading whitespace
///| or empty string round-trip losslessly.
///| Returns `(target_start, target_end, val_start, val_end, has_val, needs_eol_norm, next_pos)`.
fn scan_pi(
  src : String,
  pos : Int,
  len : Int,
) -> Result[(Int, Int, Int, Int, Bool, Bool, Int), XmlError] {
  let t_start = pos
  let t_end = scan_ncname(src, pos, len)
  if t_end < 0 {
    return Err(
      make_err(src, pos, XmlErrorKind::InvalidPI, "invalid processing instruction target"),
    )
  }
  if t_end < len && src.code_unit_at(t_end) == 0x3A {
    return Err(
      make_err(src, t_end, XmlErrorKind::InvalidNamespace, "colon not allowed in PI target"),
    )
  }
  if is_xml_ci(src, t_start, t_end) {
    return Err(
      make_err(src, t_start, XmlErrorKind::InvalidPI, "reserved PI target 'xml'"),
    )
  }
  let mut i = t_end
  if i + 1 < len && src.code_unit_at(i) == 0x3F && src.code_unit_at(i + 1) == 0x3E {
    return Ok((t_start, t_end, i, i, false, false, i + 2))
  }
  if i >= len {
    return Err(make_err(src, pos, XmlErrorKind::InvalidPI, "unterminated processing instruction"))
  }
  let sb0 = src.code_unit_at(i)
  if sb0 > 0x20 || (xml_lut[sb0] & mask_ws) == 0 {
    return Err(
      make_err(src, i, XmlErrorKind::InvalidPI, "expected whitespace or '?>' after PI target"),
    )
  }
  // Consume one whitespace separator (treating CRLF as one line break)
  if sb0 == 0x0D && i + 1 < len && src.code_unit_at(i + 1) == 0x0A {
    i = i + 2
  } else {
    i = i + 1
  }
  let lut = xml_lut
  let v_start = i
  let mut has_cr = false
  while i < len {
    while i <= len - 4 {
      let b0 = src.code_unit_at(i)
      let b1 = src.code_unit_at(i + 1)
      let b2 = src.code_unit_at(i + 2)
      let b3 = src.code_unit_at(i + 3)
      if ((lut[b0] & lut[b1] & lut[b2] & lut[b3]) & mask_valid_ascii) != 0 &&
      b0 != 0x3F &&
      b1 != 0x3F &&
      b2 != 0x3F &&
      b3 != 0x3F &&
      b0 != 0x0D &&
      b1 != 0x0D &&
      b2 != 0x0D &&
      b3 != 0x0D {
        i = i + 4
      } else {
        break
      }
    }
    if i >= len {
      break
    }
    let b = src.code_unit_at(i)
    if b == 0x3F && i + 1 < len && src.code_unit_at(i + 1) == 0x3E {
      return Ok((t_start, t_end, v_start, i, true, has_cr, i + 2))
    } else if b == 0x0D {
      has_cr = true
      i = i + 1
    } else if b < 0x80 {
      if (xml_lut[b] & mask_valid_ascii) == 0 {
        return Err(
          make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in PI"),
        )
      }
      i = i + 1
    } else {
      let (cp, blen) = decode_utf8(src, i, len)
      if cp < 0 || !is_xml_char(cp) {
        return Err(
          make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in PI"),
        )
      }
      i = i + blen
    }
  }
  Err(make_err(src, pos, XmlErrorKind::InvalidPI, "unterminated processing instruction"))
}

///| Scan a CDATA section starting after `<![CDATA[` (at `pos`).
///| Returns `(content_start, content_end, needs_eol_norm, next_pos)`.
fn scan_cdata(
  src : String,
  pos : Int,
  len : Int,
) -> Result[(Int, Int, Bool, Int), XmlError] {
  let lut = xml_lut
  let start = pos
  let mut i = pos
  let mut has_cr = false
  while i < len {
    while i <= len - 4 {
      let m0 = lut[src.code_unit_at(i)]
      let m1 = lut[src.code_unit_at(i + 1)]
      let m2 = lut[src.code_unit_at(i + 2)]
      let m3 = lut[src.code_unit_at(i + 3)]
      if ((m0 & m1 & m2 & m3) & mask_text_fast) != 0 {
        i = i + 4
      } else {
        break
      }
    }
    if i >= len {
      break
    }
    let b = src.code_unit_at(i)
    if b == 0x5D {
      if i + 2 < len &&
      src.code_unit_at(i + 1) == 0x5D &&
      src.code_unit_at(i + 2) == 0x3E {
        return Ok((start, i, has_cr, i + 3))
      }
      i = i + 1
    } else if b == 0x0D {
      has_cr = true
      i = i + 1
    } else if b < 0x80 {
      if (xml_lut[b] & mask_valid_ascii) == 0 {
        return Err(
          make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in CDATA"),
        )
      }
      i = i + 1
    } else {
      let (cp, blen) = decode_utf8(src, i, len)
      if cp < 0 || !is_xml_char(cp) {
        return Err(
          make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in CDATA"),
        )
      }
      i = i + blen
    }
  }
  Err(make_err(src, pos, XmlErrorKind::InvalidCData, "unterminated CDATA section"))
}

///| Scan a quoted literal in DTD (`"..."` or `'...'`), validating all characters are legal XML 1.0 Chars.
///| Returns `(start, end, next_pos)`.
fn scan_dtd_quoted(
  src : String,
  pos : Int,
  len : Int,
) -> Result[(Int, Int, Int), XmlError] {
  if pos >= len {
    return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "expected quoted string in DTD"))
  }
  let q = src.code_unit_at(pos)
  if q != 0x22 && q != 0x27 {
    return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "expected quote in DTD"))
  }
  let mut i = pos + 1
  let start = i
  while i < len {
    let b = src.code_unit_at(i)
    if b == q {
      return Ok((start, i, i + 1))
    }
    if b < 0x80 {
      if (xml_lut[b] & mask_valid_ascii) == 0 {
        return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in DTD literal"))
      }
      i = i + 1
    } else {
      let (cp, blen) = decode_utf8(src, i, len)
      if cp < 0 || !is_xml_char(cp) {
        return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in DTD literal"))
      }
      i = i + blen
    }
  }
  Err(make_err(src, start, XmlErrorKind::InvalidSyntax, "unterminated quoted string in DTD"))
}

///| Scan a PubidLiteral in DTD (`"..."` or `'...'`), validating PubidChar.
fn scan_dtd_pubid(
  src : String,
  pos : Int,
  len : Int,
) -> Result[(Int, Int, Int), XmlError] {
  match scan_dtd_quoted(src, pos, len) {
    Ok((s, e, ni)) => {
      let mut i = s
      while i < e {
        if !is_pubid_char(src.code_unit_at(i)) {
          return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal character in PUBLIC literal"))
        }
        i = i + 1
      }
      Ok((s, e, ni))
    }
    Err(e) => Err(e)
  }
}

///| Scan an ExternalID (`SYSTEM S SystemLiteral` or `PUBLIC S PubidLiteral S SystemLiteral`).
///| Returns `Ok((matched, next_pos))`.
fn scan_dtd_external_id(
  src : String,
  pos : Int,
  len : Int,
) -> Result[(Bool, Int), XmlError] {
  if pos + 6 <= len && raw_slice_eq_str(src, pos, pos + 6, "SYSTEM") {
    let after_kw = pos + 6
    let ws_end = skip_ws(src, after_kw, len)
    if ws_end == after_kw {
      return Err(make_err(src, after_kw, XmlErrorKind::InvalidSyntax, "expected whitespace after SYSTEM"))
    }
    match scan_dtd_quoted(src, ws_end, len) {
      Ok((_, _, ni)) => Ok((true, ni))
      Err(e) => Err(e)
    }
  } else if pos + 6 <= len && raw_slice_eq_str(src, pos, pos + 6, "PUBLIC") {
    let after_kw = pos + 6
    let ws1 = skip_ws(src, after_kw, len)
    if ws1 == after_kw {
      return Err(make_err(src, after_kw, XmlErrorKind::InvalidSyntax, "expected whitespace after PUBLIC"))
    }
    match scan_dtd_pubid(src, ws1, len) {
      Ok((_, _, ni1)) => {
        let ws2 = skip_ws(src, ni1, len)
        if ws2 == ni1 {
          return Err(make_err(src, ni1, XmlErrorKind::InvalidSyntax, "expected whitespace between PUBLIC and SYSTEM literals"))
        }
        match scan_dtd_quoted(src, ws2, len) {
          Ok((_, _, ni2)) => Ok((true, ni2))
          Err(e) => Err(e)
        }
      }
      Err(e) => Err(e)
    }
  } else {
    Ok((false, pos))
  }
}

///| Scan the body of `<!ELEMENT`, `<!ATTLIST`, or `<!NOTATION` after its keyword.
///| Requires leading whitespace, validates characters & quotes, and stops after `>`.
fn scan_dtd_other_decl(
  src : String,
  after_kw : Int,
  len : Int,
) -> Result[Int, XmlError] {
  let ws_end = skip_ws(src, after_kw, len)
  if ws_end == after_kw {
    return Err(make_err(src, after_kw, XmlErrorKind::InvalidSyntax, "expected whitespace after DTD declaration keyword"))
  }
  let mut i = ws_end
  while i < len {
    let cb = src.code_unit_at(i)
    if cb == 0x3E {
      return Ok(i + 1)
    } else if cb == 0x3C {
      return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "unexpected '<' inside DTD declaration"))
    } else if cb == 0x22 || cb == 0x27 {
      match scan_dtd_quoted(src, i, len) {
        Ok((_, _, ni)) => i = ni
        Err(e) => return Err(e)
      }
    } else if cb < 0x80 {
      if (xml_lut[cb] & mask_valid_ascii) == 0 {
        return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in DTD declaration"))
      }
      i = i + 1
    } else {
      let (cp, blen) = decode_utf8(src, i, len)
      if cp < 0 || !is_xml_char(cp) {
        return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in DTD declaration"))
      }
      i = i + blen
    }
  }
  Err(make_err(src, after_kw, XmlErrorKind::UnexpectedEof, "unterminated DTD declaration"))
}

///| Parse `<!DOCTYPE ...>` starting after `<!DOCTYPE` (at `pos`).
///| Extracts internal `<!ENTITY name "val">` definitions (expanding char refs at declaration time per §4.5)
///| and records external/unparsed entities as `is_external = true` so referencing them is rejected (XXE-safe).
///| Returns `(doctype_content_start, doctype_content_end, next_pos)`.
fn parse_doctype(
  src : String,
  pos : Int,
  len : Int,
  entities : EntityTable,
) -> Result[(Int, Int, Int), XmlError] {
  let content_start = pos
  let mut i = skip_ws(src, pos, len)
  if i == pos {
    return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "expected whitespace after DOCTYPE"))
  }
  // Root name
  let (name_end, _) = scan_qname(src, i, len)
  if name_end < 0 {
    return Err(make_err(src, i, XmlErrorKind::InvalidName, "invalid DOCTYPE name"))
  }
  let after_name = skip_ws(src, name_end, len)
  let had_ws_after_name = after_name > name_end
  i = after_name
  // Optional external ID (SYSTEM "..." or PUBLIC "..." "...") on DOCTYPE itself (never fetched)
  if i + 6 <= len &&
  (raw_slice_eq_str(src, i, i + 6, "SYSTEM") || raw_slice_eq_str(src, i, i + 6, "PUBLIC")) {
    if !had_ws_after_name {
      return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected whitespace before ExternalID"))
    }
    match scan_dtd_external_id(src, i, len) {
      Ok((_, ni)) => i = skip_ws(src, ni, len)
      Err(e) => return Err(e)
    }
  }
  // Optional internal subset `[ ... ]`
  if i < len && src.code_unit_at(i) == 0x5B {
    i = i + 1
    while i < len {
      i = skip_ws(src, i, len)
      if i >= len {
        return Err(make_err(src, i, XmlErrorKind::UnexpectedEof, "unterminated DOCTYPE internal subset"))
      }
      let b = src.code_unit_at(i)
      if b == 0x5D {
        // ']'
        i = skip_ws(src, i + 1, len)
        break
      }
      if b == 0x25 {
        // Parameter entity reference `%name;` in internal subset -> reject external/PE expansion
        let pe_end = scan_ncname(src, i + 1, len)
        if pe_end < 0 || pe_end >= len || src.code_unit_at(pe_end) != 0x3B {
          return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "invalid parameter entity reference in DTD"))
        }
        return Err(make_err(src, i, XmlErrorKind::ExternalEntityNotAllowed, "parameter entity reference is not allowed"))
      }
      if b == 0x3C {
        // '<'
        if i + 4 <= len && raw_slice_eq_str(src, i, i + 4, "<!--") {
          match scan_comment(src, i + 4, len) {
            Ok((_, _, _, ni)) => i = ni
            Err(e) => return Err(e)
          }
        } else if i + 2 <= len && src.code_unit_at(i + 1) == 0x3F {
          match scan_pi(src, i + 2, len) {
            Ok((_, _, _, _, _, _, ni)) => i = ni
            Err(e) => return Err(e)
          }
        } else if i + 8 <= len && raw_slice_eq_str(src, i, i + 8, "<!ENTITY") {
          let after_kw = i + 8
          let mut j = skip_ws(src, after_kw, len)
          if j == after_kw {
            return Err(make_err(src, after_kw, XmlErrorKind::InvalidSyntax, "expected whitespace after <!ENTITY"))
          }
          // Optional parameter entity `%`
          let mut is_pe = false
          if j < len && src.code_unit_at(j) == 0x25 {
            is_pe = true
            let after_pct = j + 1
            j = skip_ws(src, after_pct, len)
            if j == after_pct {
              return Err(make_err(src, after_pct, XmlErrorKind::InvalidSyntax, "expected whitespace after '%' in ENTITY"))
            }
          }
          let ename_end = scan_ncname(src, j, len)
          if ename_end < 0 {
            return Err(make_err(src, j, XmlErrorKind::InvalidName, "invalid entity name"))
          }
          let ename = src.slice(j, ename_end)
          j = skip_ws(src, ename_end, len)
          if j == ename_end {
            return Err(make_err(src, ename_end, XmlErrorKind::InvalidSyntax, "expected whitespace after entity name"))
          }
          if j >= len {
            return Err(make_err(src, j, XmlErrorKind::UnexpectedEof, "unterminated ENTITY declaration"))
          }
          // Either ExternalID (SYSTEM / PUBLIC [+ optional NDATA Name]) or quoted EntityValue
          match scan_dtd_external_id(src, j, len) {
            Ok((true, ni)) => {
              j = skip_ws(src, ni, len)
              // Optional NDATA Name for general entities
              if !is_pe && j + 5 <= len && raw_slice_eq_str(src, j, j + 5, "NDATA") {
                if j == ni {
                  return Err(make_err(src, j, XmlErrorKind::InvalidSyntax, "expected whitespace before NDATA"))
                }
                let after_ndata = j + 5
                let ws_ndata = skip_ws(src, after_ndata, len)
                if ws_ndata == after_ndata {
                  return Err(make_err(src, after_ndata, XmlErrorKind::InvalidSyntax, "expected whitespace after NDATA"))
                }
                let nd_end = scan_ncname(src, ws_ndata, len)
                if nd_end < 0 {
                  return Err(make_err(src, ws_ndata, XmlErrorKind::InvalidName, "invalid NDATA notation name"))
                }
                j = skip_ws(src, nd_end, len)
              }
              if j >= len || src.code_unit_at(j) != 0x3E {
                return Err(make_err(src, j, XmlErrorKind::InvalidSyntax, "expected '>' closing ENTITY"))
              }
              if !is_pe {
                // Record as external/unparsed: referencing it later will fail with ExternalEntityNotAllowed
                entities.insert_if_absent(ename, "", true)
              }
              i = j + 1
            }
            Ok((false, _)) => {
              let (vs, ve, after_val) = match scan_dtd_quoted(src, j, len) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              let expanded = match process_entity_value(src, vs, ve) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              j = skip_ws(src, after_val, len)
              if j >= len || src.code_unit_at(j) != 0x3E {
                return Err(make_err(src, j, XmlErrorKind::InvalidSyntax, "expected '>' closing ENTITY"))
              }
              if !is_pe {
                entities.insert_if_absent(ename, expanded, false)
              }
              i = j + 1
            }
            Err(e) => return Err(e)
          }
        } else if i + 9 <= len && raw_slice_eq_str(src, i, i + 9, "<!ELEMENT") {
          match scan_dtd_other_decl(src, i + 9, len) {
            Ok(ni) => i = ni
            Err(e) => return Err(e)
          }
        } else if i + 9 <= len && raw_slice_eq_str(src, i, i + 9, "<!ATTLIST") {
          match scan_dtd_other_decl(src, i + 9, len) {
            Ok(ni) => i = ni
            Err(e) => return Err(e)
          }
        } else if i + 10 <= len && raw_slice_eq_str(src, i, i + 10, "<!NOTATION") {
          let after_kw = i + 10
          let mut j = skip_ws(src, after_kw, len)
          if j == after_kw {
            return Err(make_err(src, after_kw, XmlErrorKind::InvalidSyntax, "expected whitespace after <!NOTATION"))
          }
          let nname_end = scan_ncname(src, j, len)
          if nname_end < 0 {
            return Err(make_err(src, j, XmlErrorKind::InvalidName, "invalid NOTATION name"))
          }
          j = skip_ws(src, nname_end, len)
          if j == nname_end {
            return Err(make_err(src, nname_end, XmlErrorKind::InvalidSyntax, "expected whitespace after NOTATION name"))
          }
          if j + 6 <= len && raw_slice_eq_str(src, j, j + 6, "SYSTEM") {
            let ws1 = skip_ws(src, j + 6, len)
            if ws1 == j + 6 {
              return Err(make_err(src, j + 6, XmlErrorKind::InvalidSyntax, "expected whitespace after SYSTEM in NOTATION"))
            }
            match scan_dtd_quoted(src, ws1, len) {
              Ok((_, _, ni)) => j = skip_ws(src, ni, len)
              Err(e) => return Err(e)
            }
          } else if j + 6 <= len && raw_slice_eq_str(src, j, j + 6, "PUBLIC") {
            let ws1 = skip_ws(src, j + 6, len)
            if ws1 == j + 6 {
              return Err(make_err(src, j + 6, XmlErrorKind::InvalidSyntax, "expected whitespace after PUBLIC in NOTATION"))
            }
            match scan_dtd_pubid(src, ws1, len) {
              Ok((_, _, ni1)) => {
                let ws2 = skip_ws(src, ni1, len)
                if ws2 > ni1 && ws2 < len && (src.code_unit_at(ws2) == 0x22 || src.code_unit_at(ws2) == 0x27) {
                  match scan_dtd_quoted(src, ws2, len) {
                    Ok((_, _, ni2)) => j = skip_ws(src, ni2, len)
                    Err(e) => return Err(e)
                  }
                } else {
                  j = ws2
                }
              }
              Err(e) => return Err(e)
            }
          } else {
            return Err(make_err(src, j, XmlErrorKind::InvalidSyntax, "expected SYSTEM or PUBLIC in NOTATION"))
          }
          if j >= len || src.code_unit_at(j) != 0x3E {
            return Err(make_err(src, j, XmlErrorKind::InvalidSyntax, "expected '>' closing NOTATION"))
          }
          i = j + 1
        } else {
          return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "unexpected or malformed markup declaration in DOCTYPE"))
        }
      } else {
        return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "unexpected character in DOCTYPE"))
      }
    }
  }
  if i >= len || src.code_unit_at(i) != 0x3E {
    return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected '>' closing DOCTYPE"))
  }
  Ok((content_start, i, i + 1))
}
