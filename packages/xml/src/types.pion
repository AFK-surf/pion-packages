///| Core types, options, limits, errors, DOM handles, streaming events, and writer for `xml`.

///| Categories of XML 1.0 / Namespaces 1.0 parsing and serialization errors.
pub enum XmlErrorKind {
  UnexpectedEof
  InvalidSyntax
  InvalidName
  InvalidChar
  InvalidCharRef
  UnknownEntity
  EntityLoop
  DuplicateAttribute
  MismatchedTag
  UnclosedTag
  NoRootNode
  MultipleRootNodes
  InvalidXmlDecl
  InvalidComment
  InvalidCData
  InvalidPI
  DtdDetected
  ExternalEntityNotAllowed
  InvalidNamespace
  UnboundNamespacePrefix
  LimitExceeded
  Unimplemented
}

///| Structured XML error with byte offset, 1-based line/column, and message.
pub struct XmlError {
  pub kind : XmlErrorKind
  pub offset : Int
  pub line : Int
  pub col : Int
  pub message : String
}

///|
pub fn XmlError::new(
  kind : XmlErrorKind,
  offset : Int,
  line : Int,
  col : Int,
  message : String,
) -> XmlError {
  XmlError::{ kind: kind, offset: offset, line: line, col: col, message: message }
}

///|
pub fn XmlError::to_string(self : XmlError) -> String {
  self.message +
  " (line " +
  self.line.to_string() +
  ", col " +
  self.col.to_string() +
  ")"
}

///| Resource and security limits enforced during parsing.
pub struct Limits {
  pub max_depth : Int
  pub max_nodes : Int
  pub max_attributes : Int
  pub max_entity_expansions : Int
  pub max_entity_bytes : Int
}

///|
pub fn Limits::default() -> Limits {
  Limits::{
    max_depth: 256,
    max_nodes: 1000000,
    max_attributes: 1024,
    max_entity_expansions: 256,
    max_entity_bytes: 65536,
  }
}

///| Parsing options for `Document::parse_with_options` and `Reader::with_options`.
pub struct ParseOptions {
  pub allow_dtd : Bool
  pub limits : Limits
}

///|
pub fn ParseOptions::default() -> ParseOptions {
  ParseOptions::{ allow_dtd: false, limits: Limits::default() }
}

///| A byte span inside the source string, or a negative pool index `-(idx + 1)`.
pub val struct TextSpan {
  pub start : Int
  pub end : Int
}

///|
pub fn TextSpan::empty() -> TextSpan {
  TextSpan::{ start: 0, end: 0 }
}

///|
pub fn TextSpan::from_range(start : Int, end : Int) -> TextSpan {
  TextSpan::{ start: start, end: end }
}

///|
pub fn TextSpan::from_pool(idx : Int) -> TextSpan {
  TextSpan::{ start: -(idx + 1), end: 0 }
}

///|
pub fn TextSpan::is_empty(self : TextSpan) -> Bool {
  self.start >= 0 && self.start == self.end
}

///| Node kinds in the flat read-only DOM tree.
pub enum NodeType {
  Root
  Element
  Text
  Comment
  PI
}

///|
pub fn NodeType::eq(self : NodeType, other : NodeType) -> Bool {
  match (self, other) {
    (NodeType::Root, NodeType::Root) => true
    (NodeType::Element, NodeType::Element) => true
    (NodeType::Text, NodeType::Text) => true
    (NodeType::Comment, NodeType::Comment) => true
    (NodeType::PI, NodeType::PI) => true
    _ => false
  }
}

///| Expanded XML name (local name + optional namespace URI + optional prefix).
pub struct ExpandedName {
  pub local : String
  pub ns_uri : Option[String]
  pub prefix : Option[String]
}

///|
pub fn ExpandedName::name(self : ExpandedName) -> String {
  self.local
}

///|
pub fn ExpandedName::namespace(self : ExpandedName) -> Option[String] {
  self.ns_uri
}

///|
pub fn ExpandedName::prefix(self : ExpandedName) -> Option[String] {
  self.prefix
}

///|
pub fn ExpandedName::qualified_name(self : ExpandedName) -> String {
  match self.prefix {
    Some(p) => p + ":" + self.local
    None => self.local
  }
}

///| A namespace declaration (`xmlns` or `xmlns:prefix`).
pub struct Namespace {
  pub prefix : Option[String]
  pub uri : String
}

///|
pub fn Namespace::name(self : Namespace) -> Option[String] {
  self.prefix
}

///|
pub fn Namespace::uri(self : Namespace) -> String {
  self.uri
}

///| A processing instruction (`<?target value?>`).
pub struct PI {
  pub target : String
  pub value : Option[String]
}

///| An element attribute with resolved namespace.
pub struct Attribute {
  pub local : String
  pub ns_uri : Option[String]
  pub prefix : Option[String]
  pub value : String
}

///|
pub fn Attribute::name(self : Attribute) -> String {
  self.local
}

///|
pub fn Attribute::namespace(self : Attribute) -> Option[String] {
  self.ns_uri
}

///|
pub fn Attribute::prefix(self : Attribute) -> Option[String] {
  self.prefix
}

///|
pub fn Attribute::value(self : Attribute) -> String {
  self.value
}

///| Internal flat-array node storage entry (compact 14-int layout).
///| - `kind_ns`: `(kind & 7) | ((ns_idx + 2) << 3)`
///| - `s1_start/s1_end`: local name (Element/PI) or text/comment value (Text/Comment)
///| - `s2_start/s2_end`: prefix (Element) or PI value (PI)
pub val struct NodeData {
  pub kind_ns : Int
  pub parent : Int
  pub prev_sibling : Int
  pub next_sibling : Int
  pub first_child : Int
  pub last_child : Int
  pub s1_start : Int
  pub s1_end : Int
  pub s2_start : Int
  pub s2_end : Int
  pub attrs_start : Int
  pub attrs_end : Int
  pub ns_start : Int
  pub ns_end : Int
}

///| Internal flat-array attribute storage entry.
pub val struct AttrData {
  pub local_start : Int
  pub local_end : Int
  pub prefix_start : Int
  pub prefix_end : Int
  pub val_start : Int
  pub val_end : Int
  pub ns_idx : Int
}

///| Internal flat-array namespace storage entry.
pub val struct NsData {
  pub prefix_span : TextSpan
  pub uri_span : TextSpan
  pub has_prefix : Bool
}

///| Immutable read-only XML DOM document backed by flat arrays.
pub struct Document {
  pub src : String
  pub strings : Array[String]
  pub nodes : Array[NodeData]
  pub attrs : Array[AttrData]
  pub namespaces : Array[NsData]
  pub root_elem_id : Int
}

///| Lightweight handle to a node inside a `Document`.
pub struct Node {
  pub doc : Document
  pub id : Int
}

///| XML declaration fields (`<?xml version="1.0" encoding="..." standalone="yes|no"?>`).
pub struct XmlDecl {
  pub version : String
  pub encoding : Option[String]
  pub standalone : Option[Bool]
}

///| A raw attribute pair from a streaming `StartElement` / `EmptyElement`.
pub struct RawAttribute {
  pub name : String
  pub value : String
}

///| Streaming start or empty element event payload.
pub struct StartElement {
  pub src : String
  pub name_start : Int
  pub name_end : Int
  pub raw_attrs : Array[RawAttribute]
}

///|
pub fn StartElement::name(self : StartElement) -> String {
  self.src.slice(self.name_start, self.name_end)
}

///|
pub fn StartElement::local_name(self : StartElement) -> String {
  let mut i = self.name_start
  while i < self.name_end {
    if self.src.code_unit_at(i) == 58 {
      return self.src.slice(i + 1, self.name_end)
    }
    i = i + 1
  }
  self.src.slice(self.name_start, self.name_end)
}

///|
pub fn StartElement::prefix(self : StartElement) -> Option[String] {
  let mut i = self.name_start
  while i < self.name_end {
    if self.src.code_unit_at(i) == 58 {
      return Some(self.src.slice(self.name_start, i))
    }
    i = i + 1
  }
  None
}

///|
pub fn StartElement::attributes(self : StartElement) -> Array[RawAttribute] {
  self.raw_attrs
}

///| Streaming end element event payload.
pub struct EndElement {
  pub src : String
  pub name_start : Int
  pub name_end : Int
}

///|
pub fn EndElement::name(self : EndElement) -> String {
  self.src.slice(self.name_start, self.name_end)
}

///|
pub fn EndElement::local_name(self : EndElement) -> String {
  let mut i = self.name_start
  while i < self.name_end {
    if self.src.code_unit_at(i) == 58 {
      return self.src.slice(i + 1, self.name_end)
    }
    i = i + 1
  }
  self.src.slice(self.name_start, self.name_end)
}

///|
pub fn EndElement::prefix(self : EndElement) -> Option[String] {
  let mut i = self.name_start
  while i < self.name_end {
    if self.src.code_unit_at(i) == 58 {
      return Some(self.src.slice(self.name_start, i))
    }
    i = i + 1
  }
  None
}

///| Streaming XML pull-parser events.
pub enum Event {
  StartElement(StartElement)
  EmptyElement(StartElement)
  EndElement(EndElement)
  Text(String)
  CData(String)
  Comment(String)
  ProcessingInstruction(PI)
  XmlDecl(XmlDecl)
  DocType(String)
  Eof
}

///| Streaming pull parser for XML 1.0.
pub struct Reader {
  pub src : String
  pub mut pos : Int
  pub opts : ParseOptions
  pub mut done : Bool
  mut stage : Int
  mut saw_doctype : Bool
  tag_stack : Array[(String, Int, Int)]
  entities : EntityTable
  budget : EntityBudget
  ns_map : Map[String, String]
  ns_undo : Array[(String, Option[String])]
  ns_scope_stack : Array[Int]
  input_stack : Array[InputFrame]
  mut cur_src : String
  mut cur_len : Int
  mut cur_entity_idx : Int
  mut cur_base_depth : Int
}

///| XML 1.0 serializer with optional indentation and strict validation.
pub struct Writer {
  pub sb : StringBuilder
  pub indent_char : Byte
  pub indent_size : Int
  pub mut depth : Int
  pub tag_stack : Array[String]
  pub mut has_child_element : Array[Bool]
  pub mut wrote_anything : Bool
  mut wrote_root : Bool
  has_text_child : Array[Bool]
  ns_map : Map[String, String]
  ns_undo : Array[(String, Option[String])]
  ns_scope_stack : Array[Int]
}
