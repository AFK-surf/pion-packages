///| Strict XML 1.0 serializer (`Writer`) with 4x-unrolled LUT escaping, Namespaces 1.0 checks,
///| atomic error handling, and optional pretty indentation.

///|
pub fn Writer::new() -> Writer {
  Writer::with_capacity(256)
}

///|
pub fn Writer::with_capacity(cap : Int) -> Writer {
  Writer::{
    sb: StringBuilder::with_capacity(cap),
    indent_char: (32).to_byte(),
    indent_size: 0,
    depth: 0,
    tag_stack: [],
    has_child_element: [],
    wrote_anything: false,
    wrote_root: false,
    has_text_child: [],
    ns_map: Map::new(),
    ns_undo: [],
    ns_scope_stack: [],
  }
}

///|
pub fn Writer::new_with_indent(indent_char : Byte, indent_size : Int) -> Writer {
  let safe_char = if indent_char == (32).to_byte() || indent_char == (9).to_byte() {
    indent_char
  } else {
    (32).to_byte()
  }
  let safe_size = if indent_size < 0 { 0 } else { indent_size }
  Writer::{
    sb: StringBuilder::with_capacity(256),
    indent_char: safe_char,
    indent_size: safe_size,
    depth: 0,
    tag_stack: [],
    has_child_element: [],
    wrote_anything: false,
    wrote_root: false,
    has_text_child: [],
    ns_map: Map::new(),
    ns_undo: [],
    ns_scope_stack: [],
  }
}

///| Write newline + indentation if pretty-printing is enabled.
fn Writer::write_indent(self : Writer, depth : Int) -> Unit {
  if self.indent_size <= 0 {
    return ()
  }
  if self.wrote_anything {
    self.sb.write_byte((0x0A).to_byte())
  }
  let n = depth * self.indent_size
  let mut i = 0
  while i < n {
    self.sb.write_byte(self.indent_char)
    i = i + 1
  }
}

///| Whether the currently open element has text children (mixed content: suppress indentation).
fn Writer::in_mixed_content(self : Writer) -> Bool {
  let n = self.has_text_child.length()
  n > 0 && self.has_text_child[n - 1]
}

///| Write escaped XML text to `sb`, escaping `<`, `>`, `&`, `]]>`, and `\r` (`&#xD;`).
///| Caller must have validated `text` with `validate_xml_chars` for atomicity.
fn write_escaped_text_unchecked(sb : StringBuilder, text : String) -> Unit {
  let len = text.length()
  let mut i = 0
  let mut mark = 0
  while i < len {
    while i <= len - 4 {
      let m0 = xml_lut[text.code_unit_at(i)]
      let m1 = xml_lut[text.code_unit_at(i + 1)]
      let m2 = xml_lut[text.code_unit_at(i + 2)]
      let m3 = xml_lut[text.code_unit_at(i + 3)]
      if ((m0 & m1 & m2 & m3) & mask_write_text_safe) != 0 {
        i = i + 4
      } else {
        break
      }
    }
    if i >= len {
      break
    }
    let b = text.code_unit_at(i)
    if b < 0x80 {
      if (xml_lut[b] & mask_write_text_safe) != 0 {
        i = i + 1
      } else if b == 0x26 {
        if i > mark {
          sb.write_substring(text, mark, i)
        }
        sb.write_string("&amp;")
        i = i + 1
        mark = i
      } else if b == 0x3C {
        if i > mark {
          sb.write_substring(text, mark, i)
        }
        sb.write_string("&lt;")
        i = i + 1
        mark = i
      } else if b == 0x3E {
        if i > mark {
          sb.write_substring(text, mark, i)
        }
        sb.write_string("&gt;")
        i = i + 1
        mark = i
      } else if b == 0x0D {
        if i > mark {
          sb.write_substring(text, mark, i)
        }
        sb.write_string("&#xD;")
        i = i + 1
        mark = i
      } else if b == 0x5D {
        if i + 2 < len &&
        text.code_unit_at(i + 1) == 0x5D &&
        text.code_unit_at(i + 2) == 0x3E {
          if i > mark {
            sb.write_substring(text, mark, i)
          }
          sb.write_string("]]&gt;")
          i = i + 3
          mark = i
        } else {
          i = i + 1
        }
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  if len > mark {
    sb.write_substring(text, mark, len)
  }
}

///| Write escaped XML attribute value to `sb` (double-quoted context).
///| Caller must have validated `attr_val` with `validate_xml_chars` for atomicity.
fn write_escaped_attr_unchecked(sb : StringBuilder, attr_val : String) -> Unit {
  let len = attr_val.length()
  let mut i = 0
  let mut mark = 0
  while i < len {
    while i <= len - 4 {
      let m0 = xml_lut[attr_val.code_unit_at(i)]
      let m1 = xml_lut[attr_val.code_unit_at(i + 1)]
      let m2 = xml_lut[attr_val.code_unit_at(i + 2)]
      let m3 = xml_lut[attr_val.code_unit_at(i + 3)]
      if ((m0 & m1 & m2 & m3) & mask_write_attr_safe) != 0 {
        i = i + 4
      } else {
        break
      }
    }
    if i >= len {
      break
    }
    let b = attr_val.code_unit_at(i)
    if b < 0x80 {
      if (xml_lut[b] & mask_write_attr_safe) != 0 {
        i = i + 1
      } else if b == 0x26 {
        if i > mark {
          sb.write_substring(attr_val, mark, i)
        }
        sb.write_string("&amp;")
        i = i + 1
        mark = i
      } else if b == 0x3C {
        if i > mark {
          sb.write_substring(attr_val, mark, i)
        }
        sb.write_string("&lt;")
        i = i + 1
        mark = i
      } else if b == 0x3E {
        if i > mark {
          sb.write_substring(attr_val, mark, i)
        }
        sb.write_string("&gt;")
        i = i + 1
        mark = i
      } else if b == 0x22 {
        if i > mark {
          sb.write_substring(attr_val, mark, i)
        }
        sb.write_string("&quot;")
        i = i + 1
        mark = i
      } else if b == 0x27 {
        if i > mark {
          sb.write_substring(attr_val, mark, i)
        }
        sb.write_string("&apos;")
        i = i + 1
        mark = i
      } else if b == 0x09 {
        if i > mark {
          sb.write_substring(attr_val, mark, i)
        }
        sb.write_string("&#x9;")
        i = i + 1
        mark = i
      } else if b == 0x0A {
        if i > mark {
          sb.write_substring(attr_val, mark, i)
        }
        sb.write_string("&#xA;")
        i = i + 1
        mark = i
      } else if b == 0x0D {
        if i > mark {
          sb.write_substring(attr_val, mark, i)
        }
        sb.write_string("&#xD;")
        i = i + 1
        mark = i
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  if len > mark {
    sb.write_substring(attr_val, mark, len)
  }
}

///| Validate all characters in `s` are legal XML 1.0 Chars (4x-unrolled ASCII fast path).
fn validate_xml_chars(s : String) -> Result[Unit, XmlError] {
  let len = s.length()
  let mut i = 0
  while i < len {
    while i <= len - 4 {
      let m0 = xml_lut[s.code_unit_at(i)]
      let m1 = xml_lut[s.code_unit_at(i + 1)]
      let m2 = xml_lut[s.code_unit_at(i + 2)]
      let m3 = xml_lut[s.code_unit_at(i + 3)]
      if ((m0 & m1 & m2 & m3) & mask_valid_ascii) != 0 {
        i = i + 4
      } else {
        break
      }
    }
    if i >= len {
      break
    }
    let b = s.code_unit_at(i)
    if b < 0x80 {
      if (xml_lut[b] & mask_valid_ascii) == 0 {
        return Err(make_err(s, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character"))
      }
      i = i + 1
    } else {
      let (cp, blen) = decode_utf8(s, i, len)
      if cp < 0 || !is_xml_char(cp) {
        return Err(make_err(s, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character"))
      }
      i = i + blen
    }
  }
  Ok(())
}

///| Find the index of `:` in `s`, or `-1` if none.
fn find_colon(s : String) -> Int {
  let len = s.length()
  let mut i = 0
  while i < len {
    if s.code_unit_at(i) == 0x3A {
      return i
    }
    i = i + 1
  }
  -1
}

///| Validate element tag name, attributes, duplicate attributes, and Namespaces 1.0 rules
///| before mutating the output buffer. Returns any new prefixed `xmlns:p="uri"` declarations.
fn Writer::validate_element(
  self : Writer,
  name : String,
  attrs : Array[(String, String)],
) -> Result[Array[(String, String)], XmlError] {
  if self.tag_stack.length() == 0 && self.wrote_root {
    return Err(XmlError::new(XmlErrorKind::MultipleRootNodes, 0, 1, 1, "multiple root elements"))
  }
  if !is_valid_xml_name(name, true) {
    return Err(XmlError::new(XmlErrorKind::InvalidName, 0, 1, 1, "invalid element name: " + name))
  }
  let elem_colon = find_colon(name)
  if elem_colon >= 0 && raw_slice_eq_str(name, 0, elem_colon, "xmlns") {
    return Err(
      XmlError::new(XmlErrorKind::InvalidNamespace, 0, 1, 1, "element cannot use 'xmlns' prefix"),
    )
  }

  let n = attrs.length()
  let new_ns_decls : Array[(String, String)] = []
  let mut has_prefixed_attr = false
  let use_map = n >= 8
  let seen_names : Map[String, Bool] = if use_map { Map::new() } else { Map::new() }

  let mut i = 0
  while i < n {
    let (k, v) = attrs[i]
    if !is_valid_xml_name(k, true) {
      return Err(XmlError::new(XmlErrorKind::InvalidName, 0, 1, 1, "invalid attribute name: " + k))
    }
    match validate_xml_chars(v) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
    // Check duplicate raw attribute name
    if use_map {
      match seen_names.get(k) {
        Some(_) =>
        return Err(XmlError::new(XmlErrorKind::DuplicateAttribute, 0, 1, 1, "duplicate attribute: " + k))
        None => seen_names.set(k, true)
      }
    } else {
      let mut j = 0
      while j < i {
        if attrs[j].0 == k {
          return Err(XmlError::new(XmlErrorKind::DuplicateAttribute, 0, 1, 1, "duplicate attribute: " + k))
        }
        j = j + 1
      }
    }
    let acolon = find_colon(k)
    if acolon < 0 {
      if k == "xmlns" {
        if v == xml_ns_uri || v == xmlns_ns_uri {
          return Err(
            XmlError::new(XmlErrorKind::InvalidNamespace, 0, 1, 1, "cannot bind default namespace to reserved URI"),
          )
        }
      }
    } else if acolon == 5 && raw_slice_eq_str(k, 0, 5, "xmlns") {
      let p = k.slice(6, k.length())
      if v.length() == 0 {
        return Err(
          XmlError::new(XmlErrorKind::InvalidNamespace, 0, 1, 1, "prefixed namespace URI cannot be empty"),
        )
      }
      if p == "xmlns" {
        return Err(
          XmlError::new(XmlErrorKind::InvalidNamespace, 0, 1, 1, "cannot declare prefix 'xmlns'"),
        )
      }
      if p == "xml" {
        if v != xml_ns_uri {
          return Err(
            XmlError::new(XmlErrorKind::InvalidNamespace, 0, 1, 1, "prefix 'xml' can only be bound to XML namespace"),
          )
        }
      } else if v == xml_ns_uri {
        return Err(
          XmlError::new(XmlErrorKind::InvalidNamespace, 0, 1, 1, "only prefix 'xml' may bind to XML namespace"),
        )
      }
      if v == xmlns_ns_uri {
        return Err(
          XmlError::new(XmlErrorKind::InvalidNamespace, 0, 1, 1, "no prefix may bind to xmlns namespace"),
        )
      }
      new_ns_decls.push((p, v))
    } else {
      has_prefixed_attr = true
    }
    i = i + 1
  }

  // Helper to resolve a prefix against local declarations then outer Writer scope
  if elem_colon >= 0 {
    let ep = name.slice(0, elem_colon)
    if ep != "xml" {
      let mut found = false
      let mut k = 0
      while k < new_ns_decls.length() {
        if new_ns_decls[k].0 == ep {
          found = true
          break
        }
        k = k + 1
      }
      if !found {
        match self.ns_map.get(ep) {
          Some(_) => found = true
          None => ()
        }
      }
      if !found {
        return Err(
          XmlError::new(XmlErrorKind::UnboundNamespacePrefix, 0, 1, 1, "unbound namespace prefix on element: " + ep),
        )
      }
    }
  }

  if has_prefixed_attr {
    let expanded : Array[(String, String)] = []
    let mut ai = 0
    while ai < n {
      let k = attrs[ai].0
      let acolon = find_colon(k)
      if acolon >= 0 && !(acolon == 5 && raw_slice_eq_str(k, 0, 5, "xmlns")) {
        let ap = k.slice(0, acolon)
        let alocal = k.slice(acolon + 1, k.length())
        let mut uri_opt : Option[String] = if ap == "xml" {
          Some(xml_ns_uri)
        } else {
          None
        }
        if uri_opt.is_none() {
          let mut di = 0
          while di < new_ns_decls.length() {
            if new_ns_decls[di].0 == ap {
              uri_opt = Some(new_ns_decls[di].1)
              break
            }
            di = di + 1
          }
        }
        if uri_opt.is_none() {
          uri_opt = self.ns_map.get(ap)
        }
        let uri = match uri_opt {
          Some(u) => u
          None =>
          return Err(
            XmlError::new(XmlErrorKind::UnboundNamespacePrefix, 0, 1, 1, "unbound namespace prefix on attribute: " + ap),
          )
        }
        let mut ej = 0
        while ej < expanded.length() {
          if expanded[ej].0 == uri && expanded[ej].1 == alocal {
            return Err(
              XmlError::new(XmlErrorKind::DuplicateAttribute, 0, 1, 1, "duplicate expanded attribute name"),
            )
          }
          ej = ej + 1
        }
        expanded.push((uri, alocal))
      }
      ai = ai + 1
    }
  }

  Ok(new_ns_decls)
}

///|
pub fn Writer::write_xml_decl(
  self : Writer,
  version : String,
  encoding : Option[String],
  standalone : Option[Bool],
) -> Result[Unit, XmlError] {
  if self.wrote_anything {
    return Err(
      XmlError::new(XmlErrorKind::InvalidXmlDecl, 0, 1, 1, "XML declaration must appear at the start of the document"),
    )
  }
  if !is_valid_xml_version(version, 0, version.length()) {
    return Err(
      XmlError::new(XmlErrorKind::InvalidXmlDecl, 0, 1, 1, "XML version must match '1.[0-9]+'"),
    )
  }
  match encoding {
    Some(enc) => {
      if !is_valid_enc_name(enc, 0, enc.length()) {
        return Err(XmlError::new(XmlErrorKind::InvalidXmlDecl, 0, 1, 1, "invalid encoding name"))
      }
    }
    None => ()
  }
  self.sb.write_string("<?xml version=\"")
  self.sb.write_string(version)
  self.sb.write_byte((0x22).to_byte())
  match encoding {
    Some(enc) => {
      self.sb.write_string(" encoding=\"")
      self.sb.write_string(enc)
      self.sb.write_byte((0x22).to_byte())
    }
    None => ()
  }
  match standalone {
    Some(true) => self.sb.write_string(" standalone=\"yes\"")
    Some(false) => self.sb.write_string(" standalone=\"no\"")
    None => ()
  }
  self.sb.write_string("?>")
  self.wrote_anything = true
  Ok(())
}

///|
pub fn Writer::write_start_element(
  self : Writer,
  name : String,
  attrs : Array[(String, String)],
) -> Result[Unit, XmlError] {
  let new_ns_decls = match self.validate_element(name, attrs) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let mixed = self.in_mixed_content()
  if self.has_child_element.length() > 0 {
    self.has_child_element[self.has_child_element.length() - 1] = true
  }
  if !mixed {
    self.write_indent(self.depth)
  }
  self.sb.write_byte((0x3C).to_byte())
  self.sb.write_string(name)
  let mut i = 0
  while i < attrs.length() {
    let (k, v) = attrs[i]
    self.sb.write_byte((0x20).to_byte())
    self.sb.write_string(k)
    self.sb.write_string("=\"")
    write_escaped_attr_unchecked(self.sb, v)
    self.sb.write_byte((0x22).to_byte())
    i = i + 1
  }
  self.sb.write_byte((0x3E).to_byte())
  let prev_undo_len = self.ns_undo.length()
  let mut di = 0
  while di < new_ns_decls.length() {
    let (p, u) = new_ns_decls[di]
    let prev = self.ns_map.get(p)
    self.ns_undo.push((p, prev))
    self.ns_map.set(p, u)
    di = di + 1
  }
  self.ns_scope_stack.push(prev_undo_len)
  self.tag_stack.push(name)
  self.has_child_element.push(false)
  self.has_text_child.push(false)
  self.depth = self.depth + 1
  self.wrote_root = true
  self.wrote_anything = true
  Ok(())
}

///|
pub fn Writer::write_empty_element(
  self : Writer,
  name : String,
  attrs : Array[(String, String)],
) -> Result[Unit, XmlError] {
  match self.validate_element(name, attrs) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mixed = self.in_mixed_content()
  if self.has_child_element.length() > 0 {
    self.has_child_element[self.has_child_element.length() - 1] = true
  }
  if !mixed {
    self.write_indent(self.depth)
  }
  self.sb.write_byte((0x3C).to_byte())
  self.sb.write_string(name)
  let mut i = 0
  while i < attrs.length() {
    let (k, v) = attrs[i]
    self.sb.write_byte((0x20).to_byte())
    self.sb.write_string(k)
    self.sb.write_string("=\"")
    write_escaped_attr_unchecked(self.sb, v)
    self.sb.write_byte((0x22).to_byte())
    i = i + 1
  }
  self.sb.write_string("/>")
  self.wrote_root = true
  self.wrote_anything = true
  Ok(())
}

///|
pub fn Writer::write_end_element(
  self : Writer,
  name : String,
) -> Result[Unit, XmlError] {
  if self.tag_stack.length() == 0 {
    return Err(XmlError::new(XmlErrorKind::MismatchedTag, 0, 1, 1, "no open element to close"))
  }
  let top = self.tag_stack[self.tag_stack.length() - 1]
  if top != name {
    return Err(XmlError::new(XmlErrorKind::MismatchedTag, 0, 1, 1, "mismatched end element: expected " + top + ", got " + name))
  }
  let _ = self.tag_stack.pop()
  let had_child_elem = match self.has_child_element.pop() {
    Some(v) => v
    None => false
  }
  let had_text_child = match self.has_text_child.pop() {
    Some(v) => v
    None => false
  }
  let prev_undo_len = match self.ns_scope_stack.pop() {
    Some(v) => v
    None => 0
  }
  while self.ns_undo.length() > prev_undo_len {
    match self.ns_undo.pop() {
      Some((p, Some(old_u))) => self.ns_map.set(p, old_u)
      Some((p, None)) => self.ns_map.remove(p)
      None => ()
    }
  }
  self.depth = self.depth - 1
  if had_child_elem && !had_text_child {
    self.write_indent(self.depth)
  }
  self.sb.write_string("</")
  self.sb.write_string(name)
  self.sb.write_byte((0x3E).to_byte())
  self.wrote_anything = true
  Ok(())
}

///|
pub fn Writer::write_text(self : Writer, text : String) -> Result[Unit, XmlError] {
  if self.tag_stack.length() == 0 {
    return Err(XmlError::new(XmlErrorKind::InvalidSyntax, 0, 1, 1, "text not allowed outside root element"))
  }
  match validate_xml_chars(text) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  if self.has_text_child.length() > 0 && text.length() > 0 {
    self.has_text_child[self.has_text_child.length() - 1] = true
  }
  write_escaped_text_unchecked(self.sb, text)
  self.wrote_anything = true
  Ok(())
}

///|
pub fn Writer::write_cdata(self : Writer, text : String) -> Result[Unit, XmlError] {
  if self.tag_stack.length() == 0 {
    return Err(XmlError::new(XmlErrorKind::InvalidCData, 0, 1, 1, "CDATA not allowed outside root element"))
  }
  match validate_xml_chars(text) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  let len = text.length()
  let mut i = 0
  while i + 2 < len {
    if text.code_unit_at(i) == 0x5D &&
    text.code_unit_at(i + 1) == 0x5D &&
    text.code_unit_at(i + 2) == 0x3E {
      return Err(make_err(text, i, XmlErrorKind::InvalidCData, "']]>' is not allowed inside CDATA"))
    }
    i = i + 1
  }
  if self.has_text_child.length() > 0 {
    self.has_text_child[self.has_text_child.length() - 1] = true
  }
  self.sb.write_string("<![CDATA[")
  self.sb.write_string(text)
  self.sb.write_string("]]>")
  self.wrote_anything = true
  Ok(())
}

///|
pub fn Writer::write_comment(
  self : Writer,
  text : String,
) -> Result[Unit, XmlError] {
  match validate_xml_chars(text) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  let len = text.length()
  if len > 0 && text.code_unit_at(len - 1) == 0x2D {
    return Err(make_err(text, len - 1, XmlErrorKind::InvalidComment, "comment cannot end with '-'"))
  }
  let mut i = 0
  while i + 1 < len {
    if text.code_unit_at(i) == 0x2D && text.code_unit_at(i + 1) == 0x2D {
      return Err(make_err(text, i, XmlErrorKind::InvalidComment, "'--' is not allowed inside comment"))
    }
    i = i + 1
  }
  let mixed = self.in_mixed_content()
  if self.has_child_element.length() > 0 {
    self.has_child_element[self.has_child_element.length() - 1] = true
  }
  if !mixed {
    self.write_indent(self.depth)
  }
  self.sb.write_string("<!--")
  self.sb.write_string(text)
  self.sb.write_string("-->")
  self.wrote_anything = true
  Ok(())
}

///|
pub fn Writer::write_pi(
  self : Writer,
  target : String,
  value : Option[String],
) -> Result[Unit, XmlError] {
  if !is_valid_xml_name(target, false) || is_xml_ci(target, 0, target.length()) {
    return Err(XmlError::new(XmlErrorKind::InvalidPI, 0, 1, 1, "invalid PI target: " + target))
  }
  match value {
    Some(v) => {
      match validate_xml_chars(v) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      let len = v.length()
      let mut i = 0
      while i + 1 < len {
        if v.code_unit_at(i) == 0x3F && v.code_unit_at(i + 1) == 0x3E {
          return Err(make_err(v, i, XmlErrorKind::InvalidPI, "'?>' is not allowed inside PI value"))
        }
        i = i + 1
      }
      let mixed = self.in_mixed_content()
      if self.has_child_element.length() > 0 {
        self.has_child_element[self.has_child_element.length() - 1] = true
      }
      if !mixed {
        self.write_indent(self.depth)
      }
      self.sb.write_string("<?")
      self.sb.write_string(target)
      self.sb.write_byte((0x20).to_byte())
      self.sb.write_string(v)
      self.sb.write_string("?>")
    }
    None => {
      let mixed = self.in_mixed_content()
      if self.has_child_element.length() > 0 {
        self.has_child_element[self.has_child_element.length() - 1] = true
      }
      if !mixed {
        self.write_indent(self.depth)
      }
      self.sb.write_string("<?")
      self.sb.write_string(target)
      self.sb.write_string("?>")
    }
  }
  self.wrote_anything = true
  Ok(())
}

///| Iteratively serialize a parsed `Document` (zero recursion, handles arbitrarily deep trees).
pub fn Writer::write_document(
  self : Writer,
  doc : Document,
) -> Result[Unit, XmlError] {
  // Stack entries: `(node_id, is_closing)`
  let stack : Array[(Int, Bool)] = []
  let mut child = doc.nodes[0].last_child
  while child >= 0 {
    stack.push((child, false))
    child = doc.nodes[child].prev_sibling
  }
  while stack.length() > 0 {
    let (nid, is_close) = match stack.pop() {
      Some(v) => v
      None => break
    }
    let nd = doc.nodes[nid]
    let nd_kind = nd.kind_ns & 7
    if is_close {
      let qname = if nd.s2_start >= 0 && nd.s2_start == nd.s2_end {
        span_to_string(doc.src, doc.strings, TextSpan::{ start: nd.s1_start, end: nd.s1_end })
      } else {
        span_to_string(doc.src, doc.strings, TextSpan::{ start: nd.s2_start, end: nd.s2_end }) +
        ":" +
        span_to_string(doc.src, doc.strings, TextSpan::{ start: nd.s1_start, end: nd.s1_end })
      }
      match self.write_end_element(qname) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      continue
    }
    if nd_kind == node_kind_element {
      let qname = if nd.s2_start >= 0 && nd.s2_start == nd.s2_end {
        span_to_string(doc.src, doc.strings, TextSpan::{ start: nd.s1_start, end: nd.s1_end })
      } else {
        span_to_string(doc.src, doc.strings, TextSpan::{ start: nd.s2_start, end: nd.s2_end }) +
        ":" +
        span_to_string(doc.src, doc.strings, TextSpan::{ start: nd.s1_start, end: nd.s1_end })
      }
      let out_attrs : Array[(String, String)] = []
      // Namespace declarations first
      let mut nk = nd.ns_start
      while nk < nd.ns_end {
        let ns = doc.namespaces[nk]
        let k = if ns.has_prefix {
          "xmlns:" + span_to_string(doc.src, doc.strings, ns.prefix_span)
        } else {
          "xmlns"
        }
        let v = span_to_string(doc.src, doc.strings, ns.uri_span)
        out_attrs.push((k, v))
        nk = nk + 1
      }
      // Regular attributes
      let mut ak = nd.attrs_start
      while ak < nd.attrs_end {
        let a = doc.attrs[ak]
        let k = if a.prefix_start >= 0 && a.prefix_start == a.prefix_end {
          span_to_string(doc.src, doc.strings, TextSpan::{ start: a.local_start, end: a.local_end })
        } else {
          span_to_string(doc.src, doc.strings, TextSpan::{ start: a.prefix_start, end: a.prefix_end }) +
          ":" +
          span_to_string(doc.src, doc.strings, TextSpan::{ start: a.local_start, end: a.local_end })
        }
        let v = span_to_string(doc.src, doc.strings, TextSpan::{ start: a.val_start, end: a.val_end })
        out_attrs.push((k, v))
        ak = ak + 1
      }
      if nd.first_child < 0 {
        match self.write_empty_element(qname, out_attrs) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      } else {
        match self.write_start_element(qname, out_attrs) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
        // Detect mixed content up-front so pretty-printing never injects whitespace before/between elements
        let mut scan_c = nd.first_child
        let mut has_text = false
        while scan_c >= 0 {
          if (doc.nodes[scan_c].kind_ns & 7) == node_kind_text {
            has_text = true
            break
          }
          scan_c = doc.nodes[scan_c].next_sibling
        }
        if has_text && self.has_text_child.length() > 0 {
          self.has_text_child[self.has_text_child.length() - 1] = true
        }
        stack.push((nid, true))
        let mut c = nd.last_child
        while c >= 0 {
          stack.push((c, false))
          c = doc.nodes[c].prev_sibling
        }
      }
    } else if nd_kind == node_kind_text {
      let t = span_to_string(doc.src, doc.strings, TextSpan::{ start: nd.s1_start, end: nd.s1_end })
      match self.write_text(t) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    } else if nd_kind == node_kind_comment {
      let c = span_to_string(doc.src, doc.strings, TextSpan::{ start: nd.s1_start, end: nd.s1_end })
      match self.write_comment(c) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    } else if nd_kind == node_kind_pi {
      let target = span_to_string(doc.src, doc.strings, TextSpan::{ start: nd.s1_start, end: nd.s1_end })
      let pi_has_val = ((nd.kind_ns >> 3) - 2) != 0
      let pi_val = if pi_has_val {
        Some(span_to_string(doc.src, doc.strings, TextSpan::{ start: nd.s2_start, end: nd.s2_end }))
      } else {
        None
      }
      match self.write_pi(target, pi_val) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    }
  }
  Ok(())
}

///|
pub fn Writer::into_string(self : Writer) -> String {
  self.sb.to_string()
}

///|
pub fn Writer::to_string(self : Writer) -> String {
  self.sb.to_string()
}
