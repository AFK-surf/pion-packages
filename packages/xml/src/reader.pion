///| Streaming XML 1.0 + Namespaces 1.0 pull parser (`Reader` / `Event`).

let reader_stage_start : Int = 0

let reader_stage_prolog : Int = 1

let reader_stage_in_root : Int = 2

let reader_stage_epilog : Int = 3

///| Create a streaming pull parser with default options.
pub fn Reader::new(src : String) -> Reader {
  Reader::with_options(src, ParseOptions::default())
}

///| Create a streaming pull parser with custom options and limits.
pub fn Reader::with_options(src : String, opts : ParseOptions) -> Reader {
  let mut start = 0
  if src.length() >= 3 &&
  src.code_unit_at(0) == 0xEF &&
  src.code_unit_at(1) == 0xBB &&
  src.code_unit_at(2) == 0xBF {
    start = 3
  }
  Reader::{
    src: src,
    pos: start,
    opts: opts,
    done: false,
    stage: reader_stage_start,
    saw_doctype: false,
    depth: 0,
    tag_src: [],
    tag_start: [],
    tag_end: [],
    attr_starts: [],
    attr_ends: [],
    attr_colons: [],
    entities: EntityTable::new(),
    budget: EntityBudget::new(opts.limits),
    ns_map: Map::new(),
    ns_undo: [],
    ns_scope_stack: [],
    input_stack: [],
    cur_src: src,
    cur_len: src.length(),
    cur_entity_idx: -1,
    cur_base_depth: 0,
  }
}

///| Undo Reader namespace bindings back to `target_len`.
fn Reader::undo_ns(self : Reader, target_len : Int) -> Unit {
  while self.ns_undo.length() > target_len {
    match self.ns_undo.pop() {
      Some((p, Some(old_u))) => self.ns_map.set(p, old_u)
      Some((p, None)) => self.ns_map.remove(p)
      None => ()
    }
  }
}

///| Compare `s1[a_start..a_end]` with `s2[b_start..b_end]` without allocating.
fn str_slice_eq(
  s1 : String,
  a_start : Int,
  a_end : Int,
  s2 : String,
  b_start : Int,
  b_end : Int,
) -> Bool {
  let alen = a_end - a_start
  if alen != b_end - b_start {
    return false
  }
  let mut i = 0
  while i < alen {
    if s1.code_unit_at(a_start + i) != s2.code_unit_at(b_start + i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Cold helper: handle prolog/epilog markup outside the root element.
///| Returns `Ok(Some(ev))` if an event is ready, `Ok(None)` if caller should proceed to start root element.
fn Reader::next_event_outside_root(self : Reader) -> Result[Option[Event], XmlError] {
  let src = self.cur_src
  let len = self.cur_len
  let mut pos = self.pos

  if self.stage == reader_stage_start {
    self.stage = reader_stage_prolog
    if pos + 5 <= len && raw_slice_eq_str(src, pos, pos + 5, "<?xml") {
      let next_b = if pos + 5 < len { src.code_unit_at(pos + 5) } else { 0 }
      if next_b == 0x20 ||
      next_b == 0x09 ||
      next_b == 0x0A ||
      next_b == 0x0D ||
      next_b == 0x3F {
        match parse_xml_decl(src, pos, len) {
          Ok((decl, ni)) => {
            self.pos = ni
            return Ok(Some(Event::XmlDecl(decl)))
          }
          Err(e) => return Err(e)
        }
      }
    }
  }

  pos = skip_ws(src, pos, len)
  self.pos = pos
  if pos >= len {
    self.done = true
    if self.stage != reader_stage_epilog {
      return Err(make_err(src, pos, XmlErrorKind::NoRootNode, "document has no root element"))
    }
    return Ok(Some(Event::Eof))
  }
  if src.code_unit_at(pos) != 0x3C {
    return Err(
      make_err(src, pos, XmlErrorKind::InvalidSyntax, "unexpected text outside root element"),
    )
  }
  if pos + 1 >= len {
    return Err(make_err(src, pos, XmlErrorKind::UnexpectedEof, "unexpected EOF after '<'"))
  }
  let b1 = src.code_unit_at(pos + 1)
  if b1 == 0x21 {
    if pos + 4 <= len && raw_slice_eq_str(src, pos, pos + 4, "<!--") {
      match scan_comment(src, pos + 4, len) {
        Ok((cs, ce, has_cr, ni)) => {
          self.pos = ni
          let text = if has_cr {
            normalize_eol(src, cs, ce)
          } else {
            src.slice(cs, ce)
          }
          return Ok(Some(Event::Comment(text)))
        }
        Err(e) => return Err(e)
      }
    } else if pos + 9 <= len && raw_slice_eq_str(src, pos, pos + 9, "<!DOCTYPE") {
      if self.stage == reader_stage_epilog {
        return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "DOCTYPE not allowed after root element"))
      }
      if self.saw_doctype {
        return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "multiple DOCTYPE declarations"))
      }
      if !self.opts.allow_dtd {
        return Err(make_err(src, pos, XmlErrorKind::DtdDetected, "DTD is disabled by default"))
      }
      self.saw_doctype = true
      match parse_doctype(src, pos + 9, len, self.entities) {
        Ok((ds, de, ni)) => {
          self.pos = ni
          return Ok(Some(Event::DocType(src.slice(ds, de))))
        }
        Err(e) => return Err(e)
      }
    } else if pos + 9 <= len && raw_slice_eq_str(src, pos, pos + 9, "<![CDATA[") {
      return Err(make_err(src, pos, XmlErrorKind::InvalidCData, "CDATA not allowed outside root element"))
    } else {
      return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "invalid markup in prolog/epilog"))
    }
  } else if b1 == 0x3F {
    match scan_pi(src, pos + 2, len) {
      Ok((ts, te, vs, ve, has_val, has_cr, ni)) => {
        self.pos = ni
        let target = src.slice(ts, te)
        let value = if !has_val {
          None
        } else if has_cr {
          Some(normalize_eol(src, vs, ve))
        } else {
          Some(src.slice(vs, ve))
        }
        return Ok(Some(Event::ProcessingInstruction(PI::{ target: target, value: value })))
      }
      Err(e) => return Err(e)
    }
  } else if b1 == 0x2F {
    return Err(make_err(src, pos, XmlErrorKind::MismatchedTag, "unexpected end tag at root level"))
  } else if self.stage == reader_stage_epilog {
    return Err(make_err(src, pos, XmlErrorKind::MultipleRootNodes, "multiple root elements"))
  }
  Ok(None)
}

///| Cold helper: push a custom DTD entity replacement frame onto `input_stack`.
fn Reader::push_custom_entity(
  self : Reader,
  src : String,
  err_pos : Int,
  len : Int,
  custom_ent_idx : Int,
  custom_ent_after : Int,
) -> Result[Unit, XmlError] {
  let ent = self.entities.defs[custom_ent_idx]
  if ent.is_external {
    return Err(
      make_err(src, err_pos, XmlErrorKind::ExternalEntityNotAllowed, "external entity reference is not allowed"),
    )
  }
  if self.cur_entity_idx == custom_ent_idx {
    return Err(make_err(src, err_pos, XmlErrorKind::EntityLoop, "circular entity reference"))
  }
  let mut k = 0
  while k < self.input_stack.length() {
    if self.input_stack[k].entity_idx == custom_ent_idx {
      return Err(make_err(src, err_pos, XmlErrorKind::EntityLoop, "circular entity reference"))
    }
    k = k + 1
  }
  self.budget.expansions = self.budget.expansions + 1
  self.budget.bytes = self.budget.bytes + ent.value.length()
  if self.budget.expansions > self.budget.max_expansions ||
  self.budget.bytes > self.budget.max_bytes {
    return Err(make_err(src, err_pos, XmlErrorKind::LimitExceeded, "entity expansion limit exceeded"))
  }
  self.input_stack.push(
    InputFrame::{
      src: src,
      pos: custom_ent_after,
      len: len,
      entity_idx: self.cur_entity_idx,
      base_depth: self.cur_base_depth,
    },
  )
  self.cur_src = ent.value
  self.pos = 0
  self.cur_len = ent.value.length()
  self.cur_entity_idx = custom_ent_idx
  self.cur_base_depth = self.depth
  Ok(())
}

///| Cold helper: scan Comment, CDATA, or PI inside an element.
fn Reader::handle_bang_or_pi(
  self : Reader,
  src : String,
  pos : Int,
  len : Int,
  b1 : Int,
) -> Result[Event, XmlError] {
  if b1 == 0x21 {
    if pos + 4 <= len && src.code_unit_at(pos + 2) == 0x2D && src.code_unit_at(pos + 3) == 0x2D {
      let sc = scan_comment_fast(src, pos + 4, len)
      if sc.next >= 0 {
        self.pos = sc.next
        let text = if sc.has_cr {
          normalize_eol(src, sc.start, sc.end)
        } else {
          src.slice(sc.start, sc.end)
        }
        return Ok(Event::Comment(text))
      }
      return match scan_comment(src, pos + 4, len) {
        Ok((_, _, _, _)) => Err(make_err(src, pos, XmlErrorKind::InvalidComment, "invalid comment"))
        Err(e) => Err(e)
      }
    } else if pos + 9 <= len && src.code_unit_at(pos + 2) == 0x5B && raw_slice_eq_str(src, pos, pos + 9, "<![CDATA[") {
      let sc = scan_cdata_fast(src, pos + 9, len)
      if sc.next >= 0 {
        self.pos = sc.next
        let text = if sc.has_cr {
          normalize_eol(src, sc.start, sc.end)
        } else {
          src.slice(sc.start, sc.end)
        }
        return Ok(Event::CData(text))
      }
      return match scan_cdata(src, pos + 9, len) {
        Ok((_, _, _, _)) => Err(make_err(src, pos, XmlErrorKind::InvalidCData, "invalid CDATA"))
        Err(e) => Err(e)
      }
    } else {
      return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "unexpected '<!' inside element"))
    }
  }
  match scan_pi(src, pos + 2, len) {
    Ok((ts, te, vs, ve, has_val, has_cr, ni)) => {
      self.pos = ni
      let target = src.slice(ts, te)
      let value = if !has_val {
        None
      } else if has_cr {
        Some(normalize_eol(src, vs, ve))
      } else {
        Some(src.slice(vs, ve))
      }
      Ok(Event::ProcessingInstruction(PI::{ target: target, value: value }))
    }
    Err(e) => Err(e)
  }
}

///| Cold helper: slow end tag parsing (whitespace before `>`, entity frames, or errors).
fn Reader::handle_end_tag_slow(
  self : Reader,
  src : String,
  name_start : Int,
  len : Int,
  osrc : String,
  os : Int,
  oe : Int,
) -> Result[Event, XmlError] {
  let qn = scan_qname(src, name_start, len)
  let name_end = qn.end
  if name_end < 0 {
    return Err(make_err(src, name_start, XmlErrorKind::InvalidName, "invalid end tag name"))
  }
  let after_ws = skip_ws(src, name_end, len)
  if after_ws >= len || src.code_unit_at(after_ws) != 0x3E {
    return Err(make_err(src, after_ws, XmlErrorKind::InvalidSyntax, "expected '>' closing end tag"))
  }
  if !str_slice_eq(osrc, os, oe, src, name_start, name_end) {
    return Err(make_err(src, name_start, XmlErrorKind::MismatchedTag, "mismatched end tag"))
  }
  let depth = self.depth
  self.depth = depth - 1
  let nsl = self.ns_scope_stack.length()
  if nsl > 0 && self.ns_scope_stack[nsl - 1] == depth {
    let _ = self.ns_scope_stack.pop()
    let prev_undo = match self.ns_scope_stack.pop() {
      Some(v) => v
      None => 0
    }
    self.undo_ns(prev_undo)
  }
  if depth == 1 {
    self.stage = reader_stage_epilog
  }
  self.pos = after_ws + 1
  Ok(
    Event::EndElement(
      EndElement::{ src: src, name_start: name_start, name_end: name_end },
    ),
  )
}

///| Cold helper: validate prefixed attributes on a start/empty element.
fn Reader::validate_prefixed_attrs(
  self : Reader,
  src : String,
  attr_count : Int,
  prev_undo_len : Int,
) -> Result[Unit, XmlError] {
  let expanded : Array[(String, Int, Int)] = []
  let starts = self.attr_starts
  let ends = self.attr_ends
  let colons = self.attr_colons
  let mut ai = 0
  while ai < attr_count {
    let as_ = starts[ai]
    let ae = ends[ai]
    let ac = colons[ai]
    if ac >= 0 && !(ac - as_ == 5 && raw_slice_eq_str(src, as_, ac, "xmlns")) {
      let uri = if ac - as_ == 3 && raw_slice_eq_str(src, as_, ac, "xml") {
        xml_ns_uri
      } else {
        let ap = src.slice(as_, ac)
        match self.ns_map.get(ap) {
          Some(u) => u
          None => {
            self.undo_ns(prev_undo_len)
            return Err(
              make_err(src, as_, XmlErrorKind::UnboundNamespacePrefix, "unbound namespace prefix on attribute"),
            )
          }
        }
      }
      let ls = ac + 1
      let le = ae
      let llen = le - ls
      let l0 = src.code_unit_at(ls)
      let mut ej = 0
      while ej < expanded.length() {
        let (pu, pls, ple) = expanded[ej]
        if ple - pls == llen &&
        src.code_unit_at(pls) == l0 &&
        raw_slice_eq(src, pls, ple, ls, le) &&
        pu == uri {
          self.undo_ns(prev_undo_len)
          return Err(make_err(src, as_, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
        }
        ej = ej + 1
      }
      expanded.push((uri, ls, le))
    }
    ai = ai + 1
  }
  Ok(())
}

///| Helper: parse attributes of a start or empty tag starting at `tag_end` and return the Event directly
///| (zero tuple allocation).
fn Reader::parse_tag_with_attrs(
  self : Reader,
  src : String,
  tag_start : Int,
  tag_end : Int,
  tag_colon : Int,
  len : Int,
  prev_undo_len : Int,
  lut : FixedArray[Int],
) -> Result[Event, XmlError] {
  let raw_attrs : Array[RawAttribute] = Array::with_capacity(4)
  let attr_starts = self.attr_starts
  let attr_ends = self.attr_ends
  let attr_colons = self.attr_colons
  let mut attr_count = 0
  let mut i = tag_end
  let mut is_empty = false
  let mut tag_closed = false
  let max_attributes = self.opts.limits.max_attributes
  let mut saw_default_xmlns = false
  let mut has_prefixed_attr = false
  let mut seen_attr_map : Option[Map[String, Bool]] = None
  let no_custom_entities = self.entities.is_empty()

  while i < len {
    let ws_before = i
    let b_ws = src.code_unit_at(i)
    if b_ws == 0x20 {
      i = i + 1
      if i < len && src.code_unit_at(i) <= 0x20 {
        i = skip_ws(src, i, len)
      }
    } else if b_ws <= 0x20 {
      i = skip_ws(src, i, len)
    }
    if i >= len {
      self.undo_ns(prev_undo_len)
      return Err(make_err(src, i, XmlErrorKind::UnexpectedEof, "unterminated start tag"))
    }
    let cb = src.code_unit_at(i)
    if cb == 0x3E {
      i = i + 1
      tag_closed = true
      break
    }
    if cb == 0x2F {
      if i + 1 >= len || src.code_unit_at(i + 1) != 0x3E {
        self.undo_ns(prev_undo_len)
        return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected '>' after '/' in empty tag"))
      }
      is_empty = true
      i = i + 2
      tag_closed = true
      break
    }
    if i == ws_before {
      self.undo_ns(prev_undo_len)
      return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected whitespace before attribute"))
    }
    if attr_count >= max_attributes {
      self.undo_ns(prev_undo_len)
      return Err(make_err(src, i, XmlErrorKind::LimitExceeded, "max_attributes limit exceeded"))
    }
    let aname_start = i
    // Inline fast ASCII QName scan for attribute name (lut[128..255] == 0)
    let mut aname_end = aname_start
    let mut acolon = -1
    if (lut[cb] & mask_ncname_start) != 0 {
      aname_end = aname_start + 1
      while aname_end < len {
        if (lut[src.code_unit_at(aname_end)] & mask_ncname_char) != 0 {
          aname_end = aname_end + 1
        } else {
          break
        }
      }
      if aname_end < len {
        let ab = src.code_unit_at(aname_end)
        if ab == 0x3A {
          acolon = aname_end
          aname_end = aname_end + 1
          if aname_end < len && (lut[src.code_unit_at(aname_end)] & mask_ncname_start) != 0 {
            aname_end = aname_end + 1
            while aname_end < len {
              if (lut[src.code_unit_at(aname_end)] & mask_ncname_char) != 0 {
                aname_end = aname_end + 1
              } else {
                break
              }
            }
            if aname_end < len && (src.code_unit_at(aname_end) >= 0x80 || src.code_unit_at(aname_end) == 0x3A) {
              let qn = scan_qname(src, aname_start, len)
              aname_end = qn.end
              acolon = qn.colon
            }
          } else {
            let qn = scan_qname(src, aname_start, len)
            aname_end = qn.end
            acolon = qn.colon
          }
        } else if ab >= 0x80 {
          let qn = scan_qname(src, aname_start, len)
          aname_end = qn.end
          acolon = qn.colon
        }
      }
    } else {
      let qn = scan_qname(src, aname_start, len)
      aname_end = qn.end
      acolon = qn.colon
    }
    if aname_end < 0 {
      self.undo_ns(prev_undo_len)
      return Err(make_err(src, aname_start, XmlErrorKind::InvalidName, "invalid attribute name"))
    }
    let aname = src.slice(aname_start, aname_end)

    // O(1) duplicate raw attribute check via lazy Map when >= 8 attributes; zero-alloc span check when < 8
    match seen_attr_map {
      None => {
        if attr_count >= 8 {
          let m : Map[String, Bool] = Map::new()
          let mut mi = 0
          while mi < attr_count {
            m.set(raw_attrs[mi].name, true)
            mi = mi + 1
          }
          match m.get(aname) {
            Some(_) => {
              self.undo_ns(prev_undo_len)
              return Err(make_err(src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
            }
            None => m.set(aname, true)
          }
          seen_attr_map = Some(m)
        } else {
          let alen = aname_end - aname_start
          let mut dup_k = 0
          while dup_k < attr_count {
            let ps = attr_starts[dup_k]
            let pe = attr_ends[dup_k]
            if pe - ps == alen &&
            src.code_unit_at(ps) == cb &&
            raw_slice_eq(src, ps, pe, aname_start, aname_end) {
              self.undo_ns(prev_undo_len)
              return Err(make_err(src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
            }
            dup_k = dup_k + 1
          }
        }
      }
      Some(m) => {
        match m.get(aname) {
          Some(_) => {
            self.undo_ns(prev_undo_len)
            return Err(make_err(src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
          }
          None => m.set(aname, true)
        }
      }
    }

    i = aname_end
    if i < len && src.code_unit_at(i) <= 0x20 {
      i = skip_ws(src, i, len)
    }
    if i >= len || src.code_unit_at(i) != 0x3D {
      self.undo_ns(prev_undo_len)
      return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected '=' after attribute name"))
    }
    i = i + 1
    if i < len && src.code_unit_at(i) <= 0x20 {
      i = skip_ws(src, i, len)
    }
    if i >= len {
      self.undo_ns(prev_undo_len)
      return Err(make_err(src, i, XmlErrorKind::UnexpectedEof, "expected attribute quote"))
    }
    let quote = src.code_unit_at(i)
    if quote != 0x22 && quote != 0x27 {
      self.undo_ns(prev_undo_len)
      return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "attribute value must be quoted"))
    }
    i = i + 1
    let aval_start = i
    let fast_mask = if quote == 0x22 { mask_attr_dq_fast } else { mask_attr_sq_fast }
    let mut needs_unescape = false
    let mut aval = ""
    let mut aval_done = false
    while i < len {
      while i <= len - 4 {
        let m0 = lut[src.code_unit_at(i)]
        let m1 = lut[src.code_unit_at(i + 1)]
        let m2 = lut[src.code_unit_at(i + 2)]
        let m3 = lut[src.code_unit_at(i + 3)]
        if ((m0 & m1 & m2 & m3) & fast_mask) != 0 {
          i = i + 4
        } else {
          break
        }
      }
      while i < len {
        if (lut[src.code_unit_at(i)] & fast_mask) != 0 {
          i = i + 1
        } else {
          break
        }
      }
      if i >= len {
        break
      }
      let ab = src.code_unit_at(i)
      if ab == quote {
        break
      }
      if ab < 0x80 {
        if ab == 0x26 || ab == 0x09 || ab == 0x0A || ab == 0x0D {
          if no_custom_entities {
            match scan_and_unescape_attr_no_dtd(src, aval_start, i, len, quote, self.cur_entity_idx >= 0) {
              Ok((s, next_i)) => {
                aval = s
                i = next_i
                aval_done = true
                break
              }
              Err(e) => {
                self.undo_ns(prev_undo_len)
                return Err(e)
              }
            }
          }
          needs_unescape = true
          i = i + 1
        } else if ab == 0x3C {
          self.undo_ns(prev_undo_len)
          return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "'<' not allowed in attribute value"))
        } else {
          self.undo_ns(prev_undo_len)
          return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in attribute value"))
        }
      } else {
        let dec = decode_utf8_packed(src, i, len)
        if dec < 0 || !is_xml_char(dec >> 3) {
          self.undo_ns(prev_undo_len)
          return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in attribute value"))
        }
        i = i + (dec & 7)
      }
    }
    if !aval_done {
      if i >= len || src.code_unit_at(i) != quote {
        self.undo_ns(prev_undo_len)
        return Err(make_err(src, aval_start, XmlErrorKind::UnexpectedEof, "unterminated attribute value"))
      }
      let aval_end = i
      i = i + 1
      aval = if needs_unescape {
        match unescape_span(
          src,
          aval_start,
          aval_end,
          true,
          self.entities,
          self.budget,
          self.cur_entity_idx,
          self.input_stack,
        ) {
          Ok(s) => s
          Err(e) => {
            self.undo_ns(prev_undo_len)
            return Err(e)
          }
        }
      } else {
        src.slice(aval_start, aval_end)
      }
    }

    // Namespaces 1.0 declaration processing
    if cb == 0x78 &&
    ((acolon < 0 && aname_end - aname_start == 5 && raw_slice_eq_str(src, aname_start, aname_end, "xmlns")) ||
      (acolon >= 0 && acolon - aname_start == 5 && raw_slice_eq_str(src, aname_start, acolon, "xmlns"))) {
      if acolon < 0 {
        if saw_default_xmlns {
          self.undo_ns(prev_undo_len)
          return Err(make_err(src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate xmlns attribute"))
        }
        saw_default_xmlns = true
        if aval == xml_ns_uri || aval == xmlns_ns_uri {
          self.undo_ns(prev_undo_len)
          return Err(
            make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "cannot bind default namespace to reserved URI"),
          )
        }
      } else {
        let pstr = src.slice(acolon + 1, aname_end)
        if aval.length() == 0 {
          self.undo_ns(prev_undo_len)
          return Err(
            make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "prefixed namespace URI cannot be empty"),
          )
        }
        if pstr == "xmlns" {
          self.undo_ns(prev_undo_len)
          return Err(make_err(src, aname_start, XmlErrorKind::InvalidNamespace, "cannot declare prefix 'xmlns'"))
        }
        if pstr == "xml" {
          if aval != xml_ns_uri {
            self.undo_ns(prev_undo_len)
            return Err(
              make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "prefix 'xml' can only be bound to XML namespace"),
            )
          }
        } else if aval == xml_ns_uri {
          self.undo_ns(prev_undo_len)
          return Err(
            make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "only prefix 'xml' may bind to XML namespace"),
          )
        }
        if aval == xmlns_ns_uri {
          self.undo_ns(prev_undo_len)
          return Err(
            make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "no prefix may bind to xmlns namespace"),
          )
        }
        let prev_u = self.ns_map.get(pstr)
        self.ns_undo.push((pstr, prev_u))
        self.ns_map.set(pstr, aval)
      }
    } else if acolon >= 0 {
      has_prefixed_attr = true
    }

    raw_attrs.push(RawAttribute::{ name: aname, value: aval })
    if attr_count < attr_starts.length() {
      attr_starts[attr_count] = aname_start
      attr_ends[attr_count] = aname_end
      attr_colons[attr_count] = acolon
    } else {
      attr_starts.push(aname_start)
      attr_ends.push(aname_end)
      attr_colons.push(acolon)
    }
    attr_count = attr_count + 1
  }

  if !tag_closed {
    self.undo_ns(prev_undo_len)
    return Err(make_err(src, i, XmlErrorKind::UnexpectedEof, "unterminated start tag"))
  }

  // Validate element prefix is bound
  if tag_colon >= 0 {
    if !(tag_colon - tag_start == 3 && raw_slice_eq_str(src, tag_start, tag_colon, "xml")) {
      let ep = src.slice(tag_start, tag_colon)
      match self.ns_map.get(ep) {
        Some(_) => ()
        None => {
          self.undo_ns(prev_undo_len)
          return Err(
            make_err(src, tag_start, XmlErrorKind::UnboundNamespacePrefix, "unbound namespace prefix on element"),
          )
        }
      }
    }
  }

  if has_prefixed_attr {
    match self.validate_prefixed_attrs(src, attr_count, prev_undo_len) {
      Ok(()) => ()
      Err(e) => return Err(e)
    }
  }

  self.pos = i
  let se = StartElement::{
    src: src,
    name_start: tag_start,
    name_end: tag_end,
    raw_attrs: raw_attrs,
  }
  if is_empty {
    if self.ns_undo.length() > prev_undo_len {
      self.undo_ns(prev_undo_len)
    }
    if self.depth == 0 {
      self.stage = reader_stage_epilog
    }
    Ok(Event::EmptyElement(se))
  } else {
    self.stage = reader_stage_in_root
    let d = self.depth
    if d < self.tag_src.length() {
      self.tag_src[d] = src
      self.tag_start[d] = tag_start
      self.tag_end[d] = tag_end
    } else {
      self.tag_src.push(src)
      self.tag_start.push(tag_start)
      self.tag_end.push(tag_end)
    }
    self.depth = d + 1
    if self.ns_undo.length() > prev_undo_len {
      self.ns_scope_stack.push(prev_undo_len)
      self.ns_scope_stack.push(self.depth)
    }
    Ok(Event::StartElement(se))
  }
}

///| Read the next XML 1.0 event from the stream.
pub fn Reader::next_event(self : Reader) -> Result[Event, XmlError] {
  if self.done {
    return Ok(Event::Eof)
  }
  let lut = xml_lut

  while true {
    let src = self.cur_src
    let len = self.cur_len
    let mut pos = self.pos

    // End of an entity replacement frame?
    if self.cur_entity_idx >= 0 && pos >= len {
      if self.depth != self.cur_base_depth {
        return Err(make_err(src, pos, XmlErrorKind::UnclosedTag, "unbalanced markup inside entity replacement text"))
      }
      match self.input_stack.pop() {
        Some(prev) => {
          self.cur_src = prev.src
          self.pos = prev.pos
          self.cur_len = prev.len
          self.cur_entity_idx = prev.entity_idx
          self.cur_base_depth = prev.base_depth
          continue
        }
        None => {
          self.cur_entity_idx = -1
          return Ok(Event::Eof)
        }
      }
    }

    // Prolog or Epilog (outside root element)
    if self.stage != reader_stage_in_root {
      match self.next_event_outside_root() {
        Ok(Some(ev)) => return Ok(ev)
        Ok(None) => pos = self.pos
        Err(e) => return Err(e)
      }
    }

    if pos >= len {
      return Err(make_err(src, len, XmlErrorKind::UnclosedTag, "unclosed element tag"))
    }

    let b0 = src.code_unit_at(pos)
    if b0 != 0x3C {
      // Text event (stopping at `<` or at a custom DTD entity reference `&name;`)
      let has_custom_entities = !self.entities.is_empty()
      let text_start = pos
      let mut i = pos
      let mut needs_unescape = false
      let mut custom_ent_idx = -1
      let mut custom_ent_after = -1
      while i < len {
        while i <= len - 4 {
          let m0 = lut[src.code_unit_at(i)]
          let m1 = lut[src.code_unit_at(i + 1)]
          let m2 = lut[src.code_unit_at(i + 2)]
          let m3 = lut[src.code_unit_at(i + 3)]
          if ((m0 & m1 & m2 & m3) & mask_text_fast) != 0 {
            i = i + 4
          } else {
            break
          }
        }
        while i < len {
          if (lut[src.code_unit_at(i)] & mask_text_fast) != 0 {
            i = i + 1
          } else {
            break
          }
        }
        if i >= len {
          break
        }
        let b = src.code_unit_at(i)
        if b == 0x3C {
          break
        }
        if b < 0x80 {
          if b == 0x26 {
            if !has_custom_entities {
              match scan_and_unescape_text_no_dtd(src, text_start, i, len, self.cur_entity_idx >= 0) {
                Ok((s, end_i)) => {
                  self.pos = end_i
                  return Ok(Event::Text(s))
                }
                Err(e) => return Err(e)
              }
            }
            if i + 1 < len && src.code_unit_at(i + 1) != 0x23 {
              let mut semi = i + 1
              while semi < len && src.code_unit_at(semi) != 0x3B {
                semi = semi + 1
              }
              if semi < len && semi > i + 1 && lookup_predefined_entity(src, i + 1, semi) < 0 {
                match self.entities.lookup(src, i + 1, semi) {
                  Some(eidx) => {
                    custom_ent_idx = eidx
                    custom_ent_after = semi + 1
                    break
                  }
                  None =>
                  return Err(make_err(src, i, XmlErrorKind::UnknownEntity, "unknown entity reference"))
                }
              }
            }
            needs_unescape = true
            i = i + 1
          } else if b == 0x0D {
            if self.cur_entity_idx < 0 {
              if !has_custom_entities {
                match scan_and_unescape_text_no_dtd(src, text_start, i, len, false) {
                  Ok((s, end_i)) => {
                    self.pos = end_i
                    return Ok(Event::Text(s))
                  }
                  Err(e) => return Err(e)
                }
              }
              needs_unescape = true
            }
            i = i + 1
          } else if b == 0x5D {
            if i + 2 < len &&
            src.code_unit_at(i + 1) == 0x5D &&
            src.code_unit_at(i + 2) == 0x3E {
              return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "']]>' not allowed in text"))
            }
            i = i + 1
          } else {
            return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in text"))
          }
        } else {
          let dec = decode_utf8_packed(src, i, len)
          if dec < 0 || !is_xml_char(dec >> 3) {
            return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in text"))
          }
          i = i + (dec & 7)
        }
      }
      if i > text_start {
        self.pos = i
        if needs_unescape {
          match unescape_span(
            src,
            text_start,
            i,
            false,
            self.entities,
            self.budget,
            self.cur_entity_idx,
            self.input_stack,
          ) {
            Ok(s) => return Ok(Event::Text(s))
            Err(e) => return Err(e)
          }
        } else {
          return Ok(Event::Text(src.slice(text_start, i)))
        }
      }
      if custom_ent_idx >= 0 {
        match self.push_custom_entity(src, i, len, custom_ent_idx, custom_ent_after) {
          Ok(()) => continue
          Err(e) => return Err(e)
        }
      }
      continue
    }

    // Current byte is '<'
    if pos + 1 >= len {
      return Err(make_err(src, pos, XmlErrorKind::UnexpectedEof, "unexpected EOF after '<'"))
    }
    let b1 = src.code_unit_at(pos + 1)
    if b1 == 0x2F {
      // End element
      let depth = self.depth
      if depth == 0 {
        return Err(make_err(src, pos, XmlErrorKind::MismatchedTag, "unexpected end tag"))
      }
      if self.cur_entity_idx >= 0 && depth <= self.cur_base_depth {
        return Err(make_err(src, pos, XmlErrorKind::MismatchedTag, "unbalanced end tag inside entity"))
      }
      let name_start = pos + 2
      let top_idx = depth - 1
      let osrc = self.tag_src[top_idx]
      let os = self.tag_start[top_idx]
      let oe = self.tag_end[top_idx]
      let expected_end = name_start + (oe - os)
      if expected_end < len &&
      src.code_unit_at(expected_end) == 0x3E &&
      (if self.cur_entity_idx < 0 {
        raw_slice_eq(src, os, oe, name_start, expected_end)
      } else {
        str_slice_eq(osrc, os, oe, src, name_start, expected_end)
      }) {
        self.depth = top_idx
        let nsl = self.ns_scope_stack.length()
        if nsl > 0 && self.ns_scope_stack[nsl - 1] == depth {
          let _ = self.ns_scope_stack.pop()
          let prev_undo = match self.ns_scope_stack.pop() {
            Some(v) => v
            None => 0
          }
          self.undo_ns(prev_undo)
        }
        if depth == 1 {
          self.stage = reader_stage_epilog
        }
        self.pos = expected_end + 1
        return Ok(
          Event::EndElement(
            EndElement::{ src: src, name_start: name_start, name_end: expected_end },
          ),
        )
      }
      return self.handle_end_tag_slow(src, name_start, len, osrc, os, oe)
    }
    if b1 == 0x21 || b1 == 0x3F {
      return self.handle_bang_or_pi(src, pos, len, b1)
    }

    // Start or Empty element
    if self.depth >= self.opts.limits.max_depth {
      return Err(make_err(src, pos, XmlErrorKind::LimitExceeded, "max_depth limit exceeded"))
    }
    let tag_start = pos + 1
    // Inline fast ASCII QName scan for tag name (lut[128..255] == 0)
    let mut tag_end = tag_start
    let mut tag_colon = -1
    if (lut[b1] & mask_ncname_start) != 0 {
      tag_end = tag_start + 1
      while tag_end < len {
        if (lut[src.code_unit_at(tag_end)] & mask_ncname_char) != 0 {
          tag_end = tag_end + 1
        } else {
          break
        }
      }
      if tag_end < len {
        let tb = src.code_unit_at(tag_end)
        if tb == 0x3A {
          tag_colon = tag_end
          tag_end = tag_end + 1
          if tag_end < len && (lut[src.code_unit_at(tag_end)] & mask_ncname_start) != 0 {
            tag_end = tag_end + 1
            while tag_end < len {
              if (lut[src.code_unit_at(tag_end)] & mask_ncname_char) != 0 {
                tag_end = tag_end + 1
              } else {
                break
              }
            }
            if tag_end < len && (src.code_unit_at(tag_end) >= 0x80 || src.code_unit_at(tag_end) == 0x3A) {
              let qn = scan_qname(src, tag_start, len)
              tag_end = qn.end
              tag_colon = qn.colon
            }
          } else {
            let qn = scan_qname(src, tag_start, len)
            tag_end = qn.end
            tag_colon = qn.colon
          }
        } else if tb >= 0x80 {
          let qn = scan_qname(src, tag_start, len)
          tag_end = qn.end
          tag_colon = qn.colon
        }
      }
    } else {
      let qn = scan_qname(src, tag_start, len)
      tag_end = qn.end
      tag_colon = qn.colon
    }
    if tag_end < 0 {
      return Err(make_err(src, tag_start, XmlErrorKind::InvalidName, "invalid element tag name"))
    }
    if tag_colon >= 0 &&
    tag_colon - tag_start == 5 &&
    b1 == 0x78 &&
    raw_slice_eq_str(src, tag_start, tag_colon, "xmlns") {
      return Err(
        make_err(src, tag_start, XmlErrorKind::InvalidNamespace, "element cannot use 'xmlns' prefix"),
      )
    }

    let prev_undo_len = self.ns_undo.length()
    // Zero-attribute fast path (`<tag>` or `<tag/>`)
    if tag_end < len {
      let nb = src.code_unit_at(tag_end)
      if nb == 0x3E || nb == 0x2F {
        let mut is_empty = false
        let mut next_i = tag_end + 1
        if nb == 0x2F {
          if tag_end + 1 >= len || src.code_unit_at(tag_end + 1) != 0x3E {
            return Err(make_err(src, tag_end, XmlErrorKind::InvalidSyntax, "expected '>' after '/' in empty tag"))
          }
          is_empty = true
          next_i = tag_end + 2
        }
        if tag_colon >= 0 {
          if !(tag_colon - tag_start == 3 && raw_slice_eq_str(src, tag_start, tag_colon, "xml")) {
            let ep = src.slice(tag_start, tag_colon)
            match self.ns_map.get(ep) {
              Some(_) => ()
              None =>
              return Err(
                make_err(src, tag_start, XmlErrorKind::UnboundNamespacePrefix, "unbound namespace prefix on element"),
              )
            }
          }
        }
        self.pos = next_i
        let se = StartElement::{
          src: src,
          name_start: tag_start,
          name_end: tag_end,
          raw_attrs: [],
        }
        if is_empty {
          if self.depth == 0 {
            self.stage = reader_stage_epilog
          }
          return Ok(Event::EmptyElement(se))
        } else {
          self.stage = reader_stage_in_root
          let d = self.depth
          if d < self.tag_src.length() {
            self.tag_src[d] = src
            self.tag_start[d] = tag_start
            self.tag_end[d] = tag_end
          } else {
            self.tag_src.push(src)
            self.tag_start.push(tag_start)
            self.tag_end.push(tag_end)
          }
          self.depth = d + 1
          return Ok(Event::StartElement(se))
        }
      }
    }

    return self.parse_tag_with_attrs(
      src,
      tag_start,
      tag_end,
      tag_colon,
      len,
      prev_undo_len,
      lut,
    )
  }
  Ok(Event::Eof)
}
