///| Streaming XML 1.0 + Namespaces 1.0 pull parser (`Reader` / `Event`).

let reader_stage_start : Int = 0

let reader_stage_prolog : Int = 1

let reader_stage_in_root : Int = 2

let reader_stage_epilog : Int = 3

///| Create a streaming pull parser with default options.
pub fn Reader::new(src : String) -> Reader {
  Reader::with_options(src, ParseOptions::default())
}

///| Create a streaming pull parser with custom options and limits.
pub fn Reader::with_options(src : String, opts : ParseOptions) -> Reader {
  let mut start = 0
  if src.length() >= 3 &&
  src.code_unit_at(0) == 0xEF &&
  src.code_unit_at(1) == 0xBB &&
  src.code_unit_at(2) == 0xBF {
    start = 3
  }
  Reader::{
    src: src,
    pos: start,
    opts: opts,
    done: false,
    stage: reader_stage_start,
    saw_doctype: false,
    tag_stack: [],
    entities: EntityTable::new(),
    budget: EntityBudget::new(opts.limits),
    ns_map: Map::new(),
    ns_undo: [],
    ns_scope_stack: [],
    input_stack: [],
    cur_src: src,
    cur_len: src.length(),
    cur_entity_idx: -1,
    cur_base_depth: 0,
  }
}

///| Undo Reader namespace bindings back to `target_len`.
fn Reader::undo_ns(self : Reader, target_len : Int) -> Unit {
  while self.ns_undo.length() > target_len {
    match self.ns_undo.pop() {
      Some((p, Some(old_u))) => self.ns_map.set(p, old_u)
      Some((p, None)) => self.ns_map.remove(p)
      None => ()
    }
  }
}

///| Compare `s1[a_start..a_end]` with `s2[b_start..b_end]` without allocating.
fn str_slice_eq(
  s1 : String,
  a_start : Int,
  a_end : Int,
  s2 : String,
  b_start : Int,
  b_end : Int,
) -> Bool {
  let alen = a_end - a_start
  if alen != b_end - b_start {
    return false
  }
  let mut i = 0
  while i < alen {
    if s1.code_unit_at(a_start + i) != s2.code_unit_at(b_start + i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Read the next XML 1.0 event from the stream.
pub fn Reader::next_event(self : Reader) -> Result[Event, XmlError] {
  if self.done {
    return Ok(Event::Eof)
  }
  let lut = xml_lut

  while true {
    let src = self.cur_src
    let len = self.cur_len
    let mut pos = self.pos

    // End of an entity replacement frame?
    if self.cur_entity_idx >= 0 && pos >= len {
      if self.tag_stack.length() != self.cur_base_depth {
        return Err(make_err(src, pos, XmlErrorKind::UnclosedTag, "unbalanced markup inside entity replacement text"))
      }
      match self.input_stack.pop() {
        Some(prev) => {
          self.cur_src = prev.src
          self.pos = prev.pos
          self.cur_len = prev.len
          self.cur_entity_idx = prev.entity_idx
          self.cur_base_depth = prev.base_depth
          continue
        }
        None => {
          self.cur_entity_idx = -1
          return Ok(Event::Eof)
        }
      }
    }

    // Check optional XML declaration at exact start
    if self.stage == reader_stage_start {
      self.stage = reader_stage_prolog
      if pos + 5 <= len && raw_slice_eq_str(src, pos, pos + 5, "<?xml") {
        let next_b = if pos + 5 < len { src.code_unit_at(pos + 5) } else { 0 }
        if next_b == 0x20 ||
        next_b == 0x09 ||
        next_b == 0x0A ||
        next_b == 0x0D ||
        next_b == 0x3F {
          match parse_xml_decl(src, pos, len) {
            Ok((decl, ni)) => {
              self.pos = ni
              return Ok(Event::XmlDecl(decl))
            }
            Err(e) => return Err(e)
          }
        }
      }
    }

    // Prolog or Epilog (outside root element)
    if self.tag_stack.length() == 0 {
      pos = skip_ws(src, pos, len)
      if pos >= len {
        self.pos = pos
        self.done = true
        if self.stage != reader_stage_epilog {
          return Err(make_err(src, pos, XmlErrorKind::NoRootNode, "document has no root element"))
        }
        return Ok(Event::Eof)
      }
      if src.code_unit_at(pos) != 0x3C {
        return Err(
          make_err(src, pos, XmlErrorKind::InvalidSyntax, "unexpected text outside root element"),
        )
      }
      if pos + 1 >= len {
        return Err(make_err(src, pos, XmlErrorKind::UnexpectedEof, "unexpected EOF after '<'"))
      }
      let b1 = src.code_unit_at(pos + 1)
      if b1 == 0x21 {
        if pos + 4 <= len && raw_slice_eq_str(src, pos, pos + 4, "<!--") {
          match scan_comment(src, pos + 4, len) {
            Ok((cs, ce, has_cr, ni)) => {
              self.pos = ni
              let text = if has_cr {
                normalize_eol(src, cs, ce)
              } else {
                src.slice(cs, ce)
              }
              return Ok(Event::Comment(text))
            }
            Err(e) => return Err(e)
          }
        } else if pos + 9 <= len && raw_slice_eq_str(src, pos, pos + 9, "<!DOCTYPE") {
          if self.stage == reader_stage_epilog {
            return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "DOCTYPE not allowed after root element"))
          }
          if self.saw_doctype {
            return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "multiple DOCTYPE declarations"))
          }
          if !self.opts.allow_dtd {
            return Err(make_err(src, pos, XmlErrorKind::DtdDetected, "DTD is disabled by default"))
          }
          self.saw_doctype = true
          match parse_doctype(src, pos + 9, len, self.entities) {
            Ok((ds, de, ni)) => {
              self.pos = ni
              return Ok(Event::DocType(src.slice(ds, de)))
            }
            Err(e) => return Err(e)
          }
        } else if pos + 9 <= len && raw_slice_eq_str(src, pos, pos + 9, "<![CDATA[") {
          return Err(make_err(src, pos, XmlErrorKind::InvalidCData, "CDATA not allowed outside root element"))
        } else {
          return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "invalid markup in prolog/epilog"))
        }
      } else if b1 == 0x3F {
        match scan_pi(src, pos + 2, len) {
          Ok((ts, te, vs, ve, has_val, has_cr, ni)) => {
            self.pos = ni
            let target = src.slice(ts, te)
            let value = if !has_val {
              None
            } else if has_cr {
              Some(normalize_eol(src, vs, ve))
            } else {
              Some(src.slice(vs, ve))
            }
            return Ok(Event::ProcessingInstruction(PI::{ target: target, value: value }))
          }
          Err(e) => return Err(e)
        }
      } else if b1 == 0x2F {
        return Err(make_err(src, pos, XmlErrorKind::MismatchedTag, "unexpected end tag at root level"))
      } else if self.stage == reader_stage_epilog {
        return Err(make_err(src, pos, XmlErrorKind::MultipleRootNodes, "multiple root elements"))
      }
    }

    // Inside element (or starting root element)
    if pos >= len {
      return Err(make_err(src, len, XmlErrorKind::UnclosedTag, "unclosed element tag"))
    }

    if src.code_unit_at(pos) != 0x3C {
      // Text event (stopping at `<` or at a custom DTD entity reference `&name;`)
      let has_custom_entities = !self.entities.is_empty()
      let text_start = pos
      let mut i = pos
      let mut needs_unescape = false
      let mut custom_ent_idx = -1
      let mut custom_ent_after = -1
      while i < len {
        while i <= len - 4 {
          let m0 = lut[src.code_unit_at(i)]
          let m1 = lut[src.code_unit_at(i + 1)]
          let m2 = lut[src.code_unit_at(i + 2)]
          let m3 = lut[src.code_unit_at(i + 3)]
          if ((m0 & m1 & m2 & m3) & mask_text_fast) != 0 {
            i = i + 4
          } else {
            break
          }
        }
        if i >= len {
          break
        }
        let b = src.code_unit_at(i)
        if b == 0x3C {
          break
        }
        if b < 0x80 {
          if (lut[b] & mask_text_fast) != 0 {
            i = i + 1
          } else if b == 0x26 {
            if has_custom_entities && i + 1 < len && src.code_unit_at(i + 1) != 0x23 {
              let mut semi = i + 1
              while semi < len && src.code_unit_at(semi) != 0x3B {
                semi = semi + 1
              }
              if semi < len && semi > i + 1 && lookup_predefined_entity(src, i + 1, semi) < 0 {
                match self.entities.lookup(src, i + 1, semi) {
                  Some(eidx) => {
                    custom_ent_idx = eidx
                    custom_ent_after = semi + 1
                    break
                  }
                  None =>
                  return Err(make_err(src, i, XmlErrorKind::UnknownEntity, "unknown entity reference"))
                }
              }
            }
            needs_unescape = true
            i = i + 1
          } else if b == 0x0D {
            if self.cur_entity_idx < 0 {
              needs_unescape = true
            }
            i = i + 1
          } else if b == 0x5D {
            if i + 2 < len &&
            src.code_unit_at(i + 1) == 0x5D &&
            src.code_unit_at(i + 2) == 0x3E {
              return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "']]>' not allowed in text"))
            }
            i = i + 1
          } else {
            return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in text"))
          }
        } else {
          let (cp, blen) = decode_utf8(src, i, len)
          if cp < 0 || !is_xml_char(cp) {
            return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in text"))
          }
          i = i + blen
        }
      }
      if i > text_start {
        self.pos = i
        if needs_unescape {
          match unescape_span(
            src,
            text_start,
            i,
            false,
            self.entities,
            self.budget,
            self.cur_entity_idx,
            self.input_stack,
          ) {
            Ok(s) => return Ok(Event::Text(s))
            Err(e) => return Err(e)
          }
        } else {
          return Ok(Event::Text(src.slice(text_start, i)))
        }
      }
      // We stopped immediately at a custom entity reference `&name;`!
      if custom_ent_idx >= 0 {
        let ent = self.entities.defs[custom_ent_idx]
        if ent.is_external {
          return Err(
            make_err(src, i, XmlErrorKind::ExternalEntityNotAllowed, "external entity reference is not allowed"),
          )
        }
        if self.cur_entity_idx == custom_ent_idx {
          return Err(make_err(src, i, XmlErrorKind::EntityLoop, "circular entity reference"))
        }
        let mut k = 0
        while k < self.input_stack.length() {
          if self.input_stack[k].entity_idx == custom_ent_idx {
            return Err(make_err(src, i, XmlErrorKind::EntityLoop, "circular entity reference"))
          }
          k = k + 1
        }
        self.budget.expansions = self.budget.expansions + 1
        self.budget.bytes = self.budget.bytes + ent.value.length()
        if self.budget.expansions > self.budget.max_expansions ||
        self.budget.bytes > self.budget.max_bytes {
          return Err(make_err(src, i, XmlErrorKind::LimitExceeded, "entity expansion limit exceeded"))
        }
        self.input_stack.push(
          InputFrame::{
            src: src,
            pos: custom_ent_after,
            len: len,
            entity_idx: self.cur_entity_idx,
            base_depth: self.cur_base_depth,
          },
        )
        self.cur_src = ent.value
        self.pos = 0
        self.cur_len = ent.value.length()
        self.cur_entity_idx = custom_ent_idx
        self.cur_base_depth = self.tag_stack.length()
        continue
      }
      continue
    }

    // Current byte is '<'
    if pos + 1 >= len {
      return Err(make_err(src, pos, XmlErrorKind::UnexpectedEof, "unexpected EOF after '<'"))
    }
    let b1 = src.code_unit_at(pos + 1)
    if b1 == 0x2F {
      // End element
      if self.tag_stack.length() == 0 {
        return Err(make_err(src, pos, XmlErrorKind::MismatchedTag, "unexpected end tag"))
      }
      if self.cur_entity_idx >= 0 && self.tag_stack.length() <= self.cur_base_depth {
        return Err(make_err(src, pos, XmlErrorKind::MismatchedTag, "unbalanced end tag inside entity"))
      }
      let name_start = pos + 2
      let (osrc, os, oe) = self.tag_stack[self.tag_stack.length() - 1]
      let expected_end = name_start + (oe - os)
      if expected_end < len &&
      src.code_unit_at(expected_end) == 0x3E &&
      str_slice_eq(osrc, os, oe, src, name_start, expected_end) {
        let _ = self.tag_stack.pop()
        let prev_undo = match self.ns_scope_stack.pop() {
          Some(v) => v
          None => 0
        }
        self.undo_ns(prev_undo)
        if self.tag_stack.length() == 0 {
          self.stage = reader_stage_epilog
        }
        self.pos = expected_end + 1
        return Ok(
          Event::EndElement(
            EndElement::{ src: src, name_start: name_start, name_end: expected_end },
          ),
        )
      }
      let (name_end, _) = scan_qname(src, name_start, len)
      if name_end < 0 {
        return Err(make_err(src, name_start, XmlErrorKind::InvalidName, "invalid end tag name"))
      }
      let after_ws = skip_ws(src, name_end, len)
      if after_ws >= len || src.code_unit_at(after_ws) != 0x3E {
        return Err(make_err(src, after_ws, XmlErrorKind::InvalidSyntax, "expected '>' closing end tag"))
      }
      if !str_slice_eq(osrc, os, oe, src, name_start, name_end) {
        return Err(make_err(src, name_start, XmlErrorKind::MismatchedTag, "mismatched end tag"))
      }
      let _ = self.tag_stack.pop()
      let prev_undo = match self.ns_scope_stack.pop() {
        Some(v) => v
        None => 0
      }
      self.undo_ns(prev_undo)
      if self.tag_stack.length() == 0 {
        self.stage = reader_stage_epilog
      }
      self.pos = after_ws + 1
      return Ok(
        Event::EndElement(
          EndElement::{ src: src, name_start: name_start, name_end: name_end },
        ),
      )
    } else if b1 == 0x21 {
      if pos + 4 <= len && raw_slice_eq_str(src, pos, pos + 4, "<!--") {
        match scan_comment(src, pos + 4, len) {
          Ok((cs, ce, has_cr, ni)) => {
            self.pos = ni
            let text = if has_cr {
              normalize_eol(src, cs, ce)
            } else {
              src.slice(cs, ce)
            }
            return Ok(Event::Comment(text))
          }
          Err(e) => return Err(e)
        }
      } else if pos + 9 <= len && raw_slice_eq_str(src, pos, pos + 9, "<![CDATA[") {
        match scan_cdata(src, pos + 9, len) {
          Ok((cs, ce, has_cr, ni)) => {
            self.pos = ni
            let text = if has_cr {
              normalize_eol(src, cs, ce)
            } else {
              src.slice(cs, ce)
            }
            return Ok(Event::CData(text))
          }
          Err(e) => return Err(e)
        }
      } else {
        return Err(make_err(src, pos, XmlErrorKind::InvalidSyntax, "unexpected '<!' inside element"))
      }
    } else if b1 == 0x3F {
      match scan_pi(src, pos + 2, len) {
        Ok((ts, te, vs, ve, has_val, has_cr, ni)) => {
          self.pos = ni
          let target = src.slice(ts, te)
          let value = if !has_val {
            None
          } else if has_cr {
            Some(normalize_eol(src, vs, ve))
          } else {
            Some(src.slice(vs, ve))
          }
          return Ok(Event::ProcessingInstruction(PI::{ target: target, value: value }))
        }
        Err(e) => return Err(e)
      }
    }

    // Start or Empty element
    if self.tag_stack.length() >= self.opts.limits.max_depth {
      return Err(make_err(src, pos, XmlErrorKind::LimitExceeded, "max_depth limit exceeded"))
    }
    let tag_start = pos + 1
    let (tag_end, tag_colon) = scan_qname(src, tag_start, len)
    if tag_end < 0 {
      return Err(make_err(src, tag_start, XmlErrorKind::InvalidName, "invalid element tag name"))
    }
    if tag_colon >= 0 &&
    tag_colon - tag_start == 5 &&
    src.code_unit_at(tag_start) == 0x78 &&
    raw_slice_eq_str(src, tag_start, tag_colon, "xmlns") {
      return Err(
        make_err(src, tag_start, XmlErrorKind::InvalidNamespace, "element cannot use 'xmlns' prefix"),
      )
    }

    let mut i = tag_end
    let raw_attrs : Array[RawAttribute] = []
    let attr_spans : Array[(Int, Int, Int)] = [] // (name_start, name_end, colon_pos)
    let mut is_empty = false
    let mut tag_closed = false
    let max_attributes = self.opts.limits.max_attributes
    let prev_undo_len = self.ns_undo.length()
    let mut saw_default_xmlns = false
    let mut has_prefixed_attr = false
    let mut seen_attr_map : Map[String, Bool] = Map::new()
    let mut use_attr_map = false

    // Zero-attribute fast path (`<tag>` or `<tag/>`)
    let mut scan_attrs = true
    if i < len {
      let nb = src.code_unit_at(i)
      if nb == 0x3E {
        i = i + 1
        scan_attrs = false
        tag_closed = true
      } else if nb == 0x2F {
        if i + 1 >= len || src.code_unit_at(i + 1) != 0x3E {
          return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected '>' after '/' in empty tag"))
        }
        is_empty = true
        i = i + 2
        scan_attrs = false
        tag_closed = true
      }
    }

    while scan_attrs && i < len {
      let ws_before = i
      let b_ws = src.code_unit_at(i)
      if b_ws == 0x20 {
        i = i + 1
        if i < len && src.code_unit_at(i) <= 0x20 {
          i = skip_ws(src, i, len)
        }
      } else if b_ws <= 0x20 {
        i = skip_ws(src, i, len)
      }
      if i >= len {
        self.undo_ns(prev_undo_len)
        return Err(make_err(src, i, XmlErrorKind::UnexpectedEof, "unterminated start tag"))
      }
      let cb = src.code_unit_at(i)
      if cb == 0x3E {
        i = i + 1
        tag_closed = true
        break
      }
      if cb == 0x2F {
        if i + 1 >= len || src.code_unit_at(i + 1) != 0x3E {
          self.undo_ns(prev_undo_len)
          return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected '>' after '/' in empty tag"))
        }
        is_empty = true
        i = i + 2
        tag_closed = true
        break
      }
      if i == ws_before {
        self.undo_ns(prev_undo_len)
        return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected whitespace before attribute"))
      }
      if raw_attrs.length() >= max_attributes {
        self.undo_ns(prev_undo_len)
        return Err(make_err(src, i, XmlErrorKind::LimitExceeded, "max_attributes limit exceeded"))
      }
      let aname_start = i
      let (aname_end, acolon) = scan_qname(src, aname_start, len)
      if aname_end < 0 {
        self.undo_ns(prev_undo_len)
        return Err(make_err(src, aname_start, XmlErrorKind::InvalidName, "invalid attribute name"))
      }
      let aname = src.slice(aname_start, aname_end)

      // O(1) duplicate raw attribute check via lazy Map when >= 8 attributes; span prefilter when < 8
      if !use_attr_map {
        if raw_attrs.length() >= 8 {
          use_attr_map = true
          seen_attr_map = Map::new()
          let mut mi = 0
          while mi < raw_attrs.length() {
            seen_attr_map.set(raw_attrs[mi].name, true)
            mi = mi + 1
          }
          match seen_attr_map.get(aname) {
            Some(_) => {
              self.undo_ns(prev_undo_len)
              return Err(make_err(src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
            }
            None => seen_attr_map.set(aname, true)
          }
        } else {
          let alen = aname_end - aname_start
          let a0 = src.code_unit_at(aname_start)
          let mut dup_k = 0
          while dup_k < attr_spans.length() {
            let (ps, pe, _) = attr_spans[dup_k]
            if pe - ps == alen &&
            src.code_unit_at(ps) == a0 &&
            raw_slice_eq(src, ps, pe, aname_start, aname_end) {
              self.undo_ns(prev_undo_len)
              return Err(make_err(src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
            }
            dup_k = dup_k + 1
          }
        }
      } else {
        match seen_attr_map.get(aname) {
          Some(_) => {
            self.undo_ns(prev_undo_len)
            return Err(make_err(src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
          }
          None => seen_attr_map.set(aname, true)
        }
      }

      i = aname_end
      if i < len && src.code_unit_at(i) <= 0x20 {
        i = skip_ws(src, i, len)
      }
      if i >= len || src.code_unit_at(i) != 0x3D {
        self.undo_ns(prev_undo_len)
        return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "expected '=' after attribute name"))
      }
      i = i + 1
      if i < len && src.code_unit_at(i) <= 0x20 {
        i = skip_ws(src, i, len)
      }
      if i >= len {
        self.undo_ns(prev_undo_len)
        return Err(make_err(src, i, XmlErrorKind::UnexpectedEof, "expected attribute quote"))
      }
      let quote = src.code_unit_at(i)
      if quote != 0x22 && quote != 0x27 {
        self.undo_ns(prev_undo_len)
        return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "attribute value must be quoted"))
      }
      i = i + 1
      let aval_start = i
      let fast_mask = if quote == 0x22 { mask_attr_dq_fast } else { mask_attr_sq_fast }
      let mut needs_unescape = false
      while i < len {
        while i <= len - 4 {
          let m0 = lut[src.code_unit_at(i)]
          let m1 = lut[src.code_unit_at(i + 1)]
          let m2 = lut[src.code_unit_at(i + 2)]
          let m3 = lut[src.code_unit_at(i + 3)]
          if ((m0 & m1 & m2 & m3) & fast_mask) != 0 {
            i = i + 4
          } else {
            break
          }
        }
        if i >= len {
          break
        }
        let ab = src.code_unit_at(i)
        if ab == quote {
          break
        }
        if ab < 0x80 {
          if (lut[ab] & fast_mask) != 0 {
            i = i + 1
          } else if ab == 0x26 || ab == 0x09 || ab == 0x0A || ab == 0x0D {
            needs_unescape = true
            i = i + 1
          } else if ab == 0x3C {
            self.undo_ns(prev_undo_len)
            return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "'<' not allowed in attribute value"))
          } else {
            self.undo_ns(prev_undo_len)
            return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in attribute value"))
          }
        } else {
          let (cp, blen) = decode_utf8(src, i, len)
          if cp < 0 || !is_xml_char(cp) {
            self.undo_ns(prev_undo_len)
            return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in attribute value"))
          }
          i = i + blen
        }
      }
      if i >= len || src.code_unit_at(i) != quote {
        self.undo_ns(prev_undo_len)
        return Err(make_err(src, aval_start, XmlErrorKind::UnexpectedEof, "unterminated attribute value"))
      }
      let aval_end = i
      i = i + 1
      let aval = if needs_unescape {
        match unescape_span(
          src,
          aval_start,
          aval_end,
          true,
          self.entities,
          self.budget,
          self.cur_entity_idx,
          self.input_stack,
        ) {
          Ok(s) => s
          Err(e) => {
            self.undo_ns(prev_undo_len)
            return Err(e)
          }
        }
      } else {
        src.slice(aval_start, aval_end)
      }

      // Namespaces 1.0 declaration processing
      let is_default_xmlns = acolon < 0 &&
      aname_end - aname_start == 5 &&
      cb == 0x78 &&
      raw_slice_eq_str(src, aname_start, aname_end, "xmlns")
      let is_prefixed_xmlns = acolon >= 0 &&
      acolon - aname_start == 5 &&
      cb == 0x78 &&
      raw_slice_eq_str(src, aname_start, acolon, "xmlns")

      if is_default_xmlns {
        if saw_default_xmlns {
          self.undo_ns(prev_undo_len)
          return Err(make_err(src, aname_start, XmlErrorKind::DuplicateAttribute, "duplicate xmlns attribute"))
        }
        saw_default_xmlns = true
        if aval == xml_ns_uri || aval == xmlns_ns_uri {
          self.undo_ns(prev_undo_len)
          return Err(
            make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "cannot bind default namespace to reserved URI"),
          )
        }
      } else if is_prefixed_xmlns {
        let pstr = src.slice(acolon + 1, aname_end)
        if aval.length() == 0 {
          self.undo_ns(prev_undo_len)
          return Err(
            make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "prefixed namespace URI cannot be empty"),
          )
        }
        if pstr == "xmlns" {
          self.undo_ns(prev_undo_len)
          return Err(make_err(src, aname_start, XmlErrorKind::InvalidNamespace, "cannot declare prefix 'xmlns'"))
        }
        if pstr == "xml" {
          if aval != xml_ns_uri {
            self.undo_ns(prev_undo_len)
            return Err(
              make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "prefix 'xml' can only be bound to XML namespace"),
            )
          }
        } else if aval == xml_ns_uri {
          self.undo_ns(prev_undo_len)
          return Err(
            make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "only prefix 'xml' may bind to XML namespace"),
          )
        }
        if aval == xmlns_ns_uri {
          self.undo_ns(prev_undo_len)
          return Err(
            make_err(src, aval_start, XmlErrorKind::InvalidNamespace, "no prefix may bind to xmlns namespace"),
          )
        }
        let prev_u = self.ns_map.get(pstr)
        self.ns_undo.push((pstr, prev_u))
        self.ns_map.set(pstr, aval)
      } else if acolon >= 0 {
        has_prefixed_attr = true
      }

      raw_attrs.push(RawAttribute::{ name: aname, value: aval })
      attr_spans.push((aname_start, aname_end, acolon))
    }

    if !tag_closed {
      self.undo_ns(prev_undo_len)
      return Err(make_err(src, i, XmlErrorKind::UnexpectedEof, "unterminated start tag"))
    }

    // Validate element prefix is bound
    if tag_colon >= 0 {
      if !(tag_colon - tag_start == 3 && raw_slice_eq_str(src, tag_start, tag_colon, "xml")) {
        let ep = src.slice(tag_start, tag_colon)
        match self.ns_map.get(ep) {
          Some(_) => ()
          None => {
            self.undo_ns(prev_undo_len)
            return Err(
              make_err(src, tag_start, XmlErrorKind::UnboundNamespacePrefix, "unbound namespace prefix on element"),
            )
          }
        }
      }
    }

    // Validate prefixed attributes: bound prefix + no duplicate expanded (uri, local) name
    if has_prefixed_attr {
      let expanded : Array[(String, Int, Int)] = []
      let mut ai = 0
      while ai < attr_spans.length() {
        let (as_, ae, ac) = attr_spans[ai]
        if ac >= 0 && !(ac - as_ == 5 && raw_slice_eq_str(src, as_, ac, "xmlns")) {
          let uri = if ac - as_ == 3 && raw_slice_eq_str(src, as_, ac, "xml") {
            xml_ns_uri
          } else {
            let ap = src.slice(as_, ac)
            match self.ns_map.get(ap) {
              Some(u) => u
              None => {
                self.undo_ns(prev_undo_len)
                return Err(
                  make_err(src, as_, XmlErrorKind::UnboundNamespacePrefix, "unbound namespace prefix on attribute"),
                )
              }
            }
          }
          let ls = ac + 1
          let le = ae
          let llen = le - ls
          let l0 = src.code_unit_at(ls)
          let mut ej = 0
          while ej < expanded.length() {
            let (pu, pls, ple) = expanded[ej]
            if ple - pls == llen &&
            src.code_unit_at(pls) == l0 &&
            raw_slice_eq(src, pls, ple, ls, le) &&
            pu == uri {
              self.undo_ns(prev_undo_len)
              return Err(make_err(src, as_, XmlErrorKind::DuplicateAttribute, "duplicate attribute"))
            }
            ej = ej + 1
          }
          expanded.push((uri, ls, le))
        }
        ai = ai + 1
      }
    }

    self.pos = i
    let se = StartElement::{
      src: src,
      name_start: tag_start,
      name_end: tag_end,
      raw_attrs: raw_attrs,
    }
    if is_empty {
      self.undo_ns(prev_undo_len)
      if self.tag_stack.length() == 0 {
        self.stage = reader_stage_epilog
      }
      return Ok(Event::EmptyElement(se))
    } else {
      self.stage = reader_stage_in_root
      self.ns_scope_stack.push(prev_undo_len)
      self.tag_stack.push((src, tag_start, tag_end))
      return Ok(Event::StartElement(se))
    }
  }
  Ok(Event::Eof)
}
