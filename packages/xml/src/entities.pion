///| Entity definitions, character references, and bounded iterative entity expansion (immune to Billion Laughs & cycles).

struct EntityDef {
  name : String
  value : String
  is_external : Bool
}

struct EntityTable {
  defs : Array[EntityDef]
  by_name : Map[String, Int]
}

fn EntityTable::new() -> EntityTable {
  EntityTable::{ defs: [], by_name: Map::new() }
}

fn EntityTable::is_empty(self : EntityTable) -> Bool {
  self.defs.length() == 0
}

///| Insert an entity definition following XML 1.0 §4.2 first-definition-wins in O(1).
fn EntityTable::insert_if_absent(
  self : EntityTable,
  name : String,
  value : String,
  is_external : Bool,
) -> Unit {
  match self.by_name.get(name) {
    Some(_) => ()
    None => {
      let idx = self.defs.length()
      self.defs.push(EntityDef::{ name: name, value: value, is_external: is_external })
      self.by_name.set(name, idx)
    }
  }
}

///| Look up a custom DTD entity by slice `src[start..end]` in O(1).
fn EntityTable::lookup(
  self : EntityTable,
  src : String,
  start : Int,
  end : Int,
) -> Option[Int] {
  if self.defs.length() == 0 {
    return None
  }
  self.by_name.get(src.slice(start, end))
}

struct EntityBudget {
  mut expansions : Int
  mut bytes : Int
  max_expansions : Int
  max_bytes : Int
}

fn EntityBudget::new(limits : Limits) -> EntityBudget {
  EntityBudget::{
    expansions: 0,
    bytes: 0,
    max_expansions: limits.max_entity_expansions,
    max_bytes: limits.max_entity_bytes,
  }
}

///| Input source frame for iterative entity content parsing (XML 1.0 §4.4.2 / §4.3.2).
struct InputFrame {
  src : String
  pos : Int
  len : Int
  entity_idx : Int
  base_depth : Int
}

///| Parse a character reference starting after `&#` (at `pos`).
///| Returns `(codepoint, next_pos_after_semicolon)`.
fn parse_char_ref(
  src : String,
  pos : Int,
  len : Int,
  err_offset : Int,
) -> Result[(Int, Int), XmlError] {
  if pos >= len {
    return Err(
      make_err(src, err_offset, XmlErrorKind::InvalidCharRef, "unterminated character reference"),
    )
  }
  let mut i = pos
  let mut cp = 0
  if src.code_unit_at(i) == 0x78 {
    // Hexadecimal: &#x[0-9a-fA-F]+;
    i = i + 1
    let start = i
    while i < len {
      let b = src.code_unit_at(i)
      if b == 0x3B {
        break
      }
      let d = if b >= 0x30 && b <= 0x39 {
        b - 0x30
      } else if b >= 0x61 && b <= 0x66 {
        b - 0x61 + 10
      } else if b >= 0x41 && b <= 0x46 {
        b - 0x41 + 10
      } else {
        return Err(
          make_err(src, i, XmlErrorKind::InvalidCharRef, "invalid hex digit in character reference"),
        )
      }
      if cp <= 0x10FFFF {
        cp = (cp << 4) | d
      }
      i = i + 1
    }
    if i == start || i >= len || src.code_unit_at(i) != 0x3B {
      return Err(
        make_err(src, err_offset, XmlErrorKind::InvalidCharRef, "invalid hex character reference"),
      )
    }
  } else {
    // Decimal: &#[0-9]+;
    let start = i
    while i < len {
      let b = src.code_unit_at(i)
      if b == 0x3B {
        break
      }
      if b < 0x30 || b > 0x39 {
        return Err(
          make_err(src, i, XmlErrorKind::InvalidCharRef, "invalid decimal digit in character reference"),
        )
      }
      if cp <= 0x10FFFF {
        cp = cp * 10 + (b - 0x30)
      }
      i = i + 1
    }
    if i == start || i >= len || src.code_unit_at(i) != 0x3B {
      return Err(
        make_err(src, err_offset, XmlErrorKind::InvalidCharRef, "invalid decimal character reference"),
      )
    }
  }
  if !is_xml_char(cp) {
    return Err(
      make_err(src, err_offset, XmlErrorKind::InvalidCharRef, "character reference resolves to illegal XML 1.0 codepoint"),
    )
  }
  Ok((cp, i + 1))
}

///| Look up a predefined XML 1.0 entity (`lt`, `gt`, `amp`, `quot`, `apos`) by slice `src[start..end]`.
///| Returns its ASCII byte value or `-1` if not predefined.
fn lookup_predefined_entity(src : String, start : Int, end : Int) -> Int {
  let n = end - start
  if n == 2 {
    let b0 = src.code_unit_at(start)
    let b1 = src.code_unit_at(start + 1)
    if b0 == 0x6C && b1 == 0x74 {
      return 0x3C // <
    }
    if b0 == 0x67 && b1 == 0x74 {
      return 0x3E // >
    }
  } else if n == 3 {
    if src.code_unit_at(start) == 0x61 &&
    src.code_unit_at(start + 1) == 0x6D &&
    src.code_unit_at(start + 2) == 0x70 {
      return 0x26 // &
    }
  } else if n == 4 {
    let b0 = src.code_unit_at(start)
    let b1 = src.code_unit_at(start + 1)
    let b2 = src.code_unit_at(start + 2)
    let b3 = src.code_unit_at(start + 3)
    if b0 == 0x71 && b1 == 0x75 && b2 == 0x6F && b3 == 0x74 {
      return 0x22 // "
    }
    if b0 == 0x61 && b1 == 0x70 && b2 == 0x6F && b3 == 0x73 {
      return 0x27 // '
    }
  }
  -1
}

///| Expand an EntityValue literal at declaration time per XML 1.0 §4.5:
///| - Validates all characters are legal XML 1.0 Chars (§2.2).
///| - Normalizes raw source EOLs (`\r\n`, `\r` -> `\n`) (§2.11).
///| - Expands character references (`&#...;`, `&#x...;`) immediately (§4.5).
///| - Rejects parameter entity references (`%...;`) in internal subset (§2.8 WFC).
///| - Validates syntax of general entity references (`&Name;`) while bypassing them.
fn process_entity_value(
  src : String,
  start : Int,
  end : Int,
) -> Result[String, XmlError] {
  let sb = StringBuilder::with_capacity(end - start)
  let mut i = start
  let mut mark = start
  while i < end {
    let b = src.code_unit_at(i)
    if b == 0x26 {
      // '&'
      if i + 1 >= end {
        return Err(make_err(src, i, XmlErrorKind::InvalidSyntax, "unterminated reference in entity value"))
      }
      if src.code_unit_at(i + 1) == 0x23 {
        // Character reference: expand immediately (§4.5)
        if i > mark {
          sb.write_substring(src, mark, i)
        }
        match parse_char_ref(src, i + 2, end, i) {
          Ok((cp, next_i)) => {
            encode_utf8(sb, cp)
            i = next_i
            mark = i
          }
          Err(e) => return Err(e)
        }
      } else {
        // General entity reference: bypass (keep literal) but validate syntax `&Name;`
        let name_start = i + 1
        let name_end = scan_ncname(src, name_start, end)
        if name_end < 0 || name_end >= end || src.code_unit_at(name_end) != 0x3B {
          return Err(
            make_err(src, i, XmlErrorKind::InvalidSyntax, "invalid entity reference in entity value"),
          )
        }
        i = name_end + 1
      }
    } else if b == 0x25 {
      // '%' — Parameter entity reference forbidden inside internal subset markup declarations
      return Err(
        make_err(src, i, XmlErrorKind::InvalidSyntax, "parameter entity reference not allowed in internal subset entity value"),
      )
    } else if b == 0x0D {
      // Normalize raw source CR / CRLF -> LF (§2.11)
      if i > mark {
        sb.write_substring(src, mark, i)
      }
      sb.write_byte((0x0A).to_byte())
      if i + 1 < end && src.code_unit_at(i + 1) == 0x0A {
        i = i + 2
      } else {
        i = i + 1
      }
      mark = i
    } else if b < 0x80 {
      if (xml_lut[b] & mask_valid_ascii) == 0 {
        return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in entity value"))
      }
      i = i + 1
    } else {
      let (cp, blen) = decode_utf8(src, i, end)
      if cp < 0 || !is_xml_char(cp) {
        return Err(make_err(src, i, XmlErrorKind::InvalidChar, "illegal XML 1.0 character in entity value"))
      }
      i = i + blen
    }
  }
  if end > mark {
    sb.write_substring(src, mark, end)
  }
  Ok(sb.to_string())
}

///| Frame for iterative entity expansion in attribute values (zero recursion, cycle detection).
struct ExpandFrame {
  text : String
  mut pos : Int
  end : Int
  entity_idx : Int
}

///| Fast zero-stack unescape for the common case where no custom DTD entities exist.
fn unescape_span_no_dtd(
  src : String,
  start : Int,
  end : Int,
  is_attr : Bool,
  in_entity : Bool,
) -> Result[String, XmlError] {
  let lut = xml_lut
  let sb = StringBuilder::with_capacity(end - start)
  let mut i = start
  let mut mark = start
  let fast_mask = if is_attr { mask_attr_dq_fast } else { mask_text_fast }
  while i < end {
    while i <= end - 4 {
      let m0 = lut[src.code_unit_at(i)]
      let m1 = lut[src.code_unit_at(i + 1)]
      let m2 = lut[src.code_unit_at(i + 2)]
      let m3 = lut[src.code_unit_at(i + 3)]
      if ((m0 & m1 & m2 & m3) & fast_mask) != 0 {
        i = i + 4
      } else {
        break
      }
    }
    if i >= end {
      break
    }
    let b = src.code_unit_at(i)
    if b == 0x26 {
      if i > mark {
        sb.write_substring(src, mark, i)
      }
      let amp_pos = i
      i = i + 1
      if i >= end {
        return Err(
          make_err(src, amp_pos, XmlErrorKind::InvalidSyntax, "unterminated entity reference"),
        )
      }
      if src.code_unit_at(i) == 0x23 {
        match parse_char_ref(src, i + 1, end, amp_pos) {
          Ok((cp, next_i)) => {
            encode_utf8(sb, cp)
            i = next_i
            mark = i
          }
          Err(e) => return Err(e)
        }
      } else {
        let name_start = i
        let mut semi = i
        while semi < end && src.code_unit_at(semi) != 0x3B {
          semi = semi + 1
        }
        if semi >= end || semi == name_start {
          return Err(
            make_err(src, amp_pos, XmlErrorKind::InvalidSyntax, "unterminated or empty entity reference"),
          )
        }
        let pre = lookup_predefined_entity(src, name_start, semi)
        if pre >= 0 {
          sb.write_byte(pre.to_byte())
          i = semi + 1
          mark = i
        } else {
          return Err(
            make_err(src, amp_pos, XmlErrorKind::UnknownEntity, "unknown entity reference"),
          )
        }
      }
    } else if b == 0x0D {
      if in_entity && !is_attr {
        // CR inside entity replacement text came from &#13;; preserve in text content!
        i = i + 1
      } else {
        if i > mark {
          sb.write_substring(src, mark, i)
        }
        if is_attr {
          sb.write_byte((0x20).to_byte())
          if !in_entity && i + 1 < end && src.code_unit_at(i + 1) == 0x0A {
            i = i + 2
          } else {
            i = i + 1
          }
        } else {
          sb.write_byte((0x0A).to_byte())
          if i + 1 < end && src.code_unit_at(i + 1) == 0x0A {
            i = i + 2
          } else {
            i = i + 1
          }
        }
        mark = i
      }
    } else if is_attr && (b == 0x09 || b == 0x0A) {
      if i > mark {
        sb.write_substring(src, mark, i)
      }
      sb.write_byte((0x20).to_byte())
      i = i + 1
      mark = i
    } else if is_attr && b == 0x3C {
      return Err(
        make_err(src, i, XmlErrorKind::InvalidSyntax, "'<' not allowed in attribute value"),
      )
    } else {
      i = i + 1
    }
  }
  if end > mark {
    sb.write_substring(src, mark, end)
  }
  Ok(sb.to_string())
}

///| Normalize & unescape `src[start..end]` into a `String`.
///| `is_attr`: when true, literal `\t`, `\n`, `\r`, `\r\n` become `0x20` (while direct char refs keep exact codepoints).
///| Inside entity frames (`entity_idx >= 0`), `\r` and `\n` each normalize to `0x20` individually in attributes,
///| and `\r` is preserved in text content.
fn unescape_span(
  src : String,
  start : Int,
  end : Int,
  is_attr : Bool,
  entities : EntityTable,
  budget : EntityBudget,
  cur_entity_idx : Int,
  active_entity_frames : Array[InputFrame],
) -> Result[String, XmlError] {
  if entities.is_empty() {
    return unescape_span_no_dtd(src, start, end, is_attr, cur_entity_idx >= 0)
  }
  let sb = StringBuilder::with_capacity(end - start)
  let stack : Array[ExpandFrame] = [
    ExpandFrame::{ text: src, pos: start, end: end, entity_idx: cur_entity_idx },
  ]
  while stack.length() > 0 {
    let top_idx = stack.length() - 1
    let frame = stack[top_idx]
    let s = frame.text
    let mut i = frame.pos
    let flen = frame.end
    let in_ent = frame.entity_idx >= 0
    let mut mark = i
    let mut pushed_child = false
    while i < flen {
      let b = s.code_unit_at(i)
      if b == 0x26 {
        // '&'
        if i > mark {
          sb.write_substring(s, mark, i)
        }
        let amp_pos = i
        i = i + 1
        if i >= flen {
          return Err(
            make_err(src, start, XmlErrorKind::InvalidSyntax, "unterminated entity reference"),
          )
        }
        if s.code_unit_at(i) == 0x23 {
          // Character reference &#...;
          match parse_char_ref(s, i + 1, flen, amp_pos) {
            Ok((cp, next_i)) => {
              encode_utf8(sb, cp)
              i = next_i
              mark = i
            }
            Err(e) => return Err(e)
          }
        } else {
          // Named entity reference &name;
          let name_start = i
          let mut semi = i
          while semi < flen && s.code_unit_at(semi) != 0x3B {
            semi = semi + 1
          }
          if semi >= flen || semi == name_start {
            return Err(
              make_err(src, start, XmlErrorKind::InvalidSyntax, "unterminated or empty entity reference"),
            )
          }
          let pre = lookup_predefined_entity(s, name_start, semi)
          if pre >= 0 {
            sb.write_byte(pre.to_byte())
            i = semi + 1
            mark = i
          } else {
            match entities.lookup(s, name_start, semi) {
              Some(eidx) => {
                let ent = entities.defs[eidx]
                if ent.is_external {
                  return Err(
                    make_err(src, start, XmlErrorKind::ExternalEntityNotAllowed, "external entity reference is not allowed"),
                  )
                }
                // Check cycle against both local expand stack and outer InputFrame stack
                let mut k = 0
                while k < stack.length() {
                  if stack[k].entity_idx == eidx {
                    return Err(
                      make_err(src, start, XmlErrorKind::EntityLoop, "circular entity reference"),
                    )
                  }
                  k = k + 1
                }
                k = 0
                while k < active_entity_frames.length() {
                  if active_entity_frames[k].entity_idx == eidx {
                    return Err(
                      make_err(src, start, XmlErrorKind::EntityLoop, "circular entity reference"),
                    )
                  }
                  k = k + 1
                }
                budget.expansions = budget.expansions + 1
                let eval = ent.value
                budget.bytes = budget.bytes + eval.length()
                if budget.expansions > budget.max_expansions ||
                budget.bytes > budget.max_bytes {
                  return Err(
                    make_err(src, start, XmlErrorKind::LimitExceeded, "entity expansion limit exceeded"),
                  )
                }
                frame.pos = semi + 1
                stack.push(
                  ExpandFrame::{
                    text: eval,
                    pos: 0,
                    end: eval.length(),
                    entity_idx: eidx,
                  },
                )
                pushed_child = true
                break
              }
              None =>
              return Err(
                make_err(src, start, XmlErrorKind::UnknownEntity, "unknown entity reference"),
              )
            }
          }
        }
      } else if b == 0x0D {
        // '\r' or '\r\n'
        if in_ent && !is_attr {
          // CR inside entity replacement text (from &#13;): preserve in text content!
          i = i + 1
        } else {
          if i > mark {
            sb.write_substring(s, mark, i)
          }
          if is_attr {
            sb.write_byte((0x20).to_byte())
            // Only collapse raw source \r\n; entity replacement \r\n (from &#13;&#10;) becomes two spaces (§3.3.3)
            if !in_ent && i + 1 < flen && s.code_unit_at(i + 1) == 0x0A {
              i = i + 2
            } else {
              i = i + 1
            }
          } else {
            sb.write_byte((0x0A).to_byte())
            if i + 1 < flen && s.code_unit_at(i + 1) == 0x0A {
              i = i + 2
            } else {
              i = i + 1
            }
          }
          mark = i
        }
      } else if is_attr && (b == 0x09 || b == 0x0A) {
        if i > mark {
          sb.write_substring(s, mark, i)
        }
        sb.write_byte((0x20).to_byte())
        i = i + 1
        mark = i
      } else if is_attr && b == 0x3C {
        return Err(
          make_err(src, start, XmlErrorKind::InvalidSyntax, "'<' not allowed in attribute value"),
        )
      } else {
        i = i + 1
      }
    }
    if !pushed_child {
      if i > mark {
        sb.write_substring(s, mark, i)
      }
      let _ = stack.pop()
    }
  }
  Ok(sb.to_string())
}

///| Normalize EOLs (`\r\n` and `\r` -> `\n`) in `src[start..end]`.
fn normalize_eol(src : String, start : Int, end : Int) -> String {
  let sb = StringBuilder::with_capacity(end - start)
  let mut i = start
  let mut mark = start
  while i < end {
    if src.code_unit_at(i) == 0x0D {
      if i > mark {
        sb.write_substring(src, mark, i)
      }
      sb.write_byte((0x0A).to_byte())
      if i + 1 < end && src.code_unit_at(i + 1) == 0x0A {
        i = i + 2
      } else {
        i = i + 1
      }
      mark = i
    } else {
      i = i + 1
    }
  }
  if end > mark {
    sb.write_substring(src, mark, end)
  }
  sb.to_string()
}
