///|
pub fn Reader::new(src : String) -> Reader {
  Reader::with_options(src, ParseOptions::default())
}

///|
pub fn Reader::with_options(src : String, opts : ParseOptions) -> Reader {
  Reader::{ src: src, pos: 0, opts: opts, done: false }
}

///|
pub fn Reader::next_event(self : Reader) -> Result[Event, XmlError] {
  let _ = self
  Err(XmlError::new(XmlErrorKind::Unimplemented, 0, 1, 1, "unimplemented"))
}

///|
pub fn Writer::new() -> Writer {
  Writer::with_capacity(256)
}

///|
pub fn Writer::with_capacity(cap : Int) -> Writer {
  Writer::{
    sb: StringBuilder::with_capacity(cap),
    indent_char: (32).to_byte(),
    indent_size: 0,
    depth: 0,
    tag_stack: [],
    has_child_element: [],
    wrote_anything: false,
  }
}

///|
pub fn Writer::new_with_indent(indent_char : Byte, indent_size : Int) -> Writer {
  Writer::{
    sb: StringBuilder::with_capacity(256),
    indent_char: indent_char,
    indent_size: indent_size,
    depth: 0,
    tag_stack: [],
    has_child_element: [],
    wrote_anything: false,
  }
}

