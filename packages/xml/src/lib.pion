///| Public API stubs for `xml` (Red phase).

///|
pub fn Document::parse(src : String) -> Result[Document, XmlError] {
  Document::parse_with_options(src, ParseOptions::default())
}

///|
pub fn Document::parse_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Document, XmlError] {
  let _ = (src, opts)
  Err(XmlError::new(XmlErrorKind::Unimplemented, 0, 1, 1, "unimplemented"))
}

///|
pub fn Document::root(self : Document) -> Node {
  Node::{ doc: self, id: 0 }
}

///|
pub fn Document::root_element(self : Document) -> Node {
  Node::{ doc: self, id: self.root_elem_id }
}

///|
pub fn Document::node_count(self : Document) -> Int {
  self.nodes.length()
}

///|
pub fn Document::node(self : Document, id : Int) -> Option[Node] {
  if id >= 0 && id < self.nodes.length() {
    Some(Node::{ doc: self, id: id })
  } else {
    None
  }
}

///|
pub fn Document::descendants(self : Document) -> Array[Node] {
  let _ = self
  []
}

///|
pub fn Node::id(self : Node) -> Int {
  self.id
}

///|
pub fn Node::node_type(self : Node) -> NodeType {
  let _ = self
  NodeType::Root
}

///|
pub fn Node::is_root(self : Node) -> Bool {
  match self.node_type() {
    NodeType::Root => true
    _ => false
  }
}

///|
pub fn Node::is_element(self : Node) -> Bool {
  match self.node_type() {
    NodeType::Element => true
    _ => false
  }
}

///|
pub fn Node::is_text(self : Node) -> Bool {
  match self.node_type() {
    NodeType::Text => true
    _ => false
  }
}

///|
pub fn Node::is_comment(self : Node) -> Bool {
  match self.node_type() {
    NodeType::Comment => true
    _ => false
  }
}

///|
pub fn Node::is_pi(self : Node) -> Bool {
  match self.node_type() {
    NodeType::PI => true
    _ => false
  }
}

///|
pub fn Node::tag_name(self : Node) -> ExpandedName {
  let _ = self
  ExpandedName::{ local: "", ns_uri: None, prefix: None }
}

///|
pub fn Node::has_tag_name(self : Node, name : String) -> Bool {
  let _ = (self, name)
  false
}

///|
