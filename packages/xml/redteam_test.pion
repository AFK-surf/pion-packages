///| Day-1 red-team security & adversarial tests for `xml`.

///|
test "redteam_deep_nesting_20k_no_sigsegv" {
  // 20,000 nested <a> elements: must NEVER stack-overflow (explicit stack only).
  let depth = 20000
  let sb = StringBuilder::with_capacity(depth * 7 + 16)
  let mut i = 0
  while i < depth {
    sb.write_string("<a>")
    i = i + 1
  }
  sb.write_string("ok")
  i = 0
  while i < depth {
    sb.write_string("</a>")
    i = i + 1
  }
  let deep_xml = sb.to_string()

  // 1. Default limits reject cleanly with LimitExceeded
  match Document::parse(deep_xml) {
    Ok(_) => debug_assert(false, "default max_depth should reject 20k nesting")
    Err(e) => {
      match e.kind {
        XmlErrorKind::LimitExceeded => ()
        _ => debug_assert(false, "expected LimitExceeded, got: " + e.to_string())
      }
    }
  }

  // 2. With raised max_depth, explicit-stack parser parses 20,000 levels without stack overflow!
  let high_opts = ParseOptions::{
    allow_dtd: false,
    limits: Limits::{
      max_depth: 25000,
      max_nodes: 100000,
      max_attributes: 1024,
      max_entity_expansions: 256,
      max_entity_bytes: 65536,
    },
  }
  match Document::parse_with_options(deep_xml, high_opts) {
    Ok(doc) => {
      debug_assert(doc.node_count() == depth + 2, "root + 20k elems + 1 text")
    }
    Err(e) => debug_assert(false, "raised max_depth failed: " + e.to_string())
  }
}

///|
test "redteam_billion_laughs_xml_bomb" {
  let bomb = "<!DOCTYPE lolz [" +
  "<!ENTITY lol \"lol\">" +
  "<!ENTITY lol1 \"&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;\">" +
  "<!ENTITY lol2 \"&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;\">" +
  "<!ENTITY lol3 \"&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;\">" +
  "<!ENTITY lol4 \"&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;\">" +
  "<!ENTITY lol5 \"&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;\">" +
  "<!ENTITY lol6 \"&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;\">" +
  "<!ENTITY lol7 \"&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;\">" +
  "<!ENTITY lol8 \"&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;\">" +
  "<!ENTITY lol9 \"&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;\">" +
  "]><lolz>&lol9;</lolz>"

  // Default options reject DTD immediately
  match Document::parse(bomb) {
    Ok(_) => debug_assert(false, "default must reject billion laughs")
    Err(e) => match e.kind {
      XmlErrorKind::DtdDetected => ()
      _ => debug_assert(false, "expected DtdDetected, got: " + e.to_string())
    }
  }

  // Even with allow_dtd: true, expansion limits stop it immediately!
  let opts = ParseOptions::{ allow_dtd: true, limits: Limits::default() }
  match Document::parse_with_options(bomb, opts) {
    Ok(_) => debug_assert(false, "allow_dtd must still reject billion laughs")
    Err(e) => match e.kind {
      XmlErrorKind::LimitExceeded => ()
      _ => debug_assert(false, "expected LimitExceeded, got: " + e.to_string())
    }
  }
}

///|
test "redteam_xxe_external_entity_blocked" {
  let xxe_sys = "<!DOCTYPE foo [ <!ENTITY xxe SYSTEM \"file:///etc/passwd\"> ]><foo>&xxe;</foo>"
  let xxe_pub = "<!DOCTYPE foo [ <!ENTITY xxe PUBLIC \"-//x//y\" \"http://169.254.169.254/latest\"> ]><foo>&xxe;</foo>"
  let opts = ParseOptions::{ allow_dtd: true, limits: Limits::default() }

  match Document::parse_with_options(xxe_sys, opts) {
    Ok(_) => debug_assert(false, "XXE SYSTEM must be rejected")
    Err(e) => match e.kind {
      XmlErrorKind::ExternalEntityNotAllowed => ()
      _ => debug_assert(false, "expected ExternalEntityNotAllowed, got: " + e.to_string())
    }
  }
  match Document::parse_with_options(xxe_pub, opts) {
    Ok(_) => debug_assert(false, "XXE PUBLIC must be rejected")
    Err(e) => match e.kind {
      XmlErrorKind::ExternalEntityNotAllowed => ()
      _ => debug_assert(false, "expected ExternalEntityNotAllowed, got: " + e.to_string())
    }
  }
}

///|
test "redteam_entity_cycle_rejected" {
  let cyc = "<!DOCTYPE r [ <!ENTITY a \"&b;\"> <!ENTITY b \"&a;\"> ]><r>&a;</r>"
  let opts = ParseOptions::{ allow_dtd: true, limits: Limits::default() }
  match Document::parse_with_options(cyc, opts) {
    Ok(_) => debug_assert(false, "entity cycle must be rejected")
    Err(e) => match e.kind {
      XmlErrorKind::EntityLoop => ()
      XmlErrorKind::LimitExceeded => ()
      _ => debug_assert(false, "expected EntityLoop, got: " + e.to_string())
    }
  }
}

///|
test "redteam_attribute_and_node_limits" {
  // Exceed max_attributes
  let sb = StringBuilder::with_capacity(400)
  sb.write_string("<r")
  let mut i = 0
  while i < 20 {
    sb.write_string(" a")
    sb.write_string(i.to_string())
    sb.write_string("=\"1\"")
    i = i + 1
  }
  sb.write_string("/>")
  let opts_attr = ParseOptions::{
    allow_dtd: false,
    limits: Limits::{
      max_depth: 256,
      max_nodes: 1000,
      max_attributes: 10,
      max_entity_expansions: 64,
      max_entity_bytes: 4096,
    },
  }
  match Document::parse_with_options(sb.to_string(), opts_attr) {
    Ok(_) => debug_assert(false, "max_attributes should reject 20 attrs")
    Err(e) => match e.kind {
      XmlErrorKind::LimitExceeded => ()
      _ => debug_assert(false, "expected LimitExceeded, got: " + e.to_string())
    }
  }

  // Exceed max_nodes
  let sb2 = StringBuilder::with_capacity(400)
  sb2.write_string("<r>")
  i = 0
  while i < 30 {
    sb2.write_string("<c/>")
    i = i + 1
  }
  sb2.write_string("</r>")
  let opts_nodes = ParseOptions::{
    allow_dtd: false,
    limits: Limits::{
      max_depth: 256,
      max_nodes: 15,
      max_attributes: 1024,
      max_entity_expansions: 64,
      max_entity_bytes: 4096,
    },
  }
  match Document::parse_with_options(sb2.to_string(), opts_nodes) {
    Ok(_) => debug_assert(false, "max_nodes should reject 30 child nodes")
    Err(e) => match e.kind {
      XmlErrorKind::LimitExceeded => ()
      _ => debug_assert(false, "expected LimitExceeded, got: " + e.to_string())
    }
  }
}
