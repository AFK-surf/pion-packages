///| Day-1 red-team security & adversarial tests for `xml`.

///|
test "redteam_deep_nesting_20k_no_sigsegv" {
  // 20,000 nested <a> elements: must NEVER stack-overflow (explicit stack only).
  let depth = 20000
  let sb = StringBuilder::with_capacity(depth * 7 + 16)
  let mut i = 0
  while i < depth {
    sb.write_string("<a>")
    i = i + 1
  }
  sb.write_string("ok")
  i = 0
  while i < depth {
    sb.write_string("</a>")
    i = i + 1
  }
  let deep_xml = sb.to_string()

  // 1. Default limits reject cleanly with LimitExceeded
  match Document::parse(deep_xml) {
    Ok(_) => debug_assert(false, "default max_depth should reject 20k nesting")
    Err(e) => {
      match e.kind {
        XmlErrorKind::LimitExceeded => ()
        _ => debug_assert(false, "expected LimitExceeded, got: " + e.to_string())
      }
    }
  }

  // 2. With raised max_depth, explicit-stack parser parses 20,000 levels without stack overflow!
  let high_opts = ParseOptions::{
    allow_dtd: false,
    limits: Limits::{
      max_depth: 25000,
      max_nodes: 100000,
      max_attributes: 1024,
      max_entity_expansions: 256,
      max_entity_bytes: 65536,
    },
  }
  match Document::parse_with_options(deep_xml, high_opts) {
    Ok(doc) => {
      debug_assert(doc.node_count() == depth + 2, "root + 20k elems + 1 text")
    }
    Err(e) => debug_assert(false, "raised max_depth failed: " + e.to_string())
  }
}

///|
test "redteam_billion_laughs_xml_bomb" {
  let bomb = "<!DOCTYPE lolz [" +
  "<!ENTITY lol \"lol\">" +
  "<!ENTITY lol1 \"&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;\">" +
  "<!ENTITY lol2 \"&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;\">" +
  "<!ENTITY lol3 \"&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;\">" +
  "<!ENTITY lol4 \"&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;\">" +
  "<!ENTITY lol5 \"&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;\">" +
  "<!ENTITY lol6 \"&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;\">" +
  "<!ENTITY lol7 \"&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;\">" +
  "<!ENTITY lol8 \"&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;\">" +
  "<!ENTITY lol9 \"&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;\">" +
  "]><lolz>&lol9;</lolz>"

  // Default options reject DTD immediately
  match Document::parse(bomb) {
    Ok(_) => debug_assert(false, "default must reject billion laughs")
    Err(e) => match e.kind {
      XmlErrorKind::DtdDetected => ()
      _ => debug_assert(false, "expected DtdDetected, got: " + e.to_string())
    }
  }

  // Even with allow_dtd: true, expansion limits stop it immediately!
  let opts = ParseOptions::{ allow_dtd: true, limits: Limits::default() }
  match Document::parse_with_options(bomb, opts) {
    Ok(_) => debug_assert(false, "allow_dtd must still reject billion laughs")
    Err(e) => match e.kind {
      XmlErrorKind::LimitExceeded => ()
      _ => debug_assert(false, "expected LimitExceeded, got: " + e.to_string())
    }
  }
}

///|
test "redteam_xxe_external_entity_blocked" {
  let xxe_sys = "<!DOCTYPE foo [ <!ENTITY xxe SYSTEM \"file:///etc/passwd\"> ]><foo>&xxe;</foo>"
  let xxe_pub = "<!DOCTYPE foo [ <!ENTITY xxe PUBLIC \"-//x//y\" \"http://169.254.169.254/latest\"> ]><foo>&xxe;</foo>"
  let opts = ParseOptions::{ allow_dtd: true, limits: Limits::default() }

  match Document::parse_with_options(xxe_sys, opts) {
    Ok(_) => debug_assert(false, "XXE SYSTEM must be rejected")
    Err(e) => match e.kind {
      XmlErrorKind::ExternalEntityNotAllowed => ()
      _ => debug_assert(false, "expected ExternalEntityNotAllowed, got: " + e.to_string())
    }
  }
  match Document::parse_with_options(xxe_pub, opts) {
    Ok(_) => debug_assert(false, "XXE PUBLIC must be rejected")
    Err(e) => match e.kind {
      XmlErrorKind::ExternalEntityNotAllowed => ()
      _ => debug_assert(false, "expected ExternalEntityNotAllowed, got: " + e.to_string())
    }
  }
}

///|
test "redteam_entity_cycle_rejected" {
  let cyc = "<!DOCTYPE r [ <!ENTITY a \"&b;\"> <!ENTITY b \"&a;\"> ]><r>&a;</r>"
  let opts = ParseOptions::{ allow_dtd: true, limits: Limits::default() }
  match Document::parse_with_options(cyc, opts) {
    Ok(_) => debug_assert(false, "entity cycle must be rejected")
    Err(e) => match e.kind {
      XmlErrorKind::EntityLoop => ()
      XmlErrorKind::LimitExceeded => ()
      _ => debug_assert(false, "expected EntityLoop, got: " + e.to_string())
    }
  }
}

///|
test "redteam_attribute_and_node_limits" {
  // Exceed max_attributes
  let sb = StringBuilder::with_capacity(400)
  sb.write_string("<r")
  let mut i = 0
  while i < 20 {
    sb.write_string(" a")
    sb.write_string(i.to_string())
    sb.write_string("=\"1\"")
    i = i + 1
  }
  sb.write_string("/>")
  let opts_attr = ParseOptions::{
    allow_dtd: false,
    limits: Limits::{
      max_depth: 256,
      max_nodes: 1000,
      max_attributes: 10,
      max_entity_expansions: 64,
      max_entity_bytes: 4096,
    },
  }
  match Document::parse_with_options(sb.to_string(), opts_attr) {
    Ok(_) => debug_assert(false, "max_attributes should reject 20 attrs")
    Err(e) => match e.kind {
      XmlErrorKind::LimitExceeded => ()
      _ => debug_assert(false, "expected LimitExceeded, got: " + e.to_string())
    }
  }

  // Exceed max_nodes
  let sb2 = StringBuilder::with_capacity(400)
  sb2.write_string("<r>")
  i = 0
  while i < 30 {
    sb2.write_string("<c/>")
    i = i + 1
  }
  sb2.write_string("</r>")
  let opts_nodes = ParseOptions::{
    allow_dtd: false,
    limits: Limits::{
      max_depth: 256,
      max_nodes: 15,
      max_attributes: 1024,
      max_entity_expansions: 64,
      max_entity_bytes: 4096,
    },
  }
  match Document::parse_with_options(sb2.to_string(), opts_nodes) {
    Ok(_) => debug_assert(false, "max_nodes should reject 30 child nodes")
    Err(e) => match e.kind {
      XmlErrorKind::LimitExceeded => ()
      _ => debug_assert(false, "expected LimitExceeded, got: " + e.to_string())
    }
  }
}

///|
test "redteam_regression_text_cdata_linear_pool" {
  let sb = StringBuilder::new()
  sb.write_string("<a>")
  let mut i = 0
  while i < 2000 {
    sb.write_string("ab<![CDATA[cd]]>")
    i = i + 1
  }
  sb.write_string("</a>")
  let src = sb.to_string()
  match Document::parse(src) {
    Ok(doc) => {
      let t = match doc.root_element().text() {
        Some(v) => v
        None => ""
      }
      debug_assert(t.length() == 8000, "merged text length")
      debug_assert(doc.strings.length() <= 2, "single pooled string for text run")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.to_string())
  }
}

///|
test "redteam_regression_dtd_entities_and_fifth_edition_version" {
  // XML 1.0 Fifth Edition §2.8: VersionNum = '1.' [0-9]+
  debug_assert(Document::parse("<?xml version=\"1.1\"?><a/>").is_ok(), "version 1.1 accepted")
  debug_assert(Document::parse("<?xml version=\"1.7\"?><a/>").is_ok(), "version 1.7 accepted")
  debug_assert(Document::parse("<?xml version=\"2.0\"?><a/>").is_err(), "version 2.0 rejected")

  let opts = ParseOptions::{ allow_dtd: true, limits: Limits::default() }
  // Internal entity markup parsed as content
  match Document::parse_with_options("<!DOCTYPE r [<!ENTITY p \"<p a='1'>x</p>\">]><r>&p;</r>", opts) {
    Ok(doc) => {
      let c = match doc.root_element().first_element_child() {
        Some(n) => n
        None => {
          debug_assert(false, "expected <p> child")
          return ()
        }
      }
      debug_assert(c.tag_name().name() == "p", "entity child tag p")
      debug_assert(
        match c.attribute("a") {
          Some(v) => v == "1"
          None => false
        },
        "entity child attr a=1",
      )
      debug_assert(
        match c.text() {
          Some(v) => v == "x"
          None => false
        },
        "entity child text x",
      )
    }
    Err(e) => debug_assert(false, "entity markup failed: " + e.to_string())
  }

  // Unbalanced markup, illegal char, charref '<' in attr, and ']]>' in content rejected
  debug_assert(
    Document::parse_with_options("<!DOCTYPE d [<!ENTITY e \"</foo><foo>\">]><d><foo>&e;</foo></d>", opts).is_err(),
    "unbalanced entity rejected",
  )
  debug_assert(
    Document::parse_with_options("<!DOCTYPE a [<!ENTITY e \"&#60;\">]><a k=\"&e;\"/>", opts).is_err(),
    "charref < in attr rejected",
  )
  debug_assert(
    Document::parse_with_options("<!DOCTYPE a [<!ENTITY e \"\u{1}\">]><a>&e;</a>", opts).is_err(),
    "illegal char in entity value rejected",
  )
  debug_assert(
    Document::parse_with_options("<!DOCTYPE a [<!ENTITY e \"]]>\">]><a>&e;</a>", opts).is_err(),
    "]]> in entity content rejected",
  )

  // Two-level charref escaping (§4.5 App. D), CDATA in entity, empty entity -> no text node
  match Document::parse_with_options("<!DOCTYPE a [<!ENTITY e \"1 &#38;#60; 2\">]><a>&e;</a>", opts) {
    Ok(doc) => debug_assert(
      match doc.root_element().text() {
        Some(t) => t == "1 < 2"
        None => false
      },
      "double-escaped charref",
    )
    Err(e) => debug_assert(false, "double-escaped failed: " + e.to_string())
  }
  match Document::parse_with_options("<!DOCTYPE a [<!ENTITY e \"<![CDATA[&foo;]]>\">]><a>&e;</a>", opts) {
    Ok(doc) => debug_assert(
      match doc.root_element().text() {
        Some(t) => t == "&foo;"
        None => false
      },
      "cdata in entity",
    )
    Err(e) => debug_assert(false, "cdata in entity failed: " + e.to_string())
  }
  match Document::parse_with_options("<!DOCTYPE a [<!ENTITY e \"\">]><a>&e;</a>", opts) {
    Ok(doc) => debug_assert(!doc.root_element().has_children(), "empty entity no text node")
    Err(e) => debug_assert(false, "empty entity failed: " + e.to_string())
  }

  // Unreferenced external/unparsed/parameter entity declarations accepted, references rejected
  debug_assert(
    Document::parse_with_options("<!DOCTYPE d [<!ENTITY ent SYSTEM \"nop.ent\">]><d/>", opts).is_ok(),
    "unreferenced external entity accepted",
  )
  debug_assert(
    Document::parse_with_options("<!DOCTYPE d [<!ENTITY ent SYSTEM \"nop.ent\">]><d>&ent;</d>", opts).is_err(),
    "referenced external entity rejected",
  )
}

///|
test "redteam_regression_reader_ns_and_writer_atomicity" {
  // Reader rejects unbound prefix and truncated tag immediately
  let r1 = Reader::new("<p:a/>")
  debug_assert(r1.next_event().is_err(), "reader unbound prefix")
  let r2 = Reader::new("<a k=\"1\"")
  debug_assert(r2.next_event().is_err(), "reader truncated start tag")

  // Writer atomicity, duplicate attr, NS well-formedness, CR roundtrip, PI roundtrip, mixed pretty
  let w = Writer::new()
  debug_assert(w.write_start_element("root", []).is_ok(), "start root")
  let snap = w.sb.to_string()
  debug_assert(w.write_empty_element("item", [("ok", "1"), ("bad name", "x")]).is_err(), "bad attr")
  debug_assert(w.sb.to_string() == snap, "buffer unchanged on error")
  debug_assert(w.write_empty_element("item", [("k", "1"), ("k", "2")]).is_err(), "dup attr")
  debug_assert(w.write_empty_element("p:item", []).is_err(), "unbound prefix")
  debug_assert(w.write_text("x\ry").is_ok(), "write text with CR")
  debug_assert(w.write_pi("t", Some("  v")).is_ok(), "write pi leading ws")
  debug_assert(w.write_end_element("root").is_ok(), "end root")
  debug_assert(w.write_empty_element("root2", []).is_err(), "second root rejected")
  match Document::parse(w.into_string()) {
    Ok(doc) => {
      let kids = doc.root_element().children()
      debug_assert(kids.length() == 2, "text + pi")
      debug_assert(
        match kids[0].text() {
          Some(t) => t == "x\ry"
          None => false
        },
        "CR preserved in text roundtrip",
      )
      debug_assert(
        match kids[1].pi() {
          Some(p) => match p.value {
            Some(v) => v == "  v"
            None => false
          }
          None => false
        },
        "PI leading whitespace roundtrip",
      )
    }
    Err(e) => debug_assert(false, "reparse failed: " + e.to_string())
  }
}
