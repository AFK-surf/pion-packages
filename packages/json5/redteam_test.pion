///| Day-1 Red-Team defenses:
///| - 10k deep nesting iterative parsing (0 SIGSEGV) + max_depth guard
///| - max_nodes resource budget guard
///| - huge float overflow (1e400) rejection
///| - duplicate key policies (LastWins / FirstWins / Reject)
///| - malformed UTF-16 surrogate escapes rejection
///| - huge array index OOM/overflow protection in RFC 6901 & RFC 6902
///| - atomic transaction rollback on partial patch failure
///| - precise 1-based line/col error reporting

///|
test "redteam_deep_nesting_10k_iterative_no_sigsegv" {
  let depth = 10000
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_byte((91).to_byte())
    i = i + 1
  }
  sb.write_byte((49).to_byte())
  let mut j = 0
  while j < depth {
    sb.write_byte((93).to_byte())
    j = j + 1
  }
  let deep_arr = sb.to_string()

  match parse(deep_arr) {
    Ok(_) => debug_assert(false, "default max_depth should reject 10k nesting")
    Err(_) => ()
  }

  let opts = ParseOptions::{
    max_depth: 12000,
    max_nodes: 1000000,
    duplicate_keys: DuplicateKeyPolicy::LastWins,
    allow_json5: true,
    allow_comments: true,
    allow_trailing_commas: true,
    reject_overflow: true,
  }
  match parse_with_options(deep_arr, opts) {
    Ok(v) => {
      let mut cur = v
      let mut walked = 0
      while true {
        match cur {
          Json5Value::Array(items) => {
            if items.length() == 1 {
              cur = items[0]
              walked = walked + 1
            } else {
              break
            }
          }
          _ => break
        }
      }
      debug_assert(walked == depth, "walked depth mismatch")
      assert_opt_int(as_int(cur), 1L, "leaf value mismatch")
    }
    Err(e) => debug_assert(false, "10k iterative parse failed: " + e.message)
  }
}

///|
test "redteam_max_nodes_limit" {
  let sb = StringBuilder::new()
  sb.write_byte((91).to_byte())
  let mut i = 0
  while i < 500 {
    if i > 0 {
      sb.write_byte((44).to_byte())
    }
    sb.write_byte((49).to_byte())
    i = i + 1
  }
  sb.write_byte((93).to_byte())
  let src = sb.to_string()

  let opts = ParseOptions::{
    max_depth: 128,
    max_nodes: 100,
    duplicate_keys: DuplicateKeyPolicy::LastWins,
    allow_json5: true,
    allow_comments: true,
    allow_trailing_commas: true,
    reject_overflow: true,
  }
  match parse_with_options(src, opts) {
    Ok(_) => debug_assert(false, "max_nodes=100 should reject 500 elements")
    Err(_) => ()
  }
}

///|
test "redteam_float_overflow_1e400" {
  let overflow_cases = ["1e400", "-1e400", "1e309", "9.99e308", "1e999999"]
  let strict_opts = ParseOptions::strict_json()
  let mut i = 0
  while i < overflow_cases.length() {
    // Default JSON5 v2.0 / ES5.1 mode: overflowing literals evaluate to +-Infinity
    match parse(overflow_cases[i]) {
      Ok(Json5Value::Number(x)) => {
        let want = if i == 1 { -1.0 / 0.0 } else { 1.0 / 0.0 }
        debug_assert(x == want, "expected +-Infinity for " + overflow_cases[i])
      }
      _ => debug_assert(false, "default JSON5 should accept overflow as +-Infinity: " + overflow_cases[i])
    }
    // Strict JSON / reject_overflow: true mode still rejects overflowing literals
    match parse_with_options(overflow_cases[i], strict_opts) {
      Ok(_) => debug_assert(false, "strict_json should reject overflow: " + overflow_cases[i])
      Err(_) => ()
    }
    i = i + 1
  }
  match parse("Infinity") {
    Ok(Json5Value::Number(x)) => debug_assert(x == 1.0 / 0.0, "Infinity ok")
    _ => debug_assert(false, "Infinity must be allowed")
  }
}

///|
test "redteam_duplicate_key_policies" {
  let src = "{ a: 1, b: 2, a: 3 }"
  match parse(src) {
    Ok(v) => {
      match get(v, "a") {
        Some(a) => assert_opt_int(as_int(a), 3L, "LastWins")
        None => debug_assert(false, "LastWins missing a")
      }
    }
    Err(e) => debug_assert(false, "LastWins failed: " + e.message)
  }
  let opts_first = ParseOptions::{
    max_depth: 128,
    max_nodes: 1000000,
    duplicate_keys: DuplicateKeyPolicy::FirstWins,
    allow_json5: true,
    allow_comments: true,
    allow_trailing_commas: true,
    reject_overflow: true,
  }
  match parse_with_options(src, opts_first) {
    Ok(v) => {
      match get(v, "a") {
        Some(a) => assert_opt_int(as_int(a), 1L, "FirstWins")
        None => debug_assert(false, "FirstWins missing a")
      }
    }
    Err(e) => debug_assert(false, "FirstWins failed: " + e.message)
  }
  let opts_reject = ParseOptions::{
    max_depth: 128,
    max_nodes: 1000000,
    duplicate_keys: DuplicateKeyPolicy::Reject,
    allow_json5: true,
    allow_comments: true,
    allow_trailing_commas: true,
    reject_overflow: true,
  }
  match parse_with_options(src, opts_reject) {
    Ok(_) => debug_assert(false, "Reject policy must fail on duplicate key")
    Err(_) => ()
  }
}

///|
test "redteam_malformed_surrogate_escapes_rejected" {
  let bad = [
    "\"\\uD800\"",
    "\"\\uDFFF\"",
    "\"\\uD800\\u0041\"",
    "\"\\uDC00\\uD800\"",
    "\"\\uD83D\"",
    "\"\\uD83Dabc\"",
  ]
  let mut i = 0
  while i < bad.length() {
    match parse(bad[i]) {
      Ok(_) => debug_assert(false, "malformed surrogate should fail: " + bad[i])
      Err(_) => ()
    }
    i = i + 1
  }
}

///|
test "redteam_huge_array_index_and_move_descendant_and_atomic_rollback" {
  let doc = match parse("{\"arr\":[1,2],\"a\":{\"b\":1}}") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      return
    }
  }
  match pointer_get(doc, "/arr/999999999999999999999999") {
    Ok(None) => ()
    _ => debug_assert(false, "huge index pointer_get must be Ok(None)")
  }
  let huge_patch = match parse_patch("[{\"op\":\"add\",\"path\":\"/arr/2147483647\",\"value\":9}]") {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse_patch failed: " + e.message)
      return
    }
  }
  match apply_patch(doc, huge_patch) {
    Ok(_) => debug_assert(false, "huge array index add must fail")
    Err(_) => ()
  }
  let self_move = match parse_patch("[{\"op\":\"move\",\"from\":\"/a\",\"path\":\"/a/b\"}]") {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse_patch failed: " + e.message)
      return
    }
  }
  match apply_patch(doc, self_move) {
    Ok(_) => debug_assert(false, "move into descendant must fail")
    Err(_) => ()
  }
  let tx_patch = match parse_patch("[{\"op\":\"add\",\"path\":\"/new_key\",\"value\":123},{\"op\":\"test\",\"path\":\"/a/b\",\"value\":999}]") {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse_patch failed: " + e.message)
      return
    }
  }
  match apply_patch(doc, tx_patch) {
    Ok(_) => debug_assert(false, "tx_patch must fail on test op")
    Err(_) => {
      match get(doc, "new_key") {
        None => ()
        Some(_) => debug_assert(false, "original doc must remain untouched")
      }
    }
  }
}

///|
test "redteam_precise_line_col_error_location" {
  let src = "{\n  a: 1,\n  b: @\n}"
  match parse(src) {
    Ok(_) => debug_assert(false, "expected syntax error")
    Err(e) => {
      debug_assert(e.line == 3, "expected line 3, got " + e.line.to_string())
      debug_assert(e.col == 6, "expected col 6, got " + e.col.to_string())
    }
  }
}

///|
test "redteam_patch_depth_and_node_budget_and_object_index" {
  // 1. Default apply_patch blocks patchgrow depth DoS at max_depth = 512
  let sb = StringBuilder::new()
  sb.write_byte((91).to_byte())
  let mut i = 0
  while i < 600 {
    if i > 0 {
      sb.write_byte((44).to_byte())
    }
    sb.write_string("{op:'add',path:'/b',value:{}},{op:'move',from:'/a',path:'/b/a'},{op:'move',from:'/b',path:'/a'}")
    i = i + 1
  }
  sb.write_byte((93).to_byte())
  let grow_patch = match parse_patch(sb.to_string()) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse_patch failed: " + e.message)
      return
    }
  }
  let doc = Json5Value::Object([("a", Json5Value::Null)])
  match apply_patch(doc, grow_patch) {
    Ok(_) => debug_assert(false, "default apply_patch must reject 600-level patchgrow")
    Err(_) => ()
  }
  // Configurable apply_patch_with_options allows higher depth when explicitly requested
  match apply_patch_with_options(doc, grow_patch, PatchOptions::{ max_depth: 1024, max_nodes: 1000000 }) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "apply_patch_with_options(max_depth=1024) failed: " + e.message)
  }

  // 2. Copy amplification bomb blocked by max_nodes budget
  let copy_ops : Array[PatchOp] = []
  let mut k = 0
  while k < 16 {
    copy_ops.push(PatchOp::Copy("", "/c" + k.to_string()))
    k = k + 1
  }
  match apply_patch_with_options(
    Json5Value::Object([("seed", Json5Value::Number(1.0))]),
    Patch::{ ops: copy_ops },
    PatchOptions::{ max_depth: 512, max_nodes: 1000 },
  ) {
    Ok(_) => debug_assert(false, "copy amplification bomb must hit max_nodes")
    Err(_) => ()
  }

  // 3. ObjectIndex O(1) lookup with LastWins semantics
  let obj = Json5Value::Object([
    ("x", Json5Value::Number(1.0)),
    ("y", Json5Value::Number(2.0)),
    ("x", Json5Value::Number(3.0)),
  ])
  match ObjectIndex::from_value(obj) {
    Some(idx) => {
      match idx.get("x") {
        Some(v) => assert_opt_int(as_int(v), 3L, "ObjectIndex LastWins")
        None => debug_assert(false, "ObjectIndex missing x")
      }
      match idx.get("missing") {
        None => ()
        Some(_) => debug_assert(false, "ObjectIndex unexpected hit")
      }
    }
    None => debug_assert(false, "ObjectIndex::from_value failed")
  }
}
