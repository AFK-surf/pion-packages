///| Official json-patch/json-patch-tests RFC 6902 compliance suite (108 active vectors).

fn assert_patch_ok(name : String, doc_json : String, patch_json : String, expected_json : String) -> Unit {
  let doc = match parse(doc_json) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "[" + name + "] doc parse failed: " + e.message)
      return
    }
  }
  let patch = match parse_patch(patch_json) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "[" + name + "] patch parse failed: " + e.message)
      return
    }
  }
  let expected = match parse(expected_json) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "[" + name + "] expected parse failed: " + e.message)
      return
    }
  }
  match apply_patch(doc, patch) {
    Ok(actual) => debug_assert(value_eq(actual, expected), "[" + name + "] patched value mismatch")
    Err(e) => debug_assert(false, "[" + name + "] apply_patch failed: " + e.message)
  }
}

fn assert_patch_no_error(name : String, doc_json : String, patch_json : String) -> Unit {
  let doc = match parse(doc_json) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "[" + name + "] doc parse failed: " + e.message)
      return
    }
  }
  let patch = match parse_patch(patch_json) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "[" + name + "] patch parse failed: " + e.message)
      return
    }
  }
  match apply_patch(doc, patch) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "[" + name + "] apply_patch failed: " + e.message)
  }
}

fn assert_patch_err(name : String, doc_json : String, patch_json : String) -> Unit {
  let doc = match parse(doc_json) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "[" + name + "] doc parse failed: " + e.message)
      return
    }
  }
  let snap = to_json5_string(doc)
  match parse_patch(patch_json) {
    Err(_) => ()
    Ok(patch) => {
      match apply_patch(doc, patch) {
        Ok(_) => debug_assert(false, "[" + name + "] expected patch error, got Ok")
        Err(_) => {
          debug_assert(to_json5_string(doc) == snap, "[" + name + "] atomic rollback violated")
        }
      }
    }
  }
}

///|
test "rfc6902_spec_000" {
  assert_patch_err("rfc6902_spec_000: 4.1. add with missing object", "{\"q\":{\"bar\":2}}", "[{\"op\":\"add\",\"path\":\"/a/b\",\"value\":1}]")
}

///|
test "rfc6902_spec_001" {
  assert_patch_ok("rfc6902_spec_001: A.1.  Adding an Object Member", "{\"foo\":\"bar\"}", "[{\"op\":\"add\",\"path\":\"/baz\",\"value\":\"qux\"}]", "{\"baz\":\"qux\",\"foo\":\"bar\"}")
}

///|
test "rfc6902_spec_002" {
  assert_patch_ok("rfc6902_spec_002: A.2.  Adding an Array Element", "{\"foo\":[\"bar\",\"baz\"]}", "[{\"op\":\"add\",\"path\":\"/foo/1\",\"value\":\"qux\"}]", "{\"foo\":[\"bar\",\"qux\",\"baz\"]}")
}

///|
test "rfc6902_spec_003" {
  assert_patch_ok("rfc6902_spec_003: A.3.  Removing an Object Member", "{\"baz\":\"qux\",\"foo\":\"bar\"}", "[{\"op\":\"remove\",\"path\":\"/baz\"}]", "{\"foo\":\"bar\"}")
}

///|
test "rfc6902_spec_004" {
  assert_patch_ok("rfc6902_spec_004: A.4.  Removing an Array Element", "{\"foo\":[\"bar\",\"qux\",\"baz\"]}", "[{\"op\":\"remove\",\"path\":\"/foo/1\"}]", "{\"foo\":[\"bar\",\"baz\"]}")
}

///|
test "rfc6902_spec_005" {
  assert_patch_ok("rfc6902_spec_005: A.5.  Replacing a Value", "{\"baz\":\"qux\",\"foo\":\"bar\"}", "[{\"op\":\"replace\",\"path\":\"/baz\",\"value\":\"boo\"}]", "{\"baz\":\"boo\",\"foo\":\"bar\"}")
}

///|
test "rfc6902_spec_006" {
  assert_patch_ok("rfc6902_spec_006: A.6.  Moving a Value", "{\"foo\":{\"bar\":\"baz\",\"waldo\":\"fred\"},\"qux\":{\"corge\":\"grault\"}}", "[{\"op\":\"move\",\"from\":\"/foo/waldo\",\"path\":\"/qux/thud\"}]", "{\"foo\":{\"bar\":\"baz\"},\"qux\":{\"corge\":\"grault\",\"thud\":\"fred\"}}")
}

///|
test "rfc6902_spec_007" {
  assert_patch_ok("rfc6902_spec_007: A.7.  Moving an Array Element", "{\"foo\":[\"all\",\"grass\",\"cows\",\"eat\"]}", "[{\"op\":\"move\",\"from\":\"/foo/1\",\"path\":\"/foo/3\"}]", "{\"foo\":[\"all\",\"cows\",\"eat\",\"grass\"]}")
}

///|
test "rfc6902_spec_008" {
  assert_patch_ok("rfc6902_spec_008: A.8.  Testing a Value: Success", "{\"baz\":\"qux\",\"foo\":[\"a\",2,\"c\"]}", "[{\"op\":\"test\",\"path\":\"/baz\",\"value\":\"qux\"},{\"op\":\"test\",\"path\":\"/foo/1\",\"value\":2}]", "{\"baz\":\"qux\",\"foo\":[\"a\",2,\"c\"]}")
}

///|
test "rfc6902_spec_009" {
  assert_patch_err("rfc6902_spec_009: A.9.  Testing a Value: Error", "{\"baz\":\"qux\"}", "[{\"op\":\"test\",\"path\":\"/baz\",\"value\":\"bar\"}]")
}

///|
test "rfc6902_spec_010" {
  assert_patch_ok("rfc6902_spec_010: A.10.  Adding a nested Member Object", "{\"foo\":\"bar\"}", "[{\"op\":\"add\",\"path\":\"/child\",\"value\":{\"grandchild\":{}}}]", "{\"foo\":\"bar\",\"child\":{\"grandchild\":{}}}")
}

///|
test "rfc6902_spec_011" {
  assert_patch_ok("rfc6902_spec_011: A.11.  Ignoring Unrecognized Elements", "{\"foo\":\"bar\"}", "[{\"op\":\"add\",\"path\":\"/baz\",\"value\":\"qux\",\"xyz\":123}]", "{\"foo\":\"bar\",\"baz\":\"qux\"}")
}

///|
test "rfc6902_spec_012" {
  assert_patch_err("rfc6902_spec_012: A.12.  Adding to a Non-existent Target", "{\"foo\":\"bar\"}", "[{\"op\":\"add\",\"path\":\"/baz/bat\",\"value\":\"qux\"}]")
}

///|
test "rfc6902_spec_014" {
  assert_patch_ok("rfc6902_spec_014: A.14. ~ Escape Ordering", "{\"/\":9,\"~1\":10}", "[{\"op\":\"test\",\"path\":\"/~01\",\"value\":10}]", "{\"/\":9,\"~1\":10}")
}

///|
test "rfc6902_spec_015" {
  assert_patch_err("rfc6902_spec_015: A.15. Comparing Strings and Numbers", "{\"/\":9,\"~1\":10}", "[{\"op\":\"test\",\"path\":\"/~01\",\"value\":\"10\"}]")
}

///|
test "rfc6902_spec_016" {
  assert_patch_ok("rfc6902_spec_016: A.16. Adding an Array Value", "{\"foo\":[\"bar\"]}", "[{\"op\":\"add\",\"path\":\"/foo/-\",\"value\":[\"abc\",\"def\"]}]", "{\"foo\":[\"bar\",[\"abc\",\"def\"]]}")
}

///|
test "rfc6902_suite_000" {
  assert_patch_ok("rfc6902_suite_000: empty list, empty docs", "{}", "[]", "{}")
}

///|
test "rfc6902_suite_001" {
  assert_patch_ok("rfc6902_suite_001: empty patch list", "{\"foo\":1}", "[]", "{\"foo\":1}")
}

///|
test "rfc6902_suite_002" {
  assert_patch_ok("rfc6902_suite_002: rearrangements OK?", "{\"foo\":1,\"bar\":2}", "[]", "{\"bar\":2,\"foo\":1}")
}

///|
test "rfc6902_suite_003" {
  assert_patch_ok("rfc6902_suite_003: rearrangements OK?  How about one level down ... array", "[{\"foo\":1,\"bar\":2}]", "[]", "[{\"bar\":2,\"foo\":1}]")
}

///|
test "rfc6902_suite_004" {
  assert_patch_ok("rfc6902_suite_004: rearrangements OK?  How about one level down...", "{\"foo\":{\"foo\":1,\"bar\":2}}", "[]", "{\"foo\":{\"bar\":2,\"foo\":1}}")
}

///|
test "rfc6902_suite_005" {
  assert_patch_ok("rfc6902_suite_005: add replaces any existing field", "{\"foo\":null}", "[{\"op\":\"add\",\"path\":\"/foo\",\"value\":1}]", "{\"foo\":1}")
}

///|
test "rfc6902_suite_006" {
  assert_patch_ok("rfc6902_suite_006: toplevel array", "[]", "[{\"op\":\"add\",\"path\":\"/0\",\"value\":\"foo\"}]", "[\"foo\"]")
}

///|
test "rfc6902_suite_007" {
  assert_patch_ok("rfc6902_suite_007: toplevel array, no change", "[\"foo\"]", "[]", "[\"foo\"]")
}

///|
test "rfc6902_suite_008" {
  assert_patch_ok("rfc6902_suite_008: toplevel object, numeric string", "{}", "[{\"op\":\"add\",\"path\":\"/foo\",\"value\":\"1\"}]", "{\"foo\":\"1\"}")
}

///|
test "rfc6902_suite_009" {
  assert_patch_ok("rfc6902_suite_009: toplevel object, integer", "{}", "[{\"op\":\"add\",\"path\":\"/foo\",\"value\":1}]", "{\"foo\":1}")
}

///|
test "rfc6902_suite_011" {
  assert_patch_ok("rfc6902_suite_011: replace object document with array document?", "{}", "[{\"op\":\"add\",\"path\":\"\",\"value\":[]}]", "[]")
}

///|
test "rfc6902_suite_012" {
  assert_patch_ok("rfc6902_suite_012: replace array document with object document?", "[]", "[{\"op\":\"add\",\"path\":\"\",\"value\":{}}]", "{}")
}

///|
test "rfc6902_suite_013" {
  assert_patch_ok("rfc6902_suite_013: append to root array document?", "[]", "[{\"op\":\"add\",\"path\":\"/-\",\"value\":\"hi\"}]", "[\"hi\"]")
}

///|
test "rfc6902_suite_014" {
  assert_patch_ok("rfc6902_suite_014: Add, / target", "{}", "[{\"op\":\"add\",\"path\":\"/\",\"value\":1}]", "{\"\":1}")
}

///|
test "rfc6902_suite_015" {
  assert_patch_ok("rfc6902_suite_015: Add, /foo/ deep target (trailing slash)", "{\"foo\":{}}", "[{\"op\":\"add\",\"path\":\"/foo/\",\"value\":1}]", "{\"foo\":{\"\":1}}")
}

///|
test "rfc6902_suite_016" {
  assert_patch_ok("rfc6902_suite_016: Add composite value at top level", "{\"foo\":1}", "[{\"op\":\"add\",\"path\":\"/bar\",\"value\":[1,2]}]", "{\"foo\":1,\"bar\":[1,2]}")
}

///|
test "rfc6902_suite_017" {
  assert_patch_ok("rfc6902_suite_017: Add into composite value", "{\"foo\":1,\"baz\":[{\"qux\":\"hello\"}]}", "[{\"op\":\"add\",\"path\":\"/baz/0/foo\",\"value\":\"world\"}]", "{\"foo\":1,\"baz\":[{\"qux\":\"hello\",\"foo\":\"world\"}]}")
}

///|
test "rfc6902_suite_018" {
  assert_patch_err("rfc6902_suite_018: case_18", "{\"bar\":[1,2]}", "[{\"op\":\"add\",\"path\":\"/bar/8\",\"value\":\"5\"}]")
}

///|
test "rfc6902_suite_019" {
  assert_patch_err("rfc6902_suite_019: case_19", "{\"bar\":[1,2]}", "[{\"op\":\"add\",\"path\":\"/bar/-1\",\"value\":\"5\"}]")
}

///|
test "rfc6902_suite_020" {
  assert_patch_ok("rfc6902_suite_020: case_20", "{\"foo\":1}", "[{\"op\":\"add\",\"path\":\"/bar\",\"value\":true}]", "{\"foo\":1,\"bar\":true}")
}

///|
test "rfc6902_suite_021" {
  assert_patch_ok("rfc6902_suite_021: case_21", "{\"foo\":1}", "[{\"op\":\"add\",\"path\":\"/bar\",\"value\":false}]", "{\"foo\":1,\"bar\":false}")
}

///|
test "rfc6902_suite_022" {
  assert_patch_ok("rfc6902_suite_022: case_22", "{\"foo\":1}", "[{\"op\":\"add\",\"path\":\"/bar\",\"value\":null}]", "{\"foo\":1,\"bar\":null}")
}

///|
test "rfc6902_suite_023" {
  assert_patch_ok("rfc6902_suite_023: 0 can be an array index or object element name", "{\"foo\":1}", "[{\"op\":\"add\",\"path\":\"/0\",\"value\":\"bar\"}]", "{\"foo\":1,\"0\":\"bar\"}")
}

///|
test "rfc6902_suite_024" {
  assert_patch_ok("rfc6902_suite_024: case_24", "[\"foo\"]", "[{\"op\":\"add\",\"path\":\"/1\",\"value\":\"bar\"}]", "[\"foo\",\"bar\"]")
}

///|
test "rfc6902_suite_025" {
  assert_patch_ok("rfc6902_suite_025: case_25", "[\"foo\",\"sil\"]", "[{\"op\":\"add\",\"path\":\"/1\",\"value\":\"bar\"}]", "[\"foo\",\"bar\",\"sil\"]")
}

///|
test "rfc6902_suite_026" {
  assert_patch_ok("rfc6902_suite_026: case_26", "[\"foo\",\"sil\"]", "[{\"op\":\"add\",\"path\":\"/0\",\"value\":\"bar\"}]", "[\"bar\",\"foo\",\"sil\"]")
}

///|
test "rfc6902_suite_027" {
  assert_patch_ok("rfc6902_suite_027: push item to array via last index + 1", "[\"foo\",\"sil\"]", "[{\"op\":\"add\",\"path\":\"/2\",\"value\":\"bar\"}]", "[\"foo\",\"sil\",\"bar\"]")
}

///|
test "rfc6902_suite_028" {
  assert_patch_err("rfc6902_suite_028: add item to array at index > length should fail", "[\"foo\",\"sil\"]", "[{\"op\":\"add\",\"path\":\"/3\",\"value\":\"bar\"}]")
}

///|
test "rfc6902_suite_029" {
  assert_patch_ok("rfc6902_suite_029: test against implementation-specific numeric parsing", "{\"1e0\":\"foo\"}", "[{\"op\":\"test\",\"path\":\"/1e0\",\"value\":\"foo\"}]", "{\"1e0\":\"foo\"}")
}

///|
test "rfc6902_suite_030" {
  assert_patch_err("rfc6902_suite_030: test with bad number should fail", "[\"foo\",\"bar\"]", "[{\"op\":\"test\",\"path\":\"/1e0\",\"value\":\"bar\"}]")
}

///|
test "rfc6902_suite_031" {
  assert_patch_err("rfc6902_suite_031: case_31", "[\"foo\",\"sil\"]", "[{\"op\":\"add\",\"path\":\"/bar\",\"value\":42}]")
}

///|
test "rfc6902_suite_032" {
  assert_patch_ok("rfc6902_suite_032: value in array add not flattened", "[\"foo\",\"sil\"]", "[{\"op\":\"add\",\"path\":\"/1\",\"value\":[\"bar\",\"baz\"]}]", "[\"foo\",[\"bar\",\"baz\"],\"sil\"]")
}

///|
test "rfc6902_suite_033" {
  assert_patch_ok("rfc6902_suite_033: case_33", "{\"foo\":1,\"bar\":[1,2,3,4]}", "[{\"op\":\"remove\",\"path\":\"/bar\"}]", "{\"foo\":1}")
}

///|
test "rfc6902_suite_034" {
  assert_patch_ok("rfc6902_suite_034: case_34", "{\"foo\":1,\"baz\":[{\"qux\":\"hello\"}]}", "[{\"op\":\"remove\",\"path\":\"/baz/0/qux\"}]", "{\"foo\":1,\"baz\":[{}]}")
}

///|
test "rfc6902_suite_035" {
  assert_patch_ok("rfc6902_suite_035: case_35", "{\"foo\":1,\"baz\":[{\"qux\":\"hello\"}]}", "[{\"op\":\"replace\",\"path\":\"/foo\",\"value\":[1,2,3,4]}]", "{\"foo\":[1,2,3,4],\"baz\":[{\"qux\":\"hello\"}]}")
}

///|
test "rfc6902_suite_036" {
  assert_patch_ok("rfc6902_suite_036: case_36", "{\"foo\":[1,2,3,4],\"baz\":[{\"qux\":\"hello\"}]}", "[{\"op\":\"replace\",\"path\":\"/baz/0/qux\",\"value\":\"world\"}]", "{\"foo\":[1,2,3,4],\"baz\":[{\"qux\":\"world\"}]}")
}

///|
test "rfc6902_suite_037" {
  assert_patch_ok("rfc6902_suite_037: case_37", "[\"foo\"]", "[{\"op\":\"replace\",\"path\":\"/0\",\"value\":\"bar\"}]", "[\"bar\"]")
}

///|
test "rfc6902_suite_038" {
  assert_patch_ok("rfc6902_suite_038: case_38", "[\"\"]", "[{\"op\":\"replace\",\"path\":\"/0\",\"value\":0}]", "[0]")
}

///|
test "rfc6902_suite_039" {
  assert_patch_ok("rfc6902_suite_039: case_39", "[\"\"]", "[{\"op\":\"replace\",\"path\":\"/0\",\"value\":true}]", "[true]")
}

///|
test "rfc6902_suite_040" {
  assert_patch_ok("rfc6902_suite_040: case_40", "[\"\"]", "[{\"op\":\"replace\",\"path\":\"/0\",\"value\":false}]", "[false]")
}

///|
test "rfc6902_suite_041" {
  assert_patch_ok("rfc6902_suite_041: case_41", "[\"\"]", "[{\"op\":\"replace\",\"path\":\"/0\",\"value\":null}]", "[null]")
}

///|
test "rfc6902_suite_042" {
  assert_patch_ok("rfc6902_suite_042: value in array replace not flattened", "[\"foo\",\"sil\"]", "[{\"op\":\"replace\",\"path\":\"/1\",\"value\":[\"bar\",\"baz\"]}]", "[\"foo\",[\"bar\",\"baz\"]]")
}

///|
test "rfc6902_suite_043" {
  assert_patch_ok("rfc6902_suite_043: replace whole document", "{\"foo\":\"bar\"}", "[{\"op\":\"replace\",\"path\":\"\",\"value\":{\"baz\":\"qux\"}}]", "{\"baz\":\"qux\"}")
}

///|
test "rfc6902_suite_044" {
  assert_patch_err("rfc6902_suite_044: test replace with missing parent key should fail", "{\"bar\":\"baz\"}", "[{\"op\":\"replace\",\"path\":\"/foo/bar\",\"value\":false}]")
}

///|
test "rfc6902_suite_045" {
  assert_patch_ok("rfc6902_suite_045: spurious patch properties", "{\"foo\":1}", "[{\"op\":\"test\",\"path\":\"/foo\",\"value\":1,\"spurious\":1}]", "{\"foo\":1}")
}

///|
test "rfc6902_suite_046" {
  assert_patch_ok("rfc6902_suite_046: null value should be valid obj property", "{\"foo\":null}", "[{\"op\":\"test\",\"path\":\"/foo\",\"value\":null}]", "{\"foo\":null}")
}

///|
test "rfc6902_suite_047" {
  assert_patch_ok("rfc6902_suite_047: null value should be valid obj property to be replaced with something truthy", "{\"foo\":null}", "[{\"op\":\"replace\",\"path\":\"/foo\",\"value\":\"truthy\"}]", "{\"foo\":\"truthy\"}")
}

///|
test "rfc6902_suite_048" {
  assert_patch_ok("rfc6902_suite_048: null value should be valid obj property to be moved", "{\"foo\":null}", "[{\"op\":\"move\",\"from\":\"/foo\",\"path\":\"/bar\"}]", "{\"bar\":null}")
}

///|
test "rfc6902_suite_049" {
  assert_patch_ok("rfc6902_suite_049: null value should be valid obj property to be copied", "{\"foo\":null}", "[{\"op\":\"copy\",\"from\":\"/foo\",\"path\":\"/bar\"}]", "{\"foo\":null,\"bar\":null}")
}

///|
test "rfc6902_suite_050" {
  assert_patch_ok("rfc6902_suite_050: null value should be valid obj property to be removed", "{\"foo\":null}", "[{\"op\":\"remove\",\"path\":\"/foo\"}]", "{}")
}

///|
test "rfc6902_suite_051" {
  assert_patch_ok("rfc6902_suite_051: null value should still be valid obj property replace other value", "{\"foo\":\"bar\"}", "[{\"op\":\"replace\",\"path\":\"/foo\",\"value\":null}]", "{\"foo\":null}")
}

///|
test "rfc6902_suite_052" {
  assert_patch_ok("rfc6902_suite_052: test should pass despite rearrangement", "{\"foo\":{\"foo\":1,\"bar\":2}}", "[{\"op\":\"test\",\"path\":\"/foo\",\"value\":{\"bar\":2,\"foo\":1}}]", "{\"foo\":{\"foo\":1,\"bar\":2}}")
}

///|
test "rfc6902_suite_053" {
  assert_patch_ok("rfc6902_suite_053: test should pass despite (nested) rearrangement", "{\"foo\":[{\"foo\":1,\"bar\":2}]}", "[{\"op\":\"test\",\"path\":\"/foo\",\"value\":[{\"bar\":2,\"foo\":1}]}]", "{\"foo\":[{\"foo\":1,\"bar\":2}]}")
}

///|
test "rfc6902_suite_054" {
  assert_patch_ok("rfc6902_suite_054: test should pass - no error", "{\"foo\":{\"bar\":[1,2,5,4]}}", "[{\"op\":\"test\",\"path\":\"/foo\",\"value\":{\"bar\":[1,2,5,4]}}]", "{\"foo\":{\"bar\":[1,2,5,4]}}")
}

///|
test "rfc6902_suite_055" {
  assert_patch_err("rfc6902_suite_055: case_55", "{\"foo\":{\"bar\":[1,2,5,4]}}", "[{\"op\":\"test\",\"path\":\"/foo\",\"value\":[1,2]}]")
}

///|
test "rfc6902_suite_057" {
  assert_patch_ok("rfc6902_suite_057: Empty-string element", "{\"\":1}", "[{\"op\":\"test\",\"path\":\"/\",\"value\":1}]", "{\"\":1}")
}

///|
test "rfc6902_suite_058" {
  assert_patch_ok("rfc6902_suite_058: case_58", "{\"foo\":[\"bar\",\"baz\"],\"\":0,\"a/b\":1,\"c%d\":2,\"e^f\":3,\"g|h\":4,\"i\\\\j\":5,\"k\\\"l\":6,\" \":7,\"m~n\":8}", "[{\"op\":\"test\",\"path\":\"/foo\",\"value\":[\"bar\",\"baz\"]},{\"op\":\"test\",\"path\":\"/foo/0\",\"value\":\"bar\"},{\"op\":\"test\",\"path\":\"/\",\"value\":0},{\"op\":\"test\",\"path\":\"/a~1b\",\"value\":1},{\"op\":\"test\",\"path\":\"/c%d\",\"value\":2},{\"op\":\"test\",\"path\":\"/e^f\",\"value\":3},{\"op\":\"test\",\"path\":\"/g|h\",\"value\":4},{\"op\":\"test\",\"path\":\"/i\\\\j\",\"value\":5},{\"op\":\"test\",\"path\":\"/k\\\"l\",\"value\":6},{\"op\":\"test\",\"path\":\"/ \",\"value\":7},{\"op\":\"test\",\"path\":\"/m~0n\",\"value\":8}]", "{\"\":0,\" \":7,\"a/b\":1,\"c%d\":2,\"e^f\":3,\"foo\":[\"bar\",\"baz\"],\"g|h\":4,\"i\\\\j\":5,\"k\\\"l\":6,\"m~n\":8}")
}

///|
test "rfc6902_suite_059" {
  assert_patch_ok("rfc6902_suite_059: Move to same location has no effect", "{\"foo\":1}", "[{\"op\":\"move\",\"from\":\"/foo\",\"path\":\"/foo\"}]", "{\"foo\":1}")
}

///|
test "rfc6902_suite_060" {
  assert_patch_ok("rfc6902_suite_060: case_60", "{\"foo\":1,\"baz\":[{\"qux\":\"hello\"}]}", "[{\"op\":\"move\",\"from\":\"/foo\",\"path\":\"/bar\"}]", "{\"baz\":[{\"qux\":\"hello\"}],\"bar\":1}")
}

///|
test "rfc6902_suite_061" {
  assert_patch_ok("rfc6902_suite_061: case_61", "{\"baz\":[{\"qux\":\"hello\"}],\"bar\":1}", "[{\"op\":\"move\",\"from\":\"/baz/0/qux\",\"path\":\"/baz/1\"}]", "{\"baz\":[{},\"hello\"],\"bar\":1}")
}

///|
test "rfc6902_suite_062" {
  assert_patch_ok("rfc6902_suite_062: case_62", "{\"baz\":[{\"qux\":\"hello\"}],\"bar\":1}", "[{\"op\":\"copy\",\"from\":\"/baz/0\",\"path\":\"/boo\"}]", "{\"baz\":[{\"qux\":\"hello\"}],\"bar\":1,\"boo\":{\"qux\":\"hello\"}}")
}

///|
test "rfc6902_suite_063" {
  assert_patch_ok("rfc6902_suite_063: replacing the root of the document is possible with add", "{\"foo\":\"bar\"}", "[{\"op\":\"add\",\"path\":\"\",\"value\":{\"baz\":\"qux\"}}]", "{\"baz\":\"qux\"}")
}

///|
test "rfc6902_suite_064" {
  assert_patch_ok("rfc6902_suite_064: Adding to '/-' adds to the end of the array", "[1,2]", "[{\"op\":\"add\",\"path\":\"/-\",\"value\":{\"foo\":[\"bar\",\"baz\"]}}]", "[1,2,{\"foo\":[\"bar\",\"baz\"]}]")
}

///|
test "rfc6902_suite_065" {
  assert_patch_ok("rfc6902_suite_065: Adding to '/-' adds to the end of the array, even n levels down", "[1,2,[3,[4,5]]]", "[{\"op\":\"add\",\"path\":\"/2/1/-\",\"value\":{\"foo\":[\"bar\",\"baz\"]}}]", "[1,2,[3,[4,5,{\"foo\":[\"bar\",\"baz\"]}]]]")
}

///|
test "rfc6902_suite_066" {
  assert_patch_err("rfc6902_suite_066: test remove with bad number should fail", "{\"foo\":1,\"baz\":[{\"qux\":\"hello\"}]}", "[{\"op\":\"remove\",\"path\":\"/baz/1e0/qux\"}]")
}

///|
test "rfc6902_suite_067" {
  assert_patch_ok("rfc6902_suite_067: test remove on array", "[1,2,3,4]", "[{\"op\":\"remove\",\"path\":\"/0\"}]", "[2,3,4]")
}

///|
test "rfc6902_suite_068" {
  assert_patch_ok("rfc6902_suite_068: test repeated removes", "[1,2,3,4]", "[{\"op\":\"remove\",\"path\":\"/1\"},{\"op\":\"remove\",\"path\":\"/2\"}]", "[1,3]")
}

///|
test "rfc6902_suite_069" {
  assert_patch_err("rfc6902_suite_069: test remove with bad index should fail", "[1,2,3,4]", "[{\"op\":\"remove\",\"path\":\"/1e0\"}]")
}

///|
test "rfc6902_suite_070" {
  assert_patch_err("rfc6902_suite_070: test replace with bad number should fail", "[\"\"]", "[{\"op\":\"replace\",\"path\":\"/1e0\",\"value\":false}]")
}

///|
test "rfc6902_suite_071" {
  assert_patch_err("rfc6902_suite_071: test copy with bad number should fail", "{\"baz\":[1,2,3],\"bar\":1}", "[{\"op\":\"copy\",\"from\":\"/baz/1e0\",\"path\":\"/boo\"}]")
}

///|
test "rfc6902_suite_072" {
  assert_patch_err("rfc6902_suite_072: test move with bad number should fail", "{\"foo\":1,\"baz\":[1,2,3,4]}", "[{\"op\":\"move\",\"from\":\"/baz/1e0\",\"path\":\"/foo\"}]")
}

///|
test "rfc6902_suite_073" {
  assert_patch_err("rfc6902_suite_073: test add with bad number should fail", "[\"foo\",\"sil\"]", "[{\"op\":\"add\",\"path\":\"/1e0\",\"value\":\"bar\"}]")
}

///|
test "rfc6902_suite_074" {
  assert_patch_err("rfc6902_suite_074: missing 'path' parameter", "{}", "[{\"op\":\"add\",\"value\":\"bar\"}]")
}

///|
test "rfc6902_suite_075" {
  assert_patch_err("rfc6902_suite_075: 'path' parameter with null value", "{}", "[{\"op\":\"add\",\"path\":null,\"value\":\"bar\"}]")
}

///|
test "rfc6902_suite_076" {
  assert_patch_err("rfc6902_suite_076: invalid JSON Pointer token", "{}", "[{\"op\":\"add\",\"path\":\"foo\",\"value\":\"bar\"}]")
}

///|
test "rfc6902_suite_077" {
  assert_patch_err("rfc6902_suite_077: missing 'value' parameter to add", "[1]", "[{\"op\":\"add\",\"path\":\"/-\"}]")
}

///|
test "rfc6902_suite_078" {
  assert_patch_err("rfc6902_suite_078: missing 'value' parameter to replace", "[1]", "[{\"op\":\"replace\",\"path\":\"/0\"}]")
}

///|
test "rfc6902_suite_079" {
  assert_patch_err("rfc6902_suite_079: missing 'value' parameter to test", "[null]", "[{\"op\":\"test\",\"path\":\"/0\"}]")
}

///|
test "rfc6902_suite_080" {
  assert_patch_err("rfc6902_suite_080: missing value parameter to test - where undef is falsy", "[false]", "[{\"op\":\"test\",\"path\":\"/0\"}]")
}

///|
test "rfc6902_suite_081" {
  assert_patch_err("rfc6902_suite_081: missing from parameter to copy", "[1]", "[{\"op\":\"copy\",\"path\":\"/-\"}]")
}

///|
test "rfc6902_suite_082" {
  assert_patch_err("rfc6902_suite_082: missing from location to copy", "{\"foo\":1}", "[{\"op\":\"copy\",\"from\":\"/bar\",\"path\":\"/foo\"}]")
}

///|
test "rfc6902_suite_083" {
  assert_patch_err("rfc6902_suite_083: missing from parameter to move", "{\"foo\":1}", "[{\"op\":\"move\",\"path\":\"\"}]")
}

///|
test "rfc6902_suite_084" {
  assert_patch_err("rfc6902_suite_084: missing from location to move", "{\"foo\":1}", "[{\"op\":\"move\",\"from\":\"/bar\",\"path\":\"/foo\"}]")
}

///|
test "rfc6902_suite_086" {
  assert_patch_err("rfc6902_suite_086: unrecognized op should fail", "{\"foo\":1}", "[{\"op\":\"spam\",\"path\":\"/foo\",\"value\":1}]")
}

///|
test "rfc6902_suite_087" {
  assert_patch_err("rfc6902_suite_087: test with bad array number that has leading zeros", "[\"foo\",\"bar\"]", "[{\"op\":\"test\",\"path\":\"/00\",\"value\":\"foo\"}]")
}

///|
test "rfc6902_suite_088" {
  assert_patch_err("rfc6902_suite_088: test with bad array number that has leading zeros", "[\"foo\",\"bar\"]", "[{\"op\":\"test\",\"path\":\"/01\",\"value\":\"bar\"}]")
}

///|
test "rfc6902_suite_089" {
  assert_patch_err("rfc6902_suite_089: Removing nonexistent field", "{\"foo\":\"bar\"}", "[{\"op\":\"remove\",\"path\":\"/baz\"}]")
}

///|
test "rfc6902_suite_090" {
  assert_patch_err("rfc6902_suite_090: Removing deep nonexistent path", "{\"foo\":\"bar\"}", "[{\"op\":\"remove\",\"path\":\"/missing1/missing2\"}]")
}

///|
test "rfc6902_suite_091" {
  assert_patch_err("rfc6902_suite_091: Removing nonexistent index", "[\"foo\",\"bar\"]", "[{\"op\":\"remove\",\"path\":\"/2\"}]")
}

///|
test "rfc6902_suite_092" {
  assert_patch_ok("rfc6902_suite_092: Patch with different capitalisation than doc", "{\"foo\":\"bar\"}", "[{\"op\":\"add\",\"path\":\"/FOO\",\"value\":\"BAR\"}]", "{\"foo\":\"bar\",\"FOO\":\"BAR\"}")
}

///|
test "rfc6902_suite_093" {
  assert_patch_ok("rfc6902_suite_093: test copy object then change destination", "{\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}}}", "[{\"op\":\"copy\",\"from\":\"/foo\",\"path\":\"/bak\"},{\"op\":\"replace\",\"path\":\"/bak/bar/baz/0/boo\",\"value\":\"qux\"}]", "{\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}},\"bak\":{\"bar\":{\"baz\":[{\"boo\":\"qux\"}]}}}")
}

///|
test "rfc6902_suite_094" {
  assert_patch_ok("rfc6902_suite_094: test copy object then change source", "{\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}}}", "[{\"op\":\"copy\",\"from\":\"/foo\",\"path\":\"/bak\"},{\"op\":\"replace\",\"path\":\"/foo/bar/baz/0/boo\",\"value\":\"qux\"}]", "{\"foo\":{\"bar\":{\"baz\":[{\"boo\":\"qux\"}]}},\"bak\":{\"bar\":{\"baz\":[{\"boo\":\"net\"}]}}}")
}
