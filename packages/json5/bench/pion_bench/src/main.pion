///| Steady-state JSON5 / JSON roundtrip / RFC 6901+6902 benchmark (Pion Native).

import "json5"

struct Stats {
  mut objects : Int64
  mut arrays : Int64
  mut keys : Int64
  mut strings : Int64
  mut numbers : Int64
  mut bools : Int64
  mut bool_true : Int64
  mut nulls : Int64
  mut str_bytes : Int64
  mut key_hash : Int64
  mut str_hash : Int64
}

fn poly_hash(s : String) -> Int64 {
  let mut h : Int64 = 17L
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h * 131L + s.code_unit_at(i).to_int64()) % 1000000007L
    i = i + 1
  }
  h
}

fn walk_val(st : Stats, v : json5::Json5Value) -> Unit {
  match v {
    json5::Json5Value::Null => st.nulls = st.nulls + 1L
    json5::Json5Value::Bool(b) => {
      st.bools = st.bools + 1L
      if b {
        st.bool_true = st.bool_true + 1L
      }
    }
    json5::Json5Value::Number(_) => st.numbers = st.numbers + 1L
    json5::Json5Value::Str(s) => {
      st.strings = st.strings + 1L
      st.str_bytes = st.str_bytes + s.length().to_int64()
      st.str_hash = (st.str_hash + poly_hash(s)) % 1000000007L
    }
    json5::Json5Value::Array(items) => {
      st.arrays = st.arrays + 1L
      let n = items.length()
      let mut i = 0
      while i < n {
        walk_val(st, items[i])
        i = i + 1
      }
    }
    json5::Json5Value::Object(entries) => {
      st.objects = st.objects + 1L
      let n = entries.length()
      st.keys = st.keys + n.to_int64()
      let mut i = 0
      while i < n {
        let (k, child) = entries[i]
        st.key_hash = (st.key_hash + poly_hash(k)) % 1000000007L
        walk_val(st, child)
        i = i + 1
      }
    }
  }
}

fn parse_pos_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      acc = acc * 10 + (b - 48)
    }
    i = i + 1
  }
  acc
}

fn run_parse(world : World, path : String, iters : Int) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }
  let st = Stats::{
    objects: 0L,
    arrays: 0L,
    keys: 0L,
    strings: 0L,
    numbers: 0L,
    bools: 0L,
    bool_true: 0L,
    nulls: 0L,
    str_bytes: 0L,
    key_hash: 0L,
    str_hash: 0L,
  }
  let mut iter = 0
  while iter < iters {
    let parsed = match json5::parse(content) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "parse error: " + e.message)
        return 1
      }
    }
    walk_val(st, parsed)
    iter = iter + 1
  }
  io_println(world, "mode=parse")
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "objects=" + st.objects.to_string())
  io_println(world, "arrays=" + st.arrays.to_string())
  io_println(world, "keys=" + st.keys.to_string())
  io_println(world, "strings=" + st.strings.to_string())
  io_println(world, "numbers=" + st.numbers.to_string())
  io_println(world, "bools=" + st.bools.to_string())
  io_println(world, "bool_true=" + st.bool_true.to_string())
  io_println(world, "nulls=" + st.nulls.to_string())
  io_println(world, "str_bytes=" + st.str_bytes.to_string())
  io_println(world, "key_hash=" + st.key_hash.to_string())
  io_println(world, "str_hash=" + st.str_hash.to_string())
  0
}

fn run_roundtrip(world : World, path : String, iters : Int) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input")
      return 1
    }
  }
  let mut total_bytes : Int64 = 0L
  let mut out_hash : Int64 = 0L
  let mut iter = 0
  while iter < iters {
    let parsed = match json5::parse(content) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "parse error: " + e.message)
        return 1
      }
    }
    let encoded = match json5::to_json_string(parsed) {
      Ok(s) => s
      Err(e) => {
        io_println(world, "encode error: " + e.message)
        return 1
      }
    }
    total_bytes = total_bytes + encoded.length().to_int64()
    out_hash = (out_hash + poly_hash(encoded)) % 1000000007L
    iter = iter + 1
  }
  io_println(world, "mode=roundtrip")
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "out_hash=" + out_hash.to_string())
  0
}

fn run_patch(
  world : World,
  doc_path : String,
  patch_path : String,
  ops_each : Int,
) -> Int {
  let doc_src = match fs_read(world, doc_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read doc")
      return 1
    }
  }
  let patch_src = match fs_read(world, patch_path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read patch")
      return 1
    }
  }
  let doc = match json5::parse(doc_src) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "doc parse error: " + e.message)
      return 1
    }
  }
  let patch = match json5::parse_patch(patch_src) {
    Ok(p) => p
    Err(e) => {
      io_println(world, "patch parse error: " + e.message)
      return 1
    }
  }
  let ptrs = [
    "/service",
    "/a~1b/m~0n",
    "/config/host",
    "/config/port",
    "/config/tags/2",
    "/config/limits/max_conn",
    "/routes/1/path",
    "/routes/2/enabled",
  ]
  let mut ptr_hits : Int64 = 0L
  let mut ptr_hash : Int64 = 0L
  let mut i = 0
  while i < ops_each {
    let p = ptrs[i % 8]
    match json5::pointer_get(doc, p) {
      Ok(Some(v)) => {
        ptr_hits = ptr_hits + 1L
        match v {
          json5::Json5Value::Str(s) => ptr_hash = (ptr_hash + poly_hash(s)) % 1000000007L
          json5::Json5Value::Number(x) => ptr_hash = (ptr_hash + x.to_int64()) % 1000000007L
          json5::Json5Value::Bool(b) => ptr_hash = (ptr_hash + (if b { 1L } else { 0L })) % 1000000007L
          _ => ()
        }
      }
      _ => ()
    }
    i = i + 1
  }

  let mut patch_ok : Int64 = 0L
  let mut patch_hash : Int64 = 0L
  let mut j = 0
  while j < ops_each {
    match json5::apply_patch(doc, patch) {
      Ok(res) => {
        patch_ok = patch_ok + 1L
        match json5::pointer_get(res, "/copied_label") {
          Ok(Some(json5::Json5Value::Str(s))) =>
          patch_hash = (patch_hash + poly_hash(s)) % 1000000007L
          _ => ()
        }
      }
      Err(e) => {
        io_println(world, "apply_patch error: " + e.message)
        return 1
      }
    }
    j = j + 1
  }

  io_println(world, "mode=patch")
  io_println(world, "ops_each=" + ops_each.to_string())
  io_println(world, "ptr_hits=" + ptr_hits.to_string())
  io_println(world, "ptr_hash=" + ptr_hash.to_string())
  io_println(world, "patch_ok=" + patch_ok.to_string())
  io_println(world, "patch_hash=" + patch_hash.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: json5_bench <parse|roundtrip|patch> ...")
    return 1
  }
  let mode = args[1]
  if mode == "parse" {
    run_parse(world, args[2], parse_pos_int(args[3]))
  } else if mode == "roundtrip" {
    run_roundtrip(world, args[2], parse_pos_int(args[3]))
  } else if mode == "patch" && args.length() >= 5 {
    run_patch(world, args[2], args[3], parse_pos_int(args[4]))
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
