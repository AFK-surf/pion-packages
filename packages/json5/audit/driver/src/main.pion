///| Red-team differential driver for `packages/json5`.
///|
///| Every mode prints the exact same line format as `oracle/node/oracle.mjs`
///| (Node `json5@2.2.3` + `fast-json-patch@3.1.1`) and `oracle/rust`
///| (Rust `json5 =1.3.8` + `serde_json =1.0.140` + `json-patch =4.2.0`), so
///| `tools/compare.py` can diff them line by line.
///|
///| Canonical value dump (shared by all three implementations):
///|   null -> `n`, true/false -> `t`/`f`, number -> `d<16 hex IEEE-754 bits>` (`dNaN` for any NaN),
///|   string -> `s<hex UTF-8>;`, array -> `[a,b]`, object -> `{<hex key>:<v>,...}` (document order).

import "json5"

///|
fn hexval(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    0
  }
}

///|
fn unhex(h : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i + 1 < h.length() {
    sb.write_byte(
      ((hexval(h.code_unit_at(i)) << 4) | hexval(h.code_unit_at(i + 1))).to_byte(),
    )
    i = i + 2
  }
  sb.to_string()
}

///|
fn hexdig(d : Int) -> Byte {
  if d < 10 {
    (48 + d).to_byte()
  } else {
    (87 + d).to_byte()
  }
}

///|
fn write_hex_str(sb : StringBuilder, s : String) -> Unit {
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    sb.write_byte(hexdig((b >> 4) & 15))
    sb.write_byte(hexdig(b & 15))
    i = i + 1
  }
}

///|
fn write_hex64(sb : StringBuilder, x : Int64) -> Unit {
  let mut sh = 60
  while sh >= 0 {
    sb.write_byte(hexdig(((x >> sh) & 15L).to_int()))
    sh = sh - 4
  }
}

///|
fn parse_hex64(h : String) -> Int64 {
  let mut acc = 0L
  let mut i = 0
  while i < h.length() {
    acc = (acc << 4) | hexval(h.code_unit_at(i)).to_int64()
    i = i + 1
  }
  acc
}

///|
fn write_num(sb : StringBuilder, x : Double) -> Unit {
  if x != x {
    sb.write_string("dNaN")
  } else {
    sb.write_byte((100).to_byte())
    write_hex64(sb, x.reinterpret_as_uint64().reinterpret_as_int64())
  }
}

///| Canonical dump (recursive; only used on shallow differential inputs).
fn canon(sb : StringBuilder, v : json5::Json5Value) -> Unit {
  match v {
    json5::Json5Value::Null => sb.write_byte((110).to_byte())
    json5::Json5Value::Bool(b) => sb.write_byte((if b { 116 } else { 102 }).to_byte())
    json5::Json5Value::Number(x) => write_num(sb, x)
    json5::Json5Value::Str(s) => {
      sb.write_byte((115).to_byte())
      write_hex_str(sb, s)
      sb.write_byte((59).to_byte())
    }
    json5::Json5Value::Array(items) => {
      sb.write_byte((91).to_byte())
      let mut i = 0
      while i < items.length() {
        if i > 0 {
          sb.write_byte((44).to_byte())
        }
        canon(sb, items[i])
        i = i + 1
      }
      sb.write_byte((93).to_byte())
    }
    json5::Json5Value::Object(entries) => {
      sb.write_byte((123).to_byte())
      let mut i = 0
      while i < entries.length() {
        if i > 0 {
          sb.write_byte((44).to_byte())
        }
        let (k, e) = entries[i]
        write_hex_str(sb, k)
        sb.write_byte((58).to_byte())
        canon(sb, e)
        i = i + 1
      }
      sb.write_byte((125).to_byte())
    }
  }
}

///|
fn split_lines(content : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  let n = content.length()
  while i < n {
    if content.code_unit_at(i) == 10 {
      out.push(content.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(content.slice(start, n))
  }
  out
}

///| Split a line on the first space.
fn split2(line : String) -> (String, String) {
  let mut i = 0
  while i < line.length() {
    if line.code_unit_at(i) == 32 {
      return (line.slice(0, i), line.slice(i + 1, line.length()))
    }
    i = i + 1
  }
  (line, "")
}

///|
fn opts_for(mode : String) -> json5::ParseOptions {
  if mode == "json" {
    json5::ParseOptions::strict_json()
  } else if mode == "jsonc" {
    json5::ParseOptions::jsonc()
  } else if mode == "j5inf" {
    // JSON5 with overflow to +-Infinity (what Node json5 / ES5.1 do)
    let d = json5::ParseOptions::default()
    json5::ParseOptions::{
      max_depth: d.max_depth,
      max_nodes: d.max_nodes,
      duplicate_keys: d.duplicate_keys,
      allow_json5: true,
      allow_comments: true,
      allow_trailing_commas: true,
      reject_overflow: false,
    }
  } else {
    json5::ParseOptions::default()
  }
}

///| `parse <file> <j5|j5inf|jsonc|json>`: one hex-encoded document per line.
fn run_parse(world : World, path : String, mode : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 2
  }
  let opts = opts_for(mode)
  let lines = split_lines(content)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    match json5::parse_with_options(unhex(lines[i]), opts) {
      Ok(v) => {
        sb.write_string("OK ")
        canon(sb, v)
      }
      Err(_) => sb.write_string("ERR")
    }
    sb.write_byte((10).to_byte())
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

///|
fn utf8_of(cp : Int) -> String {
  let sb = StringBuilder::new()
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
  sb.to_string()
}

///|
fn esc4(cp : Int) -> String {
  let sb = StringBuilder::new()
  sb.write_string("\\u")
  sb.write_byte(hexdig((cp >> 12) & 15))
  sb.write_byte(hexdig((cp >> 8) & 15))
  sb.write_byte(hexdig((cp >> 4) & 15))
  sb.write_byte(hexdig(cp & 15))
  sb.to_string()
}

///|
fn ok(src : String) -> Bool {
  match json5::parse(src) {
    Ok(_) => true
    Err(_) => false
  }
}

///| `idscan`: one char per code point 0x80..0x10FFFF (surrogates skipped), 'A' + mask:
///| 1 = `{X:1}`, 2 = `{aX:1}`, 4 = `[X1]` (whitespace), 8 = `{\uXXXX:1}`, 16 = `{a\uXXXX:1}`.
fn run_idscan(world : World) -> Int {
  let sb = StringBuilder::new()
  let mut cp = 0x80
  let mut col = 0
  while cp <= 0x10FFFF {
    if cp >= 0xD800 && cp <= 0xDFFF {
      cp = 0xE000
      continue
    }
    let x = utf8_of(cp)
    let mut m = 0
    if ok("{" + x + ":1}") {
      m = m | 1
    }
    if ok("{a" + x + ":1}") {
      m = m | 2
    }
    if ok("[" + x + "1]") {
      m = m | 4
    }
    if cp < 0x10000 {
      let e = esc4(cp)
      if ok("{" + e + ":1}") {
        m = m | 8
      }
      if ok("{a" + e + ":1}") {
        m = m | 16
      }
    }
    sb.write_byte((65 + m).to_byte())
    col = col + 1
    if col == 256 {
      sb.write_byte((10).to_byte())
      col = 0
    }
    cp = cp + 1
  }
  sb.write_byte((10).to_byte())
  io_print(world, sb.to_string())
  0
}

///| `numfmt <file>`: one 16-hex IEEE-754 bit pattern per line ->
///| `<to_json_string> <bits of parse(to_json_string)>`.
fn run_numfmt(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 2
  }
  let lines = split_lines(content)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let x = Double::from_bits(parse_hex64(lines[i]))
    match json5::to_json_string(json5::Json5Value::Number(x)) {
      Ok(s) => {
        sb.write_string(s)
        sb.write_byte((32).to_byte())
        match json5::parse(s) {
          Ok(json5::Json5Value::Number(y)) => write_num(sb, y)
          _ => sb.write_string("ERR")
        }
      }
      Err(_) => sb.write_string("ERR")
    }
    sb.write_byte((10).to_byte())
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

///| `ptr <file>`: lines `<hex doc> <hex pointer>` -> `OK <canon>` / `NONE` / `ERR`.
fn run_ptr(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 2
  }
  let lines = split_lines(content)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let (dh, ph) = split2(lines[i])
    match json5::parse(unhex(dh)) {
      Ok(doc) =>
      match json5::pointer_get(doc, unhex(ph)) {
        Ok(Some(v)) => {
          sb.write_string("OK ")
          canon(sb, v)
        }
        Ok(None) => sb.write_string("NONE")
        Err(_) => sb.write_string("ERR")
      }
      Err(_) => sb.write_string("BADDOC")
    }
    sb.write_byte((10).to_byte())
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

///| `patch <file>`: lines `<hex doc> <hex patch>` -> `OK <canon>` / `ERR`.
fn run_patch(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 2
  }
  let lines = split_lines(content)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let (dh, ph) = split2(lines[i])
    match json5::parse(unhex(dh)) {
      Ok(doc) =>
      match json5::parse_patch(unhex(ph)) {
        Ok(p) =>
        match json5::apply_patch(doc, p) {
          Ok(v) => {
            sb.write_string("OK ")
            canon(sb, v)
          }
          Err(_) => sb.write_string("ERR")
        }
        Err(_) => sb.write_string("ERR")
      }
      Err(_) => sb.write_string("BADDOC")
    }
    sb.write_byte((10).to_byte())
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

///| `diffrt <file>`: lines `<hex a> <hex b>` ->
///| `<RT|BAD> <op count> <hex of to_json_string(patch)>`.
fn run_diffrt(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 2
  }
  let lines = split_lines(content)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let (ah, bh) = split2(lines[i])
    match (json5::parse(unhex(ah)), json5::parse(unhex(bh))) {
      (Ok(a), Ok(b)) => {
        let p = json5::diff(a, b)
        let good = match json5::apply_patch(a, p) {
          Ok(r) => json5::value_eq(r, b)
          Err(_) => false
        }
        sb.write_string(if good { "RT " } else { "BAD " })
        sb.write_string(p.ops.length().to_string())
        sb.write_byte((32).to_byte())
        match json5::to_json_string(json5::patch_to_value(p)) {
          Ok(s) => write_hex_str(sb, s)
          Err(_) => sb.write_string("ERR")
        }
      }
      _ => sb.write_string("BADDOC")
    }
    sb.write_byte((10).to_byte())
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

///|
fn parse_pos_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      acc = acc * 10 + (b - 48)
    }
    i = i + 1
  }
  acc
}

///|
fn deep_opts(depth : Int) -> json5::ParseOptions {
  json5::ParseOptions::{
    max_depth: depth + 8,
    max_nodes: depth * 2 + 64,
    duplicate_keys: json5::DuplicateKeyPolicy::LastWins,
    allow_json5: true,
    allow_comments: true,
    allow_trailing_commas: true,
    reject_overflow: true,
  }
}

///|
fn deep_src(depth : Int, leaf : String, obj : Bool) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_string(if obj { "{a:" } else { "[" })
    i = i + 1
  }
  sb.write_string(leaf)
  i = 0
  while i < depth {
    sb.write_string(if obj { "}" } else { "]" })
    i = i + 1
  }
  sb.to_string()
}

///| `deep <depth> <kind>`: build a `depth`-deep tree (arrays; `kind` ending in `_obj` uses `{a:...}`)
///| and run one operation on it. Prints `ok <kind> <depth>`; a crash shows as a signal / trap exit.
fn run_deep(world : World, depth : Int, kind : String) -> Int {
  if kind == "build" {
    // Build the nested array without the parser (iterative loop), then let it drop.
    let mut v = json5::Json5Value::Number(1.0)
    let mut i = 0
    while i < depth {
      v = json5::Json5Value::Array([v])
      i = i + 1
    }
    io_println(world, "built " + json5::value_len(v).to_string())
    io_println(world, "ok " + kind + " " + depth.to_string())
    return 0
  }
  if kind == "patchgrow" {
    // Default ParseOptions only: a JSON Patch of 3 constant-size ops per level
    // (add /b {}, move /a -> /b/a, move /b -> /a) nests the document one level deeper each round.
    let sb = StringBuilder::new()
    sb.write_byte((91).to_byte())
    let mut i = 0
    while i < depth {
      if i > 0 {
        sb.write_byte((44).to_byte())
      }
      sb.write_string(
        "{op:'add',path:'/b',value:{}},{op:'move',from:'/a',path:'/b/a'},{op:'move',from:'/b',path:'/a'}",
      )
      i = i + 1
    }
    sb.write_byte((93).to_byte())
    let patch = match json5::parse_patch(sb.to_string()) {
      Ok(p) => p
      Err(e) => {
        io_println(world, "patch parse error: " + e.message)
        return 3
      }
    }
    match json5::apply_patch(json5::Json5Value::Object([("a", json5::Json5Value::Null)]), patch) {
      Ok(_) => ()
      Err(e) => {
        io_println(world, "apply error: " + e.message)
        return 4
      }
    }
    io_println(world, "ok " + kind + " " + depth.to_string())
    return 0
  }
  let obj = kind.length() > 4 && kind.slice(kind.length() - 4, kind.length()) == "_obj"
  let base = if obj { kind.slice(0, kind.length() - 4) } else { kind }
  let opts = deep_opts(depth)
  let a = match json5::parse_with_options(deep_src(depth, "1", obj), opts) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "parse error: " + e.message)
      return 3
    }
  }
  if base == "parse" {
    // the value is dropped when `a` goes out of scope
    ()
  } else if base == "json" {
    match json5::to_json_string(a) {
      Ok(s) => io_println(world, "len=" + s.length().to_string())
      Err(_) => return 4
    }
  } else if base == "eq" {
    let b = match json5::parse_with_options(deep_src(depth, "1", obj), opts) {
      Ok(v) => v
      Err(_) => return 3
    }
    io_println(world, "eq=" + json5::value_eq(a, b).to_string())
  } else if base == "clone" {
    match json5::apply_patch(a, json5::Patch::{ ops: [] }) {
      Ok(_) => ()
      Err(_) => return 4
    }
  } else if base == "diff" {
    let b = match json5::parse_with_options(deep_src(depth, "2", obj), opts) {
      Ok(v) => v
      Err(_) => return 3
    }
    let p = json5::diff(a, b)
    io_println(world, "ops=" + p.ops.length().to_string())
  } else if base == "copy" {
    match json5::apply_patch(
      json5::Json5Value::Object([("x", a)]),
      json5::Patch::{ ops: [json5::PatchOp::Copy("/x", "/y")] },
    ) {
      Ok(_) => ()
      Err(_) => return 4
    }
  } else {
    io_println(world, "unknown kind")
    return 2
  }
  io_println(world, "ok " + kind + " " + depth.to_string())
  0
}

///|
fn wide_src(n : Int, change : Int) -> String {
  let sb = StringBuilder::new()
  sb.write_byte((123).to_byte())
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_byte((44).to_byte())
    }
    sb.write_string("\"k")
    sb.write_string(i.to_string())
    sb.write_string("\":")
    sb.write_string(if i == change { "-1" } else { i.to_string() })
    i = i + 1
  }
  sb.write_byte((125).to_byte())
  sb.to_string()
}

///| `wide <n> <parse|eq|diff|test|ptr>`: one operation on an `n`-key object; prints a stable digest.
fn run_wide(world : World, n : Int, kind : String) -> Int {
  let a = match json5::parse(wide_src(n, -1)) {
    Ok(v) => v
    Err(_) => return 3
  }
  if kind == "parse" {
    io_println(world, "keys=" + json5::value_len(a).to_string())
  } else if kind == "eq" {
    let b = match json5::parse(wide_src(n, -1)) {
      Ok(v) => v
      Err(_) => return 3
    }
    io_println(world, "eq=" + json5::value_eq(a, b).to_string())
  } else if kind == "diff" {
    let b = match json5::parse(wide_src(n, n / 2)) {
      Ok(v) => v
      Err(_) => return 3
    }
    io_println(world, "ops=" + json5::diff(a, b).ops.length().to_string())
  } else if kind == "test" {
    let b = match json5::parse(wide_src(n, -1)) {
      Ok(v) => v
      Err(_) => return 3
    }
    let r = json5::apply_patch(
      json5::Json5Value::Object([("d", a)]),
      json5::Patch::{ ops: [json5::PatchOp::Test("/d", b)] },
    )
    io_println(
      world,
      "test=" +
      (match r {
        Ok(_) => "ok"
        Err(_) => "fail"
      }),
    )
  } else if kind == "ptr" {
    let mut hits = 0
    let mut i = 0
    while i < n {
      match json5::pointer_get(a, "/k" + i.to_string()) {
        Ok(Some(_)) => hits = hits + 1
        _ => ()
      }
      i = i + 1
    }
    io_println(world, "hits=" + hits.to_string())
  } else {
    return 2
  }
  0
}

///|
fn read_doc(world : World, path : String) -> json5::Json5Value {
  match fs_read(world, path) {
    Ok(src) =>
    match json5::parse(src) {
      Ok(v) => v
      Err(e) => {
        io_eprintln(world, "parse error: " + e.message)
        json5::Json5Value::Null
      }
    }
    Err(_) => json5::Json5Value::Null
  }
}

///|
fn count_keys(v : json5::Json5Value, acc : FixedArray[Int]) -> Unit {
  match v {
    json5::Json5Value::Array(items) => {
      let mut i = 0
      while i < items.length() {
        count_keys(items[i], acc)
        i = i + 1
      }
    }
    json5::Json5Value::Object(entries) => {
      let mut i = 0
      while i < entries.length() {
        let (k, e) = entries[i]
        acc[0] = acc[0] + 1
        acc[1] = acc[1] + k.length()
        count_keys(e, acc)
        i = i + 1
      }
    }
    _ => ()
  }
}

///| `adv <workload> <files...>`: adversarial benchmark workloads. stdout is byte-identical to
///| `rust_oracle adv` and `oracle.mjs adv` (SHA-256 gated by scripts/bench_compare.py).
fn run_adv(world : World, args : Array[String]) -> Int {
  let w = args[2]
  if w == "unikeys" {
    let acc = FixedArray::make(2, 0)
    count_keys(read_doc(world, args[3]), acc)
    io_println(world, "keys=" + acc[0].to_string() + " key_bytes=" + acc[1].to_string())
  } else if w == "numbers" {
    match read_doc(world, args[3]) {
      json5::Json5Value::Array(items) => {
        let mut x = 0L
        let mut i = 0
        while i < items.length() {
          match items[i] {
            json5::Json5Value::Number(d) => x = x ^ d.reinterpret_as_uint64().reinterpret_as_int64()
            _ => ()
          }
          i = i + 1
        }
        let sb = StringBuilder::new()
        sb.write_string("n=" + items.length().to_string() + " xor=")
        write_hex64(sb, x)
        io_println(world, sb.to_string())
      }
      _ => return 3
    }
  } else if w == "widetest" {
    let a = read_doc(world, args[3])
    let b = read_doc(world, args[4])
    let r = json5::apply_patch(a, json5::Patch::{ ops: [json5::PatchOp::Test("", b)] })
    io_println(
      world,
      "test=" +
      (match r {
        Ok(_) => "ok"
        Err(_) => "fail"
      }),
    )
  } else if w == "diff" {
    let a = read_doc(world, args[3])
    let b = read_doc(world, args[4])
    io_println(world, "ops=" + json5::diff(a, b).ops.length().to_string())
  } else if w == "ptrwide" {
    let a = read_doc(world, args[3])
    let n = json5::value_len(a)
    let mut hits = 0
    let mut i = 0
    while i < n {
      match json5::pointer_get(a, "/k" + i.to_string()) {
        Ok(Some(_)) => hits = hits + 1
        _ => ()
      }
      i = i + 1
    }
    io_println(world, "hits=" + hits.to_string())
  } else if w == "bigapply" {
    let mut doc = read_doc(world, args[3])
    let iters = parse_pos_int(args[4])
    let mut i = 1
    while i <= iters {
      let p = json5::Patch::{
        ops: [json5::PatchOp::Replace("/meta/rev", json5::Json5Value::Number(i.to_double()))],
      }
      doc = match json5::apply_patch(doc, p) {
        Ok(v) => v
        Err(_) => return 4
      }
      i = i + 1
    }
    match json5::pointer_get(doc, "/meta/rev") {
      Ok(Some(v)) =>
      match json5::as_int(v) {
        Some(r) => io_println(world, "rev=" + r.to_string())
        None => return 5
      }
      _ => return 5
    }
  } else {
    return 2
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: driver <parse|idscan|numfmt|ptr|patch|diffrt|deep|wide> ...")
    return 1
  }
  let mode = args[1]
  if mode == "parse" && args.length() >= 4 {
    run_parse(world, args[2], args[3])
  } else if mode == "idscan" {
    run_idscan(world)
  } else if mode == "numfmt" && args.length() >= 3 {
    run_numfmt(world, args[2])
  } else if mode == "ptr" && args.length() >= 3 {
    run_ptr(world, args[2])
  } else if mode == "patch" && args.length() >= 3 {
    run_patch(world, args[2])
  } else if mode == "diffrt" && args.length() >= 3 {
    run_diffrt(world, args[2])
  } else if mode == "deep" && args.length() >= 4 {
    run_deep(world, parse_pos_int(args[2]), args[3])
  } else if mode == "adv" && args.length() >= 4 {
    run_adv(world, args)
  } else if mode == "wide" && args.length() >= 4 {
    run_wide(world, parse_pos_int(args[2]), args[3])
  } else {
    io_println(world, "bad args")
    1
  }
}
