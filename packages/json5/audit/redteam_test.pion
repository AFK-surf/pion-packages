///| Red-team prosecution tests for `packages/json5` @ b9f6a1f (feat/pkg-json5).
///|
///| Each `p*_` test asserts what the references do on the very same input:
///| Node `json5@2.2.3` (the JSON5 v2.0 reference implementation, Unicode 10 tables),
///| Rust `json5 =1.3.8` (Unicode 17 tables), `serde_json =1.0.140`, `json-patch =4.2.0`
///| and ECMAScript 5.1 / JSON5 v2.0. The live differential that produced every vector is
///| `run_audit.sh` (stages `ident`, `numbers`, `syntax`, `patch`, `deep`, `bench`).
///| A FAILING `p*_` test is evidence against Pion, not a broken test.
///|
///| `ctl_*` tests are controls: attacks the package survives. They pass and stay here so a
///| reviewer can see what was tried and found sound.
///|
///| Naming: `p1_*` silent wrong value / valid input rejected / invalid input accepted,
///|         `p2_*` divergence from a reference or policy gap.
///| P0 (process crash) evidence cannot live in a unit test: it kills the test binary.
///| It is in `run_audit.sh deep` (tools/depth_bisect.py) and REPORT.md.

import "json5"

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

///|
fn num_of(src : String) -> Option[Double] {
  match json5::parse(src) {
    Ok(json5::Json5Value::Number(x)) => Some(x)
    _ => None
  }
}

///|
fn bits_hex(x : Double) -> String {
  let v = x.reinterpret_as_uint64()
  let sb = StringBuilder::new()
  let mut sh = 60UL
  while true {
    let d = ((v >> sh) & 15UL).to_int()
    sb.write_byte((if d < 10 { 48 + d } else { 55 + d }).to_byte())
    if sh == 0UL {
      break
    }
    sh = sh - 4UL
  }
  sb.to_string()
}

///| Assert `src` parses to a number with exactly the IEEE-754 bits `want`.
fn expect_bits(src : String, want : Int64, failures : Array[String]) -> Unit {
  let w = Double::from_bits(want)
  match num_of(src) {
    Some(x) =>
    if x.reinterpret_as_uint64() != w.reinterpret_as_uint64() {
      failures.push(src + " -> 0x" + bits_hex(x) + " (want 0x" + bits_hex(w) + ")")
    }
    None => failures.push(src + " -> parse error (want 0x" + bits_hex(w) + ")")
  }
}

///|
fn accepts(src : String) -> Bool {
  match json5::parse(src) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn report(failures : Array[String], what : String) -> Unit {
  if failures.length() > 0 {
    let sb = StringBuilder::new()
    sb.write_string(what + ": " + failures.length().to_string() + " wrong:")
    let mut i = 0
    while i < failures.length() {
      sb.write_string("\n    " + failures[i])
      i = i + 1
    }
    debug_assert(false, sb.to_string())
  }
}

///|
fn obj1(k : String, v : json5::Json5Value) -> json5::Json5Value {
  json5::Json5Value::Object([(k, v)])
}

// ---------------------------------------------------------------------------
// P1: silent value corruption
// ---------------------------------------------------------------------------

///| JSON5 hex literals of 16+ digits are double-rounded: the first 15 digits are rounded to a
///| Double, then every further digit is folded in with `acc * 16 + d` (one more rounding each).
///| ES5.1 §9.3.1 requires the correctly rounded value for HexIntegerLiteral (V8 / Node json5 does
///| it; Rust json5 1.3.8 accumulates in u128 and converts once). In the 1,200-literal random hex
///| corpus Pion disagrees with BOTH references on 25 literals, all silently (no error).
test "p1_hex_literal_16plus_digits_double_rounded" {
  let f : Array[String] = []
  // 2^60 + 129: the 15-digit prefix 0x100000000000008 is a tie and rounds down, losing the sticky bit
  expect_bits("0x1000000000000081", 0x43B0000000000001L, f)
  expect_bits("0x7C64C675149ad201", 0x43DF19319D4526B5L, f)
  expect_bits("0x4f61027c9a6d620d1", 0x4413D8409F269B59L, f)
  expect_bits("0x026DEd6c5eB9FFDd8A5", 0x44436F6B62F5CFFFL, f)
  // the same values, negated and as object members
  expect_bits("-0x1000000000000081", 0xC3B0000000000001L, f)
  match json5::parse("{n: 0x1000000000000081}") {
    Ok(v) =>
    match json5::get(v, "n") {
      Some(json5::Json5Value::Number(x)) =>
      if x != Double::from_bits(0x43B0000000000001L) {
        f.push("{n: 0x1000000000000081}.n -> 0x" + bits_hex(x))
      }
      _ => f.push("{n: ...}: missing member")
    }
    Err(e) => f.push("{n: 0x1000000000000081} -> error " + e.message)
  }
  report(f, "hex literals (Node json5 + Rust json5 agree on every expected value)")
}

///| `is_es5_id_start` is a hand-written range table, not Unicode categories. Whole blocks of
///| digits, punctuation, symbols and emoji are accepted as the FIRST character of an unquoted
///| key. ES5.1 §7.6 allows only Lu/Ll/Lt/Lm/Lo/Nl, `$`, `_`. Node json5 and Rust json5 both reject
///| every input below. Full scan: 52,410 code points wrongly accepted as raw IdentifierStart where
///| both references reject (`run_audit.sh ident`).
test "p1_identifier_start_accepts_digits_symbols_emoji" {
  let bad = [
    "{\u{0660}:1}", // ARABIC-INDIC DIGIT ZERO (Nd): a digit cannot start an identifier
    "{\u{0966}:1}", // DEVANAGARI DIGIT ZERO (Nd)
    "{\u{FF10}:1}", // FULLWIDTH DIGIT ZERO (Nd)
    "{\u{1D7D8}:1}", // MATHEMATICAL DOUBLE-STRUCK DIGIT ZERO (Nd)
    "{\u{1F600}:1}", // GRINNING FACE (So)
    "{\u{1F389}:1}", // PARTY POPPER (So)
    "{\u{FF01}:1}", // FULLWIDTH EXCLAMATION MARK (Po)
    "{\u{FF04}:1}", // FULLWIDTH DOLLAR SIGN (Sc)
    "{\u{FF08}:1}", // FULLWIDTH LEFT PARENTHESIS (Ps)
    "{\u{3231}:1}", // PARENTHESIZED IDEOGRAPH STOCK (So)
    "{\u{2E3A}:1}", // TWO-EM DASH (Pd)
    "{\u{0589}:1}", // ARMENIAN FULL STOP (Po)
    "{\u{0964}:1}", // DEVANAGARI DANDA (Po)
    "{\u{0483}:1}", // COMBINING CYRILLIC TITLO (Mn): a mark cannot start an identifier
    "{\u{309B}:1}", // KATAKANA-HIRAGANA VOICED SOUND MARK (Sk)
    "{\u{2122}:1}", // TRADE MARK SIGN (So)
    "{\\u0660:1}", // the same digit through a \\u escape
    "{\\uFF01:1}",
    "{\\u3231:1}",
  ]
  let f : Array[String] = []
  let mut i = 0
  while i < bad.length() {
    if accepts(bad[i]) {
      f.push(bad[i] + " accepted")
    }
    i = i + 1
  }
  report(f, "invalid IdentifierStart accepted (Node json5 + Rust json5 reject all)")
}

///| The same table also accepts non-identifier characters in the middle of a key:
///| `a·` (U+00B7 MIDDLE DOT, Po), `a😀`, `a！`. Both references reject.
test "p1_identifier_part_accepts_punctuation_and_emoji" {
  let bad = ["{a\u{00B7}:1}", "{a\u{1F600}:1}", "{a\u{FF01}:1}", "{a\u{4DC0}:1}"]
  let f : Array[String] = []
  let mut i = 0
  while i < bad.length() {
    if accepts(bad[i]) {
      f.push(bad[i] + " accepted")
    }
    i = i + 1
  }
  report(f, "invalid IdentifierPart accepted (Node json5 + Rust json5 reject all)")
}

///| ...while real letters, marks and connector punctuation are REJECTED (valid JSON5 config files
///| fail to load). Both Node json5 (Unicode 10) and Rust json5 (Unicode 17) accept every input below.
test "p1_identifier_rejects_valid_letters_and_marks" {
  let good = [
    "{\u{207F}:1}", // SUPERSCRIPT LATIN SMALL LETTER N (Lm)
    "{\u{2071}:1}", // SUPERSCRIPT LATIN SMALL LETTER I (Lm)
    "{\u{2090}:1}", // LATIN SUBSCRIPT SMALL LETTER A (Lm)
    "{\u{D7B0}:1}", // HANGUL JUNGSEONG O-YEO (Lo)
    "{\u{D7FB}:1}", // HANGUL JONGSEONG PHIEUPH-THIEUTH (Lo)
    "{a\u{20D7}:1}", // COMBINING RIGHT ARROW ABOVE (Mn), e.g. a vector name
    "{a\u{20E5}:1}", // COMBINING REVERSE SOLIDUS OVERLAY (Mn)
    "{a\u{302A}:1}", // IDEOGRAPHIC LEVEL TONE MARK (Mn)
    "{a\u{2054}b:1}", // INVERTED UNDERTIE (Pc)
    "{a\u{E0100}:1}", // VARIATION SELECTOR-17 (Mn)
    "{\\u207F:1}",
    "{a\\u20D7:1}",
  ]
  let f : Array[String] = []
  let mut i = 0
  while i < good.length() {
    if !accepts(good[i]) {
      f.push(good[i] + " rejected")
    }
    i = i + 1
  }
  report(f, "valid identifier rejected (Node json5 + Rust json5 accept all)")
}

///| Round-trip consequence of the identifier bug: Pion parses `{٠:1}` into key "٠", but every
///| other JSON5 implementation rejects the document Pion accepted, so configs written by hand and
///| validated with Pion break in Node / Rust / editors.
test "p1_accepted_identifier_keys_are_not_portable" {
  match json5::parse("{\u{1F600}: 1, \u{0660}: 2}") {
    Ok(_) =>
    debug_assert(
      false,
      "Pion accepted an object whose unquoted keys json5@2.2.3 and json5-rs 1.3.8 both reject",
    )
    Err(_) => ()
  }
}

// ---------------------------------------------------------------------------
// P2: divergence from references / policy gaps
// ---------------------------------------------------------------------------

///| JSON5 v2.0 numbers are ES5.1 NumericLiterals: `1e400` IS valid and evaluates to Infinity.
///| Node json5 and Rust json5 1.3.8 both return Infinity for every input below; Pion's default
///| options (`reject_overflow: true`) reject them as errors (958 / 37,995 numeric-corpus literals).
///| The package's own `redteam_float_overflow_1e400` test calls this a defense, but JSON5 has an
///| `Infinity` literal anyway, so rejecting `1e400` protects nothing and fails valid documents.
test "p2_valid_overflowing_literals_rejected_by_default" {
  let lits = ["1e400", "-1e400", "1e309", "[1.8e308]", "{a: 2e308}"]
  let f : Array[String] = []
  let mut i = 0
  while i < lits.length() {
    if !accepts(lits[i]) {
      f.push(lits[i] + " rejected (Node/Rust json5: Infinity)")
    }
    i = i + 1
  }
  report(f, "valid JSON5 numeric literal rejected with default options")
}

///| `to_json_string(Number(-0.0))` writes `0`, so `-0` does not survive a JSON round trip.
///| serde_json / ryu write `-0.0`, which parses back to -0.0. (Node `JSON.stringify(-0)` is `"0"`
///| too.) This is the ONLY failure in the 60,000-double round trip; formatting is otherwise
///| byte-identical to `JSON.stringify` on all 60,000.
test "p2_negative_zero_lost_in_json_roundtrip" {
  match json5::to_json_string(json5::Json5Value::Number(-0.0)) {
    Ok(s) =>
    match num_of(s) {
      Some(y) =>
      debug_assert(
        y.reinterpret_as_uint64() == (-0.0).reinterpret_as_uint64(),
        "-0.0 -> \"" + s + "\" -> 0x" + bits_hex(y) + " (serde_json: \"-0.0\" -> -0.0)",
      )
      None => debug_assert(false, "re-parse failed: " + s)
    }
    Err(e) => debug_assert(false, e.message)
  }
}

///| `Json5Value::Number` is only a Double, so integers above 2^53 collapse. A JSON Patch `test`
///| therefore PASSES on different integers. Rust json-patch 4.2.0 (serde_json u64/i64) fails all
///| three tests, as RFC 6902 §4.6 requires for numbers that are not numerically equal.
///| (Node fast-json-patch shares Pion's behaviour: JS numbers.)
test "p2_patch_test_equates_distinct_big_integers" {
  let cases = [
    ("{a: 9007199254740993}", "[{op:'test', path:'/a', value: 9007199254740992}]"),
    ("{a: 9223372036854775807}", "[{op:'test', path:'/a', value: 9223372036854775806}]"),
    ("{a: 18446744073709551615}", "[{op:'test', path:'/a', value: 18446744073709551614}]"),
  ]
  let f : Array[String] = []
  let mut i = 0
  while i < cases.length() {
    let (d, p) = cases[i]
    match (json5::parse(d), json5::parse_patch(p)) {
      (Ok(doc), Ok(patch)) =>
      match json5::apply_patch(doc, patch) {
        Ok(_) => f.push(d + " " + p + " -> test passed")
        Err(_) => ()
      }
      _ => f.push(d + ": setup failed")
    }
    i = i + 1
  }
  report(f, "RFC 6902 test op equated distinct integers (Rust json-patch rejects)")
}

///| Silent precision loss on the way through: 9007199254740993 is re-serialized as
///| 9007199254740992, and Int64::MAX 9223372036854775807 -> 9223372036854776000 (= 2^63, not even an Int64).
///| serde_json keeps both exactly.
test "p2_big_integers_silently_rounded_on_roundtrip" {
  let f : Array[String] = []
  let srcs = ["9007199254740993", "9223372036854775807", "-9223372036854775808"]
  let mut i = 0
  while i < srcs.length() {
    match json5::parse(srcs[i]) {
      Ok(v) =>
      match json5::to_json_string(v) {
        Ok(s) =>
        if s != srcs[i] {
          f.push(srcs[i] + " -> " + s)
        }
        Err(_) => f.push(srcs[i] + " -> serialize error")
      }
      Err(_) => f.push(srcs[i] + " -> parse error")
    }
    i = i + 1
  }
  report(f, "integer changed by parse -> to_json_string (serde_json preserves)")
}

///| `value_eq` is not symmetric when an object holds duplicate keys (legal to construct through the
///| public `Json5Value::Object(Array[(String, Json5Value)])`): it only checks that every key of `a`
///| is found in `b` plus equal lengths. A patch `test` op can then succeed against a document whose
///| key set differs from the expected value.
test "p2_value_eq_asymmetric_on_duplicate_keys" {
  let one = json5::Json5Value::Number(1.0)
  let a = json5::Json5Value::Object([("a", one), ("a", one)])
  let b = json5::Json5Value::Object([("a", one), ("b", json5::Json5Value::Number(2.0))])
  let ab = json5::value_eq(a, b)
  let ba = json5::value_eq(b, a)
  debug_assert(
    ab == ba,
    "value_eq(a, b) = " + ab.to_string() + " but value_eq(b, a) = " + ba.to_string(),
  )
  debug_assert(!ab, "{a:1,a:1} reported equal to {a:1,b:2}")
}

// ---------------------------------------------------------------------------
// controls: attacks the package survives (all PASS)
// ---------------------------------------------------------------------------

///| Escapes, line continuations and `\0` rules match Node json5 and Rust json5 on all 142 syntax
///| vectors except the identifier and lone-surrogate rows.
test "ctl_string_escape_rules" {
  let good = [
    "'\\0'", "'\\x41'", "'\\v'", "'\\a'", "'a\\\nb'", "'a\\\r\nb'", "'a\\\u{2028}b'", "'a\u{2028}b'",
    "'\\uD83D\\uDE00'",
  ]
  let bad = ["'\\00'", "'\\01'", "'\\1'", "'\\9'", "'\\x4'", "'\\xZZ'", "'a\nb'", "'a\rb'", "'\\u{41}'"]
  let mut i = 0
  while i < good.length() {
    debug_assert(accepts(good[i]), "rejected " + good[i])
    i = i + 1
  }
  i = 0
  while i < bad.length() {
    debug_assert(!accepts(bad[i]), "accepted " + bad[i])
    i = i + 1
  }
}

///| The whole JSON5 whitespace set (ES5.1 WhiteSpace + LineTerminator + all Zs, BOM between tokens)
///| matches both references on all 1,112,064 code points.
test "ctl_whitespace_set" {
  let ws = [
    "\u{0B}", "\u{0C}", "\u{A0}", "\u{FEFF}", "\u{2028}", "\u{2029}", "\u{1680}", "\u{2000}", "\u{200A}",
    "\u{202F}", "\u{205F}", "\u{3000}",
  ]
  let mut i = 0
  while i < ws.length() {
    debug_assert(accepts("[1," + ws[i] + "2" + ws[i] + "]"), "whitespace rejected")
    i = i + 1
  }
  debug_assert(!accepts("[\u{180E}1]"), "U+180E is not Zs since Unicode 6.3")
  debug_assert(!accepts("[\u{200B}1]"), "U+200B is Cf, not whitespace")
}

///| Decimal parsing is correctly rounded: 0 / 37,995 differences from Node and Rust (all of them
///| exact) on 15-40 digit literals and 8,000 exact halfway cases. Formatting is shortest
///| round-trip, byte-identical to JSON.stringify on 60,000 doubles.
test "ctl_decimal_parse_and_format_exact" {
  let f : Array[String] = []
  expect_bits("9007199254740993", 0x4340000000000000L, f)
  expect_bits("9007199254740995", 0x4340000000000002L, f)
  expect_bits("1.00000000000000011102230246251565404236316680908203125", 0x3FF0000000000000L, f)
  expect_bits("1.00000000000000011102230246251565404236316680908203126", 0x3FF0000000000001L, f)
  expect_bits("2.4703282292062328e-324", 0x0000000000000001L, f)
  expect_bits("2.2250738585072011e-308", 0x000FFFFFFFFFFFFFL, f)
  report(f, "decimal literal")
  match json5::to_json_string(json5::Json5Value::Number(5.0e-324)) {
    Ok(s) => debug_assert(s == "5e-324", s)
    Err(_) => debug_assert(false, "format")
  }
}

///| RFC 6901 / 6902 edge cases agree with Rust json-patch on every row where Rust and Node agree:
///| `-` handling, `~01`, leading zeros, move into own child vs sibling prefix, atomic rollback.
test "ctl_pointer_patch_edges" {
  let doc = obj1("a", obj1("b", json5::Json5Value::Number(1.0)))
  let ok_patch = fn(p : String) -> Bool {
    match json5::parse_patch(p) {
      Ok(pp) =>
      match json5::apply_patch(doc, pp) {
        Ok(_) => true
        Err(_) => false
      }
      Err(_) => false
    }
  }
  debug_assert(ok_patch("[{op:'move',from:'/a',path:'/a'}]"), "move to self must be a no-op")
  debug_assert(!ok_patch("[{op:'move',from:'/a',path:'/a/b'}]"), "move into own child")
  debug_assert(ok_patch("[{op:'move',from:'/a',path:'/ab'}]"), "/ab is not a child of /a")
  debug_assert(!ok_patch("[{op:'remove',path:'/-'}]"), "remove /-")
  debug_assert(
    !ok_patch("[{op:'add',path:'/z',value:1},{op:'remove',path:'/q'}]"),
    "second op must fail",
  )
  match json5::pointer_get(obj1("~1", json5::Json5Value::Null), "/~01") {
    Ok(Some(_)) => ()
    _ => debug_assert(false, "~01 must decode to ~1")
  }
  match json5::pointer_get(json5::Json5Value::Array([json5::Json5Value::Null]), "/00") {
    Ok(None) => ()
    _ => debug_assert(false, "leading zero index")
  }
}

///| copy isolation: modifying the copy must not touch the source (deep clone).
test "ctl_copy_is_deep" {
  match (
    json5::parse("{a:{x:[1]}}"),
    json5::parse_patch("[{op:'copy',from:'/a',path:'/b'},{op:'add',path:'/b/x/-',value:2}]"),
  ) {
    (Ok(d), Ok(p)) =>
    match json5::apply_patch(d, p) {
      Ok(r) =>
      match json5::pointer_get(r, "/a/x") {
        Ok(Some(v)) => debug_assert(json5::value_len(v) == 1, "source mutated through copy")
        _ => debug_assert(false, "/a/x missing")
      }
      Err(e) => debug_assert(false, e.message)
    }
    _ => debug_assert(false, "setup")
  }
}
