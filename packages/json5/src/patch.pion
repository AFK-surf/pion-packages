///| RFC 6902 JSON Patch (atomic apply, parse/encode, and structural diff).

fn patch_err(msg : String) -> Json5Error {
  Json5Error::new(1, 1, 0, msg)
}

///| Deep clone a `Json5Value` so mutations never alias or corrupt the caller's document.
fn clone_value(v : Json5Value) -> Json5Value {
  match v {
    Json5Value::Null => Json5Value::Null
    Json5Value::Bool(b) => Json5Value::Bool(b)
    Json5Value::Number(x) => Json5Value::Number(x)
    Json5Value::Str(s) => Json5Value::Str(s)
    Json5Value::Array(items) => {
      let out : Array[Json5Value] = []
      let mut i = 0
      while i < items.length() {
        out.push(clone_value(items[i]))
        i = i + 1
      }
      Json5Value::Array(out)
    }
    Json5Value::Object(entries) => {
      let out : Array[(String, Json5Value)] = []
      let mut i = 0
      while i < entries.length() {
        let (k, elem) = entries[i]
        out.push((k, clone_value(elem)))
        i = i + 1
      }
      Json5Value::Object(out)
    }
  }
}

///| Decode a `Patch` from a `Json5Value` (must be an array of RFC 6902 op objects).
fn patch_from_value_impl(value : Json5Value) -> Result[Patch, Json5Error] {
  let items = match value {
    Json5Value::Array(arr) => arr
    _ => return Err(patch_err("JSON Patch document must be an array"))
  }
  let ops : Array[PatchOp] = []
  let mut i = 0
  while i < items.length() {
    let op_obj = items[i]
    match op_obj {
      Json5Value::Object(_) => ()
      _ => return Err(patch_err("JSON Patch operation must be an object"))
    }
    let op_name = match get(op_obj, "op") {
      Some(Json5Value::Str(s)) => s
      _ => return Err(patch_err("JSON Patch operation missing string 'op' field"))
    }
    let path = match get(op_obj, "path") {
      Some(Json5Value::Str(s)) => s
      _ => return Err(patch_err("JSON Patch operation missing string 'path' field"))
    }
    if op_name == "add" {
      match get(op_obj, "value") {
        Some(v) => ops.push(PatchOp::Add(path, v))
        None => return Err(patch_err("'add' operation missing 'value' field"))
      }
    } else if op_name == "remove" {
      ops.push(PatchOp::Remove(path))
    } else if op_name == "replace" {
      match get(op_obj, "value") {
        Some(v) => ops.push(PatchOp::Replace(path, v))
        None => return Err(patch_err("'replace' operation missing 'value' field"))
      }
    } else if op_name == "move" {
      match get(op_obj, "from") {
        Some(Json5Value::Str(from)) => ops.push(PatchOp::Move(from, path))
        _ => return Err(patch_err("'move' operation missing string 'from' field"))
      }
    } else if op_name == "copy" {
      match get(op_obj, "from") {
        Some(Json5Value::Str(from)) => ops.push(PatchOp::Copy(from, path))
        _ => return Err(patch_err("'copy' operation missing string 'from' field"))
      }
    } else if op_name == "test" {
      match get(op_obj, "value") {
        Some(v) => ops.push(PatchOp::Test(path, v))
        None => return Err(patch_err("'test' operation missing 'value' field"))
      }
    } else {
      return Err(patch_err("unknown JSON Patch operation: " + op_name))
    }
    i = i + 1
  }
  Ok(Patch::{ ops: ops })
}

///| Encode a `Patch` back to a `Json5Value::Array`.
fn patch_to_value_impl(patch : Patch) -> Json5Value {
  let out : Array[Json5Value] = []
  let mut i = 0
  while i < patch.ops.length() {
    match patch.ops[i] {
      PatchOp::Add(path, v) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("add")),
          ("path", Json5Value::Str(path)),
          ("value", clone_value(v)),
        ]),
      )
      PatchOp::Remove(path) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("remove")),
          ("path", Json5Value::Str(path)),
        ]),
      )
      PatchOp::Replace(path, v) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("replace")),
          ("path", Json5Value::Str(path)),
          ("value", clone_value(v)),
        ]),
      )
      PatchOp::Move(from, path) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("move")),
          ("from", Json5Value::Str(from)),
          ("path", Json5Value::Str(path)),
        ]),
      )
      PatchOp::Copy(from, path) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("copy")),
          ("from", Json5Value::Str(from)),
          ("path", Json5Value::Str(path)),
        ]),
      )
      PatchOp::Test(path, v) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("test")),
          ("path", Json5Value::Str(path)),
          ("value", clone_value(v)),
        ]),
      )
    }
    i = i + 1
  }
  Json5Value::Array(out)
}

///| Find parent container of `tokens` (i.e., resolve `tokens[0..n-1]`).
fn resolve_parent(
  doc : Json5Value,
  tokens : Array[String],
) -> Result[Json5Value, Json5Error] {
  let n = tokens.length()
  let mut cur = doc
  let mut i = 0
  while i + 1 < n {
    let tok = tokens[i]
    match cur {
      Json5Value::Object(entries) => {
        let mut found : Option[Json5Value] = None
        let mut j = 0
        while j < entries.length() {
          let (k, v) = entries[j]
          if k == tok {
            found = Some(v)
            break
          }
          j = j + 1
        }
        match found {
          Some(next) => cur = next
          None => return Err(patch_err("parent path does not exist: " + tok))
        }
      }
      Json5Value::Array(items) => {
        match parse_array_index(tok) {
          Some(idx) => {
            if idx >= 0 && idx < items.length() {
              cur = items[idx]
            } else {
              return Err(patch_err("parent array index out of bounds: " + tok))
            }
          }
          None => return Err(patch_err("invalid parent array index: " + tok))
        }
      }
      _ => return Err(patch_err("cannot traverse non-container at token: " + tok))
    }
    i = i + 1
  }
  Ok(cur)
}

///| Apply `add` at `ptr` onto cloned `doc`.
fn patch_add(
  doc : Json5Value,
  ptr : JsonPointer,
  value : Json5Value,
) -> Result[Json5Value, Json5Error] {
  let n = ptr.tokens.length()
  if n == 0 {
    return Ok(clone_value(value))
  }
  let parent = match resolve_parent(doc, ptr.tokens) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let last = ptr.tokens[n - 1]
  match parent {
    Json5Value::Object(entries) => {
      let mut i = 0
      while i < entries.length() {
        let (k, _) = entries[i]
        if k == last {
          entries[i] = (last, clone_value(value))
          return Ok(doc)
        }
        i = i + 1
      }
      entries.push((last, clone_value(value)))
      Ok(doc)
    }
    Json5Value::Array(items) => {
      if last == "-" {
        items.push(clone_value(value))
        return Ok(doc)
      }
      match parse_array_index(last) {
        Some(idx) => {
          let len = items.length()
          if idx < 0 || idx > len {
            return Err(patch_err("add array index out of bounds: " + last))
          }
          items.push(clone_value(value))
          let mut k = len
          while k > idx {
            items[k] = items[k - 1]
            k = k - 1
          }
          items[idx] = clone_value(value)
          Ok(doc)
        }
        None => Err(patch_err("invalid array index in add: " + last))
      }
    }
    _ => Err(patch_err("cannot add to non-container parent"))
  }
}

///| Apply `remove` at `ptr` onto cloned `doc`, returning `(doc, removed_value)`.
fn patch_remove(
  doc : Json5Value,
  ptr : JsonPointer,
) -> Result[(Json5Value, Json5Value), Json5Error] {
  let n = ptr.tokens.length()
  if n == 0 {
    return Err(patch_err("cannot remove document root"))
  }
  let parent = match resolve_parent(doc, ptr.tokens) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let last = ptr.tokens[n - 1]
  match parent {
    Json5Value::Object(entries) => {
      let len = entries.length()
      let mut i = 0
      while i < len {
        let (k, v) = entries[i]
        if k == last {
          let mut j = i
          while j + 1 < len {
            entries[j] = entries[j + 1]
            j = j + 1
          }
          let _ = entries.pop()
          return Ok((doc, v))
        }
        i = i + 1
      }
      Err(patch_err("remove target key does not exist: " + last))
    }
    Json5Value::Array(items) => {
      match parse_array_index(last) {
        Some(idx) => {
          let len = items.length()
          if idx < 0 || idx >= len {
            return Err(patch_err("remove array index out of bounds: " + last))
          }
          let removed = items[idx]
          let mut j = idx
          while j + 1 < len {
            items[j] = items[j + 1]
            j = j + 1
          }
          let _ = items.pop()
          Ok((doc, removed))
        }
        None => Err(patch_err("invalid array index in remove: " + last))
      }
    }
    _ => Err(patch_err("cannot remove from non-container parent"))
  }
}

///| Apply `replace` at `ptr` onto cloned `doc`.
fn patch_replace(
  doc : Json5Value,
  ptr : JsonPointer,
  value : Json5Value,
) -> Result[Json5Value, Json5Error] {
  let n = ptr.tokens.length()
  if n == 0 {
    return Ok(clone_value(value))
  }
  let parent = match resolve_parent(doc, ptr.tokens) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let last = ptr.tokens[n - 1]
  match parent {
    Json5Value::Object(entries) => {
      let mut i = 0
      while i < entries.length() {
        let (k, _) = entries[i]
        if k == last {
          entries[i] = (last, clone_value(value))
          return Ok(doc)
        }
        i = i + 1
      }
      Err(patch_err("replace target key does not exist: " + last))
    }
    Json5Value::Array(items) => {
      match parse_array_index(last) {
        Some(idx) => {
          if idx < 0 || idx >= items.length() {
            return Err(patch_err("replace array index out of bounds: " + last))
          }
          items[idx] = clone_value(value)
          Ok(doc)
        }
        None => Err(patch_err("invalid array index in replace: " + last))
      }
    }
    _ => Err(patch_err("cannot replace in non-container parent"))
  }
}

///| Check whether `prefix` is a proper prefix of `target` (RFC 6902 §4.4 move guard).
fn is_proper_prefix(prefix : Array[String], target : Array[String]) -> Bool {
  let plen = prefix.length()
  if plen >= target.length() {
    return false
  }
  let mut i = 0
  while i < plen {
    if prefix[i] != target[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Check whether two token arrays are equal.
fn tokens_eq(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Apply a `Patch` atomically to `doc` (clones before mutating).
fn apply_patch_impl(
  doc : Json5Value,
  patch : Patch,
) -> Result[Json5Value, Json5Error] {
  let mut work = clone_value(doc)
  let mut i = 0
  while i < patch.ops.length() {
    match patch.ops[i] {
      PatchOp::Add(path_str, value) => {
        let ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        work = match patch_add(work, ptr, value) {
          Ok(w) => w
          Err(e) => return Err(e)
        }
      }
      PatchOp::Remove(path_str) => {
        let ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let (next_w, _) = match patch_remove(work, ptr) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        work = next_w
      }
      PatchOp::Replace(path_str, value) => {
        let ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        work = match patch_replace(work, ptr, value) {
          Ok(w) => w
          Err(e) => return Err(e)
        }
      }
      PatchOp::Move(from_str, path_str) => {
        let from_ptr = match pointer_parse_impl(from_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let path_ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        if is_proper_prefix(from_ptr.tokens, path_ptr.tokens) {
          return Err(patch_err("cannot move a location into one of its own children"))
        }
        if tokens_eq(from_ptr.tokens, path_ptr.tokens) {
          match pointer_get_parsed_impl(work, from_ptr) {
            Some(_) => ()
            None => return Err(patch_err("move 'from' location does not exist: " + from_str))
          }
        } else {
          let (after_rem, moved_val) = match patch_remove(work, from_ptr) {
            Ok(r) => r
            Err(e) => return Err(e)
          }
          work = match patch_add(after_rem, path_ptr, moved_val) {
            Ok(w) => w
            Err(e) => return Err(e)
          }
        }
      }
      PatchOp::Copy(from_str, path_str) => {
        let from_ptr = match pointer_parse_impl(from_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let path_ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let copied = match pointer_get_parsed_impl(work, from_ptr) {
          Some(v) => clone_value(v)
          None => return Err(patch_err("copy 'from' location does not exist: " + from_str))
        }
        work = match patch_add(work, path_ptr, copied) {
          Ok(w) => w
          Err(e) => return Err(e)
        }
      }
      PatchOp::Test(path_str, expected) => {
        let ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        match pointer_get_parsed_impl(work, ptr) {
          Some(actual) => {
            if !value_eq(actual, expected) {
              return Err(patch_err("test operation failed at path: " + path_str))
            }
          }
          None => return Err(patch_err("test target path does not exist: " + path_str))
        }
      }
    }
    i = i + 1
  }
  Ok(work)
}

///| Compute an RFC 6902 `Patch` transforming `a` into `b`.
fn diff_rec(
  a : Json5Value,
  b : Json5Value,
  base_path : String,
  ops : Array[PatchOp],
) -> Unit {
  if value_eq(a, b) {
    return
  }
  match (a, b) {
    (Json5Value::Object(ea), Json5Value::Object(eb)) => {
      // Remove keys present in a but absent in b
      let mut i = 0
      while i < ea.length() {
        let (ka, va) = ea[i]
        let child_path = base_path + "/" + pointer_escape_impl(ka)
        match get(b, ka) {
          Some(vb) => diff_rec(va, vb, child_path, ops)
          None => ops.push(PatchOp::Remove(child_path))
        }
        i = i + 1
      }
      // Add keys present in b but absent in a
      let mut j = 0
      while j < eb.length() {
        let (kb, vb) = eb[j]
        match get(a, kb) {
          Some(_) => ()
          None => {
            let child_path = base_path + "/" + pointer_escape_impl(kb)
            ops.push(PatchOp::Add(child_path, clone_value(vb)))
          }
        }
        j = j + 1
      }
    }
    (Json5Value::Array(ia), Json5Value::Array(ib)) => {
      let la = ia.length()
      let lb = ib.length()
      let common = if la < lb { la } else { lb }
      let mut i = 0
      while i < common {
        let child_path = base_path + "/" + i.to_string()
        diff_rec(ia[i], ib[i], child_path, ops)
        i = i + 1
      }
      if la > lb {
        // Remove excess elements from the end downwards
        let mut k = la - 1
        while k >= lb {
          ops.push(PatchOp::Remove(base_path + "/" + k.to_string()))
          k = k - 1
        }
      } else if lb > la {
        let mut k = la
        while k < lb {
          ops.push(PatchOp::Add(base_path + "/-", clone_value(ib[k])))
          k = k + 1
        }
      }
    }
    _ => ops.push(PatchOp::Replace(base_path, clone_value(b)))
  }
}

fn diff_impl(a : Json5Value, b : Json5Value) -> Patch {
  let ops : Array[PatchOp] = []
  diff_rec(a, b, "", ops)
  Patch::{ ops: ops }
}
