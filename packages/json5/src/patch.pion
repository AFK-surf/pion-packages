///| RFC 6902 JSON Patch (atomic Copy-on-Write apply with depth/node budgets, parse/encode,
///| and 100% iterative linear-time structural diff).

fn patch_err(msg : String) -> Json5Error {
  Json5Error::new(1, 1, 0, msg)
}

enum CloneFrame {
  Arr(Array[Json5Value], Array[Json5Value], Int)
  Obj(Array[(String, Json5Value)], Array[(String, Json5Value)], Int)
}

///| 100% iterative deep clone of a `Json5Value` (0 call-stack growth).
fn clone_value(root : Json5Value) -> Json5Value {
  match root {
    Json5Value::Null | Json5Value::Bool(_) | Json5Value::Number(_) | Json5Value::Str(_) =>
    return root
    _ => ()
  }
  let stack : Array[CloneFrame] = []
  match root {
    Json5Value::Array(items) => stack.push(CloneFrame::Arr(items, [], 0))
    Json5Value::Object(entries) => stack.push(CloneFrame::Obj(entries, [], 0))
    _ => return root
  }

  let mut completed : Option[Json5Value] = None
  while stack.length() > 0 {
    // Deliver any completed child into parent frame
    match completed {
      Some(child) => {
        completed = None
        let top_idx = stack.length() - 1
        match stack[top_idx] {
          CloneFrame::Arr(src, dst, idx) => {
            dst.push(child)
            stack[top_idx] = CloneFrame::Arr(src, dst, idx)
          }
          CloneFrame::Obj(src, dst, idx) => {
            let (k, _) = src[idx - 1]
            dst.push((k, child))
            stack[top_idx] = CloneFrame::Obj(src, dst, idx)
          }
        }
      }
      None => ()
    }

    let top_idx = stack.length() - 1
    match stack[top_idx] {
      CloneFrame::Arr(src, dst, idx_in) => {
        let mut idx = idx_in
        let n = src.length()
        let mut pushed_child = false
        while idx < n {
          let elem = src[idx]
          idx = idx + 1
          match elem {
            Json5Value::Array(sub) => {
              stack[top_idx] = CloneFrame::Arr(src, dst, idx)
              stack.push(CloneFrame::Arr(sub, [], 0))
              pushed_child = true
              break
            }
            Json5Value::Object(sub) => {
              stack[top_idx] = CloneFrame::Arr(src, dst, idx)
              stack.push(CloneFrame::Obj(sub, [], 0))
              pushed_child = true
              break
            }
            _ => dst.push(elem)
          }
        }
        if !pushed_child {
          let _ = stack.pop()
          completed = Some(Json5Value::Array(dst))
        }
      }
      CloneFrame::Obj(src, dst, idx_in) => {
        let mut idx = idx_in
        let n = src.length()
        let mut pushed_child = false
        while idx < n {
          let (k, elem) = src[idx]
          idx = idx + 1
          match elem {
            Json5Value::Array(sub) => {
              stack[top_idx] = CloneFrame::Obj(src, dst, idx)
              stack.push(CloneFrame::Arr(sub, [], 0))
              pushed_child = true
              break
            }
            Json5Value::Object(sub) => {
              stack[top_idx] = CloneFrame::Obj(src, dst, idx)
              stack.push(CloneFrame::Obj(sub, [], 0))
              pushed_child = true
              break
            }
            _ => dst.push((k, elem))
          }
        }
        if !pushed_child {
          let _ = stack.pop()
          completed = Some(Json5Value::Object(dst))
        }
      }
    }
  }
  match completed {
    Some(v) => v
    None => root
  }
}

///| Return whether `v` is a container (`Array` or `Object`).
fn is_container(v : Json5Value) -> Bool {
  match v {
    Json5Value::Array(_) | Json5Value::Object(_) => true
    _ => false
  }
}

///| Iteratively measure container nesting depth of `v`, stopping early if depth > `limit`.
///| Scalars have depth 0; `[]` / `{}` have depth 1; `[[]]` has depth 2.
///| Returns `limit + 1` if exceeded.
fn measure_depth_bounded(v : Json5Value, limit : Int) -> Int {
  match v {
    Json5Value::Array(_) | Json5Value::Object(_) => ()
    _ => return 0
  }
  if limit < 1 {
    return limit + 1
  }
  let stack : Array[(Json5Value, Int)] = [(v, 1)]
  let mut max_d = 1
  while stack.length() > 0 {
    let (cur, d) = match stack.pop() {
      Some(p) => p
      None => break
    }
    if d > max_d {
      max_d = d
      if max_d > limit {
        return limit + 1
      }
    }
    match cur {
      Json5Value::Array(items) => {
        let mut i = 0
        let n = items.length()
        while i < n {
          let elem = items[i]
          if is_container(elem) {
            if d + 1 > limit {
              return limit + 1
            }
            stack.push((elem, d + 1))
          }
          i = i + 1
        }
      }
      Json5Value::Object(entries) => {
        let mut i = 0
        let n = entries.length()
        while i < n {
          let (_, elem) = entries[i]
          if is_container(elem) {
            if d + 1 > limit {
              return limit + 1
            }
            stack.push((elem, d + 1))
          }
          i = i + 1
        }
      }
      _ => ()
    }
  }
  max_d
}

///| Iteratively count total nodes in `v`, stopping early if count > `limit`.
///| Returns `limit + 1` if exceeded.
fn count_nodes_bounded(v : Json5Value, limit : Int) -> Int {
  if limit <= 0 {
    return 1
  }
  match v {
    Json5Value::Array(_) | Json5Value::Object(_) => ()
    _ => return 1
  }
  let stack : Array[Json5Value] = [v]
  let mut count = 0
  while stack.length() > 0 {
    let cur = match stack.pop() {
      Some(x) => x
      None => break
    }
    count = count + 1
    if count > limit {
      return limit + 1
    }
    match cur {
      Json5Value::Array(items) => {
        let mut i = 0
        let n = items.length()
        while i < n {
          let elem = items[i]
          if is_container(elem) {
            stack.push(elem)
          } else {
            count = count + 1
            if count > limit {
              return limit + 1
            }
          }
          i = i + 1
        }
      }
      Json5Value::Object(entries) => {
        let mut i = 0
        let n = entries.length()
        while i < n {
          let (_, elem) = entries[i]
          if is_container(elem) {
            stack.push(elem)
          } else {
            count = count + 1
            if count > limit {
              return limit + 1
            }
          }
          i = i + 1
        }
      }
      _ => ()
    }
  }
  count
}

///| Decode a `Patch` from a `Json5Value` (must be an array of RFC 6902 op objects).
fn patch_from_value_impl(value : Json5Value) -> Result[Patch, Json5Error] {
  let items = match value {
    Json5Value::Array(arr) => arr
    _ => return Err(patch_err("JSON Patch document must be an array"))
  }
  let ops : Array[PatchOp] = []
  let mut i = 0
  while i < items.length() {
    let op_obj = items[i]
    match op_obj {
      Json5Value::Object(_) => ()
      _ => return Err(patch_err("JSON Patch operation must be an object"))
    }
    let op_name = match get(op_obj, "op") {
      Some(Json5Value::Str(s)) => s
      _ => return Err(patch_err("JSON Patch operation missing string 'op' field"))
    }
    let path = match get(op_obj, "path") {
      Some(Json5Value::Str(s)) => s
      _ => return Err(patch_err("JSON Patch operation missing string 'path' field"))
    }
    if op_name == "add" {
      match get(op_obj, "value") {
        Some(v) => ops.push(PatchOp::Add(path, v))
        None => return Err(patch_err("'add' operation missing 'value' field"))
      }
    } else if op_name == "remove" {
      ops.push(PatchOp::Remove(path))
    } else if op_name == "replace" {
      match get(op_obj, "value") {
        Some(v) => ops.push(PatchOp::Replace(path, v))
        None => return Err(patch_err("'replace' operation missing 'value' field"))
      }
    } else if op_name == "move" {
      match get(op_obj, "from") {
        Some(Json5Value::Str(from)) => ops.push(PatchOp::Move(from, path))
        _ => return Err(patch_err("'move' operation missing string 'from' field"))
      }
    } else if op_name == "copy" {
      match get(op_obj, "from") {
        Some(Json5Value::Str(from)) => ops.push(PatchOp::Copy(from, path))
        _ => return Err(patch_err("'copy' operation missing string 'from' field"))
      }
    } else if op_name == "test" {
      match get(op_obj, "value") {
        Some(v) => ops.push(PatchOp::Test(path, v))
        None => return Err(patch_err("'test' operation missing 'value' field"))
      }
    } else {
      return Err(patch_err("unknown JSON Patch operation: " + op_name))
    }
    i = i + 1
  }
  Ok(Patch::{ ops: ops })
}

///| Encode a `Patch` back to a `Json5Value::Array`.
fn patch_to_value_impl(patch : Patch) -> Json5Value {
  let out : Array[Json5Value] = []
  let mut i = 0
  while i < patch.ops.length() {
    match patch.ops[i] {
      PatchOp::Add(path, v) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("add")),
          ("path", Json5Value::Str(path)),
          ("value", clone_value(v)),
        ]),
      )
      PatchOp::Remove(path) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("remove")),
          ("path", Json5Value::Str(path)),
        ]),
      )
      PatchOp::Replace(path, v) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("replace")),
          ("path", Json5Value::Str(path)),
          ("value", clone_value(v)),
        ]),
      )
      PatchOp::Move(from, path) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("move")),
          ("from", Json5Value::Str(from)),
          ("path", Json5Value::Str(path)),
        ]),
      )
      PatchOp::Copy(from, path) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("copy")),
          ("from", Json5Value::Str(from)),
          ("path", Json5Value::Str(path)),
        ]),
      )
      PatchOp::Test(path, v) =>
      out.push(
        Json5Value::Object([
          ("op", Json5Value::Str("test")),
          ("path", Json5Value::Str(path)),
          ("value", clone_value(v)),
        ]),
      )
    }
    i = i + 1
  }
  Json5Value::Array(out)
}

enum CowStep {
  Obj(Array[(String, Json5Value)], Int)
  Arr(Array[Json5Value], Int)
}

///| Walk `tokens[0..n-1]` collecting parent containers on `trail` without mutating `doc`.
fn resolve_parent_trail(
  doc : Json5Value,
  tokens : Array[String],
  trail : Array[CowStep],
) -> Result[Json5Value, Json5Error] {
  let n = tokens.length()
  let mut cur = doc
  let mut i = 0
  while i + 1 < n {
    let tok = tokens[i]
    match cur {
      Json5Value::Object(entries) => {
        let mut found_idx = -1
        let mut j = 0
        let m = entries.length()
        while j < m {
          let (k, _) = entries[j]
          if k == tok {
            found_idx = j
            break
          }
          j = j + 1
        }
        if found_idx < 0 {
          return Err(patch_err("parent path does not exist: " + tok))
        }
        let (_, next) = entries[found_idx]
        trail.push(CowStep::Obj(entries, found_idx))
        cur = next
      }
      Json5Value::Array(items) => {
        match parse_array_index(tok) {
          Some(idx) => {
            if idx >= 0 && idx < items.length() {
              trail.push(CowStep::Arr(items, idx))
              cur = items[idx]
            } else {
              return Err(patch_err("parent array index out of bounds: " + tok))
            }
          }
          None => return Err(patch_err("invalid parent array index: " + tok))
        }
      }
      _ => return Err(patch_err("cannot traverse non-container at token: " + tok))
    }
    i = i + 1
  }
  Ok(cur)
}

///| Rebuild only the O(depth) containers along `trail` using structural sharing.
fn rebuild_cow_trail(trail : Array[CowStep], leaf : Json5Value) -> Json5Value {
  let mut child = leaf
  let mut k = trail.length() - 1
  while k >= 0 {
    match trail[k] {
      CowStep::Obj(entries, idx) => {
        let m = entries.length()
        let out : Array[(String, Json5Value)] = Array::with_capacity(m)
        let mut j = 0
        while j < m {
          if j == idx {
            let (key, _) = entries[j]
            out.push((key, child))
          } else {
            out.push(entries[j])
          }
          j = j + 1
        }
        child = Json5Value::Object(out)
      }
      CowStep::Arr(items, idx) => {
        let m = items.length()
        let out : Array[Json5Value] = Array::with_capacity(m)
        let mut j = 0
        while j < m {
          if j == idx {
            out.push(child)
          } else {
            out.push(items[j])
          }
          j = j + 1
        }
        child = Json5Value::Array(out)
      }
    }
    k = k - 1
  }
  child
}

///| Copy-on-Write `add` at `ptr` (never mutates `doc`; reuses `value` without cloning).
fn patch_add_cow(
  doc : Json5Value,
  ptr : JsonPointer,
  value : Json5Value,
) -> Result[Json5Value, Json5Error] {
  let n = ptr.tokens.length()
  if n == 0 {
    return Ok(value)
  }
  let trail : Array[CowStep] = Array::with_capacity(n)
  let parent = match resolve_parent_trail(doc, ptr.tokens, trail) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let last = ptr.tokens[n - 1]
  let new_parent = match parent {
    Json5Value::Object(entries) => {
      let m = entries.length()
      let out : Array[(String, Json5Value)] = Array::with_capacity(m + 1)
      let mut replaced = false
      let mut i = 0
      while i < m {
        let (k, v) = entries[i]
        if !replaced && k == last {
          out.push((last, value))
          replaced = true
        } else {
          out.push((k, v))
        }
        i = i + 1
      }
      if !replaced {
        out.push((last, value))
      }
      Json5Value::Object(out)
    }
    Json5Value::Array(items) => {
      let len = items.length()
      if last == "-" {
        let out : Array[Json5Value] = Array::with_capacity(len + 1)
        let mut i = 0
        while i < len {
          out.push(items[i])
          i = i + 1
        }
        out.push(value)
        Json5Value::Array(out)
      } else {
        match parse_array_index(last) {
          Some(idx) => {
            if idx < 0 || idx > len {
              return Err(patch_err("add array index out of bounds: " + last))
            }
            let out : Array[Json5Value] = Array::with_capacity(len + 1)
            let mut i = 0
            while i < idx {
              out.push(items[i])
              i = i + 1
            }
            out.push(value)
            while i < len {
              out.push(items[i])
              i = i + 1
            }
            Json5Value::Array(out)
          }
          None => return Err(patch_err("invalid array index in add: " + last))
        }
      }
    }
    _ => return Err(patch_err("cannot add to non-container parent"))
  }
  Ok(rebuild_cow_trail(trail, new_parent))
}

///| Copy-on-Write `remove` at `ptr`, returning `(new_doc, removed_value)`.
fn patch_remove_cow(
  doc : Json5Value,
  ptr : JsonPointer,
) -> Result[(Json5Value, Json5Value), Json5Error] {
  let n = ptr.tokens.length()
  if n == 0 {
    return Err(patch_err("cannot remove document root"))
  }
  let trail : Array[CowStep] = Array::with_capacity(n)
  let parent = match resolve_parent_trail(doc, ptr.tokens, trail) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let last = ptr.tokens[n - 1]
  match parent {
    Json5Value::Object(entries) => {
      let len = entries.length()
      let mut found_idx = -1
      let mut i = 0
      while i < len {
        let (k, _) = entries[i]
        if k == last {
          found_idx = i
          break
        }
        i = i + 1
      }
      if found_idx < 0 {
        return Err(patch_err("remove target key does not exist: " + last))
      }
      let (_, removed) = entries[found_idx]
      let out : Array[(String, Json5Value)] = Array::with_capacity(len - 1)
      let mut j = 0
      while j < len {
        if j != found_idx {
          out.push(entries[j])
        }
        j = j + 1
      }
      Ok((rebuild_cow_trail(trail, Json5Value::Object(out)), removed))
    }
    Json5Value::Array(items) => {
      match parse_array_index(last) {
        Some(idx) => {
          let len = items.length()
          if idx < 0 || idx >= len {
            return Err(patch_err("remove array index out of bounds: " + last))
          }
          let removed = items[idx]
          let out : Array[Json5Value] = Array::with_capacity(len - 1)
          let mut j = 0
          while j < len {
            if j != idx {
              out.push(items[j])
            }
            j = j + 1
          }
          Ok((rebuild_cow_trail(trail, Json5Value::Array(out)), removed))
        }
        None => Err(patch_err("invalid array index in remove: " + last))
      }
    }
    _ => Err(patch_err("cannot remove from non-container parent"))
  }
}

///| Copy-on-Write `replace` at `ptr`.
fn patch_replace_cow(
  doc : Json5Value,
  ptr : JsonPointer,
  value : Json5Value,
) -> Result[Json5Value, Json5Error] {
  let n = ptr.tokens.length()
  if n == 0 {
    return Ok(value)
  }
  let trail : Array[CowStep] = Array::with_capacity(n)
  let parent = match resolve_parent_trail(doc, ptr.tokens, trail) {
    Ok(p) => p
    Err(e) => return Err(e)
  }
  let last = ptr.tokens[n - 1]
  let new_parent = match parent {
    Json5Value::Object(entries) => {
      let len = entries.length()
      let mut found_idx = -1
      let mut i = 0
      while i < len {
        let (k, _) = entries[i]
        if k == last {
          found_idx = i
          break
        }
        i = i + 1
      }
      if found_idx < 0 {
        return Err(patch_err("replace target key does not exist: " + last))
      }
      let out : Array[(String, Json5Value)] = Array::with_capacity(len)
      let mut j = 0
      while j < len {
        if j == found_idx {
          out.push((last, value))
        } else {
          out.push(entries[j])
        }
        j = j + 1
      }
      Json5Value::Object(out)
    }
    Json5Value::Array(items) => {
      match parse_array_index(last) {
        Some(idx) => {
          let len = items.length()
          if idx < 0 || idx >= len {
            return Err(patch_err("replace array index out of bounds: " + last))
          }
          let out : Array[Json5Value] = Array::with_capacity(len)
          let mut j = 0
          while j < len {
            if j == idx {
              out.push(value)
            } else {
              out.push(items[j])
            }
            j = j + 1
          }
          Json5Value::Array(out)
        }
        None => return Err(patch_err("invalid array index in replace: " + last))
      }
    }
    _ => return Err(patch_err("cannot replace in non-container parent"))
  }
  Ok(rebuild_cow_trail(trail, new_parent))
}

///| Check whether `prefix` is a proper prefix of `target` (RFC 6902 §4.4 move guard).
fn is_proper_prefix(prefix : Array[String], target : Array[String]) -> Bool {
  let plen = prefix.length()
  if plen >= target.length() {
    return false
  }
  let mut i = 0
  while i < plen {
    if prefix[i] != target[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Check whether two token arrays are equal.
fn tokens_eq(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Apply a `Patch` atomically to `doc` using Copy-on-Write structural sharing,
///| enforcing `opts.max_depth` and `opts.max_nodes`.
fn apply_patch_with_options_impl(
  doc : Json5Value,
  patch : Patch,
  opts : PatchOptions,
) -> Result[Json5Value, Json5Error] {
  let max_depth = opts.max_depth
  let max_nodes = opts.max_nodes
  let mut work = doc
  let mut added_nodes = 0
  // Tracks an upper bound on depth growth from deeper Move/Copy operations;
  // initialized lazily on the first deeper container move/copy so shallow
  // single-op patches on large documents stay O(depth).
  let mut depth_bound = -1

  let mut i = 0
  let num_ops = patch.ops.length()
  while i < num_ops {
    match patch.ops[i] {
      PatchOp::Add(path_str, value) => {
        let ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let path_len = ptr.tokens.length()
        if path_len > max_depth {
          return Err(patch_err("maximum nesting depth exceeded"))
        }
        if is_container(value) {
          let vd = measure_depth_bounded(value, max_depth - path_len)
          if path_len + vd > max_depth {
            return Err(patch_err("maximum nesting depth exceeded"))
          }
          let vn = count_nodes_bounded(value, max_nodes - added_nodes)
          added_nodes = added_nodes + vn
          if added_nodes > max_nodes {
            return Err(patch_err("maximum node count exceeded"))
          }
          if depth_bound >= 0 && path_len + vd > depth_bound {
            depth_bound = path_len + vd
          }
        } else {
          added_nodes = added_nodes + 1
          if added_nodes > max_nodes {
            return Err(patch_err("maximum node count exceeded"))
          }
        }
        work = match patch_add_cow(work, ptr, value) {
          Ok(w) => w
          Err(e) => return Err(e)
        }
      }
      PatchOp::Remove(path_str) => {
        let ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let (next_w, _) = match patch_remove_cow(work, ptr) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        work = next_w
      }
      PatchOp::Replace(path_str, value) => {
        let ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let path_len = ptr.tokens.length()
        if path_len > max_depth {
          return Err(patch_err("maximum nesting depth exceeded"))
        }
        if is_container(value) {
          let vd = measure_depth_bounded(value, max_depth - path_len)
          if path_len + vd > max_depth {
            return Err(patch_err("maximum nesting depth exceeded"))
          }
          let vn = count_nodes_bounded(value, max_nodes - added_nodes)
          added_nodes = added_nodes + vn
          if added_nodes > max_nodes {
            return Err(patch_err("maximum node count exceeded"))
          }
          if depth_bound >= 0 && path_len + vd > depth_bound {
            depth_bound = path_len + vd
          }
        } else {
          added_nodes = added_nodes + 1
          if added_nodes > max_nodes {
            return Err(patch_err("maximum node count exceeded"))
          }
        }
        work = match patch_replace_cow(work, ptr, value) {
          Ok(w) => w
          Err(e) => return Err(e)
        }
      }
      PatchOp::Move(from_str, path_str) => {
        let from_ptr = match pointer_parse_impl(from_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let path_ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        if is_proper_prefix(from_ptr.tokens, path_ptr.tokens) {
          return Err(patch_err("cannot move a location into one of its own children"))
        }
        if tokens_eq(from_ptr.tokens, path_ptr.tokens) {
          match pointer_get_parsed_impl(work, from_ptr) {
            Some(_) => ()
            None => return Err(patch_err("move 'from' location does not exist: " + from_str))
          }
        } else {
          let path_len = path_ptr.tokens.length()
          let from_len = from_ptr.tokens.length()
          if path_len > max_depth {
            return Err(patch_err("maximum nesting depth exceeded"))
          }
          let (after_rem, moved_val) = match patch_remove_cow(work, from_ptr) {
            Ok(r) => r
            Err(e) => return Err(e)
          }
          if path_len > from_len && is_container(moved_val) {
            let delta = path_len - from_len
            if depth_bound < 0 {
              let actual = measure_depth_bounded(moved_val, max_depth - path_len)
              if path_len + actual > max_depth {
                return Err(patch_err("maximum nesting depth exceeded"))
              }
              depth_bound = path_len + actual
            } else {
              depth_bound = depth_bound + delta
              if depth_bound > max_depth {
                let actual = measure_depth_bounded(moved_val, max_depth - path_len)
                if path_len + actual > max_depth {
                  return Err(patch_err("maximum nesting depth exceeded"))
                }
                depth_bound = path_len + actual
              }
            }
          }
          work = match patch_add_cow(after_rem, path_ptr, moved_val) {
            Ok(w) => w
            Err(e) => return Err(e)
          }
        }
      }
      PatchOp::Copy(from_str, path_str) => {
        let from_ptr = match pointer_parse_impl(from_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let path_ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        let path_len = path_ptr.tokens.length()
        let from_len = from_ptr.tokens.length()
        if path_len > max_depth {
          return Err(patch_err("maximum nesting depth exceeded"))
        }
        let copied = match pointer_get_parsed_impl(work, from_ptr) {
          Some(v) => v
          None => return Err(patch_err("copy 'from' location does not exist: " + from_str))
        }
        if is_container(copied) {
          if path_len > from_len {
            let delta = path_len - from_len
            if depth_bound < 0 {
              let actual = measure_depth_bounded(copied, max_depth - path_len)
              if path_len + actual > max_depth {
                return Err(patch_err("maximum nesting depth exceeded"))
              }
              depth_bound = path_len + actual
            } else {
              depth_bound = depth_bound + delta
              if depth_bound > max_depth {
                let actual = measure_depth_bounded(copied, max_depth - path_len)
                if path_len + actual > max_depth {
                  return Err(patch_err("maximum nesting depth exceeded"))
                }
                depth_bound = path_len + actual
              }
            }
          }
          let cn = count_nodes_bounded(copied, max_nodes - added_nodes)
          added_nodes = added_nodes + cn
          if added_nodes > max_nodes {
            return Err(patch_err("maximum node count exceeded"))
          }
        } else {
          added_nodes = added_nodes + 1
          if added_nodes > max_nodes {
            return Err(patch_err("maximum node count exceeded"))
          }
        }
        // COW guarantees no subsequent op mutates `copied` in place, so RC sharing is 100% isolated.
        work = match patch_add_cow(work, path_ptr, copied) {
          Ok(w) => w
          Err(e) => return Err(e)
        }
      }
      PatchOp::Test(path_str, expected) => {
        let ptr = match pointer_parse_impl(path_str) {
          Ok(p) => p
          Err(e) => return Err(e)
        }
        match pointer_get_parsed_impl(work, ptr) {
          Some(actual) => {
            if !value_eq(actual, expected) {
              return Err(patch_err("test operation failed at path: " + path_str))
            }
          }
          None => return Err(patch_err("test target path does not exist: " + path_str))
        }
      }
    }
    i = i + 1
  }
  Ok(work)
}

///| Fast inline scalar equality check (returns `true` iff both are equal scalars;
///| returns `false` if either is a container or if scalars differ).
fn scalar_eq_inline(a : Json5Value, b : Json5Value) -> Bool {
  match (a, b) {
    (Json5Value::Null, Json5Value::Null) => true
    (Json5Value::Bool(x), Json5Value::Bool(y)) => x == y
    (Json5Value::Number(x), Json5Value::Number(y)) => x == y
    (Json5Value::Str(x), Json5Value::Str(y)) => x == y
    _ => false
  }
}

enum DiffTask {
  Cmp(Json5Value, Json5Value, String)
  Emit(PatchOp)
}

///| 100% iterative, single-pass, O(N) RFC 6902 structural diff.
///| Zero recursion, no per-level `value_eq`, inline scalar fast-path (zero path allocation on
///| matching scalars), and seeded LastWins `HashIndex` for objects with >= 16 entries.
fn diff_impl(a : Json5Value, b : Json5Value) -> Patch {
  let ops : Array[PatchOp] = []
  if scalar_eq_inline(a, b) {
    return Patch::{ ops: ops }
  }
  let stack : Array[DiffTask] = [DiffTask::Cmp(a, b, "")]
  while stack.length() > 0 {
    let task = match stack.pop() {
      Some(t) => t
      None => break
    }
    match task {
      DiffTask::Emit(op) => ops.push(op)
      DiffTask::Cmp(va, vb, base_path) => {
        if scalar_eq_inline(va, vb) {
          continue
        }
        match (va, vb) {
          (Json5Value::Object(ea), Json5Value::Object(eb)) => {
            let na = ea.length()
            let nb = eb.length()
            if na < 16 && nb < 16 {
              // Small object path: zero HashIndex allocation, LastWins normalized
              // Queue additions (keys in b not in a) first so they emit after diffs/removals
              let mut j = nb - 1
              while j >= 0 {
                let (kb, sub_b) = eb[j]
                let mut shadowed_b = false
                let mut k = j + 1
                while k < nb {
                  let (kb2, _) = eb[k]
                  if kb2 == kb {
                    shadowed_b = true
                    break
                  }
                  k = k + 1
                }
                if !shadowed_b {
                  let mut in_a = false
                  let mut ia = 0
                  while ia < na {
                    let (ka, _) = ea[ia]
                    if ka == kb {
                      in_a = true
                      break
                    }
                    ia = ia + 1
                  }
                  if !in_a {
                    let child_path = base_path + "/" + pointer_escape_impl(kb)
                    stack.push(DiffTask::Emit(PatchOp::Add(child_path, sub_b)))
                  }
                }
                j = j - 1
              }
              // Queue diffs / removals in reverse order so LIFO pops in forward key order
              let mut i = na - 1
              while i >= 0 {
                let (ka, sub_a) = ea[i]
                let mut shadowed_a = false
                let mut k = i + 1
                while k < na {
                  let (ka2, _) = ea[k]
                  if ka2 == ka {
                    shadowed_a = true
                    break
                  }
                  k = k + 1
                }
                if !shadowed_a {
                  let mut found_b = -1
                  let mut jb = nb - 1
                  while jb >= 0 {
                    let (kb, _) = eb[jb]
                    if kb == ka {
                      found_b = jb
                      break
                    }
                    jb = jb - 1
                  }
                  if found_b >= 0 {
                    let (_, sub_b) = eb[found_b]
                    if !scalar_eq_inline(sub_a, sub_b) {
                      let child_path = base_path + "/" + pointer_escape_impl(ka)
                      stack.push(DiffTask::Cmp(sub_a, sub_b, child_path))
                    }
                  } else {
                    let child_path = base_path + "/" + pointer_escape_impl(ka)
                    stack.push(DiffTask::Emit(PatchOp::Remove(child_path)))
                  }
                }
                i = i - 1
              }
            } else {
              // Wide object path: O(na + nb) via seeded LastWins HashIndex
              let seed = next_seed()
              let hi_b = HashIndex::from_entries_last_wins(eb, seed)
              let has_dup_b = hi_b.len < nb
              let seen_b = FixedArray::make(nb, false)
              // Track removed keys lazily to avoid duplicate Remove ops if ea has duplicates
              let removed_small : Array[String] = []
              let mut removed_hi : Option[HashIndex] = None
              let pending_a : Array[DiffTask] = []

              let mut i = na - 1
              while i >= 0 {
                let (ka, sub_a) = ea[i]
                let idx_b = hi_b.get_entry(ka)
                if idx_b >= 0 {
                  if !seen_b[idx_b] {
                    seen_b[idx_b] = true
                    let (_, sub_b) = eb[idx_b]
                    if !scalar_eq_inline(sub_a, sub_b) {
                      let child_path = base_path + "/" + pointer_escape_impl(ka)
                      pending_a.push(DiffTask::Cmp(sub_a, sub_b, child_path))
                    }
                  }
                } else {
                  let mut already_removed = false
                  match removed_hi {
                    Some(rhi) => {
                      if !rhi.insert_unique(ka, 0) {
                        already_removed = true
                      }
                    }
                    None => {
                      let mut r = 0
                      while r < removed_small.length() {
                        if removed_small[r] == ka {
                          already_removed = true
                          break
                        }
                        r = r + 1
                      }
                      if !already_removed {
                        if removed_small.length() >= 16 {
                          let rhi = HashIndex::new(32, seed)
                          let mut s = 0
                          while s < removed_small.length() {
                            let _ = rhi.insert_unique(removed_small[s], s)
                            s = s + 1
                          }
                          let _ = rhi.insert_unique(ka, removed_small.length())
                          removed_hi = Some(rhi)
                        } else {
                          removed_small.push(ka)
                        }
                      }
                    }
                  }
                  if !already_removed {
                    let child_path = base_path + "/" + pointer_escape_impl(ka)
                    pending_a.push(DiffTask::Emit(PatchOp::Remove(child_path)))
                  }
                }
                i = i - 1
              }

              // Queue additions (keys in b not matched in a) first on LIFO stack
              let mut j = nb - 1
              while j >= 0 {
                if !seen_b[j] {
                  let (kb, sub_b) = eb[j]
                  if !has_dup_b || hi_b.get_entry(kb) == j {
                    let child_path = base_path + "/" + pointer_escape_impl(kb)
                    stack.push(DiffTask::Emit(PatchOp::Add(child_path, sub_b)))
                  }
                }
                j = j - 1
              }
              // Push pending_a onto stack (already collected in reverse order -> pops forward)
              let mut p = 0
              while p < pending_a.length() {
                stack.push(pending_a[p])
                p = p + 1
              }
            }
          }
          (Json5Value::Array(ia), Json5Value::Array(ib)) => {
            let la = ia.length()
            let lb = ib.length()
            let common = if la < lb { la } else { lb }
            // Queue excess removes/adds first so they execute after 0..common-1 diffs
            if la > lb {
              let mut k = lb
              while k < la {
                stack.push(DiffTask::Emit(PatchOp::Remove(base_path + "/" + k.to_string())))
                k = k + 1
              }
            } else if lb > la {
              let mut k = lb - 1
              while k >= la {
                stack.push(DiffTask::Emit(PatchOp::Add(base_path + "/-", ib[k])))
                k = k - 1
              }
            }
            // Queue common elements in reverse order, skipping equal scalars with zero allocation
            let mut i = common - 1
            while i >= 0 {
              let sub_a = ia[i]
              let sub_b = ib[i]
              if !scalar_eq_inline(sub_a, sub_b) {
                let child_path = base_path + "/" + i.to_string()
                stack.push(DiffTask::Cmp(sub_a, sub_b, child_path))
              }
              i = i - 1
            }
          }
          _ => ops.push(PatchOp::Replace(base_path, vb))
        }
      }
    }
  }
  Patch::{ ops: ops }
}
