///| RFC 6901 JSON Pointer implementation.

///| Escape a single reference token (`~` -> `~0`, `/` -> `~1`).
fn pointer_escape_impl(token : String) -> String {
  let n = token.length()
  let mut needs = false
  let mut i = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b == 126 || b == 47 {
      needs = true
      break
    }
    i = i + 1
  }
  if !needs {
    return token
  }
  let sb = StringBuilder::new()
  let mut chunk_start = 0
  i = 0
  while i < n {
    let b = token.code_unit_at(i)
    if b == 126 {
      if i > chunk_start {
        sb.write_string(token.slice(chunk_start, i))
      }
      sb.write_string("~0")
      i = i + 1
      chunk_start = i
    } else if b == 47 {
      if i > chunk_start {
        sb.write_string(token.slice(chunk_start, i))
      }
      sb.write_string("~1")
      i = i + 1
      chunk_start = i
    } else {
      i = i + 1
    }
  }
  if n > chunk_start {
    sb.write_string(token.slice(chunk_start, n))
  }
  sb.to_string()
}

///| Unescape a single reference token (`~1` -> `/`, `~0` -> `~`).
///| Rejects any `~` not followed by `0` or `1`.
fn pointer_unescape_impl(token : String) -> Result[String, Json5Error] {
  let n = token.length()
  let mut has_tilde = false
  let mut i = 0
  while i < n {
    if token.code_unit_at(i) == 126 {
      has_tilde = true
      break
    }
    i = i + 1
  }
  if !has_tilde {
    return Ok(token)
  }
  let sb = StringBuilder::new()
  let mut chunk_start = 0
  i = 0
  while i < n {
    if token.code_unit_at(i) == 126 {
      if i + 1 >= n {
        return Err(Json5Error::new(1, i + 1, i, "dangling '~' in JSON Pointer"))
      }
      let next = token.code_unit_at(i + 1)
      if i > chunk_start {
        sb.write_string(token.slice(chunk_start, i))
      }
      if next == 48 {
        sb.write_byte((126).to_byte())
      } else if next == 49 {
        sb.write_byte((47).to_byte())
      } else {
        return Err(
          Json5Error::new(1, i + 1, i, "invalid escape sequence in JSON Pointer (expected ~0 or ~1)"),
        )
      }
      i = i + 2
      chunk_start = i
    } else {
      i = i + 1
    }
  }
  if n > chunk_start {
    sb.write_string(token.slice(chunk_start, n))
  }
  Ok(sb.to_string())
}

///| Parse an RFC 6901 JSON Pointer string into reference tokens.
fn pointer_parse_impl(ptr : String) -> Result[JsonPointer, Json5Error] {
  let n = ptr.length()
  if n == 0 {
    return Ok(JsonPointer::{ tokens: [] })
  }
  if ptr.code_unit_at(0) != 47 {
    return Err(Json5Error::new(1, 1, 0, "JSON Pointer must be empty or start with '/'"))
  }
  let tokens : Array[String] = []
  let mut seg_start = 1
  let mut i = 1
  while i <= n {
    if i == n || ptr.code_unit_at(i) == 47 {
      let raw = ptr.slice(seg_start, i)
      match pointer_unescape_impl(raw) {
        Ok(tok) => tokens.push(tok)
        Err(e) => return Err(e)
      }
      seg_start = i + 1
    }
    i = i + 1
  }
  Ok(JsonPointer::{ tokens: tokens })
}

///| Format a `JsonPointer` back to its RFC 6901 string form.
fn pointer_to_string_impl(ptr : JsonPointer) -> String {
  let n = ptr.tokens.length()
  if n == 0 {
    return ""
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_byte((47).to_byte())
    sb.write_string(pointer_escape_impl(ptr.tokens[i]))
    i = i + 1
  }
  sb.to_string()
}

///| Parse a strict RFC 6901 array index (`"0"` or `[1-9][0-9]*`, <= 2147483646).
///| Returns `None` for leading zeros (`"01"`), `"-"` , negative, non-digit, or overflow.
fn parse_array_index(token : String) -> Option[Int] {
  let n = token.length()
  if n == 0 || n > 10 {
    return None
  }
  let b0 = token.code_unit_at(0)
  if b0 == 48 {
    if n == 1 {
      return Some(0)
    }
    return None
  }
  if b0 < 49 || b0 > 57 {
    return None
  }
  let mut acc : Int64 = (b0 - 48).to_int64()
  let mut i = 1
  while i < n {
    let b = token.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    acc = acc * 10L + (b - 48).to_int64()
    if acc > 2147483646L {
      return None
    }
    i = i + 1
  }
  Some(acc.to_int())
}

///| Resolve a pre-parsed `JsonPointer` against `doc`.
fn pointer_get_parsed_impl(
  doc : Json5Value,
  ptr : JsonPointer,
) -> Option[Json5Value] {
  let mut cur = doc
  let n = ptr.tokens.length()
  let mut i = 0
  while i < n {
    let tok = ptr.tokens[i]
    match cur {
      Json5Value::Object(entries) => {
        let mut found : Option[Json5Value] = None
        let mut j = 0
        let m = entries.length()
        while j < m {
          let (k, v) = entries[j]
          if k == tok {
            found = Some(v)
            break
          }
          j = j + 1
        }
        match found {
          Some(next) => cur = next
          None => return None
        }
      }
      Json5Value::Array(items) => {
        match parse_array_index(tok) {
          Some(idx) => {
            if idx >= 0 && idx < items.length() {
              cur = items[idx]
            } else {
              return None
            }
          }
          None => return None
        }
      }
      _ => return None
    }
    i = i + 1
  }
  Some(cur)
}
