///| Strict UTF-8 validation, decoding, encoding, and 1-based line/col tracking for `json5`.

///| Encode a valid Unicode scalar value (0..=0x10FFFF, excluding surrogates) as UTF-8.
fn write_utf8(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Decode one validated UTF-8 code point at byte offset `pos`. Returns `(cp, byte_len)`.
fn decode_utf8_at(s : String, pos : Int) -> (Int, Int) {
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    (b0, 1)
  } else if b0 < 0xE0 {
    let b1 = s.code_unit_at(pos + 1)
    (((b0 & 0x1F) << 6) | (b1 & 0x3F), 2)
  } else if b0 < 0xF0 {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), 3)
  } else {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    (
      ((b0 & 0x07) << 18) |
      ((b1 & 0x3F) << 12) |
      ((b2 & 0x3F) << 6) |
      (b3 & 0x3F),
      4,
    )
  }
}

///| Compute (line, col) 1-based position at byte offset `off` in `s`.
///| Handles LF, CRLF, CR, U+2028, and U+2029 as line terminators.
fn line_col_at(s : String, off : Int) -> (Int, Int) {
  let n = s.length()
  let limit = if off < n { off } else { n }
  let mut line = 1
  let mut col = 1
  let mut i = 0
  while i < limit {
    let b = s.code_unit_at(i)
    if b == 10 {
      line = line + 1
      col = 1
      i = i + 1
    } else if b == 13 {
      line = line + 1
      col = 1
      if i + 1 < limit && s.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
    } else if b == 0xE2 &&
    i + 2 < limit &&
    s.code_unit_at(i + 1) == 0x80 &&
    (s.code_unit_at(i + 2) == 0xA8 || s.code_unit_at(i + 2) == 0xA9) {
      line = line + 1
      col = 1
      i = i + 3
    } else {
      if (b & 0xC0) != 0x80 {
        col = col + 1
      }
      i = i + 1
    }
  }
  (line, col)
}

///| Return true if `b` is a UTF-8 continuation byte (`10xxxxxx`).
#verify
pub fn is_utf8_cont(b : Int) -> Bool {
  (b & 0xC0) == 0x80
}

///| Validate a 3-byte UTF-8 sequence per RFC 3629 (rejecting overlongs and UTF-16 surrogates).
#verify
pub fn utf8_valid_3byte(b0 : Int, b1 : Int, b2 : Int) -> Bool {
  b0 >= 0xE0 &&
  b0 <= 0xEF &&
  is_utf8_cont(b1) &&
  is_utf8_cont(b2) &&
  !(b0 == 0xE0 && b1 < 0xA0) &&
  !(b0 == 0xED && b1 >= 0xA0)
}

///| Validate a 4-byte UTF-8 sequence per RFC 3629 (rejecting overlongs and `> U+10FFFF`).
#verify
pub fn utf8_valid_4byte(b0 : Int, b1 : Int, b2 : Int, b3 : Int) -> Bool {
  b0 >= 0xF0 &&
  b0 <= 0xF4 &&
  is_utf8_cont(b1) &&
  is_utf8_cont(b2) &&
  is_utf8_cont(b3) &&
  !(b0 == 0xF0 && b1 < 0x90) &&
  !(b0 == 0xF4 && b1 > 0x8F)
}

///| Validate a UTF-8 byte sequence in a `String`. Rejects overlong sequences,
///| UTF-16 surrogates (U+D800..U+DFFF), code points > U+10FFFF, and truncated sequences.
fn validate_utf8_str(s : String) -> Result[Unit, Json5Error] {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        let (ln, cl) = line_col_at(s, i)
        return Err(Json5Error::new(ln, cl, i, "truncated 2-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) != 0x80 {
        let (ln, cl) = line_col_at(s, i)
        return Err(Json5Error::new(ln, cl, i, "invalid UTF-8 continuation byte"))
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        let (ln, cl) = line_col_at(s, i)
        return Err(Json5Error::new(ln, cl, i, "truncated 3-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if !utf8_valid_3byte(b0, b1, b2) {
        if !is_utf8_cont(b1) || !is_utf8_cont(b2) {
          let (ln, cl) = line_col_at(s, i)
          return Err(Json5Error::new(ln, cl, i, "invalid UTF-8 continuation byte"))
        }
        if b0 == 0xE0 && b1 < 0xA0 {
          let (ln, cl) = line_col_at(s, i)
          return Err(Json5Error::new(ln, cl, i, "overlong 3-byte UTF-8 sequence"))
        }
        let (ln, cl) = line_col_at(s, i)
        return Err(Json5Error::new(ln, cl, i, "UTF-16 surrogate code point in UTF-8"))
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        let (ln, cl) = line_col_at(s, i)
        return Err(Json5Error::new(ln, cl, i, "truncated 4-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if !utf8_valid_4byte(b0, b1, b2, b3) {
        if !is_utf8_cont(b1) || !is_utf8_cont(b2) || !is_utf8_cont(b3) {
          let (ln, cl) = line_col_at(s, i)
          return Err(Json5Error::new(ln, cl, i, "invalid UTF-8 continuation byte"))
        }
        if b0 == 0xF0 && b1 < 0x90 {
          let (ln, cl) = line_col_at(s, i)
          return Err(Json5Error::new(ln, cl, i, "overlong 4-byte UTF-8 sequence"))
        }
        let (ln, cl) = line_col_at(s, i)
        return Err(Json5Error::new(ln, cl, i, "UTF-8 code point above U+10FFFF"))
      }
      i = i + 4
    } else {
      let (ln, cl) = line_col_at(s, i)
      return Err(Json5Error::new(ln, cl, i, "invalid UTF-8 lead byte"))
    }
  }
  Ok(())
}

///| Validate raw `Bytes` as strict UTF-8 and convert to a `String`.
fn validate_utf8_bytes(bs : Bytes) -> Result[String, Json5Error] {
  let n = bs.length()
  let mut i = 0
  let mut line = 1
  let mut col = 1
  while i < n {
    let b0 = bs[i].to_int()
    if b0 < 0x80 {
      if b0 == 10 {
        line = line + 1
        col = 1
      } else {
        col = col + 1
      }
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        return Err(Json5Error::new(line, col, i, "truncated 2-byte UTF-8 sequence"))
      }
      let b1 = bs[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return Err(Json5Error::new(line, col, i, "invalid UTF-8 continuation byte"))
      }
      i = i + 2
      col = col + 1
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        return Err(Json5Error::new(line, col, i, "truncated 3-byte UTF-8 sequence"))
      }
      let b1 = bs[i + 1].to_int()
      let b2 = bs[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return Err(Json5Error::new(line, col, i, "invalid UTF-8 continuation byte"))
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return Err(Json5Error::new(line, col, i, "overlong 3-byte UTF-8 sequence"))
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return Err(Json5Error::new(line, col, i, "UTF-16 surrogate code point in UTF-8"))
      }
      i = i + 3
      col = col + 1
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        return Err(Json5Error::new(line, col, i, "truncated 4-byte UTF-8 sequence"))
      }
      let b1 = bs[i + 1].to_int()
      let b2 = bs[i + 2].to_int()
      let b3 = bs[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return Err(Json5Error::new(line, col, i, "invalid UTF-8 continuation byte"))
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return Err(Json5Error::new(line, col, i, "overlong 4-byte UTF-8 sequence"))
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return Err(Json5Error::new(line, col, i, "UTF-8 code point above U+10FFFF"))
      }
      i = i + 4
      col = col + 1
    } else {
      return Err(Json5Error::new(line, col, i, "invalid UTF-8 lead byte"))
    }
  }
  let sb = StringBuilder::new()
  let mut j = 0
  while j < n {
    sb.write_byte(bs[j])
    j = j + 1
  }
  Ok(sb.to_string())
}
