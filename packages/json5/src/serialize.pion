///| Iterative JSON (RFC 8259) and JSON5 v2.0 serializers with exact Ryu float formatting.

let hex_digits_upper : FixedArray[Byte] = [
  (48).to_byte(), (49).to_byte(), (50).to_byte(), (51).to_byte(),
  (52).to_byte(), (53).to_byte(), (54).to_byte(), (55).to_byte(),
  (56).to_byte(), (57).to_byte(), (65).to_byte(), (66).to_byte(),
  (67).to_byte(), (68).to_byte(), (69).to_byte(), (70).to_byte(),
]

///| Return true if ASCII byte `b` must be escaped inside a JSON/JSON5 double-quoted string.
pub fn json_needs_escape_ascii(b : Int) -> Bool {
  b == 34 || b == 92 || b < 0x20
}

fn write_escaped_string(sb : StringBuilder, s : String, json5_mode : Bool) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut chunk_start = 0
  let mut i = 0
  while i < n {
    // 4-byte unrolled printable-ASCII fast scan
    while i + 4 <= n {
      let b0 = s.code_unit_at(i)
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b0 | b1 | b2 | b3) < 0x80 &&
      b0 >= 32 && b1 >= 32 && b2 >= 32 && b3 >= 32 &&
      b0 != 34 && b1 != 34 && b2 != 34 && b3 != 34 &&
      b0 != 92 && b1 != 92 && b2 != 92 && b3 != 92 {
        i = i + 4
        continue
      }
      break
    }
    if i >= n {
      break
    }
    let b = s.code_unit_at(i)
    if b < 0x80 {
      if b == 34 || b == 92 || b < 0x20 {
        if i > chunk_start {
          sb.write_substring(s, chunk_start, i)
        }
        if b == 34 {
          sb.write_string("\\\"")
        } else if b == 92 {
          sb.write_string("\\\\")
        } else if b == 8 {
          sb.write_string("\\b")
        } else if b == 12 {
          sb.write_string("\\f")
        } else if b == 10 {
          sb.write_string("\\n")
        } else if b == 13 {
          sb.write_string("\\r")
        } else if b == 9 {
          sb.write_string("\\t")
        } else {
          sb.write_string("\\u00")
          sb.write_byte(hex_digits_upper[(b >> 4) & 0xF])
          sb.write_byte(hex_digits_upper[b & 0xF])
        }
        i = i + 1
        chunk_start = i
      } else {
        i = i + 1
      }
    } else if json5_mode &&
    b == 0xE2 &&
    i + 2 < n &&
    s.code_unit_at(i + 1) == 0x80 &&
    (s.code_unit_at(i + 2) == 0xA8 || s.code_unit_at(i + 2) == 0xA9) {
      if i > chunk_start {
        sb.write_substring(s, chunk_start, i)
      }
      if s.code_unit_at(i + 2) == 0xA8 {
        sb.write_string("\\u2028")
      } else {
        sb.write_string("\\u2029")
      }
      i = i + 3
      chunk_start = i
    } else {
      i = i + 1
    }
  }
  if chunk_start == 0 {
    if n > 0 {
      sb.write_string(s)
    }
  } else if n > chunk_start {
    sb.write_substring(s, chunk_start, n)
  }
  sb.write_byte((34).to_byte())
}

fn write_indent(sb : StringBuilder, spaces : Int) -> Unit {
  let mut rem = spaces
  while rem >= 8 {
    sb.write_string("        ")
    rem = rem - 8
  }
  while rem > 0 {
    sb.write_byte((32).to_byte())
    rem = rem - 1
  }
}

struct SerFrame {
  is_obj : Bool
  arr : Array[Json5Value]
  obj : Array[(String, Json5Value)]
  mut idx : Int
  depth : Int
}

fn estimate_ser_cap(root : Json5Value) -> Int {
  let est = match root {
    Json5Value::Object(entries) => {
      let mut total = entries.length() * 32
      let mut i = 0
      let lim = if entries.length() < 16 { entries.length() } else { 16 }
      while i < lim {
        let (_, v) = entries[i]
        match v {
          Json5Value::Array(a) => total = total + a.length() * 256
          Json5Value::Object(o) => total = total + o.length() * 64
          _ => ()
        }
        i = i + 1
      }
      total
    }
    Json5Value::Array(items) => {
      let mut total = items.length() * 64
      if items.length() > 0 {
        match items[0] {
          Json5Value::Object(o) => total = items.length() * (o.length() * 32 + 16)
          Json5Value::Array(a) => total = items.length() * (a.length() * 16 + 8)
          _ => ()
        }
      }
      total
    }
    Json5Value::Str(s) => s.length() + 16
    _ => 64
  }
  if est < 256 { 256 } else if est > 4194304 { 4194304 } else { est }
}

fn ser_emit_val(
  sb : StringBuilder,
  digit_buf : FixedArray[Byte],
  v : Json5Value,
  depth : Int,
  json5_mode : Bool,
  stack : Array[SerFrame],
  empty_arr : Array[Json5Value],
  empty_obj : Array[(String, Json5Value)],
) -> Bool {
  match v {
    Json5Value::Null => {
      sb.write_string("null")
      true
    }
    Json5Value::Bool(b) => {
      sb.write_string(if b { "true" } else { "false" })
      true
    }
    Json5Value::Number(x) => write_json_number_buf(sb, x, json5_mode, digit_buf)
    Json5Value::Str(s) => {
      write_escaped_string(sb, s, json5_mode)
      true
    }
    Json5Value::Array(items) => {
      if items.length() == 0 {
        sb.write_string("[]")
      } else {
        sb.write_byte((91).to_byte())
        stack.push(
          SerFrame::{
            is_obj: false,
            arr: items,
            obj: empty_obj,
            idx: 0,
            depth: depth,
          },
        )
      }
      true
    }
    Json5Value::Object(entries) => {
      if entries.length() == 0 {
        sb.write_string("{}")
      } else {
        sb.write_byte((123).to_byte())
        stack.push(
          SerFrame::{
            is_obj: true,
            arr: empty_arr,
            obj: entries,
            idx: 0,
            depth: depth,
          },
        )
      }
      true
    }
  }
}

fn write_json_string_compact(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut chunk_start = 0
  let mut i = 0
  while i < n {
    while i + 4 <= n {
      let b0 = s.code_unit_at(i)
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b0 | b1 | b2 | b3) < 0x80 &&
      b0 >= 32 && b1 >= 32 && b2 >= 32 && b3 >= 32 &&
      b0 != 34 && b1 != 34 && b2 != 34 && b3 != 34 &&
      b0 != 92 && b1 != 92 && b2 != 92 && b3 != 92 {
        i = i + 4
        continue
      }
      break
    }
    if i >= n {
      break
    }
    let b = s.code_unit_at(i)
    if b < 0x80 && (b == 34 || b == 92 || b < 0x20) {
      if i > chunk_start {
        sb.write_substring(s, chunk_start, i)
      }
      if b == 34 {
        sb.write_string("\\\"")
      } else if b == 92 {
        sb.write_string("\\\\")
      } else if b == 8 {
        sb.write_string("\\b")
      } else if b == 12 {
        sb.write_string("\\f")
      } else if b == 10 {
        sb.write_string("\\n")
      } else if b == 13 {
        sb.write_string("\\r")
      } else if b == 9 {
        sb.write_string("\\t")
      } else {
        sb.write_string("\\u00")
        sb.write_byte(hex_digits_upper[(b >> 4) & 0xF])
        sb.write_byte(hex_digits_upper[b & 0xF])
      }
      i = i + 1
      chunk_start = i
    } else {
      i = i + 1
    }
  }
  if chunk_start == 0 {
    if n > 0 {
      sb.write_string(s)
    }
  } else if n > chunk_start {
    sb.write_substring(s, chunk_start, n)
  }
  sb.write_byte((34).to_byte())
}

fn serialize_compact_json(root : Json5Value) -> Result[String, Json5Error] {
  let sb = StringBuilder::with_capacity(estimate_ser_cap(root))
  let digit_buf : FixedArray[Byte] = FixedArray::make(24, (0).to_byte())
  let stack : Array[SerFrame] = Array::with_capacity(16)
  let empty_arr : Array[Json5Value] = []
  let empty_obj : Array[(String, Json5Value)] = []

  match root {
    Json5Value::Null => sb.write_string("null")
    Json5Value::Bool(b) => sb.write_string(if b { "true" } else { "false" })
    Json5Value::Number(x) => {
      if !write_json_number_buf(sb, x, false, digit_buf) {
        return Err(
          Json5Error::new(
            1,
            1,
            0,
            "non-finite number (NaN/Infinity) cannot be serialized to strict JSON",
          ),
        )
      }
    }
    Json5Value::Str(s) => write_json_string_compact(sb, s)
    Json5Value::Array(items) => {
      if items.length() == 0 {
        sb.write_string("[]")
      } else {
        sb.write_byte((91).to_byte())
        stack.push(
          SerFrame::{ is_obj: false, arr: items, obj: empty_obj, idx: 0, depth: 0 },
        )
      }
    }
    Json5Value::Object(entries) => {
      if entries.length() == 0 {
        sb.write_string("{}")
      } else {
        sb.write_byte((123).to_byte())
        stack.push(
          SerFrame::{ is_obj: true, arr: empty_arr, obj: entries, idx: 0, depth: 0 },
        )
      }
    }
  }

  while stack.length() > 0 {
    let top = stack[stack.length() - 1]
    if !top.is_obj {
      let items = top.arr
      let len = items.length()
      let mut pushed = false
      while top.idx < len {
        let idx = top.idx
        top.idx = idx + 1
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        match items[idx] {
          Json5Value::Null => sb.write_string("null")
          Json5Value::Bool(b) => sb.write_string(if b { "true" } else { "false" })
          Json5Value::Number(x) => {
            if !write_json_number_buf(sb, x, false, digit_buf) {
              return Err(
                Json5Error::new(
                  1,
                  1,
                  0,
                  "non-finite number (NaN/Infinity) cannot be serialized to strict JSON",
                ),
              )
            }
          }
          Json5Value::Str(s) => write_json_string_compact(sb, s)
          Json5Value::Array(sub) => {
            if sub.length() == 0 {
              sb.write_string("[]")
            } else {
              sb.write_byte((91).to_byte())
              stack.push(
                SerFrame::{ is_obj: false, arr: sub, obj: empty_obj, idx: 0, depth: 0 },
              )
              pushed = true
              break
            }
          }
          Json5Value::Object(sub) => {
            if sub.length() == 0 {
              sb.write_string("{}")
            } else {
              sb.write_byte((123).to_byte())
              stack.push(
                SerFrame::{ is_obj: true, arr: empty_arr, obj: sub, idx: 0, depth: 0 },
              )
              pushed = true
              break
            }
          }
        }
      }
      if !pushed {
        let _ = stack.pop()
        sb.write_byte((93).to_byte())
      }
    } else {
      let entries = top.obj
      let len = entries.length()
      let mut pushed = false
      while top.idx < len {
        let idx = top.idx
        top.idx = idx + 1
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        let (k, v) = entries[idx]
        write_json_string_compact(sb, k)
        sb.write_byte((58).to_byte())
        match v {
          Json5Value::Null => sb.write_string("null")
          Json5Value::Bool(b) => sb.write_string(if b { "true" } else { "false" })
          Json5Value::Number(x) => {
            if !write_json_number_buf(sb, x, false, digit_buf) {
              return Err(
                Json5Error::new(
                  1,
                  1,
                  0,
                  "non-finite number (NaN/Infinity) cannot be serialized to strict JSON",
                ),
              )
            }
          }
          Json5Value::Str(s) => write_json_string_compact(sb, s)
          Json5Value::Array(sub) => {
            if sub.length() == 0 {
              sb.write_string("[]")
            } else {
              sb.write_byte((91).to_byte())
              stack.push(
                SerFrame::{ is_obj: false, arr: sub, obj: empty_obj, idx: 0, depth: 0 },
              )
              pushed = true
              break
            }
          }
          Json5Value::Object(sub) => {
            if sub.length() == 0 {
              sb.write_string("{}")
            } else {
              sb.write_byte((123).to_byte())
              stack.push(
                SerFrame::{ is_obj: true, arr: empty_arr, obj: sub, idx: 0, depth: 0 },
              )
              pushed = true
              break
            }
          }
        }
      }
      if !pushed {
        let _ = stack.pop()
        sb.write_byte((125).to_byte())
      }
    }
  }
  Ok(sb.to_string())
}

fn serialize_impl(
  root : Json5Value,
  json5_mode : Bool,
  indent : Int,
) -> Result[String, Json5Error] {
  if !json5_mode && indent == 0 {
    return serialize_compact_json(root)
  }
  let sb = StringBuilder::with_capacity(estimate_ser_cap(root))
  let digit_buf : FixedArray[Byte] = FixedArray::make(24, (0).to_byte())
  let pretty = indent > 0
  let stack : Array[SerFrame] = Array::with_capacity(16)
  let empty_arr : Array[Json5Value] = []
  let empty_obj : Array[(String, Json5Value)] = []

  if !ser_emit_val(sb, digit_buf, root, 0, json5_mode, stack, empty_arr, empty_obj) {
    return Err(
      Json5Error::new(
        1,
        1,
        0,
        "non-finite number (NaN/Infinity) cannot be serialized to strict JSON",
      ),
    )
  }

  while stack.length() > 0 {
    let top = stack[stack.length() - 1]
    if !top.is_obj {
      let items = top.arr
      let len = items.length()
      let child_depth = top.depth + 1
      let mut pushed = false
      while top.idx < len {
        let idx = top.idx
        top.idx = idx + 1
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, child_depth * indent)
        }
        let prev_depth = stack.length()
        if !ser_emit_val(sb, digit_buf, items[idx], child_depth, json5_mode, stack, empty_arr, empty_obj) {
          return Err(
            Json5Error::new(
              1,
              1,
              0,
              "non-finite number (NaN/Infinity) cannot be serialized to strict JSON",
            ),
          )
        }
        if stack.length() > prev_depth {
          pushed = true
          break
        }
      }
      if !pushed {
        let _ = stack.pop()
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, top.depth * indent)
        }
        sb.write_byte((93).to_byte())
      }
    } else {
      let entries = top.obj
      let len = entries.length()
      let child_depth = top.depth + 1
      let mut pushed = false
      while top.idx < len {
        let idx = top.idx
        top.idx = idx + 1
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, child_depth * indent)
        }
        let (k, v) = entries[idx]
        if json5_mode && is_simple_ascii_identifier(k) {
          sb.write_string(k)
        } else {
          write_escaped_string(sb, k, json5_mode)
        }
        if pretty {
          sb.write_string(": ")
        } else {
          sb.write_byte((58).to_byte())
        }
        let prev_depth = stack.length()
        if !ser_emit_val(sb, digit_buf, v, child_depth, json5_mode, stack, empty_arr, empty_obj) {
          return Err(
            Json5Error::new(
              1,
              1,
              0,
              "non-finite number (NaN/Infinity) cannot be serialized to strict JSON",
            ),
          )
        }
        if stack.length() > prev_depth {
          pushed = true
          break
        }
      }
      if !pushed {
        let _ = stack.pop()
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, top.depth * indent)
        }
        sb.write_byte((125).to_byte())
      }
    }
  }
  Ok(sb.to_string())
}
