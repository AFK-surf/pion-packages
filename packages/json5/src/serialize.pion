///| Iterative JSON (RFC 8259) and JSON5 v2.0 serializers with exact Ryu float formatting.

let hex_digits_upper : FixedArray[Byte] = [
  (48).to_byte(), (49).to_byte(), (50).to_byte(), (51).to_byte(),
  (52).to_byte(), (53).to_byte(), (54).to_byte(), (55).to_byte(),
  (56).to_byte(), (57).to_byte(), (65).to_byte(), (66).to_byte(),
  (67).to_byte(), (68).to_byte(), (69).to_byte(), (70).to_byte(),
]

fn write_escaped_string(sb : StringBuilder, s : String, json5_mode : Bool) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut chunk_start = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 || b == 92 || b < 0x20 {
      if i > chunk_start {
        sb.write_string(s.slice(chunk_start, i))
      }
      if b == 34 {
        sb.write_string("\\\"")
      } else if b == 92 {
        sb.write_string("\\\\")
      } else if b == 8 {
        sb.write_string("\\b")
      } else if b == 12 {
        sb.write_string("\\f")
      } else if b == 10 {
        sb.write_string("\\n")
      } else if b == 13 {
        sb.write_string("\\r")
      } else if b == 9 {
        sb.write_string("\\t")
      } else {
        sb.write_string("\\u00")
        sb.write_byte(hex_digits_upper[(b >> 4) & 0xF])
        sb.write_byte(hex_digits_upper[b & 0xF])
      }
      i = i + 1
      chunk_start = i
    } else if json5_mode &&
    b == 0xE2 &&
    i + 2 < n &&
    s.code_unit_at(i + 1) == 0x80 &&
    (s.code_unit_at(i + 2) == 0xA8 || s.code_unit_at(i + 2) == 0xA9) {
      if i > chunk_start {
        sb.write_string(s.slice(chunk_start, i))
      }
      if s.code_unit_at(i + 2) == 0xA8 {
        sb.write_string("\\u2028")
      } else {
        sb.write_string("\\u2029")
      }
      i = i + 3
      chunk_start = i
    } else {
      i = i + 1
    }
  }
  if n > chunk_start {
    sb.write_string(s.slice(chunk_start, n))
  }
  sb.write_byte((34).to_byte())
}

fn write_indent(sb : StringBuilder, spaces : Int) -> Unit {
  let mut i = 0
  while i < spaces {
    sb.write_byte((32).to_byte())
    i = i + 1
  }
}

enum SerTask {
  Val(Json5Value, Int)
  ArrNext(Array[Json5Value], Int, Int)
  ObjNext(Array[(String, Json5Value)], Int, Int)
  CloseArr(Int)
  CloseObj(Int)
}

fn serialize_impl(
  root : Json5Value,
  json5_mode : Bool,
  indent : Int,
) -> Result[String, Json5Error] {
  let sb = StringBuilder::new()
  let pretty = indent > 0
  let stack : Array[SerTask] = [SerTask::Val(root, 0)]

  while stack.length() > 0 {
    let task = match stack.pop() {
      Some(t) => t
      None => break
    }
    match task {
      SerTask::Val(v, depth) => {
        match v {
          Json5Value::Null => sb.write_string("null")
          Json5Value::Bool(b) => sb.write_string(if b { "true" } else { "false" })
          Json5Value::Number(x) => {
            if !write_json_number(sb, x, json5_mode) {
              return Err(
                Json5Error::new(
                  1,
                  1,
                  0,
                  "non-finite number (NaN/Infinity) cannot be serialized to strict JSON",
                ),
              )
            }
          }
          Json5Value::Str(s) => write_escaped_string(sb, s, json5_mode)
          Json5Value::Array(items) => {
            if items.length() == 0 {
              sb.write_string("[]")
            } else {
              sb.write_byte((91).to_byte())
              stack.push(SerTask::CloseArr(depth))
              stack.push(SerTask::ArrNext(items, 0, depth + 1))
            }
          }
          Json5Value::Object(entries) => {
            if entries.length() == 0 {
              sb.write_string("{}")
            } else {
              sb.write_byte((123).to_byte())
              stack.push(SerTask::CloseObj(depth))
              stack.push(SerTask::ObjNext(entries, 0, depth + 1))
            }
          }
        }
      }
      SerTask::ArrNext(items, idx, child_depth) => {
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, child_depth * indent)
        }
        if idx + 1 < items.length() {
          stack.push(SerTask::ArrNext(items, idx + 1, child_depth))
        }
        stack.push(SerTask::Val(items[idx], child_depth))
      }
      SerTask::ObjNext(entries, idx, child_depth) => {
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, child_depth * indent)
        }
        let (k, v) = entries[idx]
        if json5_mode && is_simple_ascii_identifier(k) {
          sb.write_string(k)
        } else {
          write_escaped_string(sb, k, json5_mode)
        }
        if pretty {
          sb.write_string(": ")
        } else {
          sb.write_byte((58).to_byte())
        }
        if idx + 1 < entries.length() {
          stack.push(SerTask::ObjNext(entries, idx + 1, child_depth))
        }
        stack.push(SerTask::Val(v, child_depth))
      }
      SerTask::CloseArr(depth) => {
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, depth * indent)
        }
        sb.write_byte((93).to_byte())
      }
      SerTask::CloseObj(depth) => {
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, depth * indent)
        }
        sb.write_byte((125).to_byte())
      }
    }
  }
  Ok(sb.to_string())
}
