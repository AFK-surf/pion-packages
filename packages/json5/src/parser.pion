///| High-performance, 100% iterative JSON5 v2.0 / JSONC / RFC 8259 JSON parser.
///| Zero recursion (explicit heap container stack), zero-copy slice scanning on unescaped strings,
///| 256-byte ASCII LUTs, and seeded HashIndex for large objects.

struct ParseFrame {
  is_obj : Bool
  arr : Array[Json5Value]
  entries : Array[(String, Json5Value)]
  mut index : Option[HashIndex]
  mut pending_key : String
}

struct Parser {
  src : String
  len : Int
  opts : ParseOptions
  seed : UInt64
  mut pos : Int
  mut nodes : Int
  mut has_err : Bool
  mut err_off : Int
  mut err_msg : String
}

fn Parser::new(src : String, opts : ParseOptions) -> Parser {
  Parser::{
    src: src,
    len: src.length(),
    opts: opts,
    seed: derive_doc_seed(src),
    pos: 0,
    nodes: 0,
    has_err: false,
    err_off: 0,
    err_msg: "",
  }
}

fn Parser::err(self : Parser, off : Int, msg : String) -> Json5Error {
  let (ln, cl) = line_col_at(self.src, off)
  Json5Error::new(ln, cl, off, msg)
}

fn Parser::set_err(self : Parser, off : Int, msg : String) -> Unit {
  self.has_err = true
  self.err_off = off
  self.err_msg = msg
}

fn Parser::to_err(self : Parser) -> Json5Error {
  self.err(self.err_off, self.err_msg)
}

///| Skip whitespace and (when allowed) `//` and `/* */` comments.
fn Parser::skip_ws(self : Parser) -> Unit {
  let s = self.src
  let n = self.len
  let allow_j5 = self.opts.allow_json5
  let allow_comments = self.opts.allow_comments
  let mut p = self.pos
  while p < n {
    let b = s.code_unit_at(p)
    if b < 0x80 {
      if b == 32 {
        p = p + 1
        while p + 4 <= n &&
        s.code_unit_at(p) == 32 &&
        s.code_unit_at(p + 1) == 32 &&
        s.code_unit_at(p + 2) == 32 &&
        s.code_unit_at(p + 3) == 32 {
          p = p + 4
        }
        continue
      }
      if b == 10 || b == 13 || b == 9 {
        p = p + 1
        continue
      }
      if allow_j5 && (b == 11 || b == 12) {
        p = p + 1
        continue
      }
      if b == 47 && allow_comments && p + 1 < n {
        let b2 = s.code_unit_at(p + 1)
        if b2 == 47 {
          // Single-line comment // ... until LF, CR, U+2028, U+2029, or EOF
          p = p + 2
          while p < n {
            let c = s.code_unit_at(p)
            if c < 0x80 {
              if c == 10 || c == 13 {
                p = p + 1
                break
              }
              p = p + 1
            } else if c == 0xE2 &&
            p + 2 < n &&
            s.code_unit_at(p + 1) == 0x80 &&
            (s.code_unit_at(p + 2) == 0xA8 || s.code_unit_at(p + 2) == 0xA9) {
              p = p + 3
              break
            } else {
              p = p + 1
            }
          }
          continue
        }
        if b2 == 42 {
          // Multi-line block comment /* ... */
          let start = p
          p = p + 2
          let mut closed = false
          while p + 1 < n {
            if s.code_unit_at(p) == 42 && s.code_unit_at(p + 1) == 47 {
              p = p + 2
              closed = true
              break
            }
            p = p + 1
          }
          if !closed {
            self.pos = start
            self.set_err(start, "unterminated block comment")
            return
          }
          continue
        }
      }
      break
    } else if allow_j5 {
      let (cp, clen) = decode_utf8_at(s, p)
      if is_unicode_j5_ws(cp) {
        p = p + clen
        continue
      }
      break
    } else {
      break
    }
  }
  self.pos = p
}

///| Return true if `cp` is a UTF-16 high surrogate (`0xD800..0xDBFF`).
#verify
pub fn is_high_surrogate(cp : Int) -> Bool {
  cp >= 0xD800 && cp <= 0xDBFF
}

///| Return true if `cp` is a UTF-16 low surrogate (`0xDC00..0xDFFF`).
#verify
pub fn is_low_surrogate(cp : Int) -> Bool {
  cp >= 0xDC00 && cp <= 0xDFFF
}

///| Combine a validated UTF-16 surrogate pair `(hi, lo)` into a Unicode scalar (`0x10000..0x10FFFF`).
#verify
pub fn decode_surrogate_pair(hi : Int, lo : Int) -> Int {
  0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
}

///| Pack 4 hex nibbles (`0..15`) into a 16-bit code unit (`0..0xFFFF`).
pub fn pack_hex4(d0 : Int, d1 : Int, d2 : Int, d3 : Int) -> Int {
  (d0 << 12) | (d1 << 8) | (d2 << 4) | d3
}

///| Pack 2 hex nibbles (`0..15`) into a byte (`0..0xFF`).
#verify
pub fn pack_hex2(h0 : Int, h1 : Int) -> Int {
  (h0 << 4) | h1
}

///| Parse 4 hex digits starting at `self.pos`. Returns `-1` on error (sets `self.has_err`).
fn Parser::parse_hex4(self : Parser) -> Int {
  if self.pos + 4 > self.len {
    self.set_err(self.pos, "incomplete \\uXXXX escape")
    return -1
  }
  let s = self.src
  let d0 = hex_val(s.code_unit_at(self.pos))
  let d1 = hex_val(s.code_unit_at(self.pos + 1))
  let d2 = hex_val(s.code_unit_at(self.pos + 2))
  let d3 = hex_val(s.code_unit_at(self.pos + 3))
  if (d0 | d1 | d2 | d3) >= 16 {
    self.set_err(self.pos, "invalid hex digit in \\uXXXX escape")
    return -1
  }
  self.pos = self.pos + 4
  pack_hex4(d0, d1, d2, d3)
}

///| Parse a double-quoted or single-quoted string literal.
fn Parser::parse_string(self : Parser) -> String {
  let s = self.src
  let n = self.len
  let quote = s.code_unit_at(self.pos)
  if quote == 39 && !self.opts.allow_json5 {
    self.set_err(self.pos, "single-quoted strings are not allowed in JSON/JSONC")
    return ""
  }
  let allow_j5 = self.opts.allow_json5
  let lut = ascii_lut
  let stop_mask = if quote == 34 { 32 } else { 64 }
  let start_pos = self.pos
  let mut p = self.pos + 1
  let content_start = p

  // Fast zero-copy scan for unescaped strings (4-byte unrolled ASCII loop)
  while p < n {
    while p + 4 <= n {
      let b0 = s.code_unit_at(p)
      let b1 = s.code_unit_at(p + 1)
      let b2 = s.code_unit_at(p + 2)
      let b3 = s.code_unit_at(p + 3)
      if (b0 | b1 | b2 | b3) < 0x80 &&
      b0 >= 32 && b1 >= 32 && b2 >= 32 && b3 >= 32 &&
      b0 != quote && b1 != quote && b2 != quote && b3 != quote &&
      b0 != 92 && b1 != 92 && b2 != 92 && b3 != 92 {
        p = p + 4
        continue
      }
      break
    }
    if p >= n {
      break
    }
    let b = s.code_unit_at(p)
    if b < 0x80 {
      if (lut[b].to_int() & stop_mask) != 0 {
        if b == quote {
          self.pos = p + 1
          return s.slice(content_start, p)
        }
        break
      }
      p = p + 1
    } else {
      p = p + 1
    }
  }

  // Slow path with StringBuilder for escapes / validation
  let sb = StringBuilder::with_capacity((p - content_start) + 32)
  if p > content_start {
    sb.write_substring(s, content_start, p)
  }
  let mut chunk_start = p
  while p < n {
    let b = s.code_unit_at(p)
    if b == quote {
      if p > chunk_start {
        sb.write_substring(s, chunk_start, p)
      }
      self.pos = p + 1
      return sb.to_string()
    }
    if b == 92 {
      // Backslash escape
      if p > chunk_start {
        sb.write_substring(s, chunk_start, p)
      }
      p = p + 1
      if p >= n {
        self.set_err(p, "unterminated escape sequence")
        return ""
      }
      let esc = s.code_unit_at(p)
      if esc == 34 {
        sb.write_byte((34).to_byte())
        p = p + 1
      } else if esc == 92 {
        sb.write_byte((92).to_byte())
        p = p + 1
      } else if esc == 47 {
        sb.write_byte((47).to_byte())
        p = p + 1
      } else if esc == 98 {
        sb.write_byte((8).to_byte())
        p = p + 1
      } else if esc == 102 {
        sb.write_byte((12).to_byte())
        p = p + 1
      } else if esc == 110 {
        sb.write_byte((10).to_byte())
        p = p + 1
      } else if esc == 114 {
        sb.write_byte((13).to_byte())
        p = p + 1
      } else if esc == 116 {
        sb.write_byte((9).to_byte())
        p = p + 1
      } else if esc == 117 {
        // \uXXXX (with strict surrogate pair decoding)
        let u_pos = p - 1
        self.pos = p + 1
        let cp1 = self.parse_hex4()
        if cp1 < 0 {
          return ""
        }
        p = self.pos
        if is_high_surrogate(cp1) {
          // High surrogate: must be followed by \uDC00..\uDFFF
          if p + 6 > n || s.code_unit_at(p) != 92 || s.code_unit_at(p + 1) != 117 {
            self.set_err(u_pos, "unpaired high UTF-16 surrogate in string escape")
            return ""
          }
          self.pos = p + 2
          let cp2 = self.parse_hex4()
          if cp2 < 0 {
            return ""
          }
          p = self.pos
          if !is_low_surrogate(cp2) {
            self.set_err(u_pos, "invalid low UTF-16 surrogate in string escape")
            return ""
          }
          let full_cp = decode_surrogate_pair(cp1, cp2)
          write_utf8(sb, full_cp)
        } else if is_low_surrogate(cp1) {
          self.set_err(u_pos, "unpaired low UTF-16 surrogate in string escape")
          return ""
        } else {
          write_utf8(sb, cp1)
        }
      } else if allow_j5 {
        if esc == 39 {
          sb.write_byte((39).to_byte())
          p = p + 1
        } else if esc == 118 {
          sb.write_byte((11).to_byte())
          p = p + 1
        } else if esc == 48 {
          // \0: must NOT be followed by a decimal digit
          if p + 1 < n {
            let nb = s.code_unit_at(p + 1)
            if nb >= 48 && nb <= 57 {
              self.set_err(p, "octal escape sequence is not allowed in JSON5")
              return ""
            }
          }
          sb.write_byte((0).to_byte())
          p = p + 1
        } else if esc >= 49 && esc <= 57 {
          self.set_err(p, "numeric escape sequence is not allowed in JSON5")
          return ""
        } else if esc == 120 {
          // \xXX
          if p + 3 > n {
            self.set_err(p, "incomplete \\xXX escape")
            return ""
          }
          let h0 = hex_val(s.code_unit_at(p + 1))
          let h1 = hex_val(s.code_unit_at(p + 2))
          if (h0 | h1) >= 16 {
            self.set_err(p, "invalid hex digit in \\xXX escape")
            return ""
          }
          write_utf8(sb, pack_hex2(h0, h1))
          p = p + 3
        } else if esc == 10 {
          // Line continuation: \ + LF
          p = p + 1
        } else if esc == 13 {
          // Line continuation: \ + CR or \ + CRLF
          if p + 1 < n && s.code_unit_at(p + 1) == 10 {
            p = p + 2
          } else {
            p = p + 1
          }
        } else if esc == 0xE2 &&
        p + 2 < n &&
        s.code_unit_at(p + 1) == 0x80 &&
        (s.code_unit_at(p + 2) == 0xA8 || s.code_unit_at(p + 2) == 0xA9) {
          // Line continuation: \ + U+2028 or U+2029
          p = p + 3
        } else {
          // ES5 NonEscapeCharacter: literal character
          let (cp, clen) = decode_utf8_at(s, p)
          write_utf8(sb, cp)
          p = p + clen
        }
      } else {
        self.set_err(p, "invalid escape sequence in JSON/JSONC string")
        return ""
      }
      chunk_start = p
      continue
    }
    if b == 10 || b == 13 {
      self.set_err(p, "unescaped newline in string literal")
      return ""
    }
    if !allow_j5 && b < 0x20 {
      self.set_err(p, "unescaped control character in JSON string")
      return ""
    }
    p = p + 1
  }
  self.set_err(start_pos, "unterminated string literal")
  ""
}

///| Parse an unquoted ECMAScript 5.1 IdentifierName key (JSON5 only).
fn Parser::parse_identifier_key(self : Parser) -> String {
  let s = self.src
  let n = self.len
  let start = self.pos
  if start >= n {
    self.set_err(start, "unexpected EOF while parsing object key")
    return ""
  }

  let lut = ascii_lut
  // Fast path: pure ASCII identifier without \uXXXX escapes
  let b0 = s.code_unit_at(start)
  if b0 < 0x80 && (lut[b0].to_int() & 4) != 0 {
    let mut p = start + 1
    while p < n {
      let b = s.code_unit_at(p)
      if b < 0x80 {
        if (lut[b].to_int() & 8) != 0 {
          p = p + 1
          continue
        }
        if b != 92 {
          self.pos = p
          return s.slice(start, p)
        }
        break
      }
      break
    }
    if p >= n {
      self.pos = p
      return s.slice(start, p)
    }
  } else if b0 >= 0x80 {
    // Fast zero-copy path for unescaped non-ASCII Unicode identifiers
    let (cp0, clen0) = decode_utf8_at(s, start)
    if !is_es5_id_start(cp0) {
      self.set_err(start, "invalid unquoted object key")
      return ""
    }
    let mut p = start + clen0
    let mut hit_escape = false
    while p < n {
      let b = s.code_unit_at(p)
      if b < 0x80 {
        if b == 92 {
          hit_escape = true
          break
        }
        if (lut[b].to_int() & 8) != 0 {
          p = p + 1
        } else {
          break
        }
      } else {
        let (cp, clen) = decode_utf8_at(s, p)
        if is_es5_id_part(cp) {
          p = p + clen
        } else {
          break
        }
      }
    }
    if !hit_escape {
      self.pos = p
      return s.slice(start, p)
    }
  }

  // General path: Unicode characters and/or \uXXXX escapes
  let sb = StringBuilder::new()
  let mut p = start
  let mut first = true
  while p < n {
    let b = s.code_unit_at(p)
    if b == 92 {
      // Must be \uXXXX
      if p + 1 >= n || s.code_unit_at(p + 1) != 117 {
        self.set_err(p, "invalid escape in unquoted identifier key")
        return ""
      }
      self.pos = p + 2
      let cp = self.parse_hex4()
      if cp < 0 {
        return ""
      }
      p = self.pos
      let valid = if first { is_es5_id_start(cp) } else { is_es5_id_part(cp) }
      if !valid {
        self.set_err(start, "invalid Unicode escape in identifier key")
        return ""
      }
      write_utf8(sb, cp)
      first = false
    } else if b < 0x80 {
      let valid = if first { (lut[b].to_int() & 4) != 0 } else { (lut[b].to_int() & 8) != 0 }
      if !valid {
        break
      }
      sb.write_byte(b.to_byte())
      p = p + 1
      first = false
    } else {
      let (cp, clen) = decode_utf8_at(s, p)
      let valid = if first { is_es5_id_start(cp) } else { is_es5_id_part(cp) }
      if !valid {
        break
      }
      write_utf8(sb, cp)
      p = p + clen
      first = false
    }
  }
  if first {
    self.set_err(start, "invalid unquoted object key")
    return ""
  }
  self.pos = p
  sb.to_string()
}

///| Parse an object key (quoted string, or unquoted identifier in JSON5 mode).
fn Parser::parse_object_key(self : Parser) -> String {
  if self.pos >= self.len {
    self.set_err(self.pos, "unexpected EOF while expecting object key")
    return ""
  }
  let b = self.src.code_unit_at(self.pos)
  if b == 34 || b == 39 {
    self.parse_string()
  } else if self.opts.allow_json5 {
    self.parse_identifier_key()
  } else {
    self.set_err(self.pos, "object keys must be double-quoted strings in JSON/JSONC")
    ""
  }
}

///| Check if `self.src` at `pos` matches literal `lit`.
fn Parser::starts_with(self : Parser, pos : Int, lit : String) -> Bool {
  let m = lit.length()
  if pos + m > self.len {
    return false
  }
  let mut i = 0
  while i < m {
    if self.src.code_unit_at(pos + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Check if byte at `pos` is a valid token boundary after a keyword or number.
fn Parser::is_delim_at(self : Parser, pos : Int) -> Bool {
  if pos >= self.len {
    return true
  }
  let b = self.src.code_unit_at(pos)
  if b < 0x80 {
    b == 44 ||
    b == 93 ||
    b == 125 ||
    b == 58 ||
    b == 47 ||
    b == 32 ||
    b == 10 ||
    b == 13 ||
    b == 9 ||
    b == 11 ||
    b == 12
  } else if self.opts.allow_json5 {
    let (cp, _) = decode_utf8_at(self.src, pos)
    is_unicode_j5_ws(cp)
  } else {
    false
  }
}

///| Parse a JSON5 / JSON numeric literal (hex, Infinity, NaN, decimal int/float).
fn Parser::parse_number(self : Parser) -> Double {
  let s = self.src
  let n = self.len
  let allow_j5 = self.opts.allow_json5
  let start = self.pos
  let mut p = start
  let mut neg = false
  let mut has_plus = false

  let b0 = s.code_unit_at(p)
  if b0 == 45 {
    neg = true
    p = p + 1
  } else if b0 == 43 {
    if !allow_j5 {
      self.set_err(p, "explicit '+' sign is not allowed in JSON/JSONC")
      return 0.0
    }
    has_plus = true
    p = p + 1
  }
  if p >= n {
    self.set_err(start, "unexpected EOF in number")
    return 0.0
  }

  // Infinity / NaN (JSON5 only)
  let c = s.code_unit_at(p)
  if c == 73 && allow_j5 && self.starts_with(p, "Infinity") {
    let end = p + 8
    if !self.is_delim_at(end) {
      self.set_err(end, "unexpected trailing character after Infinity")
      return 0.0
    }
    self.pos = end
    return if neg { -1.0 / 0.0 } else { 1.0 / 0.0 }
  }
  if c == 78 && allow_j5 && self.starts_with(p, "NaN") {
    let end = p + 3
    if !self.is_delim_at(end) {
      self.set_err(end, "unexpected trailing character after NaN")
      return 0.0
    }
    self.pos = end
    return 0.0 / 0.0
  }

  // Hexadecimal integer 0x... / 0X... (JSON5 only)
  // Exact single-rounding IEEE-754 conversion (tracks top 60..63 significant bits + sticky bit).
  if c == 48 &&
  p + 1 < n &&
  (s.code_unit_at(p + 1) == 120 || s.code_unit_at(p + 1) == 88) {
    if !allow_j5 {
      self.set_err(start, "hexadecimal numbers are not allowed in JSON/JSONC")
      return 0.0
    }
    p = p + 2
    let hex_start = p
    let hlut = hex_lut
    let mut mant : UInt64 = 0UL
    let mut bits = 0
    let mut exp = 0
    let mut sticky = false
    while p < n {
      let hv = hlut[s.code_unit_at(p)].to_int()
      if hv >= 16 {
        break
      }
      if bits == 0 {
        if hv != 0 {
          mant = hv.to_int64().reinterpret_as_uint64()
          bits = hex_nibble_bits(hv)
        }
      } else if bits <= 59 {
        mant = (mant << 4UL) | hv.to_int64().reinterpret_as_uint64()
        bits = bits + 4
      } else {
        if exp < 10000 {
          exp = exp + 4
        }
        if hv != 0 {
          sticky = true
        }
      }
      p = p + 1
    }
    if p == hex_start {
      self.set_err(start, "expected hexadecimal digits after 0x")
      return 0.0
    }
    if !self.is_delim_at(p) {
      self.set_err(p, "unexpected character after hexadecimal number")
      return 0.0
    }
    let num_val = hex_mant_to_double(mant, bits, exp, sticky)
    if self.opts.reject_overflow && (num_val == 1.0 / 0.0 || num_val == -1.0 / 0.0) {
      self.set_err(start, "hexadecimal number overflow")
      return 0.0
    }
    self.pos = p
    if neg {
      return if num_val == 0.0 { -0.0 } else { -num_val }
    }
    return num_val
  }

  // Decimal number
  let num_start = p
  let mut has_int_digits = false
  let mut has_dot = false
  let mut has_frac_digits = false
  let mut has_exp = false
  let mut mant : UInt64 = 0UL
  let mut sig_digits = 0
  let mut exp_adj = 0
  let mut mant_overflow = false
  let mut exp_val = 0

  if c == 48 {
    has_int_digits = true
    p = p + 1
    if p < n {
      let nb = s.code_unit_at(p)
      if nb >= 48 && nb <= 57 {
        self.set_err(p, "leading zero is not allowed in number")
        return 0.0
      }
    }
  } else if c >= 48 && c <= 57 {
    has_int_digits = true
    while p < n {
      let d = s.code_unit_at(p)
      if d < 48 || d > 57 {
        break
      }
      let dig = d - 48
      if sig_digits < 19 {
        mant = mant * 10UL + dig.to_int64().reinterpret_as_uint64()
        sig_digits = sig_digits + 1
      } else if dig != 0 {
        mant_overflow = true
      } else if exp_adj < 100000 {
        exp_adj = exp_adj + 1
      }
      p = p + 1
    }
    // Immediate small-integer fast exit when followed directly by a common delimiter
    if !mant_overflow && sig_digits <= 15 {
      if p >= n {
        self.pos = p
        let iv = mant.reinterpret_as_int64()
        return if neg { (-iv).to_double() } else { iv.to_double() }
      }
      let nb = s.code_unit_at(p)
      if nb == 44 || nb == 10 || nb == 13 || nb == 32 || nb == 93 || nb == 125 || nb == 9 {
        self.pos = p
        let iv = mant.reinterpret_as_int64()
        return if neg { (-iv).to_double() } else { iv.to_double() }
      }
    }
  } else if c != 46 {
    self.set_err(p, "invalid number literal")
    return 0.0
  }

  // Fractional part
  if p < n && s.code_unit_at(p) == 46 {
    if !has_int_digits && !allow_j5 {
      self.set_err(p, "leading decimal point is not allowed in JSON/JSONC")
      return 0.0
    }
    has_dot = true
    p = p + 1
    while p < n {
      let d = s.code_unit_at(p)
      if d < 48 || d > 57 {
        break
      }
      has_frac_digits = true
      let dig = d - 48
      if sig_digits == 0 {
        if dig == 0 {
          if exp_adj > -100000 {
            exp_adj = exp_adj - 1
          }
        } else {
          mant = dig.to_int64().reinterpret_as_uint64()
          sig_digits = 1
          if exp_adj > -100000 {
            exp_adj = exp_adj - 1
          }
        }
      } else if sig_digits < 19 {
        mant = mant * 10UL + dig.to_int64().reinterpret_as_uint64()
        sig_digits = sig_digits + 1
        if exp_adj > -100000 {
          exp_adj = exp_adj - 1
        }
      } else if dig != 0 {
        mant_overflow = true
      }
      p = p + 1
    }
    if !has_int_digits && !has_frac_digits {
      self.set_err(start, "lone decimal point is not a valid number")
      return 0.0
    }
    if !has_frac_digits && !allow_j5 {
      self.set_err(p, "trailing decimal point is not allowed in JSON/JSONC")
      return 0.0
    }
  }

  // Exponent part
  if p < n && (s.code_unit_at(p) == 101 || s.code_unit_at(p) == 69) {
    has_exp = true
    p = p + 1
    let mut exp_neg = false
    if p < n {
      let eb = s.code_unit_at(p)
      if eb == 45 {
        exp_neg = true
        p = p + 1
      } else if eb == 43 {
        p = p + 1
      }
    }
    let exp_start = p
    let mut exp_abs = 0
    while p < n {
      let d = s.code_unit_at(p)
      if d < 48 || d > 57 {
        break
      }
      if exp_abs < 100000 {
        exp_abs = exp_abs * 10 + (d - 48)
      }
      p = p + 1
    }
    if p == exp_start {
      self.set_err(p, "expected exponent digits")
      return 0.0
    }
    exp_val = if exp_neg { -exp_abs } else { exp_abs }
  }

  if !self.is_delim_at(p) {
    self.set_err(p, "unexpected trailing character in number")
    return 0.0
  }
  self.pos = p

  // Fast path 1: exact small integer (no dot, no exp, <= 15 digits)
  if !has_dot && !has_exp && !mant_overflow && sig_digits <= 15 {
    let iv = mant.reinterpret_as_int64()
    if neg {
      if iv == 0L {
        return -0.0
      }
      return (-iv).to_double()
    }
    return iv.to_double()
  }

  // Fast path 2: exact zero
  if !mant_overflow && mant == 0UL {
    return if neg { -0.0 } else { 0.0 }
  }

  // Fast path 3: Clinger + Eisel-Lemire 128-bit single-rounding float parser (<= 19 sig digits)
  if !mant_overflow {
    let q = exp_val + exp_adj
    let v = eisel_lemire_or_clinger_f64(mant, q)
    if v == v {
      if self.opts.reject_overflow && (v == 1.0 / 0.0 || v == -1.0 / 0.0) {
        self.set_err(start, "floating-point number overflow")
        return 0.0
      }
      if neg {
        return if v == 0.0 { -0.0 } else { -v }
      }
      return v
    }
  }

  // General float path: normalize JSON5 leading '+' / leading '.' / trailing '.' for to_double()
  let needs_norm = has_plus || !has_int_digits || (has_dot && !has_frac_digits)
  let raw = if !needs_norm {
    s.slice(start, p)
  } else {
    let sb = StringBuilder::new()
    if neg {
      sb.write_byte((45).to_byte())
    }
    if !has_int_digits {
      sb.write_byte((48).to_byte())
    }
    // Copy body, inserting '0' after '.' if trailing decimal point before 'e'/'E' or end
    let mut k = num_start
    while k < p {
      let ch = s.code_unit_at(k)
      sb.write_byte(ch.to_byte())
      if ch == 46 && !has_frac_digits {
        sb.write_byte((48).to_byte())
      }
      k = k + 1
    }
    sb.to_string()
  }

  match raw.to_double() {
    Some(v) => {
      if self.opts.reject_overflow && (v == 1.0 / 0.0 || v == -1.0 / 0.0) {
        self.set_err(start, "floating-point number overflow")
        return 0.0
      }
      if neg && v == 0.0 {
        return -0.0
      }
      v
    }
    None => {
      self.set_err(start, "invalid floating-point number")
      0.0
    }
  }
}

///| Insert `(key, val)` into a `ParseFrame` honoring `DuplicateKeyPolicy`.
///| Returns `false` if rejected by `DuplicateKeyPolicy::Reject`.
fn insert_obj_entry(
  frame : ParseFrame,
  key : String,
  value : Json5Value,
  policy : DuplicateKeyPolicy,
  seed : UInt64,
) -> Bool {
  let entries = frame.entries
  let n = entries.length()

  // Upgrade to seeded HashIndex once object grows to 16 keys (defeats O(N^2) / HashDoS)
  if n >= 16 {
    let hi = match frame.index {
      Some(existing) => existing
      None => {
        let idx = HashIndex::new(32, seed)
        let mut i = 0
        while i < n {
          let (k, _) = entries[i]
          idx.insert(k, i, -1)
          i = i + 1
        }
        frame.index = Some(idx)
        idx
      }
    }
    let existing_pos = hi.get_entry(key)
    if existing_pos >= 0 {
      match policy {
        DuplicateKeyPolicy::LastWins => {
          entries[existing_pos] = (key, value)
          return true
        }
        DuplicateKeyPolicy::FirstWins => return true
        DuplicateKeyPolicy::Reject => return false
      }
    }
    hi.insert(key, n, -1)
    entries.push((key, value))
    return true
  }

  // Linear scan for small objects (< 16 keys, zero HashIndex allocation)
  let mut i = 0
  while i < n {
    let (k, _) = entries[i]
    if k == key {
      match policy {
        DuplicateKeyPolicy::LastWins => {
          entries[i] = (key, value)
          return true
        }
        DuplicateKeyPolicy::FirstWins => return true
        DuplicateKeyPolicy::Reject => return false
      }
    }
    i = i + 1
  }
  entries.push((key, value))
  true
}

///| Parse a validated UTF-8 `String` iteratively into a `Json5Value`.
fn parse_validated(
  src : String,
  opts : ParseOptions,
) -> Result[Json5Value, Json5Error] {
  let p = Parser::new(src, opts)
  let s = p.src
  let n = p.len
  let max_nodes = opts.max_nodes
  let max_depth = opts.max_depth
  let stack : Array[ParseFrame] = Array::with_capacity(16)
  let empty_arr : Array[Json5Value] = []
  let empty_entries : Array[(String, Json5Value)] = []

  // Iterative parse loop: each iteration parses one value (or opens a container),
  // then runs the deliver loop when a value completes.
  while true {
    p.skip_ws()
    if p.has_err {
      return Err(p.to_err())
    }
    if p.pos >= n {
      return Err(p.err(p.pos, "unexpected EOF while expecting value"))
    }

    let val_start = p.pos
    let b = s.code_unit_at(val_start)
    let mut cur : Json5Value = Json5Value::Null

    if b == 34 || b == 39 {
      p.nodes = p.nodes + 1
      if p.nodes > max_nodes {
        return Err(p.err(val_start, "maximum node count exceeded"))
      }
      let str_val = p.parse_string()
      if p.has_err {
        return Err(p.to_err())
      }
      cur = Json5Value::Str(str_val)
    } else if b == 123 {
      // '{' Object
      p.nodes = p.nodes + 1
      if p.nodes > max_nodes {
        return Err(p.err(val_start, "maximum node count exceeded"))
      }
      if stack.length() >= max_depth {
        return Err(p.err(val_start, "maximum nesting depth exceeded"))
      }
      p.pos = val_start + 1
      p.skip_ws()
      if p.has_err {
        return Err(p.to_err())
      }
      if p.pos < n && s.code_unit_at(p.pos) == 125 {
        p.pos = p.pos + 1
        cur = Json5Value::Object([])
      } else {
        let key = p.parse_object_key()
        if p.has_err {
          return Err(p.to_err())
        }
        p.skip_ws()
        if p.has_err {
          return Err(p.to_err())
        }
        if p.pos >= n || s.code_unit_at(p.pos) != 58 {
          return Err(p.err(p.pos, "expected ':' after object key"))
        }
        p.pos = p.pos + 1
        stack.push(
          ParseFrame::{
            is_obj: true,
            arr: empty_arr,
            entries: Array::with_capacity(8),
            index: None,
            pending_key: key,
          },
        )
        continue
      }
    } else if b == 91 {
      // '[' Array
      p.nodes = p.nodes + 1
      if p.nodes > max_nodes {
        return Err(p.err(val_start, "maximum node count exceeded"))
      }
      if stack.length() >= max_depth {
        return Err(p.err(val_start, "maximum nesting depth exceeded"))
      }
      p.pos = val_start + 1
      p.skip_ws()
      if p.has_err {
        return Err(p.to_err())
      }
      if p.pos < n && s.code_unit_at(p.pos) == 93 {
        p.pos = p.pos + 1
        cur = Json5Value::Array([])
      } else {
        stack.push(
          ParseFrame::{
            is_obj: false,
            arr: Array::with_capacity(4),
            entries: empty_entries,
            index: None,
            pending_key: "",
          },
        )
        continue
      }
    } else if (b >= 48 && b <= 57) ||
    b == 45 ||
    b == 43 ||
    b == 46 ||
    b == 73 ||
    b == 78 {
      p.nodes = p.nodes + 1
      if p.nodes > max_nodes {
        return Err(p.err(val_start, "maximum node count exceeded"))
      }
      let num = p.parse_number()
      if p.has_err {
        return Err(p.to_err())
      }
      cur = Json5Value::Number(num)
    } else if b == 116 &&
    val_start + 4 <= n &&
    s.code_unit_at(val_start + 1) == 114 &&
    s.code_unit_at(val_start + 2) == 117 &&
    s.code_unit_at(val_start + 3) == 101 &&
    p.is_delim_at(val_start + 4) {
      p.nodes = p.nodes + 1
      if p.nodes > max_nodes {
        return Err(p.err(val_start, "maximum node count exceeded"))
      }
      p.pos = val_start + 4
      cur = Json5Value::Bool(true)
    } else if b == 102 &&
    val_start + 5 <= n &&
    s.code_unit_at(val_start + 1) == 97 &&
    s.code_unit_at(val_start + 2) == 108 &&
    s.code_unit_at(val_start + 3) == 115 &&
    s.code_unit_at(val_start + 4) == 101 &&
    p.is_delim_at(val_start + 5) {
      p.nodes = p.nodes + 1
      if p.nodes > max_nodes {
        return Err(p.err(val_start, "maximum node count exceeded"))
      }
      p.pos = val_start + 5
      cur = Json5Value::Bool(false)
    } else if b == 110 &&
    val_start + 4 <= n &&
    s.code_unit_at(val_start + 1) == 117 &&
    s.code_unit_at(val_start + 2) == 108 &&
    s.code_unit_at(val_start + 3) == 108 &&
    p.is_delim_at(val_start + 4) {
      p.nodes = p.nodes + 1
      if p.nodes > max_nodes {
        return Err(p.err(val_start, "maximum node count exceeded"))
      }
      p.pos = val_start + 4
      cur = Json5Value::Null
    } else {
      return Err(p.err(val_start, "unexpected character while parsing value"))
    }

    // Deliver completed value up the explicit container stack
    while true {
      if stack.length() == 0 {
        p.skip_ws()
        if p.has_err {
          return Err(p.to_err())
        }
        if p.pos != n {
          return Err(p.err(p.pos, "unexpected trailing content after value"))
        }
        return Ok(cur)
      }
      let frame = stack[stack.length() - 1]
      if !frame.is_obj {
        let items = frame.arr
        items.push(cur)
        p.skip_ws()
        if p.has_err {
          return Err(p.to_err())
        }
        if p.pos >= n {
          return Err(p.err(p.pos, "unterminated array"))
        }
        let sep = s.code_unit_at(p.pos)
        if sep == 44 {
          p.pos = p.pos + 1
          p.skip_ws()
          if p.has_err {
            return Err(p.to_err())
          }
          if p.pos < n && s.code_unit_at(p.pos) == 93 {
            if !opts.allow_trailing_commas {
              return Err(p.err(p.pos, "trailing comma is not allowed in strict JSON"))
            }
            p.pos = p.pos + 1
            let _ = stack.pop()
            cur = Json5Value::Array(items)
            continue
          }
          // Parse next array element
          break
        } else if sep == 93 {
          p.pos = p.pos + 1
          let _ = stack.pop()
          cur = Json5Value::Array(items)
          continue
        } else {
          return Err(p.err(p.pos, "expected ',' or ']' in array"))
        }
      } else {
        let key = frame.pending_key
        if frame.entries.length() == 0 {
          frame.entries.push((key, cur))
        } else if !insert_obj_entry(frame, key, cur, opts.duplicate_keys, p.seed) {
          return Err(p.err(p.pos, "duplicate object key: " + key))
        }
        p.skip_ws()
        if p.has_err {
          return Err(p.to_err())
        }
        if p.pos >= n {
          return Err(p.err(p.pos, "unterminated object"))
        }
        let sep = s.code_unit_at(p.pos)
        if sep == 44 {
          p.pos = p.pos + 1
          p.skip_ws()
          if p.has_err {
            return Err(p.to_err())
          }
          if p.pos < n && s.code_unit_at(p.pos) == 125 {
            if !opts.allow_trailing_commas {
              return Err(p.err(p.pos, "trailing comma is not allowed in strict JSON"))
            }
            p.pos = p.pos + 1
            let _ = stack.pop()
            cur = Json5Value::Object(frame.entries)
            continue
          }
          let next_key = p.parse_object_key()
          if p.has_err {
            return Err(p.to_err())
          }
          p.skip_ws()
          if p.has_err {
            return Err(p.to_err())
          }
          if p.pos >= n || s.code_unit_at(p.pos) != 58 {
            return Err(p.err(p.pos, "expected ':' after object key"))
          }
          p.pos = p.pos + 1
          frame.pending_key = next_key
          break
        } else if sep == 125 {
          p.pos = p.pos + 1
          let _ = stack.pop()
          cur = Json5Value::Object(frame.entries)
          continue
        } else {
          return Err(p.err(p.pos, "expected ',' or '}' in object"))
        }
      }
    }
  }
  Err(p.err(p.pos, "unreachable"))
}
