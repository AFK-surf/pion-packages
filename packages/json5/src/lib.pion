///| Pure Pion JSON5 v2.0 + JSONC + RFC 6901 JSON Pointer + RFC 6902 JSON Patch.
///| Commit 1 (Red) public API stubs.

///| Parse a JSON5 v2.0 document from a UTF-8 `String`.
pub fn parse(src : String) -> Result[Json5Value, Json5Error] {
  let _ = src
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Parse a JSON5 / JSONC / JSON document with explicit options.
pub fn parse_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Json5Value, Json5Error] {
  let _ = (src, opts)
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Parse a JSON5 v2.0 document from raw `Bytes` (strict UTF-8 validation).
pub fn parse_bytes(src : Bytes) -> Result[Json5Value, Json5Error] {
  let _ = src
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Parse raw `Bytes` with explicit options (strict UTF-8 validation).
pub fn parse_bytes_with_options(
  src : Bytes,
  opts : ParseOptions,
) -> Result[Json5Value, Json5Error] {
  let _ = (src, opts)
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Parse a JSONC document (standard JSON + comments + trailing commas).
pub fn parse_jsonc(src : String) -> Result[Json5Value, Json5Error] {
  parse_with_options(src, ParseOptions::jsonc())
}

///| Serialize a `Json5Value` to compact standard RFC 8259 JSON.
///| Returns `Err` if the tree contains non-finite numbers (`NaN`, `Infinity`, `-Infinity`).
pub fn to_json_string(value : Json5Value) -> Result[String, Json5Error] {
  let _ = value
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Serialize a `Json5Value` to pretty-printed standard RFC 8259 JSON.
pub fn to_json_string_pretty(
  value : Json5Value,
  indent : Int,
) -> Result[String, Json5Error] {
  let _ = (value, indent)
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Serialize a `Json5Value` to compact JSON5 v2.0.
pub fn to_json5_string(value : Json5Value) -> String {
  let _ = value
  ""
}

///| Serialize a `Json5Value` to pretty-printed JSON5 v2.0.
pub fn to_json5_string_pretty(value : Json5Value, indent : Int) -> String {
  let _ = (value, indent)
  ""
}

///| Structural JSON equality (order-independent for objects).
pub fn value_eq(a : Json5Value, b : Json5Value) -> Bool {
  let _ = (a, b)
  false
}

///| Look up a key in a `Json5Value::Object`.
pub fn get(value : Json5Value, key : String) -> Option[Json5Value] {
  let _ = (value, key)
  None
}

///| Look up an element by index in a `Json5Value::Array`.
pub fn get_index(value : Json5Value, index : Int) -> Option[Json5Value] {
  let _ = (value, index)
  None
}

///| Check whether this value is `Json5Value::Null`.
pub fn is_null(value : Json5Value) -> Bool {
  let _ = value
  false
}

///| Extract a `Bool` if this value is `Json5Value::Bool`.
pub fn as_bool(value : Json5Value) -> Option[Bool] {
  let _ = value
  None
}

///| Extract a `Double` if this value is `Json5Value::Number`.
pub fn as_number(value : Json5Value) -> Option[Double] {
  let _ = value
  None
}

///| Extract an exact `Int64` if this value is an integer `Json5Value::Number`.
pub fn as_int(value : Json5Value) -> Option[Int64] {
  let _ = value
  None
}

///| Extract a `String` if this value is `Json5Value::Str`.
pub fn as_str(value : Json5Value) -> Option[String] {
  let _ = value
  None
}

///| Extract the elements if this value is `Json5Value::Array`.
pub fn as_array(value : Json5Value) -> Option[Array[Json5Value]] {
  let _ = value
  None
}

///| Extract the entries if this value is `Json5Value::Object`.
pub fn as_object(value : Json5Value) -> Option[Array[(String, Json5Value)]] {
  let _ = value
  None
}

///| Return the length of an array, object, or string, or 0 for other values.
pub fn value_len(value : Json5Value) -> Int {
  let _ = value
  0
}

///| Return whether an array, object, or string is empty.
pub fn is_empty(value : Json5Value) -> Bool {
  let _ = value
  true
}

///| Parse an RFC 6901 JSON Pointer string.
pub fn JsonPointer::parse(ptr : String) -> Result[JsonPointer, Json5Error] {
  let _ = ptr
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Format an RFC 6901 JSON Pointer back to its escaped string form.
pub fn JsonPointer::to_string(self : JsonPointer) -> String {
  let _ = self
  ""
}

///| Escape a single RFC 6901 reference token (`~` -> `~0`, `/` -> `~1`).
pub fn pointer_escape(token : String) -> String {
  let _ = token
  ""
}

///| Unescape a single RFC 6901 reference token (`~1` -> `/`, `~0` -> `~`).
pub fn pointer_unescape(token : String) -> Result[String, Json5Error] {
  let _ = token
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Resolve an RFC 6901 JSON Pointer string against a `Json5Value`.
pub fn pointer_get(
  doc : Json5Value,
  ptr : String,
) -> Result[Option[Json5Value], Json5Error] {
  let _ = (doc, ptr)
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Resolve a pre-parsed `JsonPointer` against a `Json5Value`.
pub fn pointer_get_parsed(
  doc : Json5Value,
  ptr : JsonPointer,
) -> Option[Json5Value] {
  let _ = (doc, ptr)
  None
}

///| Parse an RFC 6902 JSON Patch document from JSON/JSON5 text.
pub fn parse_patch(src : String) -> Result[Patch, Json5Error] {
  let _ = src
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Decode an RFC 6902 `Patch` from a parsed `Json5Value`.
pub fn patch_from_value(value : Json5Value) -> Result[Patch, Json5Error] {
  let _ = value
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Encode a `Patch` as a `Json5Value::Array`.
pub fn patch_to_value(patch : Patch) -> Json5Value {
  let _ = patch
  Json5Value::Array([])
}

///| Apply an RFC 6902 `Patch` atomically to `doc`.
///| On any error, `doc` is not modified and `Err` is returned.
pub fn apply_patch(
  doc : Json5Value,
  patch : Patch,
) -> Result[Json5Value, Json5Error] {
  let _ = (doc, patch)
  Err(Json5Error::new(1, 1, 0, "not implemented"))
}

///| Compute an RFC 6902 `Patch` transforming `a` into `b`.
pub fn diff(a : Json5Value, b : Json5Value) -> Patch {
  let _ = (a, b)
  Patch::{ ops: [] }
}
