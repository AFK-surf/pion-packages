///| 256-byte ASCII lookup tables and ECMAScript 5.1 Unicode identifier / whitespace classifiers.

///| Bitmask flags in `ascii_lut`:
///|   1  = JSON5 ASCII whitespace (\t, \n, \v, \f, \r, ' ')
///|   2  = Strict JSON ASCII whitespace (\t, \n, \r, ' ')
///|   4  = ASCII IdentifierStart (A-Z, a-z, _, $)
///|   8  = ASCII IdentifierPart  (A-Z, a-z, 0-9, _, $)
///|  16  = Decimal digit (0-9)
///|  32  = Double-quote string stop (", \, \n, \r, < 0x20)
///|  64  = Single-quote string stop (', \, \n, \r, < 0x20)
let ascii_lut : FixedArray[Byte] = build_ascii_lut()

fn build_ascii_lut() -> FixedArray[Byte] {
  let lut = FixedArray::make(256, (0).to_byte())
  let mut i = 0
  while i < 256 {
    let mut flags = 0
    if i == 9 || i == 10 || i == 11 || i == 12 || i == 13 || i == 32 {
      flags = flags | 1
    }
    if i == 9 || i == 10 || i == 13 || i == 32 {
      flags = flags | 2
    }
    if (i >= 65 && i <= 90) || (i >= 97 && i <= 122) || i == 95 || i == 36 {
      flags = flags | 4 | 8
    }
    if i >= 48 && i <= 57 {
      flags = flags | 8 | 16
    }
    if i < 32 || i == 34 || i == 92 {
      flags = flags | 32
    }
    if i < 32 || i == 39 || i == 92 {
      flags = flags | 64
    }
    lut[i] = flags.to_byte()
    i = i + 1
  }
  lut
}

///| Hex nibble lookup table: 0..15 for valid hex ASCII, 255 otherwise.
let hex_lut : FixedArray[Byte] = build_hex_lut()

fn build_hex_lut() -> FixedArray[Byte] {
  let lut = FixedArray::make(256, (255).to_byte())
  let mut i = 0
  while i < 10 {
    lut[48 + i] = i.to_byte()
    i = i + 1
  }
  let mut j = 0
  while j < 6 {
    lut[65 + j] = (10 + j).to_byte()
    lut[97 + j] = (10 + j).to_byte()
    j = j + 1
  }
  lut
}

fn is_ascii_j5_ws(b : Int) -> Bool {
  (ascii_lut[b].to_int() & 1) != 0
}

fn is_ascii_json_ws(b : Int) -> Bool {
  (ascii_lut[b].to_int() & 2) != 0
}

fn is_ascii_id_start(b : Int) -> Bool {
  (ascii_lut[b].to_int() & 4) != 0
}

fn is_ascii_id_part(b : Int) -> Bool {
  (ascii_lut[b].to_int() & 8) != 0
}

fn is_ascii_digit(b : Int) -> Bool {
  (ascii_lut[b].to_int() & 16) != 0
}

fn hex_val(b : Int) -> Int {
  hex_lut[b].to_int()
}

///| Check if a non-ASCII Unicode code point is a JSON5 whitespace / line terminator
///| (U+00A0, U+1680, U+2000..U+200A, U+2028, U+2029, U+202F, U+205F, U+3000, U+FEFF).
fn is_unicode_j5_ws(cp : Int) -> Bool {
  cp == 0x00A0 ||
  cp == 0xFEFF ||
  cp == 0x2028 ||
  cp == 0x2029 ||
  cp == 0x1680 ||
  (cp >= 0x2000 && cp <= 0x200A) ||
  cp == 0x202F ||
  cp == 0x205F ||
  cp == 0x3000
}

///| Check if a Unicode code point is a valid ECMAScript 5.1 IdentifierStart.
fn is_es5_id_start(cp : Int) -> Bool {
  if cp < 0x80 {
    return is_ascii_id_start(cp)
  }
  if is_unicode_j5_ws(cp) {
    return false
  }
  // Latin-1 Supplement letters (excluding × 0xD7 and ÷ 0xF7)
  if (cp >= 0x00C0 && cp <= 0x00D6) ||
  (cp >= 0x00D8 && cp <= 0x00F6) ||
  (cp >= 0x00F8 && cp <= 0x02FF) ||
  cp == 0x00AA ||
  cp == 0x00B5 ||
  cp == 0x00BA {
    return true
  }
  // Greek, Cyrillic, Armenian, Hebrew, Arabic, Devanagari, etc.
  if (cp >= 0x0370 && cp <= 0x037D) ||
  (cp >= 0x037F && cp <= 0x1FFF) ||
  (cp >= 0x2100 && cp <= 0x218F) ||
  (cp >= 0x2C00 && cp <= 0x2FEF) ||
  (cp >= 0x3005 && cp <= 0x3007) ||
  (cp >= 0x3021 && cp <= 0x3029) ||
  (cp >= 0x3031 && cp <= 0x3035) ||
  (cp >= 0x3038 && cp <= 0x303C) ||
  (cp >= 0x3041 && cp <= 0x9FFF) ||
  (cp >= 0xA000 && cp <= 0xD7AF) ||
  (cp >= 0xF900 && cp <= 0xFDCF) ||
  (cp >= 0xFDF0 && cp <= 0xFFFD) ||
  (cp >= 0x10000 && cp <= 0x2FFFF) {
    return true
  }
  false
}

///| Check if a Unicode code point is a valid ECMAScript 5.1 IdentifierPart.
fn is_es5_id_part(cp : Int) -> Bool {
  if cp < 0x80 {
    return is_ascii_id_part(cp)
  }
  if is_es5_id_start(cp) {
    return true
  }
  // Combining marks, connector punctuation, ZWNJ/ZWJ
  cp == 0x200C ||
  cp == 0x200D ||
  cp == 0x00B7 ||
  (cp >= 0x0300 && cp <= 0x036F) ||
  cp == 0x203F ||
  cp == 0x2040 ||
  (cp >= 0xFE20 && cp <= 0xFE2F) ||
  cp == 0xFE33 ||
  cp == 0xFE34 ||
  (cp >= 0xFE4D && cp <= 0xFE4F) ||
  cp == 0xFF3F
}

///| Check whether a string is a valid ASCII ES5 IdentifierName (safe to emit unquoted in JSON5).
fn is_simple_ascii_identifier(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  if !is_ascii_id_start(s.code_unit_at(0)) {
    return false
  }
  let mut i = 1
  while i < n {
    if !is_ascii_id_part(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}
