///| Core types, options, pointer/patch types, and accessors for `json5`.

///| Error returned when parsing, serializing, querying, or patching fails.
pub struct Json5Error {
  pub line : Int
  pub col : Int
  pub offset : Int
  pub message : String
}

///| Construct a `Json5Error`.
pub fn Json5Error::new(
  line : Int,
  col : Int,
  offset : Int,
  message : String,
) -> Json5Error {
  Json5Error::{ line: line, col: col, offset: offset, message: message }
}

///| Immutable JSON5 / JSON value tree.
///| Objects preserve key insertion order for deterministic serialization.
pub enum Json5Value {
  Null
  Bool(Bool)
  Number(Double)
  Str(String)
  Array(Array[Json5Value])
  Object(Array[(String, Json5Value)])
}

///| Policy for duplicate keys within a single object.
pub enum DuplicateKeyPolicy {
  LastWins
  FirstWins
  Reject
}

///| Configurable parser options and resource limits.
pub struct ParseOptions {
  pub max_depth : Int
  pub max_nodes : Int
  pub duplicate_keys : DuplicateKeyPolicy
  pub allow_json5 : Bool
  pub allow_comments : Bool
  pub allow_trailing_commas : Bool
  pub reject_overflow : Bool
}

///| Default JSON5 v2.0 parser options.
///| Matches ECMAScript 5.1 / JSON5 v2.0 semantics (`reject_overflow: false` -> ±Infinity).
pub fn ParseOptions::default() -> ParseOptions {
  ParseOptions::{
    max_depth: 128,
    max_nodes: 1000000,
    duplicate_keys: DuplicateKeyPolicy::LastWins,
    allow_json5: true,
    allow_comments: true,
    allow_trailing_commas: true,
    reject_overflow: false,
  }
}

///| JSONC parser options (standard JSON + comments + trailing commas).
pub fn ParseOptions::jsonc() -> ParseOptions {
  ParseOptions::{
    max_depth: 128,
    max_nodes: 1000000,
    duplicate_keys: DuplicateKeyPolicy::LastWins,
    allow_json5: false,
    allow_comments: true,
    allow_trailing_commas: true,
    reject_overflow: true,
  }
}

///| Strict RFC 8259 JSON parser options.
pub fn ParseOptions::strict_json() -> ParseOptions {
  ParseOptions::{
    max_depth: 128,
    max_nodes: 1000000,
    duplicate_keys: DuplicateKeyPolicy::LastWins,
    allow_json5: false,
    allow_comments: false,
    allow_trailing_commas: false,
    reject_overflow: true,
  }
}

///| Parsed RFC 6901 JSON Pointer.
pub struct JsonPointer {
  pub tokens : Array[String]
}

///| Single RFC 6902 JSON Patch operation.
pub enum PatchOp {
  Add(String, Json5Value)
  Remove(String)
  Replace(String, Json5Value)
  Move(String, String)
  Copy(String, String)
  Test(String, Json5Value)
}

///| Ordered list of RFC 6902 JSON Patch operations.
pub struct Patch {
  pub ops : Array[PatchOp]
}

///| Configurable resource limits for `apply_patch_with_options`.
pub struct PatchOptions {
  pub max_depth : Int
  pub max_nodes : Int
}

///| Default RFC 6902 patch options (`max_depth: 512`, `max_nodes: 1_000_000`).
pub fn PatchOptions::default() -> PatchOptions {
  PatchOptions::{ max_depth: 512, max_nodes: 1000000 }
}

///| Pre-built seeded hash index over a `Json5Value::Object` for O(1) repeated lookups.
pub struct ObjectIndex {
  entries : Array[(String, Json5Value)]
  index : HashIndex
}
