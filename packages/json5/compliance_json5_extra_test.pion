///| Additional JSON5 v2.0, JSONC, strict UTF-8, serialization, and float roundtrip tests.

fn assert_opt_str(opt : Option[String], expected : String, msg : String) -> Unit {
  match opt {
    Some(s) => debug_assert(s == expected, msg)
    None => debug_assert(false, msg + " (got None)")
  }
}

fn assert_opt_int(opt : Option[Int64], expected : Int64, msg : String) -> Unit {
  match opt {
    Some(n) => debug_assert(n == expected, msg)
    None => debug_assert(false, msg + " (got None)")
  }
}

fn assert_opt_bool(opt : Option[Bool], expected : Bool, msg : String) -> Unit {
  match opt {
    Some(b) => debug_assert(b == expected, msg)
    None => debug_assert(false, msg + " (got None)")
  }
}

fn assert_opt_num(opt : Option[Double], expected : Double, msg : String) -> Unit {
  match opt {
    Some(x) => debug_assert(x == expected, msg)
    None => debug_assert(false, msg + " (got None)")
  }
}

///|
test "json5_line_continuations_all_terminators" {
  let s_lf = "'hello\\\nworld'"
  let s_crlf = "'hello\\\r\nworld'"
  let s_cr = "'hello\\\rworld'"
  let s_ls = test_str_from_hex("2768656c6c6f5ce280a8776f726c6427")
  let s_ps = test_str_from_hex("2768656c6c6f5ce280a9776f726c6427")
  assert_json5_valid("cont_lf", s_lf, Json5Value::Str("helloworld"))
  assert_json5_valid("cont_crlf", s_crlf, Json5Value::Str("helloworld"))
  assert_json5_valid("cont_cr", s_cr, Json5Value::Str("helloworld"))
  assert_json5_valid("cont_ls", s_ls, Json5Value::Str("helloworld"))
  assert_json5_valid("cont_ps", s_ps, Json5Value::Str("helloworld"))
}

///|
test "json5_string_escapes_and_surrogate_pairs" {
  let src = "{ a: '\\b\\f\\n\\r\\t\\v\\0', b: '\\x41\\x7a', c: '\\u0041\\u03A3', emoji: '\\uD83D\\uDE00', nonesc: '\\a\\q' }"
  let v = match parse(src) {
    Ok(x) => x
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      return
    }
  }
  match get(v, "b") {
    Some(x) => assert_opt_str(as_str(x), "Az", "hex escape")
    None => debug_assert(false, "missing b")
  }
  match get(v, "c") {
    Some(x) => assert_opt_str(as_str(x), "AΣ", "unicode escape")
    None => debug_assert(false, "missing c")
  }
  match get(v, "emoji") {
    Some(x) => assert_opt_str(as_str(x), "😀", "surrogate pair")
    None => debug_assert(false, "missing emoji")
  }
  match get(v, "nonesc") {
    Some(x) => assert_opt_str(as_str(x), "aq", "non-escape")
    None => debug_assert(false, "missing nonesc")
  }
  assert_json5_invalid("null_escape_followed_by_digit", "'\\01'")
}

///|
test "json5_hex_and_special_numbers" {
  assert_json5_valid("hex_deadbeef", "0xDEADBEEF", Json5Value::Number(3735928559.0))
  assert_json5_valid("hex_neg", "-0x10", Json5Value::Number(-16.0))
  assert_json5_valid("hex_pos", "+0Xff", Json5Value::Number(255.0))
  assert_json5_valid("lead_dot", ".5", Json5Value::Number(0.5))
  assert_json5_valid("trail_dot", "5.", Json5Value::Number(5.0))
  assert_json5_valid("explicit_plus", "+1", Json5Value::Number(1.0))
  assert_json5_valid("inf", "Infinity", Json5Value::Number(1.0 / 0.0))
  assert_json5_valid("ninf", "-Infinity", Json5Value::Number(-1.0 / 0.0))
  assert_json5_valid("pinf", "+Infinity", Json5Value::Number(1.0 / 0.0))
  match parse("NaN") {
    Ok(v) => debug_assert(test_check_nan(v), "NaN")
    Err(e) => debug_assert(false, "NaN failed: " + e.message)
  }
  match parse("-NaN") {
    Ok(v) => debug_assert(test_check_nan(v), "-NaN")
    Err(e) => debug_assert(false, "-NaN failed: " + e.message)
  }
  match parse("+NaN") {
    Ok(v) => debug_assert(test_check_nan(v), "+NaN")
    Err(e) => debug_assert(false, "+NaN failed: " + e.message)
  }
}

///|
test "json5_unicode_whitespace_and_bom" {
  let src = test_str_from_hex("efbbbfc2a0e38080e280a83432")
  assert_json5_valid("bom_and_zs_ws", src, Json5Value::Number(42.0))
}

///|
test "jsonc_mode_allows_comments_and_trailing_commas_only" {
  let valid_jsonc = "{\n  // line comment\n  \"a\": [1, 2, /* block */],\n  \"b\": true,\n}"
  match parse_jsonc(valid_jsonc) {
    Ok(v) => {
      match get(v, "b") {
        Some(b) => assert_opt_bool(as_bool(b), true, "jsonc b")
        None => debug_assert(false, "jsonc missing b")
      }
    }
    Err(e) => debug_assert(false, "jsonc valid failed: " + e.message)
  }
  let invalid_cases = [
    "{ unquoted: 1 }",
    "{ \"a\": 'single' }",
    "{ \"a\": 0x10 }",
    "{ \"a\": .5 }",
    "{ \"a\": 5. }",
    "{ \"a\": +1 }",
    "{ \"a\": Infinity }",
    "{ \"a\": NaN }",
  ]
  let mut i = 0
  while i < invalid_cases.length() {
    match parse_jsonc(invalid_cases[i]) {
      Ok(_) => debug_assert(false, "jsonc should reject: " + invalid_cases[i])
      Err(_) => ()
    }
    i = i + 1
  }
}

///|
test "strict_json_mode_rejects_comments_and_trailing_commas" {
  let opts = ParseOptions::strict_json()
  match parse_with_options("{\"a\":1}", opts) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "strict json valid failed: " + e.message)
  }
  match parse_with_options("{\"a\":1,}", opts) {
    Ok(_) => debug_assert(false, "strict json should reject trailing comma")
    Err(_) => ()
  }
  match parse_with_options("// comment\n{\"a\":1}", opts) {
    Ok(_) => debug_assert(false, "strict json should reject comment")
    Err(_) => ()
  }
}

fn test_bytes_from_ints(arr : Array[Int]) -> Bytes {
  let b = Bytes::new(arr.length())
  let mut i = 0
  while i < arr.length() {
    b[i] = arr[i].to_byte()
    i = i + 1
  }
  b
}

///|
test "parse_bytes_strict_utf8" {
  let ok_bytes = test_bytes_from_ints([123, 97, 58, 49, 125])
  match parse_bytes(ok_bytes) {
    Ok(v) => {
      match get(v, "a") {
        Some(a) => assert_opt_int(as_int(a), 1L, "valid bytes")
        None => debug_assert(false, "valid bytes missing a")
      }
    }
    Err(e) => debug_assert(false, "valid bytes failed: " + e.message)
  }
  let bad_overlong = test_bytes_from_ints([34, 0xC0, 0xAF, 34])
  match parse_bytes(bad_overlong) {
    Ok(_) => debug_assert(false, "should reject overlong UTF-8")
    Err(_) => ()
  }
  let bad_surr = test_bytes_from_ints([34, 0xED, 0xA0, 0x80, 34])
  match parse_bytes(bad_surr) {
    Ok(_) => debug_assert(false, "should reject surrogate in UTF-8")
    Err(_) => ()
  }
  let bad_trunc = test_bytes_from_ints([34, 0xE2, 0x82])
  match parse_bytes(bad_trunc) {
    Ok(_) => debug_assert(false, "should reject truncated UTF-8")
    Err(_) => ()
  }
}

///|
test "serialization_json_and_json5_and_exact_float_roundtrip" {
  let vals : Array[Double] = [
    0.0,
    -0.0,
    1.0,
    -42.0,
    0.1,
    0.2,
    0.3,
    3.141592653589793,
    1.7976931348623157e+308,
    2.2250738585072014e-308,
    5.0e-324,
    9007199254740991.0,
    -9007199254740991.0,
    1.0e+20,
    1.0e-7,
  ]
  let mut i = 0
  while i < vals.length() {
    let x = vals[i]
    let v = Json5Value::Number(x)
    let j = match to_json_string(v) {
      Ok(s) => s
      Err(e) => {
        debug_assert(false, "to_json_string failed: " + e.message)
        return
      }
    }
    let parsed = match parse(j) {
      Ok(p) => p
      Err(e) => {
        debug_assert(false, "reparse failed for " + j + ": " + e.message)
        return
      }
    }
    match as_number(parsed) {
      Some(y) => {
        if x != 0.0 {
          debug_assert(
            x.reinterpret_as_uint64() == y.reinterpret_as_uint64(),
            "float roundtrip bit mismatch for " + j,
          )
        } else {
          debug_assert(y == 0.0, "zero roundtrip")
        }
      }
      None => debug_assert(false, "expected number")
    }
    i = i + 1
  }

  match to_json_string(Json5Value::Number(1.0 / 0.0)) {
    Ok(_) => debug_assert(false, "to_json_string must reject Infinity")
    Err(_) => ()
  }
  match to_json_string(Json5Value::Number(0.0 / 0.0)) {
    Ok(_) => debug_assert(false, "to_json_string must reject NaN")
    Err(_) => ()
  }
  debug_assert(to_json5_string(Json5Value::Number(1.0 / 0.0)) == "Infinity", "json5 Infinity")
  debug_assert(to_json5_string(Json5Value::Number(-1.0 / 0.0)) == "-Infinity", "json5 -Infinity")
  debug_assert(to_json5_string(Json5Value::Number(0.0 / 0.0)) == "NaN", "json5 NaN")

  let obj = Json5Value::Object([
    ("valid_key", Json5Value::Number(1.0)),
    ("needs-quote", Json5Value::Str("hi")),
  ])
  let j_out = match to_json_string(obj) {
    Ok(s) => s
    Err(_) => ""
  }
  debug_assert(j_out == "{\"valid_key\":1,\"needs-quote\":\"hi\"}", "compact json")
  let j5_out = to_json5_string(obj)
  debug_assert(j5_out == "{valid_key:1,\"needs-quote\":\"hi\"}", "compact json5")
}

///|
test "accessors_and_pretty_print" {
  let doc = "{ n: null, b: true, num: 42, flt: 3.5, s: 'ok', arr: [10, 20], obj: { k: 'v' } }"
  let root = match parse(doc) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse failed: " + e.message)
      return
    }
  }
  match get(root, "n") {
    Some(x) => debug_assert(is_null(x), "is_null")
    None => debug_assert(false, "missing n")
  }
  match get(root, "b") {
    Some(x) => assert_opt_bool(as_bool(x), true, "as_bool")
    None => debug_assert(false, "missing b")
  }
  match get(root, "num") {
    Some(x) => assert_opt_int(as_int(x), 42L, "as_int")
    None => debug_assert(false, "missing num")
  }
  match get(root, "flt") {
    Some(x) => {
      match as_int(x) {
        None => ()
        Some(_) => debug_assert(false, "as_int non-int")
      }
      assert_opt_num(as_number(x), 3.5, "as_number")
    }
    None => debug_assert(false, "missing flt")
  }
  match get(root, "s") {
    Some(x) => assert_opt_str(as_str(x), "ok", "as_str")
    None => debug_assert(false, "missing s")
  }
  debug_assert(value_len(root) == 7, "object len")
  debug_assert(!is_empty(root), "not empty")
  match get(root, "arr") {
    Some(a) => {
      debug_assert(value_len(a) == 2, "arr len")
      match get_index(a, 1) {
        Some(el) => assert_opt_int(as_int(el), 20L, "get_index")
        None => debug_assert(false, "get_index 1")
      }
      match get_index(a, 99) {
        None => ()
        Some(_) => debug_assert(false, "get_index oob")
      }
    }
    None => debug_assert(false, "missing arr")
  }
  let pretty_j = match to_json_string_pretty(root, 2) {
    Ok(s) => s
    Err(_) => ""
  }
  let pretty_j5 = to_json5_string_pretty(root, 2)
  match parse(pretty_j) {
    Ok(v2) => debug_assert(value_eq(root, v2), "pretty json roundtrip")
    Err(e) => debug_assert(false, "pretty json reparse failed: " + e.message)
  }
  match parse(pretty_j5) {
    Ok(v3) => debug_assert(value_eq(root, v3), "pretty json5 roundtrip")
    Err(e) => debug_assert(false, "pretty json5 reparse failed: " + e.message)
  }
}
