///| Wasm32 + Native smoke entry for the `json5` package.

import "json5"

///|
pub fn smoke() -> Int {
  let doc = "// JSON5 smoke\n{ unquoted: 'hello', hex: 0x2A, list: [1, 2, 3,], }\n"
  let parsed = match json5::parse(doc) {
    Ok(v) => v
    Err(_) => return 1
  }
  let std_json = match json5::to_json_string(parsed) {
    Ok(s) => s
    Err(_) => return 2
  }
  let j5 = json5::to_json5_string(parsed)
  let ptr_ok = match json5::pointer_get(parsed, "/list/1") {
    Ok(Some(v)) =>
    match json5::as_int(v) {
      Some(n) => n == 2L
      _ => false
    }
    _ => false
  }
  if !ptr_ok {
    return 3
  }
  let patch = match json5::parse_patch("[{\"op\":\"replace\",\"path\":\"/hex\",\"value\":99}]") {
    Ok(p) => p
    Err(_) => return 4
  }
  let patched = match json5::apply_patch(parsed, patch) {
    Ok(v) => v
    Err(_) => return 5
  }
  let diff_patch = json5::diff(parsed, patched)
  let roundtripped = match json5::apply_patch(parsed, diff_patch) {
    Ok(v) => v
    Err(_) => return 6
  }
  if !json5::value_eq(patched, roundtripped) {
    return 7
  }
  if std_json.length() > 0 && j5.length() > 0 {
    0
  } else {
    8
  }
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  smoke()
}
