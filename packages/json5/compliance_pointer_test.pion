///| Official RFC 6901 JSON Pointer compliance tests and diff/apply roundtrip tests.

///|
test "rfc6901_section5_official_vectors" {
  let doc_src = "{\n  \"foo\": [\"bar\", \"baz\"],\n  \"\": 0,\n  \"a/b\": 1,\n  \"c%d\": 2,\n  \"e^f\": 3,\n  \"g|h\": 4,\n  \"i\\\\j\": 5,\n  \"k\\\"l\": 6,\n  \" \": 7,\n  \"m~n\": 8\n}"
  let doc = match parse(doc_src) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "doc parse failed: " + e.message)
      return
    }
  }
  match pointer_get(doc, "") {
    Ok(Some(v)) => debug_assert(value_eq(v, doc), "root pointer")
    _ => debug_assert(false, "root pointer failed")
  }
  match pointer_get(doc, "/foo") {
    Ok(Some(v)) => debug_assert(value_eq(v, Json5Value::Array([Json5Value::Str("bar"), Json5Value::Str("baz")])), "/foo")
    _ => debug_assert(false, "/foo failed")
  }
  match pointer_get(doc, "/foo/0") {
    Ok(Some(v)) => assert_opt_str(as_str(v), "bar", "/foo/0")
    _ => debug_assert(false, "/foo/0 failed")
  }
  match pointer_get(doc, "/") {
    Ok(Some(v)) => assert_opt_int(as_int(v), 0L, "/")
    _ => debug_assert(false, "/ failed")
  }
  match pointer_get(doc, "/a~1b") {
    Ok(Some(v)) => assert_opt_int(as_int(v), 1L, "/a~1b")
    _ => debug_assert(false, "/a~1b failed")
  }
  match pointer_get(doc, "/c%d") {
    Ok(Some(v)) => assert_opt_int(as_int(v), 2L, "/c%d")
    _ => debug_assert(false, "/c%d failed")
  }
  match pointer_get(doc, "/e^f") {
    Ok(Some(v)) => assert_opt_int(as_int(v), 3L, "/e^f")
    _ => debug_assert(false, "/e^f failed")
  }
  match pointer_get(doc, "/g|h") {
    Ok(Some(v)) => assert_opt_int(as_int(v), 4L, "/g|h")
    _ => debug_assert(false, "/g|h failed")
  }
  match pointer_get(doc, "/i\\j") {
    Ok(Some(v)) => assert_opt_int(as_int(v), 5L, "/i\\j")
    _ => debug_assert(false, "/i\\j failed")
  }
  match pointer_get(doc, "/k\"l") {
    Ok(Some(v)) => assert_opt_int(as_int(v), 6L, "/k\"l")
    _ => debug_assert(false, "/k\"l failed")
  }
  match pointer_get(doc, "/ ") {
    Ok(Some(v)) => assert_opt_int(as_int(v), 7L, "/ ")
    _ => debug_assert(false, "/  failed")
  }
  match pointer_get(doc, "/m~0n") {
    Ok(Some(v)) => assert_opt_int(as_int(v), 8L, "/m~0n")
    _ => debug_assert(false, "/m~0n failed")
  }
  match pointer_get(doc, "/foo/-") {
    Ok(None) => ()
    _ => debug_assert(false, "/foo/- must be None")
  }
  match pointer_get(doc, "/foo/01") {
    Ok(None) => ()
    _ => debug_assert(false, "/foo/01 must be None")
  }
}

///|
test "rfc6901_escape_ordering_and_syntax_errors" {
  match pointer_unescape("~01") {
    Ok(s) => debug_assert(s == "~1", "~01 ordering")
    Err(e) => debug_assert(false, "~01 failed: " + e.message)
  }
  debug_assert(pointer_escape("~1") == "~01", "escape ~1")
  debug_assert(pointer_escape("a/b~c") == "a~1b~0c", "escape a/b~c")
  match pointer_unescape("a~1b~0c") {
    Ok(s) => debug_assert(s == "a/b~c", "unescape a~1b~0c")
    Err(e) => debug_assert(false, "unescape failed: " + e.message)
  }

  let p = match JsonPointer::parse("/a~1b/m~0n/0/") {
    Ok(x) => x
    Err(e) => {
      debug_assert(false, "parse pointer failed: " + e.message)
      return
    }
  }
  debug_assert(p.tokens.length() == 4, "4 tokens")
  debug_assert(p.tokens[0] == "a/b", "tok 0")
  debug_assert(p.tokens[1] == "m~n", "tok 1")
  debug_assert(p.tokens[2] == "0", "tok 2")
  debug_assert(p.tokens[3] == "", "tok 3")
  debug_assert(p.to_string() == "/a~1b/m~0n/0/", "pointer to_string roundtrip")

  match JsonPointer::parse("foo") {
    Ok(_) => debug_assert(false, "missing leading / must fail")
    Err(_) => ()
  }
  match JsonPointer::parse("/a~2b") {
    Ok(_) => debug_assert(false, "invalid ~2 escape must fail")
    Err(_) => ()
  }
  match JsonPointer::parse("/a~") {
    Ok(_) => debug_assert(false, "dangling ~ must fail")
    Err(_) => ()
  }
}

///|
test "rfc6902_diff_and_apply_roundtrip" {
  let pairs = [
    ("{\"a\":1,\"b\":2,\"c\":[1,2,3]}", "{\"a\":1,\"b\":99,\"d\":true,\"c\":[1,4,3,5]}"),
    ("{\"a/b\":{\"m~n\":[{\"x\":1},{\"x\":2}]}}", "{\"a/b\":{\"m~n\":[{\"x\":1,\"y\":2}]}}"),
    ("[1,2,3,4]", "[4,3,2,1]"),
    ("{\"same\":true}", "{\"same\":true}"),
    ("null", "{\"replaced\": [1, 2, 3]}"),
    ("{\"a\": [1, 2, 3]}", "42"),
    ("{\"\": \"empty_key\", \"~1\": \"tilde\"}", "{\"\": \"changed\", \"/\": \"slash\"}"),
  ]
  let mut i = 0
  while i < pairs.length() {
    let (a_s, b_s) = pairs[i]
    let a = match parse(a_s) {
      Ok(v) => v
      Err(_) => {
        debug_assert(false, "parse a failed")
        return
      }
    }
    let b = match parse(b_s) {
      Ok(v) => v
      Err(_) => {
        debug_assert(false, "parse b failed")
        return
      }
    }
    let p = diff(a, b)
    let applied = match apply_patch(a, p) {
      Ok(v) => v
      Err(e) => {
        debug_assert(false, "diff apply failed on case " + i.to_string() + ": " + e.message)
        return
      }
    }
    debug_assert(value_eq(applied, b), "diff roundtrip mismatch on case " + i.to_string())
    let pv = patch_to_value(p)
    let p2 = match patch_from_value(pv) {
      Ok(x) => x
      Err(e) => {
        debug_assert(false, "patch_from_value failed: " + e.message)
        return
      }
    }
    let applied2 = match apply_patch(a, p2) {
      Ok(v) => v
      Err(e) => {
        debug_assert(false, "redecoded patch apply failed: " + e.message)
        return
      }
    }
    debug_assert(value_eq(applied2, b), "redecoded patch mismatch")
    i = i + 1
  }
}

test "splitmix64 zero and pointer escape/unescape (migrated C1)" {
  debug_assert(splitmix64(0UL) != 0UL, "splitmix64(0) != 0")
  debug_assert(pointer_escape_suffix(126) == 48 && pointer_unescape_byte(48) == 126, "~ <-> ~0")
  debug_assert(pointer_escape_suffix(47) == 49 && pointer_unescape_byte(49) == 47, "/ <-> ~1")
}
