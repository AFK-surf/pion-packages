///| Official json5/json5-tests compliance suite (all 114 upstream test cases).

fn test_hex_nibble(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    0
  }
}

fn test_str_from_hex(hex : String) -> String {
  let sb = StringBuilder::new()
  let n = hex.length()
  let mut i = 0
  while i + 1 < n {
    let hi = test_hex_nibble(hex.code_unit_at(i))
    let lo = test_hex_nibble(hex.code_unit_at(i + 1))
    sb.write_byte(((hi << 4) | lo).to_byte())
    i = i + 2
  }
  sb.to_string()
}

fn test_check_nan(v : Json5Value) -> Bool {
  match v {
    Json5Value::Number(x) => x != x
    _ => false
  }
}

fn test_check_neg_zero(v : Json5Value) -> Bool {
  match v {
    Json5Value::Number(x) => x.reinterpret_as_uint64() == 0x8000000000000000UL
    _ => false
  }
}

fn assert_json5_valid(name : String, src : String, expected : Json5Value) -> Unit {
  match parse(src) {
    Ok(actual) => {
      debug_assert(value_eq(actual, expected), "[json5-tests:" + name + "] value mismatch")
    }
    Err(e) => {
      debug_assert(false, "[json5-tests:" + name + "] unexpected error at " + e.line.to_string() + ":" + e.col.to_string() + ": " + e.message)
    }
  }
}

fn assert_json5_invalid(name : String, src : String) -> Unit {
  match parse(src) {
    Ok(_) => debug_assert(false, "[json5-tests:" + name + "] expected Err, got Ok")
    Err(e) => {
      debug_assert(e.line >= 1 && e.col >= 1, "[json5-tests:" + name + "] invalid error location")
    }
  }
}

///|
test "json5_tests__arrays_empty_array_json" {
  assert_json5_valid("arrays/empty-array.json", "[]", Json5Value::Array([]))
}

///|
test "json5_tests__arrays_leading_comma_array_js" {
  assert_json5_invalid("arrays/leading-comma-array.js", "[\n    ,null\n]")
}

///|
test "json5_tests__arrays_lone_trailing_comma_array_js" {
  assert_json5_invalid("arrays/lone-trailing-comma-array.js", "[\n    ,\n]")
}

///|
test "json5_tests__arrays_no_comma_array_txt" {
  assert_json5_invalid("arrays/no-comma-array.txt", "[\n    true\n    false\n]")
}

///|
test "json5_tests__arrays_regular_array_json" {
  assert_json5_valid("arrays/regular-array.json", "[\n    true,\n    false,\n    null\n]", Json5Value::Array([Json5Value::Bool(true), Json5Value::Bool(false), Json5Value::Null]))
}

///|
test "json5_tests__arrays_trailing_comma_array_json5" {
  assert_json5_valid("arrays/trailing-comma-array.json5", "[\n    null,\n]", Json5Value::Array([Json5Value::Null]))
}

///|
test "json5_tests__comments_block_comment_following_array_element_json5" {
  assert_json5_valid("comments/block-comment-following-array-element.json5", "[\n    false\n    /*\n        true\n    */\n]", Json5Value::Array([Json5Value::Bool(false)]))
}

///|
test "json5_tests__comments_block_comment_following_top_level_value_json5" {
  assert_json5_valid("comments/block-comment-following-top-level-value.json5", "null\n/*\n    Some non-comment top-level value is needed;\n    we use null above.\n*/", Json5Value::Null)
}

///|
test "json5_tests__comments_block_comment_in_string_json" {
  assert_json5_valid("comments/block-comment-in-string.json", "\"This /* block comment */ isn't really a block comment.\"", Json5Value::Str("This /* block comment */ isn't really a block comment."))
}

///|
test "json5_tests__comments_block_comment_preceding_top_level_value_json5" {
  assert_json5_valid("comments/block-comment-preceding-top-level-value.json5", "/*\n    Some non-comment top-level value is needed;\n    we use null below.\n*/\nnull", Json5Value::Null)
}

///|
test "json5_tests__comments_block_comment_with_asterisks_json5" {
  assert_json5_valid("comments/block-comment-with-asterisks.json5", "/**\n * This is a JavaDoc-like block comment.\n * It contains asterisks inside of it.\n * It might also be closed with multiple asterisks.\n * Like this:\n **/\ntrue", Json5Value::Bool(true))
}

///|
test "json5_tests__comments_inline_comment_following_array_element_json5" {
  assert_json5_valid("comments/inline-comment-following-array-element.json5", "[\n    false   // true\n]", Json5Value::Array([Json5Value::Bool(false)]))
}

///|
test "json5_tests__comments_inline_comment_following_top_level_value_json5" {
  assert_json5_valid("comments/inline-comment-following-top-level-value.json5", "null // Some non-comment top-level value is needed; we use null here.", Json5Value::Null)
}

