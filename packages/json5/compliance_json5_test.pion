test "json5_tests__comments_irregular_block_comment_json" {
  assert_json5_valid("comments/irregular-block-comment.json", "true\n/*/* This message is inside comment; it is not a nested comment. /*/\n", Json5Value::Bool(true))
}

///|
test "json5_tests__comments_top_level_block_comment_txt" {
  assert_json5_invalid("comments/top-level-block-comment.txt", "/*\n    This should fail;\n    comments cannot be the only top-level value.\n*/")
}

///|
test "json5_tests__comments_top_level_inline_comment_txt" {
  assert_json5_invalid("comments/top-level-inline-comment.txt", "// This should fail; comments cannot be the only top-level value.")
}

///|
test "json5_tests__comments_unterminated_block_comment_txt" {
  assert_json5_invalid("comments/unterminated-block-comment.txt", "true\n/*\n    This block comment doesn't terminate.\n    There was a legitimate value before this,\n    but this is still invalid JS/JSON5.\n")
}

