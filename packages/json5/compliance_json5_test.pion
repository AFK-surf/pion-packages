///|
test "json5_tests__objects_duplicate_keys_json" {
  assert_json5_valid("objects/duplicate-keys.json", "{\n    \"a\": true,\n    \"a\": false\n}\n", Json5Value::Object([("a", Json5Value::Bool(false))]))
}

///|
test "json5_tests__objects_empty_object_json" {
  assert_json5_valid("objects/empty-object.json", "{}", Json5Value::Object([]))
}

///|
test "json5_tests__objects_illegal_unquoted_key_number_txt" {
  assert_json5_invalid("objects/illegal-unquoted-key-number.txt", "{\n    10twenty: \"ten twenty\"\n}")
}

///|
test "json5_tests__objects_illegal_unquoted_key_symbol_txt" {
  assert_json5_invalid("objects/illegal-unquoted-key-symbol.txt", "{\n    multi-word: \"multi-word\"\n}")
}

///|
test "json5_tests__objects_leading_comma_object_txt" {
  assert_json5_invalid("objects/leading-comma-object.txt", "{\n    ,\"foo\": \"bar\"\n}")
}

///|
test "json5_tests__objects_lone_trailing_comma_object_txt" {
  assert_json5_invalid("objects/lone-trailing-comma-object.txt", "{\n    ,\n}")
}

///|
test "json5_tests__objects_no_comma_object_txt" {
  assert_json5_invalid("objects/no-comma-object.txt", "{\n    \"foo\": \"bar\"\n    \"hello\": \"world\"\n}")
}

///|
test "json5_tests__objects_reserved_unquoted_key_json5" {
  assert_json5_valid("objects/reserved-unquoted-key.json5", "{\n    while: true\n}", Json5Value::Object([("while", Json5Value::Bool(true))]))
}

///|
test "json5_tests__objects_single_quoted_key_json5" {
  assert_json5_valid("objects/single-quoted-key.json5", "{\n    'hello': \"world\"\n}", Json5Value::Object([("hello", Json5Value::Str("world"))]))
}

///|
test "json5_tests__objects_trailing_comma_object_json5" {
  assert_json5_valid("objects/trailing-comma-object.json5", "{\n    \"foo\": \"bar\",\n}", Json5Value::Object([("foo", Json5Value::Str("bar"))]))
}

///|
test "json5_tests__objects_unquoted_keys_json5" {
  assert_json5_valid("objects/unquoted-keys.json5", "{\n    hello: \"world\",\n    _: \"underscore\",\n    $: \"dollar sign\",\n    one1: \"numerals\",\n    _$_: \"multiple symbols\",\n    $_$hello123world_$_: \"mixed\"\n}", Json5Value::Object([("hello", Json5Value::Str("world")), ("_", Json5Value::Str("underscore")), ("$", Json5Value::Str("dollar sign")), ("one1", Json5Value::Str("numerals")), ("_$_", Json5Value::Str("multiple symbols")), ("$_$hello123world_$_", Json5Value::Str("mixed"))]))
}

///|
test "json5_tests__strings_escaped_single_quoted_string_json5" {
  assert_json5_valid("strings/escaped-single-quoted-string.json5", "'I can\\'t wait'", Json5Value::Str("I can't wait"))
}

///|
test "json5_tests__strings_multi_line_string_json5" {
  assert_json5_valid("strings/multi-line-string.json5", "'hello\\\n world'", Json5Value::Str("hello world"))
}

///|
test "json5_tests__strings_single_quoted_string_json5" {
  assert_json5_valid("strings/single-quoted-string.json5", "'hello world'", Json5Value::Str("hello world"))
}

///|
test "json5_tests__strings_unescaped_multi_line_string_txt" {
  assert_json5_invalid("strings/unescaped-multi-line-string.txt", "\"foo\nbar\"\n")
}

///|
test "json5_tests__todo_unicode_escaped_unquoted_key_json5" {
  assert_json5_valid("todo/unicode-escaped-unquoted-key.json5", "{\n    sig\\u03A3ma: \"the sum of all things\"\n}", Json5Value::Object([("sigΣma", Json5Value::Str("the sum of all things"))]))
}

///|
test "json5_tests__todo_unicode_unquoted_key_json5" {
  assert_json5_valid("todo/unicode-unquoted-key.json5", "{\n    ümlåût: \"that's not really an ümlaüt, but this is\"\n}", Json5Value::Object([("ümlåût", Json5Value::Str("that's not really an ümlaüt, but this is"))]))
}
