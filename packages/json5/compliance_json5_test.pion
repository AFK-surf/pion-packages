///|
test "json5_tests__misc_readme_example_json5" {
  assert_json5_valid("misc/readme-example.json5", "{\n    foo: 'bar',\n    while: true,\n\n    this: 'is a \\\nmulti-line string',\n\n    // this is an inline comment\n    here: 'is another', // inline comment\n\n    /* this is a block comment\n       that continues on another line */\n\n    hex: 0xDEADbeef,\n    half: .5,\n    delta: +10,\n    to: Infinity,   // and beyond!\n\n    finally: 'a trailing comma',\n    oh: [\n        \"we shouldn't forget\",\n        'arrays can have',\n        'trailing commas too',\n    ],\n}\n", Json5Value::Object([("foo", Json5Value::Str("bar")), ("while", Json5Value::Bool(true)), ("this", Json5Value::Str("is a multi-line string")), ("here", Json5Value::Str("is another")), ("hex", Json5Value::Number(3735928559.0)), ("half", Json5Value::Number(0.5)), ("delta", Json5Value::Number(10.0)), ("to", Json5Value::Number(1.0 / 0.0)), ("finally", Json5Value::Str("a trailing comma")), ("oh", Json5Value::Array([Json5Value::Str("we shouldn't forget"), Json5Value::Str("arrays can have"), Json5Value::Str("trailing commas too")]))]))
}

