test "json5_tests__comments_inline_comment_in_string_json" {
  assert_json5_valid("comments/inline-comment-in-string.json", "\"This inline comment // isn't really an inline comment.\"", Json5Value::Str("This inline comment // isn't really an inline comment."))
}

///|
test "json5_tests__comments_inline_comment_preceding_top_level_value_json5" {
  assert_json5_valid("comments/inline-comment-preceding-top-level-value.json5", "// Some non-comment top-level value is needed; we use null below.\nnull", Json5Value::Null)
}

