///|
test "json5_tests__numbers_nan_json5" {
  match parse("NaN\n") {
    Ok(v) => debug_assert(test_check_nan(v), "[json5-tests:numbers/nan.json5] expected NaN")
    Err(e) => debug_assert(false, "[json5-tests:numbers/nan.json5] unexpected Err: " + e.message)
  }
}

