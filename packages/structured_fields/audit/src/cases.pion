///| Red-team (`redteam_p<sev>_<n>_*`) and control (`control_*`) cases. Each returns "" on PASS, else the reason.
///|
///| Red-team cases assert the RFC 9651 behaviour and FAIL while the finding of the same id in REPORT.md is open.
///| They use only the public API and accept every reasonable fix (for P2-2: reject the duplicate key, or emit it
///| once). Control cases are behaviour the package gets right; they must PASS before and after any fix, and the
///| bug-injection gate of run_audit.sh (diff/inject.py) relies on them.

import "structured_fields"

///|
fn rep(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn index_of(hay : String, needle : String) -> Int {
  let n = hay.length()
  let m = needle.length()
  let mut i = 0
  while i + m <= n {
    let mut k = 0
    while k < m && hay.code_unit_at(i + k) == needle.code_unit_at(k) {
      k = k + 1
    }
    if k == m {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn count_of(hay : String, needle : String) -> Int {
  let mut n = 0
  let mut from = 0
  while from <= hay.length() {
    let j = index_of(hay.slice(from, hay.length()), needle)
    if j < 0 {
      break
    }
    n = n + 1
    from = from + j + needle.length()
  }
  n
}

///|
fn pre(s : String, p : String) -> Bool {
  s.length() >= p.length() && s.slice(0, p.length()) == p
}

///| Canonical serialization of a parsed field, or "ERR".
fn canon(typ : String, raw : String) -> String {
  if typ == "list" {
    match structured_fields::parse_list(raw) {
      Err(_) => "ERR"
      Ok(l) =>
      match structured_fields::serialize_list(l) {
        Ok(s) => s
        Err(_) => "SERERR"
      }
    }
  } else if typ == "dictionary" {
    match structured_fields::parse_dictionary(raw) {
      Err(_) => "ERR"
      Ok(d) =>
      match structured_fields::serialize_dictionary(d) {
        Ok(s) => s
        Err(_) => "SERERR"
      }
    }
  } else {
    match structured_fields::parse_item(raw) {
      Err(_) => "ERR"
      Ok(it) =>
      match structured_fields::serialize_item(it) {
        Ok(s) => s
        Err(_) => "SERERR"
      }
    }
  }
}

///| Check a table of (type, raw, want) triples; want "ERR" means the parse must fail.
fn table(rows : Array[(String, String, String)]) -> String {
  let mut i = 0
  while i < rows.length() {
    let (t, raw, want) = rows[i]
    let got = canon(t, raw)
    if got != want {
      return t + " `" + hex_str(raw) + "`: got `" + got + "`, want `" + want + "`"
    }
    i = i + 1
  }
  ""
}

///|
fn ser_err(r : Result[String, structured_fields::SfvError]) -> Bool {
  match r {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn ser_ok(r : Result[String, structured_fields::SfvError], want : String) -> String {
  match r {
    Ok(s) => if s == want { "" } else { "serialized `" + s + "`, want `" + want + "`" }
    Err(e) => "serializer refused (" + structured_fields::sfv_error_message(e) + "), want `" + want + "`"
  }
}

///|
fn bare(b : structured_fields::BareItem) -> structured_fields::Item {
  structured_fields::Item::bare(b)
}

///|
fn ib(v : Int64) -> structured_fields::BareItem {
  structured_fields::BareItem::Integer(v)
}

// ------------------------------------------------------------------------------------------ red-team

///| P2-1: RFC 9651 4.2.1 / 4.2.2 discard OWS (SP or HTAB) after every List / Dictionary member and return when
///| the input is then empty, so a List or Dictionary may end in HTAB (only Items are limited to trailing SP,
///| 4.2 steps 6-7). Rust sfv 0.16.1 and the reference model accept all of these.
fn redteam_p2_1_trailing_htab_list_dict() -> String {
  table([
    ("list", "a\t", "a"),
    ("list", "a \t", "a"),
    ("list", "1, (2 3)\t", "1, (2 3)"),
    ("list", "a;x=1\t ", "a;x=1"),
    ("dictionary", "a=1\t", "a=1"),
    ("dictionary", "u=1, i\t", "u=1, i"),
    ("dictionary", "geolocation=()\t", "geolocation=()"),
  ])
}

///| P2-2: Dictionaries and Parameters are ordered maps (RFC 9651 3.1.2 / 3.2). The serializer emits a hand-built
///| duplicate key twice; every RFC parser (including this one) then reads the LAST value while get_param /
///| get_dict_member on the same value return the FIRST, and serialize(parse(serialize(x))) != serialize(x).
fn redteam_p2_2_serializer_duplicate_keys() -> String {
  let d = [
    structured_fields::DictMember::new("a", structured_fields::ListEntry::Item(bare(ib(1L)))),
    structured_fields::DictMember::new("a", structured_fields::ListEntry::Item(bare(ib(2L)))),
  ]
  match structured_fields::serialize_dictionary(d) {
    Ok(s) => if count_of(s, "a") > 1 { return "serialize_dictionary emitted a duplicate key: `" + s + "`" }
    Err(_) => ()
  }
  let it = structured_fields::Item::new(ib(1L), [
    structured_fields::Param::new("x", ib(1L)),
    structured_fields::Param::new("x", ib(2L)),
  ])
  match structured_fields::serialize_item(it) {
    Ok(s) => if count_of(s, "x") > 1 { return "serialize_item emitted a duplicate parameter: `" + s + "`" }
    Err(_) => ()
  }
  ""
}

// ------------------------------------------------------------------------------------------- controls

///| Integers: 15-digit bounds, leading zeros count, no `+`, no bare `-`.
fn control_integer() -> String {
  table([
    ("item", "999999999999999", "999999999999999"),
    ("item", "-999999999999999", "-999999999999999"),
    ("item", "000000000000001", "1"),
    ("item", "-0", "0"),
    ("item", "1000000000000000", "ERR"),
    ("item", "0000000000000001", "ERR"),
    ("item", "-1000000000000000", "ERR"),
    ("item", "+1", "ERR"),
    ("item", "-", "ERR"),
    ("item", "--1", "ERR"),
    ("item", "- 1", "ERR"),
  ])
  |> fn(r) { if r != "" { r } else { ser_range() } }
}

///| Serializer range checks for Integers and Dates (RFC 9651 4.1.4 / 4.1.10).
fn ser_range() -> String {
  let bad : Array[Int64] = [1000000000000000L, -1000000000000000L, 9223372036854775807L, -9223372036854775807L - 1L]
  let mut i = 0
  while i < bad.length() {
    if !ser_err(structured_fields::serialize_bare_item(ib(bad[i]))) {
      return "serializer accepted Integer " + bad[i].to_string()
    }
    if !ser_err(structured_fields::serialize_bare_item(structured_fields::BareItem::Date(bad[i]))) {
      return "serializer accepted Date " + bad[i].to_string()
    }
    i = i + 1
  }
  let r = ser_ok(structured_fields::serialize_bare_item(ib(-999999999999999L)), "-999999999999999")
  if r != "" {
    return r
  }
  ser_ok(structured_fields::serialize_bare_item(structured_fields::BareItem::Date(999999999999999L)), "@999999999999999")
}

///| Decimals: 12 + 3 digits, canonical form, `-0.0` -> `0.0`.
fn control_decimal() -> String {
  let r = table([
    ("item", "999999999999.999", "999999999999.999"),
    ("item", "-999999999999.999", "-999999999999.999"),
    ("item", "1.0", "1.0"),
    ("item", "1.500", "1.5"),
    ("item", "-0.0", "0.0"),
    ("item", "-0.001", "-0.001"),
    ("item", "0.120", "0.12"),
    ("item", "000000000001.5", "1.5"),
    ("item", "1234567890123.4", "ERR"),
    ("item", "1.2345", "ERR"),
    ("item", "1.", "ERR"),
    (
      "item", ".5", "ERR",
    ),
    ("item", "1..2", "ERR"),
    ("item", "-.5", "ERR"),
  ])
  if r != "" {
    return r
  }
  // exact round-half-to-even into thousandths (RFC 9651 4.1.5)
  let cases : Array[(Int64, Int, Int64)] = [
    (5L, 4, 0L),
    (15L, 4, 2L),
    (25L, 4, 2L),
    (-5L, 4, 0L),
    (-15L, 4, -2L),
    (-25L, 4, -2L),
    (12345L, 4, 1234L),
    (12355L, 4, 1236L),
    (-9223372036854775807L - 1L, 22, -1L),
    (-9223372036854775807L - 1L, 23, 0L),
    (-9223372036854775807L - 1L, 19, -922L),
    (5000000000000000000L, 22, 0L),
    (-5000000000000000000L, 22, 0L),
    (-15000000000000000L, 19, -2L),
    (9223372036854775807L, 22, 1L),
    (1999999999999999L, 4, 200000000000000L),
    (999999999999999L, 3, 999999999999999L),
  ]
  let mut i = 0
  while i < cases.length() {
    let (v, sc, want) = cases[i]
    match structured_fields::Decimal::from_scaled_rounded(v, sc) {
      Ok(d) =>
      if d.scaled_milli != want {
        return "from_scaled_rounded(" + v.to_string() + ", " + sc.to_string() + ") = " + d.scaled_milli.to_string() +
        ", want " + want.to_string()
      }
      Err(_) => return "from_scaled_rounded(" + v.to_string() + ", " + sc.to_string() + ") failed"
    }
    i = i + 1
  }
  match structured_fields::Decimal::from_scaled_rounded(9999999999999995L, 4) {
    Ok(d) => return "from_scaled_rounded overflow accepted: " + d.scaled_milli.to_string()
    Err(_) => ()
  }
  if !ser_err(structured_fields::serialize_bare_item(structured_fields::BareItem::Decimal(structured_fields::Decimal::{
    scaled_milli: 1000000000000000L,
  }))) {
    return "serializer accepted a 13-digit decimal"
  }
  ""
}

///| Strings, tokens, keys at their byte-class boundaries.
fn control_string_token_key() -> String {
  let r = table([
    ("item", "\"a\\\"b\\\\c\"", "\"a\\\"b\\\\c\""),
    ("item", "\" ~\"", "\" ~\""),
    ("item", "\"\\t\"", "ERR"),
    ("item", "\"\\'\"", "ERR"),
    ("item", "\"\\u0041\"", "ERR"),
    ("item", "\"a\tb\"", "ERR"),
    ("item", "\"a\u{7f}b\"", "ERR"),
    ("item", "\"abc", "ERR"),
    ("item", "\"abc\\", "ERR"),
    ("item", "*a!#$%&'*+-.^_`|~09:/Z", "*a!#$%&'*+-.^_`|~09:/Z"),
    ("item", "a(", "ERR"),
    ("item", "a\"", "ERR"),
    ("item", "a@", "ERR"),
    ("item", "a{", "ERR"),
    ("dictionary", "*a_b-c.d*0=1", "*a_b-c.d*0=1"),
    ("dictionary", "A=1", "ERR"),
    ("dictionary", "aB=1", "ERR"),
    ("dictionary", "_a=1", "ERR"),
    ("dictionary", "0a=1", "ERR"),
    ("item", "1;A=1", "ERR"),
    ("item", "1; a=1", "1;a=1"),
    ("item", "1;\ta=1", "ERR"),
    ("item", "1 ;a=1", "ERR"),
  ])
  if r != "" {
    return r
  }
  if !ser_err(structured_fields::serialize_bare_item(structured_fields::BareItem::String("ok\r\nX-Evil: 1"))) {
    return "serializer emitted CR LF inside a String"
  }
  if !ser_err(structured_fields::serialize_bare_item(structured_fields::BareItem::String("caf\u{e9}"))) {
    return "serializer emitted non-ASCII inside a String"
  }
  if !ser_err(structured_fields::serialize_bare_item(structured_fields::BareItem::String("a\u{7f}"))) {
    return "serializer emitted DEL inside a String"
  }
  let bad_tokens = ["", "1a", "a b", "a,b", "a\r\nb", "a\"", "\u{e9}", "a;b", "a=b", "(a)"]
  let mut i = 0
  while i < bad_tokens.length() {
    if !ser_err(structured_fields::serialize_bare_item(structured_fields::BareItem::Token(bad_tokens[i]))) {
      return "serializer accepted token `" + hex_str(bad_tokens[i]) + "`"
    }
    i = i + 1
  }
  let bad_keys = ["", "A", "aB", "a b", "a\r\nb", "1a", "-a", "a=", "a;b"]
  let mut k = 0
  while k < bad_keys.length() {
    let it = structured_fields::Item::new(ib(1L), [structured_fields::Param::new(bad_keys[k], ib(1L))])
    if !ser_err(structured_fields::serialize_item(it)) {
      return "serializer accepted parameter key `" + hex_str(bad_keys[k]) + "`"
    }
    let d = [structured_fields::DictMember::new(bad_keys[k], structured_fields::ListEntry::Item(bare(ib(1L))))]
    if !ser_err(structured_fields::serialize_dictionary(d)) {
      return "serializer accepted dictionary key `" + hex_str(bad_keys[k]) + "`"
    }
    k = k + 1
  }
  ser_ok(structured_fields::serialize_bare_item(structured_fields::BareItem::String("a\"b\\c")), "\"a\\\"b\\\\c\"")
}

///| Byte sequences: alphabet, padding position, partial padding, pad bits, canonical output.
fn control_binary() -> String {
  table([
    ("item", ":aGVsbG8=:", ":aGVsbG8=:"),
    ("item", ":aGVsbG8:", ":aGVsbG8=:"),
    ("item", ":aZ==:", ":aQ==:"),
    ("item", ":YQ=:", ":YQ==:"),
    ("item", "::", "::"),
    ("item", ":/+Ah:", ":/+Ah:"),
    ("item", ":a=GVsbG8=:", "ERR"),
    ("item", ":=aGVsbG8:", "ERR"),
    ("item", ":aGVsbG8==:", "ERR"),
    ("item", ":YWJj=:", "ERR"),
    ("item", ":=:", "ERR"),
    ("item", ":Y:", "ERR"),
    ("item", ":aGVs bG8=:", "ERR"),
    ("item", ":aGVs\nbG8=:", "ERR"),
    ("item", ":_-Ah:", "ERR"),
    ("item", ":aGVsbG8=", "ERR"),
    ("item", ":", "ERR"),
  ])
}

///| Booleans and Dates.
fn control_boolean_date() -> String {
  table([
    ("item", "?1", "?1"),
    ("item", "?0", "?0"),
    ("item", "?2", "ERR"),
    ("item", "?", "ERR"),
    ("item", "? 1", "ERR"),
    ("item", "?true", "ERR"),
    ("item", "@0", "@0"),
    ("item", "@-0", "@0"),
    ("item", "@999999999999999", "@999999999999999"),
    ("item", "@-999999999999999", "@-999999999999999"),
    ("item", "@1000000000000000", "ERR"),
    ("item", "@1.0", "ERR"),
    ("item", "@-", "ERR"),
    ("item", "@+1", "ERR"),
    ("item", "@ 1", "ERR"),
    ("item", "@", "ERR"),
    ("item", "@a", "ERR"),
  ])
}

///| Display Strings: lowercase %xx only, strict UTF-8, canonical lowercase escaping of %, ", controls, non-ASCII.
fn control_display_string() -> String {
  let r = table([
    ("item", "%\"f%c3%bc%c3%bc\"", "%\"f%c3%bc%c3%bc\""),
    ("item", "%\"%25%22\"", "%\"%25%22\""),
    ("item", "%\"%41\"", "%\"A\""),
    ("item", "%\"%f0%9f%98%80\"", "%\"%f0%9f%98%80\""),
    ("item", "%\"%f4%8f%bf%bf\"", "%\"%f4%8f%bf%bf\""),
    ("item", "%\"%ef%bf%bf\"", "%\"%ef%bf%bf\""),
    ("item", "%\"%C3%BC\"", "ERR"),
    ("item", "%\"%2F\"", "ERR"),
    ("item", "%\"%c3%BC\"", "ERR"),
    ("item", "%\"%\"", "ERR"),
    ("item", "%\"%a\"", "ERR"),
    ("item", "%\"%zz\"", "ERR"),
    ("item", "%\"%c3\"", "ERR"),
    ("item", "%\"%c0%af\"", "ERR"),
    ("item", "%\"%e0%80%af\"", "ERR"),
    ("item", "%\"%f0%80%80%af\"", "ERR"),
    ("item", "%\"%ed%a0%80\"", "ERR"),
    ("item", "%\"%ed%bf%bf\"", "ERR"),
    ("item", "%\"%f4%90%80%80\"", "ERR"),
    ("item", "%\"%f5%80%80%80\"", "ERR"),
    ("item", "%\"%ff\"", "ERR"),
    ("item", "%\"%80\"", "ERR"),
    ("item", "%\"a\tb\"", "ERR"),
    ("item", "%\"a\u{7f}\"", "ERR"),
    ("item", "%\"abc", "ERR"),
    ("item", "%abc\"", "ERR"),
    ("item", "%", "ERR"),
  ])
  if r != "" {
    return r
  }
  let r2 = ser_ok(
    structured_fields::serialize_bare_item(structured_fields::BareItem::DisplayString("100% \"ok\"\r\n\u{e9}\u{7f}")),
    "%\"100%25 %22ok%22%0d%0a%c3%a9%7f\"",
  )
  if r2 != "" {
    return r2
  }
  // invalid UTF-8 built byte by byte (lone surrogate ED A0 80, overlong C0 AF, truncated E2 82)
  let bad = ["\xed\xa0\x80", "\xc0\xaf", "\xe2\x82", "\xf8\x88\x80\x80\x80", "a\xff"]
  let mut i = 0
  while i < bad.length() {
    if !ser_err(structured_fields::serialize_bare_item(structured_fields::BareItem::DisplayString(bad[i]))) {
      return "serializer accepted invalid UTF-8 display string `" + hex_str(bad[i]) + "`"
    }
    i = i + 1
  }
  ""
}

///| Whitespace rules: Items take SP only at both ends; Lists / Dictionaries take OWS around commas; never CR / LF.
fn control_whitespace() -> String {
  table([
    ("item", "  1  ", "1"),
    ("item", "\t1", "ERR"),
    ("item", "1\t", "ERR"),
    ("item", "1 \t ", "ERR"),
    ("item", "1\r\n", "ERR"),
    ("list", "\t1", "ERR"),
    ("list", "\r1", "ERR"),
    ("list", "1\r", "ERR"),
    ("list", "1\n", "ERR"),
    ("list", "1\u{0b}", "ERR"),
    ("list", "1\u{0c}", "ERR"),
    ("list", "1 \t,\t 2", "1, 2"),
    ("list", "  1, 2  ", "1, 2"),
    ("list", "", ""),
    ("list", "   ", ""),
    ("list", "1,", "ERR"),
    ("list", "1,,2", "ERR"),
    ("list", ",1", "ERR"),
    ("list", "1 2", "ERR"),
    ("list", "(1\t2)", "ERR"),
    ("list", "( 1  2 )", "(1 2)"),
    ("list", "(), ()", "(), ()"),
    ("list", "(1)(2)", "ERR"),
    ("list", "(1", "ERR"),
    ("dictionary", "a=1 , b=2", "a=1, b=2"),
    ("dictionary", "a =1", "ERR"),
    ("dictionary", "a= 1", "ERR"),
    ("dictionary", "a=1,", "ERR"),
    ("dictionary", "", ""),
  ])
}

///| Duplicate keys overwrite in place (first position, last value), Dictionary and Parameters.
fn control_duplicates() -> String {
  table([
    ("dictionary", "a=1, b=2, a=3", "a=3, b=2"),
    ("dictionary", "a, b=2, a=?0", "a=?0, b=2"),
    ("dictionary", "a=1, b, c, d, e, f, g, h, i, a=9, j=1, b=8", "a=9, b=8, c, d, e, f, g, h, i, j=1"),
    ("item", "1;a=1;b=2;a=3", "1;a=3;b=2"),
    ("item", "1;a;b;c;d;e;f;g;h;i;a=9;j;b=8", "1;a=9;b=8;c;d;e;f;g;h;i;j"),
    ("list", "(1;a=1;a=2);x=1;x", "(1;a=2);x"),
  ])
}

///| Multi-line joining (`parse_*_fields`).
fn control_fields() -> String {
  match structured_fields::parse_list_fields(["1, 2", "3"]) {
    Ok(l) => if l.length() != 3 { return "list fields: " + l.length().to_string() + " members" }
    Err(_) => return "list fields rejected"
  }
  match structured_fields::parse_dictionary_fields(["a=1, b=2", "a=3"]) {
    Ok(d) =>
    match structured_fields::serialize_dictionary(d) {
      Ok(s) => if s != "a=3, b=2" { return "dict fields: `" + s + "`" }
      Err(_) => return "dict fields: serializer refused"
    }
    Err(_) => return "dict fields rejected"
  }
  match structured_fields::parse_list_fields([]) {
    Ok(l) => if l.length() != 0 { return "no field lines -> non-empty list" }
    Err(_) => return "no field lines rejected"
  }
  let evil = ["a", "b\r\nX-Evil: 1", "c\u{0}"]
  let mut i = 1
  while i < evil.length() {
    match structured_fields::parse_list_fields(["a", evil[i]]) {
      Ok(_) => return "control byte in a field line accepted: `" + hex_str(evil[i]) + "`"
      Err(_) => ()
    }
    i = i + 1
  }
  match structured_fields::parse_list_fields(["a", ""]) {
    Ok(_) => return "empty second field line accepted (would be a trailing comma)"
    Err(_) => ()
  }
  match structured_fields::parse_list_fields_with_limits(["aaaa", "bbbb"], structured_fields::SfvLimits::new(9, 10, 10, 10, 10, 10, 10)) {
    Ok(_) => return "joined fields over max_input_bytes accepted"
    Err(_) => ()
  }
  match structured_fields::parse_list_fields_with_limits(["aaaa", "bbb"], structured_fields::SfvLimits::new(9, 10, 10, 10, 10, 10, 10)) {
    Ok(_) => ""
    Err(_) => "joined fields of exactly max_input_bytes rejected"
  }
}

///| `SfvLimits`: negative rejected, 0 means 0, exact bound accepted, bound + 1 rejected.
fn control_limits() -> String {
  let neg = structured_fields::SfvLimits::new(10, 10, 10, 10, 10, 10, -1)
  if !ser_err(structured_fields::serialize_item_with_limits(bare(ib(1L)), neg)) {
    return "negative max_output_bytes accepted"
  }
  let l2 = structured_fields::SfvLimits::new(100, 2, 2, 2, 2, 4, 100)
  let ok_in : Array[(String, String)] = [
    ("list", "a, b"),
    ("list", "(1 2)"),
    ("dictionary", "a, b"),
    ("item", "1;a;b"),
    ("item", "\"abcd\""),
    ("item", "abcd"),
    ("item", ":YWJjZA==:"),
    ("item", "%\"abcd\""),
    ("item", "%\"%c3%bc%c3%bc\""),
    ("dictionary", "abcd"),
    ("dictionary", "a=1, b=2, a=3, a=4, b=5"),
    ("item", "1;a;b;a;a;b"),
  ]
  let bad_in : Array[(String, String)] = [
    ("list", "a, b, c"),
    ("list", "(1 2 3)"),
    ("dictionary", "a, b, c"),
    ("item", "1;a;b;c"),
    ("item", "\"abcde\""),
    ("item", "abcde"),
    ("item", ":YWJjZGU=:"),
    ("item", "%\"abcde\""),
    ("item", "%\"%c3%bc%c3%bc%c3%bc\""),
    ("dictionary", "abcde"),
  ]
  let mut i = 0
  while i < ok_in.length() {
    let (t, raw) = ok_in[i]
    if pre(bomb_summary(t, raw, l2), "ERR") {
      return "limit bound rejected: " + t + " `" + raw + "` " + bomb_summary(t, raw, l2)
    }
    i = i + 1
  }
  i = 0
  while i < bad_in.length() {
    let (t, raw) = bad_in[i]
    if !pre(bomb_summary(t, raw, l2), "ERR LimitExceeded") {
      return "limit bound + 1 not LimitExceeded: " + t + " `" + raw + "` " + bomb_summary(t, raw, l2)
    }
    i = i + 1
  }
  let z = structured_fields::SfvLimits::new(0, 0, 0, 0, 0, 0, 0)
  match structured_fields::parse_list_with_limits("", z) {
    Ok(l) => if l.length() != 0 { return "zero limits: empty list not empty" }
    Err(_) => return "zero limits: empty list rejected"
  }
  if !pre(bomb_summary("item", "1", z), "ERR LimitExceeded") {
    return "max_input_bytes = 0 accepted a byte"
  }
  // max_output_bytes: exact fits, one less fails, also for 3x display-string and 4/3 base64 expansion
  let o = fn(n : Int) { structured_fields::SfvLimits::new(100, 10, 10, 10, 10, 100, n) }
  let disp = bare(structured_fields::BareItem::DisplayString("\u{e9}\u{e9}"))
  if ser_err(structured_fields::serialize_item_with_limits(disp, o(15))) {
    return "display string of exactly max_output_bytes refused"
  }
  if !ser_err(structured_fields::serialize_item_with_limits(disp, o(14))) {
    return "display string over max_output_bytes accepted"
  }
  let bs = bare(structured_fields::BareItem::ByteSequence("abcd".to_bytes()))
  if ser_err(structured_fields::serialize_item_with_limits(bs, o(10))) {
    return "byte sequence of exactly max_output_bytes refused"
  }
  if !ser_err(structured_fields::serialize_item_with_limits(bs, o(9))) {
    return "byte sequence over max_output_bytes accepted"
  }
  let lst = [structured_fields::ListEntry::Item(bare(ib(1L))), structured_fields::ListEntry::Item(bare(ib(2L)))]
  if ser_err(structured_fields::serialize_list_with_limits(lst, o(4))) {
    return "list of exactly max_output_bytes refused"
  }
  if !ser_err(structured_fields::serialize_list_with_limits(lst, o(3))) {
    return "list over max_output_bytes accepted"
  }
  ""
}

///| RFC 9218 Priority and W3C Permissions-Policy helpers.
fn control_helpers() -> String {
  let pr : Array[(String, Int, Bool)] = [
    ("u=1, i", 1, true),
    ("", 3, false),
    ("u=0", 0, false),
    ("u=7", 7, false),
    ("u=8", 3, false),
    ("u=-1", 3, false),
    ("u=1.0", 3, false),
    ("u=\"1\"", 3, false),
    ("u=(1)", 3, false),
    ("i=?0", 3, false),
    ("i=1", 3, false),
    ("u=2, u=9", 3, false),
    ("u=2;x=1, foo=bar, i;y", 2, true),
  ]
  let mut i = 0
  while i < pr.length() {
    let (raw, u, inc) = pr[i]
    match structured_fields::parse_priority(raw) {
      Ok(p) =>
      if p.urgency != u || p.incremental != inc {
        return "priority `" + raw + "` -> u=" + p.urgency.to_string() + " i=" + p.incremental.to_string()
      }
      Err(_) => return "priority `" + raw + "` rejected"
    }
    i = i + 1
  }
  match structured_fields::serialize_priority(structured_fields::Priority::{ urgency: 8, incremental: false }) {
    Ok(_) => return "serialize_priority accepted u=8"
    Err(_) => ()
  }
  match structured_fields::parse_permissions_policy(
    "geolocation=(self \"https://a.example\"), camera=(), fullscreen=*, usb=self",
  ) {
    Ok(ds) => {
      if ds.length() != 4 {
        return "permissions policy: " + ds.length().to_string() + " directives"
      }
      if !ds[0].allow_self || ds[0].allow_all || ds[0].origins.length() != 1 {
        return "permissions policy geolocation wrong"
      }
      if ds[1].allow_self || ds[1].allow_all || ds[1].origins.length() != 0 {
        return "permissions policy camera=() wrong"
      }
      if !ds[2].allow_all || !ds[3].allow_self {
        return "permissions policy * / self wrong"
      }
    }
    Err(_) => return "permissions policy rejected"
  }
  ""
}

///| A 10,000-member dictionary of one repeated key and 10,000 repeated parameters under raised limits.
fn control_dup_scale() -> String {
  let big = structured_fields::SfvLimits::new(1000000, 100000, 256, 100000, 100000, 100000, 1000000)
  let d = rep("a=1, b=2, ", 5000) + "c"
  let s = bomb_summary("dictionary", d, big)
  if s != "OK members=3 ser=11" {
    return "duplicate-key dictionary: " + s
  }
  let p = "x" + rep(";k=1;q", 5000)
  let s2 = bomb_summary("item", p, big)
  if s2 != "OK params=2 ser=7" {
    return "duplicate parameters: " + s2
  }
  ""
}

// -------------------------------------------------------------------------------------------- registry

///|
pub fn case_names() -> Array[String] {
  [
    "redteam_p2_1_trailing_htab_list_dict", "redteam_p2_2_serializer_duplicate_keys", "control_integer", "control_decimal",
    "control_string_token_key", "control_binary", "control_boolean_date", "control_display_string", "control_whitespace",
    "control_duplicates", "control_fields", "control_limits", "control_helpers", "control_dup_scale",
  ]
}

///|
pub fn run_case(name : String) -> String {
  if name == "redteam_p2_1_trailing_htab_list_dict" {
    redteam_p2_1_trailing_htab_list_dict()
  } else if name == "redteam_p2_2_serializer_duplicate_keys" {
    redteam_p2_2_serializer_duplicate_keys()
  } else if name == "control_integer" {
    control_integer()
  } else if name == "control_decimal" {
    control_decimal()
  } else if name == "control_string_token_key" {
    control_string_token_key()
  } else if name == "control_binary" {
    control_binary()
  } else if name == "control_boolean_date" {
    control_boolean_date()
  } else if name == "control_display_string" {
    control_display_string()
  } else if name == "control_whitespace" {
    control_whitespace()
  } else if name == "control_duplicates" {
    control_duplicates()
  } else if name == "control_fields" {
    control_fields()
  } else if name == "control_limits" {
    control_limits()
  } else if name == "control_helpers" {
    control_helpers()
  } else if name == "control_dup_scale" {
    control_dup_scale()
  } else {
    "unknown case"
  }
}
