///| RT-sfv red-team CLI for `packages/structured_fields` (native + wasm32, see ../REPORT.md).
///|   dump <file>  corpus line `<name>\t<item|list|dictionary>\t<hex>[,<hex>...]` -> `=<name>` + src/dump.pion
///|   ser <file>   vector line `<name>\t<type>\t<typed AST>` -> `=<name>` + `S <hex>` / `S ERR`
///|   helpers <file> corpus lines -> parse_priority / parse_permissions_policy results
///|   bomb <type> <file> [<limit> x7] -> parse the whole file as one field (+ serialize), one-line summary + us
///|   list | case <name> -> red-team / control cases (src/cases.pion)

import "structured_fields"

///|
pub fn split_on(data : String, sep : Int) -> Array[String] {
  let out : Array[String] = []
  let n = data.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if data.code_unit_at(i) == sep {
      out.push(data.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(data.slice(start, n))
  out
}

///|
fn for_lines(text : String, f : (String, String) -> String) -> String {
  let lines = split_on(text, 10)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let cols = split_on(lines[i], 9)
    if cols.length() == 3 {
      sb.write_string("=" + cols[0] + "\n")
      sb.write_string(f(cols[1], cols[2]))
    }
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn fields_of(hexes : String) -> Array[String] {
  let out : Array[String] = []
  if hexes.length() == 0 {
    return out
  }
  let parts = split_on(hexes, 44)
  let mut i = 0
  while i < parts.length() {
    out.push(unhex(parts[i]))
    i = i + 1
  }
  out
}

///|
fn helpers_case(typ : String, hexes : String) -> String {
  let _ = typ
  let raw = join_lines(fields_of(hexes))
  let pr = match structured_fields::parse_priority(raw) {
    Ok(p) => "u=" + p.urgency.to_string() + " i=" + (if p.incremental { "1" } else { "0" })
    Err(_) => "ERR"
  }
  let pp = match structured_fields::parse_permissions_policy(raw) {
    Err(_) => "ERR"
    Ok(ds) => {
      let sb = StringBuilder::new()
      let mut i = 0
      while i < ds.length() {
        let d = ds[i]
        sb.write_string(
          " " + hex_str(d.feature) + ":" + (if d.allow_all { "*" } else { "-" }) + (if d.allow_self {
            "s"
          } else {
            "-"
          }),
        )
        let mut j = 0
        while j < d.origins.length() {
          sb.write_string("," + hex_str(d.origins[j]))
          j = j + 1
        }
        i = i + 1
      }
      "OK" + sb.to_string()
    }
  }
  "PRIO " + pr + "\nPP " + pp + "\n"
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut neg = false
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 45 {
      neg = true
    } else if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  if neg {
    -v
  } else {
    v
  }
}

///|
fn err_kind(e : structured_fields::SfvError) -> String {
  match e {
    structured_fields::SfvError::LimitExceeded(m) => "LimitExceeded(" + m + ")"
    _ => "Invalid"
  }
}

///| Parse `text` as one field of type `typ` under `lim`, re-serialize under `lim`, summarize.
pub fn bomb_summary(typ : String, text : String, lim : structured_fields::SfvLimits) -> String {
  if typ == "list" {
    match structured_fields::parse_list_with_limits(text, lim) {
      Err(e) => "ERR " + err_kind(e)
      Ok(l) =>
      "OK members=" + l.length().to_string() + " ser=" + (match structured_fields::serialize_list_with_limits(l, lim) {
        Ok(s) => s.length().to_string()
        Err(e) => err_kind(e)
      })
    }
  } else if typ == "dictionary" {
    match structured_fields::parse_dictionary_with_limits(text, lim) {
      Err(e) => "ERR " + err_kind(e)
      Ok(d) =>
      "OK members=" + d.length().to_string() + " ser=" + (match structured_fields::serialize_dictionary_with_limits(
        d, lim,
      ) {
        Ok(s) => s.length().to_string()
        Err(e) => err_kind(e)
      })
    }
  } else {
    match structured_fields::parse_item_with_limits(text, lim) {
      Err(e) => "ERR " + err_kind(e)
      Ok(it) =>
      "OK params=" + it.params.length().to_string() + " ser=" + (match structured_fields::serialize_item_with_limits(
        it, lim,
      ) {
        Ok(s) => s.length().to_string()
        Err(e) => err_kind(e)
      })
    }
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: sfv_audit dump|ser|helpers <file> | bomb <type> <file> [limits x7] | list | case <name>")
    return 2
  }
  let mode = args[1]
  if (mode == "dump" || mode == "ser" || mode == "helpers") && args.length() >= 3 {
    let text = match fs_read_bytes(world, args[2]) {
      Ok(b) => b.to_string()
      Err(_) => {
        io_eprintln(world, "cannot read " + args[2])
        return 2
      }
    }
    if mode == "dump" {
      io_print(world, for_lines(text, fn(t, h) { dump_case(t, fields_of(h)) }))
    } else if mode == "ser" {
      io_print(world, for_lines(text, ser_case))
    } else {
      io_print(world, for_lines(text, helpers_case))
    }
    return 0
  }
  if mode == "bomb" && args.length() >= 4 {
    let text = match fs_read_bytes(world, args[3]) {
      Ok(b) => b.to_string()
      Err(_) => return 2
    }
    let lim = if args.length() >= 11 {
      structured_fields::SfvLimits::new(
        parse_int(args[4]),
        parse_int(args[5]),
        parse_int(args[6]),
        parse_int(args[7]),
        parse_int(args[8]),
        parse_int(args[9]),
        parse_int(args[10]),
      )
    } else {
      structured_fields::SfvLimits::default()
    }
    let t0 = clock_monotonic_us()
    let s = bomb_summary(args[2], text, lim)
    let t1 = clock_monotonic_us()
    io_println(world, s + " us=" + (t1 - t0).to_string())
    return 0
  }
  if mode == "list" {
    io_println(world, case_names().join(" "))
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = run_case(args[2])
    io_println(world, (if r == "" { "PASS " } else { "FAIL " }) + args[2] + (if r == "" { "" } else { " :: " + r }))
    return 0
  }
  io_println(world, "bad arguments")
  2
}
