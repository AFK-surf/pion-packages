///| Shared dump format of the RT-sfv audit (same bytes as diff/model.py and diff/rust/src/main.rs):
///|   `P <typed>` + `S <hex of canonical serialization>` (or `S ERR`) for a parse, `ERR` for a rejected input.
///| `typed` hex-encodes every key, token, string, byte sequence and display string, so any byte value survives.

import "structured_fields"

///|
pub fn hex_nibble(v : Int) -> Byte {
  if v < 10 {
    (48 + v).to_byte()
  } else {
    (87 + v).to_byte()
  }
}

///|
pub fn hex_bytes(b : Bytes) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let x = b[i].to_int()
    sb.write_byte(hex_nibble(x >> 4))
    sb.write_byte(hex_nibble(x & 15))
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn hex_str(s : String) -> String {
  hex_bytes(s.to_bytes())
}

///|
fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

///| Hex text -> raw bytes as a `String` (may be any byte sequence, not only UTF-8).
pub fn unhex(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i + 1 < n {
    sb.write_byte((hex_val(s.code_unit_at(i)) * 16 + hex_val(s.code_unit_at(i + 1))).to_byte())
    i = i + 2
  }
  sb.to_string()
}

///|
pub fn unhex_bytes(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = (hex_val(s.code_unit_at(2 * i)) * 16 + hex_val(s.code_unit_at(2 * i + 1))).to_byte()
    i = i + 1
  }
  out
}

///|
pub fn t_bare(b : structured_fields::BareItem) -> String {
  match b {
    structured_fields::BareItem::Integer(v) => "i" + v.to_string()
    structured_fields::BareItem::Decimal(d) => "d" + d.scaled_milli.to_string()
    structured_fields::BareItem::String(s) => "s" + hex_str(s)
    structured_fields::BareItem::Token(t) => "t" + hex_str(t)
    structured_fields::BareItem::ByteSequence(v) => "b" + hex_bytes(v)
    structured_fields::BareItem::Boolean(v) => if v { "?1" } else { "?0" }
    structured_fields::BareItem::Date(v) => "@" + v.to_string()
    structured_fields::BareItem::DisplayString(s) => "%" + hex_str(s)
  }
}

///|
pub fn t_params(ps : Array[structured_fields::Param]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ps.length() {
    sb.write_string(";" + hex_str(ps[i].key) + "=" + t_bare(ps[i].value))
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn t_item(it : structured_fields::Item) -> String {
  t_bare(it.value) + t_params(it.params)
}

///|
pub fn t_entry(e : structured_fields::ListEntry) -> String {
  match e {
    structured_fields::ListEntry::Item(it) => t_item(it)
    structured_fields::ListEntry::InnerList(il) => {
      let sb = StringBuilder::new()
      sb.write_string("(")
      let mut i = 0
      while i < il.items.length() {
        if i > 0 {
          sb.write_string(" ")
        }
        sb.write_string(t_item(il.items[i]))
        i = i + 1
      }
      sb.write_string(")")
      sb.write_string(t_params(il.params))
      sb.to_string()
    }
  }
}

///|
pub fn t_list(l : Array[structured_fields::ListEntry]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < l.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(t_entry(l[i]))
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn t_dict(d : Array[structured_fields::DictMember]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < d.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(hex_str(d[i].key) + "=" + t_entry(d[i].value))
    i = i + 1
  }
  sb.to_string()
}

///|
fn ser_line(r : Result[String, structured_fields::SfvError]) -> String {
  match r {
    Ok(s) => "S " + hex_str(s) + "\n"
    Err(_) => "S ERR\n"
  }
}

///| Join field lines the way the official test runner and Rust `sfv` harness do (", ").
pub fn join_lines(fields : Array[String]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < fields.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(fields[i])
    i = i + 1
  }
  sb.to_string()
}

///| Lists and dictionaries go through the multi-line API (`parse_*_fields`); items have none, so the lines are
///| joined first (an item split over two lines must fail).
pub fn dump_case(typ : String, fields : Array[String]) -> String {
  if typ == "list" {
    match structured_fields::parse_list_fields(fields) {
      Err(_) => "ERR\n"
      Ok(l) => "P " + t_list(l) + "\n" + ser_line(structured_fields::serialize_list(l))
    }
  } else if typ == "dictionary" {
    match structured_fields::parse_dictionary_fields(fields) {
      Err(_) => "ERR\n"
      Ok(d) => "P " + t_dict(d) + "\n" + ser_line(structured_fields::serialize_dictionary(d))
    }
  } else {
    match structured_fields::parse_item(join_lines(fields)) {
      Err(_) => "ERR\n"
      Ok(it) => "P " + t_item(it) + "\n" + ser_line(structured_fields::serialize_item(it))
    }
  }
}

// ----------------------------------------------------------------------------------- typed AST -> values

///|
struct Tp {
  s : String
  mut i : Int
}

///|
fn Tp::peek(self : Tp) -> Int {
  if self.i < self.s.length() {
    self.s.code_unit_at(self.i)
  } else {
    0
  }
}

///|
fn Tp::hexrun(self : Tp) -> String {
  let j = self.i
  while (self.peek() >= 48 && self.peek() <= 57) || (self.peek() >= 97 && self.peek() <= 102) {
    self.i = self.i + 1
  }
  self.s.slice(j, self.i)
}

///|
fn Tp::intrun(self : Tp) -> Int64 {
  let mut neg = false
  if self.peek() == 45 {
    neg = true
    self.i = self.i + 1
  }
  let mut v = 0L
  while self.peek() >= 48 && self.peek() <= 57 {
    v = v * 10L + (self.peek() - 48).to_int64()
    self.i = self.i + 1
  }
  if neg {
    -v
  } else {
    v
  }
}

///|
fn Tp::bare(self : Tp) -> structured_fields::BareItem {
  let c = self.peek()
  self.i = self.i + 1
  if c == 105 {
    structured_fields::BareItem::Integer(self.intrun())
  } else if c == 100 {
    structured_fields::BareItem::Decimal(structured_fields::Decimal::{ scaled_milli: self.intrun() })
  } else if c == 114 {
    // `r<value>e<scale>`: exact value * 10^-scale, rounded by Decimal::from_scaled_rounded (RFC 9651 4.1.5);
    // a value the constructor refuses becomes an out-of-range Decimal, which the serializer must refuse too
    let v = self.intrun()
    self.i = self.i + 1
    let sc = self.intrun().to_int()
    match structured_fields::Decimal::from_scaled_rounded(v, sc) {
      Ok(d) => structured_fields::BareItem::Decimal(d)
      Err(_) => structured_fields::BareItem::Decimal(structured_fields::Decimal::{ scaled_milli: 9000000000000000000L })
    }
  } else if c == 64 {
    structured_fields::BareItem::Date(self.intrun())
  } else if c == 63 {
    let v = self.peek() == 49
    self.i = self.i + 1
    structured_fields::BareItem::Boolean(v)
  } else if c == 115 {
    structured_fields::BareItem::String(unhex(self.hexrun()))
  } else if c == 116 {
    structured_fields::BareItem::Token(unhex(self.hexrun()))
  } else if c == 98 {
    structured_fields::BareItem::ByteSequence(unhex_bytes(self.hexrun()))
  } else {
    structured_fields::BareItem::DisplayString(unhex(self.hexrun()))
  }
}

///|
fn Tp::params(self : Tp) -> Array[structured_fields::Param] {
  let ps : Array[structured_fields::Param] = []
  while self.peek() == 59 {
    self.i = self.i + 1
    let k = unhex(self.hexrun())
    self.i = self.i + 1
    ps.push(structured_fields::Param::new(k, self.bare()))
  }
  ps
}

///|
fn Tp::item(self : Tp) -> structured_fields::Item {
  let b = self.bare()
  structured_fields::Item::new(b, self.params())
}

///|
fn Tp::entry(self : Tp) -> structured_fields::ListEntry {
  if self.peek() == 40 {
    self.i = self.i + 1
    let items : Array[structured_fields::Item] = []
    while self.peek() != 41 {
      if items.length() > 0 {
        self.i = self.i + 1
      }
      items.push(self.item())
    }
    self.i = self.i + 1
    let ps = self.params()
    structured_fields::ListEntry::InnerList(structured_fields::InnerList::new(items, ps))
  } else {
    structured_fields::ListEntry::Item(self.item())
  }
}

///| Build the hand-written AST (`typed` grammar) without any validation and serialize it.
pub fn ser_case(typ : String, typed : String) -> String {
  let p = Tp::{ s: typed, i: 0 }
  if typ == "item" {
    ser_line(structured_fields::serialize_item(p.item()))
  } else if typ == "list" {
    let l : Array[structured_fields::ListEntry] = []
    while p.i < typed.length() {
      if l.length() > 0 {
        p.i = p.i + 1
      }
      l.push(p.entry())
    }
    ser_line(structured_fields::serialize_list(l))
  } else {
    let d : Array[structured_fields::DictMember] = []
    while p.i < typed.length() {
      if d.length() > 0 {
        p.i = p.i + 1
      }
      let k = unhex(p.hexrun())
      p.i = p.i + 1
      d.push(structured_fields::DictMember::new(k, p.entry()))
    }
    ser_line(structured_fields::serialize_dictionary(d))
  }
}
