///| Comprehensive RFC 9651 (Structured Field Values for HTTP) specification,
///| security, DoS limit, and browser-helper test suite.

fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn expect_item_roundtrip(raw : String, canonical : String) -> Unit {
  match parse_item(raw) {
    Ok(item) =>
    match serialize_item(item) {
      Ok(out) =>
      debug_assert(
        out == canonical,
        "item canonical mismatch for `" + raw + "`: got `" + out + "`, want `" + canonical + "`",
      )
      Err(e) =>
      debug_assert(false, "serialize_item failed for `" + raw + "`: " + sfv_error_message(e))
    }
    Err(e) =>
    debug_assert(false, "parse_item failed for `" + raw + "`: " + sfv_error_message(e))
  }
}

fn expect_item_fail(raw : String) -> Unit {
  match parse_item(raw) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "expected parse_item to fail for `" + raw + "`")
  }
}

fn expect_list_roundtrip(raw : String, canonical : String) -> Unit {
  match parse_list(raw) {
    Ok(list) =>
    match serialize_list(list) {
      Ok(out) =>
      debug_assert(
        out == canonical,
        "list canonical mismatch for `" + raw + "`: got `" + out + "`, want `" + canonical + "`",
      )
      Err(e) =>
      debug_assert(false, "serialize_list failed for `" + raw + "`: " + sfv_error_message(e))
    }
    Err(e) =>
    debug_assert(false, "parse_list failed for `" + raw + "`: " + sfv_error_message(e))
  }
}

fn expect_list_fail(raw : String) -> Unit {
  match parse_list(raw) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "expected parse_list to fail for `" + raw + "`")
  }
}

fn expect_dict_roundtrip(raw : String, canonical : String) -> Unit {
  match parse_dictionary(raw) {
    Ok(dict) =>
    match serialize_dictionary(dict) {
      Ok(out) =>
      debug_assert(
        out == canonical,
        "dict canonical mismatch for `" + raw + "`: got `" + out + "`, want `" + canonical + "`",
      )
      Err(e) =>
      debug_assert(
        false,
        "serialize_dictionary failed for `" + raw + "`: " + sfv_error_message(e),
      )
    }
    Err(e) =>
    debug_assert(false, "parse_dictionary failed for `" + raw + "`: " + sfv_error_message(e))
  }
}

fn expect_dict_fail(raw : String) -> Unit {
  match parse_dictionary(raw) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "expected parse_dictionary to fail for `" + raw + "`")
  }
}

// 1. Integers (RFC 9651 §3.3.1)
test "rfc9651_integers_valid_and_boundaries" {
  expect_item_roundtrip("42", "42")
  expect_item_roundtrip("0", "0")
  expect_item_roundtrip("-0", "0")
  expect_item_roundtrip("-42", "-42")
  expect_item_roundtrip("042", "42")
  expect_item_roundtrip("-042", "-42")
  expect_item_roundtrip("000000000000001", "1")
  expect_item_roundtrip("-000000000000001", "-1")
  expect_item_roundtrip("999999999999999", "999999999999999")
  expect_item_roundtrip("-999999999999999", "-999999999999999")
  match parse_item("999999999999999") {
    Ok(it) =>
    match it.value {
      BareItem::Integer(v) => debug_assert(v == 999999999999999L, "max int")
      _ => debug_assert(false, "expected Integer")
    }
    Err(_) => debug_assert(false, "max int parse failed")
  }
}

test "rfc9651_integers_invalid" {
  expect_item_fail("+42")
  expect_item_fail("-")
  expect_item_fail("--0")
  expect_item_fail("- 42")
  expect_item_fail("-a23")
  expect_item_fail("4-2")
  expect_item_fail("1000000000000000")
  expect_item_fail("-1000000000000000")
  expect_item_fail("0000000000000001")
  expect_item_fail("-0000000000000001")
  expect_item_fail("2,3")
}

// 2. Decimals (RFC 9651 §3.3.2 — exact Int64 scaled_milli, zero floating point)
test "rfc9651_decimals_valid_and_canonical" {
  expect_item_roundtrip("1.23", "1.23")
  expect_item_roundtrip("-1.23", "-1.23")
  expect_item_roundtrip("0.0", "0.0")
  expect_item_roundtrip("-0.0", "0.0")
  expect_item_roundtrip("-0.000", "0.0")
  expect_item_roundtrip("1.20", "1.2")
  expect_item_roundtrip("1.200", "1.2")
  expect_item_roundtrip("1.230", "1.23")
  expect_item_roundtrip("1.000", "1.0")
  expect_item_roundtrip("0.005", "0.005")
  expect_item_roundtrip("-0.05", "-0.05")
  expect_item_roundtrip("999999999999.999", "999999999999.999")
  expect_item_roundtrip("-999999999999.999", "-999999999999.999")
  match parse_item("123456789012.1") {
    Ok(it) =>
    match it.value {
      BareItem::Decimal(d) =>
      debug_assert(d.scaled_milli == 123456789012100L, "exact scaled_milli")
      _ => debug_assert(false, "expected Decimal")
    }
    Err(_) => debug_assert(false, "tricky precision decimal failed")
  }
}

test "rfc9651_decimals_invalid" {
  expect_item_fail("1.")
  expect_item_fail("-1.")
  expect_item_fail(".5")
  expect_item_fail("-.5")
  expect_item_fail("1.1234")
  expect_item_fail("-1.1234")
  expect_item_fail("1234567890123.0")
  expect_item_fail("-1234567890123.0")
  expect_item_fail("1. 23")
  expect_item_fail("1 .23")
  expect_item_fail("1.5.4")
  expect_item_fail("1..4")
}

test "rfc9651_decimal_round_half_to_even" {
  // 1.0005 -> 1.000 (even)
  match Decimal::from_scaled_rounded(10005L, 4) {
    Ok(d) => debug_assert(d.scaled_milli == 1000L && d.to_sfv_string() == "1.0", "1.0005 -> 1.0")
    Err(_) => debug_assert(false, "1.0005 failed")
  }
  // 1.0015 -> 1.002 (even)
  match Decimal::from_scaled_rounded(10015L, 4) {
    Ok(d) => debug_assert(d.scaled_milli == 1002L && d.to_sfv_string() == "1.002", "1.0015 -> 1.002")
    Err(_) => debug_assert(false, "1.0015 failed")
  }
  // 1.0025 -> 1.002 (even)
  match Decimal::from_scaled_rounded(10025L, 4) {
    Ok(d) => debug_assert(d.scaled_milli == 1002L, "1.0025 -> 1.002")
    Err(_) => debug_assert(false, "1.0025 failed")
  }
  // -1.0015 -> -1.002 (even)
  match Decimal::from_scaled_rounded(-10015L, 4) {
    Ok(d) => debug_assert(d.scaled_milli == -1002L && d.to_sfv_string() == "-1.002", "-1.0015 -> -1.002")
    Err(_) => debug_assert(false, "-1.0015 failed")
  }
  // -0.0004 -> 0.0 (no negative zero)
  match Decimal::from_scaled_rounded(-4L, 4) {
    Ok(d) => debug_assert(d.scaled_milli == 0L && d.to_sfv_string() == "0.0", "-0.0004 -> 0.0")
    Err(_) => debug_assert(false, "-0.0004 failed")
  }
  // Overflow after rounding: 999999999999.9999 -> Err
  match Decimal::from_scaled_rounded(9999999999999999L, 4) {
    Err(SfvError::InvalidNumber(_)) => ()
    _ => debug_assert(false, "rounding overflow should fail")
  }
}

// 3. Strings (RFC 9651 §3.3.3)
test "rfc9651_strings_valid_and_invalid" {
  expect_item_roundtrip("\"hello world\"", "\"hello world\"")
  expect_item_roundtrip("\"\"", "\"\"")
  expect_item_roundtrip("\"a\\\"b\\\\c\"", "\"a\\\"b\\\\c\"")
  match parse_item("\"a\\\"b\\\\c\"") {
    Ok(it) =>
    match it.value {
      BareItem::String(s) => debug_assert(s == "a\"b\\c", "unescaped string")
      _ => debug_assert(false, "expected String")
    }
    Err(_) => debug_assert(false, "escaped string failed")
  }
  // Invalid strings
  expect_item_fail("\"unterminated")
  expect_item_fail("\"bad\\escape\"")
  expect_item_fail("\"trailing\\")
  expect_item_fail("\"tab\there\"")
  expect_item_fail("\"nl\nhere\"")
  expect_item_fail("\"non-ascii: \u{00e9}\"")
}

// 4. Tokens (RFC 9651 §3.3.4)
test "rfc9651_tokens_valid_and_invalid" {
  expect_item_roundtrip("foo123/456", "foo123/456")
  expect_item_roundtrip("*foo:bar/baz!#$%&'*+-.^_`|~", "*foo:bar/baz!#$%&'*+-.^_`|~")
  expect_item_roundtrip("Foo", "Foo")
  expect_item_roundtrip("*", "*")
  // Invalid tokens
  expect_item_fail("!foo")
  expect_item_fail("/foo")
  expect_item_fail("foo bar")
  expect_item_fail("foo@bar")
}

// 5. Byte Sequences (RFC 9651 §3.3.5)
test "rfc9651_byte_sequences_valid_and_invalid" {
  expect_item_roundtrip(":aGVsbG8=:", ":aGVsbG8=:")
  expect_item_roundtrip("::", "::")
  expect_item_roundtrip(":/+Ah:", ":/+Ah:")
  match parse_item(":aGVsbG8=:") {
    Ok(it) =>
    match it.value {
      BareItem::ByteSequence(b) => debug_assert(bytes_eq(b, "hello".to_bytes()), "decoded hello")
      _ => debug_assert(false, "expected ByteSequence")
    }
    Err(_) => debug_assert(false, "byte sequence failed")
  }
  // Invalid byte sequences
  expect_item_fail(":=aGVsbG8=:")
  expect_item_fail(":a=GVsbG8=:")
  expect_item_fail(":aGVsbG8.:")
  expect_item_fail(":aGVsbG8=")
  expect_item_fail(":aGVsb G8=:")
  expect_item_fail(":    :")
  expect_item_fail(":aGVsbG!8=:")
  expect_item_fail(":_-Ah:")
  expect_item_fail(":")
}

// 6. Booleans (RFC 9651 §3.3.6)
test "rfc9651_booleans_valid_and_invalid" {
  expect_item_roundtrip("?1", "?1")
  expect_item_roundtrip("?0", "?0")
  expect_item_fail("?")
  expect_item_fail("?true")
  expect_item_fail("?false")
  expect_item_fail("?2")
  expect_item_fail("? 1")
}

// 7. Dates (RFC 9651 §3.3.7)
test "rfc9651_dates_valid_and_invalid" {
  expect_item_roundtrip("@0", "@0")
  expect_item_roundtrip("@-0", "@0")
  expect_item_roundtrip("@1659578233", "@1659578233")
  expect_item_roundtrip("@-1659578233", "@-1659578233")
  expect_item_roundtrip("@999999999999999", "@999999999999999")
  expect_item_roundtrip("@-999999999999999", "@-999999999999999")
  // Invalid dates
  expect_item_fail("@1659578233.12")
  expect_item_fail("@1000000000000000")
  expect_item_fail("@-1000000000000000")
  expect_item_fail("@")
  expect_item_fail("@-")
  expect_item_fail("@ 12345")
  expect_item_fail("@abc")
}

// 8. Display Strings (RFC 9651 §3.3.8)
test "rfc9651_display_strings_valid_and_invalid" {
  expect_item_roundtrip("%\"foo bar\"", "%\"foo bar\"")
  expect_item_roundtrip("%\"f%c3%bc%c3%bc\"", "%\"f%c3%bc%c3%bc\"")
  expect_item_roundtrip("%\"%0a\"", "%\"%0a\"")
  expect_item_roundtrip("%\"%1f\"", "%\"%1f\"")
  expect_item_roundtrip("%\"%7f\"", "%\"%7f\"")
  expect_item_roundtrip("%\"%61\"", "%\"a\"")
  expect_item_roundtrip("%\"foo %22bar%22 \\ baz\"", "%\"foo %22bar%22 \\ baz\"")
  match parse_item("%\"f%c3%bc%c3%bc\"") {
    Ok(it) =>
    match it.value {
      BareItem::DisplayString(s) => debug_assert(s == "füü", "decoded utf-8 display string")
      _ => debug_assert(false, "expected DisplayString")
    }
    Err(_) => debug_assert(false, "display string failed")
  }
  // Invalid display strings
  expect_item_fail("%\"f%C3%BC%C3%BC\"")
  expect_item_fail("%\"füü\"")
  expect_item_fail("%\"\t\"")
  expect_item_fail("%\"\n\"")
  expect_item_fail("%'foo'")
  expect_item_fail("%foo")
  expect_item_fail("%\"foo")
  expect_item_fail("%\"%\"")
  expect_item_fail("%\"%a\"")
  expect_item_fail("%\"%g0\"")
  expect_item_fail("%\"%c3%28\"")
  expect_item_fail("%\"%a0%a1\"")
  expect_item_fail("%\"%e2%28%a1\"")
  expect_item_fail("%\"%f0%28%8c%28\"")
  // Surrogate U+D800 (%ed%a0%80)
  expect_item_fail("%\"%ed%a0%80\"")
  // Overlong NUL (%c0%80)
  expect_item_fail("%\"%c0%80\"")
}

// 9. Lists & Inner Lists (RFC 9651 §3.1)
test "rfc9651_lists_and_inner_lists" {
  expect_list_roundtrip("", "")
  expect_list_roundtrip("   ", "")
  expect_list_roundtrip("sugar, tea, rum", "sugar, tea, rum")
  expect_list_roundtrip("(\"foo\" \"bar\"), (\"baz\"), (\"bat\" \"one\"), ()", "(\"foo\" \"bar\"), (\"baz\"), (\"bat\" \"one\"), ()")
  expect_list_roundtrip("(\"foo\";a=1;b=2);lvl=5, (\"bar\" \"baz\");lvl=1", "(\"foo\";a=1;b=2);lvl=5, (\"bar\" \"baz\");lvl=1")
  expect_list_roundtrip("a,\tb", "a, b")
  // Invalid lists
  expect_list_fail("a,")
  expect_list_fail("a, ")
  expect_list_fail(",a")
  expect_list_fail("a,,b")
  expect_list_fail("(a\tb)")
  expect_list_fail("(a b")
  expect_list_fail("\ta")
  // Trailing OWS (SP / HTAB) after a List is accepted per RFC 9651 §4.2.1
  expect_list_roundtrip("a\t", "a")
  expect_list_roundtrip("a \t", "a")
  expect_list_roundtrip("1, (2 3)\t", "1, (2 3)")
}

// 10. Dictionaries & Duplicate Key Overwrite Semantics (RFC 9651 §3.2 / §4.2.2)
test "rfc9651_dictionary_and_duplicate_key_overwrite" {
  expect_dict_roundtrip("", "")
  expect_dict_roundtrip("   ", "")
  expect_dict_roundtrip("en=\"Applepie\", da=:w4ZibGV0w6ZydGU=:", "en=\"Applepie\", da=:w4ZibGV0w6ZydGU=:")
  expect_dict_roundtrip("a=?0, b, c;foo=bar", "a=?0, b, c;foo=bar")
  expect_dict_roundtrip("a=?1, b=?1;x=2", "a, b;x=2")
  // Duplicate keys overwrite value in-place, preserving first-seen key order!
  expect_dict_roundtrip("a=1, b=2, a=3", "a=3, b=2")
  expect_dict_roundtrip("a=1;x=1;x=2, b=2;y=?1", "a=1;x=2, b=2;y")
  // Invalid dictionaries
  expect_dict_fail("A=1")
  expect_dict_fail("a=1,")
  expect_dict_fail("=1")
  expect_dict_fail("a=1,,b=2")
}

// 11. Multi-header field line joining
test "rfc9651_multi_header_fields" {
  match parse_list_fields(["a, b", "c;x=1"]) {
    Ok(list) =>
    match serialize_list(list) {
      Ok(out) => debug_assert(out == "a, b, c;x=1", "multi-line list: " + out)
      Err(_) => debug_assert(false, "serialize multi-line list failed")
    }
    Err(e) => debug_assert(false, "parse_list_fields failed: " + sfv_error_message(e))
  }
  match parse_dictionary_fields(["a=1, b=2", "a=9, c"]) {
    Ok(dict) =>
    match serialize_dictionary(dict) {
      Ok(out) => debug_assert(out == "a=9, b=2, c", "multi-line dict: " + out)
      Err(_) => debug_assert(false, "serialize multi-line dict failed")
    }
    Err(e) => debug_assert(false, "parse_dictionary_fields failed: " + sfv_error_message(e))
  }
  // Empty array -> empty
  match parse_list_fields([]) {
    Ok(list) => debug_assert(list.length() == 0, "empty list fields")
    Err(_) => debug_assert(false, "empty list fields failed")
  }
  // Trailing empty line -> trailing comma -> MUST FAIL
  match parse_list_fields(["a", ""]) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "trailing empty field line must fail")
  }
}

// 12. Strict whitespace & trailing data checks
test "rfc9651_strict_whitespace_and_trailing" {
  expect_item_roundtrip("   42   ", "42")
  expect_item_fail("")
  expect_item_fail("   ")
  expect_item_fail("\t42")
  expect_item_fail("42\t")
  expect_item_fail("42\r\n")
  expect_item_fail("42\n")
  expect_item_fail("42 43")
  expect_item_fail("42;A=1")
  expect_item_fail("42;\ta=1")
}

// 13. Serializer strict validation (anti-injection, range & charset guards)
test "rfc9651_serializer_rejects_invalid_values" {
  // Integer out of range
  match serialize_item(Item::bare(BareItem::Integer(1000000000000000L))) {
    Err(SfvError::InvalidNumber(_)) => ()
    _ => debug_assert(false, "should reject integer > max")
  }
  match serialize_item(Item::bare(BareItem::Integer(-1000000000000000L))) {
    Err(SfvError::InvalidNumber(_)) => ()
    _ => debug_assert(false, "should reject integer < min")
  }
  // Date out of range
  match serialize_item(Item::bare(BareItem::Date(1000000000000000L))) {
    Err(SfvError::InvalidDate(_)) => ()
    _ => debug_assert(false, "should reject date > max")
  }
  // String with CRLF injection
  match serialize_item(Item::bare(BareItem::String("ok\r\nX-Injected: 1"))) {
    Err(SfvError::InvalidString(_)) => ()
    _ => debug_assert(false, "should reject CRLF in String")
  }
  // Token with space / empty / invalid first char
  match serialize_item(Item::bare(BareItem::Token(""))) {
    Err(SfvError::InvalidToken(_)) => ()
    _ => debug_assert(false, "should reject empty token")
  }
  match serialize_item(Item::bare(BareItem::Token("1abc"))) {
    Err(SfvError::InvalidToken(_)) => ()
    _ => debug_assert(false, "should reject digit-leading token")
  }
  match serialize_item(Item::bare(BareItem::Token("foo bar"))) {
    Err(SfvError::InvalidToken(_)) => ()
    _ => debug_assert(false, "should reject space in token")
  }
  // Invalid parameter key (uppercase / CRLF)
  match serialize_item(Item::new(BareItem::Integer(1L), [Param::new("BadKey", BareItem::Integer(2L))])) {
    Err(SfvError::InvalidKey(_)) => ()
    _ => debug_assert(false, "should reject uppercase param key")
  }
  // Invalid dictionary key
  match serialize_dictionary([DictMember::new("a\r\nb", ListEntry::Item(Item::bare(BareItem::Integer(1L))))]) {
    Err(SfvError::InvalidKey(_)) => ()
    _ => debug_assert(false, "should reject CRLF in dict key")
  }
}

// 14. SfvLimits negative, zero, and overflow guards
test "rfc9651_limits_negative_zero_and_bounds" {
  let neg = SfvLimits::new(-1, 10, 10, 10, 10, 10, 10)
  match parse_item_with_limits("1", neg) {
    Err(SfvError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "negative limit must fail")
  }
  let zero_list = SfvLimits::new(1024, 0, 10, 10, 10, 1024, 1024)
  match parse_list_with_limits("", zero_list) {
    Ok(l) => debug_assert(l.length() == 0, "empty list allowed with max_list_members=0")
    Err(_) => debug_assert(false, "empty list should pass with max_list_members=0")
  }
  match parse_list_with_limits("a", zero_list) {
    Err(SfvError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "1-item list must fail with max_list_members=0")
  }
  let small_out = SfvLimits::new(1024, 10, 10, 10, 10, 1024, 4)
  match serialize_item_with_limits(Item::bare(BareItem::String("hello")), small_out) {
    Err(SfvError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "output exceeding max_output_bytes must fail")
  }
  let small_str = SfvLimits::new(1024, 10, 10, 10, 10, 3, 1024)
  match parse_item_with_limits("\"abcd\"", small_str) {
    Err(SfvError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "string exceeding max_string_bytes must fail")
  }
}

// 15. O(1) duplicate dictionary/parameter key protection (10,000 keys)
test "rfc9651_dos_10000_dict_keys_o1" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 10000 {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string("k")
    sb.write_string(i.to_string())
    sb.write_string("=")
    sb.write_string(i.to_string())
    i = i + 1
  }
  let big_limits = SfvLimits::new(262144, 16384, 256, 16384, 256, 16384, 262144)
  match parse_dictionary_with_limits(sb.to_string(), big_limits) {
    Ok(dict) => debug_assert(dict.length() == 10000, "10000 distinct keys")
    Err(e) => debug_assert(false, "10000 keys failed: " + sfv_error_message(e))
  }
}

// 16. Browser Helpers: RFC 9218 Priority & W3C Permissions-Policy
test "rfc9651_browser_helpers_priority_and_permissions_policy" {
  match parse_priority("u=1, i") {
    Ok(p) => {
      debug_assert(p.urgency == 1 && p.incremental, "u=1, i")
      match serialize_priority(p) {
        Ok(s) => debug_assert(s == "u=1, i", "serialize priority: " + s)
        Err(_) => debug_assert(false, "serialize priority failed")
      }
    }
    Err(e) => debug_assert(false, "parse_priority failed: " + sfv_error_message(e))
  }
  match parse_priority("") {
    Ok(p) => debug_assert(p.urgency == 3 && !p.incremental, "default priority")
    Err(_) => debug_assert(false, "empty priority failed")
  }
  match parse_priority("u=99, i=1, unknown=foo") {
    Ok(p) => debug_assert(p.urgency == 3 && !p.incremental, "invalid priority params ignored per RFC 9218")
    Err(_) => debug_assert(false, "RFC 9218 unknown/out-of-range should be ignored")
  }
  match serialize_priority(Priority::{ urgency: 8, incremental: false }) {
    Err(SfvError::InvalidNumber(_)) => ()
    _ => debug_assert(false, "urgency 8 must fail serialization")
  }
  match parse_permissions_policy("geolocation=(self \"https://example.com\"), camera=(), fullscreen=*") {
    Ok(dirs) => {
      debug_assert(dirs.length() == 3, "3 permissions directives")
      debug_assert(dirs[0].feature == "geolocation" && dirs[0].allow_self && dirs[0].origins.length() == 1, "geolocation")
      debug_assert(dirs[1].feature == "camera" && !dirs[1].allow_self && !dirs[1].allow_all && dirs[1].origins.length() == 0, "camera")
      debug_assert(dirs[2].feature == "fullscreen" && dirs[2].allow_all, "fullscreen=*")
    }
    Err(e) => debug_assert(false, "parse_permissions_policy failed: " + sfv_error_message(e))
  }
}

// 17. Decimal constructors and extreme scale_pow10 edge cases
test "rfc9651_decimal_constructors_and_scales" {
  match Decimal::from_integer(123L) {
    Ok(d) => debug_assert(d.to_scaled_milli() == 123000L && d.to_sfv_string() == "123.0", "from_integer")
    Err(_) => debug_assert(false, "from_integer failed")
  }
  match Decimal::from_integer(1000000000000L) {
    Err(SfvError::InvalidNumber(_)) => ()
    _ => debug_assert(false, "13-digit integer must fail Decimal::from_integer")
  }
  match Decimal::from_scaled_milli(0L) {
    Ok(d) => debug_assert(d.is_zero() && !d.is_negative(), "zero checks")
    Err(_) => debug_assert(false, "zero failed")
  }
  match Decimal::from_scaled_rounded(12L, 1) {
    Ok(d) => debug_assert(d.to_scaled_milli() == 1200L && d.to_sfv_string() == "1.2", "scale 1")
    Err(_) => debug_assert(false, "scale 1 failed")
  }
  match Decimal::from_scaled_rounded(5000000000000000001L, 22) {
    Ok(d) => debug_assert(d.to_scaled_milli() == 1L, "shift=19 > half rounds to 1")
    Err(_) => debug_assert(false, "shift=19 failed")
  }
  match Decimal::from_scaled_rounded(5000000000000000000L, 22) {
    Ok(d) => debug_assert(d.to_scaled_milli() == 0L, "shift=19 == half rounds to even 0")
    Err(_) => debug_assert(false, "shift=19 even failed")
  }
  match Decimal::from_scaled_rounded(9000000000000000000L, 25) {
    Ok(d) => debug_assert(d.to_scaled_milli() == 0L, "shift>=20 rounds to 0")
    Err(_) => debug_assert(false, "shift>=20 failed")
  }
  match Decimal::from_scaled_rounded(1L, -1) {
    Err(SfvError::InvalidNumber(_)) => ()
    _ => debug_assert(false, "negative scale must fail")
  }
}

// 18. Byte sequence forgiving Base64 padding & canonical re-serialization
test "rfc9651_byte_sequence_forgiving_padding" {
  expect_item_roundtrip(":aGVsbG8:", ":aGVsbG8=:")
  expect_item_roundtrip(":iZ==:", ":iQ==:")
  expect_item_roundtrip(":uuueGVsbG8=:", ":uuueGVsbGw==:")
  // Excess padding beyond 4-char quantum rejected (aligned with Rust sfv 0.16.1)
  expect_item_fail(":aGVsbG8==:")
  expect_item_fail(":A:")
  expect_item_fail(":A===:")
}

// 19. Display String UTF-8 1/2/3/4-byte, BOM, overlong & surrogate rejection
test "rfc9651_display_string_utf8_boundaries" {
  // 4-byte UTF-8 emoji U+1F600 (😀 = F0 9F 98 80)
  expect_item_roundtrip("%\"%f0%9f%98%80\"", "%\"%f0%9f%98%80\"")
  // 3-byte CJK 中文 (E4 B8 AD E6 96 87)
  expect_item_roundtrip("%\"%e4%b8%ad%e6%96%87\"", "%\"%e4%b8%ad%e6%96%87\"")
  // BOM U+FEFF
  expect_item_roundtrip("%\"BOM: %ef%bb%bf\"", "%\"BOM: %ef%bb%bf\"")
  // Percent & quote escaping on serialize
  match serialize_bare_item(BareItem::DisplayString("100% \"ok\"\n")) {
    Ok(out) => debug_assert(out == "%\"100%25 %22ok%22%0a\"", "display string escape: " + out)
    Err(_) => debug_assert(false, "display string serialize failed")
  }
  // Overlong 3-byte (E0 80 80), 4-byte (F0 80 80 80), > U+10FFFF (F4 90 80 80), surrogate U+DFFF (ED BF BF)
  expect_item_fail("%\"%e0%80%80\"")
  expect_item_fail("%\"%f0%80%80%80\"")
  expect_item_fail("%\"%f4%90%80%80\"")
  expect_item_fail("%\"%ed%bf%bf\"")
  // Truncated multi-byte UTF-8
  expect_item_fail("%\"%c3\"")
  expect_item_fail("%\"%e4%b8\"")
  expect_item_fail("%\"%f0%9f%98\"")
}

// 20. Parameters duplicate overwrite & lazy Map transition (>= 8 params)
test "rfc9651_parameters_duplicate_overwrite_and_many_params" {
  let sb = StringBuilder::new()
  sb.write_string("tok")
  let mut i = 0
  while i < 32 {
    sb.write_string(";p")
    sb.write_string(i.to_string())
    sb.write_string("=")
    sb.write_string(i.to_string())
    i = i + 1
  }
  // Overwrite p0 and p15
  sb.write_string(";p0=999;p15=?1")
  match parse_item(sb.to_string()) {
    Ok(it) => {
      debug_assert(it.params.length() == 32, "32 unique params")
      debug_assert(it.params[0].key == "p0", "p0 stayed at index 0")
      match get_param(it.params, "p0") {
        Some(BareItem::Integer(v)) => debug_assert(v == 999L, "p0 overwritten to 999")
        _ => debug_assert(false, "p0 missing")
      }
      match get_param(it.params, "p15") {
        Some(BareItem::Boolean(true)) => ()
        _ => debug_assert(false, "p15 overwritten to true")
      }
    }
    Err(e) => debug_assert(false, "many params failed: " + sfv_error_message(e))
  }
}

// 21. Inner list edge cases & max_inner_list_items limit
test "rfc9651_inner_list_edge_cases_and_limits" {
  expect_list_roundtrip("()", "()")
  expect_list_roundtrip("(  1   2  );a=1", "(1 2);a=1")
  expect_list_fail("((1))")
  expect_list_fail("(1, 2)")
  expect_list_fail("(1;a=1 2;b=2")
  let lim0 = SfvLimits::new(1024, 10, 0, 10, 10, 1024, 1024)
  match parse_list_with_limits("()", lim0) {
    Ok(l) => debug_assert(l.length() == 1, "empty inner list ok with max_inner_list_items=0")
    Err(_) => debug_assert(false, "empty inner list should pass with limit 0")
  }
  match parse_list_with_limits("(1)", lim0) {
    Err(SfvError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "1-item inner list must fail with limit 0")
  }
}

// 22. All 7 SfvLimits fields negative & zero enforcement
test "rfc9651_all_seven_limits_negative_and_zero" {
  let bad_limits = [
    SfvLimits::new(-1, 10, 10, 10, 10, 10, 10),
    SfvLimits::new(10, -1, 10, 10, 10, 10, 10),
    SfvLimits::new(10, 10, -1, 10, 10, 10, 10),
    SfvLimits::new(10, 10, 10, -1, 10, 10, 10),
    SfvLimits::new(10, 10, 10, 10, -1, 10, 10),
    SfvLimits::new(10, 10, 10, 10, 10, -1, 10),
    SfvLimits::new(10, 10, 10, 10, 10, 10, -1),
  ]
  let mut i = 0
  while i < bad_limits.length() {
    match parse_item_with_limits("1", bad_limits[i]) {
      Err(SfvError::LimitExceeded(_)) => ()
      _ => debug_assert(false, "parse must reject negative limit")
    }
    match serialize_item_with_limits(Item::bare(BareItem::Integer(1L)), bad_limits[i]) {
      Err(SfvError::LimitExceeded(_)) => ()
      _ => debug_assert(false, "serialize must reject negative limit")
    }
    i = i + 1
  }
  // max_dict_members = 0
  let zero_dict = SfvLimits::new(1024, 10, 10, 0, 10, 1024, 1024)
  match parse_dictionary_with_limits("a=1", zero_dict) {
    Err(SfvError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "dict must fail with max_dict_members=0")
  }
  // max_params = 0
  let zero_params = SfvLimits::new(1024, 10, 10, 10, 0, 1024, 1024)
  match parse_item_with_limits("1;a=2", zero_params) {
    Err(SfvError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "params must fail with max_params=0")
  }
  // max_input_bytes = 0
  let zero_in = SfvLimits::new(0, 10, 10, 10, 10, 1024, 1024)
  match parse_list_with_limits("", zero_in) {
    Ok(l) => debug_assert(l.length() == 0, "empty input ok with max_input_bytes=0")
    Err(_) => debug_assert(false, "empty list should pass with max_input_bytes=0")
  }
  match parse_list_with_limits("a", zero_in) {
    Err(SfvError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "non-empty input must fail with max_input_bytes=0")
  }
}

// 23. Real-world browser HTTP Structured Field headers
test "rfc9651_real_world_browser_headers" {
  // Sec-CH-UA (List)
  expect_list_roundtrip(
    "\"Chromium\";v=\"131\", \"Not_A Brand\";v=\"24\"",
    "\"Chromium\";v=\"131\", \"Not_A Brand\";v=\"24\"",
  )
  // Cache-Status (RFC 9211 List)
  expect_list_roundtrip(
    "OriginCache; hit; ttl=1105, \"CDN\"; fwd=uri-miss; stored",
    "OriginCache;hit;ttl=1105, \"CDN\";fwd=uri-miss;stored",
  )
  // Content-Digest (RFC 9530 Dictionary)
  expect_dict_roundtrip(
    "sha-256=:X48E9qOokqqrvdts8nOJRJN3OWDUoyWxBf7kbu9DBPE=:",
    "sha-256=:X48E9qOokqqrvdts8nOJRJN3OWDUoyWxBf7kbu9DBPE=:",
  )
  // Signature-Input (RFC 9421 Dictionary with Inner List)
  expect_dict_roundtrip(
    "sig1=(\"@method\" \"@authority\" \"content-digest\");created=1618884473;keyid=\"test-key-rsa-pss\"",
    "sig1=(\"@method\" \"@authority\" \"content-digest\");created=1618884473;keyid=\"test-key-rsa-pss\"",
  )
}

// 24. Lookup helpers, key/token validators, and error message coverage
test "rfc9651_helpers_and_validators" {
  debug_assert(is_valid_key("abc_1-2.3*"), "valid key")
  debug_assert(is_valid_key("*"), "star key")
  debug_assert(!is_valid_key(""), "empty key")
  debug_assert(!is_valid_key("Abc"), "upper key")
  debug_assert(!is_valid_key("1abc"), "digit-start key")

  debug_assert(is_valid_token("foo/bar:baz"), "valid token")
  debug_assert(is_valid_token("*"), "star token")
  debug_assert(!is_valid_token(""), "empty token")
  debug_assert(!is_valid_token("foo;bar"), "semicolon in token")

  match parse_dictionary("a=1, b=(2 3)") {
    Ok(d) => {
      match get_dict_member(d, "a") {
        Some(ListEntry::Item(_)) => ()
        _ => debug_assert(false, "get_dict_member a failed")
      }
      match get_dict_member(d, "missing") {
        None => ()
        _ => debug_assert(false, "missing key must return None")
      }
    }
    Err(_) => debug_assert(false, "dict parse failed")
  }
  debug_assert(sfv_error_message(SfvError::TrailingData("x")).length() > 0, "error message")
}

// 25. Dictionary whitespace, trailing OWS vs leading HTAB, and multi-field edges
test "rfc9651_dictionary_whitespace_and_multi_field_edges" {
  expect_dict_roundtrip("a=1,\tb=2", "a=1, b=2")
  expect_dict_roundtrip("a=1\t", "a=1")
  expect_dict_roundtrip("u=1, i\t", "u=1, i")
  expect_dict_fail("\ta=1")
  expect_dict_fail("a=1\r\n")
  match parse_dictionary_fields([]) {
    Ok(d) => debug_assert(d.length() == 0, "empty dict fields")
    Err(_) => debug_assert(false, "empty dict fields failed")
  }
  match parse_dictionary_fields(["a=1", ""]) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "trailing empty dict field line must fail")
  }
}

// 26. P2-1 regression: List/Dictionary accept trailing HTAB (OWS), Item rejects trailing HTAB
test "rfc9651_p2_1_trailing_htab_list_dict_vs_item" {
  expect_list_roundtrip("a\t", "a")
  expect_list_roundtrip("a \t", "a")
  expect_dict_roundtrip("u=1, i\t", "u=1, i")
  match parse_permissions_policy("geolocation=()\t") {
    Ok(dirs) => debug_assert(dirs.length() == 1 && dirs[0].feature == "geolocation", "permissions_policy trailing HTAB")
    Err(e) => debug_assert(false, "permissions_policy trailing HTAB failed: " + sfv_error_message(e))
  }
  // Item still rejects trailing HTAB, and all types reject leading HTAB
  expect_item_fail("1\t")
  expect_item_fail("\t1")
  expect_list_fail("\ta")
  expect_dict_fail("\ta=1")
}

// 27. P2-2 regression: Serializer rejects hand-built duplicate dictionary & parameter keys
test "rfc9651_p2_2_serializer_rejects_duplicate_keys" {
  // Small dictionary duplicate (<= 8 fast path)
  match serialize_dictionary([
    DictMember::new("a", ListEntry::Item(Item::bare(BareItem::Integer(1L)))),
    DictMember::new("a", ListEntry::Item(Item::bare(BareItem::Integer(2L)))),
  ]) {
    Err(SfvError::InvalidKey(_)) => ()
    _ => debug_assert(false, "serialize_dictionary must reject duplicate key")
  }
  // Large dictionary duplicate (> 8 Map path)
  let big_dict : Array[DictMember] = []
  let mut i = 0
  while i < 12 {
    big_dict.push(DictMember::new("k" + i.to_string(), ListEntry::Item(Item::bare(BareItem::Integer(i.to_int64())))))
    i = i + 1
  }
  big_dict.push(DictMember::new("k3", ListEntry::Item(Item::bare(BareItem::Integer(99L)))))
  match serialize_dictionary(big_dict) {
    Err(SfvError::InvalidKey(_)) => ()
    _ => debug_assert(false, "serialize_dictionary (>8) must reject duplicate key")
  }
  // Small item duplicate param (<= 8 fast path)
  match serialize_item(
    Item::new(
      BareItem::Integer(1L),
      [Param::new("x", BareItem::Integer(1L)), Param::new("x", BareItem::Integer(2L))],
    ),
  ) {
    Err(SfvError::InvalidKey(_)) => ()
    _ => debug_assert(false, "serialize_item must reject duplicate param")
  }
  // Large item duplicate param (> 8 Map path)
  let big_params : Array[Param] = []
  let mut j = 0
  while j < 12 {
    big_params.push(Param::new("p" + j.to_string(), BareItem::Integer(j.to_int64())))
    j = j + 1
  }
  big_params.push(Param::new("p5", BareItem::Boolean(true)))
  match serialize_item(Item::new(BareItem::Integer(1L), big_params)) {
    Err(SfvError::InvalidKey(_)) => ()
    _ => debug_assert(false, "serialize_item (>8) must reject duplicate param")
  }
  // InnerList duplicate param
  match serialize_list([
    ListEntry::InnerList(
      InnerList::new([], [Param::new("a", BareItem::Integer(1L)), Param::new("a", BareItem::Integer(2L))]),
    ),
  ]) {
    Err(SfvError::InvalidKey(_)) => ()
    _ => debug_assert(false, "serialize_list inner list must reject duplicate param")
  }
}
