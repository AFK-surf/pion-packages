///| RFC 9651 §4.1 Structured Field Values serializer.
///| Strictly validates every value, key, range, charset, and UTF-8 invariant before
///| emitting output, and enforces `SfvLimits.max_output_bytes` incrementally.

struct Serializer {
  sb : StringBuilder
  mut written : Int
  max_output_bytes : Int
  limits : SfvLimits
  mut err : Option[SfvError]
}

fn Serializer::new_with_cap(limits : SfvLimits, cap : Int) -> Serializer {
  let c = if cap > limits.max_output_bytes {
    limits.max_output_bytes
  } else {
    cap
  }
  let init_cap = if c < 0 { 0 } else { c }
  Serializer::{
    sb: StringBuilder::with_capacity(init_cap),
    written: 0,
    max_output_bytes: limits.max_output_bytes,
    limits: limits,
    err: None,
  }
}

fn Serializer::fail(self : Serializer, e : SfvError) -> Bool {
  self.err = Some(e)
  false
}

fn Serializer::take_err(self : Serializer) -> SfvError {
  match self.err {
    Some(e) => e
    None => SfvError::InvalidSyntax("unexpected serializer error")
  }
}

fn Serializer::write_byte_raw(self : Serializer, b : Byte) -> Bool {
  if self.written >= self.max_output_bytes {
    return self.fail(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
  }
  self.sb.write_byte(b)
  self.written = self.written + 1
  true
}

fn Serializer::write_ascii_raw(self : Serializer, s : String) -> Bool {
  let n = s.length()
  if n > self.max_output_bytes - self.written {
    return self.fail(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
  }
  self.sb.write_string(s)
  self.written = self.written + n
  true
}

fn Serializer::write_key_raw(self : Serializer, key : String) -> Bool {
  let n = key.length()
  if n == 0 || !is_key_first(key.code_unit_at(0)) {
    return self.fail(SfvError::InvalidKey("invalid RFC 9651 key"))
  }
  let lo_mask = sfv_key_char_lo
  let hi_mask = sfv_key_char_hi
  let mut i = 1
  while i < n {
    let c = key.code_unit_at(i)
    if c < 64 {
      if ((lo_mask >> c) & 1L) == 0L {
        return self.fail(SfvError::InvalidKey("invalid RFC 9651 key"))
      }
    } else if c < 128 {
      if ((hi_mask >> (c - 64)) & 1L) == 0L {
        return self.fail(SfvError::InvalidKey("invalid RFC 9651 key"))
      }
    } else {
      return self.fail(SfvError::InvalidKey("invalid RFC 9651 key"))
    }
    i = i + 1
  }
  if n > self.max_output_bytes - self.written {
    return self.fail(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
  }
  self.sb.write_string(key)
  self.written = self.written + n
  true
}

fn Serializer::write_i64_unchecked(self : Serializer, v : Int64) -> Bool {
  let rem = self.max_output_bytes - self.written
  if rem >= 16 {
    if v >= 0L && v < 10L {
      self.sb.write_byte((48 + v.to_int()).to_byte())
      self.written = self.written + 1
      return true
    }
    let n = write_i64_count(self.sb, v)
    self.written = self.written + n
    return true
  }
  let n = i64_decimal_len(v)
  if n > rem {
    return self.fail(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
  }
  write_i64_to_sb(self.sb, v)
  self.written = self.written + n
  true
}

fn Serializer::write_integer(self : Serializer, v : Int64) -> Result[Unit, SfvError] {
  if v < sfv_min_int || v > sfv_max_int {
    return Err(SfvError::InvalidNumber("integer out of RFC 9651 range"))
  }
  if !self.write_i64_unchecked(v) {
    return Err(self.take_err())
  }
  Ok(())
}

fn Serializer::write_decimal_raw(self : Serializer, d : Decimal) -> Bool {
  let m = d.scaled_milli
  if m < sfv_min_decimal_milli || m > sfv_max_decimal_milli {
    return self.fail(SfvError::InvalidNumber("decimal out of RFC 9651 range"))
  }
  let rem = self.max_output_bytes - self.written
  if rem >= 17 {
    let n = write_decimal_count(self.sb, m)
    self.written = self.written + n
    return true
  }
  let n = decimal_sfv_len(m)
  if n > rem {
    return self.fail(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
  }
  write_decimal_to_sb(self.sb, m)
  self.written = self.written + n
  true
}

fn Serializer::write_string_escaped(
  self : Serializer,
  s : String,
  n : Int,
  total : Int,
) -> Unit {
  let sb = self.sb
  sb.write_byte((34).to_byte())
  let mut j = 0
  while j < n {
    let b = s.code_unit_at(j)
    if b == 34 || b == 92 {
      sb.write_byte((92).to_byte())
    }
    sb.write_byte(b.to_byte())
    j = j + 1
  }
  sb.write_byte((34).to_byte())
  self.written = self.written + total
}

fn Serializer::write_string(self : Serializer, s : String) -> Result[Unit, SfvError] {
  let n = s.length()
  let mut escapes = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 32 || b > 126 {
      return Err(SfvError::InvalidString("string contains non-printable or non-ASCII byte"))
    }
    if b == 34 || b == 92 {
      escapes = escapes + 1
    }
    i = i + 1
  }
  let total = n + 2 + escapes
  if total > self.max_output_bytes - self.written {
    return Err(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
  }
  if escapes == 0 {
    let sb = self.sb
    sb.write_byte((34).to_byte())
    sb.write_string(s)
    sb.write_byte((34).to_byte())
    self.written = self.written + total
  } else {
    self.write_string_escaped(s, n, total)
  }
  Ok(())
}

fn Serializer::write_token_raw(self : Serializer, tok : String) -> Bool {
  let n = tok.length()
  if n == 0 || !is_token_first(tok.code_unit_at(0)) {
    return self.fail(SfvError::InvalidToken("invalid RFC 9651 token"))
  }
  let lo_mask = sfv_tok_char_lo
  let hi_mask = sfv_tok_char_hi
  let mut i = 1
  while i < n {
    let c = tok.code_unit_at(i)
    if c < 64 {
      if ((lo_mask >> c) & 1L) == 0L {
        return self.fail(SfvError::InvalidToken("invalid RFC 9651 token"))
      }
    } else if c < 128 {
      if ((hi_mask >> (c - 64)) & 1L) == 0L {
        return self.fail(SfvError::InvalidToken("invalid RFC 9651 token"))
      }
    } else {
      return self.fail(SfvError::InvalidToken("invalid RFC 9651 token"))
    }
    i = i + 1
  }
  if n > self.max_output_bytes - self.written {
    return self.fail(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
  }
  self.sb.write_string(tok)
  self.written = self.written + n
  true
}

fn Serializer::write_byte_sequence_raw(self : Serializer, data : Bytes) -> Bool {
  let n = data.length()
  let b64_len = (n + 2) / 3 * 4
  let total = b64_len + 2
  if total > self.max_output_bytes - self.written {
    return self.fail(
      SfvError::LimitExceeded("serialized byte sequence exceeds max_output_bytes"),
    )
  }
  let sb = self.sb
  let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  sb.write_byte((58).to_byte())
  let mut i = 0
  while i + 3 <= n {
    let b0 = data[i].to_int()
    let b1 = data[i + 1].to_int()
    let b2 = data[i + 2].to_int()
    sb.write_byte(alpha.code_unit_at(b0 >> 2).to_byte())
    sb.write_byte(alpha.code_unit_at((b0 & 3) << 4 | b1 >> 4).to_byte())
    sb.write_byte(alpha.code_unit_at((b1 & 15) << 2 | b2 >> 6).to_byte())
    sb.write_byte(alpha.code_unit_at(b2 & 63).to_byte())
    i = i + 3
  }
  let rem = n - i
  if rem == 1 {
    let b0 = data[i].to_int()
    sb.write_byte(alpha.code_unit_at(b0 >> 2).to_byte())
    sb.write_byte(alpha.code_unit_at((b0 & 3) << 4).to_byte())
    sb.write_byte((61).to_byte())
    sb.write_byte((61).to_byte())
  } else if rem == 2 {
    let b0 = data[i].to_int()
    let b1 = data[i + 1].to_int()
    sb.write_byte(alpha.code_unit_at(b0 >> 2).to_byte())
    sb.write_byte(alpha.code_unit_at((b0 & 3) << 4 | b1 >> 4).to_byte())
    sb.write_byte(alpha.code_unit_at((b1 & 15) << 2).to_byte())
    sb.write_byte((61).to_byte())
  }
  sb.write_byte((58).to_byte())
  self.written = self.written + total
  true
}

fn Serializer::write_boolean_raw(self : Serializer, v : Bool) -> Bool {
  if 2 > self.max_output_bytes - self.written {
    return self.fail(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
  }
  let sb = self.sb
  sb.write_byte((63).to_byte())
  if v {
    sb.write_byte((49).to_byte())
  } else {
    sb.write_byte((48).to_byte())
  }
  self.written = self.written + 2
  true
}

fn Serializer::write_date_raw(self : Serializer, v : Int64) -> Bool {
  if v < sfv_min_int || v > sfv_max_int {
    return self.fail(SfvError::InvalidDate("date out of RFC 9651 range"))
  }
  let rem = self.max_output_bytes - self.written
  if rem >= 17 {
    self.sb.write_byte((64).to_byte())
    let n = 1 + write_i64_count(self.sb, v)
    self.written = self.written + n
    return true
  }
  let n = 1 + i64_decimal_len(v)
  if n > rem {
    return self.fail(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
  }
  self.sb.write_byte((64).to_byte())
  write_i64_to_sb(self.sb, v)
  self.written = self.written + n
  true
}

fn Serializer::write_display_string_raw(self : Serializer, s : String) -> Bool {
  let n = s.length()
  let mut has_non_ascii = false
  let mut escapes = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 32 || b > 126 || b == 34 || b == 37 {
      escapes = escapes + 1
      if b >= 128 {
        has_non_ascii = true
      }
    }
    i = i + 1
  }
  if has_non_ascii && !is_valid_utf8_string(s) {
    return self.fail(SfvError::InvalidDisplayString("display string is not valid UTF-8"))
  }
  let total = n + 3 + escapes * 2
  if total > self.max_output_bytes - self.written {
    return self.fail(
      SfvError::LimitExceeded("serialized display string exceeds max_output_bytes"),
    )
  }
  let sb = self.sb
  sb.write_byte((37).to_byte())
  sb.write_byte((34).to_byte())
  if escapes == 0 {
    sb.write_string(s)
  } else {
    let hex = "0123456789abcdef"
    let mut j = 0
    while j < n {
      let b = s.code_unit_at(j)
      if b == 37 || b == 34 || b < 32 || b > 126 {
        sb.write_byte((37).to_byte())
        sb.write_byte(hex.code_unit_at(b >> 4).to_byte())
        sb.write_byte(hex.code_unit_at(b & 15).to_byte())
      } else {
        sb.write_byte(b.to_byte())
      }
      j = j + 1
    }
  }
  sb.write_byte((34).to_byte())
  self.written = self.written + total
  true
}

fn Serializer::write_bare_item_raw(self : Serializer, item : BareItem) -> Bool {
  match item {
    BareItem::Integer(v) =>
    match self.write_integer(v) {
      Ok(_) => true
      Err(e) => self.fail(e)
    }
    BareItem::Decimal(d) => self.write_decimal_raw(d)
    BareItem::String(s) =>
    match self.write_string(s) {
      Ok(_) => true
      Err(e) => self.fail(e)
    }
    BareItem::Token(t) => self.write_token_raw(t)
    BareItem::ByteSequence(b) => self.write_byte_sequence_raw(b)
    BareItem::Boolean(v) => self.write_boolean_raw(v)
    BareItem::Date(v) => self.write_date_raw(v)
    BareItem::DisplayString(s) => self.write_display_string_raw(s)
  }
}

fn Serializer::write_params_raw(self : Serializer, params : Array[Param]) -> Bool {
  let n = params.length()
  if n == 0 {
    return true
  }
  if n > self.limits.max_params {
    return self.fail(SfvError::LimitExceeded("parameters exceed max_params"))
  }
  if n > 16 {
    let seen : Map[String, Bool] = Map::new()
    let mut k = 0
    while k < n {
      let key = params[k].key
      match seen.get(key) {
        Some(_) => return self.fail(SfvError::InvalidKey("duplicate parameter key"))
        None => seen.set(key, true)
      }
      k = k + 1
    }
  } else if n > 1 {
    let mut k = 1
    while k < n {
      let key = params[k].key
      let klen = key.length()
      let mut j = 0
      while j < k {
        let pk = params[j].key
        if pk.length() == klen && pk == key {
          return self.fail(SfvError::InvalidKey("duplicate parameter key"))
        }
        j = j + 1
      }
      k = k + 1
    }
  }
  let mut i = 0
  while i < n {
    let p = params[i]
    if !self.write_byte_raw((59).to_byte()) {
      return false
    }
    if !self.write_key_raw(p.key) {
      return false
    }
    match p.value {
      BareItem::Boolean(true) => ()
      _ => {
        if !self.write_byte_raw((61).to_byte()) {
          return false
        }
        if !self.write_bare_item_raw(p.value) {
          return false
        }
      }
    }
    i = i + 1
  }
  true
}

fn Serializer::write_item_raw(self : Serializer, item : Item) -> Bool {
  if !self.write_bare_item_raw(item.value) {
    return false
  }
  if item.params.length() > 0 {
    self.write_params_raw(item.params)
  } else {
    true
  }
}

fn Serializer::write_inner_list_raw(self : Serializer, il : InnerList) -> Bool {
  let n = il.items.length()
  if n > self.limits.max_inner_list_items {
    return self.fail(SfvError::LimitExceeded("inner list exceeds max_inner_list_items"))
  }
  if !self.write_byte_raw((40).to_byte()) {
    return false
  }
  let mut i = 0
  while i < n {
    if i > 0 {
      if !self.write_byte_raw((32).to_byte()) {
        return false
      }
    }
    if !self.write_item_raw(il.items[i]) {
      return false
    }
    i = i + 1
  }
  if !self.write_byte_raw((41).to_byte()) {
    return false
  }
  if il.params.length() > 0 {
    self.write_params_raw(il.params)
  } else {
    true
  }
}

fn Serializer::write_list_entry_raw(self : Serializer, entry : ListEntry) -> Bool {
  match entry {
    ListEntry::Item(it) => self.write_item_raw(it)
    ListEntry::InnerList(il) => self.write_inner_list_raw(il)
  }
}

// ---------------------------------------------------------------------------
// Public Serialization API
// ---------------------------------------------------------------------------

fn serialize_item_unchecked(
  item : Item,
  limits : SfvLimits,
) -> Result[String, SfvError] {
  let s = Serializer::new_with_cap(limits, 64)
  if !s.write_item_raw(item) {
    return Err(s.take_err())
  }
  Ok(s.sb.to_string())
}

///| Serialize an RFC 9651 Item using default limits.
pub fn serialize_item(item : Item) -> Result[String, SfvError] {
  serialize_item_unchecked(item, SfvLimits::default())
}

///| Serialize an RFC 9651 Item with explicit `SfvLimits`.
pub fn serialize_item_with_limits(
  item : Item,
  limits : SfvLimits,
) -> Result[String, SfvError] {
  match validate_limits_fast(limits) {
    Some(e) => return Err(e)
    None => ()
  }
  serialize_item_unchecked(item, limits)
}

fn serialize_list_unchecked(
  list : Array[ListEntry],
  limits : SfvLimits,
) -> Result[String, SfvError] {
  let n = list.length()
  if n > limits.max_list_members {
    return Err(SfvError::LimitExceeded("list exceeds max_list_members"))
  }
  if n == 0 {
    return Ok("")
  }
  let s = Serializer::new_with_cap(limits, n * 32 + 64)
  let mut i = 0
  while i < n {
    if i > 0 {
      if 2 > s.max_output_bytes - s.written {
        return Err(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
      }
      s.sb.write_byte((44).to_byte())
      s.sb.write_byte((32).to_byte())
      s.written = s.written + 2
    }
    if !s.write_list_entry_raw(list[i]) {
      return Err(s.take_err())
    }
    i = i + 1
  }
  Ok(s.sb.to_string())
}

///| Serialize an RFC 9651 List using default limits.
pub fn serialize_list(list : Array[ListEntry]) -> Result[String, SfvError] {
  serialize_list_unchecked(list, SfvLimits::default())
}

///| Serialize an RFC 9651 List with explicit `SfvLimits`.
pub fn serialize_list_with_limits(
  list : Array[ListEntry],
  limits : SfvLimits,
) -> Result[String, SfvError] {
  match validate_limits_fast(limits) {
    Some(e) => return Err(e)
    None => ()
  }
  serialize_list_unchecked(list, limits)
}

fn serialize_dictionary_unchecked(
  dict : Array[DictMember],
  limits : SfvLimits,
) -> Result[String, SfvError] {
  let n = dict.length()
  if n > limits.max_dict_members {
    return Err(SfvError::LimitExceeded("dictionary exceeds max_dict_members"))
  }
  if n == 0 {
    return Ok("")
  }
  if n > 16 {
    let seen : Map[String, Bool] = Map::new()
    let mut k = 0
    while k < n {
      let key = dict[k].key
      match seen.get(key) {
        Some(_) => return Err(SfvError::InvalidKey("duplicate dictionary key"))
        None => seen.set(key, true)
      }
      k = k + 1
    }
  } else if n > 1 {
    let mut k = 1
    while k < n {
      let key = dict[k].key
      let klen = key.length()
      let mut j = 0
      while j < k {
        let dk = dict[j].key
        if dk.length() == klen && dk == key {
          return Err(SfvError::InvalidKey("duplicate dictionary key"))
        }
        j = j + 1
      }
      k = k + 1
    }
  }
  let s = Serializer::new_with_cap(limits, n * 32 + 64)
  let mut i = 0
  while i < n {
    if i > 0 {
      if 2 > s.max_output_bytes - s.written {
        return Err(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
      }
      s.sb.write_byte((44).to_byte())
      s.sb.write_byte((32).to_byte())
      s.written = s.written + 2
    }
    let m = dict[i]
    if !s.write_key_raw(m.key) {
      return Err(s.take_err())
    }
    match m.value {
      ListEntry::Item(it) =>
      match it.value {
        BareItem::Boolean(true) =>
        if it.params.length() > 0 {
          if !s.write_params_raw(it.params) {
            return Err(s.take_err())
          }
        }
        _ => {
          if !s.write_byte_raw((61).to_byte()) {
            return Err(s.take_err())
          }
          if !s.write_item_raw(it) {
            return Err(s.take_err())
          }
        }
      }
      ListEntry::InnerList(il) => {
        if !s.write_byte_raw((61).to_byte()) {
          return Err(s.take_err())
        }
        if !s.write_inner_list_raw(il) {
          return Err(s.take_err())
        }
      }
    }
    i = i + 1
  }
  Ok(s.sb.to_string())
}

///| Serialize an RFC 9651 Dictionary using default limits.
pub fn serialize_dictionary(
  dict : Array[DictMember],
) -> Result[String, SfvError] {
  serialize_dictionary_unchecked(dict, SfvLimits::default())
}

///| Serialize an RFC 9651 Dictionary with explicit `SfvLimits`.
pub fn serialize_dictionary_with_limits(
  dict : Array[DictMember],
  limits : SfvLimits,
) -> Result[String, SfvError] {
  match validate_limits_fast(limits) {
    Some(e) => return Err(e)
    None => ()
  }
  serialize_dictionary_unchecked(dict, limits)
}

///| Serialize a single `BareItem` with default limits.
pub fn serialize_bare_item(item : BareItem) -> Result[String, SfvError] {
  serialize_item(Item::bare(item))
}
