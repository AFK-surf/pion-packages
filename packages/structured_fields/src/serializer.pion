///| RFC 9651 §4.1 Structured Field Values serializer.
///| Strictly validates every value, key, range, charset, and UTF-8 invariant before
///| emitting output, and enforces `SfvLimits.max_output_bytes` incrementally.

struct Serializer {
  sb : StringBuilder
  mut written : Int
  limits : SfvLimits
}

fn Serializer::new(limits : SfvLimits) -> Result[Serializer, SfvError] {
  match validate_limits(limits) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  Ok(Serializer::{ sb: StringBuilder::new(), written: 0, limits: limits })
}

fn Serializer::write_byte(self : Serializer, b : Byte) -> Result[Unit, SfvError] {
  if self.written >= self.limits.max_output_bytes {
    return Err(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
  }
  self.sb.write_byte(b)
  self.written = self.written + 1
  Ok(())
}

fn Serializer::write_ascii(self : Serializer, s : String) -> Result[Unit, SfvError] {
  let n = s.length()
  if n > self.limits.max_output_bytes - self.written {
    return Err(SfvError::LimitExceeded("serialized output exceeds max_output_bytes"))
  }
  self.sb.write_string(s)
  self.written = self.written + n
  Ok(())
}

fn Serializer::write_key(self : Serializer, key : String) -> Result[Unit, SfvError] {
  if !is_valid_key(key) {
    return Err(SfvError::InvalidKey("invalid RFC 9651 key"))
  }
  self.write_ascii(key)
}

fn Serializer::write_integer(self : Serializer, v : Int64) -> Result[Unit, SfvError] {
  if v < sfv_min_int || v > sfv_max_int {
    return Err(SfvError::InvalidNumber("integer out of RFC 9651 range"))
  }
  self.write_ascii(v.to_string())
}

fn Serializer::write_decimal(self : Serializer, d : Decimal) -> Result[Unit, SfvError] {
  if d.scaled_milli < sfv_min_decimal_milli || d.scaled_milli > sfv_max_decimal_milli {
    return Err(SfvError::InvalidNumber("decimal out of RFC 9651 range"))
  }
  self.write_ascii(d.to_sfv_string())
}

fn Serializer::write_string(self : Serializer, s : String) -> Result[Unit, SfvError] {
  let bytes = s.to_bytes()
  let n = bytes.length()
  match self.write_byte((34).to_byte()) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let mut i = 0
  while i < n {
    let b = bytes[i].to_int()
    if b < 32 || b > 126 {
      return Err(SfvError::InvalidString("string contains non-printable or non-ASCII byte"))
    }
    if b == 34 || b == 92 {
      match self.write_byte((92).to_byte()) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    }
    match self.write_byte(b.to_byte()) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    i = i + 1
  }
  self.write_byte((34).to_byte())
}

fn Serializer::write_token(self : Serializer, tok : String) -> Result[Unit, SfvError] {
  if !is_valid_token(tok) {
    return Err(SfvError::InvalidToken("invalid RFC 9651 token"))
  }
  self.write_ascii(tok)
}

fn Serializer::write_byte_sequence(self : Serializer, data : Bytes) -> Result[Unit, SfvError] {
  let n = data.length()
  let b64_len = (n + 2) / 3 * 4
  if b64_len + 2 > self.limits.max_output_bytes - self.written {
    return Err(SfvError::LimitExceeded("serialized byte sequence exceeds max_output_bytes"))
  }
  match self.write_byte((58).to_byte()) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let mut i = 0
  while i + 3 <= n {
    let b0 = data[i].to_int()
    let b1 = data[i + 1].to_int()
    let b2 = data[i + 2].to_int()
    self.sb.write_byte(b64_encode_byte(b0 >> 2))
    self.sb.write_byte(b64_encode_byte((b0 & 3) << 4 | b1 >> 4))
    self.sb.write_byte(b64_encode_byte((b1 & 15) << 2 | b2 >> 6))
    self.sb.write_byte(b64_encode_byte(b2 & 63))
    self.written = self.written + 4
    i = i + 3
  }
  let rem = n - i
  if rem == 1 {
    let b0 = data[i].to_int()
    self.sb.write_byte(b64_encode_byte(b0 >> 2))
    self.sb.write_byte(b64_encode_byte((b0 & 3) << 4))
    self.sb.write_byte((61).to_byte())
    self.sb.write_byte((61).to_byte())
    self.written = self.written + 4
  } else if rem == 2 {
    let b0 = data[i].to_int()
    let b1 = data[i + 1].to_int()
    self.sb.write_byte(b64_encode_byte(b0 >> 2))
    self.sb.write_byte(b64_encode_byte((b0 & 3) << 4 | b1 >> 4))
    self.sb.write_byte(b64_encode_byte((b1 & 15) << 2))
    self.sb.write_byte((61).to_byte())
    self.written = self.written + 4
  }
  self.write_byte((58).to_byte())
}

fn Serializer::write_boolean(self : Serializer, v : Bool) -> Result[Unit, SfvError] {
  if v {
    self.write_ascii("?1")
  } else {
    self.write_ascii("?0")
  }
}

fn Serializer::write_date(self : Serializer, v : Int64) -> Result[Unit, SfvError] {
  if v < sfv_min_int || v > sfv_max_int {
    return Err(SfvError::InvalidDate("date out of RFC 9651 range"))
  }
  match self.write_byte((64).to_byte()) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  self.write_ascii(v.to_string())
}

fn Serializer::write_display_string(self : Serializer, s : String) -> Result[Unit, SfvError] {
  let bytes = s.to_bytes()
  if !is_valid_utf8_bytes(bytes) {
    return Err(SfvError::InvalidDisplayString("display string is not valid UTF-8"))
  }
  match self.write_ascii("%\"") {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let n = bytes.length()
  let mut i = 0
  while i < n {
    let b = bytes[i].to_int()
    if b == 37 || b == 34 || b < 32 || b > 126 {
      if 3 > self.limits.max_output_bytes - self.written {
        return Err(SfvError::LimitExceeded("serialized display string exceeds max_output_bytes"))
      }
      self.sb.write_byte((37).to_byte())
      self.sb.write_byte(hex_lower_byte(b >> 4))
      self.sb.write_byte(hex_lower_byte(b & 15))
      self.written = self.written + 3
    } else {
      match self.write_byte(b.to_byte()) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    }
    i = i + 1
  }
  self.write_byte((34).to_byte())
}

fn Serializer::write_bare_item(self : Serializer, item : BareItem) -> Result[Unit, SfvError] {
  match item {
    BareItem::Integer(v) => self.write_integer(v)
    BareItem::Decimal(d) => self.write_decimal(d)
    BareItem::String(s) => self.write_string(s)
    BareItem::Token(t) => self.write_token(t)
    BareItem::ByteSequence(b) => self.write_byte_sequence(b)
    BareItem::Boolean(v) => self.write_boolean(v)
    BareItem::Date(v) => self.write_date(v)
    BareItem::DisplayString(s) => self.write_display_string(s)
  }
}

fn Serializer::write_params(self : Serializer, params : Array[Param]) -> Result[Unit, SfvError] {
  let n = params.length()
  if n > self.limits.max_params {
    return Err(SfvError::LimitExceeded("parameters exceed max_params"))
  }
  if n > 8 {
    let seen : Map[String, Bool] = Map::new()
    let mut k = 0
    while k < n {
      let key = params[k].key
      match seen.get(key) {
        Some(_) => return Err(SfvError::InvalidKey("duplicate parameter key"))
        None => seen.set(key, true)
      }
      k = k + 1
    }
  } else if n > 1 {
    let mut k = 0
    while k < n {
      let key = params[k].key
      let mut j = 0
      while j < k {
        if params[j].key == key {
          return Err(SfvError::InvalidKey("duplicate parameter key"))
        }
        j = j + 1
      }
      k = k + 1
    }
  }
  let mut i = 0
  while i < n {
    let p = params[i]
    match self.write_byte((59).to_byte()) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    match self.write_key(p.key) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    match p.value {
      BareItem::Boolean(true) => ()
      _ => {
        match self.write_byte((61).to_byte()) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        match self.write_bare_item(p.value) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
      }
    }
    i = i + 1
  }
  Ok(())
}

fn Serializer::write_item(self : Serializer, item : Item) -> Result[Unit, SfvError] {
  match self.write_bare_item(item.value) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  self.write_params(item.params)
}

fn Serializer::write_inner_list(self : Serializer, il : InnerList) -> Result[Unit, SfvError] {
  let n = il.items.length()
  if n > self.limits.max_inner_list_items {
    return Err(SfvError::LimitExceeded("inner list exceeds max_inner_list_items"))
  }
  match self.write_byte((40).to_byte()) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let mut i = 0
  while i < n {
    if i > 0 {
      match self.write_byte((32).to_byte()) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    }
    match self.write_item(il.items[i]) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    i = i + 1
  }
  match self.write_byte((41).to_byte()) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  self.write_params(il.params)
}

fn Serializer::write_list_entry(self : Serializer, entry : ListEntry) -> Result[Unit, SfvError] {
  match entry {
    ListEntry::Item(it) => self.write_item(it)
    ListEntry::InnerList(il) => self.write_inner_list(il)
  }
}

// ---------------------------------------------------------------------------
// Public Serialization API
// ---------------------------------------------------------------------------

///| Serialize an RFC 9651 Item using default limits.
pub fn serialize_item(item : Item) -> Result[String, SfvError] {
  serialize_item_with_limits(item, SfvLimits::default())
}

///| Serialize an RFC 9651 Item with explicit `SfvLimits`.
pub fn serialize_item_with_limits(
  item : Item,
  limits : SfvLimits,
) -> Result[String, SfvError] {
  let s = match Serializer::new(limits) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  match s.write_item(item) {
    Err(e) => Err(e)
    Ok(_) => Ok(s.sb.to_string())
  }
}

///| Serialize an RFC 9651 List using default limits.
pub fn serialize_list(list : Array[ListEntry]) -> Result[String, SfvError] {
  serialize_list_with_limits(list, SfvLimits::default())
}

///| Serialize an RFC 9651 List with explicit `SfvLimits`.
pub fn serialize_list_with_limits(
  list : Array[ListEntry],
  limits : SfvLimits,
) -> Result[String, SfvError] {
  let s = match Serializer::new(limits) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let n = list.length()
  if n > limits.max_list_members {
    return Err(SfvError::LimitExceeded("list exceeds max_list_members"))
  }
  let mut i = 0
  while i < n {
    if i > 0 {
      match s.write_ascii(", ") {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    }
    match s.write_list_entry(list[i]) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    i = i + 1
  }
  Ok(s.sb.to_string())
}

///| Serialize an RFC 9651 Dictionary using default limits.
pub fn serialize_dictionary(
  dict : Array[DictMember],
) -> Result[String, SfvError] {
  serialize_dictionary_with_limits(dict, SfvLimits::default())
}

///| Serialize an RFC 9651 Dictionary with explicit `SfvLimits`.
pub fn serialize_dictionary_with_limits(
  dict : Array[DictMember],
  limits : SfvLimits,
) -> Result[String, SfvError] {
  let s = match Serializer::new(limits) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  let n = dict.length()
  if n > limits.max_dict_members {
    return Err(SfvError::LimitExceeded("dictionary exceeds max_dict_members"))
  }
  if n > 8 {
    let seen : Map[String, Bool] = Map::new()
    let mut k = 0
    while k < n {
      let key = dict[k].key
      match seen.get(key) {
        Some(_) => return Err(SfvError::InvalidKey("duplicate dictionary key"))
        None => seen.set(key, true)
      }
      k = k + 1
    }
  } else if n > 1 {
    let mut k = 0
    while k < n {
      let key = dict[k].key
      let mut j = 0
      while j < k {
        if dict[j].key == key {
          return Err(SfvError::InvalidKey("duplicate dictionary key"))
        }
        j = j + 1
      }
      k = k + 1
    }
  }
  let mut i = 0
  while i < n {
    if i > 0 {
      match s.write_ascii(", ") {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    }
    let m = dict[i]
    match s.write_key(m.key) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    match m.value {
      ListEntry::Item(it) =>
      match it.value {
        BareItem::Boolean(true) =>
        match s.write_params(it.params) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        _ => {
          match s.write_byte((61).to_byte()) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
          match s.write_item(it) {
            Err(e) => return Err(e)
            Ok(_) => ()
          }
        }
      }
      ListEntry::InnerList(il) => {
        match s.write_byte((61).to_byte()) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        match s.write_inner_list(il) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
      }
    }
    i = i + 1
  }
  Ok(s.sb.to_string())
}

///| Serialize a single `BareItem` with default limits.
pub fn serialize_bare_item(item : BareItem) -> Result[String, SfvError] {
  serialize_item(Item::bare(item))
}
