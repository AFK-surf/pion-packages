///| Core RFC 9651 (Structured Field Values for HTTP) types, exact `Int64` scaled
///| `Decimal` (zero floating point), resource limits (`SfvLimits`), and errors.

///| Minimum allowed RFC 9651 Integer / Date value (`-999_999_999_999_999`).
pub let sfv_min_int : Int64 = -999999999999999L

///| Maximum allowed RFC 9651 Integer / Date value (`+999_999_999_999_999`).
pub let sfv_max_int : Int64 = 999999999999999L

///| Minimum allowed RFC 9651 Decimal in thousandths (`-999_999_999_999.999`).
pub let sfv_min_decimal_milli : Int64 = -999999999999999L

///| Maximum allowed RFC 9651 Decimal in thousandths (`+999_999_999_999.999`).
pub let sfv_max_decimal_milli : Int64 = 999999999999999L

///| Explicit resource limits enforced during parsing and serialization to prevent
///| CPU and memory DoS attacks.
///|
///| Semantics:
///| - Any negative field is immediately rejected with `SfvError::LimitExceeded`.
///| - `0` strictly means 0 allowed (not unlimited).
pub val struct SfvLimits {
  pub max_input_bytes : Int
  pub max_list_members : Int
  pub max_inner_list_items : Int
  pub max_dict_members : Int
  pub max_params : Int
  pub max_string_bytes : Int
  pub max_output_bytes : Int
}

///| Default DoS protection limits suitable for browsers, proxies, and HTTP servers.
pub fn SfvLimits::default() -> SfvLimits {
  SfvLimits::{
    max_input_bytes: 65536,
    max_list_members: 1024,
    max_inner_list_items: 256,
    max_dict_members: 1024,
    max_params: 256,
    max_string_bytes: 16384,
    max_output_bytes: 65536,
  }
}

///| Construct custom `SfvLimits`.
pub fn SfvLimits::new(
  max_input_bytes : Int,
  max_list_members : Int,
  max_inner_list_items : Int,
  max_dict_members : Int,
  max_params : Int,
  max_string_bytes : Int,
  max_output_bytes : Int,
) -> SfvLimits {
  SfvLimits::{
    max_input_bytes: max_input_bytes,
    max_list_members: max_list_members,
    max_inner_list_items: max_inner_list_items,
    max_dict_members: max_dict_members,
    max_params: max_params,
    max_string_bytes: max_string_bytes,
    max_output_bytes: max_output_bytes,
  }
}

///| Explicit error variants returned by RFC 9651 parsing and serialization.
pub enum SfvError {
  InvalidSyntax(String)
  InvalidNumber(String)
  InvalidString(String)
  InvalidToken(String)
  InvalidByteSequence(String)
  InvalidBoolean(String)
  InvalidDate(String)
  InvalidDisplayString(String)
  InvalidKey(String)
  TrailingData(String)
  LimitExceeded(String)
}

///| Human-readable message for an `SfvError`.
pub fn sfv_error_message(err : SfvError) -> String {
  match err {
    SfvError::InvalidSyntax(msg) => "invalid syntax: " + msg
    SfvError::InvalidNumber(msg) => "invalid number: " + msg
    SfvError::InvalidString(msg) => "invalid string: " + msg
    SfvError::InvalidToken(msg) => "invalid token: " + msg
    SfvError::InvalidByteSequence(msg) => "invalid byte sequence: " + msg
    SfvError::InvalidBoolean(msg) => "invalid boolean: " + msg
    SfvError::InvalidDate(msg) => "invalid date: " + msg
    SfvError::InvalidDisplayString(msg) => "invalid display string: " + msg
    SfvError::InvalidKey(msg) => "invalid key: " + msg
    SfvError::TrailingData(msg) => "trailing data: " + msg
    SfvError::LimitExceeded(msg) => "limit exceeded: " + msg
  }
}

///| Exact RFC 9651 §3.3.2 Decimal stored as scaled thousandths (`Int64`, unit = 1/1000).
///| Zero floating point is used anywhere in this package.
///| Valid range: `[-999_999_999_999_999, +999_999_999_999_999]`, representing
///| `[-999_999_999_999.999, +999_999_999_999.999]`.
pub val struct Decimal {
  pub scaled_milli : Int64
}

///| Construct a `Decimal` from an exact thousandths `Int64` value.
pub fn Decimal::from_scaled_milli(scaled_milli : Int64) -> Result[Decimal, SfvError] {
  if scaled_milli < sfv_min_decimal_milli || scaled_milli > sfv_max_decimal_milli {
    return Err(SfvError::InvalidNumber("decimal out of RFC 9651 range"))
  }
  Ok(Decimal::{ scaled_milli: scaled_milli })
}

///| Construct a `Decimal` from a whole integer in `[-999_999_999_999, 999_999_999_999]`.
pub fn Decimal::from_integer(value : Int64) -> Result[Decimal, SfvError] {
  if value < -999999999999L || value > 999999999999L {
    return Err(SfvError::InvalidNumber("decimal integer part exceeds 12 digits"))
  }
  Ok(Decimal::{ scaled_milli: value * 1000L })
}

///| Construct a `Decimal` from exact `value * 10^(-scale_pow10)` using exact
///| integer round-half-to-even (RFC 9651 §4.1.5) into thousandths (`10^-3`).
pub fn Decimal::from_scaled_rounded(
  value : Int64,
  scale_pow10 : Int,
) -> Result[Decimal, SfvError] {
  if scale_pow10 < 0 {
    return Err(SfvError::InvalidNumber("scale_pow10 must be >= 0"))
  }
  if scale_pow10 == 3 {
    return Decimal::from_scaled_milli(value)
  }
  if scale_pow10 < 3 {
    let mult = if scale_pow10 == 2 {
      10L
    } else if scale_pow10 == 1 {
      100L
    } else {
      1000L
    }
    let max_v = sfv_max_decimal_milli / mult
    let min_v = sfv_min_decimal_milli / mult
    if value < min_v || value > max_v {
      return Err(SfvError::InvalidNumber("decimal out of RFC 9651 range"))
    }
    return Ok(Decimal::{ scaled_milli: value * mult })
  }
  let shift = scale_pow10 - 3
  if shift >= 20 {
    return Ok(Decimal::{ scaled_milli: 0L })
  }
  if shift == 19 {
    let half = 5000000000000000000L
    let rounded = if value > half {
      1L
    } else if value < -half {
      -1L
    } else {
      0L
    }
    return Ok(Decimal::{ scaled_milli: rounded })
  }
  let mut div = 1L
  let mut i = 0
  while i < shift {
    div = div * 10L
    i = i + 1
  }
  let half = div / 2L
  let mut q = value / div
  let r = value % div
  let abs_r = if r < 0L { -r } else { r }
  if abs_r > half {
    q = if value > 0L { q + 1L } else { q - 1L }
  } else if abs_r == half {
    if q % 2L != 0L {
      q = if value > 0L { q + 1L } else { q - 1L }
    }
  }
  Decimal::from_scaled_milli(q)
}

///| Return the underlying scaled thousandths value.
pub fn Decimal::to_scaled_milli(self : Decimal) -> Int64 {
  self.scaled_milli
}

///| Return whether this `Decimal` is zero.
pub fn Decimal::is_zero(self : Decimal) -> Bool {
  self.scaled_milli == 0L
}

///| Return whether this `Decimal` is strictly negative.
pub fn Decimal::is_negative(self : Decimal) -> Bool {
  self.scaled_milli < 0L
}

///| Canonical RFC 9651 §4.1.5 decimal string (never emits `-0.0`).
pub fn Decimal::to_sfv_string(self : Decimal) -> String {
  if self.scaled_milli == 0L {
    return "0.0"
  }
  let sb = StringBuilder::new()
  let abs_val = if self.scaled_milli < 0L {
    sb.write_byte((45).to_byte())
    -self.scaled_milli
  } else {
    self.scaled_milli
  }
  let int_part = abs_val / 1000L
  let frac = (abs_val % 1000L).to_int()
  sb.write_string(int_part.to_string())
  sb.write_byte((46).to_byte())
  if frac == 0 {
    sb.write_byte((48).to_byte())
  } else if frac % 100 == 0 {
    sb.write_byte((48 + frac / 100).to_byte())
  } else if frac % 10 == 0 {
    sb.write_byte((48 + frac / 100).to_byte())
    sb.write_byte((48 + frac / 10 % 10).to_byte())
  } else {
    sb.write_byte((48 + frac / 100).to_byte())
    sb.write_byte((48 + frac / 10 % 10).to_byte())
    sb.write_byte((48 + frac % 10).to_byte())
  }
  sb.to_string()
}

///| All 8 RFC 9651 §3.3 Bare Item types.
pub enum BareItem {
  Integer(Int64)
  Decimal(Decimal)
  String(String)
  Token(String)
  ByteSequence(Bytes)
  Boolean(Bool)
  Date(Int64)
  DisplayString(String)
}

///| An ordered parameter entry (`key` -> `BareItem`).
pub struct Param {
  pub key : String
  pub value : BareItem
}

///| Construct a `Param`.
pub fn Param::new(key : String, value : BareItem) -> Param {
  Param::{ key: key, value: value }
}

///| RFC 9651 §3.3 Item: a `BareItem` with ordered `Parameters`.
pub struct Item {
  pub value : BareItem
  pub params : Array[Param]
}

///| Construct an `Item` with no parameters.
pub fn Item::bare(value : BareItem) -> Item {
  Item::{ value: value, params: [] }
}

///| Construct an `Item` with parameters.
pub fn Item::new(value : BareItem, params : Array[Param]) -> Item {
  Item::{ value: value, params: params }
}

///| RFC 9651 §3.1.1 Inner List: ordered `Item`s with `Parameters`.
pub struct InnerList {
  pub items : Array[Item]
  pub params : Array[Param]
}

///| Construct an `InnerList`.
pub fn InnerList::new(items : Array[Item], params : Array[Param]) -> InnerList {
  InnerList::{ items: items, params: params }
}

///| A member of a List or value of a Dictionary entry.
pub enum ListEntry {
  Item(Item)
  InnerList(InnerList)
}

///| An ordered Dictionary member (`key` -> `ListEntry`).
pub struct DictMember {
  pub key : String
  pub value : ListEntry
}

///| Construct a `DictMember`.
pub fn DictMember::new(key : String, value : ListEntry) -> DictMember {
  DictMember::{ key: key, value: value }
}

///| RFC 9218 HTTP `Priority` header representation (`u` urgency 0..=7, `i` incremental).
pub val struct Priority {
  pub urgency : Int
  pub incremental : Bool
}

///| Default RFC 9218 Priority (`u=3, i=?0`).
pub fn Priority::default() -> Priority {
  Priority::{ urgency: 3, incremental: false }
}

///| Parsed W3C `Permissions-Policy` directive entry.
pub struct PermissionsDirective {
  pub feature : String
  pub allow_all : Bool
  pub allow_self : Bool
  pub origins : Array[String]
}

///| Validate `SfvLimits`: reject any negative field with `SfvError::LimitExceeded`.
pub fn validate_limits(limits : SfvLimits) -> Result[Unit, SfvError] {
  if limits.max_input_bytes < 0 {
    return Err(SfvError::LimitExceeded("max_input_bytes must be >= 0"))
  }
  if limits.max_list_members < 0 {
    return Err(SfvError::LimitExceeded("max_list_members must be >= 0"))
  }
  if limits.max_inner_list_items < 0 {
    return Err(SfvError::LimitExceeded("max_inner_list_items must be >= 0"))
  }
  if limits.max_dict_members < 0 {
    return Err(SfvError::LimitExceeded("max_dict_members must be >= 0"))
  }
  if limits.max_params < 0 {
    return Err(SfvError::LimitExceeded("max_params must be >= 0"))
  }
  if limits.max_string_bytes < 0 {
    return Err(SfvError::LimitExceeded("max_string_bytes must be >= 0"))
  }
  if limits.max_output_bytes < 0 {
    return Err(SfvError::LimitExceeded("max_output_bytes must be >= 0"))
  }
  Ok(())
}

// ---------------------------------------------------------------------------
// Pure RFC 9651 character-class & encoding helpers (zero module-level mutables)
// ---------------------------------------------------------------------------

fn is_ascii_digit(b : Int) -> Bool {
  b >= 48 && b <= 57
}

fn is_ascii_upper(b : Int) -> Bool {
  b >= 65 && b <= 90
}

fn is_ascii_lower(b : Int) -> Bool {
  b >= 97 && b <= 122
}

fn is_ascii_alpha(b : Int) -> Bool {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

///| RFC 9651 §3.1.2 Key first char: `lcalpha / "*"`
fn is_key_first(b : Int) -> Bool {
  (b >= 97 && b <= 122) || b == 42
}

///| RFC 9651 §3.1.2 Key subsequent char: `lcalpha / DIGIT / "_" / "-" / "." / "*"`
fn is_key_char(b : Int) -> Bool {
  (b >= 97 && b <= 122) ||
  (b >= 48 && b <= 57) ||
  b == 95 ||
  b == 45 ||
  b == 46 ||
  b == 42
}

///| RFC 9651 §3.3.4 Token first char: `ALPHA / "*"`
fn is_token_first(b : Int) -> Bool {
  is_ascii_alpha(b) || b == 42
}

///| RFC 9651 §3.3.4 Token subsequent char: `tchar / ":" / "/"`
///| `tchar = "!" / "#" / "$" / "%" / "&" / "'" / "*" / "+" / "-" / "." / "^" / "_" / "`" / "|" / "~" / DIGIT / ALPHA`
fn is_token_char(b : Int) -> Bool {
  if b <= 32 || b >= 127 {
    return false
  }
  if is_ascii_alpha(b) || is_ascii_digit(b) {
    return true
  }
  // Printable non-alnum ASCII in 33..=126 minus delimiters `"(),;<=>?@[\]{}`
  b == 33 || // !
  b == 35 || // #
  b == 36 || // $
  b == 37 || // %
  b == 38 || // &
  b == 39 || // '
  b == 42 || // *
  b == 43 || // +
  b == 45 || // -
  b == 46 || // .
  b == 47 || // /
  b == 58 || // :
  b == 94 || // ^
  b == 95 || // _
  b == 96 || // `
  b == 124 || // |
  b == 126 // ~
}

///| Validate an RFC 9651 Key string.
pub fn is_valid_key(s : String) -> Bool {
  let bytes = s.to_bytes()
  let n = bytes.length()
  if n == 0 {
    return false
  }
  if !is_key_first(bytes[0].to_int()) {
    return false
  }
  let mut i = 1
  while i < n {
    if !is_key_char(bytes[i].to_int()) {
      return false
    }
    i = i + 1
  }
  true
}

///| Validate an RFC 9651 Token string.
pub fn is_valid_token(s : String) -> Bool {
  let bytes = s.to_bytes()
  let n = bytes.length()
  if n == 0 {
    return false
  }
  if !is_token_first(bytes[0].to_int()) {
    return false
  }
  let mut i = 1
  while i < n {
    if !is_token_char(bytes[i].to_int()) {
      return false
    }
    i = i + 1
  }
  true
}

///| Lowercase hex digit value (0..15), or -1 if not `0-9` / `a-f`.
fn hex_lower_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

///| Lowercase hex ASCII byte for nibble `0..15`.
fn hex_lower_byte(v : Int) -> Byte {
  if v < 10 {
    (48 + v).to_byte()
  } else {
    (87 + v).to_byte()
  }
}

///| Standard RFC 4648 §4 Base64 sextet value, or -1 if invalid.
fn b64_decode_sextet(b : Int) -> Int {
  if b >= 65 && b <= 90 {
    b - 65
  } else if b >= 97 && b <= 122 {
    b - 71
  } else if b >= 48 && b <= 57 {
    b + 4
  } else if b == 43 {
    62
  } else if b == 47 {
    63
  } else {
    -1
  }
}

///| Standard RFC 4648 §4 Base64 alphabet byte for sextet `0..63`.
fn b64_encode_byte(v : Int) -> Byte {
  if v < 26 {
    (65 + v).to_byte()
  } else if v < 52 {
    (71 + v).to_byte()
  } else if v < 62 {
    (v - 4).to_byte()
  } else if v == 62 {
    (43).to_byte()
  } else {
    (47).to_byte()
  }
}

///| Strict RFC 3629 UTF-8 byte sequence validator (rejects overlongs, surrogates, > U+10FFFF).
fn is_valid_utf8_bytes(bytes : Bytes) -> Bool {
  let n = bytes.length()
  let mut i = 0
  while i < n {
    let b0 = bytes[i].to_int()
    if b0 <= 0x7F {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      if b1 < 0x80 || b1 > 0xBF {
        return false
      }
      i = i + 2
    } else if b0 == 0xE0 {
      if i + 2 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      if b1 < 0xA0 || b1 > 0xBF || b2 < 0x80 || b2 > 0xBF {
        return false
      }
      i = i + 3
    } else if (b0 >= 0xE1 && b0 <= 0xEC) || (b0 >= 0xEE && b0 <= 0xEF) {
      if i + 2 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      if b1 < 0x80 || b1 > 0xBF || b2 < 0x80 || b2 > 0xBF {
        return false
      }
      i = i + 3
    } else if b0 == 0xED {
      if i + 2 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      if b1 < 0x80 || b1 > 0x9F || b2 < 0x80 || b2 > 0xBF {
        return false
      }
      i = i + 3
    } else if b0 == 0xF0 {
      if i + 3 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      let b3 = bytes[i + 3].to_int()
      if b1 < 0x90 || b1 > 0xBF || b2 < 0x80 || b2 > 0xBF || b3 < 0x80 || b3 > 0xBF {
        return false
      }
      i = i + 4
    } else if b0 >= 0xF1 && b0 <= 0xF3 {
      if i + 3 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      let b3 = bytes[i + 3].to_int()
      if b1 < 0x80 || b1 > 0xBF || b2 < 0x80 || b2 > 0xBF || b3 < 0x80 || b3 > 0xBF {
        return false
      }
      i = i + 4
    } else if b0 == 0xF4 {
      if i + 3 >= n {
        return false
      }
      let b1 = bytes[i + 1].to_int()
      let b2 = bytes[i + 2].to_int()
      let b3 = bytes[i + 3].to_int()
      if b1 < 0x80 || b1 > 0x8F || b2 < 0x80 || b2 > 0xBF || b3 < 0x80 || b3 > 0xBF {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}
