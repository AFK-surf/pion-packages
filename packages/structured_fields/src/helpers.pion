///| Browser-oriented RFC 9651 helpers (RFC 9218 Priority, W3C Permissions-Policy,
///| parameter/dictionary lookup helpers).

///| Look up a parameter value by key.
pub fn get_param(params : Array[Param], key : String) -> Option[BareItem] {
  let mut i = 0
  while i < params.length() {
    if params[i].key == key {
      return Some(params[i].value)
    }
    i = i + 1
  }
  None
}

///| Look up a dictionary member by key.
pub fn get_dict_member(dict : Array[DictMember], key : String) -> Option[ListEntry] {
  let mut i = 0
  while i < dict.length() {
    if dict[i].key == key {
      return Some(dict[i].value)
    }
    i = i + 1
  }
  None
}

///| Parse an RFC 9218 HTTP `Priority` header (e.g. `u=1, i`).
///| Follows RFC 9218 §4: `u` must be an integer in `0..=7` (default `3`),
///| `i` must be a boolean (default `false`); unrecognized members or out-of-range
///| values are ignored per RFC 9218 §4, while syntactically invalid SFV fails.
pub fn parse_priority(input : String) -> Result[Priority, SfvError] {
  let dict = match parse_dictionary(input) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let mut urgency = 3
  let mut incremental = false
  let mut i = 0
  while i < dict.length() {
    let m = dict[i]
    if m.key == "u" {
      match m.value {
        ListEntry::Item(it) =>
        match it.value {
          BareItem::Integer(v) =>
          if v >= 0L && v <= 7L {
            urgency = v.to_int()
          }
          _ => ()
        }
        _ => ()
      }
    } else if m.key == "i" {
      match m.value {
        ListEntry::Item(it) =>
        match it.value {
          BareItem::Boolean(b) => incremental = b
          _ => ()
        }
        _ => ()
      }
    }
    i = i + 1
  }
  Ok(Priority::{ urgency: urgency, incremental: incremental })
}

///| Serialize an RFC 9218 HTTP `Priority` header, omitting default parameters
///| (`u=3`, `i=?0`) per RFC 9218 §4.
pub fn serialize_priority(p : Priority) -> Result[String, SfvError] {
  if p.urgency < 0 || p.urgency > 7 {
    return Err(SfvError::InvalidNumber("RFC 9218 priority urgency must be in 0..=7"))
  }
  let members : Array[DictMember] = []
  if p.urgency != 3 {
    members.push(
      DictMember::new("u", ListEntry::Item(Item::bare(BareItem::Integer(p.urgency.to_int64())))),
    )
  }
  if p.incremental {
    members.push(DictMember::new("i", ListEntry::Item(Item::bare(BareItem::Boolean(true)))))
  }
  serialize_dictionary(members)
}

///| Parse a W3C `Permissions-Policy` header into structured directives.
pub fn parse_permissions_policy(
  input : String,
) -> Result[Array[PermissionsDirective], SfvError] {
  let dict = match parse_dictionary(input) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let out : Array[PermissionsDirective] = []
  let mut i = 0
  while i < dict.length() {
    let m = dict[i]
    let mut allow_all = false
    let mut allow_self = false
    let origins : Array[String] = []
    match m.value {
      ListEntry::Item(it) =>
      match it.value {
        BareItem::Token(t) =>
        if t == "*" {
          allow_all = true
        } else if t == "self" {
          allow_self = true
        }
        BareItem::String(orig) => origins.push(orig)
        _ => ()
      }
      ListEntry::InnerList(il) => {
        let mut j = 0
        while j < il.items.length() {
          match il.items[j].value {
            BareItem::Token(t) =>
            if t == "*" {
              allow_all = true
            } else if t == "self" {
              allow_self = true
            }
            BareItem::String(orig) => origins.push(orig)
            _ => ()
          }
          j = j + 1
        }
      }
    }
    out.push(
      PermissionsDirective::{
        feature: m.key,
        allow_all: allow_all,
        allow_self: allow_self,
        origins: origins,
      },
    )
    i = i + 1
  }
  Ok(out)
}
