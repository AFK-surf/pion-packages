///| RFC 9651 §4.2 Structured Field Values parser.
///| Pure Pion zero-copy parser with exact integer arithmetic and explicit limits.

struct Parser {
  input : String
  len : Int
  mut pos : Int
  limits : SfvLimits
  mut has_err : Bool
  mut err : Option[SfvError]
}

struct SpSkipper {
  bytes : Bytes
  len : Int
  mut pos : Int
}

fn SpSkipper::skip(self : SpSkipper) -> Int {
  while self.pos < self.len && self.bytes[self.pos].to_int() == 32 {
    self.pos = self.pos + 1
  }
  self.pos
}

fn validate_limits_fast(limits : SfvLimits) -> Option[SfvError] {
  if limits.max_input_bytes < 0 {
    return Some(SfvError::LimitExceeded("max_input_bytes must be >= 0"))
  }
  if limits.max_list_members < 0 {
    return Some(SfvError::LimitExceeded("max_list_members must be >= 0"))
  }
  if limits.max_inner_list_items < 0 {
    return Some(SfvError::LimitExceeded("max_inner_list_items must be >= 0"))
  }
  if limits.max_dict_members < 0 {
    return Some(SfvError::LimitExceeded("max_dict_members must be >= 0"))
  }
  if limits.max_params < 0 {
    return Some(SfvError::LimitExceeded("max_params must be >= 0"))
  }
  if limits.max_string_bytes < 0 {
    return Some(SfvError::LimitExceeded("max_string_bytes must be >= 0"))
  }
  if limits.max_output_bytes < 0 {
    return Some(SfvError::LimitExceeded("max_output_bytes must be >= 0"))
  }
  None
}

fn finalize_parse_err(input : String, err : SfvError) -> SfvError {
  // RFC 9651 §4.2 step 1: any non-ASCII byte in the input takes precedence as InvalidSyntax.
  let len = input.length()
  let mut i = 0
  while i < len {
    if input.code_unit_at(i) >= 128 {
      return SfvError::InvalidSyntax("non-ASCII byte in structured field input")
    }
    i = i + 1
  }
  err
}

fn Parser::new_unchecked(input : String, limits : SfvLimits) -> Parser {
  Parser::{
    input: input,
    len: input.length(),
    pos: 0,
    limits: limits,
    has_err: false,
    err: None,
  }
}

fn Parser::fail(self : Parser, e : SfvError) -> Unit {
  self.has_err = true
  self.err = Some(e)
}

fn Parser::take_err(self : Parser) -> SfvError {
  match self.err {
    Some(e) => e
    None => SfvError::InvalidSyntax("unexpected parser error")
  }
}

fn Parser::skip_sp(self : Parser) -> Unit {
  if self.pos < self.len {
    let c = self.input.code_unit_at(self.pos)
    if c == 32 || c == 9 {
      let sk = SpSkipper::{ bytes: self.input.to_bytes(), len: self.len, pos: self.pos }
      self.pos = sk.skip()
    }
  }
}

fn Parser::skip_sp_fast(self : Parser) -> Unit {
  let input = self.input
  let len = self.len
  let mut pos = self.pos
  while pos < len && input.code_unit_at(pos) == 32 {
    pos = pos + 1
  }
  self.pos = pos
}

fn Parser::skip_ows(self : Parser) -> Unit {
  let input = self.input
  let len = self.len
  let mut pos = self.pos
  while pos < len {
    let b = input.code_unit_at(pos)
    if b == 32 || b == 9 {
      pos = pos + 1
    } else {
      break
    }
  }
  self.pos = pos
}

///| RFC 9651 §4.2.3.3 Parsing a Key (returns "" on error).
fn Parser::parse_key_raw(self : Parser) -> String {
  let input = self.input
  let len = self.len
  let mut pos = self.pos
  if pos >= len {
    self.fail(SfvError::InvalidKey("unexpected end of input while parsing key"))
    return ""
  }
  let first = input.code_unit_at(pos)
  if !is_key_first(first) {
    self.fail(SfvError::InvalidKey("invalid first character in key"))
    return ""
  }
  let start = pos
  pos = pos + 1
  let lo_mask = sfv_key_char_lo
  let hi_mask = sfv_key_char_hi
  while pos < len {
    let c = input.code_unit_at(pos)
    if c < 64 {
      if ((lo_mask >> c) & 1L) == 0L {
        break
      }
    } else if c < 128 {
      if ((hi_mask >> (c - 64)) & 1L) == 0L {
        break
      }
    } else {
      break
    }
    pos = pos + 1
  }
  self.pos = pos
  if pos - start > self.limits.max_string_bytes {
    self.fail(SfvError::LimitExceeded("key exceeds max_string_bytes"))
    return ""
  }
  input.slice(start, pos)
}

///| RFC 9651 §4.2.4 Parsing an Integer or Decimal.
fn Parser::parse_number_raw(self : Parser) -> BareItem {
  let input = self.input
  let len = self.len
  let mut pos = self.pos
  if pos >= len {
    self.fail(SfvError::InvalidNumber("unexpected end of input while parsing number"))
    return BareItem::Boolean(false)
  }
  let mut negative = false
  if input.code_unit_at(pos) == 45 {
    negative = true
    pos = pos + 1
  }
  if pos >= len || !is_ascii_digit(input.code_unit_at(pos)) {
    self.pos = pos
    self.fail(SfvError::InvalidNumber("expected digit in number"))
    return BareItem::Boolean(false)
  }
  let mut int_digits = 0
  let mut int_val = 0L
  while pos < len {
    let b = input.code_unit_at(pos)
    if b >= 48 && b <= 57 {
      int_digits = int_digits + 1
      if int_digits > 15 {
        self.pos = pos
        self.fail(SfvError::InvalidNumber("integer exceeds 15 digits"))
        return BareItem::Boolean(false)
      }
      int_val = int_val * 10L + (b - 48).to_int64()
      pos = pos + 1
    } else {
      break
    }
  }
  if pos >= len || input.code_unit_at(pos) != 46 {
    self.pos = pos
    let signed = if negative { -int_val } else { int_val }
    if signed < sfv_min_int || signed > sfv_max_int {
      self.fail(SfvError::InvalidNumber("integer out of RFC 9651 range"))
      return BareItem::Boolean(false)
    }
    return BareItem::Integer(signed)
  }
  // Decimal part
  if int_digits > 12 {
    self.pos = pos
    self.fail(SfvError::InvalidNumber("decimal integer part exceeds 12 digits"))
    return BareItem::Boolean(false)
  }
  pos = pos + 1
  let mut frac_digits = 0
  let mut frac_val = 0L
  while pos < len {
    let b = input.code_unit_at(pos)
    if b >= 48 && b <= 57 {
      frac_digits = frac_digits + 1
      if frac_digits > 3 {
        self.pos = pos
        self.fail(SfvError::InvalidNumber("decimal exceeds 3 fractional digits"))
        return BareItem::Boolean(false)
      }
      frac_val = frac_val * 10L + (b - 48).to_int64()
      pos = pos + 1
    } else {
      break
    }
  }
  self.pos = pos
  if frac_digits == 0 {
    self.fail(SfvError::InvalidNumber("decimal missing fractional digits after '.'"))
    return BareItem::Boolean(false)
  }
  let frac_milli = if frac_digits == 1 {
    frac_val * 100L
  } else if frac_digits == 2 {
    frac_val * 10L
  } else {
    frac_val
  }
  let abs_milli = int_val * 1000L + frac_milli
  let signed_milli = if negative { -abs_milli } else { abs_milli }
  if signed_milli < sfv_min_decimal_milli || signed_milli > sfv_max_decimal_milli {
    self.fail(SfvError::InvalidNumber("decimal out of RFC 9651 range"))
    return BareItem::Boolean(false)
  }
  BareItem::Decimal(Decimal::{ scaled_milli: signed_milli })
}

///| RFC 9651 §4.2.5 Parsing a String (zero-copy fast path for unescaped strings).
fn Parser::parse_string_raw(self : Parser) -> BareItem {
  let input = self.input
  let len = self.len
  let max_str = self.limits.max_string_bytes
  let start = self.pos + 1
  let mut pos = start
  while pos < len {
    let b = input.code_unit_at(pos)
    if b == 34 {
      if pos - start > max_str {
        self.pos = pos + 1
        self.fail(SfvError::LimitExceeded("string exceeds max_string_bytes"))
        return BareItem::Boolean(false)
      }
      self.pos = pos + 1
      return BareItem::String(input.slice(start, pos))
    }
    if b == 92 {
      break
    }
    if b < 32 || b > 126 {
      self.pos = pos + 1
      self.fail(SfvError::InvalidString("invalid character in string"))
      return BareItem::Boolean(false)
    }
    pos = pos + 1
  }
  if pos >= len {
    self.pos = pos
    self.fail(SfvError::InvalidString("unterminated string"))
    return BareItem::Boolean(false)
  }
  // Slow path: string contains backslash escape(s).
  let prefix_len = pos - start
  if prefix_len > max_str {
    self.pos = pos
    self.fail(SfvError::LimitExceeded("string exceeds max_string_bytes"))
    return BareItem::Boolean(false)
  }
  let sb = StringBuilder::with_capacity(prefix_len + 16)
  if prefix_len > 0 {
    sb.write_string(input.slice(start, pos))
  }
  let mut out_len = prefix_len
  let mut seg_start = pos
  while pos < len {
    let b = input.code_unit_at(pos)
    if b == 92 {
      if pos > seg_start {
        sb.write_string(input.slice(seg_start, pos))
      }
      pos = pos + 1
      if pos >= len {
        self.pos = pos
        self.fail(SfvError::InvalidString("unterminated escape sequence in string"))
        return BareItem::Boolean(false)
      }
      let next = input.code_unit_at(pos)
      pos = pos + 1
      if next != 34 && next != 92 {
        self.pos = pos
        self.fail(SfvError::InvalidString("invalid escape character in string"))
        return BareItem::Boolean(false)
      }
      out_len = out_len + 1
      if out_len > max_str {
        self.pos = pos
        self.fail(SfvError::LimitExceeded("string exceeds max_string_bytes"))
        return BareItem::Boolean(false)
      }
      sb.write_byte(next.to_byte())
      seg_start = pos
    } else if b == 34 {
      if pos > seg_start {
        sb.write_string(input.slice(seg_start, pos))
      }
      self.pos = pos + 1
      return BareItem::String(sb.to_string())
    } else if b < 32 || b > 126 {
      self.pos = pos + 1
      self.fail(SfvError::InvalidString("invalid character in string"))
      return BareItem::Boolean(false)
    } else {
      out_len = out_len + 1
      if out_len > max_str {
        self.pos = pos + 1
        self.fail(SfvError::LimitExceeded("string exceeds max_string_bytes"))
        return BareItem::Boolean(false)
      }
      pos = pos + 1
    }
  }
  self.pos = pos
  self.fail(SfvError::InvalidString("unterminated string"))
  BareItem::Boolean(false)
}

///| RFC 9651 §4.2.6 Parsing a Token.
fn Parser::parse_token_raw(self : Parser) -> BareItem {
  let input = self.input
  let len = self.len
  let start = self.pos
  let mut pos = start + 1
  let lo_mask = sfv_tok_char_lo
  let hi_mask = sfv_tok_char_hi
  while pos < len {
    let c = input.code_unit_at(pos)
    if c < 64 {
      if ((lo_mask >> c) & 1L) == 0L {
        break
      }
    } else if c < 128 {
      if ((hi_mask >> (c - 64)) & 1L) == 0L {
        break
      }
    } else {
      break
    }
    pos = pos + 1
  }
  self.pos = pos
  if pos - start > self.limits.max_string_bytes {
    self.fail(SfvError::LimitExceeded("token exceeds max_string_bytes"))
    return BareItem::Boolean(false)
  }
  BareItem::Token(input.slice(start, pos))
}

///| RFC 9651 §4.2.7 Parsing a Byte Sequence (`:base64:`).
fn Parser::parse_byte_sequence(self : Parser) -> Result[BareItem, SfvError] {
  let input = self.input
  let len = self.len
  let start = self.pos + 1
  let mut pos = start
  let mut found_end = false
  let mut pad_len = 0
  let mut data_len = 0
  let tbl = "                                           _   `UVWXYZ[\\]^       !\"#$%&'()*+,-./0123456789:      ;<=>?@ABCDEFGHIJKLMNOPQRST     "
  while pos < len {
    let b = input.code_unit_at(pos)
    if b == 58 {
      found_end = true
      break
    }
    if b == 61 {
      pad_len = pad_len + 1
    } else if b < 128 && tbl.code_unit_at(b) > 32 {
      if pad_len > 0 {
        self.pos = pos
        return Err(SfvError::InvalidByteSequence("base64 padding before data character"))
      }
      data_len = data_len + 1
    } else {
      self.pos = pos
      return Err(SfvError::InvalidByteSequence("invalid base64 character in byte sequence"))
    }
    pos = pos + 1
  }
  if !found_end {
    self.pos = pos
    return Err(SfvError::InvalidByteSequence("unterminated byte sequence"))
  }
  // Consume closing ':'
  self.pos = pos + 1
  let rem = data_len & 3
  if rem == 1 {
    return Err(SfvError::InvalidByteSequence("invalid base64 length"))
  }
  let max_pad = if rem == 0 { 0 } else { 4 - rem }
  if pad_len > max_pad {
    return Err(SfvError::InvalidByteSequence("excess base64 padding characters"))
  }
  let full_groups = data_len >> 2
  let out_len = full_groups * 3 +
  if rem == 2 {
    1
  } else if rem == 3 {
    2
  } else {
    0
  }
  if out_len > self.limits.max_string_bytes {
    return Err(SfvError::LimitExceeded("byte sequence exceeds max_string_bytes"))
  }
  let out = Bytes::new(out_len)
  let mut src = start
  let mut dst = 0
  let mut g = 0
  while g < full_groups {
    let v0 = tbl.code_unit_at(input.code_unit_at(src)) - 33
    let v1 = tbl.code_unit_at(input.code_unit_at(src + 1)) - 33
    let v2 = tbl.code_unit_at(input.code_unit_at(src + 2)) - 33
    let v3 = tbl.code_unit_at(input.code_unit_at(src + 3)) - 33
    out[dst] = (v0 << 2 | v1 >> 4).to_byte()
    out[dst + 1] = ((v1 & 15) << 4 | v2 >> 2).to_byte()
    out[dst + 2] = ((v2 & 3) << 6 | v3).to_byte()
    src = src + 4
    dst = dst + 3
    g = g + 1
  }
  if rem == 2 {
    let v0 = tbl.code_unit_at(input.code_unit_at(src)) - 33
    let v1 = tbl.code_unit_at(input.code_unit_at(src + 1)) - 33
    out[dst] = (v0 << 2 | v1 >> 4).to_byte()
  } else if rem == 3 {
    let v0 = tbl.code_unit_at(input.code_unit_at(src)) - 33
    let v1 = tbl.code_unit_at(input.code_unit_at(src + 1)) - 33
    let v2 = tbl.code_unit_at(input.code_unit_at(src + 2)) - 33
    out[dst] = (v0 << 2 | v1 >> 4).to_byte()
    out[dst + 1] = ((v1 & 15) << 4 | v2 >> 2).to_byte()
  }
  Ok(BareItem::ByteSequence(out))
}

///| RFC 9651 §4.2.8 Parsing a Boolean (`?1` / `?0`).
fn Parser::parse_boolean_raw(self : Parser) -> BareItem {
  let pos = self.pos + 1
  if pos >= self.len {
    self.pos = pos
    self.fail(SfvError::InvalidBoolean("unexpected end of input after '?'"))
    return BareItem::Boolean(false)
  }
  let b = self.input.code_unit_at(pos)
  self.pos = pos + 1
  if b == 49 {
    BareItem::Boolean(true)
  } else if b == 48 {
    BareItem::Boolean(false)
  } else {
    self.fail(SfvError::InvalidBoolean("expected '0' or '1' after '?'"))
    BareItem::Boolean(false)
  }
}

///| RFC 9651 §4.2.9 Parsing a Date (`@<integer>`).
fn Parser::parse_date_raw(self : Parser) -> BareItem {
  self.pos = self.pos + 1
  let v = self.parse_number_raw()
  if self.has_err {
    self.fail(SfvError::InvalidDate("invalid integer in date"))
    return BareItem::Boolean(false)
  }
  match v {
    BareItem::Integer(n) => BareItem::Date(n)
    _ => {
      self.fail(SfvError::InvalidDate("date must be an integer, not decimal"))
      BareItem::Boolean(false)
    }
  }
}

///| RFC 9651 §4.2.10 Parsing a Display String (`%"..."`).
fn Parser::parse_display_string_raw(self : Parser) -> BareItem {
  let input = self.input
  let len = self.len
  let max_str = self.limits.max_string_bytes
  let mut pos = self.pos + 1
  if pos >= len || input.code_unit_at(pos) != 34 {
    self.pos = pos
    self.fail(SfvError::InvalidDisplayString("expected '\"' after '%'"))
    return BareItem::Boolean(false)
  }
  pos = pos + 1
  let start = pos
  // Fast path: pure printable ASCII without '%' escapes.
  while pos < len {
    let b = input.code_unit_at(pos)
    if b == 34 {
      if pos - start > max_str {
        self.pos = pos + 1
        self.fail(SfvError::LimitExceeded("display string exceeds max_string_bytes"))
        return BareItem::Boolean(false)
      }
      self.pos = pos + 1
      return BareItem::DisplayString(input.slice(start, pos))
    }
    if b == 37 {
      break
    }
    if b < 32 || b > 126 {
      self.pos = pos + 1
      self.fail(SfvError::InvalidDisplayString("invalid unescaped byte in display string"))
      return BareItem::Boolean(false)
    }
    pos = pos + 1
  }
  if pos >= len {
    self.pos = pos
    self.fail(SfvError::InvalidDisplayString("unterminated display string"))
    return BareItem::Boolean(false)
  }
  // Slow path: percent-escaped display string; scan to validate & compute exact byte length.
  let mut scan = pos
  let mut out_len = pos - start
  if out_len > max_str {
    self.pos = pos
    self.fail(SfvError::LimitExceeded("display string exceeds max_string_bytes"))
    return BareItem::Boolean(false)
  }
  let mut found_end = false
  while scan < len {
    let b = input.code_unit_at(scan)
    if b < 32 || b > 126 {
      self.pos = scan + 1
      self.fail(SfvError::InvalidDisplayString("invalid unescaped byte in display string"))
      return BareItem::Boolean(false)
    }
    if b == 34 {
      found_end = true
      break
    }
    if b == 37 {
      if scan + 2 >= len {
        self.pos = len
        self.fail(SfvError::InvalidDisplayString("truncated percent-escape in display string"))
        return BareItem::Boolean(false)
      }
      let hi = hex_lower_val(input.code_unit_at(scan + 1))
      let lo = hex_lower_val(input.code_unit_at(scan + 2))
      if hi < 0 || lo < 0 {
        self.pos = scan + 3
        self.fail(
          SfvError::InvalidDisplayString(
            "invalid hex escape in display string (must be lowercase 0-9a-f)",
          ),
        )
        return BareItem::Boolean(false)
      }
      out_len = out_len + 1
      if out_len > max_str {
        self.pos = scan + 3
        self.fail(SfvError::LimitExceeded("display string exceeds max_string_bytes"))
        return BareItem::Boolean(false)
      }
      scan = scan + 3
    } else {
      out_len = out_len + 1
      if out_len > max_str {
        self.pos = scan + 1
        self.fail(SfvError::LimitExceeded("display string exceeds max_string_bytes"))
        return BareItem::Boolean(false)
      }
      scan = scan + 1
    }
  }
  if !found_end {
    self.pos = scan
    self.fail(SfvError::InvalidDisplayString("unterminated display string"))
    return BareItem::Boolean(false)
  }
  let end_pos = scan
  self.pos = end_pos + 1
  let buf = Bytes::new(out_len)
  let mut src = start
  let mut dst = 0
  while src < end_pos {
    let b = input.code_unit_at(src)
    if b == 37 {
      let c1 = input.code_unit_at(src + 1)
      let c2 = input.code_unit_at(src + 2)
      let hi = (c1 & 15) + (c1 >> 6) * 9
      let lo = (c2 & 15) + (c2 >> 6) * 9
      buf[dst] = (hi * 16 + lo).to_byte()
      src = src + 3
    } else {
      buf[dst] = b.to_byte()
      src = src + 1
    }
    dst = dst + 1
  }
  if !is_valid_utf8_bytes(buf) {
    self.fail(SfvError::InvalidDisplayString("decoded display string is not valid UTF-8"))
    return BareItem::Boolean(false)
  }
  BareItem::DisplayString(buf.to_string())
}

///| RFC 9651 §4.2.3.1 Parsing a Bare Item.
fn Parser::parse_bare_item_raw(self : Parser) -> BareItem {
  if self.pos >= self.len {
    self.fail(SfvError::InvalidSyntax("unexpected end of input while parsing bare item"))
    return BareItem::Boolean(false)
  }
  let b = self.input.code_unit_at(self.pos)
  if b == 45 || (b >= 48 && b <= 57) {
    self.parse_number_raw()
  } else if b == 34 {
    self.parse_string_raw()
  } else if is_token_first(b) {
    self.parse_token_raw()
  } else if b == 58 {
    match self.parse_byte_sequence() {
      Ok(v) => v
      Err(e) => {
        self.fail(e)
        BareItem::Boolean(false)
      }
    }
  } else if b == 63 {
    self.parse_boolean_raw()
  } else if b == 64 {
    self.parse_date_raw()
  } else if b == 37 {
    self.parse_display_string_raw()
  } else {
    self.fail(SfvError::InvalidSyntax("unexpected character starting bare item"))
    BareItem::Boolean(false)
  }
}

///| RFC 9651 §4.2.3.2 Parsing Parameters (O(1) duplicate overwrite via lazy Map).
fn Parser::parse_params_raw(self : Parser) -> Array[Param] {
  let input = self.input
  let len = self.len
  if self.pos >= len || input.code_unit_at(self.pos) != 59 {
    return []
  }
  let params : Array[Param] = Array::with_capacity(2)
  let mut index : Option[Map[String, Int]] = None
  while self.pos < len && input.code_unit_at(self.pos) == 59 {
    self.pos = self.pos + 1
    self.skip_sp_fast()
    let key = self.parse_key_raw()
    if self.has_err {
      return []
    }
    let value = if self.pos < len && input.code_unit_at(self.pos) == 61 {
      self.pos = self.pos + 1
      let v = self.parse_bare_item_raw()
      if self.has_err {
        return []
      }
      v
    } else {
      BareItem::Boolean(true)
    }
    if params.length() == 0 {
      if self.limits.max_params == 0 {
        self.fail(SfvError::LimitExceeded("parameters exceed max_params"))
        return []
      }
      params.push(Param::{ key: key, value: value })
    } else {
      let existing = match index {
        Some(m) => m.get(key)
        None => {
          let mut found : Option[Int] = None
          let mut i = 0
          let pn = params.length()
          let klen = key.length()
          while i < pn {
            let pk = params[i].key
            if pk.length() == klen && pk == key {
              found = Some(i)
              break
            }
            i = i + 1
          }
          found
        }
      }
      match existing {
        Some(idx) => params[idx] = Param::new(key, value)
        None => {
          if params.length() >= self.limits.max_params {
            self.fail(SfvError::LimitExceeded("parameters exceed max_params"))
            return []
          }
          let new_idx = params.length()
          params.push(Param::{ key: key, value: value })
          match index {
            Some(m) => m.set(key, new_idx)
            None =>
            if params.length() == 16 {
              let m : Map[String, Int] = Map::new()
              let mut j = 0
              while j < params.length() {
                m.set(params[j].key, j)
                j = j + 1
              }
              index = Some(m)
            }
          }
        }
      }
    }
  }
  params
}

///| RFC 9651 §4.2.3 Parsing an Item.
fn Parser::parse_item_inner_raw(self : Parser) -> Item {
  let bare = self.parse_bare_item_raw()
  if self.has_err {
    return Item::{ value: bare, params: [] }
  }
  if self.pos < self.len && self.input.code_unit_at(self.pos) == 59 {
    let params = self.parse_params_raw()
    Item::{ value: bare, params: params }
  } else {
    Item::{ value: bare, params: [] }
  }
}

///| RFC 9651 §4.2.1.2 Parsing an Inner List.
fn Parser::parse_inner_list_raw(self : Parser) -> InnerList {
  let input = self.input
  let len = self.len
  // Consume '('
  self.pos = self.pos + 1
  self.skip_sp_fast()
  if self.pos >= len {
    self.fail(SfvError::InvalidSyntax("unterminated inner list"))
    return InnerList::{ items: [], params: [] }
  }
  if input.code_unit_at(self.pos) == 41 {
    self.pos = self.pos + 1
    let params = if self.pos < len && input.code_unit_at(self.pos) == 59 {
      self.parse_params_raw()
    } else {
      []
    }
    return InnerList::{ items: [], params: params }
  }
  let items : Array[Item] = Array::with_capacity(4)
  while self.pos < len {
    if items.length() >= self.limits.max_inner_list_items {
      self.fail(SfvError::LimitExceeded("inner list exceeds max_inner_list_items"))
      return InnerList::{ items: [], params: [] }
    }
    let item = self.parse_item_inner_raw()
    if self.has_err {
      return InnerList::{ items: [], params: [] }
    }
    items.push(item)
    if self.pos >= len {
      self.fail(SfvError::InvalidSyntax("unterminated inner list"))
      return InnerList::{ items: [], params: [] }
    }
    let next = input.code_unit_at(self.pos)
    if next != 32 && next != 41 {
      self.fail(SfvError::InvalidSyntax("expected SP or ')' after inner list item"))
      return InnerList::{ items: [], params: [] }
    }
    self.skip_sp_fast()
    if self.pos >= len {
      self.fail(SfvError::InvalidSyntax("unterminated inner list"))
      return InnerList::{ items: [], params: [] }
    }
    if input.code_unit_at(self.pos) == 41 {
      self.pos = self.pos + 1
      let params = if self.pos < len && input.code_unit_at(self.pos) == 59 {
        self.parse_params_raw()
      } else {
        []
      }
      return InnerList::{ items: items, params: params }
    }
  }
  self.fail(SfvError::InvalidSyntax("unterminated inner list"))
  InnerList::{ items: [], params: [] }
}

///| RFC 9651 §4.2.1.1 Parsing an Item or Inner List.
fn Parser::parse_item_or_inner_list_raw(self : Parser) -> ListEntry {
  if self.pos < self.len && self.input.code_unit_at(self.pos) == 40 {
    ListEntry::InnerList(self.parse_inner_list_raw())
  } else {
    ListEntry::Item(self.parse_item_inner_raw())
  }
}

fn join_field_lines(
  fields : Array[String],
  max_input_bytes : Int,
) -> Result[String, SfvError] {
  let n = fields.length()
  if n == 0 {
    return Ok("")
  }
  if n == 1 {
    if fields[0].length() > max_input_bytes {
      return Err(SfvError::LimitExceeded("input exceeds max_input_bytes"))
    }
    return Ok(fields[0])
  }
  let mut total = 0
  let mut i = 0
  while i < n {
    let flen = fields[i].length()
    if i > 0 {
      if total > max_input_bytes - 2 {
        return Err(SfvError::LimitExceeded("combined fields exceed max_input_bytes"))
      }
      total = total + 2
    }
    if flen > max_input_bytes - total {
      return Err(SfvError::LimitExceeded("combined fields exceed max_input_bytes"))
    }
    total = total + flen
    i = i + 1
  }
  let sb = StringBuilder::with_capacity(total)
  let mut j = 0
  while j < n {
    if j > 0 {
      sb.write_string(", ")
    }
    sb.write_string(fields[j])
    j = j + 1
  }
  Ok(sb.to_string())
}

// ---------------------------------------------------------------------------
// Public Parsing API
// ---------------------------------------------------------------------------

fn parse_item_unchecked(
  input : String,
  limits : SfvLimits,
) -> Result[Item, SfvError] {
  if input.length() > limits.max_input_bytes {
    return Err(SfvError::LimitExceeded("input exceeds max_input_bytes"))
  }
  let p = Parser::new_unchecked(input, limits)
  p.skip_sp()
  if p.pos >= p.len {
    return Err(finalize_parse_err(input, SfvError::InvalidSyntax("empty input for item")))
  }
  let item = p.parse_item_inner_raw()
  if p.has_err {
    return Err(finalize_parse_err(input, p.take_err()))
  }
  p.skip_sp()
  if p.pos < p.len {
    return Err(
      finalize_parse_err(input, SfvError::TrailingData("unexpected trailing data after item")),
    )
  }
  Ok(item)
}

///| Parse an RFC 9651 Item using default limits.
pub fn parse_item(input : String) -> Result[Item, SfvError] {
  parse_item_unchecked(input, SfvLimits::default())
}

///| Parse an RFC 9651 Item with explicit `SfvLimits`.
pub fn parse_item_with_limits(
  input : String,
  limits : SfvLimits,
) -> Result[Item, SfvError] {
  match validate_limits_fast(limits) {
    Some(e) => return Err(e)
    None => ()
  }
  parse_item_unchecked(input, limits)
}

fn parse_list_unchecked(
  input : String,
  limits : SfvLimits,
) -> Result[Array[ListEntry], SfvError] {
  if input.length() > limits.max_input_bytes {
    return Err(SfvError::LimitExceeded("input exceeds max_input_bytes"))
  }
  let p = Parser::new_unchecked(input, limits)
  p.skip_sp()
  if p.pos >= p.len {
    return Ok([])
  }
  let init_cap = if p.len < 32 { 2 } else if p.len < 128 { 4 } else { 8 }
  let members : Array[ListEntry] = Array::with_capacity(init_cap)
  while p.pos < p.len {
    if members.length() >= p.limits.max_list_members {
      return Err(
        finalize_parse_err(input, SfvError::LimitExceeded("list exceeds max_list_members")),
      )
    }
    let entry = p.parse_item_or_inner_list_raw()
    if p.has_err {
      return Err(finalize_parse_err(input, p.take_err()))
    }
    members.push(entry)
    p.skip_ows()
    if p.pos >= p.len {
      break
    }
    if input.code_unit_at(p.pos) != 44 {
      return Err(
        finalize_parse_err(input, SfvError::TrailingData("expected ',' between list members")),
      )
    }
    p.pos = p.pos + 1
    p.skip_ows()
    if p.pos >= p.len {
      return Err(
        finalize_parse_err(input, SfvError::InvalidSyntax("trailing comma in list")),
      )
    }
  }
  Ok(members)
}

///| Parse an RFC 9651 List using default limits.
pub fn parse_list(input : String) -> Result[Array[ListEntry], SfvError] {
  parse_list_unchecked(input, SfvLimits::default())
}

///| Parse an RFC 9651 List with explicit `SfvLimits`.
pub fn parse_list_with_limits(
  input : String,
  limits : SfvLimits,
) -> Result[Array[ListEntry], SfvError] {
  match validate_limits_fast(limits) {
    Some(e) => return Err(e)
    None => ()
  }
  parse_list_unchecked(input, limits)
}

///| Parse multiple HTTP field lines as a combined RFC 9651 List using default limits.
pub fn parse_list_fields(fields : Array[String]) -> Result[Array[ListEntry], SfvError] {
  parse_list_fields_with_limits(fields, SfvLimits::default())
}

///| Parse multiple HTTP field lines as a combined RFC 9651 List with explicit `SfvLimits`.
pub fn parse_list_fields_with_limits(
  fields : Array[String],
  limits : SfvLimits,
) -> Result[Array[ListEntry], SfvError] {
  match validate_limits_fast(limits) {
    Some(e) => return Err(e)
    None => ()
  }
  if fields.length() == 0 {
    return Ok([])
  }
  let joined = match join_field_lines(fields, limits.max_input_bytes) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  parse_list_unchecked(joined, limits)
}

fn parse_dictionary_unchecked(
  input : String,
  limits : SfvLimits,
) -> Result[Array[DictMember], SfvError] {
  if input.length() > limits.max_input_bytes {
    return Err(SfvError::LimitExceeded("input exceeds max_input_bytes"))
  }
  let p = Parser::new_unchecked(input, limits)
  p.skip_sp()
  if p.pos >= p.len {
    return Ok([])
  }
  let init_cap = if p.len < 32 { 2 } else if p.len < 128 { 4 } else { 8 }
  let members : Array[DictMember] = Array::with_capacity(init_cap)
  let mut index : Option[Map[String, Int]] = None
  while p.pos < p.len {
    let key = p.parse_key_raw()
    if p.has_err {
      return Err(finalize_parse_err(input, p.take_err()))
    }
    let value = if p.pos < p.len && input.code_unit_at(p.pos) == 61 {
      p.pos = p.pos + 1
      let v = p.parse_item_or_inner_list_raw()
      if p.has_err {
        return Err(finalize_parse_err(input, p.take_err()))
      }
      v
    } else {
      let params = if p.pos < p.len && input.code_unit_at(p.pos) == 59 {
        let ps = p.parse_params_raw()
        if p.has_err {
          return Err(finalize_parse_err(input, p.take_err()))
        }
        ps
      } else {
        []
      }
      ListEntry::Item(Item::{ value: BareItem::Boolean(true), params: params })
    }
    if members.length() == 0 {
      if p.limits.max_dict_members == 0 {
        return Err(
          finalize_parse_err(
            input,
            SfvError::LimitExceeded("dictionary exceeds max_dict_members"),
          ),
        )
      }
      members.push(DictMember::{ key: key, value: value })
    } else {
      let existing = match index {
        Some(m) => m.get(key)
        None => {
          let mut found : Option[Int] = None
          let mut i = 0
          let mn = members.length()
          let klen = key.length()
          while i < mn {
            let mk = members[i].key
            if mk.length() == klen && mk == key {
              found = Some(i)
              break
            }
            i = i + 1
          }
          found
        }
      }
      match existing {
        Some(idx) => members[idx] = DictMember::new(key, value)
        None => {
          if members.length() >= p.limits.max_dict_members {
            return Err(
              finalize_parse_err(
                input,
                SfvError::LimitExceeded("dictionary exceeds max_dict_members"),
              ),
            )
          }
          let new_idx = members.length()
          members.push(DictMember::{ key: key, value: value })
          match index {
            Some(m) => m.set(key, new_idx)
            None =>
            if members.length() == 16 {
              let m : Map[String, Int] = Map::new()
              let mut j = 0
              while j < members.length() {
                m.set(members[j].key, j)
                j = j + 1
              }
              index = Some(m)
            }
          }
        }
      }
    }
    p.skip_ows()
    if p.pos >= p.len {
      break
    }
    if input.code_unit_at(p.pos) != 44 {
      return Err(
        finalize_parse_err(
          input,
          SfvError::TrailingData("expected ',' between dictionary members"),
        ),
      )
    }
    p.pos = p.pos + 1
    p.skip_ows()
    if p.pos >= p.len {
      return Err(
        finalize_parse_err(input, SfvError::InvalidSyntax("trailing comma in dictionary")),
      )
    }
  }
  Ok(members)
}

///| Parse an RFC 9651 Dictionary using default limits.
pub fn parse_dictionary(input : String) -> Result[Array[DictMember], SfvError] {
  parse_dictionary_unchecked(input, SfvLimits::default())
}

///| Parse an RFC 9651 Dictionary with explicit `SfvLimits`.
///| Duplicate keys overwrite their value in place while preserving first-seen order
///| (RFC 9651 §4.2.2) in O(1) amortized time.
pub fn parse_dictionary_with_limits(
  input : String,
  limits : SfvLimits,
) -> Result[Array[DictMember], SfvError] {
  match validate_limits_fast(limits) {
    Some(e) => return Err(e)
    None => ()
  }
  parse_dictionary_unchecked(input, limits)
}

///| Parse multiple HTTP field lines as a combined RFC 9651 Dictionary using default limits.
pub fn parse_dictionary_fields(
  fields : Array[String],
) -> Result[Array[DictMember], SfvError] {
  parse_dictionary_fields_with_limits(fields, SfvLimits::default())
}

///| Parse multiple HTTP field lines as a combined RFC 9651 Dictionary with explicit `SfvLimits`.
pub fn parse_dictionary_fields_with_limits(
  fields : Array[String],
  limits : SfvLimits,
) -> Result[Array[DictMember], SfvError] {
  match validate_limits_fast(limits) {
    Some(e) => return Err(e)
    None => ()
  }
  if fields.length() == 0 {
    return Ok([])
  }
  let joined = match join_field_lines(fields, limits.max_input_bytes) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  parse_dictionary_unchecked(joined, limits)
}
