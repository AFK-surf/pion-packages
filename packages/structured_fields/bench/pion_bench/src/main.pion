///| Pion Native benchmark & IETF RFC 9651 differential cross-check driver for
///| `packages/structured_fields`.
///|
///| Modes:
///|   bench <corpus_file> <iters>   - parse + serialize every corpus line `iters` times
///|   diff  <ietf_vectors_file>     - parse + serialize every hex-encoded vector

import "structured_fields"

struct CaseLine {
  kind : String
  raw : String
  meta : String
}

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

fn decode_hex_string(hex : String) -> String {
  let n = hex.length() / 2
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let hi = hex_val(hex.code_unit_at(i * 2))
    let lo = hex_val(hex.code_unit_at(i * 2 + 1))
    sb.write_byte((hi * 16 + lo).to_byte())
    i = i + 1
  }
  sb.to_string()
}

fn slice_bytes(b : Bytes, start : Int, end : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = start
  while i < end {
    sb.write_byte(b[i])
    i = i + 1
  }
  sb.to_string()
}

fn load_corpus(data : Bytes) -> Array[CaseLine] {
  let out : Array[CaseLine] = []
  let n = data.length()
  let mut pos = 0
  while pos < n {
    let mut eol = pos
    while eol < n && data[eol].to_int() != 10 {
      eol = eol + 1
    }
    if eol > pos {
      let mut tab = pos
      while tab < eol && data[tab].to_int() != 9 {
        tab = tab + 1
      }
      if tab < eol {
        let kind = slice_bytes(data, pos, tab)
        let raw = slice_bytes(data, tab + 1, eol)
        out.push(CaseLine::{ kind: kind, raw: raw, meta: "" })
      }
    }
    pos = eol + 1
  }
  out
}

fn load_vectors(data : Bytes) -> Array[CaseLine] {
  let out : Array[CaseLine] = []
  let n = data.length()
  let mut pos = 0
  while pos < n {
    let mut eol = pos
    while eol < n && data[eol].to_int() != 10 {
      eol = eol + 1
    }
    if eol > pos {
      let mut t1 = pos
      while t1 < eol && data[t1].to_int() != 9 {
        t1 = t1 + 1
      }
      let mut t2 = t1 + 1
      while t2 < eol && data[t2].to_int() != 9 {
        t2 = t2 + 1
      }
      let mut t3 = t2 + 1
      while t3 < eol && data[t3].to_int() != 9 {
        t3 = t3 + 1
      }
      if t3 < eol {
        let kind = slice_bytes(data, pos, t1)
        let flags = slice_bytes(data, t1 + 1, t2)
        let raw_hex = slice_bytes(data, t2 + 1, t3)
        let name = slice_bytes(data, t3 + 1, eol)
        out.push(CaseLine::{ kind: kind, raw: decode_hex_string(raw_hex), meta: flags + "|" + name })
      }
    }
    pos = eol + 1
  }
  out
}

fn roundtrip_one(kind : String, raw : String) -> Result[String, structured_fields::SfvError] {
  if kind == "item" {
    match structured_fields::parse_item(raw) {
      Ok(it) => structured_fields::serialize_item(it)
      Err(e) => Err(e)
    }
  } else if kind == "list" {
    match structured_fields::parse_list(raw) {
      Ok(l) => structured_fields::serialize_list(l)
      Err(e) => Err(e)
    }
  } else {
    match structured_fields::parse_dictionary(raw) {
      Ok(d) => structured_fields::serialize_dictionary(d)
      Err(e) => Err(e)
    }
  }
}

fn fnv1a_32_update(h : UInt, s : String) -> UInt {
  let b = s.to_bytes()
  let n = b.length()
  let mut cur = h
  let mut i = 0
  while i < n {
    cur = (cur ^ b[i].to_int().to_uint()) * 16777619U
    i = i + 1
  }
  cur
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: structured_fields_bench <bench|diff> <file> [iters]")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }
  if mode == "diff" {
    let vecs = load_vectors(data)
    let mut i = 0
    while i < vecs.length() {
      let v = vecs[i]
      match roundtrip_one(v.kind, v.raw) {
        Ok(canon) => io_println(world, v.meta + "\tOK\t" + canon)
        Err(_) => io_println(world, v.meta + "\tERR")
      }
      i = i + 1
    }
    return 0
  }
  let iters = if args.length() >= 4 { parse_int(args[3]) } else { 1000 }
  let cases = load_corpus(data)
  let mut h : UInt = 2166136261U
  let mut total_bytes = 0L
  let mut ok_count = 0L
  let mut it = 0
  while it < iters {
    let mut i = 0
    while i < cases.length() {
      let c = cases[i]
      match roundtrip_one(c.kind, c.raw) {
        Ok(canon) => {
          ok_count = ok_count + 1L
          total_bytes = total_bytes + canon.length().to_int64()
          if it == 0 {
            h = fnv1a_32_update(h, canon)
            h = fnv1a_32_update(h, "\n")
          }
        }
        Err(_) => {
          io_println(world, "ERR on case " + i.to_string())
          return 2
        }
      }
      i = i + 1
    }
    it = it + 1
  }
  io_println(
    world,
    "cases=" +
    cases.length().to_string() +
    " iters=" +
    iters.to_string() +
    " ok=" +
    ok_count.to_string() +
    " out_bytes=" +
    total_bytes.to_string() +
    " fnv32=" +
    h.to_int64().to_string(),
  )
  0
}
