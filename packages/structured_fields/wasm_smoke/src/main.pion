///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for
///| `packages/structured_fields`. Emits deterministic stdout for cross-mode
///| SHA-256 verification and exits 0 on success.

import "structured_fields"

fn check_item(world : World, label : String, raw : String, expect : String) -> Int {
  match structured_fields::parse_item(raw) {
    Ok(it) =>
    match structured_fields::serialize_item(it) {
      Ok(out) =>
      if out == expect {
        io_println(world, "item:" + label + "=" + out)
        0
      } else {
        io_println(world, "ERR item " + label + " got=" + out + " want=" + expect)
        1
      }
      Err(e) => {
        io_println(world, "ERR ser " + label + ": " + structured_fields::sfv_error_message(e))
        2
      }
    }
    Err(e) => {
      io_println(world, "ERR parse " + label + ": " + structured_fields::sfv_error_message(e))
      3
    }
  }
}

pub fn main(world : World) -> Int {
  if check_item(world, "int", "-00042;a=1;b=?1", "-42;a=1;b") != 0 {
    return 10
  }
  if check_item(world, "dec", "-0.000;r=1.230", "0.0;r=1.23") != 0 {
    return 11
  }
  if check_item(world, "str", "\"hi \\\"world\\\\\"", "\"hi \\\"world\\\\\"") != 0 {
    return 12
  }
  if check_item(world, "tok", "*foo:bar/baz;x=?0", "*foo:bar/baz;x=?0") != 0 {
    return 13
  }
  if check_item(world, "bin", ":aGVsbG8=:", ":aGVsbG8=:") != 0 {
    return 14
  }
  if check_item(world, "date", "@1659578233", "@1659578233") != 0 {
    return 15
  }
  if check_item(world, "disp", "%\"f%c3%bc%c3%bc %22ok%22\"", "%\"f%c3%bc%c3%bc %22ok%22\"") != 0 {
    return 16
  }

  // List with inner lists
  match structured_fields::parse_list("(\"foo\" \"bar\");lvl=5, sugar, ()") {
    Ok(list) =>
    match structured_fields::serialize_list(list) {
      Ok(out) => io_println(world, "list=" + out)
      Err(_) => return 20
    }
    Err(_) => return 21
  }

  // Dictionary with duplicate key overwrite + multi-header joining
  match structured_fields::parse_dictionary_fields(["a=1, b=2", "a=9, c;k=?1"]) {
    Ok(dict) =>
    match structured_fields::serialize_dictionary(dict) {
      Ok(out) => io_println(world, "dict=" + out)
      Err(_) => return 22
    }
    Err(_) => return 23
  }

  // Browser helpers
  match structured_fields::parse_priority("u=1, i") {
    Ok(p) =>
    match structured_fields::serialize_priority(p) {
      Ok(out) => io_println(world, "priority=" + out)
      Err(_) => return 24
    }
    Err(_) => return 25
  }

  // Security rejections
  let bad_upper_disp = match structured_fields::parse_item("%\"%C3%BC\"") {
    Err(_) => true
    Ok(_) => false
  }
  let bad_neg_limit = match structured_fields::parse_item_with_limits(
    "1",
    structured_fields::SfvLimits::new(-1, 10, 10, 10, 10, 10, 10),
  ) {
    Err(_) => true
    Ok(_) => false
  }
  if !bad_upper_disp || !bad_neg_limit {
    io_println(world, "ERR security checks failed")
    return 30
  }

  io_println(world, "structured_fields_wasm_smoke:ok")
  0
}
