///| RFC 7578 / 2046 Multipart streaming reader and writer test suite
///| (ported from Go 1.27 `mime/multipart` + nested & LF/CRLF compliance vectors).

///|
fn bytes_eq_mp(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn opt_str_eq_mp(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///|
test "multipart_reader_basic_crlf_and_preamble_epilogue" {
  let raw = "This is the preamble.\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"field1\"\r\n\r\nvalue1\r\n--MyBoundary\r\nContent-Disposition: form-data; name=\"file1\"; filename=\"hello.txt\"\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nHello, World!\r\nLine 2\r\n--MyBoundary--\r\nThis is the epilogue."
  let reader = match MultipartReader::new(raw.to_bytes(), "MyBoundary") {
    Ok(r) => r
    Err(_) => {
      debug_assert(false, "MultipartReader::new failed")
      return
    }
  }
  let parts = match reader.read_all() {
    Ok(ps) => ps
    Err(_) => {
      debug_assert(false, "read_all failed")
      return
    }
  }
  debug_assert(parts.length() == 2, "expected 2 parts")
  debug_assert(opt_str_eq_mp(parts[0].form_name(), Some("field1")), "part 0 form_name")
  debug_assert(parts[0].body_string() == "value1", "part 0 body")
  debug_assert(opt_str_eq_mp(parts[1].form_name(), Some("file1")), "part 1 form_name")
  debug_assert(opt_str_eq_mp(parts[1].filename(), Some("hello.txt")), "part 1 filename")
  debug_assert(opt_str_eq_mp(parts[1].content_type(), Some("text/plain; charset=utf-8")), "part 1 ct")
  debug_assert(parts[1].body_string() == "Hello, World!\r\nLine 2", "part 1 body")
  debug_assert(reader.preamble().to_string() == "This is the preamble.", "preamble")
  debug_assert(reader.epilogue().to_string() == "\r\nThis is the epilogue.", "epilogue")
}

///|
test "multipart_reader_lf_only_and_transport_padding" {
  // LF-only line endings and trailing spaces/tabs after boundary (RFC 2046 §5.1.1)
  let raw = "--foo   \t\nHeader1: value1\n\nBody with\nmultiple lines\n--foo\n\nEmpty headers body\n--foo--  \n"
  let reader = match MultipartReader::new(raw.to_bytes(), "foo") {
    Ok(r) => r
    Err(_) => {
      debug_assert(false, "MultipartReader::new LF failed")
      return
    }
  }
  let parts = match reader.read_all() {
    Ok(ps) => ps
    Err(_) => {
      debug_assert(false, "read_all LF failed")
      return
    }
  }
  debug_assert(parts.length() == 2, "2 parts")
  debug_assert(opt_str_eq_mp(parts[0].header("header1"), Some("value1")), "header1")
  debug_assert(parts[0].body_string() == "Body with\nmultiple lines", "body 0")
  debug_assert(parts[1].headers.length() == 0, "0 headers on part 1")
  debug_assert(parts[1].body_string() == "Empty headers body", "body 1")
}

///|
test "multipart_reader_nested_multipart" {
  let inner = "--innerB\r\nContent-Type: text/plain\r\n\r\nInner A\r\n--innerB\r\nContent-Type: text/html\r\n\r\n<b>Inner B</b>\r\n--innerB--"
  let outer = "--outerB\r\nContent-Type: multipart/mixed; boundary=innerB\r\n\r\n" + inner + "\r\n--outerB\r\nContent-Type: text/plain\r\n\r\nOuter Tail\r\n--outerB--"
  let r_outer = match MultipartReader::new(outer.to_bytes(), "outerB") {
    Ok(r) => r
    Err(_) => {
      debug_assert(false, "outer reader failed")
      return
    }
  }
  let outer_parts = match r_outer.read_all() {
    Ok(ps) => ps
    Err(_) => {
      debug_assert(false, "outer read_all failed")
      return
    }
  }
  debug_assert(outer_parts.length() == 2, "2 outer parts")
  debug_assert(outer_parts[1].body_string() == "Outer Tail", "outer tail")

  let ct_str = match outer_parts[0].content_type() {
    Some(s) => s
    None => {
      debug_assert(false, "missing inner ct")
      return
    }
  }
  let inner_b = match parse_media_type(ct_str) {
    Ok(mt) =>
    match mt.param("boundary") {
      Some(b) => b
      None => {
        debug_assert(false, "missing inner boundary")
        return
      }
    }
    Err(_) => {
      debug_assert(false, "parse inner ct failed")
      return
    }
  }
  let r_inner = match MultipartReader::new(outer_parts[0].body, inner_b) {
    Ok(r) => r
    Err(_) => {
      debug_assert(false, "inner reader failed")
      return
    }
  }
  let inner_parts = match r_inner.read_all() {
    Ok(ps) => ps
    Err(_) => {
      debug_assert(false, "inner read_all failed")
      return
    }
  }
  debug_assert(inner_parts.length() == 2, "2 inner parts")
  debug_assert(inner_parts[0].body_string() == "Inner A", "inner A")
  debug_assert(inner_parts[1].body_string() == "<b>Inner B</b>", "inner B")
}

///|
test "multipart_writer_roundtrip_binary_and_fields" {
  let w = match MultipartWriter::new("pion-boundary-2026") {
    Ok(w) => w
    Err(_) => {
      debug_assert(false, "MultipartWriter::new failed")
      return
    }
  }
  debug_assert(
    w.form_data_content_type() == "multipart/form-data; boundary=pion-boundary-2026",
    "form_data_content_type",
  )
  match w.write_field("username", "alice") {
    Ok(_) => ()
    Err(_) => debug_assert(false, "write_field failed")
  }
  let mut bin = Bytes::new(256)
  let mut i = 0
  while i < 256 {
    bin[i] = i.to_byte()
    i = i + 1
  }
  match w.write_file("upload", "data.bin", "application/octet-stream", bin) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "write_file failed")
  }
  match w.write_part([PartHeader::new("X-Custom", "123"), PartHeader::new("Content-Type", "application/json")], "{\"ok\":true}".to_bytes()) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "write_part failed")
  }
  let encoded = w.finish()
  let r = match MultipartReader::new(encoded, w.boundary()) {
    Ok(r) => r
    Err(_) => {
      debug_assert(false, "roundtrip reader failed")
      return
    }
  }
  let parts = match r.read_all() {
    Ok(ps) => ps
    Err(_) => {
      debug_assert(false, "roundtrip read_all failed")
      return
    }
  }
  debug_assert(parts.length() == 3, "3 parts")
  debug_assert(opt_str_eq_mp(parts[0].form_name(), Some("username")), "field name")
  debug_assert(parts[0].body_string() == "alice", "field val")
  debug_assert(opt_str_eq_mp(parts[1].form_name(), Some("upload")), "file field name")
  debug_assert(opt_str_eq_mp(parts[1].filename(), Some("data.bin")), "filename")
  debug_assert(bytes_eq_mp(parts[1].body, bin), "binary payload intact byte-for-byte")
  debug_assert(opt_str_eq_mp(parts[2].header("x-custom"), Some("123")), "custom header")
  debug_assert(parts[2].body_string() == "{\"ok\":true}", "json body")
}
