///| Official Go 1.27 `mime/quotedprintable` (RFC 2045 §6.7) and
///| `mime` RFC 2047 Encoded-Words (`=?charset?B/Q?...?=`) test suite.

///|
fn repeat_str(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
test "qp_decode_go_vectors" {
  let cases = [
    ("", ""),
    ("foo bar", "foo bar"),
    ("foo bar=3D", "foo bar="),
    ("foo bar=3d", "foo bar="),
    ("foo bar=\n", "foo bar"),
    ("foo bar\n", "foo bar\n"),
    ("foo bar=0D=0A", "foo bar\r\n"),
    (" A B        \r\n C ", " A B\r\n C"),
    (" A B =\r\n C ", " A B  C"),
    (" A B =\n C ", " A B  C"),
    ("foo=\nbar", "foobar"),
    ("=3D30\n", "=30\n"),
    ("foo  \n", "foo\n"),
    ("foo  \n\nfoo =\n\nfoo=20\n\n", "foo\n\nfoo \nfoo \n\n"),
    ("foo\nbar", "foo\nbar"),
    ("foo\rbar", "foo\rbar"),
    ("foo\r\nbar", "foo\r\nbar"),
    ("foo=\r\nbar", "foobar"),
    ("Now's the time =\nfor all folk to come=\n to the aid of their country.", "Now's the time for all folk to come to the aid of their country."),
    ("foo= \r\nbar", "foobar"),
    ("foo=\t \r\nbar", "foobar"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (inp, want) = cases[i]
    match qp_decode_str(inp) {
      Ok(got) => debug_assert(got.to_string() == want, "qp_decode mismatch for case " + i.to_string())
      Err(_) => debug_assert(false, "qp_decode failed for valid case " + i.to_string())
    }
    i = i + 1
  }

  // Raw binary bytes decoded (=00=FF0=\n)
  match qp_decode_str("=00=FF0=\n") {
    Ok(got) => {
      debug_assert(got.length() == 3, "len 3")
      debug_assert(got[0].to_int() == 0x00, "0x00")
      debug_assert(got[1].to_int() == 0xFF, "0xFF")
      debug_assert(got[2].to_int() == 48, "'0'")
    }
    Err(_) => debug_assert(false, "binary qp_decode failed")
  }
}

///|
test "qp_encode_go_vectors_and_76_col_wrap" {
  let text_cases = [
    ("", ""),
    ("foo bar", "foo bar"),
    ("foo bar=", "foo bar=3D"),
    ("foo bar\r", "foo bar\r\n"),
    ("foo bar\n", "foo bar\r\n"),
    ("foo bar\r\n", "foo bar\r\n"),
    ("foo bar ", "foo bar=20"),
    ("foo bar\t", "foo bar=09"),
    ("foo bar  ", "foo bar =20"),
    ("foo bar \n", "foo bar=20\r\n"),
    ("foo bar  \n ", "foo bar =20\r\n=20"),
    ("¡Hola Señor!", "=C2=A1Hola Se=C3=B1or!"),
    (repeat_str("a", 75), repeat_str("a", 75)),
    (repeat_str("a", 76), repeat_str("a", 75) + "=\r\na"),
    (repeat_str("a", 72) + "=", repeat_str("a", 72) + "=3D"),
    (repeat_str("a", 73) + "=", repeat_str("a", 73) + "=\r\n=3D"),
    (repeat_str("a", 75) + "=", repeat_str("a", 75) + "=\r\n=3D"),
    (repeat_str(" ", 73), repeat_str(" ", 72) + "=20"),
    (repeat_str(" ", 74), repeat_str(" ", 73) + "=\r\n=20"),
    (repeat_str(" ", 77), repeat_str(" ", 75) + "=\r\n =20"),
  ]
  let mut i = 0
  while i < text_cases.length() {
    let (inp, want) = text_cases[i]
    let got = qp_encode_to_string(inp.to_bytes())
    debug_assert(got == want, "qp_encode mismatch at " + i.to_string() + ": got=" + got)
    i = i + 1
  }

  // Binary mode encodes CR/LF
  debug_assert(qp_encode_binary("foo\r\nbar".to_bytes()).to_string() == "foo=0D=0Abar", "binary mode")

  // Roundtrip Wikipedia French QP paragraph
  let msg = "Quoted-Printable (QP) est un format d'encodage de données codées sur 8 bits.\r\nLes caractères accentués : éèêë àâ ç « non-imprimables ».\r\n"
  let enc = qp_encode(msg.to_bytes())
  match qp_decode(enc) {
    Ok(dec) => debug_assert(dec.to_string() == msg, "qp roundtrip")
    Err(_) => debug_assert(false, "qp roundtrip decode failed")
  }
}

///|
test "rfc2047_decode_header_and_adjacent_whitespace_folding" {
  let cases = [
    ("=?UTF-8?Q?=C2=A1Hola,_se=C3=B1or!?=", "¡Hola, señor!"),
    ("=?UTF-8?Q?Fran=C3=A7ois-J=C3=A9r=C3=B4me?=", "François-Jérôme"),
    ("=?UTF-8?q?ascii?=", "ascii"),
    ("=?utf-8?B?QW5kcsOp?=", "André"),
    ("=?ISO-8859-1?Q?Rapha=EBl_Dupont?=", "Raphaël Dupont"),
    ("Jean", "Jean"),
    ("=?utf-8?b?IkFudG9uaW8gSm9zw6kiIDxqb3NlQGV4YW1wbGUub3JnPg==?=", "\"Antonio José\" <jose@example.org>"),
    ("=?UTF-8?Q??=", ""),
    // RFC 2047 §6.2 adjacent whitespace folding
    ("=?ISO-8859-1?Q?a?=", "a"),
    ("=?ISO-8859-1?Q?a?= b", "a b"),
    ("=?ISO-8859-1?Q?a?= =?ISO-8859-1?Q?b?=", "ab"),
    ("=?ISO-8859-1?Q?a?=  =?ISO-8859-1?Q?b?=", "ab"),
    ("=?ISO-8859-1?Q?a?= \r\n\t =?ISO-8859-1?Q?b?=", "ab"),
    ("=?ISO-8859-1?Q?a_b?=", "a b"),
    // Chinese UTF-8 Base64
    ("=?UTF-8?B?5Lit5paH5rWL6K+V?=", "中文测试"),
    // Undecodable / incomplete left literal in header mode (Go DecodeHeader parity)
    ("=?UTF-8?b?garbage?= =?UTF-8?b?QW5kcsOp?= =?UTF-8?b?garbage?=", "=?UTF-8?b?garbage?= André =?UTF-8?b?garbage?="),
    ("=?UTF-8?Q?", "=?UTF-8?Q?"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (inp, want) = cases[i]
    match decode_rfc2047(inp) {
      Ok(got) => debug_assert(got == want, "rfc2047 decode mismatch at " + i.to_string() + ": got=" + got)
      Err(_) => debug_assert(false, "rfc2047 decode failed at " + i.to_string())
    }
    i = i + 1
  }
}

///|
test "rfc2047_encode_q_and_b_go_vectors" {
  debug_assert(encode_rfc2047_q("François-Jérôme") == "=?utf-8?q?Fran=C3=A7ois-J=C3=A9r=C3=B4me?=", "Q encode")
  debug_assert(encode_rfc2047_b("Café") == "=?utf-8?b?Q2Fmw6k=?=", "B encode")
  debug_assert(encode_rfc2047_q("") == "", "empty")
  debug_assert(encode_rfc2047_q("123 456") == "123 456", "ascii passthrough")
  debug_assert(encode_rfc2047_b("Hello ASCII") == "Hello ASCII", "ascii passthrough B")

  // Splitting long UTF-8 string across <=75-char words without breaking multi-byte runes
  let long_e = repeat_str("é", 11)
  let q_enc = encode_rfc2047_q(long_e)
  debug_assert(
    q_enc == "=?utf-8?q?" + repeat_str("=C3=A9", 10) + "?= =?utf-8?q?=C3=A9?=",
    "Q split at 75: " + q_enc,
  )
  match decode_rfc2047(q_enc) {
    Ok(dec) => debug_assert(dec == long_e, "Q split roundtrip")
    Err(_) => debug_assert(false, "Q split decode failed")
  }

  let long_zh = repeat_str("中文", 20)
  let b_enc = encode_rfc2047_b(long_zh)
  match decode_rfc2047(b_enc) {
    Ok(dec) => debug_assert(dec == long_zh, "B split roundtrip")
    Err(_) => debug_assert(false, "B split decode failed")
  }
}
