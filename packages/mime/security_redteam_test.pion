///| Day-1 Security Red-Team Defense Suite for `packages/mime`.
///| Covers:
///| - O(N) linear-time multipart boundary search against 10 MB adversarial near-miss payload
///| - 100,000 empty parts bomb & oversized header/part bomb -> immediate MultipartLimits rejection
///| - Header CRLF injection & illegal boundaries (>70 chars, CTL, quotes, CR/LF)
///| - Malformed RFC 2231/5987 percent-encoding & unknown charsets
///| - Truncated / invalid Quoted-Printable & RFC 2047 sequences
///| - Path traversal neutralization in ContentDisposition::safe_filename
///| - 0-panic / 0-trap magic-byte sniffing on empty, 1-byte, and all-zero inputs

///|
test "redteam_multipart_10mb_near_miss_boundary_linear_time" {
  // 10 MB payload full of "--boundary1234567890" missing only the final char 'X'
  // Naive O(N*M) search degrades severely; BMH/Two-Way stays O(N).
  let boundary = "boundary1234567890X"
  let near = "--boundary1234567890".to_bytes()
  let near_len = near.length()
  let reps = 524288 // ~10.48 MB
  let header = ("--" + boundary + "\r\nContent-Disposition: form-data; name=\"big\"\r\n\r\n").to_bytes()
  let trailer = ("\r\n--" + boundary + "--\r\n").to_bytes()
  let total = header.length() + reps * near_len + trailer.length()
  let mut buf = Bytes::new(total)
  let mut pos = 0
  let mut i = 0
  while i < header.length() {
    buf[pos] = header[i]
    pos = pos + 1
    i = i + 1
  }
  let mut r = 0
  while r < reps {
    let mut j = 0
    while j < near_len {
      buf[pos] = near[j]
      pos = pos + 1
      j = j + 1
    }
    r = r + 1
  }
  i = 0
  while i < trailer.length() {
    buf[pos] = trailer[i]
    pos = pos + 1
    i = i + 1
  }

  let reader = match MultipartReader::new(buf, boundary) {
    Ok(rd) => rd
    Err(_) => {
      debug_assert(false, "reader init failed")
      return
    }
  }
  let parts = match reader.read_all() {
    Ok(ps) => ps
    Err(_) => {
      debug_assert(false, "10MB near-miss read_all failed")
      return
    }
  }
  debug_assert(parts.length() == 1, "1 part")
  debug_assert(parts[0].body.length() == reps * near_len, "exact 10MB body length")
}

///|
test "redteam_multipart_100k_empty_parts_and_header_bombs" {
  // 100,000 empty parts bomb -> must hit max_parts immediately without OOM
  let chunk = "--b\r\n\r\n".to_bytes()
  let clen = chunk.length()
  let count = 100000
  let end_b = "--b--".to_bytes()
  let mut bomb = Bytes::new(count * clen + end_b.length())
  let mut pos = 0
  let mut i = 0
  while i < count {
    let mut j = 0
    while j < clen {
      bomb[pos] = chunk[j]
      pos = pos + 1
      j = j + 1
    }
    i = i + 1
  }
  let mut k = 0
  while k < end_b.length() {
    bomb[pos] = end_b[k]
    pos = pos + 1
    k = k + 1
  }
  let reader = match MultipartReader::new(bomb, "b") {
    Ok(r) => r
    Err(_) => {
      debug_assert(false, "bomb reader init")
      return
    }
  }
  match reader.read_all() {
    Err(MimeError::TooManyParts) => ()
    _ => debug_assert(false, "100k empty parts must fail with TooManyParts")
  }

  // Oversized header bomb
  let limits = MultipartLimits::{
    max_parts: 10,
    max_headers_per_part: 4,
    max_header_bytes: 128,
    max_part_bytes: 64,
    max_params_per_header: 16384,
  }
  let sb = StringBuilder::new()
  sb.write_string("--b\r\nX-Big: ")
  let mut h = 0
  while h < 200 {
    sb.write_string("A")
    h = h + 1
  }
  sb.write_string("\r\n\r\nhi\r\n--b--")
  match MultipartReader::with_limits(sb.to_string().to_bytes(), "b", limits) {
    Ok(r) =>
    match r.read_all() {
      Err(MimeError::HeaderTooLarge) => ()
      _ => debug_assert(false, "oversized header must fail with HeaderTooLarge")
    }
    Err(_) => debug_assert(false, "init failed")
  }

  // Too many headers per part
  let many_hdrs = "--b\r\nH1: 1\r\nH2: 2\r\nH3: 3\r\nH4: 4\r\nH5: 5\r\n\r\nok\r\n--b--"
  match MultipartReader::with_limits(many_hdrs.to_bytes(), "b", limits) {
    Ok(r) =>
    match r.read_all() {
      Err(MimeError::TooManyHeaders) => ()
      _ => debug_assert(false, "too many headers must fail with TooManyHeaders")
    }
    Err(_) => debug_assert(false, "init failed")
  }

  // Oversized part body
  let big_part = "--b\r\n\r\n0123456789012345678901234567890123456789012345678901234567890123456789\r\n--b--"
  match MultipartReader::with_limits(big_part.to_bytes(), "b", limits) {
    Ok(r) =>
    match r.read_all() {
      Err(MimeError::PartTooLarge) => ()
      _ => debug_assert(false, "oversized part must fail with PartTooLarge")
    }
    Err(_) => debug_assert(false, "init failed")
  }
}

///|
test "redteam_crlf_injection_and_illegal_boundaries" {
  // Illegal boundaries: empty, >70 chars, CR/LF, quote, control char, trailing space
  let sb71 = StringBuilder::new()
  let mut i = 0
  while i < 71 {
    sb71.write_string("a")
    i = i + 1
  }
  let bad_boundaries = [
    "",
    sb71.to_string(),
    "abc\r\ndef",
    "abc\ndef",
    "abc\"def",
    "abc\x00def",
    "trailing ",
  ]
  i = 0
  while i < bad_boundaries.length() {
    match MultipartWriter::new(bad_boundaries[i]) {
      Err(MimeError::InvalidBoundary) => ()
      _ => debug_assert(false, "writer must reject illegal boundary " + i.to_string())
    }
    match MultipartReader::new(Bytes::new(0), bad_boundaries[i]) {
      Err(MimeError::InvalidBoundary) => ()
      _ => debug_assert(false, "reader must reject illegal boundary " + i.to_string())
    }
    i = i + 1
  }

  // CRLF injection in writer headers
  let w = match MultipartWriter::new("safe-boundary") {
    Ok(w) => w
    Err(_) => {
      debug_assert(false, "valid boundary failed")
      return
    }
  }
  match w.write_part([PartHeader::new("X-Test", "ok\r\nInjected: evil")], Bytes::new(0)) {
    Err(MimeError::CrlfInjection) => ()
    _ => debug_assert(false, "CRLF injection in header value must be rejected")
  }
  match w.write_part([PartHeader::new("X-Bad\nName", "ok")], Bytes::new(0)) {
    Err(MimeError::CrlfInjection) => ()
    _ => debug_assert(false, "LF injection in header name must be rejected")
  }
  match w.write_file("f", "a.txt", "text/plain\r\nX-Evil: 1", Bytes::new(0)) {
    Err(MimeError::CrlfInjection) => ()
    _ => debug_assert(false, "CRLF injection in content-type must be rejected")
  }
}

///|
test "redteam_malformed_percent_qp_rfc2047_and_path_traversal" {
  // Malformed filename* percent-encoding / format: RFC 6266 §4.3 drops bad filename* and keeps fallback
  let bad_pct = [
    "attachment; filename=\"fb.txt\"; filename*=UTF-8''abc%",
    "attachment; filename=\"fb.txt\"; filename*=UTF-8''abc%A",
    "attachment; filename=\"fb.txt\"; filename*=UTF-8''abc%ZZ",
    "attachment; filename=\"fb.txt\"; filename*=noquotes",
  ]
  let mut i = 0
  while i < bad_pct.length() {
    match parse_content_disposition(bad_pct[i]) {
      Ok(cd) =>
      match cd.filename() {
        Some(f) => debug_assert(f == "fb.txt", "fallback filename preserved: " + bad_pct[i])
        None => debug_assert(false, "fallback filename lost: " + bad_pct[i])
      }
      Err(_) => debug_assert(false, "bad filename* must not kill whole header: " + bad_pct[i])
    }
    i = i + 1
  }
  // Empty charset in RFC 2231 (`filename*=''onlylang`) is valid per RFC 2231
  match parse_content_disposition("attachment; filename*=''onlylang") {
    Ok(cd) =>
    match cd.filename() {
      Some(f) => debug_assert(f == "onlylang", "empty charset RFC 2231")
      None => debug_assert(false, "expected onlylang")
    }
    Err(_) => debug_assert(false, "empty charset RFC 2231 should succeed")
  }

  // QP RFC 2045 §6.7 / Go parity: invalid `=` escapes pass through literally; trailing `=` is soft break; NUL fails
  match qp_decode_str("=") {
    Ok(b) => debug_assert(b.to_string() == "", "trailing = at EOF is soft break")
    Err(_) => debug_assert(false, "trailing = at EOF should succeed")
  }
  match qp_decode_str("foo=A") {
    Ok(b) => debug_assert(b.to_string() == "foo=A", "truncated =A passes through")
    Err(_) => debug_assert(false, "foo=A should pass through")
  }
  match qp_decode_str("foo=ZZ") {
    Ok(b) => debug_assert(b.to_string() == "foo=ZZ", "invalid =ZZ passes through")
    Err(_) => debug_assert(false, "foo=ZZ should pass through")
  }
  match qp_decode_str("foo=\rbar") {
    Ok(b) => debug_assert(b.to_string() == "foo=\rbar", "=CR without LF passes through")
    Err(_) => debug_assert(false, "foo=\\rbar should pass through")
  }
  match qp_decode_str("foo\x00bar") {
    Err(MimeError::InvalidQuotedPrintable) => ()
    _ => debug_assert(false, "unescaped NUL in QP must fail")
  }

  // RFC 2047 strict single-word errors
  let bad_2047 = [
    "=?UTF-8?A?Test?=",
    "=?UTF-8?Q?A=B?=",
    "=?UTF-8?Q?=A?=",
    "=????=",
    "=?UTF-8???=",
    "=?UTF-8?B?!!!notbase64!!!?=",
  ]
  i = 0
  while i < bad_2047.length() {
    match decode_rfc2047_word(bad_2047[i]) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "invalid RFC 2047 word must fail: " + bad_2047[i])
    }
    i = i + 1
  }

  // Path traversal neutralization in safe_filename
  match parse_content_disposition("attachment; filename=\"../../etc/passwd\"") {
    Ok(cd) =>
    match cd.safe_filename() {
      Some(sf) => debug_assert(sf == "passwd", "unix traversal stripped: " + sf)
      None => debug_assert(false, "expected passwd")
    }
    Err(_) => debug_assert(false, "parse cd failed")
  }
  match parse_content_disposition("attachment; filename=\"C:\\\\Windows\\\\System32\\\\cmd.exe\"") {
    Ok(cd) =>
    match cd.safe_filename() {
      Some(sf) => debug_assert(sf == "cmd.exe", "windows traversal stripped: " + sf)
      None => debug_assert(false, "expected cmd.exe")
    }
    Err(_) => debug_assert(false, "parse win cd failed")
  }
  match parse_content_disposition("attachment; filename=\"..\"") {
    Ok(cd) =>
    match cd.safe_filename() {
      None => ()
      Some(sf) => debug_assert(false, "dotdot must return None, got: " + sf)
    }
    Err(_) => debug_assert(false, "parse dotdot cd failed")
  }
}

///|
test "redteam_sniff_zero_panic_truncated_and_all_zero" {
  // Empty, 1-byte, 2-byte, all-zero buffers -> 0 panics / 0 traps
  debug_assert(sniff_mime(Bytes::new(0)) == "application/octet-stream", "empty")
  debug_assert(sniff_mime(Bytes::new(1)) == "application/octet-stream", "1 zero byte")
  debug_assert(sniff_mime(Bytes::new(2)) == "application/octet-stream", "2 zero bytes")
  debug_assert(sniff_mime(Bytes::new(4)) == "application/octet-stream", "4 zero bytes")
  debug_assert(sniff_mime(Bytes::new(512)) == "application/octet-stream", "512 zero bytes")

  let mut single_a = Bytes::new(1)
  single_a[0] = b'a'
  debug_assert(sniff_mime(single_a) == "text/plain; charset=utf-8", "1 ascii byte")

  // Truncated magic prefixes (must not panic on bounds)
  debug_assert(sniff_mime("RIFF".to_bytes()) == "text/plain; charset=utf-8", "truncated RIFF")
  debug_assert(sniff_mime("%PDF".to_bytes()) == "text/plain; charset=utf-8", "truncated PDF")
  let mut trunc_png = Bytes::new(3)
  trunc_png[0] = (0x89).to_byte()
  trunc_png[1] = b'P'
  trunc_png[2] = b'N'
  debug_assert(sniff_mime(trunc_png) == "application/octet-stream", "truncated PNG")
}

///|
test "redteam_w10_regression_all_p0_p1_p2_fixes" {
  // P0-1: large param count & RFC 2231 continuation bases parse in linear time
  let sb_p = StringBuilder::new()
  sb_p.write_string("text/plain")
  let mut i = 0
  while i < 2000 {
    sb_p.write_string("; p")
    sb_p.write_string(i.to_string())
    sb_p.write_string("=x")
    i = i + 1
  }
  match parse_media_type(sb_p.to_string()) {
    Ok(mt) => debug_assert(mt.params.length() == 2000, "2000 plain params")
    Err(_) => debug_assert(false, "2000 plain params failed")
  }

  // P0-1: max_params_per_header limit in MultipartLimits
  let tight_limits = MultipartLimits::{
    max_parts: 10,
    max_headers_per_part: 10,
    max_header_bytes: 65536,
    max_part_bytes: 1024,
    max_params_per_header: 3,
  }
  let many_params_mp = "--b\r\nContent-Disposition: form-data; name=\"f\"; a=1; b=2; c=3; d=4\r\n\r\nv\r\n--b--\r\n"
  match MultipartReader::with_limits(many_params_mp.to_bytes(), "b", tight_limits) {
    Ok(r) =>
    match r.read_all() {
      Err(MimeError::HeaderTooLarge) => ()
      _ => debug_assert(false, "max_params_per_header must reject >3 params")
    }
    Err(_) => debug_assert(false, "tight limits init failed")
  }

  // P1-1: bare LF inside CRLF multipart body does not smuggle a part
  let smuggle = "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nhi\n--b\r\nContent-Disposition: form-data; name=\"admin\"\r\n\r\ntrue\r\n--b--\r\n"
  match MultipartReader::new(smuggle.to_bytes(), "b") {
    Ok(r) =>
    match r.read_all() {
      Ok(ps) => {
        debug_assert(ps.length() == 1, "CRLF mode ignores bare LF delimiter")
        debug_assert(
          ps[0].body_string() == "hi\n--b\r\nContent-Disposition: form-data; name=\"admin\"\r\n\r\ntrue",
          "body intact",
        )
      }
      Err(_) => debug_assert(false, "CRLF smuggle read_all failed")
    }
    Err(_) => debug_assert(false, "CRLF smuggle init failed")
  }

  // P1-3: safe_filename Windows/SMB & UI spoofing defenses
  let bad_names = [
    "CON", "nul", "COM1", "LPT9.log", "aux.txt", " ", "a:b:$DATA", "C:evil", ".htaccess",
  ]
  i = 0
  while i < bad_names.length() {
    let cd = ContentDisposition::{ disposition: "attachment", params: [Param::new("filename", bad_names[i])] }
    debug_assert(cd.safe_filename() is None, "must reject: " + bad_names[i])
    i = i + 1
  }
  let cd_dot = ContentDisposition::{ disposition: "attachment", params: [Param::new("filename", "evil.exe. ")] }
  match cd_dot.safe_filename() {
    Some(s) => debug_assert(s == "evil.exe", "trailing dot/space stripped")
    None => debug_assert(false, "expected evil.exe")
  }
  let cd_bidi = ContentDisposition::{ disposition: "attachment", params: [Param::new("filename", "\u{202E}gnp.exe")] }
  match cd_bidi.safe_filename() {
    Some(s) => debug_assert(s == "gnp.exe", "bidi control stripped")
    None => debug_assert(false, "expected gnp.exe")
  }

  // P1-4: Two-Way periodic boundary worst-case (a*70 boundary on all-'a' body)
  let b70 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let mut body_a = Bytes::new(65536)
  i = 0
  while i < 65536 {
    body_a[i] = b'a'
    i = i + 1
  }
  let w_p = match MultipartWriter::new(b70) {
    Ok(x) => x
    Err(_) => {
      debug_assert(false, "a*70 writer init")
      return
    }
  }
  debug_assert(w_p.write_part([PartHeader::new("Content-Disposition", "form-data; name=\"f\"")], body_a) is Ok(_), "write a*70")
  match MultipartReader::new(w_p.finish(), b70) {
    Ok(r) =>
    match r.read_all() {
      Ok(ps) => {
        debug_assert(ps.length() == 1, "1 part")
        debug_assert(ps[0].body.length() == 65536, "exact body len")
      }
      Err(_) => debug_assert(false, "a*70 read_all failed")
    }
    Err(_) => debug_assert(false, "a*70 reader init failed")
  }

  // P1-5: MultipartWriter rejects boundary injection + from_random_bytes constructor
  let w_inj = match MultipartWriter::new("fixed-b") {
    Ok(x) => x
    Err(_) => {
      debug_assert(false, "writer init")
      return
    }
  }
  debug_assert(
    w_inj.write_field("k", "v\r\n--fixed-b\r\nContent-Disposition: form-data; name=\"evil\"\r\n\r\n1") is Err(_),
    "boundary injection must be rejected",
  )
  debug_assert(MultipartWriter::from_random_bytes(Bytes::new(8)) is Err(_), "<16 random bytes rejected")
  let mut entropy = Bytes::new(24)
  i = 0
  while i < 24 {
    entropy[i] = (i * 11 + 3).to_byte()
    i = i + 1
  }
  match MultipartWriter::from_random_bytes(entropy) {
    Ok(wr) => debug_assert(wr.boundary().length() == 48, "24 random bytes -> 48 hex chars")
    Err(_) => debug_assert(false, "from_random_bytes failed")
  }

  // P2-1/P2-2/P2-12: sniff Java class, WHATWG HTML, UTF-16 BOM, PostScript, bz2/xz/7z/RAR/AVI
  let mut jcls = Bytes::new(8)
  jcls[0] = (0xCA).to_byte()
  jcls[1] = (0xFE).to_byte()
  jcls[2] = (0xBA).to_byte()
  jcls[3] = (0xBE).to_byte()
  jcls[7] = (0x34).to_byte()
  debug_assert(sniff_mime(jcls) == "application/java", "Java class")
  debug_assert(sniff_mime("<htmlfoo>".to_bytes()) == "text/plain; charset=utf-8", "<htmlfoo> not HTML")
  debug_assert(sniff_mime("<br>".to_bytes()) == "text/html; charset=utf-8", "<br> is HTML")
  debug_assert(sniff_mime("%!PS-Adobe-3.0".to_bytes()) == "application/postscript", "PostScript")
  debug_assert(sniff_mime("BZh91AY&SY".to_bytes()) == "application/x-bzip2", "bz2")
  debug_assert(sniff_mime("RIFF\x24\x00\x00\x00AVI LIST".to_bytes()) == "video/x-msvideo", "AVI")

  // P2-3: Accept fault-tolerant negotiation
  match negotiate_media_type("text/html;q=0.5555, application/json", ["application/json"]) {
    Ok(Some(s)) => debug_assert(s == "application/json", "skip bad Accept item")
    _ => debug_assert(false, "Accept skip failed")
  }

  // P2-4/P2-5/P2-6/P2-11: RFC 2231 fault tolerance, benign dupes, MSIE backslash, format_media_type star rejection
  match parse_media_type("text/plain; charset=utf-8; charset=utf-8; a*1=orphan; a*01=bad") {
    Ok(mt) =>
    match mt.param("charset") {
      Some(v) => debug_assert(v == "utf-8", "benign dup & bad sections")
      None => debug_assert(false, "charset missing")
    }
    Err(_) => debug_assert(false, "benign dup / bad sections failed")
  }
  match parse_content_disposition("attachment; filename=\"C:\\dev\\x.txt\"") {
    Ok(cd) =>
    match cd.filename() {
      Some(f) => debug_assert(f == "C:\\dev\\x.txt", "MSIE backslash preserved")
      None => debug_assert(false, "filename missing")
    }
    Err(_) => debug_assert(false, "MSIE path failed")
  }
  debug_assert(format_media_type("text/plain", [Param::new("title*", "x")]) is Err(_), "format rejects * in param name")

  // P2-7/P2-8: close delimiter garbage & NUL in part header
  let close_garbage = "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nx\r\n--b--garbage\r\n--b--\r\n"
  match MultipartReader::new(close_garbage.to_bytes(), "b") {
    Ok(r) => debug_assert(r.read_all() is Err(_), "--b--garbage must fail")
    Err(_) => ()
  }
  let nul_hdr = "--b\r\nContent-Disposition: form-data; name=\"a\u{0}b\"\r\n\r\nx\r\n--b--\r\n"
  match MultipartReader::new(nul_hdr.to_bytes(), "b") {
    Ok(r) => debug_assert(r.read_all() is Err(_), "NUL in part header must fail")
    Err(_) => ()
  }

  // P2-10: RFC 2047 split multi-byte UTF-8 across adjacent encoded-words
  match decode_rfc2047("=?utf-8?Q?=E2=82?= =?utf-8?Q?=AC?=") {
    Ok(s) => debug_assert(s == "\u{20AC}", "split UTF-8 euro sign")
    Err(_) => debug_assert(false, "split UTF-8 decode failed")
  }
}
