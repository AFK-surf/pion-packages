///| Official Go 1.27 `mime` Media-Type, RFC 2231/5987/6266 Content-Disposition,
///| and RFC 9110 §12.5.1 HTTP Accept content negotiation compliance test suite.

///|
fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///|
test "media_type_basic_and_case_normalization" {
  match parse_media_type("TEXT/HTML; CHARSET=UTF-8") {
    Ok(mt) => {
      debug_assert(mt.type_name == "text", "type lowercased")
      debug_assert(mt.subtype == "html", "subtype lowercased")
      debug_assert(mt.essence() == "text/html", "essence")
      debug_assert(opt_str_eq(mt.param("charset"), Some("UTF-8")), "charset preserved case")
      debug_assert(opt_str_eq(mt.param("CHARSET"), Some("UTF-8")), "case-insensitive lookup")
    }
    Err(_) => debug_assert(false, "expected valid media type")
  }

  match parse_media_type("  application/vnd.api+json ; version=\"1.0\" ; profile=\"https://example.com\" ") {
    Ok(mt) => {
      debug_assert(mt.type_name == "application", "type")
      debug_assert(mt.subtype == "vnd.api+json", "subtype")
      debug_assert(opt_str_eq(mt.param("version"), Some("1.0")), "version")
      debug_assert(opt_str_eq(mt.param("profile"), Some("https://example.com")), "profile")
    }
    Err(_) => debug_assert(false, "expected valid media type with spaces")
  }

  match parse_media_type("image/png;") {
    Ok(mt) => {
      debug_assert(mt.essence() == "image/png", "trailing semicolon ok")
      debug_assert(mt.params.length() == 0, "no params")
    }
    Err(_) => debug_assert(false, "trailing semicolon should be accepted")
  }
}

///|
test "media_type_quoted_escapes" {
  match parse_media_type("text/plain; a=\"\\\"quoting\\\" tested\"; b=\"\\\\path\\\\file\"; c=\"a;b=c\"") {
    Ok(mt) => {
      debug_assert(opt_str_eq(mt.param("a"), Some("\"quoting\" tested")), "escaped quotes")
      debug_assert(opt_str_eq(mt.param("b"), Some("\\path\\file")), "escaped backslashes")
      debug_assert(opt_str_eq(mt.param("c"), Some("a;b=c")), "quoted semicolon")
    }
    Err(_) => debug_assert(false, "expected valid quoted escapes")
  }
}

///|
test "media_type_rfc2231_continuations_and_charset" {
  // RFC 2231 §4 single extended parameter
  match parse_media_type("application/x-stuff; title*=us-ascii'en-us'This%20is%20%2A%2A%2Afun%2A%2A%2A") {
    Ok(mt) => {
      debug_assert(mt.essence() == "application/x-stuff", "essence")
      debug_assert(opt_str_eq(mt.param("title"), Some("This is ***fun***")), "rfc2231 title*")
    }
    Err(_) => debug_assert(false, "expected valid RFC 2231 extended param")
  }

  // RFC 2231 §3 unencoded continuations
  match parse_media_type("message/external-body; access-type=URL; URL*0=\"ftp://\"; URL*1=\"cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar\"") {
    Ok(mt) => {
      debug_assert(opt_str_eq(mt.param("access-type"), Some("URL")), "access-type")
      debug_assert(
        opt_str_eq(mt.param("url"), Some("ftp://cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar")),
        "rfc2231 unencoded continuation",
      )
    }
    Err(_) => debug_assert(false, "expected valid RFC 2231 unencoded continuation")
  }

  // RFC 2231 §4.1 mixed encoded & unencoded continuations
  match parse_media_type("application/x-stuff; title*0*=us-ascii'en'This%20is%20even%20more%20; title*1*=%2A%2A%2Afun%2A%2A%2A%20; title*2=\"isn't it!\"") {
    Ok(mt) => {
      debug_assert(
        opt_str_eq(mt.param("title"), Some("This is even more ***fun*** isn't it!")),
        "rfc2231 mixed continuation",
      )
    }
    Err(_) => debug_assert(false, "expected valid RFC 2231 mixed continuation")
  }

  // UTF-8 percent-encoded Chinese filename
  match parse_media_type("application/octet-stream; filename*=UTF-8''%E4%B8%AD%E6%96%87.txt") {
    Ok(mt) => {
      debug_assert(opt_str_eq(mt.param("filename"), Some("中文.txt")), "utf-8 chinese filename*")
    }
    Err(_) => debug_assert(false, "expected valid UTF-8 filename*")
  }

  // ISO-8859-1 extended parameter
  match parse_media_type("text/plain; title*=ISO-8859-1''caf%E9") {
    Ok(mt) => {
      debug_assert(opt_str_eq(mt.param("title"), Some("café")), "iso-8859-1 decoded to utf-8")
    }
    Err(_) => debug_assert(false, "expected valid ISO-8859-1 param")
  }
}

///|
test "media_type_reject_invalid_and_duplicates" {
  // Duplicate parameters
  match parse_media_type("text/plain; a=1; a=2") {
    Err(MimeError::DuplicateParameter) => ()
    _ => debug_assert(false, "duplicate param must fail")
  }
  match parse_media_type("text/plain; Charset=utf-8; charset=latin1") {
    Err(MimeError::DuplicateParameter) => ()
    _ => debug_assert(false, "case-insensitive duplicate param must fail")
  }
  // Invalid media types
  let bad_inputs = [
    "",
    "   ",
    "text",
    "text/",
    "/html",
    "text/html/extra",
    "te xt/html",
    "text/ht(ml)",
    "text/html; bad name=val",
    "text/html; a=\"unclosed",
    "text/html; =val",
    "text/html; a=1 b=2",
  ]
  let mut i = 0
  while i < bad_inputs.length() {
    match parse_media_type(bad_inputs[i]) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "invalid media type should fail: " + bad_inputs[i])
    }
    i = i + 1
  }
}

///|
test "format_media_type_canonical_and_rfc2231" {
  // Sorted parameters, token unquoted, spaces quoted, non-ASCII uses RFC 2231
  match format_media_type("TEXT/HTML", [Param::new("z", "1"), Param::new("charset", "utf-8")]) {
    Ok(s) => debug_assert(s == "text/html; charset=utf-8; z=1", "canonical sorted: " + s)
    Err(_) => debug_assert(false, "format_media_type failed")
  }

  match format_media_type("text/plain", [Param::new("note", "hello \"world\"\\1")]) {
    Ok(s) => debug_assert(s == "text/plain; note=\"hello \\\"world\\\"\\\\1\"", "quoted escape: " + s)
    Err(_) => debug_assert(false, "format quoted failed")
  }

  match format_media_type("application/octet-stream", [Param::new("filename", "中文.txt")]) {
    Ok(s) => {
      debug_assert(s == "application/octet-stream; filename*=utf-8''%E4%B8%AD%E6%96%87.txt", "rfc2231 format: " + s)
      // Roundtrip
      match parse_media_type(s) {
        Ok(mt) => debug_assert(opt_str_eq(mt.param("filename"), Some("中文.txt")), "roundtrip utf-8")
        Err(_) => debug_assert(false, "roundtrip parse failed")
      }
    }
    Err(_) => debug_assert(false, "format non-ascii failed")
  }

  // Reject invalid media type / param name / duplicates
  match format_media_type("bad type/html", []) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "invalid media type must fail format")
  }
  match format_media_type("text/html", [Param::new("a", "1"), Param::new("A", "2")]) {
    Err(MimeError::DuplicateParameter) => ()
    _ => debug_assert(false, "duplicate param must fail format")
  }
}

///|
test "content_disposition_rfc6266_and_rfc5987" {
  // inline / attachment / form-data
  match parse_content_disposition("ATTACHMENT; filename=\"report.pdf\"") {
    Ok(cd) => {
      debug_assert(cd.disposition == "attachment", "disposition lowercased")
      debug_assert(opt_str_eq(cd.filename(), Some("report.pdf")), "filename")
      debug_assert(opt_str_eq(cd.safe_filename(), Some("report.pdf")), "safe_filename")
    }
    Err(_) => debug_assert(false, "expected valid attachment")
  }

  match parse_content_disposition("inline") {
    Ok(cd) => {
      debug_assert(cd.disposition == "inline", "inline")
      debug_assert(opt_str_eq(cd.filename(), None), "no filename")
    }
    Err(_) => debug_assert(false, "expected valid inline")
  }

  // filename* takes precedence over filename per RFC 6266 §4.3
  match parse_content_disposition("attachment; filename=\"fallback.txt\"; filename*=UTF-8''%E4%B8%AD%E6%96%87%E6%96%87%E6%A1%A3.txt") {
    Ok(cd) => {
      debug_assert(opt_str_eq(cd.filename(), Some("中文文档.txt")), "filename* wins over filename")
    }
    Err(_) => debug_assert(false, "expected valid dual filename + filename*")
  }

  // form-data
  match parse_content_disposition("form-data; name=\"avatar\"; filename=\"me.png\"") {
    Ok(cd) => {
      debug_assert(cd.disposition == "form-data", "form-data")
      debug_assert(opt_str_eq(cd.name(), Some("avatar")), "form field name")
      debug_assert(opt_str_eq(cd.filename(), Some("me.png")), "form filename")
    }
    Err(_) => debug_assert(false, "expected valid form-data")
  }

  // format_content_disposition
  match format_content_disposition("attachment", [Param::new("filename", "中文.pdf")]) {
    Ok(s) => {
      debug_assert(s == "attachment; filename*=utf-8''%E4%B8%AD%E6%96%87.pdf", "format cd: " + s)
    }
    Err(_) => debug_assert(false, "format_content_disposition failed")
  }

  // Invalid dispositions (from greenbytes tc2231 / Go tests)
  let bad_cds = [
    "",
    "filename=foo.html",
    "; filename=foo.html",
    "inline; attachment; filename=foo.html",
    "attachment; filename=\"foo.html\".txt",
    "attachment; filename=\"bar",
    "attachment filename=bar",
  ]
  let mut i = 0
  while i < bad_cds.length() {
    match parse_content_disposition(bad_cds[i]) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "invalid disposition should fail: " + bad_cds[i])
    }
    i = i + 1
  }
}

///|
test "http_accept_content_negotiation_rfc9110" {
  // Quality weights
  let supported = ["application/json", "text/html", "text/plain"]
  match negotiate_media_type("text/plain;q=0.5, text/html;q=0.8, application/json;q=0.9", supported) {
    Ok(res) => debug_assert(opt_str_eq(res, Some("application/json")), "highest q wins")
    Err(_) => debug_assert(false, "negotiate failed")
  }

  // Specificity ordering: type/sub;param > type/sub > type/* > */*
  match negotiate_media_type("*/*;q=0.8, text/*;q=0.8, text/html;q=0.8, text/html;level=1;q=0.8", ["text/plain", "text/html", "text/html; level=1"]) {
    Ok(res) => debug_assert(opt_str_eq(res, Some("text/html; level=1")), "param specificity wins")
    Err(_) => debug_assert(false, "specificity negotiate failed")
  }

  match negotiate_media_type("text/*, text/html;q=0.5, */*;q=0.1", ["text/html", "text/plain", "application/json"]) {
    Ok(res) => debug_assert(opt_str_eq(res, Some("text/plain")), "text/* matches text/plain with q=1.0 over text/html q=0.5")
    Err(_) => debug_assert(false, "wildcard specificity failed")
  }

  // q=0 explicitly excludes a type even if */* is present
  match negotiate_media_type("text/html;q=0, */*;q=0.5", ["text/html", "application/json"]) {
    Ok(res) => debug_assert(opt_str_eq(res, Some("application/json")), "q=0 excludes text/html")
    Err(_) => debug_assert(false, "q=0 exclusion failed")
  }

  match negotiate_media_type("text/html;q=0", ["text/html"]) {
    Ok(res) => debug_assert(opt_str_eq(res, None), "all excluded -> None")
    Err(_) => debug_assert(false, "all excluded should return Ok(None)")
  }

  // Reject invalid q values
  let bad_accepts = [
    "text/html;q=1.5",
    "text/html;q=-0.1",
    "text/html;q=0.1234",
    "text/html;q=1.001",
    "text/html;q=abc",
    "text/html;q=",
    "badtype",
  ]
  let mut i = 0
  while i < bad_accepts.length() {
    match negotiate_media_type(bad_accepts[i], supported) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "invalid Accept should fail: " + bad_accepts[i])
    }
    i = i + 1
  }
}
