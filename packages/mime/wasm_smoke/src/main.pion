///| Native + Wasm32 4-mode smoke entry for `packages/mime`.

import "mime"

///|
pub fn main(world : World) -> Int {
  // 1. Media-Type + RFC 2231
  let mt = match mime::parse_media_type("TEXT/HTML; charset=UTF-8; title*=UTF-8''%E4%B8%AD%E6%96%87") {
    Ok(m) => m
    Err(_) => return 1
  }
  let title = match mt.param("title") {
    Some(s) => s
    None => return 2
  }
  if mt.essence() != "text/html" || title != "中文" {
    return 3
  }

  // 2. Content-Disposition + safe_filename
  let cd = match mime::parse_content_disposition("attachment; filename=\"../../etc/passwd\"; filename*=UTF-8''%E6%8A%A5%E5%91%8A.pdf") {
    Ok(c) => c
    Err(_) => return 4
  }
  let sf = match cd.safe_filename() {
    Some(s) => s
    None => return 5
  }

  // 3. Accept negotiation
  let neg = match mime::negotiate_media_type("text/plain;q=0.5, application/json;q=0.9", ["text/plain", "application/json"]) {
    Ok(Some(s)) => s
    _ => return 6
  }

  // 4. Multipart writer + reader roundtrip
  let mut png = Bytes::new(8)
  png[0] = (0x89).to_byte()
  png[1] = (0x50).to_byte()
  png[2] = (0x4E).to_byte()
  png[3] = (0x47).to_byte()
  png[4] = (0x0D).to_byte()
  png[5] = (0x0A).to_byte()
  png[6] = (0x1A).to_byte()
  png[7] = (0x0A).to_byte()
  let w = match mime::MultipartWriter::new("wasm-smoke-boundary") {
    Ok(x) => x
    Err(_) => return 7
  }
  match w.write_field("k", "v") {
    Ok(_) => ()
    Err(_) => return 8
  }
  match w.write_file("f", "img.png", "image/png", png) {
    Ok(_) => ()
    Err(_) => return 9
  }
  let raw_mp = w.finish()
  let r = match mime::MultipartReader::new(raw_mp, "wasm-smoke-boundary") {
    Ok(x) => x
    Err(_) => return 10
  }
  let parts = match r.read_all() {
    Ok(ps) => ps
    Err(_) => return 11
  }
  if parts.length() != 2 {
    return 12
  }

  // 5. QP & RFC 2047
  let qp_dec = match mime::qp_decode_str("Hello=20=E4=B8=96=E7=95=8C=\r\n!") {
    Ok(b) => b.to_string()
    Err(_) => return 13
  }
  let ew_dec = match mime::decode_rfc2047("=?UTF-8?Q?Fran=C3=A7ois?= =?UTF-8?B?5Lit5paH?=") {
    Ok(s) => s
    Err(_) => return 14
  }

  // 6. Sniffing + extension
  let sniffed_png = mime::sniff_mime(parts[1].body)
  let sniffed_empty = mime::sniff_mime(Bytes::new(0))

  // 7. Security red-team smoke: CRLF injection & unescaped NUL in QP must fail cleanly (0 trap)
  match w.write_part([mime::PartHeader::new("X-Bad", "a\r\nb")], Bytes::new(0)) {
    Err(mime::MimeError::CrlfInjection) => ()
    _ => return 15
  }
  match mime::qp_decode_str("bad\x00x") {
    Err(mime::MimeError::InvalidQuotedPrintable) => ()
    _ => return 16
  }

  io_println(world, "mime_wasm_smoke=ok")
  io_println(world, "mt=" + mt.essence() + ":" + title)
  io_println(world, "cd=" + sf)
  io_println(world, "neg=" + neg)
  io_println(world, "mp_parts=" + parts.length().to_string())
  io_println(world, "qp=" + qp_dec)
  io_println(world, "rfc2047=" + ew_dec)
  io_println(world, "sniff=" + sniffed_png + "|" + sniffed_empty)
  0
}
