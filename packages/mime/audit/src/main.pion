///| Red-team differential harness CLI for `packages/mime` (Native debug/release + Wasm32 debug/release).
///| Batch file: one case per line, fields separated by a single space, every field written as `.` + lowercase hex.
///| Output: one line per case, byte-identical format to `go/main.go` so `diff.py` can compare them.
///| Modes:
///|   mt <cases>        parse_media_type             -> `OK .type/sub .k=.v ...` (keys sorted) | `ERR <kind>`
///|   mtn <cases>       parse_media_type, print only the param count (perf probes)
///|   cd <cases>        parse_content_disposition    -> same shape
///|   fmt <cases>       format_media_type(type, [k,v]...) -> `OK .out` | `ERR <kind>`; then reparse check
///|   qpdec <cases>     qp_decode                    -> `OK .out` | `ERR <kind>`
///|   qpenc <cases>     qp_encode (text)             -> `OK .out`
///|   qpencb <cases>    qp_encode_binary             -> `OK .out`
///|   ewdec <cases>     decode_rfc2047               -> `OK .out` | `ERR <kind>`
///|   ewq / ewb <cases> encode_rfc2047_q / _b        -> `OK .out`
///|   sniff <cases>     sniff_mime                   -> `<mime>`
///|   safe <cases>      ContentDisposition::safe_filename(filename=<field>) -> `OK .name` | `NONE`
///|   neg <cases>       negotiate_media_type(accept, supported...) -> `OK .chosen` | `NONE` | `ERR <kind>`
///|   mp <cases>        MultipartReader(boundary, body) -> `P .cd .ct .body | ... END` / `... ERR <kind>`
///|   mpfile <boundary> <file>  parse one multipart file, reading every part's form name -> `parts=N body_bytes=M` (perf probes)

import "mime"

///|
fn hexv(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Decode a `.hex` field into Bytes.
fn field_bytes(line : Bytes, start : Int, end : Int) -> Bytes {
  let s = start + 1
  let n = (end - s) / 2
  let mut out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = ((hexv(line[s + 2 * i].to_int()) << 4) | hexv(line[s + 2 * i + 1].to_int())).to_byte()
    i = i + 1
  }
  out
}

///|
fn split_fields(line : Bytes) -> Array[Bytes] {
  let out : Array[Bytes] = []
  let len = line.length()
  let mut start = 0
  let mut i = 0
  while i <= len {
    if i == len || line[i].to_int() == 32 {
      if i > start {
        out.push(field_bytes(line, start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  out
}

///|
fn split_lines(data : Bytes) -> Array[Bytes] {
  let out : Array[Bytes] = []
  let len = data.length()
  let mut start = 0
  let mut i = 0
  while i < len {
    if data[i].to_int() == 10 {
      out.push(data.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < len {
    out.push(data.slice(start, len))
  }
  out
}

///|
let hexchars : FixedArray[Byte] = [
  b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f',
]

///|
fn put_hex(sb : StringBuilder, b : Bytes) -> Unit {
  sb.write_byte(b'.')
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int()
    sb.write_byte(hexchars[(c >> 4) & 15])
    sb.write_byte(hexchars[c & 15])
    i = i + 1
  }
}

///|
fn put_hex_s(sb : StringBuilder, s : String) -> Unit {
  put_hex(sb, s.to_bytes())
}

///|
fn err_kind(e : mime::MimeError) -> String {
  match e {
    EmptyInput => "EmptyInput"
    InvalidMediaType => "InvalidMediaType"
    InvalidParameterName => "InvalidParameterName"
    InvalidParameterValue => "InvalidParameterValue"
    DuplicateParameter => "DuplicateParameter"
    InvalidEscape => "InvalidEscape"
    InvalidPercentEncoding => "InvalidPercentEncoding"
    InvalidCharset => "InvalidCharset"
    InvalidDisposition => "InvalidDisposition"
    InvalidAcceptHeader => "InvalidAcceptHeader"
    InvalidQualityValue => "InvalidQualityValue"
    InvalidBoundary => "InvalidBoundary"
    InvalidMultipart => "InvalidMultipart"
    InvalidPartHeader => "InvalidPartHeader"
    CrlfInjection => "CrlfInjection"
    TooManyParts => "TooManyParts"
    TooManyHeaders => "TooManyHeaders"
    HeaderTooLarge => "HeaderTooLarge"
    PartTooLarge => "PartTooLarge"
    UnexpectedEof => "UnexpectedEof"
    InvalidQuotedPrintable => "InvalidQuotedPrintable"
    InvalidRfc2047 => "InvalidRfc2047"
    InvalidBase64 => "InvalidBase64"
  }
}

///|
fn str_lt(a : String, b : String) -> Bool {
  let ab = a.to_bytes()
  let bb = b.to_bytes()
  let m = if ab.length() < bb.length() { ab.length() } else { bb.length() }
  let mut i = 0
  while i < m {
    if ab[i] != bb[i] {
      return ab[i].to_int() < bb[i].to_int()
    }
    i = i + 1
  }
  ab.length() < bb.length()
}

///|
fn put_params(sb : StringBuilder, ps : Array[mime::Param]) -> Unit {
  let sorted : Array[mime::Param] = []
  let mut i = 0
  while i < ps.length() {
    sorted.push(ps[i])
    let mut k = sorted.length() - 1
    while k > 0 && str_lt(sorted[k].name, sorted[k - 1].name) {
      let t = sorted[k]
      sorted[k] = sorted[k - 1]
      sorted[k - 1] = t
      k = k - 1
    }
    i = i + 1
  }
  i = 0
  while i < sorted.length() {
    sb.write_byte(b' ')
    put_hex_s(sb, sorted[i].name)
    sb.write_byte(b'=')
    put_hex_s(sb, sorted[i].value)
    i = i + 1
  }
}

///|
fn run_case(mode : String, f : Array[Bytes], sb : StringBuilder) -> Unit {
  let a0 = if f.length() > 0 { f[0] } else { Bytes::new(0) }
  if mode == "mt" {
    match mime::parse_media_type(a0.to_string()) {
      Ok(mt) => {
        sb.write_string("OK ")
        put_hex_s(sb, mt.essence())
        put_params(sb, mt.params)
      }
      Err(e) => sb.write_string("ERR " + err_kind(e))
    }
  } else if mode == "mtn" {
    // Perf probe: parse only, print the param count (no O(n^2) sort in the harness itself).
    match mime::parse_media_type(a0.to_string()) {
      Ok(mt) => sb.write_string("OK " + mt.params.length().to_string())
      Err(e) => sb.write_string("ERR " + err_kind(e))
    }
  } else if mode == "cd" {
    match mime::parse_content_disposition(a0.to_string()) {
      Ok(cd) => {
        sb.write_string("OK ")
        put_hex_s(sb, cd.disposition)
        put_params(sb, cd.params)
      }
      Err(e) => sb.write_string("ERR " + err_kind(e))
    }
  } else if mode == "fmt" {
    let ps : Array[mime::Param] = []
    let mut i = 1
    while i + 1 < f.length() {
      ps.push(mime::Param::new(f[i].to_string(), f[i + 1].to_string()))
      i = i + 2
    }
    match mime::format_media_type(a0.to_string(), ps) {
      Ok(s) => {
        sb.write_string("OK ")
        put_hex_s(sb, s)
        // Round-trip check: parse(format(x)) must give back the same lowercased params.
        match mime::parse_media_type(s) {
          Ok(mt) => {
            let mut same = mt.params.length() == ps.length()
            let mut j = 0
            while same && j < ps.length() {
              match mt.param(ps[j].name) {
                Some(v) => if v != ps[j].value { same = false }
                None => same = false
              }
              j = j + 1
            }
            sb.write_string(if same { " RT=same" } else { " RT=DIFF" })
          }
          Err(e) => sb.write_string(" RT=ERR:" + err_kind(e))
        }
      }
      Err(e) => sb.write_string("ERR " + err_kind(e))
    }
  } else if mode == "qpdec" {
    match mime::qp_decode(a0) {
      Ok(b) => {
        sb.write_string("OK ")
        put_hex(sb, b)
      }
      Err(e) => sb.write_string("ERR " + err_kind(e))
    }
  } else if mode == "qpenc" {
    sb.write_string("OK ")
    put_hex(sb, mime::qp_encode(a0))
  } else if mode == "qpencb" {
    sb.write_string("OK ")
    put_hex(sb, mime::qp_encode_binary(a0))
  } else if mode == "ewdec" {
    match mime::decode_rfc2047(a0.to_string()) {
      Ok(s) => {
        sb.write_string("OK ")
        put_hex_s(sb, s)
      }
      Err(e) => sb.write_string("ERR " + err_kind(e))
    }
  } else if mode == "ewq" {
    sb.write_string("OK ")
    put_hex_s(sb, mime::encode_rfc2047_q(a0.to_string()))
  } else if mode == "ewb" {
    sb.write_string("OK ")
    put_hex_s(sb, mime::encode_rfc2047_b(a0.to_string()))
  } else if mode == "sniff" {
    sb.write_string(mime::sniff_mime(a0))
  } else if mode == "safe" {
    let cd = mime::ContentDisposition::{
      disposition: "attachment",
      params: [mime::Param::new("filename", a0.to_string())],
    }
    match cd.safe_filename() {
      Some(s) => {
        sb.write_string("OK ")
        put_hex_s(sb, s)
      }
      None => sb.write_string("NONE")
    }
  } else if mode == "neg" {
    let sup : Array[String] = []
    let mut i = 1
    while i < f.length() {
      sup.push(f[i].to_string())
      i = i + 1
    }
    match mime::negotiate_media_type(a0.to_string(), sup) {
      Ok(Some(s)) => {
        sb.write_string("OK ")
        put_hex_s(sb, s)
      }
      Ok(None) => sb.write_string("NONE")
      Err(e) => sb.write_string("ERR " + err_kind(e))
    }
  } else if mode == "mp" {
    let body = if f.length() > 1 { f[1] } else { Bytes::new(0) }
    match mime::MultipartReader::new(body, a0.to_string()) {
      Ok(r) => {
        let mut go_on = true
        while go_on {
          match r.next_part() {
            Ok(Some(p)) => {
              sb.write_string("P ")
              put_hex_s(sb, match p.header("Content-Disposition") { Some(v) => v; None => "" })
              sb.write_byte(b' ')
              put_hex_s(sb, match p.header("Content-Type") { Some(v) => v; None => "" })
              sb.write_byte(b' ')
              put_hex(sb, p.body)
              sb.write_string(" | ")
            }
            Ok(None) => {
              sb.write_string("END")
              go_on = false
            }
            Err(e) => {
              sb.write_string("ERR " + err_kind(e))
              go_on = false
            }
          }
        }
      }
      Err(e) => sb.write_string("ERR " + err_kind(e))
    }
  } else {
    sb.write_string("BADMODE")
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: mime_audit <mode> <cases> | mpfile <boundary> <file>")
    return 2
  }
  let mode = args[1]
  if mode == "mpfile" {
    let data = match fs_read_bytes(world, args[3]) {
      Ok(d) => d
      Err(_) => return 3
    }
    match mime::MultipartReader::new(data, args[2]) {
      Ok(r) => {
        let mut n = 0
        let mut total = 0
        while true {
          match r.next_part() {
            Ok(Some(p)) => {
              n = n + 1
              total = total + p.body.length()
              // Typical server code reads the form field name of every part.
              match p.form_name() {
                Some(fname) => total = total + fname.length()
                None => ()
              }
            }
            Ok(None) => break
            Err(e) => {
              io_println(world, "ERR " + err_kind(e) + " after parts=" + n.to_string())
              return 0
            }
          }
        }
        io_println(world, "parts=" + n.to_string() + " body_bytes=" + total.to_string())
      }
      Err(e) => io_println(world, "ERR " + err_kind(e))
    }
    return 0
  }
  let data = match fs_read_bytes(world, args[2]) {
    Ok(d) => d
    Err(_) => {
      io_println(world, "cannot read " + args[2])
      return 3
    }
  }
  let lines = split_lines(data)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    run_case(mode, split_fields(lines[i]), sb)
    sb.write_byte(b'\n')
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}
