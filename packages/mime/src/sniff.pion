///| Extension-to-MIME mapping and WHATWG / magic-byte MIME sniffing engine.
///| Total, bounds-safe, 0-panic / 0-Wasm32-trap across all inputs.

///| Map a file extension (with or without leading `.`, case-insensitive) to a canonical MIME type.
pub fn mime_from_extension(ext : String) -> Option[String] {
  let b = ext.to_bytes()
  let len = b.length()
  if len == 0 {
    return None
  }
  let start = if b[0].to_int() == 46 { 1 } else { 0 }
  if start >= len {
    return None
  }
  let e = bytes_slice_to_lower_string(b, start, len)
  match e {
    "html" | "htm" => Some("text/html; charset=utf-8")
    "css" => Some("text/css; charset=utf-8")
    "js" | "mjs" => Some("text/javascript; charset=utf-8")
    "json" => Some("application/json")
    "xml" => Some("text/xml; charset=utf-8")
    "svg" => Some("image/svg+xml")
    "png" => Some("image/png")
    "jpg" | "jpeg" => Some("image/jpeg")
    "gif" => Some("image/gif")
    "webp" => Some("image/webp")
    "bmp" => Some("image/bmp")
    "ico" => Some("image/x-icon")
    "avif" => Some("image/avif")
    "pdf" => Some("application/pdf")
    "zip" => Some("application/zip")
    "gz" | "gzip" => Some("application/gzip")
    "zst" => Some("application/zstd")
    "br" => Some("application/x-brotli")
    "tar" => Some("application/x-tar")
    "wasm" => Some("application/wasm")
    "mp4" | "m4v" => Some("video/mp4")
    "webm" => Some("video/webm")
    "mp3" => Some("audio/mpeg")
    "ogg" | "oga" => Some("application/ogg")
    "flac" => Some("audio/flac")
    "wav" => Some("audio/wav")
    "woff" => Some("font/woff")
    "woff2" => Some("font/woff2")
    "ttf" => Some("font/ttf")
    "otf" => Some("font/otf")
    "sqlite" | "sqlite3" | "db" => Some("application/vnd.sqlite3")
    "txt" | "text" => Some("text/plain; charset=utf-8")
    "csv" => Some("text/csv; charset=utf-8")
    "md" | "markdown" => Some("text/markdown; charset=utf-8")
    "yaml" | "yml" => Some("application/yaml")
    "toml" => Some("application/toml")
    "bin" => Some("application/octet-stream")
    _ => None
  }
}

///| Map a MIME type (stripping parameters, case-insensitive) to its primary file extension.
pub fn extension_from_mime(mime_type : String) -> Option[String] {
  let b = mime_type.to_bytes()
  let mut end = b.length()
  let mut i = 0
  while i < end {
    if b[i].to_int() == 59 {
      end = i
      break
    }
    i = i + 1
  }
  let start = skip_ws(b, 0, end)
  while end > start && (b[end - 1].to_int() == 32 || b[end - 1].to_int() == 9) {
    end = end - 1
  }
  if start >= end {
    return None
  }
  let essence = bytes_slice_to_lower_string(b, start, end)
  match essence {
    "text/html" => Some(".html")
    "text/css" => Some(".css")
    "text/javascript" | "application/javascript" => Some(".js")
    "application/json" => Some(".json")
    "text/xml" | "application/xml" => Some(".xml")
    "image/svg+xml" => Some(".svg")
    "image/png" => Some(".png")
    "image/jpeg" => Some(".jpg")
    "image/gif" => Some(".gif")
    "image/webp" => Some(".webp")
    "image/bmp" => Some(".bmp")
    "image/x-icon" | "image/vnd.microsoft.icon" => Some(".ico")
    "image/avif" => Some(".avif")
    "application/pdf" => Some(".pdf")
    "application/zip" => Some(".zip")
    "application/gzip" => Some(".gz")
    "application/zstd" => Some(".zst")
    "application/x-brotli" | "application/brotli" => Some(".br")
    "application/x-tar" => Some(".tar")
    "application/wasm" => Some(".wasm")
    "video/mp4" => Some(".mp4")
    "video/webm" => Some(".webm")
    "audio/mpeg" => Some(".mp3")
    "application/ogg" | "audio/ogg" => Some(".ogg")
    "audio/flac" => Some(".flac")
    "audio/wav" | "audio/x-wav" => Some(".wav")
    "font/woff" => Some(".woff")
    "font/woff2" => Some(".woff2")
    "font/ttf" => Some(".ttf")
    "font/otf" => Some(".otf")
    "application/vnd.sqlite3" | "application/x-sqlite3" => Some(".sqlite")
    "text/plain" => Some(".txt")
    "text/csv" => Some(".csv")
    "text/markdown" => Some(".md")
    "application/yaml" => Some(".yaml")
    "application/toml" => Some(".toml")
    "application/octet-stream" => Some(".bin")
    _ => None
  }
}

///| Check if `buf` at `offset` matches ASCII string `sig` (exact).
fn match_ascii_at(buf : Bytes, offset : Int, sig : String) -> Bool {
  let sb = sig.to_bytes()
  let slen = sb.length()
  if offset < 0 || offset + slen > buf.length() {
    return false
  }
  let mut i = 0
  while i < slen {
    if buf[offset + i] != sb[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Check if `buf` at `offset` matches ASCII string `sig` (case-insensitive, `sig` lowercase).
fn match_ascii_ci_at(buf : Bytes, offset : Int, sig_lower : String) -> Bool {
  let sb = sig_lower.to_bytes()
  let slen = sb.length()
  if offset < 0 || offset + slen > buf.length() {
    return false
  }
  let llut = lower_lut
  let mut i = 0
  while i < slen {
    if llut[buf[offset + i].to_int()] != sb[i].to_int() {
      return false
    }
    i = i + 1
  }
  true
}

///| Search for ASCII substring (case-insensitive, `needle_lower` lowercase) in `buf[start..end)`.
fn contains_ascii_ci(buf : Bytes, start : Int, end : Int, needle_lower : String) -> Bool {
  let nb = needle_lower.to_bytes()
  let nlen = nb.length()
  if nlen == 0 || end - start < nlen {
    return false
  }
  let llut = lower_lut
  let limit = end - nlen
  let first = nb[0].to_int()
  let mut i = start
  while i <= limit {
    if llut[buf[i].to_int()] == first {
      let mut j = 1
      while j < nlen && llut[buf[i + j].to_int()] == nb[j].to_int() {
        j = j + 1
      }
      if j == nlen {
        return true
      }
    }
    i = i + 1
  }
  false
}

///| Check WHATWG §3 binary data byte rule + valid UTF-8 on prefix (up to 512 bytes).
fn is_utf8_text(data : Bytes) -> Bool {
  let len = data.length()
  if len == 0 {
    return false
  }
  let check_len = if len < 512 { len } else { 512 }
  let mut i = 0
  while i < check_len {
    let b = data[i].to_int()
    // WHATWG binary data bytes: 0x00..0x08, 0x0B, 0x0E..0x1A, 0x1C..0x1F
    if b <= 0x08 || b == 0x0B || (b >= 0x0E && b <= 0x1A) || (b >= 0x1C && b <= 0x1F) {
      return false
    }
    i = i + 1
  }
  // Adjust check_len backward if we split a multi-byte UTF-8 char at 512 boundary
  let mut utf8_end = check_len
  if utf8_end < len {
    let mut back = 0
    while utf8_end > 0 && back < 3 && (data[utf8_end - 1].to_int() & 0xC0) == 0x80 {
      utf8_end = utf8_end - 1
      back = back + 1
    }
    if utf8_end > 0 && (data[utf8_end - 1].to_int() & 0x80) != 0 {
      utf8_end = utf8_end - 1
    }
  }
  is_valid_utf8(data.slice(0, utf8_end))
}

///| Sniff the MIME type of `data` via magic bytes and WHATWG text/markup heuristics.
pub fn sniff_mime(data : Bytes) -> String {
  let len = data.length()
  if len == 0 {
    return "application/octet-stream"
  }
  let b0 = data[0].to_int()

  // 1. Fixed binary magic signatures (fast dispatch on first byte)
  if b0 == 0x89 && len >= 8 &&
  data[1].to_int() == 0x50 && data[2].to_int() == 0x4E && data[3].to_int() == 0x47 &&
  data[4].to_int() == 0x0D && data[5].to_int() == 0x0A && data[6].to_int() == 0x1A && data[7].to_int() == 0x0A {
    return "image/png"
  }
  if b0 == 0xFF && len >= 3 && data[1].to_int() == 0xD8 && data[2].to_int() == 0xFF {
    return "image/jpeg"
  }
  if b0 == 0xFF && len >= 2 {
    let b1 = data[1].to_int()
    if b1 == 0xFB || b1 == 0xF3 || b1 == 0xF2 {
      return "audio/mpeg"
    }
  }
  if b0 == 0x47 && (match_ascii_at(data, 0, "GIF87a") || match_ascii_at(data, 0, "GIF89a")) {
    return "image/gif"
  }
  if b0 == 0x52 && len >= 12 && match_ascii_at(data, 0, "RIFF") {
    if match_ascii_at(data, 8, "WEBP") {
      return "image/webp"
    }
    if match_ascii_at(data, 8, "WAVE") {
      return "audio/wav"
    }
  }
  if b0 == 0x42 && len >= 2 && data[1].to_int() == 0x4D {
    return "image/bmp"
  }
  if b0 == 0x00 {
    // WASM: \x00asm\x01\x00\x00\x00
    if len >= 8 &&
    data[1].to_int() == 0x61 && data[2].to_int() == 0x73 && data[3].to_int() == 0x6D &&
    data[4].to_int() == 0x01 && data[5].to_int() == 0x00 && data[6].to_int() == 0x00 && data[7].to_int() == 0x00 {
      return "application/wasm"
    }
    // ICO: \x00\x00\x01\x00
    if len >= 4 && data[1].to_int() == 0x00 && data[2].to_int() == 0x01 && data[3].to_int() == 0x00 {
      return "image/x-icon"
    }
    // TTF: \x00\x01\x00\x00\x00
    if len >= 5 && data[1].to_int() == 0x01 && data[2].to_int() == 0x00 && data[3].to_int() == 0x00 && data[4].to_int() == 0x00 {
      return "font/ttf"
    }
    // ISO Base Media File Format (ftyp at offset 4): AVIF / MP4
    if len >= 12 && match_ascii_at(data, 4, "ftyp") {
      if match_ascii_at(data, 8, "avif") || match_ascii_at(data, 8, "avis") {
        return "image/avif"
      }
      if match_ascii_at(data, 8, "isom") || match_ascii_at(data, 8, "mp41") ||
      match_ascii_at(data, 8, "mp42") || match_ascii_at(data, 8, "M4V ") ||
      match_ascii_at(data, 8, "avc1") || match_ascii_at(data, 8, "iso2") ||
      match_ascii_at(data, 8, "dash") {
        return "video/mp4"
      }
    }
  }
  if b0 == 0x25 && match_ascii_at(data, 0, "%PDF-") {
    return "application/pdf"
  }
  if b0 == 0x50 && len >= 4 && data[1].to_int() == 0x4B {
    let b2 = data[2].to_int()
    let b3 = data[3].to_int()
    if (b2 == 0x03 && b3 == 0x04) || (b2 == 0x05 && b3 == 0x06) || (b2 == 0x07 && b3 == 0x08) {
      return "application/zip"
    }
  }
  if b0 == 0x1F && len >= 2 && data[1].to_int() == 0x8B {
    return "application/gzip"
  }
  if b0 == 0x28 && len >= 4 && data[1].to_int() == 0xB5 && data[2].to_int() == 0x2F && data[3].to_int() == 0xFD {
    return "application/zstd"
  }
  if b0 == 0x7F && len >= 4 && data[1].to_int() == 0x45 && data[2].to_int() == 0x4C && data[3].to_int() == 0x46 {
    return "application/x-elf"
  }
  // Mach-O (32/64 BE/LE & Fat)
  if len >= 4 {
    let b1 = data[1].to_int()
    let b2 = data[2].to_int()
    let b3 = data[3].to_int()
    if (b0 == 0xFE && b1 == 0xED && b2 == 0xFA && (b3 == 0xCE || b3 == 0xCF)) ||
    ((b0 == 0xCE || b0 == 0xCF) && b1 == 0xFA && b2 == 0xED && b3 == 0xFE) ||
    (b0 == 0xCA && b1 == 0xFE && b2 == 0xBA && b3 == 0xBE) {
      return "application/x-mach-binary"
    }
  }
  // WebM / EBML
  if b0 == 0x1A && len >= 4 && data[1].to_int() == 0x45 && data[2].to_int() == 0xDF && data[3].to_int() == 0xA3 {
    let scan_end = if len < 64 { len } else { 64 }
    if contains_ascii_ci(data, 4, scan_end, "webm") {
      return "video/webm"
    }
    return "video/x-matroska"
  }
  if b0 == 0x49 && match_ascii_at(data, 0, "ID3") {
    return "audio/mpeg"
  }
  if b0 == 0x4F && match_ascii_at(data, 0, "OggS") {
    return "application/ogg"
  }
  if b0 == 0x66 && match_ascii_at(data, 0, "fLaC") {
    return "audio/flac"
  }
  if b0 == 0x77 {
    if match_ascii_at(data, 0, "wOFF") {
      return "font/woff"
    }
    if match_ascii_at(data, 0, "wOF2") {
      return "font/woff2"
    }
  }
  if b0 == 0x4F && match_ascii_at(data, 0, "OTTO") {
    return "font/otf"
  }
  if b0 == 0x53 && match_ascii_at(data, 0, "SQLite format 3\x00") {
    return "application/vnd.sqlite3"
  }
  // TAR: "ustar" at offset 257
  if len >= 262 && match_ascii_at(data, 257, "ustar") {
    return "application/x-tar"
  }

  // 2. Text / Markup / JSON detection (skip optional UTF-8 BOM + leading ASCII whitespace)
  let mut pos = 0
  if len >= 3 && data[0].to_int() == 0xEF && data[1].to_int() == 0xBB && data[2].to_int() == 0xBF {
    pos = 3
  }
  pos = skip_ws(data, pos, len)
  if pos < len {
    let c = data[pos].to_int()
    if c == 60 {
      // '<' -> SVG, XML, or HTML
      if match_ascii_ci_at(data, pos, "<svg") {
        return "image/svg+xml"
      }
      if match_ascii_ci_at(data, pos, "<?xml") {
        let scan_end = if len < 512 { len } else { 512 }
        if contains_ascii_ci(data, pos, scan_end, "<svg") {
          return "image/svg+xml"
        }
        return "text/xml; charset=utf-8"
      }
      if match_ascii_ci_at(data, pos, "<!doctype html") ||
      match_ascii_ci_at(data, pos, "<html") ||
      match_ascii_ci_at(data, pos, "<head") ||
      match_ascii_ci_at(data, pos, "<script") ||
      match_ascii_ci_at(data, pos, "<iframe") ||
      match_ascii_ci_at(data, pos, "<h1") ||
      match_ascii_ci_at(data, pos, "<div") ||
      match_ascii_ci_at(data, pos, "<font") ||
      match_ascii_ci_at(data, pos, "<table") ||
      match_ascii_ci_at(data, pos, "<a ") ||
      match_ascii_ci_at(data, pos, "<style") ||
      match_ascii_ci_at(data, pos, "<title") ||
      match_ascii_ci_at(data, pos, "<body") ||
      match_ascii_ci_at(data, pos, "<p>") ||
      match_ascii_ci_at(data, pos, "<!--") {
        return "text/html; charset=utf-8"
      }
    } else if (c == 123 || c == 91) && is_utf8_text(data) {
      // '{' or '[' with matching closing delimiter -> JSON
      let mut end = len
      while end > pos {
        let tc = data[end - 1].to_int()
        if tc == 32 || tc == 9 || tc == 13 || tc == 10 {
          end = end - 1
        } else {
          break
        }
      }
      if end > pos + 1 {
        let last = data[end - 1].to_int()
        if (c == 123 && last == 125) || (c == 91 && last == 93) {
          return "application/json"
        }
      }
    }
  }

  if is_utf8_text(data) {
    return "text/plain; charset=utf-8"
  }
  "application/octet-stream"
}
