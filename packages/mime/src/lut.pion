///| Lookup tables (256-entry FixedArrays) and low-level byte/ASCII helpers for `packages/mime`.

///| RFC 2045 / 9110 §5.6.2 token character predicate (`tchar`).
#verify
pub fn is_tchar_byte(c : Int) -> Bool {
  (c >= 48 && c <= 57) ||
  (c >= 65 && c <= 90) ||
  (c >= 97 && c <= 122) ||
  c == 33 ||
  c == 35 ||
  c == 36 ||
  c == 37 ||
  c == 38 ||
  c == 39 ||
  c == 42 ||
  c == 43 ||
  c == 45 ||
  c == 46 ||
  c == 94 ||
  c == 95 ||
  c == 96 ||
  c == 124 ||
  c == 126
}

///| RFC 5987 §3.2.1 `attr-char` predicate (`tchar` minus `'`, `*`, `%`).
#verify
pub fn is_attr_char_byte(c : Int) -> Bool {
  (c >= 48 && c <= 57) ||
  (c >= 65 && c <= 90) ||
  (c >= 97 && c <= 122) ||
  c == 33 ||
  c == 35 ||
  c == 36 ||
  c == 38 ||
  c == 43 ||
  c == 45 ||
  c == 46 ||
  c == 94 ||
  c == 95 ||
  c == 96 ||
  c == 124 ||
  c == 126
}

///| RFC 2046 §5.1.1 multipart boundary `bcharsnospace` predicate.
#verify
pub fn is_bchar_nospace_byte(c : Int) -> Bool {
  (c >= 48 && c <= 57) ||
  (c >= 65 && c <= 90) ||
  (c >= 97 && c <= 122) ||
  c == 39 ||
  c == 40 ||
  c == 41 ||
  c == 43 ||
  c == 44 ||
  c == 45 ||
  c == 46 ||
  c == 47 ||
  c == 58 ||
  c == 61 ||
  c == 63 ||
  c == 95
}

///| Decode a single ASCII hex digit into `0..15`, or `-1` if invalid.
#verify
pub fn hex_nibble_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

///| Encode a 4-bit nibble (`0..15`) to uppercase ASCII hex (`'0'..'9'`, `'A'..'F'`).
#verify
pub fn hex_upper_digit(n : Int) -> Int {
  if n < 10 {
    48 + n
  } else {
    55 + n
  }
}

///| ASCII lowercase transformation on a byte value (`'A'..'Z' → 'a'..'z'`, others unchanged).
#verify
pub fn ascii_lower_byte(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

///| RFC 2045 / 9110 token character table (tchar): 1 if valid token char, 0 otherwise.
let tchar_lut : FixedArray[Int] = build_tchar_lut()

///|
fn build_tchar_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    if is_tchar_byte(i) {
      lut[i] = 1
    }
    i = i + 1
  }
  lut
}

///| Hex digit value (0..15) or -1.
let hex_dec_lut : FixedArray[Int] = build_hex_dec_lut()

///|
fn build_hex_dec_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, -1)
  let mut i = 0
  while i < 256 {
    lut[i] = hex_nibble_val(i)
    i = i + 1
  }
  lut
}

///| Uppercase hex ASCII bytes '0'..'F'.
let hex_upper_bytes : FixedArray[Byte] = build_hex_upper_bytes()

///|
fn build_hex_upper_bytes() -> FixedArray[Byte] {
  let lut : FixedArray[Byte] = FixedArray::make(16, b'0')
  let mut i = 0
  while i < 16 {
    lut[i] = hex_upper_digit(i).to_byte()
    i = i + 1
  }
  lut
}

///| ASCII lowercase lookup table.
let lower_lut : FixedArray[Int] = build_lower_lut()

///|
fn build_lower_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    lut[i] = ascii_lower_byte(i)
    i = i + 1
  }
  lut
}

///| RFC 5987 attr-char lookup table: ALPHA / DIGIT / "!" / "#" / "$" / "&" / "+" / "-" / "." / "^" / "_" / "`" / "|" / "~"
let attr_char_lut : FixedArray[Int] = build_attr_char_lut()

///|
fn build_attr_char_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    if is_attr_char_byte(i) {
      lut[i] = 1
    }
    i = i + 1
  }
  lut
}

///| RFC 2046 §5.1.1 bcharsnospace lookup table (plus space handled separately).
let bchar_nospace_lut : FixedArray[Int] = build_bchar_nospace_lut()

///|
fn build_bchar_nospace_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    if is_bchar_nospace_byte(i) {
      lut[i] = 1
    }
    i = i + 1
  }
  lut
}

///| Base64 standard encoding alphabet.
let b64_enc_lut : FixedArray[Byte] = [
  b'A', b'B', b'C', b'D', b'E', b'F', b'G', b'H', b'I', b'J', b'K', b'L', b'M', b'N', b'O', b'P',
  b'Q', b'R', b'S', b'T', b'U', b'V', b'W', b'X', b'Y', b'Z', b'a', b'b', b'c', b'd', b'e', b'f',
  b'g', b'h', b'i', b'j', b'k', b'l', b'm', b'n', b'o', b'p', b'q', b'r', b's', b't', b'u', b'v',
  b'w', b'x', b'y', b'z', b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'+', b'/',
]

///| Base64 standard decoding table: 0..63 for alphabet, -1 otherwise.
let b64_dec_lut : FixedArray[Int] = build_b64_dec_lut()

///|
fn build_b64_dec_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, -1)
  let mut i = 0
  while i < 64 {
    lut[b64_enc_lut[i].to_int()] = i
    i = i + 1
  }
  lut
}

///| Convert a slice of Bytes [start, end) to String.
fn bytes_slice_to_string(buf : Bytes, start : Int, end : Int) -> String {
  if start >= end {
    return ""
  }
  buf.slice(start, end).to_string()
}

///| Lowercase ASCII bytes in [start, end) into a new String.
fn bytes_slice_to_lower_string(buf : Bytes, start : Int, end : Int) -> String {
  let len = end - start
  if len <= 0 {
    return ""
  }
  let llut = lower_lut
  let mut has_upper = false
  let mut i = start
  while i < end {
    let b = buf[i].to_int()
    if b >= 65 && b <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return buf.slice(start, end).to_string()
  }
  let mut out = Bytes::new(len)
  i = 0
  while i < len {
    out[i] = llut[buf[start + i].to_int()].to_byte()
    i = i + 1
  }
  out.to_string()
}

///| Lowercase an ASCII string.
fn ascii_lower(s : String) -> String {
  let b = s.to_bytes()
  bytes_slice_to_lower_string(b, 0, b.length())
}

///| Case-insensitive ASCII string equality.
fn ascii_eq_ignore_case(a : String, b : String) -> Bool {
  let ab = a.to_bytes()
  let bb = b.to_bytes()
  let len = ab.length()
  if len != bb.length() {
    return false
  }
  let llut = lower_lut
  let mut i = 0
  while i < len {
    if llut[ab[i].to_int()] != llut[bb[i].to_int()] {
      return false
    }
    i = i + 1
  }
  true
}

///| Check if all bytes in [start, end) are valid RFC 2045/9110 token chars.
fn is_valid_token_bytes(buf : Bytes, start : Int, end : Int) -> Bool {
  if start >= end {
    return false
  }
  let tlut = tchar_lut
  let mut i = start
  while i < end {
    if tlut[buf[i].to_int()] == 0 {
      return false
    }
    i = i + 1
  }
  true
}

///| Convert ISO-8859-1 (Latin-1) raw bytes to UTF-8 Bytes.
fn latin1_to_utf8(raw : Bytes) -> Bytes {
  let len = raw.length()
  let mut extra = 0
  let mut i = 0
  while i < len {
    if raw[i].to_int() >= 0x80 {
      extra = extra + 1
    }
    i = i + 1
  }
  if extra == 0 {
    return raw
  }
  let mut out = Bytes::new(len + extra)
  let mut pos = 0
  i = 0
  while i < len {
    let c = raw[i].to_int()
    if c < 0x80 {
      out[pos] = c.to_byte()
      pos = pos + 1
    } else {
      out[pos] = (0xC0 | (c >> 6)).to_byte()
      out[pos + 1] = (0x80 | (c & 0x3F)).to_byte()
      pos = pos + 2
    }
    i = i + 1
  }
  out
}

///| Validate strict UTF-8 byte sequence.
fn is_valid_utf8(buf : Bytes) -> Bool {
  let len = buf.length()
  let mut i = 0
  while i < len {
    let b0 = buf[i].to_int()
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= len {
        return false
      }
      let b1 = buf[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= len {
        return false
      }
      let b1 = buf[i + 1].to_int()
      let b2 = buf[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if (b0 == 0xE0 && b1 < 0xA0) || (b0 == 0xED && b1 >= 0xA0) {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= len {
        return false
      }
      let b1 = buf[i + 1].to_int()
      let b2 = buf[i + 2].to_int()
      let b3 = buf[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if (b0 == 0xF0 && b1 < 0x90) || (b0 == 0xF4 && b1 >= 0x90) {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| Check if a string contains CR, LF, or NUL.
fn has_crlf_or_nul(s : String) -> Bool {
  let b = s.to_bytes()
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int()
    if c == 13 || c == 10 || c == 0 {
      return true
    }
    i = i + 1
  }
  false
}

///| RFC 2045 §5.1 tspecials table: `()<>@,;:\"/[]?=` -> 1, else 0.
let tspecial_lut : FixedArray[Int] = build_tspecial_lut()

///|
fn build_tspecial_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  lut[40] = 1 // (
  lut[41] = 1 // )
  lut[60] = 1 // <
  lut[62] = 1 // >
  lut[64] = 1 // @
  lut[44] = 1 // ,
  lut[59] = 1 // ;
  lut[58] = 1 // :
  lut[92] = 1 // \
  lut[34] = 1 // "
  lut[47] = 1 // /
  lut[91] = 1 // [
  lut[93] = 1 // ]
  lut[63] = 1 // ?
  lut[61] = 1 // =
  lut
}

///| Fast non-overflowing string hash (DJB2 with avalanche mix, masked to positive 31-bit Int).
fn hash_str(s : String) -> Int {
  let b = s.to_bytes()
  let len = b.length()
  let mut h = 5381
  let mut i = 0
  while i < len {
    h = (((h & 0x03FFFFFF) * 33) + b[i].to_int()) & 0x7FFFFFFF
    i = i + 1
  }
  (h ^ (h >> 15)) & 0x7FFFFFFF
}

///| Open-addressing hash map from String -> Int index (O(1) amortized lookup & insert, cached hashes).
struct StrIndexMap {
  keys : Array[String]
  hashes : Array[Int]
  vals : Array[Int]
  mut slots : FixedArray[Int]
  mut mask : Int
}

///|
fn StrIndexMap::new(initial_cap : Int) -> StrIndexMap {
  let mut cap = 16
  while cap < initial_cap {
    cap = cap * 2
  }
  StrIndexMap::{
    keys: [],
    hashes: [],
    vals: [],
    slots: FixedArray::make(cap, -1),
    mask: cap - 1,
  }
}

///|
fn StrIndexMap::grow(self : StrIndexMap) -> Unit {
  let new_cap = (self.mask + 1) * 2
  let new_mask = new_cap - 1
  let new_slots : FixedArray[Int] = FixedArray::make(new_cap, -1)
  let mut i = 0
  let n = self.keys.length()
  while i < n {
    let mut idx = self.hashes[i] & new_mask
    while new_slots[idx] >= 0 {
      idx = (idx + 1) & new_mask
    }
    new_slots[idx] = i
    i = i + 1
  }
  self.slots = new_slots
  self.mask = new_mask
}

///| Lookup `key` using precomputed hash `h`, returning mapped Int value or -1 if absent.
fn StrIndexMap::get_h(self : StrIndexMap, key : String, h : Int) -> Int {
  let mut idx = h & self.mask
  while true {
    let entry = self.slots[idx]
    if entry < 0 {
      return -1
    }
    if self.hashes[entry] == h && self.keys[entry] == key {
      return self.vals[entry]
    }
    idx = (idx + 1) & self.mask
  }
  -1
}

///| Lookup `key`, returning mapped Int value or -1 if absent.
fn StrIndexMap::get(self : StrIndexMap, key : String) -> Int {
  self.get_h(key, hash_str(key))
}

///| Insert or update `key -> v` using precomputed hash `h`.
fn StrIndexMap::put_h(self : StrIndexMap, key : String, h : Int, v : Int) -> Unit {
  if (self.keys.length() + 1) * 2 > self.mask + 1 {
    self.grow()
  }
  let mut idx = h & self.mask
  while true {
    let entry = self.slots[idx]
    if entry < 0 {
      let new_entry = self.keys.length()
      self.keys.push(key)
      self.hashes.push(h)
      self.vals.push(v)
      self.slots[idx] = new_entry
      return
    }
    if self.hashes[entry] == h && self.keys[entry] == key {
      self.vals[entry] = v
      return
    }
    idx = (idx + 1) & self.mask
  }
}

///| Insert or update `key -> v`.
fn StrIndexMap::put(self : StrIndexMap, key : String, v : Int) -> Unit {
  self.put_h(key, hash_str(key), v)
}

///| Open-addressing hash map from Int -> Int index (O(1) amortized lookup & insert).
struct IntIndexMap {
  keys : Array[Int]
  vals : Array[Int]
  mut slots : FixedArray[Int]
  mut mask : Int
}

///|
fn hash_int(k : Int) -> Int {
  let mut h = (k ^ (k >> 16)) & 0x7FFFFFFF
  h = (((h & 0x0000FFFF) * 2654435761) ^ (h >> 11)) & 0x7FFFFFFF
  h
}

///|
fn IntIndexMap::new(initial_cap : Int) -> IntIndexMap {
  let mut cap = 16
  while cap < initial_cap {
    cap = cap * 2
  }
  IntIndexMap::{
    keys: [],
    vals: [],
    slots: FixedArray::make(cap, -1),
    mask: cap - 1,
  }
}

///|
fn IntIndexMap::grow(self : IntIndexMap) -> Unit {
  let new_cap = (self.mask + 1) * 2
  let new_mask = new_cap - 1
  let new_slots : FixedArray[Int] = FixedArray::make(new_cap, -1)
  let mut i = 0
  let n = self.keys.length()
  while i < n {
    let mut idx = hash_int(self.keys[i]) & new_mask
    while new_slots[idx] >= 0 {
      idx = (idx + 1) & new_mask
    }
    new_slots[idx] = i
    i = i + 1
  }
  self.slots = new_slots
  self.mask = new_mask
}

///|
fn IntIndexMap::get(self : IntIndexMap, key : Int) -> Int {
  let mut idx = hash_int(key) & self.mask
  while true {
    let entry = self.slots[idx]
    if entry < 0 {
      return -1
    }
    if self.keys[entry] == key {
      return self.vals[entry]
    }
    idx = (idx + 1) & self.mask
  }
  -1
}

///|
fn IntIndexMap::put(self : IntIndexMap, key : Int, v : Int) -> Unit {
  if (self.keys.length() + 1) * 2 > self.mask + 1 {
    self.grow()
  }
  let mut idx = hash_int(key) & self.mask
  while true {
    let entry = self.slots[idx]
    if entry < 0 {
      let new_entry = self.keys.length()
      self.keys.push(key)
      self.vals.push(v)
      self.slots[idx] = new_entry
      return
    }
    if self.keys[entry] == key {
      self.vals[entry] = v
      return
    }
    idx = (idx + 1) & self.mask
  }
}

///| Compare two strings lexicographically by byte value.
fn str_lt(a : String, b : String) -> Bool {
  let ab = a.to_bytes()
  let bb = b.to_bytes()
  let al = ab.length()
  let bl = bb.length()
  let m = if al < bl { al } else { bl }
  let mut i = 0
  while i < m {
    let ca = ab[i].to_int()
    let cb = bb[i].to_int()
    if ca != cb {
      return ca < cb
    }
    i = i + 1
  }
  al < bl
}
