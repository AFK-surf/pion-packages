///| Core types, limits, and errors for `packages/mime` (RFC 2045/2046/2047/2231/5987/6266/7578/9110).

///|
pub enum MimeError {
  EmptyInput
  InvalidMediaType
  InvalidParameterName
  InvalidParameterValue
  DuplicateParameter
  InvalidEscape
  InvalidPercentEncoding
  InvalidCharset
  InvalidDisposition
  InvalidAcceptHeader
  InvalidQualityValue
  InvalidBoundary
  InvalidMultipart
  InvalidPartHeader
  CrlfInjection
  TooManyParts
  TooManyHeaders
  HeaderTooLarge
  PartTooLarge
  UnexpectedEof
  InvalidQuotedPrintable
  InvalidRfc2047
  InvalidBase64
}

///|
pub fn mime_error_string(err : MimeError) -> String {
  match err {
    MimeError::EmptyInput => "empty input"
    MimeError::InvalidMediaType => "invalid media type"
    MimeError::InvalidParameterName => "invalid parameter name"
    MimeError::InvalidParameterValue => "invalid parameter value"
    MimeError::DuplicateParameter => "duplicate parameter name"
    MimeError::InvalidEscape => "invalid escape sequence"
    MimeError::InvalidPercentEncoding => "invalid percent-encoding"
    MimeError::InvalidCharset => "unsupported or invalid charset"
    MimeError::InvalidDisposition => "invalid content disposition"
    MimeError::InvalidAcceptHeader => "invalid Accept header"
    MimeError::InvalidQualityValue => "invalid quality (q) value"
    MimeError::InvalidBoundary => "invalid multipart boundary"
    MimeError::InvalidMultipart => "invalid multipart structure"
    MimeError::InvalidPartHeader => "invalid multipart part header"
    MimeError::CrlfInjection => "CRLF injection rejected"
    MimeError::TooManyParts => "too many multipart parts"
    MimeError::TooManyHeaders => "too many headers in part"
    MimeError::HeaderTooLarge => "part header exceeds size limit"
    MimeError::PartTooLarge => "part body exceeds size limit"
    MimeError::UnexpectedEof => "unexpected end of input"
    MimeError::InvalidQuotedPrintable => "invalid quoted-printable sequence"
    MimeError::InvalidRfc2047 => "invalid RFC 2047 encoded-word"
    MimeError::InvalidBase64 => "invalid base64 data"
  }
}

///|
pub fn MimeError::to_string(self : MimeError) -> String {
  mime_error_string(self)
}

///|
pub val struct Param {
  pub name : String
  pub value : String
}

///|
pub fn Param::new(name : String, value : String) -> Param {
  Param::{ name: name, value: value }
}

///|
pub struct MediaType {
  pub type_name : String
  pub subtype : String
  pub params : Array[Param]
}

///|
pub fn MediaType::essence(self : MediaType) -> String {
  self.type_name + "/" + self.subtype
}

///|
pub fn MediaType::param(self : MediaType, name : String) -> Option[String] {
  let mut i = 0
  while i < self.params.length() {
    if ascii_eq_ignore_case(self.params[i].name, name) {
      return Some(self.params[i].value)
    }
    i = i + 1
  }
  None
}

///|
pub fn MediaType::to_string(self : MediaType) -> String {
  match format_media_type(self.essence(), self.params) {
    Ok(s) => s
    Err(_) => self.essence()
  }
}

///|
pub struct ContentDisposition {
  pub disposition : String
  pub params : Array[Param]
}

///|
pub fn ContentDisposition::param(self : ContentDisposition, name : String) -> Option[String] {
  let mut i = 0
  while i < self.params.length() {
    if ascii_eq_ignore_case(self.params[i].name, name) {
      return Some(self.params[i].value)
    }
    i = i + 1
  }
  None
}

///|
pub fn ContentDisposition::filename(self : ContentDisposition) -> Option[String] {
  self.param("filename")
}

///| Check if `stem` (lowercased) is a Windows reserved DOS device name.
fn is_windows_reserved_device(stem_lower : String) -> Bool {
  match stem_lower {
    "con" | "prn" | "aux" | "nul" => true
    "com1" | "com2" | "com3" | "com4" | "com5" | "com6" | "com7" | "com8" | "com9" => true
    "lpt1" | "lpt2" | "lpt3" | "lpt4" | "lpt5" | "lpt6" | "lpt7" | "lpt8" | "lpt9" => true
    _ => false
  }
}

///| Whether `c` is a Unix (`/`) or Windows (`\\`) path separator byte.
#verify
pub fn is_path_sep_byte(c : Int) -> Bool {
  c == 47 || c == 92
}

///| Whether `c` is an ASCII C0 control (`0x00..0x1F`) or DEL (`0x7F`) byte stripped from filenames.
#verify
pub fn is_filename_c0_or_del(c : Int) -> Bool {
  c < 0x20 || c == 0x7F
}

///| Whether `(b0, b1)` is a 2-byte UTF-8 C1 control (`U+0080..U+009F`: `C2 80..9F`).
#verify
pub fn is_utf8_c1_pair(b0 : Int, b1 : Int) -> Bool {
  b0 == 0xC2 && b1 >= 0x80 && b1 <= 0x9F
}

///| Whether `(b0, b1, b2)` is a 3-byte UTF-8 bidi control (RLO/LRO/LRI/RLI/FSI/PDI/LRM/RLM).
#verify
pub fn is_utf8_bidi_3byte(b0 : Int, b1 : Int, b2 : Int) -> Bool {
  b0 == 0xE2 &&
  (
    (b1 == 0x80 && ((b2 >= 0x8E && b2 <= 0x8F) || (b2 >= 0xAA && b2 <= 0xAE))) ||
    (b1 == 0x81 && b2 >= 0xA6 && b2 <= 0xA9)
  )
}

///| Extract a safe basename from `filename`, stripping Unix/Windows path separators,
///| directory traversal (`..`, `.`), dotfiles, NTFS ADS / drive colons, C0/C1/bidi controls,
///| Windows reserved device names, trailing dots/spaces, and capping at 255 UTF-8 bytes.
pub fn ContentDisposition::safe_filename(self : ContentDisposition) -> Option[String] {
  let raw = match self.filename() {
    Some(s) => s
    None => return None
  }
  let b = raw.to_bytes()
  let len = b.length()
  if len == 0 {
    return None
  }
  // Find last '/' or '\\'
  let mut start = 0
  let mut i = 0
  while i < len {
    let c = b[i].to_int()
    if is_path_sep_byte(c) {
      start = i + 1
    }
    i = i + 1
  }
  if start >= len {
    return None
  }
  // Strip C0 (0x00..0x1F), DEL (0x7F), C1 (U+0080..U+009F: C2 80..9F),
  // and Unicode bidi controls (U+061C, U+200E..U+200F, U+202A..U+202E, U+2066..U+2069).
  // Reject NTFS alternate data streams / drive-relative ':'.
  let sb = StringBuilder::new()
  let mut clean_len = 0
  i = start
  while i < len {
    let c = b[i].to_int()
    if c == 58 {
      // ':' (NTFS ADS / Windows drive prefix)
      return None
    }
    if is_filename_c0_or_del(c) {
      i = i + 1
      continue
    }
    // Check 2-byte UTF-8 controls: C1 (C2 80..9F) and U+061C (D8 9C)
    if i + 1 < len && is_utf8_c1_pair(c, b[i + 1].to_int()) {
      i = i + 2
      continue
    }
    if c == 0xD8 && i + 1 < len && b[i + 1].to_int() == 0x9C {
      i = i + 2
      continue
    }
    // Check 3-byte UTF-8 bidi controls:
    // U+200E..U+200F (E2 80 8E..8F), U+202A..U+202E (E2 80 AA..AE), U+2066..U+2069 (E2 81 A6..A9)
    if i + 2 < len && is_utf8_bidi_3byte(c, b[i + 1].to_int(), b[i + 2].to_int()) {
      i = i + 3
      continue
    }
    sb.write_byte(b[i])
    clean_len = clean_len + 1
    i = i + 1
  }
  if clean_len == 0 {
    return None
  }
  let clean_bytes = sb.to_string().to_bytes()
  // Truncate to <= 255 bytes on a valid UTF-8 character boundary
  let mut end = clean_bytes.length()
  if end > 255 {
    end = 255
    // Back up past any UTF-8 continuation bytes (10xxxxxx)
    while end > 0 && (clean_bytes[end].to_int() & 0xC0) == 0x80 {
      end = end - 1
    }
  }
  // Strip trailing dots and spaces (Windows silently strips them, enabling extension allow-list bypass)
  while end > 0 {
    let tc = clean_bytes[end - 1].to_int()
    if tc == 46 || tc == 32 {
      end = end - 1
    } else {
      break
    }
  }
  if end == 0 {
    return None
  }
  // Reject dotfiles ('.', '..', '.htaccess', etc.) and whitespace-only names
  if clean_bytes[0].to_int() == 46 {
    return None
  }
  let mut all_space = true
  let mut si = 0
  while si < end {
    if clean_bytes[si].to_int() != 32 {
      all_space = false
      break
    }
    si = si + 1
  }
  if all_space {
    return None
  }
  // Reject Windows reserved device names (case-insensitive stem before first '.')
  let mut dot_pos = end
  si = 0
  while si < end {
    if clean_bytes[si].to_int() == 46 {
      dot_pos = si
      break
    }
    si = si + 1
  }
  let stem_lower = bytes_slice_to_lower_string(clean_bytes, 0, dot_pos)
  if is_windows_reserved_device(stem_lower) {
    return None
  }
  Some(bytes_slice_to_string(clean_bytes, 0, end))
}

///|
pub fn ContentDisposition::name(self : ContentDisposition) -> Option[String] {
  self.param("name")
}

///|
pub struct MediaRange {
  pub type_name : String
  pub subtype : String
  pub params : Array[Param]
  ///| Quality weight in thousandths: 0..=1000 (1.0 == 1000).
  pub q : Int
}

///|
pub val struct MultipartLimits {
  pub max_parts : Int
  pub max_headers_per_part : Int
  pub max_header_bytes : Int
  pub max_part_bytes : Int
  pub max_params_per_header : Int
}

///|
pub fn MultipartLimits::default() -> MultipartLimits {
  MultipartLimits::{
    max_parts: 1000,
    max_headers_per_part: 100,
    max_header_bytes: 65536,
    max_part_bytes: 67108864,
    max_params_per_header: 16384,
  }
}

///|
pub val struct PartHeader {
  pub name : String
  pub value : String
}

///|
pub fn PartHeader::new(name : String, value : String) -> PartHeader {
  PartHeader::{ name: name, value: value }
}

///|
pub struct Part {
  pub headers : Array[PartHeader]
  pub body : Bytes
}

///|
pub fn Part::header(self : Part, name : String) -> Option[String] {
  let mut i = 0
  while i < self.headers.length() {
    if ascii_eq_ignore_case(self.headers[i].name, name) {
      return Some(self.headers[i].value)
    }
    i = i + 1
  }
  None
}

///|
pub fn Part::headers_all(self : Part, name : String) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < self.headers.length() {
    if ascii_eq_ignore_case(self.headers[i].name, name) {
      out.push(self.headers[i].value)
    }
    i = i + 1
  }
  out
}

///|
pub fn Part::content_type(self : Part) -> Option[String] {
  self.header("content-type")
}

///|
pub fn Part::content_disposition(self : Part) -> Option[ContentDisposition] {
  match self.header("content-disposition") {
    Some(v) =>
    match parse_content_disposition(v) {
      Ok(cd) => Some(cd)
      Err(_) => None
    }
    None => None
  }
}

///|
pub fn Part::form_name(self : Part) -> Option[String] {
  match self.content_disposition() {
    Some(cd) => cd.name()
    None => None
  }
}

///|
pub fn Part::filename(self : Part) -> Option[String] {
  match self.content_disposition() {
    Some(cd) => cd.filename()
    None => None
  }
}

///|
pub fn Part::body_string(self : Part) -> String {
  self.body.to_string()
}
