///| Core types, limits, and errors for `packages/mime` (RFC 2045/2046/2047/2231/5987/6266/7578/9110).

///|
pub enum MimeError {
  EmptyInput
  InvalidMediaType
  InvalidParameterName
  InvalidParameterValue
  DuplicateParameter
  InvalidEscape
  InvalidPercentEncoding
  InvalidCharset
  InvalidDisposition
  InvalidAcceptHeader
  InvalidQualityValue
  InvalidBoundary
  InvalidMultipart
  InvalidPartHeader
  CrlfInjection
  TooManyParts
  TooManyHeaders
  HeaderTooLarge
  PartTooLarge
  UnexpectedEof
  InvalidQuotedPrintable
  InvalidRfc2047
  InvalidBase64
}

///|
pub fn mime_error_string(err : MimeError) -> String {
  match err {
    MimeError::EmptyInput => "empty input"
    MimeError::InvalidMediaType => "invalid media type"
    MimeError::InvalidParameterName => "invalid parameter name"
    MimeError::InvalidParameterValue => "invalid parameter value"
    MimeError::DuplicateParameter => "duplicate parameter name"
    MimeError::InvalidEscape => "invalid escape sequence"
    MimeError::InvalidPercentEncoding => "invalid percent-encoding"
    MimeError::InvalidCharset => "unsupported or invalid charset"
    MimeError::InvalidDisposition => "invalid content disposition"
    MimeError::InvalidAcceptHeader => "invalid Accept header"
    MimeError::InvalidQualityValue => "invalid quality (q) value"
    MimeError::InvalidBoundary => "invalid multipart boundary"
    MimeError::InvalidMultipart => "invalid multipart structure"
    MimeError::InvalidPartHeader => "invalid multipart part header"
    MimeError::CrlfInjection => "CRLF injection rejected"
    MimeError::TooManyParts => "too many multipart parts"
    MimeError::TooManyHeaders => "too many headers in part"
    MimeError::HeaderTooLarge => "part header exceeds size limit"
    MimeError::PartTooLarge => "part body exceeds size limit"
    MimeError::UnexpectedEof => "unexpected end of input"
    MimeError::InvalidQuotedPrintable => "invalid quoted-printable sequence"
    MimeError::InvalidRfc2047 => "invalid RFC 2047 encoded-word"
    MimeError::InvalidBase64 => "invalid base64 data"
  }
}

///|
pub fn MimeError::to_string(self : MimeError) -> String {
  mime_error_string(self)
}

///|
pub val struct Param {
  pub name : String
  pub value : String
}

///|
pub fn Param::new(name : String, value : String) -> Param {
  Param::{ name: name, value: value }
}

///|
pub struct MediaType {
  pub type_name : String
  pub subtype : String
  pub params : Array[Param]
}

///|
pub fn MediaType::essence(self : MediaType) -> String {
  self.type_name + "/" + self.subtype
}

///|
pub fn MediaType::param(self : MediaType, name : String) -> Option[String] {
  let _ = self
  let _ = name
  None
}

///|
pub fn MediaType::to_string(self : MediaType) -> String {
  match format_media_type(self.essence(), self.params) {
    Ok(s) => s
    Err(_) => self.essence()
  }
}

///|
pub struct ContentDisposition {
  pub disposition : String
  pub params : Array[Param]
}

///|
pub fn ContentDisposition::param(self : ContentDisposition, name : String) -> Option[String] {
  let _ = self
  let _ = name
  None
}

///|
pub fn ContentDisposition::filename(self : ContentDisposition) -> Option[String] {
  let _ = self
  None
}

///|
pub fn ContentDisposition::safe_filename(self : ContentDisposition) -> Option[String] {
  let _ = self
  None
}

///|
pub fn ContentDisposition::name(self : ContentDisposition) -> Option[String] {
  let _ = self
  None
}

///|
pub struct MediaRange {
  pub type_name : String
  pub subtype : String
  pub params : Array[Param]
  ///| Quality weight in thousandths: 0..=1000 (1.0 == 1000).
  pub q : Int
}

///|
pub val struct MultipartLimits {
  pub max_parts : Int
  pub max_headers_per_part : Int
  pub max_header_bytes : Int
  pub max_part_bytes : Int
}

///|
pub fn MultipartLimits::default() -> MultipartLimits {
  MultipartLimits::{
    max_parts: 1000,
    max_headers_per_part: 100,
    max_header_bytes: 65536,
    max_part_bytes: 67108864,
  }
}

///|
pub val struct PartHeader {
  pub name : String
  pub value : String
}

///|
pub fn PartHeader::new(name : String, value : String) -> PartHeader {
  PartHeader::{ name: name, value: value }
}

///|
pub struct Part {
  pub headers : Array[PartHeader]
  pub body : Bytes
}

///|
pub fn Part::header(self : Part, name : String) -> Option[String] {
  let _ = self
  let _ = name
  None
}

///|
pub fn Part::headers_all(self : Part, name : String) -> Array[String] {
  let _ = self
  let _ = name
  []
}

///|
pub fn Part::content_type(self : Part) -> Option[String] {
  self.header("content-type")
}

///|
pub fn Part::content_disposition(self : Part) -> Option[ContentDisposition] {
  let _ = self
  None
}

///|
pub fn Part::form_name(self : Part) -> Option[String] {
  let _ = self
  None
}

///|
pub fn Part::filename(self : Part) -> Option[String] {
  let _ = self
  None
}

///|
pub fn Part::body_string(self : Part) -> String {
  self.body.to_string()
}
