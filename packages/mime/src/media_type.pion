///| RFC 2045 / 9110 / 2231 / 5987 / 6266 Media-Type & Content-Disposition parser and formatter.

///|
fn skip_ws(buf : Bytes, pos0 : Int, end : Int) -> Int {
  let mut pos = pos0
  while pos < end {
    let c = buf[pos].to_int()
    if c == 32 || c == 9 || c == 13 || c == 10 {
      pos = pos + 1
    } else {
      break
    }
  }
  pos
}

///| Percent-decode bytes with strict 2-hex-digit validation.
fn percent_decode_strict(raw : Bytes) -> Result[Bytes, MimeError] {
  let len = raw.length()
  let hlut = hex_dec_lut
  let mut out_len = 0
  let mut i = 0
  while i < len {
    if raw[i].to_int() == 37 {
      if i + 2 >= len {
        return Err(MimeError::InvalidPercentEncoding)
      }
      let hi = hlut[raw[i + 1].to_int()]
      let lo = hlut[raw[i + 2].to_int()]
      if hi < 0 || lo < 0 {
        return Err(MimeError::InvalidPercentEncoding)
      }
      out_len = out_len + 1
      i = i + 3
    } else {
      out_len = out_len + 1
      i = i + 1
    }
  }
  if out_len == len {
    return Ok(raw)
  }
  let mut out = Bytes::new(out_len)
  let mut pos = 0
  i = 0
  while i < len {
    if raw[i].to_int() == 37 {
      let hi = hlut[raw[i + 1].to_int()]
      let lo = hlut[raw[i + 2].to_int()]
      out[pos] = ((hi << 4) | lo).to_byte()
      pos = pos + 1
      i = i + 3
    } else {
      out[pos] = raw[i]
      pos = pos + 1
      i = i + 1
    }
  }
  Ok(out)
}

///| Decode a charset-tagged raw byte payload (RFC 2231 / 5987) into a UTF-8 String.
fn decode_charset_bytes(charset_lower : String, raw : Bytes) -> Result[String, MimeError] {
  if charset_lower == "utf-8" || charset_lower == "utf8" {
    if !is_valid_utf8(raw) {
      return Err(MimeError::InvalidCharset)
    }
    Ok(raw.to_string())
  } else if charset_lower == "us-ascii" || charset_lower == "ascii" {
    let mut i = 0
    while i < raw.length() {
      if raw[i].to_int() >= 0x80 {
        return Err(MimeError::InvalidCharset)
      }
      i = i + 1
    }
    Ok(raw.to_string())
  } else if charset_lower == "iso-8859-1" || charset_lower == "latin1" || charset_lower == "latin-1" {
    Ok(latin1_to_utf8(raw).to_string())
  } else {
    Err(MimeError::InvalidCharset)
  }
}

///| Parse `charset'lang'value` prefix from an RFC 2231/5987 extended parameter value.
///| Returns `(charset_lower, encoded_value_bytes)`.
fn split_ext_value(raw_val : String) -> Result[(String, Bytes), MimeError] {
  let b = raw_val.to_bytes()
  let len = b.length()
  let mut q1 = -1
  let mut q2 = -1
  let mut i = 0
  while i < len {
    if b[i].to_int() == 39 {
      if q1 < 0 {
        q1 = i
      } else {
        q2 = i
        break
      }
    }
    i = i + 1
  }
  if q1 <= 0 || q2 < 0 {
    return Err(MimeError::InvalidParameterValue)
  }
  let charset = bytes_slice_to_lower_string(b, 0, q1)
  let rest = b.slice(q2 + 1, len)
  Ok((charset, rest))
}

///| Parse a non-negative decimal integer from ASCII bytes [start, end). Returns -1 if invalid.
fn parse_section_index(buf : Bytes, start : Int, end : Int) -> Int {
  if start >= end {
    return -1
  }
  // Leading zero forbidden except "0" itself (RFC 2231 §3)
  if end - start > 1 && buf[start].to_int() == 48 {
    return -1
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let d = buf[i].to_int() - 48
    if d < 0 || d > 9 {
      return -1
    }
    acc = acc * 10 + d
    if acc > 10000 {
      return -1
    }
    i = i + 1
  }
  acc
}

///| Internal representation of a continuation section for RFC 2231.
struct ContSection {
  base : String
  index : Int
  encoded : Bool
  value : String
}

///| Fast-path parameter parser for plain RFC 2045/9110 parameters (no RFC 2231 `*`).
///| Returns `Ok(Some(params))` if no `*` param was encountered, `Ok(None)` to fall back to RFC 2231 path.
fn parse_params_fast(buf : Bytes, start : Int, end : Int) -> Result[Option[Array[Param]], MimeError] {
  let tlut = tchar_lut
  let out : Array[Param] = []
  let mut pos = skip_ws(buf, start, end)

  while pos < end {
    if buf[pos].to_int() != 59 {
      return Err(MimeError::InvalidParameterName)
    }
    pos = skip_ws(buf, pos + 1, end)
    if pos >= end {
      break
    }

    let key_start = pos
    let mut has_star = false
    while pos < end && tlut[buf[pos].to_int()] == 1 {
      if buf[pos].to_int() == 42 {
        has_star = true
      }
      pos = pos + 1
    }
    if pos == key_start {
      return Err(MimeError::InvalidParameterName)
    }
    if has_star {
      return Ok(None)
    }
    let key = bytes_slice_to_lower_string(buf, key_start, pos)
    pos = skip_ws(buf, pos, end)
    if pos >= end || buf[pos].to_int() != 61 {
      return Err(MimeError::InvalidParameterName)
    }
    pos = skip_ws(buf, pos + 1, end)
    if pos >= end {
      return Err(MimeError::InvalidParameterValue)
    }

    let val_str = if buf[pos].to_int() == 34 {
      pos = pos + 1
      let qstart = pos
      let mut has_escape = false
      let mut closed = false
      while pos < end {
        let c = buf[pos].to_int()
        if c == 34 {
          closed = true
          break
        } else if c == 92 {
          if pos + 1 >= end {
            return Err(MimeError::InvalidEscape)
          }
          has_escape = true
          pos = pos + 2
        } else if c == 13 || c == 10 {
          return Err(MimeError::InvalidParameterValue)
        } else {
          pos = pos + 1
        }
      }
      if !closed {
        return Err(MimeError::InvalidParameterValue)
      }
      let qend = pos
      pos = pos + 1
      if !has_escape {
        bytes_slice_to_string(buf, qstart, qend)
      } else {
        let sb = StringBuilder::new()
        let mut qi = qstart
        while qi < qend {
          if buf[qi].to_int() == 92 {
            sb.write_byte(buf[qi + 1])
            qi = qi + 2
          } else {
            sb.write_byte(buf[qi])
            qi = qi + 1
          }
        }
        sb.to_string()
      }
    } else {
      let val_start = pos
      while pos < end && tlut[buf[pos].to_int()] == 1 {
        pos = pos + 1
      }
      if pos == val_start {
        return Err(MimeError::InvalidParameterValue)
      }
      bytes_slice_to_string(buf, val_start, pos)
    }

    pos = skip_ws(buf, pos, end)
    if pos < end && buf[pos].to_int() != 59 {
      return Err(MimeError::InvalidParameterValue)
    }

    let mut k = 0
    while k < out.length() {
      if out[k].name == key {
        return Err(MimeError::DuplicateParameter)
      }
      k = k + 1
    }
    out.push(Param::new(key, val_str))
  }
  Ok(Some(out))
}

///| Parse RFC 2045/2231/5987 `; key=value` parameter list starting at `start`.
fn parse_params_block(buf : Bytes, start : Int, end : Int) -> Result[Array[Param], MimeError] {
  if start >= end {
    return Ok([])
  }
  match parse_params_fast(buf, start, end) {
    Ok(Some(ps)) => return Ok(ps)
    Ok(None) => ()
    Err(e) => return Err(e)
  }
  let tlut = tchar_lut
  let plain_names : Array[String] = []
  let plain_vals : Array[String] = []
  let ext_names : Array[String] = []
  let ext_vals : Array[String] = []
  let conts : Array[ContSection] = []
  let mut pos = skip_ws(buf, start, end)

  while pos < end {
    if buf[pos].to_int() != 59 {
      return Err(MimeError::InvalidParameterName)
    }
    pos = skip_ws(buf, pos + 1, end)
    if pos >= end {
      // Trailing semicolon is permitted
      break
    }

    // Parse parameter name token
    let key_start = pos
    while pos < end && tlut[buf[pos].to_int()] == 1 {
      pos = pos + 1
    }
    if pos == key_start {
      return Err(MimeError::InvalidParameterName)
    }
    let raw_key = bytes_slice_to_lower_string(buf, key_start, pos)
    pos = skip_ws(buf, pos, end)
    if pos >= end || buf[pos].to_int() != 61 {
      return Err(MimeError::InvalidParameterName)
    }
    pos = skip_ws(buf, pos + 1, end)
    if pos >= end {
      return Err(MimeError::InvalidParameterValue)
    }

    // Parse parameter value: quoted-string or token
    let val_str = if buf[pos].to_int() == 34 {
      pos = pos + 1
      let sb = StringBuilder::new()
      let mut closed = false
      while pos < end {
        let c = buf[pos].to_int()
        if c == 34 {
          pos = pos + 1
          closed = true
          break
        } else if c == 92 {
          if pos + 1 >= end {
            return Err(MimeError::InvalidEscape)
          }
          sb.write_byte(buf[pos + 1])
          pos = pos + 2
        } else if c == 13 || c == 10 {
          return Err(MimeError::InvalidParameterValue)
        } else {
          sb.write_byte(buf[pos])
          pos = pos + 1
        }
      }
      if !closed {
        return Err(MimeError::InvalidParameterValue)
      }
      sb.to_string()
    } else {
      let val_start = pos
      while pos < end && tlut[buf[pos].to_int()] == 1 {
        pos = pos + 1
      }
      if pos == val_start {
        return Err(MimeError::InvalidParameterValue)
      }
      bytes_slice_to_string(buf, val_start, pos)
    }

    // After value, only whitespace or ';' or end is allowed
    pos = skip_ws(buf, pos, end)
    if pos < end && buf[pos].to_int() != 59 {
      return Err(MimeError::InvalidParameterValue)
    }

    // Classify raw_key: plain, single extended (`name*`), or continuation (`name*N` / `name*N*`)
    let kb = raw_key.to_bytes()
    let klen = kb.length()
    let mut star_idx = -1
    let mut j = 0
    while j < klen {
      if kb[j].to_int() == 42 {
        star_idx = j
        break
      }
      j = j + 1
    }

    if star_idx < 0 {
      // Plain parameter
      let mut k = 0
      while k < plain_names.length() {
        if plain_names[k] == raw_key {
          return Err(MimeError::DuplicateParameter)
        }
        k = k + 1
      }
      plain_names.push(raw_key)
      plain_vals.push(val_str)
    } else if star_idx == klen - 1 {
      // Single extended parameter `base*`
      if star_idx == 0 {
        return Err(MimeError::InvalidParameterName)
      }
      let base = bytes_slice_to_string(kb, 0, star_idx)
      let mut k = 0
      while k < ext_names.length() {
        if ext_names[k] == base {
          return Err(MimeError::DuplicateParameter)
        }
        k = k + 1
      }
      let (cs, enc_bytes) = match split_ext_value(val_str) {
        Ok(pair) => pair
        Err(e) => return Err(e)
      }
      let decoded_bytes = match percent_decode_strict(enc_bytes) {
        Ok(db) => db
        Err(e) => return Err(e)
      }
      let decoded_str = match decode_charset_bytes(cs, decoded_bytes) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      ext_names.push(base)
      ext_vals.push(decoded_str)
    } else {
      // Continuation: `base*N` or `base*N*`
      if star_idx == 0 {
        return Err(MimeError::InvalidParameterName)
      }
      let base = bytes_slice_to_string(kb, 0, star_idx)
      let trailing_star = kb[klen - 1].to_int() == 42
      let num_end = if trailing_star { klen - 1 } else { klen }
      let sec_idx = parse_section_index(kb, star_idx + 1, num_end)
      if sec_idx < 0 {
        return Err(MimeError::InvalidParameterName)
      }
      // Reject duplicate (base, sec_idx)
      let mut k = 0
      while k < conts.length() {
        if conts[k].base == base && conts[k].index == sec_idx {
          return Err(MimeError::DuplicateParameter)
        }
        k = k + 1
      }
      conts.push(ContSection::{
        base: base,
        index: sec_idx,
        encoded: trailing_star,
        value: val_str,
      })
    }
  }

  // Reassemble RFC 2231 continuations into ext_names/ext_vals
  let cont_bases : Array[String] = []
  let mut ci = 0
  while ci < conts.length() {
    let bname = conts[ci].base
    let mut seen = false
    let mut j = 0
    while j < cont_bases.length() {
      if cont_bases[j] == bname {
        seen = true
        break
      }
      j = j + 1
    }
    if !seen {
      cont_bases.push(bname)
    }
    ci = ci + 1
  }

  let mut bi = 0
  while bi < cont_bases.length() {
    let bname = cont_bases[bi]
    // Collect sections 0, 1, 2, ...
    let mut sec = 0
    let mut charset = "utf-8"
    let mut has_charset = false
    let parts_bytes : Array[Bytes] = []
    let mut total_len = 0
    while true {
      let mut found = -1
      let mut k = 0
      while k < conts.length() {
        if conts[k].base == bname && conts[k].index == sec {
          found = k
          break
        }
        k = k + 1
      }
      if found < 0 {
        break
      }
      let item = conts[found]
      if item.encoded {
        let enc_bytes = if sec == 0 {
          match split_ext_value(item.value) {
            Ok((cs, rest)) => {
              charset = cs
              has_charset = true
              rest
            }
            Err(e) => return Err(e)
          }
        } else {
          item.value.to_bytes()
        }
        let dec = match percent_decode_strict(enc_bytes) {
          Ok(db) => db
          Err(e) => return Err(e)
        }
        parts_bytes.push(dec)
        total_len = total_len + dec.length()
      } else {
        let raw = item.value.to_bytes()
        parts_bytes.push(raw)
        total_len = total_len + raw.length()
      }
      sec = sec + 1
    }
    if sec == 0 {
      return Err(MimeError::InvalidParameterName)
    }
    let mut combined = Bytes::new(total_len)
    let mut offset = 0
    let mut p = 0
    while p < parts_bytes.length() {
      let pb = parts_bytes[p]
      let mut q = 0
      while q < pb.length() {
        combined[offset] = pb[q]
        offset = offset + 1
        q = q + 1
      }
      p = p + 1
    }
    let final_str = if has_charset {
      match decode_charset_bytes(charset, combined) {
        Ok(s) => s
        Err(e) => return Err(e)
      }
    } else {
      combined.to_string()
    }
    // Extended continuation overrides plain param of same base
    let mut dup_ext = false
    let mut ek = 0
    while ek < ext_names.length() {
      if ext_names[ek] == bname {
        dup_ext = true
        break
      }
      ek = ek + 1
    }
    if dup_ext {
      return Err(MimeError::DuplicateParameter)
    }
    ext_names.push(bname)
    ext_vals.push(final_str)
    bi = bi + 1
  }

  // Merge plain params and extended params (extended overrides plain per RFC 6266 §4.3)
  let out : Array[Param] = []
  let mut pi = 0
  while pi < plain_names.length() {
    let pname = plain_names[pi]
    let mut override_idx = -1
    let mut ei = 0
    while ei < ext_names.length() {
      if ext_names[ei] == pname {
        override_idx = ei
        break
      }
      ei = ei + 1
    }
    if override_idx >= 0 {
      out.push(Param::new(pname, ext_vals[override_idx]))
    } else {
      out.push(Param::new(pname, plain_vals[pi]))
    }
    pi = pi + 1
  }
  let mut ei = 0
  while ei < ext_names.length() {
    let ename = ext_names[ei]
    let mut exists = false
    let mut j = 0
    while j < plain_names.length() {
      if plain_names[j] == ename {
        exists = true
        break
      }
      j = j + 1
    }
    if !exists {
      out.push(Param::new(ename, ext_vals[ei]))
    }
    ei = ei + 1
  }
  Ok(out)
}

///| Parse an RFC 2045 / 9110 Media-Type string (`type/subtype; param=val`).
pub fn parse_media_type(input : String) -> Result[MediaType, MimeError] {
  let buf = input.to_bytes()
  let end = buf.length()
  let mut pos = skip_ws(buf, 0, end)
  if pos >= end {
    return Err(MimeError::EmptyInput)
  }
  let tlut = tchar_lut

  // Parse type token
  let type_start = pos
  while pos < end && tlut[buf[pos].to_int()] == 1 {
    pos = pos + 1
  }
  if pos == type_start || pos >= end || buf[pos].to_int() != 47 {
    return Err(MimeError::InvalidMediaType)
  }
  let type_name = bytes_slice_to_lower_string(buf, type_start, pos)
  pos = pos + 1 // skip '/'

  // Parse subtype token
  let sub_start = pos
  while pos < end && tlut[buf[pos].to_int()] == 1 {
    pos = pos + 1
  }
  if pos == sub_start {
    return Err(MimeError::InvalidMediaType)
  }
  let subtype = bytes_slice_to_lower_string(buf, sub_start, pos)

  pos = skip_ws(buf, pos, end)
  if pos < end && buf[pos].to_int() != 59 {
    return Err(MimeError::InvalidMediaType)
  }
  let params = match parse_params_block(buf, pos, end) {
    Ok(ps) => ps
    Err(e) => return Err(e)
  }
  Ok(MediaType::{ type_name: type_name, subtype: subtype, params: params })
}

///| Format a parameter list canonically (sorted by lowercased name, RFC 2231/5987 for non-ASCII).
fn format_params_into(sb : StringBuilder, params : Array[Param]) -> Result[Unit, MimeError] {
  let n = params.length()
  if n == 0 {
    return Ok(())
  }
  // Validate & lowercase names, reject duplicates, insertion sort
  let sorted : Array[Param] = []
  let mut i = 0
  while i < n {
    let raw_name = params[i].name
    let nb = raw_name.to_bytes()
    if !is_valid_token_bytes(nb, 0, nb.length()) {
      return Err(MimeError::InvalidParameterName)
    }
    let lname = bytes_slice_to_lower_string(nb, 0, nb.length())
    let mut j = 0
    while j < sorted.length() {
      if sorted[j].name == lname {
        return Err(MimeError::DuplicateParameter)
      }
      j = j + 1
    }
    sorted.push(Param::new(lname, params[i].value))
    // Insertion sort step
    let mut k = sorted.length() - 1
    while k > 0 && str_lt(sorted[k].name, sorted[k - 1].name) {
      let tmp = sorted[k]
      sorted[k] = sorted[k - 1]
      sorted[k - 1] = tmp
      k = k - 1
    }
    i = i + 1
  }

  let tlut = tchar_lut
  let alut = attr_char_lut
  let hbytes = hex_upper_bytes

  i = 0
  while i < sorted.length() {
    let p = sorted[i]
    let vb = p.value.to_bytes()
    let vlen = vb.length()
    let mut is_token = vlen > 0
    let mut needs_rfc2231 = false
    let mut j = 0
    while j < vlen {
      let c = vb[j].to_int()
      if c < 0x20 || c >= 0x7F {
        needs_rfc2231 = true
        is_token = false
        break
      }
      if tlut[c] == 0 {
        is_token = false
      }
      j = j + 1
    }
    sb.write_string("; ")
    if needs_rfc2231 {
      sb.write_string(p.name)
      sb.write_string("*=utf-8''")
      j = 0
      while j < vlen {
        let c = vb[j].to_int()
        if alut[c] == 1 {
          sb.write_byte(vb[j])
        } else {
          sb.write_byte(b'%')
          sb.write_byte(hbytes[(c >> 4) & 0x0F])
          sb.write_byte(hbytes[c & 0x0F])
        }
        j = j + 1
      }
    } else if is_token {
      sb.write_string(p.name)
      sb.write_byte(b'=')
      sb.write_string(p.value)
    } else {
      sb.write_string(p.name)
      sb.write_string("=\"")
      j = 0
      while j < vlen {
        let c = vb[j].to_int()
        if c == 34 || c == 92 {
          sb.write_byte(b'\\')
        }
        sb.write_byte(vb[j])
        j = j + 1
      }
      sb.write_byte(b'"')
    }
    i = i + 1
  }
  Ok(())
}

///| Format a Media-Type and parameters canonically.
pub fn format_media_type(media_type : String, params : Array[Param]) -> Result[String, MimeError] {
  let mb = media_type.to_bytes()
  let len = mb.length()
  let mut slash = -1
  let mut i = 0
  while i < len {
    if mb[i].to_int() == 47 {
      if slash >= 0 {
        return Err(MimeError::InvalidMediaType)
      }
      slash = i
    }
    i = i + 1
  }
  if slash <= 0 || slash >= len - 1 {
    return Err(MimeError::InvalidMediaType)
  }
  if !is_valid_token_bytes(mb, 0, slash) || !is_valid_token_bytes(mb, slash + 1, len) {
    return Err(MimeError::InvalidMediaType)
  }
  let sb = StringBuilder::new()
  sb.write_string(bytes_slice_to_lower_string(mb, 0, slash))
  sb.write_byte(b'/')
  sb.write_string(bytes_slice_to_lower_string(mb, slash + 1, len))
  match format_params_into(sb, params) {
    Ok(_) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}

///| Parse an RFC 6266 / 5987 Content-Disposition header (`inline`, `attachment`, `form-data`, etc.).
pub fn parse_content_disposition(input : String) -> Result[ContentDisposition, MimeError] {
  let buf = input.to_bytes()
  let end = buf.length()
  let mut pos = skip_ws(buf, 0, end)
  if pos >= end {
    return Err(MimeError::EmptyInput)
  }
  let tlut = tchar_lut
  let disp_start = pos
  while pos < end && tlut[buf[pos].to_int()] == 1 {
    pos = pos + 1
  }
  if pos == disp_start {
    return Err(MimeError::InvalidDisposition)
  }
  let disposition = bytes_slice_to_lower_string(buf, disp_start, pos)
  pos = skip_ws(buf, pos, end)
  if pos < end && buf[pos].to_int() != 59 {
    return Err(MimeError::InvalidDisposition)
  }
  let params = match parse_params_block(buf, pos, end) {
    Ok(ps) => ps
    Err(e) => return Err(e)
  }
  Ok(ContentDisposition::{ disposition: disposition, params: params })
}

///| Format an RFC 6266 / 5987 Content-Disposition header canonically.
pub fn format_content_disposition(
  disposition : String,
  params : Array[Param],
) -> Result[String, MimeError] {
  let db = disposition.to_bytes()
  if !is_valid_token_bytes(db, 0, db.length()) {
    return Err(MimeError::InvalidDisposition)
  }
  let sb = StringBuilder::new()
  sb.write_string(bytes_slice_to_lower_string(db, 0, db.length()))
  match format_params_into(sb, params) {
    Ok(_) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}
