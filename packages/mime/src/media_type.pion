///| RFC 2045 / 9110 / 2231 / 5987 / 6266 Media-Type & Content-Disposition parser and formatter.

///|
fn skip_ws(buf : Bytes, pos0 : Int, end : Int) -> Int {
  let mut pos = pos0
  while pos < end {
    let c = buf[pos].to_int()
    if c == 32 || c == 9 || c == 13 || c == 10 {
      pos = pos + 1
    } else {
      break
    }
  }
  pos
}

///| Percent-decode bytes with strict 2-hex-digit validation.
fn percent_decode_strict(raw : Bytes) -> Result[Bytes, MimeError] {
  let len = raw.length()
  let hlut = hex_dec_lut
  let mut out_len = 0
  let mut i = 0
  while i < len {
    if raw[i].to_int() == 37 {
      if i + 2 >= len {
        return Err(MimeError::InvalidPercentEncoding)
      }
      let hi = hlut[raw[i + 1].to_int()]
      let lo = hlut[raw[i + 2].to_int()]
      if hi < 0 || lo < 0 {
        return Err(MimeError::InvalidPercentEncoding)
      }
      out_len = out_len + 1
      i = i + 3
    } else {
      out_len = out_len + 1
      i = i + 1
    }
  }
  if out_len == len {
    return Ok(raw)
  }
  let mut out = Bytes::new(out_len)
  let mut pos = 0
  i = 0
  while i < len {
    if raw[i].to_int() == 37 {
      let hi = hlut[raw[i + 1].to_int()]
      let lo = hlut[raw[i + 2].to_int()]
      out[pos] = ((hi << 4) | lo).to_byte()
      pos = pos + 1
      i = i + 3
    } else {
      out[pos] = raw[i]
      pos = pos + 1
      i = i + 1
    }
  }
  Ok(out)
}

///| Decode a charset-tagged raw byte payload (RFC 2231 / 5987) into a UTF-8 String.
fn decode_charset_bytes(charset_lower : String, raw : Bytes) -> Result[String, MimeError] {
  if charset_lower == "" || charset_lower == "utf-8" || charset_lower == "utf8" {
    if !is_valid_utf8(raw) {
      return Err(MimeError::InvalidCharset)
    }
    Ok(raw.to_string())
  } else if charset_lower == "us-ascii" || charset_lower == "ascii" {
    let mut i = 0
    while i < raw.length() {
      if raw[i].to_int() >= 0x80 {
        return Err(MimeError::InvalidCharset)
      }
      i = i + 1
    }
    Ok(raw.to_string())
  } else if charset_lower == "iso-8859-1" || charset_lower == "latin1" || charset_lower == "latin-1" {
    Ok(latin1_to_utf8(raw).to_string())
  } else {
    Err(MimeError::InvalidCharset)
  }
}

///| Parse `charset'lang'value` prefix from an RFC 2231/5987 extended parameter value.
///| Returns `(charset_lower, encoded_value_bytes)`. Empty charset (`''value`) is valid per RFC 2231.
fn split_ext_value(raw_val : String) -> Result[(String, Bytes), MimeError] {
  let b = raw_val.to_bytes()
  let len = b.length()
  let mut q1 = -1
  let mut q2 = -1
  let mut i = 0
  while i < len {
    if b[i].to_int() == 39 {
      if q1 < 0 {
        q1 = i
      } else {
        q2 = i
        break
      }
    }
    i = i + 1
  }
  if q1 < 0 || q2 < 0 {
    return Err(MimeError::InvalidParameterValue)
  }
  let charset = bytes_slice_to_lower_string(b, 0, q1)
  let rest = b.slice(q2 + 1, len)
  Ok((charset, rest))
}

///| Parse a non-negative decimal integer from ASCII bytes [start, end). Returns -1 if invalid.
fn parse_section_index(buf : Bytes, start : Int, end : Int) -> Int {
  if start >= end {
    return -1
  }
  // Leading zero forbidden except "0" itself (RFC 2231 §3)
  if end - start > 1 && buf[start].to_int() == 48 {
    return -1
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let d = buf[i].to_int() - 48
    if d < 0 || d > 9 {
      return -1
    }
    acc = acc * 10 + d
    if acc > 10000 {
      return -1
    }
    i = i + 1
  }
  acc
}

///| Internal representation of a continuation section for RFC 2231.
struct ContSection {
  index : Int
  encoded : Bool
  value : String
}

///| Per-base bucket of RFC 2231 continuation sections with O(1) index lookup for large buckets.
struct ContBucket {
  base : String
  sections : Array[ContSection]
  mut idx_map : Option[IntIndexMap]
}

///| Find section index `sec` inside `bucket`, returning its position in `bucket.sections` or -1.
fn ContBucket::find(self : ContBucket, sec : Int) -> Int {
  match self.idx_map {
    Some(m) => m.get(sec)
    None => {
      let mut i = 0
      while i < self.sections.length() {
        if self.sections[i].index == sec {
          return i
        }
        i = i + 1
      }
      -1
    }
  }
}

///| Insert section into `bucket`, upgrading to `IntIndexMap` once `sections.length() >= 8`.
fn ContBucket::add(self : ContBucket, sec : ContSection) -> Unit {
  let pos = self.sections.length()
  self.sections.push(sec)
  match self.idx_map {
    Some(m) => m.put(sec.index, pos)
    None =>
    if self.sections.length() >= 8 {
      let m = IntIndexMap::new(32)
      let mut i = 0
      while i < self.sections.length() {
        m.put(self.sections[i].index, i)
        i = i + 1
      }
      self.idx_map = Some(m)
    }
  }
}

///| Fast-path parameter parser for plain RFC 2045/9110 parameters (no RFC 2231 `*`).
///| Returns `Ok(Some(params))` if no `*` param was encountered, `Ok(None)` to fall back to RFC 2231 path.
///| O(n) amortized via lazy `StrIndexMap` promotion past 8 parameters.
fn parse_params_fast(buf : Bytes, start : Int, end : Int) -> Result[Option[Array[Param]], MimeError] {
  let tlut = tchar_lut
  let llut = lower_lut
  let ts_lut = tspecial_lut
  let out : Array[Param] = []
  let mut idx_map : Option[StrIndexMap] = None
  let mut pos = skip_ws(buf, start, end)

  while pos < end {
    if buf[pos].to_int() != 59 {
      return Err(MimeError::InvalidParameterName)
    }
    pos = skip_ws(buf, pos + 1, end)
    if pos >= end {
      break
    }

    let key_start = pos
    let mut has_star = false
    let mut has_upper = false
    let mut kh = 5381
    while pos < end {
      let c = buf[pos].to_int()
      if tlut[c] == 0 {
        break
      }
      if c == 42 {
        has_star = true
      } else if c >= 65 && c <= 90 {
        has_upper = true
      }
      kh = (((kh & 0x03FFFFFF) * 33) + llut[c]) & 0x7FFFFFFF
      pos = pos + 1
    }
    if pos == key_start {
      return Err(MimeError::InvalidParameterName)
    }
    if has_star {
      return Ok(None)
    }
    kh = (kh ^ (kh >> 15)) & 0x7FFFFFFF
    let key = if !has_upper {
      buf.slice(key_start, pos).to_string()
    } else {
      bytes_slice_to_lower_string(buf, key_start, pos)
    }
    pos = skip_ws(buf, pos, end)
    if pos >= end || buf[pos].to_int() != 61 {
      return Err(MimeError::InvalidParameterName)
    }
    pos = skip_ws(buf, pos + 1, end)
    if pos >= end {
      return Err(MimeError::InvalidParameterValue)
    }

    let val_str = if buf[pos].to_int() == 34 {
      pos = pos + 1
      let qstart = pos
      let mut has_escape = false
      let mut closed = false
      while pos < end {
        let c = buf[pos].to_int()
        if c == 34 {
          closed = true
          break
        } else if c == 92 {
          if pos + 1 >= end {
            return Err(MimeError::InvalidEscape)
          }
          if ts_lut[buf[pos + 1].to_int()] == 1 {
            has_escape = true
            pos = pos + 2
          } else {
            // MSIE intranet path compatibility (Go mime parity): keep '\' before non-tspecial
            pos = pos + 1
          }
        } else if c == 13 || c == 10 {
          return Err(MimeError::InvalidParameterValue)
        } else {
          pos = pos + 1
        }
      }
      if !closed {
        return Err(MimeError::InvalidParameterValue)
      }
      let qend = pos
      pos = pos + 1
      if !has_escape {
        bytes_slice_to_string(buf, qstart, qend)
      } else {
        let sb = StringBuilder::new()
        let mut qi = qstart
        while qi < qend {
          if buf[qi].to_int() == 92 && qi + 1 < qend && ts_lut[buf[qi + 1].to_int()] == 1 {
            sb.write_byte(buf[qi + 1])
            qi = qi + 2
          } else {
            sb.write_byte(buf[qi])
            qi = qi + 1
          }
        }
        sb.to_string()
      }
    } else {
      let val_start = pos
      while pos < end && tlut[buf[pos].to_int()] == 1 {
        pos = pos + 1
      }
      if pos == val_start {
        return Err(MimeError::InvalidParameterValue)
      }
      bytes_slice_to_string(buf, val_start, pos)
    }

    pos = skip_ws(buf, pos, end)
    if pos < end && buf[pos].to_int() != 59 {
      return Err(MimeError::InvalidParameterValue)
    }

    // O(1) duplicate check (linear for <= 8 params, hash map thereafter)
    let existing = match idx_map {
      Some(m) => m.get_h(key, kh)
      None => {
        let mut found = -1
        let mut k = 0
        while k < out.length() {
          if out[k].name == key {
            found = k
            break
          }
          k = k + 1
        }
        found
      }
    }
    if existing >= 0 {
      if out[existing].value != val_str {
        return Err(MimeError::DuplicateParameter)
      }
      // Equal-valued duplicate parameter is benign (Go 1.27 parity)
    } else {
      let new_idx = out.length()
      out.push(Param::new(key, val_str))
      match idx_map {
        Some(m) => m.put_h(key, kh, new_idx)
        None =>
        if out.length() >= 8 {
          let m = StrIndexMap::new(64)
          let mut k = 0
          while k < out.length() {
            m.put(out[k].name, k)
            k = k + 1
          }
          idx_map = Some(m)
        }
      }
    }
  }
  Ok(Some(out))
}

///| Parse RFC 2045/2231/5987 `; key=value` parameter list starting at `start` in O(n) time.
fn parse_params_block(buf : Bytes, start : Int, end : Int) -> Result[Array[Param], MimeError] {
  if start >= end {
    return Ok([])
  }
  match parse_params_fast(buf, start, end) {
    Ok(Some(ps)) => return Ok(ps)
    Ok(None) => ()
    Err(e) => return Err(e)
  }
  let tlut = tchar_lut
  let llut = lower_lut
  let ts_lut = tspecial_lut
  let plain_names : Array[String] = []
  let plain_vals : Array[String] = []
  let plain_map = StrIndexMap::new(16)
  let ext_names : Array[String] = []
  let ext_vals : Array[String] = []
  let ext_map = StrIndexMap::new(16)
  let cont_buckets : Array[ContBucket] = []
  let cont_map = StrIndexMap::new(16)
  let mut pos = skip_ws(buf, start, end)

  while pos < end {
    if buf[pos].to_int() != 59 {
      return Err(MimeError::InvalidParameterName)
    }
    pos = skip_ws(buf, pos + 1, end)
    if pos >= end {
      // Trailing semicolon is permitted
      break
    }

    // Parse parameter name token directly on `buf`, finding first `*` and hashing base in one pass
    let key_start = pos
    let mut star_pos = -1
    let mut base_has_upper = false
    let mut bh = 5381
    while pos < end {
      let c = buf[pos].to_int()
      if tlut[c] == 0 {
        break
      }
      if star_pos < 0 {
        if c == 42 {
          star_pos = pos
        } else {
          if c >= 65 && c <= 90 {
            base_has_upper = true
          }
          bh = (((bh & 0x03FFFFFF) * 33) + llut[c]) & 0x7FFFFFFF
        }
      }
      pos = pos + 1
    }
    let key_end = pos
    if key_end == key_start {
      return Err(MimeError::InvalidParameterName)
    }
    bh = (bh ^ (bh >> 15)) & 0x7FFFFFFF

    pos = skip_ws(buf, pos, end)
    if pos >= end || buf[pos].to_int() != 61 {
      return Err(MimeError::InvalidParameterName)
    }
    pos = skip_ws(buf, pos + 1, end)
    if pos >= end {
      return Err(MimeError::InvalidParameterValue)
    }

    // Parse parameter value: quoted-string or token
    let val_str = if buf[pos].to_int() == 34 {
      pos = pos + 1
      let sb = StringBuilder::new()
      let mut closed = false
      while pos < end {
        let c = buf[pos].to_int()
        if c == 34 {
          pos = pos + 1
          closed = true
          break
        } else if c == 92 {
          if pos + 1 >= end {
            return Err(MimeError::InvalidEscape)
          }
          if ts_lut[buf[pos + 1].to_int()] == 1 {
            sb.write_byte(buf[pos + 1])
            pos = pos + 2
          } else {
            // MSIE intranet path compatibility (Go mime parity)
            sb.write_byte(buf[pos])
            pos = pos + 1
          }
        } else if c == 13 || c == 10 {
          return Err(MimeError::InvalidParameterValue)
        } else {
          sb.write_byte(buf[pos])
          pos = pos + 1
        }
      }
      if !closed {
        return Err(MimeError::InvalidParameterValue)
      }
      sb.to_string()
    } else {
      let val_start = pos
      while pos < end && tlut[buf[pos].to_int()] == 1 {
        pos = pos + 1
      }
      if pos == val_start {
        return Err(MimeError::InvalidParameterValue)
      }
      bytes_slice_to_string(buf, val_start, pos)
    }

    // After value, only whitespace or ';' or end is allowed
    pos = skip_ws(buf, pos, end)
    if pos < end && buf[pos].to_int() != 59 {
      return Err(MimeError::InvalidParameterValue)
    }

    // Classify: plain, single extended (`name*`), or continuation (`name*N` / `name*N*`)
    if star_pos < 0 {
      // Plain parameter
      let raw_key = if !base_has_upper {
        buf.slice(key_start, key_end).to_string()
      } else {
        bytes_slice_to_lower_string(buf, key_start, key_end)
      }
      let existing = plain_map.get_h(raw_key, bh)
      if existing >= 0 {
        if plain_vals[existing] != val_str {
          return Err(MimeError::DuplicateParameter)
        }
      } else {
        let idx = plain_names.length()
        plain_names.push(raw_key)
        plain_vals.push(val_str)
        plain_map.put_h(raw_key, bh, idx)
      }
    } else if star_pos == key_end - 1 {
      // Single extended parameter `base*`
      if star_pos == key_start {
        // Invalid empty base `*`: skip without killing the rest of the header
        continue
      }
      let base = if !base_has_upper {
        buf.slice(key_start, star_pos).to_string()
      } else {
        bytes_slice_to_lower_string(buf, key_start, star_pos)
      }
      let decoded_opt = match split_ext_value(val_str) {
        Ok((cs, enc_bytes)) =>
        match percent_decode_strict(enc_bytes) {
          Ok(db) =>
          match decode_charset_bytes(cs, db) {
            Ok(s) => Some(s)
            Err(_) => None
          }
          Err(_) => None
        }
        Err(_) => None
      }
      // RFC 6266 §4.3: undecodable `filename*` / `base*` is ignored so plain fallback survives
      match decoded_opt {
        None => ()
        Some(decoded_str) => {
          let existing = ext_map.get_h(base, bh)
          if existing >= 0 {
            if ext_vals[existing] != decoded_str {
              return Err(MimeError::DuplicateParameter)
            }
          } else {
            let idx = ext_names.length()
            ext_names.push(base)
            ext_vals.push(decoded_str)
            ext_map.put_h(base, bh, idx)
          }
        }
      }
    } else {
      // Continuation: `base*N` or `base*N*`
      if star_pos == key_start {
        continue
      }
      let trailing_star = buf[key_end - 1].to_int() == 42
      let num_end = if trailing_star { key_end - 1 } else { key_end }
      let sec_idx = parse_section_index(buf, star_pos + 1, num_end)
      if sec_idx < 0 {
        // Invalid section name (`a*01`, `a*b`, `a**`): ignore this section, keep other params
        continue
      }
      let base = if !base_has_upper {
        buf.slice(key_start, star_pos).to_string()
      } else {
        bytes_slice_to_lower_string(buf, key_start, star_pos)
      }
      let b_idx = cont_map.get_h(base, bh)
      let bucket = if b_idx >= 0 {
        cont_buckets[b_idx]
      } else {
        let nb = ContBucket::{ base: base, sections: [], idx_map: None }
        let ni = cont_buckets.length()
        cont_buckets.push(nb)
        cont_map.put_h(base, bh, ni)
        nb
      }
      let prev_pos = bucket.find(sec_idx)
      if prev_pos >= 0 {
        let prev = bucket.sections[prev_pos]
        if prev.encoded != trailing_star || prev.value != val_str {
          return Err(MimeError::DuplicateParameter)
        }
      } else {
        bucket.add(ContSection::{
          index: sec_idx,
          encoded: trailing_star,
          value: val_str,
        })
      }
    }
  }

  // Reassemble RFC 2231 continuations into ext_names/ext_vals in O(total_sections) time
  let mut bi = 0
  while bi < cont_buckets.length() {
    let bucket = cont_buckets[bi]
    let bname = bucket.base
    // P2-5: if `base*` already decoded validly alongside `base*0`, `base*` wins (Go 1.27 parity)
    if ext_map.get(bname) >= 0 {
      bi = bi + 1
      continue
    }
    // Zero-copy fast path for single unencoded section `*0` (common case)
    if bucket.sections.length() == 1 {
      let s0 = bucket.sections[0]
      if s0.index == 0 && !s0.encoded {
        let idx = ext_names.length()
        ext_names.push(bname)
        ext_vals.push(s0.value)
        ext_map.put(bname, idx)
        bi = bi + 1
        continue
      }
    }
    let mut sec = 0
    let mut charset = "utf-8"
    let mut has_charset = false
    let parts_bytes : Array[Bytes] = []
    let mut total_len = 0
    let mut failed = false
    while true {
      let found = bucket.find(sec)
      if found < 0 {
        break
      }
      let item = bucket.sections[found]
      if item.encoded {
        let enc_bytes = if sec == 0 {
          match split_ext_value(item.value) {
            Ok((cs, rest)) => {
              charset = cs
              has_charset = true
              rest
            }
            Err(_) => {
              failed = true
              break
            }
          }
        } else {
          item.value.to_bytes()
        }
        match percent_decode_strict(enc_bytes) {
          Ok(dec) => {
            parts_bytes.push(dec)
            total_len = total_len + dec.length()
          }
          Err(_) => {
            failed = true
            break
          }
        }
      } else {
        let raw = item.value.to_bytes()
        parts_bytes.push(raw)
        total_len = total_len + raw.length()
      }
      sec = sec + 1
    }
    // P2-4 / P1-2: orphan continuation (sec == 0) or decode error is skipped, not fatal
    if failed || sec == 0 {
      bi = bi + 1
      continue
    }
    let mut combined = Bytes::new(total_len)
    let mut offset = 0
    let mut p = 0
    while p < parts_bytes.length() {
      let pb = parts_bytes[p]
      let mut q = 0
      while q < pb.length() {
        combined[offset] = pb[q]
        offset = offset + 1
        q = q + 1
      }
      p = p + 1
    }
    let final_opt = if has_charset {
      match decode_charset_bytes(charset, combined) {
        Ok(s) => Some(s)
        Err(_) => None
      }
    } else {
      Some(combined.to_string())
    }
    match final_opt {
      Some(final_str) => {
        let idx = ext_names.length()
        ext_names.push(bname)
        ext_vals.push(final_str)
        ext_map.put(bname, idx)
      }
      None => ()
    }
    bi = bi + 1
  }

  // Merge plain params and extended params in O(n) (extended overrides plain per RFC 6266 §4.3)
  let out : Array[Param] = []
  let mut pi = 0
  while pi < plain_names.length() {
    let pname = plain_names[pi]
    let override_idx = ext_map.get(pname)
    if override_idx >= 0 {
      out.push(Param::new(pname, ext_vals[override_idx]))
    } else {
      out.push(Param::new(pname, plain_vals[pi]))
    }
    pi = pi + 1
  }
  let mut ei = 0
  while ei < ext_names.length() {
    let ename = ext_names[ei]
    if plain_map.get(ename) < 0 {
      out.push(Param::new(ename, ext_vals[ei]))
    }
    ei = ei + 1
  }
  Ok(out)
}

///| Parse an RFC 2045 / 9110 Media-Type string (`type/subtype; param=val`).
pub fn parse_media_type(input : String) -> Result[MediaType, MimeError] {
  let buf = input.to_bytes()
  let end = buf.length()
  let mut pos = skip_ws(buf, 0, end)
  if pos >= end {
    return Err(MimeError::EmptyInput)
  }
  let tlut = tchar_lut

  // Parse type token
  let type_start = pos
  while pos < end && tlut[buf[pos].to_int()] == 1 {
    pos = pos + 1
  }
  if pos == type_start || pos >= end || buf[pos].to_int() != 47 {
    return Err(MimeError::InvalidMediaType)
  }
  let type_name = bytes_slice_to_lower_string(buf, type_start, pos)
  pos = pos + 1 // skip '/'

  // Parse subtype token
  let sub_start = pos
  while pos < end && tlut[buf[pos].to_int()] == 1 {
    pos = pos + 1
  }
  if pos == sub_start {
    return Err(MimeError::InvalidMediaType)
  }
  let subtype = bytes_slice_to_lower_string(buf, sub_start, pos)

  pos = skip_ws(buf, pos, end)
  if pos < end && buf[pos].to_int() != 59 {
    return Err(MimeError::InvalidMediaType)
  }
  let params = match parse_params_block(buf, pos, end) {
    Ok(ps) => ps
    Err(e) => return Err(e)
  }
  Ok(MediaType::{ type_name: type_name, subtype: subtype, params: params })
}

///| Format a parameter list canonically (sorted by lowercased name, RFC 2231/5987 for non-ASCII).
fn format_params_into(sb : StringBuilder, params : Array[Param]) -> Result[Unit, MimeError] {
  let n = params.length()
  if n == 0 {
    return Ok(())
  }
  // Validate & lowercase names, reject duplicates, insertion sort
  let sorted : Array[Param] = []
  let mut i = 0
  while i < n {
    let raw_name = params[i].name
    let nb = raw_name.to_bytes()
    if !is_valid_token_bytes(nb, 0, nb.length()) {
      return Err(MimeError::InvalidParameterName)
    }
    // Reject '*' in parameter names so formatted output always round-trips through RFC 2231 parser
    let mut si = 0
    while si < nb.length() {
      if nb[si].to_int() == 42 {
        return Err(MimeError::InvalidParameterName)
      }
      si = si + 1
    }
    let lname = bytes_slice_to_lower_string(nb, 0, nb.length())
    let mut j = 0
    while j < sorted.length() {
      if sorted[j].name == lname {
        return Err(MimeError::DuplicateParameter)
      }
      j = j + 1
    }
    sorted.push(Param::new(lname, params[i].value))
    // Insertion sort step
    let mut k = sorted.length() - 1
    while k > 0 && str_lt(sorted[k].name, sorted[k - 1].name) {
      let tmp = sorted[k]
      sorted[k] = sorted[k - 1]
      sorted[k - 1] = tmp
      k = k - 1
    }
    i = i + 1
  }

  let tlut = tchar_lut
  let alut = attr_char_lut
  let hbytes = hex_upper_bytes

  i = 0
  while i < sorted.length() {
    let p = sorted[i]
    let vb = p.value.to_bytes()
    let vlen = vb.length()
    let mut is_token = vlen > 0
    let mut needs_rfc2231 = false
    let mut j = 0
    while j < vlen {
      let c = vb[j].to_int()
      if c < 0x20 || c >= 0x7F {
        needs_rfc2231 = true
        is_token = false
        break
      }
      if tlut[c] == 0 {
        is_token = false
      }
      j = j + 1
    }
    sb.write_string("; ")
    if needs_rfc2231 {
      sb.write_string(p.name)
      sb.write_string("*=utf-8''")
      j = 0
      while j < vlen {
        let c = vb[j].to_int()
        if alut[c] == 1 {
          sb.write_byte(vb[j])
        } else {
          sb.write_byte(b'%')
          sb.write_byte(hbytes[(c >> 4) & 0x0F])
          sb.write_byte(hbytes[c & 0x0F])
        }
        j = j + 1
      }
    } else if is_token {
      sb.write_string(p.name)
      sb.write_byte(b'=')
      sb.write_string(p.value)
    } else {
      sb.write_string(p.name)
      sb.write_string("=\"")
      j = 0
      while j < vlen {
        let c = vb[j].to_int()
        if c == 34 || c == 92 {
          sb.write_byte(b'\\')
        }
        sb.write_byte(vb[j])
        j = j + 1
      }
      sb.write_byte(b'"')
    }
    i = i + 1
  }
  Ok(())
}

///| Format a Media-Type and parameters canonically.
pub fn format_media_type(media_type : String, params : Array[Param]) -> Result[String, MimeError] {
  let mb = media_type.to_bytes()
  let len = mb.length()
  let mut slash = -1
  let mut i = 0
  while i < len {
    if mb[i].to_int() == 47 {
      if slash >= 0 {
        return Err(MimeError::InvalidMediaType)
      }
      slash = i
    }
    i = i + 1
  }
  if slash <= 0 || slash >= len - 1 {
    return Err(MimeError::InvalidMediaType)
  }
  if !is_valid_token_bytes(mb, 0, slash) || !is_valid_token_bytes(mb, slash + 1, len) {
    return Err(MimeError::InvalidMediaType)
  }
  let sb = StringBuilder::new()
  sb.write_string(bytes_slice_to_lower_string(mb, 0, slash))
  sb.write_byte(b'/')
  sb.write_string(bytes_slice_to_lower_string(mb, slash + 1, len))
  match format_params_into(sb, params) {
    Ok(_) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}

///| Parse an RFC 6266 / 5987 Content-Disposition header (`inline`, `attachment`, `form-data`, etc.).
pub fn parse_content_disposition(input : String) -> Result[ContentDisposition, MimeError] {
  let buf = input.to_bytes()
  let end = buf.length()
  let mut pos = skip_ws(buf, 0, end)
  if pos >= end {
    return Err(MimeError::EmptyInput)
  }
  let tlut = tchar_lut
  let disp_start = pos
  while pos < end && tlut[buf[pos].to_int()] == 1 {
    pos = pos + 1
  }
  if pos == disp_start {
    return Err(MimeError::InvalidDisposition)
  }
  let disposition = bytes_slice_to_lower_string(buf, disp_start, pos)
  pos = skip_ws(buf, pos, end)
  if pos < end && buf[pos].to_int() != 59 {
    return Err(MimeError::InvalidDisposition)
  }
  let params = match parse_params_block(buf, pos, end) {
    Ok(ps) => ps
    Err(e) => return Err(e)
  }
  Ok(ContentDisposition::{ disposition: disposition, params: params })
}

///| Format an RFC 6266 / 5987 Content-Disposition header canonically.
pub fn format_content_disposition(
  disposition : String,
  params : Array[Param],
) -> Result[String, MimeError] {
  let db = disposition.to_bytes()
  if !is_valid_token_bytes(db, 0, db.length()) {
    return Err(MimeError::InvalidDisposition)
  }
  let sb = StringBuilder::new()
  sb.write_string(bytes_slice_to_lower_string(db, 0, db.length()))
  match format_params_into(sb, params) {
    Ok(_) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}
