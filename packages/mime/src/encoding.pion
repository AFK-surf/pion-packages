///| RFC 2045 §6.7 Quoted-Printable & RFC 2047 Encoded-Words codec with 256B LUT fast paths.

///| RFC 2045 §6.7 Quoted-Printable byte-level nibble pack/unpack helpers.
#verify
pub fn qp_hi_nibble(c : Int) -> Int {
  (c >> 4) & 0x0F
}

///|
#verify
pub fn qp_lo_nibble(c : Int) -> Int {
  c & 0x0F
}

///|
#verify
pub fn qp_pack_hex_byte(hi : Int, lo : Int) -> Int {
  (hi << 4) | lo
}

///| RFC 2045 §6.7 whether `c` is an allowed literal byte during Quoted-Printable decoding.
#verify
pub fn qp_decode_allowed_literal(c : Int) -> Bool {
  c == 9 || (c >= 32 && c <= 126) || c == 13 || c >= 128
}

///| RFC 2045 §6.7 whether `c` can be emitted literally during Quoted-Printable encoding.
#verify
pub fn qp_encode_is_literal(c : Int, is_last_before_eol : Bool) -> Bool {
  let is_ws = c == 32 || c == 9
  !is_last_before_eol && (is_ws || (c >= 33 && c <= 126 && c != 61))
}

///| RFC 2045 §6.7 76-column soft-wrap guard (`col + width > 75` triggers `=CRLF`).
#verify
pub fn qp_needs_soft_wrap(col : Int, width : Int) -> Bool {
  col + width > 75
}

let qp_dec_lit_lut : FixedArray[Int] = build_qp_dec_lit_lut()

fn build_qp_dec_lit_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(256, 0)
  let mut i = 0
  while i < 256 {
    if qp_decode_allowed_literal(i) {
      lut[i] = 1
    }
    i = i + 1
  }
  lut
}

///| Decode Quoted-Printable bytes (RFC 2045 §6.7 + Go `mime/quotedprintable` parity).
pub fn qp_decode(input : Bytes) -> Result[Bytes, MimeError] {
  let len = input.length()
  if len == 0 {
    return Ok(Bytes::new(0))
  }
  let hlut = hex_dec_lut
  let llut = qp_dec_lit_lut
  // Output is always <= input.length()
  let mut out = Bytes::new(len)
  let mut opos = 0
  let mut pos = 0

  while pos < len {
    // Process one line at a time so we can strip trailing SP/HTAB before hard line breaks
    let line_start = pos
    let mut line_end = len
    let mut eol_kind = 0 // 0=EOF, 1=LF, 2=CRLF
    let mut next_pos = len
    while pos < len {
      let c = input[pos].to_int()
      if c == 10 {
        if pos > line_start && input[pos - 1].to_int() == 13 {
          line_end = pos - 1
          eol_kind = 2
        } else {
          line_end = pos
          eol_kind = 1
        }
        next_pos = pos + 1
        break
      }
      pos = pos + 1
    }

    // Strip trailing SP / HTAB before EOL or EOF (RFC 2045 §6.7 #3)
    let mut trimmed_end = line_end
    while trimmed_end > line_start {
      let tc = input[trimmed_end - 1].to_int()
      if tc == 32 || tc == 9 {
        trimmed_end = trimmed_end - 1
      } else {
        break
      }
    }

    // Check for soft line break: '=' at trimmed_end - 1 followed by EOL or EOF (Go / RFC 2045 §6.7)
    let mut soft_break = false
    let mut body_end = trimmed_end
    if trimmed_end > line_start && input[trimmed_end - 1].to_int() == 61 {
      soft_break = true
      body_end = trimmed_end - 1
    }

    let mut i = line_start
    while i < body_end {
      let c = input[i].to_int()
      if c == 61 {
        if i + 2 < body_end {
          let hi = hlut[input[i + 1].to_int()]
          let lo = hlut[input[i + 2].to_int()]
          if hi >= 0 && lo >= 0 {
            out[opos] = qp_pack_hex_byte(hi, lo).to_byte()
            opos = opos + 1
            i = i + 3
            continue
          }
        }
        // RFC 2045 §6.7 note (2) & Go parity: pass malformed '=' through literally
        out[opos] = input[i]
        opos = opos + 1
        i = i + 1
      } else if llut[c] == 1 {
        out[opos] = input[i]
        opos = opos + 1
        i = i + 1
      } else {
        // Control characters like NUL (0x00) are rejected
        return Err(MimeError::InvalidQuotedPrintable)
      }
    }

    if !soft_break {
      if eol_kind == 2 {
        out[opos] = (13).to_byte()
        out[opos + 1] = (10).to_byte()
        opos = opos + 2
      } else if eol_kind == 1 {
        out[opos] = (10).to_byte()
        opos = opos + 1
      }
    }

    pos = next_pos
  }

  Ok(out.slice(0, opos))
}

///|
pub fn qp_decode_str(input : String) -> Result[Bytes, MimeError] {
  qp_decode(input.to_bytes())
}

///| Internal Quoted-Printable encoder (text mode or binary mode), 76-column soft wrap.
fn qp_encode_impl(input : Bytes, binary : Bool) -> Bytes {
  let len = input.length()
  if len == 0 {
    return Bytes::new(0)
  }
  let hbytes = hex_upper_bytes
  let sb = StringBuilder::new()
  let mut col = 0
  let mut cr_pending = false
  let mut i = 0

  while i < len {
    let b = input[i]
    let c = b.to_int()

    if !binary && (c == 13 || c == 10) {
      if c == 13 {
        sb.write_string("\r\n")
        col = 0
        cr_pending = true
      } else {
        if !cr_pending {
          sb.write_string("\r\n")
          col = 0
        }
        cr_pending = false
      }
      i = i + 1
      continue
    }
    cr_pending = false

    // Determine whether this byte is a trailing whitespace before EOL or EOF
    let is_ws = c == 32 || c == 9
    let is_last_before_eol = if is_ws {
      if i + 1 >= len {
        true
      } else if !binary {
        let nxt = input[i + 1].to_int()
        nxt == 13 || nxt == 10
      } else {
        false
      }
    } else {
      false
    }

    let literal = qp_encode_is_literal(c, is_last_before_eol)
    if literal {
      // Max 75 chars on a line before soft break (leaving room for '=')
      if qp_needs_soft_wrap(col, 1) {
        sb.write_string("=\r\n")
        col = 0
      }
      sb.write_byte(b)
      col = col + 1
    } else {
      // Encoded "=XX" takes 3 columns; must fit within 75 columns
      if qp_needs_soft_wrap(col, 3) {
        sb.write_string("=\r\n")
        col = 0
      }
      sb.write_byte(b'=')
      sb.write_byte(hbytes[qp_hi_nibble(c)])
      sb.write_byte(hbytes[qp_lo_nibble(c)])
      col = col + 3
    }
    i = i + 1
  }
  sb.to_string().to_bytes()
}

///| Encode bytes to Quoted-Printable (text mode, normalizing line endings to CRLF, 76-col wrap).
pub fn qp_encode(input : Bytes) -> Bytes {
  qp_encode_impl(input, false)
}

///| Encode bytes to Quoted-Printable in binary mode (encoding CR as `=0D` and LF as `=0A`).
pub fn qp_encode_binary(input : Bytes) -> Bytes {
  qp_encode_impl(input, true)
}

///|
pub fn qp_encode_to_string(input : Bytes) -> String {
  qp_encode(input).to_string()
}

///| Zero-dependency strict Base64 decoder for RFC 2047 B-encoding.
fn b64_decode_strict(buf : Bytes, start : Int, end : Int) -> Result[Bytes, MimeError] {
  let len = end - start
  if len == 0 {
    return Ok(Bytes::new(0))
  }
  if (len & 3) != 0 {
    return Err(MimeError::InvalidBase64)
  }
  let dlut = b64_dec_lut
  let mut pad = 0
  if buf[end - 1].to_int() == 61 {
    pad = pad + 1
    if buf[end - 2].to_int() == 61 {
      pad = pad + 1
    }
  }
  let out_len = (len / 4) * 3 - pad
  let mut out = Bytes::new(out_len)
  let mut opos = 0
  let mut i = start
  let full_end = if pad > 0 { end - 4 } else { end }

  while i < full_end {
    let v0 = dlut[buf[i].to_int()]
    let v1 = dlut[buf[i + 1].to_int()]
    let v2 = dlut[buf[i + 2].to_int()]
    let v3 = dlut[buf[i + 3].to_int()]
    if (v0 | v1 | v2 | v3) < 0 {
      return Err(MimeError::InvalidBase64)
    }
    let tri = (v0 << 18) | (v1 << 12) | (v2 << 6) | v3
    out[opos] = ((tri >> 16) & 0xFF).to_byte()
    out[opos + 1] = ((tri >> 8) & 0xFF).to_byte()
    out[opos + 2] = (tri & 0xFF).to_byte()
    opos = opos + 3
    i = i + 4
  }

  if pad == 1 {
    let v0 = dlut[buf[i].to_int()]
    let v1 = dlut[buf[i + 1].to_int()]
    let v2 = dlut[buf[i + 2].to_int()]
    if (v0 | v1 | v2) < 0 {
      return Err(MimeError::InvalidBase64)
    }
    let tri = (v0 << 18) | (v1 << 12) | (v2 << 6)
    out[opos] = ((tri >> 16) & 0xFF).to_byte()
    out[opos + 1] = ((tri >> 8) & 0xFF).to_byte()
  } else if pad == 2 {
    let v0 = dlut[buf[i].to_int()]
    let v1 = dlut[buf[i + 1].to_int()]
    if (v0 | v1) < 0 {
      return Err(MimeError::InvalidBase64)
    }
    let tri = (v0 << 18) | (v1 << 12)
    out[opos] = ((tri >> 16) & 0xFF).to_byte()
  }
  Ok(out)
}

///| Zero-dependency Base64 encoder for RFC 2047 B-encoding.
fn b64_encode_slice(buf : Bytes, start : Int, end : Int, sb : StringBuilder) -> Unit {
  let elut = b64_enc_lut
  let mut i = start
  while i + 3 <= end {
    let b0 = buf[i].to_int()
    let b1 = buf[i + 1].to_int()
    let b2 = buf[i + 2].to_int()
    let tri = (b0 << 16) | (b1 << 8) | b2
    sb.write_byte(elut[(tri >> 18) & 63])
    sb.write_byte(elut[(tri >> 12) & 63])
    sb.write_byte(elut[(tri >> 6) & 63])
    sb.write_byte(elut[tri & 63])
    i = i + 3
  }
  let rem = end - i
  if rem == 1 {
    let b0 = buf[i].to_int()
    sb.write_byte(elut[(b0 >> 2) & 63])
    sb.write_byte(elut[(b0 << 4) & 63])
    sb.write_byte(b'=')
    sb.write_byte(b'=')
  } else if rem == 2 {
    let b0 = buf[i].to_int()
    let b1 = buf[i + 1].to_int()
    let v = (b0 << 16) | (b1 << 8)
    sb.write_byte(elut[(v >> 18) & 63])
    sb.write_byte(elut[(v >> 12) & 63])
    sb.write_byte(elut[(v >> 6) & 63])
    sb.write_byte(b'=')
  }
}

///| Decode RFC 2047 Q-encoding payload (`_` -> space, `=XX` -> byte).
fn q_decode_word_payload(buf : Bytes, start : Int, end : Int) -> Result[Bytes, MimeError] {
  let len = end - start
  let hlut = hex_dec_lut
  let mut out = Bytes::new(len)
  let mut opos = 0
  let mut i = start
  while i < end {
    let c = buf[i].to_int()
    if c == 95 {
      // '_' -> SP
      out[opos] = (32).to_byte()
      opos = opos + 1
      i = i + 1
    } else if c == 61 {
      if i + 2 >= end {
        return Err(MimeError::InvalidRfc2047)
      }
      let hi = hlut[buf[i + 1].to_int()]
      let lo = hlut[buf[i + 2].to_int()]
      if hi < 0 || lo < 0 {
        return Err(MimeError::InvalidRfc2047)
      }
      out[opos] = ((hi << 4) | lo).to_byte()
      opos = opos + 1
      i = i + 3
    } else {
      out[opos] = buf[i]
      opos = opos + 1
      i = i + 1
    }
  }
  Ok(out.slice(0, opos))
}

///| Normalize supported RFC 2047 charset names to canonical lowercase identifiers.
fn canonical_rfc2047_charset(cs : String) -> Option[String] {
  if cs == "utf-8" || cs == "utf8" {
    Some("utf-8")
  } else if cs == "us-ascii" || cs == "ascii" {
    Some("us-ascii")
  } else if cs == "iso-8859-1" || cs == "latin1" || cs == "latin-1" {
    Some("iso-8859-1")
  } else {
    None
  }
}

///| Decode a single RFC 2047 encoded-word into `(canonical_charset, raw_bytes)` without charset validation yet.
fn decode_rfc2047_word_raw(buf : Bytes, start : Int, end : Int) -> Result[(String, Bytes), MimeError] {
  if end - start < 8 {
    return Err(MimeError::InvalidRfc2047)
  }
  if buf[start].to_int() != 61 || buf[start + 1].to_int() != 63 {
    return Err(MimeError::InvalidRfc2047)
  }
  if buf[end - 2].to_int() != 63 || buf[end - 1].to_int() != 61 {
    return Err(MimeError::InvalidRfc2047)
  }
  // Find '?' after charset
  let mut q1 = -1
  let mut i = start + 2
  while i < end - 2 {
    if buf[i].to_int() == 63 {
      q1 = i
      break
    }
    i = i + 1
  }
  if q1 <= start + 2 {
    return Err(MimeError::InvalidRfc2047)
  }
  // Encoding must be 1 char followed by '?'
  if q1 + 2 >= end - 1 || buf[q1 + 2].to_int() != 63 {
    return Err(MimeError::InvalidRfc2047)
  }
  let enc_ch = buf[q1 + 1].to_int()
  // Strip optional RFC 2231 language tag (`charset*lang`)
  let mut cs_end = q1
  let mut k = start + 2
  while k < q1 {
    if buf[k].to_int() == 42 {
      cs_end = k
      break
    }
    k = k + 1
  }
  if cs_end <= start + 2 {
    return Err(MimeError::InvalidRfc2047)
  }
  let raw_cs = bytes_slice_to_lower_string(buf, start + 2, cs_end)
  let charset = match canonical_rfc2047_charset(raw_cs) {
    Some(c) => c
    None => return Err(MimeError::InvalidCharset)
  }
  let text_start = q1 + 3
  let text_end = end - 2

  let raw_bytes = if enc_ch == 66 || enc_ch == 98 {
    match b64_decode_strict(buf, text_start, text_end) {
      Ok(b) => b
      Err(_) => return Err(MimeError::InvalidRfc2047)
    }
  } else if enc_ch == 81 || enc_ch == 113 {
    match q_decode_word_payload(buf, text_start, text_end) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
  } else {
    return Err(MimeError::InvalidRfc2047)
  }
  Ok((charset, raw_bytes))
}

///| Decode a single RFC 2047 encoded-word `=?charset?B/Q?text?=`.
fn decode_rfc2047_word_bytes(buf : Bytes, start : Int, end : Int) -> Result[String, MimeError] {
  let (charset, raw_bytes) = match decode_rfc2047_word_raw(buf, start, end) {
    Ok(pair) => pair
    Err(e) => return Err(e)
  }
  decode_charset_bytes(charset, raw_bytes)
}

///| Strictly decode a single RFC 2047 encoded-word (`=?charset?B/Q?text?=`).
pub fn decode_rfc2047_word(word : String) -> Result[String, MimeError] {
  let b = word.to_bytes()
  decode_rfc2047_word_bytes(b, 0, b.length())
}

///| Buffered consecutive same-charset encoded-word item for P2-10 multi-byte UTF-8 joining.
struct PendingEw {
  raw : Bytes
  word_start : Int
  word_end : Int
  pre_ws_start : Int
  pre_ws_end : Int
}

///| Flush a run of consecutive same-charset encoded-words into `sb`.
///| Returns `true` if the last emitted item was a decoded encoded-word.
fn flush_pending_ew(
  buf : Bytes,
  cs : String,
  run : Array[PendingEw],
  sb : StringBuilder,
) -> Bool {
  let n = run.length()
  if n == 0 {
    return false
  }
  if n == 1 {
    match decode_charset_bytes(cs, run[0].raw) {
      Ok(s) => {
        sb.write_string(s)
        return true
      }
      Err(_) => {
        if run[0].pre_ws_start >= 0 {
          sb.write_string(bytes_slice_to_string(buf, run[0].pre_ws_start, run[0].pre_ws_end))
        }
        sb.write_string(bytes_slice_to_string(buf, run[0].word_start, run[0].word_end))
        return false
      }
    }
  }
  // Concatenate raw bytes of all adjacent same-charset words and decode together
  let mut total = 0
  let mut i = 0
  while i < n {
    total = total + run[i].raw.length()
    i = i + 1
  }
  let mut combined = Bytes::new(total)
  let mut off = 0
  i = 0
  while i < n {
    let rb = run[i].raw
    let mut j = 0
    while j < rb.length() {
      combined[off] = rb[j]
      off = off + 1
      j = j + 1
    }
    i = i + 1
  }
  match decode_charset_bytes(cs, combined) {
    Ok(s) => {
      sb.write_string(s)
      true
    }
    Err(_) => {
      // Combined decode failed (e.g. one word contains invalid UTF-8): decode individually
      let mut last_ok = false
      i = 0
      while i < n {
        let item = run[i]
        match decode_charset_bytes(cs, item.raw) {
          Ok(s) => {
            if !last_ok && item.pre_ws_start >= 0 {
              sb.write_string(bytes_slice_to_string(buf, item.pre_ws_start, item.pre_ws_end))
            }
            sb.write_string(s)
            last_ok = true
          }
          Err(_) => {
            if item.pre_ws_start >= 0 {
              sb.write_string(bytes_slice_to_string(buf, item.pre_ws_start, item.pre_ws_end))
            }
            sb.write_string(bytes_slice_to_string(buf, item.word_start, item.word_end))
            last_ok = false
          }
        }
        i = i + 1
      }
      last_ok
    }
  }
}

///| Decode an RFC 2047 header value, folding whitespace between adjacent encoded-words
///| (RFC 2047 §6.2), joining octets of adjacent same-charset words before charset decoding,
///| and leaving undecodable/incomplete words literal (Go `DecodeHeader` parity).
pub fn decode_rfc2047(input : String) -> Result[String, MimeError] {
  let buf = input.to_bytes()
  let len = buf.length()
  // Fast path: if no "=?" appears, return input directly with 0 allocations
  let mut has_ew = false
  let mut i = 0
  while i + 1 < len {
    if buf[i].to_int() == 61 && buf[i + 1].to_int() == 63 {
      has_ew = true
      break
    }
    i = i + 1
  }
  if !has_ew {
    return Ok(input)
  }

  let sb = StringBuilder::new()
  let mut pos = 0
  let mut prev_was_ew = false
  let mut pending_ws_start = -1
  let mut pending_ws_end = -1
  let mut run_cs = ""
  let mut run : Array[PendingEw] = []

  while pos < len {
    // Check if we are at `=?`
    if pos + 1 < len && buf[pos].to_int() == 61 && buf[pos + 1].to_int() == 63 {
      // Find the end of the candidate encoded-word: `=?charset?enc?text?=`
      let mut q_count = 0
      let mut j = pos + 2
      let mut word_end = -1
      while j < len {
        let c = buf[j].to_int()
        if c == 32 || c == 9 || c == 13 || c == 10 {
          break
        }
        if c == 63 {
          q_count = q_count + 1
          if q_count == 3 && j + 1 < len && buf[j + 1].to_int() == 61 {
            word_end = j + 2
            break
          }
        }
        j = j + 1
      }
      if word_end > 0 {
        match decode_rfc2047_word_raw(buf, pos, word_end) {
          Ok((cs, raw_bytes)) => {
            if run.length() > 0 && run_cs == cs {
              run.push(PendingEw::{
                raw: raw_bytes,
                word_start: pos,
                word_end: word_end,
                pre_ws_start: pending_ws_start,
                pre_ws_end: pending_ws_end,
              })
            } else {
              if run.length() > 0 {
                let _ = flush_pending_ew(buf, run_cs, run, sb)
                run = []
              }
              run_cs = cs
              run.push(PendingEw::{
                raw: raw_bytes,
                word_start: pos,
                word_end: word_end,
                pre_ws_start: pending_ws_start,
                pre_ws_end: pending_ws_end,
              })
            }
            pending_ws_start = -1
            pending_ws_end = -1
            prev_was_ew = true
            pos = word_end
            continue
          }
          Err(_) => ()
        }
      }
      // Failed to decode: flush any pending run & whitespace, emit "=?" literally
      if run.length() > 0 {
        let _ = flush_pending_ew(buf, run_cs, run, sb)
        run = []
        run_cs = ""
      }
      if pending_ws_start >= 0 {
        sb.write_string(bytes_slice_to_string(buf, pending_ws_start, pending_ws_end))
        pending_ws_start = -1
        pending_ws_end = -1
      }
      sb.write_string("=?")
      prev_was_ew = false
      pos = pos + 2
      continue
    }

    // Check if we are in whitespace immediately after a decoded encoded-word
    let c = buf[pos].to_int()
    if prev_was_ew && (c == 32 || c == 9 || c == 13 || c == 10) {
      let ws_s = pos
      while pos < len {
        let wc = buf[pos].to_int()
        if wc == 32 || wc == 9 || wc == 13 || wc == 10 {
          pos = pos + 1
        } else {
          break
        }
      }
      pending_ws_start = ws_s
      pending_ws_end = pos
      continue
    }

    // Literal byte: flush any pending run & whitespace first
    if run.length() > 0 {
      let _ = flush_pending_ew(buf, run_cs, run, sb)
      run = []
      run_cs = ""
    }
    if pending_ws_start >= 0 {
      sb.write_string(bytes_slice_to_string(buf, pending_ws_start, pending_ws_end))
      pending_ws_start = -1
      pending_ws_end = -1
    }
    sb.write_byte(buf[pos])
    prev_was_ew = false
    pos = pos + 1
  }

  if run.length() > 0 {
    let _ = flush_pending_ew(buf, run_cs, run, sb)
  }
  if pending_ws_start >= 0 {
    sb.write_string(bytes_slice_to_string(buf, pending_ws_start, pending_ws_end))
  }
  Ok(sb.to_string())
}

///| Check whether a string needs RFC 2047 encoding (matches Go `needsEncoding`).
fn rfc2047_needs_encoding(b : Bytes) -> Bool {
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int()
    if (c < 32 || c > 126) && c != 9 {
      return true
    }
    i = i + 1
  }
  false
}

///| Return UTF-8 byte length of the character starting at `b[i]`.
fn utf8_char_len(b : Bytes, i : Int) -> Int {
  let c = b[i].to_int()
  if c < 0x80 {
    1
  } else if (c & 0xE0) == 0xC0 {
    if i + 2 <= b.length() { 2 } else { b.length() - i }
  } else if (c & 0xF0) == 0xE0 {
    if i + 3 <= b.length() { 3 } else { b.length() - i }
  } else if (c & 0xF8) == 0xF0 {
    if i + 4 <= b.length() { 4 } else { b.length() - i }
  } else {
    1
  }
}

///| Encode a UTF-8 string using RFC 2047 Q-encoding (`=?utf-8?q?...?=`), max 75 chars/word.
pub fn encode_rfc2047_q(input : String) -> String {
  let b = input.to_bytes()
  if !rfc2047_needs_encoding(b) {
    return input
  }
  let hbytes = hex_upper_bytes
  let sb = StringBuilder::new()
  // Prefix "=?utf-8?q?" (10) + suffix "?=" (2) = 12 chars; max payload = 63 chars
  let max_payload = 63
  sb.write_string("=?utf-8?q?")
  let mut cur_len = 0
  let mut i = 0
  let len = b.length()

  while i < len {
    let clen = utf8_char_len(b, i)
    // Compute encoded length of this UTF-8 character
    let enc_len = if clen == 1 {
      let c = b[i].to_int()
      if c == 32 || (c >= 33 && c <= 126 && c != 61 && c != 63 && c != 95) {
        1
      } else {
        3
      }
    } else {
      clen * 3
    }
    if cur_len > 0 && cur_len + enc_len > max_payload {
      sb.write_string("?= =?utf-8?q?")
      cur_len = 0
    }
    if clen == 1 {
      let c = b[i].to_int()
      if c == 32 {
        sb.write_byte(b'_')
      } else if c >= 33 && c <= 126 && c != 61 && c != 63 && c != 95 {
        sb.write_byte(b[i])
      } else {
        sb.write_byte(b'=')
        sb.write_byte(hbytes[(c >> 4) & 0x0F])
        sb.write_byte(hbytes[c & 0x0F])
      }
    } else {
      let mut k = 0
      while k < clen {
        let c = b[i + k].to_int()
        sb.write_byte(b'=')
        sb.write_byte(hbytes[(c >> 4) & 0x0F])
        sb.write_byte(hbytes[c & 0x0F])
        k = k + 1
      }
    }
    cur_len = cur_len + enc_len
    i = i + clen
  }
  sb.write_string("?=")
  sb.to_string()
}

///| Encode a UTF-8 string using RFC 2047 B-encoding (`=?utf-8?b?...?=`), max 75 chars/word.
pub fn encode_rfc2047_b(input : String) -> String {
  let b = input.to_bytes()
  if !rfc2047_needs_encoding(b) {
    return input
  }
  let sb = StringBuilder::new()
  // Prefix "=?utf-8?b?" (10) + suffix "?=" (2) = 12 chars; max base64 = 60 chars => max 45 raw bytes
  let max_raw = 45
  let len = b.length()
  let mut pos = 0
  let mut first = true
  while pos < len {
    let mut end = pos
    while end < len {
      let clen = utf8_char_len(b, end)
      if end > pos && (end + clen - pos) > max_raw {
        break
      }
      end = end + clen
    }
    if !first {
      sb.write_byte(b' ')
    }
    first = false
    sb.write_string("=?utf-8?b?")
    b64_encode_slice(b, pos, end, sb)
    sb.write_string("?=")
    pos = end
  }
  sb.to_string()
}
