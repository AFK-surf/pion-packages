///| RFC 9110 §12.5.1 HTTP Accept content negotiation.

///| Parse RFC 9110 §12.4.2 qvalue (`0`..`1` with at most 3 fractional digits) into 0..=1000.
fn parse_qvalue(s : String) -> Result[Int, MimeError] {
  let b = s.to_bytes()
  let len = b.length()
  if len == 0 || len > 5 {
    return Err(MimeError::InvalidQualityValue)
  }
  let c0 = b[0].to_int()
  if c0 == 49 {
    // "1", "1.", "1.0", "1.00", "1.000"
    if len == 1 {
      return Ok(1000)
    }
    if b[1].to_int() != 46 {
      return Err(MimeError::InvalidQualityValue)
    }
    let mut i = 2
    while i < len {
      if b[i].to_int() != 48 {
        return Err(MimeError::InvalidQualityValue)
      }
      i = i + 1
    }
    return Ok(1000)
  } else if c0 == 48 {
    // "0", "0.", "0.d", "0.dd", "0.ddd"
    if len == 1 {
      return Ok(0)
    }
    if b[1].to_int() != 46 {
      return Err(MimeError::InvalidQualityValue)
    }
    let mut qval = 0
    let mut scale = 100
    let mut i = 2
    while i < len {
      let d = b[i].to_int() - 48
      if d < 0 || d > 9 {
        return Err(MimeError::InvalidQualityValue)
      }
      qval = qval + d * scale
      scale = scale / 10
      i = i + 1
    }
    return Ok(qval)
  }
  Err(MimeError::InvalidQualityValue)
}

///| Split an Accept header on top-level commas (outside quoted strings).
fn split_accept_items(input : String) -> Result[Array[String], MimeError] {
  let b = input.to_bytes()
  let len = b.length()
  let items : Array[String] = []
  let mut start = 0
  let mut in_quote = false
  let mut i = 0
  while i < len {
    let c = b[i].to_int()
    if in_quote {
      if c == 92 {
        i = i + 2
        continue
      } else if c == 34 {
        in_quote = false
      }
    } else if c == 34 {
      in_quote = true
    } else if c == 44 {
      items.push(bytes_slice_to_string(b, start, i))
      start = i + 1
    }
    i = i + 1
  }
  if in_quote {
    return Err(MimeError::InvalidAcceptHeader)
  }
  items.push(bytes_slice_to_string(b, start, len))
  Ok(items)
}

///| Parse a single `Accept` media-range item (`type/subtype *( ; param ) [ ; q=qvalue *( ; accept-ext ) ]`).
fn parse_accept_item(item : String) -> Result[MediaRange, MimeError] {
  let buf = item.to_bytes()
  let end = buf.length()
  let mut pos = skip_ws(buf, 0, end)
  let tlut = tchar_lut

  // Parse type token
  let type_start = pos
  while pos < end && tlut[buf[pos].to_int()] == 1 {
    pos = pos + 1
  }
  if pos == type_start || pos >= end || buf[pos].to_int() != 47 {
    return Err(MimeError::InvalidAcceptHeader)
  }
  let type_name = bytes_slice_to_lower_string(buf, type_start, pos)
  pos = pos + 1

  // Parse subtype token
  let sub_start = pos
  while pos < end && tlut[buf[pos].to_int()] == 1 {
    pos = pos + 1
  }
  if pos == sub_start {
    return Err(MimeError::InvalidAcceptHeader)
  }
  let subtype = bytes_slice_to_lower_string(buf, sub_start, pos)

  // RFC 9110: `*/subtype` (wildcard type with concrete subtype) is invalid
  if type_name == "*" && subtype != "*" {
    return Err(MimeError::InvalidAcceptHeader)
  }

  pos = skip_ws(buf, pos, end)
  if pos < end && buf[pos].to_int() != 59 {
    return Err(MimeError::InvalidAcceptHeader)
  }

  let mut q = 1000
  let mut seen_q = false
  let params : Array[Param] = []

  while pos < end {
    if buf[pos].to_int() != 59 {
      return Err(MimeError::InvalidAcceptHeader)
    }
    pos = skip_ws(buf, pos + 1, end)
    if pos >= end {
      break
    }

    let key_start = pos
    while pos < end && tlut[buf[pos].to_int()] == 1 {
      pos = pos + 1
    }
    if pos == key_start {
      return Err(MimeError::InvalidAcceptHeader)
    }
    let key = bytes_slice_to_lower_string(buf, key_start, pos)
    pos = skip_ws(buf, pos, end)

    // RFC 9110 §12.5.1: accept-ext after `q` may be a bare token without `=value`
    if seen_q && (pos >= end || buf[pos].to_int() == 59) {
      if key == "q" {
        return Err(MimeError::InvalidQualityValue)
      }
      continue
    }

    if pos >= end || buf[pos].to_int() != 61 {
      return Err(MimeError::InvalidAcceptHeader)
    }
    pos = skip_ws(buf, pos + 1, end)
    if pos >= end {
      if key == "q" {
        return Err(MimeError::InvalidQualityValue)
      }
      return Err(MimeError::InvalidAcceptHeader)
    }

    let val_str = if buf[pos].to_int() == 34 {
      pos = pos + 1
      let sb = StringBuilder::new()
      let mut closed = false
      while pos < end {
        let c = buf[pos].to_int()
        if c == 34 {
          pos = pos + 1
          closed = true
          break
        } else if c == 92 {
          if pos + 1 >= end {
            return Err(MimeError::InvalidAcceptHeader)
          }
          sb.write_byte(buf[pos + 1])
          pos = pos + 2
        } else if c == 13 || c == 10 {
          return Err(MimeError::InvalidAcceptHeader)
        } else {
          sb.write_byte(buf[pos])
          pos = pos + 1
        }
      }
      if !closed {
        return Err(MimeError::InvalidAcceptHeader)
      }
      sb.to_string()
    } else {
      let val_start = pos
      while pos < end && tlut[buf[pos].to_int()] == 1 {
        pos = pos + 1
      }
      if pos == val_start {
        if key == "q" {
          return Err(MimeError::InvalidQualityValue)
        }
        return Err(MimeError::InvalidAcceptHeader)
      }
      bytes_slice_to_string(buf, val_start, pos)
    }

    pos = skip_ws(buf, pos, end)
    if pos < end && buf[pos].to_int() != 59 {
      return Err(MimeError::InvalidAcceptHeader)
    }

    if key == "q" {
      if seen_q {
        return Err(MimeError::InvalidQualityValue)
      }
      seen_q = true
      q = match parse_qvalue(val_str) {
        Ok(qv) => qv
        Err(e) => return Err(e)
      }
    } else if !seen_q {
      // Parameters before `q` are media-type parameters; after `q` are accept-ext (ignored)
      let mut dup = false
      let mut k = 0
      while k < params.length() {
        if params[k].name == key {
          if params[k].value != val_str {
            return Err(MimeError::InvalidAcceptHeader)
          }
          dup = true
          break
        }
        k = k + 1
      }
      if !dup {
        params.push(Param::new(key, val_str))
      }
    }
  }

  Ok(MediaRange::{
    type_name: type_name,
    subtype: subtype,
    params: params,
    q: q,
  })
}

///| Parse an HTTP `Accept` header into RFC 9110 `MediaRange` entries.
///| Malformed items are skipped when other valid items exist; if all non-empty items
///| are malformed, the first error is returned.
pub fn parse_accept(accept_header : String) -> Result[Array[MediaRange], MimeError] {
  let items = match split_accept_items(accept_header) {
    Ok(xs) => xs
    Err(e) => return Err(e)
  }
  let ranges : Array[MediaRange] = []
  let mut first_err : Option[MimeError] = None
  let mut i = 0
  while i < items.length() {
    let item = items[i]
    let ib = item.to_bytes()
    let s = skip_ws(ib, 0, ib.length())
    if s >= ib.length() {
      i = i + 1
      continue
    }
    match parse_accept_item(item) {
      Ok(mr) => ranges.push(mr)
      Err(e) =>
      match first_err {
        None => first_err = Some(e)
        Some(_) => ()
      }
    }
    i = i + 1
  }
  if ranges.length() == 0 {
    match first_err {
      Some(e) => return Err(e)
      None => ()
    }
  }
  Ok(ranges)
}

///| Compute specificity score of `range` matching `cand`:
///| -1 if no match, 0 for `*/*`, 1 for `type/*`, 2 + param_matches for `type/subtype`.
fn range_match_specificity(range : MediaRange, cand : MediaType) -> Int {
  if range.type_name == "*" && range.subtype == "*" {
    return 0
  }
  if range.type_name != cand.type_name {
    return -1
  }
  if range.subtype == "*" {
    return 1
  }
  if range.subtype != cand.subtype {
    return -1
  }
  // All range parameters must match candidate parameters
  let mut j = 0
  while j < range.params.length() {
    let rp = range.params[j]
    match cand.param(rp.name) {
      Some(v) =>
      if !ascii_eq_ignore_case(v, rp.value) {
        return -1
      }
      None => return -1
    }
    j = j + 1
  }
  2 + range.params.length()
}

///| Negotiate the best media type from `supported` according to RFC 9110 §12.5.1.
pub fn negotiate_media_type(
  accept_header : String,
  supported : Array[String],
) -> Result[Option[String], MimeError] {
  let ranges = match parse_accept(accept_header) {
    Ok(rs) => rs
    Err(e) => return Err(e)
  }
  if supported.length() == 0 {
    return Ok(None)
  }
  // Empty Accept header means any media type is acceptable (RFC 9110 §12.5.1)
  if ranges.length() == 0 {
    return Ok(Some(supported[0]))
  }
  let mut best_idx = -1
  let mut best_q = 0
  let mut best_spec = -1
  let mut i = 0
  while i < supported.length() {
    let cand = match parse_media_type(supported[i]) {
      Ok(m) => m
      Err(e) => return Err(e)
    }
    // Find the most specific matching range for this candidate
    let mut cand_spec = -1
    let mut cand_q = 0
    let mut r = 0
    while r < ranges.length() {
      let spec = range_match_specificity(ranges[r], cand)
      if spec > cand_spec || (spec == cand_spec && spec >= 0 && ranges[r].q > cand_q) {
        cand_spec = spec
        cand_q = ranges[r].q
      }
      r = r + 1
    }
    if cand_spec >= 0 && cand_q > 0 {
      if cand_q > best_q || (cand_q == best_q && cand_spec > best_spec) {
        best_q = cand_q
        best_spec = cand_spec
        best_idx = i
      }
    }
    i = i + 1
  }
  if best_idx < 0 {
    Ok(None)
  } else {
    Ok(Some(supported[best_idx]))
  }
}
