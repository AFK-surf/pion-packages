///| Extension mapping and WHATWG / magic-byte MIME sniffing test suite.

///|
fn bytes_of(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn opt_str_eq_sn(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///|
test "extension_and_mime_roundtrip_mappings" {
  debug_assert(opt_str_eq_sn(mime_from_extension(".png"), Some("image/png")), ".png")
  debug_assert(opt_str_eq_sn(mime_from_extension("PNG"), Some("image/png")), "PNG")
  debug_assert(opt_str_eq_sn(mime_from_extension(".jpg"), Some("image/jpeg")), ".jpg")
  debug_assert(opt_str_eq_sn(mime_from_extension(".jpeg"), Some("image/jpeg")), ".jpeg")
  debug_assert(opt_str_eq_sn(mime_from_extension(".gif"), Some("image/gif")), ".gif")
  debug_assert(opt_str_eq_sn(mime_from_extension(".webp"), Some("image/webp")), ".webp")
  debug_assert(opt_str_eq_sn(mime_from_extension(".avif"), Some("image/avif")), ".avif")
  debug_assert(opt_str_eq_sn(mime_from_extension(".svg"), Some("image/svg+xml")), ".svg")
  debug_assert(opt_str_eq_sn(mime_from_extension(".pdf"), Some("application/pdf")), ".pdf")
  debug_assert(opt_str_eq_sn(mime_from_extension(".wasm"), Some("application/wasm")), ".wasm")
  debug_assert(opt_str_eq_sn(mime_from_extension(".zst"), Some("application/zstd")), ".zst")
  debug_assert(opt_str_eq_sn(mime_from_extension(".br"), Some("application/x-brotli")), ".br")
  debug_assert(opt_str_eq_sn(mime_from_extension(".woff2"), Some("font/woff2")), ".woff2")
  debug_assert(opt_str_eq_sn(mime_from_extension(".json"), Some("application/json")), ".json")
  debug_assert(opt_str_eq_sn(mime_from_extension(".unknown_ext_xyz"), None), "unknown ext")

  debug_assert(opt_str_eq_sn(extension_from_mime("image/png"), Some(".png")), "image/png")
  debug_assert(opt_str_eq_sn(extension_from_mime("TEXT/HTML; charset=utf-8"), Some(".html")), "text/html with params")
  debug_assert(opt_str_eq_sn(extension_from_mime("application/wasm"), Some(".wasm")), "wasm ext")
  debug_assert(opt_str_eq_sn(extension_from_mime("application/pdf"), Some(".pdf")), "pdf ext")
  debug_assert(opt_str_eq_sn(extension_from_mime("application/x-nonexistent-type"), None), "unknown mime")
}

///|
test "sniff_mime_images_documents_archives_binaries" {
  // PNG
  debug_assert(sniff_mime(bytes_of([0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00])) == "image/png", "PNG")
  // JPEG
  debug_assert(sniff_mime(bytes_of([0xFF, 0xD8, 0xFF, 0xE0, 0x00, 0x10])) == "image/jpeg", "JPEG")
  // GIF87a & GIF89a
  debug_assert(sniff_mime("GIF87a\x01\x00".to_bytes()) == "image/gif", "GIF87a")
  debug_assert(sniff_mime("GIF89a\x01\x00".to_bytes()) == "image/gif", "GIF89a")
  // WebP
  debug_assert(sniff_mime("RIFF\x24\x00\x00\x00WEBPVP8 ".to_bytes()) == "image/webp", "WebP")
  // BMP
  debug_assert(sniff_mime(bytes_of([0x42, 0x4D, 0x36, 0x00, 0x00, 0x00])) == "image/bmp", "BMP")
  // ICO
  debug_assert(sniff_mime(bytes_of([0x00, 0x00, 0x01, 0x00, 0x01, 0x00])) == "image/x-icon", "ICO")
  // AVIF
  debug_assert(sniff_mime(bytes_of([0x00, 0x00, 0x00, 0x1C, 0x66, 0x74, 0x79, 0x70, 0x61, 0x76, 0x69, 0x66])) == "image/avif", "AVIF")
  // SVG must NOT be sniffed as executable image/svg+xml (WHATWG MIME Sniffing XSS defense)
  debug_assert(sniff_mime("  <svg xmlns=\"http://www.w3.org/2000/svg\"></svg>".to_bytes()) == "text/plain; charset=utf-8", "bare SVG -> text/plain")
  debug_assert(sniff_mime("<?xml version=\"1.0\"?><svg viewBox=\"0 0 10 10\"/>".to_bytes()) == "text/xml; charset=utf-8", "XML+SVG -> text/xml")
  // PDF
  debug_assert(sniff_mime("%PDF-1.7\n%".to_bytes()) == "application/pdf", "PDF")
  // ZIP
  debug_assert(sniff_mime(bytes_of([0x50, 0x4B, 0x03, 0x04, 0x14, 0x00])) == "application/zip", "ZIP")
  // GZIP
  debug_assert(sniff_mime(bytes_of([0x1F, 0x8B, 0x08, 0x00])) == "application/gzip", "GZIP")
  // ZSTD
  debug_assert(sniff_mime(bytes_of([0x28, 0xB5, 0x2F, 0xFD, 0x00])) == "application/zstd", "ZSTD")
  // TAR (ustar at offset 257)
  let mut tar = Bytes::new(265)
  tar[257] = b'u'
  tar[258] = b's'
  tar[259] = b't'
  tar[260] = b'a'
  tar[261] = b'r'
  debug_assert(sniff_mime(tar) == "application/x-tar", "TAR")
  // WASM
  debug_assert(sniff_mime(bytes_of([0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00])) == "application/wasm", "WASM")
  // ELF
  debug_assert(sniff_mime(bytes_of([0x7F, 0x45, 0x4C, 0x46, 0x02, 0x01])) == "application/x-elf", "ELF")
  // Mach-O (64-bit little-endian & fat)
  debug_assert(sniff_mime(bytes_of([0xCF, 0xFA, 0xED, 0xFE, 0x0C, 0x00])) == "application/x-mach-binary", "Mach-O 64 LE")
  debug_assert(sniff_mime(bytes_of([0xCA, 0xFE, 0xBA, 0xBE, 0x00, 0x00])) == "application/x-mach-binary", "Mach-O Fat")
}

///|
test "sniff_mime_audio_video_fonts_db_text" {
  // MP4
  debug_assert(sniff_mime(bytes_of([0x00, 0x00, 0x00, 0x18, 0x66, 0x74, 0x79, 0x70, 0x69, 0x73, 0x6F, 0x6D])) == "video/mp4", "MP4")
  // WebM
  debug_assert(sniff_mime(bytes_of([0x1A, 0x45, 0xDF, 0xA3, 0x9F, 0x42, 0x82, 0x84, 0x77, 0x65, 0x62, 0x6D])) == "video/webm", "WebM")
  // MP3 (ID3 and frame sync)
  debug_assert(sniff_mime("ID3\x03\x00\x00".to_bytes()) == "audio/mpeg", "MP3 ID3")
  debug_assert(sniff_mime(bytes_of([0xFF, 0xFB, 0x90, 0x00])) == "audio/mpeg", "MP3 sync")
  // OGG
  debug_assert(sniff_mime("OggS\x00\x02".to_bytes()) == "application/ogg", "OGG")
  // FLAC
  debug_assert(sniff_mime("fLaC\x00\x00\x00\x22".to_bytes()) == "audio/flac", "FLAC")
  // WAV
  debug_assert(sniff_mime("RIFF\x24\x00\x00\x00WAVEfmt ".to_bytes()) == "audio/wav", "WAV")
  // Fonts: WOFF, WOFF2, TTF, OTF
  debug_assert(sniff_mime("wOFF\x00\x01\x00\x00".to_bytes()) == "font/woff", "WOFF")
  debug_assert(sniff_mime("wOF2\x00\x01\x00\x00".to_bytes()) == "font/woff2", "WOFF2")
  debug_assert(sniff_mime(bytes_of([0x00, 0x01, 0x00, 0x00, 0x00, 0x0F])) == "font/ttf", "TTF")
  debug_assert(sniff_mime("OTTO\x00\x0C\x00\x80".to_bytes()) == "font/otf", "OTF")
  // SQLite
  debug_assert(sniff_mime("SQLite format 3\x00\x10\x00".to_bytes()) == "application/vnd.sqlite3", "SQLite")
  // HTML, XML, JSON, UTF-8 text vs binary
  debug_assert(sniff_mime("  \n<!DOCTYPE html><html><body>hi</body></html>".to_bytes()) == "text/html; charset=utf-8", "HTML")
  debug_assert(sniff_mime("<?xml version=\"1.0\" encoding=\"UTF-8\"?><root/>".to_bytes()) == "text/xml; charset=utf-8", "XML")
  debug_assert(sniff_mime("  {\"hello\": \"world\", \"n\": 42}  ".to_bytes()) == "application/json", "JSON object")
  debug_assert(sniff_mime("[1, 2, 3]".to_bytes()) == "application/json", "JSON array")
  debug_assert(sniff_mime("Hello, 世界!\nPlain UTF-8 text.".to_bytes()) == "text/plain; charset=utf-8", "UTF-8 text")
  // Invalid UTF-8 / binary control bytes -> application/octet-stream
  debug_assert(sniff_mime(bytes_of([0x01, 0x02, 0x03, 0x04, 0xFE, 0xFF])) == "application/octet-stream", "binary fallback")
}
