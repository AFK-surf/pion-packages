///| Pion Native head-to-head benchmark for packages/mime.
///| Modes: "multipart" | "headers_full" | "headers_mt" | "qp" | "sniff"

import "mime"

///|
fn mix(h : Int64, v : Int64) -> Int64 {
  ((h * 131L) + v) % 1000000007L
}

///|
fn hash_str(h0 : Int64, s : String) -> Int64 {
  let b = s.to_bytes()
  let mut h = mix(h0, b.length().to_int64())
  let mut i = 0
  while i < b.length() {
    h = mix(h, b[i].to_int().to_int64())
    i = i + 1
  }
  h
}

///|
fn hash_bytes_sampled(h0 : Int64, b : Bytes) -> Int64 {
  let len = b.length()
  let mut h = mix(h0, len.to_int64())
  if len == 0 {
    return h
  }
  let mut i = 0
  while i < len {
    h = mix(h, b[i].to_int().to_int64())
    i = i + 64
  }
  h = mix(h, b[len - 1].to_int().to_int64())
  h
}

///|
fn split_lines(data : Bytes) -> Array[String] {
  let out : Array[String] = []
  let len = data.length()
  let mut start = 0
  let mut i = 0
  while i < len {
    if data[i].to_int() == 10 {
      let mut end = i
      if end > start && data[end - 1].to_int() == 13 {
        end = end - 1
      }
      if end > start {
        out.push(data.slice(start, end).to_string())
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < len {
    out.push(data.slice(start, len).to_string())
  }
  out
}

///|
fn bench_multipart(world : World, data : Bytes) -> Int {
  let r = match mime::MultipartReader::new(data, "pion-bench-boundary-2026") {
    Ok(rd) => rd
    Err(_) => return 1
  }
  let mut parts = 0L
  let mut body_bytes = 0L
  let mut checksum = 0L
  while true {
    match r.next_part() {
      Ok(Some(p)) => {
        parts = parts + 1L
        body_bytes = body_bytes + p.body.length().to_int64()
        checksum = hash_bytes_sampled(checksum, p.body)
        match p.form_name() {
          Some(n) => checksum = hash_str(checksum, n)
          None => ()
        }
      }
      Ok(None) => break
      Err(_) => return 2
    }
  }
  io_println(world, "mode=multipart")
  io_println(world, "parts=" + parts.to_string())
  io_println(world, "body_bytes=" + body_bytes.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
fn bench_headers_full(world : World, data : Bytes) -> Int {
  let lines = split_lines(data)
  let kinds : Array[Int] = []
  let payloads : Array[String] = []
  let mut i = 0
  while i < lines.length() {
    let lb = lines[i].to_bytes()
    if lb.length() >= 2 {
      kinds.push(lb[0].to_int())
      payloads.push(lb.slice(2, lb.length()).to_string())
    }
    i = i + 1
  }
  let n = payloads.length()
  let mut ops = 0L
  let mut checksum = 0L
  let mut round = 0
  while round < 200 {
    let mut j = 0
    while j < n {
      let k = kinds[j]
      let p = payloads[j]
      if k == 77 {
        match mime::parse_media_type(p) {
          Ok(mt) => {
            checksum = hash_str(checksum, mt.essence())
            checksum = mix(checksum, mt.params.length().to_int64())
          }
          Err(_) => return 1
        }
      } else if k == 68 {
        match mime::parse_content_disposition(p) {
          Ok(cd) => {
            checksum = hash_str(checksum, cd.disposition)
            match cd.filename() {
              Some(f) => checksum = hash_str(checksum, f)
              None => ()
            }
          }
          Err(_) => return 2
        }
      } else {
        match mime::decode_rfc2047(p) {
          Ok(dec) => checksum = hash_str(checksum, dec)
          Err(_) => return 3
        }
      }
      ops = ops + 1L
      j = j + 1
    }
    round = round + 1
  }
  io_println(world, "mode=headers_full")
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
fn bench_headers_mt(world : World, data : Bytes) -> Int {
  let lines = split_lines(data)
  let n = lines.length()
  let mut ops = 0L
  let mut checksum = 0L
  let mut round = 0
  while round < 200 {
    let mut j = 0
    while j < n {
      match mime::parse_media_type(lines[j]) {
        Ok(mt) => {
          checksum = hash_str(checksum, mt.essence())
          match mt.param("charset") {
            Some(c) => checksum = hash_str(checksum, c)
            None => ()
          }
        }
        Err(_) => return 1
      }
      ops = ops + 1L
      j = j + 1
    }
    round = round + 1
  }
  io_println(world, "mode=headers_mt")
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
fn bench_qp(world : World, data : Bytes) -> Int {
  let dec = match mime::qp_decode(data) {
    Ok(b) => b
    Err(_) => return 1
  }
  let checksum = hash_bytes_sampled(0L, dec)
  io_println(world, "mode=qp")
  io_println(world, "decoded_bytes=" + dec.length().to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
fn bench_sniff(world : World, data : Bytes) -> Int {
  let samples : Array[Bytes] = []
  let len = data.length()
  let mut pos = 0
  while pos + 4 <= len {
    let slen = data[pos].to_int() |
    (data[pos + 1].to_int() << 8) |
    (data[pos + 2].to_int() << 16) |
    (data[pos + 3].to_int() << 24)
    pos = pos + 4
    if pos + slen > len {
      return 1
    }
    samples.push(data.slice(pos, pos + slen))
    pos = pos + slen
  }
  let n = samples.length()
  let mut ops = 0L
  let mut checksum = 0L
  let mut round = 0
  while round < 1000 {
    let mut j = 0
    while j < n {
      let m = mime::sniff_mime(samples[j])
      checksum = hash_str(checksum, m)
      ops = ops + 1L
      j = j + 1
    }
    round = round + 1
  }
  io_println(world, "mode=sniff")
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_mime_bench <mode> <corpus_path>")
    return 1
  }
  let mode = args[1]
  let data = match fs_read_bytes(world, args[2]) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read corpus")
      return 1
    }
  }
  if mode == "multipart" {
    bench_multipart(world, data)
  } else if mode == "headers_full" {
    bench_headers_full(world, data)
  } else if mode == "headers_mt" {
    bench_headers_mt(world, data)
  } else if mode == "qp" {
    bench_qp(world, data)
  } else if mode == "sniff" {
    bench_sniff(world, data)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
