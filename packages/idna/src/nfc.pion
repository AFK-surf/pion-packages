///| Unicode 16.0.0 NFD and NFC normalization (canonical decomposition, CCC ordering, composition).

let hangul_sbase : Int = 0xAC00

let hangul_lbase : Int = 0x1100

let hangul_vbase : Int = 0x1161

let hangul_tbase : Int = 0x11A7

let hangul_lcount : Int = 19

let hangul_vcount : Int = 21

let hangul_tcount : Int = 28

let hangul_ncount : Int = 588

let hangul_scount : Int = 11172

///| Fast check: could `cp` ever trigger an NFC change in a UTS #46 mapped stream?
fn cp_may_need_nfc(cp : Int) -> Bool {
  if cp < 0x0300 {
    return false
  }
  if cp >= 0x4E00 && cp <= 0x9FFF {
    return false
  }
  if cp >= 0xAC00 && cp <= 0xD7A3 {
    return false
  }
  if cp >= 0x1161 && cp <= 0x11C2 {
    return true
  }
  if (cp >= 0x09BE && cp <= 0x1B35) || (cp >= 0x11127 && cp <= 0x113FF) {
    return true
  }
  unicode_ccc(cp) != 0
}

///| Apply Unicode NFD normalization (canonical decomposition + canonical ordering) to `cps`.
fn nfd_normalize(cps : Array[Int]) -> Array[Int] {
  let n = cps.length()
  if n == 0 {
    return cps
  }
  let dec : Array[Int] = []
  let mut i = 0
  let mut has_combining = false
  while i < n {
    let cp = cps[i]
    if cp >= hangul_sbase && cp < hangul_sbase + hangul_scount {
      let s_idx = cp - hangul_sbase
      let l = hangul_lbase + s_idx / hangul_ncount
      let v = hangul_vbase + (s_idx % hangul_ncount) / hangul_tcount
      let t = hangul_tbase + s_idx % hangul_tcount
      dec.push(l)
      dec.push(v)
      if t != hangul_tbase {
        dec.push(t)
      }
    } else if cp < 0x00C0 {
      dec.push(cp)
    } else {
      let info = unicode_decomp_info(cp)
      if info >= 0 {
        let off = info & 0xFFFF
        let dlen = info >> 16
        let mut k = 0
        while k < dlen {
          let d = decomp_pool[off + k]
          if !has_combining && unicode_ccc(d) != 0 {
            has_combining = true
          }
          dec.push(d)
          k = k + 1
        }
      } else {
        if !has_combining && unicode_ccc(cp) != 0 {
          has_combining = true
        }
        dec.push(cp)
      }
    }
    i = i + 1
  }
  if !has_combining {
    return dec
  }
  let dn = dec.length()
  i = 0
  while i < dn {
    if unicode_ccc(dec[i]) == 0 {
      i = i + 1
      continue
    }
    let mut j = i + 1
    while j < dn && unicode_ccc(dec[j]) != 0 {
      j = j + 1
    }
    let mut a = i + 1
    while a < j {
      let cur = dec[a]
      let cur_c = unicode_ccc(cur)
      let mut b = a - 1
      while b >= i && unicode_ccc(dec[b]) > cur_c {
        dec[b + 1] = dec[b]
        b = b - 1
      }
      dec[b + 1] = cur
      a = a + 1
    }
    i = j
  }
  dec
}

///| Apply Unicode NFC normalization to `cps`.
fn nfc_normalize(cps : Array[Int]) -> Array[Int] {
  let n = cps.length()
  if n == 0 {
    return cps
  }
  let dec = nfd_normalize(cps)
  let dn = dec.length()
  let out : Array[Int] = []
  let mut starter_idx = -1
  let mut last_ccc = -1
  let mut i = 0
  while i < dn {
    let cp = dec[i]
    let c = unicode_ccc(cp)
    if starter_idx >= 0 && (last_ccc < c || last_ccc == 0) {
      let st = out[starter_idx]
      let composed = if st >= hangul_lbase &&
      st < hangul_lbase + hangul_lcount &&
      cp >= hangul_vbase &&
      cp < hangul_vbase + hangul_vcount {
        hangul_sbase + ((st - hangul_lbase) * hangul_vcount + (cp - hangul_vbase)) * hangul_tcount
      } else if st >= hangul_sbase &&
      st < hangul_sbase + hangul_scount &&
      (st - hangul_sbase) % hangul_tcount == 0 &&
      cp > hangul_tbase &&
      cp < hangul_tbase + hangul_tcount {
        st + (cp - hangul_tbase)
      } else {
        unicode_compose_pair(st, cp)
      }
      if composed >= 0 {
        out[starter_idx] = composed
        i = i + 1
        continue
      }
    }
    if c == 0 {
      starter_idx = out.length()
      last_ccc = 0
    } else {
      last_ccc = c
    }
    out.push(cp)
    i = i + 1
  }
  out
}

fn cps_equal(a : Array[Int], b : Array[Int]) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}
