///| Unicode 16.0.0 NFD and NFC normalization (canonical decomposition, CCC ordering, composition).

let hangul_sbase : Int = 0xAC00

let hangul_lbase : Int = 0x1100

let hangul_vbase : Int = 0x1161

let hangul_tbase : Int = 0x11A7

let hangul_lcount : Int = 19

let hangul_vcount : Int = 21

let hangul_tcount : Int = 28

let hangul_ncount : Int = 588

let hangul_scount : Int = 11172

///| Fast check: could `cp` ever trigger an NFC change in a UTS #46 mapped stream?
fn cp_may_need_nfc(cp : Int) -> Bool {
  if cp < 0x0300 {
    return false
  }
  if cp < 4096 {
    return (low_props_lut[cp] & 1) != 0
  }
  if (cp >= 0x4E00 && cp <= 0x9FFF) ||
  (cp >= 0xAC00 && cp <= 0xD7A3) ||
  (cp >= 0x3041 && cp <= 0x3096) ||
  (cp >= 0x30A1 && cp <= 0x30FA) {
    return false
  }
  unicode_ccc(cp) != 0 || unicode_nfc_qc_not_yes(cp)
}

///| Apply Unicode NFD normalization (canonical decomposition + canonical ordering) to `cps`.
fn nfd_normalize(cps : Array[Int]) -> Array[Int] {
  let n = cps.length()
  if n == 0 {
    return cps
  }
  let dec : Array[Int] = Array::with_capacity(n + 4)
  let dpool = decomp_pool
  let props = low_props_lut
  let mut i = 0
  let mut has_combining = false
  while i < n {
    let cp = cps[i]
    if cp < 0x00C0 {
      dec.push(cp)
    } else if cp < 4096 {
      let p = props[cp]
      if (p & 262144) == 0 {
        if !has_combining && ((p >> 9) & 255) != 0 {
          has_combining = true
        }
        dec.push(cp)
      } else {
        let info = unicode_decomp_info(cp)
        let off = info & 0xFFFF
        let dlen = info >> 16
        let mut k = 0
        while k < dlen {
          let d = dpool[off + k]
          if !has_combining && unicode_ccc(d) != 0 {
            has_combining = true
          }
          dec.push(d)
          k = k + 1
        }
      }
    } else if cp >= 0xAC00 && cp < 0xD7A4 {
      let s_idx = cp - 0xAC00
      let l = 0x1100 + s_idx / 588
      let v = 0x1161 + (s_idx % 588) / 28
      let t = 0x11A7 + s_idx % 28
      dec.push(l)
      dec.push(v)
      if t != 0x11A7 {
        dec.push(t)
      }
    } else {
      let info = unicode_decomp_info(cp)
      if info >= 0 {
        let off = info & 0xFFFF
        let dlen = info >> 16
        let mut k = 0
        while k < dlen {
          let d = dpool[off + k]
          if !has_combining && unicode_ccc(d) != 0 {
            has_combining = true
          }
          dec.push(d)
          k = k + 1
        }
      } else {
        if !has_combining && unicode_ccc(cp) != 0 {
          has_combining = true
        }
        dec.push(cp)
      }
    }
    i = i + 1
  }
  if !has_combining {
    return dec
  }
  let dn = dec.length()
  i = 0
  while i < dn {
    if unicode_ccc(dec[i]) == 0 {
      i = i + 1
      continue
    }
    let mut j = i + 1
    while j < dn && unicode_ccc(dec[j]) != 0 {
      j = j + 1
    }
    let run_len = j - i
    if run_len <= 16 {
      let mut a = i + 1
      while a < j {
        let cur = dec[a]
        let cur_c = unicode_ccc(cur)
        let mut b = a - 1
        while b >= i && unicode_ccc(dec[b]) > cur_c {
          dec[b + 1] = dec[b]
          b = b - 1
        }
        dec[b + 1] = cur
        a = a + 1
      }
    } else {
      // Stable O(n) counting sort by CCC (1..=254) to prevent O(n^2) DoS on long combining runs.
      let counts : FixedArray[Int] = FixedArray::make(256, 0)
      let cccs : FixedArray[Int] = FixedArray::make(run_len, 0)
      let tmp : FixedArray[Int] = FixedArray::make(run_len, 0)
      let mut k = 0
      while k < run_len {
        let c = unicode_ccc(dec[i + k]) & 255
        cccs[k] = c
        counts[c] = counts[c] + 1
        k = k + 1
      }
      let mut total = 0
      let mut bucket = 0
      while bucket < 256 {
        let cnt = counts[bucket]
        counts[bucket] = total
        total = total + cnt
        bucket = bucket + 1
      }
      k = 0
      while k < run_len {
        let c = cccs[k]
        let dst = counts[c]
        tmp[dst] = dec[i + k]
        counts[c] = dst + 1
        k = k + 1
      }
      k = 0
      while k < run_len {
        dec[i + k] = tmp[k]
        k = k + 1
      }
    }
    i = j
  }
  dec
}

///| In-place NFC on `buf[0..len]` when all code points are `< 4096` and have no canonical decomposition.
///| Returns the new length `>= 0` on success, or `-1` if full NFD/NFC fallback is needed.
fn nfc_normalize_in_place_fixed(buf : FixedArray[Int], len : Int) -> Int {
  let props = low_props_lut
  let mut i = 0
  let mut last_ccc = 0
  let mut needs_reorder = false
  while i < len {
    let cp = buf[i]
    if cp < 0x00C0 {
      last_ccc = 0
    } else if cp < 4096 {
      let p = props[cp]
      if (p & 262144) != 0 {
        return -1
      }
      let c = (p >> 9) & 255
      if c != 0 && last_ccc > c {
        needs_reorder = true
      }
      last_ccc = c
    } else {
      return -1
    }
    i = i + 1
  }
  if needs_reorder {
    i = 0
    while i < len {
      let c0 = (props[buf[i]] >> 9) & 255
      if c0 == 0 {
        i = i + 1
        continue
      }
      let mut j = i + 1
      while j < len && ((props[buf[j]] >> 9) & 255) != 0 {
        j = j + 1
      }
      if j - i > 16 {
        return -1
      }
      let mut a = i + 1
      while a < j {
        let cur = buf[a]
        let cur_c = (props[cur] >> 9) & 255
        let mut b = a - 1
        while b >= i && ((props[buf[b]] >> 9) & 255) > cur_c {
          buf[b + 1] = buf[b]
          b = b - 1
        }
        buf[b + 1] = cur
        a = a + 1
      }
      i = j
    }
  }
  let mut starter_idx = -1
  let mut comp_last_ccc = -1
  let mut w = 0
  i = 0
  while i < len {
    let cp = buf[i]
    if cp < 0x0300 {
      starter_idx = w
      comp_last_ccc = 0
      buf[w] = cp
      w = w + 1
      i = i + 1
      continue
    }
    let c = (props[cp] >> 9) & 255
    if starter_idx >= 0 && (comp_last_ccc < c || comp_last_ccc == 0) {
      let composed = unicode_compose_pair(buf[starter_idx], cp)
      if composed >= 0 {
        buf[starter_idx] = composed
        i = i + 1
        continue
      }
    }
    if c == 0 {
      starter_idx = w
      comp_last_ccc = 0
    } else {
      comp_last_ccc = c
    }
    buf[w] = cp
    w = w + 1
    i = i + 1
  }
  w
}

///| Apply Unicode NFC normalization to `cps`.
fn nfc_normalize(cps : Array[Int]) -> Array[Int] {
  let n = cps.length()
  if n == 0 {
    return cps
  }
  let props = low_props_lut
  let mut already_nfd = true
  let mut pre_last_ccc = 0
  let mut pi = 0
  while pi < n {
    let cp = cps[pi]
    if cp < 0x00C0 {
      pre_last_ccc = 0
    } else if cp < 4096 {
      let p = props[cp]
      if (p & 262144) != 0 {
        already_nfd = false
        break
      }
      let c = (p >> 9) & 255
      if c != 0 && pre_last_ccc > c {
        already_nfd = false
        break
      }
      pre_last_ccc = c
    } else {
      already_nfd = false
      break
    }
    pi = pi + 1
  }
  let dec = if already_nfd { cps } else { nfd_normalize(cps) }
  let dn = dec.length()
  let out : Array[Int] = Array::with_capacity(dn)
  let mut starter_idx = -1
  let mut last_ccc = -1
  let mut i = 0
  while i < dn {
    let cp = dec[i]
    if cp < 0x0300 {
      starter_idx = out.length()
      last_ccc = 0
      out.push(cp)
      i = i + 1
      continue
    }
    let c = unicode_ccc(cp)
    if starter_idx >= 0 && (last_ccc < c || last_ccc == 0) {
      let st = out[starter_idx]
      let composed = if st >= 0x1100 &&
      st < 0x1113 &&
      cp >= 0x1161 &&
      cp < 0x1176 {
        0xAC00 + ((st - 0x1100) * 21 + (cp - 0x1161)) * 28
      } else if st >= 0xAC00 &&
      st < 0xD7A4 &&
      (st - 0xAC00) % 28 == 0 &&
      cp > 0x11A7 &&
      cp < 0x11C3 {
        st + (cp - 0x11A7)
      } else {
        unicode_compose_pair(st, cp)
      }
      if composed >= 0 {
        out[starter_idx] = composed
        i = i + 1
        continue
      }
    }
    if c == 0 {
      starter_idx = out.length()
      last_ccc = 0
    } else {
      last_ccc = c
    }
    out.push(cp)
    i = i + 1
  }
  out
}

fn cps_equal(a : Array[Int], b : Array[Int]) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}
