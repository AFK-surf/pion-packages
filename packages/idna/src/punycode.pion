///| RFC 3492 Punycode encoder and decoder with strict overflow and DoS limit guards.

let puny_base : Int64 = 36L

let puny_tmin : Int64 = 1L

let puny_tmax : Int64 = 26L

let puny_skew : Int64 = 38L

let puny_damp : Int64 = 700L

let puny_init_bias : Int64 = 72L

let puny_init_n : Int64 = 128L

let puny_max_u32 : Int64 = 0x7FFFFFFFL

fn check_limits_valid(limits : IdnaLimits) -> Result[Unit, IdnaError] {
  if limits.max_input_bytes < 0 ||
  limits.max_labels < 0 ||
  limits.max_label_codepoints < 0 ||
  limits.max_punycode_input < 0 {
    return Err(
      IdnaError::new(IdnaErrorKind::LimitExceeded, "negative IdnaLimits value", -1),
    )
  }
  Ok(())
}

fn puny_adapt(delta_in : Int64, num_points : Int64, first_time : Bool) -> Int64 {
  let mut delta = if first_time { delta_in / puny_damp } else { delta_in >> 1 }
  delta = delta + delta / num_points
  let mut k = 0L
  while delta > ((puny_base - puny_tmin) * puny_tmax) / 2L {
    delta = delta / (puny_base - puny_tmin)
    k = k + puny_base
  }
  k + ((puny_base - puny_tmin + 1L) * delta) / (delta + puny_skew)
}

fn puny_threshold(k : Int64, bias : Int64) -> Int64 {
  if k <= bias {
    1L
  } else if k >= bias + 26L {
    26L
  } else {
    k - bias
  }
}

fn puny_encode_digit(d : Int64) -> Byte {
  if d < 26L {
    (97 + d.to_int()).to_byte()
  } else {
    (48 + (d - 26L).to_int()).to_byte()
  }
}

fn puny_decode_digit(b : Int) -> Int64 {
  if b >= 97 && b <= 122 {
    (b - 97).to_int64()
  } else if b >= 65 && b <= 90 {
    (b - 65).to_int64()
  } else if b >= 48 && b <= 57 {
    (b - 48 + 26).to_int64()
  } else {
    -1L
  }
}

fn punycode_encode_cps_range(
  sb : StringBuilder,
  cps : Array[Int],
  c_start : Int,
  c_end : Int,
  label_index : Int,
) -> Result[Unit, IdnaError] {
  let len = c_end - c_start
  let mut basic_count = 0
  let mut i = c_start
  while i < c_end {
    let cp = cps[i]
    if cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
      return Err(
        IdnaError::new(
          IdnaErrorKind::InvalidPunycode,
          "invalid Unicode scalar value in punycode encode",
          label_index,
        ),
      )
    }
    if cp < 0x80 {
      sb.write_byte(cp.to_byte())
      basic_count = basic_count + 1
    }
    i = i + 1
  }
  let mut h = basic_count
  let b = basic_count
  if b > 0 {
    sb.write_byte((45).to_byte())
  }
  let mut n = puny_init_n
  let mut delta = 0L
  let mut bias = puny_init_bias
  while h < len {
    let mut m : Int64 = 0x110000L
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp >= n && cp < m {
        m = cp
      }
      i = i + 1
    }
    let h1 = (h + 1).to_int64()
    if m - n > (puny_max_u32 - delta) / h1 {
      return Err(
        IdnaError::new(IdnaErrorKind::PunycodeOverflow, "punycode encode overflow", label_index),
      )
    }
    delta = delta + (m - n) * h1
    n = m
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp < n {
        delta = delta + 1L
        if delta > puny_max_u32 {
          return Err(
            IdnaError::new(IdnaErrorKind::PunycodeOverflow, "punycode encode overflow", label_index),
          )
        }
      } else if cp == n {
        let mut q = delta
        let mut k = puny_base
        while true {
          let t = puny_threshold(k, bias)
          if q < t {
            break
          }
          let rem = (q - t) % (puny_base - t)
          sb.write_byte(puny_encode_digit(t + rem))
          q = (q - t) / (puny_base - t)
          k = k + puny_base
        }
        sb.write_byte(puny_encode_digit(q))
        bias = puny_adapt(delta, (h + 1).to_int64(), h == b)
        delta = 0L
        h = h + 1
      }
      i = i + 1
    }
    delta = delta + 1L
    n = n + 1L
  }
  Ok(())
}

fn punycode_encode_fixed_range(
  sb : StringBuilder,
  cps : FixedArray[Int],
  c_start : Int,
  c_end : Int,
  label_index : Int,
) -> Result[Unit, IdnaError] {
  let len = c_end - c_start
  let mut basic_count = 0
  let mut i = c_start
  while i < c_end {
    let cp = cps[i]
    if cp < 0x80 {
      sb.write_byte(cp.to_byte())
      basic_count = basic_count + 1
    }
    i = i + 1
  }
  let mut h = basic_count
  let b = basic_count
  if b > 0 {
    sb.write_byte((45).to_byte())
  }
  let mut n = puny_init_n
  let mut delta = 0L
  let mut bias = puny_init_bias
  while h < len {
    let mut m : Int64 = 0x110000L
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp >= n && cp < m {
        m = cp
      }
      i = i + 1
    }
    let h1 = (h + 1).to_int64()
    if m - n > (puny_max_u32 - delta) / h1 {
      return Err(
        IdnaError::new(IdnaErrorKind::PunycodeOverflow, "punycode encode overflow", label_index),
      )
    }
    delta = delta + (m - n) * h1
    n = m
    i = c_start
    while i < c_end {
      let cp = cps[i].to_int64()
      if cp < n {
        delta = delta + 1L
        if delta > puny_max_u32 {
          return Err(
            IdnaError::new(IdnaErrorKind::PunycodeOverflow, "punycode encode overflow", label_index),
          )
        }
      } else if cp == n {
        let mut q = delta
        let mut k = puny_base
        while true {
          let t = puny_threshold(k, bias)
          if q < t {
            break
          }
          let rem = (q - t) % (puny_base - t)
          sb.write_byte(puny_encode_digit(t + rem))
          q = (q - t) / (puny_base - t)
          k = k + puny_base
        }
        sb.write_byte(puny_encode_digit(q))
        bias = puny_adapt(delta, (h + 1).to_int64(), h == b)
        delta = 0L
        h = h + 1
      }
      i = i + 1
    }
    delta = delta + 1L
    n = n + 1L
  }
  Ok(())
}

fn punycode_decode_cp_slice(
  cps : Array[Int],
  start : Int,
  end : Int,
  limits : IdnaLimits,
  require_non_ascii : Bool,
  label_index : Int,
) -> Result[Array[Int], IdnaError] {
  let in_len = end - start
  if in_len > limits.max_punycode_input {
    return Err(
      IdnaError::new(
        IdnaErrorKind::LimitExceeded,
        "punycode input exceeds max_punycode_input",
        label_index,
      ),
    )
  }
  if require_non_ascii && in_len == 0 {
    return Err(
      IdnaError::new(IdnaErrorKind::InvalidPunycode, "empty punycode payload", label_index),
    )
  }
  let out : Array[Int] = []
  let mut last_dash = -1
  let mut idx = start
  while idx < end {
    let ch = cps[idx]
    if ch >= 0x80 || ch < 0 {
      return Err(
        IdnaError::new(IdnaErrorKind::InvalidPunycode, "non-ASCII in punycode", label_index),
      )
    }
    if ch == 45 {
      last_dash = idx
    }
    idx = idx + 1
  }
  if last_dash >= start {
    let basic_len = last_dash - start
    if basic_len > limits.max_label_codepoints {
      return Err(
        IdnaError::new(
          IdnaErrorKind::LimitExceeded,
          "decoded punycode exceeds max_label_codepoints",
          label_index,
        ),
      )
    }
    idx = start
    while idx < last_dash {
      out.push(cps[idx])
      idx = idx + 1
    }
    idx = last_dash + 1
  } else {
    idx = start
  }
  let mut n = puny_init_n
  let mut i = 0L
  let mut bias = puny_init_bias
  let mut has_non_ascii = false
  while idx < end {
    let old_i = i
    let mut w = 1L
    let mut k = puny_base
    while true {
      if idx >= end {
        return Err(
          IdnaError::new(IdnaErrorKind::InvalidPunycode, "truncated punycode", label_index),
        )
      }
      let digit = puny_decode_digit(cps[idx])
      idx = idx + 1
      if digit < 0L {
        return Err(
          IdnaError::new(IdnaErrorKind::InvalidPunycode, "invalid punycode digit", label_index),
        )
      }
      if digit > (puny_max_u32 - i) / w {
        return Err(
          IdnaError::new(IdnaErrorKind::PunycodeOverflow, "punycode index overflow", label_index),
        )
      }
      i = i + digit * w
      let t = puny_threshold(k, bias)
      if digit < t {
        break
      }
      let mult = puny_base - t
      if w > puny_max_u32 / mult {
        return Err(
          IdnaError::new(IdnaErrorKind::PunycodeOverflow, "punycode weight overflow", label_index),
        )
      }
      w = w * mult
      k = k + puny_base
    }
    let out_len1 = (out.length() + 1).to_int64()
    if out.length() >= limits.max_label_codepoints {
      return Err(
        IdnaError::new(
          IdnaErrorKind::LimitExceeded,
          "decoded punycode exceeds max_label_codepoints",
          label_index,
        ),
      )
    }
    bias = puny_adapt(i - old_i, out_len1, old_i == 0L)
    let inc = i / out_len1
    if inc > 0x10FFFFL - n {
      return Err(
        IdnaError::new(
          IdnaErrorKind::PunycodeOverflow,
          "punycode code point overflow",
          label_index,
        ),
      )
    }
    n = n + inc
    i = i % out_len1
    let cp = n.to_int()
    if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
      return Err(
        IdnaError::new(
          IdnaErrorKind::InvalidPunycode,
          "invalid Unicode scalar value in punycode",
          label_index,
        ),
      )
    }
    if cp >= 0x80 {
      has_non_ascii = true
    }
    let pos = i.to_int()
    out.push(0)
    let mut j = out.length() - 1
    while j > pos {
      out[j] = out[j - 1]
      j = j - 1
    }
    out[pos] = cp
    i = i + 1L
  }
  if require_non_ascii && !has_non_ascii {
    return Err(
      IdnaError::new(
        IdnaErrorKind::InvalidPunycode,
        "punycode label has no non-ASCII code points",
        label_index,
      ),
    )
  }
  Ok(out)
}

///| Encode a UTF-8 string into RFC 3492 Punycode (without `xn--` prefix) with explicit limits.
pub fn punycode_encode_with_limits(
  input : String,
  limits : IdnaLimits,
) -> Result[String, IdnaError] {
  match check_limits_valid(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if input.length() > limits.max_input_bytes {
    return Err(
      IdnaError::new(
        IdnaErrorKind::LimitExceeded,
        "input exceeds max_input_bytes",
        -1,
      ),
    )
  }
  let cps = match string_to_cps_strict(input) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if cps.length() > limits.max_label_codepoints {
    return Err(
      IdnaError::new(
        IdnaErrorKind::LimitExceeded,
        "input exceeds max_label_codepoints",
        -1,
      ),
    )
  }
  let sb = StringBuilder::with_capacity(cps.length() * 2 + 8)
  match punycode_encode_cps_range(sb, cps, 0, cps.length(), -1) {
    Ok(_) => Ok(sb.to_string())
    Err(e) => Err(e)
  }
}

///| Encode a UTF-8 string into RFC 3492 Punycode (without `xn--` prefix) using default limits.
pub fn punycode_encode(input : String) -> Result[String, IdnaError] {
  punycode_encode_with_limits(input, IdnaLimits::default())
}

///| Decode an RFC 3492 Punycode string (without `xn--` prefix) into UTF-8 with explicit limits.
pub fn punycode_decode_with_limits(
  input : String,
  limits : IdnaLimits,
) -> Result[String, IdnaError] {
  match check_limits_valid(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = input.length()
  if n > limits.max_input_bytes || n > limits.max_punycode_input {
    return Err(
      IdnaError::new(
        IdnaErrorKind::LimitExceeded,
        "punycode input exceeds configured limits",
        -1,
      ),
    )
  }
  let cps : Array[Int] = []
  let mut i = 0
  while i < n {
    let b = input.code_unit_at(i)
    if b >= 0x80 {
      return Err(
        IdnaError::new(IdnaErrorKind::InvalidPunycode, "non-ASCII byte in punycode", -1),
      )
    }
    cps.push(b)
    i = i + 1
  }
  match punycode_decode_cp_slice(cps, 0, n, limits, false, -1) {
    Ok(out) => Ok(cps_to_string(out))
    Err(e) => Err(e)
  }
}

///| Decode an RFC 3492 Punycode string (without `xn--` prefix) into UTF-8 using default limits.
pub fn punycode_decode(input : String) -> Result[String, IdnaError] {
  punycode_decode_with_limits(input, IdnaLimits::default())
}
