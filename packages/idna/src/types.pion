///| Core public types, configuration presets, limits, and error kinds for `packages/idna`.
///| Pure Pion, zero external dependencies, zero `World`, zero `extern "C"`.

pub enum IdnaErrorKind {
  EmptyInput
  EmptyLabel
  InvalidUtf8
  DisallowedCodePoint
  InvalidPunycode
  PunycodeOverflow
  PunycodeNotNfc
  InvalidHyphens
  LeadingCombiningMark
  InvalidBidi
  InvalidJoiner
  InvalidContextO
  LabelTooLong
  DomainTooLong
  DotInLabel
  LimitExceeded
}

pub fn IdnaErrorKind::to_string(self : IdnaErrorKind) -> String {
  match self {
    IdnaErrorKind::EmptyInput => "EmptyInput"
    IdnaErrorKind::EmptyLabel => "EmptyLabel"
    IdnaErrorKind::InvalidUtf8 => "InvalidUtf8"
    IdnaErrorKind::DisallowedCodePoint => "DisallowedCodePoint"
    IdnaErrorKind::InvalidPunycode => "InvalidPunycode"
    IdnaErrorKind::PunycodeOverflow => "PunycodeOverflow"
    IdnaErrorKind::PunycodeNotNfc => "PunycodeNotNfc"
    IdnaErrorKind::InvalidHyphens => "InvalidHyphens"
    IdnaErrorKind::LeadingCombiningMark => "LeadingCombiningMark"
    IdnaErrorKind::InvalidBidi => "InvalidBidi"
    IdnaErrorKind::InvalidJoiner => "InvalidJoiner"
    IdnaErrorKind::InvalidContextO => "InvalidContextO"
    IdnaErrorKind::LabelTooLong => "LabelTooLong"
    IdnaErrorKind::DomainTooLong => "DomainTooLong"
    IdnaErrorKind::DotInLabel => "DotInLabel"
    IdnaErrorKind::LimitExceeded => "LimitExceeded"
  }
}

pub fn IdnaErrorKind::eq(self : IdnaErrorKind, other : IdnaErrorKind) -> Bool {
  self.to_string() == other.to_string()
}

pub val struct IdnaError {
  pub kind : IdnaErrorKind
  pub message : String
  pub label_index : Int
}

pub fn IdnaError::new(
  kind : IdnaErrorKind,
  message : String,
  label_index : Int,
) -> IdnaError {
  IdnaError::{ kind: kind, message: message, label_index: label_index }
}

pub fn IdnaError::to_string(self : IdnaError) -> String {
  if self.label_index >= 0 {
    self.kind.to_string() + " (label " + self.label_index.to_string() + "): " + self.message
  } else {
    self.kind.to_string() + ": " + self.message
  }
}

///| DoS protection limits for Punycode and UTS #46 / UTS #39 processing.
///| Any negative limit fails immediately with `IdnaErrorKind::LimitExceeded`; `0` is enforced strictly.
pub val struct IdnaLimits {
  pub max_input_bytes : Int
  pub max_labels : Int
  pub max_label_codepoints : Int
  pub max_punycode_input : Int
}

pub fn IdnaLimits::default() -> IdnaLimits {
  IdnaLimits::{
    max_input_bytes: 4096,
    max_labels: 128,
    max_label_codepoints: 1000,
    max_punycode_input: 2000,
  }
}

///| Complete configurable UTS #46 + IDNA2008 processing flags.
pub val struct IdnaOptions {
  pub use_std3_ascii_rules : Bool
  pub check_hyphens : Bool
  pub check_bidi : Bool
  pub check_joiners : Bool
  pub check_contexto : Bool
  pub verify_dns_length : Bool
  pub transitional_processing : Bool
  pub ignore_invalid_punycode : Bool
  pub deny_dot_in_label : Bool
}

///| Strict IDNA2008 + UTS #46 profile (STD3, hyphens, Bidi, ContextJ, ContextO, DNS length, non-transitional).
pub fn IdnaOptions::uts46_strict() -> IdnaOptions {
  IdnaOptions::{
    use_std3_ascii_rules: true,
    check_hyphens: true,
    check_bidi: true,
    check_joiners: true,
    check_contexto: true,
    verify_dns_length: true,
    transitional_processing: false,
    ignore_invalid_punycode: false,
    deny_dot_in_label: true,
  }
}

///| WHATWG URL / Rust `idna` non-strict profile (STD3=false, hyphens=false, Bidi+Joiners=true, DNS length=false).
pub fn IdnaOptions::uts46_url() -> IdnaOptions {
  IdnaOptions::{
    use_std3_ascii_rules: false,
    check_hyphens: false,
    check_bidi: true,
    check_joiners: true,
    check_contexto: false,
    verify_dns_length: false,
    transitional_processing: false,
    ignore_invalid_punycode: false,
    deny_dot_in_label: true,
  }
}

///| UTS #46 Non-Transitional profile (STD3, hyphens, Bidi, Joiners, DNS length, ContextO=false).
pub fn IdnaOptions::uts46_non_transitional() -> IdnaOptions {
  IdnaOptions::{
    use_std3_ascii_rules: true,
    check_hyphens: true,
    check_bidi: true,
    check_joiners: true,
    check_contexto: false,
    verify_dns_length: true,
    transitional_processing: false,
    ignore_invalid_punycode: false,
    deny_dot_in_label: true,
  }
}

///| UTS #46 Transitional profile (maps `ß`->`ss`, `ς`->`σ`, strips ZWNJ/ZWJ).
pub fn IdnaOptions::uts46_transitional() -> IdnaOptions {
  IdnaOptions::{
    use_std3_ascii_rules: true,
    check_hyphens: true,
    check_bidi: true,
    check_joiners: true,
    check_contexto: false,
    verify_dns_length: true,
    transitional_processing: true,
    ignore_invalid_punycode: false,
    deny_dot_in_label: true,
  }
}

///| Result of UTS #46 `ToUnicode`: always returns best-effort Unicode output along with
///| validity status and first error (per UTS #46 §4.2).
pub val struct UnicodeResult {
  pub output : String
  pub is_valid : Bool
  pub first_error : Option[IdnaError]
  pub error_count : Int
}

///| Unicode Script identifier (Unicode 16.0.0 `Scripts.txt`).
pub enum Script {
  Common
  Inherited
  Latin
  Greek
  Cyrillic
  Han
  Hiragana
  Katakana
  Hangul
  Arabic
  Hebrew
  Thai
  Devanagari
  Bengali
  Gurmukhi
  Gujarati
  Oriya
  Tamil
  Telugu
  Kannada
  Malayalam
  Sinhala
  Myanmar
  Georgian
  Armenian
  Ethiopic
  Cherokee
  Khmer
  Lao
  Tibetan
  Bopomofo
  Other(Int)
}

pub fn Script::from_id(id : Int) -> Script {
  match id {
    0 => Script::Common
    1 => Script::Inherited
    2 => Script::Latin
    3 => Script::Greek
    4 => Script::Cyrillic
    5 => Script::Han
    6 => Script::Hiragana
    7 => Script::Katakana
    8 => Script::Hangul
    9 => Script::Arabic
    10 => Script::Hebrew
    11 => Script::Thai
    12 => Script::Devanagari
    13 => Script::Bengali
    14 => Script::Gurmukhi
    15 => Script::Gujarati
    16 => Script::Oriya
    17 => Script::Tamil
    18 => Script::Telugu
    19 => Script::Kannada
    20 => Script::Malayalam
    21 => Script::Sinhala
    22 => Script::Myanmar
    23 => Script::Georgian
    24 => Script::Armenian
    25 => Script::Ethiopic
    26 => Script::Cherokee
    27 => Script::Khmer
    28 => Script::Lao
    29 => Script::Tibetan
    30 => Script::Bopomofo
    _ => Script::Other(id)
  }
}

pub fn Script::id(self : Script) -> Int {
  match self {
    Script::Common => 0
    Script::Inherited => 1
    Script::Latin => 2
    Script::Greek => 3
    Script::Cyrillic => 4
    Script::Han => 5
    Script::Hiragana => 6
    Script::Katakana => 7
    Script::Hangul => 8
    Script::Arabic => 9
    Script::Hebrew => 10
    Script::Thai => 11
    Script::Devanagari => 12
    Script::Bengali => 13
    Script::Gurmukhi => 14
    Script::Gujarati => 15
    Script::Oriya => 16
    Script::Tamil => 17
    Script::Telugu => 18
    Script::Kannada => 19
    Script::Malayalam => 20
    Script::Sinhala => 21
    Script::Myanmar => 22
    Script::Georgian => 23
    Script::Armenian => 24
    Script::Ethiopic => 25
    Script::Cherokee => 26
    Script::Khmer => 27
    Script::Lao => 28
    Script::Tibetan => 29
    Script::Bopomofo => 30
    Script::Other(id) => id
  }
}

pub fn Script::to_string(self : Script) -> String {
  match self {
    Script::Common => "Common"
    Script::Inherited => "Inherited"
    Script::Latin => "Latin"
    Script::Greek => "Greek"
    Script::Cyrillic => "Cyrillic"
    Script::Han => "Han"
    Script::Hiragana => "Hiragana"
    Script::Katakana => "Katakana"
    Script::Hangul => "Hangul"
    Script::Arabic => "Arabic"
    Script::Hebrew => "Hebrew"
    Script::Thai => "Thai"
    Script::Devanagari => "Devanagari"
    Script::Bengali => "Bengali"
    Script::Gurmukhi => "Gurmukhi"
    Script::Gujarati => "Gujarati"
    Script::Oriya => "Oriya"
    Script::Tamil => "Tamil"
    Script::Telugu => "Telugu"
    Script::Kannada => "Kannada"
    Script::Malayalam => "Malayalam"
    Script::Sinhala => "Sinhala"
    Script::Myanmar => "Myanmar"
    Script::Georgian => "Georgian"
    Script::Armenian => "Armenian"
    Script::Ethiopic => "Ethiopic"
    Script::Cherokee => "Cherokee"
    Script::Khmer => "Khmer"
    Script::Lao => "Lao"
    Script::Tibetan => "Tibetan"
    Script::Bopomofo => "Bopomofo"
    Script::Other(id) => "Other(" + id.to_string() + ")"
  }
}

pub fn Script::eq(self : Script, other : Script) -> Bool {
  self.id() == other.id()
}

///| Reasons why a domain label is forced to Punycode in browser omnibox display.
pub enum SpoofReason {
  InvalidIdna
  MixedScript
  WholeScriptConfusable
  InvisibleCodePoint
  MixedNumberingSystems
  DisallowedScript
}

pub fn SpoofReason::to_string(self : SpoofReason) -> String {
  match self {
    SpoofReason::InvalidIdna => "InvalidIdna"
    SpoofReason::MixedScript => "MixedScript"
    SpoofReason::WholeScriptConfusable => "WholeScriptConfusable"
    SpoofReason::InvisibleCodePoint => "InvisibleCodePoint"
    SpoofReason::MixedNumberingSystems => "MixedNumberingSystems"
    SpoofReason::DisallowedScript => "DisallowedScript"
  }
}

pub fn SpoofReason::eq(self : SpoofReason, other : SpoofReason) -> Bool {
  self.to_string() == other.to_string()
}

///| Browser address bar (Omnibox) IDN display policy.
pub val struct DisplayPolicy {
  pub idna_options : IdnaOptions
  pub limits : IdnaLimits
  pub allow_mixed_latin_cjk : Bool
  pub check_whole_script_confusable : Bool
  pub check_invisible : Bool
  pub check_mixed_numbers : Bool
  pub ascii_only : Bool
}

///| Modern browser Omnibox default policy (UTS #39 Moderately Restrictive + whole-script confusable guard).
pub fn DisplayPolicy::browser_default() -> DisplayPolicy {
  DisplayPolicy::{
    idna_options: IdnaOptions::uts46_strict(),
    limits: IdnaLimits::default(),
    allow_mixed_latin_cjk: true,
    check_whole_script_confusable: true,
    check_invisible: true,
    check_mixed_numbers: true,
    ascii_only: false,
  }
}

///| Always display normalized ASCII / Punycode (never render Unicode IDN).
pub fn DisplayPolicy::strict_ascii_only() -> DisplayPolicy {
  DisplayPolicy::{
    idna_options: IdnaOptions::uts46_strict(),
    limits: IdnaLimits::default(),
    allow_mixed_latin_cjk: false,
    check_whole_script_confusable: true,
    check_invisible: true,
    check_mixed_numbers: true,
    ascii_only: true,
  }
}

///| Omnibox display decision returned by `display_domain`.
///| Note: contains `Array[SpoofReason]`, so it is not `Send`; pass `display`/`ascii` across `spawn`.
pub struct DisplayDecision {
  pub display : String
  pub ascii : String
  pub is_punycode_fallback : Bool
  pub reasons : Array[SpoofReason]
}
