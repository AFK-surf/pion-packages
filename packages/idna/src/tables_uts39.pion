let script_count : Int = 805
let script_start : FixedArray[Int] = decode_vlq_delta_array(script_s_data, 805)
let script_end : FixedArray[Int] = decode_vlq_end_array(script_start, script_e_data, 805)
let script_val : FixedArray[Int] = decode_vlq_u_array(script_v_data, 805)

let ign_count : Int = 17
let ign_start : FixedArray[Int] = decode_vlq_delta_array(ign_s_data, 17)
let ign_end : FixedArray[Int] = decode_vlq_end_array(ign_start, ign_e_data, 17)

let nd_count : Int = 71
let nd_start : FixedArray[Int] = decode_vlq_delta_array(nd_s_data, 71)
let nd_end : FixedArray[Int] = decode_vlq_end_array(nd_start, nd_e_data, 71)

let conf_count : Int = 6355
let conf_cp : FixedArray[Int] = decode_vlq_delta_array(conf_cp_data, 6355)
let conf_info : FixedArray[Int] = decode_vlq_u_array(conf_info_data, 6355)
let conf_pool : FixedArray[Int] = decode_vlq_u_array(conf_pool_data, 3445)

///| Lookup Unicode Script ID (0=Common, 1=Inherited, 2=Latin, 3=Greek, 4=Cyrillic, 5=Han, ...).
fn unicode_script_id(cp : Int) -> Int {
  if (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) {
    return 2
  }
  if cp < 0x00AA {
    return 0
  }
  let starts = script_start
  let mut lo = 0
  let mut hi = script_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  if hi >= 0 && cp <= script_end[hi] {
    script_val[hi]
  } else {
    0
  }
}

///| Return true if `cp` has Default_Ignorable_Code_Point property.
fn unicode_is_default_ignorable(cp : Int) -> Bool {
  if cp < 0x00AD {
    return false
  }
  let starts = ign_start
  let mut lo = 0
  let mut hi = ign_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  hi >= 0 && cp <= ign_end[hi]
}

///| Return decimal digit numbering-system block index (>= 0) if `cp` has General_Category Nd, else -1.
fn unicode_decimal_digit_system(cp : Int) -> Int {
  if cp >= 48 && cp <= 57 {
    return 0
  }
  if cp < 0x0660 {
    return -1
  }
  let starts = nd_start
  let mut lo = 0
  let mut hi = nd_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  if hi >= 0 && cp <= nd_end[hi] {
    hi
  } else {
    -1
  }
}

///| Lookup UTS #39 confusable prototype info for `cp`, or -1 if unmapped.
///| Encoding: (info & 1) == 0 => single target cp = info >> 1;
///|           (info & 1) == 1 => packed = info >> 1, off = packed & 0xFFFF, len = packed >> 16.
fn unicode_confusable_info(cp : Int) -> Int {
  let cps = conf_cp
  let mut lo = 0
  let mut hi = conf_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    let v = cps[mid]
    if v == cp {
      return conf_info[mid]
    } else if v < cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  -1
}
