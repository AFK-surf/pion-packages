///| Full configurable Unicode 16.0.0 UTS #46 + IDNA2008 (RFC 5891 / 5892 / 5893) engine.

fn is_std3_ascii_valid(cp : Int) -> Bool {
  (cp >= 97 && cp <= 122) || (cp >= 48 && cp <= 57) || cp == 45
}

fn cp_may_be_rtl(cp : Int) -> Bool {
  if cp < 0x0590 {
    return false
  }
  if cp >= 0x4E00 && cp <= 0x9FFF {
    return false
  }
  if cp >= 0xAC00 && cp <= 0xD7A3 {
    return false
  }
  if cp >= 0x3040 && cp <= 0x30FF {
    return false
  }
  let bc = unicode_bidi_class(cp)
  bc == 1 || bc == 2 || bc == 6
}

fn cp_is_contexto_char(cp : Int) -> Bool {
  cp == 0x00B7 ||
  cp == 0x0375 ||
  cp == 0x05F3 ||
  cp == 0x05F4 ||
  cp == 0x30FB ||
  (cp >= 0x0660 && cp <= 0x0669) ||
  (cp >= 0x06F0 && cp <= 0x06F9)
}

///| RFC 5892 ContextJ: ZWNJ (U+200C) and ZWJ (U+200D) rules.
fn check_joiners_label(label : Array[Int]) -> Bool {
  let n = label.length()
  let mut i = 0
  while i < n {
    let cp = label[i]
    if cp == 0x200D {
      if i == 0 || unicode_ccc(label[i - 1]) != 9 {
        return false
      }
    } else if cp == 0x200C {
      if i > 0 && unicode_ccc(label[i - 1]) == 9 {
        i = i + 1
        continue
      }
      let mut j = i - 1
      while j >= 0 && unicode_joining_type(label[j]) == 4 {
        j = j - 1
      }
      if j < 0 {
        return false
      }
      let jtl = unicode_joining_type(label[j])
      if jtl != 1 && jtl != 3 {
        return false
      }
      let mut k = i + 1
      while k < n && unicode_joining_type(label[k]) == 4 {
        k = k + 1
      }
      if k >= n {
        return false
      }
      let jtr = unicode_joining_type(label[k])
      if jtr != 2 && jtr != 3 {
        return false
      }
    }
    i = i + 1
  }
  true
}

///| RFC 5892 ContextO rules (Appendix A.3–A.9):
///| - U+00B7 MIDDLE DOT: preceded by 'l' and followed by 'l'
///| - U+0375 GREEK LOWER NUMERAL SIGN (KERAIA): followed by Script=Greek
///| - U+05F3/U+05F4 HEBREW GERESH/GERSHAYIM: preceded by Script=Hebrew
///| - U+30FB KATAKANA MIDDLE DOT: label contains Hiragana, Katakana, or Han
///| - U+0660..0669 vs U+06F0..06F9: Arabic-Indic and Extended Arabic-Indic digits cannot mix
fn check_contexto_label(label : Array[Int]) -> Bool {
  let n = label.length()
  let mut has_arabic_indic = false
  let mut has_ext_arabic_indic = false
  let mut has_katakana_dot = false
  let mut has_cjk_kana = false
  let mut i = 0
  while i < n {
    let cp = label[i]
    if cp == 0x00B7 {
      if i == 0 || i + 1 >= n || label[i - 1] != 0x006C || label[i + 1] != 0x006C {
        return false
      }
    } else if cp == 0x0375 {
      if i + 1 >= n || unicode_script_id(label[i + 1]) != 3 {
        return false
      }
    } else if cp == 0x05F3 || cp == 0x05F4 {
      if i == 0 || unicode_script_id(label[i - 1]) != 10 {
        return false
      }
    } else if cp == 0x30FB {
      has_katakana_dot = true
    } else if cp >= 0x0660 && cp <= 0x0669 {
      has_arabic_indic = true
    } else if cp >= 0x06F0 && cp <= 0x06F9 {
      has_ext_arabic_indic = true
    }
    if !has_cjk_kana && cp >= 0x80 {
      let sid = unicode_script_id(cp)
      if sid == 5 || sid == 6 || sid == 7 {
        has_cjk_kana = true
      }
    }
    i = i + 1
  }
  if has_arabic_indic && has_ext_arabic_indic {
    return false
  }
  if has_katakana_dot && !has_cjk_kana {
    return false
  }
  true
}

///| RFC 5893 Bidi Rule 1–6 across all labels in a domain.
fn check_bidi_domain(labels : Array[Array[Int]]) -> Int {
  let num_labels = labels.length()
  let mut is_bidi = false
  let mut li = 0
  while li < num_labels && !is_bidi {
    let lab = labels[li]
    let ln = lab.length()
    let mut i = 0
    while i < ln {
      let bc = unicode_bidi_class(lab[i])
      if bc == 1 || bc == 2 || bc == 6 {
        is_bidi = true
        break
      }
      i = i + 1
    }
    li = li + 1
  }
  if !is_bidi {
    return -1
  }
  li = 0
  while li < num_labels {
    let lab = labels[li]
    let ln = lab.length()
    if ln == 0 {
      li = li + 1
      continue
    }
    let bc0 = unicode_bidi_class(lab[0])
    if bc0 == 1 || bc0 == 2 {
      let mut has_en = false
      let mut has_an = false
      let mut i = 0
      while i < ln {
        let bc = unicode_bidi_class(lab[i])
        if bc == 0 || bc >= 11 {
          return li
        }
        if bc == 3 {
          has_en = true
        } else if bc == 6 {
          has_an = true
        }
        i = i + 1
      }
      if has_en && has_an {
        return li
      }
      let mut last = ln - 1
      while last >= 0 && unicode_bidi_class(lab[last]) == 8 {
        last = last - 1
      }
      if last < 0 {
        return li
      }
      let lbc = unicode_bidi_class(lab[last])
      if lbc != 1 && lbc != 2 && lbc != 3 && lbc != 6 {
        return li
      }
    } else if bc0 == 0 {
      let mut i = 0
      while i < ln {
        let bc = unicode_bidi_class(lab[i])
        if bc == 1 || bc == 2 || bc == 6 || bc >= 11 {
          return li
        }
        i = i + 1
      }
      let mut last = ln - 1
      while last >= 0 && unicode_bidi_class(lab[last]) == 8 {
        last = last - 1
      }
      if last < 0 {
        return li
      }
      let lbc = unicode_bidi_class(lab[last])
      if lbc != 0 && lbc != 3 {
        return li
      }
    } else {
      return li
    }
    li = li + 1
  }
  -1
}

fn check_hyphens_label(lab : Array[Int]) -> Bool {
  let ln = lab.length()
  if ln == 0 {
    return true
  }
  if lab[0] == 45 || lab[ln - 1] == 45 {
    return false
  }
  if ln >= 4 && lab[2] == 45 && lab[3] == 45 {
    return false
  }
  true
}

fn label_is_punycode_ascii(s : String, start : Int, end : Int) -> Bool {
  if end - start < 4 {
    return false
  }
  let b0 = s.code_unit_at(start)
  let b1 = s.code_unit_at(start + 1)
  let b2 = s.code_unit_at(start + 2)
  let b3 = s.code_unit_at(start + 3)
  (b0 == 120 || b0 == 88) &&
  (b1 == 110 || b1 == 78) &&
  b2 == 45 &&
  b3 == 45
}

struct ProcessState {
  labels : Array[Array[Int]]
  first_error : Option[IdnaError]
  error_count : Int
}

fn record_err(
  first_err : Option[IdnaError],
  err_count : Int,
  kind : IdnaErrorKind,
  msg : String,
  label_index : Int,
) -> (Option[IdnaError], Int) {
  let next_first = match first_err {
    Some(_) => first_err
    None => Some(IdnaError::new(kind, msg, label_index))
  }
  (next_first, err_count + 1)
}

///| Core UTS #46 §4 `Processing` algorithm returning labels + error state.
fn uts46_process(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> Result[ProcessState, IdnaError] {
  match check_limits_valid(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let d_len = domain.length()
  if d_len > limits.max_input_bytes {
    return Err(
      IdnaError::new(IdnaErrorKind::LimitExceeded, "domain exceeds max_input_bytes", -1),
    )
  }
  let mapped : Array[Int] = []
  let mut needs_nfc = false
  let mut first_err : Option[IdnaError] = None
  let mut err_count = 0
  let mut cur_label_cps = 0
  let mut cur_labels = 1
  // Pre-NFC upper bound per label: canonical composition shrinks by at most 4x.
  let max_pre_nfc_label_cps = if limits.max_label_codepoints > 0x1FFFFFFF {
    0x7FFFFFFF
  } else {
    limits.max_label_codepoints * 4
  }
  let mut pos = 0
  while pos < d_len {
    let (cp, next, ok) = decode_utf8_strict(domain, pos, d_len)
    if !ok {
      return Err(
        IdnaError::new(IdnaErrorKind::InvalidUtf8, "invalid UTF-8 in domain", -1),
      )
    }
    pos = next
    if cp < 0x80 {
      let c = if cp >= 65 && cp <= 90 { cp + 32 } else { cp }
      if c == 46 {
        cur_label_cps = 0
        cur_labels = cur_labels + 1
        if cur_labels > limits.max_labels {
          return Err(
            IdnaError::new(IdnaErrorKind::LimitExceeded, "domain exceeds max_labels", cur_labels - 1),
          )
        }
      } else {
        cur_label_cps = cur_label_cps + 1
        if cur_label_cps > max_pre_nfc_label_cps {
          return Err(
            IdnaError::new(
              IdnaErrorKind::LimitExceeded,
              "label exceeds max_label_codepoints",
              cur_labels - 1,
            ),
          )
        }
      }
      mapped.push(c)
    } else {
      let v = uts46_lookup_fast(cp)
      if v == 0 {
        let (fe, ec) = record_err(
          first_err,
          err_count,
          IdnaErrorKind::DisallowedCodePoint,
          "disallowed code point in domain",
          -1,
        )
        first_err = fe
        err_count = ec
        cur_label_cps = cur_label_cps + 1
        if cur_label_cps > max_pre_nfc_label_cps {
          return Err(
            IdnaError::new(
              IdnaErrorKind::LimitExceeded,
              "label exceeds max_label_codepoints",
              cur_labels - 1,
            ),
          )
        }
        mapped.push(cp)
      } else if v == 1 {
        if !needs_nfc && cp_may_need_nfc(cp) {
          needs_nfc = true
        }
        cur_label_cps = cur_label_cps + 1
        if cur_label_cps > max_pre_nfc_label_cps {
          return Err(
            IdnaError::new(
              IdnaErrorKind::LimitExceeded,
              "label exceeds max_label_codepoints",
              cur_labels - 1,
            ),
          )
        }
        mapped.push(cp)
      } else if v == 2 {
        continue
      } else if v == 5 {
        // Deviation: U+00DF, U+03C2, U+200C, U+200D
        if opts.transitional_processing {
          if cp == 0x00DF {
            mapped.push(0x0073)
            mapped.push(0x0073)
            cur_label_cps = cur_label_cps + 2
          } else if cp == 0x03C2 {
            mapped.push(0x03C3)
            cur_label_cps = cur_label_cps + 1
          }
          // 0x200C and 0x200D are mapped to empty in transitional processing
        } else {
          mapped.push(cp)
          cur_label_cps = cur_label_cps + 1
        }
        if cur_label_cps > max_pre_nfc_label_cps {
          return Err(
            IdnaError::new(
              IdnaErrorKind::LimitExceeded,
              "label exceeds max_label_codepoints",
              cur_labels - 1,
            ),
          )
        }
      } else if (v & 7) == 3 {
        let m = cp + (v >> 3)
        if opts.transitional_processing && (m == 0x00DF || m == 0x03C2 || m == 0x200C || m == 0x200D) {
          // Mapping target is a deviation character (e.g. U+1E9E ẞ -> U+00DF -> "ss").
          if m == 0x00DF {
            mapped.push(0x0073)
            mapped.push(0x0073)
            cur_label_cps = cur_label_cps + 2
          } else if m == 0x03C2 {
            mapped.push(0x03C3)
            cur_label_cps = cur_label_cps + 1
          }
        } else {
          if m == 46 {
            cur_label_cps = 0
            cur_labels = cur_labels + 1
            if cur_labels > limits.max_labels {
              return Err(
                IdnaError::new(
                  IdnaErrorKind::LimitExceeded,
                  "domain exceeds max_labels",
                  cur_labels - 1,
                ),
              )
            }
          } else {
            cur_label_cps = cur_label_cps + 1
          }
          if !needs_nfc && cp_may_need_nfc(m) {
            needs_nfc = true
          }
          mapped.push(m)
        }
        if cur_label_cps > max_pre_nfc_label_cps {
          return Err(
            IdnaError::new(
              IdnaErrorKind::LimitExceeded,
              "label exceeds max_label_codepoints",
              cur_labels - 1,
            ),
          )
        }
      } else {
        let off = (v >> 3) & 0xFFFF
        let mlen = v >> 19
        let mut k = 0
        while k < mlen {
          let m = idna_pool[off + k]
          if opts.transitional_processing && (m == 0x00DF || m == 0x03C2 || m == 0x200C || m == 0x200D) {
            if m == 0x00DF {
              mapped.push(0x0073)
              mapped.push(0x0073)
              cur_label_cps = cur_label_cps + 2
            } else if m == 0x03C2 {
              mapped.push(0x03C3)
              cur_label_cps = cur_label_cps + 1
            }
          } else {
            if m == 46 {
              cur_label_cps = 0
              cur_labels = cur_labels + 1
              if cur_labels > limits.max_labels {
                return Err(
                  IdnaError::new(
                    IdnaErrorKind::LimitExceeded,
                    "domain exceeds max_labels",
                    cur_labels - 1,
                  ),
                )
              }
            } else {
              cur_label_cps = cur_label_cps + 1
            }
            if !needs_nfc && cp_may_need_nfc(m) {
              needs_nfc = true
            }
            mapped.push(m)
          }
          if cur_label_cps > max_pre_nfc_label_cps {
            return Err(
              IdnaError::new(
                IdnaErrorKind::LimitExceeded,
                "label exceeds max_label_codepoints",
                cur_labels - 1,
              ),
            )
          }
          k = k + 1
        }
      }
    }
  }
  let norm = if needs_nfc { nfc_normalize(mapped) } else { mapped }
  let norm_len = norm.length()
  let labels : Array[Array[Int]] = []
  let mut ls = 0
  let mut k = 0
  let mut li = 0
  while k <= norm_len {
    if k == norm_len || norm[k] == 46 {
      if li >= limits.max_labels {
        return Err(
          IdnaError::new(IdnaErrorKind::LimitExceeded, "domain exceeds max_labels", li),
        )
      }
      let llen = k - ls
      let is_xn = llen >= 4 &&
      norm[ls] == 120 &&
      norm[ls + 1] == 110 &&
      norm[ls + 2] == 45 &&
      norm[ls + 3] == 45
      if is_xn {
        let mut has_non_ascii_in_xn = false
        let mut j = ls
        while j < k {
          if norm[j] >= 0x80 {
            has_non_ascii_in_xn = true
            break
          }
          j = j + 1
        }
        if has_non_ascii_in_xn {
          let raw_lab : Array[Int] = []
          j = ls
          while j < k {
            raw_lab.push(norm[j])
            j = j + 1
          }
          // UTS #46 §4 step 4.1.1: a non-ASCII xn-- label is always an error regardless of IgnoreInvalidPunycode.
          let (fe, ec) = record_err(
            first_err,
            err_count,
            IdnaErrorKind::InvalidPunycode,
            "non-ASCII character in xn-- label",
            li,
          )
          first_err = fe
          err_count = ec
          labels.push(raw_lab)
        } else {
          let mut dec_opt : Option[Array[Int]] = None
          match punycode_decode_cp_slice(norm, ls + 4, k, limits, true, li) {
            Err(e) => {
              if e.kind.eq(IdnaErrorKind::LimitExceeded) {
                return Err(e)
              }
              let raw_lab : Array[Int] = []
              j = ls
              while j < k {
                raw_lab.push(norm[j])
                j = j + 1
              }
              if !opts.ignore_invalid_punycode {
                let (fe, ec) = record_err(first_err, err_count, e.kind, e.message, li)
                first_err = fe
                err_count = ec
                labels.push(raw_lab)
              } else {
                // UTS #46 §4 step 4.1: IgnoreInvalidPunycode only waives Punycode conversion failure;
                // the label still proceeds through empty/ASCII-only and validity criteria (V1-V8).
                dec_opt = Some(raw_lab)
              }
            }
            Ok(d) => dec_opt = Some(d)
          }
          match dec_opt {
            None => ()
            Some(dec) => {
              let dn = dec.length()
              let mut dec_has_non_ascii = false
              let mut ci = 0
              while ci < dn {
                if dec[ci] >= 0x80 {
                  dec_has_non_ascii = true
                  break
                }
                ci = ci + 1
              }
              if dn == 0 || !dec_has_non_ascii {
                let (fe, ec) = record_err(
                  first_err,
                  err_count,
                  IdnaErrorKind::InvalidPunycode,
                  "decoded punycode label is empty or ASCII-only",
                  li,
                )
                first_err = fe
                err_count = ec
              }
              let dec_nfc = nfc_normalize(dec)
              if !cps_equal(dec, dec_nfc) {
                let (fe, ec) = record_err(
                  first_err,
                  err_count,
                  IdnaErrorKind::PunycodeNotNfc,
                  "decoded punycode label is not in NFC",
                  li,
                )
                first_err = fe
                err_count = ec
              }
              if opts.check_hyphens {
                if !check_hyphens_label(dec) {
                  let (fe, ec) = record_err(
                    first_err,
                    err_count,
                    IdnaErrorKind::InvalidHyphens,
                    "invalid hyphen placement in decoded punycode label",
                    li,
                  )
                  first_err = fe
                  err_count = ec
                }
              } else if dn >= 4 && dec[0] == 120 && dec[1] == 110 && dec[2] == 45 && dec[3] == 45 {
                // UTS #46 §4.1 V4: if not CheckHyphens, label must not begin with "xn--".
                let (fe, ec) = record_err(
                  first_err,
                  err_count,
                  IdnaErrorKind::InvalidHyphens,
                  "decoded punycode label begins with xn--",
                  li,
                )
                first_err = fe
                err_count = ec
              }
              if dn > 0 && unicode_is_mark(dec[0]) {
                let (fe, ec) = record_err(
                  first_err,
                  err_count,
                  IdnaErrorKind::LeadingCombiningMark,
                  "decoded punycode label starts with combining mark",
                  li,
                )
                first_err = fe
                err_count = ec
              }
              let mut di = 0
              while di < dn {
                let cp = dec[di]
                if (cp == 46 || cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61) && opts.deny_dot_in_label {
                  let (fe, ec) = record_err(
                    first_err,
                    err_count,
                    IdnaErrorKind::DotInLabel,
                    "decoded punycode label contains dot separator",
                    li,
                  )
                  first_err = fe
                  err_count = ec
                } else if cp < 0x80 {
                  if opts.use_std3_ascii_rules && !is_std3_ascii_valid(cp) {
                    let (fe, ec) = record_err(
                      first_err,
                      err_count,
                      IdnaErrorKind::DisallowedCodePoint,
                      "disallowed STD3 ASCII code point in decoded punycode",
                      li,
                    )
                    first_err = fe
                    err_count = ec
                  }
                } else {
                  let v = uts46_lookup_fast(cp)
                  // UTS #46 §4.1: decoded punycode uses NonTransitional validity (valid or deviation)
                  if v != 1 && v != 5 {
                    let (fe, ec) = record_err(
                      first_err,
                      err_count,
                      IdnaErrorKind::DisallowedCodePoint,
                      "disallowed or unmapped code point in decoded punycode",
                      li,
                    )
                    first_err = fe
                    err_count = ec
                  }
                }
                di = di + 1
              }
              if opts.check_joiners && !check_joiners_label(dec) {
                let (fe, ec) = record_err(
                  first_err,
                  err_count,
                  IdnaErrorKind::InvalidJoiner,
                  "ContextJ joiner rule violated",
                  li,
                )
                first_err = fe
                err_count = ec
              }
              if opts.check_contexto && !check_contexto_label(dec) {
                let (fe, ec) = record_err(
                  first_err,
                  err_count,
                  IdnaErrorKind::InvalidContextO,
                  "ContextO rule violated",
                  li,
                )
                first_err = fe
                err_count = ec
              }
              labels.push(dec)
            }
          }
        }
      } else {
        if llen > limits.max_label_codepoints {
          return Err(
            IdnaError::new(
              IdnaErrorKind::LimitExceeded,
              "label exceeds max_label_codepoints",
              li,
            ),
          )
        }
        let lab : Array[Int] = []
        let mut has_joiner = false
        let mut has_contexto = false
        let mut j = ls
        while j < k {
          let cp = norm[j]
          if cp < 0x80 {
            if opts.use_std3_ascii_rules && !is_std3_ascii_valid(cp) {
              let (fe, ec) = record_err(
                first_err,
                err_count,
                IdnaErrorKind::DisallowedCodePoint,
                "disallowed STD3 ASCII code point",
                li,
              )
              first_err = fe
              err_count = ec
            }
          } else {
            let v = uts46_lookup_fast(cp)
            let ok_cp = if opts.transitional_processing { v == 1 } else { v == 1 || v == 5 }
            if !ok_cp {
              let (fe, ec) = record_err(
                first_err,
                err_count,
                IdnaErrorKind::DisallowedCodePoint,
                "disallowed code point in label",
                li,
              )
              first_err = fe
              err_count = ec
            }
            if cp == 0x200C || cp == 0x200D {
              has_joiner = true
            }
            if !has_contexto && opts.check_contexto && cp_is_contexto_char(cp) {
              has_contexto = true
            }
          }
          lab.push(cp)
          j = j + 1
        }
        if opts.check_hyphens && !check_hyphens_label(lab) {
          let (fe, ec) = record_err(
            first_err,
            err_count,
            IdnaErrorKind::InvalidHyphens,
            "invalid hyphen placement in label",
            li,
          )
          first_err = fe
          err_count = ec
        }
        if lab.length() > 0 && unicode_is_mark(lab[0]) {
          let (fe, ec) = record_err(
            first_err,
            err_count,
            IdnaErrorKind::LeadingCombiningMark,
            "label starts with combining mark",
            li,
          )
          first_err = fe
          err_count = ec
        }
        if opts.check_joiners && has_joiner && !check_joiners_label(lab) {
          let (fe, ec) = record_err(
            first_err,
            err_count,
            IdnaErrorKind::InvalidJoiner,
            "ContextJ joiner rule violated",
            li,
          )
          first_err = fe
          err_count = ec
        }
        if opts.check_contexto && has_contexto && !check_contexto_label(lab) {
          let (fe, ec) = record_err(
            first_err,
            err_count,
            IdnaErrorKind::InvalidContextO,
            "ContextO rule violated",
            li,
          )
          first_err = fe
          err_count = ec
        }
        labels.push(lab)
      }
      ls = k + 1
      li = li + 1
    }
    k = k + 1
  }
  if opts.check_bidi {
    let bad_bidi = check_bidi_domain(labels)
    if bad_bidi >= 0 {
      let (fe, ec) = record_err(
        first_err,
        err_count,
        IdnaErrorKind::InvalidBidi,
        "RFC 5893 Bidi rule violated",
        bad_bidi,
      )
      first_err = fe
      err_count = ec
    }
  }
  Ok(ProcessState::{ labels: labels, first_error: first_err, error_count: err_count })
}

///| Verify DNS length rules on ASCII output (UTS #46 §4.1 `VerifyDnsLength`).
fn verify_dns_length_ascii(ascii : String) -> Option[IdnaError] {
  let n = ascii.length()
  if n == 0 {
    return Some(IdnaError::new(IdnaErrorKind::EmptyInput, "empty domain", -1))
  }
  let eff_len = if n > 0 && ascii.code_unit_at(n - 1) == 46 { n - 1 } else { n }
  if eff_len == 0 {
    return Some(IdnaError::new(IdnaErrorKind::EmptyLabel, "empty root-only domain", 0))
  }
  if eff_len > 253 {
    return Some(
      IdnaError::new(IdnaErrorKind::DomainTooLong, "ASCII domain exceeds 253 bytes", -1),
    )
  }
  let mut ls = 0
  let mut i = 0
  let mut li = 0
  while i <= eff_len {
    if i == eff_len || ascii.code_unit_at(i) == 46 {
      let llen = i - ls
      if llen == 0 {
        return Some(IdnaError::new(IdnaErrorKind::EmptyLabel, "empty DNS label", li))
      }
      if llen > 63 {
        return Some(
          IdnaError::new(IdnaErrorKind::LabelTooLong, "DNS label exceeds 63 bytes", li),
        )
      }
      ls = i + 1
      li = li + 1
    }
    i = i + 1
  }
  None
}

///| UTS #46 `ToASCII` with full configurable `IdnaOptions` and `IdnaLimits`.
pub fn to_ascii(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> Result[String, IdnaError] {
  match check_limits_valid(limits) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let n = domain.length()
  if n > limits.max_input_bytes {
    return Err(
      IdnaError::new(IdnaErrorKind::LimitExceeded, "domain exceeds max_input_bytes", -1),
    )
  }
  if n == 0 {
    if opts.verify_dns_length {
      return Err(IdnaError::new(IdnaErrorKind::EmptyInput, "empty domain", -1))
    }
    return Ok("")
  }
  // Ultra-fast pure-ASCII zero-alloc scan
  let mut is_ascii = true
  let mut has_upper = false
  let mut has_xn = false
  let mut has_std3_bad = false
  let mut has_hyphen_bad = false
  let mut label_count = 1
  let mut label_start = 0
  let mut i = 0
  while i < n {
    let b = domain.code_unit_at(i)
    if b >= 0x80 {
      is_ascii = false
      break
    }
    if b == 46 {
      let llen = i - label_start
      if llen > limits.max_label_codepoints {
        return Err(
          IdnaError::new(
            IdnaErrorKind::LimitExceeded,
            "label exceeds max_label_codepoints",
            label_count - 1,
          ),
        )
      }
      if label_is_punycode_ascii(domain, label_start, i) {
        has_xn = true
      } else if opts.check_hyphens && llen > 0 {
        if domain.code_unit_at(label_start) == 45 ||
        domain.code_unit_at(i - 1) == 45 ||
        (llen >= 4 &&
          domain.code_unit_at(label_start + 2) == 45 &&
          domain.code_unit_at(label_start + 3) == 45) {
          has_hyphen_bad = true
        }
      }
      label_count = label_count + 1
      if label_count > limits.max_labels {
        return Err(
          IdnaError::new(IdnaErrorKind::LimitExceeded, "domain exceeds max_labels", label_count - 1),
        )
      }
      label_start = i + 1
    } else if b >= 65 && b <= 90 {
      has_upper = true
    } else if !((b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45) {
      has_std3_bad = true
    }
    i = i + 1
  }
  if is_ascii {
    let last_llen = n - label_start
    if last_llen > limits.max_label_codepoints {
      return Err(
        IdnaError::new(
          IdnaErrorKind::LimitExceeded,
          "label exceeds max_label_codepoints",
          label_count - 1,
        ),
      )
    }
    if label_is_punycode_ascii(domain, label_start, n) {
      has_xn = true
    } else if opts.check_hyphens && last_llen > 0 {
      if domain.code_unit_at(label_start) == 45 ||
      domain.code_unit_at(n - 1) == 45 ||
      (last_llen >= 4 &&
        domain.code_unit_at(label_start + 2) == 45 &&
        domain.code_unit_at(label_start + 3) == 45) {
        has_hyphen_bad = true
      }
    }
    if !has_xn {
      if opts.use_std3_ascii_rules && has_std3_bad {
        return Err(
          IdnaError::new(IdnaErrorKind::DisallowedCodePoint, "disallowed STD3 ASCII code point", -1),
        )
      }
      if opts.check_hyphens && has_hyphen_bad {
        return Err(
          IdnaError::new(IdnaErrorKind::InvalidHyphens, "invalid hyphen placement in label", -1),
        )
      }
      let res = if !has_upper {
        domain
      } else {
        let sb = StringBuilder::with_capacity(n)
        let mut k = 0
        while k < n {
          let b = domain.code_unit_at(k)
          if b >= 65 && b <= 90 {
            sb.write_byte((b + 32).to_byte())
          } else {
            sb.write_byte(b.to_byte())
          }
          k = k + 1
        }
        sb.to_string()
      }
      if opts.verify_dns_length {
        match verify_dns_length_ascii(res) {
          Some(e) => return Err(e)
          None => ()
        }
      }
      return Ok(res)
    }
  }
  // Fast non-ASCII single-FixedArray path for common already-NFC, non-Bidi, non-Joiner, non-ContextO, non-xn-- IDNs
  if !is_ascii {
    let mapped : FixedArray[Int] = FixedArray::make(n + 4, 0)
    let mut total = 0
    let mut ok_fast = true
    let mut pos = 0
    while pos < n {
      let (cp, next, ok_utf8) = decode_utf8_strict(domain, pos, n)
      if !ok_utf8 {
        return Err(
          IdnaError::new(IdnaErrorKind::InvalidUtf8, "invalid UTF-8 in domain", -1),
        )
      }
      pos = next
      if cp < 0x80 {
        let c = if cp >= 65 && cp <= 90 { cp + 32 } else { cp }
        if c != 46 && opts.use_std3_ascii_rules && !is_std3_ascii_valid(c) {
          ok_fast = false
          break
        }
        if total >= mapped.length() {
          ok_fast = false
          break
        }
        mapped[total] = c
        total = total + 1
      } else {
        let v = uts46_lookup_fast(cp)
        if v == 0 {
          return Err(
            IdnaError::new(IdnaErrorKind::DisallowedCodePoint, "disallowed code point in domain", -1),
          )
        } else if v == 1 {
          if cp_may_need_nfc(cp) ||
          (opts.check_bidi && cp_may_be_rtl(cp)) ||
          (opts.check_contexto && cp_is_contexto_char(cp)) {
            ok_fast = false
            break
          }
          if total >= mapped.length() {
            ok_fast = false
            break
          }
          mapped[total] = cp
          total = total + 1
        } else if v == 2 {
          continue
        } else if (v & 7) == 3 {
          let m = cp + (v >> 3)
          if opts.transitional_processing && (m == 0x00DF || m == 0x03C2 || m == 0x200C || m == 0x200D) {
            ok_fast = false
            break
          }
          if m < 0x80 {
            if m != 46 && opts.use_std3_ascii_rules && !is_std3_ascii_valid(m) {
              ok_fast = false
              break
            }
          } else if cp_may_need_nfc(m) ||
          (opts.check_bidi && cp_may_be_rtl(m)) ||
          (opts.check_contexto && cp_is_contexto_char(m)) {
            ok_fast = false
            break
          }
          if total >= mapped.length() {
            ok_fast = false
            break
          }
          mapped[total] = m
          total = total + 1
        } else {
          ok_fast = false
          break
        }
      }
    }
    if ok_fast && total > 0 {
      let mut ls = 0
      let mut k = 0
      let mut li = 0
      while k <= total {
        if k == total || mapped[k] == 46 {
          if li >= limits.max_labels {
            return Err(
              IdnaError::new(IdnaErrorKind::LimitExceeded, "domain exceeds max_labels", li),
            )
          }
          let llen = k - ls
          if llen > limits.max_label_codepoints {
            return Err(
              IdnaError::new(
                IdnaErrorKind::LimitExceeded,
                "label exceeds max_label_codepoints",
                li,
              ),
            )
          }
          if llen > 0 && unicode_is_mark(mapped[ls]) {
            return Err(
              IdnaError::new(
                IdnaErrorKind::LeadingCombiningMark,
                "label starts with combining mark",
                li,
              ),
            )
          }
          if llen >= 4 &&
          mapped[ls] == 120 &&
          mapped[ls + 1] == 110 &&
          mapped[ls + 2] == 45 &&
          mapped[ls + 3] == 45 {
            ok_fast = false
            break
          }
          if opts.check_hyphens && llen > 0 {
            if mapped[ls] == 45 ||
            mapped[k - 1] == 45 ||
            (llen >= 4 && mapped[ls + 2] == 45 && mapped[ls + 3] == 45) {
              return Err(
                IdnaError::new(IdnaErrorKind::InvalidHyphens, "invalid hyphen placement in label", li),
              )
            }
          }
          ls = k + 1
          li = li + 1
        }
        k = k + 1
      }
      if ok_fast {
        let out = StringBuilder::with_capacity(total * 2 + 16)
        ls = 0
        k = 0
        li = 0
        while k <= total {
          if k == total || mapped[k] == 46 {
            if ls > 0 {
              out.write_byte((46).to_byte())
            }
            let mut label_has_non_ascii = false
            let mut j = ls
            while j < k {
              if mapped[j] >= 0x80 {
                label_has_non_ascii = true
                break
              }
              j = j + 1
            }
            if label_has_non_ascii {
              out.write_string("xn--")
              match punycode_encode_fixed_range(out, mapped, ls, k, li) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
            } else {
              j = ls
              while j < k {
                out.write_byte(mapped[j].to_byte())
                j = j + 1
              }
            }
            ls = k + 1
            li = li + 1
          }
          k = k + 1
        }
        let res = out.to_string()
        if opts.verify_dns_length {
          match verify_dns_length_ascii(res) {
            Some(e) => return Err(e)
            None => ()
          }
        }
        return Ok(res)
      }
    }
  }
  // Full UTS #46 path
  let state = match uts46_process(domain, opts, limits) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  match state.first_error {
    Some(e) => return Err(e)
    None => ()
  }
  let labels = state.labels
  let num_labels = labels.length()
  let out = StringBuilder::with_capacity(n + 16)
  let mut li = 0
  while li < num_labels {
    if li > 0 {
      out.write_byte((46).to_byte())
    }
    let lab = labels[li]
    let ln = lab.length()
    let mut has_non_ascii = false
    let mut j = 0
    while j < ln {
      if lab[j] >= 0x80 {
        has_non_ascii = true
        break
      }
      j = j + 1
    }
    if has_non_ascii {
      out.write_string("xn--")
      match punycode_encode_cps_range(out, lab, 0, ln, li) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      j = 0
      while j < ln {
        out.write_byte(lab[j].to_byte())
        j = j + 1
      }
    }
    li = li + 1
  }
  let res = out.to_string()
  if opts.verify_dns_length {
    match verify_dns_length_ascii(res) {
      Some(e) => return Err(e)
      None => ()
    }
  }
  Ok(res)
}

///| UTS #46 `ToASCII` with `IdnaOptions::uts46_strict()` and `IdnaLimits::default()`.
pub fn to_ascii_default(domain : String) -> Result[String, IdnaError] {
  to_ascii(domain, IdnaOptions::uts46_strict(), IdnaLimits::default())
}

///| UTS #46 `ToUnicode` (UTS #46 §4.2): always returns best-effort Unicode output along with
///| validity flag, first error, and total error count.
pub fn to_unicode(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> UnicodeResult {
  match check_limits_valid(limits) {
    Ok(_) => ()
    Err(e) => {
      return UnicodeResult::{
        output: domain,
        is_valid: false,
        first_error: Some(e),
        error_count: 1,
      }
    }
  }
  let n = domain.length()
  if n > limits.max_input_bytes {
    return UnicodeResult::{
      output: domain,
      is_valid: false,
      first_error: Some(
        IdnaError::new(IdnaErrorKind::LimitExceeded, "domain exceeds max_input_bytes", -1),
      ),
      error_count: 1,
    }
  }
  if n == 0 {
    return UnicodeResult::{
      output: "",
      is_valid: true,
      first_error: None,
      error_count: 0,
    }
  }
  // Fast pure-ASCII zero-alloc scan when no `xn--` and all checks pass
  let mut is_ascii = true
  let mut has_upper = false
  let mut has_xn = false
  let mut has_err = false
  let mut label_count = 1
  let mut label_start = 0
  let mut i = 0
  while i < n {
    let b = domain.code_unit_at(i)
    if b >= 0x80 {
      is_ascii = false
      break
    }
    if b == 46 {
      let llen = i - label_start
      if llen > limits.max_label_codepoints {
        return UnicodeResult::{
          output: domain,
          is_valid: false,
          first_error: Some(
            IdnaError::new(
              IdnaErrorKind::LimitExceeded,
              "label exceeds max_label_codepoints",
              label_count - 1,
            ),
          ),
          error_count: 1,
        }
      }
      if label_is_punycode_ascii(domain, label_start, i) {
        has_xn = true
      } else if opts.check_hyphens && llen > 0 {
        if domain.code_unit_at(label_start) == 45 ||
        domain.code_unit_at(i - 1) == 45 ||
        (llen >= 4 &&
          domain.code_unit_at(label_start + 2) == 45 &&
          domain.code_unit_at(label_start + 3) == 45) {
          has_err = true
        }
      }
      label_count = label_count + 1
      if label_count > limits.max_labels {
        return UnicodeResult::{
          output: domain,
          is_valid: false,
          first_error: Some(
            IdnaError::new(
              IdnaErrorKind::LimitExceeded,
              "domain exceeds max_labels",
              label_count - 1,
            ),
          ),
          error_count: 1,
        }
      }
      label_start = i + 1
    } else if b >= 65 && b <= 90 {
      has_upper = true
    } else if opts.use_std3_ascii_rules && !((b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45) {
      has_err = true
    }
    i = i + 1
  }
  if is_ascii && !has_xn && !has_err {
    let last_llen = n - label_start
    if last_llen > limits.max_label_codepoints {
      return UnicodeResult::{
        output: domain,
        is_valid: false,
        first_error: Some(
          IdnaError::new(
            IdnaErrorKind::LimitExceeded,
            "label exceeds max_label_codepoints",
            label_count - 1,
          ),
        ),
        error_count: 1,
      }
    }
    let last_xn = label_is_punycode_ascii(domain, label_start, n)
    let last_hyph_bad = opts.check_hyphens &&
    last_llen > 0 &&
    (domain.code_unit_at(label_start) == 45 ||
      domain.code_unit_at(n - 1) == 45 ||
      (last_llen >= 4 &&
        domain.code_unit_at(label_start + 2) == 45 &&
        domain.code_unit_at(label_start + 3) == 45))
    if !last_xn && !last_hyph_bad {
      let out = if !has_upper {
        domain
      } else {
        let sb = StringBuilder::with_capacity(n)
        let mut k = 0
        while k < n {
          let b = domain.code_unit_at(k)
          if b >= 65 && b <= 90 {
            sb.write_byte((b + 32).to_byte())
          } else {
            sb.write_byte(b.to_byte())
          }
          k = k + 1
        }
        sb.to_string()
      }
      return UnicodeResult::{
        output: out,
        is_valid: true,
        first_error: None,
        error_count: 0,
      }
    }
  }
  // UTS #46 §4.2: ToUnicode always uses NonTransitional processing for decoding/validation
  let uni_opts = IdnaOptions::{
    use_std3_ascii_rules: opts.use_std3_ascii_rules,
    check_hyphens: opts.check_hyphens,
    check_bidi: opts.check_bidi,
    check_joiners: opts.check_joiners,
    check_contexto: opts.check_contexto,
    verify_dns_length: false,
    transitional_processing: false,
    ignore_invalid_punycode: opts.ignore_invalid_punycode,
    deny_dot_in_label: opts.deny_dot_in_label,
  }
  match uts46_process(domain, uni_opts, limits) {
    Err(e) => {
      UnicodeResult::{
        output: domain,
        is_valid: false,
        first_error: Some(e),
        error_count: 1,
      }
    }
    Ok(state) => {
      let labels = state.labels
      let num_labels = labels.length()
      let sb = StringBuilder::with_capacity(domain.length() + 16)
      let mut li = 0
      while li < num_labels {
        if li > 0 {
          sb.write_byte((46).to_byte())
        }
        let lab = labels[li]
        let ln = lab.length()
        let mut j = 0
        while j < ln {
          write_utf8_cp(sb, lab[j])
          j = j + 1
        }
        li = li + 1
      }
      UnicodeResult::{
        output: sb.to_string(),
        is_valid: state.error_count == 0,
        first_error: state.first_error,
        error_count: state.error_count,
      }
    }
  }
}

///| UTS #46 `ToUnicode` with `IdnaOptions::uts46_strict()` and `IdnaLimits::default()`.
pub fn to_unicode_default(domain : String) -> UnicodeResult {
  to_unicode(domain, IdnaOptions::uts46_strict(), IdnaLimits::default())
}

///| Convert a single domain label (must not contain `.` or UTS #46 dot separators) to ASCII.
pub fn label_to_ascii(
  label : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> Result[String, IdnaError] {
  let n = label.length()
  let mut pos = 0
  while pos < n {
    let (cp, next, ok) = decode_utf8_strict(label, pos, n)
    if !ok {
      return Err(IdnaError::new(IdnaErrorKind::InvalidUtf8, "invalid UTF-8 in label", 0))
    }
    if cp == 0x002E || cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61 {
      return Err(IdnaError::new(IdnaErrorKind::DotInLabel, "label contains dot separator", 0))
    }
    pos = next
  }
  to_ascii(label, opts, limits)
}

///| Convert a single domain label to Unicode (best-effort with error reporting).
pub fn label_to_unicode(
  label : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> UnicodeResult {
  let n = label.length()
  let mut pos = 0
  while pos < n {
    let (cp, next, ok) = decode_utf8_strict(label, pos, n)
    if !ok {
      return UnicodeResult::{
        output: label,
        is_valid: false,
        first_error: Some(IdnaError::new(IdnaErrorKind::InvalidUtf8, "invalid UTF-8 in label", 0)),
        error_count: 1,
      }
    }
    if cp == 0x002E || cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61 {
      return UnicodeResult::{
        output: label,
        is_valid: false,
        first_error: Some(
          IdnaError::new(IdnaErrorKind::DotInLabel, "label contains dot separator", 0),
        ),
        error_count: 1,
      }
    }
    pos = next
  }
  to_unicode(label, opts, limits)
}
