///| Full configurable Unicode 16.0.0 UTS #46 + IDNA2008 (RFC 5891 / 5892 / 5893) engine.

fn is_std3_ascii_valid(cp : Int) -> Bool {
  (cp >= 97 && cp <= 122) || (cp >= 48 && cp <= 57) || cp == 45
}

fn cp_may_be_rtl(cp : Int) -> Bool {
  if cp < 0x0590 {
    return false
  }
  if cp < 4096 {
    return (low_props_lut[cp] & 2) != 0
  }
  if (cp >= 0x4E00 && cp <= 0x9FFF) ||
  (cp >= 0xAC00 && cp <= 0xD7A3) ||
  (cp >= 0x3041 && cp <= 0x3096) ||
  (cp >= 0x30A1 && cp <= 0x30FA) {
    return false
  }
  let bc = unicode_bidi_class(cp)
  bc == 1 || bc == 2 || bc == 6
}

fn cp_is_contexto_char(cp : Int) -> Bool {
  cp == 0x00B7 ||
  cp == 0x0375 ||
  cp == 0x05F3 ||
  cp == 0x05F4 ||
  cp == 0x30FB ||
  (cp >= 0x0660 && cp <= 0x0669) ||
  (cp >= 0x06F0 && cp <= 0x06F9)
}

///| RFC 5892 ContextJ: ZWNJ (U+200C) and ZWJ (U+200D) rules.
fn check_joiners_label(label : Array[Int]) -> Bool {
  let n = label.length()
  let mut i = 0
  while i < n {
    let cp = label[i]
    if cp == 0x200D {
      if i == 0 || unicode_ccc(label[i - 1]) != 9 {
        return false
      }
    } else if cp == 0x200C {
      if i > 0 && unicode_ccc(label[i - 1]) == 9 {
        i = i + 1
        continue
      }
      let mut j = i - 1
      while j >= 0 && unicode_joining_type(label[j]) == 4 {
        j = j - 1
      }
      if j < 0 {
        return false
      }
      let jtl = unicode_joining_type(label[j])
      if jtl != 1 && jtl != 3 {
        return false
      }
      let mut k = i + 1
      while k < n && unicode_joining_type(label[k]) == 4 {
        k = k + 1
      }
      if k >= n {
        return false
      }
      let jtr = unicode_joining_type(label[k])
      if jtr != 2 && jtr != 3 {
        return false
      }
    }
    i = i + 1
  }
  true
}

///| RFC 5892 ContextO rules (Appendix A.3–A.9):
///| - U+00B7 MIDDLE DOT: preceded by 'l' and followed by 'l'
///| - U+0375 GREEK LOWER NUMERAL SIGN (KERAIA): followed by Script=Greek
///| - U+05F3/U+05F4 HEBREW GERESH/GERSHAYIM: preceded by Script=Hebrew
///| - U+30FB KATAKANA MIDDLE DOT: label contains Hiragana, Katakana, or Han
///| - U+0660..0669 vs U+06F0..06F9: Arabic-Indic and Extended Arabic-Indic digits cannot mix
fn check_contexto_label(label : Array[Int]) -> Bool {
  let n = label.length()
  let mut has_arabic_indic = false
  let mut has_ext_arabic_indic = false
  let mut has_katakana_dot = false
  let mut has_cjk_kana = false
  let mut i = 0
  while i < n {
    let cp = label[i]
    if cp == 0x00B7 {
      if i == 0 || i + 1 >= n || label[i - 1] != 0x006C || label[i + 1] != 0x006C {
        return false
      }
    } else if cp == 0x0375 {
      if i + 1 >= n || unicode_script_id(label[i + 1]) != 3 {
        return false
      }
    } else if cp == 0x05F3 || cp == 0x05F4 {
      if i == 0 || unicode_script_id(label[i - 1]) != 10 {
        return false
      }
    } else if cp == 0x30FB {
      has_katakana_dot = true
    } else if cp >= 0x0660 && cp <= 0x0669 {
      has_arabic_indic = true
    } else if cp >= 0x06F0 && cp <= 0x06F9 {
      has_ext_arabic_indic = true
    }
    if !has_cjk_kana && cp >= 0x80 {
      let sid = unicode_script_id(cp)
      if sid == 5 || sid == 6 || sid == 7 {
        has_cjk_kana = true
      }
    }
    i = i + 1
  }
  if has_arabic_indic && has_ext_arabic_indic {
    return false
  }
  if has_katakana_dot && !has_cjk_kana {
    return false
  }
  true
}

///| RFC 5893 Bidi Rule 1–6 across all labels in a domain.
fn check_bidi_domain(labels : Array[Array[Int]]) -> Int {
  let num_labels = labels.length()
  let mut is_bidi = false
  let mut li = 0
  while li < num_labels && !is_bidi {
    let lab = labels[li]
    let ln = lab.length()
    let mut i = 0
    while i < ln {
      let bc = unicode_bidi_class(lab[i])
      if bc == 1 || bc == 2 || bc == 6 {
        is_bidi = true
        break
      }
      i = i + 1
    }
    li = li + 1
  }
  if !is_bidi {
    return -1
  }
  li = 0
  while li < num_labels {
    let lab = labels[li]
    let ln = lab.length()
    if ln == 0 {
      li = li + 1
      continue
    }
    let bc0 = unicode_bidi_class(lab[0])
    if bc0 == 1 || bc0 == 2 {
      let mut has_en = false
      let mut has_an = false
      let mut i = 0
      while i < ln {
        let bc = unicode_bidi_class(lab[i])
        if bc == 0 || bc >= 11 {
          return li
        }
        if bc == 3 {
          has_en = true
        } else if bc == 6 {
          has_an = true
        }
        i = i + 1
      }
      if has_en && has_an {
        return li
      }
      let mut last = ln - 1
      while last >= 0 && unicode_bidi_class(lab[last]) == 8 {
        last = last - 1
      }
      if last < 0 {
        return li
      }
      let lbc = unicode_bidi_class(lab[last])
      if lbc != 1 && lbc != 2 && lbc != 3 && lbc != 6 {
        return li
      }
    } else if bc0 == 0 {
      let mut i = 0
      while i < ln {
        let bc = unicode_bidi_class(lab[i])
        if bc == 1 || bc == 2 || bc == 6 || bc >= 11 {
          return li
        }
        i = i + 1
      }
      let mut last = ln - 1
      while last >= 0 && unicode_bidi_class(lab[last]) == 8 {
        last = last - 1
      }
      if last < 0 {
        return li
      }
      let lbc = unicode_bidi_class(lab[last])
      if lbc != 0 && lbc != 3 {
        return li
      }
    } else {
      return li
    }
    li = li + 1
  }
  -1
}

fn check_hyphens_label(lab : Array[Int]) -> Bool {
  let ln = lab.length()
  if ln == 0 {
    return true
  }
  if lab[0] == 45 || lab[ln - 1] == 45 {
    return false
  }
  if ln >= 4 && lab[2] == 45 && lab[3] == 45 {
    return false
  }
  true
}

fn label_is_punycode_ascii(s : String, start : Int, end : Int) -> Bool {
  if end - start < 4 {
    return false
  }
  let b0 = s.code_unit_at(start)
  let b1 = s.code_unit_at(start + 1)
  let b2 = s.code_unit_at(start + 2)
  let b3 = s.code_unit_at(start + 3)
  (b0 == 120 || b0 == 88) &&
  (b1 == 110 || b1 == 78) &&
  b2 == 45 &&
  b3 == 45
}

struct ProcessState {
  labels : Array[Array[Int]]
  first_error : Option[IdnaError]
  error_count : Int
}

fn record_err(
  first_err : Option[IdnaError],
  err_count : Int,
  kind : IdnaErrorKind,
  msg : String,
  label_index : Int,
) -> (Option[IdnaError], Int) {
  let next_first = match first_err {
    Some(_) => first_err
    None => Some(IdnaError::new(kind, msg, label_index))
  }
  (next_first, err_count + 1)
}

///| Core UTS #46 §4 `Processing` algorithm returning labels + error state.
fn uts46_process(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> Result[ProcessState, IdnaError] {
  if limits.max_input_bytes < 0 ||
  limits.max_labels < 0 ||
  limits.max_label_codepoints < 0 ||
  limits.max_punycode_input < 0 {
    return Err(
      IdnaError::{ kind: IdnaErrorKind::LimitExceeded, message: "negative IdnaLimits value", label_index: -1 },
    )
  }
  let d_len = domain.length()
  if d_len > limits.max_input_bytes {
    return Err(
      IdnaError::{ kind: IdnaErrorKind::LimitExceeded, message: "domain exceeds max_input_bytes", label_index: -1 },
    )
  }
  let mapped : Array[Int] = Array::with_capacity(d_len)
  let lut = low_uts46_lut
  let props = low_props_lut
  let pool = idna_pool
  let mut needs_nfc = false
  let mut has_potential_rtl = false
  let mut first_err : Option[IdnaError] = None
  let mut err_count = 0
  let mut cur_label_cps = 0
  let mut cur_labels = 1
  // Pre-NFC upper bound per label: canonical composition shrinks by at most 4x.
  let max_pre_nfc_label_cps = if limits.max_label_codepoints > 0x1FFFFFFF {
    0x7FFFFFFF
  } else {
    limits.max_label_codepoints * 4
  }
  let mut pos = 0
  while pos < d_len {
    let b0 = domain.code_unit_at(pos)
    if b0 < 0x80 {
      pos = pos + 1
      let c = if b0 >= 65 && b0 <= 90 { b0 + 32 } else { b0 }
      if c == 46 {
        cur_label_cps = 0
        cur_labels = cur_labels + 1
        if cur_labels > limits.max_labels {
          return Err(
            IdnaError::{
              kind: IdnaErrorKind::LimitExceeded,
              message: "domain exceeds max_labels",
              label_index: cur_labels - 1,
            },
          )
        }
      } else {
        cur_label_cps = cur_label_cps + 1
        if cur_label_cps > max_pre_nfc_label_cps {
          return Err(
            IdnaError::{
              kind: IdnaErrorKind::LimitExceeded,
              message: "label exceeds max_label_codepoints",
              label_index: cur_labels - 1,
            },
          )
        }
      }
      mapped.push(c)
    } else {
      let r = decode_utf8_non_ascii(domain, pos, d_len)
      if r < 0 {
        return Err(
          IdnaError::{ kind: IdnaErrorKind::InvalidUtf8, message: "invalid UTF-8 in domain", label_index: -1 },
        )
      }
      let cp = r & 0x1FFFFF
      pos = pos + (r >> 21)
      let v = if cp < 4096 {
        lut[cp]
      } else if (cp >= 0x4E00 && cp <= 0x9FFF) ||
      (cp >= 0xAC00 && cp <= 0xD7A3) ||
      (cp >= 0x3041 && cp <= 0x3096) ||
      (cp >= 0x30A1 && cp <= 0x30FA) {
        1
      } else {
        uts46_lookup(cp)
      }
      if v == 0 {
        let (fe, ec) = record_err(
          first_err,
          err_count,
          IdnaErrorKind::DisallowedCodePoint,
          "disallowed code point in domain",
          -1,
        )
        first_err = fe
        err_count = ec
        if !has_potential_rtl && cp >= 0x0590 {
          if cp < 4096 {
            if (props[cp] & 2) != 0 {
              has_potential_rtl = true
            }
          } else if cp_may_be_rtl(cp) {
            has_potential_rtl = true
          }
        }
        cur_label_cps = cur_label_cps + 1
        if cur_label_cps > max_pre_nfc_label_cps {
          return Err(
            IdnaError::{
              kind: IdnaErrorKind::LimitExceeded,
              message: "label exceeds max_label_codepoints",
              label_index: cur_labels - 1,
            },
          )
        }
        mapped.push(cp)
      } else if v == 1 {
        if cp < 4096 {
          let p = props[cp]
          if !needs_nfc && (p & 1) != 0 {
            needs_nfc = true
          }
          if !has_potential_rtl && (p & 2) != 0 {
            has_potential_rtl = true
          }
        } else if !((cp >= 0x4E00 && cp <= 0x9FFF) ||
          (cp >= 0xAC00 && cp <= 0xD7A3) ||
          (cp >= 0x3041 && cp <= 0x3096) ||
          (cp >= 0x30A1 && cp <= 0x30FA)) {
          if !needs_nfc && cp_may_need_nfc(cp) {
            needs_nfc = true
          }
          if !has_potential_rtl && cp_may_be_rtl(cp) {
            has_potential_rtl = true
          }
        }
        cur_label_cps = cur_label_cps + 1
        if cur_label_cps > max_pre_nfc_label_cps {
          return Err(
            IdnaError::{
              kind: IdnaErrorKind::LimitExceeded,
              message: "label exceeds max_label_codepoints",
              label_index: cur_labels - 1,
            },
          )
        }
        mapped.push(cp)
      } else if v == 2 {
        continue
      } else if v == 5 {
        // Deviation: U+00DF, U+03C2, U+200C, U+200D
        if opts.transitional_processing {
          if cp == 0x00DF {
            mapped.push(0x0073)
            mapped.push(0x0073)
            cur_label_cps = cur_label_cps + 2
          } else if cp == 0x03C2 {
            mapped.push(0x03C3)
            cur_label_cps = cur_label_cps + 1
          }
          // 0x200C and 0x200D are mapped to empty in transitional processing
        } else {
          mapped.push(cp)
          cur_label_cps = cur_label_cps + 1
        }
        if cur_label_cps > max_pre_nfc_label_cps {
          return Err(
            IdnaError::{
              kind: IdnaErrorKind::LimitExceeded,
              message: "label exceeds max_label_codepoints",
              label_index: cur_labels - 1,
            },
          )
        }
      } else if (v & 7) == 3 {
        let m = cp + (v >> 3)
        if opts.transitional_processing && (m == 0x00DF || m == 0x03C2 || m == 0x200C || m == 0x200D) {
          // Mapping target is a deviation character (e.g. U+1E9E ẞ -> U+00DF -> "ss").
          if m == 0x00DF {
            mapped.push(0x0073)
            mapped.push(0x0073)
            cur_label_cps = cur_label_cps + 2
          } else if m == 0x03C2 {
            mapped.push(0x03C3)
            cur_label_cps = cur_label_cps + 1
          }
        } else {
          if m == 46 {
            cur_label_cps = 0
            cur_labels = cur_labels + 1
            if cur_labels > limits.max_labels {
              return Err(
                IdnaError::{
                  kind: IdnaErrorKind::LimitExceeded,
                  message: "domain exceeds max_labels",
                  label_index: cur_labels - 1,
                },
              )
            }
          } else {
            cur_label_cps = cur_label_cps + 1
          }
          if !needs_nfc && cp_may_need_nfc(m) {
            needs_nfc = true
          }
          if !has_potential_rtl && cp_may_be_rtl(m) {
            has_potential_rtl = true
          }
          mapped.push(m)
        }
        if cur_label_cps > max_pre_nfc_label_cps {
          return Err(
            IdnaError::{
              kind: IdnaErrorKind::LimitExceeded,
              message: "label exceeds max_label_codepoints",
              label_index: cur_labels - 1,
            },
          )
        }
      } else {
        let off = (v >> 3) & 0xFFFF
        let mlen = v >> 19
        let mut k = 0
        while k < mlen {
          let m = pool[off + k]
          if opts.transitional_processing && (m == 0x00DF || m == 0x03C2 || m == 0x200C || m == 0x200D) {
            if m == 0x00DF {
              mapped.push(0x0073)
              mapped.push(0x0073)
              cur_label_cps = cur_label_cps + 2
            } else if m == 0x03C2 {
              mapped.push(0x03C3)
              cur_label_cps = cur_label_cps + 1
            }
          } else {
            if m == 46 {
              cur_label_cps = 0
              cur_labels = cur_labels + 1
              if cur_labels > limits.max_labels {
                return Err(
                  IdnaError::{
                    kind: IdnaErrorKind::LimitExceeded,
                    message: "domain exceeds max_labels",
                    label_index: cur_labels - 1,
                  },
                )
              }
            } else {
              cur_label_cps = cur_label_cps + 1
            }
            if !needs_nfc && cp_may_need_nfc(m) {
              needs_nfc = true
            }
            if !has_potential_rtl && cp_may_be_rtl(m) {
              has_potential_rtl = true
            }
            mapped.push(m)
          }
          if cur_label_cps > max_pre_nfc_label_cps {
            return Err(
              IdnaError::{
                kind: IdnaErrorKind::LimitExceeded,
                message: "label exceeds max_label_codepoints",
                label_index: cur_labels - 1,
              },
            )
          }
          k = k + 1
        }
      }
    }
  }
  let norm = if needs_nfc { nfc_normalize(mapped) } else { mapped }
  let norm_len = norm.length()
  let labels : Array[Array[Int]] = Array::with_capacity(cur_labels)
  let mut ls = 0
  let mut k = 0
  let mut li = 0
  while k <= norm_len {
    if k == norm_len || norm[k] == 46 {
      if li >= limits.max_labels {
        return Err(
          IdnaError::new(IdnaErrorKind::LimitExceeded, "domain exceeds max_labels", li),
        )
      }
      let llen = k - ls
      let is_xn = llen >= 4 &&
      norm[ls] == 120 &&
      norm[ls + 1] == 110 &&
      norm[ls + 2] == 45 &&
      norm[ls + 3] == 45
      if is_xn {
        let mut has_non_ascii_in_xn = false
        let mut j = ls
        while j < k {
          if norm[j] >= 0x80 {
            has_non_ascii_in_xn = true
            break
          }
          j = j + 1
        }
        if has_non_ascii_in_xn {
          let raw_lab : Array[Int] = []
          j = ls
          while j < k {
            raw_lab.push(norm[j])
            j = j + 1
          }
          // UTS #46 §4 step 4.1.1: a non-ASCII xn-- label is always an error regardless of IgnoreInvalidPunycode.
          let (fe, ec) = record_err(
            first_err,
            err_count,
            IdnaErrorKind::InvalidPunycode,
            "non-ASCII character in xn-- label",
            li,
          )
          first_err = fe
          err_count = ec
          labels.push(raw_lab)
        } else {
          let mut dec_opt : Option[Array[Int]] = None
          match punycode_decode_cp_slice(norm, ls + 4, k, limits, true, li) {
            Err(e) => {
              if e.kind.eq(IdnaErrorKind::LimitExceeded) {
                return Err(e)
              }
              let raw_lab : Array[Int] = []
              j = ls
              while j < k {
                raw_lab.push(norm[j])
                j = j + 1
              }
              if !opts.ignore_invalid_punycode {
                let (fe, ec) = record_err(first_err, err_count, e.kind, e.message, li)
                first_err = fe
                err_count = ec
                labels.push(raw_lab)
              } else {
                // UTS #46 §4 step 4.1: IgnoreInvalidPunycode only waives Punycode conversion failure;
                // the label still proceeds through empty/ASCII-only and validity criteria (V1-V8).
                dec_opt = Some(raw_lab)
              }
            }
            Ok(d) => dec_opt = Some(d)
          }
          match dec_opt {
            None => ()
            Some(dec) => {
              let dn = dec.length()
              let mut dec_has_non_ascii = false
              let mut dec_may_need_nfc = false
              let mut ci = 0
              while ci < dn {
                let dcp = dec[ci]
                if dcp >= 0x80 {
                  dec_has_non_ascii = true
                  if dcp < 4096 {
                    let p = props[dcp]
                    if !dec_may_need_nfc && (p & 1) != 0 {
                      dec_may_need_nfc = true
                    }
                    if !has_potential_rtl && (p & 2) != 0 {
                      has_potential_rtl = true
                    }
                  } else if !((dcp >= 0x4E00 && dcp <= 0x9FFF) ||
                    (dcp >= 0xAC00 && dcp <= 0xD7A3) ||
                    (dcp >= 0x3041 && dcp <= 0x3096) ||
                    (dcp >= 0x30A1 && dcp <= 0x30FA)) {
                    if !dec_may_need_nfc && cp_may_need_nfc(dcp) {
                      dec_may_need_nfc = true
                    }
                    if !has_potential_rtl && cp_may_be_rtl(dcp) {
                      has_potential_rtl = true
                    }
                  }
                }
                ci = ci + 1
              }
              if dn == 0 || !dec_has_non_ascii {
                let (fe, ec) = record_err(
                  first_err,
                  err_count,
                  IdnaErrorKind::InvalidPunycode,
                  "decoded punycode label is empty or ASCII-only",
                  li,
                )
                first_err = fe
                err_count = ec
              }
              if dec_may_need_nfc {
                let dec_nfc = nfc_normalize(dec)
                if !cps_equal(dec, dec_nfc) {
                  let (fe, ec) = record_err(
                    first_err,
                    err_count,
                    IdnaErrorKind::PunycodeNotNfc,
                    "decoded punycode label is not in NFC",
                    li,
                  )
                  first_err = fe
                  err_count = ec
                }
              }
              if opts.check_hyphens {
                if !check_hyphens_label(dec) {
                  let (fe, ec) = record_err(
                    first_err,
                    err_count,
                    IdnaErrorKind::InvalidHyphens,
                    "invalid hyphen placement in decoded punycode label",
                    li,
                  )
                  first_err = fe
                  err_count = ec
                }
              } else if dn >= 4 && dec[0] == 120 && dec[1] == 110 && dec[2] == 45 && dec[3] == 45 {
                // UTS #46 §4.1 V4: if not CheckHyphens, label must not begin with "xn--".
                let (fe, ec) = record_err(
                  first_err,
                  err_count,
                  IdnaErrorKind::InvalidHyphens,
                  "decoded punycode label begins with xn--",
                  li,
                )
                first_err = fe
                err_count = ec
              }
              if dn > 0 && unicode_is_mark(dec[0]) {
                let (fe, ec) = record_err(
                  first_err,
                  err_count,
                  IdnaErrorKind::LeadingCombiningMark,
                  "decoded punycode label starts with combining mark",
                  li,
                )
                first_err = fe
                err_count = ec
              }
              let mut di = 0
              while di < dn {
                let cp = dec[di]
                if (cp == 46 || cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61) && opts.deny_dot_in_label {
                  let (fe, ec) = record_err(
                    first_err,
                    err_count,
                    IdnaErrorKind::DotInLabel,
                    "decoded punycode label contains dot separator",
                    li,
                  )
                  first_err = fe
                  err_count = ec
                } else if cp < 0x80 {
                  if opts.use_std3_ascii_rules && !is_std3_ascii_valid(cp) {
                    let (fe, ec) = record_err(
                      first_err,
                      err_count,
                      IdnaErrorKind::DisallowedCodePoint,
                      "disallowed STD3 ASCII code point in decoded punycode",
                      li,
                    )
                    first_err = fe
                    err_count = ec
                  }
                } else {
                  let v = if cp < 4096 {
                    lut[cp]
                  } else if (cp >= 0x4E00 && cp <= 0x9FFF) ||
                  (cp >= 0xAC00 && cp <= 0xD7A3) ||
                  (cp >= 0x3041 && cp <= 0x3096) ||
                  (cp >= 0x30A1 && cp <= 0x30FA) {
                    1
                  } else {
                    uts46_lookup(cp)
                  }
                  // UTS #46 §4.1: decoded punycode uses NonTransitional validity (valid or deviation)
                  if v != 1 && v != 5 {
                    let (fe, ec) = record_err(
                      first_err,
                      err_count,
                      IdnaErrorKind::DisallowedCodePoint,
                      "disallowed or unmapped code point in decoded punycode",
                      li,
                    )
                    first_err = fe
                    err_count = ec
                  }
                }
                di = di + 1
              }
              if opts.check_joiners && !check_joiners_label(dec) {
                let (fe, ec) = record_err(
                  first_err,
                  err_count,
                  IdnaErrorKind::InvalidJoiner,
                  "ContextJ joiner rule violated",
                  li,
                )
                first_err = fe
                err_count = ec
              }
              if opts.check_contexto && !check_contexto_label(dec) {
                let (fe, ec) = record_err(
                  first_err,
                  err_count,
                  IdnaErrorKind::InvalidContextO,
                  "ContextO rule violated",
                  li,
                )
                first_err = fe
                err_count = ec
              }
              labels.push(dec)
            }
          }
        }
      } else {
        if llen > limits.max_label_codepoints {
          return Err(
            IdnaError::{
              kind: IdnaErrorKind::LimitExceeded,
              message: "label exceeds max_label_codepoints",
              label_index: li,
            },
          )
        }
        let lab : Array[Int] = Array::with_capacity(llen)
        let mut has_joiner = false
        let mut has_contexto = false
        let mut j = ls
        while j < k {
          let cp = norm[j]
          if cp < 0x80 {
            if opts.use_std3_ascii_rules && !is_std3_ascii_valid(cp) {
              let (fe, ec) = record_err(
                first_err,
                err_count,
                IdnaErrorKind::DisallowedCodePoint,
                "disallowed STD3 ASCII code point",
                li,
              )
              first_err = fe
              err_count = ec
            }
          } else {
            let v = if cp < 4096 {
              lut[cp]
            } else if (cp >= 0x4E00 && cp <= 0x9FFF) ||
            (cp >= 0xAC00 && cp <= 0xD7A3) ||
            (cp >= 0x3041 && cp <= 0x3096) ||
            (cp >= 0x30A1 && cp <= 0x30FA) {
              1
            } else {
              uts46_lookup(cp)
            }
            let ok_cp = if opts.transitional_processing { v == 1 } else { v == 1 || v == 5 }
            if !ok_cp {
              let (fe, ec) = record_err(
                first_err,
                err_count,
                IdnaErrorKind::DisallowedCodePoint,
                "disallowed code point in label",
                li,
              )
              first_err = fe
              err_count = ec
            }
            if cp == 0x200C || cp == 0x200D {
              has_joiner = true
            }
            if !has_contexto && opts.check_contexto && cp_is_contexto_char(cp) {
              has_contexto = true
            }
          }
          lab.push(cp)
          j = j + 1
        }
        if opts.check_hyphens && !check_hyphens_label(lab) {
          let (fe, ec) = record_err(
            first_err,
            err_count,
            IdnaErrorKind::InvalidHyphens,
            "invalid hyphen placement in label",
            li,
          )
          first_err = fe
          err_count = ec
        }
        if lab.length() > 0 && unicode_is_mark(lab[0]) {
          let (fe, ec) = record_err(
            first_err,
            err_count,
            IdnaErrorKind::LeadingCombiningMark,
            "label starts with combining mark",
            li,
          )
          first_err = fe
          err_count = ec
        }
        if opts.check_joiners && has_joiner && !check_joiners_label(lab) {
          let (fe, ec) = record_err(
            first_err,
            err_count,
            IdnaErrorKind::InvalidJoiner,
            "ContextJ joiner rule violated",
            li,
          )
          first_err = fe
          err_count = ec
        }
        if opts.check_contexto && has_contexto && !check_contexto_label(lab) {
          let (fe, ec) = record_err(
            first_err,
            err_count,
            IdnaErrorKind::InvalidContextO,
            "ContextO rule violated",
            li,
          )
          first_err = fe
          err_count = ec
        }
        labels.push(lab)
      }
      ls = k + 1
      li = li + 1
    }
    k = k + 1
  }
  if opts.check_bidi && has_potential_rtl {
    let bad_bidi = check_bidi_domain(labels)
    if bad_bidi >= 0 {
      let (fe, ec) = record_err(
        first_err,
        err_count,
        IdnaErrorKind::InvalidBidi,
        "RFC 5893 Bidi rule violated",
        bad_bidi,
      )
      first_err = fe
      err_count = ec
    }
  }
  Ok(ProcessState::{ labels: labels, first_error: first_err, error_count: err_count })
}

///| Verify DNS length rules on ASCII output (UTS #46 §4.1 `VerifyDnsLength`).
fn verify_dns_length_ascii(ascii : String) -> Option[IdnaError] {
  let n = ascii.length()
  if n == 0 {
    return Some(IdnaError::new(IdnaErrorKind::EmptyInput, "empty domain", -1))
  }
  let eff_len = if n > 0 && ascii.code_unit_at(n - 1) == 46 { n - 1 } else { n }
  if eff_len == 0 {
    return Some(IdnaError::new(IdnaErrorKind::EmptyLabel, "empty root-only domain", 0))
  }
  if eff_len > 253 {
    return Some(
      IdnaError::new(IdnaErrorKind::DomainTooLong, "ASCII domain exceeds 253 bytes", -1),
    )
  }
  let mut ls = 0
  let mut i = 0
  let mut li = 0
  while i <= eff_len {
    if i == eff_len || ascii.code_unit_at(i) == 46 {
      let llen = i - ls
      if llen == 0 {
        return Some(IdnaError::new(IdnaErrorKind::EmptyLabel, "empty DNS label", li))
      }
      if llen > 63 {
        return Some(
          IdnaError::new(IdnaErrorKind::LabelTooLong, "DNS label exceeds 63 bytes", li),
        )
      }
      ls = i + 1
      li = li + 1
    }
    i = i + 1
  }
  None
}

///| Fast validator for a Punycode-decoded label in `buf[0..dn]`.
///| Returns `true` only when the label is guaranteed valid, already NFC, non-Bidi (if check_bidi),
///| non-Joiner (if check_joiners), and non-ContextO (if check_contexto).
fn validate_decoded_punycode_fixed(
  buf : FixedArray[Int],
  dn : Int,
  opts : IdnaOptions,
  lut : FixedArray[Int],
  props : FixedArray[Int],
) -> Bool {
  if dn <= 0 {
    return false
  }
  let check_hyphens = opts.check_hyphens
  if check_hyphens {
    if buf[0] == 45 || buf[dn - 1] == 45 || (dn >= 4 && buf[2] == 45 && buf[3] == 45) {
      return false
    }
  } else if dn >= 4 && buf[0] == 120 && buf[1] == 110 && buf[2] == 45 && buf[3] == 45 {
    return false
  }
  let first_cp = buf[0]
  if first_cp >= 0x0300 && unicode_is_mark(first_cp) {
    return false
  }
  let use_std3 = opts.use_std3_ascii_rules
  let deny_dot = opts.deny_dot_in_label
  let check_bidi = opts.check_bidi
  let check_joiners = opts.check_joiners
  let check_contexto = opts.check_contexto
  let bidi_ctx_mask = (if check_bidi { 2 } else { 0 }) | (if check_contexto { 8 } else { 0 })
  let mut last_ccc = 0
  let mut i = 0
  while i < dn {
    let cp = buf[i]
    if cp < 0x80 {
      last_ccc = 0
      if cp == 46 && deny_dot {
        return false
      }
      if use_std3 && !((cp >= 97 && cp <= 122) || (cp >= 48 && cp <= 57) || cp == 45) {
        return false
      }
    } else if (cp >= 0x4E00 && cp <= 0x9FFF) ||
    (cp >= 0xAC00 && cp <= 0xD7A3) ||
    (cp >= 0x3041 && cp <= 0x3096) ||
    (cp >= 0x30A1 && cp <= 0x30FA) {
      last_ccc = 0
    } else if cp < 4096 {
      let v = lut[cp]
      if v != 1 && v != 5 {
        return false
      }
      let p = props[cp]
      if (p & bidi_ctx_mask) != 0 || (p & 131072) != 0 {
        return false
      }
      if (p & 1) != 0 {
        let c = (p >> 9) & 255
        if c != 0 && last_ccc > c {
          return false
        }
        last_ccc = c
      } else {
        last_ccc = 0
      }
    } else {
      if (cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61) && deny_dot {
        return false
      }
      let v = uts46_lookup(cp)
      if v != 1 && v != 5 {
        return false
      }
      if check_joiners && (cp == 0x200C || cp == 0x200D) {
        return false
      }
      if cp_may_need_nfc(cp) ||
      (check_bidi && cp_may_be_rtl(cp)) ||
      (check_contexto && cp_is_contexto_char(cp)) {
        return false
      }
      last_ccc = 0
    }
    i = i + 1
  }
  true
}

///| RFC 5893 Bidi Rule 1-6 directly over `mapped[0..total]` (labels delimited by `.` = 46).
///| Caller already confirmed at least one RTL character is present.
fn check_bidi_fixed(mapped : FixedArray[Int], total : Int, props : FixedArray[Int]) -> Bool {
  let mut ls = 0
  let mut k = 0
  while k <= total {
    if k == total || mapped[k] == 46 {
      let ln = k - ls
      if ln > 0 {
        let cp0 = mapped[ls]
        let bc0 = if cp0 < 4096 { (props[cp0] >> 4) & 31 } else { unicode_bidi_class(cp0) }
        if bc0 == 1 || bc0 == 2 {
          let mut has_en = false
          let mut has_an = false
          let mut i = ls
          while i < k {
            let cp = mapped[i]
            let bc = if cp < 4096 { (props[cp] >> 4) & 31 } else { unicode_bidi_class(cp) }
            if bc == 0 || bc >= 11 {
              return false
            }
            if bc == 3 {
              has_en = true
            } else if bc == 6 {
              has_an = true
            }
            i = i + 1
          }
          if has_en && has_an {
            return false
          }
          let mut last = k - 1
          while last >= ls {
            let cp = mapped[last]
            let bc = if cp < 4096 { (props[cp] >> 4) & 31 } else { unicode_bidi_class(cp) }
            if bc != 8 {
              break
            }
            last = last - 1
          }
          if last < ls {
            return false
          }
          let lcp = mapped[last]
          let lbc = if lcp < 4096 { (props[lcp] >> 4) & 31 } else { unicode_bidi_class(lcp) }
          if lbc != 1 && lbc != 2 && lbc != 3 && lbc != 6 {
            return false
          }
        } else if bc0 == 0 {
          let mut i = ls
          while i < k {
            let cp = mapped[i]
            let bc = if cp < 4096 { (props[cp] >> 4) & 31 } else { unicode_bidi_class(cp) }
            if bc == 1 || bc == 2 || bc == 6 || bc >= 11 {
              return false
            }
            i = i + 1
          }
          let mut last = k - 1
          while last >= ls {
            let cp = mapped[last]
            let bc = if cp < 4096 { (props[cp] >> 4) & 31 } else { unicode_bidi_class(cp) }
            if bc != 8 {
              break
            }
            last = last - 1
          }
          if last < ls {
            return false
          }
          let lcp = mapped[last]
          let lbc = if lcp < 4096 { (props[lcp] >> 4) & 31 } else { unicode_bidi_class(lcp) }
          if lbc != 0 && lbc != 3 {
            return false
          }
        } else {
          return false
        }
      }
      ls = k + 1
    }
    k = k + 1
  }
  true
}

fn to_ascii_slow(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> Result[String, IdnaError] {
  let n = domain.length()
  let state = match uts46_process(domain, opts, limits) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  match state.first_error {
    Some(e) => return Err(e)
    None => ()
  }
  let labels = state.labels
  let num_labels = labels.length()
  let out = StringBuilder::with_capacity(n + 16)
  let mut li = 0
  while li < num_labels {
    if li > 0 {
      out.write_byte((46).to_byte())
    }
    let lab = labels[li]
    let ln = lab.length()
    let mut has_non_ascii = false
    let mut j = 0
    while j < ln {
      if lab[j] >= 0x80 {
        has_non_ascii = true
        break
      }
      j = j + 1
    }
    if has_non_ascii {
      out.write_string("xn--")
      match punycode_encode_cps_range(out, lab, 0, ln, li) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else {
      j = 0
      while j < ln {
        out.write_byte(lab[j].to_byte())
        j = j + 1
      }
    }
    li = li + 1
  }
  let res = out.to_string()
  if opts.verify_dns_length {
    match verify_dns_length_ascii(res) {
      Some(e) => return Err(e)
      None => ()
    }
  }
  Ok(res)
}

fn to_ascii_xn_fast(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
  has_upper : Bool,
  last_llen : Int,
  has_dns_bad : Bool,
) -> Result[String, IdnaError] {
  let n = domain.length()
  let lut = low_uts46_lut
  let props = low_props_lut
  let dec_cap = if n < 64 { 64 } else { n }
  let dec_buf : FixedArray[Int] = FixedArray::make(dec_cap, 0)
  let max_lcp = limits.max_label_codepoints
  let max_puny = limits.max_punycode_input
  let mut ls = 0
  let mut k = 0
  while k <= n {
    if k == n || domain.code_unit_at(k) == 46 {
      let llen = k - ls
      if llen >= 4 &&
      domain.code_unit_at(ls + 2) == 45 &&
      domain.code_unit_at(ls + 3) == 45 {
        let b0 = domain.code_unit_at(ls)
        let b1 = domain.code_unit_at(ls + 1)
        if (b0 == 120 || b0 == 88) && (b1 == 110 || b1 == 78) {
          let dn = punycode_decode_str_to_fixed(domain, ls + 4, k, dec_buf, max_lcp, max_puny)
          if dn <= 0 || !validate_decoded_punycode_fixed(dec_buf, dn, opts, lut, props) {
            return to_ascii_slow(domain, opts, limits)
          }
        }
      }
      ls = k + 1
    }
    k = k + 1
  }
  let res = if !has_upper {
    domain
  } else {
    let sb = StringBuilder::with_capacity(n)
    let mut j = 0
    while j < n {
      let b = domain.code_unit_at(j)
      if b >= 65 && b <= 90 {
        sb.write_byte((b + 32).to_byte())
      } else {
        sb.write_byte(b.to_byte())
      }
      j = j + 1
    }
    sb.to_string()
  }
  if opts.verify_dns_length {
    let eff_len = if last_llen == 0 { n - 1 } else { n }
    if has_dns_bad || eff_len == 0 || eff_len > 253 || last_llen > 63 {
      match verify_dns_length_ascii(res) {
        Some(e) => return Err(e)
        None => ()
      }
    }
  }
  Ok(res)
}

fn to_ascii_non_ascii_fast(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> Result[String, IdnaError] {
  let n = domain.length()
  let max_lab = limits.max_labels
  let max_lcp = limits.max_label_codepoints
  let use_std3 = opts.use_std3_ascii_rules
  let check_hyphens = opts.check_hyphens
  let check_bidi = opts.check_bidi
  let check_contexto = opts.check_contexto
  let verify_dns = opts.verify_dns_length
  let transitional = opts.transitional_processing
  let mapped : FixedArray[Int] = FixedArray::make(n + 4, 0)
  let lut = low_uts46_lut
  let props = low_props_lut
  let ctx_mask = if check_contexto { 8 } else { 0 }
  let mut total = 0
  let mut ok_fast = true
  let mut needs_in_place_nfc = false
  let mut has_rtl = false
  let mut last_ccc = 0
  let mut pos = 0
  while pos < n {
    let b0 = domain.code_unit_at(pos)
    if b0 < 0x80 {
      pos = pos + 1
      last_ccc = 0
      let c = if b0 >= 65 && b0 <= 90 { b0 + 32 } else { b0 }
      if c != 46 && use_std3 && !((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45) {
        ok_fast = false
        break
      }
      if total >= mapped.length() {
        ok_fast = false
        break
      }
      mapped[total] = c
      total = total + 1
    } else {
      let r = decode_utf8_non_ascii(domain, pos, n)
      if r < 0 {
        return Err(
          IdnaError::{ kind: IdnaErrorKind::InvalidUtf8, message: "invalid UTF-8 in domain", label_index: -1 },
        )
      }
      let cp = r & 0x1FFFFF
      pos = pos + (r >> 21)
      if (cp >= 0x4E00 && cp <= 0x9FFF) ||
      (cp >= 0xAC00 && cp <= 0xD7A3) ||
      (cp >= 0x3041 && cp <= 0x3096) ||
      (cp >= 0x30A1 && cp <= 0x30FA) {
        last_ccc = 0
        if total >= mapped.length() {
          ok_fast = false
          break
        }
        mapped[total] = cp
        total = total + 1
      } else if cp < 4096 {
        let v = lut[cp]
        if v == 1 || (v == 5 && !transitional) {
          let p = props[cp]
          if (p & ctx_mask) != 0 {
            ok_fast = false
            break
          }
          if check_bidi && (p & 2) != 0 {
            has_rtl = true
          }
          if (p & 131072) != 0 {
            needs_in_place_nfc = true
          } else if (p & 1) != 0 {
            let c = (p >> 9) & 255
            if c != 0 && last_ccc > c {
              needs_in_place_nfc = true
            }
            last_ccc = c
          } else {
            last_ccc = 0
          }
          if total >= mapped.length() {
            ok_fast = false
            break
          }
          mapped[total] = cp
          total = total + 1
        } else if v == 0 {
          return Err(
            IdnaError::{ kind: IdnaErrorKind::DisallowedCodePoint, message: "disallowed code point in domain", label_index: -1 },
          )
        } else if v == 2 {
          continue
        } else if (v & 7) == 3 {
          let m = cp + (v >> 3)
          if transitional && (m == 0x00DF || m == 0x03C2 || m == 0x200C || m == 0x200D) {
            ok_fast = false
            break
          }
          if m < 0x80 {
            last_ccc = 0
            if m != 46 && use_std3 && !((m >= 97 && m <= 122) || (m >= 48 && m <= 57) || m == 45) {
              ok_fast = false
              break
            }
          } else if m < 4096 {
            let p = props[m]
            if (p & ctx_mask) != 0 {
              ok_fast = false
              break
            }
            if check_bidi && (p & 2) != 0 {
              has_rtl = true
            }
            if (p & 131072) != 0 {
              needs_in_place_nfc = true
            } else if (p & 1) != 0 {
              let c = (p >> 9) & 255
              if c != 0 && last_ccc > c {
                needs_in_place_nfc = true
              }
              last_ccc = c
            } else {
              last_ccc = 0
            }
          } else if cp_may_need_nfc(m) || (check_contexto && cp_is_contexto_char(m)) {
            ok_fast = false
            break
          } else {
            if check_bidi && cp_may_be_rtl(m) {
              has_rtl = true
            }
            last_ccc = 0
          }
          if total >= mapped.length() {
            ok_fast = false
            break
          }
          mapped[total] = m
          total = total + 1
        } else {
          ok_fast = false
          break
        }
      } else if cp >= 0xFF21 && cp <= 0xFF3A {
        last_ccc = 0
        if total >= mapped.length() {
          ok_fast = false
          break
        }
        mapped[total] = cp - 0xFF21 + 97
        total = total + 1
      } else if cp >= 0xFF41 && cp <= 0xFF5A {
        last_ccc = 0
        if total >= mapped.length() {
          ok_fast = false
          break
        }
        mapped[total] = cp - 0xFF41 + 97
        total = total + 1
      } else if cp >= 0xFF10 && cp <= 0xFF19 {
        last_ccc = 0
        if total >= mapped.length() {
          ok_fast = false
          break
        }
        mapped[total] = cp - 0xFF10 + 48
        total = total + 1
      } else if cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61 {
        last_ccc = 0
        if total >= mapped.length() {
          ok_fast = false
          break
        }
        mapped[total] = 46
        total = total + 1
      } else if cp == 0xFF0D {
        last_ccc = 0
        if total >= mapped.length() {
          ok_fast = false
          break
        }
        mapped[total] = 45
        total = total + 1
      } else {
        let v = uts46_lookup(cp)
        if v == 0 {
          return Err(
            IdnaError::{ kind: IdnaErrorKind::DisallowedCodePoint, message: "disallowed code point in domain", label_index: -1 },
          )
        } else if v == 1 {
          if cp_may_need_nfc(cp) || (check_contexto && cp_is_contexto_char(cp)) {
            ok_fast = false
            break
          }
          if check_bidi && cp_may_be_rtl(cp) {
            has_rtl = true
          }
          last_ccc = 0
          if total >= mapped.length() {
            ok_fast = false
            break
          }
          mapped[total] = cp
          total = total + 1
        } else if v == 2 {
          continue
        } else if (v & 7) == 3 {
          let m = cp + (v >> 3)
          if transitional && (m == 0x00DF || m == 0x03C2 || m == 0x200C || m == 0x200D) {
            ok_fast = false
            break
          }
          if m < 0x80 {
            last_ccc = 0
            if m != 46 && use_std3 && !((m >= 97 && m <= 122) || (m >= 48 && m <= 57) || m == 45) {
              ok_fast = false
              break
            }
          } else if cp_may_need_nfc(m) || (check_contexto && cp_is_contexto_char(m)) {
            ok_fast = false
            break
          } else {
            if check_bidi && cp_may_be_rtl(m) {
              has_rtl = true
            }
            last_ccc = 0
          }
          if total >= mapped.length() {
            ok_fast = false
            break
          }
          mapped[total] = m
          total = total + 1
        } else {
          ok_fast = false
          break
        }
      }
    }
  }
  if ok_fast && needs_in_place_nfc {
    let new_total = nfc_normalize_in_place_fixed(mapped, total)
    if new_total < 0 {
      ok_fast = false
    } else {
      total = new_total
      let mut vi = 0
      while vi < total {
        let cp = mapped[vi]
        if cp >= 0x80 {
          let v = if cp < 4096 { lut[cp] } else { uts46_lookup_fast(cp) }
          if !(v == 1 || (v == 5 && !transitional)) {
            ok_fast = false
            break
          }
          if cp < 4096 {
            let p = props[cp]
            if (p & ctx_mask) != 0 {
              ok_fast = false
              break
            }
            if check_bidi && (p & 2) != 0 {
              has_rtl = true
            }
          } else {
            if (check_contexto && cp_is_contexto_char(cp)) ||
            (opts.check_joiners && (cp == 0x200C || cp == 0x200D)) {
              ok_fast = false
              break
            }
            if check_bidi && cp_may_be_rtl(cp) {
              has_rtl = true
            }
          }
        }
        vi = vi + 1
      }
    }
  }
  if ok_fast && total > 0 {
    if has_rtl && !check_bidi_fixed(mapped, total, props) {
      return to_ascii_slow(domain, opts, limits)
    }
    let out = StringBuilder::with_capacity(total * 2 + 16)
    let mut has_dns_bad = false
    let mut last_out_llen = 0
    let mut label_has_non_ascii = false
    let mut ls = 0
    let mut k = 0
    let mut li = 0
    while k <= total {
      if k < total {
        let c = mapped[k]
        if c != 46 {
          if c >= 0x80 {
            label_has_non_ascii = true
          }
          k = k + 1
          continue
        }
      }
      if li >= max_lab {
        return Err(
          IdnaError::{ kind: IdnaErrorKind::LimitExceeded, message: "domain exceeds max_labels", label_index: li },
        )
      }
      let llen = k - ls
      if llen > max_lcp {
        return Err(
          IdnaError::{
            kind: IdnaErrorKind::LimitExceeded,
            message: "label exceeds max_label_codepoints",
            label_index: li,
          },
        )
      }
      if llen > 0 {
        let first_cp = mapped[ls]
        if first_cp >= 0x0300 && unicode_is_mark(first_cp) {
          return Err(
            IdnaError::{
              kind: IdnaErrorKind::LeadingCombiningMark,
              message: "label starts with combining mark",
              label_index: li,
            },
          )
        }
        if llen >= 4 &&
        mapped[ls] == 120 &&
        mapped[ls + 1] == 110 &&
        mapped[ls + 2] == 45 &&
        mapped[ls + 3] == 45 {
          return to_ascii_slow(domain, opts, limits)
        }
        if check_hyphens {
          if first_cp == 45 ||
          mapped[k - 1] == 45 ||
          (llen >= 4 && mapped[ls + 2] == 45 && mapped[ls + 3] == 45) {
            return Err(
              IdnaError::{
                kind: IdnaErrorKind::InvalidHyphens,
                message: "invalid hyphen placement in label",
                label_index: li,
              },
            )
          }
        }
      }
      if ls > 0 {
        out.write_byte((46).to_byte())
      }
      let out_start = out.length()
      if label_has_non_ascii {
        out.write_string("xn--")
        match punycode_encode_fixed_range(out, mapped, ls, k, li) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      } else {
        let mut j = ls
        while j < k {
          out.write_byte(mapped[j].to_byte())
          j = j + 1
        }
      }
      let out_llen = out.length() - out_start
      if k < total {
        if out_llen == 0 || out_llen > 63 {
          has_dns_bad = true
        }
      } else {
        last_out_llen = out_llen
      }
      label_has_non_ascii = false
      ls = k + 1
      li = li + 1
      k = k + 1
    }
    let out_len = out.length()
    let res = out.to_string()
    if verify_dns {
      let eff_len = if last_out_llen == 0 { out_len - 1 } else { out_len }
      if has_dns_bad || eff_len <= 0 || eff_len > 253 || last_out_llen > 63 {
        match verify_dns_length_ascii(res) {
          Some(e) => return Err(e)
          None => ()
        }
      }
    }
    return Ok(res)
  }
  to_ascii_slow(domain, opts, limits)
}

///| UTS #46 `ToASCII` with full configurable `IdnaOptions` and `IdnaLimits`.
pub fn to_ascii(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> Result[String, IdnaError] {
  let max_in = limits.max_input_bytes
  let max_lab = limits.max_labels
  let max_lcp = limits.max_label_codepoints
  if max_in < 0 || max_lab < 0 || max_lcp < 0 || limits.max_punycode_input < 0 {
    return Err(
      IdnaError::{ kind: IdnaErrorKind::LimitExceeded, message: "negative IdnaLimits value", label_index: -1 },
    )
  }
  let n = domain.length()
  if n > max_in {
    return Err(
      IdnaError::{ kind: IdnaErrorKind::LimitExceeded, message: "domain exceeds max_input_bytes", label_index: -1 },
    )
  }
  if n == 0 {
    if opts.verify_dns_length {
      return Err(IdnaError::{ kind: IdnaErrorKind::EmptyInput, message: "empty domain", label_index: -1 })
    }
    return Ok("")
  }
  let check_hyphens = opts.check_hyphens
  // Packed flags: bit0=has_upper, bit1=has_xn, bit2=has_std3_bad, bit3=has_hyphen_bad, bit4=has_dns_bad
  let mut flags = 0
  let mut label_count = 1
  let mut label_start = 0
  let mut i = 0
  while i < n {
    let b = domain.code_unit_at(i)
    if b >= 97 {
      if b <= 122 {
        i = i + 1
        continue
      }
      if b >= 0x80 {
        return to_ascii_non_ascii_fast(domain, opts, limits)
      }
      flags = flags | 4
      i = i + 1
      continue
    }
    if b == 46 {
      let llen = i - label_start
      if llen > max_lcp {
        return Err(
          IdnaError::{
            kind: IdnaErrorKind::LimitExceeded,
            message: "label exceeds max_label_codepoints",
            label_index: label_count - 1,
          },
        )
      }
      if llen == 0 || llen > 63 {
        flags = flags | 16
      }
      if llen >= 4 &&
      domain.code_unit_at(label_start + 2) == 45 &&
      domain.code_unit_at(label_start + 3) == 45 {
        let b0 = domain.code_unit_at(label_start)
        let b1 = domain.code_unit_at(label_start + 1)
        if (b0 == 120 || b0 == 88) && (b1 == 110 || b1 == 78) {
          flags = flags | 2
        } else if check_hyphens {
          flags = flags | 8
        }
      } else if check_hyphens && llen > 0 {
        if domain.code_unit_at(label_start) == 45 || domain.code_unit_at(i - 1) == 45 {
          flags = flags | 8
        }
      }
      label_count = label_count + 1
      if label_count > max_lab {
        return Err(
          IdnaError::{
            kind: IdnaErrorKind::LimitExceeded,
            message: "domain exceeds max_labels",
            label_index: label_count - 1,
          },
        )
      }
      label_start = i + 1
    } else if (b >= 48 && b <= 57) || b == 45 {
      ()
    } else if b >= 65 && b <= 90 {
      flags = flags | 1
    } else {
      flags = flags | 4
    }
    i = i + 1
  }
  let last_llen = n - label_start
  if last_llen > max_lcp {
    return Err(
      IdnaError::{
        kind: IdnaErrorKind::LimitExceeded,
        message: "label exceeds max_label_codepoints",
        label_index: label_count - 1,
      },
    )
  }
  if last_llen >= 4 &&
  domain.code_unit_at(label_start + 2) == 45 &&
  domain.code_unit_at(label_start + 3) == 45 {
    let b0 = domain.code_unit_at(label_start)
    let b1 = domain.code_unit_at(label_start + 1)
    if (b0 == 120 || b0 == 88) && (b1 == 110 || b1 == 78) {
      flags = flags | 2
    } else if check_hyphens {
      flags = flags | 8
    }
  } else if check_hyphens && last_llen > 0 {
    if domain.code_unit_at(label_start) == 45 || domain.code_unit_at(n - 1) == 45 {
      flags = flags | 8
    }
  }
  if (flags & 2) != 0 {
    if !(opts.use_std3_ascii_rules && (flags & 4) != 0) &&
    !(check_hyphens && (flags & 8) != 0) {
      return to_ascii_xn_fast(domain, opts, limits, (flags & 1) != 0, last_llen, (flags & 16) != 0)
    }
    return to_ascii_slow(domain, opts, limits)
  }
  if opts.use_std3_ascii_rules && (flags & 4) != 0 {
    return Err(
      IdnaError::{ kind: IdnaErrorKind::DisallowedCodePoint, message: "disallowed STD3 ASCII code point", label_index: -1 },
    )
  }
  if check_hyphens && (flags & 8) != 0 {
    return Err(
      IdnaError::{ kind: IdnaErrorKind::InvalidHyphens, message: "invalid hyphen placement in label", label_index: -1 },
    )
  }
  let res = if (flags & 1) == 0 {
    domain
  } else {
    let sb = StringBuilder::with_capacity(n)
    let mut k = 0
    while k < n {
      let b = domain.code_unit_at(k)
      if b >= 65 && b <= 90 {
        sb.write_byte((b + 32).to_byte())
      } else {
        sb.write_byte(b.to_byte())
      }
      k = k + 1
    }
    sb.to_string()
  }
  if opts.verify_dns_length {
    let eff_len = if last_llen == 0 { n - 1 } else { n }
    if (flags & 16) != 0 || eff_len == 0 || eff_len > 253 || last_llen > 63 {
      match verify_dns_length_ascii(res) {
        Some(e) => return Err(e)
        None => ()
      }
    }
  }
  Ok(res)
}

///| UTS #46 `ToASCII` with `IdnaOptions::uts46_strict()` and `IdnaLimits::default()`.
pub fn to_ascii_default(domain : String) -> Result[String, IdnaError] {
  to_ascii(domain, IdnaOptions::uts46_strict(), IdnaLimits::default())
}

fn to_unicode_slow(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> UnicodeResult {
  // UTS #46 §4.2: ToUnicode always uses NonTransitional processing for decoding/validation
  let uni_opts = IdnaOptions::{
    use_std3_ascii_rules: opts.use_std3_ascii_rules,
    check_hyphens: opts.check_hyphens,
    check_bidi: opts.check_bidi,
    check_joiners: opts.check_joiners,
    check_contexto: opts.check_contexto,
    verify_dns_length: false,
    transitional_processing: false,
    ignore_invalid_punycode: opts.ignore_invalid_punycode,
    deny_dot_in_label: opts.deny_dot_in_label,
  }
  match uts46_process(domain, uni_opts, limits) {
    Err(e) => {
      UnicodeResult::{
        output: domain,
        is_valid: false,
        first_error: Some(e),
        error_count: 1,
      }
    }
    Ok(state) => {
      let labels = state.labels
      let num_labels = labels.length()
      let sb = StringBuilder::with_capacity(domain.length() + 16)
      let mut li = 0
      while li < num_labels {
        if li > 0 {
          sb.write_byte((46).to_byte())
        }
        let lab = labels[li]
        let ln = lab.length()
        let mut j = 0
        while j < ln {
          write_utf8_cp(sb, lab[j])
          j = j + 1
        }
        li = li + 1
      }
      UnicodeResult::{
        output: sb.to_string(),
        is_valid: state.error_count == 0,
        first_error: state.first_error,
        error_count: state.error_count,
      }
    }
  }
}

fn to_unicode_xn_fast(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> UnicodeResult {
  let n = domain.length()
  let lut = low_uts46_lut
  let props = low_props_lut
  let dec_cap = if n < 64 { 64 } else { n }
  let dec_buf : FixedArray[Int] = FixedArray::make(dec_cap, 0)
  let max_lcp = limits.max_label_codepoints
  let max_puny = limits.max_punycode_input
  let sb = StringBuilder::with_capacity(n + 16)
  let mut ls = 0
  let mut k = 0
  while k <= n {
    if k == n || domain.code_unit_at(k) == 46 {
      if ls > 0 {
        sb.write_byte((46).to_byte())
      }
      let llen = k - ls
      let mut is_xn_lab = false
      if llen >= 4 &&
      domain.code_unit_at(ls + 2) == 45 &&
      domain.code_unit_at(ls + 3) == 45 {
        let b0 = domain.code_unit_at(ls)
        let b1 = domain.code_unit_at(ls + 1)
        if (b0 == 120 || b0 == 88) && (b1 == 110 || b1 == 78) {
          is_xn_lab = true
        }
      }
      if is_xn_lab {
        let dn = punycode_decode_str_to_fixed(domain, ls + 4, k, dec_buf, max_lcp, max_puny)
        if dn <= 0 || !validate_decoded_punycode_fixed(dec_buf, dn, opts, lut, props) {
          return to_unicode_slow(domain, opts, limits)
        }
        let mut j = 0
        while j < dn {
          write_utf8_cp(sb, dec_buf[j])
          j = j + 1
        }
      } else {
        let mut j = ls
        while j < k {
          let b = domain.code_unit_at(j)
          if b >= 65 && b <= 90 {
            sb.write_byte((b + 32).to_byte())
          } else {
            sb.write_byte(b.to_byte())
          }
          j = j + 1
        }
      }
      ls = k + 1
    }
    k = k + 1
  }
  UnicodeResult::{
    output: sb.to_string(),
    is_valid: true,
    first_error: None,
    error_count: 0,
  }
}

fn to_unicode_non_ascii_transform(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> UnicodeResult {
  let n = domain.length()
  let max_lab = limits.max_labels
  let max_lcp = limits.max_label_codepoints
  let use_std3 = opts.use_std3_ascii_rules
  let check_hyphens = opts.check_hyphens
  let check_bidi = opts.check_bidi
  let check_joiners = opts.check_joiners
  let check_contexto = opts.check_contexto
  let lut = low_uts46_lut
  let props = low_props_lut
  let ctx_mask = if check_contexto { 8 } else { 0 }
  let mapped : FixedArray[Int] = FixedArray::make(n + 4, 0)
  let mut total = 0
  let mut ok_t = true
  let mut needs_in_place_nfc = false
  let mut has_rtl = false
  let mut t_last_ccc = 0
  let mut tpos = 0
  while tpos < n {
    let b0 = domain.code_unit_at(tpos)
    if b0 < 0x80 {
      tpos = tpos + 1
      t_last_ccc = 0
      let c = if b0 >= 65 && b0 <= 90 { b0 + 32 } else { b0 }
      if c != 46 && use_std3 && !((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45) {
        ok_t = false
        break
      }
      if total >= mapped.length() {
        ok_t = false
        break
      }
      mapped[total] = c
      total = total + 1
    } else {
      let r = decode_utf8_non_ascii(domain, tpos, n)
      if r < 0 {
        ok_t = false
        break
      }
      let cp = r & 0x1FFFFF
      tpos = tpos + (r >> 21)
      if (cp >= 0x4E00 && cp <= 0x9FFF) ||
      (cp >= 0xAC00 && cp <= 0xD7A3) ||
      (cp >= 0x3041 && cp <= 0x3096) ||
      (cp >= 0x30A1 && cp <= 0x30FA) {
        t_last_ccc = 0
        if total >= mapped.length() {
          ok_t = false
          break
        }
        mapped[total] = cp
        total = total + 1
      } else if cp < 4096 {
        let v = lut[cp]
        if v == 1 || v == 5 {
          let p = props[cp]
          if (p & ctx_mask) != 0 {
            ok_t = false
            break
          }
          if check_bidi && (p & 2) != 0 {
            has_rtl = true
          }
          if (p & 131072) != 0 {
            needs_in_place_nfc = true
          } else if (p & 1) != 0 {
            let c = (p >> 9) & 255
            if c != 0 && t_last_ccc > c {
              needs_in_place_nfc = true
            }
            t_last_ccc = c
          } else {
            t_last_ccc = 0
          }
          if total >= mapped.length() {
            ok_t = false
            break
          }
          mapped[total] = cp
          total = total + 1
        } else if v == 2 {
          continue
        } else if (v & 7) == 3 {
          let m = cp + (v >> 3)
          if m < 0x80 {
            t_last_ccc = 0
            if m != 46 && use_std3 && !((m >= 97 && m <= 122) || (m >= 48 && m <= 57) || m == 45) {
              ok_t = false
              break
            }
          } else if m < 4096 {
            let p = props[m]
            if (p & ctx_mask) != 0 {
              ok_t = false
              break
            }
            if check_bidi && (p & 2) != 0 {
              has_rtl = true
            }
            if (p & 131072) != 0 {
              needs_in_place_nfc = true
            } else if (p & 1) != 0 {
              let c = (p >> 9) & 255
              if c != 0 && t_last_ccc > c {
                needs_in_place_nfc = true
              }
              t_last_ccc = c
            } else {
              t_last_ccc = 0
            }
          } else {
            ok_t = false
            break
          }
          if total >= mapped.length() {
            ok_t = false
            break
          }
          mapped[total] = m
          total = total + 1
        } else {
          ok_t = false
          break
        }
      } else if cp >= 0xFF21 && cp <= 0xFF3A {
        t_last_ccc = 0
        if total >= mapped.length() {
          ok_t = false
          break
        }
        mapped[total] = cp - 0xFF21 + 97
        total = total + 1
      } else if cp >= 0xFF41 && cp <= 0xFF5A {
        t_last_ccc = 0
        if total >= mapped.length() {
          ok_t = false
          break
        }
        mapped[total] = cp - 0xFF41 + 97
        total = total + 1
      } else if cp >= 0xFF10 && cp <= 0xFF19 {
        t_last_ccc = 0
        if total >= mapped.length() {
          ok_t = false
          break
        }
        mapped[total] = cp - 0xFF10 + 48
        total = total + 1
      } else if cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61 {
        t_last_ccc = 0
        if total >= mapped.length() {
          ok_t = false
          break
        }
        mapped[total] = 46
        total = total + 1
      } else if cp == 0xFF0D {
        t_last_ccc = 0
        if total >= mapped.length() {
          ok_t = false
          break
        }
        mapped[total] = 45
        total = total + 1
      } else {
        let v = uts46_lookup(cp)
        if v == 1 {
          if cp_may_need_nfc(cp) || (check_contexto && cp_is_contexto_char(cp)) {
            ok_t = false
            break
          }
          if check_bidi && cp_may_be_rtl(cp) {
            has_rtl = true
          }
          t_last_ccc = 0
          if total >= mapped.length() {
            ok_t = false
            break
          }
          mapped[total] = cp
          total = total + 1
        } else if v == 2 {
          continue
        } else if (v & 7) == 3 {
          let m = cp + (v >> 3)
          if m < 0x80 {
            t_last_ccc = 0
            if m != 46 && use_std3 && !((m >= 97 && m <= 122) || (m >= 48 && m <= 57) || m == 45) {
              ok_t = false
              break
            }
          } else if m < 4096 {
            let p = props[m]
            if (p & ctx_mask) != 0 {
              ok_t = false
              break
            }
            if check_bidi && (p & 2) != 0 {
              has_rtl = true
            }
            if (p & 131072) != 0 {
              needs_in_place_nfc = true
            } else if (p & 1) != 0 {
              let c = (p >> 9) & 255
              if c != 0 && t_last_ccc > c {
                needs_in_place_nfc = true
              }
              t_last_ccc = c
            } else {
              t_last_ccc = 0
            }
          } else {
            ok_t = false
            break
          }
          if total >= mapped.length() {
            ok_t = false
            break
          }
          mapped[total] = m
          total = total + 1
        } else {
          ok_t = false
          break
        }
      }
    }
  }
  if ok_t && needs_in_place_nfc {
    let new_total = nfc_normalize_in_place_fixed(mapped, total)
    if new_total < 0 {
      ok_t = false
    } else {
      total = new_total
      let mut vi = 0
      while vi < total {
        let cp = mapped[vi]
        if cp >= 0x80 {
          let v = if cp < 4096 { lut[cp] } else { uts46_lookup_fast(cp) }
          if v != 1 && v != 5 {
            ok_t = false
            break
          }
          if cp < 4096 {
            let p = props[cp]
            if (p & ctx_mask) != 0 {
              ok_t = false
              break
            }
            if check_bidi && (p & 2) != 0 {
              has_rtl = true
            }
          } else {
            if (check_contexto && cp_is_contexto_char(cp)) ||
            (check_joiners && (cp == 0x200C || cp == 0x200D)) {
              ok_t = false
              break
            }
            if check_bidi && cp_may_be_rtl(cp) {
              has_rtl = true
            }
          }
        }
        vi = vi + 1
      }
    }
  }
  if ok_t && total > 0 {
    let mut ls = 0
    let mut k = 0
    let mut li = 0
    while k <= total {
      if k == total || mapped[k] == 46 {
        if li >= max_lab {
          ok_t = false
          break
        }
        let llen = k - ls
        if llen > max_lcp {
          ok_t = false
          break
        }
        if llen > 0 {
          let first_cp = mapped[ls]
          if first_cp >= 0x0300 && unicode_is_mark(first_cp) {
            ok_t = false
            break
          }
          if llen >= 4 &&
          mapped[ls] == 120 &&
          mapped[ls + 1] == 110 &&
          mapped[ls + 2] == 45 &&
          mapped[ls + 3] == 45 {
            ok_t = false
            break
          }
          if check_hyphens {
            if first_cp == 45 ||
            mapped[k - 1] == 45 ||
            (llen >= 4 && mapped[ls + 2] == 45 && mapped[ls + 3] == 45) {
              ok_t = false
              break
            }
          }
        }
        ls = k + 1
        li = li + 1
      }
      k = k + 1
    }
    if ok_t && has_rtl && !check_bidi_fixed(mapped, total, props) {
      return to_unicode_slow(domain, opts, limits)
    }
    if ok_t {
      let sb = StringBuilder::with_capacity(n + 8)
      let mut j = 0
      while j < total {
        write_utf8_cp(sb, mapped[j])
        j = j + 1
      }
      return UnicodeResult::{
        output: sb.to_string(),
        is_valid: true,
        first_error: None,
        error_count: 0,
      }
    }
  }
  to_unicode_slow(domain, opts, limits)
}

fn to_unicode_non_ascii_fast(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> UnicodeResult {
  let n = domain.length()
  let max_lab = limits.max_labels
  let max_lcp = limits.max_label_codepoints
  let use_std3 = opts.use_std3_ascii_rules
  let check_hyphens = opts.check_hyphens
  let check_bidi = opts.check_bidi
  let check_joiners = opts.check_joiners
  let check_contexto = opts.check_contexto
  let lut = low_uts46_lut
  let props = low_props_lut
  let bidi_ctx_mask = (if check_bidi { 2 } else { 0 }) |
  (if check_contexto { 8 } else { 0 })
  let mut fast_ok = true
  let mut needs_transform = false
  let mut u_upper = false
  let mut u_labels = 1
  let mut label_cps = 0
  let mut xn_state = 0
  let mut h3 = false
  let mut last_was_hyphen = false
  let mut last_ccc = 0
  let mut pos = 0
  while pos < n {
    let b0 = domain.code_unit_at(pos)
    if b0 < 0x80 {
      pos = pos + 1
      last_ccc = 0
      if b0 == 46 {
        if check_hyphens && last_was_hyphen {
          fast_ok = false
          break
        }
        u_labels = u_labels + 1
        if u_labels > max_lab {
          fast_ok = false
          break
        }
        label_cps = 0
        xn_state = 0
        h3 = false
        last_was_hyphen = false
      } else {
        label_cps = label_cps + 1
        if label_cps > max_lcp {
          fast_ok = false
          break
        }
        if b0 >= 97 && b0 <= 122 {
          last_was_hyphen = false
          if label_cps == 1 {
            xn_state = if b0 == 120 { 1 } else { 0 }
          } else if label_cps == 2 {
            xn_state = if xn_state == 1 && b0 == 110 { 2 } else { 0 }
          } else {
            xn_state = 0
          }
        } else if b0 >= 48 && b0 <= 57 {
          last_was_hyphen = false
          xn_state = 0
        } else if b0 == 45 {
          last_was_hyphen = true
          if check_hyphens && label_cps == 1 {
            fast_ok = false
            break
          }
          if label_cps == 3 {
            h3 = true
            xn_state = if xn_state == 2 { 3 } else { 0 }
          } else if label_cps == 4 {
            if xn_state == 3 || (check_hyphens && h3) {
              fast_ok = false
              break
            }
            xn_state = 0
          } else {
            xn_state = 0
          }
        } else if b0 >= 65 && b0 <= 90 {
          u_upper = true
          last_was_hyphen = false
          if label_cps == 1 {
            xn_state = if b0 == 88 { 1 } else { 0 }
          } else if label_cps == 2 {
            xn_state = if xn_state == 1 && b0 == 78 { 2 } else { 0 }
          } else {
            xn_state = 0
          }
        } else {
          last_was_hyphen = false
          xn_state = 0
          if use_std3 {
            fast_ok = false
            break
          }
        }
      }
    } else {
      let r = decode_utf8_non_ascii(domain, pos, n)
      if r < 0 {
        fast_ok = false
        break
      }
      let cp = r & 0x1FFFFF
      pos = pos + (r >> 21)
      label_cps = label_cps + 1
      if label_cps > max_lcp {
        fast_ok = false
        break
      }
      last_was_hyphen = false
      xn_state = 0
      if (cp >= 0x4E00 && cp <= 0x9FFF) ||
      (cp >= 0xAC00 && cp <= 0xD7A3) ||
      (cp >= 0x3041 && cp <= 0x3096) ||
      (cp >= 0x30A1 && cp <= 0x30FA) {
        last_ccc = 0
      } else if cp < 4096 {
        let v = lut[cp]
        if v != 1 && v != 5 {
          if (v & 7) == 3 || v == 2 {
            needs_transform = true
          }
          fast_ok = false
          break
        }
        let p = props[cp]
        if (p & bidi_ctx_mask) != 0 {
          if check_bidi && (p & 2) != 0 {
            needs_transform = true
          }
          fast_ok = false
          break
        }
        if label_cps == 1 && (p & 4) != 0 {
          fast_ok = false
          break
        }
        if (p & 131072) != 0 {
          needs_transform = true
          fast_ok = false
          break
        }
        if (p & 1) != 0 {
          let c = (p >> 9) & 255
          if c != 0 && last_ccc > c {
            needs_transform = true
            fast_ok = false
            break
          }
          last_ccc = c
        } else {
          last_ccc = 0
        }
      } else if (cp >= 0xFF10 && cp <= 0xFF5A) || cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61 || cp == 0xFF0D {
        needs_transform = true
        fast_ok = false
        break
      } else {
        let v = uts46_lookup(cp)
        if v != 1 && v != 5 {
          if (v & 7) == 3 || v == 2 {
            needs_transform = true
          }
          fast_ok = false
          break
        }
        if check_joiners && (cp == 0x200C || cp == 0x200D) {
          fast_ok = false
          break
        }
        if cp_may_need_nfc(cp) ||
        (check_bidi && cp_may_be_rtl(cp)) ||
        (check_contexto && cp_is_contexto_char(cp)) ||
        (label_cps == 1 && unicode_is_mark(cp)) {
          fast_ok = false
          break
        }
        last_ccc = 0
      }
    }
  }
  if fast_ok && !(check_hyphens && last_was_hyphen) {
    let out = if !u_upper {
      domain
    } else {
      let sb = StringBuilder::with_capacity(n)
      let mut k = 0
      while k < n {
        let b = domain.code_unit_at(k)
        if b >= 65 && b <= 90 {
          sb.write_byte((b + 32).to_byte())
        } else {
          sb.write_byte(b.to_byte())
        }
        k = k + 1
      }
      sb.to_string()
    }
    return UnicodeResult::{
      output: out,
      is_valid: true,
      first_error: None,
      error_count: 0,
    }
  }
  if needs_transform {
    return to_unicode_non_ascii_transform(domain, opts, limits)
  }
  to_unicode_slow(domain, opts, limits)
}

///| UTS #46 `ToUnicode` (UTS #46 §4.2): always returns best-effort Unicode output along with
///| validity flag, first error, and total error count.
pub fn to_unicode(
  domain : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> UnicodeResult {
  let max_in = limits.max_input_bytes
  let max_lab = limits.max_labels
  let max_lcp = limits.max_label_codepoints
  if max_in < 0 || max_lab < 0 || max_lcp < 0 || limits.max_punycode_input < 0 {
    return UnicodeResult::{
      output: domain,
      is_valid: false,
      first_error: Some(
        IdnaError::{ kind: IdnaErrorKind::LimitExceeded, message: "negative IdnaLimits value", label_index: -1 },
      ),
      error_count: 1,
    }
  }
  let n = domain.length()
  if n > max_in {
    return UnicodeResult::{
      output: domain,
      is_valid: false,
      first_error: Some(
        IdnaError::{ kind: IdnaErrorKind::LimitExceeded, message: "domain exceeds max_input_bytes", label_index: -1 },
      ),
      error_count: 1,
    }
  }
  if n == 0 {
    return UnicodeResult::{
      output: "",
      is_valid: true,
      first_error: None,
      error_count: 0,
    }
  }
  let use_std3 = opts.use_std3_ascii_rules
  let check_hyphens = opts.check_hyphens
  // Packed flags: bit0=has_upper, bit1=has_xn, bit2=has_err
  let mut flags = 0
  let mut label_count = 1
  let mut label_start = 0
  let mut i = 0
  while i < n {
    let b = domain.code_unit_at(i)
    if b >= 97 {
      if b <= 122 {
        i = i + 1
        continue
      }
      if b >= 0x80 {
        return to_unicode_non_ascii_fast(domain, opts, limits)
      }
      if use_std3 {
        flags = flags | 4
      }
      i = i + 1
      continue
    }
    if b == 46 {
      let llen = i - label_start
      if llen > max_lcp {
        return UnicodeResult::{
          output: domain,
          is_valid: false,
          first_error: Some(
            IdnaError::{
              kind: IdnaErrorKind::LimitExceeded,
              message: "label exceeds max_label_codepoints",
              label_index: label_count - 1,
            },
          ),
          error_count: 1,
        }
      }
      if llen >= 4 &&
      domain.code_unit_at(label_start + 2) == 45 &&
      domain.code_unit_at(label_start + 3) == 45 {
        let b0 = domain.code_unit_at(label_start)
        let b1 = domain.code_unit_at(label_start + 1)
        if (b0 == 120 || b0 == 88) && (b1 == 110 || b1 == 78) {
          flags = flags | 2
        } else if check_hyphens {
          flags = flags | 4
        }
      } else if check_hyphens && llen > 0 {
        if domain.code_unit_at(label_start) == 45 || domain.code_unit_at(i - 1) == 45 {
          flags = flags | 4
        }
      }
      label_count = label_count + 1
      if label_count > max_lab {
        return UnicodeResult::{
          output: domain,
          is_valid: false,
          first_error: Some(
            IdnaError::{
              kind: IdnaErrorKind::LimitExceeded,
              message: "domain exceeds max_labels",
              label_index: label_count - 1,
            },
          ),
          error_count: 1,
        }
      }
      label_start = i + 1
    } else if (b >= 48 && b <= 57) || b == 45 {
      ()
    } else if b >= 65 && b <= 90 {
      flags = flags | 1
    } else if use_std3 {
      flags = flags | 4
    }
    i = i + 1
  }
  if (flags & 4) == 0 {
    let last_llen = n - label_start
    if last_llen > max_lcp {
      return UnicodeResult::{
        output: domain,
        is_valid: false,
        first_error: Some(
          IdnaError::{
            kind: IdnaErrorKind::LimitExceeded,
            message: "label exceeds max_label_codepoints",
            label_index: label_count - 1,
          },
        ),
        error_count: 1,
      }
    }
    if last_llen >= 4 &&
    domain.code_unit_at(label_start + 2) == 45 &&
    domain.code_unit_at(label_start + 3) == 45 {
      let b0 = domain.code_unit_at(label_start)
      let b1 = domain.code_unit_at(label_start + 1)
      if (b0 == 120 || b0 == 88) && (b1 == 110 || b1 == 78) {
        flags = flags | 2
      } else if check_hyphens {
        flags = flags | 4
      }
    } else if check_hyphens && last_llen > 0 {
      if domain.code_unit_at(label_start) == 45 || domain.code_unit_at(n - 1) == 45 {
        flags = flags | 4
      }
    }
    if (flags & 4) == 0 {
      if (flags & 2) == 0 {
        let out = if (flags & 1) == 0 {
          domain
        } else {
          let sb = StringBuilder::with_capacity(n)
          let mut k = 0
          while k < n {
            let b = domain.code_unit_at(k)
            if b >= 65 && b <= 90 {
              sb.write_byte((b + 32).to_byte())
            } else {
              sb.write_byte(b.to_byte())
            }
            k = k + 1
          }
          sb.to_string()
        }
        return UnicodeResult::{
          output: out,
          is_valid: true,
          first_error: None,
          error_count: 0,
        }
      }
      return to_unicode_xn_fast(domain, opts, limits)
    }
  }
  to_unicode_slow(domain, opts, limits)
}

///| UTS #46 `ToUnicode` with `IdnaOptions::uts46_strict()` and `IdnaLimits::default()`.
pub fn to_unicode_default(domain : String) -> UnicodeResult {
  to_unicode(domain, IdnaOptions::uts46_strict(), IdnaLimits::default())
}

///| Convert a single domain label (must not contain `.` or UTS #46 dot separators) to ASCII.
pub fn label_to_ascii(
  label : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> Result[String, IdnaError] {
  let n = label.length()
  let mut pos = 0
  while pos < n {
    let b0 = label.code_unit_at(pos)
    if b0 < 0x80 {
      if b0 == 0x002E {
        return Err(IdnaError::{ kind: IdnaErrorKind::DotInLabel, message: "label contains dot separator", label_index: 0 })
      }
      pos = pos + 1
    } else {
      let r = decode_utf8_non_ascii(label, pos, n)
      if r < 0 {
        return Err(IdnaError::{ kind: IdnaErrorKind::InvalidUtf8, message: "invalid UTF-8 in label", label_index: 0 })
      }
      let cp = r & 0x1FFFFF
      if cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61 {
        return Err(IdnaError::{ kind: IdnaErrorKind::DotInLabel, message: "label contains dot separator", label_index: 0 })
      }
      pos = pos + (r >> 21)
    }
  }
  to_ascii(label, opts, limits)
}

///| Convert a single domain label to Unicode (best-effort with error reporting).
pub fn label_to_unicode(
  label : String,
  opts : IdnaOptions,
  limits : IdnaLimits,
) -> UnicodeResult {
  let n = label.length()
  let mut pos = 0
  while pos < n {
    let b0 = label.code_unit_at(pos)
    if b0 < 0x80 {
      if b0 == 0x002E {
        return UnicodeResult::{
          output: label,
          is_valid: false,
          first_error: Some(
            IdnaError::{ kind: IdnaErrorKind::DotInLabel, message: "label contains dot separator", label_index: 0 },
          ),
          error_count: 1,
        }
      }
      pos = pos + 1
    } else {
      let r = decode_utf8_non_ascii(label, pos, n)
      if r < 0 {
        return UnicodeResult::{
          output: label,
          is_valid: false,
          first_error: Some(
            IdnaError::{ kind: IdnaErrorKind::InvalidUtf8, message: "invalid UTF-8 in label", label_index: 0 },
          ),
          error_count: 1,
        }
      }
      let cp = r & 0x1FFFFF
      if cp == 0x3002 || cp == 0xFF0E || cp == 0xFF61 {
        return UnicodeResult::{
          output: label,
          is_valid: false,
          first_error: Some(
            IdnaError::{ kind: IdnaErrorKind::DotInLabel, message: "label contains dot separator", label_index: 0 },
          ),
          error_count: 1,
        }
      }
      pos = pos + (r >> 21)
    }
  }
  to_unicode(label, opts, limits)
}
