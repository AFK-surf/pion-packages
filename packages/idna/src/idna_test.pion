///| Comprehensive Red -> Green unit, spec-vector, UTS #46 / IDNA2008, UTS #39 spoof-defense,
///| and adversarial DoS test suite for `packages/idna`.

fn assert_eq_str(got : String, expected : String) -> Unit {
  debug_assert(got == expected, "expected '" + expected + "', got '" + got + "'")
}

fn assert_eq_int(got : Int, expected : Int) -> Unit {
  debug_assert(got == expected, "expected " + expected.to_string() + ", got " + got.to_string())
}

fn assert_true(cond : Bool) -> Unit {
  debug_assert(cond, "assertion failed")
}

fn assert_ok_str(res : Result[String, IdnaError], expected : String) -> Unit {
  match res {
    Ok(got) => assert_eq_str(got, expected)
    Err(e) => debug_assert(false, "expected Ok(" + expected + "), got Err: " + e.to_string())
  }
}

fn assert_err_kind(res : Result[String, IdnaError], expected : IdnaErrorKind) -> Unit {
  match res {
    Ok(v) => debug_assert(false, "expected Err(" + expected.to_string() + "), got Ok(" + v + ")")
    Err(e) => assert_eq_str(e.kind.to_string(), expected.to_string())
  }
}

fn assert_is_err(res : Result[String, IdnaError]) -> Unit {
  match res {
    Ok(v) => debug_assert(false, "expected Err, got Ok(" + v + ")")
    Err(_) => ()
  }
}

fn has_reason(reasons : Array[SpoofReason], target : SpoofReason) -> Bool {
  let mut i = 0
  while i < reasons.length() {
    if reasons[i].eq(target) {
      return true
    }
    i = i + 1
  }
  false
}

// =========================================================================
// 1. RFC 3492 Punycode Test Vectors & Edge Cases
// =========================================================================

test "punycode_rfc3492_arabic_egyptian" {
  let u = "ليهمابتكلموشعربي؟"
  let p = "egbpdaj6bu4bxfgehfvwxn"
  assert_ok_str(punycode_encode(u), p)
  assert_ok_str(punycode_decode(p), u)
}

test "punycode_rfc3492_chinese_simplified_and_traditional" {
  let s_u = "他们为什么不说中文"
  let s_p = "ihqwcrb4cv8a8dqg056pqjye"
  assert_ok_str(punycode_encode(s_u), s_p)
  assert_ok_str(punycode_decode(s_p), s_u)

  let t_u = "他們爲什麽不說中文"
  let t_p = "ihqwctvzc91f659drss3x8bo0yb"
  assert_ok_str(punycode_encode(t_u), t_p)
  assert_ok_str(punycode_decode(t_p), t_u)
}

test "punycode_rfc3492_czech_russian_japanese_korean" {
  assert_ok_str(
    punycode_encode("Pročprostěnemluvíčesky"),
    "Proprostnemluvesky-uyb24dma41a",
  )
  assert_ok_str(
    punycode_decode("Proprostnemluvesky-uyb24dma41a"),
    "Pročprostěnemluvíčesky",
  )

  let ru_u = "почемужеонинеговорятпорусски"
  let ru_p = "b1abfaaepdrnnbgefbadotcwatmq2g4l"
  assert_ok_str(punycode_encode(ru_u), ru_p)
  assert_ok_str(punycode_decode(ru_p), ru_u)

  let jp_u = "3年B組金八先生"
  let jp_p = "3B-ww4c5e180e575a65lsy2b"
  assert_ok_str(punycode_encode(jp_u), jp_p)
  assert_ok_str(punycode_decode(jp_p), jp_u)

  let kr_u = "세계의모든사람들이한국어를이해한다면얼마나좋을까"
  let kr_p = "989aomsvi5e83db1d2a355cv1e0vak1dwrv93d5xbh15a0dt30a5jpsd879ccm6fea98c"
  assert_ok_str(punycode_encode(kr_u), kr_p)
  assert_ok_str(punycode_decode(kr_p), kr_u)
}

test "punycode_rfc3492_mixed_ascii_and_emoji" {
  assert_ok_str(punycode_encode("münchen"), "mnchen-3ya")
  assert_ok_str(punycode_decode("mnchen-3ya"), "münchen")
  assert_ok_str(punycode_encode("🚀"), "158h")
  assert_ok_str(punycode_decode("158h"), "🚀")
  assert_ok_str(punycode_encode("abc"), "abc-")
  assert_ok_str(punycode_decode("abc-"), "abc")
}

test "punycode_decode_malformed_overflow_and_surrogates" {
  assert_err_kind(punycode_decode("mnchen-3y!"), IdnaErrorKind::InvalidPunycode)
  assert_err_kind(punycode_decode("münchen"), IdnaErrorKind::InvalidPunycode)
  assert_err_kind(punycode_decode("zzzz"), IdnaErrorKind::InvalidPunycode)
  assert_err_kind(punycode_decode("99999999999999a"), IdnaErrorKind::PunycodeOverflow)
  assert_is_err(punycode_decode("999999a"))
}

// =========================================================================
// 2. UTS #46 Core Mapping, Case Folding, Dots, NFC, Punycode Round-Trip
// =========================================================================

test "uts46_basic_ascii_and_multilingual_domains" {
  assert_ok_str(to_ascii_default("EXAMPLE.COM"), "example.com")
  assert_ok_str(to_ascii_default("münchen.de"), "xn--mnchen-3ya.de")
  assert_ok_str(to_ascii_default("MÜNCHEN.DE"), "xn--mnchen-3ya.de")
  assert_ok_str(to_ascii_default("中文.com"), "xn--fiq228c.com")
  assert_ok_str(to_ascii_default("日本語.jp"), "xn--wgv71a119e.jp")
  assert_ok_str(to_ascii_default("한국어.kr"), "xn--3e0bk47br7k.kr")
  assert_ok_str(to_ascii_default("www.ร้าน.ไทย"), "www.xn--q3ct9b5e.xn--o3cw4h")
  assert_ok_str(to_ascii_default("ＥＸＡＭＰＬＥ。ＣＯＭ"), "example.com")
}

test "uts46_nfc_normalization_and_roundtrip" {
  let nfd_cafe = "cafe\u{0301}.fr"
  assert_ok_str(to_ascii_default(nfd_cafe), "xn--caf-dma.fr")
  let ures = to_unicode_default("xn--caf-dma.fr")
  assert_true(ures.is_valid)
  assert_eq_str(ures.output, "café.fr")
}

test "uts46_transitional_vs_non_transitional" {
  assert_ok_str(
    to_ascii("faß.de", IdnaOptions::uts46_non_transitional(), IdnaLimits::default()),
    "xn--fa-hia.de",
  )
  assert_ok_str(
    to_ascii("faß.de", IdnaOptions::uts46_transitional(), IdnaLimits::default()),
    "fass.de",
  )
  let nt_sigma = to_ascii("βόλος.com", IdnaOptions::uts46_non_transitional(), IdnaLimits::default())
  let tr_sigma = to_ascii("βόλος.com", IdnaOptions::uts46_transitional(), IdnaLimits::default())
  assert_ok_str(nt_sigma, "xn--nxasmm1c.com")
  assert_ok_str(tr_sigma, "xn--nxasmq6b.com")
}

test "uts46_std3_ascii_rules" {
  assert_err_kind(
    to_ascii("_dmarc.example.com", IdnaOptions::uts46_strict(), IdnaLimits::default()),
    IdnaErrorKind::DisallowedCodePoint,
  )
  assert_ok_str(
    to_ascii("_dmarc.example.com", IdnaOptions::uts46_url(), IdnaLimits::default()),
    "_dmarc.example.com",
  )
}

test "uts46_check_hyphens" {
  let strict = IdnaOptions::uts46_strict()
  let url = IdnaOptions::uts46_url()
  assert_err_kind(to_ascii("-example.com", strict, IdnaLimits::default()), IdnaErrorKind::InvalidHyphens)
  assert_err_kind(to_ascii("example-.com", strict, IdnaLimits::default()), IdnaErrorKind::InvalidHyphens)
  assert_err_kind(to_ascii("ab--cd.com", strict, IdnaLimits::default()), IdnaErrorKind::InvalidHyphens)
  assert_ok_str(to_ascii("-example.com", url, IdnaLimits::default()), "-example.com")
  assert_ok_str(to_ascii("ab--cd.com", url, IdnaLimits::default()), "ab--cd.com")
}

test "uts46_verify_dns_length" {
  let strict = IdnaOptions::uts46_strict()
  let url = IdnaOptions::uts46_url()
  let l63 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let l64 = l63 + "a"
  assert_ok_str(to_ascii(l63 + ".com", strict, IdnaLimits::default()), l63 + ".com")
  assert_err_kind(to_ascii(l64 + ".com", strict, IdnaLimits::default()), IdnaErrorKind::LabelTooLong)
  assert_ok_str(to_ascii(l64 + ".com", url, IdnaLimits::default()), l64 + ".com")
  assert_err_kind(to_ascii("a..b.com", strict, IdnaLimits::default()), IdnaErrorKind::EmptyLabel)
  assert_ok_str(to_ascii("example.com.", strict, IdnaLimits::default()), "example.com.")
}

test "uts46_leading_combining_mark_and_punycode_dot_injection" {
  assert_err_kind(
    to_ascii("\u{0300}a.com", IdnaOptions::uts46_strict(), IdnaLimits::default()),
    IdnaErrorKind::LeadingCombiningMark,
  )
  let evil = match punycode_encode("a\u{3002}b") {
    Ok(p) => "xn--" + p + ".com"
    Err(_) => {
      debug_assert(false, "encode failed")
      ""
    }
  }
  assert_err_kind(
    to_ascii(evil, IdnaOptions::uts46_url(), IdnaLimits::default()),
    IdnaErrorKind::DotInLabel,
  )
}

test "uts46_ignore_invalid_punycode_flag" {
  let base = IdnaOptions::uts46_url()
  let opts = IdnaOptions::{
    use_std3_ascii_rules: base.use_std3_ascii_rules,
    check_hyphens: base.check_hyphens,
    check_bidi: base.check_bidi,
    check_joiners: base.check_joiners,
    check_contexto: base.check_contexto,
    verify_dns_length: base.verify_dns_length,
    transitional_processing: base.transitional_processing,
    ignore_invalid_punycode: true,
    deny_dot_in_label: base.deny_dot_in_label,
  }
  assert_is_err(to_ascii("xn--zzzz.com", IdnaOptions::uts46_url(), IdnaLimits::default()))
  assert_ok_str(to_ascii("xn--zzzz.com", opts, IdnaLimits::default()), "xn--zzzz.com")
}

// =========================================================================
// 3. IDNA2008: CheckBidi (RFC 5893), ContextJ (RFC 5892), ContextO (RFC 5892)
// =========================================================================

test "idna2008_check_bidi_rules" {
  let strict = IdnaOptions::uts46_strict()
  assert_ok_str(to_ascii("مثال.إختبار", strict, IdnaLimits::default()), "xn--mgbh0fb.xn--kgbechtv")
  assert_err_kind(to_ascii("אa.com", strict, IdnaLimits::default()), IdnaErrorKind::InvalidBidi)
  assert_err_kind(to_ascii("aא.com", strict, IdnaLimits::default()), IdnaErrorKind::InvalidBidi)
  assert_err_kind(to_ascii("مثال1٠.com", strict, IdnaLimits::default()), IdnaErrorKind::InvalidBidi)
  let no_bidi = IdnaOptions::{
    use_std3_ascii_rules: false,
    check_hyphens: false,
    check_bidi: false,
    check_joiners: false,
    check_contexto: false,
    verify_dns_length: false,
    transitional_processing: false,
    ignore_invalid_punycode: false,
    deny_dot_in_label: true,
  }
  assert_ok_str(to_ascii("אa.com", no_bidi, IdnaLimits::default()), "xn--a-zhc.com")
}

test "idna2008_check_joiners_contextj" {
  let strict = IdnaOptions::uts46_strict()
  assert_err_kind(to_ascii("a\u{200C}b.com", strict, IdnaLimits::default()), IdnaErrorKind::InvalidJoiner)
  assert_err_kind(to_ascii("a\u{200D}b.com", strict, IdnaLimits::default()), IdnaErrorKind::InvalidJoiner)
  assert_ok_str(
    to_ascii("\u{0915}\u{094D}\u{200C}\u{0937}.com", strict, IdnaLimits::default()),
    "xn--11b2ezcs70k.com",
  )
  assert_ok_str(
    to_ascii("\u{0915}\u{094D}\u{200D}\u{0937}.com", strict, IdnaLimits::default()),
    "xn--11b2ezcw70k.com",
  )
  assert_ok_str(
    to_ascii("\u{0628}\u{200C}\u{0628}.com", strict, IdnaLimits::default()),
    "xn--ngba799q.com",
  )
}

test "idna2008_check_contexto_rules" {
  let strict = IdnaOptions::uts46_strict()
  assert_ok_str(to_ascii("l\u{00B7}l.cat", strict, IdnaLimits::default()), "xn--ll-0ea.cat")
  assert_err_kind(to_ascii("a\u{00B7}a.cat", strict, IdnaLimits::default()), IdnaErrorKind::InvalidContextO)
  assert_err_kind(to_ascii("\u{00B7}l.cat", strict, IdnaLimits::default()), IdnaErrorKind::InvalidContextO)

  assert_ok_str(to_ascii("\u{0375}\u{03B1}.gr", strict, IdnaLimits::default()), "xn--wva4j.gr")
  assert_err_kind(to_ascii("\u{0375}a.gr", strict, IdnaLimits::default()), IdnaErrorKind::InvalidContextO)

  assert_ok_str(to_ascii("\u{05D0}\u{05F3}.il", strict, IdnaLimits::default()), "xn--4db4e.il")
  assert_err_kind(to_ascii("a\u{05F3}.il", strict, IdnaLimits::default()), IdnaErrorKind::InvalidContextO)

  assert_ok_str(to_ascii("ア\u{30FB}イ.jp", strict, IdnaLimits::default()), "xn--ccke4x.jp")
  assert_err_kind(to_ascii("a\u{30FB}b.jp", strict, IdnaLimits::default()), IdnaErrorKind::InvalidContextO)

  assert_err_kind(
    to_ascii("\u{0628}\u{0660}\u{06F0}.com", strict, IdnaLimits::default()),
    IdnaErrorKind::InvalidContextO,
  )
}

test "uts46_to_unicode_best_effort_and_label_apis" {
  let u1 = to_unicode_default("xn--mnchen-3ya.de")
  assert_true(u1.is_valid)
  assert_eq_str(u1.output, "münchen.de")
  assert_eq_int(u1.error_count, 0)

  let u2 = to_unicode_default("-bad.xn--mnchen-3ya.de")
  assert_true(!u2.is_valid)
  assert_true(u2.error_count > 0)
  assert_eq_str(u2.output, "-bad.münchen.de")

  assert_ok_str(
    label_to_ascii("münchen", IdnaOptions::uts46_strict(), IdnaLimits::default()),
    "xn--mnchen-3ya",
  )
  assert_err_kind(
    label_to_ascii("a.b", IdnaOptions::uts46_strict(), IdnaLimits::default()),
    IdnaErrorKind::DotInLabel,
  )
  let lu = label_to_unicode("xn--mnchen-3ya", IdnaOptions::uts46_strict(), IdnaLimits::default())
  assert_true(lu.is_valid)
  assert_eq_str(lu.output, "münchen")
}

// =========================================================================
// 4. UTS #39 Skeleton, Confusables, Script Detection & Browser Omnibox Defense
// =========================================================================

test "uts39_skeleton_and_are_confusable" {
  assert_eq_str(skeleton("p\u{0430}ypal"), skeleton("paypal"))
  assert_true(are_confusable("p\u{0430}ypal.com", "paypal.com"))
  assert_true(are_confusable("\u{0430}\u{0440}\u{0440}l\u{0435}.com", "apple.com"))
  assert_true(are_confusable("\u{0430}\u{0440}\u{0440}\u{04CF}\u{0435}.com", "appie.com"))
  assert_true(are_confusable("g\u{03BF}\u{03BF}gle.com", "google.com"))
  assert_true(!are_confusable("apple.com", "apple.com"))
  assert_true(!are_confusable("apple.com", "orange.com"))
}

test "uts39_detect_scripts_and_mixed_script" {
  let s_lat = detect_scripts("example")
  assert_eq_int(s_lat.length(), 1)
  assert_eq_str(s_lat[0].to_string(), "Latin")
  assert_true(!is_mixed_script("example"))

  let s_mix = detect_scripts("p\u{0430}ypal")
  assert_eq_int(s_mix.length(), 2)
  assert_true(is_mixed_script("p\u{0430}ypal"))

  let s_han = detect_scripts("中文")
  assert_eq_int(s_han.length(), 1)
  assert_eq_str(s_han[0].to_string(), "Han")
  assert_true(!is_mixed_script("中文"))
}

test "uts39_display_domain_blocks_phishing_attacks" {
  let d1 = display_domain_default("p\u{0430}ypal.com")
  assert_true(d1.is_punycode_fallback)
  assert_eq_str(d1.display, "xn--pypal-4ve.com")
  assert_eq_str(d1.ascii, "xn--pypal-4ve.com")
  assert_true(has_reason(d1.reasons, SpoofReason::MixedScript))

  let d2 = display_domain_default("\u{0430}\u{0440}\u{0440}\u{04CF}\u{0435}.com")
  assert_true(d2.is_punycode_fallback)
  assert_eq_str(d2.display, d2.ascii)
  assert_true(has_reason(d2.reasons, SpoofReason::WholeScriptConfusable))

  let d3 = display_domain_default("g\u{03BF}\u{03BF}gle.com")
  assert_true(d3.is_punycode_fallback)
  assert_eq_str(d3.display, d3.ascii)
  assert_true(has_reason(d3.reasons, SpoofReason::MixedScript))

  let d4 = display_domain_default("xn--pypal-4ve.com")
  assert_true(d4.is_punycode_fallback)
  assert_eq_str(d4.display, "xn--pypal-4ve.com")
  assert_true(has_reason(d4.reasons, SpoofReason::MixedScript))
}

test "uts39_display_domain_allows_legitimate_multilingual_domains" {
  let d0 = display_domain_default("example.com")
  assert_true(!d0.is_punycode_fallback)
  assert_eq_str(d0.display, "example.com")
  assert_eq_int(d0.reasons.length(), 0)

  let d1 = display_domain_default("中文.com")
  assert_true(!d1.is_punycode_fallback)
  assert_eq_str(d1.display, "中文.com")
  assert_eq_str(d1.ascii, "xn--fiq228c.com")

  let d2 = display_domain_default("日本語.jp")
  assert_true(!d2.is_punycode_fallback)
  assert_eq_str(d2.display, "日本語.jp")

  let d3 = display_domain_default("한국어.kr")
  assert_true(!d3.is_punycode_fallback)
  assert_eq_str(d3.display, "한국어.kr")

  let d4 = display_domain_default("münchen.de")
  assert_true(!d4.is_punycode_fallback)
  assert_eq_str(d4.display, "münchen.de")

  let d5 = display_domain_default("café.fr")
  assert_true(!d5.is_punycode_fallback)
  assert_eq_str(d5.display, "café.fr")

  let d6 = display_domain_default("www.ร้าน.ไทย")
  assert_true(!d6.is_punycode_fallback)
  assert_eq_str(d6.display, "www.ร้าน.ไทย")

  let d7 = display_domain_default("abc中文.com")
  assert_true(!d7.is_punycode_fallback)
  assert_eq_str(d7.display, "abc中文.com")
}

test "uts39_display_domain_mixed_numbers_and_strict_ascii_policy" {
  let d_num = display_domain_default("test1\u{0967}.com")
  assert_true(d_num.is_punycode_fallback)
  assert_true(has_reason(d_num.reasons, SpoofReason::MixedNumberingSystems))

  let d_asc = display_domain("münchen.de", DisplayPolicy::strict_ascii_only())
  assert_true(d_asc.is_punycode_fallback)
  assert_eq_str(d_asc.display, "xn--mnchen-3ya.de")
}

// =========================================================================
// 5. DoS Guardrails, Limits & Adversarial Edge Cases
// =========================================================================

test "limits_negative_and_zero_enforcement" {
  let neg_bytes = IdnaLimits::{
    max_input_bytes: -1,
    max_labels: 128,
    max_label_codepoints: 1000,
    max_punycode_input: 2000,
  }
  assert_err_kind(
    to_ascii("example.com", IdnaOptions::uts46_strict(), neg_bytes),
    IdnaErrorKind::LimitExceeded,
  )
  assert_err_kind(punycode_encode_with_limits("abc", neg_bytes), IdnaErrorKind::LimitExceeded)
  assert_err_kind(punycode_decode_with_limits("abc-", neg_bytes), IdnaErrorKind::LimitExceeded)

  let zero_bytes = IdnaLimits::{
    max_input_bytes: 0,
    max_labels: 128,
    max_label_codepoints: 1000,
    max_punycode_input: 2000,
  }
  assert_err_kind(
    to_ascii("a", IdnaOptions::uts46_strict(), zero_bytes),
    IdnaErrorKind::LimitExceeded,
  )

  let small_labels = IdnaLimits::{
    max_input_bytes: 4096,
    max_labels: 2,
    max_label_codepoints: 1000,
    max_punycode_input: 2000,
  }
  assert_ok_str(to_ascii("a.b", IdnaOptions::uts46_strict(), small_labels), "a.b")
  assert_err_kind(
    to_ascii("a.b.c", IdnaOptions::uts46_strict(), small_labels),
    IdnaErrorKind::LimitExceeded,
  )

  let small_puny = IdnaLimits::{
    max_input_bytes: 4096,
    max_labels: 128,
    max_label_codepoints: 4,
    max_punycode_input: 4,
  }
  assert_err_kind(
    punycode_decode_with_limits("mnchen-3ya", small_puny),
    IdnaErrorKind::LimitExceeded,
  )
  assert_err_kind(
    punycode_encode_with_limits("münchen", small_puny),
    IdnaErrorKind::LimitExceeded,
  )
}

test "dos_empty_and_deep_labels_and_punycode_bomb" {
  assert_err_kind(
    to_ascii("", IdnaOptions::uts46_strict(), IdnaLimits::default()),
    IdnaErrorKind::EmptyInput,
  )
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 140 {
    if i > 0 {
      sb.write_byte((46).to_byte())
    }
    sb.write_byte((97).to_byte())
    i = i + 1
  }
  assert_err_kind(
    to_ascii(sb.to_string(), IdnaOptions::uts46_url(), IdnaLimits::default()),
    IdnaErrorKind::LimitExceeded,
  )
}

test "punycode_rejects_empty_non_ascii_and_not_nfc_in_uts46" {
  assert_is_err(to_ascii("xn--abc-.com", IdnaOptions::uts46_url(), IdnaLimits::default()))
  let nfd_puny = match punycode_encode("e\u{0301}") {
    Ok(p) => "xn--" + p + ".com"
    Err(_) => {
      debug_assert(false, "encode failed")
      ""
    }
  }
  assert_err_kind(
    to_ascii(nfd_puny, IdnaOptions::uts46_url(), IdnaLimits::default()),
    IdnaErrorKind::PunycodeNotNfc,
  )
}

test "uts46_case_insensitive_xn_prefix_and_label_separators" {
  assert_ok_str(to_ascii_default("XN--MNCHEN-3YA.DE"), "xn--mnchen-3ya.de")
  let u = to_unicode_default("XN--MNCHEN-3YA.DE")
  assert_true(u.is_valid)
  assert_eq_str(u.output, "münchen.de")
  assert_ok_str(to_ascii_default("a\u{FF0E}b\u{3002}c\u{FF61}com"), "a.b.c.com")
}

test "uts39_invisible_and_zero_width_spoof_detection" {
  let d = display_domain_default("\u{0628}\u{200C}\u{0628}.com")
  assert_true(d.is_punycode_fallback)
  assert_true(has_reason(d.reasons, SpoofReason::InvisibleCodePoint))
}

test "uts39_cyrillic_non_confusable_allowed" {
  let d = display_domain_default("привет.рф")
  assert_true(!d.is_punycode_fallback)
  assert_eq_str(d.display, "привет.рф")
  assert_eq_str(d.ascii, "xn--b1agh1afp.xn--p1ai")
}

test "uts46_domain_max_length_253_vs_254" {
  let strict = IdnaOptions::uts46_strict()
  let l61 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let ok251 = l61 + "." + l61 + "." + l61 + "." + l61 + ".com"
  assert_ok_str(to_ascii(ok251, strict, IdnaLimits::default()), ok251)
  assert_ok_str(to_ascii(ok251 + ".", strict, IdnaLimits::default()), ok251 + ".")
  let l63 = l61 + "aa"
  let too_long = l63 + "." + l63 + "." + l63 + "." + l63
  assert_err_kind(to_ascii(too_long, strict, IdnaLimits::default()), IdnaErrorKind::DomainTooLong)
}
