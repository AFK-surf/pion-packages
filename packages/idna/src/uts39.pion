///| UTS #39 Unicode Security Mechanisms: confusable skeleton, script detection,
///| mixed-script / whole-script confusable detection, and browser Omnibox `display_domain`.

fn reverse_int_range(arr : Array[Int], start : Int, end_excl : Int) -> Unit {
  let mut l = start
  let mut r = end_excl - 1
  while l < r {
    let tmp = arr[l]
    arr[l] = arr[r]
    arr[r] = tmp
    l = l + 1
    r = r - 1
  }
}

fn bidi_canon_bracket(cp : Int) -> Int {
  if cp == 0x2329 {
    0x3008
  } else if cp == 0x232A {
    0x3009
  } else {
    cp
  }
}

fn bidi_strong_dir(t : Int) -> Int {
  if t == 0 {
    0
  } else if t == 1 || t == 3 || t == 6 {
    1
  } else {
    -1
  }
}

fn bidi_is_neutral(t : Int) -> Bool {
  t >= 9
}

fn bidi_is_isolate_init(t : Int) -> Bool {
  t == 19 || t == 20 || t == 21
}

fn bidi_is_isolate_char(t : Int) -> Bool {
  t == 19 || t == 20 || t == 21 || t == 22
}

///| Resolve W1-W7, N0 (paired brackets), and N1-N2 on one UBA isolating run sequence `idx`.
fn bidi_resolve_run(
  types : FixedArray[Int],
  orig : FixedArray[Int],
  cps : Array[Int],
  idx : Array[Int],
  run_level : Int,
  sos : Int,
  eos : Int,
) -> Unit {
  let n = idx.length()
  if n == 0 {
    return
  }
  let t : FixedArray[Int] = FixedArray::make(n, 0)
  let mut k = 0
  while k < n {
    t[k] = types[idx[k]]
    k = k + 1
  }
  // W1: NSM takes the type of the preceding character (or ON after isolate initiator/PDI, or sos at start).
  let mut prev = sos
  k = 0
  while k < n {
    if t[k] == 8 {
      if k > 0 && bidi_is_isolate_char(orig[idx[k - 1]]) {
        t[k] = 10
      } else {
        t[k] = prev
      }
    }
    prev = t[k]
    k = k + 1
  }
  // W2: EN -> AN if last strong type was AL.
  let mut last = sos
  k = 0
  while k < n {
    let tk = t[k]
    if tk == 0 || tk == 1 || tk == 2 {
      last = tk
    } else if tk == 3 && last == 2 {
      t[k] = 6
    }
    k = k + 1
  }
  // W3: AL -> R.
  k = 0
  while k < n {
    if t[k] == 2 {
      t[k] = 1
    }
    k = k + 1
  }
  // W4: single ES between EN/EN -> EN; single CS between EN/EN -> EN or AN/AN -> AN.
  k = 1
  while k + 1 < n {
    let tk = t[k]
    if tk == 4 && t[k - 1] == 3 && t[k + 1] == 3 {
      t[k] = 3
    } else if tk == 7 && t[k - 1] == t[k + 1] && (t[k - 1] == 3 || t[k - 1] == 6) {
      t[k] = t[k - 1]
    }
    k = k + 1
  }
  // W5: ET sequences adjacent to EN -> EN.
  k = 0
  while k < n {
    if t[k] == 5 {
      let mut j = k
      while j < n && t[j] == 5 {
        j = j + 1
      }
      if (k > 0 && t[k - 1] == 3) || (j < n && t[j] == 3) {
        let mut q = k
        while q < j {
          t[q] = 3
          q = q + 1
        }
      }
      k = j
    } else {
      k = k + 1
    }
  }
  // W6: remaining ES, ET, CS -> ON.
  k = 0
  while k < n {
    let tk = t[k]
    if tk == 4 || tk == 5 || tk == 7 {
      t[k] = 10
    }
    k = k + 1
  }
  // W7: EN -> L if last strong type (or sos) was L.
  last = sos
  k = 0
  while k < n {
    let tk = t[k]
    if tk == 0 || tk == 1 {
      last = tk
    } else if tk == 3 && last == 0 {
      t[k] = 0
    }
    k = k + 1
  }
  let embed_dir = if (run_level & 1) == 1 { 1 } else { 0 }
  let opp_dir = 1 - embed_dir
  // N0: Paired brackets (BD16, max stack depth 63).
  let stack_cp : Array[Int] = []
  let stack_pos : Array[Int] = []
  let pair_open : Array[Int] = []
  let pair_close : Array[Int] = []
  k = 0
  while k < n {
    if t[k] == 10 {
      let cp = cps[idx[k]]
      let binfo = unicode_bidi_bracket(cp)
      if binfo >= 0 {
        let is_open = (binfo & 1) == 1
        let other = binfo >> 1
        if is_open {
          if stack_cp.length() >= 63 {
            break
          }
          stack_cp.push(bidi_canon_bracket(other))
          stack_pos.push(k)
        } else {
          let cc = bidi_canon_bracket(cp)
          let mut s = stack_cp.length() - 1
          while s >= 0 {
            if stack_cp[s] == cc {
              pair_open.push(stack_pos[s])
              pair_close.push(k)
              while stack_cp.length() > s {
                let _ = stack_cp.pop()
                let _ = stack_pos.pop()
              }
              break
            }
            s = s - 1
          }
        }
      }
    }
    k = k + 1
  }
  // Sort pairs by opening position (insertion sort; at most 63 nesting / small count).
  let num_pairs = pair_open.length()
  let mut pi = 1
  while pi < num_pairs {
    let po = pair_open[pi]
    let pc = pair_close[pi]
    let mut pj = pi - 1
    while pj >= 0 && pair_open[pj] > po {
      pair_open[pj + 1] = pair_open[pj]
      pair_close[pj + 1] = pair_close[pj]
      pj = pj - 1
    }
    pair_open[pj + 1] = po
    pair_close[pj + 1] = pc
    pi = pi + 1
  }
  pi = 0
  while pi < num_pairs {
    let o = pair_open[pi]
    let c = pair_close[pi]
    let mut has_embed = false
    let mut has_opp = false
    let mut q = o + 1
    while q < c {
      let sd = bidi_strong_dir(t[q])
      if sd == embed_dir {
        has_embed = true
        break
      } else if sd == opp_dir {
        has_opp = true
      }
      q = q + 1
    }
    let newt = if has_embed {
      embed_dir
    } else if has_opp {
      let mut before = sos
      let mut bq = o - 1
      while bq >= 0 {
        let sd = bidi_strong_dir(t[bq])
        if sd >= 0 {
          before = sd
          break
        }
        bq = bq - 1
      }
      if before != embed_dir {
        before
      } else {
        embed_dir
      }
    } else {
      -1
    }
    if newt >= 0 {
      t[o] = newt
      let mut r = o + 1
      while r < n && orig[idx[r]] == 8 {
        t[r] = newt
        r = r + 1
      }
      t[c] = newt
      r = c + 1
      while r < n && orig[idx[r]] == 8 {
        t[r] = newt
        r = r + 1
      }
    }
    pi = pi + 1
  }
  // N1 / N2: resolve neutral runs.
  k = 0
  while k < n {
    if bidi_is_neutral(t[k]) {
      let mut j = k
      while j < n && bidi_is_neutral(t[j]) {
        j = j + 1
      }
      let left = if k == 0 {
        sos
      } else {
        let sd = bidi_strong_dir(t[k - 1])
        if sd >= 0 { sd } else { t[k - 1] }
      }
      let right = if j == n {
        eos
      } else {
        let sd = bidi_strong_dir(t[j])
        if sd >= 0 { sd } else { t[j] }
      }
      let resolved = if left == right { left } else { embed_dir }
      let mut q = k
      while q < j {
        t[q] = resolved
        q = q + 1
      }
      k = j
    } else {
      k = k + 1
    }
  }
  k = 0
  while k < n {
    types[idx[k]] = t[k]
    k = k + 1
  }
}

///| Apply UAX #9 (Unicode 16.0.0) LTR visual reordering (P1, X1-X10 incl. isolates X5a-X5c /
///| X6a / BD9 / BD13, W1-W7, N0, N1-N2, I1-I2, L1, L2) plus UTS #39 16.0 §4 L3 (combining
///| marks after base) and L4 (Bidi_Mirroring_Glyph).
///| Fast-paths inputs with no RTL or explicit RTL embedding/override/isolate code points.
fn bidi_reorder_ltr(cps : Array[Int]) -> Array[Int] {
  let n = cps.length()
  if n <= 1 {
    return cps
  }
  // Bidi classes: 0=L, 1=R, 2=AL, 3=EN, 4=ES, 5=ET, 6=AN, 7=CS, 8=NSM, 9=BN, 10=ON,
  // 11=WS, 12=S, 13=B, 14=LRE, 15=RLE, 16=LRO, 17=RLO, 18=PDF, 19=LRI, 20=RLI, 21=FSI, 22=PDI.
  let mut has_rtl = false
  let mut has_para_sep = false
  let mut i = 0
  while i < n {
    let bc = unicode_bidi_class(cps[i])
    if bc == 1 || bc == 2 || bc == 6 || bc == 15 || bc == 17 || bc == 20 {
      has_rtl = true
    } else if bc == 13 {
      has_para_sep = true
    }
    i = i + 1
  }
  if !has_rtl {
    return cps
  }
  // P1: split on paragraph separators (B=13), each paragraph at level 0.
  if has_para_sep {
    let out : Array[Int] = []
    let mut start = 0
    i = 0
    while i <= n {
      if i == n || unicode_bidi_class(cps[i]) == 13 {
        if i > start {
          let seg : Array[Int] = []
          let mut k = start
          while k < i {
            seg.push(cps[k])
            k = k + 1
          }
          let reordered = bidi_reorder_ltr(seg)
          k = 0
          while k < reordered.length() {
            out.push(reordered[k])
            k = k + 1
          }
        }
        if i < n {
          out.push(cps[i])
        }
        start = i + 1
      }
      i = i + 1
    }
    return out
  }
  let orig : FixedArray[Int] = FixedArray::make(n, 0)
  let types : FixedArray[Int] = FixedArray::make(n, 0)
  let levels : FixedArray[Int] = FixedArray::make(n, 0)
  let removed : FixedArray[Bool] = FixedArray::make(n, false)
  let match_pdi : FixedArray[Int] = FixedArray::make(n, -1)
  i = 0
  while i < n {
    let bc = unicode_bidi_class(cps[i])
    orig[i] = bc
    types[i] = bc
    i = i + 1
  }
  // BD9: matching PDI for each isolate initiator (LRI=19, RLI=20, FSI=21).
  let iso_stack : Array[Int] = []
  i = 0
  while i < n {
    let x = orig[i]
    if bidi_is_isolate_init(x) {
      iso_stack.push(i)
    } else if x == 22 && iso_stack.length() > 0 {
      let open_idx = iso_stack[iso_stack.length() - 1]
      let _ = iso_stack.pop()
      match_pdi[open_idx] = i
    }
    i = i + 1
  }
  // X1-X8: explicit embeddings, overrides, and isolates.
  let st_lvl : Array[Int] = [0]
  let st_ovr : Array[Int] = [0] // 0=None, 1=L, 2=R
  let st_iso : Array[Bool] = [false]
  let mut over_iso = 0
  let mut over_emb = 0
  let mut valid_iso = 0
  i = 0
  while i < n {
    let x = orig[i]
    if x == 14 || x == 15 || x == 16 || x == 17 {
      let cur = st_lvl[st_lvl.length() - 1]
      let next_lvl = if x == 15 || x == 17 { (cur + 1) | 1 } else { (cur + 2) & (-2) }
      if next_lvl <= 125 && over_iso == 0 && over_emb == 0 {
        st_lvl.push(next_lvl)
        let ovr = if x == 16 { 1 } else if x == 17 { 2 } else { 0 }
        st_ovr.push(ovr)
        st_iso.push(false)
      } else if over_iso == 0 {
        over_emb = over_emb + 1
      }
      removed[i] = true
      levels[i] = st_lvl[st_lvl.length() - 1]
    } else if x == 18 {
      if over_iso > 0 {
        ()
      } else if over_emb > 0 {
        over_emb = over_emb - 1
      } else if !st_iso[st_iso.length() - 1] && st_lvl.length() >= 2 {
        let _ = st_lvl.pop()
        let _ = st_ovr.pop()
        let _ = st_iso.pop()
      }
      removed[i] = true
      levels[i] = st_lvl[st_lvl.length() - 1]
    } else if x == 9 {
      removed[i] = true
      levels[i] = st_lvl[st_lvl.length() - 1]
    } else if bidi_is_isolate_init(x) {
      let top_idx = st_lvl.length() - 1
      levels[i] = st_lvl[top_idx]
      let ovr = st_ovr[top_idx]
      if ovr == 1 {
        types[i] = 0
      } else if ovr == 2 {
        types[i] = 1
      }
      let mut rtl = x == 20
      if x == 21 {
        // X5c / P2-P3: FSI determines direction from first strong L/R/AL before matching PDI.
        let end = if match_pdi[i] >= 0 { match_pdi[i] } else { n }
        let mut depth = 0
        let mut q = i + 1
        while q < end {
          let y = orig[q]
          if bidi_is_isolate_init(y) {
            depth = depth + 1
          } else if y == 22 && depth > 0 {
            depth = depth - 1
          } else if depth == 0 && (y == 0 || y == 1 || y == 2) {
            rtl = y != 0
            break
          }
          q = q + 1
        }
      }
      let cur = st_lvl[top_idx]
      let next_lvl = if rtl { (cur + 1) | 1 } else { (cur + 2) & (-2) }
      if next_lvl <= 125 && over_iso == 0 && over_emb == 0 {
        valid_iso = valid_iso + 1
        st_lvl.push(next_lvl)
        st_ovr.push(0)
        st_iso.push(true)
      } else {
        over_iso = over_iso + 1
      }
    } else if x == 22 {
      if over_iso > 0 {
        over_iso = over_iso - 1
      } else if valid_iso > 0 {
        over_emb = 0
        while st_iso.length() > 1 && !st_iso[st_iso.length() - 1] {
          let _ = st_lvl.pop()
          let _ = st_ovr.pop()
          let _ = st_iso.pop()
        }
        if st_lvl.length() > 1 {
          let _ = st_lvl.pop()
          let _ = st_ovr.pop()
          let _ = st_iso.pop()
        }
        valid_iso = valid_iso - 1
      }
      let top_idx = st_lvl.length() - 1
      levels[i] = st_lvl[top_idx]
      let ovr = st_ovr[top_idx]
      if ovr == 1 {
        types[i] = 0
      } else if ovr == 2 {
        types[i] = 1
      }
    } else {
      let top_idx = st_lvl.length() - 1
      levels[i] = st_lvl[top_idx]
      let ovr = st_ovr[top_idx]
      if ovr == 1 {
        types[i] = 0
      } else if ovr == 2 {
        types[i] = 1
      }
    }
    i = i + 1
  }
  // X10 / BD13: build level runs of non-removed characters and chain into isolating run sequences.
  let keep : Array[Int] = []
  let pos_in_keep : FixedArray[Int] = FixedArray::make(n, -1)
  let runs : Array[Array[Int]] = []
  i = 0
  while i < n {
    if !removed[i] {
      pos_in_keep[i] = keep.length()
      keep.push(i)
      let rlen = runs.length()
      if rlen > 0 {
        let last_run = runs[rlen - 1]
        if levels[last_run[last_run.length() - 1]] == levels[i] {
          last_run.push(i)
        } else {
          runs.push([i])
        }
      } else {
        runs.push([i])
      }
    }
    i = i + 1
  }
  let num_runs = runs.length()
  let start_of : FixedArray[Int] = FixedArray::make(n, -1)
  let mut r = 0
  while r < num_runs {
    start_of[runs[r][0]] = r
    r = r + 1
  }
  let used : FixedArray[Bool] = FixedArray::make(num_runs, false)
  let seqs : Array[Array[Int]] = []
  r = 0
  while r < num_runs {
    if !used[r] {
      used[r] = true
      let seq : Array[Int] = []
      let mut q = 0
      while q < runs[r].length() {
        seq.push(runs[r][q])
        q = q + 1
      }
      while true {
        let last_i = seq[seq.length() - 1]
        if !bidi_is_isolate_init(orig[last_i]) {
          break
        }
        let pdi_i = match_pdi[last_i]
        if pdi_i < 0 {
          break
        }
        let next_r = start_of[pdi_i]
        if next_r < 0 || used[next_r] {
          break
        }
        used[next_r] = true
        q = 0
        while q < runs[next_r].length() {
          seq.push(runs[next_r][q])
          q = q + 1
        }
      }
      seqs.push(seq)
    }
    r = r + 1
  }
  let keep_len = keep.length()
  let num_seqs = seqs.length()
  let mut si = 0
  while si < num_seqs {
    let idx = seqs[si]
    let lv = levels[idx[0]]
    let p0 = pos_in_keep[idx[0]]
    let pv = if p0 > 0 { levels[keep[p0 - 1]] } else { 0 }
    let last_i = idx[idx.length() - 1]
    let p1 = pos_in_keep[last_i]
    let nv = if bidi_is_isolate_init(orig[last_i]) {
      0
    } else if p1 + 1 < keep_len {
      levels[keep[p1 + 1]]
    } else {
      0
    }
    let max_p = if lv > pv { lv } else { pv }
    let max_n = if lv > nv { lv } else { nv }
    let sos = if (max_p & 1) == 1 { 1 } else { 0 }
    let eos = if (max_n & 1) == 1 { 1 } else { 0 }
    bidi_resolve_run(types, orig, cps, idx, lv, sos, eos)
    si = si + 1
  }
  // I1 / I2: implicit levels.
  i = 0
  while i < n {
    if !removed[i] {
      let lv = levels[i]
      let tk = types[i]
      if (lv & 1) == 0 {
        if tk == 1 {
          levels[i] = lv + 1
        } else if tk == 3 || tk == 6 {
          levels[i] = lv + 2
        }
      } else if tk == 0 || tk == 3 || tk == 6 {
        levels[i] = lv + 1
      }
    }
    i = i + 1
  }
  // UAX #9 §5.2: removed characters take the level of the preceding character.
  i = 0
  while i < n {
    if removed[i] {
      levels[i] = if i > 0 { levels[i - 1] } else { 0 }
    }
    i = i + 1
  }
  // L1: trailing whitespace / BN / isolate controls / removed (and before S=12) reset to level 0.
  let mut j = n - 1
  while j >= 0 && (orig[j] == 11 || orig[j] == 9 || bidi_is_isolate_char(orig[j]) || removed[j]) {
    levels[j] = 0
    j = j - 1
  }
  i = 0
  while i < n {
    if orig[i] == 12 {
      levels[i] = 0
      j = i - 1
      while j >= 0 && (orig[j] == 11 || orig[j] == 9 || bidi_is_isolate_char(orig[j]) || removed[j]) {
        levels[j] = 0
        j = j - 1
      }
    }
    i = i + 1
  }
  // L2: reverse contiguous runs at level >= lvl from max_level down to min_odd_level.
  let order : Array[Int] = []
  let mut max_level = 0
  let mut min_odd = 127
  i = 0
  while i < n {
    order.push(i)
    let lv = levels[i]
    if lv > max_level {
      max_level = lv
    }
    if (lv & 1) == 1 && lv < min_odd {
      min_odd = lv
    }
    i = i + 1
  }
  if min_odd > max_level {
    min_odd = 1
  }
  let mut lvl = max_level
  while lvl >= min_odd {
    i = 0
    while i < n {
      if levels[order[i]] >= lvl {
        let mut end = i + 1
        while end < n && levels[order[end]] >= lvl {
          end = end + 1
        }
        reverse_int_range(order, i, end)
        i = end
      } else {
        i = i + 1
      }
    }
    lvl = lvl - 1
  }
  // L3: combining marks of an RTL run now precede their base; move them after it in logical order.
  i = 0
  while i < n {
    let p = order[i]
    if unicode_is_mark(cps[p]) && (levels[p] & 1) == 1 {
      let mut end = i
      while end < n && unicode_is_mark(cps[order[end]]) && (levels[order[end]] & 1) == 1 {
        end = end + 1
      }
      if end < n && (levels[order[end]] & 1) == 1 {
        let base = order[end]
        // Reverse marks order[i..end], shift right by 1, put base at order[i].
        reverse_int_range(order, i, end)
        let mut q = end
        while q > i {
          order[q] = order[q - 1]
          q = q - 1
        }
        order[i] = base
        i = end + 1
        continue
      }
      i = end
    } else {
      i = i + 1
    }
  }
  // L4: replace mirrored glyphs at odd levels using BidiMirroring.txt.
  let res : Array[Int] = []
  i = 0
  while i < n {
    let p = order[i]
    let cp = cps[p]
    if (levels[p] & 1) == 1 {
      res.push(unicode_bidi_mirror(cp))
    } else {
      res.push(cp)
    }
    i = i + 1
  }
  res
}

///| Compute the UTS #39 16.0 §4 `skeleton(X)` = `bidiSkeleton(LTR, X)` =
///| `NFD(prototype_map(remove_default_ignorable(NFD(uba_ltr_reorder(X)))))`
///| using Unicode 16.0.0 `confusables.txt`.
pub fn skeleton(input : String) -> String {
  let n = input.length()
  if n == 0 {
    return ""
  }
  let cps : Array[Int] = []
  let mut pos = 0
  while pos < n {
    let (cp, next, _) = decode_utf8_strict(input, pos, n)
    cps.push(cp)
    pos = next
  }
  let reordered = bidi_reorder_ltr(cps)
  let nfd1 = nfd_normalize(reordered)
  let mapped : Array[Int] = []
  let mut i = 0
  let m = nfd1.length()
  while i < m {
    let cp = nfd1[i]
    if unicode_is_default_ignorable(cp) {
      i = i + 1
      continue
    }
    let info = unicode_confusable_info(cp)
    if info < 0 {
      mapped.push(cp)
    } else if (info & 1) == 0 {
      mapped.push(info >> 1)
    } else {
      let packed = info >> 1
      let off = packed & 0xFFFF
      let len = packed >> 16
      let mut k = 0
      while k < len {
        mapped.push(conf_pool[off + k])
        k = k + 1
      }
    }
    i = i + 1
  }
  let nfd2 = nfd_normalize(mapped)
  cps_to_string(nfd2)
}

///| Return true if `a` and `b` are distinct strings with identical UTS #39 confusable skeletons.
pub fn are_confusable(a : String, b : String) -> Bool {
  if a == b {
    return false
  }
  skeleton(a) == skeleton(b)
}

fn contains_int(arr : Array[Int], v : Int) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == v {
      return true
    }
    i = i + 1
  }
  false
}

///| Return the distinct non-Common, non-Inherited Unicode scripts present in `label`.
pub fn detect_scripts(label : String) -> Array[Script] {
  let ids : Array[Int] = []
  let n = label.length()
  let mut pos = 0
  while pos < n {
    let (cp, next, _) = decode_utf8_strict(label, pos, n)
    pos = next
    let sid = unicode_script_id(cp)
    if sid != 0 && sid != 1 && !contains_int(ids, sid) {
      ids.push(sid)
    }
  }
  let out : Array[Script] = []
  let mut i = 0
  while i < ids.length() {
    out.push(Script::from_id(ids[i]))
    i = i + 1
  }
  out
}

///| Return true if `label` mixes two or more distinct scripts (ignoring Common and Inherited).
pub fn is_mixed_script(label : String) -> Bool {
  detect_scripts(label).length() > 1
}

///| Check whether a set of script IDs is allowed under UTS #39 Highly Restrictive rules.
///| Script IDs: 2=Latin, 5=Han, 6=Hiragana, 7=Katakana, 8=Hangul, 30=Bopomofo.
fn script_set_is_allowed(ids : Array[Int], allow_mixed_latin_cjk : Bool) -> Bool {
  let n = ids.length()
  if n <= 1 {
    return true
  }
  if !allow_mixed_latin_cjk {
    return false
  }
  // Check Japanese: subset of {Latin(2), Han(5), Hiragana(6), Katakana(7)}
  let mut ok_jp = true
  let mut ok_kr = true
  let mut ok_zh = true
  let mut i = 0
  while i < n {
    let s = ids[i]
    if s != 2 && s != 5 && s != 6 && s != 7 {
      ok_jp = false
    }
    if s != 2 && s != 5 && s != 8 {
      ok_kr = false
    }
    if s != 2 && s != 5 && s != 30 {
      ok_zh = false
    }
    i = i + 1
  }
  ok_jp || ok_kr || ok_zh
}

fn push_reason_unique(reasons : Array[SpoofReason], r : SpoofReason) -> Unit {
  let mut i = 0
  while i < reasons.length() {
    if reasons[i].eq(r) {
      return
    }
    i = i + 1
  }
  reasons.push(r)
}

fn is_pure_ascii_str(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) >= 0x80 {
      return false
    }
    i = i + 1
  }
  true
}

///| Small-capital Latin prototype code points that visually spoof ASCII Latin letters
///| (e.g. Cyrillic н -> U+029C ʜ, в -> U+0299 ʙ, т -> U+1D1B ᴛ).
fn is_latin_small_cap_lookalike(cp : Int) -> Bool {
  cp == 0x0299 ||
  cp == 0x029C ||
  cp == 0x1D00 ||
  cp == 0x1D04 ||
  cp == 0x1D07 ||
  cp == 0x1D0A ||
  cp == 0x1D0B ||
  cp == 0x1D0D ||
  cp == 0x1D0F ||
  cp == 0x1D18 ||
  cp == 0x1D1B ||
  cp == 0x1D1C ||
  cp == 0x1D20 ||
  cp == 0x1D21 ||
  cp == 0x1D22
}

///| Return true if `sk` (a UTS #39 skeleton) consists exclusively of ASCII or small-capital Latin
///| look-alikes once non-overlay combining marks (ccc != 1) are ignored.
fn is_ascii_latin_skeleton_ignoring_marks(sk : String) -> Bool {
  let n = sk.length()
  if n == 0 {
    return false
  }
  let mut has_base = false
  let mut pos = 0
  while pos < n {
    let (cp, next, _) = decode_utf8_strict(sk, pos, n)
    pos = next
    if unicode_is_mark(cp) && unicode_ccc(cp) != 1 {
      continue
    }
    has_base = true
    if cp >= 0x80 && !is_latin_small_cap_lookalike(cp) {
      return false
    }
  }
  has_base
}

///| Return true if `tld` is a native TLD for `script_id` (same-script IDN TLD or common ccTLD).
fn is_native_script_tld(script_id : Int, tld : String, tld_scripts : Array[Int]) -> Bool {
  if contains_int(tld_scripts, script_id) {
    return true
  }
  if script_id == 4 {
    // Cyrillic ccTLDs per Chrome IDN policy
    tld == "bg" || tld == "by" || tld == "kz" || tld == "mk" || tld == "rs" || tld == "ru" || tld == "ua"
  } else if script_id == 3 {
    // Greek ccTLDs
    tld == "gr" || tld == "cy"
  } else {
    false
  }
}

///| Chrome kDangerousPattern CJK slash/dash look-alikes (excluding ー U+30FC, handled separately):
///| ノ ソ ゾ ン 丶 乀 乁 丿 一.
fn is_cjk_slash_dash_lookalike(cp : Int) -> Bool {
  cp == 0x30CE ||
  cp == 0x30BD ||
  cp == 0x30BE ||
  cp == 0x30F3 ||
  cp == 0x4E36 ||
  cp == 0x4E40 ||
  cp == 0x4E41 ||
  cp == 0x4E3F ||
  cp == 0x4E00
}

///| Return true if `cp` is a CJK script character or CJK-specific punctuation/iteration mark.
fn is_cjk_context_cp(cp : Int) -> Bool {
  let sid = unicode_script_id(cp)
  sid == 5 ||
  sid == 6 ||
  sid == 7 ||
  sid == 8 ||
  sid == 30 ||
  cp == 0x30FC ||
  cp == 0x30FB ||
  cp == 0x3005 ||
  cp == 0x3006 ||
  cp == 0x3007
}

fn upper_hex_byte(v : Int) -> Byte {
  if v < 10 {
    (48 + v).to_byte()
  } else {
    (55 + v).to_byte()
  }
}

///| Escape an invalid IDN domain into printable ASCII (`%XX` for non-ASCII / control bytes)
///| so `display_domain` never echoes raw attacker-controlled characters (RLO, U+2044, etc.).
fn escape_invalid_display(domain : String, max_bytes : Int) -> String {
  let n = domain.length()
  if n == 0 || (max_bytes >= 0 && n > max_bytes) {
    return ""
  }
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    let b = domain.code_unit_at(i) & 255
    if b >= 0x20 && b <= 0x7E {
      sb.write_byte(b.to_byte())
    } else {
      sb.write_byte((37).to_byte())
      sb.write_byte(upper_hex_byte(b >> 4))
      sb.write_byte(upper_hex_byte(b & 15))
    }
    i = i + 1
  }
  sb.to_string()
}

fn detect_script_ids(label : String) -> Array[Int] {
  let ids : Array[Int] = []
  let n = label.length()
  let mut pos = 0
  while pos < n {
    let (cp, next, _) = decode_utf8_strict(label, pos, n)
    pos = next
    let sid = unicode_script_id(cp)
    if sid != 0 && sid != 1 && !contains_int(ids, sid) {
      ids.push(sid)
    }
  }
  ids
}

///| Inspect a single Unicode label for UTS #39 browser omnibox spoofing signals.
fn check_label_spoof(
  label : String,
  tld : String,
  tld_scripts : Array[Int],
  policy : DisplayPolicy,
  reasons : Array[SpoofReason],
) -> Unit {
  let n = label.length()
  if n == 0 {
    return
  }
  let cps : Array[Int] = []
  let script_ids : Array[Int] = []
  let num_systems : Array[Int] = []
  let mut has_non_ascii = false
  let mut has_latin = false
  let mut has_restricted_non_ascii = false
  let mut pos = 0
  while pos < n {
    let (cp, next, _) = decode_utf8_strict(label, pos, n)
    pos = next
    cps.push(cp)
    if cp >= 0x80 {
      has_non_ascii = true
      if !unicode_is_identifier_allowed(cp) {
        has_restricted_non_ascii = true
      }
    }
    if policy.check_invisible && (unicode_is_default_ignorable(cp) || (cp >= 0x0335 && cp <= 0x0338)) {
      push_reason_unique(reasons, SpoofReason::InvisibleCodePoint)
    }
    if policy.check_mixed_numbers {
      let ns = unicode_decimal_digit_system(cp)
      if ns >= 0 && !contains_int(num_systems, ns) {
        num_systems.push(ns)
      }
    }
    let sid = unicode_script_id(cp)
    if sid == 2 {
      has_latin = true
    }
    if sid != 0 && sid != 1 && !contains_int(script_ids, sid) {
      script_ids.push(sid)
    }
  }
  if policy.check_mixed_numbers && num_systems.length() > 1 {
    push_reason_unique(reasons, SpoofReason::MixedNumberingSystems)
  }
  if !script_set_is_allowed(script_ids, policy.allow_mixed_latin_cjk) {
    push_reason_unique(reasons, SpoofReason::MixedScript)
  }
  // Chrome kDangerousPattern CJK slash/dash rules:
  // - ノ ソ ゾ ン 丶 乀 乁 丿 一: flag only when no neighbour is a CJK character.
  // - ー (U+30FC): flag only when not immediately preceded by Hiragana (6) or Katakana (7).
  let clen = cps.length()
  let mut ci = 0
  while ci < clen {
    let c = cps[ci]
    if is_cjk_slash_dash_lookalike(c) {
      let left_is_cjk = ci > 0 && is_cjk_context_cp(cps[ci - 1])
      let right_is_cjk = ci + 1 < clen && is_cjk_context_cp(cps[ci + 1])
      if clen > 1 && !left_is_cjk && !right_is_cjk {
        push_reason_unique(reasons, SpoofReason::MixedScript)
        break
      }
    } else if c == 0x30FC {
      let prev_sid = if ci > 0 { unicode_script_id(cps[ci - 1]) } else { 0 }
      if prev_sid != 6 && prev_sid != 7 {
        push_reason_unique(reasons, SpoofReason::MixedScript)
        break
      }
    }
    ci = ci + 1
  }
  // Whole-script confusable: pure non-Latin label whose UTS #39 skeleton is all ASCII
  // (or, for Cyrillic outside native Cyrillic TLDs/ccTLDs, ASCII/small-cap Latin ignoring
  // non-overlay diacritics, catching соӧр.com / ѕсһӧн.de while keeping αθήνα.gr / тест.bg readable).
  if policy.check_whole_script_confusable && has_non_ascii && !has_latin && script_ids.length() == 1 {
    let sk = skeleton(label)
    let sid = script_ids[0]
    let native_tld = is_native_script_tld(sid, tld, tld_scripts)
    let is_conf = if sid == 4 && !native_tld {
      is_ascii_latin_skeleton_ignoring_marks(sk)
    } else {
      sk.length() > 0 && is_pure_ascii_str(sk)
    }
    if is_conf {
      push_reason_unique(reasons, SpoofReason::WholeScriptConfusable)
    }
  }
  // Single-script Latin homoglyph guard: non-ASCII Latin label containing a UTS #39 Restricted
  // character (e.g. ɡ ɑ ᴏ) whose skeleton is pure ASCII, while Allowed orthography (æ œ ı)
  // and accented Latin (münchen, café, bücher) remain readable.
  if policy.check_whole_script_confusable && has_non_ascii && has_latin && has_restricted_non_ascii && script_ids.length() == 1 {
    let sk = skeleton(label)
    if sk.length() > 0 && is_pure_ascii_str(sk) {
      push_reason_unique(reasons, SpoofReason::WholeScriptConfusable)
    }
  }
}

///| Authoritative browser Omnibox IDN display decision (UTS #46 + UTS #39 anti-spoofing).
pub fn display_domain(domain : String, policy : DisplayPolicy) -> DisplayDecision {
  let ascii = match to_ascii(domain, policy.idna_options, policy.limits) {
    Ok(a) => a
    Err(_) => {
      return DisplayDecision::{
        display: escape_invalid_display(domain, policy.limits.max_input_bytes),
        ascii: "",
        is_punycode_fallback: true,
        reasons: [SpoofReason::InvalidIdna],
      }
    }
  }
  let uni = to_unicode(ascii, policy.idna_options, policy.limits)
  if !uni.is_valid {
    return DisplayDecision::{
      display: ascii,
      ascii: ascii,
      is_punycode_fallback: true,
      reasons: [SpoofReason::InvalidIdna],
    }
  }
  let has_idn = uni.output != ascii
  if policy.ascii_only {
    return DisplayDecision::{
      display: ascii,
      ascii: ascii,
      is_punycode_fallback: has_idn,
      reasons: [],
    }
  }
  if !has_idn {
    return DisplayDecision::{
      display: ascii,
      ascii: ascii,
      is_punycode_fallback: false,
      reasons: [],
    }
  }
  // Split normalized Unicode domain into labels, determine TLD scripts, and run UTS #39 checks per label
  let reasons : Array[SpoofReason] = []
  let u = uni.output
  let un = u.length()
  let label_list : Array[String] = []
  let mut ls = 0
  let mut i = 0
  while i <= un {
    if i == un || u.code_unit_at(i) == 46 {
      label_list.push(u.slice(ls, i))
      ls = i + 1
    }
    i = i + 1
  }
  let mut tld = ""
  let mut ti = label_list.length() - 1
  while ti >= 0 {
    if label_list[ti].length() > 0 {
      tld = label_list[ti]
      break
    }
    ti = ti - 1
  }
  let tld_scripts = detect_script_ids(tld)
  i = 0
  while i < label_list.length() {
    check_label_spoof(label_list[i], tld, tld_scripts, policy, reasons)
    i = i + 1
  }
  if reasons.length() > 0 {
    DisplayDecision::{
      display: ascii,
      ascii: ascii,
      is_punycode_fallback: true,
      reasons: reasons,
    }
  } else {
    DisplayDecision::{
      display: u,
      ascii: ascii,
      is_punycode_fallback: false,
      reasons: [],
    }
  }
}

///| Browser Omnibox IDN display decision using `DisplayPolicy::browser_default()`.
pub fn display_domain_default(domain : String) -> DisplayDecision {
  display_domain(domain, DisplayPolicy::browser_default())
}
