///| UTS #39 Unicode Security Mechanisms: confusable skeleton, script detection,
///| mixed-script / whole-script confusable detection, and browser Omnibox `display_domain`.

fn reverse_int_range(arr : Array[Int], start : Int, end_excl : Int) -> Unit {
  let mut l = start
  let mut r = end_excl - 1
  while l < r {
    let tmp = arr[l]
    arr[l] = arr[r]
    arr[r] = tmp
    l = l + 1
    r = r - 1
  }
}

///| Apply UAX #9 (Unicode Bidirectional Algorithm) LTR visual reordering (paragraph level 0)
///| for UTS #39 16.0 §4 `bidiSkeleton(LTR, X)`. Fast-paths inputs with no RTL code points.
fn bidi_reorder_ltr(cps : Array[Int]) -> Array[Int] {
  let n = cps.length()
  if n <= 1 {
    return cps
  }
  let mut has_rtl = false
  let mut i = 0
  while i < n {
    let bc = unicode_bidi_class(cps[i])
    if bc == 1 || bc == 2 || bc == 6 {
      has_rtl = true
      break
    }
    i = i + 1
  }
  if !has_rtl {
    return cps
  }
  // Bidi classes: 0=L, 1=R, 2=AL, 3=EN, 4=ES, 5=ET, 6=AN, 7=CS, 8=NSM, 9=BN, 10=ON, 11=OTHER
  let types : FixedArray[Int] = FixedArray::make(n, 0)
  i = 0
  while i < n {
    types[i] = unicode_bidi_class(cps[i])
    i = i + 1
  }
  // W1: NSM takes the type of the preceding character (or ON at start).
  let mut prev = 10
  i = 0
  while i < n {
    if types[i] == 8 {
      types[i] = prev
    } else if types[i] != 9 {
      prev = types[i]
    }
    i = i + 1
  }
  // W2: EN changes to AN if the last strong type was AL.
  // W3: AL changes to R.
  let mut last_strong = 0
  i = 0
  while i < n {
    let t = types[i]
    if t == 0 || t == 1 || t == 2 {
      last_strong = t
      if t == 2 {
        types[i] = 1
      }
    } else if t == 3 && last_strong == 2 {
      types[i] = 6
    }
    i = i + 1
  }
  // W4: single ES between EN/EN -> EN; single CS between EN/EN -> EN or AN/AN -> AN.
  i = 1
  while i + 1 < n {
    let t = types[i]
    if t == 4 && types[i - 1] == 3 && types[i + 1] == 3 {
      types[i] = 3
    } else if t == 7 && types[i - 1] == 3 && types[i + 1] == 3 {
      types[i] = 3
    } else if t == 7 && types[i - 1] == 6 && types[i + 1] == 6 {
      types[i] = 6
    }
    i = i + 1
  }
  // W5: ET sequences adjacent to EN become EN.
  i = 0
  while i < n {
    if types[i] == 5 {
      let mut j = i
      while j < n && types[j] == 5 {
        j = j + 1
      }
      let adj_en = (i > 0 && types[i - 1] == 3) || (j < n && types[j] == 3)
      if adj_en {
        let mut k = i
        while k < j {
          types[k] = 3
          k = k + 1
        }
      }
      i = j
    } else {
      i = i + 1
    }
  }
  // W6: remaining ES, ET, CS -> ON.
  i = 0
  while i < n {
    let t = types[i]
    if t == 4 || t == 5 || t == 7 {
      types[i] = 10
    }
    i = i + 1
  }
  // W7: EN -> L if last strong type (or sos=L) was L.
  last_strong = 0
  i = 0
  while i < n {
    let t = types[i]
    if t == 0 || t == 1 {
      last_strong = t
    } else if t == 3 && last_strong == 0 {
      types[i] = 0
    }
    i = i + 1
  }
  // N1 & N2: resolve neutral sequences (ON=10, BN=9, OTHER=11) with sos=L, eos=L (paragraph level 0).
  i = 0
  while i < n {
    let t = types[i]
    if t == 9 || t == 10 || t == 11 {
      let mut j = i
      while j < n && (types[j] == 9 || types[j] == 10 || types[j] == 11) {
        j = j + 1
      }
      let left_dir = if i == 0 {
        0
      } else if types[i - 1] == 0 {
        0
      } else {
        1
      }
      let right_dir = if j == n {
        0
      } else if types[j] == 0 {
        0
      } else {
        1
      }
      let resolved = if left_dir == right_dir { left_dir } else { 0 }
      let mut k = i
      while k < j {
        types[k] = resolved
        k = k + 1
      }
      i = j
    } else {
      i = i + 1
    }
  }
  // I1 (even paragraph level 0): L -> 0, R -> 1, EN/AN -> 2.
  let levels : FixedArray[Int] = FixedArray::make(n, 0)
  let mut max_level = 0
  i = 0
  while i < n {
    let t = types[i]
    let lvl = if t == 1 {
      1
    } else if t == 3 || t == 6 {
      2
    } else {
      0
    }
    levels[i] = lvl
    if lvl > max_level {
      max_level = lvl
    }
    i = i + 1
  }
  let out : Array[Int] = []
  i = 0
  while i < n {
    out.push(cps[i])
    i = i + 1
  }
  // L2: reverse contiguous runs at level >= lvl from max_level down to 1.
  let mut lvl = max_level
  while lvl >= 1 {
    i = 0
    while i < n {
      if levels[i] >= lvl {
        let mut j = i + 1
        while j < n && levels[j] >= lvl {
          j = j + 1
        }
        reverse_int_range(out, i, j)
        i = j
      } else {
        i = i + 1
      }
    }
    lvl = lvl - 1
  }
  out
}

///| Compute the UTS #39 16.0 §4 `skeleton(X)` = `bidiSkeleton(LTR, X)` =
///| `NFD(prototype_map(remove_default_ignorable(NFD(uba_ltr_reorder(X)))))`
///| using Unicode 16.0.0 `confusables.txt`.
pub fn skeleton(input : String) -> String {
  let n = input.length()
  if n == 0 {
    return ""
  }
  let cps : Array[Int] = []
  let mut pos = 0
  while pos < n {
    let (cp, next, _) = decode_utf8_strict(input, pos, n)
    cps.push(cp)
    pos = next
  }
  let reordered = bidi_reorder_ltr(cps)
  let nfd1 = nfd_normalize(reordered)
  let mapped : Array[Int] = []
  let mut i = 0
  let m = nfd1.length()
  while i < m {
    let cp = nfd1[i]
    if unicode_is_default_ignorable(cp) {
      i = i + 1
      continue
    }
    let info = unicode_confusable_info(cp)
    if info < 0 {
      mapped.push(cp)
    } else if (info & 1) == 0 {
      mapped.push(info >> 1)
    } else {
      let packed = info >> 1
      let off = packed & 0xFFFF
      let len = packed >> 16
      let mut k = 0
      while k < len {
        mapped.push(conf_pool[off + k])
        k = k + 1
      }
    }
    i = i + 1
  }
  let nfd2 = nfd_normalize(mapped)
  cps_to_string(nfd2)
}

///| Return true if `a` and `b` are distinct strings with identical UTS #39 confusable skeletons.
pub fn are_confusable(a : String, b : String) -> Bool {
  if a == b {
    return false
  }
  skeleton(a) == skeleton(b)
}

fn contains_int(arr : Array[Int], v : Int) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == v {
      return true
    }
    i = i + 1
  }
  false
}

///| Return the distinct non-Common, non-Inherited Unicode scripts present in `label`.
pub fn detect_scripts(label : String) -> Array[Script] {
  let ids : Array[Int] = []
  let n = label.length()
  let mut pos = 0
  while pos < n {
    let (cp, next, _) = decode_utf8_strict(label, pos, n)
    pos = next
    let sid = unicode_script_id(cp)
    if sid != 0 && sid != 1 && !contains_int(ids, sid) {
      ids.push(sid)
    }
  }
  let out : Array[Script] = []
  let mut i = 0
  while i < ids.length() {
    out.push(Script::from_id(ids[i]))
    i = i + 1
  }
  out
}

///| Return true if `label` mixes two or more distinct scripts (ignoring Common and Inherited).
pub fn is_mixed_script(label : String) -> Bool {
  detect_scripts(label).length() > 1
}

///| Check whether a set of script IDs is allowed under UTS #39 Highly Restrictive rules.
///| Script IDs: 2=Latin, 5=Han, 6=Hiragana, 7=Katakana, 8=Hangul, 30=Bopomofo.
fn script_set_is_allowed(ids : Array[Int], allow_mixed_latin_cjk : Bool) -> Bool {
  let n = ids.length()
  if n <= 1 {
    return true
  }
  if !allow_mixed_latin_cjk {
    return false
  }
  // Check Japanese: subset of {Latin(2), Han(5), Hiragana(6), Katakana(7)}
  let mut ok_jp = true
  let mut ok_kr = true
  let mut ok_zh = true
  let mut i = 0
  while i < n {
    let s = ids[i]
    if s != 2 && s != 5 && s != 6 && s != 7 {
      ok_jp = false
    }
    if s != 2 && s != 5 && s != 8 {
      ok_kr = false
    }
    if s != 2 && s != 5 && s != 30 {
      ok_zh = false
    }
    i = i + 1
  }
  ok_jp || ok_kr || ok_zh
}

fn push_reason_unique(reasons : Array[SpoofReason], r : SpoofReason) -> Unit {
  let mut i = 0
  while i < reasons.length() {
    if reasons[i].eq(r) {
      return
    }
    i = i + 1
  }
  reasons.push(r)
}

fn is_pure_ascii_str(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) >= 0x80 {
      return false
    }
    i = i + 1
  }
  true
}

///| Small-capital Latin prototype code points that visually spoof ASCII Latin letters
///| (e.g. Cyrillic н -> U+029C ʜ, в -> U+0299 ʙ, т -> U+1D1B ᴛ).
fn is_latin_small_cap_lookalike(cp : Int) -> Bool {
  cp == 0x0299 ||
  cp == 0x029C ||
  cp == 0x1D00 ||
  cp == 0x1D04 ||
  cp == 0x1D07 ||
  cp == 0x1D0A ||
  cp == 0x1D0B ||
  cp == 0x1D0D ||
  cp == 0x1D0F ||
  cp == 0x1D18 ||
  cp == 0x1D1B ||
  cp == 0x1D1C ||
  cp == 0x1D20 ||
  cp == 0x1D21 ||
  cp == 0x1D22
}

///| Return true if `sk` (a UTS #39 skeleton) consists exclusively of ASCII or small-capital Latin
///| look-alikes once combining marks (diacritics) are ignored.
fn is_ascii_latin_skeleton_ignoring_marks(sk : String) -> Bool {
  let n = sk.length()
  if n == 0 {
    return false
  }
  let mut has_base = false
  let mut pos = 0
  while pos < n {
    let (cp, next, _) = decode_utf8_strict(sk, pos, n)
    pos = next
    if unicode_is_mark(cp) {
      continue
    }
    has_base = true
    if cp >= 0x80 && !is_latin_small_cap_lookalike(cp) {
      return false
    }
  }
  has_base
}

///| Chrome kDangerousPattern CJK slash/dash look-alikes: ノ ソ ゾ ン 丶 乀 乁 丿 一 ー.
fn is_cjk_slash_dash_lookalike(cp : Int) -> Bool {
  cp == 0x30CE ||
  cp == 0x30BD ||
  cp == 0x30BE ||
  cp == 0x30F3 ||
  cp == 0x30FC ||
  cp == 0x4E36 ||
  cp == 0x4E40 ||
  cp == 0x4E41 ||
  cp == 0x4E3F ||
  cp == 0x4E00
}

///| Return true if `cp` is a CJK script character or CJK-specific punctuation/iteration mark.
fn is_cjk_context_cp(cp : Int) -> Bool {
  let sid = unicode_script_id(cp)
  sid == 5 ||
  sid == 6 ||
  sid == 7 ||
  sid == 8 ||
  sid == 30 ||
  cp == 0x30FC ||
  cp == 0x30FB ||
  cp == 0x3005 ||
  cp == 0x3006 ||
  cp == 0x3007
}

fn upper_hex_byte(v : Int) -> Byte {
  if v < 10 {
    (48 + v).to_byte()
  } else {
    (55 + v).to_byte()
  }
}

///| Escape an invalid IDN domain into printable ASCII (`%XX` for non-ASCII / control bytes)
///| so `display_domain` never echoes raw attacker-controlled characters (RLO, U+2044, etc.).
fn escape_invalid_display(domain : String, max_bytes : Int) -> String {
  let n = domain.length()
  if n == 0 || (max_bytes >= 0 && n > max_bytes) {
    return ""
  }
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    let b = domain.code_unit_at(i) & 255
    if b >= 0x20 && b <= 0x7E {
      sb.write_byte(b.to_byte())
    } else {
      sb.write_byte((37).to_byte())
      sb.write_byte(upper_hex_byte(b >> 4))
      sb.write_byte(upper_hex_byte(b & 15))
    }
    i = i + 1
  }
  sb.to_string()
}

///| Inspect a single Unicode label for UTS #39 browser omnibox spoofing signals.
fn check_label_spoof(
  label : String,
  policy : DisplayPolicy,
  reasons : Array[SpoofReason],
) -> Unit {
  let n = label.length()
  if n == 0 {
    return
  }
  let cps : Array[Int] = []
  let script_ids : Array[Int] = []
  let num_systems : Array[Int] = []
  let mut has_non_ascii = false
  let mut has_latin = false
  let mut pos = 0
  while pos < n {
    let (cp, next, _) = decode_utf8_strict(label, pos, n)
    pos = next
    cps.push(cp)
    if cp >= 0x80 {
      has_non_ascii = true
    }
    if policy.check_invisible && (unicode_is_default_ignorable(cp) || (cp >= 0x0335 && cp <= 0x0338)) {
      push_reason_unique(reasons, SpoofReason::InvisibleCodePoint)
    }
    if policy.check_mixed_numbers {
      let ns = unicode_decimal_digit_system(cp)
      if ns >= 0 && !contains_int(num_systems, ns) {
        num_systems.push(ns)
      }
    }
    let sid = unicode_script_id(cp)
    if sid == 2 {
      has_latin = true
    }
    if sid != 0 && sid != 1 && !contains_int(script_ids, sid) {
      script_ids.push(sid)
    }
  }
  if policy.check_mixed_numbers && num_systems.length() > 1 {
    push_reason_unique(reasons, SpoofReason::MixedNumberingSystems)
  }
  if !script_set_is_allowed(script_ids, policy.allow_mixed_latin_cjk) {
    push_reason_unique(reasons, SpoofReason::MixedScript)
  }
  // CJK slash/dash look-alikes adjacent to non-CJK characters (Chrome kDangerousPattern).
  let clen = cps.length()
  let mut ci = 0
  while ci < clen {
    if is_cjk_slash_dash_lookalike(cps[ci]) {
      let left_non_cjk = ci > 0 && !is_cjk_context_cp(cps[ci - 1])
      let right_non_cjk = ci + 1 < clen && !is_cjk_context_cp(cps[ci + 1])
      if left_non_cjk || right_non_cjk {
        push_reason_unique(reasons, SpoofReason::MixedScript)
        break
      }
    }
    ci = ci + 1
  }
  // Whole-script confusable: pure non-Latin label whose UTS #39 skeleton (ignoring diacritics)
  // is all ASCII / Latin look-alikes!
  if policy.check_whole_script_confusable && has_non_ascii && !has_latin && script_ids.length() == 1 {
    let sk = skeleton(label)
    if sk.length() > 0 && is_ascii_latin_skeleton_ignoring_marks(sk) {
      push_reason_unique(reasons, SpoofReason::WholeScriptConfusable)
    }
  }
  // Single-script Latin homoglyph guard: non-ASCII Latin label whose UTS #39 skeleton is pure ASCII
  // (e.g. gooɡle, ɑpple, faceboᴏk), while accented Latin (münchen, café, bücher) keeps non-ASCII marks.
  if policy.check_whole_script_confusable && has_non_ascii && has_latin && script_ids.length() == 1 {
    let sk = skeleton(label)
    if sk.length() > 0 && is_pure_ascii_str(sk) {
      push_reason_unique(reasons, SpoofReason::WholeScriptConfusable)
    }
  }
}

///| Authoritative browser Omnibox IDN display decision (UTS #46 + UTS #39 anti-spoofing).
pub fn display_domain(domain : String, policy : DisplayPolicy) -> DisplayDecision {
  let ascii = match to_ascii(domain, policy.idna_options, policy.limits) {
    Ok(a) => a
    Err(_) => {
      return DisplayDecision::{
        display: escape_invalid_display(domain, policy.limits.max_input_bytes),
        ascii: "",
        is_punycode_fallback: true,
        reasons: [SpoofReason::InvalidIdna],
      }
    }
  }
  let uni = to_unicode(ascii, policy.idna_options, policy.limits)
  if !uni.is_valid {
    return DisplayDecision::{
      display: ascii,
      ascii: ascii,
      is_punycode_fallback: true,
      reasons: [SpoofReason::InvalidIdna],
    }
  }
  let has_idn = uni.output != ascii
  if policy.ascii_only {
    return DisplayDecision::{
      display: ascii,
      ascii: ascii,
      is_punycode_fallback: has_idn,
      reasons: [],
    }
  }
  if !has_idn {
    return DisplayDecision::{
      display: ascii,
      ascii: ascii,
      is_punycode_fallback: false,
      reasons: [],
    }
  }
  // Split normalized Unicode domain into labels and run UTS #39 checks per label
  let reasons : Array[SpoofReason] = []
  let u = uni.output
  let un = u.length()
  let mut ls = 0
  let mut i = 0
  while i <= un {
    if i == un || u.code_unit_at(i) == 46 {
      let lab = u.slice(ls, i)
      check_label_spoof(lab, policy, reasons)
      ls = i + 1
    }
    i = i + 1
  }
  if reasons.length() > 0 {
    DisplayDecision::{
      display: ascii,
      ascii: ascii,
      is_punycode_fallback: true,
      reasons: reasons,
    }
  } else {
    DisplayDecision::{
      display: u,
      ascii: ascii,
      is_punycode_fallback: false,
      reasons: [],
    }
  }
}

///| Browser Omnibox IDN display decision using `DisplayPolicy::browser_default()`.
pub fn display_domain_default(domain : String) -> DisplayDecision {
  display_domain(domain, DisplayPolicy::browser_default())
}
