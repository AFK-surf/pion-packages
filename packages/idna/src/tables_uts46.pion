///| Lookup UTS #46 mapping entry for `cp`.
///| Returns: 0=disallowed, 1=valid, 2=ignored, 5=deviation,
///| (v&7)==3 => single-cp delta=(v>>3), (v&7)==4 => multi-cp off=(v>>3)&0xFFFF, len=v>>19.
fn uts46_lookup(cp : Int) -> Int {
  let starts = idna_start
  let mut lo = 0
  let mut hi = idna_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  if hi >= 0 && cp <= idna_end[hi] {
    idna_val[hi]
  } else {
    0
  }
}

fn build_low_uts46_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(4096, 0)
  let starts = idna_start
  let ends = idna_end
  let vals = idna_val
  let n = idna_count
  let mut i = 0
  while i < n {
    let s = starts[i]
    if s >= 4096 {
      break
    }
    let mut e = ends[i]
    if e >= 4096 {
      e = 4095
    }
    let v = vals[i]
    let mut cp = s
    while cp <= e {
      lut[cp] = v
      cp = cp + 1
    }
    i = i + 1
  }
  lut
}

let low_uts46_lut : FixedArray[Int] = build_low_uts46_lut()

///| Packed property table for `0..0x0FFF`:
///| bit 0: may_need_nfc (ccc != 0 || nfc_qc != Yes)
///| bit 1: may_be_rtl (bidi_class in {1, 2, 6})
///| bit 2: is_mark
///| bit 3: is_contexto
///| bits 4..8: bidi_class (0..22)
///| bits 9..16: ccc (0..254)
///| bit 17: nfc_qc_not_yes
fn build_low_props_lut() -> FixedArray[Int] {
  let lut : FixedArray[Int] = FixedArray::make(4096, 0)
  let c_starts = ccc_start
  let c_ends = ccc_end
  let c_vals = ccc_val
  let c_n = ccc_count
  let mut i = 0
  while i < c_n {
    let s = c_starts[i]
    if s >= 4096 {
      break
    }
    let mut e = c_ends[i]
    if e >= 4096 {
      e = 4095
    }
    let v = c_vals[i]
    let bits = (v << 9) | 1
    let mut cp = s
    while cp <= e {
      lut[cp] = lut[cp] | bits
      cp = cp + 1
    }
    i = i + 1
  }
  let q_starts = nfcqc_start
  let q_ends = nfcqc_end
  let q_n = nfcqc_count
  i = 0
  while i < q_n {
    let s = q_starts[i]
    if s >= 4096 {
      break
    }
    let mut e = q_ends[i]
    if e >= 4096 {
      e = 4095
    }
    let mut cp = s
    while cp <= e {
      lut[cp] = lut[cp] | 131073
      cp = cp + 1
    }
    i = i + 1
  }
  let b_starts = bidi_start
  let b_ends = bidi_end
  let b_vals = bidi_val
  let b_n = bidi_count
  i = 0
  while i < b_n {
    let s = b_starts[i]
    if s >= 4096 {
      break
    }
    let mut e = b_ends[i]
    if e >= 4096 {
      e = 4095
    }
    let v = b_vals[i]
    let bits = (v << 4) | (if v == 1 || v == 2 || v == 6 { 2 } else { 0 })
    let mut cp = s
    while cp <= e {
      lut[cp] = lut[cp] | bits
      cp = cp + 1
    }
    i = i + 1
  }
  let m_starts = mark_start
  let m_ends = mark_end
  let m_n = mark_count
  i = 0
  while i < m_n {
    let s = m_starts[i]
    if s >= 4096 {
      break
    }
    let mut e = m_ends[i]
    if e >= 4096 {
      e = 4095
    }
    let mut cp = s
    while cp <= e {
      lut[cp] = lut[cp] | 4
      cp = cp + 1
    }
    i = i + 1
  }
  lut[0x00B7] = lut[0x00B7] | 8
  lut[0x0375] = lut[0x0375] | 8
  lut[0x05F3] = lut[0x05F3] | 8
  lut[0x05F4] = lut[0x05F4] | 8
  let mut d = 0x0660
  while d <= 0x0669 {
    lut[d] = lut[d] | 8
    d = d + 1
  }
  d = 0x06F0
  while d <= 0x06F9 {
    lut[d] = lut[d] | 8
    d = d + 1
  }
  let d_cps = decomp_cp
  let d_n = decomp_count
  i = 0
  while i < d_n {
    let cp = d_cps[i]
    if cp >= 4096 {
      break
    }
    lut[cp] = lut[cp] | 262144
    i = i + 1
  }
  lut
}

let low_props_lut : FixedArray[Int] = build_low_props_lut()

fn uts46_lookup_fast(cp : Int) -> Int {
  if cp < 4096 {
    low_uts46_lut[cp]
  } else if (cp >= 0x4E00 && cp <= 0x9FFF) ||
  (cp >= 0xAC00 && cp <= 0xD7A3) ||
  (cp >= 0x3041 && cp <= 0x3096) ||
  (cp >= 0x30A1 && cp <= 0x30FA) {
    1
  } else {
    uts46_lookup(cp)
  }
}

fn unicode_ccc(cp : Int) -> Int {
  if cp < 0x0300 {
    return 0
  }
  if cp < 4096 {
    return (low_props_lut[cp] >> 9) & 255
  }
  if (cp >= 0x4E00 && cp <= 0x9FFF) ||
  (cp >= 0xAC00 && cp <= 0xD7A3) ||
  (cp >= 0x3041 && cp <= 0x3096) ||
  (cp >= 0x30A1 && cp <= 0x30FA) {
    return 0
  }
  let starts = ccc_start
  let mut lo = 0
  let mut hi = ccc_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  if hi >= 0 && cp <= ccc_end[hi] {
    ccc_val[hi]
  } else {
    0
  }
}

fn unicode_decomp_info(cp : Int) -> Int {
  if cp < 0x00C0 {
    return -1
  }
  let cps = decomp_cp
  let mut lo = 0
  let mut hi = decomp_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    let v = cps[mid]
    if v == cp {
      return decomp_info[mid]
    } else if v < cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  -1
}

fn unicode_compose_pair(c1 : Int, c2 : Int) -> Int {
  let key = (c1.to_int64() << 21L) | c2.to_int64()
  let keys = comp_key
  let mut lo = 0
  let mut hi = comp_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    let v = keys[mid]
    if v == key {
      return comp_val[mid]
    } else if v < key {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  -1
}

fn unicode_is_mark(cp : Int) -> Bool {
  if cp < 0x0300 {
    return false
  }
  if cp < 4096 {
    return (low_props_lut[cp] & 4) != 0
  }
  if (cp >= 0x4E00 && cp <= 0x9FFF) ||
  (cp >= 0xAC00 && cp <= 0xD7A3) ||
  (cp >= 0x3041 && cp <= 0x3096) ||
  (cp >= 0x30A1 && cp <= 0x30FA) {
    return false
  }
  let starts = mark_start
  let mut lo = 0
  let mut hi = mark_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  hi >= 0 && cp <= mark_end[hi]
}

///| Lookup Bidi_Class: 0=L, 1=R, 2=AL, 3=EN, 4=ES, 5=ET, 6=AN, 7=CS, 8=NSM, 9=BN, 10=ON, 11=OTHER.
fn unicode_bidi_class(cp : Int) -> Int {
  if cp < 4096 {
    return (low_props_lut[cp] >> 4) & 31
  }
  if (cp >= 0x4E00 && cp <= 0x9FFF) ||
  (cp >= 0xAC00 && cp <= 0xD7A3) ||
  (cp >= 0x3041 && cp <= 0x3096) ||
  (cp >= 0x30A1 && cp <= 0x30FA) {
    return 0
  }
  let starts = bidi_start
  let mut lo = 0
  let mut hi = bidi_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  if hi >= 0 && cp <= bidi_end[hi] {
    bidi_val[hi]
  } else {
    0
  }
}

///| Lookup Joining_Type: 0=other, 1=L, 2=R, 3=D, 4=T.
fn unicode_joining_type(cp : Int) -> Int {
  if cp < 0x0300 {
    return 0
  }
  let starts = jt_start
  let mut lo = 0
  let mut hi = jt_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  if hi >= 0 && cp <= jt_end[hi] {
    jt_val[hi]
  } else {
    0
  }
}

///| Return true if `cp` has NFC_Quick_Check != Yes (No or Maybe) in Unicode 16.0.0.
fn unicode_nfc_qc_not_yes(cp : Int) -> Bool {
  if cp < 0x0300 {
    return false
  }
  if cp < 4096 {
    return (low_props_lut[cp] & 131072) != 0
  }
  if (cp >= 0x4E00 && cp <= 0x9FFF) ||
  (cp >= 0xAC00 && cp <= 0xD7A3) ||
  (cp >= 0x3041 && cp <= 0x3096) ||
  (cp >= 0x30A1 && cp <= 0x30FA) {
    return false
  }
  let starts = nfcqc_start
  let mut lo = 0
  let mut hi = nfcqc_count - 1
  while lo <= hi {
    let mid = (lo + hi) >> 1
    if starts[mid] <= cp {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  hi >= 0 && cp <= nfcqc_end[hi]
}
