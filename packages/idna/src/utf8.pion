///| Strict UTF-8 codec helpers for `packages/idna`.

///| Decode one non-ASCII UTF-8 scalar value at `s[pos..end]` (caller checked `b0 >= 0x80`).
///| Returns `cp | (byte_len << 21)` on success, or `-1` on invalid UTF-8.
fn decode_utf8_non_ascii(s : String, pos : Int, end : Int) -> Int {
  let b0 = s.code_unit_at(pos)
  if b0 >= 0xC2 && b0 <= 0xDF {
    if pos + 1 >= end {
      return -1
    }
    let b1 = s.code_unit_at(pos + 1)
    if (b1 & 0xC0) != 0x80 {
      return -1
    }
    let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
    return cp | (2 << 21)
  }
  if b0 >= 0xE0 && b0 <= 0xEF {
    if pos + 2 >= end {
      return -1
    }
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
      return -1
    }
    if b0 == 0xE0 && b1 < 0xA0 {
      return -1
    }
    if b0 == 0xED && b1 >= 0xA0 {
      return -1
    }
    let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
    return cp | (3 << 21)
  }
  if b0 >= 0xF0 && b0 <= 0xF4 {
    if pos + 3 >= end {
      return -1
    }
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
      return -1
    }
    if b0 == 0xF0 && b1 < 0x90 {
      return -1
    }
    if b0 == 0xF4 && b1 > 0x8F {
      return -1
    }
    let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
    return cp | (4 << 21)
  }
  -1
}

///| Lenient UTF-8 decoder (zero-alloc) for UTS #39 helpers: returns `cp | (advance << 21)`.
fn decode_utf8_lenient_packed(s : String, pos : Int, end : Int) -> Int {
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return b0 | (1 << 21)
  }
  let r = decode_utf8_non_ascii(s, pos, end)
  if r >= 0 {
    return r
  }
  if (b0 >= 0xC2 && b0 <= 0xDF && pos + 1 >= end) ||
  (b0 >= 0xE0 && b0 <= 0xEF && pos + 2 >= end) ||
  (b0 >= 0xF0 && b0 <= 0xF4 && pos + 3 >= end) {
    return 0xFFFD | ((end - pos) << 21)
  }
  0xFFFD | (1 << 21)
}

///| Write a Unicode scalar value as UTF-8 bytes into `sb`.
fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

fn cps_to_string(cps : Array[Int]) -> String {
  let n = cps.length()
  let sb = StringBuilder::with_capacity(n * 2)
  let mut i = 0
  while i < n {
    write_utf8_cp(sb, cps[i])
    i = i + 1
  }
  sb.to_string()
}

fn string_to_cps_strict(s : String) -> Result[Array[Int], IdnaError] {
  let n = s.length()
  let cps : Array[Int] = Array::with_capacity(n)
  let mut pos = 0
  while pos < n {
    let b0 = s.code_unit_at(pos)
    if b0 < 0x80 {
      cps.push(b0)
      pos = pos + 1
    } else {
      let r = decode_utf8_non_ascii(s, pos, n)
      if r < 0 {
        return Err(IdnaError::{ kind: IdnaErrorKind::InvalidUtf8, message: "invalid UTF-8 byte sequence", label_index: -1 })
      }
      cps.push(r & 0x1FFFFF)
      pos = pos + (r >> 21)
    }
  }
  Ok(cps)
}
