import "idna"

fn fnv1a_str(h0 : UInt64, s : String) -> UInt64 {
  let mut h = h0
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i).to_int64().to_uint64()
    h = (h ^ b) * 1099511628211UL
    i = i + 1
  }
  (h ^ 255UL) * 1099511628211UL
}

fn bytes_to_string(b : Bytes) -> String {
  let n = b.length()
  let sb = StringBuilder::with_capacity(n)
  let mut i = 0
  while i < n {
    sb.write_byte(b[i])
    i = i + 1
  }
  sb.to_string()
}

fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || s.code_unit_at(i) == 10 {
      let mut end = i
      if end > start && s.code_unit_at(end - 1) == 13 {
        end = end - 1
      }
      if end > start {
        out.push(s.slice(start, end))
      }
      start = i + 1
    }
    i = i + 1
  }
  out
}

fn parse_int(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut v = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    v = v * 10 + (b - 48)
    i = i + 1
  }
  v
}

fn run_diff(world : World, path : String) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "ERR: failed to read " + path)
      return 1
    }
  }
  let content = bytes_to_string(raw)
  let lines = split_lines(content)
  let limits = idna::IdnaLimits::default()
  let url_opts = idna::IdnaOptions::uts46_url()
  let strict_hyphens_opts = idna::IdnaOptions::uts46_non_transitional()
  let mut i = 0
  while i < lines.length() {
    let line = lines[i]
    let ln = line.length()
    let mut tab = -1
    let mut k = 0
    while k < ln {
      if line.code_unit_at(k) == 9 {
        tab = k
        break
      }
      k = k + 1
    }
    let mode = if tab >= 0 { line.slice(0, tab) } else { "url" }
    let domain = if tab >= 0 { line.slice(tab + 1, ln) } else { line }
    let opts = if mode == "strict_hyphens" { strict_hyphens_opts } else { url_opts }
    let a_str = match idna::to_ascii(domain, opts, limits) {
      Ok(a) => "OK:" + a
      Err(_) => "ERR"
    }
    let u = idna::to_unicode(domain, opts, limits)
    let u_str = if u.is_valid { "OK:" + u.output } else { "ERR" }
    io_println(world, mode + "\t" + domain + "\tA=" + a_str + "\tU=" + u_str)
    i = i + 1
  }
  0
}

fn run_bench(world : World, path : String, iters : Int) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "ERR: failed to read " + path)
      return 1
    }
  }
  let content = bytes_to_string(raw)
  let domains = split_lines(content)
  let opts = idna::IdnaOptions::uts46_non_transitional()
  let limits = idna::IdnaLimits::default()
  let mut h : UInt64 = 14695981039346656037UL
  let mut ok_ascii = 0
  let mut ok_uni = 0
  let mut it = 0
  while it < iters {
    let mut i = 0
    while i < domains.length() {
      let d = domains[i]
      match idna::to_ascii(d, opts, limits) {
        Ok(a) => {
          ok_ascii = ok_ascii + 1
          h = fnv1a_str(h, a)
        }
        Err(_) => {
          h = fnv1a_str(h, "ERR")
        }
      }
      let u = idna::to_unicode(d, opts, limits)
      if u.is_valid {
        ok_uni = ok_uni + 1
      }
      h = fnv1a_str(h, u.output)
      i = i + 1
    }
    it = it + 1
  }
  io_println(
    world,
    "idna_bench: domains=" +
    domains.length().to_string() +
    " iters=" +
    iters.to_string() +
    " ok_ascii=" +
    ok_ascii.to_string() +
    " ok_uni=" +
    ok_uni.to_string() +
    " fnv64=" +
    h.to_string(),
  )
  0
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: idna_pion_bench <diff|bench> <path> [iters]")
    return 2
  }
  let cmd = args[1]
  let path = args[2]
  if cmd == "diff" {
    run_diff(world, path)
  } else if cmd == "bench" {
    let iters = if args.length() >= 4 { parse_int(args[3], 100) } else { 100 }
    run_bench(world, path, iters)
  } else {
    io_println(world, "unknown subcommand: " + cmd)
    2
  }
}
