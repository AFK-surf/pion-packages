///| Wasm32 + Native 4-mode deterministic smoke entry for `packages/idna`.
///| Uses integer-only formatting to guarantee byte-identical stdout across
///| Native Debug, Native Release, Wasm32 Debug, and Wasm32 Release.

import "idna"

fn fnv1a_str(h0 : UInt64, s : String) -> UInt64 {
  let mut h = h0
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i).to_int64().to_uint64()
    h = (h ^ b) * 1099511628211UL
    i = i + 1
  }
  (h ^ 255UL) * 1099511628211UL
}

fn fnv1a_int(h0 : UInt64, v : Int) -> UInt64 {
  (h0 ^ v.to_int64().to_uint64()) * 1099511628211UL
}

pub fn main(world : World) -> Int {
  let mut h : UInt64 = 14695981039346656037UL
  let mut ok_count = 0

  let domains : Array[String] = [
    "EXAMPLE.COM",
    "münchen.de",
    "faß.de",
    "中文.com",
    "日本語.jp",
    "한국어.kr",
    "www.ร้าน.ไทย",
    "cafe\u{0301}.fr",
    "مثال.إختبار",
    "l\u{00B7}l.cat",
    "p\u{0430}ypal.com",
    "\u{0430}\u{0440}\u{0440}\u{04CF}\u{0435}.com",
    "g\u{03BF}\u{03BF}gle.com",
    "привет.рф",
    "xn--mnchen-3ya.de",
    "-bad.example.com",
    "a\u{200C}b.com",
  ]

  let strict = idna::IdnaOptions::uts46_strict()
  let trans = idna::IdnaOptions::uts46_transitional()
  let limits = idna::IdnaLimits::default()

  let mut i = 0
  while i < domains.length() {
    let d = domains[i]
    match idna::to_ascii(d, strict, limits) {
      Ok(a) => {
        ok_count = ok_count + 1
        h = fnv1a_str(h, a)
      }
      Err(e) => {
        h = fnv1a_str(h, e.kind.to_string())
      }
    }
    match idna::to_ascii(d, trans, limits) {
      Ok(a) => h = fnv1a_str(h, a)
      Err(e) => h = fnv1a_str(h, e.kind.to_string())
    }
    let u = idna::to_unicode(d, strict, limits)
    h = fnv1a_str(h, u.output)
    h = fnv1a_int(h, if u.is_valid { 1 } else { 0 })
    let dec = idna::display_domain_default(d)
    h = fnv1a_str(h, dec.display)
    h = fnv1a_int(h, if dec.is_punycode_fallback { 1 } else { 0 })
    h = fnv1a_int(h, dec.reasons.length())
    i = i + 1
  }

  let sk1 = idna::skeleton("p\u{0430}ypal.com")
  let sk2 = idna::skeleton("paypal.com")
  h = fnv1a_str(h, sk1)
  h = fnv1a_int(h, if sk1 == sk2 { 1 } else { 0 })

  io_println(
    world,
    "idna_wasm_smoke: OK domains=" +
    domains.length().to_string() +
    " valid_strict=" +
    ok_count.to_string() +
    " fnv64=" +
    h.to_string(),
  )
  0
}
