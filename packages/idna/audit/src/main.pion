///| Red-team CLI for `packages/idna` (native + wasm32, see ../REPORT.md).
///|   dump <file>              -> one block per corpus line `<name>\t<hex>`: `=<name>` then src/dump.pion's dump
///|   bomb <file>              -> DoS bomb (`<op>\n<limits>\n<hex payload>`), one summary line
///|   time <file> <iters> <op> -> run <op> over every line of <file> <iters> times, print `<us> <fnv>`
///|   api                      -> IdnaLimits boundary sweep of the public API
///|   list | case <name>       -> red-team / control cases (src/cases.pion)

import "idna"

///|
pub fn split_lines(data : String) -> Array[String] {
  let out : Array[String] = []
  let n = data.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if data.code_unit_at(i) == 10 {
      out.push(data.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(data.slice(start, n))
  }
  out
}

///|
pub fn run_dump(text : String) -> String {
  let lines = split_lines(text)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < lines.length() {
    let l = lines[i]
    let mut t = 0
    while t < l.length() && l.code_unit_at(t) != 9 {
      t = t + 1
    }
    if t < l.length() {
      sb.write_string("=" + l.slice(0, t) + "\n")
      sb.write_string(dump_case(unhex(l.slice(t + 1, l.length()))))
    }
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn fnv(h : UInt64, s : String) -> UInt64 {
  let mut x = h
  let mut i = 0
  while i < s.length() {
    x = (x ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  x
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut neg = false
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 45 {
      neg = true
    } else if c >= 48 && c <= 57 {
      v = v * 10 + (c - 48)
    }
    i = i + 1
  }
  if neg {
    -v
  } else {
    v
  }
}

///| `default` or four space-separated integers.
pub fn parse_limits(s : String) -> idna::IdnaLimits {
  if s == "default" {
    return idna::IdnaLimits::default()
  }
  let parts : Array[Int] = []
  let mut start = 0
  let mut i = 0
  while i <= s.length() {
    if i == s.length() || s.code_unit_at(i) == 32 {
      if i > start {
        parts.push(parse_int(s.slice(start, i)))
      }
      start = i + 1
    }
    i = i + 1
  }
  while parts.length() < 4 {
    parts.push(0)
  }
  idna::IdnaLimits::{
    max_input_bytes: parts[0],
    max_labels: parts[1],
    max_label_codepoints: parts[2],
    max_punycode_input: parts[3],
  }
}

///| Run one operation and summarise its result in one line (no input-sized output).
pub fn run_op(op : String, d : String, lim : idna::IdnaLimits) -> String {
  let s = idna::IdnaOptions::uts46_strict()
  if op == "ascii" || op == "ascii_url" {
    let o = if op == "ascii" { s } else { idna::IdnaOptions::uts46_url() }
    match idna::to_ascii(d, o, lim) {
      Ok(a) => "OK len=" + a.length().to_string() + " fnv=" + fnv(14695981039346656037UL, a).to_string()
      Err(e) => "ERR " + e.kind.to_string()
    }
  } else if op == "unicode" || op == "unicode_url" {
    let o = if op == "unicode" { s } else { idna::IdnaOptions::uts46_url() }
    let u = idna::to_unicode(d, o, lim)
    "valid=" +
    u.is_valid.to_string() +
    " errors=" +
    u.error_count.to_string() +
    " len=" +
    u.output.length().to_string() +
    " fnv=" +
    fnv(14695981039346656037UL, u.output).to_string()
  } else if op == "display" {
    let x = idna::display_domain(d, { ..idna::DisplayPolicy::browser_default(), limits: lim })
    "fallback=" +
    x.is_punycode_fallback.to_string() +
    " reasons=" +
    reasons_str(x.reasons) +
    " len=" +
    x.display.length().to_string()
  } else if op == "skeleton" {
    let k = idna::skeleton(d)
    "len=" + k.length().to_string() + " fnv=" + fnv(14695981039346656037UL, k).to_string()
  } else if op == "confusable" {
    "confusable=" + idna::are_confusable(d, d + "x").to_string()
  } else if op == "scripts" {
    "scripts=" + scripts_str(idna::detect_scripts(d)) + " mixed=" + idna::is_mixed_script(d).to_string()
  } else if op == "puny_dec" {
    match idna::punycode_decode_with_limits(d, lim) {
      Ok(a) => "OK len=" + a.length().to_string() + " fnv=" + fnv(14695981039346656037UL, a).to_string()
      Err(e) => "ERR " + e.kind.to_string()
    }
  } else if op == "puny_enc" {
    match idna::punycode_encode_with_limits(d, lim) {
      Ok(a) => "OK len=" + a.length().to_string() + " fnv=" + fnv(14695981039346656037UL, a).to_string()
      Err(e) => "ERR " + e.kind.to_string()
    }
  } else {
    "unknown op " + op
  }
}

///|
pub fn run_bomb(text : String) -> String {
  let lines = split_lines(text)
  if lines.length() < 3 {
    return "bad bomb file"
  }
  lines[0] + " " + run_op(lines[0], unhex(lines[2]), parse_limits(lines[1]))
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: idna_audit dump|bomb <file> | time <file> <iters> <op> | api | list | case <name>")
    return 2
  }
  let mode = args[1]
  if (mode == "dump" || mode == "bomb" || mode == "time") && args.length() >= 3 {
    let text = match fs_read_bytes(world, args[2]) {
      Ok(b) => b.to_string()
      Err(_) => {
        io_eprintln(world, "cannot read " + args[2])
        return 2
      }
    }
    if mode == "dump" {
      io_print(world, run_dump(text))
    } else if mode == "bomb" {
      io_println(world, run_bomb(text))
    } else {
      if args.length() < 5 {
        return 2
      }
      let lines = split_lines(text)
      let iters = parse_int(args[3])
      let lim = idna::IdnaLimits::default()
      let t0 = clock_monotonic_us()
      let mut h = 14695981039346656037UL
      let mut k = 0
      while k < iters {
        let mut i = 0
        while i < lines.length() {
          h = fnv(h, run_op(args[4], lines[i], lim))
          i = i + 1
        }
        k = k + 1
      }
      let t1 = clock_monotonic_us()
      io_println(world, (t1 - t0).to_string() + " " + h.to_string())
    }
    return 0
  }
  if mode == "api" {
    io_print(world, run_api())
    return 0
  }
  if mode == "list" {
    io_println(world, case_names().join(" "))
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = run_case(args[2])
    io_println(world, (if r == "" { "PASS " } else { "FAIL " }) + args[2] + (if r == "" { "" } else { " :: " + r }))
    return 0
  }
  io_println(world, "bad arguments")
  2
}
