///| Red-team (`redteam_p<sev>_<n>_*`) and control (`control_*`) cases. Each returns "" on PASS, else the reason.
///|
///| Red-team cases assert the conforming / secure behaviour and FAIL while the finding of the same id in
///| REPORT.md is open. They use the public API only and accept every reasonable fix (for example any
///| fallback to Punycode, or an error instead of a value). Control cases pin behaviour the package gets right:
///| they must PASS before and after any fix, and the bug-injection gate of run_audit.sh relies on them.

///|
fn lim() -> idna::IdnaLimits {
  idna::IdnaLimits::default()
}

///|
fn S() -> idna::IdnaOptions {
  idna::IdnaOptions::uts46_strict()
}

///|
fn N() -> idna::IdnaOptions {
  idna::IdnaOptions::uts46_non_transitional()
}

///|
fn U() -> idna::IdnaOptions {
  idna::IdnaOptions::uts46_url()
}

///|
fn T() -> idna::IdnaOptions {
  idna::IdnaOptions::uts46_transitional()
}

///|
fn rep(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn res_str(r : Result[String, idna::IdnaError]) -> String {
  match r {
    Ok(a) => "Ok(" + a + ")"
    Err(e) => "Err(" + e.kind.to_string() + ")"
  }
}

///|
fn is_ok(r : Result[String, idna::IdnaError]) -> Bool {
  match r {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn is_ascii(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) >= 0x80 {
      return false
    }
    i = i + 1
  }
  true
}

///| Expect `to_ascii(d, o)` to be `Ok(want)` (want == "" means: expect an error).
fn expect_ascii(tag : String, d : String, o : idna::IdnaOptions, want : String) -> String {
  let r = idna::to_ascii(d, o, lim())
  match r {
    Ok(a) =>
    if want != "" && a == want {
      ""
    } else {
      tag + ": to_ascii(" + hex(d) + ") = " + res_str(r) + ", want " + (if want == "" { "Err" } else { want }) + "; "
    }
    Err(_) =>
    if want == "" {
      ""
    } else {
      tag + ": to_ascii(" + hex(d) + ") = " + res_str(r) + ", want " + want + "; "
    }
  }
}

///| Expect `to_unicode(d, o)` validity.
fn expect_uvalid(tag : String, d : String, o : idna::IdnaOptions, want : Bool) -> String {
  let u = idna::to_unicode(d, o, lim())
  if u.is_valid == want && (u.error_count == 0) == want {
    ""
  } else {
    tag +
    ": to_unicode(" +
    hex(d) +
    ") valid=" +
    u.is_valid.to_string() +
    " errors=" +
    u.error_count.to_string() +
    ", want valid=" +
    want.to_string() +
    "; "
  }
}

///|
fn fallback(d : String) -> Bool {
  idna::display_domain_default(d).is_punycode_fallback
}

///|
fn expect_fallback(d : String, want : Bool) -> String {
  let x = idna::display_domain_default(d)
  if x.is_punycode_fallback == want {
    ""
  } else {
    "display_domain(" +
    hex(d) +
    ") fallback=" +
    x.is_punycode_fallback.to_string() +
    " display=" +
    x.display +
    " reasons=" +
    reasons_str(x.reasons) +
    ", want fallback=" +
    want.to_string() +
    "; "
  }
}

// ---------------------------------------------------------------------------------------------------------
// Red-team cases
// ---------------------------------------------------------------------------------------------------------

///| P1-1: characters with NFC_Quick_Check=Maybe outside the `cp_may_need_nfc` ranges skip normalisation:
///| `to_ascii` emits a non-NFC A-label (a second, different A-label for the same name) that the package
///| itself rejects as `PunycodeNotNfc`.
fn rt_nfc_gap() -> String {
  let pairs : Array[(String, String)] = [
    ("\u{1148F}\u{114B9}\u{114BA}", "\u{1148F}\u{114BB}"), // Tirhuta  E + AI-length -> AI
    ("\u{1148F}\u{114B9}\u{114B0}", "\u{1148F}\u{114BC}"), // Tirhuta  E + AA -> O
    ("\u{1148F}\u{114B9}\u{114BD}", "\u{1148F}\u{114BE}"), // Tirhuta  E + AU-length -> AU
    ("\u{1158E}\u{115B8}\u{115AF}", "\u{1158E}\u{115BA}"), // Siddham  E + AA -> O
    ("\u{1190C}\u{11935}\u{11930}", "\u{1190C}\u{11938}"), // Dives Akuru E + AA -> O
    ("\u{16100}\u{1611E}\u{1611F}", "\u{16100}\u{16123}"), // Gurung Khema AA + I -> E
    ("\u{16D4B}\u{16D67}\u{16D67}", "\u{16D4B}\u{16D68}"), // Kirat Rai E + E -> AI
  ]
  let sb = StringBuilder::new()
  let mut i = 0
  while i < pairs.length() {
    let (raw, nfc) = pairs[i]
    let a = idna::to_ascii(raw + ".com", N(), lim())
    let b = idna::to_ascii(nfc + ".com", N(), lim())
    if res_str(a) != res_str(b) {
      sb.write_string(
        "to_ascii(" + hex(raw) + ".com) = " + res_str(a) + " but NFC form gives " + res_str(b) + "; ",
      )
    }
    match a {
      Ok(x) => {
        let u = idna::to_unicode(x, N(), lim())
        if !u.is_valid {
          sb.write_string("own output " + x + " rejected by to_unicode; ")
        }
      }
      Err(_) => ()
    }
    let u2 = idna::to_unicode(raw + ".com", N(), lim())
    let u3 = idna::to_unicode(nfc + ".com", N(), lim())
    if u2.output != u3.output {
      sb.write_string("to_unicode(" + hex(raw) + ") output not NFC (" + hex(u2.output) + "); ")
    }
    i = i + 1
  }
  sb.to_string()
}

///| P1-2: for input that is not a valid IDN, `display_domain` returns the raw attacker-controlled input as
///| `display` (with `is_punycode_fallback = true`), e.g. RLO-reordered text, disallowed look-alikes.
fn rt_display_raw_invalid() -> String {
  let ins = [
    "evil\u{202E}moc.elgoog.com", // RIGHT-TO-LEFT OVERRIDE: renders as "evilcom.google.com"
    "paypal.com\u{2044}login.evil.com", // FRACTION SLASH looks like "/"
    "google.com\u{2215}x.evil.com", // DIVISION SLASH
    "\u{0430}pple.com\u{FFFD}", // invalid + Cyrillic
  ]
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ins.length() {
    let x = idna::display_domain_default(ins[i])
    if x.is_punycode_fallback && !is_ascii(x.display) {
      sb.write_string("display_domain(" + hex(ins[i]) + ").display is raw non-ASCII input " + hex(x.display) + "; ")
    }
    i = i + 1
  }
  sb.to_string()
}

///| P1-3: single-script Latin homoglyphs (non-ASCII Latin letters whose UTS #39 skeleton is pure ASCII)
///| are displayed as Unicode: `gooɡle.com`, `ɑpple.com`, `ɡithub.com`, `faceboоk` with U+1D0F.
fn rt_latin_homoglyph() -> String {
  expect_fallback("goo\u{0261}le.com", true) +
  expect_fallback("\u{0251}pple.com", true) +
  expect_fallback("\u{0261}ithub.com", true) +
  expect_fallback("facebo\u{1D0F}k.com", true) +
  expect_fallback("p\u{0251}ypal.com", true)
}

///| P1-4: CJK characters that look like `/` or `-` next to Latin letters (Chrome's dangerous-pattern list:
///| ノ ソ ゾ ン 丶 乀 乁 丿 一 ー) are displayed as Unicode: `google.comノevil.com` reads as a path.
fn rt_cjk_slash_dash() -> String {
  expect_fallback("google.com\u{30CE}evil.com", true) +
  expect_fallback("paypal.com\u{4E3F}x.evil.com", true) +
  expect_fallback("pay\u{4E00}pal.com", true) +
  expect_fallback("ama\u{30FC}zon.com", true)
}

///| P1-5: UTS #39 (16.0) internalSkeleton removes Default_Ignorable_Code_Point characters before mapping;
///| `skeleton` / `are_confusable` do not, so invisible characters defeat confusable detection.
fn rt_skeleton_default_ignorable() -> String {
  let sb = StringBuilder::new()
  let pairs : Array[(String, String)] = [
    ("paypal", "pay\u{200B}pal"),
    ("paypal", "pay\u{00AD}pal"),
    ("paypal", "pay\u{034F}pal"),
    ("paypal", "p\u{2060}aypal"),
    ("paypal", "paypal\u{FE0F}"),
  ]
  let mut i = 0
  while i < pairs.length() {
    let (a, b) = pairs[i]
    if !idna::are_confusable(a, b) {
      sb.write_string("are_confusable(" + a + ", " + hex(b) + ") = false; ")
    }
    i = i + 1
  }
  sb.to_string()
}

///| P1-6: `skeleton` / `are_confusable` take unbounded input and sort combining marks with an insertion
///| sort: 2 x the input costs 4 x the time (quadratic). Measured on 3,000 vs 6,000 marks (ratio < 3 passes).
fn rt_skeleton_quadratic() -> String {
  let small = "a" + rep("\u{0301}\u{0316}", 1500)
  let big = "a" + rep("\u{0301}\u{0316}", 3000)
  let mut best_s = 1000000000L
  let mut best_b = 1000000000L
  let mut r = 0
  while r < 3 {
    let t0 = clock_monotonic_us()
    let _ = idna::skeleton(small)
    let t1 = clock_monotonic_us()
    let _ = idna::skeleton(big)
    let t2 = clock_monotonic_us()
    if t1 - t0 < best_s {
      best_s = t1 - t0
    }
    if t2 - t1 < best_b {
      best_b = t2 - t1
    }
    r = r + 1
  }
  if best_s < 1L {
    best_s = 1L
  }
  if best_b * 10L >= best_s * 30L && best_b > 2000L {
    "skeleton: 3,000 marks " + best_s.to_string() + " us, 6,000 marks " + best_b.to_string() + " us (quadratic)"
  } else {
    ""
  }
}

///| P2-9: the NFC pass runs over the whole mapped domain before any per-label limit: with a raised
///| `max_input_bytes`, one label of N combining marks costs O(N^2) before `max_label_codepoints` rejects it.
fn rt_limits_after_nfc() -> String {
  let l = { ..lim(), max_input_bytes: 1000000 }
  let small = "a" + rep("\u{0301}\u{0316}", 1500) + ".com"
  let big = "a" + rep("\u{0301}\u{0316}", 3000) + ".com"
  let mut best_s = 1000000000L
  let mut best_b = 1000000000L
  let mut r = 0
  while r < 3 {
    let t0 = clock_monotonic_us()
    let _ = idna::to_unicode(small, S(), l)
    let t1 = clock_monotonic_us()
    let _ = idna::to_unicode(big, S(), l)
    let t2 = clock_monotonic_us()
    if t1 - t0 < best_s {
      best_s = t1 - t0
    }
    if t2 - t1 < best_b {
      best_b = t2 - t1
    }
    r = r + 1
  }
  if best_s < 1L {
    best_s = 1L
  }
  if best_b * 10L >= best_s * 30L && best_b > 2000L {
    "to_unicode (label limit 1000): 3,000 marks " +
    best_s.to_string() +
    " us, 6,000 marks " +
    best_b.to_string() +
    " us (quadratic before LimitExceeded)"
  } else {
    ""
  }
}

///| P2-1: UTS #46 §4.1 V4: if not CheckHyphens, a label must not begin with "xn--" (after decoding).
fn rt_v4_xn_prefix() -> String {
  expect_ascii("url", "xn--xn--mnchen-eeb.com", U(), "") +
  expect_uvalid("url", "xn--xn--mnchen-eeb.com", U(), false)
}

///| P2-2: IgnoreInvalidPunycode only waives the Punycode *decode* failure; a non-ASCII `xn--` label is
///| always an error (UTS #46 §4 step 4.1.1), and the label still goes through the validity criteria (V2/V4).
fn rt_ignore_invalid_punycode() -> String {
  let ign = { ..U(), ignore_invalid_punycode: true }
  expect_ascii("ignore", "xn--m\u{00FC}nchen.com", ign, "") +
  expect_uvalid("ignore", "xn--m\u{00FC}nchen.com", ign, false) +
  expect_ascii("ignore", "xn--9.com", ign, "") +
  expect_uvalid("ignore", "xn--9.com", ign, false)
}

///| P2-3: RFC 5892 A.9 KATAKANA MIDDLE DOT needs any Hiragana/Katakana/Han character in the label; Han
///| characters below U+3040 (々 U+3005, 〇 U+3007, 〻 U+303B) are not counted, so valid labels are rejected.
fn rt_contexto_katakana_han() -> String {
  expect_ascii("strict", "\u{4EBA}\u{3005}\u{30FB}\u{3007}.jp", S(), "xn--u6je54ei48f.jp") +
  expect_ascii("strict", "\u{3005}\u{30FB}.jp", S(), "xn--u6j71a.jp")
}

///| P2-4: Transitional processing reached through a mapping: U+1E9E (ẞ) maps to U+00DF, a deviation character,
///| which transitional processing must map on to "ss" (IdnaTestV2 lines 229-230: toAsciiT(FAẞ.de) = fass.de).
///| The fast path emits the non-transitional A-label, the full path reports DisallowedCodePoint.
fn rt_transitional_sharp_s() -> String {
  expect_ascii("T", "FA\u{1E9E}.de", T(), "fass.de") +
  expect_ascii("T", "fa\u{1E9E}\u{0301}.de", T(), "xn--fas-eza.de")
}

///| P2-8: numbering systems are taken from merged runs of consecutive Nd code points, so the two systems of
///| U+116D0..U+116E3 (Myanmar Pao / Eastern Pwo Karen digits, Unicode 16) count as one.
fn rt_numbering_merge() -> String {
  expect_fallback("\u{116D1}\u{116DB}.com", true)
}

///| P2-5: the whole-script confusable test requires a pure-ASCII skeleton, so a Cyrillic label that renders
///| as a Latin word with a diacritic (`соӧр`, `ѕсһӧп`) is displayed as Unicode.
fn rt_whole_script_diacritic() -> String {
  expect_fallback("\u{0441}\u{043E}\u{04E7}\u{0440}.com", true) +
  expect_fallback("\u{0455}\u{0441}\u{04BB}\u{04E7}\u{043D}.de", true)
}

///| P2-6: combining overlay marks U+0335..U+0338 (blocked by Chrome) are displayed:
///| `google.com̸evil.com` puts a slash over the dot-com.
fn rt_combining_overlay() -> String {
  expect_fallback("google.com\u{0338}evil.com", true) + expect_fallback("paypa\u{0335}l.com", true)
}

///| P2-7: UTS #39 (16.0) skeleton(X) = bidiSkeleton(LTR, X): UAX #9 reordering up to L2 (incl. explicit
///| overrides X1-X8, paired brackets N0, L1), then L3 (combining marks after their base) and L4 (mirrored
///| glyphs), then internalSkeleton. Re-audit of 15b226e: the logical-order bug is fixed, but the reordering
///| has no X1-X8 / N0 / L1 and no L3 / L4, so UTS #39's own example S1 ≒ S2 fails, a RIGHT-TO-LEFT OVERRIDE
///| reversal is not seen, RTL combining marks end up before their base, and brackets around RTL text move.
///| Re-audit of f89aefd: X1-X8 / N0 / L1 / L3 / L4 are fixed; isolates (LRI / RLI / FSI / PDI) still are not.
fn rt_bidi_skeleton() -> String {
  let pairs : Array[(String, String, String)] = [
    ("logical order", "\u{05E1}\u{05D5}", "lo"),
    ("UTS #39 16.0 example S1 ~ S2 (L3 + L4)", "A1<\u{05E9}\u{05C2}", "\u{0391}\u{05E9}\u{05BA}>1"),
    ("RLO override (X4)", "\u{202E}lapyap", "paypal"),
    ("L3 mark after base", "\u{05E1}\u{05B0}", "o\u{05B0}"),
    ("N0 paired brackets + L4", "a\u{05E1}(\u{05D5})c", "a(l)oc"),
    // re-audit of f89aefd: isolates (X5a-X5c, X6a, BD13 isolating run sequences) are still treated as neutrals
    ("LRI isolate inside RTL text", "\u{05D0}\u{2066}ab\u{2069}\u{05D1}", "\u{05D1}ab\u{05D0}"),
    ("RLI isolate (also missed by the RTL fast path)", "\u{2067}1 2\u{2069}", "2 1"),
  ]
  let sb = StringBuilder::new()
  let mut i = 0
  while i < pairs.length() {
    let (what, a, b) = pairs[i]
    if idna::skeleton(a) != idna::skeleton(b) {
      sb.write_string(what + ": skeleton(" + hex(a) + ") = " + hex(idna::skeleton(a)) + ", want skeleton(" + hex(b) + ") = " + hex(idna::skeleton(b)) + "; ")
    }
    i = i + 1
  }
  sb.to_string()
}

///| P2-11 (re-audit of 15b226e, regression): the new display rules force legitimate domains to Punycode:
///| the Latin homoglyph rule flags letters UTS #39 IdentifierStatus lists as Allowed (æ œ ı: Danish,
///| Norwegian, French, Turkish), the CJK slash rule fires when only one neighbour is non-CJK (Chrome needs
///| every neighbour to be non-Japanese, ー only after a non-kana), and the small-capital whole-script rule
///| flags ordinary Cyrillic words (тест, весна) on Cyrillic TLDs. Re-audit of f89aefd: the first three and the
///| Cyrillic-TLD cases are fixed, but Athens (αθήνα.gr), αγορά.gr, тест.bg and работа.ua are still forced to
///| Punycode (all displayed by b046fc8 and by Chrome).
fn rt_display_overblocking() -> String {
  let legit = [
    "\u{00E6}ble.dk", "c\u{0153}ur.fr", "k\u{0131}rm\u{0131}z\u{0131}.com.tr", "\u{30DD}\u{30B1}\u{30E2}\u{30F3}123.jp",
    "\u{30E9}\u{30FC}\u{30E1}\u{30F3}-ya.com", "\u{30B3}\u{30FC}\u{30D2}\u{30FC}1.jp", "\u{0442}\u{0435}\u{0441}\u{0442}.\u{0440}\u{0444}",
    "\u{0432}\u{0435}\u{0441}\u{043D}\u{0430}.\u{0440}\u{0444}",
    // re-audit of f89aefd: the diacritic-insensitive whole-script rule still fires for ordinary words on the
    // Latin-script ccTLDs these languages use (Greek on .gr, Cyrillic on .bg / .ua); θ -> O + U+0335 overlay
    "\u{03B1}\u{03B8}\u{03AE}\u{03BD}\u{03B1}.gr", "\u{03B1}\u{03B3}\u{03BF}\u{03C1}\u{03AC}.gr",
    "\u{0442}\u{0435}\u{0441}\u{0442}.bg", "\u{0440}\u{0430}\u{0431}\u{043E}\u{0442}\u{0430}.ua",
  ]
  let sb = StringBuilder::new()
  let mut i = 0
  while i < legit.length() {
    sb.write_string(expect_fallback(legit[i], false))
    i = i + 1
  }
  sb.to_string()
}

// ---------------------------------------------------------------------------------------------------------
// Control cases (must pass before and after every fix)
// ---------------------------------------------------------------------------------------------------------

///| RFC 3492 §7.1 sample strings (A, B, C, E, F, H, L, Q, R).
fn ctl_punycode_vectors() -> String {
  let v : Array[(String, String)] = [
    (
      "\u{0644}\u{064A}\u{0647}\u{0645}\u{0627}\u{0628}\u{062A}\u{0643}\u{0644}\u{0645}\u{0648}\u{0634}\u{0639}\u{0631}\u{0628}\u{064A}\u{061F}",
      "egbpdaj6bu4bxfgehfvwxn",
    ),
    ("\u{4ED6}\u{4EEC}\u{4E3A}\u{4EC0}\u{4E48}\u{4E0D}\u{8BF4}\u{4E2D}\u{6587}", "ihqwcrb4cv8a8dqg056pqjye"),
    ("\u{4ED6}\u{5011}\u{7232}\u{4EC0}\u{9EBD}\u{4E0D}\u{8AAA}\u{4E2D}\u{6587}", "ihqwctvzc91f659drss3x8bo0yb"),
    ("Pro\u{010D}prost\u{011B}nemluv\u{00ED}\u{010D}esky", "Proprostnemluvesky-uyb24dma41a"),
    (
      "\u{05DC}\u{05DE}\u{05D4}\u{05D4}\u{05DD}\u{05E4}\u{05E9}\u{05D5}\u{05D8}\u{05DC}\u{05D0}\u{05DE}\u{05D3}\u{05D1}\u{05E8}\u{05D9}\u{05DD}\u{05E2}\u{05D1}\u{05E8}\u{05D9}\u{05EA}",
      "4dbcagdahymbxekheh6e0a7fei0b",
    ),
    (
      "\u{043F}\u{043E}\u{0447}\u{0435}\u{043C}\u{0443}\u{0436}\u{0435}\u{043E}\u{043D}\u{0438}\u{043D}\u{0435}\u{0433}\u{043E}\u{0432}\u{043E}\u{0440}\u{044F}\u{0442}\u{043F}\u{043E}\u{0440}\u{0443}\u{0441}\u{0441}\u{043A}\u{0438}",
      "b1abfaaepdrnnbgefbadotcwatmq2g4l",
    ),
    ("3\u{5E74}B\u{7D44}\u{91D1}\u{516B}\u{5148}\u{751F}", "3B-ww4c5e180e575a65lsy2b"),
    ("\u{3072}\u{3068}\u{3064}\u{5C4B}\u{6839}\u{306E}\u{4E0B}2", "2-u9tlzr9756bt3uc0v"),
    ("-> $1.00 <-", "-> $1.00 <--"),
  ]
  let sb = StringBuilder::new()
  let mut i = 0
  while i < v.length() {
    let (u, p) = v[i]
    match idna::punycode_encode(u) {
      Ok(x) =>
      if x != p {
        sb.write_string("encode " + p + " got " + x + "; ")
      }
      Err(e) => sb.write_string("encode " + p + " Err " + e.kind.to_string() + "; ")
    }
    match idna::punycode_decode(p) {
      Ok(x) =>
      if x != u {
        sb.write_string("decode " + p + " got " + hex(x) + "; ")
      }
      Err(e) => sb.write_string("decode " + p + " Err " + e.kind.to_string() + "; ")
    }
    i = i + 1
  }
  sb.to_string()
}

///| Overflow / malformed Punycode never decodes (and never panics).
fn ctl_punycode_overflow() -> String {
  let bad = [
    rep("z", 30),
    rep("9", 30),
    "99999999999",
    "zzzzzzzzzzzzzzz",
    "a-" + rep("9", 12),
    "8", // truncated variable-length integer
    "a-a!", // invalid digit
    "-" + rep("z", 8),
    "wwwwwwww", // > U+10FFFF
  ]
  let sb = StringBuilder::new()
  let mut i = 0
  while i < bad.length() {
    match idna::punycode_decode(bad[i]) {
      Ok(x) => {
        // a decoded value is acceptable only if it round-trips (valid scalar values)
        match idna::punycode_encode(x) {
          Ok(y) =>
          if y != bad[i] {
            sb.write_string("decode(" + bad[i] + ") = " + hex(x) + " which re-encodes to " + y + "; ")
          }
          Err(e) => sb.write_string("decode(" + bad[i] + ") = " + hex(x) + " not encodable: " + e.kind.to_string() + "; ")
        }
      }
      Err(_) => ()
    }
    match idna::to_ascii("xn--" + bad[i] + ".com", U(), lim()) {
      Ok(x) => sb.write_string("to_ascii(xn--" + bad[i] + ".com) = " + x + "; ")
      Err(_) => ()
    }
    i = i + 1
  }
  // decoded U+D800 surrogate (xn--) and > U+10FFFF must be rejected
  match idna::punycode_decode("a-9r4a") {
    Ok(x) => {
      let mut j = 0
      while j + 2 < x.length() {
        if x.code_unit_at(j) == 0xED && x.code_unit_at(j + 1) >= 0xA0 {
          sb.write_string("decode(a-9r4a) produced a UTF-8 surrogate; ")
        }
        j = j + 1
      }
    }
    Err(_) => ()
  }
  sb.to_string()
}

///| CheckHyphens on the ASCII fast path, the non-ASCII fast path and the full path (deviation chars).
fn ctl_hyphens() -> String {
  expect_ascii("N", "ab--c.com", N(), "") +
  expect_ascii("N", "-ab.com", N(), "") +
  expect_ascii("N", "ab-.com", N(), "") +
  expect_ascii("N", "ab--\u{00FC}.com", N(), "") +
  expect_ascii("N", "ab--c\u{00DF}.com", N(), "") +
  expect_ascii("N", "-c\u{00DF}.com", N(), "") +
  expect_ascii("N", "c\u{00DF}-.com", N(), "") +
  expect_ascii("N", "xn--mnchen-3ya.com", N(), "xn--mnchen-3ya.com") +
  expect_ascii("N", "a-b.com", N(), "a-b.com") +
  expect_ascii("U", "ab--c.com", U(), "ab--c.com") +
  expect_ascii("U", "-ab.com", U(), "-ab.com") +
  expect_ascii("U", "ab--c\u{00DF}.com", U(), "xn--ab--c-pqa.com") +
  expect_uvalid("N", "ab--c\u{00DF}.com", N(), false)
}

///| RFC 5893 Bidi rules 1-6 on the fast and the full path.
fn ctl_bidi() -> String {
  expect_ascii("N", "\u{05D0}\u{05D1}.com", N(), "xn--4dbc.com") +
  expect_ascii("N", "a\u{05D0}.com", N(), "") + // rule 5: LTR label with R
  expect_ascii("N", "\u{05D0}a.com", N(), "") + // rule 2: RTL label with L
  expect_ascii("N", "1\u{05D0}.com", N(), "") + // rule 1: first char EN
  expect_ascii("N", "\u{05D0}1\u{0661}.com", N(), "") + // rule 4: EN + AN
  expect_ascii("N", "\u{0627}1\u{0661}.com", N(), "") + // rule 4 with AL
  expect_ascii("N", "\u{05D0}\u{05B0}.com", N(), "xn--7cb7d.com") + // rule 3: trailing NSM
  expect_ascii("N", "\u{05D0}-.com", U(), "") + // rule 3: ends with ES
  expect_ascii("N", "1.\u{05D0}", N(), "") + // rule 1 across labels
  expect_ascii("N", "a\u{0300}.\u{05D0}", N(), "xn--0ca.xn--4db") + // rule 6 L + NSM ok
  expect_ascii("N", "\u{00DF}1-\u{05D0}.com", N(), "") + // full path (deviation) + rule 5
  expect_ascii("R", "a\u{05D0}.com", { ..U(), check_bidi: false }, "xn--a-0hc.com") +
  expect_uvalid("N", "a\u{05D0}.com", N(), false)
}

///| RFC 5892 ContextJ (ZWJ / ZWNJ).
fn ctl_joiners() -> String {
  expect_ascii("N", "\u{0915}\u{094D}\u{200D}\u{0937}.in", N(), "xn--11b2ezcw70k.in") +
  expect_ascii("N", "\u{0915}\u{094D}\u{200C}\u{0937}.in", N(), "xn--11b2ezcs70k.in") +
  expect_ascii("N", "a\u{200D}b.com", N(), "") +
  expect_ascii("N", "a\u{200C}b.com", N(), "") +
  expect_ascii("N", "\u{0628}\u{200C}\u{0628}.com", N(), "xn--ngba799q.com") + // D ZWNJ D
  expect_ascii("N", "\u{0628}\u{0650}\u{200C}\u{0650}\u{0628}", N(), "xn--ngba3ja3504a") + // D T* ZWNJ T* D
  expect_ascii("N", "\u{0627}\u{200C}\u{0628}", N(), "") + // left side R (alef) is not L/D
  expect_ascii("N", "\u{200C}\u{0628}", N(), "") +
  expect_ascii("T", "a\u{200D}b.com", T(), "ab.com") +
  expect_uvalid("N", "a\u{200D}b.com", N(), false)
}

///| RFC 5892 ContextO (strict profile only).
fn ctl_contexto() -> String {
  expect_ascii("S", "l\u{00B7}l.cat", S(), "xn--ll-0ea.cat") +
  expect_ascii("S", "a\u{00B7}a.cat", S(), "") +
  expect_ascii("S", "\u{00B7}l.cat", S(), "") +
  expect_ascii("S", "\u{0375}\u{03B1}.gr", S(), "xn--wva4j.gr") +
  expect_ascii("S", "\u{0375}a.gr", S(), "") +
  expect_ascii("S", "\u{05D0}\u{05F3}.il", S(), "xn--4db4e.il") +
  expect_ascii("S", "\u{05F3}\u{05D0}.il", S(), "") +
  expect_ascii("S", "\u{30A2}\u{30FB}\u{30A4}.jp", S(), "xn--ccke4x.jp") +
  expect_ascii("S", "a\u{30FB}b.jp", S(), "") +
  expect_ascii("S", "\u{0628}\u{0661}\u{06F1}", S(), "") +
  expect_ascii("N", "a\u{00B7}a.cat", N(), "xn--aa-0ea.cat")
}

///| VerifyDnsLength boundaries (fast and full path) and its absence in the URL profile.
fn ctl_dns_length() -> String {
  let l63 = rep("a", 63)
  let l64 = rep("a", 64)
  let d253 = rep("a", 63) + "." + rep("b", 63) + "." + rep("c", 63) + "." + rep("d", 61)
  let d254 = d253 + "e"
  expect_ascii("N", l63 + ".com", N(), l63 + ".com") +
  expect_ascii("N", l64 + ".com", N(), "") +
  expect_ascii("N", d253, N(), d253) +
  expect_ascii("N", d253 + ".", N(), d253 + ".") +
  expect_ascii("N", d254, N(), "") +
  expect_ascii("N", "a..b", N(), "") +
  expect_ascii("N", "a.b..", N(), "") +
  expect_ascii("N", ".", N(), "") +
  expect_ascii("N", "", N(), "") +
  expect_ascii("N", "\u{00FC}" + rep("a", 56) + ".com", N(), "") + // 64-byte A-label
  expect_ascii("N", "\u{00DF}" + rep("a", 56) + ".com", N(), "") +
  expect_ascii("U", l64 + ".com", U(), l64 + ".com") +
  expect_ascii("U", "a..b", U(), "a..b")
}

///| Transitional vs non-transitional deviations.
fn ctl_transitional() -> String {
  expect_ascii("T", "fa\u{00DF}.de", T(), "fass.de") +
  expect_ascii("N", "fa\u{00DF}.de", N(), "xn--fa-hia.de") +
  expect_ascii("T", "\u{03B2}\u{03CC}\u{03BB}\u{03BF}\u{03C2}.com", T(), "xn--nxasmq6b.com") +
  expect_ascii("N", "\u{03B2}\u{03CC}\u{03BB}\u{03BF}\u{03C2}.com", N(), "xn--nxasmm1c.com") +
  expect_ascii("T", "\u{0DC1}\u{0DCA}\u{200D}\u{0DBB}\u{0DD3}.com", T(), "xn--10cl1a0b.com") +
  expect_ascii("N", "\u{0DC1}\u{0DCA}\u{200D}\u{0DBB}\u{0DD3}.com", N(), "xn--10cl1a0b660p.com") +
  expect_uvalid("T", "xn--fa-hia.de", T(), true)
}

///| UseSTD3ASCIIRules.
fn ctl_std3() -> String {
  expect_ascii("N", "a_b.com", N(), "") +
  expect_ascii("N", "a b.com", N(), "") +
  expect_ascii("N", "a\u{FF3F}b.com", N(), "") + // fullwidth low line maps to "_"
  expect_ascii("N", "a_\u{00FC}.com", N(), "") +
  expect_ascii("U", "a_b.com", U(), "a_b.com") +
  expect_ascii("U", "A_B.COM", U(), "a_b.com")
}

///| IdnaLimits: negative / zero / exact / exact+1.
fn ctl_limits() -> String {
  let sb = StringBuilder::new()
  let neg = { ..lim(), max_labels: -1 }
  match idna::to_ascii("a.com", N(), neg) {
    Err(e) => if !e.kind.eq(idna::IdnaErrorKind::LimitExceeded) { sb.write_string("negative: " + e.kind.to_string() + "; ") }
    Ok(_) => sb.write_string("negative max_labels accepted; ")
  }
  if idna::to_unicode("a.com", N(), neg).is_valid {
    sb.write_string("to_unicode negative limit valid; ")
  }
  match idna::punycode_decode_with_limits("mnchen-3ya", { ..lim(), max_punycode_input: -5 }) {
    Ok(_) => sb.write_string("punycode negative limit accepted; ")
    Err(_) => ()
  }
  let three = { ..lim(), max_labels: 3 }
  if !is_ok(idna::to_ascii("a.b.c", N(), three)) {
    sb.write_string("3 labels rejected at max_labels=3; ")
  }
  if is_ok(idna::to_ascii("a.b.c.d", N(), three)) {
    sb.write_string("4 labels accepted at max_labels=3; ")
  }
  if is_ok(idna::to_ascii("\u{00FC}.b.c.d", N(), three)) {
    sb.write_string("4 labels accepted (non-ASCII) at max_labels=3; ")
  }
  if is_ok(idna::to_ascii("\u{00DF}.b.c.d", N(), three)) {
    sb.write_string("4 labels accepted (full path) at max_labels=3; ")
  }
  let five = { ..lim(), max_input_bytes: 5 }
  if !is_ok(idna::to_ascii("a.com", N(), five)) {
    sb.write_string("5 bytes rejected at max_input_bytes=5; ")
  }
  if is_ok(idna::to_ascii("ab.com", N(), five)) {
    sb.write_string("6 bytes accepted at max_input_bytes=5; ")
  }
  let zero = { ..lim(), max_input_bytes: 0 }
  if is_ok(idna::to_ascii("a", N(), zero)) {
    sb.write_string("max_input_bytes=0 accepted input; ")
  }
  let cp = { ..lim(), max_label_codepoints: 3 }
  if !is_ok(idna::to_ascii("\u{00FC}bc.com", N(), cp)) {
    sb.write_string("3-cp label rejected at max_label_codepoints=3; ")
  }
  if is_ok(idna::to_ascii("\u{00FC}bcd.com", N(), cp)) {
    sb.write_string("4-cp label accepted at max_label_codepoints=3; ")
  }
  if is_ok(idna::to_ascii("abcd.com", N(), cp)) {
    sb.write_string("4-char ASCII label accepted at max_label_codepoints=3; ")
  }
  let pl = { ..lim(), max_punycode_input: 10 }
  if !is_ok(idna::to_ascii("xn--mnchen-3ya", N(), pl)) {
    sb.write_string("10-char punycode rejected at max_punycode_input=10; ")
  }
  if is_ok(idna::to_ascii("xn--mnchen-3yaa", N(), { ..pl, max_punycode_input: 9 })) {
    sb.write_string("punycode over limit accepted; ")
  }
  if is_ok(idna::punycode_encode_with_limits("\u{00FC}\u{00FC}\u{00FC}\u{00FC}", { ..lim(), max_label_codepoints: 3 })) {
    sb.write_string("punycode_encode over max_label_codepoints accepted; ")
  }
  if is_ok(idna::to_ascii(rep("a.", 200) + "com", N(), lim())) {
    sb.write_string("201 labels accepted at default max_labels=128; ")
  }
  sb.to_string()
}

///| NFC: composition, reordering, Hangul, and rejection of non-NFC Punycode.
fn ctl_nfc() -> String {
  expect_ascii("N", "cafe\u{0301}.fr", N(), "xn--caf-dma.fr") +
  expect_ascii("N", "\u{1112}\u{1161}\u{11AB}.kr", N(), "xn--6q8b.kr") +
  expect_ascii("N", "a\u{0302}\u{0323}.com", N(), "xn--zkg.com") +
  expect_ascii("N", "a\u{0323}\u{0302}.com", N(), "xn--zkg.com") +
  expect_ascii("N", "\u{0915}\u{093C}.in", N(), "xn--11b2f.in") + // KA + NUKTA (QA is a composition exclusion)
  expect_ascii("N", "\u{0B47}\u{0B3E}x.com", N(), "") + // ORIYA E + AA -> O (leading Mc)
  expect_ascii("N", "\u{0B15}\u{0B47}\u{0B3E}.in", N(), "xn--ohc2i.in") +
  expect_ascii("N", "xn--cafe-yvc.fr", N(), "") + // NFD Punycode: PunycodeNotNfc
  expect_uvalid("N", "xn--cafe-yvc.fr", N(), false) +
  expect_ascii("N", "\u{212B}.com", N(), "xn--5ca.com") + // ANGSTROM SIGN maps to U+00E5
  expect_ascii("N", "\u{FDFA}.com", N(), "")
}

///| `to_unicode` keeps decoding the other labels and reports every error.
fn ctl_to_unicode_best_effort() -> String {
  let sb = StringBuilder::new()
  let u = idna::to_unicode("xn--mnchen-3ya.xn--a-.xn--4db.com", N(), lim())
  if u.is_valid {
    sb.write_string("invalid domain reported valid; ")
  }
  if u.error_count < 1 {
    sb.write_string("no error counted; ")
  }
  let pre = "m\u{00FC}nchen."
  if u.output.length() < pre.length() || u.output.slice(0, pre.length()) != pre {
    sb.write_string("first label not decoded: " + hex(u.output) + "; ")
  }
  let u2 = idna::to_unicode("xn--mnchen-3ya.de", N(), lim())
  if !u2.is_valid || u2.output != "m\u{00FC}nchen.de" {
    sb.write_string("xn--mnchen-3ya.de -> " + hex(u2.output) + "; ")
  }
  let u3 = idna::to_unicode("XN--MNCHEN-3YA.DE", N(), lim())
  if !u3.is_valid || u3.output != "m\u{00FC}nchen.de" {
    sb.write_string("upper-case A-label -> " + hex(u3.output) + "; ")
  }
  sb.to_string()
}

///| Spoof defence that works, and multilingual domains that must stay readable.
fn ctl_display() -> String {
  let sb = StringBuilder::new()
  let spoof = [
    "p\u{0430}ypal.com",
    "g\u{03BF}\u{03BF}gle.com",
    "\u{0430}\u{0440}\u{0440}\u{04CF}\u{0435}.com",
    "\u{0430}m\u{0430}z\u{043E}n.com",
    "\u{0430}\u{0440}\u{0440}\u{04CF}\u{0435}.com",
    "xn--pypal-4ve.com",
    "xn--80ak6aa92e.com",
    "a\u{200D}b.com",
    "\u{0D9A}\u{0DCA}\u{200D}\u{0DBB}.com", // ZWJ after virama: valid IDN, invisible joiner
    "paypal\u{0661}\u{0031}.com",
    "\u{0581}\u{0585}\u{0585}gle.com", // Armenian + Latin
    "\u{13AA}\u{13F4}\u{13AC}.com", // Cherokee whole-script (ABE)
  ]
  let mut i = 0
  while i < spoof.length() {
    sb.write_string(expect_fallback(spoof[i], true))
    i = i + 1
  }
  let legit = [
    "\u{4E2D}\u{6587}.com",
    "\u{65E5}\u{672C}\u{8A9E}.jp",
    "\u{D55C}\u{AD6D}\u{C5B4}.kr",
    "m\u{00FC}nchen.de",
    "caf\u{00E9}.fr",
    "www.\u{0E23}\u{0E49}\u{0E32}\u{0E19}.\u{0E44}\u{0E17}\u{0E22}",
    "abc\u{4E2D}\u{6587}.com",
    "\u{30CE}\u{30FC}\u{30C8}.jp",
    "\u{0645}\u{062B}\u{0627}\u{0644}.\u{0625}\u{062E}\u{062A}\u{0628}\u{0627}\u{0631}",
    "\u{05E9}\u{05DC}\u{05D5}\u{05DD}.\u{05D9}\u{05E9}\u{05E8}\u{05D0}\u{05DC}",
    "\u{03B5}\u{03BB}\u{03BB}\u{03AC}\u{03B4}\u{03B1}.gr",
    "b\u{00FC}cher.de",
    "\u{0645}\u{0648}\u{0642}\u{0639}.\u{0634}\u{0628}\u{0643}\u{0629}",
  ]
  i = 0
  while i < legit.length() {
    sb.write_string(expect_fallback(legit[i], false))
    i = i + 1
  }
  let a = idna::display_domain_default("EXAMPLE.COM")
  if a.is_punycode_fallback || a.display != "example.com" {
    sb.write_string("EXAMPLE.COM -> " + a.display + "; ")
  }
  let m = idna::display_domain_default("m\u{00FC}nchen.de")
  if m.ascii != "xn--mnchen-3ya.de" {
    sb.write_string("ascii of münchen.de = " + m.ascii + "; ")
  }
  let o = idna::display_domain("m\u{00FC}nchen.de", idna::DisplayPolicy::strict_ascii_only())
  if o.display != "xn--mnchen-3ya.de" {
    sb.write_string("strict_ascii_only display = " + o.display + "; ")
  }
  sb.to_string()
}

///| UTS #39 skeleton on inputs without default-ignorables or RTL characters.
fn ctl_skeleton() -> String {
  let sb = StringBuilder::new()
  if !idna::are_confusable("p\u{0430}ypal", "paypal") {
    sb.write_string("pаypal !~ paypal; ")
  }
  if idna::are_confusable("paypal", "paypal") {
    sb.write_string("identical strings reported confusable; ")
  }
  if !idna::are_confusable("e\u{0301}", "\u{00E9}") {
    sb.write_string("NFD-equal strings not confusable; ")
  }
  if idna::skeleton("rn") != idna::skeleton("m") {
    sb.write_string("rn !~ m; ")
  }
  if idna::are_confusable("abc", "abd") {
    sb.write_string("abc ~ abd; ")
  }
  if !is_ascii(idna::skeleton("\u{0430}\u{0440}\u{0440}\u{04CF}\u{0435}")) {
    sb.write_string("skeleton(аррӏе) not ASCII; ")
  }
  if !idna::are_confusable("\u{00F6}", "o\u{0308}") {
    sb.write_string("ö !~ o+U+0308; ")
  }
  if idna::skeleton("") != "" {
    sb.write_string("skeleton(\"\") not empty; ")
  }
  sb.to_string()
}

///| Mixed-script / numbering-system classification.
fn ctl_scripts() -> String {
  let sb = StringBuilder::new()
  if !idna::is_mixed_script("p\u{0430}ypal") {
    sb.write_string("pаypal not mixed; ")
  }
  if idna::is_mixed_script("paypal-123") {
    sb.write_string("ASCII mixed; ")
  }
  if idna::is_mixed_script("\u{00E9}\u{0301}") {
    sb.write_string("Latin + Inherited mixed; ")
  }
  let s = idna::detect_scripts("a\u{0430}\u{4E2D}1")
  if s.length() != 3 {
    sb.write_string("detect_scripts(a а 中 1) = " + scripts_str(s) + "; ")
  }
  let x = idna::display_domain_default("\u{0915}1\u{0967}.in")
  let mut found = false
  let mut i = 0
  while i < x.reasons.length() {
    if x.reasons[i].eq(idna::SpoofReason::MixedNumberingSystems) {
      found = true
    }
    i = i + 1
  }
  if !found {
    sb.write_string("ASCII + Devanagari digits not flagged: " + reasons_str(x.reasons) + "; ")
  }
  sb.to_string()
}

///| `label_to_ascii` / `label_to_unicode` reject every UTS #46 label separator.
fn ctl_label_api() -> String {
  let sb = StringBuilder::new()
  let seps = [".", "\u{3002}", "\u{FF0E}", "\u{FF61}"]
  let mut i = 0
  while i < seps.length() {
    if is_ok(idna::label_to_ascii("a" + seps[i] + "b", N(), lim())) {
      sb.write_string("label_to_ascii accepts separator " + hex(seps[i]) + "; ")
    }
    if idna::label_to_unicode("a" + seps[i] + "b", N(), lim()).is_valid {
      sb.write_string("label_to_unicode accepts separator " + hex(seps[i]) + "; ")
    }
    i = i + 1
  }
  match idna::label_to_ascii("M\u{00FC}nchen", N(), lim()) {
    Ok(a) => if a != "xn--mnchen-3ya" { sb.write_string("label_to_ascii(München) = " + a + "; ") }
    Err(e) => sb.write_string("label_to_ascii(München) Err " + e.kind.to_string() + "; ")
  }
  sb.to_string()
}

///| Invalid UTF-8 never panics and is never valid.
fn ctl_invalid_utf8() -> String {
  let sb = StringBuilder::new()
  let bad = [unhex("61ff2e636f6d"), unhex("61c0af2e636f6d"), unhex("eda080"), unhex("f4908080"), unhex("e282")]
  let mut i = 0
  while i < bad.length() {
    if is_ok(idna::to_ascii(bad[i], U(), lim())) {
      sb.write_string("to_ascii accepts invalid UTF-8 " + hex(bad[i]) + "; ")
    }
    if idna::to_unicode(bad[i], U(), lim()).is_valid {
      sb.write_string("to_unicode valid on invalid UTF-8 " + hex(bad[i]) + "; ")
    }
    if is_ok(idna::punycode_encode(bad[i])) {
      sb.write_string("punycode_encode accepts invalid UTF-8 " + hex(bad[i]) + "; ")
    }
    let _ = idna::skeleton(bad[i])
    let _ = idna::display_domain_default(bad[i])
    i = i + 1
  }
  sb.to_string()
}

// ---------------------------------------------------------------------------------------------------------

///|
pub fn case_names() -> Array[String] {
  [
    "redteam_p1_1_nfc_quick_check_gap", "redteam_p1_2_display_raw_invalid", "redteam_p1_3_latin_homoglyph",
    "redteam_p1_4_cjk_slash_dash", "redteam_p1_5_skeleton_default_ignorable", "redteam_p1_6_skeleton_quadratic",
    "redteam_p2_9_limits_after_nfc", "redteam_p2_1_v4_xn_prefix", "redteam_p2_2_ignore_invalid_punycode",
    "redteam_p2_3_contexto_katakana_han", "redteam_p2_4_transitional_sharp_s", "redteam_p2_5_whole_script_diacritic", "redteam_p2_6_combining_overlay",
    "redteam_p2_7_bidi_skeleton", "redteam_p2_8_numbering_merge", "redteam_p2_11_display_overblocking", "control_punycode_vectors", "control_punycode_overflow", "control_hyphens",
    "control_bidi", "control_joiners", "control_contexto", "control_dns_length", "control_transitional",
    "control_std3", "control_limits", "control_nfc", "control_to_unicode_best_effort", "control_display",
    "control_skeleton", "control_scripts", "control_label_api", "control_invalid_utf8",
  ]
}

///|
pub fn run_case(name : String) -> String {
  if name == "redteam_p1_1_nfc_quick_check_gap" {
    rt_nfc_gap()
  } else if name == "redteam_p1_2_display_raw_invalid" {
    rt_display_raw_invalid()
  } else if name == "redteam_p1_3_latin_homoglyph" {
    rt_latin_homoglyph()
  } else if name == "redteam_p1_4_cjk_slash_dash" {
    rt_cjk_slash_dash()
  } else if name == "redteam_p1_5_skeleton_default_ignorable" {
    rt_skeleton_default_ignorable()
  } else if name == "redteam_p1_6_skeleton_quadratic" {
    rt_skeleton_quadratic()
  } else if name == "redteam_p2_9_limits_after_nfc" {
    rt_limits_after_nfc()
  } else if name == "redteam_p2_1_v4_xn_prefix" {
    rt_v4_xn_prefix()
  } else if name == "redteam_p2_2_ignore_invalid_punycode" {
    rt_ignore_invalid_punycode()
  } else if name == "redteam_p2_3_contexto_katakana_han" {
    rt_contexto_katakana_han()
  } else if name == "redteam_p2_4_transitional_sharp_s" {
    rt_transitional_sharp_s()
  } else if name == "redteam_p2_11_display_overblocking" {
    rt_display_overblocking()
  } else if name == "redteam_p2_8_numbering_merge" {
    rt_numbering_merge()
  } else if name == "redteam_p2_5_whole_script_diacritic" {
    rt_whole_script_diacritic()
  } else if name == "redteam_p2_6_combining_overlay" {
    rt_combining_overlay()
  } else if name == "redteam_p2_7_bidi_skeleton" {
    rt_bidi_skeleton()
  } else if name == "control_punycode_vectors" {
    ctl_punycode_vectors()
  } else if name == "control_punycode_overflow" {
    ctl_punycode_overflow()
  } else if name == "control_hyphens" {
    ctl_hyphens()
  } else if name == "control_bidi" {
    ctl_bidi()
  } else if name == "control_joiners" {
    ctl_joiners()
  } else if name == "control_contexto" {
    ctl_contexto()
  } else if name == "control_dns_length" {
    ctl_dns_length()
  } else if name == "control_transitional" {
    ctl_transitional()
  } else if name == "control_std3" {
    ctl_std3()
  } else if name == "control_limits" {
    ctl_limits()
  } else if name == "control_nfc" {
    ctl_nfc()
  } else if name == "control_to_unicode_best_effort" {
    ctl_to_unicode_best_effort()
  } else if name == "control_display" {
    ctl_display()
  } else if name == "control_skeleton" {
    ctl_skeleton()
  } else if name == "control_scripts" {
    ctl_scripts()
  } else if name == "control_label_api" {
    ctl_label_api()
  } else if name == "control_invalid_utf8" {
    ctl_invalid_utf8()
  } else {
    "unknown case " + name
  }
}

///| IdnaLimits boundary sweep: every limit at -1, 0, 1, exact and exact+1 over fixed inputs.
pub fn run_api() -> String {
  let sb = StringBuilder::new()
  let inputs = [
    "a.b.c", "m\u{00FC}nchen.de", "xn--mnchen-3ya.de", "fa\u{00DF}.de", rep("a", 63) + "." + rep("\u{00FC}", 10),
    "", ".", "..", "a" + rep("\u{0301}", 40),
  ]
  let vals = [-1, 0, 1, 2, 3, 9, 10, 11, 14, 63, 64, 1000]
  let mut f = 0
  while f < 4 {
    let mut v = 0
    while v < vals.length() {
      let base = lim()
      let l = if f == 0 {
        { ..base, max_input_bytes: vals[v] }
      } else if f == 1 {
        { ..base, max_labels: vals[v] }
      } else if f == 2 {
        { ..base, max_label_codepoints: vals[v] }
      } else {
        { ..base, max_punycode_input: vals[v] }
      }
      let mut i = 0
      while i < inputs.length() {
        let d = inputs[i]
        sb.write_string(
          "f" + f.to_string() + " v" + vals[v].to_string() + " i" + i.to_string() + " " +
          res_str(idna::to_ascii(d, N(), l)) + " ",
        )
        let u = idna::to_unicode(d, N(), l)
        sb.write_string(u.is_valid.to_string() + "/" + u.error_count.to_string() + " " + hex(u.output) + " ")
        sb.write_string(res_str(idna::punycode_encode_with_limits(d, l)) + " ")
        sb.write_string(res_str(idna::punycode_decode_with_limits(d, l)) + " ")
        let x = idna::display_domain(d, { ..idna::DisplayPolicy::browser_default(), limits: l })
        sb.write_string(x.is_punycode_fallback.to_string() + " " + hex(x.display) + "\n")
        i = i + 1
      }
      v = v + 1
    }
    f = f + 1
  }
  sb.to_string()
}
