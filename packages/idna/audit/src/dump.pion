///| Canonical, byte-exact dump of every public `idna` entry point for one input (see ../diff/compare.py).
///| All strings are printed as lowercase hex so that the dump is plain ASCII whatever the input bytes are.

///|
fn hexval(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

///| Decode a hex string into a byte string.
pub fn unhex(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i + 1 < s.length() {
    sb.write_byte(
      ((hexval(s.code_unit_at(i)) << 4) | hexval(s.code_unit_at(i + 1))).to_byte(),
    )
    i = i + 2
  }
  sb.to_string()
}

///|
fn hexdigit(v : Int) -> Int {
  if v < 10 {
    48 + v
  } else {
    87 + v
  }
}

///| Lowercase hex of the bytes of `s` ("-" for the empty string).
pub fn hex(s : String) -> String {
  let n = s.length()
  if n == 0 {
    return "-"
  }
  let sb = StringBuilder::with_capacity(n * 2)
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i) & 255
    sb.write_byte(hexdigit(c >> 4).to_byte())
    sb.write_byte(hexdigit(c & 15).to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Option profiles exercised by the dump: S strict, U url, N non-transitional, T transitional,
///| R raw (every check off), I url + ignore_invalid_punycode.
pub fn profile_names() -> Array[String] {
  ["S", "U", "N", "T", "R", "I"]
}

///|
pub fn profile(name : String) -> idna::IdnaOptions {
  let u = idna::IdnaOptions::uts46_url()
  if name == "S" {
    idna::IdnaOptions::uts46_strict()
  } else if name == "U" {
    u
  } else if name == "N" {
    idna::IdnaOptions::uts46_non_transitional()
  } else if name == "T" {
    idna::IdnaOptions::uts46_transitional()
  } else if name == "R" {
    {
      ..u,
      check_bidi: false,
      check_joiners: false,
      check_contexto: false,
      deny_dot_in_label: false,
    }
  } else {
    { ..u, ignore_invalid_punycode: true }
  }
}

///|
pub fn ascii_line(p : String, r : Result[String, idna::IdnaError]) -> String {
  match r {
    Ok(a) => "A " + p + " OK " + hex(a) + "\n"
    Err(e) => "A " + p + " ERR " + e.kind.to_string() + "\n"
  }
}

///|
pub fn unicode_line(p : String, u : idna::UnicodeResult) -> String {
  let k = match u.first_error {
    Some(e) => e.kind.to_string()
    None => "-"
  }
  "U " +
  p +
  " " +
  (if u.is_valid { "1" } else { "0" }) +
  " " +
  u.error_count.to_string() +
  " " +
  k +
  " " +
  hex(u.output) +
  "\n"
}

///|
pub fn reasons_str(rs : Array[idna::SpoofReason]) -> String {
  if rs.length() == 0 {
    return "-"
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < rs.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(rs[i].to_string())
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn scripts_str(ss : Array[idna::Script]) -> String {
  if ss.length() == 0 {
    return "-"
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ss.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(ss[i].id().to_string())
    i = i + 1
  }
  sb.to_string()
}

///| Every public entry point applied to one input.
pub fn dump_case(d : String) -> String {
  let lim = idna::IdnaLimits::default()
  let sb = StringBuilder::new()
  let ps = profile_names()
  let mut i = 0
  while i < ps.length() {
    let o = profile(ps[i])
    sb.write_string(ascii_line(ps[i], idna::to_ascii(d, o, lim)))
    sb.write_string(unicode_line(ps[i], idna::to_unicode(d, o, lim)))
    i = i + 1
  }
  sb.write_string(ascii_line("L", idna::label_to_ascii(d, profile("N"), lim)))
  sb.write_string(unicode_line("L", idna::label_to_unicode(d, profile("N"), lim)))
  sb.write_string("K " + hex(idna::skeleton(d)) + "\n")
  sb.write_string("C " + scripts_str(idna::detect_scripts(d)) + "\n")
  let x = idna::display_domain_default(d)
  sb.write_string(
    "D " +
    (if x.is_punycode_fallback { "1" } else { "0" }) +
    " " +
    reasons_str(x.reasons) +
    " " +
    hex(x.display) +
    " " +
    hex(x.ascii) +
    "\n",
  )
  match idna::punycode_encode(d) {
    Ok(p) => sb.write_string("P OK " + hex(p) + "\n")
    Err(e) => sb.write_string("P ERR " + e.kind.to_string() + "\n")
  }
  match idna::punycode_decode(d) {
    Ok(p) => sb.write_string("Q OK " + hex(p) + "\n")
    Err(e) => sb.write_string("Q ERR " + e.kind.to_string() + "\n")
  }
  sb.to_string()
}
