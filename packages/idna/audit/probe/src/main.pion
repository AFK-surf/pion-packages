///| Concurrency probe: 8 threads call to_ascii / to_unicode / display_domain / skeleton and compare with the
///| single-threaded results (module-level FixedArray tables must be safe to read from every thread).

import "idna"

///|
fn dom(k : Int) -> String {
  let r = k % 5
  if r == 0 {
    "m\u{00FC}nchen.de"
  } else if r == 1 {
    "p\u{0430}ypal.com"
  } else if r == 2 {
    "\u{4E2D}\u{6587}.com"
  } else if r == 3 {
    "xn--mnchen-3ya.de"
  } else {
    "fa\u{00DF}.de"
  }
}

///|
fn sig(k : Int) -> Int {
  let d = dom(k)
  let a = match idna::to_ascii_default(d) {
    Ok(x) => x
    Err(_) => "E"
  }
  let u = idna::to_unicode_default(a)
  let x = idna::display_domain_default(d)
  a.length() * 7 + u.output.length() * 5 + x.display.length() * 3 + idna::skeleton(d).length()
}

///|
pub fn main(world : World) -> Int {
  let mut want = 0
  let mut k = 0
  while k < 5 {
    want = want + sig(k)
    k = k + 1
  }
  let w = want
  let bad = AtomicInt::new(0)
  let total = AtomicInt::new(0)
  scope(world, fn(s : Scope) -> Unit {
    let mut t = 0
    while t < 8 {
      spawn(s, fn() -> Unit {
        let mut j = 0
        while j < 2000 {
          let mut acc = 0
          let mut q = 0
          while q < 5 {
            acc = acc + sig(q)
            q = q + 1
          }
          if acc != w {
            let _ = bad.fetch_add(1)
          }
          let _ = total.fetch_add(1)
          j = j + 1
        }
      })
      t = t + 1
    }
  })
  io_println(world, "concurrent rounds=" + total.load().to_string() + " mismatches=" + bad.load().to_string())
  0
}
