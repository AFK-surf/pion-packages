///| Compliance, pixel-accuracy, and security test suite for `packages/webp`.
///| All real WebP vectors were encoded by `cwebp` and verified against `golang.org/x/image/webp`.

fn assert_eq_int(a : Int, b : Int, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got " + a.to_string() + ", expected " + b.to_string())
}

fn assert_eq_bool(a : Bool, b : Bool, msg : String) -> Unit {
  debug_assert(a == b, msg)
}

fn assert_eq_u64(a : UInt64, b : UInt64, msg : String) -> Unit {
  debug_assert(a == b, msg + ": got " + a.to_string() + ", expected " + b.to_string())
}

fn mk_bytes(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

fn fnv1a64(b : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = b.length()
  let mut i = 0
  while i < n {
    h = h ^ b[i].to_int().to_int64().to_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

