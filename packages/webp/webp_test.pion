test "probe_header_vp8l_vp8_vp8x" {
  match probe_header(vec_vp8l_16x16_grad_alpha()) {
    Ok(h) => {
      assert_eq_int(h.width, 16, "vp8l width")
      assert_eq_int(h.height, 16, "vp8l height")
      assert_eq_bool(h.has_alpha, true, "vp8l has_alpha")
      match h.format {
        WebpFormat::Lossless => ()
        _ => debug_assert(false, "expected Lossless")
      }
    }
    Err(e) => debug_assert(false, "probe vp8l failed: " + e.to_string())
  }

  match probe_header(vec_vp8_17x13_lossy()) {
    Ok(h) => {
      assert_eq_int(h.width, 17, "vp8 width")
      assert_eq_int(h.height, 13, "vp8 height")
      assert_eq_bool(h.has_alpha, false, "vp8 has_alpha")
      match h.format {
        WebpFormat::Lossy => ()
        _ => debug_assert(false, "expected Lossy")
      }
    }
    Err(e) => debug_assert(false, "probe vp8 failed: " + e.to_string())
  }

  match probe_header(vec_vp8x_17x13_alph_raw_f0()) {
    Ok(h) => {
      assert_eq_int(h.width, 17, "vp8x width")
      assert_eq_int(h.height, 13, "vp8x height")
      assert_eq_bool(h.has_alpha, true, "vp8x has_alpha")
      assert_eq_bool(h.has_exif, true, "vp8x has_exif")
      assert_eq_bool(h.has_icc, false, "vp8x has_icc")
      assert_eq_bool(h.has_xmp, false, "vp8x has_xmp")
      assert_eq_bool(h.has_animation, false, "vp8x has_animation")
      match h.format {
        WebpFormat::Extended => ()
        _ => debug_assert(false, "expected Extended")
      }
    }
    Err(e) => debug_assert(false, "probe vp8x failed: " + e.to_string())
  }
}

test "decode_vp8l_1x1_red" {
  match decode(vec_vp8l_1x1_red()) {
    Ok(img) => {
      assert_eq_int(img.width, 1, "w")
      assert_eq_int(img.height, 1, "h")
      assert_eq_int(img.rgba.length(), 4, "len")
      assert_eq_int(img.rgba[0].to_int(), 255, "r")
      assert_eq_int(img.rgba[1].to_int(), 0, "g")
      assert_eq_int(img.rgba[2].to_int(), 0, "b")
      assert_eq_int(img.rgba[3].to_int(), 255, "a")
      assert_eq_u64(fnv1a64(img.rgba), 7593310196735934163UL, "fnv64")
    }
    Err(e) => debug_assert(false, "decode failed: " + e.to_string())
  }
}

test "decode_vp8l_4x4_palette2" {
  match decode(vec_vp8l_4x4_palette2()) {
    Ok(img) => {
      assert_eq_int(img.width, 4, "w")
      assert_eq_int(img.height, 4, "h")
      assert_eq_int(img.rgba.length(), 64, "len")
      assert_eq_int(img.rgba[0].to_int(), 10, "r0")
      assert_eq_int(img.rgba[1].to_int(), 20, "g0")
      assert_eq_int(img.rgba[2].to_int(), 30, "b0")
      assert_eq_int(img.rgba[3].to_int(), 255, "a0")
      assert_eq_int(img.rgba[4].to_int(), 200, "r1")
      assert_eq_int(img.rgba[5].to_int(), 150, "g1")
      assert_eq_int(img.rgba[6].to_int(), 100, "b1")
      assert_eq_int(img.rgba[7].to_int(), 128, "a1")
      assert_eq_u64(fnv1a64(img.rgba), 15634804350825644677UL, "fnv64")
    }
    Err(e) => debug_assert(false, "decode failed: " + e.to_string())
  }
}

test "decode_vp8l_16x16_grad_alpha" {
  match decode(vec_vp8l_16x16_grad_alpha()) {
    Ok(img) => {
      assert_eq_int(img.width, 16, "w")
      assert_eq_int(img.height, 16, "h")
      assert_eq_int(img.rgba.length(), 1024, "len")
      assert_eq_int(img.rgba[0].to_int(), 0, "r0")
      assert_eq_int(img.rgba[3].to_int(), 128, "a0")
      assert_eq_int(img.rgba[1020].to_int(), 74, "r_last")
      assert_eq_int(img.rgba[1021].to_int(), 14, "g_last")
      assert_eq_int(img.rgba[1022].to_int(), 0, "b_last")
      assert_eq_int(img.rgba[1023].to_int(), 248, "a_last")
      assert_eq_u64(fnv1a64(img.rgba), 12420637356515786181UL, "fnv64")
    }
    Err(e) => debug_assert(false, "decode failed: " + e.to_string())
  }
}

test "decode_vp8_17x13_lossy_normal_and_simple_lf" {
  match decode(vec_vp8_17x13_lossy()) {
    Ok(img) => {
      assert_eq_int(img.width, 17, "w")
      assert_eq_int(img.height, 13, "h")
      assert_eq_bool(img.has_alpha, false, "has_alpha")
      assert_eq_int(img.rgba.length(), 17 * 13 * 4, "len")
      assert_eq_int(img.rgba[0].to_int(), 38, "r0")
      assert_eq_int(img.rgba[1].to_int(), 42, "g0")
      assert_eq_int(img.rgba[2].to_int(), 16, "b0")
      assert_eq_int(img.rgba[3].to_int(), 255, "a0")
      assert_eq_u64(fnv1a64(img.rgba), 18126280748633696700UL, "fnv64")
    }
    Err(e) => debug_assert(false, "decode vp8 normal failed: " + e.to_string())
  }

  match decode(vec_vp8_17x13_simple_lf()) {
    Ok(img) => {
      assert_eq_int(img.width, 17, "w")
      assert_eq_int(img.height, 13, "h")
      assert_eq_int(img.rgba.length(), 17 * 13 * 4, "len")
      assert_eq_int(img.rgba[0].to_int(), 35, "r0")
      assert_eq_int(img.rgba[1].to_int(), 41, "g0")
      assert_eq_int(img.rgba[2].to_int(), 19, "b0")
      assert_eq_int(img.rgba[3].to_int(), 255, "a0")
      assert_eq_u64(fnv1a64(img.rgba), 6458512643890719645UL, "fnv64")
    }
    Err(e) => debug_assert(false, "decode vp8 simple failed: " + e.to_string())
  }
}

test "decode_vp8x_alph_vp8l_and_all_four_raw_filters" {
  match decode(vec_vp8x_17x13_alph_vp8l()) {
    Ok(img) => {
      assert_eq_int(img.width, 17, "w")
      assert_eq_int(img.height, 13, "h")
      assert_eq_bool(img.has_alpha, true, "has_alpha")
      assert_eq_int(img.rgba.length(), 17 * 13 * 4, "len")
      assert_eq_int(img.rgba[0].to_int(), 92, "r0")
      assert_eq_int(img.rgba[1].to_int(), 96, "g0")
      assert_eq_int(img.rgba[2].to_int(), 71, "b0")
      assert_eq_int(img.rgba[3].to_int(), 0, "a0")
      assert_eq_u64(fnv1a64(img.rgba), 15335733769688195600UL, "fnv64")
    }
    Err(e) => debug_assert(false, "decode vp8x alph vp8l failed: " + e.to_string())
  }

  let expected_raw_hash : UInt64 = 6646428005055892657UL
  let raw_vecs = [
    vec_vp8x_17x13_alph_raw_f0(),
    vec_vp8x_17x13_alph_raw_f1(),
    vec_vp8x_17x13_alph_raw_f2(),
    vec_vp8x_17x13_alph_raw_f3(),
  ]
  let mut i = 0
  while i < raw_vecs.length() {
    match decode(raw_vecs[i]) {
      Ok(img) => {
        assert_eq_int(img.width, 17, "w")
        assert_eq_int(img.height, 13, "h")
        assert_eq_bool(img.has_alpha, true, "has_alpha")
        assert_eq_u64(fnv1a64(img.rgba), expected_raw_hash, "raw filter " + i.to_string())
      }
      Err(e) => debug_assert(false, "decode raw filter failed: " + e.to_string())
    }
    i = i + 1
  }
}

test "security_decode_limits_bombs" {
  // 1. 16383x16383 VP8L bomb (default max_pixels=16M rejects immediately before pixel alloc)
  let vp8l_bomb = mk_bytes([
    0x52, 0x49, 0x46, 0x46, 20, 0, 0, 0, 0x57, 0x45, 0x42, 0x50,
    0x56, 0x50, 0x38, 0x4C, 8, 0, 0, 0,
    0x2F, 0xFE, 0xBF, 0xFF, 0x0F, 0x00, 0x00, 0x00,
  ])
  match decode(vp8l_bomb) {
    Err(WebpError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for vp8l bomb")
  }

  // 2. 16383x16383 VP8X bomb
  let vp8x_bomb = mk_bytes([
    0x52, 0x49, 0x46, 0x46, 22, 0, 0, 0, 0x57, 0x45, 0x42, 0x50,
    0x56, 0x50, 0x38, 0x58, 10, 0, 0, 0,
    0x00, 0x00, 0x00, 0x00,
    0xFE, 0x3F, 0x00,
    0xFE, 0x3F, 0x00,
  ])
  match decode(vp8x_bomb) {
    Err(WebpError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for vp8x bomb")
  }

  // 3. Custom tight limits reject 16x16 image
  let tight = DecodeLimits::new(8, 16, 256, 1024, 4)
  match decode_with_limits(vec_vp8l_16x16_grad_alpha(), tight) {
    Err(WebpError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for tight limits")
  }
}

test "security_malformed_containers_and_truncation" {
  match decode(Bytes::new(0)) {
    Err(WebpError::UnexpectedEof(_)) => ()
    _ => debug_assert(false, "expected UnexpectedEof for empty input")
  }

  let bad_riff = mk_bytes([0x50, 0x4E, 0x47, 0x20, 12, 0, 0, 0, 0x57, 0x45, 0x42, 0x50])
  match probe_header(bad_riff) {
    Err(WebpError::InvalidContainer(_)) => ()
    _ => debug_assert(false, "expected InvalidContainer for bad RIFF")
  }

  let bad_form = mk_bytes([0x52, 0x49, 0x46, 0x46, 12, 0, 0, 0, 0x57, 0x41, 0x56, 0x45])
  match probe_header(bad_form) {
    Err(WebpError::InvalidContainer(_)) => ()
    _ => debug_assert(false, "expected InvalidContainer for bad WEBP form")
  }

  let full_vp8l = vec_vp8l_16x16_grad_alpha()
  let mut cut = 12
  while cut < 50 {
    let slice = full_vp8l.slice(0, cut)
    match decode(slice) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "expected Err on truncated VP8L")
    }
    cut = cut + 7
  }

  let full_vp8 = vec_vp8_17x13_lossy()
  let mut vcut = 12
  while vcut < 60 {
    let slice = full_vp8.slice(0, vcut)
    match decode(slice) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "expected Err on truncated VP8")
    }
    vcut = vcut + 8
  }
}
