///| RFC 6386 VP8 Intra Prediction (16x16, 8x8, 4x4) and Inverse Transforms (WHT16 + IDCT4).
///| Workspace `ybr` is a flat 26 * 32 = 832-element `FixedArray[Int]` (row stride 32).

let vp8_pred_dc : Int = 0
let vp8_pred_tm : Int = 1
let vp8_pred_ve : Int = 2
let vp8_pred_he : Int = 3
let vp8_pred_rd : Int = 4
let vp8_pred_vr : Int = 5
let vp8_pred_ld : Int = 6
let vp8_pred_vl : Int = 7
let vp8_pred_hd : Int = 8
let vp8_pred_hu : Int = 9
let vp8_pred_dc_top : Int = 10
let vp8_pred_dc_left : Int = 11
let vp8_pred_dc_top_left : Int = 12

fn vp8_clip(x : Int, lo : Int, hi : Int) -> Int {
  if x < lo {
    lo
  } else if x > hi {
    hi
  } else {
    x
  }
}

fn vp8_clip8(x : Int) -> Int {
  if x < 0 {
    0
  } else if x > 255 {
    255
  } else {
    x
  }
}

fn vp8_check_top_left_pred(mbx : Int, mby : Int, p : Int) -> Int {
  if p != vp8_pred_dc {
    return p
  }
  if mbx == 0 {
    if mby == 0 {
      return vp8_pred_dc_top_left
    }
    return vp8_pred_dc_left
  }
  if mby == 0 {
    return vp8_pred_dc_top
  }
  vp8_pred_dc
}

///| 4x4 Intra prediction into `ybr` at `(y, x)` (row stride 32).
fn vp8_pred4(ybr : FixedArray[Int], mode : Int, y : Int, x : Int) -> Unit {
  let r0 = y * 32 + x
  let rm1 = (y - 1) * 32 + x
  if mode == vp8_pred_dc {
    let sum = 4 +
    ybr[rm1] + ybr[rm1 + 1] + ybr[rm1 + 2] + ybr[rm1 + 3] +
    ybr[r0 - 1] + ybr[r0 + 31] + ybr[r0 + 63] + ybr[r0 + 95]
    let avg = sum >> 3
    let mut j = 0
    while j < 4 {
      let row = r0 + j * 32
      ybr[row] = avg
      ybr[row + 1] = avg
      ybr[row + 2] = avg
      ybr[row + 3] = avg
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_tm {
    let d0 = -ybr[rm1 - 1]
    let t0 = ybr[rm1]
    let t1 = ybr[rm1 + 1]
    let t2 = ybr[rm1 + 2]
    let t3 = ybr[rm1 + 3]
    let mut j = 0
    while j < 4 {
      let row = r0 + j * 32
      let d1 = d0 + ybr[row - 1]
      let mut v0 = d1 + t0
      if v0 < 0 { v0 = 0 } else if v0 > 255 { v0 = 255 }
      ybr[row] = v0
      let mut v1 = d1 + t1
      if v1 < 0 { v1 = 0 } else if v1 > 255 { v1 = 255 }
      ybr[row + 1] = v1
      let mut v2 = d1 + t2
      if v2 < 0 { v2 = 0 } else if v2 > 255 { v2 = 255 }
      ybr[row + 2] = v2
      let mut v3 = d1 + t3
      if v3 < 0 { v3 = 0 } else if v3 > 255 { v3 = 255 }
      ybr[row + 3] = v3
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_ve {
    let a = ybr[rm1 - 1]
    let b = ybr[rm1]
    let c = ybr[rm1 + 1]
    let d = ybr[rm1 + 2]
    let e = ybr[rm1 + 3]
    let f = ybr[rm1 + 4]
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    let cde = (c + 2 * d + e + 2) >> 2
    let def = (d + 2 * e + f + 2) >> 2
    let mut j = 0
    while j < 4 {
      let row = r0 + j * 32
      ybr[row] = abc
      ybr[row + 1] = bcd
      ybr[row + 2] = cde
      ybr[row + 3] = def
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_he {
    let a = ybr[rm1 - 1]
    let p = ybr[r0 - 1]
    let q = ybr[r0 + 31]
    let r = ybr[r0 + 63]
    let s = ybr[r0 + 95]
    let apq = (a + 2 * p + q + 2) >> 2
    let rqp = (r + 2 * q + p + 2) >> 2
    let srq = (s + 2 * r + q + 2) >> 2
    let ssr = (s + 2 * s + r + 2) >> 2
    let mut i = 0
    while i < 4 {
      ybr[r0 + i] = apq
      ybr[r0 + 32 + i] = rqp
      ybr[r0 + 64 + i] = srq
      ybr[r0 + 96 + i] = ssr
      i = i + 1
    }
    return
  }
  if mode == vp8_pred_rd {
    let s = ybr[r0 + 95]
    let r = ybr[r0 + 63]
    let q = ybr[r0 + 31]
    let p = ybr[r0 - 1]
    let a = ybr[rm1 - 1]
    let b = ybr[rm1]
    let c = ybr[rm1 + 1]
    let d = ybr[rm1 + 2]
    let e = ybr[rm1 + 3]
    let srq = (s + 2 * r + q + 2) >> 2
    let rqp = (r + 2 * q + p + 2) >> 2
    let qpa = (q + 2 * p + a + 2) >> 2
    let pab = (p + 2 * a + b + 2) >> 2
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    let cde = (c + 2 * d + e + 2) >> 2
    ybr[r0] = pab
    ybr[r0 + 1] = abc
    ybr[r0 + 2] = bcd
    ybr[r0 + 3] = cde
    ybr[r0 + 32] = qpa
    ybr[r0 + 33] = pab
    ybr[r0 + 34] = abc
    ybr[r0 + 35] = bcd
    ybr[r0 + 64] = rqp
    ybr[r0 + 65] = qpa
    ybr[r0 + 66] = pab
    ybr[r0 + 67] = abc
    ybr[r0 + 96] = srq
    ybr[r0 + 97] = rqp
    ybr[r0 + 98] = qpa
    ybr[r0 + 99] = pab
    return
  }
  if mode == vp8_pred_vr {
    let r = ybr[r0 + 63]
    let q = ybr[r0 + 31]
    let p = ybr[r0 - 1]
    let a = ybr[rm1 - 1]
    let b = ybr[rm1]
    let c = ybr[rm1 + 1]
    let d = ybr[rm1 + 2]
    let e = ybr[rm1 + 3]
    let ab = (a + b + 1) >> 1
    let bc = (b + c + 1) >> 1
    let cd = (c + d + 1) >> 1
    let de = (d + e + 1) >> 1
    let rqp = (r + 2 * q + p + 2) >> 2
    let qpa = (q + 2 * p + a + 2) >> 2
    let pab = (p + 2 * a + b + 2) >> 2
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    let cde = (c + 2 * d + e + 2) >> 2
    ybr[r0] = ab
    ybr[r0 + 1] = bc
    ybr[r0 + 2] = cd
    ybr[r0 + 3] = de
    ybr[r0 + 32] = pab
    ybr[r0 + 33] = abc
    ybr[r0 + 34] = bcd
    ybr[r0 + 35] = cde
    ybr[r0 + 64] = qpa
    ybr[r0 + 65] = ab
    ybr[r0 + 66] = bc
    ybr[r0 + 67] = cd
    ybr[r0 + 96] = rqp
    ybr[r0 + 97] = pab
    ybr[r0 + 98] = abc
    ybr[r0 + 99] = bcd
    return
  }
  if mode == vp8_pred_ld {
    let a = ybr[rm1]
    let b = ybr[rm1 + 1]
    let c = ybr[rm1 + 2]
    let d = ybr[rm1 + 3]
    let e = ybr[rm1 + 4]
    let f = ybr[rm1 + 5]
    let g = ybr[rm1 + 6]
    let h = ybr[rm1 + 7]
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    let cde = (c + 2 * d + e + 2) >> 2
    let def = (d + 2 * e + f + 2) >> 2
    let efg = (e + 2 * f + g + 2) >> 2
    let fgh = (f + 2 * g + h + 2) >> 2
    let ghh = (g + 2 * h + h + 2) >> 2
    ybr[r0] = abc
    ybr[r0 + 1] = bcd
    ybr[r0 + 2] = cde
    ybr[r0 + 3] = def
    ybr[r0 + 32] = bcd
    ybr[r0 + 33] = cde
    ybr[r0 + 34] = def
    ybr[r0 + 35] = efg
    ybr[r0 + 64] = cde
    ybr[r0 + 65] = def
    ybr[r0 + 66] = efg
    ybr[r0 + 67] = fgh
    ybr[r0 + 96] = def
    ybr[r0 + 97] = efg
    ybr[r0 + 98] = fgh
    ybr[r0 + 99] = ghh
    return
  }
  if mode == vp8_pred_vl {
    let a = ybr[rm1]
    let b = ybr[rm1 + 1]
    let c = ybr[rm1 + 2]
    let d = ybr[rm1 + 3]
    let e = ybr[rm1 + 4]
    let f = ybr[rm1 + 5]
    let g = ybr[rm1 + 6]
    let h = ybr[rm1 + 7]
    let ab = (a + b + 1) >> 1
    let bc = (b + c + 1) >> 1
    let cd = (c + d + 1) >> 1
    let de = (d + e + 1) >> 1
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    let cde = (c + 2 * d + e + 2) >> 2
    let def = (d + 2 * e + f + 2) >> 2
    let efg = (e + 2 * f + g + 2) >> 2
    let fgh = (f + 2 * g + h + 2) >> 2
    ybr[r0] = ab
    ybr[r0 + 1] = bc
    ybr[r0 + 2] = cd
    ybr[r0 + 3] = de
    ybr[r0 + 32] = abc
    ybr[r0 + 33] = bcd
    ybr[r0 + 34] = cde
    ybr[r0 + 35] = def
    ybr[r0 + 64] = bc
    ybr[r0 + 65] = cd
    ybr[r0 + 66] = de
    ybr[r0 + 67] = efg
    ybr[r0 + 96] = bcd
    ybr[r0 + 97] = cde
    ybr[r0 + 98] = def
    ybr[r0 + 99] = fgh
    return
  }
  if mode == vp8_pred_hd {
    let s = ybr[r0 + 95]
    let r = ybr[r0 + 63]
    let q = ybr[r0 + 31]
    let p = ybr[r0 - 1]
    let a = ybr[rm1 - 1]
    let b = ybr[rm1]
    let c = ybr[rm1 + 1]
    let d = ybr[rm1 + 2]
    let sr = (s + r + 1) >> 1
    let rq = (r + q + 1) >> 1
    let qp = (q + p + 1) >> 1
    let pa = (p + a + 1) >> 1
    let srq = (s + 2 * r + q + 2) >> 2
    let rqp = (r + 2 * q + p + 2) >> 2
    let qpa = (q + 2 * p + a + 2) >> 2
    let pab = (p + 2 * a + b + 2) >> 2
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    ybr[r0] = pa
    ybr[r0 + 1] = pab
    ybr[r0 + 2] = abc
    ybr[r0 + 3] = bcd
    ybr[r0 + 32] = qp
    ybr[r0 + 33] = qpa
    ybr[r0 + 34] = pa
    ybr[r0 + 35] = pab
    ybr[r0 + 64] = rq
    ybr[r0 + 65] = rqp
    ybr[r0 + 66] = qp
    ybr[r0 + 67] = qpa
    ybr[r0 + 96] = sr
    ybr[r0 + 97] = srq
    ybr[r0 + 98] = rq
    ybr[r0 + 99] = rqp
    return
  }
  // vp8_pred_hu
  let s = ybr[r0 + 95]
  let r = ybr[r0 + 63]
  let q = ybr[r0 + 31]
  let p = ybr[r0 - 1]
  let pq = (p + q + 1) >> 1
  let qr = (q + r + 1) >> 1
  let rs = (r + s + 1) >> 1
  let pqr = (p + 2 * q + r + 2) >> 2
  let qrs = (q + 2 * r + s + 2) >> 2
  let rss = (r + 2 * s + s + 2) >> 2
  ybr[r0] = pq
  ybr[r0 + 1] = pqr
  ybr[r0 + 2] = qr
  ybr[r0 + 3] = qrs
  ybr[r0 + 32] = qr
  ybr[r0 + 33] = qrs
  ybr[r0 + 34] = rs
  ybr[r0 + 35] = rss
  ybr[r0 + 64] = rs
  ybr[r0 + 65] = rss
  ybr[r0 + 66] = s
  ybr[r0 + 67] = s
  ybr[r0 + 96] = s
  ybr[r0 + 97] = s
  ybr[r0 + 98] = s
  ybr[r0 + 99] = s
}

///| 8x8 Chroma Intra prediction into `ybr` at `(y, x)`.
fn vp8_pred8(ybr : FixedArray[Int], mode : Int, y : Int, x : Int) -> Unit {
  let r0 = y * 32 + x
  let rm1 = (y - 1) * 32 + x
  if mode == vp8_pred_dc {
    let mut sum = 8
    let mut i = 0
    while i < 8 {
      sum = sum + ybr[rm1 + i] + ybr[r0 + i * 32 - 1]
      i = i + 1
    }
    let avg = sum >> 4
    let mut j = 0
    while j < 8 {
      let row = r0 + j * 32
      let mut k = 0
      while k < 8 {
        ybr[row + k] = avg
        k = k + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_tm {
    let d0 = -ybr[rm1 - 1]
    let mut j = 0
    while j < 8 {
      let row = r0 + j * 32
      let d1 = d0 + ybr[row - 1]
      let mut i = 0
      while i < 8 {
        ybr[row + i] = vp8_clip8(d1 + ybr[rm1 + i])
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_ve {
    let mut j = 0
    while j < 8 {
      let row = r0 + j * 32
      let mut i = 0
      while i < 8 {
        ybr[row + i] = ybr[rm1 + i]
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_he {
    let mut j = 0
    while j < 8 {
      let row = r0 + j * 32
      let v = ybr[row - 1]
      let mut i = 0
      while i < 8 {
        ybr[row + i] = v
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_dc_top {
    let mut sum = 4
    let mut j = 0
    while j < 8 {
      sum = sum + ybr[r0 + j * 32 - 1]
      j = j + 1
    }
    let avg = sum >> 3
    j = 0
    while j < 8 {
      let row = r0 + j * 32
      let mut i = 0
      while i < 8 {
        ybr[row + i] = avg
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_dc_left {
    let mut sum = 4
    let mut i = 0
    while i < 8 {
      sum = sum + ybr[rm1 + i]
      i = i + 1
    }
    let avg = sum >> 3
    let mut j = 0
    while j < 8 {
      let row = r0 + j * 32
      let mut k = 0
      while k < 8 {
        ybr[row + k] = avg
        k = k + 1
      }
      j = j + 1
    }
    return
  }
  // vp8_pred_dc_top_left
  let mut j = 0
  while j < 8 {
    let row = r0 + j * 32
    let mut i = 0
    while i < 8 {
      ybr[row + i] = 0x80
      i = i + 1
    }
    j = j + 1
  }
}

///| 16x16 Luma Intra prediction into `ybr` at `(y, x)`.
fn vp8_pred16(ybr : FixedArray[Int], mode : Int, y : Int, x : Int) -> Unit {
  let r0 = y * 32 + x
  let rm1 = (y - 1) * 32 + x
  if mode == vp8_pred_dc {
    let mut sum = 16
    let mut i = 0
    while i < 16 {
      sum = sum + ybr[rm1 + i] + ybr[r0 + i * 32 - 1]
      i = i + 1
    }
    let avg = sum >> 5
    let mut j = 0
    while j < 16 {
      let row = r0 + j * 32
      let mut k = 0
      while k < 16 {
        ybr[row + k] = avg
        k = k + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_tm {
    let d0 = -ybr[rm1 - 1]
    let mut j = 0
    while j < 16 {
      let row = r0 + j * 32
      let d1 = d0 + ybr[row - 1]
      let mut i = 0
      while i < 16 {
        ybr[row + i] = vp8_clip8(d1 + ybr[rm1 + i])
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_ve {
    let mut j = 0
    while j < 16 {
      let row = r0 + j * 32
      let mut i = 0
      while i < 16 {
        ybr[row + i] = ybr[rm1 + i]
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_he {
    let mut j = 0
    while j < 16 {
      let row = r0 + j * 32
      let v = ybr[row - 1]
      let mut i = 0
      while i < 16 {
        ybr[row + i] = v
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_dc_top {
    let mut sum = 8
    let mut j = 0
    while j < 16 {
      sum = sum + ybr[r0 + j * 32 - 1]
      j = j + 1
    }
    let avg = sum >> 4
    j = 0
    while j < 16 {
      let row = r0 + j * 32
      let mut i = 0
      while i < 16 {
        ybr[row + i] = avg
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_dc_left {
    let mut sum = 8
    let mut i = 0
    while i < 16 {
      sum = sum + ybr[rm1 + i]
      i = i + 1
    }
    let avg = sum >> 4
    let mut j = 0
    while j < 16 {
      let row = r0 + j * 32
      let mut k = 0
      while k < 16 {
        ybr[row + k] = avg
        k = k + 1
      }
      j = j + 1
    }
    return
  }
  // vp8_pred_dc_top_left
  let mut j = 0
  while j < 16 {
    let row = r0 + j * 32
    let mut i = 0
    while i < 16 {
      ybr[row + i] = 0x80
      i = i + 1
    }
    j = j + 1
  }
}

///| 4x4 Inverse DCT (RFC 6386 §14.3) added onto `ybr[y..y+4][x..x+4]`, clearing `coeff[base..base+16]`.
///| Keeps all 16 intermediate values in scalar registers (zero `tmp` array loads/stores/bounds checks).
fn vp8_idct4(ybr : FixedArray[Int], coeff : FixedArray[Int], y : Int, x : Int, base : Int) -> Unit {
  let c1 = 85627
  let c2 = 35468

  // Column 0
  let c00 = coeff[base]
  let c04 = coeff[base + 4]
  let c08 = coeff[base + 8]
  let c0c = coeff[base + 12]
  coeff[base] = 0
  coeff[base + 4] = 0
  coeff[base + 8] = 0
  coeff[base + 12] = 0
  let a0 = c00 + c08
  let b0 = c00 - c08
  let k0 = ((c04 * c2) >> 16) - ((c0c * c1) >> 16)
  let d0 = ((c04 * c1) >> 16) + ((c0c * c2) >> 16)
  let t00 = a0 + d0
  let t01 = b0 + k0
  let t02 = b0 - k0
  let t03 = a0 - d0

  // Column 1
  let c10 = coeff[base + 1]
  let c14 = coeff[base + 5]
  let c18 = coeff[base + 9]
  let c1c = coeff[base + 13]
  coeff[base + 1] = 0
  coeff[base + 5] = 0
  coeff[base + 9] = 0
  coeff[base + 13] = 0
  let a1 = c10 + c18
  let b1 = c10 - c18
  let k1 = ((c14 * c2) >> 16) - ((c1c * c1) >> 16)
  let d1 = ((c14 * c1) >> 16) + ((c1c * c2) >> 16)
  let t10 = a1 + d1
  let t11 = b1 + k1
  let t12 = b1 - k1
  let t13 = a1 - d1

  // Column 2
  let c20 = coeff[base + 2]
  let c24 = coeff[base + 6]
  let c28 = coeff[base + 10]
  let c2c = coeff[base + 14]
  coeff[base + 2] = 0
  coeff[base + 6] = 0
  coeff[base + 10] = 0
  coeff[base + 14] = 0
  let a2 = c20 + c28
  let b2 = c20 - c28
  let k2 = ((c24 * c2) >> 16) - ((c2c * c1) >> 16)
  let d2 = ((c24 * c1) >> 16) + ((c2c * c2) >> 16)
  let t20 = a2 + d2
  let t21 = b2 + k2
  let t22 = b2 - k2
  let t23 = a2 - d2

  // Column 3
  let c30 = coeff[base + 3]
  let c34 = coeff[base + 7]
  let c38 = coeff[base + 11]
  let c3c = coeff[base + 15]
  coeff[base + 3] = 0
  coeff[base + 7] = 0
  coeff[base + 11] = 0
  coeff[base + 15] = 0
  let a3 = c30 + c38
  let b3 = c30 - c38
  let k3 = ((c34 * c2) >> 16) - ((c3c * c1) >> 16)
  let d3 = ((c34 * c1) >> 16) + ((c3c * c2) >> 16)
  let t30 = a3 + d3
  let t31 = b3 + k3
  let t32 = b3 - k3
  let t33 = a3 - d3

  // Row 0
  let dc0 = t00 + 4
  let ra0 = dc0 + t20
  let rb0 = dc0 - t20
  let rc0 = ((t10 * c2) >> 16) - ((t30 * c1) >> 16)
  let rd0 = ((t10 * c1) >> 16) + ((t30 * c2) >> 16)
  let dst0 = y * 32 + x
  let mut v = ybr[dst0] + ((ra0 + rd0) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst0] = v
  v = ybr[dst0 + 1] + ((rb0 + rc0) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst0 + 1] = v
  v = ybr[dst0 + 2] + ((rb0 - rc0) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst0 + 2] = v
  v = ybr[dst0 + 3] + ((ra0 - rd0) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst0 + 3] = v

  // Row 1
  let dc1 = t01 + 4
  let ra1 = dc1 + t21
  let rb1 = dc1 - t21
  let rc1 = ((t11 * c2) >> 16) - ((t31 * c1) >> 16)
  let rd1 = ((t11 * c1) >> 16) + ((t31 * c2) >> 16)
  let dst1 = dst0 + 32
  v = ybr[dst1] + ((ra1 + rd1) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst1] = v
  v = ybr[dst1 + 1] + ((rb1 + rc1) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst1 + 1] = v
  v = ybr[dst1 + 2] + ((rb1 - rc1) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst1 + 2] = v
  v = ybr[dst1 + 3] + ((ra1 - rd1) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst1 + 3] = v

  // Row 2
  let dc2 = t02 + 4
  let ra2 = dc2 + t22
  let rb2 = dc2 - t22
  let rc2 = ((t12 * c2) >> 16) - ((t32 * c1) >> 16)
  let rd2 = ((t12 * c1) >> 16) + ((t32 * c2) >> 16)
  let dst2 = dst0 + 64
  v = ybr[dst2] + ((ra2 + rd2) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst2] = v
  v = ybr[dst2 + 1] + ((rb2 + rc2) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst2 + 1] = v
  v = ybr[dst2 + 2] + ((rb2 - rc2) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst2 + 2] = v
  v = ybr[dst2 + 3] + ((ra2 - rd2) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst2 + 3] = v

  // Row 3
  let dc3 = t03 + 4
  let ra3 = dc3 + t23
  let rb3 = dc3 - t23
  let rc3 = ((t13 * c2) >> 16) - ((t33 * c1) >> 16)
  let rd3 = ((t13 * c1) >> 16) + ((t33 * c2) >> 16)
  let dst3 = dst0 + 96
  v = ybr[dst3] + ((ra3 + rd3) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst3] = v
  v = ybr[dst3 + 1] + ((rb3 + rc3) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst3 + 1] = v
  v = ybr[dst3 + 2] + ((rb3 - rc3) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst3 + 2] = v
  v = ybr[dst3 + 3] + ((ra3 - rd3) >> 3)
  if v < 0 { v = 0 } else if v > 255 { v = 255 }
  ybr[dst3 + 3] = v
}

///| Fast DC-only 4x4 Inverse DCT, clearing `coeff[base]`.
fn vp8_idct4_dc(ybr : FixedArray[Int], coeff : FixedArray[Int], y : Int, x : Int, base : Int) -> Unit {
  let dc = (coeff[base] + 4) >> 3
  coeff[base] = 0
  let mut j = 0
  while j < 4 {
    let dst = (y + j) * 32 + x
    let mut v0 = ybr[dst] + dc
    if v0 < 0 { v0 = 0 } else if v0 > 255 { v0 = 255 }
    ybr[dst] = v0
    let mut v1 = ybr[dst + 1] + dc
    if v1 < 0 { v1 = 0 } else if v1 > 255 { v1 = 255 }
    ybr[dst + 1] = v1
    let mut v2 = ybr[dst + 2] + dc
    if v2 < 0 { v2 = 0 } else if v2 > 255 { v2 = 255 }
    ybr[dst + 2] = v2
    let mut v3 = ybr[dst + 3] + dc
    if v3 < 0 { v3 = 0 } else if v3 > 255 { v3 = 255 }
    ybr[dst + 3] = v3
    j = j + 1
  }
}

///| 4x4 Inverse Walsh-Hadamard Transform (RFC 6386 §14.4) from `coeff[384..400]` into DC slots of `coeff[0..256]`,
///| clearing `coeff[384..400]`.
fn vp8_iwht16(coeff : FixedArray[Int], tmp : FixedArray[Int]) -> Unit {
  let mut i = 0
  while i < 4 {
    let a0 = coeff[384 + i] + coeff[396 + i]
    let a1 = coeff[388 + i] + coeff[392 + i]
    let a2 = coeff[388 + i] - coeff[392 + i]
    let a3 = coeff[384 + i] - coeff[396 + i]
    coeff[384 + i] = 0
    coeff[388 + i] = 0
    coeff[392 + i] = 0
    coeff[396 + i] = 0
    tmp[i] = a0 + a1
    tmp[8 + i] = a0 - a1
    tmp[4 + i] = a3 + a2
    tmp[12 + i] = a3 - a2
    i = i + 1
  }
  let mut out = 0
  i = 0
  while i < 4 {
    let row = i * 4
    let dc = tmp[row] + 3
    let a0 = dc + tmp[row + 3]
    let a1 = tmp[row + 1] + tmp[row + 2]
    let a2 = tmp[row + 1] - tmp[row + 2]
    let a3 = dc - tmp[row + 3]
    coeff[out] = (((a0 + a1) >> 3) << 16) >> 16
    coeff[out + 16] = (((a3 + a2) >> 3) << 16) >> 16
    coeff[out + 32] = (((a0 - a1) >> 3) << 16) >> 16
    coeff[out + 48] = (((a3 - a2) >> 3) << 16) >> 16
    out = out + 64
    i = i + 1
  }
}
