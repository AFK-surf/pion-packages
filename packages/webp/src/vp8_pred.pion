///| RFC 6386 VP8 Intra Prediction (16x16, 8x8, 4x4) and Inverse Transforms (WHT16 + IDCT4).
///| Workspace `ybr` is a flat 26 * 32 = 832-element `FixedArray[Int]` (row stride 32).

let vp8_pred_dc : Int = 0
let vp8_pred_tm : Int = 1
let vp8_pred_ve : Int = 2
let vp8_pred_he : Int = 3
let vp8_pred_rd : Int = 4
let vp8_pred_vr : Int = 5
let vp8_pred_ld : Int = 6
let vp8_pred_vl : Int = 7
let vp8_pred_hd : Int = 8
let vp8_pred_hu : Int = 9
let vp8_pred_dc_top : Int = 10
let vp8_pred_dc_left : Int = 11
let vp8_pred_dc_top_left : Int = 12

fn vp8_clip(x : Int, lo : Int, hi : Int) -> Int {
  if x < lo {
    lo
  } else if x > hi {
    hi
  } else {
    x
  }
}

fn vp8_clip8(x : Int) -> Int {
  if x < 0 {
    0
  } else if x > 255 {
    255
  } else {
    x
  }
}

fn vp8_check_top_left_pred(mbx : Int, mby : Int, p : Int) -> Int {
  if p != vp8_pred_dc {
    return p
  }
  if mbx == 0 {
    if mby == 0 {
      return vp8_pred_dc_top_left
    }
    return vp8_pred_dc_left
  }
  if mby == 0 {
    return vp8_pred_dc_top
  }
  vp8_pred_dc
}

///| 4x4 Intra prediction into `ybr` at `(y, x)` (row stride 32).
fn vp8_pred4(ybr : FixedArray[Int], mode : Int, y : Int, x : Int) -> Unit {
  let r0 = y * 32 + x
  let rm1 = (y - 1) * 32 + x
  if mode == vp8_pred_dc {
    let sum = 4 +
    ybr[rm1] + ybr[rm1 + 1] + ybr[rm1 + 2] + ybr[rm1 + 3] +
    ybr[r0 - 1] + ybr[r0 + 31] + ybr[r0 + 63] + ybr[r0 + 95]
    let avg = sum >> 3
    let mut j = 0
    while j < 4 {
      let row = r0 + j * 32
      ybr[row] = avg
      ybr[row + 1] = avg
      ybr[row + 2] = avg
      ybr[row + 3] = avg
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_tm {
    let d0 = -ybr[rm1 - 1]
    let t0 = ybr[rm1]
    let t1 = ybr[rm1 + 1]
    let t2 = ybr[rm1 + 2]
    let t3 = ybr[rm1 + 3]
    let mut j = 0
    while j < 4 {
      let row = r0 + j * 32
      let d1 = d0 + ybr[row - 1]
      let mut v0 = d1 + t0
      if v0 < 0 { v0 = 0 } else if v0 > 255 { v0 = 255 }
      ybr[row] = v0
      let mut v1 = d1 + t1
      if v1 < 0 { v1 = 0 } else if v1 > 255 { v1 = 255 }
      ybr[row + 1] = v1
      let mut v2 = d1 + t2
      if v2 < 0 { v2 = 0 } else if v2 > 255 { v2 = 255 }
      ybr[row + 2] = v2
      let mut v3 = d1 + t3
      if v3 < 0 { v3 = 0 } else if v3 > 255 { v3 = 255 }
      ybr[row + 3] = v3
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_ve {
    let a = ybr[rm1 - 1]
    let b = ybr[rm1]
    let c = ybr[rm1 + 1]
    let d = ybr[rm1 + 2]
    let e = ybr[rm1 + 3]
    let f = ybr[rm1 + 4]
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    let cde = (c + 2 * d + e + 2) >> 2
    let def = (d + 2 * e + f + 2) >> 2
    let mut j = 0
    while j < 4 {
      let row = r0 + j * 32
      ybr[row] = abc
      ybr[row + 1] = bcd
      ybr[row + 2] = cde
      ybr[row + 3] = def
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_he {
    let a = ybr[rm1 - 1]
    let p = ybr[r0 - 1]
    let q = ybr[r0 + 31]
    let r = ybr[r0 + 63]
    let s = ybr[r0 + 95]
    let apq = (a + 2 * p + q + 2) >> 2
    let rqp = (r + 2 * q + p + 2) >> 2
    let srq = (s + 2 * r + q + 2) >> 2
    let ssr = (s + 2 * s + r + 2) >> 2
    let mut i = 0
    while i < 4 {
      ybr[r0 + i] = apq
      ybr[r0 + 32 + i] = rqp
      ybr[r0 + 64 + i] = srq
      ybr[r0 + 96 + i] = ssr
      i = i + 1
    }
    return
  }
  if mode == vp8_pred_rd {
    let s = ybr[r0 + 95]
    let r = ybr[r0 + 63]
    let q = ybr[r0 + 31]
    let p = ybr[r0 - 1]
    let a = ybr[rm1 - 1]
    let b = ybr[rm1]
    let c = ybr[rm1 + 1]
    let d = ybr[rm1 + 2]
    let e = ybr[rm1 + 3]
    let srq = (s + 2 * r + q + 2) >> 2
    let rqp = (r + 2 * q + p + 2) >> 2
    let qpa = (q + 2 * p + a + 2) >> 2
    let pab = (p + 2 * a + b + 2) >> 2
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    let cde = (c + 2 * d + e + 2) >> 2
    ybr[r0] = pab
    ybr[r0 + 1] = abc
    ybr[r0 + 2] = bcd
    ybr[r0 + 3] = cde
    ybr[r0 + 32] = qpa
    ybr[r0 + 33] = pab
    ybr[r0 + 34] = abc
    ybr[r0 + 35] = bcd
    ybr[r0 + 64] = rqp
    ybr[r0 + 65] = qpa
    ybr[r0 + 66] = pab
    ybr[r0 + 67] = abc
    ybr[r0 + 96] = srq
    ybr[r0 + 97] = rqp
    ybr[r0 + 98] = qpa
    ybr[r0 + 99] = pab
    return
  }
  if mode == vp8_pred_vr {
    let r = ybr[r0 + 63]
    let q = ybr[r0 + 31]
    let p = ybr[r0 - 1]
    let a = ybr[rm1 - 1]
    let b = ybr[rm1]
    let c = ybr[rm1 + 1]
    let d = ybr[rm1 + 2]
    let e = ybr[rm1 + 3]
    let ab = (a + b + 1) >> 1
    let bc = (b + c + 1) >> 1
    let cd = (c + d + 1) >> 1
    let de = (d + e + 1) >> 1
    let rqp = (r + 2 * q + p + 2) >> 2
    let qpa = (q + 2 * p + a + 2) >> 2
    let pab = (p + 2 * a + b + 2) >> 2
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    let cde = (c + 2 * d + e + 2) >> 2
    ybr[r0] = ab
    ybr[r0 + 1] = bc
    ybr[r0 + 2] = cd
    ybr[r0 + 3] = de
    ybr[r0 + 32] = pab
    ybr[r0 + 33] = abc
    ybr[r0 + 34] = bcd
    ybr[r0 + 35] = cde
    ybr[r0 + 64] = qpa
    ybr[r0 + 65] = ab
    ybr[r0 + 66] = bc
    ybr[r0 + 67] = cd
    ybr[r0 + 96] = rqp
    ybr[r0 + 97] = pab
    ybr[r0 + 98] = abc
    ybr[r0 + 99] = bcd
    return
  }
  if mode == vp8_pred_ld {
    let a = ybr[rm1]
    let b = ybr[rm1 + 1]
    let c = ybr[rm1 + 2]
    let d = ybr[rm1 + 3]
    let e = ybr[rm1 + 4]
    let f = ybr[rm1 + 5]
    let g = ybr[rm1 + 6]
    let h = ybr[rm1 + 7]
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    let cde = (c + 2 * d + e + 2) >> 2
    let def = (d + 2 * e + f + 2) >> 2
    let efg = (e + 2 * f + g + 2) >> 2
    let fgh = (f + 2 * g + h + 2) >> 2
    let ghh = (g + 2 * h + h + 2) >> 2
    ybr[r0] = abc
    ybr[r0 + 1] = bcd
    ybr[r0 + 2] = cde
    ybr[r0 + 3] = def
    ybr[r0 + 32] = bcd
    ybr[r0 + 33] = cde
    ybr[r0 + 34] = def
    ybr[r0 + 35] = efg
    ybr[r0 + 64] = cde
    ybr[r0 + 65] = def
    ybr[r0 + 66] = efg
    ybr[r0 + 67] = fgh
    ybr[r0 + 96] = def
    ybr[r0 + 97] = efg
    ybr[r0 + 98] = fgh
    ybr[r0 + 99] = ghh
    return
  }
  if mode == vp8_pred_vl {
    let a = ybr[rm1]
    let b = ybr[rm1 + 1]
    let c = ybr[rm1 + 2]
    let d = ybr[rm1 + 3]
    let e = ybr[rm1 + 4]
    let f = ybr[rm1 + 5]
    let g = ybr[rm1 + 6]
    let h = ybr[rm1 + 7]
    let ab = (a + b + 1) >> 1
    let bc = (b + c + 1) >> 1
    let cd = (c + d + 1) >> 1
    let de = (d + e + 1) >> 1
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    let cde = (c + 2 * d + e + 2) >> 2
    let def = (d + 2 * e + f + 2) >> 2
    let efg = (e + 2 * f + g + 2) >> 2
    let fgh = (f + 2 * g + h + 2) >> 2
    ybr[r0] = ab
    ybr[r0 + 1] = bc
    ybr[r0 + 2] = cd
    ybr[r0 + 3] = de
    ybr[r0 + 32] = abc
    ybr[r0 + 33] = bcd
    ybr[r0 + 34] = cde
    ybr[r0 + 35] = def
    ybr[r0 + 64] = bc
    ybr[r0 + 65] = cd
    ybr[r0 + 66] = de
    ybr[r0 + 67] = efg
    ybr[r0 + 96] = bcd
    ybr[r0 + 97] = cde
    ybr[r0 + 98] = def
    ybr[r0 + 99] = fgh
    return
  }
  if mode == vp8_pred_hd {
    let s = ybr[r0 + 95]
    let r = ybr[r0 + 63]
    let q = ybr[r0 + 31]
    let p = ybr[r0 - 1]
    let a = ybr[rm1 - 1]
    let b = ybr[rm1]
    let c = ybr[rm1 + 1]
    let d = ybr[rm1 + 2]
    let sr = (s + r + 1) >> 1
    let rq = (r + q + 1) >> 1
    let qp = (q + p + 1) >> 1
    let pa = (p + a + 1) >> 1
    let srq = (s + 2 * r + q + 2) >> 2
    let rqp = (r + 2 * q + p + 2) >> 2
    let qpa = (q + 2 * p + a + 2) >> 2
    let pab = (p + 2 * a + b + 2) >> 2
    let abc = (a + 2 * b + c + 2) >> 2
    let bcd = (b + 2 * c + d + 2) >> 2
    ybr[r0] = pa
    ybr[r0 + 1] = pab
    ybr[r0 + 2] = abc
    ybr[r0 + 3] = bcd
    ybr[r0 + 32] = qp
    ybr[r0 + 33] = qpa
    ybr[r0 + 34] = pa
    ybr[r0 + 35] = pab
    ybr[r0 + 64] = rq
    ybr[r0 + 65] = rqp
    ybr[r0 + 66] = qp
    ybr[r0 + 67] = qpa
    ybr[r0 + 96] = sr
    ybr[r0 + 97] = srq
    ybr[r0 + 98] = rq
    ybr[r0 + 99] = rqp
    return
  }
  // vp8_pred_hu
  let s = ybr[r0 + 95]
  let r = ybr[r0 + 63]
  let q = ybr[r0 + 31]
  let p = ybr[r0 - 1]
  let pq = (p + q + 1) >> 1
  let qr = (q + r + 1) >> 1
  let rs = (r + s + 1) >> 1
  let pqr = (p + 2 * q + r + 2) >> 2
  let qrs = (q + 2 * r + s + 2) >> 2
  let rss = (r + 2 * s + s + 2) >> 2
  ybr[r0] = pq
  ybr[r0 + 1] = pqr
  ybr[r0 + 2] = qr
  ybr[r0 + 3] = qrs
  ybr[r0 + 32] = qr
  ybr[r0 + 33] = qrs
  ybr[r0 + 34] = rs
  ybr[r0 + 35] = rss
  ybr[r0 + 64] = rs
  ybr[r0 + 65] = rss
  ybr[r0 + 66] = s
  ybr[r0 + 67] = s
  ybr[r0 + 96] = s
  ybr[r0 + 97] = s
  ybr[r0 + 98] = s
  ybr[r0 + 99] = s
}

///| 8x8 Chroma Intra prediction into `ybr` at `(y, x)`.
fn vp8_pred8(ybr : FixedArray[Int], mode : Int, y : Int, x : Int) -> Unit {
  let r0 = y * 32 + x
  let rm1 = (y - 1) * 32 + x
  if mode == vp8_pred_dc {
    let mut sum = 8
    let mut i = 0
    while i < 8 {
      sum = sum + ybr[rm1 + i] + ybr[r0 + i * 32 - 1]
      i = i + 1
    }
    let avg = sum >> 4
    let mut j = 0
    while j < 8 {
      let row = r0 + j * 32
      let mut k = 0
      while k < 8 {
        ybr[row + k] = avg
        k = k + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_tm {
    let d0 = -ybr[rm1 - 1]
    let mut j = 0
    while j < 8 {
      let row = r0 + j * 32
      let d1 = d0 + ybr[row - 1]
      let mut i = 0
      while i < 8 {
        ybr[row + i] = vp8_clip8(d1 + ybr[rm1 + i])
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_ve {
    let mut j = 0
    while j < 8 {
      let row = r0 + j * 32
      let mut i = 0
      while i < 8 {
        ybr[row + i] = ybr[rm1 + i]
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_he {
    let mut j = 0
    while j < 8 {
      let row = r0 + j * 32
      let v = ybr[row - 1]
      let mut i = 0
      while i < 8 {
        ybr[row + i] = v
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_dc_top {
    let mut sum = 4
    let mut j = 0
    while j < 8 {
      sum = sum + ybr[r0 + j * 32 - 1]
      j = j + 1
    }
    let avg = sum >> 3
    j = 0
    while j < 8 {
      let row = r0 + j * 32
      let mut i = 0
      while i < 8 {
        ybr[row + i] = avg
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_dc_left {
    let mut sum = 4
    let mut i = 0
    while i < 8 {
      sum = sum + ybr[rm1 + i]
      i = i + 1
    }
    let avg = sum >> 3
    let mut j = 0
    while j < 8 {
      let row = r0 + j * 32
      let mut k = 0
      while k < 8 {
        ybr[row + k] = avg
        k = k + 1
      }
      j = j + 1
    }
    return
  }
  // vp8_pred_dc_top_left
  let mut j = 0
  while j < 8 {
    let row = r0 + j * 32
    let mut i = 0
    while i < 8 {
      ybr[row + i] = 0x80
      i = i + 1
    }
    j = j + 1
  }
}

///| 16x16 Luma Intra prediction into `ybr` at `(y, x)`.
fn vp8_pred16(ybr : FixedArray[Int], mode : Int, y : Int, x : Int) -> Unit {
  let r0 = y * 32 + x
  let rm1 = (y - 1) * 32 + x
  if mode == vp8_pred_dc {
    let mut sum = 16
    let mut i = 0
    while i < 16 {
      sum = sum + ybr[rm1 + i] + ybr[r0 + i * 32 - 1]
      i = i + 1
    }
    let avg = sum >> 5
    let mut j = 0
    while j < 16 {
      let row = r0 + j * 32
      let mut k = 0
      while k < 16 {
        ybr[row + k] = avg
        k = k + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_tm {
    let d0 = -ybr[rm1 - 1]
    let mut j = 0
    while j < 16 {
      let row = r0 + j * 32
      let d1 = d0 + ybr[row - 1]
      let mut i = 0
      while i < 16 {
        ybr[row + i] = vp8_clip8(d1 + ybr[rm1 + i])
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_ve {
    let mut j = 0
    while j < 16 {
      let row = r0 + j * 32
      let mut i = 0
      while i < 16 {
        ybr[row + i] = ybr[rm1 + i]
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_he {
    let mut j = 0
    while j < 16 {
      let row = r0 + j * 32
      let v = ybr[row - 1]
      let mut i = 0
      while i < 16 {
        ybr[row + i] = v
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_dc_top {
    let mut sum = 8
    let mut j = 0
    while j < 16 {
      sum = sum + ybr[r0 + j * 32 - 1]
      j = j + 1
    }
    let avg = sum >> 4
    j = 0
    while j < 16 {
      let row = r0 + j * 32
      let mut i = 0
      while i < 16 {
        ybr[row + i] = avg
        i = i + 1
      }
      j = j + 1
    }
    return
  }
  if mode == vp8_pred_dc_left {
    let mut sum = 8
    let mut i = 0
    while i < 16 {
      sum = sum + ybr[rm1 + i]
      i = i + 1
    }
    let avg = sum >> 4
    let mut j = 0
    while j < 16 {
      let row = r0 + j * 32
      let mut k = 0
      while k < 16 {
        ybr[row + k] = avg
        k = k + 1
      }
      j = j + 1
    }
    return
  }
  // vp8_pred_dc_top_left
  let mut j = 0
  while j < 16 {
    let row = r0 + j * 32
    let mut i = 0
    while i < 16 {
      ybr[row + i] = 0x80
      i = i + 1
    }
    j = j + 1
  }
}

///| 4x4 Inverse DCT (RFC 6386 §14.3) added onto `ybr[y..y+4][x..x+4]`, clearing `coeff[base..base+16]`.
fn vp8_idct4(ybr : FixedArray[Int], coeff : FixedArray[Int], tmp : FixedArray[Int], y : Int, x : Int, base : Int) -> Unit {
  let c1 = 85627
  let c2 = 35468
  let mut i = 0
  while i < 4 {
    let cb = base + i
    let c0 = coeff[cb]
    let c4 = coeff[cb + 4]
    let c8 = coeff[cb + 8]
    let c12 = coeff[cb + 12]
    coeff[cb] = 0
    coeff[cb + 4] = 0
    coeff[cb + 8] = 0
    coeff[cb + 12] = 0
    let a = c0 + c8
    let b = c0 - c8
    let c = ((c4 * c2) >> 16) - ((c12 * c1) >> 16)
    let d = ((c4 * c1) >> 16) + ((c12 * c2) >> 16)
    let row = i * 4
    tmp[row] = a + d
    tmp[row + 1] = b + c
    tmp[row + 2] = b - c
    tmp[row + 3] = a - d
    i = i + 1
  }
  let mut j = 0
  while j < 4 {
    let m0 = tmp[j]
    let m1 = tmp[4 + j]
    let m2 = tmp[8 + j]
    let m3 = tmp[12 + j]
    let dc = m0 + 4
    let a = dc + m2
    let b = dc - m2
    let c = ((m1 * c2) >> 16) - ((m3 * c1) >> 16)
    let d = ((m1 * c1) >> 16) + ((m3 * c2) >> 16)
    let dst = (y + j) * 32 + x
    let mut v0 = ybr[dst] + ((a + d) >> 3)
    if v0 < 0 { v0 = 0 } else if v0 > 255 { v0 = 255 }
    ybr[dst] = v0
    let mut v1 = ybr[dst + 1] + ((b + c) >> 3)
    if v1 < 0 { v1 = 0 } else if v1 > 255 { v1 = 255 }
    ybr[dst + 1] = v1
    let mut v2 = ybr[dst + 2] + ((b - c) >> 3)
    if v2 < 0 { v2 = 0 } else if v2 > 255 { v2 = 255 }
    ybr[dst + 2] = v2
    let mut v3 = ybr[dst + 3] + ((a - d) >> 3)
    if v3 < 0 { v3 = 0 } else if v3 > 255 { v3 = 255 }
    ybr[dst + 3] = v3
    j = j + 1
  }
}

///| Fast DC-only 4x4 Inverse DCT, clearing `coeff[base]`.
fn vp8_idct4_dc(ybr : FixedArray[Int], coeff : FixedArray[Int], y : Int, x : Int, base : Int) -> Unit {
  let dc = (coeff[base] + 4) >> 3
  coeff[base] = 0
  let mut j = 0
  while j < 4 {
    let dst = (y + j) * 32 + x
    let mut v0 = ybr[dst] + dc
    if v0 < 0 { v0 = 0 } else if v0 > 255 { v0 = 255 }
    ybr[dst] = v0
    let mut v1 = ybr[dst + 1] + dc
    if v1 < 0 { v1 = 0 } else if v1 > 255 { v1 = 255 }
    ybr[dst + 1] = v1
    let mut v2 = ybr[dst + 2] + dc
    if v2 < 0 { v2 = 0 } else if v2 > 255 { v2 = 255 }
    ybr[dst + 2] = v2
    let mut v3 = ybr[dst + 3] + dc
    if v3 < 0 { v3 = 0 } else if v3 > 255 { v3 = 255 }
    ybr[dst + 3] = v3
    j = j + 1
  }
}

///| 4x4 Inverse Walsh-Hadamard Transform (RFC 6386 §14.4) from `coeff[384..400]` into DC slots of `coeff[0..256]`,
///| clearing `coeff[384..400]`.
fn vp8_iwht16(coeff : FixedArray[Int], tmp : FixedArray[Int]) -> Unit {
  let mut i = 0
  while i < 4 {
    let a0 = coeff[384 + i] + coeff[396 + i]
    let a1 = coeff[388 + i] + coeff[392 + i]
    let a2 = coeff[388 + i] - coeff[392 + i]
    let a3 = coeff[384 + i] - coeff[396 + i]
    coeff[384 + i] = 0
    coeff[388 + i] = 0
    coeff[392 + i] = 0
    coeff[396 + i] = 0
    tmp[i] = a0 + a1
    tmp[8 + i] = a0 - a1
    tmp[4 + i] = a3 + a2
    tmp[12 + i] = a3 - a2
    i = i + 1
  }
  let mut out = 0
  i = 0
  while i < 4 {
    let row = i * 4
    let dc = tmp[row] + 3
    let a0 = dc + tmp[row + 3]
    let a1 = tmp[row + 1] + tmp[row + 2]
    let a2 = tmp[row + 1] - tmp[row + 2]
    let a3 = dc - tmp[row + 3]
    coeff[out] = (a0 + a1) >> 3
    coeff[out + 16] = (a3 + a2) >> 3
    coeff[out + 32] = (a0 - a1) >> 3
    coeff[out + 48] = (a3 - a2) >> 3
    out = out + 64
    i = i + 1
  }
}
