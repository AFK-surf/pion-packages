///| RIFF/WEBP container parser, VP8X extended header, and ALPH chunk decoder + unfiltering.

fn read_u32_le(data : Bytes, pos : Int) -> Int {
  data[pos].to_int() |
  (data[pos + 1].to_int() << 8) |
  (data[pos + 2].to_int() << 16) |
  (data[pos + 3].to_int() << 24)
}

fn read_u24_le(data : Bytes, pos : Int) -> Int {
  data[pos].to_int() | (data[pos + 1].to_int() << 8) | (data[pos + 2].to_int() << 16)
}

fn match_fourcc(data : Bytes, pos : Int, a : Int, b : Int, c : Int, d : Int) -> Bool {
  data[pos].to_int() == a &&
  data[pos + 1].to_int() == b &&
  data[pos + 2].to_int() == c &&
  data[pos + 3].to_int() == d
}

///| Validate RIFF/WEBP 12-byte file header. Returns effective end byte offset.
fn parse_riff_webp_header(data : Bytes) -> Result[Int, WebpError] {
  let n = data.length()
  if n < 12 {
    return Err(WebpError::UnexpectedEof("RIFF/WEBP header requires at least 12 bytes"))
  }
  // "RIFF"
  if !match_fourcc(data, 0, 0x52, 0x49, 0x46, 0x46) {
    return Err(WebpError::InvalidContainer("missing RIFF magic"))
  }
  // "WEBP"
  if !match_fourcc(data, 8, 0x57, 0x45, 0x42, 0x50) {
    return Err(WebpError::InvalidContainer("missing WEBP form type"))
  }
  let riff_len_u = data[4].to_int().to_int64() |
  (data[5].to_int().to_int64() << 8) |
  (data[6].to_int().to_int64() << 16) |
  (data[7].to_int().to_int64() << 24)
  if riff_len_u < 4L {
    return Err(WebpError::InvalidContainer("RIFF chunk size too small"))
  }
  let declared_end = 8L + riff_len_u
  let limit_end = if declared_end < n.to_int64() { declared_end.to_int() } else { n }
  Ok(limit_end)
}

///| Apply in-place inverse alpha filter (0=None, 1=Horizontal, 2=Vertical, 3=Gradient).
fn unfilter_alpha(alpha_in : Bytes, width : Int, height : Int, filter : Int) -> Bytes {
  let mut alpha = alpha_in
  let total = width * height
  if total == 0 || width == 0 || filter == 0 {
    return alpha
  }
  if filter == 1 {
    // Horizontal (register-carried `prev`)
    let mut prev = alpha[0].to_int()
    let mut i = 1
    while i < width {
      prev = (alpha[i].to_int() + prev) & 0xFF
      alpha[i] = prev.to_byte()
      i = i + 1
    }
    let mut row = width
    while row < total {
      prev = (alpha[row].to_int() + alpha[row - width].to_int()) & 0xFF
      alpha[row] = prev.to_byte()
      let mut j = 1
      while j < width {
        prev = (alpha[row + j].to_int() + prev) & 0xFF
        alpha[row + j] = prev.to_byte()
        j = j + 1
      }
      row = row + width
    }
    return alpha
  }
  if filter == 2 {
    // Vertical
    let mut prev = alpha[0].to_int()
    let mut i = 1
    while i < width {
      prev = (alpha[i].to_int() + prev) & 0xFF
      alpha[i] = prev.to_byte()
      i = i + 1
    }
    let mut idx = width
    while idx < total {
      alpha[idx] = ((alpha[idx].to_int() + alpha[idx - width].to_int()) & 0xFF).to_byte()
      idx = idx + 1
    }
    return alpha
  }
  if filter == 3 {
    // Gradient (register-carried `a` and `c`, 2x fewer loads)
    let mut prev = alpha[0].to_int()
    let mut i = 1
    while i < width {
      prev = (alpha[i].to_int() + prev) & 0xFF
      alpha[i] = prev.to_byte()
      i = i + 1
    }
    let mut row = width
    while row < total {
      let mut c = alpha[row - width].to_int()
      let mut a = (alpha[row].to_int() + c) & 0xFF
      alpha[row] = a.to_byte()
      let mut j = 1
      while j < width {
        let b = alpha[row + j - width].to_int()
        let mut pred = a + b - c
        if pred < 0 {
          pred = 0
        } else if pred > 255 {
          pred = 255
        }
        a = (alpha[row + j].to_int() + pred) & 0xFF
        alpha[row + j] = a.to_byte()
        c = b
        j = j + 1
      }
      row = row + width
    }
  }
  alpha
}

///| Decode an ALPH chunk payload `data[start..end)` into a `width * height` alpha plane.
fn decode_alph_chunk(
  data : Bytes,
  start : Int,
  end : Int,
  width : Int,
  height : Int,
  limits : DecodeLimits,
) -> Result[Bytes, WebpError] {
  if end - start < 1 {
    return Err(WebpError::InvalidAlpha("ALPH chunk missing header byte"))
  }
  let hdr = data[start].to_int()
  let compression = hdr & 0x03
  let filter = (hdr >> 2) & 0x03
  let total = width * height
  let raw_alpha = if compression == 0 {
    if end - (start + 1) < total {
      return Err(WebpError::UnexpectedEof("ALPH raw payload truncated"))
    }
    let mut buf = Bytes::new(total)
    let mut i = 0
    while i < total {
      buf[i] = data[start + 1 + i]
      i = i + 1
    }
    buf
  } else if compression == 1 {
    if width > 16384 || height > 16384 {
      return Err(WebpError::InvalidAlpha("ALPH VP8L dimensions exceed 14-bit limit"))
    }
    match vp8l_decode_alpha_internal(data, start + 1, end, limits, width, height) {
      Ok(buf) => buf
      Err(e) => return Err(e)
    }
  } else {
    return Err(WebpError::InvalidAlpha("unsupported ALPH compression method"))
  }
  Ok(unfilter_alpha(raw_alpha, width, height, filter))
}
