///| Top-level RFC 9649 WebP decoder entry points:
///| `probe_header`, `decode`, `decode_with_limits`, `decode_vp8l`, `decode_vp8`.

///| Probe a RIFF/WEBP stream header without decoding pixel data.
pub fn probe_header(data : Bytes) -> Result[WebpHeader, WebpError] {
  let limit_end = match parse_riff_webp_header(data) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let mut pos = 12
  while pos + 8 <= limit_end {
    let chunk_len_u = data[pos + 4].to_int().to_int64() |
    (data[pos + 5].to_int().to_int64() << 8) |
    (data[pos + 6].to_int().to_int64() << 16) |
    (data[pos + 7].to_int().to_int64() << 24)
    if chunk_len_u < 0L {
      return Err(WebpError::InvalidContainer("negative chunk size"))
    }
    let payload_start = pos + 8
    let payload_end64 = payload_start.to_int64() + chunk_len_u
    if payload_end64 > limit_end.to_int64() {
      return Err(WebpError::UnexpectedEof("RIFF chunk truncated"))
    }
    let payload_end = payload_end64.to_int()

    // "VP8 "
    if match_fourcc(data, pos, 0x56, 0x50, 0x38, 0x20) {
      let (w, h, _) = match vp8_parse_frame_header(data, payload_start, payload_end) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      return Ok(
        WebpHeader::{
          format: WebpFormat::Lossy,
          width: w,
          height: h,
          has_alpha: false,
          has_icc: false,
          has_exif: false,
          has_xmp: false,
          has_animation: false,
        },
      )
    }

    // "VP8L"
    if match_fourcc(data, pos, 0x56, 0x50, 0x38, 0x4C) {
      let (w, h, has_alpha) = match vp8l_parse_header(data, payload_start, payload_end) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      return Ok(
        WebpHeader::{
          format: WebpFormat::Lossless,
          width: w,
          height: h,
          has_alpha: has_alpha,
          has_icc: false,
          has_exif: false,
          has_xmp: false,
          has_animation: false,
        },
      )
    }

    // "VP8X"
    if match_fourcc(data, pos, 0x56, 0x50, 0x38, 0x58) {
      if payload_end - payload_start != 10 {
        return Err(WebpError::InvalidHeader("VP8X chunk must be 10 bytes"))
      }
      let flags = data[payload_start].to_int()
      let w = read_u24_le(data, payload_start + 4) + 1
      let h = read_u24_le(data, payload_start + 7) + 1
      return Ok(
        WebpHeader::{
          format: WebpFormat::Extended,
          width: w,
          height: h,
          has_alpha: (flags & 0x10) != 0,
          has_icc: (flags & 0x20) != 0,
          has_exif: (flags & 0x08) != 0,
          has_xmp: (flags & 0x04) != 0,
          has_animation: (flags & 0x02) != 0,
        },
      )
    }

    let pad = if (chunk_len_u & 1L) != 0L { 1 } else { 0 }
    pos = payload_end + pad
  }
  Err(WebpError::InvalidContainer("no VP8/VP8L/VP8X chunk found"))
}

///| Decode a RIFF/WEBP stream into RGBA8888 using default `DecodeLimits`.
pub fn decode(data : Bytes) -> Result[WebpImage, WebpError] {
  decode_with_limits(data, DecodeLimits::default())
}

///| Decode a RIFF/WEBP stream into RGBA8888 with explicit `DecodeLimits`.
pub fn decode_with_limits(data : Bytes, limits : DecodeLimits) -> Result[WebpImage, WebpError] {
  let limit_end = match parse_riff_webp_header(data) {
    Ok(v) => v
    Err(e) => return Err(e)
  }

  let mut seen_vp8x = false
  let mut want_alpha = false
  let mut has_alpha_plane = false
  let mut alpha_plane = FixedArray::make(0, 0.to_byte())
  let mut vp8x_w = 0
  let mut vp8x_h = 0
  let mut vp8x_hdr = WebpHeader::{
    format: WebpFormat::Extended,
    width: 0,
    height: 0,
    has_alpha: false,
    has_icc: false,
    has_exif: false,
    has_xmp: false,
    has_animation: false,
  }

  let mut pos = 12
  while pos + 8 <= limit_end {
    let chunk_len_u = data[pos + 4].to_int().to_int64() |
    (data[pos + 5].to_int().to_int64() << 8) |
    (data[pos + 6].to_int().to_int64() << 16) |
    (data[pos + 7].to_int().to_int64() << 24)
    if chunk_len_u < 0L {
      return Err(WebpError::InvalidContainer("negative chunk size"))
    }
    let payload_start = pos + 8
    let payload_end64 = payload_start.to_int64() + chunk_len_u
    if payload_end64 > limit_end.to_int64() {
      return Err(WebpError::UnexpectedEof("RIFF chunk truncated"))
    }
    let payload_end = payload_end64.to_int()

    if match_fourcc(data, pos, 0x56, 0x50, 0x38, 0x58) {
      // "VP8X"
      if seen_vp8x {
        return Err(WebpError::InvalidHeader("duplicate VP8X chunk"))
      }
      if payload_end - payload_start != 10 {
        return Err(WebpError::InvalidHeader("VP8X chunk must be 10 bytes"))
      }
      let flags = data[payload_start].to_int()
      vp8x_w = read_u24_le(data, payload_start + 4) + 1
      vp8x_h = read_u24_le(data, payload_start + 7) + 1
      match check_dimensions(vp8x_w, vp8x_h, limits) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
      seen_vp8x = true
      want_alpha = (flags & 0x10) != 0
      vp8x_hdr = WebpHeader::{
        format: WebpFormat::Extended,
        width: vp8x_w,
        height: vp8x_h,
        has_alpha: want_alpha,
        has_icc: (flags & 0x20) != 0,
        has_exif: (flags & 0x08) != 0,
        has_xmp: (flags & 0x04) != 0,
        has_animation: (flags & 0x02) != 0,
      }
    } else if match_fourcc(data, pos, 0x41, 0x4C, 0x50, 0x48) {
      // "ALPH"
      if !want_alpha {
        return Err(WebpError::InvalidAlpha("unexpected ALPH chunk"))
      }
      want_alpha = false
      let ap = match decode_alph_chunk(data, payload_start, payload_end, vp8x_w, vp8x_h, limits) {
        Ok(b) => b
        Err(e) => return Err(e)
      }
      alpha_plane = ap
      has_alpha_plane = true
    } else if match_fourcc(data, pos, 0x56, 0x50, 0x38, 0x20) {
      // "VP8 "
      if seen_vp8x {
        let (hw, hh, _) = match vp8_parse_frame_header(data, payload_start, payload_end) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if hw != vp8x_w || hh != vp8x_h {
          return Err(WebpError::InvalidHeader("VP8 dimensions do not match VP8X canvas"))
        }
      }
      let (w, h, rgba) = match vp8_decode_internal(data, payload_start, payload_end, limits, alpha_plane, has_alpha_plane) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let hdr = if seen_vp8x {
        vp8x_hdr
      } else {
        WebpHeader::{
          format: WebpFormat::Lossy,
          width: w,
          height: h,
          has_alpha: false,
          has_icc: false,
          has_exif: false,
          has_xmp: false,
          has_animation: false,
        }
      }
      return Ok(
        WebpImage::{
          header: hdr,
          width: w,
          height: h,
          has_alpha: has_alpha_plane,
          rgba: rgba,
        },
      )
    } else if match_fourcc(data, pos, 0x56, 0x50, 0x38, 0x4C) {
      // "VP8L"
      if has_alpha_plane {
        return Err(WebpError::InvalidAlpha("ALPH chunk not allowed with VP8L"))
      }
      if seen_vp8x {
        let (hw, hh, _) = match vp8l_parse_header(data, payload_start, payload_end) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if hw != vp8x_w || hh != vp8x_h {
          return Err(WebpError::InvalidHeader("VP8L dimensions do not match VP8X canvas"))
        }
      }
      let (w, h, ha, rgba) = match vp8l_decode_internal(data, payload_start, payload_end, limits, true, 0, 0) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let hdr = if seen_vp8x {
        vp8x_hdr
      } else {
        WebpHeader::{
          format: WebpFormat::Lossless,
          width: w,
          height: h,
          has_alpha: ha,
          has_icc: false,
          has_exif: false,
          has_xmp: false,
          has_animation: false,
        }
      }
      return Ok(
        WebpImage::{
          header: hdr,
          width: w,
          height: h,
          has_alpha: ha || (seen_vp8x && vp8x_hdr.has_alpha),
          rgba: rgba,
        },
      )
    }

    let pad = if (chunk_len_u & 1L) != 0L { 1 } else { 0 }
    pos = payload_end + pad
  }
  Err(WebpError::InvalidContainer("no image bitstream chunk found in WEBP"))
}

///| Decode a raw VP8L lossless bitstream payload (without RIFF container) into RGBA8888.
pub fn decode_vp8l(data : Bytes, limits : DecodeLimits) -> Result[WebpImage, WebpError] {
  let (w, h, ha, rgba) = match vp8l_decode_internal(data, 0, data.length(), limits, true, 0, 0) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let hdr = WebpHeader::{
    format: WebpFormat::Lossless,
    width: w,
    height: h,
    has_alpha: ha,
    has_icc: false,
    has_exif: false,
    has_xmp: false,
    has_animation: false,
  }
  Ok(WebpImage::{ header: hdr, width: w, height: h, has_alpha: ha, rgba: rgba })
}

///| Decode a raw VP8 lossy keyframe bitstream payload (without RIFF container) into RGBA8888.
pub fn decode_vp8(data : Bytes, limits : DecodeLimits) -> Result[WebpImage, WebpError] {
  let (w, h, rgba) = match vp8_decode_internal(data, 0, data.length(), limits, FixedArray::make(0, 0.to_byte()), false) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let hdr = WebpHeader::{
    format: WebpFormat::Lossy,
    width: w,
    height: h,
    has_alpha: false,
    has_icc: false,
    has_exif: false,
    has_xmp: false,
    has_animation: false,
  }
  Ok(WebpImage::{ header: hdr, width: w, height: h, has_alpha: false, rgba: rgba })
}
