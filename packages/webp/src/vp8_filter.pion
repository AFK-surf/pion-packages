///| RFC 6386 VP8 Loop Filters (Simple §15.2 + Normal §15.3) and BT.601 YUV420 -> RGBA8888 conversion.
///| Operates on `FixedArray[Byte]` planes (zero Bytes COW checks) with unsigned range flatness checks
///| (`(a - b + limit).to_uint() <= (limit << 1).to_uint()`), single-branch 0..255 clamping,
///| and specialized H/V + MB/subblock filters.

fn vp8_clamp255_byte(x : Int) -> Byte {
  if (x & -256) == 0 {
    x.to_byte()
  } else if x < 0 {
    0.to_byte()
  } else {
    255.to_byte()
  }
}

///| Modify a 2-pixel band along an edge (simple filter).
fn vp8_filter2(pix : FixedArray[Byte], level : Int, start_idx : Int, i_step : Int, j_step : Int) -> Unit {
  let mut idx = start_idx
  let j2 = 2 * j_step
  let mut n = 16
  while n > 0 {
    let p1 = pix[idx - j2].to_int()
    let p0 = pix[idx - j_step].to_int()
    let q0 = pix[idx].to_int()
    let q1 = pix[idx + j_step].to_int()
    let td0 = p0 - q0
    let md0 = td0 >> 31
    let d0 = (td0 ^ md0) - md0
    let td1 = p1 - q1
    let md1 = td1 >> 31
    let d1 = (td1 ^ md1) - md1
    if (d0 << 1) + (d1 >> 1) <= level {
      let mut pq1 = td1
      if pq1 < -128 { pq1 = -128 } else if pq1 > 127 { pq1 = 127 }
      let a = 3 * (q0 - p0) + pq1
      let mut a1 = (a + 4) >> 3
      if a1 < -16 { a1 = -16 } else if a1 > 15 { a1 = 15 }
      let mut a2 = (a + 3) >> 3
      if a2 < -16 { a2 = -16 } else if a2 > 15 { a2 = 15 }
      let mut v0 = p0 + a2
      if (v0 & -256) != 0 { v0 = if v0 < 0 { 0 } else { 255 } }
      let mut v1 = q0 - a1
      if (v1 & -256) != 0 { v1 = if v1 < 0 { 0 } else { 255 } }
      pix[idx - j_step] = v0.to_byte()
      pix[idx] = v1.to_byte()
    }
    idx = idx + i_step
    n = n - 1
  }
}

///| Specialized vertical-edge (j_step=1, i_step=stride) macroblock normal filter (6-pixel).
fn vp8_filter_mb_h(
  pix : FixedArray[Byte],
  count : Int,
  level : Int,
  ilevel : Int,
  hlevel : Int,
  start_idx : Int,
  stride : Int,
) -> Unit {
  let ilevel2 = (ilevel << 1).to_uint()
  let hlevel2 = (hlevel << 1).to_uint()
  let mut idx = start_idx
  let mut n = count
  while n > 0 {
    let p1 = pix[idx - 2].to_int()
    let p0 = pix[idx - 1].to_int()
    let q0 = pix[idx].to_int()
    let q1 = pix[idx + 1].to_int()
    let td0 = p0 - q0
    let md0 = td0 >> 31
    let d0 = (td0 ^ md0) - md0
    let td1 = p1 - q1
    let md1 = td1 >> 31
    let d1 = (td1 ^ md1) - md1
    if (d0 << 1) + (d1 >> 1) <= level {
      let dp0_s = p1 - p0
      let dq0_s = q1 - q0
      if (dp0_s + ilevel).to_uint() <= ilevel2 && (dq0_s + ilevel).to_uint() <= ilevel2 {
        let p2 = pix[idx - 3].to_int()
        let q2 = pix[idx + 2].to_int()
        if (p2 - p1 + ilevel).to_uint() <= ilevel2 && (q2 - q1 + ilevel).to_uint() <= ilevel2 {
          let p3 = pix[idx - 4].to_int()
          let q3 = pix[idx + 3].to_int()
          if (p3 - p2 + ilevel).to_uint() <= ilevel2 && (q3 - q2 + ilevel).to_uint() <= ilevel2 {
            let mut pq1 = td1
            if pq1 < -128 { pq1 = -128 } else if pq1 > 127 { pq1 = 127 }
            if (dp0_s + hlevel).to_uint() > hlevel2 || (dq0_s + hlevel).to_uint() > hlevel2 {
              let a = 3 * (q0 - p0) + pq1
              let mut a1 = (a + 4) >> 3
              if a1 < -16 { a1 = -16 } else if a1 > 15 { a1 = 15 }
              let mut a2 = (a + 3) >> 3
              if a2 < -16 { a2 = -16 } else if a2 > 15 { a2 = 15 }
              let mut v0 = p0 + a2
              if (v0 & -256) != 0 { v0 = if v0 < 0 { 0 } else { 255 } }
              let mut v1 = q0 - a1
              if (v1 & -256) != 0 { v1 = if v1 < 0 { 0 } else { 255 } }
              pix[idx - 1] = v0.to_byte()
              pix[idx] = v1.to_byte()
            } else {
              let mut a = 3 * (q0 - p0) + pq1
              if a < -128 { a = -128 } else if a > 127 { a = 127 }
              let a1 = (27 * a + 63) >> 7
              let a2 = (18 * a + 63) >> 7
              let a3 = (9 * a + 63) >> 7
              let mut vp2 = p2 + a3
              if (vp2 & -256) != 0 { vp2 = if vp2 < 0 { 0 } else { 255 } }
              let mut vp1 = p1 + a2
              if (vp1 & -256) != 0 { vp1 = if vp1 < 0 { 0 } else { 255 } }
              let mut vp0 = p0 + a1
              if (vp0 & -256) != 0 { vp0 = if vp0 < 0 { 0 } else { 255 } }
              let mut vq0 = q0 - a1
              if (vq0 & -256) != 0 { vq0 = if vq0 < 0 { 0 } else { 255 } }
              let mut vq1 = q1 - a2
              if (vq1 & -256) != 0 { vq1 = if vq1 < 0 { 0 } else { 255 } }
              let mut vq2 = q2 - a3
              if (vq2 & -256) != 0 { vq2 = if vq2 < 0 { 0 } else { 255 } }
              pix[idx - 3] = vp2.to_byte()
              pix[idx - 2] = vp1.to_byte()
              pix[idx - 1] = vp0.to_byte()
              pix[idx] = vq0.to_byte()
              pix[idx + 1] = vq1.to_byte()
              pix[idx + 2] = vq2.to_byte()
            }
          }
        }
      }
    }
    idx = idx + stride
    n = n - 1
  }
}

///| Specialized vertical-edge (j_step=1, i_step=stride) subblock normal filter (4-pixel).
fn vp8_filter_sub_h(
  pix : FixedArray[Byte],
  count : Int,
  level : Int,
  ilevel : Int,
  hlevel : Int,
  start_idx : Int,
  stride : Int,
) -> Unit {
  let ilevel2 = (ilevel << 1).to_uint()
  let hlevel2 = (hlevel << 1).to_uint()
  let mut idx = start_idx
  let mut n = count
  while n > 0 {
    let p1 = pix[idx - 2].to_int()
    let p0 = pix[idx - 1].to_int()
    let q0 = pix[idx].to_int()
    let q1 = pix[idx + 1].to_int()
    let td0 = p0 - q0
    let md0 = td0 >> 31
    let d0 = (td0 ^ md0) - md0
    let td1 = p1 - q1
    let md1 = td1 >> 31
    let d1 = (td1 ^ md1) - md1
    if (d0 << 1) + (d1 >> 1) <= level {
      let dp0_s = p1 - p0
      let dq0_s = q1 - q0
      if (dp0_s + ilevel).to_uint() <= ilevel2 && (dq0_s + ilevel).to_uint() <= ilevel2 {
        let p2 = pix[idx - 3].to_int()
        let q2 = pix[idx + 2].to_int()
        if (p2 - p1 + ilevel).to_uint() <= ilevel2 && (q2 - q1 + ilevel).to_uint() <= ilevel2 {
          let p3 = pix[idx - 4].to_int()
          let q3 = pix[idx + 3].to_int()
          if (p3 - p2 + ilevel).to_uint() <= ilevel2 && (q3 - q2 + ilevel).to_uint() <= ilevel2 {
            if (dp0_s + hlevel).to_uint() > hlevel2 || (dq0_s + hlevel).to_uint() > hlevel2 {
              let mut pq1 = td1
              if pq1 < -128 { pq1 = -128 } else if pq1 > 127 { pq1 = 127 }
              let a = 3 * (q0 - p0) + pq1
              let mut a1 = (a + 4) >> 3
              if a1 < -16 { a1 = -16 } else if a1 > 15 { a1 = 15 }
              let mut a2 = (a + 3) >> 3
              if a2 < -16 { a2 = -16 } else if a2 > 15 { a2 = 15 }
              let mut v0 = p0 + a2
              if (v0 & -256) != 0 { v0 = if v0 < 0 { 0 } else { 255 } }
              let mut v1 = q0 - a1
              if (v1 & -256) != 0 { v1 = if v1 < 0 { 0 } else { 255 } }
              pix[idx - 1] = v0.to_byte()
              pix[idx] = v1.to_byte()
            } else {
              let a = 3 * (q0 - p0)
              let mut a1 = (a + 4) >> 3
              if a1 < -16 { a1 = -16 } else if a1 > 15 { a1 = 15 }
              let mut a2 = (a + 3) >> 3
              if a2 < -16 { a2 = -16 } else if a2 > 15 { a2 = 15 }
              let a3 = (a1 + 1) >> 1
              let mut vp1 = p1 + a3
              if (vp1 & -256) != 0 { vp1 = if vp1 < 0 { 0 } else { 255 } }
              let mut vp0 = p0 + a2
              if (vp0 & -256) != 0 { vp0 = if vp0 < 0 { 0 } else { 255 } }
              let mut vq0 = q0 - a1
              if (vq0 & -256) != 0 { vq0 = if vq0 < 0 { 0 } else { 255 } }
              let mut vq1 = q1 - a3
              if (vq1 & -256) != 0 { vq1 = if vq1 < 0 { 0 } else { 255 } }
              pix[idx - 2] = vp1.to_byte()
              pix[idx - 1] = vp0.to_byte()
              pix[idx] = vq0.to_byte()
              pix[idx + 1] = vq1.to_byte()
            }
          }
        }
      }
    }
    idx = idx + stride
    n = n - 1
  }
}

///| Specialized horizontal-edge (i_step=1, j_step=stride) macroblock normal filter (6-pixel).
fn vp8_filter_mb_v(
  pix : FixedArray[Byte],
  count : Int,
  level : Int,
  ilevel : Int,
  hlevel : Int,
  start_idx : Int,
  stride : Int,
) -> Unit {
  let ilevel2 = (ilevel << 1).to_uint()
  let hlevel2 = (hlevel << 1).to_uint()
  let mut idx = start_idx
  let j2 = 2 * stride
  let j3 = 3 * stride
  let j4 = 4 * stride
  let mut n = count
  while n > 0 {
    let p1 = pix[idx - j2].to_int()
    let p0 = pix[idx - stride].to_int()
    let q0 = pix[idx].to_int()
    let q1 = pix[idx + stride].to_int()
    let td0 = p0 - q0
    let md0 = td0 >> 31
    let d0 = (td0 ^ md0) - md0
    let td1 = p1 - q1
    let md1 = td1 >> 31
    let d1 = (td1 ^ md1) - md1
    if (d0 << 1) + (d1 >> 1) <= level {
      let dp0_s = p1 - p0
      let dq0_s = q1 - q0
      if (dp0_s + ilevel).to_uint() <= ilevel2 && (dq0_s + ilevel).to_uint() <= ilevel2 {
        let p2 = pix[idx - j3].to_int()
        let q2 = pix[idx + j2].to_int()
        if (p2 - p1 + ilevel).to_uint() <= ilevel2 && (q2 - q1 + ilevel).to_uint() <= ilevel2 {
          let p3 = pix[idx - j4].to_int()
          let q3 = pix[idx + j3].to_int()
          if (p3 - p2 + ilevel).to_uint() <= ilevel2 && (q3 - q2 + ilevel).to_uint() <= ilevel2 {
            let mut pq1 = td1
            if pq1 < -128 { pq1 = -128 } else if pq1 > 127 { pq1 = 127 }
            if (dp0_s + hlevel).to_uint() > hlevel2 || (dq0_s + hlevel).to_uint() > hlevel2 {
              let a = 3 * (q0 - p0) + pq1
              let mut a1 = (a + 4) >> 3
              if a1 < -16 { a1 = -16 } else if a1 > 15 { a1 = 15 }
              let mut a2 = (a + 3) >> 3
              if a2 < -16 { a2 = -16 } else if a2 > 15 { a2 = 15 }
              let mut v0 = p0 + a2
              if (v0 & -256) != 0 { v0 = if v0 < 0 { 0 } else { 255 } }
              let mut v1 = q0 - a1
              if (v1 & -256) != 0 { v1 = if v1 < 0 { 0 } else { 255 } }
              pix[idx - stride] = v0.to_byte()
              pix[idx] = v1.to_byte()
            } else {
              let mut a = 3 * (q0 - p0) + pq1
              if a < -128 { a = -128 } else if a > 127 { a = 127 }
              let a1 = (27 * a + 63) >> 7
              let a2 = (18 * a + 63) >> 7
              let a3 = (9 * a + 63) >> 7
              let mut vp2 = p2 + a3
              if (vp2 & -256) != 0 { vp2 = if vp2 < 0 { 0 } else { 255 } }
              let mut vp1 = p1 + a2
              if (vp1 & -256) != 0 { vp1 = if vp1 < 0 { 0 } else { 255 } }
              let mut vp0 = p0 + a1
              if (vp0 & -256) != 0 { vp0 = if vp0 < 0 { 0 } else { 255 } }
              let mut vq0 = q0 - a1
              if (vq0 & -256) != 0 { vq0 = if vq0 < 0 { 0 } else { 255 } }
              let mut vq1 = q1 - a2
              if (vq1 & -256) != 0 { vq1 = if vq1 < 0 { 0 } else { 255 } }
              let mut vq2 = q2 - a3
              if (vq2 & -256) != 0 { vq2 = if vq2 < 0 { 0 } else { 255 } }
              pix[idx - j3] = vp2.to_byte()
              pix[idx - j2] = vp1.to_byte()
              pix[idx - stride] = vp0.to_byte()
              pix[idx] = vq0.to_byte()
              pix[idx + stride] = vq1.to_byte()
              pix[idx + j2] = vq2.to_byte()
            }
          }
        }
      }
    }
    idx = idx + 1
    n = n - 1
  }
}

///| Specialized horizontal-edge (i_step=1, j_step=stride) subblock normal filter (4-pixel).
fn vp8_filter_sub_v(
  pix : FixedArray[Byte],
  count : Int,
  level : Int,
  ilevel : Int,
  hlevel : Int,
  start_idx : Int,
  stride : Int,
) -> Unit {
  let ilevel2 = (ilevel << 1).to_uint()
  let hlevel2 = (hlevel << 1).to_uint()
  let mut idx = start_idx
  let j2 = 2 * stride
  let j3 = 3 * stride
  let j4 = 4 * stride
  let mut n = count
  while n > 0 {
    let p1 = pix[idx - j2].to_int()
    let p0 = pix[idx - stride].to_int()
    let q0 = pix[idx].to_int()
    let q1 = pix[idx + stride].to_int()
    let td0 = p0 - q0
    let md0 = td0 >> 31
    let d0 = (td0 ^ md0) - md0
    let td1 = p1 - q1
    let md1 = td1 >> 31
    let d1 = (td1 ^ md1) - md1
    if (d0 << 1) + (d1 >> 1) <= level {
      let dp0_s = p1 - p0
      let dq0_s = q1 - q0
      if (dp0_s + ilevel).to_uint() <= ilevel2 && (dq0_s + ilevel).to_uint() <= ilevel2 {
        let p2 = pix[idx - j3].to_int()
        let q2 = pix[idx + j2].to_int()
        if (p2 - p1 + ilevel).to_uint() <= ilevel2 && (q2 - q1 + ilevel).to_uint() <= ilevel2 {
          let p3 = pix[idx - j4].to_int()
          let q3 = pix[idx + j3].to_int()
          if (p3 - p2 + ilevel).to_uint() <= ilevel2 && (q3 - q2 + ilevel).to_uint() <= ilevel2 {
            if (dp0_s + hlevel).to_uint() > hlevel2 || (dq0_s + hlevel).to_uint() > hlevel2 {
              let mut pq1 = td1
              if pq1 < -128 { pq1 = -128 } else if pq1 > 127 { pq1 = 127 }
              let a = 3 * (q0 - p0) + pq1
              let mut a1 = (a + 4) >> 3
              if a1 < -16 { a1 = -16 } else if a1 > 15 { a1 = 15 }
              let mut a2 = (a + 3) >> 3
              if a2 < -16 { a2 = -16 } else if a2 > 15 { a2 = 15 }
              let mut v0 = p0 + a2
              if (v0 & -256) != 0 { v0 = if v0 < 0 { 0 } else { 255 } }
              let mut v1 = q0 - a1
              if (v1 & -256) != 0 { v1 = if v1 < 0 { 0 } else { 255 } }
              pix[idx - stride] = v0.to_byte()
              pix[idx] = v1.to_byte()
            } else {
              let a = 3 * (q0 - p0)
              let mut a1 = (a + 4) >> 3
              if a1 < -16 { a1 = -16 } else if a1 > 15 { a1 = 15 }
              let mut a2 = (a + 3) >> 3
              if a2 < -16 { a2 = -16 } else if a2 > 15 { a2 = 15 }
              let a3 = (a1 + 1) >> 1
              let mut vp1 = p1 + a3
              if (vp1 & -256) != 0 { vp1 = if vp1 < 0 { 0 } else { 255 } }
              let mut vp0 = p0 + a2
              if (vp0 & -256) != 0 { vp0 = if vp0 < 0 { 0 } else { 255 } }
              let mut vq0 = q0 - a1
              if (vq0 & -256) != 0 { vq0 = if vq0 < 0 { 0 } else { 255 } }
              let mut vq1 = q1 - a3
              if (vq1 & -256) != 0 { vq1 = if vq1 < 0 { 0 } else { 255 } }
              pix[idx - j2] = vp1.to_byte()
              pix[idx - stride] = vp0.to_byte()
              pix[idx] = vq0.to_byte()
              pix[idx + stride] = vq1.to_byte()
            }
          }
        }
      }
    }
    idx = idx + 1
    n = n - 1
  }
}

///| Opaque YUV420 -> RGBA8888 (single-branch 0..255 clamp, 2x2 chroma sharing).
fn vp8_yuv420_to_rgba_opaque(
  y_plane : FixedArray[Byte],
  cb_plane : FixedArray[Byte],
  cr_plane : FixedArray[Byte],
  y_stride : Int,
  c_stride : Int,
  width : Int,
  height : Int,
) -> Bytes {
  let mut out = Bytes::new(width * height * 4)
  let even_w = width & -2
  let even_h = height & -2
  let row_bytes = width * 4
  let opaque = 255.to_byte()
  let mut y = 0
  while y < even_h {
    let y_row0 = y * y_stride
    let y_row1 = y_row0 + y_stride
    let c_row = (y >> 1) * c_stride
    let mut dst0 = y * row_bytes
    let mut dst1 = dst0 + row_bytes
    let mut x = 0
    while x < even_w {
      let cx = x >> 1
      let cb1 = cb_plane[c_row + cx].to_int() - 128
      let cr1 = cr_plane[c_row + cx].to_int() - 128
      let r_off = 91881 * cr1
      let g_off = -22554 * cb1 - 46802 * cr1
      let b_off = 116130 * cb1

      let yy00 = y_plane[y_row0 + x].to_int() * 65793
      let mut r00 = (yy00 + r_off) >> 16
      if (r00 & -256) != 0 { r00 = if r00 < 0 { 0 } else { 255 } }
      let mut g00 = (yy00 + g_off) >> 16
      if (g00 & -256) != 0 { g00 = if g00 < 0 { 0 } else { 255 } }
      let mut b00 = (yy00 + b_off) >> 16
      if (b00 & -256) != 0 { b00 = if b00 < 0 { 0 } else { 255 } }
      out[dst0] = r00.to_byte()
      out[dst0 + 1] = g00.to_byte()
      out[dst0 + 2] = b00.to_byte()
      out[dst0 + 3] = opaque

      let yy01 = y_plane[y_row0 + x + 1].to_int() * 65793
      let mut r01 = (yy01 + r_off) >> 16
      if (r01 & -256) != 0 { r01 = if r01 < 0 { 0 } else { 255 } }
      let mut g01 = (yy01 + g_off) >> 16
      if (g01 & -256) != 0 { g01 = if g01 < 0 { 0 } else { 255 } }
      let mut b01 = (yy01 + b_off) >> 16
      if (b01 & -256) != 0 { b01 = if b01 < 0 { 0 } else { 255 } }
      out[dst0 + 4] = r01.to_byte()
      out[dst0 + 5] = g01.to_byte()
      out[dst0 + 6] = b01.to_byte()
      out[dst0 + 7] = opaque

      let yy10 = y_plane[y_row1 + x].to_int() * 65793
      let mut r10 = (yy10 + r_off) >> 16
      if (r10 & -256) != 0 { r10 = if r10 < 0 { 0 } else { 255 } }
      let mut g10 = (yy10 + g_off) >> 16
      if (g10 & -256) != 0 { g10 = if g10 < 0 { 0 } else { 255 } }
      let mut b10 = (yy10 + b_off) >> 16
      if (b10 & -256) != 0 { b10 = if b10 < 0 { 0 } else { 255 } }
      out[dst1] = r10.to_byte()
      out[dst1 + 1] = g10.to_byte()
      out[dst1 + 2] = b10.to_byte()
      out[dst1 + 3] = opaque

      let yy11 = y_plane[y_row1 + x + 1].to_int() * 65793
      let mut r11 = (yy11 + r_off) >> 16
      if (r11 & -256) != 0 { r11 = if r11 < 0 { 0 } else { 255 } }
      let mut g11 = (yy11 + g_off) >> 16
      if (g11 & -256) != 0 { g11 = if g11 < 0 { 0 } else { 255 } }
      let mut b11 = (yy11 + b_off) >> 16
      if (b11 & -256) != 0 { b11 = if b11 < 0 { 0 } else { 255 } }
      out[dst1 + 4] = r11.to_byte()
      out[dst1 + 5] = g11.to_byte()
      out[dst1 + 6] = b11.to_byte()
      out[dst1 + 7] = opaque

      dst0 = dst0 + 8
      dst1 = dst1 + 8
      x = x + 2
    }
    if x < width {
      let cx = x >> 1
      let cb1 = cb_plane[c_row + cx].to_int() - 128
      let cr1 = cr_plane[c_row + cx].to_int() - 128
      let r_off = 91881 * cr1
      let g_off = -22554 * cb1 - 46802 * cr1
      let b_off = 116130 * cb1

      let yy0 = y_plane[y_row0 + x].to_int() * 65793
      out[dst0] = vp8_clamp255_byte((yy0 + r_off) >> 16)
      out[dst0 + 1] = vp8_clamp255_byte((yy0 + g_off) >> 16)
      out[dst0 + 2] = vp8_clamp255_byte((yy0 + b_off) >> 16)
      out[dst0 + 3] = opaque

      let yy1 = y_plane[y_row1 + x].to_int() * 65793
      out[dst1] = vp8_clamp255_byte((yy1 + r_off) >> 16)
      out[dst1 + 1] = vp8_clamp255_byte((yy1 + g_off) >> 16)
      out[dst1 + 2] = vp8_clamp255_byte((yy1 + b_off) >> 16)
      out[dst1 + 3] = opaque
    }
    y = y + 2
  }
  if y < height {
    let y_row = y * y_stride
    let c_row = (y >> 1) * c_stride
    let mut dst = y * row_bytes
    let mut x = 0
    while x < width {
      let cx = x >> 1
      let cb1 = cb_plane[c_row + cx].to_int() - 128
      let cr1 = cr_plane[c_row + cx].to_int() - 128
      let yy = y_plane[y_row + x].to_int() * 65793
      out[dst] = vp8_clamp255_byte((yy + 91881 * cr1) >> 16)
      out[dst + 1] = vp8_clamp255_byte((yy - 22554 * cb1 - 46802 * cr1) >> 16)
      out[dst + 2] = vp8_clamp255_byte((yy + 116130 * cb1) >> 16)
      out[dst + 3] = opaque
      dst = dst + 4
      x = x + 1
    }
  }
  out
}

///| Alpha-composited YUV420 -> RGBA8888 (single-branch 0..255 clamp, 2x2 chroma sharing).
fn vp8_yuv420_to_rgba_alpha(
  y_plane : FixedArray[Byte],
  cb_plane : FixedArray[Byte],
  cr_plane : FixedArray[Byte],
  y_stride : Int,
  c_stride : Int,
  width : Int,
  height : Int,
  alpha : FixedArray[Byte],
) -> Bytes {
  let mut out = Bytes::new(width * height * 4)
  let even_w = width & -2
  let even_h = height & -2
  let row_bytes = width * 4
  let mut y = 0
  while y < even_h {
    let y_row0 = y * y_stride
    let y_row1 = y_row0 + y_stride
    let c_row = (y >> 1) * c_stride
    let mut dst0 = y * row_bytes
    let mut dst1 = dst0 + row_bytes
    let mut a0 = y * width
    let mut a1 = a0 + width
    let mut x = 0
    while x < even_w {
      let cx = x >> 1
      let cb1 = cb_plane[c_row + cx].to_int() - 128
      let cr1 = cr_plane[c_row + cx].to_int() - 128
      let r_off = 91881 * cr1
      let g_off = -22554 * cb1 - 46802 * cr1
      let b_off = 116130 * cb1

      let yy00 = y_plane[y_row0 + x].to_int() * 65793
      let mut r00 = (yy00 + r_off) >> 16
      if (r00 & -256) != 0 { r00 = if r00 < 0 { 0 } else { 255 } }
      let mut g00 = (yy00 + g_off) >> 16
      if (g00 & -256) != 0 { g00 = if g00 < 0 { 0 } else { 255 } }
      let mut b00 = (yy00 + b_off) >> 16
      if (b00 & -256) != 0 { b00 = if b00 < 0 { 0 } else { 255 } }
      out[dst0] = r00.to_byte()
      out[dst0 + 1] = g00.to_byte()
      out[dst0 + 2] = b00.to_byte()
      out[dst0 + 3] = alpha[a0]

      let yy01 = y_plane[y_row0 + x + 1].to_int() * 65793
      let mut r01 = (yy01 + r_off) >> 16
      if (r01 & -256) != 0 { r01 = if r01 < 0 { 0 } else { 255 } }
      let mut g01 = (yy01 + g_off) >> 16
      if (g01 & -256) != 0 { g01 = if g01 < 0 { 0 } else { 255 } }
      let mut b01 = (yy01 + b_off) >> 16
      if (b01 & -256) != 0 { b01 = if b01 < 0 { 0 } else { 255 } }
      out[dst0 + 4] = r01.to_byte()
      out[dst0 + 5] = g01.to_byte()
      out[dst0 + 6] = b01.to_byte()
      out[dst0 + 7] = alpha[a0 + 1]

      let yy10 = y_plane[y_row1 + x].to_int() * 65793
      let mut r10 = (yy10 + r_off) >> 16
      if (r10 & -256) != 0 { r10 = if r10 < 0 { 0 } else { 255 } }
      let mut g10 = (yy10 + g_off) >> 16
      if (g10 & -256) != 0 { g10 = if g10 < 0 { 0 } else { 255 } }
      let mut b10 = (yy10 + b_off) >> 16
      if (b10 & -256) != 0 { b10 = if b10 < 0 { 0 } else { 255 } }
      out[dst1] = r10.to_byte()
      out[dst1 + 1] = g10.to_byte()
      out[dst1 + 2] = b10.to_byte()
      out[dst1 + 3] = alpha[a1]

      let yy11 = y_plane[y_row1 + x + 1].to_int() * 65793
      let mut r11 = (yy11 + r_off) >> 16
      if (r11 & -256) != 0 { r11 = if r11 < 0 { 0 } else { 255 } }
      let mut g11 = (yy11 + g_off) >> 16
      if (g11 & -256) != 0 { g11 = if g11 < 0 { 0 } else { 255 } }
      let mut b11 = (yy11 + b_off) >> 16
      if (b11 & -256) != 0 { b11 = if b11 < 0 { 0 } else { 255 } }
      out[dst1 + 4] = r11.to_byte()
      out[dst1 + 5] = g11.to_byte()
      out[dst1 + 6] = b11.to_byte()
      out[dst1 + 7] = alpha[a1 + 1]

      dst0 = dst0 + 8
      dst1 = dst1 + 8
      a0 = a0 + 2
      a1 = a1 + 2
      x = x + 2
    }
    if x < width {
      let cx = x >> 1
      let cb1 = cb_plane[c_row + cx].to_int() - 128
      let cr1 = cr_plane[c_row + cx].to_int() - 128
      let r_off = 91881 * cr1
      let g_off = -22554 * cb1 - 46802 * cr1
      let b_off = 116130 * cb1

      let yy0 = y_plane[y_row0 + x].to_int() * 65793
      out[dst0] = vp8_clamp255_byte((yy0 + r_off) >> 16)
      out[dst0 + 1] = vp8_clamp255_byte((yy0 + g_off) >> 16)
      out[dst0 + 2] = vp8_clamp255_byte((yy0 + b_off) >> 16)
      out[dst0 + 3] = alpha[a0]

      let yy1 = y_plane[y_row1 + x].to_int() * 65793
      out[dst1] = vp8_clamp255_byte((yy1 + r_off) >> 16)
      out[dst1 + 1] = vp8_clamp255_byte((yy1 + g_off) >> 16)
      out[dst1 + 2] = vp8_clamp255_byte((yy1 + b_off) >> 16)
      out[dst1 + 3] = alpha[a1]
    }
    y = y + 2
  }
  if y < height {
    let y_row = y * y_stride
    let c_row = (y >> 1) * c_stride
    let mut dst = y * row_bytes
    let mut a_idx = y * width
    let mut x = 0
    while x < width {
      let cx = x >> 1
      let cb1 = cb_plane[c_row + cx].to_int() - 128
      let cr1 = cr_plane[c_row + cx].to_int() - 128
      let yy = y_plane[y_row + x].to_int() * 65793
      out[dst] = vp8_clamp255_byte((yy + 91881 * cr1) >> 16)
      out[dst + 1] = vp8_clamp255_byte((yy - 22554 * cb1 - 46802 * cr1) >> 16)
      out[dst + 2] = vp8_clamp255_byte((yy + 116130 * cb1) >> 16)
      out[dst + 3] = alpha[a_idx]
      dst = dst + 4
      a_idx = a_idx + 1
      x = x + 1
    }
  }
  out
}

///| Convert YUV420 planes + optional alpha plane to tightly packed RGBA8888.
fn vp8_yuv420_to_rgba(
  y_plane : FixedArray[Byte],
  cb_plane : FixedArray[Byte],
  cr_plane : FixedArray[Byte],
  y_stride : Int,
  c_stride : Int,
  width : Int,
  height : Int,
  alpha : FixedArray[Byte],
  has_alpha : Bool,
) -> Bytes {
  if has_alpha && alpha.length() >= width * height {
    vp8_yuv420_to_rgba_alpha(y_plane, cb_plane, cr_plane, y_stride, c_stride, width, height, alpha)
  } else {
    vp8_yuv420_to_rgba_opaque(y_plane, cb_plane, cr_plane, y_stride, c_stride, width, height)
  }
}
