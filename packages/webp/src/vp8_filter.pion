///| RFC 6386 VP8 Loop Filters (Simple §15.2 + Normal §15.3) and BT.601 YUV420 -> RGBA8888 conversion.

fn vp8_abs(x : Int) -> Int {
  if x < 0 { -x } else { x }
}

fn vp8_clamp15(x : Int) -> Int {
  if x < -16 {
    -16
  } else if x > 15 {
    15
  } else {
    x
  }
}

fn vp8_clamp127(x : Int) -> Int {
  if x < -128 {
    -128
  } else if x > 127 {
    127
  } else {
    x
  }
}

fn vp8_clamp255_byte(x : Int) -> Byte {
  if x < 0 {
    0.to_byte()
  } else if x > 255 {
    255.to_byte()
  } else {
    x.to_byte()
  }
}

///| Modify a 2-pixel band along an edge (simple filter).
fn vp8_filter2(pix_in : Bytes, level : Int, start_idx : Int, i_step : Int, j_step : Int) -> Unit {
  let mut pix = pix_in
  let mut idx = start_idx
  let j2 = 2 * j_step
  let mut n = 16
  while n > 0 {
    let p1 = pix[idx - j2].to_int()
    let p0 = pix[idx - j_step].to_int()
    let q0 = pix[idx].to_int()
    let q1 = pix[idx + j_step].to_int()
    if (vp8_abs(p0 - q0) << 1) + (vp8_abs(p1 - q1) >> 1) <= level {
      let a = 3 * (q0 - p0) + vp8_clamp127(p1 - q1)
      let a1 = vp8_clamp15((a + 4) >> 3)
      let a2 = vp8_clamp15((a + 3) >> 3)
      pix[idx - j_step] = vp8_clamp255_byte(p0 + a2)
      pix[idx] = vp8_clamp255_byte(q0 - a1)
    }
    idx = idx + i_step
    n = n - 1
  }
}

///| Modify a 2-, 4-, or 6-pixel band along an edge (normal filter).
fn vp8_filter246(
  pix_in : Bytes,
  count : Int,
  level : Int,
  ilevel : Int,
  hlevel : Int,
  start_idx : Int,
  i_step : Int,
  j_step : Int,
  four_not_six : Bool,
) -> Unit {
  let mut pix = pix_in
  let mut idx = start_idx
  let j2 = 2 * j_step
  let j3 = 3 * j_step
  let j4 = 4 * j_step
  let mut n = count
  while n > 0 {
    let p1 = pix[idx - j2].to_int()
    let p0 = pix[idx - j_step].to_int()
    let q0 = pix[idx].to_int()
    let q1 = pix[idx + j_step].to_int()
    let d0 = if p0 >= q0 { p0 - q0 } else { q0 - p0 }
    let d1 = if p1 >= q1 { p1 - q1 } else { q1 - p1 }
    if (d0 << 1) + (d1 >> 1) <= level {
      let dp0 = if p1 >= p0 { p1 - p0 } else { p0 - p1 }
      let dq0 = if q1 >= q0 { q1 - q0 } else { q0 - q1 }
      if dp0 <= ilevel && dq0 <= ilevel {
        let p2 = pix[idx - j3].to_int()
        let q2 = pix[idx + j2].to_int()
        let dp1 = if p2 >= p1 { p2 - p1 } else { p1 - p2 }
        let dq1 = if q2 >= q1 { q2 - q1 } else { q1 - q2 }
        if dp1 <= ilevel && dq1 <= ilevel {
          let p3 = pix[idx - j4].to_int()
          let q3 = pix[idx + j3].to_int()
          let dp2 = if p3 >= p2 { p3 - p2 } else { p2 - p3 }
          let dq2 = if q3 >= q2 { q3 - q2 } else { q2 - q3 }
          if dp2 <= ilevel && dq2 <= ilevel {
            if dp0 > hlevel || dq0 > hlevel {
              let mut pq1 = p1 - q1
              if pq1 < -128 { pq1 = -128 } else if pq1 > 127 { pq1 = 127 }
              let a = 3 * (q0 - p0) + pq1
              let mut a1 = (a + 4) >> 3
              if a1 < -16 { a1 = -16 } else if a1 > 15 { a1 = 15 }
              let mut a2 = (a + 3) >> 3
              if a2 < -16 { a2 = -16 } else if a2 > 15 { a2 = 15 }
              let mut np0 = p0 + a2
              if np0 < 0 { np0 = 0 } else if np0 > 255 { np0 = 255 }
              let mut nq0 = q0 - a1
              if nq0 < 0 { nq0 = 0 } else if nq0 > 255 { nq0 = 255 }
              pix[idx - j_step] = np0.to_byte()
              pix[idx] = nq0.to_byte()
            } else if four_not_six {
              let a = 3 * (q0 - p0)
              let mut a1 = (a + 4) >> 3
              if a1 < -16 { a1 = -16 } else if a1 > 15 { a1 = 15 }
              let mut a2 = (a + 3) >> 3
              if a2 < -16 { a2 = -16 } else if a2 > 15 { a2 = 15 }
              let a3 = (a1 + 1) >> 1
              let mut np1 = p1 + a3
              if np1 < 0 { np1 = 0 } else if np1 > 255 { np1 = 255 }
              let mut np0 = p0 + a2
              if np0 < 0 { np0 = 0 } else if np0 > 255 { np0 = 255 }
              let mut nq0 = q0 - a1
              if nq0 < 0 { nq0 = 0 } else if nq0 > 255 { nq0 = 255 }
              let mut nq1 = q1 - a3
              if nq1 < 0 { nq1 = 0 } else if nq1 > 255 { nq1 = 255 }
              pix[idx - j2] = np1.to_byte()
              pix[idx - j_step] = np0.to_byte()
              pix[idx] = nq0.to_byte()
              pix[idx + j_step] = nq1.to_byte()
            } else {
              let mut pq1 = p1 - q1
              if pq1 < -128 { pq1 = -128 } else if pq1 > 127 { pq1 = 127 }
              let mut a = 3 * (q0 - p0) + pq1
              if a < -128 { a = -128 } else if a > 127 { a = 127 }
              let a1 = (27 * a + 63) >> 7
              let a2 = (18 * a + 63) >> 7
              let a3 = (9 * a + 63) >> 7
              let mut np2 = p2 + a3
              if np2 < 0 { np2 = 0 } else if np2 > 255 { np2 = 255 }
              let mut np1 = p1 + a2
              if np1 < 0 { np1 = 0 } else if np1 > 255 { np1 = 255 }
              let mut np0 = p0 + a1
              if np0 < 0 { np0 = 0 } else if np0 > 255 { np0 = 255 }
              let mut nq0 = q0 - a1
              if nq0 < 0 { nq0 = 0 } else if nq0 > 255 { nq0 = 255 }
              let mut nq1 = q1 - a2
              if nq1 < 0 { nq1 = 0 } else if nq1 > 255 { nq1 = 255 }
              let mut nq2 = q2 - a3
              if nq2 < 0 { nq2 = 0 } else if nq2 > 255 { nq2 = 255 }
              pix[idx - j3] = np2.to_byte()
              pix[idx - j2] = np1.to_byte()
              pix[idx - j_step] = np0.to_byte()
              pix[idx] = nq0.to_byte()
              pix[idx + j_step] = nq1.to_byte()
              pix[idx + j2] = nq2.to_byte()
            }
          }
        }
      }
    }
    idx = idx + i_step
    n = n - 1
  }
}

///| Convert YUV420 planes + optional alpha plane to tightly packed RGBA8888.
///| Processes 2 horizontally adjacent pixels per chroma lookup (2x fewer chroma ops).
///| Uses the exact Go `image/color.YCbCrToRGB` BT.601 integer formula for 100% byte-exact parity.
fn vp8_yuv420_to_rgba(
  y_plane : Bytes,
  cb_plane : Bytes,
  cr_plane : Bytes,
  y_stride : Int,
  c_stride : Int,
  width : Int,
  height : Int,
  alpha : Bytes,
  has_alpha : Bool,
) -> Bytes {
  let mut out = Bytes::new(width * height * 4)
  let mut dst = 0
  let mut a_idx = 0
  let even_w = width & -2
  let mut y = 0
  if has_alpha {
    while y < height {
      let y_row = y * y_stride
      let c_row = (y >> 1) * c_stride
      let mut x = 0
      while x < even_w {
        let cx = x >> 1
        let cb1 = cb_plane[c_row + cx].to_int() - 128
        let cr1 = cr_plane[c_row + cx].to_int() - 128
        let r_off = 91881 * cr1
        let g_off = -22554 * cb1 - 46802 * cr1
        let b_off = 116130 * cb1

        let yy0 = y_plane[y_row + x].to_int() * 65793
        let mut r0 = (yy0 + r_off) >> 16
        if r0 < 0 { r0 = 0 } else if r0 > 255 { r0 = 255 }
        let mut g0 = (yy0 + g_off) >> 16
        if g0 < 0 { g0 = 0 } else if g0 > 255 { g0 = 255 }
        let mut b0 = (yy0 + b_off) >> 16
        if b0 < 0 { b0 = 0 } else if b0 > 255 { b0 = 255 }
        out[dst] = r0.to_byte()
        out[dst + 1] = g0.to_byte()
        out[dst + 2] = b0.to_byte()
        out[dst + 3] = alpha[a_idx]

        let yy1 = y_plane[y_row + x + 1].to_int() * 65793
        let mut r1 = (yy1 + r_off) >> 16
        if r1 < 0 { r1 = 0 } else if r1 > 255 { r1 = 255 }
        let mut g1 = (yy1 + g_off) >> 16
        if g1 < 0 { g1 = 0 } else if g1 > 255 { g1 = 255 }
        let mut b1 = (yy1 + b_off) >> 16
        if b1 < 0 { b1 = 0 } else if b1 > 255 { b1 = 255 }
        out[dst + 4] = r1.to_byte()
        out[dst + 5] = g1.to_byte()
        out[dst + 6] = b1.to_byte()
        out[dst + 7] = alpha[a_idx + 1]

        dst = dst + 8
        a_idx = a_idx + 2
        x = x + 2
      }
      if x < width {
        let cx = x >> 1
        let cb1 = cb_plane[c_row + cx].to_int() - 128
        let cr1 = cr_plane[c_row + cx].to_int() - 128
        let yy = y_plane[y_row + x].to_int() * 65793
        let mut r = (yy + 91881 * cr1) >> 16
        if r < 0 { r = 0 } else if r > 255 { r = 255 }
        let mut g = (yy - 22554 * cb1 - 46802 * cr1) >> 16
        if g < 0 { g = 0 } else if g > 255 { g = 255 }
        let mut b = (yy + 116130 * cb1) >> 16
        if b < 0 { b = 0 } else if b > 255 { b = 255 }
        out[dst] = r.to_byte()
        out[dst + 1] = g.to_byte()
        out[dst + 2] = b.to_byte()
        out[dst + 3] = alpha[a_idx]
        dst = dst + 4
        a_idx = a_idx + 1
      }
      y = y + 1
    }
  } else {
    let opaque = 255.to_byte()
    while y < height {
      let y_row = y * y_stride
      let c_row = (y >> 1) * c_stride
      let mut x = 0
      while x < even_w {
        let cx = x >> 1
        let cb1 = cb_plane[c_row + cx].to_int() - 128
        let cr1 = cr_plane[c_row + cx].to_int() - 128
        let r_off = 91881 * cr1
        let g_off = -22554 * cb1 - 46802 * cr1
        let b_off = 116130 * cb1

        let yy0 = y_plane[y_row + x].to_int() * 65793
        let mut r0 = (yy0 + r_off) >> 16
        if r0 < 0 { r0 = 0 } else if r0 > 255 { r0 = 255 }
        let mut g0 = (yy0 + g_off) >> 16
        if g0 < 0 { g0 = 0 } else if g0 > 255 { g0 = 255 }
        let mut b0 = (yy0 + b_off) >> 16
        if b0 < 0 { b0 = 0 } else if b0 > 255 { b0 = 255 }
        out[dst] = r0.to_byte()
        out[dst + 1] = g0.to_byte()
        out[dst + 2] = b0.to_byte()
        out[dst + 3] = opaque

        let yy1 = y_plane[y_row + x + 1].to_int() * 65793
        let mut r1 = (yy1 + r_off) >> 16
        if r1 < 0 { r1 = 0 } else if r1 > 255 { r1 = 255 }
        let mut g1 = (yy1 + g_off) >> 16
        if g1 < 0 { g1 = 0 } else if g1 > 255 { g1 = 255 }
        let mut b1 = (yy1 + b_off) >> 16
        if b1 < 0 { b1 = 0 } else if b1 > 255 { b1 = 255 }
        out[dst + 4] = r1.to_byte()
        out[dst + 5] = g1.to_byte()
        out[dst + 6] = b1.to_byte()
        out[dst + 7] = opaque

        dst = dst + 8
        x = x + 2
      }
      if x < width {
        let cx = x >> 1
        let cb1 = cb_plane[c_row + cx].to_int() - 128
        let cr1 = cr_plane[c_row + cx].to_int() - 128
        let yy = y_plane[y_row + x].to_int() * 65793
        let mut r = (yy + 91881 * cr1) >> 16
        if r < 0 { r = 0 } else if r > 255 { r = 255 }
        let mut g = (yy - 22554 * cb1 - 46802 * cr1) >> 16
        if g < 0 { g = 0 } else if g > 255 { g = 255 }
        let mut b = (yy + 116130 * cb1) >> 16
        if b < 0 { b = 0 } else if b > 255 { b = 255 }
        out[dst] = r.to_byte()
        out[dst + 1] = g.to_byte()
        out[dst + 2] = b.to_byte()
        out[dst + 3] = opaque
        dst = dst + 4
      }
      y = y + 1
    }
  }
  out
}
