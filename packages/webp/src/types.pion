///| Public types, errors, limits, and metadata for `packages/webp`.
///| Pure Pion RFC 9649 WebP decoder (RIFF/WEBP + VP8L lossless + VP8 lossy + VP8X/ALPH).

///| Default maximum image width (16,384 px).
pub let default_max_width : Int = 16384

///| Default maximum image height (16,384 px).
pub let default_max_height : Int = 16384

///| Default maximum pixel count (16M pixels = 64 MiB RGBA8888).
pub let default_max_pixels : Int = 16777216

///| Default maximum decoded RGBA8888 output bytes (64 MiB).
pub let default_max_output_bytes : Int = 67108864

///| Default maximum VP8L transform depth (RFC 9649 defines at most 4 unique transforms).
pub let default_max_transform_depth : Int = 4

///| Error returned when probing or decoding a WebP stream.
pub enum WebpError {
  UnexpectedEof(String)
  InvalidContainer(String)
  InvalidHeader(String)
  UnsupportedFeature(String)
  InvalidBitstream(String)
  InvalidHuffman(String)
  InvalidLz77(String)
  InvalidAlpha(String)
  LimitExceeded(String)
}

///| Human-readable description of a `WebpError`.
pub fn webp_error_message(err : WebpError) -> String {
  match err {
    WebpError::UnexpectedEof(msg) => "unexpected EOF: " + msg
    WebpError::InvalidContainer(msg) => "invalid RIFF/WEBP container: " + msg
    WebpError::InvalidHeader(msg) => "invalid WebP header: " + msg
    WebpError::UnsupportedFeature(msg) => "unsupported WebP feature: " + msg
    WebpError::InvalidBitstream(msg) => "invalid WebP bitstream: " + msg
    WebpError::InvalidHuffman(msg) => "invalid VP8L Huffman tree: " + msg
    WebpError::InvalidLz77(msg) => "invalid VP8L LZ77 reference: " + msg
    WebpError::InvalidAlpha(msg) => "invalid ALPH chunk: " + msg
    WebpError::LimitExceeded(msg) => "decode limit exceeded: " + msg
  }
}

///|
pub fn WebpError::to_string(self : WebpError) -> String {
  webp_error_message(self)
}

///| Container bitstream format identified in the WebP header.
pub enum WebpFormat {
  Lossy
  Lossless
  Extended
}

///| Resource limits protecting against decompression bombs and OOM.
pub val struct DecodeLimits {
  pub max_width : Int
  pub max_height : Int
  pub max_pixels : Int
  pub max_output_bytes : Int
  pub max_transform_depth : Int
}

///| Default resource limits (16384x16384 max dim, 16M pixels, 64 MiB output, 4 transforms).
pub fn DecodeLimits::default() -> DecodeLimits {
  DecodeLimits::{
    max_width: default_max_width,
    max_height: default_max_height,
    max_pixels: default_max_pixels,
    max_output_bytes: default_max_output_bytes,
    max_transform_depth: default_max_transform_depth,
  }
}

///| Create custom decode limits.
pub fn DecodeLimits::new(
  max_width : Int,
  max_height : Int,
  max_pixels : Int,
  max_output_bytes : Int,
  max_transform_depth : Int,
) -> DecodeLimits {
  DecodeLimits::{
    max_width: max_width,
    max_height: max_height,
    max_pixels: max_pixels,
    max_output_bytes: max_output_bytes,
    max_transform_depth: max_transform_depth,
  }
}

///| Validate image dimensions against `DecodeLimits` without overflowing 32-bit ints.
pub fn check_dimensions(width : Int, height : Int, limits : DecodeLimits) -> Result[Unit, WebpError] {
  if width <= 0 || height <= 0 {
    return Err(WebpError::InvalidHeader("WebP dimensions must be positive"))
  }
  if width > limits.max_width {
    return Err(
      WebpError::LimitExceeded(
        "width " + width.to_string() + " exceeds max_width " + limits.max_width.to_string(),
      ),
    )
  }
  if height > limits.max_height {
    return Err(
      WebpError::LimitExceeded(
        "height " + height.to_string() + " exceeds max_height " + limits.max_height.to_string(),
      ),
    )
  }
  let pixels64 : Int64 = width.to_int64() * height.to_int64()
  if pixels64 > limits.max_pixels.to_int64() {
    return Err(
      WebpError::LimitExceeded(
        "pixel count " + pixels64.to_string() + " exceeds max_pixels " + limits.max_pixels.to_string(),
      ),
    )
  }
  let out_bytes64 : Int64 = pixels64 * 4L
  if out_bytes64 > limits.max_output_bytes.to_int64() {
    return Err(
      WebpError::LimitExceeded(
        "output size " +
        out_bytes64.to_string() +
        " exceeds max_output_bytes " +
        limits.max_output_bytes.to_string(),
      ),
    )
  }
  Ok(())
}

///| Parsed WebP header metadata from `probe_header`.
pub struct WebpHeader {
  pub format : WebpFormat
  pub width : Int
  pub height : Int
  pub has_alpha : Bool
  pub has_icc : Bool
  pub has_exif : Bool
  pub has_xmp : Bool
  pub has_animation : Bool
}

///| Complete decoded WebP image in tightly packed RGBA8888 format (`4 * width * height` bytes).
pub struct WebpImage {
  pub header : WebpHeader
  pub width : Int
  pub height : Int
  pub has_alpha : Bool
  pub rgba : Bytes
}
