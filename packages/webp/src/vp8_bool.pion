///| RFC 6386 VP8 Boolean Arithmetic Decoder (Chapter 7).
///| Operates zero-copy directly on a slice `[pos..end)` of the input `Bytes`,
///| using a 64-bit window at bits 40..47 (16 overflow headroom bits at 48..63,
///| matching `golang.org/x/image/vp8` / `libwebp`) with 32-bit batch refill
///| and a single packed renorm LUT `(range_m1 << 4) | shift`.

let vp8_uniform_prob : Int = 128

struct BoolDecoder {
  data : Bytes
  mut pos : Int
  end : Int
  mut range_m1 : Int
  mut bits : UInt64
  mut nbits : Int
  mut eof : Bool
  lut_renorm : FixedArray[Int]
}

fn BoolDecoder::empty() -> BoolDecoder {
  BoolDecoder::{
    data: Bytes::new(0),
    pos: 0,
    end: 0,
    range_m1: 254,
    bits: 0UL,
    nbits: 0,
    eof: false,
    lut_renorm: vp8_lut_renorm,
  }
}

fn BoolDecoder::new(data : Bytes, start : Int, end : Int) -> BoolDecoder {
  BoolDecoder::{
    data: data,
    pos: start,
    end: end,
    range_m1: 254,
    bits: 0UL,
    nbits: 0,
    eof: false,
    lut_renorm: vp8_lut_renorm,
  }
}

///| Read one arithmetic-coded boolean with probability `prob` (1..255).
fn BoolDecoder::read_bit(self : BoolDecoder, prob : Int) -> Bool {
  if self.nbits < 8 {
    let pos = self.pos
    if pos + 4 <= self.end {
      let d = self.data
      let w32 : UInt64 = (d[pos].to_int().to_int64().to_uint64() << 24) |
      (d[pos + 1].to_int().to_int64().to_uint64() << 16) |
      (d[pos + 2].to_int().to_int64().to_uint64() << 8) |
      d[pos + 3].to_int().to_int64().to_uint64()
      let sh = 16 - self.nbits
      self.bits = self.bits | (w32 << sh)
      self.pos = pos + 4
      self.nbits = self.nbits + 32
    } else if pos < self.end {
      let x = self.data[pos].to_int().to_int64().to_uint64()
      let sh = 40 - self.nbits
      self.bits = self.bits | (x << sh)
      self.pos = pos + 1
      self.nbits = self.nbits + 8
    } else {
      self.eof = true
      return false
    }
  }
  let split = ((self.range_m1 * prob) >> 8) + 1
  let split40 = split.to_int64().to_uint64() << 40
  let bit = self.bits >= split40
  if bit {
    self.range_m1 = self.range_m1 - split
    self.bits = self.bits - split40
  } else {
    self.range_m1 = split - 1
  }
  if self.range_m1 < 127 {
    let packed = self.lut_renorm[self.range_m1]
    let shift = packed & 0xF
    self.range_m1 = packed >> 4
    self.bits = self.bits << shift
    self.nbits = self.nbits - shift
  }
  bit
}

///| Read an `n`-bit unsigned integer (MSB-first) with probability `prob`.
fn BoolDecoder::read_uint(self : BoolDecoder, prob : Int, n : Int) -> Int {
  let mut u = 0
  let mut rem = n
  while rem > 0 {
    rem = rem - 1
    if self.read_bit(prob) {
      u = u | (1 << rem)
    }
  }
  u
}

///| Read an `n`-bit signed magnitude integer (magnitude then sign bit).
fn BoolDecoder::read_int(self : BoolDecoder, prob : Int, n : Int) -> Int {
  let u = self.read_uint(prob, n)
  if self.read_bit(prob) {
    -u
  } else {
    u
  }
}

///| Read an optional signed `n`-bit integer (1 flag bit; if 0 returns 0).
fn BoolDecoder::read_optional_int(self : BoolDecoder, prob : Int, n : Int) -> Int {
  if !self.read_bit(prob) {
    return 0
  }
  self.read_int(prob, n)
}
