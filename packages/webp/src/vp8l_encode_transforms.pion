///| Forward RFC 9649 VP8L transforms for lossless encoding:
///| - SubtractGreen (in-place)
///| - Predictor (per-tile best of modes 0..13)
///| - ColorIndexing (delta-encoded sorted palette + 1/2/4/8-bit pixel packing)

///| Forward SubtractGreen transform in-place: `R = (R - G) & 0xFF`, `B = (B - G) & 0xFF`.
fn vp8l_forward_subtract_green(pix_in : Bytes) -> Bytes {
  let mut pix = pix_in
  let n = pix.length()
  let mut p = 0
  while p < n {
    let g = pix[p + 1].to_int()
    pix[p] = ((pix[p].to_int() - g) & 0xFF).to_byte()
    pix[p + 2] = ((pix[p + 2].to_int() - g) & 0xFF).to_byte()
    p = p + 4
  }
  pix
}

///| Predict one pixel `(r, g, b, a)` for interior position `p` using mode `0..13`.
fn vp8l_predict_pixel(src : Bytes, p : Int, top : Int, mode : Int) -> (Int, Int, Int, Int) {
  if mode == 0 {
    return (0, 0, 0, 255)
  }
  if mode == 1 {
    return (
      src[p - 4].to_int(),
      src[p - 3].to_int(),
      src[p - 2].to_int(),
      src[p - 1].to_int(),
    )
  }
  if mode == 2 {
    return (
      src[top].to_int(),
      src[top + 1].to_int(),
      src[top + 2].to_int(),
      src[top + 3].to_int(),
    )
  }
  if mode == 3 {
    return (
      src[top + 4].to_int(),
      src[top + 5].to_int(),
      src[top + 6].to_int(),
      src[top + 7].to_int(),
    )
  }
  if mode == 4 {
    return (
      src[top - 4].to_int(),
      src[top - 3].to_int(),
      src[top - 2].to_int(),
      src[top - 1].to_int(),
    )
  }
  if mode == 5 {
    return (
      (((src[p - 4].to_int() + src[top + 4].to_int()) >> 1) + src[top].to_int()) >> 1,
      (((src[p - 3].to_int() + src[top + 5].to_int()) >> 1) + src[top + 1].to_int()) >> 1,
      (((src[p - 2].to_int() + src[top + 6].to_int()) >> 1) + src[top + 2].to_int()) >> 1,
      (((src[p - 1].to_int() + src[top + 7].to_int()) >> 1) + src[top + 3].to_int()) >> 1,
    )
  }
  if mode == 6 {
    return (
      (src[p - 4].to_int() + src[top - 4].to_int()) >> 1,
      (src[p - 3].to_int() + src[top - 3].to_int()) >> 1,
      (src[p - 2].to_int() + src[top - 2].to_int()) >> 1,
      (src[p - 1].to_int() + src[top - 1].to_int()) >> 1,
    )
  }
  if mode == 7 {
    return (
      (src[p - 4].to_int() + src[top].to_int()) >> 1,
      (src[p - 3].to_int() + src[top + 1].to_int()) >> 1,
      (src[p - 2].to_int() + src[top + 2].to_int()) >> 1,
      (src[p - 1].to_int() + src[top + 3].to_int()) >> 1,
    )
  }
  if mode == 8 {
    return (
      (src[top - 4].to_int() + src[top].to_int()) >> 1,
      (src[top - 3].to_int() + src[top + 1].to_int()) >> 1,
      (src[top - 2].to_int() + src[top + 2].to_int()) >> 1,
      (src[top - 1].to_int() + src[top + 3].to_int()) >> 1,
    )
  }
  if mode == 9 {
    return (
      (src[top].to_int() + src[top + 4].to_int()) >> 1,
      (src[top + 1].to_int() + src[top + 5].to_int()) >> 1,
      (src[top + 2].to_int() + src[top + 6].to_int()) >> 1,
      (src[top + 3].to_int() + src[top + 7].to_int()) >> 1,
    )
  }
  if mode == 10 {
    return (
      (((src[p - 4].to_int() + src[top - 4].to_int()) >> 1) + ((src[top].to_int() + src[top + 4].to_int()) >> 1)) >> 1,
      (((src[p - 3].to_int() + src[top - 3].to_int()) >> 1) + ((src[top + 1].to_int() + src[top + 5].to_int()) >> 1)) >> 1,
      (((src[p - 2].to_int() + src[top - 2].to_int()) >> 1) + ((src[top + 2].to_int() + src[top + 6].to_int()) >> 1)) >> 1,
      (((src[p - 1].to_int() + src[top - 1].to_int()) >> 1) + ((src[top + 3].to_int() + src[top + 7].to_int()) >> 1)) >> 1,
    )
  }
  if mode == 11 {
    let l0 = src[p - 4].to_int()
    let l1 = src[p - 3].to_int()
    let l2 = src[p - 2].to_int()
    let l3 = src[p - 1].to_int()
    let c0 = src[top - 4].to_int()
    let c1 = src[top - 3].to_int()
    let c2 = src[top - 2].to_int()
    let c3 = src[top - 1].to_int()
    let t0 = src[top].to_int()
    let t1 = src[top + 1].to_int()
    let t2 = src[top + 2].to_int()
    let t3 = src[top + 3].to_int()
    let pl = vp8l_abs(c0 - t0) + vp8l_abs(c1 - t1) + vp8l_abs(c2 - t2) + vp8l_abs(c3 - t3)
    let pt = vp8l_abs(c0 - l0) + vp8l_abs(c1 - l1) + vp8l_abs(c2 - l2) + vp8l_abs(c3 - l3)
    if pl < pt {
      return (l0, l1, l2, l3)
    }
    return (t0, t1, t2, t3)
  }
  if mode == 12 {
    return (
      vp8l_clamp_add_sub_full(src[p - 4].to_int(), src[top].to_int(), src[top - 4].to_int()),
      vp8l_clamp_add_sub_full(src[p - 3].to_int(), src[top + 1].to_int(), src[top - 3].to_int()),
      vp8l_clamp_add_sub_full(src[p - 2].to_int(), src[top + 2].to_int(), src[top - 2].to_int()),
      vp8l_clamp_add_sub_full(src[p - 1].to_int(), src[top + 3].to_int(), src[top - 1].to_int()),
    )
  }
  // mode == 13
  (
    vp8l_clamp_add_sub_half((src[p - 4].to_int() + src[top].to_int()) >> 1, src[top - 4].to_int()),
    vp8l_clamp_add_sub_half((src[p - 3].to_int() + src[top + 1].to_int()) >> 1, src[top - 3].to_int()),
    vp8l_clamp_add_sub_half((src[p - 2].to_int() + src[top + 2].to_int()) >> 1, src[top - 2].to_int()),
    vp8l_clamp_add_sub_half((src[p - 1].to_int() + src[top + 3].to_int()) >> 1, src[top - 1].to_int()),
  )
}

fn vp8l_wrap_cost(diff : Int) -> Int {
  let d = diff & 0xFF
  if d > 128 { 256 - d } else { d }
}

///| Forward Predictor transform with per-tile best mode selection across modes 0..13.
///| Returns `(residual_rgba, tile_modes_rgba, pred_bits, tw, th)`.
fn vp8l_forward_predictor(src : Bytes, w : Int, h : Int) -> (Bytes, Bytes, Int, Int, Int) {
  let pred_bits = if w * h <= 65536 { 4 } else { 5 }
  let tile_size = 1 << pred_bits
  let tw = vp8l_ntiles(w, pred_bits)
  let th = vp8l_ntiles(h, pred_bits)
  let mut tiles = Bytes::new(4 * tw * th)
  let mut res = Bytes::new(4 * w * h)

  // Select best predictor mode per tile using wrapped L1 residual cost.
  let mut ty = 0
  while ty < th {
    let y0 = ty << pred_bits
    let y1 = if y0 + tile_size < h { y0 + tile_size } else { h }
    let ys = if y0 == 0 { 1 } else { y0 }
    let mut tx = 0
    while tx < tw {
      let x0 = tx << pred_bits
      let x1 = if x0 + tile_size < w { x0 + tile_size } else { w }
      let xs = if x0 == 0 { 1 } else { x0 }
      let mut best_mode = 1
      let mut best_cost = 2147483647
      if xs < x1 && ys < y1 {
        let mut mode = 0
        while mode < 14 {
          let mut cost = 0
          let mut y = ys
          while y < y1 {
            let mut p = 4 * (y * w + xs)
            let mut top = p - 4 * w
            let mut x = xs
            while x < x1 {
              let (pr, pg, pb, pa) = vp8l_predict_pixel(src, p, top, mode)
              cost = cost +
              vp8l_wrap_cost(src[p].to_int() - pr) +
              vp8l_wrap_cost(src[p + 1].to_int() - pg) +
              vp8l_wrap_cost(src[p + 2].to_int() - pb) +
              vp8l_wrap_cost(src[p + 3].to_int() - pa)
              if cost >= best_cost {
                break
              }
              p = p + 4
              top = top + 4
              x = x + 1
            }
            if cost >= best_cost {
              break
            }
            y = y + 1
          }
          if cost < best_cost {
            best_cost = cost
            best_mode = mode
          }
          mode = mode + 1
        }
      }
      let q = 4 * (ty * tw + tx)
      tiles[q + 1] = best_mode.to_byte()
      tx = tx + 1
    }
    ty = ty + 1
  }

  // Pixel (0, 0): predicted as (0, 0, 0, 255).
  res[0] = src[0]
  res[1] = src[1]
  res[2] = src[2]
  res[3] = ((src[3].to_int() - 0xFF) & 0xFF).to_byte()

  // Top row (y == 0, x >= 1): mode 1 (Left).
  let mut p = 4
  let mut x = 1
  while x < w {
    res[p] = ((src[p].to_int() - src[p - 4].to_int()) & 0xFF).to_byte()
    res[p + 1] = ((src[p + 1].to_int() - src[p - 3].to_int()) & 0xFF).to_byte()
    res[p + 2] = ((src[p + 2].to_int() - src[p - 2].to_int()) & 0xFF).to_byte()
    res[p + 3] = ((src[p + 3].to_int() - src[p - 1].to_int()) & 0xFF).to_byte()
    p = p + 4
    x = x + 1
  }

  // Remaining rows (y >= 1).
  let mut top = 0
  let mut y = 1
  while y < h {
    // First column (x == 0): mode 2 (Top).
    res[p] = ((src[p].to_int() - src[top].to_int()) & 0xFF).to_byte()
    res[p + 1] = ((src[p + 1].to_int() - src[top + 1].to_int()) & 0xFF).to_byte()
    res[p + 2] = ((src[p + 2].to_int() - src[top + 2].to_int()) & 0xFF).to_byte()
    res[p + 3] = ((src[p + 3].to_int() - src[top + 3].to_int()) & 0xFF).to_byte()
    p = p + 4
    top = top + 4

    let mut q = 4 * (y >> pred_bits) * tw
    x = 1
    let mut tile_end = tile_size
    while x < w {
      if tile_end > w {
        tile_end = w
      }
      let mode = tiles[q + 1].to_int() & 0x0F
      q = q + 4
      while x < tile_end {
        let (pr, pg, pb, pa) = vp8l_predict_pixel(src, p, top, mode)
        res[p] = ((src[p].to_int() - pr) & 0xFF).to_byte()
        res[p + 1] = ((src[p + 1].to_int() - pg) & 0xFF).to_byte()
        res[p + 2] = ((src[p + 2].to_int() - pb) & 0xFF).to_byte()
        res[p + 3] = ((src[p + 3].to_int() - pa) & 0xFF).to_byte()
        p = p + 4
        top = top + 4
        x = x + 1
      }
      tile_end = tile_end + tile_size
    }
    y = y + 1
  }

  (res, tiles, pred_bits, tw, th)
}

///| Attempt forward ColorIndexing transform if unique colors <= 256 and profitable.
///| Returns `(applied, packed_rgba, new_w, n_colors, pal_delta_rgba)`.
fn vp8l_try_color_indexing(src : Bytes, w : Int, h : Int) -> (Bool, Bytes, Int, Int, Bytes) {
  let npix = w * h
  let hmask = 511
  let hkeys = FixedArray::make(512, 0U)
  let hvals = FixedArray::make(512, -1)
  let palette = FixedArray::make(256, 0U)
  let mut n_colors = 0

  let mut i = 0
  while i < npix {
    let off = i * 4
    let argb : UInt = (src[off + 3].to_int().to_uint() << 24U) |
    (src[off].to_int().to_uint() << 16U) |
    (src[off + 1].to_int().to_uint() << 8U) |
    src[off + 2].to_int().to_uint()
    let mut slot = ((argb * 0x1e35a7bdU) >> 23U).to_int() & hmask
    let mut found = false
    while hvals[slot] >= 0 {
      if hkeys[slot] == argb {
        found = true
        break
      }
      slot = (slot + 1) & hmask
    }
    if !found {
      if n_colors >= 256 {
        return (false, Bytes::new(0), w, 0, Bytes::new(0))
      }
      hkeys[slot] = argb
      hvals[slot] = n_colors
      palette[n_colors] = argb
      n_colors = n_colors + 1
    }
    i = i + 1
  }

  // Only apply if palette overhead pays off.
  let profitable = (n_colors <= 16 && npix >= 8) || (n_colors * 4 <= npix)
  if !profitable {
    return (false, Bytes::new(0), w, 0, Bytes::new(0))
  }

  // Sort palette ascending by ARGB so delta encoding yields smaller residuals.
  i = 1
  while i < n_colors {
    let key = palette[i]
    let mut j = i - 1
    while j >= 0 && palette[j] > key {
      palette[j + 1] = palette[j]
      j = j - 1
    }
    palette[j + 1] = key
    i = i + 1
  }

  // Rebuild hash table mapping sorted ARGB -> palette index.
  i = 0
  while i < 512 {
    hkeys[i] = 0U
    hvals[i] = -1
    i = i + 1
  }
  i = 0
  while i < n_colors {
    let argb = palette[i]
    let mut slot = ((argb * 0x1e35a7bdU) >> 23U).to_int() & hmask
    while hvals[slot] >= 0 {
      slot = (slot + 1) & hmask
    }
    hkeys[slot] = argb
    hvals[slot] = i
    i = i + 1
  }

  // Build delta-encoded palette sub-image (n_colors x 1, RGBA).
  let mut pal_delta = Bytes::new(4 * n_colors)
  let mut prev_r = 0
  let mut prev_g = 0
  let mut prev_b = 0
  let mut prev_a = 0
  i = 0
  while i < n_colors {
    let argb = palette[i]
    let r = ((argb >> 16U) & 0xFFU).to_int()
    let g = ((argb >> 8U) & 0xFFU).to_int()
    let b = (argb & 0xFFU).to_int()
    let a = ((argb >> 24U) & 0xFFU).to_int()
    pal_delta[4 * i] = ((r - prev_r) & 0xFF).to_byte()
    pal_delta[4 * i + 1] = ((g - prev_g) & 0xFF).to_byte()
    pal_delta[4 * i + 2] = ((b - prev_b) & 0xFF).to_byte()
    pal_delta[4 * i + 3] = ((a - prev_a) & 0xFF).to_byte()
    prev_r = r
    prev_g = g
    prev_b = b
    prev_a = a
    i = i + 1
  }

  let bits = if n_colors <= 2 {
    3
  } else if n_colors <= 4 {
    2
  } else if n_colors <= 16 {
    1
  } else {
    0
  }
  let new_w = vp8l_ntiles(w, bits)
  let mut packed = Bytes::new(4 * new_w * h)
  let per_byte = 1 << bits
  let bpp = 8 >> bits

  let mut y = 0
  while y < h {
    let row_off = y * w
    let mut px = 0
    while px < new_w {
      let mut acc = 0
      let mut k = 0
      while k < per_byte {
        let x = (px << bits) + k
        if x < w {
          let off = (row_off + x) * 4
          let argb : UInt = (src[off + 3].to_int().to_uint() << 24U) |
          (src[off].to_int().to_uint() << 16U) |
          (src[off + 1].to_int().to_uint() << 8U) |
          src[off + 2].to_int().to_uint()
          let mut slot = ((argb * 0x1e35a7bdU) >> 23U).to_int() & hmask
          while hvals[slot] >= 0 && hkeys[slot] != argb {
            slot = (slot + 1) & hmask
          }
          let pidx = if hvals[slot] >= 0 { hvals[slot] } else { 0 }
          acc = acc | (pidx << (k * bpp))
        }
        k = k + 1
      }
      // Per RFC 9649 §3.5.4, packed color-index pixels store index bits in green with alpha = 255.
      let dst_off = 4 * (y * new_w + px)
      packed[dst_off + 1] = acc.to_byte()
      packed[dst_off + 3] = 255.to_byte()
      px = px + 1
    }
    y = y + 1
  }

  (true, packed, new_w, n_colors, pal_delta)
}
