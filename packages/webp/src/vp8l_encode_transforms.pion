///| Forward RFC 9649 VP8L transforms for lossless encoding (zero-COW `FixedArray[Byte]`):
///| - SubtractGreen (in-place)
///| - Predictor (single-pass 14-mode tile selection + mode-specialized residual emission)
///| - ColorIndexing (delta-encoded sorted palette + 1/2/4/8-bit pixel packing)

fn build_vp8l_wrap_cost_lut() -> FixedArray[Int] {
  let lut = FixedArray::make(511, 0)
  let mut diff = -255
  while diff <= 255 {
    let d = diff & 0xFF
    lut[diff + 255] = if d > 128 { 256 - d } else { d }
    diff = diff + 1
  }
  lut
}

let vp8l_wrap_cost_lut : FixedArray[Int] = build_vp8l_wrap_cost_lut()

///| Forward SubtractGreen transform in-place: `R = (R - G) & 0xFF`, `B = (B - G) & 0xFF`.
fn vp8l_forward_subtract_green(pix : FixedArray[Byte]) -> FixedArray[Byte] {
  let n = pix.length()
  let mut p = 0
  let n8 = n & -8
  while p < n8 {
    let g0 = pix[p + 1].to_int()
    pix[p] = ((pix[p].to_int() - g0) & 0xFF).to_byte()
    pix[p + 2] = ((pix[p + 2].to_int() - g0) & 0xFF).to_byte()
    let g1 = pix[p + 5].to_int()
    pix[p + 4] = ((pix[p + 4].to_int() - g1) & 0xFF).to_byte()
    pix[p + 6] = ((pix[p + 6].to_int() - g1) & 0xFF).to_byte()
    p = p + 8
  }
  while p < n {
    let g = pix[p + 1].to_int()
    pix[p] = ((pix[p].to_int() - g) & 0xFF).to_byte()
    pix[p + 2] = ((pix[p + 2].to_int() - g) & 0xFF).to_byte()
    p = p + 4
  }
  pix
}

///| Evaluate all 14 predictor modes for one tile `[xs..x1) x [ys..y1)` and return the lowest-cost mode.
///| On large tiles (>= 256 px), samples every 2nd row for 2x speedup with virtually identical compression.
fn vp8l_select_best_pred_mode(
  src : FixedArray[Byte],
  w : Int,
  xs : Int,
  x1 : Int,
  ys : Int,
  y1 : Int,
  wlut : FixedArray[Int],
  costs : FixedArray[Int],
) -> Int {
  let mut m = 0
  while m < 14 {
    costs[m] = 0
    m = m + 1
  }
  let y_step = if (x1 - xs) * (y1 - ys) >= 256 { 2 } else { 1 }
  let mut y = ys
  while y < y1 {
    let mut p = 4 * (y * w + xs)
    let mut top = p - 4 * w
    let mut l0 = src[p - 4].to_int()
    let mut l1 = src[p - 3].to_int()
    let mut l2 = src[p - 2].to_int()
    let mut l3 = src[p - 1].to_int()
    let mut tl0 = src[top - 4].to_int()
    let mut tl1 = src[top - 3].to_int()
    let mut tl2 = src[top - 2].to_int()
    let mut tl3 = src[top - 1].to_int()
    let mut t0 = src[top].to_int()
    let mut t1 = src[top + 1].to_int()
    let mut t2 = src[top + 2].to_int()
    let mut t3 = src[top + 3].to_int()
    let mut x = xs
    while x < x1 {
      let s0 = src[p].to_int()
      let s1 = src[p + 1].to_int()
      let s2 = src[p + 2].to_int()
      let s3 = src[p + 3].to_int()
      let tr0 = src[top + 4].to_int()
      let tr1 = src[top + 5].to_int()
      let tr2 = src[top + 6].to_int()
      let tr3 = src[top + 7].to_int()

      // Mode 0: (0, 0, 0, 255)
      costs[0] = costs[0] + wlut[s0 + 255] + wlut[s1 + 255] + wlut[s2 + 255] + wlut[s3]
      // Mode 1: L
      let c1 = wlut[s0 - l0 + 255] + wlut[s1 - l1 + 255] + wlut[s2 - l2 + 255] + wlut[s3 - l3 + 255]
      costs[1] = costs[1] + c1
      // Mode 2: T
      let c2 = wlut[s0 - t0 + 255] + wlut[s1 - t1 + 255] + wlut[s2 - t2 + 255] + wlut[s3 - t3 + 255]
      costs[2] = costs[2] + c2
      // Mode 3: TR
      costs[3] = costs[3] + wlut[s0 - tr0 + 255] + wlut[s1 - tr1 + 255] + wlut[s2 - tr2 + 255] + wlut[s3 - tr3 + 255]
      // Mode 4: TL
      costs[4] = costs[4] + wlut[s0 - tl0 + 255] + wlut[s1 - tl1 + 255] + wlut[s2 - tl2 + 255] + wlut[s3 - tl3 + 255]
      // Mode 5: avg2(avg2(L, TR), T)
      costs[5] = costs[5] +
      wlut[s0 - ((((l0 + tr0) >> 1) + t0) >> 1) + 255] +
      wlut[s1 - ((((l1 + tr1) >> 1) + t1) >> 1) + 255] +
      wlut[s2 - ((((l2 + tr2) >> 1) + t2) >> 1) + 255] +
      wlut[s3 - ((((l3 + tr3) >> 1) + t3) >> 1) + 255]
      // Mode 6: avg2(L, TL)
      let a6_0 = (l0 + tl0) >> 1
      let a6_1 = (l1 + tl1) >> 1
      let a6_2 = (l2 + tl2) >> 1
      let a6_3 = (l3 + tl3) >> 1
      costs[6] = costs[6] + wlut[s0 - a6_0 + 255] + wlut[s1 - a6_1 + 255] + wlut[s2 - a6_2 + 255] + wlut[s3 - a6_3 + 255]
      // Mode 7: avg2(L, T)
      let a7_0 = (l0 + t0) >> 1
      let a7_1 = (l1 + t1) >> 1
      let a7_2 = (l2 + t2) >> 1
      let a7_3 = (l3 + t3) >> 1
      costs[7] = costs[7] + wlut[s0 - a7_0 + 255] + wlut[s1 - a7_1 + 255] + wlut[s2 - a7_2 + 255] + wlut[s3 - a7_3 + 255]
      // Mode 8: avg2(TL, T)
      costs[8] = costs[8] +
      wlut[s0 - ((tl0 + t0) >> 1) + 255] +
      wlut[s1 - ((tl1 + t1) >> 1) + 255] +
      wlut[s2 - ((tl2 + t2) >> 1) + 255] +
      wlut[s3 - ((tl3 + t3) >> 1) + 255]
      // Mode 9: avg2(T, TR)
      let a9_0 = (t0 + tr0) >> 1
      let a9_1 = (t1 + tr1) >> 1
      let a9_2 = (t2 + tr2) >> 1
      let a9_3 = (t3 + tr3) >> 1
      costs[9] = costs[9] + wlut[s0 - a9_0 + 255] + wlut[s1 - a9_1 + 255] + wlut[s2 - a9_2 + 255] + wlut[s3 - a9_3 + 255]
      // Mode 10: avg2(avg2(L, TL), avg2(T, TR))
      costs[10] = costs[10] +
      wlut[s0 - ((a6_0 + a9_0) >> 1) + 255] +
      wlut[s1 - ((a6_1 + a9_1) >> 1) + 255] +
      wlut[s2 - ((a6_2 + a9_2) >> 1) + 255] +
      wlut[s3 - ((a6_3 + a9_3) >> 1) + 255]
      // Mode 11: Select(L, T, TL)
      let pl = (if tl0 >= t0 { tl0 - t0 } else { t0 - tl0 }) +
      (if tl1 >= t1 { tl1 - t1 } else { t1 - tl1 }) +
      (if tl2 >= t2 { tl2 - t2 } else { t2 - tl2 }) +
      (if tl3 >= t3 { tl3 - t3 } else { t3 - tl3 })
      let pt = (if tl0 >= l0 { tl0 - l0 } else { l0 - tl0 }) +
      (if tl1 >= l1 { tl1 - l1 } else { l1 - tl1 }) +
      (if tl2 >= l2 { tl2 - l2 } else { l2 - tl2 }) +
      (if tl3 >= l3 { tl3 - l3 } else { l3 - tl3 })
      costs[11] = costs[11] + (if pl < pt { c1 } else { c2 })
      // Mode 12: clamp(L + T - TL)
      let mut p12_0 = l0 + t0 - tl0
      if (p12_0 & -256) != 0 { p12_0 = if p12_0 < 0 { 0 } else { 255 } }
      let mut p12_1 = l1 + t1 - tl1
      if (p12_1 & -256) != 0 { p12_1 = if p12_1 < 0 { 0 } else { 255 } }
      let mut p12_2 = l2 + t2 - tl2
      if (p12_2 & -256) != 0 { p12_2 = if p12_2 < 0 { 0 } else { 255 } }
      let mut p12_3 = l3 + t3 - tl3
      if (p12_3 & -256) != 0 { p12_3 = if p12_3 < 0 { 0 } else { 255 } }
      costs[12] = costs[12] + wlut[s0 - p12_0 + 255] + wlut[s1 - p12_1 + 255] + wlut[s2 - p12_2 + 255] + wlut[s3 - p12_3 + 255]
      // Mode 13: clamp(avg2(L, T) + (avg2(L, T) - TL) / 2)
      let mut p13_0 = a7_0 + (a7_0 - tl0) / 2
      if (p13_0 & -256) != 0 { p13_0 = if p13_0 < 0 { 0 } else { 255 } }
      let mut p13_1 = a7_1 + (a7_1 - tl1) / 2
      if (p13_1 & -256) != 0 { p13_1 = if p13_1 < 0 { 0 } else { 255 } }
      let mut p13_2 = a7_2 + (a7_2 - tl2) / 2
      if (p13_2 & -256) != 0 { p13_2 = if p13_2 < 0 { 0 } else { 255 } }
      let mut p13_3 = a7_3 + (a7_3 - tl3) / 2
      if (p13_3 & -256) != 0 { p13_3 = if p13_3 < 0 { 0 } else { 255 } }
      costs[13] = costs[13] + wlut[s0 - p13_0 + 255] + wlut[s1 - p13_1 + 255] + wlut[s2 - p13_2 + 255] + wlut[s3 - p13_3 + 255]

      l0 = s0
      l1 = s1
      l2 = s2
      l3 = s3
      tl0 = t0
      tl1 = t1
      tl2 = t2
      tl3 = t3
      t0 = tr0
      t1 = tr1
      t2 = tr2
      t3 = tr3
      p = p + 4
      top = top + 4
      x = x + 1
    }
    y = y + y_step
  }
  let mut best_cost = costs[0]
  let mut best_mode = 0
  m = 1
  while m < 14 {
    if costs[m] < best_cost {
      best_cost = costs[m]
      best_mode = m
    }
    m = m + 1
  }
  best_mode
}

///| Forward Predictor transform with per-tile best mode selection across modes 0..13
///| and mode-specialized residual emission (zero tuple allocations, zero COW).
///| Returns `(residual_rgba, tile_modes_rgba, pred_bits, tw, th)`.
fn vp8l_forward_predictor(
  src : FixedArray[Byte],
  w : Int,
  h : Int,
) -> (FixedArray[Byte], FixedArray[Byte], Int, Int, Int) {
  let pred_bits = if w * h <= 65536 { 4 } else { 5 }
  let tile_size = 1 << pred_bits
  let tw = vp8l_ntiles(w, pred_bits)
  let th = vp8l_ntiles(h, pred_bits)
  let tiles = FixedArray::make(4 * tw * th, 0.to_byte())
  let res = FixedArray::make(4 * w * h, 0.to_byte())
  let wlut = vp8l_wrap_cost_lut
  let costs = FixedArray::make(14, 0)

  let mut ty = 0
  while ty < th {
    let y0 = ty << pred_bits
    let y1 = if y0 + tile_size < h { y0 + tile_size } else { h }
    let ys = if y0 == 0 { 1 } else { y0 }
    let mut tx = 0
    while tx < tw {
      let x0 = tx << pred_bits
      let x1 = if x0 + tile_size < w { x0 + tile_size } else { w }
      let xs = if x0 == 0 { 1 } else { x0 }
      let best_mode = if xs < x1 && ys < y1 {
        vp8l_select_best_pred_mode(src, w, xs, x1, ys, y1, wlut, costs)
      } else {
        1
      }
      let q = 4 * (ty * tw + tx)
      tiles[q + 1] = best_mode.to_byte()
      tx = tx + 1
    }
    ty = ty + 1
  }

  // Pixel (0, 0): predicted as (0, 0, 0, 255).
  res[0] = src[0]
  res[1] = src[1]
  res[2] = src[2]
  res[3] = ((src[3].to_int() - 0xFF) & 0xFF).to_byte()

  // Top row (y == 0, x >= 1): mode 1 (Left).
  let mut p = 4
  let mut x = 1
  while x < w {
    res[p] = ((src[p].to_int() - src[p - 4].to_int()) & 0xFF).to_byte()
    res[p + 1] = ((src[p + 1].to_int() - src[p - 3].to_int()) & 0xFF).to_byte()
    res[p + 2] = ((src[p + 2].to_int() - src[p - 2].to_int()) & 0xFF).to_byte()
    res[p + 3] = ((src[p + 3].to_int() - src[p - 1].to_int()) & 0xFF).to_byte()
    p = p + 4
    x = x + 1
  }

  // Remaining rows (y >= 1), mode-specialized per tile.
  let mut top = 0
  let mut y = 1
  while y < h {
    // First column (x == 0): mode 2 (Top).
    res[p] = ((src[p].to_int() - src[top].to_int()) & 0xFF).to_byte()
    res[p + 1] = ((src[p + 1].to_int() - src[top + 1].to_int()) & 0xFF).to_byte()
    res[p + 2] = ((src[p + 2].to_int() - src[top + 2].to_int()) & 0xFF).to_byte()
    res[p + 3] = ((src[p + 3].to_int() - src[top + 3].to_int()) & 0xFF).to_byte()
    p = p + 4
    top = top + 4

    let mut q = 4 * (y >> pred_bits) * tw
    x = 1
    let mut tile_end = tile_size
    while x < w {
      if tile_end > w {
        tile_end = w
      }
      let mode = tiles[q + 1].to_int() & 0x0F
      q = q + 4
      if mode == 0 {
        while x < tile_end {
          res[p] = src[p]
          res[p + 1] = src[p + 1]
          res[p + 2] = src[p + 2]
          res[p + 3] = ((src[p + 3].to_int() - 255) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 1 {
        while x < tile_end {
          res[p] = ((src[p].to_int() - src[p - 4].to_int()) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - src[p - 3].to_int()) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - src[p - 2].to_int()) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - src[p - 1].to_int()) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 2 {
        while x < tile_end {
          res[p] = ((src[p].to_int() - src[top].to_int()) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - src[top + 1].to_int()) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - src[top + 2].to_int()) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - src[top + 3].to_int()) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 3 {
        while x < tile_end {
          res[p] = ((src[p].to_int() - src[top + 4].to_int()) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - src[top + 5].to_int()) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - src[top + 6].to_int()) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - src[top + 7].to_int()) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 4 {
        while x < tile_end {
          res[p] = ((src[p].to_int() - src[top - 4].to_int()) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - src[top - 3].to_int()) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - src[top - 2].to_int()) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - src[top - 1].to_int()) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 5 {
        while x < tile_end {
          res[p] = ((src[p].to_int() - ((((src[p - 4].to_int() + src[top + 4].to_int()) >> 1) + src[top].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - ((((src[p - 3].to_int() + src[top + 5].to_int()) >> 1) + src[top + 1].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - ((((src[p - 2].to_int() + src[top + 6].to_int()) >> 1) + src[top + 2].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - ((((src[p - 1].to_int() + src[top + 7].to_int()) >> 1) + src[top + 3].to_int()) >> 1)) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 6 {
        while x < tile_end {
          res[p] = ((src[p].to_int() - ((src[p - 4].to_int() + src[top - 4].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - ((src[p - 3].to_int() + src[top - 3].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - ((src[p - 2].to_int() + src[top - 2].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - ((src[p - 1].to_int() + src[top - 1].to_int()) >> 1)) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 7 {
        while x < tile_end {
          res[p] = ((src[p].to_int() - ((src[p - 4].to_int() + src[top].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - ((src[p - 3].to_int() + src[top + 1].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - ((src[p - 2].to_int() + src[top + 2].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - ((src[p - 1].to_int() + src[top + 3].to_int()) >> 1)) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 8 {
        while x < tile_end {
          res[p] = ((src[p].to_int() - ((src[top - 4].to_int() + src[top].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - ((src[top - 3].to_int() + src[top + 1].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - ((src[top - 2].to_int() + src[top + 2].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - ((src[top - 1].to_int() + src[top + 3].to_int()) >> 1)) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 9 {
        while x < tile_end {
          res[p] = ((src[p].to_int() - ((src[top].to_int() + src[top + 4].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - ((src[top + 1].to_int() + src[top + 5].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - ((src[top + 2].to_int() + src[top + 6].to_int()) >> 1)) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - ((src[top + 3].to_int() + src[top + 7].to_int()) >> 1)) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 10 {
        while x < tile_end {
          res[p] = ((src[p].to_int() - ((((src[p - 4].to_int() + src[top - 4].to_int()) >> 1) + ((src[top].to_int() + src[top + 4].to_int()) >> 1)) >> 1)) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - ((((src[p - 3].to_int() + src[top - 3].to_int()) >> 1) + ((src[top + 1].to_int() + src[top + 5].to_int()) >> 1)) >> 1)) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - ((((src[p - 2].to_int() + src[top - 2].to_int()) >> 1) + ((src[top + 2].to_int() + src[top + 6].to_int()) >> 1)) >> 1)) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - ((((src[p - 1].to_int() + src[top - 1].to_int()) >> 1) + ((src[top + 3].to_int() + src[top + 7].to_int()) >> 1)) >> 1)) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 11 {
        while x < tile_end {
          let l0 = src[p - 4].to_int()
          let l1 = src[p - 3].to_int()
          let l2 = src[p - 2].to_int()
          let l3 = src[p - 1].to_int()
          let c0 = src[top - 4].to_int()
          let c1 = src[top - 3].to_int()
          let c2 = src[top - 2].to_int()
          let c3 = src[top - 1].to_int()
          let t0 = src[top].to_int()
          let t1 = src[top + 1].to_int()
          let t2 = src[top + 2].to_int()
          let t3 = src[top + 3].to_int()
          let pl = (if c0 >= t0 { c0 - t0 } else { t0 - c0 }) +
          (if c1 >= t1 { c1 - t1 } else { t1 - c1 }) +
          (if c2 >= t2 { c2 - t2 } else { t2 - c2 }) +
          (if c3 >= t3 { c3 - t3 } else { t3 - c3 })
          let pt = (if c0 >= l0 { c0 - l0 } else { l0 - c0 }) +
          (if c1 >= l1 { c1 - l1 } else { l1 - c1 }) +
          (if c2 >= l2 { c2 - l2 } else { l2 - c2 }) +
          (if c3 >= l3 { c3 - l3 } else { l3 - c3 })
          if pl < pt {
            res[p] = ((src[p].to_int() - l0) & 0xFF).to_byte()
            res[p + 1] = ((src[p + 1].to_int() - l1) & 0xFF).to_byte()
            res[p + 2] = ((src[p + 2].to_int() - l2) & 0xFF).to_byte()
            res[p + 3] = ((src[p + 3].to_int() - l3) & 0xFF).to_byte()
          } else {
            res[p] = ((src[p].to_int() - t0) & 0xFF).to_byte()
            res[p + 1] = ((src[p + 1].to_int() - t1) & 0xFF).to_byte()
            res[p + 2] = ((src[p + 2].to_int() - t2) & 0xFF).to_byte()
            res[p + 3] = ((src[p + 3].to_int() - t3) & 0xFF).to_byte()
          }
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else if mode == 12 {
        while x < tile_end {
          let mut pr0 = src[p - 4].to_int() + src[top].to_int() - src[top - 4].to_int()
          if (pr0 & -256) != 0 { pr0 = if pr0 < 0 { 0 } else { 255 } }
          let mut pr1 = src[p - 3].to_int() + src[top + 1].to_int() - src[top - 3].to_int()
          if (pr1 & -256) != 0 { pr1 = if pr1 < 0 { 0 } else { 255 } }
          let mut pr2 = src[p - 2].to_int() + src[top + 2].to_int() - src[top - 2].to_int()
          if (pr2 & -256) != 0 { pr2 = if pr2 < 0 { 0 } else { 255 } }
          let mut pr3 = src[p - 1].to_int() + src[top + 3].to_int() - src[top - 1].to_int()
          if (pr3 & -256) != 0 { pr3 = if pr3 < 0 { 0 } else { 255 } }
          res[p] = ((src[p].to_int() - pr0) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - pr1) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - pr2) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - pr3) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      } else {
        while x < tile_end {
          let a0 = (src[p - 4].to_int() + src[top].to_int()) >> 1
          let mut pr0 = a0 + (a0 - src[top - 4].to_int()) / 2
          if (pr0 & -256) != 0 { pr0 = if pr0 < 0 { 0 } else { 255 } }
          let a1 = (src[p - 3].to_int() + src[top + 1].to_int()) >> 1
          let mut pr1 = a1 + (a1 - src[top - 3].to_int()) / 2
          if (pr1 & -256) != 0 { pr1 = if pr1 < 0 { 0 } else { 255 } }
          let a2 = (src[p - 2].to_int() + src[top + 2].to_int()) >> 1
          let mut pr2 = a2 + (a2 - src[top - 2].to_int()) / 2
          if (pr2 & -256) != 0 { pr2 = if pr2 < 0 { 0 } else { 255 } }
          let a3 = (src[p - 1].to_int() + src[top + 3].to_int()) >> 1
          let mut pr3 = a3 + (a3 - src[top - 1].to_int()) / 2
          if (pr3 & -256) != 0 { pr3 = if pr3 < 0 { 0 } else { 255 } }
          res[p] = ((src[p].to_int() - pr0) & 0xFF).to_byte()
          res[p + 1] = ((src[p + 1].to_int() - pr1) & 0xFF).to_byte()
          res[p + 2] = ((src[p + 2].to_int() - pr2) & 0xFF).to_byte()
          res[p + 3] = ((src[p + 3].to_int() - pr3) & 0xFF).to_byte()
          p = p + 4
          top = top + 4
          x = x + 1
        }
      }
      tile_end = tile_end + tile_size
    }
    y = y + 1
  }

  (res, tiles, pred_bits, tw, th)
}

///| Attempt forward ColorIndexing transform if unique colors <= 256 and profitable.
///| Returns `(applied, packed_rgba, new_w, n_colors, pal_delta_rgba)`.
fn vp8l_try_color_indexing(
  src : FixedArray[Byte],
  w : Int,
  h : Int,
) -> (Bool, FixedArray[Byte], Int, Int, FixedArray[Byte]) {
  let npix = w * h
  let hmask = 511
  let hkeys = FixedArray::make(512, 0U)
  let hvals = FixedArray::make(512, -1)
  let palette = FixedArray::make(256, 0U)
  let mut n_colors = 0

  let mut i = 0
  while i < npix {
    let off = i * 4
    let argb : UInt = (src[off + 3].to_int().to_uint() << 24U) |
    (src[off].to_int().to_uint() << 16U) |
    (src[off + 1].to_int().to_uint() << 8U) |
    src[off + 2].to_int().to_uint()
    let mut slot = ((argb * 0x1e35a7bdU) >> 23U).to_int() & hmask
    let mut found = false
    while hvals[slot] >= 0 {
      if hkeys[slot] == argb {
        found = true
        break
      }
      slot = (slot + 1) & hmask
    }
    if !found {
      if n_colors >= 256 {
        return (false, FixedArray::make(0, 0.to_byte()), w, 0, FixedArray::make(0, 0.to_byte()))
      }
      hkeys[slot] = argb
      hvals[slot] = n_colors
      palette[n_colors] = argb
      n_colors = n_colors + 1
    }
    i = i + 1
  }

  // Only apply if palette overhead pays off.
  let profitable = (n_colors <= 16 && npix >= 8) || (n_colors * 4 <= npix)
  if !profitable {
    return (false, FixedArray::make(0, 0.to_byte()), w, 0, FixedArray::make(0, 0.to_byte()))
  }

  // Sort palette ascending by ARGB so delta encoding yields smaller residuals.
  i = 1
  while i < n_colors {
    let key = palette[i]
    let mut j = i - 1
    while j >= 0 && palette[j] > key {
      palette[j + 1] = palette[j]
      j = j - 1
    }
    palette[j + 1] = key
    i = i + 1
  }

  // Rebuild hash table mapping sorted ARGB -> palette index.
  i = 0
  while i < 512 {
    hkeys[i] = 0U
    hvals[i] = -1
    i = i + 1
  }
  i = 0
  while i < n_colors {
    let argb = palette[i]
    let mut slot = ((argb * 0x1e35a7bdU) >> 23U).to_int() & hmask
    while hvals[slot] >= 0 {
      slot = (slot + 1) & hmask
    }
    hkeys[slot] = argb
    hvals[slot] = i
    i = i + 1
  }

  // Build delta-encoded palette sub-image (n_colors x 1, RGBA).
  let pal_delta = FixedArray::make(4 * n_colors, 0.to_byte())
  let mut prev_r = 0
  let mut prev_g = 0
  let mut prev_b = 0
  let mut prev_a = 0
  i = 0
  while i < n_colors {
    let argb = palette[i]
    let r = ((argb >> 16U) & 0xFFU).to_int()
    let g = ((argb >> 8U) & 0xFFU).to_int()
    let b = (argb & 0xFFU).to_int()
    let a = ((argb >> 24U) & 0xFFU).to_int()
    pal_delta[4 * i] = ((r - prev_r) & 0xFF).to_byte()
    pal_delta[4 * i + 1] = ((g - prev_g) & 0xFF).to_byte()
    pal_delta[4 * i + 2] = ((b - prev_b) & 0xFF).to_byte()
    pal_delta[4 * i + 3] = ((a - prev_a) & 0xFF).to_byte()
    prev_r = r
    prev_g = g
    prev_b = b
    prev_a = a
    i = i + 1
  }

  let bits = if n_colors <= 2 {
    3
  } else if n_colors <= 4 {
    2
  } else if n_colors <= 16 {
    1
  } else {
    0
  }
  let new_w = vp8l_ntiles(w, bits)
  let packed = FixedArray::make(4 * new_w * h, 0.to_byte())
  let per_byte = 1 << bits
  let bpp = 8 >> bits

  let mut y = 0
  while y < h {
    let row_off = y * w
    let mut px = 0
    while px < new_w {
      let mut acc = 0
      let mut k = 0
      while k < per_byte {
        let x = (px << bits) + k
        if x < w {
          let off = (row_off + x) * 4
          let argb : UInt = (src[off + 3].to_int().to_uint() << 24U) |
          (src[off].to_int().to_uint() << 16U) |
          (src[off + 1].to_int().to_uint() << 8U) |
          src[off + 2].to_int().to_uint()
          let mut slot = ((argb * 0x1e35a7bdU) >> 23U).to_int() & hmask
          while hvals[slot] >= 0 && hkeys[slot] != argb {
            slot = (slot + 1) & hmask
          }
          let pidx = if hvals[slot] >= 0 { hvals[slot] } else { 0 }
          acc = acc | (pidx << (k * bpp))
        }
        k = k + 1
      }
      // Per RFC 9649 §3.5.4, packed color-index pixels store index bits in green with alpha = 255.
      let dst_off = 4 * (y * new_w + px)
      packed[dst_off + 1] = acc.to_byte()
      packed[dst_off + 3] = 255.to_byte()
      px = px + 1
    }
    y = y + 1
  }

  (true, packed, new_w, n_colors, pal_delta)
}
