///| VP8L LSB 64-bit bit writer and length-limited Canonical Huffman encoder
///| (Package-Merge <= 15 bits, Simple 1/2-symbol trees, and Normal RLE 16/17/18).

///| LSB-first 64-bit buffered bit writer.
struct BitWriter {
  buf : Array[Byte]
  mut acc : UInt64
  mut nbits : Int
}

fn BitWriter::new() -> BitWriter {
  BitWriter::{ buf: [], acc: 0UL, nbits: 0 }
}

fn BitWriter::with_capacity(cap : Int) -> BitWriter {
  BitWriter::{ buf: Array::with_capacity(cap), acc: 0UL, nbits: 0 }
}

///| Write the lowest `n` bits (`0 <= n <= 32`) of `bits_val` in LSB-first order.
fn BitWriter::write_bits(self : BitWriter, bits_val : Int, n : Int) -> Unit {
  if n <= 0 {
    return
  }
  let mask : UInt64 = (1UL << n) - 1UL
  let v : UInt64 = bits_val.to_int64().to_uint64() & mask
  self.acc = self.acc | (v << self.nbits)
  self.nbits = self.nbits + n
  while self.nbits >= 8 {
    self.buf.push((self.acc & 0xFFUL).to_int().to_byte())
    self.acc = self.acc >> 8
    self.nbits = self.nbits - 8
  }
}

///| Flush remaining bits (zero-padded to byte boundary) and return the encoded `Bytes`.
fn BitWriter::finish(self : BitWriter) -> Bytes {
  if self.nbits > 0 {
    self.buf.push((self.acc & 0xFFUL).to_int().to_byte())
    self.acc = 0UL
    self.nbits = 0
  }
  let buf = self.buf
  let n = buf.length()
  let mut out = Bytes::new(n)
  let mut i = 0
  let n8 = n & -8
  while i < n8 {
    out[i] = buf[i]
    out[i + 1] = buf[i + 1]
    out[i + 2] = buf[i + 2]
    out[i + 3] = buf[i + 3]
    out[i + 4] = buf[i + 4]
    out[i + 5] = buf[i + 5]
    out[i + 6] = buf[i + 6]
    out[i + 7] = buf[i + 7]
    i = i + 8
  }
  while i < n {
    out[i] = buf[i]
    i = i + 1
  }
  out
}

///| Package-Merge optimal length-limited Huffman code length builder (`1 <= len <= max_bits`).
fn vp8l_build_huff_lengths(
  freqs : FixedArray[Int],
  num_syms : Int,
  max_bits : Int,
  out_lengths : FixedArray[Int],
) -> Unit {
  let mut i = 0
  while i < num_syms {
    out_lengths[i] = 0
    i = i + 1
  }
  let syms = FixedArray::make(num_syms, 0)
  let weights = FixedArray::make(num_syms, 0L)
  let mut n = 0
  i = 0
  while i < num_syms {
    if freqs[i] > 0 {
      syms[n] = i
      weights[n] = freqs[i].to_int64()
      n = n + 1
    }
    i = i + 1
  }
  if n == 0 {
    return
  }
  if n == 1 {
    out_lengths[syms[0]] = 1
    return
  }

  // Sort active symbols by (weight asc, sym asc).
  i = 1
  while i < n {
    let kw = weights[i]
    let ks = syms[i]
    let mut j = i - 1
    while j >= 0 && (weights[j] > kw || (weights[j] == kw && syms[j] > ks)) {
      weights[j + 1] = weights[j]
      syms[j + 1] = syms[j]
      j = j - 1
    }
    weights[j + 1] = kw
    syms[j + 1] = ks
    i = i + 1
  }

  let max_items = 2 * n
  let max_nodes = (max_bits + 1) * max_items + 4
  let node_left = FixedArray::make(max_nodes, -1)
  let node_right = FixedArray::make(max_nodes, -1)
  let node_sym = FixedArray::make(max_nodes, -1)
  let mut node_cnt = 0

  let cur_ids = FixedArray::make(max_items, 0)
  let cur_w = FixedArray::make(max_items, 0L)
  let mut cur_len = n
  i = 0
  while i < n {
    let id = node_cnt
    node_cnt = node_cnt + 1
    node_sym[id] = syms[i]
    cur_ids[i] = id
    cur_w[i] = weights[i]
    i = i + 1
  }

  let next_ids = FixedArray::make(max_items, 0)
  let next_w = FixedArray::make(max_items, 0L)

  let mut lvl = 1
  while lvl < max_bits {
    let pkg_cnt = cur_len / 2
    let mut li = 0
    let mut pi = 0
    let mut oi = 0
    let max_out = 2 * n - 2
    while oi < max_out && (li < n || pi < pkg_cnt) {
      let take_leaf = if pi >= pkg_cnt {
        true
      } else if li >= n {
        false
      } else {
        let pw = cur_w[pi * 2] + cur_w[pi * 2 + 1]
        weights[li] <= pw
      }
      if take_leaf {
        let id = node_cnt
        node_cnt = node_cnt + 1
        node_sym[id] = syms[li]
        next_ids[oi] = id
        next_w[oi] = weights[li]
        li = li + 1
      } else {
        let id = node_cnt
        node_cnt = node_cnt + 1
        node_left[id] = cur_ids[pi * 2]
        node_right[id] = cur_ids[pi * 2 + 1]
        next_ids[oi] = id
        next_w[oi] = cur_w[pi * 2] + cur_w[pi * 2 + 1]
        pi = pi + 1
      }
      oi = oi + 1
    }
    let mut k = 0
    while k < oi {
      cur_ids[k] = next_ids[k]
      cur_w[k] = next_w[k]
      k = k + 1
    }
    cur_len = oi
    lvl = lvl + 1
  }

  let stack = FixedArray::make(max_nodes, 0)
  let mut sp = 0
  let take = if 2 * n - 2 < cur_len { 2 * n - 2 } else { cur_len }
  i = 0
  while i < take {
    stack[sp] = cur_ids[i]
    sp = sp + 1
    i = i + 1
  }
  while sp > 0 {
    sp = sp - 1
    let id = stack[sp]
    let s = node_sym[id]
    if s >= 0 {
      out_lengths[s] = out_lengths[s] + 1
    } else {
      stack[sp] = node_left[id]
      sp = sp + 1
      stack[sp] = node_right[id]
      sp = sp + 1
    }
  }
}

///| Compute bit-reversed canonical Huffman codes from `lengths[0..num_syms)`.
fn vp8l_build_canonical_codes(
  lengths : FixedArray[Int],
  num_syms : Int,
  max_bits : Int,
  codes : FixedArray[Int],
) -> Unit {
  let bl_count = FixedArray::make(max_bits + 1, 0)
  let mut i = 0
  while i < num_syms {
    let l = lengths[i]
    if l > 0 {
      bl_count[l] = bl_count[l] + 1
    }
    codes[i] = 0
    i = i + 1
  }
  let next_code = FixedArray::make(max_bits + 1, 0)
  let mut code = 0
  let mut b = 1
  while b <= max_bits {
    code = (code + bl_count[b - 1]) << 1
    next_code[b] = code
    b = b + 1
  }
  i = 0
  while i < num_syms {
    let l = lengths[i]
    if l > 0 {
      let c = next_code[l]
      next_code[l] = c + 1
      codes[i] = reverse_bits_n(c, l)
    }
    i = i + 1
  }
}

///| Build and write a VP8L Huffman tree (Simple 1/2-symbol or Normal RLE), populating `out_lengths` and `out_codes`.
fn vp8l_write_huff_tree(
  bw : BitWriter,
  freqs : FixedArray[Int],
  alphabet_size : Int,
  out_lengths : FixedArray[Int],
  out_codes : FixedArray[Int],
) -> Unit {
  let mut i = 0
  while i < alphabet_size {
    out_lengths[i] = 0
    out_codes[i] = 0
    i = i + 1
  }

  let mut num_used = 0
  let mut s0 = 0
  let mut s1 = 0
  i = 0
  while i < alphabet_size {
    if freqs[i] > 0 {
      if num_used == 0 {
        s0 = i
      } else if num_used == 1 {
        s1 = i
      }
      num_used = num_used + 1
    }
    i = i + 1
  }

  // 0 used symbols -> Simple 1-symbol tree for symbol 0.
  if num_used == 0 {
    bw.write_bits(1, 1) // use_simple = 1
    bw.write_bits(0, 1) // 1 symbol
    bw.write_bits(0, 1) // 1-bit symbol
    bw.write_bits(0, 1) // sym0 = 0
    return
  }

  // 1 used symbol < 256 -> Simple 1-symbol tree (0 bits per occurrence).
  if num_used == 1 && s0 < 256 {
    bw.write_bits(1, 1) // use_simple = 1
    bw.write_bits(0, 1) // 1 symbol
    if s0 <= 1 {
      bw.write_bits(0, 1)
      bw.write_bits(s0, 1)
    } else {
      bw.write_bits(1, 1)
      bw.write_bits(s0, 8)
    }
    return
  }

  // 2 used symbols, both < 256 -> Simple 2-symbol tree (s0 < s1: code 0 -> s0, code 1 -> s1).
  if num_used == 2 && s0 < 256 && s1 < 256 {
    bw.write_bits(1, 1) // use_simple = 1
    bw.write_bits(1, 1) // 2 symbols
    if s0 <= 1 {
      bw.write_bits(0, 1)
      bw.write_bits(s0, 1)
    } else {
      bw.write_bits(1, 1)
      bw.write_bits(s0, 8)
    }
    bw.write_bits(s1, 8)
    out_lengths[s0] = 1
    out_codes[s0] = 0
    out_lengths[s1] = 1
    out_codes[s1] = 1
    return
  }

  // Normal Huffman tree (max 15 bits).
  vp8l_build_huff_lengths(freqs, alphabet_size, 15, out_lengths)
  if num_used > 1 {
    vp8l_build_canonical_codes(out_lengths, alphabet_size, 15, out_codes)
  }

  // RLE-encode `out_lengths[0..alphabet_size)` with codes 0..15, 16, 17, 18.
  let rle_syms = FixedArray::make(alphabet_size, 0)
  let rle_extra = FixedArray::make(alphabet_size, 0)
  let rle_ebits = FixedArray::make(alphabet_size, 0)
  let cl_freqs = FixedArray::make(19, 0)
  let mut rle_len = 0
  let mut prev_cl = 8
  i = 0
  while i < alphabet_size {
    let cl = out_lengths[i]
    let mut run = 1
    while i + run < alphabet_size && out_lengths[i + run] == cl {
      run = run + 1
    }
    if cl == 0 {
      let mut rem = run
      while rem >= 11 {
        let take = if rem > 138 { 138 } else { rem }
        rle_syms[rle_len] = 18
        rle_extra[rle_len] = take - 11
        rle_ebits[rle_len] = 7
        rle_len = rle_len + 1
        cl_freqs[18] = cl_freqs[18] + 1
        rem = rem - take
      }
      if rem >= 3 {
        rle_syms[rle_len] = 17
        rle_extra[rle_len] = rem - 3
        rle_ebits[rle_len] = 3
        rle_len = rle_len + 1
        cl_freqs[17] = cl_freqs[17] + 1
        rem = 0
      }
      while rem > 0 {
        rle_syms[rle_len] = 0
        rle_extra[rle_len] = 0
        rle_ebits[rle_len] = 0
        rle_len = rle_len + 1
        cl_freqs[0] = cl_freqs[0] + 1
        rem = rem - 1
      }
    } else {
      let mut rem = run
      if cl != prev_cl {
        rle_syms[rle_len] = cl
        rle_extra[rle_len] = 0
        rle_ebits[rle_len] = 0
        rle_len = rle_len + 1
        cl_freqs[cl] = cl_freqs[cl] + 1
        prev_cl = cl
        rem = rem - 1
      }
      while rem >= 3 {
        let take = if rem > 6 { 6 } else { rem }
        rle_syms[rle_len] = 16
        rle_extra[rle_len] = take - 3
        rle_ebits[rle_len] = 2
        rle_len = rle_len + 1
        cl_freqs[16] = cl_freqs[16] + 1
        rem = rem - take
      }
      while rem > 0 {
        rle_syms[rle_len] = cl
        rle_extra[rle_len] = 0
        rle_ebits[rle_len] = 0
        rle_len = rle_len + 1
        cl_freqs[cl] = cl_freqs[cl] + 1
        rem = rem - 1
      }
    }
    i = i + run
  }

  let cl_cl = FixedArray::make(19, 0)
  let cl_codes = FixedArray::make(19, 0)
  let mut cl_used = 0
  i = 0
  while i < 19 {
    if cl_freqs[i] > 0 {
      cl_used = cl_used + 1
    }
    i = i + 1
  }
  vp8l_build_huff_lengths(cl_freqs, 19, 7, cl_cl)
  if cl_used > 1 {
    vp8l_build_canonical_codes(cl_cl, 19, 7, cl_codes)
  }

  let mut last_idx = 18
  while last_idx > 3 && cl_cl[vp8l_code_len_order(last_idx)] == 0 {
    last_idx = last_idx - 1
  }
  let n_codes = last_idx + 1

  bw.write_bits(0, 1) // use_simple = 0
  bw.write_bits(n_codes - 4, 4)
  i = 0
  while i < n_codes {
    bw.write_bits(cl_cl[vp8l_code_len_order(i)], 3)
    i = i + 1
  }
  bw.write_bits(0, 1) // use_len = 0 (encode full alphabet via RLE)

  i = 0
  while i < rle_len {
    let s = rle_syms[i]
    if cl_used > 1 {
      bw.write_bits(cl_codes[s], cl_cl[s])
    }
    if rle_ebits[i] > 0 {
      bw.write_bits(rle_extra[i], rle_ebits[i])
    }
    i = i + 1
  }

  // A 1-symbol normal tree decodes as 0-bit single-symbol.
  if num_used == 1 {
    out_lengths[s0] = 0
  }
}
