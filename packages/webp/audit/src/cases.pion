///| Red-team cases for `packages/webp`. Every case returns "" on PASS or a failure reason.
///| `redteam_*` cases assert the behaviour a correct decoder must have and FAIL while a defect exists.
///| `control_*` cases pin attacks / edge cases the decoder already handles (regression guards).
///| The same functions run under `pionc test` (redteam_test.pion / control_test.pion) and, one process per
///| case, under `webp_audit case <name>` in native debug/release and wasm32 debug/release (run_audit.sh), so a
///| panicking case is reported as a crash instead of aborting the whole run.

import "webp"

///|
pub fn rt_err_name(e : webp::WebpError) -> String {
  match e {
    webp::WebpError::UnexpectedEof(_) => "UnexpectedEof"
    webp::WebpError::InvalidContainer(_) => "InvalidContainer"
    webp::WebpError::InvalidHeader(_) => "InvalidHeader"
    webp::WebpError::UnsupportedFeature(_) => "UnsupportedFeature"
    webp::WebpError::InvalidBitstream(_) => "InvalidBitstream"
    webp::WebpError::InvalidHuffman(_) => "InvalidHuffman"
    webp::WebpError::InvalidLz77(_) => "InvalidLz77"
    webp::WebpError::InvalidAlpha(_) => "InvalidAlpha"
    webp::WebpError::LimitExceeded(_) => "LimitExceeded"
  }
}

///| "OK <w>x<h>" or "ERR <Variant>".
pub fn rt_kind(r : Result[webp::WebpImage, webp::WebpError]) -> String {
  match r {
    Ok(img) => "OK " + img.width.to_string() + "x" + img.height.to_string()
    Err(e) => "ERR " + rt_err_name(e)
  }
}

///|
fn rt_is_err(k : String) -> Bool {
  k.length() >= 3 && k.code_unit_at(0) == 69 && k.code_unit_at(1) == 82 && k.code_unit_at(2) == 82
}

///|
fn rt_expect(got : String, want : String, what : String) -> String {
  if got == want {
    ""
  } else {
    what + ": got " + got + ", want " + want
  }
}

///| First non-empty failure of `rs`.
fn rt_first(rs : Array[String]) -> String {
  let mut i = 0
  while i < rs.length() {
    if rs[i] != "" {
      return rs[i]
    }
    i = i + 1
  }
  ""
}

///|
fn rt_expect_err(r : Result[webp::WebpImage, webp::WebpError], what : String) -> String {
  let k = rt_kind(r)
  if rt_is_err(k) {
    ""
  } else {
    what + ": got " + k + ", want ERR"
  }
}

///| Write `code` of length `len` most-significant bit first (canonical prefix code order).
fn rt_put_code(bw : RtBw, code : Int, len : Int) -> Unit {
  let mut i = len - 1
  while i >= 0 {
    bw.put(1, (code >> i) & 1)
    i = i - 1
  }
}

///| RGBA bytes -> "r,g,b,a r,g,b,a ..." (for messages).
fn rt_px(b : Bytes, n : Int) -> String {
  let mut s = ""
  let mut i = 0
  while i < n && 4 * i + 3 < b.length() {
    if i > 0 {
      s = s + " "
    }
    s = s +
    b[4 * i].to_int().to_string() +
    "," +
    b[4 * i + 1].to_int().to_string() +
    "," +
    b[4 * i + 2].to_int().to_string() +
    "," +
    b[4 * i + 3].to_int().to_string()
    i = i + 1
  }
  s
}

///| Deterministic 32-bit LCG.
fn rt_rand(state : Array[Int]) -> Int {
  state[0] = state[0] * 1103515245 + 12345
  (state[0] >> 16) & 0x7FFF
}

// ---------------------------------------------------------------------------------------------
// P0: VP8X canvas smaller than the VP8 frame while an ALPH plane is present.

///| VP8X says 1x1 (alpha), ALPH carries the 1 raw alpha byte, the VP8 frame is 16x16.
///| `decode_with_limits` (decoder.pion:172) decodes the ALPH plane at the VP8X size, then
///| `vp8_decode_internal` (decoder.pion:183) composites it in `vp8_yuv420_to_rgba` (vp8_filter.pion:210/222/242)
///| with the VP8 frame size and only afterwards (decoder.pion:187-189) compares the sizes: `alpha[a_idx]` runs past the
///| 1-byte plane and the process aborts with `pion panic: index out of bounds`. Must be a clean `Err`.
pub fn redteam_p0_alph_plane_smaller_than_vp8_frame_raw() -> String {
  let f = rt_riff([rt_vp8x(0x10, 1, 1), rt_chunk("ALPH", [0, 0x80]), rt_chunk("VP8 ", rt_vp8_16x16())])
  rt_expect_err(webp::decode(f), "VP8X 1x1 + raw ALPH + VP8 16x16")
}

///| Same with a VP8L-compressed ALPH plane (4x4 canvas, 16x16 frame).
pub fn redteam_p0_alph_plane_smaller_than_vp8_frame_vp8l() -> String {
  let alph : Array[Int] = [1]
  rt_push_all(alph, rt_alph_vp8l_solid(0x40))
  let f = rt_riff([rt_vp8x(0x10, 4, 4), rt_chunk("ALPH", alph), rt_chunk("VP8 ", rt_vp8_16x16())])
  rt_expect_err(webp::decode(f), "VP8X 4x4 + VP8L ALPH + VP8 16x16")
}

///| Only the height differs: canvas 16x4 (64 alpha bytes, filter=vertical) vs a 16x16 frame.
pub fn redteam_p0_alph_plane_shorter_than_vp8_frame() -> String {
  let alph : Array[Int] = [2 << 2]
  rt_push_all(alph, rt_fill(64, 3))
  let f = rt_riff([rt_vp8x(0x10, 16, 4), rt_chunk("ALPH", alph), rt_chunk("VP8 ", rt_vp8_16x16())])
  rt_expect_err(webp::decode(f), "VP8X 16x4 + raw ALPH + VP8 16x16")
}

///| Same attack through `decode_with_limits` with tight custom limits: still no panic.
pub fn redteam_p0_alph_plane_smaller_than_vp8_frame_custom_limits() -> String {
  let f = rt_riff([rt_vp8x(0x10, 2, 2), rt_chunk("ALPH", [3 << 2, 1, 2, 3, 4]), rt_chunk("VP8 ", rt_vp8_4x4())])
  let lim = webp::DecodeLimits::new(64, 64, 4096, 16384, 4)
  rt_expect_err(webp::decode_with_limits(f, lim), "VP8X 2x2 + raw ALPH + VP8 4x4, limits 64x64")
}

// ---------------------------------------------------------------------------------------------
// P2: interoperability / RFC 9649 conformance.

///| RFC 9649 3.7.2.1.1 builds the simple code from code lengths: `code_lengths[symbol0] = 1;
///| code_lengths[symbol1] = 1`, then canonical codes, so the SMALLER symbol gets code `0` whatever the
///| order the two symbols were written in (libwebp / dwebp / browsers do exactly this).
///| `HuffTable::build_simple` (vp8l_huffman.pion:115-123) gives code 0 to the symbol read first, as
///| x/image/vp8l's `buildSimple` does, so a stream with (200, 100) decodes with green swapped: the same
///| file shows different pixels in Pion than in libwebp-based viewers (decoder differential).
pub fn redteam_p2_simple_code_descending_symbols_follow_rfc() -> String {
  let f = rt_simple_code_descending_file()
  match webp::decode(f) {
    Err(e) => "decode failed: " + rt_err_name(e)
    Ok(img) => {
      let got = rt_px(img.rgba, 2)
      rt_expect(got, "0,100,0,255 0,200,0,255", "simple code (200,100), bits 0 then 1 (libwebp: green 100 then 200)")
    }
  }
}

///| VP8L 2x1: green = simple code written as (200, 100), pixel bits 0 then 1.
pub fn rt_simple_code_descending_file() -> Bytes {
  let bw = RtBw::new()
  rt_vp8l_header(bw, 2, 1, 1, 0)
  bw.put(1, 0)
  rt_no_cache_no_meta(bw, true)
  rt_simple2(bw, 200, 100) // green: written descending
  rt_simple1(bw, 0) // red
  rt_simple1(bw, 0) // blue
  rt_simple1(bw, 255) // alpha
  rt_simple1(bw, 0) // distance
  bw.put(1, 0) // pixel 0: code 0
  bw.put(1, 1) // pixel 1: code 1
  rt_riff([rt_chunk("VP8L", bw.finish())])
}

///| RFC 9649 2.7.1.3: the ALPH chunk is optional; the VP8X alpha flag only says that some frame *may*
///| carry alpha. libwebp (dwebp, Chrome, Android) decodes VP8X(alpha) + VP8 without ALPH as an opaque
///| image; decoder.pion:180-182 rejects it ("missing ALPH chunk before VP8"), so such files fail to load.
pub fn redteam_p2_alpha_flag_without_alph_chunk_decodes_opaque() -> String {
  let f = rt_riff([rt_vp8x(0x10, 16, 16), rt_chunk("VP8 ", rt_vp8_16x16())])
  match webp::decode(f) {
    Err(e) => "VP8X(alpha flag) + VP8 without ALPH rejected with " + rt_err_name(e) + " (libwebp decodes it, alpha = 255)"
    Ok(img) => {
      let mut i = 0
      while i < 256 {
        if img.rgba[4 * i + 3].to_int() != 255 {
          return "pixel " + i.to_string() + " alpha " + img.rgba[4 * i + 3].to_int().to_string() + ", want 255"
        }
        i = i + 1
      }
      ""
    }
  }
}

// ---------------------------------------------------------------------------------------------
// Controls: RIFF / VP8X / ALPH container.

///|
pub fn control_riff_container_edges() -> String {
  let good = rt_vp8l_solid(3, 2, 255, 1, 2, 3)
  let ok_file = rt_riff([rt_chunk("VP8L", good)])
  let rs : Array[String] = []
  rs.push(rt_expect(rt_kind(webp::decode(ok_file)), "OK 3x2", "baseline VP8L"))
  rs.push(rt_expect_err(webp::decode(rt_bytes([])), "empty input"))
  rs.push(rt_expect_err(webp::decode(rt_bytes([0x52, 0x49, 0x46, 0x46, 4, 0, 0, 0, 0x57, 0x45, 0x42])), "11 bytes"))
  // bad magic / form type
  let bad1 : Array[Int] = []
  let mut i = 0
  while i < ok_file.length() {
    bad1.push(ok_file[i].to_int())
    i = i + 1
  }
  bad1[0] = 0x58
  rs.push(rt_expect(rt_kind(webp::decode(rt_bytes(bad1))), "ERR InvalidContainer", "RIFX magic"))
  bad1[0] = 0x52
  bad1[8] = 0x41
  rs.push(rt_expect(rt_kind(webp::decode(rt_bytes(bad1))), "ERR InvalidContainer", "AVI form type"))
  bad1[8] = 0x57
  // RIFF size 0..3 (smaller than the form type)
  bad1[4] = 3
  bad1[5] = 0
  rs.push(rt_expect(rt_kind(webp::decode(rt_bytes(bad1))), "ERR InvalidContainer", "RIFF size 3"))
  // RIFF size 0xFFFFFFFF (larger than the file) -> clamp to file length, still decodes
  bad1[4] = 0xFF
  bad1[5] = 0xFF
  bad1[6] = 0xFF
  bad1[7] = 0xFF
  rs.push(rt_expect(rt_kind(webp::decode(rt_bytes(bad1))), "OK 3x2", "RIFF size 0xFFFFFFFF"))
  // RIFF size cutting the image chunk -> chunk truncated
  bad1[4] = 12
  bad1[5] = 0
  bad1[6] = 0
  bad1[7] = 0
  rs.push(rt_expect_err(webp::decode(rt_bytes(bad1)), "RIFF size cuts VP8L chunk"))
  // chunk size larger than the rest of the file, and 0xFFFFFFFF
  let c1 : Array[Int] = []
  rt_push_all(c1, rt_chunk("VP8L", good))
  // one byte past the (padded) end of the file
  c1[4] = (good.length() + 1 + (good.length() & 1)) & 0xFF
  rs.push(rt_expect_err(webp::decode(rt_riff([c1])), "chunk size past end of file"))
  c1[4] = 0xFF
  c1[5] = 0xFF
  c1[6] = 0xFF
  c1[7] = 0xFF
  rs.push(rt_expect_err(webp::decode(rt_riff([c1])), "chunk size 0xFFFFFFFF"))
  // odd metadata chunks with padding, unknown chunks, then the image
  let meta = rt_riff([
    rt_chunk("ZZZZ", [1, 2, 3]),
    rt_chunk("ICCP", [9]),
    rt_chunk("EXIF", [1, 2, 3, 4, 5]),
    rt_chunk("XMP ", [7]),
    rt_chunk("VP8L", good),
  ])
  rs.push(rt_expect(rt_kind(webp::decode(meta)), "OK 3x2", "odd-sized metadata/unknown chunks before VP8L"))
  // no image chunk at all
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_chunk("ICCP", [1])]))), "ERR InvalidContainer", "no image chunk"))
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([]))), "ERR InvalidContainer", "RIFF with only WEBP"))
  // 4096 empty unknown chunks before the image (chunk-count bomb, linear)
  let many : Array[Array[Int]] = []
  i = 0
  while i < 4096 {
    many.push(rt_chunk("JUNK", []))
    i = i + 1
  }
  many.push(rt_chunk("VP8L", good))
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff(many))), "OK 3x2", "4096 empty chunks"))
  rt_first(rs)
}

///|
pub fn control_vp8x_edges() -> String {
  let good = rt_vp8l_solid(3, 2, 255, 1, 2, 3)
  let rs : Array[String] = []
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_vp8x(0x10, 3, 2), rt_chunk("VP8L", good)]))), "OK 3x2", "VP8X + VP8L"))
  // VP8X canvas vs VP8L header mismatch (both directions)
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_vp8x(0, 30, 2), rt_chunk("VP8L", good)]))), "ERR InvalidHeader", "VP8X 30x2 vs VP8L 3x2"))
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_vp8x(0, 1, 1), rt_chunk("VP8L", rt_vp8l_solid(100, 100, 255, 0, 0, 0))]))), "ERR InvalidHeader", "VP8X 1x1 vs VP8L 100x100"))
  // VP8X canvas vs VP8 frame mismatch without ALPH
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_vp8x(0, 10, 10), rt_chunk("VP8 ", rt_vp8_16x16())]))), "ERR InvalidHeader", "VP8X 10x10 vs VP8 16x16"))
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_vp8x(0, 100, 100), rt_chunk("VP8 ", rt_vp8_16x16())]))), "ERR InvalidHeader", "VP8X 100x100 vs VP8 16x16"))
  // canvas LARGER than the VP8 frame with ALPH (alpha plane bigger than needed): clean error
  let big_alph : Array[Int] = [0]
  rt_push_all(big_alph, rt_fill(32 * 32, 9))
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_vp8x(0x10, 32, 32), rt_chunk("ALPH", big_alph), rt_chunk("VP8 ", rt_vp8_16x16())]))), "ERR InvalidHeader", "VP8X 32x32 + ALPH vs VP8 16x16"))
  // duplicate VP8X, wrong VP8X size
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_vp8x(0, 3, 2), rt_vp8x(0, 3, 2), rt_chunk("VP8L", good)])), "duplicate VP8X"))
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_chunk("VP8X", [0, 0, 0, 0, 2, 0, 0, 1, 0]), rt_chunk("VP8L", good)])), "9-byte VP8X"))
  // VP8X canvas bombs: 2^24 x 2^24 and 16384 x 16384 are rejected before any allocation
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_vp8x(0x10, 16777216, 16777216), rt_chunk("ALPH", [0])]))), "ERR LimitExceeded", "VP8X 16777216^2"))
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_vp8x(0x10, 16384, 16384), rt_chunk("ALPH", [0])]))), "ERR LimitExceeded", "VP8X 16384^2"))
  // animation flag / ANMF only: no still image -> error, not a hang
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_vp8x(0x02, 3, 2), rt_chunk("ANIM", [0, 0, 0, 0, 0, 0]), rt_chunk("ANMF", rt_fill(16, 0))])), "animated VP8X without still image"))
  // ALPH without the VP8X alpha flag, ALPH without VP8X, ALPH + VP8L, second ALPH
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_vp8x(0, 4, 4), rt_chunk("ALPH", [0, 1]), rt_chunk("VP8 ", rt_vp8_4x4())])), "ALPH without alpha flag"))
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_chunk("ALPH", [0, 1]), rt_chunk("VP8 ", rt_vp8_4x4())])), "ALPH without VP8X"))
  let a16 : Array[Int] = [0]
  rt_push_all(a16, rt_fill(6, 7))
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_vp8x(0x10, 3, 2), rt_chunk("ALPH", a16), rt_chunk("VP8L", good)])), "ALPH + VP8L"))
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_vp8x(0x10, 3, 2), rt_chunk("ALPH", a16), rt_chunk("ALPH", a16), rt_chunk("VP8L", good)])), "two ALPH"))
  rt_first(rs)
}

///| Forward ALPH filter (RFC 9649 2.7.1.3) used to build expected inputs independently of the decoder.
fn rt_alpha_forward(a : Array[Int], w : Int, h : Int, filter : Int) -> Array[Int] {
  let out : Array[Int] = []
  let mut y = 0
  while y < h {
    let mut x = 0
    while x < w {
      let mut pred = 0
      if filter == 0 || (x == 0 && y == 0) {
        pred = 0
      } else if y == 0 {
        pred = a[x - 1]
      } else if x == 0 {
        pred = a[(y - 1) * w]
      } else if filter == 1 {
        pred = a[y * w + x - 1]
      } else if filter == 2 {
        pred = a[(y - 1) * w + x]
      } else {
        pred = a[y * w + x - 1] + a[(y - 1) * w + x] - a[(y - 1) * w + x - 1]
        if pred < 0 {
          pred = 0
        } else if pred > 255 {
          pred = 255
        }
      }
      out.push((a[y * w + x] - pred) & 0xFF)
      x = x + 1
    }
    y = y + 1
  }
  out
}

///| Raw ALPH, all 4 filters x odd sizes: decoded alpha must equal the source plane exactly.
pub fn control_alph_raw_filters_odd_sizes() -> String {
  let sizes = [1, 1, 3, 5, 17, 13, 15, 17, 16, 1, 1, 16]
  let st = [7]
  let mut si = 0
  while si < sizes.length() {
    let w = sizes[si]
    let h = sizes[si + 1]
    let src : Array[Int] = []
    let mut i = 0
    while i < w * h {
      src.push(rt_rand(st) & 0xFF)
      i = i + 1
    }
    // a VP8 frame of the same size: reuse the 16x16 / 4x4 samples only when sizes match, else build a
    // DC-only frame of the exact size through the VP8L path is impossible, so use VP8L-free check: the
    // alpha plane is composited onto the lossy frame and only the A channel is compared.
    let mut f = 0
    while f < 4 {
      let payload : Array[Int] = [f << 2]
      rt_push_all(payload, rt_alpha_forward(src, w, h, f))
      let vp8 = rt_vp8_solid_frame(w, h)
      let file = rt_riff([rt_vp8x(0x10, w, h), rt_chunk("ALPH", payload), rt_chunk("VP8 ", vp8)])
      match webp::decode(file) {
        Err(e) => return w.to_string() + "x" + h.to_string() + " filter " + f.to_string() + ": " + rt_err_name(e)
        Ok(img) => {
          i = 0
          while i < w * h {
            if img.rgba[4 * i + 3].to_int() != src[i] {
              return w.to_string() + "x" + h.to_string() + " filter " + f.to_string() + " pixel " + i.to_string() +
              ": alpha " + img.rgba[4 * i + 3].to_int().to_string() + ", want " + src[i].to_string()
            }
            i = i + 1
          }
        }
      }
      f = f + 1
    }
    si = si + 2
  }
  ""
}

///| ALPH header edge cases: compression 2/3 rejected, truncated raw payload rejected, VP8L payload decodes.
pub fn control_alph_header_edges() -> String {
  let rs : Array[String] = []
  let vp8 = rt_vp8_4x4()
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_vp8x(0x10, 4, 4), rt_chunk("ALPH", []), rt_chunk("VP8 ", vp8)])), "empty ALPH"))
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_vp8x(0x10, 4, 4), rt_chunk("ALPH", [2, 1, 2]), rt_chunk("VP8 ", vp8)])), "ALPH compression 2"))
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_vp8x(0x10, 4, 4), rt_chunk("ALPH", [3]), rt_chunk("VP8 ", vp8)])), "ALPH compression 3"))
  let short : Array[Int] = [0]
  rt_push_all(short, rt_fill(15, 1))
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_vp8x(0x10, 4, 4), rt_chunk("ALPH", short), rt_chunk("VP8 ", vp8)])), "raw ALPH 15/16 bytes"))
  let comp : Array[Int] = [1]
  rt_push_all(comp, rt_alph_vp8l_solid(0x42))
  match webp::decode(rt_riff([rt_vp8x(0x10, 4, 4), rt_chunk("ALPH", comp), rt_chunk("VP8 ", vp8)])) {
    Err(e) => rs.push("VP8L ALPH: " + rt_err_name(e))
    Ok(img) => rs.push(rt_expect(img.rgba[3].to_int().to_string() + "/" + img.rgba[63].to_int().to_string(), "66/66", "VP8L ALPH alpha"))
  }
  // truncated VP8L ALPH payload
  rs.push(rt_expect_err(webp::decode(rt_riff([rt_vp8x(0x10, 4, 4), rt_chunk("ALPH", [1, 0]), rt_chunk("VP8 ", vp8)])), "truncated VP8L ALPH"))
  rt_first(rs)
}

///| A syntactically minimal VP8 keyframe of `w x h`: all-zero first partition (DC prediction, no
///| coefficients thanks to the decoder's EOF-as-zero semantics is NOT relied upon: the partition is
///| long enough), one empty token partition.
pub fn rt_vp8_solid_frame(w : Int, h : Int) -> Array[Int] {
  let mbs = ((w + 15) / 16) * ((h + 15) / 16)
  // first partition: zero bytes decode as "0" decisions with any probability; long enough for
  // header (~ 1100 decisions) + per-MB modes, so no EOF.
  let fp = rt_fill(400 + 8 * mbs, 0)
  let tok = rt_fill(64 + 64 * mbs, 0)
  let body : Array[Int] = []
  rt_push_all(body, fp)
  rt_push_all(body, tok)
  let out = rt_vp8_frame(w, h, 0, 1, [])
  // patch first-partition length into the frame tag
  let tag = (fp.length() << 5) | (1 << 4)
  out[0] = tag & 0xFF
  out[1] = (tag >> 8) & 0xFF
  out[2] = (tag >> 16) & 0xFF
  rt_push_all(out, body)
  out
}

// ---------------------------------------------------------------------------------------------
// Controls: VP8L Huffman / LZ77 / color cache / transforms.

///| VP8L 2x1 whose green code is `code` (written by `emit`), other codes single symbols, then `pixels`.
fn rt_vp8l_green_code(code : (RtBw) -> Unit, pixels : (RtBw) -> Unit, w : Int) -> Bytes {
  let bw = RtBw::new()
  rt_vp8l_header(bw, w, 1, 1, 0)
  bw.put(1, 0)
  rt_no_cache_no_meta(bw, true)
  code(bw)
  rt_simple1(bw, 0)
  rt_simple1(bw, 0)
  rt_simple1(bw, 255)
  rt_simple1(bw, 0)
  pixels(bw)
  rt_riff([rt_chunk("VP8L", bw.finish())])
}

///|
pub fn control_vp8l_huffman_edges() -> String {
  let rs : Array[String] = []
  let nopix = fn(bw : RtBw) -> Unit { bw.put(8, 0) }
  // empty code (all code lengths 0)
  rs.push(rt_expect(rt_kind(webp::decode(rt_vp8l_green_code(fn(bw : RtBw) -> Unit { rt_flat_code(bw, 0, 280) }, nopix, 2))), "ERR InvalidHuffman", "all-zero code lengths"))
  // over-subscribed: 3 symbols of length 1
  rs.push(rt_expect(rt_kind(webp::decode(rt_vp8l_green_code(fn(bw : RtBw) -> Unit { rt_flat_code(bw, 1, 3) }, nopix, 2))), "ERR InvalidHuffman", "3 x length-1 codes"))
  // over-subscribed at length 15: 32769 > 2^15 is impossible in a 280 alphabet; 281 x length 8 > 256
  rs.push(rt_expect(rt_kind(webp::decode(rt_vp8l_green_code(fn(bw : RtBw) -> Unit { rt_flat_code(bw, 8, 280) }, nopix, 2))), "ERR InvalidHuffman", "280 x length-8 codes"))
  // max_symbol > alphabet size
  rs.push(rt_expect(rt_kind(webp::decode(rt_vp8l_green_code(fn(bw : RtBw) -> Unit { rt_flat_code(bw, 9, 281) }, nopix, 2))), "ERR InvalidHuffman", "max_symbol 281 > 280"))
  // complete flat code: 256 literals of length 8 -> green is the raw byte (MSB-first canonical code)
  let px = fn(bw : RtBw) -> Unit {
    rt_put_code(bw, 0xA5, 8)
    rt_put_code(bw, 0x01, 8)
    rt_put_code(bw, 0xFF, 8)
  }
  match webp::decode(rt_vp8l_green_code(fn(bw : RtBw) -> Unit { rt_flat_code(bw, 8, 256) }, px, 3)) {
    Err(e) => rs.push("flat length-8 code: " + rt_err_name(e))
    Ok(img) => rs.push(rt_expect(rt_px(img.rgba, 3), "0,165,0,255 0,1,0,255 0,255,0,255", "flat length-8 code"))
  }
  // RLE: code 18 repeating zeros past the alphabet; code 16 before any non-zero (repeats 8)
  let rle_over = fn(bw : RtBw) -> Unit {
    bw.put(1, 0)
    // code-length code: symbols 18 (len 1) and 0 (len 1): order 17,18,0 -> 0,1,1, rest 0 (n = 4)
    bw.put(4, 0)
    bw.put(3, 0)
    bw.put(3, 1)
    bw.put(3, 1)
    bw.put(3, 0)
    bw.put(1, 0) // max_symbol = alphabet
    // canonical: symbol 0 -> code 0, symbol 18 -> code 1; emit 18 with extra 127 (138 zeros) x 3 = 414 > 280
    bw.put(1, 1)
    bw.put(7, 127)
    bw.put(1, 1)
    bw.put(7, 127)
    bw.put(1, 1)
    bw.put(7, 127)
  }
  rs.push(rt_expect(rt_kind(webp::decode(rt_vp8l_green_code(rle_over, nopix, 2))), "ERR InvalidHuffman", "RLE 18 past alphabet"))
  // simple code symbol >= alphabet (distance alphabet 40)
  let bw = RtBw::new()
  rt_vp8l_header(bw, 1, 1, 1, 0)
  bw.put(1, 0)
  rt_no_cache_no_meta(bw, true)
  rt_simple1(bw, 1)
  rt_simple1(bw, 0)
  rt_simple1(bw, 0)
  rt_simple1(bw, 0)
  rt_simple1(bw, 40)
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_chunk("VP8L", bw.finish())]))), "ERR InvalidHuffman", "distance symbol 40"))
  rt_first(rs)
}

///| LZ77 probe: green = normal code {literal 7, length symbol 256 + len_sym}, distance = single symbol
///| `dsym`; `n_lit` literals, one backward reference, then literals.
fn rt_vp8l_lz(w : Int, h : Int, len_sym : Int, len_extra_bits : Int, len_extra : Int, dsym : Int, d_extra_bits : Int, d_extra : Int, n_lit : Int) -> Bytes {
  let bw = RtBw::new()
  rt_vp8l_header(bw, w, h, 1, 0)
  bw.put(1, 0)
  rt_no_cache_no_meta(bw, true)
  // green: normal code with exactly two symbols of length 1: literal 7 and 256 + len_sym.
  // code-length code: symbols 0 and 1 with length 1 each (order 17,18,0,1 -> 0,0,1,1)
  bw.put(1, 0)
  bw.put(4, 0)
  bw.put(3, 0)
  bw.put(3, 0)
  bw.put(3, 1)
  bw.put(3, 1)
  bw.put(1, 0)
  // canonical over {0,1}: 0 -> code 0, 1 -> code 1. Emit 280 tokens.
  let mut s = 0
  while s < 280 {
    bw.put(1, if s == 7 || s == 256 + len_sym { 1 } else { 0 })
    s = s + 1
  }
  rt_simple1(bw, 0)
  rt_simple1(bw, 0)
  rt_simple1(bw, 255)
  rt_simple1(bw, dsym)
  // pixels: green symbol 7 = code 0, length symbol = code 1
  let mut i = 0
  while i < n_lit {
    bw.put(1, 0)
    i = i + 1
  }
  bw.put(1, 1)
  bw.put(len_extra_bits, len_extra)
  bw.put(d_extra_bits, d_extra)
  // fill the rest with literals
  i = 0
  while i < w * h {
    bw.put(1, 0)
    i = i + 1
  }
  rt_riff([rt_chunk("VP8L", bw.finish())])
}

///|
pub fn control_vp8l_lz77_edges() -> String {
  let rs : Array[String] = []
  // dist (plane code 1 -> 0x18 -> (y 1, x 0) -> w) at position 1 of a 4x4: dist 4 > pos 1
  rs.push(rt_expect(rt_kind(webp::decode(rt_vp8l_lz(4, 4, 0, 0, 0, 0, 0, 0, 1))), "ERR InvalidLz77", "dist > pos"))
  // plane code 121 (sym 13: extra 5 bits, (3<<5)+e+1 = 121 at e=24) -> dist 1; length 1 after 1 literal: OK
  rs.push(rt_expect(rt_kind(webp::decode(rt_vp8l_lz(4, 4, 0, 0, 0, 13, 5, 24, 1))), "OK 4x4", "dist 1 copy"))
  // length 4096 (sym 23, extra 10 bits = 1023) on a 4x4 = 16 px image: pos + len > w*h
  rs.push(rt_expect(rt_kind(webp::decode(rt_vp8l_lz(4, 4, 23, 10, 1023, 13, 5, 24, 1))), "ERR InvalidLz77", "len past end"))
  // largest distance code (sym 39, 18 extra bits): dist ~1M > pos
  rs.push(rt_expect(rt_kind(webp::decode(rt_vp8l_lz(4, 4, 0, 0, 0, 39, 18, 262143, 1))), "ERR InvalidLz77", "dist code 39"))
  // copy that ends exactly at the last pixel
  rs.push(rt_expect(rt_kind(webp::decode(rt_vp8l_lz(4, 4, 13, 5, 30, 13, 5, 24, 1))), "ERR InvalidLz77", "len 127 > 15 remaining"))
  rt_first(rs)
}

///| Color cache: bits 0 and 12 rejected; a cache hit returns the inserted colour.
pub fn control_vp8l_color_cache_edges() -> String {
  let rs : Array[String] = []
  let mut bits = 0
  while bits <= 15 {
    let bw = RtBw::new()
    rt_vp8l_header(bw, 1, 1, 1, 0)
    bw.put(1, 0)
    bw.put(1, 1)
    bw.put(4, bits)
    bw.put(1, 0)
    rt_simple1(bw, 9)
    rt_simple1(bw, 0)
    rt_simple1(bw, 0)
    rt_simple1(bw, 255)
    rt_simple1(bw, 0)
    let k = rt_kind(webp::decode(rt_riff([rt_chunk("VP8L", bw.finish())])))
    let want = if bits >= 1 && bits <= 11 { "OK 1x1" } else { "ERR InvalidBitstream" }
    rs.push(rt_expect(k, want, "color cache bits " + bits.to_string()))
    bits = bits + 1
  }
  // cache index with no cache -> green symbol 280 is outside the 280-symbol alphabet -> simple code rejects
  rt_first(rs)
}

///| ColorIndexing with 2/3/4/5/16/17 colours on widths 1,3,5,7,9,17 (bit packing with partial last byte).
pub fn control_vp8l_color_indexing_widths() -> String {
  let ncols = [2, 3, 4, 5, 16, 17]
  let widths = [1, 3, 5, 7, 9, 17]
  let st = [99]
  let mut ci = 0
  while ci < ncols.length() {
    let n = ncols[ci]
    let bits = if n <= 2 { 3 } else if n <= 4 { 2 } else if n <= 16 { 1 } else { 0 }
    let mut wi = 0
    while wi < widths.length() {
      let w = widths[wi]
      let h = 2
      let pal : Array[Int] = []
      let mut i = 0
      while i < 4 * n {
        pal.push(rt_rand(st) & 0xFF)
        i = i + 1
      }
      let idx : Array[Int] = []
      i = 0
      while i < w * h {
        idx.push(rt_rand(st) % n)
        i = i + 1
      }
      let bw = RtBw::new()
      rt_vp8l_header(bw, w, h, 1, 0)
      bw.put(1, 1)
      bw.put(2, 3)
      bw.put(8, n - 1)
      // palette sub-image n x 1, delta coded; each channel through a flat length-8 code (raw byte)
      rt_no_cache_no_meta(bw, false)
      rt_flat_code(bw, 8, 256)
      rt_flat_code(bw, 8, 256)
      rt_flat_code(bw, 8, 256)
      rt_flat_code(bw, 8, 256)
      rt_simple1(bw, 0)
      i = 0
      while i < n {
        let mut c = 0
        while c < 4 {
          // order in the stream: green, red, blue, alpha; pal is stored as r,g,b,a
          let ch = if c == 0 { 1 } else if c == 1 { 0 } else { c }
          let prev = if i == 0 { 0 } else { pal[4 * (i - 1) + ch] }
          rt_put_code(bw, (pal[4 * i + ch] - prev) & 0xFF, 8)
          c = c + 1
        }
        i = i + 1
      }
      bw.put(1, 0) // no more transforms
      rt_no_cache_no_meta(bw, true)
      rt_flat_code(bw, 8, 256)
      rt_simple1(bw, 0)
      rt_simple1(bw, 0)
      rt_simple1(bw, 0)
      rt_simple1(bw, 0)
      let per = 1 << bits
      let pw = (w + per - 1) / per
      let mut y = 0
      while y < h {
        let mut px = 0
        while px < pw {
          let mut v = 0
          let mut k = 0
          while k < per {
            let x = px * per + k
            if x < w {
              v = v | (idx[y * w + x] << (k * (8 >> bits)))
            }
            k = k + 1
          }
          rt_put_code(bw, v & 0xFF, 8)
          px = px + 1
        }
        y = y + 1
      }
      match webp::decode(rt_riff([rt_chunk("VP8L", bw.finish())])) {
        Err(e) => return n.to_string() + " colours, width " + w.to_string() + ": " + rt_err_name(e)
        Ok(img) => {
          i = 0
          while i < w * h {
            let mut c = 0
            while c < 4 {
              if img.rgba[4 * i + c].to_int() != pal[4 * idx[i] + c] {
                return n.to_string() + " colours, width " + w.to_string() + ", pixel " + i.to_string() + " channel " +
                c.to_string() + ": " + img.rgba[4 * i + c].to_int().to_string() + " want " + pal[4 * idx[i] + c].to_string()
              }
              c = c + 1
            }
            i = i + 1
          }
        }
      }
      wi = wi + 1
    }
    ci = ci + 1
  }
  ""
}

///| Duplicate transforms are rejected; `max_transform_depth` is enforced at every boundary.
pub fn control_vp8l_transform_limits() -> String {
  let rs : Array[String] = []
  let mk = fn(kinds : Array[Int]) -> Bytes {
    let bw = RtBw::new()
    rt_vp8l_header(bw, 2, 2, 1, 0)
    let mut i = 0
    while i < kinds.length() {
      bw.put(1, 1)
      bw.put(2, kinds[i])
      if kinds[i] == 0 || kinds[i] == 1 {
        bw.put(3, 0)
        rt_no_cache_no_meta(bw, false)
        rt_simple1(bw, 1)
        rt_simple1(bw, 0)
        rt_simple1(bw, 0)
        rt_simple1(bw, 0)
        rt_simple1(bw, 0)
      } else if kinds[i] == 3 {
        bw.put(8, 0)
        rt_no_cache_no_meta(bw, false)
        rt_simple1(bw, 5)
        rt_simple1(bw, 6)
        rt_simple1(bw, 7)
        rt_simple1(bw, 255)
        rt_simple1(bw, 0)
      }
      i = i + 1
    }
    bw.put(1, 0)
    rt_no_cache_no_meta(bw, true)
    rt_simple1(bw, 0)
    rt_simple1(bw, 0)
    rt_simple1(bw, 0)
    rt_simple1(bw, 0)
    rt_simple1(bw, 0)
    rt_riff([rt_chunk("VP8L", bw.finish())])
  }
  rs.push(rt_expect(rt_kind(webp::decode(mk([2, 2]))), "ERR InvalidBitstream", "SubtractGreen twice"))
  rs.push(rt_expect(rt_kind(webp::decode(mk([0, 1, 0]))), "ERR InvalidBitstream", "Predictor twice"))
  rs.push(rt_expect(rt_kind(webp::decode(mk([3, 3]))), "ERR InvalidBitstream", "ColorIndexing twice"))
  rs.push(rt_expect(rt_kind(webp::decode(mk([0, 1, 2, 3]))), "OK 2x2", "all four transforms"))
  rs.push(rt_expect_err(webp::decode(mk([0, 1, 2, 3, 0])), "five transforms"))
  let lim = fn(d : Int) -> webp::DecodeLimits {
    let x = webp::DecodeLimits::default()
    webp::DecodeLimits::new(x.max_width, x.max_height, x.max_pixels, x.max_output_bytes, d)
  }
  rs.push(rt_expect(rt_kind(webp::decode_with_limits(mk([0, 1, 2]), lim(3))), "OK 2x2", "3 transforms, depth 3"))
  rs.push(rt_expect(rt_kind(webp::decode_with_limits(mk([0, 1, 2]), lim(2))), "ERR LimitExceeded", "3 transforms, depth 2"))
  rs.push(rt_expect(rt_kind(webp::decode_with_limits(mk([]), lim(0))), "OK 2x2", "0 transforms, depth 0"))
  rs.push(rt_expect(rt_kind(webp::decode_with_limits(mk([2]), lim(0))), "ERR LimitExceeded", "1 transform, depth 0"))
  rs.push(rt_expect(rt_kind(webp::decode_with_limits(mk([2]), lim(-5))), "ERR LimitExceeded", "1 transform, depth -5"))
  // all 4 transforms on the solid image: SubtractGreen etc. must give the palette colour (5,6,7)->(r,g,b)
  rt_first(rs)
}

///| `DecodeLimits` boundaries (+-1) on width, height, pixels, output bytes; zero / negative limits.
pub fn control_decode_limits_boundaries() -> String {
  let rs : Array[String] = []
  let f = rt_riff([rt_chunk("VP8L", rt_vp8l_solid(100, 50, 255, 1, 2, 3))])
  let d = webp::DecodeLimits::default()
  let k = fn(mw : Int, mh : Int, mp : Int, mo : Int) -> String {
    rt_kind(webp::decode_with_limits(f, webp::DecodeLimits::new(mw, mh, mp, mo, d.max_transform_depth)))
  }
  rs.push(rt_expect(k(100, 50, 5000, 20000), "OK 100x50", "exact limits"))
  rs.push(rt_expect(k(99, 50, 5000, 20000), "ERR LimitExceeded", "max_width - 1"))
  rs.push(rt_expect(k(100, 49, 5000, 20000), "ERR LimitExceeded", "max_height - 1"))
  rs.push(rt_expect(k(100, 50, 4999, 20000), "ERR LimitExceeded", "max_pixels - 1"))
  rs.push(rt_expect(k(100, 50, 5000, 19999), "ERR LimitExceeded", "max_output_bytes - 1"))
  rs.push(rt_expect(k(0, 0, 0, 0), "ERR LimitExceeded", "zero limits"))
  rs.push(rt_expect(k(-1, -1, -1, -1), "ERR LimitExceeded", "negative limits"))
  rs.push(rt_expect(k(2147483647, 2147483647, 2147483647, 2147483647), "OK 100x50", "Int max limits"))
  // VP8L 14-bit maximum 16384 x 16384 (268M px) under default limits: rejected before allocation
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_chunk("VP8L", rt_vp8l_solid(16384, 16384, 255, 0, 0, 0))]))), "ERR LimitExceeded", "VP8L 16384^2"))
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_chunk("VP8L", rt_vp8l_solid(16383, 16383, 255, 0, 0, 0))]))), "ERR LimitExceeded", "VP8L 16383^2"))
  // VP8 14-bit maximum
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_chunk("VP8 ", rt_vp8_frame(16383, 16383, 0, 1, rt_fill(32, 0)))]))), "ERR LimitExceeded", "VP8 16383^2"))
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_chunk("VP8 ", rt_vp8_frame(0, 16, 0, 1, rt_fill(32, 0)))]))), "ERR InvalidHeader", "VP8 width 0"))
  rt_first(rs)
}

// ---------------------------------------------------------------------------------------------
// Controls: VP8 frame header / partitions / boolean decoder truncation.

///|
pub fn control_vp8_header_edges() -> String {
  let rs : Array[String] = []
  let good = rt_vp8_16x16()
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_chunk("VP8 ", good)]))), "OK 16x16", "baseline VP8"))
  // interframe
  let inter : Array[Int] = []
  rt_push_all(inter, good)
  inter[0] = inter[0] | 1
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_chunk("VP8 ", inter)]))), "ERR UnsupportedFeature", "interframe"))
  // bad start code
  let sync : Array[Int] = []
  rt_push_all(sync, good)
  sync[4] = 0x02
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_chunk("VP8 ", sync)]))), "ERR InvalidHeader", "bad start code"))
  // first partition longer than the chunk
  let fp : Array[Int] = []
  rt_push_all(fp, good)
  fp[1] = 0xFF
  fp[2] = 0xFF
  rs.push(rt_expect(rt_kind(webp::decode(rt_riff([rt_chunk("VP8 ", fp)]))), "ERR UnexpectedEof", "first partition > chunk"))
  // every truncation of the payload: error, never a crash or hang
  let mut n = 0
  while n < good.length() - 2 {
    let t : Array[Int] = []
    let mut i = 0
    while i < n {
      t.push(good[i])
      i = i + 1
    }
    let r = rt_kind(webp::decode(rt_riff([rt_chunk("VP8 ", t)])))
    if !rt_is_err(r) {
      rs.push("VP8 truncated to " + n.to_string() + " bytes: " + r)
    }
    n = n + 1
  }
  rt_first(rs)
}

///| Every truncation and every single-bit flip of `f`: `decode` must return (any verdict), never abort.
fn rt_sweep(f : Bytes) -> Unit {
  let mut n = 0
  while n < f.length() {
    let t = Bytes::new(n)
    let mut i = 0
    while i < n {
      t[i] = f[i]
      i = i + 1
    }
    let _ = webp::decode(t)
    n = n + 1
  }
  let mut bit = 0
  while bit < 8 * f.length() {
    let t = Bytes::new(f.length())
    let mut i = 0
    while i < f.length() {
      t[i] = f[i]
      i = i + 1
    }
    t[bit / 8] = (t[bit / 8].to_int() ^ (1 << (bit % 8))).to_byte()
    let _ = webp::decode(t)
    bit = bit + 1
  }
}

///| Truncation / single-bit-flip sweep of a VP8L file and of a plain VP8 file: no abort.
pub fn control_bitflip_truncation_sweep() -> String {
  rt_sweep(rt_riff([rt_chunk("VP8L", rt_vp8l_solid(5, 3, 200, 1, 2, 3))]))
  rt_sweep(rt_riff([rt_chunk("VP8 ", rt_vp8_4x4())]))
  ""
}

///| The same sweep over a 4x4 VP8X + VP8L-ALPH + VP8 file. Ten of its 552 single-bit flips abort the
///| process (`pion panic: index 12 out of bounds (len 12)` etc.): flips in the VP8X canvas width/height
///| (bits 192/193/216/217) or in the VP8 frame width/height (bits 496..515) make the frame larger than the
///| alpha plane, i.e. the P0 above is reachable from ordinary corruption of a valid file.
pub fn redteam_p0_bitflip_sweep_vp8x_alph_no_abort() -> String {
  let alph : Array[Int] = [1]
  rt_push_all(alph, rt_alph_vp8l_solid(0x40))
  rt_sweep(rt_riff([rt_vp8x(0x10, 4, 4), rt_chunk("ALPH", alph), rt_chunk("VP8 ", rt_vp8_4x4())]))
  ""
}

///| `probe_header` agrees with `decode` on format and size, and never decodes pixels.
pub fn control_probe_header() -> String {
  let rs : Array[String] = []
  match webp::probe_header(rt_riff([rt_vp8x(0x3E, 16777216, 7), rt_chunk("ALPH", [0])])) {
    Err(e) => rs.push("probe VP8X: " + rt_err_name(e))
    Ok(h) => rs.push(rt_expect(h.width.to_string() + "x" + h.height.to_string() + " " + h.has_alpha.to_string() + h.has_icc.to_string() + h.has_exif.to_string() + h.has_xmp.to_string() + h.has_animation.to_string(), "16777216x7 truetruetruetruetrue", "probe VP8X flags"))
  }
  match webp::probe_header(rt_riff([rt_chunk("VP8 ", rt_vp8_16x16())])) {
    Err(e) => rs.push("probe VP8: " + rt_err_name(e))
    Ok(h) => rs.push(rt_expect(h.width.to_string() + "x" + h.height.to_string(), "16x16", "probe VP8"))
  }
  match webp::probe_header(rt_riff([rt_chunk("VP8L", rt_vp8l_solid(16384, 3, 0, 0, 0, 0))])) {
    Err(e) => rs.push("probe VP8L: " + rt_err_name(e))
    Ok(h) => rs.push(rt_expect(h.width.to_string() + "x" + h.height.to_string(), "16384x3", "probe VP8L"))
  }
  rs.push(
    match webp::probe_header(rt_bytes([0x52, 0x49, 0x46, 0x46])) {
      Ok(_) => "probe of 4 bytes succeeded"
      Err(_) => ""
    },
  )
  rt_first(rs)
}

// ---------------------------------------------------------------------------------------------

///|
pub fn rt_all_cases() -> Array[String] {
  [
    "redteam_p0_alph_plane_smaller_than_vp8_frame_raw", "redteam_p0_alph_plane_smaller_than_vp8_frame_vp8l",
    "redteam_p0_alph_plane_shorter_than_vp8_frame", "redteam_p0_alph_plane_smaller_than_vp8_frame_custom_limits", "redteam_p0_bitflip_sweep_vp8x_alph_no_abort",
    "redteam_p2_simple_code_descending_symbols_follow_rfc", "redteam_p2_alpha_flag_without_alph_chunk_decodes_opaque",
    "control_riff_container_edges", "control_vp8x_edges", "control_alph_raw_filters_odd_sizes", "control_alph_header_edges",
    "control_vp8l_huffman_edges", "control_vp8l_lz77_edges", "control_vp8l_color_cache_edges",
    "control_vp8l_color_indexing_widths", "control_vp8l_transform_limits", "control_decode_limits_boundaries",
    "control_vp8_header_edges", "control_bitflip_truncation_sweep", "control_probe_header",
  ]
}

///| Run one case by name.
pub fn rt_run_case(name : String) -> String {
  if name == "redteam_p0_alph_plane_smaller_than_vp8_frame_raw" {
    redteam_p0_alph_plane_smaller_than_vp8_frame_raw()
  } else if name == "redteam_p0_alph_plane_smaller_than_vp8_frame_vp8l" {
    redteam_p0_alph_plane_smaller_than_vp8_frame_vp8l()
  } else if name == "redteam_p0_alph_plane_shorter_than_vp8_frame" {
    redteam_p0_alph_plane_shorter_than_vp8_frame()
  } else if name == "redteam_p0_alph_plane_smaller_than_vp8_frame_custom_limits" {
    redteam_p0_alph_plane_smaller_than_vp8_frame_custom_limits()
  } else if name == "redteam_p0_bitflip_sweep_vp8x_alph_no_abort" {
    redteam_p0_bitflip_sweep_vp8x_alph_no_abort()
  } else if name == "redteam_p2_simple_code_descending_symbols_follow_rfc" {
    redteam_p2_simple_code_descending_symbols_follow_rfc()
  } else if name == "redteam_p2_alpha_flag_without_alph_chunk_decodes_opaque" {
    redteam_p2_alpha_flag_without_alph_chunk_decodes_opaque()
  } else if name == "control_riff_container_edges" {
    control_riff_container_edges()
  } else if name == "control_vp8x_edges" {
    control_vp8x_edges()
  } else if name == "control_alph_raw_filters_odd_sizes" {
    control_alph_raw_filters_odd_sizes()
  } else if name == "control_alph_header_edges" {
    control_alph_header_edges()
  } else if name == "control_vp8l_huffman_edges" {
    control_vp8l_huffman_edges()
  } else if name == "control_vp8l_lz77_edges" {
    control_vp8l_lz77_edges()
  } else if name == "control_vp8l_color_cache_edges" {
    control_vp8l_color_cache_edges()
  } else if name == "control_vp8l_color_indexing_widths" {
    control_vp8l_color_indexing_widths()
  } else if name == "control_vp8l_transform_limits" {
    control_vp8l_transform_limits()
  } else if name == "control_decode_limits_boundaries" {
    control_decode_limits_boundaries()
  } else if name == "control_vp8_header_edges" {
    control_vp8_header_edges()
  } else if name == "control_bitflip_truncation_sweep" {
    control_bitflip_truncation_sweep()
  } else if name == "control_probe_header" {
    control_probe_header()
  } else {
    "unknown case " + name
  }
}

///| Base files of `control_bitflip_truncation_sweep` and the red-team vectors, for external tools.
pub fn rt_write_samples(world : World, dir : String) -> Unit {
  let alph : Array[Int] = [1]
  rt_push_all(alph, rt_alph_vp8l_solid(0x40))
  let _ = fs_write_bytes(world, dir + "/sweep_vp8l_5x3.webp", rt_riff([rt_chunk("VP8L", rt_vp8l_solid(5, 3, 200, 1, 2, 3))]))
  let _ = fs_write_bytes(world, dir + "/sweep_vp8x_alph_vp8_4x4.webp", rt_riff([rt_vp8x(0x10, 4, 4), rt_chunk("ALPH", alph), rt_chunk("VP8 ", rt_vp8_4x4())]))
  let _ = fs_write_bytes(world, dir + "/p0_vp8x1x1_alph_raw_vp8_16x16.webp", rt_riff([rt_vp8x(0x10, 1, 1), rt_chunk("ALPH", [0, 0x80]), rt_chunk("VP8 ", rt_vp8_16x16())]))
  let _ = fs_write_bytes(world, dir + "/p2_vp8l_simple_code_descending.webp", rt_simple_code_descending_file())
  let _ = fs_write_bytes(world, dir + "/p2_flag_without_alph.webp", rt_riff([rt_vp8x(0x10, 16, 16), rt_chunk("VP8 ", rt_vp8_16x16())]))
}

///| VP8L prefix coding of a length/distance value `v >= 1`: (symbol, extra bit count, extra value).
fn rt_prefix(v : Int) -> (Int, Int, Int) {
  let x = v - 1
  if x < 4 {
    return (x, 0, 0)
  }
  let mut hb = 0
  while (x >> (hb + 1)) != 0 {
    hb = hb + 1
  }
  let second = (x >> (hb - 1)) & 1
  (2 * hb + second, hb - 1, x & ((1 << (hb - 1)) - 1))
}

///| Meta-prefix-code memory bomb: `groups` Huffman groups (max 2600 = the decoder's cap), each with five
///| maximal flat 15-bit codes (green over 256 + 24 + 2048 cache symbols), used by a 208 x 200 image whose
///| 52 x 50 tiles reference every group. Pixels are one literal plus maximal LZ77 copies (dist 1).
pub fn rt_meta_bomb(groups : Int, complete : Bool) -> Array[Int] {
  let w = 208
  let h = 200
  let bw = RtBw::new()
  rt_vp8l_header(bw, w, h, 1, 0)
  bw.put(1, 0) // no transforms
  bw.put(1, 1) // color cache
  bw.put(4, 11)
  bw.put(1, 1) // meta prefix codes
  bw.put(3, 0) // tile bits 2
  // entropy image 52 x 50: green = i & 255 (flat length-8 code), red = i >> 8 (flat length-4 code)
  rt_no_cache_no_meta(bw, false)
  rt_flat_code(bw, 8, 256)
  rt_flat_code(bw, 4, 16)
  rt_simple1(bw, 0)
  rt_simple1(bw, 0)
  rt_simple1(bw, 0)
  let mut i = 0
  while i < 52 * 50 {
    // more than 2600 groups: tile 0 references group `groups - 1` (>= 2600, over the decoder's cap)
    let g = if groups > 2600 && i == 0 { groups - 1 } else { i % groups }
    rt_put_code(bw, g & 255, 8)
    rt_put_code(bw, g >> 8, 4)
    i = i + 1
  }
  let mut gi = 0
  while gi < groups {
    if complete {
      // complete codes (accepted by every decoder): green 1768 x 11 bits + 560 x 12 bits,
      // red/blue/alpha 256 x 8 bits, distance 24 x 5 bits + 16 x 6 bits
      rt_two_length_code(bw, 11, 1768, 12, 560)
      rt_flat_code(bw, 8, 256)
      rt_flat_code(bw, 8, 256)
      rt_flat_code(bw, 8, 256)
      rt_two_length_code(bw, 5, 24, 6, 16)
    } else {
      // incomplete flat 15-bit codes (libwebp and x/image/webp reject them; packages/webp accepts)
      rt_flat_code(bw, 15, 256 + 24 + 2048)
      rt_flat_code(bw, 15, 256)
      rt_flat_code(bw, 15, 256)
      rt_flat_code(bw, 15, 256)
      rt_flat_code(bw, 15, 40)
    }
    gi = gi + 1
  }
  // canonical codes: incomplete flat 15-bit -> code = symbol; complete -> green symbol s < 1768 has the
  // 11-bit code s, length symbol 256 + k likewise; r/b/a code = symbol (8 bits); distance symbol 13 has
  // the 5-bit code 13
  let gl = if complete { 11 } else { 15 }
  let cl = if complete { 8 } else { 15 }
  let dl = if complete { 5 } else { 15 }
  // pixel 0: literal ARGB (255, 1, 2, 3)
  rt_put_code(bw, 2, gl)
  rt_put_code(bw, 1, cl)
  rt_put_code(bw, 3, cl)
  rt_put_code(bw, 255, cl)
  let mut pos = 1
  while pos < w * h {
    let rem = w * h - pos
    let len = if rem > 4096 { 4096 } else { rem }
    let (ls, lb, le) = rt_prefix(len)
    rt_put_code(bw, 256 + ls, gl)
    bw.put(lb, le)
    rt_put_code(bw, 13, dl) // distance symbol 13, extra 24 -> plane code 121 -> distance 1
    bw.put(5, 24)
    pos = pos + len
  }
  bw.finish()
}

///| DoS probe corpus (verdict + wall-clock budget checked by diff/dos.py).
pub fn rt_gen_dos(world : World, dir : String) -> Unit {
  // canvas / header bombs: must be rejected before allocation
  let _ = fs_write_bytes(world, dir + "/vp8l_16383sq_header.webp", rt_riff([rt_chunk("VP8L", rt_vp8l_solid(16383, 16383, 255, 0, 0, 0))]))
  let _ = fs_write_bytes(world, dir + "/vp8l_16384sq_header.webp", rt_riff([rt_chunk("VP8L", rt_vp8l_solid(16384, 16384, 255, 0, 0, 0))]))
  let _ = fs_write_bytes(world, dir + "/vp8x_16777216sq.webp", rt_riff([rt_vp8x(0x10, 16777216, 16777216), rt_chunk("ALPH", [0])]))
  let _ = fs_write_bytes(world, dir + "/vp8x_16384sq_alph.webp", rt_riff([rt_vp8x(0x10, 16384, 16384), rt_chunk("ALPH", [0])]))
  let _ = fs_write_bytes(world, dir + "/vp8_16383sq.webp", rt_riff([rt_chunk("VP8 ", rt_vp8_frame(16383, 16383, 0, 1, rt_fill(32, 0)))]))
  // largest image the default limits allow, from a few bytes (4096 x 4096 = 16M px, 64 MiB RGBA)
  let _ = fs_write_bytes(world, dir + "/vp8l_4096sq_solid_bomb.webp", rt_riff([rt_chunk("VP8L", rt_vp8l_solid(4096, 4096, 255, 9, 8, 7))]))
  let alph : Array[Int] = [1]
  rt_push_all(alph, rt_alph_vp8l_solid(0x40))
  let _ = fs_write_bytes(world, dir + "/alph_vp8l_4096sq_bomb_truncated_vp8.webp", rt_riff([rt_vp8x(0x10, 4096, 4096), rt_chunk("ALPH", alph), rt_chunk("VP8 ", rt_vp8_frame(4096, 4096, 0, 1, rt_fill(16, 0)))]))
  // truncated VP8 4096 x 4096: tiny partitions, every macroblock read past EOF
  let _ = fs_write_bytes(world, dir + "/vp8_4096sq_truncated.webp", rt_riff([rt_chunk("VP8 ", rt_vp8_frame(4096, 4096, 0, 1, rt_fill(16, 0)))]))
  // meta prefix codes: 2600 groups (decoder cap) of maximal tables, and 2601 (over the cap -> rejected)
  let _ = fs_write_bytes(world, dir + "/vp8l_meta_huffman_2600_groups_incomplete.webp", rt_riff([rt_chunk("VP8L", rt_meta_bomb(2600, false))]))
  let _ = fs_write_bytes(world, dir + "/vp8l_meta_huffman_2600_groups_complete.webp", rt_riff([rt_chunk("VP8L", rt_meta_bomb(2600, true))]))
  let _ = fs_write_bytes(world, dir + "/vp8l_meta_huffman_group_index_2600.webp", rt_riff([rt_chunk("VP8L", rt_meta_bomb(2601, true))]))
  // 1M empty unknown chunks (8 MiB file) before the image
  let many : Array[Array[Int]] = []
  let mut i = 0
  while i < 1048576 {
    many.push(rt_chunk("JUNK", []))
    i = i + 1
  }
  many.push(rt_chunk("VP8L", rt_vp8l_solid(3, 2, 255, 1, 2, 3)))
  let _ = fs_write_bytes(world, dir + "/chunk_count_bomb_1M.webp", rt_riff(many))
}
