///| Red-team CLI for `packages/webp` (native + wasm32).
///|   list                        -> every case name, one per line
///|   case <name>                 -> run one case: `PASS <name>` / `FAIL <name> :: <reason>`; exit 1 on FAIL
///|   selftest                    -> run every case in-process (a panicking case aborts the run; see run_audit.sh)
///|   digest <file>...            -> `<file> OK <w> <h> <sha256(RGBA8888)>` | `<file> ERR <Variant>`
///|   rgba <file> <out>           -> write the decoded RGBA8888 bytes
///|   samples <dir>               -> write the sweep / red-team sample files
///|   time <file>                 -> decode with default limits, print verdict and microseconds
///|   gen_dos <dir>               -> write the DoS probe corpus

import "webp"
import "crypto"

///|
pub fn rt_digest(data : Bytes) -> String {
  match webp::decode(data) {
    Err(e) => "ERR " + rt_err_name(e)
    Ok(img) =>
    "OK " +
    img.width.to_string() +
    " " +
    img.height.to_string() +
    " " +
    crypto::sha256_hex(img.rgba)
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: webp_audit list | case <name> | selftest | digest <file>... | time <file> | gen_dos <dir>")
    return 2
  }
  let mode = args[1]
  if mode == "list" {
    let names = rt_all_cases()
    let mut i = 0
    while i < names.length() {
      io_println(world, names[i])
      i = i + 1
    }
    return 0
  }
  if mode == "case" && args.length() >= 3 {
    let r = rt_run_case(args[2])
    if r == "" {
      io_println(world, "PASS " + args[2])
      return 0
    }
    io_println(world, "FAIL " + args[2] + " :: " + r)
    return 1
  }
  if mode == "selftest" {
    let names = rt_all_cases()
    let mut failed = 0
    let mut i = 0
    while i < names.length() {
      let r = rt_run_case(names[i])
      if r == "" {
        io_println(world, "PASS " + names[i])
      } else {
        io_println(world, "FAIL " + names[i] + " :: " + r)
        failed = failed + 1
      }
      i = i + 1
    }
    io_println(world, "selftest: " + (names.length() - failed).to_string() + "/" + names.length().to_string() + " passed")
    return if failed == 0 { 0 } else { 1 }
  }
  if mode == "digest" {
    let mut i = 2
    while i < args.length() {
      match fs_read_bytes(world, args[i]) {
        Ok(d) => io_println(world, args[i] + " " + rt_digest(d))
        Err(_) => io_println(world, args[i] + " READFAIL")
      }
      i = i + 1
    }
    return 0
  }
  if mode == "time" && args.length() >= 3 {
    let d = match fs_read_bytes(world, args[2]) {
      Ok(x) => x
      Err(_) => return 3
    }
    let t0 = clock_monotonic_us()
    let k = rt_kind(webp::decode(d))
    let t1 = clock_monotonic_us()
    io_println(world, k + " us=" + (t1 - t0).to_string())
    return 0
  }
  if mode == "rgba" && args.length() >= 4 {
    match fs_read_bytes(world, args[2]) {
      Ok(d) =>
      match webp::decode(d) {
        Ok(img) => {
          let _ = fs_write_bytes(world, args[3], img.rgba)
        }
        Err(e) => io_println(world, "ERR " + rt_err_name(e))
      }
      Err(_) => return 3
    }
    return 0
  }
  if mode == "samples" && args.length() >= 3 {
    rt_write_samples(world, args[2])
    return 0
  }
  if mode == "gen_dos" && args.length() >= 3 {
    rt_gen_dos(world, args[2])
    io_println(world, "gen_dos: ok")
    return 0
  }
  io_println(world, "bad arguments")
  2
}
