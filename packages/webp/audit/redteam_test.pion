///| Red-team FINDING tests for `packages/webp` @ 97d38ff (`origin/feat/pkg-webp`).
///| Each test asserts the behaviour a correct WebP decoder must have and FAILS (or aborts with a panic) on the
///| audited baseline; the failure message is the evidence. A fix is complete when every test passes without
///| editing `audit/`. Case bodies live in `src/cases.pion` so `webp_audit case <name>` runs the same code on
///| native and wasm32.

///|
test "redteam_p0_alph_plane_smaller_than_vp8_frame_raw" {
  let r = redteam_p0_alph_plane_smaller_than_vp8_frame_raw()
  debug_assert(r == "", r)
}

