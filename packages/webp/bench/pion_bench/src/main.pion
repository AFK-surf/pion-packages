///| Pion Native head-to-head benchmark for `packages/webp`.
///| Usage: pion_webp_bench <webp_file> <iters>
///| Decodes `<webp_file>` `<iters>` times and writes the final RGBA8888 bytes to stdout.

import "webp"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_webp_bench <webp_file> <iters>")
    return 1
  }
  let path = args[1]
  let iters = parse_int(args[2])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }
  let mut last_rgba = Bytes::new(0)
  let mut i = 0
  while i < iters {
    match webp::decode(data) {
      Ok(img) => last_rgba = img.rgba
      Err(e) => {
        io_println(world, "decode error: " + webp::webp_error_message(e))
        return 1
      }
    }
    i = i + 1
  }
  let _ = fs_write_bytes(world, "/dev/stdout", last_rgba)
  0
}
