///| Pion Native head-to-head benchmark for `packages/webp`.
///| Usage:
///|   pion_webp_bench <webp_file> <iters>
///|   pion_webp_bench encode <rgba_file> <w> <h> <iters> [exact] [out_webp]
///| Decode mode decodes `<webp_file>` `<iters>` times and writes the final RGBA8888 bytes to stdout.
///| Encode mode encodes `<rgba_file>` `<iters>` times, optionally saves the encoded WebP to `out_webp`,
///| decodes the final encoded WebP back to RGBA8888, and writes those RGBA8888 bytes to stdout.

import "webp"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_webp_bench <webp_file> <iters>")
    return 1
  }
  if args[1] == "encode" {
    if args.length() < 6 {
      io_println(world, "usage: pion_webp_bench encode <rgba_file> <w> <h> <iters> [exact] [out_webp]")
      return 1
    }
    let path = args[2]
    let w = parse_int(args[3])
    let h = parse_int(args[4])
    let iters = parse_int(args[5])
    let use_exact = args.length() >= 7 && args[6] == "exact"
    let opts = if use_exact { webp::EncodeOptions::exact() } else { webp::EncodeOptions::default() }
    let rgba = match fs_read_bytes(world, path) {
      Ok(b) => b
      Err(_) => {
        io_println(world, "failed to read " + path)
        return 1
      }
    }
    let mut last_webp = Bytes::new(0)
    let mut i = 0
    while i < iters {
      match webp::encode_lossless_rgba_with_options(rgba, w, h, opts) {
        Ok(enc) => last_webp = enc
        Err(e) => {
          io_println(world, "encode error: " + webp::webp_error_message(e))
          return 1
        }
      }
      i = i + 1
    }
    if args.length() >= 8 {
      match fs_write_bytes(world, args[7], last_webp) {
        Ok(()) => ()
        Err(_) => {
          io_println(world, "failed to write " + args[7])
          return 1
        }
      }
    }
    match webp::decode(last_webp) {
      Ok(img) => {
        match fs_write_bytes(world, "/dev/stdout", img.rgba) {
          Ok(()) => return 0
          Err(_) => {
            io_println(world, "failed to write stdout")
            return 1
          }
        }
      }
      Err(e) => {
        io_println(world, "roundtrip decode error: " + webp::webp_error_message(e))
        return 1
      }
    }
  }
  let path = args[1]
  let iters = parse_int(args[2])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }
  let mut last_rgba = Bytes::new(0)
  let mut i = 0
  while i < iters {
    match webp::decode(data) {
      Ok(img) => last_rgba = img.rgba
      Err(e) => {
        io_println(world, "decode error: " + webp::webp_error_message(e))
        return 1
      }
    }
    i = i + 1
  }
  let _ = fs_write_bytes(world, "/dev/stdout", last_rgba)
  0
}
