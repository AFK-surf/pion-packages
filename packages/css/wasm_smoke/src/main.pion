///| Wasm32 + Native smoke entry for the `css` package.

import "css"

///|
pub fn smoke() -> Int {
  let src = "/* smoke */ @media screen and (min-width: 768px) { #app .card:not(.hidden) { color: #ffffff; margin: 0px 0.5rem; --gap:  12px ; } }"
  let toks = match css::tokenize(src) {
    Ok(t) => t
    Err(_) => return 1
  }
  if toks.length() == 0 {
    return 2
  }
  let sheet = match css::parse_stylesheet(src) {
    Ok(s) => s
    Err(_) => return 3
  }
  if sheet.rules.length() != 1 {
    return 4
  }
  let spec = match css::selector_specificity("#app .card:not(.hidden)") {
    Ok(sp) => sp
    Err(_) => return 5
  }
  if !spec.eq(css::Specificity::new(1, 2, 0)) {
    return 6
  }
  let col = match css::parse_color("rgb(255 0 128 / 50%)") {
    Ok(c) => c
    Err(_) => return 7
  }
  if col.r != 255 || col.g != 0 || col.b != 128 {
    return 8
  }
  let mqs = match css::parse_media_query_list("screen and (min-width: 768px)") {
    Ok(m) => m
    Err(_) => return 9
  }
  if mqs.length() != 1 {
    return 10
  }
  let min = match css::minify(src) {
    Ok(m) => m
    Err(_) => return 11
  }
  if min.length() == 0 {
    return 12
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  smoke()
}
