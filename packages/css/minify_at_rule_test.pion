///| Boundary and byte-equivalence tests for `minify` and `minify_stylesheet` at-rule fast paths.

test "css_minify_at_rule_fast_path_equivalence" {
  let samples = [
    "@charset \"UTF-8\"; @import url(base.css) screen;",
    "@FONT-FACE { font-family: 'Inter'; SRC: url(inter.woff2); font-weight: 400; }",
    "@page :first { margin: 0px 0em; size: A4; }",
    "@property --x { syntax: '<length>'; inherits: false; initial-value: 0px; }",
    "@keyframes fade { 0% { opacity: 0.0; } 100% { opacity: 1; } }",
    "@-webkit-keyframes slide { from { transform: translateX(0px); } to { transform: translateX(10px); } }",
    "@media screen and (min-width: 768px) { .a { color: #FFFFFF; margin: 0px; flex: 0px; line-height: 0px; --gap:  ; } }",
    "@supports (display: grid) { @layer base { .b { padding: 0rem !IMPORTANT; } } }",
    ".card { color: #aabbcc; @media (hover: hover) { &:hover { color: #112233; } @font-face { font-family: X; } } }",
    "@m\\65 dia (min-width: 10px) { .esc { width: 0px; } }",
    "@starting-style { .toast { opacity: 0; } }",
    "@container sidebar (min-width: 400px) { .item { margin: 0px; } }",
  ]
  let mut i = 0
  while i < samples.length() {
    let src = samples[i]
    let m1 = match minify(src) {
      Ok(s) => s
      Err(e) => {
        debug_assert(false, e.to_string())
        ""
      }
    }
    let sheet = match parse_stylesheet(src) {
      Ok(st) => st
      Err(e) => {
        debug_assert(false, e.to_string())
        Stylesheet::{ rules: [] }
      }
    }
    let m2 = minify_stylesheet(sheet)
    debug_assert(m1 == m2, "minify vs minify_stylesheet mismatch for sample " + i.to_string() + ": " + m1 + " != " + m2)
    // Idempotence check
    let m3 = match minify(m1) {
      Ok(s) => s
      Err(_) => ""
    }
    debug_assert(m3 == m1, "minify not idempotent for sample " + i.to_string())
    i = i + 1
  }
}

test "css_minify_with_token_limit_matches_default" {
  // Force `lex.check_limit == true` (`max_tokens < src.length()`) so `minify_internal`
  // exercises the `parse_decl_or_nested` fallback path with `decl.value`.
  let src = "/* leading comment padding so src.length() exceeds max_tokens */ .card { color: #AABBCC; margin: 0px 10px; --custom:  1px ; background: rgb(255, 0, 0) !IMPORTANT; }"
  let opts = ParseOptions::{ max_depth: 256, max_tokens: 80, max_rules: 500000 }
  let m_default = match minify(src) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, e.to_string())
      ""
    }
  }
  let m_limited = match minify_with_options(src, opts) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, e.to_string())
      ""
    }
  }
  debug_assert(
    m_limited == m_default,
    "minify_with_options(check_limit) mismatch: " + m_limited + " != " + m_default,
  )
}
