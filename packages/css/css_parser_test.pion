///| CSS Syntax Level 3 stylesheet & declaration block parser compliance tests.

fn assert_parse_ok(name : String, src : String) -> Stylesheet {
  match parse_stylesheet(src) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "[" + name + "] unexpected parse error: " + e.to_string())
      Stylesheet::{ rules: [] }
    }
  }
}

///|
test "parser__basic_qualified_rule" {
  let sheet = assert_parse_ok(
    "basic",
    "body { color: #333; font-size: 16px !important; }",
  )
  debug_assert(sheet.rules.length() == 1, "expected 1 rule")
  match sheet.rules[0] {
    Rule::Qualified(qr) => {
      debug_assert(qr.prelude == "body", "prelude mismatch: " + qr.prelude)
      debug_assert(qr.declarations.length() == 2, "expected 2 declarations")
      debug_assert(qr.declarations[0].name == "color", "decl 0 name")
      debug_assert(qr.declarations[0].value == "#333", "decl 0 value")
      debug_assert(!qr.declarations[0].important, "decl 0 not important")
      debug_assert(qr.declarations[1].name == "font-size", "decl 1 name")
      debug_assert(qr.declarations[1].value == "16px", "decl 1 value")
      debug_assert(qr.declarations[1].important, "decl 1 important")
    }
    _ => debug_assert(false, "expected QualifiedRule")
  }
}

///|
test "parser__important_case_insensitive" {
  match parse_declarations("color: red !IMPORTANT; display: flex !  ImPoRtAnT ;") {
    Ok(decls) => {
      debug_assert(decls.length() == 2, "expected 2 decls")
      debug_assert(decls[0].value == "red" && decls[0].important, "decl 0 !IMPORTANT")
      debug_assert(decls[1].value == "flex" && decls[1].important, "decl 1 ! ImPoRtAnT")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.to_string())
  }
}

///|
test "parser__custom_properties_preserve_whitespace_and_case" {
  match parse_declarations("--My-Var:   hello   world  ; --empty:  ; Color: blue;") {
    Ok(decls) => {
      debug_assert(decls.length() == 3, "expected 3 decls")
      debug_assert(decls[0].is_custom, "decl 0 is_custom")
      debug_assert(decls[0].name == "--My-Var", "custom prop case preserved")
      debug_assert(decls[0].value == "   hello   world  ", "custom prop ws preserved: [" + decls[0].value + "]")
      debug_assert(decls[1].is_custom, "decl 1 is_custom")
      debug_assert(decls[1].name == "--empty", "decl 1 name")
      debug_assert(decls[1].value == "  ", "empty custom prop ws preserved: [" + decls[1].value + "]")
      debug_assert(!decls[2].is_custom, "decl 2 standard")
      debug_assert(decls[2].name == "color", "standard prop lowercased")
      debug_assert(decls[2].value == "blue", "standard prop value")
    }
    Err(e) => debug_assert(false, "unexpected error: " + e.to_string())
  }
}

///|
test "parser__at_rules_all_kinds" {
  let src = "@charset \"UTF-8\";\n" +
  "@import url(\"base.css\") screen;\n" +
  "@layer reset, base;\n" +
  "@font-face { font-family: 'Inter'; src: url(inter.woff2); }\n" +
  "@media (min-width: 768px) { .grid { display: grid; } }\n" +
  "@supports (display: grid) { .grid { gap: 1rem; } }\n" +
  "@keyframes fade { from { opacity: 0; } to { opacity: 1; } }\n" +
  "@container sidebar (min-width: 400px) { .card { padding: 12px; } }\n"
  let sheet = assert_parse_ok("at-rules", src)
  debug_assert(sheet.rules.length() == 8, "expected 8 at-rules, got " + sheet.rules.length().to_string())

  // @charset (statement)
  match sheet.rules[0] {
    Rule::At(ar) => {
      debug_assert(ar.name == "charset", "charset name")
      debug_assert(!ar.has_block, "charset has no block")
    }
    _ => debug_assert(false, "expected @charset")
  }
  // @import (statement)
  match sheet.rules[1] {
    Rule::At(ar) => {
      debug_assert(ar.name == "import", "import name")
      debug_assert(!ar.has_block, "import has no block")
    }
    _ => debug_assert(false, "expected @import")
  }
  // @layer (statement)
  match sheet.rules[2] {
    Rule::At(ar) => {
      debug_assert(ar.name == "layer", "layer name")
      debug_assert(!ar.has_block, "layer statement has no block")
      debug_assert(ar.prelude == "reset, base", "layer prelude")
    }
    _ => debug_assert(false, "expected @layer")
  }
  // @font-face (declarations block)
  match sheet.rules[3] {
    Rule::At(ar) => {
      debug_assert(ar.name == "font-face", "font-face name")
      debug_assert(ar.has_block, "font-face has block")
      debug_assert(ar.declarations.length() == 2, "font-face decls")
    }
    _ => debug_assert(false, "expected @font-face")
  }
  // @media (rules block)
  match sheet.rules[4] {
    Rule::At(ar) => {
      debug_assert(ar.name == "media", "media name")
      debug_assert(ar.has_block && ar.rules.length() == 1, "media inner rule")
    }
    _ => debug_assert(false, "expected @media")
  }
  // @supports
  match sheet.rules[5] {
    Rule::At(ar) => {
      debug_assert(ar.name == "supports" && ar.rules.length() == 1, "supports inner rule")
    }
    _ => debug_assert(false, "expected @supports")
  }
  // @keyframes
  match sheet.rules[6] {
    Rule::At(ar) => {
      debug_assert(ar.name == "keyframes" && ar.prelude == "fade", "keyframes prelude")
      debug_assert(ar.rules.length() == 2, "keyframes 2 stops")
    }
    _ => debug_assert(false, "expected @keyframes")
  }
  // @container
  match sheet.rules[7] {
    Rule::At(ar) => {
      debug_assert(ar.name == "container" && ar.rules.length() == 1, "container inner rule")
    }
    _ => debug_assert(false, "expected @container")
  }
}

///|
test "parser__css_nesting" {
  let src = ".card { padding: 16px; &:hover { background: #eee; } @media (min-width: 600px) { padding: 24px; } }"
  let sheet = assert_parse_ok("nesting", src)
  debug_assert(sheet.rules.length() == 1, "expected 1 outer rule")
  match sheet.rules[0] {
    Rule::Qualified(qr) => {
      debug_assert(qr.prelude == ".card", "outer prelude")
      debug_assert(qr.declarations.length() == 1, "outer decl count")
      debug_assert(qr.nested_rules.length() == 2, "expected 2 nested rules")
      match qr.nested_rules[0] {
        Rule::Qualified(nqr) => {
          debug_assert(nqr.prelude == "&:hover", "nested &:hover")
          debug_assert(nqr.declarations.length() == 1, "nested decl")
        }
        _ => debug_assert(false, "expected nested QualifiedRule")
      }
      match qr.nested_rules[1] {
        Rule::At(nar) => {
          debug_assert(nar.name == "media", "nested @media")
          debug_assert(nar.declarations.length() == 1, "nested @media decl")
        }
        _ => debug_assert(false, "expected nested @media")
      }
    }
    _ => debug_assert(false, "expected QualifiedRule")
  }
}

///|
test "parser__fault_tolerance_malformed_declarations_and_rules" {
  // Malformed declarations discarded, valid ones preserved
  let src = ".a { broken_no_colon; 123: bad_name; color: green; margin: \"unclosed\n; padding: 8px }"
  let sheet = assert_parse_ok("fault-decl", src)
  debug_assert(sheet.rules.length() == 1, "expected 1 rule")
  match sheet.rules[0] {
    Rule::Qualified(qr) => {
      debug_assert(qr.declarations.length() == 2, "expected 2 valid decls, got " + qr.declarations.length().to_string())
      debug_assert(qr.declarations[0].name == "color" && qr.declarations[0].value == "green", "decl 0")
      debug_assert(qr.declarations[1].name == "padding" && qr.declarations[1].value == "8px", "decl 1")
    }
    _ => debug_assert(false, "expected QualifiedRule")
  }

  // Stray '}' and ';' at top level do not kill subsequent rules
  let src2 = "} ; .first { color: red; } } .second { color: blue; }"
  let sheet2 = assert_parse_ok("fault-rules", src2)
  debug_assert(sheet2.rules.length() == 2, "expected 2 valid rules, got " + sheet2.rules.length().to_string())

  // Unclosed rule block at EOF is still parsed gracefully
  let src3 = ".eof { color: purple"
  let sheet3 = assert_parse_ok("fault-eof", src3)
  debug_assert(sheet3.rules.length() == 1, "expected 1 rule at EOF")
  match sheet3.rules[0] {
    Rule::Qualified(qr) => {
      debug_assert(qr.declarations.length() == 1 && qr.declarations[0].value == "purple", "eof decl")
    }
    _ => debug_assert(false, "expected QualifiedRule")
  }
}
