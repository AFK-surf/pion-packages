///| Selector specificity, CSS Color Level 4 (148 named + hex/rgb/hsl), Media Queries Level 4, and Serializer/Minifier tests.

fn assert_spec(sel : String, ids : Int, cls : Int, els : Int) -> Unit {
  match selector_specificity(sel) {
    Ok(sp) => {
      let exp = Specificity::new(ids, cls, els)
      debug_assert(
        sp.eq(exp),
        "specificity(" + sel + "): got " + sp.to_string() + ", expected " + exp.to_string(),
      )
    }
    Err(e) => debug_assert(false, "specificity(" + sel + ") error: " + e.to_string())
  }
}

///|
test "specificity__selectors_level_4" {
  assert_spec("*", 0, 0, 0)
  assert_spec("div", 0, 0, 1)
  assert_spec("div p", 0, 0, 2)
  assert_spec("div > p + span ~ a", 0, 0, 4)
  assert_spec(".card", 0, 1, 0)
  assert_spec("[type=\"text\"]", 0, 1, 0)
  assert_spec("a:hover", 0, 1, 1)
  assert_spec("p::before", 0, 0, 2)
  assert_spec("p:before", 0, 0, 2)
  assert_spec("p:first-line", 0, 0, 2)
  assert_spec("#nav", 1, 0, 0)
  assert_spec("#nav .item > a.active[href]:hover::after", 1, 4, 2)
  // :where() always 0
  assert_spec(":where(#id, .cls, div)", 0, 0, 0)
  assert_spec("div:where(#id .cls)", 0, 0, 1)
  // :not() / :is() / :has() take highest specificity of argument list
  assert_spec(":not(.foo)", 0, 1, 0)
  assert_spec(":not(div, #main, .a.b)", 1, 0, 0)
  assert_spec(":is(header, #hero, .card.open) p", 1, 0, 1)
  assert_spec("article:has(> h2, .lead#top)", 1, 1, 1)
  // :nth-child(An+B) vs :nth-child(An+B of S)
  assert_spec("li:nth-child(2n+1)", 0, 1, 1)
  assert_spec("li:nth-child(2n+1 of .foo)", 0, 2, 1)
  assert_spec("li:nth-child(2n+1 of .foo, #bar)", 1, 1, 1)
  // selector_list_specificity & max_specificity
  match selector_list_specificity("div, #app .btn, .card:hover") {
    Ok(list) => {
      debug_assert(list.length() == 3, "list len")
      debug_assert(list[0].eq(Specificity::new(0, 0, 1)), "list[0]")
      debug_assert(list[1].eq(Specificity::new(1, 1, 0)), "list[1]")
      debug_assert(list[2].eq(Specificity::new(0, 2, 0)), "list[2]")
    }
    Err(e) => debug_assert(false, "list error: " + e.to_string())
  }
  match max_specificity("div, #app .btn, .card:hover") {
    Ok(m) => debug_assert(m.eq(Specificity::new(1, 1, 0)), "max spec")
    Err(e) => debug_assert(false, "max error: " + e.to_string())
  }
  debug_assert(Specificity::new(1, 0, 0).compare(Specificity::new(0, 99, 99)) == 1, "compare ids")
  debug_assert(Specificity::new(0, 2, 0).compare(Specificity::new(0, 1, 99)) == 1, "compare cls")
}

fn assert_color(src : String, r : Int, g : Int, b : Int, a : Double) -> Unit {
  match parse_color(src) {
    Ok(c) => {
      let exp = Color::rgba(r, g, b, a)
      debug_assert(
        c.eq(exp),
        "color(" + src + "): got rgba(" + c.r.to_string() + "," + c.g.to_string() + "," + c.b.to_string() + "," + c.a.to_string() + ")",
      )
    }
    Err(e) => debug_assert(false, "color(" + src + ") error: " + e.to_string())
  }
}

///|
test "color__hex_rgb_hsl_keywords" {
  // Hex
  assert_color("#f0a", 255, 0, 170, 1.0)
  assert_color("#f0a8", 255, 0, 170, 136.0 / 255.0)
  assert_color("#123456", 0x12, 0x34, 0x56, 1.0)
  assert_color("#12345680", 0x12, 0x34, 0x56, 128.0 / 255.0)
  // Legacy rgb / rgba
  assert_color("rgb(255, 0, 128)", 255, 0, 128, 1.0)
  assert_color("rgba(255, 0, 128, 0.5)", 255, 0, 128, 0.5)
  assert_color("rgb(100%, 0%, 50%)", 255, 0, 128, 1.0)
  assert_color("rgba(300, -10, 128, 50%)", 255, 0, 128, 0.5)
  // Modern space + slash syntax
  assert_color("rgb(255 0 128)", 255, 0, 128, 1.0)
  assert_color("rgb(255 0 128 / 50%)", 255, 0, 128, 0.5)
  assert_color("rgba(255 0 128 / 0.25)", 255, 0, 128, 0.25)
  // HSL / HSLA (legacy & modern & angle units)
  assert_color("hsl(0, 100%, 50%)", 255, 0, 0, 1.0)
  assert_color("hsl(120, 100%, 50%)", 0, 255, 0, 1.0)
  assert_color("hsl(240deg 100% 50% / 50%)", 0, 0, 255, 0.5)
  assert_color("hsl(0.5turn 100% 50%)", 0, 255, 255, 1.0)
  assert_color("hsl(200grad 100% 50%)", 0, 255, 255, 1.0)
  assert_color("hsla(60, 100%, 50%, 0.75)", 255, 255, 0, 0.75)
  // Keywords
  assert_color("transparent", 0, 0, 0, 0.0)
  match parse_color("currentColor") {
    Ok(c) => debug_assert(c.is_current_color, "currentColor flag")
    Err(e) => debug_assert(false, "currentColor error: " + e.to_string())
  }
  // Invalid colors
  match parse_color("#12345") {
    Err(e) => debug_assert(css_error_kind_eq(e.kind, CssErrorKind::InvalidColor), "bad hex len")
    Ok(_) => debug_assert(false, "expected Err for #12345")
  }
  match parse_color("notacolor") {
    Err(e) => debug_assert(css_error_kind_eq(e.kind, CssErrorKind::InvalidColor), "bad name")
    Ok(_) => debug_assert(false, "expected Err for notacolor")
  }
  // Formatting & minification
  debug_assert(Color::rgb(255, 255, 255).to_hex() == "#ffffff", "to_hex")
  debug_assert(Color::rgb(255, 255, 255).to_minified_css() == "#fff", "to_minified_css #fff")
  debug_assert(Color::rgb(17, 34, 51).to_minified_css() == "#123", "to_minified_css #123")
  debug_assert(Color::current_color().to_css() == "currentcolor", "currentcolor to_css")
}

