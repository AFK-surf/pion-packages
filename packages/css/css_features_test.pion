///|
test "media__queries_level_4" {
  match parse_media_query_list("screen and (min-width: 768px), not print") {
    Ok(list) => {
      debug_assert(list.length() == 2, "expected 2 media queries")
      debug_assert(
        media_modifier_eq(list[0].modifier, MediaModifier::None) &&
        list[0].media_type == "screen",
        "mq 0 type",
      )
      debug_assert(
        media_modifier_eq(list[1].modifier, MediaModifier::Not) &&
        list[1].media_type == "print",
        "mq 1 type",
      )
    }
    Err(e) => debug_assert(false, "mq list error: " + e.to_string())
  }
  // Range syntax & boolean feature
  match parse_media_query_list("(width >= 768px) and (color)") {
    Ok(list) => {
      debug_assert(list.length() == 1, "expected 1 mq")
      match list[0].condition {
        Some(MediaCondition::And(parts)) => {
          debug_assert(parts.length() == 2, "expected 2 and parts")
          match parts[0] {
            MediaCondition::Feature(MediaFeature::Range(name, op, v)) => {
              debug_assert(
                name == "width" && media_range_op_eq(op, MediaRangeOp::GtEq) && v == "768px",
                "range feature",
              )
            }
            _ => debug_assert(false, "expected Range feature")
          }
          match parts[1] {
            MediaCondition::Feature(MediaFeature::Boolean(name)) => {
              debug_assert(name == "color", "boolean feature")
            }
            _ => debug_assert(false, "expected Boolean feature")
          }
        }
        _ => debug_assert(false, "expected And condition")
      }
    }
    Err(e) => debug_assert(false, "mq range error: " + e.to_string())
  }
  // RangeBetween
  match parse_media_query_list("(400px <= width <= 1024px)") {
    Ok(list) => {
      debug_assert(list.length() == 1, "expected 1 mq")
      match list[0].condition {
        Some(MediaCondition::Feature(MediaFeature::RangeBetween(lo, op1, name, op2, hi))) => {
          debug_assert(
            lo == "400px" &&
            media_range_op_eq(op1, MediaRangeOp::LtEq) &&
            name == "width" &&
            media_range_op_eq(op2, MediaRangeOp::LtEq) &&
            hi == "1024px",
            "range between",
          )
        }
        _ => debug_assert(false, "expected RangeBetween")
      }
    }
    Err(e) => debug_assert(false, "mq range-between error: " + e.to_string())
  }
  // Or & Not
  match parse_media_query_list("not (hover: none)") {
    Ok(list) => {
      debug_assert(list.length() == 1, "expected 1 mq")
      match list[0].condition {
        Some(MediaCondition::Not(_)) => ()
        _ => debug_assert(false, "expected Not condition")
      }
    }
    Err(e) => debug_assert(false, "mq not error: " + e.to_string())
  }
}

///|
test "serialize__to_css_and_minify" {
  let src = "/* banner */\n.card > .title {\n  color: #ffffff;\n  background: #aabbccdd;\n  margin: 0px 0.5rem -0.25em 0em;\n  width: calc(10px + 20px);\n  --x:  ;\n  padding: 8px !important;\n}\n"
  match parse_stylesheet(src) {
    Ok(sheet) => {
      let formatted = to_css(sheet)
      debug_assert(formatted.length() > 0, "to_css non-empty")
      // Roundtrip parse of formatted CSS
      match parse_stylesheet(formatted) {
        Ok(rt) => debug_assert(rt.rules.length() == 1, "roundtrip rule count")
        Err(e) => debug_assert(false, "roundtrip error: " + e.to_string())
      }
    }
    Err(e) => debug_assert(false, "parse error: " + e.to_string())
  }
  match minify(src) {
    Ok(min) => {
      debug_assert(!min.contains("banner"), "comments stripped")
      debug_assert(min.contains(".card>.title{"), "combinator spaces stripped: " + min)
      debug_assert(min.contains("color:#fff"), "hex compressed: " + min)
      debug_assert(min.contains("background:#abcd"), "hex8 compressed: " + min)
      debug_assert(min.contains("margin:0 .5rem -.25em 0"), "0px and 0.5 compressed: " + min)
      debug_assert(min.contains("calc(10px + 20px)"), "calc spaces preserved: " + min)
      debug_assert(min.contains("--x: ;"), "custom property preserved: " + min)
      debug_assert(min.contains("padding:8px!important}"), "trailing semicolon stripped: " + min)
    }
    Err(e) => debug_assert(false, "minify error: " + e.to_string())
  }
}
