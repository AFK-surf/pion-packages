///| 100% iterative CSS Syntax Level 3 stylesheet & declaration block parser.

fn trim_ascii_ws(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n {
    let b = s.code_unit_at(start)
    if b == 32 || b == 9 || b == 10 || b == 13 || b == 12 {
      start = start + 1
    } else {
      break
    }
  }
  let mut end = n
  while end > start {
    let b = s.code_unit_at(end - 1)
    if b == 32 || b == 9 || b == 10 || b == 13 || b == 12 {
      end = end - 1
    } else {
      break
    }
  }
  if start == 0 && end == n {
    s
  } else {
    s.slice(start, end)
  }
}

fn is_ws_tok(t : Token) -> Bool {
  match t.kind {
    TokenKind::Whitespace => true
    _ => false
  }
}

fn is_bad_tok(t : Token) -> Bool {
  match t.kind {
    TokenKind::BadString => true
    TokenKind::BadUrl => true
    _ => false
  }
}

///| Slice raw text from `src` covering tokens `[lo, hi)`, trimmed if `trim` is true.
fn slice_tokens_text(
  src : String,
  tokens : Array[Token],
  lo : Int,
  hi : Int,
  trim : Bool,
) -> String {
  if lo >= hi {
    return ""
  }
  let s = src.slice(tokens[lo].start, tokens[hi - 1].end)
  if trim {
    trim_ascii_ws(s)
  } else {
    s
  }
}

///| Check whether an at-rule block is primarily a declaration list (e.g. @font-face, @page, @property).
fn is_decl_at_rule(name : String) -> Bool {
  name == "font-face" ||
  name == "page" ||
  name == "property" ||
  name == "counter-style" ||
  name == "font-palette-values" ||
  name == "font-feature-values"
}

///| Parse a single declaration from `tokens[lo..hi)`.
///| Returns `Some(Declaration)` if valid, `None` if malformed.
fn parse_single_declaration(
  src : String,
  tokens : Array[Token],
  lo : Int,
  hi : Int,
) -> Option[Declaration] {
  let mut i = lo
  while i < hi && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  if i >= hi {
    return None
  }
  let raw_name = match tokens[i].kind {
    TokenKind::Ident(name) => name
    _ => return None
  }
  i = i + 1
  while i < hi && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  if i >= hi {
    return None
  }
  match tokens[i].kind {
    TokenKind::Colon => ()
    _ => return None
  }
  i = i + 1

  let is_custom = raw_name.length() >= 2 &&
  raw_name.code_unit_at(0) == 45 &&
  raw_name.code_unit_at(1) == 45
  let prop_name = if is_custom { raw_name } else { ascii_lower(raw_name) }

  // Check for BadString / BadUrl in value
  let val_start = i
  let mut k = val_start
  while k < hi {
    if is_bad_tok(tokens[k]) {
      return None
    }
    k = k + 1
  }

  // Detect trailing `!important` (case-insensitive, optional ws between ! and important)
  let mut val_end = hi
  let mut important = false
  let mut t = hi - 1
  while t >= val_start && is_ws_tok(tokens[t]) {
    t = t - 1
  }
  if t >= val_start {
    let is_imp_ident = match tokens[t].kind {
      TokenKind::Ident(w) => ascii_eq_ignore_case(w, "important")
      _ => false
    }
    if is_imp_ident {
      let mut excl = t - 1
      while excl >= val_start && is_ws_tok(tokens[excl]) {
        excl = excl - 1
      }
      if excl >= val_start {
        let is_bang = match tokens[excl].kind {
          TokenKind::Delim(d) => d == "!"
          _ => false
        }
        if is_bang {
          important = true
          val_end = excl
        }
      }
    }
  }

  let value = if is_custom {
    // Custom properties preserve whitespace verbatim!
    if val_start < val_end {
      src.slice(tokens[val_start].start, tokens[val_end - 1].end)
    } else {
      ""
    }
  } else {
    slice_tokens_text(src, tokens, val_start, val_end, true)
  }

  Some(Declaration::new(prop_name, value, important, is_custom))
}

///| Validate balanced nesting depth of `()[]{}` across tokens (100% iterative).
fn check_token_nesting_depth(
  tokens : Array[Token],
  max_depth : Int,
) -> Result[Unit, CssError] {
  let n = tokens.length()
  let mut depth = 0
  let mut i = 0
  while i < n {
    match tokens[i].kind {
      TokenKind::LeftCurly | TokenKind::LeftParen | TokenKind::LeftSquare | TokenKind::Function(_) => {
        depth = depth + 1
        if depth > max_depth {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              tokens[i].start,
              1,
              1,
              "nesting depth limit exceeded",
            ),
          )
        }
      }
      TokenKind::RightCurly | TokenKind::RightParen | TokenKind::RightSquare => {
        if depth > 0 {
          depth = depth - 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  Ok(())
}

///| Frame kinds for the explicit iterative parser stack.
let FRAME_STYLESHEET : Int = 0
let FRAME_QUALIFIED : Int = 1
let FRAME_AT_RULE : Int = 2

struct ParseFrame {
  kind : Int
  name : String
  prelude : String
  declarations : Array[Declaration]
  rules : Array[Rule]
}

fn ParseFrame::new(kind : Int, name : String, prelude : String) -> ParseFrame {
  ParseFrame::{
    kind: kind,
    name: name,
    prelude: prelude,
    declarations: [],
    rules: [],
  }
}

///| Scan forward from `pos` (inside a block or top-level) to find the next `;`, `{`, or `}`
///| at the current paren/bracket depth (0). Returns `(end_idx, stop_kind)`:
///| stop_kind: 0 = EOF, 1 = `;`, 2 = `{`, 3 = `}`.
fn scan_item(tokens : Array[Token], n : Int, pos : Int) -> (Int, Int) {
  let mut i = pos
  let mut paren_depth = 0
  while i < n {
    match tokens[i].kind {
      TokenKind::LeftParen | TokenKind::LeftSquare | TokenKind::Function(_) => {
        paren_depth = paren_depth + 1
        i = i + 1
      }
      TokenKind::RightParen | TokenKind::RightSquare => {
        if paren_depth > 0 {
          paren_depth = paren_depth - 1
        }
        i = i + 1
      }
      TokenKind::Semicolon => {
        if paren_depth == 0 {
          return (i, 1)
        }
        i = i + 1
      }
      TokenKind::LeftCurly => {
        if paren_depth == 0 {
          return (i, 2)
        }
        i = i + 1
      }
      TokenKind::RightCurly => {
        if paren_depth == 0 {
          return (i, 3)
        }
        i = i + 1
      }
      _ => i = i + 1
    }
  }
  (n, 0)
}

fn pop_and_attach_frame(stack : Array[ParseFrame]) -> Unit {
  if stack.length() <= 1 {
    return
  }
  let last_idx = stack.length() - 1
  let frame = stack[last_idx]
  let _ = stack.pop()
  let parent = stack[stack.length() - 1]
  if frame.kind == FRAME_QUALIFIED {
    let qr = QualifiedRule::{
      prelude: frame.prelude,
      declarations: frame.declarations,
      nested_rules: frame.rules,
    }
    parent.rules.push(Rule::Qualified(qr))
  } else if frame.kind == FRAME_AT_RULE {
    let ar = AtRule::{
      name: frame.name,
      prelude: frame.prelude,
      has_block: true,
      declarations: frame.declarations,
      rules: frame.rules,
    }
    parent.rules.push(Rule::At(ar))
  }
}

///| 100% iterative stylesheet parser.
pub fn parse_stylesheet_internal(
  src : String,
  opts : ParseOptions,
) -> Result[Stylesheet, CssError] {
  let clean = preprocess_string(src)
  let tokens = match tokenize_preprocessed(clean, opts) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match check_token_nesting_depth(tokens, opts.max_depth) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }

  let n = tokens.length()
  let stack : Array[ParseFrame] = [ParseFrame::new(FRAME_STYLESHEET, "", "")]
  let mut rule_count = 0
  let mut i = 0

  while i < n {
    // Skip whitespace, CDO, CDC, stray semicolons
    match tokens[i].kind {
      TokenKind::Whitespace | TokenKind::Cdo | TokenKind::Cdc | TokenKind::Semicolon => {
        i = i + 1
        continue
      }
      TokenKind::RightCurly => {
        if stack.length() > 1 {
          pop_and_attach_frame(stack)
        }
        i = i + 1
        continue
      }
      _ => ()
    }

    let cur_frame = stack[stack.length() - 1]

    // At-rule
    match tokens[i].kind {
      TokenKind::AtKeyword(raw_at) => {
        rule_count = rule_count + 1
        if rule_count > opts.max_rules {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              tokens[i].start,
              1,
              1,
              "rule limit exceeded",
            ),
          )
        }
        let at_name = ascii_lower(raw_at)
        let prelude_start = i + 1
        let (stop_idx, stop_kind) = scan_item(tokens, n, prelude_start)
        let prelude = slice_tokens_text(clean, tokens, prelude_start, stop_idx, true)
        if stop_kind == 2 {
          // '{' -> open block frame
          stack.push(ParseFrame::new(FRAME_AT_RULE, at_name, prelude))
          i = stop_idx + 1
        } else {
          // Statement at-rule (';' or '}' or EOF)
          let ar = AtRule::{
            name: at_name,
            prelude: prelude,
            has_block: false,
            declarations: [],
            rules: [],
          }
          cur_frame.rules.push(Rule::At(ar))
          if stop_kind == 1 {
            i = stop_idx + 1
          } else {
            i = stop_idx
          }
        }
        continue
      }
      _ => ()
    }

    // Either top-level qualified rule or inside a block (declaration or nested qualified rule)
    let item_start = i
    let (stop_idx, stop_kind) = scan_item(tokens, n, item_start)

    if stop_kind == 2 {
      // '{' -> Qualified rule (top-level or nested!)
      rule_count = rule_count + 1
      if rule_count > opts.max_rules {
        return Err(
          CssError::new(
            CssErrorKind::LimitExceeded,
            tokens[item_start].start,
            1,
            1,
            "rule limit exceeded",
          ),
        )
      }
      let prelude = slice_tokens_text(clean, tokens, item_start, stop_idx, true)
      stack.push(ParseFrame::new(FRAME_QUALIFIED, "", prelude))
      i = stop_idx + 1
    } else {
      // Ended by ';', '}', or EOF
      if cur_frame.kind != FRAME_STYLESHEET {
        // Inside a qualified rule or at-rule block: try parsing as declaration
        match parse_single_declaration(clean, tokens, item_start, stop_idx) {
          Some(decl) => cur_frame.declarations.push(decl)
          None => ()
        }
      }
      if stop_kind == 1 {
        i = stop_idx + 1
      } else if stop_kind == 3 {
        if stack.length() > 1 {
          pop_and_attach_frame(stack)
        }
        i = stop_idx + 1
      } else {
        i = stop_idx
      }
    }
  }

  // Close any unclosed blocks at EOF gracefully (CSS Syntax 3 fault tolerance)
  while stack.length() > 1 {
    pop_and_attach_frame(stack)
  }

  let _ = is_decl_at_rule("")
  Ok(Stylesheet::{ rules: stack[0].rules })
}

///| 100% iterative declaration list parser (e.g. inline `style` attribute).
pub fn parse_declarations_internal(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Declaration], CssError] {
  let clean = preprocess_string(src)
  let tokens = match tokenize_preprocessed(clean, opts) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match check_token_nesting_depth(tokens, opts.max_depth) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }

  let n = tokens.length()
  let decls : Array[Declaration] = []
  let mut i = 0
  while i < n {
    match tokens[i].kind {
      TokenKind::Whitespace | TokenKind::Semicolon => {
        i = i + 1
        continue
      }
      _ => ()
    }
    let item_start = i
    let (stop_idx, stop_kind) = scan_item(tokens, n, item_start)
    if stop_kind == 2 {
      // Skip unexpected '{...}' block to matching '}'
      let mut depth = 1
      let mut j = stop_idx + 1
      while j < n && depth > 0 {
        match tokens[j].kind {
          TokenKind::LeftCurly => depth = depth + 1
          TokenKind::RightCurly => depth = depth - 1
          _ => ()
        }
        j = j + 1
      }
      i = j
      continue
    }
    match parse_single_declaration(clean, tokens, item_start, stop_idx) {
      Some(d) => decls.push(d)
      None => ()
    }
    if stop_kind == 1 || stop_kind == 3 {
      i = stop_idx + 1
    } else {
      i = stop_idx
    }
  }
  Ok(decls)
}
