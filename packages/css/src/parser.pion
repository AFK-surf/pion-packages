///| 100% iterative, single-pass streaming CSS Syntax Level 3 stylesheet & declaration block parser.
///| Consumes tokens directly from `Lexer` without materializing an intermediate `Array[Token]`.

fn trim_ascii_ws(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n {
    let b = s.code_unit_at(start)
    if b == 32 || b == 9 || b == 10 || b == 13 || b == 12 {
      start = start + 1
    } else {
      break
    }
  }
  let mut end = n
  while end > start {
    let b = s.code_unit_at(end - 1)
    if b == 32 || b == 9 || b == 10 || b == 13 || b == 12 {
      end = end - 1
    } else {
      break
    }
  }
  if start == 0 && end == n {
    s
  } else {
    s.slice(start, end)
  }
}

fn is_ws_tok(t : Token) -> Bool {
  match t.kind {
    TokenKind::Whitespace => true
    _ => false
  }
}

///| Slice raw text from `src` covering tokens `[lo, hi)`, trimmed if `trim` is true.
fn slice_tokens_text(
  src : String,
  tokens : Array[Token],
  lo : Int,
  hi : Int,
  trim : Bool,
) -> String {
  if lo >= hi {
    return ""
  }
  let s = src.slice(tokens[lo].start, tokens[hi - 1].end)
  if trim {
    trim_ascii_ws(s)
  } else {
    s
  }
}

///| Validate balanced nesting depth of `()[]{}` across tokens (100% iterative, used by selector/media).
fn check_token_nesting_depth(
  tokens : Array[Token],
  max_depth : Int,
) -> Result[Unit, CssError] {
  let n = tokens.length()
  let mut depth = 0
  let mut i = 0
  while i < n {
    match tokens[i].kind {
      TokenKind::LeftCurly | TokenKind::LeftParen | TokenKind::LeftSquare | TokenKind::Function(_) => {
        depth = depth + 1
        if depth > max_depth {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              tokens[i].start,
              1,
              1,
              "nesting depth limit exceeded",
            ),
          )
        }
      }
      TokenKind::RightCurly | TokenKind::RightParen | TokenKind::RightSquare => {
        if depth > 0 {
          depth = depth - 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  Ok(())
}

///| Check whether an at-rule block is primarily a declaration list.
fn is_decl_at_rule(name : String) -> Bool {
  name == "font-face" ||
  name == "page" ||
  name == "property" ||
  name == "counter-style" ||
  name == "font-palette-values" ||
  name == "font-feature-values" ||
  name == "viewport"
}

///| Check whether an at-rule is a conditional/grouping rule (rules-only at top-level, mixed when nested).
fn is_group_at_rule(name : String) -> Bool {
  name == "media" ||
  name == "supports" ||
  name == "container" ||
  name == "layer" ||
  name == "document" ||
  name == "scope" ||
  name == "starting-style"
}

fn is_keyframes_at_rule(name : String) -> Bool {
  if name == "keyframes" {
    return true
  }
  let n = name.length()
  n > 10 && name.slice(n - 10, n) == "-keyframes"
}

///| Frame kinds and block content modes.
let FRAME_STYLESHEET : Int = 0
let FRAME_QUALIFIED : Int = 1
let FRAME_AT_RULE : Int = 2

let CTX_RULE_LIST : Int = 0 // Rules only (stylesheet root, top-level @media, @keyframes)
let CTX_BODY : Int = 1 // Declarations + nested rules (style rule body, nested @media)
let CTX_DECL_LIST : Int = 2 // Declarations only (@font-face, @page, inline style)

val struct ParseFrame {
  kind : Int
  ctx : Int
  nested : Bool
  name : String
  prelude : String
  decl_base : Int
  rule_base : Int
}

fn ParseFrame::new(
  kind : Int,
  ctx : Int,
  nested : Bool,
  name : String,
  prelude : String,
  decl_base : Int,
  rule_base : Int,
) -> ParseFrame {
  ParseFrame::{
    kind: kind,
    ctx: ctx,
    nested: nested,
    name: name,
    prelude: prelude,
    decl_base: decl_base,
    rule_base: rule_base,
  }
}

fn pop_and_attach_frame(
  stack : Array[ParseFrame],
  scratch_decls : Array[Declaration],
  scratch_rules : Array[Rule],
) -> Unit {
  if stack.length() <= 1 {
    return
  }
  let frame = stack[stack.length() - 1]
  let _ = stack.pop()
  let d_base = frame.decl_base
  let d_len = scratch_decls.length() - d_base
  let decls : Array[Declaration] = if d_len == 0 {
    []
  } else {
    let out : Array[Declaration] = Array::with_capacity(d_len)
    let mut k = 0
    while k < d_len {
      out.push(scratch_decls[d_base + k])
      k = k + 1
    }
    while scratch_decls.length() > d_base {
      let _ = scratch_decls.pop()
    }
    out
  }
  let r_base = frame.rule_base
  let r_len = scratch_rules.length() - r_base
  let rules : Array[Rule] = if r_len == 0 {
    []
  } else {
    let out : Array[Rule] = Array::with_capacity(r_len)
    let mut k = 0
    while k < r_len {
      out.push(scratch_rules[r_base + k])
      k = k + 1
    }
    while scratch_rules.length() > r_base {
      let _ = scratch_rules.pop()
    }
    out
  }
  if frame.kind == FRAME_QUALIFIED {
    let qr = QualifiedRule::{
      prelude: frame.prelude,
      declarations: decls,
      nested_rules: rules,
    }
    scratch_rules.push(Rule::Qualified(qr))
  } else if frame.kind == FRAME_AT_RULE {
    let ar = AtRule::{
      name: frame.name,
      prelude: frame.prelude,
      has_block: true,
      declarations: decls,
      rules: rules,
    }
    scratch_rules.push(Rule::At(ar))
  }
}

///| Check whether `(` at `lp_pos` is preceded by an unquoted `url` ident (no escapes).
fn is_unquoted_url_open(
  src : String,
  n : Int,
  lp_pos : Int,
  lut : FixedArray[Int],
) -> Bool {
  if lp_pos < 3 {
    return false
  }
  if (src.code_unit_at(lp_pos - 3) | 32) != 117 ||
  (src.code_unit_at(lp_pos - 2) | 32) != 114 ||
  (src.code_unit_at(lp_pos - 1) | 32) != 108 {
    return false
  }
  if lp_pos > 3 {
    let prev = src.code_unit_at(lp_pos - 4)
    if (lut[prev] & CH_IDENT) != 0 || prev == 92 {
      return false
    }
  }
  let mut p = lp_pos + 1
  while p < n && (lut[src.code_unit_at(p)] & CH_WS) != 0 {
    p = p + 1
  }
  !(p < n && (src.code_unit_at(p) == 34 || src.code_unit_at(p) == 39))
}

///| Skip whitespace and `/* ... */` comments starting at `pos`.
fn skip_ws_and_comments(
  src : String,
  n : Int,
  pos : Int,
  lut : FixedArray[Int],
) -> Int {
  let mut i = pos
  while i < n {
    let b = src.code_unit_at(i)
    if (lut[b] & CH_WS) != 0 {
      i = i + 1
      while i < n && (lut[src.code_unit_at(i)] & CH_WS) != 0 {
        i = i + 1
      }
    } else if b == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
      i = i + 2
      while i < n {
        if src.code_unit_at(i) == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
          i = i + 2
          break
        }
        i = i + 1
      }
    } else {
      break
    }
  }
  i
}

///| Fast byte-level prelude scanner (used when `!lex.check_limit`).
///| Sets `lex.pos` (after stop char), `lex.tok_start` (stop offset), `lex.tok_end` (`last_non_ws_end`).
///| Returns: 0 = EOF, 1 = `;`, 2 = `{`, 3 = `}`, -1 = LimitExceeded.
fn fast_scan_until(
  lex : Lexer,
  start_pos : Int,
  init_depth : Int,
  init_last_end : Int,
  stop_on_semi : Bool,
  stop_on_rcur : Bool,
  max_paren : Int,
) -> Int {
  let src = lex.src
  let n = lex.n
  let lut = lex.lut
  let safe = PRELUDE_SAFE_LUT
  let mut i = start_pos
  let mut paren_depth = init_depth
  let mut last_non_ws_end = init_last_end

  if paren_depth > max_paren {
    lex.err_offset = start_pos
    return -1
  }

  while i < n {
    let b = src.code_unit_at(i)
    if safe[b] != 0 {
      i = i + 1
      while i < n && safe[src.code_unit_at(i)] != 0 {
        i = i + 1
      }
      last_non_ws_end = i
      continue
    }
    if (lut[b] & CH_WS) != 0 {
      i = i + 1
      while i < n && (lut[src.code_unit_at(i)] & CH_WS) != 0 {
        i = i + 1
      }
      continue
    }
    if paren_depth == 0 {
      if b == 123 {
        lex.pos = i + 1
        lex.tok_start = i
        lex.tok_end = last_non_ws_end
        return 2
      }
      if stop_on_semi && b == 59 {
        lex.pos = i + 1
        lex.tok_start = i
        lex.tok_end = last_non_ws_end
        return 1
      }
      if stop_on_rcur && b == 125 {
        lex.pos = i + 1
        lex.tok_start = i
        lex.tok_end = last_non_ws_end
        return 3
      }
    }
    if b == 40 || b == 91 {
      if b == 40 && is_unquoted_url_open(src, n, i, lut) {
        let r = scan_url_end(src, n, i + 1, lut)
        i = if r >= 0 { r } else { -(r + 1) }
        last_non_ws_end = i
        continue
      }
      paren_depth = paren_depth + 1
      if paren_depth > max_paren {
        lex.err_offset = i
        return -1
      }
      i = i + 1
      last_non_ws_end = i
      continue
    }
    if b == 41 || b == 93 {
      if paren_depth > 0 {
        paren_depth = paren_depth - 1
      }
      i = i + 1
      last_non_ws_end = i
      continue
    }
    if b == 34 || b == 39 {
      let r = scan_string_end(src, n, i + 1, b)
      i = if r >= 0 { r } else { -(r + 1) }
      last_non_ws_end = i
      continue
    }
    if b == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
      i = i + 2
      while i < n {
        if src.code_unit_at(i) == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
          i = i + 2
          break
        }
        i = i + 1
      }
      continue
    }
    if b == 92 && is_valid_escape_at(src, n, i) {
      let esc_start = i
      i = skip_escape(src, n, i + 1)
      // Check if this escape is part of an escaped `url(`
      while i < n {
        let c = src.code_unit_at(i)
        if (lut[c] & CH_IDENT) != 0 {
          i = i + 1
        } else if c == 92 && is_valid_escape_at(src, n, i) {
          i = skip_escape(src, n, i + 1)
        } else {
          break
        }
      }
      if i < n && src.code_unit_at(i) == 40 {
        let mut id_start = esc_start
        while id_start > 0 && (lut[src.code_unit_at(id_start - 1)] & CH_IDENT) != 0 {
          id_start = id_start - 1
        }
        let (id_str, _) = consume_ident_seq(src, n, id_start, lut)
        if ascii_eq_ignore_case(id_str, "url") {
          let mut p = i + 1
          while p < n && (lut[src.code_unit_at(p)] & CH_WS) != 0 {
            p = p + 1
          }
          if !(p < n && (src.code_unit_at(p) == 34 || src.code_unit_at(p) == 39)) {
            let r = scan_url_end(src, n, i + 1, lut)
            i = if r >= 0 { r } else { -(r + 1) }
          }
        }
      }
      last_non_ws_end = i
      continue
    }
    i = i + 1
    last_non_ws_end = i
  }

  lex.pos = n
  lex.tok_start = n
  lex.tok_end = last_non_ws_end
  0
}

///| Fast byte-level declaration value parser (used when `!lex.check_limit`).
///| Pushes directly into `out_decls` and returns stop_kind: 0=EOF, 1=';', 2='{', 3='}', -1=LimitExceeded.
fn fast_parse_decl_value(
  lex : Lexer,
  prop_name : String,
  is_custom : Bool,
  after_rule : Int,
  max_paren : Int,
  allow_nested : Bool,
  out_decls : Array[Declaration],
) -> Int {
  let src = lex.src
  let n = lex.n
  let lut = lex.lut
  let safe = DECL_SAFE_LUT
  let mut i = lex.pos
  let mut saw_any_ws = false

  // Skip leading whitespace and comments
  while i < n {
    let b = src.code_unit_at(i)
    if (lut[b] & CH_WS) != 0 {
      saw_any_ws = true
      i = i + 1
      while i < n && (lut[src.code_unit_at(i)] & CH_WS) != 0 {
        i = i + 1
      }
    } else if b == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
      i = i + 2
      while i < n {
        if src.code_unit_at(i) == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
          i = i + 2
          break
        }
        i = i + 1
      }
    } else {
      break
    }
  }

  // Empty declaration fast path
  if i >= n {
    lex.pos = n
    lex.tok_start = n
    let value = if is_custom && saw_any_ws { " " } else { "" }
    out_decls.push(Declaration::new_at(prop_name, value, false, is_custom, after_rule))
    return 0
  }
  let fb = src.code_unit_at(i)
  if fb == 59 {
    lex.pos = i + 1
    lex.tok_start = i
    let value = if is_custom && saw_any_ws { " " } else { "" }
    out_decls.push(Declaration::new_at(prop_name, value, false, is_custom, after_rule))
    return 1
  }
  if fb == 125 {
    lex.pos = i + 1
    lex.tok_start = i
    let value = if is_custom && saw_any_ws { " " } else { "" }
    out_decls.push(Declaration::new_at(prop_name, value, false, is_custom, after_rule))
    return 3
  }

  let first_non_ws = i
  let mut last_non_ws_end = -1
  let mut depth = 0
  let mut has_bad = false
  let mut saw_other = false
  let mut saw_top_curly = false

  while i < n {
    let b = src.code_unit_at(i)
    if safe[b] != 0 {
      if depth == 0 {
        if !is_custom && saw_top_curly {
          has_bad = true
        } else {
          saw_other = true
        }
      }
      i = i + 1
      while i < n && safe[src.code_unit_at(i)] != 0 {
        i = i + 1
      }
      last_non_ws_end = i
      continue
    }
    if (lut[b] & CH_WS) != 0 {
      saw_any_ws = true
      i = i + 1
      while i < n && (lut[src.code_unit_at(i)] & CH_WS) != 0 {
        i = i + 1
      }
      continue
    }
    if depth == 0 {
      if b == 59 {
        lex.pos = i + 1
        lex.tok_start = i
        if !has_bad {
          let value = if last_non_ws_end > first_non_ws {
            src.slice(first_non_ws, last_non_ws_end)
          } else if is_custom && saw_any_ws {
            " "
          } else {
            ""
          }
          out_decls.push(Declaration::new_at(prop_name, value, false, is_custom, after_rule))
        }
        return 1
      }
      if b == 125 {
        lex.pos = i + 1
        lex.tok_start = i
        if !has_bad {
          let value = if last_non_ws_end > first_non_ws {
            src.slice(first_non_ws, last_non_ws_end)
          } else if is_custom && saw_any_ws {
            " "
          } else {
            ""
          }
          out_decls.push(Declaration::new_at(prop_name, value, false, is_custom, after_rule))
        }
        return 3
      }
      if b == 123 {
        if !is_custom && allow_nested && (saw_other || saw_top_curly) {
          lex.pos = i + 1
          lex.tok_start = i
          return 2
        }
        saw_top_curly = true
        depth = 1
        if depth > max_paren {
          lex.err_offset = i
          return -1
        }
        i = i + 1
        last_non_ws_end = i
        continue
      }
      if b == 33 {
        // Possible `!important` at end of declaration
        let before_bang = last_non_ws_end
        let p = skip_ws_and_comments(src, n, i + 1, lut)
        if p < n && ((lut[src.code_unit_at(p)] & CH_IDENT_START) != 0 || (src.code_unit_at(p) == 92 && is_valid_escape_at(src, n, p))) {
          let r = scan_ident_end(src, n, p, lut)
          let (imp_end, imp_esc) = if r >= 0 { (r, false) } else { (-(r + 1), true) }
          if is_important_ident(src, p, imp_end, imp_esc, lut) {
            let q = skip_ws_and_comments(src, n, imp_end, lut)
            if q >= n || src.code_unit_at(q) == 59 || src.code_unit_at(q) == 125 {
              let stop_k = if q >= n {
                0
              } else if src.code_unit_at(q) == 59 {
                1
              } else {
                3
              }
              lex.pos = if q < n { q + 1 } else { n }
              lex.tok_start = q
              if !has_bad {
                let value = if before_bang > first_non_ws {
                  src.slice(first_non_ws, before_bang)
                } else if is_custom && saw_any_ws {
                  " "
                } else {
                  ""
                }
                out_decls.push(Declaration::new_at(prop_name, value, true, is_custom, after_rule))
              }
              return stop_k
            }
          }
        }
        if !is_custom && saw_top_curly {
          has_bad = true
        } else {
          saw_other = true
        }
        i = i + 1
        last_non_ws_end = i
        continue
      }
    }
    if b == 40 || b == 91 || b == 123 {
      if b == 40 && is_unquoted_url_open(src, n, i, lut) {
        let r = scan_url_end(src, n, i + 1, lut)
        if r < 0 {
          has_bad = true
          i = -(r + 1)
        } else {
          i = r
        }
        if depth == 0 {
          if !is_custom && saw_top_curly {
            has_bad = true
          } else {
            saw_other = true
          }
        }
        last_non_ws_end = i
        continue
      }
      depth = depth + 1
      if depth > max_paren {
        lex.err_offset = i
        return -1
      }
      if depth == 1 {
        saw_other = true
      }
      i = i + 1
      last_non_ws_end = i
      continue
    }
    if b == 41 || b == 93 || b == 125 {
      if depth > 0 {
        depth = depth - 1
      }
      i = i + 1
      last_non_ws_end = i
      continue
    }
    if b == 34 || b == 39 {
      let r = scan_string_end(src, n, i + 1, b)
      if r < 0 {
        has_bad = true
        i = -(r + 1)
      } else {
        i = r
      }
      if depth == 0 {
        if !is_custom && saw_top_curly {
          has_bad = true
        } else {
          saw_other = true
        }
      }
      last_non_ws_end = i
      continue
    }
    if b == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
      i = i + 2
      while i < n {
        if src.code_unit_at(i) == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
          i = i + 2
          break
        }
        i = i + 1
      }
      continue
    }
    if b == 92 && is_valid_escape_at(src, n, i) {
      let esc_start = i
      if depth == 0 {
        if !is_custom && saw_top_curly {
          has_bad = true
        } else {
          saw_other = true
        }
      }
      i = skip_escape(src, n, i + 1)
      while i < n {
        let c = src.code_unit_at(i)
        if (lut[c] & CH_IDENT) != 0 {
          i = i + 1
        } else if c == 92 && is_valid_escape_at(src, n, i) {
          i = skip_escape(src, n, i + 1)
        } else {
          break
        }
      }
      if i < n && src.code_unit_at(i) == 40 {
        let mut id_start = esc_start
        while id_start > 0 && (lut[src.code_unit_at(id_start - 1)] & CH_IDENT) != 0 {
          id_start = id_start - 1
        }
        let (id_str, _) = consume_ident_seq(src, n, id_start, lut)
        if ascii_eq_ignore_case(id_str, "url") {
          let mut p = i + 1
          while p < n && (lut[src.code_unit_at(p)] & CH_WS) != 0 {
            p = p + 1
          }
          if !(p < n && (src.code_unit_at(p) == 34 || src.code_unit_at(p) == 39)) {
            let r = scan_url_end(src, n, i + 1, lut)
            if r < 0 {
              has_bad = true
              i = -(r + 1)
            } else {
              i = r
            }
          }
        }
      }
      last_non_ws_end = i
      continue
    }
    if depth == 0 {
      if !is_custom && saw_top_curly {
        has_bad = true
      } else {
        saw_other = true
      }
    }
    i = i + 1
    last_non_ws_end = i
  }

  lex.pos = n
  lex.tok_start = n
  if !has_bad {
    let value = if last_non_ws_end > first_non_ws {
      src.slice(first_non_ws, last_non_ws_end)
    } else if is_custom && saw_any_ws {
      " "
    } else {
      ""
    }
    out_decls.push(Declaration::new_at(prop_name, value, false, is_custom, after_rule))
  }
  0
}

fn compute_paren_limit(max_depth : Int) -> Int {
  if max_depth >= 256 {
    max_depth * 4
  } else {
    max_depth
  }
}

///| Strip trailing comments and whitespace from `src[start..end)` (fast path when no `*/` at end).
fn trim_raw_slice(src : String, start : Int, end : Int) -> String {
  if start >= end {
    return ""
  }
  trim_ascii_ws(src.slice(start, end))
}

///| Consume a declaration value after `:` has been read from `lex`.
///| For custom properties (`is_custom == true`), `{}` blocks are kept as part of the value
///| and only top-level `;`, `}`, or EOF terminates the declaration.
///| For standard properties (`is_custom == false`), hitting `{` at depth 0:
///|   - if `saw_other` is true, returns `Ok((2, lcur_start, None))` so caller can open a nested QualifiedRule;
///|   - if `saw_other` is false (e.g. `color:{red};`), consumes the `{}` block as a declaration value.
///| Returns `(stop_kind, stop_offset, Option[Declaration])`:
///|   stop_kind: 0 = EOF, 1 = `;`, 2 = `{` (nested rule fallback), 3 = `}`.
fn stream_parse_decl_value(
  lex : Lexer,
  prop_name : String,
  is_custom : Bool,
  after_rule : Int,
  max_paren : Int,
  allow_nested_rule : Bool,
) -> Result[(Int, Int, Option[Declaration]), CssError] {
  let clean = lex.src
  let mut depth = 0
  let mut has_bad = false
  let mut saw_any_ws = false
  let mut saw_other = false
  let mut saw_top_curly = false

  // Track first and last non-WS token spans, plus last 2 non-WS tokens at depth 0 for `!important`.
  let mut first_non_ws = -1
  let mut last_non_ws_end = -1
  let mut prev2_kind = TK_EOF
  let mut prev2_end = -1
  let mut prev1_kind = TK_EOF
  let mut prev1_start = -1
  let mut prev1_end = -1
  let mut prev1_is_bang = false
  let mut prev1_is_imp = false
  let mut prev2_is_bang = false
  let mut prev3_end = -1

  while true {
    let tk = lex.next_fast()
    if tk < 0 {
      return Err(lex.limit_err())
    }
    if tk == TK_EOF {
      break
    }
    if depth == 0 {
      if tk == TK_SEMI {
        return Ok(
          (
            1,
            lex.tok_start,
            finalize_decl(
              clean,
              prop_name,
              is_custom,
              after_rule,
              has_bad,
              saw_any_ws,
              first_non_ws,
              last_non_ws_end,
              prev1_is_imp && prev2_is_bang,
              prev3_end,
            ),
          ),
        )
      }
      if tk == TK_RCUR {
        return Ok(
          (
            3,
            lex.tok_start,
            finalize_decl(
              clean,
              prop_name,
              is_custom,
              after_rule,
              has_bad,
              saw_any_ws,
              first_non_ws,
              last_non_ws_end,
              prev1_is_imp && prev2_is_bang,
              prev3_end,
            ),
          ),
        )
      }
      if tk == TK_LCUR {
        if !is_custom && allow_nested_rule && (saw_other || saw_top_curly) {
          return Ok((2, lex.tok_start, None))
        }
        saw_top_curly = true
        depth = depth + 1
        if depth > max_paren {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              lex.tok_start,
              1,
              1,
              "nesting depth limit exceeded",
            ),
          )
        }
        if first_non_ws < 0 {
          first_non_ws = lex.tok_start
        }
        // Shift trailing token history (reset !important match since we entered a block)
        prev3_end = prev2_end
        prev2_kind = prev1_kind
        prev2_end = prev1_end
        prev2_is_bang = prev1_is_bang
        prev1_kind = TK_LCUR
        prev1_start = lex.tok_start
        prev1_end = lex.tok_end
        prev1_is_bang = false
        prev1_is_imp = false
        last_non_ws_end = lex.tok_end
        continue
      }
    }

    if tk == TK_WS {
      saw_any_ws = true
      continue
    }

    if tk == TK_BADSTR || tk == TK_BADURL {
      has_bad = true
    }

    if tk == TK_LPAR || tk == TK_LSQ || tk == TK_FUNC || tk == TK_LCUR {
      depth = depth + 1
      if depth > max_paren {
        return Err(
          CssError::new(
            CssErrorKind::LimitExceeded,
            lex.tok_start,
            1,
            1,
            "nesting depth limit exceeded",
          ),
        )
      }
      if depth == 1 {
        saw_other = true
        if first_non_ws < 0 {
          first_non_ws = lex.tok_start
        }
        prev3_end = prev2_end
        prev2_kind = prev1_kind
        prev2_end = prev1_end
        prev2_is_bang = prev1_is_bang
        prev1_kind = tk
        prev1_start = lex.tok_start
        prev1_end = lex.tok_end
        prev1_is_bang = false
        prev1_is_imp = false
      }
      last_non_ws_end = lex.tok_end
      continue
    }

    if tk == TK_RPAR || tk == TK_RSQ || tk == TK_RCUR {
      if depth > 0 {
        depth = depth - 1
      }
      last_non_ws_end = lex.tok_end
      if depth == 0 {
        prev1_end = lex.tok_end
      }
      continue
    }

    // Regular non-WS token
    if depth == 0 {
      if !is_custom && saw_top_curly {
        // Non-custom property had a `{}` block followed by another token; check if it's `!important`
        let is_bang = tk == TK_DELIM && lex.tok_end - lex.tok_start == 1 && clean.code_unit_at(lex.tok_start) == 33
        let is_imp = tk == TK_IDENT && is_important_ident(clean, lex.tok_start, lex.tok_end, lex.tok_has_esc, lex.lut)
        if !is_bang && !(is_imp && prev1_is_bang) {
          has_bad = true
        }
      } else {
        saw_other = true
      }
      if first_non_ws < 0 {
        first_non_ws = lex.tok_start
      }
      let is_bang = tk == TK_DELIM && lex.tok_end - lex.tok_start == 1 && clean.code_unit_at(lex.tok_start) == 33
      let is_imp = prev1_is_bang && tk == TK_IDENT && is_important_ident(clean, lex.tok_start, lex.tok_end, lex.tok_has_esc, lex.lut)
      prev3_end = prev2_end
      prev2_kind = prev1_kind
      prev2_end = prev1_end
      prev2_is_bang = prev1_is_bang
      prev1_kind = tk
      prev1_start = lex.tok_start
      prev1_end = lex.tok_end
      prev1_is_bang = is_bang
      prev1_is_imp = is_imp
    }
    last_non_ws_end = lex.tok_end
  }

  let _ = prev1_start
  let _ = prev2_kind
  Ok(
    (
      0,
      lex.n,
      finalize_decl(
        clean,
        prop_name,
        is_custom,
        after_rule,
        has_bad,
        saw_any_ws,
        first_non_ws,
        last_non_ws_end,
        prev1_is_imp && prev2_is_bang,
        prev3_end,
      ),
    ),
  )
}

fn finalize_decl(
  clean : String,
  prop_name : String,
  is_custom : Bool,
  after_rule : Int,
  has_bad : Bool,
  saw_any_ws : Bool,
  first_non_ws : Int,
  last_non_ws_end : Int,
  important : Bool,
  end_before_imp : Int,
) -> Option[Declaration] {
  if has_bad {
    return None
  }
  let val_end = if important { end_before_imp } else { last_non_ws_end }
  let value = if first_non_ws >= 0 && val_end > first_non_ws {
    clean.slice(first_non_ws, val_end)
  } else if is_custom && saw_any_ws {
    // CSS Variables 1: whitespace-only custom property normalizes to single space " "
    " "
  } else {
    ""
  }
  Some(Declaration::new_at(prop_name, value, important, is_custom, after_rule))
}

///| Scan forward from current lexer state until `{`, `;`, `}`, or EOF at `paren_depth == 0`.
///| `stop_on_semi`: false in `CTX_RULE_LIST` for qualified rule preludes (CSS Syntax 3 §5.4.3).
///| `stop_on_rcur`: false at top-level stylesheet (stray `}` is part of prelude per CSS Syntax 3).
///| Returns `(stop_kind, stop_offset, last_non_ws_end)`:
///|   stop_kind: 0 = EOF, 1 = `;`, 2 = `{`, 3 = `}`.
fn stream_scan_until(
  lex : Lexer,
  first_tk : Int,
  first_start : Int,
  first_end : Int,
  stop_on_semi : Bool,
  stop_on_rcur : Bool,
  max_paren : Int,
) -> Result[(Int, Int, Int), CssError] {
  let mut paren_depth = 0
  let mut tk = first_tk
  let mut tstart = first_start
  let mut tend = first_end
  let mut last_non_ws_end = -1

  while true {
    if tk == TK_EOF {
      return Ok((0, lex.n, last_non_ws_end))
    }
    if paren_depth == 0 {
      if tk == TK_LCUR {
        return Ok((2, tstart, last_non_ws_end))
      }
      if stop_on_semi && tk == TK_SEMI {
        return Ok((1, tstart, last_non_ws_end))
      }
      if stop_on_rcur && tk == TK_RCUR {
        return Ok((3, tstart, last_non_ws_end))
      }
    }
    if tk == TK_LPAR || tk == TK_LSQ || tk == TK_FUNC {
      paren_depth = paren_depth + 1
      if paren_depth > max_paren {
        return Err(
          CssError::new(
            CssErrorKind::LimitExceeded,
            tstart,
            1,
            1,
            "nesting depth limit exceeded",
          ),
        )
      }
    } else if tk == TK_RPAR || tk == TK_RSQ {
      if paren_depth > 0 {
        paren_depth = paren_depth - 1
      }
    }
    if tk != TK_WS {
      last_non_ws_end = tend
    }
    tk = lex.next_fast()
    if tk < 0 {
      return Err(lex.limit_err())
    }
    tstart = lex.tok_start
    tend = lex.tok_end
  }
  Ok((0, lex.n, last_non_ws_end))
}

///| Helper to scan a prelude either via `fast_scan_until` or `stream_scan_until` depending on `lex.check_limit`.
///| Sets `lex.tok_start` = stop_offset and `lex.tok_end` = last_non_ws_end.
///| Returns `Ok(stop_kind)` (0=EOF, 1=';', 2='{', 3='}').
fn scan_prelude_unified(
  lex : Lexer,
  first_tk : Int,
  first_start : Int,
  first_end : Int,
  stop_on_semi : Bool,
  stop_on_rcur : Bool,
  max_paren : Int,
) -> Result[Int, CssError] {
  if !lex.check_limit {
    if first_tk == TK_EOF {
      lex.tok_start = lex.n
      lex.tok_end = -1
      return Ok(0)
    }
    if first_tk == TK_LCUR {
      lex.tok_start = first_start
      lex.tok_end = -1
      return Ok(2)
    }
    if stop_on_semi && first_tk == TK_SEMI {
      lex.tok_start = first_start
      lex.tok_end = -1
      return Ok(1)
    }
    if stop_on_rcur && first_tk == TK_RCUR {
      lex.tok_start = first_start
      lex.tok_end = -1
      return Ok(3)
    }
    let init_depth = if first_tk == TK_LPAR || first_tk == TK_LSQ || first_tk == TK_FUNC {
      1
    } else {
      0
    }
    let init_last = if first_tk != TK_WS { first_end } else { -1 }
    let sk = fast_scan_until(
      lex,
      lex.pos,
      init_depth,
      init_last,
      stop_on_semi,
      stop_on_rcur,
      max_paren,
    )
    if sk < 0 {
      return Err(
        CssError::new(
          CssErrorKind::LimitExceeded,
          lex.err_offset,
          1,
          1,
          "nesting depth limit exceeded",
        ),
      )
    }
    return Ok(sk)
  }
  let (stop_kind, stop_off, last_end) = match stream_scan_until(
    lex,
    first_tk,
    first_start,
    first_end,
    stop_on_semi,
    stop_on_rcur,
    max_paren,
  ) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  lex.tok_start = stop_off
  lex.tok_end = last_end
  Ok(stop_kind)
}

///| Scan a property name in `clean[start..end)` lowercasing only if uppercase ASCII or escapes are present.
fn decode_prop_name(
  clean : String,
  start : Int,
  end : Int,
  has_esc : Bool,
  is_custom : Bool,
  lut : FixedArray[Int],
) -> String {
  if has_esc {
    let raw = decode_ident_slice(clean, start, end, true, lut)
    if is_custom { raw } else { ascii_lower(raw) }
  } else if is_custom {
    clean.slice(start, end)
  } else {
    let mut i = start
    let mut has_upper = false
    while i < end {
      let b = clean.code_unit_at(i)
      if b >= 65 && b <= 90 {
        has_upper = true
        break
      }
      i = i + 1
    }
    if !has_upper {
      clean.slice(start, end)
    } else {
      let sb = StringBuilder::with_capacity(end - start)
      let mut k = start
      while k < end {
        let b = clean.code_unit_at(k)
        if b >= 65 && b <= 90 {
          sb.write_byte((b + 32).to_byte())
        } else {
          sb.write_byte(b.to_byte())
        }
        k = k + 1
      }
      sb.to_string()
    }
  }
}

///| 100% iterative, single-pass streaming stylesheet parser.
pub fn parse_stylesheet_internal(
  src : String,
  opts : ParseOptions,
) -> Result[Stylesheet, CssError] {
  let clean = preprocess_string(src)
  let lex = Lexer::new(clean, opts.max_tokens)
  let max_paren = compute_paren_limit(opts.max_depth)
  let stack : Array[ParseFrame] = Array::with_capacity(16)
  stack.push(ParseFrame::new(FRAME_STYLESHEET, CTX_RULE_LIST, false, "", "", 0, 0))
  let scratch_decls : Array[Declaration] = Array::with_capacity(64)
  let init_rules = if clean.length() > 1024 { clean.length() / 128 } else { 16 }
  let scratch_rules : Array[Rule] = Array::with_capacity(init_rules)
  let mut rule_count = 0

  while true {
    let tk = lex.next_fast()
    if tk < 0 {
      return Err(lex.limit_err())
    }
    if tk == TK_EOF {
      break
    }

    // Whitespace is always skipped between items
    if tk == TK_WS {
      continue
    }

    let s_len = stack.length()
    let cur_frame = stack[s_len - 1]
    let at_root = s_len == 1

    // CDO / CDC are ONLY skipped at top-level stylesheet (CSS Syntax 3 §5.4.1)
    if at_root && (tk == TK_CDO || tk == TK_CDC) {
      continue
    }

    // Inside a block: '}' closes the current block, ';' is an empty statement
    if !at_root {
      if tk == TK_RCUR {
        pop_and_attach_frame(stack, scratch_decls, scratch_rules)
        continue
      }
      if tk == TK_SEMI && cur_frame.ctx != CTX_RULE_LIST {
        continue
      }
    }

    // At-rule
    if tk == TK_AT {
      rule_count = rule_count + 1
      if rule_count > opts.max_rules {
        return Err(
          CssError::new(
            CssErrorKind::LimitExceeded,
            lex.tok_start,
            1,
            1,
            "rule limit exceeded",
          ),
        )
      }
      let at_name = decode_prop_name(clean, lex.tok_start + 1, lex.tok_end, lex.tok_has_esc, false, lex.lut)
      let mut p_tk = lex.next_fast()
      if p_tk < 0 {
        return Err(lex.limit_err())
      }
      while p_tk == TK_WS {
        p_tk = lex.next_fast()
        if p_tk < 0 {
          return Err(lex.limit_err())
        }
      }
      let p_start = lex.tok_start
      let stop_kind = match scan_prelude_unified(
        lex,
        p_tk,
        lex.tok_start,
        lex.tok_end,
        true,
        !at_root,
        max_paren,
      ) {
        Ok(k) => k
        Err(e) => return Err(e)
      }
      let p_end = lex.tok_end
      let prelude = if p_end > p_start {
        trim_raw_slice(clean, p_start, p_end)
      } else {
        ""
      }
      if stop_kind == 2 {
        // '{' -> open at-rule block
        if stack.length() > opts.max_depth {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              lex.tok_start,
              1,
              1,
              "nesting depth limit exceeded",
            ),
          )
        }
        let child_ctx = if is_decl_at_rule(at_name) {
          CTX_DECL_LIST
        } else if is_keyframes_at_rule(at_name) {
          CTX_RULE_LIST
        } else if is_group_at_rule(at_name) {
          if cur_frame.nested { CTX_BODY } else { CTX_RULE_LIST }
        } else {
          CTX_BODY
        }
        let child_nested = cur_frame.nested || child_ctx == CTX_BODY
        stack.push(
          ParseFrame::new(
            FRAME_AT_RULE,
            child_ctx,
            child_nested,
            at_name,
            prelude,
            scratch_decls.length(),
            scratch_rules.length(),
          ),
        )
      } else {
        // Statement at-rule (';', '}', or EOF)
        let ar = AtRule::{
          name: at_name,
          prelude: prelude,
          has_block: false,
          declarations: [],
          rules: [],
        }
        scratch_rules.push(Rule::At(ar))
        if stop_kind == 3 && !at_root {
          pop_and_attach_frame(stack, scratch_decls, scratch_rules)
        }
      }
      continue
    }

    // In CTX_RULE_LIST (top-level or top-level @media / @keyframes): qualified rule only!
    if cur_frame.ctx == CTX_RULE_LIST {
      let item_start = lex.tok_start
      let stop_kind = match scan_prelude_unified(
        lex,
        tk,
        lex.tok_start,
        lex.tok_end,
        false,
        !at_root,
        max_paren,
      ) {
        Ok(k) => k
        Err(e) => return Err(e)
      }
      let item_end = lex.tok_end
      if stop_kind == 2 {
        rule_count = rule_count + 1
        if rule_count > opts.max_rules {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              item_start,
              1,
              1,
              "rule limit exceeded",
            ),
          )
        }
        if stack.length() > opts.max_depth {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              lex.tok_start,
              1,
              1,
              "nesting depth limit exceeded",
            ),
          )
        }
        let prelude = if item_end > item_start {
          clean.slice(item_start, item_end)
        } else {
          ""
        }
        stack.push(
          ParseFrame::new(
            FRAME_QUALIFIED,
            CTX_BODY,
            true,
            "",
            prelude,
            scratch_decls.length(),
            scratch_rules.length(),
          ),
        )
      } else if stop_kind == 3 && !at_root {
        pop_and_attach_frame(stack, scratch_decls, scratch_rules)
      }
      continue
    }

    // Inside CTX_BODY or CTX_DECL_LIST: try declaration if starts with Ident + ':'
    let item_start = lex.tok_start
    let item_end_first = lex.tok_end
    if tk == TK_IDENT {
      let name_has_esc = lex.tok_has_esc
      let mut is_colon = false
      let mut next_tk = TK_EOF
      if !lex.check_limit && lex.pos < lex.n && clean.code_unit_at(lex.pos) == 58 {
        lex.pos = lex.pos + 1
        is_colon = true
      } else {
        next_tk = lex.next_fast()
        if next_tk < 0 {
          return Err(lex.limit_err())
        }
        while next_tk == TK_WS {
          next_tk = lex.next_fast()
          if next_tk < 0 {
            return Err(lex.limit_err())
          }
        }
        is_colon = next_tk == TK_COLON
      }
      if is_colon {
        let is_custom = if !name_has_esc {
          item_end_first - item_start >= 2 &&
          clean.code_unit_at(item_start) == 45 &&
          clean.code_unit_at(item_start + 1) == 45
        } else {
          let tmp = decode_ident_slice(clean, item_start, item_end_first, true, lex.lut)
          tmp.length() >= 2 && tmp.code_unit_at(0) == 45 && tmp.code_unit_at(1) == 45
        }
        let prop_name = decode_prop_name(clean, item_start, item_end_first, name_has_esc, is_custom, lex.lut)
        let allow_nested = cur_frame.ctx == CTX_BODY
        let after_rule = scratch_rules.length() - cur_frame.rule_base
        let stop_kind = if !lex.check_limit {
          let sk = fast_parse_decl_value(
            lex,
            prop_name,
            is_custom,
            after_rule,
            max_paren,
            allow_nested,
            scratch_decls,
          )
          if sk < 0 {
            return Err(
              CssError::new(
                CssErrorKind::LimitExceeded,
                lex.err_offset,
                1,
                1,
                "nesting depth limit exceeded",
              ),
            )
          }
          sk
        } else {
          let (sk, stop_off, decl_opt) = match stream_parse_decl_value(
            lex,
            prop_name,
            is_custom,
            after_rule,
            max_paren,
            allow_nested,
          ) {
            Ok(r) => r
            Err(e) => return Err(e)
          }
          lex.tok_start = stop_off
          if sk != 2 {
            match decl_opt {
              Some(decl) => scratch_decls.push(decl)
              None => ()
            }
          }
          sk
        }
        if stop_kind == 2 {
          // Fallback to nested QualifiedRule (e.g. `a:hover { ... }`)
          let stop_off = lex.tok_start
          rule_count = rule_count + 1
          if rule_count > opts.max_rules {
            return Err(
              CssError::new(
                CssErrorKind::LimitExceeded,
                item_start,
                1,
                1,
                "rule limit exceeded",
              ),
            )
          }
          if stack.length() > opts.max_depth {
            return Err(
              CssError::new(
                CssErrorKind::LimitExceeded,
                stop_off,
                1,
                1,
                "nesting depth limit exceeded",
              ),
            )
          }
          let prelude = trim_raw_slice(clean, item_start, stop_off)
          stack.push(
            ParseFrame::new(
              FRAME_QUALIFIED,
              CTX_BODY,
              true,
              "",
              prelude,
              scratch_decls.length(),
              scratch_rules.length(),
            ),
          )
        } else if stop_kind == 3 {
          pop_and_attach_frame(stack, scratch_decls, scratch_rules)
        }
        continue
      }
      // Ident not followed by ':' -> scan rest of item (might be a nested rule like `div > p { ... }`)
      let stop_kind = match scan_prelude_unified(
        lex,
        next_tk,
        lex.tok_start,
        lex.tok_end,
        true,
        true,
        max_paren,
      ) {
        Ok(k) => k
        Err(e) => return Err(e)
      }
      let item_end = lex.tok_end
      if stop_kind == 2 {
        if cur_frame.ctx == CTX_BODY {
          rule_count = rule_count + 1
          if rule_count > opts.max_rules {
            return Err(
              CssError::new(
                CssErrorKind::LimitExceeded,
                item_start,
                1,
                1,
                "rule limit exceeded",
              ),
            )
          }
          if stack.length() > opts.max_depth {
            return Err(
              CssError::new(
                CssErrorKind::LimitExceeded,
                lex.tok_start,
                1,
                1,
                "nesting depth limit exceeded",
              ),
            )
          }
          let end_pos = if item_end > item_start { item_end } else { item_end_first }
          let prelude = trim_raw_slice(clean, item_start, end_pos)
          stack.push(
            ParseFrame::new(
              FRAME_QUALIFIED,
              CTX_BODY,
              true,
              "",
              prelude,
              scratch_decls.length(),
              scratch_rules.length(),
            ),
          )
        } else {
          // CTX_DECL_LIST: skip unexpected `{...}` block
          match skip_balanced_curly(lex, max_paren) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
        }
      } else if stop_kind == 3 {
        pop_and_attach_frame(stack, scratch_decls, scratch_rules)
      }
      continue
    }

    // Non-ident start inside CTX_BODY or CTX_DECL_LIST (e.g. `&:hover { ... }`, `.child { ... }`, `<!-- ...`)
    let stop_kind = match scan_prelude_unified(
      lex,
      tk,
      lex.tok_start,
      lex.tok_end,
      true,
      true,
      max_paren,
    ) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    let item_end = lex.tok_end
    if stop_kind == 2 {
      if cur_frame.ctx == CTX_BODY {
        rule_count = rule_count + 1
        if rule_count > opts.max_rules {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              item_start,
              1,
              1,
              "rule limit exceeded",
            ),
          )
        }
        if stack.length() > opts.max_depth {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              lex.tok_start,
              1,
              1,
              "nesting depth limit exceeded",
            ),
          )
        }
        let prelude = if item_end > item_start {
          clean.slice(item_start, item_end)
        } else {
          ""
        }
        stack.push(
          ParseFrame::new(
            FRAME_QUALIFIED,
            CTX_BODY,
            true,
            "",
            prelude,
            scratch_decls.length(),
            scratch_rules.length(),
          ),
        )
      } else {
        match skip_balanced_curly(lex, max_paren) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
    } else if stop_kind == 3 {
      pop_and_attach_frame(stack, scratch_decls, scratch_rules)
    }
  }

  // Close any unclosed blocks at EOF gracefully (CSS Syntax 3 fault tolerance)
  while stack.length() > 1 {
    pop_and_attach_frame(stack, scratch_decls, scratch_rules)
  }
  Ok(Stylesheet::{ rules: scratch_rules })
}

fn skip_balanced_curly(lex : Lexer, max_paren : Int) -> Result[Unit, CssError] {
  let mut depth = 1
  while depth > 0 {
    let tk = lex.next_fast()
    if tk < 0 {
      return Err(lex.limit_err())
    }
    if tk == TK_EOF {
      return Ok(())
    }
    if tk == TK_LCUR || tk == TK_LPAR || tk == TK_LSQ || tk == TK_FUNC {
      depth = depth + 1
      if depth > max_paren {
        return Err(
          CssError::new(
            CssErrorKind::LimitExceeded,
            lex.tok_start,
            1,
            1,
            "nesting depth limit exceeded",
          ),
        )
      }
    } else if tk == TK_RCUR || tk == TK_RPAR || tk == TK_RSQ {
      depth = depth - 1
    }
  }
  Ok(())
}

///| 100% iterative, single-pass streaming declaration list parser (e.g. inline `style` attribute).
pub fn parse_declarations_internal(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Declaration], CssError] {
  let clean = preprocess_string(src)
  let lex = Lexer::new(clean, opts.max_tokens)
  let max_paren = compute_paren_limit(opts.max_depth)
  let decls : Array[Declaration] = []

  while true {
    let tk = lex.next_fast()
    if tk < 0 {
      return Err(lex.limit_err())
    }
    if tk == TK_EOF {
      break
    }
    if tk == TK_WS || tk == TK_SEMI {
      continue
    }
    if tk == TK_AT {
      // Skip at-rule in declaration list
      let next_tk = lex.next_fast()
      if next_tk < 0 {
        return Err(lex.limit_err())
      }
      let stop_kind = match scan_prelude_unified(
        lex,
        next_tk,
        lex.tok_start,
        lex.tok_end,
        true,
        false,
        max_paren,
      ) {
        Ok(k) => k
        Err(e) => return Err(e)
      }
      if stop_kind == 2 {
        match skip_balanced_curly(lex, max_paren) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
      continue
    }
    if tk == TK_IDENT {
      let item_start = lex.tok_start
      let item_end_first = lex.tok_end
      let name_has_esc = lex.tok_has_esc
      let mut next_tk = lex.next_fast()
      if next_tk < 0 {
        return Err(lex.limit_err())
      }
      while next_tk == TK_WS {
        next_tk = lex.next_fast()
        if next_tk < 0 {
          return Err(lex.limit_err())
        }
      }
      if next_tk == TK_COLON {
        let is_custom = if !name_has_esc {
          item_end_first - item_start >= 2 &&
          clean.code_unit_at(item_start) == 45 &&
          clean.code_unit_at(item_start + 1) == 45
        } else {
          let tmp = decode_ident_slice(clean, item_start, item_end_first, true, lex.lut)
          tmp.length() >= 2 && tmp.code_unit_at(0) == 45 && tmp.code_unit_at(1) == 45
        }
        let prop_name = decode_prop_name(clean, item_start, item_end_first, name_has_esc, is_custom, lex.lut)
        if !lex.check_limit {
          let sk = fast_parse_decl_value(lex, prop_name, is_custom, 0, max_paren, false, decls)
          if sk < 0 {
            return Err(
              CssError::new(
                CssErrorKind::LimitExceeded,
                lex.err_offset,
                1,
                1,
                "nesting depth limit exceeded",
              ),
            )
          }
        } else {
          let (_, _, decl_opt) = match stream_parse_decl_value(
            lex,
            prop_name,
            is_custom,
            0,
            max_paren,
            false,
          ) {
            Ok(r) => r
            Err(e) => return Err(e)
          }
          match decl_opt {
            Some(d) => decls.push(d)
            None => ()
          }
        }
        continue
      }
      let stop_kind = match scan_prelude_unified(
        lex,
        next_tk,
        lex.tok_start,
        lex.tok_end,
        true,
        false,
        max_paren,
      ) {
        Ok(k) => k
        Err(e) => return Err(e)
      }
      if stop_kind == 2 {
        match skip_balanced_curly(lex, max_paren) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
      continue
    }
    // Non-ident: skip until ';' or skip '{...}' block
    let stop_kind = match scan_prelude_unified(
      lex,
      tk,
      lex.tok_start,
      lex.tok_end,
      true,
      false,
      max_paren,
    ) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    if stop_kind == 2 {
      match skip_balanced_curly(lex, max_paren) {
        Ok(()) => ()
        Err(e) => return Err(e)
      }
    }
  }
  Ok(decls)
}
