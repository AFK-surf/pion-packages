///| 100% iterative Selectors Level 4 specificity calculator.

fn is_legacy_pseudo_element(name : String) -> Bool {
  ascii_eq_ignore_case(name, "before") ||
  ascii_eq_ignore_case(name, "after") ||
  ascii_eq_ignore_case(name, "first-line") ||
  ascii_eq_ignore_case(name, "first-letter")
}

// Frame modes for iterative functional pseudo-class evaluation
let SEL_MODE_LIST : Int = 0 // Top-level or :not/:is/:has/:matches
let SEL_MODE_WHERE : Int = 1 // :where(...) -> always 0
let SEL_MODE_NTH : Int = 2 // :nth-child / :nth-last-child (adds (0,1,0) + max of `of S`)
let SEL_MODE_HOST : Int = 3 // :host(...) / :host-context(...) (adds (0,1,0) + max of S)
let SEL_MODE_SKIP : Int = 4 // Other functional pseudo-classes like :lang(en) -> already counted (0,1,0)

struct SelFrame {
  mode : Int
  mut cur_ids : Int
  mut cur_cls : Int
  mut cur_els : Int
  mut max_ids : Int
  mut max_cls : Int
  mut max_els : Int
  mut seen_of : Bool
  mut paren_depth : Int
  mut has_any : Bool
}

fn SelFrame::new(mode : Int) -> SelFrame {
  SelFrame::{
    mode: mode,
    cur_ids: 0,
    cur_cls: 0,
    cur_els: 0,
    max_ids: 0,
    max_cls: 0,
    max_els: 0,
    seen_of: false,
    paren_depth: 0,
    has_any: false,
  }
}

fn sel_frame_commit_branch(f : SelFrame) -> Unit {
  if !f.has_any {
    f.max_ids = f.cur_ids
    f.max_cls = f.cur_cls
    f.max_els = f.cur_els
    f.has_any = true
  } else {
    let cur = Specificity::new(f.cur_ids, f.cur_cls, f.cur_els)
    let best = Specificity::new(f.max_ids, f.max_cls, f.max_els)
    if cur.compare(best) > 0 {
      f.max_ids = f.cur_ids
      f.max_cls = f.cur_cls
      f.max_els = f.cur_els
    }
  }
  f.cur_ids = 0
  f.cur_cls = 0
  f.cur_els = 0
}

fn compute_selector_list_internal(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Specificity], CssError] {
  let clean = preprocess_string(src)
  let tokens = match tokenize_preprocessed(clean, opts) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match check_token_nesting_depth(tokens, opts.max_depth) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }

  let n = tokens.length()
  let results : Array[Specificity] = []
  let stack : Array[SelFrame] = [SelFrame::new(SEL_MODE_LIST)]
  let mut i = 0
  let mut has_top_tokens = false

  while i < n {
    let top = stack[stack.length() - 1]
    let tok = tokens[i]

    // If inside SEL_MODE_SKIP, just match parens
    if top.mode == SEL_MODE_SKIP {
      match tok.kind {
        TokenKind::LeftParen | TokenKind::Function(_) => {
          top.paren_depth = top.paren_depth + 1
          i = i + 1
        }
        TokenKind::RightParen => {
          if top.paren_depth == 0 {
            let _ = stack.pop()
          } else {
            top.paren_depth = top.paren_depth - 1
          }
          i = i + 1
        }
        _ => i = i + 1
      }
      continue
    }

    // If inside SEL_MODE_NTH before seeing `of`, scan until `of` or `)`
    if top.mode == SEL_MODE_NTH && !top.seen_of {
      match tok.kind {
        TokenKind::Ident(w) => {
          if ascii_eq_ignore_case(w, "of") {
            top.seen_of = true
          }
          i = i + 1
        }
        TokenKind::RightParen => {
          // No `of S`, so :nth-child(...) contributes (0, 1, 0)
          let _ = stack.pop()
          if stack.length() > 0 {
            let parent = stack[stack.length() - 1]
            parent.cur_cls = parent.cur_cls + 1
          }
          i = i + 1
        }
        _ => i = i + 1
      }
      continue
    }

    // Comma separates selector list items
    match tok.kind {
      TokenKind::Comma => {
        if stack.length() == 1 {
          results.push(Specificity::new(top.cur_ids, top.cur_cls, top.cur_els))
          top.cur_ids = 0
          top.cur_cls = 0
          top.cur_els = 0
          has_top_tokens = false
        } else {
          sel_frame_commit_branch(top)
        }
        i = i + 1
        continue
      }
      TokenKind::RightParen => {
        if stack.length() > 1 {
          sel_frame_commit_branch(top)
          let mode = top.mode
          let mid = top.max_ids
          let mcl = top.max_cls
          let mel = top.max_els
          let _ = stack.pop()
          let parent = stack[stack.length() - 1]
          if mode == SEL_MODE_WHERE {
            // Contributes (0, 0, 0)
            ()
          } else if mode == SEL_MODE_NTH || mode == SEL_MODE_HOST {
            parent.cur_ids = parent.cur_ids + mid
            parent.cur_cls = parent.cur_cls + mcl + 1
            parent.cur_els = parent.cur_els + mel
          } else {
            // :not, :is, :has, :matches
            parent.cur_ids = parent.cur_ids + mid
            parent.cur_cls = parent.cur_cls + mcl
            parent.cur_els = parent.cur_els + mel
          }
        }
        i = i + 1
        continue
      }
      TokenKind::Whitespace => {
        i = i + 1
        continue
      }
      _ => ()
    }

    if stack.length() == 1 {
      has_top_tokens = true
    }

    match tok.kind {
      TokenKind::Hash(_, _) => {
        top.cur_ids = top.cur_ids + 1
        i = i + 1
      }
      TokenKind::Delim(d) => {
        if d == "." {
          // Class selector `.ident`
          if i + 1 < n {
            match tokens[i + 1].kind {
              TokenKind::Ident(_) => {
                top.cur_cls = top.cur_cls + 1
                i = i + 2
              }
              _ => i = i + 1
            }
          } else {
            i = i + 1
          }
        } else {
          // '*', '>', '+', '~', '|', '&' -> 0 specificity
          i = i + 1
        }
      }
      TokenKind::LeftSquare => {
        // Attribute selector `[...]` -> (0, 1, 0), skip to matching `]`
        top.cur_cls = top.cur_cls + 1
        let mut sq_depth = 1
        i = i + 1
        while i < n && sq_depth > 0 {
          match tokens[i].kind {
            TokenKind::LeftSquare => sq_depth = sq_depth + 1
            TokenKind::RightSquare => sq_depth = sq_depth - 1
            _ => ()
          }
          i = i + 1
        }
      }
      TokenKind::Colon => {
        // Check for `::` pseudo-element
        if i + 1 < n {
          match tokens[i + 1].kind {
            TokenKind::Colon => {
              // `::pseudo-element` or `::part(...)`
              top.cur_els = top.cur_els + 1
              if i + 2 < n {
                match tokens[i + 2].kind {
                  TokenKind::Function(_) => {
                    stack.push(SelFrame::new(SEL_MODE_SKIP))
                    i = i + 3
                  }
                  TokenKind::Ident(_) => i = i + 3
                  _ => i = i + 2
                }
              } else {
                i = i + 2
              }
            }
            TokenKind::Ident(pname) => {
              if is_legacy_pseudo_element(pname) {
                top.cur_els = top.cur_els + 1
              } else {
                top.cur_cls = top.cur_cls + 1
              }
              i = i + 2
            }
            TokenKind::Function(fname) => {
              let lf = ascii_lower(fname)
              if lf == "where" {
                stack.push(SelFrame::new(SEL_MODE_WHERE))
              } else if lf == "not" || lf == "is" || lf == "matches" || lf == "has" || lf == "-webkit-any" || lf == "-moz-any" {
                stack.push(SelFrame::new(SEL_MODE_LIST))
              } else if lf == "nth-child" || lf == "nth-last-child" {
                stack.push(SelFrame::new(SEL_MODE_NTH))
              } else if lf == "host" || lf == "host-context" {
                stack.push(SelFrame::new(SEL_MODE_HOST))
              } else {
                top.cur_cls = top.cur_cls + 1
                stack.push(SelFrame::new(SEL_MODE_SKIP))
              }
              if stack.length() > opts.max_depth {
                return Err(
                  CssError::new(
                    CssErrorKind::LimitExceeded,
                    tok.start,
                    1,
                    1,
                    "selector nesting depth exceeded",
                  ),
                )
              }
              i = i + 2
            }
            _ => i = i + 1
          }
        } else {
          i = i + 1
        }
      }
      TokenKind::Ident(_) => {
        // Type selector (note: if followed by `|`, it's a namespace prefix, so don't double-count)
        let is_ns_prefix = if i + 1 < n {
          match tokens[i + 1].kind {
            TokenKind::Delim(d) => d == "|"
            _ => false
          }
        } else {
          false
        }
        if !is_ns_prefix {
          top.cur_els = top.cur_els + 1
        }
        i = i + 1
      }
      _ => i = i + 1
    }
  }

  // Close any unclosed frames
  while stack.length() > 1 {
    let _ = stack.pop()
  }
  let root = stack[0]
  if has_top_tokens || results.length() == 0 {
    if !has_top_tokens && results.length() == 0 {
      return Err(
        CssError::new(CssErrorKind::InvalidSelector, 0, 1, 1, "empty selector"),
      )
    }
    results.push(Specificity::new(root.cur_ids, root.cur_cls, root.cur_els))
  }
  Ok(results)
}

///| Compute specificity for a single selector.
pub fn selector_specificity_internal(
  selector : String,
) -> Result[Specificity, CssError] {
  match compute_selector_list_internal(selector, ParseOptions::default()) {
    Ok(list) => {
      if list.length() == 0 {
        Err(CssError::new(CssErrorKind::InvalidSelector, 0, 1, 1, "empty selector"))
      } else {
        Ok(list[0])
      }
    }
    Err(e) => Err(e)
  }
}

///| Compute specificities for a comma-separated selector list.
pub fn selector_list_specificity_internal(
  selectors : String,
) -> Result[Array[Specificity], CssError] {
  compute_selector_list_internal(selectors, ParseOptions::default())
}

///| Compute maximum specificity in a comma-separated selector list.
pub fn max_specificity_internal(
  selectors : String,
) -> Result[Specificity, CssError] {
  match compute_selector_list_internal(selectors, ParseOptions::default()) {
    Ok(list) => {
      let mut best = list[0]
      let mut i = 1
      while i < list.length() {
        if list[i].compare(best) > 0 {
          best = list[i]
        }
        i = i + 1
      }
      Ok(best)
    }
    Err(e) => Err(e)
  }
}
