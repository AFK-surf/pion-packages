///| 100% iterative Selectors Level 4 validator & specificity calculator.

fn is_legacy_pseudo_element(name : String) -> Bool {
  ascii_eq_ignore_case(name, "before") ||
  ascii_eq_ignore_case(name, "after") ||
  ascii_eq_ignore_case(name, "first-line") ||
  ascii_eq_ignore_case(name, "first-letter")
}

fn sel_err(offset : Int, msg : String) -> CssError {
  CssError::new(CssErrorKind::InvalidSelector, offset, 1, 1, msg)
}

fn cap_spec(v : Int) -> Int {
  if v > 1023 { 1023 } else { v }
}

// Frame modes for iterative functional pseudo-class/element evaluation
let SEL_MODE_TOP : Int = 0 // Top-level selector list
let SEL_MODE_LIST : Int = 1 // :not/:is/:matches/:-webkit-any/:-moz-any (no pseudo-elements, no leading combinator)
let SEL_MODE_HAS : Int = 2 // :has(...) (allows leading combinator)
let SEL_MODE_WHERE : Int = 3 // :where(...) -> always 0
let SEL_MODE_NTH : Int = 4 // :nth-child / :nth-last-child (adds (0,1,0) + max of `of S`)
let SEL_MODE_HOST : Int = 5 // :host(...) / :host-context(...) (adds (0,1,0) + max of S)
let SEL_MODE_SLOTTED : Int = 6 // ::slotted(...) (adds (0,0,1) + specificity of S)
let SEL_MODE_SKIP : Int = 7 // Other functional pseudo-classes/elements like :lang(en), ::part(x)

struct SelFrame {
  mode : Int
  mut cur_ids : Int
  mut cur_cls : Int
  mut cur_els : Int
  mut max_ids : Int
  mut max_cls : Int
  mut max_els : Int
  mut seen_of : Bool
  mut paren_depth : Int
  mut has_any_branch : Bool
  // Grammar state for the current selector branch:
  // 0 = start of selector (nothing yet), 1 = after explicit combinator (> + ~),
  // 2 = in compound selector, 3 = after whitespace following compound
  mut state : Int
  mut seen_pseudo_el : Bool
  mut has_nth_expr : Bool
}

fn SelFrame::new(mode : Int) -> SelFrame {
  SelFrame::{
    mode: mode,
    cur_ids: 0,
    cur_cls: 0,
    cur_els: 0,
    max_ids: 0,
    max_cls: 0,
    max_els: 0,
    seen_of: false,
    paren_depth: 0,
    has_any_branch: false,
    state: 0,
    seen_pseudo_el: false,
    has_nth_expr: false,
  }
}

fn sel_frame_commit_branch(f : SelFrame) -> Unit {
  let cid = cap_spec(f.cur_ids)
  let ccl = cap_spec(f.cur_cls)
  let cel = cap_spec(f.cur_els)
  if !f.has_any_branch {
    f.max_ids = cid
    f.max_cls = ccl
    f.max_els = cel
    f.has_any_branch = true
  } else {
    let cur = Specificity::new(cid, ccl, cel)
    let best = Specificity::new(f.max_ids, f.max_cls, f.max_els)
    if cur.compare(best) > 0 {
      f.max_ids = cid
      f.max_cls = ccl
      f.max_els = cel
    }
  }
  f.cur_ids = 0
  f.cur_cls = 0
  f.cur_els = 0
  f.state = 0
  f.seen_pseudo_el = false
}

///| Validate an attribute selector `[...]` starting AFTER `[` at `pos`.
///| Returns `Ok(index_after_rsq)` or `Err(InvalidSelector)`.
fn validate_attr_selector(tokens : Array[Token], pos : Int, n : Int) -> Result[Int, CssError] {
  let mut i = pos
  while i < n && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  if i >= n {
    return Err(sel_err(0, "unclosed attribute selector"))
  }
  // Optional namespace prefix: `ident|`, `*|`, or `|`
  let mut has_name = false
  match tokens[i].kind {
    TokenKind::Delim(d) => {
      if d == "|" {
        i = i + 1
        if i < n {
          match tokens[i].kind {
            TokenKind::Ident(_) => {
              has_name = true
              i = i + 1
            }
            _ => return Err(sel_err(tokens[i].start, "expected attribute name after '|'"))
          }
        } else {
          return Err(sel_err(0, "expected attribute name"))
        }
      } else if d == "*" {
        if i + 2 < n {
          let pipe_ok = match tokens[i + 1].kind {
            TokenKind::Delim(p) => p == "|"
            _ => false
          }
          let id_ok = match tokens[i + 2].kind {
            TokenKind::Ident(_) => true
            _ => false
          }
          if pipe_ok && id_ok {
            has_name = true
            i = i + 3
          } else {
            return Err(sel_err(tokens[i].start, "invalid attribute namespace"))
          }
        } else {
          return Err(sel_err(tokens[i].start, "invalid attribute selector"))
        }
      } else {
        return Err(sel_err(tokens[i].start, "unexpected token in attribute selector"))
      }
    }
    TokenKind::Ident(_) => {
      i = i + 1
      // Could be `ns|attr` (no space around `|`)
      if i + 1 < n {
        let is_pipe = match tokens[i].kind {
          TokenKind::Delim(p) => p == "|"
          _ => false
        }
        let next_is_eq = match tokens[i + 1].kind {
          TokenKind::Delim(e) => e == "="
          _ => false
        }
        if is_pipe && !next_is_eq {
          match tokens[i + 1].kind {
            TokenKind::Ident(_) => i = i + 2
            _ => return Err(sel_err(tokens[i + 1].start, "expected attribute name after '|'"))
          }
        }
      }
      has_name = true
    }
    _ => return Err(sel_err(tokens[i].start, "expected attribute name"))
  }
  if !has_name {
    return Err(sel_err(0, "missing attribute name"))
  }
  while i < n && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  if i >= n {
    return Err(sel_err(0, "unclosed attribute selector"))
  }
  match tokens[i].kind {
    TokenKind::RightSquare => return Ok(i + 1)
    _ => ()
  }
  // Expect matcher: `=`, `~=`, `|=`, `^=`, `$=`, `*=`
  match tokens[i].kind {
    TokenKind::Delim(d) => {
      if d == "=" {
        i = i + 1
      } else if d == "~" || d == "|" || d == "^" || d == "$" || d == "*" {
        if i + 1 < n {
          let is_eq = match tokens[i + 1].kind {
            TokenKind::Delim(e) => e == "="
            _ => false
          }
          if !is_eq {
            return Err(sel_err(tokens[i].start, "expected '=' in attribute matcher"))
          }
          i = i + 2
        } else {
          return Err(sel_err(tokens[i].start, "incomplete attribute matcher"))
        }
      } else {
        return Err(sel_err(tokens[i].start, "invalid attribute matcher"))
      }
    }
    _ => return Err(sel_err(tokens[i].start, "expected attribute matcher or ']'"))
  }
  while i < n && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  if i >= n {
    return Err(sel_err(0, "missing attribute value"))
  }
  // Value must be Ident or Str
  match tokens[i].kind {
    TokenKind::Ident(_) | TokenKind::Str(_) => i = i + 1
    _ => return Err(sel_err(tokens[i].start, "expected attribute value"))
  }
  while i < n && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  if i >= n {
    return Err(sel_err(0, "unclosed attribute selector"))
  }
  // Optional case-sensitivity flag (`i` or `s`)
  match tokens[i].kind {
    TokenKind::Ident(flag) => {
      if ascii_eq_ignore_case(flag, "i") || ascii_eq_ignore_case(flag, "s") {
        i = i + 1
        while i < n && is_ws_tok(tokens[i]) {
          i = i + 1
        }
      } else {
        return Err(sel_err(tokens[i].start, "invalid attribute flag"))
      }
    }
    _ => ()
  }
  if i >= n {
    return Err(sel_err(0, "unclosed attribute selector"))
  }
  match tokens[i].kind {
    TokenKind::RightSquare => Ok(i + 1)
    _ => Err(sel_err(tokens[i].start, "expected ']' in attribute selector"))
  }
}

fn compute_selector_list_internal(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Specificity], CssError] {
  let clean = preprocess_string(src)
  let tokens = match tokenize_preprocessed(clean, opts) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match check_token_nesting_depth(tokens, opts.max_depth) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }

  let n = tokens.length()
  let results : Array[Specificity] = []
  let stack : Array[SelFrame] = [SelFrame::new(SEL_MODE_TOP)]
  let mut i = 0

  while i < n {
    let top = stack[stack.length() - 1]
    let tok = tokens[i]

    // Skip mode (:lang(...), ::part(...), :dir(...), etc.)
    if top.mode == SEL_MODE_SKIP {
      match tok.kind {
        TokenKind::LeftParen | TokenKind::Function(_) => {
          top.paren_depth = top.paren_depth + 1
          i = i + 1
        }
        TokenKind::RightParen => {
          if top.paren_depth == 0 {
            let _ = stack.pop()
          } else {
            top.paren_depth = top.paren_depth - 1
          }
          i = i + 1
        }
        TokenKind::LeftCurly | TokenKind::RightCurly | TokenKind::BadString | TokenKind::BadUrl => {
          return Err(sel_err(tok.start, "invalid token in functional pseudo"))
        }
        _ => i = i + 1
      }
      continue
    }

    // :nth-child(An+B [of S]) before seeing `of`
    if top.mode == SEL_MODE_NTH && !top.seen_of {
      match tok.kind {
        TokenKind::Ident(w) => {
          if ascii_eq_ignore_case(w, "of") {
            if !top.has_nth_expr {
              return Err(sel_err(tok.start, "missing An+B before 'of'"))
            }
            top.seen_of = true
          } else {
            top.has_nth_expr = true
          }
          i = i + 1
        }
        TokenKind::RightParen => {
          if !top.has_nth_expr {
            return Err(sel_err(tok.start, "empty :nth-child()"))
          }
          let _ = stack.pop()
          let parent = stack[stack.length() - 1]
          parent.cur_cls = cap_spec(parent.cur_cls + 1)
          i = i + 1
        }
        TokenKind::Whitespace => i = i + 1
        TokenKind::LeftCurly | TokenKind::RightCurly | TokenKind::BadString | TokenKind::BadUrl => {
          return Err(sel_err(tok.start, "invalid token in :nth-child()"))
        }
        _ => {
          top.has_nth_expr = true
          i = i + 1
        }
      }
      continue
    }

    // Whitespace
    match tok.kind {
      TokenKind::Whitespace => {
        if top.state == 2 {
          top.state = 3
        }
        i = i + 1
        continue
      }
      TokenKind::Comma => {
        // Must have a complete selector before comma (state 2 or 3)
        if top.state != 2 && top.state != 3 {
          return Err(sel_err(tok.start, "empty selector before ','"))
        }
        if stack.length() == 1 {
          results.push(
            Specificity::new(cap_spec(top.cur_ids), cap_spec(top.cur_cls), cap_spec(top.cur_els)),
          )
          top.cur_ids = 0
          top.cur_cls = 0
          top.cur_els = 0
          top.state = 0
          top.seen_pseudo_el = false
        } else {
          sel_frame_commit_branch(top)
        }
        i = i + 1
        continue
      }
      TokenKind::RightParen => {
        if stack.length() <= 1 {
          return Err(sel_err(tok.start, "unmatched ')' in selector"))
        }
        // Must have a complete selector inside parens (no empty :not(), :is(), :where(), :nth-child(2n of))
        if top.state != 2 && top.state != 3 {
          return Err(sel_err(tok.start, "empty or incomplete selector in functional pseudo"))
        }
        sel_frame_commit_branch(top)
        let mode = top.mode
        let mid = top.max_ids
        let mcl = top.max_cls
        let mel = top.max_els
        let _ = stack.pop()
        let parent = stack[stack.length() - 1]
        if mode == SEL_MODE_WHERE {
          ()
        } else if mode == SEL_MODE_NTH || mode == SEL_MODE_HOST {
          parent.cur_ids = cap_spec(parent.cur_ids + mid)
          parent.cur_cls = cap_spec(parent.cur_cls + mcl + 1)
          parent.cur_els = cap_spec(parent.cur_els + mel)
        } else if mode == SEL_MODE_SLOTTED {
          parent.cur_ids = cap_spec(parent.cur_ids + mid)
          parent.cur_cls = cap_spec(parent.cur_cls + mcl)
          parent.cur_els = cap_spec(parent.cur_els + mel + 1)
        } else {
          // :not, :is, :has, :matches
          parent.cur_ids = cap_spec(parent.cur_ids + mid)
          parent.cur_cls = cap_spec(parent.cur_cls + mcl)
          parent.cur_els = cap_spec(parent.cur_els + mel)
        }
        i = i + 1
        continue
      }
      _ => ()
    }

    // Combinators: `>`, `+`, `~`
    match tok.kind {
      TokenKind::Delim(d) => {
        if d == ">" || d == "+" || d == "~" {
          if top.state == 0 {
            // Leading combinator only allowed in :has(...)
            if top.mode != SEL_MODE_HAS {
              return Err(sel_err(tok.start, "unexpected leading combinator"))
            }
            top.state = 1
            i = i + 1
            continue
          }
          if top.state == 1 {
            return Err(sel_err(tok.start, "consecutive combinators"))
          }
          if top.seen_pseudo_el {
            return Err(sel_err(tok.start, "combinator after pseudo-element"))
          }
          top.state = 1
          top.seen_pseudo_el = false
          i = i + 1
          continue
        }
      }
      _ => ()
    }

    // If transitioning from whitespace (state 3) into a new compound selector, reset seen_pseudo_el check
    if top.state == 3 && top.seen_pseudo_el {
      return Err(sel_err(tok.start, "selector after pseudo-element"))
    }
    let at_compound_start = top.state == 0 || top.state == 1 || top.state == 3

    match tok.kind {
      TokenKind::Hash(_, hk) => {
        if !hash_kind_eq(hk, HashKind::Id) {
          return Err(sel_err(tok.start, "non-ID hash in selector"))
        }
        if top.seen_pseudo_el {
          return Err(sel_err(tok.start, "ID selector after pseudo-element"))
        }
        top.cur_ids = cap_spec(top.cur_ids + 1)
        top.state = 2
        i = i + 1
      }
      TokenKind::Delim(d) => {
        if d == "." {
          if top.seen_pseudo_el {
            return Err(sel_err(tok.start, "class selector after pseudo-element"))
          }
          if i + 1 < n {
            match tokens[i + 1].kind {
              TokenKind::Ident(_) => {
                top.cur_cls = cap_spec(top.cur_cls + 1)
                top.state = 2
                i = i + 2
              }
              _ => return Err(sel_err(tok.start, "expected identifier after '.'"))
            }
          } else {
            return Err(sel_err(tok.start, "trailing '.' in selector"))
          }
        } else if d == "*" {
          if !at_compound_start {
            return Err(sel_err(tok.start, "universal selector must start compound selector"))
          }
          // Could be `*|type` or `*`
          if i + 2 < n {
            let is_pipe = match tokens[i + 1].kind {
              TokenKind::Delim(p) => p == "|"
              _ => false
            }
            if is_pipe {
              match tokens[i + 2].kind {
                TokenKind::Ident(_) => {
                  top.cur_els = cap_spec(top.cur_els + 1)
                  top.state = 2
                  i = i + 3
                  continue
                }
                TokenKind::Delim(st) => {
                  if st == "*" {
                    top.state = 2
                    i = i + 3
                    continue
                  }
                  return Err(sel_err(tokens[i + 2].start, "expected type or '*' after '*|'"))
                }
                _ => return Err(sel_err(tokens[i + 2].start, "expected type or '*' after '*|'"))
              }
            }
          }
          top.state = 2
          i = i + 1
        } else if d == "|" {
          // `|type` or `|*` (must be at compound start; `||` is rejected)
          if !at_compound_start {
            return Err(sel_err(tok.start, "unexpected '|' in selector"))
          }
          if i + 1 < n {
            match tokens[i + 1].kind {
              TokenKind::Ident(_) => {
                top.cur_els = cap_spec(top.cur_els + 1)
                top.state = 2
                i = i + 2
              }
              TokenKind::Delim(st) => {
                if st == "*" {
                  top.state = 2
                  i = i + 2
                } else {
                  return Err(sel_err(tokens[i + 1].start, "expected type or '*' after '|'"))
                }
              }
              _ => return Err(sel_err(tokens[i + 1].start, "expected type or '*' after '|'"))
            }
          } else {
            return Err(sel_err(tok.start, "trailing '|' in selector"))
          }
        } else if d == "&" {
          if top.seen_pseudo_el {
            return Err(sel_err(tok.start, "'&' after pseudo-element"))
          }
          top.state = 2
          i = i + 1
        } else {
          return Err(sel_err(tok.start, "unexpected delimiter in selector: " + d))
        }
      }
      TokenKind::LeftSquare => {
        if top.seen_pseudo_el {
          return Err(sel_err(tok.start, "attribute selector after pseudo-element"))
        }
        let next_i = match validate_attr_selector(tokens, i + 1, n) {
          Ok(ni) => ni
          Err(e) => return Err(e)
        }
        top.cur_cls = cap_spec(top.cur_cls + 1)
        top.state = 2
        i = next_i
      }
      TokenKind::Colon => {
        if i + 1 >= n {
          return Err(sel_err(tok.start, "trailing ':' in selector"))
        }
        match tokens[i + 1].kind {
          TokenKind::Colon => {
            // Pseudo-element `::ident` or `::func(...)`
            if top.mode == SEL_MODE_LIST || top.mode == SEL_MODE_WHERE || top.mode == SEL_MODE_HAS {
              return Err(sel_err(tok.start, "pseudo-element not allowed inside functional pseudo-class"))
            }
            if top.seen_pseudo_el {
              return Err(sel_err(tok.start, "multiple pseudo-elements"))
            }
            if i + 2 >= n {
              return Err(sel_err(tok.start, "trailing '::' in selector"))
            }
            top.seen_pseudo_el = true
            top.state = 2
            match tokens[i + 2].kind {
              TokenKind::Ident(_) => {
                top.cur_els = cap_spec(top.cur_els + 1)
                i = i + 3
              }
              TokenKind::Function(fname) => {
                if stack.length() >= opts.max_depth {
                  return Err(
                    CssError::new(
                      CssErrorKind::LimitExceeded,
                      tok.start,
                      1,
                      1,
                      "selector nesting depth exceeded",
                    ),
                  )
                }
                if ascii_eq_ignore_case(fname, "slotted") {
                  stack.push(SelFrame::new(SEL_MODE_SLOTTED))
                } else {
                  top.cur_els = cap_spec(top.cur_els + 1)
                  stack.push(SelFrame::new(SEL_MODE_SKIP))
                }
                i = i + 3
              }
              _ => return Err(sel_err(tokens[i + 2].start, "expected pseudo-element name after '::'"))
            }
          }
          TokenKind::Ident(pname) => {
            if is_legacy_pseudo_element(pname) {
              if top.mode == SEL_MODE_LIST || top.mode == SEL_MODE_WHERE || top.mode == SEL_MODE_HAS {
                return Err(sel_err(tok.start, "pseudo-element not allowed inside functional pseudo-class"))
              }
              top.cur_els = cap_spec(top.cur_els + 1)
              top.seen_pseudo_el = true
            } else {
              top.cur_cls = cap_spec(top.cur_cls + 1)
            }
            top.state = 2
            i = i + 2
          }
          TokenKind::Function(fname) => {
            if stack.length() >= opts.max_depth {
              return Err(
                CssError::new(
                  CssErrorKind::LimitExceeded,
                  tok.start,
                  1,
                  1,
                  "selector nesting depth exceeded",
                ),
              )
            }
            let lf = ascii_lower(fname)
            if lf == "where" {
              stack.push(SelFrame::new(SEL_MODE_WHERE))
            } else if lf == "has" {
              stack.push(SelFrame::new(SEL_MODE_HAS))
            } else if lf == "not" || lf == "is" || lf == "matches" || lf == "-webkit-any" || lf == "-moz-any" {
              stack.push(SelFrame::new(SEL_MODE_LIST))
            } else if lf == "nth-child" || lf == "nth-last-child" {
              stack.push(SelFrame::new(SEL_MODE_NTH))
            } else if lf == "host" || lf == "host-context" {
              stack.push(SelFrame::new(SEL_MODE_HOST))
            } else {
              top.cur_cls = cap_spec(top.cur_cls + 1)
              stack.push(SelFrame::new(SEL_MODE_SKIP))
            }
            top.state = 2
            i = i + 2
          }
          _ => return Err(sel_err(tokens[i + 1].start, "expected pseudo-class name after ':'"))
        }
      }
      TokenKind::Ident(_) => {
        if !at_compound_start {
          return Err(sel_err(tok.start, "type selector must start compound selector"))
        }
        // Check for namespace prefix `ns|type` or `ns|*`
        if i + 1 < n {
          let is_pipe = match tokens[i + 1].kind {
            TokenKind::Delim(d) => d == "|"
            _ => false
          }
          if is_pipe {
            if i + 2 >= n {
              return Err(sel_err(tokens[i + 1].start, "expected type or '*' after '|'"))
            }
            match tokens[i + 2].kind {
              TokenKind::Ident(_) => {
                top.cur_els = cap_spec(top.cur_els + 1)
                top.state = 2
                i = i + 3
                continue
              }
              TokenKind::Delim(st) => {
                if st == "*" {
                  top.state = 2
                  i = i + 3
                  continue
                }
                return Err(sel_err(tokens[i + 2].start, "expected type or '*' after '|'"))
              }
              _ => return Err(sel_err(tokens[i + 2].start, "expected type or '*' after '|'"))
            }
          }
        }
        top.cur_els = cap_spec(top.cur_els + 1)
        top.state = 2
        i = i + 1
      }
      _ => return Err(sel_err(tok.start, "unexpected token in selector"))
    }
  }

  // Unclosed functional pseudo-class/element -> invalid selector
  if stack.length() > 1 {
    return Err(sel_err(0, "unclosed '(' in selector"))
  }
  let root = stack[0]
  if root.state != 2 && root.state != 3 {
    return Err(sel_err(0, "empty or incomplete selector"))
  }
  results.push(
    Specificity::new(cap_spec(root.cur_ids), cap_spec(root.cur_cls), cap_spec(root.cur_els)),
  )
  Ok(results)
}

///| Compute specificity for a single selector.
pub fn selector_specificity_internal(
  selector : String,
) -> Result[Specificity, CssError] {
  match compute_selector_list_internal(selector, ParseOptions::default()) {
    Ok(list) => {
      if list.length() == 0 {
        Err(sel_err(0, "empty selector"))
      } else {
        Ok(list[0])
      }
    }
    Err(e) => Err(e)
  }
}

///| Compute specificities for a comma-separated selector list.
pub fn selector_list_specificity_internal(
  selectors : String,
) -> Result[Array[Specificity], CssError] {
  compute_selector_list_internal(selectors, ParseOptions::default())
}

///| Compute maximum specificity in a comma-separated selector list.
pub fn max_specificity_internal(
  selectors : String,
) -> Result[Specificity, CssError] {
  match compute_selector_list_internal(selectors, ParseOptions::default()) {
    Ok(list) => {
      let mut best = list[0]
      let mut i = 1
      while i < list.length() {
        if list[i].compare(best) > 0 {
          best = list[i]
        }
        i = i + 1
      }
      Ok(best)
    }
    Err(e) => Err(e)
  }
}
