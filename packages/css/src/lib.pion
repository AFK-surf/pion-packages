///| Public API entry points for `css` (Red-phase stubs).

fn unimplemented_err() -> CssError {
  CssError::new(CssErrorKind::Unimplemented, 0, 1, 1, "unimplemented")
}

///| Tokenize a CSS string according to W3C CSS Syntax Level 3.
pub fn tokenize(src : String) -> Result[Array[Token], CssError] {
  tokenize_with_options(src, ParseOptions::default())
}

///| Tokenize a CSS string with explicit resource limits.
pub fn tokenize_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Token], CssError] {
  let _ = (src, opts)
  Err(unimplemented_err())
}

///| Tokenize raw CSS bytes (replacing invalid UTF-8 and NUL with U+FFFD).
pub fn tokenize_bytes(src : Bytes) -> Result[Array[Token], CssError] {
  tokenize_bytes_with_options(src, ParseOptions::default())
}

///| Tokenize raw CSS bytes with explicit resource limits.
pub fn tokenize_bytes_with_options(
  src : Bytes,
  opts : ParseOptions,
) -> Result[Array[Token], CssError] {
  let _ = (src, opts)
  Err(unimplemented_err())
}

///| Count tokens in a CSS string without allocating a `Token` array.
pub fn count_tokens(src : String) -> Result[Int, CssError] {
  let _ = src
  Err(unimplemented_err())
}

