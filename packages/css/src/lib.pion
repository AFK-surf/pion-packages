///| Public API entry points for `css`.

///| Tokenize a CSS string according to W3C CSS Syntax Level 3.
pub fn tokenize(src : String) -> Result[Array[Token], CssError] {
  tokenize_with_options(src, ParseOptions::default())
}

///| Tokenize a CSS string with explicit resource limits.
pub fn tokenize_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Token], CssError] {
  let clean = preprocess_string(src)
  tokenize_preprocessed(clean, opts)
}

///| Tokenize raw CSS bytes (replacing invalid UTF-8 and NUL with U+FFFD).
pub fn tokenize_bytes(src : Bytes) -> Result[Array[Token], CssError] {
  tokenize_bytes_with_options(src, ParseOptions::default())
}

///| Tokenize raw CSS bytes with explicit resource limits.
pub fn tokenize_bytes_with_options(
  src : Bytes,
  opts : ParseOptions,
) -> Result[Array[Token], CssError] {
  let clean = preprocess_bytes(src)
  tokenize_preprocessed(clean, opts)
}

///| Count tokens in a CSS string without allocating a `Token` array.
pub fn count_tokens(src : String) -> Result[Int, CssError] {
  count_tokens_internal(src)
}

///| Count non-whitespace tokens in a CSS string without allocating a `Token` array.
pub fn count_non_ws_tokens(src : String) -> Result[Int, CssError] {
  count_non_ws_tokens_internal(src)
}

///| Parse a CSS stylesheet with default limits.
pub fn parse_stylesheet(src : String) -> Result[Stylesheet, CssError] {
  parse_stylesheet_with_options(src, ParseOptions::default())
}

///| Parse a CSS stylesheet with explicit limits.
pub fn parse_stylesheet_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Stylesheet, CssError] {
  parse_stylesheet_internal(src, opts)
}

///| Parse a CSS stylesheet from raw bytes.
pub fn parse_stylesheet_bytes(src : Bytes) -> Result[Stylesheet, CssError] {
  let clean = preprocess_bytes(src)
  parse_stylesheet_internal(clean, ParseOptions::default())
}

///| Parse a CSS declaration block (e.g. inline `style` attribute).
pub fn parse_declarations(src : String) -> Result[Array[Declaration], CssError] {
  parse_declarations_with_options(src, ParseOptions::default())
}

///| Parse a CSS declaration block with explicit limits.
pub fn parse_declarations_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Declaration], CssError] {
  parse_declarations_internal(src, opts)
}

///| Compute Selectors Level 4 specificity `(a, b, c)` for a single complex selector.
pub fn selector_specificity(selector : String) -> Result[Specificity, CssError] {
  selector_specificity_internal(selector)
}

///| Compute specificities for each selector in a comma-separated selector list.
pub fn selector_list_specificity(
  selectors : String,
) -> Result[Array[Specificity], CssError] {
  selector_list_specificity_internal(selectors)
}

///| Compute the maximum specificity across a comma-separated selector list.
pub fn max_specificity(selectors : String) -> Result[Specificity, CssError] {
  max_specificity_internal(selectors)
}

///| Parse a Media Queries Level 4 comma-separated media query list.
pub fn parse_media_query_list(src : String) -> Result[Array[MediaQuery], CssError] {
  parse_media_query_list_internal(src, ParseOptions::default())
}

///| Parse a CSS Color Level 4 color value.
pub fn parse_color(src : String) -> Result[Color, CssError] {
  parse_color_internal(src)
}

///| Format a `Color` as lowercase hex (`#rrggbb` or `#rrggbbaa`, or `"currentcolor"`).
pub fn Color::to_hex(self : Color) -> String {
  color_to_hex(self)
}

///| Format a `Color` as canonical CSS (`#rrggbb` / `rgba(...)` / `currentcolor`).
pub fn Color::to_css(self : Color) -> String {
  color_to_css(self)
}

///| Format a `Color` in shortest minified CSS form (`#fff`, `#f0a`, etc.).
pub fn Color::to_minified_css(self : Color) -> String {
  color_to_minified_css(self)
}

///| Serialize a `Stylesheet` to formatted CSS.
pub fn to_css(sheet : Stylesheet) -> String {
  to_css_internal(sheet)
}

///| Minify a CSS stylesheet string.
pub fn minify(src : String) -> Result[String, CssError] {
  minify_with_options(src, ParseOptions::default())
}

///| Minify a CSS stylesheet string with explicit resource limits.
pub fn minify_with_options(
  src : String,
  opts : ParseOptions,
) -> Result[String, CssError] {
  minify_internal(src, opts)
}

///| Minify an already-parsed `Stylesheet`.
pub fn minify_stylesheet(sheet : Stylesheet) -> String {
  minify_stylesheet_internal(sheet)
}
