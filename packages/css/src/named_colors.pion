///| Lookup table for all 148 CSS Color Level 4 named colors (returns packed 0xRRGGBB).

///| Look up a lowercase CSS Color 4 named color, returning `Some(0xRRGGBB)`.
pub fn lookup_named_color(name : String) -> Option[Int] {
  match name {
    "aliceblue" => Some(0xF0F8FF)
    "antiquewhite" => Some(0xFAEBD7)
    "aqua" => Some(0x00FFFF)
    "aquamarine" => Some(0x7FFFD4)
    "azure" => Some(0xF0FFFF)
    "beige" => Some(0xF5F5DC)
    "bisque" => Some(0xFFE4C4)
    "black" => Some(0x000000)
    "blanchedalmond" => Some(0xFFEBCD)
