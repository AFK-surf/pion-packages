///| Core types, errors, options, tokens, AST nodes, specificity, color, and media queries for `css`.

///| Categories of CSS lexing, parsing, and evaluation errors.
pub enum CssErrorKind {
  LimitExceeded
  InvalidColor
  InvalidSelector
  InvalidMediaQuery
  InvalidSyntax
  Unimplemented
}

///| Structural equality for `CssErrorKind`.
pub fn css_error_kind_eq(a : CssErrorKind, b : CssErrorKind) -> Bool {
  match (a, b) {
    (CssErrorKind::LimitExceeded, CssErrorKind::LimitExceeded) => true
    (CssErrorKind::InvalidColor, CssErrorKind::InvalidColor) => true
    (CssErrorKind::InvalidSelector, CssErrorKind::InvalidSelector) => true
    (CssErrorKind::InvalidMediaQuery, CssErrorKind::InvalidMediaQuery) => true
    (CssErrorKind::InvalidSyntax, CssErrorKind::InvalidSyntax) => true
    (CssErrorKind::Unimplemented, CssErrorKind::Unimplemented) => true
    _ => false
  }
}

///| Structured CSS error with byte offset and 1-based line/column.
pub struct CssError {
  pub kind : CssErrorKind
  pub offset : Int
  pub line : Int
  pub col : Int
  pub message : String
}

///| Construct a `CssError`.
pub fn CssError::new(
  kind : CssErrorKind,
  offset : Int,
  line : Int,
  col : Int,
  message : String,
) -> CssError {
  CssError::{
    kind: kind,
    offset: offset,
    line: line,
    col: col,
    message: message,
  }
}

///| Format a `CssError` as a human-readable string.
pub fn CssError::to_string(self : CssError) -> String {
  self.message +
  " (line " +
  self.line.to_string() +
  ", col " +
  self.col.to_string() +
  ", offset " +
  self.offset.to_string() +
  ")"
}

///| Configurable resource and security limits for CSS lexing and parsing.
pub val struct ParseOptions {
  pub max_depth : Int
  pub max_tokens : Int
  pub max_rules : Int
}

///| Default CSS parser limits (`max_depth: 256`, `max_tokens: 2_000_000`, `max_rules: 500_000`).
pub fn ParseOptions::default() -> ParseOptions {
  ParseOptions::{
    max_depth: 256,
    max_tokens: 2000000,
    max_rules: 500000,
  }
}

///| Hash token type per CSS Syntax Level 3 §4.2.
pub enum HashKind {
  Id
  Unrestricted
}

///| Equality for `HashKind`.
pub fn hash_kind_eq(a : HashKind, b : HashKind) -> Bool {
  match (a, b) {
    (HashKind::Id, HashKind::Id) => true
    (HashKind::Unrestricted, HashKind::Unrestricted) => true
    _ => false
  }
}

///| CSS Syntax Level 3 token kind.
pub enum TokenKind {
  Ident(String)
  Function(String)
  AtKeyword(String)
  Hash(String, HashKind)
  Str(String)
  BadString
  Url(String)
  BadUrl
  Delim(String)
  Number(Double, Bool, Bool)
  Percentage(Double, Bool, Bool)
  Dimension(Double, Bool, Bool, String)
  UnicodeRange(Int, Int)
  Whitespace
  Cdo
  Cdc
  Colon
  Semicolon
  Comma
  LeftSquare
  RightSquare
  LeftParen
  RightParen
  LeftCurly
  RightCurly
}

///| A CSS Syntax Level 3 token with source byte span `[start, end)`.
pub struct Token {
  pub kind : TokenKind
  pub start : Int
  pub end : Int
}

///| Construct a `Token`.
pub fn Token::new(kind : TokenKind, start : Int, end : Int) -> Token {
  Token::{ kind: kind, start: start, end: end }
}

///| Structural equality for `TokenKind`.
pub fn token_kind_eq(a : TokenKind, b : TokenKind) -> Bool {
  match (a, b) {
    (TokenKind::Ident(x), TokenKind::Ident(y)) => x == y
    (TokenKind::Function(x), TokenKind::Function(y)) => x == y
    (TokenKind::AtKeyword(x), TokenKind::AtKeyword(y)) => x == y
    (TokenKind::Hash(x, kx), TokenKind::Hash(y, ky)) => x == y && hash_kind_eq(kx, ky)
    (TokenKind::Str(x), TokenKind::Str(y)) => x == y
    (TokenKind::BadString, TokenKind::BadString) => true
    (TokenKind::Url(x), TokenKind::Url(y)) => x == y
    (TokenKind::BadUrl, TokenKind::BadUrl) => true
    (TokenKind::Delim(x), TokenKind::Delim(y)) => x == y
    (TokenKind::Number(vx, ix, sx), TokenKind::Number(vy, iy, sy)) =>
    vx == vy && ix == iy && sx == sy
    (TokenKind::Percentage(vx, ix, sx), TokenKind::Percentage(vy, iy, sy)) =>
    vx == vy && ix == iy && sx == sy
    (TokenKind::Dimension(vx, ix, sx, ux), TokenKind::Dimension(vy, iy, sy, uy)) =>
    vx == vy && ix == iy && sx == sy && ux == uy
    (TokenKind::UnicodeRange(sx, ex), TokenKind::UnicodeRange(sy, ey)) =>
    sx == sy && ex == ey
    (TokenKind::Whitespace, TokenKind::Whitespace) => true
    (TokenKind::Cdo, TokenKind::Cdo) => true
    (TokenKind::Cdc, TokenKind::Cdc) => true
    (TokenKind::Colon, TokenKind::Colon) => true
    (TokenKind::Semicolon, TokenKind::Semicolon) => true
    (TokenKind::Comma, TokenKind::Comma) => true
    (TokenKind::LeftSquare, TokenKind::LeftSquare) => true
    (TokenKind::RightSquare, TokenKind::RightSquare) => true
    (TokenKind::LeftParen, TokenKind::LeftParen) => true
    (TokenKind::RightParen, TokenKind::RightParen) => true
    (TokenKind::LeftCurly, TokenKind::LeftCurly) => true
    (TokenKind::RightCurly, TokenKind::RightCurly) => true
    _ => false
  }
}

///| A CSS property declaration (`name: value [!important]`).
pub struct Declaration {
  pub name : String
  pub value : String
  pub important : Bool
  pub is_custom : Bool
}

///| Construct a `Declaration`.
pub fn Declaration::new(
  name : String,
  value : String,
  important : Bool,
  is_custom : Bool,
) -> Declaration {
  Declaration::{
    name: name,
    value: value,
    important: important,
    is_custom: is_custom,
  }
}

///| A CSS qualified rule (e.g. `div.card > p { color: red; }`, including CSS nesting).
pub struct QualifiedRule {
  pub prelude : String
  pub declarations : Array[Declaration]
  pub nested_rules : Array[Rule]
}

///| A CSS at-rule (e.g. `@media (...) { ... }`, `@import url(...);`, `@font-face { ... }`).
pub struct AtRule {
  pub name : String
  pub prelude : String
  pub has_block : Bool
  pub declarations : Array[Declaration]
  pub rules : Array[Rule]
}

///| A top-level or nested CSS rule.
pub enum Rule {
  Qualified(QualifiedRule)
  At(AtRule)
}

///| A parsed CSS stylesheet.
pub struct Stylesheet {
  pub rules : Array[Rule]
}

///| Selectors Level 4 specificity `(ids, classes, elements)` = `(a, b, c)`.
pub val struct Specificity {
  pub ids : Int
  pub classes : Int
  pub elements : Int
}

///| Construct a `Specificity`.
pub fn Specificity::new(ids : Int, classes : Int, elements : Int) -> Specificity {
  Specificity::{ ids: ids, classes: classes, elements: elements }
}

///| Zero specificity `(0, 0, 0)`.
pub fn Specificity::zero() -> Specificity {
  Specificity::{ ids: 0, classes: 0, elements: 0 }
}

///| Add two specificities component-wise.
pub fn Specificity::add(self : Specificity, other : Specificity) -> Specificity {
  Specificity::{
    ids: self.ids + other.ids,
    classes: self.classes + other.classes,
    elements: self.elements + other.elements,
  }
}

///| Compare two specificities lexicographically (`-1`, `0`, `1`).
pub fn Specificity::compare(self : Specificity, other : Specificity) -> Int {
  if self.ids != other.ids {
    if self.ids < other.ids { -1 } else { 1 }
  } else if self.classes != other.classes {
    if self.classes < other.classes { -1 } else { 1 }
  } else if self.elements != other.elements {
    if self.elements < other.elements { -1 } else { 1 }
  } else {
    0
  }
}

///| Structural equality for `Specificity`.
pub fn Specificity::eq(self : Specificity, other : Specificity) -> Bool {
  self.ids == other.ids &&
  self.classes == other.classes &&
  self.elements == other.elements
}

///| Format `Specificity` as `"(a, b, c)"`.
pub fn Specificity::to_string(self : Specificity) -> String {
  "(" +
  self.ids.to_string() +
  ", " +
  self.classes.to_string() +
  ", " +
  self.elements.to_string() +
  ")"
}

///| CSS Color Level 4 sRGB color value (`val struct`).
pub val struct Color {
  pub r : Int
  pub g : Int
  pub b : Int
  pub a : Double
  pub is_current_color : Bool
}

///| Construct an opaque sRGB `Color`.
pub fn Color::rgb(r : Int, g : Int, b : Int) -> Color {
  Color::{ r: r, g: g, b: b, a: 1.0, is_current_color: false }
}

///| Construct an sRGB `Color` with alpha in `[0.0, 1.0]`.
pub fn Color::rgba(r : Int, g : Int, b : Int, a : Double) -> Color {
  Color::{ r: r, g: g, b: b, a: a, is_current_color: false }
}

///| The `transparent` color (`rgba(0, 0, 0, 0)`).
pub fn Color::transparent() -> Color {
  Color::{ r: 0, g: 0, b: 0, a: 0.0, is_current_color: false }
}

///| The `currentcolor` keyword sentinel.
pub fn Color::current_color() -> Color {
  Color::{ r: 0, g: 0, b: 0, a: 1.0, is_current_color: true }
}

///| Equality for `Color` (exact RGB + alpha within 1e-6).
pub fn Color::eq(self : Color, other : Color) -> Bool {
  if self.is_current_color || other.is_current_color {
    return self.is_current_color && other.is_current_color
  }
  let da = self.a - other.a
  let abs_da = if da < 0.0 { 0.0 - da } else { da }
  self.r == other.r && self.g == other.g && self.b == other.b && abs_da < 0.000001
}

///| Media query leading modifier.
pub enum MediaModifier {
  None
  Not
  Only
}

///| Equality for `MediaModifier`.
pub fn media_modifier_eq(a : MediaModifier, b : MediaModifier) -> Bool {
  match (a, b) {
    (MediaModifier::None, MediaModifier::None) => true
    (MediaModifier::Not, MediaModifier::Not) => true
    (MediaModifier::Only, MediaModifier::Only) => true
    _ => false
  }
}

///| Comparison operator for Media Queries Level 4 range features.
pub enum MediaRangeOp {
  Eq
  Lt
  LtEq
  Gt
  GtEq
}

///| Equality for `MediaRangeOp`.
pub fn media_range_op_eq(a : MediaRangeOp, b : MediaRangeOp) -> Bool {
  match (a, b) {
    (MediaRangeOp::Eq, MediaRangeOp::Eq) => true
    (MediaRangeOp::Lt, MediaRangeOp::Lt) => true
    (MediaRangeOp::LtEq, MediaRangeOp::LtEq) => true
    (MediaRangeOp::Gt, MediaRangeOp::Gt) => true
    (MediaRangeOp::GtEq, MediaRangeOp::GtEq) => true
    _ => false
  }
}

///| A single media feature expression in parentheses.
pub enum MediaFeature {
  Plain(String, String)
  Boolean(String)
  Range(String, MediaRangeOp, String)
  RangeBetween(String, MediaRangeOp, String, MediaRangeOp, String)
}

///| Logical media condition tree.
pub enum MediaCondition {
  Feature(MediaFeature)
  Not(MediaCondition)
  And(Array[MediaCondition])
  Or(Array[MediaCondition])
}

///| A single parsed media query in a comma-separated media query list.
pub struct MediaQuery {
  pub modifier : MediaModifier
  pub media_type : String
  pub condition : Option[MediaCondition]
}
