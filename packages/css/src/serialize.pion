///| CSS serializer (`to_css`), AST minifier (`minify_stylesheet`), and single-pass streaming minifier (`minify`).

///| Write `src[start..end)` into `sb`, avoiding `String::slice` allocation for short spans (<= 8 bytes).
fn write_span(sb : StringBuilder, src : String, start : Int, end : Int) -> Unit {
  let len = end - start
  if len <= 0 {
    return
  }
  if len <= 8 {
    let mut i = start
    while i < end {
      sb.write_byte(src.code_unit_at(i).to_byte())
      i = i + 1
    }
  } else {
    sb.write_string(src.slice(start, end))
  }
}

///| Write `src[start..end)` lowercased into `sb` without allocating an intermediate string.
fn write_span_lower(sb : StringBuilder, src : String, start : Int, end : Int) -> Unit {
  let mut i = start
  while i < end {
    let b = src.code_unit_at(i)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
}

///| Zero-allocation check if unescaped `src[start..end)` is a zero-collapsible CSS length unit.
fn is_zero_collapsible_unit_slice(src : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len == 2 {
    let c0 = src.code_unit_at(start) | 32
    let c1 = src.code_unit_at(start + 1) | 32
    // px, em, pt, cm, mm, in, pc, ex, ch, vw, vh
    return (c0 == 112 && (c1 == 120 || c1 == 116 || c1 == 99)) ||
    (c0 == 101 && (c1 == 109 || c1 == 120)) ||
    (c0 == 99 && (c1 == 109 || c1 == 104)) ||
    (c0 == 109 && c1 == 109) ||
    (c0 == 105 && c1 == 110) ||
    (c0 == 118 && (c1 == 119 || c1 == 104))
  }
  if len == 3 {
    let c0 = src.code_unit_at(start) | 32
    let c1 = src.code_unit_at(start + 1) | 32
    let c2 = src.code_unit_at(start + 2) | 32
    return c0 == 114 && c1 == 101 && c2 == 109 // rem
  }
  if len == 4 {
    let c0 = src.code_unit_at(start) | 32
    let c1 = src.code_unit_at(start + 1) | 32
    let c2 = src.code_unit_at(start + 2) | 32
    let c3 = src.code_unit_at(start + 3) | 32
    return c0 == 118 && ((c1 == 109 && c2 == 105 && c3 == 110) || (c1 == 109 && c2 == 97 && c3 == 120))
  }
  false
}

///| Zero-allocation check if unescaped `src[start..end)` is a selector-list function name.
fn is_sel_func_slice(src : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len == 2 {
    return (src.code_unit_at(start) | 32) == 105 && (src.code_unit_at(start + 1) | 32) == 115
  }
  if len == 3 {
    let c0 = src.code_unit_at(start) | 32
    let c1 = src.code_unit_at(start + 1) | 32
    let c2 = src.code_unit_at(start + 2) | 32
    return (c0 == 110 && c1 == 111 && c2 == 116) || (c0 == 104 && c1 == 97 && c2 == 115)
  }
  if len == 5 {
    return (src.code_unit_at(start) | 32) == 119 &&
    (src.code_unit_at(start + 1) | 32) == 104 &&
    (src.code_unit_at(start + 2) | 32) == 101 &&
    (src.code_unit_at(start + 3) | 32) == 114 &&
    (src.code_unit_at(start + 4) | 32) == 101
  }
  if len == 8 {
    return (src.code_unit_at(start) | 32) == 115 &&
    (src.code_unit_at(start + 1) | 32) == 101 &&
    (src.code_unit_at(start + 2) | 32) == 108 &&
    (src.code_unit_at(start + 3) | 32) == 101 &&
    (src.code_unit_at(start + 4) | 32) == 99 &&
    (src.code_unit_at(start + 5) | 32) == 116 &&
    (src.code_unit_at(start + 6) | 32) == 111 &&
    (src.code_unit_at(start + 7) | 32) == 114
  }
  false
}

///| Zero-allocation check if unescaped `src[start..end)` is a CSS math function name.
fn is_math_func_slice(src : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len < 3 || len > 12 {
    return false
  }
  let c0 = src.code_unit_at(start) | 32
  // Quick reject for rgb/rgba/hsl/hsla/var/url/oklch/oklab/color/linear-gradient
  if c0 == 118 || c0 == 117 || c0 == 111 {
    return false
  }
  if c0 == 114 && len == 3 {
    // rgb vs rem
    return (src.code_unit_at(start + 1) | 32) == 101 && (src.code_unit_at(start + 2) | 32) == 109
  }
  if c0 == 114 && len == 4 {
    // rgba -> false
    return false
  }
  if c0 == 104 && (len == 3 || len == 4) {
    // hsl / hsla -> false
    return false
  }
  is_math_func_name(src.slice(start, end))
}

///| Write a minified hex body `src[start..end)` (without `#`, unescaped) directly into `sb` with zero alloc.
fn write_minified_hex_slice(sb : StringBuilder, src : String, start : Int, end : Int) -> Unit {
  let n = end - start
  let mut i = start
  while i < end {
    if HEX_LUT[src.code_unit_at(i)] < 0 {
      write_span(sb, src, start, end)
      return
    }
    i = i + 1
  }
  if n == 6 {
    let b0 = src.code_unit_at(start)
    let b1 = src.code_unit_at(start + 1)
    let b2 = src.code_unit_at(start + 2)
    let b3 = src.code_unit_at(start + 3)
    let b4 = src.code_unit_at(start + 4)
    let b5 = src.code_unit_at(start + 5)
    let l0 = if b0 >= 65 && b0 <= 90 { b0 + 32 } else { b0 }
    let l1 = if b1 >= 65 && b1 <= 90 { b1 + 32 } else { b1 }
    let l2 = if b2 >= 65 && b2 <= 90 { b2 + 32 } else { b2 }
    let l3 = if b3 >= 65 && b3 <= 90 { b3 + 32 } else { b3 }
    let l4 = if b4 >= 65 && b4 <= 90 { b4 + 32 } else { b4 }
    let l5 = if b5 >= 65 && b5 <= 90 { b5 + 32 } else { b5 }
    if l0 == l1 && l2 == l3 && l4 == l5 {
      sb.write_byte(l0.to_byte())
      sb.write_byte(l2.to_byte())
      sb.write_byte(l4.to_byte())
    } else {
      sb.write_byte(l0.to_byte())
      sb.write_byte(l1.to_byte())
      sb.write_byte(l2.to_byte())
      sb.write_byte(l3.to_byte())
      sb.write_byte(l4.to_byte())
      sb.write_byte(l5.to_byte())
    }
    return
  }
  if n == 8 {
    let a0_raw = src.code_unit_at(start + 6)
    let a1_raw = src.code_unit_at(start + 7)
    let a0 = if a0_raw >= 65 && a0_raw <= 90 { a0_raw + 32 } else { a0_raw }
    let a1 = if a1_raw >= 65 && a1_raw <= 90 { a1_raw + 32 } else { a1_raw }
    if a0 == 102 && a1 == 102 {
      write_minified_hex_slice(sb, src, start, start + 6)
      return
    }
    let b0 = src.code_unit_at(start)
    let b1 = src.code_unit_at(start + 1)
    let b2 = src.code_unit_at(start + 2)
    let b3 = src.code_unit_at(start + 3)
    let b4 = src.code_unit_at(start + 4)
    let b5 = src.code_unit_at(start + 5)
    let l0 = if b0 >= 65 && b0 <= 90 { b0 + 32 } else { b0 }
    let l1 = if b1 >= 65 && b1 <= 90 { b1 + 32 } else { b1 }
    let l2 = if b2 >= 65 && b2 <= 90 { b2 + 32 } else { b2 }
    let l3 = if b3 >= 65 && b3 <= 90 { b3 + 32 } else { b3 }
    let l4 = if b4 >= 65 && b4 <= 90 { b4 + 32 } else { b4 }
    let l5 = if b5 >= 65 && b5 <= 90 { b5 + 32 } else { b5 }
    if l0 == l1 && l2 == l3 && l4 == l5 && a0 == a1 {
      sb.write_byte(l0.to_byte())
      sb.write_byte(l2.to_byte())
      sb.write_byte(l4.to_byte())
      sb.write_byte(a0.to_byte())
    } else {
      sb.write_byte(l0.to_byte())
      sb.write_byte(l1.to_byte())
      sb.write_byte(l2.to_byte())
      sb.write_byte(l3.to_byte())
      sb.write_byte(l4.to_byte())
      sb.write_byte(l5.to_byte())
      sb.write_byte(a0.to_byte())
      sb.write_byte(a1.to_byte())
    }
    return
  }
  if n == 4 {
    let a_raw = src.code_unit_at(start + 3)
    let a = if a_raw >= 65 && a_raw <= 90 { a_raw + 32 } else { a_raw }
    if a == 102 {
      write_span_lower(sb, src, start, start + 3)
      return
    }
  }
  write_span_lower(sb, src, start, end)
}

fn is_zero_collapsible_unit(unit : String) -> Bool {
  let u = ascii_lower(unit)
  u == "px" ||
  u == "em" ||
  u == "rem" ||
  u == "pt" ||
  u == "cm" ||
  u == "mm" ||
  u == "in" ||
  u == "pc" ||
  u == "ex" ||
  u == "ch" ||
  u == "vw" ||
  u == "vh" ||
  u == "vmin" ||
  u == "vmax"
}

fn is_math_func_name(name : String) -> Bool {
  let n = ascii_lower(name)
  n == "calc" ||
  n == "min" ||
  n == "max" ||
  n == "clamp" ||
  n == "round" ||
  n == "mod" ||
  n == "rem" ||
  n == "abs" ||
  n == "sign" ||
  n == "hypot" ||
  n == "sin" ||
  n == "cos" ||
  n == "tan" ||
  n == "asin" ||
  n == "acos" ||
  n == "atan" ||
  n == "atan2" ||
  n == "pow" ||
  n == "sqrt" ||
  n == "exp" ||
  n == "log" ||
  n == "-webkit-calc" ||
  n == "-moz-calc" ||
  n == "calc-size"
}

fn is_ascii_alpha_only(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    let is_alpha = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
    if !is_alpha {
      return false
    }
    i = i + 1
  }
  true
}

///| Compress a raw CSS hex token (without leading `#`), e.g. `ffffff` -> `fff`, `aabbccdd` -> `abcd`.
fn minify_hex_body(hex : String) -> String {
  let n = hex.length()
  let mut i = 0
  while i < n {
    if hex_val(hex.code_unit_at(i)) < 0 {
      return hex
    }
    i = i + 1
  }
  let low = ascii_lower(hex)
  if n == 6 {
    if low.code_unit_at(0) == low.code_unit_at(1) &&
    low.code_unit_at(2) == low.code_unit_at(3) &&
    low.code_unit_at(4) == low.code_unit_at(5) {
      let sb = StringBuilder::with_capacity(3)
      sb.write_byte(low.code_unit_at(0).to_byte())
      sb.write_byte(low.code_unit_at(2).to_byte())
      sb.write_byte(low.code_unit_at(4).to_byte())
      return sb.to_string()
    }
    return low
  }
  if n == 8 {
    let a0 = low.code_unit_at(6)
    let a1 = low.code_unit_at(7)
    // Opaque alpha `ff` -> drop alpha
    if a0 == 102 && a1 == 102 {
      return minify_hex_body(low.slice(0, 6))
    }
    if low.code_unit_at(0) == low.code_unit_at(1) &&
    low.code_unit_at(2) == low.code_unit_at(3) &&
    low.code_unit_at(4) == low.code_unit_at(5) &&
    a0 == a1 {
      let sb = StringBuilder::with_capacity(4)
      sb.write_byte(low.code_unit_at(0).to_byte())
      sb.write_byte(low.code_unit_at(2).to_byte())
      sb.write_byte(low.code_unit_at(4).to_byte())
      sb.write_byte(a0.to_byte())
      return sb.to_string()
    }
    return low
  }
  if n == 4 {
    if low.code_unit_at(3) == 102 {
      return low.slice(0, 3)
    }
    return low
  }
  low
}

///| Check if a raw numeric slice represents zero (e.g. `0`, `+0`, `-0`, `0.0`, `00.00`).
fn raw_number_is_zero(src : String, start : Int, end : Int) -> Bool {
  let mut i = start
  if i < end && (src.code_unit_at(i) == 43 || src.code_unit_at(i) == 45) {
    i = i + 1
  }
  let mut saw_digit = false
  while i < end {
    let b = src.code_unit_at(i)
    if b == 48 || b == 46 {
      if b == 48 {
        saw_digit = true
      }
      i = i + 1
    } else if b == 101 || b == 69 {
      // Exponent: 0e... is still 0 if mantissa was 0
      return saw_digit
    } else {
      return false
    }
  }
  saw_digit
}

///| Strip leading `+` and redundant leading zeros (`0.5` -> `.5`, `-0.5` -> `-.5`, `00.5` -> `.5`).
fn write_minified_number(sb : StringBuilder, src : String, start : Int, end : Int) -> Unit {
  let mut i = start
  let mut neg = false
  if i < end {
    let b0 = src.code_unit_at(i)
    if b0 == 43 {
      i = i + 1
    } else if b0 == 45 {
      neg = true
      i = i + 1
    }
  }
  // Skip redundant leading '0's before another digit or '.'
  while i + 1 < end && src.code_unit_at(i) == 48 {
    let nxt = src.code_unit_at(i + 1)
    if (nxt >= 48 && nxt <= 57) || nxt == 46 {
      i = i + 1
    } else {
      break
    }
  }
  if neg {
    sb.write_byte((45).to_byte())
  }
  if i < end {
    write_span(sb, src, i, end)
  } else {
    sb.write_byte((48).to_byte())
  }
}

///| W3C CSS Syntax Level 3 §9.2 token-pair separation check.
///| Returns true if emitting `next_tk` directly after `prev_tk` (with no separator)
///| would re-tokenize into a different token stream.
fn tokens_need_sep(
  prev_tk : Int,
  prev_delim : Int,
  next_tk : Int,
  next_delim : Int,
) -> Bool {
  if prev_tk == TK_EOF {
    return false
  }
  // Next is ident-like / numeric / cdc
  let next_is_ident_or_num = next_tk == TK_IDENT ||
  next_tk == TK_FUNC ||
  next_tk == TK_URL ||
  next_tk == TK_BADURL ||
  next_tk == TK_NUM ||
  next_tk == TK_PCT ||
  next_tk == TK_DIM ||
  next_tk == TK_CDC
  let next_is_num = next_tk == TK_NUM || next_tk == TK_PCT || next_tk == TK_DIM
  let next_is_dash = next_tk == TK_DELIM && next_delim == 45

  if prev_tk == TK_IDENT {
    return next_is_ident_or_num || next_is_dash || next_tk == TK_LPAR
  }
  if prev_tk == TK_AT || prev_tk == TK_HASH_ID || prev_tk == TK_HASH_UN || prev_tk == TK_DIM {
    return next_is_ident_or_num || next_is_dash
  }
  if prev_tk == TK_NUM {
    return next_is_ident_or_num || next_is_dash || (next_tk == TK_DELIM && next_delim == 37)
  }
  if prev_tk == TK_DELIM {
    if prev_delim == 35 {
      // '#'
      return next_is_ident_or_num || next_is_dash
    }
    if prev_delim == 45 {
      // '-'
      return next_is_ident_or_num || next_is_dash || (next_tk == TK_DELIM && next_delim == 62)
    }
    if prev_delim == 64 {
      // '@'
      return next_tk == TK_IDENT ||
      next_tk == TK_FUNC ||
      next_tk == TK_URL ||
      next_tk == TK_BADURL ||
      next_is_dash ||
      next_tk == TK_CDC
    }
    if prev_delim == 46 || prev_delim == 43 {
      // '.' or '+'
      return next_is_num
    }
    if prev_delim == 47 {
      // '/' + '*' -> comment start!
      return next_tk == TK_DELIM && next_delim == 42
    }
    if prev_delim == 60 {
      // '<' + '!' -> CDO start
      return next_tk == TK_DELIM && next_delim == 33
    }
    if prev_delim == 126 || prev_delim == 124 || prev_delim == 94 || prev_delim == 36 || prev_delim == 42 {
      // '~', '|', '^', '$', '*' + '='
      if next_tk == TK_DELIM && next_delim == 61 {
        return true
      }
      if prev_delim == 124 && next_tk == TK_DELIM && next_delim == 124 {
        return true
      }
      return false
    }
    if prev_delim == 92 {
      // '\'
      return true
    }
  }
  false
}

///| Zero-allocation ASCII case-insensitive equality between `src[start..end)` and lowercase `lit`.
fn slice_eq_lower_lit(src : String, start : Int, end : Int, lit : String) -> Bool {
  let len = end - start
  if len != lit.length() {
    return false
  }
  let mut i = 0
  while i < len {
    let b = src.code_unit_at(start + i)
    let lb = if b >= 65 && b <= 90 { b + 32 } else { b }
    if lb != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Zero-allocation check if unescaped property `src[start..end)` forbids `0px -> 0` collapse (`flex` / `line-height`).
fn is_no_zero_collapse_prop_slice(src : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len == 4 {
    return slice_eq_lower_lit(src, start, end, "flex")
  }
  if len == 11 {
    return slice_eq_lower_lit(src, start, end, "line-height")
  }
  false
}

///| Zero-allocation at-rule block context classifier for unescaped `@name` slice `src[start..end)`.
fn classify_at_rule_ctx_slice(src : String, start : Int, end : Int, parent_nested : Bool) -> Int {
  let len = end - start
  if len == 4 && slice_eq_lower_lit(src, start, end, "page") {
    return CTX_DECL_LIST
  }
  if len == 5 {
    if slice_eq_lower_lit(src, start, end, "media") ||
    slice_eq_lower_lit(src, start, end, "layer") ||
    slice_eq_lower_lit(src, start, end, "scope") {
      return if parent_nested { CTX_BODY } else { CTX_RULE_LIST }
    }
    return CTX_BODY
  }
  if len == 8 {
    if slice_eq_lower_lit(src, start, end, "supports") ||
    slice_eq_lower_lit(src, start, end, "document") {
      return if parent_nested { CTX_BODY } else { CTX_RULE_LIST }
    }
    if slice_eq_lower_lit(src, start, end, "property") ||
    slice_eq_lower_lit(src, start, end, "viewport") {
      return CTX_DECL_LIST
    }
    return CTX_BODY
  }
  if len == 9 {
    if slice_eq_lower_lit(src, start, end, "keyframes") {
      return CTX_RULE_LIST
    }
    if slice_eq_lower_lit(src, start, end, "font-face") {
      return CTX_DECL_LIST
    }
    if slice_eq_lower_lit(src, start, end, "container") {
      return if parent_nested { CTX_BODY } else { CTX_RULE_LIST }
    }
    return CTX_BODY
  }
  if len > 10 && slice_eq_lower_lit(src, end - 10, end, "-keyframes") {
    return CTX_RULE_LIST
  }
  if len == 13 {
    if slice_eq_lower_lit(src, start, end, "counter-style") {
      return CTX_DECL_LIST
    }
    return CTX_BODY
  }
  if len == 14 && slice_eq_lower_lit(src, start, end, "starting-style") {
    return if parent_nested { CTX_BODY } else { CTX_RULE_LIST }
  }
  if len == 19 &&
  (slice_eq_lower_lit(src, start, end, "font-palette-values") ||
    slice_eq_lower_lit(src, start, end, "font-feature-values")) {
    return CTX_DECL_LIST
  }
  CTX_BODY
}

///| Minify a prelude slice `clean[start..end)` directly into `sb` reusing `lex` and `sel_stack`.
///| Preserves descendant combinators before `:` inside `:is()`/`:not()`/`:where()`/`:has()`/`selector()` (P0-2).
fn minify_prelude_into(
  sb : StringBuilder,
  clean : String,
  start : Int,
  end : Int,
  lut : FixedArray[Int],
  is_at_rule : Bool,
  lex : Lexer,
  sel_stack : Array[Bool],
) -> Unit {
  let mut sel_len = 0
  lex.reset_range(start, end)
  let mut paren_depth = 0
  let mut sel_func_depth = 0
  let mut prev_tk = TK_EOF
  let mut prev_delim = 0
  let mut pending_ws = false

  while true {
    let tk = lex.next_fast()
    if tk <= TK_EOF {
      break
    }
    if tk == TK_WS {
      if prev_tk != TK_EOF {
        pending_ws = true
      }
      continue
    }

    let cur_delim = if tk == TK_DELIM && lex.tok_end - lex.tok_start == 1 {
      clean.code_unit_at(lex.tok_start)
    } else {
      0
    }

    // Decide whether to emit a separator before this token
    if prev_tk != TK_EOF {
      if pending_ws {
        let in_at_feature = is_at_rule && paren_depth > 0 && sel_func_depth == 0
        let prev_tight = prev_tk == TK_COMMA ||
        prev_tk == TK_LPAR ||
        prev_tk == TK_LSQ ||
        prev_tk == TK_FUNC ||
        (prev_tk == TK_COLON && in_at_feature) ||
        (prev_tk == TK_DELIM && (prev_delim == 62 || prev_delim == 43 || prev_delim == 126))
        let next_tight = tk == TK_COMMA ||
        tk == TK_RPAR ||
        tk == TK_RSQ ||
        (tk == TK_COLON && in_at_feature) ||
        (tk == TK_DELIM && (cur_delim == 62 || cur_delim == 43 || cur_delim == 126))
        if (!prev_tight && !next_tight) || tokens_need_sep(prev_tk, prev_delim, tk, cur_delim) {
          sb.write_byte((32).to_byte())
        }
      } else if lex.saw_comment && tokens_need_sep(prev_tk, prev_delim, tk, cur_delim) {
        // Two tokens were separated only by a comment (no whitespace) -> preserve with `/**/`
        // so we do NOT introduce a descendant combinator in a selector!
        sb.write_string("/**/")
      }
    }
    pending_ws = false

    if tk == TK_FUNC {
      paren_depth = paren_depth + 1
      let is_sel_fn = if !lex.tok_has_esc {
        is_sel_func_slice(clean, lex.tok_start, lex.tok_end - 1)
      } else {
        let fname = decode_ident_slice(clean, lex.tok_start, lex.tok_end - 1, true, lut)
        ascii_eq_ignore_case(fname, "selector") ||
        ascii_eq_ignore_case(fname, "is") ||
        ascii_eq_ignore_case(fname, "not") ||
        ascii_eq_ignore_case(fname, "where") ||
        ascii_eq_ignore_case(fname, "has")
      }
      if sel_len < sel_stack.length() {
        sel_stack[sel_len] = is_sel_fn
      } else {
        sel_stack.push(is_sel_fn)
      }
      sel_len = sel_len + 1
      if is_sel_fn {
        sel_func_depth = sel_func_depth + 1
      }
      write_span(sb, clean, lex.tok_start, lex.tok_end)
    } else if tk == TK_LPAR {
      paren_depth = paren_depth + 1
      if sel_len < sel_stack.length() {
        sel_stack[sel_len] = false
      } else {
        sel_stack.push(false)
      }
      sel_len = sel_len + 1
      sb.write_byte((40).to_byte())
    } else if tk == TK_RPAR {
      if paren_depth > 0 {
        paren_depth = paren_depth - 1
      }
      if sel_len > 0 {
        sel_len = sel_len - 1
        if sel_stack[sel_len] && sel_func_depth > 0 {
          sel_func_depth = sel_func_depth - 1
        }
      }
      sb.write_byte((41).to_byte())
    } else {
      write_span(sb, clean, lex.tok_start, lex.tok_end)
    }

    prev_tk = tk
    prev_delim = cur_delim
  }
}

///| Minify a standard declaration value `clean[start..end)` directly into `sb` reusing `lex` and `math_stack`.
///| Enforces P1-1 (CSS Syntax §9 separation), P1-2 (no 0px->0 inside functions or flex/line-height),
///| P1-3 (escaped unit fidelity), and P2-9 (idempotence).
fn minify_decl_value_into_flag(
  sb : StringBuilder,
  clean : String,
  start : Int,
  end : Int,
  allow_zero_collapse : Bool,
  lut : FixedArray[Int],
  lex : Lexer,
  math_stack : Array[Bool],
) -> Unit {
  if start >= end {
    return
  }
  let mut math_len = 0
  lex.reset_range(start, end)
  let mut func_depth = 0
  let mut math_depth = 0
  let mut prev_tk = TK_EOF
  let mut prev_delim = 0
  let mut pending_ws = false

  while true {
    let tk = lex.next_fast()
    if tk <= TK_EOF {
      break
    }
    if tk == TK_WS {
      if prev_tk != TK_EOF {
        pending_ws = true
      }
      continue
    }

    let cur_delim = if tk == TK_DELIM && lex.tok_end - lex.tok_start == 1 {
      clean.code_unit_at(lex.tok_start)
    } else {
      0
    }

    // Determine effective output token kind (for separator check):
    // If `0px` collapses to `0`, its emitted kind is TK_NUM; otherwise same as `tk`.
    let mut emit_as_zero_num = false
    if tk == TK_DIM && allow_zero_collapse && func_depth == 0 && raw_number_is_zero(clean, lex.tok_start, lex.tok_num_end) {
      if !lex.tok_has_esc {
        if is_zero_collapsible_unit_slice(clean, lex.tok_num_end, lex.tok_end) {
          emit_as_zero_num = true
        }
      } else {
        let unit_str = decode_ident_slice(clean, lex.tok_num_end, lex.tok_end, true, lut)
        if is_zero_collapsible_unit(unit_str) {
          emit_as_zero_num = true
        }
      }
    }
    let eff_tk = if emit_as_zero_num { TK_NUM } else { tk }

    // Emit separator if required
    if prev_tk != TK_EOF {
      let stripped_plus = (tk == TK_NUM || tk == TK_PCT || tk == TK_DIM) && clean.code_unit_at(lex.tok_start) == 43
      let need_sep = (pending_ws || lex.saw_comment || stripped_plus || emit_as_zero_num) &&
      tokens_need_sep(prev_tk, prev_delim, eff_tk, cur_delim)
      if need_sep {
        sb.write_byte((32).to_byte())
      } else if pending_ws {
        let prev_tight = prev_tk == TK_COMMA ||
        prev_tk == TK_LPAR ||
        prev_tk == TK_FUNC ||
        prev_tk == TK_COLON ||
        (prev_tk == TK_DELIM && prev_delim == 47 && math_depth == 0)
        let next_tight = tk == TK_COMMA ||
        tk == TK_RPAR ||
        (tk == TK_DELIM && cur_delim == 47 && math_depth == 0)
        let need_math_space = math_depth > 0 && (
          (prev_tk == TK_DELIM && (prev_delim == 43 || prev_delim == 45)) ||
          (tk == TK_DELIM && (cur_delim == 43 || cur_delim == 45))
        )
        if need_math_space || (!prev_tight && !next_tight) {
          sb.write_byte((32).to_byte())
        }
      }
    }
    pending_ws = false

    // Emit the token itself
    if tk == TK_FUNC {
      func_depth = func_depth + 1
      let is_math = if !lex.tok_has_esc {
        is_math_func_slice(clean, lex.tok_start, lex.tok_end - 1)
      } else {
        is_math_func_name(decode_ident_slice(clean, lex.tok_start, lex.tok_end - 1, true, lut))
      }
      if math_len < math_stack.length() {
        math_stack[math_len] = is_math
      } else {
        math_stack.push(is_math)
      }
      math_len = math_len + 1
      if is_math {
        math_depth = math_depth + 1
      }
      write_span(sb, clean, lex.tok_start, lex.tok_end)
    } else if tk == TK_LPAR {
      if math_len < math_stack.length() {
        math_stack[math_len] = false
      } else {
        math_stack.push(false)
      }
      math_len = math_len + 1
      sb.write_byte((40).to_byte())
    } else if tk == TK_RPAR {
      if math_len > 0 {
        math_len = math_len - 1
        if math_stack[math_len] && math_depth > 0 {
          math_depth = math_depth - 1
        }
      }
      if func_depth > 0 {
        func_depth = func_depth - 1
      }
      sb.write_byte((41).to_byte())
    } else if tk == TK_HASH_ID || tk == TK_HASH_UN {
      sb.write_byte((35).to_byte())
      if !lex.tok_has_esc {
        write_minified_hex_slice(sb, clean, lex.tok_start + 1, lex.tok_end)
      } else {
        let body = decode_ident_slice(clean, lex.tok_start + 1, lex.tok_end, true, lut)
        sb.write_string(minify_hex_body(body))
      }
    } else if tk == TK_DIM {
      if emit_as_zero_num {
        sb.write_byte((48).to_byte())
      } else {
        write_minified_number(sb, clean, lex.tok_start, lex.tok_num_end)
        if !lex.tok_has_esc {
          write_span_lower(sb, clean, lex.tok_num_end, lex.tok_end)
        } else {
          let decoded = decode_ident_slice(clean, lex.tok_num_end, lex.tok_end, true, lut)
          if is_ascii_alpha_only(decoded) {
            sb.write_string(ascii_lower(decoded))
          } else {
            write_span(sb, clean, lex.tok_num_end, lex.tok_end)
          }
        }
      }
    } else if tk == TK_NUM {
      write_minified_number(sb, clean, lex.tok_start, lex.tok_end)
    } else if tk == TK_PCT {
      write_minified_number(sb, clean, lex.tok_start, lex.tok_end - 1)
      sb.write_byte((37).to_byte())
    } else {
      write_span(sb, clean, lex.tok_start, lex.tok_end)
    }

    prev_tk = eff_tk
    prev_delim = cur_delim
  }
}

fn minify_decl_value_into(
  sb : StringBuilder,
  clean : String,
  start : Int,
  end : Int,
  prop_name : String,
  lut : FixedArray[Int],
  lex : Lexer,
  math_stack : Array[Bool],
) -> Unit {
  let allow_zero_collapse = prop_name != "flex" && prop_name != "line-height"
  minify_decl_value_into_flag(sb, clean, start, end, allow_zero_collapse, lut, lex, math_stack)
}

fn minify_prelude(prelude : String, is_at_rule : Bool) -> String {
  let clean = preprocess_string(prelude)
  let sb = StringBuilder::with_capacity(clean.length())
  let sub_lex = Lexer::new_slice(clean, 0, clean.length())
  let sel_stack : Array[Bool] = []
  minify_prelude_into(sb, clean, 0, clean.length(), CSS_LUT, is_at_rule, sub_lex, sel_stack)
  sb.to_string()
}

fn minify_decl_value(value : String, prop_name : String) -> String {
  let clean = preprocess_string(value)
  let sb = StringBuilder::with_capacity(clean.length())
  let sub_lex = Lexer::new_slice(clean, 0, clean.length())
  let math_stack : Array[Bool] = []
  minify_decl_value_into(sb, clean, 0, clean.length(), prop_name, CSS_LUT, sub_lex, math_stack)
  sb.to_string()
}

fn write_indent(sb : StringBuilder, depth : Int) -> Unit {
  let mut k = 0
  while k < depth {
    sb.write_string("  ")
    k = k + 1
  }
}

enum SerOp {
  EmitRule(Rule, Int)
  EmitDecl(Declaration, Int, Bool)
  CloseBlock(Int)
}

///| Push declarations and nested rules onto `ops` in reverse source order (preserving P0-1 interleaving).
fn push_body_items_reversed(
  ops : Array[SerOp],
  decls : Array[Declaration],
  rules : Array[Rule],
  child_depth : Int,
) -> Unit {
  let mut d = decls.length() - 1
  let mut r = rules.length() - 1
  let mut has_following = false
  while d >= 0 || r >= 0 {
    if d >= 0 && (r < 0 || decls[d].after_rule > r) {
      ops.push(SerOp::EmitDecl(decls[d], child_depth, has_following))
      has_following = true
      d = d - 1
    } else {
      ops.push(SerOp::EmitRule(rules[r], child_depth))
      has_following = true
      r = r - 1
    }
  }
}

///| 100% iterative formatted CSS serializer (preserves declaration/nested-rule source order).
pub fn to_css_internal(sheet : Stylesheet) -> String {
  let n_rules = sheet.rules.length()
  let sb = StringBuilder::with_capacity(n_rules * 96 + 64)
  let ops : Array[SerOp] = Array::with_capacity(n_rules + 16)
  let mut idx = n_rules - 1
  while idx >= 0 {
    ops.push(SerOp::EmitRule(sheet.rules[idx], 0))
    idx = idx - 1
  }

  let mut first = true
  while ops.length() > 0 {
    let op = ops[ops.length() - 1]
    let _ = ops.pop()
    match op {
      SerOp::CloseBlock(depth) => {
        write_indent(sb, depth)
        sb.write_string("}\n")
      }
      SerOp::EmitDecl(decl, depth, _) => {
        write_indent(sb, depth)
        sb.write_string(decl.name)
        if decl.is_custom {
          sb.write_byte((58).to_byte())
          sb.write_string(decl.value)
        } else {
          sb.write_string(": ")
          sb.write_string(decl.value)
        }
        if decl.important {
          sb.write_string(" !important")
        }
        sb.write_string(";\n")
      }
      SerOp::EmitRule(rule, depth) => {
        if !first && depth == 0 {
          sb.write_byte((10).to_byte())
        }
        first = false
        match rule {
          Rule::Qualified(qr) => {
            write_indent(sb, depth)
            sb.write_string(qr.prelude)
            sb.write_string(" {\n")
            if qr.nested_rules.length() == 0 {
              let decls = qr.declarations
              let dn = decls.length()
              let child_depth = depth + 1
              let mut di = 0
              while di < dn {
                let decl = decls[di]
                write_indent(sb, child_depth)
                sb.write_string(decl.name)
                if decl.is_custom {
                  sb.write_byte((58).to_byte())
                  sb.write_string(decl.value)
                } else {
                  sb.write_string(": ")
                  sb.write_string(decl.value)
                }
                if decl.important {
                  sb.write_string(" !important")
                }
                sb.write_string(";\n")
                di = di + 1
              }
              write_indent(sb, depth)
              sb.write_string("}\n")
            } else {
              ops.push(SerOp::CloseBlock(depth))
              push_body_items_reversed(ops, qr.declarations, qr.nested_rules, depth + 1)
            }
          }
          Rule::At(ar) => {
            write_indent(sb, depth)
            sb.write_byte((64).to_byte())
            sb.write_string(ar.name)
            if ar.prelude.length() > 0 {
              sb.write_byte((32).to_byte())
              sb.write_string(ar.prelude)
            }
            if !ar.has_block {
              sb.write_string(";\n")
            } else if ar.rules.length() == 0 {
              sb.write_string(" {\n")
              let decls = ar.declarations
              let dn = decls.length()
              let child_depth = depth + 1
              let mut di = 0
              while di < dn {
                let decl = decls[di]
                write_indent(sb, child_depth)
                sb.write_string(decl.name)
                if decl.is_custom {
                  sb.write_byte((58).to_byte())
                  sb.write_string(decl.value)
                } else {
                  sb.write_string(": ")
                  sb.write_string(decl.value)
                }
                if decl.important {
                  sb.write_string(" !important")
                }
                sb.write_string(";\n")
                di = di + 1
              }
              write_indent(sb, depth)
              sb.write_string("}\n")
            } else {
              sb.write_string(" {\n")
              ops.push(SerOp::CloseBlock(depth))
              push_body_items_reversed(ops, ar.declarations, ar.rules, depth + 1)
            }
          }
        }
      }
    }
  }
  sb.to_string()
}

///| 100% iterative AST CSS stylesheet minifier (preserves declaration/nested-rule source order).
pub fn minify_stylesheet_internal(sheet : Stylesheet) -> String {
  let n_rules = sheet.rules.length()
  let est_cap = if n_rules > 16384 { 1048576 } else { n_rules * 64 + 64 }
  let sb = StringBuilder::with_capacity(est_cap)
  let lut = CSS_LUT
  let sel_stack : Array[Bool] = Array::with_capacity(8)
  let math_stack : Array[Bool] = Array::with_capacity(8)
  let ops : Array[SerOp] = Array::with_capacity(n_rules + 16)
  let mut idx = n_rules - 1
  while idx >= 0 {
    ops.push(SerOp::EmitRule(sheet.rules[idx], 0))
    idx = idx - 1
  }

  while ops.length() > 0 {
    let op = ops[ops.length() - 1]
    let _ = ops.pop()
    match op {
      SerOp::CloseBlock(_) => sb.write_byte((125).to_byte())
      SerOp::EmitDecl(decl, _, need_semi) => {
        sb.write_string(decl.name)
        sb.write_byte((58).to_byte())
        if decl.is_custom {
          sb.write_string(decl.value)
        } else {
          let clean_val = preprocess_string(decl.value)
          let vlen = clean_val.length()
          let vlex = Lexer::new_slice(clean_val, 0, vlen)
          minify_decl_value_into(sb, clean_val, 0, vlen, decl.name, lut, vlex, math_stack)
        }
        if decl.important {
          sb.write_string("!important")
        }
        if need_semi {
          sb.write_byte((59).to_byte())
        }
      }
      SerOp::EmitRule(rule, depth) => {
        match rule {
          Rule::Qualified(qr) => {
            let clean_pre = preprocess_string(qr.prelude)
            let plen = clean_pre.length()
            let plex = Lexer::new_slice(clean_pre, 0, plen)
            minify_prelude_into(sb, clean_pre, 0, plen, lut, false, plex, sel_stack)
            sb.write_byte((123).to_byte())
            if qr.nested_rules.length() == 0 {
              let decls = qr.declarations
              let dn = decls.length()
              let mut di = 0
              while di < dn {
                let decl = decls[di]
                sb.write_string(decl.name)
                sb.write_byte((58).to_byte())
                if decl.is_custom {
                  sb.write_string(decl.value)
                } else {
                  let clean_val = preprocess_string(decl.value)
                  let vlen = clean_val.length()
                  let vlex = Lexer::new_slice(clean_val, 0, vlen)
                  minify_decl_value_into(sb, clean_val, 0, vlen, decl.name, lut, vlex, math_stack)
                }
                if decl.important {
                  sb.write_string("!important")
                }
                if di + 1 < dn {
                  sb.write_byte((59).to_byte())
                }
                di = di + 1
              }
              sb.write_byte((125).to_byte())
            } else {
              ops.push(SerOp::CloseBlock(depth))
              push_body_items_reversed(ops, qr.declarations, qr.nested_rules, depth + 1)
            }
          }
          Rule::At(ar) => {
            sb.write_byte((64).to_byte())
            sb.write_string(ar.name)
            if ar.prelude.length() > 0 {
              sb.write_byte((32).to_byte())
              let clean_pre = preprocess_string(ar.prelude)
              let plen = clean_pre.length()
              let plex = Lexer::new_slice(clean_pre, 0, plen)
              minify_prelude_into(sb, clean_pre, 0, plen, lut, true, plex, sel_stack)
            }
            if !ar.has_block {
              sb.write_byte((59).to_byte())
            } else if ar.rules.length() == 0 {
              sb.write_byte((123).to_byte())
              let decls = ar.declarations
              let dn = decls.length()
              let mut di = 0
              while di < dn {
                let decl = decls[di]
                sb.write_string(decl.name)
                sb.write_byte((58).to_byte())
                if decl.is_custom {
                  sb.write_string(decl.value)
                } else {
                  let clean_val = preprocess_string(decl.value)
                  let vlen = clean_val.length()
                  let vlex = Lexer::new_slice(clean_val, 0, vlen)
                  minify_decl_value_into(sb, clean_val, 0, vlen, decl.name, lut, vlex, math_stack)
                }
                if decl.important {
                  sb.write_string("!important")
                }
                if di + 1 < dn {
                  sb.write_byte((59).to_byte())
                }
                di = di + 1
              }
              sb.write_byte((125).to_byte())
            } else {
              sb.write_byte((123).to_byte())
              ops.push(SerOp::CloseBlock(depth))
              push_body_items_reversed(ops, ar.declarations, ar.rules, depth + 1)
            }
          }
        }
      }
    }
  }
  let _ = minify_prelude
  let _ = minify_decl_value
  sb.to_string()
}

///| Single-pass streaming CSS minifier (zero AST materialization, zero `Array[Token]`).
pub fn minify_internal(
  src : String,
  opts : ParseOptions,
) -> Result[String, CssError] {
  let clean = preprocess_string(src)
  let lex = Lexer::new(clean, opts.max_tokens)
  let sub_lex = Lexer::new_slice(clean, 0, 0)
  let lut = lex.lut
  let max_paren = compute_paren_limit(opts.max_depth)
  let sb = StringBuilder::with_capacity(clean.length())

  // Explicit iterative block context stack (index-managed, zero Option boxing on pop)
  let ctx_stack : Array[Int] = Array::with_capacity(16)
  let nested_stack : Array[Bool] = Array::with_capacity(16)
  let semi_stack : Array[Bool] = Array::with_capacity(16)
  ctx_stack.push(CTX_RULE_LIST)
  nested_stack.push(false)
  semi_stack.push(false)
  let mut stack_len = 1
  let sel_stack : Array[Bool] = Array::with_capacity(8)
  let math_stack : Array[Bool] = Array::with_capacity(8)
  let mut rule_count = 0

  while true {
    let tk = lex.next_fast()
    if tk < 0 {
      return Err(lex.limit_err())
    }
    if tk == TK_EOF {
      break
    }

    if tk == TK_WS {
      continue
    }

    let top = stack_len - 1
    let cur_ctx = ctx_stack[top]
    let at_root = top == 0

    if at_root && (tk == TK_CDO || tk == TK_CDC) {
      continue
    }
    if !at_root {
      if tk == TK_RCUR {
        sb.write_byte((125).to_byte())
        stack_len = stack_len - 1
        continue
      }
      if tk == TK_SEMI && cur_ctx != CTX_RULE_LIST {
        continue
      }
    }

    // At-rule (zero-alloc unescaped name + prelude fast path)
    if tk == TK_AT {
      rule_count = rule_count + 1
      if rule_count > opts.max_rules {
        return Err(
          CssError::new(
            CssErrorKind::LimitExceeded,
            lex.tok_start,
            1,
            1,
            "rule limit exceeded",
          ),
        )
      }
      if semi_stack[top] {
        sb.write_byte((59).to_byte())
        semi_stack[top] = false
      }
      let at_name_start = lex.tok_start + 1
      let at_name_end = lex.tok_end
      let at_has_esc = lex.tok_has_esc
      let at_name_owned = if at_has_esc {
        decode_prop_name(clean, at_name_start, at_name_end, true, false, lut)
      } else {
        ""
      }
      let mut p_tk = lex.next_fast()
      if p_tk < 0 {
        return Err(lex.limit_err())
      }
      while p_tk == TK_WS {
        p_tk = lex.next_fast()
        if p_tk < 0 {
          return Err(lex.limit_err())
        }
      }
      let p_start = lex.tok_start
      let stop_kind = match scan_prelude_unified(
        lex,
        p_tk,
        lex.tok_start,
        lex.tok_end,
        true,
        !at_root,
        max_paren,
      ) {
        Ok(k) => k
        Err(e) => return Err(e)
      }
      let p_end = lex.tok_end
      sb.write_byte((64).to_byte())
      if at_has_esc {
        sb.write_string(at_name_owned)
      } else {
        write_span_lower(sb, clean, at_name_start, at_name_end)
      }
      if p_end > p_start {
        sb.write_byte((32).to_byte())
        minify_prelude_into(sb, clean, p_start, p_end, lut, true, sub_lex, sel_stack)
      }
      if stop_kind == 2 {
        if stack_len > opts.max_depth {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              lex.tok_start,
              1,
              1,
              "nesting depth limit exceeded",
            ),
          )
        }
        sb.write_byte((123).to_byte())
        let child_ctx = if !at_has_esc {
          classify_at_rule_ctx_slice(clean, at_name_start, at_name_end, nested_stack[top])
        } else if is_decl_at_rule(at_name_owned) {
          CTX_DECL_LIST
        } else if is_keyframes_at_rule(at_name_owned) {
          CTX_RULE_LIST
        } else if is_group_at_rule(at_name_owned) {
          if nested_stack[top] { CTX_BODY } else { CTX_RULE_LIST }
        } else {
          CTX_BODY
        }
        let child_nested = nested_stack[top] || child_ctx == CTX_BODY
        if stack_len < ctx_stack.length() {
          ctx_stack[stack_len] = child_ctx
          nested_stack[stack_len] = child_nested
          semi_stack[stack_len] = false
        } else {
          ctx_stack.push(child_ctx)
          nested_stack.push(child_nested)
          semi_stack.push(false)
        }
        stack_len = stack_len + 1
      } else {
        sb.write_byte((59).to_byte())
        if stop_kind == 3 && !at_root {
          sb.write_byte((125).to_byte())
          stack_len = stack_len - 1
        }
      }
      continue
    }

    // CTX_RULE_LIST: qualified rule only
    if cur_ctx == CTX_RULE_LIST {
      let item_start = lex.tok_start
      let stop_kind = match scan_prelude_unified(
        lex,
        tk,
        lex.tok_start,
        lex.tok_end,
        false,
        !at_root,
        max_paren,
      ) {
        Ok(k) => k
        Err(e) => return Err(e)
      }
      let item_end = lex.tok_end
      if stop_kind == 2 {
        rule_count = rule_count + 1
        if rule_count > opts.max_rules {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              item_start,
              1,
              1,
              "rule limit exceeded",
            ),
          )
        }
        if stack_len > opts.max_depth {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              lex.tok_start,
              1,
              1,
              "nesting depth limit exceeded",
            ),
          )
        }
        if semi_stack[top] {
          sb.write_byte((59).to_byte())
          semi_stack[top] = false
        }
        if item_end > item_start {
          minify_prelude_into(sb, clean, item_start, item_end, lut, false, sub_lex, sel_stack)
        }
        sb.write_byte((123).to_byte())
        if stack_len < ctx_stack.length() {
          ctx_stack[stack_len] = CTX_BODY
          nested_stack[stack_len] = true
          semi_stack[stack_len] = false
        } else {
          ctx_stack.push(CTX_BODY)
          nested_stack.push(true)
          semi_stack.push(false)
        }
        stack_len = stack_len + 1
      } else if stop_kind == 3 && !at_root {
        sb.write_byte((125).to_byte())
        stack_len = stack_len - 1
      }
      continue
    }

    // CTX_BODY or CTX_DECL_LIST
    let item_start = lex.tok_start
    let item_end_first = lex.tok_end
    if tk == TK_IDENT {
      let name_has_esc = lex.tok_has_esc
      let mut is_colon = false
      let mut next_tk = TK_EOF
      if !lex.check_limit && lex.pos < lex.n && clean.code_unit_at(lex.pos) == 58 {
        lex.pos = lex.pos + 1
        is_colon = true
      } else {
        next_tk = lex.next_fast()
        if next_tk < 0 {
          return Err(lex.limit_err())
        }
        while next_tk == TK_WS {
          next_tk = lex.next_fast()
          if next_tk < 0 {
            return Err(lex.limit_err())
          }
        }
        is_colon = next_tk == TK_COLON
      }
      if is_colon {
        let is_custom = if !name_has_esc {
          item_end_first - item_start >= 2 &&
          clean.code_unit_at(item_start) == 45 &&
          clean.code_unit_at(item_start + 1) == 45
        } else {
          let tmp = decode_ident_slice(clean, item_start, item_end_first, true, lut)
          tmp.length() >= 2 && tmp.code_unit_at(0) == 45 && tmp.code_unit_at(1) == 45
        }
        let allow_nested = cur_ctx == CTX_BODY
        if !lex.check_limit {
          let stop_kind = fast_scan_decl_value_span(lex, is_custom, max_paren, allow_nested)
          if stop_kind < 0 {
            return Err(
              CssError::new(
                CssErrorKind::LimitExceeded,
                lex.err_offset,
                1,
                1,
                "nesting depth limit exceeded",
              ),
            )
          }
          if stop_kind == 2 {
            // Nested qualified rule fallback (e.g. `a:hover { ... }`)
            let stop_off = lex.tok_start
            rule_count = rule_count + 1
            if rule_count > opts.max_rules {
              return Err(
                CssError::new(
                  CssErrorKind::LimitExceeded,
                  item_start,
                  1,
                  1,
                  "rule limit exceeded",
                ),
              )
            }
            if stack_len > opts.max_depth {
              return Err(
                CssError::new(
                  CssErrorKind::LimitExceeded,
                  stop_off,
                  1,
                  1,
                  "nesting depth limit exceeded",
                ),
              )
            }
            if semi_stack[top] {
              sb.write_byte((59).to_byte())
              semi_stack[top] = false
            }
            minify_prelude_into(sb, clean, item_start, stop_off, lut, false, sub_lex, sel_stack)
            sb.write_byte((123).to_byte())
            if stack_len < ctx_stack.length() {
              ctx_stack[stack_len] = CTX_BODY
              nested_stack[stack_len] = true
              semi_stack[stack_len] = false
            } else {
              ctx_stack.push(CTX_BODY)
              nested_stack.push(true)
              semi_stack.push(false)
            }
            stack_len = stack_len + 1
          } else {
            let flags = lex.tok_num_end
            if (flags & 1) != 0 {
              let val_start = lex.tok_start
              let val_end = lex.tok_end
              if semi_stack[top] {
                sb.write_byte((59).to_byte())
              }
              let allow_zero_collapse = if !name_has_esc {
                if is_custom {
                  write_span(sb, clean, item_start, item_end_first)
                  true
                } else {
                  write_span_lower(sb, clean, item_start, item_end_first)
                  !is_no_zero_collapse_prop_slice(clean, item_start, item_end_first)
                }
              } else {
                let prop_name = decode_prop_name(clean, item_start, item_end_first, true, is_custom, lut)
                sb.write_string(prop_name)
                prop_name != "flex" && prop_name != "line-height"
              }
              sb.write_byte((58).to_byte())
              if is_custom {
                if val_end > val_start {
                  write_span(sb, clean, val_start, val_end)
                } else if (flags & 4) != 0 {
                  sb.write_byte((32).to_byte())
                }
              } else if val_end > val_start {
                minify_decl_value_into_flag(sb, clean, val_start, val_end, allow_zero_collapse, lut, sub_lex, math_stack)
              }
              if (flags & 2) != 0 {
                sb.write_string("!important")
              }
              semi_stack[top] = true
            }
            if stop_kind == 3 {
              sb.write_byte((125).to_byte())
              stack_len = stack_len - 1
            }
          }
          continue
        }
        let prop_name = decode_prop_name(clean, item_start, item_end_first, name_has_esc, is_custom, lut)
        let (stop_kind, stop_off, decl_opt) = match stream_parse_decl_value(
          lex,
          prop_name,
          is_custom,
          0,
          max_paren,
          allow_nested,
        ) {
          Ok(r) => r
          Err(e) => return Err(e)
        }
        if stop_kind == 2 {
          rule_count = rule_count + 1
          if rule_count > opts.max_rules {
            return Err(
              CssError::new(
                CssErrorKind::LimitExceeded,
                item_start,
                1,
                1,
                "rule limit exceeded",
              ),
            )
          }
          if stack_len > opts.max_depth {
            return Err(
              CssError::new(
                CssErrorKind::LimitExceeded,
                stop_off,
                1,
                1,
                "nesting depth limit exceeded",
              ),
            )
          }
          if semi_stack[top] {
            sb.write_byte((59).to_byte())
            semi_stack[top] = false
          }
          minify_prelude_into(sb, clean, item_start, stop_off, lut, false, sub_lex, sel_stack)
          sb.write_byte((123).to_byte())
          if stack_len < ctx_stack.length() {
            ctx_stack[stack_len] = CTX_BODY
            nested_stack[stack_len] = true
            semi_stack[stack_len] = false
          } else {
            ctx_stack.push(CTX_BODY)
            nested_stack.push(true)
            semi_stack.push(false)
          }
          stack_len = stack_len + 1
        } else {
          match decl_opt {
            Some(decl) => {
              if semi_stack[top] {
                sb.write_byte((59).to_byte())
              }
              sb.write_string(decl.name)
              sb.write_byte((58).to_byte())
              if decl.is_custom {
                sb.write_string(decl.value)
              } else {
                let dlex = Lexer::new_slice(decl.value, 0, decl.value.length())
                minify_decl_value_into(sb, decl.value, 0, decl.value.length(), decl.name, lut, dlex, math_stack)
              }
              if decl.important {
                sb.write_string("!important")
              }
              semi_stack[top] = true
            }
            None => ()
          }
          if stop_kind == 3 {
            sb.write_byte((125).to_byte())
            stack_len = stack_len - 1
          }
        }
        continue
      }
      // Ident not followed by ':'
      let stop_kind = match scan_prelude_unified(
        lex,
        next_tk,
        lex.tok_start,
        lex.tok_end,
        true,
        true,
        max_paren,
      ) {
        Ok(k) => k
        Err(e) => return Err(e)
      }
      let item_end = lex.tok_end
      if stop_kind == 2 {
        if cur_ctx == CTX_BODY {
          rule_count = rule_count + 1
          if rule_count > opts.max_rules {
            return Err(
              CssError::new(
                CssErrorKind::LimitExceeded,
                item_start,
                1,
                1,
                "rule limit exceeded",
              ),
            )
          }
          if stack_len > opts.max_depth {
            return Err(
              CssError::new(
                CssErrorKind::LimitExceeded,
                lex.tok_start,
                1,
                1,
                "nesting depth limit exceeded",
              ),
            )
          }
          if semi_stack[top] {
            sb.write_byte((59).to_byte())
            semi_stack[top] = false
          }
          let end_pos = if item_end > item_start { item_end } else { item_end_first }
          minify_prelude_into(sb, clean, item_start, end_pos, lut, false, sub_lex, sel_stack)
          sb.write_byte((123).to_byte())
          if stack_len < ctx_stack.length() {
            ctx_stack[stack_len] = CTX_BODY
            nested_stack[stack_len] = true
            semi_stack[stack_len] = false
          } else {
            ctx_stack.push(CTX_BODY)
            nested_stack.push(true)
            semi_stack.push(false)
          }
          stack_len = stack_len + 1
        } else {
          match skip_balanced_curly(lex, max_paren) {
            Ok(()) => ()
            Err(e) => return Err(e)
          }
        }
      } else if stop_kind == 3 {
        sb.write_byte((125).to_byte())
        stack_len = stack_len - 1
      }
      continue
    }

    // Non-ident start inside CTX_BODY / CTX_DECL_LIST
    let stop_kind = match scan_prelude_unified(
      lex,
      tk,
      lex.tok_start,
      lex.tok_end,
      true,
      true,
      max_paren,
    ) {
      Ok(k) => k
      Err(e) => return Err(e)
    }
    let item_end = lex.tok_end
    if stop_kind == 2 {
      if cur_ctx == CTX_BODY {
        rule_count = rule_count + 1
        if rule_count > opts.max_rules {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              item_start,
              1,
              1,
              "rule limit exceeded",
            ),
          )
        }
        if stack_len > opts.max_depth {
          return Err(
            CssError::new(
              CssErrorKind::LimitExceeded,
              lex.tok_start,
              1,
              1,
              "nesting depth limit exceeded",
            ),
          )
        }
        if semi_stack[top] {
          sb.write_byte((59).to_byte())
          semi_stack[top] = false
        }
        if item_end > item_start {
          minify_prelude_into(sb, clean, item_start, item_end, lut, false, sub_lex, sel_stack)
        }
        sb.write_byte((123).to_byte())
        if stack_len < ctx_stack.length() {
          ctx_stack[stack_len] = CTX_BODY
          nested_stack[stack_len] = true
          semi_stack[stack_len] = false
        } else {
          ctx_stack.push(CTX_BODY)
          nested_stack.push(true)
          semi_stack.push(false)
        }
        stack_len = stack_len + 1
      } else {
        match skip_balanced_curly(lex, max_paren) {
          Ok(()) => ()
          Err(e) => return Err(e)
        }
      }
    } else if stop_kind == 3 {
      sb.write_byte((125).to_byte())
      stack_len = stack_len - 1
    }
  }

  // Close any unclosed blocks at EOF
  while stack_len > 1 {
    sb.write_byte((125).to_byte())
    stack_len = stack_len - 1
  }
  Ok(sb.to_string())
}
