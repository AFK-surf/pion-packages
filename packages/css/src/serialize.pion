///| CSS serializer (`to_css`) and minifier (`minify` / `minify_stylesheet`).

fn is_zero_collapsible_unit(unit : String) -> Bool {
  let u = ascii_lower(unit)
  u == "px" ||
  u == "em" ||
  u == "rem" ||
  u == "pt" ||
  u == "cm" ||
  u == "mm" ||
  u == "in" ||
  u == "pc" ||
  u == "ex" ||
  u == "ch" ||
  u == "vw" ||
  u == "vh" ||
  u == "vmin" ||
  u == "vmax"
}

fn is_math_func_name(name : String) -> Bool {
  let n = ascii_lower(name)
  n == "calc" || n == "min" || n == "max" || n == "clamp"
}

///| Compress a raw CSS hex token (without leading `#`), e.g. `ffffff` -> `fff`, `aabbccdd` -> `abcd`.
fn minify_hex_body(hex : String) -> String {
  let n = hex.length()
  let mut i = 0
  while i < n {
    if hex_val(hex.code_unit_at(i)) < 0 {
      return hex
    }
    i = i + 1
  }
  let low = ascii_lower(hex)
  if n == 6 {
    if low.code_unit_at(0) == low.code_unit_at(1) &&
    low.code_unit_at(2) == low.code_unit_at(3) &&
    low.code_unit_at(4) == low.code_unit_at(5) {
      let sb = StringBuilder::new()
      sb.write_byte(low.code_unit_at(0).to_byte())
      sb.write_byte(low.code_unit_at(2).to_byte())
      sb.write_byte(low.code_unit_at(4).to_byte())
      return sb.to_string()
    }
    return low
  }
  if n == 8 {
    let a0 = low.code_unit_at(6)
    let a1 = low.code_unit_at(7)
    // Opaque alpha `ff` -> drop alpha
    if a0 == 102 && a1 == 102 {
      return minify_hex_body(low.slice(0, 6))
    }
    if low.code_unit_at(0) == low.code_unit_at(1) &&
    low.code_unit_at(2) == low.code_unit_at(3) &&
    low.code_unit_at(4) == low.code_unit_at(5) &&
    a0 == a1 {
      let sb = StringBuilder::new()
      sb.write_byte(low.code_unit_at(0).to_byte())
      sb.write_byte(low.code_unit_at(2).to_byte())
      sb.write_byte(low.code_unit_at(4).to_byte())
      sb.write_byte(a0.to_byte())
      return sb.to_string()
    }
    return low
  }
  if n == 4 {
    if low.code_unit_at(3) == 102 {
      return low.slice(0, 3)
    }
    return low
  }
  low
}

///| Strip leading zero in `0.5` -> `.5` and `-0.5` -> `-.5` on a raw number string.
fn minify_raw_number(raw : String) -> String {
  let n = raw.length()
  if n >= 3 && raw.code_unit_at(0) == 48 && raw.code_unit_at(1) == 46 {
    return raw.slice(1, n)
  }
  if n >= 4 && raw.code_unit_at(0) == 45 && raw.code_unit_at(1) == 48 && raw.code_unit_at(2) == 46 {
    return "-" + raw.slice(2, n)
  }
  if n >= 4 && raw.code_unit_at(0) == 43 && raw.code_unit_at(1) == 48 && raw.code_unit_at(2) == 46 {
    return raw.slice(2, n)
  }
  if n >= 2 && raw.code_unit_at(0) == 43 {
    return raw.slice(1, n)
  }
  raw
}

///| Minify a selector/prelude string (remove whitespace around `,`, `>`, `+`, `~`, keep descendant spaces).
fn minify_prelude(prelude : String) -> String {
  let clean = preprocess_string(prelude)
  let tokens = match tokenize_preprocessed(clean, ParseOptions::default()) {
    Ok(t) => t
    Err(_) => return prelude
  }
  let n = tokens.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let tok = tokens[i]
    match tok.kind {
      TokenKind::Whitespace => {
        // Keep space only if neither previous nor next token is a combinator/comma/paren
        let prev_tight = if i > 0 {
          match tokens[i - 1].kind {
            TokenKind::Comma | TokenKind::LeftParen | TokenKind::LeftSquare | TokenKind::Function(_) => true
            TokenKind::Delim(d) => d == ">" || d == "+" || d == "~"
            _ => false
          }
        } else {
          true
        }
        let next_tight = if i + 1 < n {
          match tokens[i + 1].kind {
            TokenKind::Comma | TokenKind::RightParen | TokenKind::RightSquare => true
            TokenKind::Delim(d) => d == ">" || d == "+" || d == "~"
            _ => false
          }
        } else {
          true
        }
        if !prev_tight && !next_tight {
          sb.write_byte((32).to_byte())
        }
      }
      _ => sb.write_string(clean.slice(tok.start, tok.end))
    }
    i = i + 1
  }
  sb.to_string()
}

///| Minify a standard declaration value (never called on custom properties!).
fn minify_decl_value(value : String) -> String {
  let clean = preprocess_string(value)
  let tokens = match tokenize_preprocessed(clean, ParseOptions::default()) {
    Ok(t) => t
    Err(_) => return value
  }
  let n = tokens.length()
  let sb = StringBuilder::new()
  // Track function stack to know when inside calc()/min()/max()/clamp()
  let math_stack : Array[Bool] = []
  let mut math_depth = 0
  let mut i = 0

  while i < n {
    let tok = tokens[i]
    match tok.kind {
      TokenKind::Whitespace => {
        let prev_tight = if i > 0 {
          match tokens[i - 1].kind {
            TokenKind::Comma | TokenKind::LeftParen | TokenKind::Function(_) | TokenKind::Colon => true
            TokenKind::Delim(d) => d == "/" && math_depth == 0
            _ => false
          }
        } else {
          true
        }
        let next_tight = if i + 1 < n {
          match tokens[i + 1].kind {
            TokenKind::Comma | TokenKind::RightParen => true
            TokenKind::Delim(d) => d == "/" && math_depth == 0
            _ => false
          }
        } else {
          true
        }
        // Inside calc()/min()/max()/clamp(), ALWAYS preserve space around '+' and '-'
        let need_math_space = if math_depth > 0 {
          let prev_pm = if i > 0 {
            match tokens[i - 1].kind {
              TokenKind::Delim(d) => d == "+" || d == "-"
              _ => false
            }
          } else {
            false
          }
          let next_pm = if i + 1 < n {
            match tokens[i + 1].kind {
              TokenKind::Delim(d) => d == "+" || d == "-"
              _ => false
            }
          } else {
            false
          }
          prev_pm || next_pm
        } else {
          false
        }
        if need_math_space || (!prev_tight && !next_tight) {
          sb.write_byte((32).to_byte())
        }
      }
      TokenKind::Function(fname) => {
        let is_math = is_math_func_name(fname)
        math_stack.push(is_math)
        if is_math {
          math_depth = math_depth + 1
        }
        sb.write_string(clean.slice(tok.start, tok.end))
      }
      TokenKind::LeftParen => {
        math_stack.push(false)
        sb.write_byte((40).to_byte())
      }
      TokenKind::RightParen => {
        if math_stack.length() > 0 {
          let was_math = math_stack[math_stack.length() - 1]
          let _ = math_stack.pop()
          if was_math && math_depth > 0 {
            math_depth = math_depth - 1
          }
        }
        sb.write_byte((41).to_byte())
      }
      TokenKind::Hash(body, _) => {
        sb.write_byte((35).to_byte())
        sb.write_string(minify_hex_body(body))
      }
      TokenKind::Dimension(v, _, _, unit) => {
        if v == 0.0 && math_depth == 0 && is_zero_collapsible_unit(unit) {
          sb.write_byte((48).to_byte())
        } else {
          let raw = clean.slice(tok.start, tok.end)
          let num_len = raw.length() - unit.length()
          if num_len > 0 {
            sb.write_string(minify_raw_number(raw.slice(0, num_len)))
            sb.write_string(ascii_lower(unit))
          } else {
            sb.write_string(raw)
          }
        }
      }
      TokenKind::Number(_, _, _) => {
        sb.write_string(minify_raw_number(clean.slice(tok.start, tok.end)))
      }
      TokenKind::Percentage(_, _, _) => {
        let raw = clean.slice(tok.start, tok.end)
        if raw.length() > 1 {
          sb.write_string(minify_raw_number(raw.slice(0, raw.length() - 1)))
          sb.write_byte((37).to_byte())
        } else {
          sb.write_string(raw)
        }
      }
      _ => sb.write_string(clean.slice(tok.start, tok.end))
    }
    i = i + 1
  }
  sb.to_string()
}

fn write_indent(sb : StringBuilder, depth : Int) -> Unit {
  let mut k = 0
  while k < depth {
    sb.write_string("  ")
    k = k + 1
  }
}

enum SerOp {
  EmitRule(Rule, Int)
  CloseBlock(Int)
}

///| 100% iterative formatted CSS serializer.
pub fn to_css_internal(sheet : Stylesheet) -> String {
  let sb = StringBuilder::new()
  let ops : Array[SerOp] = []
  let mut idx = sheet.rules.length() - 1
  while idx >= 0 {
    ops.push(SerOp::EmitRule(sheet.rules[idx], 0))
    idx = idx - 1
  }

  let mut first = true
  while ops.length() > 0 {
    let op = ops[ops.length() - 1]
    let _ = ops.pop()
    match op {
      SerOp::CloseBlock(depth) => {
        write_indent(sb, depth)
        sb.write_string("}\n")
      }
      SerOp::EmitRule(rule, depth) => {
        if !first && depth == 0 {
          sb.write_byte((10).to_byte())
        }
        first = false
        match rule {
          Rule::Qualified(qr) => {
            write_indent(sb, depth)
            sb.write_string(qr.prelude)
            sb.write_string(" {\n")
            let mut d = 0
            while d < qr.declarations.length() {
              let decl = qr.declarations[d]
              write_indent(sb, depth + 1)
              sb.write_string(decl.name)
              if decl.is_custom {
                sb.write_byte((58).to_byte())
                sb.write_string(decl.value)
              } else {
                sb.write_string(": ")
                sb.write_string(decl.value)
              }
              if decl.important {
                sb.write_string(" !important")
              }
              sb.write_string(";\n")
              d = d + 1
            }
            ops.push(SerOp::CloseBlock(depth))
            let mut r = qr.nested_rules.length() - 1
            while r >= 0 {
              ops.push(SerOp::EmitRule(qr.nested_rules[r], depth + 1))
              r = r - 1
            }
          }
          Rule::At(ar) => {
            write_indent(sb, depth)
            sb.write_byte((64).to_byte())
            sb.write_string(ar.name)
            if ar.prelude.length() > 0 {
              sb.write_byte((32).to_byte())
              sb.write_string(ar.prelude)
            }
            if !ar.has_block {
              sb.write_string(";\n")
            } else {
              sb.write_string(" {\n")
              let mut d = 0
              while d < ar.declarations.length() {
                let decl = ar.declarations[d]
                write_indent(sb, depth + 1)
                sb.write_string(decl.name)
                if decl.is_custom {
                  sb.write_byte((58).to_byte())
                  sb.write_string(decl.value)
                } else {
                  sb.write_string(": ")
                  sb.write_string(decl.value)
                }
                if decl.important {
                  sb.write_string(" !important")
                }
                sb.write_string(";\n")
                d = d + 1
              }
              ops.push(SerOp::CloseBlock(depth))
              let mut r = ar.rules.length() - 1
              while r >= 0 {
                ops.push(SerOp::EmitRule(ar.rules[r], depth + 1))
                r = r - 1
              }
            }
          }
        }
      }
    }
  }
  sb.to_string()
}

///| 100% iterative CSS stylesheet minifier.
pub fn minify_stylesheet_internal(sheet : Stylesheet) -> String {
  let sb = StringBuilder::new()
  let ops : Array[SerOp] = []
  let mut idx = sheet.rules.length() - 1
  while idx >= 0 {
    ops.push(SerOp::EmitRule(sheet.rules[idx], 0))
    idx = idx - 1
  }

  while ops.length() > 0 {
    let op = ops[ops.length() - 1]
    let _ = ops.pop()
    match op {
      SerOp::CloseBlock(_) => sb.write_byte((125).to_byte())
      SerOp::EmitRule(rule, depth) => {
        match rule {
          Rule::Qualified(qr) => {
            sb.write_string(minify_prelude(qr.prelude))
            sb.write_byte((123).to_byte())
            let dlen = qr.declarations.length()
            let rlen = qr.nested_rules.length()
            let mut d = 0
            while d < dlen {
              let decl = qr.declarations[d]
              sb.write_string(decl.name)
              sb.write_byte((58).to_byte())
              if decl.is_custom {
                sb.write_string(decl.value)
              } else {
                sb.write_string(minify_decl_value(decl.value))
              }
              if decl.important {
                sb.write_string("!important")
              }
              if d + 1 < dlen || rlen > 0 {
                sb.write_byte((59).to_byte())
              }
              d = d + 1
            }
            ops.push(SerOp::CloseBlock(depth))
            let mut r = rlen - 1
            while r >= 0 {
              ops.push(SerOp::EmitRule(qr.nested_rules[r], depth + 1))
              r = r - 1
            }
          }
          Rule::At(ar) => {
            sb.write_byte((64).to_byte())
            sb.write_string(ar.name)
            if ar.prelude.length() > 0 {
              sb.write_byte((32).to_byte())
              sb.write_string(minify_prelude(ar.prelude))
            }
            if !ar.has_block {
              sb.write_byte((59).to_byte())
            } else {
              sb.write_byte((123).to_byte())
              let dlen = ar.declarations.length()
              let rlen = ar.rules.length()
              let mut d = 0
              while d < dlen {
                let decl = ar.declarations[d]
                sb.write_string(decl.name)
                sb.write_byte((58).to_byte())
                if decl.is_custom {
                  sb.write_string(decl.value)
                } else {
                  sb.write_string(minify_decl_value(decl.value))
                }
                if decl.important {
                  sb.write_string("!important")
                }
                if d + 1 < dlen || rlen > 0 {
                  sb.write_byte((59).to_byte())
                }
                d = d + 1
              }
              ops.push(SerOp::CloseBlock(depth))
              let mut r = rlen - 1
              while r >= 0 {
                ops.push(SerOp::EmitRule(ar.rules[r], depth + 1))
                r = r - 1
              }
            }
          }
        }
      }
    }
  }
  sb.to_string()
}

///| Parse and minify a CSS string in one call.
pub fn minify_internal(
  src : String,
  opts : ParseOptions,
) -> Result[String, CssError] {
  match parse_stylesheet_internal(src, opts) {
    Ok(sheet) => Ok(minify_stylesheet_internal(sheet))
    Err(e) => Err(e)
  }
}
