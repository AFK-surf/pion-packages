///| W3C CSS Syntax Level 3 tokenizer with 256-byte LUT and zero-copy fast paths.

// LUT bit flags for ASCII byte classification.
let CH_WS : Int = 1
let CH_DIGIT : Int = 2
let CH_HEX : Int = 4
let CH_IDENT_START : Int = 8
let CH_IDENT : Int = 16
let CH_NON_PRINTABLE : Int = 32

fn build_lut() -> FixedArray[Int] {
  let lut = FixedArray::make(256, 0)
  // Whitespace: \t (9), \n (10), \f (12), \r (13), ' ' (32)
  lut[9] = CH_WS
  lut[10] = CH_WS
  lut[12] = CH_WS
  lut[13] = CH_WS
  lut[32] = CH_WS

  // Digits 0-9
  let mut c = 48
  while c <= 57 {
    lut[c] = CH_DIGIT | CH_HEX | CH_IDENT
    c = c + 1
  }
  // Uppercase A-Z
  c = 65
  while c <= 90 {
    let mut f = CH_IDENT_START | CH_IDENT
    if c <= 70 {
      f = f | CH_HEX
    }
    lut[c] = f
    c = c + 1
  }
  // Lowercase a-z
  c = 97
  while c <= 122 {
    let mut f = CH_IDENT_START | CH_IDENT
    if c <= 102 {
      f = f | CH_HEX
    }
    lut[c] = f
    c = c + 1
  }
  // '_' (95) and '-' (45)
  lut[95] = CH_IDENT_START | CH_IDENT
  lut[45] = CH_IDENT

  // Non-printable code points per CSS Syntax 3 §4.2:
  // 0x00..0x08, 0x0B, 0x0E..0x1F, 0x7F
  c = 0
  while c <= 8 {
    lut[c] = lut[c] | CH_NON_PRINTABLE
    c = c + 1
  }
  lut[11] = lut[11] | CH_NON_PRINTABLE
  c = 14
  while c <= 31 {
    lut[c] = lut[c] | CH_NON_PRINTABLE
    c = c + 1
  }
  lut[127] = lut[127] | CH_NON_PRINTABLE

  // Non-ASCII bytes >= 0x80 are ident-start and ident
  c = 128
  while c < 256 {
    lut[c] = CH_IDENT_START | CH_IDENT
    c = c + 1
  }
  lut
}

fn hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

fn write_utf8_codepoint(sb : StringBuilder, cp : Int) -> Unit {
  let c = if cp <= 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    0xFFFD
  } else {
    cp
  }
  if c < 0x80 {
    sb.write_byte(c.to_byte())
  } else if c < 0x800 {
    sb.write_byte((0xC0 | (c >> 6)).to_byte())
    sb.write_byte((0x80 | (c & 0x3F)).to_byte())
  } else if c < 0x10000 {
    sb.write_byte((0xE0 | (c >> 12)).to_byte())
    sb.write_byte((0x80 | ((c >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (c & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (c >> 18)).to_byte())
    sb.write_byte((0x80 | ((c >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((c >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (c & 0x3F)).to_byte())
  }
}

///| Lowercase ASCII letters in a string.
pub fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b >= 65 && b <= 90 {
      sb.write_byte((b + 32).to_byte())
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///| ASCII case-insensitive equality check without allocation.
pub fn ascii_eq_ignore_case(a : String, b : String) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    let ca = a.code_unit_at(i)
    let cb = b.code_unit_at(i)
    let la = if ca >= 65 && ca <= 90 { ca + 32 } else { ca }
    let lb = if cb >= 65 && cb <= 90 { cb + 32 } else { cb }
    if la != lb {
      return false
    }
    i = i + 1
  }
  true
}

///| Preprocess a CSS string per CSS Syntax Level 3 §3.3:
///| \r\n, \r, \f -> \n; \0 -> U+FFFD. Fast-paths strings with none of these.
pub fn preprocess_string(src : String) -> String {
  let n = src.length()
  let mut needs = false
  let mut i = 0
  while i < n {
    let b = src.code_unit_at(i)
    if b == 13 || b == 12 || b == 0 {
      needs = true
      break
    }
    i = i + 1
  }
  if !needs {
    return src
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let b = src.code_unit_at(i)
    if b == 13 {
      sb.write_byte((10).to_byte())
      if i + 1 < n && src.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
    } else if b == 12 {
      sb.write_byte((10).to_byte())
      i = i + 1
    } else if b == 0 {
      write_utf8_codepoint(sb, 0xFFFD)
      i = i + 1
    } else {
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  sb.to_string()
}

///| Decode raw bytes to a preprocessed CSS string, replacing invalid UTF-8 and NUL with U+FFFD.
pub fn preprocess_bytes(src : Bytes) -> String {
  let n = src.length()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let b0 = src[i].to_int() & 0xFF
    if b0 < 0x80 {
      if b0 == 13 {
        sb.write_byte((10).to_byte())
        if i + 1 < n && (src[i + 1].to_int() & 0xFF) == 10 {
          i = i + 2
        } else {
          i = i + 1
        }
      } else if b0 == 12 {
        sb.write_byte((10).to_byte())
        i = i + 1
      } else if b0 == 0 {
        write_utf8_codepoint(sb, 0xFFFD)
        i = i + 1
      } else {
        sb.write_byte(b0.to_byte())
        i = i + 1
      }
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 < n {
        let b1 = src[i + 1].to_int() & 0xFF
        if (b1 & 0xC0) == 0x80 {
          sb.write_byte(b0.to_byte())
          sb.write_byte(b1.to_byte())
          i = i + 2
        } else {
          write_utf8_codepoint(sb, 0xFFFD)
          i = i + 1
        }
      } else {
        write_utf8_codepoint(sb, 0xFFFD)
        i = i + 1
      }
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 < n {
        let b1 = src[i + 1].to_int() & 0xFF
        let b2 = src[i + 2].to_int() & 0xFF
        let valid_b1 = if b0 == 0xE0 {
          b1 >= 0xA0 && b1 <= 0xBF
        } else if b0 == 0xED {
          b1 >= 0x80 && b1 <= 0x9F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if valid_b1 && (b2 & 0xC0) == 0x80 {
          sb.write_byte(b0.to_byte())
          sb.write_byte(b1.to_byte())
          sb.write_byte(b2.to_byte())
          i = i + 3
        } else {
          write_utf8_codepoint(sb, 0xFFFD)
          i = i + 1
        }
      } else {
        write_utf8_codepoint(sb, 0xFFFD)
        i = i + 1
      }
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 < n {
        let b1 = src[i + 1].to_int() & 0xFF
        let b2 = src[i + 2].to_int() & 0xFF
        let b3 = src[i + 3].to_int() & 0xFF
        let valid_b1 = if b0 == 0xF0 {
          b1 >= 0x90 && b1 <= 0xBF
        } else if b0 == 0xF4 {
          b1 >= 0x80 && b1 <= 0x8F
        } else {
          (b1 & 0xC0) == 0x80
        }
        if valid_b1 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
          sb.write_byte(b0.to_byte())
          sb.write_byte(b1.to_byte())
          sb.write_byte(b2.to_byte())
          sb.write_byte(b3.to_byte())
          i = i + 4
        } else {
          write_utf8_codepoint(sb, 0xFFFD)
          i = i + 1
        }
      } else {
        write_utf8_codepoint(sb, 0xFFFD)
        i = i + 1
      }
    } else {
      write_utf8_codepoint(sb, 0xFFFD)
      i = i + 1
    }
  }
  sb.to_string()
}

fn is_valid_escape_at(src : String, n : Int, pos : Int) -> Bool {
  if pos >= n || src.code_unit_at(pos) != 92 {
    return false
  }
  if pos + 1 >= n {
    return true
  }
  src.code_unit_at(pos + 1) != 10
}

fn would_start_ident_at(
  src : String,
  n : Int,
  pos : Int,
  lut : FixedArray[Int],
) -> Bool {
  if pos >= n {
    return false
  }
  let b0 = src.code_unit_at(pos)
  if (lut[b0] & CH_IDENT_START) != 0 {
    return true
  }
  if b0 == 45 {
    // '-'
    if pos + 1 >= n {
      return false
    }
    let b1 = src.code_unit_at(pos + 1)
    if (lut[b1] & CH_IDENT_START) != 0 || b1 == 45 {
      return true
    }
    return is_valid_escape_at(src, n, pos + 1)
  }
  if b0 == 92 {
    return is_valid_escape_at(src, n, pos)
  }
  false
}

fn would_start_number_at(
  src : String,
  n : Int,
  pos : Int,
  lut : FixedArray[Int],
) -> Bool {
  if pos >= n {
    return false
  }
  let b0 = src.code_unit_at(pos)
  if (lut[b0] & CH_DIGIT) != 0 {
    return true
  }
  if b0 == 43 || b0 == 45 {
    // '+' or '-'
    if pos + 1 >= n {
      return false
    }
    let b1 = src.code_unit_at(pos + 1)
    if (lut[b1] & CH_DIGIT) != 0 {
      return true
    }
    if b1 == 46 && pos + 2 < n {
      return (lut[src.code_unit_at(pos + 2)] & CH_DIGIT) != 0
    }
    return false
  }
  if b0 == 46 {
    // '.'
    return pos + 1 < n && (lut[src.code_unit_at(pos + 1)] & CH_DIGIT) != 0
  }
  false
}

///| Consume a CSS escape starting AFTER the leading backslash `\` at `pos`.
///| Returns the new byte position after the escape and writes the decoded UTF-8 to `sb`.
fn consume_escape_into(
  src : String,
  n : Int,
  pos : Int,
  sb : StringBuilder,
) -> Int {
  if pos >= n {
    write_utf8_codepoint(sb, 0xFFFD)
    return pos
  }
  let b0 = src.code_unit_at(pos)
  let h0 = hex_val(b0)
  if h0 >= 0 {
    let mut cp = h0
    let mut i = pos + 1
    let mut digits = 1
    while i < n && digits < 6 {
      let h = hex_val(src.code_unit_at(i))
      if h < 0 {
        break
      }
      cp = (cp << 4) | h
      i = i + 1
      digits = digits + 1
    }
    // Optional single trailing whitespace (' ', '\t', '\n')
    if i < n {
      let ws = src.code_unit_at(i)
      if ws == 32 || ws == 9 || ws == 10 {
        i = i + 1
      }
    }
    write_utf8_codepoint(sb, cp)
    return i
  }
  // Copy one UTF-8 character (non-newline)
  if b0 < 0x80 {
    sb.write_byte(b0.to_byte())
    return pos + 1
  }
  let char_len = if b0 < 0xE0 {
    2
  } else if b0 < 0xF0 {
    3
  } else {
    4
  }
  let end = if pos + char_len <= n { pos + char_len } else { n }
  let mut k = pos
  while k < end {
    sb.write_byte(src.code_unit_at(k).to_byte())
    k = k + 1
  }
  end
}

fn skip_escape(src : String, n : Int, pos : Int) -> Int {
  if pos >= n {
    return pos
  }
  let b0 = src.code_unit_at(pos)
  if hex_val(b0) >= 0 {
    let mut i = pos + 1
    let mut digits = 1
    while i < n && digits < 6 && hex_val(src.code_unit_at(i)) >= 0 {
      i = i + 1
      digits = digits + 1
    }
    if i < n {
      let ws = src.code_unit_at(i)
      if ws == 32 || ws == 9 || ws == 10 {
        i = i + 1
      }
    }
    return i
  }
  if b0 < 0x80 {
    return pos + 1
  }
  let char_len = if b0 < 0xE0 {
    2
  } else if b0 < 0xF0 {
    3
  } else {
    4
  }
  if pos + char_len <= n {
    pos + char_len
  } else {
    n
  }
}

///| Consume an ident sequence starting at `pos`.
///| Fast-paths zero-copy slice when no escapes are encountered.
fn consume_ident_seq(
  src : String,
  n : Int,
  pos : Int,
  lut : FixedArray[Int],
) -> (String, Int) {
  let mut i = pos
  while i < n {
    let b = src.code_unit_at(i)
    if (lut[b] & CH_IDENT) != 0 {
      i = i + 1
    } else if b == 92 && is_valid_escape_at(src, n, i) {
      // Slow path: has escapes
      let sb = StringBuilder::new()
      if i > pos {
        sb.write_string(src.slice(pos, i))
      }
      while i < n {
        let c = src.code_unit_at(i)
        if (lut[c] & CH_IDENT) != 0 {
          sb.write_byte(c.to_byte())
          i = i + 1
        } else if c == 92 && is_valid_escape_at(src, n, i) {
          i = consume_escape_into(src, n, i + 1, sb)
        } else {
          break
        }
      }
      return (sb.to_string(), i)
    } else {
      break
    }
  }
  (src.slice(pos, i), i)
}

fn skip_ident_seq(
  src : String,
  n : Int,
  pos : Int,
  lut : FixedArray[Int],
) -> Int {
  let mut i = pos
  while i < n {
    let b = src.code_unit_at(i)
    if (lut[b] & CH_IDENT) != 0 {
      i = i + 1
    } else if b == 92 && is_valid_escape_at(src, n, i) {
      i = skip_escape(src, n, i + 1)
    } else {
      break
    }
  }
  i
}

///| Parse a CSS number starting at `pos` (known `would_start_number_at`).
///| Returns `(value, is_int, has_sign, new_pos)`.
fn consume_number(
  src : String,
  n : Int,
  pos : Int,
  lut : FixedArray[Int],
) -> (Double, Bool, Bool, Int) {
  let mut i = pos
  let mut is_int = true
  let mut has_sign = false
  let mut neg = false
  if i < n {
    let b = src.code_unit_at(i)
    if b == 43 {
      has_sign = true
      i = i + 1
    } else if b == 45 {
      has_sign = true
      neg = true
      i = i + 1
    }
  }
  let mut int_part : Double = 0.0
  while i < n {
    let b = src.code_unit_at(i)
    if (lut[b] & CH_DIGIT) != 0 {
      int_part = int_part * 10.0 + (b - 48).to_double()
      i = i + 1
    } else {
      break
    }
  }
  let mut frac_part : Double = 0.0
  let mut frac_scale : Double = 1.0
  if i + 1 < n && src.code_unit_at(i) == 46 && (lut[src.code_unit_at(i + 1)] & CH_DIGIT) != 0 {
    is_int = false
    i = i + 1
    while i < n {
      let b = src.code_unit_at(i)
      if (lut[b] & CH_DIGIT) != 0 {
        frac_part = frac_part * 10.0 + (b - 48).to_double()
        frac_scale = frac_scale * 10.0
        i = i + 1
      } else {
        break
      }
    }
  }
  let mut value = int_part + frac_part / frac_scale
  // Optional exponent: ('e' | 'E') ['+' | '-'] DIGIT+
  if i < n && (src.code_unit_at(i) == 101 || src.code_unit_at(i) == 69) {
    let mut exp_pos = i + 1
    let mut exp_neg = false
    if exp_pos < n {
      let eb = src.code_unit_at(exp_pos)
      if eb == 43 {
        exp_pos = exp_pos + 1
      } else if eb == 45 {
        exp_neg = true
        exp_pos = exp_pos + 1
      }
    }
    if exp_pos < n && (lut[src.code_unit_at(exp_pos)] & CH_DIGIT) != 0 {
      is_int = false
      let mut exp_val = 0
      while exp_pos < n && (lut[src.code_unit_at(exp_pos)] & CH_DIGIT) != 0 {
        if exp_val < 10000 {
          exp_val = exp_val * 10 + (src.code_unit_at(exp_pos) - 48)
        }
        exp_pos = exp_pos + 1
      }
      let mut p = 1.0
      let mut base = 10.0
      let mut e = exp_val
      while e > 0 {
        if (e & 1) == 1 {
          p = p * base
        }
        base = base * base
        e = e >> 1
      }
      if exp_neg {
        value = value / p
      } else {
        value = value * p
      }
      i = exp_pos
    }
  }
  if neg {
    value = 0.0 - value
  }
  (value, is_int, has_sign, i)
}

fn skip_number(
  src : String,
  n : Int,
  pos : Int,
  lut : FixedArray[Int],
) -> Int {
  let mut i = pos
  if i < n && (src.code_unit_at(i) == 43 || src.code_unit_at(i) == 45) {
    i = i + 1
  }
  while i < n && (lut[src.code_unit_at(i)] & CH_DIGIT) != 0 {
    i = i + 1
  }
  if i + 1 < n && src.code_unit_at(i) == 46 && (lut[src.code_unit_at(i + 1)] & CH_DIGIT) != 0 {
    i = i + 1
    while i < n && (lut[src.code_unit_at(i)] & CH_DIGIT) != 0 {
      i = i + 1
    }
  }
  if i < n && (src.code_unit_at(i) == 101 || src.code_unit_at(i) == 69) {
    let mut exp_pos = i + 1
    if exp_pos < n && (src.code_unit_at(exp_pos) == 43 || src.code_unit_at(exp_pos) == 45) {
      exp_pos = exp_pos + 1
    }
    if exp_pos < n && (lut[src.code_unit_at(exp_pos)] & CH_DIGIT) != 0 {
      while exp_pos < n && (lut[src.code_unit_at(exp_pos)] & CH_DIGIT) != 0 {
        exp_pos = exp_pos + 1
      }
      i = exp_pos
    }
  }
  i
}

///| Consume a string token starting AFTER the opening quote `quote_byte` (`"` or `'`).
fn consume_string_token(
  src : String,
  n : Int,
  pos : Int,
  quote_byte : Int,
) -> (TokenKind, Int) {
  let mut i = pos
  while i < n {
    let b = src.code_unit_at(i)
    if b == quote_byte {
      return (TokenKind::Str(src.slice(pos, i)), i + 1)
    } else if b == 10 {
      // Unescaped newline -> BadString, do NOT consume newline
      return (TokenKind::BadString, i)
    } else if b == 92 {
      // Slow path: has escapes or line continuation
      let sb = StringBuilder::new()
      if i > pos {
        sb.write_string(src.slice(pos, i))
      }
      while i < n {
        let c = src.code_unit_at(i)
        if c == quote_byte {
          return (TokenKind::Str(sb.to_string()), i + 1)
        } else if c == 10 {
          return (TokenKind::BadString, i)
        } else if c == 92 {
          if i + 1 >= n {
            // Backslash at EOF in string -> ignored per CSS Syntax 3 §4.3.5
            return (TokenKind::Str(sb.to_string()), n)
          } else if src.code_unit_at(i + 1) == 10 {
            // Line continuation: consume \ and \n
            i = i + 2
          } else {
            i = consume_escape_into(src, n, i + 1, sb)
          }
        } else {
          sb.write_byte(c.to_byte())
          i = i + 1
        }
      }
      return (TokenKind::Str(sb.to_string()), n)
    } else {
      i = i + 1
    }
  }
  // EOF closes string cleanly
  (TokenKind::Str(src.slice(pos, n)), n)
}

fn skip_string_token(
  src : String,
  n : Int,
  pos : Int,
  quote_byte : Int,
) -> Int {
  let mut i = pos
  while i < n {
    let b = src.code_unit_at(i)
    if b == quote_byte {
      return i + 1
    } else if b == 10 {
      return i
    } else if b == 92 {
      if i + 1 >= n {
        return n
      } else if src.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = skip_escape(src, n, i + 1)
      }
    } else {
      i = i + 1
    }
  }
  n
}

fn consume_bad_url_remnants(src : String, n : Int, pos : Int) -> Int {
  let mut i = pos
  while i < n {
    let b = src.code_unit_at(i)
    if b == 41 {
      return i + 1
    } else if b == 92 && is_valid_escape_at(src, n, i) {
      i = skip_escape(src, n, i + 1)
    } else {
      i = i + 1
    }
  }
  n
}

///| Consume an unquoted url(...) starting AFTER `(` (at `pos`).
fn consume_url_token(
  src : String,
  n : Int,
  pos : Int,
  lut : FixedArray[Int],
) -> (TokenKind, Int) {
  let mut i = pos
  while i < n && (lut[src.code_unit_at(i)] & CH_WS) != 0 {
    i = i + 1
  }
  let sb = StringBuilder::new()
  while i < n {
    let b = src.code_unit_at(i)
    if b == 41 {
      // ')'
      return (TokenKind::Url(sb.to_string()), i + 1)
    } else if (lut[b] & CH_WS) != 0 {
      while i < n && (lut[src.code_unit_at(i)] & CH_WS) != 0 {
        i = i + 1
      }
      if i >= n {
        return (TokenKind::Url(sb.to_string()), n)
      }
      if src.code_unit_at(i) == 41 {
        return (TokenKind::Url(sb.to_string()), i + 1)
      }
      let end = consume_bad_url_remnants(src, n, i)
      return (TokenKind::BadUrl, end)
    } else if b == 34 || b == 39 || b == 40 || (lut[b] & CH_NON_PRINTABLE) != 0 {
      // '"', '\'', '(', or non-printable
      let end = consume_bad_url_remnants(src, n, i + 1)
      return (TokenKind::BadUrl, end)
    } else if b == 92 {
      if is_valid_escape_at(src, n, i) {
        i = consume_escape_into(src, n, i + 1, sb)
      } else {
        let end = consume_bad_url_remnants(src, n, i + 1)
        return (TokenKind::BadUrl, end)
      }
    } else {
      sb.write_byte(b.to_byte())
      i = i + 1
    }
  }
  (TokenKind::Url(sb.to_string()), n)
}

fn skip_url_token(
  src : String,
  n : Int,
  pos : Int,
  lut : FixedArray[Int],
) -> Int {
  let mut i = pos
  while i < n && (lut[src.code_unit_at(i)] & CH_WS) != 0 {
    i = i + 1
  }
  while i < n {
    let b = src.code_unit_at(i)
    if b == 41 {
      return i + 1
    } else if (lut[b] & CH_WS) != 0 {
      while i < n && (lut[src.code_unit_at(i)] & CH_WS) != 0 {
        i = i + 1
      }
      if i >= n {
        return n
      }
      if src.code_unit_at(i) == 41 {
        return i + 1
      }
      return consume_bad_url_remnants(src, n, i)
    } else if b == 34 || b == 39 || b == 40 || (lut[b] & CH_NON_PRINTABLE) != 0 {
      return consume_bad_url_remnants(src, n, i + 1)
    } else if b == 92 {
      if is_valid_escape_at(src, n, i) {
        i = skip_escape(src, n, i + 1)
      } else {
        return consume_bad_url_remnants(src, n, i + 1)
      }
    } else {
      i = i + 1
    }
  }
  n
}

fn try_consume_unicode_range(
  src : String,
  n : Int,
  pos : Int,
) -> Option[(Int, Int, Int)] {
  // pos is at 'U' or 'u', pos+1 is '+', pos+2 is hex or '?'
  if pos + 2 >= n {
    return None
  }
  let b0 = src.code_unit_at(pos)
  if (b0 != 85 && b0 != 117) || src.code_unit_at(pos + 1) != 43 {
    return None
  }
  let b2 = src.code_unit_at(pos + 2)
  if hex_val(b2) < 0 && b2 != 63 {
    return None
  }
  let mut i = pos + 2
  let mut digits = 0
  let mut start_cp = 0
  let mut end_cp = 0
  let mut has_q = false
  while i < n && digits < 6 {
    let c = src.code_unit_at(i)
    let hv = hex_val(c)
    if hv >= 0 && !has_q {
      start_cp = (start_cp << 4) | hv
      end_cp = (end_cp << 4) | hv
      i = i + 1
      digits = digits + 1
    } else if c == 63 {
      // '?'
      has_q = true
      start_cp = start_cp << 4
      end_cp = (end_cp << 4) | 0xF
      i = i + 1
      digits = digits + 1
    } else {
      break
    }
  }
  if has_q {
    return Some((start_cp, end_cp, i))
  }
  // Optional -HEX{1,6}
  if i + 1 < n && src.code_unit_at(i) == 45 && hex_val(src.code_unit_at(i + 1)) >= 0 {
    i = i + 1
    let mut e_cp = 0
    let mut e_digits = 0
    while i < n && e_digits < 6 {
      let hv = hex_val(src.code_unit_at(i))
      if hv < 0 {
        break
      }
      e_cp = (e_cp << 4) | hv
      i = i + 1
      e_digits = e_digits + 1
    }
    return Some((start_cp, e_cp, i))
  }
  Some((start_cp, start_cp, i))
}

///| Tokenize a preprocessed CSS string into `Array[Token]` enforcing `opts.max_tokens`.
pub fn tokenize_preprocessed(
  src : String,
  opts : ParseOptions,
) -> Result[Array[Token], CssError] {
  let lut = build_lut()
  let n = src.length()
  let tokens : Array[Token] = []
  let max_tok = opts.max_tokens
  let mut i = 0
  let mut line = 1
  let mut line_start = 0

  while i < n {
    let b = src.code_unit_at(i)

    // Comments /* ... */
    if b == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
      i = i + 2
      while i < n {
        let cb = src.code_unit_at(i)
        if cb == 10 {
          line = line + 1
          line_start = i + 1
          i = i + 1
        } else if cb == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
          i = i + 2
          break
        } else {
          i = i + 1
        }
      }
      continue
    }

    if tokens.length() >= max_tok {
      return Err(
        CssError::new(
          CssErrorKind::LimitExceeded,
          i,
          line,
          i - line_start + 1,
          "token limit exceeded",
        ),
      )
    }

    let start = i

    // Whitespace
    if (lut[b] & CH_WS) != 0 {
      while i < n && (lut[src.code_unit_at(i)] & CH_WS) != 0 {
        if src.code_unit_at(i) == 10 {
          line = line + 1
          line_start = i + 1
        }
        i = i + 1
      }
      tokens.push(Token::new(TokenKind::Whitespace, start, i))
      continue
    }

    // String: '"' (34) or '\'' (39)
    if b == 34 || b == 39 {
      let (kind, next_i) = consume_string_token(src, n, i + 1, b)
      i = next_i
      tokens.push(Token::new(kind, start, i))
      continue
    }

    // Hash: '#' (35)
    if b == 35 {
      if i + 1 < n && ((lut[src.code_unit_at(i + 1)] & CH_IDENT) != 0 || is_valid_escape_at(src, n, i + 1)) {
        let hk = if would_start_ident_at(src, n, i + 1, lut) {
          HashKind::Id
        } else {
          HashKind::Unrestricted
        }
        let (name, next_i) = consume_ident_seq(src, n, i + 1, lut)
        i = next_i
        tokens.push(Token::new(TokenKind::Hash(name, hk), start, i))
      } else {
        i = i + 1
        tokens.push(Token::new(TokenKind::Delim("#"), start, i))
      }
      continue
    }

    // Single-character structural tokens
    if b == 40 {
      i = i + 1
      tokens.push(Token::new(TokenKind::LeftParen, start, i))
      continue
    }
    if b == 41 {
      i = i + 1
      tokens.push(Token::new(TokenKind::RightParen, start, i))
      continue
    }
    if b == 44 {
      i = i + 1
      tokens.push(Token::new(TokenKind::Comma, start, i))
      continue
    }
    if b == 58 {
      i = i + 1
      tokens.push(Token::new(TokenKind::Colon, start, i))
      continue
    }
    if b == 59 {
      i = i + 1
      tokens.push(Token::new(TokenKind::Semicolon, start, i))
      continue
    }
    if b == 91 {
      i = i + 1
      tokens.push(Token::new(TokenKind::LeftSquare, start, i))
      continue
    }
    if b == 93 {
      i = i + 1
      tokens.push(Token::new(TokenKind::RightSquare, start, i))
      continue
    }
    if b == 123 {
      i = i + 1
      tokens.push(Token::new(TokenKind::LeftCurly, start, i))
      continue
    }
    if b == 125 {
      i = i + 1
      tokens.push(Token::new(TokenKind::RightCurly, start, i))
      continue
    }

    // '+' (43), '.' (46), or digit -> possible numeric token
    if b == 43 || b == 46 || (lut[b] & CH_DIGIT) != 0 {
      if would_start_number_at(src, n, i, lut) {
        let (val_f, is_int, has_sign, num_end) = consume_number(src, n, i, lut)
        i = num_end
        if would_start_ident_at(src, n, i, lut) {
          let (unit, unit_end) = consume_ident_seq(src, n, i, lut)
          i = unit_end
          tokens.push(
            Token::new(TokenKind::Dimension(val_f, is_int, has_sign, unit), start, i),
          )
        } else if i < n && src.code_unit_at(i) == 37 {
          i = i + 1
          tokens.push(Token::new(TokenKind::Percentage(val_f, is_int, has_sign), start, i))
        } else {
          tokens.push(Token::new(TokenKind::Number(val_f, is_int, has_sign), start, i))
        }
        continue
      }
      i = i + 1
      tokens.push(Token::new(TokenKind::Delim(src.slice(start, i)), start, i))
      continue
    }

    // '-' (45): number, CDC ('-->'), ident/function, or delim
    if b == 45 {
      if would_start_number_at(src, n, i, lut) {
        let (val_f, is_int, has_sign, num_end) = consume_number(src, n, i, lut)
        i = num_end
        if would_start_ident_at(src, n, i, lut) {
          let (unit, unit_end) = consume_ident_seq(src, n, i, lut)
          i = unit_end
          tokens.push(
            Token::new(TokenKind::Dimension(val_f, is_int, has_sign, unit), start, i),
          )
        } else if i < n && src.code_unit_at(i) == 37 {
          i = i + 1
          tokens.push(Token::new(TokenKind::Percentage(val_f, is_int, has_sign), start, i))
        } else {
          tokens.push(Token::new(TokenKind::Number(val_f, is_int, has_sign), start, i))
        }
        continue
      }
      if i + 2 < n && src.code_unit_at(i + 1) == 45 && src.code_unit_at(i + 2) == 62 {
        i = i + 3
        tokens.push(Token::new(TokenKind::Cdc, start, i))
        continue
      }
      if would_start_ident_at(src, n, i, lut) {
        let (ident, next_i) = consume_ident_seq(src, n, i, lut)
        i = next_i
        if i < n && src.code_unit_at(i) == 40 {
          i = i + 1
          tokens.push(Token::new(TokenKind::Function(ident), start, i))
        } else {
          tokens.push(Token::new(TokenKind::Ident(ident), start, i))
        }
        continue
      }
      i = i + 1
      tokens.push(Token::new(TokenKind::Delim("-"), start, i))
      continue
    }

    // '<' (60): CDO ('<!--') or delim
    if b == 60 {
      if i + 3 < n && src.code_unit_at(i + 1) == 33 && src.code_unit_at(i + 2) == 45 && src.code_unit_at(i + 3) == 45 {
        i = i + 4
        tokens.push(Token::new(TokenKind::Cdo, start, i))
      } else {
        i = i + 1
        tokens.push(Token::new(TokenKind::Delim("<"), start, i))
      }
      continue
    }

    // '@' (64): AtKeyword or delim
    if b == 64 {
      if would_start_ident_at(src, n, i + 1, lut) {
        let (name, next_i) = consume_ident_seq(src, n, i + 1, lut)
        i = next_i
        tokens.push(Token::new(TokenKind::AtKeyword(name), start, i))
      } else {
        i = i + 1
        tokens.push(Token::new(TokenKind::Delim("@"), start, i))
      }
      continue
    }

    // UnicodeRange: U+... / u+...
    if b == 85 || b == 117 {
      match try_consume_unicode_range(src, n, i) {
        Some((s_cp, e_cp, next_i)) => {
          i = next_i
          tokens.push(Token::new(TokenKind::UnicodeRange(s_cp, e_cp), start, i))
          continue
        }
        None => ()
      }
    }

    // Ident-like: ident, function, or unquoted url(...)
    if (lut[b] & CH_IDENT_START) != 0 || (b == 92 && is_valid_escape_at(src, n, i)) {
      let (ident, next_i) = consume_ident_seq(src, n, i, lut)
      i = next_i
      if i < n && src.code_unit_at(i) == 40 {
        i = i + 1
        if ascii_eq_ignore_case(ident, "url") {
          // Peek past whitespace to see if next char is '"' or '\''
          let mut p = i
          while p < n && (lut[src.code_unit_at(p)] & CH_WS) != 0 {
            p = p + 1
          }
          if p < n && (src.code_unit_at(p) == 34 || src.code_unit_at(p) == 39) {
            tokens.push(Token::new(TokenKind::Function(ident), start, i))
          } else {
            let (ukind, url_end) = consume_url_token(src, n, i, lut)
            i = url_end
            tokens.push(Token::new(ukind, start, i))
          }
        } else {
          tokens.push(Token::new(TokenKind::Function(ident), start, i))
        }
      } else {
        tokens.push(Token::new(TokenKind::Ident(ident), start, i))
      }
      continue
    }

    // Fallback: single-code-point Delim
    let char_len = if b < 0x80 {
      1
    } else if b < 0xE0 {
      2
    } else if b < 0xF0 {
      3
    } else {
      4
    }
    let end = if i + char_len <= n { i + char_len } else { n }
    i = end
    tokens.push(Token::new(TokenKind::Delim(src.slice(start, i)), start, i))
  }

  Ok(tokens)
}

///| Fast zero-allocation token counter (matches `tokenize(src).length()`).
pub fn count_tokens_internal(src : String) -> Result[Int, CssError] {
  let clean = preprocess_string(src)
  let lut = build_lut()
  let n = clean.length()
  let mut i = 0
  let mut count = 0

  while i < n {
    let b = clean.code_unit_at(i)

    // Comments /* ... */
    if b == 47 && i + 1 < n && clean.code_unit_at(i + 1) == 42 {
      i = i + 2
      while i < n {
        if clean.code_unit_at(i) == 42 && i + 1 < n && clean.code_unit_at(i + 1) == 47 {
          i = i + 2
          break
        }
        i = i + 1
      }
      continue
    }

    count = count + 1

    if (lut[b] & CH_WS) != 0 {
      i = i + 1
      while i < n && (lut[clean.code_unit_at(i)] & CH_WS) != 0 {
        i = i + 1
      }
      continue
    }

    if b == 34 || b == 39 {
      i = skip_string_token(clean, n, i + 1, b)
      continue
    }

    if b == 35 {
      if i + 1 < n && ((lut[clean.code_unit_at(i + 1)] & CH_IDENT) != 0 || is_valid_escape_at(clean, n, i + 1)) {
        i = skip_ident_seq(clean, n, i + 1, lut)
      } else {
        i = i + 1
      }
      continue
    }

    if b == 40 || b == 41 || b == 44 || b == 58 || b == 59 || b == 91 || b == 93 || b == 123 || b == 125 {
      i = i + 1
      continue
    }

    if b == 43 || b == 46 || (lut[b] & CH_DIGIT) != 0 {
      if would_start_number_at(clean, n, i, lut) {
        i = skip_number(clean, n, i, lut)
        if would_start_ident_at(clean, n, i, lut) {
          i = skip_ident_seq(clean, n, i, lut)
        } else if i < n && clean.code_unit_at(i) == 37 {
          i = i + 1
        }
      } else {
        i = i + 1
      }
      continue
    }

    if b == 45 {
      if would_start_number_at(clean, n, i, lut) {
        i = skip_number(clean, n, i, lut)
        if would_start_ident_at(clean, n, i, lut) {
          i = skip_ident_seq(clean, n, i, lut)
        } else if i < n && clean.code_unit_at(i) == 37 {
          i = i + 1
        }
      } else if i + 2 < n && clean.code_unit_at(i + 1) == 45 && clean.code_unit_at(i + 2) == 62 {
        i = i + 3
      } else if would_start_ident_at(clean, n, i, lut) {
        i = skip_ident_seq(clean, n, i, lut)
        if i < n && clean.code_unit_at(i) == 40 {
          i = i + 1
        }
      } else {
        i = i + 1
      }
      continue
    }

    if b == 60 {
      if i + 3 < n && clean.code_unit_at(i + 1) == 33 && clean.code_unit_at(i + 2) == 45 && clean.code_unit_at(i + 3) == 45 {
        i = i + 4
      } else {
        i = i + 1
      }
      continue
    }

    if b == 64 {
      if would_start_ident_at(clean, n, i + 1, lut) {
        i = skip_ident_seq(clean, n, i + 1, lut)
      } else {
        i = i + 1
      }
      continue
    }

    if b == 85 || b == 117 {
      match try_consume_unicode_range(clean, n, i) {
        Some((_, _, next_i)) => {
          i = next_i
          continue
        }
        None => ()
      }
    }

    if (lut[b] & CH_IDENT_START) != 0 || (b == 92 && is_valid_escape_at(clean, n, i)) {
      let start_id = i
      let end_id = skip_ident_seq(clean, n, i, lut)
      i = end_id
      if i < n && clean.code_unit_at(i) == 40 {
        i = i + 1
        // Check if ident is "url" (fast ASCII check for 3 chars or escaped)
        let is_url = if end_id - start_id == 3 {
          let c0 = clean.code_unit_at(start_id) | 32
          let c1 = clean.code_unit_at(start_id + 1) | 32
          let c2 = clean.code_unit_at(start_id + 2) | 32
          c0 == 117 && c1 == 114 && c2 == 108
        } else {
          let (id_str, _) = consume_ident_seq(clean, n, start_id, lut)
          ascii_eq_ignore_case(id_str, "url")
        }
        if is_url {
          let mut p = i
          while p < n && (lut[clean.code_unit_at(p)] & CH_WS) != 0 {
            p = p + 1
          }
          if !(p < n && (clean.code_unit_at(p) == 34 || clean.code_unit_at(p) == 39)) {
            i = skip_url_token(clean, n, i, lut)
          }
        }
      }
      continue
    }

    let char_len = if b < 0x80 {
      1
    } else if b < 0xE0 {
      2
    } else if b < 0xF0 {
      3
    } else {
      4
    }
    i = if i + char_len <= n { i + char_len } else { n }
  }

  Ok(count)
}
