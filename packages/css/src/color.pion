///| CSS Color Level 4 parser & serializer
///| Supports hex, rgb/rgba, hsl/hsla, hwb, lab, lch, oklab, oklch, color(), `none`, 148 named colors, transparent, currentcolor.

fn color_err(msg : String) -> CssError {
  CssError::new(CssErrorKind::InvalidColor, 0, 1, 1, msg)
}

fn clamp_u8(v : Double) -> Int {
  let rounded = if v >= 0.0 {
    (v + 0.5).to_int()
  } else {
    (v - 0.5).to_int()
  }
  if rounded < 0 {
    0
  } else if rounded > 255 {
    255
  } else {
    rounded
  }
}

fn clamp_unit(v : Double) -> Double {
  if v < 0.0 {
    0.0
  } else if v > 1.0 {
    1.0
  } else {
    v
  }
}

fn hex_digit_char(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (87 + n).to_byte()
  }
}

fn write_hex_byte(sb : StringBuilder, v : Int) -> Unit {
  let c = if v < 0 { 0 } else if v > 255 { 255 } else { v }
  sb.write_byte(hex_digit_char((c >> 4) & 0xF))
  sb.write_byte(hex_digit_char(c & 0xF))
}

fn is_none_tok(tok : Token) -> Bool {
  match tok.kind {
    TokenKind::Ident(w) => ascii_eq_ignore_case(w, "none")
    _ => false
  }
}

fn parse_hex_color(hex : String) -> Result[Color, CssError] {
  let n = hex.length()
  if n != 3 && n != 4 && n != 6 && n != 8 {
    return Err(color_err("invalid hex color length"))
  }
  let mut i = 0
  while i < n {
    if hex_val(hex.code_unit_at(i)) < 0 {
      return Err(color_err("invalid hex digit"))
    }
    i = i + 1
  }
  if n == 3 {
    let r = hex_val(hex.code_unit_at(0)) * 17
    let g = hex_val(hex.code_unit_at(1)) * 17
    let b = hex_val(hex.code_unit_at(2)) * 17
    return Ok(Color::rgb(r, g, b))
  }
  if n == 4 {
    let r = hex_val(hex.code_unit_at(0)) * 17
    let g = hex_val(hex.code_unit_at(1)) * 17
    let b = hex_val(hex.code_unit_at(2)) * 17
    let a = (hex_val(hex.code_unit_at(3)) * 17).to_double() / 255.0
    return Ok(Color::rgba(r, g, b, a))
  }
  let r = (hex_val(hex.code_unit_at(0)) << 4) | hex_val(hex.code_unit_at(1))
  let g = (hex_val(hex.code_unit_at(2)) << 4) | hex_val(hex.code_unit_at(3))
  let b = (hex_val(hex.code_unit_at(4)) << 4) | hex_val(hex.code_unit_at(5))
  if n == 6 {
    return Ok(Color::rgb(r, g, b))
  }
  let a_byte = (hex_val(hex.code_unit_at(6)) << 4) | hex_val(hex.code_unit_at(7))
  Ok(Color::rgba(r, g, b, a_byte.to_double() / 255.0))
}

///| Parse an RGB channel returning `(value_0_255, is_pct)`.
fn parse_rgb_channel_ex(tok : Token, allow_none : Bool) -> Option[(Int, Bool)] {
  if allow_none && is_none_tok(tok) {
    return Some((0, false))
  }
  match tok.kind {
    TokenKind::Number(v, _, _) => Some((clamp_u8(v), false))
    TokenKind::Percentage(p, _, _) => Some((clamp_u8(p * 255.0 / 100.0), true))
    _ => None
  }
}

fn parse_alpha_token(tok : Token, allow_none : Bool) -> Option[Double] {
  if allow_none && is_none_tok(tok) {
    return Some(0.0)
  }
  match tok.kind {
    TokenKind::Number(v, _, _) => Some(clamp_unit(v))
    TokenKind::Percentage(p, _, _) => Some(clamp_unit(p / 100.0))
    _ => None
  }
}

fn parse_hue_degrees(tok : Token, allow_none : Bool) -> Option[Double] {
  if allow_none && is_none_tok(tok) {
    return Some(0.0)
  }
  match tok.kind {
    TokenKind::Number(v, _, _) => Some(v)
    TokenKind::Dimension(v, _, _, unit) => {
      let u = ascii_lower(unit)
      if u == "deg" {
        Some(v)
      } else if u == "turn" {
        Some(v * 360.0)
      } else if u == "grad" {
        Some(v * 0.9)
      } else if u == "rad" {
        Some(v * 180.0 / 3.14159265358979323846)
      } else {
        None
      }
    }
    _ => None
  }
}

fn parse_percent_or_num_100(tok : Token, require_pct : Bool, allow_none : Bool) -> Option[Double] {
  if allow_none && is_none_tok(tok) {
    return Some(0.0)
  }
  match tok.kind {
    TokenKind::Percentage(p, _, _) => Some(p / 100.0)
    TokenKind::Number(v, _, _) =>
    if require_pct {
      None
    } else {
      Some(v / 100.0)
    }
    _ => None
  }
}

fn parse_num_or_pct(tok : Token, pct_scale : Double) -> Option[Double] {
  if is_none_tok(tok) {
    return Some(0.0)
  }
  match tok.kind {
    TokenKind::Number(v, _, _) => Some(v)
    TokenKind::Percentage(p, _, _) => Some(p * pct_scale / 100.0)
    _ => None
  }
}

// Pure Double trig/pow helpers for CSS Color 4 space conversions (zero external deps, identical on native & wasm32)
fn pi() -> Double {
  3.14159265358979323846
}

fn cos_rad(x_in : Double) -> Double {
  let two_pi = 2.0 * pi()
  let mut x = x_in % two_pi
  if x > pi() {
    x = x - two_pi
  } else if x < -pi() {
    x = x + two_pi
  }
  let x2 = x * x
  let mut term = 1.0
  let mut sum = 1.0
  let mut k = 1
  while k <= 10 {
    term = -term * x2 / ((2 * k - 1).to_double() * (2 * k).to_double())
    sum = sum + term
    k = k + 1
  }
  sum
}

fn sin_rad(x_in : Double) -> Double {
  cos_rad(x_in - pi() / 2.0)
}

///| Approximate `x^(1/2.4)` for sRGB transfer function (x in [0, 1]) via Newton's method on `y^12 = x^5`.
fn srgb_gamma_encode(c : Double) -> Double {
  let x = clamp_unit(c)
  if x <= 0.0031308 {
    return 12.92 * x
  }
  // Compute x^(5/12) = (x^5)^(1/12) via Newton iteration
  let x5 = x * x * x * x * x
  let mut y = 0.5
  let mut k = 0
  while k < 16 {
    let y2 = y * y
    let y4 = y2 * y2
    let y8 = y4 * y4
    let y11 = y8 * y2 * y
    if y11 == 0.0 {
      break
    }
    y = (11.0 * y + x5 / y11) / 12.0
    k = k + 1
  }
  1.055 * y - 0.055
}

fn linear_srgb_to_color(lr : Double, lg : Double, lb : Double, alpha : Double) -> Color {
  let r = clamp_u8(srgb_gamma_encode(lr) * 255.0)
  let g = clamp_u8(srgb_gamma_encode(lg) * 255.0)
  let b = clamp_u8(srgb_gamma_encode(lb) * 255.0)
  Color::rgba(r, g, b, alpha)
}

fn hsl_channel(n : Double, h : Double, s : Double, l : Double) -> Double {
  let k = (n + h / 30.0) % 12.0
  let a = s * (if l < 1.0 - l { l } else { 1.0 - l })
  let m1 = if k - 3.0 < 9.0 - k { k - 3.0 } else { 9.0 - k }
  let m2 = if m1 < 1.0 { m1 } else { 1.0 }
  let m3 = if m2 > -1.0 { m2 } else { -1.0 }
  l - a * m3
}

fn hsl_to_rgb(h_deg : Double, s_in : Double, l_in : Double, alpha : Double) -> Color {
  let s = clamp_unit(s_in)
  let l = clamp_unit(l_in)
  let mut h = h_deg % 360.0
  if h < 0.0 {
    h = h + 360.0
  }
  let r = clamp_u8(hsl_channel(0.0, h, s, l) * 255.0)
  let g = clamp_u8(hsl_channel(8.0, h, s, l) * 255.0)
  let b = clamp_u8(hsl_channel(4.0, h, s, l) * 255.0)
  Color::rgba(r, g, b, alpha)
}

fn hwb_to_rgb(h_deg : Double, w_in : Double, b_in : Double, alpha : Double) -> Color {
  let w = clamp_unit(w_in)
  let bl = clamp_unit(b_in)
  if w + bl >= 1.0 {
    let gray = clamp_u8((w / (w + bl)) * 255.0)
    return Color::rgba(gray, gray, gray, alpha)
  }
  let mut h = h_deg % 360.0
  if h < 0.0 {
    h = h + 360.0
  }
  let scale = 1.0 - w - bl
  let r = clamp_u8((hsl_channel(0.0, h, 1.0, 0.5) * scale + w) * 255.0)
  let g = clamp_u8((hsl_channel(8.0, h, 1.0, 0.5) * scale + w) * 255.0)
  let b = clamp_u8((hsl_channel(4.0, h, 1.0, 0.5) * scale + w) * 255.0)
  Color::rgba(r, g, b, alpha)
}

fn lab_to_rgb(l : Double, a : Double, b : Double, alpha : Double) -> Color {
  let fy = (l + 16.0) / 116.0
  let fx = a / 500.0 + fy
  let fz = fy - b / 200.0
  let eps = 216.0 / 24389.0
  let kappa = 24389.0 / 27.0
  let fx3 = fx * fx * fx
  let fz3 = fz * fz * fz
  let xr = if fx3 > eps { fx3 } else { (116.0 * fx - 16.0) / kappa }
  let yr = if l > kappa * eps { fy * fy * fy } else { l / kappa }
  let zr = if fz3 > eps { fz3 } else { (116.0 * fz - 16.0) / kappa }
  // D50 reference white
  let x50 = xr * 0.9642956764295677
  let y50 = yr * 1.0
  let z50 = zr * 0.8251046025104602
  // Bradford D50 -> D65
  let x65 = 0.9554734527042182 * x50 - 0.023098536874261423 * y50 + 0.0632593086610217 * z50
  let y65 = -0.028369706963208136 * x50 + 1.0099954580058226 * y50 + 0.021041398966943008 * z50
  let z65 = 0.012314001688319899 * x50 - 0.020507696433477912 * y50 + 1.3303659366080753 * z50
  // XYZ D65 -> linear sRGB
  let lr = 3.2409699419045226 * x65 - 1.537383177570094 * y65 - 0.4986107602930034 * z65
  let lg = -0.9692436362808796 * x65 + 1.8759675015077202 * y65 + 0.04155505740717559 * z65
  let lb = 0.05563007969699366 * x65 - 0.20397695888897652 * y65 + 1.0569715142428786 * z65
  linear_srgb_to_color(lr, lg, lb, alpha)
}

fn oklab_to_rgb(l : Double, a : Double, b : Double, alpha : Double) -> Color {
  let l_ = l + 0.3963377774 * a + 0.2158037573 * b
  let m_ = l - 0.1055613458 * a - 0.0638541728 * b
  let s_ = l - 0.0894841775 * a - 1.2914855480 * b
  let l3 = l_ * l_ * l_
  let m3 = m_ * m_ * m_
  let s3 = s_ * s_ * s_
  let lr = 4.0767416621 * l3 - 3.3077115913 * m3 + 0.2309699292 * s3
  let lg = -1.2684380046 * l3 + 2.6097574011 * m3 - 0.3413193965 * s3
  let lb = -0.0041960863 * l3 - 0.7034186147 * m3 + 1.7076147010 * s3
  linear_srgb_to_color(lr, lg, lb, alpha)
}

fn strip_ws_tokens(tokens : Array[Token], lo : Int, hi : Int) -> Array[Token] {
  let out : Array[Token] = []
  let mut i = lo
  while i < hi {
    if !is_ws_tok(tokens[i]) {
      out.push(tokens[i])
    }
    i = i + 1
  }
  out
}

///| Extract `(t0, t1, t2, alpha)` for modern-only 3-channel space-separated functions (`hwb`, `lab`, `lch`, `oklab`, `oklch`).
fn parse_modern_3_args(args : Array[Token]) -> Result[(Token, Token, Token, Double), CssError] {
  let n = args.length()
  if n == 3 {
    return Ok((args[0], args[1], args[2], 1.0))
  }
  if n == 5 {
    let slash_ok = match args[3].kind {
      TokenKind::Delim(d) => d == "/"
      _ => false
    }
    if !slash_ok {
      return Err(color_err("expected '/' before alpha"))
    }
    match parse_alpha_token(args[4], true) {
      Some(a) => return Ok((args[0], args[1], args[2], a))
      None => return Err(color_err("invalid alpha component"))
    }
  }
  Err(color_err("invalid number of arguments in color function"))
}

fn parse_color_space_func(args : Array[Token]) -> Result[Color, CssError] {
  let n = args.length()
  if n != 4 && n != 6 {
    return Err(color_err("invalid number of arguments in color()"))
  }
  let space = match args[0].kind {
    TokenKind::Ident(s) => ascii_lower(s)
    _ => return Err(color_err("expected color space identifier in color()"))
  }
  let valid_space = space == "srgb" ||
  space == "srgb-linear" ||
  space == "display-p3" ||
  space == "a98-rgb" ||
  space == "prophoto-rgb" ||
  space == "rec2020" ||
  space == "xyz" ||
  space == "xyz-d50" ||
  space == "xyz-d65"
  if !valid_space {
    return Err(color_err("unsupported color space: " + space))
  }
  let alpha = if n == 6 {
    let slash_ok = match args[4].kind {
      TokenKind::Delim(d) => d == "/"
      _ => false
    }
    if !slash_ok {
      return Err(color_err("expected '/' before alpha in color()"))
    }
    match parse_alpha_token(args[5], true) {
      Some(a) => a
      None => return Err(color_err("invalid alpha in color()"))
    }
  } else {
    1.0
  }
  let c0 = match parse_num_or_pct(args[1], 1.0) {
    Some(v) => v
    None => return Err(color_err("invalid channel 1 in color()"))
  }
  let c1 = match parse_num_or_pct(args[2], 1.0) {
    Some(v) => v
    None => return Err(color_err("invalid channel 2 in color()"))
  }
  let c2 = match parse_num_or_pct(args[3], 1.0) {
    Some(v) => v
    None => return Err(color_err("invalid channel 3 in color()"))
  }
  if space == "srgb-linear" {
    return Ok(linear_srgb_to_color(c0, c1, c2, alpha))
  }
  if space == "xyz" || space == "xyz-d65" {
    let lr = 3.2409699419045226 * c0 - 1.537383177570094 * c1 - 0.4986107602930034 * c2
    let lg = -0.9692436362808796 * c0 + 1.8759675015077202 * c1 + 0.04155505740717559 * c2
    let lb = 0.05563007969699366 * c0 - 0.20397695888897652 * c1 + 1.0569715142428786 * c2
    return Ok(linear_srgb_to_color(lr, lg, lb, alpha))
  }
  Ok(Color::rgba(clamp_u8(c0 * 255.0), clamp_u8(c1 * 255.0), clamp_u8(c2 * 255.0), alpha))
}

fn parse_func_color(
  fname : String,
  args : Array[Token],
) -> Result[Color, CssError] {
  let lf = ascii_lower(fname)

  // CSS Color 4 modern-only color functions
  if lf == "color" {
    return parse_color_space_func(args)
  }
  if lf == "hwb" {
    let (t0, t1, t2, alpha) = match parse_modern_3_args(args) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let h = match parse_hue_degrees(t0, true) {
      Some(v) => v
      None => return Err(color_err("invalid hue in hwb()"))
    }
    let w = match parse_percent_or_num_100(t1, false, true) {
      Some(v) => v
      None => return Err(color_err("invalid whiteness in hwb()"))
    }
    let b = match parse_percent_or_num_100(t2, false, true) {
      Some(v) => v
      None => return Err(color_err("invalid blackness in hwb()"))
    }
    return Ok(hwb_to_rgb(h, w, b, alpha))
  }
  if lf == "lab" {
    let (t0, t1, t2, alpha) = match parse_modern_3_args(args) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let l = match parse_num_or_pct(t0, 100.0) {
      Some(v) => v
      None => return Err(color_err("invalid L in lab()"))
    }
    let a = match parse_num_or_pct(t1, 125.0) {
      Some(v) => v
      None => return Err(color_err("invalid a in lab()"))
    }
    let b = match parse_num_or_pct(t2, 125.0) {
      Some(v) => v
      None => return Err(color_err("invalid b in lab()"))
    }
    return Ok(lab_to_rgb(l, a, b, alpha))
  }
  if lf == "lch" {
    let (t0, t1, t2, alpha) = match parse_modern_3_args(args) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let l = match parse_num_or_pct(t0, 100.0) {
      Some(v) => v
      None => return Err(color_err("invalid L in lch()"))
    }
    let c = match parse_num_or_pct(t1, 150.0) {
      Some(v) => v
      None => return Err(color_err("invalid C in lch()"))
    }
    let h = match parse_hue_degrees(t2, true) {
      Some(v) => v
      None => return Err(color_err("invalid H in lch()"))
    }
    let rad = h * pi() / 180.0
    return Ok(lab_to_rgb(l, c * cos_rad(rad), c * sin_rad(rad), alpha))
  }
  if lf == "oklab" {
    let (t0, t1, t2, alpha) = match parse_modern_3_args(args) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let l = match parse_num_or_pct(t0, 1.0) {
      Some(v) => v
      None => return Err(color_err("invalid L in oklab()"))
    }
    let a = match parse_num_or_pct(t1, 0.4) {
      Some(v) => v
      None => return Err(color_err("invalid a in oklab()"))
    }
    let b = match parse_num_or_pct(t2, 0.4) {
      Some(v) => v
      None => return Err(color_err("invalid b in oklab()"))
    }
    return Ok(oklab_to_rgb(l, a, b, alpha))
  }
  if lf == "oklch" {
    let (t0, t1, t2, alpha) = match parse_modern_3_args(args) {
      Ok(r) => r
      Err(e) => return Err(e)
    }
    let l = match parse_num_or_pct(t0, 1.0) {
      Some(v) => v
      None => return Err(color_err("invalid L in oklch()"))
    }
    let c = match parse_num_or_pct(t1, 0.4) {
      Some(v) => v
      None => return Err(color_err("invalid C in oklch()"))
    }
    let h = match parse_hue_degrees(t2, true) {
      Some(v) => v
      None => return Err(color_err("invalid H in oklch()"))
    }
    let rad = h * pi() / 180.0
    return Ok(oklab_to_rgb(l, c * cos_rad(rad), c * sin_rad(rad), alpha))
  }

  let is_rgb = lf == "rgb" || lf == "rgba"
  let is_hsl = lf == "hsl" || lf == "hsla"
  if !is_rgb && !is_hsl {
    return Err(color_err("unsupported color function: " + fname))
  }

  let n = args.length()
  // Detect legacy comma syntax vs modern space+slash syntax
  let mut has_comma = false
  let mut has_slash = false
  let mut i = 0
  while i < n {
    match args[i].kind {
      TokenKind::Comma => has_comma = true
      TokenKind::Delim(d) =>
      if d == "/" {
        has_slash = true
      }
      _ => ()
    }
    i = i + 1
  }
  if has_comma && has_slash {
    return Err(color_err("cannot mix commas and '/' in color function"))
  }

  let t0 : Token = if n > 0 { args[0] } else { return Err(color_err("missing color arguments")) }
  let mut t1_opt : Option[Token] = None
  let mut t2_opt : Option[Token] = None
  let mut ta_opt : Option[Token] = None

  if has_comma {
    // Legacy: a, b, c [, alpha]
    if n == 5 {
      match (args[1].kind, args[3].kind) {
        (TokenKind::Comma, TokenKind::Comma) => {
          t1_opt = Some(args[2])
          t2_opt = Some(args[4])
        }
        _ => return Err(color_err("invalid comma-separated color arguments"))
      }
    } else if n == 7 {
      match (args[1].kind, args[3].kind, args[5].kind) {
        (TokenKind::Comma, TokenKind::Comma, TokenKind::Comma) => {
          t1_opt = Some(args[2])
          t2_opt = Some(args[4])
          ta_opt = Some(args[6])
        }
        _ => return Err(color_err("invalid comma-separated color arguments"))
      }
    } else {
      return Err(color_err("invalid number of arguments in color function"))
    }
  } else {
    // Modern: a b c [/ alpha]
    if n == 3 {
      t1_opt = Some(args[1])
      t2_opt = Some(args[2])
    } else if n == 5 {
      let slash_ok = match args[3].kind {
        TokenKind::Delim(d) => d == "/"
        _ => false
      }
      if !slash_ok {
        return Err(color_err("expected '/' before alpha"))
      }
      t1_opt = Some(args[1])
      t2_opt = Some(args[2])
      ta_opt = Some(args[4])
    } else {
      return Err(color_err("invalid number of arguments in color function"))
    }
  }

  let t1 = match t1_opt {
    Some(t) => t
    None => return Err(color_err("missing second color component"))
  }
  let t2 = match t2_opt {
    Some(t) => t
    None => return Err(color_err("missing third color component"))
  }
  let allow_none = !has_comma
  let alpha = match ta_opt {
    Some(ta) =>
    match parse_alpha_token(ta, allow_none) {
      Some(a) => a
      None => return Err(color_err("invalid alpha component"))
    }
    None => 1.0
  }

  if is_rgb {
    let (r, r_pct) = match parse_rgb_channel_ex(t0, allow_none) {
      Some(v) => v
      None => return Err(color_err("invalid red channel"))
    }
    let (g, g_pct) = match parse_rgb_channel_ex(t1, allow_none) {
      Some(v) => v
      None => return Err(color_err("invalid green channel"))
    }
    let (b, b_pct) = match parse_rgb_channel_ex(t2, allow_none) {
      Some(v) => v
      None => return Err(color_err("invalid blue channel"))
    }
    // P1-10: Legacy comma rgb() forbids mixing numbers and percentages
    if has_comma && !(r_pct == g_pct && g_pct == b_pct) {
      return Err(color_err("legacy rgb() cannot mix numbers and percentages"))
    }
    return Ok(Color::rgba(r, g, b, alpha))
  }

  let h = match parse_hue_degrees(t0, allow_none) {
    Some(v) => v
    None => return Err(color_err("invalid hue component"))
  }
  // P1-10: Legacy comma hsl() requires percentages for S and L
  let s = match parse_percent_or_num_100(t1, has_comma, allow_none) {
    Some(v) => v
    None => return Err(color_err("invalid saturation component"))
  }
  let l = match parse_percent_or_num_100(t2, has_comma, allow_none) {
    Some(v) => v
    None => return Err(color_err("invalid lightness component"))
  }
  Ok(hsl_to_rgb(h, s, l, alpha))
}

///| Parse a CSS Color Level 4 color string.
pub fn parse_color_internal(src : String) -> Result[Color, CssError] {
  let clean = preprocess_string(src)
  let tokens = match tokenize_preprocessed(clean, ParseOptions::default()) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let stripped = strip_ws_tokens(tokens, 0, tokens.length())
  if stripped.length() == 0 {
    return Err(color_err("empty color"))
  }
  if stripped.length() == 1 {
    match stripped[0].kind {
      TokenKind::Hash(body, _) => return parse_hex_color(body)
      TokenKind::Ident(name) => {
        let low = ascii_lower(name)
        if low == "transparent" {
          return Ok(Color::transparent())
        }
        if low == "currentcolor" {
          return Ok(Color::current_color())
        }
        match lookup_named_color(low) {
          Some(packed) => {
            let r = (packed >> 16) & 0xFF
            let g = (packed >> 8) & 0xFF
            let b = packed & 0xFF
            return Ok(Color::rgb(r, g, b))
          }
          None => return Err(color_err("unknown color keyword: " + name))
        }
      }
      _ => return Err(color_err("unexpected token in color"))
    }
  }
  match stripped[0].kind {
    TokenKind::Function(fname) => {
      // Check for matching RightParen; if a RightParen appears before the last token, trailing tokens are invalid!
      let last = stripped.length() - 1
      let mut k = 1
      let mut depth = 1
      let mut closed_at = -1
      while k <= last {
        match stripped[k].kind {
          TokenKind::LeftParen | TokenKind::Function(_) => depth = depth + 1
          TokenKind::RightParen => {
            depth = depth - 1
            if depth == 0 {
              closed_at = k
              break
            }
          }
          _ => ()
        }
        k = k + 1
      }
      if closed_at >= 0 && closed_at != last {
        return Err(color_err("unexpected trailing tokens after color function"))
      }
      // P2-2: EOF closes an unclosed function (CSS Syntax 3 §5.4.9)
      let arg_end = if closed_at == last { last } else { stripped.length() }
      let args : Array[Token] = []
      let mut j = 1
      while j < arg_end {
        args.push(stripped[j])
        j = j + 1
      }
      parse_func_color(fname, args)
    }
    _ => Err(color_err("invalid color syntax"))
  }
}

///| Format a `Color` as `#rrggbb` or `#rrggbbaa` (or `"currentcolor"`).
pub fn color_to_hex(c : Color) -> String {
  if c.is_current_color {
    return "currentcolor"
  }
  let sb = StringBuilder::new()
  sb.write_byte((35).to_byte())
  write_hex_byte(sb, c.r)
  write_hex_byte(sb, c.g)
  write_hex_byte(sb, c.b)
  let a_byte = clamp_u8(c.a * 255.0)
  if a_byte < 255 {
    write_hex_byte(sb, a_byte)
  }
  sb.to_string()
}

///| Format a `Color` as canonical CSS.
pub fn color_to_css(c : Color) -> String {
  if c.is_current_color {
    return "currentcolor"
  }
  if c.a >= 0.999999 {
    return color_to_hex(c)
  }
  if c.r == 0 && c.g == 0 && c.b == 0 && c.a <= 0.000001 {
    return "transparent"
  }
  "rgba(" +
  c.r.to_string() +
  ", " +
  c.g.to_string() +
  ", " +
  c.b.to_string() +
  ", " +
  c.a.to_string() +
  ")"
}

///| Format a `Color` in shortest minified CSS form (`#fff`, `#f0a`, `#abcd`, etc.).
pub fn color_to_minified_css(c : Color) -> String {
  if c.is_current_color {
    return "currentcolor"
  }
  let hex = color_to_hex(c)
  "#" + minify_hex_body(hex.slice(1, hex.length()))
}
