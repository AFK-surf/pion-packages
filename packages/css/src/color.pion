///| CSS Color Level 4 parser & serializer (hex, rgb/rgba, hsl/hsla, 148 named colors, transparent, currentcolor).

fn color_err(msg : String) -> CssError {
  CssError::new(CssErrorKind::InvalidColor, 0, 1, 1, msg)
}

fn clamp_u8(v : Double) -> Int {
  let rounded = if v >= 0.0 {
    (v + 0.5).to_int()
  } else {
    (v - 0.5).to_int()
  }
  if rounded < 0 {
    0
  } else if rounded > 255 {
    255
  } else {
    rounded
  }
}

fn clamp_unit(v : Double) -> Double {
  if v < 0.0 {
    0.0
  } else if v > 1.0 {
    1.0
  } else {
    v
  }
}

fn hex_digit_char(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (87 + n).to_byte()
  }
}

fn write_hex_byte(sb : StringBuilder, v : Int) -> Unit {
  let c = if v < 0 { 0 } else if v > 255 { 255 } else { v }
  sb.write_byte(hex_digit_char((c >> 4) & 0xF))
  sb.write_byte(hex_digit_char(c & 0xF))
}

fn parse_hex_color(hex : String) -> Result[Color, CssError] {
  let n = hex.length()
  if n != 3 && n != 4 && n != 6 && n != 8 {
    return Err(color_err("invalid hex color length"))
  }
  let mut i = 0
  while i < n {
    if hex_val(hex.code_unit_at(i)) < 0 {
      return Err(color_err("invalid hex digit"))
    }
    i = i + 1
  }
  if n == 3 {
    let r = hex_val(hex.code_unit_at(0)) * 17
    let g = hex_val(hex.code_unit_at(1)) * 17
    let b = hex_val(hex.code_unit_at(2)) * 17
    return Ok(Color::rgb(r, g, b))
  }
  if n == 4 {
    let r = hex_val(hex.code_unit_at(0)) * 17
    let g = hex_val(hex.code_unit_at(1)) * 17
    let b = hex_val(hex.code_unit_at(2)) * 17
    let a = (hex_val(hex.code_unit_at(3)) * 17).to_double() / 255.0
    return Ok(Color::rgba(r, g, b, a))
  }
  let r = (hex_val(hex.code_unit_at(0)) << 4) | hex_val(hex.code_unit_at(1))
  let g = (hex_val(hex.code_unit_at(2)) << 4) | hex_val(hex.code_unit_at(3))
  let b = (hex_val(hex.code_unit_at(4)) << 4) | hex_val(hex.code_unit_at(5))
  if n == 6 {
    return Ok(Color::rgb(r, g, b))
  }
  let a_byte = (hex_val(hex.code_unit_at(6)) << 4) | hex_val(hex.code_unit_at(7))
  Ok(Color::rgba(r, g, b, a_byte.to_double() / 255.0))
}

fn parse_rgb_channel(tok : Token) -> Option[Int] {
  match tok.kind {
    TokenKind::Number(v, _, _) => Some(clamp_u8(v))
    TokenKind::Percentage(p, _, _) => Some(clamp_u8(p * 255.0 / 100.0))
    _ => None
  }
}

fn parse_alpha_token(tok : Token) -> Option[Double] {
  match tok.kind {
    TokenKind::Number(v, _, _) => Some(clamp_unit(v))
    TokenKind::Percentage(p, _, _) => Some(clamp_unit(p / 100.0))
    _ => None
  }
}

fn parse_hue_degrees(tok : Token) -> Option[Double] {
  match tok.kind {
    TokenKind::Number(v, _, _) => Some(v)
    TokenKind::Dimension(v, _, _, unit) => {
      let u = ascii_lower(unit)
      if u == "deg" {
        Some(v)
      } else if u == "turn" {
        Some(v * 360.0)
      } else if u == "grad" {
        Some(v * 0.9)
      } else if u == "rad" {
        Some(v * 180.0 / 3.14159265358979323846)
      } else {
        None
      }
    }
    _ => None
  }
}

fn parse_percent_unit(tok : Token) -> Option[Double] {
  match tok.kind {
    TokenKind::Percentage(p, _, _) => Some(clamp_unit(p / 100.0))
    TokenKind::Number(v, _, _) => Some(clamp_unit(v / 100.0))
    _ => None
  }
}

fn hsl_channel(n : Double, h : Double, s : Double, l : Double) -> Double {
  let k = (n + h / 30.0) % 12.0
  let a = s * (if l < 1.0 - l { l } else { 1.0 - l })
  let m1 = if k - 3.0 < 9.0 - k { k - 3.0 } else { 9.0 - k }
  let m2 = if m1 < 1.0 { m1 } else { 1.0 }
  let m3 = if m2 > -1.0 { m2 } else { -1.0 }
  l - a * m3
}

fn hsl_to_rgb(h_deg : Double, s : Double, l : Double, alpha : Double) -> Color {
  let mut h = h_deg % 360.0
  if h < 0.0 {
    h = h + 360.0
  }
  let r = clamp_u8(hsl_channel(0.0, h, s, l) * 255.0)
  let g = clamp_u8(hsl_channel(8.0, h, s, l) * 255.0)
  let b = clamp_u8(hsl_channel(4.0, h, s, l) * 255.0)
  Color::rgba(r, g, b, alpha)
}

fn strip_ws_tokens(tokens : Array[Token], lo : Int, hi : Int) -> Array[Token] {
  let out : Array[Token] = []
  let mut i = lo
  while i < hi {
    if !is_ws_tok(tokens[i]) {
      out.push(tokens[i])
    }
    i = i + 1
  }
  out
}

fn parse_func_color(
  fname : String,
  args : Array[Token],
) -> Result[Color, CssError] {
  let lf = ascii_lower(fname)
  let is_rgb = lf == "rgb" || lf == "rgba"
  let is_hsl = lf == "hsl" || lf == "hsla"
  if !is_rgb && !is_hsl {
    return Err(color_err("unsupported color function: " + fname))
  }

  let n = args.length()
  // Detect legacy comma syntax vs modern space+slash syntax
  let mut has_comma = false
  let mut has_slash = false
  let mut i = 0
  while i < n {
    match args[i].kind {
      TokenKind::Comma => has_comma = true
      TokenKind::Delim(d) =>
      if d == "/" {
        has_slash = true
      }
      _ => ()
    }
    i = i + 1
  }
  if has_comma && has_slash {
    return Err(color_err("cannot mix commas and '/' in color function"))
  }

  let t0 : Token = if n > 0 { args[0] } else { return Err(color_err("missing color arguments")) }
  let mut t1_opt : Option[Token] = None
  let mut t2_opt : Option[Token] = None
  let mut ta_opt : Option[Token] = None

  if has_comma {
    // Legacy: a, b, c [, alpha]
    if n == 5 {
      match (args[1].kind, args[3].kind) {
        (TokenKind::Comma, TokenKind::Comma) => {
          t1_opt = Some(args[2])
          t2_opt = Some(args[4])
        }
        _ => return Err(color_err("invalid comma-separated color arguments"))
      }
    } else if n == 7 {
      match (args[1].kind, args[3].kind, args[5].kind) {
        (TokenKind::Comma, TokenKind::Comma, TokenKind::Comma) => {
          t1_opt = Some(args[2])
          t2_opt = Some(args[4])
          ta_opt = Some(args[6])
        }
        _ => return Err(color_err("invalid comma-separated color arguments"))
      }
    } else {
      return Err(color_err("invalid number of arguments in color function"))
    }
  } else {
    // Modern: a b c [/ alpha]
    if n == 3 {
      t1_opt = Some(args[1])
      t2_opt = Some(args[2])
    } else if n == 5 {
      let slash_ok = match args[3].kind {
        TokenKind::Delim(d) => d == "/"
        _ => false
      }
      if !slash_ok {
        return Err(color_err("expected '/' before alpha"))
      }
      t1_opt = Some(args[1])
      t2_opt = Some(args[2])
      ta_opt = Some(args[4])
    } else {
      return Err(color_err("invalid number of arguments in color function"))
    }
  }

  let t1 = match t1_opt {
    Some(t) => t
    None => return Err(color_err("missing second color component"))
  }
  let t2 = match t2_opt {
    Some(t) => t
    None => return Err(color_err("missing third color component"))
  }
  let alpha = match ta_opt {
    Some(ta) =>
    match parse_alpha_token(ta) {
      Some(a) => a
      None => return Err(color_err("invalid alpha component"))
    }
    None => 1.0
  }

  if is_rgb {
    let r = match parse_rgb_channel(t0) {
      Some(v) => v
      None => return Err(color_err("invalid red channel"))
    }
    let g = match parse_rgb_channel(t1) {
      Some(v) => v
      None => return Err(color_err("invalid green channel"))
    }
    let b = match parse_rgb_channel(t2) {
      Some(v) => v
      None => return Err(color_err("invalid blue channel"))
    }
    return Ok(Color::rgba(r, g, b, alpha))
  }

  let h = match parse_hue_degrees(t0) {
    Some(v) => v
    None => return Err(color_err("invalid hue component"))
  }
  let s = match parse_percent_unit(t1) {
    Some(v) => v
    None => return Err(color_err("invalid saturation component"))
  }
  let l = match parse_percent_unit(t2) {
    Some(v) => v
    None => return Err(color_err("invalid lightness component"))
  }
  Ok(hsl_to_rgb(h, s, l, alpha))
}

///| Parse a CSS Color Level 4 color string.
pub fn parse_color_internal(src : String) -> Result[Color, CssError] {
  let clean = preprocess_string(src)
  let tokens = match tokenize_preprocessed(clean, ParseOptions::default()) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let stripped = strip_ws_tokens(tokens, 0, tokens.length())
  if stripped.length() == 0 {
    return Err(color_err("empty color"))
  }
  if stripped.length() == 1 {
    match stripped[0].kind {
      TokenKind::Hash(body, _) => return parse_hex_color(body)
      TokenKind::Ident(name) => {
        let low = ascii_lower(name)
        if low == "transparent" {
          return Ok(Color::transparent())
        }
        if low == "currentcolor" {
          return Ok(Color::current_color())
        }
        match lookup_named_color(low) {
          Some(packed) => {
            let r = (packed >> 16) & 0xFF
            let g = (packed >> 8) & 0xFF
            let b = packed & 0xFF
            return Ok(Color::rgb(r, g, b))
          }
          None => return Err(color_err("unknown color keyword: " + name))
        }
      }
      _ => return Err(color_err("unexpected token in color"))
    }
  }
  match stripped[0].kind {
    TokenKind::Function(fname) => {
      let last = stripped.length() - 1
      match stripped[last].kind {
        TokenKind::RightParen => {
          let args : Array[Token] = []
          let mut k = 1
          while k < last {
            args.push(stripped[k])
            k = k + 1
          }
          parse_func_color(fname, args)
        }
        _ => Err(color_err("unclosed color function"))
      }
    }
    _ => Err(color_err("invalid color syntax"))
  }
}

///| Format a `Color` as `#rrggbb` or `#rrggbbaa` (or `"currentcolor"`).
pub fn color_to_hex(c : Color) -> String {
  if c.is_current_color {
    return "currentcolor"
  }
  let sb = StringBuilder::new()
  sb.write_byte((35).to_byte())
  write_hex_byte(sb, c.r)
  write_hex_byte(sb, c.g)
  write_hex_byte(sb, c.b)
  let a_byte = clamp_u8(c.a * 255.0)
  if a_byte < 255 {
    write_hex_byte(sb, a_byte)
  }
  sb.to_string()
}

///| Format a `Color` as canonical CSS.
pub fn color_to_css(c : Color) -> String {
  if c.is_current_color {
    return "currentcolor"
  }
  if c.a >= 0.999999 {
    return color_to_hex(c)
  }
  if c.r == 0 && c.g == 0 && c.b == 0 && c.a <= 0.000001 {
    return "transparent"
  }
  "rgba(" +
  c.r.to_string() +
  ", " +
  c.g.to_string() +
  ", " +
  c.b.to_string() +
  ", " +
  c.a.to_string() +
  ")"
}

///| Format a `Color` in shortest minified CSS form (`#fff`, `#f0a`, `#abcd`, etc.).
pub fn color_to_minified_css(c : Color) -> String {
  if c.is_current_color {
    return "currentcolor"
  }
  let hex = color_to_hex(c)
  "#" + minify_hex_body(hex.slice(1, hex.length()))
}
