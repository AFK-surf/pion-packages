///| 100% iterative Media Queries Level 4 parser.

fn mq_err(offset : Int, msg : String) -> CssError {
  CssError::new(CssErrorKind::InvalidMediaQuery, offset, 1, 1, msg)
}

fn find_matching_paren(tokens : Array[Token], start : Int, hi : Int) -> Int {
  let mut depth = 1
  let mut i = start
  while i < hi && depth > 0 {
    match tokens[i].kind {
      TokenKind::LeftParen | TokenKind::Function(_) => depth = depth + 1
      TokenKind::RightParen => depth = depth - 1
      _ => ()
    }
    if depth == 0 {
      return i
    }
    i = i + 1
  }
  hi
}

///| Parse a comparison operator at `tokens[i]` (`=`, `<`, `<=`, `>`, `>=`).
fn try_parse_range_op(
  tokens : Array[Token],
  i : Int,
  hi : Int,
) -> Option[(MediaRangeOp, Int)] {
  if i >= hi {
    return None
  }
  match tokens[i].kind {
    TokenKind::Delim(d) => {
      if d == "=" {
        Some((MediaRangeOp::Eq, i + 1))
      } else if d == "<" {
        if i + 1 < hi {
          match tokens[i + 1].kind {
            TokenKind::Delim(d2) =>
            if d2 == "=" {
              return Some((MediaRangeOp::LtEq, i + 2))
            }
            _ => ()
          }
        }
        Some((MediaRangeOp::Lt, i + 1))
      } else if d == ">" {
        if i + 1 < hi {
          match tokens[i + 1].kind {
            TokenKind::Delim(d2) =>
            if d2 == "=" {
              return Some((MediaRangeOp::GtEq, i + 2))
            }
            _ => ()
          }
        }
        Some((MediaRangeOp::Gt, i + 1))
      } else {
        None
      }
    }
    _ => None
  }
}

fn is_single_ident(tokens : Array[Token], lo : Int, hi : Int) -> Bool {
  let mut i = lo
  while i < hi && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  let mut end = hi
  while end > i && is_ws_tok(tokens[end - 1]) {
    end = end - 1
  }
  if end - i != 1 {
    return false
  }
  match tokens[i].kind {
    TokenKind::Ident(_) => true
    _ => false
  }
}

///| Validate a `<mf-value>`: `<number>`, `<dimension>`, `<ident>`, or `<ratio>` (`<number> / <number>`).
fn is_valid_mf_value(tokens : Array[Token], lo : Int, hi : Int) -> Bool {
  let non_ws : Array[Token] = []
  let mut i = lo
  while i < hi {
    if !is_ws_tok(tokens[i]) {
      non_ws.push(tokens[i])
    }
    i = i + 1
  }
  if non_ws.length() == 1 {
    return match non_ws[0].kind {
      TokenKind::Number(_, _, _) | TokenKind::Dimension(_, _, _, _) | TokenKind::Ident(_) => true
      _ => false
    }
  }
  if non_ws.length() == 3 {
    let n0 = match non_ws[0].kind {
      TokenKind::Number(_, _, _) => true
      _ => false
    }
    let sl = match non_ws[1].kind {
      TokenKind::Delim(d) => d == "/"
      _ => false
    }
    let n2 = match non_ws[2].kind {
      TokenKind::Number(_, _, _) => true
      _ => false
    }
    return n0 && sl && n2
  }
  false
}

fn is_lt_op(op : MediaRangeOp) -> Bool {
  match op {
    MediaRangeOp::Lt | MediaRangeOp::LtEq => true
    _ => false
  }
}

fn is_gt_op(op : MediaRangeOp) -> Bool {
  match op {
    MediaRangeOp::Gt | MediaRangeOp::GtEq => true
    _ => false
  }
}

///| Parse a single media feature inside `(...)`: `tokens[lo..hi)`.
fn parse_media_feature(
  src : String,
  tokens : Array[Token],
  lo : Int,
  hi : Int,
) -> Result[MediaFeature, CssError] {
  let mut i = lo
  while i < hi && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  let mut end = hi
  while end > i && is_ws_tok(tokens[end - 1]) {
    end = end - 1
  }
  if i >= end {
    return Err(mq_err(0, "empty media feature"))
  }

  // Check for colon -> Plain feature `(name: value)`
  let mut colon_idx = -1
  let mut k = i
  while k < end {
    match tokens[k].kind {
      TokenKind::Colon => {
        colon_idx = k
        break
      }
      _ => k = k + 1
    }
  }
  if colon_idx >= 0 {
    if !is_single_ident(tokens, i, colon_idx) {
      return Err(mq_err(tokens[i].start, "invalid media feature name"))
    }
    if !is_valid_mf_value(tokens, colon_idx + 1, end) {
      return Err(mq_err(tokens[colon_idx].start, "invalid media feature value"))
    }
    let fname = ascii_lower(slice_tokens_text(src, tokens, i, colon_idx, true))
    let fval = slice_tokens_text(src, tokens, colon_idx + 1, end, true)
    return Ok(MediaFeature::Plain(fname, fval))
  }

  // Check for range operators (`<`, `<=`, `>`, `>=`, `=`)
  let op_positions : Array[(Int, Int, MediaRangeOp)] = []
  k = i
  while k < end {
    match try_parse_range_op(tokens, k, end) {
      Some((op, next_k)) => {
        op_positions.push((k, next_k, op))
        k = next_k
      }
      None => k = k + 1
    }
  }

  if op_positions.length() == 1 {
    let (op_start, op_end, op) = op_positions[0]
    let lhs_is_id = is_single_ident(tokens, i, op_start)
    let rhs_is_id = is_single_ident(tokens, op_end, end)
    let lhs_is_val = is_valid_mf_value(tokens, i, op_start)
    let rhs_is_val = is_valid_mf_value(tokens, op_end, end)
    if !((lhs_is_id && rhs_is_val) || (lhs_is_val && rhs_is_id)) {
      return Err(mq_err(tokens[op_start].start, "invalid range media feature"))
    }
    let lhs = slice_tokens_text(src, tokens, i, op_start, true)
    let rhs = slice_tokens_text(src, tokens, op_end, end, true)
    return Ok(MediaFeature::Range(ascii_lower(lhs), op, rhs))
  }
  if op_positions.length() == 2 {
    let (s1, e1, op1) = op_positions[0]
    let (s2, e2, op2) = op_positions[1]
    // P1-9: Both operators must point the same direction (both < / <= OR both > / >=),
    // middle must be a single <mf-name> ident, and outer operands must be valid <mf-value>s.
    let same_dir = (is_lt_op(op1) && is_lt_op(op2)) || (is_gt_op(op1) && is_gt_op(op2))
    if !same_dir {
      return Err(mq_err(tokens[s2].start, "mixed range directions in media feature"))
    }
    if !is_single_ident(tokens, e1, s2) {
      return Err(mq_err(tokens[e1].start, "expected feature name in middle of range"))
    }
    if !is_valid_mf_value(tokens, i, s1) || !is_valid_mf_value(tokens, e2, end) {
      return Err(mq_err(tokens[i].start, "invalid range bounds in media feature"))
    }
    let p1 = slice_tokens_text(src, tokens, i, s1, true)
    let mid = ascii_lower(slice_tokens_text(src, tokens, e1, s2, true))
    let p3 = slice_tokens_text(src, tokens, e2, end, true)
    return Ok(MediaFeature::RangeBetween(p1, op1, mid, op2, p3))
  }
  if op_positions.length() > 2 {
    return Err(mq_err(tokens[i].start, "too many range operators in media feature"))
  }

  // Boolean feature `(color)` -> must be a single identifier
  if !is_single_ident(tokens, i, end) {
    return Err(mq_err(tokens[i].start, "invalid boolean media feature"))
  }
  let bname = ascii_lower(slice_tokens_text(src, tokens, i, end, true))
  Ok(MediaFeature::Boolean(bname))
}

///| Check whether `tokens[lo..hi)` inside parens is a nested media condition (contains `and`/`or`/`not` or nested `(`).
fn is_nested_media_condition(
  tokens : Array[Token],
  lo : Int,
  hi : Int,
) -> Bool {
  let mut i = lo
  while i < hi {
    match tokens[i].kind {
      TokenKind::LeftParen => return true
      TokenKind::Ident(w) =>
      if ascii_eq_ignore_case(w, "not") ||
      ascii_eq_ignore_case(w, "and") ||
      ascii_eq_ignore_case(w, "or") {
        return true
      }
      _ => ()
    }
    i = i + 1
  }
  false
}

// Explicit heap frame for 100% iterative media condition parsing (P2-10)
struct MqCondFrame {
  lo : Int
  hi : Int
  allow_or : Bool
  mut pos : Int
  mut is_not : Bool
  mut op_kind : Int // 0 = none, 1 = and, 2 = or
  mut expect_item : Bool
  items : Array[MediaCondition]
}

fn MqCondFrame::new(lo : Int, hi : Int, allow_or : Bool) -> MqCondFrame {
  MqCondFrame::{
    lo: lo,
    hi: hi,
    allow_or: allow_or,
    pos: lo,
    is_not: false,
    op_kind: 0,
    expect_item: true,
    items: [],
  }
}

///| 100% iterative Media Queries 4 `<media-condition>` / `<media-condition-without-or>` parser.
fn parse_media_condition_iterative(
  src : String,
  tokens : Array[Token],
  lo : Int,
  hi : Int,
  allow_or : Bool,
  max_depth : Int,
) -> Result[MediaCondition, CssError] {
  let stack : Array[MqCondFrame] = [MqCondFrame::new(lo, hi, allow_or)]

  while stack.length() > 0 {
    let f = stack[stack.length() - 1]
    // Skip whitespace
    while f.pos < f.hi && is_ws_tok(tokens[f.pos]) {
      f.pos = f.pos + 1
    }

    // Check if we finished this frame
    if f.pos >= f.hi {
      if f.expect_item || f.items.length() == 0 {
        return Err(mq_err(0, "incomplete or empty media condition"))
      }
      let built = if f.is_not {
        MediaCondition::Not(f.items[0])
      } else if f.items.length() == 1 {
        f.items[0]
      } else if f.op_kind == 2 {
        MediaCondition::Or(f.items)
      } else {
        MediaCondition::And(f.items)
      }
      let _ = stack.pop()
      if stack.length() == 0 {
        return Ok(built)
      }
      let parent = stack[stack.length() - 1]
      parent.items.push(built)
      parent.expect_item = false
      continue
    }

    let tok = tokens[f.pos]

    // At the start of a condition, check for leading `not <media-in-parens>`
    if f.items.length() == 0 && !f.is_not && f.expect_item {
      let is_not_kw = match tok.kind {
        TokenKind::Ident(w) => ascii_eq_ignore_case(w, "not")
        _ => false
      }
      if is_not_kw {
        f.is_not = true
        f.pos = f.pos + 1
        while f.pos < f.hi && is_ws_tok(tokens[f.pos]) {
          f.pos = f.pos + 1
        }
        // P1-9: `<media-not>` MUST be followed by a SINGLE `(...)` and nothing else!
        if f.pos >= f.hi {
          return Err(mq_err(tok.start, "expected '(' after 'not'"))
        }
        match tokens[f.pos].kind {
          TokenKind::LeftParen => {
            let close_i = find_matching_paren(tokens, f.pos + 1, f.hi)
            if close_i >= f.hi {
              return Err(mq_err(tokens[f.pos].start, "unclosed '(' after 'not'"))
            }
            // Verify NOTHING follows the single `(...)` in this frame!
            let mut after = close_i + 1
            while after < f.hi && is_ws_tok(tokens[after]) {
              after = after + 1
            }
            if after < f.hi {
              return Err(mq_err(tokens[after].start, "unexpected token after 'not (...)' (parentheses required)"))
            }
            let inner_lo = f.pos + 1
            f.pos = f.hi
            if is_nested_media_condition(tokens, inner_lo, close_i) {
              if stack.length() >= max_depth {
                return Err(CssError::new(CssErrorKind::LimitExceeded, tokens[inner_lo].start, 1, 1, "media query depth exceeded"))
              }
              stack.push(MqCondFrame::new(inner_lo, close_i, true))
            } else {
              match parse_media_feature(src, tokens, inner_lo, close_i) {
                Ok(feat) => {
                  f.items.push(MediaCondition::Feature(feat))
                  f.expect_item = false
                }
                Err(e) => return Err(e)
              }
            }
            continue
          }
          _ => return Err(mq_err(tokens[f.pos].start, "expected '(' after 'not'"))
        }
      }
    }

    if f.expect_item {
      match tok.kind {
        TokenKind::LeftParen => {
          let close_i = find_matching_paren(tokens, f.pos + 1, f.hi)
          if close_i >= f.hi {
            return Err(mq_err(tok.start, "unclosed '(' in media condition"))
          }
          let inner_lo = f.pos + 1
          f.pos = close_i + 1
          if is_nested_media_condition(tokens, inner_lo, close_i) {
            if stack.length() >= max_depth {
              return Err(CssError::new(CssErrorKind::LimitExceeded, tok.start, 1, 1, "media query depth exceeded"))
            }
            stack.push(MqCondFrame::new(inner_lo, close_i, true))
          } else {
            match parse_media_feature(src, tokens, inner_lo, close_i) {
              Ok(feat) => {
                f.items.push(MediaCondition::Feature(feat))
                f.expect_item = false
              }
              Err(e) => return Err(e)
            }
          }
        }
        _ => return Err(mq_err(tok.start, "expected '(' in media condition"))
      }
    } else {
      // Expect `and` or `or` between parenthesized conditions
      match tok.kind {
        TokenKind::Ident(w) => {
          if ascii_eq_ignore_case(w, "and") {
            if f.op_kind == 2 {
              return Err(mq_err(tok.start, "cannot mix 'and' and 'or' without parentheses"))
            }
            f.op_kind = 1
            f.expect_item = true
            f.pos = f.pos + 1
          } else if ascii_eq_ignore_case(w, "or") {
            if !f.allow_or {
              return Err(mq_err(tok.start, "'or' is not allowed after media type without parentheses"))
            }
            if f.op_kind == 1 {
              return Err(mq_err(tok.start, "cannot mix 'and' and 'or' without parentheses"))
            }
            f.op_kind = 2
            f.expect_item = true
            f.pos = f.pos + 1
          } else {
            return Err(mq_err(tok.start, "expected 'and' or 'or' in media condition"))
          }
        }
        _ => return Err(mq_err(tok.start, "expected 'and' or 'or' in media condition"))
      }
    }
  }

  Err(mq_err(0, "empty media condition"))
}

fn is_forbidden_media_type(t : String) -> Bool {
  t == "only" || t == "not" || t == "and" || t == "or" || t == "layer"
}

fn parse_single_media_query(
  src : String,
  tokens : Array[Token],
  lo : Int,
  hi : Int,
  max_depth : Int,
) -> Result[MediaQuery, CssError] {
  let mut i = lo
  while i < hi && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  let mut end = hi
  while end > i && is_ws_tok(tokens[end - 1]) {
    end = end - 1
  }
  if i >= end {
    return Err(mq_err(0, "empty media query"))
  }

  // Case 1: starts with `(` -> pure `<media-condition>`
  match tokens[i].kind {
    TokenKind::LeftParen => {
      let cond = match parse_media_condition_iterative(src, tokens, i, end, true, max_depth) {
        Ok(c) => c
        Err(e) => return Err(e)
      }
      return Ok(MediaQuery::{
        modifier: MediaModifier::None,
        media_type: "",
        condition: Some(cond),
      })
    }
    _ => ()
  }

  // Case 2: starts with `not (` -> pure negated `<media-condition>`
  let starts_with_not = match tokens[i].kind {
    TokenKind::Ident(w) => ascii_eq_ignore_case(w, "not")
    _ => false
  }
  if starts_with_not {
    let mut j = i + 1
    while j < end && is_ws_tok(tokens[j]) {
      j = j + 1
    }
    if j < end {
      match tokens[j].kind {
        TokenKind::LeftParen => {
          let cond = match parse_media_condition_iterative(src, tokens, i, end, true, max_depth) {
            Ok(c) => c
            Err(e) => return Err(e)
          }
          return Ok(MediaQuery::{
            modifier: MediaModifier::None,
            media_type: "",
            condition: Some(cond),
          })
        }
        _ => ()
      }
    }
  }

  // Case 3: `[not | only]? <media-type> [and <media-condition-without-or>]?`
  let mut modifier = MediaModifier::None
  match tokens[i].kind {
    TokenKind::Ident(w) => {
      if ascii_eq_ignore_case(w, "not") {
        modifier = MediaModifier::Not
        i = i + 1
      } else if ascii_eq_ignore_case(w, "only") {
        modifier = MediaModifier::Only
        i = i + 1
      }
    }
    _ => ()
  }
  while i < end && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  if i >= end {
    return Err(mq_err(0, "expected media type"))
  }
  let media_type = match tokens[i].kind {
    TokenKind::Ident(t) => ascii_lower(t)
    _ => return Err(mq_err(tokens[i].start, "expected media type identifier"))
  }
  if is_forbidden_media_type(media_type) {
    return Err(mq_err(tokens[i].start, "invalid media type: " + media_type))
  }
  i = i + 1
  while i < end && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  if i >= end {
    return Ok(MediaQuery::{
      modifier: modifier,
      media_type: media_type,
      condition: None,
    })
  }
  // Expect `and <media-condition-without-or>`
  match tokens[i].kind {
    TokenKind::Ident(w) => {
      if !ascii_eq_ignore_case(w, "and") {
        return Err(mq_err(tokens[i].start, "expected 'and' after media type"))
      }
      i = i + 1
    }
    _ => return Err(mq_err(tokens[i].start, "expected 'and' after media type"))
  }
  // P1-9: allow_or = false after `<media-type> and`!
  let cond = match parse_media_condition_iterative(src, tokens, i, end, false, max_depth) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  Ok(MediaQuery::{
    modifier: modifier,
    media_type: media_type,
    condition: Some(cond),
  })
}

///| Parse a comma-separated Media Queries Level 4 list.
pub fn parse_media_query_list_internal(
  src : String,
  opts : ParseOptions,
) -> Result[Array[MediaQuery], CssError] {
  let clean = preprocess_string(src)
  let tokens = match tokenize_preprocessed(clean, opts) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match check_token_nesting_depth(tokens, opts.max_depth) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  let n = tokens.length()
  // Empty/whitespace-only media query list -> empty list (matches all)
  let mut has_non_ws = false
  let mut k = 0
  while k < n {
    if !is_ws_tok(tokens[k]) {
      has_non_ws = true
      break
    }
    k = k + 1
  }
  if !has_non_ws {
    return Ok([])
  }

  let out : Array[MediaQuery] = []
  let mut start = 0
  let mut depth = 0
  let mut i = 0
  while i <= n {
    let at_sep = if i == n {
      true
    } else {
      match tokens[i].kind {
        TokenKind::LeftParen | TokenKind::Function(_) => {
          depth = depth + 1
          false
        }
        TokenKind::RightParen => {
          if depth > 0 {
            depth = depth - 1
          }
          false
        }
        TokenKind::Comma => depth == 0
        _ => false
      }
    }
    if at_sep {
      match parse_single_media_query(clean, tokens, start, i, opts.max_depth) {
        Ok(mq) => out.push(mq)
        Err(e) => return Err(e)
      }
      start = i + 1
    }
    i = i + 1
  }
  Ok(out)
}
