///| Media Queries Level 4 parser.

fn mq_err(offset : Int, msg : String) -> CssError {
  CssError::new(CssErrorKind::InvalidMediaQuery, offset, 1, 1, msg)
}

fn find_matching_paren(tokens : Array[Token], start : Int, hi : Int) -> Int {
  let mut depth = 1
  let mut i = start
  while i < hi && depth > 0 {
    match tokens[i].kind {
      TokenKind::LeftParen | TokenKind::Function(_) => depth = depth + 1
      TokenKind::RightParen => depth = depth - 1
      _ => ()
    }
    if depth == 0 {
      return i
    }
    i = i + 1
  }
  hi
}

///| Parse a comparison operator at `tokens[i]` (`=`, `<`, `<=`, `>`, `>=`).
///| Returns `Some((op, next_i))` or `None`.
fn try_parse_range_op(
  tokens : Array[Token],
  i : Int,
  hi : Int,
) -> Option[(MediaRangeOp, Int)] {
  if i >= hi {
    return None
  }
  match tokens[i].kind {
    TokenKind::Delim(d) => {
      if d == "=" {
        Some((MediaRangeOp::Eq, i + 1))
      } else if d == "<" {
        if i + 1 < hi {
          match tokens[i + 1].kind {
            TokenKind::Delim(d2) =>
            if d2 == "=" {
              return Some((MediaRangeOp::LtEq, i + 2))
            }
            _ => ()
          }
        }
        Some((MediaRangeOp::Lt, i + 1))
      } else if d == ">" {
        if i + 1 < hi {
          match tokens[i + 1].kind {
            TokenKind::Delim(d2) =>
            if d2 == "=" {
              return Some((MediaRangeOp::GtEq, i + 2))
            }
            _ => ()
          }
        }
        Some((MediaRangeOp::Gt, i + 1))
      } else {
        None
      }
    }
    _ => None
  }
}

///| Parse a single media feature inside `(...)`: `tokens[lo..hi)`.
fn parse_media_feature(
  src : String,
  tokens : Array[Token],
  lo : Int,
  hi : Int,
) -> Result[MediaFeature, CssError] {
  let mut i = lo
  while i < hi && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  let mut end = hi
  while end > i && is_ws_tok(tokens[end - 1]) {
    end = end - 1
  }
  if i >= end {
    return Err(mq_err(0, "empty media feature"))
  }

  // Check for colon -> Plain feature `(name: value)`
  let mut colon_idx = -1
  let mut k = i
  while k < end {
    match tokens[k].kind {
      TokenKind::Colon => {
        colon_idx = k
        break
      }
      _ => k = k + 1
    }
  }
  if colon_idx >= 0 {
    let fname = ascii_lower(slice_tokens_text(src, tokens, i, colon_idx, true))
    let fval = slice_tokens_text(src, tokens, colon_idx + 1, end, true)
    if fname.length() == 0 {
      return Err(mq_err(tokens[i].start, "missing media feature name"))
    }
    return Ok(MediaFeature::Plain(fname, fval))
  }

  // Check for range operators (`<`, `<=`, `>`, `>=`, `=`)
  let op_positions : Array[(Int, Int, MediaRangeOp)] = []
  k = i
  while k < end {
    match try_parse_range_op(tokens, k, end) {
      Some((op, next_k)) => {
        op_positions.push((k, next_k, op))
        k = next_k
      }
      None => k = k + 1
    }
  }

  if op_positions.length() == 1 {
    let (op_start, op_end, op) = op_positions[0]
    let lhs = slice_tokens_text(src, tokens, i, op_start, true)
    let rhs = slice_tokens_text(src, tokens, op_end, end, true)
    return Ok(MediaFeature::Range(ascii_lower(lhs), op, rhs))
  }
  if op_positions.length() == 2 {
    let (s1, e1, op1) = op_positions[0]
    let (s2, e2, op2) = op_positions[1]
    let p1 = slice_tokens_text(src, tokens, i, s1, true)
    let mid = ascii_lower(slice_tokens_text(src, tokens, e1, s2, true))
    let p3 = slice_tokens_text(src, tokens, e2, end, true)
    return Ok(MediaFeature::RangeBetween(p1, op1, mid, op2, p3))
  }

  // Boolean feature `(color)`
  let bname = ascii_lower(slice_tokens_text(src, tokens, i, end, true))
  Ok(MediaFeature::Boolean(bname))
}

///| Check whether `tokens[lo..hi)` inside parens is a nested media condition (contains `and`/`or`/`not` or nested `(`).
fn is_nested_media_condition(
  tokens : Array[Token],
  lo : Int,
  hi : Int,
) -> Bool {
  let mut i = lo
  while i < hi {
    match tokens[i].kind {
      TokenKind::LeftParen => return true
      TokenKind::Ident(w) =>
      if ascii_eq_ignore_case(w, "not") ||
      ascii_eq_ignore_case(w, "and") ||
      ascii_eq_ignore_case(w, "or") {
        return true
      }
      _ => ()
    }
    i = i + 1
  }
  false
}

///| Parse a media condition over `tokens[lo..hi)` (depth-bounded).
fn parse_media_condition(
  src : String,
  tokens : Array[Token],
  lo : Int,
  hi : Int,
  depth : Int,
  max_depth : Int,
) -> Result[MediaCondition, CssError] {
  if depth > max_depth {
    return Err(
      CssError::new(CssErrorKind::LimitExceeded, 0, 1, 1, "media query depth exceeded"),
    )
  }
  let mut i = lo
  while i < hi && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  if i >= hi {
    return Err(mq_err(0, "empty media condition"))
  }

  // Leading `not (...)`
  let is_not = match tokens[i].kind {
    TokenKind::Ident(w) => ascii_eq_ignore_case(w, "not")
    _ => false
  }
  if is_not {
    let mut j = i + 1
    while j < hi && is_ws_tok(tokens[j]) {
      j = j + 1
    }
    let inner = match parse_media_condition(src, tokens, j, hi, depth + 1, max_depth) {
      Ok(c) => c
      Err(e) => return Err(e)
    }
    return Ok(MediaCondition::Not(inner))
  }

  let items : Array[MediaCondition] = []
  let mut op_kind = 0 // 0 = single, 1 = and, 2 = or

  while i < hi {
    while i < hi && is_ws_tok(tokens[i]) {
      i = i + 1
    }
    if i >= hi {
      break
    }
    match tokens[i].kind {
      TokenKind::LeftParen => {
        let close_i = find_matching_paren(tokens, i + 1, hi)
        if close_i >= hi {
          return Err(mq_err(tokens[i].start, "unclosed '(' in media condition"))
        }
        let cond = if is_nested_media_condition(tokens, i + 1, close_i) {
          match parse_media_condition(src, tokens, i + 1, close_i, depth + 1, max_depth) {
            Ok(c) => c
            Err(e) => return Err(e)
          }
        } else {
          match parse_media_feature(src, tokens, i + 1, close_i) {
            Ok(f) => MediaCondition::Feature(f)
            Err(e) => return Err(e)
          }
        }
        items.push(cond)
        i = close_i + 1
      }
      TokenKind::Ident(w) => {
        if ascii_eq_ignore_case(w, "and") {
          if op_kind == 2 {
            return Err(mq_err(tokens[i].start, "cannot mix 'and' and 'or' without parentheses"))
          }
          op_kind = 1
          i = i + 1
        } else if ascii_eq_ignore_case(w, "or") {
          if op_kind == 1 {
            return Err(mq_err(tokens[i].start, "cannot mix 'and' and 'or' without parentheses"))
          }
          op_kind = 2
          i = i + 1
        } else {
          return Err(mq_err(tokens[i].start, "unexpected identifier in media condition: " + w))
        }
      }
      _ => return Err(mq_err(tokens[i].start, "unexpected token in media condition"))
    }
  }

  if items.length() == 0 {
    return Err(mq_err(0, "empty media condition"))
  }
  if items.length() == 1 {
    return Ok(items[0])
  }
  if op_kind == 2 {
    Ok(MediaCondition::Or(items))
  } else {
    Ok(MediaCondition::And(items))
  }
}

fn parse_single_media_query(
  src : String,
  tokens : Array[Token],
  lo : Int,
  hi : Int,
  max_depth : Int,
) -> Result[MediaQuery, CssError] {
  let mut i = lo
  while i < hi && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  let mut end = hi
  while end > i && is_ws_tok(tokens[end - 1]) {
    end = end - 1
  }
  if i >= end {
    return Ok(MediaQuery::{
      modifier: MediaModifier::None,
      media_type: "all",
      condition: None,
    })
  }

  // Case 1: starts with `(` -> pure media condition
  match tokens[i].kind {
    TokenKind::LeftParen => {
      let cond = match parse_media_condition(src, tokens, i, end, 0, max_depth) {
        Ok(c) => c
        Err(e) => return Err(e)
      }
      return Ok(MediaQuery::{
        modifier: MediaModifier::None,
        media_type: "",
        condition: Some(cond),
      })
    }
    _ => ()
  }

  // Case 2: starts with `not (` -> pure negated media condition (not a media type)
  let starts_with_not = match tokens[i].kind {
    TokenKind::Ident(w) => ascii_eq_ignore_case(w, "not")
    _ => false
  }
  if starts_with_not {
    let mut j = i + 1
    while j < end && is_ws_tok(tokens[j]) {
      j = j + 1
    }
    if j < end {
      match tokens[j].kind {
        TokenKind::LeftParen => {
          let cond = match parse_media_condition(src, tokens, i, end, 0, max_depth) {
            Ok(c) => c
            Err(e) => return Err(e)
          }
          return Ok(MediaQuery::{
            modifier: MediaModifier::None,
            media_type: "",
            condition: Some(cond),
          })
        }
        _ => ()
      }
    }
  }

  // Case 3: `[not | only]? <media-type> [and <media-condition>]?`
  let mut modifier = MediaModifier::None
  match tokens[i].kind {
    TokenKind::Ident(w) => {
      if ascii_eq_ignore_case(w, "not") {
        modifier = MediaModifier::Not
        i = i + 1
      } else if ascii_eq_ignore_case(w, "only") {
        modifier = MediaModifier::Only
        i = i + 1
      }
    }
    _ => ()
  }
  while i < end && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  if i >= end {
    return Err(mq_err(0, "expected media type"))
  }
  let media_type = match tokens[i].kind {
    TokenKind::Ident(t) => ascii_lower(t)
    _ => return Err(mq_err(tokens[i].start, "expected media type identifier"))
  }
  i = i + 1
  while i < end && is_ws_tok(tokens[i]) {
    i = i + 1
  }
  if i >= end {
    return Ok(MediaQuery::{
      modifier: modifier,
      media_type: media_type,
      condition: None,
    })
  }
  // Expect `and <condition>`
  match tokens[i].kind {
    TokenKind::Ident(w) => {
      if !ascii_eq_ignore_case(w, "and") {
        return Err(mq_err(tokens[i].start, "expected 'and' after media type"))
      }
      i = i + 1
    }
    _ => return Err(mq_err(tokens[i].start, "expected 'and' after media type"))
  }
  let cond = match parse_media_condition(src, tokens, i, end, 0, max_depth) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  Ok(MediaQuery::{
    modifier: modifier,
    media_type: media_type,
    condition: Some(cond),
  })
}

///| Parse a comma-separated Media Queries Level 4 list.
pub fn parse_media_query_list_internal(
  src : String,
  opts : ParseOptions,
) -> Result[Array[MediaQuery], CssError] {
  let clean = preprocess_string(src)
  let tokens = match tokenize_preprocessed(clean, opts) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match check_token_nesting_depth(tokens, opts.max_depth) {
    Ok(()) => ()
    Err(e) => return Err(e)
  }
  let n = tokens.length()
  let out : Array[MediaQuery] = []
  let mut start = 0
  let mut depth = 0
  let mut i = 0
  while i <= n {
    let at_sep = if i == n {
      true
    } else {
      match tokens[i].kind {
        TokenKind::LeftParen | TokenKind::Function(_) => {
          depth = depth + 1
          false
        }
        TokenKind::RightParen => {
          if depth > 0 {
            depth = depth - 1
          }
          false
        }
        TokenKind::Comma => depth == 0
        _ => false
      }
    }
    if at_sep {
      match parse_single_media_query(clean, tokens, start, i, opts.max_depth) {
        Ok(mq) => out.push(mq)
        Err(e) => return Err(e)
      }
      start = i + 1
    }
    i = i + 1
  }
  Ok(out)
}
