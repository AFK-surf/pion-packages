///| Head-to-head benchmark driver for `packages/css`.

import "css"

fn parse_int_arg(s : String, fallback : Int) -> Int {
  let n = s.length()
  if n == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return fallback
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

fn count_sheet_stats(sheet : css::Stylesheet) -> (Int, Int, Int, Int) {
  let mut q_rules = 0
  let mut at_rules = 0
  let mut decls = 0
  let mut imps = 0
  let stack : Array[css::Rule] = []
  let mut i = sheet.rules.length() - 1
  while i >= 0 {
    stack.push(sheet.rules[i])
    i = i - 1
  }
  while stack.length() > 0 {
    let r = stack[stack.length() - 1]
    let _ = stack.pop()
    match r {
      css::Rule::Qualified(qr) => {
        q_rules = q_rules + 1
        let mut d = 0
        while d < qr.declarations.length() {
          decls = decls + 1
          if qr.declarations[d].important {
            imps = imps + 1
          }
          d = d + 1
        }
        let mut k = qr.nested_rules.length() - 1
        while k >= 0 {
          stack.push(qr.nested_rules[k])
          k = k - 1
        }
      }
      css::Rule::At(ar) => {
        at_rules = at_rules + 1
        let mut d = 0
        while d < ar.declarations.length() {
          decls = decls + 1
          if ar.declarations[d].important {
            imps = imps + 1
          }
          d = d + 1
        }
        let mut k = ar.rules.length() - 1
        while k >= 0 {
          stack.push(ar.rules[k])
          k = k - 1
        }
      }
    }
  }
  (q_rules, at_rules, decls, imps)
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: css_bench_pion <tokenize|parse|minify> <file> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_int_arg(args[3], 1)
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input file")
      return 1
    }
  }

  if mode == "tokenize" {
    let mut total_non_ws : Int64 = 0L
    let mut r = 0
    while r < iters {
      let c = match css::count_non_ws_tokens(src) {
        Ok(cnt) => cnt
        Err(e) => {
          io_println(world, "tokenize error: " + e.to_string())
          return 1
        }
      }
      total_non_ws = total_non_ws + c.to_int64()
      r = r + 1
    }
    io_println(world, "mode=tokenize")
    io_println(world, "iters=" + iters.to_string())
    io_println(world, "non_ws_tokens=" + total_non_ws.to_string())
    return 0
  }

  if mode == "parse" {
    let mut total_q : Int64 = 0L
    let mut total_at : Int64 = 0L
    let mut total_decls : Int64 = 0L
    let mut total_imp : Int64 = 0L
    let mut r = 0
    while r < iters {
      let sheet = match css::parse_stylesheet(src) {
        Ok(s) => s
        Err(e) => {
          io_println(world, "parse error: " + e.to_string())
          return 1
        }
      }
      let (q, a, d, imp) = count_sheet_stats(sheet)
      total_q = total_q + q.to_int64()
      total_at = total_at + a.to_int64()
      total_decls = total_decls + d.to_int64()
      total_imp = total_imp + imp.to_int64()
      r = r + 1
    }
    io_println(world, "mode=parse")
    io_println(world, "iters=" + iters.to_string())
    io_println(world, "qualified_rules=" + total_q.to_string())
    io_println(world, "at_rules=" + total_at.to_string())
    io_println(world, "declarations=" + total_decls.to_string())
    io_println(world, "important=" + total_imp.to_string())
    return 0
  }

  if mode == "minify" {
    let mut total_bytes : Int64 = 0L
    let mut last_out = ""
    let mut r = 0
    while r < iters {
      let out = match css::minify(src) {
        Ok(s) => s
        Err(e) => {
          io_println(world, "minify error: " + e.to_string())
          return 1
        }
      }
      total_bytes = total_bytes + out.length().to_int64()
      last_out = out
      r = r + 1
    }
    io_println(world, "mode=minify")
    io_println(world, "iters=" + iters.to_string())
    io_println(world, "total_bytes=" + total_bytes.to_string())
    io_println(world, "sample_head=" + last_out.slice(0, 120))
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
