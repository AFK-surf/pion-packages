///| Red-team regression tests for packages/css @ 7d19ec4 (branch feat/pkg-css).
///
/// `p0_*` / `p1_*` / `p2_*` tests assert what the reference implementations do (Rust cssparser
/// =0.35.0, cssparser-color =0.3.0, lightningcss =1.0.0-alpha.72 / parcel_selectors, Node css-tree
/// @3.1.0) or what the W3C spec text says where the oracles are silent; every expectation below was
/// checked against `rust/` (see REPORT.md for the oracle output) — a FAILURE here is the evidence.
/// `control_*` tests are attacks Pion survived, including places where Pion is more correct or more
/// robust than an oracle; they must keep passing.
/// Timing / memory findings (stack-overflow of the oracles, realistic-size limits, throughput) are
/// reproduced by run_audit.sh (scripts/dos.py, scripts/perf.py).

import "css"

///|
fn contains(hay : String, needle : String) -> Bool {
  let n = hay.length()
  let m = needle.length()
  let mut i = 0
  while i + m <= n {
    if hay.slice(i, i + m) == needle {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn index_of(hay : String, needle : String) -> Int {
  let n = hay.length()
  let m = needle.length()
  let mut i = 0
  while i + m <= n {
    if hay.slice(i, i + m) == needle {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::with_capacity(s.length() * n + 1)
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
fn mini(src : String) -> String {
  match css::minify(src) {
    Ok(s) => s
    Err(e) => "ERR " + e.to_string()
  }
}

///|
fn pretty(src : String) -> String {
  match css::parse_stylesheet(src) {
    Ok(s) => css::to_css(s)
    Err(e) => "ERR " + e.to_string()
  }
}

///|
fn spec(sel : String) -> String {
  match css::selector_specificity(sel) {
    Ok(s) => s.ids.to_string() + "," + s.classes.to_string() + "," + s.elements.to_string()
    Err(_) => "ERR"
  }
}

///| Compact token dump: `I(u)`, `D(+)`, `U(10-10)`, `N`, `X(unit)`, ...
fn toks(src : String) -> String {
  let sb = StringBuilder::new()
  match css::tokenize(src) {
    Ok(ts) => {
      let mut i = 0
      while i < ts.length() {
        match ts[i].kind {
          css::TokenKind::Ident(s) => sb.write_string("I(" + s + ")")
          css::TokenKind::Function(s) => sb.write_string("F(" + s + ")")
          css::TokenKind::Delim(s) => sb.write_string("D(" + s + ")")
          css::TokenKind::UnicodeRange(a, b) =>
          sb.write_string("U(" + a.to_string() + "-" + b.to_string() + ")")
          css::TokenKind::Url(s) => sb.write_string("URL(" + s + ")")
          css::TokenKind::BadUrl => sb.write_string("BADURL")
          css::TokenKind::Number(_, _, _) => sb.write_string("N")
          css::TokenKind::Dimension(_, _, _, u) => sb.write_string("X(" + u + ")")
          css::TokenKind::Whitespace => sb.write_string("_")
          _ => sb.write_string("?")
        }
        i = i + 1
      }
    }
    Err(e) => sb.write_string("ERR " + e.to_string())
  }
  sb.to_string()
}

///| First top-level qualified rule (or a placeholder with prelude "<none>").
fn first_rule(src : String) -> css::QualifiedRule {
  let none = css::QualifiedRule::{ prelude: "<none>", declarations: [], nested_rules: [] }
  match css::parse_stylesheet(src) {
    Ok(s) => {
      let mut i = 0
      while i < s.rules.length() {
        match s.rules[i] {
          css::Rule::Qualified(q) => return q
          _ => ()
        }
        i = i + 1
      }
      none
    }
    Err(_) => none
  }
}

///| Unit of the first dimension token in `parse(minify(src))`'s first declaration value.
fn unit_after_minify(src : String) -> String {
  let q = first_rule(mini(src))
  if q.declarations.length() == 0 {
    return "<no decl>"
  }
  match css::tokenize(q.declarations[0].value) {
    Ok(ts) => {
      let mut i = 0
      while i < ts.length() {
        match ts[i].kind {
          css::TokenKind::Dimension(_, _, _, u) => return u
          _ => ()
        }
        i = i + 1
      }
      "<no dimension>"
    }
    Err(_) => "<err>"
  }
}

///|
fn make_bytes(arr : Array[Int]) -> Bytes {
  let out = Bytes::new(arr.length())
  let mut i = 0
  while i < arr.length() {
    out[i] = arr[i].to_byte()
    i = i + 1
  }
  out
}

// ===========================================================================
// F-1 (P0) CSS Nesting: declarations that follow a nested rule are hoisted above it.
// `QualifiedRule`/`AtRule` keep `declarations` and `nested_rules` in two separate arrays, so the
// interleaving is unrepresentable and both `to_css` and `minify` move trailing declarations in
// front of every nested rule. Since CSS Nesting's nested-declarations rule (Chrome 130+, Firefox
// 132+, Safari 18.2+, lightningcss) trailing declarations keep their place in the cascade:
// `.a{@media (min-width:600px){color:red} color:blue}` is BLUE on wide screens in browsers and in
// lightningcss output (`.a{@media (min-width:600px){color:red}color:#00f}`); Pion's minify prints
// `.a{color:blue;@media (min-width:600px){color:red}}` which is RED.
// ===========================================================================

///|
test "p0_nesting_trailing_declaration_hoisted_by_minify" {
  let out = mini(".a{ @media (min-width:600px) { color: red } color: blue }")
  let i_media = index_of(out, "@media")
  let i_blue = index_of(out, "color:blue")
  debug_assert(
    i_media >= 0 && i_blue > i_media,
    "minify must keep `color:blue` after the nested @media (lightningcss: .a{@media (min-width:600px){color:red}color:#00f}); got " +
    out,
  )
}

///|
test "p0_nesting_trailing_declaration_hoisted_by_to_css" {
  let out = pretty(".a{ :is(&) { color: red } color: blue }")
  let i_rule = index_of(out, ":is(&)")
  let i_blue = index_of(out, "color: blue")
  debug_assert(
    i_rule >= 0 && i_blue > i_rule,
    "to_css must keep `color: blue` after the nested `:is(&)` rule (same specificity; order decides); got " +
    out,
  )
}

// ===========================================================================
// F-2 (P0) minify deletes the descendant combinator before `:` inside any parenthesised selector:
// `minify_prelude` treats Colon as "tight" whenever paren_depth > 0, so `:is(div :hover)` (any
// hovered element inside a div) becomes `:is(div:hover)` (a hovered div). Same for :not / :where /
// :has / @supports selector(). lightningcss keeps the space. No error, different elements match.
// ===========================================================================

///|
test "p0_minify_drops_descendant_combinator_in_is_not_where_has" {
  let cases = [
    (":is(div :hover){x:y}", ":is(div :hover)"),
    (":not(a :focus){x:y}", ":not(a :focus)"),
    (":where(.prose :first-child){x:y}", ":where(.prose :first-child)"),
    (":has(a :hover){x:y}", ":has(a :hover)"),
    ("@supports selector(a :hover){a{x:y}}", "selector(a :hover)"),
  ]
  let bad = StringBuilder::new()
  let mut i = 0
  while i < cases.length() {
    let (src, want) = cases[i]
    let out = mini(src)
    if !contains(out, want) {
      bad.write_string(src + " -> " + out + " | ")
    }
    i = i + 1
  }
  debug_assert(bad.to_string() == "", "descendant combinator lost: " + bad.to_string())
}

// ===========================================================================
// F-3 (P1) minify glues tokens: comments are dropped by the tokenizer but the raw declaration
// value keeps them, and `minify_decl_value` re-emits adjacent tokens with nothing in between.
// `1px/**/2px` -> `1px2px` (one dimension with unit `px2px`), `12px/**/Arial` -> `12pxArial`.
// The `+` of a signed number is also stripped without checking the previous token:
// `1px+2px` -> `1px2px`, `z-index:1+2` -> `z-index:12`. CSS Syntax 3 §9 (serialization) requires
// a separator (comment or space) between such token pairs; lightningcss prints `1px 2px`.
// ===========================================================================

///|
test "p1_minify_comment_removal_glues_tokens" {
  let a = mini("a{margin:1px/**/2px}")
  let b = mini("a{font:12px/**/Arial}")
  let c = mini("a{border:1px/*w*/solid/*s*/red}")
  debug_assert(
    !contains(a, "1px2px") && !contains(b, "12pxArial") && !contains(c, "1pxsolidred"),
    "comment removal must not glue tokens: " + a + " / " + b + " / " + c,
  )
}

///|
test "p1_minify_plus_sign_strip_glues_numbers" {
  let a = mini("a{margin:1px+2px}")
  let b = mini("a{z-index:1+2}")
  debug_assert(
    a != "a{margin:1px2px}" && b != "a{z-index:12}",
    "stripping `+` must not merge numbers: " + a + " / " + b,
  )
}

// ===========================================================================
// F-4 (P1) minify rewrites `0px` -> `0` inside math functions it does not know. Only
// calc/min/max/clamp are whitelisted; round/mod/rem/abs/sign/hypot/atan2/calc-size and the prefixed
// -webkit-calc/-moz-calc are not, and a unit-less 0 makes `<length> + <number>` a type error, so the
// whole declaration becomes invalid at computed-value time (lightningcss: round(0px + 10px, 1px)
// -> 10px; Pion: round(0 + 10px,1px) -> invalid).
// ===========================================================================

///|
test "p1_minify_zero_unit_in_unlisted_math_functions" {
  let cases = [
    "a{width:round(0px + 10px, 1px)}", "a{width:abs(0px - 5px)}", "a{width:mod(0px + 7px, 5px)}",
    "a{width:rem(0px + 7px, 5px)}", "a{width:sign(0px - 1px)}", "a{width:hypot(0px, 3px)}",
    "a{width:-webkit-calc(100% - 0px)}", "a{width:-moz-calc(0px + 10px)}", "a{height:calc-size(auto, size + 0px)}",
  ]
  let bad = StringBuilder::new()
  let mut i = 0
  while i < cases.length() {
    let out = mini(cases[i])
    let zero_without_unit = contains(out, "(0 ") ||
    contains(out, "(0,") ||
    contains(out, ",0 ") ||
    contains(out, ",0,") ||
    contains(out, "- 0)") ||
    contains(out, "+ 0)")
    if zero_without_unit {
      bad.write_string(out + " | ")
    }
    i = i + 1
  }
  debug_assert(bad.to_string() == "", "0px must stay 0px inside math functions: " + bad.to_string())
}

// ===========================================================================
// F-5 (P1) minify corrupts escaped units: the number part is cut with `raw.length() - unit.length()`
// where `unit` is the DECODED unit, so `1\70 x` (= 1px) becomes `1\70px` (= 1 + unit `ppx`), and a
// second minify pass corrupts it again (`1\7ppx`): non-idempotent, wrong value.
// ===========================================================================

///|
test "p1_minify_escaped_unit_corrupted" {
  let u1 = unit_after_minify("a{width:1\\70 x}")
  let u2 = unit_after_minify("a{width:1p\\78}")
  debug_assert(u1 == "px" && u2 == "px", "escaped unit must still be px after minify: " + u1 + " / " + u2)
}

// ===========================================================================
// F-6 (P1) Custom property whose value contains a {}-block is parsed as a nested qualified rule:
// `--x:{a;b}` -> rule with prelude `--x:`, the value (and !important) is lost and minify prints
// `--x:{}`. CSS Syntax 3 "consume a declaration" keeps {}-blocks in custom property values
// (cssparser: DECL --x = `{a;b}`, lightningcss: `--x:{a;b}`).
// ===========================================================================

///|
test "p1_custom_property_block_value_becomes_nested_rule" {
  let q = first_rule(".a{--x:{a;b}; color:red}")
  let mut found = ""
  let mut i = 0
  while i < q.declarations.length() {
    if q.declarations[i].name == "--x" {
      found = q.declarations[i].value
    }
    i = i + 1
  }
  debug_assert(
    found == "{a;b}" && q.nested_rules.length() == 0,
    "--x must be a declaration with value {a;b}; got value=`" +
    found +
    "`, nested_rules=" +
    q.nested_rules.length().to_string() +
    ", minify=" +
    mini(".a{--x:{a;b}; color:red}"),
  )
}

///|
test "p1_custom_property_block_value_loses_important" {
  let q = first_rule(".a{--x:{a:b} !important}")
  let ok = q.declarations.length() == 1 && q.declarations[0].important
  debug_assert(ok, "--x:{a:b} !important must stay an important declaration; minify=" + mini(".a{--x:{a:b} !important}"))
}

// ===========================================================================
// F-7 (P1) `u+<hex>` is tokenized as a unicode-range token. CSS Syntax 3 removed <unicode-range-token>
// (2019); cssparser and css-tree both emit ident `u`, delim `+`, ident `a`. Consequences: the
// selector `u+a` (an <a> right after a <u>) gets specificity (0,0,0) instead of (0,0,2), `.u+a`
// loses its class, `u+b > i` is (0,0,1) instead of (0,0,3).
// ===========================================================================

///|
test "p1_unicode_range_token_breaks_u_plus_selectors" {
  let t = toks("u+a")
  let s1 = spec("u+a")
  let s2 = spec(".u+a")
  let s3 = spec("u+b > i")
  debug_assert(
    t == "I(u)D(+)I(a)" && s1 == "0,0,2" && s2 == "0,1,1" && s3 == "0,0,3",
    "tokens=" + t + " spec(u+a)=" + s1 + " spec(.u+a)=" + s2 + " spec(u+b > i)=" + s3,
  )
}

// ===========================================================================
// F-8 (P1) Top-level error recovery differs from CSS Syntax 3: at top level `;` and `}` do not end a
// qualified-rule prelude, so `a; b{color:red}` is ONE rule with the (invalid) selector `a; b` that
// browsers drop. Pion discards `a` and keeps a valid-looking `b{color:red}` (cssparser prelude:
// `a; b`). Same for stray `}` (`}a{x:y}`) and for the rule list of a top-level @media, where Pion
// also accepts bare declarations that are invalid there.
// ===========================================================================

///|
test "p1_top_level_semicolon_and_brace_recovery" {
  let a = first_rule("a; b{color:red}").prelude
  let b = first_rule("}a{x:y}").prelude
  let c = first_rule("color:red; b{x:y}").prelude
  debug_assert(
    a == "a; b" && b == "}a" && c == "color:red; b",
    "cssparser preludes: `a; b`, `}a`, `color:red; b`; Pion: `" + a + "`, `" + b + "`, `" + c + "`",
  )
}

///|
test "p1_top_level_media_accepts_bare_declarations" {
  let out = mini("@media screen { color: red; b{x:y} }")
  debug_assert(!contains(out, "color:red"), "bare declaration in top-level @media must not survive: " + out)
}

// ===========================================================================
// F-9 (P1) Default limits reject whole, legitimate stylesheets (fail-closed, no partial result):
// (a) max_tokens 2,000,000 counts whitespace tokens, so a realistic 5.5 MB utility stylesheet
//     (45,000 small components) fails parse/minify/tokenize with "token limit exceeded";
//     cssparser, lightningcss and css-tree parse it.
// (b) max_depth 256 counts ( [ and functions, so one 300-deep value anywhere rejects the entire
//     sheet; cssparser/lightningcss/css-tree keep every other rule.
// ===========================================================================

///|
test "p1_default_max_tokens_rejects_realistic_5mb_sheet" {
  let sb = StringBuilder::with_capacity(6000000)
  let mut i = 0
  while i < 45000 {
    let s = i.to_string()
    sb.write_string(".c" + s + "{display:flex;margin:0px auto;padding:.5rem 1rem;color:#fff}\n")
    sb.write_string("@media (min-width:768px){.md\\:c" + s + "{width:calc(100% - 2rem)}}\n")
    i = i + 1
  }
  let r = match css::parse_stylesheet(sb.to_string()) {
    Ok(s) => "ok " + s.rules.length().to_string()
    Err(e) => "ERR " + e.to_string()
  }
  debug_assert(r == "ok 90000", "5.5 MB realistic sheet must parse with default options: " + r)
}

///|
test "p1_default_max_depth_rejects_entire_sheet" {
  let src = ".ok{color:red} .deep{width:" + repeat("(", 300) + "1px" + repeat(")", 300) + "}"
  let r = match css::parse_stylesheet(src) {
    Ok(s) => "ok " + s.rules.length().to_string()
    Err(e) => "ERR " + e.to_string()
  }
  debug_assert(r == "ok 2", "a deep value must not discard the whole sheet (oracles: 2 rules): " + r)
}

// ===========================================================================
// F-10 (P1) selector_specificity / selector_list_specificity never reject invalid selectors
// (only the empty string). 23 of 93 selectors in struct_diff.py that lightningcss rejects get a
// specificity, e.g. `a..b` (0,1,1), `##a` (1,0,0), `a,` (0,0,1), `{` (0,0,0), `:not()` (0,0,0).
// A caller using it to validate or rank selectors cannot tell garbage from CSS.
// ===========================================================================

///|
test "p1_invalid_selectors_accepted" {
  let bad = [
    "a..b", "a#", "##a", "a,", ",a", "a,,b", ">>a", "a >", "{", "$", "a)", "[a", ":::a", "a:", "::",
    ".1a", "#1a", "a::before.b", ":not()", "a || b",
  ]
  let acc = StringBuilder::new()
  let mut i = 0
  while i < bad.length() {
    let r = match css::selector_list_specificity(bad[i]) {
      Ok(_) => "ok"
      Err(_) => "ERR"
    }
    if r != "ERR" {
      acc.write_string(bad[i] + "=" + spec(bad[i]) + "  ")
    }
    i = i + 1
  }
  debug_assert(acc.to_string() == "", "invalid selectors accepted: " + acc.to_string())
}

// ===========================================================================
// F-11 (P1) Media Queries 4 grammar violations accepted with a wrong meaning:
// `not (a) and (b)` is invalid (<media-not> takes ONE <media-in-parens>) but Pion builds
// Not(And(a,b)); `(100px < width > 50px)` mixes range directions; `screen and (a) or (b)` uses `or`
// after a media type; `print,` yields a second query `all` with no condition, so the list matches
// every medium instead of print only (lightningcss drops it; MQ4: empty/invalid query = `not all`).
// ===========================================================================

///|
test "p1_media_query_grammar_violations_accepted" {
  let bad = ["not (a) and (b)", "(100px < width > 50px)", "(400px <= width >= 100px)", "screen and (a) or (b)"]
  let acc = StringBuilder::new()
  let mut i = 0
  while i < bad.length() {
    match css::parse_media_query_list(bad[i]) {
      Ok(_) => acc.write_string(bad[i] + "  ")
      Err(_) => ()
    }
    i = i + 1
  }
  debug_assert(acc.to_string() == "", "invalid media queries accepted: " + acc.to_string())
}

///|
test "p1_media_query_trailing_comma_matches_all" {
  let r = match css::parse_media_query_list("print,") {
    Ok(l) =>
    if l.length() == 2 && l[1].media_type == "all" {
      match l[1].condition {
        None => "print OR all (matches every medium)"
        Some(_) => "ok"
      }
    } else {
      "ok"
    }
    Err(_) => "ok"
  }
  debug_assert(r == "ok", "`print,` must not become `print, all`: " + r)
}

// ===========================================================================
// F-12 (P1) Legacy (comma) rgb()/hsl() accept forms CSS Color 4 forbids: mixing numbers and
// percentages in legacy rgb(), and unit-less saturation/lightness in legacy hsl(). cssparser-color
// rejects both; browsers drop the declaration. A validator built on parse_color says "valid".
// ===========================================================================

///|
test "p1_color_legacy_syntax_violations_accepted" {
  let a = match css::parse_color("rgb(255, 0%, 0)") {
    Ok(_) => "accepted"
    Err(_) => "ERR"
  }
  let b = match css::parse_color("hsl(0, 100, 50)") {
    Ok(_) => "accepted"
    Err(_) => "ERR"
  }
  debug_assert(a == "ERR" && b == "ERR", "rgb(255, 0%, 0)=" + a + " hsl(0, 100, 50)=" + b)
}

// ===========================================================================
// P2 findings
// ===========================================================================

///| CSS Color 4 `none` components (cssparser-color: rgb(none 0 0) = 0 0 0 1).
test "p2_color_none_keyword_unsupported" {
  let ok = match css::parse_color("rgb(none 0 0)") {
    Ok(c) => c.r == 0 && c.g == 0 && c.b == 0
    Err(_) => false
  }
  debug_assert(ok, "rgb(none 0 0) must parse")
}

///| EOF closes an unclosed function (CSS Syntax 3 §5.4.9); cssparser-color: rgb(1 2 3 -> 1 2 3.
test "p2_color_unclosed_function_rejected" {
  let ok = match css::parse_color("rgb(1 2 3") {
    Ok(c) => c.r == 1 && c.g == 2 && c.b == 3
    Err(_) => false
  }
  debug_assert(ok, "rgb(1 2 3 must parse as rgb(1 2 3)")
}

///| Color 4 spaces parsed by cssparser-color: hwb/lab/lch/oklab/oklch/color().
test "p2_color4_spaces_unsupported" {
  let xs = ["hwb(120 0% 0%)", "lab(50% 40 59.5)", "lch(52.2% 72.2 50)", "oklab(0.4 0.1 0.1)", "oklch(0.6 0.1 200)", "color(srgb 1 0 0)"]
  let acc = StringBuilder::new()
  let mut i = 0
  while i < xs.length() {
    match css::parse_color(xs[i]) {
      Ok(_) => ()
      Err(_) => acc.write_string(xs[i] + "  ")
    }
    i = i + 1
  }
  debug_assert(acc.to_string() == "", "unsupported: " + acc.to_string())
}

///| Custom property values are trimmed (CSS Syntax 3 consume-a-declaration; cssparser `12px`).
test "p2_custom_property_whitespace_not_trimmed" {
  let q = first_rule("a{--x:  12px ;}")
  let v = if q.declarations.length() > 0 { q.declarations[0].value } else { "<none>" }
  debug_assert(v == "12px", "--x value must be `12px`, got `" + v + "`")
}

///| `<!--` / `-->` are only skipped at the top level; inside a block they invalidate the declaration.
test "p2_cdo_inside_block_skipped" {
  let q = first_rule(".a{<!-- color:red}")
  debug_assert(q.declarations.length() == 0, "`<!-- color:red` inside a block is not a declaration (cssparser: none)")
}

///| `-0` keeps its sign (cssparser/css-tree: -0); matters for calc(1/-0) = -infinity.
test "p2_negative_zero_sign_lost" {
  let neg = match css::tokenize("-0") {
    Ok(ts) =>
    match ts[0].kind {
      css::TokenKind::Number(v, _, _) => 1.0 / v < 0.0
      _ => false
    }
    Err(_) => false
  }
  debug_assert(neg, "tokenize(-0) must yield -0.0")
}

///| ::slotted(S) adds the specificity of S (CSS Scoping 1 §3.2.2; lightningcss (0,1,1)).
test "p2_slotted_argument_specificity_ignored" {
  let s = spec("::slotted(.a)")
  debug_assert(s == "0,1,1", "::slotted(.a) must be (0,1,1), got " + s)
}

///| WHATWG Encoding "decode": one U+FFFD per maximal subpart (`E2 82` -> one U+FFFD, as cssparser
///| fed by from_utf8_lossy); tokenize_bytes emits one per byte.
test "p2_tokenize_bytes_not_maximal_subpart" {
  let r = match css::tokenize_bytes(make_bytes([0xE2, 0x82])) {
    Ok(ts) =>
    match ts[0].kind {
      css::TokenKind::Ident(s) => s.length()
      _ => -1
    }
    Err(_) => -2
  }
  debug_assert(r == 3, "truncated E2 82 must decode to ONE U+FFFD (3 bytes), got " + r.to_string() + " bytes")
}

///| minify must be idempotent (3 / 2,114 inputs are not; see F-3, F-5).
test "p2_minify_not_idempotent" {
  let x = mini("a{font:12px/**/Arial}")
  debug_assert(mini(x) == x, "minify(minify(x)) != minify(x): " + x + " -> " + mini(x))
}

// ===========================================================================
// Controls: must PASS (Pion correct; several are places where an oracle is wrong or crashes)
// ===========================================================================

///| CSS Syntax 3 §4.3.9: `-` + `\` + newline does not start an ident. Pion: delim `-` (css-tree agrees);
///| cssparser 0.35 wrongly emits ident `-`, `@-\<nl>` as at-keyword and `#-\<nl>` as an id-hash.
test "control_escape_newline_not_ident_start" {
  let t = toks("-\\\n")
  debug_assert(t == "D(-)D(\\)_", "got " + t)
}

///| 50k nested blocks: Pion returns LimitExceeded; cssparser-based recursion and lightningcss abort
///| with a Rust stack overflow on the same input (scripts/dos.py).
test "control_50k_nested_blocks_clean_error" {
  let ok = match css::parse_stylesheet(repeat("@media all{", 50000) + repeat("}", 50000)) {
    Err(e) => css::css_error_kind_eq(e.kind, css::CssErrorKind::LimitExceeded)
    Ok(_) => false
  }
  debug_assert(ok, "expected LimitExceeded")
}

///| Selectors 4: :has() and :host-context() take their argument's specificity. Pion is right;
///| lightningcss 1.0.0-alpha.72 returns (0,0,0) and (0,1,0).
test "control_has_and_host_context_specificity" {
  let a = spec(":has(> #x)")
  let b = spec(":host-context(#a)")
  let c = spec(":nth-child(2n+1 of #id.foo)")
  let d = spec(":where(#id) :not(.a, #b)")
  debug_assert(a == "1,0,0" && b == "1,1,0" && c == "1,2,0" && d == "1,0,0", a + " " + b + " " + c + " " + d)
}

///| url() edge cases agree with cssparser and css-tree.
test "control_url_and_number_edges" {
  let a = toks("url( a\\29 b )")
  let b = toks("URL(x)")
  let c = toks("url(a b)")
  let d = toks("1e+")
  debug_assert(
    a == "URL(a)b)" && b == "URL(x)" && c == "BADURL" && d == "X(e)D(+)",
    a + " " + b + " " + c + " " + d,
  )
}

///| Strings, urls and comment-looking text inside them survive minify; calc keeps its spaces and units.
test "control_minify_strings_urls_calc_preserved" {
  let a = mini("a{content:\"/* x */\"; background:url(http://a/*b*/)}")
  let b = mini("a{width:calc(100% - 0px); margin:10px -5px}")
  debug_assert(
    a == "a{content:\"/* x */\";background:url(http://a/*b*/)}" &&
    b == "a{width:calc(100% - 0px);margin:10px -5px}",
    a + " / " + b,
  )
}

///| !important variants (comment between, whitespace, upper case) all recognised, as cssparser.
test "control_important_variants" {
  let q = first_rule("a{x:y!/*c*/important; y:z ! important; z:w !IMPORTANT}")
  let ok = q.declarations.length() == 3 &&
  q.declarations[0].important &&
  q.declarations[1].important &&
  q.declarations[2].important
  debug_assert(ok, "all three must be !important")
}

///| 4 MB unclosed comment / string: linear, no crash.
test "control_unclosed_comment_and_string_linear" {
  let a = match css::tokenize("/*" + repeat("a*", 2000000)) {
    Ok(t) => t.length()
    Err(_) => -1
  }
  let b = match css::parse_stylesheet(".a{content:'" + repeat("a", 4000000)) {
    Ok(s) => s.rules.length()
    Err(_) => -1
  }
  debug_assert(a == 0 && b == 1, a.to_string() + " " + b.to_string())
}
