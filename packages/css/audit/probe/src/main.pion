///| Red-team differential probe for `packages/css` (batch, length-framed I/O).
///|
///| Input records: `<len>\n<bytes>` repeated. Output records: `<len>\n<bytes>` repeated.
///|   tok   <in> <out> : `tokenize` canonical dump (one `KIND len:value` item per token)
///|   tokb  <in> <out> : `tokenize_bytes` canonical dump
///|   sheet <in> <out> : `parse_stylesheet` canonical AST dump
///|   decls <in> <out> : `parse_declarations` canonical dump
///|   min   <in> <out> : `minify`
///|   css   <in> <out> : `to_css(parse_stylesheet(..))`
///|   spec  <in> <out> : `selector_list_specificity` -> `a,b,c;a,b,c` or `ERR`
///|   color <in> <out> : `parse_color` -> `r g b a` / `currentcolor` / `ERR`
///|   mq    <in> <out> : `parse_media_query_list` -> number of queries or `ERR`
///|   one   <in> <mode> [reps] : run one mode on the whole file `reps` times (DoS / perf), print a summary

import "css"

///|
fn parse_dec(s : String, start : Int, end : Int) -> Int {
  let mut v = 0
  let mut i = start
  while i < end {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
fn read_records(src : String) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut i = 0
  while i < n {
    let ls = i
    while i < n && src.code_unit_at(i) != 10 {
      i = i + 1
    }
    let len = parse_dec(src, ls, i)
    i = i + 1
    out.push(src.slice(i, i + len))
    i = i + len
  }
  out
}

///|
fn emit(sb : StringBuilder, h : String) -> Unit {
  sb.write_string(h.length().to_string())
  sb.write_byte((10).to_byte())
  sb.write_string(h)
}

///|
fn item(sb : StringBuilder, kind : String, v : String) -> Unit {
  sb.write_string(kind)
  sb.write_byte((32).to_byte())
  sb.write_string(v.length().to_string())
  sb.write_byte((58).to_byte())
  sb.write_string(v)
}

///|
fn flag(b : Bool) -> String {
  if b {
    "1"
  } else {
    "0"
  }
}

///|
fn dump_tokens(toks : Array[css::Token]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < toks.length() {
    match toks[i].kind {
      css::TokenKind::Ident(s) => item(sb, "IDENT", s)
      css::TokenKind::Function(s) => item(sb, "FUNC", s)
      css::TokenKind::AtKeyword(s) => item(sb, "AT", s)
      css::TokenKind::Hash(s, k) =>
      if css::hash_kind_eq(k, css::HashKind::Id) {
        item(sb, "IDHASH", s)
      } else {
        item(sb, "HASH", s)
      }
      css::TokenKind::Str(s) => item(sb, "STR", s)
      css::TokenKind::BadString => item(sb, "BADSTR", "")
      css::TokenKind::Url(s) => item(sb, "URL", s)
      css::TokenKind::BadUrl => item(sb, "BADURL", "")
      css::TokenKind::Delim(s) => item(sb, "DELIM", s)
      css::TokenKind::Number(v, isi, sg) =>
      item(sb, "NUM", flag(sg) + flag(isi) + " " + v.to_string())
      css::TokenKind::Percentage(v, isi, sg) =>
      item(sb, "PCT", flag(sg) + flag(isi) + " " + v.to_string())
      css::TokenKind::Dimension(v, isi, sg, u) =>
      item(sb, "DIM", flag(sg) + flag(isi) + " " + v.to_string() + " " + u)
      css::TokenKind::UnicodeRange(a, b) =>
      item(sb, "URANGE", a.to_string() + "-" + b.to_string())
      css::TokenKind::Whitespace => item(sb, "WS", "")
      css::TokenKind::Cdo => item(sb, "CDO", "")
      css::TokenKind::Cdc => item(sb, "CDC", "")
      css::TokenKind::Colon => item(sb, "COLON", "")
      css::TokenKind::Semicolon => item(sb, "SEMI", "")
      css::TokenKind::Comma => item(sb, "COMMA", "")
      css::TokenKind::LeftSquare => item(sb, "LSQ", "")
      css::TokenKind::RightSquare => item(sb, "RSQ", "")
      css::TokenKind::LeftParen => item(sb, "LPAR", "")
      css::TokenKind::RightParen => item(sb, "RPAR", "")
      css::TokenKind::LeftCurly => item(sb, "LCUR", "")
      css::TokenKind::RightCurly => item(sb, "RCUR", "")
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn dump_decls(sb : StringBuilder, ds : Array[css::Declaration]) -> Unit {
  let mut d = 0
  while d < ds.length() {
    let x = ds[d]
    item(sb, "DECL", x.name)
    item(sb, "VAL", x.value)
    if x.important {
      item(sb, "IMP", "")
    }
    d = d + 1
  }
}

///| Iterative pre-order AST dump: declarations of a block first, then its child rules.
fn dump_sheet(sheet : css::Stylesheet) -> String {
  let sb = StringBuilder::new()
  // stack of (rule, is_close)
  let st_r : Array[css::Rule] = []
  let st_c : Array[Bool] = []
  let mut i = sheet.rules.length() - 1
  while i >= 0 {
    st_r.push(sheet.rules[i])
    st_c.push(false)
    i = i - 1
  }
  while st_r.length() > 0 {
    let r = st_r[st_r.length() - 1]
    let c = st_c[st_c.length() - 1]
    let _ = st_r.pop()
    let _ = st_c.pop()
    if c {
      item(sb, "END", "")
      continue
    }
    match r {
      css::Rule::Qualified(q) => {
        item(sb, "QR", q.prelude)
        dump_decls(sb, q.declarations)
        st_r.push(r)
        st_c.push(true)
        let mut k = q.nested_rules.length() - 1
        while k >= 0 {
          st_r.push(q.nested_rules[k])
          st_c.push(false)
          k = k - 1
        }
      }
      css::Rule::At(a) => {
        item(sb, "AT", a.name)
        item(sb, "PRE", a.prelude)
        if a.has_block {
          dump_decls(sb, a.declarations)
          st_r.push(r)
          st_c.push(true)
          let mut k = a.rules.length() - 1
          while k >= 0 {
            st_r.push(a.rules[k])
            st_c.push(false)
            k = k - 1
          }
        } else {
          item(sb, "STMT", "")
        }
      }
    }
  }
  sb.to_string()
}

///|
fn run_one(mode : String, rec : String) -> String {
  if mode == "tok" {
    match css::tokenize(rec) {
      Ok(t) => dump_tokens(t)
      Err(e) => "ERR " + e.to_string()
    }
  } else if mode == "tokb" {
    match css::tokenize_bytes(rec.to_bytes()) {
      Ok(t) => dump_tokens(t)
      Err(e) => "ERR " + e.to_string()
    }
  } else if mode == "sheet" {
    match css::parse_stylesheet(rec) {
      Ok(s) => dump_sheet(s)
      Err(e) => "ERR " + e.to_string()
    }
  } else if mode == "decls" {
    match css::parse_declarations(rec) {
      Ok(ds) => {
        let sb = StringBuilder::new()
        dump_decls(sb, ds)
        sb.to_string()
      }
      Err(e) => "ERR " + e.to_string()
    }
  } else if mode == "min" {
    match css::minify(rec) {
      Ok(s) => s
      Err(e) => "ERR " + e.to_string()
    }
  } else if mode == "css" {
    match css::parse_stylesheet(rec) {
      Ok(s) => css::to_css(s)
      Err(e) => "ERR " + e.to_string()
    }
  } else if mode == "spec" {
    match css::selector_list_specificity(rec) {
      Ok(l) => {
        let sb = StringBuilder::new()
        let mut i = 0
        while i < l.length() {
          if i > 0 {
            sb.write_byte((59).to_byte())
          }
          sb.write_string(
            l[i].ids.to_string() +
            "," +
            l[i].classes.to_string() +
            "," +
            l[i].elements.to_string(),
          )
          i = i + 1
        }
        sb.to_string()
      }
      Err(_) => "ERR"
    }
  } else if mode == "color" {
    match css::parse_color(rec) {
      Ok(c) =>
      if c.is_current_color {
        "currentcolor"
      } else {
        c.r.to_string() +
        " " +
        c.g.to_string() +
        " " +
        c.b.to_string() +
        " " +
        c.a.to_string()
      }
      Err(_) => "ERR"
    }
  } else if mode == "mq" {
    match css::parse_media_query_list(rec) {
      Ok(l) => l.length().to_string()
      Err(_) => "ERR"
    }
  } else {
    "ERR unknown mode"
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: probe tok|tokb|sheet|decls|min|css|spec|color|mq|one <in> ...")
    return 2
  }
  let mode = args[1]
  let src = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "read failed")
      return 1
    }
  }
  if mode == "one" {
    let sub = args[3]
    let reps = if args.length() > 4 {
      parse_dec(args[4], 0, args[4].length())
    } else {
      1
    }
    let mut total = 0
    let mut r = 0
    while r < reps {
      if sub == "count" {
        match css::count_tokens(src) {
          Ok(c) => total = total + c
          Err(e) => {
            io_println(world, "ERR " + e.to_string())
            return 0
          }
        }
      } else if sub == "tokn" {
        match css::tokenize(src) {
          Ok(t) => total = total + t.length()
          Err(e) => {
            io_println(world, "ERR " + e.to_string())
            return 0
          }
        }
      } else if sub == "parse" {
        match css::parse_stylesheet(src) {
          Ok(s) => total = total + s.rules.length()
          Err(e) => {
            io_println(world, "ERR " + e.to_string())
            return 0
          }
        }
      } else {
        let o = run_one(sub, src)
        if o.length() >= 3 && o.slice(0, 3) == "ERR" {
          io_println(world, o)
          return 0
        }
        total = total + o.length()
      }
      r = r + 1
    }
    io_println(world, "ok " + total.to_string())
    return 0
  }
  let out_path = args[3]
  let recs = read_records(src)
  let out = StringBuilder::with_capacity(src.length() * 2 + 64)
  let mut i = 0
  while i < recs.length() {
    emit(out, run_one(mode, recs[i]))
    i = i + 1
  }
  match fs_write(world, out_path, out.to_string()) {
    Ok(_) => 0
    Err(_) => {
      io_eprintln(world, "write failed")
      1
    }
  }
}
