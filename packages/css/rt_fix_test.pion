///| Regression tests for Wave 8 red-team fixes (P0/P1/P2 + single-pass streaming parse/minify).

///|
test "rt_fix__p0_nesting_order_preserved_in_to_css_and_minify" {
  let src = ".a { color: green; @media (min-width: 600px) { color: red } color: blue; &:hover { opacity: 0.5 } margin: 0px; }"
  match parse_stylesheet(src) {
    Ok(sheet) => {
      let css = to_css(sheet)
      let i_green = css.contains("color: green")
      let i_blue = css.contains("color: blue")
      debug_assert(i_green && i_blue, "both declarations present")
      // Verify exact source ordering in minified output
      let min_ast = minify_stylesheet(sheet)
      let min_stream = match minify(src) {
        Ok(s) => s
        Err(e) => {
          debug_assert(false, "minify failed: " + e.to_string())
          ""
        }
      }
      debug_assert(
        min_ast == min_stream,
        "AST minify and streaming minify must match:\n  ast=" + min_ast + "\n  str=" + min_stream,
      )
      debug_assert(
        min_stream == ".a{color:green;@media (min-width:600px){color:red}color:blue;&:hover{opacity:.5}margin:0}",
        "unexpected minified nesting order: " + min_stream,
      )
    }
    Err(e) => debug_assert(false, "parse failed: " + e.to_string())
  }
}

///|
test "rt_fix__p0_descendant_combinator_and_attr_matcher_in_minify" {
  let cases = [
    (":is(div :hover){x:y}", ":is(div :hover){x:y}"),
    (":not(a :focus){x:y}", ":not(a :focus){x:y}"),
    (":where(.prose :first-child){x:y}", ":where(.prose :first-child){x:y}"),
    (":has(a :hover){x:y}", ":has(a :hover){x:y}"),
    ("@supports selector(a :hover){a{x:y}}", "@supports selector(a :hover){a{x:y}}"),
    ("[class ~= x]{x:y}", "[class~= x]{x:y}"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (src, want) = cases[i]
    match minify(src) {
      Ok(got) => debug_assert(got == want, "minify(" + src + ") = " + got + ", want " + want)
      Err(e) => debug_assert(false, "minify err: " + e.to_string())
    }
    i = i + 1
  }
}

///|
test "rt_fix__p1_minify_separation_math_zero_and_escaped_units" {
  // P1-1: no token gluing on comment removal or '+' strip
  match minify("a{margin:1px/**/2px;font:12px/**/Arial;z-index:1+2;padding:1px+2px}") {
    Ok(s) => {
      debug_assert(s == "a{margin:1px 2px;font:12px Arial;z-index:1 2;padding:1px 2px}", "got " + s)
      match minify(s) {
        Ok(s2) => debug_assert(s2 == s, "must be idempotent: " + s2)
        Err(e) => debug_assert(false, e.to_string())
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }
  // P1-2: preserve 0px inside math functions, flex, line-height, and var()
  match minify("a{width:round(0px + 10px, 1px);height:abs(0px - 5px);flex:0 0 0px;margin:0px}") {
    Ok(s) =>
    debug_assert(
      s == "a{width:round(0px + 10px,1px);height:abs(0px - 5px);flex:0 0 0px;margin:0}",
      "got " + s,
    )
    Err(e) => debug_assert(false, e.to_string())
  }
  // P1-3: escaped units preserved and idempotent
  match minify("a{width:1\\70 x;height:1p\\78}") {
    Ok(s) => {
      debug_assert(s == "a{width:1px;height:1px}", "got " + s)
      match minify(s) {
        Ok(s2) => debug_assert(s2 == s, "idempotent: " + s2)
        Err(e) => debug_assert(false, e.to_string())
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///|
test "rt_fix__p1_custom_prop_block_and_top_level_recovery" {
  // P1-4: custom property with {} block & !important
  match parse_stylesheet(".a{--x:{a;b} !important; --ws:   !important; color:red}") {
    Ok(sheet) =>
    match sheet.rules[0] {
      Rule::Qualified(q) => {
        debug_assert(q.declarations.length() == 3, "expected 3 decls")
        debug_assert(q.nested_rules.length() == 0, "expected 0 nested rules")
        debug_assert(q.declarations[0].name == "--x" && q.declarations[0].value == "{a;b}" && q.declarations[0].important, "--x decl")
        debug_assert(q.declarations[1].name == "--ws" && q.declarations[1].value == " " && q.declarations[1].important, "--ws decl")
      }
      _ => debug_assert(false, "expected Qualified")
    }
    Err(e) => debug_assert(false, e.to_string())
  }
  // P1-6: top-level recovery & top-level @media rejects bare declarations
  match parse_stylesheet("a; b{color:red}") {
    Ok(sheet) =>
    match sheet.rules[0] {
      Rule::Qualified(q) => debug_assert(q.prelude == "a; b", "prelude: " + q.prelude)
      _ => debug_assert(false, "expected Qualified")
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///|
test "rt_fix__p1_selectors_mq_color_and_p2_fixes" {
  // P1-8 & P2-7: invalid selectors rejected, ::slotted(.a) = (0,1,1)
  match selector_specificity("a..b") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "a..b must be rejected")
  }
  match selector_specificity("::slotted(.a)") {
    Ok(sp) => debug_assert(sp.eq(Specificity::new(0, 1, 1)), "::slotted(.a) = (0,1,1)")
    Err(e) => debug_assert(false, e.to_string())
  }
  // P1-9: invalid MQ4 rejected
  match parse_media_query_list("not (a) and (b)") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "not (a) and (b) must be rejected")
  }
  match parse_media_query_list("(100px < width > 50px)") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "mixed range must be rejected")
  }
  match parse_media_query_list("print,") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "trailing comma must be rejected")
  }
  // P1-10 & P2-1..3: color validation & Color 4 spaces
  match parse_color("rgb(255, 0%, 0)") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "legacy mixed rgb must be rejected")
  }
  match parse_color("hsl(0, 100, 50)") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "legacy unitless hsl must be rejected")
  }
  match parse_color("rgb(none 0 0)") {
    Ok(c) => debug_assert(c.r == 0 && c.g == 0 && c.b == 0, "rgb none")
    Err(e) => debug_assert(false, e.to_string())
  }
  match parse_color("hwb(120 0% 0%)") {
    Ok(c) => debug_assert(c.r == 0 && c.g == 255 && c.b == 0, "hwb green")
    Err(e) => debug_assert(false, e.to_string())
  }
  match parse_color("color(srgb 1 0 0)") {
    Ok(c) => debug_assert(c.r == 255 && c.g == 0 && c.b == 0, "color(srgb 1 0 0)")
    Err(e) => debug_assert(false, e.to_string())
  }
  // P2-6: -0 preserves negative sign
  match tokenize("-0") {
    Ok(ts) =>
    match ts[0].kind {
      TokenKind::Number(v, _, _) => debug_assert(1.0 / v < 0.0, "-0 sign preserved")
      _ => debug_assert(false, "expected Number")
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}
