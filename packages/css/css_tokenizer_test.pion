///| W3C CSS Syntax Level 3 tokenizer compliance test suite.

fn assert_tokens(name : String, src : String, expected : Array[TokenKind]) -> Unit {
  match tokenize(src) {
    Ok(actual) => {
      debug_assert(
        actual.length() == expected.length(),
        "[" + name + "] token count mismatch: got " + actual.length().to_string() + ", expected " + expected.length().to_string(),
      )
      let mut i = 0
      while i < expected.length() {
        debug_assert(
          token_kind_eq(actual[i].kind, expected[i]),
          "[" + name + "] token mismatch at index " + i.to_string(),
        )
        i = i + 1
      }
      match count_tokens(src) {
        Ok(cnt) =>
        debug_assert(
          cnt == expected.length(),
          "[" + name + "] count_tokens mismatch: got " + cnt.to_string(),
        )
        Err(e) => debug_assert(false, "[" + name + "] count_tokens error: " + e.to_string())
      }
    }
    Err(e) => debug_assert(false, "[" + name + "] unexpected error: " + e.to_string())
  }
}

///|
test "tokenizer__idents_and_custom_props" {
  assert_tokens("simple-ident", "color", [TokenKind::Ident("color")])
  assert_tokens("hyphen-ident", "-webkit-transform", [TokenKind::Ident("-webkit-transform")])
  assert_tokens("double-hyphen", "--primary-color", [TokenKind::Ident("--primary-color")])
  assert_tokens("underscore-ident", "_foo_123", [TokenKind::Ident("_foo_123")])
  assert_tokens("non-ascii-ident", "字体", [TokenKind::Ident("字体")])
  assert_tokens("lone-hyphen", "-", [TokenKind::Delim("-")])
  assert_tokens("hyphen-digit", "-1", [TokenKind::Number(-1.0, true, true)])
  assert_tokens("double-hyphen-digit", "--1", [TokenKind::Ident("--1")])
}

///|
test "tokenizer__css_escapes" {
  // Hex escape + optional single trailing whitespace
  assert_tokens("hex-escape-space", "\\61 bc", [TokenKind::Ident("abc")])
  assert_tokens("hex-escape-6-digits", "\\000061bc", [TokenKind::Ident("abc")])
  assert_tokens("hex-escape-6-digits-space", "\\000061 bc", [TokenKind::Ident("abc")])
  assert_tokens("hex-escape-two-spaces", "\\61  bc", [
    TokenKind::Ident("a"),
    TokenKind::Whitespace,
    TokenKind::Ident("bc"),
  ])
  // Escaped punctuation
  assert_tokens("escaped-colon", "foo\\:bar", [TokenKind::Ident("foo:bar")])
  assert_tokens("escaped-leading-digit", "\\31 23", [TokenKind::Ident("123")])
  // Invalid code points -> U+FFFD
  assert_tokens("escape-zero", "\\0 ", [TokenKind::Ident("\u{FFFD}")])
  assert_tokens("escape-surrogate-low", "\\D800 ", [TokenKind::Ident("\u{FFFD}")])
  assert_tokens("escape-surrogate-high", "\\DFFF ", [TokenKind::Ident("\u{FFFD}")])
  assert_tokens("escape-overflow", "\\110000 ", [TokenKind::Ident("\u{FFFD}")])
  // Valid non-BMP Unicode escape (U+1F600)
  assert_tokens("escape-emoji", "\\1F600", [TokenKind::Ident("\u{1F600}")])
  // Backslash at EOF in ident -> U+FFFD
  assert_tokens("escape-eof-ident", "foo\\", [TokenKind::Ident("foo\u{FFFD}")])
}

///|
test "tokenizer__functions_and_at_keywords" {
  assert_tokens("function", "rgb(1, 2, 3)", [
    TokenKind::Function("rgb"),
    TokenKind::Number(1.0, true, false),
    TokenKind::Comma,
    TokenKind::Whitespace,
    TokenKind::Number(2.0, true, false),
    TokenKind::Comma,
    TokenKind::Whitespace,
    TokenKind::Number(3.0, true, false),
    TokenKind::RightParen,
  ])
  assert_tokens("at-keyword", "@media", [TokenKind::AtKeyword("media")])
  assert_tokens("at-keyword-escaped", "@\\6d edia", [TokenKind::AtKeyword("media")])
  assert_tokens("at-keyword-vendor", "@-webkit-keyframes", [TokenKind::AtKeyword("-webkit-keyframes")])
  assert_tokens("lone-at", "@", [TokenKind::Delim("@")])
  assert_tokens("at-number", "@123", [TokenKind::Delim("@"), TokenKind::Number(123.0, true, false)])
}

///|
test "tokenizer__hash_tokens" {
  assert_tokens("hash-id", "#header", [TokenKind::Hash("header", HashKind::Id)])
  assert_tokens("hash-id-hyphen", "#-foo", [TokenKind::Hash("-foo", HashKind::Id)])
  assert_tokens("hash-id-double-hyphen", "#--foo", [TokenKind::Hash("--foo", HashKind::Id)])
  assert_tokens("hash-unrestricted-digits", "#123456", [TokenKind::Hash("123456", HashKind::Unrestricted)])
  assert_tokens("hash-unrestricted-hyphen-digit", "#-123", [TokenKind::Hash("-123", HashKind::Unrestricted)])
  assert_tokens("hash-hex-id", "#ff00aa", [TokenKind::Hash("ff00aa", HashKind::Id)])
  assert_tokens("lone-hash", "#", [TokenKind::Delim("#")])
  assert_tokens("hash-space", "# a", [
    TokenKind::Delim("#"),
    TokenKind::Whitespace,
    TokenKind::Ident("a"),
  ])
}

///|
test "tokenizer__strings_and_bad_strings" {
  assert_tokens("double-quoted", "\"hello world\"", [TokenKind::Str("hello world")])
  assert_tokens("single-quoted", "'hello world'", [TokenKind::Str("hello world")])
  assert_tokens("escaped-quote", "\"a\\\"b\"", [TokenKind::Str("a\"b")])
  assert_tokens("line-continuation", "\"hello\\\nworld\"", [TokenKind::Str("helloworld")])
  assert_tokens("line-continuation-crlf", "\"hello\\\r\nworld\"", [TokenKind::Str("helloworld")])
  assert_tokens("unclosed-eof-string", "\"eof", [TokenKind::Str("eof")])
  assert_tokens("backslash-eof-in-string", "\"abc\\", [TokenKind::Str("abc")])
  assert_tokens("string-hex-escape", "\"\\41 \\0 \"", [TokenKind::Str("A\u{FFFD}")])
  // Unescaped newline in string -> BadString, newline NOT consumed
  assert_tokens("bad-string-newline", "\"bad\nok\"", [
    TokenKind::BadString,
    TokenKind::Whitespace,
    TokenKind::Ident("ok"),
    TokenKind::Str(""),
  ])
}

///|
test "tokenizer__urls_and_bad_urls" {
  assert_tokens("unquoted-url", "url(https://example.com/a.png)", [
    TokenKind::Url("https://example.com/a.png"),
  ])
  assert_tokens("unquoted-url-spaces", "url(   foo/bar.svg  )", [
    TokenKind::Url("foo/bar.svg"),
  ])
  assert_tokens("unquoted-url-case", "URL(a.png)", [TokenKind::Url("a.png")])
  assert_tokens("unquoted-url-escaped-paren", "url(a\\)b.png)", [TokenKind::Url("a)b.png")])
  assert_tokens("unquoted-url-eof", "url(a.png", [TokenKind::Url("a.png")])
  // Quoted url(...) is Function("url") + Str + RightParen per CSS Syntax 3!
  assert_tokens("quoted-url-double", "url(\"a.png\")", [
    TokenKind::Function("url"),
    TokenKind::Str("a.png"),
    TokenKind::RightParen,
  ])
  assert_tokens("quoted-url-single-ws", "url( 'a.png' )", [
    TokenKind::Function("url"),
    TokenKind::Whitespace,
    TokenKind::Str("a.png"),
    TokenKind::Whitespace,
    TokenKind::RightParen,
  ])
  // BadUrl cases
  assert_tokens("bad-url-space-inside", "url(a b)", [TokenKind::BadUrl])
  assert_tokens("bad-url-quote", "url(a\"b)", [TokenKind::BadUrl])
  assert_tokens("bad-url-lparen", "url(a(b)", [TokenKind::BadUrl])
  assert_tokens("bad-url-newline", "url(a\nb)", [TokenKind::BadUrl])
  assert_tokens("bad-url-recovery", "url(a b) color", [
    TokenKind::BadUrl,
    TokenKind::Whitespace,
    TokenKind::Ident("color"),
  ])
}

///|
test "tokenizer__numbers_percentages_dimensions" {
  assert_tokens("int", "42", [TokenKind::Number(42.0, true, false)])
  assert_tokens("signed-int", "+42 -7", [
    TokenKind::Number(42.0, true, true),
    TokenKind::Whitespace,
    TokenKind::Number(-7.0, true, true),
  ])
  assert_tokens("float-dot", ".5 -.25 +0.75", [
    TokenKind::Number(0.5, false, false),
    TokenKind::Whitespace,
    TokenKind::Number(-0.25, false, true),
    TokenKind::Whitespace,
    TokenKind::Number(0.75, false, true),
  ])
  assert_tokens("scientific", "1e3 2.5E-2 +1e+1", [
    TokenKind::Number(1000.0, false, false),
    TokenKind::Whitespace,
    TokenKind::Number(0.025, false, false),
    TokenKind::Whitespace,
    TokenKind::Number(10.0, false, true),
  ])
  assert_tokens("trailing-dot-not-float", "1.", [
    TokenKind::Number(1.0, true, false),
    TokenKind::Delim("."),
  ])
  assert_tokens("number-followed-by-e-unit", "1e", [
    TokenKind::Dimension(1.0, true, false, "e"),
  ])
  assert_tokens("percentage", "50% -12.5%", [
    TokenKind::Percentage(50.0, true, false),
    TokenKind::Whitespace,
    TokenKind::Percentage(-12.5, false, true),
  ])
  assert_tokens("dimensions", "16px 1.5rem 2em 45deg 250ms 1fr", [
    TokenKind::Dimension(16.0, true, false, "px"),
    TokenKind::Whitespace,
    TokenKind::Dimension(1.5, false, false, "rem"),
    TokenKind::Whitespace,
    TokenKind::Dimension(2.0, true, false, "em"),
    TokenKind::Whitespace,
    TokenKind::Dimension(45.0, true, false, "deg"),
    TokenKind::Whitespace,
    TokenKind::Dimension(250.0, true, false, "ms"),
    TokenKind::Whitespace,
    TokenKind::Dimension(1.0, true, false, "fr"),
  ])
  assert_tokens("dimension-escaped-unit", "10\\70 x", [
    TokenKind::Dimension(10.0, true, false, "px"),
  ])
}

///|
test "tokenizer__unicode_range" {
  assert_tokens("urange-single", "U+26", [TokenKind::UnicodeRange(0x26, 0x26)])
  assert_tokens("urange-explicit", "U+0025-00FF", [TokenKind::UnicodeRange(0x25, 0xFF)])
  assert_tokens("urange-wildcard", "u+4??", [TokenKind::UnicodeRange(0x400, 0x4FF)])
  assert_tokens("urange-not-range", "U+G", [
    TokenKind::Ident("U"),
    TokenKind::Delim("+"),
    TokenKind::Ident("G"),
  ])
}

///|
test "tokenizer__cdo_cdc_punctuation_comments" {
  assert_tokens("cdo-cdc", "<!-- -->", [
    TokenKind::Cdo,
    TokenKind::Whitespace,
    TokenKind::Cdc,
  ])
  assert_tokens("punctuation", ":;,[](){}", [
    TokenKind::Colon,
    TokenKind::Semicolon,
    TokenKind::Comma,
    TokenKind::LeftSquare,
    TokenKind::RightSquare,
    TokenKind::LeftParen,
    TokenKind::RightParen,
    TokenKind::LeftCurly,
    TokenKind::RightCurly,
  ])
  assert_tokens("comments-split-idents", "foo/* comment */bar", [
    TokenKind::Ident("foo"),
    TokenKind::Ident("bar"),
  ])
  assert_tokens("unclosed-comment-eof", "a /* unclosed", [
    TokenKind::Ident("a"),
    TokenKind::Whitespace,
  ])
}

///|
test "tokenizer__preprocessing_newlines_and_nul" {
  // \r\n, \r, \f (\u{0C}) normalized to \n (Whitespace)
  assert_tokens("newlines-ws", "a\r\nb\rc\u{0C}d", [
    TokenKind::Ident("a"),
    TokenKind::Whitespace,
    TokenKind::Ident("b"),
    TokenKind::Whitespace,
    TokenKind::Ident("c"),
    TokenKind::Whitespace,
    TokenKind::Ident("d"),
  ])
  // NUL -> U+FFFD
  let nul_src = "a\u{0000}b"
  assert_tokens("nul-replacement", nul_src, [TokenKind::Ident("a\u{FFFD}b")])
}
