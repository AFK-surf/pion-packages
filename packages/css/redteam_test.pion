///| Day-1 Red-Team security & robustness test suite for `css`.

fn repeat_str(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///|
test "redteam__50k_nested_braces_iterative_no_sigsegv" {
  let deep = repeat_str("a{", 50000) + repeat_str("}", 50000)
  // Default max_depth (256) must cleanly return LimitExceeded without crashing
  match parse_stylesheet(deep) {
    Err(e) => debug_assert(css_error_kind_eq(e.kind, CssErrorKind::LimitExceeded), "expected LimitExceeded")
    Ok(_) => debug_assert(false, "expected LimitExceeded for 50k nested braces under default max_depth")
  }
  // Tokenizing 50k nested braces succeeds iteratively with 150k tokens and 0 SIGSEGV
  match tokenize(deep) {
    Ok(toks) => debug_assert(toks.length() == 150000, "50k nested braces tokenized")
    Err(e) => debug_assert(false, "50k tokenize failed: " + e.to_string())
  }
  // Deeply nested stylesheet (1000 levels) parses iteratively with 0 SIGSEGV
  let deep_1k = repeat_str("a{", 1000) + repeat_str("}", 1000)
  let high_opts = ParseOptions::{
    max_depth: 2000,
    max_tokens: 500000,
    max_rules: 100000,
  }
  match parse_stylesheet_with_options(deep_1k, high_opts) {
    Ok(sheet) => debug_assert(sheet.rules.length() == 1, "1k nested parsed iteratively")
    Err(e) => debug_assert(false, "1k iterative failed: " + e.to_string())
  }
}

///|
test "redteam__50k_nested_parens_and_media" {
  let deep_parens = ".a { width: " + repeat_str("(", 50000) + "1px" + repeat_str(")", 50000) + "; }"
  match parse_stylesheet(deep_parens) {
    Err(e) => debug_assert(css_error_kind_eq(e.kind, CssErrorKind::LimitExceeded), "parens LimitExceeded")
    Ok(_) => debug_assert(false, "expected LimitExceeded for 50k parens")
  }

  let deep_media = repeat_str("@media all {", 50000) + repeat_str("}", 50000)
  match parse_stylesheet(deep_media) {
    Err(e) => debug_assert(css_error_kind_eq(e.kind, CssErrorKind::LimitExceeded), "media LimitExceeded")
    Ok(_) => debug_assert(false, "expected LimitExceeded for 50k @media")
  }
}

///|
test "redteam__explicit_limits_max_tokens_and_max_rules" {
  let src = repeat_str(".a{color:red;}", 200)
  let tok_opts = ParseOptions::{ max_depth: 64, max_tokens: 50, max_rules: 1000 }
  match tokenize_with_options(src, tok_opts) {
    Err(e) => debug_assert(css_error_kind_eq(e.kind, CssErrorKind::LimitExceeded), "max_tokens LimitExceeded")
    Ok(_) => debug_assert(false, "expected max_tokens LimitExceeded")
  }
  let rule_opts = ParseOptions::{ max_depth: 64, max_tokens: 100000, max_rules: 50 }
  match parse_stylesheet_with_options(src, rule_opts) {
    Err(e) => debug_assert(css_error_kind_eq(e.kind, CssErrorKind::LimitExceeded), "max_rules LimitExceeded")
    Ok(_) => debug_assert(false, "expected max_rules LimitExceeded")
  }
}

///|
test "redteam__50k_unclosed_comments_strings_escapes_linear" {
  // 50k-byte unclosed comment -> single comment to EOF, O(N)
  let comments = "/*" + repeat_str("a", 50000)
  match tokenize(comments) {
    Ok(toks) => debug_assert(toks.length() == 0, "unclosed comment -> 0 tokens")
    Err(e) => debug_assert(false, "comments error: " + e.to_string())
  }
  // 50k repeated `/*` (each adjacent pair forms `*/`) -> O(N)
  let slash_stars = repeat_str("/*", 50000)
  match tokenize(slash_stars) {
    Ok(toks) => debug_assert(toks.length() > 0, "50k /* tokenized in O(N)")
    Err(e) => debug_assert(false, "slash_stars error: " + e.to_string())
  }
  // 50k unclosed strings separated by newlines -> 50k BadString + Whitespace, O(N)
  let bad_strs = repeat_str("\"x\n", 50000)
  match tokenize(bad_strs) {
    Ok(toks) => debug_assert(toks.length() == 100000, "50k bad strings -> 100k tokens")
    Err(e) => debug_assert(false, "bad strings error: " + e.to_string())
  }
  // 50k escapes -> O(N)
  let escapes = repeat_str("\\61 ", 50000)
  match tokenize(escapes) {
    Ok(toks) => {
      debug_assert(toks.length() == 1, "50k escapes -> 1 ident token")
      match toks[0].kind {
        TokenKind::Ident(s) => debug_assert(s.length() == 50000, "ident len 50k")
        _ => debug_assert(false, "expected Ident")
      }
    }
    Err(e) => debug_assert(false, "escapes error: " + e.to_string())
  }
}

fn make_bytes(arr : Array[Int]) -> Bytes {
  let out = Bytes::new(arr.length())
  let mut i = 0
  while i < arr.length() {
    out[i] = arr[i].to_byte()
    i = i + 1
  }
  out
}

///|
test "redteam__nul_and_invalid_utf8_bytes" {
  // Raw bytes containing invalid UTF-8 (0xFF, 0xFE, truncated 2-byte 0xC2, lone continuation 0x80) and NUL (0x00)
  let raw = make_bytes([97, 0, 98, 32, 0xFF, 0xFE, 0xC2, 32, 0x80])
  match tokenize_bytes(raw) {
    Ok(toks) => {
      debug_assert(toks.length() >= 3, "invalid utf8 tokenized safely")
      match toks[0].kind {
        TokenKind::Ident(s) => debug_assert(s == "a\u{FFFD}b", "NUL replaced with U+FFFD")
        _ => debug_assert(false, "expected Ident for a\\0b")
      }
    }
    Err(e) => debug_assert(false, "tokenize_bytes error: " + e.to_string())
  }
  let sheet_bytes = make_bytes([
    46, 120, 0, 123, 99, 111, 108, 111, 114, 58, 114, 101, 100, 59, 125,
  ])
  match parse_stylesheet_bytes(sheet_bytes) {
    Ok(s) => debug_assert(s.rules.length() == 1, "parse_stylesheet_bytes safe")
    Err(e) => debug_assert(false, "parse_stylesheet_bytes error: " + e.to_string())
  }
}

///|
test "redteam__deep_selector_specificity_iterative" {
  let deep_sel = repeat_str(":is(", 2000) + "#a" + repeat_str(")", 2000)
  match selector_specificity(deep_sel) {
    Err(e) => debug_assert(css_error_kind_eq(e.kind, CssErrorKind::LimitExceeded), "deep selector LimitExceeded")
    Ok(_) => debug_assert(false, "expected LimitExceeded for 2000 nested :is()")
  }
}
