///| Preset, `windowBits` (`9..15`), and `Z_FILTERED` auto-selector for LZ77 prediction.

///| Estimate residual byte cost of `(preset, wbits, filtered)` on up to `sample_limit` tokens,
///| reusing `scratch` and aborting early once `cost >= cost_limit`.
fn score_preset_on_block(
  base_state : PredictorState,
  scratch : PredictorState,
  plain : Bytes,
  block_start : Int,
  block_end : Int,
  tokens : FixedArray[Int],
  n_toks : Int,
  preset : Int,
  wbits : Int,
  filtered : Bool,
  sample_limit : Int,
  cost_limit : Int,
) -> Int {
  let lim = if n_toks < sample_limit { n_toks } else { sample_limit }
  let uses_hash = preset_uses_hash(preset)

  if uses_hash {
    pred_copy_into(scratch, base_state)
    pred_catch_up(scratch, plain, block_start, block_end)
  } else {
    scratch.lazy_len = 0
    scratch.lazy_dist = 0
  }

  let good_len = cfg_good_len[preset]
  let max_lazy = cfg_max_lazy[preset]
  let nice_len = cfg_nice_len[preset]
  let max_chain = cfg_max_chain[preset]
  let max_dist = if preset == preset_flate_greedy {
    win_size
  } else {
    zlib_max_dist_for_wbits(wbits)
  }
  let fast_max_ins = if preset_is_zlib_fast(preset) { max_lazy } else { 0 }

  let mut pos = block_start
  let mut cost = 0
  let mut i = 0
  while i < lim {
    let actual = tokens[i]
    let pred = predict_token_cfg(
      scratch, plain, pos, block_end, preset, good_len, max_lazy, nice_len, max_chain, max_dist,
      filtered,
    )
    let matched = actual == pred
    if !matched {
      if !token_is_match(actual) {
        cost = cost + 1
      } else if token_is_alt_258(actual) {
        cost = cost + 3
      } else if token_is_match(pred) && token_match_dist(actual) == token_match_dist(pred) {
        cost = cost + 2
      } else if token_is_match(pred) && token_match_len(actual) == token_match_len(pred) {
        cost = cost + 3
      } else {
        cost = cost + 4
      }
      if cost >= cost_limit {
        scratch.scored_pos = pos
        return cost
      }
    }
    let adv = if token_is_match(actual) { token_match_len(actual) } else { 1 }
    let pass_nll = if matched { scratch.next_lazy_len } else { 0 }
    let pass_nld = if matched { scratch.next_lazy_dist } else { 0 }
    pred_advance_cfg(
      scratch, plain, pos, adv, block_end, uses_hash, fast_max_ins, pass_nll, pass_nld,
    )
    pos = pos + adv
    i = i + 1
  }
  scratch.scored_pos = pos
  cost
}

///| Choose the lowest-residual `(preset, wbits, filtered)` for a Huffman block.
///| Returns `(preset, wbits, filtered, skip_toks, skip_pos)`; when `skip_toks > 0`,
///| `base_state` has already been advanced to `skip_pos` with `skip_toks` zero-residual matches.
fn select_block_preset(
  base_state : PredictorState,
  plain : Bytes,
  block_start : Int,
  block_end : Int,
  tokens : FixedArray[Int],
  n_toks : Int,
  match_count : Int,
  all_dist_one : Bool,
  max_obs_dist : Int,
  min_obs_len : Int,
  cached_preset : Int,
  cached_wbits : Int,
  cached_filtered : Bool,
) -> (Int, Int, Bool, Int, Int) {
  if match_count == 0 {
    return (preset_literals, cached_wbits, cached_filtered, 0, block_start)
  }
  if all_dist_one {
    return (preset_rle, cached_wbits, cached_filtered, 0, block_start)
  }
  if cached_preset >= 0 {
    return (cached_preset, cached_wbits, cached_filtered, 0, block_start)
  }

  let sample_limit = 4096
  let lim = if n_toks < sample_limit { n_toks } else { sample_limit }
  let scratch = PredictorState::new()
  // Test cheap L1 first so L1 streams never pay for L6/L9 scoring, followed by L6 and L9.
  let candidates = [
    preset_zlib_l1,
    preset_zlib_l6,
    preset_zlib_l9,
    preset_zlib_l4,
    preset_zlib_l5,
    preset_zlib_l2,
    preset_zlib_l3,
    preset_zlib_l7,
    preset_zlib_l8,
    preset_flate_greedy,
    preset_rle,
    preset_literals,
  ]
  let mut best_preset = preset_zlib_l6
  let mut best_wbits = 15
  let mut best_filtered = false
  let mut best_cost = 2147483647

  let mut ci = 0
  while ci < candidates.length() {
    let p = candidates[ci]
    let c = score_preset_on_block(
      base_state, scratch, plain, block_start, block_end, tokens, n_toks, p, 15, false,
      sample_limit, best_cost,
    )
    if c < best_cost {
      best_cost = c
      best_preset = p
      if c == 0 {
        if preset_uses_hash(p) {
          pred_swap_in(base_state, scratch)
        }
        return (best_preset, best_wbits, best_filtered, lim, scratch.scored_pos)
      }
    }
    ci = ci + 1
  }

  // Try `Z_FILTERED` slow presets (libpng default when row filters are enabled).
  let slow_candidates = [
    preset_zlib_l6,
    preset_zlib_l9,
    preset_zlib_l4,
    preset_zlib_l5,
    preset_zlib_l7,
    preset_zlib_l8,
  ]
  if min_obs_len >= 6 {
    let mut si = 0
    while si < slow_candidates.length() {
      let p = slow_candidates[si]
      let c = score_preset_on_block(
        base_state, scratch, plain, block_start, block_end, tokens, n_toks, p, 15, true,
        sample_limit, best_cost,
      )
      if c < best_cost {
        best_cost = c
        best_preset = p
        best_wbits = 15
        best_filtered = true
        if c == 0 {
          pred_swap_in(base_state, scratch)
          return (best_preset, best_wbits, best_filtered, lim, scratch.scored_pos)
        }
      }
      si = si + 1
    }
  }

  // Try smaller `windowBits` (`9..14`) when all observed match distances fit in a smaller window.
  let mut min_wb = 9
  while min_wb <= 14 && zlib_max_dist_for_wbits(min_wb) < max_obs_dist {
    min_wb = min_wb + 1
  }
  if min_wb <= 14 {
    let zlib_all = [
      preset_zlib_l1,
      preset_zlib_l6,
      preset_zlib_l9,
      preset_zlib_l4,
      preset_zlib_l5,
      preset_zlib_l2,
      preset_zlib_l3,
      preset_zlib_l7,
      preset_zlib_l8,
    ]
    let mut wb = min_wb
    while wb <= 14 {
      let mut zi = 0
      while zi < zlib_all.length() {
        let p = zlib_all[zi]
        let c = score_preset_on_block(
          base_state, scratch, plain, block_start, block_end, tokens, n_toks, p, wb, false,
          sample_limit, best_cost,
        )
        if c < best_cost {
          best_cost = c
          best_preset = p
          best_wbits = wb
          best_filtered = false
          if c == 0 {
            pred_swap_in(base_state, scratch)
            return (best_preset, best_wbits, best_filtered, lim, scratch.scored_pos)
          }
        }
        zi = zi + 1
      }
      if min_obs_len >= 6 {
        let mut si = 0
        while si < slow_candidates.length() {
          let p = slow_candidates[si]
          let c = score_preset_on_block(
            base_state, scratch, plain, block_start, block_end, tokens, n_toks, p, wb, true,
            sample_limit, best_cost,
          )
          if c < best_cost {
            best_cost = c
            best_preset = p
            best_wbits = wb
            best_filtered = true
            if c == 0 {
              pred_swap_in(base_state, scratch)
              return (best_preset, best_wbits, best_filtered, lim, scratch.scored_pos)
            }
          }
          si = si + 1
        }
      }
      wb = wb + 1
    }
  }

  (best_preset, best_wbits, best_filtered, 0, block_start)
}
