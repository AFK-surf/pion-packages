///| Incremental RFC 1951 DEFLATE stream parser, analyzer, and parse-only wrapper inflater.

///| Grow `buf` to at least `needed` bytes (clamped to `max_cap`), preserving `used` bytes.
fn grow_plain_buf(buf : Bytes, used : Int, needed : Int, max_cap : Int) -> Bytes {
  let mut new_cap = buf.length()
  if new_cap == 0 {
    new_cap = 256
    if new_cap > max_cap {
      new_cap = max_cap
    }
  }
  while new_cap < needed {
    if new_cap > max_cap / 2 {
      new_cap = max_cap
      break
    }
    new_cap = new_cap * 2
  }
  if new_cap < needed {
    new_cap = needed
  }
  if used == 0 {
    return Bytes::new(new_cap)
  }
  // Use Bytes::concat for buffers <= 32 MiB to leverage fast copy; avoid 2x temporary peak above 32 MiB.
  if new_cap <= 33554432 {
    let pad = Bytes::new(new_cap - used)
    if used == buf.length() {
      return buf.concat(pad)
    }
    return buf.slice(0, used).concat(pad)
  }
  let mut next = Bytes::new(new_cap)
  let mut i = 0
  while i < used {
    next[i] = buf[i]
    i = i + 1
  }
  next
}

///| Decode a single Huffman symbol from `br` using a 2-level LUT.
fn decode_huff_sym(
  br : BitReader,
  lut : FixedArray[Int],
  root_bits : Int,
  root_mask : UInt64,
) -> Result[Int, String] {
  br_refill_max(br)
  let entry = lut[(br.bitbuf & root_mask).to_int()]
  if entry == 0 {
    return Err("invalid Huffman code")
  }
  if (entry & 16) == 0 {
    let bits = entry & 15
    if br.bitcnt < bits {
      return Err("unexpected EOF in Huffman symbol")
    }
    br.bitbuf = br.bitbuf >> bits
    br.bitcnt = br.bitcnt - bits
    return Ok(entry >> 5)
  }
  if br.bitcnt <= root_bits {
    return Err("unexpected EOF in Huffman subtable")
  }
  let sub_off = entry >> 5
  let sub_bits = entry & 15
  let sub_mask = (1UL << sub_bits) - 1UL
  let sub_entry = lut[sub_off + ((br.bitbuf >> root_bits) & sub_mask).to_int()]
  if sub_entry == 0 {
    return Err("invalid Huffman code in subtable")
  }
  let extra_len = sub_entry & 15
  let total_bits = root_bits + extra_len
  if br.bitcnt < total_bits {
    return Err("unexpected EOF in Huffman subtable symbol")
  }
  br.bitbuf = br.bitbuf >> total_bits
  br.bitcnt = br.bitcnt - total_bits
  Ok(sub_entry >> 5)
}

///| Parse a dynamic Huffman block header from `br` and populate decode LUTs.
fn parse_dynamic_header(
  br : BitReader,
  cl_lut : FixedArray[Int],
  cl_lens : FixedArray[Int],
  code_lens : FixedArray[Int],
  litlen_lens : FixedArray[Int],
  dist_lens : FixedArray[Int],
  dyn_litlen_lut : FixedArray[Int],
  dyn_dist_lut : FixedArray[Int],
  rle_syms : Array[Int],
  rle_extra : Array[Int],
  record_rle : Bool,
) -> Result[(Int, Int, Int), String] {
  let dhdr = match br_read_bits(br, 14) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let hlit = (dhdr & 31) + 257
  let hdist = ((dhdr >> 5) & 31) + 1
  let hclen = ((dhdr >> 10) & 15) + 4
  if hlit > 286 || hdist > 32 {
    return Err("dynamic Huffman HLIT > 286 or HDIST > 32")
  }
  let mut ci = 0
  while ci < 19 {
    cl_lens[ci] = 0
    ci = ci + 1
  }
  ci = 0
  while ci < hclen {
    let lv = match br_read_bits(br, 3) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    cl_lens[cl_order[ci]] = lv
    ci = ci + 1
  }
  match build_decode_lut(cl_lens, 19, cl_lut, cl_root_bits, false) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }

  let total_codes = hlit + hdist
  let mut idx = 0
  while idx < total_codes {
    let csym = match decode_huff_sym(br, cl_lut, cl_root_bits, cl_root_mask) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if csym < 16 {
      code_lens[idx] = csym
      idx = idx + 1
      if record_rle {
        rle_syms.push(csym)
        rle_extra.push(0)
      }
    } else if csym == 16 {
      if idx == 0 {
        return Err("code-length repeat 16 at index 0")
      }
      let ex = match br_read_bits(br, 2) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let rep = ex + 3
      if rep > total_codes - idx {
        return Err("code-length repeat 16 exceeds HLIT + HDIST")
      }
      let prev = code_lens[idx - 1]
      let mut r = 0
      while r < rep {
        code_lens[idx] = prev
        idx = idx + 1
        r = r + 1
      }
      if record_rle {
        rle_syms.push(16)
        rle_extra.push(ex)
      }
    } else if csym == 17 {
      let ex = match br_read_bits(br, 3) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let rep = ex + 3
      if rep > total_codes - idx {
        return Err("code-length repeat 17 exceeds HLIT + HDIST")
      }
      let mut r = 0
      while r < rep {
        code_lens[idx] = 0
        idx = idx + 1
        r = r + 1
      }
      if record_rle {
        rle_syms.push(17)
        rle_extra.push(ex)
      }
    } else if csym == 18 {
      let ex = match br_read_bits(br, 7) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let rep = ex + 11
      if rep > total_codes - idx {
        return Err("code-length repeat 18 exceeds HLIT + HDIST")
      }
      let mut r = 0
      while r < rep {
        code_lens[idx] = 0
        idx = idx + 1
        r = r + 1
      }
      if record_rle {
        rle_syms.push(18)
        rle_extra.push(ex)
      }
    } else {
      return Err("invalid code-length symbol")
    }
  }

  if code_lens[256] == 0 {
    return Err("dynamic Huffman tree missing EOB symbol 256")
  }
  let mut i = 0
  while i < hlit {
    litlen_lens[i] = code_lens[i]
    i = i + 1
  }
  while i < 288 {
    litlen_lens[i] = 0
    i = i + 1
  }
  i = 0
  while i < hdist {
    dist_lens[i] = code_lens[hlit + i]
    i = i + 1
  }
  while i < 32 {
    dist_lens[i] = 0
    i = i + 1
  }
  match build_decode_lut(litlen_lens, hlit, dyn_litlen_lut, litlen_root_bits, false) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  match build_decode_lut(dist_lens, hdist, dyn_dist_lut, dist_root_bits, true) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  Ok((hlit, hdist, hclen))
}

///| Grow a reusable `FixedArray[Int]` token buffer by doubling, preserving `used` entries.
fn grow_tok_buf(buf : FixedArray[Int], used : Int) -> FixedArray[Int] {
  let next_cap = buf.length() * 2
  let next : FixedArray[Int] = FixedArray::make(next_cap, 0)
  let mut i = 0
  let lim4 = used - 4
  while i <= lim4 {
    next[i] = buf[i]
    next[i + 1] = buf[i + 1]
    next[i + 2] = buf[i + 2]
    next[i + 3] = buf[i + 3]
    i = i + 4
  }
  while i < used {
    next[i] = buf[i]
    i = i + 1
  }
  next
}

///| Parse and incrementally encode a raw RFC 1951 DEFLATE stream with explicit `plain_limit` and `max_corr_raw`.
fn analyze_stream_with_caps(
  deflate : Bytes,
  plain_limit : Int,
  max_corr_raw : Int,
) -> Result[PreflateResult, String] {
  if plain_limit < 0 {
    return Err("plain limit must be non-negative")
  }
  let br = BitReader::new(deflate)
  let corr_w = ByteWriter::new_capped(256, max_corr_raw)
  let pred_state = PredictorState::new()
  let mut cached_preset = -1
  let mut cached_wbits = 15
  let mut cached_filtered = false

  let mut out = Bytes::new(0)
  let mut out_len = 0
  let mut out_cap = 0

  let dyn_litlen_lut : FixedArray[Int] = FixedArray::make(4096, 0)
  let dyn_dist_lut : FixedArray[Int] = FixedArray::make(2048, 0)
  let cl_lut : FixedArray[Int] = FixedArray::make(128, 0)
  let cl_lens : FixedArray[Int] = FixedArray::make(19, 0)
  let code_lens : FixedArray[Int] = FixedArray::make(320, 0)
  let litlen_lens : FixedArray[Int] = FixedArray::make(288, 0)
  let dist_lens : FixedArray[Int] = FixedArray::make(32, 0)
  let lit_freqs : FixedArray[Int] = FixedArray::make(286, 0)
  let dist_freqs : FixedArray[Int] = FixedArray::make(30, 0)
  let mut tok_buf : FixedArray[Int] = FixedArray::make(32768, 0)
  let mut tok_cap = 32768

  let mut bfinal = false
  while !bfinal {
    if corr_w.overflow {
      return Err("corrections payload exceeded maximum size")
    }
    let hdr = match br_read_bits(br, 3) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    bfinal = (hdr & 1) != 0
    let btype = (hdr >> 1) & 3
    if btype == 3 {
      return Err("invalid DEFLATE block type 3")
    }

    if btype == 0 {
      let pad_bits = br_align_byte(br)
      let slen = match br_read_u16_le(br) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let nlen = match br_read_u16_le(br) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if (slen ^ nlen) != 0xFFFF {
        return Err("invalid stored block NLEN != ~LEN")
      }
      if slen > br.in_len - br.in_pos {
        return Err("truncated stored block payload")
      }
      if slen > plain_limit - out_len {
        return Err("decoded plain text exceeded plain_limit")
      }
      if slen > 0 {
        if out_len + slen > out_cap {
          out = grow_plain_buf(out, out_len, out_len + slen, plain_limit)
          out_cap = out.length()
        }
        let mut k = 0
        while k < slen {
          out[out_len + k] = deflate[br.in_pos + k]
          k = k + 1
        }
        br.in_pos = br.in_pos + slen
        out_len = out_len + slen
      }
      encode_stored_block(corr_w, bfinal, pad_bits, slen)
      continue
    }

    let mut cur_litlen = fixed_litlen_lut
    let mut cur_dist = fixed_dist_lut
    let mut hlit = 0
    let mut hdist = 0
    let mut hclen = 0
    let rle_syms : Array[Int] = []
    let rle_extra : Array[Int] = []

    if btype == 2 {
      let (hl, hd, hc) = match parse_dynamic_header(
        br,
        cl_lut,
        cl_lens,
        code_lens,
        litlen_lens,
        dist_lens,
        dyn_litlen_lut,
        dyn_dist_lut,
        rle_syms,
        rle_extra,
        true,
      ) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      hlit = hl
      hdist = hd
      hclen = hc
      cur_litlen = dyn_litlen_lut
      cur_dist = dyn_dist_lut
    }

    let block_plain_start = out_len
    let mut tok_cnt = 0
    let mut match_count = 0
    let mut all_dist_one = true
    let mut max_obs_dist = 0
    let mut min_obs_len = 259

    let le = len_extra
    let lb = len_base
    let de = dist_extra
    let db = dist_base
    let in_len = br.in_len
    let mut in_pos = br.in_pos
    let mut bitbuf = br.bitbuf
    let mut bitcnt = br.bitcnt
    let mut done_block = false

    while !done_block {
      // Fast loop: enough input, output room, plain_limit headroom, and token buffer space.
      let safe_out = if out_cap < plain_limit { out_cap } else { plain_limit }
      let fast_out_lim = safe_out - 258
      let fast_in_lim = in_len - 8
      while in_pos <= fast_in_lim && out_len <= fast_out_lim && tok_cnt < tok_cap {
        if bitcnt <= 32 {
          let w = deflate[in_pos].to_int().to_int64().to_uint64() |
          (deflate[in_pos + 1].to_int().to_int64().to_uint64() << 8) |
          (deflate[in_pos + 2].to_int().to_int64().to_uint64() << 16) |
          (deflate[in_pos + 3].to_int().to_int64().to_uint64() << 24)
          bitbuf = bitbuf | (w << bitcnt)
          in_pos = in_pos + 4
          bitcnt = bitcnt + 32
        }
        let entry = cur_litlen[(bitbuf & 1023UL).to_int()]
        if entry == 0 {
          return Err("invalid Huffman code")
        }
        let sym = if (entry & 16) == 0 {
          let bits = entry & 15
          bitbuf = bitbuf >> bits
          bitcnt = bitcnt - bits
          entry >> 5
        } else {
          let sub_off = entry >> 5
          let sub_bits = entry & 15
          let sub_entry = cur_litlen[sub_off + ((bitbuf >> 10) & ((1UL << sub_bits) - 1UL)).to_int()]
          if sub_entry == 0 {
            return Err("invalid Huffman code in subtable")
          }
          let total_bits = 10 + (sub_entry & 15)
          bitbuf = bitbuf >> total_bits
          bitcnt = bitcnt - total_bits
          sub_entry >> 5
        }
        if sym < 256 {
          out[out_len] = sym.to_byte()
          out_len = out_len + 1
          tok_buf[tok_cnt] = sym
          tok_cnt = tok_cnt + 1
        } else if sym == 256 {
          done_block = true
          break
        } else {
          let lidx = sym - 257
          if lidx < 0 || lidx >= 29 {
            return Err("invalid literal/length symbol")
          }
          let lxb = le[lidx]
          let lextra = if lxb == 0 {
            0
          } else {
            let v = (bitbuf & ((1UL << lxb) - 1UL)).to_int()
            bitbuf = bitbuf >> lxb
            bitcnt = bitcnt - lxb
            v
          }
          let match_len = lb[lidx] + lextra
          let is_alt_258 = sym == 284 && lextra == 31

          if bitcnt <= 32 {
            let w = deflate[in_pos].to_int().to_int64().to_uint64() |
            (deflate[in_pos + 1].to_int().to_int64().to_uint64() << 8) |
            (deflate[in_pos + 2].to_int().to_int64().to_uint64() << 16) |
            (deflate[in_pos + 3].to_int().to_int64().to_uint64() << 24)
            bitbuf = bitbuf | (w << bitcnt)
            in_pos = in_pos + 4
            bitcnt = bitcnt + 32
          }
          let dentry = cur_dist[(bitbuf & 511UL).to_int()]
          if dentry == 0 {
            return Err("invalid Huffman code")
          }
          let dsym = if (dentry & 16) == 0 {
            let bits = dentry & 15
            bitbuf = bitbuf >> bits
            bitcnt = bitcnt - bits
            dentry >> 5
          } else {
            let sub_off = dentry >> 5
            let sub_bits = dentry & 15
            let sub_entry = cur_dist[sub_off + ((bitbuf >> 9) & ((1UL << sub_bits) - 1UL)).to_int()]
            if sub_entry == 0 {
              return Err("invalid Huffman code in subtable")
            }
            let total_bits = 9 + (sub_entry & 15)
            bitbuf = bitbuf >> total_bits
            bitcnt = bitcnt - total_bits
            sub_entry >> 5
          }
          if dsym < 0 || dsym >= 30 {
            return Err("invalid distance symbol")
          }
          let dxb = de[dsym]
          let dextra = if dxb == 0 {
            0
          } else {
            let v = (bitbuf & ((1UL << dxb) - 1UL)).to_int()
            bitbuf = bitbuf >> dxb
            bitcnt = bitcnt - dxb
            v
          }
          let dist = db[dsym] + dextra
          if dist < 1 || dist > out_len || dist > 32768 {
            return Err("back-reference distance out of window bounds")
          }
          let src = out_len - dist
          if dist == 1 {
            let b = out[src]
            let mut k = 0
            let lim8 = match_len - 8
            while k <= lim8 {
              out[out_len + k] = b
              out[out_len + k + 1] = b
              out[out_len + k + 2] = b
              out[out_len + k + 3] = b
              out[out_len + k + 4] = b
              out[out_len + k + 5] = b
              out[out_len + k + 6] = b
              out[out_len + k + 7] = b
              k = k + 8
            }
            while k < match_len {
              out[out_len + k] = b
              k = k + 1
            }
          } else if dist >= 8 {
            let mut k = 0
            let lim8 = match_len - 8
            while k <= lim8 {
              out[out_len + k] = out[src + k]
              out[out_len + k + 1] = out[src + k + 1]
              out[out_len + k + 2] = out[src + k + 2]
              out[out_len + k + 3] = out[src + k + 3]
              out[out_len + k + 4] = out[src + k + 4]
              out[out_len + k + 5] = out[src + k + 5]
              out[out_len + k + 6] = out[src + k + 6]
              out[out_len + k + 7] = out[src + k + 7]
              k = k + 8
            }
            while k < match_len {
              out[out_len + k] = out[src + k]
              k = k + 1
            }
          } else {
            let mut k = 0
            while k < match_len {
              out[out_len + k] = out[src + k]
              k = k + 1
            }
          }
          out_len = out_len + match_len
          tok_buf[tok_cnt] = pack_match_token(match_len, dist, is_alt_258)
          tok_cnt = tok_cnt + 1
          match_count = match_count + 1
          if dist != 1 {
            all_dist_one = false
          }
          if dist > max_obs_dist {
            max_obs_dist = dist
          }
          if match_len < min_obs_len {
            min_obs_len = match_len
          }
        }
      }
      if done_block {
        break
      }

      // Slow / boundary path: exact EOF, buffer growth, and plain_limit checks.
      if tok_cnt >= tok_cap {
        tok_buf = grow_tok_buf(tok_buf, tok_cnt)
        tok_cap = tok_buf.length()
      }
      while bitcnt <= 56 && in_pos < in_len {
        bitbuf = bitbuf | (deflate[in_pos].to_int().to_int64().to_uint64() << bitcnt)
        in_pos = in_pos + 1
        bitcnt = bitcnt + 8
      }
      let entry = cur_litlen[(bitbuf & 1023UL).to_int()]
      if entry == 0 {
        return Err("invalid Huffman code")
      }
      let sym = if (entry & 16) == 0 {
        let bits = entry & 15
        if bitcnt < bits {
          return Err("unexpected EOF in Huffman symbol")
        }
        bitbuf = bitbuf >> bits
        bitcnt = bitcnt - bits
        entry >> 5
      } else {
        if bitcnt <= 10 {
          return Err("unexpected EOF in Huffman subtable")
        }
        let sub_off = entry >> 5
        let sub_bits = entry & 15
        let sub_entry = cur_litlen[sub_off + ((bitbuf >> 10) & ((1UL << sub_bits) - 1UL)).to_int()]
        if sub_entry == 0 {
          return Err("invalid Huffman code in subtable")
        }
        let total_bits = 10 + (sub_entry & 15)
        if bitcnt < total_bits {
          return Err("unexpected EOF in Huffman subtable symbol")
        }
        bitbuf = bitbuf >> total_bits
        bitcnt = bitcnt - total_bits
        sub_entry >> 5
      }

      if sym < 256 {
        if 1 > plain_limit - out_len {
          return Err("decoded plain text exceeded plain_limit")
        }
        if out_len + 1 > out_cap {
          out = grow_plain_buf(out, out_len, out_len + 1, plain_limit)
          out_cap = out.length()
        }
        out[out_len] = sym.to_byte()
        out_len = out_len + 1
        tok_buf[tok_cnt] = sym
        tok_cnt = tok_cnt + 1
      } else if sym == 256 {
        done_block = true
        break
      } else {
        let lidx = sym - 257
        if lidx < 0 || lidx >= 29 {
          return Err("invalid literal/length symbol")
        }
        let lxb = le[lidx]
        let lextra = if lxb == 0 {
          0
        } else {
          if bitcnt < lxb {
            while bitcnt < lxb && in_pos < in_len {
              bitbuf = bitbuf | (deflate[in_pos].to_int().to_int64().to_uint64() << bitcnt)
              in_pos = in_pos + 1
              bitcnt = bitcnt + 8
            }
            if bitcnt < lxb {
              return Err("unexpected EOF while reading bits")
            }
          }
          let v = (bitbuf & ((1UL << lxb) - 1UL)).to_int()
          bitbuf = bitbuf >> lxb
          bitcnt = bitcnt - lxb
          v
        }
        let match_len = lb[lidx] + lextra
        let is_alt_258 = sym == 284 && lextra == 31

        while bitcnt <= 56 && in_pos < in_len {
          bitbuf = bitbuf | (deflate[in_pos].to_int().to_int64().to_uint64() << bitcnt)
          in_pos = in_pos + 1
          bitcnt = bitcnt + 8
        }
        let dentry = cur_dist[(bitbuf & 511UL).to_int()]
        if dentry == 0 {
          return Err("invalid Huffman code")
        }
        let dsym = if (dentry & 16) == 0 {
          let bits = dentry & 15
          if bitcnt < bits {
            return Err("unexpected EOF in Huffman symbol")
          }
          bitbuf = bitbuf >> bits
          bitcnt = bitcnt - bits
          dentry >> 5
        } else {
          if bitcnt <= 9 {
            return Err("unexpected EOF in Huffman subtable")
          }
          let sub_off = dentry >> 5
          let sub_bits = dentry & 15
          let sub_entry = cur_dist[sub_off + ((bitbuf >> 9) & ((1UL << sub_bits) - 1UL)).to_int()]
          if sub_entry == 0 {
            return Err("invalid Huffman code in subtable")
          }
          let total_bits = 9 + (sub_entry & 15)
          if bitcnt < total_bits {
            return Err("unexpected EOF in Huffman subtable symbol")
          }
          bitbuf = bitbuf >> total_bits
          bitcnt = bitcnt - total_bits
          sub_entry >> 5
        }
        if dsym < 0 || dsym >= 30 {
          return Err("invalid distance symbol")
        }
        let dxb = de[dsym]
        let dextra = if dxb == 0 {
          0
        } else {
          if bitcnt < dxb {
            while bitcnt < dxb && in_pos < in_len {
              bitbuf = bitbuf | (deflate[in_pos].to_int().to_int64().to_uint64() << bitcnt)
              in_pos = in_pos + 1
              bitcnt = bitcnt + 8
            }
            if bitcnt < dxb {
              return Err("unexpected EOF while reading bits")
            }
          }
          let v = (bitbuf & ((1UL << dxb) - 1UL)).to_int()
          bitbuf = bitbuf >> dxb
          bitcnt = bitcnt - dxb
          v
        }
        let dist = db[dsym] + dextra
        if dist < 1 || dist > out_len || dist > 32768 {
          return Err("back-reference distance out of window bounds")
        }
        if match_len > plain_limit - out_len {
          return Err("decoded plain text exceeded plain_limit")
        }
        if out_len + match_len > out_cap {
          out = grow_plain_buf(out, out_len, out_len + match_len, plain_limit)
          out_cap = out.length()
        }
        let src = out_len - dist
        if dist == 1 {
          let b = out[src]
          let mut k = 0
          let lim8 = match_len - 8
          while k <= lim8 {
            out[out_len + k] = b
            out[out_len + k + 1] = b
            out[out_len + k + 2] = b
            out[out_len + k + 3] = b
            out[out_len + k + 4] = b
            out[out_len + k + 5] = b
            out[out_len + k + 6] = b
            out[out_len + k + 7] = b
            k = k + 8
          }
          while k < match_len {
            out[out_len + k] = b
            k = k + 1
          }
        } else if dist >= 8 {
          let mut k = 0
          let lim8 = match_len - 8
          while k <= lim8 {
            out[out_len + k] = out[src + k]
            out[out_len + k + 1] = out[src + k + 1]
            out[out_len + k + 2] = out[src + k + 2]
            out[out_len + k + 3] = out[src + k + 3]
            out[out_len + k + 4] = out[src + k + 4]
            out[out_len + k + 5] = out[src + k + 5]
            out[out_len + k + 6] = out[src + k + 6]
            out[out_len + k + 7] = out[src + k + 7]
            k = k + 8
          }
          while k < match_len {
            out[out_len + k] = out[src + k]
            k = k + 1
          }
        } else {
          let mut k = 0
          while k < match_len {
            out[out_len + k] = out[src + k]
            k = k + 1
          }
        }
        out_len = out_len + match_len
        tok_buf[tok_cnt] = pack_match_token(match_len, dist, is_alt_258)
        tok_cnt = tok_cnt + 1
        match_count = match_count + 1
        if dist != 1 {
          all_dist_one = false
        }
        if dist > max_obs_dist {
          max_obs_dist = dist
        }
        if match_len < min_obs_len {
          min_obs_len = match_len
        }
      }
    }
    br.in_pos = in_pos
    br.bitbuf = bitbuf
    br.bitcnt = bitcnt

    let (used_preset, used_wbits, used_filtered) = encode_huffman_block(
      corr_w,
      pred_state,
      out,
      block_plain_start,
      out_len - block_plain_start,
      btype,
      bfinal,
      hlit,
      hdist,
      hclen,
      cl_lens,
      rle_syms,
      rle_extra,
      tok_buf,
      tok_cnt,
      match_count,
      match_count > 0 && all_dist_one,
      max_obs_dist,
      min_obs_len,
      cached_preset,
      cached_wbits,
      cached_filtered,
      lit_freqs,
      dist_freqs,
    )
    if corr_w.overflow {
      return Err("corrections payload exceeded maximum size")
    }
    if match_count > 0 && !all_dist_one && cached_preset < 0 {
      cached_preset = used_preset
      cached_wbits = used_wbits
      cached_filtered = used_filtered
    }
  }

  let trailing_pad_bits = br_align_byte(br)
  let plain = if out_len == 0 {
    Bytes::new(0)
  } else if out_len == out_cap {
    out
  } else {
    out.slice(0, out_len)
  }
  match finalize_corrections(corr_w, trailing_pad_bits, cached_wbits, cached_filtered) {
    Err(e) => Err(e)
    Ok(corrections) => Ok(PreflateResult::{ compressed_size: br.in_pos, corrections, plain })
  }
}
