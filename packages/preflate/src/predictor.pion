///| Deterministic zlib-accurate LZ77 match predictor (levels 1..9, `windowBits` 9..15, `Z_FILTERED`, RLE, Huffman-only).

///| Predictor preset IDs stored in 4 bits (`0..11`) of block flags.
let preset_literals : Int = 0

///|
let preset_rle : Int = 1

///|
let preset_zlib_l1 : Int = 2

///|
let preset_zlib_l2 : Int = 3

///|
let preset_zlib_l3 : Int = 4

///|
let preset_zlib_l4 : Int = 5

///|
let preset_zlib_l5 : Int = 6

///|
let preset_zlib_l6 : Int = 7

///|
let preset_zlib_l7 : Int = 8

///|
let preset_zlib_l8 : Int = 9

///|
let preset_zlib_l9 : Int = 10

///|
let preset_flate_greedy : Int = 11

///|
let preset_max : Int = 11

///|
let hash_size : Int = 32768

///|
let hash_mask : Int = 32767

///|
let win_size : Int = 32768

///|
let win_mask : Int = 32767

///| Zlib `TOO_FAR`: drop length-3 matches at distance > 4096 in `deflate_slow`.
let zlib_too_far : Int = 4096

///| Exact zlib `configuration_table` parameters for presets `2..10` (levels 1..9).
let cfg_good_len : FixedArray[Int] = fixed_from_array([0, 0, 4, 4, 4, 4, 8, 8, 8, 32, 32, 4])

///| `max_insert` for fast presets (2..4) and `max_lazy` for slow presets (5..10).
let cfg_max_lazy : FixedArray[Int] = fixed_from_array([0, 0, 4, 5, 6, 4, 16, 16, 32, 128, 258, 0])

///|
let cfg_nice_len : FixedArray[Int] = fixed_from_array([
  0, 0, 8, 16, 32, 16, 32, 128, 128, 258, 258, 32,
])

///|
let cfg_max_chain : FixedArray[Int] = fixed_from_array([
  0, 0, 4, 8, 32, 16, 32, 128, 256, 1024, 4096, 16,
])

///|
fn preset_is_zlib_fast(preset : Int) -> Bool {
  preset >= preset_zlib_l1 && preset <= preset_zlib_l3
}

///|
fn preset_is_zlib_slow(preset : Int) -> Bool {
  preset >= preset_zlib_l4 && preset <= preset_zlib_l9
}

///|
fn preset_uses_hash(preset : Int) -> Bool {
  preset >= preset_zlib_l1 && preset <= preset_max
}

///| Compute zlib `MAX_DIST = (1 << wbits) - MIN_LOOKAHEAD (262)` for `wbits` in `9..15`.
fn zlib_max_dist_for_wbits(wbits : Int) -> Int {
  (1 << wbits) - 262
}

///| Sliding-window hash-chain and lazy carry-over state for deterministic LZ77 prediction.
struct PredictorState {
  mut initialized : Bool
  mut head : FixedArray[Int]
  mut prev : FixedArray[Int]
  mut indexed_up_to : Int
  mut lazy_len : Int
  mut lazy_dist : Int
  mut next_lazy_len : Int
  mut next_lazy_dist : Int
  mut scored_pos : Int
}

///|
fn PredictorState::new() -> PredictorState {
  let empty : FixedArray[Int] = FixedArray::make(0, 0)
  PredictorState::{
    initialized: false,
    head: empty,
    prev: empty,
    indexed_up_to: 0,
    lazy_len: 0,
    lazy_dist: 0,
    next_lazy_len: 0,
    next_lazy_dist: 0,
    scored_pos: 0,
  }
}

///| Transfer ownership of a scored scratch state into `dst` in O(1) (zero array copies).
fn pred_swap_in(dst : PredictorState, src : PredictorState) -> Unit {
  dst.initialized = src.initialized
  dst.head = src.head
  dst.prev = src.prev
  dst.indexed_up_to = src.indexed_up_to
  dst.lazy_len = src.lazy_len
  dst.lazy_dist = src.lazy_dist
  dst.next_lazy_len = src.next_lazy_len
  dst.next_lazy_dist = src.next_lazy_dist
}

///|
fn pred_ensure_tables(s : PredictorState) -> Unit {
  if !s.initialized {
    s.head = FixedArray::make(hash_size, -1)
    s.prev = FixedArray::make(win_size, -1)
    s.initialized = true
  }
}

///| Copy `base` into reusable scratch state `dst` without reallocating 256 KiB hash tables.
fn pred_copy_into(dst : PredictorState, base : PredictorState) -> Unit {
  pred_ensure_tables(dst)
  let dh = dst.head
  if !base.initialized {
    let mut i = 0
    while i < 32768 {
      dh[i] = -1
      dh[i + 1] = -1
      dh[i + 2] = -1
      dh[i + 3] = -1
      i = i + 4
    }
  } else {
    let bh = base.head
    let bp = base.prev
    let dp = dst.prev
    let mut i = 0
    while i < 32768 {
      dh[i] = bh[i]
      dp[i] = bp[i]
      dh[i + 1] = bh[i + 1]
      dp[i + 1] = bp[i + 1]
      dh[i + 2] = bh[i + 2]
      dp[i + 2] = bp[i + 2]
      dh[i + 3] = bh[i + 3]
      dp[i + 3] = bp[i + 3]
      i = i + 4
    }
  }
  dst.indexed_up_to = base.indexed_up_to
  dst.lazy_len = base.lazy_len
  dst.lazy_dist = base.lazy_dist
  dst.next_lazy_len = 0
  dst.next_lazy_dist = 0
}

///| Catch up hash table indexing before entering a hash-based block using rolling hash.
fn pred_catch_up(s : PredictorState, plain : Bytes, pos : Int, block_end : Int) -> Unit {
  pred_ensure_tables(s)
  let min_start = if pos > 32768 { pos - 32768 } else { 0 }
  let mut i = s.indexed_up_to
  if i < min_start {
    i = min_start
  }
  if i < 0 {
    i = 0
  }
  let max_ins = if block_end >= 2 { block_end - 2 } else { 0 }
  let target = if pos < max_ins { pos } else { max_ins }
  if i < target {
    let head = s.head
    let prev = s.prev
    let mut h = ((plain[i].to_int() << 5) ^ plain[i + 1].to_int()) & 32767
    while i < target {
      h = ((h << 5) ^ plain[i + 2].to_int()) & 32767
      prev[i & 32767] = head[h]
      head[h] = i
      i = i + 1
    }
  }
  if s.indexed_up_to < target {
    s.indexed_up_to = target
  }
  s.lazy_len = 0
  s.lazy_dist = 0
}

///| Advance predictor state after committing an actual token of `advance` bytes.
///| Uses hoisted rolling-hash insertion with zero per-byte function calls.
fn pred_advance_cfg(
  s : PredictorState,
  plain : Bytes,
  pos : Int,
  advance : Int,
  block_end : Int,
  uses_hash : Bool,
  fast_max_ins : Int,
  next_lazy_len : Int,
  next_lazy_dist : Int,
) -> Unit {
  if !uses_hash {
    s.lazy_len = 0
    s.lazy_dist = 0
    return
  }
  if !s.initialized {
    pred_catch_up(s, plain, pos, block_end)
  }
  if advance == 1 {
    s.lazy_len = next_lazy_len
    s.lazy_dist = next_lazy_dist
  } else {
    s.lazy_len = 0
    s.lazy_dist = 0
  }

  let max_ins = if block_end >= 2 { block_end - 2 } else { 0 }
  let head = s.head
  let prev = s.prev
  if fast_max_ins > 0 && advance > fast_max_ins {
    if pos < max_ins {
      let h = ((plain[pos].to_int() << 10) ^
        (plain[pos + 1].to_int() << 5) ^
        plain[pos + 2].to_int()) & 32767
      prev[pos & 32767] = head[h]
      head[h] = pos
    }
    let end = pos + advance
    let new_idx = if end < max_ins { end } else { max_ins }
    if s.indexed_up_to < new_idx {
      s.indexed_up_to = new_idx
    }
    return
  }

  let end = pos + advance
  let stop = if end < max_ins { end } else { max_ins }
  let mut i = pos
  if i < stop {
    let mut h = ((plain[i].to_int() << 5) ^ plain[i + 1].to_int()) & 32767
    while i < stop {
      h = ((h << 5) ^ plain[i + 2].to_int()) & 32767
      prev[i & 32767] = head[h]
      head[h] = i
      i = i + 1
    }
  }
  if s.indexed_up_to < stop {
    s.indexed_up_to = stop
  }
}

///| Find longest match at `pos` without mutating hash state, matching zlib's `longest_match`.
///| `chain_nice` packs `(chain << 9) | nice_len`.
///| `dist_init` packs `(check_prev << 25) | (max_dist << 9) | init_best_len`.
///| Returns packed `(best_len << 16) | best_dist`, or `0` if no match `> init_best_len`.
fn find_best_match(
  plain : Bytes,
  pos : Int,
  block_end : Int,
  prev : FixedArray[Int],
  start_cand : Int,
  chain_nice : Int,
  dist_init : Int,
) -> Int {
  let rem = block_end - pos
  if rem < 3 {
    return 0
  }
  let max_len = if rem > 258 { 258 } else { rem }
  let init_best_len = dist_init & 511
  if init_best_len >= max_len {
    return 0
  }
  let nice_len = chain_nice & 511
  let eff_nice = if nice_len > max_len { max_len } else { nice_len }
  let max_dist = (dist_init >> 9) & 65535
  let min_pos = if pos > max_dist { pos - max_dist } else { 0 }

  let mut best_len = init_best_len
  let mut best_dist = 0
  let p0 = plain[pos]
  let p1 = plain[pos + 1]
  let p2 = plain[pos + 2]
  let mut end_b = plain[pos + best_len]
  let mut end_p = plain[pos + best_len - 1]
  let mut mid_off = best_len >> 1
  let mut end_m = plain[pos + mid_off]

  // Unindexed candidate (`pos - 1`) during lazy lookahead at `pos + 1`.
  if (dist_init >> 25) != 0 {
    let extra_cand = pos - 1
    if extra_cand >= min_pos &&
    plain[extra_cand + best_len] == end_b &&
    plain[extra_cand + best_len - 1] == end_p &&
    plain[extra_cand] == p0 &&
    plain[extra_cand + 1] == p1 &&
    plain[extra_cand + 2] == p2 {
      let mut mlen = 3
      while mlen + 4 <= max_len &&
      plain[extra_cand + mlen] == plain[pos + mlen] &&
      plain[extra_cand + mlen + 1] == plain[pos + mlen + 1] &&
      plain[extra_cand + mlen + 2] == plain[pos + mlen + 2] &&
      plain[extra_cand + mlen + 3] == plain[pos + mlen + 3] {
        mlen = mlen + 4
      }
      while mlen < max_len && plain[extra_cand + mlen] == plain[pos + mlen] {
        mlen = mlen + 1
      }
      if mlen > best_len {
        best_len = mlen
        best_dist = 1
        if best_len >= eff_nice {
          return (best_len << 16) | 1
        }
        end_b = plain[pos + best_len]
        end_p = plain[pos + best_len - 1]
        mid_off = best_len >> 1
        end_m = plain[pos + mid_off]
      }
    }
  }

  let mut chain = chain_nice >> 9
  let mut cur = start_cand
  if cur >= pos {
    cur = -1
  }
  while cur >= min_pos && chain > 0 {
    if plain[cur + best_len] == end_b &&
    plain[cur + best_len - 1] == end_p &&
    plain[cur + mid_off] == end_m &&
    plain[cur] == p0 &&
    plain[cur + 1] == p1 &&
    plain[cur + 2] == p2 {
      let mut mlen = 3
      while mlen + 4 <= max_len &&
      plain[cur + mlen] == plain[pos + mlen] &&
      plain[cur + mlen + 1] == plain[pos + mlen + 1] &&
      plain[cur + mlen + 2] == plain[pos + mlen + 2] &&
      plain[cur + mlen + 3] == plain[pos + mlen + 3] {
        mlen = mlen + 4
      }
      while mlen < max_len && plain[cur + mlen] == plain[pos + mlen] {
        mlen = mlen + 1
      }
      if mlen > best_len {
        best_len = mlen
        best_dist = pos - cur
        if best_len >= eff_nice {
          break
        }
        end_b = plain[pos + best_len]
        end_p = plain[pos + best_len - 1]
        mid_off = best_len >> 1
        end_m = plain[pos + mid_off]
      }
    }
    cur = prev[cur & 32767]
    chain = chain - 1
  }
  if best_len <= init_best_len {
    return 0
  }
  (best_len << 16) | best_dist
}

///| 6-arg register-only slow-preset (L4..L9) token predictor.
///| `cfg` packs `(good_len << 22) | (nice_len << 13) | max_chain`.
///| `lazy_dist` packs `(filtered << 25) | (max_lazy << 16) | max_dist`.
fn predict_token_slow(
  s : PredictorState,
  plain : Bytes,
  pos : Int,
  block_end : Int,
  cfg : Int,
  lazy_dist : Int,
) -> Int {
  s.next_lazy_len = 0
  s.next_lazy_dist = 0
  let head = s.head
  let prev = s.prev
  let max_chain = cfg & 8191
  let nice_len = (cfg >> 13) & 511
  let good_len = cfg >> 22
  let max_dist = lazy_dist & 65535
  let max_lazy = (lazy_dist >> 16) & 511
  let filtered = (lazy_dist >> 25) != 0

  let mut cur_len = s.lazy_len
  let mut cur_dist = s.lazy_dist
  if cur_len < 3 {
    if block_end - pos < 3 {
      return plain[pos].to_int()
    }
    let h = ((plain[pos].to_int() << 10) ^
      (plain[pos + 1].to_int() << 5) ^
      plain[pos + 2].to_int()) & 32767
    let ch = if 2 >= good_len {
      let c = max_chain >> 2
      if c < 1 { 1 } else { c }
    } else {
      max_chain
    }
    let packed = find_best_match(
      plain,
      pos,
      block_end,
      prev,
      head[h],
      (ch << 9) | nice_len,
      (max_dist << 9) | 2,
    )
    if packed == 0 {
      return plain[pos].to_int()
    }
    let ml = packed >> 16
    let md = packed & 65535
    if (filtered && ml <= 5) || (ml == 3 && md > zlib_too_far) {
      return plain[pos].to_int()
    }
    cur_len = ml
    cur_dist = md
  }

  if cur_len < max_lazy && block_end - pos >= 4 {
    let p1 = pos + 1
    let h1 = ((plain[p1].to_int() << 10) ^
      (plain[p1 + 1].to_int() << 5) ^
      plain[p1 + 2].to_int()) & 32767
    let ch1 = if cur_len >= good_len {
      let c = max_chain >> 2
      if c < 1 { 1 } else { c }
    } else {
      max_chain
    }
    let packed1 = find_best_match(
      plain,
      p1,
      block_end,
      prev,
      head[h1],
      (ch1 << 9) | nice_len,
      (1 << 25) | (max_dist << 9) | cur_len,
    )
    if packed1 != 0 {
      let next_len_raw = packed1 >> 16
      let next_dist = packed1 & 65535
      let next_len = if (filtered && next_len_raw <= 5) ||
      (next_len_raw == 3 && next_dist > zlib_too_far) {
        0
      } else {
        next_len_raw
      }
      if next_len > cur_len {
        s.next_lazy_len = next_len
        s.next_lazy_dist = next_dist
        return plain[pos].to_int()
      }
    }
  }
  pack_match_token(cur_len, cur_dist, false)
}

///| 5-arg register-only slow-preset (L4..L9) hash-chain advancer.
fn pred_advance_slow(
  s : PredictorState,
  plain : Bytes,
  pos : Int,
  advance : Int,
  block_end : Int,
) -> Unit {
  if advance == 1 {
    s.lazy_len = s.next_lazy_len
    s.lazy_dist = s.next_lazy_dist
  } else {
    s.lazy_len = 0
    s.lazy_dist = 0
  }
  let max_ins = if block_end >= 2 { block_end - 2 } else { 0 }
  let end = pos + advance
  let stop = if end < max_ins { end } else { max_ins }
  let mut i = pos
  if i < stop {
    let head = s.head
    let prev = s.prev
    let mut h = ((plain[i].to_int() << 5) ^ plain[i + 1].to_int()) & 32767
    while i < stop {
      h = ((h << 5) ^ plain[i + 2].to_int()) & 32767
      prev[i & 32767] = head[h]
      head[h] = i
      i = i + 1
    }
  }
  if s.indexed_up_to < stop {
    s.indexed_up_to = stop
  }
}

///| Pure deterministic prediction at `pos` using hoisted preset parameters.
///| Writes `(next_lazy_len, next_lazy_dist)` into `s` and returns `predicted_token` (zero tuple allocs).
fn predict_token_cfg(
  s : PredictorState,
  plain : Bytes,
  pos : Int,
  block_end : Int,
  preset : Int,
  good_len : Int,
  max_lazy : Int,
  nice_len : Int,
  max_chain : Int,
  max_dist : Int,
  filtered : Bool,
) -> Int {
  s.next_lazy_len = 0
  s.next_lazy_dist = 0
  if preset == preset_literals {
    return plain[pos].to_int()
  }
  if preset == preset_rle {
    if pos > 0 && block_end - pos >= 3 {
      let prev_b = plain[pos - 1]
      if plain[pos] == prev_b && plain[pos + 1] == prev_b && plain[pos + 2] == prev_b {
        let rem = block_end - pos
        let max_len = if rem > 258 { 258 } else { rem }
        let mut mlen = 3
        while mlen < max_len && plain[pos + mlen] == prev_b {
          mlen = mlen + 1
        }
        return pack_match_token(mlen, 1, false)
      }
    }
    return plain[pos].to_int()
  }

  let head = s.head
  let prev = s.prev
  if preset < preset_zlib_l4 || preset > preset_zlib_l9 {
    if block_end - pos < 3 {
      return plain[pos].to_int()
    }
    let h = ((plain[pos].to_int() << 10) ^
      (plain[pos + 1].to_int() << 5) ^
      plain[pos + 2].to_int()) & 32767
    let packed = find_best_match(
      plain,
      pos,
      block_end,
      prev,
      head[h],
      (max_chain << 9) | nice_len,
      (max_dist << 9) | 2,
    )
    if packed == 0 {
      return plain[pos].to_int()
    }
    return pack_match_token(packed >> 16, packed & 65535, false)
  }

  // Zlib `deflate_slow`: use carried lazy match if available, otherwise search at `pos`.
  let mut cur_len = s.lazy_len
  let mut cur_dist = s.lazy_dist
  if cur_len < 3 {
    if block_end - pos < 3 {
      return plain[pos].to_int()
    }
    let h = ((plain[pos].to_int() << 10) ^
      (plain[pos + 1].to_int() << 5) ^
      plain[pos + 2].to_int()) & 32767
    let ch = if 2 >= good_len {
      let c = max_chain >> 2
      if c < 1 { 1 } else { c }
    } else {
      max_chain
    }
    let packed = find_best_match(
      plain,
      pos,
      block_end,
      prev,
      head[h],
      (ch << 9) | nice_len,
      (max_dist << 9) | 2,
    )
    if packed == 0 {
      return plain[pos].to_int()
    }
    let ml = packed >> 16
    let md = packed & 65535
    if (filtered && ml <= 5) || (ml == 3 && md > zlib_too_far) {
      return plain[pos].to_int()
    }
    cur_len = ml
    cur_dist = md
  }

  // Lazy lookahead at `pos + 1` with zlib's `prev_length` carry-over, `Z_FILTERED`, and `TOO_FAR`.
  if cur_len < max_lazy && block_end - pos >= 4 {
    let p1 = pos + 1
    let h1 = ((plain[p1].to_int() << 10) ^
      (plain[p1 + 1].to_int() << 5) ^
      plain[p1 + 2].to_int()) & 32767
    let ch1 = if cur_len >= good_len {
      let c = max_chain >> 2
      if c < 1 { 1 } else { c }
    } else {
      max_chain
    }
    let packed1 = find_best_match(
      plain,
      p1,
      block_end,
      prev,
      head[h1],
      (ch1 << 9) | nice_len,
      (1 << 25) | (max_dist << 9) | cur_len,
    )
    if packed1 != 0 {
      let next_len_raw = packed1 >> 16
      let next_dist = packed1 & 65535
      let next_len = if (filtered && next_len_raw <= 5) ||
      (next_len_raw == 3 && next_dist > zlib_too_far) {
        0
      } else {
        next_len_raw
      }
      if next_len > cur_len {
        s.next_lazy_len = next_len
        s.next_lazy_dist = next_dist
        return plain[pos].to_int()
      }
    }
  }
  pack_match_token(cur_len, cur_dist, false)
}
