///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/preflate`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "flate"
import "preflate"

///|
fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn fnv1a_32(data : Bytes) -> UInt {
  let mut h : UInt = 2166136261U
  let n = data.length()
  let mut i = 0
  while i < n {
    h = (h ^ data[i].to_int().to_uint()) * 16777619U
    i = i + 1
  }
  h
}

///|
fn repeat_bytes(pat : Bytes, count : Int) -> Bytes {
  let pn = pat.length()
  let out = Bytes::new(pn * count)
  let mut c = 0
  while c < count {
    let base = c * pn
    let mut j = 0
    while j < pn {
      out[base + j] = pat[j]
      j = j + 1
    }
    c = c + 1
  }
  out
}

///|
fn from_hex(s : String) -> Bytes {
  let n = s.length() / 2
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c0 = s.code_unit_at(i * 2)
    let c1 = s.code_unit_at(i * 2 + 1)
    let hi = if c0 >= 48 && c0 <= 57 {
      c0 - 48
    } else if c0 >= 97 && c0 <= 102 {
      c0 - 87
    } else {
      c0 - 55
    }
    let lo = if c1 >= 48 && c1 <= 57 {
      c1 - 48
    } else if c1 >= 97 && c1 <= 102 {
      c1 - 87
    } else {
      c1 - 55
    }
    b[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  b
}

///|
fn check_roundtrip(
  world : World,
  label : String,
  deflate : Bytes,
  expected_plain : Bytes,
) -> Int {
  let res = match preflate::analyze(deflate) {
    Ok(r) => r
    Err(e) => {
      io_println(world, "ERR analyze " + label + ": " + e)
      return 1
    }
  }
  if res.compressed_size != deflate.length() {
    io_println(world, "ERR compressed_size " + label)
    return 2
  }
  if !bytes_eq(res.plain, expected_plain) {
    io_println(world, "ERR plain " + label)
    return 3
  }
  let rebuilt = match preflate::reencode(res.corrections, res.plain) {
    Ok(b) => b
    Err(e) => {
      io_println(world, "ERR reencode " + label + ": " + e)
      return 4
    }
  }
  if !bytes_eq(rebuilt, deflate) {
    io_println(world, "ERR bit-exact " + label)
    return 5
  }
  io_println(
    world,
    label +
    ": def=" +
    deflate.length().to_string() +
    " plain=" +
    res.plain.length().to_string() +
    " corr=" +
    res.corrections.length().to_string() +
    " fnv=" +
    fnv1a_32(rebuilt).to_int64().to_string(),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  // 1. Stored block (flate level 0)
  let stored_plain = repeat_bytes("preflate-stored-block-0123456789\n".to_bytes(), 120)
  let stored_def = match flate::deflate_compress(stored_plain, 0) {
    Ok(b) => b
    Err(_) => return 10
  }
  let rc1 = check_roundtrip(world, "stored", stored_def, stored_plain)
  if rc1 != 0 {
    return rc1
  }

  // 2. Fixed Huffman block ("Hello, preflate!\n" encoded as raw RFC 1951 fixed block)
  let fixed_plain = "Hello, preflate!\n".to_bytes()
  let fixed_def = from_hex("f348cdc9c9d75128284a4dcb492c4955e40200")
  let rc2 = check_roundtrip(world, "fixed", fixed_def, fixed_plain)
  if rc2 != 0 {
    return 20 + rc2
  }

  // 3. Dynamic Huffman blocks (flate L1, L6, L9 on structured payload)
  let dyn_plain = repeat_bytes(
    "{\"ts\":1795516200,\"lvl\":\"INFO\",\"msg\":\"preflate bit-exact roundtrip\",\"ok\":true}\n".to_bytes(),
    200,
  )
  let dyn_l1 = match flate::deflate_compress(dyn_plain, 1) {
    Ok(b) => b
    Err(_) => return 30
  }
  let rc3 = check_roundtrip(world, "dyn_l1", dyn_l1, dyn_plain)
  if rc3 != 0 {
    return 30 + rc3
  }
  let dyn_l6 = match flate::deflate_compress(dyn_plain, 6) {
    Ok(b) => b
    Err(_) => return 40
  }
  let rc4 = check_roundtrip(world, "dyn_l6", dyn_l6, dyn_plain)
  if rc4 != 0 {
    return 40 + rc4
  }
  let dyn_l9 = match flate::deflate_compress(dyn_plain, 9) {
    Ok(b) => b
    Err(_) => return 50
  }
  let rc5 = check_roundtrip(world, "dyn_l9", dyn_l9, dyn_plain)
  if rc5 != 0 {
    return 50 + rc5
  }

  // 4. analyze_limited bomb rejection
  let bomb_rejected = match preflate::analyze_limited(dyn_l6, 1024) {
    Err(_) => true
    Ok(_) => false
  }
  if !bomb_rejected {
    io_println(world, "ERR bomb not rejected")
    return 60
  }

  // 5. Malformed DEFLATE and malformed correction stream rejection
  let bad_def_rejected = match preflate::analyze(from_hex("06ff")) {
    Err(_) => true
    Ok(_) => false
  }
  if !bad_def_rejected {
    io_println(world, "ERR bad deflate not rejected")
    return 61
  }
  let bad_corr_rejected = match preflate::reencode("BAD!".to_bytes(), fixed_plain) {
    Err(_) => true
    Ok(_) => false
  }
  if !bad_corr_rejected {
    io_println(world, "ERR bad corrections not rejected")
    return 62
  }

  io_println(world, "preflate_wasm_smoke:ok bomb=rejected bad_def=rejected bad_corr=rejected")
  0
}
