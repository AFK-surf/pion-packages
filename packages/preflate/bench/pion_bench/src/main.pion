///| Pion Native head-to-head benchmark for `packages/preflate`.
///| Usage: preflate_bench_pion <deflate_file> <iters> [stats_path]
///| Runs `analyze` + `reencode` roundtrip `iters` times and writes the final
///| reconstructed raw DEFLATE stream to stdout for byte-exact SHA-256 verification.
///| When `stats_path` is provided, writes correction-stream statistics to that file.

import "preflate"

///|
fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: preflate_bench_pion <deflate_file> <iters> [stats_path]")
    return 1
  }
  let path = args[1]
  let iters = parse_int(args[2])
  if iters <= 0 {
    io_println(world, "iters must be > 0")
    return 1
  }
  let deflate = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }

  let mut last_rebuilt = Bytes::new(0)
  let mut last_corr_len = 0
  let mut last_plain_len = 0
  let mut i = 0
  while i < iters {
    let res = match preflate::analyze(deflate) {
      Ok(r) => r
      Err(e) => {
        io_println(world, "analyze error: " + e)
        return 2
      }
    }
    let rebuilt = match preflate::reencode(res.corrections, res.plain) {
      Ok(b) => b
      Err(e) => {
        io_println(world, "reencode error: " + e)
        return 3
      }
    }
    last_rebuilt = rebuilt
    last_corr_len = res.corrections.length()
    last_plain_len = res.plain.length()
    i = i + 1
  }

  if args.length() >= 4 {
    let stats = "impl=pion deflate=" +
    deflate.length().to_string() +
    " plain=" +
    last_plain_len.to_string() +
    " corrections=" +
    last_corr_len.to_string() +
    "\n"
    let _ = fs_write_bytes(world, args[3], stats.to_bytes())
  }
  match fs_write_bytes(world, "/dev/stdout", last_rebuilt) {
    Ok(_) => 0
    Err(_) => {
      io_println(world, "failed to write stdout")
      4
    }
  }
}
