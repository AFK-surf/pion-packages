///| Red-team audit driver for `packages/glsl` (native and wasm32 from the same source).
///|   tr <vert|frag> <in> <out>      translate one file, write GLSL 410 to <out>, print verdict + reflection
///|   batch <list> <out>             for every path in <list>: reflect+translate as vertex and fragment,
///|                                  write one deterministic verdict line per case to <out>
///|   time <vert|frag> <in> <iters>  wall-clock ms of <iters> translations (reflect-only with `rtime`)

import "glsl"

fn fnv(s : String) -> String {
  let mut h : UInt = 2166136261U
  let mut i = 0
  while i < s.length() {
    h = (h ^ s.code_unit_at(i).to_uint()) * 16777619U
    i = i + 1
  }
  h.to_int64().to_string()
}

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn err_kind(e : glsl::GlslError) -> String {
  match e {
    glsl::GlslError::EmptySource => "Empty"
    glsl::GlslError::LimitExceeded(_) => "Limit"
    glsl::GlslError::LexError(_, _) => "Lex"
    glsl::GlslError::PreprocessorError(_, _) => "Pp"
    glsl::GlslError::ParseError(_, _) => "Parse"
    glsl::GlslError::UnsupportedVersion(_) => "Version"
    glsl::GlslError::StageMismatch(_) => "Stage"
  }
}

fn vars(sb : StringBuilder, tag : String, vs : Array[glsl::VarInfo]) -> Unit {
  sb.write_string(" " + tag + "=")
  let mut i = 0
  while i < vs.length() {
    let v = vs[i]
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(
      v.name + ":" + v.glsl_type + "[" + v.array_size.to_string() + "]@" + v.location.to_string() +
      "/" + v.precision,
    )
    i = i + 1
  }
}

fn refl_text(r : glsl::Reflection) -> String {
  let sb = StringBuilder::new()
  let ver = match r.version {
    glsl::GlslVersion::Es100 => "es100"
    glsl::GlslVersion::Es300 => "es300"
  }
  sb.write_string("version=" + ver)
  vars(sb, "attributes", r.attributes)
  vars(sb, "uniforms", r.uniforms)
  vars(sb, "varyings", r.varyings)
  vars(sb, "outputs", r.outputs)
  sb.write_string(" extensions=")
  let mut i = 0
  while i < r.extensions.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(r.extensions[i])
    i = i + 1
  }
  sb.write_string(
    " frag_color=" + r.uses_frag_color.to_string() + " frag_data=" + r.uses_frag_data.to_string() +
    " max_frag_data_index=" + r.max_frag_data_index.to_string(),
  )
  sb.to_string()
}

fn to_bytes(s : String) -> Bytes {
  let b = Bytes::new(s.length())
  let mut k = 0
  while k < s.length() {
    b[k] = s.code_unit_at(k).to_byte()
    k = k + 1
  }
  b
}

fn stage_of(s : String) -> glsl::ShaderStage {
  if s == "vert" {
    glsl::ShaderStage::Vertex
  } else {
    glsl::ShaderStage::Fragment
  }
}

fn one(src : String, st : glsl::ShaderStage) -> String {
  let a = match glsl::parse_and_reflect(src, st) {
    Ok(r) => "OK:" + fnv(refl_text(r))
    Err(e) => "ERR:" + err_kind(e) + ":" + fnv(glsl::glsl_error_message(e))
  }
  let b = match glsl::translate_to_glsl410(src, st) {
    Ok(t) => "OK:" + fnv(t.glsl410) + ":" + fnv(refl_text(t.reflection))
    Err(e) => "ERR:" + err_kind(e) + ":" + fnv(glsl::glsl_error_message(e))
  }
  a + " " + b
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: tr|batch|time|rtime ...")
    return 2
  }
  let mode = args[1]
  if mode == "tr" && args.length() >= 5 {
    let src = match fs_read_bytes(world, args[3]) {
      Ok(b) => b.to_string()
      Err(_) => {
        io_println(world, "IOERR " + args[3])
        return 2
      }
    }
    match glsl::translate_to_glsl410(src, stage_of(args[2])) {
      Ok(t) => {
        let _ = fs_write_bytes(world, args[4], to_bytes(t.glsl410))
        io_println(world, "OK " + refl_text(t.reflection))
        0
      }
      Err(e) => {
        io_println(world, "ERR " + err_kind(e) + " " + glsl::glsl_error_message(e))
        1
      }
    }
  } else if mode == "batch" && args.length() >= 4 {
    let list = match fs_read_bytes(world, args[2]) {
      Ok(b) => b.to_string()
      Err(_) => return 2
    }
    let out = StringBuilder::new()
    let mut start = 0
    let mut i = 0
    while i <= list.length() {
      if i == list.length() || list.code_unit_at(i) == 10 {
        if i > start {
          let path = list.slice(start, i)
          let src = match fs_read_bytes(world, path) {
            Ok(b) => b.to_string()
            Err(_) => ""
          }
          out.write_string(
            path + " V " + one(src, glsl::ShaderStage::Vertex) + " F " +
            one(src, glsl::ShaderStage::Fragment) + "\n",
          )
        }
        start = i + 1
      }
      i = i + 1
    }
    let _ = fs_write_bytes(world, args[3], to_bytes(out.to_string()))
    0
  } else if (mode == "time" || mode == "rtime") && args.length() >= 5 {
    let src = match fs_read_bytes(world, args[3]) {
      Ok(b) => b.to_string()
      Err(_) => return 2
    }
    let st = stage_of(args[2])
    let iters = parse_int(args[4])
    let t0 = clock_now_ms(world)
    let mut ok = 0
    let mut k = 0
    while k < iters {
      if mode == "time" {
        match glsl::translate_to_glsl410_with_limits(src, st, glsl::ParseLimits::new(0, 0, 0, 0, 0)) {
          Ok(_) => ok = ok + 1
          Err(_) => ()
        }
      } else {
        match glsl::parse_and_reflect_with_limits(src, st, glsl::ParseLimits::new(0, 0, 0, 0, 0)) {
          Ok(_) => ok = ok + 1
          Err(_) => ()
        }
      }
      k = k + 1
    }
    let t1 = clock_now_ms(world)
    io_println(world, "ms=" + (t1 - t0).to_string() + " ok=" + ok.to_string())
    0
  } else {
    io_println(world, "bad args")
    2
  }
}
