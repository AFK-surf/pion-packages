///| Red-team unit tests for `packages/glsl` v0.1.0.
///| Assertions encode the *expected correct* behaviour: a `redteam_` test FAILS while the defect exists and PASSES
///| once fixed.  `control_` tests pin behaviour that is already correct.  OpenGL 4.1 Core ground truth for every
///| finding (glCompileShader / glLinkProgram logs) is produced by `gl_judge.py` and quoted in `REPORT.md`.

import "glsl"

fn contains(h : String, n : String) -> Bool {
  let hl = h.length()
  let nl = n.length()
  if nl == 0 {
    return true
  }
  let mut i = 0
  while i + nl <= hl {
    let mut j = 0
    while j < nl && h.code_unit_at(i + j) == n.code_unit_at(j) {
      j = j + 1
    }
    if j == nl {
      return true
    }
    i = i + 1
  }
  false
}

fn tr(src : String, st : glsl::ShaderStage) -> String {
  match glsl::translate_to_glsl410(src, st) {
    Ok(t) => t.glsl410
    Err(e) => "ERR " + glsl::glsl_error_message(e)
  }
}

fn frag(src : String) -> String {
  tr(src, glsl::ShaderStage::Fragment)
}

fn vert(src : String) -> String {
  tr(src, glsl::ShaderStage::Vertex)
}

fn ok(out : String, label : String) -> Unit {
  debug_assert(!contains(out, "ERR "), label + ": translation rejected a valid WebGL shader: " + out)
}

fn absent(out : String, needle : String, label : String) -> Unit {
  ok(out, label)
  debug_assert(!contains(out, needle), label + ": GLSL 410 output still contains `" + needle + "`:\n" + out)
}

fn present(out : String, needle : String, label : String) -> Unit {
  ok(out, label)
  debug_assert(contains(out, needle), label + ": GLSL 410 output lacks `" + needle + "`:\n" + out)
}

// ---------------------------------------------------------------- P0 ----------------------------------------------

///| Three.js WebGL2 prelude (`#define attribute in` / `#define varying out|in`) is rejected outright.
test "redteam_p0_threejs_webgl2_prelude_vertex" {
  ok(
    vert(
      "#version 300 es\n#define attribute in\n#define varying out\n#define texture2D texture\n" +
      "precision highp float;\nattribute vec3 position;\nvarying vec2 vUv;\n" +
      "void main() { vUv = position.xy; gl_Position = vec4(position, 1.0); }\n",
    ),
    "three.js webgl2 vertex",
  )
}

test "redteam_p0_threejs_webgl2_prelude_fragment" {
  ok(
    frag(
      "#version 300 es\n#define varying in\nlayout(location = 0) out highp vec4 pc_fragColor;\n" +
      "#define gl_FragColor pc_fragColor\n#define texture2D texture\nprecision highp float;\n" +
      "uniform sampler2D map;\nvarying vec2 vUv;\nvoid main() { gl_FragColor = texture2D(map, vUv); }\n",
    ),
    "three.js webgl2 fragment",
  )
}

// ---------------------------------------------------------------- P1 ----------------------------------------------

///| Legal ES 1.00 identifiers that are GLSL 4.10 keywords / reserved words are emitted verbatim.
test "redteam_p1_es100_identifiers_that_are_glsl410_keywords" {
  let words = [
    "sample", "smooth", "noperspective", "patch", "subroutine", "layout", "centroid", "uint", "case", "precise",
    "common", "partition", "active", "filter", "isampler2D", "usampler2D", "sampler2DArray", "samplerBuffer",
    "mat2x3", "uvec2", "dmat2",
  ]
  let mut i = 0
  while i < words.length() {
    let w = words[i]
    absent(
      frag(
        "precision mediump float;\nuniform float u;\nvoid main() {\n  float " + w + " = u;\n  gl_FragColor = vec4(" +
        w + ");\n}\n",
      ),
      "float " + w + " =",
      "es100 identifier " + w,
    )
    i = i + 1
  }
}

test "redteam_p1_es300_identifier_precise" {
  absent(
    frag(
      "#version 300 es\nprecision mediump float;\nuniform float u;\nout vec4 o;\n" +
      "void main() { float precise = u; o = vec4(precise); }\n",
    ),
    "float precise",
    "es300 precise",
  )
}

///| `uniform sampler2D texture;` (classic WebGL1 tutorial code) hides the 410 `texture()` builtin after rewriting.
test "redteam_p1_uniform_named_texture" {
  absent(
    frag(
      "precision mediump float;\nuniform sampler2D texture;\nvarying vec2 v;\n" +
      "void main() { gl_FragColor = texture2D(texture, v); }\n",
    ),
    "texture(texture",
    "uniform named texture",
  )
}

///| gl_FragColor / gl_FragData used only through a macro whose body does not have them as a whitespace-separated
///| word: the body is rewritten to `_fv_*` but the output variable is never declared.
test "redteam_p1_fragcolor_in_macro_not_declared" {
  present(
    frag("precision mediump float;\n#define OUTPUT(c) gl_FragColor=(c)\nvoid main() { OUTPUT(vec4(1.0)); }\n"),
    "out vec4 _fv_gl_FragColor",
    "macro gl_FragColor=",
  )
  present(
    frag("precision mediump float;\n#define FRAG (gl_FragColor)\nvoid main() { FRAG = vec4(1.0); }\n"),
    "out vec4 _fv_gl_FragColor",
    "macro (gl_FragColor)",
  )
}

test "redteam_p1_fragdata_in_macro_not_declared" {
  present(
    frag(
      "#extension GL_EXT_draw_buffers : require\nprecision mediump float;\n#define OUT0 gl_FragData[0]\n" +
      "#define OUT1 gl_FragData[1]\nvoid main() { OUT0 = vec4(1.0); OUT1 = vec4(0.0); }\n",
    ),
    "out vec4 _fv_gl_FragData[",
    "macro gl_FragData[0]",
  )
}

///| A macro in a function signature (or a macro-generated function) desynchronises the top-level scanner, so the
///| function body is never rewritten.
test "redteam_p1_macro_in_function_signature_skips_body_rewrite" {
  absent(
    frag(
      "precision mediump float;\n#define PREC highp\nuniform sampler2D s;\nvarying vec2 v;\n" +
      "PREC vec4 sampleIt(vec2 uv) { return texture2D(s, uv); }\nvoid main() { gl_FragColor = sampleIt(v); }\n",
    ),
    "texture2D",
    "macro return-type qualifier",
  )
  absent(
    frag(
      "precision mediump float;\n#define DECL_GETTER(name, val) vec4 name() { return val; }\n" +
      "DECL_GETTER(white, vec4(1.0))\nvoid main() { gl_FragColor = white(); }\n",
    ),
    "gl_FragColor",
    "macro-generated function",
  )
}

///| ES 1.00 built-ins with no GLSL 410 equivalent left untranslated.
test "redteam_p1_missing_es100_builtin_rewrites" {
  absent(
    vert(
      "attribute vec2 p;\nuniform sampler2D hm;\nvarying vec4 c;\n" +
      "void main() { c = texture2DProjLod(hm, vec3(p, 1.0), 0.0); gl_Position = vec4(p, 0.0, 1.0); }\n",
    ),
    "texture2DProjLod",
    "texture2DProjLod (ES 1.00 vertex built-in)",
  )
  absent(
    frag(
      "#extension GL_EXT_frag_depth : enable\nprecision mediump float;\nvarying float d;\n" +
      "void main() { gl_FragDepthEXT = d; gl_FragColor = vec4(1.0); }\n",
    ),
    "gl_FragDepthEXT",
    "gl_FragDepthEXT",
  )
  absent(
    frag(
      "#extension GL_OES_texture_3D : enable\nprecision mediump float;\nuniform mediump sampler3D vol;\n" +
      "varying vec3 v;\nvoid main() { gl_FragColor = texture3D(vol, v); }\n",
    ),
    "texture3D",
    "texture3D (OES_texture_3D)",
  )
}

///| `#define VARYING varying` keeps the removed `varying` keyword in a 410 core shader.
test "redteam_p1_storage_keyword_inside_define" {
  absent(
    vert("#define VARYING varying\nattribute vec4 p;\nVARYING vec2 vUv;\nvoid main() { vUv = p.xy; gl_Position = p; }\n"),
    "varying",
    "#define VARYING varying",
  )
}

///| Non-literal gl_FragData index next to a literal one: array sized from the literal only ("Index 2 beyond bounds").
test "redteam_p1_fragdata_const_expr_index_undersized" {
  present(
    frag(
      "#extension GL_EXT_draw_buffers : require\nprecision mediump float;\n" +
      "void main() { gl_FragData[0] = vec4(1.0); gl_FragData[1 + 1] = vec4(0.5); }\n",
    ),
    "out vec4 _fv_gl_FragData[8]",
    "gl_FragData[1 + 1]",
  )
}

///| ES 3.00 packing built-ins are GLSL 4.20; macOS 4.1 has no GL_ARB_shading_language_packing, so they need
///| polyfills (or a clear error) instead of an "undeclared identifier" from the driver.
test "redteam_p1_es300_pack_half_snorm_need_polyfill" {
  let out = frag(
    "#version 300 es\nprecision highp float;\nuniform vec4 v;\nout vec4 o;\n" +
    "void main() { uint h = packHalf2x16(v.xy); o = vec4(unpackHalf2x16(h), 0.0, 1.0); }\n",
  )
  debug_assert(
    contains(out, "ERR ") || contains(out, "packHalf2x16(vec2") || contains(out, "packHalf2x16(in vec2"),
    "packHalf2x16 neither polyfilled nor rejected:\n" + out,
  )
}

// ---------------------------------------------------------------- P2 ----------------------------------------------

test "redteam_p2_internal_prefix_collision" {
  let out = frag(
    "precision mediump float;\nuniform vec4 _fv_gl_FragColor;\nvoid main() { gl_FragColor = _fv_gl_FragColor; }\n",
  )
  absent(out, "uniform vec4 _fv_gl_FragColor", "user identifier _fv_gl_FragColor")
}

test "redteam_p2_stage_check_ignores_preprocessor_branches" {
  ok(
    vert(
      "#define VERTEX\n#ifdef VERTEX\nattribute vec4 p;\nvoid main() { gl_Position = p; }\n#else\n" +
      "precision mediump float;\nvoid main() { gl_FragColor = vec4(1.0); }\n#endif\n",
    ),
    "single-source uber shader",
  )
}

test "redteam_p2_brace_balance_across_if_else" {
  ok(
    vert(
      "attribute vec4 p;\n#ifdef FLIP\nvoid main() { gl_Position = -p;\n#else\nvoid main() { gl_Position = p;\n#endif\n}\n",
    ),
    "#ifdef-split braces",
  )
}

test "redteam_p2_int_overflow_in_sizes_and_indices" {
  match
  glsl::parse_and_reflect(
    "attribute vec4 p;\nuniform vec4 a[99999999999999999999];\nvoid main(){gl_Position=p;}\n",
    glsl::ShaderStage::Vertex,
  ) {
    Ok(r) =>
    debug_assert(
      r.uniforms[0].array_size == -1,
      "20-digit array size reflected as " + r.uniforms[0].array_size.to_string(),
    )
    Err(_) => ()
  }
  let out = frag(
    "#extension GL_EXT_draw_buffers : require\nprecision mediump float;\n" +
    "void main(){gl_FragData[2147483647]=vec4(1.0);}\n",
  )
  absent(out, "[-2147483648]", "gl_FragData[2147483647]")
  match
  glsl::parse_and_reflect(
    "#extension GL_EXT_draw_buffers : require\nprecision mediump float;\n" +
    "void main(){gl_FragData[4294967296]=vec4(1.0);}\n",
    glsl::ShaderStage::Fragment,
  ) {
    Ok(r) =>
    debug_assert(
      r.max_frag_data_index != 0,
      "gl_FragData[4294967296] reflected as index 0 (32-bit wrap)",
    )
    Err(_) => ()
  }
}

test "redteam_p2_line_continuation_splits_tokens" {
  let out = frag(
    "#version 300 es\nprecision mediump float;\nout vec4 o;\n" +
    "void main(){ float x = 1\\\n0.0; int i = 0; i +\\\n= 2; o = vec4(x); }\n",
  )
  present(out, "10.0", "1\\<newline>0.0")
  absent(out, "+ =", "+\\<newline>=")
}

test "redteam_p2_es300_accepts_removed_es100_builtins" {
  let out = frag(
    "#version 300 es\nprecision mediump float;\nuniform sampler2D s;\nin vec2 v;\nout vec4 o;\n" +
    "void main(){ gl_FragColor = texture2D(s, v); }\n",
  )
  debug_assert(contains(out, "ERR "), "ES 3.00 gl_FragColor/texture2D accepted and passed to 410:\n" + out)
}

// ---------------------------------------------------------------- controls ----------------------------------------

test "control_es100_basic_roundtrip" {
  let out = frag(
    "precision mediump float;\nuniform sampler2D map;\nvarying vec2 vUv;\n" +
    "void main() { gl_FragColor = texture2D(map, vUv); }\n",
  )
  present(out, "#version 410 core", "basic")
  present(out, "out vec4 _fv_gl_FragColor;", "basic")
  present(out, "in vec2 vUv;", "basic")
  absent(out, "texture2D", "basic")
  absent(out, "precision", "basic")
}

test "control_struct_member_named_like_builtin_untouched" {
  let out = frag(
    "precision mediump float;\nstruct S { vec4 texture2D; };\nuniform S s;\n" +
    "void main() { gl_FragColor = s.texture2D; }\n",
  )
  present(out, "s.texture2D", "member access")
}

test "control_texture_rewrites_es100" {
  let out = frag(
    "#extension GL_EXT_shader_texture_lod : enable\nprecision mediump float;\nuniform sampler2D s;\n" +
    "uniform samplerCube c;\nvarying vec2 v;\nvoid main() {\n  gl_FragColor = texture2D(s, v) + " +
    "texture2DProj(s, vec3(v, 1.0)) + textureCube(c, vec3(v, 1.0)) + texture2DLodEXT(s, v, 1.0) + " +
    "textureCubeLodEXT(c, vec3(v, 1.0), 1.0);\n}\n",
  )
  absent(out, "texture2D", "rewrites")
  absent(out, "textureCube", "rewrites")
  absent(out, "GL_EXT_shader_texture_lod", "extension stripped")
}

test "control_limits_boundaries" {
  let src = "precision mediump float;\nvoid main(){gl_FragColor=vec4(1.0);}\n"
  let n = src.length()
  let fr = glsl::ShaderStage::Fragment
  let at = glsl::parse_and_reflect_with_limits(src, fr, glsl::ParseLimits::new(n, 0, 0, 0, 0))
  let over = glsl::parse_and_reflect_with_limits(src, fr, glsl::ParseLimits::new(n - 1, 0, 0, 0, 0))
  let neg = glsl::parse_and_reflect_with_limits(src, fr, glsl::ParseLimits::new(-1, -1, -1, -1, -1))
  debug_assert(
    match at {
      Ok(_) => true
      Err(_) => false
    },
    "exact max_source_bytes rejected",
  )
  debug_assert(
    match over {
      Err(glsl::GlslError::LimitExceeded(_)) => true
      _ => false
    },
    "max_source_bytes - 1 accepted",
  )
  debug_assert(
    match neg {
      Ok(_) => true
      Err(_) => false
    },
    "-1 limits must mean unlimited",
  )
  // 17 tokens exactly: `precision mediump float ;` (4) + `void main ( ) { gl_FragColor = vec4 ( 1.0 ) ; }` (13)
  let tok_ok = glsl::parse_and_reflect_with_limits(src, fr, glsl::ParseLimits::new(0, 17, 0, 0, 0))
  let tok_over = glsl::parse_and_reflect_with_limits(src, fr, glsl::ParseLimits::new(0, 16, 0, 0, 0))
  debug_assert(
    match tok_ok {
      Ok(_) => true
      Err(_) => false
    },
    "exact max_tokens rejected",
  )
  debug_assert(
    match tok_over {
      Err(glsl::GlslError::LimitExceeded(_)) => true
      _ => false
    },
    "max_tokens - 1 accepted",
  )
}

test "control_define_and_depth_limits_exact" {
  let fr = glsl::ShaderStage::Fragment
  let src = "#define A 1\n#define B 2\n#ifdef A\n#ifdef B\nprecision mediump float;\n#endif\n#endif\n" +
  "void main(){gl_FragColor=vec4(((1.0)));}\n"
  let cases = [
    (glsl::ParseLimits::new(0, 0, 0, 0, 2), true), (glsl::ParseLimits::new(0, 0, 0, 0, 1), false),
    (glsl::ParseLimits::new(0, 0, 0, 2, 0), true), (glsl::ParseLimits::new(0, 0, 0, 1, 0), false),
    (glsl::ParseLimits::new(0, 0, 4, 0, 0), true), (glsl::ParseLimits::new(0, 0, 3, 0, 0), false),
  ]
  let mut i = 0
  while i < cases.length() {
    let (lim, want_ok) = cases[i]
    let got_ok = match glsl::parse_and_reflect_with_limits(src, fr, lim) {
      Ok(_) => true
      Err(_) => false
    }
    debug_assert(got_ok == want_ok, "limit boundary case " + i.to_string())
    i = i + 1
  }
}

test "control_hostile_bytes_rejected_without_panic" {
  let fr = glsl::ShaderStage::Fragment
  let cases = [
    "precision mediump float;\nvo\u{0}id main(){}\n", "/*", "/*/", "#if 1\n", "#endif\n", "}", "((((", "\u{FEFF}void main(){}",
    "void main(){ float é = 1.0; }",
  ]
  let mut i = 0
  while i < cases.length() {
    match glsl::translate_to_glsl410(cases[i], fr) {
      Ok(_) => debug_assert(false, "hostile input accepted: case " + i.to_string())
      Err(_) => ()
    }
    i = i + 1
  }
}

test "control_comment_bytes_tolerated" {
  ok(frag("// é ünïcode ✓\nprecision mediump float;\nvoid main(){gl_FragColor=vec4(1.0);}\n"), "utf-8 comment")
  ok(frag("precision mediump float;\r\nvoid main(){gl_FragColor=vec4(1.0);}\r"), "CR / CRLF")
}

test "control_es300_layout_and_blocks_reflected" {
  match
  glsl::parse_and_reflect(
    "#version 300 es\nlayout(std140) uniform Camera { mat4 view; } cam;\nuniform vec3 a, b[2], c;\n" +
    "uniform struct M { float r; } mat;\nlayout(location = 3) in vec4 p;\nflat out int id;\n" +
    "void main() { float local = 1.0; id = 1; gl_Position = p * local; }\n",
    glsl::ShaderStage::Vertex,
  ) {
    Ok(r) => {
      debug_assert(r.uniforms.length() == 5, "uniform count " + r.uniforms.length().to_string())
      debug_assert(r.uniforms[0].glsl_type == "uniform_block", "block")
      debug_assert(r.uniforms[2].array_size == 2, "b[2]")
      debug_assert(r.uniforms[4].glsl_type == "M", "struct uniform type")
      debug_assert(r.attributes[0].location == 3, "location")
      debug_assert(r.varyings[0].name == "id", "flat out")
    }
    Err(e) => debug_assert(false, glsl::glsl_error_message(e))
  }
}
