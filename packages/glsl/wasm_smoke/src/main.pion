///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/glsl`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "glsl"

fn fnv1a_32_str(s : String) -> UInt {
  let mut h : UInt = 2166136261U
  let mut i = 0
  let n = s.length()
  while i < n {
    h = (h ^ s.code_unit_at(i).to_uint()) * 16777619U
    i = i + 1
  }
  h
}

pub fn main(world : World) -> Int {
  let es100_vs =
  "precision highp float;\n" +
  "attribute vec3 aPos;\n" +
  "attribute vec2 aUv;\n" +
  "uniform mat4 uMvp;\n" +
  "varying vec2 vUv;\n" +
  "void main() {\n" +
  "  vUv = aUv;\n" +
  "  gl_Position = uMvp * vec4(aPos, 1.0);\n" +
  "}\n"

  let es100_fs =
  "#extension GL_OES_standard_derivatives : enable\n" +
  "#define USE_MAP\n" +
  "precision mediump float;\n" +
  "uniform sampler2D uMap;\n" +
  "varying vec2 vUv;\n" +
  "void main() {\n" +
  "  vec4 c = texture2D(uMap, vUv);\n" +
  "  gl_FragColor = c;\n" +
  "}\n"

  let es300_fs =
  "#version 300 es\n" +
  "precision highp float;\n" +
  "uniform sampler2DArray uTex;\n" +
  "in vec2 vUv;\n" +
  "layout(location = 0) out vec4 fragColor;\n" +
  "void main() {\n" +
  "  fragColor = texture(uTex, vec3(vUv, 0.0));\n" +
  "}\n"

  let t1 = match glsl::translate_to_glsl410(es100_vs, glsl::ShaderStage::Vertex) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "ERR es100_vs: " + glsl::glsl_error_message(e))
      return 1
    }
  }
  let t2 = match glsl::translate_to_glsl410(es100_fs, glsl::ShaderStage::Fragment) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "ERR es100_fs: " + glsl::glsl_error_message(e))
      return 2
    }
  }
  let t3 = match glsl::translate_to_glsl410(es300_fs, glsl::ShaderStage::Fragment) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "ERR es300_fs: " + glsl::glsl_error_message(e))
      return 3
    }
  }

  let lim_ok = match glsl::translate_to_glsl410_with_limits(
    es100_fs,
    glsl::ShaderStage::Fragment,
    glsl::ParseLimits::new(16, 0, 0, 0, 0),
  ) {
    Err(glsl::GlslError::LimitExceeded(_)) => true
    _ => false
  }
  if !lim_ok {
    io_println(world, "ERR limit not enforced")
    return 4
  }

  io_println(world, "glsl_wasm_smoke:ok")
  io_println(
    world,
    "es100_vs attrs=" + t1.reflection.attributes.length().to_string() +
    " uniforms=" + t1.reflection.uniforms.length().to_string() +
    " varyings=" + t1.reflection.varyings.length().to_string() +
    " len=" + t1.glsl410.length().to_string() +
    " fnv=" + fnv1a_32_str(t1.glsl410).to_int64().to_string(),
  )
  io_println(
    world,
    "es100_fs uniforms=" + t2.reflection.uniforms.length().to_string() +
    " varyings=" + t2.reflection.varyings.length().to_string() +
    " exts=" + t2.reflection.extensions.length().to_string() +
    " frag_color=" + t2.reflection.uses_frag_color.to_string() +
    " len=" + t2.glsl410.length().to_string() +
    " fnv=" + fnv1a_32_str(t2.glsl410).to_int64().to_string(),
  )
  io_println(
    world,
    "es300_fs uniforms=" + t3.reflection.uniforms.length().to_string() +
    " varyings=" + t3.reflection.varyings.length().to_string() +
    " outputs=" + t3.reflection.outputs.length().to_string() +
    " len=" + t3.glsl410.length().to_string() +
    " fnv=" + fnv1a_32_str(t3.glsl410).to_int64().to_string(),
  )
  0
}
