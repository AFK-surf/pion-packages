}

///| Identifiers that are legal in GLSL ES 3.00 but are keywords or reserved words in GLSL 4.10 Core
///| (or collide with our `_fv_` internal namespace).
fn needs_rename_es300(name : String) -> Bool {
  if starts_with(name, "_fv_") {
    return true
  }
  name == "precise" ||
  name == "sample" ||
  name == "noperspective" ||
  name == "patch" ||
  name == "subroutine" ||
  name == "common" ||
  name == "partition" ||
  name == "active" ||
  name == "filter" ||
  name == "resource" ||
  name == "buffer" ||
  name == "shared" ||
  name == "coherent" ||
  name == "readonly" ||
  name == "writeonly" ||
  name == "volatile" ||
  name == "restrict" ||
  name == "atomic_uint" ||
  name == "double" ||
  name == "dvec2" ||
  name == "dvec3" ||
  name == "dvec4" ||
  name == "dmat2" ||
  name == "dmat3" ||
  name == "dmat4" ||
  name == "dmat2x2" ||
  name == "dmat2x3" ||
  name == "dmat2x4" ||
  name == "dmat3x2" ||
  name == "dmat3x3" ||
  name == "dmat3x4" ||
  name == "dmat4x2" ||
  name == "dmat4x3" ||
  name == "dmat4x4" ||
  name == "sampler1D" ||
  name == "sampler1DShadow" ||
  name == "sampler1DArray" ||
  name == "sampler1DArrayShadow" ||
  name == "sampler2DRect" ||
  name == "sampler2DRectShadow" ||
  name == "samplerBuffer" ||
  name == "sampler2DMS" ||
  name == "sampler2DMSArray" ||
  name == "samplerCubeArray" ||
  name == "samplerCubeArrayShadow" ||
  name == "isampler1D" ||
  name == "isampler1DArray" ||
  name == "isampler2DRect" ||
  name == "isamplerBuffer" ||
  name == "isampler2DMS" ||
  name == "isampler2DMSArray" ||
  name == "isamplerCubeArray" ||
  name == "usampler1D" ||
  name == "usampler1DArray" ||
  name == "usampler2DRect" ||
  name == "usamplerBuffer" ||
  name == "usampler2DMS" ||
  name == "usampler2DMSArray" ||
  name == "usamplerCubeArray"
}

fn is_fragment_only_builtin(name : String) -> Bool {
  name == "gl_FragColor" ||
  name == "gl_FragData" ||
  name == "gl_FragDepth" ||
  name == "gl_FragDepthEXT" ||
  name == "gl_FragCoord" ||
  name == "gl_FrontFacing" ||
  name == "gl_PointCoord" ||
  name == "discard"
}

fn is_vertex_only_builtin(name : String) -> Bool {
  name == "gl_Position" ||
  name == "gl_PointSize" ||
  name == "gl_VertexID" ||
  name == "gl_InstanceID"
}

fn map_get_int(m : Map[String, Int], key : String) -> Int {
  match m.get(key) {
    Some(v) => v
    None => -1
  }
}

fn map_has_bool(m : Map[String, Bool], key : String) -> Bool {
  match m.get(key) {
    Some(v) => v
    None => false
  }
}

fn has_string(arr : Array[String], target : String) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

fn clone_int_array(src : Array[Int]) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < src.length() {
    out.push(src[i])
    i = i + 1
  }
  out
}

///| Result of scanning and rewriting a `#define` directive body.
struct DefineScanResult {
  rewritten : String
  saw_frag_color : Bool
  saw_frag_data : Bool
  max_frag_data_idx : Int
  has_dynamic_frag_data : Bool
}

///| Token-level scan and rewrite of a `#define` directive body.
///| Handles ES 1.00 builtins, storage qualifiers (`attribute`/`varying`), precision qualifiers,
///| and keyword/prefix sanitization consistently with the main token pass.
fn rewrite_define_line(
  line_text : String,
  is_es100 : Bool,
  is_vertex : Bool,
  int_defines : Map[String, Int],
) -> DefineScanResult {
  let no_change = DefineScanResult::{
    rewritten: line_text,
    saw_frag_color: false,
    saw_frag_data: false,
    max_frag_data_idx: -1,
    has_dynamic_frag_data: false,
  }
  let n = line_text.length()
  let mut i = 1
  while i < n && is_ws(line_text.code_unit_at(i)) {
    i = i + 1
  }
  let kw_start = i
  while i < n && is_ident_cont(line_text.code_unit_at(i)) {
    i = i + 1
  }
  if line_text.slice(kw_start, i) != "define" {
    return no_change
  }
  while i < n && is_ws(line_text.code_unit_at(i)) {
    i = i + 1
  }
  let name_start = i
  while i < n && is_ident_cont(line_text.code_unit_at(i)) {
    i = i + 1
  }
  let macro_name = line_text.slice(name_start, i)
  // Do not rewrite shim macros that redefine builtins/keywords themselves (e.g. Three.js WebGL2 prelude)
  if rewrite_es100_texture_fn(macro_name) != "" ||
  macro_name == "gl_FragColor" ||
  macro_name == "gl_FragData" ||
  macro_name == "gl_FragDepthEXT" ||
  macro_name == "attribute" ||
  macro_name == "varying" {
    return no_change
  }
  // Skip function-like macro parameter list `(a, b)`
  if i < n && line_text.code_unit_at(i) == 40 {
    while i < n && line_text.code_unit_at(i) != 41 {
      i = i + 1
    }
    if i < n {
      i = i + 1
    }
  }
  if i >= n {
    return no_change
  }

  let sb = StringBuilder::new()
  sb.write_string(line_text.slice(0, i))
  let mut prev_dot = false
  let mut saw_frag_color = false
  let mut saw_frag_data = false
  let mut max_fd_idx = -1
  let mut has_dyn_fd = false

  while i < n {
    let c = line_text.code_unit_at(i)
    if is_ident_start(c) {
      let id_start = i
      i = i + 1
      while i < n && is_ident_cont(line_text.code_unit_at(i)) {
        i = i + 1
      }
      let ident = line_text.slice(id_start, i)
      let mut j = i
      while j < n && is_ws(line_text.code_unit_at(j)) {
        j = j + 1
      }
      let followed_by_lparen = j < n && line_text.code_unit_at(j) == 40
      if prev_dot {
        sb.write_string(ident)
      } else if is_precision_kw(ident) {
        // Strip lowp/mediump/highp inside macro bodies (e.g., `#define PREC highp`)
        ()
      } else if is_es100 {
        if !is_vertex && ident == "gl_FragColor" {
          saw_frag_color = true
          sb.write_string("_fv_gl_FragColor")
        } else if !is_vertex && ident == "gl_FragData" {
          saw_frag_data = true
          sb.write_string("_fv_gl_FragData")
          // Inspect optional `[idx]` subscript right after `gl_FragData`
          if j < n && line_text.code_unit_at(j) == 91 {
            let mut k = j + 1
            while k < n && is_ws(line_text.code_unit_at(k)) {
              k = k + 1
            }
            let idx_start = k
            while k < n && is_ident_cont(line_text.code_unit_at(k)) {
              k = k + 1
            }
            let idx_tok = line_text.slice(idx_start, k)
            while k < n && is_ws(line_text.code_unit_at(k)) {
              k = k + 1
            }
            if k < n && line_text.code_unit_at(k) == 93 && idx_tok.length() > 0 {
              let mut idx = parse_nonneg_int(idx_tok)
              if idx < 0 {
                idx = map_get_int(int_defines, idx_tok)
              }
              if idx >= 0 && idx < 8 {
                if idx > max_fd_idx {
                  max_fd_idx = idx
                }
              } else {
                has_dyn_fd = true
              }
            } else {
              has_dyn_fd = true
            }
          } else {
            has_dyn_fd = true
          }
        } else if !is_vertex && ident == "gl_FragDepthEXT" {
          sb.write_string("gl_FragDepth")
        } else if ident == "attribute" && is_vertex {
          sb.write_string("in")
        } else if ident == "varying" {
          sb.write_string(if is_vertex { "out" } else { "in" })
        } else if followed_by_lparen && rewrite_es100_texture_fn(ident) != "" {
          sb.write_string(rewrite_es100_texture_fn(ident))
        } else if needs_rename_es100(ident) {
          sb.write_string("_fv_u_" + ident)
        } else {
          sb.write_string(ident)
        }
      } else {
        // ES 3.00
        if needs_rename_es300(ident) {
          sb.write_string("_fv_u_" + ident)
        } else {
          sb.write_string(ident)
        }
      }
      prev_dot = false
    } else {
      if c == 46 {
        prev_dot = true
      } else if !is_ws(c) {
        prev_dot = false
      }
      sb.write_byte(c.to_byte())
      i = i + 1
    }
  }
  DefineScanResult::{
    rewritten: sb.to_string(),
    saw_frag_color: saw_frag_color,
    saw_frag_data: saw_frag_data,
    max_frag_data_idx: max_fd_idx,
    has_dynamic_frag_data: has_dyn_fd,
  }
}

fn emit_es300_packing_polyfills(
  sb : StringBuilder,
  need_pack_half : Bool,
  need_unpack_half : Bool,
  need_pack_snorm : Bool,
  need_unpack_snorm : Bool,
) -> Unit {
  if need_pack_half {
    sb.write_string(
      "uint _fv_f32_to_f16(float val) {\n" +
      "  uint f = floatBitsToUint(val);\n" +
      "  uint sign = (f >> 16u) & 0x8000u;\n" +
      "  uint exp_bits = (f >> 23u) & 0xFFu;\n" +
      "  uint mant = f & 0x007FFFFFu;\n" +
      "  if (exp_bits == 0xFFu) { return sign | 0x7C00u | (mant != 0u ? 0x0200u : 0u); }\n" +
      "  int e = int(exp_bits) - 112;\n" +
      "  if (e <= 0) {\n" +
      "    if (e < -10) return sign;\n" +
      "    mant = (mant | 0x00800000u) >> uint(1 - e);\n" +
      "    return sign | ((mant + 0x00001000u) >> 13u);\n" +
      "  }\n" +
      "  if (e >= 31) { return sign | 0x7C00u; }\n" +
      "  return sign | (uint(e) << 10u) | ((mant + 0x00001000u) >> 13u);\n" +
      "}\n" +
      "uint packHalf2x16(vec2 v) {\n" +
      "  return _fv_f32_to_f16(v.x) | (_fv_f32_to_f16(v.y) << 16u);\n" +
      "}\n",
    )
  }
  if need_unpack_half {
    sb.write_string(
      "float _fv_f16_to_f32(uint h) {\n" +
      "  uint sign = (h & 0x8000u) << 16u;\n" +
      "  uint exp_bits = (h >> 10u) & 0x1Fu;\n" +
      "  uint mant = h & 0x03FFu;\n" +
      "  if (exp_bits == 0u) {\n" +
      "    if (mant == 0u) return uintBitsToFloat(sign);\n" +
      "    return uintBitsToFloat(sign) + float(mant) * exp2(-24.0);\n" +
      "  }\n" +
      "  if (exp_bits == 31u) { return uintBitsToFloat(sign | 0x7F800000u | (mant << 13u)); }\n" +
      "  return uintBitsToFloat(sign | ((exp_bits + 112u) << 23u) | (mant << 13u));\n" +
      "}\n" +
      "vec2 unpackHalf2x16(uint v) {\n" +
      "  return vec2(_fv_f16_to_f32(v & 0xFFFFu), _fv_f16_to_f32((v >> 16u) & 0xFFFFu));\n" +
      "}\n",
    )
  }
  if need_pack_snorm {
    sb.write_string(
      "uint packSnorm2x16(vec2 v) {\n" +
      "  ivec2 q = ivec2(round(clamp(v, -1.0, 1.0) * 32767.0));\n" +
      "  return (uint(q.x) & 0xFFFFu) | ((uint(q.y) & 0xFFFFu) << 16u);\n" +
      "}\n",
    )
  }
  if need_unpack_snorm {
    sb.write_string(
      "vec2 unpackSnorm2x16(uint v) {\n" +
      "  int lo = int(v << 16u) >> 16;\n" +
      "  int hi = int(v) >> 16;\n" +
      "  return clamp(vec2(float(lo), float(hi)) / 32767.0, -1.0, 1.0);\n" +
      "}\n",
    )
  }
}

fn needs_space_between(
  prev_kind : TokKind,
  prev_text : String,
  cur_kind : TokKind,
  cur_text : String,
) -> Bool {
  let prev_word = match prev_kind {
    TokKind::Ident => true
    TokKind::IntLit => true
    TokKind::FloatLit => true
    _ => false
  }
  let cur_word = match cur_kind {
    TokKind::Ident => true
    TokKind::IntLit => true
    TokKind::FloatLit => true
    _ => false
  }
  if prev_word && cur_word {
    return true
  }
  if prev_text == "," || prev_text == "=" || cur_text == "=" {
    return true
  }
  if prev_text == ")" && (cur_text == "{" || cur_word) {
    return true
  }
  if prev_text == "]" && cur_word {
    return true
  }
  if prev_word && cur_text == "{" {
    return true
  }
  // Prevent accidental token merging between adjacent punctuators (e.g. `+` `+` -> `++`)
  if !prev_word && !cur_word && prev_text.length() > 0 && cur_text.length() > 0 {
    let p = prev_text.code_unit_at(prev_text.length() - 1)
    let q = cur_text.code_unit_at(0)
    if (p == 43 && (q == 43 || q == 61)) ||
    (p == 45 && (q == 45 || q == 61)) ||
    (p == 60 && (q == 60 || q == 61)) ||
    (p == 62 && (q == 62 || q == 61)) ||
    (p == 38 && (q == 38 || q == 61)) ||
    (p == 124 && (q == 124 || q == 61)) ||
    (p == 94 && (q == 94 || q == 61)) ||
    (p == 61 && q == 61) ||
    (p == 33 && q == 61) ||
    (p == 47 && (q == 47 || q == 42 || q == 61)) {
      return true
    }
  }
  false
}

///| Core multi-pass GLSL ES 1.00 / 3.00 validator, reflector, and OpenGL 4.10 Core translator.
fn process_shader(
  source : String,
  stage : ShaderStage,
  limits : ParseLimits,
  do_translate : Bool,
) -> Result[TranslatedShader, GlslError] {
  let tokens = match lex_glsl(source, limits) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let n = tokens.length()
  let is_vertex = match stage {
    ShaderStage::Vertex => true
    ShaderStage::Fragment => false
  }

  // Per-token action: 0 = keep, 1 = skip, 2 = replace with `repls[idx]`
  let actions : Array[Int] = []
  let repls : Array[String] = []
  let mut init_i = 0
  while init_i < n {
    actions.push(0)
    repls.push("")
    init_i = init_i + 1
  }

  let extensions : Array[String] = []
  let defined_macros : Map[String, Bool] = Map::new()
  let int_defines : Map[String, Int] = Map::new()

  let mut version = GlslVersion::Es100
  let mut has_version = false
  let mut seen_non_version = false
  let mut pp_depth = 0
  let mut define_count = 0
  let mut uses_frag_color = false
  let mut uses_frag_data = false
  let mut max_frag_data_index = -1
  let mut has_dynamic_frag_data = false
  let mut need_pack_half = false
  let mut need_unpack_half = false
  let mut need_pack_snorm = false
  let mut need_unpack_snorm = false

  // Bracket stack with per-`#if` snapshots so valid split-brace `#ifdef/#else` code passes
  let mut bstack : Array[Int] = []
  let pp_bstack_snaps : Array[Array[Int]] = []

  // Pass 1: Preprocessor validation, version/extension extraction, nesting balance, stage checks,
  // and flat ES -> 410 token & macro-body rewrites.
  let mut i = 0
  while i < n {
    let tok = tokens[i]
    let is_es100 = match version {
      GlslVersion::Es100 => true
      GlslVersion::Es300 => false
    }
    match tok.kind {
      TokKind::Directive => {
        let words = split_directive_words(tok.text)
        if words.length() > 0 {
          let kw = words[0]
          if kw == "version" {
            if seen_non_version || has_version {
              return Err(
                GlslError::PreprocessorError(
                  tok.line,
                  "#version must be the first directive in the shader",
                ),
              )
            }
            has_version = true
            if words.length() == 2 && words[1] == "100" {
              version = GlslVersion::Es100
            } else if words.length() == 3 && words[1] == "300" && words[2] == "es" {
              version = GlslVersion::Es300
            } else {
              let mut vstr = ""
              let mut k = 1
              while k < words.length() {
                if k > 1 {
                  vstr = vstr + " "
                }
                vstr = vstr + words[k]
                k = k + 1
              }
              return Err(GlslError::UnsupportedVersion(vstr))
            }
            actions[i] = 1
          } else {
            seen_non_version = true
            if kw == "extension" {
              if words.length() < 4 || words[2] != ":" {
                return Err(
                  GlslError::PreprocessorError(tok.line, "malformed #extension directive"),
                )
              }
              let ext_name = words[1]
              let behavior = words[3]
              if behavior != "enable" &&
              behavior != "require" &&
              behavior != "warn" &&
              behavior != "disable" {
                return Err(
                  GlslError::PreprocessorError(
                    tok.line,
                    "invalid #extension behavior: " + behavior,
                  ),
                )
              }
              if !has_string(extensions, ext_name) {
                extensions.push(ext_name)
              }
              if is_es_stripped_extension(ext_name) {
                actions[i] = 1
              }
            } else if kw == "if" || kw == "ifdef" || kw == "ifndef" {
              pp_depth = pp_depth + 1
              if limits.max_preprocessor_depth > 0 && pp_depth > limits.max_preprocessor_depth {
                return Err(
                  GlslError::LimitExceeded(
                    "preprocessor nesting depth exceeds " +
                    limits.max_preprocessor_depth.to_string(),
                  ),
                )
              }
              pp_bstack_snaps.push(clone_int_array(bstack))
            } else if kw == "else" || kw == "elif" {
              if pp_depth <= 0 {
                return Err(
                  GlslError::PreprocessorError(
                    tok.line,
                    "unexpected #" + kw + " without matching #if",
                  ),
                )
              }
              // Restore bracket stack to entry of the matching `#if` so split-brace branches balance
              if pp_bstack_snaps.length() > 0 {
                bstack = clone_int_array(pp_bstack_snaps[pp_bstack_snaps.length() - 1])
              }
            } else if kw == "endif" {
              if pp_depth <= 0 {
                return Err(
                  GlslError::PreprocessorError(
                    tok.line,
                    "unexpected #endif without matching #if",
                  ),
                )
              }
              pp_depth = pp_depth - 1
              if pp_bstack_snaps.length() > 0 {
                let _ = pp_bstack_snaps.pop()
              }
            } else if kw == "define" {
              define_count = define_count + 1
              if limits.max_defines > 0 && define_count > limits.max_defines {
                return Err(
                  GlslError::LimitExceeded(
                    "define count exceeds max_defines " + limits.max_defines.to_string(),
                  ),
                )
              }
              if words.length() >= 2 {
                // Extract pure identifier name (strip `(` if function-like macro `FOO(x)`)
                let raw_name = words[1]
                let mut mlen = 0
                while mlen < raw_name.length() && is_ident_cont(raw_name.code_unit_at(mlen)) {
                  mlen = mlen + 1
                }
                if mlen > 0 {
                  let mname = raw_name.slice(0, mlen)
                  defined_macros.set(mname, true)
                  if mlen == raw_name.length() && words.length() >= 3 {
                    let parsed = parse_nonneg_int(words[2])
                    if parsed >= 0 {
                      int_defines.set(mname, parsed)
                    } else {
                      let _ = int_defines.remove(mname)
                    }
                  }
                }
              }
              // Scan & rewrite `#define` body consistently for both reflection and translation
              let dscan = rewrite_define_line(tok.text, is_es100, is_vertex, int_defines)
              if dscan.saw_frag_color {
                uses_frag_color = true
              }
              if dscan.saw_frag_data {
                uses_frag_data = true
                if dscan.has_dynamic_frag_data {
                  has_dynamic_frag_data = true
                } else if dscan.max_frag_data_idx > max_frag_data_index {
                  max_frag_data_index = dscan.max_frag_data_idx
                }
              }
              if do_translate && dscan.rewritten != tok.text {
                actions[i] = 2
                repls[i] = dscan.rewritten
              }
            } else if kw == "undef" {
              if words.length() >= 2 {
                let _ = defined_macros.remove(words[1])
                let _ = int_defines.remove(words[1])
              }
            }
          }
        } else {
          seen_non_version = true
        }
      }
      TokKind::Punct => {
        seen_non_version = true
        if tok.text == "(" {
          bstack.push(1)
          if limits.max_nesting_depth > 0 && bstack.length() > limits.max_nesting_depth {
            return Err(
              GlslError::LimitExceeded(
                "nesting depth exceeds max_nesting_depth " + limits.max_nesting_depth.to_string(),
              ),
            )
          }
        } else if tok.text == "{" {
          bstack.push(2)
          if limits.max_nesting_depth > 0 && bstack.length() > limits.max_nesting_depth {
            return Err(
              GlslError::LimitExceeded(
                "nesting depth exceeds max_nesting_depth " + limits.max_nesting_depth.to_string(),
              ),
            )
          }
        } else if tok.text == "[" {
          bstack.push(3)
          if limits.max_nesting_depth > 0 && bstack.length() > limits.max_nesting_depth {
            return Err(
              GlslError::LimitExceeded(
                "nesting depth exceeds max_nesting_depth " + limits.max_nesting_depth.to_string(),
              ),
            )
          }
        } else if tok.text == ")" {
          if bstack.length() == 0 || bstack[bstack.length() - 1] != 1 {
            return Err(GlslError::ParseError(tok.line, "unmatched ')'"))
          }
          let _ = bstack.pop()
        } else if tok.text == "}" {
          if bstack.length() == 0 || bstack[bstack.length() - 1] != 2 {
            return Err(GlslError::ParseError(tok.line, "unmatched '}'"))
          }
          let _ = bstack.pop()
        } else if tok.text == "]" {
          if bstack.length() == 0 || bstack[bstack.length() - 1] != 3 {
            return Err(GlslError::ParseError(tok.line, "unmatched ']'"))
          }
          let _ = bstack.pop()
        }
      }
      TokKind::Ident => {
        seen_non_version = true
        let prev_is_dot = i > 0 && tokens[i - 1].text == "."
        if !prev_is_dot {
          let is_macro = map_has_bool(defined_macros, tok.text)
          // Unconditional stage checks (skip inside `#if` branches to allow single-source uber shaders)
          if pp_depth == 0 && !is_macro {
            if is_vertex {
              if is_fragment_only_builtin(tok.text) {
                return Err(
                  GlslError::StageMismatch(
                    "fragment-only symbol '" + tok.text + "' used in vertex shader",
                  ),
                )
              }
            } else {
              if is_vertex_only_builtin(tok.text) {
                return Err(
                  GlslError::StageMismatch(
                    "vertex-only symbol '" + tok.text + "' used in fragment shader",
                  ),
                )
              }
            }
          }

          // Strip precision qualifiers everywhere
          if is_precision_kw(tok.text) {
            actions[i] = 1
          } else if is_es100 {
            if !is_vertex && tok.text == "gl_FragColor" {
              uses_frag_color = true
              if do_translate {
                actions[i] = 2
                repls[i] = "_fv_gl_FragColor"
              }
            } else if !is_vertex && tok.text == "gl_FragData" {
              uses_frag_data = true
              if do_translate {
                actions[i] = 2
                repls[i] = "_fv_gl_FragData"
              }
              if i + 3 < n && tokens[i + 1].text == "[" && tokens[i + 3].text == "]" {
                let idx_tok = tokens[i + 2]
                let idx = match idx_tok.kind {
                  TokKind::IntLit => parse_nonneg_int(idx_tok.text)
                  TokKind::Ident => map_get_int(int_defines, idx_tok.text)
                  _ => -1
                }
                if idx >= 0 && idx < 8 {
                  if idx > max_frag_data_index {
                    max_frag_data_index = idx
                  }
                } else {
                  has_dynamic_frag_data = true
                }
              } else {
                has_dynamic_frag_data = true
              }
            } else if !is_vertex && tok.text == "gl_FragDepthEXT" {
              if do_translate {
                actions[i] = 2
                repls[i] = "gl_FragDepth"
              }
            } else if i + 1 < n && tokens[i + 1].text == "(" &&
            rewrite_es100_texture_fn(tok.text) != "" {
              if do_translate {
                actions[i] = 2
                repls[i] = rewrite_es100_texture_fn(tok.text)
              }
            } else if needs_rename_es100(tok.text) {
              if do_translate {
                actions[i] = 2
                repls[i] = "_fv_u_" + tok.text
              }
            }
          } else {
            // GLSL ES 3.00
            // Reject removed ES 1.00 builtins when not redefined via `#define`
            if !is_macro {
              if tok.text == "gl_FragColor" ||
              tok.text == "gl_FragData" ||
              tok.text == "gl_FragDepthEXT" {
                return Err(
                  GlslError::ParseError(
                    tok.line,
                    "'" + tok.text + "' was removed in GLSL ES 3.00",
                  ),
                )
              }
              if i + 1 < n &&
              tokens[i + 1].text == "(" &&
              rewrite_es100_texture_fn(tok.text) != "" {
                return Err(
                  GlslError::ParseError(
                    tok.line,
                    "'" + tok.text + "' was removed in GLSL ES 3.00",
                  ),
                )
              }
            }
            if i + 1 < n && tokens[i + 1].text == "(" {
              if tok.text == "packHalf2x16" {
                need_pack_half = true
              } else if tok.text == "unpackHalf2x16" {
                need_unpack_half = true
              } else if tok.text == "packSnorm2x16" {
                need_pack_snorm = true
              } else if tok.text == "unpackSnorm2x16" {
                need_unpack_snorm = true
              }
            }
            if needs_rename_es300(tok.text) {
              if do_translate {
                actions[i] = 2
                repls[i] = "_fv_u_" + tok.text
              }
            }
          }
        }
      }
      _ => seen_non_version = true
    }
    i = i + 1
  }

  if pp_depth != 0 {
    return Err(
      GlslError::PreprocessorError(tokens[n - 1].line, "unclosed #if/#ifdef directive"),
    )
  }
  if bstack.length() > 0 {
    return Err(GlslError::ParseError(tokens[n - 1].line, "unclosed bracket or brace"))
  }

  let is_es100 = match version {
    GlslVersion::Es100 => true
    GlslVersion::Es300 => false
  }

  // Pass 2: Top-level declaration parsing & reflection + ES 1.00 storage qualifier rewrites
  let attributes : Array[VarInfo] = []
  let uniforms : Array[VarInfo] = []
  let varyings : Array[VarInfo] = []
  let outputs : Array[VarInfo] = []

  let mut pos = 0
  while pos < n {
    let tok = tokens[pos]
    match tok.kind {
      TokKind::Directive => {
        pos = pos + 1
        continue
      }
      _ => ()
    }

    if tok.text == ";" {
      pos = pos + 1
      continue
    }

    // `precision <lowp|mediump|highp> <type>;`
    if tok.text == "precision" {
      let start = pos
      pos = pos + 1
      while pos < n && tokens[pos].text != ";" {
        pos = pos + 1
      }
      if pos >= n {
        return Err(GlslError::ParseError(tok.line, "missing ';' after precision statement"))
      }
      let mut k = start
      while k <= pos {
        actions[k] = 1
        k = k + 1
      }
      pos = pos + 1
      continue
    }

    // Collect leading qualifiers for a top-level declaration
    let mut location = -1
    let mut storage = ""
    let mut storage_idx = -1
    let mut precision = ""

    let mut reading_quals = true
    while pos < n && reading_quals {
      let qt = tokens[pos]
      if qt.text == "layout" && pos + 1 < n && tokens[pos + 1].text == "(" {
        pos = pos + 2
        let mut ldepth = 1
        while pos < n && ldepth > 0 {
          if tokens[pos].text == "(" {
            ldepth = ldepth + 1
          } else if tokens[pos].text == ")" {
            ldepth = ldepth - 1
            if ldepth == 0 {
              pos = pos + 1
              break
            }
          } else if tokens[pos].text == "location" &&
          pos + 2 < n &&
          tokens[pos + 1].text == "=" {
            let lv = parse_nonneg_int(tokens[pos + 2].text)
            if lv >= 0 {
              location = lv
            }
          }
          pos = pos + 1
        }
      } else if is_interp_or_aux_kw(qt.text) {
        pos = pos + 1
      } else if is_storage_kw(qt.text) {
        storage = qt.text
        storage_idx = pos
        let is_macro = map_has_bool(defined_macros, storage)
        if storage == "attribute" && !is_macro {
          if !is_vertex {
            return Err(
              GlslError::StageMismatch("attribute qualifier is not allowed in fragment shader"),
            )
          }
          if !is_es100 {
            return Err(
              GlslError::ParseError(qt.line, "'attribute' is not valid in GLSL ES 3.00"),
            )
          }
        } else if storage == "varying" && !is_es100 && !is_macro {
          return Err(
            GlslError::ParseError(qt.line, "'varying' is not valid in GLSL ES 3.00"),
          )
        }
        pos = pos + 1
      } else if is_precision_kw(qt.text) {
        precision = qt.text
        pos = pos + 1
      } else {
        reading_quals = false
      }
    }

    if pos >= n {
      break
    }

    // Rewrite ES 1.00 top-level `attribute` / `varying` storage qualifiers
    if is_es100 && storage_idx >= 0 && !map_has_bool(defined_macros, storage) {
      if storage == "attribute" {
        actions[storage_idx] = 2
        repls[storage_idx] = "in"
      } else if storage == "varying" {
        actions[storage_idx] = 2
        repls[storage_idx] = if is_vertex { "out" } else { "in" }
      }
    }

    // `struct [Name] { ... } [vars];`
    let mut type_name = ""
    if tokens[pos].text == "struct" {
      pos = pos + 1
      if pos < n {
        match tokens[pos].kind {
          TokKind::Ident => {
            type_name = tokens[pos].text
            pos = pos + 1
          }
          _ => type_name = "struct"
        }
      }
      if pos < n && tokens[pos].text == "{" {
        let mut sdepth = 1
        pos = pos + 1
        while pos < n && sdepth > 0 {
          if tokens[pos].text == "{" {
            sdepth = sdepth + 1
          } else if tokens[pos].text == "}" {
            sdepth = sdepth - 1
          }
          pos = pos + 1
        }
      }
      if pos < n && tokens[pos].text == ";" {
        pos = pos + 1
        continue
      }
    } else {
      // Interface / Uniform Block: `[layout(...)] uniform BlockName { ... } [inst [arr]];`
      let is_block_storage = storage == "uniform" || storage == "in" || storage == "out"
      if is_block_storage && pos + 1 < n && tokens[pos + 1].text == "{" {
        let block_name = tokens[pos].text
        pos = pos + 2
        let mut bdepth = 1
        while pos < n && bdepth > 0 {
          if tokens[pos].text == "{" {
            bdepth = bdepth + 1
          } else if tokens[pos].text == "}" {
            bdepth = bdepth - 1
          }
          pos = pos + 1
        }
        let mut arr_size = 0
        while pos < n && tokens[pos].text != ";" {
          if tokens[pos].text == "[" && pos + 2 < n && tokens[pos + 2].text == "]" {
            let sz = match tokens[pos + 1].kind {
              TokKind::IntLit => parse_nonneg_int(tokens[pos + 1].text)
              TokKind::Ident => map_get_int(int_defines, tokens[pos + 1].text)
              _ => -1
            }
            arr_size = if sz >= 0 { sz } else { -1 }
            pos = pos + 3
          } else {
            pos = pos + 1
          }
        }
        if pos < n && tokens[pos].text == ";" {
          pos = pos + 1
        }
        if storage == "uniform" {
          uniforms.push(VarInfo::new(block_name, "uniform_block", arr_size, location, precision))
        }
        continue
      }

      // Normal type specifier
      match tokens[pos].kind {
        TokKind::Ident => {
          type_name = tokens[pos].text
          pos = pos + 1
        }
        _ => {
          pos = pos + 1
          continue
        }
      }
    }

    // Optional type-level array specifier `vec3[4]`
    let mut type_arr_size = 0
    if pos < n && tokens[pos].text == "[" {
      pos = pos + 1
      if pos < n && tokens[pos].text == "]" {
        type_arr_size = -1
        pos = pos + 1
      } else if pos + 1 < n && tokens[pos + 1].text == "]" {
        let sz = match tokens[pos].kind {
          TokKind::IntLit => parse_nonneg_int(tokens[pos].text)
          TokKind::Ident => map_get_int(int_defines, tokens[pos].text)
          _ => -1
        }
        type_arr_size = if sz >= 0 { sz } else { -1 }
        pos = pos + 2
      } else {
        type_arr_size = -1
        while pos < n && tokens[pos].text != "]" {
          pos = pos + 1
        }
        if pos < n {
          pos = pos + 1
        }
      }
    }

    if pos >= n {
      break
    }

    // Function declaration / definition: `<type> <name> (`
    let is_func = pos + 1 < n && tokens[pos + 1].text == "("
    if is_func {
      pos = pos + 2
      let mut pdepth = 1
      while pos < n && pdepth > 0 {
        if tokens[pos].text == "(" {
          pdepth = pdepth + 1
        } else if tokens[pos].text == ")" {
          pdepth = pdepth - 1
        }
        pos = pos + 1
      }
      if pos < n && tokens[pos].text == ";" {
        pos = pos + 1
      } else if pos < n && tokens[pos].text == "{" {
        let mut fdepth = 1
        pos = pos + 1
        while pos < n && fdepth > 0 {
          if tokens[pos].text == "{" {
            fdepth = fdepth + 1
          } else if tokens[pos].text == "}" {
            fdepth = fdepth - 1
          }
          pos = pos + 1
        }
      }
      continue
    }

    // Variable declarator list: `a, b[4], c = expr;`
    let mut parsing_decls = true
    while pos < n && parsing_decls {
      match tokens[pos].kind {
        TokKind::Ident => {
          let var_name = tokens[pos].text
          pos = pos + 1
          let mut arr_size = type_arr_size
          if pos < n && tokens[pos].text == "[" {
            pos = pos + 1
            if pos < n && tokens[pos].text == "]" {
              arr_size = -1
              pos = pos + 1
            } else if pos + 1 < n && tokens[pos + 1].text == "]" {
              let sz = match tokens[pos].kind {
                TokKind::IntLit => parse_nonneg_int(tokens[pos].text)
                TokKind::Ident => map_get_int(int_defines, tokens[pos].text)
                _ => -1
              }
              arr_size = if sz >= 0 { sz } else { -1 }
              pos = pos + 2
            } else {
              arr_size = -1
              let mut adepth = 1
              while pos < n && adepth > 0 {
                if tokens[pos].text == "[" {
                  adepth = adepth + 1
                } else if tokens[pos].text == "]" {
                  adepth = adepth - 1
                }
                pos = pos + 1
              }
            }
          }

          // Skip optional `= initializer` up to `,` or `;` at depth 0
          if pos < n && tokens[pos].text == "=" {
            pos = pos + 1
            let mut edepth = 0
            while pos < n {
              let et = tokens[pos]
              if et.text == "(" || et.text == "[" || et.text == "{" {
                edepth = edepth + 1
              } else if et.text == ")" || et.text == "]" || et.text == "}" {
                if edepth > 0 {
                  edepth = edepth - 1
                }
              } else if edepth == 0 && (et.text == "," || et.text == ";") {
                break
              }
              pos = pos + 1
            }
          }

          // Record reflected variable (always using original source name)
          let info = VarInfo::new(var_name, type_name, arr_size, location, precision)
          if storage == "uniform" {
            uniforms.push(info)
          } else if is_es100 {
            if storage == "attribute" {
              attributes.push(info)
            } else if storage == "varying" {
              varyings.push(info)
            }
          } else {
            // GLSL ES 3.00 (including Three.js `#define attribute in` / `#define varying out|in`)
            if is_vertex {
              if storage == "in" || storage == "attribute" {
                attributes.push(info)
              } else if storage == "out" || storage == "varying" {
                varyings.push(info)
              }
            } else {
              if storage == "in" || storage == "varying" {
                varyings.push(info)
              } else if storage == "out" {
                outputs.push(info)
              }
            }
          }

          if pos < n && tokens[pos].text == "," {
            pos = pos + 1
          } else {
            if pos < n && tokens[pos].text == ";" {
              pos = pos + 1
            }
            parsing_decls = false
          }
        }
        _ => {
          while pos < n && tokens[pos].text != ";" && tokens[pos].text != "}" {
            pos = pos + 1
          }
          if pos < n {
            pos = pos + 1
          }
          parsing_decls = false
        }
      }
    }
  }

  let refl = Reflection::{
    version: version,
    stage: stage,
    attributes: attributes,
    uniforms: uniforms,
    varyings: varyings,
    outputs: outputs,
    extensions: extensions,
    uses_frag_color: uses_frag_color,
    uses_frag_data: uses_frag_data,
    max_frag_data_index: max_frag_data_index,
  }

  if !do_translate {
    return Ok(TranslatedShader::{ glsl410: "", reflection: refl })
  }

  // Pass 3: Emit OpenGL 4.10 Core GLSL with `#line` mapping
  let sb = StringBuilder::new()
  sb.write_string("#version 410 core\n")
  if is_es100 && !is_vertex {
    if uses_frag_color {
      sb.write_string("out vec4 _fv_gl_FragColor;\n")
    }
    if uses_frag_data {
      let count = if has_dynamic_frag_data || max_frag_data_index < 0 || max_frag_data_index >= 8 {
        8
      } else {
        max_frag_data_index + 1
      }
      sb.write_string("out vec4 _fv_gl_FragData[" + count.to_string() + "];\n")
    }
  }
  if !is_es100 && (need_pack_half || need_unpack_half || need_pack_snorm || need_unpack_snorm) {
    emit_es300_packing_polyfills(
      sb,
      need_pack_half,
      need_unpack_half,
      need_pack_snorm,
      need_unpack_snorm,
    )
  }

  let mut at_bol = true
  let mut has_prev = false
  let mut prev_kind = TokKind::Eof
  let mut prev_text = ""
  let mut cur_out_line = 0

  let mut idx = 0
  while idx < n {
    let act = actions[idx]
    if act == 1 {
      idx = idx + 1
      continue
    }
    let tok = tokens[idx]
    let out_text = if act == 2 { repls[idx] } else { tok.text }
    match tok.kind {
      TokKind::Directive => {
        if !at_bol {
          sb.write_byte((10).to_byte())
        }
        sb.write_string(out_text)
        sb.write_byte((10).to_byte())
        at_bol = true
        has_prev = false
        cur_out_line = tok.line + 1
      }
      _ => {
        if at_bol && tok.line > 0 && tok.line != cur_out_line {
          sb.write_string("#line " + tok.line.to_string() + "\n")
          cur_out_line = tok.line
        }
        if has_prev && needs_space_between(prev_kind, prev_text, tok.kind, out_text) {
          sb.write_byte((32).to_byte())
        }
        sb.write_string(out_text)
        if out_text == ";" || out_text == "{" || out_text == "}" {
          sb.write_byte((10).to_byte())
          at_bol = true
          has_prev = false
          cur_out_line = cur_out_line + 1
        } else {
          at_bol = false
          has_prev = true
          prev_kind = tok.kind
          prev_text = out_text
        }
      }
    }
    idx = idx + 1
  }

  if !at_bol {
    sb.write_byte((10).to_byte())
  }

  Ok(TranslatedShader::{ glsl410: sb.to_string(), reflection: refl })
}

///| Parse and reflect a GLSL ES 1.00 or 3.00 shader using default `ParseLimits`.
pub fn parse_and_reflect(
  source : String,
  stage : ShaderStage,
) -> Result[Reflection, GlslError] {
  parse_and_reflect_with_limits(source, stage, ParseLimits::default())
}

///| Parse and reflect a GLSL ES 1.00 or 3.00 shader with explicit `ParseLimits`.
pub fn parse_and_reflect_with_limits(
  source : String,
  stage : ShaderStage,
  limits : ParseLimits,
) -> Result[Reflection, GlslError] {
  match process_shader(source, stage, limits, false) {
    Ok(t) => Ok(t.reflection)
    Err(e) => Err(e)
  }
}

///| Translate a GLSL ES 1.00 or 3.00 shader to OpenGL 4.10 Core using default `ParseLimits`.
pub fn translate_to_glsl410(
  source : String,
  stage : ShaderStage,
) -> Result[TranslatedShader, GlslError] {
  translate_to_glsl410_with_limits(source, stage, ParseLimits::default())
}

///| Translate a GLSL ES 1.00 or 3.00 shader to OpenGL 4.10 Core with explicit `ParseLimits`.
pub fn translate_to_glsl410_with_limits(
  source : String,
  stage : ShaderStage,
  limits : ParseLimits,
) -> Result[TranslatedShader, GlslError] {
  process_shader(source, stage, limits, true)
}
