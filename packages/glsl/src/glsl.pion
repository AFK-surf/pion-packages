///| GLSL ES 1.00 / 3.00 preprocessor validation, reflection, and OpenGL 4.10 Core translation.

fn is_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 11 || c == 12
}

fn starts_with(s : String, prefix : String) -> Bool {
  let plen = prefix.length()
  if s.length() < plen {
    return false
  }
  let mut i = 0
  while i < plen {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn parse_nonneg_int(s : String) -> Int {
  let n = s.length()
  if n == 0 {
    return -1
  }
  // Hex literal
  if n > 2 && s.code_unit_at(0) == 48 &&
  (s.code_unit_at(1) == 120 || s.code_unit_at(1) == 88) {
    let mut acc = 0
    let mut i = 2
    while i < n {
      let c = s.code_unit_at(i)
      if c == 117 || c == 85 {
        break
      }
      let d = if c >= 48 && c <= 57 {
        c - 48
      } else if c >= 65 && c <= 70 {
        c - 55
      } else if c >= 97 && c <= 102 {
        c - 87
      } else {
        return -1
      }
      acc = acc * 16 + d
      i = i + 1
    }
    return acc
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 117 || c == 85 {
      if i == 0 {
        return -1
      }
      break
    }
    if c < 48 || c > 57 {
      return -1
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  acc
}

///| Split a preprocessor directive line (starting with `#`) into whitespace/colon-separated words.
fn split_directive_words(line_text : String) -> Array[String] {
  let out : Array[String] = []
  let n = line_text.length()
  let mut i = 1 // skip '#'
  while i < n {
    while i < n && is_ws(line_text.code_unit_at(i)) {
      i = i + 1
    }
    if i >= n {
      break
    }
    if line_text.code_unit_at(i) == 58 {
      out.push(":")
      i = i + 1
      continue
    }
    let start = i
    while i < n && !is_ws(line_text.code_unit_at(i)) && line_text.code_unit_at(i) != 58 {
      i = i + 1
    }
    out.push(line_text.slice(start, i))
  }
  out
}

fn is_es_stripped_extension(ext : String) -> Bool {
  ext == "all" ||
  starts_with(ext, "GL_OES_") ||
  starts_with(ext, "GL_EXT_") ||
  starts_with(ext, "GL_WEBGL_") ||
  starts_with(ext, "GL_ANGLE_") ||
  starts_with(ext, "GL_NV_shadow_samplers")
}

fn is_precision_kw(s : String) -> Bool {
  s == "lowp" || s == "mediump" || s == "highp"
}

fn is_interp_or_aux_kw(s : String) -> Bool {
  s == "invariant" || s == "centroid" || s == "flat" || s == "smooth"
}

fn is_storage_kw(s : String) -> Bool {
  s == "attribute" || s == "varying" || s == "uniform" || s == "in" || s == "out" || s == "const"
}

fn rewrite_es100_texture_fn(name : String) -> String {
  if name == "texture2D" || name == "textureCube" || name == "shadow2D" || name == "shadow2DEXT" {
    "texture"
  } else if name == "texture2DProj" {
    "textureProj"
  } else if name == "texture2DLod" ||
  name == "texture2DLodEXT" ||
  name == "textureCubeLod" ||
  name == "textureCubeLodEXT" {
    "textureLod"
  } else if name == "texture2DGradEXT" || name == "textureCubeGradEXT" {
    "textureGrad"
  } else if name == "texture2DProjLodEXT" {
    "textureProjLod"
  } else {
    ""
  }
}

fn is_fragment_only_builtin(name : String) -> Bool {
  name == "gl_FragColor" ||
  name == "gl_FragData" ||
  name == "gl_FragDepth" ||
  name == "gl_FragCoord" ||
  name == "gl_FrontFacing" ||
  name == "gl_PointCoord" ||
  name == "discard"
}

fn is_vertex_only_builtin(name : String) -> Bool {
  name == "gl_Position" ||
  name == "gl_PointSize" ||
  name == "gl_VertexID" ||
  name == "gl_InstanceID"
}

fn find_int_define(keys : Array[String], vals : Array[Int], name : String) -> Int {
  let mut i = keys.length() - 1
  while i >= 0 {
    if keys[i] == name {
      return vals[i]
    }
    i = i - 1
  }
  -1
}

fn set_int_define(keys : Array[String], vals : Array[Int], name : String, v : Int) -> Unit {
  let mut i = 0
  while i < keys.length() {
    if keys[i] == name {
      vals[i] = v
      return ()
    }
    i = i + 1
  }
  keys.push(name)
  vals.push(v)
}

fn remove_int_define(keys : Array[String], vals : Array[Int], name : String) -> Unit {
  let mut i = 0
  while i < keys.length() {
    if keys[i] == name {
      vals[i] = -1
      return ()
    }
    i = i + 1
  }
}

fn has_string(arr : Array[String], target : String) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

///| Rewrite ES 1.00 texture builtins and gl_FragColor/gl_FragData inside a `#define` body.
fn rewrite_define_line_es100(line_text : String, is_fragment : Bool) -> String {
  let n = line_text.length()
  // Skip `#`, whitespace, `define`, whitespace, macro name, optional `(params)`
  let mut i = 1
  while i < n && is_ws(line_text.code_unit_at(i)) {
    i = i + 1
  }
  let kw_start = i
  while i < n && is_ident_cont(line_text.code_unit_at(i)) {
    i = i + 1
  }
  if line_text.slice(kw_start, i) != "define" {
    return line_text
  }
  while i < n && is_ws(line_text.code_unit_at(i)) {
    i = i + 1
  }
  let name_start = i
  while i < n && is_ident_cont(line_text.code_unit_at(i)) {
    i = i + 1
  }
  let macro_name = line_text.slice(name_start, i)
  // Do not rewrite shim macros that redefine a texture builtin itself
  if rewrite_es100_texture_fn(macro_name) != "" ||
  macro_name == "gl_FragColor" ||
  macro_name == "gl_FragData" {
    return line_text
  }
  // Skip function-like macro parameter list `(a, b)`
  if i < n && line_text.code_unit_at(i) == 40 {
    while i < n && line_text.code_unit_at(i) != 41 {
      i = i + 1
    }
    if i < n {
      i = i + 1
    }
  }
  if i >= n {
    return line_text
  }
  let sb = StringBuilder::new()
  sb.write_string(line_text.slice(0, i))
  let mut prev_dot = false
  while i < n {
    let c = line_text.code_unit_at(i)
    if is_ident_start(c) {
      let id_start = i
      i = i + 1
      while i < n && is_ident_cont(line_text.code_unit_at(i)) {
        i = i + 1
      }
      let ident = line_text.slice(id_start, i)
      // Look ahead past whitespace for `(`
      let mut j = i
      while j < n && is_ws(line_text.code_unit_at(j)) {
        j = j + 1
      }
      let followed_by_lparen = j < n && line_text.code_unit_at(j) == 40
      if !prev_dot && is_fragment && ident == "gl_FragColor" {
        sb.write_string("_fv_gl_FragColor")
      } else if !prev_dot && is_fragment && ident == "gl_FragData" {
        sb.write_string("_fv_gl_FragData")
      } else if !prev_dot && followed_by_lparen {
        let rw = rewrite_es100_texture_fn(ident)
        if rw != "" {
          sb.write_string(rw)
        } else {
          sb.write_string(ident)
        }
      } else {
        sb.write_string(ident)
      }
      prev_dot = false
    } else {
      if c == 46 {
        prev_dot = true
      } else if !is_ws(c) {
        prev_dot = false
      }
      sb.write_byte(c.to_byte())
      i = i + 1
    }
  }
  sb.to_string()
}

fn needs_space_between(prev_kind : TokKind, prev_text : String, cur_kind : TokKind, cur_text : String) -> Bool {
  let prev_word = match prev_kind {
    TokKind::Ident => true
    TokKind::IntLit => true
    TokKind::FloatLit => true
    _ => false
  }
  let cur_word = match cur_kind {
    TokKind::Ident => true
    TokKind::IntLit => true
    TokKind::FloatLit => true
    _ => false
  }
  if prev_word && cur_word {
    return true
  }
  // Keep readable spacing after `,` and around `=` / binary ops without hurting correctness
  if prev_text == "," || prev_text == "=" || cur_text == "=" {
    return true
  }
  if prev_text == ")" && (cur_text == "{" || cur_word) {
    return true
  }
  if prev_text == "]" && cur_word {
    return true
  }
  if prev_word && cur_text == "{" {
    return true
  }
  // Prevent accidental token merging between adjacent punctuators (e.g. `+` `+` -> `++`)
  if !prev_word && !cur_word && prev_text.length() > 0 && cur_text.length() > 0 {
    let p = prev_text.code_unit_at(prev_text.length() - 1)
    let q = cur_text.code_unit_at(0)
    if (p == 43 && (q == 43 || q == 61)) ||
    (p == 45 && (q == 45 || q == 61)) ||
    (p == 60 && (q == 60 || q == 61)) ||
    (p == 62 && (q == 62 || q == 61)) ||
    (p == 38 && (q == 38 || q == 61)) ||
    (p == 124 && (q == 124 || q == 61)) ||
    (p == 94 && (q == 94 || q == 61)) ||
    (p == 61 && q == 61) ||
    (p == 33 && q == 61) ||
    (p == 47 && (q == 47 || q == 42 || q == 61)) {
      return true
    }
  }
  false
}

///| Core single-pass-lex + reflect + optional GLSL 410 Core translation engine.
fn process_shader(
  source : String,
  stage : ShaderStage,
  limits : ParseLimits,
  do_translate : Bool,
) -> Result[TranslatedShader, GlslError] {
  let tokens = match lex_glsl(source, limits) {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  let n = tokens.length()
  let is_vertex = match stage {
    ShaderStage::Vertex => true
    ShaderStage::Fragment => false
  }

  // Per-token action: 0 = keep, 1 = skip, 2 = replace with `repl[idx]`
  let actions : Array[Int] = []
  let repls : Array[String] = []
  let mut init_i = 0
  while init_i < n {
    actions.push(0)
    repls.push("")
    init_i = init_i + 1
  }

  let extensions : Array[String] = []
  let def_keys : Array[String] = []
  let def_vals : Array[Int] = []

  let mut version = GlslVersion::Es100
  let mut has_version = false
  let mut seen_non_version = false
  let mut pp_depth = 0
  let mut define_count = 0
  let mut uses_frag_color = false
  let mut uses_frag_data = false
  let mut max_frag_data_index = -1

  // Bracket stack for nesting limit & balance validation: 1='(', 2='{', 3='['
  let bstack : Array[Int] = []

  // Pass 1: Preprocessor validation, version/extension extraction, nesting checks, stage checks
  let mut i = 0
  while i < n {
    let tok = tokens[i]
    match tok.kind {
      TokKind::Directive => {
        let words = split_directive_words(tok.text)
        if words.length() > 0 {
          let kw = words[0]
          if kw == "version" {
            if seen_non_version || has_version {
              return Err(
                GlslError::PreprocessorError(
                  tok.line,
                  "#version must be the first directive in the shader",
                ),
              )
            }
            has_version = true
            if words.length() == 2 && words[1] == "100" {
              version = GlslVersion::Es100
            } else if words.length() == 3 && words[1] == "300" && words[2] == "es" {
              version = GlslVersion::Es300
            } else {
              let mut vstr = ""
              let mut k = 1
              while k < words.length() {
                if k > 1 {
                  vstr = vstr + " "
                }
                vstr = vstr + words[k]
                k = k + 1
              }
              return Err(GlslError::UnsupportedVersion(vstr))
            }
            actions[i] = 1
          } else {
            seen_non_version = true
            if kw == "extension" {
              if words.length() < 4 || words[2] != ":" {
                return Err(
                  GlslError::PreprocessorError(tok.line, "malformed #extension directive"),
                )
              }
              let ext_name = words[1]
              let behavior = words[3]
              if behavior != "enable" &&
              behavior != "require" &&
              behavior != "warn" &&
              behavior != "disable" {
                return Err(
                  GlslError::PreprocessorError(
                    tok.line,
                    "invalid #extension behavior: " + behavior,
                  ),
                )
              }
              if !has_string(extensions, ext_name) {
                extensions.push(ext_name)
              }
              if is_es_stripped_extension(ext_name) {
                actions[i] = 1
              }
            } else if kw == "if" || kw == "ifdef" || kw == "ifndef" {
              pp_depth = pp_depth + 1
              if limits.max_preprocessor_depth > 0 && pp_depth > limits.max_preprocessor_depth {
                return Err(
                  GlslError::LimitExceeded(
                    "preprocessor nesting depth exceeds " +
                    limits.max_preprocessor_depth.to_string(),
                  ),
                )
              }
            } else if kw == "else" || kw == "elif" {
              if pp_depth <= 0 {
                return Err(
                  GlslError::PreprocessorError(
                    tok.line,
                    "unexpected #" + kw + " without matching #if",
                  ),
                )
              }
            } else if kw == "endif" {
              if pp_depth <= 0 {
                return Err(
                  GlslError::PreprocessorError(
                    tok.line,
                    "unexpected #endif without matching #if",
                  ),
                )
              }
              pp_depth = pp_depth - 1
            } else if kw == "define" {
              define_count = define_count + 1
              if limits.max_defines > 0 && define_count > limits.max_defines {
                return Err(
                  GlslError::LimitExceeded(
                    "define count exceeds max_defines " + limits.max_defines.to_string(),
                  ),
                )
              }
              if words.length() >= 3 {
                let val_str = words[2]
                let parsed = parse_nonneg_int(val_str)
                if parsed >= 0 {
                  set_int_define(def_keys, def_vals, words[1], parsed)
                }
              }
              if !is_vertex {
                let rw_check = rewrite_define_line_es100(tok.text, true)
                if rw_check != tok.text {
                  let mut wi = 2
                  while wi < words.length() {
                    if words[wi] == "gl_FragColor" {
                      uses_frag_color = true
                    } else if words[wi] == "gl_FragData" {
                      uses_frag_data = true
                    }
                    wi = wi + 1
                  }
                }
              }
            } else if kw == "undef" {
              if words.length() >= 2 {
                remove_int_define(def_keys, def_vals, words[1])
              }
            }
          }
        } else {
          seen_non_version = true
        }
      }
      TokKind::Punct => {
        seen_non_version = true
        if tok.text == "(" {
          bstack.push(1)
          if limits.max_nesting_depth > 0 && bstack.length() > limits.max_nesting_depth {
            return Err(
              GlslError::LimitExceeded(
                "nesting depth exceeds max_nesting_depth " + limits.max_nesting_depth.to_string(),
              ),
            )
          }
        } else if tok.text == "{" {
          bstack.push(2)
          if limits.max_nesting_depth > 0 && bstack.length() > limits.max_nesting_depth {
            return Err(
              GlslError::LimitExceeded(
                "nesting depth exceeds max_nesting_depth " + limits.max_nesting_depth.to_string(),
              ),
            )
          }
        } else if tok.text == "[" {
          bstack.push(3)
          if limits.max_nesting_depth > 0 && bstack.length() > limits.max_nesting_depth {
            return Err(
              GlslError::LimitExceeded(
                "nesting depth exceeds max_nesting_depth " + limits.max_nesting_depth.to_string(),
              ),
            )
          }
        } else if tok.text == ")" {
          if bstack.length() == 0 || bstack[bstack.length() - 1] != 1 {
            return Err(GlslError::ParseError(tok.line, "unmatched ')'"))
          }
          let _ = bstack.pop()
        } else if tok.text == "}" {
          if bstack.length() == 0 || bstack[bstack.length() - 1] != 2 {
            return Err(GlslError::ParseError(tok.line, "unmatched '}'"))
          }
          let _ = bstack.pop()
        } else if tok.text == "]" {
          if bstack.length() == 0 || bstack[bstack.length() - 1] != 3 {
            return Err(GlslError::ParseError(tok.line, "unmatched ']'"))
          }
          let _ = bstack.pop()
        }
      }
      TokKind::Ident => {
        seen_non_version = true
        let prev_is_dot = i > 0 && tokens[i - 1].text == "."
        if !prev_is_dot {
          if is_vertex {
            if is_fragment_only_builtin(tok.text) {
              return Err(
                GlslError::StageMismatch(
                  "fragment-only symbol '" + tok.text + "' used in vertex shader",
                ),
              )
            }
          } else {
            if is_vertex_only_builtin(tok.text) {
              return Err(
                GlslError::StageMismatch(
                  "vertex-only symbol '" + tok.text + "' used in fragment shader",
                ),
              )
            }
            if tok.text == "gl_FragColor" {
              uses_frag_color = true
            } else if tok.text == "gl_FragData" {
              uses_frag_data = true
              if i + 3 < n && tokens[i + 1].text == "[" && tokens[i + 3].text == "]" {
                let idx_tok = tokens[i + 2]
                let idx = match idx_tok.kind {
                  TokKind::IntLit => parse_nonneg_int(idx_tok.text)
                  TokKind::Ident => find_int_define(def_keys, def_vals, idx_tok.text)
                  _ => -1
                }
                if idx > max_frag_data_index {
                  max_frag_data_index = idx
                }
              }
            }
          }
          // Strip precision qualifiers everywhere (top-level, params, locals, struct fields)
          if is_precision_kw(tok.text) {
            actions[i] = 1
          }
        }
      }
      _ => seen_non_version = true
    }
    i = i + 1
  }

  if pp_depth != 0 {
    return Err(
      GlslError::PreprocessorError(tokens[n - 1].line, "unclosed #if/#ifdef directive"),
    )
  }
  if bstack.length() > 0 {
    return Err(GlslError::ParseError(tokens[n - 1].line, "unclosed bracket or brace"))
  }

  let is_es100 = match version {
    GlslVersion::Es100 => true
    GlslVersion::Es300 => false
  }

  // Pass 2: Top-level declaration parsing & reflection + ES 1.00 token rewrites
  let attributes : Array[VarInfo] = []
  let uniforms : Array[VarInfo] = []
  let varyings : Array[VarInfo] = []
  let outputs : Array[VarInfo] = []

  let mut pos = 0
  while pos < n {
    let tok = tokens[pos]
    match tok.kind {
      TokKind::Directive => {
        if is_es100 && do_translate && actions[pos] == 0 {
          let rw_dir = rewrite_define_line_es100(tok.text, !is_vertex)
          if rw_dir != tok.text {
            actions[pos] = 2
            repls[pos] = rw_dir
          }
        }
        pos = pos + 1
        continue
      }
      _ => ()
    }

    // Stray top-level semicolon
    if tok.text == ";" {
      pos = pos + 1
      continue
    }

    // `precision <lowp|mediump|highp> <type>;`
    if tok.text == "precision" {
      let start = pos
      pos = pos + 1
      while pos < n && tokens[pos].text != ";" {
        pos = pos + 1
      }
      if pos >= n {
        return Err(GlslError::ParseError(tok.line, "missing ';' after precision statement"))
      }
      let mut k = start
      while k <= pos {
        actions[k] = 1
        k = k + 1
      }
      pos = pos + 1
      continue
    }

    // Collect leading qualifiers for a top-level declaration
    let mut location = -1
    let mut storage = ""
    let mut storage_idx = -1
    let mut precision = ""

    let mut reading_quals = true
    while pos < n && reading_quals {
      let qt = tokens[pos]
      if qt.text == "layout" && pos + 1 < n && tokens[pos + 1].text == "(" {
        pos = pos + 2
        let mut ldepth = 1
        while pos < n && ldepth > 0 {
          if tokens[pos].text == "(" {
            ldepth = ldepth + 1
          } else if tokens[pos].text == ")" {
            ldepth = ldepth - 1
            if ldepth == 0 {
              pos = pos + 1
              break
            }
          } else if tokens[pos].text == "location" &&
          pos + 2 < n &&
          tokens[pos + 1].text == "=" {
            let lv = parse_nonneg_int(tokens[pos + 2].text)
            if lv >= 0 {
              location = lv
            }
          }
          pos = pos + 1
        }
      } else if is_interp_or_aux_kw(qt.text) {
        pos = pos + 1
      } else if is_storage_kw(qt.text) {
        storage = qt.text
        storage_idx = pos
        if storage == "attribute" {
          if !is_vertex {
            return Err(
              GlslError::StageMismatch("attribute qualifier is not allowed in fragment shader"),
            )
          }
          if !is_es100 {
            return Err(
              GlslError::ParseError(qt.line, "'attribute' is not valid in GLSL ES 3.00"),
            )
          }
        } else if storage == "varying" && !is_es100 {
          return Err(
            GlslError::ParseError(qt.line, "'varying' is not valid in GLSL ES 3.00"),
          )
        }
        pos = pos + 1
      } else if is_precision_kw(qt.text) {
        precision = qt.text
        pos = pos + 1
      } else {
        reading_quals = false
      }
    }

    if pos >= n {
      break
    }

    // Rewrite ES 1.00 top-level `attribute` / `varying` storage qualifiers
    if is_es100 && storage_idx >= 0 {
      if storage == "attribute" {
        actions[storage_idx] = 2
        repls[storage_idx] = "in"
      } else if storage == "varying" {
        actions[storage_idx] = 2
        repls[storage_idx] = if is_vertex { "out" } else { "in" }
      }
    }

    // `struct [Name] { ... } [vars];`
    let mut type_name = ""
    if tokens[pos].text == "struct" {
      pos = pos + 1
      if pos < n {
        match tokens[pos].kind {
          TokKind::Ident => {
            type_name = tokens[pos].text
            pos = pos + 1
          }
          _ => type_name = "struct"
        }
      }
      if pos < n && tokens[pos].text == "{" {
        let mut sdepth = 1
        pos = pos + 1
        while pos < n && sdepth > 0 {
          if tokens[pos].text == "{" {
            sdepth = sdepth + 1
          } else if tokens[pos].text == "}" {
            sdepth = sdepth - 1
          }
          pos = pos + 1
        }
      }
      if pos < n && tokens[pos].text == ";" {
        pos = pos + 1
        continue
      }
    } else {
      // Interface / Uniform Block: `[layout(...)] uniform BlockName { ... } [inst [arr]];`
      let is_block_storage = storage == "uniform" || storage == "in" || storage == "out"
      if is_block_storage && pos + 1 < n && tokens[pos + 1].text == "{" {
        let block_name = tokens[pos].text
        pos = pos + 2
        let mut bdepth = 1
        while pos < n && bdepth > 0 {
          if tokens[pos].text == "{" {
            bdepth = bdepth + 1
          } else if tokens[pos].text == "}" {
            bdepth = bdepth - 1
          }
          pos = pos + 1
        }
        let mut arr_size = 0
        // Optional instance name and array specifier before `;`
        while pos < n && tokens[pos].text != ";" {
          if tokens[pos].text == "[" && pos + 2 < n && tokens[pos + 2].text == "]" {
            let sz = match tokens[pos + 1].kind {
              TokKind::IntLit => parse_nonneg_int(tokens[pos + 1].text)
              TokKind::Ident => find_int_define(def_keys, def_vals, tokens[pos + 1].text)
              _ => -1
            }
            arr_size = if sz >= 0 { sz } else { -1 }
            pos = pos + 3
          } else {
            pos = pos + 1
          }
        }
        if pos < n && tokens[pos].text == ";" {
          pos = pos + 1
        }
        if storage == "uniform" {
          uniforms.push(VarInfo::new(block_name, "uniform_block", arr_size, location, precision))
        }
        continue
      }

      // Normal type specifier
      match tokens[pos].kind {
        TokKind::Ident => {
          type_name = tokens[pos].text
          pos = pos + 1
        }
        _ => {
          // Skip unrecognized top-level statement to next `;` or `}`
          pos = pos + 1
          continue
        }
      }
    }

    // Optional type-level array specifier `vec3[4]`
    let mut type_arr_size = 0
    if pos < n && tokens[pos].text == "[" {
      pos = pos + 1
      if pos < n && tokens[pos].text == "]" {
        type_arr_size = -1
        pos = pos + 1
      } else if pos + 1 < n && tokens[pos + 1].text == "]" {
        let sz = match tokens[pos].kind {
          TokKind::IntLit => parse_nonneg_int(tokens[pos].text)
          TokKind::Ident => find_int_define(def_keys, def_vals, tokens[pos].text)
          _ => -1
        }
        type_arr_size = if sz >= 0 { sz } else { -1 }
        pos = pos + 2
      } else {
        type_arr_size = -1
        while pos < n && tokens[pos].text != "]" {
          pos = pos + 1
        }
        if pos < n {
          pos = pos + 1
        }
      }
    }

    if pos >= n {
      break
    }

    // Check if this is a function declaration / definition: `<type> <name> (`
    let is_func = pos + 1 < n && tokens[pos + 1].text == "("
    if is_func {
      pos = pos + 2
      let mut pdepth = 1
      while pos < n && pdepth > 0 {
        if tokens[pos].text == "(" {
          pdepth = pdepth + 1
        } else if tokens[pos].text == ")" {
          pdepth = pdepth - 1
        }
        pos = pos + 1
      }
      if pos < n && tokens[pos].text == ";" {
        pos = pos + 1
      } else if pos < n && tokens[pos].text == "{" {
        // Function body: scan tokens for ES 1.00 rewrites
        let mut fdepth = 1
        pos = pos + 1
        while pos < n && fdepth > 0 {
          let ft = tokens[pos]
          if ft.text == "{" {
            fdepth = fdepth + 1
          } else if ft.text == "}" {
            fdepth = fdepth - 1
          } else if is_es100 && do_translate {
            match ft.kind {
              TokKind::Directive => {
                if actions[pos] == 0 {
                  let rw_dir = rewrite_define_line_es100(ft.text, !is_vertex)
                  if rw_dir != ft.text {
                    actions[pos] = 2
                    repls[pos] = rw_dir
                  }
                }
              }
              TokKind::Ident => {
                let prev_dot = pos > 0 && tokens[pos - 1].text == "."
                if !prev_dot {
                  if !is_vertex && ft.text == "gl_FragColor" {
                    actions[pos] = 2
                    repls[pos] = "_fv_gl_FragColor"
                  } else if !is_vertex && ft.text == "gl_FragData" {
                    actions[pos] = 2
                    repls[pos] = "_fv_gl_FragData"
                  } else if pos + 1 < n && tokens[pos + 1].text == "(" {
                    let rw = rewrite_es100_texture_fn(ft.text)
                    if rw != "" {
                      actions[pos] = 2
                      repls[pos] = rw
                    }
                  }
                }
              }
              _ => ()
            }
          }
          pos = pos + 1
        }
      }
      continue
    }

    // Variable declarator list: `a, b[4], c = expr;`
    let mut parsing_decls = true
    while pos < n && parsing_decls {
      match tokens[pos].kind {
        TokKind::Ident => {
          let var_name = tokens[pos].text
          pos = pos + 1
          let mut arr_size = type_arr_size
          if pos < n && tokens[pos].text == "[" {
            pos = pos + 1
            if pos < n && tokens[pos].text == "]" {
              arr_size = -1
              pos = pos + 1
            } else if pos + 1 < n && tokens[pos + 1].text == "]" {
              let sz = match tokens[pos].kind {
                TokKind::IntLit => parse_nonneg_int(tokens[pos].text)
                TokKind::Ident => find_int_define(def_keys, def_vals, tokens[pos].text)
                _ => -1
              }
              arr_size = if sz >= 0 { sz } else { -1 }
              pos = pos + 2
            } else {
              arr_size = -1
              let mut adepth = 1
              while pos < n && adepth > 0 {
                if tokens[pos].text == "[" {
                  adepth = adepth + 1
                } else if tokens[pos].text == "]" {
                  adepth = adepth - 1
                }
                pos = pos + 1
              }
            }
          }

          // Skip optional `= initializer` up to `,` or `;` at depth 0
          if pos < n && tokens[pos].text == "=" {
            pos = pos + 1
            let mut edepth = 0
            while pos < n {
              let et = tokens[pos]
              if et.text == "(" || et.text == "[" || et.text == "{" {
                edepth = edepth + 1
              } else if et.text == ")" || et.text == "]" || et.text == "}" {
                if edepth > 0 {
                  edepth = edepth - 1
                }
              } else if edepth == 0 && (et.text == "," || et.text == ";") {
                break
              }
              if is_es100 && do_translate {
                match et.kind {
                  TokKind::Ident => {
                    let prev_dot = pos > 0 && tokens[pos - 1].text == "."
                    if !prev_dot && pos + 1 < n && tokens[pos + 1].text == "(" {
                      let rw = rewrite_es100_texture_fn(et.text)
                      if rw != "" {
                        actions[pos] = 2
                        repls[pos] = rw
                      }
                    }
                  }
                  _ => ()
                }
              }
              pos = pos + 1
            }
          }

          // Record reflected variable
          let info = VarInfo::new(var_name, type_name, arr_size, location, precision)
          if storage == "uniform" {
            uniforms.push(info)
          } else if is_es100 {
            if storage == "attribute" {
              attributes.push(info)
            } else if storage == "varying" {
              varyings.push(info)
            }
          } else {
            // GLSL ES 3.00
            if is_vertex {
              if storage == "in" {
                attributes.push(info)
              } else if storage == "out" {
                varyings.push(info)
              }
            } else {
              if storage == "in" {
                varyings.push(info)
              } else if storage == "out" {
                outputs.push(info)
              }
            }
          }

          if pos < n && tokens[pos].text == "," {
            pos = pos + 1
          } else {
            if pos < n && tokens[pos].text == ";" {
              pos = pos + 1
            }
            parsing_decls = false
          }
        }
        _ => {
          // Advance to next `;` to avoid stalling
          while pos < n && tokens[pos].text != ";" {
            pos = pos + 1
          }
          if pos < n {
            pos = pos + 1
          }
          parsing_decls = false
        }
      }
    }
  }

  let refl = Reflection::{
    version: version,
    stage: stage,
    attributes: attributes,
    uniforms: uniforms,
    varyings: varyings,
    outputs: outputs,
    extensions: extensions,
    uses_frag_color: uses_frag_color,
    uses_frag_data: uses_frag_data,
    max_frag_data_index: max_frag_data_index,
  }

  if !do_translate {
    return Ok(TranslatedShader::{ glsl410: "", reflection: refl })
  }

  // Pass 3: Emit OpenGL 4.10 Core GLSL
  let sb = StringBuilder::new()
  sb.write_string("#version 410 core\n")
  if is_es100 && !is_vertex {
    if uses_frag_color {
      sb.write_string("out vec4 _fv_gl_FragColor;\n")
    }
    if uses_frag_data {
      let count = if max_frag_data_index >= 0 { max_frag_data_index + 1 } else { 8 }
      sb.write_string("out vec4 _fv_gl_FragData[" + count.to_string() + "];\n")
    }
  }

  let mut at_bol = true
  let mut has_prev = false
  let mut prev_kind = TokKind::Eof
  let mut prev_text = ""

  let mut idx = 0
  while idx < n {
    let act = actions[idx]
    if act == 1 {
      idx = idx + 1
      continue
    }
    let tok = tokens[idx]
    let out_text = if act == 2 { repls[idx] } else { tok.text }
    match tok.kind {
      TokKind::Directive => {
        if !at_bol {
          sb.write_byte((10).to_byte())
        }
        sb.write_string(out_text)
        sb.write_byte((10).to_byte())
        at_bol = true
        has_prev = false
      }
      _ => {
        if has_prev && needs_space_between(prev_kind, prev_text, tok.kind, out_text) {
          sb.write_byte((32).to_byte())
        }
        sb.write_string(out_text)
        if out_text == ";" || out_text == "{" || out_text == "}" {
          sb.write_byte((10).to_byte())
          at_bol = true
          has_prev = false
        } else {
          at_bol = false
          has_prev = true
          prev_kind = tok.kind
          prev_text = out_text
        }
      }
    }
    idx = idx + 1
  }

  if !at_bol {
    sb.write_byte((10).to_byte())
  }

  Ok(TranslatedShader::{ glsl410: sb.to_string(), reflection: refl })
}

///| Parse and reflect a GLSL ES 1.00 or 3.00 shader using default `ParseLimits`.
pub fn parse_and_reflect(
  source : String,
  stage : ShaderStage,
) -> Result[Reflection, GlslError] {
  parse_and_reflect_with_limits(source, stage, ParseLimits::default())
}

///| Parse and reflect a GLSL ES 1.00 or 3.00 shader with explicit `ParseLimits`.
pub fn parse_and_reflect_with_limits(
  source : String,
  stage : ShaderStage,
  limits : ParseLimits,
) -> Result[Reflection, GlslError] {
  match process_shader(source, stage, limits, false) {
    Ok(t) => Ok(t.reflection)
    Err(e) => Err(e)
  }
}

///| Translate a GLSL ES 1.00 or 3.00 shader to OpenGL 4.10 Core using default `ParseLimits`.
pub fn translate_to_glsl410(
  source : String,
  stage : ShaderStage,
) -> Result[TranslatedShader, GlslError] {
  translate_to_glsl410_with_limits(source, stage, ParseLimits::default())
}

///| Translate a GLSL ES 1.00 or 3.00 shader to OpenGL 4.10 Core with explicit `ParseLimits`.
pub fn translate_to_glsl410_with_limits(
  source : String,
  stage : ShaderStage,
  limits : ParseLimits,
) -> Result[TranslatedShader, GlslError] {
  process_shader(source, stage, limits, true)
}
