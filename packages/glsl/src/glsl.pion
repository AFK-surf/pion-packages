///| GLSL ES 1.00 / 3.00 preprocessor validation, reflection, and OpenGL 4.10 Core translation.
///| Uses decoupled passes: (1) preprocessor/nesting/stage validation, (2) flat ES->410 token &
///| macro-body rewrite + identifier sanitization, (3) top-level declaration reflection, (4) emit.

fn is_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 11 || c == 12
}

fn starts_with(s : String, prefix : String) -> Bool {
  let plen = prefix.length()
  if s.length() < plen {
    return false
  }
  let mut i = 0
  while i < plen {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Overflow-safe non-negative 32-bit integer parser (uses Int64; returns -1 on overflow or invalid).
fn parse_nonneg_int(s : String) -> Int {
  let n = s.length()
  if n == 0 {
    return -1
  }
  let max_i32 : Int64 = 2147483647L
  // Hex literal
  if n > 2 &&
  s.code_unit_at(0) == 48 &&
  (s.code_unit_at(1) == 120 || s.code_unit_at(1) == 88) {
    let mut acc : Int64 = 0L
    let mut i = 2
    let mut digits = 0
    while i < n {
      let c = s.code_unit_at(i)
      if c == 117 || c == 85 {
        if i + 1 != n {
          return -1
        }
        break
      }
      let d = if c >= 48 && c <= 57 {
        c - 48
      } else if c >= 65 && c <= 70 {
        c - 55
      } else if c >= 97 && c <= 102 {
        c - 87
      } else {
        return -1
      }
      acc = acc * 16L + d.to_int64()
      if acc > max_i32 {
        return -1
      }
      digits = digits + 1
      i = i + 1
    }
    if digits == 0 {
      return -1
    }
    return acc.to_int()
  }
  let mut acc : Int64 = 0L
  let mut i = 0
  let mut digits = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 117 || c == 85 {
      if digits == 0 || i + 1 != n {
        return -1
      }
      break
    }
    if c < 48 || c > 57 {
      return -1
    }
    acc = acc * 10L + (c - 48).to_int64()
    if acc > max_i32 {
      return -1
    }
    digits = digits + 1
    i = i + 1
  }
  if digits == 0 {
    return -1
  }
  acc.to_int()
}

///| Split a preprocessor directive line (starting with `#`) into whitespace/colon-separated words.
fn split_directive_words(line_text : String) -> Array[String] {
  let out : Array[String] = []
  let n = line_text.length()
  let mut i = 1 // skip '#'
  while i < n {
    while i < n && is_ws(line_text.code_unit_at(i)) {
      i = i + 1
    }
    if i >= n {
      break
    }
    if line_text.code_unit_at(i) == 58 {
      out.push(":")
      i = i + 1
      continue
    }
    let start = i
    while i < n && !is_ws(line_text.code_unit_at(i)) && line_text.code_unit_at(i) != 58 {
      i = i + 1
    }
    out.push(line_text.slice(start, i))
  }
  out
}

fn is_es_stripped_extension(ext : String) -> Bool {
  ext == "all" ||
  starts_with(ext, "GL_OES_") ||
  starts_with(ext, "GL_EXT_") ||
  starts_with(ext, "GL_WEBGL_") ||
  starts_with(ext, "GL_ANGLE_") ||
  starts_with(ext, "GL_NV_shadow_samplers")
}

fn is_precision_kw(s : String) -> Bool {
  s == "lowp" || s == "mediump" || s == "highp"
}

fn is_interp_or_aux_kw(s : String) -> Bool {
  s == "invariant" || s == "centroid" || s == "flat" || s == "smooth"
}

fn is_storage_kw(s : String) -> Bool {
  s == "attribute" || s == "varying" || s == "uniform" || s == "in" || s == "out" || s == "const"
}

///| Map ES 1.00 built-in texture functions to their GLSL 4.10 Core equivalents.
fn rewrite_es100_texture_fn(name : String) -> String {
  if name == "texture2D" ||
  name == "textureCube" ||
  name == "texture3D" ||
  name == "shadow2D" ||
  name == "shadow2DEXT" {
    "texture"
  } else if name == "texture2DProj" ||
  name == "texture3DProj" ||
  name == "shadow2DProj" ||
  name == "shadow2DProjEXT" {
    "textureProj"
  } else if name == "texture2DLod" ||
  name == "texture2DLodEXT" ||
  name == "textureCubeLod" ||
  name == "textureCubeLodEXT" ||
  name == "texture3DLod" {
    "textureLod"
  } else if name == "texture2DGradEXT" || name == "textureCubeGradEXT" {
    "textureGrad"
  } else if name == "texture2DProjLod" ||
  name == "texture2DProjLodEXT" ||
  name == "texture3DProjLod" {
    "textureProjLod"
  } else if name == "texture2DProjGradEXT" {
    "textureProjGrad"
  } else {
    ""
  }
}

///| Identifiers that are legal in GLSL ES 1.00 but are keywords, reserved words, or rewritten
///| built-in names in GLSL 4.10 Core (or collide with our `_fv_` internal namespace).
fn needs_rename_es100(name : String) -> Bool {
  if starts_with(name, "_fv_") {
    return true
  }
  // GLSL 4.10 rewrite target built-ins (not built-ins in ES 1.00; user var `texture` shadows `texture()`)
  if name == "texture" ||
  name == "textureLod" ||
  name == "textureProj" ||
  name == "textureGrad" ||
  name == "textureProjLod" ||
  name == "textureProjGrad" {
    return true
  }
  // GLSL 4.10 keywords & reserved words that are legal ES 1.00 identifiers
  name == "sample" ||
  name == "smooth" ||
  name == "noperspective" ||
  name == "patch" ||
  name == "subroutine" ||
  name == "layout" ||
  name == "centroid" ||
  name == "uint" ||
  name == "case" ||
  name == "switch" ||
  name == "default" ||
  name == "precise" ||
  name == "common" ||
  name == "partition" ||
  name == "active" ||
  name == "filter" ||
  name == "resource" ||
  name == "buffer" ||
  name == "shared" ||
  name == "coherent" ||
  name == "volatile" ||
  name == "restrict" ||
  name == "readonly" ||
  name == "writeonly" ||
  name == "superp" ||
  name == "input" ||
  name == "output" ||
  name == "row_major" ||
  name == "atomic_uint" ||
  name == "uvec2" ||
  name == "uvec3" ||
  name == "uvec4" ||
  name == "double" ||
  name == "dvec2" ||
  name == "dvec3" ||
  name == "dvec4" ||
  name == "mat2x2" ||
  name == "mat2x3" ||
  name == "mat2x4" ||
  name == "mat3x2" ||
  name == "mat3x3" ||
  name == "mat3x4" ||
  name == "mat4x2" ||
  name == "mat4x3" ||
  name == "mat4x4" ||
  name == "dmat2" ||
  name == "dmat3" ||
  name == "dmat4" ||
  name == "dmat2x2" ||
  name == "dmat2x3" ||
  name == "dmat2x4" ||
  name == "dmat3x2" ||
  name == "dmat3x3" ||
  name == "dmat3x4" ||
  name == "dmat4x2" ||
  name == "dmat4x3" ||
  name == "dmat4x4" ||
  name == "hvec2" ||
  name == "hvec3" ||
  name == "hvec4" ||
  name == "fvec2" ||
  name == "fvec3" ||
  name == "fvec4" ||
  name == "isampler1D" ||
  name == "isampler2D" ||
  name == "isampler3D" ||
  name == "isamplerCube" ||
  name == "isampler1DArray" ||
  name == "isampler2DArray" ||
  name == "isampler2DRect" ||
  name == "isamplerBuffer" ||
  name == "isampler2DMS" ||
  name == "isampler2DMSArray" ||
  name == "isamplerCubeArray" ||
  name == "usampler1D" ||
  name == "usampler2D" ||
  name == "usampler3D" ||
  name == "usamplerCube" ||
  name == "usampler1DArray" ||
  name == "usampler2DArray" ||
  name == "usampler2DRect" ||
  name == "usamplerBuffer" ||
  name == "usampler2DMS" ||
  name == "usampler2DMSArray" ||
  name == "usamplerCubeArray" ||
  name == "sampler1D" ||
  name == "sampler1DShadow" ||
  name == "sampler1DArray" ||
  name == "sampler1DArrayShadow" ||
  name == "sampler2DArray" ||
  name == "sampler2DArrayShadow" ||
  name == "sampler2DRect" ||
  name == "sampler2DRectShadow" ||
  name == "samplerBuffer" ||
  name == "sampler2DMS" ||
  name == "sampler2DMSArray" ||
