///| Core public types, resource limits, reflection structures, and error types for `glsl`.

///| Shader pipeline stage.
pub enum ShaderStage {
  Vertex
  Fragment
}

///| Supported GLSL ES language versions.
pub enum GlslVersion {
  Es100
  Es300
}

///| Resource and security limits for shader lexing, preprocessing, and parsing.
///| Any field `<= 0` means unlimited.
pub val struct ParseLimits {
  pub max_source_bytes : Int
  pub max_tokens : Int
  pub max_nesting_depth : Int
  pub max_preprocessor_depth : Int
  pub max_defines : Int
}

///| Default conservative security limits suitable for untrusted web shaders.
pub fn ParseLimits::default() -> ParseLimits {
  ParseLimits::{
    max_source_bytes: 4194304,
    max_tokens: 500000,
    max_nesting_depth: 128,
    max_preprocessor_depth: 64,
    max_defines: 4096,
  }
}

///| Construct custom `ParseLimits`. Any field `<= 0` means unlimited.
pub fn ParseLimits::new(
  max_source_bytes : Int,
  max_tokens : Int,
  max_nesting_depth : Int,
  max_preprocessor_depth : Int,
  max_defines : Int,
) -> ParseLimits {
  ParseLimits::{
    max_source_bytes: max_source_bytes,
    max_tokens: max_tokens,
    max_nesting_depth: max_nesting_depth,
    max_preprocessor_depth: max_preprocessor_depth,
    max_defines: max_defines,
  }
}

///| Reflected top-level shader variable or uniform block declaration.
pub struct VarInfo {
  pub name : String
  pub glsl_type : String
  pub array_size : Int
  pub location : Int
  pub precision : String
}

///| Construct a `VarInfo`.
pub fn VarInfo::new(
  name : String,
  glsl_type : String,
  array_size : Int,
  location : Int,
  precision : String,
) -> VarInfo {
  VarInfo::{
    name: name,
    glsl_type: glsl_type,
    array_size: array_size,
    location: location,
    precision: precision,
  }
}

///| Reflected metadata extracted from a GLSL ES 1.00 or 3.00 shader.
pub struct Reflection {
  pub version : GlslVersion
  pub stage : ShaderStage
  pub attributes : Array[VarInfo]
  pub uniforms : Array[VarInfo]
  pub varyings : Array[VarInfo]
  pub outputs : Array[VarInfo]
  pub extensions : Array[String]
  pub uses_frag_color : Bool
  pub uses_frag_data : Bool
  pub max_frag_data_index : Int
}

///| Result of translating a GLSL ES shader to desktop OpenGL 4.10 Core GLSL.
pub struct TranslatedShader {
  pub glsl410 : String
  pub reflection : Reflection
}

///| Errors returned by `parse_and_reflect` and `translate_to_glsl410`.
pub enum GlslError {
  EmptySource
  LimitExceeded(String)
  LexError(Int, String)
  PreprocessorError(Int, String)
  ParseError(Int, String)
  UnsupportedVersion(String)
  StageMismatch(String)
}

///| Format a `GlslError` into a human-readable diagnostic string.
pub fn glsl_error_message(e : GlslError) -> String {
  match e {
    GlslError::EmptySource => "empty shader source"
    GlslError::LimitExceeded(msg) => "limit exceeded: " + msg
    GlslError::LexError(line, msg) => "lex error at line " + line.to_string() + ": " + msg
    GlslError::PreprocessorError(line, msg) =>
    "preprocessor error at line " + line.to_string() + ": " + msg
    GlslError::ParseError(line, msg) => "parse error at line " + line.to_string() + ": " + msg
    GlslError::UnsupportedVersion(v) => "unsupported GLSL version: " + v
    GlslError::StageMismatch(msg) => "stage mismatch: " + msg
  }
}
