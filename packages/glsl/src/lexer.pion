///| Single-pass GLSL ES 1.00 / 3.00 lexer with version-aware line-continuation splicing,
///| comment stripping, ASCII/null-byte validation, and token-limit enforcement.

enum TokKind {
  Ident
  IntLit
  FloatLit
  Punct
  Directive
  Eof
}

struct Token {
  kind : TokKind
  text : String
  line : Int
}

fn is_ascii_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn is_ascii_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_hex_digit(c : Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

fn is_ident_start(c : Int) -> Bool {
  is_ascii_alpha(c) || c == 95
}

fn is_ident_cont(c : Int) -> Bool {
  is_ascii_alpha(c) || is_ascii_digit(c) || c == 95
}

///| Check if `src` at position `i` starts a `\` line continuation (`\\\n`, `\\\r\n`, or `\\\r`).
///| Returns the new index after the continuation, or `-1` if not a continuation.
fn line_cont_end(src : String, i : Int, n : Int) -> Int {
  if i < n && src.code_unit_at(i) == 92 {
    if i + 1 < n && src.code_unit_at(i + 1) == 10 {
      return i + 2
    }
    if i + 2 < n && src.code_unit_at(i + 1) == 13 && src.code_unit_at(i + 2) == 10 {
      return i + 3
    }
    if i + 1 < n && src.code_unit_at(i + 1) == 13 {
      return i + 2
    }
  }
  -1
}

///| Quick peek to detect whether the first non-whitespace, non-comment directive is `#version 300 es`
///| (even when `#ver\\\nsion 300 es` uses line continuation).
fn peek_is_es300(source : String) -> Bool {
  let n = source.length()
  let mut i = 0
  while i < n {
    let c = source.code_unit_at(i)
    if c == 0 {
      return false
    }
    if c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13 {
      i = i + 1
      continue
    }
    // Single-line comment
    if c == 47 && i + 1 < n && source.code_unit_at(i + 1) == 47 {
      i = i + 2
      while i < n {
        let cc = source.code_unit_at(i)
        if cc == 10 || cc == 13 {
          break
        }
        i = i + 1
      }
      continue
    }
    // Block comment
    if c == 47 && i + 1 < n && source.code_unit_at(i + 1) == 42 {
      i = i + 2
      while i < n {
        if source.code_unit_at(i) == 42 && i + 1 < n && source.code_unit_at(i + 1) == 47 {
          i = i + 2
          break
        }
        i = i + 1
      }
      continue
    }
    if c != 35 {
      return false
    }
    // Collect first directive line with line-continuation splicing
    let sb = StringBuilder::new()
    i = i + 1
    while i < n {
      let dc = source.code_unit_at(i)
      let dlc = line_cont_end(source, i, n)
      if dlc >= 0 {
        i = dlc
        continue
      }
      if dc == 10 || dc == 13 {
        break
      }
      if dc == 47 && i + 1 < n && source.code_unit_at(i + 1) == 47 {
        break
      }
      sb.write_byte(dc.to_byte())
      i = i + 1
    }
    let line = sb.to_string()
    let ln = line.length()
    let mut k = 0
    while k < ln && (line.code_unit_at(k) == 32 || line.code_unit_at(k) == 9) {
      k = k + 1
    }
    let w0_start = k
    while k < ln && is_ident_cont(line.code_unit_at(k)) {
      k = k + 1
    }
    if line.slice(w0_start, k) != "version" {
      return false
    }
    while k < ln && (line.code_unit_at(k) == 32 || line.code_unit_at(k) == 9) {
      k = k + 1
    }
    let w1_start = k
    while k < ln && is_ident_cont(line.code_unit_at(k)) {
      k = k + 1
    }
    return line.slice(w1_start, k) == "300"
  }
  false
}

///| Physical line-continuation splicing pre-pass for GLSL ES 3.00.
///| Only allocates when `source` actually contains a backslash (`\`).
///| Returns `(spliced_source, line_map)` where `line_map[l - 1]` is the original 1-based line number.
fn splice_es300_lines(source : String) -> (String, Array[Int]) {
  let n = source.length()
  let mut has_bs = false
  let mut k = 0
  while k < n {
    if source.code_unit_at(k) == 92 {
      has_bs = true
      break
    }
    k = k + 1
  }
  if !has_bs {
    return (source, [])
  }
  let sb = StringBuilder::new()
  let line_map : Array[Int] = [1]
  let mut i = 0
  let mut orig_line = 1
  while i < n {
    let lc = line_cont_end(source, i, n)
    if lc >= 0 {
      i = lc
      orig_line = orig_line + 1
      continue
    }
    let c = source.code_unit_at(i)
    if c == 10 {
      sb.write_byte((10).to_byte())
      orig_line = orig_line + 1
      line_map.push(orig_line)
      i = i + 1
    } else if c == 13 {
      sb.write_byte((10).to_byte())
      orig_line = orig_line + 1
      line_map.push(orig_line)
      if i + 1 < n && source.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
    } else {
      sb.write_byte(c.to_byte())
      i = i + 1
    }
  }
  (sb.to_string(), line_map)
}

fn map_line(line_map : Array[Int], cur_line : Int) -> Int {
  if line_map.length() == 0 {
    return cur_line
  }
  let idx = cur_line - 1
  if idx >= 0 && idx < line_map.length() {
    line_map[idx]
  } else {
    cur_line
  }
}

///| Lex a GLSL ES 1.00 / 3.00 source string into tokens while enforcing `ParseLimits`.
fn lex_glsl(source : String, limits : ParseLimits) -> Result[Array[Token], GlslError] {
  let raw_n = source.length()
  if limits.max_source_bytes > 0 && raw_n > limits.max_source_bytes {
    return Err(
      GlslError::LimitExceeded(
        "source size " +
        raw_n.to_string() +
        " exceeds max_source_bytes " +
        limits.max_source_bytes.to_string(),
      ),
    )
  }
  if raw_n == 0 {
    return Err(GlslError::EmptySource)
  }

  let is_es300 = peek_is_es300(source)
  let (src, line_map) = if is_es300 {
    splice_es300_lines(source)
  } else {
    (source, [])
  }

  let n = src.length()
  let tokens : Array[Token] = []
  let mut i = 0
  let mut line = 1
  let mut at_line_start = true

  while i < n {
    let c = src.code_unit_at(i)

    // Reject null bytes everywhere
    if c == 0 {
      return Err(GlslError::LexError(map_line(line_map, line), "null byte in shader source"))
    }

    // Horizontal whitespace
    if c == 32 || c == 9 || c == 11 || c == 12 {
      i = i + 1
      continue
    }

    // Newlines
    if c == 10 {
      i = i + 1
      line = line + 1
      at_line_start = true
      continue
    }
    if c == 13 {
      if i + 1 < n && src.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
      line = line + 1
      at_line_start = true
      continue
    }

    // Single-line comment `// ...` (ES 1.00 has no `\` continuation in comments; ES 3.00 already spliced)
    if c == 47 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
      i = i + 2
      while i < n {
        let cc = src.code_unit_at(i)
        if cc == 0 {
          return Err(GlslError::LexError(map_line(line_map, line), "null byte in comment"))
        }
        if cc == 10 || cc == 13 {
          break
        }
        i = i + 1
      }
      continue
    }

    // Block comment `/* ... */`
    if c == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
      let start_line = map_line(line_map, line)
      i = i + 2
      let mut closed = false
      while i < n {
        let cc = src.code_unit_at(i)
        if cc == 0 {
          return Err(GlslError::LexError(map_line(line_map, line), "null byte in block comment"))
        }
        if cc == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
          i = i + 2
          closed = true
          break
        }
        if cc == 10 {
          line = line + 1
          i = i + 1
        } else if cc == 13 {
          line = line + 1
          if i + 1 < n && src.code_unit_at(i + 1) == 10 {
            i = i + 2
          } else {
            i = i + 1
          }
        } else {
          i = i + 1
        }
      }
      if !closed {
        return Err(GlslError::LexError(start_line, "unterminated block comment"))
      }
      continue
    }

    // Reject non-ASCII outside comments
    if c >= 128 {
      return Err(
        GlslError::LexError(map_line(line_map, line), "non-ASCII character in GLSL source"),
      )
    }

    // Check token limit before pushing a new token
    if limits.max_tokens > 0 && tokens.length() >= limits.max_tokens {
      return Err(
        GlslError::LimitExceeded(
          "token count exceeds max_tokens " + limits.max_tokens.to_string(),
        ),
      )
    }

    // Preprocessor directive (`#` at start of logical line)
    if c == 35 {
      if !at_line_start {
        return Err(
          GlslError::PreprocessorError(
            map_line(line_map, line),
            "'#' directive must start at the beginning of a line",
          ),
        )
      }
      let start_line = map_line(line_map, line)
      let sb = StringBuilder::new()
      sb.write_byte((35).to_byte())
      i = i + 1
      while i < n {
        let dc = src.code_unit_at(i)
        if dc == 0 {
          return Err(
            GlslError::LexError(map_line(line_map, line), "null byte in preprocessor directive"),
          )
        }
        // Allow `\` continuation inside directives in ES 1.00 as well (multi-line `#define`)
        if !is_es300 {
          let dlc = line_cont_end(src, i, n)
          if dlc >= 0 {
            i = dlc
            line = line + 1
            continue
          }
        }
        if dc == 10 || dc == 13 {
          break
        }
        // Strip single-line comment inside directive
        if dc == 47 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
          i = i + 2
          while i < n {
            let cc = src.code_unit_at(i)
            if cc == 0 {
              return Err(GlslError::LexError(map_line(line_map, line), "null byte in comment"))
            }
            if cc == 10 || cc == 13 {
              break
            }
            i = i + 1
          }
          break
        }
        // Strip block comment inside directive
        if dc == 47 && i + 1 < n && src.code_unit_at(i + 1) == 42 {
          let cstart = map_line(line_map, line)
          i = i + 2
          let mut closed = false
          while i < n {
            let cc = src.code_unit_at(i)
            if cc == 0 {
              return Err(
                GlslError::LexError(map_line(line_map, line), "null byte in block comment"),
              )
            }
            if cc == 42 && i + 1 < n && src.code_unit_at(i + 1) == 47 {
              i = i + 2
              closed = true
              break
            }
            if cc == 10 {
              line = line + 1
              i = i + 1
            } else if cc == 13 {
              line = line + 1
              if i + 1 < n && src.code_unit_at(i + 1) == 10 {
                i = i + 2
              } else {
                i = i + 1
              }
            } else {
              i = i + 1
            }
          }
          if !closed {
            return Err(GlslError::LexError(cstart, "unterminated block comment in directive"))
          }
          sb.write_byte((32).to_byte())
          continue
        }
        if dc >= 128 {
          return Err(
            GlslError::LexError(map_line(line_map, line), "non-ASCII character in directive"),
          )
        }
        sb.write_byte(dc.to_byte())
        i = i + 1
      }
      tokens.push(Token::{ kind: TokKind::Directive, text: sb.to_string(), line: start_line })
      at_line_start = false
      continue
    }

    at_line_start = false

    // Identifier or keyword
    if is_ident_start(c) {
      let start = i
      let tok_line = map_line(line_map, line)
      i = i + 1
      while i < n && is_ident_cont(src.code_unit_at(i)) {
        i = i + 1
      }
      tokens.push(Token::{ kind: TokKind::Ident, text: src.slice(start, i), line: tok_line })
      continue
    }

    // Numeric literal (int, hex, octal, float)
    if is_ascii_digit(c) || (c == 46 && i + 1 < n && is_ascii_digit(src.code_unit_at(i + 1))) {
      let start = i
      let tok_line = map_line(line_map, line)
      let mut is_float = false
      if c == 48 &&
      i + 1 < n &&
      (src.code_unit_at(i + 1) == 120 || src.code_unit_at(i + 1) == 88) {
        // Hex integer literal
        i = i + 2
        let hex_start = i
        while i < n && is_hex_digit(src.code_unit_at(i)) {
          i = i + 1
        }
        if i == hex_start {
          return Err(GlslError::LexError(tok_line, "invalid hexadecimal literal"))
        }
        if i < n && (src.code_unit_at(i) == 117 || src.code_unit_at(i) == 85) {
          i = i + 1
        }
      } else {
        while i < n && is_ascii_digit(src.code_unit_at(i)) {
          i = i + 1
        }
        if i < n && src.code_unit_at(i) == 46 {
          is_float = true
          i = i + 1
          while i < n && is_ascii_digit(src.code_unit_at(i)) {
            i = i + 1
          }
        }
        if i < n && (src.code_unit_at(i) == 101 || src.code_unit_at(i) == 69) {
          is_float = true
          i = i + 1
          if i < n && (src.code_unit_at(i) == 43 || src.code_unit_at(i) == 45) {
            i = i + 1
          }
          let exp_start = i
          while i < n && is_ascii_digit(src.code_unit_at(i)) {
            i = i + 1
          }
          if i == exp_start {
            return Err(GlslError::LexError(tok_line, "invalid float exponent"))
          }
        }
        if is_float {
          if i < n && (src.code_unit_at(i) == 102 || src.code_unit_at(i) == 70) {
            i = i + 1
          }
        } else {
          if i < n && (src.code_unit_at(i) == 117 || src.code_unit_at(i) == 85) {
            i = i + 1
          } else if i < n && (src.code_unit_at(i) == 102 || src.code_unit_at(i) == 70) {
            is_float = true
            i = i + 1
          }
        }
      }
      let kind = if is_float { TokKind::FloatLit } else { TokKind::IntLit }
      tokens.push(Token::{ kind: kind, text: src.slice(start, i), line: tok_line })
      continue
    }

    // Punctuation and operators
    let tok_line = map_line(line_map, line)
    let c1 = if i + 1 < n { src.code_unit_at(i + 1) } else { 0 }
    let c2 = if i + 2 < n { src.code_unit_at(i + 2) } else { 0 }

    // 3-char operators: <<= >>=
    if (c == 60 && c1 == 60 && c2 == 61) || (c == 62 && c1 == 62 && c2 == 61) {
      tokens.push(Token::{ kind: TokKind::Punct, text: src.slice(i, i + 3), line: tok_line })
      i = i + 3
      continue
    }

    // 2-char operators
    let is_two =
    (c == 60 && (c1 == 61 || c1 == 60)) ||
    (c == 62 && (c1 == 61 || c1 == 62)) ||
    (c == 61 && c1 == 61) ||
    (c == 33 && c1 == 61) ||
    (c == 38 && (c1 == 38 || c1 == 61)) ||
    (c == 124 && (c1 == 124 || c1 == 61)) ||
    (c == 94 && (c1 == 94 || c1 == 61)) ||
    (c == 43 && (c1 == 43 || c1 == 61)) ||
    (c == 45 && (c1 == 45 || c1 == 61)) ||
    (c == 42 && c1 == 61) ||
    (c == 47 && c1 == 61) ||
    (c == 37 && c1 == 61)
    if is_two {
      tokens.push(Token::{ kind: TokKind::Punct, text: src.slice(i, i + 2), line: tok_line })
      i = i + 2
      continue
    }

    // 1-char punctuation / operators
    let is_one =
    c == 40 || c == 41 || c == 123 || c == 125 || c == 91 || c == 93 ||
    c == 59 || c == 44 || c == 46 || c == 58 || c == 63 || c == 61 ||
    c == 60 || c == 62 || c == 43 || c == 45 || c == 42 || c == 47 ||
    c == 37 || c == 38 || c == 124 || c == 94 || c == 126 || c == 33
    if is_one {
      tokens.push(Token::{ kind: TokKind::Punct, text: src.slice(i, i + 1), line: tok_line })
      i = i + 1
      continue
    }

    return Err(
      GlslError::LexError(tok_line, "unexpected character code " + c.to_string()),
    )
  }

  if tokens.length() == 0 {
    return Err(GlslError::EmptySource)
  }
  Ok(tokens)
}
