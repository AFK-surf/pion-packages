///| Single-pass GLSL ES 1.00 / 3.00 lexer with line-continuation splicing,
///| comment stripping, ASCII/null-byte validation, and token-limit enforcement.

enum TokKind {
  Ident
  IntLit
  FloatLit
  Punct
  Directive
  Eof
}

struct Token {
  kind : TokKind
  text : String
  line : Int
}

fn is_ascii_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn is_ascii_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_hex_digit(c : Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

fn is_ident_start(c : Int) -> Bool {
  is_ascii_alpha(c) || c == 95
}

fn is_ident_cont(c : Int) -> Bool {
  is_ascii_alpha(c) || is_ascii_digit(c) || c == 95
}

///| Check if `src` at position `i` starts a `\` line continuation (`\\\n` or `\\\r\n`).
///| Returns the new index after the continuation, or `-1` if not a continuation.
fn line_cont_end(src : String, i : Int, n : Int) -> Int {
  if i < n && src.code_unit_at(i) == 92 {
    if i + 1 < n && src.code_unit_at(i + 1) == 10 {
      return i + 2
    }
    if i + 2 < n && src.code_unit_at(i + 1) == 13 && src.code_unit_at(i + 2) == 10 {
      return i + 3
    }
    if i + 1 < n && src.code_unit_at(i + 1) == 13 {
      return i + 2
    }
  }
  -1
}

///| Lex a GLSL ES 1.00 / 3.00 source string into tokens while enforcing `ParseLimits`.
fn lex_glsl(source : String, limits : ParseLimits) -> Result[Array[Token], GlslError] {
  let n = source.length()
  if limits.max_source_bytes > 0 && n > limits.max_source_bytes {
    return Err(
      GlslError::LimitExceeded(
        "source size " +
        n.to_string() +
        " exceeds max_source_bytes " +
        limits.max_source_bytes.to_string(),
      ),
    )
  }
  if n == 0 {
    return Err(GlslError::EmptySource)
  }

  let tokens : Array[Token] = []
  let mut i = 0
  let mut line = 1
  let mut at_line_start = true

  while i < n {
    let c = source.code_unit_at(i)

    // Reject null bytes everywhere
    if c == 0 {
      return Err(GlslError::LexError(line, "null byte in shader source"))
    }

    // Line continuation outside comments
    let lc = line_cont_end(source, i, n)
    if lc >= 0 {
      i = lc
      line = line + 1
      continue
    }

    // Horizontal whitespace
    if c == 32 || c == 9 || c == 11 || c == 12 {
      i = i + 1
      continue
    }

    // Newlines
    if c == 10 {
      i = i + 1
      line = line + 1
      at_line_start = true
      continue
    }
    if c == 13 {
      if i + 1 < n && source.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
      line = line + 1
      at_line_start = true
      continue
    }

    // Single-line comment `// ...`
    if c == 47 && i + 1 < n && source.code_unit_at(i + 1) == 47 {
      i = i + 2
      while i < n {
        let cc = source.code_unit_at(i)
        if cc == 0 {
          return Err(GlslError::LexError(line, "null byte in comment"))
        }
        let clc = line_cont_end(source, i, n)
        if clc >= 0 {
          i = clc
          line = line + 1
          continue
        }
        if cc == 10 || cc == 13 {
          break
        }
        i = i + 1
      }
      continue
    }

    // Block comment `/* ... */`
    if c == 47 && i + 1 < n && source.code_unit_at(i + 1) == 42 {
      let start_line = line
      i = i + 2
      let mut closed = false
      while i < n {
        let cc = source.code_unit_at(i)
        if cc == 0 {
          return Err(GlslError::LexError(line, "null byte in block comment"))
        }
        if cc == 42 && i + 1 < n && source.code_unit_at(i + 1) == 47 {
          i = i + 2
          closed = true
          break
        }
        if cc == 10 {
          line = line + 1
          i = i + 1
        } else if cc == 13 {
          line = line + 1
          if i + 1 < n && source.code_unit_at(i + 1) == 10 {
            i = i + 2
          } else {
            i = i + 1
          }
        } else {
          i = i + 1
        }
      }
      if !closed {
        return Err(GlslError::LexError(start_line, "unterminated block comment"))
      }
      continue
    }

    // Reject non-ASCII outside comments
    if c >= 128 {
      return Err(GlslError::LexError(line, "non-ASCII character in GLSL source"))
    }

    // Check token limit before pushing a new token
    if limits.max_tokens > 0 && tokens.length() >= limits.max_tokens {
      return Err(
        GlslError::LimitExceeded(
          "token count exceeds max_tokens " + limits.max_tokens.to_string(),
        ),
      )
    }

    // Preprocessor directive (`#` at start of logical line)
    if c == 35 {
      if !at_line_start {
        return Err(
          GlslError::PreprocessorError(
            line,
            "'#' directive must start at the beginning of a line",
          ),
        )
      }
      let start_line = line
      let sb = StringBuilder::new()
      sb.write_byte((35).to_byte())
      i = i + 1
      while i < n {
        let dc = source.code_unit_at(i)
        if dc == 0 {
          return Err(GlslError::LexError(line, "null byte in preprocessor directive"))
        }
        let dlc = line_cont_end(source, i, n)
        if dlc >= 0 {
          i = dlc
          line = line + 1
          continue
        }
        if dc == 10 || dc == 13 {
          break
        }
        // Strip single-line comment inside directive
        if dc == 47 && i + 1 < n && source.code_unit_at(i + 1) == 47 {
          i = i + 2
          while i < n {
            let cc = source.code_unit_at(i)
            if cc == 0 {
              return Err(GlslError::LexError(line, "null byte in comment"))
            }
            let clc = line_cont_end(source, i, n)
            if clc >= 0 {
              i = clc
              line = line + 1
              continue
            }
            if cc == 10 || cc == 13 {
              break
            }
            i = i + 1
          }
          break
        }
        // Strip block comment inside directive
        if dc == 47 && i + 1 < n && source.code_unit_at(i + 1) == 42 {
          let cstart = line
          i = i + 2
          let mut closed = false
          while i < n {
            let cc = source.code_unit_at(i)
            if cc == 0 {
              return Err(GlslError::LexError(line, "null byte in block comment"))
            }
            if cc == 42 && i + 1 < n && source.code_unit_at(i + 1) == 47 {
              i = i + 2
              closed = true
              break
            }
            if cc == 10 {
              line = line + 1
              i = i + 1
            } else if cc == 13 {
              line = line + 1
              if i + 1 < n && source.code_unit_at(i + 1) == 10 {
                i = i + 2
              } else {
                i = i + 1
              }
            } else {
              i = i + 1
            }
          }
          if !closed {
            return Err(GlslError::LexError(cstart, "unterminated block comment in directive"))
          }
          sb.write_byte((32).to_byte())
          continue
        }
        if dc >= 128 {
          return Err(GlslError::LexError(line, "non-ASCII character in directive"))
        }
        sb.write_byte(dc.to_byte())
        i = i + 1
      }
      tokens.push(Token::{ kind: TokKind::Directive, text: sb.to_string(), line: start_line })
      at_line_start = false
      continue
    }

    at_line_start = false

    // Identifier or keyword
    if is_ident_start(c) {
      let start = i
      let tok_line = line
      i = i + 1
      let mut has_cont = false
      while i < n {
        let ic = source.code_unit_at(i)
        if is_ident_cont(ic) {
          i = i + 1
        } else {
          let ilc = line_cont_end(source, i, n)
          if ilc >= 0 {
            has_cont = true
            i = ilc
            line = line + 1
          } else {
            break
          }
        }
      }
      let text = if !has_cont {
        source.slice(start, i)
      } else {
        let sb = StringBuilder::new()
        let mut k = start
        while k < i {
          let klc = line_cont_end(source, k, i)
          if klc >= 0 {
            k = klc
          } else {
            sb.write_byte(source.code_unit_at(k).to_byte())
            k = k + 1
          }
        }
        sb.to_string()
      }
      tokens.push(Token::{ kind: TokKind::Ident, text: text, line: tok_line })
      continue
    }

    // Numeric literal (int, hex, octal, float)
    if is_ascii_digit(c) || (c == 46 && i + 1 < n && is_ascii_digit(source.code_unit_at(i + 1))) {
      let start = i
      let tok_line = line
      let mut is_float = false
      if c == 48 && i + 1 < n &&
      (source.code_unit_at(i + 1) == 120 || source.code_unit_at(i + 1) == 88) {
        // Hex integer literal
        i = i + 2
        let hex_start = i
        while i < n && is_hex_digit(source.code_unit_at(i)) {
          i = i + 1
        }
        if i == hex_start {
          return Err(GlslError::LexError(tok_line, "invalid hexadecimal literal"))
        }
        if i < n && (source.code_unit_at(i) == 117 || source.code_unit_at(i) == 85) {
          i = i + 1
        }
      } else {
        while i < n && is_ascii_digit(source.code_unit_at(i)) {
          i = i + 1
        }
        if i < n && source.code_unit_at(i) == 46 {
          is_float = true
          i = i + 1
          while i < n && is_ascii_digit(source.code_unit_at(i)) {
            i = i + 1
          }
        }
        if i < n && (source.code_unit_at(i) == 101 || source.code_unit_at(i) == 69) {
          is_float = true
          i = i + 1
          if i < n && (source.code_unit_at(i) == 43 || source.code_unit_at(i) == 45) {
            i = i + 1
          }
          let exp_start = i
          while i < n && is_ascii_digit(source.code_unit_at(i)) {
            i = i + 1
          }
          if i == exp_start {
            return Err(GlslError::LexError(tok_line, "invalid float exponent"))
          }
        }
        if is_float {
          if i < n && (source.code_unit_at(i) == 102 || source.code_unit_at(i) == 70) {
            i = i + 1
          }
        } else {
          if i < n && (source.code_unit_at(i) == 117 || source.code_unit_at(i) == 85) {
            i = i + 1
          } else if i < n && (source.code_unit_at(i) == 102 || source.code_unit_at(i) == 70) {
            is_float = true
            i = i + 1
          }
        }
      }
      let kind = if is_float { TokKind::FloatLit } else { TokKind::IntLit }
      tokens.push(Token::{ kind: kind, text: source.slice(start, i), line: tok_line })
      continue
    }

    // Punctuation and operators
    let tok_line = line
    let c1 = if i + 1 < n { source.code_unit_at(i + 1) } else { 0 }
    let c2 = if i + 2 < n { source.code_unit_at(i + 2) } else { 0 }

    // 3-char operators: <<= >>=
    if (c == 60 && c1 == 60 && c2 == 61) || (c == 62 && c1 == 62 && c2 == 61) {
      tokens.push(Token::{ kind: TokKind::Punct, text: source.slice(i, i + 3), line: tok_line })
      i = i + 3
      continue
    }

    // 2-char operators
    let is_two =
    (c == 60 && (c1 == 61 || c1 == 60)) ||
    (c == 62 && (c1 == 61 || c1 == 62)) ||
    (c == 61 && c1 == 61) ||
    (c == 33 && c1 == 61) ||
    (c == 38 && (c1 == 38 || c1 == 61)) ||
    (c == 124 && (c1 == 124 || c1 == 61)) ||
    (c == 94 && (c1 == 94 || c1 == 61)) ||
    (c == 43 && (c1 == 43 || c1 == 61)) ||
    (c == 45 && (c1 == 45 || c1 == 61)) ||
    (c == 42 && c1 == 61) ||
    (c == 47 && c1 == 61) ||
    (c == 37 && c1 == 61)
    if is_two {
      tokens.push(Token::{ kind: TokKind::Punct, text: source.slice(i, i + 2), line: tok_line })
      i = i + 2
      continue
    }

    // 1-char punctuation / operators
    let is_one =
    c == 40 || c == 41 || c == 123 || c == 125 || c == 91 || c == 93 ||
    c == 59 || c == 44 || c == 46 || c == 58 || c == 63 || c == 61 ||
    c == 60 || c == 62 || c == 43 || c == 45 || c == 42 || c == 47 ||
    c == 37 || c == 38 || c == 124 || c == 94 || c == 126 || c == 33
    if is_one {
      tokens.push(Token::{ kind: TokKind::Punct, text: source.slice(i, i + 1), line: tok_line })
      i = i + 1
      continue
    }

    return Err(
      GlslError::LexError(
        tok_line,
        "unexpected character code " + c.to_string(),
      ),
    )
  }

  if tokens.length() == 0 {
    return Err(GlslError::EmptySource)
  }
  Ok(tokens)
}
