///| Comprehensive GLSL ES 1.00 / 3.00 specification, reflection, translation, and security tests.

fn assert(cond : Bool) -> Unit {
  debug_assert(cond, "assertion failed")
}

fn assert_eq_int(a : Int, b : Int) -> Unit {
  debug_assert(a == b, "expected " + b.to_string() + ", got " + a.to_string())
}

fn assert_eq_str(a : String, b : String) -> Unit {
  debug_assert(a == b, "expected '" + b + "', got '" + a + "'")
}

fn empty_reflection() -> Reflection {
  Reflection::{
    version: GlslVersion::Es100,
    stage: ShaderStage::Vertex,
    attributes: [],
    uniforms: [],
    varyings: [],
    outputs: [],
    extensions: [],
    uses_frag_color: false,
    uses_frag_data: false,
    max_frag_data_index: -1,
  }
}

fn unwrap_translated(res : Result[TranslatedShader, GlslError]) -> TranslatedShader {
  match res {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(TranslatedShader), got: " + glsl_error_message(e))
      TranslatedShader::{ glsl410: "", reflection: empty_reflection() }
    }
  }
}

fn unwrap_reflection(res : Result[Reflection, GlslError]) -> Reflection {
  match res {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "expected Ok(Reflection), got: " + glsl_error_message(e))
      empty_reflection()
    }
  }
}

fn contains_str(haystack : String, needle : String) -> Bool {
  let hlen = haystack.length()
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  if nlen > hlen {
    return false
  }
  let mut i = 0
  let limit = hlen - nlen
  while i <= limit {
    let mut j = 0
    let mut ok = true
    while j < nlen {
      if haystack.code_unit_at(i + j) != needle.code_unit_at(j) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return true
    }
    i = i + 1
  }
  false
}

fn find_var(vars : Array[VarInfo], name : String) -> Option[VarInfo] {
  let mut i = 0
  while i < vars.length() {
    if vars[i].name == name {
      return Some(vars[i])
    }
    i = i + 1
  }
  None
}

fn is_es100(v : GlslVersion) -> Bool {
  match v {
    GlslVersion::Es100 => true
    _ => false
  }
}

fn is_es300(v : GlslVersion) -> Bool {
  match v {
    GlslVersion::Es300 => true
    _ => false
  }
}

fn is_vertex(s : ShaderStage) -> Bool {
  match s {
    ShaderStage::Vertex => true
    _ => false
  }
}

fn is_fragment(s : ShaderStage) -> Bool {
  match s {
    ShaderStage::Fragment => true
    _ => false
  }
}

test "es100_vertex_basic_reflection_and_translation" {
  let src =
  "precision highp float;\n" +
  "attribute vec3 aPosition;\n" +
  "attribute vec2 aUv;\n" +
  "uniform mat4 uMvp;\n" +
  "uniform lowp float uTime;\n" +
  "varying vec2 vUv;\n" +
  "void main() {\n" +
  "  vUv = aUv;\n" +
  "  gl_Position = uMvp * vec4(aPosition, 1.0);\n" +
  "}\n"
  let res = translate_to_glsl410(src, ShaderStage::Vertex)
  let t = unwrap_translated(res)
  assert(is_es100(t.reflection.version))
  assert(is_vertex(t.reflection.stage))
  assert_eq_int(t.reflection.attributes.length(), 2)
  assert_eq_int(t.reflection.uniforms.length(), 2)
  assert_eq_int(t.reflection.varyings.length(), 1)
  assert_eq_int(t.reflection.outputs.length(), 0)
  assert(!t.reflection.uses_frag_color)
  assert(!t.reflection.uses_frag_data)
  assert_eq_int(t.reflection.max_frag_data_index, -1)

  match find_var(t.reflection.attributes, "aPosition") {
    Some(v) => {
      assert_eq_str(v.glsl_type, "vec3")
      assert_eq_int(v.array_size, 0)
      assert_eq_int(v.location, -1)
    }
    None => debug_assert(false, "missing aPosition")
  }
  match find_var(t.reflection.uniforms, "uTime") {
    Some(v) => {
      assert_eq_str(v.glsl_type, "float")
      assert_eq_str(v.precision, "lowp")
    }
    None => debug_assert(false, "missing uTime")
  }

  assert(contains_str(t.glsl410, "#version 410 core"))
  assert(!contains_str(t.glsl410, "precision highp"))
  assert(!contains_str(t.glsl410, "attribute "))
  assert(!contains_str(t.glsl410, "varying "))
  assert(!contains_str(t.glsl410, "lowp"))
  assert(contains_str(t.glsl410, "in vec3 aPosition"))
  assert(contains_str(t.glsl410, "out vec2 vUv"))
}

test "es100_fragment_frag_color_and_textures" {
  let src =
  "#version 100\n" +
  "#extension GL_OES_standard_derivatives : enable\n" +
  "#extension GL_EXT_shader_texture_lod : require\n" +
  "precision mediump float;\n" +
  "uniform sampler2D uAlbedo;\n" +
  "uniform samplerCube uEnv;\n" +
  "uniform sampler2DShadow uShadow;\n" +
  "varying highp vec2 vUv;\n" +
  "varying vec3 vNormal;\n" +
  "void main() {\n" +
  "  vec4 c0 = texture2D(uAlbedo, vUv);\n" +
  "  vec4 c1 = textureCube(uEnv, vNormal);\n" +
  "  vec4 c2 = texture2DLodEXT(uAlbedo, vUv, 2.0);\n" +
  "  vec4 c3 = textureCubeLodEXT(uEnv, vNormal, 1.0);\n" +
  "  vec4 c4 = texture2DGradEXT(uAlbedo, vUv, dFdx(vUv), dFdy(vUv));\n" +
  "  vec4 c5 = textureCubeGradEXT(uEnv, vNormal, dFdx(vNormal), dFdy(vNormal));\n" +
  "  vec4 c6 = texture2DProj(uAlbedo, vec3(vUv, 1.0));\n" +
  "  vec4 c7 = texture2DProjLodEXT(uAlbedo, vec3(vUv, 1.0), 1.0);\n" +
  "  float sh = shadow2DEXT(uShadow, vec3(vUv, 0.5));\n" +
  "  gl_FragColor = (c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7) * sh;\n" +
  "}\n"
  let t = unwrap_translated(translate_to_glsl410(src, ShaderStage::Fragment))
  assert(is_es100(t.reflection.version))
  assert(is_fragment(t.reflection.stage))
  assert(t.reflection.uses_frag_color)
  assert(!t.reflection.uses_frag_data)
  assert_eq_int(t.reflection.extensions.length(), 2)
  assert_eq_str(t.reflection.extensions[0], "GL_OES_standard_derivatives")
  assert_eq_str(t.reflection.extensions[1], "GL_EXT_shader_texture_lod")
  assert_eq_int(t.reflection.uniforms.length(), 3)
  assert_eq_int(t.reflection.varyings.length(), 2)

  assert(contains_str(t.glsl410, "#version 410 core"))
  assert(!contains_str(t.glsl410, "GL_OES_standard_derivatives"))
  assert(!contains_str(t.glsl410, "GL_EXT_shader_texture_lod"))
  assert(!contains_str(t.glsl410, "precision mediump"))
  assert(!contains_str(t.glsl410, "varying "))
  assert(contains_str(t.glsl410, "out vec4 _fv_gl_FragColor;"))
  assert(contains_str(t.glsl410, "_fv_gl_FragColor ="))
  assert(!contains_str(t.glsl410, "\ngl_FragColor"))
  assert(!contains_str(t.glsl410, " gl_FragColor"))
  assert(!contains_str(t.glsl410, "texture2D("))
  assert(!contains_str(t.glsl410, "textureCube("))
  assert(!contains_str(t.glsl410, "texture2DLodEXT("))
  assert(!contains_str(t.glsl410, "textureCubeLodEXT("))
  assert(!contains_str(t.glsl410, "texture2DGradEXT("))
  assert(!contains_str(t.glsl410, "textureCubeGradEXT("))
  assert(!contains_str(t.glsl410, "texture2DProj("))
  assert(!contains_str(t.glsl410, "texture2DProjLodEXT("))
  assert(!contains_str(t.glsl410, "shadow2DEXT("))
  assert(contains_str(t.glsl410, "texture("))
  assert(contains_str(t.glsl410, "textureLod("))
  assert(contains_str(t.glsl410, "textureGrad("))
  assert(contains_str(t.glsl410, "textureProj("))
  assert(contains_str(t.glsl410, "textureProjLod("))
}

test "es100_fragment_frag_data_mrt" {
  let src =
  "#extension GL_EXT_draw_buffers : require\n" +
  "precision highp float;\n" +
  "varying vec3 vNormal;\n" +
  "void main() {\n" +
  "  gl_FragData[0] = vec4(vNormal, 1.0);\n" +
  "  gl_FragData[2] = vec4(0.5, 0.5, 0.5, 1.0);\n" +
  "}\n"
  let t = unwrap_translated(translate_to_glsl410(src, ShaderStage::Fragment))
  assert(!t.reflection.uses_frag_color)
  assert(t.reflection.uses_frag_data)
  assert_eq_int(t.reflection.max_frag_data_index, 2)
  assert(contains_str(t.glsl410, "out vec4 _fv_gl_FragData[3];"))
  assert(contains_str(t.glsl410, "_fv_gl_FragData[0]"))
  assert(contains_str(t.glsl410, "_fv_gl_FragData[2]"))
  assert(!contains_str(t.glsl410, "GL_EXT_draw_buffers"))
}

test "es100_do_not_rewrite_member_access" {
  let src =
  "precision mediump float;\n" +
  "struct Material { vec4 texture2D; float gl_FragColor; };\n" +
  "uniform Material uMat;\n" +
  "void main() {\n" +
  "  vec4 c = uMat.texture2D;\n" +
  "  gl_FragColor = vec4(c.rgb, uMat.gl_FragColor);\n" +
  "}\n"
  let t = unwrap_translated(translate_to_glsl410(src, ShaderStage::Fragment))
  assert(t.reflection.uses_frag_color)
  assert(contains_str(t.glsl410, ".texture2D"))
  assert(contains_str(t.glsl410, ".gl_FragColor"))
  assert(contains_str(t.glsl410, "_fv_gl_FragColor ="))
}

test "es100_threejs_conditional_and_multidecl" {
  let src =
  "#define NUM_DIR_LIGHTS 2\n" +
  "#define USE_MAP\n" +
  "precision highp float;\n" +
  "uniform vec3 uColorA, uColors[4];\n" +
  "uniform vec3 uLightDirs[NUM_DIR_LIGHTS];\n" +
  "#ifdef USE_MAP\n" +
  "  uniform sampler2D map;\n" +
  "  varying vec2 vMapUv;\n" +
  "#endif\n" +
  "#if NUM_DIR_LIGHTS > 0\n" +
  "  struct DirLight { highp vec3 dir; lowp vec3 color; };\n" +
  "  uniform DirLight uDirLights[NUM_DIR_LIGHTS];\n" +
  "#endif\n" +
  "void main() {\n" +
  "  vec4 diffuse = vec4(uColorA, 1.0);\n" +
  "#ifdef USE_MAP\n" +
  "  diffuse *= texture2D(map, vMapUv);\n" +
  "#endif\n" +
  "  gl_FragColor = diffuse;\n" +
  "}\n"
  let t = unwrap_translated(translate_to_glsl410(src, ShaderStage::Fragment))
  assert(contains_str(t.glsl410, "#ifdef USE_MAP"))
  assert(contains_str(t.glsl410, "#if NUM_DIR_LIGHTS > 0"))
  assert(contains_str(t.glsl410, "#endif"))
  assert(contains_str(t.glsl410, "texture(map, vMapUv)"))
  assert(!contains_str(t.glsl410, "highp"))
  assert(!contains_str(t.glsl410, "lowp"))

  match find_var(t.reflection.uniforms, "uColorA") {
    Some(v) => {
      assert_eq_str(v.glsl_type, "vec3")
      assert_eq_int(v.array_size, 0)
    }
    None => debug_assert(false, "missing uColorA")
  }
  match find_var(t.reflection.uniforms, "uColors") {
    Some(v) => {
      assert_eq_str(v.glsl_type, "vec3")
      assert_eq_int(v.array_size, 4)
    }
    None => debug_assert(false, "missing uColors")
  }
  match find_var(t.reflection.uniforms, "uLightDirs") {
    Some(v) => {
      assert_eq_str(v.glsl_type, "vec3")
      assert_eq_int(v.array_size, 2)
    }
    None => debug_assert(false, "missing uLightDirs")
  }
  match find_var(t.reflection.uniforms, "uDirLights") {
    Some(v) => {
      assert_eq_str(v.glsl_type, "DirLight")
      assert_eq_int(v.array_size, 2)
    }
    None => debug_assert(false, "missing uDirLights")
  }
}

test "es300_vertex_and_fragment_full" {
  let vs =
  "#version 300 es\n" +
  "precision highp float;\n" +
  "layout(location = 0) in vec3 aPos;\n" +
  "layout(location = 1) in vec3 aNorm;\n" +
  "layout(std140) uniform CameraBlock {\n" +
  "  mat4 view;\n" +
  "  mat4 proj;\n" +
  "} uCamera;\n" +
  "flat out uint vMatId;\n" +
  "smooth out vec3 vNorm;\n" +
  "void main() {\n" +
  "  vMatId = 1u;\n" +
  "  vNorm = aNorm;\n" +
  "  gl_Position = uCamera.proj * uCamera.view * vec4(aPos, 1.0);\n" +
  "}\n"
  let tv = unwrap_translated(translate_to_glsl410(vs, ShaderStage::Vertex))
  assert(is_es300(tv.reflection.version))
  assert_eq_int(tv.reflection.attributes.length(), 2)
  match find_var(tv.reflection.attributes, "aPos") {
    Some(v) => assert_eq_int(v.location, 0)
    None => debug_assert(false, "missing aPos")
  }
  match find_var(tv.reflection.attributes, "aNorm") {
    Some(v) => assert_eq_int(v.location, 1)
    None => debug_assert(false, "missing aNorm")
  }
  assert_eq_int(tv.reflection.varyings.length(), 2)
  assert_eq_int(tv.reflection.uniforms.length(), 1)
  assert_eq_str(tv.reflection.uniforms[0].name, "CameraBlock")
  assert(contains_str(tv.glsl410, "#version 410 core"))
  assert(contains_str(tv.glsl410, "layout(location = 0) in vec3 aPos"))
  assert(contains_str(tv.glsl410, "layout(std140) uniform CameraBlock"))
  assert(contains_str(tv.glsl410, "flat out uint vMatId"))
  assert(contains_str(tv.glsl410, "1u"))

  let fs =
  "#version 300 es\n" +
  "precision highp float;\n" +
  "precision highp sampler2DArray;\n" +
  "uniform highp sampler2DArray uTexArr;\n" +
  "uniform isampler2D uIntTex;\n" +
  "flat in uint vMatId;\n" +
  "smooth in vec3 vNorm;\n" +
  "layout(location = 0) out vec4 fragColor;\n" +
  "layout(location = 1) out vec4 fragNormal;\n" +
  "void main() {\n" +
  "  vec4 t = texture(uTexArr, vec3(0.5, 0.5, float(vMatId)));\n" +
  "  ivec4 iv = texelFetch(uIntTex, ivec2(0, 0), 0);\n" +
  "  fragColor = t + vec4(iv);\n" +
  "  fragNormal = vec4(vNorm, 1.0);\n" +
  "}\n"
  let tf = unwrap_translated(translate_to_glsl410(fs, ShaderStage::Fragment))
  assert(is_es300(tf.reflection.version))
  assert_eq_int(tf.reflection.uniforms.length(), 2)
  assert_eq_int(tf.reflection.varyings.length(), 2)
  assert_eq_int(tf.reflection.outputs.length(), 2)
  match find_var(tf.reflection.outputs, "fragColor") {
    Some(v) => assert_eq_int(v.location, 0)
    None => debug_assert(false, "missing fragColor")
  }
  match find_var(tf.reflection.outputs, "fragNormal") {
    Some(v) => assert_eq_int(v.location, 1)
    None => debug_assert(false, "missing fragNormal")
  }
  assert(contains_str(tf.glsl410, "#version 410 core"))
  assert(!contains_str(tf.glsl410, "precision highp"))
  assert(contains_str(tf.glsl410, "layout(location = 0) out vec4 fragColor"))
  assert(contains_str(tf.glsl410, "texelFetch("))
}

test "comments_and_line_continuations" {
  let src =
  "/* leading block comment\n" +
  "   with unicode: 中文 */\n" +
  "#version 300 \\\n" +
  "es\n" +
  "// single line comment \\\n" +
  "continued comment\n" +
  "in vec2 aUv;\n" +
  "void main() { gl_Position = vec4(aUv, 0.0, 1.0); }\n"
  let r = unwrap_reflection(parse_and_reflect(src, ShaderStage::Vertex))
  assert(is_es300(r.version))
  assert_eq_int(r.attributes.length(), 1)
  assert_eq_str(r.attributes[0].name, "aUv")
}

test "error_empty_and_whitespace_only" {
  match parse_and_reflect("", ShaderStage::Vertex) {
    Err(GlslError::EmptySource) => ()
    _ => debug_assert(false, "expected EmptySource")
  }
  match parse_and_reflect("   \n// just a comment\n/* block */", ShaderStage::Fragment) {
    Err(GlslError::EmptySource) => ()
    _ => debug_assert(false, "expected EmptySource for comment-only")
  }
}

test "error_version_placement_and_unsupported" {
  let late_ver = "precision mediump float;\n#version 300 es\nvoid main() {}\n"
  match parse_and_reflect(late_ver, ShaderStage::Fragment) {
    Err(GlslError::PreprocessorError(_, _)) => ()
    _ => debug_assert(false, "expected PreprocessorError for late #version")
  }
  match parse_and_reflect("#version 450 core\nvoid main() {}\n", ShaderStage::Vertex) {
    Err(GlslError::UnsupportedVersion(_)) => ()
    _ => debug_assert(false, "expected UnsupportedVersion for 450 core")
  }
  match parse_and_reflect("#version 310 es\nvoid main() {}\n", ShaderStage::Vertex) {
    Err(GlslError::UnsupportedVersion(_)) => ()
    _ => debug_assert(false, "expected UnsupportedVersion for 310 es")
  }
  match parse_and_reflect("#version 300\nvoid main() {}\n", ShaderStage::Vertex) {
    Err(GlslError::UnsupportedVersion(_)) => ()
    _ => debug_assert(false, "expected UnsupportedVersion for 300 without es")
  }
}

test "error_stage_mismatch" {
  let vs_with_frag = "void main() { gl_FragColor = vec4(1.0); }\n"
  match parse_and_reflect(vs_with_frag, ShaderStage::Vertex) {
    Err(GlslError::StageMismatch(_)) => ()
    _ => debug_assert(false, "expected StageMismatch for gl_FragColor in Vertex")
  }
  let vs_with_discard = "void main() { discard; }\n"
  match parse_and_reflect(vs_with_discard, ShaderStage::Vertex) {
    Err(GlslError::StageMismatch(_)) => ()
    _ => debug_assert(false, "expected StageMismatch for discard in Vertex")
  }
  let fs_with_attr = "attribute vec3 aPos;\nvoid main() { gl_FragColor = vec4(aPos, 1.0); }\n"
  match parse_and_reflect(fs_with_attr, ShaderStage::Fragment) {
    Err(GlslError::StageMismatch(_)) => ()
    _ => debug_assert(false, "expected StageMismatch for attribute in Fragment")
  }
  let fs_with_pos = "void main() { gl_Position = vec4(1.0); }\n"
  match parse_and_reflect(fs_with_pos, ShaderStage::Fragment) {
    Err(GlslError::StageMismatch(_)) => ()
    _ => debug_assert(false, "expected StageMismatch for gl_Position in Fragment")
  }
}

test "error_lex_and_parse_security" {
  // Null byte
  let nul = "void main() {\x00}\n"
  match parse_and_reflect(nul, ShaderStage::Vertex) {
    Err(GlslError::LexError(_, _)) => ()
    _ => debug_assert(false, "expected LexError for null byte")
  }
  // Non-ASCII outside comment
  let non_ascii = "uniform float 温度;\nvoid main() {}\n"
  match parse_and_reflect(non_ascii, ShaderStage::Vertex) {
    Err(GlslError::LexError(_, _)) => ()
    _ => debug_assert(false, "expected LexError for non-ASCII")
  }
  // Unterminated block comment
  match parse_and_reflect("/* unterminated", ShaderStage::Vertex) {
    Err(GlslError::LexError(_, _)) => ()
    _ => debug_assert(false, "expected LexError for unterminated comment")
  }
  // Unmatched brace
  match parse_and_reflect("void main() { gl_Position = vec4(1.0);", ShaderStage::Vertex) {
    Err(GlslError::ParseError(_, _)) => ()
    _ => debug_assert(false, "expected ParseError for unmatched brace")
  }
  // Unclosed #ifdef
  match parse_and_reflect("#ifdef FOO\nvoid main() {}\n", ShaderStage::Vertex) {
    Err(GlslError::PreprocessorError(_, _)) => ()
    _ => debug_assert(false, "expected PreprocessorError for unclosed #ifdef")
  }
  // Stray #endif
  match parse_and_reflect("#endif\nvoid main() {}\n", ShaderStage::Vertex) {
    Err(GlslError::PreprocessorError(_, _)) => ()
    _ => debug_assert(false, "expected PreprocessorError for stray #endif")
  }
}

test "parse_limits_enforcement_and_unlimited" {
  let src =
  "#define A 1\n" +
  "#define B 2\n" +
  "#ifdef A\n" +
  "#ifdef B\n" +
  "void main() { float x = (((1.0))); gl_Position = vec4(x); }\n" +
  "#endif\n" +
  "#endif\n"

  // max_source_bytes
  match translate_to_glsl410_with_limits(src, ShaderStage::Vertex, ParseLimits::new(10, 0, 0, 0, 0)) {
    Err(GlslError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_source_bytes")
  }
  // max_tokens
  match translate_to_glsl410_with_limits(src, ShaderStage::Vertex, ParseLimits::new(0, 5, 0, 0, 0)) {
    Err(GlslError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_tokens")
  }
  // max_nesting_depth
  match translate_to_glsl410_with_limits(src, ShaderStage::Vertex, ParseLimits::new(0, 0, 2, 0, 0)) {
    Err(GlslError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_nesting_depth")
  }
  // max_preprocessor_depth
  match translate_to_glsl410_with_limits(src, ShaderStage::Vertex, ParseLimits::new(0, 0, 0, 1, 0)) {
    Err(GlslError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_preprocessor_depth")
  }
  // max_defines
  match translate_to_glsl410_with_limits(src, ShaderStage::Vertex, ParseLimits::new(0, 0, 0, 0, 1)) {
    Err(GlslError::LimitExceeded(_)) => ()
    _ => debug_assert(false, "expected LimitExceeded for max_defines")
  }
  // All <= 0 means unlimited -> should succeed
  match translate_to_glsl410_with_limits(src, ShaderStage::Vertex, ParseLimits::new(0, -1, 0, -5, 0)) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "expected Ok for unlimited limits, got: " + glsl_error_message(e))
  }
}

test "function_parameters_not_reflected_as_stage_io" {
  let src =
  "#version 300 es\n" +
  "in vec3 aPos;\n" +
  "void helper(in highp vec3 p, out lowp vec4 res, inout mediump float k) {\n" +
  "  res = vec4(p * k, 1.0);\n" +
  "}\n" +
  "void main() {\n" +
  "  vec4 r;\n" +
  "  float k = 1.0;\n" +
  "  helper(aPos, r, k);\n" +
  "  gl_Position = r;\n" +
  "}\n"
  let t = unwrap_translated(translate_to_glsl410(src, ShaderStage::Vertex))
  assert_eq_int(t.reflection.attributes.length(), 1)
  assert_eq_str(t.reflection.attributes[0].name, "aPos")
  assert_eq_int(t.reflection.varyings.length(), 0)
  assert_eq_int(t.reflection.outputs.length(), 0)
  assert(!contains_str(t.glsl410, "highp"))
  assert(!contains_str(t.glsl410, "lowp"))
  assert(!contains_str(t.glsl410, "mediump"))
}

test "es100_define_macro_body_texture_rewrite" {
  let src =
  "#define SAMPLE_ALBEDO(t, u) texture2D(t, u)\n" +
  "#define WRITE_OUT(c) gl_FragColor = (c)\n" +
  "precision mediump float;\n" +
  "uniform sampler2D uTex;\n" +
  "varying vec2 vUv;\n" +
  "void main() {\n" +
  "  WRITE_OUT(SAMPLE_ALBEDO(uTex, vUv));\n" +
  "}\n"
  let t = unwrap_translated(translate_to_glsl410(src, ShaderStage::Fragment))
  assert(contains_str(t.glsl410, "#define SAMPLE_ALBEDO(t, u) texture(t, u)"))
  assert(contains_str(t.glsl410, "#define WRITE_OUT(c) _fv_gl_FragColor = (c)"))
  assert(!contains_str(t.glsl410, "texture2D("))
}

test "es300_rejects_attribute_and_varying" {
  let bad_attr = "#version 300 es\nattribute vec3 aPos;\nvoid main() {}\n"
  match parse_and_reflect(bad_attr, ShaderStage::Vertex) {
    Err(GlslError::ParseError(_, _)) => ()
    _ => debug_assert(false, "expected ParseError for attribute in ES 3.00")
  }
  let bad_vary = "#version 300 es\nvarying vec2 vUv;\nvoid main() {}\n"
  match parse_and_reflect(bad_vary, ShaderStage::Fragment) {
    Err(GlslError::ParseError(_, _)) => ()
    _ => debug_assert(false, "expected ParseError for varying in ES 3.00")
  }
}

test "invariant_centroid_and_struct_precision_strip" {
  let src =
  "precision highp float;\n" +
  "invariant varying vec4 vClip;\n" +
  "struct Packed { lowp vec2 a; mediump vec3 b; };\n" +
  "uniform Packed uP;\n" +
  "void main() {\n" +
  "  vClip = vec4(uP.a, uP.b.xy);\n" +
  "  gl_Position = vClip;\n" +
  "}\n"
  let t = unwrap_translated(translate_to_glsl410(src, ShaderStage::Vertex))
  assert_eq_int(t.reflection.varyings.length(), 1)
  assert_eq_str(t.reflection.varyings[0].name, "vClip")
  assert_eq_int(t.reflection.uniforms.length(), 1)
  assert_eq_str(t.reflection.uniforms[0].glsl_type, "Packed")
  assert(contains_str(t.glsl410, "invariant out vec4 vClip"))
  assert(!contains_str(t.glsl410, "lowp"))
  assert(!contains_str(t.glsl410, "mediump"))
}
