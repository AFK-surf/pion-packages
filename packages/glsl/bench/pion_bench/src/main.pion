///| Pion Native head-to-head benchmark for `packages/glsl`.
///| Usage: pion_glsl_bench <vert|frag> <shader_path> <iters> [dump_glsl410_path]

import "glsl"

fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn is_sampler_type(t : String) -> Bool {
  t == "sampler2D" ||
  t == "samplerCube" ||
  t == "sampler3D" ||
  t == "sampler2DArray" ||
  t == "sampler2DShadow" ||
  t == "samplerCubeShadow" ||
  t == "sampler2DArrayShadow" ||
  t == "isampler2D" ||
  t == "isampler3D" ||
  t == "isamplerCube" ||
  t == "isampler2DArray" ||
  t == "usampler2D" ||
  t == "usampler3D" ||
  t == "usamplerCube" ||
  t == "usampler2DArray"
}

fn format_vars(vars : Array[glsl::VarInfo]) -> String {
  let sb = StringBuilder::new()
  sb.write_string(vars.length().to_string())
  sb.write_string(":")
  let mut i = 0
  while i < vars.length() {
    if i > 0 {
      sb.write_string(",")
    }
    let v = vars[i]
    sb.write_string(v.name)
    sb.write_string(":")
    sb.write_string(v.glsl_type)
    if v.array_size > 0 {
      sb.write_string("[")
      sb.write_string(v.array_size.to_string())
      sb.write_string("]")
    }
    if v.location >= 0 {
      sb.write_string("@")
      sb.write_string(v.location.to_string())
    }
    i = i + 1
  }
  sb.to_string()
}

fn format_samplers(uniforms : Array[glsl::VarInfo]) -> String {
  let samplers : Array[glsl::VarInfo] = []
  let mut i = 0
  while i < uniforms.length() {
    if is_sampler_type(uniforms[i].glsl_type) {
      samplers.push(uniforms[i])
    }
    i = i + 1
  }
  format_vars(samplers)
}

fn format_strings(arr : Array[String]) -> String {
  let sb = StringBuilder::new()
  sb.write_string(arr.length().to_string())
  sb.write_string(":")
  let mut i = 0
  while i < arr.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(arr[i])
    i = i + 1
  }
  sb.to_string()
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_glsl_bench <vert|frag> <shader_path> <iters> [dump_path]")
    return 1
  }
  let stage_str = args[1]
  let stage = if stage_str == "vert" {
    glsl::ShaderStage::Vertex
  } else {
    glsl::ShaderStage::Fragment
  }
  let path = args[2]
  let iters = parse_int(args[3])
  let raw_bytes = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }
  let source = raw_bytes.to_string()

  let mut last_out = ""
  let mut last_refl = glsl::Reflection::{
    version: glsl::GlslVersion::Es100,
    stage: stage,
    attributes: [],
    uniforms: [],
    varyings: [],
    outputs: [],
    extensions: [],
    uses_frag_color: false,
    uses_frag_data: false,
    max_frag_data_index: -1,
  }

  let mut i = 0
  while i < iters {
    match glsl::translate_to_glsl410(source, stage) {
      Ok(res) => {
        last_out = res.glsl410
        last_refl = res.reflection
      }
      Err(e) => {
        io_println(world, "error: " + glsl::glsl_error_message(e))
        return 1
      }
    }
    i = i + 1
  }

  if args.length() >= 5 {
    let out_bytes = Bytes::new(last_out.length())
    let mut k = 0
    while k < last_out.length() {
      out_bytes[k] = last_out.code_unit_at(k).to_byte()
      k = k + 1
    }
    let _ = fs_write_bytes(world, args[4], out_bytes)
  }

  let ver_str = match last_refl.version {
    glsl::GlslVersion::Es100 => "es100"
    glsl::GlslVersion::Es300 => "es300"
  }
  let st_str = match last_refl.stage {
    glsl::ShaderStage::Vertex => "vertex"
    glsl::ShaderStage::Fragment => "fragment"
  }
  io_println(world, "iters=" + iters.to_string())
  io_println(world, "stage=" + st_str + " version=" + ver_str)
  io_println(world, "attributes=" + format_vars(last_refl.attributes))
  io_println(world, "uniforms=" + format_vars(last_refl.uniforms))
  io_println(world, "varyings=" + format_vars(last_refl.varyings))
  io_println(world, "outputs=" + format_vars(last_refl.outputs))
  io_println(world, "samplers=" + format_samplers(last_refl.uniforms))
  io_println(world, "extensions=" + format_strings(last_refl.extensions))
  io_println(
    world,
    "frag_color=" +
    last_refl.uses_frag_color.to_string() +
    " frag_data=" +
    last_refl.uses_frag_data.to_string(),
  )
  0
}
