///| RFC 8259 & JSONTestSuite compliance tests (y_, n_, i_ vectors + strict UTF-8).

fn test_make_bytes(vals : Array[Int]) -> Bytes {
  let b = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

fn assert_ok(label : String, src : String) -> Json {
  match parse(src) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "[" + label + "] expected Ok, got Err: " + e.message)
      Json::Null
    }
  }
}

fn assert_err(label : String, src : String) -> Unit {
  match parse(src) {
    Ok(_) => debug_assert(false, "[" + label + "] expected Err, got Ok for: " + src)
    Err(e) => {
      debug_assert(e.line >= 1 && e.col >= 1, "[" + label + "] error line/col must be >= 1")
    }
  }
}

fn assert_err_bytes(label : String, vals : Array[Int]) -> Unit {
  let b = test_make_bytes(vals)
  match parse_bytes(b) {
    Ok(_) => debug_assert(false, "[" + label + "] expected Err for bytes, got Ok")
    Err(e) => {
      debug_assert(e.line >= 1 && e.col >= 1, "[" + label + "] error line/col must be >= 1")
    }
  }
}

fn assert_opt_bool(got : Option[Bool], expected : Bool, msg : String) -> Unit {
  match got {
    Some(b) => debug_assert(b == expected, msg)
    None => debug_assert(false, msg + " (got None)")
  }
}

fn assert_opt_i64(got : Option[Int64], expected : Int64, msg : String) -> Unit {
  match got {
    Some(n) => debug_assert(n == expected, msg)
    None => debug_assert(false, msg + " (got None)")
  }
}

fn assert_opt_i64_none(got : Option[Int64], msg : String) -> Unit {
  match got {
    None => ()
    Some(_) => debug_assert(false, msg + " (expected None)")
  }
}

fn assert_opt_u64(got : Option[UInt64], expected : UInt64, msg : String) -> Unit {
  match got {
    Some(n) => debug_assert(n == expected, msg)
    None => debug_assert(false, msg + " (got None)")
  }
}

fn assert_opt_u64_none(got : Option[UInt64], msg : String) -> Unit {
  match got {
    None => ()
    Some(_) => debug_assert(false, msg + " (expected None)")
  }
}

fn assert_opt_f64(got : Option[Double], expected : Double, msg : String) -> Unit {
  match got {
    Some(x) => debug_assert(x == expected, msg)
    None => debug_assert(false, msg + " (got None)")
  }
}

fn assert_opt_f64_none(got : Option[Double], msg : String) -> Unit {
  match got {
    None => ()
    Some(_) => debug_assert(false, msg + " (expected None)")
  }
}

fn assert_opt_str(got : Option[String], expected : String, msg : String) -> Unit {
  match got {
    Some(s) => debug_assert(s == expected, msg + " (got: " + s + ")")
    None => debug_assert(false, msg + " (got None)")
  }
}

fn assert_opt_json(got : Option[Json], expected : Json, msg : String) -> Unit {
  match got {
    Some(v) => debug_assert(json_eq(v, expected), msg)
    None => debug_assert(false, msg + " (got None)")
  }
}

fn assert_opt_json_none(got : Option[Json], msg : String) -> Unit {
  match got {
    None => ()
    Some(_) => debug_assert(false, msg + " (expected None)")
  }
}

fn assert_ptr_json(got : Result[Option[Json], JsonError], expected : Json, msg : String) -> Unit {
  match got {
    Ok(Some(v)) => debug_assert(json_eq(v, expected), msg)
    Ok(None) => debug_assert(false, msg + " (got Ok(None))")
    Err(e) => debug_assert(false, msg + " (got Err: " + e.message + ")")
  }
}

fn assert_ptr_none(got : Result[Option[Json], JsonError], msg : String) -> Unit {
  match got {
    Ok(None) => ()
    Ok(Some(_)) => debug_assert(false, msg + " (expected Ok(None), got Some)")
    Err(e) => debug_assert(false, msg + " (expected Ok(None), got Err: " + e.message + ")")
  }
}

fn assert_ok_str(got : Result[String, JsonError], expected : String, msg : String) -> Unit {
  match got {
    Ok(s) => debug_assert(s == expected, msg + " (got: " + s + ")")
    Err(e) => debug_assert(false, msg + " (got Err: " + e.message + ")")
  }
}

///|
test "rfc8259_y_primitives_and_whitespace" {
  debug_assert(assert_ok("y_null", "null").is_null(), "null")
  assert_opt_bool(assert_ok("y_true", "true").as_bool(), true, "true")
  assert_opt_bool(assert_ok("y_false", "false").as_bool(), false, "false")
  assert_opt_i64(assert_ok("y_ws", " \t\r\n 42 \r\n\t ").as_i64(), 42L, "ws around int")
  assert_opt_str(assert_ok("y_empty_str", "\"\"").as_str(), "", "empty str")
  match assert_ok("y_empty_arr", "[]").as_array() {
    Some(a) => debug_assert(a.length() == 0, "empty arr len")
    None => debug_assert(false, "empty arr")
  }
  match assert_ok("y_empty_obj", "{}").as_obj() {
    Some(o) => debug_assert(o.is_empty(), "empty obj")
    None => debug_assert(false, "empty obj")
  }
}

///|
test "rfc8259_y_strings_escapes_and_surrogates" {
  let v1 = assert_ok("y_escapes", "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"")
  assert_opt_str(v1.as_str(), "\"\\/\u{08}\u{0c}\n\r\t", "basic escapes")

  // U+1D11E MUSICAL SYMBOL G CLEF via UTF-16 surrogate pair \uD834\uDD1E
  let v2 = assert_ok("y_gclef", "\"\\uD834\\uDD1E\"")
  assert_opt_str(v2.as_str(), "𝄞", "surrogate pair G-clef")

  // U+1F600 GRINNING FACE via \uD83D\uDE00
  let v3 = assert_ok("y_emoji", "\"\\uD83D\\uDE00\"")
  assert_opt_str(v3.as_str(), "😀", "surrogate pair emoji")

  // U+0000 escaped NUL is valid in RFC 8259
  let v4 = assert_ok("y_nul", "\"a\\u0000b\"")
  match v4.as_str() {
    Some(s) => {
      debug_assert(s.length() == 3, "nul string length")
      debug_assert(s.code_unit_at(0) == 97, "a")
      debug_assert(s.code_unit_at(1) == 0, "nul byte")
      debug_assert(s.code_unit_at(2) == 98, "b")
    }
    None => debug_assert(false, "expected string")
  }

  // Raw UTF-8 multi-byte characters (2, 3, 4 bytes)
  let v5 = assert_ok("y_utf8", "\"café 日本語 🚀\"")
  assert_opt_str(v5.as_str(), "café 日本語 🚀", "raw utf8")

  // Lowercase and uppercase hex escapes
  let v6 = assert_ok("y_hex_case", "\"\\u0041\\u006a\\u006A\"")
  assert_opt_str(v6.as_str(), "Ajj", "hex case")
}

///|
test "rfc8259_y_nested_structures" {
  let doc = "{\"a\":[1,2,{\"b\":true,\"c\":null,\"d\":[[]]}],\"e\":{}}"
  let v = assert_ok("y_nested", doc)
  assert_ptr_json(v.pointer("/a/2/b"), Json::Bool(true), "nested bool")
  assert_ptr_json(v.pointer("/a/2/c"), Json::Null, "nested null")
  assert_ok_str(stringify(v), doc, "compact roundtrip mismatch")
}

///|
test "rfc8259_n_reject_json5_and_syntax_extensions" {
  // Comments
  assert_err("n_line_comment", "// comment\n1")
  assert_err("n_block_comment", "/* comment */ 1")
  assert_err("n_trailing_comment", "1 // comment")
  // Trailing commas
  assert_err("n_arr_trailing_comma", "[1,]")
  assert_err("n_arr_only_comma", "[,]")
  assert_err("n_obj_trailing_comma", "{\"a\":1,}")
  assert_err("n_obj_double_comma", "{\"a\":1,,\"b\":2}")
  // Single quotes and unquoted keys
  assert_err("n_single_quote_str", "'hello'")
  assert_err("n_single_quote_key", "{'a':1}")
  assert_err("n_unquoted_key", "{a:1}")
  // Non-RFC8259 numbers
  assert_err("n_leading_plus", "+1")
  assert_err("n_leading_zero", "01")
  assert_err("n_neg_leading_zero", "-01")
  assert_err("n_double_zero", "00")
  assert_err("n_leading_zero_frac", "01.5")
  assert_err("n_trailing_dot", "1.")
  assert_err("n_trailing_dot_exp", "1.e2")
  assert_err("n_leading_dot", ".5")
  assert_err("n_neg_leading_dot", "-.5")
  assert_err("n_bare_minus", "-")
  assert_err("n_double_minus", "--1")
  assert_err("n_incomplete_exp", "1e")
  assert_err("n_incomplete_exp_plus", "1e+")
  assert_err("n_incomplete_exp_minus", "1E-")
  assert_err("n_hex_num", "0x10")
  assert_err("n_nan", "NaN")
  assert_err("n_infinity", "Infinity")
  assert_err("n_neg_infinity", "-Infinity")
  assert_err("n_exp_dot", "1e1.5")
}

///|
test "rfc8259_n_reject_trailing_empty_and_broken_containers" {
  assert_err("n_empty", "")
  assert_err("n_only_ws", "   \t\r\n  ")
  assert_err("n_trailing_num", "1 2")
  assert_err("n_trailing_arr", "[] []")
  assert_err("n_trailing_word", "true false")
  assert_err("n_trailing_comma_root", "1,")
  assert_err("n_unclosed_arr", "[1, 2")
  assert_err("n_unclosed_obj", "{\"a\": 1")
  assert_err("n_mismatched_close", "[1}")
  assert_err("n_extra_close", "[]]")
  assert_err("n_missing_colon", "{\"a\" 1}")
  assert_err("n_missing_value", "{\"a\":}")
  assert_err("n_missing_comma_arr", "[1 2]")
  assert_err("n_missing_comma_obj", "{\"a\":1 \"b\":2}")
  assert_err("n_non_string_key", "{1:2}")
  assert_err("n_unclosed_str", "\"abc")
  assert_err("n_unclosed_str_esc", "\"abc\\")
}

///|
test "rfc8259_n_reject_invalid_escapes_and_lone_surrogates" {
  // Invalid escape sequences
  assert_err("n_esc_a", "\"\\a\"")
  assert_err("n_esc_x", "\"\\x41\"")
  assert_err("n_esc_single_quote", "\"\\'\"")
  assert_err("n_esc_zero", "\"\\0\"")
  assert_err("n_esc_v", "\"\\v\"")
  assert_err("n_esc_short_u", "\"\\u123\"")
  assert_err("n_esc_bad_hex", "\"\\u123G\"")
  assert_err("n_esc_newline", "\"\\\n\"")
  // Lone UTF-16 surrogates (strict RFC 8259 / Unicode scalar value requirement)
  assert_err("n_lone_high_surr", "\"\\uD800\"")
  assert_err("n_lone_high_surr_end", "\"\\uDBFF\"")
  assert_err("n_lone_low_surr", "\"\\uDC00\"")
  assert_err("n_lone_low_surr_end", "\"\\uDFFF\"")
  assert_err("n_high_followed_by_ascii", "\"\\uD800a\"")
  assert_err("n_high_followed_by_non_low", "\"\\uD800\\u0041\"")
  assert_err("n_high_followed_by_high", "\"\\uD800\\uD800\"")
  assert_err("n_reversed_surrogates", "\"\\uDC00\\uD800\"")
  assert_err("n_high_truncated_esc", "\"\\uD800\\uDC0\"")
}

///|
test "rfc8259_n_reject_unescaped_control_chars_0x00_to_0x1F" {
  // Every control byte 0x00..0x1F raw inside a JSON string must be rejected
  let mut c = 0
  while c < 0x20 {
    assert_err_bytes("n_ctrl_" + c.to_string(), [34, c, 34])
    c = c + 1
  }
}

///|
test "rfc8259_n_reject_non_rfc8259_whitespace_and_bom" {
  // Vertical tab 0x0B and form feed 0x0C are NOT JSON whitespace
  assert_err_bytes("n_ws_vt", [0x0B, 49])
  assert_err_bytes("n_ws_ff", [0x0C, 49])
  // UTF-8 NBSP (U+00A0 = C2 A0)
  assert_err_bytes("n_ws_nbsp", [0xC2, 0xA0, 49])
  // UTF-8 BOM (EF BB BF) is forbidden by RFC 8259 §8.1
  assert_err_bytes("n_bom", [0xEF, 0xBB, 0xBF, 123, 125])
}

///|
test "rfc8259_n_reject_invalid_utf8_bytes" {
  // Valid UTF-8 bytes succeed
  let valid = test_make_bytes([34, 0xE6, 0x97, 0xA5, 34]) // "日"
  match parse_bytes(valid) {
    Ok(v) => assert_opt_str(v.as_str(), "日", "valid utf8 bytes")
    Err(e) => debug_assert(false, "valid utf8 bytes failed: " + e.message)
  }

  // Overlong 2-byte encoding of '/' (C0 AF)
  assert_err_bytes("n_utf8_overlong_2", [34, 0xC0, 0xAF, 34])
  // Overlong 3-byte encoding (E0 80 AF)
  assert_err_bytes("n_utf8_overlong_3", [34, 0xE0, 0x80, 0xAF, 34])
  // Overlong 4-byte encoding (F0 80 80 AF)
  assert_err_bytes("n_utf8_overlong_4", [34, 0xF0, 0x80, 0x80, 0xAF, 34])
  // UTF-8 encoded surrogate U+D800 (ED A0 80)
  assert_err_bytes("n_utf8_surrogate", [34, 0xED, 0xA0, 0x80, 34])
  // Code point > U+10FFFF (F4 90 80 80)
  assert_err_bytes("n_utf8_above_max", [34, 0xF4, 0x90, 0x80, 0x80, 34])
  // Truncated 2-byte / 3-byte / 4-byte
  assert_err_bytes("n_utf8_trunc_2", [34, 0xC2, 34])
  assert_err_bytes("n_utf8_trunc_3", [34, 0xE2, 0x82, 34])
  assert_err_bytes("n_utf8_trunc_4", [34, 0xF0, 0x9F, 0x98, 34])
  // Stray continuation byte 0x80 and invalid lead 0xFF
  assert_err_bytes("n_utf8_cont", [34, 0x80, 34])
  assert_err_bytes("n_utf8_ff", [34, 0xFF, 34])
}

///|
test "rfc8259_i_huge_numbers_and_zero_variants" {
  // Huge exponents preserved losslessly as BigNum
  let v_pos = assert_ok("i_huge_pos_exp", "1e500")
  assert_opt_str(v_pos.raw_repr(), "1e500", "1e500 raw_repr")
  assert_opt_f64_none(v_pos.as_f64(), "1e500 overflows f64")

  let v_neg = assert_ok("i_huge_neg_exp", "-1e500")
  assert_opt_str(v_neg.raw_repr(), "-1e500", "-1e500 raw_repr")
  assert_opt_f64_none(v_neg.as_f64(), "-1e500 overflows f64")

  // Underflow to 0.0 is finite IEEE-754 double
  let v_under = assert_ok("i_underflow", "1e-500")
  assert_opt_f64(v_under.as_f64(), 0.0, "1e-500 underflows to 0.0")

  // -0.0 preserves negative zero sign bit
  let v_neg_zero = assert_ok("i_neg_zero_float", "-0.0")
  match v_neg_zero.as_f64() {
    Some(x) => debug_assert(x.reinterpret_as_uint64() == 0x8000000000000000UL, "-0.0 sign bit")
    None => debug_assert(false, "expected float for -0.0")
  }
}
