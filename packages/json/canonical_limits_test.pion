///| Serialization (compact, pretty, RFC 8785 JCS canonical) and DoS resource limit tests.

///|
test "stringify_compact_pretty_and_non_finite_rejection" {
  let doc = Json::obj([
    ("b", Json::arr([Json::int(1L), Json::bool(false)])),
    ("a", Json::str("line1\nline2")),
    ("empty_arr", Json::arr([])),
    ("empty_obj", Json::obj([])),
  ])
  let compact = match stringify(doc) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "stringify failed: " + e.message)
      ""
    }
  }
  debug_assert(
    compact == "{\"b\":[1,false],\"a\":\"line1\\nline2\",\"empty_arr\":[],\"empty_obj\":{}}",
    "compact output: " + compact,
  )

  let pretty = match stringify_pretty(doc, 2) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "stringify_pretty failed: " + e.message)
      ""
    }
  }
  let expected_pretty = "{\n  \"b\": [\n    1,\n    false\n  ],\n  \"a\": \"line1\\nline2\",\n  \"empty_arr\": [],\n  \"empty_obj\": {}\n}"
  debug_assert(pretty == expected_pretty, "pretty output mismatch:\n" + pretty)

  // Non-finite floats must be rejected with NonFiniteNumber
  let nan_val = Json::Float(0.0 / 0.0)
  let inf_val = Json::Float(1.0 / 0.0)
  let neg_inf_val = Json::Float(-1.0 / 0.0)
  match stringify(nan_val) {
    Err(e) => {
      match e.kind {
        JsonErrorKind::NonFiniteNumber => ()
        _ => debug_assert(false, "expected NonFiniteNumber for NaN")
      }
    }
    Ok(_) => debug_assert(false, "NaN must not serialize")
  }
  match stringify(inf_val) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "Infinity must not serialize")
  }
  match stringify_canonical(neg_inf_val) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "-Infinity must not serialize")
  }
}

///|
test "stringify_canonical_rfc8785_jcs_utf16_key_sort_and_numbers" {
  // RFC 8785 §3.2.3 sorting example:
  // UTF-16 code units order:
  // "\r" (0x000D) < "1" (0x0031) < "\u0080" (0x0080) < "\u00f6" (0x00F6)
  // < "\u20ac" (0x20AC) < "\uD83D\uDE00" ("😀", 0xD83D) < "\uFB33" (0xFB33)
  // Note: in UTF-8 order, "😀" (U+1F600) would come AFTER "\uFB33"!
  // RFC 8785 JCS requires UTF-16 code unit ordering, so "😀" MUST come BEFORE "\uFB33".
  let doc = Json::obj([
    ("דּ", Json::str("hebrew_presentation_U+FB33")),
    ("😀", Json::str("emoji_U+1F600")),
    ("€", Json::str("euro_U+20AC")),
    ("\r", Json::str("cr")),
    ("ö", Json::str("latin_U+00F6")),
    ("1", Json::str("one")),
    ("\u{80}", Json::str("ctrl_U+0080")),
  ])
  let canon = match stringify_canonical(doc) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "canonical failed: " + e.message)
      ""
    }
  }
  let expected = "{\"\\r\":\"cr\",\"1\":\"one\",\"\u{80}\":\"ctrl_U+0080\",\"ö\":\"latin_U+00F6\",\"€\":\"euro_U+20AC\",\"😀\":\"emoji_U+1F600\",\"דּ\":\"hebrew_presentation_U+FB33\"}"
  debug_assert(canon == expected, "RFC 8785 UTF-16 sort mismatch:\n" + canon)

  // RFC 8785 §3.2.2.3 number rules + lowercase \u00xx control escaping
  let num_doc = Json::obj([
    ("neg_zero", Json::Float(-0.0)),
    ("int_float", Json::Float(1.0)),
    ("e20", Json::Float(1.0e20)),
    ("e21", Json::Float(1.0e21)),
    ("small_fixed", Json::Float(0.000001)),
    ("small_exp", Json::Float(0.0000001)),
    ("ctrl", Json::Str("\u{0b}")),
    ("nested", Json::obj([("b", Json::int(2L)), ("a", Json::int(1L))])),
  ])
  let num_canon = match stringify_canonical(num_doc) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "canonical num failed: " + e.message)
      ""
    }
  }
  let expected_num = "{\"ctrl\":\"\\u000b\",\"e20\":100000000000000000000,\"e21\":1e+21,\"int_float\":1,\"neg_zero\":0,\"nested\":{\"a\":1,\"b\":2},\"small_exp\":1e-7,\"small_fixed\":0.000001}"
  debug_assert(num_canon == expected_num, "RFC 8785 number/escape mismatch:\n" + num_canon)
}

///|
test "limits_deep_nesting_5000_iterative_no_stack_overflow" {
  let depth = 5000
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_byte((91).to_byte())
    i = i + 1
  }
  sb.write_byte((49).to_byte())
  let mut j = 0
  while j < depth {
    sb.write_byte((93).to_byte())
    j = j + 1
  }
  let deep = sb.to_string()

  // Default max_depth=128 must reject
  match parse(deep) {
    Ok(_) => debug_assert(false, "default max_depth must reject 5000 nesting")
    Err(e) => {
      match e.kind {
        JsonErrorKind::DepthLimitExceeded => ()
        _ => debug_assert(false, "expected DepthLimitExceeded")
      }
    }
  }

  // Raising max_depth allows 5000-deep iterative parse + stringify + json_eq with 0 stack overflow
  let lim = JsonLimits::{
    max_depth: 6000,
    max_bytes: 1048576,
    max_elements: 100000,
    max_string_bytes: 65536,
    duplicate_keys: DuplicateKeyPolicy::LastWins,
  }
  let v1 = match parse_with_limits(deep, lim) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "5000-deep parse failed: " + e.message)
      Json::Null
    }
  }
  let s = match stringify(v1) {
    Ok(out) => out
    Err(e) => {
      debug_assert(false, "5000-deep stringify failed: " + e.message)
      ""
    }
  }
  debug_assert(s == deep, "5000-deep roundtrip mismatch")
  let v2 = match parse_with_limits(s, lim) {
    Ok(v) => v
    Err(_) => Json::Null
  }
  debug_assert(json_eq(v1, v2), "5000-deep iterative json_eq")
}

///|
test "limits_max_bytes_max_elements_max_string_bytes" {
  // max_bytes
  let lim_bytes = JsonLimits::{
    max_depth: 128,
    max_bytes: 10,
    max_elements: 1000,
    max_string_bytes: 1000,
    duplicate_keys: DuplicateKeyPolicy::LastWins,
  }
  match parse_with_limits("[1,2,3,4,5,6]", lim_bytes) {
    Err(e) => {
      match e.kind {
        JsonErrorKind::ByteLimitExceeded => ()
        _ => debug_assert(false, "expected ByteLimitExceeded")
      }
    }
    Ok(_) => debug_assert(false, "max_bytes=10 must reject 13-byte input")
  }

  // max_elements
  let lim_elems = JsonLimits::{
    max_depth: 128,
    max_bytes: 10000,
    max_elements: 5,
    max_string_bytes: 1000,
    duplicate_keys: DuplicateKeyPolicy::LastWins,
  }
  match parse_with_limits("[1,2,3,4,5,6]", lim_elems) {
    Err(e) => {
      match e.kind {
        JsonErrorKind::ElementLimitExceeded => ()
        _ => debug_assert(false, "expected ElementLimitExceeded")
      }
    }
    Ok(_) => debug_assert(false, "max_elements=5 must reject 7 values")
  }

  // max_string_bytes
  let lim_str = JsonLimits::{
    max_depth: 128,
    max_bytes: 10000,
    max_elements: 1000,
    max_string_bytes: 4,
    duplicate_keys: DuplicateKeyPolicy::LastWins,
  }
  match parse_with_limits("\"hello\"", lim_str) {
    Err(e) => {
      match e.kind {
        JsonErrorKind::StringLimitExceeded => ()
        _ => debug_assert(false, "expected StringLimitExceeded")
      }
    }
    Ok(_) => debug_assert(false, "max_string_bytes=4 must reject 'hello'")
  }
}
