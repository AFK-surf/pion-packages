///| Order-preserving JsonObject, O(1) large-object lookup, DuplicateKeyPolicy,
///| ergonomic immutable helpers, and RFC 6901 JSON Pointer tests.

///|
test "object_insertion_order_and_duplicate_key_policies" {
  let src = "{\"z\":1,\"a\":2,\"m\":3,\"a\":20,\"z\":10}"

  // Default (LastWins): preserves first-seen key order [z, a, m] with last values
  let v_last = match parse(src) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "LastWins failed: " + e.message)
      Json::Null
    }
  }
  match v_last.as_obj() {
    Some(obj) => {
      let ks = obj.keys()
      debug_assert(ks.length() == 3, "LastWins key count")
      debug_assert(ks[0] == "z" && ks[1] == "a" && ks[2] == "m", "LastWins order")
      assert_opt_json(obj.get("z"), Json::Int(10L), "LastWins z")
      assert_opt_json(obj.get("a"), Json::Int(20L), "LastWins a")
      assert_opt_json(obj.get("m"), Json::Int(3L), "LastWins m")
    }
    None => debug_assert(false, "expected Object")
  }

  // FirstWins: keeps first values
  let lim_first = JsonLimits::{
    max_depth: 128,
    max_bytes: 1048576,
    max_elements: 100000,
    max_string_bytes: 65536,
    duplicate_keys: DuplicateKeyPolicy::FirstWins,
  }
  let v_first = match parse_with_limits(src, lim_first) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "FirstWins failed: " + e.message)
      Json::Null
    }
  }
  assert_opt_i64(v_first.get_i64("z"), 1L, "FirstWins z")
  assert_opt_i64(v_first.get_i64("a"), 2L, "FirstWins a")

  // Reject: returns DuplicateKey error
  let lim_reject = JsonLimits::{
    max_depth: 128,
    max_bytes: 1048576,
    max_elements: 100000,
    max_string_bytes: 65536,
    duplicate_keys: DuplicateKeyPolicy::Reject,
  }
  match parse_with_limits(src, lim_reject) {
    Ok(_) => debug_assert(false, "Reject must fail on duplicate keys")
    Err(e) => {
      match e.kind {
        JsonErrorKind::DuplicateKey => ()
        _ => debug_assert(false, "expected DuplicateKey error kind")
      }
    }
  }
}

///|
test "object_large_o1_index_10k_keys" {
  let n = 10000
  let sb = StringBuilder::new()
  sb.write_byte((123).to_byte())
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_byte((44).to_byte())
    }
    sb.write_string("\"key_")
    sb.write_string(i.to_string())
    sb.write_string("\":")
    sb.write_string(i.to_string())
    i = i + 1
  }
  sb.write_byte((125).to_byte())

  let v = match parse(sb.to_string()) {
    Ok(x) => x
    Err(e) => {
      debug_assert(false, "10k object parse failed: " + e.message)
      Json::Null
    }
  }
  match v.as_obj() {
    Some(obj) => {
      debug_assert(obj.len() == n, "10k object len")
      // 10,000 random-stride lookups must complete in O(1) each
      let mut q = 0
      while q < n {
        let idx = (q * 7919) % n
        let k = "key_" + idx.to_string()
        assert_opt_json(obj.get(k), Json::Int(idx.to_int64()), "lookup " + k)
        q = q + 1
      }
      assert_opt_json_none(obj.get("missing_key"), "missing key")
      debug_assert(!obj.contains_key("missing_key"), "contains_key false")
      debug_assert(obj.contains_key("key_9999"), "contains_key true")
    }
    None => debug_assert(false, "expected Object")
  }
}

///|
test "ergonomic_immutable_helpers_and_builders" {
  let doc = Json::obj([
    ("id", Json::int(9007199254740993L)),
    ("uid", Json::big_num("18446744073709551615")),
    ("name", Json::str("pion")),
    ("score", Json::float(99.5)),
    ("active", Json::bool(true)),
    ("empty", Json::null()),
    ("tags", Json::arr([Json::str("fast"), Json::str("safe")])),
    ("meta", Json::obj([("v", Json::int(1L))])),
  ])

  assert_opt_i64(doc.get_i64("id"), 9007199254740993L, "get_i64")
  assert_opt_u64(doc.get_u64("uid"), 18446744073709551615UL, "get_u64")
  assert_opt_str(doc.get_str("name"), "pion", "get_str")
  assert_opt_f64(doc.get_f64("score"), 99.5, "get_f64")
  assert_opt_bool(doc.get_bool("active"), true, "get_bool")
  assert_opt_json(doc.get("empty"), Json::Null, "get null")
  match doc.get("empty") {
    Some(e) => debug_assert(e.is_null(), "is_null")
    None => debug_assert(false, "missing empty")
  }
  match doc.get_array("tags") {
    Some(arr) => debug_assert(arr.length() == 2, "get_array len")
    None => debug_assert(false, "get_array")
  }
  match doc.get("tags") {
    Some(t) => {
      assert_opt_json(t.at(0), Json::Str("fast"), "at(0)")
      assert_opt_json(t.at(1), Json::Str("safe"), "at(1)")
      assert_opt_json_none(t.at(2), "at(2) oob")
      assert_opt_json_none(t.at(-1), "at(-1) oob")
    }
    None => debug_assert(false, "missing tags")
  }
  match doc.get_obj("meta") {
    Some(m) => assert_opt_json(m.get("v"), Json::Int(1L), "get_obj")
    None => debug_assert(false, "get_obj")
  }

  // Immutable set_field does not mutate original
  let updated = match doc.set_field("name", Json::str("pion-json")) {
    Ok(u) => u
    Err(e) => {
      debug_assert(false, "set_field failed: " + e.message)
      Json::Null
    }
  }
  assert_opt_str(updated.get_str("name"), "pion-json", "updated name")
  assert_opt_str(doc.get_str("name"), "pion", "original unchanged")

  // Immutable without_keys
  let stripped = match updated.without_keys(["empty", "score"]) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "without_keys failed: " + e.message)
      Json::Null
    }
  }
  assert_opt_json_none(stripped.get("empty"), "empty removed")
  assert_opt_json_none(stripped.get("score"), "score removed")
  assert_opt_str(stripped.get_str("name"), "pion-json", "name kept")
  assert_opt_json(updated.get("score"), Json::Float(99.5), "updated unchanged")

  // Immutable merge_object
  let patch = Json::obj([("active", Json::bool(false)), ("extra", Json::int(7L))])
  let merged = match stripped.merge_object(patch) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, "merge_object failed: " + e.message)
      Json::Null
    }
  }
  assert_opt_bool(merged.get_bool("active"), false, "merged active overridden")
  assert_opt_i64(merged.get_i64("extra"), 7L, "merged extra added")
  assert_opt_bool(stripped.get_bool("active"), true, "stripped unchanged")

  // Non-object returns TypeMismatch
  match Json::int(1L).set_field("a", Json::null()) {
    Err(e) => {
      match e.kind {
        JsonErrorKind::TypeMismatch => ()
        _ => debug_assert(false, "expected TypeMismatch")
      }
    }
    Ok(_) => debug_assert(false, "set_field on int must fail")
  }
}

///|
test "rfc6901_json_pointer_compliance" {
  // Official RFC 6901 §5 example document
  let src = "{\"foo\":[\"bar\",\"baz\"],\"\":0,\"a/b\":1,\"c%d\":2,\"e^f\":3,\"g|h\":4,\"i\\\\j\":5,\"k\\\"l\":6,\" \":7,\"m~n\":8}"
  let doc = match parse(src) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse RFC 6901 doc failed: " + e.message)
      Json::Null
    }
  }
  assert_ptr_json(doc.pointer(""), doc, "ptr root")
  assert_ptr_json(doc.pointer("/foo/0"), Json::Str("bar"), "ptr /foo/0")
  assert_ptr_json(doc.pointer("/"), Json::Int(0L), "ptr /")
  assert_ptr_json(doc.pointer("/a~1b"), Json::Int(1L), "ptr /a~1b")
  assert_ptr_json(doc.pointer("/c%d"), Json::Int(2L), "ptr /c%d")
  assert_ptr_json(doc.pointer("/e^f"), Json::Int(3L), "ptr /e^f")
  assert_ptr_json(doc.pointer("/g|h"), Json::Int(4L), "ptr /g|h")
  assert_ptr_json(doc.pointer("/i\\j"), Json::Int(5L), "ptr /i\\j")
  assert_ptr_json(doc.pointer("/k\"l"), Json::Int(6L), "ptr /k\"l")
  assert_ptr_json(doc.pointer("/ "), Json::Int(7L), "ptr / ")
  assert_ptr_json(doc.pointer("/m~0n"), Json::Int(8L), "ptr /m~0n")
  // Non-existent path -> Ok(None)
  assert_ptr_none(doc.pointer("/foo/2"), "ptr oob")
  assert_ptr_none(doc.pointer("/foo/01"), "ptr leading zero array idx")
  assert_ptr_none(doc.pointer("/missing"), "ptr missing")
  // Invalid pointer syntax -> Err(InvalidPointer)
  match doc.pointer("foo") {
    Err(e) => {
      match e.kind {
        JsonErrorKind::InvalidPointer => ()
        _ => debug_assert(false, "expected InvalidPointer for no leading /")
      }
    }
    Ok(_) => debug_assert(false, "missing leading / must fail")
  }
  match doc.pointer("/a~2b") {
    Err(e) => {
      match e.kind {
        JsonErrorKind::InvalidPointer => ()
        _ => debug_assert(false, "expected InvalidPointer for ~2")
      }
    }
    Ok(_) => debug_assert(false, "~2 must fail")
  }
  match doc.pointer("/a~") {
    Err(e) => {
      match e.kind {
        JsonErrorKind::InvalidPointer => ()
        _ => debug_assert(false, "expected InvalidPointer for trailing ~")
      }
    }
    Ok(_) => debug_assert(false, "trailing ~ must fail")
  }
}
