///| Regression tests for all Wave 17 red-team findings (P0-1..P0-2, P1-1..P1-5, P2-1..P2-5).

fn rt_raw_bytes(bs : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < bs.length() {
    sb.write_byte(bs[i].to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| P0-1 & P2-3: BigNum validation in all serializers and accessors.
test "rt_p0_1_p2_3_bignum_validation_serializers_and_accessors" {
  let invalid = [
    "1,\"admin\":true", "NaN", "Infinity", "-Infinity", "", " ", "0x10", "01", "-01", "00",
    "1 ", " 1", "1e", "1e+", "1e-", "+1", "1.", ".5", "-.5", "1.5.5", "abc", "-", "--1",
  ]
  let mut i = 0
  while i < invalid.length() {
    let raw = invalid[i]
    debug_assert(!is_valid_json_number(raw), "must reject invalid number: " + raw)
    let bn = Json::big_num(raw)
    assert_opt_f64_none(bn.as_f64(), "as_f64 must reject: " + raw)
    assert_opt_i64_none(bn.as_i64(), "as_i64 must reject: " + raw)
    assert_opt_u64_none(bn.as_u64(), "as_u64 must reject: " + raw)
    let doc = Json::obj([("amount", bn)])
    match stringify(doc) {
      Err(e) => {
        match e.kind {
          JsonErrorKind::InvalidNumber => ()
          _ => debug_assert(false, "stringify expected InvalidNumber for: " + raw)
        }
      }
      Ok(s) => debug_assert(false, "stringify must reject invalid BigNum " + raw + ", got: " + s)
    }
    match stringify_pretty(doc, 2) {
      Err(e) => {
        match e.kind {
          JsonErrorKind::InvalidNumber => ()
          _ => debug_assert(false, "stringify_pretty expected InvalidNumber for: " + raw)
        }
      }
      Ok(s) => debug_assert(false, "stringify_pretty must reject invalid BigNum " + raw + ", got: " + s)
    }
    match stringify_canonical(doc) {
      Err(e) => {
        match e.kind {
          JsonErrorKind::InvalidNumber => ()
          _ => debug_assert(false, "stringify_canonical expected InvalidNumber for: " + raw)
        }
      }
      Ok(s) => debug_assert(false, "stringify_canonical must reject invalid BigNum " + raw + ", got: " + s)
    }
    i = i + 1
  }

  // Valid BigNum literals are accepted
  let valid = ["0", "-0", "42", "-9223372036854775809", "18446744073709551615", "1.5e+10", "0e999999999"]
  i = 0
  while i < valid.length() {
    debug_assert(is_valid_json_number(valid[i]), "must accept valid number: " + valid[i])
    assert_ok_str(stringify(Json::big_num(valid[i])), valid[i], "valid BigNum stringify")
    i = i + 1
  }
  assert_opt_f64(Json::big_num("0e999999999").as_f64(), 0.0, "0e999999999 is finite 0.0")
}

///| P0-2: White-box HashDoS test forcing probe chain > 256 and verifying AVL tree fallback.
test "rt_p0_2_whitebox_hashdos_avl_fallback" {
  let seed : UInt64 = 0x123456789ABCDEF0UL
  let b = ObjIndexBuilder::new(512, seed)
  let colliding : Array[String] = []
  let mut cand = 0
  // Find 300 distinct keys whose hash collides at bucket 0 mod 512 (probe chain > 256).
  while colliding.length() < 300 {
    let k = "c_" + cand.to_string()
    if (hash_str_seeded(k, seed) & 511UL) == 0UL {
      colliding.push(k)
    }
    cand = cand + 1
  }
  let mut i = 0
  while i < colliding.length() {
    let prev = b.insert_if_absent(colliding[i], i)
    debug_assert(prev == -1, "fresh colliding key must insert")
    i = i + 1
  }
  // Duplicate insert after AVL fallback must return existing index
  debug_assert(b.insert_if_absent(colliding[0], 999) == 0, "dup key 0 in AVL")
  debug_assert(b.insert_if_absent(colliding[299], 999) == 299, "dup key 299 in AVL")

  let frozen = b.freeze()
  match frozen {
    ObjectHashIndex::Tree(_) => ()
    ObjectHashIndex::Hash(_, _, _, _, _) => debug_assert(false, "expected AVL tree fallback after > 256 probes")
  }
  i = 0
  while i < colliding.length() {
    debug_assert(frozen.get_idx(colliding[i]) == i, "AVL lookup mismatch at " + i.to_string())
    i = i + 1
  }
  debug_assert(frozen.get_idx("not_present_key") == -1, "AVL missing key")
}

///| P1-1 & P1-2: RFC 8785 (JCS) canonical number serialization for Int > 2^53 and BigNum.
test "rt_p1_1_p1_2_jcs_canonical_numbers_and_nonfinite_bignum" {
  let non_finite = ["1e400", "[-1e400]", "{\"a\":1E999}", "10e399"]
  let mut i = 0
  while i < non_finite.length() {
    let v = assert_ok("jcs_nf_" + i.to_string(), non_finite[i])
    match stringify_canonical(v) {
      Err(e) => {
        match e.kind {
          JsonErrorKind::NonFiniteNumber => ()
          _ => debug_assert(false, "expected NonFiniteNumber for " + non_finite[i])
        }
      }
      Ok(s) => debug_assert(false, "expected Err for non-finite " + non_finite[i] + ", got: " + s)
    }
    i = i + 1
  }

  let es_cases : Array[(String, String)] = [
    ("9007199254740991", "9007199254740991"),
    ("-9007199254740991", "-9007199254740991"),
    ("9007199254740992", "9007199254740992"),
    ("9007199254740993", "9007199254740992"),
    ("9223372036854775807", "9223372036854776000"),
    ("-9223372036854775808", "-9223372036854776000"),
    ("18446744073709551615", "18446744073709552000"),
    ("123456789012345678901234567890", "1.2345678901234568e+29"),
    ("-0", "0"),
  ]
  i = 0
  while i < es_cases.length() {
    let (src, want) = es_cases[i]
    let v = assert_ok("jcs_es_" + src, src)
    assert_ok_str(stringify_canonical(v), want, "JCS(" + src + ")")
    i = i + 1
  }
  assert_ok_str(stringify_canonical(Json::big_num("-0.0")), "0", "JCS BigNum(-0.0)")
}

///| P1-3 & P1-4: True immutable value model (no internal Array aliasing).
test "rt_p1_3_p1_4_immutable_defensive_copies" {
  let raw_arr : Array[Json] = [Json::int(1L)]
  let wrapped = Json::arr(raw_arr)
  raw_arr.push(Json::int(2L))
  assert_ok_str(stringify(wrapped), "[1]", "Json::arr must defensively copy input")

  match wrapped.as_array() {
    Some(xs) => xs.push(Json::int(3L))
    None => debug_assert(false, "expected array")
  }
  assert_ok_str(stringify(wrapped), "[1]", "as_array must return copy")

  let a = assert_ok("imm_doc", "{\"arr\":[1],\"k0\":0,\"k1\":1,\"k2\":2,\"k3\":3,\"k4\":4,\"k5\":5,\"k6\":6,\"k7\":7,\"k8\":8,\"k9\":9}")
  let before = match stringify_canonical(a) {
    Ok(s) => s
    Err(_) => ""
  }
  let b = match a.set_field("extra", Json::bool(true)) {
    Ok(v) => v
    Err(_) => Json::Null
  }
  match b.get_array("arr") {
    Some(xs) => xs.push(Json::str("MUTATED"))
    None => debug_assert(false, "expected arr")
  }
  match a.as_obj() {
    Some(o) => {
      let es = o.entries()
      es[0] = ("evil", Json::int(666L))
      es.push(("k1", Json::int(777L)))
    }
    None => debug_assert(false, "expected obj")
  }
  assert_ok_str(stringify_canonical(a), before, "original object must remain immutable")
  assert_opt_i64(a.get_i64("k0"), 0L, "index k0 intact")
  assert_opt_json_none(a.get("evil"), "evil not present")
}

///| P1-5 & P2-4: Non-UTF-8 strings and keys rejected with InvalidUnicode (no panic).
test "rt_p1_5_p2_4_invalid_utf8_rejected_in_serializers" {
  let bad_strs = [
    "é".slice(0, 1),
    rt_raw_bytes([0xF0]),
    rt_raw_bytes([0x61, 0xFF, 0xC0, 0x80, 0xED, 0xA0, 0x80]),
    rt_raw_bytes([0xE0, 0x80, 0xAF]),
    rt_raw_bytes([0xF4, 0x90, 0x80, 0x80]),
  ]
  let mut i = 0
  while i < bad_strs.length() {
    let s = bad_strs[i]
    let v_str = Json::str(s)
    let v_obj = Json::obj([(s, Json::int(1L)), ("a", Json::int(2L))])
    let checks = [
      stringify(v_str),
      stringify_pretty(v_str, 2),
      stringify_canonical(v_str),
      stringify(v_obj),
      stringify_pretty(v_obj, 2),
      stringify_canonical(v_obj),
    ]
    let mut j = 0
    while j < checks.length() {
      match checks[j] {
        Err(e) => {
          match e.kind {
            JsonErrorKind::InvalidUnicode => ()
            _ => debug_assert(false, "expected InvalidUnicode")
          }
        }
        Ok(_) => debug_assert(false, "serializer must reject invalid UTF-8")
      }
      j = j + 1
    }
    i = i + 1
  }
}

///| P2-1, P2-2, P2-5: -0 sign preservation, order-insensitive json_eq, O(n+k) without_keys.
test "rt_p2_1_p2_2_p2_5_neg_zero_unordered_eq_and_without_keys" {
  // P2-1: -0 preserves negative zero sign
  let nz = assert_ok("neg_zero_int", "-0")
  match nz.as_f64() {
    Some(d) => debug_assert(d.reinterpret_as_uint64() == 0x8000000000000000UL, "-0 sign bit")
    None => debug_assert(false, "-0 as_f64")
  }
  assert_ok_str(stringify(nz), "-0.0", "-0 stringify")
  assert_ok_str(stringify_canonical(nz), "0", "-0 canonical")

  // P2-2: order-insensitive json_eq (small and large objects)
  let o1 = assert_ok("eq_o1", "{\"a\":1,\"b\":{\"x\":10,\"y\":20}}")
  let o2 = assert_ok("eq_o2", "{\"b\":{\"y\":20,\"x\":10},\"a\":1}")
  let o3 = assert_ok("eq_o3", "{\"a\":1,\"b\":{\"x\":10,\"y\":21}}")
  debug_assert(json_eq(o1, o2), "json_eq must ignore object key order")
  debug_assert(o1.eq(o2), "Json::eq must ignore object key order")
  debug_assert(!json_eq(o1, o3), "json_eq must detect nested value mismatch")

  // P2-5: without_keys with > 8 keys (indexed O(n+k) path)
  let pairs : Array[(String, Json)] = []
  let drop : Array[String] = []
  let mut i = 0
  while i < 200 {
    let k = "k_" + i.to_string()
    pairs.push((k, Json::int(i.to_int64())))
    if i % 2 == 0 {
      drop.push(k)
    }
    i = i + 1
  }
  let big = Json::obj(pairs)
  let filtered = match big.without_keys(drop) {
    Ok(v) => v
    Err(_) => Json::Null
  }
  match filtered.as_obj() {
    Some(o) => {
      debug_assert(o.len() == 100, "without_keys kept 100 odd keys")
      assert_opt_json_none(o.get("k_0"), "k_0 removed")
      assert_opt_json(o.get("k_1"), Json::Int(1L), "k_1 kept")
      assert_opt_json_none(o.get("k_198"), "k_198 removed")
      assert_opt_json(o.get("k_199"), Json::Int(199L), "k_199 kept")
    }
    None => debug_assert(false, "expected Object")
  }
}
