///| Lossless number precision tests:
///| - Exact Int64 (> 2^53 IDs/timestamps, i64::MIN, i64::MAX)
///| - Out-of-range integers (u64::MAX, BigNum raw_repr)
///| - Eisel-Lemire + BigInt exact 0-ULP strtod (subnormals, midpoints, 768+ digits)
///| - Pure Pion Ryu shortest roundtrip formatting

fn assert_float_bits(label : String, src : String, expected_bits : UInt64) -> Unit {
  match parse(src) {
    Ok(v) => {
      match v {
        Json::Float(x) => {
          let actual = x.reinterpret_as_uint64()
          debug_assert(
            actual == expected_bits,
            "[" + label + "] bit mismatch for " + src,
          )
        }
        _ => debug_assert(false, "[" + label + "] expected Json::Float for " + src)
      }
    }
    Err(e) => debug_assert(false, "[" + label + "] parse error: " + e.message)
  }
}

///|
test "numbers_exact_int64_above_2_pow_53_and_extremes" {
  let i64_min : Int64 = -9223372036854775807L - 1L
  let i64_max : Int64 = 9223372036854775807L
  let cases : Array[(String, Int64)] = [
    ("0", 0L),
    ("1", 1L),
    ("-1", -1L),
    ("9007199254740992", 9007199254740992L),
    ("9007199254740993", 9007199254740993L),
    ("-9007199254740993", -9007199254740993L),
    ("1795451015208000123", 1795451015208000123L),
    ("9223372036854775807", i64_max),
    ("-9223372036854775808", i64_min),
  ]
  let mut i = 0
  while i < cases.length() {
    let (src, expected) = cases[i]
    match parse(src) {
      Ok(v) => {
        match v {
          Json::Int(n) => debug_assert(n == expected, "Int64 mismatch for " + src)
          _ => debug_assert(false, "expected Json::Int for " + src)
        }
        assert_opt_i64(v.as_i64(), expected, "as_i64 mismatch for " + src)
        assert_ok_str(stringify(v), src, "Int64 stringify mismatch for " + src)
      }
      Err(e) => debug_assert(false, "parse error for " + src + ": " + e.message)
    }
    i = i + 1
  }
}

///|
test "numbers_u64_max_and_bignum_lossless" {
  // u64::MAX = 18446744073709551615
  let u64_max_str = "18446744073709551615"
  let v_u64 = match parse(u64_max_str) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse u64::MAX failed: " + e.message)
      Json::Null
    }
  }
  match v_u64 {
    Json::BigNum(r) => debug_assert(r == u64_max_str, "u64::MAX repr")
    _ => debug_assert(false, "u64::MAX must be BigNum")
  }
  assert_opt_i64_none(v_u64.as_i64(), "u64::MAX does not fit i64")
  assert_opt_u64(v_u64.as_u64(), 18446744073709551615UL, "u64::MAX as_u64")
  assert_opt_str(v_u64.raw_repr(), u64_max_str, "u64::MAX raw_repr")
  assert_ok_str(stringify(v_u64), u64_max_str, "u64::MAX stringify")

  // i64::MAX + 1 = 9223372036854775808
  let v_i64_p1 = match parse("9223372036854775808") {
    Ok(v) => v
    Err(_) => Json::Null
  }
  assert_opt_i64_none(v_i64_p1.as_i64(), "i64::MAX+1 as_i64 None")
  assert_opt_u64(v_i64_p1.as_u64(), 9223372036854775808UL, "i64::MAX+1 as_u64")

  // u64::MAX + 1 = 18446744073709551616
  let v_u64_p1 = match parse("18446744073709551616") {
    Ok(v) => v
    Err(_) => Json::Null
  }
  assert_opt_u64_none(v_u64_p1.as_u64(), "u64::MAX+1 overflows u64")
  assert_opt_str(v_u64_p1.raw_repr(), "18446744073709551616", "u64::MAX+1 raw_repr")

  // i64::MIN - 1 = -9223372036854775809
  let v_neg_big = match parse("-9223372036854775809") {
    Ok(v) => v
    Err(_) => Json::Null
  }
  assert_opt_i64_none(v_neg_big.as_i64(), "i64::MIN-1 as_i64 None")
  assert_opt_u64_none(v_neg_big.as_u64(), "negative as_u64 None")
  assert_ok_str(stringify(v_neg_big), "-9223372036854775809", "i64::MIN-1 stringify")

  // 50-digit integer preserved losslessly
  let huge_int = "12345678901234567890123456789012345678901234567890"
  let v_huge = match parse(huge_int) {
    Ok(v) => v
    Err(_) => Json::Null
  }
  assert_opt_str(v_huge.raw_repr(), huge_int, "50-digit raw_repr")
  assert_ok_str(stringify(v_huge), huge_int, "50-digit stringify")
}

///|
test "numbers_exact_strtod_eisel_lemire_and_bigint_fallback" {
  // Standard decimals
  assert_float_bits("0.1", "0.1", 0x3FB999999999999AUL)
  assert_float_bits("0.2", "0.2", 0x3FC999999999999AUL)
  assert_float_bits("0.3", "0.3", 0x3FD3333333333333UL)
  assert_float_bits("-0.0", "-0.0", 0x8000000000000000UL)

  // DBL_MAX & DBL_MIN normal
  assert_float_bits("dbl_max", "1.7976931348623157e308", 0x7FEFFFFFFFFFFFFFUL)
  assert_float_bits("dbl_min_normal", "2.2250738585072014e-308", 0x0010000000000000UL)

  // Subnormal / normal boundary (forces BigInt exact rounding!)
  assert_float_bits("subnormal_round_to_normal", "2.2250738585072012e-308", 0x0010000000000000UL)
  assert_float_bits("largest_subnormal", "2.2250738585072009e-308", 0x000FFFFFFFFFFFFFUL)
  assert_float_bits("min_subnormal", "5e-324", 0x0000000000000001UL)
  assert_float_bits("below_half_min_subnormal", "2.47e-324", 0x0000000000000000UL)

  // Exact half-ULP ties-to-even (forces BigInt fallback!)
  // 1.0 + 2^-53 exactly -> ties to even -> 1.0 (0x3FF0000000000000)
  assert_float_bits(
    "exact_half_ulp_even",
    "1.00000000000000011102230246251565404236316680908203125",
    0x3FF0000000000000UL,
  )
  // 1.0 + 2^-53 + epsilon -> rounds up -> 0x3FF0000000000001
  assert_float_bits(
    "above_half_ulp",
    "1.000000000000000111022302462515654042363166809082031251",
    0x3FF0000000000001UL,
  )
  // 2^53 + 1.0 -> ties to even -> 2^53 (0x4340000000000000)
  assert_float_bits("2p53_plus_1_float", "9007199254740993.0", 0x4340000000000000UL)
  // 2^53 + 3.0 -> ties to even -> 2^53 + 4 (0x4340000000000002)
  assert_float_bits("2p53_plus_3_float", "9007199254740995.0", 0x4340000000000002UL)
}

///|
test "numbers_ryu_bit_exact_roundtrip" {
  let bit_patterns : Array[UInt64] = [
    0x0000000000000000UL, // +0.0
    0x8000000000000000UL, // -0.0
    0x0000000000000001UL, // min subnormal 5e-324
    0x000FFFFFFFFFFFFFUL, // max subnormal
    0x0010000000000000UL, // min normal
    0x3FB999999999999AUL, // 0.1
    0x3FC999999999999AUL, // 0.2
    0x3FD3333333333333UL, // 0.3
    0x3FF0000000000000UL, // 1.0
    0x3FF0000000000001UL, // 1.0 + eps
    0x400921FB54442D18UL, // pi
    0x4340000000000000UL, // 2^53
    0x44B52D02C7E14AF6UL, // 1e23
    0x7FEFFFFFFFFFFFFFUL, // DBL_MAX
    0xFFEFFFFFFFFFFFFFUL, // -DBL_MAX
  ]
  let mut i = 0
  while i < bit_patterns.length() {
    let bits = bit_patterns[i]
    let d = Double::from_bits(bits.reinterpret_as_int64())
    let s = match stringify(Json::Float(d)) {
      Ok(out) => out
      Err(e) => {
        debug_assert(false, "stringify float failed: " + e.message)
        ""
      }
    }
    let reparsed = match parse(s) {
      Ok(v) => v
      Err(e) => {
        debug_assert(false, "reparse float failed for " + s + ": " + e.message)
        Json::Null
      }
    }
    match reparsed.as_f64() {
      Some(d2) => {
        debug_assert(
          d2.reinterpret_as_uint64() == bits,
          "Ryu roundtrip bit mismatch for " + s,
        )
      }
      None => debug_assert(false, "reparsed not f64 for " + s)
    }
    i = i + 1
  }
}
