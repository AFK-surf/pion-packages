///| Red-team prosecution tests for `packages/json` @ 44160880 (feat/pkg-json).
///|
///| Each `p*_` test asserts what RFC 8259 / RFC 8785 (JCS) / RFC 6901 and the references
///| (Rust `serde_json =1.0.145`, Node.js `JSON` + the RFC 8785 Appendix canonicalizer, Go
///| `encoding/json`) do on the very same input, or what the package's own docs promise.
///| A FAILING `p*_` test is evidence against the package, not a broken test. Every assertion
///| accepts every fix that is correct (e.g. "reject with Err" OR "emit the RFC form"), so a fixed
///| branch passes without touching `audit/`.
///|
///| `ctl_*` tests are controls: attacks the package survives. They pass and stay here so a
///| reviewer can see what was tried and found sound.
///|
///| Naming: `p0_*` invalid / injected output or signature-relevant canonical divergence,
///|         `p1_*` silent wrong value, broken documented guarantee, `p2_*` divergence / policy gap.
///| Crash (panic) and DoS evidence cannot live in a unit test: it is in `run_audit.sh`
///| stages `utf8` and `hashdos` and in REPORT.md.

import "json"

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

///|
fn must_parse(src : String) -> json::Json {
  match json::parse(src) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse failed for " + src + ": " + e.message)
      json::Json::Null
    }
  }
}

///|
fn limits(policy : json::DuplicateKeyPolicy) -> json::JsonLimits {
  let d = json::JsonLimits::default()
  json::JsonLimits::{
    max_depth: d.max_depth,
    max_bytes: d.max_bytes,
    max_elements: d.max_elements,
    max_string_bytes: d.max_string_bytes,
    duplicate_keys: policy,
  }
}

///|
fn canon_of(v : json::Json) -> String {
  match json::stringify_canonical(v) {
    Ok(s) => s
    Err(_) => "<ERR>"
  }
}

///|
fn compact_of(v : json::Json) -> String {
  match json::stringify(v) {
    Ok(s) => s
    Err(_) => "<ERR>"
  }
}

///|
fn raw_bytes(bs : Array[Int]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < bs.length() {
    sb.write_byte(bs[i].to_byte())
    i = i + 1
  }
  sb.to_string()
}

///|
fn i64s(o : Option[Int64]) -> String {
  match o {
    Some(n) => n.to_string()
    None => "None"
  }
}

///|
fn u64s(o : Option[UInt64]) -> String {
  match o {
    Some(n) => n.to_string()
    None => "None"
  }
}

///|
fn strs(o : Option[String]) -> String {
  match o {
    Some(x) => x
    None => "<None>"
  }
}

///|
fn has_f64(o : Option[Double]) -> Bool {
  match o {
    Some(_) => true
    None => false
  }
}

///|
fn is_none(o : Option[json::Json]) -> Bool {
  match o {
    Some(_) => false
    None => true
  }
}

///|
fn is_err_kind(r : Result[json::Json, json::JsonError], want : String) -> Bool {
  match r {
    Ok(_) => false
    Err(e) =>
    match e.kind {
      json::JsonErrorKind::DuplicateKey => want == "DuplicateKey"
      json::JsonErrorKind::InvalidUnicode => want == "InvalidUnicode"
      json::JsonErrorKind::InvalidEscape => want == "InvalidEscape"
      json::JsonErrorKind::DepthLimitExceeded => want == "DepthLimitExceeded"
      json::JsonErrorKind::ByteLimitExceeded => want == "ByteLimitExceeded"
      json::JsonErrorKind::ElementLimitExceeded => want == "ElementLimitExceeded"
      json::JsonErrorKind::StringLimitExceeded => want == "StringLimitExceeded"
      _ => want == "other"
    }
  }
}

// ---------------------------------------------------------------------------
// P0: serializers emit unvalidated BigNum text (invalid JSON / injection)
// ---------------------------------------------------------------------------

///| `Json::big_num` is a public constructor taking any `String`; `stringify` and
///| `stringify_canonical` write it verbatim (serialize.pion:277). A correct serializer either
///| returns `Err` or emits text that re-parses to a one-key object.
test "p0_bignum_raw_text_is_emitted_unvalidated_json_injection" {
  let evil = ["1,\"admin\":true", "NaN", "Infinity", "-Infinity", "", "0x10", "01", "1 ", "1e", "+1"]
  let mut i = 0
  while i < evil.length() {
    let doc = json::Json::obj([("amount", json::Json::big_num(evil[i]))])
    let outs = [json::stringify(doc), json::stringify_canonical(doc)]
    let mut j = 0
    while j < outs.length() {
      match outs[j] {
        Err(_) => ()
        Ok(s) =>
        match json::parse_with_limits(s, limits(json::DuplicateKeyPolicy::Reject)) {
          Ok(json::Json::Object(o)) =>
          debug_assert(
            o.len() == 1,
            "big_num(" + evil[i] + ") injected keys: " + s,
          )
          Ok(_) => debug_assert(false, "big_num(" + evil[i] + ") changed shape: " + s)
          Err(_) =>
          debug_assert(false, "big_num(" + evil[i] + ") produced INVALID JSON: " + s)
        }
      }
      j = j + 1
    }
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// P1: RFC 8785 number serialization
// ---------------------------------------------------------------------------

///| RFC 8785 §3.2.2.2: numbers that are not finite IEEE-754 doubles MUST cause an error.
///| `parse("1e400")` gives `BigNum("1e400")` and the canonicalizer writes it raw.
test "p1_canonical_emits_nonfinite_bignum_instead_of_error" {
  let srcs = ["1e400", "[-1e400]", "{\"a\":1E999}", "10e399"]
  let mut i = 0
  while i < srcs.length() {
    let c = canon_of(must_parse(srcs[i]))
    debug_assert(c == "<ERR>", "RFC 8785 requires an error for " + srcs[i] + ", got " + c)
    i = i + 1
  }
}

///| RFC 8785 §3.2.2.3: every number is serialized as ECMAScript `Number::toString` of its
///| binary64 value. Integers beyond 2^53 (`Json::Int`) and `BigNum` integers are written with
///| their exact decimal digits instead (serialize.pion:263,277), so Pion's canonical bytes differ
///| from every RFC 8785 implementation and the same binary64 value gets several canonical forms.
///| Correct = the ES form, or an error (refusing a lossy value is a legitimate JCS policy).
test "p1_canonical_big_integers_not_in_ecmascript_form" {
  let cases = [
    ("9007199254740993", "9007199254740992"),
    ("9223372036854775807", "9223372036854776000"),
    ("-9223372036854775808", "-9223372036854776000"),
    ("18446744073709551615", "18446744073709552000"),
    ("123456789012345678901234567890", "1.2345678901234568e+29"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (src, es) = cases[i]
    let c = canon_of(must_parse(src))
    debug_assert(c == es || c == "<ERR>", "JCS(" + src + ") = " + c + ", RFC 8785 form is " + es)
    i = i + 1
  }
  // canonical form must be unique per binary64 value: these four are the same IEEE double
  let forms = [
    "18446744073709551616", "18446744073709551616.0", "1.8446744073709551616e19", "18446744073709551617",
  ]
  let first = canon_of(must_parse(forms[0]))
  let mut j = 1
  while j < forms.length() {
    let c = canon_of(must_parse(forms[j]))
    debug_assert(
      c == first || c == "<ERR>" || first == "<ERR>",
      "same double, different canonical bytes: " + first + " vs " + c,
    )
    j = j + 1
  }
}

// ---------------------------------------------------------------------------
// P1: the "immutable" value model leaks its mutable internals
// ---------------------------------------------------------------------------

///| README: "Immutable mutators: set_field, without_keys, merge_object". `set_field` shares
///| children with the original, and `get_array`/`as_array` hand out the live `Array`, so a
///| write through the *derived* document changes the *original* one.
test "p1_set_field_copy_aliases_original_children" {
  let a = must_parse("{\"arr\":[1],\"o\":{\"x\":1}}")
  let before = compact_of(a)
  let b = match a.set_field("new", json::Json::int(1L)) {
    Ok(v) => v
    Err(_) => json::Json::Null
  }
  match b.get_array("arr") {
    Some(xs) => xs.push(json::Json::str("INJECTED"))
    None => ()
  }
  match b.get_obj("o") {
    Some(o) => {
      let es = o.entries()
      es.push(("y", json::Json::int(2L)))
    }
    None => ()
  }
  debug_assert(compact_of(a) == before, "original mutated through set_field copy: " + compact_of(a))
}

///| `JsonObject::entries()` returns the internal array: writing to it desynchronizes the O(1)
///| hash index (object_index.pion) from the entries, so `get` returns a value whose key is gone,
///| misses a present key, and a duplicate key is serialized twice (also by the canonicalizer:
///| a key-smuggling vector that bypasses `DuplicateKeyPolicy::Reject`).
test "p1_entries_alias_desyncs_index_and_duplicates_keys" {
  let a = must_parse(
    "{\"k0\":0,\"k1\":1,\"k2\":2,\"k3\":3,\"k4\":4,\"k5\":5,\"k6\":6,\"k7\":7,\"k8\":8,\"k9\":9}",
  )
  let before = canon_of(a)
  match a.as_obj() {
    Some(o) => {
      let es = o.entries()
      es[0] = ("evil", json::Json::int(666L))
      es.push(("k1", json::Json::int(777L)))
    }
    None => ()
  }
  debug_assert(canon_of(a) == before, "object changed through entries(): " + canon_of(a))
  let c = canon_of(a)
  match json::parse_with_limits(c, limits(json::DuplicateKeyPolicy::Reject)) {
    Ok(_) => ()
    Err(_) => debug_assert(false, "canonical output contains duplicate keys: " + c)
  }
}

// ---------------------------------------------------------------------------
// P2: divergences
// ---------------------------------------------------------------------------

///| `-0` parses to `Json::Int(0)`: the sign is lost and `stringify` prints `0`.
///| serde_json (`-0` -> f64 -0.0), Go (`float64` -0), and JavaScript all keep -0.
test "p2_negative_zero_integer_literal_loses_sign" {
  let v = must_parse("-0")
  let neg = match v.as_f64() {
    Some(d) => (d.reinterpret_as_uint64() >> 63UL) == 1UL
    None => false
  }
  debug_assert(neg, "-0 lost its sign: " + compact_of(v))
}

///| RFC 8259 §4: an object is an *unordered* collection. `json_eq`/`Json::eq` compare entries
///| positionally. serde_json `Value` (even with `preserve_order`: IndexMap eq is order-free),
///| Go `reflect.DeepEqual` on maps and every JS deep-equal treat these as equal.
test "p2_json_eq_is_object_order_sensitive" {
  let a = must_parse("{\"a\":1,\"b\":2}")
  let b = must_parse("{\"b\":2,\"a\":1}")
  debug_assert(json::json_eq(a, b), "json_eq({a,b},{b,a}) == false")
}

///| `BigNum` accessors accept non-numbers: `big_num("abc").as_f64()` is `Some(0.0)`.
test "p2_bignum_accessors_accept_garbage" {
  debug_assert(!has_f64(json::Json::big_num("abc").as_f64()), "big_num(\"abc\").as_f64() returned a number")
  debug_assert(!has_f64(json::Json::big_num("1.5.5").as_f64()), "big_num(\"1.5.5\").as_f64() returned a number")
}

///| `Json::str` can hold any bytes (`StringBuilder::write_byte`, `String::slice` mid-character);
///| the serializers copy them verbatim, so the output is not UTF-8 and not RFC 8259 JSON.
test "p2_stringify_emits_invalid_utf8" {
  let v = json::Json::str(raw_bytes([0x61, 0xFF, 0xC0, 0x80, 0xED, 0xA0, 0x80]))
  match json::stringify(v) {
    Err(_) => ()
    Ok(s) =>
    match json::parse(s) {
      Ok(_) => ()
      Err(_) => debug_assert(false, "stringify produced bytes its own parser rejects")
    }
  }
}

// ---------------------------------------------------------------------------
// controls (all pass on 44160880)
// ---------------------------------------------------------------------------

///|
test "ctl_surrogates_and_escapes" {
  debug_assert(is_err_kind(json::parse("\"\\uD800\""), "InvalidUnicode"), "lone high")
  debug_assert(is_err_kind(json::parse("\"\\uDFFF\""), "InvalidUnicode"), "lone low")
  debug_assert(is_err_kind(json::parse("\"\\uDC00\\uD800\""), "InvalidUnicode"), "reversed pair")
  debug_assert(is_err_kind(json::parse("\"\\uD83D\\u0041\""), "InvalidUnicode"), "high + BMP")
  debug_assert(is_err_kind(json::parse("\"\\a\""), "InvalidEscape"), "\\a")
  debug_assert(is_err_kind(json::parse("\"\\x41\""), "InvalidEscape"), "\\x41")
  match json::parse("\"\\uD83D\\uDE00\"") {
    Ok(v) => debug_assert(strs(v.as_str()) == "😀", "pair decode")
    Err(_) => debug_assert(false, "valid pair rejected")
  }
}

///|
test "ctl_duplicate_key_reject_escaped_and_nested" {
  let lim = limits(json::DuplicateKeyPolicy::Reject)
  debug_assert(
    is_err_kind(json::parse_with_limits("{\"a\":1,\"\\u0061\":2}", lim), "DuplicateKey"),
    "escaped-equivalent key",
  )
  debug_assert(
    is_err_kind(json::parse_with_limits("[{\"x\":{\"b\":1,\"b\":2}}]", lim), "DuplicateKey"),
    "nested duplicate",
  )
  // > 8 keys: duplicate detected through the hash index
  debug_assert(
    is_err_kind(
      json::parse_with_limits(
        "{\"k0\":0,\"k1\":1,\"k2\":2,\"k3\":3,\"k4\":4,\"k5\":5,\"k6\":6,\"k7\":7,\"k8\":8,\"k9\":9,\"k\\u0030\":1}",
        lim,
      ),
      "DuplicateKey",
    ),
    "indexed duplicate",
  )
}

///|
test "ctl_lastwins_firstwins_slot_and_index_consistency" {
  let src = "{\"k0\":0,\"k1\":1,\"k2\":2,\"k3\":3,\"k4\":4,\"k5\":5,\"k6\":6,\"k7\":7,\"k8\":8,\"k9\":9,\"k1\":10,\"k9\":90,\"k0\":100}"
  let last = must_parse(src)
  debug_assert(
    compact_of(last) ==
    "{\"k0\":100,\"k1\":10,\"k2\":2,\"k3\":3,\"k4\":4,\"k5\":5,\"k6\":6,\"k7\":7,\"k8\":8,\"k9\":90}",
    "LastWins slots: " + compact_of(last),
  )
  debug_assert(i64s(last.get_i64("k0")) == "100", "LastWins index k0")
  debug_assert(i64s(last.get_i64("k9")) == "90", "LastWins index k9")
  let first = match json::parse_with_limits(src, limits(json::DuplicateKeyPolicy::FirstWins)) {
    Ok(v) => v
    Err(_) => json::Json::Null
  }
  debug_assert(i64s(first.get_i64("k0")) == "0" && i64s(first.get_i64("k9")) == "9", "FirstWins")
  match last.as_obj() {
    Some(o) => debug_assert(o.len() == 10 && o.keys().length() == 10, "no ghost keys")
    None => debug_assert(false, "object")
  }
}

///|
test "ctl_rfc6901_pointer" {
  let doc = must_parse("{\"foo\":[\"bar\",\"baz\"],\"\":0,\"a/b\":1,\"m~n\":8,\"~1\":9,\"01\":10}")
  let p = fn(path : String) -> String {
    match doc.pointer(path) {
      Ok(Some(v)) => compact_of(v)
      Ok(None) => "NONE"
      Err(_) => "ERR"
    }
  }
  debug_assert(p("") == compact_of(doc), "root")
  debug_assert(p("/") == "0", "empty key")
  debug_assert(p("/a~1b") == "1", "~1")
  debug_assert(p("/m~0n") == "8", "~0")
  debug_assert(p("/~01") == "9", "~01 must decode to ~1, not /")
  debug_assert(p("/01") == "10", "object key 01")
  debug_assert(p("/foo/01") == "NONE", "leading-zero index")
  debug_assert(p("/foo/-") == "NONE", "- index")
  debug_assert(p("/foo/1") == "\"baz\"", "index")
  debug_assert(p("/~2") == "ERR", "~2")
  debug_assert(p("/a~") == "ERR", "dangling ~")
  debug_assert(p("foo") == "ERR", "no leading /")
}

///|
test "ctl_immutable_mutators_top_level" {
  let a = must_parse("{\"k0\":0,\"k1\":1,\"k2\":2,\"k3\":3,\"k4\":4,\"k5\":5,\"k6\":6,\"k7\":7,\"k8\":8,\"k9\":9}")
  let before = compact_of(a)
  let _ = a.set_field("k0", json::Json::int(5L))
  let _ = a.set_field("zz", json::Json::int(5L))
  let _ = a.without_keys(["k1", "k2"])
  let _ = a.merge_object(must_parse("{\"k3\":33,\"q\":1}"))
  debug_assert(compact_of(a) == before, "top level unchanged")
  debug_assert(i64s(a.get_i64("k0")) == "0" && is_none(a.get("zz")), "index unchanged")
}

///|
test "ctl_limits_zero_and_negative_fail_closed" {
  let d = json::JsonLimits::default()
  let mk = fn(depth : Int, bytes : Int, elems : Int, strs : Int) -> json::JsonLimits {
    json::JsonLimits::{
      max_depth: depth,
      max_bytes: bytes,
      max_elements: elems,
      max_string_bytes: strs,
      duplicate_keys: d.duplicate_keys,
    }
  }
  debug_assert(is_err_kind(json::parse_with_limits("[]", mk(0, 100, 100, 100)), "DepthLimitExceeded"), "depth 0")
  debug_assert(is_err_kind(json::parse_with_limits("[]", mk(-1, 100, 100, 100)), "DepthLimitExceeded"), "depth -1")
  debug_assert(is_err_kind(json::parse_with_limits("1", mk(5, -1, 100, 100)), "ByteLimitExceeded"), "bytes -1")
  debug_assert(is_err_kind(json::parse_with_limits("1", mk(5, 100, 0, 100)), "ElementLimitExceeded"), "elements 0")
  debug_assert(
    is_err_kind(json::parse_with_limits("\"\\u0061\"", mk(5, 100, 100, 0)), "StringLimitExceeded"),
    "escaped string over limit",
  )
  debug_assert(
    is_err_kind(json::parse_with_limits("{\"ab\":1}", mk(5, 100, 100, 1)), "StringLimitExceeded"),
    "key counts toward max_string_bytes",
  )
}

///|
test "ctl_jcs_utf16_order_escapes_and_float_form" {
  let v = must_parse(
    "{\"\\uE000\":1,\"\\uD800\\uDC00\":2,\"\\uFFFF\":3,\"\\uD83D\\uDE00\":4,\"a\":5,\"\\u0000\":6}",
  )
  debug_assert(
    canon_of(v) == "{\"\\u0000\":6,\"a\":5,\"𐀀\":2,\"😀\":4,\"\u{E000}\":1,\"\u{FFFF}\":3}",
    "UTF-16 order: " + canon_of(v),
  )
  let s = must_parse("\"\\u0000\\u001f\\u007f\\/\\b\\f\\n\\r\\t\\u2028\\u00e9\"")
  debug_assert(
    canon_of(s) == "\"\\u0000\\u001f\u{7f}/\\b\\f\\n\\r\\t\u{2028}é\"",
    "JCS escapes: " + canon_of(s),
  )
  let n = must_parse("[-0.0,1e20,1e21,1e-6,1e-7,5e-324,1.7976931348623157e308,0.1,1.0,1e2]")
  debug_assert(
    canon_of(n) ==
    "[0,100000000000000000000,1e+21,0.000001,1e-7,5e-324,1.7976931348623157e+308,0.1,1,100]",
    "JCS numbers: " + canon_of(n),
  )
}

///|
test "ctl_int64_u64_boundaries" {
  debug_assert(i64s(must_parse("-9223372036854775808").as_i64()) == (-9223372036854775807L - 1L).to_string(), "i64 min")
  debug_assert(i64s(must_parse("9223372036854775807").as_i64()) == (9223372036854775807L).to_string(), "i64 max")
  debug_assert(u64s(must_parse("9223372036854775808").as_u64()) == (9223372036854775808UL).to_string(), "i64 max + 1 as u64")
  debug_assert(u64s(must_parse("18446744073709551615").as_u64()) == (18446744073709551615UL).to_string(), "u64 max")
  debug_assert(u64s(must_parse("18446744073709551616").as_u64()) == "None", "u64 max + 1")
  debug_assert(i64s(must_parse("9007199254740993").as_i64()) == (9007199254740993L).to_string(), "2^53 + 1 exact")
  debug_assert(!has_f64(must_parse("1e400").as_f64()), "1e400 has no finite f64")
}
