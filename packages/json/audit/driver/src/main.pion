///| Red-team differential driver for `packages/json`.
///|
///| Dump format (identical to `oracle/rust`): null `n`, `t`/`f`, `Int` -> `i<decimal>`,
///| `Float` -> `d<16 hex IEEE-754 bits>`, `BigNum` -> `b<raw>`, string -> `s<hex UTF-8>;`,
///| array `[a,b]`, object `{<hex key>:<v>,...}` in document order. A rejected input prints `ERR <kind>`.

import "json"

///|
fn hexval(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    0
  }
}

///|
fn unhex(h : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i + 1 < h.length() {
    sb.write_byte(((hexval(h.code_unit_at(i)) << 4) | hexval(h.code_unit_at(i + 1))).to_byte())
    i = i + 2
  }
  sb.to_string()
}

///|
fn hexdig(d : Int) -> Byte {
  if d < 10 {
    (48 + d).to_byte()
  } else {
    (87 + d).to_byte()
  }
}

///|
fn write_hex_str(sb : StringBuilder, s : String) -> Unit {
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    sb.write_byte(hexdig((b >> 4) & 15))
    sb.write_byte(hexdig(b & 15))
    i = i + 1
  }
}

///|
fn write_hex64(sb : StringBuilder, x : UInt64) -> Unit {
  let mut sh = 60UL
  while true {
    sb.write_byte(hexdig(((x >> sh) & 15UL).to_int()))
    if sh == 0UL {
      break
    }
    sh = sh - 4UL
  }
}

///|
fn parse_hex64(h : String) -> UInt64 {
  let mut acc = 0UL
  let mut i = 0
  while i < h.length() {
    acc = (acc << 4UL) | hexval(h.code_unit_at(i)).to_int64().reinterpret_as_uint64()
    i = i + 1
  }
  acc
}

///|
fn atoi(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    acc = acc * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  acc
}

///| Split on `\n` (a trailing empty line is dropped).
fn lines_of(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut st = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == 10 {
      out.push(s.slice(st, i))
      st = i + 1
    }
    i = i + 1
  }
  if st < s.length() {
    out.push(s.slice(st, s.length()))
  }
  out
}

///| First tab-separated field.
fn field(s : String, idx : Int) -> String {
  let mut k = 0
  let mut st = 0
  let mut i = 0
  while i <= s.length() {
    if i == s.length() || s.code_unit_at(i) == 9 {
      if k == idx {
        return s.slice(st, i)
      }
      k = k + 1
      st = i + 1
    }
    i = i + 1
  }
  ""
}

///|
fn kind_name(k : json::JsonErrorKind) -> String {
  match k {
    json::JsonErrorKind::Syntax => "Syntax"
    json::JsonErrorKind::InvalidUtf8 => "InvalidUtf8"
    json::JsonErrorKind::UnexpectedEof => "UnexpectedEof"
    json::JsonErrorKind::TrailingData => "TrailingData"
    json::JsonErrorKind::InvalidEscape => "InvalidEscape"
    json::JsonErrorKind::InvalidUnicode => "InvalidUnicode"
    json::JsonErrorKind::InvalidNumber => "InvalidNumber"
    json::JsonErrorKind::DuplicateKey => "DuplicateKey"
    json::JsonErrorKind::DepthLimitExceeded => "DepthLimitExceeded"
    json::JsonErrorKind::ByteLimitExceeded => "ByteLimitExceeded"
    json::JsonErrorKind::ElementLimitExceeded => "ElementLimitExceeded"
    json::JsonErrorKind::StringLimitExceeded => "StringLimitExceeded"
    json::JsonErrorKind::NonFiniteNumber => "NonFiniteNumber"
    json::JsonErrorKind::InvalidPointer => "InvalidPointer"
    json::JsonErrorKind::TypeMismatch => "TypeMismatch"
  }
}

///| Iterative dump (same format as the Rust oracle).
enum DTask {
  V(json::Json)
  S(String)
}

///|
fn dump(sb : StringBuilder, root : json::Json) -> Unit {
  let st : Array[DTask] = [DTask::V(root)]
  while st.length() > 0 {
    let t = match st.pop() {
      Some(x) => x
      None => break
    }
    match t {
      DTask::S(s) => sb.write_string(s)
      DTask::V(v) =>
      match v {
        json::Json::Null => sb.write_string("n")
        json::Json::Bool(b) => sb.write_string(if b { "t" } else { "f" })
        json::Json::Int(n) => sb.write_string("i" + n.to_string())
        json::Json::Float(d) => {
          sb.write_string("d")
          write_hex64(sb, d.reinterpret_as_uint64())
        }
        json::Json::BigNum(r) => sb.write_string("b" + r)
        json::Json::Str(s) => {
          sb.write_string("s")
          write_hex_str(sb, s)
          sb.write_string(";")
        }
        json::Json::Array(items) => {
          sb.write_string("[")
          st.push(DTask::S("]"))
          let mut i = items.length() - 1
          while i >= 0 {
            st.push(DTask::V(items[i]))
            if i > 0 {
              st.push(DTask::S(","))
            }
            i = i - 1
          }
        }
        json::Json::Object(o) => {
          sb.write_string("{")
          st.push(DTask::S("}"))
          let es = o.entries()
          let mut i = es.length() - 1
          while i >= 0 {
            let (k, x) = es[i]
            st.push(DTask::V(x))
            let kb = StringBuilder::new()
            if i > 0 {
              kb.write_string(",")
            }
            write_hex_str(kb, k)
            kb.write_string(":")
            st.push(DTask::S(kb.to_string()))
            i = i - 1
          }
        }
      }
    }
  }
}

///|
fn limits_for(policy : String) -> json::JsonLimits {
  let d = json::JsonLimits::default()
  let p = if policy == "reject" {
    json::DuplicateKeyPolicy::Reject
  } else if policy == "firstwins" {
    json::DuplicateKeyPolicy::FirstWins
  } else {
    json::DuplicateKeyPolicy::LastWins
  }
  json::JsonLimits::{
    max_depth: d.max_depth,
    max_bytes: d.max_bytes,
    max_elements: d.max_elements,
    max_string_bytes: d.max_string_bytes,
    duplicate_keys: p,
  }
}

///| `parse <hexfile> [lastwins|firstwins|reject]`: one dump (or `ERR <kind>`) per input line.
fn run_parse(world : World, path : String, policy : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let lim = limits_for(policy)
  let ls = lines_of(content)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ls.length() {
    let src = unhex(field(ls[i], 0))
    match json::parse_with_limits(src, lim) {
      Ok(v) => dump(sb, v)
      Err(e) => sb.write_string("ERR " + kind_name(e.kind))
    }
    sb.write_string("\n")
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

///| `canon <hexfile>`: `OK <hex of stringify_canonical>` or `ERR <kind>` per line.
fn run_canon(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let ls = lines_of(content)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ls.length() {
    let src = unhex(field(ls[i], 0))
    match json::parse(src) {
      Ok(v) =>
      match json::stringify_canonical(v) {
        Ok(s) => {
          sb.write_string("OK ")
          write_hex_str(sb, s)
        }
        Err(e) => sb.write_string("ERR " + kind_name(e.kind))
      }
      Err(e) => sb.write_string("PARSE_ERR " + kind_name(e.kind))
    }
    sb.write_string("\n")
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

///| `rt <hexfile>`: for every accepted document, stringify / stringify_pretty / stringify_canonical
///| must re-parse, compact and pretty must be `json_eq` to the original, and canonical must be a
///| fixed point. Prints `ok`, `skip` (rejected input) or `BAD <what>` per line.
fn run_rt(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let ls = lines_of(content)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ls.length() {
    let src = unhex(field(ls[i], 0))
    let line = match json::parse(src) {
      Err(_) => "skip"
      Ok(v) => {
        let c1 = match json::stringify(v) {
          Ok(s) => s
          Err(e) => "\u{1}" + kind_name(e.kind)
        }
        let p1 = match json::stringify_pretty(v, 2) {
          Ok(s) => s
          Err(e) => "\u{1}" + kind_name(e.kind)
        }
        let k1 = match json::stringify_canonical(v) {
          Ok(s) => s
          Err(e) => "\u{1}" + kind_name(e.kind)
        }
        let mut bad = ""
        match json::parse(c1) {
          Ok(w) => if !json::json_eq(v, w) { bad = bad + " compact!=orig" }
          Err(_) => bad = bad + " compact-unparseable"
        }
        match json::parse(p1) {
          Ok(w) => if !json::json_eq(v, w) { bad = bad + " pretty!=orig" }
          Err(_) => bad = bad + " pretty-unparseable"
        }
        match json::parse(k1) {
          Ok(w) =>
          match json::stringify_canonical(w) {
            Ok(k2) => if k2 != k1 { bad = bad + " canonical-not-idempotent" }
            Err(_) => bad = bad + " canonical-reserialize-err"
          }
          Err(_) => bad = bad + " canonical-unparseable"
        }
        if bad == "" {
          "ok"
        } else {
          "BAD" + bad
        }
      }
    }
    sb.write_string(line)
    sb.write_string("\n")
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

///| `numfmt <file of 16-hex IEEE bits>`: `<canonical> <plain> <bits after parse(plain)>` per line.
fn run_numfmt(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let ls = lines_of(content)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ls.length() {
    let bits = parse_hex64(ls[i])
    let v = json::Json::float(Double::from_bits(bits.reinterpret_as_int64()))
    let c = match json::stringify_canonical(v) {
      Ok(s) => s
      Err(_) => "ERR"
    }
    let p = match json::stringify(v) {
      Ok(s) => s
      Err(_) => "ERR"
    }
    sb.write_string(c + " " + p + " ")
    match json::parse(p) {
      Ok(json::Json::Float(d)) => write_hex64(sb, d.reinterpret_as_uint64())
      Ok(_) => sb.write_string("NOT_FLOAT")
      Err(_) => sb.write_string("ERR")
    }
    sb.write_string("\n")
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

///| `ptr <file>`: lines `<hex doc>\t<hex pointer>` -> dump, `NONE` or `ERR <kind>`.
fn run_ptr(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let ls = lines_of(content)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < ls.length() {
    let doc = unhex(field(ls[i], 0))
    let p = unhex(field(ls[i], 1))
    match json::parse(doc) {
      Ok(v) =>
      match v.pointer(p) {
        Ok(Some(x)) => dump(sb, x)
        Ok(None) => sb.write_string("NONE")
        Err(e) => sb.write_string("ERR " + kind_name(e.kind))
      }
      Err(e) => sb.write_string("PARSE_ERR " + kind_name(e.kind))
    }
    sb.write_string("\n")
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}

///| `adv wide <file> <lookups>`: parse a wide object and look keys up (stdout identical to the Rust oracle).
fn run_adv(world : World, path : String, lookups : Int) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let o = match json::parse(content) {
    Ok(json::Json::Object(o)) => o
    _ => return 2
  }
  let keys = o.keys()
  let mut hits = 0
  let mut j = 0
  let mut it = 0
  while it < lookups {
    j = (j * 31 + 7) % keys.length()
    if o.contains_key(keys[j]) {
      hits = hits + 1
    }
    it = it + 1
  }
  io_println(world, "keys=" + o.len().to_string() + " hits=" + hits.to_string())
  0
}

///| `deep <a|o> <depth>`: build, parse (max_depth raised), stringify, canonical, json_eq, drop.
fn run_deep(world : World, kind : String, depth : Int) -> Int {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < depth {
    sb.write_string(if kind == "a" { "[" } else { "{\"k\":" })
    i = i + 1
  }
  sb.write_string("0")
  i = 0
  while i < depth {
    sb.write_string(if kind == "a" { "]" } else { "}" })
    i = i + 1
  }
  let src = sb.to_string()
  let d = json::JsonLimits::default()
  let dflt = match json::parse(src) {
    Ok(_) => "accepted"
    Err(e) => kind_name(e.kind)
  }
  let lim = json::JsonLimits::{
    max_depth: depth + 1,
    max_bytes: d.max_bytes,
    max_elements: depth + 1,
    max_string_bytes: d.max_string_bytes,
    duplicate_keys: d.duplicate_keys,
  }
  let v = match json::parse_with_limits(src, lim) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "raised-limit parse error " + kind_name(e.kind))
      return 2
    }
  }
  let c = match json::stringify(v) {
    Ok(s) => s.length()
    Err(_) => -1
  }
  let k = match json::stringify_canonical(v) {
    Ok(s) => s.length()
    Err(_) => -1
  }
  // pretty output is inherently O(depth^2) bytes (indentation), so only checked up to 20k levels
  let p = if depth <= 20000 {
    match json::stringify_pretty(v, 1) {
      Ok(s) => s.length()
      Err(_) => -1
    }
  } else {
    0
  }
  let eq = json::json_eq(v, v)
  io_println(
    world,
    "deep " + kind + " " + depth.to_string() + " default=" + dflt + " compact=" +
    c.to_string() + " canonical=" + k.to_string() + " pretty=" + p.to_string() +
    " eq=" + eq.to_string(),
  )
  0
}

///| `utf8`: a `String` that is not UTF-8 (here: what `"é".slice(0, 1)` yields) used as object keys.
///| A correct serializer returns `Err` or valid output; it must not abort the process.
fn run_utf8(world : World) -> Int {
  let cut = "é".slice(0, 1)
  let sb = StringBuilder::new()
  sb.write_byte((0xF0).to_byte())
  let doc = json::Json::obj([
    (cut, json::Json::int(1L)),
    (sb.to_string(), json::Json::int(2L)),
  ])
  match json::stringify(doc) {
    Ok(_) => io_println(world, "stringify: Ok")
    Err(e) => io_println(world, "stringify: Err " + kind_name(e.kind))
  }
  match json::stringify_canonical(doc) {
    Ok(_) => io_println(world, "stringify_canonical: Ok")
    Err(e) => io_println(world, "stringify_canonical: Err " + kind_name(e.kind))
  }
  0
}

///| `adv without <file>`: one `without_keys` call removing every other key of a wide object.
fn run_without(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 1
  }
  let v = match json::parse(content) {
    Ok(v) => v
    Err(_) => return 2
  }
  let keys = match v.as_obj() {
    Some(o) => o.keys()
    None => return 3
  }
  let drop : Array[String] = []
  let mut i = 0
  while i < keys.length() {
    drop.push(keys[i])
    i = i + 2
  }
  match v.without_keys(drop) {
    Ok(json::Json::Object(o)) => io_println(world, "kept=" + o.len().to_string())
    _ => return 4
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: driver parse|canon|rt|numfmt|ptr|adv|deep ...")
    return 64
  }
  let mode = args[1]
  if mode == "parse" {
    run_parse(world, args[2], if args.length() > 3 { args[3] } else { "lastwins" })
  } else if mode == "canon" {
    run_canon(world, args[2])
  } else if mode == "rt" {
    run_rt(world, args[2])
  } else if mode == "numfmt" {
    run_numfmt(world, args[2])
  } else if mode == "ptr" {
    run_ptr(world, args[2])
  } else if mode == "adv" && args[2] == "without" {
    run_without(world, args[3])
  } else if mode == "adv" {
    run_adv(world, args[3], atoi(args[4]))
  } else if mode == "utf8" {
    run_utf8(world)
  } else if mode == "deep" {
    run_deep(world, args[2], atoi(args[3]))
  } else {
    64
  }
}
