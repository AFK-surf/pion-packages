///| 4-mode (native_dbg / native_rel / wasm_dbg / wasm_rel) smoke test for `packages/json`.

import "json"

///|
pub fn main(world : World) -> Int {
  let doc = "{\"id\":9007199254740993,\"u64\":18446744073709551615,\"pi\":3.141592653589793,\"sub\":2.2250738585072012e-308,\"min\":5e-324,\"neg0\":-0.0,\"emoji\":\"\\uD83D\\uDE00\",\"nested\":{\"דּ\":1,\"😀\":2,\"a\":3}}"
  let parsed = match json::parse(doc) {
    Ok(v) => v
    Err(e) => {
      io_println(world, "ERR_PARSE:" + e.message)
      return 1
    }
  }
  let id_val = match parsed.get_i64("id") {
    Some(n) => n
    None => return 2
  }
  if id_val != 9007199254740993L {
    return 3
  }
  let u64_val = match parsed.get_u64("u64") {
    Some(u) => u
    None => return 4
  }
  if u64_val != 18446744073709551615UL {
    return 5
  }
  let ptr_val = match parsed.pointer("/nested/a") {
    Ok(Some(v)) => {
      match v.as_i64() {
        Some(n) => n
        None => return 6
      }
    }
    _ => return 7
  }
  if ptr_val != 3L {
    return 8
  }
  let modified = match parsed.set_field("checked", json::Json::bool(true)) {
    Ok(v) => v
    Err(_) => return 9
  }
  let compact = match json::stringify(modified) {
    Ok(s) => s
    Err(_) => return 10
  }
  let canonical = match json::stringify_canonical(modified) {
    Ok(s) => s
    Err(_) => return 11
  }
  // Verify strict UTF-8 rejection via parse_bytes
  let bad = Bytes::new(3)
  bad[0] = (34).to_byte()
  bad[1] = (0xFF).to_byte()
  bad[2] = (34).to_byte()
  match json::parse_bytes(bad) {
    Ok(_) => return 12
    Err(_) => ()
  }
  // Verify DuplicateKeyPolicy::Reject
  let lim = json::JsonLimits::{
    max_depth: 64,
    max_bytes: 65536,
    max_elements: 10000,
    max_string_bytes: 4096,
    duplicate_keys: json::DuplicateKeyPolicy::Reject,
  }
  match json::parse_with_limits("{\"k\":1,\"k\":2}", lim) {
    Ok(_) => return 13
    Err(_) => ()
  }
  io_println(world, "compact=" + compact)
  io_println(world, "canonical=" + canonical)
  io_println(world, "id=" + id_val.to_string() + " u64=" + u64_val.to_string())
  0
}
