///| Strict RFC 8259 iterative JSON parser (zero recursion, zero global state).
///| Supports lossless Int64 / Double (Clinger + Eisel-Lemire + BigInt) / BigNum,
///| order-preserving O(1) JsonObject, DuplicateKeyPolicy, and explicit JsonLimits.

struct ParseFrame {
  is_obj : Bool
  arr_items : Array[Json]
  obj_entries : Array[(String, Json)]
  mut obj_idx : Option[ObjIndexBuilder]
  mut obj_key : String
}

struct Parser {
  src : String
  n : Int
  mut pos : Int
  max_string_bytes : Int
  mut has_err : Bool
  mut err_kind : JsonErrorKind
  mut err_off : Int
  mut err_msg : String
}

fn Parser::new(src : String, max_string_bytes : Int) -> Parser {
  Parser::{
    src: src,
    n: src.length(),
    pos: 0,
    max_string_bytes: max_string_bytes,
    has_err: false,
    err_kind: JsonErrorKind::Syntax,
    err_off: 0,
    err_msg: "",
  }
}

fn Parser::set_err(self : Parser, kind : JsonErrorKind, off : Int, msg : String) -> Unit {
  self.has_err = true
  self.err_kind = kind
  self.err_off = off
  self.err_msg = msg
}

fn Parser::set_syntax_or_utf8_err(self : Parser, off : Int, msg : String) -> Unit {
  if off < self.n && self.src.code_unit_at(off) >= 0x80 && utf8_seq_len_at(self.src, self.n, off) == 0 {
    self.set_err(JsonErrorKind::InvalidUtf8, off, "invalid UTF-8 byte sequence")
  } else {
    self.set_err(JsonErrorKind::Syntax, off, msg)
  }
}

fn Parser::to_err(self : Parser) -> JsonError {
  make_err(self.src, self.err_kind, self.err_off, self.err_msg)
}

fn Parser::skip_ws(self : Parser) -> Unit {
  let src = self.src
  let n = self.n
  let mut p = self.pos
  while p < n {
    let b = src.code_unit_at(p)
    if b > 32 || (b != 32 && b != 9 && b != 10 && b != 13) {
      break
    }
    p = p + 1
  }
  self.pos = p
}

fn parse_hex4(src : String, n : Int, pos : Int) -> Int {
  if pos + 4 > n {
    return -1
  }
  let mut v = 0
  let mut i = 0
  while i < 4 {
    let b = src.code_unit_at(pos + i)
    let d = if b >= 48 && b <= 57 {
      b - 48
    } else if b >= 97 && b <= 102 {
      b - 87
    } else if b >= 65 && b <= 70 {
      b - 55
    } else {
      return -1
    }
    v = (v << 4) | d
    i = i + 1
  }
  v
}

fn make_err(src : String, kind : JsonErrorKind, off : Int, msg : String) -> JsonError {
  let (ln, cl) = line_col_at(src, off)
  JsonError::new(kind, ln, cl, off, msg)
}

///| Parse a strict RFC 8259 JSON string starting at `self.pos` (pointing at opening `"`).
///| Validates UTF-8 in-place on non-ASCII bytes and advances `self.pos` past closing `"`.
///| On error sets `self.has_err = true` and returns `""` (zero Result/tuple boxing).
fn Parser::parse_string(self : Parser) -> String {
  let src = self.src
  let n = self.n
  let pos = self.pos
  let max_string_bytes = self.max_string_bytes
  let start = pos + 1
  let mut i = start

  // Fast path: scan until `"`, `\`, or control char < 0x20, validating UTF-8 on non-ASCII bytes.
  while i < n {
    // 4-byte unrolled printable-ASCII fast scan
    while i + 4 <= n {
      let b0 = src.code_unit_at(i)
      let b1 = src.code_unit_at(i + 1)
      let b2 = src.code_unit_at(i + 2)
      let b3 = src.code_unit_at(i + 3)
      if (b0 | b1 | b2 | b3) < 0x80 &&
      b0 >= 32 && b1 >= 32 && b2 >= 32 && b3 >= 32 &&
      b0 != 34 && b1 != 34 && b2 != 34 && b3 != 34 &&
      b0 != 92 && b1 != 92 && b2 != 92 && b3 != 92 {
        i = i + 4
        continue
      }
      break
    }
    if i >= n {
      break
    }
    let b = src.code_unit_at(i)
    if b < 0x80 {
      if b == 34 {
        let byte_len = i - start
        if byte_len > max_string_bytes {
          self.set_err(JsonErrorKind::StringLimitExceeded, pos, "string exceeds max_string_bytes")
          return ""
        }
        self.pos = i + 1
        return src.slice(start, i)
      }
      if b == 92 {
        break
      }
      if b < 0x20 {
        self.set_err(JsonErrorKind::Syntax, i, "unescaped control character in string")
        return ""
      }
      i = i + 1
    } else if b >= 0xC2 && b <= 0xDF {
      if i + 1 >= n || (src.code_unit_at(i + 1) & 0xC0) != 0x80 {
        self.set_err(JsonErrorKind::InvalidUtf8, i, "invalid 2-byte UTF-8 sequence")
        return ""
      }
      i = i + 2
    } else if b >= 0xE0 && b <= 0xEF {
      if i + 2 >= n {
        self.set_err(JsonErrorKind::InvalidUtf8, i, "truncated 3-byte UTF-8 sequence")
        return ""
      }
      let b1 = src.code_unit_at(i + 1)
      let b2 = src.code_unit_at(i + 2)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        self.set_err(JsonErrorKind::InvalidUtf8, i, "invalid UTF-8 continuation byte")
        return ""
      }
      if b == 0xE0 && b1 < 0xA0 {
        self.set_err(JsonErrorKind::InvalidUtf8, i, "overlong 3-byte UTF-8 sequence")
        return ""
      }
      if b == 0xED && b1 >= 0xA0 {
        self.set_err(JsonErrorKind::InvalidUtf8, i, "UTF-16 surrogate code point in UTF-8")
        return ""
      }
      i = i + 3
    } else if b >= 0xF0 && b <= 0xF4 {
      if i + 3 >= n {
        self.set_err(JsonErrorKind::InvalidUtf8, i, "truncated 4-byte UTF-8 sequence")
        return ""
      }
      let b1 = src.code_unit_at(i + 1)
      let b2 = src.code_unit_at(i + 2)
      let b3 = src.code_unit_at(i + 3)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        self.set_err(JsonErrorKind::InvalidUtf8, i, "invalid UTF-8 continuation byte")
        return ""
      }
      if b == 0xF0 && b1 < 0x90 {
        self.set_err(JsonErrorKind::InvalidUtf8, i, "overlong 4-byte UTF-8 sequence")
        return ""
      }
      if b == 0xF4 && b1 > 0x8F {
        self.set_err(JsonErrorKind::InvalidUtf8, i, "UTF-8 code point above U+10FFFF")
        return ""
      }
      i = i + 4
    } else {
      self.set_err(JsonErrorKind::InvalidUtf8, i, "invalid UTF-8 lead byte")
      return ""
    }
  }
  if i >= n {
    self.set_err(JsonErrorKind::UnexpectedEof, pos, "unterminated string")
    return ""
  }

  // Slow path: string contains escape sequences.
  let prefix_len = i - start
  let sb = StringBuilder::with_capacity(prefix_len + 32)
  let mut out_bytes = 0
  if prefix_len > 0 {
    out_bytes = prefix_len
    if out_bytes > max_string_bytes {
      self.set_err(JsonErrorKind::StringLimitExceeded, pos, "string exceeds max_string_bytes")
      return ""
    }
    sb.write_substring(src, start, i)
  }
  let mut chunk_start = i
  while i < n {
    let b = src.code_unit_at(i)
    if b < 0x80 {
      if b == 34 {
        if i > chunk_start {
          let seg_len = i - chunk_start
          out_bytes = out_bytes + seg_len
          if out_bytes > max_string_bytes {
            self.set_err(JsonErrorKind::StringLimitExceeded, pos, "string exceeds max_string_bytes")
            return ""
          }
          sb.write_substring(src, chunk_start, i)
        }
        self.pos = i + 1
        return sb.to_string()
      }
      if b < 0x20 {
        self.set_err(JsonErrorKind::Syntax, i, "unescaped control character in string")
        return ""
      }
      if b == 92 {
        if i > chunk_start {
          let seg_len = i - chunk_start
          out_bytes = out_bytes + seg_len
          if out_bytes > max_string_bytes {
            self.set_err(JsonErrorKind::StringLimitExceeded, pos, "string exceeds max_string_bytes")
            return ""
          }
          sb.write_substring(src, chunk_start, i)
        }
        if i + 1 >= n {
          self.set_err(JsonErrorKind::UnexpectedEof, i, "unterminated escape sequence")
          return ""
        }
        let esc = src.code_unit_at(i + 1)
        if esc == 34 {
          sb.write_byte((34).to_byte())
          out_bytes = out_bytes + 1
          i = i + 2
        } else if esc == 92 {
          sb.write_byte((92).to_byte())
          out_bytes = out_bytes + 1
          i = i + 2
        } else if esc == 47 {
          sb.write_byte((47).to_byte())
          out_bytes = out_bytes + 1
          i = i + 2
        } else if esc == 98 {
          sb.write_byte((8).to_byte())
          out_bytes = out_bytes + 1
          i = i + 2
        } else if esc == 102 {
          sb.write_byte((12).to_byte())
          out_bytes = out_bytes + 1
          i = i + 2
        } else if esc == 110 {
          sb.write_byte((10).to_byte())
          out_bytes = out_bytes + 1
          i = i + 2
        } else if esc == 114 {
          sb.write_byte((13).to_byte())
          out_bytes = out_bytes + 1
          i = i + 2
        } else if esc == 116 {
          sb.write_byte((9).to_byte())
          out_bytes = out_bytes + 1
          i = i + 2
        } else if esc == 117 {
          let cu = parse_hex4(src, n, i + 2)
          if cu < 0 {
            self.set_err(JsonErrorKind::InvalidEscape, i, "invalid \\uXXXX escape")
            return ""
          }
          if cu >= 0xDC00 && cu <= 0xDFFF {
            self.set_err(JsonErrorKind::InvalidUnicode, i, "lone low UTF-16 surrogate")
            return ""
          }
          if cu >= 0xD800 && cu <= 0xDBFF {
            // Must be immediately followed by \uDC00..\uDFFF
            if i + 11 >= n || src.code_unit_at(i + 6) != 92 || src.code_unit_at(i + 7) != 117 {
              self.set_err(JsonErrorKind::InvalidUnicode, i, "lone high UTF-16 surrogate")
              return ""
            }
            let lo = parse_hex4(src, n, i + 8)
            if lo < 0xDC00 || lo > 0xDFFF {
              self.set_err(JsonErrorKind::InvalidUnicode, i + 6, "invalid low UTF-16 surrogate")
              return ""
            }
            let cp = 0x10000 + ((cu - 0xD800) << 10) + (lo - 0xDC00)
            write_utf8_scalar(sb, cp)
            out_bytes = out_bytes + 4
            i = i + 12
          } else {
            write_utf8_scalar(sb, cu)
            out_bytes = out_bytes + (if cu < 0x80 { 1 } else if cu < 0x800 { 2 } else { 3 })
            i = i + 6
          }
        } else {
          self.set_err(JsonErrorKind::InvalidEscape, i, "invalid escape character")
          return ""
        }
        if out_bytes > max_string_bytes {
          self.set_err(JsonErrorKind::StringLimitExceeded, pos, "string exceeds max_string_bytes")
          return ""
        }
        chunk_start = i
      } else {
        i = i + 1
      }
    } else {
      let seq_len = utf8_seq_len_at(src, n, i)
      if seq_len == 0 {
        self.set_err(JsonErrorKind::InvalidUtf8, i, "invalid UTF-8 sequence in string")
        return ""
      }
      i = i + seq_len
    }
  }
  self.set_err(JsonErrorKind::UnexpectedEof, pos, "unterminated string")
  ""
}

///| Exact IEEE-754 binary64 powers of 10 from 10^0 to 10^22 (all exactly representable in f64).
let exact_pow10_f64 : FixedArray[Double] = [
  1.0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10,
  1e11, 1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22,
]

///| Parse a strict RFC 8259 JSON number starting at `self.pos`.
///| Advances `self.pos` in place and returns `Json` directly (zero Result/tuple boxing):
///| - Exact integer in i64::MIN..=i64::MAX -> `Json::Int(Int64)`
///| - Out-of-range integer -> `Json::BigNum(raw)`
///| - Fractional/exponent finite binary64 -> `Json::Float(Double)` (Clinger + Eisel-Lemire + BigInt 0-ULP)
///| - Fractional/exponent overflowing binary64 -> `Json::BigNum(raw)`
fn Parser::parse_number(self : Parser) -> Json {
  let src = self.src
  let n = self.n
  let start = self.pos
  let mut i = start
  let neg = if i < n && src.code_unit_at(i) == 45 {
    i = i + 1
    true
  } else {
    false
  }
  if i >= n {
    self.set_err(JsonErrorKind::InvalidNumber, start, "unexpected end of number")
    return Json::Null
  }

  // Integer part: "0" or [1-9][0-9]* — accumulate `mag` in-place during first scan!
  let int_start = i
  let b0 = src.code_unit_at(i)
  let mut int_mag : UInt64 = 0UL
  let mut int_digits = 0
  if b0 == 48 {
    i = i + 1
    int_digits = 1
    if i < n {
      let next = src.code_unit_at(i)
      if next >= 48 && next <= 57 {
        self.set_err(JsonErrorKind::InvalidNumber, i, "leading zero in number")
        return Json::Null
      }
    }
  } else if b0 >= 49 && b0 <= 57 {
    int_mag = (b0 - 48).to_int64().reinterpret_as_uint64()
    int_digits = 1
    i = i + 1
    while i < n {
      let b = src.code_unit_at(i)
      if b >= 48 && b <= 57 {
        if int_digits < 19 {
          int_mag = int_mag * 10UL + (b - 48).to_int64().reinterpret_as_uint64()
        }
        int_digits = int_digits + 1
        i = i + 1
      } else {
        break
      }
    }
  } else {
    self.set_err(JsonErrorKind::InvalidNumber, i, "invalid number")
    return Json::Null
  }
  let int_end = i

  // Fast check: pure integer (neither '.' nor 'e'/'E')
  if i >= n || (src.code_unit_at(i) != 46 && src.code_unit_at(i) != 101 && src.code_unit_at(i) != 69) {
    self.pos = i
    if int_digits <= 19 {
      if !neg {
        if int_mag <= 9223372036854775807UL {
          return Json::Int(int_mag.reinterpret_as_int64())
        }
      } else {
        if int_mag == 0UL {
          let neg_zero_bits : Int64 = -9223372036854775807L - 1L
          return Json::Float(Double::from_bits(neg_zero_bits))
        }
        if int_mag <= 9223372036854775808UL {
          return Json::Int((0UL - int_mag).reinterpret_as_int64())
        }
      }
    }
    return Json::BigNum(src.slice(start, i))
  }

  // Fractional part: "." [0-9]+
  let mut frac_start = i
  let mut frac_end = i
  if i < n && src.code_unit_at(i) == 46 {
    i = i + 1
    frac_start = i
    if i >= n || src.code_unit_at(i) < 48 || src.code_unit_at(i) > 57 {
      self.set_err(JsonErrorKind::InvalidNumber, i, "expected digit after decimal point")
      return Json::Null
    }
    while i < n {
      let b = src.code_unit_at(i)
      if b >= 48 && b <= 57 {
        i = i + 1
      } else {
        break
      }
    }
    frac_end = i
  }

  // Exponent part: ("e"|"E") ["+"|"-"] [0-9]+
  let mut exp_val = 0
  let mut exp_overflow = false
  let mut exp_neg = false
  if i < n {
    let eb = src.code_unit_at(i)
    if eb == 101 || eb == 69 {
      i = i + 1
      if i < n {
        let sb = src.code_unit_at(i)
        if sb == 45 {
          exp_neg = true
          i = i + 1
        } else if sb == 43 {
          i = i + 1
        }
      }
      if i >= n || src.code_unit_at(i) < 48 || src.code_unit_at(i) > 57 {
        self.set_err(JsonErrorKind::InvalidNumber, i, "expected digit in exponent")
        return Json::Null
      }
      while i < n {
        let b = src.code_unit_at(i)
        if b >= 48 && b <= 57 {
          if exp_val < 10000000 {
            exp_val = exp_val * 10 + (b - 48)
          } else {
            exp_overflow = true
          }
          i = i + 1
        } else {
          break
        }
      }
    }
  }
  let end = i
  self.pos = end

  // Case 2: Float (has '.' or 'e'/'E')
  // Scan significant digits for Clinger / Eisel-Lemire fast path (<= 19 significant digits).
  let signed_exp = if exp_neg { -exp_val } else { exp_val }
  let mut mant : UInt64 = 0UL
  let mut sig_digits = 0
  let mut truncated = false
  let mut exp_adjust = 0

  // Integer digits (reuse int_mag if it fits without leading zero!)
  if int_mag > 0UL && int_digits <= 19 {
    mant = int_mag
    sig_digits = int_digits
  } else if int_digits > 19 {
    let mut j = int_start
    while j < int_end {
      let d = src.code_unit_at(j) - 48
      if sig_digits < 19 {
        mant = mant * 10UL + d.to_int64().reinterpret_as_uint64()
        sig_digits = sig_digits + 1
      } else {
        exp_adjust = exp_adjust + 1
        if d != 0 {
          truncated = true
        }
      }
      j = j + 1
    }
  }
  // Fractional digits
  let mut j = frac_start
  while j < frac_end {
    let d = src.code_unit_at(j) - 48
    if sig_digits == 0 && d == 0 {
      exp_adjust = exp_adjust - 1
      j = j + 1
      continue
    }
    if sig_digits < 19 {
      mant = mant * 10UL + d.to_int64().reinterpret_as_uint64()
      sig_digits = sig_digits + 1
      exp_adjust = exp_adjust - 1
    } else {
      if d != 0 {
        truncated = true
      }
    }
    j = j + 1
  }

  if sig_digits == 0 {
    let zero_bits : Int64 = if neg { -9223372036854775807L - 1L } else { 0L }
    return Json::Float(Double::from_bits(zero_bits))
  }

  if exp_overflow {
    if exp_neg {
      let zero_bits : Int64 = if neg { -9223372036854775807L - 1L } else { 0L }
      return Json::Float(Double::from_bits(zero_bits))
    } else {
      return Json::BigNum(src.slice(start, end))
    }
  }

  let q = signed_exp + exp_adjust

  // Clinger's 0-ULP exact fast path: mant <= 2^53 - 1 and -22 <= q <= 22.
  // Both mant and 10^|q| are exact in IEEE-754 binary64, so one mul/div is strictly 0-ULP!
  if !truncated && mant <= 9007199254740991UL && q >= -22 && q <= 22 {
    let dm = mant.reinterpret_as_int64().to_double()
    let abs_d = if q == 0 {
      dm
    } else if q > 0 {
      dm * exact_pow10_f64[q]
    } else {
      dm / exact_pow10_f64[-q]
    }
    let final_d = if neg { -abs_d } else { abs_d }
    return Json::Float(final_d)
  }

  // Quick exponent bounds before Eisel-Lemire / BigInt
  let sci_exp = q + sig_digits - 1
  if sci_exp > 309 {
    return Json::BigNum(src.slice(start, end))
  }
  if sci_exp < -325 {
    let zero_bits : Int64 = if neg { -9223372036854775807L - 1L } else { 0L }
    return Json::Float(Double::from_bits(zero_bits))
  }

  // Fast path: Eisel-Lemire 128-bit exact conversion when not truncated.
  if !truncated {
    match eisel_lemire_f64(mant, q) {
      Some(abs_d) => {
        let bits = abs_d.reinterpret_as_uint64()
        if ((bits >> 52UL) & 0x7FFUL) == 0x7FFUL {
          return Json::BigNum(src.slice(start, end))
        }
        let final_d = if neg { -abs_d } else { abs_d }
        return Json::Float(final_d)
      }
      None => ()
    }
  }

  // Exact 0-ULP BigInt fallback (Algorithm M) for midpoints, subnormals, and > 19 digits.
  let abs_d = parse_decimal_float_bigint(src, int_start, int_end, frac_start, frac_end, signed_exp)
  let bits = abs_d.reinterpret_as_uint64()
  if ((bits >> 52UL) & 0x7FFUL) == 0x7FFUL {
    return Json::BigNum(src.slice(start, end))
  }
  let final_d = if neg {
    Double::from_bits((bits | 0x8000000000000000UL).reinterpret_as_int64())
  } else {
    abs_d
  }
  Json::Float(final_d)
}

///| Insert `(frame.obj_key, v)` into `frame` in place according to `DuplicateKeyPolicy`.
///| Returns `false` on `DuplicateKeyPolicy::Reject` (sets error on `p`).
fn obj_frame_insert(
  frame : ParseFrame,
  v : Json,
  policy : DuplicateKeyPolicy,
  doc_seed : UInt64,
  p : Parser,
  key_off : Int,
) -> Bool {
  let entries = frame.obj_entries
  let key = frame.obj_key
  let n = entries.length()
  match frame.obj_idx {
    Some(b) => {
      let existing = b.insert_if_absent(key, n)
      if existing >= 0 {
        match policy {
          DuplicateKeyPolicy::LastWins => {
            entries[existing] = (key, v)
            true
          }
          DuplicateKeyPolicy::FirstWins => true
          DuplicateKeyPolicy::Reject => {
            p.set_err(JsonErrorKind::DuplicateKey, key_off, "duplicate object key: " + key)
            false
          }
        }
      } else {
        entries.push((key, v))
        true
      }
    }
    None => {
      // Linear scan for small objects (<= 8 entries)
      let mut i = 0
      while i < n {
        let (ek, _) = entries[i]
        if ek == key {
          match policy {
            DuplicateKeyPolicy::LastWins => {
              entries[i] = (key, v)
              return true
            }
            DuplicateKeyPolicy::FirstWins => return true
            DuplicateKeyPolicy::Reject => {
              p.set_err(JsonErrorKind::DuplicateKey, key_off, "duplicate object key: " + key)
              return false
            }
          }
        }
        i = i + 1
      }
      entries.push((key, v))
      if n + 1 > 8 {
        // Promote to O(1) hash index on crossing 8 entries
        let b = ObjIndexBuilder::new(32, doc_seed)
        let mut j = 0
        while j <= n {
          let (k, _) = entries[j]
          let _ = b.insert_if_absent(k, j)
          j = j + 1
        }
        frame.obj_idx = Some(b)
      }
      true
    }
  }
}

///| Top-level strict RFC 8259 iterative parser (single-pass UTF-8, mutable cursor & frame stack).
fn parse_str_impl(src : String, limits : JsonLimits) -> Result[Json, JsonError] {
  let n = src.length()
  if n > limits.max_bytes {
    return Err(
      JsonError::new(
        JsonErrorKind::ByteLimitExceeded,
        1,
        1,
        0,
        "input byte length exceeds max_bytes limit",
      ),
    )
  }

  let p = Parser::new(src, limits.max_string_bytes)
  p.skip_ws()
  if p.pos >= n {
    return Err(make_err(src, JsonErrorKind::UnexpectedEof, p.pos, "empty JSON input"))
  }

  let doc_seed = derive_seed_from_str(src)
  let stack : Array[ParseFrame] = Array::with_capacity(16)
  let empty_arr : Array[Json] = []
  let empty_entries : Array[(String, Json)] = []
  let max_depth = limits.max_depth
  let max_elements = limits.max_elements
  let dup_policy = limits.duplicate_keys

  let mut elements = 0
  let mut root_val : Option[Json] = None

  // State machine:
  // expect_value == true  -> parse a value (or empty container close if just opened)
  // expect_value == false -> we just completed a value `cur_val`, attach to parent or finish
  let mut expect_value = true
  let mut cur_val : Json = Json::Null

  while true {
    if expect_value {
      p.skip_ws()
      let pos = p.pos
      if pos >= n {
        return Err(make_err(src, JsonErrorKind::UnexpectedEof, pos, "unexpected end of input"))
      }
      elements = elements + 1
      if elements > max_elements {
        return Err(make_err(src, JsonErrorKind::ElementLimitExceeded, pos, "element count exceeds max_elements"))
      }
      let b = src.code_unit_at(pos)
      if b == 34 {
        // '"' (most common value token)
        let s = p.parse_string()
        if p.has_err {
          return Err(p.to_err())
        }
        cur_val = Json::Str(s)
        expect_value = false
      } else if b == 45 || (b >= 48 && b <= 57) {
        let nv = p.parse_number()
        if p.has_err {
          return Err(p.to_err())
        }
        cur_val = nv
        expect_value = false
      } else if b == 123 {
        // '{'
        if stack.length() + 1 > max_depth {
          return Err(make_err(src, JsonErrorKind::DepthLimitExceeded, pos, "nesting depth exceeds max_depth"))
        }
        p.pos = pos + 1
        p.skip_ws()
        let kpos = p.pos
        if kpos < n && src.code_unit_at(kpos) == 125 {
          p.pos = kpos + 1
          cur_val = Json::Object(JsonObject::empty())
          expect_value = false
        } else {
          if kpos >= n {
            return Err(make_err(src, JsonErrorKind::UnexpectedEof, kpos, "unterminated object"))
          }
          if src.code_unit_at(kpos) != 34 {
            p.set_syntax_or_utf8_err(kpos, "expected string key in object")
            return Err(p.to_err())
          }
          let k = p.parse_string()
          if p.has_err {
            return Err(p.to_err())
          }
          p.skip_ws()
          if p.pos >= n || src.code_unit_at(p.pos) != 58 {
            p.set_syntax_or_utf8_err(p.pos, "expected ':' after object key")
            return Err(p.to_err())
          }
          p.pos = p.pos + 1
          stack.push(
            ParseFrame::{
              is_obj: true,
              arr_items: empty_arr,
              obj_entries: Array::with_capacity(4),
              obj_idx: None,
              obj_key: k,
            },
          )
          expect_value = true
        }
      } else if b == 91 {
        // '['
        if stack.length() + 1 > max_depth {
          return Err(make_err(src, JsonErrorKind::DepthLimitExceeded, pos, "nesting depth exceeds max_depth"))
        }
        p.pos = pos + 1
        p.skip_ws()
        let epos = p.pos
        if epos < n && src.code_unit_at(epos) == 93 {
          p.pos = epos + 1
          cur_val = Json::Array([])
          expect_value = false
        } else {
          stack.push(
            ParseFrame::{
              is_obj: false,
              arr_items: Array::with_capacity(4),
              obj_entries: empty_entries,
              obj_idx: None,
              obj_key: "",
            },
          )
          expect_value = true
        }
      } else if b == 116 {
        // 'true'
        if pos + 4 <= n &&
        src.code_unit_at(pos + 1) == 114 &&
        src.code_unit_at(pos + 2) == 117 &&
        src.code_unit_at(pos + 3) == 101 {
          p.pos = pos + 4
          cur_val = Json::Bool(true)
          expect_value = false
        } else {
          return Err(make_err(src, JsonErrorKind::Syntax, pos, "invalid literal"))
        }
      } else if b == 102 {
        // 'false'
        if pos + 5 <= n &&
        src.code_unit_at(pos + 1) == 97 &&
        src.code_unit_at(pos + 2) == 108 &&
        src.code_unit_at(pos + 3) == 115 &&
        src.code_unit_at(pos + 4) == 101 {
          p.pos = pos + 5
          cur_val = Json::Bool(false)
          expect_value = false
        } else {
          return Err(make_err(src, JsonErrorKind::Syntax, pos, "invalid literal"))
        }
      } else if b == 110 {
        // 'null'
        if pos + 4 <= n &&
        src.code_unit_at(pos + 1) == 117 &&
        src.code_unit_at(pos + 2) == 108 &&
        src.code_unit_at(pos + 3) == 108 {
          p.pos = pos + 4
          cur_val = Json::Null
          expect_value = false
        } else {
          return Err(make_err(src, JsonErrorKind::Syntax, pos, "invalid literal"))
        }
      } else {
        p.set_syntax_or_utf8_err(pos, "unexpected token")
        return Err(p.to_err())
      }
    } else {
      // Attach `cur_val` to top container frame in place, or finish if stack is empty.
      let depth = stack.length()
      if depth == 0 {
        root_val = Some(cur_val)
        break
      }
      let top = stack[depth - 1]
      if !top.is_obj {
        top.arr_items.push(cur_val)
        p.skip_ws()
        let spos = p.pos
        if spos >= n {
          return Err(make_err(src, JsonErrorKind::UnexpectedEof, spos, "unterminated array"))
        }
        let sep = src.code_unit_at(spos)
        if sep == 44 {
          // ',' — keep top frame in place, zero pop/push!
          p.pos = spos + 1
          expect_value = true
        } else if sep == 93 {
          // ']'
          p.pos = spos + 1
          let _ = stack.pop()
          cur_val = Json::Array(top.arr_items)
          expect_value = false
        } else {
          p.set_syntax_or_utf8_err(spos, "expected ',' or ']' in array")
          return Err(p.to_err())
        }
      } else {
        if !obj_frame_insert(top, cur_val, dup_policy, doc_seed, p, p.pos) {
          return Err(p.to_err())
        }
        p.skip_ws()
        let spos = p.pos
        if spos >= n {
          return Err(make_err(src, JsonErrorKind::UnexpectedEof, spos, "unterminated object"))
        }
        let sep = src.code_unit_at(spos)
        if sep == 44 {
          // ',' — mutate top.obj_key in place, zero pop/push!
          p.pos = spos + 1
          p.skip_ws()
          let kpos = p.pos
          if kpos >= n {
            return Err(make_err(src, JsonErrorKind::UnexpectedEof, kpos, "unterminated object after ','"))
          }
          if src.code_unit_at(kpos) != 34 {
            p.set_syntax_or_utf8_err(kpos, "expected string key after ','")
            return Err(p.to_err())
          }
          let next_key = p.parse_string()
          if p.has_err {
            return Err(p.to_err())
          }
          p.skip_ws()
          if p.pos >= n || src.code_unit_at(p.pos) != 58 {
            p.set_syntax_or_utf8_err(p.pos, "expected ':' after object key")
            return Err(p.to_err())
          }
          p.pos = p.pos + 1
          top.obj_key = next_key
          expect_value = true
        } else if sep == 125 {
          // '}'
          p.pos = spos + 1
          let _ = stack.pop()
          let frozen = match top.obj_idx {
            Some(b) => Some(b.freeze())
            None => None
          }
          cur_val = Json::Object(JsonObject::{ entries: top.obj_entries, index: frozen })
          expect_value = false
        } else {
          p.set_syntax_or_utf8_err(spos, "expected ',' or '}' in object")
          return Err(p.to_err())
        }
      }
    }
  }

  p.skip_ws()
  if p.pos < n {
    let b = src.code_unit_at(p.pos)
    if b >= 0x80 && utf8_seq_len_at(src, n, p.pos) == 0 {
      return Err(make_err(src, JsonErrorKind::InvalidUtf8, p.pos, "invalid UTF-8 byte sequence"))
    }
    return Err(make_err(src, JsonErrorKind::TrailingData, p.pos, "unexpected trailing data after JSON value"))
  }
  match root_val {
    Some(v) => Ok(v)
    None => Err(make_err(src, JsonErrorKind::UnexpectedEof, 0, "empty JSON input"))
  }
}
