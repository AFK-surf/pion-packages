///| Strict UTF-8 validation, encoding, decoding, and 1-based line/col tracking for `json`.

///| Encode a valid Unicode scalar value (0..=0x10FFFF, excluding surrogates) as UTF-8.
fn write_utf8_scalar(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Compute 1-based (line, col) at byte offset `off` in `s`.
fn line_col_at(s : String, off : Int) -> (Int, Int) {
  let n = s.length()
  let limit = if off < n { off } else { n }
  let mut line = 1
  let mut col = 1
  let mut i = 0
  while i < limit {
    let b = s.code_unit_at(i)
    if b == 10 {
      line = line + 1
      col = 1
      i = i + 1
    } else if b == 13 {
      line = line + 1
      col = 1
      if i + 1 < limit && s.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
    } else {
      if (b & 0xC0) != 0x80 {
        col = col + 1
      }
      i = i + 1
    }
  }
  (line, col)
}

///| Validate a UTF-8 byte sequence in a `String`. Rejects overlong sequences,
///| UTF-16 surrogates (U+D800..U+DFFF), code points > U+10FFFF, and truncated sequences.
fn validate_utf8_str(s : String) -> Result[Unit, JsonError] {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        let (ln, cl) = line_col_at(s, i)
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, ln, cl, i, "truncated 2-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) != 0x80 {
        let (ln, cl) = line_col_at(s, i)
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, ln, cl, i, "invalid UTF-8 continuation byte"))
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        let (ln, cl) = line_col_at(s, i)
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, ln, cl, i, "truncated 3-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        let (ln, cl) = line_col_at(s, i)
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, ln, cl, i, "invalid UTF-8 continuation byte"))
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        let (ln, cl) = line_col_at(s, i)
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, ln, cl, i, "overlong 3-byte UTF-8 sequence"))
      }
      if b0 == 0xED && b1 >= 0xA0 {
        let (ln, cl) = line_col_at(s, i)
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, ln, cl, i, "UTF-16 surrogate code point in UTF-8"))
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        let (ln, cl) = line_col_at(s, i)
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, ln, cl, i, "truncated 4-byte UTF-8 sequence"))
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        let (ln, cl) = line_col_at(s, i)
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, ln, cl, i, "invalid UTF-8 continuation byte"))
      }
      if b0 == 0xF0 && b1 < 0x90 {
        let (ln, cl) = line_col_at(s, i)
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, ln, cl, i, "overlong 4-byte UTF-8 sequence"))
      }
      if b0 == 0xF4 && b1 > 0x8F {
        let (ln, cl) = line_col_at(s, i)
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, ln, cl, i, "UTF-8 code point above U+10FFFF"))
      }
      i = i + 4
    } else {
      let (ln, cl) = line_col_at(s, i)
      return Err(JsonError::new(JsonErrorKind::InvalidUtf8, ln, cl, i, "invalid UTF-8 lead byte"))
    }
  }
  Ok(())
}

///| Validate raw `Bytes` as strict UTF-8 (respecting `max_bytes`) and convert to `String`.
fn validate_utf8_bytes(bs : Bytes, max_bytes : Int) -> Result[String, JsonError] {
  let n = bs.length()
  if n > max_bytes {
    return Err(
      JsonError::new(
        JsonErrorKind::ByteLimitExceeded,
        1,
        1,
        0,
        "input byte length exceeds max_bytes limit",
      ),
    )
  }
  let mut i = 0
  let mut line = 1
  let mut col = 1
  while i < n {
    let b0 = bs[i].to_int()
    if b0 < 0x80 {
      if b0 == 10 {
        line = line + 1
        col = 1
      } else {
        col = col + 1
      }
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, line, col, i, "truncated 2-byte UTF-8 sequence"))
      }
      let b1 = bs[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, line, col, i, "invalid UTF-8 continuation byte"))
      }
      i = i + 2
      col = col + 1
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, line, col, i, "truncated 3-byte UTF-8 sequence"))
      }
      let b1 = bs[i + 1].to_int()
      let b2 = bs[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, line, col, i, "invalid UTF-8 continuation byte"))
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, line, col, i, "overlong 3-byte UTF-8 sequence"))
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, line, col, i, "UTF-16 surrogate code point in UTF-8"))
      }
      i = i + 3
      col = col + 1
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, line, col, i, "truncated 4-byte UTF-8 sequence"))
      }
      let b1 = bs[i + 1].to_int()
      let b2 = bs[i + 2].to_int()
      let b3 = bs[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, line, col, i, "invalid UTF-8 continuation byte"))
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, line, col, i, "overlong 4-byte UTF-8 sequence"))
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return Err(JsonError::new(JsonErrorKind::InvalidUtf8, line, col, i, "UTF-8 code point above U+10FFFF"))
      }
      i = i + 4
      col = col + 1
    } else {
      return Err(JsonError::new(JsonErrorKind::InvalidUtf8, line, col, i, "invalid UTF-8 lead byte"))
    }
  }
  let sb = StringBuilder::with_capacity(n)
  let mut j = 0
  while j < n {
    sb.write_byte(bs[j])
    j = j + 1
  }
  Ok(sb.to_string())
}

///| Check whether a single UTF-8 scalar starting at `i` in `s` (length `n`) is valid.
///| Returns the sequence length (1..4) if valid, or 0 if invalid.
fn utf8_seq_len_at(s : String, n : Int, i : Int) -> Int {
  let b0 = s.code_unit_at(i)
  if b0 < 0x80 {
    return 1
  }
  if b0 >= 0xC2 && b0 <= 0xDF {
    if i + 1 < n && (s.code_unit_at(i + 1) & 0xC0) == 0x80 {
      return 2
    }
    return 0
  }
  if b0 >= 0xE0 && b0 <= 0xEF {
    if i + 2 >= n {
      return 0
    }
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
      return 0
    }
    if b0 == 0xE0 && b1 < 0xA0 {
      return 0
    }
    if b0 == 0xED && b1 >= 0xA0 {
      return 0
    }
    return 3
  }
  if b0 >= 0xF0 && b0 <= 0xF4 {
    if i + 3 >= n {
      return 0
    }
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    let b3 = s.code_unit_at(i + 3)
    if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
      return 0
    }
    if b0 == 0xF0 && b1 < 0x90 {
      return 0
    }
    if b0 == 0xF4 && b1 > 0x8F {
      return 0
    }
    return 4
  }
  0
}
