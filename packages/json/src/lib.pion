///| Public entry points for strict RFC 8259 JSON parsing, serialization, and RFC 8785 JCS.

///| Parse a strict RFC 8259 JSON string with default limits.
pub fn parse(src : String) -> Result[Json, JsonError] {
  parse_with_limits(src, JsonLimits::default())
}

///| Parse strict UTF-8 RFC 8259 JSON bytes with default limits.
pub fn parse_bytes(bytes : Bytes) -> Result[Json, JsonError] {
  parse_bytes_with_limits(bytes, JsonLimits::default())
}

///| Parse a strict RFC 8259 JSON string with explicit resource limits and duplicate-key policy.
pub fn parse_with_limits(src : String, limits : JsonLimits) -> Result[Json, JsonError] {
  let _ = src
  let _ = limits
  Err(JsonError::new(JsonErrorKind::Syntax, 1, 1, 0, "not implemented"))
}

///| Parse strict UTF-8 RFC 8259 JSON bytes with explicit resource limits and duplicate-key policy.
pub fn parse_bytes_with_limits(bytes : Bytes, limits : JsonLimits) -> Result[Json, JsonError] {
  let _ = bytes
  let _ = limits
  Err(JsonError::new(JsonErrorKind::Syntax, 1, 1, 0, "not implemented"))
}

///| Serialize a `Json` value to compact RFC 8259 JSON.
pub fn stringify(v : Json) -> Result[String, JsonError] {
  let _ = v
  Err(JsonError::new(JsonErrorKind::Syntax, 1, 1, 0, "not implemented"))
}

///| Serialize a `Json` value to pretty-printed RFC 8259 JSON with `indent` spaces per level.
pub fn stringify_pretty(v : Json, indent : Int) -> Result[String, JsonError] {
  let _ = v
  let _ = indent
  Err(JsonError::new(JsonErrorKind::Syntax, 1, 1, 0, "not implemented"))
}

///| Serialize a `Json` value to RFC 8785 (JCS) canonical JSON
///| (object keys sorted by UTF-16 code units, ES6/Ryu shortest numbers, `-0.0` -> `0`, compact).
pub fn stringify_canonical(v : Json) -> Result[String, JsonError] {
  let _ = v
  Err(JsonError::new(JsonErrorKind::Syntax, 1, 1, 0, "not implemented"))
}

///| Iterative deep structural equality on `Json` values.
pub fn json_eq(a : Json, b : Json) -> Bool {
  let _ = a
  let _ = b
  false
}
