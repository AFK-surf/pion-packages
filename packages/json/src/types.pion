///| Core types, lossless number model, order-preserving O(1) `JsonObject`,
///| ergonomic immutable accessors, error kinds, and resource limits for `json`.

///| Structured error classification for RFC 8259 parsing, serialization, and queries.
pub enum JsonErrorKind {
  Syntax
  InvalidUtf8
  UnexpectedEof
  TrailingData
  InvalidEscape
  InvalidUnicode
  InvalidNumber
  DuplicateKey
  DepthLimitExceeded
  ByteLimitExceeded
  ElementLimitExceeded
  StringLimitExceeded
  NonFiniteNumber
  InvalidPointer
  TypeMismatch
}

///| Detailed error with 1-based line/column and 0-based byte offset.
pub struct JsonError {
  pub kind : JsonErrorKind
  pub line : Int
  pub col : Int
  pub offset : Int
  pub message : String
}

///| Construct a `JsonError`.
pub fn JsonError::new(
  kind : JsonErrorKind,
  line : Int,
  col : Int,
  offset : Int,
  message : String,
) -> JsonError {
  JsonError::{ kind: kind, line: line, col: col, offset: offset, message: message }
}

///| Policy for handling duplicate keys within the same JSON object.
pub enum DuplicateKeyPolicy {
  ///| Keep the last value for a duplicate key (updates value at original slot, matches `serde_json` preserve_order).
  LastWins
  ///| Keep the first value for a duplicate key and ignore subsequent duplicates.
  FirstWins
  ///| Reject duplicate keys with `JsonErrorKind::DuplicateKey`.
  Reject
}

///| Configurable parser resource limits and duplicate-key policy.
pub struct JsonLimits {
  pub max_depth : Int
  pub max_bytes : Int
  pub max_elements : Int
  pub max_string_bytes : Int
  pub duplicate_keys : DuplicateKeyPolicy
}

///| Default production resource limits:
///| `max_depth = 128`, `max_bytes = 64 MiB`, `max_elements = 2_000_000`,
///| `max_string_bytes = 16 MiB`, `duplicate_keys = LastWins`.
pub fn JsonLimits::default() -> JsonLimits {
  JsonLimits::{
    max_depth: 128,
    max_bytes: 67108864,
    max_elements: 2000000,
    max_string_bytes: 16777216,
    duplicate_keys: DuplicateKeyPolicy::LastWins,
  }
}

///| Lossless JSON number representation distinguishing exact `Int64`,
///| correctly-rounded IEEE-754 `Double`, and out-of-range raw literal `BigNum`.
pub enum JsonNumber {
  Int(Int64)
  Float(Double)
  BigNum(String)
}

///| Return exact `Int64` if representable without precision loss.
pub fn JsonNumber::as_i64(self : JsonNumber) -> Option[Int64] {
  match self {
    JsonNumber::Int(n) => Some(n)
    JsonNumber::BigNum(s) => parse_raw_as_i64(s)
    JsonNumber::Float(_) => None
  }
}

///| Return exact `UInt64` if representable without precision loss (including `u64::MAX` stored in `BigNum`).
pub fn JsonNumber::as_u64(self : JsonNumber) -> Option[UInt64] {
  match self {
    JsonNumber::Int(n) => {
      if n >= 0L {
        Some(n.reinterpret_as_uint64())
      } else {
        None
      }
    }
    JsonNumber::BigNum(s) => parse_raw_as_u64(s)
    JsonNumber::Float(_) => None
  }
}

///| Convert to finite IEEE-754 `Double` (returns `None` on overflow / non-finite).
pub fn JsonNumber::as_f64(self : JsonNumber) -> Option[Double] {
  match self {
    JsonNumber::Float(d) => {
      let bits = d.reinterpret_as_uint64()
      if ((bits >> 52UL) & 0x7FFUL) == 0x7FFUL {
        None
      } else {
        Some(d)
      }
    }
    JsonNumber::Int(n) => Some(n.to_double())
    JsonNumber::BigNum(s) => parse_raw_as_f64(s)
  }
}

///| Return the canonical/raw decimal literal representation of this number.
pub fn JsonNumber::raw_repr(self : JsonNumber) -> String {
  match self {
    JsonNumber::Int(n) => n.to_string()
    JsonNumber::Float(d) => format_float_str(d)
    JsonNumber::BigNum(s) => s
  }
}

///| Internal open-addressing hash index for O(1) lookup in large `JsonObject`s (> 8 keys).
///| Pure value with deterministic per-object seed (zero module-level mutable state).
struct ObjectHashIndex {
  seed : UInt64
  cap : Int
  keys : FixedArray[String]
  hashes : FixedArray[UInt64]
  ///| entry_idx + 1 (0 means empty slot)
  vals : FixedArray[Int]
}

///| Order-preserving JSON object with automatic O(1) key lookup for > 8 keys.
pub struct JsonObject {
  entries : Array[(String, Json)]
  index : Option[ObjectHashIndex]
}

///| Construct an empty `JsonObject`.
pub fn JsonObject::empty() -> JsonObject {
  JsonObject::{ entries: [], index: None }
}

///| Construct a `JsonObject` from `(key, value)` pairs using `LastWins` deduplication.
pub fn JsonObject::from_pairs(pairs : Array[(String, Json)]) -> JsonObject {
  let n = pairs.length()
  if n == 0 {
    return JsonObject::empty()
  }
  let entries : Array[(String, Json)] = []
  let seed = derive_seed_from_entries(pairs)
  let mut idx_opt : Option[ObjIndexBuilder] = None
  let mut i = 0
  while i < n {
    let (k, v) = pairs[i]
    match idx_opt {
      Some(b) => {
        let existing = b.insert_if_absent(k, entries.length())
        if existing >= 0 {
          entries[existing] = (k, v)
        } else {
          entries.push((k, v))
        }
      }
      None => {
        let mut found = -1
        let mut j = 0
        while j < entries.length() {
          let (ek, _) = entries[j]
          if ek == k {
            found = j
            break
          }
          j = j + 1
        }
        if found >= 0 {
          entries[found] = (k, v)
        } else {
          entries.push((k, v))
          if entries.length() > 8 {
            let b = ObjIndexBuilder::new(32, seed)
            let mut m = 0
            while m < entries.length() {
              let (ek, _) = entries[m]
              let _ = b.insert_if_absent(ek, m)
              m = m + 1
            }
            idx_opt = Some(b)
          }
        }
      }
    }
    i = i + 1
  }
  let frozen = match idx_opt {
    Some(b) => Some(b.freeze())
    None => None
  }
  JsonObject::{ entries: entries, index: frozen }
}

///| Return the number of entries in this object.
pub fn JsonObject::len(self : JsonObject) -> Int {
  self.entries.length()
}

///| Return true if this object has no entries.
pub fn JsonObject::is_empty(self : JsonObject) -> Bool {
  self.entries.length() == 0
}

///| Return all `(key, value)` entries in insertion order.
pub fn JsonObject::entries(self : JsonObject) -> Array[(String, Json)] {
  self.entries
}

///| Return all keys in insertion order.
pub fn JsonObject::keys(self : JsonObject) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < self.entries.length() {
    let (k, _) = self.entries[i]
    out.push(k)
    i = i + 1
  }
  out
}

///| Look up a key in O(1) (indexed when > 8 entries, linear scan when <= 8).
pub fn JsonObject::get(self : JsonObject, key : String) -> Option[Json] {
  match self.index {
    Some(idx) => {
      let pos = idx.get_idx(key)
      if pos >= 0 {
        let (_, v) = self.entries[pos]
        Some(v)
      } else {
        None
      }
    }
    None => {
      let mut i = 0
      while i < self.entries.length() {
        let (k, v) = self.entries[i]
        if k == key {
          return Some(v)
        }
        i = i + 1
      }
      None
    }
  }
}

///| Return true if `key` is present in this object.
pub fn JsonObject::contains_key(self : JsonObject, key : String) -> Bool {
  match self.get(key) {
    Some(_) => true
    None => false
  }
}

///| Immutable update: replace existing `key` in place or append `(key, v)`.
pub fn JsonObject::set(self : JsonObject, key : String, v : Json) -> JsonObject {
  let n = self.entries.length()
  let next : Array[(String, Json)] = []
  let mut replaced = false
  let mut i = 0
  while i < n {
    let (k, existing) = self.entries[i]
    if k == key {
      next.push((key, v))
      replaced = true
    } else {
      next.push((k, existing))
    }
    i = i + 1
  }
  if !replaced {
    next.push((key, v))
  }
  build_json_object(next)
}

///| Immutable removal of all listed `keys`, preserving order of remaining entries.
pub fn JsonObject::without_keys(self : JsonObject, keys : Array[String]) -> JsonObject {
  let kn = keys.length()
  if kn == 0 || self.entries.length() == 0 {
    return self
  }
  let next : Array[(String, Json)] = []
  let mut i = 0
  while i < self.entries.length() {
    let (k, v) = self.entries[i]
    let mut drop = false
    let mut j = 0
    while j < kn {
      if keys[j] == k {
        drop = true
        break
      }
      j = j + 1
    }
    if !drop {
      next.push((k, v))
    }
    i = i + 1
  }
  build_json_object(next)
}

///| Immutable merge: start from `self`, overwrite/append entries from `other` in order.
pub fn JsonObject::merge(self : JsonObject, other : JsonObject) -> JsonObject {
  let combined : Array[(String, Json)] = []
  let mut i = 0
  while i < self.entries.length() {
    combined.push(self.entries[i])
    i = i + 1
  }
  let mut j = 0
  while j < other.entries.length() {
    combined.push(other.entries[j])
    j = j + 1
  }
  JsonObject::from_pairs(combined)
}

///| Immutable, lossless RFC 8259 JSON value tree.
pub enum Json {
  Null
  Bool(Bool)
  Int(Int64)
  Float(Double)
  BigNum(String)
  Str(String)
  Array(Array[Json])
  Object(JsonObject)
}

///| Construct `Json::Null`.
pub fn Json::null() -> Json {
  Json::Null
}

///| Construct `Json::Bool`.
pub fn Json::bool(b : Bool) -> Json {
  Json::Bool(b)
}

///| Construct `Json::Int`.
pub fn Json::int(n : Int64) -> Json {
  Json::Int(n)
}

///| Construct `Json::Float`.
pub fn Json::float(f : Double) -> Json {
  Json::Float(f)
}

///| Construct `Json::BigNum`.
pub fn Json::big_num(repr : String) -> Json {
  Json::BigNum(repr)
}

///| Construct `Json::Str`.
pub fn Json::str(s : String) -> Json {
  Json::Str(s)
}

///| Construct `Json::Array`.
pub fn Json::arr(items : Array[Json]) -> Json {
  Json::Array(items)
}

///| Construct `Json::Object` from `(key, value)` pairs.
pub fn Json::obj(pairs : Array[(String, Json)]) -> Json {
  Json::Object(JsonObject::from_pairs(pairs))
}

///| Return true if this value is `Json::Null`.
pub fn Json::is_null(self : Json) -> Bool {
  match self {
    Json::Null => true
    _ => false
  }
}

///| Extract `Bool` if this value is `Json::Bool`.
pub fn Json::as_bool(self : Json) -> Option[Bool] {
  match self {
    Json::Bool(b) => Some(b)
    _ => None
  }
}

///| Extract exact `Int64` if representable without precision loss.
pub fn Json::as_i64(self : Json) -> Option[Int64] {
  match self {
    Json::Int(n) => Some(n)
    Json::BigNum(s) => parse_raw_as_i64(s)
    _ => None
  }
}

///| Extract exact `UInt64` if representable without precision loss.
pub fn Json::as_u64(self : Json) -> Option[UInt64] {
  match self {
    Json::Int(n) => {
      if n >= 0L {
        Some(n.reinterpret_as_uint64())
      } else {
        None
      }
    }
    Json::BigNum(s) => parse_raw_as_u64(s)
    _ => None
  }
}

///| Extract finite `Double` if this value is a number representable as finite binary64.
pub fn Json::as_f64(self : Json) -> Option[Double] {
  match self {
    Json::Float(d) => {
      let bits = d.reinterpret_as_uint64()
      if ((bits >> 52UL) & 0x7FFUL) == 0x7FFUL {
        None
      } else {
        Some(d)
      }
    }
    Json::Int(n) => Some(n.to_double())
    Json::BigNum(s) => parse_raw_as_f64(s)
    _ => None
  }
}

///| Extract `JsonNumber` if this value is `Int`, `Float`, or `BigNum`.
pub fn Json::as_number(self : Json) -> Option[JsonNumber] {
  match self {
    Json::Int(n) => Some(JsonNumber::Int(n))
    Json::Float(d) => Some(JsonNumber::Float(d))
    Json::BigNum(s) => Some(JsonNumber::BigNum(s))
    _ => None
  }
}

///| Return the raw decimal representation if this value is numeric.
pub fn Json::raw_repr(self : Json) -> Option[String] {
  match self {
    Json::Int(n) => Some(n.to_string())
    Json::Float(d) => Some(format_float_str(d))
    Json::BigNum(s) => Some(s)
    _ => None
  }
}

///| Extract `String` if this value is `Json::Str`.
pub fn Json::as_str(self : Json) -> Option[String] {
  match self {
    Json::Str(s) => Some(s)
    _ => None
  }
}

///| Extract `Array[Json]` if this value is `Json::Array`.
pub fn Json::as_array(self : Json) -> Option[Array[Json]] {
  match self {
    Json::Array(items) => Some(items)
    _ => None
  }
}

///| Extract `JsonObject` if this value is `Json::Object`.
pub fn Json::as_obj(self : Json) -> Option[JsonObject] {
  match self {
    Json::Object(o) => Some(o)
    _ => None
  }
}

///| Look up `key` on a `Json::Object`.
pub fn Json::get(self : Json, key : String) -> Option[Json] {
  match self {
    Json::Object(o) => o.get(key)
    _ => None
  }
}

///| Look up `key` and extract `String`.
pub fn Json::get_str(self : Json, key : String) -> Option[String] {
  match self.get(key) {
    Some(v) => v.as_str()
    None => None
  }
}

///| Look up `key` and extract exact `Int64`.
pub fn Json::get_i64(self : Json, key : String) -> Option[Int64] {
  match self.get(key) {
    Some(v) => v.as_i64()
    None => None
  }
}

///| Look up `key` and extract exact `UInt64`.
pub fn Json::get_u64(self : Json, key : String) -> Option[UInt64] {
  match self.get(key) {
    Some(v) => v.as_u64()
    None => None
  }
}

///| Look up `key` and extract finite `Double`.
pub fn Json::get_f64(self : Json, key : String) -> Option[Double] {
  match self.get(key) {
    Some(v) => v.as_f64()
    None => None
  }
}

///| Look up `key` and extract `Bool`.
pub fn Json::get_bool(self : Json, key : String) -> Option[Bool] {
  match self.get(key) {
    Some(v) => v.as_bool()
    None => None
  }
}

///| Look up `key` and extract `Array[Json]`.
pub fn Json::get_array(self : Json, key : String) -> Option[Array[Json]] {
  match self.get(key) {
    Some(v) => v.as_array()
    None => None
  }
}

///| Look up `key` and extract `JsonObject`.
pub fn Json::get_obj(self : Json, key : String) -> Option[JsonObject] {
  match self.get(key) {
    Some(v) => v.as_obj()
    None => None
  }
}

///| Index into a `Json::Array` by 0-based index.
pub fn Json::at(self : Json, index : Int) -> Option[Json] {
  match self {
    Json::Array(items) => {
      if index >= 0 && index < items.length() {
        Some(items[index])
      } else {
        None
      }
    }
    _ => None
  }
}

///| Evaluate an RFC 6901 JSON Pointer against `self`.
pub fn Json::pointer(self : Json, rfc6901_path : String) -> Result[Option[Json], JsonError] {
  pointer_eval(self, rfc6901_path)
}

///| Immutable object field update. Returns `Err(TypeMismatch)` if `self` is not `Json::Object`.
pub fn Json::set_field(self : Json, key : String, v : Json) -> Result[Json, JsonError] {
  match self {
    Json::Object(o) => Ok(Json::Object(o.set(key, v)))
    _ => Err(JsonError::new(JsonErrorKind::TypeMismatch, 1, 1, 0, "set_field requires Json::Object"))
  }
}

///| Immutable object key removal. Returns `Err(TypeMismatch)` if `self` is not `Json::Object`.
pub fn Json::without_keys(self : Json, keys : Array[String]) -> Result[Json, JsonError] {
  match self {
    Json::Object(o) => Ok(Json::Object(o.without_keys(keys)))
    _ => Err(JsonError::new(JsonErrorKind::TypeMismatch, 1, 1, 0, "without_keys requires Json::Object"))
  }
}

///| Immutable object merge. Returns `Err(TypeMismatch)` if either value is not `Json::Object`.
pub fn Json::merge_object(self : Json, other : Json) -> Result[Json, JsonError] {
  match (self, other) {
    (Json::Object(oa), Json::Object(ob)) => Ok(Json::Object(oa.merge(ob)))
    _ => Err(JsonError::new(JsonErrorKind::TypeMismatch, 1, 1, 0, "merge_object requires two Json::Object values"))
  }
}

///| Deep structural equality (iterative, stack-safe).
pub fn Json::eq(self : Json, other : Json) -> Bool {
  json_eq(self, other)
}
