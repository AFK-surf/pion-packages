///| Iterative RFC 8259 & RFC 8785 (JCS) serializers + iterative structural equality.
///| Zero recursion, zero module-level mutable state.

///| Single-pass RFC 8259 / RFC 8785 string escaper with strict UTF-8 validation.
///| Uses 4-byte ASCII unrolled scanning and zero-allocation `write_substring`.
///| Returns `false` if `s` contains any invalid UTF-8 byte sequence (lone surrogate,
///| overlong encoding, truncated sequence, > U+10FFFF, or stray continuation byte).
fn write_json_string(sb : StringBuilder, s : String) -> Bool {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut chunk_start = 0
  let mut i = 0
  while i < n {
    // 4-byte unrolled printable-ASCII fast scan
    while i + 4 <= n {
      let b0 = s.code_unit_at(i)
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b0 | b1 | b2 | b3) < 0x80 &&
      b0 >= 32 && b1 >= 32 && b2 >= 32 && b3 >= 32 &&
      b0 != 34 && b1 != 34 && b2 != 34 && b3 != 34 &&
      b0 != 92 && b1 != 92 && b2 != 92 && b3 != 92 {
        i = i + 4
        continue
      }
      break
    }
    if i >= n {
      break
    }
    let b = s.code_unit_at(i)
    if b < 0x80 {
      if b == 34 || b == 92 || b < 0x20 {
        if i > chunk_start {
          sb.write_substring(s, chunk_start, i)
        }
        if b == 34 {
          sb.write_string("\\\"")
        } else if b == 92 {
          sb.write_string("\\\\")
        } else if b == 8 {
          sb.write_string("\\b")
        } else if b == 12 {
          sb.write_string("\\f")
        } else if b == 10 {
          sb.write_string("\\n")
        } else if b == 13 {
          sb.write_string("\\r")
        } else if b == 9 {
          sb.write_string("\\t")
        } else {
          sb.write_string("\\u00")
          let hi = (b >> 4) & 0xF
          let lo = b & 0xF
          sb.write_byte((if hi < 10 { 48 + hi } else { 87 + hi }).to_byte())
          sb.write_byte((if lo < 10 { 48 + lo } else { 87 + lo }).to_byte())
        }
        i = i + 1
        chunk_start = i
      } else {
        i = i + 1
      }
    } else if b >= 0xC2 && b <= 0xDF {
      if i + 1 >= n || (s.code_unit_at(i + 1) & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b >= 0xE0 && b <= 0xEF {
      if i + 2 >= n {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b >= 0xF0 && b <= 0xF4 {
      if i + 3 >= n {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b == 0xF0 && b1 < 0x90 {
        return false
      }
      if b == 0xF4 && b1 > 0x8F {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  if n > chunk_start {
    sb.write_substring(s, chunk_start, n)
  }
  sb.write_byte((34).to_byte())
  true
}

fn write_indent(sb : StringBuilder, spaces : Int) -> Unit {
  let mut rem = spaces
  while rem >= 8 {
    sb.write_string("        ")
    rem = rem - 8
  }
  while rem > 0 {
    sb.write_byte((32).to_byte())
    rem = rem - 1
  }
}

///| Fast, bounds-safe comparison of two strings in RFC 8785 §3.2.3 UTF-16 code unit order.
///| For valid UTF-8, UTF-16 code unit order equals UTF-8 byte order everywhere except when
///| the first differing byte pits a BMP U+E000..U+FFFF lead (`0xEE..0xEF`) against a
///| supplementary U+10000..U+10FFFF lead (`0xF0..0xF4`, UTF-16 high surrogate `0xD800..0xDBFF`).
///| Never reads past `min(a.length(), b.length())`, so non-UTF-8 inputs cannot panic.
fn cmp_utf16_code_units(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let lim = if na < nb { na } else { nb }
  let mut i = 0
  while i < lim {
    let ba = a.code_unit_at(i)
    let bb = b.code_unit_at(i)
    if ba != bb {
      if ba >= 0xEE && bb >= 0xEE {
        if ba <= 0xEF && bb >= 0xF0 && bb <= 0xF4 {
          return 1
        }
        if bb <= 0xEF && ba >= 0xF0 && ba <= 0xF4 {
          return -1
        }
      }
      return ba - bb
    }
    i = i + 1
  }
  na - nb
}

///| Hybrid iterative merge sort (insertion sort for runs of 16, then bottom-up merge)
///| of object entries by RFC 8785 UTF-16 code units.
///| Sorts an index array `FixedArray[Int]` over extracted keys so swaps/merges incur
///| zero `(String, Json)` tuple copies or reference-count traffic.
fn sort_entries_utf16(entries : Array[(String, Json)]) -> Array[(String, Json)] {
  let n = entries.length()
  if n <= 1 {
    return entries
  }
  let keys : FixedArray[String] = FixedArray::make(n, "")
  let mut src : FixedArray[Int] = FixedArray::make(n, 0)
  let mut dst : FixedArray[Int] = FixedArray::make(n, 0)
  let mut i = 0
  while i < n {
    let (k, _) = entries[i]
    keys[i] = k
    src[i] = i
    i = i + 1
  }
  // Insertion sort small runs of width 16 to skip 4 full-array merge passes.
  let run_size = 16
  let mut start = 0
  while start < n {
    let end = if start + run_size < n { start + run_size } else { n }
    let mut k = start + 1
    while k < end {
      let cur_idx = src[k]
      let ck = keys[cur_idx]
      let mut j = k - 1
      while j >= start {
        let j_idx = src[j]
        if cmp_utf16_code_units(keys[j_idx], ck) > 0 {
          src[j + 1] = j_idx
          j = j - 1
        } else {
          break
        }
      }
      src[j + 1] = cur_idx
      k = k + 1
    }
    start = end
  }

  let mut width = run_size
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + 2 * width < n { left + 2 * width } else { n }
      if mid >= right {
        let mut p = left
        while p < mid {
          dst[p] = src[p]
          p = p + 1
        }
      } else {
        let mut p = left
        let mut q = mid
        let mut out = left
        while p < mid && q < right {
          let ip = src[p]
          let iq = src[q]
          if cmp_utf16_code_units(keys[ip], keys[iq]) <= 0 {
            dst[out] = ip
            p = p + 1
          } else {
            dst[out] = iq
            q = q + 1
          }
          out = out + 1
        }
        while p < mid {
          dst[out] = src[p]
          p = p + 1
          out = out + 1
        }
        while q < right {
          dst[out] = src[q]
          q = q + 1
          out = out + 1
        }
      }
      left = left + 2 * width
    }
    let tmp = src
    src = dst
    dst = tmp
    width = width * 2
  }
  let ordered : Array[(String, Json)] = Array::with_capacity(n)
  i = 0
  while i < n {
    ordered.push(entries[src[i]])
    i = i + 1
  }
  ordered
}

struct SerFrame {
  is_obj : Bool
  arr : Array[Json]
  obj : Array[(String, Json)]
  mut idx : Int
  depth : Int
}

fn write_i64(sb : StringBuilder, v : Int64, digit_buf : FixedArray[Byte]) -> Unit {
  if v == 0L {
    sb.write_byte((48).to_byte())
    return
  }
  let mut u : UInt64 = if v < 0L {
    sb.write_byte((45).to_byte())
    0UL - v.reinterpret_as_uint64()
  } else {
    v.reinterpret_as_uint64()
  }
  let mut n = 0
  while u >= 10UL {
    let q = u / 10UL
    let r = (u - q * 10UL).to_int()
    digit_buf[n] = (48 + r).to_byte()
    n = n + 1
    u = q
  }
  digit_buf[n] = (48 + u.to_int()).to_byte()
  let mut i = n
  while i >= 0 {
    sb.write_byte(digit_buf[i])
    i = i - 1
  }
}

///| Write a single `Json` value inline if primitive/empty, or push a `SerFrame` onto `stack`
///| if it is a non-empty Array/Object. Returns `None` on success or `Some(JsonError)` on error.
fn ser_emit_val(
  sb : StringBuilder,
  digit_buf : FixedArray[Byte],
  v : Json,
  depth : Int,
  canonical : Bool,
  stack : Array[SerFrame],
  empty_arr : Array[Json],
  empty_obj : Array[(String, Json)],
) -> Option[JsonError] {
  match v {
    Json::Null => {
      sb.write_string("null")
      None
    }
    Json::Bool(b) => {
      sb.write_string(if b { "true" } else { "false" })
      None
    }
    Json::Int(n) => {
      if canonical && (n < -9007199254740991L || n > 9007199254740991L) {
        let _ = write_json_float(sb, n.to_double(), digit_buf, true)
      } else {
        write_i64(sb, n, digit_buf)
      }
      None
    }
    Json::Float(x) => {
      if !write_json_float(sb, x, digit_buf, canonical) {
        Some(
          JsonError::new(
            JsonErrorKind::NonFiniteNumber,
            1,
            1,
            0,
            "non-finite number (NaN/Infinity) cannot be serialized to JSON",
          ),
        )
      } else {
        None
      }
    }
    Json::BigNum(r) => {
      if !is_valid_json_number(r) {
        return Some(
          JsonError::new(
            JsonErrorKind::InvalidNumber,
            1,
            1,
            0,
            "invalid BigNum JSON number literal",
          ),
        )
      }
      if canonical {
        match parse_raw_as_f64(r) {
          Some(d) => {
            if !write_json_float(sb, d, digit_buf, true) {
              return Some(
                JsonError::new(
                  JsonErrorKind::NonFiniteNumber,
                  1,
                  1,
                  0,
                  "non-finite BigNum cannot be serialized in RFC 8785 canonical JSON",
                ),
              )
            }
          }
          None => {
            return Some(
              JsonError::new(
                JsonErrorKind::NonFiniteNumber,
                1,
                1,
                0,
                "non-finite BigNum cannot be serialized in RFC 8785 canonical JSON",
              ),
            )
          }
        }
      } else {
        sb.write_string(r)
      }
      None
    }
    Json::Str(s) => {
      if !write_json_string(sb, s) {
        Some(
          JsonError::new(
            JsonErrorKind::InvalidUnicode,
            1,
            1,
            0,
            "invalid UTF-8 sequence in JSON string",
          ),
        )
      } else {
        None
      }
    }
    Json::Array(items) => {
      if items.length() == 0 {
        sb.write_string("[]")
      } else {
        sb.write_byte((91).to_byte())
        stack.push(
          SerFrame::{
            is_obj: false,
            arr: items,
            obj: empty_obj,
            idx: 0,
            depth: depth,
          },
        )
      }
      None
    }
    Json::Object(obj) => {
      let entries = obj.entries
      if entries.length() == 0 {
        sb.write_string("{}")
      } else {
        let ordered = if canonical { sort_entries_utf16(entries) } else { entries }
        sb.write_byte((123).to_byte())
        stack.push(
          SerFrame::{
            is_obj: true,
            arr: empty_arr,
            obj: ordered,
            idx: 0,
            depth: depth,
          },
        )
      }
      None
    }
  }
}

fn serialize_impl(root : Json, indent : Int, canonical : Bool) -> Result[String, JsonError] {
  let init_cap = match root {
    Json::Object(o) => {
      let est = o.entries.length() * 32
      if est < 256 { 256 } else if est > 4194304 { 4194304 } else { est }
    }
    Json::Array(a) => {
      let est = a.length() * 32
      if est < 256 { 256 } else if est > 4194304 { 4194304 } else { est }
    }
    Json::Str(s) => s.length() + 16
    _ => 64
  }
  let sb = StringBuilder::with_capacity(init_cap)
  let digit_buf : FixedArray[Byte] = FixedArray::make(24, (0).to_byte())
  let pretty = !canonical && indent > 0
  let stack : Array[SerFrame] = Array::with_capacity(16)
  let empty_arr : Array[Json] = []
  let empty_obj : Array[(String, Json)] = []

  match ser_emit_val(sb, digit_buf, root, 0, canonical, stack, empty_arr, empty_obj) {
    Some(e) => return Err(e)
    None => ()
  }

  while stack.length() > 0 {
    let top = stack[stack.length() - 1]
    if !top.is_obj {
      let items = top.arr
      let len = items.length()
      let child_depth = top.depth + 1
      let mut pushed = false
      while top.idx < len {
        let idx = top.idx
        top.idx = idx + 1
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, child_depth * indent)
        }
        let prev_depth = stack.length()
        match ser_emit_val(sb, digit_buf, items[idx], child_depth, canonical, stack, empty_arr, empty_obj) {
          Some(e) => return Err(e)
          None => ()
        }
        if stack.length() > prev_depth {
          pushed = true
          break
        }
      }
      if !pushed {
        let _ = stack.pop()
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, top.depth * indent)
        }
        sb.write_byte((93).to_byte())
      }
    } else {
      let entries = top.obj
      let len = entries.length()
      let child_depth = top.depth + 1
      let mut pushed = false
      while top.idx < len {
        let idx = top.idx
        top.idx = idx + 1
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, child_depth * indent)
        }
        let (k, v) = entries[idx]
        if !write_json_string(sb, k) {
          return Err(
            JsonError::new(
              JsonErrorKind::InvalidUnicode,
              1,
              1,
              0,
              "invalid UTF-8 sequence in JSON object key",
            ),
          )
        }
        if pretty {
          sb.write_string(": ")
        } else {
          sb.write_byte((58).to_byte())
        }
        let prev_depth = stack.length()
        match ser_emit_val(sb, digit_buf, v, child_depth, canonical, stack, empty_arr, empty_obj) {
          Some(e) => return Err(e)
          None => ()
        }
        if stack.length() > prev_depth {
          pushed = true
          break
        }
      }
      if !pushed {
        let _ = stack.pop()
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, top.depth * indent)
        }
        sb.write_byte((125).to_byte())
      }
    }
  }
  Ok(sb.to_string())
}

///| Iterative deep structural equality (stack-safe for arbitrary nesting,
///| object-key-order independent per RFC 8259 §4).
fn json_eq_impl(a : Json, b : Json) -> Bool {
  let stack : Array[(Json, Json)] = [(a, b)]
  while stack.length() > 0 {
    let (x, y) = match stack.pop() {
      Some(p) => p
      None => break
    }
    match (x, y) {
      (Json::Null, Json::Null) => ()
      (Json::Bool(ba), Json::Bool(bb)) => {
        if ba != bb {
          return false
        }
      }
      (Json::Int(ia), Json::Int(ib)) => {
        if ia != ib {
          return false
        }
      }
      (Json::Float(fa), Json::Float(fb)) => {
        if fa.reinterpret_as_uint64() != fb.reinterpret_as_uint64() {
          return false
        }
      }
      (Json::BigNum(ra), Json::BigNum(rb)) => {
        if ra != rb {
          return false
        }
      }
      (Json::Str(sa), Json::Str(sb)) => {
        if sa != sb {
          return false
        }
      }
      (Json::Array(aa), Json::Array(ab)) => {
        let na = aa.length()
        if na != ab.length() {
          return false
        }
        let mut i = 0
        while i < na {
          stack.push((aa[i], ab[i]))
          i = i + 1
        }
      }
      (Json::Object(oa), Json::Object(ob)) => {
        let ea = oa.entries
        let eb = ob.entries
        let na = ea.length()
        if na != eb.length() {
          return false
        }
        let mut i = 0
        while i < na {
          let (ka, va) = ea[i]
          let (kb, vb) = eb[i]
          if ka == kb {
            stack.push((va, vb))
          } else {
            match ob.get(ka) {
              Some(vb2) => stack.push((va, vb2))
              None => return false
            }
          }
          i = i + 1
        }
      }
      _ => return false
    }
  }
  true
}
