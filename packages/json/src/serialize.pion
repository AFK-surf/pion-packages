///| Iterative RFC 8259 & RFC 8785 (JCS) serializers + iterative structural equality.
///| Zero recursion, zero module-level mutable state.

let hex_digits_lower : FixedArray[Byte] = [
  (48).to_byte(), (49).to_byte(), (50).to_byte(), (51).to_byte(),
  (52).to_byte(), (53).to_byte(), (54).to_byte(), (55).to_byte(),
  (56).to_byte(), (57).to_byte(), (97).to_byte(), (98).to_byte(),
  (99).to_byte(), (100).to_byte(), (101).to_byte(), (102).to_byte(),
]

///| Single-pass zero-unnecessary-copy RFC 8259 / RFC 8785 string escaper.
fn write_json_string(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut chunk_start = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 34 || b == 92 || b < 0x20 {
      if i > chunk_start {
        sb.write_string(s.slice(chunk_start, i))
      }
      if b == 34 {
        sb.write_string("\\\"")
      } else if b == 92 {
        sb.write_string("\\\\")
      } else if b == 8 {
        sb.write_string("\\b")
      } else if b == 12 {
        sb.write_string("\\f")
      } else if b == 10 {
        sb.write_string("\\n")
      } else if b == 13 {
        sb.write_string("\\r")
      } else if b == 9 {
        sb.write_string("\\t")
      } else {
        sb.write_string("\\u00")
        sb.write_byte(hex_digits_lower[(b >> 4) & 0xF])
        sb.write_byte(hex_digits_lower[b & 0xF])
      }
      i = i + 1
      chunk_start = i
    } else {
      i = i + 1
    }
  }
  if n > chunk_start {
    sb.write_string(s.slice(chunk_start, n))
  }
  sb.write_byte((34).to_byte())
}

fn write_indent(sb : StringBuilder, spaces : Int) -> Unit {
  let mut i = 0
  while i < spaces {
    sb.write_byte((32).to_byte())
    i = i + 1
  }
}

///| Decode next UTF-8 code point at `pos` in validated UTF-8 string `s`.
fn next_utf8_cp(s : String, pos : Int) -> (Int, Int) {
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    (b0, 1)
  } else if b0 < 0xE0 {
    let b1 = s.code_unit_at(pos + 1)
    (((b0 & 0x1F) << 6) | (b1 & 0x3F), 2)
  } else if b0 < 0xF0 {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), 3)
  } else {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F), 4)
  }
}

///| Compare two UTF-8 strings by RFC 8785 §3.2.3 UTF-16 code unit lexicographical order.
///| Returns < 0 if a < b, 0 if a == b, > 0 if a > b.
fn cmp_utf16_code_units(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let mut ia = 0
  let mut ib = 0
  // Fast ASCII prefix loop
  while ia < na && ib < nb {
    let ba = a.code_unit_at(ia)
    let bb = b.code_unit_at(ib)
    if ba < 0x80 && bb < 0x80 {
      if ba != bb {
        return ba - bb
      }
      ia = ia + 1
      ib = ib + 1
    } else {
      break
    }
  }
  // General UTF-16 code unit comparison (supplementary planes split into surrogate pairs)
  let mut pend_a = -1
  let mut pend_b = -1
  while true {
    let cu_a = if pend_a >= 0 {
      let c = pend_a
      pend_a = -1
      c
    } else if ia < na {
      let (cp, step) = next_utf8_cp(a, ia)
      ia = ia + step
      if cp <= 0xFFFF {
        cp
      } else {
        let u = cp - 0x10000
        pend_a = 0xDC00 + (u & 0x3FF)
        0xD800 + (u >> 10)
      }
    } else {
      -1
    }

    let cu_b = if pend_b >= 0 {
      let c = pend_b
      pend_b = -1
      c
    } else if ib < nb {
      let (cp, step) = next_utf8_cp(b, ib)
      ib = ib + step
      if cp <= 0xFFFF {
        cp
      } else {
        let u = cp - 0x10000
        pend_b = 0xDC00 + (u & 0x3FF)
        0xD800 + (u >> 10)
      }
    } else {
      -1
    }

    if cu_a != cu_b {
      return cu_a - cu_b
    }
    if cu_a < 0 {
      return 0
    }
  }
  0
}

///| Bottom-up iterative merge sort of object entries by RFC 8785 UTF-16 code units.
fn sort_entries_utf16(entries : Array[(String, Json)]) -> Array[(String, Json)] {
  let n = entries.length()
  if n <= 1 {
    return entries
  }
  let mut src : Array[(String, Json)] = []
  let mut i = 0
  while i < n {
    src.push(entries[i])
    i = i + 1
  }
  let mut dst : Array[(String, Json)] = []
  i = 0
  while i < n {
    dst.push(entries[i])
    i = i + 1
  }
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + 2 * width < n { left + 2 * width } else { n }
      let mut p = left
      let mut q = mid
      let mut out = left
      while p < mid && q < right {
        let (kp, _) = src[p]
        let (kq, _) = src[q]
        if cmp_utf16_code_units(kp, kq) <= 0 {
          dst[out] = src[p]
          p = p + 1
        } else {
          dst[out] = src[q]
          q = q + 1
        }
        out = out + 1
      }
      while p < mid {
        dst[out] = src[p]
        p = p + 1
        out = out + 1
      }
      while q < right {
        dst[out] = src[q]
        q = q + 1
        out = out + 1
      }
      left = left + 2 * width
    }
    let tmp = src
    src = dst
    dst = tmp
    width = width * 2
  }
  src
}

enum SerTask {
  Val(Json, Int)
  ArrNext(Array[Json], Int, Int)
  ObjNext(Array[(String, Json)], Int, Int)
  CloseArr(Int)
  CloseObj(Int)
}

fn serialize_impl(root : Json, indent : Int, canonical : Bool) -> Result[String, JsonError] {
  let sb = StringBuilder::new()
  let digit_buf : FixedArray[Byte] = FixedArray::make(24, (0).to_byte())
  let pretty = !canonical && indent > 0
  let stack : Array[SerTask] = [SerTask::Val(root, 0)]

  while stack.length() > 0 {
    let task = match stack.pop() {
      Some(t) => t
      None => break
    }
    match task {
      SerTask::Val(v, depth) => {
        match v {
          Json::Null => sb.write_string("null")
          Json::Bool(b) => sb.write_string(if b { "true" } else { "false" })
          Json::Int(n) => sb.write_string(n.to_string())
          Json::Float(x) => {
            if !write_json_float(sb, x, digit_buf, canonical) {
              return Err(
                JsonError::new(
                  JsonErrorKind::NonFiniteNumber,
                  1,
                  1,
                  0,
                  "non-finite number (NaN/Infinity) cannot be serialized to JSON",
                ),
              )
            }
          }
          Json::BigNum(r) => sb.write_string(r)
          Json::Str(s) => write_json_string(sb, s)
          Json::Array(items) => {
            if items.length() == 0 {
              sb.write_string("[]")
            } else {
              sb.write_byte((91).to_byte())
              stack.push(SerTask::CloseArr(depth))
              stack.push(SerTask::ArrNext(items, 0, depth + 1))
            }
          }
          Json::Object(obj) => {
            let entries = obj.entries
            if entries.length() == 0 {
              sb.write_string("{}")
            } else {
              let ordered = if canonical { sort_entries_utf16(entries) } else { entries }
              sb.write_byte((123).to_byte())
              stack.push(SerTask::CloseObj(depth))
              stack.push(SerTask::ObjNext(ordered, 0, depth + 1))
            }
          }
        }
      }
      SerTask::ArrNext(items, idx, child_depth) => {
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, child_depth * indent)
        }
        if idx + 1 < items.length() {
          stack.push(SerTask::ArrNext(items, idx + 1, child_depth))
        }
        stack.push(SerTask::Val(items[idx], child_depth))
      }
      SerTask::ObjNext(entries, idx, child_depth) => {
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, child_depth * indent)
        }
        let (k, v) = entries[idx]
        write_json_string(sb, k)
        if pretty {
          sb.write_string(": ")
        } else {
          sb.write_byte((58).to_byte())
        }
        if idx + 1 < entries.length() {
          stack.push(SerTask::ObjNext(entries, idx + 1, child_depth))
        }
        stack.push(SerTask::Val(v, child_depth))
      }
      SerTask::CloseArr(depth) => {
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, depth * indent)
        }
        sb.write_byte((93).to_byte())
      }
      SerTask::CloseObj(depth) => {
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, depth * indent)
        }
        sb.write_byte((125).to_byte())
      }
    }
  }
  Ok(sb.to_string())
}

///| Iterative deep structural equality (stack-safe for arbitrary nesting).
fn json_eq_impl(a : Json, b : Json) -> Bool {
  let stack : Array[(Json, Json)] = [(a, b)]
  while stack.length() > 0 {
    let (x, y) = match stack.pop() {
      Some(p) => p
      None => break
    }
    match (x, y) {
      (Json::Null, Json::Null) => ()
      (Json::Bool(ba), Json::Bool(bb)) => {
        if ba != bb {
          return false
        }
      }
      (Json::Int(ia), Json::Int(ib)) => {
        if ia != ib {
          return false
        }
      }
      (Json::Float(fa), Json::Float(fb)) => {
        if fa.reinterpret_as_uint64() != fb.reinterpret_as_uint64() {
          return false
        }
      }
      (Json::BigNum(ra), Json::BigNum(rb)) => {
        if ra != rb {
          return false
        }
      }
      (Json::Str(sa), Json::Str(sb)) => {
        if sa != sb {
          return false
        }
      }
      (Json::Array(aa), Json::Array(ab)) => {
        let na = aa.length()
        if na != ab.length() {
          return false
        }
        let mut i = 0
        while i < na {
          stack.push((aa[i], ab[i]))
          i = i + 1
        }
      }
      (Json::Object(oa), Json::Object(ob)) => {
        let ea = oa.entries
        let eb = ob.entries
        let na = ea.length()
        if na != eb.length() {
          return false
        }
        let mut i = 0
        while i < na {
          let (ka, va) = ea[i]
          let (kb, vb) = eb[i]
          if ka != kb {
            return false
          }
          stack.push((va, vb))
          i = i + 1
        }
      }
      _ => return false
    }
  }
  true
}
