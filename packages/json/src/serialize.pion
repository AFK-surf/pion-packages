///| Iterative RFC 8259 & RFC 8785 (JCS) serializers + iterative structural equality.
///| Zero recursion, zero module-level mutable state.

let hex_digits_lower : FixedArray[Byte] = [
  (48).to_byte(), (49).to_byte(), (50).to_byte(), (51).to_byte(),
  (52).to_byte(), (53).to_byte(), (54).to_byte(), (55).to_byte(),
  (56).to_byte(), (57).to_byte(), (97).to_byte(), (98).to_byte(),
  (99).to_byte(), (100).to_byte(), (101).to_byte(), (102).to_byte(),
]

///| Single-pass RFC 8259 / RFC 8785 string escaper with strict UTF-8 validation.
///| Returns `false` if `s` contains any invalid UTF-8 byte sequence (lone surrogate,
///| overlong encoding, truncated sequence, > U+10FFFF, or stray continuation byte).
fn write_json_string(sb : StringBuilder, s : String) -> Bool {
  sb.write_byte((34).to_byte())
  let n = s.length()
  let mut chunk_start = 0
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b < 0x80 {
      if b == 34 || b == 92 || b < 0x20 {
        if i > chunk_start {
          sb.write_string(s.slice(chunk_start, i))
        }
        if b == 34 {
          sb.write_string("\\\"")
        } else if b == 92 {
          sb.write_string("\\\\")
        } else if b == 8 {
          sb.write_string("\\b")
        } else if b == 12 {
          sb.write_string("\\f")
        } else if b == 10 {
          sb.write_string("\\n")
        } else if b == 13 {
          sb.write_string("\\r")
        } else if b == 9 {
          sb.write_string("\\t")
        } else {
          sb.write_string("\\u00")
          sb.write_byte(hex_digits_lower[(b >> 4) & 0xF])
          sb.write_byte(hex_digits_lower[b & 0xF])
        }
        i = i + 1
        chunk_start = i
      } else {
        i = i + 1
      }
    } else if b >= 0xC2 && b <= 0xDF {
      if i + 1 >= n || (s.code_unit_at(i + 1) & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b >= 0xE0 && b <= 0xEF {
      if i + 2 >= n {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b >= 0xF0 && b <= 0xF4 {
      if i + 3 >= n {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b == 0xF0 && b1 < 0x90 {
        return false
      }
      if b == 0xF4 && b1 > 0x8F {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  if n > chunk_start {
    sb.write_string(s.slice(chunk_start, n))
  }
  sb.write_byte((34).to_byte())
  true
}

fn write_indent(sb : StringBuilder, spaces : Int) -> Unit {
  let mut i = 0
  while i < spaces {
    sb.write_byte((32).to_byte())
    i = i + 1
  }
}

///| Fast, bounds-safe comparison of two strings in RFC 8785 §3.2.3 UTF-16 code unit order.
///| For valid UTF-8, UTF-16 code unit order equals UTF-8 byte order everywhere except when
///| the first differing byte pits a BMP U+E000..U+FFFF lead (`0xEE..0xEF`) against a
///| supplementary U+10000..U+10FFFF lead (`0xF0..0xF4`, UTF-16 high surrogate `0xD800..0xDBFF`).
///| Never reads past `min(a.length(), b.length())`, so non-UTF-8 inputs cannot panic.
fn cmp_utf16_code_units(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let lim = if na < nb { na } else { nb }
  let mut i = 0
  while i < lim {
    let ba = a.code_unit_at(i)
    let bb = b.code_unit_at(i)
    if ba != bb {
      if ba >= 0xEE && bb >= 0xEE {
        if ba <= 0xEF && bb >= 0xF0 && bb <= 0xF4 {
          return 1
        }
        if bb <= 0xEF && ba >= 0xF0 && ba <= 0xF4 {
          return -1
        }
      }
      return ba - bb
    }
    i = i + 1
  }
  na - nb
}

///| Bottom-up iterative merge sort of object entries by RFC 8785 UTF-16 code units.
fn sort_entries_utf16(entries : Array[(String, Json)]) -> Array[(String, Json)] {
  let n = entries.length()
  if n <= 1 {
    return entries
  }
  let mut src : Array[(String, Json)] = []
  let mut i = 0
  while i < n {
    src.push(entries[i])
    i = i + 1
  }
  let mut dst : Array[(String, Json)] = []
  i = 0
  while i < n {
    dst.push(entries[i])
    i = i + 1
  }
  let mut width = 1
  while width < n {
    let mut left = 0
    while left < n {
      let mid = if left + width < n { left + width } else { n }
      let right = if left + 2 * width < n { left + 2 * width } else { n }
      let mut p = left
      let mut q = mid
      let mut out = left
      while p < mid && q < right {
        let (kp, _) = src[p]
        let (kq, _) = src[q]
        if cmp_utf16_code_units(kp, kq) <= 0 {
          dst[out] = src[p]
          p = p + 1
        } else {
          dst[out] = src[q]
          q = q + 1
        }
        out = out + 1
      }
      while p < mid {
        dst[out] = src[p]
        p = p + 1
        out = out + 1
      }
      while q < right {
        dst[out] = src[q]
        q = q + 1
        out = out + 1
      }
      left = left + 2 * width
    }
    let tmp = src
    src = dst
    dst = tmp
    width = width * 2
  }
  src
}

enum SerTask {
  Val(Json, Int)
  ArrNext(Array[Json], Int, Int)
  ObjNext(Array[(String, Json)], Int, Int)
  CloseArr(Int)
  CloseObj(Int)
}

fn write_i64(sb : StringBuilder, v : Int64, digit_buf : FixedArray[Byte]) -> Unit {
  if v == 0L {
    sb.write_byte((48).to_byte())
    return
  }
  let mut u : UInt64 = if v < 0L {
    sb.write_byte((45).to_byte())
    0UL - v.reinterpret_as_uint64()
  } else {
    v.reinterpret_as_uint64()
  }
  let mut n = 0
  while u >= 10UL {
    let q = u / 10UL
    let r = (u - q * 10UL).to_int()
    digit_buf[n] = (48 + r).to_byte()
    n = n + 1
    u = q
  }
  digit_buf[n] = (48 + u.to_int()).to_byte()
  let mut i = n
  while i >= 0 {
    sb.write_byte(digit_buf[i])
    i = i - 1
  }
}

fn serialize_impl(root : Json, indent : Int, canonical : Bool) -> Result[String, JsonError] {
  let sb = StringBuilder::new()
  let digit_buf : FixedArray[Byte] = FixedArray::make(24, (0).to_byte())
  let pretty = !canonical && indent > 0
  let stack : Array[SerTask] = [SerTask::Val(root, 0)]

  while stack.length() > 0 {
    let task = match stack.pop() {
      Some(t) => t
      None => break
    }
    match task {
      SerTask::Val(v, depth) => {
        match v {
          Json::Null => sb.write_string("null")
          Json::Bool(b) => sb.write_string(if b { "true" } else { "false" })
          Json::Int(n) => {
            if canonical && (n < -9007199254740991L || n > 9007199254740991L) {
              let _ = write_json_float(sb, n.to_double(), digit_buf, true)
            } else {
              write_i64(sb, n, digit_buf)
            }
          }
          Json::Float(x) => {
            if !write_json_float(sb, x, digit_buf, canonical) {
              return Err(
                JsonError::new(
                  JsonErrorKind::NonFiniteNumber,
                  1,
                  1,
                  0,
                  "non-finite number (NaN/Infinity) cannot be serialized to JSON",
                ),
              )
            }
          }
          Json::BigNum(r) => {
            if !is_valid_json_number(r) {
              return Err(
                JsonError::new(
                  JsonErrorKind::InvalidNumber,
                  1,
                  1,
                  0,
                  "invalid BigNum JSON number literal",
                ),
              )
            }
            if canonical {
              match parse_raw_as_f64(r) {
                Some(d) => {
                  if !write_json_float(sb, d, digit_buf, true) {
                    return Err(
                      JsonError::new(
                        JsonErrorKind::NonFiniteNumber,
                        1,
                        1,
                        0,
                        "non-finite BigNum cannot be serialized in RFC 8785 canonical JSON",
                      ),
                    )
                  }
                }
                None => {
                  return Err(
                    JsonError::new(
                      JsonErrorKind::NonFiniteNumber,
                      1,
                      1,
                      0,
                      "non-finite BigNum cannot be serialized in RFC 8785 canonical JSON",
                    ),
                  )
                }
              }
            } else {
              sb.write_string(r)
            }
          }
          Json::Str(s) => {
            if !write_json_string(sb, s) {
              return Err(
                JsonError::new(
                  JsonErrorKind::InvalidUnicode,
                  1,
                  1,
                  0,
                  "invalid UTF-8 sequence in JSON string",
                ),
              )
            }
          }
          Json::Array(items) => {
            if items.length() == 0 {
              sb.write_string("[]")
            } else {
              sb.write_byte((91).to_byte())
              stack.push(SerTask::CloseArr(depth))
              stack.push(SerTask::ArrNext(items, 0, depth + 1))
            }
          }
          Json::Object(obj) => {
            let entries = obj.entries
            if entries.length() == 0 {
              sb.write_string("{}")
            } else {
              let ordered = if canonical { sort_entries_utf16(entries) } else { entries }
              sb.write_byte((123).to_byte())
              stack.push(SerTask::CloseObj(depth))
              stack.push(SerTask::ObjNext(ordered, 0, depth + 1))
            }
          }
        }
      }
      SerTask::ArrNext(items, idx, child_depth) => {
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, child_depth * indent)
        }
        if idx + 1 < items.length() {
          stack.push(SerTask::ArrNext(items, idx + 1, child_depth))
        }
        stack.push(SerTask::Val(items[idx], child_depth))
      }
      SerTask::ObjNext(entries, idx, child_depth) => {
        if idx > 0 {
          sb.write_byte((44).to_byte())
        }
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, child_depth * indent)
        }
        let (k, v) = entries[idx]
        if !write_json_string(sb, k) {
          return Err(
            JsonError::new(
              JsonErrorKind::InvalidUnicode,
              1,
              1,
              0,
              "invalid UTF-8 sequence in JSON object key",
            ),
          )
        }
        if pretty {
          sb.write_string(": ")
        } else {
          sb.write_byte((58).to_byte())
        }
        if idx + 1 < entries.length() {
          stack.push(SerTask::ObjNext(entries, idx + 1, child_depth))
        }
        stack.push(SerTask::Val(v, child_depth))
      }
      SerTask::CloseArr(depth) => {
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, depth * indent)
        }
        sb.write_byte((93).to_byte())
      }
      SerTask::CloseObj(depth) => {
        if pretty {
          sb.write_byte((10).to_byte())
          write_indent(sb, depth * indent)
        }
        sb.write_byte((125).to_byte())
      }
    }
  }
  Ok(sb.to_string())
}

///| Iterative deep structural equality (stack-safe for arbitrary nesting,
///| object-key-order independent per RFC 8259 §4).
fn json_eq_impl(a : Json, b : Json) -> Bool {
  let stack : Array[(Json, Json)] = [(a, b)]
  while stack.length() > 0 {
    let (x, y) = match stack.pop() {
      Some(p) => p
      None => break
    }
    match (x, y) {
      (Json::Null, Json::Null) => ()
      (Json::Bool(ba), Json::Bool(bb)) => {
        if ba != bb {
          return false
        }
      }
      (Json::Int(ia), Json::Int(ib)) => {
        if ia != ib {
          return false
        }
      }
      (Json::Float(fa), Json::Float(fb)) => {
        if fa.reinterpret_as_uint64() != fb.reinterpret_as_uint64() {
          return false
        }
      }
      (Json::BigNum(ra), Json::BigNum(rb)) => {
        if ra != rb {
          return false
        }
      }
      (Json::Str(sa), Json::Str(sb)) => {
        if sa != sb {
          return false
        }
      }
      (Json::Array(aa), Json::Array(ab)) => {
        let na = aa.length()
        if na != ab.length() {
          return false
        }
        let mut i = 0
        while i < na {
          stack.push((aa[i], ab[i]))
          i = i + 1
        }
      }
      (Json::Object(oa), Json::Object(ob)) => {
        let ea = oa.entries
        let eb = ob.entries
        let na = ea.length()
        if na != eb.length() {
          return false
        }
        let mut i = 0
        while i < na {
          let (ka, va) = ea[i]
          let (kb, vb) = eb[i]
          if ka == kb {
            stack.push((va, vb))
          } else {
            match ob.get(ka) {
              Some(vb2) => stack.push((va, vb2))
              None => return false
            }
          }
          i = i + 1
        }
      }
      _ => return false
    }
  }
  true
}
