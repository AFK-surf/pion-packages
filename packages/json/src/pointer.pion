///| RFC 6901 JSON Pointer evaluator.

fn pointer_unescape_token(token : String) -> Result[String, JsonError] {
  let n = token.length()
  let mut has_tilde = false
  let mut i = 0
  while i < n {
    if token.code_unit_at(i) == 126 {
      has_tilde = true
      break
    }
    i = i + 1
  }
  if !has_tilde {
    return Ok(token)
  }
  let sb = StringBuilder::new()
  let mut chunk_start = 0
  i = 0
  while i < n {
    if token.code_unit_at(i) == 126 {
      if i + 1 >= n {
        return Err(
          JsonError::new(
            JsonErrorKind::InvalidPointer,
            1,
            i + 1,
            i,
            "dangling '~' in JSON Pointer",
          ),
        )
      }
      let next = token.code_unit_at(i + 1)
      if i > chunk_start {
        sb.write_string(token.slice(chunk_start, i))
      }
      if next == 48 {
        sb.write_byte((126).to_byte())
      } else if next == 49 {
        sb.write_byte((47).to_byte())
      } else {
        return Err(
          JsonError::new(
            JsonErrorKind::InvalidPointer,
            1,
            i + 1,
            i,
            "invalid escape sequence in JSON Pointer (expected ~0 or ~1)",
          ),
        )
      }
      i = i + 2
      chunk_start = i
    } else {
      i = i + 1
    }
  }
  if n > chunk_start {
    sb.write_string(token.slice(chunk_start, n))
  }
  Ok(sb.to_string())
}

///| Parse strict RFC 6901 array index ("0" or [1-9][0-9]*).
fn pointer_parse_array_index(token : String) -> Option[Int] {
  let n = token.length()
  if n == 0 || n > 10 {
    return None
  }
  let b0 = token.code_unit_at(0)
  if b0 == 48 {
    if n == 1 {
      return Some(0)
    }
    return None
  }
  if b0 < 49 || b0 > 57 {
    return None
  }
  let mut acc : Int64 = (b0 - 48).to_int64()
  let mut i = 1
  while i < n {
    let b = token.code_unit_at(i)
    if b < 48 || b > 57 {
      return None
    }
    acc = acc * 10L + (b - 48).to_int64()
    if acc > 2147483646L {
      return None
    }
    i = i + 1
  }
  Some(acc.to_int())
}

///| Resolve an RFC 6901 JSON Pointer string against `doc`.
fn pointer_eval(doc : Json, path : String) -> Result[Option[Json], JsonError] {
  let n = path.length()
  if n == 0 {
    return Ok(Some(doc))
  }
  if path.code_unit_at(0) != 47 {
    return Err(
      JsonError::new(
        JsonErrorKind::InvalidPointer,
        1,
        1,
        0,
        "JSON Pointer must be empty or start with '/'",
      ),
    )
  }
  // Parse & validate all tokens first so syntax errors are always reported even on missing prefixes.
  let tokens : Array[String] = []
  let mut seg_start = 1
  let mut i = 1
  while i <= n {
    if i == n || path.code_unit_at(i) == 47 {
      let raw = path.slice(seg_start, i)
      match pointer_unescape_token(raw) {
        Ok(tok) => tokens.push(tok)
        Err(e) => return Err(e)
      }
      seg_start = i + 1
    }
    i = i + 1
  }

  let mut cur = doc
  let mut t = 0
  while t < tokens.length() {
    let tok = tokens[t]
    match cur {
      Json::Object(obj) => {
        match obj.get(tok) {
          Some(next) => cur = next
          None => return Ok(None)
        }
      }
      Json::Array(items) => {
        match pointer_parse_array_index(tok) {
          Some(idx) => {
            if idx >= 0 && idx < items.length() {
              cur = items[idx]
            } else {
              return Ok(None)
            }
          }
          None => return Ok(None)
        }
      }
      _ => return Ok(None)
    }
    t = t + 1
  }
  Ok(Some(cur))
}
