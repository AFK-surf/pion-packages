///| RFC 6901 JSON Pointer evaluator (zero-allocation fast path when no `~` escapes).

fn pointer_unescape_slice(path : String, start : Int, end : Int) -> String {
  let sb = StringBuilder::with_capacity(end - start)
  let mut chunk_start = start
  let mut i = start
  while i < end {
    if path.code_unit_at(i) == 126 {
      if i > chunk_start {
        sb.write_substring(path, chunk_start, i)
      }
      let next = path.code_unit_at(i + 1)
      if next == 48 {
        sb.write_byte((126).to_byte())
      } else {
        sb.write_byte((47).to_byte())
      }
      i = i + 2
      chunk_start = i
    } else {
      i = i + 1
    }
  }
  if end > chunk_start {
    sb.write_substring(path, chunk_start, end)
  }
  sb.to_string()
}

///| Parse strict RFC 6901 array index ("0" or [1-9][0-9]*) directly from `path[start..end]`.
///| Returns `-1` if not a valid array index.
fn pointer_parse_array_index_slice(path : String, start : Int, end : Int) -> Int {
  let n = end - start
  if n == 0 || n > 10 {
    return -1
  }
  let b0 = path.code_unit_at(start)
  if b0 == 48 {
    if n == 1 {
      return 0
    }
    return -1
  }
  if b0 < 49 || b0 > 57 {
    return -1
  }
  let mut acc : Int64 = (b0 - 48).to_int64()
  let mut i = start + 1
  while i < end {
    let b = path.code_unit_at(i)
    if b < 48 || b > 57 {
      return -1
    }
    acc = acc * 10L + (b - 48).to_int64()
    if acc > 2147483646L {
      return -1
    }
    i = i + 1
  }
  acc.to_int()
}

fn pointer_validate_tail(path : String, from : Int, n : Int) -> Option[JsonError] {
  let mut v = from
  while v < n {
    if path.code_unit_at(v) == 126 {
      if v + 1 >= n {
        return Some(
          JsonError::new(
            JsonErrorKind::InvalidPointer,
            1,
            v + 1,
            v,
            "dangling '~' in JSON Pointer",
          ),
        )
      }
      let next = path.code_unit_at(v + 1)
      if next != 48 && next != 49 {
        return Some(
          JsonError::new(
            JsonErrorKind::InvalidPointer,
            1,
            v + 1,
            v,
            "invalid escape sequence in JSON Pointer (expected ~0 or ~1)",
          ),
        )
      }
      v = v + 2
    } else {
      v = v + 1
    }
  }
  None
}

///| Resolve an RFC 6901 JSON Pointer string against `doc` in a single pass.
fn pointer_eval(doc : Json, path : String) -> Result[Option[Json], JsonError] {
  let n = path.length()
  if n == 0 {
    return Ok(Some(doc))
  }
  if path.code_unit_at(0) != 47 {
    return Err(
      JsonError::new(
        JsonErrorKind::InvalidPointer,
        1,
        1,
        0,
        "JSON Pointer must be empty or start with '/'",
      ),
    )
  }

  let mut cur = doc
  let mut seg_start = 1
  let mut seg_has_tilde = false
  let mut i = 1
  while i <= n {
    if i < n && path.code_unit_at(i) == 126 {
      seg_has_tilde = true
      if i + 1 >= n {
        return Err(
          JsonError::new(
            JsonErrorKind::InvalidPointer,
            1,
            i + 1,
            i,
            "dangling '~' in JSON Pointer",
          ),
        )
      }
      let next = path.code_unit_at(i + 1)
      if next != 48 && next != 49 {
        return Err(
          JsonError::new(
            JsonErrorKind::InvalidPointer,
            1,
            i + 1,
            i,
            "invalid escape sequence in JSON Pointer (expected ~0 or ~1)",
          ),
        )
      }
      i = i + 2
      continue
    }
    if i == n || path.code_unit_at(i) == 47 {
      match cur {
        Json::Object(obj) => {
          let idx = if !seg_has_tilde {
            obj.find_idx_slice(path, seg_start, i)
          } else {
            obj.find_idx(pointer_unescape_slice(path, seg_start, i))
          }
          if idx >= 0 {
            let (_, next) = obj.entries[idx]
            cur = next
          } else {
            match pointer_validate_tail(path, i + 1, n) {
              Some(e) => return Err(e)
              None => return Ok(None)
            }
          }
        }
        Json::Array(items) => {
          let idx = if !seg_has_tilde {
            pointer_parse_array_index_slice(path, seg_start, i)
          } else {
            let unesc = pointer_unescape_slice(path, seg_start, i)
            pointer_parse_array_index_slice(unesc, 0, unesc.length())
          }
          if idx >= 0 && idx < items.length() {
            cur = items[idx]
          } else {
            match pointer_validate_tail(path, i + 1, n) {
              Some(e) => return Err(e)
              None => return Ok(None)
            }
          }
        }
        _ => {
          match pointer_validate_tail(path, i + 1, n) {
            Some(e) => return Err(e)
            None => return Ok(None)
          }
        }
      }
      seg_start = i + 1
      seg_has_tilde = false
    }
    i = i + 1
  }
  Ok(Some(cur))
}
