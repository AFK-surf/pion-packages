///| Head-to-head benchmark harness (Pion Native) for `packages/json`.
///| Workloads:
///|   w1 <file> <iters>  : Large realistic JSON document parse + tree stats
///|   w2 <file> <iters>  : Parse + extract/filter/mutate + compact stringify roundtrip
///|   w3 <file> <iters>  : Wide 50k-key object parse + 50k random lookups + canonical stringify

import "json"

struct W1Stats {
  mut objects : Int64
  mut arrays : Int64
  mut strings : Int64
  mut ints : Int64
  mut floats : Int64
  mut bools : Int64
  mut nulls : Int64
  mut int_sum : Int64
  mut str_bytes : Int64
}

fn fnv1a_bytes(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ s.code_unit_at(i).to_int64().reinterpret_as_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn walk_w1(st : W1Stats, root : json::Json) -> Unit {
  let stack : Array[json::Json] = [root]
  while stack.length() > 0 {
    let v = match stack.pop() {
      Some(x) => x
      None => break
    }
    match v {
      json::Json::Null => st.nulls = st.nulls + 1L
      json::Json::Bool(_) => st.bools = st.bools + 1L
      json::Json::Int(n) => {
        st.ints = st.ints + 1L
        st.int_sum = st.int_sum + (n % 1000003L)
      }
      json::Json::Float(_) => st.floats = st.floats + 1L
      json::Json::BigNum(_) => st.ints = st.ints + 1L
      json::Json::Str(s) => {
        st.strings = st.strings + 1L
        st.str_bytes = st.str_bytes + s.length().to_int64()
      }
      json::Json::Array(items) => {
        st.arrays = st.arrays + 1L
        let mut i = 0
        while i < items.length() {
          stack.push(items[i])
          i = i + 1
        }
      }
      json::Json::Object(obj) => {
        st.objects = st.objects + 1L
        let entries = obj.entries()
        let mut i = 0
        while i < entries.length() {
          let (_, child) = entries[i]
          stack.push(child)
          i = i + 1
        }
      }
    }
  }
}

fn parse_pos_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      acc = acc * 10 + (b - 48)
    }
    i = i + 1
  }
  acc
}

fn run_w1(world : World, path : String, iters : Int) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read " + path)
      return 1
    }
  }
  let st = W1Stats::{
    objects: 0L,
    arrays: 0L,
    strings: 0L,
    ints: 0L,
    floats: 0L,
    bools: 0L,
    nulls: 0L,
    int_sum: 0L,
    str_bytes: 0L,
  }
  let mut it = 0
  while it < iters {
    let v = match json::parse(content) {
      Ok(x) => x
      Err(e) => {
        io_println(world, "parse error: " + e.message)
        return 2
      }
    }
    walk_w1(st, v)
    it = it + 1
  }
  io_println(
    world,
    "w1 objects=" + st.objects.to_string() +
    " arrays=" + st.arrays.to_string() +
    " strings=" + st.strings.to_string() +
    " ints=" + st.ints.to_string() +
    " floats=" + st.floats.to_string() +
    " bools=" + st.bools.to_string() +
    " nulls=" + st.nulls.to_string() +
    " int_sum=" + st.int_sum.to_string() +
    " str_bytes=" + st.str_bytes.to_string(),
  )
  0
}

fn run_w2(world : World, path : String, iters : Int) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read " + path)
      return 1
    }
  }
  let mut total_bytes : Int64 = 0L
  let mut kept_total : Int64 = 0L
  let mut last_hash : UInt64 = 0UL
  let mut it = 0
  while it < iters {
    let doc = match json::parse(content) {
      Ok(x) => x
      Err(e) => {
        io_println(world, "parse error: " + e.message)
        return 2
      }
    }
    let recs = match doc.get_array("records") {
      Some(a) => a
      None => return 3
    }
    let out_items : Array[json::Json] = []
    let mut i = 0
    while i < recs.length() {
      let r = recs[i]
      let active = match r.get_bool("active") {
        Some(b) => b
        None => false
      }
      if active {
        let id = match r.get_i64("id") {
          Some(n) => n
          None => 0L
        }
        let score = match r.get_f64("score") {
          Some(f) => f
          None => 0.0
        }
        let login = match r.pointer("/actor/login") {
          Ok(Some(v)) => {
            match v.as_str() {
              Some(s) => s
              None => ""
            }
          }
          _ => ""
        }
        let tag0 = match r.pointer("/payload/tags/0") {
          Ok(Some(v)) => {
            match v.as_str() {
              Some(s) => s
              None => ""
            }
          }
          _ => ""
        }
        let item = json::Json::obj([
          ("id", json::Json::int(id)),
          ("login", json::Json::str(login)),
          ("processed", json::Json::bool(true)),
          ("score", json::Json::float(score)),
          ("tag", json::Json::str(tag0)),
        ])
        out_items.push(item)
        kept_total = kept_total + 1L
      }
      i = i + 1
    }
    let out_doc = json::Json::obj([
      ("count", json::Json::int(out_items.length().to_int64())),
      ("items", json::Json::arr(out_items)),
    ])
    let s = match json::stringify(out_doc) {
      Ok(str_out) => str_out
      Err(e) => {
        io_println(world, "stringify error: " + e.message)
        return 4
      }
    }
    total_bytes = total_bytes + s.length().to_int64()
    last_hash = fnv1a_bytes(s)
    it = it + 1
  }
  io_println(
    world,
    "w2 kept=" + kept_total.to_string() +
    " total_bytes=" + total_bytes.to_string() +
    " hash=" + last_hash.to_string(),
  )
  0
}

fn pad5(n : Int) -> String {
  let s = n.to_string()
  let mut pad = 5 - s.length()
  let sb = StringBuilder::new()
  while pad > 0 {
    sb.write_byte((48).to_byte())
    pad = pad - 1
  }
  sb.write_string(s)
  sb.to_string()
}

fn make_w3_key(k_idx : Int) -> String {
  let p = pad5(k_idx)
  if k_idx % 500 == 0 {
    "k_" + p + "_😀"
  } else if k_idx % 500 == 1 {
    "k_" + p + "_דּ"
  } else {
    "field_" + p
  }
}

fn run_w3(world : World, path : String, iters : Int) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read " + path)
      return 1
    }
  }
  let mut lookup_sum : Int64 = 0L
  let mut canon_bytes : Int64 = 0L
  let mut last_hash : UInt64 = 0UL
  let mut it = 0
  while it < iters {
    let doc = match json::parse(content) {
      Ok(x) => x
      Err(e) => {
        io_println(world, "parse error: " + e.message)
        return 2
      }
    }
    let obj = match doc.as_obj() {
      Some(o) => o
      None => return 3
    }
    let n = obj.len()
    let mut q = 0
    while q < n {
      let k_idx = (q * 7919 + 13) % n
      let k = make_w3_key(k_idx)
      match obj.get(k) {
        Some(v) => {
          match v.as_i64() {
            Some(iv) => lookup_sum = lookup_sum + (iv % 1000003L)
            None => ()
          }
        }
        None => return 4
      }
      q = q + 1
    }
    let canon = match json::stringify_canonical(doc) {
      Ok(s) => s
      Err(e) => {
        io_println(world, "canonical error: " + e.message)
        return 5
      }
    }
    canon_bytes = canon_bytes + canon.length().to_int64()
    last_hash = fnv1a_bytes(canon)
    it = it + 1
  }
  io_println(
    world,
    "w3 lookup_sum=" + lookup_sum.to_string() +
    " canon_bytes=" + canon_bytes.to_string() +
    " hash=" + last_hash.to_string(),
  )
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: json_bench <w1|w2|w3> <file> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_pos_int(args[3])
  if mode == "w1" {
    run_w1(world, path, iters)
  } else if mode == "w2" {
    run_w2(world, path, iters)
  } else if mode == "w3" {
    run_w3(world, path, iters)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
