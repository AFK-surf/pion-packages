///| Pion Native head-to-head benchmark for `packages/http_cache`.
///| Usage: pion_http_cache_bench <corpus_file> <iters>

import "http_cache"
import "crypto"

struct BenchCase {
  id : String
  method : String
  uri : String
  is_shared : Bool
  req_time : Int64
  resp_time : Int64
  lookup_time : Int64
  status : Int
  req_headers : Array[http_cache::Header]
  resp_headers : Array[http_cache::Header]
  lookup_headers : Array[http_cache::Header]
  reval_304_headers : Array[http_cache::Header]
}

fn parse_i64(s : String) -> Int64 {
  let mut acc = 0L
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10L + (c - 48).to_int64()
    }
    i = i + 1
  }
  acc
}

fn parse_int(s : String) -> Int {
  parse_i64(s).to_int()
}

fn slice_str(s : String, start : Int, end : Int) -> String {
  let len = end - start
  if len <= 0 {
    return ""
  }
  let out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = s.code_unit_at(start + i).to_byte()
    i = i + 1
  }
  out.to_string()
}

fn split_tabs(line : String) -> Array[String] {
  let parts : Array[String] = []
  let n = line.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || line.code_unit_at(i) == 9 {
      parts.push(slice_str(line, start, i))
      start = i + 1
    }
    i = i + 1
  }
  parts
}

fn parse_corpus(data : String) -> Array[BenchCase] {
  let cases : Array[BenchCase] = []
  let n = data.length()
  let mut pos = 0
  let mut id = ""
  let mut method = ""
  let mut uri = ""
  let mut is_shared = false
  let mut req_time = 0L
  let mut resp_time = 0L
  let mut lookup_time = 0L
  let mut status = 200
  let mut req_h : Array[http_cache::Header] = []
  let mut resp_h : Array[http_cache::Header] = []
  let mut lookup_h : Array[http_cache::Header] = []
  let mut reval_h : Array[http_cache::Header] = []

  while pos < n {
    let start = pos
    while pos < n && data.code_unit_at(pos) != 10 {
      pos = pos + 1
    }
    let end = if pos > start && data.code_unit_at(pos - 1) == 13 { pos - 1 } else { pos }
    if pos < n {
      pos = pos + 1
    }
    if end == start {
      continue
    }
    let line = slice_str(data, start, end)
    let parts = split_tabs(line)
    if parts.length() == 0 {
      continue
    }
    let tag = parts[0]
    if tag == "CASE" && parts.length() >= 9 {
      id = parts[1]
      method = parts[2]
      uri = parts[3]
      is_shared = parts[4] == "1"
      req_time = parse_i64(parts[5])
      resp_time = parse_i64(parts[6])
      lookup_time = parse_i64(parts[7])
      status = parse_int(parts[8])
      req_h = []
      resp_h = []
      lookup_h = []
      reval_h = []
    } else if tag == "RQ" && parts.length() >= 3 {
      req_h.push(http_cache::Header::new(parts[1], parts[2]))
    } else if tag == "RS" && parts.length() >= 3 {
      resp_h.push(http_cache::Header::new(parts[1], parts[2]))
    } else if tag == "LQ" && parts.length() >= 3 {
      lookup_h.push(http_cache::Header::new(parts[1], parts[2]))
    } else if tag == "R3" && parts.length() >= 3 {
      reval_h.push(http_cache::Header::new(parts[1], parts[2]))
    } else if tag == "END" {
      cases.push(BenchCase::{
        id: id,
        method: method,
        uri: uri,
        is_shared: is_shared,
        req_time: req_time,
        resp_time: resp_time,
        lookup_time: lookup_time,
        status: status,
        req_headers: req_h,
        resp_headers: resp_h,
        lookup_headers: lookup_h,
        reval_304_headers: reval_h,
      })
    }
  }
  cases
}

fn find_hdr(headers : Array[http_cache::Header], name : String) -> String {
  let mut i = 0
  while i < headers.length() {
    if headers[i].name == name {
      return headers[i].value
    }
    i = i + 1
  }
  "-"
}

fn eval_all_once(cases : Array[BenchCase]) -> String {
  let limits = http_cache::CacheLimits::default()
  let empty_body = Bytes::new(0)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < cases.length() {
    let c = cases[i]
    let opts = if c.is_shared {
      http_cache::CachePolicyOptions::shared()
    } else {
      http_cache::CachePolicyOptions::private_cache()
    }
    let req = http_cache::CacheRequest::new(c.method, c.uri, c.req_headers)
    let resp = http_cache::CacheResponse::new(c.status, c.resp_headers)
    sb.write_string(c.id)
    sb.write_string(":")
    match http_cache::create_entry(req, resp, empty_body, c.req_time, c.resp_time, opts, limits) {
      Ok(None) => {
        sb.write_string("storable=0\n")
      }
      Ok(Some(entry)) => {
        sb.write_string("storable=1|")
        let lreq = http_cache::CacheRequest::new(c.method, c.uri, c.lookup_headers)
        match http_cache::evaluate_lookup(lreq, entry, c.lookup_time, opts, limits) {
          Ok(http_cache::CacheLookup::Fresh(ttl)) => {
            sb.write_string("fresh=")
            sb.write_string(ttl.to_string())
          }
          Ok(http_cache::CacheLookup::StaleNeedsRevalidation(conds)) => {
            sb.write_string("reval|inm=")
            sb.write_string(find_hdr(conds, "if-none-match"))
            sb.write_string("|ims=")
            sb.write_string(find_hdr(conds, "if-modified-since"))
            if c.reval_304_headers.length() > 0 {
              let r304 = http_cache::CacheResponse::new(304, c.reval_304_headers)
              match http_cache::merge_304(entry, r304, c.lookup_time, c.lookup_time, opts, limits) {
                Ok(merged) => {
                  match http_cache::evaluate_lookup(lreq, merged, c.lookup_time + 10L, opts, limits) {
                    Ok(http_cache::CacheLookup::Fresh(ttl2)) => {
                      sb.write_string("|after304_fresh=")
                      sb.write_string(ttl2.to_string())
                    }
                    _ => sb.write_string("|after304_stale")
                  }
                }
                Err(_) => sb.write_string("|after304_err")
              }
            }
          }
          Ok(http_cache::CacheLookup::StaleWhileRevalidate(conds)) => {
            sb.write_string("swr|inm=")
            sb.write_string(find_hdr(conds, "if-none-match"))
          }
          Ok(http_cache::CacheLookup::Miss) => sb.write_string("miss")
          Ok(http_cache::CacheLookup::GatewayTimeout504) => sb.write_string("504")
          Err(_) => sb.write_string("err")
        }
        sb.write_string("\n")
      }
      Err(_) => sb.write_string("err\n")
    }
    i = i + 1
  }
  sb.to_string()
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: pion_http_cache_bench <corpus_file> <iters>")
    return 1
  }
  let path = args[1]
  let iters = parse_int(args[2])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b.to_string()
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }
  let cases = parse_corpus(data)
  if iters == 0 {
    io_println(world, eval_all_once(cases))
    return 0
  }
  let mut last_summary = ""
  let mut i = 0
  while i < iters {
    last_summary = eval_all_once(cases)
    i = i + 1
  }
  let hasher = crypto::Sha256::new()
  hasher.update(last_summary.to_bytes())
  let sha = hasher.finalize_hex()
  io_println(
    world,
    "cases=" + cases.length().to_string() +
    " iters=" + iters.to_string() +
    " summary_bytes=" + last_summary.length().to_string() +
    " summary_sha256=" + sha,
  )
  0
}
