///| Four-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/http_cache`.
///| Emits deterministic stdout for cross-mode SHA-256 verification and exits 0 on success.

import "http_cache"

fn fnv1a_64_str(s : String) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = s.length()
  let mut i = 0
  while i < n {
    h = (h ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  h
}

fn hex_u64(v : UInt64) -> String {
  let out = Bytes::new(16)
  let mut i = 0
  let mut shift = 60
  while i < 16 {
    let nib = ((v >> shift) & 15UL).to_int()
    let ch = if nib < 10 { 48 + nib } else { 87 + nib }
    out[i] = ch.to_byte()
    i = i + 1
    shift = shift - 4
  }
  out.to_string()
}

pub fn main(world : World) -> Int {
  // 1. HTTP-date three formats + roundtrip
  let ts = match http_cache::parse_http_date("Sun, 06 Nov 1994 08:49:37 GMT") {
    Ok(v) => v
    Err(_) => return 1
  }
  let ts_850 = match http_cache::parse_http_date("Sunday, 06-Nov-94 08:49:37 GMT") {
    Ok(v) => v
    Err(_) => return 2
  }
  let ts_asc = match http_cache::parse_http_date("Sun Nov  6 08:49:37 1994") {
    Ok(v) => v
    Err(_) => return 3
  }
  if ts != ts_850 || ts != ts_asc {
    return 4
  }
  let fmt = http_cache::format_http_date(ts)

  // 2. Bounded LRU CacheStore + Vary + SWR + 304 + Invalidation
  let limits = http_cache::CacheLimits::new(8192, 64, 8, 32, 4096L, 4, 8192L)
  let store = match http_cache::CacheStore::new(http_cache::CachePolicyOptions::shared(), limits) {
    Ok(s) => s
    Err(_) => return 5
  }
  let t0 = 1700000000L
  let req = http_cache::CacheRequest::new("GET", "https://cdn.example.com/video/manifest.mpd", [
    http_cache::Header::new("Accept-Encoding", "br"),
  ])
  let resp = http_cache::CacheResponse::new(200, [
    http_cache::Header::new("Date", http_cache::format_http_date(t0)),
    http_cache::Header::new("Cache-Control", "public, s-maxage=120, max-age=60, stale-while-revalidate=30"),
    http_cache::Header::new("Vary", "Accept-Encoding"),
    http_cache::Header::new("ETag", "\"m-v1\""),
  ])
  let stored = match store.store(req, resp, "<MPD>ok</MPD>".to_bytes(), t0, t0) {
    Ok(v) => v
    Err(_) => return 6
  }
  if !stored {
    return 7
  }
  let ttl = match store.lookup(req, t0 + 50L) {
    Ok(http_cache::StoreLookup::HitFresh(_, r)) => r
    _ => return 8
  }
  let swr_inm = match store.lookup(req, t0 + 135L) {
    Ok(http_cache::StoreLookup::HitStaleWhileRevalidate(_, conds)) =>
    if conds.length() > 0 { conds[0].value } else { "" }
    _ => return 9
  }
  let resp_304 = http_cache::CacheResponse::new(304, [
    http_cache::Header::new("Date", http_cache::format_http_date(t0 + 150L)),
    http_cache::Header::new("Cache-Control", "public, s-maxage=300"),
    http_cache::Header::new("ETag", "\"m-v2\""),
  ])
  let new_etag = match store.update_304(req, resp_304, t0 + 150L, t0 + 150L) {
    Ok(Some(e)) => match e.etag { Some(v) => v None => "" }
    _ => return 10
  }
  let post_req = http_cache::CacheRequest::new("POST", "https://cdn.example.com/video/manifest.mpd", [])
  let post_resp = http_cache::CacheResponse::new(200, [])
  let evicted = match store.invalidate_for_response(post_req, post_resp) {
    Ok(n) => n
    Err(_) => return 11
  }

  let summary = fmt + "|" + ttl.to_string() + "|" + swr_inm + "|" + new_etag + "|" + evicted.to_string()
  io_println(world, "http_cache_wasm_smoke:ok")
  io_println(world, "summary=" + summary + " fnv64=" + hex_u64(fnv1a_64_str(summary)))
  0
}
