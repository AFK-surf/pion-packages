///| Core RFC 9111 (HTTP Caching) and RFC 9110 (HTTP-date / Conditional Requests)
///| types, resource limits, and explicit errors.

///| HTTP header name-value pair.
pub val struct Header {
  pub name : String
  pub value : String
}

///| Construct an HTTP header.
pub fn Header::new(name : String, value : String) -> Header {
  Header::{ name: name, value: value }
}

///| Explicit resource limits enforced across parsing, policy evaluation, and
///| in-memory storage to prevent allocation bombs and OOM DoS.
///|
///| Semantics:
///| - Any negative limit field is immediately rejected with `CacheError::LimitExceeded`.
///| - A value of `0` strictly means 0 items/bytes are allowed (not unlimited).
#verify
pub val struct CacheLimits {
  pub max_header_bytes : Int
  pub max_headers : Int
  pub max_vary_headers : Int
  pub max_directives : Int
  pub max_entry_bytes : Int64
  pub max_entries : Int
  pub max_total_bytes : Int64
}

///| Default resource limits suitable for browsers, HTTP clients, and CDNs.
#verify
pub fn CacheLimits::default() -> CacheLimits {
  CacheLimits::{
    max_header_bytes: 65536,
    max_headers: 512,
    max_vary_headers: 32,
    max_directives: 64,
    max_entry_bytes: 16777216L,
    max_entries: 1024,
    max_total_bytes: 67108864L,
  }
}

///| Construct custom cache limits.
#verify
pub fn CacheLimits::new(
  max_header_bytes : Int,
  max_headers : Int,
  max_vary_headers : Int,
  max_directives : Int,
  max_entry_bytes : Int64,
  max_entries : Int,
  max_total_bytes : Int64,
) -> CacheLimits {
  CacheLimits::{
    max_header_bytes: max_header_bytes,
    max_headers: max_headers,
    max_vary_headers: max_vary_headers,
    max_directives: max_directives,
    max_entry_bytes: max_entry_bytes,
    max_entries: max_entries,
    max_total_bytes: max_total_bytes,
  }
}

///| Explicit errors returned by `http_cache` operations.
pub enum CacheError {
  LimitExceeded(String)
  InvalidDate(String)
  InvalidCacheControl(String)
  InvalidHeader(String)
  InvalidUri(String)
  InvalidRequest(String)
  InvalidResponse(String)
}

///| Human-readable message for a `CacheError`.
pub fn cache_error_message(err : CacheError) -> String {
  match err {
    CacheError::LimitExceeded(msg) => "limit exceeded: " + msg
    CacheError::InvalidDate(msg) => "invalid HTTP-date: " + msg
    CacheError::InvalidCacheControl(msg) => "invalid Cache-Control: " + msg
    CacheError::InvalidHeader(msg) => "invalid header: " + msg
    CacheError::InvalidUri(msg) => "invalid URI: " + msg
    CacheError::InvalidRequest(msg) => "invalid request: " + msg
    CacheError::InvalidResponse(msg) => "invalid response: " + msg
  }
}

///| HTTP request metadata for Sans-IO cache evaluation.
pub struct CacheRequest {
  pub method : String
  pub uri : String
  pub headers : Array[Header]
}

///| Construct a `CacheRequest`.
pub fn CacheRequest::new(
  method : String,
  uri : String,
  headers : Array[Header],
) -> CacheRequest {
  CacheRequest::{ method: method, uri: uri, headers: headers }
}

///| HTTP response metadata for Sans-IO cache evaluation.
pub struct CacheResponse {
  pub status : Int
  pub headers : Array[Header]
}

///| Construct a `CacheResponse`.
pub fn CacheResponse::new(
  status : Int,
  headers : Array[Header],
) -> CacheResponse {
  CacheResponse::{ status: status, headers: headers }
}

///| Parsed RFC 9111 §5.2.1 request `Cache-Control` directives.
#verify
pub val struct RequestCacheControl {
  pub max_age : Option[Int64]
  pub has_max_stale : Bool
  pub max_stale_seconds : Option[Int64]
  pub min_fresh : Option[Int64]
  pub no_cache : Bool
  pub no_store : Bool
  pub no_transform : Bool
  pub only_if_cached : Bool
}

///| Empty default `RequestCacheControl`.
#verify
pub fn RequestCacheControl::empty() -> RequestCacheControl {
  RequestCacheControl::{
    max_age: None,
    has_max_stale: false,
    max_stale_seconds: None,
    min_fresh: None,
    no_cache: false,
    no_store: false,
    no_transform: false,
    only_if_cached: false,
  }
}

///| Parsed RFC 9111 §5.2.2 response `Cache-Control` directives.
pub struct ResponseCacheControl {
  pub is_public : Bool
  pub is_private : Bool
  pub private_fields : Array[String]
  pub no_cache : Bool
  pub no_cache_fields : Array[String]
  pub no_store : Bool
  pub must_revalidate : Bool
  pub proxy_revalidate : Bool
  pub must_understand : Bool
  pub max_age : Option[Int64]
  pub s_maxage : Option[Int64]
  pub immutable : Bool
  pub stale_while_revalidate : Option[Int64]
  pub stale_if_error : Option[Int64]
  pub no_transform : Bool
}

///| Empty default `ResponseCacheControl`.
pub fn ResponseCacheControl::empty() -> ResponseCacheControl {
  ResponseCacheControl::{
    is_public: false,
    is_private: false,
    private_fields: [],
    no_cache: false,
    no_cache_fields: [],
    no_store: false,
    must_revalidate: false,
    proxy_revalidate: false,
    must_understand: false,
    max_age: None,
    s_maxage: None,
    immutable: false,
    stale_while_revalidate: None,
    stale_if_error: None,
    no_transform: false,
  }
}

///| Cache policy options controlling shared/private semantics and heuristic freshness.
#verify
pub val struct CachePolicyOptions {
  pub is_shared : Bool
  pub heuristic_fraction_pct : Int
  pub max_heuristic_seconds : Int64
}

///| Default options for a shared cache (CDN / reverse proxy).
#verify
pub fn CachePolicyOptions::shared() -> CachePolicyOptions {
  CachePolicyOptions::{
    is_shared: true,
    heuristic_fraction_pct: 10,
    max_heuristic_seconds: 86400L,
  }
}

///| Default options for a private cache (browser / HTTP client).
#verify
pub fn CachePolicyOptions::private_cache() -> CachePolicyOptions {
  CachePolicyOptions::{
    is_shared: false,
    heuristic_fraction_pct: 10,
    max_heuristic_seconds: 86400L,
  }
}

///| Stored HTTP response entry with parsed metadata for Sans-IO reuse and revalidation.
pub struct StoredEntry {
  pub method : String
  pub uri : String
  pub status : Int
  pub request_headers : Array[Header]
  pub response_headers : Array[Header]
  pub body : Bytes
  pub request_time : Int64
  pub response_time : Int64
  pub initial_age : Int64
  pub freshness_lifetime : Int64
  pub response_cc : ResponseCacheControl
  pub vary_headers : Array[String]
  pub vary_star : Bool
  pub etag : Option[String]
  pub last_modified : Option[String]
}

///| RFC 9111 lookup decision against a single stored entry.
pub enum CacheLookup {
  Fresh(Int64)
  StaleNeedsRevalidation(Array[Header])
  StaleWhileRevalidate(Array[Header])
  Miss
  GatewayTimeout504
}

///| Lookup result from `CacheStore::lookup`.
pub enum StoreLookup {
  HitFresh(StoredEntry, Int64)
  HitStaleWhileRevalidate(StoredEntry, Array[Header])
  NeedsRevalidation(StoredEntry, Array[Header])
  Miss
  GatewayTimeout504
}

///| Maximum RFC 9111 §1.2.2 clamped delta-seconds (2^31).
pub let max_delta_seconds : Int64 = 2147483648L

///| Pure predicate checking that all `CacheLimits` fields are non-negative.
#verify
pub fn limits_all_nonneg(limits : CacheLimits) -> Bool {
  limits.max_header_bytes >= 0 &&
  limits.max_headers >= 0 &&
  limits.max_vary_headers >= 0 &&
  limits.max_directives >= 0 &&
  limits.max_entry_bytes >= 0L &&
  limits.max_entries >= 0 &&
  limits.max_total_bytes >= 0L
}

///| Validate that all fields in `CacheLimits` are non-negative.
pub fn validate_limits(limits : CacheLimits) -> Result[Unit, CacheError] {
  if limits_all_nonneg(limits) {
    return Ok(())
  }
  if limits.max_header_bytes < 0 {
    return Err(CacheError::LimitExceeded("max_header_bytes must be non-negative"))
  }
  if limits.max_headers < 0 {
    return Err(CacheError::LimitExceeded("max_headers must be non-negative"))
  }
  if limits.max_vary_headers < 0 {
    return Err(CacheError::LimitExceeded("max_vary_headers must be non-negative"))
  }
  if limits.max_directives < 0 {
    return Err(CacheError::LimitExceeded("max_directives must be non-negative"))
  }
  if limits.max_entry_bytes < 0L {
    return Err(CacheError::LimitExceeded("max_entry_bytes must be non-negative"))
  }
  if limits.max_entries < 0 {
    return Err(CacheError::LimitExceeded("max_entries must be non-negative"))
  }
  if limits.max_total_bytes < 0L {
    return Err(CacheError::LimitExceeded("max_total_bytes must be non-negative"))
  }
  Ok(())
}
