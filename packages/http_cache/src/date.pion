///| RFC 9110 §5.6.7 HTTP-date parsing (IMF-fixdate, obsolete RFC 850, ANSI C asctime)
///| and canonical IMF-fixdate formatting. Pure Int64 O(1) civil calendar arithmetic.

#verify
pub fn is_ascii_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn parse_2_digits(s : String, pos : Int) -> Option[Int] {
  if pos + 2 > s.length() {
    return None
  }
  let a = s.code_unit_at(pos)
  let b = s.code_unit_at(pos + 1)
  if !is_ascii_digit(a) || !is_ascii_digit(b) {
    return None
  }
  Some((a - 48) * 10 + (b - 48))
}

fn parse_4_digits(s : String, pos : Int) -> Option[Int] {
  if pos + 4 > s.length() {
    return None
  }
  let a = s.code_unit_at(pos)
  let b = s.code_unit_at(pos + 1)
  let c = s.code_unit_at(pos + 2)
  let d = s.code_unit_at(pos + 3)
  if !is_ascii_digit(a) || !is_ascii_digit(b) || !is_ascii_digit(c) || !is_ascii_digit(d) {
    return None
  }
  Some((a - 48) * 1000 + (b - 48) * 100 + (c - 48) * 10 + (d - 48))
}

fn match_lit3(s : String, pos : Int, c0 : Int, c1 : Int, c2 : Int) -> Bool {
  pos + 3 <= s.length() &&
  s.code_unit_at(pos) == c0 &&
  s.code_unit_at(pos + 1) == c1 &&
  s.code_unit_at(pos + 2) == c2
}

fn parse_month3(s : String, pos : Int) -> Option[Int] {
  if pos + 3 > s.length() {
    return None
  }
  let c0 = s.code_unit_at(pos)
  let c1 = s.code_unit_at(pos + 1)
  let c2 = s.code_unit_at(pos + 2)
  if c0 == 74 && c1 == 97 && c2 == 110 {
    return Some(1) // Jan
  }
  if c0 == 70 && c1 == 101 && c2 == 98 {
    return Some(2) // Feb
  }
  if c0 == 77 && c1 == 97 && c2 == 114 {
    return Some(3) // Mar
  }
  if c0 == 65 && c1 == 112 && c2 == 114 {
    return Some(4) // Apr
  }
  if c0 == 77 && c1 == 97 && c2 == 121 {
    return Some(5) // May
  }
  if c0 == 74 && c1 == 117 && c2 == 110 {
    return Some(6) // Jun
  }
  if c0 == 74 && c1 == 117 && c2 == 108 {
    return Some(7) // Jul
  }
  if c0 == 65 && c1 == 117 && c2 == 103 {
    return Some(8) // Aug
  }
  if c0 == 83 && c1 == 101 && c2 == 112 {
    return Some(9) // Sep
  }
  if c0 == 79 && c1 == 99 && c2 == 116 {
    return Some(10) // Oct
  }
  if c0 == 78 && c1 == 111 && c2 == 118 {
    return Some(11) // Nov
  }
  if c0 == 68 && c1 == 101 && c2 == 99 {
    return Some(12) // Dec
  }
  None
}

fn is_valid_day_name3(s : String, pos : Int) -> Bool {
  match_lit3(s, pos, 77, 111, 110) || // Mon
  match_lit3(s, pos, 84, 117, 101) || // Tue
  match_lit3(s, pos, 87, 101, 100) || // Wed
  match_lit3(s, pos, 84, 104, 117) || // Thu
  match_lit3(s, pos, 70, 114, 105) || // Fri
  match_lit3(s, pos, 83, 97, 116) || // Sat
  match_lit3(s, pos, 83, 117, 110) // Sun
}

fn match_day_name_long(s : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len == 6 {
    // Monday, Friday, Sunday
    return (
      match_lit3(s, start, 77, 111, 110) && match_lit3(s, start + 3, 100, 97, 121)
    ) || (
      match_lit3(s, start, 70, 114, 105) && match_lit3(s, start + 3, 100, 97, 121)
    ) || (
      match_lit3(s, start, 83, 117, 110) && match_lit3(s, start + 3, 100, 97, 121)
    )
  }
  if len == 7 {
    // Tuesday
    return match_lit3(s, start, 84, 117, 101) &&
    s.code_unit_at(start + 3) == 115 &&
    match_lit3(s, start + 4, 100, 97, 121)
  }
  if len == 8 {
    // Thursday, Saturday
    return (
      match_lit3(s, start, 84, 104, 117) &&
      s.code_unit_at(start + 3) == 114 &&
      s.code_unit_at(start + 4) == 115 &&
      match_lit3(s, start + 5, 100, 97, 121)
    ) || (
      match_lit3(s, start, 83, 97, 116) &&
      s.code_unit_at(start + 3) == 117 &&
      s.code_unit_at(start + 4) == 114 &&
      match_lit3(s, start + 5, 100, 97, 121)
    )
  }
  if len == 9 {
    // Wednesday
    return match_lit3(s, start, 87, 101, 100) &&
    match_lit3(s, start + 3, 110, 101, 115) &&
    match_lit3(s, start + 6, 100, 97, 121)
  }
  false
}

#verify
pub fn is_leap_year(year : Int) -> Bool {
  (year % 4 == 0) && ((year % 100 != 0) || (year % 400 == 0))
}

#verify
pub fn days_in_month(year : Int, month : Int) -> Int {
  if month == 2 {
    if is_leap_year(year) { 29 } else { 28 }
  } else if month == 4 || month == 6 || month == 9 || month == 11 {
    30
  } else {
    31
  }
}

///| Howard Hinnant's O(1) civil-to-days since 1970-01-01.
fn days_from_civil(year : Int, month : Int, day : Int) -> Int64 {
  let y = if month <= 2 { year.to_int64() - 1L } else { year.to_int64() }
  let era = if y >= 0L { y / 400L } else { (y - 399L) / 400L }
  let yoe = y - era * 400L
  let m = month.to_int64()
  let d = day.to_int64()
  let doy = (153L * (if m > 2L { m - 3L } else { m + 9L }) + 2L) / 5L + d - 1L
  let doe = yoe * 365L + yoe / 4L - yoe / 100L + doy
  era * 146097L + doe - 719468L
}

fn build_epoch(
  year : Int,
  month : Int,
  day : Int,
  hour : Int,
  minute : Int,
  second : Int,
) -> Result[Int64, CacheError] {
  if year < 1900 || year > 9999 {
    return Err(CacheError::InvalidDate("year out of range"))
  }
  if month < 1 || month > 12 {
    return Err(CacheError::InvalidDate("month out of range"))
  }
  let max_day = days_in_month(year, month)
  if day < 1 || day > max_day {
    return Err(CacheError::InvalidDate("day out of range for month/year"))
  }
  if hour < 0 || hour > 23 {
    return Err(CacheError::InvalidDate("hour out of range"))
  }
  if minute < 0 || minute > 59 {
    return Err(CacheError::InvalidDate("minute out of range"))
  }
  if second < 0 || second > 59 {
    return Err(CacheError::InvalidDate("second out of range"))
  }
  let days = days_from_civil(year, month, day)
  Ok(days * 86400L + hour.to_int64() * 3600L + minute.to_int64() * 60L + second.to_int64())
}

fn parse_hms(s : String, pos : Int) -> Result[(Int, Int, Int), CacheError] {
  if pos + 8 > s.length() {
    return Err(CacheError::InvalidDate("truncated time"))
  }
  if s.code_unit_at(pos + 2) != 58 || s.code_unit_at(pos + 5) != 58 {
    return Err(CacheError::InvalidDate("expected ':' in time"))
  }
  let hh = match parse_2_digits(s, pos) {
    Some(v) => v
    None => return Err(CacheError::InvalidDate("invalid hour"))
  }
  let mm = match parse_2_digits(s, pos + 3) {
    Some(v) => v
    None => return Err(CacheError::InvalidDate("invalid minute"))
  }
  let ss = match parse_2_digits(s, pos + 6) {
    Some(v) => v
    None => return Err(CacheError::InvalidDate("invalid second"))
  }
  Ok((hh, mm, ss))
}

///| Parse an RFC 9110 §5.6.7 HTTP-date (IMF-fixdate, obsolete RFC 850, or
///| ANSI C `asctime()`) into Unix epoch seconds (`Int64`).
pub fn parse_http_date(s : String) -> Result[Int64, CacheError] {
  let n = s.length()
  // Trim leading/trailing ASCII OWS (SP / HTAB)
  let mut start = 0
  while start < n && (s.code_unit_at(start) == 32 || s.code_unit_at(start) == 9) {
    start = start + 1
  }
  let mut end = n
  while end > start && (s.code_unit_at(end - 1) == 32 || s.code_unit_at(end - 1) == 9) {
    end = end - 1
  }
  let len = end - start
  if len == 0 {
    return Err(CacheError::InvalidDate("empty date"))
  }

  // Format 1: IMF-fixdate (exact length 29)
  // e.g. "Sun, 06 Nov 1994 08:49:37 GMT"
  if len == 29 && s.code_unit_at(start + 3) == 44 && s.code_unit_at(start + 4) == 32 {
    if !is_valid_day_name3(s, start) {
      return Err(CacheError::InvalidDate("invalid IMF-fixdate weekday"))
    }
    if s.code_unit_at(start + 7) != 32 ||
    s.code_unit_at(start + 11) != 32 ||
    s.code_unit_at(start + 16) != 32 ||
    s.code_unit_at(start + 25) != 32 {
      return Err(CacheError::InvalidDate("invalid IMF-fixdate spacing"))
    }
    if !match_lit3(s, start + 26, 71, 77, 84) {
      return Err(CacheError::InvalidDate("IMF-fixdate must end with GMT"))
    }
    let day = match parse_2_digits(s, start + 5) {
      Some(v) => v
      None => return Err(CacheError::InvalidDate("invalid IMF-fixdate day"))
    }
    let month = match parse_month3(s, start + 8) {
      Some(v) => v
      None => return Err(CacheError::InvalidDate("invalid IMF-fixdate month"))
    }
    let year = match parse_4_digits(s, start + 12) {
      Some(v) => v
      None => return Err(CacheError::InvalidDate("invalid IMF-fixdate year"))
    }
    let (hh, mm, ss) = match parse_hms(s, start + 17) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return build_epoch(year, month, day, hh, mm, ss)
  }

  // Format 3: ANSI C asctime() (exact length 24)
  // e.g. "Sun Nov  6 08:49:37 1994" or "Sun Nov 16 08:49:37 1994"
  if len == 24 && s.code_unit_at(start + 3) == 32 {
    if !is_valid_day_name3(s, start) {
      return Err(CacheError::InvalidDate("invalid asctime weekday"))
    }
    if s.code_unit_at(start + 7) != 32 ||
    s.code_unit_at(start + 10) != 32 ||
    s.code_unit_at(start + 19) != 32 {
      return Err(CacheError::InvalidDate("invalid asctime spacing"))
    }
    let month = match parse_month3(s, start + 4) {
      Some(v) => v
      None => return Err(CacheError::InvalidDate("invalid asctime month"))
    }
    let d0 = s.code_unit_at(start + 8)
    let d1 = s.code_unit_at(start + 9)
    let day = if d0 == 32 && is_ascii_digit(d1) {
      d1 - 48
    } else if is_ascii_digit(d0) && is_ascii_digit(d1) {
      (d0 - 48) * 10 + (d1 - 48)
    } else {
      return Err(CacheError::InvalidDate("invalid asctime day"))
    }
    let (hh, mm, ss) = match parse_hms(s, start + 11) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let year = match parse_4_digits(s, start + 20) {
      Some(v) => v
      None => return Err(CacheError::InvalidDate("invalid asctime year"))
    }
    return build_epoch(year, month, day, hh, mm, ss)
  }

  // Format 2: obsolete RFC 850
  // e.g. "Sunday, 06-Nov-94 08:49:37 GMT"
  let mut comma = -1
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == 44 {
      comma = i
      break
    }
    i = i + 1
  }
  if comma > start && comma + 24 == end {
    if !match_day_name_long(s, start, comma) {
      return Err(CacheError::InvalidDate("invalid RFC 850 weekday"))
    }
    let p = comma + 1
    if s.code_unit_at(p) != 32 ||
    s.code_unit_at(p + 3) != 45 ||
    s.code_unit_at(p + 7) != 45 ||
    s.code_unit_at(p + 10) != 32 ||
    s.code_unit_at(p + 19) != 32 {
      return Err(CacheError::InvalidDate("invalid RFC 850 format"))
    }
    if !match_lit3(s, p + 20, 71, 77, 84) {
      return Err(CacheError::InvalidDate("RFC 850 date must end with GMT"))
    }
    let day = match parse_2_digits(s, p + 1) {
      Some(v) => v
      None => return Err(CacheError::InvalidDate("invalid RFC 850 day"))
    }
    let month = match parse_month3(s, p + 4) {
      Some(v) => v
      None => return Err(CacheError::InvalidDate("invalid RFC 850 month"))
    }
    let yy = match parse_2_digits(s, p + 8) {
      Some(v) => v
      None => return Err(CacheError::InvalidDate("invalid RFC 850 year"))
    }
    let year = if yy >= 70 { 1900 + yy } else { 2000 + yy }
    let (hh, mm, ss) = match parse_hms(s, p + 11) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    return build_epoch(year, month, day, hh, mm, ss)
  }

  Err(CacheError::InvalidDate("unrecognized HTTP-date format"))
}

let day_names : Array[String] = ["Thu", "Fri", "Sat", "Sun", "Mon", "Tue", "Wed"]

let month_names : Array[String] = [
  "", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
]

fn write_3(out : Bytes, pos : Int, s : String) -> Unit {
  out[pos] = s.code_unit_at(0).to_byte()
  out[pos + 1] = s.code_unit_at(1).to_byte()
  out[pos + 2] = s.code_unit_at(2).to_byte()
}

fn write_2d(out : Bytes, pos : Int, v : Int) -> Unit {
  out[pos] = (48 + v / 10).to_byte()
  out[pos + 1] = (48 + v % 10).to_byte()
}

fn write_4d(out : Bytes, pos : Int, v : Int) -> Unit {
  out[pos] = (48 + (v / 1000) % 10).to_byte()
  out[pos + 1] = (48 + (v / 100) % 10).to_byte()
  out[pos + 2] = (48 + (v / 10) % 10).to_byte()
  out[pos + 3] = (48 + v % 10).to_byte()
}

///| Format Unix epoch seconds (`Int64`) as an RFC 9110 §5.6.7 IMF-fixdate
///| (e.g. `Sun, 06 Nov 1994 08:49:37 GMT`).
pub fn format_http_date(epoch_secs : Int64) -> String {
  let mut days = epoch_secs / 86400L
  let mut rem = epoch_secs % 86400L
  if rem < 0L {
    rem = rem + 86400L
    days = days - 1L
  }
  let mut dow = (days % 7L).to_int()
  if dow < 0 {
    dow = dow + 7
  }
  // Howard Hinnant civil_from_days
  let z = days + 719468L
  let era = if z >= 0L { z / 146097L } else { (z - 146096L) / 146097L }
  let doe = z - era * 146097L
  let yoe = (doe - doe / 1460L + doe / 36524L - doe / 146096L) / 365L
  let y = yoe + era * 400L
  let doy = doe - (365L * yoe + yoe / 4L - yoe / 100L)
  let mp = (5L * doy + 2L) / 153L
  let d = (doy - (153L * mp + 2L) / 5L + 1L).to_int()
  let m = (if mp < 10L { mp + 3L } else { mp - 9L }).to_int()
  let year = (if m <= 2 { y + 1L } else { y }).to_int()

  let sec = (rem % 60L).to_int()
  let mins_total = (rem / 60L).to_int()
  let min = mins_total % 60
  let hour = mins_total / 60

  let out = Bytes::new(29)
  write_3(out, 0, day_names[dow])
  out[3] = 44.to_byte() // ','
  out[4] = 32.to_byte() // ' '
  write_2d(out, 5, d)
  out[7] = 32.to_byte()
  write_3(out, 8, month_names[m])
  out[11] = 32.to_byte()
  write_4d(out, 12, year)
  out[16] = 32.to_byte()
  write_2d(out, 17, hour)
  out[19] = 58.to_byte() // ':'
  write_2d(out, 20, min)
  out[22] = 58.to_byte() // ':'
  write_2d(out, 23, sec)
  out[25] = 32.to_byte()
  out[26] = 71.to_byte() // 'G'
  out[27] = 77.to_byte() // 'M'
  out[28] = 84.to_byte() // 'T'
  out.to_string()
}
