///| Differential subject: `http_cache` decisions per corpus case, same line format as
///| the Rust `http-cache-semantics 3.0.0` oracle (audit/diff/rust).

import "http_cache"

struct Case {
  id : String
  method : String
  uri : String
  is_shared : Bool
  rt : Int64
  st : Int64
  lt : Int64
  status : Int
  rq : Array[http_cache::Header]
  rs : Array[http_cache::Header]
  lq : Array[http_cache::Header]
  r3 : Array[http_cache::Header]
}

fn parse_i64(s : String) -> Int64 {
  let mut acc = 0L
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10L + (c - 48).to_int64()
    }
    i = i + 1
  }
  acc
}

fn slice_str(s : String, start : Int, end : Int) -> String {
  let len = end - start
  if len <= 0 {
    return ""
  }
  let out = Bytes::new(len)
  let mut i = 0
  while i < len {
    out[i] = s.code_unit_at(start + i).to_byte()
    i = i + 1
  }
  out.to_string()
}

fn split_tabs(line : String) -> Array[String] {
  let parts : Array[String] = []
  let n = line.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || line.code_unit_at(i) == 9 {
      parts.push(slice_str(line, start, i))
      start = i + 1
    }
    i = i + 1
  }
  parts
}

fn kv(p : Array[String]) -> http_cache::Header {
  http_cache::Header::new(p[1], if p.length() > 2 { p[2] } else { "" })
}

fn parse(data : String) -> Array[Case] {
  let out : Array[Case] = []
  let n = data.length()
  let mut pos = 0
  let mut id = ""
  let mut method = ""
  let mut uri = ""
  let mut sh = false
  let mut rt = 0L
  let mut st = 0L
  let mut lt = 0L
  let mut status = 0
  let mut rq : Array[http_cache::Header] = []
  let mut rs : Array[http_cache::Header] = []
  let mut lq : Array[http_cache::Header] = []
  let mut r3 : Array[http_cache::Header] = []
  while pos < n {
    let start = pos
    while pos < n && data.code_unit_at(pos) != 10 {
      pos = pos + 1
    }
    let line = slice_str(data, start, pos)
    pos = pos + 1
    if line.length() == 0 {
      continue
    }
    let p = split_tabs(line)
    let tag = p[0]
    if tag == "CASE" {
      id = p[1]
      method = p[2]
      uri = p[3]
      sh = p[4] == "1"
      rt = parse_i64(p[5])
      st = parse_i64(p[6])
      lt = parse_i64(p[7])
      status = parse_i64(p[8]).to_int()
      rq = []
      rs = []
      lq = []
      r3 = []
    } else if tag == "RQ" {
      rq.push(kv(p))
    } else if tag == "RS" {
      rs.push(kv(p))
    } else if tag == "LQ" {
      lq.push(kv(p))
    } else if tag == "R3" {
      r3.push(kv(p))
    } else if tag == "END" {
      out.push(Case::{ id: id, method: method, uri: uri, is_shared: sh, rt: rt, st: st, lt: lt, status: status, rq: rq, rs: rs, lq: lq, r3: r3 })
    }
  }
  out
}

fn ttl_of(e : http_cache::StoredEntry, now : Int64) -> Int64 {
  let r = e.freshness_lifetime - http_cache::compute_current_age(e, now)
  if r < 0L { 0L } else { r }
}

fn kind(r : Result[http_cache::CacheLookup, http_cache::CacheError]) -> String {
  match r {
    Ok(http_cache::CacheLookup::Fresh(_)) => "fresh"
    Ok(http_cache::CacheLookup::Miss) => "miss"
    Ok(_) => "stale"
    Err(_) => "err"
  }
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  let data = match fs_read_bytes(world, args[1]) {
    Ok(b) => b.to_string()
    Err(_) => return 1
  }
  let limits = http_cache::CacheLimits::default()
  let cases = parse(data)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < cases.length() {
    let c = cases[i]
    let base = if c.is_shared { http_cache::CachePolicyOptions::shared() } else { http_cache::CachePolicyOptions::private_cache() }
    // align with oracle: 10% heuristic, no 24h heuristic cap
    let opts = http_cache::CachePolicyOptions::{ is_shared: base.is_shared, heuristic_fraction_pct: 10, max_heuristic_seconds: -1L }
    let req = http_cache::CacheRequest::new(c.method, c.uri, c.rq)
    let resp = http_cache::CacheResponse::new(c.status, c.rs)
    sb.write_string(c.id)
    match http_cache::create_entry(req, resp, Bytes::new(0), c.rt, c.st, opts, limits) {
      Ok(Some(e)) => {
        let lreq = http_cache::CacheRequest::new(c.method, c.uri, c.lq)
        let k = kind(http_cache::evaluate_lookup(lreq, e, c.lt, opts, limits))
        sb.write_string(" st=1 lk=" + k)
        sb.write_string(" ttl=" + ttl_of(e, c.lt).to_string())
        sb.write_string(" age=" + http_cache::compute_current_age(e, c.lt).to_string())
        if k == "stale" && c.r3.length() > 0 {
          match http_cache::merge_304(e, http_cache::CacheResponse::new(304, c.r3), c.lt, c.lt, opts, limits) {
            Ok(m) => {
              let k2 = kind(http_cache::evaluate_lookup(lreq, m, c.lt + 10L, opts, limits))
              sb.write_string(" a304=" + k2 + " ttl2=" + ttl_of(m, c.lt + 10L).to_string())
            }
            Err(_) => sb.write_string(" a304=err ttl2=0")
          }
        } else {
          sb.write_string(" a304=- ttl2=0")
        }
      }
      Ok(None) => sb.write_string(" st=0")
      Err(_) => sb.write_string(" st=0 err")
    }
    sb.write_string("\n")
    i = i + 1
  }
  io_print(world, sb.to_string())
  0
}
