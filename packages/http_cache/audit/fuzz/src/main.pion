///| Deterministic, oracle-free fuzz harness for `http_cache` (Native + Wasm32).
///| Seeded xorshift64*, 50,000 iterations of random/mutated headers, directives, dates
///| and extreme times through every public API. Checks safety invariants; any
///| violation prints `VIOLATION` and exits 1. stdout (counts + FNV digest of every
///| decision) must be byte-identical across native/wasm32 x debug/release.

import "http_cache"

struct Rng {
  mut s : UInt64
}

fn next(r : Rng) -> UInt64 {
  let mut x = r.s
  x = x ^ (x >> 12)
  x = x ^ (x << 25)
  x = x ^ (x >> 27)
  r.s = x
  x * 2685821657736338717UL
}

fn below(r : Rng, n : Int) -> Int {
  ((next(r) >> 33) % n.to_int64().to_uint64()).to_int()
}

fn pick(r : Rng, xs : Array[String]) -> String {
  xs[below(r, xs.length())]
}

struct Digest {
  mut h : UInt64
  mut violations : Int
  mut known_p2_16 : Int
}

fn mix(d : Digest, s : String) -> Unit {
  let mut i = 0
  while i < s.length() {
    d.h = (d.h ^ (s.code_unit_at(i) & 255).to_int64().to_uint64()) * 1099511628211UL
    i = i + 1
  }
  d.h = (d.h ^ 10UL) * 1099511628211UL
}

fn violation(d : Digest, world : World, what : String) -> Unit {
  d.violations = d.violations + 1
  if d.violations <= 20 {
    io_println(world, "VIOLATION " + what)
  }
}

let dir_pool : Array[String] = [
  "public", "private", "no-cache", "no-store", "must-revalidate", "proxy-revalidate",
  "must-understand", "immutable", "no-transform", "only-if-cached", "max-stale",
  "max-age=", "s-maxage=", "stale-while-revalidate=", "stale-if-error=", "min-fresh=",
  "max-stale=", "private=\"set-cookie\"", "no-cache=\"set-cookie, x\"", "x-ext=\"a,b\"",
  "MAX-AGE=", "No-Store", ",", " , ", "=", "\"", "max-age", "max-age=\"5\"", "\\",
]

let num_pool : Array[String] = [
  "0", "1", "5", "60", "3600", "2147483647", "2147483648", "2147483649",
  "99999999999999999999", "-1", "+5", "60abc", "", "00000000000000000000000000060", " 7",
]

let date_pool : Array[String] = [
  "Sun, 06 Nov 1994 08:49:37 GMT", "Sunday, 06-Nov-94 08:49:37 GMT", "Sun Nov  6 08:49:37 1994",
  "Sat, 29 Feb 2025 00:00:00 GMT", "Tue, 29 Feb 2000 00:00:00 GMT", "Fri, 31 Dec 9999 23:59:59 GMT",
  "Mon, 01 Jan 1900 00:00:00 GMT", "Thu, 01 Jan 1970 24:00:00 GMT", "0", "-1", "",
  "Tue, 14 Nov 2023 22:13:20 GMT", "Tue, 14 Nov 2023 22:23:20 GMT", "Tue, 14 Nov 2023 21:13:20 GMT",
  "Wednesday, 15-Nov-23 00:00:00 GMT", "Thu, 32 Jan 2015 00:00:00 GMT", "garbage, 01 Jan 2015",
]

let name_pool : Array[String] = [
  "Cache-Control", "cache-control", "CACHE-CONTROL", "Expires", "Date", "Last-Modified",
  "Age", "ETag", "Vary", "Pragma", "Authorization", "Set-Cookie", "Location",
  "Content-Location", "Accept-Encoding", "Cookie", "X-Junk", "Content-Length",
]

let time_pool : Array[Int64] = [
  0L, 1L, 1700000000L, 1700000030L, 1700003600L, -1L, -2208988800L, 253402300799L,
  9223372036854775807L, -9223372036854775807L, 2147483648L,
]

fn lower_ascii(s : String) -> String {
  let b = Bytes::new(s.length())
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    b[i] = (if c >= 65 && c <= 90 { c + 32 } else { c }).to_byte()
    i = i + 1
  }
  b.to_string()
}

fn mutate(r : Rng, s : String) -> String {
  if s.length() == 0 || below(r, 4) != 0 {
    return s
  }
  let b = s.to_bytes()
  let out = Bytes::new(b.length())
  let mut i = 0
  while i < b.length() {
    out[i] = b[i]
    i = i + 1
  }
  let k = below(r, out.length())
  let opts = [32, 44, 61, 34, 92, 9, 42, 0, 255, 128, 48, 57]
  out[k] = opts[below(r, opts.length())].to_byte()
  out.to_string()
}

fn gen_cc(r : Rng) -> String {
  let sb = StringBuilder::new()
  let n = below(r, 5)
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_string(pick(r, [", ", ",", " ,", ",,"]))
    }
    let d = pick(r, dir_pool)
    sb.write_string(d)
    if d.length() > 0 && d.code_unit_at(d.length() - 1) == 61 {
      sb.write_string(pick(r, num_pool))
    }
    i = i + 1
  }
  mutate(r, sb.to_string())
}

fn gen_value(r : Rng, name : String) -> String {
  let low = lower_ascii(name)
  if low == "cache-control" || low == "pragma" {
    gen_cc(r)
  } else if low == "expires" || low == "date" || low == "last-modified" {
    mutate(r, pick(r, date_pool))
  } else if low == "age" {
    pick(r, num_pool)
  } else if low == "vary" {
    mutate(r, pick(r, ["accept-encoding", "*", "Accept-Encoding, Origin", "x-junk", "", " , ", "cookie,*"]))
  } else if low == "location" || low == "content-location" {
    mutate(r, pick(r, ["/a", "../b", "//evil.example/x", "https://evil.example/", "https://h.example:443/c", "?q=1", "", "h", "https://u@h.example/", "[::1]", "https://[::1]:99999/"]))
  } else if low == "etag" {
    pick(r, ["\"a\"", "W/\"a\"", "\"b\"", ""])
  } else {
    mutate(r, pick(r, ["gzip", "br", "a=1", "Bearer x", "", "x, y"]))
  }
}

fn gen_headers(r : Rng, max : Int) -> Array[http_cache::Header] {
  let out : Array[http_cache::Header] = []
  let n = below(r, max)
  let mut i = 0
  while i < n {
    let name = pick(r, name_pool)
    out.push(http_cache::Header::new(name, gen_value(r, name)))
    i = i + 1
  }
  out
}

fn lower_has(headers : Array[http_cache::Header], name : String, needle : String) -> Bool {
  let mut i = 0
  while i < headers.length() {
    if lower_ascii(headers[i].name) == name && lower_ascii(headers[i].value).contains(needle) {
      return true
    }
    i = i + 1
  }
  false
}

fn kind(r : Result[http_cache::CacheLookup, http_cache::CacheError]) -> String {
  match r {
    Ok(http_cache::CacheLookup::Fresh(t)) => "F" + t.to_string()
    Ok(http_cache::CacheLookup::StaleWhileRevalidate(_)) => "W"
    Ok(http_cache::CacheLookup::StaleNeedsRevalidation(c)) => "R" + c.length().to_string()
    Ok(http_cache::CacheLookup::Miss) => "M"
    Ok(http_cache::CacheLookup::GatewayTimeout504) => "G"
    Err(e) => "E" + http_cache::cache_error_message(e).length().to_string()
  }
}

pub fn main(world : World) -> Int {
  let r = Rng::{ s: 0x9E3779B97F4A7C15UL }
  let d = Digest::{ h: 14695981039346656037UL, violations: 0, known_p2_16: 0 }
  let iters = 50000
  let lim = http_cache::CacheLimits::default()
  let tight = http_cache::CacheLimits::new(4096, 24, 4, 16, 512L, 8, 2048L)
  let store = match http_cache::CacheStore::new(http_cache::CachePolicyOptions::shared(), tight) {
    Ok(s) => s
    Err(_) => return 2
  }
  let pstore = match http_cache::CacheStore::new(http_cache::CachePolicyOptions::private_cache(), lim) {
    Ok(s) => s
    Err(_) => return 2
  }
  let mut n_storable = 0
  let mut n_fresh = 0
  let mut n_err = 0
  let mut n_dates = 0
  let mut it = 0
  while it < iters {
    let shared = below(r, 2) == 0
    let opts = if shared { http_cache::CachePolicyOptions::shared() } else { http_cache::CachePolicyOptions::private_cache() }
    let method = pick(r, ["GET", "GET", "GET", "HEAD", "POST", "PUT", "DELETE", "get", "OPTIONS"])
    let uri = pick(r, ["https://h.example/a", "https://h.example/b/c", "http://h.example/a", "https://H.EXAMPLE:443/a", "", "h.example/a", "https://h.example/a?x=1"])
    let statuses = [200, 203, 204, 206, 301, 302, 304, 308, 404, 500, 100, 103, 599, 600, -1, 0]
    let status = statuses[below(r, statuses.length())]
    let rq = gen_headers(r, 6)
    let rsh = gen_headers(r, 8)
    let lq = if below(r, 2) == 0 { rq } else { gen_headers(r, 6) }
    let t_req = time_pool[below(r, time_pool.length())]
    let t_resp = if below(r, 3) == 0 { time_pool[below(r, time_pool.length())] } else { t_req }
    let t_now = if below(r, 3) == 0 { time_pool[below(r, time_pool.length())] } else { t_resp + below(r, 5000).to_int64() }
    let req = http_cache::CacheRequest::new(method, uri, rq)
    let resp = http_cache::CacheResponse::new(status, rsh)

    // --- HTTP-date parse / format ---
    let ds = mutate(r, pick(r, date_pool))
    match http_cache::parse_http_date(ds) {
      Ok(ts) => {
        n_dates = n_dates + 1
        mix(d, "D" + ts.to_string())
        match http_cache::parse_http_date(http_cache::format_http_date(ts)) {
          Ok(ts2) => if ts2 != ts { violation(d, world, "date roundtrip " + ds) }
          Err(_) => violation(d, world, "format not reparsable " + ds)
        }
      }
      Err(_) => mix(d, "Dx")
    }
    let tf = -2208988800L + (next(r) % 255611289599UL).to_int64()
    match http_cache::parse_http_date(http_cache::format_http_date(tf)) {
      Ok(v) => if v != tf { violation(d, world, "format/parse " + tf.to_string()) }
      Err(_) => violation(d, world, "format unparsable " + tf.to_string())
    }

    // --- storability ---
    match http_cache::is_storable_with_options(req, resp, opts, lim) {
      Ok(true) => {
        n_storable = n_storable + 1
        mix(d, "S1")
        if lower_has(rsh, "cache-control", "no-store") && !lower_has(rsh, "cache-control", "\"") && !lower_has(rsh, "cache-control", "\\") {
          violation(d, world, "stored despite response no-store")
        }
        if lower_has(rq, "cache-control", "no-store") && !lower_has(rq, "cache-control", "\"") && !lower_has(rq, "cache-control", "\\") {
          violation(d, world, "stored despite request no-store")
        }
        if method != "GET" && method != "HEAD" {
          violation(d, world, "unsafe method storable " + method)
        }
      }
      Ok(false) => mix(d, "S0")
      Err(e) => {
        n_err = n_err + 1
        mix(d, "SE" + http_cache::cache_error_message(e).length().to_string())
      }
    }

    // --- entry / lookup / 304 ---
    match http_cache::create_entry(req, resp, Bytes::new(below(r, 64)), t_req, t_resp, opts, lim) {
      Ok(Some(e)) => {
        if e.freshness_lifetime < 0L && t_resp > 4611686018427387904L {
          d.known_p2_16 = d.known_p2_16 + 1
        } else if e.freshness_lifetime < 0L || e.freshness_lifetime > http_cache::max_delta_seconds {
          violation(d, world, "freshness out of range " + e.freshness_lifetime.to_string() + " t_resp=" + t_resp.to_string() + " status=" + status.to_string() + " hdrs=" + dump(rsh))
        }
        let age = http_cache::compute_current_age(e, t_now)
        if age < 0L || age > http_cache::max_delta_seconds {
          violation(d, world, "age out of range " + age.to_string())
        }
        let lreq = http_cache::CacheRequest::new(method, uri, lq)
        let res = http_cache::evaluate_lookup(lreq, e, t_now, opts, lim)
        let k = kind(res)
        mix(d, "L" + k)
        match res {
          Ok(http_cache::CacheLookup::Fresh(ttl)) => {
            n_fresh = n_fresh + 1
            if ttl < 0L { violation(d, world, "negative ttl") }
            if e.response_cc.no_cache && e.response_cc.no_cache_fields.length() == 0 {
              violation(d, world, "fresh despite response no-cache")
            }
            if e.vary_star { violation(d, world, "fresh with Vary *") }
            if (e.response_cc.must_revalidate || (shared && e.response_cc.proxy_revalidate)) && age >= e.freshness_lifetime {
              violation(d, world, "stale served despite must-revalidate")
            }
          }
          _ => ()
        }
        let r3 = gen_headers(r, 5)
        match http_cache::merge_304(e, http_cache::CacheResponse::new(304, r3), t_now, t_now, opts, lim) {
          Ok(m) => {
            if m.body.length() != e.body.length() { violation(d, world, "304 changed body") }
            if m.freshness_lifetime < 0L && t_now > 4611686018427387904L {
              d.known_p2_16 = d.known_p2_16 + 1
            } else if m.freshness_lifetime < 0L || m.freshness_lifetime > http_cache::max_delta_seconds {
              violation(d, world, "304 freshness out of range")
            }
            mix(d, "M" + m.freshness_lifetime.to_string() + "/" + m.initial_age.to_string())
          }
          Err(e2) => mix(d, "ME" + http_cache::cache_error_message(e2).length().to_string())
        }
      }
      Ok(None) => mix(d, "C0")
      Err(_) => mix(d, "CE")
    }

    // --- invalidation ---
    match http_cache::invalidation_targets(req, resp) {
      Ok(ts) => {
        let mut j = 0
        while j < ts.length() {
          if ts[j] != uri && !http_cache::same_origin(uri, ts[j]) {
            violation(d, world, "cross-origin invalidation " + uri + " -> " + ts[j])
          }
          mix(d, "I" + ts[j])
          j = j + 1
        }
      }
      Err(_) => mix(d, "IE")
    }

    // --- bounded stores ---
    let body = Bytes::new(below(r, 1200))
    match store.store(req, resp, body, t_req, t_resp) {
      Ok(b) => mix(d, "T" + b.to_string())
      Err(_) => mix(d, "TE")
    }
    let _ = pstore.store(req, resp, Bytes::new(below(r, 32)), t_req, t_resp)
    mix(d, "Q" + kind_store(store.lookup(http_cache::CacheRequest::new(method, uri, lq), t_now)))
    if below(r, 10) == 0 {
      match store.update_304(req, http_cache::CacheResponse::new(304, gen_headers(r, 4)), t_now, t_now) {
        Ok(_) => mix(d, "U")
        Err(_) => mix(d, "UE")
      }
    }
    match store.invalidate_for_response(req, resp) {
      Ok(n) => mix(d, "V" + n.to_string())
      Err(_) => mix(d, "VE")
    }
    if store.entry_count() > tight.max_entries || store.total_bytes() > tight.max_total_bytes || store.total_bytes() < 0L || store.entry_count() < 0 {
      violation(d, world, "store bounds count=" + store.entry_count().to_string() + " bytes=" + store.total_bytes().to_string())
    }
    if pstore.entry_count() > lim.max_entries {
      violation(d, world, "pstore bounds")
    }
    it = it + 1
  }
  io_println(world, "iters=" + iters.to_string() + " storable=" + n_storable.to_string() + " fresh=" + n_fresh.to_string() + " err=" + n_err.to_string() + " dates=" + n_dates.to_string() + " store=" + store.entry_count().to_string() + "/" + store.total_bytes().to_string() + " known_p2_16_negative_heuristic=" + d.known_p2_16.to_string() + " violations=" + d.violations.to_string())
  io_println(world, "digest=" + d.h.to_string())
  if d.violations > 0 { 1 } else { 0 }
}

fn dump(hs : Array[http_cache::Header]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < hs.length() {
    sb.write_string("[" + hs[i].name + ": " + hs[i].value + "]")
    i = i + 1
  }
  sb.to_string()
}

fn kind_store(r : Result[http_cache::StoreLookup, http_cache::CacheError]) -> String {
  match r {
    Ok(http_cache::StoreLookup::HitFresh(e, t)) => "F" + t.to_string() + ":" + e.body.length().to_string()
    Ok(http_cache::StoreLookup::HitStaleWhileRevalidate(_, _)) => "W"
    Ok(http_cache::StoreLookup::NeedsRevalidation(_, c)) => "R" + c.length().to_string()
    Ok(http_cache::StoreLookup::Miss) => "M"
    Ok(http_cache::StoreLookup::GatewayTimeout504) => "G"
    Err(_) => "E"
  }
}
