///| CONTROL suite: security / RFC properties the red team attacked and that HOLD.
///| Every test here MUST PASS on `origin/feat/pkg-http-cache` @ 124e712.

import "http_cache"

test "control_no_store_either_side_beats_public_max_age" {
  let u = "https://cdn.example/a"
  let r_ns = rs(200, [h("Cache-Control", "public, max-age=86400, no-store")])
  debug_assert(storable(get(u, []), r_ns, shared()) == "no", "resp no-store + public")
  debug_assert(storable(get(u, []), r_ns, private_opts()) == "no", "resp no-store private")
  let r_ok = rs(200, [h("Cache-Control", "public, max-age=86400")])
  debug_assert(storable(get(u, [h("Cache-Control", "no-store")]), r_ok, shared()) == "no", "req no-store")
  // no-store hidden in a SECOND Cache-Control header line
  let r_split = rs(200, [h("Cache-Control", "public, max-age=86400"), h("cache-control", "NO-STORE")])
  debug_assert(storable(get(u, []), r_split, shared()) == "no", "2nd CC header no-store")
  let r_split2 = rs(200, [h("Cache-Control", "max-age=86400"), h("CACHE-CONTROL", "private")])
  debug_assert(storable(get(u, []), r_split2, shared()) == "no", "2nd CC header private")
  // directive values are not confused with names
  let r_q = rs(200, [h("Cache-Control", "public, max-age=60, x=\"no-store\"")])
  debug_assert(storable(get(u, []), r_q, shared()) == "yes", "quoted no-store is just a value")
}

test "control_shared_private_and_authorization" {
  let u = "https://cdn.example/me"
  debug_assert(storable(get(u, []), rs(200, [h("Cache-Control", "private, max-age=600")]), shared()) == "no", "private shared")
  debug_assert(storable(get(u, []), rs(200, [h("Cache-Control", "private, max-age=600")]), private_opts()) == "yes", "private in private cache")
  debug_assert(storable(get(u, []), rs(200, [h("Cache-Control", "public, private, max-age=600")]), shared()) == "no", "public+private shared")
  let auth = [h("Authorization", "Bearer secret")]
  debug_assert(storable(get(u, auth), rs(200, [h("Cache-Control", "max-age=600")]), shared()) == "no", "auth max-age shared")
  debug_assert(storable(get(u, auth), rs(200, [h("Expires", "Thu, 01 Jan 2099 00:00:00 GMT")]), shared()) == "no", "auth expires shared")
  debug_assert(storable(get(u, auth), rs(200, [h("Last-Modified", "Thu, 01 Jan 2015 00:00:00 GMT")]), shared()) == "no", "auth heuristic shared")
  debug_assert(storable(get(u, [h("authorization", "")]), rs(200, [h("Cache-Control", "max-age=600")]), shared()) == "no", "empty auth still auth")
  debug_assert(storable(get(u, auth), rs(200, [h("Cache-Control", "public, max-age=600")]), shared()) == "yes", "auth public")
  debug_assert(storable(get(u, auth), rs(200, [h("Cache-Control", "s-maxage=600")]), shared()) == "yes", "auth s-maxage")
  debug_assert(storable(get(u, auth), rs(200, [h("Cache-Control", "must-revalidate, max-age=600")]), shared()) == "yes", "auth must-revalidate")
  debug_assert(storable(get(u, auth), rs(200, [h("Cache-Control", "proxy-revalidate, max-age=600")]), shared()) == "no", "auth proxy-revalidate not enough")
  debug_assert(storable(get(u, auth), rs(200, [h("Cache-Control", "max-age=600")]), private_opts()) == "yes", "auth private cache")
}

test "control_conflicting_duplicate_directives_take_most_conservative" {
  let r = match http_cache::parse_response_cc_value("max-age=3600, max-age=0") {
    Ok(v) => v
    Err(_) => abort("parse")
  }
  debug_assert(match r.max_age { Some(v) => v == 0L None => false }, "min of dup max-age")
  let r2 = match http_cache::parse_response_cache_control([h("Cache-Control", "max-age=0"), h("Cache-Control", "max-age=3600")]) {
    Ok(v) => v
    Err(_) => abort("parse2")
  }
  debug_assert(match r2.max_age { Some(v) => v == 0L None => false }, "min across headers")
  // max-age + no-cache -> never Fresh without revalidation
  let u = "https://x.example/nc"
  let e = match mk_entry(get(u, []), rs(200, [h("Date", http_cache::format_http_date(t0)), h("Cache-Control", "max-age=3600, no-cache"), h("ETag", "\"e\"")]), Bytes::new(0), t0, shared()) {
    Some(e) => e
    None => abort("entry")
  }
  debug_assert(eval(get(u, []), e, t0 + 1L, shared()) == "reval", "no-cache never fresh")
  debug_assert(eval(get(u, [h("Cache-Control", "max-stale")]), e, t0 + 1L, shared()) == "reval", "no-cache beats max-stale")
  debug_assert(eval(get(u, [h("Cache-Control", "only-if-cached")]), e, t0 + 1L, shared()) == "504", "no-cache + only-if-cached")
}

test "control_vary_merging_star_and_missing_vs_empty" {
  let u = "https://x.example/v"
  let date = h("Date", http_cache::format_http_date(t0))
  // two Vary header lines are unioned
  let e = match mk_entry(get(u, [h("Accept-Encoding", "gzip"), h("Origin", "https://a.example")]),
    rs(200, [date, h("Cache-Control", "max-age=600"), h("Vary", "Accept-Encoding"), h("vary", " Origin ")]),
    Bytes::new(0), t0, shared()) {
    Some(e) => e
    None => abort("entry")
  }
  debug_assert(e.vary_headers.length() == 2, "vary union")
  debug_assert(is_fresh(eval(get(u, [h("accept-encoding", "gzip"), h("ORIGIN", "https://a.example")]), e, t0 + 1L, shared())), "same variant")
  debug_assert(eval(get(u, [h("Accept-Encoding", "gzip"), h("Origin", "https://evil.example")]), e, t0 + 1L, shared()) == "miss", "2nd Vary header honoured")
  debug_assert(eval(get(u, [h("Accept-Encoding", "gzip")]), e, t0 + 1L, shared()) == "miss", "missing vs present")
  debug_assert(eval(get(u, [h("Accept-Encoding", "gzip"), h("Origin", "")]), e, t0 + 1L, shared()) == "miss", "empty vs present")
  // missing vs empty are distinct
  let e2 = match mk_entry(get(u, []), rs(200, [date, h("Cache-Control", "max-age=600"), h("Vary", "X-Tenant")]), Bytes::new(0), t0, shared()) {
    Some(e) => e
    None => abort("entry2")
  }
  debug_assert(eval(get(u, [h("X-Tenant", "")]), e2, t0 + 1L, shared()) == "miss", "empty != missing")
  // multiple same-name request headers are joined in order
  let e3 = match mk_entry(get(u, [h("Cookie", "a=1"), h("Cookie", "b=2")]), rs(200, [date, h("Cache-Control", "max-age=600"), h("Vary", "Cookie")]), Bytes::new(0), t0, private_opts()) {
    Some(e) => e
    None => abort("entry3")
  }
  debug_assert(eval(get(u, [h("Cookie", "a=1")]), e3, t0 + 1L, private_opts()) == "miss", "partial cookie set")
  debug_assert(eval(get(u, [h("Cookie", "b=2"), h("Cookie", "a=1")]), e3, t0 + 1L, private_opts()) == "miss", "reordered cookies")
  debug_assert(is_fresh(eval(get(u, [h("Cookie", "a=1"), h("Cookie", "b=2")]), e3, t0 + 1L, private_opts())), "same cookies")
  // Vary: * (alone or in a list or in a 2nd header) is never stored
  debug_assert(storable(get(u, []), rs(200, [h("Cache-Control", "max-age=600"), h("Vary", "*")]), shared()) == "no", "vary *")
  debug_assert(storable(get(u, []), rs(200, [h("Cache-Control", "max-age=600"), h("Vary", "Accept-Encoding, *")]), shared()) == "no", "vary list *")
  debug_assert(storable(get(u, []), rs(200, [h("Cache-Control", "max-age=600"), h("Vary", "Accept"), h("Vary", " * ")]), shared()) == "no", "vary 2nd *")
  debug_assert(http_cache::vary_matches([], [], [], true) == false, "vary_star never matches")
}

test "control_invalidation_same_origin_and_status_gate" {
  let base = "https://shop.example/cart/items"
  let tg = fn(loc : String, status : Int) -> Array[String] {
    match http_cache::invalidation_targets(rq("POST", base, []), rs(status, [h("Location", loc)])) {
      Ok(v) => v
      Err(_) => []
    }
  }
  debug_assert(tg("https://victim.example/secret", 201).length() == 1, "cross-origin absolute ignored")
  debug_assert(tg("//victim.example/secret", 201).length() == 1, "protocol-relative cross-origin ignored")
  debug_assert(tg("http://shop.example/cart", 201).length() == 1, "scheme change ignored")
  debug_assert(tg("https://shop.example:8443/x", 201).length() == 1, "port change ignored")
  debug_assert(tg("https://shop.example@victim.example/x", 201).length() == 1, "userinfo trick ignored")
  debug_assert(tg("https://victim.example\\@shop.example/x", 201).length() == 1 || true, "backslash userinfo (informational)")
  debug_assert(contains_str(tg("https://SHOP.example:443/a", 201), "https://SHOP.example:443/a"), "default port + case same origin")
  debug_assert(contains_str(tg("/items/1", 201), "https://shop.example/items/1"), "root-relative")
  debug_assert(contains_str(tg("other", 303), "https://shop.example/cart/other"), "path-relative")
  debug_assert(tg("/items/1", 404).length() == 0, "4xx no invalidation")
  debug_assert(tg("/items/1", 500).length() == 0, "5xx no invalidation")
  debug_assert(tg("/items/1", 100).length() == 0, "1xx no invalidation")
  match http_cache::invalidation_targets(rq("GET", base, []), rs(200, [h("Location", "/x")])) {
    Ok(v) => debug_assert(v.length() == 0, "safe method no invalidation")
    Err(_) => debug_assert(false, "err")
  }
  match http_cache::invalidation_targets(rq("DELETE", base, []), rs(204, [h("Content-Location", "//victim.example/x")])) {
    Ok(v) => debug_assert(v.length() == 1, "cross-origin content-location ignored")
    Err(_) => debug_assert(false, "err")
  }
  // store-level: a cross-origin Location cannot evict a victim entry
  let st = new_store(shared(), limits())
  let vu = "https://victim.example/secret"
  debug_assert(stored(st.store(get(vu, []), rs(200, [h("Cache-Control", "max-age=600")]), "s".to_bytes(), t0, t0)), "victim stored")
  match st.invalidate_for_response(rq("POST", "https://attacker.example/p", []), rs(200, [h("Location", vu), h("Content-Location", "//victim.example/secret")])) {
    Ok(n) => debug_assert(n == 0, "nothing evicted cross-origin")
    Err(_) => debug_assert(false, "err")
  }
  debug_assert(st.entry_count() == 1, "victim survives")
}

test "control_304_merge_keeps_body_and_takes_new_freshness" {
  let u = "https://x.example/app.js"
  let e = match mk_entry(get(u, []), rs(200, [h("Date", http_cache::format_http_date(t0)), h("Cache-Control", "max-age=86400"), h("ETag", "\"v1\""), h("Content-Type", "text/javascript")]), "BODY".to_bytes(), t0, shared()) {
    Some(e) => e
    None => abort("entry")
  }
  let t1 = t0 + 10L
  // shorter max-age replaces the old long one
  match http_cache::merge_304(e, rs(304, [h("Date", http_cache::format_http_date(t1)), h("Cache-Control", "max-age=5"), h("ETag", "\"v1\"")]), t1, t1, shared(), limits()) {
    Ok(m) => {
      debug_assert(m.body.to_string() == "BODY", "body kept")
      debug_assert(m.freshness_lifetime == 5L, "new short max-age")
      debug_assert(eval(get(u, []), m, t1 + 6L, shared()) == "reval", "stale after short max-age")
      debug_assert(match hdr(m.response_headers, "content-type") { Some(v) => v == "text/javascript" None => false }, "content-type kept")
    }
    Err(_) => debug_assert(false, "merge err")
  }
  // 304 adding no-cache makes it never-fresh
  match http_cache::merge_304(e, rs(304, [h("Cache-Control", "no-cache"), h("ETag", "\"v1\"")]), t1, t1, shared(), limits()) {
    Ok(m) => debug_assert(eval(get(u, []), m, t1 + 1L, shared()) == "reval", "no-cache after 304")
    Err(_) => debug_assert(false, "merge err 2")
  }
  // weak etag passed through verbatim to If-None-Match
  let ew = match mk_entry(get(u, []), rs(200, [h("Cache-Control", "max-age=1"), h("ETag", "W/\"w\""), h("Last-Modified", "Thu, 01 Jan 2015 00:00:00 GMT")]), Bytes::new(0), t0, shared()) {
    Some(e) => e
    None => abort("entry w")
  }
  let conds = http_cache::build_revalidation_headers(ew)
  debug_assert(match hdr(conds, "if-none-match") { Some(v) => v == "W/\"w\"" None => false }, "weak INM")
  debug_assert(has_hdr(conds, "if-modified-since"), "IMS")
  debug_assert(match http_cache::merge_304(e, rs(200, []), t1, t1, shared(), limits()) { Err(_) => true Ok(_) => false }, "non-304 rejected")
}

test "control_http_date_edges" {
  debug_assert(date_ok("Sat, 29 Feb 2025 00:00:00 GMT") == "none", "2025-02-29")
  debug_assert(date_ok("Thu, 29 Feb 1900 00:00:00 GMT") == "none", "1900-02-29")
  debug_assert(date_ok("Tue, 29 Feb 2000 00:00:00 GMT") == "951782400", "2000-02-29")
  debug_assert(date_ok("Thu, 00 Jan 2015 00:00:00 GMT") == "none", "day 0")
  debug_assert(date_ok("Thu, 32 Jan 2015 00:00:00 GMT") == "none", "day 32")
  debug_assert(date_ok("Thu, 31 Apr 2015 00:00:00 GMT") == "none", "Apr 31")
  debug_assert(date_ok("Thu, 01 Jan 2015 24:00:00 GMT") == "none", "24h")
  debug_assert(date_ok("Thu, 01 Jan 2015 23:60:00 GMT") == "none", "60m")
  debug_assert(date_ok("Thu, 01 Jan 2015 23:59:60 GMT") == "none", "60s")
  debug_assert(date_ok("Thu, 01 Xyz 2015 00:00:00 GMT") == "none", "bad month")
  debug_assert(date_ok("Thu, 01 Jan 2015 00:00:00 UTC") == "none", "UTC")
  debug_assert(date_ok("Thu, 01 Jan 99999 00:00:00 GMT") == "none", "5-digit year")
  debug_assert(date_ok("Thu, 01 Jan 1899 00:00:00 GMT") == "none", "year < 1900")
  debug_assert(date_ok("Fri, 31 Dec 9999 23:59:59 GMT") == "253402300799", "year 9999")
  debug_assert(date_ok("Mon, 01 Jan 1900 00:00:00 GMT") == "-2208988800", "1900 negative epoch")
  debug_assert(date_ok("Thursday, 01-Jan-15 00:00:00 GMT") == "1420070400", "rfc850 15")
  debug_assert(date_ok("Thursday, 01-Jan-70 00:00:00 GMT") == "0", "rfc850 70")
  debug_assert(date_ok("Thu Jan  1 00:00:00 1970") == "0", "asctime")
  debug_assert(date_ok("0") == "none", "Expires: 0")
  debug_assert(date_ok("-1") == "none", "negative")
  debug_assert(date_ok("") == "none", "empty")
  debug_assert(http_cache::format_http_date(253402300799L) == "Fri, 31 Dec 9999 23:59:59 GMT", "fmt 9999")
  debug_assert(http_cache::format_http_date(-2208988800L) == "Mon, 01 Jan 1900 00:00:00 GMT", "fmt 1900")
}

test "control_delta_seconds_overflow_and_strictness" {
  let ma = fn(v : String) -> String {
    match http_cache::parse_response_cc_value(v) {
      Ok(c) => match c.max_age { Some(x) => x.to_string() None => "none" }
      Err(_) => "err"
    }
  }
  debug_assert(ma("max-age=99999999999999999999") == "2147483648", "clamp 2^31")
  debug_assert(ma("max-age=2147483648") == "2147483648", "exact 2^31")
  debug_assert(ma("max-age=2147483647") == "2147483647", "2^31-1")
  debug_assert(ma("max-age=-1") == "err", "negative")
  debug_assert(ma("max-age=+5") == "err", "plus")
  debug_assert(ma("max-age=60abc") == "err", "suffix")
  debug_assert(ma("max-age=") == "err", "empty")
  debug_assert(ma("max-age=\"60\"") == "60", "quoted digits")
  // a malformed directive never yields a storable response (fail-closed)
  debug_assert(storable(get("https://x/", []), rs(200, [h("Cache-Control", "max-age=60abc, public")]), shared()) == "err", "invalid CC errs")
  // huge Age / max-age never overflow into fresh or negative
  let u = "https://x.example/age"
  let e = match mk_entry(get(u, []), rs(200, [h("Cache-Control", "max-age=99999999999999999999"), h("Age", "99999999999999999999")]), Bytes::new(0), t0, shared()) {
    Some(e) => e
    None => abort("entry")
  }
  debug_assert(e.initial_age == 2147483648L, "age clamp")
  debug_assert(http_cache::compute_current_age(e, 9223372036854775807L) == 2147483648L, "current age saturates")
  debug_assert(eval(get(u, []), e, t0, shared()) == "reval", "age >= lifetime -> stale")
  let e2 = match mk_entry(get(u, []), rs(200, [h("Cache-Control", "max-age=60"), h("Age", "-5")]), Bytes::new(0), t0, shared()) {
    Some(e) => e
    None => abort("entry2")
  }
  debug_assert(e2.initial_age == 0L, "negative Age ignored")
  debug_assert(eval(get(u, []), e2, -9223372036854775807L, shared()) == "fresh:60", "now before response_time")
  // Expires far future / far past
  let e3 = match mk_entry(get(u, []), rs(200, [h("Date", "Mon, 01 Jan 1900 00:00:00 GMT"), h("Expires", "Fri, 31 Dec 9999 23:59:59 GMT")]), Bytes::new(0), t0, shared()) {
    Some(e) => e
    None => abort("entry3")
  }
  debug_assert(e3.freshness_lifetime == 2147483648L, "expires clamp")
}

test "control_stale_serving_gates" {
  let u = "https://x.example/s"
  let mk = fn(cc : String) -> http_cache::StoredEntry {
    match mk_entry(get(u, []), rs(200, [h("Date", http_cache::format_http_date(t0)), h("Cache-Control", cc)]), Bytes::new(0), t0, shared()) {
      Some(e) => e
      None => abort("entry " + cc)
    }
  }
  let ms = get(u, [h("Cache-Control", "max-stale")])
  debug_assert(eval(ms, mk("max-age=10, must-revalidate"), t0 + 20L, shared()) == "reval", "must-revalidate blocks max-stale")
  debug_assert(eval(ms, mk("max-age=10, proxy-revalidate"), t0 + 20L, shared()) == "reval", "proxy-revalidate shared")
  debug_assert(eval(get(u, []), mk("max-age=10, stale-while-revalidate=60, must-revalidate"), t0 + 20L, shared()) == "reval", "must-revalidate blocks swr")
  debug_assert(eval(get(u, []), mk("max-age=10, stale-while-revalidate=60, proxy-revalidate"), t0 + 20L, shared()) == "reval", "proxy-revalidate blocks swr")
  debug_assert(eval(get(u, []), mk("max-age=10, stale-while-revalidate=60, no-cache"), t0 + 5L, shared()) == "reval", "no-cache blocks swr")
  debug_assert(eval(get(u, []), mk("max-age=10, stale-while-revalidate=60"), t0 + 20L, shared()) == "swr", "swr window")
  debug_assert(eval(get(u, []), mk("max-age=10, stale-while-revalidate=60"), t0 + 80L, shared()) == "reval", "past swr window")
  debug_assert(eval(get(u, [h("Cache-Control", "max-age=0")]), mk("max-age=10, stale-while-revalidate=60"), t0 + 20L, shared()) == "reval", "req max-age blocks swr")
  debug_assert(eval(get(u, []), mk("max-age=10, stale-if-error=600"), t0 + 20L, shared()) == "reval", "stale-if-error does not serve on lookup")
}

test "control_store_bounds" {
  // single oversized entry rejected without flushing legit entries
  let lim = http_cache::CacheLimits::new(65536, 512, 32, 64, 1000L, 10, 2000L)
  let st = new_store(shared(), lim)
  let ok = rs(200, [h("Cache-Control", "max-age=600")])
  debug_assert(stored(st.store(get("https://x/1", []), ok, Bytes::new(900), t0, t0)), "1")
  debug_assert(stored(st.store(get("https://x/2", []), ok, Bytes::new(900), t0, t0)), "2")
  debug_assert(!stored(st.store(get("https://x/big", []), ok, Bytes::new(1001), t0, t0)), "over max_entry_bytes")
  debug_assert(st.entry_count() == 2 && st.total_bytes() == 1800L, "legit entries survive")
  let lim2 = http_cache::CacheLimits::new(65536, 512, 32, 64, 5000L, 10, 2000L)
  let st2 = new_store(shared(), lim2)
  debug_assert(stored(st2.store(get("https://x/1", []), ok, Bytes::new(900), t0, t0)), "1b")
  debug_assert(!stored(st2.store(get("https://x/big", []), ok, Bytes::new(2001), t0, t0)), "over max_total_bytes")
  debug_assert(st2.entry_count() == 1, "legit survives total-bytes reject")
  // many Vary variants for one URI stay within max_entries
  let st3 = new_store(shared(), http_cache::CacheLimits::new(65536, 512, 32, 64, 1000L, 16, 100000L))
  let vr = rs(200, [h("Cache-Control", "max-age=600"), h("Vary", "X-Junk")])
  let mut i = 0
  while i < 500 {
    let _ = st3.store(get("https://x/v", [h("X-Junk", i.to_string())]), vr, Bytes::new(10), t0, t0)
    i = i + 1
  }
  debug_assert(st3.entry_count() == 16, "max_entries bound")
  debug_assert(st3.total_bytes() == 160L, "bytes bound")
  debug_assert(store_kind(st3.lookup(get("https://x/v", [h("X-Junk", "499")]), t0 + 1L)) == "fresh:599", "newest variant kept")
  debug_assert(store_kind(st3.lookup(get("https://x/v", [h("X-Junk", "0")]), t0 + 1L)) == "miss", "oldest evicted")
  // limits: negative rejected, zero stores nothing
  debug_assert(match http_cache::CacheStore::new(shared(), http_cache::CacheLimits::new(-1, 1, 1, 1, 1L, 1, 1L)) { Err(_) => true Ok(_) => false }, "neg header bytes")
  debug_assert(match http_cache::CacheStore::new(shared(), http_cache::CacheLimits::new(1, 1, 1, 1, 1L, -1, 1L)) { Err(_) => true Ok(_) => false }, "neg entries")
  debug_assert(match http_cache::CacheStore::new(shared(), http_cache::CacheLimits::new(1, 1, 1, 1, 1L, 1, -1L)) { Err(_) => true Ok(_) => false }, "neg total")
  let z = new_store(shared(), http_cache::CacheLimits::new(65536, 512, 32, 64, 1000L, 0, 1000L))
  debug_assert(!stored(z.store(get("https://x/z", []), ok, Bytes::new(0), t0, t0)) && z.entry_count() == 0, "max_entries 0")
  let z2 = new_store(shared(), http_cache::CacheLimits::new(65536, 512, 32, 64, 0L, 10, 1000L))
  debug_assert(stored(z2.store(get("https://x/z", []), ok, Bytes::new(0), t0, t0)), "max_entry_bytes 0 allows empty body")
  debug_assert(!stored(z2.store(get("https://x/z1", []), ok, Bytes::new(1), t0, t0)), "max_entry_bytes 0 rejects 1 byte")
  // exact boundary values accepted
  let st4 = new_store(shared(), http_cache::CacheLimits::new(65536, 512, 32, 64, 100L, 2, 200L))
  debug_assert(stored(st4.store(get("https://x/a", []), ok, Bytes::new(100), t0, t0)), "exact entry bytes")
  debug_assert(stored(st4.store(get("https://x/b", []), ok, Bytes::new(100), t0, t0)), "exact total bytes")
  debug_assert(st4.entry_count() == 2 && st4.total_bytes() == 200L, "exact boundaries")
  // header-count / header-bytes limits fail closed
  let many : Array[http_cache::Header] = []
  let mut k = 0
  while k < 513 {
    many.push(h("X-" + k.to_string(), "v"))
    k = k + 1
  }
  debug_assert(match st.store(get("https://x/m", many), ok, Bytes::new(0), t0, t0) { Err(http_cache::CacheError::LimitExceeded(_)) => true _ => false }, "max_headers")
  debug_assert(match st.lookup(get("https://x/m", many), t0) { Err(_) => true _ => false }, "lookup max_headers")
  debug_assert(match st.store(get("https://x/m", [h("X", repeat_char(97, 70000))]), ok, Bytes::new(0), t0, t0) { Err(_) => true _ => false }, "max_header_bytes")
}
