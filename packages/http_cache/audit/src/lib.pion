///| Red-team audit helpers for `packages/http_cache` (public API only).

import "http_cache"

pub fn h(name : String, value : String) -> http_cache::Header {
  http_cache::Header::new(name, value)
}

pub fn get(uri : String, headers : Array[http_cache::Header]) -> http_cache::CacheRequest {
  http_cache::CacheRequest::new("GET", uri, headers)
}

pub fn rq(method : String, uri : String, headers : Array[http_cache::Header]) -> http_cache::CacheRequest {
  http_cache::CacheRequest::new(method, uri, headers)
}

pub fn rs(status : Int, headers : Array[http_cache::Header]) -> http_cache::CacheResponse {
  http_cache::CacheResponse::new(status, headers)
}

pub fn shared() -> http_cache::CachePolicyOptions {
  http_cache::CachePolicyOptions::shared()
}

pub fn private_opts() -> http_cache::CachePolicyOptions {
  http_cache::CachePolicyOptions::private_cache()
}

pub fn limits() -> http_cache::CacheLimits {
  http_cache::CacheLimits::default()
}

fn lower_eq(a : String, b_lower : String) -> Bool {
  if a.length() != b_lower.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    let c = a.code_unit_at(i)
    let l = if c >= 65 && c <= 90 { c + 32 } else { c }
    if l != b_lower.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Case-insensitive header lookup (first value).
pub fn hdr(headers : Array[http_cache::Header], name_lower : String) -> Option[String] {
  let mut i = 0
  while i < headers.length() {
    if lower_eq(headers[i].name, name_lower) {
      return Some(headers[i].value)
    }
    i = i + 1
  }
  None
}

pub fn has_hdr(headers : Array[http_cache::Header], name_lower : String) -> Bool {
  match hdr(headers, name_lower) {
    Some(_) => true
    None => false
  }
}

pub fn new_store(opts : http_cache::CachePolicyOptions, lim : http_cache::CacheLimits) -> http_cache::CacheStore {
  match http_cache::CacheStore::new(opts, lim) {
    Ok(s) => s
    Err(_) => abort("CacheStore::new failed")
  }
}

pub fn stored(r : Result[Bool, http_cache::CacheError]) -> Bool {
  match r {
    Ok(true) => true
    _ => false
  }
}

pub fn storable(
  req : http_cache::CacheRequest,
  resp : http_cache::CacheResponse,
  opts : http_cache::CachePolicyOptions,
) -> String {
  match http_cache::is_storable_with_options(req, resp, opts, limits()) {
    Ok(true) => "yes"
    Ok(false) => "no"
    Err(_) => "err"
  }
}

pub fn mk_entry(
  req : http_cache::CacheRequest,
  resp : http_cache::CacheResponse,
  body : Bytes,
  t : Int64,
  opts : http_cache::CachePolicyOptions,
) -> Option[http_cache::StoredEntry] {
  match http_cache::create_entry(req, resp, body, t, t, opts, limits()) {
    Ok(v) => v
    Err(_) => None
  }
}

pub fn lookup_kind(r : Result[http_cache::CacheLookup, http_cache::CacheError]) -> String {
  match r {
    Ok(http_cache::CacheLookup::Fresh(ttl)) => "fresh:" + ttl.to_string()
    Ok(http_cache::CacheLookup::StaleWhileRevalidate(_)) => "swr"
    Ok(http_cache::CacheLookup::StaleNeedsRevalidation(_)) => "reval"
    Ok(http_cache::CacheLookup::Miss) => "miss"
    Ok(http_cache::CacheLookup::GatewayTimeout504) => "504"
    Err(_) => "err"
  }
}

pub fn eval(
  req : http_cache::CacheRequest,
  entry : http_cache::StoredEntry,
  now : Int64,
  opts : http_cache::CachePolicyOptions,
) -> String {
  lookup_kind(http_cache::evaluate_lookup(req, entry, now, opts, limits()))
}

pub fn store_kind(r : Result[http_cache::StoreLookup, http_cache::CacheError]) -> String {
  match r {
    Ok(http_cache::StoreLookup::HitFresh(_, ttl)) => "fresh:" + ttl.to_string()
    Ok(http_cache::StoreLookup::HitStaleWhileRevalidate(_, _)) => "swr"
    Ok(http_cache::StoreLookup::NeedsRevalidation(_, _)) => "reval"
    Ok(http_cache::StoreLookup::Miss) => "miss"
    Ok(http_cache::StoreLookup::GatewayTimeout504) => "504"
    Err(_) => "err"
  }
}

pub fn starts_with(s : String, p : String) -> Bool {
  if p.length() > s.length() {
    return false
  }
  let mut i = 0
  while i < p.length() {
    if s.code_unit_at(i) != p.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

pub fn is_fresh(kind : String) -> Bool {
  starts_with(kind, "fresh")
}

pub fn date_ok(s : String) -> String {
  match http_cache::parse_http_date(s) {
    Ok(v) => v.to_string()
    Err(_) => "none"
  }
}

pub fn contains_str(arr : Array[String], s : String) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == s {
      return true
    }
    i = i + 1
  }
  false
}

pub fn repeat_char(c : Int, n : Int) -> String {
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = c.to_byte()
    i = i + 1
  }
  b.to_string()
}

pub let t0 : Int64 = 1700000000L
