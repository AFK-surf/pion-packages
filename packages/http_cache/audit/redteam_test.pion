///| RED-TEAM suite: each test asserts the RFC 9111-correct / safe behaviour for one
///| confirmed finding. On `origin/feat/pkg-http-cache` @ 124e712 every test here
///| FAILS (that failure *is* the reproduction). A fix flips it to PASS.
///| Naming: redteam_<severity>_<id>_<what>. See README.md for root cause & fix.

import "http_cache"

fn date0() -> http_cache::Header {
  h("Date", http_cache::format_http_date(t0))
}

// ---------------------------------------------------------------------------
// P0-1  Shared cache stores & replays Set-Cookie of `private="Set-Cookie"`
// ---------------------------------------------------------------------------
test "redteam_p0_1_shared_private_qualified_set_cookie_replayed_to_other_users" {
  let st = new_store(shared(), limits())
  let u = "https://shop.example/home"
  let victim = get(u, [h("Cookie", "sid=VICTIM")])
  let resp = rs(200, [
    date0(),
    h("Cache-Control", "public, max-age=600, private=\"Set-Cookie\""),
    h("Set-Cookie", "sid=VICTIM-SESSION; HttpOnly"),
    h("Content-Type", "text/html"),
  ])
  debug_assert(stored(st.store(victim, resp, "<html>".to_bytes(), t0, t0)), "stored")
  // a different, anonymous user now hits the shared cache
  match st.lookup(get(u, []), t0 + 1L) {
    Ok(http_cache::StoreLookup::HitFresh(e, _)) =>
    debug_assert(!has_hdr(e.response_headers, "set-cookie"),
      "P0-1: shared cache replays victim Set-Cookie listed in private=\"Set-Cookie\" (RFC 9111 §5.2.2.7 MUST NOT store)")
    _ => () // not served fresh -> safe
  }
}

test "redteam_p0_1b_no_cache_qualified_set_cookie_served_without_revalidation" {
  let st = new_store(shared(), limits())
  let u = "https://shop.example/home2"
  let resp = rs(200, [
    date0(),
    h("Cache-Control", "public, max-age=600, no-cache=\"Set-Cookie\""),
    h("Set-Cookie", "sid=VICTIM-SESSION"),
  ])
  debug_assert(stored(st.store(get(u, []), resp, "x".to_bytes(), t0, t0)), "stored")
  match st.lookup(get(u, []), t0 + 1L) {
    Ok(http_cache::StoreLookup::HitFresh(e, _)) =>
    debug_assert(!has_hdr(e.response_headers, "set-cookie"),
      "P0-1b: no-cache=\"Set-Cookie\" field returned on fresh hit without revalidation (RFC 9111 §5.2.2.4)")
    _ => ()
  }
}

// ---------------------------------------------------------------------------
// P1-2  206 Partial Content stored as a complete response (CPDoS)
// ---------------------------------------------------------------------------
test "redteam_p1_2_206_partial_poisons_full_get" {
  let st = new_store(shared(), limits())
  let u = "https://cdn.example/video.mp4"
  let attacker = get(u, [h("Range", "bytes=0-0")])
  let resp = rs(206, [date0(), h("Cache-Control", "public, max-age=3600"), h("Content-Range", "bytes 0-0/1000000"), h("Content-Length", "1")])
  let _ = st.store(attacker, resp, "A".to_bytes(), t0, t0)
  let k = store_kind(st.lookup(get(u, []), t0 + 1L))
  debug_assert(!is_fresh(k),
    "P1-2: a 1-byte 206 from an attacker Range request is served fresh to every full GET (RFC 9111 §3.3/§3.4)")
}

test "redteam_p1_2b_206_heuristic_storable_without_cc" {
  let r = rs(206, [date0(), h("Last-Modified", "Thu, 01 Jan 2015 00:00:00 GMT"), h("Content-Range", "bytes 0-9/100")])
  debug_assert(storable(get("https://cdn.example/f", [h("Range", "bytes=0-9")]), r, shared()) == "no",
    "P1-2b: 206 heuristically storable as a complete response")
}

// ---------------------------------------------------------------------------
// P1-3  304 merge overwrites Content-Length / Content-Encoding / Content-Range
// ---------------------------------------------------------------------------
test "redteam_p1_3_304_overwrites_content_length_of_stored_body" {
  let u = "https://x.example/app.js"
  let e = match mk_entry(get(u, []), rs(200, [date0(), h("Cache-Control", "max-age=10"), h("ETag", "\"v1\""), h("Content-Length", "10")]), "0123456789".to_bytes(), t0, shared()) {
    Some(e) => e
    None => abort("entry")
  }
  match http_cache::merge_304(e, rs(304, [h("ETag", "\"v1\""), h("Cache-Control", "max-age=600"), h("Content-Length", "0"), h("Content-Encoding", "gzip")]), t0 + 20L, t0 + 20L, shared(), limits()) {
    Ok(m) => {
      let cl = match hdr(m.response_headers, "content-length") { Some(v) => v None => "-" }
      debug_assert(cl == "10" && !has_hdr(m.response_headers, "content-encoding"),
        "P1-3: merged entry advertises Content-Length=" + cl + " / Content-Encoding for an unchanged 10-byte identity body (RFC 9111 §3.2)")
    }
    Err(_) => ()
  }
}

// ---------------------------------------------------------------------------
// P1-4  304 with a different strong validator still refreshes the stored entry
// ---------------------------------------------------------------------------
test "redteam_p1_4_304_strong_etag_mismatch_still_updates" {
  let st = new_store(shared(), limits())
  let u = "https://x.example/doc"
  debug_assert(stored(st.store(get(u, []), rs(200, [date0(), h("Cache-Control", "max-age=10"), h("ETag", "\"v1\"")]), "OLD".to_bytes(), t0, t0)), "stored")
  let t1 = t0 + 20L
  let _ = st.update_304(get(u, []), rs(304, [h("Date", http_cache::format_http_date(t1)), h("Cache-Control", "max-age=3600"), h("ETag", "\"v2\"")]), t1, t1)
  let k = store_kind(st.lookup(get(u, []), t1 + 1L))
  debug_assert(!is_fresh(k),
    "P1-4: body of \"v1\" re-labelled \"v2\" and served fresh after a non-matching 304 (RFC 9111 §4.3.4 MUST NOT update)")
}

// ---------------------------------------------------------------------------
// P1-5  304 carrying no-store keeps the entry and keeps serving it fresh
// ---------------------------------------------------------------------------
test "redteam_p1_5_304_no_store_entry_kept_and_served_fresh" {
  let st = new_store(shared(), limits())
  let u = "https://x.example/acct"
  let resp = rs(200, [date0(), h("Cache-Control", "max-age=10"), h("Expires", http_cache::format_http_date(t0 + 86400L)), h("ETag", "\"a\"")])
  debug_assert(stored(st.store(get(u, []), resp, "SECRET".to_bytes(), t0, t0)), "stored")
  let t1 = t0 + 20L
  let _ = st.update_304(get(u, []), rs(304, [h("Date", http_cache::format_http_date(t1)), h("Cache-Control", "no-store"), h("ETag", "\"a\"")]), t1, t1)
  let k = store_kind(st.lookup(get(u, []), t1 + 1L))
  debug_assert(!is_fresh(k) && st.entry_count() == 0,
    "P1-5: origin revoked caching with 304 no-store but entry kept (count=" + st.entry_count().to_string() + ", lookup=" + k + ")")
}

// ---------------------------------------------------------------------------
// P2-8  s-maxage does not imply proxy-revalidate in a shared cache
// ---------------------------------------------------------------------------
test "redteam_p2_8_s_maxage_stale_served_with_max_stale" {
  let u = "https://x.example/sm"
  let e = match mk_entry(get(u, []), rs(200, [date0(), h("Cache-Control", "s-maxage=10")]), Bytes::new(0), t0, shared()) {
    Some(e) => e
    None => abort("entry")
  }
  let k = eval(get(u, [h("Cache-Control", "max-stale=3600")]), e, t0 + 100L, shared())
  debug_assert(k == "reval", "P2-8: stale s-maxage response served (" + k + ") in shared cache (RFC 9111 §5.2.2.10)")
}

test "redteam_p2_8b_s_maxage_stale_while_revalidate_in_shared_cache" {
  let u = "https://x.example/sm2"
  let e = match mk_entry(get(u, []), rs(200, [date0(), h("Cache-Control", "s-maxage=10, stale-while-revalidate=600")]), Bytes::new(0), t0, shared()) {
    Some(e) => e
    None => abort("entry")
  }
  let k = eval(get(u, []), e, t0 + 100L, shared())
  debug_assert(k == "reval", "P2-8b: s-maxage (implies proxy-revalidate) still served stale via swr: " + k)
}

// ---------------------------------------------------------------------------
// P2-9  Pragma: no-cache ignored (request and response, no Cache-Control)
// ---------------------------------------------------------------------------
test "redteam_p2_9_request_pragma_no_cache_ignored" {
  let u = "https://x.example/p"
  let e = match mk_entry(get(u, []), rs(200, [date0(), h("Cache-Control", "max-age=600")]), Bytes::new(0), t0, private_opts()) {
    Some(e) => e
    None => abort("entry")
  }
  let k = eval(get(u, [h("Pragma", "no-cache")]), e, t0 + 1L, private_opts())
  debug_assert(k == "reval", "P2-9: request Pragma: no-cache (no Cache-Control) served from cache: " + k)
}

test "redteam_p2_9b_response_pragma_no_cache_ignored" {
  let u = "https://x.example/p2"
  let e = match mk_entry(get(u, []), rs(200, [date0(), h("Pragma", "no-cache"), h("Expires", http_cache::format_http_date(t0 + 600L))]), Bytes::new(0), t0, shared()) {
    Some(e) => e
    None => abort("entry")
  }
  let k = eval(get(u, []), e, t0 + 1L, shared())
  debug_assert(k == "reval", "P2-9b: response Pragma: no-cache (HTTP/1.0 origin) served fresh: " + k)
}

// ---------------------------------------------------------------------------
// P2-10  Relative Location / Content-Location dot-segments not removed
// ---------------------------------------------------------------------------
test "redteam_p2_10_dot_segment_location_misses_real_key" {
  let st = new_store(shared(), limits())
  let target = "https://shop.example/cart/other"
  debug_assert(stored(st.store(get(target, []), rs(200, [h("Cache-Control", "max-age=600")]), "stale".to_bytes(), t0, t0)), "stored")
  let _ = st.invalidate_for_response(rq("POST", "https://shop.example/cart/items/add", []), rs(303, [h("Location", "../other")]))
  debug_assert(st.entry_count() == 0,
    "P2-10: Location: ../other resolved to https://shop.example/cart/items/../other; real key not invalidated (RFC 3986 §5.2.4)")
}

test "redteam_p2_10b_query_only_reference_resolution" {
  match http_cache::invalidation_targets(rq("POST", "https://shop.example/cart/items?x=1", []), rs(201, [h("Location", "?id=7")])) {
    Ok(v) => debug_assert(contains_str(v, "https://shop.example/cart/items?id=7"),
      "P2-10b: Location: ?id=7 resolved incorrectly: " + (if v.length() > 1 { v[1] } else { "-" }))
    Err(_) => debug_assert(false, "err")
  }
}

// ---------------------------------------------------------------------------
// P1-7  max_total_bytes accounts body only; stored headers are unbounded by it
// ---------------------------------------------------------------------------
test "redteam_p1_7_header_bytes_not_charged_to_max_total_bytes" {
  let lim = http_cache::CacheLimits::new(65536, 512, 32, 64, 1024L, 1000, 4096L)
  let st = new_store(shared(), lim)
  let big = repeat_char(97, 30000)
  let mut i = 0
  while i < 100 {
    let _ = st.store(get("https://x.example/h" + i.to_string(), [h("X-Pad", big)]),
      rs(200, [h("Cache-Control", "max-age=600"), h("X-Pad", big)]), Bytes::new(0), t0, t0)
    i = i + 1
  }
  let retained = st.entry_count().to_int64() * 60000L
  debug_assert(retained <= 4096L,
    "P1-7: max_total_bytes=4096 but store retains " + st.entry_count().to_string() + " entries ~" + retained.to_string() + " header bytes (total_bytes()=" + st.total_bytes().to_string() + ")")
}

// ---------------------------------------------------------------------------
// P2-11  1xx (non-final) responses storable with explicit freshness
// ---------------------------------------------------------------------------
test "redteam_p2_11_informational_status_storable" {
  debug_assert(storable(get("https://x.example/i", []), rs(103, [h("Cache-Control", "max-age=600"), h("Link", "</a.css>; rel=preload")]), shared()) == "no",
    "P2-11: 103 Early Hints storable (RFC 9111 §3: status must be final)")
}

// ---------------------------------------------------------------------------
// P2-12  Storing a HEAD response evicts the GET variant (cache-busting)
// ---------------------------------------------------------------------------
test "redteam_p2_12_head_store_evicts_get_body" {
  let st = new_store(shared(), limits())
  let u = "https://x.example/big.bin"
  let ok = rs(200, [h("Cache-Control", "max-age=600")])
  debug_assert(stored(st.store(get(u, []), ok, Bytes::new(1000), t0, t0)), "GET stored")
  let _ = st.store(rq("HEAD", u, []), ok, Bytes::new(0), t0 + 1L, t0 + 1L)
  let k = store_kind(st.lookup(get(u, []), t0 + 2L))
  debug_assert(is_fresh(k), "P2-12: attacker HEAD evicted cached GET body; GET now " + k)
}

// ---------------------------------------------------------------------------
// P2-13  Several matching variants: oldest is selected, not the most recent
// ---------------------------------------------------------------------------
test "redteam_p2_13_most_recent_matching_variant_not_selected" {
  let st = new_store(shared(), limits())
  let u = "https://x.example/neg"
  debug_assert(stored(st.store(get(u, [h("X-A", "1")]), rs(200, [h("Cache-Control", "max-age=600"), h("Vary", "X-A")]), "OLD".to_bytes(), t0, t0)), "A")
  debug_assert(stored(st.store(get(u, [h("X-A", "2"), h("X-B", "1")]), rs(200, [h("Cache-Control", "max-age=600"), h("Vary", "X-B")]), "NEW".to_bytes(), t0 + 5L, t0 + 5L)), "B")
  match st.lookup(get(u, [h("X-A", "1"), h("X-B", "1")]), t0 + 6L) {
    Ok(http_cache::StoreLookup::HitFresh(e, _)) =>
    debug_assert(e.body.to_string() == "NEW", "P2-13: older variant '" + e.body.to_string() + "' selected (RFC 9111 §4.1 most recent)")
    _ => debug_assert(false, "expected hit")
  }
}

// ---------------------------------------------------------------------------
// P2-14  308 Permanent Redirect missing from heuristically cacheable statuses
// ---------------------------------------------------------------------------
test "redteam_p2_14_308_not_heuristically_cacheable" {
  debug_assert(storable(get("https://x.example/old", []), rs(308, [date0(), h("Location", "/new"), h("Last-Modified", "Thu, 01 Jan 2015 00:00:00 GMT")]), shared()) == "yes",
    "P2-14: 308 is heuristically cacheable (RFC 9110 §15.4.9) but refused")
}

// ---------------------------------------------------------------------------
// P2-15  Date-less 304: stored Date kept, apparent age counted from the ORIGINAL Date
// ---------------------------------------------------------------------------
test "redteam_p2_15_dateless_304_never_refreshes" {
  let st = new_store(shared(), limits())
  let u = "https://x.example/feed"
  debug_assert(stored(st.store(get(u, []), rs(200, [date0(), h("Cache-Control", "max-age=60"), h("ETag", "\"f\"")]), "F".to_bytes(), t0, t0)), "stored")
  let t1 = t0 + 3600L
  let _ = st.update_304(get(u, []), rs(304, [h("Cache-Control", "max-age=600"), h("ETag", "\"f\"")]), t1, t1)
  let k = store_kind(st.lookup(get(u, []), t1 + 10L))
  debug_assert(is_fresh(k),
    "P2-15: just-revalidated entry (max-age=600, 10 s ago) is " + k + ": a recipient MUST stamp Date on a Date-less response (RFC 9110 §6.6.1); every request now revalidates")
}

// ---------------------------------------------------------------------------
// P2-16  Heuristic freshness Int64 overflow -> negative freshness_lifetime
// ---------------------------------------------------------------------------
test "redteam_p2_16_heuristic_overflow_negative_lifetime" {
  let r = rs(200, [h("Last-Modified", "Tue, 14 Nov 2023 22:13:20 GMT")])
  match http_cache::compute_freshness_lifetime(r, 9223372036854775807L, shared()) {
    Ok(v) => debug_assert(v >= 0L, "P2-16: (Date-or-response_time - Last-Modified) * pct overflowed: freshness_lifetime=" + v.to_string())
    Err(_) => ()
  }
}
