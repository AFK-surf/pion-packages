///| DoS / resource-amplification probes for `http_cache` under DEFAULT CacheLimits.
///| Usage: http_cache_rt_dos <vary|mem|cc>
///|   vary : 256 Vary variants of ONE URI x 32 Vary fields; time per lookup that scans them
///|   vary_ua: realistic `Vary: Accept-Encoding, User-Agent`, 1024 bot UAs, victim lookup cost
///|   mem  : 1024 entries with ~2 x 60 KiB headers and EMPTY bodies (max_total_bytes = 64 MiB);
///|          run under /usr/bin/time -l to read peak RSS
///|   cc   : 64 KiB Cache-Control / Vary parsing cost (linearity check)

import "http_cache"

fn pad(n : Int, c : Int) -> String {
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = c.to_byte()
    i = i + 1
  }
  b.to_string()
}

fn vary_probe(world : World) -> Int {
  let t0 = 1700000000L
  let lim = http_cache::CacheLimits::default()
  let st = match http_cache::CacheStore::new(http_cache::CachePolicyOptions::shared(), lim) {
    Ok(s) => s
    Err(_) => return 2
  }
  // 32 Vary field names
  let names : Array[String] = []
  let mut k = 0
  while k < 32 {
    names.push("x-v" + k.to_string())
    k = k + 1
  }
  let vsb = StringBuilder::new()
  k = 0
  while k < 32 {
    if k > 0 {
      vsb.write_string(", ")
    }
    vsb.write_string(names[k])
    k = k + 1
  }
  let resp = http_cache::CacheResponse::new(200, [
    http_cache::Header::new("Cache-Control", "max-age=600"),
    http_cache::Header::new("Vary", vsb.to_string()),
  ])
  // attacker-chosen request headers: 31 equal Vary fields + 1 varying, padded to 480 headers
  let base : Array[http_cache::Header] = []
  k = 0
  while k < 31 {
    base.push(http_cache::Header::new(names[k], "same"))
    k = k + 1
  }
  k = 0
  while k < 448 {
    base.push(http_cache::Header::new("x-pad-" + k.to_string(), "p"))
    k = k + 1
  }
  let mk = fn(tag : String) -> http_cache::CacheRequest {
    let hs : Array[http_cache::Header] = []
    let mut i = 0
    while i < base.length() {
      hs.push(base[i])
      i = i + 1
    }
    hs.push(http_cache::Header::new("x-v31", tag))
    http_cache::CacheRequest::new("GET", "https://cdn.example/hot", hs)
  }
  let t_fill = clock_now_ms(world)
  let mut i = 0
  while i < 256 {
    let _ = st.store(mk(i.to_string()), resp, Bytes::new(0), t0, t0)
    i = i + 1
  }
  let fill_ms = clock_now_ms(world) - t_fill
  // baseline: lookup on a URI with a single entry
  let st1 = match http_cache::CacheStore::new(http_cache::CachePolicyOptions::shared(), lim) {
    Ok(s) => s
    Err(_) => return 2
  }
  let _ = st1.store(mk("0"), resp, Bytes::new(0), t0, t0)
  let miss_req = mk("never-stored")
  let rounds = 50
  let tb = clock_now_ms(world)
  i = 0
  while i < rounds {
    let _ = st1.lookup(miss_req, t0 + 1L)
    i = i + 1
  }
  let base_ms = clock_now_ms(world) - tb
  let ta = clock_now_ms(world)
  i = 0
  while i < rounds {
    let _ = st.lookup(miss_req, t0 + 1L)
    i = i + 1
  }
  let atk_ms = clock_now_ms(world) - ta
  io_println(world, "vary: variants=" + st.entry_count().to_string() + " fill_ms=" + fill_ms.to_string() +
    " lookup_miss_1variant_us=" + (base_ms * 1000L / rounds.to_int64()).to_string() +
    " lookup_miss_256variants_us=" + (atk_ms * 1000L / rounds.to_int64()).to_string())
  0
}

///| Realistic: `Vary: Accept-Encoding, User-Agent`, attacker rotates User-Agent,
///| pads the request to 400 headers.
fn vary_ua_probe(world : World) -> Int {
  let t0 = 1700000000L
  let lim = http_cache::CacheLimits::default()
  let st = match http_cache::CacheStore::new(http_cache::CachePolicyOptions::shared(), lim) {
    Ok(s) => s
    Err(_) => return 2
  }
  let resp = http_cache::CacheResponse::new(200, [
    http_cache::Header::new("Cache-Control", "public, max-age=600"),
    http_cache::Header::new("Vary", "Accept-Encoding, User-Agent"),
  ])
  let mk = fn(ua : String) -> http_cache::CacheRequest {
    let hs : Array[http_cache::Header] = [http_cache::Header::new("accept-encoding", "gzip")]
    let mut i = 0
    while i < 398 {
      hs.push(http_cache::Header::new("x-pad-" + i.to_string(), "p"))
      i = i + 1
    }
    hs.push(http_cache::Header::new("user-agent", ua))
    http_cache::CacheRequest::new("GET", "https://cdn.example/index.html", hs)
  }
  let t_fill = clock_now_ms(world)
  let mut i = 0
  while i < 1024 {
    let _ = st.store(mk("bot/" + i.to_string()), resp, Bytes::new(0), t0, t0)
    i = i + 1
  }
  let fill_ms = clock_now_ms(world) - t_fill
  let victim = http_cache::CacheRequest::new("GET", "https://cdn.example/index.html", [
    http_cache::Header::new("accept-encoding", "gzip"),
    http_cache::Header::new("user-agent", "Mozilla/5.0 victim"),
  ])
  let rounds = 200
  let ta = clock_now_ms(world)
  i = 0
  while i < rounds {
    let _ = st.lookup(victim, t0 + 1L)
    i = i + 1
  }
  let atk_ms = clock_now_ms(world) - ta
  let st1 = match http_cache::CacheStore::new(http_cache::CachePolicyOptions::shared(), lim) {
    Ok(s) => s
    Err(_) => return 2
  }
  let _ = st1.store(mk("bot/0"), resp, Bytes::new(0), t0, t0)
  let tb = clock_now_ms(world)
  i = 0
  while i < rounds {
    let _ = st1.lookup(victim, t0 + 1L)
    i = i + 1
  }
  let base_ms = clock_now_ms(world) - tb
  io_println(world, "vary_ua: variants=" + st.entry_count().to_string() + " fill_ms=" + fill_ms.to_string() +
    " victim_lookup_1variant_us=" + (base_ms * 1000L / rounds.to_int64()).to_string() +
    " victim_lookup_1024variants_us=" + (atk_ms * 1000L / rounds.to_int64()).to_string())
  0
}

fn mem_probe(world : World) -> Int {
  let t0 = 1700000000L
  let lim = http_cache::CacheLimits::default()
  let st = match http_cache::CacheStore::new(http_cache::CachePolicyOptions::shared(), lim) {
    Ok(s) => s
    Err(_) => return 2
  }
  let big = pad(30000, 97)
  let mut i = 0
  while i < 1024 {
    // distinct strings per entry so nothing is shared by reference
    let tag = i.to_string()
    let rq = [http_cache::Header::new("x-a", big + tag), http_cache::Header::new("x-b", big + tag)]
    let rs = http_cache::CacheResponse::new(200, [
      http_cache::Header::new("Cache-Control", "max-age=600"),
      http_cache::Header::new("x-c", big + tag),
      http_cache::Header::new("x-d", big + tag),
    ])
    let _ = st.store(http_cache::CacheRequest::new("GET", "https://cdn.example/m" + tag, rq), rs, Bytes::new(0), t0, t0)
    i = i + 1
  }
  io_println(world, "mem: entries=" + st.entry_count().to_string() + " accounted_total_bytes=" + st.total_bytes().to_string() +
    " retained_header_bytes~=" + (st.entry_count().to_int64() * 120000L).to_string() + " max_total_bytes=" + lim.max_total_bytes.to_string())
  0
}

fn cc_probe(world : World) -> Int {
  let lim = http_cache::CacheLimits::default()
  let mut n = 4000
  while n <= 64000 {
    let q = "x=\"" + pad(n, 97) + "\""
    let t = clock_now_ms(world)
    let mut i = 0
    while i < 200 {
      let _ = http_cache::parse_response_cache_control_with_limits([http_cache::Header::new("Cache-Control", q)], lim)
      i = i + 1
    }
    io_println(world, "cc: quoted_len=" + n.to_string() + " ms_per_200=" + (clock_now_ms(world) - t).to_string())
    n = n * 4
  }
  0
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mode = if args.length() > 1 { args[1] } else { "vary" }
  if mode == "vary" {
    vary_probe(world)
  } else if mode == "vary_ua" {
    vary_ua_probe(world)
  } else if mode == "mem" {
    mem_probe(world)
  } else {
    cc_probe(world)
  }
}
