///| Pion Native head-to-head benchmark for `packages/gif`.
///| Modes:
///|   decode_first <gif_file> <iters>  -> outputs raw RGBA8888 bytes of frame 0 to stdout
///|   decode_all   <gif_file> <iters>  -> outputs raw RGBA8888 bytes of all frames to stdout

import "gif"

///|
fn parse_int(s : String) -> Int {
  let n = s.length()
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: pion_gif_bench <decode_first|decode_all> <gif_file> <iters>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let iters = parse_int(args[3])
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read " + path)
      return 1
    }
  }

  if mode == "decode_first" {
    let mut last_rgba = Bytes::new(0)
    let mut i = 0
    while i < iters {
      match gif::decode_first_frame(data) {
        Ok(f) => last_rgba = f.rgba
        Err(e) => {
          io_println(world, "decode_first error: " + gif::gif_error_message(e))
          return 1
        }
      }
      i = i + 1
    }
    let _ = fs_write_bytes(world, "/dev/stdout", last_rgba)
    return 0
  }

  if mode == "decode_all" {
    let mut last_frames : Array[gif::GifFrame] = []
    let mut i = 0
    while i < iters {
      match gif::decode(data) {
        Ok(img) => last_frames = img.frames
        Err(e) => {
          io_println(world, "decode_all error: " + gif::gif_error_message(e))
          return 1
        }
      }
      i = i + 1
    }
    let mut fi = 0
    while fi < last_frames.length() {
      let _ = fs_write_bytes(world, "/dev/stdout", last_frames[fi].rgba)
      fi = fi + 1
    }
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
