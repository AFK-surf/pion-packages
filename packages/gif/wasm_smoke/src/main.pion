///| Wasm32 + Native 4-mode smoke entry for `packages/gif`.

import "gif"

///|
fn mk_bytes(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///| FNV-1a 64-bit checksum for deterministic cross-target verification.
fn fnv1a64(b : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = b.length()
  let mut i = 0
  while i < n {
    h = h ^ b[i].to_int().to_int64().to_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

///|
fn smoke() -> (Int, UInt64) {
  let mut acc : UInt64 = 0UL

  // 1. Classic 1x1 red GIF89a
  let gif1x1 = mk_bytes([
    0x47, 0x49, 0x46, 0x38, 0x39, 0x61,
    0x01, 0x00, 0x01, 0x00,
    0x80, 0x00, 0x00,
    0xFF, 0x00, 0x00, 0x00, 0xFF, 0x00,
    0x2C, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00,
    0x02, 0x02, 0x44, 0x01, 0x00, 0x3B,
  ])
  match gif::probe_header(gif1x1) {
    Ok(h) =>
    if h.width != 1 || h.height != 1 || h.global_color_table_size != 2 {
      return (-1, 0UL)
    }
    Err(_) => return (-2, 0UL)
  }
  match gif::decode_first_frame(gif1x1) {
    Ok(f) => {
      if f.rgba.length() != 4 || f.rgba[0].to_int() != 255 || f.rgba[3].to_int() != 255 {
        return (-3, 0UL)
      }
      acc = acc ^ fnv1a64(f.rgba)
    }
    Err(_) => return (-4, 0UL)
  }

  // 2. Standalone LZW KwKwK decoding
  match gif::lzw_decode(mk_bytes([0x84, 0x5F]), 2, 16) {
    Ok(out) => {
      if out.length() != 6 {
        return (-5, 0UL)
      }
      acc = acc ^ fnv1a64(out)
    }
    Err(_) => return (-6, 0UL)
  }

  // 3. 2-frame animated GIF with NETSCAPE2.0, GCE transparency + RestoreToBackground
  // 2x2 canvas, 2-color GCT (Red, Blue)
  // Frame 0: 2x2 Red (0,0,0,0), disposal=RestoreToBackground (2), delay=15
  //   LZW (min=2): clear(4), 0, 0, 0, 0, eoi(5) -> 0x44, 0x00, 0x00, 0x05? Use exact KwKwK:
  //   clear(4)[3b], 0[3b], 6(0,0)[3b], 0[3b], eoi(5)[3b] -> 15 bits:
  //   4 | (0<<3) | (6<<6) | (0<<9) | (5<<12) = 4 + 384 + 20480 = 20868 = 0x5184 -> [0x84, 0x51]
  // Frame 1: 1x1 at (1,1) Blue (1), trans=0, disposal=DoNotDispose (1), delay=25
  //   clear(4)[3b], 1[3b], eoi(5)[3b] = 4 | 8 | 320 = 332 = 0x014C -> [0x4C, 0x01]
  let anim = mk_bytes([
    0x47, 0x49, 0x46, 0x38, 0x39, 0x61,
    0x02, 0x00, 0x02, 0x00,
    0x80, 0x00, 0x00,
    0xFF, 0x00, 0x00, 0x00, 0x00, 0xFF,
    // NETSCAPE2.0 loop=0
    0x21, 0xFF, 0x0B, 0x4E, 0x45, 0x54, 0x53, 0x43, 0x41, 0x50, 0x45, 0x32, 0x2E, 0x30,
    0x03, 0x01, 0x00, 0x00, 0x00,
    // GCE Frame 0: disposal=2, delay=15
    0x21, 0xF9, 0x04, 0x08, 0x0F, 0x00, 0x00, 0x00,
    0x2C, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x02, 0x00, 0x00,
    0x02, 0x02, 0x84, 0x51, 0x00,
    // GCE Frame 1: disposal=1, trans=0, delay=25
    0x21, 0xF9, 0x04, 0x05, 0x19, 0x00, 0x00, 0x00,
    0x2C, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00,
    0x02, 0x02, 0x4C, 0x01, 0x00,
    0x3B,
  ])
  match gif::decode(anim) {
    Ok(img) => {
      if img.frames.length() != 2 {
        return (-7, 0UL)
      }
      // Frame 1 pixel (0,0) must be cleared to (0,0,0,0) by Frame 0's RestoreToBackground,
      // and pixel (1,1) must be Blue (0,0,255,255).
      let f1 = img.frames[1].rgba
      if f1[0].to_int() != 0 || f1[3].to_int() != 0 || f1[14].to_int() != 255 || f1[15].to_int() != 255 {
        return (-8, 0UL)
      }
      acc = acc ^ fnv1a64(img.frames[0].rgba)
      acc = acc ^ fnv1a64(f1)
    }
    Err(_) => return (-9, 0UL)
  }

  // 4. DecodeLimits bomb guard (10000x10000 rejected)
  let bomb = mk_bytes([
    0x47, 0x49, 0x46, 0x38, 0x39, 0x61,
    0x10, 0x27, 0x10, 0x27,
    0x80, 0x00, 0x00, 0, 0, 0, 255, 255, 255, 0x3B,
  ])
  match gif::decode(bomb) {
    Err(gif::GifError::LimitExceeded(_)) => ()
    _ => return (-10, 0UL)
  }

  (4, acc)
}

///|
pub fn main(world : World) -> Int {
  let (checks, hash) = smoke()
  if checks > 0 {
    io_println(
      world,
      "gif_wasm_smoke: OK checks=" + checks.to_string() + " fnv64=" + hash.to_string(),
    )
    0
  } else {
    io_println(world, "gif_wasm_smoke: FAIL code=" + checks.to_string())
    1
  }
}
