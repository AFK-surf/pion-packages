///| Red-team CLI for `packages/gif` (native + wasm32).
///|   selftest                    -> run every case, one `PASS|FAIL <name>` line each; exit 1 if any fails
///|   digest <file>...            -> one line per file: `<file> OK <frames> <loop> <sha256>` | `<file> ERR <Variant>`
///|                                  sha256 over, per frame: u16le delay, u8 disposal, RGBA8888 canvas
///|   time <file> [max_total]     -> decode with default limits (or max_total_bytes) and print verdict + microseconds
///|   lzwtime <file> <min> <max>  -> standalone `lzw_decode` verdict + microseconds
///|   gen_dos <dir>               -> write the DoS probe corpus

import "gif"
import "crypto"

///|
fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut neg = false
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 45 && i == 0 {
      neg = true
    } else if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  if neg {
    0 - acc
  } else {
    acc
  }
}

///|
pub fn rt_loop_str(l : gif::LoopCount) -> String {
  match l {
    gif::LoopCount::None => "-1"
    gif::LoopCount::Infinite => "0"
    gif::LoopCount::Finite(n) => n.to_string()
  }
}

///| Digest line body for one GIF.
pub fn rt_digest(data : Bytes) -> String {
  match rt_digest_buf(data) {
    Err(e) => "ERR " + rt_err_name(e)
    Ok((img, buf)) =>
    "OK " +
    img.frames.length().to_string() +
    " " +
    rt_loop_str(img.loop_count) +
    " " +
    crypto::sha256_hex(buf)
  }
}

///| The digested byte stream: per frame u16le delay, u8 disposal, RGBA8888 canvas.
pub fn rt_digest_buf(data : Bytes) -> Result[(gif::GifImage, Bytes), gif::GifError] {
  match gif::decode(data) {
    Err(e) => Err(e)
    Ok(img) => {
      let mut total = 0
      let mut i = 0
      while i < img.frames.length() {
        total = total + 3 + img.frames[i].rgba.length()
        i = i + 1
      }
      let buf = Bytes::new(total)
      let mut p = 0
      i = 0
      while i < img.frames.length() {
        let f = img.frames[i]
        buf[p] = (f.delay_cs & 0xFF).to_byte()
        buf[p + 1] = ((f.delay_cs >> 8) & 0xFF).to_byte()
        buf[p + 2] = f.disposal.to_int().to_byte()
        p = p + 3
        let n = f.rgba.length()
        let mut k = 0
        while k < n {
          buf[p + k] = f.rgba[k]
          k = k + 1
        }
        p = p + n
        i = i + 1
      }
      Ok((img, buf))
    }
  }
}

///| 1x1 canvas, `frames` frames each `side x side` at (0,0), each an LZW bomb filling the sub-frame.
pub fn rt_subframe_bomb(frames : Int, side : Int) -> Bytes {
  let b : Array[Int] = []
  rt_header(b, 1, 1, [0, 0, 0, 255, 255, 255], 0)
  let codes = rt_bomb_codes(2, side * side)
  let i0 = b.length()
  rt_image_codes(b, 0, 0, side, side, false, [], 0, 2, codes)
  let one : Array[Int] = []
  let mut k = i0
  while k < b.length() {
    one.push(b[k])
    k = k + 1
  }
  let mut f = 1
  while f < frames {
    k = 0
    while k < one.length() {
      b.push(one[k])
      k = k + 1
    }
    f = f + 1
  }
  b.push(0x3B)
  rt_bytes(b)
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: gif_audit selftest | digest <file>... | time <file> [max_total] | lzwtime <file> <min> <max> | gen_dos <dir>")
    return 2
  }
  let mode = args[1]
  if mode == "selftest" {
    let names = rt_all_cases()
    let mut failed = 0
    let mut i = 0
    while i < names.length() {
      let r = rt_run_case(names[i])
      if r == "" {
        io_println(world, "PASS " + names[i])
      } else {
        io_println(world, "FAIL " + names[i] + " :: " + r)
        failed = failed + 1
      }
      i = i + 1
    }
    io_println(world, "selftest: " + (names.length() - failed).to_string() + "/" + names.length().to_string() + " passed")
    return if failed == 0 { 0 } else { 1 }
  }
  if mode == "digest" {
    let mut i = 2
    while i < args.length() {
      match fs_read_bytes(world, args[i]) {
        Ok(d) => io_println(world, args[i] + " " + rt_digest(d))
        Err(_) => io_println(world, args[i] + " READFAIL")
      }
      i = i + 1
    }
    return 0
  }
  if mode == "dump" && args.length() >= 4 {
    match fs_read_bytes(world, args[2]) {
      Ok(d) =>
      match rt_digest_buf(d) {
        Ok((_, buf)) => {
          let _ = fs_write_bytes(world, args[3], buf)
        }
        Err(e) => io_println(world, "ERR " + rt_err_name(e))
      }
      Err(_) => return 3
    }
    return 0
  }
  if mode == "time" && args.length() >= 3 {
    let d = match fs_read_bytes(world, args[2]) {
      Ok(x) => x
      Err(_) => return 3
    }
    let lim = if args.length() >= 4 {
      let dl = gif::DecodeLimits::default()
      gif::DecodeLimits::new(dl.max_width, dl.max_height, dl.max_pixels, dl.max_frames, parse_int(args[3]))
    } else {
      gif::DecodeLimits::default()
    }
    let t0 = clock_monotonic_us()
    let k = rt_kind(gif::decode_with_limits(d, lim))
    let t1 = clock_monotonic_us()
    io_println(world, k + " us=" + (t1 - t0).to_string())
    return 0
  }
  if mode == "lzwtime" && args.length() >= 5 {
    let d = match fs_read_bytes(world, args[2]) {
      Ok(x) => x
      Err(_) => return 3
    }
    let t0 = clock_monotonic_us()
    let k = match gif::lzw_decode(d, parse_int(args[3]), parse_int(args[4])) {
      Ok(o) => "OK " + o.length().to_string()
      Err(e) => "ERR " + rt_err_name(e)
    }
    let t1 = clock_monotonic_us()
    io_println(world, k + " us=" + (t1 - t0).to_string())
    return 0
  }
  if mode == "gen_dos" && args.length() >= 3 {
    let dir = args[2]
    let _ = fs_write_bytes(world, dir + "/subframe_bomb_1x1_256f_4096sq.gif", rt_subframe_bomb(256, 4096))
    let _ = fs_write_bytes(world, dir + "/subframe_bomb_1x1_1f_4096sq.gif", rt_subframe_bomb(1, 4096))
    // standalone LZW stream expanding to 1 GiB + 64 MiB (crosses the Int32 capacity-doubling point)
    // Inputs are zero-padded after EOI to exactly 512 KiB so `lzw_decode`'s initial capacity (2 * in_len = 1 MiB)
    // doubles onto exactly 2^30; the next doubling is 2^31, which wraps negative in 32-bit `Int`.
    let _ = fs_write_bytes(world, dir + "/lzw_bomb_1088MiB.lzw", rt_padded(rt_lzw_pack(2, rt_bomb_codes(2, 1140850688)), 524288))
    let _ = fs_write_bytes(world, dir + "/lzw_bomb_1000MiB.lzw", rt_padded(rt_lzw_pack(2, rt_bomb_codes(2, 1048576000)), 524288))
    // frame-count bomb: 4096 frames on a 1024x1024 canvas (4 MiB each) -> must stop at max_total_bytes
    let _ = fs_write_bytes(world, dir + "/frames_bomb_1024sq_4096f.gif", rt_frames_bomb(4096, 1024))
    // canvas bombs
    let c1 : Array[Int] = []
    rt_header(c1, 65535, 65535, [0, 0, 0, 255, 255, 255], 0)
    c1.push(0x3B)
    let _ = fs_write_bytes(world, dir + "/canvas_65535sq.gif", rt_bytes(c1))
    let c2 : Array[Int] = []
    rt_header(c2, 4096, 4096, [0, 0, 0, 255, 255, 255], 0)
    rt_image_codes(c2, 0, 0, 4096, 4096, false, [], 0, 2, rt_bomb_codes(2, 4096 * 4096))
    c2.push(0x3B)
    let _ = fs_write_bytes(world, dir + "/canvas_4096sq_bomb.gif", rt_bytes(c2))
    io_println(world, "gen_dos: ok")
    return 0
  }
  io_println(world, "bad arguments")
  2
}

///| `frames` 1x1 frames on a `side x side` canvas.
pub fn rt_frames_bomb(frames : Int, side : Int) -> Bytes {
  let b : Array[Int] = []
  rt_header(b, side, side, [0, 0, 0, 255, 255, 255], 0)
  let mut f = 0
  while f < frames {
    rt_image_codes(b, 0, 0, 1, 1, false, [], 0, 2, [4, f % 2, 5])
    f = f + 1
  }
  b.push(0x3B)
  rt_bytes(b)
}

///| `vals` as Bytes, zero-padded to `n` bytes.
pub fn rt_padded(vals : Array[Int], n : Int) -> Bytes {
  let b = Bytes::new(n)
  let mut i = 0
  while i < vals.length() && i < n {
    b[i] = (vals[i] & 0xFF).to_byte()
    i = i + 1
  }
  b
}
