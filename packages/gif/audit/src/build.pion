///| Red-team GIF / LZW stream builders and an independent reference compositor.
///| Nothing here calls into `gif`: every expected pixel is derived from the indices the case itself encodes.

///| Convert an `Array[Int]` of byte values into `Bytes`.
pub fn rt_bytes(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = (vals[i] & 0xFF).to_byte()
    i = i + 1
  }
  b
}

///|
pub fn rt_u16(buf : Array[Int], v : Int) -> Unit {
  buf.push(v & 0xFF)
  buf.push((v >> 8) & 0xFF)
}

///| Pack an explicit LZW code sequence (LSB-first). Code widths follow the GIF decoder's own
///| dictionary growth (entry added for every code after the first since Clear, width bump when
///| `next_code` reaches `1 << width`, no growth past 4096 = Deferred Clear), so any sequence of
///| codes (valid or malicious) is emitted at exactly the width a conforming decoder reads it with.
pub fn rt_lzw_pack(min_code_size : Int, codes : Array[Int]) -> Array[Int] {
  let clear = 1 << min_code_size
  let eoi = clear + 1
  let mut width = min_code_size + 1
  let mut next_code = eoi + 1
  let mut has_prev = false
  let out : Array[Int] = []
  let mut acc : UInt64 = 0UL
  let mut nbits = 0
  let mut i = 0
  while i < codes.length() {
    let c = codes[i]
    acc = acc | (c.to_int64().to_uint64() << nbits)
    nbits = nbits + width
    while nbits >= 8 {
      out.push((acc & 0xFFUL).to_int())
      acc = acc >> 8
      nbits = nbits - 8
    }
    if c == clear {
      width = min_code_size + 1
      next_code = eoi + 1
      has_prev = false
    } else if c == eoi {
      ()
    } else {
      if has_prev && next_code < 4096 {
        next_code = next_code + 1
        if next_code >= (1 << width) && width < 12 {
          width = width + 1
        }
      }
      has_prev = true
    }
    i = i + 1
  }
  if nbits > 0 {
    out.push((acc & 0xFFUL).to_int())
  }
  out
}

///| `[Clear] + pixels + [EOI]` (literal-only, Deferred Clear once the table is full).
pub fn rt_literal_codes(min_code_size : Int, pixels : Array[Int]) -> Array[Int] {
  let codes : Array[Int] = [1 << min_code_size]
  let mut i = 0
  while i < pixels.length() {
    codes.push(pixels[i])
    i = i + 1
  }
  codes.push((1 << min_code_size) + 1)
  codes
}

///| LZW decompression bomb: Clear, literal 0, then the KwKwK chain `eoi+1 .. 4095` (entry `j` expands to
///| `j - eoi` zeros) and finally code 4095 repeated until `total` output pixels are reached, then EOI.
///| Every code is legal; the stream is ~1/1800 of its output size.
pub fn rt_bomb_codes(min_code_size : Int, total : Int) -> Array[Int] {
  let clear = 1 << min_code_size
  let eoi = clear + 1
  let codes : Array[Int] = [clear, 0]
  let mut produced = 1
  let mut next = eoi + 1
  while next < 4096 && produced + (next - eoi + 1) <= total {
    codes.push(next)
    produced = produced + (next - eoi + 1)
    next = next + 1
  }
  if next == 4096 {
    let big = 4095 - eoi + 1
    while produced + big <= total {
      codes.push(4095)
      produced = produced + big
    }
  }
  while produced < total {
    codes.push(0)
    produced = produced + 1
  }
  codes.push(eoi)
  codes
}

///| Append GIF data sub-blocks (255-byte chunks) and the 0x00 terminator.
pub fn rt_sub_blocks(buf : Array[Int], payload : Array[Int]) -> Unit {
  let n = payload.length()
  let mut pos = 0
  while pos < n {
    let mut chunk = n - pos
    if chunk > 255 {
      chunk = 255
    }
    buf.push(chunk)
    let mut j = 0
    while j < chunk {
      buf.push(payload[pos + j])
      j = j + 1
    }
    pos = pos + chunk
  }
  buf.push(0)
}

///| Header + Logical Screen Descriptor. `gct` holds RGB triples; it is padded with black up to
///| `2^(gct_bits+1)` entries. An empty `gct` means "no Global Color Table".
pub fn rt_header(buf : Array[Int], w : Int, h : Int, gct : Array[Int], gct_bits : Int) -> Unit {
  let sig = [0x47, 0x49, 0x46, 0x38, 0x39, 0x61]
  let mut i = 0
  while i < 6 {
    buf.push(sig[i])
    i = i + 1
  }
  rt_u16(buf, w)
  rt_u16(buf, h)
  if gct.length() > 0 {
    buf.push(0x80 | 0x70 | (gct_bits & 7))
  } else {
    buf.push(0x70)
  }
  buf.push(0)
  buf.push(0)
  if gct.length() > 0 {
    rt_color_table(buf, gct, gct_bits)
  }
}

///|
pub fn rt_color_table(buf : Array[Int], rgb : Array[Int], bits : Int) -> Unit {
  let want = (1 << ((bits & 7) + 1)) * 3
  let mut i = 0
  while i < want {
    if i < rgb.length() {
      buf.push(rgb[i])
    } else {
      buf.push(0)
    }
    i = i + 1
  }
}

///| Graphic Control Extension.
pub fn rt_gce(buf : Array[Int], disposal : Int, has_trans : Bool, trans : Int, delay : Int) -> Unit {
  buf.push(0x21)
  buf.push(0xF9)
  buf.push(4)
  let mut packed = (disposal & 7) << 2
  if has_trans {
    packed = packed | 1
  }
  buf.push(packed)
  rt_u16(buf, delay)
  buf.push(trans & 0xFF)
  buf.push(0)
}

///| Image Descriptor (+ optional LCT) + min code size + LZW sub-blocks built from `codes`.
pub fn rt_image_codes(
  buf : Array[Int],
  left : Int,
  top : Int,
  w : Int,
  h : Int,
  interlaced : Bool,
  lct : Array[Int],
  lct_bits : Int,
  min_code_size : Int,
  codes : Array[Int],
) -> Unit {
  buf.push(0x2C)
  rt_u16(buf, left)
  rt_u16(buf, top)
  rt_u16(buf, w)
  rt_u16(buf, h)
  let mut packed = 0
  if lct.length() > 0 {
    packed = packed | 0x80 | (lct_bits & 7)
  }
  if interlaced {
    packed = packed | 0x40
  }
  buf.push(packed)
  if lct.length() > 0 {
    rt_color_table(buf, lct, lct_bits)
  }
  buf.push(min_code_size)
  rt_sub_blocks(buf, rt_lzw_pack(min_code_size, codes))
}

///| Reorder linear rows into GIF 4-pass interlaced row order.
pub fn rt_interlace(pixels : Array[Int], w : Int, h : Int) -> Array[Int] {
  let out : Array[Int] = []
  let starts = [0, 4, 2, 1]
  let steps = [8, 8, 4, 2]
  let mut pass = 0
  while pass < 4 {
    let mut y = starts[pass]
    while y < h {
      let mut x = 0
      while x < w {
        out.push(pixels[y * w + x])
        x = x + 1
      }
      y = y + steps[pass]
    }
    pass = pass + 1
  }
  out
}

///| Image with literal-only LZW of `pixels` (given in linear row order; interlaced on write if asked).
pub fn rt_image(
  buf : Array[Int],
  left : Int,
  top : Int,
  w : Int,
  h : Int,
  interlaced : Bool,
  lct : Array[Int],
  lct_bits : Int,
  min_code_size : Int,
  pixels : Array[Int],
) -> Unit {
  let stream = if interlaced { rt_interlace(pixels, w, h) } else { pixels }
  rt_image_codes(
    buf,
    left,
    top,
    w,
    h,
    interlaced,
    lct,
    lct_bits,
    min_code_size,
    rt_literal_codes(min_code_size, stream),
  )
}

///| One frame for the reference compositor. `pal` = RGB triples actually in effect (LCT or GCT),
///| `idx` = linear (de-interlaced) indices, `w * h` long.
pub struct RefFrame {
  left : Int
  top : Int
  w : Int
  h : Int
  disposal : Int
  has_trans : Bool
  trans : Int
  pal : Array[Int]
  idx : Array[Int]
}

///| Independent browser-semantics compositor (transparent-black canvas, sub-rectangles clipped to the
///| canvas, transparent index skipped, index >= palette size -> opaque black (the documented choice of
///| `fill_palette_1024`), disposal 2 -> clear rect, 3 -> restore pre-frame canvas, 0/1/4..7 -> keep).
pub fn rt_ref_composite(cw : Int, ch : Int, frames : Array[RefFrame]) -> Array[Bytes] {
  let canvas = Bytes::new(cw * ch * 4)
  let out : Array[Bytes] = []
  let mut fi = 0
  while fi < frames.length() {
    let f = frames[fi]
    let saved = canvas.slice(0, cw * ch * 4)
    let ncol = f.pal.length() / 3
    let mut y = 0
    while y < f.h {
      let mut x = 0
      while x < f.w {
        let cx = f.left + x
        let cy = f.top + y
        if cx < cw && cy < ch {
          let c = f.idx[y * f.w + x]
          if !(f.has_trans && c == f.trans) {
            let o = (cy * cw + cx) * 4
            if c < ncol {
              canvas[o] = f.pal[c * 3].to_byte()
              canvas[o + 1] = f.pal[c * 3 + 1].to_byte()
              canvas[o + 2] = f.pal[c * 3 + 2].to_byte()
            } else {
              canvas[o] = (0).to_byte()
              canvas[o + 1] = (0).to_byte()
              canvas[o + 2] = (0).to_byte()
            }
            canvas[o + 3] = (255).to_byte()
          }
        }
        x = x + 1
      }
      y = y + 1
    }
    out.push(canvas.slice(0, cw * ch * 4))
    if f.disposal == 2 {
      let mut yy = f.top
      while yy < f.top + f.h && yy < ch {
        let mut xx = f.left
        while xx < f.left + f.w && xx < cw {
          let o = (yy * cw + xx) * 4
          canvas[o] = (0).to_byte()
          canvas[o + 1] = (0).to_byte()
          canvas[o + 2] = (0).to_byte()
          canvas[o + 3] = (0).to_byte()
          xx = xx + 1
        }
        yy = yy + 1
      }
    } else if f.disposal == 3 {
      let mut k = 0
      while k < cw * ch * 4 {
        canvas[k] = saved[k]
        k = k + 1
      }
    }
    fi = fi + 1
  }
  out
}

///|
pub fn rt_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| First differing pixel as `"(x,y) got r,g,b,a want r,g,b,a"`, or "" when equal.
pub fn rt_first_diff(got : Bytes, want : Bytes, cw : Int) -> String {
  if got.length() != want.length() {
    return "length " + got.length().to_string() + " != " + want.length().to_string()
  }
  let mut i = 0
  while i < got.length() {
    if got[i] != want[i] {
      let p = i / 4
      let o = p * 4
      return "(" +
      (p % cw).to_string() +
      "," +
      (p / cw).to_string() +
      ") got " +
      rt_px(got, o) +
      " want " +
      rt_px(want, o)
    }
    i = i + 1
  }
  ""
}

///|
pub fn rt_px(b : Bytes, o : Int) -> String {
  b[o].to_int().to_string() +
  "," +
  b[o + 1].to_int().to_string() +
  "," +
  b[o + 2].to_int().to_string() +
  "," +
  b[o + 3].to_int().to_string()
}

///| Deterministic xorshift32 PRNG for structured random cases.
pub struct RtRng {
  mut s : Int
}

///|
pub fn RtRng::new(seed : Int) -> RtRng {
  RtRng::{ s: if seed == 0 { 0x2545F491 } else { seed } }
}

///| Uniform-ish value in `0 .. n-1` (n > 0).
pub fn RtRng::next(self : RtRng, n : Int) -> Int {
  let mut x = self.s
  x = x ^ (x << 13)
  x = x ^ ((x >> 17) & 0x7FFF)
  x = x ^ (x << 5)
  self.s = x
  let v = x & 0x7FFFFFFF
  v % n
}
