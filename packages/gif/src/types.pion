///| Public types, errors, limits, and metadata for `packages/gif`.
///| Pure Pion GIF87a / GIF89a multi-frame animated LZW decoder.

///| Default maximum logical screen width (16,384 px).
pub let default_max_width : Int = 16384

///| Default maximum logical screen height (16,384 px).
pub let default_max_height : Int = 16384

///| Default maximum canvas pixels per frame (16M pixels = 64 MiB RGBA per frame).
pub let default_max_pixels : Int = 16777216

///| Default maximum number of frames decoded per GIF stream.
pub let default_max_frames : Int = 4096

///| Default maximum total RGBA output bytes across all frames (256 MiB).
pub let default_max_total_bytes : Int = 268435456

///| Error returned when probing or decoding a GIF stream.
pub enum GifError {
  UnexpectedEof(String)
  InvalidHeader(String)
  InvalidBlock(String)
  InvalidExtension(String)
  InvalidLzwCodeSize(Int)
  InvalidLzwCode(Int)
  MissingColorTable(String)
  LimitExceeded(String)
}

///| Human-readable description of a `GifError`.
pub fn gif_error_message(err : GifError) -> String {
  match err {
    GifError::UnexpectedEof(msg) => "unexpected EOF: " + msg
    GifError::InvalidHeader(msg) => "invalid GIF header: " + msg
    GifError::InvalidBlock(msg) => "invalid GIF block: " + msg
    GifError::InvalidExtension(msg) => "invalid GIF extension: " + msg
    GifError::InvalidLzwCodeSize(n) => "invalid LZW minimum code size: " + n.to_string()
    GifError::InvalidLzwCode(c) => "invalid LZW code: " + c.to_string()
    GifError::MissingColorTable(msg) => "missing color table: " + msg
    GifError::LimitExceeded(msg) => "decode limit exceeded: " + msg
  }
}

///|
pub fn GifError::to_string(self : GifError) -> String {
  gif_error_message(self)
}

///| GIF specification version from the 6-byte file signature.
pub enum GifVersion {
  Gif87a
  Gif89a
}

///| Frame disposal method from Graphic Control Extension (GCE).
pub enum DisposalMethod {
  Unspecified
  DoNotDispose
  RestoreToBackground
  RestoreToPrevious
}

///| Convert the 3-bit GCE disposal field (`0..7`) into a `DisposalMethod`.
pub fn disposal_method_from_int(v : Int) -> DisposalMethod {
  if v == 1 {
    DisposalMethod::DoNotDispose
  } else if v == 2 {
    DisposalMethod::RestoreToBackground
  } else if v == 3 {
    DisposalMethod::RestoreToPrevious
  } else {
    DisposalMethod::Unspecified
  }
}

///| Convert a `DisposalMethod` back to its GIF89a integer code (`0..3`).
pub fn DisposalMethod::to_int(self : DisposalMethod) -> Int {
  match self {
    DisposalMethod::Unspecified => 0
    DisposalMethod::DoNotDispose => 1
    DisposalMethod::RestoreToBackground => 2
    DisposalMethod::RestoreToPrevious => 3
  }
}

///| Animation loop count from `NETSCAPE2.0` / `ANIMEXTS1.0` Application Extension.
pub enum LoopCount {
  None
  Infinite
  Finite(Int)
}

///| Resource limits protecting against GIF decompression bombs and OOM.
pub val struct DecodeLimits {
  pub max_width : Int
  pub max_height : Int
  pub max_pixels : Int
  pub max_frames : Int
  pub max_total_bytes : Int
}

///| Default resource limits (16384x16384 max dim, 16M pixels, 4096 frames, 256 MiB total RGBA).
pub fn DecodeLimits::default() -> DecodeLimits {
  DecodeLimits::{
    max_width: default_max_width,
    max_height: default_max_height,
    max_pixels: default_max_pixels,
    max_frames: default_max_frames,
    max_total_bytes: default_max_total_bytes,
  }
}

///| Create custom decode limits.
pub fn DecodeLimits::new(
  max_width : Int,
  max_height : Int,
  max_pixels : Int,
  max_frames : Int,
  max_total_bytes : Int,
) -> DecodeLimits {
  DecodeLimits::{
    max_width: max_width,
    max_height: max_height,
    max_pixels: max_pixels,
    max_frames: max_frames,
    max_total_bytes: max_total_bytes,
  }
}

///| Parsed GIF header and Logical Screen Descriptor (+ optional Global Color Table).
pub struct GifHeader {
  pub version : GifVersion
  pub width : Int
  pub height : Int
  pub has_global_color_table : Bool
  pub color_resolution : Int
  pub global_color_table_sorted : Bool
  pub global_color_table_size : Int
  pub background_color_index : Int
  pub pixel_aspect_ratio : Int
  pub global_color_table : Bytes
}

///| A single decoded, de-interlaced palette-indexed GIF frame (raw sub-rectangle).
pub struct GifIndexedFrame {
  pub left : Int
  pub top : Int
  pub width : Int
  pub height : Int
  pub interlaced : Bool
  pub delay_cs : Int
  pub disposal : DisposalMethod
  pub user_input : Bool
  pub transparent_index : Option[Int]
  pub local_color_table : Bytes
  pub indices : Bytes
}

///| A single composited full-canvas RGBA8888 GIF frame.
pub struct GifFrame {
  pub width : Int
  pub height : Int
  pub left : Int
  pub top : Int
  pub frame_width : Int
  pub frame_height : Int
  pub delay_cs : Int
  pub disposal : DisposalMethod
  pub rgba : Bytes
}

///| Complete decoded multi-frame GIF image with composited RGBA8888 frames.
pub struct GifImage {
  pub header : GifHeader
  pub loop_count : LoopCount
  pub frames : Array[GifFrame]
}

///| Complete decoded multi-frame GIF image with raw palette-indexed frames.
pub struct GifIndexedImage {
  pub header : GifHeader
  pub loop_count : LoopCount
  pub frames : Array[GifIndexedFrame]
}
