///| Day-1 Red-Team Security & DoS Defense Tests:
///  - 5-byte OOM pre-allocation bombs (array32/map32/str32/bin32/ext32 with 0xFFFFFFFF)
///  - 100,000-layer nested arrays & maps (0 SIGSEGV, iterative decode & encode)
///  - max_depth / max_items / max_bytes boundary enforcement
///  - Truncated input safety for every marker type
///  - Trailing bytes rejection
///  - Duplicate map key rejection (small + large O(n) hash table)

///|
test "security_oom_preallocation_bombs" {
  // All 5-byte / 6-byte crafted OOM bombs MUST fail immediately BEFORE allocating!
  let bombs = [
    "dd-ff-ff-ff-ff", // array32(0xFFFFFFFF)
    "df-ff-ff-ff-ff", // map32(0xFFFFFFFF)
    "db-ff-ff-ff-ff", // str32(0xFFFFFFFF)
    "c6-ff-ff-ff-ff", // bin32(0xFFFFFFFF)
    "c9-ff-ff-ff-ff-01", // ext32(0xFFFFFFFF, type=1)
    "dd-7f-ff-ff-ff", // array32(0x7FFFFFFF)
    "df-7f-ff-ff-ff", // map32(0x7FFFFFFF)
    "db-7f-ff-ff-ff", // str32(0x7FFFFFFF)
    "c6-7f-ff-ff-ff", // bin32(0x7FFFFFFF)
    "dc-ff-ff", // array16(65535) with 0 remaining bytes
    "de-ff-ff", // map16(65535) with 0 remaining bytes
    "da-ff-ff", // str16(65535) with 0 remaining bytes
    "c5-ff-ff", // bin16(65535) with 0 remaining bytes
    "c8-ff-ff-01", // ext16(65535) with 0 remaining bytes
  ]
  let relaxed = DecodeOptions::{
    max_depth: 128,
    max_items: 2147483647,
    max_bytes: 2147483647,
    reject_duplicate_keys: false,
    require_canonical: false,
    decode_timestamp: true,
    allow_trailing_bytes: false,
  }
  let mut i = 0
  while i < bombs.length() {
    let raw = hex_to_bytes(bombs[i])
    // Under default limits: must fail with MaxItemsExceeded / MaxBytesExceeded / UnexpectedEof
    match decode_default(raw) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "OOM bomb must fail under default opts: " + bombs[i])
    }
    // Even under relaxed limits (2 GiB): must STILL fail with UnexpectedEof before allocating!
    match decode(raw, relaxed) {
      Err(UnexpectedEof(_)) => ()
      _ => debug_assert(false, "OOM bomb must fail with UnexpectedEof under relaxed opts: " + bombs[i])
    }
    i = i + 1
  }
}

///|
test "security_100k_nesting_zero_sigsegv" {
  // Construct 100,000 nested single-element arrays: 0x91 * 100_000 + 0x90
  let depth = 100000
  let buf = Bytes::new(depth + 1)
  let mut i = 0
  while i < depth {
    buf[i] = (0x91).to_byte()
    i = i + 1
  }
  buf[depth] = (0x90).to_byte()

  // 1. Default max_depth (128) must cleanly reject with MaxDepthExceeded(128) and 0 SIGSEGV.
  match decode_default(buf) {
    Err(MaxDepthExceeded(128)) => ()
    _ => debug_assert(false, "100k nested array must fail with MaxDepthExceeded(128)")
  }

  // 2. With raised max_depth (100005), iterative decoder & encoder & equals must succeed with 0 SIGSEGV!
  let deep_opts = DecodeOptions::{
    max_depth: 100005,
    max_items: 200000,
    max_bytes: 67108864,
    reject_duplicate_keys: false,
    require_canonical: false,
    decode_timestamp: true,
    allow_trailing_bytes: false,
  }
  let decoded = unwrap_val(decode(buf, deep_opts))
  let reencoded = unwrap_bytes(encode_default(decoded))
  debug_assert(reencoded.length() == depth + 1, "100k nested array re-encoded length")
  debug_assert(bytes_equal(reencoded, buf), "100k nested array byte-identical roundtrip")

  // 3. 100,000 nested maps: (0x81, 0x00) * 100_000 + 0x80
  let map_buf = Bytes::new(depth * 2 + 1)
  let mut j = 0
  while j < depth {
    map_buf[j * 2] = (0x81).to_byte()
    map_buf[j * 2 + 1] = (0x00).to_byte()
    j = j + 1
  }
  map_buf[depth * 2] = (0x80).to_byte()
  match decode_default(map_buf) {
    Err(MaxDepthExceeded(128)) => ()
    _ => debug_assert(false, "100k nested map must fail with MaxDepthExceeded(128)")
  }
}

///|
test "security_limits_depth_items_bytes" {
  // max_depth exact boundary: [[[0]]] has depth 3
  let d3 = hex_to_bytes("91-91-91-00")
  let opt_d3 = DecodeOptions::{
    max_depth: 3,
    max_items: 1000,
    max_bytes: 1000,
    reject_duplicate_keys: false,
    require_canonical: false,
    decode_timestamp: true,
    allow_trailing_bytes: false,
  }
  let opt_d2 = DecodeOptions::{
    max_depth: 2,
    max_items: 1000,
    max_bytes: 1000,
    reject_duplicate_keys: false,
    require_canonical: false,
    decode_timestamp: true,
    allow_trailing_bytes: false,
  }
  let _ = unwrap_val(decode(d3, opt_d3))
  match decode(d3, opt_d2) {
    Err(MaxDepthExceeded(2)) => ()
    _ => debug_assert(false, "expected MaxDepthExceeded(2)")
  }

  // max_items exact boundary: array of 5 elements -> 6 total items (1 array + 5 ints)
  let arr5 = hex_to_bytes("95-01-02-03-04-05")
  let opt_i6 = DecodeOptions::{
    max_depth: 32,
    max_items: 6,
    max_bytes: 1000,
    reject_duplicate_keys: false,
    require_canonical: false,
    decode_timestamp: true,
    allow_trailing_bytes: false,
  }
  let opt_i5 = DecodeOptions::{
    max_depth: 32,
    max_items: 5,
    max_bytes: 1000,
    reject_duplicate_keys: false,
    require_canonical: false,
    decode_timestamp: true,
    allow_trailing_bytes: false,
  }
  let _ = unwrap_val(decode(arr5, opt_i6))
  match decode(arr5, opt_i5) {
    Err(MaxItemsExceeded(5)) => ()
    _ => debug_assert(false, "expected MaxItemsExceeded(5)")
  }

  // max_bytes exact boundary: str "abcd" (4 bytes) and bin of 4 bytes
  let str4 = hex_to_bytes("a4-61-62-63-64")
  let bin4 = hex_to_bytes("c4-04-01-02-03-04")
  let opt_b4 = DecodeOptions::{
    max_depth: 32,
    max_items: 1000,
    max_bytes: 4,
    reject_duplicate_keys: false,
    require_canonical: false,
    decode_timestamp: true,
    allow_trailing_bytes: false,
  }
  let opt_b3 = DecodeOptions::{
    max_depth: 32,
    max_items: 1000,
    max_bytes: 3,
    reject_duplicate_keys: false,
    require_canonical: false,
    decode_timestamp: true,
    allow_trailing_bytes: false,
  }
  let _ = unwrap_val(decode(str4, opt_b4))
  let _ = unwrap_val(decode(bin4, opt_b4))
  match decode(str4, opt_b3) {
    Err(MaxBytesExceeded(3)) => ()
    _ => debug_assert(false, "expected MaxBytesExceeded(3) for str")
  }
  match decode(bin4, opt_b3) {
    Err(MaxBytesExceeded(3)) => ()
    _ => debug_assert(false, "expected MaxBytesExceeded(3) for bin")
  }
}

///|
test "security_truncated_inputs_and_trailing_bytes" {
  // Empty input
  match decode_default(Bytes::new(0)) {
    Err(UnexpectedEof(0)) => ()
    _ => debug_assert(false, "empty input must fail with UnexpectedEof(0)")
  }

  // Every marker truncated by 1+ bytes
  let truncated = [
    "cc", // uint8
    "cd-01", // uint16
    "ce-01-02-03", // uint32
    "cf-01-02-03-04-05-06-07", // uint64
    "d0", // int8
    "d1-01", // int16
    "d2-01-02-03", // int32
    "d3-01-02-03-04-05-06-07", // int64
    "ca-01-02-03", // float32
    "cb-01-02-03-04-05-06-07", // float64
    "a3-61-62", // fixstr(3) with 2 bytes
    "d9", // str8 missing len
    "d9-02-61", // str8 missing payload
    "da-00", // str16 missing len
    "db-00-00-01", // str32 missing len
    "c4", // bin8 missing len
    "c4-02-01", // bin8 missing payload
    "c5-00", // bin16 missing len
    "c6-00-00-01", // bin32 missing len
    "92-01", // fixarray(2) missing 2nd element
    "dc-00", // array16 missing len
    "dd-00-00-00", // array32 missing len
    "81-a1-61", // fixmap(1) missing value
    "de-00", // map16 missing len
    "df-00-00-00", // map32 missing len
    "d4-01", // fixext1 missing data
    "d5-01-aa", // fixext2 missing data
    "d6-01-aa-bb-cc", // fixext4 missing data
    "d7-01-01-02-03-04-05-06-07", // fixext8 missing data
    "d8-01-00-01-02-03-04-05-06-07-08-09-0a-0b-0c-0d-0e", // fixext16 missing data
    "c7-01", // ext8 missing type
    "c7-01-05", // ext8 missing data
    "c8-00-01-05", // ext16 missing data
    "c9-00-00-00-01-05", // ext32 missing data
    "d6-ff-00-00-00", // timestamp32 truncated
    "d7-ff-00-00-00-00-00-00-00", // timestamp64 truncated
    "c7-0c-ff-00-00-00-00-00-00-00-00-00-00-00", // timestamp96 truncated
  ]
  let mut i = 0
  while i < truncated.length() {
    match decode_default(hex_to_bytes(truncated[i])) {
      Err(UnexpectedEof(_)) => ()
      _ => debug_assert(false, "expected UnexpectedEof for " + truncated[i])
    }
    i = i + 1
  }

  // Trailing bytes rejected by default, accepted with allow_trailing_bytes=true
  let trailing = hex_to_bytes("c0-c0")
  match decode_default(trailing) {
    Err(TrailingBytes(1)) => ()
    _ => debug_assert(false, "expected TrailingBytes(1)")
  }
  let allow_opts = DecodeOptions::{
    max_depth: 128,
    max_items: 1048576,
    max_bytes: 67108864,
    reject_duplicate_keys: false,
    require_canonical: false,
    decode_timestamp: true,
    allow_trailing_bytes: true,
  }
  debug_assert(msgpack_equals(unwrap_val(decode(trailing, allow_opts)), MsgpackValue::Nil), "allow trailing")
}

///|
test "security_duplicate_map_keys" {
  let reject_opts = DecodeOptions::{
    max_depth: 128,
    max_items: 1048576,
    max_bytes: 67108864,
    reject_duplicate_keys: true,
    require_canonical: false,
    decode_timestamp: true,
    allow_trailing_bytes: false,
  }
  // Duplicate string keys: {"a": 1, "a": 2}
  let dup_str = hex_to_bytes("82-a1-61-01-a1-61-02")
  // Allowed by default
  let _ = unwrap_val(decode_default(dup_str))
  // Rejected when reject_duplicate_keys=true
  match decode(dup_str, reject_opts) {
    Err(DuplicateMapKey(_)) => ()
    _ => debug_assert(false, "expected DuplicateMapKey for duplicate string key")
  }

  // Duplicate integer keys with different wire encodings: {1: true, uint16(1): false}
  let dup_int = hex_to_bytes("82-01-c3-cd-00-01-c2")
  match decode(dup_int, reject_opts) {
    Err(DuplicateMapKey(_)) => ()
    _ => debug_assert(false, "expected DuplicateMapKey for overlong duplicate int key")
  }

  // Distinct float keys: +0.0 vs -0.0
  let distinct_zeros = hex_to_bytes("82-cb-00-00-00-00-00-00-00-00-01-cb-80-00-00-00-00-00-00-00-02")
  let _ = unwrap_val(decode(distinct_zeros, reject_opts))

  // Large map (2000 unique keys + 1 duplicate at end) tests O(n) hash table path
  let pairs : Array[(MsgpackValue, MsgpackValue)] = []
  let mut i = 0
  while i < 2000 {
    pairs.push((MsgpackValue::Str("k_" + i.to_string()), MsgpackValue::UInt(i.to_int64().to_uint64())))
    i = i + 1
  }
  let ok_map_bytes = unwrap_bytes(encode_default(MsgpackValue::Map(pairs)))
  let _ = unwrap_val(decode(ok_map_bytes, reject_opts))

  pairs.push((MsgpackValue::Str("k_0"), MsgpackValue::UInt(9999UL)))
  let dup_map_bytes = unwrap_bytes(encode_default(MsgpackValue::Map(pairs)))
  match decode(dup_map_bytes, reject_opts) {
    Err(DuplicateMapKey(_)) => ()
    _ => debug_assert(false, "expected DuplicateMapKey in 2001-key map")
  }
}
