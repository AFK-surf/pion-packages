///| Red-team audit helpers for packages/msgpack (no production code; see ../REPORT.md).

import "msgpack"

///|
fn audit_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
pub fn hx(s : String) -> Bytes {
  let n = s.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = audit_nibble(s.code_unit_at(2 * i).to_int())
    let lo = audit_nibble(s.code_unit_at(2 * i + 1).to_int())
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

///|
pub fn tohex(b : Bytes) -> String {
  let d = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    sb.write_string(d.slice(v >> 4, (v >> 4) + 1))
    sb.write_string(d.slice(v & 15, (v & 15) + 1))
    i = i + 1
  }
  sb.to_string()
}

///| `prefix` bytes followed by `body`.
pub fn cat(prefix : Bytes, body : Bytes) -> Bytes {
  prefix.concat(body)
}

///| n copies of byte `b`.
pub fn rep(b : Int, n : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = b.to_byte()
    i = i + 1
  }
  out
}

///|
pub fn outcome(r : Result[msgpack::MsgpackValue, msgpack::MsgpackError]) -> String {
  match r {
    Ok(_) => "OK"
    Err(e) => "ERR " + msgpack::error_message(e)
  }
}

///|
pub fn unit_outcome(r : Result[Unit, msgpack::MsgpackError]) -> String {
  match r {
    Ok(_) => "OK"
    Err(e) => "ERR " + msgpack::error_message(e)
  }
}

///|
pub fn with_depth(d : Int) -> msgpack::DecodeOptions {
  msgpack::DecodeOptions::{ ..msgpack::DecodeOptions::default(), max_depth: d }
}

///|
pub fn with_dup() -> msgpack::DecodeOptions {
  msgpack::DecodeOptions::{ ..msgpack::DecodeOptions::default(), reject_duplicate_keys: true }
}
