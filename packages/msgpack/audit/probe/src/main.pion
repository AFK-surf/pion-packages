///| Red-team differential / DoS probe for packages/msgpack (audit only, no production code).
///
///   probe tree  <opts> <file-of-hex-lines>   one line per input: "OK <tree> <re-encoding hex>" | "ERR <msg>"
///   probe bench <dec|validate|prefix|all> <opts> <file.msgpack> <iters>
///   probe deep  <a|m> <n> <max_depth> <decode|validate|encode|equals|prefix|all|strict>
///   probe bigenc <mib> <copies>        encode [Bin(mib MiB)] x copies (shared Bytes, 32-bit size overflow probe)
///
/// <opts> is "-" (DecodeOptions::default()) or a comma list of:
///   ts0 (decode_timestamp=false) dup (reject_duplicate_keys) canon (require_canonical)
///   strict (DecodeOptions::strict()) trail (allow_trailing_bytes) compact (EncodeOptions::compact())
///   depth=N items=N bytes=N
/// The tree format is shared with ../rust and ../go/cmd/probe so outputs diff line by line.

import "msgpack"

///|
fn nib(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

///|
fn hex_range(src : Bytes, start : Int, end : Int) -> Bytes {
  let n = (end - start) / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = nib(src[start + 2 * i].to_int())
    let lo = nib(src[start + 2 * i + 1].to_int())
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

///|
fn hexd(sb : StringBuilder, v : Int) -> Unit {
  let d = "0123456789abcdef"
  sb.write_string(d.slice(v, v + 1))
}

///|
fn hex_bytes(sb : StringBuilder, b : Bytes) -> Unit {
  let mut i = 0
  while i < b.length() {
    let v = b[i].to_int()
    hexd(sb, v >> 4)
    hexd(sb, v & 15)
    i = i + 1
  }
}

///|
fn hex_str(sb : StringBuilder, s : String) -> Unit {
  let mut i = 0
  while i < s.length() {
    let v = s.code_unit_at(i).to_int() & 0xFF
    hexd(sb, v >> 4)
    hexd(sb, v & 15)
    i = i + 1
  }
}

///|
fn hex_u64(sb : StringBuilder, v : UInt64, digits : Int) -> Unit {
  let mut k = digits - 1
  while k >= 0 {
    hexd(sb, ((v >> (k * 4)) & 15UL).to_int())
    k = k - 1
  }
}

///|
fn tree(sb : StringBuilder, v : msgpack::MsgpackValue) -> Unit {
  match v {
    Nil => sb.write_string("nil")
    Bool(b) => sb.write_string(if b { "T" } else { "F" })
    UInt(u) => sb.write_string("u" + u.to_string())
    Int(x) =>
    if x >= 0L {
      sb.write_string("u" + x.to_string())
    } else {
      sb.write_string("i" + x.to_string())
    }
    Float32(d) => {
      sb.write_string("f32:")
      hex_u64(sb, msgpack::double_to_float32_bits(d).to_uint64(), 8)
    }
    Float64(d) => {
      sb.write_string("f64:")
      hex_u64(sb, d.to_bits().to_uint64(), 16)
    }
    Str(s) => {
      sb.write_string("s:")
      hex_str(sb, s)
    }
    Bin(b) => {
      sb.write_string("b:")
      hex_bytes(sb, b)
    }
    Ext(t, b) => {
      sb.write_string("x" + t.to_string() + ":")
      hex_bytes(sb, b)
    }
    Timestamp(sec, nsec) => sb.write_string("t" + sec.to_string() + "." + nsec.to_string())
    Array(items) => {
      sb.write_string("[")
      let mut i = 0
      while i < items.length() {
        if i > 0 {
          sb.write_string(",")
        }
        tree(sb, items[i])
        i = i + 1
      }
      sb.write_string("]")
    }
    Map(pairs) => {
      sb.write_string("{")
      let mut i = 0
      while i < pairs.length() {
        if i > 0 {
          sb.write_string(",")
        }
        let (k, x) = pairs[i]
        tree(sb, k)
        sb.write_string(":")
        tree(sb, x)
        i = i + 1
      }
      sb.write_string("}")
    }
  }
}

///|
fn parse_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i).to_int() - 48)
    i = i + 1
  }
  v
}

///|
fn parse_opts(spec : String) -> msgpack::DecodeOptions {
  let mut o = msgpack::DecodeOptions::default()
  if spec == "-" {
    return o
  }
  let parts = spec.split(",")
  let mut i = 0
  while i < parts.length() {
    let p = parts[i]
    if p == "ts0" {
      o = msgpack::DecodeOptions::{ ..o, decode_timestamp: false }
    } else if p == "dup" {
      o = msgpack::DecodeOptions::{ ..o, reject_duplicate_keys: true }
    } else if p == "canon" {
      o = msgpack::DecodeOptions::{ ..o, require_canonical: true }
    } else if p == "strict" {
      o = msgpack::DecodeOptions::strict()
    } else if p == "trail" {
      o = msgpack::DecodeOptions::{ ..o, allow_trailing_bytes: true }
    } else if p.starts_with("depth=") {
      o = msgpack::DecodeOptions::{ ..o, max_depth: parse_int(p.slice(6, p.length())) }
    } else if p.starts_with("items=") {
      o = msgpack::DecodeOptions::{ ..o, max_items: parse_int(p.slice(6, p.length())) }
    } else if p.starts_with("bytes=") {
      o = msgpack::DecodeOptions::{ ..o, max_bytes: parse_int(p.slice(6, p.length())) }
    }
    i = i + 1
  }
  o
}

///|
fn run_one(opts : msgpack::DecodeOptions, eopts : msgpack::EncodeOptions, input : Bytes) -> String {
  match msgpack::decode(input, opts) {
    Err(e) => "ERR " + msgpack::error_message(e)
    Ok(v) => {
      let sb = StringBuilder::new()
      sb.write_string("OK ")
      tree(sb, v)
      sb.write_string(" ")
      match msgpack::encode(v, eopts) {
        Ok(b) => hex_bytes(sb, b)
        Err(e) => sb.write_string("ENCERR:" + msgpack::error_message(e))
      }
      sb.to_string()
    }
  }
}

///|
fn run_tree(world : World, spec : String, path : String) -> Int {
  let src = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => return 1
  }
  let opts = parse_opts(spec)
  let eopts = if spec.contains("compact") {
    msgpack::EncodeOptions::compact()
  } else {
    msgpack::EncodeOptions::default()
  }
  let mut start = 0
  let mut i = 0
  while i <= src.length() {
    if i == src.length() || src[i].to_int() == 10 {
      if i > start {
        io_println(world, run_one(opts, eopts, hex_range(src, start, i)))
      } else if i < src.length() {
        io_println(world, run_one(opts, eopts, Bytes::new(0)))
      }
      start = i + 1
    }
    i = i + 1
  }
  0
}

///| (nodes, str+bin+ext payload bytes) — same accumulation as ../rust and ../go bench.
fn walk(v : msgpack::MsgpackValue, acc : Array[Int64]) -> Unit {
  acc[0] = acc[0] + 1L
  match v {
    Str(s) => acc[1] = acc[1] + s.length().to_int64()
    Bin(b) => acc[1] = acc[1] + b.length().to_int64()
    Ext(_, b) => acc[1] = acc[1] + b.length().to_int64()
    Array(items) => {
      let mut i = 0
      while i < items.length() {
        walk(items[i], acc)
        i = i + 1
      }
    }
    Map(pairs) => {
      let mut i = 0
      while i < pairs.length() {
        let (k, x) = pairs[i]
        walk(k, acc)
        walk(x, acc)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn run_bench(world : World, mode : String, spec : String, path : String, iters : Int) -> Int {
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => return 1
  }
  let opts = parse_opts(spec)
  let acc : Array[Int64] = [0L, 0L]
  let mut frames = 0
  let mut r = 0
  while r < iters {
    if mode == "dec" {
      match msgpack::decode(data, opts) {
        Ok(v) => walk(v, acc)
        Err(e) => {
          io_println(world, "ERR " + msgpack::error_message(e))
          return 2
        }
      }
    } else if mode == "validate" {
      match msgpack::validate(data, opts) {
        Ok(_) => acc[0] = acc[0] + 1L
        Err(e) => {
          io_println(world, "ERR " + msgpack::error_message(e))
          return 2
        }
      }
    } else if mode == "prefix" {
      // Idiomatic streaming loop over a buffer of concatenated frames.
      let mut off = 0
      while off < data.length() {
        match msgpack::decode_prefix_at(data, off, opts) {
          Ok((v, used)) => {
            walk(v, acc)
            off = off + used
            frames = frames + 1
          }
          Err(e) => {
            io_println(world, "ERR " + msgpack::error_message(e))
            return 2
          }
        }
      }
    } else {
      match msgpack::decode_all(data, opts) {
        Ok(vs) => {
          let mut i = 0
          while i < vs.length() {
            walk(vs[i], acc)
            i = i + 1
          }
          frames = frames + vs.length()
        }
        Err(e) => {
          io_println(world, "ERR " + msgpack::error_message(e))
          return 2
        }
      }
    }
    r = r + 1
  }
  io_println(world, "nodes=" + acc[0].to_string())
  io_println(world, "payload_bytes=" + acc[1].to_string())
  0
}

///| n nested containers around a nil: [[[...nil]]] or {0:{0:{...nil}}}.
fn deep_bytes(kind : String, n : Int) -> Bytes {
  if kind == "a" {
    let b = Bytes::new(n + 1)
    let mut i = 0
    while i < n {
      b[i] = (0x91).to_byte()
      i = i + 1
    }
    b[n] = (0xC0).to_byte()
    b
  } else {
    let b = Bytes::new(2 * n + 1)
    let mut i = 0
    while i < n {
      b[2 * i] = (0x81).to_byte()
      b[2 * i + 1] = (0x00).to_byte()
      i = i + 1
    }
    b[2 * n] = (0xC0).to_byte()
    b
  }
}

///|
fn deep_value(kind : String, n : Int) -> msgpack::MsgpackValue {
  let mut v = msgpack::MsgpackValue::Nil
  let mut i = 0
  while i < n {
    v = if kind == "a" {
      msgpack::MsgpackValue::Array([v])
    } else {
      msgpack::MsgpackValue::Map([(msgpack::MsgpackValue::UInt(0UL), v)])
    }
    i = i + 1
  }
  v
}

///|
fn res_str(r : Result[Unit, msgpack::MsgpackError]) -> String {
  match r {
    Ok(_) => "OK"
    Err(e) => "ERR " + msgpack::error_message(e)
  }
}

///|
fn run_deep(world : World, kind : String, n : Int, max_depth : Int, op : String) -> Int {
  let opts = msgpack::DecodeOptions::{ ..msgpack::DecodeOptions::default(), max_depth: max_depth }
  let data = deep_bytes(kind, n)
  let out = if op == "decode" {
    res_str(
      match msgpack::decode(data, opts) {
        Ok(_) => Result::Ok(())
        Err(e) => Result::Err(e)
      },
    )
  } else if op == "strict" {
    let so = msgpack::DecodeOptions::{ ..msgpack::DecodeOptions::strict(), max_depth: max_depth }
    res_str(
      match msgpack::decode(data, so) {
        Ok(_) => Result::Ok(())
        Err(e) => Result::Err(e)
      },
    )
  } else if op == "validate" {
    res_str(msgpack::validate(data, opts))
  } else if op == "prefix" {
    res_str(
      match msgpack::decode_prefix(data, opts) {
        Ok(_) => Result::Ok(())
        Err(e) => Result::Err(e)
      },
    )
  } else if op == "all" {
    res_str(
      match msgpack::decode_all(data, opts) {
        Ok(_) => Result::Ok(())
        Err(e) => Result::Err(e)
      },
    )
  } else if op == "encode" {
    let v = deep_value(kind, n)
    match msgpack::encode_default(v) {
      Ok(b) => if b.length() == data.length() { "OK" } else { "ERR length mismatch" }
      Err(e) => "ERR " + msgpack::error_message(e)
    }
  } else {
    let a = deep_value(kind, n)
    let b = deep_value(kind, n)
    if msgpack::msgpack_equals(a, b) {
      "OK"
    } else {
      "ERR not equal"
    }
  }
  io_println(world, out)
  0
}

///| Encode an Array of `copies` references to one shared `mib`-MiB Bin (cheap to build: RC-shared).
///  Total encoded size = copies * (mib MiB + 5) + 5; above 2^31-1 it no longer fits Pion's 32-bit `Int`.
fn run_bigenc(world : World, mib : Int, copies : Int) -> Int {
  let blob = msgpack::MsgpackValue::Bin(Bytes::new(mib * 1048576))
  let items : Array[msgpack::MsgpackValue] = []
  let mut i = 0
  while i < copies {
    items.push(blob)
    i = i + 1
  }
  match msgpack::encode_default(msgpack::MsgpackValue::Array(items)) {
    Ok(b) => io_println(world, "OK encoded " + b.length().to_string() + " bytes")
    Err(e) => io_println(world, "ERR " + msgpack::error_message(e))
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: probe tree|bench|deep ...")
    return 1
  }
  let cmd = args[1]
  if cmd == "tree" && args.length() >= 4 {
    run_tree(world, args[2], args[3])
  } else if cmd == "bench" && args.length() >= 6 {
    run_bench(world, args[2], args[3], args[4], parse_int(args[5]))
  } else if cmd == "deep" && args.length() >= 6 {
    run_deep(world, args[2], parse_int(args[3]), parse_int(args[4]), args[5])
  } else if cmd == "bigenc" && args.length() >= 4 {
    run_bigenc(world, parse_int(args[2]), parse_int(args[3]))
  } else {
    io_println(world, "bad args")
    1
  }
}
