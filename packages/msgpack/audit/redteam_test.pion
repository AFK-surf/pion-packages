///| Red-team regression tests for packages/msgpack @ ef53ce0 (branch feat/pkg-msgpack).
///
/// Every `redteam_*` test asserts the behaviour of the reference implementations
/// (Rust rmpv =1.3.1, Go vmihailenco/msgpack/v5 v5.4.1) or Pion's own documented contract —
/// a FAILURE here is the evidence. `control_*` tests are attacks Pion survived; they must stay green.
/// Crash / DoS findings (quadratic time, panics) cannot live in a unit test that must finish:
/// they are reproduced by ./run_audit.sh (see REPORT.md F-1..F-3).

import "msgpack"

// ---------------------------------------------------------------------------
// F-4 (P2) decode() silently clamps max_depth to 1024 while validate() honours it, and the
// error names 1024 instead of the limit the caller passed. rmpv read_value_with_max_depth(2000)
// and Go (no depth limit) both decode the same 1025-deep document.
// ---------------------------------------------------------------------------

///|
test "redteam_decode_honours_caller_max_depth_like_validate" {
  let data = cat(rep(0x91, 1025), hx("c0"))
  let opts = with_depth(2000)
  let d = outcome(msgpack::decode(data, opts))
  let v = unit_outcome(msgpack::validate(data, opts))
  debug_assert(d == v, "max_depth=2000, 1025 deep: decode=" + d + " but validate=" + v)
}

///|
test "redteam_validate_depth_independent_of_dup_flag" {
  // validate() switches to decode() (and its hidden 1024 cap) as soon as reject_duplicate_keys is on.
  let data = cat(rep(0x91, 1025), hx("c0"))
  let plain = unit_outcome(msgpack::validate(data, with_depth(2000)))
  let dup = unit_outcome(
    msgpack::validate(data, msgpack::DecodeOptions::{ ..with_depth(2000), reject_duplicate_keys: true }),
  )
  debug_assert(plain == dup, "validate: plain=" + plain + " dup=" + dup)
}

// ---------------------------------------------------------------------------
// F-5 (P2) Default max_depth is 128: decode_default() rejects ordinary documents nested
// 129..1024 deep that rmpv's default read_value (MAX_DEPTH 1024) and Go both accept.
// ---------------------------------------------------------------------------

///|
test "redteam_default_depth_compat_with_rmpv_1024" {
  let data = cat(rep(0x91, 129), hx("01"))
  let got = outcome(msgpack::decode_default(data))
  debug_assert(got == "OK", "129-deep array (rmpv/Go: OK): " + got)
}

// ---------------------------------------------------------------------------
// F-6 (P2) DuplicateMapKey offset is wrong once the map sits at depth >= 64 (iterative path):
// frame_key_pos records the start of the *last scalar* read, not of the key, when the key is a
// container. The same map reports offset 4 at depth 0 and 64+5 (not 64+4) at depth 64.
// ---------------------------------------------------------------------------

///|
test "redteam_dup_key_offset_same_in_iterative_path" {
  let map = hx("82910100910100") // {[1]:0, [1]:0} -> 2nd key at offset 4
  let shallow = outcome(msgpack::decode(map, with_dup()))
  debug_assert(shallow == "ERR msgpack: duplicate map key at offset 4", "depth 0: " + shallow)
  let deep = outcome(msgpack::decode(cat(rep(0x91, 64), map), with_dup()))
  debug_assert(
    deep == "ERR msgpack: duplicate map key at offset 68",
    "depth 64: expected offset 68, got " + deep,
  )
}

// ---------------------------------------------------------------------------
// F-7 (P2) encode() accepts Ext(-1, <len not 4/8/12>) and emits bytes that Pion's own default
// decoder rejects (InvalidTimestamp): encode/decode round-trip broken for a value the encoder
// approved. rmpv round-trips Ext(-1, [0,0,0]) unchanged.
// ---------------------------------------------------------------------------

///|
test "redteam_encode_rejects_or_roundtrips_ext_minus1" {
  let v = msgpack::MsgpackValue::Ext(-1, hx("000000"))
  match msgpack::encode_default(v) {
    Err(_) => ()
    Ok(b) => {
      let back = outcome(msgpack::decode_default(b))
      debug_assert(back == "OK", "encode_default(Ext(-1, 3 bytes)) = " + tohex(b) + " but decode: " + back)
    }
  }
}

// ---------------------------------------------------------------------------
// Controls — attacks Pion survived (must stay green).
// ---------------------------------------------------------------------------

///|
test "control_le_2mib_to_string_fast_path_mixed_bin_str" {
  // Non-UTF-8 bin blobs next to valid str in a <= 2 MiB buffer (the `data.to_string()` cache path):
  // Pion strings are byte strings, to_string() is a raw memcpy on native and wasm32, so offsets hold.
  let small = hx("94c404fffe80c3a5c3a9e29c93c401ffa7f09f9880616263")
  match msgpack::decode_default(small) {
    Ok(Array(items)) => {
      debug_assert(items.length() == 4, "4 items")
      match items[1] {
        Str(s) => debug_assert(s == "é✓", "str #1 bytes intact")
        _ => debug_assert(false, "item 1 must be Str")
      }
      match items[3] {
        Str(s) => debug_assert(s == "😀abc", "str #2 bytes intact")
        _ => debug_assert(false, "item 3 must be Str")
      }
      match items[0] {
        Bin(b) => debug_assert(tohex(b) == "fffe80c3", "bin intact")
        _ => debug_assert(false, "item 0 must be Bin")
      }
    }
    _ => debug_assert(false, "small mixed buffer must decode")
  }
  // Same content behind a 2.1 MiB bin forces the > 2 MiB slice path: identical strings.
  let big_bin = cat(hx("c6" + "00210000"), rep(0xFF, 0x210000))
  let big = cat(cat(hx("92"), big_bin), hx("a5c3a9e29c93"))
  match msgpack::decode_default(big) {
    Ok(Array(items)) =>
    match items[1] {
      Str(s) => debug_assert(s == "é✓", "> 2 MiB path str intact")
      _ => debug_assert(false, "item 1 must be Str")
    }
    _ => debug_assert(false, "big mixed buffer must decode")
  }
  // invalid str after an invalid bin is still caught at the right offset in both paths
  let bad = outcome(msgpack::decode_default(hx("92c401ffa2c328")))
  debug_assert(bad == "ERR msgpack: invalid UTF-8 string at offset 5", "small bad: " + bad)
}

///|
test "control_duplicate_key_eq_hash_consistency" {
  // Same verdict in the <= 8-key linear path and the > 8-key hash path (eq(a,b) => hash(a)==hash(b)).
  let pad = "a26b61c0a26b62c0a26b63c0a26b64c0a26b65c0a26b66c0a26b67c0a26b68c0a26b69c0a26b6ac0"
  let cases = [
    ("00", "cc00", true), ("00", "d000", true), ("d30000000000000005", "cf0000000000000005", true),
    ("cb0000000000000000", "ca00000000", false), ("cb0000000000000000", "cb8000000000000000", false),
    ("cb7ff8000000000000", "cb7ff8000000000000", true), ("cb7ff8000000000000", "cb7ff8000000000001", false),
    ("a161", "c40161", false), ("a161", "d90161", true), ("d6ff00000007", "d7ff0000000000000007", true),
    ("9101", "91cc01", true), ("ff", "cfffffffffffffffff", false), ("c0", "c0", true),
  ]
  let mut i = 0
  while i < cases.length() {
    let (a, b, dup) = cases[i]
    let small = outcome(msgpack::decode(hx("82" + a + "01" + b + "02"), with_dup()))
    let large = outcome(msgpack::decode(hx("de000c" + pad + a + "01" + b + "02"), with_dup()))
    debug_assert(small.starts_with("ERR") == dup, a + " vs " + b + " small path: " + small)
    debug_assert(large.starts_with("ERR") == dup, a + " vs " + b + " hash path: " + large)
    i = i + 1
  }
  // user-constructed Int(5) / UInt(5) are equal; Float32(0.0) and Float64(0.0) are not
  debug_assert(msgpack::msgpack_equals(msgpack::MsgpackValue::Int(5L), msgpack::MsgpackValue::UInt(5UL)), "Int(5)==UInt(5)")
  debug_assert(
    !msgpack::msgpack_equals(msgpack::MsgpackValue::Int(-1L), msgpack::MsgpackValue::UInt(18446744073709551615UL)),
    "Int(-1) != UInt(MAX)",
  )
}

///|
test "control_depth_boundaries_consistent_around_64_and_1024" {
  let depths = [1, 62, 63, 64, 65, 66, 127, 128, 129, 1023, 1024]
  let mut i = 0
  while i < depths.length() {
    let d = depths[i]
    let arr = cat(rep(0x91, d), hx("c0"))
    let mb = Bytes::new(2 * d)
    let mut j = 0
    while j < d {
      mb[2 * j] = (0x81).to_byte()
      mb[2 * j + 1] = (0x00).to_byte()
      j = j + 1
    }
    let map = cat(mb, hx("c0"))
    let inputs = [arr, map]
    let mut k = 0
    while k < 2 {
      let data = inputs[k]
      // exactly at the limit: accepted everywhere; one below: rejected everywhere
      let at = with_depth(d)
      debug_assert(outcome(msgpack::decode(data, at)) == "OK", "decode at limit " + d.to_string())
      debug_assert(unit_outcome(msgpack::validate(data, at)) == "OK", "validate at limit")
      debug_assert(
        outcome(msgpack::decode(data, msgpack::DecodeOptions::{ ..at, reject_duplicate_keys: true })) == "OK",
        "dup decode at limit",
      )
      match msgpack::decode_prefix(data, at) {
        Ok((_, used)) => debug_assert(used == data.length(), "prefix consumed all")
        Err(_) => debug_assert(false, "prefix at limit")
      }
      let below = with_depth(d - 1)
      let e1 = outcome(msgpack::decode(data, below))
      let e2 = unit_outcome(msgpack::validate(data, below))
      debug_assert(e1.starts_with("ERR") && e1 == e2, "below limit " + d.to_string() + ": " + e1 + " / " + e2)
      // encode(decode(x)) == x and msgpack_equals across the 64 recursion switch
      match msgpack::decode(data, at) {
        Ok(v) =>
        match msgpack::encode_default(v) {
          Ok(b) => {
            debug_assert(tohex(b) == tohex(data), "re-encode depth " + d.to_string())
            match msgpack::decode(b, at) {
              Ok(w) => debug_assert(msgpack::msgpack_equals(v, w), "equals depth " + d.to_string())
              Err(_) => debug_assert(false, "re-decode")
            }
          }
          Err(_) => debug_assert(false, "encode")
        }
        Err(_) => debug_assert(false, "decode")
      }
      k = k + 1
    }
    i = i + 1
  }
}

///|
test "control_float_bits_and_compact_floats" {
  let f32s = [
    "00000000", "80000000", "00000001", "007fffff", "00800000", "7f7fffff", "7f800000", "ff800000",
    "7fc00000", "7f800001", "7fbfffff", "ffc00001", "7fffffff",
  ]
  let mut i = 0
  while i < f32s.length() {
    let raw = hx("ca" + f32s[i])
    match msgpack::decode_default(raw) {
      Ok(v) =>
      match msgpack::encode_default(v) {
        Ok(b) => debug_assert(tohex(b) == "ca" + f32s[i], "f32 bits " + f32s[i] + " -> " + tohex(b))
        Err(_) => debug_assert(false, "encode f32")
      }
      Err(_) => debug_assert(false, "decode f32")
    }
    i = i + 1
  }
  // compact_floats: only lossless narrowing (-0.0 ok; 16777217, 1e40, 1e-40, low-bit NaN payload stay f64)
  let c = msgpack::EncodeOptions::compact()
  let cases = [
    ("8000000000000000", "ca80000000"), ("4170000010000000", "cb4170000010000000"),
    ("483d6329f1c35ca5", "cb483d6329f1c35ca5"), ("37a16c262777579c", "cb37a16c262777579c"),
    ("7ff0000000000001", "cb7ff0000000000001"), ("36a0000000000000", "ca00000001"),
    ("7ff8000020000000", "ca7fc00001"),
  ]
  let mut j = 0
  while j < cases.length() {
    let (bits, want) = cases[j]
    match msgpack::decode_default(hx("cb" + bits)) {
      Ok(v) =>
      match msgpack::encode(v, c) {
        Ok(b) => debug_assert(tohex(b) == want, "compact " + bits + " -> " + tohex(b) + " want " + want)
        Err(_) => debug_assert(false, "encode compact")
      }
      Err(_) => debug_assert(false, "decode f64")
    }
    j = j + 1
  }
}

///|
test "control_timestamp_and_canonical_strictness" {
  let strict = msgpack::DecodeOptions::strict()
  let reject = [
    "d7ffee6b280000000000", "c70cff3b9aca00ffffffffffffffff", "c703ff000000", "d4ff00", "d8ff00000000000000000000000000000000",
  ]
  let mut i = 0
  while i < reject.length() {
    debug_assert(outcome(msgpack::decode_default(hx(reject[i]))).starts_with("ERR"), "invalid ts " + reject[i])
    i = i + 1
  }
  let noncanon = [
    "c704ff00000007", "c80008ff0000001c00000007", "c9 0000000cff00000007fffffffffffffff9", "d7ff0000000000000007",
    "c70cff000000050000000000000005", "d90568656c6c6f", "c5000a00000000000000000000", "c7040500000000",
    "dc00020102", "de000201010202", "cc05", "d005", "d3ffffffffffffffff", "cd00ff", "9191d005",
  ]
  let mut j = 0
  while j < noncanon.length() {
    let h = noncanon[j].replace(" ", "")
    let r = outcome(msgpack::decode(hx(h), strict))
    debug_assert(r.starts_with("ERR msgpack: non-canonical"), "strict must reject " + h + ": " + r)
    // ...and the default decoder + canonical encoder fixes it so strict accepts the re-encoding
    match msgpack::decode_default(hx(h)) {
      Ok(v) =>
      match msgpack::encode_default(v) {
        Ok(b) => debug_assert(outcome(msgpack::decode(b, strict)) == "OK", "re-encoding of " + h + " is canonical")
        Err(_) => debug_assert(false, "encode")
      }
      Err(_) => debug_assert(false, "default decode " + h)
    }
    j = j + 1
  }
  // decode_timestamp=false keeps the raw ext, even for lengths the Timestamp decoder would reject
  let raw = msgpack::DecodeOptions::{ ..msgpack::DecodeOptions::default(), decode_timestamp: false }
  match msgpack::decode(hx("c703ff000000"), raw) {
    Ok(Ext(t, b)) => debug_assert(t == -1 && tohex(b) == "000000", "raw ext kept")
    _ => debug_assert(false, "decode_timestamp=false must keep Ext(-1, ...)")
  }
}

///|
test "control_encode_invalid_values_return_err" {
  let bad = [
    msgpack::MsgpackValue::Timestamp(0L, -1), msgpack::MsgpackValue::Timestamp(0L, 1000000000),
    msgpack::MsgpackValue::Ext(128, hx("00")), msgpack::MsgpackValue::Ext(-129, hx("00")),
    msgpack::MsgpackValue::Array([msgpack::MsgpackValue::Nil, msgpack::MsgpackValue::Timestamp(-5L, 2000000000)]),
  ]
  let mut i = 0
  while i < bad.length() {
    match msgpack::encode_default(bad[i]) {
      Err(_) => ()
      Ok(b) => debug_assert(false, "invalid value encoded: " + tohex(b))
    }
    i = i + 1
  }
}
