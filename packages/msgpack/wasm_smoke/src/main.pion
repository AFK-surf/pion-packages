///| Wasm32 smoke entry for the `msgpack` package.

import "msgpack"

///|
pub fn smoke() -> Int {
  let bin_val = Bytes::new(2)
  bin_val[0] = (0xDE).to_byte()
  bin_val[1] = (0xAD).to_byte()
  let payload = msgpack::MsgpackValue::Map([
    (msgpack::MsgpackValue::Str("ok"), msgpack::MsgpackValue::Bool(true)),
    (msgpack::MsgpackValue::Str("count"), msgpack::MsgpackValue::UInt(42UL)),
    (msgpack::MsgpackValue::Str("delta"), msgpack::MsgpackValue::Int(-100L)),
    (msgpack::MsgpackValue::Str("score"), msgpack::MsgpackValue::Float64(1.5)),
    (msgpack::MsgpackValue::Str("ts"), msgpack::MsgpackValue::Timestamp(1700000000L, 123456789)),
    (msgpack::MsgpackValue::Str("bin"), msgpack::MsgpackValue::Bin(bin_val)),
  ])
  let encoded = match msgpack::encode_default(payload) {
    Ok(b) => b
    Err(_) => return -1
  }
  let decoded = match msgpack::decode(encoded, msgpack::DecodeOptions::strict()) {
    Ok(v) => v
    Err(_) => return -2
  }
  if !msgpack::msgpack_equals(decoded, payload) {
    return -3
  }
  encoded.length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
