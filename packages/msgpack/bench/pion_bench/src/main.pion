///| Head-to-head benchmark binary for packages/msgpack (Pion Native):
///  - decode-rpc <file>   : 40 x 2,000 = 80,000 nested RPC/Telemetry records
///  - encode-rpc          : 50,000 nested RPC/Telemetry records
///  - decode-large <file> : 4 x ~16 MiB = ~64 MiB large bin + str + array payload

import "msgpack"

///|
val struct WalkStats {
  nodes : Int64
  checksum : UInt64
}

///| Order-independent structural checksum (commutative over Map entries so Go's
///  randomized map[string]any iteration produces the exact same SHA-256 stdout).
fn walk_value(value : msgpack::MsgpackValue) -> WalkStats {
  match value {
    Nil => WalkStats::{ nodes: 1L, checksum: 19UL }
    Bool(b) => WalkStats::{ nodes: 1L, checksum: if b { 13UL } else { 17UL } }
    UInt(u) => WalkStats::{ nodes: 1L, checksum: u + 1UL }
    Int(v) =>
    if v >= 0L {
      WalkStats::{ nodes: 1L, checksum: v.to_uint64() + 1UL }
    } else {
      WalkStats::{ nodes: 1L, checksum: (0UL - v.to_uint64()) * 3UL + 5UL }
    }
    Float32(d) => WalkStats::{ nodes: 1L, checksum: d.to_bits().to_uint64() }
    Float64(d) => WalkStats::{ nodes: 1L, checksum: d.to_bits().to_uint64() }
    Str(s) => {
      let n = s.length()
      let mut h : UInt64 = n.to_int64().to_uint64() * 11UL
      if n > 0 {
        h = h + s.code_unit_at(0).to_int64().to_uint64()
        h = h + s.code_unit_at(n - 1).to_int64().to_uint64()
      }
      WalkStats::{ nodes: 1L, checksum: h }
    }
    Bin(b) => {
      let n = b.length()
      let mut h : UInt64 = n.to_int64().to_uint64() * 7UL
      if n > 0 {
        h = h + b[0].to_int().to_int64().to_uint64()
        h = h + b[n - 1].to_int().to_int64().to_uint64()
      }
      WalkStats::{ nodes: 1L, checksum: h }
    }
    Ext(tag, b) => {
      let h : UInt64 = (tag + 128).to_int64().to_uint64() * 29UL + b.length().to_int64().to_uint64()
      WalkStats::{ nodes: 1L, checksum: h }
    }
    Timestamp(sec, nsec) => {
      let h : UInt64 = sec.to_uint64() * 31UL + nsec.to_int64().to_uint64()
      WalkStats::{ nodes: 1L, checksum: h }
    }
    Array(items) => {
      let n = items.length()
      let mut nodes : Int64 = 1L
      let mut sum : UInt64 = n.to_int64().to_uint64() * 37UL
      let mut i = 0
      while i < n {
        let sub = walk_value(items[i])
        nodes = nodes + sub.nodes
        sum = sum + sub.checksum
        i = i + 1
      }
      WalkStats::{ nodes: nodes, checksum: sum }
    }
    Map(pairs) => {
      let n = pairs.length()
      let mut nodes : Int64 = 1L
      let mut sum : UInt64 = n.to_int64().to_uint64() * 41UL
      let mut i = 0
      while i < n {
        let (k, v) = pairs[i]
        let sk = walk_value(k)
        let sv = walk_value(v)
        nodes = nodes + sk.nodes + sv.nodes
        // Commutative across map entries, asymmetric between key and value
        sum = sum + sk.checksum * 131UL + sv.checksum
        i = i + 1
      }
      WalkStats::{ nodes: nodes, checksum: sum }
    }
  }
}

///|
fn run_decode(world : World, path : String, rounds : Int) -> Int {
  let data = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read corpus")
      return 1
    }
  }
  let opts = msgpack::DecodeOptions::default()
  let mut total_nodes : Int64 = 0L
  let mut total_checksum : UInt64 = 0UL
  let mut r = 0
  while r < rounds {
    let val_dec = match msgpack::decode(data, opts) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "decode error: " + msgpack::error_message(e))
        return 2
      }
    }
    let st = walk_value(val_dec)
    total_nodes = total_nodes + st.nodes
    total_checksum = total_checksum + st.checksum
    r = r + 1
  }
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "bytes=" + data.length().to_string())
  io_println(world, "nodes=" + total_nodes.to_string())
  io_println(world, "checksum=" + total_checksum.to_string())
  0
}

///|
fn run_encode_rpc(world : World) -> Int {
  let ops = 50000
  let regions = ["ap-northeast-1", "us-east-1", "eu-west-1", "us-west-2"]
  let svcs = [
    "edge-gw-0", "edge-gw-1", "edge-gw-2", "edge-gw-3",
    "edge-gw-4", "edge-gw-5", "edge-gw-6", "edge-gw-7",
    "edge-gw-8", "edge-gw-9", "edge-gw-10", "edge-gw-11",
    "edge-gw-12", "edge-gw-13", "edge-gw-14", "edge-gw-15",
  ]
  let tags = msgpack::MsgpackValue::Array([
    msgpack::MsgpackValue::Str("prod"),
    msgpack::MsgpackValue::Str("telemetry"),
    msgpack::MsgpackValue::Str("v2"),
    msgpack::MsgpackValue::Str("grpc"),
  ])
  let payload = Bytes::new(24)
  let mut p = 0
  while p < 24 {
    payload[p] = ((p * 13 + 5) & 0xFF).to_byte()
    p = p + 1
  }
  let opts = msgpack::EncodeOptions::default()
  let mut total_bytes : Int64 = 0L
  let mut checksum : UInt64 = 0UL
  let mut i = 0
  while i < ops {
    let i64 = i.to_int64()
    let meta = msgpack::MsgpackValue::Map([
      (msgpack::MsgpackValue::Str("err"), msgpack::MsgpackValue::Nil),
      (msgpack::MsgpackValue::Str("region"), msgpack::MsgpackValue::Str(regions[i & 3])),
      (msgpack::MsgpackValue::Str("retries"), msgpack::MsgpackValue::UInt((i & 3).to_int64().to_uint64())),
    ])
    let rec = msgpack::MsgpackValue::Map([
      (msgpack::MsgpackValue::Str("delta"), msgpack::MsgpackValue::Int(-(i64 * 17L + 1L))),
      (msgpack::MsgpackValue::Str("id"), msgpack::MsgpackValue::UInt((1000000L + i64).to_uint64())),
      (msgpack::MsgpackValue::Str("latency_ms"), msgpack::MsgpackValue::Float64(1.25 + (i % 97).to_double() * 0.25)),
      (msgpack::MsgpackValue::Str("meta"), meta),
      (msgpack::MsgpackValue::Str("ok"), msgpack::MsgpackValue::Bool((i % 5) != 0)),
      (msgpack::MsgpackValue::Str("payload"), msgpack::MsgpackValue::Bin(payload)),
      (msgpack::MsgpackValue::Str("svc"), msgpack::MsgpackValue::Str(svcs[i & 15])),
      (msgpack::MsgpackValue::Str("tags"), tags),
    ])
    let enc = match msgpack::encode(rec, opts) {
      Ok(b) => b
      Err(e) => {
        io_println(world, "encode error: " + msgpack::error_message(e))
        return 2
      }
    }
    let n = enc.length()
    total_bytes = total_bytes + n.to_int64()
    checksum = checksum + n.to_int64().to_uint64()
    checksum = checksum + enc[0].to_int().to_int64().to_uint64()
    checksum = checksum + enc[n / 2].to_int().to_int64().to_uint64()
    checksum = checksum + enc[n - 1].to_int().to_int64().to_uint64()
    i = i + 1
  }
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "total_bytes=" + total_bytes.to_string())
  io_println(world, "checksum=" + checksum.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: pion_bench <decode-rpc|encode-rpc|decode-large> [path]")
    return 1
  }
  let cmd = args[1]
  if cmd == "decode-rpc" {
    if args.length() < 3 {
      return 1
    }
    run_decode(world, args[2], 40)
  } else if cmd == "encode-rpc" {
    run_encode_rpc(world)
  } else if cmd == "decode-large" {
    if args.length() < 3 {
      return 1
    }
    run_decode(world, args[2], 4)
  } else {
    io_println(world, "unknown cmd: " + cmd)
    1
  }
}
