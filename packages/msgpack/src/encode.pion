///| High-performance pure Pion MessagePack encoder:
///  two-pass exact pre-allocation, canonical shortest encodings, zero intermediate copies,
///  and hybrid recursive/iterative stack-safe traversal (0 SIGSEGV at 100k+ depth).

///|
let encode_rec_limit : Int = 64

///|
struct Encoder {
  out : Bytes
  mut pos : Int
  compact_floats : Bool
}

///|
fn uint_encoded_size(u : UInt64) -> Int {
  if u <= 0x7FUL {
    1
  } else if u <= 0xFFUL {
    2
  } else if u <= 0xFFFFUL {
    3
  } else if u <= 0xFFFFFFFFUL {
    5
  } else {
    9
  }
}

///|
fn int_encoded_size(v : Int64) -> Int {
  if v >= 0L {
    uint_encoded_size(v.to_uint64())
  } else if v >= -32L {
    1
  } else if v >= -128L {
    2
  } else if v >= -32768L {
    3
  } else if v >= -2147483648L {
    5
  } else {
    9
  }
}

///|
fn str_encoded_size(n : Int) -> Int {
  if n <= 31 {
    1 + n
  } else if n <= 0xFF {
    2 + n
  } else if n <= 0xFFFF {
    3 + n
  } else {
    5 + n
  }
}

///|
fn bin_encoded_size(n : Int) -> Int {
  if n <= 0xFF {
    2 + n
  } else if n <= 0xFFFF {
    3 + n
  } else {
    5 + n
  }
}

///|
fn container_head_size(n : Int) -> Int {
  if n <= 15 {
    1
  } else if n <= 0xFFFF {
    3
  } else {
    5
  }
}

///|
fn ext_encoded_size(n : Int) -> Int {
  if n == 1 || n == 2 || n == 4 || n == 8 || n == 16 {
    2 + n
  } else if n <= 0xFF {
    3 + n
  } else if n <= 0xFFFF {
    4 + n
  } else {
    6 + n
  }
}

///|
fn timestamp_encoded_size(sec : Int64, nsec : Int) -> Int {
  if sec >= 0L && (sec >> 34) == 0L {
    if nsec == 0 && (sec >> 32) == 0L {
      6
    } else {
      10
    }
  } else {
    15
  }
}

///|
fn float64_encoded_size(d : Double, compact : Bool) -> Int {
  if compact {
    match double_to_float32_exact(d) {
      Some(_) => return 5
      None => ()
    }
  }
  9
}

///| Iterative size calculation & validation (stack-safe for arbitrary depth).
fn encoded_size_iter(root : MsgpackValue, compact_floats : Bool) -> Result[Int, MsgpackError] {
  let stack : Array[MsgpackValue] = [root]
  let mut total = 0
  while stack.length() > 0 {
    let cur = match stack.pop() {
      Some(v) => v
      None => break
    }
    match cur {
      Nil => total = total + 1
      Bool(_) => total = total + 1
      UInt(u) => total = total + uint_encoded_size(u)
      Int(v) => total = total + int_encoded_size(v)
      Float32(_) => total = total + 5
      Float64(d) => total = total + float64_encoded_size(d, compact_floats)
      Str(s) => total = total + str_encoded_size(s.length())
      Bin(b) => total = total + bin_encoded_size(b.length())
      Ext(tag, data) => {
        if tag < -128 || tag > 127 {
          return Result::Err(MsgpackError::InvalidExtType(tag))
        }
        total = total + ext_encoded_size(data.length())
      }
      Timestamp(sec, nsec) => {
        if nsec < 0 || nsec > 999999999 {
          return Result::Err(MsgpackError::InvalidTimestamp(-1))
        }
        total = total + timestamp_encoded_size(sec, nsec)
      }
      Array(items) => {
        let n = items.length()
        total = total + container_head_size(n)
        let mut i = n - 1
        while i >= 0 {
          stack.push(items[i])
          i = i - 1
        }
      }
      Map(pairs) => {
        let n = pairs.length()
        total = total + container_head_size(n)
        let mut i = n - 1
        while i >= 0 {
          let (k, v) = pairs[i]
          stack.push(v)
          stack.push(k)
          i = i - 1
        }
      }
    }
  }
  Result::Ok(total)
}

///| Fast recursive size calculation with iterative fallback beyond `encode_rec_limit`.
fn encoded_size(
  value : MsgpackValue,
  compact_floats : Bool,
  depth : Int,
) -> Result[Int, MsgpackError] {
  if depth > encode_rec_limit {
    return encoded_size_iter(value, compact_floats)
  }
  match value {
    Nil => Result::Ok(1)
    Bool(_) => Result::Ok(1)
    UInt(u) => Result::Ok(uint_encoded_size(u))
    Int(v) => Result::Ok(int_encoded_size(v))
    Float32(_) => Result::Ok(5)
    Float64(d) => Result::Ok(float64_encoded_size(d, compact_floats))
    Str(s) => Result::Ok(str_encoded_size(s.length()))
    Bin(b) => Result::Ok(bin_encoded_size(b.length()))
    Ext(tag, data) =>
    if tag < -128 || tag > 127 {
      Result::Err(MsgpackError::InvalidExtType(tag))
    } else {
      Result::Ok(ext_encoded_size(data.length()))
    }
    Timestamp(sec, nsec) =>
    if nsec < 0 || nsec > 999999999 {
      Result::Err(MsgpackError::InvalidTimestamp(-1))
    } else {
      Result::Ok(timestamp_encoded_size(sec, nsec))
    }
    Array(items) => {
      let n = items.length()
      let mut total = container_head_size(n)
      let nd = depth + 1
      let mut i = 0
      while i < n {
        match encoded_size(items[i], compact_floats, nd) {
          Ok(s) => total = total + s
          Err(e) => return Result::Err(e)
        }
        i = i + 1
      }
      Result::Ok(total)
    }
    Map(pairs) => {
      let n = pairs.length()
      let mut total = container_head_size(n)
      let nd = depth + 1
      let mut i = 0
      while i < n {
        let (k, v) = pairs[i]
        match encoded_size(k, compact_floats, nd) {
          Ok(sk) => total = total + sk
          Err(e) => return Result::Err(e)
        }
        match encoded_size(v, compact_floats, nd) {
          Ok(sv) => total = total + sv
          Err(e) => return Result::Err(e)
        }
        i = i + 1
      }
      Result::Ok(total)
    }
  }
}

///|
fn write_uint(enc : Encoder, u : UInt64) -> Unit {
  let out = enc.out
  let p = enc.pos
  if u <= 0x7FUL {
    out[p] = u.to_int().to_byte()
    enc.pos = p + 1
  } else if u <= 0xFFUL {
    out[p] = (0xCC).to_byte()
    out[p + 1] = u.to_int().to_byte()
    enc.pos = p + 2
  } else if u <= 0xFFFFUL {
    out[p] = (0xCD).to_byte()
    out[p + 1] = ((u >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 2] = (u & 0xFFUL).to_int().to_byte()
    enc.pos = p + 3
  } else if u <= 0xFFFFFFFFUL {
    out[p] = (0xCE).to_byte()
    out[p + 1] = ((u >> 24) & 0xFFUL).to_int().to_byte()
    out[p + 2] = ((u >> 16) & 0xFFUL).to_int().to_byte()
    out[p + 3] = ((u >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 4] = (u & 0xFFUL).to_int().to_byte()
    enc.pos = p + 5
  } else {
    out[p] = (0xCF).to_byte()
    out[p + 1] = ((u >> 56) & 0xFFUL).to_int().to_byte()
    out[p + 2] = ((u >> 48) & 0xFFUL).to_int().to_byte()
    out[p + 3] = ((u >> 40) & 0xFFUL).to_int().to_byte()
    out[p + 4] = ((u >> 32) & 0xFFUL).to_int().to_byte()
    out[p + 5] = ((u >> 24) & 0xFFUL).to_int().to_byte()
    out[p + 6] = ((u >> 16) & 0xFFUL).to_int().to_byte()
    out[p + 7] = ((u >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 8] = (u & 0xFFUL).to_int().to_byte()
    enc.pos = p + 9
  }
}

///|
fn write_int(enc : Encoder, v : Int64) -> Unit {
  if v >= 0L {
    write_uint(enc, v.to_uint64())
    return
  }
  let out = enc.out
  let p = enc.pos
  if v >= -32L {
    out[p] = (v & 0xFFL).to_int().to_byte()
    enc.pos = p + 1
  } else if v >= -128L {
    out[p] = (0xD0).to_byte()
    out[p + 1] = (v & 0xFFL).to_int().to_byte()
    enc.pos = p + 2
  } else if v >= -32768L {
    out[p] = (0xD1).to_byte()
    out[p + 1] = ((v >> 8) & 0xFFL).to_int().to_byte()
    out[p + 2] = (v & 0xFFL).to_int().to_byte()
    enc.pos = p + 3
  } else if v >= -2147483648L {
    out[p] = (0xD2).to_byte()
    out[p + 1] = ((v >> 24) & 0xFFL).to_int().to_byte()
    out[p + 2] = ((v >> 16) & 0xFFL).to_int().to_byte()
    out[p + 3] = ((v >> 8) & 0xFFL).to_int().to_byte()
    out[p + 4] = (v & 0xFFL).to_int().to_byte()
    enc.pos = p + 5
  } else {
    out[p] = (0xD3).to_byte()
    out[p + 1] = ((v >> 56) & 0xFFL).to_int().to_byte()
    out[p + 2] = ((v >> 48) & 0xFFL).to_int().to_byte()
    out[p + 3] = ((v >> 40) & 0xFFL).to_int().to_byte()
    out[p + 4] = ((v >> 32) & 0xFFL).to_int().to_byte()
    out[p + 5] = ((v >> 24) & 0xFFL).to_int().to_byte()
    out[p + 6] = ((v >> 16) & 0xFFL).to_int().to_byte()
    out[p + 7] = ((v >> 8) & 0xFFL).to_int().to_byte()
    out[p + 8] = (v & 0xFFL).to_int().to_byte()
    enc.pos = p + 9
  }
}

///|
fn write_float32_bits(enc : Encoder, f32 : Int64) -> Unit {
  let out = enc.out
  let p = enc.pos
  out[p] = (0xCA).to_byte()
  out[p + 1] = ((f32 >> 24) & 0xFFL).to_int().to_byte()
  out[p + 2] = ((f32 >> 16) & 0xFFL).to_int().to_byte()
  out[p + 3] = ((f32 >> 8) & 0xFFL).to_int().to_byte()
  out[p + 4] = (f32 & 0xFFL).to_int().to_byte()
  enc.pos = p + 5
}

///|
fn write_float64(enc : Encoder, d : Double) -> Unit {
  if enc.compact_floats {
    match double_to_float32_exact(d) {
      Some(f32) => {
        write_float32_bits(enc, f32)
        return
      }
      None => ()
    }
  }
  let bits = d.to_bits()
  let out = enc.out
  let p = enc.pos
  out[p] = (0xCB).to_byte()
  out[p + 1] = ((bits >> 56) & 0xFFL).to_int().to_byte()
  out[p + 2] = ((bits >> 48) & 0xFFL).to_int().to_byte()
  out[p + 3] = ((bits >> 40) & 0xFFL).to_int().to_byte()
  out[p + 4] = ((bits >> 32) & 0xFFL).to_int().to_byte()
  out[p + 5] = ((bits >> 24) & 0xFFL).to_int().to_byte()
  out[p + 6] = ((bits >> 16) & 0xFFL).to_int().to_byte()
  out[p + 7] = ((bits >> 8) & 0xFFL).to_int().to_byte()
  out[p + 8] = (bits & 0xFFL).to_int().to_byte()
  enc.pos = p + 9
}

///|
fn write_str(enc : Encoder, s : String) -> Unit {
  let out = enc.out
  let n = s.length()
  let mut p = enc.pos
  if n <= 31 {
    out[p] = (0xA0 | n).to_byte()
    p = p + 1
  } else if n <= 0xFF {
    out[p] = (0xD9).to_byte()
    out[p + 1] = n.to_byte()
    p = p + 2
  } else if n <= 0xFFFF {
    out[p] = (0xDA).to_byte()
    out[p + 1] = ((n >> 8) & 0xFF).to_byte()
    out[p + 2] = (n & 0xFF).to_byte()
    p = p + 3
  } else {
    let u = n.to_int64().to_uint64()
    out[p] = (0xDB).to_byte()
    out[p + 1] = ((u >> 24) & 0xFFUL).to_int().to_byte()
    out[p + 2] = ((u >> 16) & 0xFFUL).to_int().to_byte()
    out[p + 3] = ((u >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 4] = (u & 0xFFUL).to_int().to_byte()
    p = p + 5
  }
  let mut i = 0
  while i < n {
    out[p + i] = s.code_unit_at(i).to_byte()
    i = i + 1
  }
  enc.pos = p + n
}

///|
fn write_bin(enc : Encoder, b : Bytes) -> Unit {
  let out = enc.out
  let n = b.length()
  let mut p = enc.pos
  if n <= 0xFF {
    out[p] = (0xC4).to_byte()
    out[p + 1] = n.to_byte()
    p = p + 2
  } else if n <= 0xFFFF {
    out[p] = (0xC5).to_byte()
    out[p + 1] = ((n >> 8) & 0xFF).to_byte()
    out[p + 2] = (n & 0xFF).to_byte()
    p = p + 3
  } else {
    let u = n.to_int64().to_uint64()
    out[p] = (0xC6).to_byte()
    out[p + 1] = ((u >> 24) & 0xFFUL).to_int().to_byte()
    out[p + 2] = ((u >> 16) & 0xFFUL).to_int().to_byte()
    out[p + 3] = ((u >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 4] = (u & 0xFFUL).to_int().to_byte()
    p = p + 5
  }
  let mut i = 0
  while i < n {
    out[p + i] = b[i]
    i = i + 1
  }
  enc.pos = p + n
}

///|
fn write_array_head(enc : Encoder, n : Int) -> Unit {
  let out = enc.out
  let p = enc.pos
  if n <= 15 {
    out[p] = (0x90 | n).to_byte()
    enc.pos = p + 1
  } else if n <= 0xFFFF {
    out[p] = (0xDC).to_byte()
    out[p + 1] = ((n >> 8) & 0xFF).to_byte()
    out[p + 2] = (n & 0xFF).to_byte()
    enc.pos = p + 3
  } else {
    let u = n.to_int64().to_uint64()
    out[p] = (0xDD).to_byte()
    out[p + 1] = ((u >> 24) & 0xFFUL).to_int().to_byte()
    out[p + 2] = ((u >> 16) & 0xFFUL).to_int().to_byte()
    out[p + 3] = ((u >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 4] = (u & 0xFFUL).to_int().to_byte()
    enc.pos = p + 5
  }
}

///|
fn write_map_head(enc : Encoder, n : Int) -> Unit {
  let out = enc.out
  let p = enc.pos
  if n <= 15 {
    out[p] = (0x80 | n).to_byte()
    enc.pos = p + 1
  } else if n <= 0xFFFF {
    out[p] = (0xDE).to_byte()
    out[p + 1] = ((n >> 8) & 0xFF).to_byte()
    out[p + 2] = (n & 0xFF).to_byte()
    enc.pos = p + 3
  } else {
    let u = n.to_int64().to_uint64()
    out[p] = (0xDF).to_byte()
    out[p + 1] = ((u >> 24) & 0xFFUL).to_int().to_byte()
    out[p + 2] = ((u >> 16) & 0xFFUL).to_int().to_byte()
    out[p + 3] = ((u >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 4] = (u & 0xFFUL).to_int().to_byte()
    enc.pos = p + 5
  }
}

///|
fn write_ext(enc : Encoder, tag : Int, data : Bytes) -> Unit {
  let out = enc.out
  let n = data.length()
  let tag_b = (tag & 0xFF).to_byte()
  let mut p = enc.pos
  if n == 1 {
    out[p] = (0xD4).to_byte()
    out[p + 1] = tag_b
    p = p + 2
  } else if n == 2 {
    out[p] = (0xD5).to_byte()
    out[p + 1] = tag_b
    p = p + 2
  } else if n == 4 {
    out[p] = (0xD6).to_byte()
    out[p + 1] = tag_b
    p = p + 2
  } else if n == 8 {
    out[p] = (0xD7).to_byte()
    out[p + 1] = tag_b
    p = p + 2
  } else if n == 16 {
    out[p] = (0xD8).to_byte()
    out[p + 1] = tag_b
    p = p + 2
  } else if n <= 0xFF {
    out[p] = (0xC7).to_byte()
    out[p + 1] = n.to_byte()
    out[p + 2] = tag_b
    p = p + 3
  } else if n <= 0xFFFF {
    out[p] = (0xC8).to_byte()
    out[p + 1] = ((n >> 8) & 0xFF).to_byte()
    out[p + 2] = (n & 0xFF).to_byte()
    out[p + 3] = tag_b
    p = p + 4
  } else {
    let u = n.to_int64().to_uint64()
    out[p] = (0xC9).to_byte()
    out[p + 1] = ((u >> 24) & 0xFFUL).to_int().to_byte()
    out[p + 2] = ((u >> 16) & 0xFFUL).to_int().to_byte()
    out[p + 3] = ((u >> 8) & 0xFFUL).to_int().to_byte()
    out[p + 4] = (u & 0xFFUL).to_int().to_byte()
    out[p + 5] = tag_b
    p = p + 6
  }
  let mut i = 0
  while i < n {
    out[p + i] = data[i]
    i = i + 1
  }
  enc.pos = p + n
}

///|
fn write_timestamp(enc : Encoder, sec : Int64, nsec : Int) -> Unit {
  let out = enc.out
  let p = enc.pos
  if sec >= 0L && (sec >> 34) == 0L {
    if nsec == 0 && (sec >> 32) == 0L {
      // timestamp 32: fixext4 type -1
      out[p] = (0xD6).to_byte()
      out[p + 1] = (0xFF).to_byte()
      out[p + 2] = ((sec >> 24) & 0xFFL).to_int().to_byte()
      out[p + 3] = ((sec >> 16) & 0xFFL).to_int().to_byte()
      out[p + 4] = ((sec >> 8) & 0xFFL).to_int().to_byte()
      out[p + 5] = (sec & 0xFFL).to_int().to_byte()
      enc.pos = p + 6
    } else {
      // timestamp 64: fixext8 type -1
      let data64 : UInt64 = (nsec.to_int64().to_uint64() << 34) | sec.to_uint64()
      out[p] = (0xD7).to_byte()
      out[p + 1] = (0xFF).to_byte()
      out[p + 2] = ((data64 >> 56) & 0xFFUL).to_int().to_byte()
      out[p + 3] = ((data64 >> 48) & 0xFFUL).to_int().to_byte()
      out[p + 4] = ((data64 >> 40) & 0xFFUL).to_int().to_byte()
      out[p + 5] = ((data64 >> 32) & 0xFFUL).to_int().to_byte()
      out[p + 6] = ((data64 >> 24) & 0xFFUL).to_int().to_byte()
      out[p + 7] = ((data64 >> 16) & 0xFFUL).to_int().to_byte()
      out[p + 8] = ((data64 >> 8) & 0xFFUL).to_int().to_byte()
      out[p + 9] = (data64 & 0xFFUL).to_int().to_byte()
      enc.pos = p + 10
    }
  } else {
    // timestamp 96: ext8 len=12 type=-1
    let ns = nsec.to_int64()
    out[p] = (0xC7).to_byte()
    out[p + 1] = (12).to_byte()
    out[p + 2] = (0xFF).to_byte()
    out[p + 3] = ((ns >> 24) & 0xFFL).to_int().to_byte()
    out[p + 4] = ((ns >> 16) & 0xFFL).to_int().to_byte()
    out[p + 5] = ((ns >> 8) & 0xFFL).to_int().to_byte()
    out[p + 6] = (ns & 0xFFL).to_int().to_byte()
    out[p + 7] = ((sec >> 56) & 0xFFL).to_int().to_byte()
    out[p + 8] = ((sec >> 48) & 0xFFL).to_int().to_byte()
    out[p + 9] = ((sec >> 40) & 0xFFL).to_int().to_byte()
    out[p + 10] = ((sec >> 32) & 0xFFL).to_int().to_byte()
    out[p + 11] = ((sec >> 24) & 0xFFL).to_int().to_byte()
    out[p + 12] = ((sec >> 16) & 0xFFL).to_int().to_byte()
    out[p + 13] = ((sec >> 8) & 0xFFL).to_int().to_byte()
    out[p + 14] = (sec & 0xFFL).to_int().to_byte()
    enc.pos = p + 15
  }
}

///| Iterative stack-safe encoder for deep trees.
fn encode_into_iter(enc : Encoder, root : MsgpackValue) -> Unit {
  let stack : Array[MsgpackValue] = [root]
  while stack.length() > 0 {
    let cur = match stack.pop() {
      Some(v) => v
      None => break
    }
    match cur {
      Nil => {
        let p = enc.pos
        enc.out[p] = (0xC0).to_byte()
        enc.pos = p + 1
      }
      Bool(b) => {
        let p = enc.pos
        enc.out[p] = (if b { 0xC3 } else { 0xC2 }).to_byte()
        enc.pos = p + 1
      }
      UInt(u) => write_uint(enc, u)
      Int(v) => write_int(enc, v)
      Float32(d) => write_float32_bits(enc, double_to_float32_bits(d))
      Float64(d) => write_float64(enc, d)
      Str(s) => write_str(enc, s)
      Bin(b) => write_bin(enc, b)
      Ext(tag, data) => write_ext(enc, tag, data)
      Timestamp(sec, nsec) => write_timestamp(enc, sec, nsec)
      Array(items) => {
        let n = items.length()
        write_array_head(enc, n)
        let mut i = n - 1
        while i >= 0 {
          stack.push(items[i])
          i = i - 1
        }
      }
      Map(pairs) => {
        let n = pairs.length()
        write_map_head(enc, n)
        let mut i = n - 1
        while i >= 0 {
          let (k, v) = pairs[i]
          stack.push(v)
          stack.push(k)
          i = i - 1
        }
      }
    }
  }
}

///| Fast recursive encoder with iterative fallback beyond `encode_rec_limit`.
fn encode_into(enc : Encoder, value : MsgpackValue, depth : Int) -> Unit {
  if depth > encode_rec_limit {
    encode_into_iter(enc, value)
    return
  }
  match value {
    Nil => {
      let p = enc.pos
      enc.out[p] = (0xC0).to_byte()
      enc.pos = p + 1
    }
    Bool(b) => {
      let p = enc.pos
      enc.out[p] = (if b { 0xC3 } else { 0xC2 }).to_byte()
      enc.pos = p + 1
    }
    UInt(u) => write_uint(enc, u)
    Int(v) => write_int(enc, v)
    Float32(d) => write_float32_bits(enc, double_to_float32_bits(d))
    Float64(d) => write_float64(enc, d)
    Str(s) => write_str(enc, s)
    Bin(b) => write_bin(enc, b)
    Ext(tag, data) => write_ext(enc, tag, data)
    Timestamp(sec, nsec) => write_timestamp(enc, sec, nsec)
    Array(items) => {
      let n = items.length()
      write_array_head(enc, n)
      let nd = depth + 1
      let mut i = 0
      while i < n {
        encode_into(enc, items[i], nd)
        i = i + 1
      }
    }
    Map(pairs) => {
      let n = pairs.length()
      write_map_head(enc, n)
      let nd = depth + 1
      let mut i = 0
      while i < n {
        let (k, v) = pairs[i]
        encode_into(enc, k, nd)
        encode_into(enc, v, nd)
        i = i + 1
      }
    }
  }
}

///| Encode a `MsgpackValue` to canonical shortest MessagePack bytes.
pub fn encode(value : MsgpackValue, opts : EncodeOptions) -> Result[Bytes, MsgpackError] {
  let total = match encoded_size(value, opts.compact_floats, 0) {
    Ok(n) => n
    Err(e) => return Result::Err(e)
  }
  let out = Bytes::new(total)
  let enc = Encoder::{ out: out, pos: 0, compact_floats: opts.compact_floats }
  encode_into(enc, value, 0)
  Result::Ok(out)
}

///| Encode a `MsgpackValue` using default options.
pub fn encode_default(value : MsgpackValue) -> Result[Bytes, MsgpackError] {
  encode(value, EncodeOptions::default())
}
