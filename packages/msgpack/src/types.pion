///| Core MessagePack data model, options, and error types (MessagePack spec + Timestamp ext -1).

///|
pub enum MsgpackValue {
  Nil
  Bool(Bool)
  Int(Int64)
  UInt(UInt64)
  Float32(Double)
  Float64(Double)
  Str(String)
  Bin(Bytes)
  Array(Array[MsgpackValue])
  Map(Array[(MsgpackValue, MsgpackValue)])
  Ext(Int, Bytes)
  Timestamp(Int64, Int)
}

///|
pub enum MsgpackError {
  UnexpectedEof(Int)
  TrailingBytes(Int)
  InvalidMarker(Int, Int)
  InvalidUtf8(Int)
  InvalidTimestamp(Int)
  InvalidExtType(Int)
  MaxDepthExceeded(Int)
  MaxItemsExceeded(Int)
  MaxBytesExceeded(Int)
  DuplicateMapKey(Int)
  NonCanonicalEncoding(Int)
}

///|
pub fn error_message(err : MsgpackError) -> String {
  match err {
    UnexpectedEof(pos) => "msgpack: unexpected EOF at offset " + pos.to_string()
    TrailingBytes(pos) => "msgpack: trailing bytes at offset " + pos.to_string()
    InvalidMarker(marker, pos) =>
    "msgpack: invalid marker " + marker.to_string() + " at offset " + pos.to_string()
    InvalidUtf8(pos) => "msgpack: invalid UTF-8 string at offset " + pos.to_string()
    InvalidTimestamp(pos) => "msgpack: invalid timestamp at offset " + pos.to_string()
    InvalidExtType(tag) => "msgpack: invalid ext type " + tag.to_string()
    MaxDepthExceeded(limit) => "msgpack: exceeded max nesting depth " + limit.to_string()
    MaxItemsExceeded(limit) => "msgpack: exceeded max items " + limit.to_string()
    MaxBytesExceeded(limit) => "msgpack: exceeded max bytes " + limit.to_string()
    DuplicateMapKey(pos) => "msgpack: duplicate map key at offset " + pos.to_string()
    NonCanonicalEncoding(pos) =>
    "msgpack: non-canonical encoding at offset " + pos.to_string()
  }
}

///|
pub val struct DecodeOptions {
  pub max_depth : Int
  pub max_items : Int
  pub max_bytes : Int
  pub reject_duplicate_keys : Bool
  pub require_canonical : Bool
  pub decode_timestamp : Bool
  pub allow_trailing_bytes : Bool
}

///|
pub fn DecodeOptions::default() -> DecodeOptions {
  DecodeOptions::{
    max_depth: 512,
    max_items: 1048576,
    max_bytes: 67108864,
    reject_duplicate_keys: false,
    require_canonical: false,
    decode_timestamp: true,
    allow_trailing_bytes: false,
  }
}

///|
pub fn DecodeOptions::strict() -> DecodeOptions {
  DecodeOptions::{
    max_depth: 512,
    max_items: 1048576,
    max_bytes: 67108864,
    reject_duplicate_keys: true,
    require_canonical: true,
    decode_timestamp: true,
    allow_trailing_bytes: false,
  }
}

///|
pub val struct EncodeOptions {
  pub compact_floats : Bool
}

///|
pub fn EncodeOptions::default() -> EncodeOptions {
  EncodeOptions::{ compact_floats: false }
}

///|
pub fn EncodeOptions::compact() -> EncodeOptions {
  EncodeOptions::{ compact_floats: true }
}

///|
pub fn bytes_equal(a : Bytes, b : Bytes) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Iterative stack-safe structural equality for MsgpackValue.
///  Treats Int(v) with v >= 0 as equal to UInt(v.to_uint64()).
///  Preserves exact IEEE-754 bit patterns for Float32 and Float64 (-0.0 != +0.0, NaN bits preserved).
pub fn msgpack_equals(lhs : MsgpackValue, rhs : MsgpackValue) -> Bool {
  let left_stack : Array[MsgpackValue] = [lhs]
  let right_stack : Array[MsgpackValue] = [rhs]
  while left_stack.length() > 0 {
    let l = match left_stack.pop() {
      Some(v) => v
      None => break
    }
    let r = match right_stack.pop() {
      Some(v) => v
      None => return false
    }
    match (l, r) {
      (Nil, Nil) => ()
      (Bool(a), Bool(b)) => if a != b { return false }
      (Int(a), Int(b)) => if a != b { return false }
      (UInt(a), UInt(b)) => if a != b { return false }
      (Int(a), UInt(b)) => if a < 0L || a.to_uint64() != b { return false }
      (UInt(a), Int(b)) => if b < 0L || a != b.to_uint64() { return false }
      (Float32(a), Float32(b)) => if a.to_bits() != b.to_bits() { return false }
      (Float64(a), Float64(b)) => if a.to_bits() != b.to_bits() { return false }
      (Str(a), Str(b)) => if a != b { return false }
      (Bin(a), Bin(b)) => if !bytes_equal(a, b) { return false }
      (Ext(ta, da), Ext(tb, db)) => if ta != tb || !bytes_equal(da, db) { return false }
      (Timestamp(sa, na), Timestamp(sb, nb)) => if sa != sb || na != nb { return false }
      (Array(a), Array(b)) => {
        let n = a.length()
        if n != b.length() {
          return false
        }
        let mut i = n - 1
        while i >= 0 {
          left_stack.push(a[i])
          right_stack.push(b[i])
          i = i - 1
        }
      }
      (Map(a), Map(b)) => {
        let n = a.length()
        if n != b.length() {
          return false
        }
        let mut i = n - 1
        while i >= 0 {
          let (ka, va) = a[i]
          let (kb, vb) = b[i]
          left_stack.push(va)
          right_stack.push(vb)
          left_stack.push(ka)
          right_stack.push(kb)
          i = i - 1
        }
      }
      _ => return false
    }
  }
  true
}
