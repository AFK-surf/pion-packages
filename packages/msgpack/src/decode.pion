///| High-performance pure Pion MessagePack decoder:
///  - Full MessagePack spec (all 256 first-byte markers, rejecting reserved 0xC1)
///  - Standard Timestamp ext -1 (32/64/96-bit) with strict nanosecond validation (< 1e9)
///  - Strict RFC 3629 UTF-8 validation with ASCII fast path
///  - Pre-allocation OOM defense (rejects huge declared lengths before allocation)
///  - Hybrid recursive (depth <= 64) + explicit heap-stack iterative decoding (0 SIGSEGV at 100k+ depth)
///  - Optional O(n) open-addressing hash duplicate-key detection and canonical shortest validation

///|
let decode_rec_limit : Int = 64

///|
struct Decoder {
  data : Bytes
  mut data_str : String
  mut has_data_str : Bool
  cache_data_str : Bool
  len : Int
  mut pos : Int
  max_depth : Int
  max_items : Int
  max_bytes : Int
  mut items : Int
  reject_duplicate_keys : Bool
  require_canonical : Bool
  decode_timestamp : Bool
  mut has_err : Bool
  mut err : MsgpackError
}

///|
fn set_err(dec : Decoder, err : MsgpackError) -> Unit {
  if !dec.has_err {
    dec.has_err = true
    dec.err = err
  }
}

///|
fn extract_utf8_str(dec : Decoder, start : Int, n : Int) -> String {
  if n == 0 {
    return ""
  }
  // Only cache whole-buffer `data.to_string()` for full-buffer decodes (`decode` / `decode_all`) <= 2 MiB.
  // Streaming `decode_prefix` / `decode_prefix_at` disables whole-buffer caching to avoid O(N^2) copies.
  if dec.cache_data_str && dec.len <= 2097152 {
    if !dec.has_data_str {
      dec.data_str = dec.data.to_string()
      dec.has_data_str = true
    }
    dec.data_str.slice(start, start + n)
  } else {
    dec.data.slice(start, start + n).to_string()
  }
}

///| Strict RFC 3629 UTF-8 validator with ASCII fast loop.
fn is_valid_utf8_range(data : Bytes, start : Int, len : Int) -> Bool {
  let end = start + len
  let mut i = start
  while i < end {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
      while i < end && data[i].to_int() < 0x80 {
        i = i + 1
      }
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return false
      }
      if b0 == 0xF4 && b1 > 0x8F {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| 64-bit left rotation for SipHash-1-3.
fn rotl64(x : UInt64, b : Int) -> UInt64 {
  let r : Int = 64 - b
  (x << b) | (x >> r)
}

///| Streaming SipHash-1-3 state (used for composite Array/Map keys).
struct SipState {
  mut v0 : UInt64
  mut v1 : UInt64
  mut v2 : UInt64
  mut v3 : UInt64
}

///|
fn sip_state_init(k0 : UInt64, k1 : UInt64) -> SipState {
  SipState::{
    v0: k0 ^ 0x736F6D6570736575UL,
    v1: k1 ^ 0x646F72616E646F6DUL,
    v2: k0 ^ 0x6C7967656E657261UL,
    v3: k1 ^ 0x7465646279746573UL,
  }
}

///|
fn sip_round(st : SipState) -> Unit {
  let mut v0 = st.v0
  let mut v1 = st.v1
  let mut v2 = st.v2
  let mut v3 = st.v3
  v0 = v0 + v1
  v1 = rotl64(v1, 13) ^ v0
  v0 = rotl64(v0, 32)
  v2 = v2 + v3
  v3 = rotl64(v3, 16) ^ v2
  v0 = v0 + v3
  v3 = rotl64(v3, 21) ^ v0
  v2 = v2 + v1
  v1 = rotl64(v1, 17) ^ v2
  v2 = rotl64(v2, 32)
  st.v0 = v0
  st.v1 = v1
  st.v2 = v2
  st.v3 = v3
}

///|
fn sip_compress(st : SipState, m : UInt64) -> Unit {
  st.v3 = st.v3 ^ m
  sip_round(st)
  st.v0 = st.v0 ^ m
}

///|
fn sip_finish(st : SipState) -> UInt64 {
  st.v2 = st.v2 ^ 0xFFUL
  sip_round(st)
  sip_round(st)
  sip_round(st)
  st.v0 ^ st.v1 ^ st.v2 ^ st.v3
}

///| Zero-allocation SipHash-1-3 for two 64-bit words (tag + scalar payload).
fn siphash13_2w(k0 : UInt64, k1 : UInt64, w0 : UInt64, w1 : UInt64) -> UInt64 {
  let mut v0 = k0 ^ 0x736F6D6570736575UL
  let mut v1 = k1 ^ 0x646F72616E646F6DUL
  let mut v2 = k0 ^ 0x6C7967656E657261UL
  let mut v3 = k1 ^ 0x7465646279746573UL

  v3 = v3 ^ w0
  v0 = v0 + v1; v1 = rotl64(v1, 13) ^ v0; v0 = rotl64(v0, 32)
  v2 = v2 + v3; v3 = rotl64(v3, 16) ^ v2
  v0 = v0 + v3; v3 = rotl64(v3, 21) ^ v0
  v2 = v2 + v1; v1 = rotl64(v1, 17) ^ v2; v2 = rotl64(v2, 32)
  v0 = v0 ^ w0

  v3 = v3 ^ w1
  v0 = v0 + v1; v1 = rotl64(v1, 13) ^ v0; v0 = rotl64(v0, 32)
  v2 = v2 + v3; v3 = rotl64(v3, 16) ^ v2
  v0 = v0 + v3; v3 = rotl64(v3, 21) ^ v0
  v2 = v2 + v1; v1 = rotl64(v1, 17) ^ v2; v2 = rotl64(v2, 32)
  v0 = v0 ^ w1

  v2 = v2 ^ 0xFFUL
  let mut r = 0
  while r < 3 {
    v0 = v0 + v1; v1 = rotl64(v1, 13) ^ v0; v0 = rotl64(v0, 32)
    v2 = v2 + v3; v3 = rotl64(v3, 16) ^ v2
    v0 = v0 + v3; v3 = rotl64(v3, 21) ^ v0
    v2 = v2 + v1; v1 = rotl64(v1, 17) ^ v2; v2 = rotl64(v2, 32)
    r = r + 1
  }
  v0 ^ v1 ^ v2 ^ v3
}

///| Zero-allocation SipHash-1-3 for a UTF-8 `String` (8-byte word blocks).
fn siphash13_str(k0 : UInt64, k1 : UInt64, s : String) -> UInt64 {
  let mut v0 = k0 ^ 0x736F6D6570736575UL
  let mut v1 = k1 ^ 0x646F72616E646F6DUL
  let mut v2 = k0 ^ 0x6C7967656E657261UL
  let mut v3 = k1 ^ 0x7465646279746573UL

  // Domain tag for Str
  let tag = 0x7070707070707070UL
  v3 = v3 ^ tag
  v0 = v0 + v1; v1 = rotl64(v1, 13) ^ v0; v0 = rotl64(v0, 32)
  v2 = v2 + v3; v3 = rotl64(v3, 16) ^ v2
  v0 = v0 + v3; v3 = rotl64(v3, 21) ^ v0
  v2 = v2 + v1; v1 = rotl64(v1, 17) ^ v2; v2 = rotl64(v2, 32)
  v0 = v0 ^ tag

  let n = s.length()
  let mut i = 0
  let full_end = n - (n & 7)
  while i < full_end {
    let m = (s.code_unit_at(i).to_int64().to_uint64())
    | (s.code_unit_at(i + 1).to_int64().to_uint64() << 8)
    | (s.code_unit_at(i + 2).to_int64().to_uint64() << 16)
    | (s.code_unit_at(i + 3).to_int64().to_uint64() << 24)
    | (s.code_unit_at(i + 4).to_int64().to_uint64() << 32)
    | (s.code_unit_at(i + 5).to_int64().to_uint64() << 40)
    | (s.code_unit_at(i + 6).to_int64().to_uint64() << 48)
    | (s.code_unit_at(i + 7).to_int64().to_uint64() << 56)
    v3 = v3 ^ m
    v0 = v0 + v1; v1 = rotl64(v1, 13) ^ v0; v0 = rotl64(v0, 32)
    v2 = v2 + v3; v3 = rotl64(v3, 16) ^ v2
    v0 = v0 + v3; v3 = rotl64(v3, 21) ^ v0
    v2 = v2 + v1; v1 = rotl64(v1, 17) ^ v2; v2 = rotl64(v2, 32)
    v0 = v0 ^ m
    i = i + 8
  }
  let mut last = (n.to_int64().to_uint64() & 0xFFUL) << 56
  let mut shift = 0
  while i < n {
    last = last | (s.code_unit_at(i).to_int64().to_uint64() << shift)
    shift = shift + 8
    i = i + 1
  }
  v3 = v3 ^ last
  v0 = v0 + v1; v1 = rotl64(v1, 13) ^ v0; v0 = rotl64(v0, 32)
  v2 = v2 + v3; v3 = rotl64(v3, 16) ^ v2
  v0 = v0 + v3; v3 = rotl64(v3, 21) ^ v0
  v2 = v2 + v1; v1 = rotl64(v1, 17) ^ v2; v2 = rotl64(v2, 32)
  v0 = v0 ^ last

  v2 = v2 ^ 0xFFUL
  let mut r = 0
  while r < 3 {
    v0 = v0 + v1; v1 = rotl64(v1, 13) ^ v0; v0 = rotl64(v0, 32)
    v2 = v2 + v3; v3 = rotl64(v3, 16) ^ v2
    v0 = v0 + v3; v3 = rotl64(v3, 21) ^ v0
    v2 = v2 + v1; v1 = rotl64(v1, 17) ^ v2; v2 = rotl64(v2, 32)
    r = r + 1
  }
  v0 ^ v1 ^ v2 ^ v3
}

///| Zero-allocation SipHash-1-3 for `Bytes` with domain tag (Bin / Ext).
fn siphash13_bytes(k0 : UInt64, k1 : UInt64, tag : UInt64, b : Bytes) -> UInt64 {
  let mut v0 = k0 ^ 0x736F6D6570736575UL
  let mut v1 = k1 ^ 0x646F72616E646F6DUL
  let mut v2 = k0 ^ 0x6C7967656E657261UL
  let mut v3 = k1 ^ 0x7465646279746573UL

  v3 = v3 ^ tag
  v0 = v0 + v1; v1 = rotl64(v1, 13) ^ v0; v0 = rotl64(v0, 32)
  v2 = v2 + v3; v3 = rotl64(v3, 16) ^ v2
  v0 = v0 + v3; v3 = rotl64(v3, 21) ^ v0
  v2 = v2 + v1; v1 = rotl64(v1, 17) ^ v2; v2 = rotl64(v2, 32)
  v0 = v0 ^ tag

  let n = b.length()
  let mut i = 0
  let full_end = n - (n & 7)
  while i < full_end {
    let m = (b[i].to_int().to_int64().to_uint64())
    | (b[i + 1].to_int().to_int64().to_uint64() << 8)
    | (b[i + 2].to_int().to_int64().to_uint64() << 16)
    | (b[i + 3].to_int().to_int64().to_uint64() << 24)
    | (b[i + 4].to_int().to_int64().to_uint64() << 32)
    | (b[i + 5].to_int().to_int64().to_uint64() << 40)
    | (b[i + 6].to_int().to_int64().to_uint64() << 48)
    | (b[i + 7].to_int().to_int64().to_uint64() << 56)
    v3 = v3 ^ m
    v0 = v0 + v1; v1 = rotl64(v1, 13) ^ v0; v0 = rotl64(v0, 32)
    v2 = v2 + v3; v3 = rotl64(v3, 16) ^ v2
    v0 = v0 + v3; v3 = rotl64(v3, 21) ^ v0
    v2 = v2 + v1; v1 = rotl64(v1, 17) ^ v2; v2 = rotl64(v2, 32)
    v0 = v0 ^ m
    i = i + 8
  }
  let mut last = (n.to_int64().to_uint64() & 0xFFUL) << 56
  let mut shift = 0
  while i < n {
    last = last | (b[i].to_int().to_int64().to_uint64() << shift)
    shift = shift + 8
    i = i + 1
  }
  v3 = v3 ^ last
  v0 = v0 + v1; v1 = rotl64(v1, 13) ^ v0; v0 = rotl64(v0, 32)
  v2 = v2 + v3; v3 = rotl64(v3, 16) ^ v2
  v0 = v0 + v3; v3 = rotl64(v3, 21) ^ v0
  v2 = v2 + v1; v1 = rotl64(v1, 17) ^ v2; v2 = rotl64(v2, 32)
  v0 = v0 ^ last

  v2 = v2 ^ 0xFFUL
  let mut r = 0
  while r < 3 {
    v0 = v0 + v1; v1 = rotl64(v1, 13) ^ v0; v0 = rotl64(v0, 32)
    v2 = v2 + v3; v3 = rotl64(v3, 16) ^ v2
    v0 = v0 + v3; v3 = rotl64(v3, 21) ^ v0
    v2 = v2 + v1; v1 = rotl64(v1, 17) ^ v2; v2 = rotl64(v2, 32)
    r = r + 1
  }
  v0 ^ v1 ^ v2 ^ v3
}

///| Derive dynamic per-table 128-bit SipHash key from decoder state and buffer samples.
fn derive_hash_keys(dec : Decoder, initial_cap : Int) -> (UInt64, UInt64) {
  let len = dec.len
  let mut s0 = (len.to_int64().to_uint64() << 32) ^ dec.pos.to_int64().to_uint64() ^ 0x243F6A8885A308D3UL
  let mut s1 = (dec.items.to_int64().to_uint64() << 32) ^ initial_cap.to_int64().to_uint64() ^ 0x13198A2E03707344UL
  if len > 0 {
    let data = dec.data
    let p0 = data[0].to_int().to_int64().to_uint64()
    let p1 = data[len / 4].to_int().to_int64().to_uint64()
    let p2 = data[len / 2].to_int().to_int64().to_uint64()
    let p3 = data[(len * 3) / 4].to_int().to_int64().to_uint64()
    let p4 = data[len - 1].to_int().to_int64().to_uint64()
    let p5 = if dec.pos < len { data[dec.pos].to_int().to_int64().to_uint64() } else { 0UL }
    let sample = p0 | (p1 << 8) | (p2 << 16) | (p3 << 24) | (p4 << 32) | (p5 << 40)
    s0 = s0 ^ sample
    s1 = s1 ^ rotl64(sample, 29)
  }
  let k0 = siphash13_2w(0xA4093822299F31D0UL, 0x082EFA98EC4E6C89UL, s0, s1)
  let k1 = siphash13_2w(0x452821E638D01377UL, 0xBE5466CF34E90C6CUL, s1, k0)
  (k0, k1)
}

///| Iterative stack-safe keyed SipHash-1-3 structural hash consistent with `msgpack_equals`.
fn msgpack_key_hash(k0 : UInt64, k1 : UInt64, root : MsgpackValue) -> UInt64 {
  match root {
    Nil => siphash13_2w(k0, k1, 0x1010101010101010UL, 0UL)
    Bool(b) => siphash13_2w(k0, k1, 0x2020202020202020UL, if b { 1UL } else { 0UL })
    UInt(u) => siphash13_2w(k0, k1, 0x3030303030303030UL, u)
    Int(v) =>
    if v >= 0L {
      siphash13_2w(k0, k1, 0x3030303030303030UL, v.to_uint64())
    } else {
      siphash13_2w(k0, k1, 0x4040404040404040UL, v.to_uint64())
    }
    Float32(d) => siphash13_2w(k0, k1, 0x5050505050505050UL, d.to_bits().to_uint64())
    Float64(d) => siphash13_2w(k0, k1, 0x6060606060606060UL, d.to_bits().to_uint64())
    Str(s) => siphash13_str(k0, k1, s)
    Bin(b) => siphash13_bytes(k0, k1, 0x8080808080808080UL, b)
    Ext(tag, data) =>
    siphash13_bytes(k0, k1, 0x9090909090909090UL ^ tag.to_int64().to_uint64(), data)
    Timestamp(sec, nsec) =>
    siphash13_2w(k0, k1, 0xA0A0A0A0A0A0A0A0UL ^ nsec.to_int64().to_uint64(), sec.to_uint64())
    Array(_) | Map(_) => {
      let st = sip_state_init(k0, k1)
      let stack : Array[MsgpackValue] = [root]
      while stack.length() > 0 {
        let cur = match stack.pop() {
          Some(v) => v
          None => break
        }
        match cur {
          Array(items) => {
            let n = items.length()
            sip_compress(st, 0xC0C0C0C0C0C0C0C0UL ^ n.to_int64().to_uint64())
            let mut i = n - 1
            while i >= 0 {
              stack.push(items[i])
              i = i - 1
            }
          }
          Map(pairs) => {
            let n = pairs.length()
            sip_compress(st, 0xD0D0D0D0D0D0D0D0UL ^ n.to_int64().to_uint64())
            let mut i = n - 1
            while i >= 0 {
              let (k, v) = pairs[i]
              stack.push(v)
              stack.push(k)
              i = i - 1
            }
          }
          leaf => sip_compress(st, msgpack_key_hash(k0, k1, leaf))
        }
      }
      sip_finish(st)
    }
  }
}

///| Keyed SipHash-1-3 open-addressing hash set for O(n) HashDoS-resistant duplicate-key detection.
struct KeyHashSet {
  mut table : Array[Int]
  mut mask : Int
  mut count : Int
  mut k0 : UInt64
  mut k1 : UInt64
  hashes : Array[UInt64]
}

///|
fn make_key_hash_set(dec : Decoder, initial_cap : Int) -> KeyHashSet {
  let mut cap = 32
  while cap < initial_cap {
    cap = cap * 2
  }
  let table : Array[Int] = Array::with_capacity(cap)
  let mut i = 0
  while i < cap {
    table.push(-1)
    i = i + 1
  }
  let (k0, k1) = derive_hash_keys(dec, initial_cap)
  KeyHashSet::{ table: table, mask: cap - 1, count: 0, k0: k0, k1: k1, hashes: [] }
}

///|
fn key_hash_set_grow(set : KeyHashSet) -> Unit {
  let new_cap = (set.mask + 1) * 2
  let new_mask = new_cap - 1
  let new_table : Array[Int] = Array::with_capacity(new_cap)
  let mut i = 0
  while i < new_cap {
    new_table.push(-1)
    i = i + 1
  }
  let old_table = set.table
  let old_len = old_table.length()
  let hashes = set.hashes
  let mut j = 0
  while j < old_len {
    let idx = old_table[j]
    if idx >= 0 {
      let mut slot = (hashes[idx] & new_mask.to_int64().to_uint64()).to_int()
      while new_table[slot] >= 0 {
        slot = (slot + 1) & new_mask
      }
      new_table[slot] = idx
    }
    j = j + 1
  }
  set.table = new_table
  set.mask = new_mask
}

///| Insert key `k` at `pair_idx`. Returns `false` if duplicate exists.
fn key_hash_set_insert(
  set : KeyHashSet,
  pairs : Array[(MsgpackValue, MsgpackValue)],
  k : MsgpackValue,
  pair_idx : Int,
) -> Bool {
  if (set.count + 1) * 10 >= (set.mask + 1) * 7 {
    key_hash_set_grow(set)
  }
  let h = msgpack_key_hash(set.k0, set.k1, k)
  let mask = set.mask
  let table = set.table
  let hashes = set.hashes
  let mut slot = (h & mask.to_int64().to_uint64()).to_int()
  while true {
    let existing = table[slot]
    if existing < 0 {
      table[slot] = pair_idx
      hashes.push(h)
      set.count = set.count + 1
      return true
    }
    if hashes[existing] == h {
      let (pk, _) = pairs[existing]
      if msgpack_equals(pk, k) {
        return false
      }
    }
    slot = (slot + 1) & mask
  }
  true
}

///|
fn read_u16_be(data : Bytes, p : Int) -> Int {
  (data[p].to_int() << 8) | data[p + 1].to_int()
}

///|
fn read_u32_be(data : Bytes, p : Int) -> UInt64 {
  let b0 = data[p].to_int().to_int64().to_uint64()
  let b1 = data[p + 1].to_int().to_int64().to_uint64()
  let b2 = data[p + 2].to_int().to_int64().to_uint64()
  let b3 = data[p + 3].to_int().to_int64().to_uint64()
  (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

///|
fn read_u64_be(data : Bytes, p : Int) -> UInt64 {
  let b0 = data[p].to_int().to_int64().to_uint64()
  let b1 = data[p + 1].to_int().to_int64().to_uint64()
  let b2 = data[p + 2].to_int().to_int64().to_uint64()
  let b3 = data[p + 3].to_int().to_int64().to_uint64()
  let b4 = data[p + 4].to_int().to_int64().to_uint64()
  let b5 = data[p + 5].to_int().to_int64().to_uint64()
  let b6 = data[p + 6].to_int().to_int64().to_uint64()
  let b7 = data[p + 7].to_int().to_int64().to_uint64()
  (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7
}

///| Decode ext payload (handling Timestamp ext -1 when enabled).
fn decode_ext_payload(
  dec : Decoder,
  marker : Int,
  start_pos : Int,
  len_u64 : UInt64,
) -> MsgpackValue {
  let pos = dec.pos
  // Check remaining bytes BEFORE max_bytes/allocation to reject OOM bombs immediately.
  if pos >= dec.len {
    set_err(dec, MsgpackError::UnexpectedEof(pos))
    return MsgpackValue::Nil
  }
  let rem_after_type = (dec.len - pos - 1).to_int64().to_uint64()
  if len_u64 > rem_after_type {
    set_err(dec, MsgpackError::UnexpectedEof(pos))
    return MsgpackValue::Nil
  }
  let max_b = dec.max_bytes.to_int64().to_uint64()
  if len_u64 > max_b {
    set_err(dec, MsgpackError::MaxBytesExceeded(dec.max_bytes))
    return MsgpackValue::Nil
  }
  let len = len_u64.to_int()
  let raw_type = dec.data[pos].to_int()
  let ext_type = if raw_type >= 128 { raw_type - 256 } else { raw_type }
  let payload_pos = pos + 1
  dec.pos = payload_pos + len

  if dec.decode_timestamp && ext_type == -1 {
    if len == 4 {
      if dec.require_canonical && marker != 0xD6 {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      let sec = read_u32_be(dec.data, payload_pos).to_int64()
      return MsgpackValue::Timestamp(sec, 0)
    }
    if len == 8 {
      let data64 = read_u64_be(dec.data, payload_pos)
      let nsec_u64 = (data64 >> 34) & 0x3FFFFFFFUL
      if nsec_u64 > 999999999UL {
        set_err(dec, MsgpackError::InvalidTimestamp(start_pos))
        return MsgpackValue::Nil
      }
      let sec = (data64 & 0x3FFFFFFFFUL).to_int64()
      let nsec = nsec_u64.to_int()
      if dec.require_canonical && (marker != 0xD7 || (nsec == 0 && sec <= 0xFFFFFFFFL)) {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      return MsgpackValue::Timestamp(sec, nsec)
    }
    if len == 12 {
      let nsec_u64 = read_u32_be(dec.data, payload_pos)
      if nsec_u64 > 999999999UL {
        set_err(dec, MsgpackError::InvalidTimestamp(start_pos))
        return MsgpackValue::Nil
      }
      let sec = read_u64_be(dec.data, payload_pos + 4).to_int64()
      if dec.require_canonical && (marker != 0xC7 || (sec >= 0L && (sec >> 34) == 0L)) {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      return MsgpackValue::Timestamp(sec, nsec_u64.to_int())
    }
    set_err(dec, MsgpackError::InvalidTimestamp(start_pos))
    return MsgpackValue::Nil
  }

  // Canonical ext marker check for non-timestamp ext
  if dec.require_canonical {
    if marker == 0xC7 && (len == 1 || len == 2 || len == 4 || len == 8 || len == 16) {
      set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
      return MsgpackValue::Nil
    }
    if marker == 0xC8 && len <= 0xFF {
      set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
      return MsgpackValue::Nil
    }
    if marker == 0xC9 && len <= 0xFFFF {
      set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
      return MsgpackValue::Nil
    }
  }

  if len == 0 {
    MsgpackValue::Ext(ext_type, Bytes::new(0))
  } else {
    MsgpackValue::Ext(ext_type, dec.data.slice(payload_pos, payload_pos + len))
  }
}

///| Decode a validated string of `len_u64` bytes starting at `dec.pos`.
fn decode_str_payload(dec : Decoder, len_u64 : UInt64) -> MsgpackValue {
  let pos = dec.pos
  let rem = (dec.len - pos).to_int64().to_uint64()
  if len_u64 > rem {
    set_err(dec, MsgpackError::UnexpectedEof(pos))
    return MsgpackValue::Nil
  }
  let max_b = dec.max_bytes.to_int64().to_uint64()
  if len_u64 > max_b {
    set_err(dec, MsgpackError::MaxBytesExceeded(dec.max_bytes))
    return MsgpackValue::Nil
  }
  let n = len_u64.to_int()
  if n == 0 {
    return MsgpackValue::Str("")
  }
  if !is_valid_utf8_range(dec.data, pos, n) {
    set_err(dec, MsgpackError::InvalidUtf8(pos))
    return MsgpackValue::Nil
  }
  dec.pos = pos + n
  MsgpackValue::Str(extract_utf8_str(dec, pos, n))
}

///| Decode a binary byte slice of `len_u64` bytes starting at `dec.pos`.
fn decode_bin_payload(dec : Decoder, len_u64 : UInt64) -> MsgpackValue {
  let pos = dec.pos
  let rem = (dec.len - pos).to_int64().to_uint64()
  if len_u64 > rem {
    set_err(dec, MsgpackError::UnexpectedEof(pos))
    return MsgpackValue::Nil
  }
  let max_b = dec.max_bytes.to_int64().to_uint64()
  if len_u64 > max_b {
    set_err(dec, MsgpackError::MaxBytesExceeded(dec.max_bytes))
    return MsgpackValue::Nil
  }
  let n = len_u64.to_int()
  if n == 0 {
    return MsgpackValue::Bin(Bytes::new(0))
  }
  dec.pos = pos + n
  MsgpackValue::Bin(dec.data.slice(pos, pos + n))
}

///| Validate array count against remaining bytes and max_items BEFORE allocating.
fn validate_array_count(dec : Decoder, count_u64 : UInt64) -> Int {
  let rem = (dec.len - dec.pos).to_int64().to_uint64()
  if count_u64 > rem {
    set_err(dec, MsgpackError::UnexpectedEof(dec.pos))
    return -1
  }
  let avail_items = (dec.max_items - dec.items).to_int64().to_uint64()
  if count_u64 > avail_items {
    set_err(dec, MsgpackError::MaxItemsExceeded(dec.max_items))
    return -1
  }
  count_u64.to_int()
}

///| Validate map pair count against remaining bytes (2 bytes/pair min) and max_items BEFORE allocating.
fn validate_map_count(dec : Decoder, count_u64 : UInt64) -> Int {
  let rem = (dec.len - dec.pos).to_int64().to_uint64()
  if count_u64 > rem / 2UL {
    set_err(dec, MsgpackError::UnexpectedEof(dec.pos))
    return -1
  }
  let avail_items = (dec.max_items - dec.items).to_int64().to_uint64()
  if count_u64 > avail_items / 2UL {
    set_err(dec, MsgpackError::MaxItemsExceeded(dec.max_items))
    return -1
  }
  count_u64.to_int()
}

///|
struct IterArrFrame {
  items : Array[MsgpackValue]
  mut rem : Int
}

///|
struct IterMapFrame {
  pairs : Array[(MsgpackValue, MsgpackValue)]
  mut rem : Int
  mut has_key : Bool
  mut key : MsgpackValue
  mut key_pos : Int
  hset : Option[KeyHashSet]
}

///|
enum IterFrame {
  Arr(IterArrFrame)
  Map(IterMapFrame)
}

///| Explicit heap-stack iterative decoder for deep nesting (depth > decode_rec_limit).
///  Uses a single compact frame stack (avoiding parallel array allocations) and tracks exact key start offsets.
fn decode_iter(dec : Decoder, start_depth : Int) -> MsgpackValue {
  let frames : Array[IterFrame] = []

  while true {
    if dec.has_err {
      return MsgpackValue::Nil
    }
    let cur_depth = start_depth + frames.length()
    let start_pos = dec.pos
    if start_pos >= dec.len {
      set_err(dec, MsgpackError::UnexpectedEof(start_pos))
      return MsgpackValue::Nil
    }
    dec.items = dec.items + 1
    if dec.items > dec.max_items {
      set_err(dec, MsgpackError::MaxItemsExceeded(dec.max_items))
      return MsgpackValue::Nil
    }
    let b = dec.data[start_pos].to_int()
    dec.pos = start_pos + 1

    let mut produced = false
    let mut cur_val = MsgpackValue::Nil

    if b <= 0x7F {
      cur_val = MsgpackValue::UInt(b.to_int64().to_uint64())
      produced = true
    } else if b >= 0xE0 {
      cur_val = MsgpackValue::Int((b - 256).to_int64())
      produced = true
    } else if b >= 0xA0 && b <= 0xBF {
      cur_val = decode_str_payload(dec, (b & 0x1F).to_int64().to_uint64())
      produced = true
    } else if b >= 0x90 && b <= 0x9F {
      let next_depth = cur_depth + 1
      if next_depth > dec.max_depth {
        set_err(dec, MsgpackError::MaxDepthExceeded(dec.max_depth))
        return MsgpackValue::Nil
      }
      let n = b & 0x0F
      if n == 0 {
        cur_val = MsgpackValue::Array([])
        produced = true
      } else {
        let count = validate_array_count(dec, n.to_int64().to_uint64())
        if count < 0 {
          return MsgpackValue::Nil
        }
        frames.push(IterFrame::Arr(IterArrFrame::{ items: Array::with_capacity(count), rem: count }))
      }
    } else if b >= 0x80 && b <= 0x8F {
      let next_depth = cur_depth + 1
      if next_depth > dec.max_depth {
        set_err(dec, MsgpackError::MaxDepthExceeded(dec.max_depth))
        return MsgpackValue::Nil
      }
      let n = b & 0x0F
      if n == 0 {
        cur_val = MsgpackValue::Map([])
        produced = true
      } else {
        let count = validate_map_count(dec, n.to_int64().to_uint64())
        if count < 0 {
          return MsgpackValue::Nil
        }
        let hset = if dec.reject_duplicate_keys && count > 8 {
          Option::Some(make_key_hash_set(dec, count * 2))
        } else {
          Option::None
        }
        frames.push(
          IterFrame::Map(
            IterMapFrame::{
              pairs: Array::with_capacity(count),
              rem: count,
              has_key: false,
              key: MsgpackValue::Nil,
              key_pos: dec.pos,
              hset: hset,
            },
          ),
        )
      }
    } else if b == 0xDC || b == 0xDD {
      let next_depth = cur_depth + 1
      if next_depth > dec.max_depth {
        set_err(dec, MsgpackError::MaxDepthExceeded(dec.max_depth))
        return MsgpackValue::Nil
      }
      let count_u64 = if b == 0xDC {
        if dec.len - dec.pos < 2 {
          set_err(dec, MsgpackError::UnexpectedEof(dec.pos))
          return MsgpackValue::Nil
        }
        let v = read_u16_be(dec.data, dec.pos).to_int64().to_uint64()
        dec.pos = dec.pos + 2
        if dec.require_canonical && v <= 15UL {
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        v
      } else {
        if dec.len - dec.pos < 4 {
          set_err(dec, MsgpackError::UnexpectedEof(dec.pos))
          return MsgpackValue::Nil
        }
        let v = read_u32_be(dec.data, dec.pos)
        dec.pos = dec.pos + 4
        if dec.require_canonical && v <= 0xFFFFUL {
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        v
      }
      if count_u64 == 0UL {
        cur_val = MsgpackValue::Array([])
        produced = true
      } else {
        let count = validate_array_count(dec, count_u64)
        if count < 0 {
          return MsgpackValue::Nil
        }
        frames.push(IterFrame::Arr(IterArrFrame::{ items: Array::with_capacity(count), rem: count }))
      }
    } else if b == 0xDE || b == 0xDF {
      let next_depth = cur_depth + 1
      if next_depth > dec.max_depth {
        set_err(dec, MsgpackError::MaxDepthExceeded(dec.max_depth))
        return MsgpackValue::Nil
      }
      let count_u64 = if b == 0xDE {
        if dec.len - dec.pos < 2 {
          set_err(dec, MsgpackError::UnexpectedEof(dec.pos))
          return MsgpackValue::Nil
        }
        let v = read_u16_be(dec.data, dec.pos).to_int64().to_uint64()
        dec.pos = dec.pos + 2
        if dec.require_canonical && v <= 15UL {
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        v
      } else {
        if dec.len - dec.pos < 4 {
          set_err(dec, MsgpackError::UnexpectedEof(dec.pos))
          return MsgpackValue::Nil
        }
        let v = read_u32_be(dec.data, dec.pos)
        dec.pos = dec.pos + 4
        if dec.require_canonical && v <= 0xFFFFUL {
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        v
      }
      if count_u64 == 0UL {
        cur_val = MsgpackValue::Map([])
        produced = true
      } else {
        let count = validate_map_count(dec, count_u64)
        if count < 0 {
          return MsgpackValue::Nil
        }
        let hset = if dec.reject_duplicate_keys && count > 8 {
          Option::Some(make_key_hash_set(dec, count * 2))
        } else {
          Option::None
        }
        frames.push(
          IterFrame::Map(
            IterMapFrame::{
              pairs: Array::with_capacity(count),
              rem: count,
              has_key: false,
              key: MsgpackValue::Nil,
              key_pos: dec.pos,
              hset: hset,
            },
          ),
        )
      }
    } else {
      cur_val = decode_scalar_marker(dec, b, start_pos)
      produced = true
    }

    if dec.has_err {
      return MsgpackValue::Nil
    }

    while produced {
      let top = frames.length() - 1
      if top < 0 {
        return cur_val
      }
      match frames[top] {
        Arr(af) => {
          af.items.push(cur_val)
          let rem = af.rem - 1
          af.rem = rem
          if rem == 0 {
            let _ = frames.pop()
            cur_val = MsgpackValue::Array(af.items)
          } else {
            produced = false
          }
        }
        Map(mf) =>
        if !mf.has_key {
          if dec.reject_duplicate_keys {
            let pairs = mf.pairs
            match mf.hset {
              Some(hset) =>
              if !key_hash_set_insert(hset, pairs, cur_val, pairs.length()) {
                set_err(dec, MsgpackError::DuplicateMapKey(mf.key_pos))
                return MsgpackValue::Nil
              }
              None => {
                let mut j = 0
                while j < pairs.length() {
                  let (pk, _) = pairs[j]
                  if msgpack_equals(pk, cur_val) {
                    set_err(dec, MsgpackError::DuplicateMapKey(mf.key_pos))
                    return MsgpackValue::Nil
                  }
                  j = j + 1
                }
              }
            }
          }
          mf.key = cur_val
          mf.has_key = true
          produced = false
        } else {
          mf.pairs.push((mf.key, cur_val))
          mf.has_key = false
          let rem = mf.rem - 1
          mf.rem = rem
          if rem == 0 {
            let _ = frames.pop()
            cur_val = MsgpackValue::Map(mf.pairs)
          } else {
            mf.key_pos = dec.pos
            produced = false
          }
        }
      }
    }
  }
  MsgpackValue::Nil
}

///| Decode non-container markers (`0xC0..=0xDB`, excluding arrays/maps/fixint/fixstr).
fn decode_scalar_marker(dec : Decoder, b : Int, start_pos : Int) -> MsgpackValue {
  let data = dec.data
  let pos = dec.pos
  let rem = dec.len - pos
  match b {
    0xC0 => MsgpackValue::Nil
    0xC1 => {
      set_err(dec, MsgpackError::InvalidMarker(0xC1, start_pos))
      MsgpackValue::Nil
    }
    0xC2 => MsgpackValue::Bool(false)
    0xC3 => MsgpackValue::Bool(true)
    0xC4 => {
      if rem < 1 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let n = data[pos].to_int().to_int64().to_uint64()
      dec.pos = pos + 1
      decode_bin_payload(dec, n)
    }
    0xC5 => {
      if rem < 2 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let n = read_u16_be(data, pos).to_int64().to_uint64()
      dec.pos = pos + 2
      if dec.require_canonical && n <= 0xFFUL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      decode_bin_payload(dec, n)
    }
    0xC6 => {
      if rem < 4 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let n = read_u32_be(data, pos)
      dec.pos = pos + 4
      if dec.require_canonical && n <= 0xFFFFUL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      decode_bin_payload(dec, n)
    }
    0xC7 => {
      if rem < 1 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let n = data[pos].to_int().to_int64().to_uint64()
      dec.pos = pos + 1
      decode_ext_payload(dec, 0xC7, start_pos, n)
    }
    0xC8 => {
      if rem < 2 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let n = read_u16_be(data, pos).to_int64().to_uint64()
      dec.pos = pos + 2
      decode_ext_payload(dec, 0xC8, start_pos, n)
    }
    0xC9 => {
      if rem < 4 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let n = read_u32_be(data, pos)
      dec.pos = pos + 4
      decode_ext_payload(dec, 0xC9, start_pos, n)
    }
    0xCA => {
      if rem < 4 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let bits = read_u32_be(data, pos).to_int64()
      dec.pos = pos + 4
      MsgpackValue::Float32(float32_to_double(bits))
    }
    0xCB => {
      if rem < 8 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let bits = read_u64_be(data, pos).to_int64()
      dec.pos = pos + 8
      MsgpackValue::Float64(Double::from_bits(bits))
    }
    0xCC => {
      if rem < 1 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let v = data[pos].to_int().to_int64().to_uint64()
      dec.pos = pos + 1
      if dec.require_canonical && v <= 0x7FUL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      MsgpackValue::UInt(v)
    }
    0xCD => {
      if rem < 2 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let v = read_u16_be(data, pos).to_int64().to_uint64()
      dec.pos = pos + 2
      if dec.require_canonical && v <= 0xFFUL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      MsgpackValue::UInt(v)
    }
    0xCE => {
      if rem < 4 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let v = read_u32_be(data, pos)
      dec.pos = pos + 4
      if dec.require_canonical && v <= 0xFFFFUL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      MsgpackValue::UInt(v)
    }
    0xCF => {
      if rem < 8 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let v = read_u64_be(data, pos)
      dec.pos = pos + 8
      if dec.require_canonical && v <= 0xFFFFFFFFUL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      MsgpackValue::UInt(v)
    }
    0xD0 => {
      if rem < 1 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let raw = data[pos].to_int()
      dec.pos = pos + 1
      let v = (if raw >= 128 { raw - 256 } else { raw }).to_int64()
      if dec.require_canonical && v >= -32L {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      if v >= 0L {
        MsgpackValue::UInt(v.to_uint64())
      } else {
        MsgpackValue::Int(v)
      }
    }
    0xD1 => {
      if rem < 2 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let raw = read_u16_be(data, pos)
      dec.pos = pos + 2
      let v = (if raw >= 32768 { raw - 65536 } else { raw }).to_int64()
      if dec.require_canonical && v >= -128L {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      if v >= 0L {
        MsgpackValue::UInt(v.to_uint64())
      } else {
        MsgpackValue::Int(v)
      }
    }
    0xD2 => {
      if rem < 4 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let u = read_u32_be(data, pos).to_int64()
      dec.pos = pos + 4
      let v = if u >= 0x80000000L { u - 0x100000000L } else { u }
      if dec.require_canonical && v >= -32768L {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      if v >= 0L {
        MsgpackValue::UInt(v.to_uint64())
      } else {
        MsgpackValue::Int(v)
      }
    }
    0xD3 => {
      if rem < 8 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let v = read_u64_be(data, pos).to_int64()
      dec.pos = pos + 8
      if dec.require_canonical && v >= -2147483648L {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      if v >= 0L {
        MsgpackValue::UInt(v.to_uint64())
      } else {
        MsgpackValue::Int(v)
      }
    }
    0xD4 => decode_ext_payload(dec, 0xD4, start_pos, 1UL)
    0xD5 => decode_ext_payload(dec, 0xD5, start_pos, 2UL)
    0xD6 => decode_ext_payload(dec, 0xD6, start_pos, 4UL)
    0xD7 => decode_ext_payload(dec, 0xD7, start_pos, 8UL)
    0xD8 => decode_ext_payload(dec, 0xD8, start_pos, 16UL)
    0xD9 => {
      if rem < 1 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let n = data[pos].to_int().to_int64().to_uint64()
      dec.pos = pos + 1
      if dec.require_canonical && n <= 31UL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      decode_str_payload(dec, n)
    }
    0xDA => {
      if rem < 2 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let n = read_u16_be(data, pos).to_int64().to_uint64()
      dec.pos = pos + 2
      if dec.require_canonical && n <= 0xFFUL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      decode_str_payload(dec, n)
    }
    0xDB => {
      if rem < 4 {
        set_err(dec, MsgpackError::UnexpectedEof(pos))
        return MsgpackValue::Nil
      }
      let n = read_u32_be(data, pos)
      dec.pos = pos + 4
      if dec.require_canonical && n <= 0xFFFFUL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      decode_str_payload(dec, n)
    }
    _ => {
      set_err(dec, MsgpackError::InvalidMarker(b, start_pos))
      MsgpackValue::Nil
    }
  }
}

///| Hot-loop array element decoder with inlined numeric scalar fast paths (fixint, int/uint, f32, f64).
fn decode_array_items(dec : Decoder, count : Int, next_depth : Int) -> MsgpackValue {
  let items : Array[MsgpackValue] = Array::with_capacity(count)
  let data = dec.data
  let len = dec.len
  let max_items = dec.max_items
  let req_canon = dec.require_canonical
  let mut pos = dec.pos
  let mut item_cnt = dec.items
  let mut i = 0
  while i < count {
    if pos >= len {
      dec.pos = pos
      dec.items = item_cnt
      set_err(dec, MsgpackError::UnexpectedEof(pos))
      return MsgpackValue::Nil
    }
    let b = data[pos].to_int()
    if b <= 0x7F {
      item_cnt = item_cnt + 1
      if item_cnt > max_items {
        dec.pos = pos
        dec.items = item_cnt
        set_err(dec, MsgpackError::MaxItemsExceeded(max_items))
        return MsgpackValue::Nil
      }
      pos = pos + 1
      items.push(MsgpackValue::UInt(b.to_int64().to_uint64()))
    } else if b >= 0xE0 {
      item_cnt = item_cnt + 1
      if item_cnt > max_items {
        dec.pos = pos
        dec.items = item_cnt
        set_err(dec, MsgpackError::MaxItemsExceeded(max_items))
        return MsgpackValue::Nil
      }
      pos = pos + 1
      items.push(MsgpackValue::Int((b - 256).to_int64()))
    } else if b == 0xCA {
      item_cnt = item_cnt + 1
      if item_cnt > max_items {
        dec.pos = pos
        dec.items = item_cnt
        set_err(dec, MsgpackError::MaxItemsExceeded(max_items))
        return MsgpackValue::Nil
      }
      if len - pos < 5 {
        dec.pos = pos + 1
        dec.items = item_cnt
        set_err(dec, MsgpackError::UnexpectedEof(pos + 1))
        return MsgpackValue::Nil
      }
      let bits = read_u32_be(data, pos + 1).to_int64()
      pos = pos + 5
      items.push(MsgpackValue::Float32(float32_to_double(bits)))
    } else if b == 0xCB {
      item_cnt = item_cnt + 1
      if item_cnt > max_items {
        dec.pos = pos
        dec.items = item_cnt
        set_err(dec, MsgpackError::MaxItemsExceeded(max_items))
        return MsgpackValue::Nil
      }
      if len - pos < 9 {
        dec.pos = pos + 1
        dec.items = item_cnt
        set_err(dec, MsgpackError::UnexpectedEof(pos + 1))
        return MsgpackValue::Nil
      }
      let bits = read_u64_be(data, pos + 1).to_int64()
      pos = pos + 9
      items.push(MsgpackValue::Float64(Double::from_bits(bits)))
    } else if b >= 0xCC && b <= 0xD3 {
      item_cnt = item_cnt + 1
      if item_cnt > max_items {
        dec.pos = pos
        dec.items = item_cnt
        set_err(dec, MsgpackError::MaxItemsExceeded(max_items))
        return MsgpackValue::Nil
      }
      let start_pos = pos
      pos = pos + 1
      let rem = len - pos
      if b == 0xCC {
        if rem < 1 {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::UnexpectedEof(pos))
          return MsgpackValue::Nil
        }
        let v = data[pos].to_int().to_int64().to_uint64()
        pos = pos + 1
        if req_canon && v <= 0x7FUL {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        items.push(MsgpackValue::UInt(v))
      } else if b == 0xCD {
        if rem < 2 {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::UnexpectedEof(pos))
          return MsgpackValue::Nil
        }
        let v = read_u16_be(data, pos).to_int64().to_uint64()
        pos = pos + 2
        if req_canon && v <= 0xFFUL {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        items.push(MsgpackValue::UInt(v))
      } else if b == 0xCE {
        if rem < 4 {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::UnexpectedEof(pos))
          return MsgpackValue::Nil
        }
        let v = read_u32_be(data, pos)
        pos = pos + 4
        if req_canon && v <= 0xFFFFUL {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        items.push(MsgpackValue::UInt(v))
      } else if b == 0xCF {
        if rem < 8 {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::UnexpectedEof(pos))
          return MsgpackValue::Nil
        }
        let v = read_u64_be(data, pos)
        pos = pos + 8
        if req_canon && v <= 0xFFFFFFFFUL {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        items.push(MsgpackValue::UInt(v))
      } else if b == 0xD0 {
        if rem < 1 {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::UnexpectedEof(pos))
          return MsgpackValue::Nil
        }
        let raw = data[pos].to_int()
        pos = pos + 1
        let v = (if raw >= 128 { raw - 256 } else { raw }).to_int64()
        if req_canon && v >= -32L {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        if v >= 0L {
          items.push(MsgpackValue::UInt(v.to_uint64()))
        } else {
          items.push(MsgpackValue::Int(v))
        }
      } else if b == 0xD1 {
        if rem < 2 {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::UnexpectedEof(pos))
          return MsgpackValue::Nil
        }
        let raw = read_u16_be(data, pos)
        pos = pos + 2
        let v = (if raw >= 32768 { raw - 65536 } else { raw }).to_int64()
        if req_canon && v >= -128L {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        if v >= 0L {
          items.push(MsgpackValue::UInt(v.to_uint64()))
        } else {
          items.push(MsgpackValue::Int(v))
        }
      } else if b == 0xD2 {
        if rem < 4 {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::UnexpectedEof(pos))
          return MsgpackValue::Nil
        }
        let u = read_u32_be(data, pos).to_int64()
        pos = pos + 4
        let v = if u >= 0x80000000L { u - 0x100000000L } else { u }
        if req_canon && v >= -32768L {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        if v >= 0L {
          items.push(MsgpackValue::UInt(v.to_uint64()))
        } else {
          items.push(MsgpackValue::Int(v))
        }
      } else {
        if rem < 8 {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::UnexpectedEof(pos))
          return MsgpackValue::Nil
        }
        let v = read_u64_be(data, pos).to_int64()
        pos = pos + 8
        if req_canon && v >= -2147483648L {
          dec.pos = pos
          dec.items = item_cnt
          set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
          return MsgpackValue::Nil
        }
        if v >= 0L {
          items.push(MsgpackValue::UInt(v.to_uint64()))
        } else {
          items.push(MsgpackValue::Int(v))
        }
      }
    } else {
      dec.pos = pos
      dec.items = item_cnt
      let elem = decode_item(dec, next_depth)
      if dec.has_err {
        return MsgpackValue::Nil
      }
      pos = dec.pos
      item_cnt = dec.items
      items.push(elem)
    }
    i = i + 1
  }
  dec.pos = pos
  dec.items = item_cnt
  MsgpackValue::Array(items)
}

///| Fast recursive decoder for depth <= `decode_rec_limit`, falling back to `decode_iter`.
fn decode_item(dec : Decoder, depth : Int) -> MsgpackValue {
  if depth >= decode_rec_limit {
    return decode_iter(dec, depth)
  }
  let start_pos = dec.pos
  if start_pos >= dec.len {
    set_err(dec, MsgpackError::UnexpectedEof(start_pos))
    return MsgpackValue::Nil
  }
  dec.items = dec.items + 1
  if dec.items > dec.max_items {
    set_err(dec, MsgpackError::MaxItemsExceeded(dec.max_items))
    return MsgpackValue::Nil
  }
  let b = dec.data[start_pos].to_int()
  dec.pos = start_pos + 1

  if b <= 0x7F {
    return MsgpackValue::UInt(b.to_int64().to_uint64())
  }
  if b >= 0xE0 {
    return MsgpackValue::Int((b - 256).to_int64())
  }
  if b >= 0xA0 && b <= 0xBF {
    return decode_str_payload(dec, (b & 0x1F).to_int64().to_uint64())
  }
  if b >= 0x90 && b <= 0x9F {
    let next_depth = depth + 1
    if next_depth > dec.max_depth {
      set_err(dec, MsgpackError::MaxDepthExceeded(dec.max_depth))
      return MsgpackValue::Nil
    }
    let n = b & 0x0F
    if n == 0 {
      return MsgpackValue::Array([])
    }
    let count = validate_array_count(dec, n.to_int64().to_uint64())
    if count < 0 {
      return MsgpackValue::Nil
    }
    return decode_array_items(dec, count, next_depth)
  }
  if b >= 0x80 && b <= 0x8F {
    let next_depth = depth + 1
    if next_depth > dec.max_depth {
      set_err(dec, MsgpackError::MaxDepthExceeded(dec.max_depth))
      return MsgpackValue::Nil
    }
    let n = b & 0x0F
    if n == 0 {
      return MsgpackValue::Map([])
    }
    let count = validate_map_count(dec, n.to_int64().to_uint64())
    if count < 0 {
      return MsgpackValue::Nil
    }
    return decode_map_entries(dec, count, next_depth)
  }
  if b == 0xDC || b == 0xDD {
    let next_depth = depth + 1
    if next_depth > dec.max_depth {
      set_err(dec, MsgpackError::MaxDepthExceeded(dec.max_depth))
      return MsgpackValue::Nil
    }
    let count_u64 = if b == 0xDC {
      if dec.len - dec.pos < 2 {
        set_err(dec, MsgpackError::UnexpectedEof(dec.pos))
        return MsgpackValue::Nil
      }
      let v = read_u16_be(dec.data, dec.pos).to_int64().to_uint64()
      dec.pos = dec.pos + 2
      if dec.require_canonical && v <= 15UL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      v
    } else {
      if dec.len - dec.pos < 4 {
        set_err(dec, MsgpackError::UnexpectedEof(dec.pos))
        return MsgpackValue::Nil
      }
      let v = read_u32_be(dec.data, dec.pos)
      dec.pos = dec.pos + 4
      if dec.require_canonical && v <= 0xFFFFUL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      v
    }
    if count_u64 == 0UL {
      return MsgpackValue::Array([])
    }
    let count = validate_array_count(dec, count_u64)
    if count < 0 {
      return MsgpackValue::Nil
    }
    return decode_array_items(dec, count, next_depth)
  }
  if b == 0xDE || b == 0xDF {
    let next_depth = depth + 1
    if next_depth > dec.max_depth {
      set_err(dec, MsgpackError::MaxDepthExceeded(dec.max_depth))
      return MsgpackValue::Nil
    }
    let count_u64 = if b == 0xDE {
      if dec.len - dec.pos < 2 {
        set_err(dec, MsgpackError::UnexpectedEof(dec.pos))
        return MsgpackValue::Nil
      }
      let v = read_u16_be(dec.data, dec.pos).to_int64().to_uint64()
      dec.pos = dec.pos + 2
      if dec.require_canonical && v <= 15UL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      v
    } else {
      if dec.len - dec.pos < 4 {
        set_err(dec, MsgpackError::UnexpectedEof(dec.pos))
        return MsgpackValue::Nil
      }
      let v = read_u32_be(dec.data, dec.pos)
      dec.pos = dec.pos + 4
      if dec.require_canonical && v <= 0xFFFFUL {
        set_err(dec, MsgpackError::NonCanonicalEncoding(start_pos))
        return MsgpackValue::Nil
      }
      v
    }
    if count_u64 == 0UL {
      return MsgpackValue::Map([])
    }
    let count = validate_map_count(dec, count_u64)
    if count < 0 {
      return MsgpackValue::Nil
    }
    return decode_map_entries(dec, count, next_depth)
  }
  decode_scalar_marker(dec, b, start_pos)
}

///|
fn decode_map_entries(dec : Decoder, count : Int, next_depth : Int) -> MsgpackValue {
  let pairs : Array[(MsgpackValue, MsgpackValue)] = Array::with_capacity(count)
  if !dec.reject_duplicate_keys {
    let mut i = 0
    while i < count {
      let k = decode_item(dec, next_depth)
      if dec.has_err {
        return MsgpackValue::Nil
      }
      let v = decode_item(dec, next_depth)
      if dec.has_err {
        return MsgpackValue::Nil
      }
      pairs.push((k, v))
      i = i + 1
    }
    return MsgpackValue::Map(pairs)
  }
  if count <= 8 {
    let mut i = 0
    while i < count {
      let kpos = dec.pos
      let k = decode_item(dec, next_depth)
      if dec.has_err {
        return MsgpackValue::Nil
      }
      let mut j = 0
      while j < i {
        let (pk, _) = pairs[j]
        if msgpack_equals(pk, k) {
          set_err(dec, MsgpackError::DuplicateMapKey(kpos))
          return MsgpackValue::Nil
        }
        j = j + 1
      }
      let v = decode_item(dec, next_depth)
      if dec.has_err {
        return MsgpackValue::Nil
      }
      pairs.push((k, v))
      i = i + 1
    }
    return MsgpackValue::Map(pairs)
  }
  let hset = make_key_hash_set(dec, count * 2)
  let mut i = 0
  while i < count {
    let kpos = dec.pos
    let k = decode_item(dec, next_depth)
    if dec.has_err {
      return MsgpackValue::Nil
    }
    if !key_hash_set_insert(hset, pairs, k, i) {
      set_err(dec, MsgpackError::DuplicateMapKey(kpos))
      return MsgpackValue::Nil
    }
    let v = decode_item(dec, next_depth)
    if dec.has_err {
      return MsgpackValue::Nil
    }
    pairs.push((k, v))
    i = i + 1
  }
  MsgpackValue::Map(pairs)
}

///|
fn make_decoder(
  data : Bytes,
  offset : Int,
  opts : DecodeOptions,
  cache_data_str : Bool,
) -> Decoder {
  Decoder::{
    data: data,
    data_str: "",
    has_data_str: false,
    cache_data_str: cache_data_str,
    len: data.length(),
    pos: offset,
    max_depth: opts.max_depth,
    max_items: opts.max_items,
    max_bytes: opts.max_bytes,
    items: 0,
    reject_duplicate_keys: opts.reject_duplicate_keys,
    require_canonical: opts.require_canonical,
    decode_timestamp: opts.decode_timestamp,
    has_err: false,
    err: MsgpackError::UnexpectedEof(0),
  }
}

///| Decode a single MessagePack value from `data` with custom options.
pub fn decode(data : Bytes, opts : DecodeOptions) -> Result[MsgpackValue, MsgpackError] {
  let dec = make_decoder(data, 0, opts, true)
  let v = decode_item(dec, 0)
  if dec.has_err {
    return Result::Err(dec.err)
  }
  if !opts.allow_trailing_bytes && dec.pos < dec.len {
    return Result::Err(MsgpackError::TrailingBytes(dec.pos))
  }
  Result::Ok(v)
}

///| Decode a single MessagePack value from `data` with default options.
pub fn decode_default(data : Bytes) -> Result[MsgpackValue, MsgpackError] {
  decode(data, DecodeOptions::default())
}

///| Decode the first MessagePack value at `offset`, returning `(value, bytes_consumed)`.
pub fn decode_prefix_at(
  data : Bytes,
  offset : Int,
  opts : DecodeOptions,
) -> Result[(MsgpackValue, Int), MsgpackError] {
  if offset < 0 || offset >= data.length() {
    return Result::Err(MsgpackError::UnexpectedEof(offset))
  }
  let dec = make_decoder(data, offset, opts, false)
  let v = decode_item(dec, 0)
  if dec.has_err {
    return Result::Err(dec.err)
  }
  Result::Ok((v, dec.pos - offset))
}

///| Decode the first MessagePack value at offset 0, returning `(value, bytes_consumed)`.
pub fn decode_prefix(
  data : Bytes,
  opts : DecodeOptions,
) -> Result[(MsgpackValue, Int), MsgpackError] {
  decode_prefix_at(data, 0, opts)
}

///| Decode a concatenated stream of MessagePack values until EOF.
pub fn decode_all(
  data : Bytes,
  opts : DecodeOptions,
) -> Result[Array[MsgpackValue], MsgpackError] {
  let dec = make_decoder(data, 0, opts, true)
  let out : Array[MsgpackValue] = []
  while dec.pos < dec.len {
    dec.items = 0
    let v = decode_item(dec, 0)
    if dec.has_err {
      return Result::Err(dec.err)
    }
    out.push(v)
  }
  Result::Ok(out)
}

///| Zero-copy UTF-8 string validation for `validate_iter` (no String allocation).
fn validate_str_payload(dec : Decoder, len_u64 : UInt64) -> Unit {
  let pos = dec.pos
  let rem = (dec.len - pos).to_int64().to_uint64()
  if len_u64 > rem {
    set_err(dec, MsgpackError::UnexpectedEof(pos))
    return
  }
  let max_b = dec.max_bytes.to_int64().to_uint64()
  if len_u64 > max_b {
    set_err(dec, MsgpackError::MaxBytesExceeded(dec.max_bytes))
    return
  }
  let n = len_u64.to_int()
  if n > 0 && !is_valid_utf8_range(dec.data, pos, n) {
    set_err(dec, MsgpackError::InvalidUtf8(pos))
    return
  }
  dec.pos = pos + n
}

///| Zero-tree iterative validator supporting arbitrary nesting depth (100,000+ layers, 0 SIGSEGV).
fn validate_iter(data : Bytes, opts : DecodeOptions) -> Result[Unit, MsgpackError] {
  if opts.reject_duplicate_keys {
    return match decode(data, opts) {
      Ok(_) => Result::Ok(())
      Err(e) => Result::Err(e)
    }
  }
  let dec = make_decoder(data, 0, opts, false)
  // Stack of remaining child value counts (for arrays: N; for maps: 2*N)
  let rem_stack : Array[Int] = []
  while true {
    let start_pos = dec.pos
    if start_pos >= dec.len {
      return Result::Err(MsgpackError::UnexpectedEof(start_pos))
    }
    dec.items = dec.items + 1
    if dec.items > dec.max_items {
      return Result::Err(MsgpackError::MaxItemsExceeded(dec.max_items))
    }
    let b = dec.data[start_pos].to_int()
    dec.pos = start_pos + 1
    let mut pushed = false
    if b <= 0x7F || b >= 0xE0 {
      ()
    } else if b >= 0xA0 && b <= 0xBF {
      validate_str_payload(dec, (b & 0x1F).to_int64().to_uint64())
      if dec.has_err {
        return Result::Err(dec.err)
      }
    } else if b >= 0x90 && b <= 0x9F {
      let next_depth = rem_stack.length() + 1
      if next_depth > dec.max_depth {
        return Result::Err(MsgpackError::MaxDepthExceeded(dec.max_depth))
      }
      let n = b & 0x0F
      if n > 0 {
        let count = validate_array_count(dec, n.to_int64().to_uint64())
        if count < 0 {
          return Result::Err(dec.err)
        }
        rem_stack.push(count)
        pushed = true
      }
    } else if b >= 0x80 && b <= 0x8F {
      let next_depth = rem_stack.length() + 1
      if next_depth > dec.max_depth {
        return Result::Err(MsgpackError::MaxDepthExceeded(dec.max_depth))
      }
      let n = b & 0x0F
      if n > 0 {
        let count = validate_map_count(dec, n.to_int64().to_uint64())
        if count < 0 {
          return Result::Err(dec.err)
        }
        rem_stack.push(count * 2)
        pushed = true
      }
    } else if b == 0xDC || b == 0xDD {
      let next_depth = rem_stack.length() + 1
      if next_depth > dec.max_depth {
        return Result::Err(MsgpackError::MaxDepthExceeded(dec.max_depth))
      }
      let count_u64 = if b == 0xDC {
        if dec.len - dec.pos < 2 {
          return Result::Err(MsgpackError::UnexpectedEof(dec.pos))
        }
        let v = read_u16_be(dec.data, dec.pos).to_int64().to_uint64()
        dec.pos = dec.pos + 2
        if dec.require_canonical && v <= 15UL {
          return Result::Err(MsgpackError::NonCanonicalEncoding(start_pos))
        }
        v
      } else {
        if dec.len - dec.pos < 4 {
          return Result::Err(MsgpackError::UnexpectedEof(dec.pos))
        }
        let v = read_u32_be(dec.data, dec.pos)
        dec.pos = dec.pos + 4
        if dec.require_canonical && v <= 0xFFFFUL {
          return Result::Err(MsgpackError::NonCanonicalEncoding(start_pos))
        }
        v
      }
      if count_u64 > 0UL {
        let count = validate_array_count(dec, count_u64)
        if count < 0 {
          return Result::Err(dec.err)
        }
        rem_stack.push(count)
        pushed = true
      }
    } else if b == 0xDE || b == 0xDF {
      let next_depth = rem_stack.length() + 1
      if next_depth > dec.max_depth {
        return Result::Err(MsgpackError::MaxDepthExceeded(dec.max_depth))
      }
      let count_u64 = if b == 0xDE {
        if dec.len - dec.pos < 2 {
          return Result::Err(MsgpackError::UnexpectedEof(dec.pos))
        }
        let v = read_u16_be(dec.data, dec.pos).to_int64().to_uint64()
        dec.pos = dec.pos + 2
        if dec.require_canonical && v <= 15UL {
          return Result::Err(MsgpackError::NonCanonicalEncoding(start_pos))
        }
        v
      } else {
        if dec.len - dec.pos < 4 {
          return Result::Err(MsgpackError::UnexpectedEof(dec.pos))
        }
        let v = read_u32_be(dec.data, dec.pos)
        dec.pos = dec.pos + 4
        if dec.require_canonical && v <= 0xFFFFUL {
          return Result::Err(MsgpackError::NonCanonicalEncoding(start_pos))
        }
        v
      }
      if count_u64 > 0UL {
        let count = validate_map_count(dec, count_u64)
        if count < 0 {
          return Result::Err(dec.err)
        }
        rem_stack.push(count * 2)
        pushed = true
      }
    } else {
      let _ = decode_scalar_marker(dec, b, start_pos)
      if dec.has_err {
        return Result::Err(dec.err)
      }
    }
    if !pushed {
      while rem_stack.length() > 0 {
        let top = rem_stack.length() - 1
        let rem = rem_stack[top] - 1
        if rem == 0 {
          let _ = rem_stack.pop()
        } else {
          rem_stack[top] = rem
          break
        }
      }
      if rem_stack.length() == 0 {
        break
      }
    }
  }
  if !opts.allow_trailing_bytes && dec.pos < dec.len {
    return Result::Err(MsgpackError::TrailingBytes(dec.pos))
  }
  Result::Ok(())
}

///| Validate that `data` is well-formed MessagePack under `opts`.
pub fn validate(data : Bytes, opts : DecodeOptions) -> Result[Unit, MsgpackError] {
  validate_iter(data, opts)
}
