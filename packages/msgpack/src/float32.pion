///| IEEE-754 binary32 (float32) exact bit-level conversions.

///| Convert 32-bit IEEE-754 binary32 bit pattern (in lower 32 bits of Int64) to IEEE-754 binary64 bits.
///  Preserves sign bit, subnormals, +-0.0, +-Inf, and all 23 bits of NaN payload.
#verify
pub fn float32_to_double_bits(bits : Int64) -> Int64 {
  let u = bits & 0xFFFFFFFFL
  let sign : Int64 = (u >> 31) & 1L
  let exp = ((u >> 23) & 0xFFL).to_int()
  let frac : Int64 = u & 0x7FFFFFL
  if exp == 0 {
    if frac == 0L {
      return sign << 63
    }
    // Subnormal binary32: (-1)^sign * frac * 2^-149
    let mut f = frac
    let mut e64 = 897 // 1023 - 126
    while (f & 0x800000L) == 0L {
      f = f << 1
      e64 = e64 - 1
    }
    let mant : Int64 = (f & 0x7FFFFFL) << 29
    return (sign << 63) | (e64.to_int64() << 52) | mant
  }
  if exp == 255 {
    if frac == 0L {
      return (sign << 63) | (0x7FFL << 52)
    }
    let mant : Int64 = frac << 29
    return (sign << 63) | (0x7FFL << 52) | mant
  }
  // Normal binary32: e64 = exp - 127 + 1023 = exp + 896
  let e64 : Int64 = (exp + 896).to_int64()
  let mant : Int64 = frac << 29
  (sign << 63) | (e64 << 52) | mant
}

///| Convert 32-bit IEEE-754 binary32 bit pattern (in lower 32 bits of Int64) to Double.
///  Preserves sign bit, subnormals, +-0.0, +-Inf, and all 23 bits of NaN payload.
pub fn float32_to_double(bits : Int64) -> Double {
  Double::from_bits(float32_to_double_bits(bits))
}

///| Convert Double to 32-bit IEEE-754 binary32 bit pattern (in lower 32 bits of Int64).
///  Preserves +-0.0, +-Inf, NaN sign + upper 23-bit payload, and uses round-to-nearest-even for finite values.
pub fn double_to_float32_bits(value : Double) -> Int64 {
  let bits = value.to_bits()
  let sign : Int64 = (bits >> 63) & 1L
  let exp = ((bits >> 52) & 0x7FFL).to_int()
  let frac : Int64 = bits & 0x000FFFFFFFFFFFFFL
  if exp == 0x7FF {
    if frac == 0L {
      return (sign << 31) | 0x7F800000L
    }
    let payload = (frac >> 29) & 0x7FFFFFL
    let safe_payload = if payload == 0L { 0x400000L } else { payload }
    return (sign << 31) | 0x7F800000L | safe_payload
  }
  if exp == 0 && frac == 0L {
    return sign << 31
  }
  let e = exp - 1023
  if e > 127 {
    // Overflow to +-Inf
    return (sign << 31) | 0x7F800000L
  }
  if e >= -126 {
    // Normal binary32 with round-to-nearest-even
    let mut mant = (frac >> 29) & 0x7FFFFFL
    let rem = frac & 0x1FFFFFFFL
    let half : Int64 = 0x10000000L
    if rem > half || (rem == half && (mant & 1L) != 0L) {
      mant = mant + 1L
      if mant == 0x800000L {
        mant = 0L
        let ne = e + 1
        if ne > 127 {
          return (sign << 31) | 0x7F800000L
        }
        return (sign << 31) | ((ne + 127).to_int64() << 23)
      }
    }
    return (sign << 31) | ((e + 127).to_int64() << 23) | mant
  }
  if e >= -150 {
    // Subnormal binary32 with round-to-nearest-even
    let full_sig : Int64 = (1L << 52) | frac
    let shift = -97 - e // in [30, 53]
    if shift >= 54 {
      return sign << 31
    }
    let mut mant = full_sig >> shift
    let half : Int64 = 1L << (shift - 1)
    let rem = full_sig & ((1L << shift) - 1L)
    if rem > half || (rem == half && (mant & 1L) != 0L) {
      mant = mant + 1L
      if mant == 0x800000L {
        return (sign << 31) | 0x00800000L
      }
    }
    return (sign << 31) | (mant & 0x7FFFFFL)
  }
  // Underflow to +-0.0
  sign << 31
}

///| Convert IEEE-754 binary64 bits to binary32 bit pattern only if exact (lossless).
#verify
pub fn double_bits_to_float32_exact(bits : Int64) -> Option[Int64] {
  let sign : Int64 = (bits >> 63) & 1L
  let exp = ((bits >> 52) & 0x7FFL).to_int()
  let frac : Int64 = bits & 0x000FFFFFFFFFFFFFL
  if exp == 0x7FF {
    if frac == 0L {
      return Option::Some((sign << 31) | 0x7F800000L)
    }
    if (frac & 0x1FFFFFFFL) != 0L {
      return Option::None
    }
    let payload = (frac >> 29) & 0x7FFFFFL
    if payload == 0L {
      return Option::None
    }
    return Option::Some((sign << 31) | 0x7F800000L | payload)
  }
  if exp == 0 && frac == 0L {
    return Option::Some(sign << 31)
  }
  let e = exp - 1023
  if e >= -126 && e <= 127 {
    if (frac & 0x1FFFFFFFL) != 0L {
      return Option::None
    }
    let f32 = (sign << 31) | ((e + 127).to_int64() << 23) | ((frac >> 29) & 0x7FFFFFL)
    return Option::Some(f32)
  }
  if e >= -149 && e <= -127 {
    let full_sig : Int64 = (1L << 52) | frac
    let shift = -97 - e
    let mask = (1L << shift) - 1L
    if (full_sig & mask) != 0L {
      return Option::None
    }
    let f32 = (sign << 31) | ((full_sig >> shift) & 0x7FFFFFL)
    return Option::Some(f32)
  }
  Option::None
}

///| Convert Double to binary32 bit pattern only if exact (lossless).
pub fn double_to_float32_exact(value : Double) -> Option[Int64] {
  double_bits_to_float32_exact(value.to_bits())
}
