///| Exhaustive MessagePack spec, Rust rmpv & Go vmihailenco/msgpack/v5 edge-case tests:
///  all 256 first-byte markers (including reserved 0xC1), integer boundaries, canonical encoding,
///  float32/64 exact bit preservation, strict RFC 3629 UTF-8, ext/timestamp boundaries, and streaming.

///|
fn one_byte(b : Int) -> Bytes {
  let out = Bytes::new(1)
  out[0] = b.to_byte()
  out
}

///|
test "spec_all_256_first_byte_markers" {
  // Verify every single one of the 256 possible first bytes (0x00..=0xFF):
  // - 0xC1 MUST be rejected with InvalidMarker(0xC1, 0).
  // - All other 255 markers decode validly when given a minimal valid payload.
  let mut b = 0
  while b < 256 {
    if b == 0xC1 {
      let raw = one_byte(0xC1)
      match decode_default(raw) {
        Err(InvalidMarker(m, pos)) => {
          debug_assert(m == 0xC1, "expected marker 0xC1")
          debug_assert(pos == 0, "expected offset 0")
        }
        _ => debug_assert(false, "0xC1 MUST fail with InvalidMarker(0xC1, 0)")
      }
    } else if b <= 0x7F {
      // positive fixint
      let v = unwrap_val(decode_default(one_byte(b)))
      debug_assert(msgpack_equals(v, MsgpackValue::UInt(b.to_int64().to_uint64())), "pos fixint")
    } else if b >= 0x80 && b <= 0x8F {
      // fixmap of length n = b & 0x0F (fill with n pairs of (i, nil))
      let n = b & 0x0F
      let buf = Bytes::new(1 + n * 2)
      buf[0] = b.to_byte()
      let mut i = 0
      while i < n {
        buf[1 + i * 2] = i.to_byte()
        buf[2 + i * 2] = (0xC0).to_byte()
        i = i + 1
      }
      match decode_default(buf) {
        Ok(Map(pairs)) => debug_assert(pairs.length() == n, "fixmap len")
        _ => debug_assert(false, "fixmap decode failed")
      }
    } else if b >= 0x90 && b <= 0x9F {
      // fixarray of length n = b & 0x0F
      let n = b & 0x0F
      let buf = Bytes::new(1 + n)
      buf[0] = b.to_byte()
      let mut i = 0
      while i < n {
        buf[1 + i] = (0xC0).to_byte()
        i = i + 1
      }
      match decode_default(buf) {
        Ok(Array(items)) => debug_assert(items.length() == n, "fixarray len")
        _ => debug_assert(false, "fixarray decode failed")
      }
    } else if b >= 0xA0 && b <= 0xBF {
      // fixstr of length n = b & 0x1F
      let n = b & 0x1F
      let buf = Bytes::new(1 + n)
      buf[0] = b.to_byte()
      let mut i = 0
      while i < n {
        buf[1 + i] = (0x61).to_byte() // 'a'
        i = i + 1
      }
      match decode_default(buf) {
        Ok(Str(s)) => debug_assert(s.length() == n, "fixstr len")
        _ => debug_assert(false, "fixstr decode failed")
      }
    } else if b == 0xC0 {
      let v = unwrap_val(decode_default(one_byte(0xC0)))
      debug_assert(msgpack_equals(v, MsgpackValue::Nil), "nil")
    } else if b == 0xC2 {
      let v = unwrap_val(decode_default(one_byte(0xC2)))
      debug_assert(msgpack_equals(v, MsgpackValue::Bool(false)), "false")
    } else if b == 0xC3 {
      let v = unwrap_val(decode_default(one_byte(0xC3)))
      debug_assert(msgpack_equals(v, MsgpackValue::Bool(true)), "true")
    } else if b == 0xC4 {
      let v = unwrap_val(decode_default(hex_to_bytes("c4-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Bin(Bytes::new(0))), "bin8")
    } else if b == 0xC5 {
      let v = unwrap_val(decode_default(hex_to_bytes("c5-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Bin(Bytes::new(0))), "bin16")
    } else if b == 0xC6 {
      let v = unwrap_val(decode_default(hex_to_bytes("c6-00-00-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Bin(Bytes::new(0))), "bin32")
    } else if b == 0xC7 {
      let v = unwrap_val(decode_default(hex_to_bytes("c7-00-01")))
      debug_assert(msgpack_equals(v, MsgpackValue::Ext(1, Bytes::new(0))), "ext8")
    } else if b == 0xC8 {
      let v = unwrap_val(decode_default(hex_to_bytes("c8-00-00-01")))
      debug_assert(msgpack_equals(v, MsgpackValue::Ext(1, Bytes::new(0))), "ext16")
    } else if b == 0xC9 {
      let v = unwrap_val(decode_default(hex_to_bytes("c9-00-00-00-00-01")))
      debug_assert(msgpack_equals(v, MsgpackValue::Ext(1, Bytes::new(0))), "ext32")
    } else if b == 0xCA {
      let v = unwrap_val(decode_default(hex_to_bytes("ca-00-00-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Float32(0.0)), "float32")
    } else if b == 0xCB {
      let v = unwrap_val(decode_default(hex_to_bytes("cb-00-00-00-00-00-00-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Float64(0.0)), "float64")
    } else if b == 0xCC {
      let v = unwrap_val(decode_default(hex_to_bytes("cc-ff")))
      debug_assert(msgpack_equals(v, MsgpackValue::UInt(255UL)), "uint8")
    } else if b == 0xCD {
      let v = unwrap_val(decode_default(hex_to_bytes("cd-01-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::UInt(256UL)), "uint16")
    } else if b == 0xCE {
      let v = unwrap_val(decode_default(hex_to_bytes("ce-00-01-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::UInt(65536UL)), "uint32")
    } else if b == 0xCF {
      let v = unwrap_val(decode_default(hex_to_bytes("cf-00-00-00-01-00-00-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::UInt(4294967296UL)), "uint64")
    } else if b == 0xD0 {
      let v = unwrap_val(decode_default(hex_to_bytes("d0-80")))
      debug_assert(msgpack_equals(v, MsgpackValue::Int(-128L)), "int8")
    } else if b == 0xD1 {
      let v = unwrap_val(decode_default(hex_to_bytes("d1-80-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Int(-32768L)), "int16")
    } else if b == 0xD2 {
      let v = unwrap_val(decode_default(hex_to_bytes("d2-80-00-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Int(-2147483648L)), "int32")
    } else if b == 0xD3 {
      let v = unwrap_val(decode_default(hex_to_bytes("d3-ff-ff-ff-ff-00-00-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Int(-4294967296L)), "int64")
    } else if b == 0xD4 {
      let v = unwrap_val(decode_default(hex_to_bytes("d4-01-aa")))
      debug_assert(msgpack_equals(v, MsgpackValue::Ext(1, hex_to_bytes("aa"))), "fixext1")
    } else if b == 0xD5 {
      let v = unwrap_val(decode_default(hex_to_bytes("d5-01-aa-bb")))
      debug_assert(msgpack_equals(v, MsgpackValue::Ext(1, hex_to_bytes("aa-bb"))), "fixext2")
    } else if b == 0xD6 {
      let v = unwrap_val(decode_default(hex_to_bytes("d6-01-aa-bb-cc-dd")))
      debug_assert(msgpack_equals(v, MsgpackValue::Ext(1, hex_to_bytes("aa-bb-cc-dd"))), "fixext4")
    } else if b == 0xD7 {
      let v = unwrap_val(decode_default(hex_to_bytes("d7-01-01-02-03-04-05-06-07-08")))
      debug_assert(
        msgpack_equals(v, MsgpackValue::Ext(1, hex_to_bytes("01-02-03-04-05-06-07-08"))),
        "fixext8",
      )
    } else if b == 0xD8 {
      let v = unwrap_val(
        decode_default(hex_to_bytes("d8-01-00-01-02-03-04-05-06-07-08-09-0a-0b-0c-0d-0e-0f")),
      )
      debug_assert(
        msgpack_equals(
          v,
          MsgpackValue::Ext(1, hex_to_bytes("00-01-02-03-04-05-06-07-08-09-0a-0b-0c-0d-0e-0f")),
        ),
        "fixext16",
      )
    } else if b == 0xD9 {
      let v = unwrap_val(decode_default(hex_to_bytes("d9-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Str("")), "str8")
    } else if b == 0xDA {
      let v = unwrap_val(decode_default(hex_to_bytes("da-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Str("")), "str16")
    } else if b == 0xDB {
      let v = unwrap_val(decode_default(hex_to_bytes("db-00-00-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Str("")), "str32")
    } else if b == 0xDC {
      let v = unwrap_val(decode_default(hex_to_bytes("dc-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Array([])), "array16")
    } else if b == 0xDD {
      let v = unwrap_val(decode_default(hex_to_bytes("dd-00-00-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Array([])), "array32")
    } else if b == 0xDE {
      let v = unwrap_val(decode_default(hex_to_bytes("de-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Map([])), "map16")
    } else if b == 0xDF {
      let v = unwrap_val(decode_default(hex_to_bytes("df-00-00-00-00")))
      debug_assert(msgpack_equals(v, MsgpackValue::Map([])), "map32")
    } else {
      // 0xE0..=0xFF negative fixint (-32..-1)
      let expected = (b - 256).to_int64()
      let v = unwrap_val(decode_default(one_byte(b)))
      debug_assert(msgpack_equals(v, MsgpackValue::Int(expected)), "neg fixint")
    }
    b = b + 1
  }
}

///|
test "spec_integer_boundaries_and_canonical_shortest" {
  let i64_min : Int64 = -9223372036854775807L - 1L
  // Signed Int values >= 0 must encode using canonical shortest unsigned/fixint form!
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(0L)))) == "00", "Int(0)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(127L)))) == "7f", "Int(127)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(128L)))) == "cc80", "Int(128)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(255L)))) == "ccff", "Int(255)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(256L)))) == "cd0100", "Int(256)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(65535L)))) == "cdffff", "Int(65535)")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(65536L)))) == "ce00010000", "Int(65536)")
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(4294967295L)))) == "ceffffffff",
    "Int(4294967295)",
  )
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(4294967296L)))) == "cf0000000100000000",
    "Int(4294967296)",
  )
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(9223372036854775807L)))) == "cf7fffffffffffffff",
    "Int(i64::MAX)",
  )
  // Negative boundaries
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(-1L)))) == "ff", "-1")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(-32L)))) == "e0", "-32")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(-33L)))) == "d0df", "-33")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(-128L)))) == "d080", "-128")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(-129L)))) == "d1ff7f", "-129")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(-32768L)))) == "d18000", "-32768")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(-32769L)))) == "d2ffff7fff", "-32769")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(-2147483648L)))) == "d280000000", "-2^31")
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(-2147483649L)))) == "d3ffffffff7fffffff",
    "-2^31-1",
  )
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::Int(i64_min)))) == "d38000000000000000",
    "i64::MIN",
  )
  // UInt64::MAX
  debug_assert(
    bytes_to_hex(unwrap_bytes(encode_default(MsgpackValue::UInt(18446744073709551615UL)))) == "cfffffffffffffffff",
    "u64::MAX",
  )

  // Strict canonical mode must reject non-shortest encodings
  let strict = DecodeOptions::strict()
  let non_canonical = [
    "cc-00",
    "cc-7f",
    "cd-00-ff",
    "ce-00-00-ff-ff",
    "cf-00-00-00-00-ff-ff-ff-ff",
    "d0-00",
    "d0-ff",
    "d0-e0",
    "d1-ff-80",
    "d2-ff-ff-80-00",
    "d3-ff-ff-ff-ff-80-00-00-00",
    "d9-00",
    "d9-1f-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61",
    "da-00-20-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61-61",
    "c5-00-01-aa",
    "c6-00-00-00-01-aa",
    "dc-00-00",
    "dd-00-00-00-00",
    "de-00-00",
    "df-00-00-00-00",
    "c7-01-05-aa",
    "c7-02-05-aa-bb",
    "c7-04-05-aa-bb-cc-dd",
    "c8-00-03-05-aa-bb-cc",
    "c7-04-ff-00-00-00-01",
    "d7-ff-00-00-00-00-00-00-00-01",
    "c7-0c-ff-00-00-00-00-00-00-00-00-00-00-00-01",
  ]
  let mut i = 0
  while i < non_canonical.length() {
    match decode(hex_to_bytes(non_canonical[i]), strict) {
      Err(NonCanonicalEncoding(_)) => ()
      _ => debug_assert(false, "expected NonCanonicalEncoding for " + non_canonical[i])
    }
    i = i + 1
  }
}

///|
test "spec_float32_float64_exact_bits" {
  // Float32 exact bit roundtrip: +0.0, -0.0, +Inf, -Inf, qNaN, payload NaN, -NaN, subnormal min, max finite
  let f32_hexes = [
    "ca-00-00-00-00", // +0.0
    "ca-80-00-00-00", // -0.0
    "ca-7f-80-00-00", // +Inf
    "ca-ff-80-00-00", // -Inf
    "ca-7f-c0-00-00", // qNaN
    "ca-7f-c0-12-34", // qNaN with payload
    "ca-7f-80-00-01", // sNaN with payload
    "ca-ff-c0-ab-cd", // negative NaN with payload
    "ca-00-00-00-01", // smallest positive subnormal 2^-149
    "ca-00-7f-ff-ff", // largest subnormal
    "ca-00-80-00-00", // smallest normal 2^-126
    "ca-7f-7f-ff-ff", // largest finite float32
    "ca-3f-9d-70-a4", // 1.23f32
  ]
  let mut i = 0
  while i < f32_hexes.length() {
    let raw = hex_to_bytes(f32_hexes[i])
    let v = unwrap_val(decode_default(raw))
    let re = unwrap_bytes(encode_default(v))
    debug_assert(
      bytes_to_hex(re) == strip_dashes(f32_hexes[i]),
      "float32 exact bit roundtrip failed for " + f32_hexes[i] + ": got " + bytes_to_hex(re),
    )
    i = i + 1
  }

  // Verify -0.0 and +0.0 are distinct in msgpack_equals
  let pos_zero_32 = unwrap_val(decode_default(hex_to_bytes("ca-00-00-00-00")))
  let neg_zero_32 = unwrap_val(decode_default(hex_to_bytes("ca-80-00-00-00")))
  debug_assert(!msgpack_equals(pos_zero_32, neg_zero_32), "float32 +0.0 != -0.0")

  // Float64 exact bit roundtrip: +0.0, -0.0, +Inf, -Inf, qNaN, payload NaN, -NaN, subnormal, max finite
  let f64_hexes = [
    "cb-00-00-00-00-00-00-00-00", // +0.0
    "cb-80-00-00-00-00-00-00-00", // -0.0
    "cb-7f-f0-00-00-00-00-00-00", // +Inf
    "cb-ff-f0-00-00-00-00-00-00", // -Inf
    "cb-7f-f8-00-00-00-00-00-00", // qNaN
    "cb-7f-f8-12-34-56-78-9a-bc", // qNaN with payload
    "cb-7f-f0-00-00-00-00-00-01", // sNaN
    "cb-ff-f8-de-ad-be-ef-ca-fe", // negative NaN with payload
    "cb-00-00-00-00-00-00-00-01", // smallest positive subnormal
    "cb-7f-ef-ff-ff-ff-ff-ff-ff", // max finite float64
    "cb-40-09-21-fb-54-44-2d-18", // pi
  ]
  let mut j = 0
  while j < f64_hexes.length() {
    let raw = hex_to_bytes(f64_hexes[j])
    let v = unwrap_val(decode_default(raw))
    let re = unwrap_bytes(encode_default(v))
    debug_assert(
      bytes_to_hex(re) == strip_dashes(f64_hexes[j]),
      "float64 exact bit roundtrip failed for " + f64_hexes[j] + ": got " + bytes_to_hex(re),
    )
    j = j + 1
  }

  let pos_zero_64 = unwrap_val(decode_default(hex_to_bytes("cb-00-00-00-00-00-00-00-00")))
  let neg_zero_64 = unwrap_val(decode_default(hex_to_bytes("cb-80-00-00-00-00-00-00-00")))
  debug_assert(!msgpack_equals(pos_zero_64, neg_zero_64), "float64 +0.0 != -0.0")

  // compact_floats option: 1.5 encodes as float32, 0.1 stays float64
  let c1 = unwrap_bytes(encode(MsgpackValue::Float64(1.5), EncodeOptions::compact()))
  debug_assert(bytes_to_hex(c1) == "ca3fc00000", "compact 1.5 -> float32")
  let c2 = unwrap_bytes(encode(MsgpackValue::Float64(0.1), EncodeOptions::compact()))
  debug_assert(bytes_to_hex(c2) == "cb3fb999999999999a", "compact 0.1 stays float64")
}

///|
test "spec_str_vs_bin_and_strict_utf8" {
  // Bin accepts arbitrary non-UTF8 bytes
  let raw_bin = hex_to_bytes("c4-04-ff-fe-80-ed")
  let vb = unwrap_val(decode_default(raw_bin))
  debug_assert(msgpack_equals(vb, MsgpackValue::Bin(hex_to_bytes("ff-fe-80-ed"))), "bin accepts non-UTF8")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(vb))) == "c404fffe80ed", "bin roundtrip")

  // Str MUST reject invalid RFC 3629 UTF-8 sequences
  let bad_utf8_hexes = [
    "a1-80", // lone continuation byte
    "a1-ff", // 0xFF invalid
    "a1-fe", // 0xFE invalid
    "a2-c0-af", // overlong '/'
    "a2-c1-bf", // overlong 2-byte
    "a2-c2-20", // bad continuation
    "a1-c2", // truncated 2-byte
    "a3-e0-80-af", // overlong 3-byte
    "a3-e0-9f-bf", // overlong 3-byte boundary
    "a3-ed-a0-80", // UTF-16 high surrogate U+D800
    "a3-ed-bf-bf", // UTF-16 low surrogate U+DFFF
    "a2-e2-9d", // truncated 3-byte
    "a4-f0-80-80-af", // overlong 4-byte
    "a4-f0-8f-bf-bf", // overlong 4-byte boundary
    "a4-f4-90-80-80", // > U+10FFFF
    "a4-f5-80-80-80", // > U+10FFFF
    "a3-f0-9f-8d", // truncated 4-byte
    "d9-03-ed-a0-80", // str8 surrogate
  ]
  let mut i = 0
  while i < bad_utf8_hexes.length() {
    match decode_default(hex_to_bytes(bad_utf8_hexes[i])) {
      Err(InvalidUtf8(_)) => ()
      _ => debug_assert(false, "expected InvalidUtf8 for " + bad_utf8_hexes[i])
    }
    i = i + 1
  }

  // Valid boundary UTF-8: U+0000, U+007F, U+0080, U+07FF, U+0800, U+D7FF, U+E000, U+FFFF, U+10000, U+10FFFF
  let good_utf8 = [
    "a1-00",
    "a1-7f",
    "a2-c2-80",
    "a2-df-bf",
    "a3-e0-a0-80",
    "a3-ed-9f-bf",
    "a3-ee-80-80",
    "a3-ef-bf-bf",
    "a4-f0-90-80-80",
    "a4-f4-8f-bf-bf",
  ]
  let mut j = 0
  while j < good_utf8.length() {
    let raw = hex_to_bytes(good_utf8[j])
    let v = unwrap_val(decode_default(raw))
    debug_assert(bytes_to_hex(unwrap_bytes(encode_default(v))) == strip_dashes(good_utf8[j]), "valid UTF-8 roundtrip")
    j = j + 1
  }
}

///|
test "spec_ext_and_timestamp_validation" {
  // Signed ext types -128..=127 (excluding -1 when decode_timestamp=true)
  let ext_neg128 = unwrap_val(decode_default(hex_to_bytes("d4-80-42")))
  debug_assert(msgpack_equals(ext_neg128, MsgpackValue::Ext(-128, hex_to_bytes("42"))), "ext -128")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(ext_neg128))) == "d48042", "ext -128 encode")

  let ext_neg2 = unwrap_val(decode_default(hex_to_bytes("d4-fe-99")))
  debug_assert(msgpack_equals(ext_neg2, MsgpackValue::Ext(-2, hex_to_bytes("99"))), "ext -2")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(ext_neg2))) == "d4fe99", "ext -2 encode")

  let ext_pos127 = unwrap_val(decode_default(hex_to_bytes("d4-7f-11")))
  debug_assert(msgpack_equals(ext_pos127, MsgpackValue::Ext(127, hex_to_bytes("11"))), "ext 127")
  debug_assert(bytes_to_hex(unwrap_bytes(encode_default(ext_pos127))) == "d47f11", "ext 127 encode")

  // Out-of-range ext type on encode must fail
  match encode_default(MsgpackValue::Ext(128, Bytes::new(0))) {
    Err(InvalidExtType(128)) => ()
    _ => debug_assert(false, "expected InvalidExtType(128)")
  }
  match encode_default(MsgpackValue::Ext(-129, Bytes::new(0))) {
    Err(InvalidExtType(-129)) => ()
    _ => debug_assert(false, "expected InvalidExtType(-129)")
  }

  // Timestamp invalid nanoseconds >= 1_000_000_000 MUST be rejected on decode (64-bit & 96-bit) AND encode!
  // 64-bit: nsec = 1_000_000_000 (0x3B9ACA00) << 34 = 0xEE6B2800_00000000
  match decode_default(hex_to_bytes("d7-ff-ee-6b-28-00-00-00-00-00")) {
    Err(InvalidTimestamp(_)) => ()
    _ => debug_assert(false, "expected InvalidTimestamp for ts64 nsec=1_000_000_000")
  }
  // 64-bit: nsec = 0x3FFFFFFF (max 30-bit)
  match decode_default(hex_to_bytes("d7-ff-ff-ff-ff-fc-00-00-00-00")) {
    Err(InvalidTimestamp(_)) => ()
    _ => debug_assert(false, "expected InvalidTimestamp for ts64 nsec=max30")
  }
  // 96-bit: nsec = 1_000_000_000 (0x3B9ACA00)
  match decode_default(hex_to_bytes("c7-0c-ff-3b-9a-ca-00-00-00-00-00-00-00-00-00")) {
    Err(InvalidTimestamp(_)) => ()
    _ => debug_assert(false, "expected InvalidTimestamp for ts96 nsec=1_000_000_000")
  }
  // 96-bit: nsec = 0xFFFFFFFF
  match decode_default(hex_to_bytes("c7-0c-ff-ff-ff-ff-ff-00-00-00-00-00-00-00-00")) {
    Err(InvalidTimestamp(_)) => ()
    _ => debug_assert(false, "expected InvalidTimestamp for ts96 nsec=0xFFFFFFFF")
  }
  // Invalid ext -1 lengths (0, 1, 2, 3, 5, 16) MUST be rejected when decode_timestamp=true
  let bad_ts_lens = [
    "c7-00-ff",
    "d4-ff-00",
    "d5-ff-00-00",
    "c7-03-ff-00-00-00",
    "c7-05-ff-00-00-00-00-00",
    "d8-ff-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00",
  ]
  let mut i = 0
  while i < bad_ts_lens.length() {
    match decode_default(hex_to_bytes(bad_ts_lens[i])) {
      Err(InvalidTimestamp(_)) => ()
      _ => debug_assert(false, "expected InvalidTimestamp for " + bad_ts_lens[i])
    }
    i = i + 1
  }
  // Invalid Timestamp on encode
  match encode_default(MsgpackValue::Timestamp(0L, -1)) {
    Err(InvalidTimestamp(_)) => ()
    _ => debug_assert(false, "expected InvalidTimestamp on encode nsec=-1")
  }
  match encode_default(MsgpackValue::Timestamp(0L, 1000000000)) {
    Err(InvalidTimestamp(_)) => ()
    _ => debug_assert(false, "expected InvalidTimestamp on encode nsec=1e9")
  }
  // decode_timestamp=false preserves raw Ext(-1, ...)
  let raw_ts_opts = DecodeOptions::{
    max_depth: 128,
    max_items: 1048576,
    max_bytes: 67108864,
    reject_duplicate_keys: false,
    require_canonical: false,
    decode_timestamp: false,
    allow_trailing_bytes: false,
  }
  let raw_ext = unwrap_val(decode(hex_to_bytes("d6-ff-00-00-00-01"), raw_ts_opts))
  debug_assert(
    msgpack_equals(raw_ext, MsgpackValue::Ext(-1, hex_to_bytes("00-00-00-01"))),
    "decode_timestamp=false returns Ext(-1, ...)",
  )
}

///|
test "spec_streaming_decode_prefix_and_decode_all" {
  // Concatenate 5 frames: int(42), str("hi"), array([true, nil]), timestamp(1, 0), map({"k": -5})
  let stream = hex_to_bytes("2a-a2-68-69-92-c3-c0-d6-ff-00-00-00-01-81-a1-6b-fb")
  let opts = DecodeOptions::default()
  let mut offset = 0
  let frames : Array[MsgpackValue] = []
  while offset < stream.length() {
    match decode_prefix_at(stream, offset, opts) {
      Ok((frame, consumed)) => {
        debug_assert(consumed > 0, "consumed must be > 0")
        frames.push(frame)
        offset = offset + consumed
      }
      Err(e) => {
        debug_assert(false, "decode_prefix_at failed: " + error_message(e))
        break
      }
    }
  }
  debug_assert(offset == stream.length(), "all bytes consumed")
  debug_assert(frames.length() == 5, "5 frames")
  debug_assert(msgpack_equals(frames[0], MsgpackValue::UInt(42UL)), "frame 0")
  debug_assert(msgpack_equals(frames[1], MsgpackValue::Str("hi")), "frame 1")
  debug_assert(
    msgpack_equals(frames[2], MsgpackValue::Array([MsgpackValue::Bool(true), MsgpackValue::Nil])),
    "frame 2",
  )
  debug_assert(msgpack_equals(frames[3], MsgpackValue::Timestamp(1L, 0)), "frame 3")
  debug_assert(
    msgpack_equals(frames[4], MsgpackValue::Map([(MsgpackValue::Str("k"), MsgpackValue::Int(-5L))])),
    "frame 4",
  )

  // decode_prefix returns first frame + consumed bytes
  match decode_prefix(stream, opts) {
    Ok((v0, c0)) => {
      debug_assert(msgpack_equals(v0, MsgpackValue::UInt(42UL)), "prefix v0")
      debug_assert(c0 == 1, "prefix c0 == 1")
    }
    Err(e) => debug_assert(false, "decode_prefix failed: " + error_message(e))
  }

  // decode_all returns all 5 frames
  match decode_all(stream, opts) {
    Ok(all) => {
      debug_assert(all.length() == 5, "decode_all len 5")
      debug_assert(msgpack_equals(all[4], frames[4]), "decode_all last frame")
    }
    Err(e) => debug_assert(false, "decode_all failed: " + error_message(e))
  }
}

///|
test "spec_large_lengths_str16_bin16_array16_map16_ext8_ext16" {
  // Test str8 (len 32), str16 (len 256), bin16 (len 256), array16 (len 16), map16 (len 16), ext8 (len 17)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 256 {
    sb.write_byte((0x78).to_byte()) // 'x'
    i = i + 1
  }
  let s256 = sb.to_string()
  let enc_s256 = unwrap_bytes(encode_default(MsgpackValue::Str(s256)))
  debug_assert(enc_s256.length() == 3 + 256 && enc_s256[0].to_int() == 0xDA, "str16 marker")
  debug_assert(msgpack_equals(unwrap_val(decode_default(enc_s256)), MsgpackValue::Str(s256)), "str16 rt")

  let b256 = Bytes::new(256)
  let mut j = 0
  while j < 256 {
    b256[j] = (j & 0xFF).to_byte()
    j = j + 1
  }
  let enc_b256 = unwrap_bytes(encode_default(MsgpackValue::Bin(b256)))
  debug_assert(enc_b256.length() == 3 + 256 && enc_b256[0].to_int() == 0xC5, "bin16 marker")
  debug_assert(msgpack_equals(unwrap_val(decode_default(enc_b256)), MsgpackValue::Bin(b256)), "bin16 rt")

  let b17 = Bytes::new(17)
  let enc_ext17 = unwrap_bytes(encode_default(MsgpackValue::Ext(42, b17)))
  debug_assert(enc_ext17.length() == 3 + 17 && enc_ext17[0].to_int() == 0xC7, "ext8 marker for len 17")
  debug_assert(
    msgpack_equals(unwrap_val(decode_default(enc_ext17)), MsgpackValue::Ext(42, b17)),
    "ext8 len 17 rt",
  )

  let enc_ext256 = unwrap_bytes(encode_default(MsgpackValue::Ext(42, b256)))
  debug_assert(enc_ext256.length() == 4 + 256 && enc_ext256[0].to_int() == 0xC8, "ext16 marker for len 256")
  debug_assert(
    msgpack_equals(unwrap_val(decode_default(enc_ext256)), MsgpackValue::Ext(42, b256)),
    "ext16 len 256 rt",
  )
}
