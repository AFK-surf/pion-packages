///| Head-to-head benchmark harness for `packages/cron` (W1 parse, W2 next_after, W3 sparse, W4 fri13).

import "cron"

///|
fn read_lines(world : World, path : String) -> Array[String] {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return []
  }
  let lines : Array[String] = []
  let clen = content.length()
  let mut pos = 0
  while pos < clen {
    let mut end = pos
    while end < clen && content.code_unit_at(end) != 10 {
      end = end + 1
    }
    if end > pos {
      lines.push(content.slice(pos, end))
    }
    pos = end + 1
  }
  lines
}

///|
fn bench_parse(world : World, exprs : Array[String]) -> Int {
  let base = match cron::DateTime::new(2024, 1, 1, 0, 0, 0) {
    Ok(dt) => dt
    Err(_) => return 1
  }
  let rounds = 1000
  let mut ok_count : Int64 = 0L
  let mut sum_secs : Int64 = 0L
  let mut xor_secs : Int64 = 0L
  let mut r = 0
  while r < rounds {
    let mut i = 0
    while i < exprs.length() {
      match cron::Cron::parse_standard(exprs[i]) {
        Ok(c) => {
          ok_count = ok_count + 1L
          if r == rounds - 1 {
            match c.next_after(base) {
              Some(dt) => {
                let ts = dt.to_unix_secs()
                sum_secs = sum_secs + ts
                xor_secs = xor_secs ^ ts
              }
              None => return 2
            }
          }
        }
        Err(_) => return 3
      }
      i = i + 1
    }
    r = r + 1
  }
  io_println(world, "mode=parse")
  io_println(world, "ops=" + ok_count.to_string())
  io_println(world, "sum_secs=" + sum_secs.to_string())
  io_println(world, "xor_secs=" + xor_secs.to_string())
  0
}

///|
fn bench_next(world : World, exprs : Array[String]) -> Int {
  let base = match cron::DateTime::new(2024, 1, 1, 0, 0, 0) {
    Ok(dt) => dt
    Err(_) => return 1
  }
  let compiled : Array[cron::Cron] = []
  let mut i = 0
  while i < exprs.length() {
    match cron::Cron::parse_standard(exprs[i]) {
      Ok(c) => compiled.push(c)
      Err(_) => return 2
    }
    i = i + 1
  }
  let rounds = 20
  let steps = 50
  let mut total_ops : Int64 = 0L
  let mut sum_secs : Int64 = 0L
  let mut xor_secs : Int64 = 0L
  let mut r = 0
  while r < rounds {
    let mut j = 0
    while j < compiled.length() {
      let c = compiled[j]
      let mut cur = base
      let mut k = 0
      while k < steps {
        match c.next_after(cur) {
          Some(nxt) => {
            let ts = nxt.to_unix_secs()
            sum_secs = sum_secs + ts
            xor_secs = xor_secs ^ ts
            cur = nxt
            total_ops = total_ops + 1L
          }
          None => return 3
        }
        k = k + 1
      }
      j = j + 1
    }
    r = r + 1
  }
  io_println(world, "mode=next")
  io_println(world, "ops=" + total_ops.to_string())
  io_println(world, "sum_secs=" + sum_secs.to_string())
  io_println(world, "xor_secs=" + xor_secs.to_string())
  0
}

///|
fn bench_sparse(world : World) -> Int {
  let base = match cron::DateTime::new(2024, 1, 1, 0, 0, 0) {
    Ok(dt) => dt
    Err(_) => return 1
  }
  let rare_exprs : Array[String] = [
    "0 0 29 2 *",
    "0 0 31 12 *",
    "0 0 30 4 *",
    "0 0 1 1 *",
    "0 0 31 1,3,5,7,8,10,12 *",
  ]
  let compiled : Array[cron::Cron] = []
  let mut i = 0
  while i < rare_exprs.length() {
    match cron::Cron::parse_standard(rare_exprs[i]) {
      Ok(c) => compiled.push(c)
      Err(_) => return 2
    }
    i = i + 1
  }
  let rounds = 125
  let steps = 16
  let mut total_ops : Int64 = 0L
  let mut sum_secs : Int64 = 0L
  let mut xor_secs : Int64 = 0L
  let mut r = 0
  while r < rounds {
    let mut j = 0
    while j < compiled.length() {
      let c = compiled[j]
      let mut cur = base
      let mut k = 0
      while k < steps {
        match c.next_after(cur) {
          Some(nxt) => {
            let ts = nxt.to_unix_secs()
            sum_secs = sum_secs + ts
            xor_secs = xor_secs ^ ts
            cur = nxt
            total_ops = total_ops + 1L
          }
          None => return 3
        }
        k = k + 1
      }
      j = j + 1
    }
    r = r + 1
  }
  io_println(world, "mode=sparse")
  io_println(world, "ops=" + total_ops.to_string())
  io_println(world, "sum_secs=" + sum_secs.to_string())
  io_println(world, "xor_secs=" + xor_secs.to_string())
  0
}

///|
fn bench_fri13(world : World) -> Int {
  let base = match cron::DateTime::new(2024, 1, 1, 0, 0, 0) {
    Ok(dt) => dt
    Err(_) => return 1
  }
  let opts = cron::ParseOptions::{ allow_seconds: false, allow_years: false, dom_and_dow: true }
  let c = match cron::Cron::parse_with_options("0 0 13 * 5", opts) {
    Ok(v) => v
    Err(_) => return 2
  }
  let rounds = 100
  let steps = 100
  let mut total_ops : Int64 = 0L
  let mut sum_secs : Int64 = 0L
  let mut xor_secs : Int64 = 0L
  let mut r = 0
  while r < rounds {
    let mut cur = base
    let mut k = 0
    while k < steps {
      match c.next_after(cur) {
        Some(nxt) => {
          let ts = nxt.to_unix_secs()
          sum_secs = sum_secs + ts
          xor_secs = xor_secs ^ ts
          cur = nxt
          total_ops = total_ops + 1L
        }
        None => return 3
      }
      k = k + 1
    }
    r = r + 1
  }
  io_println(world, "mode=fri13")
  io_println(world, "ops=" + total_ops.to_string())
  io_println(world, "sum_secs=" + sum_secs.to_string())
  io_println(world, "xor_secs=" + xor_secs.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: cron_bench <parse|next|sparse|fri13> [exprs_file]")
    return 1
  }
  let mode = args[1]
  if mode == "sparse" {
    return bench_sparse(world)
  }
  if mode == "fri13" {
    return bench_fri13(world)
  }
  let path = if args.length() > 2 { args[2] } else { "/private/tmp/pion-cron-bench/exprs_100.txt" }
  let exprs = read_lines(world, path)
  if exprs.length() == 0 {
    io_println(world, "error: empty exprs file")
    return 1
  }
  if mode == "parse" {
    return bench_parse(world, exprs)
  }
  if mode == "next" {
    return bench_next(world, exprs)
  }
  io_println(world, "unknown mode: " + mode)
  1
}
