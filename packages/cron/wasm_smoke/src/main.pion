///| Wasm32 + Native smoke entry for the `cron` package.

import "cron"

///|
pub fn smoke() -> Int {
  let c1 = match cron::Cron::parse("*/15 9-17 * * 1-5") {
    Ok(c) => c
    Err(_) => return -1
  }
  let base = match cron::DateTime::new(2024, 1, 5, 17, 45, 0) {
    Ok(dt) => dt
    Err(_) => return -2
  }
  let nxt = match c1.next_after(base) {
    Some(dt) => dt
    None => return -3
  }
  if nxt.year != 2024 || nxt.month != 1 || nxt.day != 8 || nxt.hour != 9 || nxt.minute != 0 {
    return -4
  }
  let prv = match c1.prev_before(nxt) {
    Some(dt) => dt
    None => return -5
  }
  if !prv.eq(base) {
    return -6
  }
  let leap = match cron::Cron::parse("0 0 29 2 *") {
    Ok(c) => c
    Err(_) => return -7
  }
  let y2096 = match cron::DateTime::new(2096, 2, 29, 0, 0, 0) {
    Ok(dt) => dt
    Err(_) => return -8
  }
  match leap.next_after(y2096) {
    Some(dt) => if dt.year != 2104 || dt.month != 2 || dt.day != 29 { return -9 }
    None => return -10
  }
  let imp = match cron::Cron::parse("0 0 31 2 *") {
    Ok(c) => c
    Err(_) => return -11
  }
  match imp.next_after(base) {
    None => ()
    Some(_) => return -12
  }
  let q = match cron::Cron::parse("0 0 L * *") {
    Ok(c) => c
    Err(_) => return -13
  }
  if q.describe().length() == 0 {
    return -14
  }
  nxt.to_string().length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
