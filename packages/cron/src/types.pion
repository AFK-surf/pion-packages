///| Core value types, error definitions, bit helpers, and calendar math for `cron`.

///| Minimum supported Gregorian year.
pub let MIN_YEAR : Int = 1

///| Maximum supported Gregorian year.
pub let MAX_YEAR : Int = 9999

///| Internal flag bit masks on `Cron.flags`.
let FLAG_DOM_STAR : UInt = 1U

let FLAG_DOW_STAR : UInt = 2U

let FLAG_DOM_AND_DOW : UInt = 4U

let FLAG_DOM_LAST : UInt = 8U

let FLAG_DOM_LAST_WEEKDAY : UInt = 16U

let FLAG_HAS_QUARTZ_DAY : UInt = 32U

let FLAG_HAS_YEAR_FILTER : UInt = 64U

///| De Bruijn table for O(1) 64-bit count-trailing-zeros (`0x03F79D71B4CB0A89`).
let DEBRUIJN64 : FixedArray[Int] = [
  0, 1, 48, 2, 57, 49, 28, 3, 61, 58, 50, 42, 38, 29, 17, 4, 62, 55, 59, 36, 53, 51, 43, 22, 45, 39,
  33, 30, 24, 18, 12, 5, 63, 47, 56, 27, 60, 41, 37, 16, 54, 35, 52, 21, 44, 32, 23, 11, 46, 26, 40,
  15, 34, 20, 31, 10, 25, 14, 19, 9, 13, 8, 7, 6,
]

///| O(1) trailing zero count for non-zero `UInt64`.
fn ctz64(x : UInt64) -> Int {
  let lsb = x & (0UL - x)
  let idx = ((lsb * 0x03F79D71B4CB0A89UL) >> 58).to_int()
  DEBRUIJN64[idx]
}

///| O(1) highest set bit index (0..=63) for non-zero `UInt64`.
fn msb64(x_in : UInt64) -> Int {
  let mut x = x_in
  let mut r = 0
  if (x & 0xFFFFFFFF00000000UL) != 0UL {
    x = x >> 32
    r = r + 32
  }
  if (x & 0xFFFF0000UL) != 0UL {
    x = x >> 16
    r = r + 16
  }
  if (x & 0xFF00UL) != 0UL {
    x = x >> 8
    r = r + 8
  }
  if (x & 0xF0UL) != 0UL {
    x = x >> 4
    r = r + 4
  }
  if (x & 0xCUL) != 0UL {
    x = x >> 2
    r = r + 2
  }
  if (x & 0x2UL) != 0UL {
    r = r + 1
  }
  r
}

///| Lowest set bit >= `from` in `mask`, or -1 if none.
fn next_set_bit(mask : UInt64, from : Int) -> Int {
  if from >= 64 {
    return -1
  }
  let shifted = if from <= 0 { mask } else { mask >> from }
  if shifted == 0UL {
    -1
  } else {
    (if from <= 0 { 0 } else { from }) + ctz64(shifted)
  }
}

///| Highest set bit <= `from` in `mask`, or -1 if none.
fn prev_set_bit(mask : UInt64, from : Int) -> Int {
  if from < 0 {
    return -1
  }
  let masked = if from >= 63 { mask } else { mask & ((1UL << (from + 1)) - 1UL) }
  if masked == 0UL {
    -1
  } else {
    msb64(masked)
  }
}

///| Error returned by fallible `cron` parsing and datetime operations.
pub enum CronError {
  EmptyExpression
  InvalidFieldCount(Int)
  InvalidSyntax(String)
  InvalidValue(String)
  OutOfRange(String)
  InvalidStep(String)
  InvalidRange(String)
  UnsupportedMacro(String)
  InvalidDateTime(String)
  NoMatchingTime
}

///|
pub fn cron_error_to_string(self : CronError) -> String {
  match self {
    CronError::EmptyExpression => "empty cron expression"
    CronError::InvalidFieldCount(n) => "invalid field count: " + n.to_string()
    CronError::InvalidSyntax(msg) => "invalid syntax: " + msg
    CronError::InvalidValue(msg) => "invalid value: " + msg
    CronError::OutOfRange(msg) => "out of range: " + msg
    CronError::InvalidStep(msg) => "invalid step: " + msg
    CronError::InvalidRange(msg) => "invalid range: " + msg
    CronError::UnsupportedMacro(msg) => "unsupported macro: " + msg
    CronError::InvalidDateTime(msg) => "invalid datetime: " + msg
    CronError::NoMatchingTime => "no matching time"
  }
}

///| Lightweight UTC civil date-time value (zero external dependencies).
pub val struct DateTime {
  pub year : Int
  pub month : Int
  pub day : Int
  pub hour : Int
  pub minute : Int
  pub second : Int
}

///|
pub fn is_leap_year(year : Int) -> Bool {
  if (year & 3) != 0 {
    return false
  }
  year % 25 != 0 || (year & 15) == 0
}

///|
pub fn days_in_month(year : Int, month : Int) -> Int {
  if month == 2 {
    if is_leap_year(year) {
      29
    } else {
      28
    }
  } else {
    30 + ((month + (month >> 3)) & 1)
  }
}

///| Howard Hinnant's O(1) civil date to days since 1970-01-01.
fn days_from_civil(year : Int, month : Int, day : Int) -> Int64 {
  let y = if month <= 2 { year - 1 } else { year }
  let era = if y >= 0 { y / 400 } else { (y - 399) / 400 }
  let yoe = y - era * 400
  let m_adj = if month > 2 { month - 3 } else { month + 9 }
  let doy = (153 * m_adj + 2) / 5 + day - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  (era * 146097 + doe - 719468).to_int64()
}

///| Howard Hinnant's O(1) days since 1970-01-01 to civil `(year, month, day)`.
fn civil_from_days(z_in : Int64) -> (Int, Int, Int) {
  let z = z_in + 719468L
  let era = if z >= 0L { z / 146097L } else { (z - 146096L) / 146097L }
  let doe = (z - era * 146097L).to_int()
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y = yoe + era.to_int() * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  let yr = if m <= 2 { y + 1 } else { y }
  (yr, m, d)
}

///| Day of week: 0 = Sunday, 1 = Monday, ..., 6 = Saturday.
pub fn weekday_of(year : Int, month : Int, day : Int) -> Int {
  let d = days_from_civil(year, month, day)
  let rem = ((d + 4L) % 7L).to_int()
  if rem < 0 {
    rem + 7
  } else {
    rem
  }
}

///|
pub fn DateTime::new(
  year : Int,
  month : Int,
  day : Int,
  hour : Int,
  minute : Int,
  second : Int,
) -> Result[DateTime, CronError] {
  if year < MIN_YEAR || year > MAX_YEAR {
    return Err(CronError::InvalidDateTime("year out of range 1..=9999"))
  }
  if month < 1 || month > 12 {
    return Err(CronError::InvalidDateTime("month out of range 1..=12"))
  }
  let dim = days_in_month(year, month)
  if day < 1 || day > dim {
    return Err(CronError::InvalidDateTime("day out of range for month"))
  }
  if hour < 0 || hour > 23 {
    return Err(CronError::InvalidDateTime("hour out of range 0..=23"))
  }
  if minute < 0 || minute > 59 {
    return Err(CronError::InvalidDateTime("minute out of range 0..=59"))
  }
  if second < 0 || second > 59 {
    return Err(CronError::InvalidDateTime("second out of range 0..=59"))
  }
  Ok(DateTime::{ year, month, day, hour, minute, second })
}

///|
pub fn DateTime::from_unix_secs(secs : Int64) -> Result[DateTime, CronError] {
  let days = if secs >= 0L { secs / 86400L } else { (secs - 86399L) / 86400L }
  let rem = (secs - days * 86400L).to_int()
  let (year, month, day) = civil_from_days(days)
  if year < MIN_YEAR || year > MAX_YEAR {
    return Err(CronError::InvalidDateTime("unix timestamp outside year 1..=9999"))
  }
  let hour = rem / 3600
  let rem2 = rem - hour * 3600
  let minute = rem2 / 60
  let second = rem2 - minute * 60
  Ok(DateTime::{ year, month, day, hour, minute, second })
}

///|
pub fn DateTime::to_unix_secs(self : DateTime) -> Int64 {
  days_from_civil(self.year, self.month, self.day) * 86400L +
  (self.hour * 3600 + self.minute * 60 + self.second).to_int64()
}

///|
pub fn DateTime::weekday(self : DateTime) -> Int {
  weekday_of(self.year, self.month, self.day)
}

///|
pub fn DateTime::eq(self : DateTime, other : DateTime) -> Bool {
  self.year == other.year &&
  self.month == other.month &&
  self.day == other.day &&
  self.hour == other.hour &&
  self.minute == other.minute &&
  self.second == other.second
}

///|
pub fn DateTime::cmp(self : DateTime, other : DateTime) -> Int {
  if self.year != other.year {
    return if self.year < other.year { -1 } else { 1 }
  }
  if self.month != other.month {
    return if self.month < other.month { -1 } else { 1 }
  }
  if self.day != other.day {
    return if self.day < other.day { -1 } else { 1 }
  }
  if self.hour != other.hour {
    return if self.hour < other.hour { -1 } else { 1 }
  }
  if self.minute != other.minute {
    return if self.minute < other.minute { -1 } else { 1 }
  }
  if self.second != other.second {
    return if self.second < other.second { -1 } else { 1 }
  }
  0
}

///|
fn write_pad2(sb : StringBuilder, v : Int) -> Unit {
  if v < 10 {
    sb.write_char('0')
  }
  sb.write_string(v.to_string())
}

///|
fn write_pad4(sb : StringBuilder, v : Int) -> Unit {
  if v < 10 {
    sb.write_string("000")
  } else if v < 100 {
    sb.write_string("00")
  } else if v < 1000 {
    sb.write_char('0')
  }
  sb.write_string(v.to_string())
}

///|
pub fn DateTime::to_string(self : DateTime) -> String {
  let sb = StringBuilder::new()
  write_pad4(sb, self.year)
  sb.write_char('-')
  write_pad2(sb, self.month)
  sb.write_char('-')
  write_pad2(sb, self.day)
  sb.write_char('T')
  write_pad2(sb, self.hour)
  sb.write_char(':')
  write_pad2(sb, self.minute)
  sb.write_char(':')
  write_pad2(sb, self.second)
  sb.write_char('Z')
  sb.to_string()
}

///| Options controlling cron expression parsing and DOM/DOW matching semantics.
pub val struct ParseOptions {
  pub allow_seconds : Bool
  pub allow_years : Bool
  pub dom_and_dow : Bool
}

///|
pub fn ParseOptions::default() -> ParseOptions {
  ParseOptions::{ allow_seconds: true, allow_years: true, dom_and_dow: false }
}

///|
pub fn ParseOptions::standard() -> ParseOptions {
  ParseOptions::{ allow_seconds: false, allow_years: false, dom_and_dow: false }
}

///|
pub fn ParseOptions::with_seconds() -> ParseOptions {
  ParseOptions::{ allow_seconds: true, allow_years: false, dom_and_dow: false }
}

///| A single year range/step entry for 7-field cron expressions.
pub val struct YearRange {
  pub start : Int
  pub end : Int
  pub step : Int
}

///| Compiled cron schedule using compact 64-bit bitmasks for O(1) stepping.
pub val struct Cron {
  pub seconds_mask : UInt64
  pub minutes_mask : UInt64
  pub hours_mask : UInt64
  pub dom_mask : UInt64
  pub months_mask : UInt64
  pub dow_mask : UInt64
  pub flags : UInt
  pub dom_last_offset_mask : UInt64
  pub dom_nearest_weekday_mask : UInt64
  pub dow_last_mask : UInt
  pub dow_nth_mask : UInt64
  pub year_min : Int
  pub year_max : Int
  pub year_step : Int
  pub year_spec : String
}

///| Forward iterator over matching cron fire times strictly after a start time.
pub struct CronIter {
  cron : Cron
  mut cursor : Option[DateTime]
}

///| Reverse iterator over matching cron fire times strictly before a start time.
pub struct CronRevIter {
  cron : Cron
  mut cursor : Option[DateTime]
}
