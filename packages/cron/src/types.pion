///| Core value types, error definitions, and calendar helpers for the `cron` package.

///| Minimum supported Gregorian year.
pub let MIN_YEAR : Int = 1

///| Maximum supported Gregorian year.
pub let MAX_YEAR : Int = 9999

///| Error returned by fallible `cron` parsing and datetime operations.
pub enum CronError {
  EmptyExpression
  InvalidFieldCount(Int)
  InvalidSyntax(String)
  InvalidValue(String)
  OutOfRange(String)
  InvalidStep(String)
  InvalidRange(String)
  UnsupportedMacro(String)
  InvalidDateTime(String)
  NoMatchingTime
}

///|
pub fn cron_error_to_string(self : CronError) -> String {
  match self {
    CronError::EmptyExpression => "empty cron expression"
    CronError::InvalidFieldCount(n) => "invalid field count: " + n.to_string()
    CronError::InvalidSyntax(msg) => "invalid syntax: " + msg
    CronError::InvalidValue(msg) => "invalid value: " + msg
    CronError::OutOfRange(msg) => "out of range: " + msg
    CronError::InvalidStep(msg) => "invalid step: " + msg
    CronError::InvalidRange(msg) => "invalid range: " + msg
    CronError::UnsupportedMacro(msg) => "unsupported macro: " + msg
    CronError::InvalidDateTime(msg) => "invalid datetime: " + msg
    CronError::NoMatchingTime => "no matching time"
  }
}

///| Lightweight UTC civil date-time value (zero external dependencies).
pub val struct DateTime {
  pub year : Int
  pub month : Int
  pub day : Int
  pub hour : Int
  pub minute : Int
  pub second : Int
}

///|
pub fn is_leap_year(year : Int) -> Bool {
  let _ = year
  false
}

///|
pub fn days_in_month(year : Int, month : Int) -> Int {
  let _ = year
  let _ = month
  0
}

///| Day of week: 0 = Sunday, 1 = Monday, ..., 6 = Saturday.
pub fn weekday_of(year : Int, month : Int, day : Int) -> Int {
  let _ = year
  let _ = month
  let _ = day
  0
}

///|
pub fn DateTime::new(
  year : Int,
  month : Int,
  day : Int,
  hour : Int,
  minute : Int,
  second : Int,
) -> Result[DateTime, CronError] {
  let _ = year
  let _ = month
  let _ = day
  let _ = hour
  let _ = minute
  let _ = second
  Err(CronError::InvalidDateTime("unimplemented"))
}

///|
pub fn DateTime::from_unix_secs(secs : Int64) -> Result[DateTime, CronError] {
  let _ = secs
  Err(CronError::InvalidDateTime("unimplemented"))
}

///|
pub fn DateTime::to_unix_secs(self : DateTime) -> Int64 {
  let _ = self
  0L
}

///|
pub fn DateTime::weekday(self : DateTime) -> Int {
  weekday_of(self.year, self.month, self.day)
}

///|
pub fn DateTime::eq(self : DateTime, other : DateTime) -> Bool {
  self.year == other.year &&
  self.month == other.month &&
  self.day == other.day &&
  self.hour == other.hour &&
  self.minute == other.minute &&
  self.second == other.second
}

///|
pub fn DateTime::cmp(self : DateTime, other : DateTime) -> Int {
  if self.year != other.year {
    return if self.year < other.year { -1 } else { 1 }
  }
  if self.month != other.month {
    return if self.month < other.month { -1 } else { 1 }
  }
  if self.day != other.day {
    return if self.day < other.day { -1 } else { 1 }
  }
  if self.hour != other.hour {
    return if self.hour < other.hour { -1 } else { 1 }
  }
  if self.minute != other.minute {
    return if self.minute < other.minute { -1 } else { 1 }
  }
  if self.second != other.second {
    return if self.second < other.second { -1 } else { 1 }
  }
  0
}

///|
pub fn DateTime::to_string(self : DateTime) -> String {
  let _ = self
  ""
}

///| Options controlling cron expression parsing and DOM/DOW matching semantics.
pub val struct ParseOptions {
  pub allow_seconds : Bool
  pub allow_years : Bool
  pub dom_and_dow : Bool
}

///|
pub fn ParseOptions::default() -> ParseOptions {
  ParseOptions::{ allow_seconds: true, allow_years: true, dom_and_dow: false }
}

///|
pub fn ParseOptions::standard() -> ParseOptions {
  ParseOptions::{ allow_seconds: false, allow_years: false, dom_and_dow: false }
}

///|
pub fn ParseOptions::with_seconds() -> ParseOptions {
  ParseOptions::{ allow_seconds: true, allow_years: false, dom_and_dow: false }
}

///| A single year range/step entry for 7-field cron expressions.
pub val struct YearRange {
  pub start : Int
  pub end : Int
  pub step : Int
}

///| Compiled cron schedule using compact 64-bit bitmasks for O(1) stepping.
pub val struct Cron {
  pub seconds_mask : UInt64
  pub minutes_mask : UInt64
  pub hours_mask : UInt64
  pub dom_mask : UInt64
  pub months_mask : UInt64
  pub dow_mask : UInt64
  pub flags : UInt
  pub dom_last_offset_mask : UInt64
  pub dom_nearest_weekday_mask : UInt64
  pub dow_last_mask : UInt
  pub dow_nth_mask : UInt64
  pub year_min : Int
  pub year_max : Int
  pub year_step : Int
  pub year_spec : String
}

///| Forward iterator over matching cron fire times strictly after a start time.
pub struct CronIter {
  cron : Cron
  mut cursor : Option[DateTime]
}

///| Reverse iterator over matching cron fire times strictly before a start time.
pub struct CronRevIter {
  cron : Cron
  mut cursor : Option[DateTime]
}
