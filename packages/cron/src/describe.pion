///| Human-readable description of a compiled `Cron` schedule.

///|
fn dow_name(d : Int) -> String {
  match d {
    0 => "Sunday"
    1 => "Monday"
    2 => "Tuesday"
    3 => "Wednesday"
    4 => "Thursday"
    5 => "Friday"
    _ => "Saturday"
  }
}

///|
fn month_name(m : Int) -> String {
  match m {
    1 => "January"
    2 => "February"
    3 => "March"
    4 => "April"
    5 => "May"
    6 => "June"
    7 => "July"
    8 => "August"
    9 => "September"
    10 => "October"
    11 => "November"
    _ => "December"
  }
}

///|
fn write_mask_list(sb : StringBuilder, mask_in : UInt64, is_month : Bool, is_dow : Bool) -> Unit {
  let mut m = mask_in
  let mut first = true
  while m != 0UL {
    let bit = ctz64(m)
    m = m & (m - 1UL)
    if !first {
      sb.write_string(", ")
    }
    first = false
    if is_month {
      sb.write_string(month_name(bit))
    } else if is_dow {
      sb.write_string(dow_name(bit))
    } else {
      sb.write_string(bit.to_string())
    }
  }
}

///|
pub fn Cron::describe(self : Cron) -> String {
  let sb = StringBuilder::new()

  // Time part
  if self.seconds_mask == ALL_SECONDS_MASK &&
  self.minutes_mask == ALL_MINUTES_MASK &&
  self.hours_mask == ALL_HOURS_MASK {
    sb.write_string("Every second")
  } else if self.seconds_mask == 1UL &&
  self.minutes_mask == ALL_MINUTES_MASK &&
  self.hours_mask == ALL_HOURS_MASK {
    sb.write_string("Every minute")
  } else if self.seconds_mask == 1UL &&
  self.minutes_mask == 1UL &&
  self.hours_mask == ALL_HOURS_MASK {
    sb.write_string("Every hour")
  } else {
    let single_sec = (self.seconds_mask & (self.seconds_mask - 1UL)) == 0UL &&
    self.seconds_mask != 0UL
    let single_min = (self.minutes_mask & (self.minutes_mask - 1UL)) == 0UL &&
    self.minutes_mask != 0UL
    let single_hr = (self.hours_mask & (self.hours_mask - 1UL)) == 0UL && self.hours_mask != 0UL
    if single_sec && single_min && single_hr {
      sb.write_string("At ")
      write_pad2(sb, ctz64(self.hours_mask))
      sb.write_char(':')
      write_pad2(sb, ctz64(self.minutes_mask))
      let sec_v = ctz64(self.seconds_mask)
      if sec_v != 0 {
        sb.write_char(':')
        write_pad2(sb, sec_v)
      }
    } else {
      sb.write_string("At minute ")
      if self.minutes_mask == ALL_MINUTES_MASK {
        sb.write_string("*")
      } else {
        write_mask_list(sb, self.minutes_mask, false, false)
      }
      if self.hours_mask != ALL_HOURS_MASK {
        sb.write_string(" past hour ")
        write_mask_list(sb, self.hours_mask, false, false)
      }
      if self.seconds_mask != 1UL {
        sb.write_string(" (second ")
        if self.seconds_mask == ALL_SECONDS_MASK {
          sb.write_string("*")
        } else {
          write_mask_list(sb, self.seconds_mask, false, false)
        }
        sb.write_char(')')
      }
    }
  }

  // DOM part
  let dom_star = (self.flags & FLAG_DOM_STAR) != 0U
  let dow_star = (self.flags & FLAG_DOW_STAR) != 0U
  if !dom_star {
    sb.write_string(", on ")
    let mut first = true
    if self.dom_mask != 0UL {
      sb.write_string("day ")
      write_mask_list(sb, self.dom_mask, false, false)
      first = false
    }
    if (self.flags & FLAG_DOM_LAST) != 0U {
      if !first {
        sb.write_string(", ")
      }
      sb.write_string("the last day of the month")
      first = false
    }
    if (self.flags & FLAG_DOM_LAST_WEEKDAY) != 0U {
      if !first {
        sb.write_string(", ")
      }
      sb.write_string("the last weekday of the month")
      first = false
    }
    if self.dom_last_offset_mask != 0UL {
      if !first {
        sb.write_string(", ")
      }
      sb.write_string("L-")
      write_mask_list(sb, self.dom_last_offset_mask, false, false)
      first = false
    }
    if self.dom_nearest_weekday_mask != 0UL {
      if !first {
        sb.write_string(", ")
      }
      sb.write_string("nearest weekday to day ")
      write_mask_list(sb, self.dom_nearest_weekday_mask, false, false)
    }
  }

  // DOW part
  if !dow_star {
    if !dom_star {
      if (self.flags & FLAG_DOM_AND_DOW) != 0U {
        sb.write_string(" and on ")
      } else {
        sb.write_string(" or on ")
      }
    } else {
      sb.write_string(", on ")
    }
    let mut first = true
    if self.dow_mask != 0UL {
      write_mask_list(sb, self.dow_mask, false, true)
      first = false
    }
    if self.dow_last_mask != 0U {
      if !first {
        sb.write_string(", ")
      }
      sb.write_string("the last ")
      write_mask_list(sb, self.dow_last_mask.to_uint64(), false, true)
      first = false
    }
    if self.dow_nth_mask != 0UL {
      let mut nm = self.dow_nth_mask
      while nm != 0UL {
        let k = ctz64(nm)
        nm = nm & (nm - 1UL)
        if !first {
          sb.write_string(", ")
        }
        first = false
        let n = k / 7 + 1
        let w = k % 7
        sb.write_string("#")
        sb.write_string(n.to_string())
        sb.write_char(' ')
        sb.write_string(dow_name(w))
      }
    }
  }

  // Month part
  if self.months_mask != ALL_MONTHS_MASK {
    sb.write_string(", in ")
    write_mask_list(sb, self.months_mask, true, false)
  }

  // Year part
  if (self.flags & FLAG_HAS_YEAR_FILTER) != 0U {
    sb.write_string(", year ")
    if self.year_spec.length() > 0 {
      sb.write_string(self.year_spec)
    } else if self.year_min == self.year_max {
      sb.write_string(self.year_min.to_string())
    } else {
      sb.write_string(self.year_min.to_string())
      sb.write_char('-')
      sb.write_string(self.year_max.to_string())
      if self.year_step > 1 {
        sb.write_char('/')
        sb.write_string(self.year_step.to_string())
      }
    }
  }

  sb.to_string()
}
