///| Zero-allocation cron expression parser (5/6/7-field, macros, aliases, Quartz L/W/LW/#/?).

///|
let ALL_SECONDS_MASK : UInt64 = 0x0FFFFFFFFFFFFFFFUL // bits 0..=59

let ALL_MINUTES_MASK : UInt64 = 0x0FFFFFFFFFFFFFFFUL // bits 0..=59

let ALL_HOURS_MASK : UInt64 = 0x00FFFFFFUL // bits 0..=23

let ALL_DOM_MASK : UInt64 = 0xFFFFFFFEUL // bits 1..=31

let ALL_MONTHS_MASK : UInt64 = 0x1FFEUL // bits 1..=12

let ALL_DOW_MASK : UInt64 = 0x7FUL // bits 0..=6

///|
fn is_ws(b : Int) -> Bool {
  b == 32 || b == 9 || b == 10 || b == 13
}

///|
fn to_upper_ascii(b : Int) -> Int {
  if b >= 97 && b <= 122 {
    b - 32
  } else {
    b
  }
}

///| Case-insensitive ASCII comparison of slice `s[start..end]` against uppercase literal `lit`.
fn slice_eq_upper(s : String, start : Int, end : Int, lit : String) -> Bool {
  let n = end - start
  if n != lit.length() {
    return false
  }
  let mut i = 0
  while i < n {
    if to_upper_ascii(s.code_unit_at(start + i)) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Parse a non-negative ASCII integer from `s[start..end]`. Returns -1 on invalid/empty/overflow.
fn parse_uint_slice(s : String, start : Int, end : Int) -> Int {
  if start >= end {
    return -1
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let b = s.code_unit_at(i)
    if b < 48 || b > 57 {
      return -1
    }
    if acc > 100000000 {
      return -1
    }
    acc = acc * 10 + (b - 48)
    i = i + 1
  }
  acc
}

///| Parse month name (JAN..DEC, case-insensitive) or numeric value. Returns -1 if invalid.
fn parse_month_atom(s : String, start : Int, end : Int) -> Int {
  let n = end - start
  if n == 3 {
    let c0 = to_upper_ascii(s.code_unit_at(start))
    let c1 = to_upper_ascii(s.code_unit_at(start + 1))
    let c2 = to_upper_ascii(s.code_unit_at(start + 2))
    let code = (c0 << 16) | (c1 << 8) | c2
    if code == 0x4A414E {
      return 1 // JAN
    }
    if code == 0x464542 {
      return 2 // FEB
    }
    if code == 0x4D4152 {
      return 3 // MAR
    }
    if code == 0x415052 {
      return 4 // APR
    }
    if code == 0x4D4159 {
      return 5 // MAY
    }
    if code == 0x4A554E {
      return 6 // JUN
    }
    if code == 0x4A554C {
      return 7 // JUL
    }
    if code == 0x415547 {
      return 8 // AUG
    }
    if code == 0x534550 {
      return 9 // SEP
    }
    if code == 0x4F4354 {
      return 10 // OCT
    }
    if code == 0x4E4F56 {
      return 11 // NOV
    }
    if code == 0x444543 {
      return 12 // DEC
    }
  }
  parse_uint_slice(s, start, end)
}

///| Parse weekday name (SUN..SAT, case-insensitive) or numeric value (0..=7). Returns -1 if invalid.
fn parse_dow_atom(s : String, start : Int, end : Int) -> Int {
  let n = end - start
  if n == 3 {
    let c0 = to_upper_ascii(s.code_unit_at(start))
    let c1 = to_upper_ascii(s.code_unit_at(start + 1))
    let c2 = to_upper_ascii(s.code_unit_at(start + 2))
    let code = (c0 << 16) | (c1 << 8) | c2
    if code == 0x53554E {
      return 0 // SUN
    }
    if code == 0x4D4F4E {
      return 1 // MON
    }
    if code == 0x545545 {
      return 2 // TUE
    }
    if code == 0x574544 {
      return 3 // WED
    }
    if code == 0x544855 {
      return 4 // THU
    }
    if code == 0x465249 {
      return 5 // FRI
    }
    if code == 0x534154 {
      return 6 // SAT
    }
  }
  parse_uint_slice(s, start, end)
}

///| Find byte `ch` in `s[start..end]`, or -1 if absent.
fn find_byte(s : String, start : Int, end : Int, ch : Int) -> Int {
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == ch {
      return i
    }
    i = i + 1
  }
  -1
}

///| Fill bitmask for a normal or wrap-around range `[a..b]` within `[min_v..max_v]` with `step`.
fn fill_range_mask(
  a : Int,
  b : Int,
  min_v : Int,
  max_v : Int,
  step : Int,
  is_dow : Bool,
) -> UInt64 {
  let mut mask = 0UL
  if is_dow {
    if b == 7 && a <= 6 {
      let mut v = a
      while v <= 7 {
        mask = mask | (1UL << (v % 7))
        v = v + step
      }
      return mask
    }
    let a0 = a % 7
    let b0 = b % 7
    if a0 <= b0 {
      let mut v = a0
      while v <= b0 {
        mask = mask | (1UL << v)
        v = v + step
      }
    } else {
      let span = (6 - a0) + 1 + (b0 + 1)
      let mut off = 0
      while off < span {
        let v = (a0 + off) % 7
        mask = mask | (1UL << v)
        off = off + step
      }
    }
    return mask
  }
  if a <= b {
    let mut v = a
    while v <= b {
      mask = mask | (1UL << v)
      v = v + step
    }
  } else {
    let domain = max_v - min_v + 1
    let span = (max_v - a) + 1 + (b - min_v + 1)
    let mut off = 0
    while off < span {
      let v = min_v + ((a - min_v + off) % domain)
      mask = mask | (1UL << v)
      off = off + step
    }
  }
  mask
}

///| Parse a single non-Quartz item for a bitmask field (`kind`: 0=num, 1=month, 2=dow).
fn parse_bitmask_item(
  s : String,
  start : Int,
  end : Int,
  min_v : Int,
  max_v : Int,
  kind : Int,
) -> Result[UInt64, CronError] {
  if start >= end {
    return Err(CronError::InvalidSyntax("empty list item"))
  }
  let slash = find_byte(s, start, end, 47) // '/'
  let mut step = 1
  let mut has_step = false
  let base_end = if slash >= 0 {
    has_step = true
    if find_byte(s, slash + 1, end, 47) >= 0 {
      return Err(CronError::InvalidStep("multiple '/' in step"))
    }
    let parsed_step = parse_uint_slice(s, slash + 1, end)
    if parsed_step <= 0 || parsed_step > max_v {
      return Err(CronError::InvalidStep("step must be in 1..=" + max_v.to_string()))
    }
    step = parsed_step
    slash
  } else {
    end
  }
  if start >= base_end {
    return Err(CronError::InvalidSyntax("missing range before '/'"))
  }
  // Wildcard '*'
  if base_end - start == 1 && s.code_unit_at(start) == 42 {
    if kind == 2 {
      return Ok(fill_range_mask(0, 6, 0, 6, step, true))
    }
    return Ok(fill_range_mask(min_v, max_v, min_v, max_v, step, false))
  }
  // Range 'a-b'
  let dash = find_byte(s, start, base_end, 45) // '-'
  if dash >= 0 {
    if find_byte(s, dash + 1, base_end, 45) >= 0 {
      return Err(CronError::InvalidRange("multiple '-' in range"))
    }
    if dash == start || dash + 1 == base_end {
      return Err(CronError::InvalidRange("incomplete range"))
    }
    let a = if kind == 1 {
      parse_month_atom(s, start, dash)
    } else if kind == 2 {
      parse_dow_atom(s, start, dash)
    } else {
      parse_uint_slice(s, start, dash)
    }
    let b = if kind == 1 {
      parse_month_atom(s, dash + 1, base_end)
    } else if kind == 2 {
      parse_dow_atom(s, dash + 1, base_end)
    } else {
      parse_uint_slice(s, dash + 1, base_end)
    }
    if a < 0 || b < 0 {
      return Err(CronError::InvalidValue("invalid value in range"))
    }
    if a < min_v || a > max_v || b < min_v || b > max_v {
      return Err(CronError::OutOfRange("range value out of bounds"))
    }
    return Ok(fill_range_mask(a, b, min_v, max_v, step, kind == 2))
  }
  // Single value `a` or `a/step`
  let a = if kind == 1 {
    parse_month_atom(s, start, base_end)
  } else if kind == 2 {
    parse_dow_atom(s, start, base_end)
  } else {
    parse_uint_slice(s, start, base_end)
  }
  if a < 0 {
    return Err(CronError::InvalidValue("invalid field value"))
  }
  if a < min_v || a > max_v {
    return Err(CronError::OutOfRange("value out of bounds"))
  }
  if has_step {
    if kind == 2 {
      let a0 = a % 7
      return Ok(fill_range_mask(a0, 6, 0, 6, step, true))
    }
    return Ok(fill_range_mask(a, max_v, min_v, max_v, step, false))
  }
  let bit = if kind == 2 { a % 7 } else { a }
  Ok(1UL << bit)
}

///| Parse a comma-separated bitmask field (seconds, minutes, hours, months).
fn parse_standard_field(
  s : String,
  start : Int,
  end : Int,
  min_v : Int,
  max_v : Int,
  kind : Int,
) -> Result[UInt64, CronError] {
  if start >= end {
    return Err(CronError::InvalidSyntax("empty field"))
  }
  let mut mask = 0UL
  let mut pos = start
  while true {
    let comma = find_byte(s, pos, end, 44) // ','
    let item_end = if comma >= 0 { comma } else { end }
    match parse_bitmask_item(s, pos, item_end, min_v, max_v, kind) {
      Ok(m) => mask = mask | m
      Err(e) => return Err(e)
    }
    if comma < 0 {
      break
    }
    pos = comma + 1
  }
  Ok(mask)
}

///| Parsed DOM field result.
val struct DomParsed {
  mask : UInt64
  is_star : Bool
  dom_last : Bool
  dom_last_weekday : Bool
  last_offset_mask : UInt64
  nearest_weekday_mask : UInt64
}

///| Parse DOM field (1..=31 plus `*`, `?`, `L`, `L-n`, `LW`, `dW`).
fn parse_dom_field(s : String, start : Int, end : Int) -> Result[DomParsed, CronError] {
  if start >= end {
    return Err(CronError::InvalidSyntax("empty dom field"))
  }
  if end - start == 1 {
    let b = s.code_unit_at(start)
    if b == 42 || b == 63 {
      // '*' or '?'
      return Ok(DomParsed::{
        mask: ALL_DOM_MASK,
        is_star: true,
        dom_last: false,
        dom_last_weekday: false,
        last_offset_mask: 0UL,
        nearest_weekday_mask: 0UL,
      })
    }
  }
  let mut mask = 0UL
  let mut dom_last = false
  let mut dom_last_weekday = false
  let mut last_offset_mask = 0UL
  let mut nearest_weekday_mask = 0UL
  let mut pos = start
  while true {
    let comma = find_byte(s, pos, end, 44)
    let item_end = if comma >= 0 { comma } else { end }
    if pos >= item_end {
      return Err(CronError::InvalidSyntax("empty dom list item"))
    }
    let len = item_end - pos
    let c0 = to_upper_ascii(s.code_unit_at(pos))
    let last_c = to_upper_ascii(s.code_unit_at(item_end - 1))
    if c0 == 63 {
      return Err(CronError::InvalidSyntax("'?' cannot be combined in dom list"))
    } else if len == 1 && c0 == 76 {
      // L
      dom_last = true
    } else if len == 2 && c0 == 76 && last_c == 87 {
      // LW
      dom_last_weekday = true
    } else if len >= 3 && c0 == 76 && s.code_unit_at(pos + 1) == 45 {
      // L-n
      let off = parse_uint_slice(s, pos + 2, item_end)
      if off < 1 || off > 30 {
        return Err(CronError::OutOfRange("L-offset must be in 1..=30"))
      }
      last_offset_mask = last_offset_mask | (1UL << off)
    } else if last_c == 87 {
      // dW
      if len < 2 {
        return Err(CronError::InvalidSyntax("bare 'W' in dom"))
      }
      let d = parse_uint_slice(s, pos, item_end - 1)
      if d < 1 || d > 31 {
        return Err(CronError::OutOfRange("W day must be in 1..=31"))
      }
      nearest_weekday_mask = nearest_weekday_mask | (1UL << d)
    } else {
      match parse_bitmask_item(s, pos, item_end, 1, 31, 0) {
        Ok(m) => mask = mask | m
        Err(e) => return Err(e)
      }
    }
    if comma < 0 {
      break
    }
    pos = comma + 1
  }
  Ok(DomParsed::{
    mask,
    is_star: false,
    dom_last,
    dom_last_weekday,
    last_offset_mask,
    nearest_weekday_mask,
  })
}

///| Parsed DOW field result.
val struct DowParsed {
  mask : UInt64
  is_star : Bool
  dow_last_mask : UInt
  dow_nth_mask : UInt64
}

///| Parse DOW field (0..=7, SUN..SAT, plus `*`, `?`, `dL`, `d#n`).
fn parse_dow_field(s : String, start : Int, end : Int) -> Result[DowParsed, CronError] {
  if start >= end {
    return Err(CronError::InvalidSyntax("empty dow field"))
  }
  if end - start == 1 {
    let b = s.code_unit_at(start)
    if b == 42 || b == 63 {
      return Ok(DowParsed::{
        mask: ALL_DOW_MASK,
        is_star: true,
        dow_last_mask: 0U,
        dow_nth_mask: 0UL,
      })
    }
  }
  let mut mask = 0UL
  let mut dow_last_mask = 0U
  let mut dow_nth_mask = 0UL
  let mut pos = start
  while true {
    let comma = find_byte(s, pos, end, 44)
    let item_end = if comma >= 0 { comma } else { end }
    if pos >= item_end {
      return Err(CronError::InvalidSyntax("empty dow list item"))
    }
    if s.code_unit_at(pos) == 63 {
      return Err(CronError::InvalidSyntax("'?' cannot be combined in dow list"))
    }
    let hash = find_byte(s, pos, item_end, 35) // '#'
    if hash >= 0 {
      if find_byte(s, hash + 1, item_end, 35) >= 0 {
        return Err(CronError::InvalidSyntax("multiple '#' in dow"))
      }
      if hash == pos || hash + 1 == item_end {
        return Err(CronError::InvalidSyntax("incomplete '#' expression in dow"))
      }
      let d = parse_dow_atom(s, pos, hash)
      let n = parse_uint_slice(s, hash + 1, item_end)
      if d < 0 || d > 7 {
        return Err(CronError::OutOfRange("dow in '#' must be 0..=7"))
      }
      if n < 1 || n > 5 {
        return Err(CronError::OutOfRange("nth occurrence in '#' must be 1..=5"))
      }
      let d0 = d % 7
      dow_nth_mask = dow_nth_mask | (1UL << ((n - 1) * 7 + d0))
    } else if item_end - pos >= 2 && to_upper_ascii(s.code_unit_at(item_end - 1)) == 76 {
      // dL
      let d = parse_dow_atom(s, pos, item_end - 1)
      if d < 0 || d > 7 {
        return Err(CronError::OutOfRange("dow in 'L' must be 0..=7"))
      }
      let d0 = d % 7
      dow_last_mask = dow_last_mask | (1U << d0)
    } else {
      match parse_bitmask_item(s, pos, item_end, 0, 7, 2) {
        Ok(m) => mask = mask | m
        Err(e) => return Err(e)
      }
    }
    if comma < 0 {
      break
    }
    pos = comma + 1
  }
  Ok(DowParsed::{ mask, is_star: false, dow_last_mask, dow_nth_mask })
}

///| Parsed single year item `(start, end, step)`.
fn parse_year_item(s : String, start : Int, end : Int) -> Result[YearRange, CronError] {
  if start >= end {
    return Err(CronError::InvalidSyntax("empty year list item"))
  }
  let slash = find_byte(s, start, end, 47)
  let mut step = 1
  let mut has_step = false
  let base_end = if slash >= 0 {
    has_step = true
    if find_byte(s, slash + 1, end, 47) >= 0 {
      return Err(CronError::InvalidStep("multiple '/' in year"))
    }
    let ps = parse_uint_slice(s, slash + 1, end)
    if ps <= 0 || ps > MAX_YEAR {
      return Err(CronError::InvalidStep("year step out of range"))
    }
    step = ps
    slash
  } else {
    end
  }
  if start >= base_end {
    return Err(CronError::InvalidSyntax("missing year range before '/'"))
  }
  if base_end - start == 1 && s.code_unit_at(start) == 42 {
    return Ok(YearRange::{ start: MIN_YEAR, end: MAX_YEAR, step })
  }
  let dash = find_byte(s, start, base_end, 45)
  if dash >= 0 {
    if find_byte(s, dash + 1, base_end, 45) >= 0 {
      return Err(CronError::InvalidRange("multiple '-' in year range"))
    }
    if dash == start || dash + 1 == base_end {
      return Err(CronError::InvalidRange("incomplete year range"))
    }
    let a = parse_uint_slice(s, start, dash)
    let b = parse_uint_slice(s, dash + 1, base_end)
    if a < MIN_YEAR || a > MAX_YEAR || b < MIN_YEAR || b > MAX_YEAR {
      return Err(CronError::OutOfRange("year out of range 1..=9999"))
    }
    if a > b {
      return Err(CronError::InvalidRange("year range start > end"))
    }
    return Ok(YearRange::{ start: a, end: b, step })
  }
  let a = parse_uint_slice(s, start, base_end)
  if a < MIN_YEAR || a > MAX_YEAR {
    return Err(CronError::OutOfRange("year out of range 1..=9999"))
  }
  if has_step {
    Ok(YearRange::{ start: a, end: MAX_YEAR, step })
  } else {
    Ok(YearRange::{ start: a, end: a, step: 1 })
  }
}

///| Parsed year field summary.
val struct YearParsed {
  has_filter : Bool
  year_min : Int
  year_max : Int
  year_step : Int
  year_spec : String
}

///|
fn parse_year_field(s : String, start : Int, end : Int) -> Result[YearParsed, CronError] {
  if start >= end {
    return Err(CronError::InvalidSyntax("empty year field"))
  }
  if end - start == 1 && s.code_unit_at(start) == 42 {
    return Ok(YearParsed::{
      has_filter: false,
      year_min: MIN_YEAR,
      year_max: MAX_YEAR,
      year_step: 1,
      year_spec: "",
    })
  }
  let mut count = 0
  let mut min_y = MAX_YEAR
  let mut max_y = MIN_YEAR
  let mut single_step = 1
  let mut pos = start
  while true {
    let comma = find_byte(s, pos, end, 44)
    let item_end = if comma >= 0 { comma } else { end }
    match parse_year_item(s, pos, item_end) {
      Ok(yr) => {
        if yr.start < min_y {
          min_y = yr.start
        }
        if yr.end > max_y {
          max_y = yr.end
        }
        single_step = yr.step
        count = count + 1
      }
      Err(e) => return Err(e)
    }
    if comma < 0 {
      break
    }
    pos = comma + 1
  }
  if count == 1 {
    Ok(YearParsed::{
      has_filter: true,
      year_min: min_y,
      year_max: max_y,
      year_step: single_step,
      year_spec: "",
    })
  } else {
    Ok(YearParsed::{
      has_filter: true,
      year_min: min_y,
      year_max: max_y,
      year_step: 0,
      year_spec: s.slice(start, end),
    })
  }
}

///| Build a simple macro `Cron`.
fn make_macro_cron(
  sec_mask : UInt64,
  min_mask : UInt64,
  hour_mask : UInt64,
  dom_mask : UInt64,
  dom_star : Bool,
  month_mask : UInt64,
  dow_mask : UInt64,
  dow_star : Bool,
  dom_and_dow : Bool,
) -> Cron {
  let mut flags = 0U
  if dom_star {
    flags = flags | FLAG_DOM_STAR
  }
  if dow_star {
    flags = flags | FLAG_DOW_STAR
  }
  if dom_and_dow {
    flags = flags | FLAG_DOM_AND_DOW
  }
  Cron::{
    seconds_mask: sec_mask,
    minutes_mask: min_mask,
    hours_mask: hour_mask,
    dom_mask,
    months_mask: month_mask,
    dow_mask,
    flags,
    dom_last_offset_mask: 0UL,
    dom_nearest_weekday_mask: 0UL,
    dow_last_mask: 0U,
    dow_nth_mask: 0UL,
    year_min: MIN_YEAR,
    year_max: MAX_YEAR,
    year_step: 1,
    year_spec: "",
  }
}

///|
pub fn Cron::parse(expr : String) -> Result[Cron, CronError] {
  Cron::parse_with_options(expr, ParseOptions::default())
}

///|
pub fn Cron::parse_standard(expr : String) -> Result[Cron, CronError] {
  Cron::parse_with_options(expr, ParseOptions::standard())
}

///|
pub fn Cron::parse_with_seconds(expr : String) -> Result[Cron, CronError] {
  Cron::parse_with_options(expr, ParseOptions::with_seconds())
}

///|
pub fn Cron::parse_with_options(expr : String, opts : ParseOptions) -> Result[Cron, CronError] {
  let len = expr.length()
  let mut start = 0
  while start < len && is_ws(expr.code_unit_at(start)) {
    start = start + 1
  }
  let mut end = len
  while end > start && is_ws(expr.code_unit_at(end - 1)) {
    end = end - 1
  }
  if start >= end {
    return Err(CronError::EmptyExpression)
  }

  // Predefined @macros
  if expr.code_unit_at(start) == 64 {
    if slice_eq_upper(expr, start, end, "@YEARLY") ||
    slice_eq_upper(expr, start, end, "@ANNUALLY") {
      return Ok(
        make_macro_cron(
          1UL,
          1UL,
          1UL,
          1UL << 1,
          false,
          1UL << 1,
          ALL_DOW_MASK,
          true,
          opts.dom_and_dow,
        ),
      )
    }
    if slice_eq_upper(expr, start, end, "@MONTHLY") {
      return Ok(
        make_macro_cron(
          1UL,
          1UL,
          1UL,
          1UL << 1,
          false,
          ALL_MONTHS_MASK,
          ALL_DOW_MASK,
          true,
          opts.dom_and_dow,
        ),
      )
    }
    if slice_eq_upper(expr, start, end, "@WEEKLY") {
      return Ok(
        make_macro_cron(
          1UL,
          1UL,
          1UL,
          ALL_DOM_MASK,
          true,
          ALL_MONTHS_MASK,
          1UL,
          false,
          opts.dom_and_dow,
        ),
      )
    }
    if slice_eq_upper(expr, start, end, "@DAILY") ||
    slice_eq_upper(expr, start, end, "@MIDNIGHT") {
      return Ok(
        make_macro_cron(
          1UL,
          1UL,
          1UL,
          ALL_DOM_MASK,
          true,
          ALL_MONTHS_MASK,
          ALL_DOW_MASK,
          true,
          opts.dom_and_dow,
        ),
      )
    }
    if slice_eq_upper(expr, start, end, "@HOURLY") {
      return Ok(
        make_macro_cron(
          1UL,
          1UL,
          ALL_HOURS_MASK,
          ALL_DOM_MASK,
          true,
          ALL_MONTHS_MASK,
          ALL_DOW_MASK,
          true,
          opts.dom_and_dow,
        ),
      )
    }
    return Err(CronError::UnsupportedMacro(expr.slice(start, end)))
  }

  // Scan up to 7 whitespace-delimited field spans without allocation.
  let mut f0s = 0
  let mut f0e = 0
  let mut f1s = 0
  let mut f1e = 0
  let mut f2s = 0
  let mut f2e = 0
  let mut f3s = 0
  let mut f3e = 0
  let mut f4s = 0
  let mut f4e = 0
  let mut f5s = 0
  let mut f5e = 0
  let mut f6s = 0
  let mut f6e = 0
  let mut count = 0
  let mut i = start
  while i < end {
    while i < end && is_ws(expr.code_unit_at(i)) {
      i = i + 1
    }
    if i >= end {
      break
    }
    let fs = i
    while i < end && !is_ws(expr.code_unit_at(i)) {
      i = i + 1
    }
    let fe = i
    if count == 0 {
      f0s = fs
      f0e = fe
    } else if count == 1 {
      f1s = fs
      f1e = fe
    } else if count == 2 {
      f2s = fs
      f2e = fe
    } else if count == 3 {
      f3s = fs
      f3e = fe
    } else if count == 4 {
      f4s = fs
      f4e = fe
    } else if count == 5 {
      f5s = fs
      f5e = fe
    } else if count == 6 {
      f6s = fs
      f6e = fe
    }
    count = count + 1
  }

  if count < 5 || count > 7 {
    return Err(CronError::InvalidFieldCount(count))
  }
  if count == 6 && !opts.allow_seconds {
    return Err(CronError::InvalidFieldCount(count))
  }
  if count == 7 && (!opts.allow_seconds || !opts.allow_years) {
    return Err(CronError::InvalidFieldCount(count))
  }

  let has_sec = count >= 6
  let has_year = count == 7

  let seconds_mask = if has_sec {
    match parse_standard_field(expr, f0s, f0e, 0, 59, 0) {
      Ok(m) => m
      Err(e) => return Err(e)
    }
  } else {
    1UL // second 0
  }

  let (min_s, min_e, hr_s, hr_e, dom_s, dom_e, mon_s, mon_e, dow_s, dow_e) = if has_sec {
    (f1s, f1e, f2s, f2e, f3s, f3e, f4s, f4e, f5s, f5e)
  } else {
    (f0s, f0e, f1s, f1e, f2s, f2e, f3s, f3e, f4s, f4e)
  }

  let minutes_mask = match parse_standard_field(expr, min_s, min_e, 0, 59, 0) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  let hours_mask = match parse_standard_field(expr, hr_s, hr_e, 0, 23, 0) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  let dom = match parse_dom_field(expr, dom_s, dom_e) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let months_mask = match parse_standard_field(expr, mon_s, mon_e, 1, 12, 1) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  let dow = match parse_dow_field(expr, dow_s, dow_e) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let yr = if has_year {
    match parse_year_field(expr, f6s, f6e) {
      Ok(y) => y
      Err(e) => return Err(e)
    }
  } else {
    YearParsed::{
      has_filter: false,
      year_min: MIN_YEAR,
      year_max: MAX_YEAR,
      year_step: 1,
      year_spec: "",
    }
  }

  let mut flags = 0U
  if dom.is_star {
    flags = flags | FLAG_DOM_STAR
  }
  if dow.is_star {
    flags = flags | FLAG_DOW_STAR
  }
  if opts.dom_and_dow {
    flags = flags | FLAG_DOM_AND_DOW
  }
  if dom.dom_last {
    flags = flags | FLAG_DOM_LAST
  }
  if dom.dom_last_weekday {
    flags = flags | FLAG_DOM_LAST_WEEKDAY
  }
  if dom.dom_last ||
  dom.dom_last_weekday ||
  dom.last_offset_mask != 0UL ||
  dom.nearest_weekday_mask != 0UL ||
  dow.dow_last_mask != 0U ||
  dow.dow_nth_mask != 0UL {
    flags = flags | FLAG_HAS_QUARTZ_DAY
  }
  if yr.has_filter {
    flags = flags | FLAG_HAS_YEAR_FILTER
  }

  Ok(Cron::{
    seconds_mask,
    minutes_mask,
    hours_mask,
    dom_mask: dom.mask,
    months_mask,
    dow_mask: dow.mask,
    flags,
    dom_last_offset_mask: dom.last_offset_mask,
    dom_nearest_weekday_mask: dom.nearest_weekday_mask,
    dow_last_mask: dow.dow_last_mask,
    dow_nth_mask: dow.dow_nth_mask,
    year_min: yr.year_min,
    year_max: yr.year_max,
    year_step: yr.year_step,
    year_spec: yr.year_spec,
  })
}
