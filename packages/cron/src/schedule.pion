///| O(1) bitmask calendar stepping (`next_after`, `prev_before`, `matches`, iterators).

///| Check whether `year` matches the compiled year filter.
fn year_matches(cron : Cron, year : Int) -> Bool {
  if year < cron.year_min || year > cron.year_max {
    return false
  }
  if (cron.flags & FLAG_HAS_YEAR_FILTER) == 0U {
    return true
  }
  if cron.year_step > 0 {
    return (year - cron.year_min) % cron.year_step == 0
  }
  let bits = cron.year_bitmap
  if bits.length() == 0 {
    return false
  }
  let idx = (year >> 2) - (cron.year_min >> 2)
  (((bits.code_unit_at(idx) - 64) >> (year & 3)) & 1) != 0
}

///| Find smallest matching year >= `year`, or -1 if none.
fn next_matching_year(cron : Cron, year : Int) -> Int {
  if year > cron.year_max {
    return -1
  }
  let start_y = if year < cron.year_min { cron.year_min } else { year }
  if (cron.flags & FLAG_HAS_YEAR_FILTER) == 0U {
    return start_y
  }
  if cron.year_step > 0 {
    let rem = (start_y - cron.year_min) % cron.year_step
    let cand = if rem == 0 { start_y } else { start_y + (cron.year_step - rem) }
    return if cand <= cron.year_max { cand } else { -1 }
  }
  let bits = cron.year_bitmap
  let blen = bits.length()
  if blen == 0 {
    return -1
  }
  let base_idx = cron.year_min >> 2
  let mut idx = (start_y >> 2) - base_idx
  let b = start_y & 3
  let first = (bits.code_unit_at(idx) - 64) >> b
  if first != 0 {
    let cand = start_y + CTZ4[first]
    return if cand <= cron.year_max { cand } else { -1 }
  }
  idx = idx + 1
  while idx < blen {
    let v = bits.code_unit_at(idx) - 64
    if v != 0 {
      let cand = ((idx + base_idx) << 2) + CTZ4[v]
      return if cand <= cron.year_max { cand } else { -1 }
    }
    idx = idx + 1
  }
  -1
}

///| Find largest matching year <= `year`, or -1 if none.
fn prev_matching_year(cron : Cron, year : Int) -> Int {
  if year < cron.year_min {
    return -1
  }
  let start_y = if year > cron.year_max { cron.year_max } else { year }
  if (cron.flags & FLAG_HAS_YEAR_FILTER) == 0U {
    return start_y
  }
  if cron.year_step > 0 {
    let rem = (start_y - cron.year_min) % cron.year_step
    let cand = start_y - rem
    return if cand >= cron.year_min { cand } else { -1 }
  }
  let bits = cron.year_bitmap
  if bits.length() == 0 {
    return -1
  }
  let base_idx = cron.year_min >> 2
  let mut idx = (start_y >> 2) - base_idx
  let b = start_y & 3
  let mask = (bits.code_unit_at(idx) - 64) & ((1 << (b + 1)) - 1)
  if mask != 0 {
    let cand = ((idx + base_idx) << 2) + MSB4[mask]
    return if cand >= cron.year_min { cand } else { -1 }
  }
  idx = idx - 1
  while idx >= 0 {
    let v = bits.code_unit_at(idx) - 64
    if v != 0 {
      let cand = ((idx + base_idx) << 2) + MSB4[v]
      return if cand >= cron.year_min { cand } else { -1 }
    }
    idx = idx - 1
  }
  -1
}

///| Compute the effective 32-bit day-of-month bitmask (bits 1..=dim) for `(year, month)` in O(1).
fn effective_day_mask(cron : Cron, year : Int, month : Int) -> UInt64 {
  let dim = days_in_month(year, month)
  let valid_days = (1UL << (dim + 1)) - 2UL
  let flags = cron.flags
  let dom_star = (flags & FLAG_DOM_STAR) != 0U
  let dow_star = (flags & FLAG_DOW_STAR) != 0U

  // Ultra-fast path: no Quartz extensions and DOW is wildcard.
  if (flags & FLAG_HAS_QUARTZ_DAY) == 0U && dow_star {
    return if dom_star { valid_days } else { cron.dom_mask & valid_days }
  }

  let first_dow = weekday_of(year, month, 1)

  // Compute DOM bits
  let mut dom_bits = if dom_star { valid_days } else { cron.dom_mask & valid_days }
  if (flags & FLAG_HAS_QUARTZ_DAY) != 0U {
    if (flags & FLAG_DOM_LAST) != 0U {
      dom_bits = dom_bits | (1UL << dim)
    }
    if (flags & FLAG_DOM_LAST_WEEKDAY) != 0U {
      let last_dow = (first_dow + dim - 1) % 7
      let lw_day = if last_dow == 6 {
        dim - 1
      } else if last_dow == 0 {
        dim - 2
      } else {
        dim
      }
      dom_bits = dom_bits | (1UL << lw_day)
    }
    let mut off_m = cron.dom_last_offset_mask
    while off_m != 0UL {
      let off = ctz64(off_m)
      off_m = off_m & (off_m - 1UL)
      let d = dim - off
      if d >= 1 {
        dom_bits = dom_bits | (1UL << d)
      }
    }
    let mut nw_m = cron.dom_nearest_weekday_mask & valid_days
    while nw_m != 0UL {
      let d = ctz64(nw_m)
      nw_m = nw_m & (nw_m - 1UL)
      let wd = (first_dow + d - 1) % 7
      let target = if wd == 6 {
        if d == 1 { 3 } else { d - 1 }
      } else if wd == 0 {
        if d == dim { dim - 2 } else { d + 1 }
      } else {
        d
      }
      dom_bits = dom_bits | (1UL << target)
    }
  }

  if dow_star {
    return dom_bits
  }

  // Compute DOW bits in O(1) via 7-bit rotation & 5x replication.
  let mut dow_bits = 0UL
  if cron.dow_mask != 0UL {
    let lshift = 7 - first_dow
    let rot = ((cron.dow_mask >> first_dow) | (cron.dow_mask << lshift)) & 0x7FUL
    let rep = (rot << 1) | (rot << 8) | (rot << 15) | (rot << 22) | (rot << 29)
    dow_bits = rep & valid_days
  }
  if (flags & FLAG_HAS_QUARTZ_DAY) != 0U {
    if cron.dow_last_mask != 0U {
      let last_dow = (first_dow + dim - 1) % 7
      let mut lm = cron.dow_last_mask.to_uint64()
      while lm != 0UL {
        let w = ctz64(lm)
        lm = lm & (lm - 1UL)
        let back = (last_dow - w + 7) % 7
        let d = dim - back
        if d >= 1 {
          dow_bits = dow_bits | (1UL << d)
        }
      }
    }
    let mut nm = cron.dow_nth_mask
    while nm != 0UL {
      let k = ctz64(nm)
      nm = nm & (nm - 1UL)
      let n = k / 7 + 1
      let w = k % 7
      let offset = (w - first_dow + 7) % 7
      let d = 1 + offset + (n - 1) * 7
      if d <= dim {
        dow_bits = dow_bits | (1UL << d)
      }
    }
  }

  if dom_star {
    dow_bits
  } else if (flags & FLAG_DOM_AND_DOW) != 0U {
    dom_bits & dow_bits
  } else {
    dom_bits | dow_bits
  }
}

///|
pub fn Cron::matches(self : Cron, dt : DateTime) -> Bool {
  if !dt.is_valid() {
    return false
  }
  if ((self.seconds_mask >> dt.second) & 1UL) == 0UL {
    return false
  }
  if ((self.minutes_mask >> dt.minute) & 1UL) == 0UL {
    return false
  }
  if ((self.hours_mask >> dt.hour) & 1UL) == 0UL {
    return false
  }
  if ((self.months_mask >> dt.month) & 1UL) == 0UL {
    return false
  }
  if !year_matches(self, dt.year) {
    return false
  }
  let dmask = effective_day_mask(self, dt.year, dt.month)
  ((dmask >> dt.day) & 1UL) != 0UL
}

///|
pub fn Cron::matches_unix(self : Cron, unix_secs : Int64) -> Bool {
  match DateTime::from_unix_secs(unix_secs) {
    Ok(dt) => self.matches(dt)
    Err(_) => false
  }
}

///| Core forward search: smallest matching `DateTime >= (y, mo, d, h, mi, s)`.
fn find_next_from(
  cron : Cron,
  y_in : Int,
  mo_in : Int,
  d_in : Int,
  h_in : Int,
  mi_in : Int,
  s_in : Int,
) -> Option[DateTime] {
  if cron.seconds_mask == 0UL ||
  cron.minutes_mask == 0UL ||
  cron.hours_mask == 0UL ||
  cron.months_mask == 0UL {
    return None
  }
  let mut y = y_in
  let mut mo = mo_in
  let mut d = d_in
  let mut h = h_in
  let mut mi = mi_in
  let mut s = s_in

  // Gregorian calendar repeats every 400 years; if no year filter and we advance
  // > 400 years without a single matching day, the expression has no valid date.
  let has_year_filter = (cron.flags & FLAG_HAS_YEAR_FILTER) != 0U
  let max_search_year = if has_year_filter {
    cron.year_max
  } else {
    let lim = y + 400
    if lim < cron.year_max { lim } else { cron.year_max }
  }

  while y <= max_search_year {
    let ny = next_matching_year(cron, y)
    if ny < 0 || ny > max_search_year {
      return None
    }
    if ny > y {
      y = ny
      mo = 1
      d = 1
      h = 0
      mi = 0
      s = 0
    }

    let nmo = next_set_bit(cron.months_mask, mo)
    if nmo < 0 {
      y = y + 1
      mo = 1
      d = 1
      h = 0
      mi = 0
      s = 0
      continue
    }
    if nmo > mo {
      mo = nmo
      d = 1
      h = 0
      mi = 0
      s = 0
    }

    let dmask = effective_day_mask(cron, y, mo)
    let nd = next_set_bit(dmask, d)
    if nd < 0 {
      mo = mo + 1
      d = 1
      h = 0
      mi = 0
      s = 0
      if mo > 12 {
        y = y + 1
        mo = 1
      }
      continue
    }
    if nd > d {
      d = nd
      h = 0
      mi = 0
      s = 0
    }

    let nh = next_set_bit(cron.hours_mask, h)
    if nh < 0 {
      d = d + 1
      h = 0
      mi = 0
      s = 0
      if d > days_in_month(y, mo) {
        mo = mo + 1
        d = 1
        if mo > 12 {
          y = y + 1
          mo = 1
        }
      }
      continue
    }
    if nh > h {
      h = nh
      mi = 0
      s = 0
    }

    let nmi = next_set_bit(cron.minutes_mask, mi)
    if nmi < 0 {
      h = h + 1
      mi = 0
      s = 0
      if h > 23 {
        h = 0
        d = d + 1
        if d > days_in_month(y, mo) {
          mo = mo + 1
          d = 1
          if mo > 12 {
            y = y + 1
            mo = 1
          }
        }
      }
      continue
    }
    if nmi > mi {
      mi = nmi
      s = 0
    }

    let ns = next_set_bit(cron.seconds_mask, s)
    if ns < 0 {
      mi = mi + 1
      s = 0
      if mi > 59 {
        mi = 0
        h = h + 1
        if h > 23 {
          h = 0
          d = d + 1
          if d > days_in_month(y, mo) {
            mo = mo + 1
            d = 1
            if mo > 12 {
              y = y + 1
              mo = 1
            }
          }
        }
      }
      continue
    }
    s = ns
    return Some(DateTime::{ year: y, month: mo, day: d, hour: h, minute: mi, second: s })
  }
  None
}

///| Core reverse search: largest matching `DateTime <= (y, mo, d, h, mi, s)`.
fn find_prev_from(
  cron : Cron,
  y_in : Int,
  mo_in : Int,
  d_in : Int,
  h_in : Int,
  mi_in : Int,
  s_in : Int,
) -> Option[DateTime] {
  if cron.seconds_mask == 0UL ||
  cron.minutes_mask == 0UL ||
  cron.hours_mask == 0UL ||
  cron.months_mask == 0UL {
    return None
  }
  let mut y = y_in
  let mut mo = mo_in
  let mut d = d_in
  let mut h = h_in
  let mut mi = mi_in
  let mut s = s_in

  let has_year_filter = (cron.flags & FLAG_HAS_YEAR_FILTER) != 0U
  let min_search_year = if has_year_filter {
    cron.year_min
  } else {
    let lim = y - 400
    if lim > cron.year_min { lim } else { cron.year_min }
  }

  while y >= min_search_year {
    let py = prev_matching_year(cron, y)
    if py < 0 || py < min_search_year {
      return None
    }
    if py < y {
      y = py
      mo = 12
      d = 31
      h = 23
      mi = 59
      s = 59
    }

    let pmo = prev_set_bit(cron.months_mask, mo)
    if pmo < 0 {
      y = y - 1
      mo = 12
      d = 31
      h = 23
      mi = 59
      s = 59
      continue
    }
    if pmo < mo {
      mo = pmo
      d = days_in_month(y, mo)
      h = 23
      mi = 59
      s = 59
    }

    let dmask = effective_day_mask(cron, y, mo)
    let pd = prev_set_bit(dmask, d)
    if pd < 0 {
      mo = mo - 1
      if mo < 1 {
        y = y - 1
        mo = 12
      }
      d = if y >= MIN_YEAR { days_in_month(y, mo) } else { 31 }
      h = 23
      mi = 59
      s = 59
      continue
    }
    if pd < d {
      d = pd
      h = 23
      mi = 59
      s = 59
    }

    let ph = prev_set_bit(cron.hours_mask, h)
    if ph < 0 {
      d = d - 1
      h = 23
      mi = 59
      s = 59
      if d < 1 {
        mo = mo - 1
        if mo < 1 {
          y = y - 1
          mo = 12
        }
        d = if y >= MIN_YEAR { days_in_month(y, mo) } else { 31 }
      }
      continue
    }
    if ph < h {
      h = ph
      mi = 59
      s = 59
    }

    let pmi = prev_set_bit(cron.minutes_mask, mi)
    if pmi < 0 {
      h = h - 1
      mi = 59
      s = 59
      if h < 0 {
        h = 23
        d = d - 1
        if d < 1 {
          mo = mo - 1
          if mo < 1 {
            y = y - 1
            mo = 12
          }
          d = if y >= MIN_YEAR { days_in_month(y, mo) } else { 31 }
        }
      }
      continue
    }
    if pmi < mi {
      mi = pmi
      s = 59
    }

    let ps = prev_set_bit(cron.seconds_mask, s)
    if ps < 0 {
      mi = mi - 1
      s = 59
      if mi < 0 {
        mi = 59
        h = h - 1
        if h < 0 {
          h = 23
          d = d - 1
          if d < 1 {
            mo = mo - 1
            if mo < 1 {
              y = y - 1
              mo = 12
            }
            d = if y >= MIN_YEAR { days_in_month(y, mo) } else { 31 }
          }
        }
      }
      continue
    }
    s = ps
    return Some(DateTime::{ year: y, month: mo, day: d, hour: h, minute: mi, second: s })
  }
  None
}

///|
pub fn Cron::next_after_inclusive(self : Cron, dt : DateTime) -> Option[DateTime] {
  if !dt.is_valid() {
    return None
  }
  find_next_from(self, dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second)
}

///|
pub fn Cron::next_after(self : Cron, dt : DateTime) -> Option[DateTime] {
  if !dt.is_valid() {
    return None
  }
  let mut y = dt.year
  let mut mo = dt.month
  let mut d = dt.day
  let mut h = dt.hour
  let mut mi = dt.minute
  let mut s = dt.second + 1
  if s > 59 {
    s = 0
    mi = mi + 1
    if mi > 59 {
      mi = 0
      h = h + 1
      if h > 23 {
        h = 0
        d = d + 1
        if d > days_in_month(y, mo) {
          d = 1
          mo = mo + 1
          if mo > 12 {
            mo = 1
            y = y + 1
            if y > MAX_YEAR {
              return None
            }
          }
        }
      }
    }
  }
  find_next_from(self, y, mo, d, h, mi, s)
}

///|
pub fn Cron::next_after_unix(self : Cron, unix_secs : Int64) -> Option[Int64] {
  match DateTime::from_unix_secs(unix_secs) {
    Ok(dt) =>
    match self.next_after(dt) {
      Some(next_dt) => Some(next_dt.to_unix_secs())
      None => None
    }
    Err(_) => None
  }
}

///|
pub fn Cron::prev_before_inclusive(self : Cron, dt : DateTime) -> Option[DateTime] {
  if !dt.is_valid() {
    return None
  }
  find_prev_from(self, dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second)
}

///|
pub fn Cron::prev_before(self : Cron, dt : DateTime) -> Option[DateTime] {
  if !dt.is_valid() {
    return None
  }
  let mut y = dt.year
  let mut mo = dt.month
  let mut d = dt.day
  let mut h = dt.hour
  let mut mi = dt.minute
  let mut s = dt.second - 1
  if s < 0 {
    s = 59
    mi = mi - 1
    if mi < 0 {
      mi = 59
      h = h - 1
      if h < 0 {
        h = 23
        d = d - 1
        if d < 1 {
          mo = mo - 1
          if mo < 1 {
            mo = 12
            y = y - 1
            if y < MIN_YEAR {
              return None
            }
          }
          d = days_in_month(y, mo)
        }
      }
    }
  }
  find_prev_from(self, y, mo, d, h, mi, s)
}

///|
pub fn Cron::prev_before_unix(self : Cron, unix_secs : Int64) -> Option[Int64] {
  match DateTime::from_unix_secs(unix_secs) {
    Ok(dt) =>
    match self.prev_before(dt) {
      Some(prev_dt) => Some(prev_dt.to_unix_secs())
      None => None
    }
    Err(_) => None
  }
}

///|
pub fn Cron::iter_after(self : Cron, start : DateTime) -> CronIter {
  CronIter::{ cron: self, cursor: Some(start) }
}

///|
pub fn CronIter::next(self : CronIter) -> Option[DateTime] {
  match self.cursor {
    Some(cur) => {
      let nxt = self.cron.next_after(cur)
      self.cursor = nxt
      nxt
    }
    None => None
  }
}

///|
pub fn Cron::iter_before(self : Cron, start : DateTime) -> CronRevIter {
  CronRevIter::{ cron: self, cursor: Some(start) }
}

///|
pub fn CronRevIter::next(self : CronRevIter) -> Option[DateTime] {
  match self.cursor {
    Some(cur) => {
      let prv = self.cron.prev_before(cur)
      self.cursor = prv
      prv
    }
    None => None
  }
}

///|
pub fn Cron::take_after(self : Cron, start : DateTime, count : Int) -> Array[DateTime] {
  let out : Array[DateTime] = []
  let mut cur = start
  let mut i = 0
  while i < count {
    match self.next_after(cur) {
      Some(nxt) => {
        out.push(nxt)
        cur = nxt
      }
      None => break
    }
    i = i + 1
  }
  out
}
