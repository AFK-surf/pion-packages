///| Day-1 Red-Team & adversarial test suite for `packages/cron` (Red -> Green).

///|
fn assert_parse_err(expr : String, label : String) -> Unit {
  match Cron::parse(expr) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "expected parse error for " + label + " ('" + expr + "')")
  }
}

///|
test "redteam_impossible_dates_must_not_infinite_loop" {
  let impossible : Array[String] = [
    "0 0 31 2 *", // Feb 31
    "0 0 30 2 *", // Feb 30
    "0 0 31 4 *", // Apr 31
    "0 0 31 6 *", // Jun 31
    "0 0 31 9 *", // Sep 31
    "0 0 31 11 *", // Nov 31
    "0 0 31 2,4,6,9,11 *", // 31st in only non-31-day months
    "0 0 31W 2,4,6,9,11 *", // 31W in only non-31-day months
    "0 0 0 29 2 * 2023", // Feb 29 in non-leap year 2023
    "0 0 0 29 2 * 2100", // Feb 29 in non-leap century year 2100
    "0 0 0 31 2 * 2024", // Feb 31 in leap year
    "0 0 L-29 2 *", // Feb has at most 29 days, L-29 <= 0
    "0 0 L-30 2,4,6,9,11 *", // max 30 days, L-30 <= 0
  ]
  let probe = match DateTime::new(2024, 1, 1, 0, 0, 0) {
    Ok(dt) => dt
    Err(_) => DateTime::{ year: 2024, month: 1, day: 1, hour: 0, minute: 0, second: 0 }
  }
  let mut i = 0
  while i < impossible.length() {
    let expr = impossible[i]
    match Cron::parse(expr) {
      Ok(c) => {
        match c.next_after(probe) {
          None => ()
          Some(got) =>
          debug_assert(false, "impossible date '" + expr + "' returned next " + got.to_string())
        }
        match c.prev_before(probe) {
          None => ()
          Some(got) =>
          debug_assert(false, "impossible date '" + expr + "' returned prev " + got.to_string())
        }
      }
      Err(_) => () // Rejecting at parse time or returning None at step time are both safe
    }
    i = i + 1
  }
}

///|
test "redteam_year_bounds_exhaustion" {
  let c = match Cron::parse("0 0 0 1 1 * 2020") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse failed: " + cron_error_to_string(e))
      return
    }
  }
  let after_2020 = match DateTime::new(2025, 1, 1, 0, 0, 0) {
    Ok(dt) => dt
    Err(_) => DateTime::{ year: 2025, month: 1, day: 1, hour: 0, minute: 0, second: 0 }
  }
  let before_2020 = match DateTime::new(2019, 1, 1, 0, 0, 0) {
    Ok(dt) => dt
    Err(_) => DateTime::{ year: 2019, month: 1, day: 1, hour: 0, minute: 0, second: 0 }
  }
  match c.next_after(after_2020) {
    None => ()
    Some(dt) => debug_assert(false, "expected None after 2020, got " + dt.to_string())
  }
  match c.prev_before(before_2020) {
    None => ()
    Some(dt) => debug_assert(false, "expected None before 2020, got " + dt.to_string())
  }
}

///|
test "redteam_invalid_syntax_steps_ranges_bounds" {
  // Empty and wrong field counts
  assert_parse_err("", "empty")
  assert_parse_err("   \t  ", "whitespace only")
  assert_parse_err("* * *", "3 fields")
  assert_parse_err("* * * *", "4 fields")
  assert_parse_err("* * * * * * * *", "8 fields")

  // Unknown macros
  assert_parse_err("@biweekly", "unknown macro")
  assert_parse_err("@every 5m", "unsupported @every")
  assert_parse_err("@", "bare @")

  // Invalid steps: zero, negative, missing, double
  assert_parse_err("*/0 * * * *", "step zero")
  assert_parse_err("1-10/0 * * * *", "range step zero")
  assert_parse_err("5/0 * * * *", "val step zero")
  assert_parse_err("*/-5 * * * *", "negative step")
  assert_parse_err("1-10/-2 * * * *", "range negative step")
  assert_parse_err("*/ * * * *", "missing step")
  assert_parse_err("/5 * * * *", "missing base")
  assert_parse_err("1-10/2/3 * * * *", "double slash")
  assert_parse_err("*/60 * * * *", "step exceeds field max")

  // Out-of-range values
  assert_parse_err("60 * * * *", "minute 60")
  assert_parse_err("-1 * * * *", "negative minute")
  assert_parse_err("0 24 * * *", "hour 24")
  assert_parse_err("0 0 0 * *", "dom 0")
  assert_parse_err("0 0 32 * *", "dom 32")
  assert_parse_err("0 0 * 0 *", "month 0")
  assert_parse_err("0 0 * 13 *", "month 13")
  assert_parse_err("0 0 * * 8", "dow 8")
  assert_parse_err("60 0 0 * * *", "second 60")
  assert_parse_err("0 0 0 * * * 0", "year 0")
  assert_parse_err("0 0 0 * * * 10000", "year 10000")
  assert_parse_err("0 0 0 * * * 2030-2020", "reversed year range")

  // Invalid ranges and commas
  assert_parse_err("1-2-3 * * * *", "double hyphen")
  assert_parse_err("-5 * * * *", "missing range start")
  assert_parse_err("5- * * * *", "missing range end")
  assert_parse_err(",1 * * * *", "leading comma")
  assert_parse_err("1, * * * *", "trailing comma")
  assert_parse_err("1,,2 * * * *", "double comma")

  // Invalid Quartz tokens
  assert_parse_err("0 0 * * 5#6", "5#6 invalid nth")
  assert_parse_err("0 0 * * 5#0", "5#0 invalid nth")
  assert_parse_err("0 0 * * 8#1", "8#1 invalid dow")
  assert_parse_err("0 0 * * 5#", "5# missing nth")
  assert_parse_err("0 0 * * #3", "#3 missing dow")
  // Quartz accepts L-0 as equivalent to L (last day of month)
  match Cron::parse("0 0 L-0 * *") {
    Ok(c) => {
      let probe = match DateTime::new(2024, 1, 1, 0, 0, 0) {
        Ok(dt) => dt
        Err(_) => DateTime::{ year: 2024, month: 1, day: 1, hour: 0, minute: 0, second: 0 }
      }
      match c.next_after(probe) {
        Some(got) =>
        debug_assert(
          got.year == 2024 && got.month == 1 && got.day == 31,
          "L-0 must fire on 2024-01-31, got " + got.to_string(),
        )
        None => debug_assert(false, "L-0 returned None")
      }
    }
    Err(e) => debug_assert(false, "L-0 should parse (Quartz == L): " + cron_error_to_string(e))
  }
  assert_parse_err("0 0 L-31 * *", "L-31 invalid")
  assert_parse_err("0 0 0W * *", "0W invalid")
  assert_parse_err("0 0 32W * *", "32W invalid")
  assert_parse_err("0 0 W * *", "bare W invalid")
  assert_parse_err("0 0 * * 8L", "8L invalid")
  assert_parse_err("L * * * *", "L in minutes")
  assert_parse_err("0 L * * *", "L in hours")
  assert_parse_err("0 0 1 L *", "L in months")
  assert_parse_err("? * * * *", "? in minutes")
  assert_parse_err("0 ? * * *", "? in hours")
  assert_parse_err("0 0 1 ? *", "? in months")
}

///|
test "redteam_long_repeated_lists_and_invalid_datetimes" {
  // Long repeated list should parse quickly and produce the same mask without OOM/hang
  let mut sb = StringBuilder::new()
  let mut i = 0
  while i < 500 {
    if i > 0 {
      sb.write_char(',')
    }
    sb.write_string("15")
    i = i + 1
  }
  let long_expr = sb.to_string() + " * * * *"
  match Cron::parse(long_expr) {
    Ok(c) => {
      let dt = match DateTime::new(2024, 1, 1, 0, 0, 0) {
        Ok(v) => v
        Err(_) => DateTime::{ year: 2024, month: 1, day: 1, hour: 0, minute: 0, second: 0 }
      }
      match c.next_after(dt) {
        Some(t) => debug_assert(t.minute == 15, "long repeated list minute 15")
        None => debug_assert(false, "long repeated list returned None")
      }
    }
    Err(e) => debug_assert(false, "long repeated list failed: " + cron_error_to_string(e))
  }

  // Invalid DateTime values rejected
  let bad_dts : Array[(Int, Int, Int, Int, Int, Int)] = [
    (0, 1, 1, 0, 0, 0),
    (10000, 1, 1, 0, 0, 0),
    (2024, 0, 1, 0, 0, 0),
    (2024, 13, 1, 0, 0, 0),
    (2024, 1, 0, 0, 0, 0),
    (2024, 1, 32, 0, 0, 0),
    (2023, 2, 29, 0, 0, 0),
    (2100, 2, 29, 0, 0, 0),
    (2024, 4, 31, 0, 0, 0),
    (2024, 1, 1, 24, 0, 0),
    (2024, 1, 1, 0, 60, 0),
    (2024, 1, 1, 0, 0, 60),
    (2024, 1, 1, -1, 0, 0),
  ]
  let mut j = 0
  while j < bad_dts.length() {
    let (y, mo, d, h, mi, s) = bad_dts[j]
    match DateTime::new(y, mo, d, h, mi, s) {
      Err(_) => ()
      Ok(_) => debug_assert(false, "expected invalid DateTime at index " + j.to_string())
    }
    j = j + 1
  }
}

///|
test "redteam_wave7_f1_to_f6_regressions" {
  // F1: DOW 7/<step> fires on Sundays only while preserving 0/2, 5-7, 7-2, 0,7
  let d72 = match Cron::parse("0 0 * * 7/2") {
    Ok(c) => c
    Err(_) => {
      debug_assert(false, "7/2 should parse")
      return
    }
  }
  let mon = match DateTime::new(2024, 1, 1, 0, 0, 0) {
    Ok(v) => v
    Err(_) => return
  }
  let tue = match DateTime::new(2024, 1, 2, 0, 0, 0) {
    Ok(v) => v
    Err(_) => return
  }
  let sun = match DateTime::new(2024, 1, 7, 0, 0, 0) {
    Ok(v) => v
    Err(_) => return
  }
  debug_assert(!d72.matches(tue), "F1: 7/2 must not match Tuesday")
  debug_assert(d72.matches(sun), "F1: 7/2 must match Sunday")
  match d72.next_after(mon) {
    Some(got) => debug_assert(got.eq(sun), "F1: 7/2 next after Mon must be Sun")
    None => debug_assert(false, "F1: 7/2 returned None")
  }
  let d02 = match Cron::parse("0 0 * * 0/2") {
    Ok(c) => c
    Err(_) => return
  }
  debug_assert(d02.matches(tue), "F1: 0/2 still matches Tuesday")

  // F2: Year */n anchored at 1970 with next/prev bijection across 1..=9999
  let y2 = match Cron::parse("0 0 0 1 1 ? */2") {
    Ok(c) => c
    Err(_) => return
  }
  let y2024 = match DateTime::new(2024, 1, 1, 0, 0, 0) {
    Ok(v) => v
    Err(_) => return
  }
  debug_assert(y2.matches(y2024), "F2: 2024 matches */2")
  match y2.next_after(y2024) {
    Some(n) => {
      debug_assert(n.year == 2026, "F2: */2 next after 2024 is 2026")
      match y2.prev_before(n) {
        Some(p) => debug_assert(p.eq(y2024), "F2: prev_before(next_after(2024)) == 2024")
        None => debug_assert(false, "F2: prev_before returned None")
      }
    }
    None => debug_assert(false, "F2: next_after returned None")
  }
  let y5 = match Cron::parse("0 0 0 1 1 ? */5") {
    Ok(c) => c
    Err(_) => return
  }
  match y5.next_after(y2024) {
    Some(n) => debug_assert(n.year == 2025, "F2: */5 next after 2024 is 2025")
    None => debug_assert(false, "F2: */5 returned None")
  }

  // F3: 64-bit era overflow / aliasing rejected in from_unix_secs & unix helpers
  let aliased_pos = 3388401920987913600L
  let aliased_neg = (0L - 268435456L * 146097L + 730485L - 719468L) * 86400L
  match DateTime::from_unix_secs(aliased_pos) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "F3: aliased positive timestamp must be Err")
  }
  match DateTime::from_unix_secs(aliased_neg) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "F3: aliased negative timestamp must be Err")
  }
  let daily = match Cron::parse("0 0 * * *") {
    Ok(c) => c
    Err(_) => return
  }
  debug_assert(!daily.matches_unix(aliased_pos), "F3: matches_unix(aliased_pos) false")
  match daily.next_after_unix(aliased_pos) {
    None => ()
    Some(_) => debug_assert(false, "F3: next_after_unix(aliased_pos) must be None")
  }
  match daily.prev_before_unix(aliased_neg) {
    None => ()
    Some(_) => debug_assert(false, "F3: prev_before_unix(aliased_neg) must be None")
  }

  // F4: Precompiled multi-item year list bitmap matches & bijects accurately
  let ylist = match Cron::parse("0 0 0 1 1 ? 2020,2024,2028-2032/2,9999") {
    Ok(c) => c
    Err(_) => return
  }
  match ylist.next_after(y2024) {
    Some(n) => {
      debug_assert(n.year == 2028, "F4: next after 2024 is 2028")
      match ylist.prev_before(n) {
        Some(p) => debug_assert(p.year == 2024, "F4: prev before 2028 is 2024")
        None => debug_assert(false, "F4: prev_before None")
      }
    }
    None => debug_assert(false, "F4: next_after None")
  }
  let y2032 = match DateTime::new(2032, 1, 1, 0, 0, 0) {
    Ok(v) => v
    Err(_) => return
  }
  match ylist.next_after(y2032) {
    Some(n) => debug_assert(n.year == 9999, "F4: jump across sparse bitmap to 9999")
    None => debug_assert(false, "F4: jump to 9999 returned None")
  }

  // F5: Unvalidated DateTime struct literals rejected in matches & stepping
  let sec0 = match Cron::parse("0 * * * * *") {
    Ok(c) => c
    Err(_) => return
  }
  let bad_sec = DateTime::{ year: 2024, month: 1, day: 1, hour: 0, minute: 0, second: 64 }
  let bad_day = DateTime::{ year: 2023, month: 2, day: 29, hour: 0, minute: 0, second: 0 }
  debug_assert(!sec0.matches(bad_sec), "F5: second=64 must not match")
  debug_assert(!sec0.matches(bad_day), "F5: 2023-02-29 must not match")
  match sec0.next_after(bad_sec) {
    None => ()
    Some(_) => debug_assert(false, "F5: next_after(bad_sec) must be None")
  }
  match sec0.next_after_inclusive(bad_sec) {
    None => ()
    Some(_) => debug_assert(false, "F5: next_after_inclusive(bad_sec) must be None")
  }
  match sec0.prev_before(bad_day) {
    None => ()
    Some(_) => debug_assert(false, "F5: prev_before(bad_day) must be None")
  }
  match sec0.prev_before_inclusive(bad_day) {
    None => ()
    Some(_) => debug_assert(false, "F5: prev_before_inclusive(bad_day) must be None")
  }

  // F6: L-0 in leap and non-leap February
  let l0 = match Cron::parse("0 0 0 L-0 2 ?") {
    Ok(c) => c
    Err(_) => return
  }
  let feb23 = match DateTime::new(2023, 2, 1, 0, 0, 0) {
    Ok(v) => v
    Err(_) => return
  }
  let feb24 = match DateTime::new(2024, 2, 1, 0, 0, 0) {
    Ok(v) => v
    Err(_) => return
  }
  match l0.next_after(feb23) {
    Some(n) => debug_assert(n.year == 2023 && n.month == 2 && n.day == 28, "F6: L-0 Feb 2023 -> 28")
    None => debug_assert(false, "F6: L-0 Feb 2023 None")
  }
  match l0.next_after(feb24) {
    Some(n) => debug_assert(n.year == 2024 && n.month == 2 && n.day == 29, "F6: L-0 Feb 2024 -> 29")
    None => debug_assert(false, "F6: L-0 Feb 2024 None")
  }
}
