///| Upstream `croner` + `robfig/cron/v3` compliance test suite (Red -> Green).

///|
fn must_dt(y : Int, mo : Int, d : Int, h : Int, mi : Int, s : Int) -> DateTime {
  match DateTime::new(y, mo, d, h, mi, s) {
    Ok(dt) => dt
    Err(e) => {
      debug_assert(false, "expected valid DateTime: " + cron_error_to_string(e))
      DateTime::{ year: 1970, month: 1, day: 1, hour: 0, minute: 0, second: 0 }
    }
  }
}

///|
fn must_cron(expr : String) -> Cron {
  match Cron::parse(expr) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "expected valid cron '" + expr + "': " + cron_error_to_string(e))
      Cron::{
        seconds_mask: 0UL,
        minutes_mask: 0UL,
        hours_mask: 0UL,
        dom_mask: 0UL,
        months_mask: 0UL,
        dow_mask: 0UL,
        flags: 0U,
        dom_last_offset_mask: 0UL,
        dom_nearest_weekday_mask: 0UL,
        dow_last_mask: 0U,
        dow_nth_mask: 0UL,
        year_min: 1,
        year_max: 9999,
        year_step: 1,
        year_spec: "",
        year_bitmap: "",
      }
    }
  }
}

///|
fn must_cron_opts(expr : String, opts : ParseOptions) -> Cron {
  match Cron::parse_with_options(expr, opts) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "expected valid cron with opts '" + expr + "': " + cron_error_to_string(e))
      must_cron("* * * * *")
    }
  }
}

///|
fn assert_next(c : Cron, from : DateTime, expected : DateTime, label : String) -> Unit {
  match c.next_after(from) {
    Some(got) =>
    debug_assert(
      got.eq(expected),
      label + ": expected " + expected.to_string() + ", got " + got.to_string(),
    )
    None => debug_assert(false, label + ": expected " + expected.to_string() + ", got None")
  }
}

///|
fn assert_prev(c : Cron, from : DateTime, expected : DateTime, label : String) -> Unit {
  match c.prev_before(from) {
    Some(got) =>
    debug_assert(
      got.eq(expected),
      label + ": expected " + expected.to_string() + ", got " + got.to_string(),
    )
    None => debug_assert(false, label + ": expected " + expected.to_string() + ", got None")
  }
}

///|
fn assert_next_none(c : Cron, from : DateTime, label : String) -> Unit {
  match c.next_after(from) {
    None => ()
    Some(got) => debug_assert(false, label + ": expected None, got " + got.to_string())
  }
}

///|
fn assert_prev_none(c : Cron, from : DateTime, label : String) -> Unit {
  match c.prev_before(from) {
    None => ()
    Some(got) => debug_assert(false, label + ": expected None, got " + got.to_string())
  }
}

///|
test "calendar_helpers_and_datetime" {
  // Leap years including century rules
  debug_assert(is_leap_year(2000), "2000 is leap (div by 400)")
  debug_assert(!is_leap_year(1900), "1900 is not leap")
  debug_assert(!is_leap_year(2100), "2100 is not leap")
  debug_assert(is_leap_year(2400), "2400 is leap (div by 400)")
  debug_assert(is_leap_year(2024), "2024 is leap")
  debug_assert(!is_leap_year(2023), "2023 is not leap")

  debug_assert(days_in_month(2024, 2) == 29, "2024-02 has 29 days")
  debug_assert(days_in_month(2023, 2) == 28, "2023-02 has 28 days")
  debug_assert(days_in_month(2000, 2) == 29, "2000-02 has 29 days")
  debug_assert(days_in_month(2100, 2) == 28, "2100-02 has 28 days")
  debug_assert(days_in_month(2024, 4) == 30, "Apr has 30 days")
  debug_assert(days_in_month(2024, 1) == 31, "Jan has 31 days")

  // Weekdays: 0=Sun..6=Sat
  debug_assert(weekday_of(1970, 1, 1) == 4, "1970-01-01 is Thu (4)")
  debug_assert(weekday_of(2000, 1, 1) == 6, "2000-01-01 is Sat (6)")
  debug_assert(weekday_of(2024, 2, 29) == 4, "2024-02-29 is Thu (4)")
  debug_assert(weekday_of(2024, 9, 13) == 5, "2024-09-13 is Fri (5)")
  debug_assert(weekday_of(2023, 1, 1) == 0, "2023-01-01 is Sun (0)")
  debug_assert(weekday_of(2100, 3, 1) == 1, "2100-03-01 is Mon (1)")

  // Unix timestamp roundtrips across epochs and centuries
  let samples : Array[(DateTime, Int64)] = [
    (must_dt(1970, 1, 1, 0, 0, 0), 0L),
    (must_dt(2000, 2, 29, 12, 34, 56), 951827696L),
    (must_dt(2024, 2, 29, 23, 59, 59), 1709251199L),
    (must_dt(2038, 1, 19, 3, 14, 7), 2147483647L),
    (must_dt(2100, 3, 1, 0, 0, 0), 4107542400L),
    (must_dt(2400, 2, 29, 0, 0, 0), 13574563200L),
  ]
  let mut i = 0
  while i < samples.length() {
    let (dt, ts) = samples[i]
    debug_assert(dt.to_unix_secs() == ts, "to_unix_secs " + dt.to_string())
    match DateTime::from_unix_secs(ts) {
      Ok(rt) => debug_assert(rt.eq(dt), "from_unix_secs roundtrip " + dt.to_string())
      Err(_) => debug_assert(false, "from_unix_secs failed")
    }
    i = i + 1
  }

  let formatted = must_dt(2024, 2, 9, 5, 7, 3).to_string()
  debug_assert(formatted == "2024-02-09T05:07:03Z", "ISO formatting: " + formatted)
}

///|
test "parse_standard_5_field_basic" {
  let every_min = must_cron("* * * * *")
  assert_next(
    every_min,
    must_dt(2024, 1, 1, 0, 0, 0),
    must_dt(2024, 1, 1, 0, 1, 0),
    "strictly after 00:00:00",
  )
  assert_next(
    every_min,
    must_dt(2024, 1, 1, 0, 0, 30),
    must_dt(2024, 1, 1, 0, 1, 0),
    "mid-minute advances to next minute sec 0",
  )
  assert_next(
    every_min,
    must_dt(2024, 12, 31, 23, 59, 59),
    must_dt(2025, 1, 1, 0, 0, 0),
    "year rollover",
  )

  // Step, range, stepped range, list
  let c1 = must_cron("*/15 9-17 * * 1-5")
  assert_next(
    c1,
    must_dt(2024, 1, 5, 17, 45, 0), // Fri 17:45
    must_dt(2024, 1, 8, 9, 0, 0), // Mon 09:00
    "skip weekend",
  )

  let c2 = must_cron("5/20 1-10/3 * * *")
  // minutes: 5, 25, 45; hours: 1, 4, 7, 10
  assert_next(c2, must_dt(2024, 3, 1, 0, 0, 0), must_dt(2024, 3, 1, 1, 5, 0), "5/20 1-10/3 #1")
  assert_next(c2, must_dt(2024, 3, 1, 1, 45, 0), must_dt(2024, 3, 1, 4, 5, 0), "5/20 1-10/3 #2")
  assert_next(c2, must_dt(2024, 3, 1, 10, 45, 0), must_dt(2024, 3, 2, 1, 5, 0), "5/20 1-10/3 #3")

  let c3 = must_cron("1,3,5 0 1,15 * *")
  assert_next(c3, must_dt(2024, 5, 1, 0, 1, 0), must_dt(2024, 5, 1, 0, 3, 0), "list #1")
  assert_next(c3, must_dt(2024, 5, 1, 0, 5, 0), must_dt(2024, 5, 15, 0, 1, 0), "list #2")
}

///|
test "parse_6_and_7_field_seconds_and_years" {
  // 6-field with seconds
  let every_sec = must_cron("* * * * * *")
  assert_next(
    every_sec,
    must_dt(2024, 6, 1, 12, 0, 59),
    must_dt(2024, 6, 1, 12, 1, 0),
    "6-field sec rollover",
  )

  let sec_step = must_cron("*/10 30 14 * * *")
  assert_next(
    sec_step,
    must_dt(2024, 6, 1, 14, 30, 0),
    must_dt(2024, 6, 1, 14, 30, 10),
    "6-field */10 #1",
  )
  assert_next(
    sec_step,
    must_dt(2024, 6, 1, 14, 30, 50),
    must_dt(2024, 6, 2, 14, 30, 0),
    "6-field */10 #2",
  )

  // 7-field with year
  let yr_single = must_cron("0 0 12 1 1 * 2026")
  assert_next(
    yr_single,
    must_dt(2024, 1, 1, 0, 0, 0),
    must_dt(2026, 1, 1, 12, 0, 0),
    "7-field jump to 2026",
  )
  assert_next_none(yr_single, must_dt(2026, 1, 1, 12, 0, 0), "7-field exhausted after 2026")

  // 7-field year list and range/step
  let yr_list = must_cron("0 0 0 1 1 * 2025,2028-2032/2")
  // matches 2025, 2028, 2030, 2032
  assert_next(yr_list, must_dt(2024, 6, 1, 0, 0, 0), must_dt(2025, 1, 1, 0, 0, 0), "yr_list 2025")
  assert_next(yr_list, must_dt(2025, 1, 1, 0, 0, 0), must_dt(2028, 1, 1, 0, 0, 0), "yr_list 2028")
  assert_next(yr_list, must_dt(2028, 1, 1, 0, 0, 0), must_dt(2030, 1, 1, 0, 0, 0), "yr_list 2030")
  assert_next(yr_list, must_dt(2030, 1, 1, 0, 0, 0), must_dt(2032, 1, 1, 0, 0, 0), "yr_list 2032")
  assert_next_none(yr_list, must_dt(2032, 1, 1, 0, 0, 0), "yr_list exhausted")

  // Strict 5-field rejects 6-field; strict 6-field rejects 7-field
  match Cron::parse_standard("0 * * * * *") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "parse_standard should reject 6 fields")
  }
  match Cron::parse_with_seconds("0 * * * * * 2025") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "parse_with_seconds should reject 7 fields")
  }
}

///|
test "predefined_macros" {
  let base = must_dt(2024, 3, 15, 10, 30, 45)
  assert_next(must_cron("@yearly"), base, must_dt(2025, 1, 1, 0, 0, 0), "@yearly")
  assert_next(must_cron("@ANNUALLY"), base, must_dt(2025, 1, 1, 0, 0, 0), "@ANNUALLY")
  assert_next(must_cron("@monthly"), base, must_dt(2024, 4, 1, 0, 0, 0), "@monthly")
  assert_next(must_cron("@weekly"), base, must_dt(2024, 3, 17, 0, 0, 0), "@weekly (Sun)")
  assert_next(must_cron("@daily"), base, must_dt(2024, 3, 16, 0, 0, 0), "@daily")
  assert_next(must_cron("@Midnight"), base, must_dt(2024, 3, 16, 0, 0, 0), "@Midnight")
  assert_next(must_cron("  @hourly  "), base, must_dt(2024, 3, 15, 11, 0, 0), "@hourly")
}

///|
test "aliases_sunday_0_and_7_and_wrap_around_ranges" {
  // Month aliases (case-insensitive)
  let m = must_cron("0 0 1 jan,MAR,dec *")
  assert_next(m, must_dt(2024, 1, 1, 0, 0, 0), must_dt(2024, 3, 1, 0, 0, 0), "month alias MAR")
  assert_next(m, must_dt(2024, 3, 1, 0, 0, 0), must_dt(2024, 12, 1, 0, 0, 0), "month alias DEC")
  assert_next(m, must_dt(2024, 12, 1, 0, 0, 0), must_dt(2025, 1, 1, 0, 0, 0), "month alias JAN")

  // Sunday as 0, 7, SUN
  let sun0 = must_cron("0 0 * * 0")
  let sun7 = must_cron("0 0 * * 7")
  let sun_name = must_cron("0 0 * * sun")
  let probe = must_dt(2024, 3, 15, 12, 0, 0) // Fri
  let expected_sun = must_dt(2024, 3, 17, 0, 0, 0) // Sun
  assert_next(sun0, probe, expected_sun, "dow 0")
  assert_next(sun7, probe, expected_sun, "dow 7")
  assert_next(sun_name, probe, expected_sun, "dow sun")

  // 5-7 (Fri, Sat, Sun) and 7-2 (Sun, Mon, Tue)
  let fri_to_sun = must_cron("0 0 * * 5-7")
  assert_next(
    fri_to_sun,
    must_dt(2024, 3, 14, 0, 0, 0), // Thu
    must_dt(2024, 3, 15, 0, 0, 0), // Fri
    "5-7 Fri",
  )
  assert_next(
    fri_to_sun,
    must_dt(2024, 3, 16, 0, 0, 0), // Sat
    must_dt(2024, 3, 17, 0, 0, 0), // Sun
    "5-7 Sun",
  )
  assert_next(
    fri_to_sun,
    must_dt(2024, 3, 17, 0, 0, 0), // Sun
    must_dt(2024, 3, 22, 0, 0, 0), // next Fri
    "5-7 next Fri",
  )

  let sun_to_tue = must_cron("0 0 * * 7-2")
  assert_next(
    sun_to_tue,
    must_dt(2024, 3, 16, 0, 0, 0), // Sat
    must_dt(2024, 3, 17, 0, 0, 0), // Sun
    "7-2 Sun",
  )
  assert_next(
    sun_to_tue,
    must_dt(2024, 3, 19, 0, 0, 0), // Tue
    must_dt(2024, 3, 24, 0, 0, 0), // next Sun
    "7-2 next Sun",
  )

  // Wrap-around ranges: hours 22-2, months NOV-FEB, dow FRI-MON
  let night = must_cron("0 22-2 * * *")
  assert_next(night, must_dt(2024, 1, 1, 2, 0, 0), must_dt(2024, 1, 1, 22, 0, 0), "22-2 jump to 22")
  assert_next(night, must_dt(2024, 1, 1, 23, 0, 0), must_dt(2024, 1, 2, 0, 0, 0), "22-2 midnight")

  let winter = must_cron("0 0 1 NOV-FEB *")
  assert_next(winter, must_dt(2024, 2, 1, 0, 0, 0), must_dt(2024, 11, 1, 0, 0, 0), "NOV-FEB -> Nov")
  assert_next(winter, must_dt(2024, 12, 1, 0, 0, 0), must_dt(2025, 1, 1, 0, 0, 0), "NOV-FEB -> Jan")

  let wknd = must_cron("0 0 * * FRI-MON")
  assert_next(wknd, must_dt(2024, 3, 18, 0, 0, 0), must_dt(2024, 3, 22, 0, 0, 0), "FRI-MON -> Fri")
  assert_next(wknd, must_dt(2024, 3, 24, 0, 0, 0), must_dt(2024, 3, 25, 0, 0, 0), "FRI-MON -> Mon")

  // Wrap-around with step: 22-2/2 => 22, 0, 2
  let night_step = must_cron("0 22-2/2 * * *")
  assert_next(
    night_step,
    must_dt(2024, 1, 1, 21, 0, 0),
    must_dt(2024, 1, 1, 22, 0, 0),
    "22-2/2 -> 22",
  )
  assert_next(
    night_step,
    must_dt(2024, 1, 1, 22, 0, 0),
    must_dt(2024, 1, 2, 0, 0, 0),
    "22-2/2 -> 0",
  )
  assert_next(
    night_step,
    must_dt(2024, 1, 2, 0, 0, 0),
    must_dt(2024, 1, 2, 2, 0, 0),
    "22-2/2 -> 2",
  )
  assert_next(
    night_step,
    must_dt(2024, 1, 2, 2, 0, 0),
    must_dt(2024, 1, 2, 22, 0, 0),
    "22-2/2 -> next 22",
  )
}

///|
test "vixie_dom_dow_or_vs_and_semantics" {
  // Both DOM=15 and DOW=1 (Mon) restricted => Vixie OR semantics
  let or_cron = must_cron("0 0 15 * 1")
  // 2024-03-11 is Mon, 2024-03-15 is Fri, 2024-03-18 is Mon
  assert_next(or_cron, must_dt(2024, 3, 10, 0, 0, 0), must_dt(2024, 3, 11, 0, 0, 0), "OR: Mon 11")
  assert_next(or_cron, must_dt(2024, 3, 11, 0, 0, 0), must_dt(2024, 3, 15, 0, 0, 0), "OR: Fri 15")
  assert_next(or_cron, must_dt(2024, 3, 15, 0, 0, 0), must_dt(2024, 3, 18, 0, 0, 0), "OR: Mon 18")

  // DOM=* and DOW=1 => only Mondays (AND)
  let only_mon = must_cron("0 0 * * 1")
  assert_next(only_mon, must_dt(2024, 3, 11, 0, 0, 0), must_dt(2024, 3, 18, 0, 0, 0), "DOM=* only Mon")

  // DOM=15 and DOW=* => only 15th (AND)
  let only_15 = must_cron("0 0 15 * *")
  assert_next(only_15, must_dt(2024, 3, 15, 0, 0, 0), must_dt(2024, 4, 15, 0, 0, 0), "DOW=* only 15th")

  // Question mark `?` behaves as wildcard
  let q_dom = must_cron("0 0 ? * 5")
  assert_next(q_dom, must_dt(2024, 3, 15, 0, 0, 0), must_dt(2024, 3, 22, 0, 0, 0), "DOM=? only Fri")
  let q_dow = must_cron("0 0 15 * ?")
  assert_next(q_dow, must_dt(2024, 3, 15, 0, 0, 0), must_dt(2024, 4, 15, 0, 0, 0), "DOW=? only 15th")

  // Strict AND mode (Friday the 13th!)
  let and_opts = ParseOptions::{ allow_seconds: true, allow_years: true, dom_and_dow: true }
  let fri13 = must_cron_opts("0 0 13 * 5", and_opts)
  assert_next(
    fri13,
    must_dt(2024, 1, 1, 0, 0, 0),
    must_dt(2024, 9, 13, 0, 0, 0),
    "Friday the 13th 2024-09-13",
  )
  assert_next(
    fri13,
    must_dt(2024, 9, 13, 0, 0, 0),
    must_dt(2024, 12, 13, 0, 0, 0),
    "Friday the 13th 2024-12-13",
  )
}

///|
test "quartz_extensions_L_W_LW_nth" {
  // L: last day of month (handles leap and non-leap Feb!)
  let last_day = must_cron("0 0 L * *")
  assert_next(last_day, must_dt(2023, 2, 1, 0, 0, 0), must_dt(2023, 2, 28, 0, 0, 0), "L 2023-02")
  assert_next(last_day, must_dt(2024, 2, 1, 0, 0, 0), must_dt(2024, 2, 29, 0, 0, 0), "L 2024-02")
  assert_next(last_day, must_dt(2024, 4, 1, 0, 0, 0), must_dt(2024, 4, 30, 0, 0, 0), "L 2024-04")
  assert_next(last_day, must_dt(2024, 5, 1, 0, 0, 0), must_dt(2024, 5, 31, 0, 0, 0), "L 2024-05")

  // L-3: 3 days before last day of month
  let l_minus_3 = must_cron("0 0 L-3 * *")
  assert_next(l_minus_3, must_dt(2023, 2, 1, 0, 0, 0), must_dt(2023, 2, 25, 0, 0, 0), "L-3 2023-02")
  assert_next(l_minus_3, must_dt(2024, 2, 1, 0, 0, 0), must_dt(2024, 2, 26, 0, 0, 0), "L-3 2024-02")
  assert_next(l_minus_3, must_dt(2024, 3, 1, 0, 0, 0), must_dt(2024, 3, 28, 0, 0, 0), "L-3 2024-03")

  // LW: last weekday of month
  // 2024-03-31 is Sun => LW is Fri 2024-03-29
  // 2024-06-30 is Sun => LW is Fri 2024-06-28
  // 2024-08-31 is Sat => LW is Fri 2024-08-30
  // 2024-04-30 is Tue => LW is Tue 2024-04-30
  let lw = must_cron("0 0 LW * *")
  assert_next(lw, must_dt(2024, 3, 1, 0, 0, 0), must_dt(2024, 3, 29, 0, 0, 0), "LW 2024-03 (Sun->Fri)")
  assert_next(lw, must_dt(2024, 4, 1, 0, 0, 0), must_dt(2024, 4, 30, 0, 0, 0), "LW 2024-04 (Tue)")
  assert_next(lw, must_dt(2024, 8, 1, 0, 0, 0), must_dt(2024, 8, 30, 0, 0, 0), "LW 2024-08 (Sat->Fri)")

  // 15W: nearest weekday to 15th
  // 2024-06-15 is Sat => Fri 2024-06-14
  // 2024-09-15 is Sun => Mon 2024-09-16
  // 2024-03-15 is Fri => Fri 2024-03-15
  let w15 = must_cron("0 0 15W * *")
  assert_next(w15, must_dt(2024, 3, 1, 0, 0, 0), must_dt(2024, 3, 15, 0, 0, 0), "15W Fri")
  assert_next(w15, must_dt(2024, 6, 1, 0, 0, 0), must_dt(2024, 6, 14, 0, 0, 0), "15W Sat->14")
  assert_next(w15, must_dt(2024, 9, 1, 0, 0, 0), must_dt(2024, 9, 16, 0, 0, 0), "15W Sun->16")

  // 1W when 1st is Saturday => Monday 3rd (never crosses to previous month)
  // 2024-06-01 is Sat => Mon 2024-06-03
  let w1 = must_cron("0 0 1W * *")
  assert_next(w1, must_dt(2024, 5, 31, 0, 0, 0), must_dt(2024, 6, 3, 0, 0, 0), "1W Sat->Mon 3rd")

  // 31W when 31st is Sunday => Friday 29th (never crosses to next month), skips non-31-day months
  // 2024-03-31 is Sun => Fri 2024-03-29; 2024-04 has 30 days (skip); 2024-05-31 is Fri
  let w31 = must_cron("0 0 31W * *")
  assert_next(w31, must_dt(2024, 3, 1, 0, 0, 0), must_dt(2024, 3, 29, 0, 0, 0), "31W Sun->Fri 29")
  assert_next(w31, must_dt(2024, 3, 29, 0, 0, 0), must_dt(2024, 5, 31, 0, 0, 0), "31W skips Apr")

  // 5L / FRIL: last Friday of month
  // 2024-03 last Fri = 2024-03-29; 2024-04 last Fri = 2024-04-26
  let last_fri = must_cron("0 0 * * 5L")
  assert_next(last_fri, must_dt(2024, 3, 1, 0, 0, 0), must_dt(2024, 3, 29, 0, 0, 0), "5L 2024-03")
  assert_next(last_fri, must_dt(2024, 3, 29, 0, 0, 0), must_dt(2024, 4, 26, 0, 0, 0), "5L 2024-04")

  // 5#3 / FRI#3: 3rd Friday of month
  // 2024-03 Fridays: 1, 8, 15, 22, 29 => 3rd is 15; 5th is 29
  let third_fri = must_cron("0 0 * * FRI#3")
  assert_next(third_fri, must_dt(2024, 3, 1, 0, 0, 0), must_dt(2024, 3, 15, 0, 0, 0), "FRI#3 2024-03")
  assert_next(third_fri, must_dt(2024, 3, 15, 0, 0, 0), must_dt(2024, 4, 19, 0, 0, 0), "FRI#3 2024-04")

  // 5#5: 5th Friday (only months with 5 Fridays: 2024-03-29, then 2024-05-31)
  let fifth_fri = must_cron("0 0 * * 5#5")
  assert_next(fifth_fri, must_dt(2024, 3, 1, 0, 0, 0), must_dt(2024, 3, 29, 0, 0, 0), "5#5 2024-03")
  assert_next(fifth_fri, must_dt(2024, 3, 29, 0, 0, 0), must_dt(2024, 5, 31, 0, 0, 0), "5#5 skips Apr -> May 31")
}

///|
test "leap_year_and_400_year_gregorian_boundaries" {
  let leap_day = must_cron("0 0 29 2 *")
  // 2000 is leap (div by 400)
  assert_next(leap_day, must_dt(1999, 1, 1, 0, 0, 0), must_dt(2000, 2, 29, 0, 0, 0), "leap 2000")
  assert_next(leap_day, must_dt(2023, 1, 1, 0, 0, 0), must_dt(2024, 2, 29, 0, 0, 0), "leap 2024")
  // 2100 is NOT leap => 2096-02-29 skips 2100 and lands on 2104-02-29!
  assert_next(leap_day, must_dt(2096, 2, 29, 0, 0, 0), must_dt(2104, 2, 29, 0, 0, 0), "skip 2100 -> 2104")
  // 2400 IS leap => 2396-02-29 lands on 2400-02-29!
  assert_next(leap_day, must_dt(2396, 2, 29, 0, 0, 0), must_dt(2400, 2, 29, 0, 0, 0), "leap 2400")
  assert_next(leap_day, must_dt(2400, 2, 29, 0, 0, 0), must_dt(2404, 2, 29, 0, 0, 0), "leap 2404")

  // Reverse across 2100 non-leap century
  assert_prev(leap_day, must_dt(2104, 2, 29, 0, 0, 0), must_dt(2096, 2, 29, 0, 0, 0), "prev skip 2100 -> 2096")
  assert_prev(leap_day, must_dt(2404, 2, 29, 0, 0, 0), must_dt(2400, 2, 29, 0, 0, 0), "prev 2400")
}

///|
test "prev_before_bijection_and_iterators" {
  let exprs : Array[String] = [
    "* * * * *",
    "*/15 9-17 * * 1-5",
    "0 0 29 2 *",
    "0 0 L * *",
    "0 0 L-3 * *",
    "0 0 LW * *",
    "0 0 15W * *",
    "0 0 * * 5L",
    "0 0 * * 5#3",
    "0 0 15 * 1",
    "30 15 10 * * *",
    "0 0 0 1 1 * 2024-2030/2",
  ]
  let start = must_dt(2024, 1, 1, 0, 0, 0)
  let mut i = 0
  while i < exprs.length() {
    let expr = exprs[i]
    let c = must_cron(expr)
    let seq = c.take_after(start, 6)
    debug_assert(seq.length() >= 3, "take_after len for " + expr)
    let mut j = 0
    while j < seq.length() {
      debug_assert(c.matches(seq[j]), "matches(seq[j]) for " + expr)
      debug_assert(c.matches_unix(seq[j].to_unix_secs()), "matches_unix for " + expr)
      if j > 0 {
        debug_assert(seq[j - 1].cmp(seq[j]) < 0, "strictly increasing for " + expr)
        assert_prev(c, seq[j], seq[j - 1], "prev_before bijection for " + expr)
      }
      j = j + 1
    }
    // Inclusive checks
    match c.next_after_inclusive(seq[0]) {
      Some(t) => debug_assert(t.eq(seq[0]), "next_after_inclusive on match for " + expr)
      None => debug_assert(false, "next_after_inclusive None")
    }
    match c.prev_before_inclusive(seq[0]) {
      Some(t) => debug_assert(t.eq(seq[0]), "prev_before_inclusive on match for " + expr)
      None => debug_assert(false, "prev_before_inclusive None")
    }
    i = i + 1
  }

  // Test iter_after and iter_before directly
  let hourly = must_cron("@hourly")
  let it = hourly.iter_after(must_dt(2024, 5, 1, 10, 0, 0))
  let a = it.next()
  let b = it.next()
  match (a, b) {
    (Some(t1), Some(t2)) => {
      debug_assert(t1.eq(must_dt(2024, 5, 1, 11, 0, 0)), "iter_after #1")
      debug_assert(t2.eq(must_dt(2024, 5, 1, 12, 0, 0)), "iter_after #2")
    }
    _ => debug_assert(false, "iter_after expected Some")
  }

  let rit = hourly.iter_before(must_dt(2024, 5, 1, 12, 0, 0))
  let ra = rit.next()
  let rb = rit.next()
  match (ra, rb) {
    (Some(t1), Some(t2)) => {
      debug_assert(t1.eq(must_dt(2024, 5, 1, 11, 0, 0)), "iter_before #1")
      debug_assert(t2.eq(must_dt(2024, 5, 1, 10, 0, 0)), "iter_before #2")
    }
    _ => debug_assert(false, "iter_before expected Some")
  }
}

///|
test "describe_human_readable" {
  debug_assert(must_cron("* * * * *").describe().length() > 0, "describe * * * * *")
  debug_assert(must_cron("*/5 * * * *").describe().length() > 0, "describe */5")
  debug_assert(must_cron("0 9 * * 1-5").describe().length() > 0, "describe weekday 9am")
  debug_assert(must_cron("0 0 L * *").describe().length() > 0, "describe L")
  debug_assert(must_cron("0 0 * * 5#3").describe().length() > 0, "describe 5#3")
}

test "c1_migrated_cron_leap_year_constants" {
  debug_assert(is_leap_year(2000), "2000 is leap")
  debug_assert(!is_leap_year(2100), "2100 is not leap")
  debug_assert(is_leap_year(2400), "2400 is leap")
}
