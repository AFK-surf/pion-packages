///| Red-team differential / invariant probe for packages/cron.
/// usage:
///   cron_audit_probe diff <file>   one line per input "opts<TAB>expr<TAB>start_unix<TAB>n"
///                                  -> "ERR" | "OK m=<0|1> N <next chain> P <prev chain>"
///   cron_audit_probe inv <file>    same input; prints only invariant violations + a summary line
///   cron_audit_probe unix <secs>   DateTime::from_unix_secs(secs) round-trip
///   cron_audit_probe time <opts> <expr> <start_unix> <n>  run next_after n times (DoS probe)
/// opts: std (5-field), sec (5/6), q (default: 5/6/7), and (default + dom_and_dow)

import "cron"

///|
fn parse_i64(s : String) -> Int64 {
  let mut i = 0
  let mut neg = false
  if s.length() > 0 && s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  let mut acc = 0L
  while i < s.length() {
    acc = acc * 10L + (s.code_unit_at(i) - 48).to_int64()
    i = i + 1
  }
  if neg {
    0L - acc
  } else {
    acc
  }
}

///|
fn opts_of(o : String) -> cron::ParseOptions {
  if o == "std" {
    cron::ParseOptions::standard()
  } else if o == "sec" {
    cron::ParseOptions::with_seconds()
  } else if o == "and" {
    cron::ParseOptions::{ allow_seconds: true, allow_years: true, dom_and_dow: true }
  } else {
    cron::ParseOptions::default()
  }
}

///| Undo the corpus escaping: \t \n \r \\ \0 and \xHH (ASCII only).
fn unescape(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 92 && i + 1 < s.length() {
      let d = s.code_unit_at(i + 1)
      if d == 116 {
        sb.write_char('\t')
        i = i + 2
        continue
      }
      if d == 110 {
        sb.write_char('\n')
        i = i + 2
        continue
      }
      if d == 114 {
        sb.write_char('\r')
        i = i + 2
        continue
      }
      if d == 92 {
        sb.write_char('\\')
        i = i + 2
        continue
      }
    }
    sb.write_string(s.slice(i, i + 1))
    i = i + 1
  }
  sb.to_string()
}

///|
fn split_tabs(line : String) -> Array[String] {
  let out : Array[String] = []
  let mut pos = 0
  let mut i = 0
  while i < line.length() {
    if line.code_unit_at(i) == 9 {
      out.push(line.slice(pos, i))
      pos = i + 1
    }
    i = i + 1
  }
  out.push(line.slice(pos, line.length()))
  out
}

///|
fn read_lines(world : World, path : String) -> Array[String] {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return []
  }
  let lines : Array[String] = []
  let clen = content.length()
  let mut pos = 0
  while pos < clen {
    let mut end = pos
    while end < clen && content.code_unit_at(end) != 10 {
      end = end + 1
    }
    if end > pos {
      lines.push(content.slice(pos, end))
    }
    pos = end + 1
  }
  lines
}

///|
fn opt_str(o : Option[cron::DateTime]) -> String {
  match o {
    Some(dt) => dt.to_unix_secs().to_string()
    None => "-"
  }
}

///|
fn diff_line(line : String) -> String {
  let f = split_tabs(line)
  if f.length() < 4 {
    return "BADLINE"
  }
  let c = match cron::Cron::parse_with_options(unescape(f[1]), opts_of(f[0])) {
    Ok(c) => c
    Err(_) => return "ERR"
  }
  let start = match cron::DateTime::from_unix_secs(parse_i64(f[2])) {
    Ok(dt) => dt
    Err(_) => return "BADSTART"
  }
  let n = parse_i64(f[3]).to_int()
  let sb = StringBuilder::new()
  sb.write_string("OK m=")
  sb.write_string(if c.matches(start) { "1" } else { "0" })
  sb.write_string(" N")
  let mut cur = Some(start)
  let mut k = 0
  while k < n {
    match cur {
      Some(dt) => {
        let nx = c.next_after(dt)
        sb.write_char(' ')
        sb.write_string(opt_str(nx))
        cur = nx
      }
      None => break
    }
    k = k + 1
  }
  sb.write_string(" P")
  cur = Some(start)
  k = 0
  while k < n {
    match cur {
      Some(dt) => {
        let pv = c.prev_before(dt)
        sb.write_char(' ')
        sb.write_string(opt_str(pv))
        cur = pv
      }
      None => break
    }
    k = k + 1
  }
  sb.to_string()
}

///|
fn same(a : Option[cron::DateTime], b : Option[cron::DateTime]) -> Bool {
  match (a, b) {
    (Some(x), Some(y)) => x.eq(y)
    (None, None) => true
    _ => false
  }
}

///| Strict invariants; returns "" when all hold.
fn inv_line(line : String) -> String {
  let f = split_tabs(line)
  if f.length() < 4 {
    return ""
  }
  let c = match cron::Cron::parse_with_options(unescape(f[1]), opts_of(f[0])) {
    Ok(c) => c
    Err(_) => return ""
  }
  let t = match cron::DateTime::from_unix_secs(parse_i64(f[2])) {
    Ok(dt) => dt
    Err(_) => return ""
  }
  let tag = f[0] + " '" + f[1] + "' @" + f[2] + ": "
  let nx = c.next_after(t)
  let nxi = c.next_after_inclusive(t)
  let pv = c.prev_before(t)
  let pvi = c.prev_before_inclusive(t)
  let mt = c.matches(t)
  // I1: matches(next) / matches(prev)
  match nx {
    Some(n) => {
      if !c.matches(n) {
        return tag + "I1 next " + n.to_string() + " does not match"
      }
      if n.cmp(t) <= 0 {
        return tag + "I1b next not strictly after"
      }
      // I3: prev_before(next_after(t)) == prev_before_inclusive(t)
      if !same(c.prev_before(n), pvi) {
        return tag +
        "I3 prev_before(next)=" +
        opt_str(c.prev_before(n)) +
        " != prev_before_inclusive(t)=" +
        opt_str(pvi)
      }
    }
    None => ()
  }
  match pv {
    Some(p) => {
      if !c.matches(p) {
        return tag + "I2 prev " + p.to_string() + " does not match"
      }
      if p.cmp(t) >= 0 {
        return tag + "I2b prev not strictly before"
      }
      // I4: next_after(prev_before(t)) == next_after_inclusive(t)
      if !same(c.next_after(p), nxi) {
        return tag +
        "I4 next_after(prev)=" +
        opt_str(c.next_after(p)) +
        " != next_after_inclusive(t)=" +
        opt_str(nxi)
      }
    }
    None => ()
  }
  // I5: inclusive variants agree with matches()
  if mt {
    if !same(nxi, Some(t)) || !same(pvi, Some(t)) {
      return tag + "I5 t matches but inclusive search did not return t"
    }
  } else {
    if !same(nxi, nx) || !same(pvi, pv) {
      return tag + "I5 t does not match but inclusive != strict"
    }
  }
  // I6: unix helpers agree
  let tu = t.to_unix_secs()
  match (c.next_after_unix(tu), nx) {
    (Some(a), Some(b)) => if a != b.to_unix_secs() { return tag + "I6 next_after_unix mismatch" }
    (None, None) => ()
    _ => return tag + "I6 next_after_unix presence mismatch"
  }
  if c.matches_unix(tu) != mt {
    return tag + "I6 matches_unix mismatch"
  }
  ""
}

///| Adversarial head-to-head bench (same workload as rust/go/java probes, SHA-256 checked).
/// bench-step <file> <steps> <rounds>: every round restarts each expression at 2024-01-01T00:00:00Z
/// and chains `steps` next_after calls; bench-parse <file> <rounds>: parse every line `rounds`
/// times (errors counted), next_after(2024-01-01) folded on the last round.
/// bench-parse-fold: Pion-only DCE control, additionally folds every parsed mask into the output.
fn bench(world : World, mode : String, path : String, steps : Int, rounds : Int) -> Int {
  let lines = read_lines(world, path)
  let opts : Array[cron::ParseOptions] = []
  let exprs : Array[String] = []
  let mut i = 0
  while i < lines.length() {
    let f = split_tabs(lines[i])
    opts.push(opts_of(f[0]))
    exprs.push(unescape(f[1]))
    i = i + 1
  }
  let base = match cron::DateTime::from_unix_secs(1704067200L) {
    Ok(v) => v
    Err(_) => return 2
  }
  let mut ops = 0L
  let mut errs = 0L
  let mut sum = 0L
  let mut xor = 0L
  let mut fold = 0UL
  if mode == "bench-step" {
    let compiled : Array[cron::Cron] = []
    i = 0
    while i < exprs.length() {
      match cron::Cron::parse_with_options(exprs[i], opts[i]) {
        Ok(c) => compiled.push(c)
        Err(_) => return 3
      }
      i = i + 1
    }
    let mut r = 0
    while r < rounds {
      let mut j = 0
      while j < compiled.length() {
        let c = compiled[j]
        let mut cur = base
        let mut k = 0
        while k < steps {
          match c.next_after(cur) {
            Some(n) => {
              let ts = n.to_unix_secs()
              sum = sum + ts
              xor = xor ^ ts
              cur = n
              ops = ops + 1L
            }
            None => {
              errs = errs + 1L
              break
            }
          }
          k = k + 1
        }
        j = j + 1
      }
      r = r + 1
    }
  } else {
    let mut r = 0
    while r < rounds {
      let mut j = 0
      while j < exprs.length() {
        match cron::Cron::parse_with_options(exprs[j], opts[j]) {
          Ok(c) => {
            ops = ops + 1L
            if mode == "bench-parse-fold" {
              fold = fold ^ c.seconds_mask ^ (c.minutes_mask << 1) ^ (c.hours_mask << 2) ^
              (c.dom_mask << 3) ^ (c.months_mask << 4) ^ (c.dow_mask << 5) ^ c.flags.to_uint64()
            }
            if r == rounds - 1 {
              match c.next_after(base) {
                Some(n) => {
                  let ts = n.to_unix_secs()
                  sum = sum + ts
                  xor = xor ^ ts
                }
                None => ()
              }
            }
          }
          Err(_) => errs = errs + 1L
        }
        j = j + 1
      }
      r = r + 1
    }
  }
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "none_or_err=" + errs.to_string())
  io_println(world, "sum=" + sum.to_string())
  io_println(world, "xor=" + xor.to_string())
  if mode == "bench-parse-fold" {
    io_println(world, "fold=" + fold.to_string())
  }
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: cron_audit_probe diff|inv <file> | unix <secs> | time <opts> <expr> <start> <n>")
    return 2
  }
  let mode = args[1]
  if mode == "bench-step" {
    return bench(world, mode, args[2], parse_i64(args[3]).to_int(), parse_i64(args[4]).to_int())
  }
  if mode == "bench-parse" || mode == "bench-parse-fold" {
    return bench(world, mode, args[2], 0, parse_i64(args[3]).to_int())
  }
  if mode == "unix" {
    let s = parse_i64(args[2])
    match cron::DateTime::from_unix_secs(s) {
      Ok(dt) => io_println(world, "OK " + dt.to_string() + " back=" + dt.to_unix_secs().to_string())
      Err(e) => io_println(world, "ERR " + cron::cron_error_to_string(e))
    }
    return 0
  }
  if mode == "time" {
    let c = match cron::Cron::parse_with_options(unescape(args[3]), opts_of(args[2])) {
      Ok(c) => c
      Err(e) => {
        io_println(world, "ERR " + cron::cron_error_to_string(e))
        return 0
      }
    }
    let mut cur = match cron::DateTime::from_unix_secs(parse_i64(args[4])) {
      Ok(dt) => dt
      Err(_) => return 2
    }
    let n = parse_i64(args[5]).to_int()
    let mut k = 0
    let mut found = 0
    while k < n {
      match c.next_after(cur) {
        Some(nx) => {
          cur = nx
          found = found + 1
        }
        None => break
      }
      k = k + 1
    }
    io_println(world, "found=" + found.to_string() + " last=" + cur.to_string())
    return 0
  }
  let lines = read_lines(world, args[2])
  let sb = StringBuilder::new()
  let mut bad = 0
  let mut i = 0
  while i < lines.length() {
    if mode == "diff" {
      sb.write_string(diff_line(lines[i]))
      sb.write_char('\n')
    } else {
      let r = inv_line(lines[i])
      if r.length() > 0 {
        bad = bad + 1
        if bad <= 200 {
          sb.write_string(r)
          sb.write_char('\n')
        }
      }
    }
    if sb.length() > 1000000 {
      io_print(world, sb.to_string())
      sb.reset()
    }
    i = i + 1
  }
  if mode == "inv" {
    sb.write_string("inv: " + lines.length().to_string() + " cases, " + bad.to_string() + " violations\n")
  }
  io_print(world, sb.to_string())
  0
}
