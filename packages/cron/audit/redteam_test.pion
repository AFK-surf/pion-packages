///| Red-team regression tests for packages/cron @ 2eac9b1 (branch feat/pkg-cron).
///
/// Every `redteam_*` test asserts the behaviour of an upstream reference (Rust croner 2.1.0,
/// Quartz 2.3.2 org.quartz.CronExpression, Go robfig/cron/v3 v3.0.1, chrono / Go time) where that
/// reference is unambiguous -- a FAILURE here is the evidence (see REPORT.md, F-ids).
/// `control_*` tests are attacks Pion survived (several of them break croner or Quartz);
/// they must keep passing.
/// The year-list DoS (F4) cannot live in a unit test that must finish quickly: it is reproduced
/// with timings by ./run_audit.sh (section 5).
///
/// Run: pionc test --json packages/cron/audit

import "cron"

///|
fn dt(y : Int, mo : Int, d : Int, h : Int, mi : Int, s : Int) -> cron::DateTime {
  match cron::DateTime::new(y, mo, d, h, mi, s) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "bad test datetime: " + cron::cron_error_to_string(e))
      cron::DateTime::{ year: 2000, month: 1, day: 1, hour: 0, minute: 0, second: 0 }
    }
  }
}

///|
fn cr(expr : String) -> cron::Cron {
  match cron::Cron::parse(expr) {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "expected '" + expr + "' to parse: " + cron::cron_error_to_string(e))
      match cron::Cron::parse("* * * * *") {
        Ok(c) => c
        Err(_) => panic()
      }
    }
  }
}

///|
fn show(o : Option[cron::DateTime]) -> String {
  match o {
    Some(v) => v.to_string()
    None => "None"
  }
}

///|
fn rejects_unix(ts : Int64) -> Bool {
  match cron::DateTime::from_unix_secs(ts) {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn rejects(expr : String) -> Bool {
  match cron::Cron::parse(expr) {
    Ok(_) => false
    Err(_) => true
  }
}

///|
fn expect_next(c : cron::Cron, from : cron::DateTime, want : cron::DateTime, label : String) -> Unit {
  let got = c.next_after(from)
  let ok = match got {
    Some(v) => v.eq(want)
    None => false
  }
  debug_assert(ok, label + ": next_after(" + from.to_string() + ") want " + want.to_string() + ", got " + show(got))
}

///|
fn expect_prev(c : cron::Cron, from : cron::DateTime, want : cron::DateTime, label : String) -> Unit {
  let got = c.prev_before(from)
  let ok = match got {
    Some(v) => v.eq(want)
    None => false
  }
  debug_assert(ok, label + ": prev_before(" + from.to_string() + ") want " + want.to_string() + ", got " + show(got))
}

// ---------------------------------------------------------------------------
// F1 (P1) DOW "7/<step>": 7 is Sunday, "a/s" means "a..max step s" (croner: a..7). Starting at 7
// can only ever yield Sunday. croner 2.1.0: "0 0 * * 7/2" and "0 0 * * 7/1" fire on Sundays only;
// Vixie cron and robfig reject the expression. Pion maps 7 -> 0 *before* expanding and fires on
// Sun/Tue/Thu/Sat ("7/2") or on every day ("7/1").
// ---------------------------------------------------------------------------

///|
test "redteam_F1_dow_7_slash_2_is_sunday_only" {
  match cron::Cron::parse("0 0 * * 7/2") {
    Err(_) => () // rejecting (Vixie / robfig behaviour) is also acceptable
    Ok(c) => {
      // 2024-01-01 is a Monday; croner: 2024-01-07 (Sun), 2024-01-14 (Sun)
      expect_next(c, dt(2024, 1, 1, 0, 0, 0), dt(2024, 1, 7, 0, 0, 0), "7/2")
      expect_next(c, dt(2024, 1, 7, 0, 0, 0), dt(2024, 1, 14, 0, 0, 0), "7/2 second hit")
      debug_assert(!c.matches(dt(2024, 1, 2, 0, 0, 0)), "7/2 must not match Tuesday 2024-01-02")
    }
  }
}

///|
test "redteam_F1_dow_7_slash_1_is_sunday_only" {
  match cron::Cron::parse("0 0 * * 7/1") {
    Err(_) => ()
    Ok(c) => {
      expect_next(c, dt(2024, 1, 1, 0, 0, 0), dt(2024, 1, 7, 0, 0, 0), "7/1")
      expect_prev(c, dt(2024, 1, 7, 0, 0, 0), dt(2023, 12, 31, 0, 0, 0), "7/1 prev")
    }
  }
}

// ---------------------------------------------------------------------------
// F2 (P1) Year "*/n" anchoring. The 7th (year) field is Quartz syntax; Quartz 2.3.2 anchors "*" in
// the year field at 1970 (its year minimum), so "*/2" = 1970, 1972, ... (even years) and "*/5" =
// 1970, 1975, ..., 2025, 2030. Pion anchors at year 1: "*/2" fires on odd years, "*/5" on 2026,
// 2031 -- every "every N years" schedule fires in different years than Quartz.
// ---------------------------------------------------------------------------

///|
test "redteam_F2_year_star_slash_2_matches_quartz_even_years" {
  let c = cr("0 0 0 1 1 ? */2")
  debug_assert(c.matches(dt(2024, 1, 1, 0, 0, 0)), "Quartz: 2024-01-01 matches '*/2' (1970 + 2k)")
  expect_next(c, dt(2024, 1, 1, 0, 0, 0), dt(2026, 1, 1, 0, 0, 0), "year */2")
}

///|
test "redteam_F2_year_star_slash_5_matches_quartz" {
  let c = cr("0 0 0 1 1 ? */5")
  // Quartz 2.3.2 getTimeAfter(2024-01-01T00:00:00Z) = 2025-01-01, then 2030-01-01
  expect_next(c, dt(2024, 1, 1, 0, 0, 0), dt(2025, 1, 1, 0, 0, 0), "year */5")
  expect_next(c, dt(2025, 1, 1, 0, 0, 0), dt(2030, 1, 1, 0, 0, 0), "year */5 second hit")
}

// ---------------------------------------------------------------------------
// F3 (P1) DateTime::from_unix_secs aliasing. civil_from_days truncates the 400-year era count to
// 32-bit Int and the year arithmetic wraps, so a timestamp ~1.07e11 years in the future decodes
// to a valid in-range date: 3388401920987913600 -> Ok(2000-03-01T00:00:00Z) (to_unix_secs gives
// 951868800). chrono (croner) and Go time never alias: chrono returns None, Go keeps the year.
// next_after_unix / matches_unix inherit it (a "next" occurrence ~1e11 years in the *past*).
// ---------------------------------------------------------------------------

///|
test "redteam_F3_from_unix_secs_rejects_aliased_timestamp" {
  let ts = 3388401920987913600L // (2^28 * 146097 + 730485 - 719468) * 86400
  match cron::DateTime::from_unix_secs(ts) {
    Err(_) => ()
    Ok(v) =>
    debug_assert(
      false,
      "from_unix_secs(" + ts.to_string() + ") must be Err (year ~1.07e11), got " + v.to_string() +
      " (round-trips to " + v.to_unix_secs().to_string() + ")",
    )
  }
}

///|
test "redteam_F3_next_after_unix_never_goes_backwards" {
  let ts = 3388401920987913600L
  let c = cr("0 0 * * *")
  match c.next_after_unix(ts) {
    None => ()
    Some(n) =>
    debug_assert(n > ts, "next_after_unix(" + ts.to_string() + ") returned an earlier time " + n.to_string())
  }
  debug_assert(!c.matches_unix(ts), "matches_unix on an out-of-range timestamp must be false")
}

///|
test "redteam_F3_negative_alias_rejected" {
  // Same wrap on the negative side: era = -2^28.
  let ts = (0L - 268435456L * 146097L + 730485L - 719468L) * 86400L
  match cron::DateTime::from_unix_secs(ts) {
    Err(_) => ()
    Ok(v) => debug_assert(false, "from_unix_secs(" + ts.to_string() + ") must be Err, got " + v.to_string())
  }
}

// ---------------------------------------------------------------------------
// F5 (P2) DateTime is a `pub val struct` with public fields, so callers can build it with a
// struct literal and skip DateTime::new validation. matches()/next_after() then shift the
// 64-bit masks by >= 64, which wraps: second=64 "matches" a second-0 schedule. chrono / Go time
// cannot represent such values at all.
// ---------------------------------------------------------------------------

///|
test "redteam_F5_unvalidated_datetime_literal_never_matches" {
  let c = cr("0 * * * * *")
  let bad = cron::DateTime::{ year: 2024, month: 1, day: 1, hour: 0, minute: 0, second: 64 }
  debug_assert(!c.matches(bad), "second=64 must not match a second-0 schedule")
  let bad2 = cron::DateTime::{ year: 2024, month: 1, day: 1, hour: 0, minute: 64, second: 0 }
  debug_assert(!c.matches(bad2), "minute=64 must not match")
}

// ---------------------------------------------------------------------------
// F6 (P2) Quartz accepts "L-0" (== "L", offset 0 from the last day). Pion rejects it.
// ---------------------------------------------------------------------------

///|
test "redteam_F6_quartz_L_minus_0_is_last_day" {
  match cron::Cron::parse("0 0 0 L-0 * ?") {
    Err(e) => debug_assert(false, "Quartz accepts 'L-0' (== 'L'); Pion: " + cron::cron_error_to_string(e))
    Ok(c) => expect_next(c, dt(2024, 1, 1, 0, 0, 0), dt(2024, 1, 31, 0, 0, 0), "L-0")
  }
}

// ---------------------------------------------------------------------------
// Controls: attacks Pion survived. Several break an upstream (noted per test).
// ---------------------------------------------------------------------------

///|
test "control_1W_on_saturday_moves_forward_within_month" {
  // 2022-01-01 is a Saturday -> Quartz: Monday 2022-01-03 (never the previous month).
  // croner 2.1.0 gets this wrong: it fires on 2021-12-31 (previous month).
  let c = cr("0 0 0 1W * ?")
  expect_next(c, dt(2021, 12, 15, 0, 0, 0), dt(2022, 1, 3, 0, 0, 0), "1W Sat")
  // 2024-06-01 is a Saturday -> 2024-06-03; croner returns 2024-05-31.
  expect_next(c, dt(2024, 5, 15, 0, 0, 0), dt(2024, 6, 3, 0, 0, 0), "1W Sat June")
}

///|
test "control_last_day_W_on_sunday_moves_back_within_month" {
  // 2023-12-31 is a Sunday -> Friday 2023-12-29 (never 2024-01-01; croner 2.1.0 returns 2024-01-01).
  expect_next(cr("0 0 0 31W * ?"), dt(2023, 12, 15, 0, 0, 0), dt(2023, 12, 29, 0, 0, 0), "31W Sun")
  // 2026-02-28 is a Saturday -> Friday 2026-02-27.
  expect_next(cr("0 0 0 28W 2 ?"), dt(2026, 1, 1, 0, 0, 0), dt(2026, 2, 27, 0, 0, 0), "28W Sat")
}

///|
test "control_LW_leap_february" {
  let c = cr("0 0 0 LW 2 ?")
  // 2020-02-29 is a Saturday -> Friday 28th; 2024-02-29 is a Thursday.
  expect_next(c, dt(2020, 1, 1, 0, 0, 0), dt(2020, 2, 28, 0, 0, 0), "LW 2020")
  expect_next(c, dt(2024, 1, 1, 0, 0, 0), dt(2024, 2, 29, 0, 0, 0), "LW 2024")
}

///|
test "control_nth_and_last_weekday" {
  // 5th Friday does not exist every month: after 2024-03-29 the next one is 2024-05-31.
  expect_next(cr("0 0 0 ? * FRI#5"), dt(2024, 3, 29, 0, 0, 0), dt(2024, 5, 31, 0, 0, 0), "FRI#5")
  // "7L" (last Sunday): croner 2.1.0 never fires at all.
  expect_next(cr("0 0 0 ? * 7L"), dt(2024, 1, 1, 0, 0, 0), dt(2024, 1, 28, 0, 0, 0), "7L")
  expect_next(cr("0 0 0 ? * 0#1"), dt(2024, 1, 1, 0, 0, 0), dt(2024, 1, 7, 0, 0, 0), "0#1")
  expect_next(cr("0 0 0 ? * 7#1"), dt(2024, 1, 1, 0, 0, 0), dt(2024, 1, 7, 0, 0, 0), "7#1")
}

///|
test "control_0W_rejected_quartz_hangs" {
  // Quartz 2.3.2 accepts "0 0 0 0W * ?" and getTimeAfter() spins forever.
  match cron::Cron::parse("0 0 0 0W * ?") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "'0W' must be rejected")
  }
}

///|
test "control_impossible_and_sparse_years_terminate" {
  let probe = dt(2024, 1, 1, 0, 0, 0)
  let none : Array[String] = [
    "0 0 0 29 2 ? 2100-2103", "0 0 0 29 2 * 2100-2103", "0 0 0 31 2,4,6,9,11 ?", "0 0 0 30 2 ? 1-9999",
  ]
  let mut i = 0
  while i < none.length() {
    let c = cr(none[i])
    debug_assert(show(c.next_after(probe)) == "None", none[i] + " next must be None")
    debug_assert(show(c.prev_before(probe)) == "None", none[i] + " prev must be None")
    i = i + 1
  }
  // 2096-02-29 -> 2104-02-29 (robfig's 5-year horizon misses this) and 2000/2400 century leaps
  expect_next(cr("0 0 29 2 *"), dt(2096, 2, 29, 0, 0, 0), dt(2104, 2, 29, 0, 0, 0), "leap gap")
  expect_next(
    cr("0 0 0 29 2 ? 2000,2100,2400"),
    dt(2000, 2, 29, 0, 0, 0),
    dt(2400, 2, 29, 0, 0, 0),
    "2100 skipped",
  )
  expect_next(cr("0 0 0 1 1 ? 9999"), dt(2024, 1, 1, 0, 0, 0), dt(9999, 1, 1, 0, 0, 0), "year 9999")
}

///|
test "control_calendar_extremes_and_negative_unix" {
  let cases : Array[(Int64, String)] = [
    (-1L, "1969-12-31T23:59:59Z"),
    (-86400L, "1969-12-31T00:00:00Z"),
    (-2208988800L, "1900-01-01T00:00:00Z"),
    (-11644473600L, "1601-01-01T00:00:00Z"),
    (-62135596800L, "0001-01-01T00:00:00Z"),
    (253402300799L, "9999-12-31T23:59:59Z"),
  ]
  let mut i = 0
  while i < cases.length() {
    let (ts, want) = cases[i]
    match cron::DateTime::from_unix_secs(ts) {
      Ok(v) => {
        debug_assert(v.to_string() == want, ts.to_string() + " -> " + v.to_string() + " want " + want)
        debug_assert(v.to_unix_secs() == ts, ts.to_string() + " round trip")
      }
      Err(_) => debug_assert(false, ts.to_string() + " must decode")
    }
    i = i + 1
  }
  debug_assert(rejects_unix(-62135596801L), "year 0 rejected")
  debug_assert(rejects_unix(253402300800L), "year 10000 rejected")
  let every = cr("* * * * * *")
  debug_assert(show(every.next_after(dt(9999, 12, 31, 23, 59, 59))) == "None", "no next after 9999-12-31T23:59:59")
  debug_assert(show(every.prev_before(dt(1, 1, 1, 0, 0, 0))) == "None", "no prev before 0001-01-01")
  expect_prev(cr("0 0 0 29 2 ?"), dt(5, 1, 1, 0, 0, 0), dt(4, 2, 29, 0, 0, 0), "prev leap year 4")
}

///|
test "control_malformed_input_rejected" {
  let bad : Array[String] = [
    "0-59/99999999999999999999 * * * *", "*/0 * * * *", "1-2-3 * * * *", "1//2 * * * *",
    "1,,2 * * * *", "0 0 0 ? * FRI#6", "0 0 0 ? * FRI#0", "0 0 0 L-31 * ?", "0 0 0 32W * ?",
    "0 0 0 1 1 ? 2026-2024", "0 0 0 1 1 ? 0", "0 0 0 1 1 ? 10000", "0 0 0 1 1 ? 2024 extra",
    "0 0 \u{0} * *", "0 0 1\u{FF11} * *", "@reboot", "@every 5m",
  ]
  let mut i = 0
  while i < bad.length() {
    debug_assert(rejects(bad[i]), "must reject '" + bad[i] + "'")
    i = i + 1
  }
}

///|
test "control_bijection_spot_checks" {
  let exprs : Array[String] = [
    "*/7 */5 */3 L,15W * ?", "0 0 0 ? 2 FRI#5", "0 30 9 LW * ?", "0 0 12 ? * MON-FRI 2024-2026",
    "0 0 0 L-30 * ?", "0 0 22-2/2 * * *", "0 0 0 * * 5-7",
  ]
  let starts = [dt(2024, 2, 29, 12, 0, 0), dt(1, 1, 1, 0, 0, 1), dt(9999, 12, 31, 0, 0, 0)]
  let mut i = 0
  while i < exprs.length() {
    let c = cr(exprs[i])
    let mut j = 0
    while j < starts.length() {
      let t = starts[j]
      match c.next_after(t) {
        Some(n) => {
          debug_assert(c.matches(n), exprs[i] + " next must match")
          let back = c.prev_before(n)
          let want = c.prev_before_inclusive(t)
          debug_assert(show(back) == show(want), exprs[i] + " prev(next(t)) == prev_incl(t)")
        }
        None => ()
      }
      j = j + 1
    }
    i = i + 1
  }
}
