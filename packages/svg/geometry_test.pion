///| 2D Affine Transform, ViewBox, Analytical BBox, Adaptive Flattening, and Path Length tests.

fn g_approx(a : Double, b : Double, eps : Double) -> Bool {
  (a - b).abs() <= eps
}

///|
test "transform__all_6_functions_and_composition" {
  let t1 = match parse_transform("translate(10, 20) scale(2, 3)") {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, "parse_transform err: " + e.to_string())
      Transform2D::identity()
    }
  }
  // SVG applies right-to-left on points: first scale(2,3) -> (2, 6), then translate(10,20) -> (12, 26)
  let p = t1.apply_point(Point::new(1.0, 2.0))
  debug_assert(g_approx(p.x, 12.0, 1e-9) && g_approx(p.y, 26.0, 1e-9), "translate * scale")

  // rotate(90, 10, 10) maps (20, 10) -> (10, 20)
  let r = match parse_transform("rotate(90 10 10)") {
    Ok(t) => t
    Err(e) => {
      debug_assert(false, "rotate err: " + e.to_string())
      Transform2D::identity()
    }
  }
  let pr = r.apply_point(Point::new(20.0, 10.0))
  debug_assert(g_approx(pr.x, 10.0, 1e-9) && g_approx(pr.y, 20.0, 1e-9), "rotate(90, 10, 10)")

  // skewX(45): x' = x + y * tan(45 deg) = x + y
  let sx = match parse_transform("skewX(45)") {
    Ok(t) => t
    Err(_) => {
      debug_assert(false, "skewX err")
      Transform2D::identity()
    }
  }
  let psx = sx.apply_point(Point::new(3.0, 4.0))
  debug_assert(g_approx(psx.x, 7.0, 1e-9) && g_approx(psx.y, 4.0, 1e-9), "skewX(45)")

  // skewY(45): y' = y + x * tan(45 deg) = y + x
  let sy = match parse_transform("skewY(45)") {
    Ok(t) => t
    Err(_) => {
      debug_assert(false, "skewY err")
      Transform2D::identity()
    }
  }
  let psy = sy.apply_point(Point::new(3.0, 4.0))
  debug_assert(g_approx(psy.x, 3.0, 1e-9) && g_approx(psy.y, 7.0, 1e-9), "skewY(45)")

  // matrix(a b c d e f) and invert()
  let m = match parse_transform("matrix(1 2 3 4 5 6)") {
    Ok(t) => t
    Err(_) => {
      debug_assert(false, "matrix err")
      Transform2D::identity()
    }
  }
  let inv = match m.invert() {
    Some(i) => i
    None => {
      debug_assert(false, "matrix should be invertible")
      Transform2D::identity()
    }
  }
  let id = m.multiply(inv)
  let q = id.apply_point(Point::new(7.0, -3.0))
  debug_assert(g_approx(q.x, 7.0, 1e-9) && g_approx(q.y, -3.0, 1e-9), "m * m^-1 == I")

  // Singular matrix has None inverse
  let singular = Transform2D::scale(0.0, 1.0)
  match singular.invert() {
    None => ()
    Some(_) => debug_assert(false, "singular matrix must return None")
  }
}

///|
test "transform__viewbox_and_preserve_aspect_ratio" {
  let vb = match parse_viewbox("10 20 100 50") {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "viewBox err: " + e.to_string())
      ViewBox::new(0.0, 0.0, 1.0, 1.0)
    }
  }
  // Viewport 200x200 with xMidYMid meet: scale = min(200/100, 200/50) = 2.0
  // Scaled size = 200x100, centered vertically -> y offset = +50
  let par_meet = match parse_preserve_aspect_ratio("xMidYMid meet") {
    Ok(p) => p
    Err(_) => {
      debug_assert(false, "par err")
      PreserveAspectRatio::default()
    }
  }
  let tm = viewbox_transform(vb, 200.0, 200.0, par_meet)
  let top_left = tm.apply_point(Point::new(10.0, 20.0))
  let bot_right = tm.apply_point(Point::new(110.0, 70.0))
  debug_assert(g_approx(top_left.x, 0.0, 1e-9) && g_approx(top_left.y, 50.0, 1e-9), "meet top_left")
  debug_assert(g_approx(bot_right.x, 200.0, 1e-9) && g_approx(bot_right.y, 150.0, 1e-9), "meet bot_right")

  // preserveAspectRatio="none": stretches to fill 200x200
  let par_none = match parse_preserve_aspect_ratio("none") {
    Ok(p) => p
    Err(_) => {
      debug_assert(false, "par none err")
      PreserveAspectRatio::default()
    }
  }
  let tn = viewbox_transform(vb, 200.0, 200.0, par_none)
  let n_br = tn.apply_point(Point::new(110.0, 70.0))
  debug_assert(g_approx(n_br.x, 200.0, 1e-9) && g_approx(n_br.y, 200.0, 1e-9), "none stretch")
}

///|
test "geometry__exact_analytical_cubic_bbox_tighter_than_control_hull" {
  // Cubic from (0,0) to (100,0) with control points (0,100) and (100,100).
  // Control hull max_y is 100, but true curve maximum is at t=0.5:
  // B_y(0.5) = 3*(0.25)*(0.5)*100 + 3*(0.5)*(0.25)*100 = 75.0!
  let p = match parse_path("M 0 0 C 0 100 100 100 100 0") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse err")
      SvgPath::{ segments: [] }
    }
  }
  let bb = match path_bbox(p) {
    Some(r) => r
    None => {
      debug_assert(false, "expected bbox")
      Rect::new(0.0, 0.0, 0.0, 0.0)
    }
  }
  debug_assert(g_approx(bb.min_x, 0.0, 1e-6), "min_x")
  debug_assert(g_approx(bb.max_x, 100.0, 1e-6), "max_x")
  debug_assert(g_approx(bb.min_y, 0.0, 1e-6), "min_y")
  debug_assert(g_approx(bb.max_y, 75.0, 1e-6), "exact max_y must be 75.0, not control hull 100.0")
}

///|
test "geometry__exact_analytical_quadratic_and_arc_bbox" {
  // Quadratic from (0,0) with ctrl (50, 100) to (100,0): true peak at t=0.5 is y=50.0!
  let pq = match parse_path("M 0 0 Q 50 100 100 0") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse err")
      SvgPath::{ segments: [] }
    }
  }
  let bbq = match path_bbox(pq) {
    Some(r) => r
    None => {
      debug_assert(false, "expected q bbox")
      Rect::new(0.0, 0.0, 0.0, 0.0)
    }
  }
  debug_assert(g_approx(bbq.max_y, 50.0, 1e-6), "quadratic exact peak y=50.0")

  // Circle of radius 10 centered at (10, 10) via two arcs -> exact bbox [0, 0, 20, 20]
  let pc = match parse_path("M 0 10 A 10 10 0 1 0 20 10 A 10 10 0 1 0 0 10 Z") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse err")
      SvgPath::{ segments: [] }
    }
  }
  let bbc = match path_bbox(pc) {
    Some(r) => r
    None => {
      debug_assert(false, "expected circle bbox")
      Rect::new(0.0, 0.0, 0.0, 0.0)
    }
  }
  debug_assert(
    g_approx(bbc.min_x, 0.0, 1e-3) &&
    g_approx(bbc.min_y, 0.0, 1e-3) &&
    g_approx(bbc.max_x, 20.0, 1e-3) &&
    g_approx(bbc.max_y, 20.0, 1e-3),
    "circle arc bbox [0,0,20,20]",
  )
}

///|
test "geometry__flatten_path_adaptive_tolerance_and_closure" {
  // Full circle of radius 10 centered at (10, 10)
  let p = match parse_path("M 0 10 A 10 10 0 1 0 20 10 A 10 10 0 1 0 0 10 Z") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse err")
      SvgPath::{ segments: [] }
    }
  }
  let polys = match flatten_path(p, 0.05) {
    Ok(pl) => pl
    Err(e) => {
      debug_assert(false, "flatten err: " + e.to_string())
      []
    }
  }
  debug_assert(polys.length() == 1, "single closed contour")
  debug_assert(polys[0].closed, "contour must be closed")
  debug_assert(polys[0].points.length() >= 16, "enough points for 0.05 tolerance")
  // Every point must lie within tolerance of circle radius 10 around (10, 10)
  let mut i = 0
  while i < polys[0].points.length() {
    let pt = polys[0].points[i]
    let dx = pt.x - 10.0
    let dy = pt.y - 10.0
    let r = (dx * dx + dy * dy).sqrt()
    debug_assert((r - 10.0).abs() <= 0.1, "flattened circle point radius within tolerance")
    i = i + 1
  }
}

///|
test "geometry__path_length_lines_and_circle" {
  // 3-4-5 right triangle perimeter = 12.0
  let tri = match parse_path("M 0 0 L 3 0 L 3 4 Z") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse err")
      SvgPath::{ segments: [] }
    }
  }
  debug_assert(g_approx(path_length(tri), 12.0, 1e-6), "triangle perimeter == 12")

  // Circle radius 10 circumference = 2 * pi * 10 = 62.831853...
  let circ = match parse_path("M 0 10 A 10 10 0 1 0 20 10 A 10 10 0 1 0 0 10 Z") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse err")
      SvgPath::{ segments: [] }
    }
  }
  let len = path_length(circ)
  debug_assert(g_approx(len, 62.831853, 0.05), "circle circumference ~= 62.831853")
}
