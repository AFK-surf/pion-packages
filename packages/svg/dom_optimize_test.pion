///| SVG Color (148 named + hex + rgb/hsl), DOM, Shape-to-Path, RenderPath Extraction,
///| SVGO Optimizer, and DoS Limits tests.

fn d_approx(a : Double, b : Double, eps : Double) -> Bool {
  (a - b).abs() <= eps
}

///|
test "color__hex_rgb_hsl_and_paints" {
  let c3 = match parse_color("#f0a") {
    Ok(c) => c
    Err(_) => {
      debug_assert(false, "#f0a")
      SvgColor::rgb(0, 0, 0)
    }
  }
  debug_assert(c3.r == 255 && c3.g == 0 && c3.b == 170 && c3.a == 255, "hex3")

  let c4 = match parse_color("#0f88") {
    Ok(c) => c
    Err(_) => {
      debug_assert(false, "#0f88")
      SvgColor::rgb(0, 0, 0)
    }
  }
  debug_assert(c4.r == 0 && c4.g == 255 && c4.b == 136 && c4.a == 136, "hex4")

  let c6 = match parse_color("#1a2B3c") {
    Ok(c) => c
    Err(_) => {
      debug_assert(false, "#1a2B3c")
      SvgColor::rgb(0, 0, 0)
    }
  }
  debug_assert(c6.r == 0x1a && c6.g == 0x2b && c6.b == 0x3c && c6.a == 255, "hex6")

  let c8 = match parse_color("#11223380") {
    Ok(c) => c
    Err(_) => {
      debug_assert(false, "#11223380")
      SvgColor::rgb(0, 0, 0)
    }
  }
  debug_assert(c8.r == 0x11 && c8.g == 0x22 && c8.b == 0x33 && c8.a == 0x80, "hex8")

  let crgb = match parse_color("rgba(100%, 50%, 0%, 0.5)") {
    Ok(c) => c
    Err(_) => {
      debug_assert(false, "rgba%")
      SvgColor::rgb(0, 0, 0)
    }
  }
  debug_assert(crgb.r == 255 && crgb.g == 128 && crgb.b == 0 && crgb.a == 128, "rgba%")

  let chsl = match parse_color("hsl(120, 100%, 50%)") {
    Ok(c) => c
    Err(_) => {
      debug_assert(false, "hsl")
      SvgColor::rgb(0, 0, 0)
    }
  }
  debug_assert(chsl.r == 0 && chsl.g == 255 && chsl.b == 0 && chsl.a == 255, "hsl green")

  match parse_paint("none") {
    Ok(SvgPaint::None) => ()
    _ => debug_assert(false, "paint none")
  }
  match parse_paint("currentColor") {
    Ok(SvgPaint::CurrentColor) => ()
    _ => debug_assert(false, "paint currentColor")
  }
  match parse_paint("url(#grad1)") {
    Ok(SvgPaint::Url(u)) => debug_assert(u == "#grad1", "paint url")
    _ => debug_assert(false, "paint url")
  }
}

///|
test "color__all_148_svg_named_colors" {
  let names : Array[String] = [
    "aliceblue", "antiquewhite", "aqua", "aquamarine", "azure", "beige", "bisque",
    "black", "blanchedalmond", "blue", "blueviolet", "brown", "burlywood", "cadetblue",
    "chartreuse", "chocolate", "coral", "cornflowerblue", "cornsilk", "crimson", "cyan",
    "darkblue", "darkcyan", "darkgoldenrod", "darkgray", "darkgreen", "darkgrey", "darkkhaki",
    "darkmagenta", "darkolivegreen", "darkorange", "darkorchid", "darkred", "darksalmon",
    "darkseagreen", "darkslateblue", "darkslategray", "darkslategrey", "darkturquoise",
    "darkviolet", "deeppink", "deepskyblue", "dimgray", "dimgrey", "dodgerblue", "firebrick",
    "floralwhite", "forestgreen", "fuchsia", "gainsboro", "ghostwhite", "gold", "goldenrod",
    "gray", "green", "greenyellow", "grey", "honeydew", "hotpink", "indianred", "indigo",
    "ivory", "khaki", "lavender", "lavenderblush", "lawngreen", "lemonchiffon", "lightblue",
    "lightcoral", "lightcyan", "lightgoldenrodyellow", "lightgray", "lightgreen", "lightgrey",
    "lightpink", "lightsalmon", "lightseagreen", "lightskyblue", "lightslategray", "lightslategrey",
    "lightsteelblue", "lightyellow", "lime", "limegreen", "linen", "magenta", "maroon",
    "mediumaquamarine", "mediumblue", "mediumorchid", "mediumpurple", "mediumseagreen",
    "mediumslateblue", "mediumspringgreen", "mediumturquoise", "mediumvioletred", "midnightblue",
    "mintcream", "mistyrose", "moccasin", "navajowhite", "navy", "oldlace", "olive", "olivedrab",
    "orange", "orangered", "orchid", "palegoldenrod", "palegreen", "paleturquoise",
    "palevioletred", "papayawhip", "peachpuff", "peru", "pink", "plum", "powderblue", "purple",
    "rebeccapurple", "red", "rosybrown", "royalblue", "saddlebrown", "salmon", "sandybrown",
    "seagreen", "seashell", "sienna", "silver", "skyblue", "slateblue", "slategray", "slategrey",
    "snow", "springgreen", "steelblue", "tan", "teal", "thistle", "tomato", "turquoise",
    "violet", "wheat", "white", "whitesmoke", "yellow", "yellowgreen",
  ]
  debug_assert(names.length() == 148, "148 SVG named colors")
  let mut i = 0
  while i < names.length() {
    match lookup_svg_color(names[i]) {
      Some(_) => ()
      None => debug_assert(false, "missing named color: " + names[i])
    }
    i = i + 1
  }
  // Case-insensitive parse_color check
  match parse_color("RebeccaPurple") {
    Ok(c) => debug_assert(c.r == 0x66 && c.g == 0x33 && c.b == 0x99, "RebeccaPurple")
    Err(_) => debug_assert(false, "RebeccaPurple failed")
  }
}

///|
test "dom__basic_shapes_to_path" {
  // rect with rounded corners
  let r = match shape_to_path(
    "rect",
    [
      SvgAttr::new("x", "10"),
      SvgAttr::new("y", "20"),
      SvgAttr::new("width", "100"),
      SvgAttr::new("height", "50"),
      SvgAttr::new("rx", "5"),
    ],
  ) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "rect err: " + e.to_string())
      SvgPath::{ segments: [] }
    }
  }
  let bb = match path_bbox(r) {
    Some(b) => b
    None => {
      debug_assert(false, "rect bbox")
      Rect::new(0.0, 0.0, 0.0, 0.0)
    }
  }
  debug_assert(
    d_approx(bb.min_x, 10.0, 1e-3) &&
    d_approx(bb.min_y, 20.0, 1e-3) &&
    d_approx(bb.max_x, 110.0, 1e-3) &&
    d_approx(bb.max_y, 70.0, 1e-3),
    "rounded rect bbox",
  )

  // circle
  let c = match shape_to_path(
    "circle",
    [SvgAttr::new("cx", "12"), SvgAttr::new("cy", "12"), SvgAttr::new("r", "10")],
  ) {
    Ok(p) => p
    Err(_) => {
      debug_assert(false, "circle err")
      SvgPath::{ segments: [] }
    }
  }
  let cbb = match path_bbox(c) {
    Some(b) => b
    None => {
      debug_assert(false, "circle bbox")
      Rect::new(0.0, 0.0, 0.0, 0.0)
    }
  }
  debug_assert(
    d_approx(cbb.min_x, 2.0, 1e-3) &&
    d_approx(cbb.max_x, 22.0, 1e-3) &&
    d_approx(cbb.min_y, 2.0, 1e-3) &&
    d_approx(cbb.max_y, 22.0, 1e-3),
    "circle bbox",
  )

  // ellipse, line, polyline, polygon
  let el = shape_to_path(
    "ellipse",
    [SvgAttr::new("cx", "5"), SvgAttr::new("cy", "5"), SvgAttr::new("rx", "4"), SvgAttr::new("ry", "2")],
  )
  debug_assert(match el { Ok(p) => p.segments.length() > 0; Err(_) => false }, "ellipse")

  let ln = shape_to_path(
    "line",
    [SvgAttr::new("x1", "0"), SvgAttr::new("y1", "0"), SvgAttr::new("x2", "10"), SvgAttr::new("y2", "20")],
  )
  debug_assert(match ln { Ok(p) => p.segments.length() == 2; Err(_) => false }, "line")

  let pl = shape_to_path("polyline", [SvgAttr::new("points", "0,0 10,5 20,0")])
  debug_assert(match pl { Ok(p) => p.segments.length() == 3; Err(_) => false }, "polyline")

  let pg = shape_to_path("polygon", [SvgAttr::new("points", "0,0 10,0 5,10")])
  debug_assert(match pg { Ok(p) => p.segments.length() == 4; Err(_) => false }, "polygon closed")
}

///|
test "dom__parse_and_extract_render_paths_with_transforms_and_style" {
  let src = "<?xml version=\"1.0\"?><!-- comment --><svg viewBox=\"0 0 24 24\"><defs><path id=\"hidden\" d=\"M0 0L1 1\"/></defs><g transform=\"translate(10, 0)\" fill=\"#ff0000\" stroke=\"blue\"><rect id=\"r1\" x=\"0\" y=\"0\" width=\"4\" height=\"4\" style=\"fill: #00ff00; stroke-width: 2\"/><g transform=\"scale(2)\"><circle id=\"c1\" cx=\"5\" cy=\"5\" r=\"3\"/></g></g></svg>"
  let doc = match parse_svg(src) {
    Ok(d) => d
    Err(e) => {
      debug_assert(false, "parse_svg err: " + e.to_string())
      SvgDocument::{ nodes: [], root: -1 }
    }
  }
  let paths = match extract_render_paths(doc) {
    Ok(ps) => ps
    Err(e) => {
      debug_assert(false, "extract err: " + e.to_string())
      []
    }
  }
  // <defs> path must be excluded -> only r1 and c1 remain
  debug_assert(paths.length() == 2, "expected 2 renderable paths")
  debug_assert(paths[0].id == "r1", "first path is r1")
  // r1 inline style overrides fill to #00ff00, inherits stroke=blue, stroke_width=2
  match paths[0].style.fill {
    SvgPaint::Color(c) => debug_assert(c.r == 0 && c.g == 255 && c.b == 0, "inline style fill override")
    _ => debug_assert(false, "expected green fill")
  }
  debug_assert(d_approx(paths[0].style.stroke_width, 2.0, 1e-9), "inline stroke-width")
  // c1 has composed transform translate(10,0) * scale(2) -> maps (5,5) to (20,10)
  debug_assert(paths[1].id == "c1", "second path is c1")
  let center = paths[1].transform.apply_point(Point::new(5.0, 5.0))
  debug_assert(d_approx(center.x, 20.0, 1e-9) && d_approx(center.y, 10.0, 1e-9), "composed ancestor transform")
}

///|
test "optimize__svgo_removes_cruft_and_compacts_paths_and_colors" {
  let src = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- created by tool -->\n<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n  <metadata><rdf>info</rdf></metadata>\n  <g></g>\n  <g><g><path fill=\"#ffffff\" d=\"M 0.50000 -0.50000 L 10.00000 20.00000 A 5 5 0 0 1 15 20 Z\"/></g></g>\n</svg>"
  let opts = OptimizeOptions::default()
  let out = match optimize_svg(src, opts) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "optimize_svg err: " + e.to_string())
      ""
    }
  }
  debug_assert(out.length() < src.length(), "optimized output must be smaller")
  debug_assert(!out.contains("<?xml"), "xml decl removed")
  debug_assert(!out.contains("<!--"), "comments removed")
  debug_assert(!out.contains("<metadata"), "metadata removed")
  debug_assert(!out.contains("<g></g>"), "empty group removed")
  debug_assert(out.contains("fill=\"#fff\""), "color minified to #fff")
  debug_assert(out.contains("d=\"M.5-.5 10 20A5 5 0 0115 20Z\""), "path compacted: " + out)
}

///|
test "security__dos_limits_enforced" {
  // 1. max_input_bytes
  let tiny_limits = SvgLimits::{
    max_depth: 4,
    max_elements: 5,
    max_path_segments: 3,
    max_flatten_points: 10,
    max_input_bytes: 16,
  }
  match parse_path_with_limits("M 0 0 L 1 1 L 2 2 L 3 3 L 4 4", tiny_limits) {
    Err(e) => {
      match e.kind {
        SvgErrorKind::LimitExceeded => ()
        _ => debug_assert(false, "expected LimitExceeded for input bytes")
      }
    }
    Ok(_) => debug_assert(false, "must reject oversized path input")
  }

  // 2. max_path_segments
  let seg_limits = SvgLimits::{
    max_depth: 128,
    max_elements: 1000,
    max_path_segments: 2,
    max_flatten_points: 1000,
    max_input_bytes: 1024,
  }
  match parse_path_with_limits("M0 0L1 1L2 2", seg_limits) {
    Err(e) => {
      match e.kind {
        SvgErrorKind::LimitExceeded => ()
        _ => debug_assert(false, "expected LimitExceeded for path segments")
      }
    }
    Ok(_) => debug_assert(false, "must reject > max_path_segments")
  }

  // 3. max_depth (deeply nested <g>)
  let sb = StringBuilder::new()
  sb.write_string("<svg>")
  let mut i = 0
  while i < 10 {
    sb.write_string("<g>")
    i = i + 1
  }
  i = 0
  while i < 10 {
    sb.write_string("</g>")
    i = i + 1
  }
  sb.write_string("</svg>")
  let depth_limits = SvgLimits::{
    max_depth: 5,
    max_elements: 1000,
    max_path_segments: 1000,
    max_flatten_points: 1000,
    max_input_bytes: 65536,
  }
  match parse_svg_with_limits(sb.to_string(), depth_limits) {
    Err(e) => {
      match e.kind {
        SvgErrorKind::LimitExceeded => ()
        _ => debug_assert(false, "expected LimitExceeded for max_depth")
      }
    }
    Ok(_) => debug_assert(false, "must reject deep nesting")
  }

  // 4. max_flatten_points
  let big_curve = match parse_path("M 0 0 C 0 10000 10000 10000 10000 0") {
    Ok(p) => p
    Err(_) => SvgPath::{ segments: [] }
  }
  let flat_limits = SvgLimits::{
    max_depth: 128,
    max_elements: 1000,
    max_path_segments: 1000,
    max_flatten_points: 8,
    max_input_bytes: 65536,
  }
  match flatten_path_with_limits(big_curve, 0.001, flat_limits) {
    Err(e) => {
      match e.kind {
        SvgErrorKind::LimitExceeded => ()
        _ => debug_assert(false, "expected LimitExceeded for max_flatten_points")
      }
    }
    Ok(_) => debug_assert(false, "must reject > max_flatten_points")
  }
}

test "c1_migrated_svg_constants" {
  let lim = SvgLimits::default()
  debug_assert(lim.max_depth == 128 && lim.max_input_bytes == 16777216, "SvgLimits::default")
}
