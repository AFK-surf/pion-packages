///| 4-mode (Native debug/release + Wasm32 debug/release) smoke entry for `packages/svg`.

import "svg"

fn round_cent(v : Double) -> Int {
  if v >= 0.0 {
    (v * 100.0 + 0.5).floor().to_int()
  } else {
    -((-v * 100.0 + 0.5).floor().to_int())
  }
}

///|
pub fn main(world : World) -> Int {
  // 1. Complex path parse + cubic normalization + analytical BBox + flatten + length + compact format
  let d = "M0.500-.250L1.2.3C10 20 30 40 50 0S80-20 90 0Q95 15 100 0T110 0a25 25 0 0150 25Z"
  let p = match svg::parse_path(d) {
    Ok(v) => v
    Err(_) => return 1
  }
  let cubics = svg::to_cubic_beziers(p)
  let bb = match svg::cubics_bbox(cubics) {
    Some(r) => r
    None => return 2
  }
  let polys = match svg::flatten_path(p, 0.25) {
    Ok(v) => v
    Err(_) => return 3
  }
  let len = svg::path_length(p)
  let compact = svg::format_path(p, 2)

  // 2. Transform + ViewBox
  let tf = match svg::parse_transform("translate(10, 20) rotate(45 5 5) scale(2)") {
    Ok(v) => v
    Err(_) => return 4
  }
  let pt = tf.apply_point(svg::Point::new(3.0, 4.0))
  let vb = match svg::parse_viewbox("0 0 24 24") {
    Ok(v) => v
    Err(_) => return 5
  }
  let par = match svg::parse_preserve_aspect_ratio("xMidYMid meet") {
    Ok(v) => v
    Err(_) => return 6
  }
  let vbt = svg::viewbox_transform(vb, 96.0, 48.0, par)
  let vpt = vbt.apply_point(svg::Point::new(12.0, 12.0))

  // 3. Color + DOM + RenderPath extraction + SVGO optimization
  let col = match svg::parse_color("RebeccaPurple") {
    Ok(c) => c
    Err(_) => return 7
  }
  let doc_src = "<?xml version=\"1.0\"?><!-- smoke --><svg viewBox=\"0 0 24 24\"><metadata><x/></metadata><g></g><g transform=\"translate(4 6)\" fill=\"#ffffff\"><rect x=\"1\" y=\"2\" width=\"8\" height=\"6\" rx=\"1\" style=\"fill:rgb(255 0 128 / 50%)\"/><circle cx=\"12\" cy=\"12\" r=\"5\"/><path d=\"M 0.500 0.500 L 10.000 10.000 Z\"/></g></svg>"
  let doc = match svg::parse_svg(doc_src) {
    Ok(v) => v
    Err(_) => return 8
  }
  let rpaths = match svg::extract_render_paths(doc) {
    Ok(v) => v
    Err(_) => return 9
  }
  let opt = match svg::optimize_svg(doc_src, svg::OptimizeOptions::default()) {
    Ok(s) => s
    Err(_) => return 10
  }

  let mut total_pts = 0
  let mut i = 0
  while i < polys.length() {
    total_pts = total_pts + polys[i].points.length()
    i = i + 1
  }

  io_println(world, "segs=" + p.segments.length().to_string())
  io_println(world, "cubics=" + cubics.length().to_string())
  io_println(
    world,
    "bbox=" +
    round_cent(bb.min_x).to_string() +
    "," +
    round_cent(bb.min_y).to_string() +
    "," +
    round_cent(bb.max_x).to_string() +
    "," +
    round_cent(bb.max_y).to_string(),
  )
  io_println(world, "flat_pts=" + total_pts.to_string())
  io_println(world, "len_cent=" + round_cent(len).to_string())
  io_println(world, "compact=" + compact)
  io_println(world, "tf_pt=" + round_cent(pt.x).to_string() + "," + round_cent(pt.y).to_string())
  io_println(world, "vb_pt=" + round_cent(vpt.x).to_string() + "," + round_cent(vpt.y).to_string())
  io_println(world, "color=" + col.to_hex())
  io_println(world, "rpaths=" + rpaths.length().to_string())
  io_println(world, "opt=" + opt)
  0
}
