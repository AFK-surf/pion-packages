///| W3C SVG 1.1/2 Path Data (`d`) compliance, normalization, arc-to-cubic, and compact formatting tests.

fn approx_eq(a : Double, b : Double, eps : Double) -> Bool {
  (a - b).abs() <= eps
}

fn must_parse_path(name : String, d : String) -> SvgPath {
  match parse_path(d) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "[" + name + "] unexpected parse error: " + e.to_string())
      SvgPath::{ segments: [] }
    }
  }
}

///|
test "path__all_20_commands" {
  let d = "M 10 20 m 1 2 L 30 40 l 3 4 H 50 h 5 V 60 v 6 C 1 2 3 4 5 6 c 1 2 3 4 5 6 S 7 8 9 10 s 1 2 3 4 Q 11 12 13 14 q 1 2 3 4 T 15 16 t 1 2 A 25 25 -30 0 1 50 -25 a 10 20 45 1 0 5 5 Z z"
  let p = must_parse_path("all20", d)
  debug_assert(p.segments.length() == 20, "expected 20 segments")
  match p.segments[0] {
    PathSegment::MoveTo(abs, x, y) => {
      debug_assert(abs && approx_eq(x, 10.0, 1e-9) && approx_eq(y, 20.0, 1e-9), "M")
    }
    _ => debug_assert(false, "seg 0 should be M")
  }
  match p.segments[1] {
    PathSegment::MoveTo(abs, x, y) => {
      debug_assert(!abs && approx_eq(x, 1.0, 1e-9) && approx_eq(y, 2.0, 1e-9), "m")
    }
    _ => debug_assert(false, "seg 1 should be m")
  }
  match p.segments[4] {
    PathSegment::HorizontalLineTo(abs, x) => {
      debug_assert(abs && approx_eq(x, 50.0, 1e-9), "H")
    }
    _ => debug_assert(false, "seg 4 should be H")
  }
  match p.segments[7] {
    PathSegment::VerticalLineTo(abs, y) => {
      debug_assert(!abs && approx_eq(y, 6.0, 1e-9), "v")
    }
    _ => debug_assert(false, "seg 7 should be v")
  }
  match p.segments[16] {
    PathSegment::EllipticalArc(abs, rx, ry, rot, la, sw, x, y) => {
      debug_assert(
        abs &&
        approx_eq(rx, 25.0, 1e-9) &&
        approx_eq(ry, 25.0, 1e-9) &&
        approx_eq(rot, -30.0, 1e-9) &&
        !la &&
        sw &&
        approx_eq(x, 50.0, 1e-9) &&
        approx_eq(y, -25.0, 1e-9),
        "A",
      )
    }
    _ => debug_assert(false, "seg 16 should be A")
  }
  match p.segments[18] {
    PathSegment::ClosePath(abs) => debug_assert(abs, "Z")
    _ => debug_assert(false, "seg 18 should be Z")
  }
  match p.segments[19] {
    PathSegment::ClosePath(abs) => debug_assert(!abs, "z")
    _ => debug_assert(false, "seg 19 should be z")
  }
}

///|
test "path__implicit_lineto_after_moveto" {
  let p1 = must_parse_path("M_implicit", "M 10 20 30 40 50 60")
  debug_assert(p1.segments.length() == 3, "M with 3 pairs -> M, L, L")
  match p1.segments[1] {
    PathSegment::LineTo(abs, x, y) => {
      debug_assert(abs && approx_eq(x, 30.0, 1e-9) && approx_eq(y, 40.0, 1e-9), "implicit L 1")
    }
    _ => debug_assert(false, "expected implicit L")
  }
  let p2 = must_parse_path("m_implicit", "m 1 2 3 4 5 6")
  debug_assert(p2.segments.length() == 3, "m with 3 pairs -> m, l, l")
  match p2.segments[2] {
    PathSegment::LineTo(abs, x, y) => {
      debug_assert(!abs && approx_eq(x, 5.0, 1e-9) && approx_eq(y, 6.0, 1e-9), "implicit l 2")
    }
    _ => debug_assert(false, "expected implicit l")
  }
}

///|
test "path__concatenated_numbers_and_exponents" {
  // 1.2.3-4e-2 => 1.2, 0.3, -0.04
  let p = must_parse_path("concat_nums", "M1.2.3L-4e-2+.5e+1H.25.75")
  debug_assert(p.segments.length() == 4, "expected 4 segments")
  match p.segments[0] {
    PathSegment::MoveTo(_, x, y) => {
      debug_assert(approx_eq(x, 1.2, 1e-9) && approx_eq(y, 0.3, 1e-9), "1.2.3")
    }
    _ => debug_assert(false, "expected M")
  }
  match p.segments[1] {
    PathSegment::LineTo(_, x, y) => {
      debug_assert(approx_eq(x, -0.04, 1e-9) && approx_eq(y, 5.0, 1e-9), "-4e-2+.5e+1")
    }
    _ => debug_assert(false, "expected L")
  }
  match p.segments[2] {
    PathSegment::HorizontalLineTo(_, x) => debug_assert(approx_eq(x, 0.25, 1e-9), ".25")
    _ => debug_assert(false, "expected H 1")
  }
  match p.segments[3] {
    PathSegment::HorizontalLineTo(_, x) => debug_assert(approx_eq(x, 0.75, 1e-9), ".75")
    _ => debug_assert(false, "expected H 2")
  }
}

///|
test "path__compact_arc_flags_without_spaces" {
  // SVG 1.1/2 grammar: arc flags are single bits '0' or '1' and need no separator before next flag or coordinate!
  let p = must_parse_path("compact_arc", "M0 0a25 25 0 0150 25a10,10 0 1010,10a5 5 0 11-5.5.5")
  debug_assert(p.segments.length() == 4, "expected M + 3 arcs")
  match p.segments[1] {
    PathSegment::EllipticalArc(abs, rx, ry, rot, la, sw, x, y) => {
      debug_assert(
        !abs &&
        approx_eq(rx, 25.0, 1e-9) &&
        approx_eq(ry, 25.0, 1e-9) &&
        approx_eq(rot, 0.0, 1e-9) &&
        !la &&
        sw &&
        approx_eq(x, 50.0, 1e-9) &&
        approx_eq(y, 25.0, 1e-9),
        "0150 -> la=0 sw=1 x=50",
      )
    }
    _ => debug_assert(false, "expected arc 1")
  }
  match p.segments[2] {
    PathSegment::EllipticalArc(_, _, _, _, la, sw, x, y) => {
      debug_assert(la && !sw && approx_eq(x, 10.0, 1e-9) && approx_eq(y, 10.0, 1e-9), "1010 -> la=1 sw=0 x=10")
    }
    _ => debug_assert(false, "expected arc 2")
  }
  match p.segments[3] {
    PathSegment::EllipticalArc(_, _, _, _, la, sw, x, y) => {
      debug_assert(la && sw && approx_eq(x, -5.5, 1e-9) && approx_eq(y, 0.5, 1e-9), "11-5.5.5 -> la=1 sw=1 x=-5.5 y=0.5")
    }
    _ => debug_assert(false, "expected arc 3")
  }
}

///|
test "path__invalid_arc_flag_rejected" {
  match parse_path("M0 0 A 10 10 0 2 1 20 20") {
    Err(e) => {
      match e.kind {
        SvgErrorKind::InvalidPath => ()
        _ => debug_assert(false, "expected InvalidPath for flag '2'")
      }
    }
    Ok(_) => debug_assert(false, "flag '2' must be rejected")
  }
}

///|
test "path__must_start_with_moveto" {
  match parse_path("L 10 10") {
    Err(_) => ()
    Ok(_) => debug_assert(false, "path not starting with M/m must error")
  }
  // Empty/whitespace-only path is valid and yields 0 segments
  let empty = must_parse_path("empty", "   \t\n  ")
  debug_assert(empty.segments.length() == 0, "empty path has 0 segments")
}

///|
test "path__to_absolute_relative_subpaths_and_closepath" {
  let p = must_parse_path("rel", "m 10 20 l 5 5 h 10 v -5 z m 1 2 l 3 4")
  let abs_p = to_absolute(p)
  debug_assert(abs_p.segments.length() == 7, "expected 7 segments")
  // After z, current point resets to (10, 20), so second m 1 2 -> M 11 22, l 3 4 -> L 14 26
  match abs_p.segments[5] {
    PathSegment::MoveTo(abs, x, y) => {
      debug_assert(abs && approx_eq(x, 11.0, 1e-9) && approx_eq(y, 22.0, 1e-9), "second M after z")
    }
    _ => debug_assert(false, "expected M at index 5")
  }
  match abs_p.segments[6] {
    PathSegment::LineTo(abs, x, y) => {
      debug_assert(abs && approx_eq(x, 14.0, 1e-9) && approx_eq(y, 26.0, 1e-9), "L after second M")
    }
    _ => debug_assert(false, "expected L at index 6")
  }
}

///|
test "path__to_cubic_beziers_smooth_and_quadratic" {
  // Smooth cubic S reflects previous c2; smooth quadratic T reflects previous q1
  let p = must_parse_path("smooth", "M 0 0 C 0 10 10 10 10 0 S 20 -10 20 0 Q 25 10 30 0 T 40 0")
  let cubics = to_cubic_beziers(p)
  debug_assert(cubics.length() == 5, "expected M + 4 cubics")
  // S after C(0,10, 10,10, 10,0): reflected c1 = (2*10 - 10, 2*0 - 10) = (10, -10)
  match cubics[2] {
    CubicSegment::CurveTo(x1, y1, x2, y2, x, y) => {
      debug_assert(
        approx_eq(x1, 10.0, 1e-9) &&
        approx_eq(y1, -10.0, 1e-9) &&
        approx_eq(x2, 20.0, 1e-9) &&
        approx_eq(y2, -10.0, 1e-9) &&
        approx_eq(x, 20.0, 1e-9) &&
        approx_eq(y, 0.0, 1e-9),
        "reflected S cubic",
      )
    }
    _ => debug_assert(false, "expected CurveTo for S")
  }
  // Q from (20,0) with ctrl (25,10) to (30,0): c1 = (20 + 2/3*5, 0 + 2/3*10), c2 = (30 - 2/3*5, 0 + 2/3*10)
  match cubics[3] {
    CubicSegment::CurveTo(x1, y1, x2, y2, x, y) => {
      debug_assert(
        approx_eq(x1, 20.0 + 10.0 / 3.0, 1e-9) &&
        approx_eq(y1, 20.0 / 3.0, 1e-9) &&
        approx_eq(x2, 30.0 - 10.0 / 3.0, 1e-9) &&
        approx_eq(y2, 20.0 / 3.0, 1e-9) &&
        approx_eq(x, 30.0, 1e-9) &&
        approx_eq(y, 0.0, 1e-9),
        "elevated Q cubic",
      )
    }
    _ => debug_assert(false, "expected CurveTo for Q")
  }
  // T from (30,0) to (40,0): reflected q1 = (35, -10)
  match cubics[4] {
    CubicSegment::CurveTo(x1, y1, x2, y2, x, y) => {
      debug_assert(
        approx_eq(x1, 30.0 + 10.0 / 3.0, 1e-9) &&
        approx_eq(y1, -20.0 / 3.0, 1e-9) &&
        approx_eq(x2, 40.0 - 10.0 / 3.0, 1e-9) &&
        approx_eq(y2, -20.0 / 3.0, 1e-9) &&
        approx_eq(x, 40.0, 1e-9) &&
        approx_eq(y, 0.0, 1e-9),
        "reflected T cubic",
      )
    }
    _ => debug_assert(false, "expected CurveTo for T")
  }
}

///|
test "path__arc_to_cubic_w3c_f65_f66" {
  // Semicircle radius 10 from (0, 10) to (20, 10), sweep=1 -> passes through top (10, 0)
  let p = must_parse_path("semi", "M 0 10 A 10 10 0 0 1 20 10")
  let cubics = to_cubic_beziers(p)
  // 180 deg split into 2 segments of 90 deg each
  debug_assert(cubics.length() == 3, "expected M + 2 cubic arcs")
  match cubics[1] {
    CubicSegment::CurveTo(_, _, _, _, mx, my) => {
      debug_assert(approx_eq(mx, 10.0, 1e-6) && approx_eq(my, 0.0, 1e-6), "midpoint at (10, 0)")
    }
    _ => debug_assert(false, "expected cubic 1")
  }
  match cubics[2] {
    CubicSegment::CurveTo(_, _, _, _, ex, ey) => {
      debug_assert(approx_eq(ex, 20.0, 1e-6) && approx_eq(ey, 10.0, 1e-6), "endpoint at (20, 10)")
    }
    _ => debug_assert(false, "expected cubic 2")
  }
  // Degenerate zero-radius arc must become LineTo, never NaN
  let deg = must_parse_path("deg_arc", "M 0 0 A 0 10 0 0 1 15 25")
  let deg_c = to_cubic_beziers(deg)
  debug_assert(deg_c.length() == 2, "zero-radius arc -> M + LineTo")
  match deg_c[1] {
    CubicSegment::LineTo(x, y) => {
      debug_assert(approx_eq(x, 15.0, 1e-9) && approx_eq(y, 25.0, 1e-9), "degenerate arc LineTo")
    }
    _ => debug_assert(false, "expected LineTo for zero-radius arc")
  }
}

///|
test "path__format_path_compact_svgo" {
  let p = must_parse_path("fmt", "M 0.5000 -0.2500 L 1.200 0.300 L -4.000 5.000 A 25 25 0 0 1 50 25 Z")
  let s = format_path(p, 2)
  // Expect compact formatting: leading zeros dropped, no space before '-', no space between arc flags
  debug_assert(s == "M.5-.25 1.2.3-4 5A25 25 0 0150 25Z", "got: " + s)
  // Round-trip parse must match values
  let rt = must_parse_path("fmt_rt", s)
  debug_assert(rt.segments.length() == 5, "round-trip segment count")
}
