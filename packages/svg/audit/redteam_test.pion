///| Red-team regression tests for packages/svg @ 4f97bad (branch feat/pkg-svg).
///
/// `p0_*` / `p1_*` / `p2_*` tests assert what the W3C SVG 1.1 / SVG 2 / CSS / XML 1.0 specs say and what the
/// reference implementations do (Rust svgtypes =0.15.3, roxmltree =0.20.0, kurbo =0.11.3, libm, svgo 3
/// for optimizer semantics). Every expectation was checked against `oracle/` or the Python references in
/// `scripts/` (see REPORT.md); a FAILURE here is the evidence of an open defect.
/// `control_*` tests are attacks Pion survived; they must keep passing.
/// Numeric / differential / DoS / 4-mode findings are reproduced by run_audit.sh (scripts/*.py).

import "svg"

///|
fn must_path(d : String) -> svg::SvgPath {
  match svg::parse_path(d) {
    Ok(p) => p
    Err(e) => {
      debug_assert(false, "parse_path(" + d + ") failed: " + e.to_string())
      svg::SvgPath::new([])
    }
  }
}

///|
fn first_x(d : String) -> Double {
  match must_path(d).segments[0] {
    svg::PathSegment::MoveTo(_, x, _) => x
    _ => -1.0
  }
}

///|
fn opt(src : String) -> String {
  match svg::optimize_svg(src, svg::OptimizeOptions::default()) {
    Ok(s) => s
    Err(e) => "ERR " + e.to_string()
  }
}

///|
fn opt_with_shapes(src : String) -> String {
  let d = svg::OptimizeOptions::default()
  let o = svg::OptimizeOptions::{
    float_precision: d.float_precision,
    remove_comments: d.remove_comments,
    remove_xml_decl: d.remove_xml_decl,
    remove_metadata: d.remove_metadata,
    remove_empty_groups: d.remove_empty_groups,
    collapse_groups: d.collapse_groups,
    convert_shapes_to_paths: true,
    minify_colors: d.minify_colors,
    optimize_paths: d.optimize_paths,
    limits: d.limits,
  }
  match svg::optimize_svg(src, o) {
    Ok(s) => s
    Err(e) => "ERR " + e.to_string()
  }
}

///|
fn render(src : String) -> Array[svg::RenderPath] {
  match svg::parse_svg(src) {
    Ok(doc) => {
      match svg::extract_render_paths(doc) {
        Ok(r) => r
        Err(e) => {
          debug_assert(false, "extract_render_paths failed: " + e.to_string())
          []
        }
      }
    }
    Err(e) => {
      debug_assert(false, "parse_svg failed: " + e.to_string())
      []
    }
  }
}

///|
fn parse_ok(src : String) -> Bool {
  match svg::parse_svg(src) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn first_text(src : String) -> String {
  match svg::parse_svg(src) {
    Ok(doc) => {
      let mut i = 0
      while i < doc.nodes.length() {
        match doc.nodes[i].kind {
          svg::SvgNodeKind::Text => return doc.nodes[i].text
          _ => ()
        }
        i = i + 1
      }
      "<no text>"
    }
    Err(e) => "ERR " + e.to_string()
  }
}

///|
fn near(a : Double, b : Double, eps : Double) -> Bool {
  (a - b).abs() <= eps
}

///|
fn seg_dist(px : Double, py : Double, a : svg::Point, b : svg::Point) -> Double {
  let vx = b.x - a.x
  let vy = b.y - a.y
  let l = vx * vx + vy * vy
  let mut t = if l == 0.0 { 0.0 } else { ((px - a.x) * vx + (py - a.y) * vy) / l }
  if t < 0.0 {
    t = 0.0
  }
  if t > 1.0 {
    t = 1.0
  }
  let dx = px - (a.x + t * vx)
  let dy = py - (a.y + t * vy)
  (dx * dx + dy * dy).sqrt()
}

///| Max distance from 400 samples of the single cubic P0..P3 to the flattened polyline.
fn flatten_error(
  x0 : Double,
  y0 : Double,
  x1 : Double,
  y1 : Double,
  x2 : Double,
  y2 : Double,
  x3 : Double,
  y3 : Double,
  pts : Array[svg::Point],
) -> Double {
  let mut worst = 0.0
  let mut k = 1
  while k < 400 {
    let t = k.to_double() / 400.0
    let mt = 1.0 - t
    let px = mt * mt * mt * x0 + 3.0 * mt * mt * t * x1 + 3.0 * mt * t * t * x2 + t * t * t * x3
    let py = mt * mt * mt * y0 + 3.0 * mt * mt * t * y1 + 3.0 * mt * t * t * y2 + t * t * t * y3
    let mut best = 1.0e300
    let mut j = 0
    while j + 1 < pts.length() {
      let d = seg_dist(px, py, pts[j], pts[j + 1])
      if d < best {
        best = d
      }
      j = j + 1
    }
    if best > worst {
      worst = best
    }
    k = k + 1
  }
  worst
}

// ============================================================ P1 ==========================================

///| README: "flatten_path: adaptive De Casteljau subdivision within geometric tolerance `tolerance`".
///| geometry.pion:217 uses (16*tol)^2 where the Willcocks/Hain bound needs 16*tol^2 -> up to 4x the tolerance.
test "p1_flatten_path_respects_tolerance" {
  let tol = 0.25
  let p = must_path("M0 0C10 20 30 20 40 0")
  match svg::flatten_path(p, tol) {
    Ok(polys) => {
      let err = flatten_error(0.0, 0.0, 10.0, 20.0, 30.0, 20.0, 40.0, 0.0, polys[0].points)
      debug_assert(
        err <= tol,
        "flatten_path(tol=0.25) deviates " + err.to_string() + " from the curve (" + (err / tol).to_string() + "x tol)",
      )
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///|
test "p1_flatten_path_respects_tolerance_s_chain" {
  let tol = 0.25
  let p = must_path("M0 0C10 20 30 20 40 0S70-20 80 0")
  match svg::flatten_path(p, tol) {
    Ok(polys) => {
      // second cubic: (40,0) (50,-20) (70,-20) (80,0) -- reflected control point
      let pts = polys[0].points
      let mut k = 0
      while k < pts.length() && !(pts[k].x == 40.0 && pts[k].y == 0.0) {
        k = k + 1
      }
      let tail : Array[svg::Point] = []
      while k < pts.length() {
        tail.push(pts[k])
        k = k + 1
      }
      let err = flatten_error(40.0, 0.0, 50.0, -20.0, 70.0, -20.0, 80.0, 0.0, tail)
      debug_assert(err <= tol, "S segment flattened with error " + err.to_string() + " > tol 0.25")
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| SVG default white-space handling keeps one space between words in adjacent text chunks;
///| optimize.pion:207 trims every text node and dom.pion:458 drops whitespace-only ones.
test "p1_optimize_keeps_spaces_between_text_and_tspan" {
  let o = opt("<svg><text>Hello <tspan>World</tspan> again</text></svg>")
  debug_assert(o.contains("Hello <tspan>World</tspan> again"), "rendered text changed: " + o)
}

///|
test "p1_optimize_keeps_whitespace_only_text_between_tspans" {
  let o = opt("<svg><text><tspan>a</tspan> <tspan>b</tspan></text></svg>")
  debug_assert(o.contains("</tspan> <tspan>"), "'a b' became 'ab': " + o)
}

///|
test "p1_optimize_keeps_xml_space_preserve" {
  let o = opt("<svg><text xml:space=\"preserve\">  two  spaces  </text></svg>")
  debug_assert(o.contains(">  two  spaces  </text>"), "xml:space=preserve text trimmed: " + o)
}

///| XML 1.0 §4.1: &#NNN; / &#xHHH; reference any Unicode scalar value. dom.pion:154 only decodes cp < 128.
test "p1_parse_svg_decodes_latin1_charref" {
  let t = first_text("<svg><text>caf&#233;</text></svg>")
  debug_assert(t == "caf\u{e9}", "&#233; not decoded: '" + t + "'")
}

///|
test "p1_parse_svg_decodes_astral_charref" {
  let t = first_text("<svg><text>&#x1F600;</text></svg>")
  debug_assert(t == "\u{1F600}", "&#x1F600; not decoded: '" + t + "'")
}

///|
test "p1_optimize_does_not_double_escape_charrefs" {
  let o = opt("<svg><text>a&#160;b &#x2713;</text><g aria-label=\"&#x2713; ok\"><path d=\"M0 0L1 1\"/></g></svg>")
  debug_assert(!o.contains("&amp;#"), "character reference turned into literal text: " + o)
}

///| <switch> renders only its first direct child that passes its conditions (SVG 2 §5.8).
///| svgo collapseGroups skips groups whose parent is <switch>.
test "p1_optimize_does_not_unwrap_groups_inside_switch" {
  let o = opt(
    "<svg><switch><g><rect width=\"5\" height=\"5\"/><circle r=\"3\"/></g><g><rect width=\"9\" height=\"9\"/></g></switch></svg>",
  )
  debug_assert(o.contains("<switch><g>"), "switch children re-parented: " + o)
}

///| An animation element animates its parent; svgo collapseGroups keeps such groups.
test "p1_optimize_does_not_unwrap_group_with_animation_child" {
  let o = opt(
    "<svg><g><animateTransform attributeName=\"transform\" type=\"rotate\" to=\"90\"/><rect width=\"5\" height=\"5\"/></g></svg>",
  )
  debug_assert(o.contains("<g><animateTransform"), "animation now targets <svg>: " + o)
}

///| math.pion:419: v*scale overflows to inf for |v| >= ~1.8e305 (precision 3); the fallback prints "inf".
test "p1_format_path_never_emits_inf" {
  let f = svg::format_path(must_path("M0 0L1e306 1e307"), 3)
  debug_assert(!f.contains("inf") && !f.contains("nan"), "format_path produced invalid path data: " + f)
  match svg::parse_path(f) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "format_path output does not re-parse: " + f + " " + e.to_string())
  }
}

///|
test "p1_optimize_huge_coordinate_keeps_valid_d" {
  let o = opt("<svg><path d=\"M0 0L1e306 1e306\"/></svg>")
  debug_assert(!o.contains("inf"), "optimize_svg wrote d=\"... inf inf\": " + o)
}

// ============================================================ P2 ==========================================

///| svgtypes uses the correctly rounded f64::from_str; math.pion:305 accumulates the mantissa in a double.
test "p2_number_parse_correctly_rounded" {
  let x = first_x("M-948.2166391075641 0")
  debug_assert(
    x.to_bits() == (-948.2166391075641).to_bits(),
    "-948.2166391075641 parsed as " + x.to_string(),
  )
}

///| math.pion:318 keeps only 18 fractional digits, leading zeros included.
test "p2_number_parse_keeps_digits_after_leading_zeros" {
  let x = first_x("M0.000000000000000305655 0")
  debug_assert(
    near(x, 3.05655e-16, 1.0e-30),
    "0.000000000000000305655 parsed as " + x.to_string(),
  )
}

///| math.pion:266: pow10_f64(e > 308) returns 1e308, so 10^-320 becomes 10^-308.
test "p2_number_parse_subnormal_exponent" {
  let x = first_x("M1e-320 0")
  debug_assert(x < 1.0e-319, "1e-320 parsed as " + x.to_string())
}

///|
test "p2_number_parse_accepts_dbl_max" {
  match svg::parse_path("M1.7976931348623157e308 0") {
    Ok(_) => ()
    Err(e) => debug_assert(false, "DBL_MAX rejected: " + e.to_string())
  }
}

///| svgtypes: 1e309 is +inf -> InvalidNumber. Pion clamps it to 1e308.
test "p2_number_parse_rejects_overflow" {
  match svg::parse_path("M1e309 0") {
    Ok(p) => debug_assert(false, "1e309 accepted as " + svg::format_path(p, 0))
    Err(_) => ()
  }
}

///| geometry.pion:25 uses absolute 1e-12 thresholds: the y-extremum (7.5e-14) of a 1e-13-sized curve is lost.
test "p2_bbox_is_scale_invariant" {
  match svg::path_bbox(must_path("M0 0C0 1e-13 1e-13 1e-13 1e-13 0")) {
    Some(r) => debug_assert(near(r.max_y, 7.5e-14, 1.0e-20), "max_y " + r.max_y.to_string() + " (exact 7.5e-14)")
    None => debug_assert(false, "no bbox")
  }
}

///| geometry.pion:471: `1e-6 * (1.0 + whole)` is an absolute floor -> tiny paths stop after one GL5 pass.
test "p2_path_length_is_scale_invariant" {
  let big = svg::path_length(must_path("M0 0C0 3 1 3 1 0"))
  let small = svg::path_length(must_path("M0 0C0 3e-9 1e-9 3e-9 1e-9 0"))
  let rel = (small * 1.0e9 - big).abs() / big
  debug_assert(rel <= 1.0e-6, "length(1e-9 * curve) * 1e9 differs from length(curve) by " + rel.to_string())
}

///| Two-term Cody-Waite reduction (math.pion:57) loses ~ulp(pi/2) per quadrant; libm cos(1e6 deg) = 0.17364817766507232.
test "p2_rotate_large_angle_precision" {
  let t = svg::Transform2D::rotate(1000000.0)
  debug_assert(near(t.a, 0.17364817766507232, 1.0e-14), "cos(1e6 deg) = " + t.a.to_string())
}

///| reduce_angle: (v / tau).floor() * tau cannot reduce >= 1e18 deg; libm cos = 0.3942908135108136.
test "p2_rotate_huge_angle_not_identity" {
  let t = svg::Transform2D::rotate(1.0e18)
  debug_assert(near(t.a, 0.3942908135108136, 1.0e-9), "rotate(1e18) cos = " + t.a.to_string())
}

///| svgtypes ViewBox: w <= 0 || h <= 0 -> error (SVG 2: zero disables rendering of the element).
test "p2_viewbox_rejects_zero_size" {
  match svg::parse_viewbox("0 0 0 10") {
    Ok(_) => debug_assert(false, "viewBox with width 0 accepted")
    Err(_) => ()
  }
}

///|
test "p2_color_rejects_trailing_comma" {
  match svg::parse_color("rgb(255,0,0,)") {
    Ok(c) => debug_assert(false, "rgb(255,0,0,) accepted as " + c.to_hex())
    Err(_) => ()
  }
}

///| XML 1.0 well-formedness (roxmltree rejects all of these).
test "p2_xml_rejects_duplicate_attribute" {
  debug_assert(!parse_ok("<svg><g id=\"a\" id=\"b\"/></svg>"), "duplicate attribute accepted")
}

///|
test "p2_xml_rejects_lt_in_attribute" {
  debug_assert(!parse_ok("<svg><g id=\"a<b\"/></svg>"), "'<' in attribute value accepted")
}

///|
test "p2_xml_rejects_two_root_elements" {
  debug_assert(!parse_ok("<svg/><svg/>"), "two root elements accepted")
}

///|
test "p2_xml_rejects_bare_ampersand_and_unknown_entity" {
  debug_assert(!parse_ok("<svg><text>a & b &nbsp;</text></svg>"), "bare '&' / unknown entity accepted")
}

///|
test "p2_xml_rejects_missing_space_between_attributes" {
  debug_assert(!parse_ok("<svg><g id=\"a\"class=\"b\"/></svg>"), "attributes without separating whitespace accepted")
}

///| Namespace-prefixed SVG (valid XML, common in some exporters) renders nothing.
test "p2_namespace_prefixed_svg_renders" {
  let r = render("<svg:svg xmlns:svg=\"http://www.w3.org/2000/svg\"><svg:path d=\"M0 0L10 10\"/></svg:svg>")
  debug_assert(r.length() == 1, "svg:path ignored (" + r.length().to_string() + " render paths)")
}

///| CSS comments are allowed anywhere in a declaration list.
test "p2_style_css_comment" {
  let r = render("<svg><path d=\"M0 0L1 1\" style=\"/*x*/fill:red\"/></svg>")
  match r[0].style.fill {
    svg::SvgPaint::Color(c) => debug_assert(c.r == 255 && c.g == 0, "fill ignored after a CSS comment: " + c.to_hex())
    _ => debug_assert(false, "fill not a color")
  }
}

///|
test "p2_style_important" {
  let r = render("<svg><path d=\"M0 0L1 1\" style=\"fill:red !important\"/></svg>")
  match r[0].style.fill {
    svg::SvgPaint::Color(c) => debug_assert(c.r == 255 && c.g == 0, "fill:red !important ignored: " + c.to_hex())
    _ => debug_assert(false, "fill not a color")
  }
}

///| style="opacity:.5" overrides opacity=".5"; it must not multiply with it (dom.pion:736).
test "p2_opacity_style_overrides_attribute" {
  let r = render("<svg><path d=\"M0 0L1 1\" opacity=\"0.5\" style=\"opacity:0.5\"/></svg>")
  debug_assert(r[0].style.opacity == 0.5, "opacity " + r[0].style.opacity.to_string())
}

///| CSS Color 4 / SVG 2: <alpha-value> accepts percentages.
test "p2_fill_opacity_percentage" {
  let r = render("<svg><path d=\"M0 0L1 1\" fill-opacity=\"50%\"/></svg>")
  debug_assert(r[0].style.fill_opacity == 0.5, "fill-opacity=50% -> " + r[0].style.fill_opacity.to_string())
}

///| Opacity values are clamped to [0, 1].
test "p2_opacity_clamped" {
  let r = render("<svg><path d=\"M0 0L1 1\" opacity=\"2\"/></svg>")
  debug_assert(r[0].style.opacity == 1.0, "opacity=2 -> " + r[0].style.opacity.to_string())
}

///| <marker> content is never rendered directly.
test "p2_marker_content_not_rendered" {
  let r = render("<svg><marker id=\"m\"><path d=\"M0 0L1 1\"/></marker></svg>")
  debug_assert(r.length() == 0, "marker child rendered as a normal path")
}

///| An invalid attribute value affects only its element (SVG 2 error handling), not the whole document.
test "p2_bad_transform_isolated" {
  match svg::parse_svg("<svg><path d=\"M0 0L1 1\"/><path d=\"M0 0L2 2\" transform=\"rotate(oops)\"/></svg>") {
    Ok(doc) => {
      match svg::extract_render_paths(doc) {
        Ok(r) => debug_assert(r.length() >= 1, "no paths")
        Err(e) => debug_assert(false, "one bad transform aborted the whole document: " + e.to_string())
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| SVG path error handling: render the path up to the error; never abort sibling elements.
test "p2_bad_path_data_isolated" {
  match svg::parse_svg("<svg><path d=\"M0 0L1 1\"/><path d=\"M0 0L2 2 X\"/></svg>") {
    Ok(doc) => {
      match svg::extract_render_paths(doc) {
        Ok(r) => debug_assert(r.length() >= 1, "no paths")
        Err(e) => debug_assert(false, "one bad d aborted the whole document: " + e.to_string())
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| SVG 2 §10.6: an odd number of polyline coordinates -> the last one is ignored.
test "p2_odd_polyline_coordinate_ignored" {
  match svg::parse_svg("<svg><polyline points=\"0 0 10 10 20\"/></svg>") {
    Ok(doc) => {
      match svg::extract_render_paths(doc) {
        Ok(r) => debug_assert(r.length() == 1, "polyline dropped")
        Err(e) => debug_assert(false, "odd coordinate count aborted the document: " + e.to_string())
      }
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| SVG 2 §10.2: rx="auto" (or a negative/invalid rx) takes the value of ry.
test "p2_rect_rx_auto_uses_ry" {
  match svg::shape_to_path("rect", [svg::SvgAttr::new("width", "20"), svg::SvgAttr::new("height", "20"), svg::SvgAttr::new("rx", "auto"), svg::SvgAttr::new("ry", "5")]) {
    Ok(p) => debug_assert(svg::format_path(p, 3).contains("A5 5"), "rx=auto ry=5 -> " + svg::format_path(p, 3))
    Err(e) => debug_assert(false, e.to_string())
  }
}

///|
test "p2_rect_negative_rx_is_auto" {
  match svg::shape_to_path("rect", [svg::SvgAttr::new("width", "20"), svg::SvgAttr::new("height", "20"), svg::SvgAttr::new("rx", "-3"), svg::SvgAttr::new("ry", "5")]) {
    Ok(p) => debug_assert(svg::format_path(p, 3).contains("A5 5"), "rx=-3 ry=5 -> " + svg::format_path(p, 3))
    Err(e) => debug_assert(false, e.to_string())
  }
}

///| Nested <svg x y width height viewBox> establishes a new viewport transform.
test "p2_nested_svg_viewport_transform" {
  let r = render(
    "<svg><svg x=\"10\" y=\"10\" width=\"10\" height=\"10\" viewBox=\"0 0 1 1\"><path d=\"M0 0L1 1\"/></svg></svg>",
  )
  debug_assert(
    r[0].transform.a == 10.0 && r[0].transform.e == 10.0,
    "nested viewport ignored: a=" + r[0].transform.a.to_string() + " e=" + r[0].transform.e.to_string(),
  )
}

///| A filter on an empty group still paints (e.g. feFlood); svgo removeEmptyContainers keeps g[filter].
test "p2_optimize_keeps_empty_group_with_filter" {
  let o = opt(
    "<svg><defs><filter id=\"f\"><feFlood flood-color=\"red\"/></filter></defs><g filter=\"url(#f)\"/></svg>",
  )
  debug_assert(o.contains("filter=\"url(#f)\""), "g[filter] removed: " + o)
}

///| <?xml-stylesheet?> is a PI linking a stylesheet, not the XML declaration (optimize.pion:85).
test "p2_optimize_keeps_xml_stylesheet_pi" {
  let o = opt("<?xml-stylesheet type=\"text/css\" href=\"t.css\"?><svg><path d=\"M0 0L1 1\"/></svg>")
  debug_assert(o.contains("xml-stylesheet"), "stylesheet link removed: " + o)
}

///| Rounding each relative coordinate independently accumulates drift (1000 x l.0004 -> 0 instead of 0.4).
test "p2_format_path_relative_rounding_drift" {
  let sb = StringBuilder::new()
  sb.write_string("M0 0")
  let mut i = 0
  while i < 1000 {
    sb.write_string("l.0004 0")
    i = i + 1
  }
  let f = svg::format_path(must_path(sb.to_string()), 3)
  match svg::path_bbox(must_path(f)) {
    Some(r) => debug_assert(near(r.max_x, 0.4, 0.002), "end point moved from x=0.4 to x=" + r.max_x.to_string())
    None => debug_assert(false, "no bbox")
  }
}

///| #rrggbbaa / #rgba are CSS Color 4 only; svgo convertColors never produces them from rgba()/hsla().
test "p2_optimize_alpha_colors_stay_svg11_compatible" {
  let o = opt("<svg><path d=\"M0 0\" fill=\"rgba(255,0,0,0.5)\"/></svg>")
  debug_assert(!o.contains("#ff000080"), "rgba() rewritten as 8-digit hex: " + o)
}

///| Attribute-value normalisation turns raw TAB/LF into spaces; &#9; / &#10; must be re-escaped.
test "p2_optimize_reescapes_attribute_whitespace_charrefs" {
  let o = opt("<svg><path d=\"M0 0\" data-x=\"a&#10;b&#9;c\"/></svg>")
  debug_assert(o.contains("a&#10;b&#9;c") || o.contains("a&#xA;b&#x9;c"), "LF/TAB written raw: " + o)
}

///| Invertible matrices with |det| < 1e-15 (e.g. scale(1e-8)) are reported singular (transform.pion:95).
test "p2_invert_small_scale_matrix" {
  match svg::Transform2D::scale(1.0e-8, 1.0e-8).invert() {
    Some(t) => debug_assert(near(t.a, 1.0e8, 1.0), "wrong inverse")
    None => debug_assert(false, "scale(1e-8) reported as non-invertible")
  }
}

///| path.pion:565 `max_path_segments * 4` overflows Int for large custom limits -> spurious LimitExceeded.
test "p2_cubic_limit_no_int_overflow" {
  let d = svg::SvgLimits::default()
  let lim = svg::SvgLimits::{
    max_depth: d.max_depth,
    max_elements: d.max_elements,
    max_path_segments: 1000000000,
    max_flatten_points: d.max_flatten_points,
    max_input_bytes: d.max_input_bytes,
  }
  match svg::to_cubic_beziers_with_limits(must_path("M0 0L1 1"), lim) {
    Ok(c) => debug_assert(c.length() == 2, "wrong cubic count")
    Err(e) => debug_assert(false, "2-segment path exceeds a 1e9-segment limit: " + e.to_string())
  }
}

// ============================================================ controls ====================================

///|
test "control_optimize_escapes_attribute_and_text" {
  let o = opt("<svg><path d=\"M0 0\" title='say \"hi\" &amp; &lt;b&gt;'/><text>&lt;script&gt;</text></svg>")
  debug_assert(o.contains("title=\"say &quot;hi&quot; &amp; &lt;b&gt;\""), o)
  debug_assert(o.contains("<text>&lt;script&gt;</text>"), o)
}

///|
test "control_billion_laughs_not_expanded" {
  let src = "<!DOCTYPE l [<!ENTITY a \"aaaaaaaaaa\"><!ENTITY b \"&a;&a;&a;&a;&a;&a;&a;&a;&a;&a;\"><!ENTITY c \"&b;&b;&b;&b;&b;&b;&b;&b;&b;&b;\">]><svg><text>&c;</text></svg>"
  let t = first_text(src)
  debug_assert(t.length() < 100, "entity expanded")
}

///|
test "control_default_depth_limit" {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 1000 {
    sb.write_string("<g>")
    i = i + 1
  }
  i = 0
  while i < 1000 {
    sb.write_string("</g>")
    i = i + 1
  }
  match svg::parse_svg(sb.to_string()) {
    Ok(_) => debug_assert(false, "1000-deep nesting accepted with max_depth 128")
    Err(e) => debug_assert(e.kind == svg::SvgErrorKind::LimitExceeded, e.to_string())
  }
}

///|
test "control_rx_zero_arc_is_line_and_radii_scaled" {
  let c = svg::to_cubic_beziers(must_path("M0 0A0 10 0 0 1 10 10A1 1 0 0 1 110 10"))
  match c[1] {
    svg::CubicSegment::LineTo(x, y) => debug_assert(x == 10.0 && y == 10.0, "rx=0 arc not a line")
    _ => debug_assert(false, "rx=0 arc not a line")
  }
  match c[c.length() - 1] {
    svg::CubicSegment::CurveTo(_, _, _, _, x, y) => debug_assert(x == 110.0 && y == 10.0, "arc end not exact")
    _ => debug_assert(false, "scaled arc missing")
  }
}

///|
test "control_rect_rx_inherit_then_clamp" {
  match svg::shape_to_path("rect", [svg::SvgAttr::new("width", "10"), svg::SvgAttr::new("height", "40"), svg::SvgAttr::new("rx", "30")]) {
    Ok(p) => debug_assert(svg::format_path(p, 3).contains("A5 20"), svg::format_path(p, 3))
    Err(e) => debug_assert(false, e.to_string())
  }
}

///|
test "control_transform_list_order" {
  match svg::parse_transform("translate(10 0) scale(2)") {
    Ok(t) => {
      let p = t.apply_point(svg::Point::new(1.0, 1.0))
      debug_assert(p.x == 12.0 && p.y == 2.0, "wrong composition order")
    }
    Err(e) => debug_assert(false, e.to_string())
  }
}

///|
test "control_smooth_reflection_after_close" {
  // After Z the current point is the subpath start and the previous command is not a curve:
  // S's first control point equals the current point.
  let c = svg::to_cubic_beziers(must_path("M0 0C10 10 20 10 30 0ZS10 10 20 0"))
  match c[3] {
    svg::CubicSegment::CurveTo(x1, y1, _, _, _, _) => debug_assert(x1 == 0.0 && y1 == 0.0, "reflection leaked over Z")
    _ => debug_assert(false, "expected curve")
  }
}

///|
test "control_extreme_numbers_no_panic" {
  let ds = ["M-1e308 0A1 1 0 0 1 1e308 0", "M0 0A1e308 1e308 1e308 1 1 1e308 -1e308", "M0 0A10 10 1e300 0 1 10 10"]
  let mut i = 0
  while i < ds.length() {
    let p = must_path(ds[i])
    let _ = svg::path_bbox(p)
    let _ = svg::path_length(p)
    let _ = svg::flatten_path(p, 0.5)
    i = i + 1
  }
  match svg::parse_color("rgb(1e300,0,-1e300)") {
    Ok(c) => debug_assert(c.r == 255 && c.b == 0, "clamping")
    Err(_) => ()
  }
}
