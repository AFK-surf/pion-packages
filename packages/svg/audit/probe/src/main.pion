///| Red-team differential probe for `packages/svg` (batch, length-framed I/O).
///|
///| Input records: `<len>\n<bytes>` repeated; multi-field records use 0x1F as field separator.
///| Output records: same framing. Doubles are printed as their IEEE-754 bit pattern (`Int64`).
///|   path    d                  -> `OK` + segments | `ERR`
///|   geom    tol 0x1F d         -> cubics, bbox, length, flatten polylines | `ERR`
///|   fmt     prec 0x1F d        -> `format_path(parse_path(d), prec)`
///|   color   s                  -> `OK r g b a` | `ERR`
///|   paint   s                  -> `NONE` | `CUR` | `URL x` | `COL r g b a` | `ERR`
///|   tf      s                  -> 6 doubles | `ERR`
///|   rot     deg                -> `Transform2D::rotate(deg)` a b ; `skew_x(deg)` c
///|   vb      s                  -> 4 doubles | `ERR`
///|   par     s                  -> `align slice` | `ERR`
///|   vbt     vb 0x1F w 0x1F h 0x1F par -> 6 doubles | `ERR`
///|   len     s                  -> double | `ERR`
///|   xml     doc                -> canonical node dump | `ERR`
///|   extract doc                -> render paths | `ERR`
///|   opt     doc                -> `optimize_svg(doc, default)` | `ERR`
///|   optc    doc                -> same with `convert_shapes_to_paths = true`
///|   one     <in> <mode> [reps] : run one mode on the first record `reps` times, print a summary
///|   dos     <kind> <n> [depth] : build an adversarial input in memory and run it (DoS probes)

import "svg"

///|
fn parse_dec(s : String, start : Int, end : Int) -> Int {
  let mut v = 0
  let mut i = start
  while i < end {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
fn read_records(src : String) -> Array[String] {
  let out : Array[String] = []
  let n = src.length()
  let mut i = 0
  while i < n {
    let ls = i
    while i < n && src.code_unit_at(i) != 10 {
      i = i + 1
    }
    let len = parse_dec(src, ls, i)
    i = i + 1
    out.push(src.slice(i, i + len))
    i = i + len
  }
  out
}

///|
fn split_fields(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut st = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 31 {
      out.push(s.slice(st, i))
      st = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(st, n))
  out
}

///|
fn emit(sb : StringBuilder, h : String) -> Unit {
  sb.write_string(h.length().to_string())
  sb.write_byte((10).to_byte())
  sb.write_string(h)
}

///|
fn db(sb : StringBuilder, v : Double) -> Unit {
  sb.write_byte((32).to_byte())
  sb.write_string(v.to_bits().to_string())
}

///|
fn fl(sb : StringBuilder, b : Bool) -> Unit {
  sb.write_string(if b { " 1" } else { " 0" })
}

///|
fn parse_double(s : String) -> Double {
  if s.length() > 1 && s.code_unit_at(0) == 98 {
    // `b<int64>`: exact IEEE-754 bit pattern
    let mut neg = false
    let mut i = 1
    if s.code_unit_at(1) == 45 {
      neg = true
      i = 2
    }
    let mut v : Int64 = 0L
    while i < s.length() {
      v = v * 10L + (s.code_unit_at(i) - 48).to_int64()
      i = i + 1
    }
    return Double::from_bits(if neg { -v } else { v })
  }
  match svg::parse_length(s) {
    Ok(v) => v
    Err(_) => 0.0
  }
}

///|
fn dump_segments(sb : StringBuilder, p : svg::SvgPath) -> Unit {
  let mut i = 0
  while i < p.segments.length() {
    sb.write_byte((10).to_byte())
    match p.segments[i] {
      svg::PathSegment::MoveTo(a, x, y) => {
        sb.write_string(if a { "M" } else { "m" })
        db(sb, x)
        db(sb, y)
      }
      svg::PathSegment::LineTo(a, x, y) => {
        sb.write_string(if a { "L" } else { "l" })
        db(sb, x)
        db(sb, y)
      }
      svg::PathSegment::HorizontalLineTo(a, x) => {
        sb.write_string(if a { "H" } else { "h" })
        db(sb, x)
      }
      svg::PathSegment::VerticalLineTo(a, y) => {
        sb.write_string(if a { "V" } else { "v" })
        db(sb, y)
      }
      svg::PathSegment::CurveTo(a, x1, y1, x2, y2, x, y) => {
        sb.write_string(if a { "C" } else { "c" })
        db(sb, x1)
        db(sb, y1)
        db(sb, x2)
        db(sb, y2)
        db(sb, x)
        db(sb, y)
      }
      svg::PathSegment::SmoothCurveTo(a, x2, y2, x, y) => {
        sb.write_string(if a { "S" } else { "s" })
        db(sb, x2)
        db(sb, y2)
        db(sb, x)
        db(sb, y)
      }
      svg::PathSegment::Quadratic(a, x1, y1, x, y) => {
        sb.write_string(if a { "Q" } else { "q" })
        db(sb, x1)
        db(sb, y1)
        db(sb, x)
        db(sb, y)
      }
      svg::PathSegment::SmoothQuadratic(a, x, y) => {
        sb.write_string(if a { "T" } else { "t" })
        db(sb, x)
        db(sb, y)
      }
      svg::PathSegment::EllipticalArc(a, rx, ry, rot, la, sw, x, y) => {
        sb.write_string(if a { "A" } else { "a" })
        db(sb, rx)
        db(sb, ry)
        db(sb, rot)
        fl(sb, la)
        fl(sb, sw)
        db(sb, x)
        db(sb, y)
      }
      svg::PathSegment::ClosePath(a) => sb.write_string(if a { "Z" } else { "z" })
    }
    i = i + 1
  }
}

///|
fn dump_cubics(sb : StringBuilder, cs : Array[svg::CubicSegment]) -> Unit {
  let mut i = 0
  while i < cs.length() {
    sb.write_byte((10).to_byte())
    match cs[i] {
      svg::CubicSegment::MoveTo(x, y) => {
        sb.write_string("M")
        db(sb, x)
        db(sb, y)
      }
      svg::CubicSegment::LineTo(x, y) => {
        sb.write_string("L")
        db(sb, x)
        db(sb, y)
      }
      svg::CubicSegment::CurveTo(x1, y1, x2, y2, x, y) => {
        sb.write_string("C")
        db(sb, x1)
        db(sb, y1)
        db(sb, x2)
        db(sb, y2)
        db(sb, x)
        db(sb, y)
      }
      svg::CubicSegment::ClosePath => sb.write_string("Z")
    }
    i = i + 1
  }
}

///|
fn dump_tf(sb : StringBuilder, t : svg::Transform2D) -> Unit {
  sb.write_string("OK")
  db(sb, t.a)
  db(sb, t.b)
  db(sb, t.c)
  db(sb, t.d)
  db(sb, t.e)
  db(sb, t.f)
}

///|
fn color_str(sb : StringBuilder, c : svg::SvgColor) -> Unit {
  sb.write_string(
    c.r.to_string() +
    " " +
    c.g.to_string() +
    " " +
    c.b.to_string() +
    " " +
    c.a.to_string(),
  )
}

///|
fn paint_str(sb : StringBuilder, p : svg::SvgPaint) -> Unit {
  match p {
    svg::SvgPaint::None => sb.write_string("NONE")
    svg::SvgPaint::CurrentColor => sb.write_string("CUR")
    svg::SvgPaint::Url(u) => sb.write_string("URL " + u)
    svg::SvgPaint::Color(c) => {
      sb.write_string("COL ")
      color_str(sb, c)
    }
  }
}

///|
fn align_name(a : svg::AspectAlign) -> String {
  match a {
    svg::AspectAlign::None => "none"
    svg::AspectAlign::XMinYMin => "xMinYMin"
    svg::AspectAlign::XMidYMin => "xMidYMin"
    svg::AspectAlign::XMaxYMin => "xMaxYMin"
    svg::AspectAlign::XMinYMid => "xMinYMid"
    svg::AspectAlign::XMidYMid => "xMidYMid"
    svg::AspectAlign::XMaxYMid => "xMaxYMid"
    svg::AspectAlign::XMinYMax => "xMinYMax"
    svg::AspectAlign::XMidYMax => "xMidYMax"
    svg::AspectAlign::XMaxYMax => "xMaxYMax"
  }
}

///|
fn opts_with(convert : Bool) -> svg::OptimizeOptions {
  let d = svg::OptimizeOptions::default()
  svg::OptimizeOptions::{
    float_precision: d.float_precision,
    remove_comments: d.remove_comments,
    remove_xml_decl: d.remove_xml_decl,
    remove_metadata: d.remove_metadata,
    remove_empty_groups: d.remove_empty_groups,
    collapse_groups: d.collapse_groups,
    convert_shapes_to_paths: convert,
    minify_colors: d.minify_colors,
    optimize_paths: d.optimize_paths,
    limits: d.limits,
  }
}

///|
fn run_mode(mode : String, rec : String) -> String {
  let sb = StringBuilder::new()
  if mode == "path" {
    match svg::parse_path(rec) {
      Ok(p) => {
        sb.write_string("OK")
        dump_segments(sb, p)
      }
      Err(_) => sb.write_string("ERR")
    }
  } else if mode == "geom" {
    let f = split_fields(rec)
    let tol = parse_double(f[0])
    match svg::parse_path(f[1]) {
      Ok(p) => {
        sb.write_string("OK\nCUBICS")
        dump_cubics(sb, svg::to_cubic_beziers(p))
        sb.write_string("\nBBOX")
        match svg::path_bbox(p) {
          Some(r) => {
            db(sb, r.min_x)
            db(sb, r.min_y)
            db(sb, r.max_x)
            db(sb, r.max_y)
          }
          None => sb.write_string(" NONE")
        }
        sb.write_string("\nLEN")
        db(sb, svg::path_length(p))
        sb.write_string("\nFLAT")
        match svg::flatten_path(p, tol) {
          Ok(polys) => {
            let mut k = 0
            while k < polys.length() {
              sb.write_string("\nPOLY")
              fl(sb, polys[k].closed)
              let mut j = 0
              while j < polys[k].points.length() {
                db(sb, polys[k].points[j].x)
                db(sb, polys[k].points[j].y)
                j = j + 1
              }
              k = k + 1
            }
          }
          Err(_) => sb.write_string(" ERR")
        }
      }
      Err(_) => sb.write_string("ERR")
    }
  } else if mode == "fmt" {
    let f = split_fields(rec)
    let prec = parse_dec(f[0], 0, f[0].length())
    match svg::parse_path(f[1]) {
      Ok(p) => {
        sb.write_string("OK ")
        sb.write_string(svg::format_path(p, prec))
      }
      Err(_) => sb.write_string("ERR")
    }
  } else if mode == "color" {
    match svg::parse_color(rec) {
      Ok(c) => {
        sb.write_string("OK ")
        color_str(sb, c)
      }
      Err(_) => sb.write_string("ERR")
    }
  } else if mode == "paint" {
    match svg::parse_paint(rec) {
      Ok(p) => paint_str(sb, p)
      Err(_) => sb.write_string("ERR")
    }
  } else if mode == "tf" {
    match svg::parse_transform(rec) {
      Ok(t) => dump_tf(sb, t)
      Err(_) => sb.write_string("ERR")
    }
  } else if mode == "rot" {
    let deg = parse_double(rec)
    let r = svg::Transform2D::rotate(deg)
    let k = svg::Transform2D::skew_x(deg)
    sb.write_string("OK")
    db(sb, r.a)
    db(sb, r.b)
    db(sb, k.c)
  } else if mode == "vb" {
    match svg::parse_viewbox(rec) {
      Ok(v) => {
        sb.write_string("OK")
        db(sb, v.x)
        db(sb, v.y)
        db(sb, v.width)
        db(sb, v.height)
      }
      Err(_) => sb.write_string("ERR")
    }
  } else if mode == "par" {
    match svg::parse_preserve_aspect_ratio(rec) {
      Ok(p) => {
        sb.write_string("OK " + align_name(p.align))
        sb.write_string(
          match p.meet_or_slice {
            svg::MeetOrSlice::Meet => " meet"
            svg::MeetOrSlice::Slice => " slice"
          },
        )
      }
      Err(_) => sb.write_string("ERR")
    }
  } else if mode == "vbt" {
    let f = split_fields(rec)
    match (svg::parse_viewbox(f[0]), svg::parse_preserve_aspect_ratio(f[3])) {
      (Ok(v), Ok(p)) => {
        dump_tf(sb, svg::viewbox_transform(v, parse_double(f[1]), parse_double(f[2]), p))
      }
      _ => sb.write_string("ERR")
    }
  } else if mode == "len" {
    match svg::parse_length(rec) {
      Ok(v) => {
        sb.write_string("OK")
        db(sb, v)
      }
      Err(_) => sb.write_string("ERR")
    }
  } else if mode == "xml" {
    match svg::parse_svg(rec) {
      Ok(doc) => {
        sb.write_string("OK root=" + doc.nodes[doc.root].tag)
        let mut i = 1
        while i < doc.nodes.length() {
          let nd = doc.nodes[i]
          sb.write_byte((10).to_byte())
          match nd.kind {
            svg::SvgNodeKind::Element => {
              sb.write_string("E " + nd.parent.to_string() + " " + nd.tag)
              let mut k = 0
              while k < nd.attrs.length() {
                sb.write_string(
                  " " +
                  nd.attrs[k].name +
                  "=" +
                  nd.attrs[k].value.length().to_string() +
                  ":" +
                  nd.attrs[k].value,
                )
                k = k + 1
              }
            }
            svg::SvgNodeKind::Text => {
              sb.write_string(
                "T " +
                nd.parent.to_string() +
                " " +
                nd.text.length().to_string() +
                ":" +
                nd.text,
              )
            }
            svg::SvgNodeKind::Comment => {
              sb.write_string("C " + nd.parent.to_string())
            }
            svg::SvgNodeKind::XmlDecl => {
              sb.write_string("X " + nd.parent.to_string())
            }
          }
          i = i + 1
        }
      }
      Err(_) => sb.write_string("ERR")
    }
  } else if mode == "extract" {
    match svg::parse_svg(rec) {
      Ok(doc) => {
        match svg::extract_render_paths(doc) {
          Ok(rps) => {
            sb.write_string("OK " + rps.length().to_string())
            let mut i = 0
            while i < rps.length() {
              let rp = rps[i]
              sb.write_string("\nRP id=" + rp.id + " fill=")
              paint_str(sb, rp.style.fill)
              sb.write_string(" stroke=")
              paint_str(sb, rp.style.stroke)
              sb.write_string(" sw")
              db(sb, rp.style.stroke_width)
              sb.write_string(" op")
              db(sb, rp.style.opacity)
              sb.write_string(" fop")
              db(sb, rp.style.fill_opacity)
              sb.write_string(" sop")
              db(sb, rp.style.stroke_opacity)
              sb.write_string(" tf")
              db(sb, rp.transform.a)
              db(sb, rp.transform.b)
              db(sb, rp.transform.c)
              db(sb, rp.transform.d)
              db(sb, rp.transform.e)
              db(sb, rp.transform.f)
              sb.write_string(" d=" + svg::format_path(rp.path, 6))
              i = i + 1
            }
          }
          Err(_) => sb.write_string("ERR extract")
        }
      }
      Err(_) => sb.write_string("ERR")
    }
  } else if mode == "opt" || mode == "optc" {
    match svg::optimize_svg(rec, opts_with(mode == "optc")) {
      Ok(o) => sb.write_string("OK " + o)
      Err(_) => sb.write_string("ERR")
    }
  } else {
    sb.write_string("BADMODE")
  }
  sb.to_string()
}

///|
fn limits_depth(depth : Int) -> svg::SvgLimits {
  let d = svg::SvgLimits::default()
  svg::SvgLimits::{
    max_depth: depth,
    max_elements: if depth + 10 > d.max_elements {
      depth + 10
    } else {
      d.max_elements
    },
    max_path_segments: d.max_path_segments,
    max_flatten_points: d.max_flatten_points,
    max_input_bytes: d.max_input_bytes,
  }
}

///|
fn repeat_str(sb : StringBuilder, s : String, n : Int) -> Unit {
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
}

///| Adversarial in-memory inputs; prints `kind result` (exit 0 = survived without crash).
fn run_dos(world : World, kind : String, n : Int, depth : Int) -> Int {
  if kind == "nest_g" || kind == "nest_g_opt" || kind == "nest_g_extract" {
    let sb = StringBuilder::new()
    sb.write_string("<svg>")
    repeat_str(sb, "<g>", n)
    sb.write_string("<path d=\"M0 0L1 1\"/>")
    repeat_str(sb, "</g>", n)
    sb.write_string("</svg>")
    let src = sb.to_string()
    let lim = limits_depth(depth)
    if kind == "nest_g" {
      match svg::parse_svg_with_limits(src, lim) {
        Ok(d) => io_println(world, kind + " ok nodes=" + d.nodes.length().to_string())
        Err(e) => io_println(world, kind + " err " + e.message)
      }
    } else if kind == "nest_g_extract" {
      match svg::parse_svg_with_limits(src, lim) {
        Ok(d) => {
          match svg::extract_render_paths_with_limits(d, lim) {
            Ok(r) => io_println(world, kind + " ok paths=" + r.length().to_string())
            Err(e) => io_println(world, kind + " err " + e.message)
          }
        }
        Err(e) => io_println(world, kind + " err " + e.message)
      }
    } else {
      let base = opts_with(false)
      let opts = svg::OptimizeOptions::{
        float_precision: base.float_precision,
        remove_comments: base.remove_comments,
        remove_xml_decl: base.remove_xml_decl,
        remove_metadata: base.remove_metadata,
        remove_empty_groups: base.remove_empty_groups,
        collapse_groups: base.collapse_groups,
        convert_shapes_to_paths: false,
        minify_colors: base.minify_colors,
        optimize_paths: base.optimize_paths,
        limits: lim,
      }
      match svg::optimize_svg(src, opts) {
        Ok(o) => io_println(world, kind + " ok out=" + o.length().to_string())
        Err(e) => io_println(world, kind + " err " + e.message)
      }
    }
    return 0
  }
  if kind == "segs" {
    let sb = StringBuilder::new()
    sb.write_string("M0 0")
    repeat_str(sb, "a5 5 0 1 1 3 4c1 2 3 4 5 6", n)
    match svg::parse_path(sb.to_string()) {
      Ok(p) => {
        let c = svg::to_cubic_beziers(p)
        let bb = svg::path_bbox(p)
        let l = svg::path_length(p)
        let f = svg::format_path(p, 3)
        let fl = match svg::flatten_path(p, 0.1) {
          Ok(v) => v.length()
          Err(_) => -1
        }
        let has = match bb {
          Some(_) => 1
          None => 0
        }
        io_println(
          world,
          kind +
          " ok cubics=" +
          c.length().to_string() +
          " bb=" +
          has.to_string() +
          " len=" +
          l.to_string() +
          " fmt=" +
          f.length().to_string() +
          " flat=" +
          fl.to_string(),
        )
      }
      Err(e) => io_println(world, kind + " err " + e.message)
    }
    return 0
  }
  if kind == "flatten_huge" {
    match svg::parse_path("M0 0C1e12 1e12 -1e12 1e12 1e12 0C-1e12 -1e12 1e12 -1e12 0 0") {
      Ok(p) => {
        match svg::flatten_path(p, 1.0e-300) {
          Ok(v) => io_println(world, kind + " ok polys=" + v.length().to_string())
          Err(e) => io_println(world, kind + " err " + e.message)
        }
      }
      Err(e) => io_println(world, kind + " err " + e.message)
    }
    return 0
  }
  if kind == "flatten_tiny_tol" {
    let sb = StringBuilder::new()
    sb.write_string("M0 0")
    repeat_str(sb, "c1 2 3 4 5 6", n)
    match svg::parse_path(sb.to_string()) {
      Ok(p) => {
        match svg::flatten_path(p, 1.0e-12) {
          Ok(v) => io_println(world, kind + " ok polys=" + v.length().to_string())
          Err(e) => io_println(world, kind + " err " + e.message)
        }
      }
      Err(e) => io_println(world, kind + " err " + e.message)
    }
    return 0
  }
  if kind == "extreme_numbers" {
    // Non-finite / huge coordinates through every numeric code path (Wasm32 trap hunt).
    let ds = [
      "M-1e308 0A1 1 0 0 1 1e308 0", "M0 0A1e308 1e308 1e308 1 1 1e308 -1e308", "M0 0A10 10 1e300 0 1 10 10",
      "M1e308 1e308C-1e308 -1e308 1e308 -1e308 -1e308 1e308Z", "M0 0Q1e308 1e308 -1e308 1e308T1e308 0",
      "M0 0A1e-320 1e-320 0 0 1 1e-320 1e-320", "M3e9 -3e9L-2.5e9 2.5e9",
    ]
    let mut i = 0
    let mut acc = 0
    while i < ds.length() {
      match svg::parse_path(ds[i]) {
        Ok(p) => {
          let c = svg::to_cubic_beziers(p)
          let _ = svg::path_bbox(p)
          let _ = svg::path_length(p)
          let _ = svg::format_path(p, 3)
          let _ = svg::format_path(p, 0)
          let _ = svg::format_path(p, 8)
          let _ = svg::flatten_path(p, 0.5)
          let tp = svg::transform_path(p, svg::Transform2D::new(1e300, 0.0, 0.0, 1e300, 1e300, -1e300))
          let _ = svg::format_path(tp, 3)
          acc = acc + c.length()
        }
        Err(_) => ()
      }
      i = i + 1
    }
    let cols = [
      "rgb(1e300,1e300,-1e300)", "rgba(0,0,0,1e300)", "hsl(1e300,1e300%,1e300%)", "hsla(-1e300 50% 50% / -1e300)",
      "rgb(3000000000,0,0)", "rgb(100000000000%,0%,0%)", "hsl(1e308turn,50%,50%)",
    ]
    i = 0
    while i < cols.length() {
      match svg::parse_color(cols[i]) {
        Ok(c) => acc = acc + c.r
        Err(_) => ()
      }
      i = i + 1
    }
    let tfs = [
      "rotate(1e300)", "rotate(-1e308 1e308 -1e308)", "skewX(1e300)", "skewY(90)", "matrix(1e308 1e308 1e308 1e308 1e308 1e308)",
      "scale(1e308)translate(1e308)",
    ]
    i = 0
    while i < tfs.length() {
      match svg::parse_transform(tfs[i]) {
        Ok(t) => {
          let _ = t.invert()
          acc = acc + 1
        }
        Err(_) => ()
      }
      i = i + 1
    }
    io_println(world, kind + " ok acc=" + acc.to_string())
    return 0
  }
  if kind == "big_attr" {
    let sb = StringBuilder::new()
    sb.write_string("<svg><path d=\"M0 0")
    repeat_str(sb, "L1 1", n)
    sb.write_string("\" fill=\"")
    repeat_str(sb, "&amp;", n)
    sb.write_string("\"/></svg>")
    match svg::optimize_svg(sb.to_string(), opts_with(true)) {
      Ok(o) => io_println(world, kind + " ok out=" + o.length().to_string())
      Err(e) => io_println(world, kind + " err " + e.message)
    }
    return 0
  }
  if kind == "wide_doc" {
    let sb = StringBuilder::new()
    sb.write_string("<svg>")
    repeat_str(sb, "<g fill=\"red\"><rect width=\"1\" height=\"1\" rx=\"0.5\"/><!--c--></g>", n)
    sb.write_string("</svg>")
    let src = sb.to_string()
    match svg::parse_svg(src) {
      Ok(d) => {
        match svg::extract_render_paths(d) {
          Ok(r) => {
            match svg::optimize_svg(src, opts_with(true)) {
              Ok(o) => {
                io_println(
                  world,
                  kind +
                  " ok paths=" +
                  r.length().to_string() +
                  " out=" +
                  o.length().to_string(),
                )
              }
              Err(e) => io_println(world, kind + " err " + e.message)
            }
          }
          Err(e) => io_println(world, kind + " err " + e.message)
        }
      }
      Err(e) => io_println(world, kind + " err " + e.message)
    }
    return 0
  }
  if kind == "unclosed" {
    // Unterminated constructs at max size: comment, CDATA, attribute, PI, DOCTYPE
    let heads = ["<svg><!--", "<svg><![CDATA[", "<svg><path d=\"", "<svg><?pi ", "<!DOCTYPE svg [<!ENTITY a \""]
    let mut i = 0
    while i < heads.length() {
      let sb = StringBuilder::new()
      sb.write_string(heads[i])
      repeat_str(sb, "-]?a ", n)
      match svg::parse_svg(sb.to_string()) {
        Ok(_) => io_println(world, kind + " unexpected-ok " + i.to_string())
        Err(_) => ()
      }
      i = i + 1
    }
    io_println(world, kind + " ok")
    return 0
  }
  io_println(world, "unknown dos kind " + kind)
  2
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_eprintln(world, "usage: probe <mode> <in> <out> | one <in> <mode> [reps] | dos <kind> <n> [depth]")
    return 2
  }
  let mode = args[1]
  if mode == "w1" {
    // W1 phase breakdown: stage 1 = parse_path, 2 = + to_cubic_beziers, 3 = + cubics_bbox
    let src = match fs_read(world, args[2]) {
      Ok(s) => s
      Err(_) => return 2
    }
    let stage = parse_dec(args[3], 0, args[3].length())
    let mut acc = 0
    let mut st = 0
    let n = src.length()
    let mut i = 0
    while i <= n {
      if i == n || src.code_unit_at(i) == 10 {
        if i > st {
          match svg::parse_path(src.slice(st, i)) {
            Ok(p) => {
              acc = acc + p.segments.length()
              if stage >= 2 {
                let c = svg::to_cubic_beziers(p)
                acc = acc + c.length()
                if stage >= 3 {
                  match svg::cubics_bbox(c) {
                    Some(r) => if r.max_x > 0.0 { acc = acc + 1 }
                    None => ()
                  }
                }
              }
            }
            Err(_) => acc = acc - 1
          }
        }
        st = i + 1
      }
      i = i + 1
    }
    io_println(world, "w1 stage=" + stage.to_string() + " acc=" + acc.to_string())
    return 0
  }
  if mode == "dos" {
    let n = parse_dec(args[3], 0, args[3].length())
    let depth = if args.length() > 4 {
      parse_dec(args[4], 0, args[4].length())
    } else {
      128
    }
    return run_dos(world, args[2], n, depth)
  }
  let src = match fs_read(world, args[2]) {
    Ok(s) => s
    Err(_) => {
      io_eprintln(world, "read failed")
      return 2
    }
  }
  let recs = read_records(src)
  if mode == "one" {
    let sub = args[3]
    let reps = if args.length() > 4 {
      parse_dec(args[4], 0, args[4].length())
    } else {
      1
    }
    let mut total = 0
    let mut r = 0
    while r < reps {
      total = total + run_mode(sub, recs[0]).length()
      r = r + 1
    }
    io_println(world, "ok " + total.to_string())
    return 0
  }
  let out = StringBuilder::new()
  let mut i = 0
  while i < recs.length() {
    emit(out, run_mode(mode, recs[i]))
    i = i + 1
  }
  match fs_write(world, args[3], out.to_string()) {
    Ok(_) => 0
    Err(_) => {
      io_eprintln(world, "write failed")
      2
    }
  }
}
