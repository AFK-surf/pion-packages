///| Additional edge-case tests for rotated arcs, transform_path, CSS4 colors, lengths,
///| preserveAspectRatio slice, convert_shapes_to_paths, and adversarial degenerate inputs.

fn e_approx(a : Double, b : Double, eps : Double) -> Bool {
  (a - b).abs() <= eps
}

///|
test "edge__rotated_ellipse_arc_and_scaled_radii" {
  // Too-small radii (rx=1, ry=1) between (0,0) and (20,0) must scale up per W3C F.6.6.3
  let p = match parse_path("M 0 0 A 1 1 45 0 1 20 0") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse rotated arc")
      SvgPath::{ segments: [] }
    }
  }
  let c = to_cubic_beziers(p)
  debug_assert(c.length() >= 2, "scaled-up arc emits cubics")
  let bb = match cubics_bbox(c) {
    Some(r) => r
    None => {
      debug_assert(false, "bbox")
      Rect::new(0.0, 0.0, 0.0, 0.0)
    }
  }
  // Semicircle diameter 20 -> radius 10, height 10
  debug_assert(e_approx(bb.min_x, 0.0, 1e-2) && e_approx(bb.max_x, 20.0, 1e-2), "scaled arc x span")
  debug_assert(e_approx(bb.height(), 10.0, 0.1), "scaled arc height ~= 10")
}

///|
test "edge__smooth_S_and_T_without_previous_curve" {
  // S after L uses current point as first control point; T after L uses current point
  let p = match parse_path("M 0 0 L 10 0 S 20 10 30 0 L 40 0 T 50 0") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "parse S/T after L")
      SvgPath::{ segments: [] }
    }
  }
  let c = to_cubic_beziers(p)
  debug_assert(c.length() == 5, "M, L, C(from S), L, C(from T)")
  match c[2] {
    CubicSegment::CurveTo(x1, y1, _, _, _, _) => {
      debug_assert(e_approx(x1, 10.0, 1e-9) && e_approx(y1, 0.0, 1e-9), "S after L uses cur point")
    }
    _ => debug_assert(false, "expected CurveTo")
  }
}

///|
test "edge__transform_path_and_viewbox_slice" {
  let p = match parse_path("M 0 0 L 10 0 L 10 10 Z") {
    Ok(v) => v
    Err(_) => SvgPath::{ segments: [] }
  }
  let tf = Transform2D::translate(5.0, 10.0).multiply(Transform2D::scale(2.0, 3.0))
  let tp = transform_path(p, tf)
  let bb = match path_bbox(tp) {
    Some(r) => r
    None => {
      debug_assert(false, "transformed bbox")
      Rect::new(0.0, 0.0, 0.0, 0.0)
    }
  }
  debug_assert(
    e_approx(bb.min_x, 5.0, 1e-9) &&
    e_approx(bb.max_x, 25.0, 1e-9) &&
    e_approx(bb.min_y, 10.0, 1e-9) &&
    e_approx(bb.max_y, 40.0, 1e-9),
    "transform_path bbox",
  )

  let vb = ViewBox::new(0.0, 0.0, 100.0, 50.0)
  let par = match parse_preserve_aspect_ratio("xMaxYMax slice") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "xMaxYMax slice")
      PreserveAspectRatio::default()
    }
  }
  // Viewport 200x200: sx=2, sy=4 -> slice picks 4 -> scaled 400x200 -> xMax aligns right edge to 200 (tx = -200)
  let ts = viewbox_transform(vb, 200.0, 200.0, par)
  let br = ts.apply_point(Point::new(100.0, 50.0))
  debug_assert(e_approx(br.x, 200.0, 1e-9) && e_approx(br.y, 200.0, 1e-9), "slice xMaxYMax bottom-right")
}

///|
test "edge__css4_rgb_slash_and_length_units" {
  let c = match parse_color("rgb(255 0 128 / 50%)") {
    Ok(v) => v
    Err(_) => {
      debug_assert(false, "css4 rgb")
      SvgColor::rgb(0, 0, 0)
    }
  }
  debug_assert(c.r == 255 && c.g == 0 && c.b == 128 && c.a == 128, "css4 rgb slash")

  let pt = match parse_length("72pt") {
    Ok(v) => v
    Err(_) => 0.0
  }
  debug_assert(e_approx(pt, 96.0, 1e-6), "72pt == 96px")
  let inch = match parse_length("1in") {
    Ok(v) => v
    Err(_) => 0.0
  }
  debug_assert(e_approx(inch, 96.0, 1e-6), "1in == 96px")
  let cm = match parse_length("2.54cm") {
    Ok(v) => v
    Err(_) => 0.0
  }
  debug_assert(e_approx(cm, 96.0, 1e-6), "2.54cm == 96px")
}

///|
test "edge__optimize_convert_shapes_to_paths" {
  let src = "<svg viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"3\" width=\"10\" height=\"8\" fill=\"#000000\"/></svg>"
  let opts = OptimizeOptions::{
    float_precision: 2,
    remove_comments: true,
    remove_xml_decl: true,
    remove_metadata: true,
    remove_empty_groups: true,
    collapse_groups: true,
    convert_shapes_to_paths: true,
    minify_colors: true,
    optimize_paths: true,
    limits: SvgLimits::default(),
  }
  let out = match optimize_svg(src, opts) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "opt err: " + e.to_string())
      ""
    }
  }
  debug_assert(out.contains("<path"), "rect converted to <path>")
  debug_assert(out.contains("fill=\"#000\""), "black minified to #000")
  debug_assert(out.contains("d=\"M2 3H12V11H2Z\""), "rect path: " + out)
}

///|
test "edge__security_negative_tolerance_and_max_elements" {
  let p = match parse_path("M 0 0 L 10 10") {
    Ok(v) => v
    Err(_) => SvgPath::{ segments: [] }
  }
  match flatten_path(p, 0.0) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "tolerance=0 must error")
  }
  match flatten_path(p, -1.0) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "negative tolerance must error")
  }
  let lim = SvgLimits::{
    max_depth: 128,
    max_elements: 2,
    max_path_segments: 1000,
    max_flatten_points: 1000,
    max_input_bytes: 65536,
  }
  match parse_svg_with_limits("<svg><g/><g/><g/></svg>", lim) {
    Err(e) => {
      match e.kind {
        SvgErrorKind::LimitExceeded => ()
        _ => debug_assert(false, "expected LimitExceeded for max_elements")
      }
    }
    Ok(_) => debug_assert(false, "must reject > max_elements")
  }
}

///|
test "edge__redteam_p1_p2_regressions" {
  // Streaming parse_path_to_cubics matches parse_path + to_cubic_beziers
  let d = "M0 0C10 20 30 20 40 0S70-20 80 0Q90 15 100 0T120 0a25 25-30 0150 25Z"
  let p = match parse_path(d) {
    Ok(v) => v
    Err(_) => SvgPath::{ segments: [] }
  }
  let c1 = to_cubic_beziers(p)
  let c2 = match parse_path_to_cubics(d) {
    Ok(v) => v
    Err(_) => []
  }
  debug_assert(c1.length() == c2.length(), "streaming cubic count matches")

  // P1-2 & P1-3: text whitespace + UTF-8 charrefs
  let o_txt = match optimize_svg(
    "<svg><text>Hello <tspan>World</tspan> caf&#233; &#x1F600;</text></svg>",
    OptimizeOptions::default(),
  ) {
    Ok(s) => s
    Err(_) => ""
  }
  debug_assert(o_txt.contains("Hello <tspan>World</tspan> caf\u{e9} \u{1F600}"), o_txt)

  // P1-4 & P1-5: <switch> and animation child <g> preserved
  let o_sw = match optimize_svg(
    "<svg><switch><g><rect width=\"5\" height=\"5\"/><circle r=\"3\"/></g></switch><g><animateTransform attributeName=\"transform\" type=\"rotate\" to=\"90\"/><rect width=\"5\" height=\"5\"/></g></svg>",
    OptimizeOptions::default(),
  ) {
    Ok(s) => s
    Err(_) => ""
  }
  debug_assert(o_sw.contains("<switch><g>"), o_sw)
  debug_assert(o_sw.contains("<g><animateTransform"), o_sw)

  // P1-6: format_path never emits inf/nan
  let p_huge = match parse_path("M0 0L1e306 1e307") {
    Ok(v) => v
    Err(_) => SvgPath::{ segments: [] }
  }
  let f_huge = format_path(p_huge, 3)
  debug_assert(!f_huge.contains("inf") && !f_huge.contains("nan"), f_huge)

  // P2-4 & P2-19: Payne-Hanek trig + scale-invariant invert
  let rot_big = Transform2D::rotate(1000000.0)
  debug_assert(e_approx(rot_big.a, 0.17364817766507232, 1e-14), "rotate(1e6)")
  match Transform2D::scale(1e-8, 1e-8).invert() {
    Some(inv) => debug_assert(e_approx(inv.a, 1e8, 1.0), "small scale invert")
    None => debug_assert(false, "scale(1e-8) must be invertible")
  }
}
