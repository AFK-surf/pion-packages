///| Flat-array iterative SVG DOM parser, basic shape-to-path conversion, and render path extraction.

///| Key-value XML/SVG attribute.
pub struct SvgAttr {
  pub name : String
  pub value : String
}

///|
pub fn SvgAttr::new(name : String, value : String) -> SvgAttr {
  SvgAttr::{ name: name, value: value }
}

///| Node kind in `SvgDocument`.
pub enum SvgNodeKind {
  Element
  Text
  Comment
  XmlDecl
}

///| Flat DOM node.
pub struct SvgNode {
  pub kind : SvgNodeKind
  pub tag : String
  pub attrs : Array[SvgAttr]
  pub text : String
  pub children : Array[Int]
  pub parent : Int
}

///| Flat-array SVG document tree.
pub struct SvgDocument {
  pub nodes : Array[SvgNode]
  pub root : Int
}

///| Look up an attribute value on an `SvgNode`.
pub fn SvgNode::attr(self : SvgNode, name : String) -> Option[String] {
  let n = self.attrs.length()
  let mut i = 0
  while i < n {
    if self.attrs[i].name == name {
      return Some(self.attrs[i].value)
    }
    i = i + 1
  }
  None
}

fn find_attr(attrs : Array[SvgAttr], name : String) -> Option[String] {
  let n = attrs.length()
  let mut i = 0
  while i < n {
    if attrs[i].name == name {
      return Some(attrs[i].value)
    }
    i = i + 1
  }
  None
}

fn local_name(name : String) -> String {
  let n = name.length()
  let mut i = 0
  while i < n {
    if name.code_unit_at(i) == 0x3A {
      return name.slice(i + 1, n)
    }
    i = i + 1
  }
  name
}

///| Resolved inheritable presentation style for a renderable path.
pub struct ResolvedStyle {
  pub fill : SvgPaint
  pub stroke : SvgPaint
  pub stroke_width : Double
  pub opacity : Double
  pub fill_opacity : Double
  pub stroke_opacity : Double
  pub display_none : Bool
}

///|
pub fn ResolvedStyle::default() -> ResolvedStyle {
  ResolvedStyle::{
    fill: SvgPaint::Color(SvgColor::rgb(0, 0, 0)),
    stroke: SvgPaint::None,
    stroke_width: 1.0,
    opacity: 1.0,
    fill_opacity: 1.0,
    stroke_opacity: 1.0,
    display_none: false,
  }
}

///| Flattened renderable path with merged ancestor transform and inherited style.
pub struct RenderPath {
  pub path : SvgPath
  pub transform : Transform2D
  pub style : ResolvedStyle
  pub id : String
}

fn is_xml_name_char(c : Int) -> Bool {
  (c >= 0x41 && c <= 0x5A) ||
  (c >= 0x61 && c <= 0x7A) ||
  (c >= 0x30 && c <= 0x39) ||
  c == 0x2D ||
  c == 0x5F ||
  c == 0x2E ||
  c == 0x3A ||
  c >= 0x80
}

fn is_valid_xml_char(cp : Int) -> Bool {
  cp == 0x09 ||
  cp == 0x0A ||
  cp == 0x0D ||
  (cp >= 0x20 && cp <= 0xD7FF) ||
  (cp >= 0xE000 && cp <= 0xFFFD) ||
  (cp >= 0x10000 && cp <= 0x10FFFF)
}

fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

///| Strict XML 1.0 entity & numeric character reference decoder (full UTF-8 up to U+10FFFF).
///| Rejects bare `&`, unknown named entities, and invalid XML 1.0 code points (0, surrogates, > U+10FFFF).
fn decode_xml_entities(
  s : String,
  base_offset : Int,
  in_attr : Bool,
) -> Result[String, SvgError] {
  let n = s.length()
  let mut needs_decode = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 0x26 || (in_attr && (c == 0x09 || c == 0x0A || c == 0x0D)) {
      needs_decode = true
      break
    }
    i = i + 1
  }
  if !needs_decode {
    return Ok(s)
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 0x26 {
      let mut semi = i + 1
      while semi < n && semi < i + 32 {
        let sc = s.code_unit_at(semi)
        if sc == 0x3B {
          break
        }
        if sc == 0x26 || sc == 0x3C || is_xml_ws(sc) {
          return Err(
            SvgError::new(
              SvgErrorKind::InvalidXml,
              base_offset + i,
              "bare '&' or malformed entity reference",
            ),
          )
        }
        semi = semi + 1
      }
      if semi >= n || s.code_unit_at(semi) != 0x3B {
        return Err(
          SvgError::new(
            SvgErrorKind::InvalidXml,
            base_offset + i,
            "unterminated entity reference",
          ),
        )
      }
      let ent = s.slice(i + 1, semi)
      if ent == "amp" {
        sb.write_byte((0x26).to_byte())
      } else if ent == "lt" {
        sb.write_byte((0x3C).to_byte())
      } else if ent == "gt" {
        sb.write_byte((0x3E).to_byte())
      } else if ent == "quot" {
        sb.write_byte((0x22).to_byte())
      } else if ent == "apos" {
        sb.write_byte((0x27).to_byte())
      } else if ent.length() >= 2 && ent.code_unit_at(0) == 0x23 {
        let mut cp = 0
        let mut ok = true
        if ent.code_unit_at(1) == 0x78 {
          // XML 1.0 §4.1: hex charref uses lowercase 'x'
          if ent.length() < 3 {
            ok = false
          } else {
            let mut k = 2
            while k < ent.length() {
              let hv = hex_val(ent.code_unit_at(k))
              if hv < 0 {
                ok = false
                break
              }
              if cp <= 0x10FFFF {
                cp = (cp << 4) | hv
              }
              k = k + 1
            }
          }
        } else {
          let mut k = 1
          while k < ent.length() {
            let d = ent.code_unit_at(k) - 0x30
            if d < 0 || d > 9 {
              ok = false
              break
            }
            if cp <= 0x10FFFF {
              cp = cp * 10 + d
            }
            k = k + 1
          }
        }
        if !ok || !is_valid_xml_char(cp) {
          return Err(
            SvgError::new(
              SvgErrorKind::InvalidXml,
              base_offset + i,
              "invalid numeric character reference: &" + ent + ";",
            ),
          )
        }
        write_utf8_cp(sb, cp)
      } else {
        return Err(
          SvgError::new(
            SvgErrorKind::InvalidXml,
            base_offset + i,
            "unknown XML entity: &" + ent + ";",
          ),
        )
      }
      i = semi + 1
      continue
    }
    // XML 1.0 §3.3.3 attribute value normalization: literal TAB/LF/CR -> space
    if in_attr && (c == 0x09 || c == 0x0A || c == 0x0D) {
      if c == 0x0D && i + 1 < n && s.code_unit_at(i + 1) == 0x0A {
        i = i + 1
      }
      sb.write_byte((0x20).to_byte())
      i = i + 1
      continue
    }
    sb.write_byte(c.to_byte())
    i = i + 1
  }
  Ok(sb.to_string())
}

struct NsBinding {
  depth : Int
  prefix : String
}

fn ns_is_bound(bindings : Array[NsBinding], prefix : String) -> Bool {
  if prefix == "xml" || prefix == "xmlns" {
    return true
  }
  let mut k = bindings.length() - 1
  while k >= 0 {
    if bindings[k].prefix == prefix {
      return true
    }
    k = k - 1
  }
  false
}

fn split_qname_prefix(name : String) -> Option[String] {
  let n = name.length()
  let mut colon = -1
  let mut i = 0
  while i < n {
    if name.code_unit_at(i) == 0x3A {
      if colon >= 0 {
        // Multiple colons -> invalid QName
        return Some(":")
      }
      colon = i
    }
    i = i + 1
  }
  if colon < 0 {
    return None
  }
  if colon == 0 || colon == n - 1 {
    return Some(":")
  }
  Some(name.slice(0, colon))
}

///| Parse an SVG document string with default `SvgLimits`.
pub fn parse_svg(src : String) -> Result[SvgDocument, SvgError] {
  parse_svg_with_limits(src, SvgLimits::default())
}

///| Parse an SVG document string with explicit `SvgLimits` (iterative stack, zero recursion).
pub fn parse_svg_with_limits(
  src : String,
  limits : SvgLimits,
) -> Result[SvgDocument, SvgError] {
  let n = src.length()
  if n > limits.max_input_bytes {
    return Err(
      SvgError::new(
        SvgErrorKind::LimitExceeded,
        0,
        "SVG input exceeds max_input_bytes",
      ),
    )
  }
  let nodes : Array[SvgNode] = []
  // Node 0 is synthetic document container
  nodes.push(
    SvgNode::{
      kind: SvgNodeKind::Element,
      tag: "#document",
      attrs: [],
      text: "",
      children: [],
      parent: -1,
    },
  )
  let stack : Array[Int] = [0]
  let ns_bindings : Array[NsBinding] = []
  let mut elem_count = 0
  let mut root_elem = -1
  let mut i = 0
  // Skip UTF-8 BOM (EF BB BF) if present at start of document
  if n >= 3 &&
  src.code_unit_at(0) == 0xEF &&
  src.code_unit_at(1) == 0xBB &&
  src.code_unit_at(2) == 0xBF {
    i = 3
  }
  while i < n {
    let c = src.code_unit_at(i)
    if c == 0x3C {
      if i + 1 >= n {
        return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unexpected '<' at EOF"))
      }
      let c1 = src.code_unit_at(i + 1)
      // Comment <!-- ... --> (XML 1.0 §2.5: '--' forbidden inside comment body)
      if c1 == 0x21 && i + 3 < n && src.code_unit_at(i + 2) == 0x2D && src.code_unit_at(i + 3) == 0x2D {
        let start = i + 4
        let mut j = start
        let mut found = -1
        while j + 1 < n {
          if src.code_unit_at(j) == 0x2D && src.code_unit_at(j + 1) == 0x2D {
            if j + 2 < n && src.code_unit_at(j + 2) == 0x3E {
              found = j
              break
            }
            return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "'--' is not allowed inside XML comment"))
          }
          j = j + 1
        }
        if found < 0 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated comment"))
        }
        let parent_id = stack[stack.length() - 1]
        let id = nodes.length()
        nodes.push(
          SvgNode::{
            kind: SvgNodeKind::Comment,
            tag: "",
            attrs: [],
            text: src.slice(start, found),
            children: [],
            parent: parent_id,
          },
        )
        nodes[parent_id].children.push(id)
        i = found + 3
        continue
      }
      // CDATA <![CDATA[ ... ]]>
      if c1 == 0x21 && i + 8 < n && src.slice(i, i + 9) == "<![CDATA[" {
        if stack.length() <= 1 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "CDATA outside root element"))
        }
        let start = i + 9
        let mut j = start
        let mut found = -1
        while j + 2 < n {
          if src.code_unit_at(j) == 0x5D && src.code_unit_at(j + 1) == 0x5D && src.code_unit_at(j + 2) == 0x3E {
            found = j
            break
          }
          j = j + 1
        }
        if found < 0 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated CDATA"))
        }
        let parent_id = stack[stack.length() - 1]
        let id = nodes.length()
        nodes.push(
          SvgNode::{
            kind: SvgNodeKind::Text,
            tag: "",
            attrs: [],
            text: src.slice(start, found),
            children: [],
            parent: parent_id,
          },
        )
        nodes[parent_id].children.push(id)
        i = found + 3
        continue
      }
      // DOCTYPE <!DOCTYPE ... > (skip safely without DTD expansion; reject other <!foo>)
      if c1 == 0x21 {
        if i + 9 >= n || src.slice(i, i + 9) != "<!DOCTYPE" || !is_xml_ws(src.code_unit_at(i + 9)) {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "invalid XML declaration"))
        }
        let mut j = i + 9
        let mut bracket_depth = 0
        while j < n {
          let ch = src.code_unit_at(j)
          if ch == 0x5B {
            bracket_depth = bracket_depth + 1
          } else if ch == 0x5D && bracket_depth > 0 {
            bracket_depth = bracket_depth - 1
          } else if ch == 0x3E && bracket_depth == 0 {
            break
          }
          j = j + 1
        }
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated DOCTYPE"))
        }
        i = j + 1
        continue
      }
      // Processing instruction / XML declaration <? ... ?>
      if c1 == 0x3F {
        let start = i + 2
        let mut j = start
        let mut found = -1
        while j + 1 < n {
          if src.code_unit_at(j) == 0x3F && src.code_unit_at(j + 1) == 0x3E {
            found = j
            break
          }
          j = j + 1
        }
        if found < 0 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated processing instruction"))
        }
        let parent_id = stack[stack.length() - 1]
        let id = nodes.length()
        nodes.push(
          SvgNode::{
            kind: SvgNodeKind::XmlDecl,
            tag: "",
            attrs: [],
            text: src.slice(start, found),
            children: [],
            parent: parent_id,
          },
        )
        nodes[parent_id].children.push(id)
        i = found + 2
        continue
      }
      // Closing tag </name> (XML 1.0 §3.1: no whitespace allowed between '</' and Name)
      if c1 == 0x2F {
        let name_start = i + 2
        let mut j = name_start
        while j < n && is_xml_name_char(src.code_unit_at(j)) {
          j = j + 1
        }
        if j == name_start {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "invalid closing tag"))
        }
        let close_name = src.slice(name_start, j)
        j = skip_xml_ws(src, j, n)
        if j >= n || src.code_unit_at(j) != 0x3E {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected '>' in closing tag"))
        }
        if stack.length() <= 1 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unexpected closing tag </" + close_name + ">"))
        }
        let top_id = stack[stack.length() - 1]
        if nodes[top_id].tag != close_name {
          return Err(
            SvgError::new(
              SvgErrorKind::InvalidXml,
              i,
              "mismatched closing tag </" + close_name + "> for <" + nodes[top_id].tag + ">",
            ),
          )
        }
        let closing_depth = stack.length() - 1
        let _ = stack.pop()
        while ns_bindings.length() > 0 && ns_bindings[ns_bindings.length() - 1].depth >= closing_depth {
          let _ = ns_bindings.pop()
        }
        i = j + 1
        continue
      }
      // Opening tag <name attrs... /?>
      let name_start = i + 1
      let mut j = name_start
      while j < n && is_xml_name_char(src.code_unit_at(j)) {
        j = j + 1
      }
      if j == name_start {
        return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "empty tag name"))
      }
      let tag_name = src.slice(name_start, j)
      let parent_id = stack[stack.length() - 1]
      if parent_id == 0 && root_elem >= 0 {
        return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "multiple root elements"))
      }
      elem_count = elem_count + 1
      if elem_count > limits.max_elements {
        return Err(SvgError::new(SvgErrorKind::LimitExceeded, i, "SVG exceeds max_elements"))
      }
      let attrs : Array[SvgAttr] = []
      let mut self_closing = false
      let elem_depth = stack.length()
      let mut need_ws_before_attr = false
      while j < n {
        let before_ws = j
        j = skip_xml_ws(src, j, n)
        let had_ws = j > before_ws
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "unterminated start tag"))
        }
        let ch = src.code_unit_at(j)
        if ch == 0x3E {
          j = j + 1
          break
        }
        if ch == 0x2F {
          if j + 1 < n && src.code_unit_at(j + 1) == 0x3E {
            self_closing = true
            j = j + 2
            break
          }
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected '>' after '/'"))
        }
        if need_ws_before_attr && !had_ws {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected whitespace between attributes"))
        }
        let an_start = j
        while j < n && is_xml_name_char(src.code_unit_at(j)) {
          j = j + 1
        }
        if j == an_start {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "invalid attribute name"))
        }
        let attr_name = src.slice(an_start, j)
        // Reject duplicate attributes
        let mut ak = 0
        while ak < attrs.length() {
          if attrs[ak].name == attr_name {
            return Err(SvgError::new(SvgErrorKind::InvalidXml, an_start, "duplicate attribute: " + attr_name))
          }
          ak = ak + 1
        }
        j = skip_xml_ws(src, j, n)
        if j >= n || src.code_unit_at(j) != 0x3D {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected '=' after attribute name"))
        }
        j = skip_xml_ws(src, j + 1, n)
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected attribute value"))
        }
        let q = src.code_unit_at(j)
        if q != 0x22 && q != 0x27 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "attribute value must be quoted"))
        }
        j = j + 1
        let val_start = j
        while j < n {
          let vc = src.code_unit_at(j)
          if vc == q {
            break
          }
          if vc == 0x3C {
            return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "'<' not allowed in attribute value"))
          }
          j = j + 1
        }
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "unterminated attribute string"))
        }
        let attr_val = match decode_xml_entities(src.slice(val_start, j), val_start, true) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        j = j + 1
        // Record xmlns:prefix declarations
        if attr_name.length() > 6 && attr_name.slice(0, 6) == "xmlns:" {
          let pfx = attr_name.slice(6, attr_name.length())
          ns_bindings.push(NsBinding::{ depth: elem_depth, prefix: pfx })
        }
        attrs.push(SvgAttr::new(attr_name, attr_val))
        need_ws_before_attr = true
      }
      // Validate namespace prefixes on element tag and all attributes
      match split_qname_prefix(tag_name) {
        Some(pfx) => {
          if pfx == ":" || !ns_is_bound(ns_bindings, pfx) {
            return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "undeclared namespace prefix: " + pfx))
          }
        }
        None => ()
      }
      let mut ai = 0
      while ai < attrs.length() {
        match split_qname_prefix(attrs[ai].name) {
          Some(pfx) => {
            if pfx == ":" || !ns_is_bound(ns_bindings, pfx) {
              return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "undeclared attribute prefix: " + pfx))
            }
          }
          None => ()
        }
        ai = ai + 1
      }
      let id = nodes.length()
      nodes.push(
        SvgNode::{
          kind: SvgNodeKind::Element,
          tag: tag_name,
          attrs: attrs,
          text: "",
          children: [],
          parent: parent_id,
        },
      )
      nodes[parent_id].children.push(id)
      if root_elem < 0 && parent_id == 0 {
        root_elem = id
      }
      if self_closing {
        while ns_bindings.length() > 0 && ns_bindings[ns_bindings.length() - 1].depth >= elem_depth {
          let _ = ns_bindings.pop()
        }
      } else {
        if stack.length() > limits.max_depth {
          return Err(
            SvgError::new(
              SvgErrorKind::LimitExceeded,
              i,
              "SVG nesting exceeds max_depth",
            ),
          )
        }
        stack.push(id)
      }
      i = j
    } else {
      // Text node
      let start = i
      while i < n && src.code_unit_at(i) != 0x3C {
        i = i + 1
      }
      let raw = src.slice(start, i)
      let parent_id = stack[stack.length() - 1]
      if parent_id == 0 {
        // Document-level text: only whitespace is allowed outside root element
        let mut wi = 0
        while wi < raw.length() {
          if !is_xml_ws(raw.code_unit_at(wi)) {
            return Err(SvgError::new(SvgErrorKind::InvalidXml, start + wi, "unexpected text outside root element"))
          }
          wi = wi + 1
        }
      } else {
        let decoded = match decode_xml_entities(raw, start, false) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        let id = nodes.length()
        nodes.push(
          SvgNode::{
            kind: SvgNodeKind::Text,
            tag: "",
            attrs: [],
            text: decoded,
            children: [],
            parent: parent_id,
          },
        )
        nodes[parent_id].children.push(id)
      }
    }
  }
  if stack.length() != 1 {
    let unclosed = nodes[stack[stack.length() - 1]].tag
    return Err(SvgError::new(SvgErrorKind::InvalidXml, n, "unclosed tag <" + unclosed + ">"))
  }
  if root_elem < 0 {
    return Err(SvgError::new(SvgErrorKind::InvalidXml, 0, "no root element found"))
  }
  Ok(SvgDocument::{ nodes: nodes, root: root_elem })
}

fn attr_len_or(attrs : Array[SvgAttr], name : String, default_val : Double) -> Double {
  match find_attr(attrs, name) {
    Some(v) => {
      match parse_length(v) {
        Ok(x) => x
        Err(_) => default_val
      }
    }
    None => default_val
  }
}

fn parse_rect_radius_attr(attrs : Array[SvgAttr], name : String) -> Option[Double] {
  match find_attr(attrs, name) {
    Some(raw) => {
      let t = ascii_lower(ascii_trim(raw))
      if t == "auto" {
        return None
      }
      match parse_length(raw) {
        Ok(v) => if v >= 0.0 { Some(v) } else { None }
        Err(_) => None
      }
    }
    None => None
  }
}

///| Parse SVG polyline/polygon `points` list (SVG 2 §10.6: odd trailing coordinate is ignored).
fn parse_points_list(s : String) -> Result[Array[Point], SvgError] {
  let pts : Array[Point] = []
  let n = s.length()
  let mut i = skip_ws(s, 0, n)
  while i < n {
    let (x, i1) = match scan_svg_number(s, i, n) {
      Some(v) => v
      None => break
    }
    let i2 = skip_comma_wsp(s, i1, n)
    let (y, i3) = match scan_svg_number(s, i2, n) {
      Some(v) => v
      None => break
    }
    pts.push(Point::new(x, y))
    i = skip_comma_wsp(s, i3, n)
  }
  Ok(pts)
}

///| Convert a basic SVG shape (`rect`, `circle`, `ellipse`, `line`, `polyline`, `polygon`, `path`) to `SvgPath`.
pub fn shape_to_path(
  tag : String,
  attrs : Array[SvgAttr],
) -> Result[SvgPath, SvgError] {
  let ltag = local_name(tag)
  if ltag == "path" {
    match find_attr(attrs, "d") {
      Some(d) => return parse_path(d)
      None => return Ok(SvgPath::{ segments: [] })
    }
  }
  if ltag == "rect" {
    let x = attr_len_or(attrs, "x", 0.0)
    let y = attr_len_or(attrs, "y", 0.0)
    let w = attr_len_or(attrs, "width", 0.0)
    let h = attr_len_or(attrs, "height", 0.0)
    if w <= 0.0 || h <= 0.0 {
      return Ok(SvgPath::{ segments: [] })
    }
    let rx_opt = parse_rect_radius_attr(attrs, "rx")
    let ry_opt = parse_rect_radius_attr(attrs, "ry")
    let (rx0, ry0) = match (rx_opt, ry_opt) {
      (Some(a), Some(b)) => (a, b)
      (Some(a), None) => (a, a)
      (None, Some(b)) => (b, b)
      _ => (0.0, 0.0)
    }
    let mut rx = rx0
    let mut ry = ry0
    if rx > w * 0.5 { rx = w * 0.5 }
    if ry > h * 0.5 { ry = h * 0.5 }
    if rx == 0.0 || ry == 0.0 {
      return Ok(
        SvgPath::{
          segments: [
            PathSegment::MoveTo(true, x, y),
            PathSegment::HorizontalLineTo(true, x + w),
            PathSegment::VerticalLineTo(true, y + h),
            PathSegment::HorizontalLineTo(true, x),
            PathSegment::ClosePath(true),
          ],
        },
      )
    }
    return Ok(
      SvgPath::{
        segments: [
          PathSegment::MoveTo(true, x + rx, y),
          PathSegment::HorizontalLineTo(true, x + w - rx),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, false, true, x + w, y + ry),
          PathSegment::VerticalLineTo(true, y + h - ry),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, false, true, x + w - rx, y + h),
          PathSegment::HorizontalLineTo(true, x + rx),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, false, true, x, y + h - ry),
          PathSegment::VerticalLineTo(true, y + ry),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, false, true, x + rx, y),
          PathSegment::ClosePath(true),
        ],
      },
    )
  }
  if ltag == "circle" {
    let cx = attr_len_or(attrs, "cx", 0.0)
    let cy = attr_len_or(attrs, "cy", 0.0)
    let r = attr_len_or(attrs, "r", 0.0)
    if r <= 0.0 {
      return Ok(SvgPath::{ segments: [] })
    }
    return Ok(
      SvgPath::{
        segments: [
          PathSegment::MoveTo(true, cx - r, cy),
          PathSegment::EllipticalArc(true, r, r, 0.0, true, false, cx + r, cy),
          PathSegment::EllipticalArc(true, r, r, 0.0, true, false, cx - r, cy),
          PathSegment::ClosePath(true),
        ],
      },
    )
  }
  if ltag == "ellipse" {
    let cx = attr_len_or(attrs, "cx", 0.0)
    let cy = attr_len_or(attrs, "cy", 0.0)
    let rx = attr_len_or(attrs, "rx", 0.0)
    let ry = attr_len_or(attrs, "ry", 0.0)
    if rx <= 0.0 || ry <= 0.0 {
      return Ok(SvgPath::{ segments: [] })
    }
    return Ok(
      SvgPath::{
        segments: [
          PathSegment::MoveTo(true, cx - rx, cy),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, true, false, cx + rx, cy),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, true, false, cx - rx, cy),
          PathSegment::ClosePath(true),
        ],
      },
    )
  }
  if ltag == "line" {
    let x1 = attr_len_or(attrs, "x1", 0.0)
    let y1 = attr_len_or(attrs, "y1", 0.0)
    let x2 = attr_len_or(attrs, "x2", 0.0)
    let y2 = attr_len_or(attrs, "y2", 0.0)
    return Ok(
      SvgPath::{
        segments: [
          PathSegment::MoveTo(true, x1, y1),
          PathSegment::LineTo(true, x2, y2),
        ],
      },
    )
  }
  if ltag == "polyline" || ltag == "polygon" {
    let raw = match find_attr(attrs, "points") {
      Some(v) => v
      None => return Ok(SvgPath::{ segments: [] })
    }
    let pts = match parse_points_list(raw) {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    if pts.length() == 0 {
      return Ok(SvgPath::{ segments: [] })
    }
    let segs : Array[PathSegment] = []
    segs.push(PathSegment::MoveTo(true, pts[0].x, pts[0].y))
    let mut i = 1
    while i < pts.length() {
      segs.push(PathSegment::LineTo(true, pts[i].x, pts[i].y))
      i = i + 1
    }
    if ltag == "polygon" {
      segs.push(PathSegment::ClosePath(true))
    }
    return Ok(SvgPath::{ segments: segs })
  }
  Err(SvgError::new(SvgErrorKind::InvalidXml, 0, "unsupported shape tag: " + tag))
}

fn clamp01(v : Double) -> Double {
  if v < 0.0 {
    0.0
  } else if v > 1.0 {
    1.0
  } else {
    v
  }
}

fn parse_alpha_value(s : String) -> Option[Double] {
  let t = ascii_trim(s)
  let n = t.length()
  match scan_num_and_pct(t, 0, n) {
    Some((v, is_pct, next_i)) => {
      if skip_ws(t, next_i, n) != n {
        return None
      }
      let f = if is_pct { v / 100.0 } else { v }
      Some(clamp01(f))
    }
    None => None
  }
}

fn strip_css_comments(s : String) -> String {
  if !s.contains("/*") {
    return s
  }
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    if i + 1 < n && s.code_unit_at(i) == 0x2F && s.code_unit_at(i + 1) == 0x2A {
      i = i + 2
      while i + 1 < n && !(s.code_unit_at(i) == 0x2A && s.code_unit_at(i + 1) == 0x2F) {
        i = i + 1
      }
      if i + 1 < n {
        i = i + 2
      } else {
        i = n
      }
    } else {
      sb.write_byte(s.code_unit_at(i).to_byte())
      i = i + 1
    }
  }
  sb.to_string()
}

fn strip_css_important(s : String) -> String {
  let t = ascii_trim(s)
  let lower = ascii_lower(t)
  let n = lower.length()
  if n >= 9 && lower.slice(n - 9, n) == "important" {
    let mut j = n - 9
    while j > 0 && is_svg_ws(lower.code_unit_at(j - 1)) {
      j = j - 1
    }
    if j > 0 && lower.code_unit_at(j - 1) == 0x21 {
      return ascii_trim(t.slice(0, j - 1))
    }
  }
  t
}

fn apply_style_prop(base : ResolvedStyle, prop : String, raw_val : String) -> ResolvedStyle {
  let k = ascii_lower(ascii_trim(prop))
  let v = strip_css_important(raw_val)
  if k == "fill" {
    match parse_paint(v) {
      Ok(p) => {
        return ResolvedStyle::{
          fill: p,
          stroke: base.stroke,
          stroke_width: base.stroke_width,
          opacity: base.opacity,
          fill_opacity: base.fill_opacity,
          stroke_opacity: base.stroke_opacity,
          display_none: base.display_none,
        }
      }
      Err(_) => return base
    }
  }
  if k == "stroke" {
    match parse_paint(v) {
      Ok(p) => {
        return ResolvedStyle::{
          fill: base.fill,
          stroke: p,
          stroke_width: base.stroke_width,
          opacity: base.opacity,
          fill_opacity: base.fill_opacity,
          stroke_opacity: base.stroke_opacity,
          display_none: base.display_none,
        }
      }
      Err(_) => return base
    }
  }
  if k == "stroke-width" {
    match parse_length(v) {
      Ok(sw) => {
        return ResolvedStyle::{
          fill: base.fill,
          stroke: base.stroke,
          stroke_width: sw,
          opacity: base.opacity,
          fill_opacity: base.fill_opacity,
          stroke_opacity: base.stroke_opacity,
          display_none: base.display_none,
        }
      }
      Err(_) => return base
    }
  }
  if k == "fill-opacity" {
    match parse_alpha_value(v) {
      Some(op) => {
        return ResolvedStyle::{
          fill: base.fill,
          stroke: base.stroke,
          stroke_width: base.stroke_width,
          opacity: base.opacity,
          fill_opacity: op,
          stroke_opacity: base.stroke_opacity,
          display_none: base.display_none,
        }
      }
      None => return base
    }
  }
  if k == "stroke-opacity" {
    match parse_alpha_value(v) {
      Some(op) => {
        return ResolvedStyle::{
          fill: base.fill,
          stroke: base.stroke,
          stroke_width: base.stroke_width,
          opacity: base.opacity,
          fill_opacity: base.fill_opacity,
          stroke_opacity: op,
          display_none: base.display_none,
        }
      }
      None => return base
    }
  }
  if k == "display" {
    let dl = ascii_lower(v)
    if dl == "none" {
      return ResolvedStyle::{
        fill: base.fill,
        stroke: base.stroke,
        stroke_width: base.stroke_width,
        opacity: base.opacity,
        fill_opacity: base.fill_opacity,
        stroke_opacity: base.stroke_opacity,
        display_none: true,
      }
    }
  }
  base
}

fn resolve_node_style(parent_style : ResolvedStyle, attrs : Array[SvgAttr]) -> ResolvedStyle {
  let mut st = parent_style
  let mut inline_style = ""
  let mut has_own_opacity = false
  let mut own_opacity = 1.0
  let n = attrs.length()
  let mut i = 0
  while i < n {
    let a = attrs[i]
    if a.name == "style" {
      inline_style = a.value
    } else if a.name == "opacity" {
      match parse_alpha_value(a.value) {
        Some(op) => {
          has_own_opacity = true
          own_opacity = op
        }
        None => ()
      }
    } else {
      st = apply_style_prop(st, a.name, a.value)
    }
    i = i + 1
  }
  // Inline `style="..."` overrides presentation attributes (including `opacity`)
  if inline_style.length() > 0 {
    let cleaned = strip_css_comments(inline_style)
    let sn = cleaned.length()
    let mut pos = 0
    while pos < sn {
      let mut semi = pos
      while semi < sn && cleaned.code_unit_at(semi) != 0x3B {
        semi = semi + 1
      }
      let decl = cleaned.slice(pos, semi)
      let dn = decl.length()
      let mut colon = -1
      let mut k = 0
      while k < dn {
        if decl.code_unit_at(k) == 0x3A {
          colon = k
          break
        }
        k = k + 1
      }
      if colon > 0 {
        let prop = decl.slice(0, colon)
        let prop_val = decl.slice(colon + 1, dn)
        let pk = ascii_lower(ascii_trim(prop))
        if pk == "opacity" {
          match parse_alpha_value(strip_css_important(prop_val)) {
            Some(op) => {
              has_own_opacity = true
              own_opacity = op
            }
            None => ()
          }
        } else {
          st = apply_style_prop(st, prop, prop_val)
        }
      }
      pos = semi + 1
    }
  }
  if has_own_opacity {
    st = ResolvedStyle::{
      fill: st.fill,
      stroke: st.stroke,
      stroke_width: st.stroke_width,
      opacity: parent_style.opacity * own_opacity,
      fill_opacity: st.fill_opacity,
      stroke_opacity: st.stroke_opacity,
      display_none: st.display_none,
    }
  }
  st
}

struct WalkFrame {
  node_id : Int
  transform : Transform2D
  style : ResolvedStyle
}

fn is_shape_tag(tag : String) -> Bool {
  tag == "path" ||
  tag == "rect" ||
  tag == "circle" ||
  tag == "ellipse" ||
  tag == "line" ||
  tag == "polyline" ||
  tag == "polygon"
}

fn is_non_render_container(tag : String) -> Bool {
  tag == "defs" ||
  tag == "metadata" ||
  tag == "title" ||
  tag == "desc" ||
  tag == "style" ||
  tag == "clipPath" ||
  tag == "mask" ||
  tag == "pattern" ||
  tag == "symbol" ||
  tag == "marker"
}

///| Extract all renderable paths from an `SvgDocument` with merged transforms and inherited styles.
pub fn extract_render_paths(
  doc : SvgDocument,
) -> Result[Array[RenderPath], SvgError] {
  extract_render_paths_with_limits(doc, SvgLimits::default())
}

///| Extract all renderable paths from an `SvgDocument` with explicit `SvgLimits`.
pub fn extract_render_paths_with_limits(
  doc : SvgDocument,
  limits : SvgLimits,
) -> Result[Array[RenderPath], SvgError] {
  let out : Array[RenderPath] = []
  if doc.root < 0 || doc.root >= doc.nodes.length() {
    return Ok(out)
  }
  let stack : Array[WalkFrame] = [
    WalkFrame::{
      node_id: doc.root,
      transform: Transform2D::identity(),
      style: ResolvedStyle::default(),
    },
  ]
  while stack.length() > 0 {
    let frame = match stack.pop() {
      Some(f) => f
      None => break
    }
    let node = doc.nodes[frame.node_id]
    match node.kind {
      SvgNodeKind::Element => ()
      _ => continue
    }
    let ltag = local_name(node.tag)
    if is_non_render_container(ltag) {
      continue
    }
    let style = resolve_node_style(frame.style, node.attrs)
    if style.display_none {
      continue
    }
    // SVG 2 error handling: an invalid transform affects only this attribute (ignored), never aborts the document
    let mut cur_tf = match find_attr(node.attrs, "transform") {
      Some(tstr) => {
        match parse_transform(tstr) {
          Ok(t) => frame.transform.multiply(t)
          Err(_) => frame.transform
        }
      }
      None => frame.transform
    }
    // Nested <svg x y width height viewBox preserveAspectRatio> establishes a new viewport transform (SVG 2 §8.2)
    if ltag == "svg" && frame.node_id != doc.root {
      let vx = attr_len_or(node.attrs, "x", 0.0)
      let vy = attr_len_or(node.attrs, "y", 0.0)
      if vx != 0.0 || vy != 0.0 {
        cur_tf = cur_tf.multiply(Transform2D::translate(vx, vy))
      }
      match find_attr(node.attrs, "viewBox") {
        Some(vb_str) => {
          match parse_viewbox(vb_str) {
            Ok(vb) => {
              let vw = attr_len_or(node.attrs, "width", vb.width)
              let vh = attr_len_or(node.attrs, "height", vb.height)
              let par = match find_attr(node.attrs, "preserveAspectRatio") {
                Some(pstr) => {
                  match parse_preserve_aspect_ratio(pstr) {
                    Ok(p) => p
                    Err(_) => PreserveAspectRatio::default()
                  }
                }
                None => PreserveAspectRatio::default()
              }
              cur_tf = cur_tf.multiply(viewbox_transform(vb, vw, vh, par))
            }
            Err(_) => ()
          }
        }
        None => ()
      }
    }
    if is_shape_tag(ltag) {
      let p = if ltag == "path" {
        match find_attr(node.attrs, "d") {
          Some(d) => {
            // SVG 2 path error handling: render up to the error; only propagate LimitExceeded
            match parse_path_lenient(d, limits) {
              Ok(sp) => sp
              Err(e) => return Err(e)
            }
          }
          None => SvgPath::{ segments: [] }
        }
      } else {
        match shape_to_path(ltag, node.attrs) {
          Ok(sp) => sp
          Err(_) => SvgPath::{ segments: [] }
        }
      }
      if p.segments.length() > 0 {
        let id = match find_attr(node.attrs, "id") {
          Some(v) => v
          None => ""
        }
        out.push(RenderPath::{ path: p, transform: cur_tf, style: style, id: id })
      }
    }
    // Push children in reverse order to preserve document order
    let mut k = node.children.length() - 1
    while k >= 0 {
      stack.push(
        WalkFrame::{
          node_id: node.children[k],
          transform: cur_tf,
          style: style,
        },
      )
      k = k - 1
    }
  }
  Ok(out)
}
