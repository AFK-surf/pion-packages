///| Flat-array iterative SVG DOM parser, basic shape-to-path conversion, and render path extraction.

///| Key-value XML/SVG attribute.
pub struct SvgAttr {
  pub name : String
  pub value : String
}

///|
pub fn SvgAttr::new(name : String, value : String) -> SvgAttr {
  SvgAttr::{ name: name, value: value }
}

///| Node kind in `SvgDocument`.
pub enum SvgNodeKind {
  Element
  Text
  Comment
  XmlDecl
}

///| Flat DOM node.
pub struct SvgNode {
  pub kind : SvgNodeKind
  pub tag : String
  pub attrs : Array[SvgAttr]
  pub text : String
  pub children : Array[Int]
  pub parent : Int
}

///| Flat-array SVG document tree.
pub struct SvgDocument {
  pub nodes : Array[SvgNode]
  pub root : Int
}

///| Look up an attribute value on an `SvgNode`.
pub fn SvgNode::attr(self : SvgNode, name : String) -> Option[String] {
  let n = self.attrs.length()
  let mut i = 0
  while i < n {
    if self.attrs[i].name == name {
      return Some(self.attrs[i].value)
    }
    i = i + 1
  }
  None
}

fn find_attr(attrs : Array[SvgAttr], name : String) -> Option[String] {
  let n = attrs.length()
  let mut i = 0
  while i < n {
    if attrs[i].name == name {
      return Some(attrs[i].value)
    }
    i = i + 1
  }
  None
}

///| Resolved inheritable presentation style for a renderable path.
pub struct ResolvedStyle {
  pub fill : SvgPaint
  pub stroke : SvgPaint
  pub stroke_width : Double
  pub opacity : Double
  pub fill_opacity : Double
  pub stroke_opacity : Double
  pub display_none : Bool
}

///|
pub fn ResolvedStyle::default() -> ResolvedStyle {
  ResolvedStyle::{
    fill: SvgPaint::Color(SvgColor::rgb(0, 0, 0)),
    stroke: SvgPaint::None,
    stroke_width: 1.0,
    opacity: 1.0,
    fill_opacity: 1.0,
    stroke_opacity: 1.0,
    display_none: false,
  }
}

///| Flattened renderable path with merged ancestor transform and inherited style.
pub struct RenderPath {
  pub path : SvgPath
  pub transform : Transform2D
  pub style : ResolvedStyle
  pub id : String
}

fn is_xml_name_char(c : Int) -> Bool {
  (c >= 0x41 && c <= 0x5A) ||
  (c >= 0x61 && c <= 0x7A) ||
  (c >= 0x30 && c <= 0x39) ||
  c == 0x2D ||
  c == 0x5F ||
  c == 0x2E ||
  c == 0x3A ||
  c >= 0x80
}

fn decode_xml_entities(s : String) -> String {
  if !s.contains("&") {
    return s
  }
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 0x26 {
      let mut semi = i + 1
      while semi < n && semi < i + 12 && s.code_unit_at(semi) != 0x3B {
        semi = semi + 1
      }
      if semi < n && s.code_unit_at(semi) == 0x3B {
        let ent = s.slice(i + 1, semi)
        if ent == "amp" {
          sb.write_byte((0x26).to_byte())
          i = semi + 1
          continue
        } else if ent == "lt" {
          sb.write_byte((0x3C).to_byte())
          i = semi + 1
          continue
        } else if ent == "gt" {
          sb.write_byte((0x3E).to_byte())
          i = semi + 1
          continue
        } else if ent == "quot" {
          sb.write_byte((0x22).to_byte())
          i = semi + 1
          continue
        } else if ent == "apos" {
          sb.write_byte((0x27).to_byte())
          i = semi + 1
          continue
        } else if ent.length() >= 2 && ent.code_unit_at(0) == 0x23 {
          let mut cp = 0
          let mut ok = true
          if ent.length() >= 3 && (ent.code_unit_at(1) == 0x78 || ent.code_unit_at(1) == 0x58) {
            let mut k = 2
            while k < ent.length() {
              let hv = hex_val(ent.code_unit_at(k))
              if hv < 0 {
                ok = false
                break
              }
              cp = (cp << 4) | hv
              k = k + 1
            }
          } else {
            let mut k = 1
            while k < ent.length() {
              let d = ent.code_unit_at(k) - 0x30
              if d < 0 || d > 9 {
                ok = false
                break
              }
              cp = cp * 10 + d
              k = k + 1
            }
          }
          if ok && cp > 0 && cp < 128 {
            sb.write_byte(cp.to_byte())
            i = semi + 1
            continue
          }
        }
      }
    }
    sb.write_byte(c.to_byte())
    i = i + 1
  }
  sb.to_string()
}

///| Parse an SVG document string with default `SvgLimits`.
pub fn parse_svg(src : String) -> Result[SvgDocument, SvgError] {
  parse_svg_with_limits(src, SvgLimits::default())
}

///| Parse an SVG document string with explicit `SvgLimits` (iterative stack, zero recursion).
pub fn parse_svg_with_limits(
  src : String,
  limits : SvgLimits,
) -> Result[SvgDocument, SvgError] {
  let n = src.length()
  if n > limits.max_input_bytes {
    return Err(
      SvgError::new(
        SvgErrorKind::LimitExceeded,
        0,
        "SVG input exceeds max_input_bytes",
      ),
    )
  }
  let nodes : Array[SvgNode] = []
  // Node 0 is synthetic document container
  nodes.push(
    SvgNode::{
      kind: SvgNodeKind::Element,
      tag: "#document",
      attrs: [],
      text: "",
      children: [],
      parent: -1,
    },
  )
  let stack : Array[Int] = [0]
  let mut elem_count = 0
  let mut root_elem = -1
  let mut i = 0
  while i < n {
    let c = src.code_unit_at(i)
    if c == 0x3C {
      // Tag, comment, PI/XML decl, DOCTYPE, or CDATA
      if i + 1 >= n {
        return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unexpected '<' at EOF"))
      }
      let c1 = src.code_unit_at(i + 1)
      // Comment <!-- ... -->
      if c1 == 0x21 && i + 3 < n && src.code_unit_at(i + 2) == 0x2D && src.code_unit_at(i + 3) == 0x2D {
        let start = i + 4
        let mut j = start
        let mut found = -1
        while j + 2 < n {
          if src.code_unit_at(j) == 0x2D && src.code_unit_at(j + 1) == 0x2D && src.code_unit_at(j + 2) == 0x3E {
            found = j
            break
          }
          j = j + 1
        }
        if found < 0 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated comment"))
        }
        let parent_id = stack[stack.length() - 1]
        let id = nodes.length()
        nodes.push(
          SvgNode::{
            kind: SvgNodeKind::Comment,
            tag: "",
            attrs: [],
            text: src.slice(start, found),
            children: [],
            parent: parent_id,
          },
        )
        nodes[parent_id].children.push(id)
        i = found + 3
        continue
      }
      // CDATA <![CDATA[ ... ]]>
      if c1 == 0x21 && i + 8 < n && src.slice(i, i + 9) == "<![CDATA[" {
        let start = i + 9
        let mut j = start
        let mut found = -1
        while j + 2 < n {
          if src.code_unit_at(j) == 0x5D && src.code_unit_at(j + 1) == 0x5D && src.code_unit_at(j + 2) == 0x3E {
            found = j
            break
          }
          j = j + 1
        }
        if found < 0 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated CDATA"))
        }
        let parent_id = stack[stack.length() - 1]
        let id = nodes.length()
        nodes.push(
          SvgNode::{
            kind: SvgNodeKind::Text,
            tag: "",
            attrs: [],
            text: src.slice(start, found),
            children: [],
            parent: parent_id,
          },
        )
        nodes[parent_id].children.push(id)
        i = found + 3
        continue
      }
      // DOCTYPE <!DOCTYPE ... > (skip safely without DTD expansion)
      if c1 == 0x21 {
        let mut j = i + 2
        let mut bracket_depth = 0
        while j < n {
          let ch = src.code_unit_at(j)
          if ch == 0x5B {
            bracket_depth = bracket_depth + 1
          } else if ch == 0x5D && bracket_depth > 0 {
            bracket_depth = bracket_depth - 1
          } else if ch == 0x3E && bracket_depth == 0 {
            break
          }
          j = j + 1
        }
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated declaration"))
        }
        i = j + 1
        continue
      }
      // Processing instruction / XML declaration <? ... ?>
      if c1 == 0x3F {
        let start = i + 2
        let mut j = start
        let mut found = -1
        while j + 1 < n {
          if src.code_unit_at(j) == 0x3F && src.code_unit_at(j + 1) == 0x3E {
            found = j
            break
          }
          j = j + 1
        }
        if found < 0 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated processing instruction"))
        }
        let parent_id = stack[stack.length() - 1]
        let id = nodes.length()
        nodes.push(
          SvgNode::{
            kind: SvgNodeKind::XmlDecl,
            tag: "",
            attrs: [],
            text: src.slice(start, found),
            children: [],
            parent: parent_id,
          },
        )
        nodes[parent_id].children.push(id)
        i = found + 2
        continue
      }
      // Closing tag </name>
      if c1 == 0x2F {
        let mut j = skip_ws(src, i + 2, n)
        let name_start = j
        while j < n && is_xml_name_char(src.code_unit_at(j)) {
          j = j + 1
        }
        let close_name = src.slice(name_start, j)
        j = skip_ws(src, j, n)
        if j >= n || src.code_unit_at(j) != 0x3E {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected '>' in closing tag"))
        }
        if stack.length() <= 1 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unexpected closing tag </" + close_name + ">"))
        }
        let top_id = stack[stack.length() - 1]
        if nodes[top_id].tag != close_name {
          return Err(
            SvgError::new(
              SvgErrorKind::InvalidXml,
              i,
              "mismatched closing tag </" + close_name + "> for <" + nodes[top_id].tag + ">",
            ),
          )
        }
        let _ = stack.pop()
        i = j + 1
        continue
      }
      // Opening tag <name attrs... /?>
      let name_start = i + 1
      let mut j = name_start
      while j < n && is_xml_name_char(src.code_unit_at(j)) {
        j = j + 1
      }
      if j == name_start {
        return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "empty tag name"))
      }
      let tag_name = src.slice(name_start, j)
      elem_count = elem_count + 1
      if elem_count > limits.max_elements {
        return Err(SvgError::new(SvgErrorKind::LimitExceeded, i, "SVG exceeds max_elements"))
      }
      let attrs : Array[SvgAttr] = []
      let mut self_closing = false
      while j < n {
        j = skip_ws(src, j, n)
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "unterminated start tag"))
        }
        let ch = src.code_unit_at(j)
        if ch == 0x3E {
          j = j + 1
          break
        }
        if ch == 0x2F {
          if j + 1 < n && src.code_unit_at(j + 1) == 0x3E {
            self_closing = true
            j = j + 2
            break
          }
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected '>' after '/'"))
        }
        let an_start = j
        while j < n && is_xml_name_char(src.code_unit_at(j)) {
          j = j + 1
        }
        if j == an_start {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "invalid attribute name"))
        }
        let attr_name = src.slice(an_start, j)
        j = skip_ws(src, j, n)
        if j >= n || src.code_unit_at(j) != 0x3D {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected '=' after attribute name"))
        }
        j = skip_ws(src, j + 1, n)
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected attribute value"))
        }
        let q = src.code_unit_at(j)
        if q != 0x22 && q != 0x27 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "attribute value must be quoted"))
        }
        j = j + 1
        let val_start = j
        while j < n && src.code_unit_at(j) != q {
          j = j + 1
        }
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "unterminated attribute string"))
        }
        let attr_val = decode_xml_entities(src.slice(val_start, j))
        j = j + 1
        attrs.push(SvgAttr::new(attr_name, attr_val))
      }
      let parent_id = stack[stack.length() - 1]
      let id = nodes.length()
      nodes.push(
        SvgNode::{
          kind: SvgNodeKind::Element,
          tag: tag_name,
          attrs: attrs,
          text: "",
          children: [],
          parent: parent_id,
        },
      )
      nodes[parent_id].children.push(id)
      if root_elem < 0 && parent_id == 0 {
        root_elem = id
      }
      if !self_closing {
        // Depth excludes synthetic #document node
        if stack.length() > limits.max_depth {
          return Err(
            SvgError::new(
              SvgErrorKind::LimitExceeded,
              i,
              "SVG nesting exceeds max_depth",
            ),
          )
        }
        stack.push(id)
      }
      i = j
    } else {
      // Text node
      let start = i
      while i < n && src.code_unit_at(i) != 0x3C {
        i = i + 1
      }
      let raw = src.slice(start, i)
      let trimmed = ascii_trim(raw)
      if trimmed.length() > 0 {
        let parent_id = stack[stack.length() - 1]
        let id = nodes.length()
        nodes.push(
          SvgNode::{
            kind: SvgNodeKind::Text,
            tag: "",
            attrs: [],
            text: decode_xml_entities(raw),
            children: [],
            parent: parent_id,
          },
        )
        nodes[parent_id].children.push(id)
      }
    }
  }
  if stack.length() != 1 {
    let unclosed = nodes[stack[stack.length() - 1]].tag
    return Err(SvgError::new(SvgErrorKind::InvalidXml, n, "unclosed tag <" + unclosed + ">"))
  }
  if root_elem < 0 {
    return Err(SvgError::new(SvgErrorKind::InvalidXml, 0, "no root element found"))
  }
  Ok(SvgDocument::{ nodes: nodes, root: root_elem })
}

fn attr_len_or(attrs : Array[SvgAttr], name : String, default_val : Double) -> Double {
  match find_attr(attrs, name) {
    Some(v) => {
      match parse_length(v) {
        Ok(x) => x
        Err(_) => default_val
      }
    }
    None => default_val
  }
}

fn parse_points_list(s : String) -> Result[Array[Point], SvgError] {
  let pts : Array[Point] = []
  let n = s.length()
  let mut i = skip_ws(s, 0, n)
  while i < n {
    let (x, i1) = match scan_svg_number(s, i, n) {
      Some(v) => v
      None => return Err(SvgError::new(SvgErrorKind::InvalidNumber, i, "expected point x"))
    }
    let i2 = skip_comma_wsp(s, i1, n)
    let (y, i3) = match scan_svg_number(s, i2, n) {
      Some(v) => v
      None => return Err(SvgError::new(SvgErrorKind::InvalidNumber, i2, "expected point y"))
    }
    pts.push(Point::new(x, y))
    i = skip_comma_wsp(s, i3, n)
  }
  Ok(pts)
}

///| Convert a basic SVG shape (`rect`, `circle`, `ellipse`, `line`, `polyline`, `polygon`, `path`) to `SvgPath`.
pub fn shape_to_path(
  tag : String,
  attrs : Array[SvgAttr],
) -> Result[SvgPath, SvgError] {
  if tag == "path" {
    match find_attr(attrs, "d") {
      Some(d) => return parse_path(d)
      None => return Ok(SvgPath::{ segments: [] })
    }
  }
  if tag == "rect" {
    let x = attr_len_or(attrs, "x", 0.0)
    let y = attr_len_or(attrs, "y", 0.0)
    let w = attr_len_or(attrs, "width", 0.0)
    let h = attr_len_or(attrs, "height", 0.0)
    if w <= 0.0 || h <= 0.0 {
      return Ok(SvgPath::{ segments: [] })
    }
    let has_rx = match find_attr(attrs, "rx") {
      Some(_) => true
      None => false
    }
    let has_ry = match find_attr(attrs, "ry") {
      Some(_) => true
      None => false
    }
    let mut rx = if has_rx { attr_len_or(attrs, "rx", 0.0) } else { 0.0 }
    let mut ry = if has_ry { attr_len_or(attrs, "ry", 0.0) } else { 0.0 }
    if has_rx && !has_ry {
      ry = rx
    } else if !has_rx && has_ry {
      rx = ry
    }
    if rx < 0.0 { rx = 0.0 }
    if ry < 0.0 { ry = 0.0 }
    if rx > w * 0.5 { rx = w * 0.5 }
    if ry > h * 0.5 { ry = h * 0.5 }
    if rx == 0.0 || ry == 0.0 {
      return Ok(
        SvgPath::{
          segments: [
            PathSegment::MoveTo(true, x, y),
            PathSegment::HorizontalLineTo(true, x + w),
            PathSegment::VerticalLineTo(true, y + h),
            PathSegment::HorizontalLineTo(true, x),
            PathSegment::ClosePath(true),
          ],
        },
      )
    }
    return Ok(
      SvgPath::{
        segments: [
          PathSegment::MoveTo(true, x + rx, y),
          PathSegment::HorizontalLineTo(true, x + w - rx),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, false, true, x + w, y + ry),
          PathSegment::VerticalLineTo(true, y + h - ry),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, false, true, x + w - rx, y + h),
          PathSegment::HorizontalLineTo(true, x + rx),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, false, true, x, y + h - ry),
          PathSegment::VerticalLineTo(true, y + ry),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, false, true, x + rx, y),
          PathSegment::ClosePath(true),
        ],
      },
    )
  }
  if tag == "circle" {
    let cx = attr_len_or(attrs, "cx", 0.0)
    let cy = attr_len_or(attrs, "cy", 0.0)
    let r = attr_len_or(attrs, "r", 0.0)
    if r <= 0.0 {
      return Ok(SvgPath::{ segments: [] })
    }
    return Ok(
      SvgPath::{
        segments: [
          PathSegment::MoveTo(true, cx - r, cy),
          PathSegment::EllipticalArc(true, r, r, 0.0, true, false, cx + r, cy),
          PathSegment::EllipticalArc(true, r, r, 0.0, true, false, cx - r, cy),
          PathSegment::ClosePath(true),
        ],
      },
    )
  }
  if tag == "ellipse" {
    let cx = attr_len_or(attrs, "cx", 0.0)
    let cy = attr_len_or(attrs, "cy", 0.0)
    let rx = attr_len_or(attrs, "rx", 0.0)
    let ry = attr_len_or(attrs, "ry", 0.0)
    if rx <= 0.0 || ry <= 0.0 {
      return Ok(SvgPath::{ segments: [] })
    }
    return Ok(
      SvgPath::{
        segments: [
          PathSegment::MoveTo(true, cx - rx, cy),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, true, false, cx + rx, cy),
          PathSegment::EllipticalArc(true, rx, ry, 0.0, true, false, cx - rx, cy),
          PathSegment::ClosePath(true),
        ],
      },
    )
  }
  if tag == "line" {
    let x1 = attr_len_or(attrs, "x1", 0.0)
    let y1 = attr_len_or(attrs, "y1", 0.0)
    let x2 = attr_len_or(attrs, "x2", 0.0)
    let y2 = attr_len_or(attrs, "y2", 0.0)
    return Ok(
      SvgPath::{
        segments: [
          PathSegment::MoveTo(true, x1, y1),
          PathSegment::LineTo(true, x2, y2),
        ],
      },
    )
  }
  if tag == "polyline" || tag == "polygon" {
    let raw = match find_attr(attrs, "points") {
      Some(v) => v
      None => return Ok(SvgPath::{ segments: [] })
    }
    let pts = match parse_points_list(raw) {
      Ok(p) => p
      Err(e) => return Err(e)
    }
    if pts.length() == 0 {
      return Ok(SvgPath::{ segments: [] })
    }
    let segs : Array[PathSegment] = []
    segs.push(PathSegment::MoveTo(true, pts[0].x, pts[0].y))
    let mut i = 1
    while i < pts.length() {
      segs.push(PathSegment::LineTo(true, pts[i].x, pts[i].y))
      i = i + 1
    }
    if tag == "polygon" {
      segs.push(PathSegment::ClosePath(true))
    }
    return Ok(SvgPath::{ segments: segs })
  }
  Err(SvgError::new(SvgErrorKind::InvalidXml, 0, "unsupported shape tag: " + tag))
}

fn apply_style_prop(base : ResolvedStyle, prop : String, raw_val : String) -> ResolvedStyle {
  let k = ascii_lower(ascii_trim(prop))
  let v = ascii_trim(raw_val)
  if k == "fill" {
    match parse_paint(v) {
      Ok(p) => {
        return ResolvedStyle::{
          fill: p,
          stroke: base.stroke,
          stroke_width: base.stroke_width,
          opacity: base.opacity,
          fill_opacity: base.fill_opacity,
          stroke_opacity: base.stroke_opacity,
          display_none: base.display_none,
        }
      }
      Err(_) => return base
    }
  }
  if k == "stroke" {
    match parse_paint(v) {
      Ok(p) => {
        return ResolvedStyle::{
          fill: base.fill,
          stroke: p,
          stroke_width: base.stroke_width,
          opacity: base.opacity,
          fill_opacity: base.fill_opacity,
          stroke_opacity: base.stroke_opacity,
          display_none: base.display_none,
        }
      }
      Err(_) => return base
    }
  }
  if k == "stroke-width" {
    match parse_length(v) {
      Ok(sw) => {
        return ResolvedStyle::{
          fill: base.fill,
          stroke: base.stroke,
          stroke_width: sw,
          opacity: base.opacity,
          fill_opacity: base.fill_opacity,
          stroke_opacity: base.stroke_opacity,
          display_none: base.display_none,
        }
      }
      Err(_) => return base
    }
  }
  if k == "opacity" {
    match scan_svg_number(v, 0, v.length()) {
      Some((op, _)) => {
        return ResolvedStyle::{
          fill: base.fill,
          stroke: base.stroke,
          stroke_width: base.stroke_width,
          opacity: base.opacity * op,
          fill_opacity: base.fill_opacity,
          stroke_opacity: base.stroke_opacity,
          display_none: base.display_none,
        }
      }
      None => return base
    }
  }
  if k == "fill-opacity" {
    match scan_svg_number(v, 0, v.length()) {
      Some((op, _)) => {
        return ResolvedStyle::{
          fill: base.fill,
          stroke: base.stroke,
          stroke_width: base.stroke_width,
          opacity: base.opacity,
          fill_opacity: op,
          stroke_opacity: base.stroke_opacity,
          display_none: base.display_none,
        }
      }
      None => return base
    }
  }
  if k == "stroke-opacity" {
    match scan_svg_number(v, 0, v.length()) {
      Some((op, _)) => {
        return ResolvedStyle::{
          fill: base.fill,
          stroke: base.stroke,
          stroke_width: base.stroke_width,
          opacity: base.opacity,
          fill_opacity: base.fill_opacity,
          stroke_opacity: op,
          display_none: base.display_none,
        }
      }
      None => return base
    }
  }
  if k == "display" {
    if ascii_lower(v) == "none" {
      return ResolvedStyle::{
        fill: base.fill,
        stroke: base.stroke,
        stroke_width: base.stroke_width,
        opacity: base.opacity,
        fill_opacity: base.fill_opacity,
        stroke_opacity: base.stroke_opacity,
        display_none: true,
      }
    }
  }
  base
}

fn resolve_node_style(parent_style : ResolvedStyle, attrs : Array[SvgAttr]) -> ResolvedStyle {
  let mut st = parent_style
  let mut inline_style = ""
  let n = attrs.length()
  let mut i = 0
  while i < n {
    let a = attrs[i]
    if a.name == "style" {
      inline_style = a.value
    } else {
      st = apply_style_prop(st, a.name, a.value)
    }
    i = i + 1
  }
  // Inline `style="..."` overrides presentation attributes
  if inline_style.length() > 0 {
    let sn = inline_style.length()
    let mut pos = 0
    while pos < sn {
      let mut semi = pos
      while semi < sn && inline_style.code_unit_at(semi) != 0x3B {
        semi = semi + 1
      }
      let decl = inline_style.slice(pos, semi)
      let dn = decl.length()
      let mut colon = -1
      let mut k = 0
      while k < dn {
        if decl.code_unit_at(k) == 0x3A {
          colon = k
          break
        }
        k = k + 1
      }
      if colon > 0 {
        let prop = decl.slice(0, colon)
        let prop_val = decl.slice(colon + 1, dn)
        st = apply_style_prop(st, prop, prop_val)
      }
      pos = semi + 1
    }
  }
  st
}

struct WalkFrame {
  node_id : Int
  transform : Transform2D
  style : ResolvedStyle
}

fn is_shape_tag(tag : String) -> Bool {
  tag == "path" ||
  tag == "rect" ||
  tag == "circle" ||
  tag == "ellipse" ||
  tag == "line" ||
  tag == "polyline" ||
  tag == "polygon"
}

fn is_non_render_container(tag : String) -> Bool {
  tag == "defs" ||
  tag == "metadata" ||
  tag == "title" ||
  tag == "desc" ||
  tag == "style" ||
  tag == "clipPath" ||
  tag == "mask" ||
  tag == "pattern" ||
  tag == "symbol"
}

///| Extract all renderable paths from an `SvgDocument` with merged transforms and inherited styles.
pub fn extract_render_paths(
  doc : SvgDocument,
) -> Result[Array[RenderPath], SvgError] {
  extract_render_paths_with_limits(doc, SvgLimits::default())
}

///| Extract all renderable paths from an `SvgDocument` with explicit `SvgLimits`.
pub fn extract_render_paths_with_limits(
  doc : SvgDocument,
  limits : SvgLimits,
) -> Result[Array[RenderPath], SvgError] {
  let out : Array[RenderPath] = []
  if doc.root < 0 || doc.root >= doc.nodes.length() {
    return Ok(out)
  }
  let stack : Array[WalkFrame] = [
    WalkFrame::{
      node_id: doc.root,
      transform: Transform2D::identity(),
      style: ResolvedStyle::default(),
    },
  ]
  while stack.length() > 0 {
    let frame = match stack.pop() {
      Some(f) => f
      None => break
    }
    let node = doc.nodes[frame.node_id]
    match node.kind {
      SvgNodeKind::Element => ()
      _ => continue
    }
    if is_non_render_container(node.tag) {
      continue
    }
    let style = resolve_node_style(frame.style, node.attrs)
    if style.display_none {
      continue
    }
    let cur_tf = match find_attr(node.attrs, "transform") {
      Some(tstr) => {
        match parse_transform(tstr) {
          Ok(t) => frame.transform.multiply(t)
          Err(e) => return Err(e)
        }
      }
      None => frame.transform
    }
    if is_shape_tag(node.tag) {
      let p = if node.tag == "path" {
        match find_attr(node.attrs, "d") {
          Some(d) => {
            match parse_path_with_limits(d, limits) {
              Ok(sp) => sp
              Err(e) => return Err(e)
            }
          }
          None => SvgPath::{ segments: [] }
        }
      } else {
        match shape_to_path(node.tag, node.attrs) {
          Ok(sp) => sp
          Err(e) => return Err(e)
        }
      }
      if p.segments.length() > 0 {
        let id = match find_attr(node.attrs, "id") {
          Some(v) => v
          None => ""
        }
        out.push(RenderPath::{ path: p, transform: cur_tf, style: style, id: id })
      }
    }
    // Push children in reverse order to preserve document order
    let mut k = node.children.length() - 1
    while k >= 0 {
      stack.push(
        WalkFrame::{
          node_id: node.children[k],
          transform: cur_tf,
          style: style,
        },
      )
      k = k - 1
    }
  }
  Ok(out)
}
