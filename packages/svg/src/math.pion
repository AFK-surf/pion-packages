///| Pure-Pion deterministic IEEE-754 math, fast SVG number scanning, and compact number formatting.

let pi_val : Double = 3.14159265358979323846

let tau_val : Double = 6.28318530717958647692

let half_pi_val : Double = 1.57079632679489661923

let inv_half_pi : Double = 0.63661977236758134308

let pi_2_hi : Double = 1.570796326794896558

let pi_2_lo : Double = 6.12323399573676603587e-17

let sqrt3_val : Double = 1.73205080756887729353

let pi_6_val : Double = 0.52359877559829887308

let tan_pi_12 : Double = 0.26794919243112270647

fn is_nan(x : Double) -> Bool {
  x != x
}

fn is_finite(x : Double) -> Bool {
  x == x && x - x == 0.0
}

fn deg_to_rad(deg : Double) -> Double {
  deg * (pi_val / 180.0)
}

fn poly_sin(r : Double) -> Double {
  let r2 = r * r
  let mut acc = -1.0 / 1307674368000.0
  acc = acc * r2 + 1.0 / 6227020800.0
  acc = acc * r2 - 1.0 / 39916800.0
  acc = acc * r2 + 1.0 / 362880.0
  acc = acc * r2 - 1.0 / 5040.0
  acc = acc * r2 + 1.0 / 120.0
  acc = acc * r2 - 1.0 / 6.0
  r + r * r2 * acc
}

fn poly_cos(r : Double) -> Double {
  let r2 = r * r
  let mut acc = -1.0 / 87178291200.0
  acc = acc * r2 + 1.0 / 479001600.0
  acc = acc * r2 - 1.0 / 3628800.0
  acc = acc * r2 + 1.0 / 40320.0
  acc = acc * r2 - 1.0 / 720.0
  acc = acc * r2 + 1.0 / 24.0
  acc = acc * r2 - 0.5
  1.0 + r2 * acc
}

fn reduce_angle(x : Double) -> (Double, Int) {
  let mut v = x
  if v.abs() > 1000000.0 {
    let turns = (v / tau_val).floor()
    v = v - turns * tau_val
  }
  let kf = (v * inv_half_pi + 0.5).floor()
  let r = (v - kf * pi_2_hi) - kf * pi_2_lo
  let mut q = kf.to_int() % 4
  if q < 0 {
    q = q + 4
  }
  (r, q)
}

fn sin_f64(x : Double) -> Double {
  if !is_finite(x) {
    return 0.0
  }
  let (r, q) = reduce_angle(x)
  if q == 0 {
    poly_sin(r)
  } else if q == 1 {
    poly_cos(r)
  } else if q == 2 {
    -poly_sin(r)
  } else {
    -poly_cos(r)
  }
}

fn cos_f64(x : Double) -> Double {
  if !is_finite(x) {
    return 1.0
  }
  let (r, q) = reduce_angle(x)
  if q == 0 {
    poly_cos(r)
  } else if q == 1 {
    -poly_sin(r)
  } else if q == 2 {
    -poly_cos(r)
  } else {
    poly_sin(r)
  }
}

fn tan_f64(x : Double) -> Double {
  let c = cos_f64(x)
  if c.abs() < 1e-15 {
    if sin_f64(x) >= 0.0 {
      1e15
    } else {
      -1e15
    }
  } else {
    sin_f64(x) / c
  }
}

fn atan_f64(x : Double) -> Double {
  if !is_finite(x) {
    return 0.0
  }
  let mut neg = false
  let mut v = x
  if v < 0.0 {
    neg = true
    v = -v
  }
  let mut invert = false
  if v > 1.0 {
    invert = true
    v = 1.0 / v
  }
  let mut shift = false
  if v > tan_pi_12 {
    shift = true
    v = (sqrt3_val * v - 1.0) / (sqrt3_val + v)
  }
  let v2 = v * v
  let mut acc = -1.0 / 19.0
  acc = acc * v2 + 1.0 / 17.0
  acc = acc * v2 - 1.0 / 15.0
  acc = acc * v2 + 1.0 / 13.0
  acc = acc * v2 - 1.0 / 11.0
  acc = acc * v2 + 1.0 / 9.0
  acc = acc * v2 - 1.0 / 7.0
  acc = acc * v2 + 1.0 / 5.0
  acc = acc * v2 - 1.0 / 3.0
  let mut res = v + v * v2 * acc
  if shift {
    res = pi_6_val + res
  }
  if invert {
    res = half_pi_val - res
  }
  if neg {
    -res
  } else {
    res
  }
}

fn atan2_f64(y : Double, x : Double) -> Double {
  if x > 0.0 {
    atan_f64(y / x)
  } else if x < 0.0 {
    if y >= 0.0 {
      atan_f64(y / x) + pi_val
    } else {
      atan_f64(y / x) - pi_val
    }
  } else if y > 0.0 {
    half_pi_val
  } else if y < 0.0 {
    -half_pi_val
  } else {
    0.0
  }
}

fn acos_f64(x : Double) -> Double {
  let clamped = if x < -1.0 {
    -1.0
  } else if x > 1.0 {
    1.0
  } else {
    x
  }
  atan2_f64((1.0 - clamped * clamped).sqrt(), clamped)
}

fn is_svg_ws(c : Int) -> Bool {
  c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D || c == 0x0C
}

fn is_ascii_digit(c : Int) -> Bool {
  c >= 0x30 && c <= 0x39
}

fn hex_val(c : Int) -> Int {
  if c >= 0x30 && c <= 0x39 {
    c - 0x30
  } else if c >= 0x41 && c <= 0x46 {
    c - 0x41 + 10
  } else if c >= 0x61 && c <= 0x66 {
    c - 0x61 + 10
  } else {
    -1
  }
}

fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut needs = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 0x41 && c <= 0x5A {
      needs = true
      break
    }
    i = i + 1
  }
  if !needs {
    return s
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 0x41 && c <= 0x5A {
      sb.write_byte((c + 32).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn ascii_trim(s : String) -> String {
  let n = s.length()
  let mut a = 0
  while a < n && is_svg_ws(s.code_unit_at(a)) {
    a = a + 1
  }
  let mut b = n
  while b > a && is_svg_ws(s.code_unit_at(b - 1)) {
    b = b - 1
  }
  if a == 0 && b == n {
    s
  } else {
    s.slice(a, b)
  }
}

fn pow10_f64(exp : Int) -> Double {
  if exp == 0 {
    return 1.0
  }
  let mut e = exp
  let mut neg = false
  if e < 0 {
    neg = true
    e = -e
  }
  if e > 308 {
    return if neg { 0.0 } else { 1.0e308 }
  }
  let mut base = 10.0
  let mut res = 1.0
  while e > 0 {
    if (e & 1) == 1 {
      res = res * base
    }
    base = base * base
    e = e >> 1
  }
  if neg {
    1.0 / res
  } else {
    res
  }
}

///| Fast zero-allocation SVG number scanner starting at `pos`.
///| Stops before a second `.` or a subsequent sign so `1.2.3-4e-2` scans cleanly.
fn scan_svg_number(s : String, pos : Int, end : Int) -> Option[(Double, Int)] {
  if pos >= end {
    return None
  }
  let mut i = pos
  let mut neg = false
  let c0 = s.code_unit_at(i)
  if c0 == 0x2D {
    neg = true
    i = i + 1
  } else if c0 == 0x2B {
    i = i + 1
  }
  let mut mantissa = 0.0
  let mut int_digits = 0
  while i < end {
    let c = s.code_unit_at(i)
    if c >= 0x30 && c <= 0x39 {
      mantissa = mantissa * 10.0 + (c - 0x30).to_double()
      int_digits = int_digits + 1
      i = i + 1
    } else {
      break
    }
  }
  let mut frac_digits = 0
  if i < end && s.code_unit_at(i) == 0x2E {
    i = i + 1
    while i < end {
      let c = s.code_unit_at(i)
      if c >= 0x30 && c <= 0x39 {
        if frac_digits < 18 {
          mantissa = mantissa * 10.0 + (c - 0x30).to_double()
          frac_digits = frac_digits + 1
        }
        i = i + 1
      } else {
        break
      }
    }
  }
  if int_digits == 0 && frac_digits == 0 {
    return None
  }
  let mut exp = -frac_digits
  if i < end {
    let ce = s.code_unit_at(i)
    if ce == 0x65 || ce == 0x45 {
      let save = i
      i = i + 1
      let mut exp_neg = false
      if i < end {
        let cs = s.code_unit_at(i)
        if cs == 0x2D {
          exp_neg = true
          i = i + 1
        } else if cs == 0x2B {
          i = i + 1
        }
      }
      let mut exp_val = 0
      let mut exp_digits = 0
      while i < end {
        let cd = s.code_unit_at(i)
        if cd >= 0x30 && cd <= 0x39 {
          if exp_val < 10000 {
            exp_val = exp_val * 10 + (cd - 0x30)
          }
          exp_digits = exp_digits + 1
          i = i + 1
        } else {
          break
        }
      }
      if exp_digits == 0 {
        i = save
      } else {
        if exp_neg {
          exp = exp - exp_val
        } else {
          exp = exp + exp_val
        }
      }
    }
  }
  let mut res = if exp == 0 {
    mantissa
  } else if exp > 0 {
    mantissa * pow10_f64(exp)
  } else {
    mantissa / pow10_f64(-exp)
  }
  if neg {
    res = -res
  }
  if !is_finite(res) {
    return None
  }
  Some((res, i))
}

fn skip_ws(s : String, pos : Int, end : Int) -> Int {
  let mut i = pos
  while i < end && is_svg_ws(s.code_unit_at(i)) {
    i = i + 1
  }
  i
}

fn skip_comma_wsp(s : String, pos : Int, end : Int) -> Int {
  let mut i = skip_ws(s, pos, end)
  if i < end && s.code_unit_at(i) == 0x2C {
    i = i + 1
    i = skip_ws(s, i, end)
  }
  i
}

///| Format a Double compactly with `precision` decimal digits (0..8).
///| Strips trailing zeros, converts -0 to 0, omits leading 0 (`0.5` -> `.5`, `-0.5` -> `-.5`).
fn format_compact_number(v : Double, precision : Int) -> String {
  if !is_finite(v) {
    return "0"
  }
  let p = if precision < 0 {
    0
  } else if precision > 8 {
    8
  } else {
    precision
  }
  let scale = pow10_f64(p)
  let scaled = if v >= 0.0 {
    (v * scale + 0.5).floor()
  } else {
    -((-v * scale + 0.5).floor())
  }
  if scaled == 0.0 {
    return "0"
  }
  let neg = scaled < 0.0
  let abs_scaled = if neg { -scaled } else { scaled }
  let scale_i = pow10_f64(p).to_int()
  // Fast integer path when fits safely in 53-bit / 32-bit int
  if abs_scaled < 2000000000.0 {
    let n = abs_scaled.to_int()
    if p == 0 {
      if neg {
        return "-" + n.to_string()
      } else {
        return n.to_string()
      }
    }
    let ipart = n / scale_i
    let mut fpart = n % scale_i
    if fpart == 0 {
      if neg {
        return "-" + ipart.to_string()
      } else {
        return ipart.to_string()
      }
    }
    let mut digits = p
    while digits > 0 && fpart % 10 == 0 {
      fpart = fpart / 10
      digits = digits - 1
    }
    let fstr = fpart.to_string()
    let sb = StringBuilder::new()
    if neg {
      sb.write_byte((0x2D).to_byte())
    }
    if ipart > 0 {
      sb.write_string(ipart.to_string())
    }
    sb.write_byte((0x2E).to_byte())
    let mut pad = digits - fstr.length()
    while pad > 0 {
      sb.write_byte((0x30).to_byte())
      pad = pad - 1
    }
    sb.write_string(fstr)
    return sb.to_string()
  }
  // Fallback for very large numbers
  let rounded = (if neg { -abs_scaled } else { abs_scaled }) / scale
  rounded.to_string()
}
