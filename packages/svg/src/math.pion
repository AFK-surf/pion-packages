///| Pure-Pion deterministic IEEE-754 math, exact SVG number scanning, and compact number formatting.

let pi_val : Double = 3.14159265358979323846

let tau_val : Double = 6.28318530717958647692

let half_pi_val : Double = 1.57079632679489661923

let inv_half_pi : Double = 0.63661977236758134308

// 3-term Cody-Waite constants for pi/2 (fdlibm e_rem_pio2.c)
let pio2_1 : Double = 1.57079632673412561417e+00

let pio2_1t : Double = 6.07710050650619224932e-11

let pio2_2 : Double = 6.07710050630396597660e-11

let pio2_2t : Double = 2.02226624879595063154e-21

let pio2_3 : Double = 2.02226624873128033827e-21

let pio2_3t : Double = 8.47842766036889956997e-32

let sqrt3_val : Double = 1.73205080756887729353

let pi_6_val : Double = 0.52359877559829887308

let tan_pi_12 : Double = 0.26794919243112270647

// 66 x 24-bit words of 2/pi for Payne-Hanek range reduction (fdlibm)
let two_over_pi : Array[Int] = [
  10680707, 7228996, 1387004, 2578385, 16069853, 12639074, 9804092, 4427841,
  16666979, 11263675, 12935607, 2387514, 4345298, 14681673, 3074569, 13734428,
  16653803, 1880361, 10960616, 8533493, 3062596, 8710556, 7349940, 6258241,
  3772886, 3769171, 3798172, 8675211, 12450088, 3874808, 9961438, 366607,
  15675153, 9132554, 7151469, 3571407, 2607881, 12013382, 4155038, 6285869,
  7677882, 13102053, 15825725, 473591, 9065106, 15363067, 6271263, 9264392,
  5636912, 4652155, 7056368, 13614112, 10155062, 1944035, 9527646, 15080200,
  6658437, 6231200, 6832269, 16767104, 5075751, 3212806, 1398474, 7579849,
  6349435, 12618859,
]

// Exact powers of 10 in IEEE-754 Double (10^0 .. 10^22)
let pow10_exact_tbl : Array[Double] = [
  1.0, 1.0e1, 1.0e2, 1.0e3, 1.0e4, 1.0e5, 1.0e6, 1.0e7, 1.0e8, 1.0e9, 1.0e10,
  1.0e11, 1.0e12, 1.0e13, 1.0e14, 1.0e15, 1.0e16, 1.0e17, 1.0e18, 1.0e19,
  1.0e20, 1.0e21, 1.0e22,
]

// Exact integer powers of 10 (10^0 .. 10^8)
let pow10_i64_tbl : Array[Int64] = [
  1L, 10L, 100L, 1000L, 10000L, 100000L, 1000000L, 10000000L, 100000000L,
]

fn is_nan(x : Double) -> Bool {
  x != x
}

fn is_finite(x : Double) -> Bool {
  x == x && x - x == 0.0
}

fn deg_to_rad(deg : Double) -> Double {
  deg * (pi_val / 180.0)
}

fn hypot_f64(x : Double, y : Double) -> Double {
  let ax = x.abs()
  let ay = y.abs()
  let hi = if ax > ay { ax } else { ay }
  let lo = if ax > ay { ay } else { ax }
  if hi == 0.0 {
    return 0.0
  }
  if !is_finite(hi) {
    return hi
  }
  let r = lo / hi
  hi * (1.0 + r * r).sqrt()
}

fn pow2_f64(exp : Int) -> Double {
  if exp < -1022 {
    return 0.0
  }
  if exp > 1023 {
    return 1.0e308 * 10.0
  }
  Double::from_bits((exp + 1023).to_int64() << 52)
}

fn poly_sin(r : Double) -> Double {
  let r2 = r * r
  let mut acc = -1.0 / 1307674368000.0
  acc = acc * r2 + 1.0 / 6227020800.0
  acc = acc * r2 - 1.0 / 39916800.0
  acc = acc * r2 + 1.0 / 362880.0
  acc = acc * r2 - 1.0 / 5040.0
  acc = acc * r2 + 1.0 / 120.0
  acc = acc * r2 - 1.0 / 6.0
  r + r * r2 * acc
}

fn poly_cos(r : Double) -> Double {
  let r2 = r * r
  let mut acc = -1.0 / 87178291200.0
  acc = acc * r2 + 1.0 / 479001600.0
  acc = acc * r2 - 1.0 / 3628800.0
  acc = acc * r2 + 1.0 / 40320.0
  acc = acc * r2 - 1.0 / 720.0
  acc = acc * r2 + 1.0 / 24.0
  acc = acc * r2 - 0.5
  1.0 + r2 * acc
}

fn payne_hanek_reduce(x : Double) -> (Double, Int) {
  let neg = x < 0.0
  let ax = if neg { -x } else { x }
  let bits = ax.to_bits()
  let biased = (bits >> 52).to_int()
  let mant = (bits & 4503599627370495L) | 4503599627370496L
  let e = biased - 1075
  let mut k0 = (e - 2) / 24 - 1
  if e < 26 {
    k0 = 0
  }
  if k0 < 0 {
    k0 = 0
  }
  let m0 = mant & 16777215L
  let m1 = (mant >> 24) & 16777215L
  let m2 = mant >> 48
  let acc : Array[Int64] = [0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L]
  let mut j = 0
  while j < 9 {
    let w = two_over_pi[k0 + j].to_int64()
    acc[j] = acc[j] + m2 * w
    acc[j + 1] = acc[j + 1] + m1 * w
    acc[j + 2] = acc[j + 2] + m0 * w
    j = j + 1
  }
  let mut idx = 10
  while idx > 0 {
    acc[idx - 1] = acc[idx - 1] + (acc[idx] >> 24)
    acc[idx] = acc[idx] & 16777215L
    idx = idx - 1
  }
  let top_shift = e + 48 - 24 * (k0 + 1)
  let mut q = 0
  let mut f_hi = 0.0
  let mut f_lo = 0.0
  idx = 0
  while idx < 11 {
    let bp = top_shift - 24 * idx
    let mut v = acc[idx]
    if bp < 2 {
      if bp == 1 {
        q = (q + ((v & 1L) << 1).to_int()) & 3
      } else if bp == 0 {
        q = (q + (v & 3L).to_int()) & 3
      } else {
        if bp + 24 > 0 {
          q = (q + ((v >> (-bp)) & 3L).to_int()) & 3
          v = v & ((1L << (-bp)) - 1L)
        }
        if v != 0L {
          let term = v.to_double() * pow2_f64(bp)
          let s = f_hi + term
          let bb = s - f_hi
          let err = (f_hi - (s - bb)) + (term - bb)
          f_hi = s
          f_lo = f_lo + err
        }
      }
    }
    idx = idx + 1
  }
  if f_hi + f_lo >= 0.5 {
    q = (q + 1) & 3
    let s = f_hi - 1.0
    let bb = s - f_hi
    let err = (f_hi - (s - bb)) + (-1.0 - bb)
    f_hi = s
    f_lo = f_lo + err
  }
  let mut r = f_hi * pio2_1 + (f_lo * pio2_1 + f_hi * pio2_1t)
  if neg {
    r = -r
    q = (4 - q) & 3
  }
  (r, q)
}

///| Stack-friendly sin/cos pair returned by value (zero heap allocation).
val struct SinCos {
  s : Double
  c : Double
}

fn sin_cos_val(x : Double) -> SinCos {
  let ax = x.abs()
  if ax <= 0.7853981633974483 {
    return SinCos::{ s: poly_sin(x), c: poly_cos(x) }
  }
  if !is_finite(x) {
    return SinCos::{ s: 0.0, c: 1.0 }
  }
  let mut r = 0.0
  let mut q = 0
  if ax >= 32768.0 {
    let (pr, pq) = payne_hanek_reduce(x)
    r = pr
    q = pq
  } else {
    let kf = (x * inv_half_pi + (if x >= 0.0 { 0.5 } else { -0.5 })).to_int()
    let k = kf.to_double()
    let t1 = x - k * pio2_1
    let t2 = t1 - k * pio2_2
    r = t2 - k * pio2_3 - k * pio2_3t
    q = kf % 4
    if q < 0 {
      q = q + 4
    }
  }
  let s = poly_sin(r)
  let c = poly_cos(r)
  if q == 0 {
    SinCos::{ s: s, c: c }
  } else if q == 1 {
    SinCos::{ s: c, c: -s }
  } else if q == 2 {
    SinCos::{ s: -s, c: -c }
  } else {
    SinCos::{ s: -c, c: s }
  }
}

fn sin_f64(x : Double) -> Double {
  if !is_finite(x) {
    return 0.0
  }
  let ax = x.abs()
  let mut r = 0.0
  let mut q = 0
  if ax >= 32768.0 {
    let (pr, pq) = payne_hanek_reduce(x)
    r = pr
    q = pq
  } else {
    let kf = (x * inv_half_pi + (if x >= 0.0 { 0.5 } else { -0.5 })).to_int()
    let k = kf.to_double()
    let t1 = x - k * pio2_1
    let t2 = t1 - k * pio2_2
    r = t2 - k * pio2_3 - k * pio2_3t
    q = kf % 4
    if q < 0 {
      q = q + 4
    }
  }
  if q == 0 {
    poly_sin(r)
  } else if q == 1 {
    poly_cos(r)
  } else if q == 2 {
    -poly_sin(r)
  } else {
    -poly_cos(r)
  }
}

fn cos_f64(x : Double) -> Double {
  if !is_finite(x) {
    return 1.0
  }
  let ax = x.abs()
  let mut r = 0.0
  let mut q = 0
  if ax >= 32768.0 {
    let (pr, pq) = payne_hanek_reduce(x)
    r = pr
    q = pq
  } else {
    let kf = (x * inv_half_pi + (if x >= 0.0 { 0.5 } else { -0.5 })).to_int()
    let k = kf.to_double()
    let t1 = x - k * pio2_1
    let t2 = t1 - k * pio2_2
    r = t2 - k * pio2_3 - k * pio2_3t
    q = kf % 4
    if q < 0 {
      q = q + 4
    }
  }
  if q == 0 {
    poly_cos(r)
  } else if q == 1 {
    -poly_sin(r)
  } else if q == 2 {
    -poly_cos(r)
  } else {
    poly_sin(r)
  }
}

fn tan_f64(x : Double) -> Double {
  let sc = sin_cos_val(x)
  if sc.c.abs() < 1e-15 {
    if sc.s >= 0.0 {
      1e15
    } else {
      -1e15
    }
  } else {
    sc.s / sc.c
  }
}

fn atan_f64(x : Double) -> Double {
  if !is_finite(x) {
    return 0.0
  }
  let mut neg = false
  let mut v = x
  if v < 0.0 {
    neg = true
    v = -v
  }
  let mut invert = false
  if v > 1.0 {
    invert = true
    v = 1.0 / v
  }
  let mut shift = false
  if v > tan_pi_12 {
    shift = true
    v = (sqrt3_val * v - 1.0) / (sqrt3_val + v)
  }
  let v2 = v * v
  let mut acc = -1.0 / 19.0
  acc = acc * v2 + 1.0 / 17.0
  acc = acc * v2 - 1.0 / 15.0
  acc = acc * v2 + 1.0 / 13.0
  acc = acc * v2 - 1.0 / 11.0
  acc = acc * v2 + 1.0 / 9.0
  acc = acc * v2 - 1.0 / 7.0
  acc = acc * v2 + 1.0 / 5.0
  acc = acc * v2 - 1.0 / 3.0
  let mut res = v + v * v2 * acc
  if shift {
    res = pi_6_val + res
  }
  if invert {
    res = half_pi_val - res
  }
  if neg {
    -res
  } else {
    res
  }
}

fn atan2_f64(y : Double, x : Double) -> Double {
  if x > 0.0 {
    atan_f64(y / x)
  } else if x < 0.0 {
    if y >= 0.0 {
      atan_f64(y / x) + pi_val
    } else {
      atan_f64(y / x) - pi_val
    }
  } else if y > 0.0 {
    half_pi_val
  } else if y < 0.0 {
    -half_pi_val
  } else {
    0.0
  }
}

fn acos_f64(x : Double) -> Double {
  let clamped = if x < -1.0 {
    -1.0
  } else if x > 1.0 {
    1.0
  } else {
    x
  }
  atan2_f64((1.0 - clamped * clamped).sqrt(), clamped)
}

#verify
pub fn is_svg_ws(c : Int) -> Bool {
  c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D || c == 0x0C
}

#verify
pub fn is_xml_ws(c : Int) -> Bool {
  c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D
}

#verify
pub fn is_ascii_digit(c : Int) -> Bool {
  c >= 0x30 && c <= 0x39
}

#verify
pub fn hex_val(c : Int) -> Int {
  if c >= 0x30 && c <= 0x39 {
    c - 0x30
  } else if c >= 0x41 && c <= 0x46 {
    c - 0x41 + 10
  } else if c >= 0x61 && c <= 0x66 {
    c - 0x61 + 10
  } else {
    -1
  }
}

fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut needs = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 0x41 && c <= 0x5A {
      needs = true
      break
    }
    i = i + 1
  }
  if !needs {
    return s
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 0x41 && c <= 0x5A {
      sb.write_byte((c + 32).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn ascii_trim(s : String) -> String {
  let n = s.length()
  let mut a = 0
  while a < n && is_svg_ws(s.code_unit_at(a)) {
    a = a + 1
  }
  let mut b = n
  while b > a && is_svg_ws(s.code_unit_at(b - 1)) {
    b = b - 1
  }
  if a == 0 && b == n {
    s
  } else {
    s.slice(a, b)
  }
}

// ============================================================
// Exact IEEE-754 decimal-to-binary BigInt (base 2^30)
// ============================================================

let bi_base : Int64 = 1073741824L // 2^30

let bi_mask : Int64 = 1073741823L // 2^30 - 1

fn bi_trim(a : Array[Int64]) -> Unit {
  while a.length() > 0 && a[a.length() - 1] == 0L {
    let _ = a.pop()
  }
}

fn bi_mul_add(a : Array[Int64], mul : Int64, add : Int64) -> Unit {
  let mut carry = add
  let mut i = 0
  while i < a.length() {
    let v = a[i] * mul + carry
    a[i] = v & bi_mask
    carry = v >> 30
    i = i + 1
  }
  while carry > 0L {
    a.push(carry & bi_mask)
    carry = carry >> 30
  }
}

fn bi_mul_pow5(a : Array[Int64], exp5 : Int) -> Unit {
  let mut e = exp5
  // 5^13 = 1220703125 fits easily with 2^30 limb in signed Int64 (1.22e9 * 1.07e9 = 1.31e18 < 9.22e18)
  while e >= 13 {
    bi_mul_add(a, 1220703125L, 0L)
    e = e - 13
  }
  if e > 0 {
    let mut p = 1L
    let mut k = 0
    while k < e {
      p = p * 5L
      k = k + 1
    }
    bi_mul_add(a, p, 0L)
  }
}

fn bi_shl(a : Array[Int64], shift : Int) -> Unit {
  if shift <= 0 || a.length() == 0 {
    return
  }
  let word_shift = shift / 30
  let bit_shift = shift % 30
  if bit_shift > 0 {
    let mut carry = 0L
    let mut i = 0
    while i < a.length() {
      let v = (a[i] << bit_shift) | carry
      a[i] = v & bi_mask
      carry = v >> 30
      i = i + 1
    }
    if carry > 0L {
      a.push(carry)
    }
  }
  if word_shift > 0 {
    let old_len = a.length()
    let mut k = 0
    while k < word_shift {
      a.push(0L)
      k = k + 1
    }
    let mut i = old_len - 1
    while i >= 0 {
      a[i + word_shift] = a[i]
      i = i - 1
    }
    k = 0
    while k < word_shift {
      a[k] = 0L
      k = k + 1
    }
  }
}

fn bi_bit_len(a : Array[Int64]) -> Int {
  let n = a.length()
  if n == 0 {
    return 0
  }
  let mut top = a[n - 1]
  let mut bits = (n - 1) * 30
  while top > 0L {
    bits = bits + 1
    top = top >> 1
  }
  bits
}

fn bi_cmp(a : Array[Int64], b : Array[Int64]) -> Int {
  if a.length() != b.length() {
    return if a.length() < b.length() { -1 } else { 1 }
  }
  let mut i = a.length() - 1
  while i >= 0 {
    if a[i] != b[i] {
      return if a[i] < b[i] { -1 } else { 1 }
    }
    i = i - 1
  }
  0
}

///| Compare `a` against `b << shift` without allocating.
fn bi_cmp_shl(a : Array[Int64], b : Array[Int64], shift : Int) -> Int {
  let alen = bi_bit_len(a)
  let blen = if b.length() == 0 { 0 } else { bi_bit_len(b) + shift }
  if alen != blen {
    return if alen < blen { -1 } else { 1 }
  }
  if alen == 0 {
    return 0
  }
  let ws = shift / 30
  let bs = shift % 30
  let mut i = a.length() - 1
  while i >= 0 {
    let av = a[i]
    let bi_idx = i - ws
    let mut bv = 0L
    if bi_idx >= 0 && bi_idx < b.length() {
      bv = (b[bi_idx] << bs) & bi_mask
    }
    if bs > 0 && bi_idx - 1 >= 0 && bi_idx - 1 < b.length() {
      bv = bv | (b[bi_idx - 1] >> (30 - bs))
    }
    if av != bv {
      return if av < bv { -1 } else { 1 }
    }
    i = i - 1
  }
  0
}

///| Subtract `b * q` from `a` in place (requires `a >= b * q`, `0 <= q < 2^30`).
fn bi_sub_mul_small(a : Array[Int64], b : Array[Int64], q : Int64) -> Unit {
  if q == 0L {
    return
  }
  let mut borrow = 0L
  let mut i = 0
  let bn = b.length()
  while i < a.length() {
    let bv = if i < bn { b[i] * q } else { 0L }
    let sub = bv + borrow
    let lo = sub & bi_mask
    borrow = sub >> 30
    let diff = a[i] - lo
    if diff < 0L {
      a[i] = diff + bi_base
      borrow = borrow + 1L
    } else {
      a[i] = diff
    }
    i = i + 1
  }
  bi_trim(a)
}

///| Approximate a positive BigInt as a Double (for quotient estimation).
fn bi_to_double(a : Array[Int64]) -> Double {
  let n = a.length()
  if n == 0 {
    return 0.0
  }
  let mut hi = a[n - 1].to_double()
  let mut k = n - 2
  let mut lim = if n >= 3 { n - 3 } else { 0 }
  while k >= lim {
    hi = hi * 1073741824.0 + a[k].to_double()
    k = k - 1
  }
  let shift_bits = (k + 1) * 30
  if shift_bits > 0 {
    // Multiply by 2^shift_bits in chunks <= 512 to avoid overflow during intermediate step
    let mut rem = shift_bits
    while rem > 512 {
      hi = hi * pow2_f64(512)
      rem = rem - 512
    }
    hi = hi * pow2_f64(rem)
  }
  hi
}

///| Compute `q = floor(num / den)` and leave remainder in `num` (assumes `0 <= num / den < 2^53`).
fn bi_divmod_u53(num : Array[Int64], den : Array[Int64]) -> Int64 {
  let mut q = 0L
  let den_len = bi_bit_len(den)
  // Fast estimation loop (2-3 iterations)
  let mut iter = 0
  while iter < 6 && bi_cmp(num, den) >= 0 {
    let num_len = bi_bit_len(num)
    let diff_bits = num_len - den_len
    if diff_bits <= 1 {
      break
    }
    // Extract top ~50 bits of num and den at aligned scale
    let shift = if diff_bits > 28 { diff_bits - 28 } else { 0 }
    // Estimate dq via double ratio of top limbs
    let mut top_n = bi_to_double(num)
    let mut top_d = bi_to_double(den)
    if !is_finite(top_n) || !is_finite(top_d) || top_d == 0.0 {
      break
    }
    let est_f = (top_n / top_d).floor()
    if !is_finite(est_f) || est_f < 1.0 {
      break
    }
    let mut est = est_f.to_int64()
    if est > 1L {
      est = est - 1L
    }
    if est >= bi_base {
      // Split est into high/low 30-bit chunks to avoid Int64 overflow in bi_sub_mul_small
      let q_hi = est >> 30
      let q_lo = est & bi_mask
      // Subtract q_hi * (den << 30)
      if q_hi > 0L {
        let den_sh : Array[Int64] = [0L]
        let mut k = 0
        while k < den.length() {
          den_sh.push(den[k])
          k = k + 1
        }
        bi_sub_mul_small(num, den_sh, q_hi)
        q = q + (q_hi << 30)
      }
      if q_lo > 0L && bi_cmp(num, den) >= 0 {
        // Re-check if num >= den * q_lo safely via next iteration
        let _ = shift
      }
    } else if est > 0L {
      bi_sub_mul_small(num, den, est)
      q = q + est
    }
    iter = iter + 1
  }
  // Exact binary long-division finish for any remaining bits
  let mut bit = bi_bit_len(num) - den_len
  if bit > 53 {
    bit = 53
  }
  while bit >= 0 {
    if bi_cmp_shl(num, den, bit) >= 0 {
      // Subtract den << bit
      let ws = bit / 30
      let bs = bit % 30
      let mut borrow = 0L
      let mut i = ws
      while i < num.length() {
        let bi_idx = i - ws
        let mut bv = 0L
        if bi_idx >= 0 && bi_idx < den.length() {
          bv = (den[bi_idx] << bs) & bi_mask
        }
        if bs > 0 && bi_idx - 1 >= 0 && bi_idx - 1 < den.length() {
          bv = bv | (den[bi_idx - 1] >> (30 - bs))
        }
        let sub = bv + borrow
        let diff = num[i] - sub
        if diff < 0L {
          num[i] = diff + bi_base
          borrow = 1L
        } else {
          num[i] = diff
          borrow = 0L
        }
        i = i + 1
      }
      bi_trim(num)
      q = q + (1L << bit)
    }
    bit = bit - 1
  }
  q
}

///| Exact IEEE-754 decimal-to-Double conversion for arbitrary decimal strings.
fn parse_decimal_exact(
  s : String,
  int_start : Int,
  int_end : Int,
  frac_start : Int,
  frac_end : Int,
  raw_exp : Int,
  neg : Bool,
) -> Option[Double] {
  // Build exact BigInt D from up to 768 significant digits + sticky digit if truncated
  let d : Array[Int64] = []
  let mut sig = 0
  let mut started = false
  let mut dec_exp = raw_exp
  let mut sticky = false
  let mut chunk = 0L
  let mut chunk_mul = 1L
  // Scan integer digits
  let mut i = int_start
  while i < int_end {
    let dig = s.code_unit_at(i) - 0x30
    if !started {
      if dig != 0 {
        started = true
      }
    }
    if started {
      if sig < 768 {
        chunk = chunk * 10L + dig.to_int64()
        chunk_mul = chunk_mul * 10L
        sig = sig + 1
        if chunk_mul == 1000000000L {
          bi_mul_add(d, chunk_mul, chunk)
          chunk = 0L
          chunk_mul = 1L
        }
      } else {
        dec_exp = dec_exp + 1
        if dig != 0 {
          sticky = true
        }
      }
    }
    i = i + 1
  }
  // Scan fractional digits
  i = frac_start
  while i < frac_end {
    let dig = s.code_unit_at(i) - 0x30
    if !started {
      if dig != 0 {
        started = true
      } else {
        dec_exp = dec_exp - 1
      }
    }
    if started {
      if sig < 768 {
        chunk = chunk * 10L + dig.to_int64()
        chunk_mul = chunk_mul * 10L
        sig = sig + 1
        dec_exp = dec_exp - 1
        if chunk_mul == 1000000000L {
          bi_mul_add(d, chunk_mul, chunk)
          chunk = 0L
          chunk_mul = 1L
        }
      } else if dig != 0 {
        sticky = true
      }
    }
    i = i + 1
  }
  if sticky {
    chunk = chunk * 10L + 1L
    chunk_mul = chunk_mul * 10L
    dec_exp = dec_exp - 1
  }
  if chunk_mul > 1L {
    bi_mul_add(d, chunk_mul, chunk)
  }
  bi_trim(d)
  if d.length() == 0 {
    return Some(if neg { -0.0 } else { 0.0 })
  }
  // Quick range check using scientific exponent
  let sci_exp = dec_exp + sig - 1
  if sci_exp > 309 {
    return None
  }
  if sci_exp < -326 {
    return Some(if neg { -0.0 } else { 0.0 })
  }
  // Represent D * 10^dec_exp = (num / den) * 2^shift2
  let num = d
  let den : Array[Int64] = [1L]
  let shift2 = dec_exp
  if dec_exp > 0 {
    bi_mul_pow5(num, dec_exp)
  } else if dec_exp < 0 {
    bi_mul_pow5(den, -dec_exp)
  }
  // Estimate binary exponent exp2 so that 2^52 <= num/den * 2^(shift2 - exp2) < 2^53
  let mut exp2 = bi_bit_len(num) - bi_bit_len(den) + shift2 - 53
  if exp2 < -1074 {
    exp2 = -1074
  }
  let net_shift = shift2 - exp2
  if net_shift > 0 {
    bi_shl(num, net_shift)
  } else if net_shift < 0 {
    bi_shl(den, -net_shift)
  }
  // Normalize so num/den is in [2^52, 2^53) for normal numbers (or < 2^52 for subnormals at exp2 == -1074)
  while exp2 > -1074 && bi_cmp_shl(num, den, 52) < 0 {
    exp2 = exp2 - 1
    bi_shl(num, 1)
  }
  while bi_cmp_shl(num, den, 53) >= 0 {
    exp2 = exp2 + 1
    bi_shl(den, 1)
  }
  let mut q = bi_divmod_u53(num, den)
  // Round to nearest even: compare 2 * rem (= num << 1) with den
  bi_shl(num, 1)
  let cmp_half = bi_cmp(num, den)
  if cmp_half > 0 || (cmp_half == 0 && (q & 1L) == 1L) {
    q = q + 1L
    if q == 9007199254740992L {
      // 2^53
      q = q >> 1
      exp2 = exp2 + 1
    }
  }
  if exp2 > 971 {
    // Overflow to infinity -> invalid SVG number
    return None
  }
  let sign_bits = if neg { (-0.0).to_bits() } else { 0L }
  if exp2 == -1074 && q < 4503599627370496L {
    // Subnormal or zero
    return Some(Double::from_bits(sign_bits | q))
  }
  let biased_exp = (exp2 + 1075).to_int64()
  let frac = q & 4503599627370495L
  Some(Double::from_bits(sign_bits | (biased_exp << 52) | frac))
}

///| Reusable mutable cursor for zero-allocation SVG number and flag scanning.
struct NumCursor {
  mut pos : Int
  mut ok : Bool
}

///| Fast, correctly-rounded (0-ULP vs IEEE-754 / Rust `f64::from_str`) SVG number scanner
///| using a mutable `NumCursor` to avoid `Option[(Double, Int)]` heap boxing on hot loops.
fn scan_svg_number_into(s : String, end : Int, cur : NumCursor) -> Double {
  let mut i = cur.pos
  if i >= end {
    cur.ok = false
    return 0.0
  }
  let mut neg = false
  let c0 = s.code_unit_at(i)
  if c0 == 0x2D {
    neg = true
    i = i + 1
  } else if c0 == 0x2B {
    i = i + 1
  }
  let int_start = i
  let mut mant = 0L
  let mut sig = 0
  let mut has_digits = false
  let mut truncated = false
  let mut dec_exp = 0
  // Skip leading zeros in integer part
  while i < end && s.code_unit_at(i) == 0x30 {
    has_digits = true
    i = i + 1
  }
  // Fast integer digits loop (up to 18 significant digits without per-digit sig>0 check)
  while i < end {
    let d = s.code_unit_at(i) - 0x30
    if d >= 0 && d <= 9 {
      has_digits = true
      if sig < 18 {
        mant = mant * 10L + d.to_int64()
        sig = sig + 1
      } else {
        dec_exp = dec_exp + 1
        if d != 0 {
          truncated = true
        }
      }
      i = i + 1
    } else {
      break
    }
  }
  let int_end = i
  let mut frac_start = i
  let mut frac_end = i
  if i < end && s.code_unit_at(i) == 0x2E {
    i = i + 1
    frac_start = i
    if sig == 0 {
      while i < end && s.code_unit_at(i) == 0x30 {
        has_digits = true
        dec_exp = dec_exp - 1
        i = i + 1
      }
    }
    while i < end {
      let d = s.code_unit_at(i) - 0x30
      if d >= 0 && d <= 9 {
        has_digits = true
        if sig < 18 {
          mant = mant * 10L + d.to_int64()
          sig = sig + 1
          dec_exp = dec_exp - 1
        } else if d != 0 {
          truncated = true
        }
        i = i + 1
      } else {
        break
      }
    }
    frac_end = i
  }
  if !has_digits {
    cur.ok = false
    return 0.0
  }
  let mut raw_exp = 0
  if i < end {
    let ce = s.code_unit_at(i)
    if ce == 0x65 || ce == 0x45 {
      let save = i
      i = i + 1
      let mut exp_neg = false
      if i < end {
        let cs = s.code_unit_at(i)
        if cs == 0x2D {
          exp_neg = true
          i = i + 1
        } else if cs == 0x2B {
          i = i + 1
        }
      }
      let mut exp_val = 0
      let mut exp_digits = 0
      while i < end {
        let cd = s.code_unit_at(i) - 0x30
        if cd >= 0 && cd <= 9 {
          if exp_val < 100000 {
            exp_val = exp_val * 10 + cd
          }
          exp_digits = exp_digits + 1
          i = i + 1
        } else {
          break
        }
      }
      if exp_digits == 0 {
        i = save
      } else {
        raw_exp = if exp_neg { -exp_val } else { exp_val }
      }
    }
  }
  if mant == 0L {
    cur.pos = i
    cur.ok = true
    return if neg { -0.0 } else { 0.0 }
  }
  let eff_exp = dec_exp + raw_exp
  // Clinger exact fast path: mant < 2^53 (exact Double) and |eff_exp| <= 22 (exact 10^|e|)
  if !truncated && mant <= 9007199254740991L {
    if eff_exp == 0 {
      let res = mant.to_double()
      cur.pos = i
      cur.ok = true
      return if neg { -res } else { res }
    }
    if eff_exp == -1 {
      let res = mant.to_double() / 10.0
      cur.pos = i
      cur.ok = true
      return if neg { -res } else { res }
    }
    if eff_exp == -2 {
      let res = mant.to_double() / 100.0
      cur.pos = i
      cur.ok = true
      return if neg { -res } else { res }
    }
    if eff_exp == -3 {
      let res = mant.to_double() / 1000.0
      cur.pos = i
      cur.ok = true
      return if neg { -res } else { res }
    }
    if eff_exp >= -22 && eff_exp <= 22 {
      let mut res = mant.to_double()
      if eff_exp > 0 {
        res = res * pow10_exact_tbl[eff_exp]
      } else {
        res = res / pow10_exact_tbl[-eff_exp]
      }
      cur.pos = i
      cur.ok = true
      return if neg { -res } else { res }
    }
    if eff_exp > 22 && eff_exp <= 37 {
      let extra = eff_exp - 22
      if sig + extra <= 15 {
        let mut res = mant.to_double() * pow10_exact_tbl[extra]
        res = res * pow10_exact_tbl[22]
        cur.pos = i
        cur.ok = true
        return if neg { -res } else { res }
      }
    }
  }
  match parse_decimal_exact(s, int_start, int_end, frac_start, frac_end, raw_exp, neg) {
    Some(v) => {
      cur.pos = i
      cur.ok = true
      v
    }
    None => {
      cur.ok = false
      0.0
    }
  }
}

///| Skip optional SVG whitespace and at most one comma, then scan an SVG number into `cur`.
fn scan_comma_svg_number_into(s : String, end : Int, cur : NumCursor) -> Double {
  let mut i = cur.pos
  while i < end {
    let c = s.code_unit_at(i)
    if c == 0x20 || (c <= 0x0D && (c == 0x0A || c == 0x09 || c == 0x0D || c == 0x0C)) {
      i = i + 1
    } else {
      break
    }
  }
  if i < end && s.code_unit_at(i) == 0x2C {
    i = i + 1
    while i < end {
      let c = s.code_unit_at(i)
      if c == 0x20 || (c <= 0x0D && (c == 0x0A || c == 0x09 || c == 0x0D || c == 0x0C)) {
        i = i + 1
      } else {
        break
      }
    }
  }
  cur.pos = i
  scan_svg_number_into(s, end, cur)
}

///| Fast, correctly-rounded (0-ULP vs IEEE-754 / Rust `f64::from_str`) SVG number scanner.
///| Stops before a second `.` or a subsequent sign so `1.2.3-4e-2` scans cleanly.
fn scan_svg_number(s : String, pos : Int, end : Int) -> Option[(Double, Int)] {
  let cur = NumCursor::{ pos: pos, ok: false }
  let v = scan_svg_number_into(s, end, cur)
  if cur.ok {
    Some((v, cur.pos))
  } else {
    None
  }
}

fn skip_ws(s : String, pos : Int, end : Int) -> Int {
  let mut i = pos
  while i < end {
    let c = s.code_unit_at(i)
    if c == 0x20 || (c <= 0x0D && (c == 0x0A || c == 0x09 || c == 0x0D || c == 0x0C)) {
      i = i + 1
    } else {
      break
    }
  }
  i
}

fn skip_xml_ws(s : String, pos : Int, end : Int) -> Int {
  let mut i = pos
  while i < end {
    let c = s.code_unit_at(i)
    if c == 0x20 || (c <= 0x0D && (c == 0x0A || c == 0x09 || c == 0x0D)) {
      i = i + 1
    } else {
      break
    }
  }
  i
}

fn skip_comma_wsp(s : String, pos : Int, end : Int) -> Int {
  let mut i = pos
  while i < end {
    let c = s.code_unit_at(i)
    if c == 0x20 || (c <= 0x0D && (c == 0x0A || c == 0x09 || c == 0x0D || c == 0x0C)) {
      i = i + 1
    } else {
      break
    }
  }
  if i < end && s.code_unit_at(i) == 0x2C {
    i = i + 1
    while i < end {
      let c = s.code_unit_at(i)
      if c == 0x20 || (c <= 0x0D && (c == 0x0A || c == 0x09 || c == 0x0D || c == 0x0C)) {
        i = i + 1
      } else {
        break
      }
    }
  }
  i
}

fn pow10_i64(p : Int) -> Int64 {
  let mut res = 1L
  let mut k = 0
  while k < p {
    res = res * 10L
    k = k + 1
  }
  res
}

///| Round `v` to `precision` (0..8) decimal places, returning the exact rounded Double.
fn round_to_precision(v : Double, precision : Int) -> Double {
  if !is_finite(v) {
    return 0.0
  }
  let p = if precision < 0 {
    0
  } else if precision > 8 {
    8
  } else {
    precision
  }
  let abs_v = v.abs()
  if abs_v >= 4500000000000000.0 {
    return v
  }
  let scale = pow10_exact_tbl[p]
  let ip = abs_v.floor()
  let fp = abs_v - ip
  let f_int = (fp * scale + 0.5).floor()
  let r = ip + f_int / scale
  if r == 0.0 {
    0.0
  } else if v < 0.0 {
    -r
  } else {
    r
  }
}

fn write_nonneg_i64(sb : StringBuilder, n : Int64) -> Unit {
  if n < 10L {
    sb.write_byte((0x30 + n.to_int()).to_byte())
  } else if n < 100L {
    let v = n.to_int()
    sb.write_byte((0x30 + v / 10).to_byte())
    sb.write_byte((0x30 + v % 10).to_byte())
  } else if n < 1000L {
    let v = n.to_int()
    sb.write_byte((0x30 + v / 100).to_byte())
    sb.write_byte((0x30 + (v / 10) % 10).to_byte())
    sb.write_byte((0x30 + v % 10).to_byte())
  } else if n < 10000L {
    let v = n.to_int()
    sb.write_byte((0x30 + v / 1000).to_byte())
    sb.write_byte((0x30 + (v / 100) % 10).to_byte())
    sb.write_byte((0x30 + (v / 10) % 10).to_byte())
    sb.write_byte((0x30 + v % 10).to_byte())
  } else {
    sb.write_string(n.to_string())
  }
}

///| Write a compactly formatted SVG number directly into `sb` with zero temporary String/StringBuilder
///| allocation, omitting the separator space when unambiguous.
///| Returns `true` if a subsequent number starting with `.` needs NO space.
fn write_compact_number_to(
  sb : StringBuilder,
  v : Double,
  precision : Int,
  after_cmd : Bool,
  prev_allows_dot_join : Bool,
) -> Bool {
  if !is_finite(v) {
    if !after_cmd {
      sb.write_byte((0x20).to_byte())
    }
    sb.write_byte((0x30).to_byte())
    return false
  }
  let p = if precision < 0 {
    0
  } else if precision > 8 {
    8
  } else {
    precision
  }
  let neg = v < 0.0
  let abs_v = if neg { -v } else { v }
  if abs_v < 4500000000000000.0 {
    let scale = pow10_exact_tbl[p]
    let scale_i = pow10_i64_tbl[p]
    let ip_f = abs_v.floor()
    let fp = abs_v - ip_f
    let mut f_int = (fp * scale + 0.5).floor().to_int64()
    let mut ip = ip_f.to_int64()
    if f_int >= scale_i {
      ip = ip + 1L
      f_int = 0L
    }
    if ip == 0L && f_int == 0L {
      if !after_cmd {
        sb.write_byte((0x20).to_byte())
      }
      sb.write_byte((0x30).to_byte())
      return false
    }
    if p == 0 || f_int == 0L {
      if neg {
        sb.write_byte((0x2D).to_byte())
      } else if !after_cmd {
        sb.write_byte((0x20).to_byte())
      }
      write_nonneg_i64(sb, ip)
      return false
    }
    // Has fractional digits: strip trailing zeros
    let mut digits = p
    let mut fpart = f_int
    while digits > 0 && fpart % 10L == 0L {
      fpart = fpart / 10L
      digits = digits - 1
    }
    if neg {
      sb.write_byte((0x2D).to_byte())
    } else if ip == 0L {
      // Starts with '.' -> space only needed if not after_cmd and !prev_allows_dot_join
      if !after_cmd && !prev_allows_dot_join {
        sb.write_byte((0x20).to_byte())
      }
    } else if !after_cmd {
      sb.write_byte((0x20).to_byte())
    }
    if ip > 0L {
      write_nonneg_i64(sb, ip)
    }
    sb.write_byte((0x2E).to_byte())
    let mut k = digits - 1
    while k >= 0 {
      let div = pow10_i64_tbl[k]
      let dig = (fpart / div).to_int()
      sb.write_byte((0x30 + dig).to_byte())
      fpart = fpart - dig.to_int64() * div
      k = k - 1
    }
    return true
  }
  let s = v.to_string()
  if !after_cmd && s.length() > 0 {
    let first = s.code_unit_at(0)
    if first != 0x2D && !(first == 0x2E && prev_allows_dot_join) {
      sb.write_byte((0x20).to_byte())
    }
  }
  sb.write_string(s)
  let sn = s.length()
  let mut si = 0
  while si < sn {
    let c = s.code_unit_at(si)
    if c == 0x2E || c == 0x65 || c == 0x45 {
      return true
    }
    si = si + 1
  }
  false
}

///| Format a Double compactly with `precision` decimal digits (0..8).
///| Strips trailing zeros, converts -0 to 0, omits leading 0 (`0.5` -> `.5`, `-0.5` -> `-.5`).
///| Never emits `inf` or `nan`.
fn format_compact_number(v : Double, precision : Int) -> String {
  let sb = StringBuilder::with_capacity(16)
  let _ = write_compact_number_to(sb, v, precision, true, false)
  sb.to_string()
}
