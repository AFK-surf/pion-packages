///| Core types, errors, and DoS limits for `svg`.

///| Categories of SVG parsing, geometry, and optimization errors.
pub enum SvgErrorKind {
  InvalidPath
  InvalidTransform
  InvalidColor
  InvalidNumber
  InvalidViewBox
  InvalidXml
  LimitExceeded
  Unimplemented
}

///| Structured SVG error with byte offset and message.
pub struct SvgError {
  pub kind : SvgErrorKind
  pub offset : Int
  pub message : String
}

///|
pub fn SvgError::new(
  kind : SvgErrorKind,
  offset : Int,
  message : String,
) -> SvgError {
  SvgError::{ kind: kind, offset: offset, message: message }
}

///|
pub fn SvgError::to_string(self : SvgError) -> String {
  self.message + " (offset " + self.offset.to_string() + ")"
}

///| Resource and security limits enforced during parsing, flattening, and optimization.
pub val struct SvgLimits {
  pub max_depth : Int
  pub max_elements : Int
  pub max_path_segments : Int
  pub max_flatten_points : Int
  pub max_input_bytes : Int
}

///|
pub fn SvgLimits::default() -> SvgLimits {
  SvgLimits::{
    max_depth: 128,
    max_elements: 100000,
    max_path_segments: 200000,
    max_flatten_points: 500000,
    max_input_bytes: 16777216,
  }
}

///| 2D point in SVG user coordinates.
pub val struct Point {
  pub x : Double
  pub y : Double
}

///|
pub fn Point::new(x : Double, y : Double) -> Point {
  Point::{ x: x, y: y }
}

///| Axis-aligned 2D bounding box.
pub val struct Rect {
  pub min_x : Double
  pub min_y : Double
  pub max_x : Double
  pub max_y : Double
}

///|
pub fn Rect::new(
  min_x : Double,
  min_y : Double,
  max_x : Double,
  max_y : Double,
) -> Rect {
  Rect::{ min_x: min_x, min_y: min_y, max_x: max_x, max_y: max_y }
}

///|
pub fn Rect::width(self : Rect) -> Double {
  self.max_x - self.min_x
}

///|
pub fn Rect::height(self : Rect) -> Double {
  self.max_y - self.min_y
}

///|
pub fn Rect::is_empty(self : Rect) -> Bool {
  self.max_x < self.min_x || self.max_y < self.min_y
}

///| SVG `viewBox` rectangle (`min-x min-y width height`).
pub val struct ViewBox {
  pub x : Double
  pub y : Double
  pub width : Double
  pub height : Double
}

///|
pub fn ViewBox::new(
  x : Double,
  y : Double,
  width : Double,
  height : Double,
) -> ViewBox {
  ViewBox::{ x: x, y: y, width: width, height: height }
}
