///| SVGO-class SVG optimizer and compact serializer.

///| Configuration options for `optimize_svg`.
pub val struct OptimizeOptions {
  pub float_precision : Int
  pub remove_comments : Bool
  pub remove_xml_decl : Bool
  pub remove_metadata : Bool
  pub remove_empty_groups : Bool
  pub collapse_groups : Bool
  pub convert_shapes_to_paths : Bool
  pub minify_colors : Bool
  pub optimize_paths : Bool
  pub limits : SvgLimits
}

///|
pub fn OptimizeOptions::default() -> OptimizeOptions {
  OptimizeOptions::{
    float_precision: 3,
    remove_comments: true,
    remove_xml_decl: true,
    remove_metadata: true,
    remove_empty_groups: true,
    collapse_groups: true,
    convert_shapes_to_paths: false,
    minify_colors: true,
    optimize_paths: true,
    limits: SvgLimits::default(),
  }
}

fn is_color_attr(name : String) -> Bool {
  name == "fill" ||
  name == "stroke" ||
  name == "color" ||
  name == "stop-color" ||
  name == "flood-color" ||
  name == "lighting-color"
}

fn minify_color_value(raw_val : String) -> String {
  let trimmed = ascii_trim(raw_val)
  let lower = ascii_lower(trimmed)
  if lower == "none" || lower == "currentcolor" || lower.contains("url(") {
    return trimmed
  }
  match parse_color(trimmed) {
    Ok(c) => {
      let hex = c.to_hex()
      if hex.length() < trimmed.length() {
        hex
      } else {
        trimmed
      }
    }
    Err(_) => trimmed
  }
}

fn write_xml_escaped(sb : StringBuilder, s : String, in_attr : Bool) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 0x26 {
      sb.write_string("&amp;")
    } else if c == 0x3C {
      sb.write_string("&lt;")
    } else if c == 0x3E {
      sb.write_string("&gt;")
    } else if in_attr && c == 0x22 {
      sb.write_string("&quot;")
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
}

fn is_removable_node(doc : SvgDocument, id : Int, opts : OptimizeOptions) -> Bool {
  let node = doc.nodes[id]
  match node.kind {
    SvgNodeKind::Comment => opts.remove_comments
    SvgNodeKind::XmlDecl => opts.remove_xml_decl
    SvgNodeKind::Element => opts.remove_metadata && node.tag == "metadata"
    SvgNodeKind::Text => false
  }
}

///| Check if a `<g>` subtree has zero surviving content (iterative).
fn is_empty_group(doc : SvgDocument, id : Int, opts : OptimizeOptions) -> Bool {
  let stack : Array[Int] = [id]
  while stack.length() > 0 {
    let cur = match stack.pop() {
      Some(v) => v
      None => break
    }
    let node = doc.nodes[cur]
    match node.kind {
      SvgNodeKind::Element => {
        if node.tag != "g" {
          if !(opts.remove_metadata && node.tag == "metadata") {
            return false
          }
        } else {
          let mut k = 0
          while k < node.children.length() {
            let cid = node.children[k]
            if !is_removable_node(doc, cid, opts) {
              stack.push(cid)
            }
            k = k + 1
          }
        }
      }
      SvgNodeKind::Text => {
        if ascii_trim(node.text).length() > 0 {
          return false
        }
      }
      SvgNodeKind::Comment => {
        if !opts.remove_comments {
          return false
        }
      }
      SvgNodeKind::XmlDecl => {
        if !opts.remove_xml_decl {
          return false
        }
      }
    }
  }
  true
}

fn should_skip_shape_attr(name : String) -> Bool {
  name == "x" ||
  name == "y" ||
  name == "width" ||
  name == "height" ||
  name == "rx" ||
  name == "ry" ||
  name == "cx" ||
  name == "cy" ||
  name == "r" ||
  name == "x1" ||
  name == "y1" ||
  name == "x2" ||
  name == "y2" ||
  name == "points"
}

struct EmitOp {
  // 0 = visit node, 1 = emit closing tag
  op : Int
  node_id : Int
  close_tag : String
}

///| Optimize an SVG document string according to `opts`.
pub fn optimize_svg(
  src : String,
  opts : OptimizeOptions,
) -> Result[String, SvgError] {
  let doc = match parse_svg_with_limits(src, opts.limits) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let sb = StringBuilder::new()
  let stack : Array[EmitOp] = []
  // Push top-level children of synthetic #document node (index 0) in reverse
  let top = doc.nodes[0].children
  let mut ti = top.length() - 1
  while ti >= 0 {
    stack.push(EmitOp::{ op: 0, node_id: top[ti], close_tag: "" })
    ti = ti - 1
  }
  while stack.length() > 0 {
    let item = match stack.pop() {
      Some(v) => v
      None => break
    }
    if item.op == 1 {
      sb.write_string("</")
      sb.write_string(item.close_tag)
      sb.write_byte((0x3E).to_byte())
      continue
    }
    let id = item.node_id
    if is_removable_node(doc, id, opts) {
      continue
    }
    let node = doc.nodes[id]
    match node.kind {
      SvgNodeKind::Comment => {
        sb.write_string("<!--")
        sb.write_string(node.text)
        sb.write_string("-->")
      }
      SvgNodeKind::XmlDecl => {
        sb.write_string("<?")
        sb.write_string(node.text)
        sb.write_string("?>")
      }
      SvgNodeKind::Text => {
        write_xml_escaped(sb, ascii_trim(node.text), false)
      }
      SvgNodeKind::Element => {
        if node.tag == "g" && opts.remove_empty_groups && is_empty_group(doc, id, opts) {
          continue
        }
        // Collapse attribute-less `<g>` wrapper
        if node.tag == "g" && opts.collapse_groups && node.attrs.length() == 0 {
          let mut ck = node.children.length() - 1
          while ck >= 0 {
            stack.push(EmitOp::{ op: 0, node_id: node.children[ck], close_tag: "" })
            ck = ck - 1
          }
          continue
        }
        let mut emit_tag = node.tag
        let mut converted_d = ""
        let mut did_convert_shape = false
        if opts.convert_shapes_to_paths &&
        is_shape_tag(node.tag) &&
        node.tag != "path" {
          match shape_to_path(node.tag, node.attrs) {
            Ok(sp) => {
              emit_tag = "path"
              converted_d = format_path(sp, opts.float_precision)
              did_convert_shape = true
            }
            Err(_) => ()
          }
        }
        sb.write_byte((0x3C).to_byte())
        sb.write_string(emit_tag)
        let mut ai = 0
        while ai < node.attrs.length() {
          let a = node.attrs[ai]
          if did_convert_shape && should_skip_shape_attr(a.name) {
            ai = ai + 1
            continue
          }
          let attr_v = if opts.optimize_paths && a.name == "d" && emit_tag == "path" {
            match parse_path_with_limits(a.value, opts.limits) {
              Ok(sp) => format_path(sp, opts.float_precision)
              Err(_) => a.value
            }
          } else if opts.minify_colors && is_color_attr(a.name) {
            minify_color_value(a.value)
          } else {
            a.value
          }
          sb.write_byte((0x20).to_byte())
          sb.write_string(a.name)
          sb.write_string("=\"")
          write_xml_escaped(sb, attr_v, true)
          sb.write_byte((0x22).to_byte())
          ai = ai + 1
        }
        if did_convert_shape {
          sb.write_string(" d=\"")
          write_xml_escaped(sb, converted_d, true)
          sb.write_byte((0x22).to_byte())
        }
        // Check surviving children
        let mut has_child = false
        let mut ci = 0
        while ci < node.children.length() {
          let cid = node.children[ci]
          if !is_removable_node(doc, cid, opts) {
            let cn = doc.nodes[cid]
            let skip = match cn.kind {
              SvgNodeKind::Element => {
                cn.tag == "g" && opts.remove_empty_groups && is_empty_group(doc, cid, opts)
              }
              _ => false
            }
            if !skip {
              has_child = true
              break
            }
          }
          ci = ci + 1
        }
        if !has_child {
          sb.write_string("/>")
        } else {
          sb.write_byte((0x3E).to_byte())
          stack.push(EmitOp::{ op: 1, node_id: -1, close_tag: emit_tag })
          let mut ck = node.children.length() - 1
          while ck >= 0 {
            stack.push(EmitOp::{ op: 0, node_id: node.children[ck], close_tag: "" })
            ck = ck - 1
          }
        }
      }
    }
  }
  Ok(sb.to_string())
}
