///| SVGO-class SVG optimizer and compact serializer.

///| Configuration options for `optimize_svg`.
pub val struct OptimizeOptions {
  pub float_precision : Int
  pub remove_comments : Bool
  pub remove_xml_decl : Bool
  pub remove_metadata : Bool
  pub remove_empty_groups : Bool
  pub collapse_groups : Bool
  pub convert_shapes_to_paths : Bool
  pub minify_colors : Bool
  pub optimize_paths : Bool
  pub limits : SvgLimits
}

///|
pub fn OptimizeOptions::default() -> OptimizeOptions {
  OptimizeOptions::{
    float_precision: 3,
    remove_comments: true,
    remove_xml_decl: true,
    remove_metadata: true,
    remove_empty_groups: true,
    collapse_groups: true,
    convert_shapes_to_paths: false,
    minify_colors: true,
    optimize_paths: true,
    limits: SvgLimits::default(),
  }
}

fn is_color_attr(name : String) -> Bool {
  let n = name.length()
  if n < 4 || n > 14 {
    return false
  }
  let c0 = name.code_unit_at(0)
  if c0 == 0x66 {
    name == "fill" || name == "flood-color"
  } else if c0 == 0x73 {
    name == "stroke" || name == "stop-color"
  } else if c0 == 0x63 {
    name == "color"
  } else if c0 == 0x6C {
    name == "lighting-color"
  } else {
    false
  }
}

///| Minify opaque colors to compact `#rgb`/`#rrggbb`.
///| Keeps alpha colors (`c.a != 255`) in SVG 1.1-compatible form (never emits `#rrggbbaa`/`#rgba`).
fn minify_color_value(raw_val : String) -> String {
  let trimmed = ascii_trim(raw_val)
  let tn = trimmed.length()
  // Fast path for #rrggbb (most common SVG color format)
  if tn == 7 && trimmed.code_unit_at(0) == 0x23 {
    let mut i = 1
    let mut valid = true
    while i < 7 {
      if hex_val(trimmed.code_unit_at(i)) < 0 {
        valid = false
        break
      }
      i = i + 1
    }
    if valid {
      let c1 = trimmed.code_unit_at(1)
      let c2 = trimmed.code_unit_at(2)
      let c3 = trimmed.code_unit_at(3)
      let c4 = trimmed.code_unit_at(4)
      let c5 = trimmed.code_unit_at(5)
      let c6 = trimmed.code_unit_at(6)
      let l1 = if c1 >= 0x41 && c1 <= 0x46 { c1 + 32 } else { c1 }
      let l2 = if c2 >= 0x41 && c2 <= 0x46 { c2 + 32 } else { c2 }
      let l3 = if c3 >= 0x41 && c3 <= 0x46 { c3 + 32 } else { c3 }
      let l4 = if c4 >= 0x41 && c4 <= 0x46 { c4 + 32 } else { c4 }
      let l5 = if c5 >= 0x41 && c5 <= 0x46 { c5 + 32 } else { c5 }
      let l6 = if c6 >= 0x41 && c6 <= 0x46 { c6 + 32 } else { c6 }
      if l1 == l2 && l3 == l4 && l5 == l6 {
        let sb = StringBuilder::with_capacity(4)
        sb.write_byte((0x23).to_byte())
        sb.write_byte(l1.to_byte())
        sb.write_byte(l3.to_byte())
        sb.write_byte(l5.to_byte())
        return sb.to_string()
      }
      return trimmed
    }
  }
  let lower = ascii_lower(trimmed)
  if lower == "none" || lower == "currentcolor" || lower.contains("url(") {
    return trimmed
  }
  match parse_color(trimmed) {
    Ok(c) => {
      if c.a != 255 {
        return trimmed
      }
      let hex = c.to_hex()
      if hex.length() < tn {
        hex
      } else {
        trimmed
      }
    }
    Err(_) => trimmed
  }
}

fn write_xml_escaped(sb : StringBuilder, s : String, in_attr : Bool) -> Unit {
  let n = s.length()
  let mut needs = false
  let mut i = 0
  if in_attr {
    while i < n {
      let c = s.code_unit_at(i)
      if c <= 0x3E && (c == 0x26 || c == 0x3C || c == 0x3E || c == 0x22 || (c <= 0x0D && (c == 0x0A || c == 0x09 || c == 0x0D))) {
        needs = true
        break
      }
      i = i + 1
    }
  } else {
    while i < n {
      let c = s.code_unit_at(i)
      if c <= 0x3E && (c == 0x26 || c == 0x3C || c == 0x3E) {
        needs = true
        break
      }
      i = i + 1
    }
  }
  if !needs {
    sb.write_string(s)
    return
  }
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 0x26 {
      sb.write_string("&amp;")
    } else if c == 0x3C {
      sb.write_string("&lt;")
    } else if c == 0x3E {
      sb.write_string("&gt;")
    } else if in_attr && c == 0x22 {
      sb.write_string("&quot;")
    } else if in_attr && c == 0x0A {
      sb.write_string("&#10;")
    } else if in_attr && c == 0x09 {
      sb.write_string("&#9;")
    } else if in_attr && c == 0x0D {
      sb.write_string("&#13;")
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
}

///| True only for `<?xml ...?>` (the XML declaration), NOT `<?xml-stylesheet ...?>` or other PIs.
fn is_xml_decl_pi(text : String) -> Bool {
  let n = text.length()
  if n < 3 {
    return false
  }
  let head = ascii_lower(text.slice(0, 3))
  if head != "xml" {
    return false
  }
  if n == 3 {
    return true
  }
  is_xml_ws(text.code_unit_at(3))
}

fn is_text_preserving_tag(ltag : String) -> Bool {
  let n = ltag.length()
  if n < 4 || n > 8 {
    return false
  }
  let c0 = ltag.code_unit_at(0)
  if c0 == 0x74 {
    ltag == "text" || ltag == "tspan" || ltag == "textPath" || ltag == "tref"
  } else if c0 == 0x73 {
    ltag == "style" || ltag == "script"
  } else {
    false
  }
}

fn is_animation_tag(ltag : String) -> Bool {
  ltag == "animate" ||
  ltag == "animateColor" ||
  ltag == "animateMotion" ||
  ltag == "animateTransform" ||
  ltag == "set"
}

fn has_xml_space_preserve(attrs : Array[SvgAttr]) -> Bool {
  let n = attrs.length()
  let mut i = 0
  while i < n {
    let an = attrs[i].name
    if an.length() == 9 && an.code_unit_at(0) == 0x78 && an == "xml:space" {
      return ascii_trim(attrs[i].value) == "preserve"
    }
    i = i + 1
  }
  false
}

fn has_filter_attr(attrs : Array[SvgAttr]) -> Bool {
  let n = attrs.length()
  let mut i = 0
  while i < n {
    let an = attrs[i].name
    if an.length() == 6 && an.code_unit_at(0) == 0x66 && an == "filter" {
      return true
    }
    i = i + 1
  }
  false
}

fn is_all_svg_ws(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if !(c == 0x20 || (c <= 0x0D && (c == 0x0A || c == 0x09 || c == 0x0D || c == 0x0C))) {
      return false
    }
    i = i + 1
  }
  true
}

fn has_animation_child(doc : SvgDocument, node : SvgNode) -> Bool {
  let mut k = 0
  while k < node.children.length() {
    let ch = doc.nodes[node.children[k]]
    match ch.kind {
      SvgNodeKind::Element => {
        if is_animation_tag(local_name(ch.tag)) {
          return true
        }
      }
      _ => ()
    }
    k = k + 1
  }
  false
}

fn is_removable_node(doc : SvgDocument, id : Int, opts : OptimizeOptions) -> Bool {
  let node = doc.nodes[id]
  match node.kind {
    SvgNodeKind::Comment => opts.remove_comments
    SvgNodeKind::XmlDecl => opts.remove_xml_decl && is_xml_decl_pi(node.text)
    SvgNodeKind::Element => opts.remove_metadata && local_name(node.tag) == "metadata"
    SvgNodeKind::Text => false
  }
}

fn should_skip_shape_attr(name : String) -> Bool {
  name == "x" ||
  name == "y" ||
  name == "width" ||
  name == "height" ||
  name == "rx" ||
  name == "ry" ||
  name == "cx" ||
  name == "cy" ||
  name == "r" ||
  name == "x1" ||
  name == "y1" ||
  name == "x2" ||
  name == "y2" ||
  name == "points"
}

struct EmitOp {
  // 0 = visit node, 1 = emit closing tag
  op : Int
  node_id : Int
  close_tag : String
}

fn write_raw_range(sb : StringBuilder, s : String, start : Int, end : Int) -> Unit {
  if end - start <= 32 {
    let mut i = start
    while i < end {
      sb.write_byte(s.code_unit_at(i).to_byte())
      i = i + 1
    }
  } else {
    sb.write_string(s.slice(start, end))
  }
}

fn write_xml_escaped_range(sb : StringBuilder, s : String, start : Int, end : Int, in_attr : Bool) -> Unit {
  let mut needs = false
  let mut i = start
  if in_attr {
    while i < end {
      let c = s.code_unit_at(i)
      if c <= 0x3E && (c == 0x26 || c == 0x3C || c == 0x3E || c == 0x22 || (c <= 0x0D && (c == 0x0A || c == 0x09 || c == 0x0D))) {
        needs = true
        break
      }
      i = i + 1
    }
  } else {
    while i < end {
      let c = s.code_unit_at(i)
      if c <= 0x3E && (c == 0x26 || c == 0x3C || c == 0x3E) {
        needs = true
        break
      }
      i = i + 1
    }
  }
  if !needs {
    write_raw_range(sb, s, start, end)
    return
  }
  i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c == 0x26 {
      sb.write_string("&amp;")
    } else if c == 0x3C {
      sb.write_string("&lt;")
    } else if c == 0x3E {
      sb.write_string("&gt;")
    } else if in_attr && c == 0x22 {
      sb.write_string("&quot;")
    } else if in_attr && c == 0x0A {
      sb.write_string("&#10;")
    } else if in_attr && c == 0x09 {
      sb.write_string("&#9;")
    } else if in_attr && c == 0x0D {
      sb.write_string("&#13;")
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
}

fn slice_eq_lit(s : String, start : Int, end : Int, lit : String) -> Bool {
  let len = end - start
  if len != lit.length() {
    return false
  }
  let mut k = 0
  while k < len {
    if s.code_unit_at(start + k) != lit.code_unit_at(k) {
      return false
    }
    k = k + 1
  }
  true
}

fn slice_eq_slice(s : String, s1 : Int, e1 : Int, s2 : Int, e2 : Int) -> Bool {
  let len = e1 - s1
  if len != e2 - s2 {
    return false
  }
  let mut k = 0
  while k < len {
    if s.code_unit_at(s1 + k) != s.code_unit_at(s2 + k) {
      return false
    }
    k = k + 1
  }
  true
}

fn local_start_of(s : String, start : Int, end : Int) -> Int {
  let mut i = start
  while i < end {
    if s.code_unit_at(i) == 0x3A {
      return i + 1
    }
    i = i + 1
  }
  start
}

fn is_all_svg_ws_range(s : String, start : Int, end : Int) -> Bool {
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if !(c == 0x20 || (c <= 0x0D && (c == 0x0A || c == 0x09 || c == 0x0D || c == 0x0C))) {
      return false
    }
    i = i + 1
  }
  true
}

fn is_text_preserving_range(s : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len < 4 || len > 8 {
    return false
  }
  let c0 = s.code_unit_at(start)
  if c0 == 0x74 {
    slice_eq_lit(s, start, end, "text") ||
    slice_eq_lit(s, start, end, "tspan") ||
    slice_eq_lit(s, start, end, "textPath") ||
    slice_eq_lit(s, start, end, "tref")
  } else if c0 == 0x73 {
    slice_eq_lit(s, start, end, "style") ||
    slice_eq_lit(s, start, end, "script")
  } else {
    false
  }
}

fn is_anim_range(s : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len == 3 {
    return slice_eq_lit(s, start, end, "set")
  }
  if len >= 7 && s.code_unit_at(start) == 0x61 {
    return slice_eq_lit(s, start, end, "animate") ||
    slice_eq_lit(s, start, end, "animateColor") ||
    slice_eq_lit(s, start, end, "animateMotion") ||
    slice_eq_lit(s, start, end, "animateTransform")
  }
  false
}

fn is_color_attr_range(s : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len < 4 || len > 14 {
    return false
  }
  let c0 = s.code_unit_at(start)
  if c0 == 0x66 {
    slice_eq_lit(s, start, end, "fill") || slice_eq_lit(s, start, end, "flood-color")
  } else if c0 == 0x73 {
    slice_eq_lit(s, start, end, "stroke") || slice_eq_lit(s, start, end, "stop-color")
  } else if c0 == 0x63 {
    slice_eq_lit(s, start, end, "color")
  } else if c0 == 0x6C {
    slice_eq_lit(s, start, end, "lighting-color")
  } else {
    false
  }
}

fn is_xml_decl_pi_range(s : String, start : Int, end : Int) -> Bool {
  let len = end - start
  if len < 3 {
    return false
  }
  let c0 = s.code_unit_at(start) | 0x20
  let c1 = s.code_unit_at(start + 1) | 0x20
  let c2 = s.code_unit_at(start + 2) | 0x20
  if c0 != 0x78 || c1 != 0x6D || c2 != 0x6C {
    return false
  }
  if len == 3 {
    return true
  }
  is_xml_ws(s.code_unit_at(start + 3))
}

fn write_minified_color_range(sb : StringBuilder, s : String, start : Int, end : Int) -> Unit {
  let mut a = start
  while a < end && is_svg_ws(s.code_unit_at(a)) {
    a = a + 1
  }
  let mut b = end
  while b > a && is_svg_ws(s.code_unit_at(b - 1)) {
    b = b - 1
  }
  let len = b - a
  if len == 7 && s.code_unit_at(a) == 0x23 {
    let h1 = hex_val(s.code_unit_at(a + 1))
    let h2 = hex_val(s.code_unit_at(a + 2))
    let h3 = hex_val(s.code_unit_at(a + 3))
    let h4 = hex_val(s.code_unit_at(a + 4))
    let h5 = hex_val(s.code_unit_at(a + 5))
    let h6 = hex_val(s.code_unit_at(a + 6))
    if h1 >= 0 && h2 >= 0 && h3 >= 0 && h4 >= 0 && h5 >= 0 && h6 >= 0 {
      if h1 == h2 && h3 == h4 && h5 == h6 {
        sb.write_byte((0x23).to_byte())
        sb.write_byte(hex_nibble(h1))
        sb.write_byte(hex_nibble(h3))
        sb.write_byte(hex_nibble(h5))
        return
      }
      write_raw_range(sb, s, a, b)
      return
    }
  }
  write_xml_escaped(sb, minify_color_value(s.slice(a, b)), true)
}

///| Optimize an SVG document string according to `opts` in linear O(N) time.
///| Uses a flat-array zero-node-object XML index to avoid allocating intermediate DOM objects.
pub fn optimize_svg(
  src : String,
  opts : OptimizeOptions,
) -> Result[String, SvgError] {
  if opts.convert_shapes_to_paths {
    return optimize_svg_dom(src, opts)
  }
  let n = src.length()
  if n > opts.limits.max_input_bytes {
    return Err(
      SvgError::new(
        SvgErrorKind::LimitExceeded,
        0,
        "SVG input exceeds max_input_bytes",
      ),
    )
  }
  let mut cap = n / 40 + 8
  if cap > 2048 {
    cap = 2048
  }
  // Flat node arrays: kind 0=Element, 1=Text, 2=Comment, 3=XmlDecl
  let n_kind : Array[Int] = Array::with_capacity(cap)
  let n_parent : Array[Int] = Array::with_capacity(cap)
  let n_s : Array[Int] = Array::with_capacity(cap)
  let n_e : Array[Int] = Array::with_capacity(cap)
  let n_a0 : Array[Int] = Array::with_capacity(cap)
  let n_a1 : Array[Int] = Array::with_capacity(cap)
  let n_fc : Array[Int] = Array::with_capacity(cap)
  let n_lc : Array[Int] = Array::with_capacity(cap)
  let n_ns : Array[Int] = Array::with_capacity(cap)
  // Flat attribute arrays
  let a_ns : Array[Int] = Array::with_capacity(cap * 2)
  let a_ne : Array[Int] = Array::with_capacity(cap * 2)
  let a_vs : Array[Int] = Array::with_capacity(cap * 2)
  let a_ve : Array[Int] = Array::with_capacity(cap * 2)
  let pool : Array[String] = []

  // Node 0: synthetic #document
  n_kind.push(0)
  n_parent.push(-1)
  n_s.push(0)
  n_e.push(0)
  n_a0.push(0)
  n_a1.push(0)
  n_fc.push(-1)
  n_lc.push(-1)
  n_ns.push(-1)

  let stack : Array[Int] = Array::with_capacity(16)
  stack.push(0)
  let ns_bindings : Array[NsBinding] = []
  let mut elem_count = 0
  let mut root_elem = -1
  let mut i = 0
  if n >= 3 &&
  src.code_unit_at(0) == 0xEF &&
  src.code_unit_at(1) == 0xBB &&
  src.code_unit_at(2) == 0xBF {
    i = 3
  }
  while i < n {
    let c = src.code_unit_at(i)
    if c == 0x3C {
      if i + 1 >= n {
        return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unexpected '<' at EOF"))
      }
      let c1 = src.code_unit_at(i + 1)
      if c1 == 0x21 && i + 3 < n && src.code_unit_at(i + 2) == 0x2D && src.code_unit_at(i + 3) == 0x2D {
        let start = i + 4
        let mut j = start
        let mut found = -1
        while j + 1 < n {
          if src.code_unit_at(j) == 0x2D && src.code_unit_at(j + 1) == 0x2D {
            if j + 2 < n && src.code_unit_at(j + 2) == 0x3E {
              found = j
              break
            }
            return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "'--' is not allowed inside XML comment"))
          }
          j = j + 1
        }
        if found < 0 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated comment"))
        }
        if !opts.remove_comments {
          let pid = stack[stack.length() - 1]
          let id = n_kind.length()
          n_kind.push(2)
          n_parent.push(pid)
          n_s.push(start)
          n_e.push(found)
          n_a0.push(0)
          n_a1.push(0)
          n_fc.push(-1)
          n_lc.push(-1)
          n_ns.push(-1)
          if n_lc[pid] < 0 {
            n_fc[pid] = id
            n_lc[pid] = id
          } else {
            n_ns[n_lc[pid]] = id
            n_lc[pid] = id
          }
        }
        i = found + 3
        continue
      }
      if c1 == 0x21 && i + 8 < n && src.slice(i, i + 9) == "<![CDATA[" {
        if stack.length() <= 1 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "CDATA outside root element"))
        }
        let start = i + 9
        let mut j = start
        let mut found = -1
        while j + 2 < n {
          if src.code_unit_at(j) == 0x5D && src.code_unit_at(j + 1) == 0x5D && src.code_unit_at(j + 2) == 0x3E {
            found = j
            break
          }
          j = j + 1
        }
        if found < 0 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated CDATA"))
        }
        let pid = stack[stack.length() - 1]
        let id = n_kind.length()
        n_kind.push(1)
        n_parent.push(pid)
        n_s.push(start)
        n_e.push(found)
        n_a0.push(0)
        n_a1.push(0)
        n_fc.push(-1)
        n_lc.push(-1)
        n_ns.push(-1)
        if n_lc[pid] < 0 {
          n_fc[pid] = id
          n_lc[pid] = id
        } else {
          n_ns[n_lc[pid]] = id
          n_lc[pid] = id
        }
        i = found + 3
        continue
      }
      if c1 == 0x21 {
        if i + 9 >= n || src.slice(i, i + 9) != "<!DOCTYPE" || !is_xml_ws(src.code_unit_at(i + 9)) {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "invalid XML declaration"))
        }
        let mut j = i + 9
        let mut bd = 0
        while j < n {
          let ch = src.code_unit_at(j)
          if ch == 0x5B {
            bd = bd + 1
          } else if ch == 0x5D && bd > 0 {
            bd = bd - 1
          } else if ch == 0x3E && bd == 0 {
            break
          }
          j = j + 1
        }
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated DOCTYPE"))
        }
        i = j + 1
        continue
      }
      if c1 == 0x3F {
        let start = i + 2
        let mut j = start
        let mut found = -1
        while j + 1 < n {
          if src.code_unit_at(j) == 0x3F && src.code_unit_at(j + 1) == 0x3E {
            found = j
            break
          }
          j = j + 1
        }
        if found < 0 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unterminated processing instruction"))
        }
        if !(opts.remove_xml_decl && is_xml_decl_pi_range(src, start, found)) {
          let pid = stack[stack.length() - 1]
          let id = n_kind.length()
          n_kind.push(3)
          n_parent.push(pid)
          n_s.push(start)
          n_e.push(found)
          n_a0.push(0)
          n_a1.push(0)
          n_fc.push(-1)
          n_lc.push(-1)
          n_ns.push(-1)
          if n_lc[pid] < 0 {
            n_fc[pid] = id
            n_lc[pid] = id
          } else {
            n_ns[n_lc[pid]] = id
            n_lc[pid] = id
          }
        }
        i = found + 2
        continue
      }
      if c1 == 0x2F {
        let name_start = i + 2
        let mut j = name_start
        while j < n {
          let nc = src.code_unit_at(j)
          if (nc >= 0x61 && nc <= 0x7A) || (nc >= 0x41 && nc <= 0x5A) || (nc >= 0x30 && nc <= 0x39) || nc == 0x2D || nc == 0x5F || nc == 0x2E || nc == 0x3A || nc >= 0x80 {
            j = j + 1
          } else {
            break
          }
        }
        if j == name_start {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "invalid closing tag"))
        }
        let name_end = j
        while j < n {
          let wc = src.code_unit_at(j)
          if wc == 0x20 || (wc <= 0x0D && (wc == 0x0A || wc == 0x09 || wc == 0x0D)) {
            j = j + 1
          } else {
            break
          }
        }
        if j >= n || src.code_unit_at(j) != 0x3E {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected '>' in closing tag"))
        }
        if stack.length() <= 1 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "unexpected closing tag </" + src.slice(name_start, name_end) + ">"))
        }
        let top_id = stack[stack.length() - 1]
        if !slice_eq_slice(src, name_start, name_end, n_s[top_id], n_e[top_id]) {
          return Err(
            SvgError::new(
              SvgErrorKind::InvalidXml,
              i,
              "mismatched closing tag </" + src.slice(name_start, name_end) + "> for <" + src.slice(n_s[top_id], n_e[top_id]) + ">",
            ),
          )
        }
        let closing_depth = stack.length() - 1
        let _ = stack.pop()
        while ns_bindings.length() > 0 && ns_bindings[ns_bindings.length() - 1].depth >= closing_depth {
          let _ = ns_bindings.pop()
        }
        i = j + 1
        continue
      }
      // Opening tag <name attrs... /?>
      let name_start = i + 1
      let mut j = name_start
      let mut tag_has_colon = false
      while j < n {
        let nc = src.code_unit_at(j)
        if (nc >= 0x61 && nc <= 0x7A) || (nc >= 0x41 && nc <= 0x5A) || (nc >= 0x30 && nc <= 0x39) || nc == 0x2D || nc == 0x5F || nc == 0x2E || nc >= 0x80 {
          j = j + 1
        } else if nc == 0x3A {
          tag_has_colon = true
          j = j + 1
        } else {
          break
        }
      }
      if j == name_start {
        return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "empty tag name"))
      }
      let name_end = j
      let pid = stack[stack.length() - 1]
      if pid == 0 && root_elem >= 0 {
        return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "multiple root elements"))
      }
      elem_count = elem_count + 1
      if elem_count > opts.limits.max_elements {
        return Err(SvgError::new(SvgErrorKind::LimitExceeded, i, "SVG exceeds max_elements"))
      }
      let a0 = a_ns.length()
      let mut self_closing = false
      let elem_depth = stack.length()
      let mut need_ws_before_attr = false
      let mut any_attr_colon = false
      while j < n {
        let before_ws = j
        while j < n {
          let wc = src.code_unit_at(j)
          if wc == 0x20 || (wc <= 0x0D && (wc == 0x0A || wc == 0x09 || wc == 0x0D)) {
            j = j + 1
          } else {
            break
          }
        }
        let had_ws = j > before_ws
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "unterminated start tag"))
        }
        let ch = src.code_unit_at(j)
        if ch == 0x3E {
          j = j + 1
          break
        }
        if ch == 0x2F {
          if j + 1 < n && src.code_unit_at(j + 1) == 0x3E {
            self_closing = true
            j = j + 2
            break
          }
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected '>' after '/'"))
        }
        if need_ws_before_attr && !had_ws {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected whitespace between attributes"))
        }
        let an_start = j
        while j < n {
          let ac = src.code_unit_at(j)
          if (ac >= 0x61 && ac <= 0x7A) || (ac >= 0x41 && ac <= 0x5A) || (ac >= 0x30 && ac <= 0x39) || ac == 0x2D || ac == 0x5F || ac == 0x2E || ac >= 0x80 {
            j = j + 1
          } else if ac == 0x3A {
            any_attr_colon = true
            j = j + 1
          } else {
            break
          }
        }
        if j == an_start {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "invalid attribute name"))
        }
        let an_end = j
        // Reject duplicate attributes
        let mut ak = a0
        while ak < a_ns.length() {
          if slice_eq_slice(src, a_ns[ak], a_ne[ak], an_start, an_end) {
            return Err(SvgError::new(SvgErrorKind::InvalidXml, an_start, "duplicate attribute: " + src.slice(an_start, an_end)))
          }
          ak = ak + 1
        }
        j = skip_xml_ws(src, j, n)
        if j >= n || src.code_unit_at(j) != 0x3D {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected '=' after attribute name"))
        }
        j = skip_xml_ws(src, j + 1, n)
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "expected attribute value"))
        }
        let q = src.code_unit_at(j)
        if q != 0x22 && q != 0x27 {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "attribute value must be quoted"))
        }
        j = j + 1
        let val_start = j
        let mut needs_decode = false
        while j < n {
          let vc = src.code_unit_at(j)
          if vc == q {
            break
          }
          if vc == 0x3C {
            return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "'<' not allowed in attribute value"))
          }
          if vc == 0x26 || vc == 0x09 || vc == 0x0A || vc == 0x0D {
            needs_decode = true
          }
          j = j + 1
        }
        if j >= n {
          return Err(SvgError::new(SvgErrorKind::InvalidXml, j, "unterminated attribute string"))
        }
        let val_end = j
        j = j + 1
        if an_end - an_start > 6 && src.code_unit_at(an_start) == 0x78 && slice_eq_lit(src, an_start, an_start + 6, "xmlns:") {
          ns_bindings.push(NsBinding::{ depth: elem_depth, prefix: src.slice(an_start + 6, an_end) })
        }
        a_ns.push(an_start)
        a_ne.push(an_end)
        if needs_decode {
          match decode_xml_entities(src.slice(val_start, val_end), val_start, true) {
            Ok(v) => {
              let pidx = pool.length()
              pool.push(v)
              a_vs.push(-1 - pidx)
              a_ve.push(0)
            }
            Err(e) => return Err(e)
          }
        } else {
          a_vs.push(val_start)
          a_ve.push(val_end)
        }
        need_ws_before_attr = true
      }
      let a1 = a_ns.length()
      if tag_has_colon && !validate_qname_prefix(src.slice(name_start, name_end), ns_bindings) {
        return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "undeclared namespace prefix: " + src.slice(name_start, name_end)))
      }
      if any_attr_colon {
        let mut ai = a0
        while ai < a1 {
          let aname = src.slice(a_ns[ai], a_ne[ai])
          if !validate_qname_prefix(aname, ns_bindings) {
            return Err(SvgError::new(SvgErrorKind::InvalidXml, i, "undeclared attribute prefix: " + aname))
          }
          ai = ai + 1
        }
      }
      let id = n_kind.length()
      n_kind.push(0)
      n_parent.push(pid)
      n_s.push(name_start)
      n_e.push(name_end)
      n_a0.push(a0)
      n_a1.push(a1)
      n_fc.push(-1)
      n_lc.push(-1)
      n_ns.push(-1)
      if n_lc[pid] < 0 {
        n_fc[pid] = id
        n_lc[pid] = id
      } else {
        n_ns[n_lc[pid]] = id
        n_lc[pid] = id
      }
      if root_elem < 0 && pid == 0 {
        root_elem = id
      }
      if self_closing {
        while ns_bindings.length() > 0 && ns_bindings[ns_bindings.length() - 1].depth >= elem_depth {
          let _ = ns_bindings.pop()
        }
      } else {
        if stack.length() > opts.limits.max_depth {
          return Err(SvgError::new(SvgErrorKind::LimitExceeded, i, "SVG nesting exceeds max_depth"))
        }
        stack.push(id)
      }
      i = j
    } else {
      let start = i
      let mut has_amp = false
      while i < n {
        let tc = src.code_unit_at(i)
        if tc == 0x3C {
          break
        }
        if tc == 0x26 {
          has_amp = true
        }
        i = i + 1
      }
      let pid = stack[stack.length() - 1]
      if pid == 0 {
        let mut wi = start
        while wi < i {
          if !is_xml_ws(src.code_unit_at(wi)) {
            return Err(SvgError::new(SvgErrorKind::InvalidXml, wi, "unexpected text outside root element"))
          }
          wi = wi + 1
        }
      } else {
        let id = n_kind.length()
        n_kind.push(1)
        n_parent.push(pid)
        if has_amp {
          match decode_xml_entities(src.slice(start, i), start, false) {
            Ok(v) => {
              let pidx = pool.length()
              pool.push(v)
              n_s.push(-1 - pidx)
              n_e.push(0)
            }
            Err(e) => return Err(e)
          }
        } else {
          n_s.push(start)
          n_e.push(i)
        }
        n_a0.push(0)
        n_a1.push(0)
        n_fc.push(-1)
        n_lc.push(-1)
        n_ns.push(-1)
        if n_lc[pid] < 0 {
          n_fc[pid] = id
          n_lc[pid] = id
        } else {
          n_ns[n_lc[pid]] = id
          n_lc[pid] = id
        }
      }
    }
  }
  if stack.length() != 1 {
    let top_id = stack[stack.length() - 1]
    return Err(SvgError::new(SvgErrorKind::InvalidXml, n, "unclosed tag <" + src.slice(n_s[top_id], n_e[top_id]) + ">"))
  }
  if root_elem < 0 {
    return Err(SvgError::new(SvgErrorKind::InvalidXml, 0, "no root element found"))
  }

  let num_nodes = n_kind.length()
  // Pass 1 (O(N) top-down): preserve_ws
  let preserve_ws : Array[Bool] = Array::with_capacity(num_nodes)
  let mut id = 0
  while id < num_nodes {
    let par = n_parent[id]
    let mut pws = if par >= 0 { preserve_ws[par] } else { false }
    if !pws && n_kind[id] == 0 {
      let ls = local_start_of(src, n_s[id], n_e[id])
      if is_text_preserving_range(src, ls, n_e[id]) {
        pws = true
      } else {
        let mut ai = n_a0[id]
        let a1 = n_a1[id]
        while ai < a1 {
          if a_ne[ai] - a_ns[ai] == 9 && src.code_unit_at(a_ns[ai]) == 0x78 && slice_eq_lit(src, a_ns[ai], a_ne[ai], "xml:space") {
            let v = if a_vs[ai] < 0 { pool[-1 - a_vs[ai]] } else { src.slice(a_vs[ai], a_ve[ai]) }
            if ascii_trim(v) == "preserve" {
              pws = true
            }
            break
          }
          ai = ai + 1
        }
      }
    }
    preserve_ws.push(pws)
    id = id + 1
  }

  // Pass 2 (O(N) bottom-up): dropped & has_child
  let dropped : Array[Bool] = Array::with_capacity(num_nodes)
  let has_child_arr : Array[Bool] = Array::with_capacity(num_nodes)
  id = 0
  while id < num_nodes {
    dropped.push(false)
    has_child_arr.push(false)
    id = id + 1
  }
  id = num_nodes - 1
  while id >= 0 {
    let k = n_kind[id]
    if k == 1 {
      if !preserve_ws[id] {
        let is_ws = if n_s[id] < 0 {
          is_all_svg_ws(pool[-1 - n_s[id]])
        } else {
          is_all_svg_ws_range(src, n_s[id], n_e[id])
        }
        if is_ws {
          dropped[id] = true
        }
      }
    } else if k == 0 {
      let ls = local_start_of(src, n_s[id], n_e[id])
      let tlen = n_e[id] - ls
      if opts.remove_metadata && tlen == 8 && src.code_unit_at(ls) == 0x6D && slice_eq_lit(src, ls, n_e[id], "metadata") {
        dropped[id] = true
      } else {
        let mut hc = false
        let mut ch = n_fc[id]
        while ch >= 0 {
          if !dropped[ch] {
            hc = true
            break
          }
          ch = n_ns[ch]
        }
        has_child_arr[id] = hc
        if opts.remove_empty_groups && !hc && tlen == 1 && src.code_unit_at(ls) == 0x67 {
          let mut has_flt = false
          let mut ai = n_a0[id]
          let a1 = n_a1[id]
          while ai < a1 {
            if a_ne[ai] - a_ns[ai] == 6 && src.code_unit_at(a_ns[ai]) == 0x66 && slice_eq_lit(src, a_ns[ai], a_ne[ai], "filter") {
              has_flt = true
              break
            }
            ai = ai + 1
          }
          if !has_flt {
            dropped[id] = true
          }
        }
      }
    }
    id = id - 1
  }

  // Pass 3 (O(N) iterative emit)
  let sb = StringBuilder::with_capacity(n)
  let emit_stack : Array[Int] = Array::with_capacity(32)
  // Collect children of node 0 in reverse order using stack
  let rev_buf : Array[Int] = Array::with_capacity(16)
  let mut ch0 = n_fc[0]
  while ch0 >= 0 {
    rev_buf.push(ch0)
    ch0 = n_ns[ch0]
  }
  while rev_buf.length() > 0 {
    match rev_buf.pop() {
      Some(v) => emit_stack.push(v)
      None => break
    }
  }
  while emit_stack.length() > 0 {
    let entry = match emit_stack.pop() {
      Some(v) => v
      None => break
    }
    if entry < 0 {
      let cid = -(entry + 1)
      sb.write_string("</")
      write_raw_range(sb, src, n_s[cid], n_e[cid])
      sb.write_byte((0x3E).to_byte())
      continue
    }
    let cur = entry
    if dropped[cur] {
      continue
    }
    let k = n_kind[cur]
    if k == 2 {
      sb.write_string("<!--")
      sb.write_string(src.slice(n_s[cur], n_e[cur]))
      sb.write_string("-->")
    } else if k == 3 {
      sb.write_string("<?")
      sb.write_string(src.slice(n_s[cur], n_e[cur]))
      sb.write_string("?>")
    } else if k == 1 {
      if n_s[cur] < 0 {
        let txt = pool[-1 - n_s[cur]]
        if preserve_ws[cur] {
          write_xml_escaped(sb, txt, false)
        } else {
          write_xml_escaped(sb, ascii_trim(txt), false)
        }
      } else if preserve_ws[cur] {
        write_xml_escaped_range(sb, src, n_s[cur], n_e[cur], false)
      } else {
        let mut a = n_s[cur]
        let mut b = n_e[cur]
        while a < b && is_svg_ws(src.code_unit_at(a)) {
          a = a + 1
        }
        while b > a && is_svg_ws(src.code_unit_at(b - 1)) {
          b = b - 1
        }
        write_xml_escaped_range(sb, src, a, b, false)
      }
    } else {
      let ts = n_s[cur]
      let te = n_e[cur]
      let ls = local_start_of(src, ts, te)
      let tlen = te - ls
      let a0 = n_a0[cur]
      let a1 = n_a1[cur]
      // Collapse attribute-less `<g>` wrapper unless inside `<switch>` or containing an animation child
      if opts.collapse_groups && a0 == a1 && tlen == 1 && src.code_unit_at(ls) == 0x67 {
        let par = n_parent[cur]
        let parent_is_switch = if par > 0 {
          let pls = local_start_of(src, n_s[par], n_e[par])
          n_e[par] - pls == 6 && slice_eq_lit(src, pls, n_e[par], "switch")
        } else {
          false
        }
        if !parent_is_switch {
          let mut has_anim = false
          let mut ch = n_fc[cur]
          while ch >= 0 {
            if n_kind[ch] == 0 {
              let cls = local_start_of(src, n_s[ch], n_e[ch])
              if is_anim_range(src, cls, n_e[ch]) {
                has_anim = true
                break
              }
            }
            ch = n_ns[ch]
          }
          if !has_anim {
            let mut ch2 = n_fc[cur]
            while ch2 >= 0 {
              rev_buf.push(ch2)
              ch2 = n_ns[ch2]
            }
            while rev_buf.length() > 0 {
              match rev_buf.pop() {
                Some(v) => emit_stack.push(v)
                None => break
              }
            }
            continue
          }
        }
      }
      let is_path = tlen == 4 && src.code_unit_at(ls) == 0x70 && slice_eq_lit(src, ls, te, "path")
      sb.write_byte((0x3C).to_byte())
      write_raw_range(sb, src, ts, te)
      let mut ai = a0
      while ai < a1 {
        let ans = a_ns[ai]
        let ane = a_ne[ai]
        sb.write_byte((0x20).to_byte())
        write_raw_range(sb, src, ans, ane)
        sb.write_string("=\"")
        let avs = a_vs[ai]
        if avs < 0 {
          let aval = pool[-1 - avs]
          if opts.optimize_paths && is_path && ane - ans == 1 && src.code_unit_at(ans) == 0x64 {
            match format_path_str(aval, opts.float_precision, opts.limits) {
              Some(compact) => sb.write_string(compact)
              None => write_xml_escaped(sb, aval, true)
            }
          } else if opts.minify_colors && is_color_attr_range(src, ans, ane) {
            write_xml_escaped(sb, minify_color_value(aval), true)
          } else {
            write_xml_escaped(sb, aval, true)
          }
        } else {
          let ave = a_ve[ai]
          if opts.optimize_paths && is_path && ane - ans == 1 && src.code_unit_at(ans) == 0x64 {
            match format_path_range(src, avs, ave, opts.float_precision, opts.limits) {
              Some(compact) => sb.write_string(compact)
              None => write_xml_escaped_range(sb, src, avs, ave, true)
            }
          } else if opts.minify_colors && is_color_attr_range(src, ans, ane) {
            write_minified_color_range(sb, src, avs, ave)
          } else {
            write_xml_escaped_range(sb, src, avs, ave, true)
          }
        }
        sb.write_byte((0x22).to_byte())
        ai = ai + 1
      }
      if !has_child_arr[cur] {
        sb.write_string("/>")
      } else {
        sb.write_byte((0x3E).to_byte())
        emit_stack.push(-(cur + 1))
        let mut ch2 = n_fc[cur]
        while ch2 >= 0 {
          rev_buf.push(ch2)
          ch2 = n_ns[ch2]
        }
        while rev_buf.length() > 0 {
          match rev_buf.pop() {
            Some(v) => emit_stack.push(v)
            None => break
          }
        }
      }
    }
  }
  Ok(sb.to_string())
}

fn optimize_svg_dom(
  src : String,
  opts : OptimizeOptions,
) -> Result[String, SvgError] {
  let doc = match parse_svg_with_limits(src, opts.limits) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let num_nodes = doc.nodes.length()

  // Pass 1 (O(N) top-down): determine which nodes are inside text/xml:space="preserve" context.
  // Because nodes are allocated in pre-order, parent < id always holds.
  let preserve_ws : Array[Bool] = Array::with_capacity(num_nodes)
  let mut id = 0
  while id < num_nodes {
    let node = doc.nodes[id]
    let mut pws = if node.parent >= 0 { preserve_ws[node.parent] } else { false }
    if !pws {
      match node.kind {
        SvgNodeKind::Element => {
          if is_text_preserving_tag(local_name(node.tag)) || has_xml_space_preserve(node.attrs) {
            pws = true
          }
        }
        _ => ()
      }
    }
    preserve_ws.push(pws)
    id = id + 1
  }

  // Pass 2 (O(N) bottom-up): mark dropped nodes (removable or empty <g>) and surviving children.
  let dropped : Array[Bool] = Array::with_capacity(num_nodes)
  let has_child_arr : Array[Bool] = Array::with_capacity(num_nodes)
  id = 0
  while id < num_nodes {
    dropped.push(false)
    has_child_arr.push(false)
    id = id + 1
  }
  id = num_nodes - 1
  while id >= 0 {
    let node = doc.nodes[id]
    match node.kind {
      SvgNodeKind::Comment => {
        if opts.remove_comments {
          dropped[id] = true
        }
      }
      SvgNodeKind::XmlDecl => {
        if opts.remove_xml_decl && is_xml_decl_pi(node.text) {
          dropped[id] = true
        }
      }
      SvgNodeKind::Text => {
        if !preserve_ws[id] && is_all_svg_ws(node.text) {
          dropped[id] = true
        }
      }
      SvgNodeKind::Element => {
        let ltag = local_name(node.tag)
        if opts.remove_metadata && ltag == "metadata" {
          dropped[id] = true
        } else {
          let mut hc = false
          let mut ci = 0
          let cn = node.children.length()
          while ci < cn {
            if !dropped[node.children[ci]] {
              hc = true
              break
            }
            ci = ci + 1
          }
          has_child_arr[id] = hc
          if opts.remove_empty_groups &&
          ltag == "g" &&
          !hc &&
          !has_filter_attr(node.attrs) {
            dropped[id] = true
          }
        }
      }
    }
    id = id - 1
  }

  // Pass 3 (O(N) iterative emit with single Int stack: >=0 visit node_id, <0 close -(x+1) or -1000000000 for converted "path")
  let sb = StringBuilder::with_capacity(src.length())
  let stack : Array[Int] = Array::with_capacity(32)
  let top = doc.nodes[0].children
  let mut ti = top.length() - 1
  while ti >= 0 {
    stack.push(top[ti])
    ti = ti - 1
  }
  while stack.length() > 0 {
    let entry = match stack.pop() {
      Some(v) => v
      None => break
    }
    if entry < 0 {
      sb.write_string("</")
      if entry == -1000000000 {
        sb.write_string("path")
      } else {
        sb.write_string(doc.nodes[-(entry + 1)].tag)
      }
      sb.write_byte((0x3E).to_byte())
      continue
    }
    let cur = entry
    if dropped[cur] {
      continue
    }
    let node = doc.nodes[cur]
    match node.kind {
      SvgNodeKind::Comment => {
        sb.write_string("<!--")
        sb.write_string(node.text)
        sb.write_string("-->")
      }
      SvgNodeKind::XmlDecl => {
        sb.write_string("<?")
        sb.write_string(node.text)
        sb.write_string("?>")
      }
      SvgNodeKind::Text => {
        if preserve_ws[cur] {
          write_xml_escaped(sb, node.text, false)
        } else {
          write_xml_escaped(sb, ascii_trim(node.text), false)
        }
      }
      SvgNodeKind::Element => {
        let ltag = local_name(node.tag)
        // Collapse attribute-less `<g>` wrapper unless inside `<switch>` or containing an animation child
        if ltag == "g" && opts.collapse_groups && node.attrs.length() == 0 {
          let parent_is_switch = node.parent >= 0 && local_name(doc.nodes[node.parent].tag) == "switch"
          if !parent_is_switch && !has_animation_child(doc, node) {
            let mut ck = node.children.length() - 1
            while ck >= 0 {
              stack.push(node.children[ck])
              ck = ck - 1
            }
            continue
          }
        }
        let mut emit_tag = node.tag
        let mut converted_d = ""
        let mut did_convert_shape = false
        if opts.convert_shapes_to_paths &&
        is_shape_tag(ltag) &&
        ltag != "path" {
          match shape_to_path(ltag, node.attrs) {
            Ok(sp) => {
              emit_tag = "path"
              converted_d = format_path(sp, opts.float_precision)
              did_convert_shape = true
            }
            Err(_) => ()
          }
        }
        let emit_is_path = did_convert_shape || ltag == "path"
        sb.write_byte((0x3C).to_byte())
        sb.write_string(emit_tag)
        let mut ai = 0
        let an = node.attrs.length()
        while ai < an {
          let a = node.attrs[ai]
          if did_convert_shape && should_skip_shape_attr(a.name) {
            ai = ai + 1
            continue
          }
          sb.write_byte((0x20).to_byte())
          sb.write_string(a.name)
          sb.write_string("=\"")
          if opts.optimize_paths && emit_is_path && a.name == "d" {
            match format_path_str(a.value, opts.float_precision, opts.limits) {
              Some(compact) => sb.write_string(compact)
              None => write_xml_escaped(sb, a.value, true)
            }
          } else if opts.minify_colors && is_color_attr(a.name) {
            write_xml_escaped(sb, minify_color_value(a.value), true)
          } else {
            write_xml_escaped(sb, a.value, true)
          }
          sb.write_byte((0x22).to_byte())
          ai = ai + 1
        }
        if did_convert_shape {
          sb.write_string(" d=\"")
          sb.write_string(converted_d)
          sb.write_byte((0x22).to_byte())
        }
        if !has_child_arr[cur] {
          sb.write_string("/>")
        } else {
          sb.write_byte((0x3E).to_byte())
          stack.push(if did_convert_shape { -1000000000 } else { -(cur + 1) })
          let mut ck = node.children.length() - 1
          while ck >= 0 {
            stack.push(node.children[ck])
            ck = ck - 1
          }
        }
      }
    }
  }
  Ok(sb.to_string())
}
