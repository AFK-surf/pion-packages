fn clamp_u8_f64(v : Double) -> Int {
  let r = if v >= 0.0 { (v + 0.5).floor().to_int() } else { 0 }
  if r < 0 {
    0
  } else if r > 255 {
    255
  } else {
    r
  }
}

fn parse_hex_svg_color(hex : String) -> Result[SvgColor, SvgError] {
  let n = hex.length()
  if n != 3 && n != 4 && n != 6 && n != 8 {
    return Err(SvgError::new(SvgErrorKind::InvalidColor, 0, "invalid hex color length"))
  }
  let mut i = 0
  while i < n {
    if hex_val(hex.code_unit_at(i)) < 0 {
      return Err(SvgError::new(SvgErrorKind::InvalidColor, i, "invalid hex digit"))
    }
    i = i + 1
  }
  if n == 3 {
    let r = hex_val(hex.code_unit_at(0)) * 17
    let g = hex_val(hex.code_unit_at(1)) * 17
    let b = hex_val(hex.code_unit_at(2)) * 17
    return Ok(SvgColor::rgb(r, g, b))
  }
  if n == 4 {
    let r = hex_val(hex.code_unit_at(0)) * 17
    let g = hex_val(hex.code_unit_at(1)) * 17
    let b = hex_val(hex.code_unit_at(2)) * 17
    let a = hex_val(hex.code_unit_at(3)) * 17
    return Ok(SvgColor::rgba(r, g, b, a))
  }
  let r = (hex_val(hex.code_unit_at(0)) << 4) | hex_val(hex.code_unit_at(1))
  let g = (hex_val(hex.code_unit_at(2)) << 4) | hex_val(hex.code_unit_at(3))
  let b = (hex_val(hex.code_unit_at(4)) << 4) | hex_val(hex.code_unit_at(5))
  if n == 6 {
    return Ok(SvgColor::rgb(r, g, b))
  }
  let a = (hex_val(hex.code_unit_at(6)) << 4) | hex_val(hex.code_unit_at(7))
  Ok(SvgColor::rgba(r, g, b, a))
}

fn scan_num_and_pct(s : String, pos : Int, end : Int) -> Option[(Double, Bool, Int)] {
  match scan_svg_number(s, pos, end) {
    Some((v, next_i)) => {
      if next_i < end && s.code_unit_at(next_i) == 0x25 {
        Some((v, true, next_i + 1))
      } else {
        Some((v, false, next_i))
      }
    }
    None => None
  }
}

fn skip_color_sep(s : String, pos : Int, end : Int) -> Int {
  let mut i = skip_ws(s, pos, end)
  if i < end {
    let c = s.code_unit_at(i)
    if c == 0x2C || c == 0x2F {
      i = i + 1
      i = skip_ws(s, i, end)
    }
  }
  i
}

fn hue_to_rgb(p : Double, q : Double, t_in : Double) -> Double {
  let mut t = t_in
  if t < 0.0 {
    t = t + 1.0
  }
  if t > 1.0 {
    t = t - 1.0
  }
  if t < 1.0 / 6.0 {
    p + (q - p) * 6.0 * t
  } else if t < 0.5 {
    q
  } else if t < 2.0 / 3.0 {
    p + (q - p) * (2.0 / 3.0 - t) * 6.0
  } else {
    p
  }
}

fn parse_func_color(lower : String) -> Result[SvgColor, SvgError] {
  let n = lower.length()
  let mut lp = -1
  let mut i = 0
  while i < n {
    if lower.code_unit_at(i) == 0x28 {
      lp = i
      break
    }
    i = i + 1
  }
  if lp < 0 || lower.code_unit_at(n - 1) != 0x29 {
    return Err(SvgError::new(SvgErrorKind::InvalidColor, 0, "malformed functional color"))
  }
  let fn_name = lower.slice(0, lp)
  let end = n - 1
  let p0 = skip_ws(lower, lp + 1, end)
  if fn_name == "rgb" || fn_name == "rgba" {
    let (r_val, r_pct, i1) = match scan_num_and_pct(lower, p0, end) {
      Some(v) => v
      None => return Err(SvgError::new(SvgErrorKind::InvalidColor, p0, "expected r channel"))
    }
    let p1 = skip_color_sep(lower, i1, end)
    let (g_val, g_pct, i2) = match scan_num_and_pct(lower, p1, end) {
      Some(v) => v
      None => return Err(SvgError::new(SvgErrorKind::InvalidColor, p1, "expected g channel"))
    }
    let p2 = skip_color_sep(lower, i2, end)
    let (b_val, b_pct, i3) = match scan_num_and_pct(lower, p2, end) {
      Some(v) => v
      None => return Err(SvgError::new(SvgErrorKind::InvalidColor, p2, "expected b channel"))
    }
    let r = clamp_u8_f64(if r_pct { r_val * 255.0 / 100.0 } else { r_val })
    let g = clamp_u8_f64(if g_pct { g_val * 255.0 / 100.0 } else { g_val })
    let b = clamp_u8_f64(if b_pct { b_val * 255.0 / 100.0 } else { b_val })
    let ws3 = skip_ws(lower, i3, end)
    let mut a = 255
    if ws3 < end {
      let p3 = skip_color_sep(lower, ws3, end)
      if p3 >= end {
        return Err(SvgError::new(SvgErrorKind::InvalidColor, ws3, "trailing separator in rgb()"))
      }
      let (a_val, a_pct, i4) = match scan_num_and_pct(lower, p3, end) {
        Some(v) => v
        None => return Err(SvgError::new(SvgErrorKind::InvalidColor, p3, "expected alpha channel"))
      }
      let af = if a_pct { a_val / 100.0 } else { a_val }
      a = clamp_u8_f64(af * 255.0)
      if skip_ws(lower, i4, end) != end {
        return Err(SvgError::new(SvgErrorKind::InvalidColor, i4, "trailing tokens in rgb()"))
      }
    }
    return Ok(SvgColor::rgba(r, g, b, a))
  }
  if fn_name == "hsl" || fn_name == "hsla" {
    let (h_raw, i1) = match scan_svg_number(lower, p0, end) {
      Some(v) => v
      None => return Err(SvgError::new(SvgErrorKind::InvalidColor, p0, "expected hue"))
    }
    // Optional angle unit (deg/rad/grad/turn)
    let mut i1u = i1
    while i1u < end && is_ident_char(lower.code_unit_at(i1u)) {
      i1u = i1u + 1
    }
    let mut h_deg = h_raw
    if i1u > i1 {
      let unit = lower.slice(i1, i1u)
      if unit == "turn" {
        h_deg = h_raw * 360.0
      } else if unit == "rad" {
        h_deg = h_raw * 180.0 / pi_val
      } else if unit == "grad" {
        h_deg = h_raw * 0.9
      } else if unit != "deg" {
        return Err(SvgError::new(SvgErrorKind::InvalidColor, i1, "unknown hue unit"))
      }
    }
    let p1 = skip_color_sep(lower, i1u, end)
    let (s_val, _, i2) = match scan_num_and_pct(lower, p1, end) {
      Some(v) => v
      None => return Err(SvgError::new(SvgErrorKind::InvalidColor, p1, "expected saturation"))
    }
    let p2 = skip_color_sep(lower, i2, end)
    let (l_val, _, i3) = match scan_num_and_pct(lower, p2, end) {
      Some(v) => v
      None => return Err(SvgError::new(SvgErrorKind::InvalidColor, p2, "expected lightness"))
    }
    let mut a = 255
    let ws3 = skip_ws(lower, i3, end)
    if ws3 < end {
      let p3 = skip_color_sep(lower, ws3, end)
      if p3 >= end {
        return Err(SvgError::new(SvgErrorKind::InvalidColor, ws3, "trailing separator in hsl()"))
      }
      let (a_val, a_pct, i4) = match scan_num_and_pct(lower, p3, end) {
        Some(v) => v
        None => return Err(SvgError::new(SvgErrorKind::InvalidColor, p3, "expected alpha"))
      }
      let af = if a_pct { a_val / 100.0 } else { a_val }
      a = clamp_u8_f64(af * 255.0)
      if skip_ws(lower, i4, end) != end {
        return Err(SvgError::new(SvgErrorKind::InvalidColor, i4, "trailing tokens in hsl()"))
      }
    }
    let mut h = (h_deg - (h_deg / 360.0).floor() * 360.0) / 360.0
    if h < 0.0 {
      h = h + 1.0
    }
    let s = if s_val < 0.0 { 0.0 } else if s_val > 100.0 { 1.0 } else { s_val / 100.0 }
    let l = if l_val < 0.0 { 0.0 } else if l_val > 100.0 { 1.0 } else { l_val / 100.0 }
    let (rf, gf, bf) = if s == 0.0 {
      (l, l, l)
    } else {
      let q = if l < 0.5 { l * (1.0 + s) } else { l + s - l * s }
      let p = 2.0 * l - q
      (
        hue_to_rgb(p, q, h + 1.0 / 3.0),
        hue_to_rgb(p, q, h),
        hue_to_rgb(p, q, h - 1.0 / 3.0),
      )
    }
    return Ok(
      SvgColor::rgba(
        clamp_u8_f64(rf * 255.0),
        clamp_u8_f64(gf * 255.0),
        clamp_u8_f64(bf * 255.0),
        a,
      ),
    )
  }
  Err(SvgError::new(SvgErrorKind::InvalidColor, 0, "unknown color function: " + fn_name))
}

///| Parse an SVG color string.
pub fn parse_color(s : String) -> Result[SvgColor, SvgError] {
  let trimmed = ascii_trim(s)
  if trimmed.length() == 0 {
    return Err(SvgError::new(SvgErrorKind::InvalidColor, 0, "empty color"))
  }
  if trimmed.code_unit_at(0) == 0x23 {
    return parse_hex_svg_color(trimmed.slice(1, trimmed.length()))
  }
  let lower = ascii_lower(trimmed)
  if lower == "transparent" {
    return Ok(SvgColor::rgba(0, 0, 0, 0))
  }
  match lookup_svg_color(lower) {
    Some(rgb) => {
      return Ok(SvgColor::rgb((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF))
    }
    None => ()
  }
  if lower.contains("(") {
    return parse_func_color(lower)
  }
  Err(SvgError::new(SvgErrorKind::InvalidColor, 0, "unknown color: " + trimmed))
}

///| Parse an SVG paint string (`none`, `currentColor`, `url(...)`, or color).
pub fn parse_paint(s : String) -> Result[SvgPaint, SvgError] {
  let trimmed = ascii_trim(s)
  let lower = ascii_lower(trimmed)
  if lower == "none" {
    return Ok(SvgPaint::None)
  }
  if lower == "currentcolor" {
    return Ok(SvgPaint::CurrentColor)
  }
  if lower.length() >= 5 && lower.slice(0, 4) == "url(" {
    let mut end = trimmed.length() - 1
    while end > 4 && trimmed.code_unit_at(end) != 0x29 {
      end = end - 1
    }
    if trimmed.code_unit_at(end) == 0x29 {
      let mut inner = ascii_trim(trimmed.slice(4, end))
      if inner.length() >= 2 {
        let q0 = inner.code_unit_at(0)
        let q1 = inner.code_unit_at(inner.length() - 1)
        if (q0 == 0x22 && q1 == 0x22) || (q0 == 0x27 && q1 == 0x27) {
          inner = inner.slice(1, inner.length() - 1)
        }
      }
      return Ok(SvgPaint::Url(inner))
    }
  }
  match parse_color(trimmed) {
    Ok(c) => Ok(SvgPaint::Color(c))
    Err(e) => Err(e)
  }
}

///| Parse an SVG length value into user-unit pixels (`px`, `pt`, `pc`, `mm`, `cm`, `in`, or unitless).
pub fn parse_length(s : String) -> Result[Double, SvgError] {
  let trimmed = ascii_trim(s)
  let n = trimmed.length()
  let (v, i1) = match scan_svg_number(trimmed, 0, n) {
    Some(x) => x
    None => return Err(SvgError::new(SvgErrorKind::InvalidNumber, 0, "invalid SVG length"))
  }
  let unit = ascii_lower(ascii_trim(trimmed.slice(i1, n)))
  if unit == "" || unit == "px" {
    Ok(v)
  } else if unit == "pt" {
    Ok(v * 96.0 / 72.0)
  } else if unit == "pc" {
    Ok(v * 16.0)
  } else if unit == "in" {
    Ok(v * 96.0)
  } else if unit == "cm" {
    Ok(v * 96.0 / 2.54)
  } else if unit == "mm" {
    Ok(v * 96.0 / 25.4)
  } else if unit == "%" {
    Ok(v)
  } else {
    Err(SvgError::new(SvgErrorKind::InvalidNumber, i1, "unknown SVG length unit: " + unit))
  }
}
