///| SVG Color, Paint, and Length parsing (hex3/4/6/8, rgb/rgba, hsl/hsla, all 148 named colors).

///| RGBA 8-bit color (`0..255` per channel).
pub val struct SvgColor {
  pub r : Int
  pub g : Int
  pub b : Int
  pub a : Int
}

///|
pub fn SvgColor::rgb(r : Int, g : Int, b : Int) -> SvgColor {
  SvgColor::{ r: r, g: g, b: b, a: 255 }
}

///|
pub fn SvgColor::rgba(r : Int, g : Int, b : Int, a : Int) -> SvgColor {
  SvgColor::{ r: r, g: g, b: b, a: a }
}

///| Format color as compact hex string (`#rgb`, `#rrggbb`, or `#rrggbbaa`).
pub fn SvgColor::to_hex(self : SvgColor) -> String {
  let _ = self
  ""
}

///| SVG paint value (`none`, `currentColor`, solid color, or `url(#id)`).
pub enum SvgPaint {
  None
  CurrentColor
  Color(SvgColor)
  Url(String)
}

///| Look up a lowercase SVG 1.1 / CSS4 named color (all 148 entries), returning `Some(0xRRGGBB)`.
pub fn lookup_svg_color(name : String) -> Option[Int] {
  let _ = name
  None
}

///| Parse an SVG color string.
pub fn parse_color(s : String) -> Result[SvgColor, SvgError] {
  let _ = s
  Err(SvgError::new(SvgErrorKind::Unimplemented, 0, "unimplemented"))
}

///| Parse an SVG paint string (`none`, `currentColor`, `url(...)`, or color).
pub fn parse_paint(s : String) -> Result[SvgPaint, SvgError] {
  let _ = s
  Err(SvgError::new(SvgErrorKind::Unimplemented, 0, "unimplemented"))
}

///| Parse an SVG length value into user-unit pixels (`px`, `pt`, `pc`, `mm`, `cm`, `in`, or unitless).
pub fn parse_length(s : String) -> Result[Double, SvgError] {
  let _ = s
  Err(SvgError::new(SvgErrorKind::Unimplemented, 0, "unimplemented"))
}
