///| SVG Color, Paint, and Length parsing (hex3/4/6/8, rgb/rgba, hsl/hsla, all 148 named colors).

///| RGBA 8-bit color (`0..255` per channel).
pub val struct SvgColor {
  pub r : Int
  pub g : Int
  pub b : Int
  pub a : Int
}

///|
pub fn SvgColor::rgb(r : Int, g : Int, b : Int) -> SvgColor {
  SvgColor::{ r: r, g: g, b: b, a: 255 }
}

///|
pub fn SvgColor::rgba(r : Int, g : Int, b : Int, a : Int) -> SvgColor {
  SvgColor::{ r: r, g: g, b: b, a: a }
}

fn hex_nibble(n : Int) -> Byte {
  if n < 10 {
    (0x30 + n).to_byte()
  } else {
    (0x61 + n - 10).to_byte()
  }
}

///| Format color as compact hex string (`#rgb`, `#rrggbb`, or `#rrggbbaa`).
pub fn SvgColor::to_hex(self : SvgColor) -> String {
  let sb = StringBuilder::new()
  sb.write_byte((0x23).to_byte())
  let r_hi = (self.r >> 4) & 0xF
  let r_lo = self.r & 0xF
  let g_hi = (self.g >> 4) & 0xF
  let g_lo = self.g & 0xF
  let b_hi = (self.b >> 4) & 0xF
  let b_lo = self.b & 0xF
  let a_hi = (self.a >> 4) & 0xF
  let a_lo = self.a & 0xF
  if self.a == 255 {
    if r_hi == r_lo && g_hi == g_lo && b_hi == b_lo {
      sb.write_byte(hex_nibble(r_hi))
      sb.write_byte(hex_nibble(g_hi))
      sb.write_byte(hex_nibble(b_hi))
    } else {
      sb.write_byte(hex_nibble(r_hi))
      sb.write_byte(hex_nibble(r_lo))
      sb.write_byte(hex_nibble(g_hi))
      sb.write_byte(hex_nibble(g_lo))
      sb.write_byte(hex_nibble(b_hi))
      sb.write_byte(hex_nibble(b_lo))
    }
  } else if r_hi == r_lo && g_hi == g_lo && b_hi == b_lo && a_hi == a_lo {
    sb.write_byte(hex_nibble(r_hi))
    sb.write_byte(hex_nibble(g_hi))
    sb.write_byte(hex_nibble(b_hi))
    sb.write_byte(hex_nibble(a_hi))
  } else {
    sb.write_byte(hex_nibble(r_hi))
    sb.write_byte(hex_nibble(r_lo))
    sb.write_byte(hex_nibble(g_hi))
    sb.write_byte(hex_nibble(g_lo))
    sb.write_byte(hex_nibble(b_hi))
    sb.write_byte(hex_nibble(b_lo))
    sb.write_byte(hex_nibble(a_hi))
    sb.write_byte(hex_nibble(a_lo))
  }
  sb.to_string()
}

///| SVG paint value (`none`, `currentColor`, solid color, or `url(#id)`).
pub enum SvgPaint {
  None
  CurrentColor
  Color(SvgColor)
  Url(String)
}

