///| 2D affine transforms (`Transform2D`) and `viewBox` + `preserveAspectRatio` mapping.

///| SVG 2D affine transformation matrix `[a c e; b d f; 0 0 1]`.
pub val struct Transform2D {
  pub a : Double
  pub b : Double
  pub c : Double
  pub d : Double
  pub e : Double
  pub f : Double
}

///|
pub fn Transform2D::identity() -> Transform2D {
  Transform2D::{ a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }
}

///|
pub fn Transform2D::new(
  a : Double,
  b : Double,
  c : Double,
  d : Double,
  e : Double,
  f : Double,
) -> Transform2D {
  Transform2D::{ a: a, b: b, c: c, d: d, e: e, f: f }
}

///|
pub fn Transform2D::translate(tx : Double, ty : Double) -> Transform2D {
  Transform2D::{ a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: tx, f: ty }
}

///|
pub fn Transform2D::scale(sx : Double, sy : Double) -> Transform2D {
  Transform2D::{ a: sx, b: 0.0, c: 0.0, d: sy, e: 0.0, f: 0.0 }
}

///|
pub fn Transform2D::rotate(angle_deg : Double) -> Transform2D {
  let (s, c) = sin_cos_f64(deg_to_rad(angle_deg))
  Transform2D::{ a: c, b: s, c: -s, d: c, e: 0.0, f: 0.0 }
}

///|
pub fn Transform2D::rotate_around(
  angle_deg : Double,
  cx : Double,
  cy : Double,
) -> Transform2D {
  let t1 = Transform2D::translate(cx, cy)
  let r = Transform2D::rotate(angle_deg)
  let t2 = Transform2D::translate(-cx, -cy)
  t1.multiply(r).multiply(t2)
}

///|
pub fn Transform2D::skew_x(angle_deg : Double) -> Transform2D {
  let t = tan_f64(deg_to_rad(angle_deg))
  Transform2D::{ a: 1.0, b: 0.0, c: t, d: 1.0, e: 0.0, f: 0.0 }
}

///|
pub fn Transform2D::skew_y(angle_deg : Double) -> Transform2D {
  let t = tan_f64(deg_to_rad(angle_deg))
  Transform2D::{ a: 1.0, b: t, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }
}

///|
pub fn Transform2D::multiply(
  self : Transform2D,
  other : Transform2D,
) -> Transform2D {
  Transform2D::{
    a: self.a * other.a + self.c * other.b,
    b: self.b * other.a + self.d * other.b,
    c: self.a * other.c + self.c * other.d,
    d: self.b * other.c + self.d * other.d,
    e: self.a * other.e + self.c * other.f + self.e,
    f: self.b * other.e + self.d * other.f + self.f,
  }
}

///|
pub fn Transform2D::determinant(self : Transform2D) -> Double {
  self.a * self.d - self.b * self.c
}

///|
pub fn Transform2D::invert(self : Transform2D) -> Option[Transform2D] {
  let det = self.determinant()
  let norm_sq = self.a * self.a + self.b * self.b + self.c * self.c + self.d * self.d
  if !is_finite(det) || det == 0.0 || !is_finite(norm_sq) || norm_sq == 0.0 || det.abs() <= 1e-15 * norm_sq {
    return None
  }
  let inv = 1.0 / det
  let ra = self.d * inv
  let rb = -self.b * inv
  let rc = -self.c * inv
  let rd = self.a * inv
  let re = (self.c * self.f - self.d * self.e) * inv
  let rf = (self.b * self.e - self.a * self.f) * inv
  if !is_finite(ra) || !is_finite(rb) || !is_finite(rc) || !is_finite(rd) || !is_finite(re) || !is_finite(rf) {
    return None
  }
  Some(Transform2D::{ a: ra, b: rb, c: rc, d: rd, e: re, f: rf })
}

///|
pub fn Transform2D::apply_point(self : Transform2D, p : Point) -> Point {
  Point::{
    x: self.a * p.x + self.c * p.y + self.e,
    y: self.b * p.x + self.d * p.y + self.f,
  }
}

///|
pub fn Transform2D::is_identity(self : Transform2D) -> Bool {
  (self.a - 1.0).abs() < 1e-12 &&
  self.b.abs() < 1e-12 &&
  self.c.abs() < 1e-12 &&
  (self.d - 1.0).abs() < 1e-12 &&
  self.e.abs() < 1e-12 &&
  self.f.abs() < 1e-12
}

///| SVG `preserveAspectRatio` alignment mode.
pub enum AspectAlign {
  None
  XMinYMin
  XMidYMin
  XMaxYMin
  XMinYMid
  XMidYMid
  XMaxYMid
  XMinYMax
  XMidYMax
  XMaxYMax
}

///| SVG `preserveAspectRatio` meet/slice mode.
pub enum MeetOrSlice {
  Meet
  Slice
}

///| Parsed `preserveAspectRatio` value.
pub val struct PreserveAspectRatio {
  pub align : AspectAlign
  pub meet_or_slice : MeetOrSlice
}

///|
pub fn PreserveAspectRatio::default() -> PreserveAspectRatio {
  PreserveAspectRatio::{
    align: AspectAlign::XMidYMid,
    meet_or_slice: MeetOrSlice::Meet,
  }
}

#verify
pub fn is_ident_char(c : Int) -> Bool {
  (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A)
}

///| Parse an SVG `transform` attribute string.
pub fn parse_transform(s : String) -> Result[Transform2D, SvgError] {
  let n = s.length()
  let mut i = skip_ws(s, 0, n)
  let mut acc = Transform2D::identity()
  while i < n {
    let name_start = i
    while i < n && is_ident_char(s.code_unit_at(i)) {
      i = i + 1
    }
    if i == name_start {
      return Err(
        SvgError::new(
          SvgErrorKind::InvalidTransform,
          i,
          "expected transform function name",
        ),
      )
    }
    let name = s.slice(name_start, i)
    i = skip_ws(s, i, n)
    if i >= n || s.code_unit_at(i) != 0x28 {
      return Err(
        SvgError::new(
          SvgErrorKind::InvalidTransform,
          i,
          "expected '(' after transform function",
        ),
      )
    }
    i = i + 1
    let args : Array[Double] = []
    while true {
      i = skip_ws(s, i, n)
      if i >= n {
        return Err(
          SvgError::new(
            SvgErrorKind::InvalidTransform,
            i,
            "unclosed transform argument list",
          ),
        )
      }
      if s.code_unit_at(i) == 0x29 {
        i = i + 1
        break
      }
      if args.length() > 0 {
        i = skip_comma_wsp(s, i, n)
        if i < n && s.code_unit_at(i) == 0x29 {
          i = i + 1
          break
        }
      }
      match scan_svg_number(s, i, n) {
        Some((v, next_i)) => {
          args.push(v)
          i = next_i
        }
        None => {
          return Err(
            SvgError::new(
              SvgErrorKind::InvalidTransform,
              i,
              "invalid number in transform",
            ),
          )
        }
      }
    }
    let t = if name == "matrix" {
      if args.length() != 6 {
        return Err(
          SvgError::new(
            SvgErrorKind::InvalidTransform,
            name_start,
            "matrix() requires 6 arguments",
          ),
        )
      }
      Transform2D::new(args[0], args[1], args[2], args[3], args[4], args[5])
    } else if name == "translate" {
      if args.length() == 1 {
        Transform2D::translate(args[0], 0.0)
      } else if args.length() == 2 {
        Transform2D::translate(args[0], args[1])
      } else {
        return Err(
          SvgError::new(
            SvgErrorKind::InvalidTransform,
            name_start,
            "translate() requires 1 or 2 arguments",
          ),
        )
      }
    } else if name == "scale" {
      if args.length() == 1 {
        Transform2D::scale(args[0], args[0])
      } else if args.length() == 2 {
        Transform2D::scale(args[0], args[1])
      } else {
        return Err(
          SvgError::new(
            SvgErrorKind::InvalidTransform,
            name_start,
            "scale() requires 1 or 2 arguments",
          ),
        )
      }
    } else if name == "rotate" {
      if args.length() == 1 {
        Transform2D::rotate(args[0])
      } else if args.length() == 3 {
        Transform2D::rotate_around(args[0], args[1], args[2])
      } else {
        return Err(
          SvgError::new(
            SvgErrorKind::InvalidTransform,
            name_start,
            "rotate() requires 1 or 3 arguments",
          ),
        )
      }
    } else if name == "skewX" {
      if args.length() != 1 {
        return Err(
          SvgError::new(
            SvgErrorKind::InvalidTransform,
            name_start,
            "skewX() requires 1 argument",
          ),
        )
      }
      Transform2D::skew_x(args[0])
    } else if name == "skewY" {
      if args.length() != 1 {
        return Err(
          SvgError::new(
            SvgErrorKind::InvalidTransform,
            name_start,
            "skewY() requires 1 argument",
          ),
        )
      }
      Transform2D::skew_y(args[0])
    } else {
      return Err(
        SvgError::new(
          SvgErrorKind::InvalidTransform,
          name_start,
          "unknown transform function: " + name,
        ),
      )
    }
    acc = acc.multiply(t)
    i = skip_comma_wsp(s, i, n)
  }
  Ok(acc)
}

///| Transform normalized cubic Bézier segments by a 2D affine matrix.
pub fn transform_cubics(
  cubics : Array[CubicSegment],
  t : Transform2D,
) -> Array[CubicSegment] {
  if t.is_identity() {
    return cubics
  }
  let out : Array[CubicSegment] = []
  let n = cubics.length()
  let mut i = 0
  while i < n {
    match cubics[i] {
      CubicSegment::MoveTo(x, y) => {
        let p = t.apply_point(Point::new(x, y))
        out.push(CubicSegment::MoveTo(p.x, p.y))
      }
      CubicSegment::LineTo(x, y) => {
        let p = t.apply_point(Point::new(x, y))
        out.push(CubicSegment::LineTo(p.x, p.y))
      }
      CubicSegment::CurveTo(x1, y1, x2, y2, x, y) => {
        let p1 = t.apply_point(Point::new(x1, y1))
        let p2 = t.apply_point(Point::new(x2, y2))
        let p = t.apply_point(Point::new(x, y))
        out.push(CubicSegment::CurveTo(p1.x, p1.y, p2.x, p2.y, p.x, p.y))
      }
      CubicSegment::ClosePath => out.push(CubicSegment::ClosePath)
    }
    i = i + 1
  }
  out
}

///| Transform an `SvgPath` by a 2D affine matrix (converts to exact cubic segments).
pub fn transform_path(path : SvgPath, t : Transform2D) -> SvgPath {
  if t.is_identity() {
    return path
  }
  let cubics = transform_cubics(to_cubic_beziers(path), t)
  let segs : Array[PathSegment] = []
  let n = cubics.length()
  let mut i = 0
  while i < n {
    match cubics[i] {
      CubicSegment::MoveTo(x, y) => segs.push(PathSegment::MoveTo(true, x, y))
      CubicSegment::LineTo(x, y) => segs.push(PathSegment::LineTo(true, x, y))
      CubicSegment::CurveTo(x1, y1, x2, y2, x, y) => {
        segs.push(PathSegment::CurveTo(true, x1, y1, x2, y2, x, y))
      }
      CubicSegment::ClosePath => segs.push(PathSegment::ClosePath(true))
    }
    i = i + 1
  }
  SvgPath::{ segments: segs }
}

///| Parse an SVG `viewBox` attribute string (`min-x min-y width height`).
pub fn parse_viewbox(s : String) -> Result[ViewBox, SvgError] {
  let n = s.length()
  let i0 = skip_ws(s, 0, n)
  let (x, i1) = match scan_svg_number(s, i0, n) {
    Some(v) => v
    None => return Err(SvgError::new(SvgErrorKind::InvalidViewBox, i0, "expected viewBox x"))
  }
  let (y, i2) = match scan_svg_number(s, skip_comma_wsp(s, i1, n), n) {
    Some(v) => v
    None => return Err(SvgError::new(SvgErrorKind::InvalidViewBox, i1, "expected viewBox y"))
  }
  let (w, i3) = match scan_svg_number(s, skip_comma_wsp(s, i2, n), n) {
    Some(v) => v
    None => return Err(SvgError::new(SvgErrorKind::InvalidViewBox, i2, "expected viewBox width"))
  }
  let (h, i4) = match scan_svg_number(s, skip_comma_wsp(s, i3, n), n) {
    Some(v) => v
    None => return Err(SvgError::new(SvgErrorKind::InvalidViewBox, i3, "expected viewBox height"))
  }
  let i5 = skip_ws(s, i4, n)
  if i5 != n || w <= 0.0 || h <= 0.0 {
    return Err(
      SvgError::new(
        SvgErrorKind::InvalidViewBox,
        i5,
        "invalid viewBox dimensions or trailing tokens",
      ),
    )
  }
  Ok(ViewBox::new(x, y, w, h))
}

fn split_ws_tokens(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    i = skip_ws(s, i, n)
    if i >= n {
      break
    }
    let start = i
    while i < n && !is_svg_ws(s.code_unit_at(i)) {
      i = i + 1
    }
    out.push(s.slice(start, i))
  }
  out
}

///| Parse an SVG `preserveAspectRatio` attribute string.
pub fn parse_preserve_aspect_ratio(
  s : String,
) -> Result[PreserveAspectRatio, SvgError] {
  let toks = split_ws_tokens(s)
  if toks.length() == 0 {
    return Err(
      SvgError::new(
        SvgErrorKind::InvalidViewBox,
        0,
        "empty preserveAspectRatio",
      ),
    )
  }
  let mut idx = 0
  if toks[idx] == "defer" {
    idx = idx + 1
    if idx >= toks.length() {
      return Err(
        SvgError::new(
          SvgErrorKind::InvalidViewBox,
          0,
          "missing alignment after defer",
        ),
      )
    }
  }
  let align = match toks[idx] {
    "none" => AspectAlign::None
    "xMinYMin" => AspectAlign::XMinYMin
    "xMidYMin" => AspectAlign::XMidYMin
    "xMaxYMin" => AspectAlign::XMaxYMin
    "xMinYMid" => AspectAlign::XMinYMid
    "xMidYMid" => AspectAlign::XMidYMid
    "xMaxYMid" => AspectAlign::XMaxYMid
    "xMinYMax" => AspectAlign::XMinYMax
    "xMidYMax" => AspectAlign::XMidYMax
    "xMaxYMax" => AspectAlign::XMaxYMax
    _ => {
      return Err(
        SvgError::new(
          SvgErrorKind::InvalidViewBox,
          0,
          "unknown preserveAspectRatio align: " + toks[idx],
        ),
      )
    }
  }
  idx = idx + 1
  let mut mos = MeetOrSlice::Meet
  if idx < toks.length() {
    if toks[idx] == "meet" {
      mos = MeetOrSlice::Meet
    } else if toks[idx] == "slice" {
      mos = MeetOrSlice::Slice
    } else {
      return Err(
        SvgError::new(
          SvgErrorKind::InvalidViewBox,
          0,
          "unknown meetOrSlice: " + toks[idx],
        ),
      )
    }
    idx = idx + 1
  }
  if idx != toks.length() {
    return Err(
      SvgError::new(
        SvgErrorKind::InvalidViewBox,
        0,
        "trailing tokens in preserveAspectRatio",
      ),
    )
  }
  Ok(PreserveAspectRatio::{ align: align, meet_or_slice: mos })
}

///| Compute the `viewBox` -> viewport affine transformation matrix.
pub fn viewbox_transform(
  vb : ViewBox,
  viewport_w : Double,
  viewport_h : Double,
  par : PreserveAspectRatio,
) -> Transform2D {
  if vb.width <= 0.0 || vb.height <= 0.0 || viewport_w <= 0.0 || viewport_h <= 0.0 {
    return Transform2D::identity()
  }
  let mut sx = viewport_w / vb.width
  let mut sy = viewport_h / vb.height
  match par.align {
    AspectAlign::None => {
      return Transform2D::new(sx, 0.0, 0.0, sy, -vb.x * sx, -vb.y * sy)
    }
    _ => ()
  }
  let s = match par.meet_or_slice {
    MeetOrSlice::Meet => if sx < sy { sx } else { sy }
    MeetOrSlice::Slice => if sx > sy { sx } else { sy }
  }
  sx = s
  sy = s
  let extra_x = viewport_w - vb.width * sx
  let extra_y = viewport_h - vb.height * sy
  let tx_align = match par.align {
    AspectAlign::XMidYMin | AspectAlign::XMidYMid | AspectAlign::XMidYMax => {
      extra_x * 0.5
    }
    AspectAlign::XMaxYMin | AspectAlign::XMaxYMid | AspectAlign::XMaxYMax => {
      extra_x
    }
    _ => 0.0
  }
  let ty_align = match par.align {
    AspectAlign::XMinYMid | AspectAlign::XMidYMid | AspectAlign::XMaxYMid => {
      extra_y * 0.5
    }
    AspectAlign::XMinYMax | AspectAlign::XMidYMax | AspectAlign::XMaxYMax => {
      extra_y
    }
    _ => 0.0
  }
  Transform2D::new(
    sx,
    0.0,
    0.0,
    sy,
    tx_align - vb.x * sx,
    ty_align - vb.y * sy,
  )
}
