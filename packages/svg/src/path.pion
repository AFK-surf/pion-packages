///| W3C SVG 1.1/2 Path Data (`d`) parser, normalizer, arc-to-cubic converter, and compact serializer.

///| A single SVG path command segment (first `Bool` is `abs`, true for uppercase commands).
pub enum PathSegment {
  MoveTo(Bool, Double, Double)
  LineTo(Bool, Double, Double)
  HorizontalLineTo(Bool, Double)
  VerticalLineTo(Bool, Double)
  CurveTo(Bool, Double, Double, Double, Double, Double, Double)
  SmoothCurveTo(Bool, Double, Double, Double, Double)
  Quadratic(Bool, Double, Double, Double, Double)
  SmoothQuadratic(Bool, Double, Double)
  EllipticalArc(Bool, Double, Double, Double, Bool, Bool, Double, Double)
  ClosePath(Bool)
}

///| Parsed SVG path command list.
pub struct SvgPath {
  pub segments : Array[PathSegment]
}

///|
pub fn SvgPath::new(segments : Array[PathSegment]) -> SvgPath {
  SvgPath::{ segments: segments }
}

///| Normalized absolute cubic Bézier path segment.
pub enum CubicSegment {
  MoveTo(Double, Double)
  LineTo(Double, Double)
  CurveTo(Double, Double, Double, Double, Double, Double)
  ClosePath
}

// 128-entry ASCII lookup table for the 20 SVG path command letters.
let path_cmd_tbl : Array[Bool] = [
  false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false,
  false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false,
  false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false,
  false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false,
  // 64..79: @ A B C D E F G H I J K L M N O
  false, true, false, true, false, false, false, false, true, false, false, false, true, true, false, false,
  // 80..95: P Q R S T U V W X Y Z [ \ ] ^ _
  false, true, false, true, true, false, true, false, false, false, true, false, false, false, false, false,
  // 96..111: ` a b c d e f g h i j k l m n o
  false, true, false, true, false, false, false, false, true, false, false, false, true, true, false, false,
  // 112..127: p q r s t u v w x y z { | } ~ DEL
  false, true, false, true, true, false, true, false, false, false, true, false, false, false, false, false,
]

fn is_path_cmd(c : Int) -> Bool {
  c >= 0 && c < 128 && path_cmd_tbl[c]
}

#verify
pub fn is_number_start(c : Int) -> Bool {
  (c >= 0x30 && c <= 0x39) || c == 0x2D || c == 0x2B || c == 0x2E
}

///| True if `c` is an SVG MoveTo command (`M` or `m`).
#verify
pub fn is_path_moveto(c : Int) -> Bool {
  c == 0x4D || c == 0x6D
}

///| True if `c` is an SVG ClosePath command (`Z` or `z`).
#verify
pub fn is_path_closepath(c : Int) -> Bool {
  c == 0x5A || c == 0x7A
}

fn scan_arc_flag(s : String, pos : Int, end : Int) -> Option[(Bool, Int)] {
  if pos >= end {
    return None
  }
  let c = s.code_unit_at(pos)
  if c == 0x30 {
    Some((false, pos + 1))
  } else if c == 0x31 {
    Some((true, pos + 1))
  } else {
    None
  }
}

///| Parse an SVG path data string (`d`) with default limits.
pub fn parse_path(d : String) -> Result[SvgPath, SvgError] {
  parse_path_with_limits(d, SvgLimits::default())
}

fn parse_path_internal(
  d : String,
  limits : SvgLimits,
  lenient : Bool,
) -> Result[SvgPath, SvgError] {
  let n = d.length()
  if n > limits.max_input_bytes {
    return Err(
      SvgError::new(
        SvgErrorKind::LimitExceeded,
        0,
        "path input exceeds max_input_bytes",
      ),
    )
  }
  let segs : Array[PathSegment] = []
  let mut i = skip_ws(d, 0, n)
  if i >= n {
    return Ok(SvgPath::{ segments: segs })
  }
  // SVG spec: first command must be M or m
  let first = d.code_unit_at(i)
  if !is_path_moveto(first) {
    if lenient {
      return Ok(SvgPath::{ segments: segs })
    }
    return Err(
      SvgError::new(
        SvgErrorKind::InvalidPath,
        i,
        "path data must start with MoveTo (M/m)",
      ),
    )
  }
  let mut cmd = 0
  while i < n {
    i = skip_ws(d, i, n)
    if i >= n {
      break
    }
    let c = d.code_unit_at(i)
    if is_path_cmd(c) {
      cmd = c
      i = i + 1
    } else if cmd == 0 {
      if lenient {
        return Ok(SvgPath::{ segments: segs })
      }
      return Err(
        SvgError::new(
          SvgErrorKind::InvalidPath,
          i,
          "expected SVG path command",
        ),
      )
    }
    if is_path_closepath(cmd) {
      if segs.length() >= limits.max_path_segments {
        return Err(
          SvgError::new(
            SvgErrorKind::LimitExceeded,
            i,
            "path exceeds max_path_segments",
          ),
        )
      }
      segs.push(PathSegment::ClosePath(cmd == 0x5A))
      cmd = 0
      continue
    }
    // Parse at least one coordinate tuple for this command, then implicit repeats
    let mut first_tuple = true
    while true {
      i = if first_tuple {
        skip_ws(d, i, n)
      } else {
        skip_comma_wsp(d, i, n)
      }
      if !first_tuple {
        if i >= n || !is_number_start(d.code_unit_at(i)) {
          break
        }
      }
      if i >= n {
        if lenient {
          return Ok(SvgPath::{ segments: segs })
        }
        return Err(
          SvgError::new(
            SvgErrorKind::InvalidPath,
            i,
            "unexpected end of path arguments",
          ),
        )
      }
      if segs.length() >= limits.max_path_segments {
        return Err(
          SvgError::new(
            SvgErrorKind::LimitExceeded,
            i,
            "path exceeds max_path_segments",
          ),
        )
      }
      let abs = cmd < 0x60
      if cmd == 0x4D || cmd == 0x6D || cmd == 0x4C || cmd == 0x6C || cmd == 0x54 || cmd == 0x74 {
        let (x, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected x coordinate"))
          }
        }
        let i2 = skip_comma_wsp(d, i1, n)
        let (y, i3) = match scan_svg_number(d, i2, n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i2, "expected y coordinate"))
          }
        }
        i = i3
        if cmd == 0x4D || cmd == 0x6D {
          segs.push(PathSegment::MoveTo(abs, x, y))
          cmd = if abs { 0x4C } else { 0x6C }
        } else if cmd == 0x4C || cmd == 0x6C {
          segs.push(PathSegment::LineTo(abs, x, y))
        } else {
          segs.push(PathSegment::SmoothQuadratic(abs, x, y))
        }
      } else if cmd == 0x48 || cmd == 0x68 {
        let (x, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected H coordinate"))
          }
        }
        i = i1
        segs.push(PathSegment::HorizontalLineTo(abs, x))
      } else if cmd == 0x56 || cmd == 0x76 {
        let (y, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected V coordinate"))
          }
        }
        i = i1
        segs.push(PathSegment::VerticalLineTo(abs, y))
      } else if cmd == 0x43 || cmd == 0x63 {
        let (x1, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected C x1"))
          }
        }
        let (y1, i2) = match scan_svg_number(d, skip_comma_wsp(d, i1, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i1, "expected C y1"))
          }
        }
        let (x2, i3) = match scan_svg_number(d, skip_comma_wsp(d, i2, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i2, "expected C x2"))
          }
        }
        let (y2, i4) = match scan_svg_number(d, skip_comma_wsp(d, i3, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i3, "expected C y2"))
          }
        }
        let (x, i5) = match scan_svg_number(d, skip_comma_wsp(d, i4, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i4, "expected C x"))
          }
        }
        let (y, i6) = match scan_svg_number(d, skip_comma_wsp(d, i5, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i5, "expected C y"))
          }
        }
        i = i6
        segs.push(PathSegment::CurveTo(abs, x1, y1, x2, y2, x, y))
      } else if cmd == 0x53 || cmd == 0x73 || cmd == 0x51 || cmd == 0x71 {
        let (x1, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected S/Q x1"))
          }
        }
        let (y1, i2) = match scan_svg_number(d, skip_comma_wsp(d, i1, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i1, "expected S/Q y1"))
          }
        }
        let (x, i3) = match scan_svg_number(d, skip_comma_wsp(d, i2, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i2, "expected S/Q x"))
          }
        }
        let (y, i4) = match scan_svg_number(d, skip_comma_wsp(d, i3, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i3, "expected S/Q y"))
          }
        }
        i = i4
        if cmd == 0x53 || cmd == 0x73 {
          segs.push(PathSegment::SmoothCurveTo(abs, x1, y1, x, y))
        } else {
          segs.push(PathSegment::Quadratic(abs, x1, y1, x, y))
        }
      } else if cmd == 0x41 || cmd == 0x61 {
        let (rx, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected A rx"))
          }
        }
        let (ry, i2) = match scan_svg_number(d, skip_comma_wsp(d, i1, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i1, "expected A ry"))
          }
        }
        let (rot, i3) = match scan_svg_number(d, skip_comma_wsp(d, i2, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i2, "expected A rotation"))
          }
        }
        let p_la = skip_comma_wsp(d, i3, n)
        let (large_arc, i4) = match scan_arc_flag(d, p_la, n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, p_la, "expected A large-arc flag (0 or 1)"))
          }
        }
        let p_sw = skip_comma_wsp(d, i4, n)
        let (sweep, i5) = match scan_arc_flag(d, p_sw, n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, p_sw, "expected A sweep flag (0 or 1)"))
          }
        }
        let (x, i6) = match scan_svg_number(d, skip_comma_wsp(d, i5, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i5, "expected A x"))
          }
        }
        let (y, i7) = match scan_svg_number(d, skip_comma_wsp(d, i6, n), n) {
          Some(v) => v
          None => {
            if lenient { return Ok(SvgPath::{ segments: segs }) }
            return Err(SvgError::new(SvgErrorKind::InvalidPath, i6, "expected A y"))
          }
        }
        i = i7
        segs.push(
          PathSegment::EllipticalArc(abs, rx, ry, rot, large_arc, sweep, x, y),
        )
      } else {
        if lenient {
          return Ok(SvgPath::{ segments: segs })
        }
        return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "unknown path command"))
      }
      first_tuple = false
    }
  }
  Ok(SvgPath::{ segments: segs })
}

///| Parse an SVG path data string (`d`) with explicit `SvgLimits`.
pub fn parse_path_with_limits(
  d : String,
  limits : SvgLimits,
) -> Result[SvgPath, SvgError] {
  parse_path_internal(d, limits, false)
}

fn parse_path_lenient(
  d : String,
  limits : SvgLimits,
) -> Result[SvgPath, SvgError] {
  parse_path_internal(d, limits, true)
}

///| Streaming parser: parse SVG path data directly into normalized absolute `CubicSegment`s
///| without allocating an intermediate `Array[PathSegment]`.
pub fn parse_path_to_cubics(d : String) -> Result[Array[CubicSegment], SvgError] {
  parse_path_to_cubics_with_limits(d, SvgLimits::default())
}

///| Streaming parser into normalized absolute `CubicSegment`s with explicit `SvgLimits`.
pub fn parse_path_to_cubics_with_limits(
  d : String,
  limits : SvgLimits,
) -> Result[Array[CubicSegment], SvgError] {
  let n = d.length()
  if n > limits.max_input_bytes {
    return Err(
      SvgError::new(
        SvgErrorKind::LimitExceeded,
        0,
        "path input exceeds max_input_bytes",
      ),
    )
  }
  let out : Array[CubicSegment] = []
  let max_cubics : Int64 = limits.max_path_segments.to_int64() * 4L
  let mut i = skip_ws(d, 0, n)
  if i >= n {
    return Ok(out)
  }
  let first = d.code_unit_at(i)
  if first != 0x4D && first != 0x6D {
    return Err(
      SvgError::new(
        SvgErrorKind::InvalidPath,
        i,
        "path data must start with MoveTo (M/m)",
      ),
    )
  }
  let mut cx = 0.0
  let mut cy = 0.0
  let mut sx = 0.0
  let mut sy = 0.0
  let mut last_ctrl_x = 0.0
  let mut last_ctrl_y = 0.0
  let mut last_kind = 0
  let mut seg_cnt = 0
  let mut cmd = 0
  while i < n {
    i = skip_ws(d, i, n)
    if i >= n {
      break
    }
    let c = d.code_unit_at(i)
    if is_path_cmd(c) {
      cmd = c
      i = i + 1
    } else if cmd == 0 {
      return Err(
        SvgError::new(
          SvgErrorKind::InvalidPath,
          i,
          "expected SVG path command",
        ),
      )
    }
    if cmd == 0x5A || cmd == 0x7A {
      if seg_cnt >= limits.max_path_segments || out.length().to_int64() >= max_cubics {
        return Err(
          SvgError::new(
            SvgErrorKind::LimitExceeded,
            i,
            "path exceeds max_path_segments",
          ),
        )
      }
      seg_cnt = seg_cnt + 1
      cx = sx
      cy = sy
      last_kind = 0
      out.push(CubicSegment::ClosePath)
      cmd = 0
      continue
    }
    let mut first_tuple = true
    while true {
      i = if first_tuple {
        skip_ws(d, i, n)
      } else {
        skip_comma_wsp(d, i, n)
      }
      if !first_tuple {
        if i >= n || !is_number_start(d.code_unit_at(i)) {
          break
        }
      }
      if i >= n {
        return Err(
          SvgError::new(
            SvgErrorKind::InvalidPath,
            i,
            "unexpected end of path arguments",
          ),
        )
      }
      if seg_cnt >= limits.max_path_segments || out.length().to_int64() >= max_cubics {
        return Err(
          SvgError::new(
            SvgErrorKind::LimitExceeded,
            i,
            "path exceeds max_path_segments",
          ),
        )
      }
      seg_cnt = seg_cnt + 1
      let abs = cmd < 0x60
      if cmd == 0x4D || cmd == 0x6D || cmd == 0x4C || cmd == 0x6C || cmd == 0x54 || cmd == 0x74 {
        let (x, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected x coordinate"))
        }
        let i2 = skip_comma_wsp(d, i1, n)
        let (y, i3) = match scan_svg_number(d, i2, n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i2, "expected y coordinate"))
        }
        i = i3
        let nx = if abs { x } else { cx + x }
        let ny = if abs { y } else { cy + y }
        if cmd == 0x4D || cmd == 0x6D {
          cx = nx
          cy = ny
          sx = nx
          sy = ny
          last_kind = 0
          out.push(CubicSegment::MoveTo(nx, ny))
          cmd = if abs { 0x4C } else { 0x6C }
        } else if cmd == 0x4C || cmd == 0x6C {
          cx = nx
          cy = ny
          last_kind = 0
          out.push(CubicSegment::LineTo(nx, ny))
        } else {
          let qx = if last_kind == 2 { 2.0 * cx - last_ctrl_x } else { cx }
          let qy = if last_kind == 2 { 2.0 * cy - last_ctrl_y } else { cy }
          let c1x = cx + (2.0 / 3.0) * (qx - cx)
          let c1y = cy + (2.0 / 3.0) * (qy - cy)
          let c2x = nx + (2.0 / 3.0) * (qx - nx)
          let c2y = ny + (2.0 / 3.0) * (qy - ny)
          out.push(CubicSegment::CurveTo(c1x, c1y, c2x, c2y, nx, ny))
          last_ctrl_x = qx
          last_ctrl_y = qy
          last_kind = 2
          cx = nx
          cy = ny
        }
      } else if cmd == 0x48 || cmd == 0x68 {
        let (x, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected H coordinate"))
        }
        i = i1
        let nx = if abs { x } else { cx + x }
        cx = nx
        last_kind = 0
        out.push(CubicSegment::LineTo(nx, cy))
      } else if cmd == 0x56 || cmd == 0x76 {
        let (y, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected V coordinate"))
        }
        i = i1
        let ny = if abs { y } else { cy + y }
        cy = ny
        last_kind = 0
        out.push(CubicSegment::LineTo(cx, ny))
      } else if cmd == 0x43 || cmd == 0x63 {
        let (x1, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected C x1"))
        }
        let (y1, i2) = match scan_svg_number(d, skip_comma_wsp(d, i1, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i1, "expected C y1"))
        }
        let (x2, i3) = match scan_svg_number(d, skip_comma_wsp(d, i2, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i2, "expected C x2"))
        }
        let (y2, i4) = match scan_svg_number(d, skip_comma_wsp(d, i3, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i3, "expected C y2"))
        }
        let (x, i5) = match scan_svg_number(d, skip_comma_wsp(d, i4, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i4, "expected C x"))
        }
        let (y, i6) = match scan_svg_number(d, skip_comma_wsp(d, i5, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i5, "expected C y"))
        }
        i = i6
        let ax1 = if abs { x1 } else { cx + x1 }
        let ay1 = if abs { y1 } else { cy + y1 }
        let ax2 = if abs { x2 } else { cx + x2 }
        let ay2 = if abs { y2 } else { cy + y2 }
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        out.push(CubicSegment::CurveTo(ax1, ay1, ax2, ay2, ax, ay))
        last_ctrl_x = ax2
        last_ctrl_y = ay2
        last_kind = 1
        cx = ax
        cy = ay
      } else if cmd == 0x53 || cmd == 0x73 || cmd == 0x51 || cmd == 0x71 {
        let (x1, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected S/Q x1"))
        }
        let (y1, i2) = match scan_svg_number(d, skip_comma_wsp(d, i1, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i1, "expected S/Q y1"))
        }
        let (x, i3) = match scan_svg_number(d, skip_comma_wsp(d, i2, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i2, "expected S/Q x"))
        }
        let (y, i4) = match scan_svg_number(d, skip_comma_wsp(d, i3, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i3, "expected S/Q y"))
        }
        i = i4
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        if cmd == 0x53 || cmd == 0x73 {
          let ax1 = if last_kind == 1 { 2.0 * cx - last_ctrl_x } else { cx }
          let ay1 = if last_kind == 1 { 2.0 * cy - last_ctrl_y } else { cy }
          let ax2 = if abs { x1 } else { cx + x1 }
          let ay2 = if abs { y1 } else { cy + y1 }
          out.push(CubicSegment::CurveTo(ax1, ay1, ax2, ay2, ax, ay))
          last_ctrl_x = ax2
          last_ctrl_y = ay2
          last_kind = 1
        } else {
          let qx = if abs { x1 } else { cx + x1 }
          let qy = if abs { y1 } else { cy + y1 }
          let c1x = cx + (2.0 / 3.0) * (qx - cx)
          let c1y = cy + (2.0 / 3.0) * (qy - cy)
          let c2x = ax + (2.0 / 3.0) * (qx - ax)
          let c2y = ay + (2.0 / 3.0) * (qy - ay)
          out.push(CubicSegment::CurveTo(c1x, c1y, c2x, c2y, ax, ay))
          last_ctrl_x = qx
          last_ctrl_y = qy
          last_kind = 2
        }
        cx = ax
        cy = ay
      } else if cmd == 0x41 || cmd == 0x61 {
        let (rx, i1) = match scan_svg_number(d, i, n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "expected A rx"))
        }
        let (ry, i2) = match scan_svg_number(d, skip_comma_wsp(d, i1, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i1, "expected A ry"))
        }
        let (rot, i3) = match scan_svg_number(d, skip_comma_wsp(d, i2, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i2, "expected A rotation"))
        }
        let p_la = skip_comma_wsp(d, i3, n)
        let (large_arc, i4) = match scan_arc_flag(d, p_la, n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, p_la, "expected A large-arc flag (0 or 1)"))
        }
        let p_sw = skip_comma_wsp(d, i4, n)
        let (sweep, i5) = match scan_arc_flag(d, p_sw, n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, p_sw, "expected A sweep flag (0 or 1)"))
        }
        let (x, i6) = match scan_svg_number(d, skip_comma_wsp(d, i5, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i5, "expected A x"))
        }
        let (y, i7) = match scan_svg_number(d, skip_comma_wsp(d, i6, n), n) {
          Some(v) => v
          None => return Err(SvgError::new(SvgErrorKind::InvalidPath, i6, "expected A y"))
        }
        i = i7
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        arc_to_cubics(cx, cy, rx, ry, rot, large_arc, sweep, ax, ay, out)
        cx = ax
        cy = ay
        last_kind = 0
      } else {
        return Err(SvgError::new(SvgErrorKind::InvalidPath, i, "unknown path command"))
      }
      first_tuple = false
    }
  }
  Ok(out)
}

///| Convert all relative path segments to absolute coordinates.
pub fn to_absolute(path : SvgPath) -> SvgPath {
  let out : Array[PathSegment] = []
  let mut cx = 0.0
  let mut cy = 0.0
  let mut sx = 0.0
  let mut sy = 0.0
  let n = path.segments.length()
  let mut i = 0
  while i < n {
    match path.segments[i] {
      PathSegment::MoveTo(abs, x, y) => {
        let nx = if abs { x } else { cx + x }
        let ny = if abs { y } else { cy + y }
        cx = nx
        cy = ny
        sx = nx
        sy = ny
        out.push(PathSegment::MoveTo(true, nx, ny))
      }
      PathSegment::LineTo(abs, x, y) => {
        let nx = if abs { x } else { cx + x }
        let ny = if abs { y } else { cy + y }
        cx = nx
        cy = ny
        out.push(PathSegment::LineTo(true, nx, ny))
      }
      PathSegment::HorizontalLineTo(abs, x) => {
        let nx = if abs { x } else { cx + x }
        cx = nx
        out.push(PathSegment::HorizontalLineTo(true, nx))
      }
      PathSegment::VerticalLineTo(abs, y) => {
        let ny = if abs { y } else { cy + y }
        cy = ny
        out.push(PathSegment::VerticalLineTo(true, ny))
      }
      PathSegment::CurveTo(abs, x1, y1, x2, y2, x, y) => {
        let ax1 = if abs { x1 } else { cx + x1 }
        let ay1 = if abs { y1 } else { cy + y1 }
        let ax2 = if abs { x2 } else { cx + x2 }
        let ay2 = if abs { y2 } else { cy + y2 }
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        cx = ax
        cy = ay
        out.push(PathSegment::CurveTo(true, ax1, ay1, ax2, ay2, ax, ay))
      }
      PathSegment::SmoothCurveTo(abs, x2, y2, x, y) => {
        let ax2 = if abs { x2 } else { cx + x2 }
        let ay2 = if abs { y2 } else { cy + y2 }
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        cx = ax
        cy = ay
        out.push(PathSegment::SmoothCurveTo(true, ax2, ay2, ax, ay))
      }
      PathSegment::Quadratic(abs, x1, y1, x, y) => {
        let ax1 = if abs { x1 } else { cx + x1 }
        let ay1 = if abs { y1 } else { cy + y1 }
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        cx = ax
        cy = ay
        out.push(PathSegment::Quadratic(true, ax1, ay1, ax, ay))
      }
      PathSegment::SmoothQuadratic(abs, x, y) => {
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        cx = ax
        cy = ay
        out.push(PathSegment::SmoothQuadratic(true, ax, ay))
      }
      PathSegment::EllipticalArc(abs, rx, ry, rot, la, sw, x, y) => {
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        cx = ax
        cy = ay
        out.push(PathSegment::EllipticalArc(true, rx, ry, rot, la, sw, ax, ay))
      }
      PathSegment::ClosePath(_) => {
        cx = sx
        cy = sy
        out.push(PathSegment::ClosePath(true))
      }
    }
    i = i + 1
  }
  SvgPath::{ segments: out }
}

///| W3C SVG 1.1 Appendix F.6.5 & F.6.6: convert elliptical arc to 1..4 cubic Bézier segments.
fn arc_to_cubics(
  x1 : Double,
  y1 : Double,
  rx_in : Double,
  ry_in : Double,
  x_axis_rotation_deg : Double,
  large_arc : Bool,
  sweep : Bool,
  x2 : Double,
  y2 : Double,
  out : Array[CubicSegment],
) -> Unit {
  if !is_finite(x1) || !is_finite(y1) || !is_finite(x2) || !is_finite(y2) {
    return
  }
  if x1 == x2 && y1 == y2 {
    return
  }
  let mut rx = rx_in.abs()
  let mut ry = ry_in.abs()
  if !is_finite(rx) || !is_finite(ry) || rx == 0.0 || ry == 0.0 {
    out.push(CubicSegment::LineTo(x2, y2))
    return
  }
  let phi = deg_to_rad(x_axis_rotation_deg)
  let (sin_phi, cos_phi) = sin_cos_f64(phi)

  // Step 1: Compute (x1', y1')
  let dx2 = (x1 - x2) * 0.5
  let dy2 = (y1 - y2) * 0.5
  let x1p = cos_phi * dx2 + sin_phi * dy2
  let y1p = -sin_phi * dx2 + cos_phi * dy2

  // Step 2: Ensure radii are large enough (F.6.6.3)
  let rx2_0 = rx * rx
  let ry2_0 = ry * ry
  let x1p2 = x1p * x1p
  let y1p2 = y1p * y1p
  let lambda = x1p2 / rx2_0 + y1p2 / ry2_0
  if !is_finite(lambda) {
    out.push(CubicSegment::LineTo(x2, y2))
    return
  }
  if lambda > 1.0 {
    let s = lambda.sqrt()
    rx = rx * s
    ry = ry * s
  }
  let rx2 = rx * rx
  let ry2 = ry * ry

  // Step 3: Compute (cx', cy')
  let num = rx2 * ry2 - rx2 * y1p2 - ry2 * x1p2
  let den = rx2 * y1p2 + ry2 * x1p2
  let factor_sq = if den == 0.0 || !is_finite(den) {
    0.0
  } else {
    let r = num / den
    if !is_finite(r) || r < 0.0 { 0.0 } else { r }
  }
  let mut factor = factor_sq.sqrt()
  if large_arc == sweep {
    factor = -factor
  }
  let cxp = factor * (rx * y1p / ry)
  let cyp = factor * (-ry * x1p / rx)

  // Step 4: Compute (cx, cy) from (cx', cy')
  let cx = cos_phi * cxp - sin_phi * cyp + (x1 + x2) * 0.5
  let cy = sin_phi * cxp + cos_phi * cyp + (y1 + y2) * 0.5

  // Step 5: Compute theta1 and dtheta using atan2 (faster and more accurate than acos)
  let ux = (x1p - cxp) / rx
  let uy = (y1p - cyp) / ry
  let vx = (-x1p - cxp) / rx
  let vy = (-y1p - cyp) / ry

  let theta1 = atan2_f64(uy, ux)
  let mut dtheta = atan2_f64(ux * vy - uy * vx, ux * vx + uy * vy)
  if !sweep && dtheta > 0.0 {
    dtheta = dtheta - tau_val
  } else if sweep && dtheta < 0.0 {
    dtheta = dtheta + tau_val
  }

  // Split arc into segments of at most pi/2 radians (at most 4 segments)
  let mut n_segs = (dtheta.abs() / half_pi_val).ceil().to_int()
  if n_segs < 1 {
    n_segs = 1
  }
  if n_segs > 4 {
    n_segs = 4
  }
  let delta = dtheta / n_segs.to_double()
  let alpha = (4.0 / 3.0) * tan_f64(delta * 0.25)

  // Reuse (cos1, sin1) by rotating with precomputed (cos_d, sin_d) -> only 2 trig reductions per arc!
  let (sin_d, cos_d) = sin_cos_f64(delta)
  let (init_sin, init_cos) = sin_cos_f64(theta1)
  let mut cos1 = init_cos
  let mut sin1 = init_sin
  let rx_cos_phi = rx * cos_phi
  let ry_sin_phi = ry * sin_phi
  let rx_sin_phi = rx * sin_phi
  let ry_cos_phi = ry * cos_phi
  let mut k = 0
  while k < n_segs {
    let cos2 = cos1 * cos_d - sin1 * sin_d
    let sin2 = sin1 * cos_d + cos1 * sin_d

    let q1x = cos1 - alpha * sin1
    let q1y = sin1 + alpha * cos1
    let q2x = cos2 + alpha * sin2
    let q2y = sin2 - alpha * cos2

    let c1x = cx + rx_cos_phi * q1x - ry_sin_phi * q1y
    let c1y = cy + rx_sin_phi * q1x + ry_cos_phi * q1y
    let c2x = cx + rx_cos_phi * q2x - ry_sin_phi * q2y
    let c2y = cy + rx_sin_phi * q2x + ry_cos_phi * q2y
    let ex = if k == n_segs - 1 {
      x2
    } else {
      cx + rx_cos_phi * cos2 - ry_sin_phi * sin2
    }
    let ey = if k == n_segs - 1 {
      y2
    } else {
      cy + rx_sin_phi * cos2 + ry_cos_phi * sin2
    }
    out.push(CubicSegment::CurveTo(c1x, c1y, c2x, c2y, ex, ey))
    cos1 = cos2
    sin1 = sin2
    k = k + 1
  }
}

///| Normalize a path into absolute MoveTo/LineTo/CurveTo/ClosePath segments.
pub fn to_cubic_beziers(path : SvgPath) -> Array[CubicSegment] {
  match to_cubic_beziers_with_limits(path, SvgLimits::default()) {
    Ok(c) => c
    Err(_) => []
  }
}

///| Normalize a path into absolute cubic Bézier segments with explicit `SvgLimits`.
pub fn to_cubic_beziers_with_limits(
  path : SvgPath,
  limits : SvgLimits,
) -> Result[Array[CubicSegment], SvgError] {
  let out : Array[CubicSegment] = []
  let max_cubics : Int64 = limits.max_path_segments.to_int64() * 4L
  let mut cx = 0.0
  let mut cy = 0.0
  let mut sx = 0.0
  let mut sy = 0.0
  let mut last_ctrl_x = 0.0
  let mut last_ctrl_y = 0.0
  // 0 = other, 1 = cubic (C/c/S/s), 2 = quad (Q/q/T/t)
  let mut last_kind = 0
  let n = path.segments.length()
  let mut i = 0
  while i < n {
    if out.length().to_int64() >= max_cubics {
      return Err(
        SvgError::new(
          SvgErrorKind::LimitExceeded,
          i,
          "cubic expansion exceeds limit",
        ),
      )
    }
    match path.segments[i] {
      PathSegment::MoveTo(abs, x, y) => {
        let nx = if abs { x } else { cx + x }
        let ny = if abs { y } else { cy + y }
        cx = nx
        cy = ny
        sx = nx
        sy = ny
        last_kind = 0
        out.push(CubicSegment::MoveTo(nx, ny))
      }
      PathSegment::LineTo(abs, x, y) => {
        let nx = if abs { x } else { cx + x }
        let ny = if abs { y } else { cy + y }
        cx = nx
        cy = ny
        last_kind = 0
        out.push(CubicSegment::LineTo(nx, ny))
      }
      PathSegment::HorizontalLineTo(abs, x) => {
        let nx = if abs { x } else { cx + x }
        cx = nx
        last_kind = 0
        out.push(CubicSegment::LineTo(nx, cy))
      }
      PathSegment::VerticalLineTo(abs, y) => {
        let ny = if abs { y } else { cy + y }
        cy = ny
        last_kind = 0
        out.push(CubicSegment::LineTo(cx, ny))
      }
      PathSegment::CurveTo(abs, x1, y1, x2, y2, x, y) => {
        let ax1 = if abs { x1 } else { cx + x1 }
        let ay1 = if abs { y1 } else { cy + y1 }
        let ax2 = if abs { x2 } else { cx + x2 }
        let ay2 = if abs { y2 } else { cy + y2 }
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        out.push(CubicSegment::CurveTo(ax1, ay1, ax2, ay2, ax, ay))
        last_ctrl_x = ax2
        last_ctrl_y = ay2
        last_kind = 1
        cx = ax
        cy = ay
      }
      PathSegment::SmoothCurveTo(abs, x2, y2, x, y) => {
        let ax1 = if last_kind == 1 { 2.0 * cx - last_ctrl_x } else { cx }
        let ay1 = if last_kind == 1 { 2.0 * cy - last_ctrl_y } else { cy }
        let ax2 = if abs { x2 } else { cx + x2 }
        let ay2 = if abs { y2 } else { cy + y2 }
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        out.push(CubicSegment::CurveTo(ax1, ay1, ax2, ay2, ax, ay))
        last_ctrl_x = ax2
        last_ctrl_y = ay2
        last_kind = 1
        cx = ax
        cy = ay
      }
      PathSegment::Quadratic(abs, x1, y1, x, y) => {
        let qx = if abs { x1 } else { cx + x1 }
        let qy = if abs { y1 } else { cy + y1 }
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        let c1x = cx + (2.0 / 3.0) * (qx - cx)
        let c1y = cy + (2.0 / 3.0) * (qy - cy)
        let c2x = ax + (2.0 / 3.0) * (qx - ax)
        let c2y = ay + (2.0 / 3.0) * (qy - ay)
        out.push(CubicSegment::CurveTo(c1x, c1y, c2x, c2y, ax, ay))
        last_ctrl_x = qx
        last_ctrl_y = qy
        last_kind = 2
        cx = ax
        cy = ay
      }
      PathSegment::SmoothQuadratic(abs, x, y) => {
        let qx = if last_kind == 2 { 2.0 * cx - last_ctrl_x } else { cx }
        let qy = if last_kind == 2 { 2.0 * cy - last_ctrl_y } else { cy }
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        let c1x = cx + (2.0 / 3.0) * (qx - cx)
        let c1y = cy + (2.0 / 3.0) * (qy - cy)
        let c2x = ax + (2.0 / 3.0) * (qx - ax)
        let c2y = ay + (2.0 / 3.0) * (qy - ay)
        out.push(CubicSegment::CurveTo(c1x, c1y, c2x, c2y, ax, ay))
        last_ctrl_x = qx
        last_ctrl_y = qy
        last_kind = 2
        cx = ax
        cy = ay
      }
      PathSegment::EllipticalArc(abs, rx, ry, rot, la, sw, x, y) => {
        let ax = if abs { x } else { cx + x }
        let ay = if abs { y } else { cy + y }
        arc_to_cubics(cx, cy, rx, ry, rot, la, sw, ax, ay, out)
        cx = ax
        cy = ay
        last_kind = 0
      }
      PathSegment::ClosePath(_) => {
        cx = sx
        cy = sy
        last_kind = 0
        out.push(CubicSegment::ClosePath)
      }
    }
    i = i + 1
  }
  Ok(out)
}

fn str_has_dot_or_exp(s : String) -> (Bool, Bool) {
  let n = s.length()
  let mut has_dot = false
  let mut has_exp = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 0x2E {
      has_dot = true
    } else if c == 0x65 || c == 0x45 {
      has_exp = true
    }
    i = i + 1
  }
  (has_dot, has_exp)
}

///| Append a compactly formatted number to `sb`, omitting space when unambiguous.
///| Returns `true` if a subsequent number starting with `.` needs NO space.
fn write_path_num(
  sb : StringBuilder,
  v : Double,
  precision : Int,
  after_cmd : Bool,
  prev_allows_dot_join : Bool,
) -> Bool {
  let s = format_compact_number(v, precision)
  if !after_cmd && s.length() > 0 {
    let first = s.code_unit_at(0)
    // Space is only needed if NOT starting with '-' and NOT (starting with '.' when previous allows dot join)
    if first != 0x2D && !(first == 0x2E && prev_allows_dot_join) {
      sb.write_byte((0x20).to_byte())
    }
  }
  sb.write_string(s)
  let (has_dot, has_exp) = str_has_dot_or_exp(s)
  // After an exponent (like 1e21 or 1.5e300), a following `.` is always a new number,
  // and after a dot (like 1.2), a following `.` is always a new number.
  has_dot || has_exp
}

///| Choose the relative value and precision to emit so that BOTH:
///| 1. `|emitted - orig| <= 0.5 * 10^-precision` (per-segment rounding contract), and
///| 2. cumulative absolute drift stays bounded within `0.5 * 10^-precision`.
fn choose_rel_emit(orig : Double, target : Double, precision : Int) -> (Double, Int) {
  let p = if precision < 0 {
    0
  } else if precision > 8 {
    8
  } else {
    precision
  }
  if !is_finite(orig) || !is_finite(target) || orig.abs() >= 4500000000000000.0 || target.abs() >= 4500000000000000.0 {
    return (orig, p)
  }
  let u = 1.0 / pow10_exact_tbl[p]
  let half_u = 0.5 * u
  let r = round_to_precision(target, p)
  if (r - orig).abs() <= half_u * (1.0 + 1e-12) {
    return (r, p)
  }
  // Error-compensation crossed the 0.5*u per-segment bound: refine by 1 extra digit
  let p2 = if p < 8 { p + 1 } else { 8 }
  let mut r2 = round_to_precision(target, p2)
  if (r2 - orig).abs() > half_u {
    let step = 1.0 / pow10_exact_tbl[p2]
    r2 = if r2 > orig { r2 - step } else { r2 + step }
    r2 = round_to_precision(r2, p2)
  }
  (r2, p2)
}

///| Serialize an SVG path in SVGO-level compact form with `precision` decimal digits.
///| Tracks cumulative rounding error on relative commands so endpoints never drift.
pub fn format_path(path : SvgPath, precision : Int) -> String {
  let sb = StringBuilder::new()
  let mut prev_cmd = 0
  let mut prev_dot = false
  let mut cur_x = 0.0
  let mut cur_y = 0.0
  let mut start_x = 0.0
  let mut start_y = 0.0
  let mut out_x = 0.0
  let mut out_y = 0.0
  let mut out_sx = 0.0
  let mut out_sy = 0.0
  let n = path.segments.length()
  let mut i = 0
  while i < n {
    match path.segments[i] {
      PathSegment::MoveTo(abs, x, y) => {
        let cmd = if abs { 0x4D } else { 0x6D }
        sb.write_byte(cmd.to_byte())
        if abs {
          let d1 = write_path_num(sb, x, precision, true, false)
          prev_dot = write_path_num(sb, y, precision, false, d1)
          cur_x = x
          cur_y = y
          out_x = round_to_precision(x, precision)
          out_y = round_to_precision(y, precision)
        } else {
          let nx = cur_x + x
          let ny = cur_y + y
          let (ex, px) = choose_rel_emit(x, nx - out_x, precision)
          let (ey, py) = choose_rel_emit(y, ny - out_y, precision)
          let d1 = write_path_num(sb, ex, px, true, false)
          prev_dot = write_path_num(sb, ey, py, false, d1)
          cur_x = nx
          cur_y = ny
          out_x = out_x + ex
          out_y = out_y + ey
        }
        start_x = cur_x
        start_y = cur_y
        out_sx = out_x
        out_sy = out_y
        prev_cmd = if abs { 0x4C } else { 0x6C }
      }
      PathSegment::LineTo(abs, x, y) => {
        let cmd = if abs { 0x4C } else { 0x6C }
        let wrote_cmd = prev_cmd != cmd
        if wrote_cmd {
          sb.write_byte(cmd.to_byte())
        }
        if abs {
          let d1 = write_path_num(sb, x, precision, wrote_cmd, prev_dot)
          prev_dot = write_path_num(sb, y, precision, false, d1)
          cur_x = x
          cur_y = y
          out_x = round_to_precision(x, precision)
          out_y = round_to_precision(y, precision)
        } else {
          let nx = cur_x + x
          let ny = cur_y + y
          let (ex, px) = choose_rel_emit(x, nx - out_x, precision)
          let (ey, py) = choose_rel_emit(y, ny - out_y, precision)
          let d1 = write_path_num(sb, ex, px, wrote_cmd, prev_dot)
          prev_dot = write_path_num(sb, ey, py, false, d1)
          cur_x = nx
          cur_y = ny
          out_x = out_x + ex
          out_y = out_y + ey
        }
        prev_cmd = cmd
      }
      PathSegment::HorizontalLineTo(abs, x) => {
        let cmd = if abs { 0x48 } else { 0x68 }
        let wrote_cmd = prev_cmd != cmd
        if wrote_cmd {
          sb.write_byte(cmd.to_byte())
        }
        if abs {
          prev_dot = write_path_num(sb, x, precision, wrote_cmd, prev_dot)
          cur_x = x
          out_x = round_to_precision(x, precision)
        } else {
          let nx = cur_x + x
          let (ex, px) = choose_rel_emit(x, nx - out_x, precision)
          prev_dot = write_path_num(sb, ex, px, wrote_cmd, prev_dot)
          cur_x = nx
          out_x = out_x + ex
        }
        prev_cmd = cmd
      }
      PathSegment::VerticalLineTo(abs, y) => {
        let cmd = if abs { 0x56 } else { 0x76 }
        let wrote_cmd = prev_cmd != cmd
        if wrote_cmd {
          sb.write_byte(cmd.to_byte())
        }
        if abs {
          prev_dot = write_path_num(sb, y, precision, wrote_cmd, prev_dot)
          cur_y = y
          out_y = round_to_precision(y, precision)
        } else {
          let ny = cur_y + y
          let (ey, py) = choose_rel_emit(y, ny - out_y, precision)
          prev_dot = write_path_num(sb, ey, py, wrote_cmd, prev_dot)
          cur_y = ny
          out_y = out_y + ey
        }
        prev_cmd = cmd
      }
      PathSegment::CurveTo(abs, x1, y1, x2, y2, x, y) => {
        let cmd = if abs { 0x43 } else { 0x63 }
        let wrote_cmd = prev_cmd != cmd
        if wrote_cmd {
          sb.write_byte(cmd.to_byte())
        }
        if abs {
          let d1 = write_path_num(sb, x1, precision, wrote_cmd, prev_dot)
          let d2 = write_path_num(sb, y1, precision, false, d1)
          let d3 = write_path_num(sb, x2, precision, false, d2)
          let d4 = write_path_num(sb, y2, precision, false, d3)
          let d5 = write_path_num(sb, x, precision, false, d4)
          prev_dot = write_path_num(sb, y, precision, false, d5)
          cur_x = x
          cur_y = y
          out_x = round_to_precision(x, precision)
          out_y = round_to_precision(y, precision)
        } else {
          let nx = cur_x + x
          let ny = cur_y + y
          let (ex1, px1) = choose_rel_emit(x1, cur_x + x1 - out_x, precision)
          let (ey1, py1) = choose_rel_emit(y1, cur_y + y1 - out_y, precision)
          let (ex2, px2) = choose_rel_emit(x2, cur_x + x2 - out_x, precision)
          let (ey2, py2) = choose_rel_emit(y2, cur_y + y2 - out_y, precision)
          let (ex, px) = choose_rel_emit(x, nx - out_x, precision)
          let (ey, py) = choose_rel_emit(y, ny - out_y, precision)
          let d1 = write_path_num(sb, ex1, px1, wrote_cmd, prev_dot)
          let d2 = write_path_num(sb, ey1, py1, false, d1)
          let d3 = write_path_num(sb, ex2, px2, false, d2)
          let d4 = write_path_num(sb, ey2, py2, false, d3)
          let d5 = write_path_num(sb, ex, px, false, d4)
          prev_dot = write_path_num(sb, ey, py, false, d5)
          cur_x = nx
          cur_y = ny
          out_x = out_x + ex
          out_y = out_y + ey
        }
        prev_cmd = cmd
      }
      PathSegment::SmoothCurveTo(abs, x2, y2, x, y) => {
        let cmd = if abs { 0x53 } else { 0x73 }
        let wrote_cmd = prev_cmd != cmd
        if wrote_cmd {
          sb.write_byte(cmd.to_byte())
        }
        if abs {
          let d1 = write_path_num(sb, x2, precision, wrote_cmd, prev_dot)
          let d2 = write_path_num(sb, y2, precision, false, d1)
          let d3 = write_path_num(sb, x, precision, false, d2)
          prev_dot = write_path_num(sb, y, precision, false, d3)
          cur_x = x
          cur_y = y
          out_x = round_to_precision(x, precision)
          out_y = round_to_precision(y, precision)
        } else {
          let nx = cur_x + x
          let ny = cur_y + y
          let (ex2, px2) = choose_rel_emit(x2, cur_x + x2 - out_x, precision)
          let (ey2, py2) = choose_rel_emit(y2, cur_y + y2 - out_y, precision)
          let (ex, px) = choose_rel_emit(x, nx - out_x, precision)
          let (ey, py) = choose_rel_emit(y, ny - out_y, precision)
          let d1 = write_path_num(sb, ex2, px2, wrote_cmd, prev_dot)
          let d2 = write_path_num(sb, ey2, py2, false, d1)
          let d3 = write_path_num(sb, ex, px, false, d2)
          prev_dot = write_path_num(sb, ey, py, false, d3)
          cur_x = nx
          cur_y = ny
          out_x = out_x + ex
          out_y = out_y + ey
        }
        prev_cmd = cmd
      }
      PathSegment::Quadratic(abs, x1, y1, x, y) => {
        let cmd = if abs { 0x51 } else { 0x71 }
        let wrote_cmd = prev_cmd != cmd
        if wrote_cmd {
          sb.write_byte(cmd.to_byte())
        }
        if abs {
          let d1 = write_path_num(sb, x1, precision, wrote_cmd, prev_dot)
          let d2 = write_path_num(sb, y1, precision, false, d1)
          let d3 = write_path_num(sb, x, precision, false, d2)
          prev_dot = write_path_num(sb, y, precision, false, d3)
          cur_x = x
          cur_y = y
          out_x = round_to_precision(x, precision)
          out_y = round_to_precision(y, precision)
        } else {
          let nx = cur_x + x
          let ny = cur_y + y
          let (ex1, px1) = choose_rel_emit(x1, cur_x + x1 - out_x, precision)
          let (ey1, py1) = choose_rel_emit(y1, cur_y + y1 - out_y, precision)
          let (ex, px) = choose_rel_emit(x, nx - out_x, precision)
          let (ey, py) = choose_rel_emit(y, ny - out_y, precision)
          let d1 = write_path_num(sb, ex1, px1, wrote_cmd, prev_dot)
          let d2 = write_path_num(sb, ey1, py1, false, d1)
          let d3 = write_path_num(sb, ex, px, false, d2)
          prev_dot = write_path_num(sb, ey, py, false, d3)
          cur_x = nx
          cur_y = ny
          out_x = out_x + ex
          out_y = out_y + ey
        }
        prev_cmd = cmd
      }
      PathSegment::SmoothQuadratic(abs, x, y) => {
        let cmd = if abs { 0x54 } else { 0x74 }
        let wrote_cmd = prev_cmd != cmd
        if wrote_cmd {
          sb.write_byte(cmd.to_byte())
        }
        if abs {
          let d1 = write_path_num(sb, x, precision, wrote_cmd, prev_dot)
          prev_dot = write_path_num(sb, y, precision, false, d1)
          cur_x = x
          cur_y = y
          out_x = round_to_precision(x, precision)
          out_y = round_to_precision(y, precision)
        } else {
          let nx = cur_x + x
          let ny = cur_y + y
          let (ex, px) = choose_rel_emit(x, nx - out_x, precision)
          let (ey, py) = choose_rel_emit(y, ny - out_y, precision)
          let d1 = write_path_num(sb, ex, px, wrote_cmd, prev_dot)
          prev_dot = write_path_num(sb, ey, py, false, d1)
          cur_x = nx
          cur_y = ny
          out_x = out_x + ex
          out_y = out_y + ey
        }
        prev_cmd = cmd
      }
      PathSegment::EllipticalArc(abs, rx, ry, rot, la, sw, x, y) => {
        let cmd = if abs { 0x41 } else { 0x61 }
        let wrote_cmd = prev_cmd != cmd
        if wrote_cmd {
          sb.write_byte(cmd.to_byte())
        }
        let d1 = write_path_num(sb, rx, precision, wrote_cmd, prev_dot)
        let d2 = write_path_num(sb, ry, precision, false, d1)
        let _ = write_path_num(sb, rot, precision, false, d2)
        // Compact SVGO arc flags: space before first flag, NO space between flags or before x
        sb.write_byte((0x20).to_byte())
        sb.write_byte((if la { 0x31 } else { 0x30 }).to_byte())
        sb.write_byte((if sw { 0x31 } else { 0x30 }).to_byte())
        if abs {
          let d5 = write_path_num(sb, x, precision, true, false)
          prev_dot = write_path_num(sb, y, precision, false, d5)
          cur_x = x
          cur_y = y
          out_x = round_to_precision(x, precision)
          out_y = round_to_precision(y, precision)
        } else {
          let nx = cur_x + x
          let ny = cur_y + y
          let (ex, px) = choose_rel_emit(x, nx - out_x, precision)
          let (ey, py) = choose_rel_emit(y, ny - out_y, precision)
          let d5 = write_path_num(sb, ex, px, true, false)
          prev_dot = write_path_num(sb, ey, py, false, d5)
          cur_x = nx
          cur_y = ny
          out_x = out_x + ex
          out_y = out_y + ey
        }
        prev_cmd = cmd
      }
      PathSegment::ClosePath(abs) => {
        let cmd = if abs { 0x5A } else { 0x7A }
        sb.write_byte(cmd.to_byte())
        cur_x = start_x
        cur_y = start_y
        out_x = out_sx
        out_y = out_sy
        prev_cmd = 0
        prev_dot = false
      }
    }
    i = i + 1
  }
  sb.to_string()
}
