///| Exact analytical bounding box, adaptive De Casteljau flattening, and arc-length integration.

///| Flattened polyline contour.
pub struct Polyline {
  pub points : Array[Point]
  pub closed : Bool
}

fn eval_cubic_1d(p0 : Double, p1 : Double, p2 : Double, p3 : Double, t : Double) -> Double {
  let mt = 1.0 - t
  mt * mt * mt * p0 +
  3.0 * mt * mt * t * p1 +
  3.0 * mt * t * t * p2 +
  t * t * t * p3
}

val struct Bounds1D {
  lo : Double
  hi : Double
}

///| Return exact `(lo, hi)` for 1D cubic Bézier on `t in [0, 1]` as a stack value (zero heap allocation).
fn cubic_1d_bounds_val(
  p0 : Double,
  p1 : Double,
  p2 : Double,
  p3 : Double,
  init_lo : Double,
  init_hi : Double,
) -> Bounds1D {
  let mut lo = init_lo
  let mut hi = init_hi
  let mut cmin = if p0 < p3 { p0 } else { p3 }
  if p1 < cmin { cmin = p1 }
  if p2 < cmin { cmin = p2 }
  let mut cmax = if p0 > p3 { p0 } else { p3 }
  if p1 > cmax { cmax = p1 }
  if p2 > cmax { cmax = p2 }
  let span = cmax - cmin
  if span != 0.0 && is_finite(span) {
    // B'(t) = 3 * (a t^2 + b t + c) = 0
    let a = -p0 + 3.0 * p1 - 3.0 * p2 + p3
    let b = 2.0 * (p0 - 2.0 * p1 + p2)
    let c = p1 - p0
    let eps = 1e-12 * span
    if a.abs() <= eps {
      if b != 0.0 {
        let t = -c / b
        if t > 0.0 && t < 1.0 {
          let v = eval_cubic_1d(p0, p1, p2, p3, t)
          if v < lo { lo = v }
          if v > hi { hi = v }
        }
      }
    } else {
      let disc = b * b - 4.0 * a * c
      if disc >= 0.0 {
        let sq = disc.sqrt()
        let q = -0.5 * (b + (if b >= 0.0 { sq } else { -sq }))
        if q != 0.0 {
          let t1 = q / a
          if t1 > 0.0 && t1 < 1.0 {
            let v = eval_cubic_1d(p0, p1, p2, p3, t1)
            if v < lo { lo = v }
            if v > hi { hi = v }
          }
          let t2 = c / q
          if t2 > 0.0 && t2 < 1.0 {
            let v = eval_cubic_1d(p0, p1, p2, p3, t2)
            if v < lo { lo = v }
            if v > hi { hi = v }
          }
        } else {
          let t1 = -b / (2.0 * a)
          if t1 > 0.0 && t1 < 1.0 {
            let v = eval_cubic_1d(p0, p1, p2, p3, t1)
            if v < lo { lo = v }
            if v > hi { hi = v }
          }
        }
      }
    }
  }
  Bounds1D::{ lo: lo, hi: hi }
}

///| Compute the exact tight analytical bounding box of normalized cubic segments.
pub fn cubics_bbox(cubics : Array[CubicSegment]) -> Option[Rect] {
  let n = cubics.length()
  if n == 0 {
    return None
  }
  let mut has_pt = false
  let mut min_x = 0.0
  let mut min_y = 0.0
  let mut max_x = 0.0
  let mut max_y = 0.0
  let mut cx = 0.0
  let mut cy = 0.0
  let mut sx = 0.0
  let mut sy = 0.0
  let mut i = 0
  while i < n {
    match cubics[i] {
      CubicSegment::MoveTo(x, y) => {
        cx = x
        cy = y
        sx = x
        sy = y
        if !has_pt {
          has_pt = true
          min_x = x
          max_x = x
          min_y = y
          max_y = y
        } else {
          if x < min_x { min_x = x }
          if x > max_x { max_x = x }
          if y < min_y { min_y = y }
          if y > max_y { max_y = y }
        }
      }
      CubicSegment::LineTo(x, y) => {
        if !has_pt {
          has_pt = true
          min_x = x
          max_x = x
          min_y = y
          max_y = y
        } else {
          if x < min_x { min_x = x }
          if x > max_x { max_x = x }
          if y < min_y { min_y = y }
          if y > max_y { max_y = y }
        }
        cx = x
        cy = y
      }
      CubicSegment::CurveTo(x1, y1, x2, y2, x, y) => {
        if !has_pt {
          has_pt = true
          min_x = if cx < x { cx } else { x }
          max_x = if cx > x { cx } else { x }
          min_y = if cy < y { cy } else { y }
          max_y = if cy > y { cy } else { y }
        } else {
          if x < min_x { min_x = x }
          if x > max_x { max_x = x }
          if y < min_y { min_y = y }
          if y > max_y { max_y = y }
        }
        if x1 < min_x || x1 > max_x || x2 < min_x || x2 > max_x {
          let bx = cubic_1d_bounds_val(cx, x1, x2, x, min_x, max_x)
          min_x = bx.lo
          max_x = bx.hi
        }
        if y1 < min_y || y1 > max_y || y2 < min_y || y2 > max_y {
          let by = cubic_1d_bounds_val(cy, y1, y2, y, min_y, max_y)
          min_y = by.lo
          max_y = by.hi
        }
        cx = x
        cy = y
      }
      CubicSegment::ClosePath => {
        cx = sx
        cy = sy
      }
    }
    i = i + 1
  }
  if !has_pt {
    None
  } else {
    Some(Rect::new(min_x, min_y, max_x, max_y))
  }
}

///| Compute the exact tight analytical bounding box of an `SvgPath`.
pub fn path_bbox(path : SvgPath) -> Option[Rect] {
  cubics_bbox(to_cubic_beziers(path))
}

val struct CubicFrame {
  x0 : Double
  y0 : Double
  x1 : Double
  y1 : Double
  x2 : Double
  y2 : Double
  x3 : Double
  y3 : Double
  depth : Int
}

fn cubic_is_flat(
  x0 : Double,
  y0 : Double,
  x1 : Double,
  y1 : Double,
  x2 : Double,
  y2 : Double,
  x3 : Double,
  y3 : Double,
  tol16_sq : Double,
) -> Bool {
  // Exact Wang/Hain cubic flatness bound: max(|3*P1 - 2*P0 - P3|^2, |3*P2 - P0 - 2*P3|^2) <= 16 * tol^2
  let ux = 3.0 * x1 - 2.0 * x0 - x3
  let uy = 3.0 * y1 - 2.0 * y0 - y3
  let vx = 3.0 * x2 - x0 - 2.0 * x3
  let vy = 3.0 * y2 - y0 - 2.0 * y3
  let d1 = ux * ux + uy * uy
  let d2 = vx * vx + vy * vy
  if !is_finite(d1) || !is_finite(d2) {
    return false
  }
  let m = if d1 > d2 { d1 } else { d2 }
  m <= tol16_sq
}

///| Adaptively flatten an `SvgPath` into polylines within geometric error `tolerance`.
pub fn flatten_path(
  path : SvgPath,
  tolerance : Double,
) -> Result[Array[Polyline], SvgError] {
  flatten_path_with_limits(path, tolerance, SvgLimits::default())
}

///| Adaptively flatten an `SvgPath` into polylines with explicit `SvgLimits`.
pub fn flatten_path_with_limits(
  path : SvgPath,
  tolerance : Double,
  limits : SvgLimits,
) -> Result[Array[Polyline], SvgError] {
  if !is_finite(tolerance) || tolerance <= 0.0 {
    return Err(
      SvgError::new(
        SvgErrorKind::InvalidNumber,
        0,
        "flatten tolerance must be finite and > 0",
      ),
    )
  }
  let cubics = match to_cubic_beziers_with_limits(path, limits) {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let tol16_sq = 16.0 * tolerance * tolerance
  let polys : Array[Polyline] = []
  let mut cur_pts : Array[Point] = []
  let mut has_subpath = false
  let mut total_pts = 0
  let mut cx = 0.0
  let mut cy = 0.0
  let mut sx = 0.0
  let mut sy = 0.0
  let stack : Array[CubicFrame] = []
  let n = cubics.length()
  let mut i = 0
  while i < n {
    match cubics[i] {
      CubicSegment::MoveTo(x, y) => {
        if has_subpath && cur_pts.length() > 0 {
          polys.push(Polyline::{ points: cur_pts, closed: false })
        }
        cur_pts = []
        has_subpath = true
        total_pts = total_pts + 1
        if total_pts > limits.max_flatten_points {
          return Err(
            SvgError::new(
              SvgErrorKind::LimitExceeded,
              i,
              "flatten_path exceeds max_flatten_points",
            ),
          )
        }
        cur_pts.push(Point::new(x, y))
        cx = x
        cy = y
        sx = x
        sy = y
      }
      CubicSegment::LineTo(x, y) => {
        if !has_subpath {
          has_subpath = true
          cur_pts = [Point::new(cx, cy)]
          total_pts = total_pts + 1
        }
        total_pts = total_pts + 1
        if total_pts > limits.max_flatten_points {
          return Err(
            SvgError::new(
              SvgErrorKind::LimitExceeded,
              i,
              "flatten_path exceeds max_flatten_points",
            ),
          )
        }
        cur_pts.push(Point::new(x, y))
        cx = x
        cy = y
      }
      CubicSegment::CurveTo(x1, y1, x2, y2, x3, y3) => {
        if !has_subpath {
          has_subpath = true
          cur_pts = [Point::new(cx, cy)]
          total_pts = total_pts + 1
        }
        stack.push(
          CubicFrame::{
            x0: cx,
            y0: cy,
            x1: x1,
            y1: y1,
            x2: x2,
            y2: y2,
            x3: x3,
            y3: y3,
            depth: 0,
          },
        )
        while stack.length() > 0 {
          let f = match stack.pop() {
            Some(v) => v
            None => break
          }
          if cubic_is_flat(f.x0, f.y0, f.x1, f.y1, f.x2, f.y2, f.x3, f.y3, tol16_sq) {
            total_pts = total_pts + 1
            if total_pts > limits.max_flatten_points {
              return Err(
                SvgError::new(
                  SvgErrorKind::LimitExceeded,
                  i,
                  "flatten_path exceeds max_flatten_points",
                ),
              )
            }
            cur_pts.push(Point::new(f.x3, f.y3))
          } else if f.depth >= 24 {
            return Err(
              SvgError::new(
                SvgErrorKind::LimitExceeded,
                i,
                "flatten_path exceeded subdivision depth without reaching tolerance",
              ),
            )
          } else {
            // De Casteljau midpoint split
            let x01 = (f.x0 + f.x1) * 0.5
            let y01 = (f.y0 + f.y1) * 0.5
            let x12 = (f.x1 + f.x2) * 0.5
            let y12 = (f.y1 + f.y2) * 0.5
            let x23 = (f.x2 + f.x3) * 0.5
            let y23 = (f.y2 + f.y3) * 0.5
            let x012 = (x01 + x12) * 0.5
            let y012 = (y01 + y12) * 0.5
            let x123 = (x12 + x23) * 0.5
            let y123 = (y12 + y23) * 0.5
            let mx = (x012 + x123) * 0.5
            let my = (y012 + y123) * 0.5
            let nd = f.depth + 1
            // Push right half first so left half is processed first (preserving point order)
            stack.push(
              CubicFrame::{
                x0: mx,
                y0: my,
                x1: x123,
                y1: y123,
                x2: x23,
                y2: y23,
                x3: f.x3,
                y3: f.y3,
                depth: nd,
              },
            )
            stack.push(
              CubicFrame::{
                x0: f.x0,
                y0: f.y0,
                x1: x01,
                y1: y01,
                x2: x012,
                y2: y012,
                x3: mx,
                y3: my,
                depth: nd,
              },
            )
          }
        }
        cx = x3
        cy = y3
      }
      CubicSegment::ClosePath => {
        if has_subpath && cur_pts.length() > 0 {
          polys.push(Polyline::{ points: cur_pts, closed: true })
          cur_pts = []
          has_subpath = false
        }
        cx = sx
        cy = sy
      }
    }
    i = i + 1
  }
  if has_subpath && cur_pts.length() > 0 {
    polys.push(Polyline::{ points: cur_pts, closed: false })
  }
  Ok(polys)
}

///| 5-point Gauss-Legendre quadrature for cubic Bézier arc length on `[0, 1]`.
fn cubic_speed(
  x0 : Double,
  y0 : Double,
  x1 : Double,
  y1 : Double,
  x2 : Double,
  y2 : Double,
  x3 : Double,
  y3 : Double,
  t : Double,
) -> Double {
  let mt = 1.0 - t
  let dx = 3.0 * mt * mt * (x1 - x0) +
  6.0 * mt * t * (x2 - x1) +
  3.0 * t * t * (x3 - x2)
  let dy = 3.0 * mt * mt * (y1 - y0) +
  6.0 * mt * t * (y2 - y1) +
  3.0 * t * t * (y3 - y2)
  hypot_f64(dx, dy)
}

fn cubic_gl5_len(
  x0 : Double,
  y0 : Double,
  x1 : Double,
  y1 : Double,
  x2 : Double,
  y2 : Double,
  x3 : Double,
  y3 : Double,
) -> Double {
  // Nodes mapped from [-1, 1] to [0, 1]
  let t0 = 0.04691007703066802
  let t1 = 0.23076534494715845
  let t2 = 0.5
  let t3 = 0.7692346550528415
  let t4 = 0.9530899229693319
  let w0 = 0.11846344252809454
  let w1 = 0.23931433524968324
  let w2 = 0.28444444444444444
  w0 * cubic_speed(x0, y0, x1, y1, x2, y2, x3, y3, t0) +
  w1 * cubic_speed(x0, y0, x1, y1, x2, y2, x3, y3, t1) +
  w2 * cubic_speed(x0, y0, x1, y1, x2, y2, x3, y3, t2) +
  w1 * cubic_speed(x0, y0, x1, y1, x2, y2, x3, y3, t3) +
  w0 * cubic_speed(x0, y0, x1, y1, x2, y2, x3, y3, t4)
}

fn cubic_deriv_roots_1d(p0 : Double, p1 : Double, p2 : Double, p3 : Double, out : Array[Double]) -> Unit {
  let a = -p0 + 3.0 * p1 - 3.0 * p2 + p3
  let b = 2.0 * (p0 - 2.0 * p1 + p2)
  let c = p1 - p0
  let mut cmin = p0
  if p1 < cmin { cmin = p1 }
  if p2 < cmin { cmin = p2 }
  if p3 < cmin { cmin = p3 }
  let mut cmax = p0
  if p1 > cmax { cmax = p1 }
  if p2 > cmax { cmax = p2 }
  if p3 > cmax { cmax = p3 }
  let span = cmax - cmin
  if span == 0.0 || !is_finite(span) {
    return
  }
  if a.abs() <= 1e-12 * span {
    if b != 0.0 {
      let t = -c / b
      if t > 1e-9 && t < 1.0 - 1e-9 {
        out.push(t)
      }
    }
  } else {
    let disc = b * b - 4.0 * a * c
    if disc >= 0.0 {
      let sq = disc.sqrt()
      let q = -0.5 * (b + (if b >= 0.0 { sq } else { -sq }))
      if q != 0.0 {
        let t1 = q / a
        if t1 > 1e-9 && t1 < 1.0 - 1e-9 {
          out.push(t1)
        }
        let t2 = c / q
        if t2 > 1e-9 && t2 < 1.0 - 1e-9 {
          out.push(t2)
        }
      } else {
        let t1 = -b / (2.0 * a)
        if t1 > 1e-9 && t1 < 1.0 - 1e-9 {
          out.push(t1)
        }
      }
    }
  }
}

fn cubic_split_at(
  x0 : Double,
  y0 : Double,
  x1 : Double,
  y1 : Double,
  x2 : Double,
  y2 : Double,
  x3 : Double,
  y3 : Double,
  t : Double,
) -> (CubicFrame, CubicFrame) {
  let mt = 1.0 - t
  let x01 = mt * x0 + t * x1
  let y01 = mt * y0 + t * y1
  let x12 = mt * x1 + t * x2
  let y12 = mt * y1 + t * y2
  let x23 = mt * x2 + t * x3
  let y23 = mt * y2 + t * y3
  let x012 = mt * x01 + t * x12
  let y012 = mt * y01 + t * y12
  let x123 = mt * x12 + t * x23
  let y123 = mt * y12 + t * y23
  let mx = mt * x012 + t * x123
  let my = mt * y012 + t * y123
  (
    CubicFrame::{ x0: x0, y0: y0, x1: x01, y1: y01, x2: x012, y2: y012, x3: mx, y3: my, depth: 0 },
    CubicFrame::{ x0: mx, y0: my, x1: x123, y1: y123, x2: x23, y2: y23, x3: x3, y3: y3, depth: 0 },
  )
}

fn cubic_arc_length(
  x0 : Double,
  y0 : Double,
  x1 : Double,
  y1 : Double,
  x2 : Double,
  y2 : Double,
  x3 : Double,
  y3 : Double,
) -> Double {
  // Pre-split at exact x'/y' roots so every piece is monotonic in x and y (no interior hairpin cusps).
  let roots : Array[Double] = []
  cubic_deriv_roots_1d(x0, x1, x2, x3, roots)
  cubic_deriv_roots_1d(y0, y1, y2, y3, roots)
  // Insertion sort (at most 4 roots)
  let mut ri = 1
  while ri < roots.length() {
    let key = roots[ri]
    let mut rj = ri - 1
    while rj >= 0 && roots[rj] > key {
      roots[rj + 1] = roots[rj]
      rj = rj - 1
    }
    roots[rj + 1] = key
    ri = ri + 1
  }
  let stack : Array[CubicFrame] = []
  let mut cur = CubicFrame::{
    x0: x0,
    y0: y0,
    x1: x1,
    y1: y1,
    x2: x2,
    y2: y2,
    x3: x3,
    y3: y3,
    depth: 0,
  }
  let mut t_prev = 0.0
  ri = 0
  while ri < roots.length() {
    let t = roots[ri]
    if t - t_prev > 1e-9 && 1.0 - t_prev > 1e-9 {
      let local_t = (t - t_prev) / (1.0 - t_prev)
      if local_t > 1e-9 && local_t < 1.0 - 1e-9 {
        let (left, right) = cubic_split_at(cur.x0, cur.y0, cur.x1, cur.y1, cur.x2, cur.y2, cur.x3, cur.y3, local_t)
        stack.push(left)
        cur = right
        t_prev = t
      }
    }
    ri = ri + 1
  }
  stack.push(cur)
  let mut total = 0.0
  while stack.length() > 0 {
    let f = match stack.pop() {
      Some(v) => v
      None => break
    }
    let whole = cubic_gl5_len(f.x0, f.y0, f.x1, f.y1, f.x2, f.y2, f.x3, f.y3)
    if f.depth >= 16 || !is_finite(whole) {
      total = total + whole
      continue
    }
    let x01 = (f.x0 + f.x1) * 0.5
    let y01 = (f.y0 + f.y1) * 0.5
    let x12 = (f.x1 + f.x2) * 0.5
    let y12 = (f.y1 + f.y2) * 0.5
    let x23 = (f.x2 + f.x3) * 0.5
    let y23 = (f.y2 + f.y3) * 0.5
    let x012 = (x01 + x12) * 0.5
    let y012 = (y01 + y12) * 0.5
    let x123 = (x12 + x23) * 0.5
    let y123 = (y12 + y23) * 0.5
    let mx = (x012 + x123) * 0.5
    let my = (y012 + y123) * 0.5
    let l1 = cubic_gl5_len(f.x0, f.y0, x01, y01, x012, y012, mx, my)
    let l2 = cubic_gl5_len(mx, my, x123, y123, x23, y23, f.x3, f.y3)
    let sum = l1 + l2
    if (whole - sum).abs() <= 1e-8 * sum {
      total = total + sum
    } else {
      let nd = f.depth + 1
      stack.push(
        CubicFrame::{
          x0: mx,
          y0: my,
          x1: x123,
          y1: y123,
          x2: x23,
          y2: y23,
          x3: f.x3,
          y3: f.y3,
          depth: nd,
        },
      )
      stack.push(
        CubicFrame::{
          x0: f.x0,
          y0: f.y0,
          x1: x01,
          y1: y01,
          x2: x012,
          y2: y012,
          x3: mx,
          y3: my,
          depth: nd,
        },
      )
    }
  }
  total
}

///| Compute total arc length of an `SvgPath` using adaptive numerical integration.
pub fn path_length(path : SvgPath) -> Double {
  let cubics = to_cubic_beziers(path)
  let mut total = 0.0
  let mut cx = 0.0
  let mut cy = 0.0
  let mut sx = 0.0
  let mut sy = 0.0
  let n = cubics.length()
  let mut i = 0
  while i < n {
    match cubics[i] {
      CubicSegment::MoveTo(x, y) => {
        cx = x
        cy = y
        sx = x
        sy = y
      }
      CubicSegment::LineTo(x, y) => {
        let dx = x - cx
        let dy = y - cy
        total = total + (dx * dx + dy * dy).sqrt()
        cx = x
        cy = y
      }
      CubicSegment::CurveTo(x1, y1, x2, y2, x, y) => {
        total = total + cubic_arc_length(cx, cy, x1, y1, x2, y2, x, y)
        cx = x
        cy = y
      }
      CubicSegment::ClosePath => {
        let dx = sx - cx
        let dy = sy - cy
        total = total + (dx * dx + dy * dy).sqrt()
        cx = sx
        cy = sy
      }
    }
    i = i + 1
  }
  total
}
