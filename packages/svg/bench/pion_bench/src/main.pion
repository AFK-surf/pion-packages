///| Head-to-head benchmark driver for `packages/svg` (W1 paths, W2 DOM+shapes+transforms, W3 optimize).

import "svg"

fn round_tenth(v : Double) -> Int64 {
  if v >= 0.0 {
    (v * 10.0 + 0.5).floor().to_int64()
  } else {
    -((-v * 10.0 + 0.5).floor().to_int64())
  }
}

fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 0x0A {
      if i > start {
        out.push(s.slice(start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(s.slice(start, n))
  }
  out
}

fn split_svgs(s : String) -> Array[String] {
  let sep = "\n---SVG---\n"
  let slen = sep.length()
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i + slen <= n {
    if s.code_unit_at(i) == 0x0A && s.slice(i, i + slen) == sep {
      out.push(s.slice(start, i))
      start = i + slen
      i = start
    } else {
      i = i + 1
    }
  }
  if start < n {
    out.push(s.slice(start, n))
  }
  out
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: svg_bench_pion <w1_paths|w2_dom|w3_opt> <file>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let src = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => {
      io_println(world, "error: failed to read input file")
      return 1
    }
  }

  if mode == "w1_paths" {
    let lines = split_lines(src)
    let mut path_cnt : Int64 = 0L
    let mut cubic_cnt : Int64 = 0L
    let mut bbox_sum : Int64 = 0L
    let mut i = 0
    while i < lines.length() {
      let p = match svg::parse_path(lines[i]) {
        Ok(v) => v
        Err(e) => {
          io_println(world, "parse_path error: " + e.to_string())
          return 1
        }
      }
      let cubics = svg::to_cubic_beziers(p)
      path_cnt = path_cnt + 1L
      cubic_cnt = cubic_cnt + cubics.length().to_int64()
      match svg::cubics_bbox(cubics) {
        Some(bb) => {
          bbox_sum = bbox_sum +
          round_tenth(bb.min_x) +
          round_tenth(bb.min_y) +
          round_tenth(bb.max_x) +
          round_tenth(bb.max_y)
        }
        None => ()
      }
      i = i + 1
    }
    io_println(world, "mode=w1_paths")
    io_println(world, "paths=" + path_cnt.to_string())
    io_println(world, "cubics=" + cubic_cnt.to_string())
    io_println(world, "bbox_sum_10=" + bbox_sum.to_string())
    return 0
  }

  if mode == "w2_dom" {
    let icons = split_svgs(src)
    let mut doc_cnt : Int64 = 0L
    let mut rpath_cnt : Int64 = 0L
    let mut seg_cnt : Int64 = 0L
    let mut bbox_sum : Int64 = 0L
    let mut i = 0
    while i < icons.length() {
      let doc = match svg::parse_svg(icons[i]) {
        Ok(d) => d
        Err(e) => {
          io_println(world, "parse_svg error: " + e.to_string())
          return 1
        }
      }
      let rps = match svg::extract_render_paths(doc) {
        Ok(r) => r
        Err(e) => {
          io_println(world, "extract error: " + e.to_string())
          return 1
        }
      }
      doc_cnt = doc_cnt + 1L
      rpath_cnt = rpath_cnt + rps.length().to_int64()
      let mut j = 0
      while j < rps.length() {
        let cubics = svg::transform_cubics(svg::to_cubic_beziers(rps[j].path), rps[j].transform)
        seg_cnt = seg_cnt + cubics.length().to_int64()
        match svg::cubics_bbox(cubics) {
          Some(bb) => {
            bbox_sum = bbox_sum +
            round_tenth(bb.min_x) +
            round_tenth(bb.min_y) +
            round_tenth(bb.max_x) +
            round_tenth(bb.max_y)
          }
          None => ()
        }
        j = j + 1
      }
      i = i + 1
    }
    io_println(world, "mode=w2_dom")
    io_println(world, "icons=" + doc_cnt.to_string())
    io_println(world, "render_paths=" + rpath_cnt.to_string())
    io_println(world, "cubics=" + seg_cnt.to_string())
    io_println(world, "bbox_sum_10=" + bbox_sum.to_string())
    return 0
  }

  if mode == "w3_opt" {
    let icons = split_svgs(src)
    let opts = svg::OptimizeOptions::default()
    let mut total_in : Int64 = 0L
    let mut total_out : Int64 = 0L
    let mut fnv : Int64 = 1469598103934665603L
    let mut i = 0
    while i < icons.length() {
      let raw = icons[i]
      total_in = total_in + raw.length().to_int64()
      let out = match svg::optimize_svg(raw, opts) {
        Ok(s) => s
        Err(e) => {
          io_println(world, "optimize error: " + e.to_string())
          return 1
        }
      }
      total_out = total_out + out.length().to_int64()
      let mut k = 0
      while k < out.length() {
        fnv = (fnv ^ out.code_unit_at(k).to_int64()) * 1099511628211L
        k = k + 1
      }
      i = i + 1
    }
    io_println(world, "mode=w3_opt")
    io_println(world, "icons=" + icons.length().to_string())
    io_println(world, "in_bytes=" + total_in.to_string())
    io_println(world, "out_bytes=" + total_out.to_string())
    io_println(world, "fnv64=" + fnv.to_string())
    return 0
  }

  io_println(world, "unknown mode: " + mode)
  1
}
