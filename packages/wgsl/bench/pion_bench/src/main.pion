///| Steady-state WGSL parse + validate + MSL/GLSL emit benchmark (Pion Native).

import "wgsl"

fn parse_pos_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b >= 48 && b <= 57 {
      acc = acc * 10 + (b - 48)
    }
    i = i + 1
  }
  acc
}

fn check_prefix(s : String, prefix : String) -> Bool {
  if s.length() < prefix.length() {
    return false
  }
  let mut i = 0
  while i < prefix.length() {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  let dir = if args.length() > 1 { args[1] } else { "/tmp/pion-wgsl-bench" }
  let iters = if args.length() > 2 { parse_pos_int(args[2]) } else { 200 }

  let pbr_src = match fs_read(world, dir + "/pbr.wgsl") {
    Ok(s) => s
    Err(_) => return 1
  }
  let red_src = match fs_read(world, dir + "/compute_reduce.wgsl") {
    Ok(s) => s
    Err(_) => return 1
  }
  let part_src = match fs_read(world, dir + "/particles.wgsl") {
    Ok(s) => s
    Err(_) => return 1
  }

  let opts_def = wgsl::CompileOptions::default()
  let opts_vs = wgsl::CompileOptions::with_entry_point("vs_main")
  let opts_fs = wgsl::CompileOptions::with_entry_point("fs_main")
  let opts_red = wgsl::CompileOptions::with_entry_point("reduce_main")
  let opts_part = wgsl::CompileOptions::with_entry_point("step_particles")

  let mut entries_total = 0
  let mut bindings_total = 0
  let mut wg_x_total = 0
  let mut msl_ok = 0
  let mut glsl_ok = 0

  let mut it = 0
  while it < iters {
    match wgsl::compile_to_msl(pbr_src, opts_def) {
      Ok(m) => {
        entries_total = entries_total + m.reflection.entries.length()
        bindings_total = bindings_total + m.reflection.bindings.length()
        if check_prefix(m.source, "#include <metal_stdlib>") {
          msl_ok = msl_ok + 1
        }
      }
      Err(_) => return 2
    }
    match wgsl::compile_to_glsl(pbr_src, opts_vs) {
      Ok(g) => if check_prefix(g.source, "#version ") { glsl_ok = glsl_ok + 1 }
      Err(_) => return 3
    }
    match wgsl::compile_to_glsl(pbr_src, opts_fs) {
      Ok(g) => if check_prefix(g.source, "#version ") { glsl_ok = glsl_ok + 1 }
      Err(_) => return 4
    }
    match wgsl::compile_to_msl(red_src, opts_def) {
      Ok(m) => {
        entries_total = entries_total + m.reflection.entries.length()
        bindings_total = bindings_total + m.reflection.bindings.length()
        wg_x_total = wg_x_total + m.reflection.entries[0].workgroup_size_x
        if check_prefix(m.source, "#include <metal_stdlib>") {
          msl_ok = msl_ok + 1
        }
      }
      Err(_) => return 5
    }
    match wgsl::compile_to_glsl(red_src, opts_red) {
      Ok(g) => if check_prefix(g.source, "#version ") { glsl_ok = glsl_ok + 1 }
      Err(_) => return 6
    }
    match wgsl::compile_to_msl(part_src, opts_def) {
      Ok(m) => {
        entries_total = entries_total + m.reflection.entries.length()
        bindings_total = bindings_total + m.reflection.bindings.length()
        wg_x_total = wg_x_total + m.reflection.entries[0].workgroup_size_x
        if check_prefix(m.source, "#include <metal_stdlib>") {
          msl_ok = msl_ok + 1
        }
      }
      Err(_) => return 7
    }
    match wgsl::compile_to_glsl(part_src, opts_part) {
      Ok(g) => if check_prefix(g.source, "#version ") { glsl_ok = glsl_ok + 1 }
      Err(_) => return 8
    }
    it = it + 1
  }

  io_println(world, "iters=" + iters.to_string())
  io_println(world, "entries=" + entries_total.to_string())
  io_println(world, "bindings=" + bindings_total.to_string())
  io_println(world, "wg_x_sum=" + wg_x_total.to_string())
  io_println(world, "msl_ok=" + msl_ok.to_string())
  io_println(world, "glsl_ok=" + glsl_ok.to_string())
  0
}
