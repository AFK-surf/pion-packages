///| WGSL -> GLSL ES 3.00 (vertex/fragment) and GLSL 450 (compute) backend tests.

test "glsl_es300_vertex_shader" {
  let src =
  #|struct Uniforms {
  #| mvp : mat4x4f,
  #| tint : vec4f,
  #|}
  #|struct VsOut {
  #| @builtin(position) pos : vec4f,
  #| @location(0) uv : vec2f,
  #|}
  #|@group(0) @binding(0) var<uniform> u : Uniforms;
  #|
  #|@vertex
  #|fn vs_main(
  #| @location(0) pos : vec3f,
  #| @location(1) uv : vec2f,
  #| @builtin(vertex_index) vid : u32,
  #|) -> VsOut {
  #| var out : VsOut;
  #| out.pos = u.mvp * vec4f(pos, 1.0);
  #| out.uv = uv + vec2f(f32(vid) * 0.0, 0.0);
  #| return out;
  #|}
  match compile_to_glsl(src, CompileOptions::with_entry_point("vs_main")) {
    Ok(compiled) => {
      debug_assert(test_contains(compiled.source, "#version 300 es"), "version 300 es")
      debug_assert(test_contains(compiled.source, "layout(location = 0) in vec3 pos;"), "in pos")
      debug_assert(test_contains(compiled.source, "layout(location = 1) in vec2 uv;"), "in uv")
      debug_assert(test_contains(compiled.source, "out vec2 _wgsl_v_loc0;"), "out uv")
      debug_assert(test_contains(compiled.source, "layout(std140) uniform"), "std140 uniform")
      debug_assert(test_contains(compiled.source, "gl_Position"), "gl_Position")
      debug_assert(test_contains(compiled.source, "gl_VertexID"), "gl_VertexID")
      debug_assert(test_contains(compiled.source, "void main()"), "void main")
    }
    Err(e) => debug_assert(false, "compile_to_glsl failed: " + e.to_string())
  }
}

test "glsl_es300_fragment_shader_builtins" {
  let src =
  #|@group(0) @binding(0) var tex : texture_2d<f32>;
  #|@group(0) @binding(1) var samp : sampler;
  #|
  #|@fragment
  #|fn fs_main(@location(0) uv : vec2f, @builtin(front_facing) ff : bool) -> @location(0) vec4f {
  #| let c = textureSample(tex, samp, uv);
  #| let f = fract(uv.x);
  #| let m = mix(c.rgb, vec3f(f), saturate(uv.y));
  #| let dx = dpdx(uv.x);
  #| let r = inverseSqrt(max(dx * dx, 0.001));
  #| return select(vec4f(m * 0.5, 1.0), vec4f(m * r, 1.0), ff);
  #|}
  match compile_to_glsl(src, CompileOptions::with_entry_point("fs_main")) {
    Ok(compiled) => {
      debug_assert(test_contains(compiled.source, "#version 300 es"), "version 300 es")
      debug_assert(test_contains(compiled.source, "precision highp float;"), "precision")
      debug_assert(test_contains(compiled.source, "in vec2 _wgsl_v_loc0;"), "in uv")
      debug_assert(test_contains(compiled.source, "layout(location = 0) out vec4 _fs_out_0;"), "out 0")
      debug_assert(test_contains(compiled.source, "texture(tex, _wgsl_v_loc0)"), "texture()")
      debug_assert(test_contains(compiled.source, "fract("), "fract()")
      debug_assert(test_contains(compiled.source, "mix("), "mix()")
      debug_assert(test_contains(compiled.source, "clamp("), "clamp()")
      debug_assert(test_contains(compiled.source, "dFdx("), "dFdx()")
      debug_assert(test_contains(compiled.source, "inversesqrt("), "inversesqrt()")
      debug_assert(test_contains(compiled.source, "gl_FrontFacing"), "gl_FrontFacing")
      debug_assert(test_contains(compiled.source, " ? "), "ternary select")
    }
    Err(e) => debug_assert(false, "compile_to_glsl failed: " + e.to_string())
  }
}

test "glsl_450_compute_shader" {
  let src =
  #|@group(0) @binding(0) var<storage, read> src_data : array<f32>;
  #|@group(0) @binding(1) var<storage, read_write> dst_data : array<f32>;
  #|
  #|@compute @workgroup_size(64, 1, 1)
  #|fn cs_main(@builtin(global_invocation_id) gid : vec3u) {
  #| let idx = gid.x;
  #| dst_data[idx] = src_data[idx] * 2.0;
  #| workgroupBarrier();
  #|}
  match compile_to_glsl(src, CompileOptions::with_entry_point("cs_main")) {
    Ok(compiled) => {
      debug_assert(test_contains(compiled.source, "#version 450"), "version 450")
      debug_assert(
        test_contains(compiled.source, "layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;"),
        "local_size",
      )
      debug_assert(test_contains(compiled.source, "layout(std430, binding = 0)"), "std430 0")
      debug_assert(test_contains(compiled.source, "layout(std430, binding = 1)"), "std430 1")
      debug_assert(test_contains(compiled.source, "gl_GlobalInvocationID"), "gl_GlobalInvocationID")
      debug_assert(test_contains(compiled.source, "barrier()"), "barrier()")
    }
    Err(e) => debug_assert(false, "compile_to_glsl failed: " + e.to_string())
  }
}
