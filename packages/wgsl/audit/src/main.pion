///| Red-team CLI for `packages/wgsl` (identical source for native and wasm32).
///|   selftest                        -> run every red-team/control case: `PASS|FAIL <name>` per line; exit 1 on any FAIL
///|   digest <list> <out>             -> one deterministic verdict line per WGSL file listed in <list>
///|   msl <in> <out>                  -> compile_to_msl; write MSL to <out>; print `OK <entries>` | `ERR <kind> <msg>`
///|   glsl <in> <entry|-> <out>       -> compile_to_glsl for one entry point (`-` = default)
///|   reflect <in>                    -> print the ModuleReflection as text
///|   time <in> [src tok depth]       -> verdict + microseconds of parse/validate/MSL/GLSL with the given ParseLimits
///|   gen_dos <dir>                   -> write the DoS probe corpus

import "wgsl"
import "crypto"

///|
fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut neg = false
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 45 && i == 0 {
      neg = true
    } else if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  if neg {
    0 - acc
  } else {
    acc
  }
}

///|
fn to_bytes(s : String) -> Bytes {
  s.to_bytes()
}

///| First 16 hex digits of SHA-256 of `s`.
pub fn rt_h(s : String) -> String {
  crypto::sha256_hex(to_bytes(s)).slice(0, 16)
}

///|
pub fn rt_kind(k : wgsl::WgslErrorKind) -> String {
  match k {
    wgsl::WgslErrorKind::EmptySource => "Empty"
    wgsl::WgslErrorKind::LimitExceeded => "Limit"
    wgsl::WgslErrorKind::LexError => "Lex"
    wgsl::WgslErrorKind::ParseError => "Parse"
    wgsl::WgslErrorKind::ValidationError => "Validate"
    wgsl::WgslErrorKind::CodegenError => "Codegen"
  }
}

///|
pub fn rt_err(e : wgsl::WgslError) -> String {
  "ERR " + rt_kind(e.kind) + "@" + e.line.to_string() + ":" + e.col.to_string()
}

///|
fn rt_stage(s : wgsl::EntryStage) -> String {
  match s {
    wgsl::EntryStage::Vertex => "vertex"
    wgsl::EntryStage::Fragment => "fragment"
    wgsl::EntryStage::Compute => "compute"
  }
}

///|
fn rt_bkind(k : wgsl::BindingKind) -> String {
  match k {
    wgsl::BindingKind::Uniform => "uniform"
    wgsl::BindingKind::StorageRead => "storage_read"
    wgsl::BindingKind::StorageReadWrite => "storage_rw"
    wgsl::BindingKind::Texture1d => "tex1d"
    wgsl::BindingKind::Texture2d => "tex2d"
    wgsl::BindingKind::Texture2dArray => "tex2darr"
    wgsl::BindingKind::TextureCube => "texcube"
    wgsl::BindingKind::TextureCubeArray => "texcubearr"
    wgsl::BindingKind::Texture3d => "tex3d"
    wgsl::BindingKind::TextureDepth2d => "depth2d"
    wgsl::BindingKind::TextureDepth2dArray => "depth2darr"
    wgsl::BindingKind::TextureDepthCube => "depthcube"
    wgsl::BindingKind::TextureMultisampled2d => "ms2d"
    wgsl::BindingKind::TextureStorage1d => "storage1d"
    wgsl::BindingKind::TextureStorage2d => "storage2d"
    wgsl::BindingKind::TextureStorage2dArray => "storage2darr"
    wgsl::BindingKind::TextureStorage3d => "storage3d"
    wgsl::BindingKind::Sampler => "sampler"
    wgsl::BindingKind::SamplerComparison => "sampler_cmp"
  }
}

///| Deterministic text form of a `ModuleReflection`.
pub fn rt_refl(r : wgsl::ModuleReflection) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < r.entries.length() {
    let e = r.entries[i]
    sb.write_string(
      "entry " + e.name + " " + rt_stage(e.stage) + " msl=" + e.msl_name + " wg=" +
      e.workgroup_size_x.to_string() + "," + e.workgroup_size_y.to_string() + "," +
      e.workgroup_size_z.to_string() + " in=" + e.inputs.length().to_string() + " out=" +
      e.outputs.length().to_string() + "\n",
    )
    i = i + 1
  }
  i = 0
  while i < r.bindings.length() {
    let b = r.bindings[i]
    sb.write_string(
      "binding " + b.name + " g=" + b.group.to_string() + " b=" + b.binding.to_string() + " " +
      rt_bkind(b.kind) + " slot=" + b.msl_slot.to_string() + " ty=" + b.wgsl_type + "\n",
    )
    i = i + 1
  }
  i = 0
  while i < r.structs.length() {
    sb.write_string("struct " + r.structs[i].name + " fields=" + r.structs[i].fields.length().to_string() + "\n")
    i = i + 1
  }
  i = 0
  while i < r.overrides.length() {
    let o = r.overrides[i]
    sb.write_string("override " + o.name + " id=" + o.id.to_string() + " ty=" + o.wgsl_type + "\n")
    i = i + 1
  }
  sb.to_string()
}

///| One verdict line for a WGSL source: parse / validate / MSL / GLSL(default entry).
pub fn rt_digest(src : String) -> String {
  let lim = wgsl::ParseLimits::default()
  let p = match wgsl::parse(src, lim) {
    Ok(m) => "OK f" + m.funcs.length().to_string() + " s" + m.structs.length().to_string() + " g" + m.globals.length().to_string()
    Err(e) => rt_err(e)
  }
  let v = match wgsl::validate(src, lim) {
    Ok(r) => "OK " + rt_h(rt_refl(r))
    Err(e) => rt_err(e)
  }
  let m = match wgsl::compile_to_msl(src, wgsl::CompileOptions::default()) {
    Ok(c) => "OK " + rt_h(c.source)
    Err(e) => rt_err(e)
  }
  let g = match wgsl::compile_to_glsl(src, wgsl::CompileOptions::default()) {
    Ok(c) => "OK " + rt_h(c.source)
    Err(e) => rt_err(e)
  }
  "P[" + p + "] V[" + v + "] M[" + m + "] G[" + g + "]"
}

///|
fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i <= s.length() {
    if i == s.length() || s.code_unit_at(i) == 10 {
      if i > start {
        out.push(s.slice(start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  out
}

///|
fn read_src(world : World, path : String) -> Option[String] {
  match fs_read_bytes(world, path) {
    Ok(b) => Some(b.to_string())
    Err(_) => None
  }
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: wgsl_audit selftest | digest <list> <out> | msl <in> <out> | glsl <in> <entry|-> <out> | reflect <in> | time <in> [src tok depth] | gen_dos <dir>")
    return 2
  }
  let mode = args[1]
  if mode == "selftest" {
    let names = rt_all_cases()
    let mut failed = 0
    let mut i = 0
    while i < names.length() {
      let r = rt_run_case(names[i])
      if r == "" {
        io_println(world, "PASS " + names[i])
      } else {
        io_println(world, "FAIL " + names[i] + " :: " + r)
        failed = failed + 1
      }
      i = i + 1
    }
    io_println(world, "selftest: " + (names.length() - failed).to_string() + "/" + names.length().to_string() + " passed")
    return if failed == 0 { 0 } else { 1 }
  }
  if mode == "digest" && args.length() >= 4 {
    let list = match read_src(world, args[2]) {
      Some(s) => s
      None => return 3
    }
    let paths = split_lines(list)
    let out = StringBuilder::new()
    let mut i = 0
    while i < paths.length() {
      let line = match read_src(world, paths[i]) {
        Some(src) => rt_digest(src)
        None => "READFAIL"
      }
      out.write_string(paths[i] + " " + line + "\n")
      i = i + 1
    }
    let _ = fs_write_bytes(world, args[3], to_bytes(out.to_string()))
    return 0
  }
  if mode == "msl" && args.length() >= 4 {
    let src = match read_src(world, args[2]) {
      Some(s) => s
      None => return 3
    }
    match wgsl::compile_to_msl(src, wgsl::CompileOptions::default()) {
      Ok(c) => {
        let _ = fs_write_bytes(world, args[3], to_bytes(c.source))
        io_println(world, "OK " + c.reflection.entries.length().to_string())
        return 0
      }
      Err(e) => {
        io_println(world, rt_err(e) + " " + e.message)
        return 1
      }
    }
  }
  if mode == "glsl" && args.length() >= 5 {
    let src = match read_src(world, args[2]) {
      Some(s) => s
      None => return 3
    }
    let opts = if args[3] == "-" {
      wgsl::CompileOptions::default()
    } else {
      wgsl::CompileOptions::with_entry_point(args[3])
    }
    match wgsl::compile_to_glsl(src, opts) {
      Ok(c) => {
        let _ = fs_write_bytes(world, args[4], to_bytes(c.source))
        io_println(world, "OK")
        return 0
      }
      Err(e) => {
        io_println(world, rt_err(e) + " " + e.message)
        return 1
      }
    }
  }
  if mode == "reflect" && args.length() >= 3 {
    let src = match read_src(world, args[2]) {
      Some(s) => s
      None => return 3
    }
    match wgsl::reflect(src) {
      Ok(r) => io_println(world, rt_refl(r))
      Err(e) => io_println(world, rt_err(e) + " " + e.message)
    }
    return 0
  }
  if mode == "time" && args.length() >= 3 {
    let src = match read_src(world, args[2]) {
      Some(s) => s
      None => return 3
    }
    let lim = if args.length() >= 6 {
      wgsl::ParseLimits::new(parse_int(args[3]), parse_int(args[4]), parse_int(args[5]))
    } else {
      wgsl::ParseLimits::default()
    }
    let t0 = clock_monotonic_us()
    let v = match wgsl::compile_to_msl(src, wgsl::CompileOptions::with_limits(lim)) {
      Ok(c) => "OK msl_bytes=" + c.source.length().to_string()
      Err(e) => rt_err(e) + " " + e.message
    }
    let t1 = clock_monotonic_us()
    let g = match wgsl::compile_to_glsl(src, wgsl::CompileOptions::with_limits(lim)) {
      Ok(c) => "OK glsl_bytes=" + c.source.length().to_string()
      Err(e) => rt_err(e)
    }
    let t2 = clock_monotonic_us()
    io_println(world, v + " | " + g + " | us=" + (t1 - t0).to_string() + "," + (t2 - t1).to_string())
    return 0
  }
  if mode == "stages" && args.length() >= 4 {
    // Stage split of the bench workload, comparable with `wgsl_audit_naga stages`.
    let srcs : Array[String] = []
    let names = ["pbr.wgsl", "compute_reduce.wgsl", "particles.wgsl"]
    let mut k = 0
    while k < names.length() {
      match read_src(world, args[2] + "/" + names[k]) {
        Some(s) => srcs.push(s)
        None => return 3
      }
      k = k + 1
    }
    let iters = parse_int(args[3])
    let t0 = clock_monotonic_us()
    let mut it = 0
    while it < iters {
      k = 0
      while k < srcs.length() {
        let _ = wgsl::parse(srcs[k], wgsl::ParseLimits::default())
        k = k + 1
      }
      it = it + 1
    }
    let t1 = clock_monotonic_us()
    it = 0
    while it < iters {
      k = 0
      while k < srcs.length() {
        let _ = wgsl::validate(srcs[k], wgsl::ParseLimits::default())
        k = k + 1
      }
      it = it + 1
    }
    let t2 = clock_monotonic_us()
    io_println(
      world,
      "pion parse_only_ms=" + ((t1 - t0) / 1000L).to_string() + " parse_validate_ms=" + ((t2 - t1) / 1000L).to_string() +
      " (x" + iters.to_string() + " over pbr+reduce+particles, one pass each)",
    )
    return 0
  }
  if mode == "gen_dos" && args.length() >= 3 {
    let cases = rt_dos_cases()
    let mut i = 0
    while i < cases.length() {
      let (name, src) = cases[i]
      let _ = fs_write_bytes(world, args[2] + "/" + name + ".wgsl", to_bytes(src))
      i = i + 1
    }
    io_println(world, "gen_dos: " + cases.length().to_string() + " files")
    return 0
  }
  io_println(world, "bad arguments")
  2
}
