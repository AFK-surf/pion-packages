///| Red-team (`redteam_*`) and control (`control_*`) cases for `packages/wgsl` @ f1bb2c4.
///| Every case returns "" when the package behaves as WGSL / the API contract requires, otherwise the evidence.
///| `redteam_*` cases FAIL on the audited baseline; `control_*` cases PASS and guard against regressions.
///| Cases that crash the process (stack overflow) are not here: they live in `rt_dos_cases` and are run in a
///| separate process per input by `run_audit.sh dos`.

import "wgsl"

///|
fn lim() -> wgsl::ParseLimits {
  wgsl::ParseLimits::default()
}

///| "" when `validate` rejects `src`, otherwise the evidence.
pub fn rt_must_reject(src : String, why : String) -> String {
  match wgsl::validate(src, lim()) {
    Ok(_) => "accepted invalid WGSL (" + why + ")"
    Err(_) => ""
  }
}

///| "" when `validate` accepts `src`.
pub fn rt_must_accept(src : String, why : String) -> String {
  match wgsl::validate(src, lim()) {
    Ok(_) => ""
    Err(e) => "rejected valid WGSL (" + why + "): " + e.to_string()
  }
}

///|
fn msl(src : String) -> Result[String, String] {
  match wgsl::compile_to_msl(src, wgsl::CompileOptions::default()) {
    Ok(c) => Ok(c.source)
    Err(e) => Err(e.to_string())
  }
}

///|
fn glsl(src : String, entry : String) -> Result[String, String] {
  match wgsl::compile_to_glsl(src, wgsl::CompileOptions::with_entry_point(entry)) {
    Ok(c) => Ok(c.source)
    Err(e) => Err(e.to_string())
  }
}

///|
fn has(hay : String, needle : String) -> Bool {
  hay.contains(needle)
}

///|
fn cs(body : String) -> String {
  "@group(0) @binding(0) var<storage, read_write> o : array<f32>;\n@compute @workgroup_size(1)\nfn cs_main() {\n" +
  body +
  "\n}\n"
}

///|
pub fn rt_pbr() -> String {
  #|struct Camera { view_proj : mat4x4f, eye_pos : vec4f }
  #|struct VsIn { @location(0) pos : vec3f, @location(1) normal : vec3f, @location(2) uv : vec2f }
  #|struct VsOut {
  #| @builtin(position) clip_pos : vec4f,
  #| @location(0) world_pos : vec3f,
  #| @location(1) normal : vec3f,
  #| @location(2) uv : vec2f,
  #|}
  #|@group(0) @binding(0) var<uniform> cam : Camera;
  #|@group(1) @binding(0) var albedo_tex : texture_2d<f32>;
  #|@group(1) @binding(1) var linear_samp : sampler;
  #|@group(2) @binding(0) var<storage, read> lights : array<vec4f>;
  #|@group(2) @binding(1) var<storage, read_write> stats : array<atomic<u32>>;
  #|const WG : u32 = 64u;
  #|@vertex
  #|fn vs_main(in : VsIn) -> VsOut {
  #| var out : VsOut;
  #| out.clip_pos = cam.view_proj * vec4f(in.pos, 1.0);
  #| out.world_pos = in.pos;
  #| out.normal = normalize(in.normal);
  #| out.uv = in.uv;
  #| return out;
  #|}
  #|@fragment
  #|fn fs_main(in : VsOut) -> @location(0) vec4f {
  #| let base = textureSample(albedo_tex, linear_samp, in.uv);
  #| let n = normalize(in.normal);
  #| let l = normalize(vec3f(0.5, 0.8, 0.3));
  #| let ndotl = max(dot(n, l), 0.0);
  #| return vec4f(base.rgb * (0.15 + 0.85 * ndotl), base.a);
  #|}
  #|@compute @workgroup_size(WG, 2, 1)
  #|fn count(@builtin(global_invocation_id) gid : vec3u) {
  #| if gid.x < arrayLength(&lights) { atomicAdd(&stats[0], 1u); }
  #|}
}

// ---------------------------------------------------------------- controls (PASS on the baseline)

///| Reflection of a module with three stages, three bind groups, storage read vs read_write, texture,
///| sampler and a const-sized workgroup.
pub fn control_reflection_multi_entry() -> String {
  match wgsl::reflect(rt_pbr()) {
    Err(e) => "reflect failed: " + e.to_string()
    Ok(r) => {
      if r.entries.length() != 3 {
        return "entries=" + r.entries.length().to_string()
      }
      let c = r.entries[2]
      if c.name != "count" || c.workgroup_size_x != 64 || c.workgroup_size_y != 2 || c.workgroup_size_z != 1 {
        return "compute entry " + c.name + " wg=" + c.workgroup_size_x.to_string()
      }
      if r.entries[0].inputs.length() != 3 || r.entries[0].outputs.length() != 4 {
        return "vs io " + r.entries[0].inputs.length().to_string() + "/" + r.entries[0].outputs.length().to_string()
      }
      if r.bindings.length() != 5 {
        return "bindings=" + r.bindings.length().to_string()
      }
      let ok_kinds = match (r.bindings[0].kind, r.bindings[1].kind, r.bindings[2].kind, r.bindings[3].kind, r.bindings[4].kind) {
        (
          wgsl::BindingKind::Uniform,
          wgsl::BindingKind::Texture2d,
          wgsl::BindingKind::Sampler,
          wgsl::BindingKind::StorageRead,
          wgsl::BindingKind::StorageReadWrite,
        ) => true
        _ => false
      }
      if !ok_kinds {
        return "binding kinds wrong"
      }
      if r.bindings[3].group != 2 || r.bindings[3].binding != 0 || r.bindings[4].binding != 1 {
        return "binding numbers wrong"
      }
      ""
    }
  }
}

///| Nested block comments, `>>` closing two template lists, shifts, compound shift-assign and `<`/`>`
///| comparisons that are not template lists.
pub fn control_lexer_template_edges() -> String {
  let src = "/* outer /* inner */ still comment */\n" +
  "var<private> a : array<vec4<f32>, 4>;\nvar<private> b : array<vec2<u32>>;\n" +
  cs(
    "  var x = 1u;\n  x = x >> 1u;\n  x >>= 1u;\n  x <<= 2u;\n  let p = 1; let q = 2; let r = 3; let s = 4;\n" +
    "  let t = p < q && r > s;\n  for (var i = 0u; i < 4u; i++) { x += i; }\n",
  )
  match wgsl::parse(src, lim()) {
    Ok(m) => if m.globals.length() == 3 { "" } else { "globals=" + m.globals.length().to_string() }
    Err(e) => "parse failed: " + e.to_string()
  }
}

///| Statement coverage: switch/case/default, loop/continuing/break if, for, while, pointers, matrices.
pub fn control_statement_coverage() -> String {
  let src = cs(
    "  var i = 0;\n  switch i { case 0, 1: { i = 2; } case 2 { } default { } }\n" +
    "  loop { i = i + 1; continuing { break if i > 3; } }\n" +
    "  while i < 10 { i++; if i == 7 { break; } else if i == 8 { continue; } else { } }\n" +
    "  var v = 1.0; let pv = &v; *pv = 2.0;\n  let m = mat2x2<f32>(1.0, 0.0, 0.0, 1.0); o[0] = m[1][1] * v;\n" +
    "  _ = o[1];\n",
  )
  match msl(src) {
    Ok(_) => ""
    Err(e) => "MSL failed: " + e
  }
}

///| Malformed inputs fail cleanly with a located error.
pub fn control_malformed_inputs() -> String {
  let bad : Array[(String, String)] = [
    ("unterminated nested comment", "fn f() {} /* /* */"),
    ("NUL byte", "fn f() {}\n\u{0}"),
    ("non-ASCII byte outside identifier", "fn f() { let x = 1 \u{00A7} 2; }"),
    ("lone exponent", "fn f() { let x = 1e; }"),
    ("hex without digits", "fn f() { let x = 0x; }"),
    ("truncated template", "var<private> a : array<vec4<f32>;"),
    ("truncated fn", "fn f( "),
    ("stray brace", "}"),
    ("only comment", "// nothing"),
    ("empty", ""),
  ]
  let mut i = 0
  while i < bad.length() {
    let (what, src) = bad[i]
    match wgsl::validate(src, lim()) {
      Ok(_) => return "accepted " + what
      Err(e) =>
      if src.length() > 0 && what != "only comment" && e.line <= 0 {
        return what + ": error without location: " + e.to_string()
      }
    }
    i = i + 1
  }
  ""
}

///| Every prefix of a real shader is answered (Ok or Err) without a panic.
pub fn control_every_prefix() -> String {
  let src = rt_pbr()
  let mut n = 0
  while n <= src.length() {
    let _ = wgsl::compile_to_msl(src.slice(0, n), wgsl::CompileOptions::default())
    let _ = wgsl::compile_to_glsl(src.slice(0, n), wgsl::CompileOptions::default())
    n = n + 7
  }
  ""
}

///| Structural checks that do exist: duplicates, workgroup_size, break/discard placement.
pub fn control_structural_rejections() -> String {
  let bad : Array[(String, String)] = [
    ("duplicate struct", "struct A { x : f32 }\nstruct A { y : f32 }"),
    ("duplicate field", "struct A { x : f32, x : f32 }"),
    ("duplicate fn", "fn f() {}\nfn f() {}"),
    ("duplicate global", "var<private> g : f32;\nvar<private> g : f32;"),
    ("duplicate binding", "@group(0) @binding(0) var<uniform> a : vec4f;\n@group(0) @binding(0) var<uniform> b : vec4f;"),
    ("workgroup_size(0)", "@compute @workgroup_size(0) fn c() {}"),
    ("workgroup_size(-1)", "@compute @workgroup_size(-1) fn c() {}"),
    ("missing workgroup_size", "@compute fn c() {}"),
    ("workgroup_size > 1024 total", "@compute @workgroup_size(64, 64) fn c() {}"),
    ("break outside loop", "fn f() { break; }"),
    ("continue in switch only", "fn f() { switch 1 { default { continue; } } }"),
    ("discard in vertex", "@vertex fn v() -> @builtin(position) vec4f { discard; }"),
    ("undeclared type", "var<private> x : Missing;"),
    ("reserved word", "fn f() { let typedef = 1; }"),
    ("two stages", "@vertex @fragment fn f() {}"),
  ]
  let mut i = 0
  while i < bad.length() {
    let (what, src) = bad[i]
    let r = rt_must_reject(src, what)
    if r != "" {
      return r
    }
    i = i + 1
  }
  ""
}

///| `ParseLimits` are enforced (tokens, bytes, nesting of parens/blocks/templates).
pub fn control_parse_limits() -> String {
  let src = rt_pbr()
  let checks : Array[(String, wgsl::ParseLimits)] = [
    ("bytes", wgsl::ParseLimits::new(100, 0, 0)),
    ("tokens", wgsl::ParseLimits::new(0, 50, 0)),
  ]
  let mut i = 0
  while i < checks.length() {
    let (what, l) = checks[i]
    match wgsl::parse(src, l) {
      Ok(_) => return "limit " + what + " not enforced"
      Err(e) =>
      match e.kind {
        wgsl::WgslErrorKind::LimitExceeded => ()
        _ => return "limit " + what + " gave " + e.to_string()
      }
    }
    i = i + 1
  }
  let deep = cs("  o[0] = " + rt_rep("(", 70) + "1.0" + rt_rep(")", 70) + ";")
  match wgsl::parse(deep, wgsl::ParseLimits::new(0, 0, 64)) {
    Ok(_) => "70 nested parens accepted with max_nesting_depth=64"
    Err(_) => ""
  }
}

// ---------------------------------------------------------------- P0: parser/DoS (non-crashing proxies)

///| `max_nesting_depth` must bound index nesting `o[o[o[...]]]` like it bounds parens; without it the
///| recursion is unbounded (native SIGSEGV at ~10k levels / 30 KB, wasm32 RangeError at 500 levels / 1.6 KB).
pub fn redteam_p0_index_nesting_ignores_depth_limit() -> String {
  let deep = cs("  o[0] = " + rt_rep("o[", 100) + "0" + rt_rep("]", 100) + ";")
  match wgsl::parse(deep, wgsl::ParseLimits::new(0, 0, 64)) {
    Ok(_) => "100 nested index expressions accepted with max_nesting_depth=64 (parser.pion:1657 never calls enter_depth)"
    Err(_) => ""
  }
}

///| Expression trees built iteratively by the parser (binary chains, field/index chains) must still be
///| depth-bounded, because validate/MSL/GLSL walk them recursively (wasm32 overflows at ~1.7k terms).
pub fn redteam_p0_binary_chain_unbounded_tree_depth() -> String {
  let chain = cs("  let a = 1.0;\n  o[0] = " + rt_rep("a+", 500) + "a;")
  match wgsl::compile_to_msl(chain, wgsl::CompileOptions::with_limits(wgsl::ParseLimits::new(0, 0, 64))) {
    Ok(_) => "a 501-term binary chain (tree depth 500) passes max_nesting_depth=64 into recursive codegen"
    Err(_) => ""
  }
}

///| A 500-deep postfix chain `a.x.x.x...` is invalid WGSL and as deep as the binary chain; it must be refused
///| (depth limit or type error) before the recursive passes run (wasm32 overflows at ~1.7k levels).
pub fn redteam_p0_field_chain_unbounded_tree_depth() -> String {
  let chain = cs("  let a = vec4<f32>(1.0);\n  o[0] = a" + rt_rep(".x", 500) + ";")
  match wgsl::compile_to_msl(chain, wgsl::CompileOptions::with_limits(wgsl::ParseLimits::new(0, 0, 64))) {
    Ok(_) => "a 500-deep `.x.x.x` chain compiled with max_nesting_depth=64"
    Err(_) => ""
  }
}

// ---------------------------------------------------------------- P1: validator accepts invalid WGSL

///|
pub fn redteam_p1_struct_self_reference() -> String {
  rt_must_reject("struct A { x : f32, a : A }\n" + cs("  var v : A;"), "struct A contains A")
}

///|
pub fn redteam_p1_struct_mutual_recursion() -> String {
  rt_must_reject("struct A { b : B }\nstruct B { a : A }\n" + cs(""), "A contains B contains A")
}

///|
pub fn redteam_p1_undeclared_identifier() -> String {
  rt_must_reject(cs("  o[0] = not_declared;"), "undeclared identifier")
}

///| Undeclared names reach the target compiler: Metal macros/intrinsics silently give them meaning.
pub fn redteam_p1_target_builtin_passthrough() -> String {
  rt_must_reject(cs("  o[0] = M_PI_F + simd_sum(o[1]);"), "Metal-only M_PI_F / simd_sum")
}

///|
pub fn redteam_p1_glsl_macro_passthrough() -> String {
  rt_must_reject(cs("  o[0] = f32(__VERSION__);"), "GLSL predefined macro __VERSION__")
}

///|
pub fn redteam_p1_type_mismatch() -> String {
  rt_must_reject(cs("  let x : f32 = true;"), "bool initializer for f32")
}

///|
pub fn redteam_p1_wrong_builtin_arity() -> String {
  rt_must_reject(cs("  let d = dot(vec3<f32>(1.0));"), "dot with one argument")
}

///|
pub fn redteam_p1_assign_to_let() -> String {
  rt_must_reject(cs("  let x = 1;\n  x = 2;"), "assignment to let")
}

///|
pub fn redteam_p1_write_read_only_storage() -> String {
  rt_must_reject(
    "@group(0) @binding(0) var<storage, read> r : array<f32>;\n@compute @workgroup_size(1) fn c() { r[0] = 1.0; }",
    "store to var<storage, read>",
  )
}

///|
pub fn redteam_p1_recursion() -> String {
  rt_must_reject("fn f(x : i32) -> i32 { return f(x - 1); }\n" + cs("  let y = f(3);"), "recursive function")
}

///|
pub fn redteam_p1_missing_return() -> String {
  rt_must_reject("fn f(x : f32) -> f32 { if x > 0.0 { return 1.0; } }\n" + cs(""), "no return on all paths")
}

///|
pub fn redteam_p1_const_assert_ignored() -> String {
  rt_must_reject("const_assert 1 > 2;\n" + cs(""), "failing const_assert")
}

///|
pub fn redteam_p1_reserved_words_missing() -> String {
  let words = ["fallthrough", "precision", "nointerpolation"]
  let mut i = 0
  while i < words.length() {
    let r = rt_must_reject(cs("  let " + words[i] + " = 1;"), "reserved word " + words[i])
    if r != "" {
      return r
    }
    i = i + 1
  }
  ""
}

///|
pub fn redteam_p1_keywords_as_identifiers() -> String {
  let r = rt_must_reject("var<private> fn : f32;\n" + cs(""), "keyword fn as global name")
  if r != "" {
    return r
  }
  rt_must_reject(cs("  var loop : f32 = 1.0;"), "keyword loop as local name")
}

///|
pub fn redteam_p1_module_scope_name_clash() -> String {
  let r = rt_must_reject("var<private> f : f32;\nfn f() {}\n" + cs(""), "global and fn named f")
  if r != "" {
    return r
  }
  rt_must_reject("struct S { x : f32 }\nfn S() {}\n" + cs(""), "struct and fn named S")
}

///|
pub fn redteam_p1_double_underscore_identifier() -> String {
  rt_must_reject(cs("  let __x = 1;"), "identifier with reserved __ prefix")
}

///|
pub fn redteam_p1_leading_zero_literal() -> String {
  rt_must_reject(cs("  let x = 0123;"), "decimal literal with leading zero")
}

///| `wgsl_parse_int_str` accumulates in a wrapping 32-bit Int: 2^32 becomes binding 0.
pub fn redteam_p1_binding_literal_wraps() -> String {
  let src = "@group(0) @binding(4294967296) var<storage, read_write> o : array<f32>;\n@compute @workgroup_size(1) fn c() { o[0] = 1.0; }"
  match wgsl::reflect(src) {
    Ok(r) =>
    "accepted @binding(2^32) as binding " + r.bindings[0].binding.to_string() + " slot " + r.bindings[0].msl_slot.to_string()
    Err(_) => ""
  }
}

///|
pub fn redteam_p1_array_length_literal_wraps() -> String {
  rt_must_reject("var<private> a : array<f32, 4294967297>;\n" + cs("  a[0] = 1.0;"), "array length 2^32+1 (wraps to 1)")
}

///| `@workgroup_size(2^32 + 1)` wraps to 1 and is accepted (reflection reports x = 1).
pub fn redteam_p1_workgroup_size_literal_wraps() -> String {
  match wgsl::reflect("@compute @workgroup_size(4294967297) fn c() {}") {
    Ok(r) => "accepted @workgroup_size(2^32+1) as x=" + r.entries[0].workgroup_size_x.to_string()
    Err(_) => ""
  }
}

///|
pub fn redteam_p1_continue_in_continuing() -> String {
  rt_must_reject(cs("  loop { continuing { continue; } }"), "continue inside continuing")
}

///|
pub fn redteam_p1_return_in_continuing() -> String {
  rt_must_reject(cs("  loop { continuing { return; } }"), "return inside continuing")
}

///|
pub fn redteam_p1_workgroup_var_in_function() -> String {
  rt_must_reject(cs("  var<workgroup> x : f32;"), "var<workgroup> in a function")
}

///|
pub fn redteam_p1_duplicate_location() -> String {
  rt_must_reject(
    "struct O { @location(0) a : vec4<f32>, @location(0) b : vec4<f32> }\n@fragment fn fs() -> O { var o : O; return o; }",
    "two outputs at @location(0)",
  )
}

///|
pub fn redteam_p1_discard_via_helper_in_vertex() -> String {
  rt_must_reject(
    "fn kill() { discard; }\n@vertex fn vs() -> @builtin(position) vec4<f32> { kill(); return vec4<f32>(0.0); }",
    "discard reached from a vertex entry",
  )
}

///|
pub fn redteam_p1_vertex_without_position() -> String {
  rt_must_reject("@vertex fn vs() -> @location(0) vec4<f32> { return vec4<f32>(0.0); }", "vertex output lacks position")
}

///|
pub fn redteam_p1_unknown_attribute_and_builtin() -> String {
  let r = rt_must_reject("@frobnicate @compute @workgroup_size(1) fn c() {}", "unknown attribute")
  if r != "" {
    return r
  }
  rt_must_reject("@compute @workgroup_size(1) fn c(@builtin(thread_id) t : u32) {}", "unknown builtin")
}

///|
pub fn redteam_p1_unknown_address_space_access_format() -> String {
  let r = rt_must_reject("var<device> x : f32;\n" + cs(""), "address space device")
  if r != "" {
    return r
  }
  let r2 = rt_must_reject("@group(1) @binding(0) var<storage, write_only> w : array<f32>;\n" + cs(""), "access write_only")
  if r2 != "" {
    return r2
  }
  rt_must_reject("@group(1) @binding(0) var t : texture_storage_2d<rgb9e5, write>;\n" + cs(""), "storage format rgb9e5")
}

///|
pub fn redteam_p1_bad_type_parameters() -> String {
  let r = rt_must_reject("var<private> v : vec3<not_a_type>;\n" + cs(""), "vec3<not_a_type>")
  if r != "" {
    return r
  }
  let r2 = rt_must_reject("@group(1) @binding(0) var t : texture_2d<bool>;\n" + cs(""), "texture_2d<bool>")
  if r2 != "" {
    return r2
  }
  rt_must_reject("@group(1) @binding(0) var<uniform> u : array<vec4<f32>>;\n" + cs(""), "runtime array in uniform")
}

// ---------------------------------------------------------------- P1: reflection

///| `msl_slot = group * 8 + binding` with binding allowed up to 31: (0,8) and (1,0) both get slot 8.
pub fn redteam_p1_msl_slot_collision() -> String {
  let src = "@group(0) @binding(8) var<storage, read_write> a : array<f32>;\n@group(1) @binding(0) var<storage, read_write> b : array<f32>;\n@compute @workgroup_size(1) fn c() { a[0] = 1.0; b[0] = 2.0; }"
  match wgsl::reflect(src) {
    Err(e) => "reflect failed: " + e.to_string()
    Ok(r) =>
    if r.bindings[0].msl_slot == r.bindings[1].msl_slot {
      "(0,8) and (1,0) both reflected to msl_slot " + r.bindings[0].msl_slot.to_string()
    } else {
      ""
    }
  }
}

///| Reflected Metal slots must fit Metal's argument tables (buffers 0..30, samplers 0..15).
pub fn redteam_p1_msl_slot_out_of_metal_range() -> String {
  let src = "@group(3) @binding(31) var<storage, read_write> c : array<f32>;\n@group(2) @binding(0) var s : sampler;\n@compute @workgroup_size(1) fn k() { c[0] = 1.0; }"
  match wgsl::reflect(src) {
    Err(_) => ""
    Ok(r) => {
      let mut i = 0
      while i < r.bindings.length() {
        let b = r.bindings[i]
        let limit = match b.kind {
          wgsl::BindingKind::Sampler | wgsl::BindingKind::SamplerComparison => 15
          wgsl::BindingKind::Uniform | wgsl::BindingKind::StorageRead | wgsl::BindingKind::StorageReadWrite => 30
          _ => 127
        }
        if b.msl_slot > limit {
          return b.name + " reflected to Metal slot " + b.msl_slot.to_string() + " (max " + limit.to_string() + ")"
        }
        i = i + 1
      }
      ""
    }
  }
}

///| `texture_depth_cube_array` falls through `wgsl_classify_texture_binding` to `TextureStorage3d`.
pub fn redteam_p1_depth_cube_array_misclassified() -> String {
  let src = "@group(0) @binding(0) var t : texture_depth_cube_array;\n@compute @workgroup_size(1) fn k() {}"
  match wgsl::reflect(src) {
    Err(e) => "reflect failed: " + e.to_string()
    Ok(r) =>
    match r.bindings[0].kind {
      wgsl::BindingKind::TextureStorage3d => "texture_depth_cube_array reflected as TextureStorage3d"
      _ => ""
    }
  }
}

///| Handle types (textures/samplers) cannot live in the private address space.
pub fn redteam_p1_private_texture_accepted() -> String {
  rt_must_reject("var<private> t : texture_depth_cube_array;\n" + cs(""), "var<private> of a texture type")
}

// ---------------------------------------------------------------- P1: MSL semantics visible in the text

///| A fragment entry returning `@builtin(frag_depth)` must be emitted as a depth output, not color 0.
pub fn redteam_p1_msl_frag_depth_return_becomes_color() -> String {
  match msl("@fragment fn fs(@builtin(position) p : vec4<f32>) -> @builtin(frag_depth) f32 { return p.z; }") {
    Err(e) => "compile failed: " + e
    Ok(s) => if has(s, "depth(") { "" } else { "no [[depth(...)]] on the frag_depth return:\n" + s }
  }
}

///| A fragment entry returning `@location(1)` must write color attachment 1.
pub fn redteam_p1_msl_location1_return_becomes_color0() -> String {
  match msl("@fragment fn fs() -> @location(1) vec4<f32> { return vec4<f32>(1.0); }") {
    Err(e) => "compile failed: " + e
    Ok(s) => if has(s, "color(1)") { "" } else { "no [[color(1)]] on the @location(1) return:\n" + s }
  }
}

///| `override` with both @id and a default: the default must survive.
pub fn redteam_p2_msl_override_default_dropped() -> String {
  match msl("@id(0) override scale : f32 = 2.0;\n" + cs("  o[0] = scale;")) {
    Err(e) => "compile failed: " + e
    Ok(s) => if has(s, "2.0") { "" } else { "default value 2.0 of @id(0) override missing:\n" + s }
  }
}

// ---------------------------------------------------------------- P1: GLSL semantics visible in the text

///| `@builtin(position)` read in a fragment shader is `gl_FragCoord`; `gl_Position` does not exist there.
pub fn redteam_p1_glsl_fragment_position_is_gl_position() -> String {
  let src = "struct V { @builtin(position) pos : vec4<f32>, @location(0) uv : vec2<f32> }\n@fragment fn fs(v : V) -> @location(0) vec4<f32> { return v.pos; }"
  match glsl(src, "fs") {
    Err(e) => "compile failed: " + e
    Ok(s) => if has(s, "gl_Position") { "fragment shader reads gl_Position:\n" + s } else { "" }
  }
}

///| `1f / 2f` is 0.5; emitting `1 / 2` is integer division (0) after GLSL 450 implicit conversion.
pub fn redteam_p1_glsl_float_suffix_becomes_int() -> String {
  match glsl(cs("  o[0] = 1f / 2f;"), "cs_main") {
    Err(e) => "compile failed: " + e
    Ok(s) => if has(s, "1 / 2") { "`1f / 2f` emitted as integer division `1 / 2`" } else { "" }
  }
}

///| WGSL zero-initialises `var` without initializer; GLSL locals are undefined unless initialised.
pub fn redteam_p1_glsl_var_not_zero_initialized() -> String {
  match glsl(cs("  var acc : f32;\n  acc += 1.0;\n  o[0] = acc;"), "cs_main") {
    Err(e) => "compile failed: " + e
    Ok(s) => if has(s, "float acc;") { "`var acc : f32;` emitted as uninitialised `float acc;`" } else { "" }
  }
}

///| Vertex outputs and fragment inputs of one module must agree on interface names (ES 3.00 links by name).
pub fn redteam_p1_glsl_varyings_do_not_link() -> String {
  let src = "struct V { @builtin(position) pos : vec4<f32>, @location(0) uv : vec2<f32> }\n@vertex fn vs() -> V { var v : V; return v; }\n@fragment fn fs(v : V) -> @location(0) vec4<f32> { return vec4<f32>(v.uv, 0.0, 1.0); }"
  match (glsl(src, "vs"), glsl(src, "fs")) {
    (Ok(a), Ok(b)) =>
    if has(a, "out vec2 _vs_out_uv") && has(b, "in vec2 _in_uv") {
      "vertex declares `_vs_out_uv`, fragment declares `_in_uv`"
    } else {
      ""
    }
    _ => "compile failed"
  }
}

///| `let` without a type gets `float` when the initializer is not a recognised literal/call.
pub fn redteam_p1_glsl_let_type_inference_defaults_to_float() -> String {
  match glsl(cs("  let v = vec3<f32>(1.0) * 2.0;\n  let i = 3u + 1u;\n  o[i] = v.z;"), "cs_main") {
    Err(e) => "compile failed: " + e
    Ok(s) => if has(s, "float v =") || has(s, "float i =") { "vec3/u32 `let` emitted as float:\n" + s } else { "" }
  }
}

///| WGSL `select(f, t, vec_cond)` is component-wise; a GLSL `?:` needs a scalar bool.
pub fn redteam_p1_glsl_select_vector_condition() -> String {
  match glsl(cs("  let r = select(vec2<f32>(1.0), vec2<f32>(2.0), vec2<bool>(true, false));\n  o[0] = r.x;"), "cs_main") {
    Err(e) => "compile failed: " + e
    Ok(s) => if has(s, ") ? (") { "vector select lowered to scalar ternary" } else { "" }
  }
}

// ---------------------------------------------------------------- P2: false rejections of valid WGSL

///|
pub fn redteam_p2_unicode_identifier_rejected() -> String {
  rt_must_accept(cs("  let gr\u{00F6}\u{00DF}e = 1.0;\n  o[0] = gr\u{00F6}\u{00DF}e;"), "XID identifier")
}

///|
pub fn redteam_p2_const_expr_workgroup_size_rejected() -> String {
  rt_must_accept("const TILE : u32 = 8u;\nconst WG = TILE * 8u;\n@compute @workgroup_size(WG) fn c() {}", "workgroup_size(TILE * 8u)")
}

///|
pub fn redteam_p2_function_const_assert_rejected() -> String {
  rt_must_accept(cs("  const_assert 1 < 2;"), "function-scope const_assert")
}

///|
pub fn redteam_p2_group_above_7_rejected() -> String {
  rt_must_accept("@group(8) @binding(40) var<storage, read_write> o : array<f32>;\n@compute @workgroup_size(1) fn c() { o[0] = 1.0; }", "@group(8) @binding(40)")
}

// ---------------------------------------------------------------- registry

///|
pub fn rt_all_cases() -> Array[String] {
  [
    "control_reflection_multi_entry", "control_lexer_template_edges", "control_statement_coverage",
    "control_malformed_inputs", "control_every_prefix", "control_structural_rejections", "control_parse_limits",
    "redteam_p0_index_nesting_ignores_depth_limit", "redteam_p0_binary_chain_unbounded_tree_depth",
    "redteam_p0_field_chain_unbounded_tree_depth", "redteam_p1_struct_self_reference",
    "redteam_p1_struct_mutual_recursion", "redteam_p1_undeclared_identifier", "redteam_p1_target_builtin_passthrough",
    "redteam_p1_glsl_macro_passthrough", "redteam_p1_type_mismatch", "redteam_p1_wrong_builtin_arity",
    "redteam_p1_assign_to_let", "redteam_p1_write_read_only_storage", "redteam_p1_recursion",
    "redteam_p1_missing_return", "redteam_p1_const_assert_ignored", "redteam_p1_reserved_words_missing",
    "redteam_p1_keywords_as_identifiers", "redteam_p1_module_scope_name_clash",
    "redteam_p1_double_underscore_identifier", "redteam_p1_leading_zero_literal",
    "redteam_p1_binding_literal_wraps", "redteam_p1_array_length_literal_wraps",
    "redteam_p1_workgroup_size_literal_wraps", "redteam_p1_continue_in_continuing",
    "redteam_p1_return_in_continuing", "redteam_p1_workgroup_var_in_function",
    "redteam_p1_duplicate_location", "redteam_p1_discard_via_helper_in_vertex", "redteam_p1_vertex_without_position",
    "redteam_p1_unknown_attribute_and_builtin", "redteam_p1_unknown_address_space_access_format",
    "redteam_p1_bad_type_parameters", "redteam_p1_msl_slot_collision", "redteam_p1_msl_slot_out_of_metal_range",
    "redteam_p1_depth_cube_array_misclassified", "redteam_p1_private_texture_accepted",
    "redteam_p1_msl_frag_depth_return_becomes_color", "redteam_p1_msl_location1_return_becomes_color0",
    "redteam_p2_msl_override_default_dropped", "redteam_p1_glsl_fragment_position_is_gl_position",
    "redteam_p1_glsl_float_suffix_becomes_int", "redteam_p1_glsl_var_not_zero_initialized",
    "redteam_p1_glsl_varyings_do_not_link", "redteam_p1_glsl_let_type_inference_defaults_to_float",
    "redteam_p1_glsl_select_vector_condition", "redteam_p2_unicode_identifier_rejected",
    "redteam_p2_const_expr_workgroup_size_rejected", "redteam_p2_function_const_assert_rejected",
    "redteam_p2_group_above_7_rejected",
  ]
}

