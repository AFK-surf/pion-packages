///| DoS probe corpus (written by `wgsl_audit gen_dos <dir>`).

///| `s` repeated `n` times.
pub fn rt_rep(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

///| Wrap an expression in a compute entry point that stores it.
pub fn rt_cs_expr(expr : String) -> String {
  "@group(0) @binding(0) var<storage, read_write> o : array<f32>;\n" +
  "@compute @workgroup_size(1)\nfn main() {\n  let a = 1.0;\n  o[0] = " + expr + ";\n}\n"
}

///| (name, source) pairs; sizes stay under the default 2 MiB / 250k-token limits unless noted.
pub fn rt_dos_cases() -> Array[(String, String)] {
  let out : Array[(String, String)] = []
  // Left-deep binary chain: parsed iteratively, but every later pass recurses on it.
  out.push(("binary_chain_2k", rt_cs_expr(rt_rep("a+", 2000) + "a")))
  out.push(("binary_chain_110k", rt_cs_expr(rt_rep("a+", 110000) + "a")))
  // Nested index `o[o[o[...]]]`: parse_postfix -> parse_expr with no depth accounting.
  out.push(("index_nest_500", rt_cs_expr(rt_rep("o[", 500) + "0" + rt_rep("]", 500))))
  out.push(("index_nest_10k", rt_cs_expr(rt_rep("o[", 10000) + "0" + rt_rep("]", 10000))))
  // Postfix chain `a.x.x.x...`.
  out.push(("field_chain_2k", rt_cs_expr("a" + rt_rep(".x", 2000))))
  out.push(("field_chain_110k", rt_cs_expr("a" + rt_rep(".x", 110000))))
  // Depth-limited constructs (must be rejected with LimitExceeded in microseconds).
  out.push(("paren_nest_100k", rt_cs_expr(rt_rep("(", 100000) + "a" + rt_rep(")", 100000))))
  out.push(("unary_nest_100k", rt_cs_expr(rt_rep("- ", 100000) + "a")))
  out.push(("block_nest_100k", "fn f() " + rt_rep("{", 100000) + rt_rep("}", 100000) + "\n"))
  out.push(("elseif_chain_20k", "fn f() { if true {}" + rt_rep(" else if true {}", 20000) + " }\n"))
  out.push(("template_nest_50k", "alias T = " + rt_rep("array<", 50000) + "f32" + rt_rep(">", 50000) + ";\n"))
  out.push(("call_nest_100k", rt_cs_expr(rt_rep("abs(", 100000) + "a" + rt_rep(")", 100000))))
  out.push(("comment_nest_500k", rt_rep("/*", 500000) + rt_rep("*/", 500000) + "fn f() {}\n"))
  out.push(("comment_unterminated_500k", rt_rep("/*", 500000) + "fn f() {}\n"))
  // Long flat sources at the default limits.
  out.push(("tokens_250k_plus", rt_cs_expr(rt_rep("a+", 125100) + "a")))
  out.push(("stmts_60k", "fn f() {\n" + rt_rep("  var x = 1.0;\n", 60000) + "}\n"))
  out.push(("funcs_20k", rt_rep("fn f() {}\n", 1) + rt_rep_idx("fn g", "() {}\n", 20000)))
  out.push(("structs_wide_20k", "struct S {\n" + rt_rep_idx("  f", " : f32,\n", 20000) + "}\n"))
  out.push(("long_ident_1m", "fn " + rt_rep("a", 1000000) + "() {}\n"))
  out.push(("long_number_1m", rt_cs_expr(rt_rep("9", 1000000))))
  out.push(("switch_cases_20k", "fn f(x : i32) {\n  switch x {\n" + rt_rep_idx("    case ", " : {}\n", 20000) + "    default : {}\n  }\n}\n"))
  out.push(("attrs_100k", "fn f() {}\n" + rt_rep("@const", 100000) + " fn g() {}\n"))
  out
}

///| `prefix + i + suffix` for i in 0..n, concatenated.
pub fn rt_rep_idx(prefix : String, suffix : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(prefix)
    sb.write_string(i.to_string())
    sb.write_string(suffix)
    i = i + 1
  }
  sb.to_string()
}
