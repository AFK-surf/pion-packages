///| Pure-Pion WGSL -> Metal Shading Language (MSL 2.x) backend.
///| Uses direct `StringBuilder` emission to minimize intermediate allocations.

fn msl_scalar(s : String) -> String {
  if s == "f32" {
    "float"
  } else if s == "i32" {
    "int"
  } else if s == "u32" {
    "uint"
  } else if s == "bool" {
    "bool"
  } else if s == "f16" {
    "half"
  } else {
    s
  }
}

fn msl_storage_tex_elem(fmt : String) -> String {
  if fmt == "r32uint" || fmt == "rg32uint" || fmt == "rgba32uint" ||
  fmt == "rgba16uint" || fmt == "rgba8uint" {
    "uint"
  } else if fmt == "r32sint" || fmt == "rg32sint" || fmt == "rgba32sint" ||
  fmt == "rgba16sint" || fmt == "rgba8sint" {
    "int"
  } else {
    "float"
  }
}

fn msl_storage_tex_access(acc : String) -> String {
  if acc == "read" {
    "access::read"
  } else if acc == "read_write" {
    "access::read_write"
  } else {
    "access::write"
  }
}

fn msl_emit_type(sb : StringBuilder, ty : WgslType) -> Unit {
  match ty {
    WgslType::Scalar(s) => sb.write_string(msl_scalar(s))
    WgslType::Vec(d, e) => {
      sb.write_string(msl_scalar(e))
      sb.write_string(d.to_string())
    }
    WgslType::Mat(c, r, e) => {
      sb.write_string(msl_scalar(e))
      sb.write_string(c.to_string())
      sb.write_string("x")
      sb.write_string(r.to_string())
    }
    WgslType::Array(elem, len, len_ident) =>
    if len > 0 {
      sb.write_string("array<")
      msl_emit_type(sb, elem)
      sb.write_string(", ")
      sb.write_string(len.to_string())
      sb.write_string(">")
    } else if len_ident.length() > 0 {
      sb.write_string("array<")
      msl_emit_type(sb, elem)
      sb.write_string(", ")
      sb.write_string(len_ident)
      sb.write_string(">")
    } else {
      msl_emit_type(sb, elem)
    }
    WgslType::Texture(kind, elem, acc) =>
    if kind == "texture_1d" {
      sb.write_string("texture1d<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_2d" {
      sb.write_string("texture2d<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_2d_array" {
      sb.write_string("texture2d_array<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_3d" {
      sb.write_string("texture3d<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_cube" {
      sb.write_string("texturecube<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_cube_array" {
      sb.write_string("texturecube_array<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_multisampled_2d" {
      sb.write_string("texture2d_ms<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_depth_2d" {
      sb.write_string("depth2d<float>")
    } else if kind == "texture_depth_2d_array" {
      sb.write_string("depth2d_array<float>")
    } else if kind == "texture_depth_cube" {
      sb.write_string("depthcube<float>")
    } else if kind == "texture_depth_cube_array" {
      sb.write_string("depthcube_array<float>")
    } else if kind == "texture_depth_multisampled_2d" {
      sb.write_string("depth2d_ms<float>")
    } else if kind == "texture_storage_1d" {
      sb.write_string("texture1d<")
      sb.write_string(msl_storage_tex_elem(elem))
      sb.write_string(", ")
      sb.write_string(msl_storage_tex_access(acc))
      sb.write_string(">")
    } else if kind == "texture_storage_2d" {
      sb.write_string("texture2d<")
      sb.write_string(msl_storage_tex_elem(elem))
      sb.write_string(", ")
      sb.write_string(msl_storage_tex_access(acc))
      sb.write_string(">")
    } else if kind == "texture_storage_2d_array" {
      sb.write_string("texture2d_array<")
      sb.write_string(msl_storage_tex_elem(elem))
      sb.write_string(", ")
      sb.write_string(msl_storage_tex_access(acc))
      sb.write_string(">")
    } else {
      sb.write_string("texture3d<")
      sb.write_string(msl_storage_tex_elem(elem))
      sb.write_string(", ")
      sb.write_string(msl_storage_tex_access(acc))
      sb.write_string(">")
    }
    WgslType::Sampler(_) => sb.write_string("sampler")
    WgslType::Atomic(e) =>
    if e == "u32" {
      sb.write_string("atomic_uint")
    } else {
      sb.write_string("atomic_int")
    }
    WgslType::Named(n) => sb.write_string(n)
    WgslType::Ptr(sp, elem, _) => {
      let msp = if sp == "function" || sp == "private" {
        "thread"
      } else if sp == "workgroup" {
        "threadgroup"
      } else if sp == "uniform" {
        "constant"
      } else {
        "device"
      }
      sb.write_string(msp)
      sb.write_string(" ")
      msl_emit_type(sb, elem)
      sb.write_string("*")
    }
  }
}

fn msl_builtin_attr(name : String) -> String {
  if name == "vertex_index" {
    "[[vertex_id]]"
  } else if name == "instance_index" {
    "[[instance_id]]"
  } else if name == "position" {
    "[[position]]"
  } else if name == "front_facing" {
    "[[front_facing]]"
  } else if name == "frag_depth" {
    "[[depth(any)]]"
  } else if name == "sample_index" {
    "[[sample_id]]"
  } else if name == "sample_mask" {
    "[[sample_mask]]"
  } else if name == "global_invocation_id" {
    "[[thread_position_in_grid]]"
  } else if name == "local_invocation_id" {
    "[[thread_position_in_threadgroup]]"
  } else if name == "workgroup_id" {
    "[[threadgroup_position_in_grid]]"
  } else if name == "local_invocation_index" {
    "[[thread_index_in_threadgroup]]"
  } else if name == "num_workgroups" {
    "[[threadgroups_per_grid]]"
  } else {
    ""
  }
}

fn msl_interpolate_attr(attrs : Array[WgslAttr]) -> String {
  match wgsl_find_attr(attrs, "interpolate") {
    Some(ia) =>
    if ia.args.length() >= 1 {
      let kind = ia.args[0]
      let samp = if ia.args.length() >= 2 { ia.args[1] } else { "center" }
      if kind == "flat" {
        " [[flat]]"
      } else if kind == "linear" {
        if samp == "centroid" {
          " [[centroid_no_perspective]]"
        } else if samp == "sample" {
          " [[sample_no_perspective]]"
        } else {
          " [[center_no_perspective]]"
        }
      } else if samp == "centroid" {
        " [[centroid_perspective]]"
      } else if samp == "sample" {
        " [[sample_perspective]]"
      } else {
        " [[center_perspective]]"
      }
    } else {
      ""
    }
    None => ""
  }
}

struct MslCtx {
  sb : StringBuilder
  struct_names : Map[String, Bool]
  mut indent : Int
  mut wrap_ret_struct : String
}

fn MslCtx::new(m : WgslModule) -> MslCtx {
  let sn : Map[String, Bool] = Map::new()
  let mut i = 0
  while i < m.structs.length() {
    sn.set(m.structs[i].name, true)
    i = i + 1
  }
  MslCtx::{
    sb: StringBuilder::new(),
    struct_names: sn,
    indent: 0,
    wrap_ret_struct: "",
  }
}

fn MslCtx::emit_indent(self : MslCtx) -> Unit {
  let mut i = 0
  while i < self.indent {
    self.sb.write_string("  ")
    i = i + 1
  }
}

fn msl_emit_int_lit(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  if n > 1 && s.code_unit_at(n - 1) == 105 {
    sb.write_string(s.slice(0, n - 1))
  } else {
    sb.write_string(s)
  }
}

fn msl_emit_float_lit(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  sb.write_string(s)
  if n > 0 {
    let last = s.code_unit_at(n - 1)
    if last != 102 && last != 104 {
      sb.write_string("f")
    }
  }
}

fn MslCtx::emit_arg_list(self : MslCtx, args : Array[WgslExpr]) -> Unit {
  let mut i = 0
  while i < args.length() {
    if i > 0 {
      self.sb.write_string(", ")
    }
    self.emit_expr(args[i])
    i = i + 1
  }
}

fn MslCtx::emit_expr(self : MslCtx, expr : WgslExpr) -> Unit {
  match expr {
    WgslExpr::Ident(name, _, _) => self.sb.write_string(name)
    WgslExpr::IntLit(s, _, _) => msl_emit_int_lit(self.sb, s)
    WgslExpr::FloatLit(s, _, _) => msl_emit_float_lit(self.sb, s)
    WgslExpr::BoolLit(b, _, _) => self.sb.write_string(if b { "true" } else { "false" })
    WgslExpr::Paren(inner, _, _) => {
      self.sb.write_string("(")
      self.emit_expr(inner)
      self.sb.write_string(")")
    }
    WgslExpr::Unary(op, inner, _, _) => {
      self.sb.write_string(op)
      self.emit_expr(inner)
    }
    WgslExpr::Binary(op, l, r, _, _) => {
      self.emit_expr(l)
      self.sb.write_string(" ")
      self.sb.write_string(op)
      self.sb.write_string(" ")
      self.emit_expr(r)
    }
    WgslExpr::Index(base, idx, _, _) => {
      self.emit_expr(base)
      self.sb.write_string("[")
      self.emit_expr(idx)
      self.sb.write_string("]")
    }
    WgslExpr::Field(base, fld, _, _) => {
      self.emit_expr(base)
      self.sb.write_string(".")
      self.sb.write_string(fld)
    }
    WgslExpr::Call(name, targs, arr_len, len_ident, args, _, _) => {
      if name == "textureSample" && args.length() == 3 {
        self.emit_expr(args[0])
        self.sb.write_string(".sample(")
        self.emit_expr(args[1])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string(")")
        return
      }
      if name == "textureSampleLevel" && args.length() == 4 {
        self.emit_expr(args[0])
        self.sb.write_string(".sample(")
        self.emit_expr(args[1])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string(", level(")
        self.emit_expr(args[3])
        self.sb.write_string("))")
        return
      }
      if name == "textureSampleBias" && args.length() == 4 {
        self.emit_expr(args[0])
        self.sb.write_string(".sample(")
        self.emit_expr(args[1])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string(", bias(")
        self.emit_expr(args[3])
        self.sb.write_string("))")
        return
      }
      if name == "textureSampleCompare" && args.length() == 4 {
        self.emit_expr(args[0])
        self.sb.write_string(".sample_compare(")
        self.emit_expr(args[1])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string(", ")
        self.emit_expr(args[3])
        self.sb.write_string(")")
        return
      }
      if name == "textureLoad" && args.length() == 3 {
        self.emit_expr(args[0])
        self.sb.write_string(".read(uint2(")
        self.emit_expr(args[1])
        self.sb.write_string("), uint(")
        self.emit_expr(args[2])
        self.sb.write_string("))")
        return
      }
      if name == "textureStore" && args.length() == 3 {
        self.emit_expr(args[0])
        self.sb.write_string(".write(")
        self.emit_expr(args[2])
        self.sb.write_string(", uint2(")
        self.emit_expr(args[1])
        self.sb.write_string("))")
        return
      }
      if name == "textureDimensions" && args.length() >= 1 {
        self.sb.write_string("uint2(")
        self.emit_expr(args[0])
        self.sb.write_string(".get_width(), ")
        self.emit_expr(args[0])
        self.sb.write_string(".get_height())")
        return
      }
      if name == "arrayLength" && args.length() == 1 {
        self.sb.write_string("uint(sizeof(")
        match args[0] {
          WgslExpr::Unary("&", e, _, _) => self.emit_expr(e)
          _ => self.emit_expr(args[0])
        }
        self.sb.write_string(") / sizeof(")
        match args[0] {
          WgslExpr::Unary("&", e, _, _) => self.emit_expr(e)
          _ => self.emit_expr(args[0])
        }
        self.sb.write_string("[0]))")
        return
      }
      if name == "workgroupBarrier" {
        self.sb.write_string("threadgroup_barrier(mem_flags::mem_threadgroup)")
        return
      }
      if name == "storageBarrier" {
        self.sb.write_string("threadgroup_barrier(mem_flags::mem_device)")
        return
      }
      if name == "textureBarrier" {
        self.sb.write_string("threadgroup_barrier(mem_flags::mem_texture)")
        return
      }
      if name == "bitcast" && targs.length() == 1 && args.length() == 1 {
        self.sb.write_string("as_type<")
        msl_emit_type(self.sb, targs[0])
        self.sb.write_string(">(")
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "atomicLoad" && args.length() == 1 {
        self.sb.write_string("atomic_load_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicStore" && args.length() == 2 {
        self.sb.write_string("atomic_store_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicAdd" && args.length() == 2 {
        self.sb.write_string("atomic_fetch_add_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "pack2x16float" && args.length() == 1 {
        self.sb.write_string("as_type<uint>(half2(")
        self.emit_expr(args[0])
        self.sb.write_string("))")
        return
      }
      if name == "unpack2x16float" && args.length() == 1 {
        self.sb.write_string("float2(as_type<half2>(")
        self.emit_expr(args[0])
        self.sb.write_string("))")
        return
      }
      if name == "array" && targs.length() == 1 {
        self.sb.write_string("array<")
        msl_emit_type(self.sb, targs[0])
        self.sb.write_string(", ")
        if arr_len > 0 {
          self.sb.write_string(arr_len.to_string())
        } else if len_ident.length() > 0 {
          self.sb.write_string(len_ident)
        } else {
          self.sb.write_string(args.length().to_string())
        }
        self.sb.write_string(">{")
        self.emit_arg_list(args)
        self.sb.write_string("}")
        return
      }
      if (name == "vec2" || name == "vec3" || name == "vec4") && targs.length() == 1 {
        let dim = name.code_unit_at(3) - 48
        msl_emit_type(self.sb, targs[0])
        self.sb.write_string(dim.to_string())
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      if (name == "mat2x2" || name == "mat3x3" || name == "mat4x4" ||
        name == "mat2x3" || name == "mat2x4" || name == "mat3x2" ||
        name == "mat3x4" || name == "mat4x2" || name == "mat4x3") && targs.length() == 1 {
        let cols = name.code_unit_at(3) - 48
        let rows = name.code_unit_at(5) - 48
        msl_emit_type(self.sb, targs[0])
        self.sb.write_string(cols.to_string())
        self.sb.write_string("x")
        self.sb.write_string(rows.to_string())
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      if name == "f32" || name == "i32" || name == "u32" || name == "bool" || name == "f16" {
        self.sb.write_string(msl_scalar(name))
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      match wgsl_resolve_vec_alias(name) {
        Some(vt) => {
          msl_emit_type(self.sb, vt)
          self.sb.write_string("(")
          self.emit_arg_list(args)
          self.sb.write_string(")")
          return
        }
        None => ()
      }
      match self.struct_names.get(name) {
        Some(_) => {
          self.sb.write_string(name)
          self.sb.write_string("{")
          self.emit_arg_list(args)
          self.sb.write_string("}")
          return
        }
        None => ()
      }
      let fn_name = msl_remap_builtin(name)
      self.sb.write_string(fn_name)
      self.sb.write_string("(")
      self.emit_arg_list(args)
      self.sb.write_string(")")
    }
  }
}

fn msl_remap_builtin(name : String) -> String {
  if name == "inverseSqrt" {
    "rsqrt"
  } else if name == "dpdx" || name == "dpdxCoarse" || name == "dpdxFine" {
    "dfdx"
  } else if name == "dpdy" || name == "dpdyCoarse" || name == "dpdyFine" {
    "dfdy"
  } else if name == "fwidthCoarse" || name == "fwidthFine" {
    "fwidth"
  } else if name == "countLeadingZeros" {
    "clz"
  } else if name == "countTrailingZeros" {
    "ctz"
  } else if name == "countOneBits" {
    "popcount"
  } else if name == "reverseBits" {
    "reverse_bits"
  } else if name == "pack4x8unorm" {
    "pack_float_to_unorm4x8"
  } else if name == "unpack4x8unorm" {
    "unpack_unorm4x8_to_float"
  } else if name == "pack4x8snorm" {
    "pack_float_to_snorm4x8"
  } else if name == "unpack4x8snorm" {
    "unpack_snorm4x8_to_float"
  } else if name == "pack2x16unorm" {
    "pack_float_to_unorm2x16"
  } else if name == "unpack2x16unorm" {
    "unpack_unorm2x16_to_float"
  } else if name == "pack2x16snorm" {
    "pack_float_to_snorm2x16"
  } else if name == "unpack2x16snorm" {
    "unpack_snorm2x16_to_float"
  } else {
    name
  }
}

fn MslCtx::emit_simple_stmt_inline(self : MslCtx, s : WgslStmt) -> Unit {
  match s {
    WgslStmt::VarDecl(name, kind_s, ty, init, _, _) => {
      if kind_s == "let" || kind_s == "const" {
        self.sb.write_string("const ")
      }
      match ty {
        Some(t) => msl_emit_type(self.sb, t)
        None => self.sb.write_string("auto")
      }
      self.sb.write_string(" ")
      self.sb.write_string(name)
      match init {
        Some(ex) => {
          self.sb.write_string(" = ")
          self.emit_expr(ex)
        }
        None => self.sb.write_string(" = {}")
      }
    }
    WgslStmt::Assign(lhs, op, rhs, _, _) => {
      self.emit_expr(lhs)
      self.sb.write_string(" ")
      self.sb.write_string(op)
      self.sb.write_string(" ")
      self.emit_expr(rhs)
    }
    WgslStmt::PhonyAssign(rhs, _, _) => {
      self.sb.write_string("(void)(")
      self.emit_expr(rhs)
      self.sb.write_string(")")
    }
    WgslStmt::IncDec(lhs, is_inc, _, _) => {
      self.emit_expr(lhs)
      self.sb.write_string(if is_inc { "++" } else { "--" })
    }
    WgslStmt::ExprStmt(ex, _, _) => self.emit_expr(ex)
    _ => ()
  }
}

fn MslCtx::emit_stmts(self : MslCtx, stmts : Array[WgslStmt]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    self.emit_stmt(stmts[i])
    i = i + 1
  }
}

fn MslCtx::emit_stmt(self : MslCtx, stmt : WgslStmt) -> Unit {
  match stmt {
    WgslStmt::VarDecl(_, _, _, _, _, _)
    | WgslStmt::Assign(_, _, _, _, _)
    | WgslStmt::PhonyAssign(_, _, _)
    | WgslStmt::IncDec(_, _, _, _)
    | WgslStmt::ExprStmt(_, _, _) => {
      self.emit_indent()
      self.emit_simple_stmt_inline(stmt)
      self.sb.write_string(";\n")
    }
    WgslStmt::Return(opt_ex, _, _) => {
      self.emit_indent()
      match opt_ex {
        Some(ex) =>
        if self.wrap_ret_struct.length() > 0 {
          self.sb.write_string("return ")
          self.sb.write_string(self.wrap_ret_struct)
          self.sb.write_string("{")
          self.emit_expr(ex)
          self.sb.write_string("};\n")
        } else {
          self.sb.write_string("return ")
          self.emit_expr(ex)
          self.sb.write_string(";\n")
        }
        None => self.sb.write_string("return;\n")
      }
    }
    WgslStmt::If(cond, then_b, else_b, _, _) => {
      self.emit_indent()
      self.sb.write_string("if (")
      self.emit_expr(cond)
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      self.emit_stmts(then_b)
      self.indent = self.indent - 1
      if else_b.length() > 0 {
        self.emit_indent()
        self.sb.write_string("} else {\n")
        self.indent = self.indent + 1
        self.emit_stmts(else_b)
        self.indent = self.indent - 1
      }
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::Switch(sel, cases, _, _) => {
      self.emit_indent()
      self.sb.write_string("switch (")
      self.emit_expr(sel)
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      let mut ci = 0
      while ci < cases.length() {
        let c = cases[ci]
        let mut si = 0
        while si < c.selectors.length() {
          self.emit_indent()
          self.sb.write_string("case ")
          self.emit_expr(c.selectors[si])
          self.sb.write_string(":\n")
          si = si + 1
        }
        if c.is_default {
          self.emit_indent()
          self.sb.write_string("default:\n")
        }
        self.emit_indent()
        self.sb.write_string("{\n")
        self.indent = self.indent + 1
        self.emit_stmts(c.body)
        self.emit_indent()
        self.sb.write_string("break;\n")
        self.indent = self.indent - 1
        self.emit_indent()
        self.sb.write_string("}\n")
        ci = ci + 1
      }
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::For(init, cond, update, body, _, _) => {
      self.emit_indent()
      self.sb.write_string("for (")
      match init {
        Some(st) => self.emit_simple_stmt_inline(st)
        None => ()
      }
      self.sb.write_string("; ")
      match cond {
        Some(ex) => self.emit_expr(ex)
        None => ()
      }
      self.sb.write_string("; ")
      match update {
        Some(st) => self.emit_simple_stmt_inline(st)
        None => ()
      }
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::While(cond, body, _, _) => {
      self.emit_indent()
      self.sb.write_string("while (")
      self.emit_expr(cond)
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::Loop(body, cont, break_if, _, _) => {
      self.emit_indent()
      self.sb.write_string("while (true) {\n")
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.emit_stmts(cont)
      match break_if {
        Some(cond) => {
          self.emit_indent()
          self.sb.write_string("if (")
          self.emit_expr(cond)
          self.sb.write_string(") { break; }\n")
        }
        None => ()
      }
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::Break(_, _) => {
      self.emit_indent()
      self.sb.write_string("break;\n")
    }
    WgslStmt::Continue(_, _) => {
      self.emit_indent()
      self.sb.write_string("continue;\n")
    }
    WgslStmt::Discard(_, _) => {
      self.emit_indent()
      self.sb.write_string("discard_fragment();\n")
    }
    WgslStmt::Block(body, _, _) => {
      self.emit_indent()
      self.sb.write_string("{\n")
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
  }
}

fn msl_emit_struct(ctx : MslCtx, s : WgslStructDecl, is_vs_in : Bool, is_fs_out : Bool) -> Unit {
  ctx.sb.write_string("struct ")
  ctx.sb.write_string(s.name)
  ctx.sb.write_string(" {\n")
  let mut i = 0
  while i < s.fields.length() {
    let f = s.fields[i]
    ctx.sb.write_string("  ")
    match wgsl_find_attr(f.attrs, "align") {
      Some(aa) =>
      if aa.args.length() == 1 {
        ctx.sb.write_string("alignas(")
        ctx.sb.write_string(aa.args[0])
        ctx.sb.write_string(") ")
      }
      None => ()
    }
    let mut attr_s = ""
    match wgsl_find_attr(f.attrs, "builtin") {
      Some(ba) =>
      if ba.args.length() == 1 {
        attr_s = " " + msl_builtin_attr(ba.args[0])
      }
      None => ()
    }
    match wgsl_find_attr(f.attrs, "location") {
      Some(la) =>
      if la.args.length() == 1 {
        let loc = la.args[0]
        if is_vs_in {
          attr_s = " [[attribute(" + loc + ")]]"
        } else if is_fs_out {
          attr_s = " [[color(" + loc + ")]]"
        } else {
          attr_s = " [[user(loc" + loc + ")]]" + msl_interpolate_attr(f.attrs)
        }
      }
      None => ()
    }
    match f.ty {
      WgslType::Array(elem, len, len_ident) =>
      if len == 0 && len_ident.length() == 0 {
        msl_emit_type(ctx.sb, elem)
        ctx.sb.write_string(" ")
        ctx.sb.write_string(f.name)
        ctx.sb.write_string("[1]")
        ctx.sb.write_string(attr_s)
        ctx.sb.write_string(";\n")
      } else {
        msl_emit_type(ctx.sb, f.ty)
        ctx.sb.write_string(" ")
        ctx.sb.write_string(f.name)
        ctx.sb.write_string(attr_s)
        ctx.sb.write_string(";\n")
      }
      _ => {
        msl_emit_type(ctx.sb, f.ty)
        ctx.sb.write_string(" ")
        ctx.sb.write_string(f.name)
        ctx.sb.write_string(attr_s)
        ctx.sb.write_string(";\n")
      }
    }
    i = i + 1
  }
  ctx.sb.write_string("};\n\n")
}

fn msl_emit_binding_param(sb : StringBuilder, g : WgslGlobalVar, slot : Int) -> Unit {
  let ty = match g.ty {
    Some(t) => t
    None => WgslType::Scalar("f32")
  }
  match ty {
    WgslType::Texture(_, _, _) => {
      msl_emit_type(sb, ty)
      sb.write_string(" ")
      sb.write_string(g.name)
      sb.write_string(" [[texture(")
      sb.write_string(slot.to_string())
      sb.write_string(")]]")
    }
    WgslType::Sampler(_) => {
      sb.write_string("sampler ")
      sb.write_string(g.name)
      sb.write_string(" [[sampler(")
      sb.write_string(slot.to_string())
      sb.write_string(")]]")
    }
    WgslType::Array(elem, len, len_ident) =>
    if len == 0 && len_ident.length() == 0 {
      if g.addr_space == "uniform" {
        sb.write_string("constant ")
      } else if g.access == "read_write" {
        sb.write_string("device ")
      } else {
        sb.write_string("device const ")
      }
      msl_emit_type(sb, elem)
      sb.write_string("* ")
      sb.write_string(g.name)
      sb.write_string(" [[buffer(")
      sb.write_string(slot.to_string())
      sb.write_string(")]]")
    } else {
      if g.addr_space == "uniform" {
        sb.write_string("constant ")
      } else if g.access == "read_write" {
        sb.write_string("device ")
      } else {
        sb.write_string("device const ")
      }
      msl_emit_type(sb, ty)
      sb.write_string("& ")
      sb.write_string(g.name)
      sb.write_string(" [[buffer(")
      sb.write_string(slot.to_string())
      sb.write_string(")]]")
    }
    _ => {
      if g.addr_space == "uniform" {
        sb.write_string("constant ")
      } else if g.access == "read_write" {
        sb.write_string("device ")
      } else {
        sb.write_string("device const ")
      }
      msl_emit_type(sb, ty)
      sb.write_string("& ")
      sb.write_string(g.name)
      sb.write_string(" [[buffer(")
      sb.write_string(slot.to_string())
      sb.write_string(")]]")
    }
  }
}

fn msl_emit_func(
  ctx : MslCtx,
  f : WgslFuncDecl,
  bindings : Array[BindingInfo],
  globals : Array[WgslGlobalVar],
) -> Unit {
  let is_vs = wgsl_has_attr(f.attrs, "vertex")
  let is_fs = wgsl_has_attr(f.attrs, "fragment")
  let is_cs = wgsl_has_attr(f.attrs, "compute")
  let is_entry = is_vs || is_fs || is_cs

  let loc_params : Array[WgslParam] = []
  if is_vs || is_fs {
    let mut pi = 0
    while pi < f.params.length() {
      if wgsl_has_attr(f.params[pi].attrs, "location") {
        loc_params.push(f.params[pi])
      }
      pi = pi + 1
    }
  }
  let stage_in_struct = if loc_params.length() > 0 {
    "_wgsl_in_" + f.name
  } else {
    ""
  }
  if stage_in_struct.length() > 0 {
    ctx.sb.write_string("struct ")
    ctx.sb.write_string(stage_in_struct)
    ctx.sb.write_string(" {\n")
    let mut li = 0
    while li < loc_params.length() {
      let p = loc_params[li]
      let loc = match wgsl_find_attr(p.attrs, "location") {
        Some(a) => if a.args.length() > 0 { a.args[0] } else { "0" }
        None => "0"
      }
      ctx.sb.write_string("  ")
      msl_emit_type(ctx.sb, p.ty)
      ctx.sb.write_string(" ")
      ctx.sb.write_string(p.name)
      if is_vs {
        ctx.sb.write_string(" [[attribute(")
        ctx.sb.write_string(loc)
        ctx.sb.write_string(")]]")
      } else {
        ctx.sb.write_string(" [[user(loc")
        ctx.sb.write_string(loc)
        ctx.sb.write_string(")]]")
        ctx.sb.write_string(msl_interpolate_attr(p.attrs))
      }
      ctx.sb.write_string(";\n")
      li = li + 1
    }
    ctx.sb.write_string("};\n\n")
  }

  let mut wrap_ret = ""
  let ret_sb = StringBuilder::new()
  match f.ret_ty {
    Some(rt) =>
    if is_vs && wgsl_has_attr(f.ret_attrs, "builtin") {
      wrap_ret = "_wgsl_vs_out_" + f.name
      ctx.sb.write_string("struct ")
      ctx.sb.write_string(wrap_ret)
      ctx.sb.write_string(" {\n  ")
      msl_emit_type(ctx.sb, rt)
      ctx.sb.write_string(" _pos [[position]];\n};\n\n")
      ret_sb.write_string(wrap_ret)
    } else {
      msl_emit_type(ret_sb, rt)
    }
    None => ret_sb.write_string("void")
  }

  let qual = if is_vs {
    "vertex "
  } else if is_fs {
    "fragment "
  } else if is_cs {
    "kernel "
  } else {
    ""
  }
  let emitted_name = if is_entry { msl_entry_name(f.name) } else { f.name }
  ctx.sb.write_string(qual)
  ctx.sb.write_string(ret_sb.to_string())
  ctx.sb.write_string(" ")
  ctx.sb.write_string(emitted_name)
  ctx.sb.write_string("(")

  let mut param_count = 0
  if stage_in_struct.length() > 0 {
    ctx.sb.write_string(stage_in_struct)
    ctx.sb.write_string(" _wgsl_stage_in [[stage_in]]")
    param_count = param_count + 1
  }

  let mut pi = 0
  while pi < f.params.length() {
    let p = f.params[pi]
    if is_entry && wgsl_has_attr(p.attrs, "location") {
      pi = pi + 1
      continue
    }
    if param_count > 0 {
      ctx.sb.write_string(", ")
    }
    msl_emit_type(ctx.sb, p.ty)
    ctx.sb.write_string(" ")
    ctx.sb.write_string(p.name)
    match wgsl_find_attr(p.attrs, "builtin") {
      Some(ba) =>
      if ba.args.length() == 1 {
        ctx.sb.write_string(" ")
        ctx.sb.write_string(msl_builtin_attr(ba.args[0]))
      }
      None =>
      if is_entry {
        match p.ty {
          WgslType::Named(sn) =>
          match ctx.struct_names.get(sn) {
            Some(_) => ctx.sb.write_string(" [[stage_in]]")
            None => ()
          }
          _ => ()
        }
      }
    }
    param_count = param_count + 1
    pi = pi + 1
  }

  if is_entry {
    let mut bi = 0
    while bi < bindings.length() {
      let b = bindings[bi]
      let mut gi = 0
      while gi < globals.length() {
        if globals[gi].name == b.name {
          if param_count > 0 {
            ctx.sb.write_string(", ")
          }
          msl_emit_binding_param(ctx.sb, globals[gi], b.msl_slot)
          param_count = param_count + 1
          break
        }
        gi = gi + 1
      }
      bi = bi + 1
    }
  }

  ctx.sb.write_string(") {\n")
  ctx.indent = 1
  ctx.wrap_ret_struct = wrap_ret

  if stage_in_struct.length() > 0 {
    let mut li = 0
    while li < loc_params.length() {
      let p = loc_params[li]
      ctx.emit_indent()
      msl_emit_type(ctx.sb, p.ty)
      ctx.sb.write_string(" ")
      ctx.sb.write_string(p.name)
      ctx.sb.write_string(" = _wgsl_stage_in.")
      ctx.sb.write_string(p.name)
      ctx.sb.write_string(";\n")
      li = li + 1
    }
  }

  if is_entry {
    let mut gi = 0
    while gi < globals.length() {
      let g = globals[gi]
      if g.decl_kind == "var" && g.addr_space == "private" {
        ctx.emit_indent()
        ctx.sb.write_string("thread ")
        match g.ty {
          Some(t) => msl_emit_type(ctx.sb, t)
          None => ctx.sb.write_string("auto")
        }
        ctx.sb.write_string(" ")
        ctx.sb.write_string(g.name)
        match g.init {
          Some(ex) => {
            ctx.sb.write_string(" = ")
            ctx.emit_expr(ex)
            ctx.sb.write_string(";\n")
          }
          None => ctx.sb.write_string(" = {};\n")
        }
      } else if is_cs && g.decl_kind == "var" && g.addr_space == "workgroup" {
        ctx.emit_indent()
        ctx.sb.write_string("threadgroup ")
        match g.ty {
          Some(t) => msl_emit_type(ctx.sb, t)
          None => ctx.sb.write_string("float")
        }
        ctx.sb.write_string(" ")
        ctx.sb.write_string(g.name)
        ctx.sb.write_string(";\n")
      }
      gi = gi + 1
    }
  }

  ctx.emit_stmts(f.body)
  ctx.wrap_ret_struct = ""
  ctx.indent = 0
  ctx.sb.write_string("}\n\n")
}

fn wgsl_emit_msl(
  module_ast : WgslModule,
  reflection : ModuleReflection,
) -> Result[CompiledModule, WgslError] {
  let vs_in_structs : Map[String, Bool] = Map::new()
  let fs_out_structs : Map[String, Bool] = Map::new()
  let mut fi = 0
  while fi < module_ast.funcs.length() {
    let f = module_ast.funcs[fi]
    if wgsl_has_attr(f.attrs, "vertex") {
      let mut pi = 0
      while pi < f.params.length() {
        match f.params[pi].ty {
          WgslType::Named(sn) => vs_in_structs.set(sn, true)
          _ => ()
        }
        pi = pi + 1
      }
    }
    if wgsl_has_attr(f.attrs, "fragment") {
      match f.ret_ty {
        Some(WgslType::Named(sn)) => fs_out_structs.set(sn, true)
        _ => ()
      }
    }
    fi = fi + 1
  }

  let ctx = MslCtx::new(module_ast)
  ctx.sb.write_string("#include <metal_stdlib>\nusing namespace metal;\n\n")

  // Emit type aliases
  let mut ai = 0
  while ai < module_ast.aliases.length() {
    let a = module_ast.aliases[ai]
    ctx.sb.write_string("using ")
    ctx.sb.write_string(a.name)
    ctx.sb.write_string(" = ")
    msl_emit_type(ctx.sb, a.ty)
    ctx.sb.write_string(";\n")
    ai = ai + 1
  }
  if module_ast.aliases.length() > 0 {
    ctx.sb.write_string("\n")
  }

  // Emit module-level `const` and `override` declarations
  let mut gi = 0
  let mut emitted_const = false
  while gi < module_ast.globals.length() {
    let g = module_ast.globals[gi]
    if g.decl_kind == "const" {
      match g.init {
        Some(ex) => {
          ctx.sb.write_string("constant ")
          match g.ty {
            Some(t) => msl_emit_type(ctx.sb, t)
            None => ctx.sb.write_string("auto")
          }
          ctx.sb.write_string(" ")
          ctx.sb.write_string(g.name)
          ctx.sb.write_string(" = ")
          ctx.emit_expr(ex)
          ctx.sb.write_string(";\n")
          emitted_const = true
        }
        None => ()
      }
    } else if g.decl_kind == "override" {
      ctx.sb.write_string("constant ")
      match g.ty {
        Some(t) => msl_emit_type(ctx.sb, t)
        None => ctx.sb.write_string("float")
      }
      ctx.sb.write_string(" ")
      ctx.sb.write_string(g.name)
      match wgsl_find_attr(g.attrs, "id") {
        Some(ia) =>
        if ia.args.length() == 1 {
          ctx.sb.write_string(" [[function_constant(")
          ctx.sb.write_string(ia.args[0])
          ctx.sb.write_string(")]];\n")
        } else {
          ctx.sb.write_string(" = 0;\n")
        }
        None =>
        match g.init {
          Some(ex) => {
            ctx.sb.write_string(" = ")
            ctx.emit_expr(ex)
            ctx.sb.write_string(";\n")
          }
          None => ctx.sb.write_string(" = 0;\n")
        }
      }
      emitted_const = true
    }
    gi = gi + 1
  }
  if emitted_const {
    ctx.sb.write_string("\n")
  }

  // Emit structs
  let mut si = 0
  while si < module_ast.structs.length() {
    let s = module_ast.structs[si]
    let is_vi = match vs_in_structs.get(s.name) {
      Some(b) => b
      None => false
    }
    let is_fo = match fs_out_structs.get(s.name) {
      Some(b) => b
      None => false
    }
    msl_emit_struct(ctx, s, is_vi, is_fo)
    si = si + 1
  }

  // Emit functions
  fi = 0
  while fi < module_ast.funcs.length() {
    msl_emit_func(ctx, module_ast.funcs[fi], reflection.bindings, module_ast.globals)
    fi = fi + 1
  }

  Ok(CompiledModule::{ source: ctx.sb.to_string(), reflection: reflection })
}
