///| Pure-Pion WGSL -> Metal Shading Language (MSL 2.x) backend.
///| Supports host-shareable struct layout (`packed_float3`, `@size`, `@align`),
///| WGSL `loop`/`continuing` semantics, helper resource threading, forward declarations,
///| MSL keyword/macro escaping, `arrayLength` via buffer sizes (buffer 30),
///| workgroup zero-initialization, and full atomic/texture/math builtin coverage.

fn msl_scalar(s : String) -> String {
  if s == "f32" {
    "float"
  } else if s == "i32" {
    "int"
  } else if s == "u32" {
    "uint"
  } else if s == "bool" {
    "bool"
  } else if s == "f16" {
    "half"
  } else {
    s
  }
}

fn msl_hex_digit(n : Int) -> String {
  if n == 0 { "0" } else if n == 1 { "1" } else if n == 2 { "2" } else if n == 3 { "3" }
  else if n == 4 { "4" } else if n == 5 { "5" } else if n == 6 { "6" } else if n == 7 { "7" }
  else if n == 8 { "8" } else if n == 9 { "9" } else if n == 10 { "a" } else if n == 11 { "b" }
  else if n == 12 { "c" } else if n == 13 { "d" } else if n == 14 { "e" } else { "f" }
}

fn msl_is_reserved_ident(name : String) -> Bool {
  name == "device" || name == "constant" || name == "thread" || name == "threadgroup" ||
  name == "threadgroup_imageblock" || name == "ray_data" || name == "object_data" ||
  name == "kernel" || name == "vertex" || name == "fragment" || name == "mesh" || name == "object" ||
  name == "bool" || name == "char" || name == "uchar" || name == "short" || name == "ushort" ||
  name == "int" || name == "uint" || name == "long" || name == "ulong" || name == "half" ||
  name == "float" || name == "double" || name == "void" || name == "size_t" || name == "ptrdiff_t" ||
  name == "auto" || name == "class" || name == "struct" || name == "union" || name == "enum" ||
  name == "namespace" || name == "using" || name == "typedef" || name == "template" ||
  name == "typename" || name == "public" || name == "private" || name == "protected" ||
  name == "virtual" || name == "inline" || name == "static" || name == "extern" || name == "const" ||
  name == "constexpr" || name == "volatile" || name == "mutable" || name == "register" ||
  name == "sizeof" || name == "alignas" || name == "alignof" || name == "decltype" ||
  name == "nullptr" || name == "new" || name == "delete" || name == "operator" || name == "this" ||
  name == "friend" || name == "explicit" || name == "noexcept" || name == "throw" || name == "try" ||
  name == "catch" || name == "goto" || name == "do" || name == "asm" || name == "signed" ||
  name == "unsigned" || name == "bias" || name == "level" || name == "sample" ||
  name == "gradient2d" || name == "gradient3d" || name == "gradientcube" || name == "min_lod_clamp" ||
  name == "coord" || name == "filter" || name == "address" || name == "compare_func" ||
  name == "mip_filter" || name == "access" || name == "sampler" || name == "texture1d" ||
  name == "texture2d" || name == "texture3d" || name == "texturecube" || name == "depth2d" ||
  name == "depthcube" || name == "array" || name == "atomic" || name == "atomic_uint" ||
  name == "atomic_int" || name == "M_PI_F" || name == "M_E_F" || name == "M_LN2_F" ||
  name == "M_LN10_F" || name == "FLT_MAX" || name == "FLT_MIN" || name == "INFINITY" ||
  name == "NAN" || name == "HUGE_VALF" || name == "INT_MAX" || name == "INT_MIN" ||
  name == "UINT_MAX" || name == "GL_ES" || name == "NULL" || name == "main"
}

fn msl_ident(name : String) -> String {
  let mut has_non_ascii = false
  let mut i = 0
  while i < name.length() {
    if name.code_unit_at(i) >= 128 {
      has_non_ascii = true
      break
    }
    i = i + 1
  }
  if has_non_ascii {
    let sb = StringBuilder::new()
    sb.write_string("_u_")
    i = 0
    while i < name.length() {
      let b = name.code_unit_at(i)
      if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) {
        sb.write_string(name.slice(i, i + 1))
      } else {
        sb.write_string("_")
        sb.write_string(msl_hex_digit((b >> 4) & 15))
        sb.write_string(msl_hex_digit(b & 15))
      }
      i = i + 1
    }
    return sb.to_string()
  }
  if msl_is_reserved_ident(name) {
    "_w_" + name
  } else {
    name
  }
}

fn msl_storage_tex_elem(fmt : String) -> String {
  if fmt == "r32uint" || fmt == "rg32uint" || fmt == "rgba32uint" ||
  fmt == "rgba16uint" || fmt == "rgba8uint" {
    "uint"
  } else if fmt == "r32sint" || fmt == "rg32sint" || fmt == "rgba32sint" ||
  fmt == "rgba16sint" || fmt == "rgba8sint" {
    "int"
  } else {
    "float"
  }
}

fn msl_storage_tex_access(acc : String) -> String {
  if acc == "read" {
    "access::read"
  } else if acc == "read_write" {
    "access::read_write"
  } else {
    "access::write"
  }
}

fn msl_emit_type(sb : StringBuilder, ty : WgslType) -> Unit {
  match ty {
    WgslType::Scalar(s) => sb.write_string(msl_scalar(s))
    WgslType::Vec(d, e) => {
      sb.write_string(msl_scalar(e))
      sb.write_string(d.to_string())
    }
    WgslType::Mat(c, r, e) => {
      sb.write_string(msl_scalar(e))
      sb.write_string(c.to_string())
      sb.write_string("x")
      sb.write_string(r.to_string())
    }
    WgslType::Array(elem, len, len_ident) =>
    if len > 0 {
      sb.write_string("array<")
      msl_emit_type(sb, elem)
      sb.write_string(", ")
      sb.write_string(len.to_string())
      sb.write_string(">")
    } else if len_ident.length() > 0 {
      sb.write_string("array<")
      msl_emit_type(sb, elem)
      sb.write_string(", ")
      sb.write_string(msl_ident(len_ident))
      sb.write_string(">")
    } else {
      msl_emit_type(sb, elem)
    }
    WgslType::Texture(kind, elem, acc) =>
    if kind == "texture_1d" {
      sb.write_string("texture1d<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_2d" {
      sb.write_string("texture2d<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_2d_array" {
      sb.write_string("texture2d_array<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_3d" {
      sb.write_string("texture3d<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_cube" {
      sb.write_string("texturecube<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_cube_array" {
      sb.write_string("texturecube_array<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_multisampled_2d" {
      sb.write_string("texture2d_ms<")
      sb.write_string(msl_scalar(elem))
      sb.write_string(">")
    } else if kind == "texture_depth_2d" {
      sb.write_string("depth2d<float>")
    } else if kind == "texture_depth_2d_array" {
      sb.write_string("depth2d_array<float>")
    } else if kind == "texture_depth_cube" {
      sb.write_string("depthcube<float>")
    } else if kind == "texture_depth_cube_array" {
      sb.write_string("depthcube_array<float>")
    } else if kind == "texture_depth_multisampled_2d" {
      sb.write_string("depth2d_ms<float>")
    } else if kind == "texture_storage_1d" {
      sb.write_string("texture1d<")
      sb.write_string(msl_storage_tex_elem(elem))
      sb.write_string(", ")
      sb.write_string(msl_storage_tex_access(acc))
      sb.write_string(">")
    } else if kind == "texture_storage_2d" {
      sb.write_string("texture2d<")
      sb.write_string(msl_storage_tex_elem(elem))
      sb.write_string(", ")
      sb.write_string(msl_storage_tex_access(acc))
      sb.write_string(">")
    } else if kind == "texture_storage_2d_array" {
      sb.write_string("texture2d_array<")
      sb.write_string(msl_storage_tex_elem(elem))
      sb.write_string(", ")
      sb.write_string(msl_storage_tex_access(acc))
      sb.write_string(">")
    } else {
      sb.write_string("texture3d<")
      sb.write_string(msl_storage_tex_elem(elem))
      sb.write_string(", ")
      sb.write_string(msl_storage_tex_access(acc))
      sb.write_string(">")
    }
    WgslType::Sampler(_) => sb.write_string("sampler")
    WgslType::Atomic(e) =>
    if e == "u32" {
      sb.write_string("atomic_uint")
    } else {
      sb.write_string("atomic_int")
    }
    WgslType::Named(n) => sb.write_string(msl_ident(n))
    WgslType::Ptr(sp, elem, _) => {
      let msp = if sp == "function" || sp == "private" {
        "thread"
      } else if sp == "workgroup" {
        "threadgroup"
      } else if sp == "uniform" {
        "constant"
      } else {
        "device"
      }
      sb.write_string(msp)
      sb.write_string(" ")
      msl_emit_type(sb, elem)
      sb.write_string("*")
    }
  }
}

fn msl_builtin_attr(name : String) -> String {
  if name == "vertex_index" {
    "[[vertex_id]]"
  } else if name == "instance_index" {
    "[[instance_id]]"
  } else if name == "position" {
    "[[position]]"
  } else if name == "front_facing" {
    "[[front_facing]]"
  } else if name == "frag_depth" {
    "[[depth(any)]]"
  } else if name == "sample_index" {
    "[[sample_id]]"
  } else if name == "sample_mask" {
    "[[sample_mask]]"
  } else if name == "global_invocation_id" {
    "[[thread_position_in_grid]]"
  } else if name == "local_invocation_id" {
    "[[thread_position_in_threadgroup]]"
  } else if name == "workgroup_id" {
    "[[threadgroup_position_in_grid]]"
  } else if name == "local_invocation_index" {
    "[[thread_index_in_threadgroup]]"
  } else if name == "num_workgroups" {
    "[[threadgroups_per_grid]]"
  } else {
    ""
  }
}

fn msl_interpolate_attr(attrs : Array[WgslAttr]) -> String {
  match wgsl_find_attr(attrs, "interpolate") {
    Some(ia) =>
    if ia.args.length() >= 1 {
      let kind = ia.args[0]
      let samp = if ia.args.length() >= 2 { ia.args[1] } else { "center" }
      if kind == "flat" {
        " [[flat]]"
      } else if kind == "linear" {
        if samp == "centroid" {
          " [[centroid_no_perspective]]"
        } else if samp == "sample" {
          " [[sample_no_perspective]]"
        } else {
          " [[center_no_perspective]]"
        }
      } else if samp == "centroid" {
        " [[centroid_perspective]]"
      } else if samp == "sample" {
        " [[sample_perspective]]"
      } else {
        " [[center_perspective]]"
      }
    } else {
      ""
    }
    None => ""
  }
}

// --- WGSL Host-Shareable Layout Calculator ---

fn wgsl_round_up(align : Int, v : Int) -> Int {
  if align <= 1 {
    v
  } else {
    let rem = v % align
    if rem == 0 { v } else { v + (align - rem) }
  }
}

fn wgsl_layout_size_align(
  ty : WgslType,
  structs : Map[String, WgslStructDecl],
  aliases : Map[String, WgslType],
  const_ints : Map[String, Int64],
  depth : Int,
) -> (Int, Int) {
  if depth > 32 {
    return (4, 4)
  }
  let resolved = wgsl_resolve_alias_depth(ty, aliases, 0)
  match resolved {
    WgslType::Scalar(s) =>
    if s == "f16" { (2, 2) } else { (4, 4) }
    WgslType::Vec(d, e) => {
      let es = if e == "f16" { 2 } else { 4 }
      if d == 2 {
        (2 * es, 2 * es)
      } else if d == 3 {
        (3 * es, 4 * es)
      } else {
        (4 * es, 4 * es)
      }
    }
    WgslType::Mat(c, r, e) => {
      let (cs, ca) = wgsl_layout_size_align(WgslType::Vec(r, e), structs, aliases, const_ints, depth + 1)
      let stride = wgsl_round_up(ca, cs)
      (c * stride, ca)
    }
    WgslType::Atomic(_) => (4, 4)
    WgslType::Array(elem, len, len_ident) => {
      let (es, ea) = wgsl_layout_size_align(elem, structs, aliases, const_ints, depth + 1)
      let stride = wgsl_round_up(ea, es)
      let n = if len > 0 {
        len
      } else if len_ident.length() > 0 {
        match const_ints.get(len_ident) {
          Some(v) => v.to_int()
          None => 0
        }
      } else {
        0
      }
      (n * stride, ea)
    }
    WgslType::Named(sn) =>
    match structs.get(sn) {
      Some(st) => {
        let mut cur = 0
        let mut max_a = 1
        let mut fi = 0
        while fi < st.fields.length() {
          let f = st.fields[fi]
          let (fs, fa) = wgsl_layout_size_align(f.ty, structs, aliases, const_ints, depth + 1)
          let mut eff_a = fa
          match wgsl_find_attr(f.attrs, "align") {
            Some(aa) =>
            if aa.args.length() == 1 {
              match wgsl_parse_int_str(aa.args[0]) {
                Some(v) => if v > eff_a { eff_a = v }
                None => ()
              }
            }
            None => ()
          }
          let mut eff_s = fs
          match wgsl_find_attr(f.attrs, "size") {
            Some(sa) =>
            if sa.args.length() == 1 {
              match wgsl_parse_int_str(sa.args[0]) {
                Some(v) => if v > eff_s { eff_s = v }
                None => ()
              }
            }
            None => ()
          }
          let off = wgsl_round_up(eff_a, cur)
          cur = off + eff_s
          if eff_a > max_a {
            max_a = eff_a
          }
          fi = fi + 1
        }
        (wgsl_round_up(max_a, cur), max_a)
      }
      None => (4, 4)
    }
    _ => (4, 4)
  }
}

fn wgsl_struct_field_offset(
  st : WgslStructDecl,
  field_name : String,
  structs : Map[String, WgslStructDecl],
  aliases : Map[String, WgslType],
  const_ints : Map[String, Int64],
) -> Int {
  let mut cur = 0
  let mut fi = 0
  while fi < st.fields.length() {
    let f = st.fields[fi]
    let (fs, fa) = wgsl_layout_size_align(f.ty, structs, aliases, const_ints, 0)
    let mut eff_a = fa
    match wgsl_find_attr(f.attrs, "align") {
      Some(aa) =>
      if aa.args.length() == 1 {
        match wgsl_parse_int_str(aa.args[0]) {
          Some(v) => if v > eff_a { eff_a = v }
          None => ()
        }
      }
      None => ()
    }
    let off = wgsl_round_up(eff_a, cur)
    if f.name == field_name {
      return off
    }
    let mut eff_s = fs
    match wgsl_find_attr(f.attrs, "size") {
      Some(sa) =>
      if sa.args.length() == 1 {
        match wgsl_parse_int_str(sa.args[0]) {
          Some(v) => if v > eff_s { eff_s = v }
          None => ()
        }
      }
      None => ()
    }
    cur = off + eff_s
    fi = fi + 1
  }
  0
}

// --- Helper Dependency Analysis (globals & arrayLength) ---

fn msl_collect_expr_refs(
  expr : WgslExpr,
  refs : Map[String, Bool],
  calls : Map[String, Bool],
  call_list : Array[String],
  uses_arr_len : Array[Bool],
) -> Unit {
  match expr {
    WgslExpr::Ident(name, _, _) => refs.set(name, true)
    WgslExpr::Paren(inner, _, _) => msl_collect_expr_refs(inner, refs, calls, call_list, uses_arr_len)
    WgslExpr::Unary(_, inner, _, _) => msl_collect_expr_refs(inner, refs, calls, call_list, uses_arr_len)
    WgslExpr::Binary(_, l, r, _, _) => {
      msl_collect_expr_refs(l, refs, calls, call_list, uses_arr_len)
      msl_collect_expr_refs(r, refs, calls, call_list, uses_arr_len)
    }
    WgslExpr::Index(b, idx, _, _) => {
      msl_collect_expr_refs(b, refs, calls, call_list, uses_arr_len)
      msl_collect_expr_refs(idx, refs, calls, call_list, uses_arr_len)
    }
    WgslExpr::Field(b, _, _, _) => msl_collect_expr_refs(b, refs, calls, call_list, uses_arr_len)
    WgslExpr::Call(name, _, _, _, args, _, _) => {
      if name == "arrayLength" {
        uses_arr_len[0] = true
      }
      match calls.get(name) {
        Some(true) => ()
        _ => {
          calls.set(name, true)
          call_list.push(name)
        }
      }
      let mut i = 0
      while i < args.length() {
        msl_collect_expr_refs(args[i], refs, calls, call_list, uses_arr_len)
        i = i + 1
      }
    }
    _ => ()
  }
}

fn msl_collect_stmts_refs(
  stmts : Array[WgslStmt],
  refs : Map[String, Bool],
  calls : Map[String, Bool],
  call_list : Array[String],
  uses_arr_len : Array[Bool],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      WgslStmt::VarDecl(_, _, _, opt_init, _, _) =>
      match opt_init {
        Some(ex) => msl_collect_expr_refs(ex, refs, calls, call_list, uses_arr_len)
        None => ()
      }
      WgslStmt::Assign(lhs, _, rhs, _, _) => {
        msl_collect_expr_refs(lhs, refs, calls, call_list, uses_arr_len)
        msl_collect_expr_refs(rhs, refs, calls, call_list, uses_arr_len)
      }
      WgslStmt::PhonyAssign(rhs, _, _) => msl_collect_expr_refs(rhs, refs, calls, call_list, uses_arr_len)
      WgslStmt::IncDec(lhs, _, _, _) => msl_collect_expr_refs(lhs, refs, calls, call_list, uses_arr_len)
      WgslStmt::ExprStmt(ex, _, _) => msl_collect_expr_refs(ex, refs, calls, call_list, uses_arr_len)
      WgslStmt::Return(opt_ex, _, _) =>
      match opt_ex {
        Some(ex) => msl_collect_expr_refs(ex, refs, calls, call_list, uses_arr_len)
        None => ()
      }
      WgslStmt::If(c, tb, eb, _, _) => {
        msl_collect_expr_refs(c, refs, calls, call_list, uses_arr_len)
        msl_collect_stmts_refs(tb, refs, calls, call_list, uses_arr_len)
        msl_collect_stmts_refs(eb, refs, calls, call_list, uses_arr_len)
      }
      WgslStmt::Switch(sel, cases, _, _) => {
        msl_collect_expr_refs(sel, refs, calls, call_list, uses_arr_len)
        let mut ci = 0
        while ci < cases.length() {
          let mut si = 0
          while si < cases[ci].selectors.length() {
            msl_collect_expr_refs(cases[ci].selectors[si], refs, calls, call_list, uses_arr_len)
            si = si + 1
          }
          msl_collect_stmts_refs(cases[ci].body, refs, calls, call_list, uses_arr_len)
          ci = ci + 1
        }
      }
      WgslStmt::For(init, cond, upd, body, _, _) => {
        match init {
          Some(st) => msl_collect_stmts_refs([st], refs, calls, call_list, uses_arr_len)
          None => ()
        }
        match cond {
          Some(ex) => msl_collect_expr_refs(ex, refs, calls, call_list, uses_arr_len)
          None => ()
        }
        match upd {
          Some(st) => msl_collect_stmts_refs([st], refs, calls, call_list, uses_arr_len)
          None => ()
        }
        msl_collect_stmts_refs(body, refs, calls, call_list, uses_arr_len)
      }
      WgslStmt::While(c, body, _, _) => {
        msl_collect_expr_refs(c, refs, calls, call_list, uses_arr_len)
        msl_collect_stmts_refs(body, refs, calls, call_list, uses_arr_len)
      }
      WgslStmt::Loop(body, cont, bif, _, _) => {
        msl_collect_stmts_refs(body, refs, calls, call_list, uses_arr_len)
        msl_collect_stmts_refs(cont, refs, calls, call_list, uses_arr_len)
        match bif {
          Some(ex) => msl_collect_expr_refs(ex, refs, calls, call_list, uses_arr_len)
          None => ()
        }
      }
      WgslStmt::Block(body, _, _) => msl_collect_stmts_refs(body, refs, calls, call_list, uses_arr_len)
      _ => ()
    }
    i = i + 1
  }
}

struct MslCtx {
  sb : StringBuilder
  m : WgslModule
  struct_map : Map[String, WgslStructDecl]
  alias_map : Map[String, WgslType]
  func_map : Map[String, WgslFuncDecl]
  binding_slots : Map[String, Int]
  const_ints : Map[String, Int64]
  helper_globals : Map[String, Array[String]]
  helper_needs_sizes : Map[String, Bool]
  scopes : Array[Map[String, SemType]]
  mut indent : Int
  mut wrap_ret_struct : String
  mut loop_counter : Int
}

fn MslCtx::lookup_type(self : MslCtx, name : String) -> Option[SemType] {
  let mut i = self.scopes.length() - 1
  while i >= 0 {
    match self.scopes[i].get(name) {
      Some(t) => return Some(t)
      None => ()
    }
    i = i - 1
  }
  None
}

fn MslCtx::define_type(self : MslCtx, name : String, ty : SemType) -> Unit {
  if self.scopes.length() > 0 {
    self.scopes[self.scopes.length() - 1].set(name, ty)
  }
}

fn MslCtx::push_scope(self : MslCtx) -> Unit {
  self.scopes.push(Map::new())
}

fn MslCtx::pop_scope(self : MslCtx) -> Unit {
  if self.scopes.length() > 1 {
    let _ = self.scopes.pop()
  }
}

fn MslCtx::infer_expr_type(self : MslCtx, expr : WgslExpr) -> SemType {
  match expr {
    WgslExpr::Ident(name, _, _) =>
    match self.lookup_type(name) {
      Some(t) => t
      None => SemType::Scalar("f32")
    }
    WgslExpr::IntLit(s, _, _) => {
      let n = s.length()
      if n > 0 && s.code_unit_at(n - 1) == 117 {
        SemType::Scalar("u32")
      } else if n > 0 && s.code_unit_at(n - 1) == 105 {
        SemType::Scalar("i32")
      } else {
        SemType::AbstractInt
      }
    }
    WgslExpr::FloatLit(s, _, _) => {
      let n = s.length()
      if n > 0 && s.code_unit_at(n - 1) == 104 {
        SemType::Scalar("f16")
      } else {
        SemType::Scalar("f32")
      }
    }
    WgslExpr::BoolLit(_, _, _) => SemType::Scalar("bool")
    WgslExpr::Paren(inner, _, _) => self.infer_expr_type(inner)
    WgslExpr::Unary(op, inner, _, _) => {
      let it = self.infer_expr_type(inner)
      if op == "&" {
        SemType::Ptr("function", it, "read_write")
      } else if op == "*" {
        match it {
          SemType::Ptr(_, elem, _) => elem
          _ => it
        }
      } else {
        it
      }
    }
    WgslExpr::Binary(op, l, r, _, _) => {
      let lt = self.infer_expr_type(l)
      let rt = self.infer_expr_type(r)
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        match (lt, rt) {
          (SemType::Vec(d, _), _) | (_, SemType::Vec(d, _)) => return SemType::Vec(d, "bool")
          _ => return SemType::Scalar("bool")
        }
      }
      if op == "&&" || op == "||" {
        return SemType::Scalar("bool")
      }
      match (lt, rt) {
        (SemType::Mat(_, rows, e), SemType::Vec(_, _)) => SemType::Vec(rows, e)
        (SemType::Vec(_, _), SemType::Mat(cols, _, e)) => SemType::Vec(cols, e)
        (SemType::Mat(_, r1, e), SemType::Mat(c2, _, _)) => SemType::Mat(c2, r1, e)
        (SemType::Vec(d, e1), SemType::Vec(_, e2)) => SemType::Vec(d, sem_promote_scalar(e1, e2))
        (SemType::Vec(d, e1), _) => SemType::Vec(d, sem_promote_scalar(e1, sem_scalar_name(rt)))
        (_, SemType::Vec(d, e2)) => SemType::Vec(d, sem_promote_scalar(sem_scalar_name(lt), e2))
        (SemType::AbstractInt, _) => rt
        (_, SemType::AbstractInt) => lt
        _ => lt
      }
    }
    WgslExpr::Index(base, _, _, _) => {
      let bt = self.infer_expr_type(base)
      let unptr = match bt {
        SemType::Ptr(_, elem, _) => elem
        _ => bt
      }
      match unptr {
        SemType::Array(elem, _) => elem
        SemType::Vec(_, e) => SemType::Scalar(e)
        SemType::Mat(_, r, e) => SemType::Vec(r, e)
        _ => SemType::Scalar("f32")
      }
    }
    WgslExpr::Field(base, fld, _, _) => {
      let bt = self.infer_expr_type(base)
      let unptr = match bt {
        SemType::Ptr(_, elem, _) => elem
        _ => bt
      }
      match unptr {
        SemType::Struct(sn) =>
        match self.struct_map.get(sn) {
          Some(st) => {
            let mut fi = 0
            while fi < st.fields.length() {
              if st.fields[fi].name == fld {
                return wgsl_type_to_sem(st.fields[fi].ty, self.alias_map, self.const_ints)
              }
              fi = fi + 1
            }
            SemType::Scalar("f32")
          }
          None => SemType::Scalar("f32")
        }
        SemType::Vec(_, e) =>
        if fld.length() == 1 { SemType::Scalar(e) } else { SemType::Vec(fld.length(), e) }
        _ => SemType::Scalar("f32")
      }
    }
    WgslExpr::Call(name, targs, _, _, args, _, _) => {
      match self.func_map.get(name) {
        Some(f) =>
        match f.ret_ty {
          Some(rt) => return wgsl_type_to_sem(rt, self.alias_map, self.const_ints)
          None => return SemType::Void
        }
        None => ()
      }
      match self.struct_map.get(name) {
        Some(_) => return SemType::Struct(name)
        None => ()
      }
      if name == "f32" || name == "f16" || name == "i32" || name == "u32" || name == "bool" {
        return SemType::Scalar(name)
      }
      if (name == "vec2" || name == "vec3" || name == "vec4") && targs.length() == 1 {
        let dim = name.code_unit_at(3) - 48
        match wgsl_type_to_sem(targs[0], self.alias_map, self.const_ints) {
          SemType::Scalar(s) => return SemType::Vec(dim, s)
          _ => return SemType::Vec(dim, "f32")
        }
      }
      match wgsl_resolve_vec_alias(name) {
        Some(vt) => return wgsl_type_to_sem(vt, self.alias_map, self.const_ints)
        None => ()
      }
      if args.length() > 0 {
        self.infer_expr_type(args[0])
      } else {
        SemType::Scalar("f32")
      }
    }
  }
}

fn MslCtx::emit_indent(self : MslCtx) -> Unit {
  let mut i = 0
  while i < self.indent {
    self.sb.write_string("  ")
    i = i + 1
  }
}

fn msl_emit_int_lit(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  if n > 1 && s.code_unit_at(n - 1) == 105 {
    sb.write_string(s.slice(0, n - 1))
  } else {
    sb.write_string(s)
  }
}

fn msl_emit_float_lit(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  if n == 0 {
    return
  }
  let last = s.code_unit_at(n - 1)
  let has_suf = last == 102 || last == 104
  let body = if has_suf { s.slice(0, n - 1) } else { s }
  let suf = if has_suf { s.slice(n - 1, n) } else { "f" }
  // Check if body contains '.', 'e', 'E', 'p', 'P'
  let mut has_dot_or_exp = false
  let mut i = 0
  while i < body.length() {
    let c = body.code_unit_at(i)
    if c == 46 || c == 101 || c == 69 || c == 112 || c == 80 {
      has_dot_or_exp = true
      break
    }
    i = i + 1
  }
  sb.write_string(body)
  if !has_dot_or_exp {
    sb.write_string(".0")
  }
  sb.write_string(suf)
}

fn MslCtx::emit_arg_list(self : MslCtx, args : Array[WgslExpr]) -> Unit {
  let mut i = 0
  while i < args.length() {
    if i > 0 {
      self.sb.write_string(", ")
    }
    self.emit_expr(args[i])
    i = i + 1
  }
}

fn msl_gather_comp(expr : WgslExpr) -> String {
  match expr {
    WgslExpr::IntLit(s, _, _) =>
    match wgsl_parse_int_str(s) {
      Some(0) => "component::x"
      Some(1) => "component::y"
      Some(2) => "component::z"
      Some(3) => "component::w"
      _ => "component::x"
    }
    _ => "component::x"
  }
}

fn MslCtx::emit_array_length(self : MslCtx, arg : WgslExpr) -> Unit {
  let target = match arg {
    WgslExpr::Unary("&", e, _, _) => e
    _ => arg
  }
  match target {
    WgslExpr::Ident(name, _, _) => {
      let slot = match self.binding_slots.get(name) {
        Some(s) => s
        None => 0
      }
      self.sb.write_string("(_wgsl_buffer_sizes[")
      self.sb.write_string(slot.to_string())
      self.sb.write_string("] / uint(sizeof(")
      self.sb.write_string(msl_ident(name))
      self.sb.write_string("[0])))")
    }
    WgslExpr::Field(WgslExpr::Ident(base_name, _, _), fld, _, _) => {
      let slot = match self.binding_slots.get(base_name) {
        Some(s) => s
        None => 0
      }
      let off = match self.lookup_type(base_name) {
        Some(SemType::Struct(sn)) =>
        match self.struct_map.get(sn) {
          Some(st) => wgsl_struct_field_offset(st, fld, self.struct_map, self.alias_map, self.const_ints)
          None => 0
        }
        _ => 0
      }
      self.sb.write_string("((_wgsl_buffer_sizes[")
      self.sb.write_string(slot.to_string())
      self.sb.write_string("] - ")
      self.sb.write_string(off.to_string())
      self.sb.write_string("u) / uint(sizeof(")
      self.sb.write_string(msl_ident(base_name))
      self.sb.write_string(".")
      self.sb.write_string(msl_ident(fld))
      self.sb.write_string("[0])))")
    }
    _ => {
      self.sb.write_string("uint(sizeof(")
      self.emit_expr(target)
      self.sb.write_string(") / sizeof(")
      self.emit_expr(target)
      self.sb.write_string("[0]))")
    }
  }
}

fn MslCtx::emit_expr(self : MslCtx, expr : WgslExpr) -> Unit {
  match expr {
    WgslExpr::Ident(name, _, _) => self.sb.write_string(msl_ident(name))
    WgslExpr::IntLit(s, _, _) => msl_emit_int_lit(self.sb, s)
    WgslExpr::FloatLit(s, _, _) => msl_emit_float_lit(self.sb, s)
    WgslExpr::BoolLit(b, _, _) => self.sb.write_string(if b { "true" } else { "false" })
    WgslExpr::Paren(inner, _, _) => {
      self.sb.write_string("(")
      self.emit_expr(inner)
      self.sb.write_string(")")
    }
    WgslExpr::Unary(op, inner, _, _) =>
    if op == "-" || op == "!" || op == "~" {
      match inner {
        WgslExpr::Unary(_, _, _, _) => {
          self.sb.write_string(op)
          self.sb.write_string("(")
          self.emit_expr(inner)
          self.sb.write_string(")")
        }
        _ => {
          self.sb.write_string(op)
          self.emit_expr(inner)
        }
      }
    } else {
      self.sb.write_string(op)
      self.emit_expr(inner)
    }
    WgslExpr::Binary(op, l, r, _, _) => {
      if op == "%" {
        let lt = self.infer_expr_type(l)
        let rt = self.infer_expr_type(r)
        if sem_is_float_type(lt) || sem_is_float_type(rt) {
          self.sb.write_string("metal::fmod(")
          self.emit_expr(l)
          self.sb.write_string(", ")
          self.emit_expr(r)
          self.sb.write_string(")")
          return
        }
      }
      self.emit_expr(l)
      self.sb.write_string(" ")
      self.sb.write_string(op)
      self.sb.write_string(" ")
      self.emit_expr(r)
    }
    WgslExpr::Index(base, idx, _, _) => {
      self.emit_expr(base)
      self.sb.write_string("[")
      self.emit_expr(idx)
      self.sb.write_string("]")
    }
    WgslExpr::Field(base, fld, _, _) => {
      self.emit_expr(base)
      self.sb.write_string(".")
      let bt = self.infer_expr_type(base)
      let unptr = match bt {
        SemType::Ptr(_, elem, _) => elem
        _ => bt
      }
      match unptr {
        SemType::Struct(_) => self.sb.write_string(msl_ident(fld))
        _ => self.sb.write_string(fld)
      }
    }
    WgslExpr::Call(name, targs, arr_len, len_ident, args, _, _) => {
      if name == "textureSample" && args.length() >= 3 {
        self.emit_expr(args[0])
        self.sb.write_string(".sample(")
        self.emit_expr(args[1])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        if args.length() >= 4 {
          self.sb.write_string(", ")
          self.emit_expr(args[3])
        }
        self.sb.write_string(")")
        return
      }
      if name == "textureSampleLevel" && args.length() >= 4 {
        self.emit_expr(args[0])
        self.sb.write_string(".sample(")
        self.emit_expr(args[1])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        if args.length() >= 5 {
          self.sb.write_string(", ")
          self.emit_expr(args[3])
          self.sb.write_string(", metal::level(")
          self.emit_expr(args[4])
          self.sb.write_string("))")
        } else {
          self.sb.write_string(", metal::level(")
          self.emit_expr(args[3])
          self.sb.write_string("))")
        }
        return
      }
      if name == "textureSampleBias" && args.length() >= 4 {
        self.emit_expr(args[0])
        self.sb.write_string(".sample(")
        self.emit_expr(args[1])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        if args.length() >= 5 {
          self.sb.write_string(", ")
          self.emit_expr(args[3])
          self.sb.write_string(", metal::bias(")
          self.emit_expr(args[4])
          self.sb.write_string("))")
        } else {
          self.sb.write_string(", metal::bias(")
          self.emit_expr(args[3])
          self.sb.write_string("))")
        }
        return
      }
      if name == "textureSampleGrad" && args.length() >= 5 {
        let tk = match self.infer_expr_type(args[0]) {
          SemType::Texture(k, _, _) => k
          _ => "texture_2d"
        }
        let grad_fn = if tk == "texture_3d" {
          "metal::gradient3d"
        } else if tk == "texture_cube" || tk == "texture_cube_array" {
          "metal::gradientcube"
        } else {
          "metal::gradient2d"
        }
        self.emit_expr(args[0])
        self.sb.write_string(".sample(")
        self.emit_expr(args[1])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        if args.length() >= 6 {
          self.sb.write_string(", ")
          self.emit_expr(args[3])
          self.sb.write_string(", ")
          self.sb.write_string(grad_fn)
          self.sb.write_string("(")
          self.emit_expr(args[4])
          self.sb.write_string(", ")
          self.emit_expr(args[5])
          self.sb.write_string("))")
        } else {
          self.sb.write_string(", ")
          self.sb.write_string(grad_fn)
          self.sb.write_string("(")
          self.emit_expr(args[3])
          self.sb.write_string(", ")
          self.emit_expr(args[4])
          self.sb.write_string("))")
        }
        return
      }
      if name == "textureSampleCompare" && args.length() >= 4 {
        self.emit_expr(args[0])
        self.sb.write_string(".sample_compare(")
        self.emit_expr(args[1])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string(", ")
        self.emit_expr(args[3])
        if args.length() >= 5 {
          self.sb.write_string(", ")
          self.emit_expr(args[4])
        }
        self.sb.write_string(")")
        return
      }
      if name == "textureSampleCompareLevel" && args.length() >= 4 {
        self.emit_expr(args[0])
        self.sb.write_string(".sample_compare(")
        self.emit_expr(args[1])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        if args.length() >= 5 {
          self.sb.write_string(", ")
          self.emit_expr(args[3])
          self.sb.write_string(", ")
          self.emit_expr(args[4])
          self.sb.write_string(", metal::level(0))")
        } else {
          self.sb.write_string(", ")
          self.emit_expr(args[3])
          self.sb.write_string(", metal::level(0))")
        }
        return
      }
      if name == "textureGather" && args.length() >= 3 {
        let has_comp = match self.infer_expr_type(args[0]) {
          SemType::Texture(_, _, _) => false
          _ => true
        }
        if has_comp && args.length() >= 4 {
          let comp = msl_gather_comp(args[0])
          self.emit_expr(args[1])
          self.sb.write_string(".gather(")
          self.emit_expr(args[2])
          self.sb.write_string(", ")
          self.emit_expr(args[3])
          self.sb.write_string(", int2(0), ")
          self.sb.write_string(comp)
          self.sb.write_string(")")
        } else {
          self.emit_expr(args[0])
          self.sb.write_string(".gather(")
          self.emit_expr(args[1])
          self.sb.write_string(", ")
          self.emit_expr(args[2])
          self.sb.write_string(")")
        }
        return
      }
      if name == "textureLoad" && args.length() >= 2 {
        let tk = match self.infer_expr_type(args[0]) {
          SemType::Texture(k, _, _) => k
          _ => "texture_2d"
        }
        let cty = if tk == "texture_1d" || tk == "texture_storage_1d" {
          "uint"
        } else if tk == "texture_3d" || tk == "texture_storage_3d" {
          "uint3"
        } else {
          "uint2"
        }
        self.emit_expr(args[0])
        self.sb.write_string(".read(")
        self.sb.write_string(cty)
        self.sb.write_string("(")
        self.emit_expr(args[1])
        self.sb.write_string(")")
        if args.length() >= 3 {
          self.sb.write_string(", uint(")
          self.emit_expr(args[2])
          self.sb.write_string(")")
        }
        if args.length() >= 4 {
          self.sb.write_string(", uint(")
          self.emit_expr(args[3])
          self.sb.write_string(")")
        }
        self.sb.write_string(")")
        return
      }
      if name == "textureStore" && args.length() >= 3 {
        let tk = match self.infer_expr_type(args[0]) {
          SemType::Texture(k, _, _) => k
          _ => "texture_storage_2d"
        }
        let cty = if tk == "texture_storage_1d" {
          "uint"
        } else if tk == "texture_storage_3d" {
          "uint3"
        } else {
          "uint2"
        }
        self.emit_expr(args[0])
        self.sb.write_string(".write(")
        self.emit_expr(args[args.length() - 1])
        self.sb.write_string(", ")
        self.sb.write_string(cty)
        self.sb.write_string("(")
        self.emit_expr(args[1])
        self.sb.write_string(")")
        if args.length() == 4 {
          self.sb.write_string(", uint(")
          self.emit_expr(args[2])
          self.sb.write_string(")")
        }
        self.sb.write_string(")")
        return
      }
      if name == "textureDimensions" && args.length() >= 1 {
        let tk = match self.infer_expr_type(args[0]) {
          SemType::Texture(k, _, _) => k
          _ => "texture_2d"
        }
        if tk == "texture_1d" || tk == "texture_storage_1d" {
          self.sb.write_string("uint(")
          self.emit_expr(args[0])
          self.sb.write_string(".get_width())")
        } else if tk == "texture_3d" || tk == "texture_storage_3d" {
          self.sb.write_string("uint3(")
          self.emit_expr(args[0])
          self.sb.write_string(".get_width(), ")
          self.emit_expr(args[0])
          self.sb.write_string(".get_height(), ")
          self.emit_expr(args[0])
          self.sb.write_string(".get_depth())")
        } else {
          self.sb.write_string("uint2(")
          self.emit_expr(args[0])
          self.sb.write_string(".get_width(), ")
          self.emit_expr(args[0])
          self.sb.write_string(".get_height())")
        }
        return
      }
      if name == "textureNumLevels" && args.length() == 1 {
        self.sb.write_string("uint(")
        self.emit_expr(args[0])
        self.sb.write_string(".get_num_mip_levels())")
        return
      }
      if name == "textureNumLayers" && args.length() == 1 {
        self.sb.write_string("uint(")
        self.emit_expr(args[0])
        self.sb.write_string(".get_array_size())")
        return
      }
      if name == "textureNumSamples" && args.length() == 1 {
        self.sb.write_string("uint(")
        self.emit_expr(args[0])
        self.sb.write_string(".get_num_samples())")
        return
      }
      if name == "arrayLength" && args.length() == 1 {
        self.emit_array_length(args[0])
        return
      }
      if name == "workgroupBarrier" {
        self.sb.write_string("threadgroup_barrier(mem_flags::mem_threadgroup)")
        return
      }
      if name == "storageBarrier" {
        self.sb.write_string("threadgroup_barrier(mem_flags::mem_device)")
        return
      }
      if name == "textureBarrier" {
        self.sb.write_string("threadgroup_barrier(mem_flags::mem_texture)")
        return
      }
      if name == "bitcast" && targs.length() == 1 && args.length() == 1 {
        self.sb.write_string("as_type<")
        msl_emit_type(self.sb, targs[0])
        self.sb.write_string(">(")
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "atomicLoad" && args.length() == 1 {
        self.sb.write_string("atomic_load_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicStore" && args.length() == 2 {
        self.sb.write_string("atomic_store_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicAdd" && args.length() == 2 {
        self.sb.write_string("atomic_fetch_add_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicSub" && args.length() == 2 {
        self.sb.write_string("atomic_fetch_sub_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicMax" && args.length() == 2 {
        self.sb.write_string("atomic_fetch_max_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicMin" && args.length() == 2 {
        self.sb.write_string("atomic_fetch_min_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicAnd" && args.length() == 2 {
        self.sb.write_string("atomic_fetch_and_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicOr" && args.length() == 2 {
        self.sb.write_string("atomic_fetch_or_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicXor" && args.length() == 2 {
        self.sb.write_string("atomic_fetch_xor_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicExchange" && args.length() == 2 {
        self.sb.write_string("atomic_exchange_explicit(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", memory_order_relaxed)")
        return
      }
      if name == "atomicCompareExchangeWeak" && args.length() == 3 {
        self.sb.write_string("_wgsl_atomic_cas(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      if name == "degrees" && args.length() == 1 {
        self.sb.write_string("((")
        self.emit_expr(args[0])
        self.sb.write_string(") * 57.29577951308232f)")
        return
      }
      if name == "radians" && args.length() == 1 {
        self.sb.write_string("((")
        self.emit_expr(args[0])
        self.sb.write_string(") * 0.017453292519943295f)")
        return
      }
      if name == "quantizeToF16" && args.length() == 1 {
        self.sb.write_string("float(half(")
        self.emit_expr(args[0])
        self.sb.write_string("))")
        return
      }
      if name == "modf" && args.length() == 1 {
        self.sb.write_string("_wgsl_modf(")
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "frexp" && args.length() == 1 {
        self.sb.write_string("_wgsl_frexp(")
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "firstLeadingBit" && args.length() == 1 {
        self.sb.write_string("_wgsl_first_leading_bit(")
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "firstTrailingBit" && args.length() == 1 {
        self.sb.write_string("_wgsl_first_trailing_bit(")
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "pack2x16float" && args.length() == 1 {
        self.sb.write_string("as_type<uint>(half2(")
        self.emit_expr(args[0])
        self.sb.write_string("))")
        return
      }
      if name == "unpack2x16float" && args.length() == 1 {
        self.sb.write_string("float2(as_type<half2>(")
        self.emit_expr(args[0])
        self.sb.write_string("))")
        return
      }
      if name == "array" && targs.length() == 1 {
        self.sb.write_string("array<")
        msl_emit_type(self.sb, targs[0])
        self.sb.write_string(", ")
        if arr_len > 0 {
          self.sb.write_string(arr_len.to_string())
        } else if len_ident.length() > 0 {
          self.sb.write_string(msl_ident(len_ident))
        } else {
          self.sb.write_string(args.length().to_string())
        }
        self.sb.write_string(">{")
        self.emit_arg_list(args)
        self.sb.write_string("}")
        return
      }
      if (name == "vec2" || name == "vec3" || name == "vec4") && targs.length() == 1 {
        let dim = name.code_unit_at(3) - 48
        msl_emit_type(self.sb, targs[0])
        self.sb.write_string(dim.to_string())
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      if (name == "mat2x2" || name == "mat3x3" || name == "mat4x4" ||
        name == "mat2x3" || name == "mat2x4" || name == "mat3x2" ||
        name == "mat3x4" || name == "mat4x2" || name == "mat4x3") && targs.length() == 1 {
        let cols = name.code_unit_at(3) - 48
        let rows = name.code_unit_at(5) - 48
        msl_emit_type(self.sb, targs[0])
        self.sb.write_string(cols.to_string())
        self.sb.write_string("x")
        self.sb.write_string(rows.to_string())
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      if name == "f32" || name == "i32" || name == "u32" || name == "bool" || name == "f16" {
        self.sb.write_string(msl_scalar(name))
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      match wgsl_resolve_vec_alias(name) {
        Some(vt) => {
          msl_emit_type(self.sb, vt)
          self.sb.write_string("(")
          self.emit_arg_list(args)
          self.sb.write_string(")")
          return
        }
        None => ()
      }
      match self.struct_map.get(name) {
        Some(_) => {
          self.sb.write_string(msl_ident(name))
          self.sb.write_string("{")
          self.emit_arg_list(args)
          self.sb.write_string("}")
          return
        }
        None => ()
      }
      // User-defined helper function (append threaded globals & sizes buffer if needed)
      match self.func_map.get(name) {
        Some(_) => {
          self.sb.write_string(msl_ident(name))
          self.sb.write_string("(")
          self.emit_arg_list(args)
          let mut has_args = args.length() > 0
          match self.helper_globals.get(name) {
            Some(glist) => {
              let mut gi = 0
              while gi < glist.length() {
                if has_args {
                  self.sb.write_string(", ")
                }
                self.sb.write_string(msl_ident(glist[gi]))
                has_args = true
                gi = gi + 1
              }
            }
            None => ()
          }
          match self.helper_needs_sizes.get(name) {
            Some(true) => {
              if has_args {
                self.sb.write_string(", ")
              }
              self.sb.write_string("_wgsl_buffer_sizes")
            }
            _ => ()
          }
          self.sb.write_string(")")
          return
        }
        None => ()
      }
      let fn_name = msl_remap_builtin(name)
      self.sb.write_string(fn_name)
      self.sb.write_string("(")
      self.emit_arg_list(args)
      self.sb.write_string(")")
    }
  }
}

fn msl_remap_builtin(name : String) -> String {
  if name == "inverseSqrt" {
    "rsqrt"
  } else if name == "round" {
    "rint"
  } else if name == "faceForward" {
    "faceforward"
  } else if name == "extractBits" {
    "extract_bits"
  } else if name == "insertBits" {
    "insert_bits"
  } else if name == "dpdx" || name == "dpdxCoarse" || name == "dpdxFine" {
    "dfdx"
  } else if name == "dpdy" || name == "dpdyCoarse" || name == "dpdyFine" {
    "dfdy"
  } else if name == "fwidthCoarse" || name == "fwidthFine" {
    "fwidth"
  } else if name == "countLeadingZeros" {
    "clz"
  } else if name == "countTrailingZeros" {
    "ctz"
  } else if name == "countOneBits" {
    "popcount"
  } else if name == "reverseBits" {
    "reverse_bits"
  } else if name == "pack4x8unorm" {
    "pack_float_to_unorm4x8"
  } else if name == "unpack4x8unorm" {
    "unpack_unorm4x8_to_float"
  } else if name == "pack4x8snorm" {
    "pack_float_to_snorm4x8"
  } else if name == "unpack4x8snorm" {
    "unpack_snorm4x8_to_float"
  } else if name == "pack2x16unorm" {
    "pack_float_to_unorm2x16"
  } else if name == "unpack2x16unorm" {
    "unpack_unorm2x16_to_float"
  } else if name == "pack2x16snorm" {
    "pack_float_to_snorm2x16"
  } else if name == "unpack2x16snorm" {
    "unpack_snorm2x16_to_float"
  } else {
    name
  }
}

fn MslCtx::emit_simple_stmt_inline(self : MslCtx, s : WgslStmt) -> Unit {
  match s {
    WgslStmt::VarDecl(name, kind_s, ty, init, _, _) => {
      let var_sem = match ty {
        Some(t) => wgsl_type_to_sem(t, self.alias_map, self.const_ints)
        None =>
        match init {
          Some(ex) => sem_concretize(self.infer_expr_type(ex))
          None => SemType::Scalar("f32")
        }
      }
      self.define_type(name, var_sem)
      if kind_s == "let" || kind_s == "const" {
        self.sb.write_string("const ")
      }
      match ty {
        Some(t) => msl_emit_type(self.sb, t)
        None => self.sb.write_string("auto")
      }
      self.sb.write_string(" ")
      self.sb.write_string(msl_ident(name))
      match init {
        Some(ex) => {
          self.sb.write_string(" = ")
          self.emit_expr(ex)
        }
        None => self.sb.write_string(" = {}")
      }
    }
    WgslStmt::Assign(lhs, op, rhs, _, _) => {
      self.emit_expr(lhs)
      self.sb.write_string(" ")
      self.sb.write_string(op)
      self.sb.write_string(" ")
      self.emit_expr(rhs)
    }
    WgslStmt::PhonyAssign(rhs, _, _) => {
      self.sb.write_string("(void)(")
      self.emit_expr(rhs)
      self.sb.write_string(")")
    }
    WgslStmt::IncDec(lhs, is_inc, _, _) => {
      self.emit_expr(lhs)
      self.sb.write_string(if is_inc { "++" } else { "--" })
    }
    WgslStmt::ExprStmt(ex, _, _) => self.emit_expr(ex)
    _ => ()
  }
}

fn MslCtx::emit_stmts(self : MslCtx, stmts : Array[WgslStmt]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    self.emit_stmt(stmts[i])
    i = i + 1
  }
}

fn MslCtx::emit_stmt(self : MslCtx, stmt : WgslStmt) -> Unit {
  match stmt {
    WgslStmt::VarDecl(_, _, _, _, _, _)
    | WgslStmt::Assign(_, _, _, _, _)
    | WgslStmt::PhonyAssign(_, _, _)
    | WgslStmt::IncDec(_, _, _, _)
    | WgslStmt::ExprStmt(_, _, _) => {
      self.emit_indent()
      self.emit_simple_stmt_inline(stmt)
      self.sb.write_string(";\n")
    }
    WgslStmt::Return(opt_ex, _, _) => {
      self.emit_indent()
      match opt_ex {
        Some(ex) =>
        if self.wrap_ret_struct.length() > 0 {
          self.sb.write_string("return ")
          self.sb.write_string(self.wrap_ret_struct)
          self.sb.write_string("{")
          self.emit_expr(ex)
          self.sb.write_string("};\n")
        } else {
          self.sb.write_string("return ")
          self.emit_expr(ex)
          self.sb.write_string(";\n")
        }
        None => self.sb.write_string("return;\n")
      }
    }
    WgslStmt::If(cond, then_b, else_b, _, _) => {
      self.emit_indent()
      self.sb.write_string("if (")
      self.emit_expr(cond)
      self.sb.write_string(") {\n")
      self.push_scope()
      self.indent = self.indent + 1
      self.emit_stmts(then_b)
      self.indent = self.indent - 1
      self.pop_scope()
      if else_b.length() > 0 {
        self.emit_indent()
        self.sb.write_string("} else {\n")
        self.push_scope()
        self.indent = self.indent + 1
        self.emit_stmts(else_b)
        self.indent = self.indent - 1
        self.pop_scope()
      }
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::Switch(sel, cases, _, _) => {
      self.emit_indent()
      self.sb.write_string("switch (")
      self.emit_expr(sel)
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      let mut ci = 0
      while ci < cases.length() {
        let c = cases[ci]
        let mut si = 0
        while si < c.selectors.length() {
          self.emit_indent()
          self.sb.write_string("case ")
          self.emit_expr(c.selectors[si])
          self.sb.write_string(":\n")
          si = si + 1
        }
        if c.is_default {
          self.emit_indent()
          self.sb.write_string("default:\n")
        }
        self.emit_indent()
        self.sb.write_string("{\n")
        self.push_scope()
        self.indent = self.indent + 1
        self.emit_stmts(c.body)
        self.emit_indent()
        self.sb.write_string("break;\n")
        self.indent = self.indent - 1
        self.pop_scope()
        self.emit_indent()
        self.sb.write_string("}\n")
        ci = ci + 1
      }
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::For(init, cond, update, body, _, _) => {
      self.push_scope()
      self.emit_indent()
      self.sb.write_string("for (")
      match init {
        Some(st) => self.emit_simple_stmt_inline(st)
        None => ()
      }
      self.sb.write_string("; ")
      match cond {
        Some(ex) => self.emit_expr(ex)
        None => ()
      }
      self.sb.write_string("; ")
      match update {
        Some(st) => self.emit_simple_stmt_inline(st)
        None => ()
      }
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
      self.pop_scope()
    }
    WgslStmt::While(cond, body, _, _) => {
      self.emit_indent()
      self.sb.write_string("while (")
      self.emit_expr(cond)
      self.sb.write_string(") {\n")
      self.push_scope()
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.pop_scope()
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::Loop(body, cont, break_if, _, _) => {
      let has_cont = cont.length() > 0 || (match break_if { Some(_) => true; None => false })
      if !has_cont {
        self.emit_indent()
        self.sb.write_string("while (true) {\n")
        self.push_scope()
        self.indent = self.indent + 1
        self.emit_stmts(body)
        self.indent = self.indent - 1
        self.pop_scope()
        self.emit_indent()
        self.sb.write_string("}\n")
      } else {
        let lid = "_wgsl_li_" + self.loop_counter.to_string()
        self.loop_counter = self.loop_counter + 1
        self.emit_indent()
        self.sb.write_string("bool ")
        self.sb.write_string(lid)
        self.sb.write_string(" = true;\n")
        self.emit_indent()
        self.sb.write_string("while (true) {\n")
        self.push_scope()
        self.indent = self.indent + 1
        self.emit_indent()
        self.sb.write_string("if (!")
        self.sb.write_string(lid)
        self.sb.write_string(") {\n")
        self.indent = self.indent + 1
        self.emit_stmts(cont)
        match break_if {
          Some(cond) => {
            self.emit_indent()
            self.sb.write_string("if (")
            self.emit_expr(cond)
            self.sb.write_string(") { break; }\n")
          }
          None => ()
        }
        self.indent = self.indent - 1
        self.emit_indent()
        self.sb.write_string("}\n")
        self.emit_indent()
        self.sb.write_string(lid)
        self.sb.write_string(" = false;\n")
        self.emit_stmts(body)
        self.indent = self.indent - 1
        self.pop_scope()
        self.emit_indent()
        self.sb.write_string("}\n")
      }
    }
    WgslStmt::Break(_, _) => {
      self.emit_indent()
      self.sb.write_string("break;\n")
    }
    WgslStmt::Continue(_, _) => {
      self.emit_indent()
      self.sb.write_string("continue;\n")
    }
    WgslStmt::Discard(_, _) => {
      self.emit_indent()
      self.sb.write_string("discard_fragment();\n")
    }
    WgslStmt::Block(body, _, _) => {
      self.emit_indent()
      self.sb.write_string("{\n")
      self.push_scope()
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.pop_scope()
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::ConstAssert(_, _, _) => ()
  }
}

fn msl_emit_struct(
  ctx : MslCtx,
  s : WgslStructDecl,
  is_vs_in : Bool,
  is_fs_out : Bool,
  is_host_shareable : Bool,
) -> Unit {
  ctx.sb.write_string("struct ")
  ctx.sb.write_string(msl_ident(s.name))
  ctx.sb.write_string(" {\n")
  let mut cur_off = 0
  let mut max_align = 1
  let mut has_runtime_arr = false
  let mut i = 0
  while i < s.fields.length() {
    let f = s.fields[i]
    let resolved_fty = wgsl_resolve_alias_depth(f.ty, ctx.alias_map, 0)
    let mut attr_s = ""
    match wgsl_find_attr(f.attrs, "builtin") {
      Some(ba) =>
      if ba.args.length() == 1 {
        attr_s = " " + msl_builtin_attr(ba.args[0])
      }
      None => ()
    }
    match wgsl_find_attr(f.attrs, "location") {
      Some(la) =>
      if la.args.length() == 1 {
        let loc = la.args[0]
        if is_vs_in {
          attr_s = " [[attribute(" + loc + ")]]"
        } else if is_fs_out {
          attr_s = " [[color(" + loc + ")]]"
        } else {
          attr_s = " [[user(loc" + loc + ")]]" + msl_interpolate_attr(f.attrs)
        }
      }
      None => ()
    }
    if is_host_shareable && attr_s.length() == 0 {
      let (fs, fa) = wgsl_layout_size_align(f.ty, ctx.struct_map, ctx.alias_map, ctx.const_ints, 0)
      let mut eff_a = fa
      match wgsl_find_attr(f.attrs, "align") {
        Some(aa) =>
        if aa.args.length() == 1 {
          match wgsl_parse_int_str(aa.args[0]) {
            Some(v) => if v > eff_a { eff_a = v }
            None => ()
          }
        }
        None => ()
      }
      let mut eff_s = fs
      match wgsl_find_attr(f.attrs, "size") {
        Some(sa) =>
        if sa.args.length() == 1 {
          match wgsl_parse_int_str(sa.args[0]) {
            Some(v) => if v > eff_s { eff_s = v }
            None => ()
          }
        }
        None => ()
      }
      let off = wgsl_round_up(eff_a, cur_off)
      if off > cur_off {
        ctx.sb.write_string("  char _pad_")
        ctx.sb.write_string(i.to_string())
        ctx.sb.write_string("_pre[")
        ctx.sb.write_string((off - cur_off).to_string())
        ctx.sb.write_string("];\n")
      }
      ctx.sb.write_string("  ")
      match resolved_fty {
        WgslType::Vec(3, e) => {
          ctx.sb.write_string("packed_")
          ctx.sb.write_string(msl_scalar(e))
          ctx.sb.write_string("3 ")
          ctx.sb.write_string(msl_ident(f.name))
          ctx.sb.write_string(";\n")
        }
        WgslType::Array(elem, len, len_ident) =>
        if len == 0 && len_ident.length() == 0 {
          has_runtime_arr = true
          msl_emit_type(ctx.sb, elem)
          ctx.sb.write_string(" ")
          ctx.sb.write_string(msl_ident(f.name))
          ctx.sb.write_string("[1];\n")
        } else {
          msl_emit_type(ctx.sb, f.ty)
          ctx.sb.write_string(" ")
          ctx.sb.write_string(msl_ident(f.name))
          ctx.sb.write_string(";\n")
        }
        _ => {
          msl_emit_type(ctx.sb, f.ty)
          ctx.sb.write_string(" ")
          ctx.sb.write_string(msl_ident(f.name))
          ctx.sb.write_string(";\n")
        }
      }
      if !has_runtime_arr && eff_s > fs {
        ctx.sb.write_string("  char _pad_")
        ctx.sb.write_string(i.to_string())
        ctx.sb.write_string("_post[")
        ctx.sb.write_string((eff_s - fs).to_string())
        ctx.sb.write_string("];\n")
      }
      cur_off = off + eff_s
      if eff_a > max_align {
        max_align = eff_a
      }
    } else {
      ctx.sb.write_string("  ")
      match wgsl_find_attr(f.attrs, "align") {
        Some(aa) =>
        if aa.args.length() == 1 {
          ctx.sb.write_string("alignas(")
          ctx.sb.write_string(aa.args[0])
          ctx.sb.write_string(") ")
        }
        None => ()
      }
      match resolved_fty {
        WgslType::Array(elem, len, len_ident) =>
        if len == 0 && len_ident.length() == 0 {
          msl_emit_type(ctx.sb, elem)
          ctx.sb.write_string(" ")
          ctx.sb.write_string(msl_ident(f.name))
          ctx.sb.write_string("[1]")
          ctx.sb.write_string(attr_s)
          ctx.sb.write_string(";\n")
        } else {
          msl_emit_type(ctx.sb, f.ty)
          ctx.sb.write_string(" ")
          ctx.sb.write_string(msl_ident(f.name))
          ctx.sb.write_string(attr_s)
          ctx.sb.write_string(";\n")
        }
        _ => {
          msl_emit_type(ctx.sb, f.ty)
          ctx.sb.write_string(" ")
          ctx.sb.write_string(msl_ident(f.name))
          ctx.sb.write_string(attr_s)
          ctx.sb.write_string(";\n")
        }
      }
    }
    i = i + 1
  }
  if is_host_shareable && !has_runtime_arr {
    let total_size = wgsl_round_up(max_align, cur_off)
    if total_size > cur_off {
      ctx.sb.write_string("  char _pad_tail[")
      ctx.sb.write_string((total_size - cur_off).to_string())
      ctx.sb.write_string("];\n")
    }
  }
  ctx.sb.write_string("};\n\n")
}

fn msl_emit_binding_param(sb : StringBuilder, g : WgslGlobalVar, slot : Int, include_attr : Bool) -> Unit {
  let ty = match g.ty {
    Some(t) => t
    None => WgslType::Scalar("f32")
  }
  match ty {
    WgslType::Texture(_, _, _) => {
      msl_emit_type(sb, ty)
      sb.write_string(" ")
      sb.write_string(msl_ident(g.name))
      if include_attr {
        sb.write_string(" [[texture(")
        sb.write_string(slot.to_string())
        sb.write_string(")]]")
      }
    }
    WgslType::Sampler(_) => {
      sb.write_string("sampler ")
      sb.write_string(msl_ident(g.name))
      if include_attr {
        sb.write_string(" [[sampler(")
        sb.write_string(slot.to_string())
        sb.write_string(")]]")
      }
    }
    WgslType::Array(elem, len, len_ident) =>
    if len == 0 && len_ident.length() == 0 {
      if g.addr_space == "uniform" {
        sb.write_string("constant ")
      } else if g.access == "read_write" {
        sb.write_string("device ")
      } else {
        sb.write_string("device const ")
      }
      msl_emit_type(sb, elem)
      sb.write_string("* ")
      sb.write_string(msl_ident(g.name))
      if include_attr {
        sb.write_string(" [[buffer(")
        sb.write_string(slot.to_string())
        sb.write_string(")]]")
      }
    } else {
      if g.addr_space == "uniform" {
        sb.write_string("constant ")
      } else if g.access == "read_write" {
        sb.write_string("device ")
      } else {
        sb.write_string("device const ")
      }
      msl_emit_type(sb, ty)
      sb.write_string("& ")
      sb.write_string(msl_ident(g.name))
      if include_attr {
        sb.write_string(" [[buffer(")
        sb.write_string(slot.to_string())
        sb.write_string(")]]")
      }
    }
    _ => {
      if g.addr_space == "uniform" {
        sb.write_string("constant ")
      } else if g.access == "read_write" {
        sb.write_string("device ")
      } else {
        sb.write_string("device const ")
      }
      msl_emit_type(sb, ty)
      sb.write_string("& ")
      sb.write_string(msl_ident(g.name))
      if include_attr {
        sb.write_string(" [[buffer(")
        sb.write_string(slot.to_string())
        sb.write_string(")]]")
      }
    }
  }
}

fn msl_emit_helper_global_param(sb : StringBuilder, g : WgslGlobalVar) -> Unit {
  if g.addr_space == "private" {
    sb.write_string("thread ")
    match g.ty {
      Some(t) => msl_emit_type(sb, t)
      None => sb.write_string("float")
    }
    sb.write_string("& ")
    sb.write_string(msl_ident(g.name))
  } else if g.addr_space == "workgroup" {
    sb.write_string("threadgroup ")
    match g.ty {
      Some(t) => msl_emit_type(sb, t)
      None => sb.write_string("float")
    }
    sb.write_string("& ")
    sb.write_string(msl_ident(g.name))
  } else {
    msl_emit_binding_param(sb, g, 0, false)
  }
}

fn msl_emit_helper_sig(
  ctx : MslCtx,
  f : WgslFuncDecl,
  global_map : Map[String, WgslGlobalVar],
) -> Unit {
  match f.ret_ty {
    Some(rt) => msl_emit_type(ctx.sb, rt)
    None => ctx.sb.write_string("void")
  }
  ctx.sb.write_string(" ")
  ctx.sb.write_string(msl_ident(f.name))
  ctx.sb.write_string("(")
  let mut pc = 0
  let mut pi = 0
  while pi < f.params.length() {
    if pc > 0 {
      ctx.sb.write_string(", ")
    }
    msl_emit_type(ctx.sb, f.params[pi].ty)
    ctx.sb.write_string(" ")
    ctx.sb.write_string(msl_ident(f.params[pi].name))
    pc = pc + 1
    pi = pi + 1
  }
  match ctx.helper_globals.get(f.name) {
    Some(glist) => {
      let mut gi = 0
      while gi < glist.length() {
        match global_map.get(glist[gi]) {
          Some(g) => {
            if pc > 0 {
              ctx.sb.write_string(", ")
            }
            msl_emit_helper_global_param(ctx.sb, g)
            pc = pc + 1
          }
          None => ()
        }
        gi = gi + 1
      }
    }
    None => ()
  }
  match ctx.helper_needs_sizes.get(f.name) {
    Some(true) => {
      if pc > 0 {
        ctx.sb.write_string(", ")
      }
      ctx.sb.write_string("constant uint* _wgsl_buffer_sizes")
    }
    _ => ()
  }
  ctx.sb.write_string(")")
}

fn msl_emit_func(
  ctx : MslCtx,
  f : WgslFuncDecl,
  bindings : Array[BindingInfo],
  globals : Array[WgslGlobalVar],
  global_map : Map[String, WgslGlobalVar],
) -> Unit {
  let is_vs = wgsl_has_attr(f.attrs, "vertex")
  let is_fs = wgsl_has_attr(f.attrs, "fragment")
  let is_cs = wgsl_has_attr(f.attrs, "compute")
  let is_entry = is_vs || is_fs || is_cs

  if !is_entry {
    msl_emit_helper_sig(ctx, f, global_map)
    ctx.sb.write_string(" {\n")
    ctx.push_scope()
    let mut pi = 0
    while pi < f.params.length() {
      ctx.define_type(f.params[pi].name, wgsl_type_to_sem(f.params[pi].ty, ctx.alias_map, ctx.const_ints))
      pi = pi + 1
    }
    ctx.indent = 1
    ctx.wrap_ret_struct = ""
    ctx.emit_stmts(f.body)
    ctx.indent = 0
    ctx.pop_scope()
    ctx.sb.write_string("}\n\n")
    return
  }

  let loc_params : Array[WgslParam] = []
  if is_vs || is_fs {
    let mut pi = 0
    while pi < f.params.length() {
      if wgsl_has_attr(f.params[pi].attrs, "location") {
        loc_params.push(f.params[pi])
      }
      pi = pi + 1
    }
  }
  let stage_in_struct = if loc_params.length() > 0 {
    "_wgsl_in_" + msl_entry_name(f.name)
  } else {
    ""
  }
  if stage_in_struct.length() > 0 {
    ctx.sb.write_string("struct ")
    ctx.sb.write_string(stage_in_struct)
    ctx.sb.write_string(" {\n")
    let mut li = 0
    while li < loc_params.length() {
      let p = loc_params[li]
      let loc = match wgsl_find_attr(p.attrs, "location") {
        Some(a) => if a.args.length() > 0 { a.args[0] } else { "0" }
        None => "0"
      }
      ctx.sb.write_string("  ")
      msl_emit_type(ctx.sb, p.ty)
      ctx.sb.write_string(" ")
      ctx.sb.write_string(msl_ident(p.name))
      if is_vs {
        ctx.sb.write_string(" [[attribute(")
        ctx.sb.write_string(loc)
        ctx.sb.write_string(")]]")
      } else {
        ctx.sb.write_string(" [[user(loc")
        ctx.sb.write_string(loc)
        ctx.sb.write_string(")]]")
        ctx.sb.write_string(msl_interpolate_attr(p.attrs))
      }
      ctx.sb.write_string(";\n")
      li = li + 1
    }
    ctx.sb.write_string("};\n\n")
  }

  let mut wrap_ret = ""
  let ret_sb = StringBuilder::new()
  match f.ret_ty {
    Some(rt) =>
    if is_vs && wgsl_has_attr(f.ret_attrs, "builtin") {
      wrap_ret = "_wgsl_vs_out_" + msl_entry_name(f.name)
      ctx.sb.write_string("struct ")
      ctx.sb.write_string(wrap_ret)
      ctx.sb.write_string(" {\n  ")
      msl_emit_type(ctx.sb, rt)
      ctx.sb.write_string(" _pos [[position]];\n};\n\n")
      ret_sb.write_string(wrap_ret)
    } else if is_fs && wgsl_has_attr(f.ret_attrs, "builtin") {
      let battr = match wgsl_find_attr(f.ret_attrs, "builtin") {
        Some(ba) => if ba.args.length() == 1 { msl_builtin_attr(ba.args[0]) } else { "" }
        None => ""
      }
      wrap_ret = "_wgsl_fs_out_" + msl_entry_name(f.name)
      ctx.sb.write_string("struct ")
      ctx.sb.write_string(wrap_ret)
      ctx.sb.write_string(" {\n  ")
      msl_emit_type(ctx.sb, rt)
      ctx.sb.write_string(" _out ")
      ctx.sb.write_string(battr)
      ctx.sb.write_string(";\n};\n\n")
      ret_sb.write_string(wrap_ret)
    } else if is_fs && wgsl_has_attr(f.ret_attrs, "location") {
      let loc = match wgsl_find_attr(f.ret_attrs, "location") {
        Some(la) => if la.args.length() > 0 { la.args[0] } else { "0" }
        None => "0"
      }
      wrap_ret = "_wgsl_fs_out_" + msl_entry_name(f.name)
      ctx.sb.write_string("struct ")
      ctx.sb.write_string(wrap_ret)
      ctx.sb.write_string(" {\n  ")
      msl_emit_type(ctx.sb, rt)
      ctx.sb.write_string(" _out [[color(")
      ctx.sb.write_string(loc)
      ctx.sb.write_string(")]];\n};\n\n")
      ret_sb.write_string(wrap_ret)
    } else {
      msl_emit_type(ret_sb, rt)
    }
    None => ret_sb.write_string("void")
  }

  let qual = if is_vs { "vertex " } else if is_fs { "fragment " } else { "kernel " }
  let emitted_name = msl_entry_name(f.name)
  ctx.sb.write_string(qual)
  ctx.sb.write_string(ret_sb.to_string())
  ctx.sb.write_string(" ")
  ctx.sb.write_string(emitted_name)
  ctx.sb.write_string("(")

  let mut param_count = 0
  if stage_in_struct.length() > 0 {
    ctx.sb.write_string(stage_in_struct)
    ctx.sb.write_string(" _wgsl_stage_in [[stage_in]]")
    param_count = param_count + 1
  }

  let mut has_lidx_param = ""
  let mut pi = 0
  while pi < f.params.length() {
    let p = f.params[pi]
    if wgsl_has_attr(p.attrs, "location") {
      pi = pi + 1
      continue
    }
    if param_count > 0 {
      ctx.sb.write_string(", ")
    }
    msl_emit_type(ctx.sb, p.ty)
    ctx.sb.write_string(" ")
    ctx.sb.write_string(msl_ident(p.name))
    match wgsl_find_attr(p.attrs, "builtin") {
      Some(ba) =>
      if ba.args.length() == 1 {
        if ba.args[0] == "local_invocation_index" {
          has_lidx_param = msl_ident(p.name)
        }
        ctx.sb.write_string(" ")
        ctx.sb.write_string(msl_builtin_attr(ba.args[0]))
      }
      None =>
      match p.ty {
        WgslType::Named(sn) =>
        match ctx.struct_map.get(sn) {
          Some(_) => ctx.sb.write_string(" [[stage_in]]")
          None => ()
        }
        _ => ()
      }
    }
    param_count = param_count + 1
    pi = pi + 1
  }

  // Check if compute shader has workgroup vars needing zero-init
  let mut has_wg_vars = false
  if is_cs {
    let mut gi = 0
    while gi < globals.length() {
      if globals[gi].decl_kind == "var" && globals[gi].addr_space == "workgroup" {
        has_wg_vars = true
        break
      }
      gi = gi + 1
    }
  }
  if is_cs && has_wg_vars && has_lidx_param.length() == 0 {
    if param_count > 0 {
      ctx.sb.write_string(", ")
    }
    ctx.sb.write_string("uint _wgsl_lidx [[thread_index_in_threadgroup]]")
    has_lidx_param = "_wgsl_lidx"
    param_count = param_count + 1
  }

  let mut bi = 0
  while bi < bindings.length() {
    let b = bindings[bi]
    match global_map.get(b.name) {
      Some(g) => {
        if param_count > 0 {
          ctx.sb.write_string(", ")
        }
        msl_emit_binding_param(ctx.sb, g, b.msl_slot, true)
        param_count = param_count + 1
      }
      None => ()
    }
    bi = bi + 1
  }

  let needs_sizes = match ctx.helper_needs_sizes.get(f.name) {
    Some(true) => true
    _ => false
  }
  if needs_sizes {
    if param_count > 0 {
      ctx.sb.write_string(", ")
    }
    ctx.sb.write_string("constant uint* _wgsl_buffer_sizes [[buffer(30)]]")
    param_count = param_count + 1
  }

  ctx.sb.write_string(") {\n")
  ctx.push_scope()
  pi = 0
  while pi < f.params.length() {
    ctx.define_type(f.params[pi].name, wgsl_type_to_sem(f.params[pi].ty, ctx.alias_map, ctx.const_ints))
    pi = pi + 1
  }
  ctx.indent = 1
  ctx.wrap_ret_struct = wrap_ret

  if stage_in_struct.length() > 0 {
    let mut li = 0
    while li < loc_params.length() {
      let p = loc_params[li]
      ctx.emit_indent()
      msl_emit_type(ctx.sb, p.ty)
      ctx.sb.write_string(" ")
      ctx.sb.write_string(msl_ident(p.name))
      ctx.sb.write_string(" = _wgsl_stage_in.")
      ctx.sb.write_string(msl_ident(p.name))
      ctx.sb.write_string(";\n")
      li = li + 1
    }
  }

  let mut gi = 0
  while gi < globals.length() {
    let g = globals[gi]
    if g.decl_kind == "var" && g.addr_space == "private" {
      ctx.emit_indent()
      ctx.sb.write_string("thread ")
      match g.ty {
        Some(t) => msl_emit_type(ctx.sb, t)
        None => ctx.sb.write_string("auto")
      }
      ctx.sb.write_string(" ")
      ctx.sb.write_string(msl_ident(g.name))
      match g.init {
        Some(ex) => {
          ctx.sb.write_string(" = ")
          ctx.emit_expr(ex)
          ctx.sb.write_string(";\n")
        }
        None => ctx.sb.write_string(" = {};\n")
      }
    } else if is_cs && g.decl_kind == "var" && g.addr_space == "workgroup" {
      ctx.emit_indent()
      ctx.sb.write_string("threadgroup ")
      match g.ty {
        Some(t) => msl_emit_type(ctx.sb, t)
        None => ctx.sb.write_string("float")
      }
      ctx.sb.write_string(" ")
      ctx.sb.write_string(msl_ident(g.name))
      ctx.sb.write_string(";\n")
    }
    gi = gi + 1
  }

  // Zero-initialize workgroup memory per WGSL spec
  if is_cs && has_wg_vars {
    ctx.emit_indent()
    ctx.sb.write_string("if (")
    ctx.sb.write_string(has_lidx_param)
    ctx.sb.write_string(" == 0u) {\n")
    ctx.indent = ctx.indent + 1
    gi = 0
    while gi < globals.length() {
      let g = globals[gi]
      if g.decl_kind == "var" && g.addr_space == "workgroup" {
        ctx.emit_indent()
        match g.ty {
          Some(WgslType::Atomic(_)) => {
            ctx.sb.write_string("atomic_store_explicit(&")
            ctx.sb.write_string(msl_ident(g.name))
            ctx.sb.write_string(", 0, memory_order_relaxed);\n")
          }
          Some(WgslType::Array(_, len, len_ident)) => {
            let n_str = if len > 0 { len.to_string() } else if len_ident.length() > 0 { msl_ident(len_ident) } else { "0" }
            ctx.sb.write_string("for (uint _zi = 0u; _zi < ")
            ctx.sb.write_string(n_str)
            ctx.sb.write_string("u; _zi++) { ")
            ctx.sb.write_string(msl_ident(g.name))
            ctx.sb.write_string("[_zi] = {}; }\n")
          }
          _ => {
            ctx.sb.write_string(msl_ident(g.name))
            ctx.sb.write_string(" = {};\n")
          }
        }
      }
      gi = gi + 1
    }
    ctx.indent = ctx.indent - 1
    ctx.emit_indent()
    ctx.sb.write_string("}\n")
    ctx.emit_indent()
    ctx.sb.write_string("threadgroup_barrier(mem_flags::mem_threadgroup);\n")
  }

  ctx.emit_stmts(f.body)
  ctx.wrap_ret_struct = ""
  ctx.indent = 0
  ctx.pop_scope()
  ctx.sb.write_string("}\n\n")
}

fn msl_mark_host_shareable(
  ty : WgslType,
  struct_map : Map[String, WgslStructDecl],
  alias_map : Map[String, WgslType],
  host_structs : Map[String, Bool],
) -> Unit {
  let resolved = wgsl_resolve_alias_depth(ty, alias_map, 0)
  match resolved {
    WgslType::Named(sn) => {
      match host_structs.get(sn) {
        Some(true) => return
        _ => host_structs.set(sn, true)
      }
      match struct_map.get(sn) {
        Some(st) => {
          let mut fi = 0
          while fi < st.fields.length() {
            msl_mark_host_shareable(st.fields[fi].ty, struct_map, alias_map, host_structs)
            fi = fi + 1
          }
        }
        None => ()
      }
    }
    WgslType::Array(elem, _, _) => msl_mark_host_shareable(elem, struct_map, alias_map, host_structs)
    _ => ()
  }
}

fn msl_emit_type_decl_topo(
  name : String,
  ctx : MslCtx,
  vs_in_structs : Map[String, Bool],
  fs_out_structs : Map[String, Bool],
  host_structs : Map[String, Bool],
  emitted : Map[String, Bool],
) -> Unit {
  match emitted.get(name) {
    Some(true) => return
    _ => emitted.set(name, true)
  }
  match ctx.alias_map.get(name) {
    Some(target_ty) => {
      let deps : Array[String] = []
      wgsl_collect_type_deps(target_ty, deps)
      let mut i = 0
      while i < deps.length() {
        msl_emit_type_decl_topo(deps[i], ctx, vs_in_structs, fs_out_structs, host_structs, emitted)
        i = i + 1
      }
      ctx.sb.write_string("using ")
      ctx.sb.write_string(msl_ident(name))
      ctx.sb.write_string(" = ")
      msl_emit_type(ctx.sb, target_ty)
      ctx.sb.write_string(";\n\n")
      return
    }
    None => ()
  }
  match ctx.struct_map.get(name) {
    Some(s) => {
      let mut fi = 0
      while fi < s.fields.length() {
        let deps : Array[String] = []
        wgsl_collect_type_deps(s.fields[fi].ty, deps)
        let mut di = 0
        while di < deps.length() {
          msl_emit_type_decl_topo(deps[di], ctx, vs_in_structs, fs_out_structs, host_structs, emitted)
          di = di + 1
        }
        fi = fi + 1
      }
      let is_vi = match vs_in_structs.get(s.name) { Some(b) => b; None => false }
      let is_fo = match fs_out_structs.get(s.name) { Some(b) => b; None => false }
      let is_hs = match host_structs.get(s.name) { Some(b) => b; None => false }
      msl_emit_struct(ctx, s, is_vi, is_fo, is_hs)
    }
    None => ()
  }
}

fn wgsl_emit_msl(
  module_ast : WgslModule,
  reflection : ModuleReflection,
) -> Result[CompiledModule, WgslError] {
  let struct_map : Map[String, WgslStructDecl] = Map::new()
  let alias_map : Map[String, WgslType] = Map::new()
  let func_map : Map[String, WgslFuncDecl] = Map::new()
  let global_map : Map[String, WgslGlobalVar] = Map::new()
  let binding_slots : Map[String, Int] = Map::new()
  let const_vals : Map[String, ConstVal] = Map::new()
  let const_ints : Map[String, Int64] = Map::new()

  let mut i = 0
  while i < module_ast.structs.length() {
    struct_map.set(module_ast.structs[i].name, module_ast.structs[i])
    i = i + 1
  }
  i = 0
  while i < module_ast.aliases.length() {
    alias_map.set(module_ast.aliases[i].name, module_ast.aliases[i].ty)
    i = i + 1
  }
  i = 0
  while i < module_ast.funcs.length() {
    func_map.set(module_ast.funcs[i].name, module_ast.funcs[i])
    i = i + 1
  }
  i = 0
  while i < module_ast.globals.length() {
    global_map.set(module_ast.globals[i].name, module_ast.globals[i])
    i = i + 1
  }
  i = 0
  while i < reflection.bindings.length() {
    binding_slots.set(reflection.bindings[i].name, reflection.bindings[i].msl_slot)
    i = i + 1
  }
  // Evaluate integer consts
  let mut pass = 0
  while pass < 4 {
    i = 0
    while i < module_ast.globals.length() {
      let g = module_ast.globals[i]
      if g.decl_kind == "const" {
        match g.init {
          Some(ex) =>
          match wgsl_eval_const(ex, const_vals) {
            Some(cv) => {
              const_vals.set(g.name, cv)
              match cv { ConstVal::CInt(v) => const_ints.set(g.name, v); _ => () }
            }
            None => ()
          }
          None => ()
        }
      }
      i = i + 1
    }
    pass = pass + 1
  }

  // Compute global scope types & host-shareable structs
  let global_types : Map[String, SemType] = Map::new()
  let host_structs : Map[String, Bool] = Map::new()
  let threadable_globals : Array[String] = []
  let threadable_set : Map[String, Bool] = Map::new()
  i = 0
  while i < module_ast.globals.length() {
    let g = module_ast.globals[i]
    if g.decl_kind == "var" {
      threadable_globals.push(g.name)
      threadable_set.set(g.name, true)
    }
    match g.ty {
      Some(t) => {
        global_types.set(g.name, wgsl_type_to_sem(t, alias_map, const_ints))
        if g.addr_space == "uniform" || g.addr_space == "storage" {
          msl_mark_host_shareable(t, struct_map, alias_map, host_structs)
        }
      }
      None => global_types.set(g.name, SemType::Scalar("f32"))
    }
    i = i + 1
  }

  // Analyze direct + transitive global & arrayLength usage per function (O(V + E))
  let fn_direct_refs : Map[String, Map[String, Bool]] = Map::new()
  let fn_direct_call_lists : Map[String, Array[String]] = Map::new()
  let fn_needs_sizes : Map[String, Bool] = Map::new()
  let mut uses_modf = false
  let mut uses_frexp = false
  let mut uses_cas = false
  let mut uses_flb = false
  let mut uses_ftb = false

  i = 0
  while i < module_ast.funcs.length() {
    let f = module_ast.funcs[i]
    let refs : Map[String, Bool] = Map::new()
    let calls : Map[String, Bool] = Map::new()
    let call_list : Array[String] = []
    let arr_len_flag : Array[Bool] = [false]
    msl_collect_stmts_refs(f.body, refs, calls, call_list, arr_len_flag)
    fn_direct_refs.set(f.name, refs)
    fn_direct_call_lists.set(f.name, call_list)
    fn_needs_sizes.set(f.name, arr_len_flag[0])
    match calls.get("modf") { Some(true) => uses_modf = true; _ => () }
    match calls.get("frexp") { Some(true) => uses_frexp = true; _ => () }
    match calls.get("atomicCompareExchangeWeak") { Some(true) => uses_cas = true; _ => () }
    match calls.get("firstLeadingBit") { Some(true) => uses_flb = true; _ => () }
    match calls.get("firstTrailingBit") { Some(true) => uses_ftb = true; _ => () }
    i = i + 1
  }

  // Fixed-point propagation of used threadable globals & arrayLength across call graph (O(V + E))
  let fn_used_globals : Map[String, Map[String, Bool]] = Map::new()
  i = 0
  while i < module_ast.funcs.length() {
    let f = module_ast.funcs[i]
    let ug : Map[String, Bool] = Map::new()
    match fn_direct_refs.get(f.name) {
      Some(refs) => {
        let mut gi = 0
        while gi < threadable_globals.length() {
          let gn = threadable_globals[gi]
          match refs.get(gn) {
            Some(true) => ug.set(gn, true)
            _ => ()
          }
          gi = gi + 1
        }
      }
      None => ()
    }
    fn_used_globals.set(f.name, ug)
    i = i + 1
  }
  let mut changed = true
  let mut iter_guard = 0
  while changed && iter_guard < 32 {
    changed = false
    iter_guard = iter_guard + 1
    i = 0
    while i < module_ast.funcs.length() {
      let f = module_ast.funcs[i]
      let ug = match fn_used_globals.get(f.name) { Some(m) => m; None => Map::new() }
      match fn_direct_call_lists.get(f.name) {
        Some(clist) => {
          let mut ci = 0
          while ci < clist.length() {
            let callee = clist[ci]
            match fn_used_globals.get(callee) {
              Some(cug) => {
                let mut gi = 0
                while gi < threadable_globals.length() {
                  let gn = threadable_globals[gi]
                  match cug.get(gn) {
                    Some(true) =>
                    match ug.get(gn) {
                      Some(true) => ()
                      _ => {
                        ug.set(gn, true)
                        changed = true
                      }
                    }
                    _ => ()
                  }
                  gi = gi + 1
                }
              }
              None => ()
            }
            match fn_needs_sizes.get(callee) {
              Some(true) =>
              match fn_needs_sizes.get(f.name) {
                Some(true) => ()
                _ => {
                  fn_needs_sizes.set(f.name, true)
                  changed = true
                }
              }
              _ => ()
            }
            ci = ci + 1
          }
        }
        None => ()
      }
      i = i + 1
    }
  }

  // Convert fn_used_globals to ordered arrays for deterministic parameter lists
  let helper_globals : Map[String, Array[String]] = Map::new()
  i = 0
  while i < module_ast.funcs.length() {
    let f = module_ast.funcs[i]
    let arr : Array[String] = []
    match fn_used_globals.get(f.name) {
      Some(ug) => {
        let mut gi = 0
        while gi < threadable_globals.length() {
          let gn = threadable_globals[gi]
          match ug.get(gn) {
            Some(true) => arr.push(gn)
            _ => ()
          }
          gi = gi + 1
        }
      }
      None => ()
    }
    helper_globals.set(f.name, arr)
    i = i + 1
  }

  let vs_in_structs : Map[String, Bool] = Map::new()
  let fs_out_structs : Map[String, Bool] = Map::new()
  i = 0
  while i < module_ast.funcs.length() {
    let f = module_ast.funcs[i]
    if wgsl_has_attr(f.attrs, "vertex") {
      let mut pi = 0
      while pi < f.params.length() {
        match f.params[pi].ty {
          WgslType::Named(sn) => vs_in_structs.set(sn, true)
          _ => ()
        }
        pi = pi + 1
      }
    }
    if wgsl_has_attr(f.attrs, "fragment") {
      match f.ret_ty {
        Some(WgslType::Named(sn)) => fs_out_structs.set(sn, true)
        _ => ()
      }
    }
    i = i + 1
  }

  let ctx = MslCtx::{
    sb: StringBuilder::new(),
    m: module_ast,
    struct_map: struct_map,
    alias_map: alias_map,
    func_map: func_map,
    binding_slots: binding_slots,
    const_ints: const_ints,
    helper_globals: helper_globals,
    helper_needs_sizes: fn_needs_sizes,
    scopes: [global_types],
    indent: 0,
    wrap_ret_struct: "",
    loop_counter: 0,
  }

  ctx.sb.write_string("#include <metal_stdlib>\nusing namespace metal;\n\n")

  // Emit small builtin polyfills only when used
  if uses_modf {
    ctx.sb.write_string("template<typename T> struct _wgsl_modf_res { T fract; T whole; };\n")
    ctx.sb.write_string("template<typename T> inline _wgsl_modf_res<T> _wgsl_modf(T x) { T w; T f = metal::modf(x, w); return {f, w}; }\n\n")
  }
  if uses_frexp {
    ctx.sb.write_string("template<typename T> struct _wgsl_frexp_res { T fract; int exp; };\n")
    ctx.sb.write_string("template<typename T> inline _wgsl_frexp_res<T> _wgsl_frexp(T x) { int e; T f = metal::frexp(x, e); return {f, e}; }\n\n")
  }
  if uses_cas {
    ctx.sb.write_string("template<typename T> struct _wgsl_cas_res { T old_value; bool exchanged; };\n")
    ctx.sb.write_string("template<typename A, typename T> inline _wgsl_cas_res<T> _wgsl_atomic_cas(device A* p, T cmp, T val) { T expected = cmp; bool ok = atomic_compare_exchange_weak_explicit(p, &expected, val, memory_order_relaxed, memory_order_relaxed); return {expected, ok}; }\n")
    ctx.sb.write_string("template<typename A, typename T> inline _wgsl_cas_res<T> _wgsl_atomic_cas(threadgroup A* p, T cmp, T val) { T expected = cmp; bool ok = atomic_compare_exchange_weak_explicit(p, &expected, val, memory_order_relaxed, memory_order_relaxed); return {expected, ok}; }\n\n")
  }
  if uses_flb {
    ctx.sb.write_string("inline uint _wgsl_first_leading_bit(uint x) { return x == 0u ? 0xffffffffu : (31u - clz(x)); }\n")
    ctx.sb.write_string("inline int _wgsl_first_leading_bit(int x) { uint u = x < 0 ? ~uint(x) : uint(x); return u == 0u ? -1 : int(31u - clz(u)); }\n\n")
  }
  if uses_ftb {
    ctx.sb.write_string("inline uint _wgsl_first_trailing_bit(uint x) { return x == 0u ? 0xffffffffu : ctz(x); }\n")
    ctx.sb.write_string("inline int _wgsl_first_trailing_bit(int x) { return x == 0 ? -1 : int(ctz(uint(x))); }\n\n")
  }

  // Emit module-level `const` and `override` declarations first (may be used in array lengths)
  let mut gi = 0
  let mut emitted_const = false
  while gi < module_ast.globals.length() {
    let g = module_ast.globals[gi]
    if g.decl_kind == "const" {
      match g.init {
        Some(ex) => {
          ctx.sb.write_string("constant ")
          match g.ty {
            Some(t) => msl_emit_type(ctx.sb, t)
            None => ctx.sb.write_string("auto")
          }
          ctx.sb.write_string(" ")
          ctx.sb.write_string(msl_ident(g.name))
          ctx.sb.write_string(" = ")
          ctx.emit_expr(ex)
          ctx.sb.write_string(";\n")
          emitted_const = true
        }
        None => ()
      }
    } else if g.decl_kind == "override" {
      let oty_sb = StringBuilder::new()
      match g.ty {
        Some(t) => msl_emit_type(oty_sb, t)
        None =>
        match g.init {
          Some(ex) => msl_emit_type(oty_sb, sem_to_wgsl_type(ctx.infer_expr_type(ex)))
          None => oty_sb.write_string("float")
        }
      }
      let oty_s = oty_sb.to_string()
      match wgsl_find_attr(g.attrs, "id") {
        Some(ia) =>
        if ia.args.length() == 1 {
          match g.init {
            Some(ex) => {
              let fc_name = "_wgsl_fc_" + msl_ident(g.name)
              ctx.sb.write_string("constant ")
              ctx.sb.write_string(oty_s)
              ctx.sb.write_string(" ")
              ctx.sb.write_string(fc_name)
              ctx.sb.write_string(" [[function_constant(")
              ctx.sb.write_string(ia.args[0])
              ctx.sb.write_string(")]];\n")
              ctx.sb.write_string("constant ")
              ctx.sb.write_string(oty_s)
              ctx.sb.write_string(" ")
              ctx.sb.write_string(msl_ident(g.name))
              ctx.sb.write_string(" = is_function_constant_defined(")
              ctx.sb.write_string(fc_name)
              ctx.sb.write_string(") ? ")
              ctx.sb.write_string(fc_name)
              ctx.sb.write_string(" : ")
              ctx.emit_expr(ex)
              ctx.sb.write_string(";\n")
            }
            None => {
              ctx.sb.write_string("constant ")
              ctx.sb.write_string(oty_s)
              ctx.sb.write_string(" ")
              ctx.sb.write_string(msl_ident(g.name))
              ctx.sb.write_string(" [[function_constant(")
              ctx.sb.write_string(ia.args[0])
              ctx.sb.write_string(")]];\n")
            }
          }
        } else {
          ctx.sb.write_string("constant ")
          ctx.sb.write_string(oty_s)
          ctx.sb.write_string(" ")
          ctx.sb.write_string(msl_ident(g.name))
          ctx.sb.write_string(" = 0;\n")
        }
        None => {
          ctx.sb.write_string("constant ")
          ctx.sb.write_string(oty_s)
          ctx.sb.write_string(" ")
          ctx.sb.write_string(msl_ident(g.name))
          match g.init {
            Some(ex) => {
              ctx.sb.write_string(" = ")
              ctx.emit_expr(ex)
              ctx.sb.write_string(";\n")
            }
            None => ctx.sb.write_string(" = 0;\n")
          }
        }
      }
      emitted_const = true
    }
    gi = gi + 1
  }
  if emitted_const {
    ctx.sb.write_string("\n")
  }

  // Emit structs & aliases in topological dependency order
  let emitted_types : Map[String, Bool] = Map::new()
  let mut si = 0
  while si < module_ast.structs.length() {
    msl_emit_type_decl_topo(module_ast.structs[si].name, ctx, vs_in_structs, fs_out_structs, host_structs, emitted_types)
    si = si + 1
  }
  let mut ai = 0
  while ai < module_ast.aliases.length() {
    msl_emit_type_decl_topo(module_ast.aliases[ai].name, ctx, vs_in_structs, fs_out_structs, host_structs, emitted_types)
    ai = ai + 1
  }

  // Forward declarations for all non-entry helper functions
  let mut fi = 0
  let mut has_helpers = false
  while fi < module_ast.funcs.length() {
    let f = module_ast.funcs[fi]
    let is_entry = wgsl_has_attr(f.attrs, "vertex") ||
    wgsl_has_attr(f.attrs, "fragment") ||
    wgsl_has_attr(f.attrs, "compute")
    if !is_entry {
      msl_emit_helper_sig(ctx, f, global_map)
      ctx.sb.write_string(";\n")
      has_helpers = true
    }
    fi = fi + 1
  }
  if has_helpers {
    ctx.sb.write_string("\n")
  }

  // Emit functions
  fi = 0
  while fi < module_ast.funcs.length() {
    msl_emit_func(ctx, module_ast.funcs[fi], reflection.bindings, module_ast.globals, global_map)
    fi = fi + 1
  }

  Ok(CompiledModule::{ source: ctx.sb.to_string(), reflection: reflection })
}
