///| Pure-Pion W3C WGSL compiler public entry points.
///| Zero `extern "C"`, zero `World`, zero external dependencies, zero module-level mutable globals.

fn not_implemented_err() -> WgslError {
  WgslError::{
    kind: WgslErrorKind::CodegenError,
    line: 0,
    col: 0,
    message: "not implemented",
  }
}

///| Parse a WGSL source string into a `WgslModule` AST with explicit `ParseLimits`.
pub fn parse(source : String, limits : ParseLimits) -> Result[WgslModule, WgslError] {
  let _ = source
  let _ = limits
  Err(not_implemented_err())
}

///| Parse and statically validate a WGSL source string, returning its `ModuleReflection`.
pub fn validate(source : String, limits : ParseLimits) -> Result[ModuleReflection, WgslError] {
  let _ = source
  let _ = limits
  Err(not_implemented_err())
}

///| Parse, validate, and reflect a WGSL source string using default limits.
pub fn reflect(source : String) -> Result[ModuleReflection, WgslError] {
  validate(source, ParseLimits::default())
}

///| Compile a WGSL shader module to Metal Shading Language (MSL 2.x).
pub fn compile_to_msl(
  source : String,
  options : CompileOptions,
) -> Result[CompiledModule, WgslError] {
  let _ = source
  let _ = options
  Err(not_implemented_err())
}

///| Compile a WGSL shader module to GLSL ES 3.00 (vertex/fragment) or GLSL 450 (compute).
pub fn compile_to_glsl(
  source : String,
  options : CompileOptions,
) -> Result[CompiledModule, WgslError] {
  let _ = source
  let _ = options
  Err(not_implemented_err())
}

///| Look up an entry point by WGSL name in a `ModuleReflection`.
pub fn find_entry_point(
  reflection : ModuleReflection,
  name : String,
) -> Result[EntryPointInfo, WgslError] {
  let _ = reflection
  let _ = name
  Err(not_implemented_err())
}
