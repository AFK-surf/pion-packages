///| Pure-Pion WGSL -> GLSL ES 3.00 (vertex/fragment) & GLSL 450 (compute) backend.
///| Uses direct `StringBuilder` emission for low-allocation code generation.

fn glsl_scalar(s : String) -> String {
  if s == "f32" || s == "f16" {
    "float"
  } else if s == "i32" {
    "int"
  } else if s == "u32" {
    "uint"
  } else if s == "bool" {
    "bool"
  } else {
    s
  }
}

fn glsl_vec_prefix(elem : String) -> String {
  if elem == "i32" {
    "i"
  } else if elem == "u32" {
    "u"
  } else if elem == "bool" {
    "b"
  } else {
    ""
  }
}

fn glsl_emit_type(sb : StringBuilder, ty : WgslType, aliases : Map[String, WgslType]) -> Unit {
  match ty {
    WgslType::Scalar(s) => sb.write_string(glsl_scalar(s))
    WgslType::Vec(d, e) => {
      sb.write_string(glsl_vec_prefix(e))
      sb.write_string("vec")
      sb.write_string(d.to_string())
    }
    WgslType::Mat(c, r, _) =>
    if c == r {
      sb.write_string("mat")
      sb.write_string(c.to_string())
    } else {
      sb.write_string("mat")
      sb.write_string(c.to_string())
      sb.write_string("x")
      sb.write_string(r.to_string())
    }
    WgslType::Array(elem, len, len_ident) => {
      glsl_emit_type(sb, elem, aliases)
      sb.write_string("[")
      if len > 0 {
        sb.write_string(len.to_string())
      } else if len_ident.length() > 0 {
        sb.write_string(len_ident)
      }
      sb.write_string("]")
    }
    WgslType::Texture(kind, elem, _) => {
      let pref = if elem == "i32" { "i" } else if elem == "u32" { "u" } else { "" }
      if kind == "texture_1d" {
        sb.write_string(pref + "sampler1D")
      } else if kind == "texture_2d" {
        sb.write_string(pref + "sampler2D")
      } else if kind == "texture_2d_array" {
        sb.write_string(pref + "sampler2DArray")
      } else if kind == "texture_3d" {
        sb.write_string(pref + "sampler3D")
      } else if kind == "texture_cube" {
        sb.write_string(pref + "samplerCube")
      } else if kind == "texture_cube_array" {
        sb.write_string(pref + "samplerCubeArray")
      } else if kind == "texture_depth_2d" {
        sb.write_string("sampler2DShadow")
      } else if kind == "texture_depth_2d_array" {
        sb.write_string("sampler2DArrayShadow")
      } else if kind == "texture_depth_cube" {
        sb.write_string("samplerCubeShadow")
      } else if kind == "texture_storage_2d" {
        sb.write_string("image2D")
      } else if kind == "texture_storage_3d" {
        sb.write_string("image3D")
      } else {
        sb.write_string("sampler2D")
      }
    }
    WgslType::Sampler(_) => sb.write_string("sampler")
    WgslType::Atomic(e) => sb.write_string(glsl_scalar(e))
    WgslType::Named(n) =>
    match aliases.get(n) {
      Some(resolved) => glsl_emit_type(sb, resolved, aliases)
      None => sb.write_string(n)
    }
    WgslType::Ptr(_, elem, _) => glsl_emit_type(sb, elem, aliases)
  }
}

fn glsl_builtin_var(name : String) -> String {
  if name == "vertex_index" {
    "uint(gl_VertexID)"
  } else if name == "instance_index" {
    "uint(gl_InstanceID)"
  } else if name == "position" {
    "gl_Position"
  } else if name == "front_facing" {
    "gl_FrontFacing"
  } else if name == "frag_depth" {
    "gl_FragDepth"
  } else if name == "sample_index" {
    "uint(gl_SampleID)"
  } else if name == "global_invocation_id" {
    "gl_GlobalInvocationID"
  } else if name == "local_invocation_id" {
    "gl_LocalInvocationID"
  } else if name == "workgroup_id" {
    "gl_WorkGroupID"
  } else if name == "local_invocation_index" {
    "gl_LocalInvocationIndex"
  } else if name == "num_workgroups" {
    "gl_NumWorkGroups"
  } else {
    name
  }
}

struct GlslCtx {
  sb : StringBuilder
  aliases : Map[String, WgslType]
  structs : Map[String, WgslStructDecl]
  builtin_remap : Map[String, String]
  mut indent : Int
  mut in_entry : Bool
  mut entry_stage : EntryStage
  mut entry_ret_struct : String
}

fn GlslCtx::new(m : WgslModule, stage : EntryStage) -> GlslCtx {
  let al : Map[String, WgslType] = Map::new()
  let mut i = 0
  while i < m.aliases.length() {
    al.set(m.aliases[i].name, m.aliases[i].ty)
    i = i + 1
  }
  let st : Map[String, WgslStructDecl] = Map::new()
  i = 0
  while i < m.structs.length() {
    st.set(m.structs[i].name, m.structs[i])
    i = i + 1
  }
  GlslCtx::{
    sb: StringBuilder::new(),
    aliases: al,
    structs: st,
    builtin_remap: Map::new(),
    indent: 0,
    in_entry: false,
    entry_stage: stage,
    entry_ret_struct: "",
  }
}

fn GlslCtx::emit_indent(self : GlslCtx) -> Unit {
  let mut i = 0
  while i < self.indent {
    self.sb.write_string("  ")
    i = i + 1
  }
}

fn glsl_emit_int_lit(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  if n > 1 && s.code_unit_at(n - 1) == 105 {
    sb.write_string(s.slice(0, n - 1))
  } else {
    sb.write_string(s)
  }
}

fn glsl_emit_float_lit(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  if n > 1 {
    let last = s.code_unit_at(n - 1)
    if last == 102 || last == 104 {
      sb.write_string(s.slice(0, n - 1))
      return
    }
  }
  sb.write_string(s)
}

fn GlslCtx::emit_arg_list(self : GlslCtx, args : Array[WgslExpr]) -> Unit {
  let mut i = 0
  while i < args.length() {
    if i > 0 {
      self.sb.write_string(", ")
    }
    self.emit_expr(args[i])
    i = i + 1
  }
}

fn glsl_remap_builtin(name : String) -> String {
  if name == "inverseSqrt" {
    "inversesqrt"
  } else if name == "dpdx" || name == "dpdxCoarse" || name == "dpdxFine" {
    "dFdx"
  } else if name == "dpdy" || name == "dpdyCoarse" || name == "dpdyFine" {
    "dFdy"
  } else if name == "fwidthCoarse" || name == "fwidthFine" {
    "fwidth"
  } else if name == "countOneBits" {
    "bitCount"
  } else if name == "reverseBits" {
    "bitfieldReverse"
  } else if name == "pack2x16float" {
    "packHalf2x16"
  } else if name == "unpack2x16float" {
    "unpackHalf2x16"
  } else if name == "pack4x8unorm" {
    "packUnorm4x8"
  } else if name == "unpack4x8unorm" {
    "unpackUnorm4x8"
  } else if name == "pack4x8snorm" {
    "packSnorm4x8"
  } else if name == "unpack4x8snorm" {
    "unpackSnorm4x8"
  } else if name == "pack2x16unorm" {
    "packUnorm2x16"
  } else if name == "unpack2x16unorm" {
    "unpackUnorm2x16"
  } else if name == "pack2x16snorm" {
    "packSnorm2x16"
  } else if name == "unpack2x16snorm" {
    "unpackSnorm2x16"
  } else {
    name
  }
}

fn GlslCtx::emit_expr(self : GlslCtx, expr : WgslExpr) -> Unit {
  match expr {
    WgslExpr::Ident(name, _, _) =>
    match self.builtin_remap.get(name) {
      Some(mapped) => self.sb.write_string(mapped)
      None => self.sb.write_string(name)
    }
    WgslExpr::IntLit(s, _, _) => glsl_emit_int_lit(self.sb, s)
    WgslExpr::FloatLit(s, _, _) => glsl_emit_float_lit(self.sb, s)
    WgslExpr::BoolLit(b, _, _) => self.sb.write_string(if b { "true" } else { "false" })
    WgslExpr::Paren(inner, _, _) => {
      self.sb.write_string("(")
      self.emit_expr(inner)
      self.sb.write_string(")")
    }
    WgslExpr::Unary(op, inner, _, _) =>
    if op == "&" || op == "*" {
      self.emit_expr(inner)
    } else {
      self.sb.write_string(op)
      self.emit_expr(inner)
    }
    WgslExpr::Binary(op, l, r, _, _) => {
      self.emit_expr(l)
      self.sb.write_string(" ")
      self.sb.write_string(op)
      self.sb.write_string(" ")
      self.emit_expr(r)
    }
    WgslExpr::Index(base, idx, _, _) => {
      self.emit_expr(base)
      self.sb.write_string("[")
      self.emit_expr(idx)
      self.sb.write_string("]")
    }
    WgslExpr::Field(base, fld, _, _) => {
      self.emit_expr(base)
      self.sb.write_string(".")
      self.sb.write_string(fld)
    }
    WgslExpr::Call(name, targs, arr_len, len_ident, args, _, _) => {
      // WGSL `select(f, t, cond)` -> GLSL `((cond) ? (t) : (f))`
      if name == "select" && args.length() == 3 {
        self.sb.write_string("((")
        self.emit_expr(args[2])
        self.sb.write_string(") ? (")
        self.emit_expr(args[1])
        self.sb.write_string(") : (")
        self.emit_expr(args[0])
        self.sb.write_string("))")
        return
      }
      if name == "saturate" && args.length() == 1 {
        self.sb.write_string("clamp(")
        self.emit_expr(args[0])
        self.sb.write_string(", 0.0, 1.0)")
        return
      }
      if name == "textureSample" && args.length() == 3 {
        self.sb.write_string("texture(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string(")")
        return
      }
      if name == "textureSampleLevel" && args.length() == 4 {
        self.sb.write_string("textureLod(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string(", ")
        self.emit_expr(args[3])
        self.sb.write_string(")")
        return
      }
      if name == "textureSampleBias" && args.length() == 4 {
        self.sb.write_string("texture(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string(", ")
        self.emit_expr(args[3])
        self.sb.write_string(")")
        return
      }
      if name == "textureLoad" && args.length() == 3 {
        self.sb.write_string("texelFetch(")
        self.emit_expr(args[0])
        self.sb.write_string(", ivec2(")
        self.emit_expr(args[1])
        self.sb.write_string("), int(")
        self.emit_expr(args[2])
        self.sb.write_string("))")
        return
      }
      if name == "textureStore" && args.length() == 3 {
        self.sb.write_string("imageStore(")
        self.emit_expr(args[0])
        self.sb.write_string(", ivec2(")
        self.emit_expr(args[1])
        self.sb.write_string("), ")
        self.emit_expr(args[2])
        self.sb.write_string(")")
        return
      }
      if name == "textureDimensions" && args.length() >= 1 {
        self.sb.write_string("uvec2(textureSize(")
        self.emit_expr(args[0])
        self.sb.write_string(", 0))")
        return
      }
      if name == "arrayLength" && args.length() == 1 {
        self.sb.write_string("uint(")
        match args[0] {
          WgslExpr::Unary("&", e, _, _) => self.emit_expr(e)
          _ => self.emit_expr(args[0])
        }
        self.sb.write_string(".length())")
        return
      }
      if name == "workgroupBarrier" {
        self.sb.write_string("barrier()")
        return
      }
      if name == "storageBarrier" {
        self.sb.write_string("memoryBarrierBuffer()")
        return
      }
      if name == "textureBarrier" {
        self.sb.write_string("memoryBarrierImage()")
        return
      }
      if name == "bitcast" && targs.length() == 1 && args.length() == 1 {
        match targs[0] {
          WgslType::Scalar("f32") => self.sb.write_string("uintBitsToFloat(")
          WgslType::Scalar("u32") => self.sb.write_string("floatBitsToUint(")
          WgslType::Scalar("i32") => self.sb.write_string("floatBitsToInt(")
          _ => {
            glsl_emit_type(self.sb, targs[0], self.aliases)
            self.sb.write_string("(")
          }
        }
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "array" && targs.length() == 1 {
        glsl_emit_type(self.sb, targs[0], self.aliases)
        self.sb.write_string("[")
        if arr_len > 0 {
          self.sb.write_string(arr_len.to_string())
        } else if len_ident.length() > 0 {
          self.sb.write_string(len_ident)
        } else {
          self.sb.write_string(args.length().to_string())
        }
        self.sb.write_string("](")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      if (name == "vec2" || name == "vec3" || name == "vec4") && targs.length() == 1 {
        let dim = name.code_unit_at(3) - 48
        let pref = match targs[0] {
          WgslType::Scalar(s) => glsl_vec_prefix(s)
          _ => ""
        }
        self.sb.write_string(pref)
        self.sb.write_string("vec")
        self.sb.write_string(dim.to_string())
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      if (name == "mat2x2" || name == "mat3x3" || name == "mat4x4" ||
        name == "mat2x3" || name == "mat2x4" || name == "mat3x2" ||
        name == "mat3x4" || name == "mat4x2" || name == "mat4x3") && targs.length() == 1 {
        let cols = name.code_unit_at(3) - 48
        let rows = name.code_unit_at(5) - 48
        if cols == rows {
          self.sb.write_string("mat")
          self.sb.write_string(cols.to_string())
        } else {
          self.sb.write_string("mat")
          self.sb.write_string(cols.to_string())
          self.sb.write_string("x")
          self.sb.write_string(rows.to_string())
        }
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      if name == "f32" || name == "i32" || name == "u32" || name == "bool" || name == "f16" {
        self.sb.write_string(glsl_scalar(name))
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      match wgsl_resolve_vec_alias(name) {
        Some(vt) => {
          glsl_emit_type(self.sb, vt, self.aliases)
          self.sb.write_string("(")
          self.emit_arg_list(args)
          self.sb.write_string(")")
          return
        }
        None => ()
      }
      let fn_name = glsl_remap_builtin(name)
      self.sb.write_string(fn_name)
      self.sb.write_string("(")
      self.emit_arg_list(args)
      self.sb.write_string(")")
    }
  }
}

fn glsl_infer_expr_type(expr : WgslExpr, aliases : Map[String, WgslType]) -> String {
  match expr {
    WgslExpr::FloatLit(_, _, _) => "float"
    WgslExpr::IntLit(s, _, _) =>
    if s.length() > 0 && s.code_unit_at(s.length() - 1) == 117 {
      "uint"
    } else {
      "int"
    }
    WgslExpr::BoolLit(_, _, _) => "bool"
    WgslExpr::Call(name, targs, _, _, _, _, _) =>
    if name == "f32" || name == "f16" {
      "float"
    } else if name == "u32" {
      "uint"
    } else if name == "i32" {
      "int"
    } else if name == "bool" {
      "bool"
    } else if name == "textureSample" || name == "textureSampleLevel" || name == "textureLoad" {
      "vec4"
    } else if name == "textureDimensions" {
      "uvec2"
    } else if name == "arrayLength" {
      "uint"
    } else if name == "dot" || name == "length" || name == "distance" ||
    name == "fract" || name == "dpdx" || name == "dpdy" || name == "fwidth" ||
    name == "inverseSqrt" || name == "saturate" {
      "float"
    } else if (name == "vec2" || name == "vec3" || name == "vec4") && targs.length() == 1 {
      let dim = name.code_unit_at(3) - 48
      let pref = match targs[0] {
        WgslType::Scalar(s) => glsl_vec_prefix(s)
        _ => ""
      }
      pref + "vec" + dim.to_string()
    } else {
      match wgsl_resolve_vec_alias(name) {
        Some(vt) => {
          let sb = StringBuilder::new()
          glsl_emit_type(sb, vt, aliases)
          sb.to_string()
        }
        None => "float"
      }
    }
    WgslExpr::Field(_, fld, _, _) => {
      let n = fld.length()
      if n == 2 && (fld == "xy" || fld == "rg" || fld == "uv" || fld == "zw") {
        "vec2"
      } else if n == 3 && (fld == "xyz" || fld == "rgb") {
        "vec3"
      } else if n == 4 && (fld == "xyzw" || fld == "rgba") {
        "vec4"
      } else {
        "float"
      }
    }
    _ => "float"
  }
}

fn GlslCtx::emit_simple_stmt_inline(self : GlslCtx, s : WgslStmt) -> Unit {
  match s {
    WgslStmt::VarDecl(name, kind_s, ty, init, _, _) => {
      if kind_s == "const" {
        self.sb.write_string("const ")
      }
      match ty {
        Some(t) => glsl_emit_type(self.sb, t, self.aliases)
        None =>
        match init {
          Some(ex) => self.sb.write_string(glsl_infer_expr_type(ex, self.aliases))
          None => self.sb.write_string("float")
        }
      }
      self.sb.write_string(" ")
      self.sb.write_string(name)
      match init {
        Some(ex) => {
          self.sb.write_string(" = ")
          self.emit_expr(ex)
        }
        None => ()
      }
    }
    WgslStmt::Assign(lhs, op, rhs, _, _) => {
      self.emit_expr(lhs)
      self.sb.write_string(" ")
      self.sb.write_string(op)
      self.sb.write_string(" ")
      self.emit_expr(rhs)
    }
    WgslStmt::PhonyAssign(rhs, _, _) => self.emit_expr(rhs)
    WgslStmt::IncDec(lhs, is_inc, _, _) => {
      self.emit_expr(lhs)
      self.sb.write_string(if is_inc { "++" } else { "--" })
    }
    WgslStmt::ExprStmt(ex, _, _) => self.emit_expr(ex)
    _ => ()
  }
}

fn GlslCtx::emit_stmts(self : GlslCtx, stmts : Array[WgslStmt]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    self.emit_stmt(stmts[i])
    i = i + 1
  }
}

fn GlslCtx::emit_stmt(self : GlslCtx, stmt : WgslStmt) -> Unit {
  match stmt {
    WgslStmt::VarDecl(_, _, _, _, _, _)
    | WgslStmt::Assign(_, _, _, _, _)
    | WgslStmt::PhonyAssign(_, _, _)
    | WgslStmt::IncDec(_, _, _, _)
    | WgslStmt::ExprStmt(_, _, _) => {
      self.emit_indent()
      self.emit_simple_stmt_inline(stmt)
      self.sb.write_string(";\n")
    }
    WgslStmt::Return(opt_ex, _, _) => {
      self.emit_indent()
      if self.in_entry {
        match opt_ex {
          Some(ex) =>
          if self.entry_ret_struct.length() > 0 {
            self.sb.write_string(self.entry_ret_struct)
            self.sb.write_string(" _ret = ")
            self.emit_expr(ex)
            self.sb.write_string(";\n")
            match self.structs.get(self.entry_ret_struct) {
              Some(st) => {
                let mut fi = 0
                while fi < st.fields.length() {
                  let fld = st.fields[fi]
                  self.emit_indent()
                  match wgsl_find_attr(fld.attrs, "builtin") {
                    Some(ba) =>
                    if ba.args.length() == 1 && ba.args[0] == "position" {
                      self.sb.write_string("gl_Position = _ret.")
                      self.sb.write_string(fld.name)
                      self.sb.write_string(";\n")
                    } else if ba.args.length() == 1 && ba.args[0] == "frag_depth" {
                      self.sb.write_string("gl_FragDepth = _ret.")
                      self.sb.write_string(fld.name)
                      self.sb.write_string(";\n")
                    }
                    None =>
                    match self.entry_stage {
                      EntryStage::Vertex => {
                        self.sb.write_string("_vs_out_")
                        self.sb.write_string(fld.name)
                        self.sb.write_string(" = _ret.")
                        self.sb.write_string(fld.name)
                        self.sb.write_string(";\n")
                      }
                      EntryStage::Fragment => {
                        let loc = match wgsl_find_attr(fld.attrs, "location") {
                          Some(la) => if la.args.length() > 0 { la.args[0] } else { "0" }
                          None => "0"
                        }
                        self.sb.write_string("_fs_out_")
                        self.sb.write_string(loc)
                        self.sb.write_string(" = _ret.")
                        self.sb.write_string(fld.name)
                        self.sb.write_string(";\n")
                      }
                      EntryStage::Compute => ()
                    }
                  }
                  fi = fi + 1
                }
              }
              None => ()
            }
            self.emit_indent()
            self.sb.write_string("return;\n")
          } else {
            match self.entry_stage {
              EntryStage::Vertex => {
                self.sb.write_string("gl_Position = ")
                self.emit_expr(ex)
                self.sb.write_string(";\n")
              }
              EntryStage::Fragment => {
                self.sb.write_string("_fs_out_0 = ")
                self.emit_expr(ex)
                self.sb.write_string(";\n")
              }
              EntryStage::Compute => ()
            }
            self.emit_indent()
            self.sb.write_string("return;\n")
          }
          None => self.sb.write_string("return;\n")
        }
      } else {
        match opt_ex {
          Some(ex) => {
            self.sb.write_string("return ")
            self.emit_expr(ex)
            self.sb.write_string(";\n")
          }
          None => self.sb.write_string("return;\n")
        }
      }
    }
    WgslStmt::If(cond, then_b, else_b, _, _) => {
      self.emit_indent()
      self.sb.write_string("if (")
      self.emit_expr(cond)
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      self.emit_stmts(then_b)
      self.indent = self.indent - 1
      if else_b.length() > 0 {
        self.emit_indent()
        self.sb.write_string("} else {\n")
        self.indent = self.indent + 1
        self.emit_stmts(else_b)
        self.indent = self.indent - 1
      }
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::Switch(sel, cases, _, _) => {
      self.emit_indent()
      self.sb.write_string("switch (")
      self.emit_expr(sel)
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      let mut ci = 0
      while ci < cases.length() {
        let c = cases[ci]
        let mut si = 0
        while si < c.selectors.length() {
          self.emit_indent()
          self.sb.write_string("case ")
          self.emit_expr(c.selectors[si])
          self.sb.write_string(":\n")
          si = si + 1
        }
        if c.is_default {
          self.emit_indent()
          self.sb.write_string("default:\n")
        }
        self.emit_indent()
        self.sb.write_string("{\n")
        self.indent = self.indent + 1
        self.emit_stmts(c.body)
        self.emit_indent()
        self.sb.write_string("break;\n")
        self.indent = self.indent - 1
        self.emit_indent()
        self.sb.write_string("}\n")
        ci = ci + 1
      }
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::For(init, cond, update, body, _, _) => {
      self.emit_indent()
      self.sb.write_string("for (")
      match init {
        Some(st) => self.emit_simple_stmt_inline(st)
        None => ()
      }
      self.sb.write_string("; ")
      match cond {
        Some(ex) => self.emit_expr(ex)
        None => ()
      }
      self.sb.write_string("; ")
      match update {
        Some(st) => self.emit_simple_stmt_inline(st)
        None => ()
      }
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::While(cond, body, _, _) => {
      self.emit_indent()
      self.sb.write_string("while (")
      self.emit_expr(cond)
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::Loop(body, cont, break_if, _, _) => {
      self.emit_indent()
      self.sb.write_string("while (true) {\n")
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.emit_stmts(cont)
      match break_if {
        Some(cond) => {
          self.emit_indent()
          self.sb.write_string("if (")
          self.emit_expr(cond)
          self.sb.write_string(") { break; }\n")
        }
        None => ()
      }
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::Break(_, _) => {
      self.emit_indent()
      self.sb.write_string("break;\n")
    }
    WgslStmt::Continue(_, _) => {
      self.emit_indent()
      self.sb.write_string("continue;\n")
    }
    WgslStmt::Discard(_, _) => {
      self.emit_indent()
      self.sb.write_string("discard;\n")
    }
    WgslStmt::Block(body, _, _) => {
      self.emit_indent()
      self.sb.write_string("{\n")
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
  }
}

fn wgsl_emit_glsl(
  module_ast : WgslModule,
  reflection : ModuleReflection,
  options : CompileOptions,
) -> Result[CompiledModule, WgslError] {
  if reflection.entries.length() == 0 {
    return Err(
      WgslError::{
        kind: WgslErrorKind::CodegenError,
        line: 0,
        col: 0,
        message: "no entry point found in WGSL module",
      },
    )
  }

  // Select target entry point
  let mut target_info = reflection.entries[0]
  if options.entry_point.length() > 0 {
    let mut found = false
    let mut ei = 0
    while ei < reflection.entries.length() {
      if reflection.entries[ei].name == options.entry_point {
        target_info = reflection.entries[ei]
        found = true
        break
      }
      ei = ei + 1
    }
    if !found {
      return Err(
        WgslError::{
          kind: WgslErrorKind::CodegenError,
          line: 0,
          col: 0,
          message: "unknown entry point '" + options.entry_point + "'",
        },
      )
    }
  }

  let mut target_func = module_ast.funcs[0]
  let mut fi = 0
  while fi < module_ast.funcs.length() {
    if module_ast.funcs[fi].name == target_info.name {
      target_func = module_ast.funcs[fi]
      break
    }
    fi = fi + 1
  }

  let is_compute = match target_info.stage {
    EntryStage::Compute => true
    _ => false
  }
  let ctx = GlslCtx::new(module_ast, target_info.stage)

  if is_compute {
    ctx.sb.write_string("#version 450\n\n")
    ctx.sb.write_string("layout(local_size_x = ")
    ctx.sb.write_string(target_info.workgroup_size_x.to_string())
    ctx.sb.write_string(", local_size_y = ")
    ctx.sb.write_string(target_info.workgroup_size_y.to_string())
    ctx.sb.write_string(", local_size_z = ")
    ctx.sb.write_string(target_info.workgroup_size_z.to_string())
    ctx.sb.write_string(") in;\n\n")
  } else {
    ctx.sb.write_string("#version 300 es\nprecision highp float;\nprecision highp int;\n\n")
  }

  // Emit structs
  let mut si = 0
  while si < module_ast.structs.length() {
    let s = module_ast.structs[si]
    ctx.sb.write_string("struct ")
    ctx.sb.write_string(s.name)
    ctx.sb.write_string(" {\n")
    let mut sfi = 0
    while sfi < s.fields.length() {
      let fld = s.fields[sfi]
      ctx.sb.write_string("  ")
      glsl_emit_type(ctx.sb, fld.ty, ctx.aliases)
      ctx.sb.write_string(" ")
      ctx.sb.write_string(fld.name)
      ctx.sb.write_string(";\n")
      sfi = sfi + 1
    }
    ctx.sb.write_string("};\n\n")
    si = si + 1
  }

  // Emit module-level globals (consts, overrides, uniforms, storage buffers, textures, private/workgroup)
  let mut gi = 0
  while gi < module_ast.globals.length() {
    let g = module_ast.globals[gi]
    if g.decl_kind == "const" || g.decl_kind == "override" {
      match g.init {
        Some(ex) => {
          ctx.sb.write_string("const ")
          match g.ty {
            Some(t) => glsl_emit_type(ctx.sb, t, ctx.aliases)
            None => ctx.sb.write_string(glsl_infer_expr_type(ex, ctx.aliases))
          }
          ctx.sb.write_string(" ")
          ctx.sb.write_string(g.name)
          ctx.sb.write_string(" = ")
          ctx.emit_expr(ex)
          ctx.sb.write_string(";\n")
        }
        None => ()
      }
    } else if g.addr_space == "private" {
      match g.ty {
        Some(t) => glsl_emit_type(ctx.sb, t, ctx.aliases)
        None => ctx.sb.write_string("float")
      }
      ctx.sb.write_string(" ")
      ctx.sb.write_string(g.name)
      match g.init {
        Some(ex) => {
          ctx.sb.write_string(" = ")
          ctx.emit_expr(ex)
        }
        None => ()
      }
      ctx.sb.write_string(";\n")
    } else if g.addr_space == "workgroup" {
      ctx.sb.write_string("shared ")
      match g.ty {
        Some(t) => glsl_emit_type(ctx.sb, t, ctx.aliases)
        None => ctx.sb.write_string("float")
      }
      ctx.sb.write_string(" ")
      ctx.sb.write_string(g.name)
      ctx.sb.write_string(";\n")
    } else {
      // Bound resources
      let mut slot = 0
      let mut bi = 0
      while bi < reflection.bindings.length() {
        if reflection.bindings[bi].name == g.name {
          slot = reflection.bindings[bi].msl_slot
          break
        }
        bi = bi + 1
      }
      match g.ty {
        Some(WgslType::Sampler(_)) => ()
        Some(WgslType::Texture(tk, elem, acc)) => {
          ctx.sb.write_string("uniform ")
          glsl_emit_type(ctx.sb, WgslType::Texture(tk, elem, acc), ctx.aliases)
          ctx.sb.write_string(" ")
          ctx.sb.write_string(g.name)
          ctx.sb.write_string(";\n")
        }
        Some(t) =>
        if g.addr_space == "uniform" {
          if is_compute {
            ctx.sb.write_string("layout(std140, binding = ")
            ctx.sb.write_string(slot.to_string())
            ctx.sb.write_string(") uniform _U_")
          } else {
            ctx.sb.write_string("layout(std140) uniform _U_")
          }
          ctx.sb.write_string(g.name)
          ctx.sb.write_string(" {\n  ")
          match t {
            WgslType::Named(sn) =>
            match ctx.structs.get(sn) {
              Some(st) => {
                let mut sfi = 0
                while sfi < st.fields.length() {
                  if sfi > 0 {
                    ctx.sb.write_string("  ")
                  }
                  glsl_emit_type(ctx.sb, st.fields[sfi].ty, ctx.aliases)
                  ctx.sb.write_string(" ")
                  ctx.sb.write_string(st.fields[sfi].name)
                  ctx.sb.write_string(";\n")
                  sfi = sfi + 1
                }
              }
              None => {
                glsl_emit_type(ctx.sb, t, ctx.aliases)
                ctx.sb.write_string(" value;\n")
              }
            }
            _ => {
              glsl_emit_type(ctx.sb, t, ctx.aliases)
              ctx.sb.write_string(" value;\n")
            }
          }
          ctx.sb.write_string("} ")
          ctx.sb.write_string(g.name)
          ctx.sb.write_string(";\n")
        } else if g.addr_space == "storage" {
          ctx.sb.write_string("layout(std430, binding = ")
          ctx.sb.write_string(slot.to_string())
          ctx.sb.write_string(") ")
          if g.access != "read_write" {
            ctx.sb.write_string("readonly ")
          }
          ctx.sb.write_string("buffer _B_")
          ctx.sb.write_string(g.name)
          ctx.sb.write_string(" {\n  ")
          match t {
            WgslType::Array(elem, len, len_ident) => {
              glsl_emit_type(ctx.sb, elem, ctx.aliases)
              ctx.sb.write_string(" ")
              ctx.sb.write_string(g.name)
              ctx.sb.write_string("[")
              if len > 0 {
                ctx.sb.write_string(len.to_string())
              } else if len_ident.length() > 0 {
                ctx.sb.write_string(len_ident)
              }
              ctx.sb.write_string("];\n")
            }
            _ => {
              glsl_emit_type(ctx.sb, t, ctx.aliases)
              ctx.sb.write_string(" ")
              ctx.sb.write_string(g.name)
              ctx.sb.write_string(";\n")
            }
          }
          ctx.sb.write_string("};\n")
        }
        None => ()
      }
    }
    gi = gi + 1
  }
  ctx.sb.write_string("\n")

  // Emit stage inputs & outputs for target entry point
  let mut pi = 0
  while pi < target_func.params.length() {
    let p = target_func.params[pi]
    match wgsl_find_attr(p.attrs, "builtin") {
      Some(ba) =>
      if ba.args.length() == 1 {
        ctx.builtin_remap.set(p.name, glsl_builtin_var(ba.args[0]))
      }
      None =>
      match wgsl_find_attr(p.attrs, "location") {
        Some(la) =>
        if la.args.length() == 1 {
          ctx.sb.write_string("layout(location = ")
          ctx.sb.write_string(la.args[0])
          ctx.sb.write_string(") in ")
          glsl_emit_type(ctx.sb, p.ty, ctx.aliases)
          ctx.sb.write_string(" ")
          ctx.sb.write_string(p.name)
          ctx.sb.write_string(";\n")
        }
        None =>
        match p.ty {
          WgslType::Named(sn) =>
          match ctx.structs.get(sn) {
            Some(st) => {
              let mut sfi = 0
              while sfi < st.fields.length() {
                let fld = st.fields[sfi]
                match wgsl_find_attr(fld.attrs, "location") {
                  Some(la) =>
                  if la.args.length() == 1 {
                    ctx.sb.write_string("layout(location = ")
                    ctx.sb.write_string(la.args[0])
                    ctx.sb.write_string(") in ")
                    glsl_emit_type(ctx.sb, fld.ty, ctx.aliases)
                    ctx.sb.write_string(" _in_")
                    ctx.sb.write_string(fld.name)
                    ctx.sb.write_string(";\n")
                  }
                  None => ()
                }
                sfi = sfi + 1
              }
            }
            None => ()
          }
          _ => ()
        }
      }
    }
    pi = pi + 1
  }

  match target_func.ret_ty {
    Some(rt) =>
    match rt {
      WgslType::Named(sn) =>
      match ctx.structs.get(sn) {
        Some(st) => {
          ctx.entry_ret_struct = sn
          let mut sfi = 0
          while sfi < st.fields.length() {
            let fld = st.fields[sfi]
            match wgsl_find_attr(fld.attrs, "location") {
              Some(la) =>
              if la.args.length() == 1 {
                ctx.sb.write_string("layout(location = ")
                ctx.sb.write_string(la.args[0])
                ctx.sb.write_string(") out ")
                glsl_emit_type(ctx.sb, fld.ty, ctx.aliases)
                match target_info.stage {
                  EntryStage::Vertex => {
                    ctx.sb.write_string(" _vs_out_")
                    ctx.sb.write_string(fld.name)
                  }
                  _ => {
                    ctx.sb.write_string(" _fs_out_")
                    ctx.sb.write_string(la.args[0])
                  }
                }
                ctx.sb.write_string(";\n")
              }
              None => ()
            }
            sfi = sfi + 1
          }
        }
        None => ()
      }
      _ =>
      match target_info.stage {
        EntryStage::Fragment => {
          let loc = match wgsl_find_attr(target_func.ret_attrs, "location") {
            Some(la) => if la.args.length() > 0 { la.args[0] } else { "0" }
            None => "0"
          }
          ctx.sb.write_string("layout(location = ")
          ctx.sb.write_string(loc)
          ctx.sb.write_string(") out ")
          glsl_emit_type(ctx.sb, rt, ctx.aliases)
          ctx.sb.write_string(" _fs_out_")
          ctx.sb.write_string(loc)
          ctx.sb.write_string(";\n")
        }
        _ => ()
      }
    }
    None => ()
  }
  ctx.sb.write_string("\n")

  // Emit non-entry helper functions
  fi = 0
  while fi < module_ast.funcs.length() {
    let f = module_ast.funcs[fi]
    let is_entry = wgsl_has_attr(f.attrs, "vertex") ||
    wgsl_has_attr(f.attrs, "fragment") ||
    wgsl_has_attr(f.attrs, "compute")
    if !is_entry {
      match f.ret_ty {
        Some(rt) => glsl_emit_type(ctx.sb, rt, ctx.aliases)
        None => ctx.sb.write_string("void")
      }
      ctx.sb.write_string(" ")
      ctx.sb.write_string(f.name)
      ctx.sb.write_string("(")
      let mut hpi = 0
      while hpi < f.params.length() {
        if hpi > 0 {
          ctx.sb.write_string(", ")
        }
        match f.params[hpi].ty {
          WgslType::Ptr(_, elem, _) => {
            ctx.sb.write_string("inout ")
            glsl_emit_type(ctx.sb, elem, ctx.aliases)
          }
          _ => glsl_emit_type(ctx.sb, f.params[hpi].ty, ctx.aliases)
        }
        ctx.sb.write_string(" ")
        ctx.sb.write_string(f.params[hpi].name)
        hpi = hpi + 1
      }
      ctx.sb.write_string(") {\n")
      ctx.in_entry = false
      ctx.indent = 1
      ctx.emit_stmts(f.body)
      ctx.indent = 0
      ctx.sb.write_string("}\n\n")
    }
    fi = fi + 1
  }

  // Emit target entry point as `void main()`
  ctx.sb.write_string("void main() {\n")
  ctx.in_entry = true
  ctx.indent = 1

  // Reconstruct struct stage_in params if any
  pi = 0
  while pi < target_func.params.length() {
    let p = target_func.params[pi]
    if !wgsl_has_attr(p.attrs, "builtin") && !wgsl_has_attr(p.attrs, "location") {
      match p.ty {
        WgslType::Named(sn) =>
        match ctx.structs.get(sn) {
          Some(st) => {
            ctx.emit_indent()
            ctx.sb.write_string(sn)
            ctx.sb.write_string(" ")
            ctx.sb.write_string(p.name)
            ctx.sb.write_string(";\n")
            let mut sfi = 0
            while sfi < st.fields.length() {
              let fld = st.fields[sfi]
              ctx.emit_indent()
              ctx.sb.write_string(p.name)
              ctx.sb.write_string(".")
              ctx.sb.write_string(fld.name)
              ctx.sb.write_string(" = ")
              match wgsl_find_attr(fld.attrs, "builtin") {
                Some(ba) =>
                if ba.args.length() == 1 {
                  ctx.sb.write_string(glsl_builtin_var(ba.args[0]))
                }
                None => {
                  ctx.sb.write_string("_in_")
                  ctx.sb.write_string(fld.name)
                }
              }
              ctx.sb.write_string(";\n")
              sfi = sfi + 1
            }
          }
          None => ()
        }
        _ => ()
      }
    }
    pi = pi + 1
  }

  ctx.emit_stmts(target_func.body)
  ctx.indent = 0
  ctx.in_entry = false
  ctx.sb.write_string("}\n")

  Ok(CompiledModule::{ source: ctx.sb.to_string(), reflection: reflection })
}
