///| Pure-Pion WGSL -> GLSL ES 3.00 (vertex/fragment) & GLSL 450 (compute) backend.
///| Features full scope-tracked type inference, ES 3.00 varying name alignment,
///| GLSL keyword/macro/Unicode escaping, zero-initialization, hex-float conversion,
///| WGSL `loop`/`continuing` lowering, pointer-let aliasing, and stage-reachable emission.

fn glsl_scalar(s : String) -> String {
  if s == "f32" || s == "f16" {
    "float"
  } else if s == "i32" {
    "int"
  } else if s == "u32" {
    "uint"
  } else if s == "bool" {
    "bool"
  } else {
    s
  }
}

fn glsl_vec_prefix(elem : String) -> String {
  if elem == "i32" {
    "i"
  } else if elem == "u32" {
    "u"
  } else if elem == "bool" {
    "b"
  } else {
    ""
  }
}

fn glsl_is_reserved_ident(name : String) -> Bool {
  name == "in" || name == "out" || name == "inout" || name == "uniform" ||
  name == "buffer" || name == "shared" || name == "attribute" || name == "varying" ||
  name == "layout" || name == "centroid" || name == "flat" || name == "smooth" ||
  name == "noperspective" || name == "patch" || name == "sample" || name == "subroutine" ||
  name == "coherent" || name == "volatile" || name == "restrict" || name == "readonly" ||
  name == "writeonly" || name == "invariant" || name == "precise" || name == "precision" ||
  name == "lowp" || name == "mediump" || name == "highp" || name == "common" ||
  name == "partition" || name == "active" || name == "asm" || name == "class" ||
  name == "union" || name == "enum" || name == "typedef" || name == "template" ||
  name == "this" || name == "resource" || name == "goto" || name == "inline" ||
  name == "noinline" || name == "public" || name == "static" || name == "extern" ||
  name == "external" || name == "interface" || name == "long" || name == "short" ||
  name == "double" || name == "half" || name == "fixed" || name == "unsigned" ||
  name == "superp" || name == "input" || name == "output" || name == "filter" ||
  name == "sizeof" || name == "cast" || name == "namespace" || name == "using" ||
  name == "main" || name == "float" || name == "int" || name == "uint" || name == "bool" ||
  name == "void" || name == "vec2" || name == "vec3" || name == "vec4" ||
  name == "ivec2" || name == "ivec3" || name == "ivec4" || name == "uvec2" ||
  name == "uvec3" || name == "uvec4" || name == "bvec2" || name == "bvec3" ||
  name == "bvec4" || name == "mat2" || name == "mat3" || name == "mat4" ||
  name == "GL_ES" || name == "M_PI_F" || name == "FLT_MAX" || name == "INFINITY" ||
  name == "NAN" || name == "NULL"
}

fn glsl_ident(name : String) -> String {
  let mut has_non_ascii = false
  let mut i = 0
  while i < name.length() {
    if name.code_unit_at(i) >= 128 {
      has_non_ascii = true
      break
    }
    i = i + 1
  }
  if has_non_ascii {
    let sb = StringBuilder::new()
    sb.write_string("_u_")
    i = 0
    while i < name.length() {
      let b = name.code_unit_at(i)
      if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) {
        sb.write_string(name.slice(i, i + 1))
      } else {
        sb.write_string("_")
        sb.write_string(msl_hex_digit((b >> 4) & 15))
        sb.write_string(msl_hex_digit(b & 15))
      }
      i = i + 1
    }
    return sb.to_string()
  }
  if glsl_is_reserved_ident(name) {
    "_g_" + name
  } else {
    name
  }
}

fn glsl_is_int_type(ty : WgslType, aliases : Map[String, WgslType]) -> Bool {
  let r = wgsl_resolve_alias_depth(ty, aliases, 0)
  match r {
    WgslType::Scalar(s) => s == "i32" || s == "u32"
    WgslType::Vec(_, e) => e == "i32" || e == "u32"
    _ => false
  }
}

fn glsl_emit_type(sb : StringBuilder, ty : WgslType, aliases : Map[String, WgslType]) -> Unit {
  match ty {
    WgslType::Scalar(s) => sb.write_string(glsl_scalar(s))
    WgslType::Vec(d, e) => {
      sb.write_string(glsl_vec_prefix(e))
      sb.write_string("vec")
      sb.write_string(d.to_string())
    }
    WgslType::Mat(c, r, _) =>
    if c == r {
      sb.write_string("mat")
      sb.write_string(c.to_string())
    } else {
      sb.write_string("mat")
      sb.write_string(c.to_string())
      sb.write_string("x")
      sb.write_string(r.to_string())
    }
    WgslType::Array(elem, len, len_ident) => {
      glsl_emit_type(sb, elem, aliases)
      sb.write_string("[")
      if len > 0 {
        sb.write_string(len.to_string())
      } else if len_ident.length() > 0 {
        sb.write_string(glsl_ident(len_ident))
      }
      sb.write_string("]")
    }
    WgslType::Texture(kind, elem, _) => {
      let pref = if elem == "i32" { "i" } else if elem == "u32" { "u" } else { "" }
      if kind == "texture_1d" {
        sb.write_string(pref + "sampler1D")
      } else if kind == "texture_2d" {
        sb.write_string(pref + "sampler2D")
      } else if kind == "texture_2d_array" {
        sb.write_string(pref + "sampler2DArray")
      } else if kind == "texture_3d" {
        sb.write_string(pref + "sampler3D")
      } else if kind == "texture_cube" {
        sb.write_string(pref + "samplerCube")
      } else if kind == "texture_cube_array" {
        sb.write_string(pref + "samplerCubeArray")
      } else if kind == "texture_depth_2d" {
        sb.write_string("sampler2DShadow")
      } else if kind == "texture_depth_2d_array" {
        sb.write_string("sampler2DArrayShadow")
      } else if kind == "texture_depth_cube" {
        sb.write_string("samplerCubeShadow")
      } else if kind == "texture_storage_2d" {
        sb.write_string("image2D")
      } else if kind == "texture_storage_3d" {
        sb.write_string("image3D")
      } else {
        sb.write_string("sampler2D")
      }
    }
    WgslType::Sampler(_) => sb.write_string("sampler")
    WgslType::Atomic(e) => sb.write_string(glsl_scalar(e))
    WgslType::Named(n) =>
    match aliases.get(n) {
      Some(resolved) => glsl_emit_type(sb, resolved, aliases)
      None => sb.write_string(glsl_ident(n))
    }
    WgslType::Ptr(_, elem, _) => glsl_emit_type(sb, elem, aliases)
  }
}

fn glsl_emit_sem_type(sb : StringBuilder, st : SemType, aliases : Map[String, WgslType]) -> Unit {
  match st {
    SemType::ModfRes(_) => sb.write_string("_wgsl_modf_f32")
    SemType::FrexpRes(_) => sb.write_string("_wgsl_frexp_f32")
    SemType::AtomicCmpExchRes(e) =>
    if e == "i32" {
      sb.write_string("_wgsl_cas_i32")
    } else {
      sb.write_string("_wgsl_cas_u32")
    }
    _ => glsl_emit_type(sb, sem_to_wgsl_type(st), aliases)
  }
}

fn glsl_emit_zero_init(
  sb : StringBuilder,
  ty : WgslType,
  structs : Map[String, WgslStructDecl],
  aliases : Map[String, WgslType],
  const_ints : Map[String, Int64],
  depth : Int,
) -> Unit {
  if depth > 16 {
    sb.write_string("0")
    return
  }
  let r = wgsl_resolve_alias_depth(ty, aliases, 0)
  match r {
    WgslType::Scalar(s) =>
    if s == "f32" || s == "f16" {
      sb.write_string("0.0")
    } else if s == "u32" {
      sb.write_string("0u")
    } else if s == "bool" {
      sb.write_string("false")
    } else {
      sb.write_string("0")
    }
    WgslType::Vec(d, e) => {
      sb.write_string(glsl_vec_prefix(e))
      sb.write_string("vec")
      sb.write_string(d.to_string())
      sb.write_string("(")
      glsl_emit_zero_init(sb, WgslType::Scalar(e), structs, aliases, const_ints, depth + 1)
      sb.write_string(")")
    }
    WgslType::Mat(c, rows, _) => {
      if c == rows {
        sb.write_string("mat")
        sb.write_string(c.to_string())
      } else {
        sb.write_string("mat")
        sb.write_string(c.to_string())
        sb.write_string("x")
        sb.write_string(rows.to_string())
      }
      sb.write_string("(0.0)")
    }
    WgslType::Atomic(e) =>
    if e == "u32" { sb.write_string("0u") } else { sb.write_string("0") }
    WgslType::Array(elem, len, len_ident) => {
      let n = if len > 0 {
        len
      } else if len_ident.length() > 0 {
        match const_ints.get(len_ident) {
          Some(v) => v.to_int()
          None => 0
        }
      } else {
        0
      }
      glsl_emit_type(sb, elem, aliases)
      sb.write_string("[")
      sb.write_string(n.to_string())
      sb.write_string("](")
      let mut i = 0
      while i < n {
        if i > 0 {
          sb.write_string(", ")
        }
        glsl_emit_zero_init(sb, elem, structs, aliases, const_ints, depth + 1)
        i = i + 1
      }
      sb.write_string(")")
    }
    WgslType::Named(sn) =>
    match structs.get(sn) {
      Some(st) => {
        sb.write_string(glsl_ident(sn))
        sb.write_string("(")
        let mut fi = 0
        while fi < st.fields.length() {
          if fi > 0 {
            sb.write_string(", ")
          }
          glsl_emit_zero_init(sb, st.fields[fi].ty, structs, aliases, const_ints, depth + 1)
          fi = fi + 1
        }
        sb.write_string(")")
      }
      None => sb.write_string("0")
    }
    _ => sb.write_string("0")
  }
}

fn glsl_builtin_var(name : String, stage : EntryStage) -> String {
  if name == "vertex_index" {
    "uint(gl_VertexID)"
  } else if name == "instance_index" {
    "uint(gl_InstanceID)"
  } else if name == "position" {
    match stage {
      EntryStage::Fragment => "gl_FragCoord"
      _ => "gl_Position"
    }
  } else if name == "front_facing" {
    "gl_FrontFacing"
  } else if name == "frag_depth" {
    "gl_FragDepth"
  } else if name == "sample_index" {
    "uint(gl_SampleID)"
  } else if name == "global_invocation_id" {
    "gl_GlobalInvocationID"
  } else if name == "local_invocation_id" {
    "gl_LocalInvocationID"
  } else if name == "workgroup_id" {
    "gl_WorkGroupID"
  } else if name == "local_invocation_index" {
    "gl_LocalInvocationIndex"
  } else if name == "num_workgroups" {
    "gl_NumWorkGroups"
  } else {
    name
  }
}

fn glsl_hex_float_to_dec(s : String) -> String {
  let n = s.length()
  let mut end = n
  if end > 0 && (s.code_unit_at(end - 1) == 102 || s.code_unit_at(end - 1) == 104) {
    end = end - 1
  }
  let mut i = 2 // skip 0x / 0X
  let mut mant : Double = 0.0
  let mut frac_scale : Double = 1.0
  let mut in_frac = false
  while i < end {
    let c = s.code_unit_at(i)
    if c == 112 || c == 80 {
      i = i + 1
      break
    }
    if c == 46 {
      in_frac = true
      i = i + 1
      continue
    }
    let d = if c >= 48 && c <= 57 {
      c - 48
    } else if c >= 65 && c <= 70 {
      c - 55
    } else if c >= 97 && c <= 102 {
      c - 87
    } else {
      0
    }
    if !in_frac {
      mant = mant * 16.0 + d.to_double()
    } else {
      frac_scale = frac_scale * 16.0
      mant = mant + d.to_double() / frac_scale
    }
    i = i + 1
  }
  let mut exp_neg = false
  let mut exp_v = 0
  if i < end && (s.code_unit_at(i) == 43 || s.code_unit_at(i) == 45) {
    if s.code_unit_at(i) == 45 {
      exp_neg = true
    }
    i = i + 1
  }
  while i < end {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      exp_v = exp_v * 10 + (c - 48)
    }
    i = i + 1
  }
  if exp_neg {
    let mut k = 0
    while k < exp_v && k < 150 {
      mant = mant * 0.5
      k = k + 1
    }
  } else {
    let mut k = 0
    while k < exp_v && k < 150 {
      mant = mant * 2.0
      k = k + 1
    }
  }
  let res = mant.to_string()
  let mut has_dot = false
  let mut j = 0
  while j < res.length() {
    let c = res.code_unit_at(j)
    if c == 46 || c == 101 || c == 69 {
      has_dot = true
      break
    }
    j = j + 1
  }
  if has_dot { res } else { res + ".0" }
}

struct GlslCtx {
  sb : StringBuilder
  aliases : Map[String, WgslType]
  structs : Map[String, WgslStructDecl]
  funcs : Map[String, WgslFuncDecl]
  const_ints : Map[String, Int64]
  builtin_remap : Map[String, String]
  scalar_uniforms : Map[String, Bool]
  scopes : Array[Map[String, SemType]]
  ptr_aliases : Array[Map[String, WgslExpr]]
  mut indent : Int
  mut in_entry : Bool
  mut entry_stage : EntryStage
  mut entry_ret_struct : String
  mut entry_ret_loc : String
  mut entry_ret_builtin : String
  mut loop_counter : Int
}

fn GlslCtx::lookup_type(self : GlslCtx, name : String) -> Option[SemType] {
  let mut i = self.scopes.length() - 1
  while i >= 0 {
    match self.scopes[i].get(name) {
      Some(t) => return Some(t)
      None => ()
    }
    i = i - 1
  }
  None
}

fn GlslCtx::is_body_shadowed(self : GlslCtx, name : String) -> Bool {
  let mut i = self.scopes.length() - 1
  while i >= 2 {
    match self.scopes[i].get(name) {
      Some(_) => return true
      None => ()
    }
    i = i - 1
  }
  false
}

fn GlslCtx::is_local_shadowed(self : GlslCtx, name : String) -> Bool {
  let mut i = self.scopes.length() - 1
  while i >= 1 {
    match self.scopes[i].get(name) {
      Some(_) => return true
      None => ()
    }
    i = i - 1
  }
  false
}

fn GlslCtx::define_type(self : GlslCtx, name : String, ty : SemType) -> Unit {
  if self.scopes.length() > 0 {
    self.scopes[self.scopes.length() - 1].set(name, ty)
  }
}

fn GlslCtx::lookup_ptr_alias(self : GlslCtx, name : String) -> Option[WgslExpr] {
  let mut i = self.ptr_aliases.length() - 1
  while i >= 0 {
    match self.ptr_aliases[i].get(name) {
      Some(e) => return Some(e)
      None => ()
    }
    i = i - 1
  }
  None
}

fn GlslCtx::define_ptr_alias(self : GlslCtx, name : String, target : WgslExpr) -> Unit {
  if self.ptr_aliases.length() > 0 {
    self.ptr_aliases[self.ptr_aliases.length() - 1].set(name, target)
  }
}

fn GlslCtx::push_scope(self : GlslCtx) -> Unit {
  self.scopes.push(Map::new())
  self.ptr_aliases.push(Map::new())
}

fn GlslCtx::pop_scope(self : GlslCtx) -> Unit {
  if self.scopes.length() > 1 {
    let _ = self.scopes.pop()
  }
  if self.ptr_aliases.length() > 1 {
    let _ = self.ptr_aliases.pop()
  }
}

fn GlslCtx::infer_expr_type(self : GlslCtx, expr : WgslExpr) -> SemType {
  match expr {
    WgslExpr::Ident(name, _, _) =>
    match self.lookup_type(name) {
      Some(t) => t
      None => SemType::Scalar("f32")
    }
    WgslExpr::IntLit(s, _, _) => {
      let n = s.length()
      if n > 0 && s.code_unit_at(n - 1) == 117 {
        SemType::Scalar("u32")
      } else if n > 0 && s.code_unit_at(n - 1) == 105 {
        SemType::Scalar("i32")
      } else {
        SemType::AbstractInt
      }
    }
    WgslExpr::FloatLit(_, _, _) => SemType::Scalar("f32")
    WgslExpr::BoolLit(_, _, _) => SemType::Scalar("bool")
    WgslExpr::Paren(inner, _, _) => self.infer_expr_type(inner)
    WgslExpr::Unary(op, inner, _, _) => {
      let it = self.infer_expr_type(inner)
      if op == "&" {
        SemType::Ptr("function", it, "read_write")
      } else if op == "*" {
        match it {
          SemType::Ptr(_, elem, _) => elem
          _ => it
        }
      } else {
        it
      }
    }
    WgslExpr::Binary(op, l, r, _, _) => {
      let lt = self.infer_expr_type(l)
      let rt = self.infer_expr_type(r)
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        match (lt, rt) {
          (SemType::Vec(d, _), _) | (_, SemType::Vec(d, _)) => return SemType::Vec(d, "bool")
          _ => return SemType::Scalar("bool")
        }
      }
      if op == "&&" || op == "||" {
        return SemType::Scalar("bool")
      }
      match (lt, rt) {
        (SemType::Mat(_, rows, e), SemType::Vec(_, _)) => SemType::Vec(rows, e)
        (SemType::Vec(_, _), SemType::Mat(cols, _, e)) => SemType::Vec(cols, e)
        (SemType::Mat(_, r1, e), SemType::Mat(c2, _, _)) => SemType::Mat(c2, r1, e)
        (SemType::Vec(d, e1), SemType::Vec(_, e2)) => SemType::Vec(d, sem_promote_scalar(e1, e2))
        (SemType::Vec(d, e1), _) => SemType::Vec(d, sem_promote_scalar(e1, sem_scalar_name(rt)))
        (_, SemType::Vec(d, e2)) => SemType::Vec(d, sem_promote_scalar(sem_scalar_name(lt), e2))
        (SemType::AbstractInt, _) => rt
        (_, SemType::AbstractInt) => lt
        _ => lt
      }
    }
    WgslExpr::Index(base, _, _, _) => {
      let bt = self.infer_expr_type(base)
      let unptr = match bt {
        SemType::Ptr(_, elem, _) => elem
        _ => bt
      }
      match unptr {
        SemType::Array(elem, _) => elem
        SemType::Vec(_, e) => SemType::Scalar(e)
        SemType::Mat(_, r, e) => SemType::Vec(r, e)
        _ => SemType::Scalar("f32")
      }
    }
    WgslExpr::Field(base, fld, _, _) => {
      let bt = self.infer_expr_type(base)
      let unptr = match bt {
        SemType::Ptr(_, elem, _) => elem
        _ => bt
      }
      match unptr {
        SemType::Struct(sn) =>
        match self.structs.get(sn) {
          Some(st) => {
            let mut fi = 0
            while fi < st.fields.length() {
              if st.fields[fi].name == fld {
                return wgsl_type_to_sem(st.fields[fi].ty, self.aliases, self.const_ints)
              }
              fi = fi + 1
            }
            SemType::Scalar("f32")
          }
          None => SemType::Scalar("f32")
        }
        SemType::Vec(_, e) =>
        if fld.length() == 1 { SemType::Scalar(e) } else { SemType::Vec(fld.length(), e) }
        SemType::ModfRes(t) => t
        SemType::FrexpRes(t) => if fld == "exp" { SemType::Scalar("i32") } else { t }
        SemType::AtomicCmpExchRes(e) =>
        if fld == "exchanged" { SemType::Scalar("bool") } else { SemType::Scalar(e) }
        _ => SemType::Scalar("f32")
      }
    }
    WgslExpr::Call(name, targs, arr_len, len_ident, args, _, _) => {
      match self.funcs.get(name) {
        Some(f) =>
        match f.ret_ty {
          Some(rt) => return wgsl_type_to_sem(rt, self.aliases, self.const_ints)
          None => return SemType::Void
        }
        None => ()
      }
      match self.structs.get(name) {
        Some(_) => return SemType::Struct(name)
        None => ()
      }
      if name == "f32" || name == "f16" || name == "i32" || name == "u32" || name == "bool" {
        return SemType::Scalar(name)
      }
      if name == "bitcast" && targs.length() == 1 {
        return wgsl_type_to_sem(targs[0], self.aliases, self.const_ints)
      }
      if name == "array" && targs.length() == 1 {
        let n = if arr_len > 0 { arr_len } else if len_ident.length() > 0 {
          match self.const_ints.get(len_ident) { Some(v) => v.to_int(); None => args.length() }
        } else { args.length() }
        return SemType::Array(wgsl_type_to_sem(targs[0], self.aliases, self.const_ints), n)
      }
      if (name == "vec2" || name == "vec3" || name == "vec4") && targs.length() == 1 {
        let dim = name.code_unit_at(3) - 48
        match wgsl_type_to_sem(targs[0], self.aliases, self.const_ints) {
          SemType::Scalar(s) => return SemType::Vec(dim, s)
          _ => return SemType::Vec(dim, "f32")
        }
      }
      if (name == "mat2x2" || name == "mat3x3" || name == "mat4x4" ||
        name == "mat2x3" || name == "mat2x4" || name == "mat3x2" ||
        name == "mat3x4" || name == "mat4x2" || name == "mat4x3") && targs.length() == 1 {
        let cols = name.code_unit_at(3) - 48
        let rows = name.code_unit_at(5) - 48
        return SemType::Mat(cols, rows, "f32")
      }
      match wgsl_resolve_vec_alias(name) {
        Some(vt) => return wgsl_type_to_sem(vt, self.aliases, self.const_ints)
        None => ()
      }
      if name == "modf" && args.length() == 1 {
        return SemType::ModfRes(sem_concretize(self.infer_expr_type(args[0])))
      }
      if name == "frexp" && args.length() == 1 {
        return SemType::FrexpRes(sem_concretize(self.infer_expr_type(args[0])))
      }
      if name == "atomicCompareExchangeWeak" && args.length() >= 1 {
        let e = match self.infer_expr_type(args[0]) {
          SemType::Ptr(_, SemType::Atomic(s), _) => s
          _ => "u32"
        }
        return SemType::AtomicCmpExchRes(e)
      }
      if name == "atomicLoad" || name == "atomicAdd" || name == "atomicSub" ||
      name == "atomicMax" || name == "atomicMin" || name == "atomicAnd" ||
      name == "atomicOr" || name == "atomicXor" || name == "atomicExchange" {
        if args.length() >= 1 {
          match self.infer_expr_type(args[0]) {
            SemType::Ptr(_, SemType::Atomic(s), _) => return SemType::Scalar(s)
            _ => return SemType::Scalar("u32")
          }
        }
        return SemType::Scalar("u32")
      }
      if name == "arrayLength" || name == "textureNumLevels" || name == "textureNumLayers" ||
      name == "textureNumSamples" || name == "pack2x16float" || name == "pack4x8unorm" ||
      name == "pack4x8snorm" || name == "pack2x16unorm" || name == "pack2x16snorm" {
        return SemType::Scalar("u32")
      }
      if name == "unpack2x16float" || name == "unpack2x16unorm" || name == "unpack2x16snorm" {
        return SemType::Vec(2, "f32")
      }
      if name == "unpack4x8unorm" || name == "unpack4x8snorm" {
        return SemType::Vec(4, "f32")
      }
      if name == "textureDimensions" && args.length() >= 1 {
        match self.infer_expr_type(args[0]) {
          SemType::Texture(tk, _, _) =>
          if tk == "texture_1d" || tk == "texture_storage_1d" {
            return SemType::Scalar("u32")
          } else if tk == "texture_3d" || tk == "texture_storage_3d" {
            return SemType::Vec(3, "u32")
          } else {
            return SemType::Vec(2, "u32")
          }
          _ => return SemType::Vec(2, "u32")
        }
      }
      if name == "textureSampleCompare" || name == "textureSampleCompareLevel" {
        return SemType::Scalar("f32")
      }
      if name == "textureSample" || name == "textureSampleLevel" || name == "textureSampleBias" ||
      name == "textureSampleGrad" || name == "textureLoad" || name == "textureGather" {
        return SemType::Vec(4, "f32")
      }
      if name == "dot" || name == "length" || name == "distance" || name == "determinant" {
        return SemType::Scalar("f32")
      }
      if name == "transpose" && args.length() == 1 {
        match self.infer_expr_type(args[0]) {
          SemType::Mat(c, r, e) => return SemType::Mat(r, c, e)
          other => return other
        }
      }
      if name == "all" || name == "any" {
        return SemType::Scalar("bool")
      }
      if args.length() > 0 {
        sem_concretize(self.infer_expr_type(args[0]))
      } else {
        SemType::Scalar("f32")
      }
    }
  }
}

fn GlslCtx::emit_indent(self : GlslCtx) -> Unit {
  let mut i = 0
  while i < self.indent {
    self.sb.write_string("  ")
    i = i + 1
  }
}

fn glsl_emit_int_lit(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  if n > 1 && s.code_unit_at(n - 1) == 105 {
    sb.write_string(s.slice(0, n - 1))
  } else {
    sb.write_string(s)
  }
}

fn glsl_emit_float_lit(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  if n == 0 {
    return
  }
  if n >= 2 && s.code_unit_at(0) == 48 && (s.code_unit_at(1) == 120 || s.code_unit_at(1) == 88) {
    sb.write_string(glsl_hex_float_to_dec(s))
    return
  }
  let last = s.code_unit_at(n - 1)
  let body = if last == 102 || last == 104 { s.slice(0, n - 1) } else { s }
  let mut has_dot_or_exp = false
  let mut i = 0
  while i < body.length() {
    let c = body.code_unit_at(i)
    if c == 46 || c == 101 || c == 69 {
      has_dot_or_exp = true
      break
    }
    i = i + 1
  }
  sb.write_string(body)
  if !has_dot_or_exp {
    sb.write_string(".0")
  }
}

fn GlslCtx::emit_arg_list(self : GlslCtx, args : Array[WgslExpr]) -> Unit {
  let mut i = 0
  while i < args.length() {
    if i > 0 {
      self.sb.write_string(", ")
    }
    self.emit_expr(args[i])
    i = i + 1
  }
}

fn glsl_remap_builtin(name : String) -> String {
  if name == "inverseSqrt" {
    "inversesqrt"
  } else if name == "round" {
    "roundEven"
  } else if name == "faceForward" {
    "faceforward"
  } else if name == "atan2" {
    "atan"
  } else if name == "dpdx" || name == "dpdxCoarse" || name == "dpdxFine" {
    "dFdx"
  } else if name == "dpdy" || name == "dpdyCoarse" || name == "dpdyFine" {
    "dFdy"
  } else if name == "fwidthCoarse" || name == "fwidthFine" {
    "fwidth"
  } else if name == "countOneBits" {
    "bitCount"
  } else if name == "reverseBits" {
    "bitfieldReverse"
  } else if name == "pack2x16float" {
    "packHalf2x16"
  } else if name == "unpack2x16float" {
    "unpackHalf2x16"
  } else if name == "pack4x8unorm" {
    "packUnorm4x8"
  } else if name == "unpack4x8unorm" {
    "unpackUnorm4x8"
  } else if name == "pack4x8snorm" {
    "packSnorm4x8"
  } else if name == "unpack4x8snorm" {
    "unpackSnorm4x8"
  } else if name == "pack2x16unorm" {
    "packUnorm2x16"
  } else if name == "unpack2x16unorm" {
    "unpackUnorm2x16"
  } else if name == "pack2x16snorm" {
    "packSnorm2x16"
  } else if name == "unpack2x16snorm" {
    "unpackSnorm2x16"
  } else {
    name
  }
}

fn GlslCtx::emit_expr(self : GlslCtx, expr : WgslExpr) -> Unit {
  match expr {
    WgslExpr::Ident(name, _, _) => {
      match self.lookup_ptr_alias(name) {
        Some(target) => {
          self.emit_expr(target)
          return
        }
        None => ()
      }
      if self.in_entry && !self.is_body_shadowed(name) {
        match self.builtin_remap.get(name) {
          Some(mapped) => {
            self.sb.write_string(mapped)
            return
          }
          None => ()
        }
      }
      if !self.is_local_shadowed(name) {
        match self.scalar_uniforms.get(name) {
          Some(true) => {
            self.sb.write_string(glsl_ident(name))
            self.sb.write_string(".value")
            return
          }
          _ => ()
        }
      }
      self.sb.write_string(glsl_ident(name))
    }
    WgslExpr::IntLit(s, _, _) => glsl_emit_int_lit(self.sb, s)
    WgslExpr::FloatLit(s, _, _) => glsl_emit_float_lit(self.sb, s)
    WgslExpr::BoolLit(b, _, _) => self.sb.write_string(if b { "true" } else { "false" })
    WgslExpr::Paren(inner, _, _) => {
      self.sb.write_string("(")
      self.emit_expr(inner)
      self.sb.write_string(")")
    }
    WgslExpr::Unary(op, inner, _, _) =>
    if op == "&" || op == "*" {
      self.emit_expr(inner)
    } else {
      match inner {
        WgslExpr::Unary(_, _, _, _) => {
          self.sb.write_string(op)
          self.sb.write_string("(")
          self.emit_expr(inner)
          self.sb.write_string(")")
        }
        _ => {
          self.sb.write_string(op)
          self.emit_expr(inner)
        }
      }
    }
    WgslExpr::Binary(op, l, r, _, _) => {
      let lt = self.infer_expr_type(l)
      let rt = self.infer_expr_type(r)
      if op == "%" && (sem_is_float_type(lt) || sem_is_float_type(rt)) {
        self.sb.write_string("((")
        self.emit_expr(l)
        self.sb.write_string(") - (")
        self.emit_expr(r)
        self.sb.write_string(") * trunc((")
        self.emit_expr(l)
        self.sb.write_string(") / (")
        self.emit_expr(r)
        self.sb.write_string(")))")
        return
      }
      // Coerce abstract int literal to float when paired with float
      let l_is_float = sem_is_float_type(lt)
      let r_is_float = sem_is_float_type(rt)
      if r_is_float && (match lt { SemType::AbstractInt => true; _ => false }) {
        self.sb.write_string("float(")
        self.emit_expr(l)
        self.sb.write_string(")")
      } else {
        self.emit_expr(l)
      }
      self.sb.write_string(" ")
      self.sb.write_string(op)
      self.sb.write_string(" ")
      if l_is_float && (match rt { SemType::AbstractInt => true; _ => false }) {
        self.sb.write_string("float(")
        self.emit_expr(r)
        self.sb.write_string(")")
      } else {
        self.emit_expr(r)
      }
    }
    WgslExpr::Index(base, idx, _, _) => {
      self.emit_expr(base)
      self.sb.write_string("[")
      self.emit_expr(idx)
      self.sb.write_string("]")
    }
    WgslExpr::Field(base, fld, _, _) => {
      self.emit_expr(base)
      self.sb.write_string(".")
      let bt = self.infer_expr_type(base)
      let unptr = match bt {
        SemType::Ptr(_, elem, _) => elem
        _ => bt
      }
      match unptr {
        SemType::Struct(_) => self.sb.write_string(glsl_ident(fld))
        _ => self.sb.write_string(fld)
      }
    }
    WgslExpr::Call(name, targs, arr_len, len_ident, args, _, _) => {
      // WGSL `select(f, t, cond)`: vector cond -> `mix(f, t, cond)`, scalar cond -> `((cond) ? (t) : (f))`
      if name == "select" && args.length() == 3 {
        let ct = self.infer_expr_type(args[2])
        match ct {
          SemType::Vec(_, _) => {
            self.sb.write_string("mix(")
            self.emit_expr(args[0])
            self.sb.write_string(", ")
            self.emit_expr(args[1])
            self.sb.write_string(", ")
            self.emit_expr(args[2])
            self.sb.write_string(")")
          }
          _ => {
            self.sb.write_string("((")
            self.emit_expr(args[2])
            self.sb.write_string(") ? (")
            self.emit_expr(args[1])
            self.sb.write_string(") : (")
            self.emit_expr(args[0])
            self.sb.write_string("))")
          }
        }
        return
      }
      if name == "saturate" && args.length() == 1 {
        self.sb.write_string("clamp(")
        self.emit_expr(args[0])
        self.sb.write_string(", 0.0, 1.0)")
        return
      }
      if name == "fma" && args.length() == 3 {
        self.sb.write_string("((")
        self.emit_expr(args[0])
        self.sb.write_string(") * (")
        self.emit_expr(args[1])
        self.sb.write_string(") + (")
        self.emit_expr(args[2])
        self.sb.write_string("))")
        return
      }
      if name == "quantizeToF16" && args.length() == 1 {
        self.sb.write_string("unpackHalf2x16(packHalf2x16(vec2(")
        self.emit_expr(args[0])
        self.sb.write_string(", 0.0))).x")
        return
      }
      if name == "modf" && args.length() == 1 {
        self.sb.write_string("_wgsl_modf(")
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "frexp" && args.length() == 1 {
        self.sb.write_string("_wgsl_frexp(")
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "extractBits" && args.length() == 3 {
        self.sb.write_string("bitfieldExtract(")
        self.emit_expr(args[0])
        self.sb.write_string(", int(")
        self.emit_expr(args[1])
        self.sb.write_string("), int(")
        self.emit_expr(args[2])
        self.sb.write_string("))")
        return
      }
      if name == "insertBits" && args.length() == 4 {
        self.sb.write_string("bitfieldInsert(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", int(")
        self.emit_expr(args[2])
        self.sb.write_string("), int(")
        self.emit_expr(args[3])
        self.sb.write_string("))")
        return
      }
      if name == "firstLeadingBit" && args.length() == 1 {
        let is_u = match self.infer_expr_type(args[0]) { SemType::Scalar("u32") => true; _ => false }
        if is_u {
          self.sb.write_string("uint(findMSB(")
          self.emit_expr(args[0])
          self.sb.write_string("))")
        } else {
          self.sb.write_string("findMSB(")
          self.emit_expr(args[0])
          self.sb.write_string(")")
        }
        return
      }
      if name == "firstTrailingBit" && args.length() == 1 {
        let is_u = match self.infer_expr_type(args[0]) { SemType::Scalar("u32") => true; _ => false }
        if is_u {
          self.sb.write_string("uint(findLSB(")
          self.emit_expr(args[0])
          self.sb.write_string("))")
        } else {
          self.sb.write_string("findLSB(")
          self.emit_expr(args[0])
          self.sb.write_string(")")
        }
        return
      }
      if name == "countLeadingZeros" && args.length() == 1 {
        self.sb.write_string("_wgsl_clz(")
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "countTrailingZeros" && args.length() == 1 {
        self.sb.write_string("_wgsl_ctz(")
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "atomicLoad" && args.length() == 1 {
        let is_i = match self.infer_expr_type(args[0]) { SemType::Ptr(_, SemType::Atomic("i32"), _) => true; _ => false }
        self.sb.write_string("atomicOr(")
        self.emit_expr(args[0])
        self.sb.write_string(if is_i { ", 0)" } else { ", 0u)" })
        return
      }
      if name == "atomicStore" && args.length() == 2 {
        self.sb.write_string("atomicExchange(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(")")
        return
      }
      if name == "atomicSub" && args.length() == 2 {
        let is_i = match self.infer_expr_type(args[0]) { SemType::Ptr(_, SemType::Atomic("i32"), _) => true; _ => false }
        self.sb.write_string("atomicAdd(")
        self.emit_expr(args[0])
        if is_i {
          self.sb.write_string(", -(")
        } else {
          self.sb.write_string(", (0u - ")
        }
        self.emit_expr(args[1])
        self.sb.write_string("))")
        return
      }
      if name == "atomicCompareExchangeWeak" && args.length() == 3 {
        let is_i = match self.infer_expr_type(args[0]) { SemType::Ptr(_, SemType::Atomic("i32"), _) => true; _ => false }
        self.sb.write_string(if is_i { "_wgsl_cas_i32_res(" } else { "_wgsl_cas_u32_res(" })
        self.sb.write_string("atomicCompSwap(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[1])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string("), ")
        self.emit_expr(args[1])
        self.sb.write_string(")")
        return
      }
      if name == "textureSample" && args.length() >= 3 {
        self.sb.write_string("texture(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        if args.length() >= 4 {
          self.sb.write_string("vec3(")
          self.emit_expr(args[2])
          self.sb.write_string(", float(")
          self.emit_expr(args[3])
          self.sb.write_string("))")
        } else {
          self.emit_expr(args[2])
        }
        self.sb.write_string(")")
        return
      }
      if name == "textureSampleLevel" && args.length() >= 4 {
        self.sb.write_string("textureLod(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string(", ")
        self.emit_expr(args[3])
        self.sb.write_string(")")
        return
      }
      if name == "textureSampleBias" && args.length() >= 4 {
        self.sb.write_string("texture(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string(", ")
        self.emit_expr(args[3])
        self.sb.write_string(")")
        return
      }
      if name == "textureSampleGrad" && args.length() >= 5 {
        self.sb.write_string("textureGrad(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.emit_expr(args[2])
        self.sb.write_string(", ")
        self.emit_expr(args[3])
        self.sb.write_string(", ")
        self.emit_expr(args[4])
        self.sb.write_string(")")
        return
      }
      if (name == "textureSampleCompare" || name == "textureSampleCompareLevel") && args.length() >= 4 {
        self.sb.write_string("texture(")
        self.emit_expr(args[0])
        self.sb.write_string(", vec3(")
        self.emit_expr(args[2])
        self.sb.write_string(", ")
        self.emit_expr(args[3])
        self.sb.write_string("))")
        return
      }
      if name == "textureLoad" && args.length() >= 3 {
        let tk = match self.infer_expr_type(args[0]) { SemType::Texture(k, _, _) => k; _ => "texture_2d" }
        let cty = if tk == "texture_3d" { "ivec3" } else if tk == "texture_1d" { "int" } else { "ivec2" }
        self.sb.write_string("texelFetch(")
        self.emit_expr(args[0])
        self.sb.write_string(", ")
        self.sb.write_string(cty)
        self.sb.write_string("(")
        self.emit_expr(args[1])
        self.sb.write_string("), int(")
        self.emit_expr(args[2])
        self.sb.write_string("))")
        return
      }
      if name == "textureStore" && args.length() >= 3 {
        self.sb.write_string("imageStore(")
        self.emit_expr(args[0])
        self.sb.write_string(", ivec2(")
        self.emit_expr(args[1])
        self.sb.write_string("), ")
        self.emit_expr(args[2])
        self.sb.write_string(")")
        return
      }
      if name == "textureDimensions" && args.length() >= 1 {
        let tk = match self.infer_expr_type(args[0]) { SemType::Texture(k, _, _) => k; _ => "texture_2d" }
        if tk == "texture_3d" {
          self.sb.write_string("uvec3(textureSize(")
          self.emit_expr(args[0])
          self.sb.write_string(", 0))")
        } else if tk == "texture_1d" {
          self.sb.write_string("uint(textureSize(")
          self.emit_expr(args[0])
          self.sb.write_string(", 0))")
        } else {
          self.sb.write_string("uvec2(textureSize(")
          self.emit_expr(args[0])
          self.sb.write_string(", 0))")
        }
        return
      }
      if name == "arrayLength" && args.length() == 1 {
        self.sb.write_string("uint(")
        match args[0] {
          WgslExpr::Unary("&", e, _, _) => self.emit_expr(e)
          _ => self.emit_expr(args[0])
        }
        self.sb.write_string(".length())")
        return
      }
      if name == "workgroupBarrier" {
        self.sb.write_string("barrier()")
        return
      }
      if name == "storageBarrier" {
        self.sb.write_string("memoryBarrierBuffer()")
        return
      }
      if name == "textureBarrier" {
        self.sb.write_string("memoryBarrierImage()")
        return
      }
      if name == "bitcast" && targs.length() == 1 && args.length() == 1 {
        let dst_t = wgsl_type_to_sem(targs[0], self.aliases, self.const_ints)
        let src_t = sem_concretize(self.infer_expr_type(args[0]))
        let dst_sc = sem_scalar_name(dst_t)
        let src_sc = sem_scalar_name(src_t)
        if dst_sc == "f32" && src_sc == "u32" {
          self.sb.write_string("uintBitsToFloat(")
        } else if dst_sc == "f32" && src_sc == "i32" {
          self.sb.write_string("intBitsToFloat(")
        } else if dst_sc == "u32" && src_sc == "f32" {
          self.sb.write_string("floatBitsToUint(")
        } else if dst_sc == "i32" && src_sc == "f32" {
          self.sb.write_string("floatBitsToInt(")
        } else {
          glsl_emit_type(self.sb, targs[0], self.aliases)
          self.sb.write_string("(")
        }
        self.emit_expr(args[0])
        self.sb.write_string(")")
        return
      }
      if name == "array" && targs.length() == 1 {
        glsl_emit_type(self.sb, targs[0], self.aliases)
        self.sb.write_string("[")
        if arr_len > 0 {
          self.sb.write_string(arr_len.to_string())
        } else if len_ident.length() > 0 {
          self.sb.write_string(glsl_ident(len_ident))
        } else {
          self.sb.write_string(args.length().to_string())
        }
        self.sb.write_string("](")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      if (name == "vec2" || name == "vec3" || name == "vec4") && targs.length() == 1 {
        let dim = name.code_unit_at(3) - 48
        let pref = match targs[0] {
          WgslType::Scalar(s) => glsl_vec_prefix(s)
          _ => ""
        }
        self.sb.write_string(pref)
        self.sb.write_string("vec")
        self.sb.write_string(dim.to_string())
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      if (name == "mat2x2" || name == "mat3x3" || name == "mat4x4" ||
        name == "mat2x3" || name == "mat2x4" || name == "mat3x2" ||
        name == "mat3x4" || name == "mat4x2" || name == "mat4x3") && targs.length() == 1 {
        let cols = name.code_unit_at(3) - 48
        let rows = name.code_unit_at(5) - 48
        if cols == rows {
          self.sb.write_string("mat")
          self.sb.write_string(cols.to_string())
        } else {
          self.sb.write_string("mat")
          self.sb.write_string(cols.to_string())
          self.sb.write_string("x")
          self.sb.write_string(rows.to_string())
        }
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      if name == "f32" || name == "i32" || name == "u32" || name == "bool" || name == "f16" {
        self.sb.write_string(glsl_scalar(name))
        self.sb.write_string("(")
        self.emit_arg_list(args)
        self.sb.write_string(")")
        return
      }
      match wgsl_resolve_vec_alias(name) {
        Some(vt) => {
          glsl_emit_type(self.sb, vt, self.aliases)
          self.sb.write_string("(")
          self.emit_arg_list(args)
          self.sb.write_string(")")
          return
        }
        None => ()
      }
      match self.structs.get(name) {
        Some(_) => {
          self.sb.write_string(glsl_ident(name))
          self.sb.write_string("(")
          self.emit_arg_list(args)
          self.sb.write_string(")")
          return
        }
        None => ()
      }
      match self.funcs.get(name) {
        Some(_) => {
          self.sb.write_string(glsl_ident(name))
          self.sb.write_string("(")
          self.emit_arg_list(args)
          self.sb.write_string(")")
          return
        }
        None => ()
      }
      let fn_name = glsl_remap_builtin(name)
      self.sb.write_string(fn_name)
      self.sb.write_string("(")
      self.emit_arg_list(args)
      self.sb.write_string(")")
    }
  }
}

fn GlslCtx::emit_simple_stmt_inline(self : GlslCtx, s : WgslStmt) -> Unit {
  match s {
    WgslStmt::VarDecl(name, kind_s, ty, init, _, _) => {
      // Handle `let p = &target;` by aliasing `p` to `target` in GLSL (no pointers in GLSL)
      if kind_s == "let" {
        match init {
          Some(WgslExpr::Unary("&", target, _, _)) => {
            let var_sem = self.infer_expr_type(WgslExpr::Unary("&", target, 0, 0))
            self.define_type(name, var_sem)
            self.define_ptr_alias(name, target)
            return
          }
          _ => ()
        }
      }
      let var_sem = match ty {
        Some(t) => wgsl_type_to_sem(t, self.aliases, self.const_ints)
        None =>
        match init {
          Some(ex) => sem_concretize(self.infer_expr_type(ex))
          None => SemType::Scalar("f32")
        }
      }
      self.define_type(name, var_sem)
      if kind_s == "const" {
        self.sb.write_string("const ")
      }
      match ty {
        Some(t) => glsl_emit_type(self.sb, t, self.aliases)
        None => glsl_emit_sem_type(self.sb, var_sem, self.aliases)
      }
      self.sb.write_string(" ")
      self.sb.write_string(glsl_ident(name))
      match init {
        Some(ex) => {
          self.sb.write_string(" = ")
          self.emit_expr(ex)
        }
        None => {
          self.sb.write_string(" = ")
          let wt = match ty { Some(t) => t; None => sem_to_wgsl_type(var_sem) }
          glsl_emit_zero_init(self.sb, wt, self.structs, self.aliases, self.const_ints, 0)
        }
      }
    }
    WgslStmt::Assign(lhs, op, rhs, _, _) => {
      self.emit_expr(lhs)
      self.sb.write_string(" ")
      self.sb.write_string(op)
      self.sb.write_string(" ")
      self.emit_expr(rhs)
    }
    WgslStmt::PhonyAssign(rhs, _, _) => self.emit_expr(rhs)
    WgslStmt::IncDec(lhs, is_inc, _, _) => {
      self.emit_expr(lhs)
      self.sb.write_string(if is_inc { "++" } else { "--" })
    }
    WgslStmt::ExprStmt(ex, _, _) => self.emit_expr(ex)
    _ => ()
  }
}

fn GlslCtx::emit_stmts(self : GlslCtx, stmts : Array[WgslStmt]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    self.emit_stmt(stmts[i])
    i = i + 1
  }
}

fn GlslCtx::emit_stmt(self : GlslCtx, stmt : WgslStmt) -> Unit {
  match stmt {
    WgslStmt::VarDecl(name, kind_s, _, init, _, _) => {
      if kind_s == "let" {
        match init {
          Some(WgslExpr::Unary("&", target, _, _)) => {
            let var_sem = self.infer_expr_type(WgslExpr::Unary("&", target, 0, 0))
            self.define_type(name, var_sem)
            self.define_ptr_alias(name, target)
            return
          }
          _ => ()
        }
      }
      self.emit_indent()
      self.emit_simple_stmt_inline(stmt)
      self.sb.write_string(";\n")
    }
    WgslStmt::Assign(_, _, _, _, _)
    | WgslStmt::PhonyAssign(_, _, _)
    | WgslStmt::IncDec(_, _, _, _)
    | WgslStmt::ExprStmt(_, _, _) => {
      self.emit_indent()
      self.emit_simple_stmt_inline(stmt)
      self.sb.write_string(";\n")
    }
    WgslStmt::Return(opt_ex, _, _) => {
      self.emit_indent()
      if self.in_entry {
        match opt_ex {
          Some(ex) =>
          if self.entry_ret_struct.length() > 0 {
            self.sb.write_string(glsl_ident(self.entry_ret_struct))
            self.sb.write_string(" _ret = ")
            self.emit_expr(ex)
            self.sb.write_string(";\n")
            match self.structs.get(self.entry_ret_struct) {
              Some(st) => {
                let mut fi = 0
                while fi < st.fields.length() {
                  let fld = st.fields[fi]
                  self.emit_indent()
                  match wgsl_find_attr(fld.attrs, "builtin") {
                    Some(ba) =>
                    if ba.args.length() == 1 && ba.args[0] == "position" {
                      self.sb.write_string("gl_Position = _ret.")
                      self.sb.write_string(glsl_ident(fld.name))
                      self.sb.write_string(";\n")
                    } else if ba.args.length() == 1 && ba.args[0] == "frag_depth" {
                      self.sb.write_string("gl_FragDepth = _ret.")
                      self.sb.write_string(glsl_ident(fld.name))
                      self.sb.write_string(";\n")
                    }
                    None => {
                      let loc = match wgsl_find_attr(fld.attrs, "location") {
                        Some(la) => if la.args.length() > 0 { la.args[0] } else { "0" }
                        None => "0"
                      }
                      match self.entry_stage {
                        EntryStage::Vertex => {
                          self.sb.write_string("_wgsl_v_loc")
                          self.sb.write_string(loc)
                          self.sb.write_string(" = _ret.")
                          self.sb.write_string(glsl_ident(fld.name))
                          self.sb.write_string(";\n")
                        }
                        EntryStage::Fragment => {
                          self.sb.write_string("_fs_out_")
                          self.sb.write_string(loc)
                          self.sb.write_string(" = _ret.")
                          self.sb.write_string(glsl_ident(fld.name))
                          self.sb.write_string(";\n")
                        }
                        EntryStage::Compute => ()
                      }
                    }
                  }
                  fi = fi + 1
                }
              }
              None => ()
            }
            self.emit_indent()
            self.sb.write_string("return;\n")
          } else {
            match self.entry_stage {
              EntryStage::Vertex => {
                self.sb.write_string("gl_Position = ")
                self.emit_expr(ex)
                self.sb.write_string(";\n")
              }
              EntryStage::Fragment =>
              if self.entry_ret_builtin == "frag_depth" {
                self.sb.write_string("gl_FragDepth = ")
                self.emit_expr(ex)
                self.sb.write_string(";\n")
              } else {
                let loc = if self.entry_ret_loc.length() > 0 { self.entry_ret_loc } else { "0" }
                self.sb.write_string("_fs_out_")
                self.sb.write_string(loc)
                self.sb.write_string(" = ")
                self.emit_expr(ex)
                self.sb.write_string(";\n")
              }
              EntryStage::Compute => ()
            }
            self.emit_indent()
            self.sb.write_string("return;\n")
          }
          None => self.sb.write_string("return;\n")
        }
      } else {
        match opt_ex {
          Some(ex) => {
            self.sb.write_string("return ")
            self.emit_expr(ex)
            self.sb.write_string(";\n")
          }
          None => self.sb.write_string("return;\n")
        }
      }
    }
    WgslStmt::If(cond, then_b, else_b, _, _) => {
      self.emit_indent()
      self.sb.write_string("if (")
      self.emit_expr(cond)
      self.sb.write_string(") {\n")
      self.push_scope()
      self.indent = self.indent + 1
      self.emit_stmts(then_b)
      self.indent = self.indent - 1
      self.pop_scope()
      if else_b.length() > 0 {
        self.emit_indent()
        self.sb.write_string("} else {\n")
        self.push_scope()
        self.indent = self.indent + 1
        self.emit_stmts(else_b)
        self.indent = self.indent - 1
        self.pop_scope()
      }
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::Switch(sel, cases, _, _) => {
      self.emit_indent()
      self.sb.write_string("switch (")
      self.emit_expr(sel)
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      let mut ci = 0
      while ci < cases.length() {
        let c = cases[ci]
        let mut si = 0
        while si < c.selectors.length() {
          self.emit_indent()
          self.sb.write_string("case ")
          self.emit_expr(c.selectors[si])
          self.sb.write_string(":\n")
          si = si + 1
        }
        if c.is_default {
          self.emit_indent()
          self.sb.write_string("default:\n")
        }
        self.emit_indent()
        self.sb.write_string("{\n")
        self.push_scope()
        self.indent = self.indent + 1
        self.emit_stmts(c.body)
        self.emit_indent()
        self.sb.write_string("break;\n")
        self.indent = self.indent - 1
        self.pop_scope()
        self.emit_indent()
        self.sb.write_string("}\n")
        ci = ci + 1
      }
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::For(init, cond, update, body, _, _) => {
      self.push_scope()
      self.emit_indent()
      self.sb.write_string("for (")
      match init {
        Some(st) => self.emit_simple_stmt_inline(st)
        None => ()
      }
      self.sb.write_string("; ")
      match cond {
        Some(ex) => self.emit_expr(ex)
        None => ()
      }
      self.sb.write_string("; ")
      match update {
        Some(st) => self.emit_simple_stmt_inline(st)
        None => ()
      }
      self.sb.write_string(") {\n")
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.emit_indent()
      self.sb.write_string("}\n")
      self.pop_scope()
    }
    WgslStmt::While(cond, body, _, _) => {
      self.emit_indent()
      self.sb.write_string("while (")
      self.emit_expr(cond)
      self.sb.write_string(") {\n")
      self.push_scope()
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.pop_scope()
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::Loop(body, cont, break_if, _, _) => {
      let has_cont = cont.length() > 0 || (match break_if { Some(_) => true; None => false })
      if !has_cont {
        self.emit_indent()
        self.sb.write_string("while (true) {\n")
        self.push_scope()
        self.indent = self.indent + 1
        self.emit_stmts(body)
        self.indent = self.indent - 1
        self.pop_scope()
        self.emit_indent()
        self.sb.write_string("}\n")
      } else {
        let lid = "_wgsl_li_" + self.loop_counter.to_string()
        self.loop_counter = self.loop_counter + 1
        self.emit_indent()
        self.sb.write_string("bool ")
        self.sb.write_string(lid)
        self.sb.write_string(" = true;\n")
        self.emit_indent()
        self.sb.write_string("while (true) {\n")
        self.push_scope()
        self.indent = self.indent + 1
        self.emit_indent()
        self.sb.write_string("if (!")
        self.sb.write_string(lid)
        self.sb.write_string(") {\n")
        self.indent = self.indent + 1
        self.emit_stmts(cont)
        match break_if {
          Some(cond) => {
            self.emit_indent()
            self.sb.write_string("if (")
            self.emit_expr(cond)
            self.sb.write_string(") { break; }\n")
          }
          None => ()
        }
        self.indent = self.indent - 1
        self.emit_indent()
        self.sb.write_string("}\n")
        self.emit_indent()
        self.sb.write_string(lid)
        self.sb.write_string(" = false;\n")
        self.emit_stmts(body)
        self.indent = self.indent - 1
        self.pop_scope()
        self.emit_indent()
        self.sb.write_string("}\n")
      }
    }
    WgslStmt::Break(_, _) => {
      self.emit_indent()
      self.sb.write_string("break;\n")
    }
    WgslStmt::Continue(_, _) => {
      self.emit_indent()
      self.sb.write_string("continue;\n")
    }
    WgslStmt::Discard(_, _) => {
      self.emit_indent()
      self.sb.write_string("discard;\n")
    }
    WgslStmt::Block(body, _, _) => {
      self.emit_indent()
      self.sb.write_string("{\n")
      self.push_scope()
      self.indent = self.indent + 1
      self.emit_stmts(body)
      self.indent = self.indent - 1
      self.pop_scope()
      self.emit_indent()
      self.sb.write_string("}\n")
    }
    WgslStmt::ConstAssert(_, _, _) => ()
  }
}

fn glsl_struct_has_runtime_array(s : WgslStructDecl, aliases : Map[String, WgslType]) -> Bool {
  let mut i = 0
  while i < s.fields.length() {
    let r = wgsl_resolve_alias_depth(s.fields[i].ty, aliases, 0)
    match r {
      WgslType::Array(_, len, len_ident) =>
      if len == 0 && len_ident.length() == 0 {
        return true
      }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn glsl_emit_struct_topo(
  name : String,
  ctx : GlslCtx,
  emitted : Map[String, Bool],
) -> Unit {
  match emitted.get(name) {
    Some(true) => return
    _ => emitted.set(name, true)
  }
  match ctx.aliases.get(name) {
    Some(t) => {
      let deps : Array[String] = []
      wgsl_collect_type_deps(t, deps)
      let mut i = 0
      while i < deps.length() {
        glsl_emit_struct_topo(deps[i], ctx, emitted)
        i = i + 1
      }
      return
    }
    None => ()
  }
  match ctx.structs.get(name) {
    Some(s) => {
      if glsl_struct_has_runtime_array(s, ctx.aliases) {
        return
      }
      let mut fi = 0
      while fi < s.fields.length() {
        let deps : Array[String] = []
        wgsl_collect_type_deps(s.fields[fi].ty, deps)
        let mut di = 0
        while di < deps.length() {
          glsl_emit_struct_topo(deps[di], ctx, emitted)
          di = di + 1
        }
        fi = fi + 1
      }
      ctx.sb.write_string("struct ")
      ctx.sb.write_string(glsl_ident(s.name))
      ctx.sb.write_string(" {\n")
      let mut sfi = 0
      while sfi < s.fields.length() {
        let fld = s.fields[sfi]
        ctx.sb.write_string("  ")
        glsl_emit_type(ctx.sb, fld.ty, ctx.aliases)
        ctx.sb.write_string(" ")
        ctx.sb.write_string(glsl_ident(fld.name))
        ctx.sb.write_string(";\n")
        sfi = sfi + 1
      }
      ctx.sb.write_string("};\n\n")
    }
    None => ()
  }
}

fn glsl_emit_helper_sig(ctx : GlslCtx, f : WgslFuncDecl) -> Unit {
  match f.ret_ty {
    Some(rt) => glsl_emit_type(ctx.sb, rt, ctx.aliases)
    None => ctx.sb.write_string("void")
  }
  ctx.sb.write_string(" ")
  ctx.sb.write_string(glsl_ident(f.name))
  ctx.sb.write_string("(")
  let mut hpi = 0
  while hpi < f.params.length() {
    if hpi > 0 {
      ctx.sb.write_string(", ")
    }
    match f.params[hpi].ty {
      WgslType::Ptr(_, elem, _) => {
        ctx.sb.write_string("inout ")
        glsl_emit_type(ctx.sb, elem, ctx.aliases)
      }
      _ => glsl_emit_type(ctx.sb, f.params[hpi].ty, ctx.aliases)
    }
    ctx.sb.write_string(" ")
    ctx.sb.write_string(glsl_ident(f.params[hpi].name))
    hpi = hpi + 1
  }
  ctx.sb.write_string(")")
}

fn wgsl_emit_glsl(
  module_ast : WgslModule,
  reflection : ModuleReflection,
  options : CompileOptions,
) -> Result[CompiledModule, WgslError] {
  if reflection.entries.length() == 0 {
    return Err(
      WgslError::{
        kind: WgslErrorKind::CodegenError,
        line: 0,
        col: 0,
        message: "no entry point found in WGSL module",
      },
    )
  }

  let mut target_info = reflection.entries[0]
  if options.entry_point.length() > 0 {
    let mut found = false
    let mut ei = 0
    while ei < reflection.entries.length() {
      if reflection.entries[ei].name == options.entry_point {
        target_info = reflection.entries[ei]
        found = true
        break
      }
      ei = ei + 1
    }
    if !found {
      return Err(
        WgslError::{
          kind: WgslErrorKind::CodegenError,
          line: 0,
          col: 0,
          message: "unknown entry point '" + options.entry_point + "'",
        },
      )
    }
  }

  let mut target_func = module_ast.funcs[0]
  let func_map : Map[String, WgslFuncDecl] = Map::new()
  let mut fi = 0
  while fi < module_ast.funcs.length() {
    func_map.set(module_ast.funcs[fi].name, module_ast.funcs[fi])
    if module_ast.funcs[fi].name == target_info.name {
      target_func = module_ast.funcs[fi]
    }
    fi = fi + 1
  }

  let is_compute = match target_info.stage {
    EntryStage::Compute => true
    _ => false
  }
  let aliases : Map[String, WgslType] = Map::new()
  let mut i = 0
  while i < module_ast.aliases.length() {
    aliases.set(module_ast.aliases[i].name, module_ast.aliases[i].ty)
    i = i + 1
  }
  let structs : Map[String, WgslStructDecl] = Map::new()
  i = 0
  while i < module_ast.structs.length() {
    structs.set(module_ast.structs[i].name, module_ast.structs[i])
    i = i + 1
  }

  // Evaluate const ints
  let const_vals : Map[String, ConstVal] = Map::new()
  let const_ints : Map[String, Int64] = Map::new()
  let mut pass = 0
  while pass < 4 {
    i = 0
    while i < module_ast.globals.length() {
      let g = module_ast.globals[i]
      if g.decl_kind == "const" {
        match g.init {
          Some(ex) =>
          match wgsl_eval_const(ex, const_vals) {
            Some(cv) => {
              const_vals.set(g.name, cv)
              match cv { ConstVal::CInt(v) => const_ints.set(g.name, v); _ => () }
            }
            None => ()
          }
          None => ()
        }
      }
      i = i + 1
    }
    pass = pass + 1
  }

  // Compute functions & globals reachable from target_func
  let reachable_funcs : Map[String, Bool] = Map::new()
  let reachable_refs : Map[String, Bool] = Map::new()
  let reachable_calls : Map[String, Bool] = Map::new()
  let dummy_arr : Array[Bool] = [false]
  let worklist : Array[String] = [target_func.name]
  reachable_funcs.set(target_func.name, true)
  let mut wi = 0
  while wi < worklist.length() {
    let fname = worklist[wi]
    wi = wi + 1
    match func_map.get(fname) {
      Some(fn_d) => {
        let frefs : Map[String, Bool] = Map::new()
        let fcalls : Map[String, Bool] = Map::new()
        let fcall_list : Array[String] = []
        msl_collect_stmts_refs(fn_d.body, frefs, fcalls, fcall_list, dummy_arr)
        let mut gi = 0
        while gi < module_ast.globals.length() {
          let gn = module_ast.globals[gi].name
          match frefs.get(gn) {
            Some(true) => reachable_refs.set(gn, true)
            _ => ()
          }
          gi = gi + 1
        }
        let mut ci = 0
        while ci < fcall_list.length() {
          let cn = fcall_list[ci]
          match func_map.get(cn) {
            Some(_) =>
            match reachable_funcs.get(cn) {
              Some(true) => ()
              _ => {
                reachable_funcs.set(cn, true)
                worklist.push(cn)
              }
            }
            None => ()
          }
          ci = ci + 1
        }
        // Track special builtin calls
        match fcalls.get("modf") { Some(true) => reachable_calls.set("modf", true); _ => () }
        match fcalls.get("frexp") { Some(true) => reachable_calls.set("frexp", true); _ => () }
        match fcalls.get("atomicCompareExchangeWeak") { Some(true) => reachable_calls.set("cas", true); _ => () }
        match fcalls.get("countLeadingZeros") { Some(true) => reachable_calls.set("clz", true); _ => () }
        match fcalls.get("countTrailingZeros") { Some(true) => reachable_calls.set("ctz", true); _ => () }
      }
      None => ()
    }
  }

  let global_types : Map[String, SemType] = Map::new()
  let ctx = GlslCtx::{
    sb: StringBuilder::new(),
    aliases: aliases,
    structs: structs,
    funcs: func_map,
    const_ints: const_ints,
    builtin_remap: Map::new(),
    scalar_uniforms: Map::new(),
    scopes: [global_types],
    ptr_aliases: [Map::new()],
    indent: 0,
    in_entry: false,
    entry_stage: target_info.stage,
    entry_ret_struct: "",
    entry_ret_loc: "",
    entry_ret_builtin: "",
    loop_counter: 0,
  }

  // Populate global_types
  i = 0
  while i < module_ast.globals.length() {
    let g = module_ast.globals[i]
    let gt = match g.ty {
      Some(t) => wgsl_type_to_sem(t, aliases, const_ints)
      None =>
      match g.init {
        Some(ex) => sem_concretize(ctx.infer_expr_type(ex))
        None => SemType::Scalar("f32")
      }
    }
    global_types.set(g.name, gt)
    i = i + 1
  }

  if is_compute {
    ctx.sb.write_string("#version 450\n\n")
    ctx.sb.write_string("layout(local_size_x = ")
    ctx.sb.write_string(target_info.workgroup_size_x.to_string())
    ctx.sb.write_string(", local_size_y = ")
    ctx.sb.write_string(target_info.workgroup_size_y.to_string())
    ctx.sb.write_string(", local_size_z = ")
    ctx.sb.write_string(target_info.workgroup_size_z.to_string())
    ctx.sb.write_string(") in;\n\n")
  } else {
    ctx.sb.write_string("#version 300 es\nprecision highp float;\nprecision highp int;\n\n")
  }

  // Emit polyfills when used
  match reachable_calls.get("modf") {
    Some(true) => {
      ctx.sb.write_string("struct _wgsl_modf_f32 { float fract; float whole; };\n")
      ctx.sb.write_string("_wgsl_modf_f32 _wgsl_modf(float x) { float w = trunc(x); return _wgsl_modf_f32(x - w, w); }\n\n")
    }
    _ => ()
  }
  match reachable_calls.get("frexp") {
    Some(true) => {
      ctx.sb.write_string("struct _wgsl_frexp_f32 { float fract; int exp; };\n")
      ctx.sb.write_string("_wgsl_frexp_f32 _wgsl_frexp(float x) { int e; float f = frexp(x, e); return _wgsl_frexp_f32(f, e); }\n\n")
    }
    _ => ()
  }
  match reachable_calls.get("cas") {
    Some(true) => {
      ctx.sb.write_string("struct _wgsl_cas_u32 { uint old_value; bool exchanged; };\n")
      ctx.sb.write_string("_wgsl_cas_u32 _wgsl_cas_u32_res(uint prev, uint cmp) { return _wgsl_cas_u32(prev, prev == cmp); }\n")
      ctx.sb.write_string("struct _wgsl_cas_i32 { int old_value; bool exchanged; };\n")
      ctx.sb.write_string("_wgsl_cas_i32 _wgsl_cas_i32_res(int prev, int cmp) { return _wgsl_cas_i32(prev, prev == cmp); }\n\n")
    }
    _ => ()
  }
  match reachable_calls.get("clz") {
    Some(true) => {
      ctx.sb.write_string("uint _wgsl_clz(uint x) { int m = findMSB(x); return m < 0 ? 32u : uint(31 - m); }\n")
      ctx.sb.write_string("int _wgsl_clz(int x) { int m = findMSB(uint(x)); return m < 0 ? 32 : (31 - m); }\n\n")
    }
    _ => ()
  }
  match reachable_calls.get("ctz") {
    Some(true) => {
      ctx.sb.write_string("uint _wgsl_ctz(uint x) { int l = findLSB(x); return l < 0 ? 32u : uint(l); }\n")
      ctx.sb.write_string("int _wgsl_ctz(int x) { int l = findLSB(uint(x)); return l < 0 ? 32 : l; }\n\n")
    }
    _ => ()
  }

  // Emit module-level `const` and `override` first (may be used in struct/array sizes)
  let mut gi = 0
  let mut emitted_const = false
  while gi < module_ast.globals.length() {
    let g = module_ast.globals[gi]
    if g.decl_kind == "const" || g.decl_kind == "override" {
      ctx.sb.write_string("const ")
      let wt = match g.ty {
        Some(t) => t
        None =>
        match g.init {
          Some(ex) => sem_to_wgsl_type(ctx.infer_expr_type(ex))
          None => WgslType::Scalar("f32")
        }
      }
      glsl_emit_type(ctx.sb, wt, ctx.aliases)
      ctx.sb.write_string(" ")
      ctx.sb.write_string(glsl_ident(g.name))
      ctx.sb.write_string(" = ")
      match g.init {
        Some(ex) => ctx.emit_expr(ex)
        None => glsl_emit_zero_init(ctx.sb, wt, ctx.structs, ctx.aliases, ctx.const_ints, 0)
      }
      ctx.sb.write_string(";\n")
      emitted_const = true
    }
    gi = gi + 1
  }
  if emitted_const {
    ctx.sb.write_string("\n")
  }

  // Emit structs in topological order
  let emitted_structs : Map[String, Bool] = Map::new()
  let mut si = 0
  while si < module_ast.structs.length() {
    glsl_emit_struct_topo(module_ast.structs[si].name, ctx, emitted_structs)
    si = si + 1
  }

  // Emit module-level vars (private, workgroup, uniform, storage, textures)
  let wg_vars : Array[WgslGlobalVar] = []
  gi = 0
  while gi < module_ast.globals.length() {
    let g = module_ast.globals[gi]
    if g.decl_kind == "const" || g.decl_kind == "override" {
      gi = gi + 1
      continue
    }
    let is_used = match reachable_refs.get(g.name) { Some(true) => true; _ => false }
    if g.addr_space == "private" {
      let wt = match g.ty { Some(t) => t; None => WgslType::Scalar("f32") }
      glsl_emit_type(ctx.sb, wt, ctx.aliases)
      ctx.sb.write_string(" ")
      ctx.sb.write_string(glsl_ident(g.name))
      ctx.sb.write_string(" = ")
      match g.init {
        Some(ex) => ctx.emit_expr(ex)
        None => glsl_emit_zero_init(ctx.sb, wt, ctx.structs, ctx.aliases, ctx.const_ints, 0)
      }
      ctx.sb.write_string(";\n")
    } else if g.addr_space == "workgroup" {
      if is_compute {
        wg_vars.push(g)
        ctx.sb.write_string("shared ")
        match g.ty {
          Some(t) => glsl_emit_type(ctx.sb, t, ctx.aliases)
          None => ctx.sb.write_string("float")
        }
        ctx.sb.write_string(" ")
        ctx.sb.write_string(glsl_ident(g.name))
        ctx.sb.write_string(";\n")
      }
    } else {
      // Bound resources
      let mut slot = 0
      let mut bi = 0
      while bi < reflection.bindings.length() {
        if reflection.bindings[bi].name == g.name {
          slot = reflection.bindings[bi].msl_slot
          break
        }
        bi = bi + 1
      }
      match g.ty {
        Some(WgslType::Sampler(_)) => ()
        Some(WgslType::Texture(tk, elem, acc)) =>
        if is_used || is_compute {
          if tk == "texture_storage_1d" || tk == "texture_storage_2d" ||
          tk == "texture_storage_2d_array" || tk == "texture_storage_3d" {
            if is_compute {
              ctx.sb.write_string("layout(binding = ")
              ctx.sb.write_string(slot.to_string())
              ctx.sb.write_string(", ")
              ctx.sb.write_string(elem)
              ctx.sb.write_string(") uniform ")
              glsl_emit_type(ctx.sb, WgslType::Texture(tk, elem, acc), ctx.aliases)
              ctx.sb.write_string(" ")
              ctx.sb.write_string(glsl_ident(g.name))
              ctx.sb.write_string(";\n")
            }
          } else {
            if is_compute {
              ctx.sb.write_string("layout(binding = ")
              ctx.sb.write_string(slot.to_string())
              ctx.sb.write_string(") ")
            }
            ctx.sb.write_string("uniform ")
            glsl_emit_type(ctx.sb, WgslType::Texture(tk, elem, acc), ctx.aliases)
            ctx.sb.write_string(" ")
            ctx.sb.write_string(glsl_ident(g.name))
            ctx.sb.write_string(";\n")
          }
        }
        Some(t) =>
        if g.addr_space == "uniform" {
          if is_compute {
            ctx.sb.write_string("layout(std140, binding = ")
            ctx.sb.write_string(slot.to_string())
            ctx.sb.write_string(") uniform _U_")
          } else {
            ctx.sb.write_string("layout(std140) uniform _U_")
          }
          ctx.sb.write_string(glsl_ident(g.name))
          ctx.sb.write_string(" {\n  ")
          let resolved_t = wgsl_resolve_alias_depth(t, ctx.aliases, 0)
          match resolved_t {
            WgslType::Named(sn) =>
            match ctx.structs.get(sn) {
              Some(st) => {
                let mut sfi = 0
                while sfi < st.fields.length() {
                  if sfi > 0 {
                    ctx.sb.write_string("  ")
                  }
                  glsl_emit_type(ctx.sb, st.fields[sfi].ty, ctx.aliases)
                  ctx.sb.write_string(" ")
                  ctx.sb.write_string(glsl_ident(st.fields[sfi].name))
                  ctx.sb.write_string(";\n")
                  sfi = sfi + 1
                }
              }
              None => {
                ctx.scalar_uniforms.set(g.name, true)
                glsl_emit_type(ctx.sb, t, ctx.aliases)
                ctx.sb.write_string(" value;\n")
              }
            }
            _ => {
              ctx.scalar_uniforms.set(g.name, true)
              glsl_emit_type(ctx.sb, t, ctx.aliases)
              ctx.sb.write_string(" value;\n")
            }
          }
          ctx.sb.write_string("} ")
          ctx.sb.write_string(glsl_ident(g.name))
          ctx.sb.write_string(";\n")
        } else if g.addr_space == "storage" {
          if is_compute || is_used {
            ctx.sb.write_string("layout(std430, binding = ")
            ctx.sb.write_string(slot.to_string())
            ctx.sb.write_string(") ")
            if g.access != "read_write" {
              ctx.sb.write_string("readonly ")
            }
            ctx.sb.write_string("buffer _B_")
            ctx.sb.write_string(glsl_ident(g.name))
            ctx.sb.write_string(" {\n  ")
            let resolved_t = wgsl_resolve_alias_depth(t, ctx.aliases, 0)
            match resolved_t {
              WgslType::Array(elem, len, len_ident) => {
                glsl_emit_type(ctx.sb, elem, ctx.aliases)
                ctx.sb.write_string(" ")
                ctx.sb.write_string(glsl_ident(g.name))
                ctx.sb.write_string("[")
                if len > 0 {
                  ctx.sb.write_string(len.to_string())
                } else if len_ident.length() > 0 {
                  ctx.sb.write_string(glsl_ident(len_ident))
                }
                ctx.sb.write_string("];\n};\n")
              }
              WgslType::Named(sn) =>
              match ctx.structs.get(sn) {
                Some(st) =>
                if glsl_struct_has_runtime_array(st, ctx.aliases) {
                  let mut sfi = 0
                  while sfi < st.fields.length() {
                    if sfi > 0 {
                      ctx.sb.write_string("  ")
                    }
                    let fld = st.fields[sfi]
                    let fr = wgsl_resolve_alias_depth(fld.ty, ctx.aliases, 0)
                    match fr {
                      WgslType::Array(elem, len, len_ident) => {
                        glsl_emit_type(ctx.sb, elem, ctx.aliases)
                        ctx.sb.write_string(" ")
                        ctx.sb.write_string(glsl_ident(fld.name))
                        ctx.sb.write_string("[")
                        if len > 0 {
                          ctx.sb.write_string(len.to_string())
                        } else if len_ident.length() > 0 {
                          ctx.sb.write_string(glsl_ident(len_ident))
                        }
                        ctx.sb.write_string("];\n")
                      }
                      _ => {
                        glsl_emit_type(ctx.sb, fld.ty, ctx.aliases)
                        ctx.sb.write_string(" ")
                        ctx.sb.write_string(glsl_ident(fld.name))
                        ctx.sb.write_string(";\n")
                      }
                    }
                    sfi = sfi + 1
                  }
                  ctx.sb.write_string("} ")
                  ctx.sb.write_string(glsl_ident(g.name))
                  ctx.sb.write_string(";\n")
                } else {
                  glsl_emit_type(ctx.sb, t, ctx.aliases)
                  ctx.sb.write_string(" ")
                  ctx.sb.write_string(glsl_ident(g.name))
                  ctx.sb.write_string(";\n};\n")
                }
                None => {
                  glsl_emit_type(ctx.sb, t, ctx.aliases)
                  ctx.sb.write_string(" ")
                  ctx.sb.write_string(glsl_ident(g.name))
                  ctx.sb.write_string(";\n};\n")
                }
              }
              _ => {
                glsl_emit_type(ctx.sb, t, ctx.aliases)
                ctx.sb.write_string(" ")
                ctx.sb.write_string(glsl_ident(g.name))
                ctx.sb.write_string(";\n};\n")
              }
            }
          }
        }
        None => ()
      }
    }
    gi = gi + 1
  }
  ctx.sb.write_string("\n")

  // Emit stage inputs & outputs for target entry point
  let is_vs = match target_info.stage { EntryStage::Vertex => true; _ => false }
  let is_fs = match target_info.stage { EntryStage::Fragment => true; _ => false }

  let mut pi = 0
  while pi < target_func.params.length() {
    let p = target_func.params[pi]
    match wgsl_find_attr(p.attrs, "builtin") {
      Some(ba) =>
      if ba.args.length() == 1 {
        ctx.builtin_remap.set(p.name, glsl_builtin_var(ba.args[0], target_info.stage))
      }
      None =>
      match wgsl_find_attr(p.attrs, "location") {
        Some(la) =>
        if la.args.length() == 1 {
          let loc = la.args[0]
          let need_flat = glsl_is_int_type(p.ty, ctx.aliases) ||
          (match wgsl_find_attr(p.attrs, "interpolate") {
            Some(ia) => ia.args.length() >= 1 && ia.args[0] == "flat"
            None => false
          })
          if is_vs {
            ctx.sb.write_string("layout(location = ")
            ctx.sb.write_string(loc)
            ctx.sb.write_string(") in ")
            glsl_emit_type(ctx.sb, p.ty, ctx.aliases)
            ctx.sb.write_string(" ")
            ctx.sb.write_string(glsl_ident(p.name))
            ctx.sb.write_string(";\n")
          } else {
            // ES 3.00 fragment input: link by name `_wgsl_v_loc<N>` without layout(location)
            if need_flat {
              ctx.sb.write_string("flat ")
            }
            ctx.sb.write_string("in ")
            glsl_emit_type(ctx.sb, p.ty, ctx.aliases)
            ctx.sb.write_string(" _wgsl_v_loc")
            ctx.sb.write_string(loc)
            ctx.sb.write_string(";\n")
            ctx.builtin_remap.set(p.name, "_wgsl_v_loc" + loc)
          }
        }
        None =>
        match p.ty {
          WgslType::Named(sn) =>
          match ctx.structs.get(sn) {
            Some(st) => {
              let mut sfi = 0
              while sfi < st.fields.length() {
                let fld = st.fields[sfi]
                match wgsl_find_attr(fld.attrs, "location") {
                  Some(la) =>
                  if la.args.length() == 1 {
                    let loc = la.args[0]
                    let need_flat = glsl_is_int_type(fld.ty, ctx.aliases) ||
                    (match wgsl_find_attr(fld.attrs, "interpolate") {
                      Some(ia) => ia.args.length() >= 1 && ia.args[0] == "flat"
                      None => false
                    })
                    if is_vs {
                      ctx.sb.write_string("layout(location = ")
                      ctx.sb.write_string(loc)
                      ctx.sb.write_string(") in ")
                      glsl_emit_type(ctx.sb, fld.ty, ctx.aliases)
                      ctx.sb.write_string(" _vs_in_loc")
                      ctx.sb.write_string(loc)
                      ctx.sb.write_string(";\n")
                    } else {
                      if need_flat {
                        ctx.sb.write_string("flat ")
                      }
                      ctx.sb.write_string("in ")
                      glsl_emit_type(ctx.sb, fld.ty, ctx.aliases)
                      ctx.sb.write_string(" _wgsl_v_loc")
                      ctx.sb.write_string(loc)
                      ctx.sb.write_string(";\n")
                    }
                  }
                  None => ()
                }
                sfi = sfi + 1
              }
            }
            None => ()
          }
          _ => ()
        }
      }
    }
    pi = pi + 1
  }

  match target_func.ret_ty {
    Some(rt) =>
    match rt {
      WgslType::Named(sn) =>
      match ctx.structs.get(sn) {
        Some(st) => {
          ctx.entry_ret_struct = sn
          let mut sfi = 0
          while sfi < st.fields.length() {
            let fld = st.fields[sfi]
            match wgsl_find_attr(fld.attrs, "location") {
              Some(la) =>
              if la.args.length() == 1 {
                let loc = la.args[0]
                if is_vs {
                  let need_flat = glsl_is_int_type(fld.ty, ctx.aliases) ||
                  (match wgsl_find_attr(fld.attrs, "interpolate") {
                    Some(ia) => ia.args.length() >= 1 && ia.args[0] == "flat"
                    None => false
                  })
                  if need_flat {
                    ctx.sb.write_string("flat ")
                  }
                  ctx.sb.write_string("out ")
                  glsl_emit_type(ctx.sb, fld.ty, ctx.aliases)
                  ctx.sb.write_string(" _wgsl_v_loc")
                  ctx.sb.write_string(loc)
                  ctx.sb.write_string(";\n")
                } else {
                  ctx.sb.write_string("layout(location = ")
                  ctx.sb.write_string(loc)
                  ctx.sb.write_string(") out ")
                  glsl_emit_type(ctx.sb, fld.ty, ctx.aliases)
                  ctx.sb.write_string(" _fs_out_")
                  ctx.sb.write_string(loc)
                  ctx.sb.write_string(";\n")
                }
              }
              None => ()
            }
            sfi = sfi + 1
          }
        }
        None => ()
      }
      _ =>
      if is_fs {
        match wgsl_find_attr(target_func.ret_attrs, "builtin") {
          Some(ba) =>
          if ba.args.length() == 1 {
            ctx.entry_ret_builtin = ba.args[0]
          }
          None => {
            let loc = match wgsl_find_attr(target_func.ret_attrs, "location") {
              Some(la) => if la.args.length() > 0 { la.args[0] } else { "0" }
              None => "0"
            }
            ctx.entry_ret_loc = loc
            ctx.sb.write_string("layout(location = ")
            ctx.sb.write_string(loc)
            ctx.sb.write_string(") out ")
            glsl_emit_type(ctx.sb, rt, ctx.aliases)
            ctx.sb.write_string(" _fs_out_")
            ctx.sb.write_string(loc)
            ctx.sb.write_string(";\n")
          }
        }
      }
    }
    None => ()
  }
  ctx.sb.write_string("\n")

  // Forward declarations for reachable helper functions
  fi = 0
  let mut has_helpers = false
  while fi < module_ast.funcs.length() {
    let f = module_ast.funcs[fi]
    let is_entry = wgsl_has_attr(f.attrs, "vertex") ||
    wgsl_has_attr(f.attrs, "fragment") ||
    wgsl_has_attr(f.attrs, "compute")
    let is_reach = match reachable_funcs.get(f.name) { Some(true) => true; _ => false }
    if !is_entry && is_reach {
      glsl_emit_helper_sig(ctx, f)
      ctx.sb.write_string(";\n")
      has_helpers = true
    }
    fi = fi + 1
  }
  if has_helpers {
    ctx.sb.write_string("\n")
  }

  // Emit reachable helper functions
  fi = 0
  while fi < module_ast.funcs.length() {
    let f = module_ast.funcs[fi]
    let is_entry = wgsl_has_attr(f.attrs, "vertex") ||
    wgsl_has_attr(f.attrs, "fragment") ||
    wgsl_has_attr(f.attrs, "compute")
    let is_reach = match reachable_funcs.get(f.name) { Some(true) => true; _ => false }
    if !is_entry && is_reach {
      glsl_emit_helper_sig(ctx, f)
      ctx.sb.write_string(" {\n")
      ctx.push_scope()
      let mut hpi = 0
      while hpi < f.params.length() {
        ctx.define_type(f.params[hpi].name, wgsl_type_to_sem(f.params[hpi].ty, ctx.aliases, ctx.const_ints))
        hpi = hpi + 1
      }
      ctx.in_entry = false
      ctx.indent = 1
      ctx.emit_stmts(f.body)
      ctx.indent = 0
      ctx.pop_scope()
      ctx.sb.write_string("}\n\n")
    }
    fi = fi + 1
  }

  // Emit target entry point as `void main()`
  ctx.sb.write_string("void main() {\n")
  ctx.push_scope()
  pi = 0
  while pi < target_func.params.length() {
    ctx.define_type(
      target_func.params[pi].name,
      wgsl_type_to_sem(target_func.params[pi].ty, ctx.aliases, ctx.const_ints),
    )
    pi = pi + 1
  }
  ctx.in_entry = true
  ctx.indent = 1

  // Zero-initialize shared workgroup variables in compute shaders
  if is_compute && wg_vars.length() > 0 {
    ctx.emit_indent()
    ctx.sb.write_string("if (gl_LocalInvocationIndex == 0u) {\n")
    ctx.indent = ctx.indent + 1
    let mut wgi = 0
    while wgi < wg_vars.length() {
      let g = wg_vars[wgi]
      ctx.emit_indent()
      match g.ty {
        Some(WgslType::Array(elem, len, len_ident)) => {
          let n = if len > 0 {
            len
          } else if len_ident.length() > 0 {
            match ctx.const_ints.get(len_ident) { Some(v) => v.to_int(); None => 0 }
          } else { 0 }
          ctx.sb.write_string("for (uint _zi = 0u; _zi < ")
          ctx.sb.write_string(n.to_string())
          ctx.sb.write_string("u; _zi++) { ")
          ctx.sb.write_string(glsl_ident(g.name))
          ctx.sb.write_string("[_zi] = ")
          glsl_emit_zero_init(ctx.sb, elem, ctx.structs, ctx.aliases, ctx.const_ints, 0)
          ctx.sb.write_string("; }\n")
        }
        Some(t) => {
          ctx.sb.write_string(glsl_ident(g.name))
          ctx.sb.write_string(" = ")
          glsl_emit_zero_init(ctx.sb, t, ctx.structs, ctx.aliases, ctx.const_ints, 0)
          ctx.sb.write_string(";\n")
        }
        None => {
          ctx.sb.write_string(glsl_ident(g.name))
          ctx.sb.write_string(" = 0.0;\n")
        }
      }
      wgi = wgi + 1
    }
    ctx.indent = ctx.indent - 1
    ctx.emit_indent()
    ctx.sb.write_string("}\n")
    ctx.emit_indent()
    ctx.sb.write_string("barrier();\n")
  }

  // Reconstruct struct stage_in params if any
  pi = 0
  while pi < target_func.params.length() {
    let p = target_func.params[pi]
    if !wgsl_has_attr(p.attrs, "builtin") && !wgsl_has_attr(p.attrs, "location") {
      match p.ty {
        WgslType::Named(sn) =>
        match ctx.structs.get(sn) {
          Some(st) => {
            ctx.emit_indent()
            ctx.sb.write_string(glsl_ident(sn))
            ctx.sb.write_string(" ")
            ctx.sb.write_string(glsl_ident(p.name))
            ctx.sb.write_string(";\n")
            let mut sfi = 0
            while sfi < st.fields.length() {
              let fld = st.fields[sfi]
              ctx.emit_indent()
              ctx.sb.write_string(glsl_ident(p.name))
              ctx.sb.write_string(".")
              ctx.sb.write_string(glsl_ident(fld.name))
              ctx.sb.write_string(" = ")
              match wgsl_find_attr(fld.attrs, "builtin") {
                Some(ba) =>
                if ba.args.length() == 1 {
                  ctx.sb.write_string(glsl_builtin_var(ba.args[0], target_info.stage))
                }
                None => {
                  let loc = match wgsl_find_attr(fld.attrs, "location") {
                    Some(la) => if la.args.length() > 0 { la.args[0] } else { "0" }
                    None => "0"
                  }
                  if is_vs {
                    ctx.sb.write_string("_vs_in_loc")
                    ctx.sb.write_string(loc)
                  } else {
                    ctx.sb.write_string("_wgsl_v_loc")
                    ctx.sb.write_string(loc)
                  }
                }
              }
              ctx.sb.write_string(";\n")
              sfi = sfi + 1
            }
          }
          None => ()
        }
        _ => ()
      }
    }
    pi = pi + 1
  }

  ctx.push_scope()
  ctx.emit_stmts(target_func.body)
  ctx.pop_scope()
  ctx.indent = 0
  ctx.in_entry = false
  ctx.pop_scope()
  ctx.sb.write_string("}\n")

  Ok(CompiledModule::{ source: ctx.sb.to_string(), reflection: reflection })
}
