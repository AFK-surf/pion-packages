///| Pure-Pion W3C WGSL compiler public types, AST, limits, options, reflection, and errors.
///| Zero `extern "C"`, zero `World`, zero external dependencies, zero module-level mutable globals.

///| Security and resource limits for lexing and parsing untrusted WGSL shaders.
pub val struct ParseLimits {
  pub max_source_bytes : Int
  pub max_tokens : Int
  pub max_nesting_depth : Int
}

///| Default conservative limits for WGSL shader compilation.
pub fn ParseLimits::default() -> ParseLimits {
  ParseLimits::{
    max_source_bytes: 2097152,
    max_tokens: 250000,
    max_nesting_depth: 64,
  }
}

///| Construct custom `ParseLimits`.
pub fn ParseLimits::new(
  max_source_bytes : Int,
  max_tokens : Int,
  max_nesting_depth : Int,
) -> ParseLimits {
  ParseLimits::{
    max_source_bytes: max_source_bytes,
    max_tokens: max_tokens,
    max_nesting_depth: max_nesting_depth,
  }
}

///| Compilation options for `compile_to_msl` and `compile_to_glsl`.
pub struct CompileOptions {
  pub limits : ParseLimits
  pub entry_point : String
  pub glsl_version : Int
}

///| Default compilation options (`ParseLimits::default()`, auto entry point, GLSL ES 300).
pub fn CompileOptions::default() -> CompileOptions {
  CompileOptions::{
    limits: ParseLimits::default(),
    entry_point: "",
    glsl_version: 300,
  }
}

///| Construct `CompileOptions` with custom `ParseLimits`.
pub fn CompileOptions::with_limits(limits : ParseLimits) -> CompileOptions {
  CompileOptions::{
    limits: limits,
    entry_point: "",
    glsl_version: 300,
  }
}

///| Construct `CompileOptions` targeting a specific entry point name.
pub fn CompileOptions::with_entry_point(entry_point : String) -> CompileOptions {
  CompileOptions::{
    limits: ParseLimits::default(),
    entry_point: entry_point,
    glsl_version: 300,
  }
}

///| Category of a structured WGSL compiler error.
pub enum WgslErrorKind {
  EmptySource
  LimitExceeded
  LexError
  ParseError
  ValidationError
  CodegenError
}

///| Structured WGSL compiler error with 1-based `(line, col)` location.
pub struct WgslError {
  pub kind : WgslErrorKind
  pub line : Int
  pub col : Int
  pub message : String
}

///| Format a `WgslError` as a human-readable diagnostic string.
pub fn WgslError::to_string(self : WgslError) -> String {
  let prefix = match self.kind {
    WgslErrorKind::EmptySource => "empty WGSL source"
    WgslErrorKind::LimitExceeded => "limit exceeded"
    WgslErrorKind::LexError => "lex error"
    WgslErrorKind::ParseError => "parse error"
    WgslErrorKind::ValidationError => "validation error"
    WgslErrorKind::CodegenError => "codegen error"
  }
  if self.line > 0 {
    prefix + " at " + self.line.to_string() + ":" + self.col.to_string() + ": " + self.message
  } else if self.message.length() > 0 {
    prefix + ": " + self.message
  } else {
    prefix
  }
}

///| Human-readable diagnostic string for a `WgslError`.
pub fn wgsl_error_message(err : WgslError) -> String {
  err.to_string()
}

///| Pipeline stage for a WGSL entry point.
pub enum EntryStage {
  Vertex
  Fragment
  Compute
}

///| Reflected input or output variable on a WGSL entry point.
pub struct IoVarInfo {
  pub name : String
  pub wgsl_type : String
  pub location : Int
  pub builtin : String
  pub interpolate : String
}

///| Reflected entry point metadata.
pub struct EntryPointInfo {
  pub name : String
  pub stage : EntryStage
  pub msl_name : String
  pub glsl_name : String
  pub workgroup_size_x : Int
  pub workgroup_size_y : Int
  pub workgroup_size_z : Int
  pub inputs : Array[IoVarInfo]
  pub outputs : Array[IoVarInfo]
}

///| Resource binding kind for `@group(g) @binding(b)`.
pub enum BindingKind {
  Uniform
  StorageRead
  StorageReadWrite
  Texture1d
  Texture2d
  Texture2dArray
  TextureCube
  TextureCubeArray
  Texture3d
  TextureDepth2d
  TextureDepth2dArray
  TextureDepthCube
  TextureMultisampled2d
  TextureStorage1d
  TextureStorage2d
  TextureStorage2dArray
  TextureStorage3d
  Sampler
  SamplerComparison
}

///| Deterministic binding layout entry mapping WGSL `@group(g) @binding(b)`
///| to Metal buffer/texture/sampler slot `group * 8 + binding`.
pub struct BindingInfo {
  pub name : String
  pub group : Int
  pub binding : Int
  pub address_space : String
  pub access : String
  pub wgsl_type : String
  pub kind : BindingKind
  pub msl_slot : Int
}

///| Reflected struct field metadata.
pub struct StructFieldInfo {
  pub name : String
  pub wgsl_type : String
  pub location : Int
  pub builtin : String
  pub interpolate : String
  pub align : Int
  pub size : Int
}

///| Reflected struct declaration metadata.
pub struct StructInfo {
  pub name : String
  pub fields : Array[StructFieldInfo]
}

///| Reflected type alias metadata.
pub struct AliasInfo {
  pub name : String
  pub target_type : String
}

///| Reflected pipeline-overridable constant (`override`) metadata.
pub struct OverrideInfo {
  pub name : String
  pub wgsl_type : String
  pub id : Int
  pub has_default : Bool
}

///| Full static reflection of a validated WGSL shader module.
pub struct ModuleReflection {
  pub entries : Array[EntryPointInfo]
  pub bindings : Array[BindingInfo]
  pub structs : Array[StructInfo]
  pub aliases : Array[AliasInfo]
  pub overrides : Array[OverrideInfo]
}

///| Result of compiling a WGSL shader module to a target shading language (MSL or GLSL).
pub struct CompiledModule {
  pub source : String
  pub reflection : ModuleReflection
}

// --- AST Representation ---

///| Parsed WGSL attribute `@name(args...)`.
pub struct WgslAttr {
  pub name : String
  pub args : Array[String]
  pub line : Int
  pub col : Int
}

///| Parsed WGSL type node.
pub enum WgslType {
  Scalar(String)
  Vec(Int, String)
  Mat(Int, Int, String)
  Array(WgslType, Int, String)
  Texture(String, String, String)
  Sampler(Bool)
  Atomic(String)
  Named(String)
  Ptr(String, WgslType, String)
}

///| Parsed WGSL struct field.
pub struct WgslStructField {
  pub name : String
  pub ty : WgslType
  pub attrs : Array[WgslAttr]
  pub line : Int
  pub col : Int
}

///| Parsed WGSL struct declaration.
pub struct WgslStructDecl {
  pub name : String
  pub fields : Array[WgslStructField]
  pub line : Int
  pub col : Int
}

///| Parsed WGSL type alias declaration (`alias Name = Type;`).
pub struct WgslAliasDecl {
  pub name : String
  pub ty : WgslType
  pub line : Int
  pub col : Int
}

///| Parsed WGSL module-scope `var` / `const` / `override` declaration.
pub struct WgslGlobalVar {
  pub name : String
  pub decl_kind : String
  pub addr_space : String
  pub access : String
  pub ty : Option[WgslType]
  pub init : Option[WgslExpr]
  pub attrs : Array[WgslAttr]
  pub line : Int
  pub col : Int
}

///| Parsed WGSL function parameter.
pub struct WgslParam {
  pub name : String
  pub ty : WgslType
  pub attrs : Array[WgslAttr]
  pub line : Int
  pub col : Int
}

///| Parsed WGSL function declaration.
pub struct WgslFuncDecl {
  pub name : String
  pub params : Array[WgslParam]
  pub ret_ty : Option[WgslType]
  pub ret_attrs : Array[WgslAttr]
  pub attrs : Array[WgslAttr]
  pub body : Array[WgslStmt]
  pub line : Int
  pub col : Int
}

///| Parsed WGSL switch case clause.
pub struct WgslSwitchCase {
  pub selectors : Array[WgslExpr]
  pub is_default : Bool
  pub body : Array[WgslStmt]
  pub line : Int
  pub col : Int
}

///| Parsed WGSL statement.
pub enum WgslStmt {
  VarDecl(String, String, Option[WgslType], Option[WgslExpr], Int, Int)
  Assign(WgslExpr, String, WgslExpr, Int, Int)
  PhonyAssign(WgslExpr, Int, Int)
  IncDec(WgslExpr, Bool, Int, Int)
  ExprStmt(WgslExpr, Int, Int)
  Return(Option[WgslExpr], Int, Int)
  If(WgslExpr, Array[WgslStmt], Array[WgslStmt], Int, Int)
  Switch(WgslExpr, Array[WgslSwitchCase], Int, Int)
  For(Option[WgslStmt], Option[WgslExpr], Option[WgslStmt], Array[WgslStmt], Int, Int)
  While(WgslExpr, Array[WgslStmt], Int, Int)
  Loop(Array[WgslStmt], Array[WgslStmt], Option[WgslExpr], Int, Int)
  Break(Int, Int)
  Continue(Int, Int)
  Discard(Int, Int)
  Block(Array[WgslStmt], Int, Int)
  ConstAssert(WgslExpr, Int, Int)
}

///| Parsed WGSL expression.
pub enum WgslExpr {
  Ident(String, Int, Int)
  IntLit(String, Int, Int)
  FloatLit(String, Int, Int)
  BoolLit(Bool, Int, Int)
  Unary(String, WgslExpr, Int, Int)
  Binary(String, WgslExpr, WgslExpr, Int, Int)
  Call(String, Array[WgslType], Int, String, Array[WgslExpr], Int, Int)
  Index(WgslExpr, WgslExpr, Int, Int)
  Field(WgslExpr, String, Int, Int)
  Paren(WgslExpr, Int, Int)
}

///| Parsed WGSL `const_assert` declaration.
pub struct WgslConstAssert {
  pub expr : WgslExpr
  pub line : Int
  pub col : Int
}

///| Parsed WGSL module AST.
pub struct WgslModule {
  pub enables : Array[String]
  pub aliases : Array[WgslAliasDecl]
  pub structs : Array[WgslStructDecl]
  pub globals : Array[WgslGlobalVar]
  pub funcs : Array[WgslFuncDecl]
  pub const_asserts : Array[WgslConstAssert]
}
