///| Pure-Pion W3C WGSL static semantic validator & module reflection builder.
///| Checks duplicate entries/functions/structs/fields/aliases/globals/bindings/overrides,
///| undeclared named types, invalid `@workgroup_size`, WGSL reserved words,
///| `break`/`continue`/`discard` control-flow rules, and builds `ModuleReflection`.

fn wgsl_find_attr(attrs : Array[WgslAttr], name : String) -> Option[WgslAttr] {
  let mut i = 0
  while i < attrs.length() {
    if attrs[i].name == name {
      return Some(attrs[i])
    }
    i = i + 1
  }
  None
}

fn wgsl_has_attr(attrs : Array[WgslAttr], name : String) -> Bool {
  match wgsl_find_attr(attrs, name) {
    Some(_) => true
    None => false
  }
}

fn wgsl_val_err(line : Int, col : Int, msg : String) -> WgslError {
  WgslError::{
    kind: WgslErrorKind::ValidationError,
    line: line,
    col: col,
    message: msg,
  }
}

fn wgsl_is_reserved_word(name : String) -> Bool {
  name == "NULL" || name == "Self" || name == "abstract" || name == "active" ||
  name == "alignas" || name == "alignof" || name == "as" || name == "asm" ||
  name == "asm_fragment" || name == "async" || name == "attribute" || name == "auto" ||
  name == "await" || name == "become" || name == "cast" || name == "catch" ||
  name == "class" || name == "co_await" || name == "co_return" || name == "co_yield" ||
  name == "coherent" || name == "column_major" || name == "common" || name == "compile" ||
  name == "compile_fragment" || name == "concept" || name == "const_cast" || name == "consteval" ||
  name == "constexpr" || name == "constinit" || name == "crate" || name == "debugger" ||
  name == "decltype" || name == "delete" || name == "demote" || name == "demote_to_helper" ||
  name == "do" || name == "dynamic_cast" || name == "enum" || name == "explicit" ||
  name == "export" || name == "extends" || name == "extern" || name == "external" ||
  name == "filter" || name == "final" || name == "finally" || name == "friend" ||
  name == "from" || name == "fxgroup" || name == "get" || name == "goto" ||
  name == "groupshared" || name == "highp" || name == "impl" || name == "implements" ||
  name == "import" || name == "inline" || name == "instanceof" || name == "interface" ||
  name == "layout" || name == "lowp" || name == "macro" || name == "macro_rules" ||
  name == "match" || name == "mediump" || name == "meta" || name == "mod" ||
  name == "module" || name == "move" || name == "mut" || name == "mutable" ||
  name == "namespace" || name == "new" || name == "nil" || name == "noexcept" ||
  name == "noinline" || name == "non_coherent" || name == "noncoherent" || name == "noperspective" ||
  name == "null" || name == "nullptr" || name == "of" || name == "operator" ||
  name == "package" || name == "packoffset" || name == "partition" || name == "pass" ||
  name == "patch" || name == "pixelfragment" || name == "precise" || name == "premerge" ||
  name == "priv" || name == "protected" || name == "pub" || name == "public" ||
  name == "readonly" || name == "ref" || name == "regardless" || name == "register" ||
  name == "reinterpret_cast" || name == "require" || name == "resource" || name == "restrict" ||
  name == "self" || name == "set" || name == "shared" || name == "sizeof" ||
  name == "smooth" || name == "snorm" || name == "static" || name == "static_assert" ||
  name == "static_cast" || name == "std" || name == "subroutine" || name == "super" ||
  name == "target" || name == "template" || name == "this" || name == "thread_local" ||
  name == "throw" || name == "trait" || name == "try" || name == "type" ||
  name == "typedef" || name == "typeid" || name == "typename" || name == "typeof" ||
  name == "union" || name == "unless" || name == "unorm" || name == "unsafe" ||
  name == "unsized" || name == "use" || name == "using" || name == "varying" ||
  name == "virtual" || name == "volatile" || name == "wgsl" || name == "where" ||
  name == "with" || name == "writeonly" || name == "yield"
}

fn wgsl_type_to_str(ty : WgslType) -> String {
  match ty {
    WgslType::Scalar(s) => s
    WgslType::Vec(d, e) => "vec" + d.to_string() + "<" + e + ">"
    WgslType::Mat(c, r, e) => "mat" + c.to_string() + "x" + r.to_string() + "<" + e + ">"
    WgslType::Array(elem, len, len_ident) =>
    if len > 0 {
      "array<" + wgsl_type_to_str(elem) + ", " + len.to_string() + ">"
    } else if len_ident.length() > 0 {
      "array<" + wgsl_type_to_str(elem) + ", " + len_ident + ">"
    } else {
      "array<" + wgsl_type_to_str(elem) + ">"
    }
    WgslType::Texture(kind, elem, acc) =>
    if elem.length() == 0 {
      kind
    } else if acc.length() > 0 {
      kind + "<" + elem + ", " + acc + ">"
    } else {
      kind + "<" + elem + ">"
    }
    WgslType::Sampler(is_comp) => if is_comp { "sampler_comparison" } else { "sampler" }
    WgslType::Atomic(e) => "atomic<" + e + ">"
    WgslType::Named(n) => n
    WgslType::Ptr(sp, elem, acc) =>
    if acc.length() > 0 {
      "ptr<" + sp + ", " + wgsl_type_to_str(elem) + ", " + acc + ">"
    } else {
      "ptr<" + sp + ", " + wgsl_type_to_str(elem) + ">"
    }
  }
}

fn msl_entry_name(name : String) -> String {
  if name == "main" {
    "main0"
  } else {
    name
  }
}

fn wgsl_validate_type_refs(
  ty : WgslType,
  known_types : Map[String, Bool],
  line : Int,
  col : Int,
) -> Result[Unit, WgslError] {
  match ty {
    WgslType::Named(n) =>
    match known_types.get(n) {
      Some(_) => Ok(())
      None => Err(wgsl_val_err(line, col, "undeclared type '" + n + "'"))
    }
    WgslType::Array(elem, _, _) => wgsl_validate_type_refs(elem, known_types, line, col)
    WgslType::Ptr(_, elem, _) => wgsl_validate_type_refs(elem, known_types, line, col)
    _ => Ok(())
  }
}

fn wgsl_validate_stmts(
  stmts : Array[WgslStmt],
  loop_depth : Int,
  switch_depth : Int,
  allow_discard : Bool,
  known_types : Map[String, Bool],
) -> Result[Unit, WgslError] {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      WgslStmt::VarDecl(name, _, opt_ty, _, line, col) => {
        if wgsl_is_reserved_word(name) {
          return Err(wgsl_val_err(line, col, "reserved keyword '" + name + "' cannot be used as identifier"))
        }
        match opt_ty {
          Some(t) =>
          match wgsl_validate_type_refs(t, known_types, line, col) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          None => ()
        }
      }
      WgslStmt::If(_, then_b, else_b, _, _) => {
        match wgsl_validate_stmts(then_b, loop_depth, switch_depth, allow_discard, known_types) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        match wgsl_validate_stmts(else_b, loop_depth, switch_depth, allow_discard, known_types) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      WgslStmt::Switch(_, cases, _, _) => {
        let mut ci = 0
        while ci < cases.length() {
          match wgsl_validate_stmts(cases[ci].body, loop_depth, switch_depth + 1, allow_discard, known_types) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          ci = ci + 1
        }
      }
      WgslStmt::For(init, _, _, body, _, _) => {
        match init {
          Some(st) => {
            let tmp : Array[WgslStmt] = [st]
            match wgsl_validate_stmts(tmp, loop_depth, switch_depth, allow_discard, known_types) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
          }
          None => ()
        }
        match wgsl_validate_stmts(body, loop_depth + 1, switch_depth, allow_discard, known_types) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      WgslStmt::While(_, body, _, _) =>
      match wgsl_validate_stmts(body, loop_depth + 1, switch_depth, allow_discard, known_types) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      WgslStmt::Loop(body, cont, _, _, _) => {
        match wgsl_validate_stmts(body, loop_depth + 1, switch_depth, allow_discard, known_types) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        match wgsl_validate_stmts(cont, loop_depth + 1, switch_depth, allow_discard, known_types) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      WgslStmt::Block(body, _, _) =>
      match wgsl_validate_stmts(body, loop_depth, switch_depth, allow_discard, known_types) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      WgslStmt::Break(line, col) =>
      if loop_depth == 0 && switch_depth == 0 {
        return Err(wgsl_val_err(line, col, "'break' is only valid inside a loop or switch"))
      }
      WgslStmt::Continue(line, col) =>
      if loop_depth == 0 {
        return Err(wgsl_val_err(line, col, "'continue' is only valid inside a loop"))
      }
      WgslStmt::Discard(line, col) =>
      if !allow_discard {
        return Err(wgsl_val_err(line, col, "'discard' is only valid in fragment shaders"))
      }
      _ => ()
    }
    i = i + 1
  }
  Ok(())
}

fn wgsl_extract_io_meta(attrs : Array[WgslAttr]) -> (Int, String, String) {
  let mut loc = -1
  let mut builtin = ""
  let mut interp = ""
  match wgsl_find_attr(attrs, "location") {
    Some(la) =>
    if la.args.length() == 1 {
      match wgsl_parse_int_str(la.args[0]) {
        Some(v) => loc = v
        None => ()
      }
    }
    None => ()
  }
  match wgsl_find_attr(attrs, "builtin") {
    Some(ba) =>
    if ba.args.length() == 1 {
      builtin = ba.args[0]
    }
    None => ()
  }
  match wgsl_find_attr(attrs, "interpolate") {
    Some(ia) =>
    if ia.args.length() == 1 {
      interp = ia.args[0]
    } else if ia.args.length() >= 2 {
      interp = ia.args[0] + ", " + ia.args[1]
    }
    None => ()
  }
  (loc, builtin, interp)
}

fn wgsl_classify_texture_binding(kind : String) -> BindingKind {
  if kind == "texture_1d" {
    BindingKind::Texture1d
  } else if kind == "texture_2d" {
    BindingKind::Texture2d
  } else if kind == "texture_2d_array" {
    BindingKind::Texture2dArray
  } else if kind == "texture_cube" {
    BindingKind::TextureCube
  } else if kind == "texture_cube_array" {
    BindingKind::TextureCubeArray
  } else if kind == "texture_3d" {
    BindingKind::Texture3d
  } else if kind == "texture_depth_2d" {
    BindingKind::TextureDepth2d
  } else if kind == "texture_depth_2d_array" {
    BindingKind::TextureDepth2dArray
  } else if kind == "texture_depth_cube" {
    BindingKind::TextureDepthCube
  } else if kind == "texture_multisampled_2d" || kind == "texture_depth_multisampled_2d" {
    BindingKind::TextureMultisampled2d
  } else if kind == "texture_storage_1d" {
    BindingKind::TextureStorage1d
  } else if kind == "texture_storage_2d" {
    BindingKind::TextureStorage2d
  } else if kind == "texture_storage_2d_array" {
    BindingKind::TextureStorage2dArray
  } else {
    BindingKind::TextureStorage3d
  }
}

fn wgsl_validate_module(m : WgslModule) -> Result[ModuleReflection, WgslError] {
  // 1. Collect & validate aliases and structs (also check reserved words & duplicates)
  let known_types : Map[String, Bool] = Map::new()
  let struct_map : Map[String, WgslStructDecl] = Map::new()
  let alias_infos : Array[AliasInfo] = []
  let mut i = 0
  while i < m.aliases.length() {
    let a = m.aliases[i]
    if wgsl_is_reserved_word(a.name) {
      return Err(wgsl_val_err(a.line, a.col, "reserved keyword '" + a.name + "' cannot be used as alias name"))
    }
    match known_types.get(a.name) {
      Some(_) => return Err(wgsl_val_err(a.line, a.col, "duplicate type alias '" + a.name + "'"))
      None => known_types.set(a.name, true)
    }
    alias_infos.push(AliasInfo::{ name: a.name, target_type: wgsl_type_to_str(a.ty) })
    i = i + 1
  }

  let struct_infos : Array[StructInfo] = []
  i = 0
  while i < m.structs.length() {
    let s = m.structs[i]
    if wgsl_is_reserved_word(s.name) {
      return Err(wgsl_val_err(s.line, s.col, "reserved keyword '" + s.name + "' cannot be used as struct name"))
    }
    match known_types.get(s.name) {
      Some(_) => return Err(wgsl_val_err(s.line, s.col, "duplicate struct '" + s.name + "'"))
      None => {
        known_types.set(s.name, true)
        struct_map.set(s.name, s)
      }
    }
    i = i + 1
  }

  // Validate alias targets & struct fields
  i = 0
  while i < m.aliases.length() {
    let a = m.aliases[i]
    match wgsl_validate_type_refs(a.ty, known_types, a.line, a.col) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }

  i = 0
  while i < m.structs.length() {
    let s = m.structs[i]
    let seen_fields : Map[String, Bool] = Map::new()
    let field_infos : Array[StructFieldInfo] = []
    let mut fi = 0
    while fi < s.fields.length() {
      let f = s.fields[fi]
      if wgsl_is_reserved_word(f.name) {
        return Err(wgsl_val_err(f.line, f.col, "reserved keyword '" + f.name + "' cannot be used as field name"))
      }
      match seen_fields.get(f.name) {
        Some(_) =>
        return Err(
          wgsl_val_err(f.line, f.col, "duplicate field '" + f.name + "' in struct '" + s.name + "'"),
        )
        None => seen_fields.set(f.name, true)
      }
      match wgsl_validate_type_refs(f.ty, known_types, f.line, f.col) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let (loc, builtin, interp) = wgsl_extract_io_meta(f.attrs)
      let mut align_v = 0
      let mut size_v = 0
      match wgsl_find_attr(f.attrs, "align") {
        Some(aa) =>
        if aa.args.length() == 1 {
          match wgsl_parse_int_str(aa.args[0]) {
            Some(v) => align_v = v
            None => ()
          }
        }
        None => ()
      }
      match wgsl_find_attr(f.attrs, "size") {
        Some(sa) =>
        if sa.args.length() == 1 {
          match wgsl_parse_int_str(sa.args[0]) {
            Some(v) => size_v = v
            None => ()
          }
        }
        None => ()
      }
      field_infos.push(
        StructFieldInfo::{
          name: f.name,
          wgsl_type: wgsl_type_to_str(f.ty),
          location: loc,
          builtin: builtin,
          interpolate: interp,
          align: align_v,
          size: size_v,
        },
      )
      fi = fi + 1
    }
    struct_infos.push(StructInfo::{ name: s.name, fields: field_infos })
    i = i + 1
  }

  // 2. Validate globals, bindings, overrides, and collect integer consts for @workgroup_size
  let bindings : Array[BindingInfo] = []
  let overrides : Array[OverrideInfo] = []
  let seen_bindings : Map[String, Int] = Map::new()
  let seen_globals : Map[String, Int] = Map::new()
  let seen_override_ids : Map[Int, Bool] = Map::new()
  let const_ints : Map[String, Int] = Map::new()

  i = 0
  while i < m.globals.length() {
    let g = m.globals[i]
    if wgsl_is_reserved_word(g.name) {
      return Err(wgsl_val_err(g.line, g.col, "reserved keyword '" + g.name + "' cannot be used as global name"))
    }
    match seen_globals.get(g.name) {
      Some(_) => return Err(wgsl_val_err(g.line, g.col, "duplicate global variable '" + g.name + "'"))
      None => seen_globals.set(g.name, g.line)
    }
    match g.ty {
      Some(t) =>
      match wgsl_validate_type_refs(t, known_types, g.line, g.col) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      None => ()
    }
    if g.decl_kind == "const" {
      match g.init {
        Some(WgslExpr::IntLit(s, _, _)) =>
        match wgsl_parse_int_str(s) {
          Some(v) => const_ints.set(g.name, v)
          None => ()
        }
        _ => ()
      }
    }
    if g.decl_kind == "override" {
      let mut ov_id = -1
      match wgsl_find_attr(g.attrs, "id") {
        Some(ia) =>
        if ia.args.length() == 1 {
          match wgsl_parse_int_str(ia.args[0]) {
            Some(v) =>
            if v >= 0 {
              match seen_override_ids.get(v) {
                Some(_) =>
                return Err(wgsl_val_err(ia.line, ia.col, "duplicate override @id(" + v.to_string() + ")"))
                None => {
                  seen_override_ids.set(v, true)
                  ov_id = v
                }
              }
            } else {
              return Err(wgsl_val_err(ia.line, ia.col, "@id must be non-negative"))
            }
            None => return Err(wgsl_val_err(ia.line, ia.col, "@id requires integer argument"))
          }
        }
        None => ()
      }
      let ty_s = match g.ty {
        Some(t) => wgsl_type_to_str(t)
        None => "inferred"
      }
      let has_def = match g.init {
        Some(_) => true
        None => false
      }
      overrides.push(
        OverrideInfo::{ name: g.name, wgsl_type: ty_s, id: ov_id, has_default: has_def },
      )
    }

    let grp_attr = wgsl_find_attr(g.attrs, "group")
    let bnd_attr = wgsl_find_attr(g.attrs, "binding")
    match (grp_attr, bnd_attr) {
      (Some(ga), Some(ba)) => {
        if ga.args.length() != 1 || ba.args.length() != 1 {
          return Err(wgsl_val_err(g.line, g.col, "@group and @binding each require 1 integer argument"))
        }
        let grp = match wgsl_parse_int_str(ga.args[0]) {
          Some(v) =>
          if v >= 0 && v < 8 {
            v
          } else {
            return Err(wgsl_val_err(ga.line, ga.col, "@group index out of range 0..7"))
          }
          None => return Err(wgsl_val_err(ga.line, ga.col, "@group requires non-negative integer"))
        }
        let bnd = match wgsl_parse_int_str(ba.args[0]) {
          Some(v) =>
          if v >= 0 && v < 32 {
            v
          } else {
            return Err(wgsl_val_err(ba.line, ba.col, "@binding index out of range 0..31"))
          }
          None => return Err(wgsl_val_err(ba.line, ba.col, "@binding requires non-negative integer"))
        }
        let bkey = grp.to_string() + ":" + bnd.to_string()
        match seen_bindings.get(bkey) {
          Some(_) =>
          return Err(
            wgsl_val_err(
              g.line,
              g.col,
              "duplicate @group(" + grp.to_string() + ") @binding(" + bnd.to_string() + ")",
            ),
          )
          None => seen_bindings.set(bkey, g.line)
        }
        let ty = match g.ty {
          Some(t) => t
          None =>
          return Err(wgsl_val_err(g.line, g.col, "bound resource '" + g.name + "' requires explicit type"))
        }
        let kind = match ty {
          WgslType::Texture(tk, _, _) => wgsl_classify_texture_binding(tk)
          WgslType::Sampler(is_comp) =>
          if is_comp {
            BindingKind::SamplerComparison
          } else {
            BindingKind::Sampler
          }
          _ =>
          if g.addr_space == "uniform" {
            BindingKind::Uniform
          } else if g.addr_space == "storage" {
            if g.access == "read_write" {
              BindingKind::StorageReadWrite
            } else {
              BindingKind::StorageRead
            }
          } else {
            return Err(
              wgsl_val_err(
                g.line,
                g.col,
                "resource '" + g.name + "' must use var<uniform>, var<storage, ...>, texture, or sampler",
              ),
            )
          }
        }
        let addr_s = if g.addr_space.length() > 0 { g.addr_space } else { "handle" }
        bindings.push(
          BindingInfo::{
            name: g.name,
            group: grp,
            binding: bnd,
            address_space: addr_s,
            access: g.access,
            wgsl_type: wgsl_type_to_str(ty),
            kind: kind,
            msl_slot: grp * 8 + bnd,
          },
        )
      }
      (Some(_), None) | (None, Some(_)) =>
      return Err(wgsl_val_err(g.line, g.col, "@group and @binding must both be specified"))
      _ => ()
    }
    i = i + 1
  }

  // 3. Validate functions, entry points, and control flow
  let entries : Array[EntryPointInfo] = []
  let seen_funcs : Map[String, Int] = Map::new()
  i = 0
  while i < m.funcs.length() {
    let f = m.funcs[i]
    if wgsl_is_reserved_word(f.name) {
      return Err(wgsl_val_err(f.line, f.col, "reserved keyword '" + f.name + "' cannot be used as function name"))
    }
    match seen_funcs.get(f.name) {
      Some(_) => return Err(wgsl_val_err(f.line, f.col, "duplicate function '" + f.name + "'"))
      None => seen_funcs.set(f.name, f.line)
    }

    let mut pi = 0
    while pi < f.params.length() {
      let p = f.params[pi]
      if wgsl_is_reserved_word(p.name) {
        return Err(wgsl_val_err(p.line, p.col, "reserved keyword '" + p.name + "' cannot be used as parameter name"))
      }
      match wgsl_validate_type_refs(p.ty, known_types, p.line, p.col) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      pi = pi + 1
    }
    match f.ret_ty {
      Some(rt) =>
      match wgsl_validate_type_refs(rt, known_types, f.line, f.col) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      None => ()
    }

    let is_vs = wgsl_has_attr(f.attrs, "vertex")
    let is_fs = wgsl_has_attr(f.attrs, "fragment")
    let is_cs = wgsl_has_attr(f.attrs, "compute")
    let stage_count = (if is_vs { 1 } else { 0 }) +
    (if is_fs { 1 } else { 0 }) +
    (if is_cs { 1 } else { 0 })
    if stage_count > 1 {
      return Err(wgsl_val_err(f.line, f.col, "function '" + f.name + "' has multiple stage attributes"))
    }

    let allow_discard = !is_vs && !is_cs
    match wgsl_validate_stmts(f.body, 0, 0, allow_discard, known_types) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }

    if is_vs || is_fs || is_cs {
      let inputs : Array[IoVarInfo] = []
      pi = 0
      while pi < f.params.length() {
        let p = f.params[pi]
        let (loc, builtin, interp) = wgsl_extract_io_meta(p.attrs)
        if loc >= 0 || builtin.length() > 0 {
          inputs.push(
            IoVarInfo::{
              name: p.name,
              wgsl_type: wgsl_type_to_str(p.ty),
              location: loc,
              builtin: builtin,
              interpolate: interp,
            },
          )
        } else {
          match p.ty {
            WgslType::Named(sn) =>
            match struct_map.get(sn) {
              Some(st) => {
                let mut sfi = 0
                while sfi < st.fields.length() {
                  let sf = st.fields[sfi]
                  let (floc, fbi, fint) = wgsl_extract_io_meta(sf.attrs)
                  inputs.push(
                    IoVarInfo::{
                      name: sf.name,
                      wgsl_type: wgsl_type_to_str(sf.ty),
                      location: floc,
                      builtin: fbi,
                      interpolate: fint,
                    },
                  )
                  sfi = sfi + 1
                }
              }
              None => ()
            }
            _ => ()
          }
        }
        pi = pi + 1
      }

      let outputs : Array[IoVarInfo] = []
      match f.ret_ty {
        Some(rt) => {
          let (rloc, rbi, rint) = wgsl_extract_io_meta(f.ret_attrs)
          if rloc >= 0 || rbi.length() > 0 {
            outputs.push(
              IoVarInfo::{
                name: "",
                wgsl_type: wgsl_type_to_str(rt),
                location: rloc,
                builtin: rbi,
                interpolate: rint,
              },
            )
          } else {
            match rt {
              WgslType::Named(sn) =>
              match struct_map.get(sn) {
                Some(st) => {
                  let mut sfi = 0
                  while sfi < st.fields.length() {
                    let sf = st.fields[sfi]
                    let (floc, fbi, fint) = wgsl_extract_io_meta(sf.attrs)
                    outputs.push(
                      IoVarInfo::{
                        name: sf.name,
                        wgsl_type: wgsl_type_to_str(sf.ty),
                        location: floc,
                        builtin: fbi,
                        interpolate: fint,
                      },
                    )
                    sfi = sfi + 1
                  }
                }
                None => ()
              }
              _ => ()
            }
          }
        }
        None => ()
      }

      if is_cs {
        let wg_attr = match wgsl_find_attr(f.attrs, "workgroup_size") {
          Some(a) => a
          None =>
          return Err(
            wgsl_val_err(f.line, f.col, "@compute entry '" + f.name + "' requires @workgroup_size"),
          )
        }
        if wg_attr.args.length() < 1 || wg_attr.args.length() > 3 {
          return Err(
            wgsl_val_err(wg_attr.line, wg_attr.col, "@workgroup_size requires 1 to 3 positive integer arguments"),
          )
        }
        let wgx = match wgsl_resolve_wg_dim(wg_attr.args[0], const_ints) {
          Some(v) =>
          if v > 0 && v <= 1024 {
            v
          } else {
            return Err(
              wgsl_val_err(wg_attr.line, wg_attr.col, "@workgroup_size x must be in 1..1024, got " + v.to_string()),
            )
          }
          None => return Err(wgsl_val_err(wg_attr.line, wg_attr.col, "invalid @workgroup_size x"))
        }
        let wgy = if wg_attr.args.length() >= 2 {
          match wgsl_resolve_wg_dim(wg_attr.args[1], const_ints) {
            Some(v) =>
            if v > 0 && v <= 1024 {
              v
            } else {
              return Err(
                wgsl_val_err(wg_attr.line, wg_attr.col, "@workgroup_size y must be in 1..1024, got " + v.to_string()),
              )
            }
            None => return Err(wgsl_val_err(wg_attr.line, wg_attr.col, "invalid @workgroup_size y"))
          }
        } else {
          1
        }
        let wgz = if wg_attr.args.length() >= 3 {
          match wgsl_resolve_wg_dim(wg_attr.args[2], const_ints) {
            Some(v) =>
            if v > 0 && v <= 64 {
              v
            } else {
              return Err(
                wgsl_val_err(wg_attr.line, wg_attr.col, "@workgroup_size z must be in 1..64, got " + v.to_string()),
              )
            }
            None => return Err(wgsl_val_err(wg_attr.line, wg_attr.col, "invalid @workgroup_size z"))
          }
        } else {
          1
        }
        if wgx * wgy * wgz > 1024 {
          return Err(
            wgsl_val_err(wg_attr.line, wg_attr.col, "@workgroup_size total invocations exceeds 1024"),
          )
        }
        entries.push(
          EntryPointInfo::{
            name: f.name,
            stage: EntryStage::Compute,
            msl_name: msl_entry_name(f.name),
            glsl_name: "main",
            workgroup_size_x: wgx,
            workgroup_size_y: wgy,
            workgroup_size_z: wgz,
            inputs: inputs,
            outputs: outputs,
          },
        )
      } else if is_vs {
        entries.push(
          EntryPointInfo::{
            name: f.name,
            stage: EntryStage::Vertex,
            msl_name: msl_entry_name(f.name),
            glsl_name: "main",
            workgroup_size_x: 0,
            workgroup_size_y: 0,
            workgroup_size_z: 0,
            inputs: inputs,
            outputs: outputs,
          },
        )
      } else {
        entries.push(
          EntryPointInfo::{
            name: f.name,
            stage: EntryStage::Fragment,
            msl_name: msl_entry_name(f.name),
            glsl_name: "main",
            workgroup_size_x: 0,
            workgroup_size_y: 0,
            workgroup_size_z: 0,
            inputs: inputs,
            outputs: outputs,
          },
        )
      }
    }
    i = i + 1
  }

  Ok(
    ModuleReflection::{
      entries: entries,
      bindings: bindings,
      structs: struct_infos,
      aliases: alias_infos,
      overrides: overrides,
    },
  )
}

fn wgsl_resolve_wg_dim(arg : String, const_ints : Map[String, Int]) -> Option[Int] {
  match wgsl_parse_int_str(arg) {
    Some(v) => Some(v)
    None => const_ints.get(arg)
  }
}
