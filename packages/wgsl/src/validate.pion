///| Pure-Pion W3C WGSL static semantic validator, type checker, const evaluator & reflection builder.
///| Performs full name resolution, type inference & checking, mutability & address-space checks,
///| cycle detection (structs/aliases/call-graph), control-flow & return-path analysis,
///| constant expression & `const_assert` evaluation, and Metal slot allocation.

fn wgsl_find_attr(attrs : Array[WgslAttr], name : String) -> Option[WgslAttr] {
  let mut i = 0
  while i < attrs.length() {
    if attrs[i].name == name {
      return Some(attrs[i])
    }
    i = i + 1
  }
  None
}

fn wgsl_has_attr(attrs : Array[WgslAttr], name : String) -> Bool {
  match wgsl_find_attr(attrs, name) {
    Some(_) => true
    None => false
  }
}

fn wgsl_val_err(line : Int, col : Int, msg : String) -> WgslError {
  WgslError::{
    kind: WgslErrorKind::ValidationError,
    line: line,
    col: col,
    message: msg,
  }
}

fn wgsl_is_keyword(name : String) -> Bool {
  name == "alias" || name == "break" || name == "case" || name == "const" ||
  name == "const_assert" || name == "continue" || name == "continuing" || name == "default" ||
  name == "diagnostic" || name == "discard" || name == "else" || name == "enable" ||
  name == "false" || name == "fn" || name == "for" || name == "if" ||
  name == "let" || name == "loop" || name == "override" || name == "requires" ||
  name == "return" || name == "struct" || name == "switch" || name == "true" ||
  name == "var" || name == "while"
}

fn wgsl_is_reserved_word(name : String) -> Bool {
  name == "NULL" || name == "Self" || name == "abstract" || name == "active" ||
  name == "alignas" || name == "alignof" || name == "as" || name == "asm" ||
  name == "asm_fragment" || name == "async" || name == "attribute" || name == "auto" ||
  name == "await" || name == "become" || name == "cast" || name == "catch" ||
  name == "class" || name == "co_await" || name == "co_return" || name == "co_yield" ||
  name == "coherent" || name == "column_major" || name == "common" || name == "compile" ||
  name == "compile_fragment" || name == "concept" || name == "const_cast" || name == "consteval" ||
  name == "constexpr" || name == "constinit" || name == "crate" || name == "debugger" ||
  name == "decltype" || name == "delete" || name == "demote" || name == "demote_to_helper" ||
  name == "do" || name == "dynamic_cast" || name == "enum" || name == "explicit" ||
  name == "export" || name == "extends" || name == "extern" || name == "external" ||
  name == "fallthrough" || name == "filter" || name == "final" || name == "finally" ||
  name == "friend" || name == "from" || name == "fxgroup" || name == "get" ||
  name == "goto" || name == "groupshared" || name == "highp" || name == "impl" ||
  name == "implements" || name == "import" || name == "inline" || name == "instanceof" ||
  name == "interface" || name == "layout" || name == "lowp" || name == "macro" ||
  name == "macro_rules" || name == "match" || name == "mediump" || name == "meta" ||
  name == "mod" || name == "module" || name == "move" || name == "mut" ||
  name == "mutable" || name == "namespace" || name == "new" || name == "nil" ||
  name == "noexcept" || name == "noinline" || name == "nointerpolation" || name == "non_coherent" ||
  name == "noncoherent" || name == "noperspective" || name == "null" || name == "nullptr" ||
  name == "of" || name == "operator" || name == "package" || name == "packoffset" ||
  name == "partition" || name == "pass" || name == "patch" || name == "pixelfragment" ||
  name == "precise" || name == "precision" || name == "premerge" || name == "priv" ||
  name == "protected" || name == "pub" || name == "public" || name == "readonly" ||
  name == "ref" || name == "regardless" || name == "register" || name == "reinterpret_cast" ||
  name == "require" || name == "resource" || name == "restrict" || name == "self" ||
  name == "set" || name == "shared" || name == "sizeof" || name == "smooth" ||
  name == "snorm" || name == "static" || name == "static_assert" || name == "static_cast" ||
  name == "std" || name == "subroutine" || name == "super" || name == "target" ||
  name == "template" || name == "this" || name == "thread_local" || name == "throw" ||
  name == "trait" || name == "try" || name == "type" || name == "typedef" ||
  name == "typeid" || name == "typename" || name == "typeof" || name == "union" ||
  name == "unless" || name == "unorm" || name == "unsafe" || name == "unsized" ||
  name == "use" || name == "using" || name == "varying" || name == "virtual" ||
  name == "volatile" || name == "wgsl" || name == "where" || name == "with" ||
  name == "writeonly" || name == "yield"
}

fn wgsl_check_ident_name(name : String, line : Int, col : Int, role : String) -> Result[Unit, WgslError] {
  if wgsl_is_keyword(name) {
    return Err(wgsl_val_err(line, col, "keyword '" + name + "' cannot be used as " + role))
  }
  if wgsl_is_reserved_word(name) {
    return Err(wgsl_val_err(line, col, "reserved keyword '" + name + "' cannot be used as " + role))
  }
  if name == "_" {
    return Err(wgsl_val_err(line, col, "'_' cannot be used as " + role))
  }
  Ok(())
}

fn wgsl_is_valid_attr(name : String) -> Bool {
  name == "align" || name == "binding" || name == "blend_src" || name == "builtin" ||
  name == "compute" || name == "const" || name == "diagnostic" || name == "fragment" ||
  name == "group" || name == "id" || name == "interpolate" || name == "invariant" ||
  name == "location" || name == "must_use" || name == "size" || name == "vertex" ||
  name == "workgroup_size"
}

fn wgsl_is_valid_builtin(name : String) -> Bool {
  name == "vertex_index" || name == "instance_index" || name == "position" ||
  name == "front_facing" || name == "frag_depth" || name == "sample_index" ||
  name == "sample_mask" || name == "local_invocation_id" || name == "local_invocation_index" ||
  name == "global_invocation_id" || name == "workgroup_id" || name == "num_workgroups" ||
  name == "subgroup_invocation_id" || name == "subgroup_size"
}

fn wgsl_is_valid_storage_format(fmt : String) -> Bool {
  fmt == "rgba8unorm" || fmt == "rgba8snorm" || fmt == "rgba8uint" || fmt == "rgba8sint" ||
  fmt == "rgba16uint" || fmt == "rgba16sint" || fmt == "rgba16float" ||
  fmt == "r32uint" || fmt == "r32sint" || fmt == "r32float" ||
  fmt == "rg32uint" || fmt == "rg32sint" || fmt == "rg32float" ||
  fmt == "rgba32uint" || fmt == "rgba32sint" || fmt == "rgba32float" ||
  fmt == "bgra8unorm"
}

fn wgsl_storage_format_scalar(fmt : String) -> String {
  if fmt == "r32uint" || fmt == "rg32uint" || fmt == "rgba32uint" ||
  fmt == "rgba16uint" || fmt == "rgba8uint" {
    "u32"
  } else if fmt == "r32sint" || fmt == "rg32sint" || fmt == "rgba32sint" ||
  fmt == "rgba16sint" || fmt == "rgba8sint" {
    "i32"
  } else {
    "f32"
  }
}

fn wgsl_check_attrs(attrs : Array[WgslAttr]) -> Result[Unit, WgslError] {
  let seen : Map[String, Bool] = Map::new()
  let mut i = 0
  while i < attrs.length() {
    let a = attrs[i]
    if !wgsl_is_valid_attr(a.name) {
      return Err(wgsl_val_err(a.line, a.col, "unknown attribute '@" + a.name + "'"))
    }
    if a.name != "diagnostic" {
      match seen.get(a.name) {
        Some(_) => return Err(wgsl_val_err(a.line, a.col, "duplicate attribute '@" + a.name + "'"))
        None => seen.set(a.name, true)
      }
    }
    if a.name == "builtin" {
      if a.args.length() != 1 || !wgsl_is_valid_builtin(a.args[0]) {
        let bn = if a.args.length() >= 1 { a.args[0] } else { "" }
        return Err(wgsl_val_err(a.line, a.col, "unknown builtin '" + bn + "'"))
      }
    } else if a.name == "location" {
      if a.args.length() != 1 {
        return Err(wgsl_val_err(a.line, a.col, "@location requires 1 integer argument"))
      }
      match wgsl_parse_int_str(a.args[0]) {
        Some(v) =>
        if v < 0 {
          return Err(wgsl_val_err(a.line, a.col, "@location must be non-negative"))
        }
        None => return Err(wgsl_val_err(a.line, a.col, "invalid @location argument"))
      }
    } else if a.name == "align" {
      if a.args.length() != 1 {
        return Err(wgsl_val_err(a.line, a.col, "@align requires 1 integer argument"))
      }
      match wgsl_parse_int_str(a.args[0]) {
        Some(v) =>
        if v <= 0 || (v & (v - 1)) != 0 {
          return Err(wgsl_val_err(a.line, a.col, "@align must be a positive power of two"))
        }
        None => return Err(wgsl_val_err(a.line, a.col, "invalid @align argument"))
      }
    } else if a.name == "size" {
      if a.args.length() != 1 {
        return Err(wgsl_val_err(a.line, a.col, "@size requires 1 integer argument"))
      }
      match wgsl_parse_int_str(a.args[0]) {
        Some(v) =>
        if v <= 0 {
          return Err(wgsl_val_err(a.line, a.col, "@size must be positive"))
        }
        None => return Err(wgsl_val_err(a.line, a.col, "invalid @size argument"))
      }
    }
    i = i + 1
  }
  Ok(())
}

fn wgsl_type_to_str(ty : WgslType) -> String {
  match ty {
    WgslType::Scalar(s) => s
    WgslType::Vec(d, e) => "vec" + d.to_string() + "<" + e + ">"
    WgslType::Mat(c, r, e) => "mat" + c.to_string() + "x" + r.to_string() + "<" + e + ">"
    WgslType::Array(elem, len, len_ident) =>
    if len > 0 {
      "array<" + wgsl_type_to_str(elem) + ", " + len.to_string() + ">"
    } else if len_ident.length() > 0 {
      "array<" + wgsl_type_to_str(elem) + ", " + len_ident + ">"
    } else {
      "array<" + wgsl_type_to_str(elem) + ">"
    }
    WgslType::Texture(kind, elem, acc) =>
    if elem.length() == 0 {
      kind
    } else if acc.length() > 0 {
      kind + "<" + elem + ", " + acc + ">"
    } else {
      kind + "<" + elem + ">"
    }
    WgslType::Sampler(is_comp) => if is_comp { "sampler_comparison" } else { "sampler" }
    WgslType::Atomic(e) => "atomic<" + e + ">"
    WgslType::Named(n) => n
    WgslType::Ptr(sp, elem, acc) =>
    if acc.length() > 0 {
      "ptr<" + sp + ", " + wgsl_type_to_str(elem) + ", " + acc + ">"
    } else {
      "ptr<" + sp + ", " + wgsl_type_to_str(elem) + ">"
    }
  }
}

fn msl_entry_name(name : String) -> String {
  if name == "main" {
    "main0"
  } else {
    name
  }
}

// --- Semantic Types & Constant Evaluation ---

enum SemType {
  Void
  AbstractInt
  AbstractFloat
  Scalar(String)
  Vec(Int, String)
  Mat(Int, Int, String)
  Array(SemType, Int)
  Struct(String)
  Texture(String, String, String)
  Sampler(Bool)
  Atomic(String)
  Ptr(String, SemType, String)
  ModfRes(SemType)
  FrexpRes(SemType)
  AtomicCmpExchRes(String)
}

enum ConstVal {
  CInt(Int64)
  CBool(Bool)
}

struct VarSymbol {
  ty : SemType
  mutable : Bool
  addr_space : String
  access : String
}

fn sem_concretize(t : SemType) -> SemType {
  match t {
    SemType::AbstractInt => SemType::Scalar("i32")
    SemType::AbstractFloat => SemType::Scalar("f32")
    SemType::Vec(d, e) =>
    if e == "abstract_int" {
      SemType::Vec(d, "i32")
    } else if e == "abstract_float" {
      SemType::Vec(d, "f32")
    } else {
      t
    }
    _ => t
  }
}

fn sem_scalar_name(t : SemType) -> String {
  match t {
    SemType::Scalar(s) => s
    SemType::AbstractInt => "abstract_int"
    SemType::AbstractFloat => "abstract_float"
    SemType::Vec(_, e) => e
    SemType::Mat(_, _, e) => e
    _ => ""
  }
}

fn sem_is_float_scalar(s : String) -> Bool {
  s == "f32" || s == "f16" || s == "abstract_float"
}

fn sem_is_int_scalar(s : String) -> Bool {
  s == "i32" || s == "u32" || s == "abstract_int"
}

fn sem_is_float_type(t : SemType) -> Bool {
  match t {
    SemType::AbstractFloat => true
    SemType::Scalar(s) => s == "f32" || s == "f16"
    SemType::Vec(_, e) => sem_is_float_scalar(e)
    SemType::Mat(_, _, _) => true
    _ => false
  }
}

fn sem_is_bool_type(t : SemType) -> Bool {
  match t {
    SemType::Scalar("bool") => true
    _ => false
  }
}

fn sem_is_handle_type(t : SemType) -> Bool {
  match t {
    SemType::Texture(_, _, _) | SemType::Sampler(_) => true
    _ => false
  }
}

fn sem_contains_runtime_array(t : SemType, structs : Map[String, WgslStructDecl], aliases : Map[String, WgslType]) -> Bool {
  match t {
    SemType::Array(elem, len) =>
    if len == 0 {
      true
    } else {
      sem_contains_runtime_array(elem, structs, aliases)
    }
    SemType::Struct(sn) =>
    match structs.get(sn) {
      Some(st) => {
        let mut i = 0
        while i < st.fields.length() {
          let ft = wgsl_type_to_sem(st.fields[i].ty, aliases, Map::new())
          if sem_contains_runtime_array(ft, structs, aliases) {
            return true
          }
          i = i + 1
        }
        false
      }
      None => false
    }
    _ => false
  }
}

fn sem_scalar_compat(expected : String, actual : String) -> Bool {
  if expected == actual {
    return true
  }
  if actual == "abstract_int" {
    return expected == "i32" || expected == "u32" || expected == "f32" || expected == "f16" || expected == "abstract_float"
  }
  if actual == "abstract_float" {
    return expected == "f32" || expected == "f16"
  }
  if expected == "abstract_int" {
    return actual == "i32" || actual == "u32" || actual == "f32" || actual == "f16" || actual == "abstract_float"
  }
  if expected == "abstract_float" {
    return actual == "f32" || actual == "f16" || actual == "abstract_int"
  }
  false
}

fn sem_types_compatible(expected : SemType, actual : SemType) -> Bool {
  match (expected, actual) {
    (SemType::Scalar(e), SemType::Scalar(a)) => sem_scalar_compat(e, a)
    (SemType::Scalar(e), SemType::AbstractInt) => sem_scalar_compat(e, "abstract_int")
    (SemType::Scalar(e), SemType::AbstractFloat) => sem_scalar_compat(e, "abstract_float")
    (SemType::AbstractInt, SemType::Scalar(a)) => sem_scalar_compat("abstract_int", a)
    (SemType::AbstractFloat, SemType::Scalar(a)) => sem_scalar_compat("abstract_float", a)
    (SemType::AbstractInt, SemType::AbstractInt) => true
    (SemType::AbstractFloat, SemType::AbstractFloat) => true
    (SemType::AbstractFloat, SemType::AbstractInt) => true
    (SemType::AbstractInt, SemType::AbstractFloat) => true
    (SemType::Vec(d1, e1), SemType::Vec(d2, e2)) => d1 == d2 && sem_scalar_compat(e1, e2)
    (SemType::Mat(c1, r1, e1), SemType::Mat(c2, r2, e2)) => c1 == c2 && r1 == r2 && sem_scalar_compat(e1, e2)
    (SemType::Struct(s1), SemType::Struct(s2)) => s1 == s2
    (SemType::Array(e1, l1), SemType::Array(e2, l2)) => (l1 == l2 || l1 == 0 || l2 == 0) && sem_types_compatible(e1, e2)
    (SemType::Ptr(_, e1, _), SemType::Ptr(_, e2, _)) => sem_types_compatible(e1, e2)
    (SemType::Atomic(e1), SemType::Atomic(e2)) => e1 == e2
    (SemType::Texture(k1, _, _), SemType::Texture(k2, _, _)) => k1 == k2
    (SemType::Sampler(c1), SemType::Sampler(c2)) => c1 == c2
    (SemType::Void, SemType::Void) => true
    _ => false
  }
}

fn sem_promote_scalar(a : String, b : String) -> String {
  if a == b {
    return a
  }
  if a == "abstract_int" {
    return b
  }
  if b == "abstract_int" {
    return a
  }
  if a == "abstract_float" {
    return if b == "f16" { "f16" } else { "f32" }
  }
  if b == "abstract_float" {
    return if a == "f16" { "f16" } else { "f32" }
  }
  a
}

fn sem_to_wgsl_type(t : SemType) -> WgslType {
  match sem_concretize(t) {
    SemType::Scalar(s) => WgslType::Scalar(s)
    SemType::Vec(d, e) => WgslType::Vec(d, e)
    SemType::Mat(c, r, e) => WgslType::Mat(c, r, e)
    SemType::Array(elem, len) => WgslType::Array(sem_to_wgsl_type(elem), len, "")
    SemType::Struct(n) => WgslType::Named(n)
    SemType::Texture(k, e, a) => WgslType::Texture(k, e, a)
    SemType::Sampler(c) => WgslType::Sampler(c)
    SemType::Atomic(e) => WgslType::Atomic(e)
    SemType::Ptr(sp, elem, acc) => WgslType::Ptr(sp, sem_to_wgsl_type(elem), acc)
    _ => WgslType::Scalar("f32")
  }
}

fn wgsl_resolve_alias_depth(
  ty : WgslType,
  aliases : Map[String, WgslType],
  depth : Int,
) -> WgslType {
  if depth > 32 {
    return ty
  }
  match ty {
    WgslType::Named(n) =>
    match aliases.get(n) {
      Some(target) => wgsl_resolve_alias_depth(target, aliases, depth + 1)
      None => ty
    }
    _ => ty
  }
}

fn wgsl_type_to_sem(
  ty : WgslType,
  aliases : Map[String, WgslType],
  const_ints : Map[String, Int64],
) -> SemType {
  let resolved = wgsl_resolve_alias_depth(ty, aliases, 0)
  match resolved {
    WgslType::Scalar(s) => SemType::Scalar(s)
    WgslType::Vec(d, e) => {
      let er = match aliases.get(e) {
        Some(t) =>
        match wgsl_resolve_alias_depth(t, aliases, 0) {
          WgslType::Scalar(sc) => sc
          _ => e
        }
        None => e
      }
      SemType::Vec(d, er)
    }
    WgslType::Mat(c, r, e) => {
      let er = match aliases.get(e) {
        Some(t) =>
        match wgsl_resolve_alias_depth(t, aliases, 0) {
          WgslType::Scalar(sc) => sc
          _ => e
        }
        None => e
      }
      SemType::Mat(c, r, er)
    }
    WgslType::Array(elem, len, len_ident) => {
      let n = if len > 0 {
        len
      } else if len_ident.length() > 0 {
        match const_ints.get(len_ident) {
          Some(v) => v.to_int()
          None => 0
        }
      } else {
        0
      }
      SemType::Array(wgsl_type_to_sem(elem, aliases, const_ints), n)
    }
    WgslType::Texture(k, e, a) => SemType::Texture(k, e, a)
    WgslType::Sampler(c) => SemType::Sampler(c)
    WgslType::Atomic(e) => SemType::Atomic(e)
    WgslType::Named(n) => SemType::Struct(n)
    WgslType::Ptr(sp, elem, acc) => SemType::Ptr(sp, wgsl_type_to_sem(elem, aliases, const_ints), acc)
  }
}

fn wgsl_eval_const(expr : WgslExpr, consts : Map[String, ConstVal]) -> Option[ConstVal] {
  match expr {
    WgslExpr::IntLit(s, _, _) =>
    match wgsl_parse_i64_str(s) {
      Some(v) => Some(ConstVal::CInt(v))
      None => None
    }
    WgslExpr::BoolLit(b, _, _) => Some(ConstVal::CBool(b))
    WgslExpr::Ident(name, _, _) => consts.get(name)
    WgslExpr::Paren(inner, _, _) => wgsl_eval_const(inner, consts)
    WgslExpr::Unary(op, inner, _, _) =>
    match wgsl_eval_const(inner, consts) {
      Some(ConstVal::CInt(v)) =>
      if op == "-" {
        Some(ConstVal::CInt(0L - v))
      } else if op == "~" {
        Some(ConstVal::CInt(-1L - v))
      } else {
        None
      }
      Some(ConstVal::CBool(b)) =>
      if op == "!" {
        Some(ConstVal::CBool(!b))
      } else {
        None
      }
      None => None
    }
    WgslExpr::Binary(op, l, r, _, _) =>
    match (wgsl_eval_const(l, consts), wgsl_eval_const(r, consts)) {
      (Some(ConstVal::CInt(a)), Some(ConstVal::CInt(b))) =>
      if op == "+" {
        Some(ConstVal::CInt(a + b))
      } else if op == "-" {
        Some(ConstVal::CInt(a - b))
      } else if op == "*" {
        Some(ConstVal::CInt(a * b))
      } else if op == "/" {
        if b == 0L { None } else { Some(ConstVal::CInt(a / b)) }
      } else if op == "%" {
        if b == 0L { None } else { Some(ConstVal::CInt(a % b)) }
      } else if op == "<<" {
        Some(ConstVal::CInt(a << b.to_int()))
      } else if op == ">>" {
        Some(ConstVal::CInt(a >> b.to_int()))
      } else if op == "&" {
        Some(ConstVal::CInt(a & b))
      } else if op == "|" {
        Some(ConstVal::CInt(a | b))
      } else if op == "^" {
        Some(ConstVal::CInt(a ^ b))
      } else if op == "==" {
        Some(ConstVal::CBool(a == b))
      } else if op == "!=" {
        Some(ConstVal::CBool(a != b))
      } else if op == "<" {
        Some(ConstVal::CBool(a < b))
      } else if op == "<=" {
        Some(ConstVal::CBool(a <= b))
      } else if op == ">" {
        Some(ConstVal::CBool(a > b))
      } else if op == ">=" {
        Some(ConstVal::CBool(a >= b))
      } else {
        None
      }
      (Some(ConstVal::CBool(a)), Some(ConstVal::CBool(b))) =>
      if op == "&&" {
        Some(ConstVal::CBool(a && b))
      } else if op == "||" {
        Some(ConstVal::CBool(a || b))
      } else if op == "==" {
        Some(ConstVal::CBool(a == b))
      } else if op == "!=" {
        Some(ConstVal::CBool(a != b))
      } else {
        None
      }
      _ => None
    }
    WgslExpr::Call(name, _, _, _, args, _, _) =>
    if (name == "u32" || name == "i32") && args.length() == 1 {
      wgsl_eval_const(args[0], consts)
    } else if name == "bool" && args.length() == 1 {
      match wgsl_eval_const(args[0], consts) {
        Some(ConstVal::CBool(b)) => Some(ConstVal::CBool(b))
        Some(ConstVal::CInt(v)) => Some(ConstVal::CBool(v != 0L))
        None => None
      }
    } else {
      None
    }
    _ => None
  }
}

// --- Type Reference & Cycle Validation ---

fn wgsl_validate_type_refs(
  ty : WgslType,
  known_types : Map[String, Bool],
  aliases : Map[String, WgslType],
  const_ints : Map[String, Int64],
  line : Int,
  col : Int,
) -> Result[Unit, WgslError] {
  match ty {
    WgslType::Scalar(_) => Ok(())
    WgslType::Vec(_, elem) => {
      let resolved = match aliases.get(elem) {
        Some(t) => wgsl_resolve_alias_depth(t, aliases, 0)
        None =>
        if elem == "f32" || elem == "f16" || elem == "i32" || elem == "u32" || elem == "bool" {
          WgslType::Scalar(elem)
        } else {
          WgslType::Named(elem)
        }
      }
      match resolved {
        WgslType::Scalar(_) => Ok(())
        _ => Err(wgsl_val_err(line, col, "invalid vector element type '" + elem + "'"))
      }
    }
    WgslType::Mat(_, _, elem) => {
      let resolved = match aliases.get(elem) {
        Some(t) => wgsl_resolve_alias_depth(t, aliases, 0)
        None =>
        if elem == "f32" || elem == "f16" {
          WgslType::Scalar(elem)
        } else {
          WgslType::Named(elem)
        }
      }
      match resolved {
        WgslType::Scalar(s) =>
        if s == "f32" || s == "f16" {
          Ok(())
        } else {
          Err(wgsl_val_err(line, col, "invalid matrix element type '" + elem + "'"))
        }
        _ => Err(wgsl_val_err(line, col, "invalid matrix element type '" + elem + "'"))
      }
    }
    WgslType::Texture(kind, elem, acc) =>
    if kind == "texture_storage_1d" || kind == "texture_storage_2d" ||
    kind == "texture_storage_2d_array" || kind == "texture_storage_3d" {
      if !wgsl_is_valid_storage_format(elem) {
        return Err(wgsl_val_err(line, col, "unknown storage texture format '" + elem + "'"))
      }
      if acc != "read" && acc != "write" && acc != "read_write" {
        return Err(wgsl_val_err(line, col, "invalid storage texture access mode '" + acc + "'"))
      }
      Ok(())
    } else if elem.length() > 0 {
      if elem != "f32" && elem != "i32" && elem != "u32" {
        return Err(wgsl_val_err(line, col, "sampled texture element type must be f32, i32, or u32, got '" + elem + "'"))
      }
      Ok(())
    } else {
      Ok(())
    }
    WgslType::Sampler(_) => Ok(())
    WgslType::Atomic(elem) =>
    if elem == "u32" || elem == "i32" {
      Ok(())
    } else {
      Err(wgsl_val_err(line, col, "atomic element type must be i32 or u32, got '" + elem + "'"))
    }
    WgslType::Named(n) =>
    match known_types.get(n) {
      Some(_) => Ok(())
      None => Err(wgsl_val_err(line, col, "undeclared type '" + n + "'"))
    }
    WgslType::Array(elem, len, len_ident) => {
      if len == 0 && len_ident.length() > 0 {
        match const_ints.get(len_ident) {
          Some(v) =>
          if v <= 0L {
            return Err(wgsl_val_err(line, col, "array length '" + len_ident + "' must be positive"))
          }
          None => return Err(wgsl_val_err(line, col, "undeclared array length const '" + len_ident + "'"))
        }
      }
      wgsl_validate_type_refs(elem, known_types, aliases, const_ints, line, col)
    }
    WgslType::Ptr(sp, elem, acc) => {
      if sp != "function" && sp != "private" && sp != "workgroup" && sp != "uniform" && sp != "storage" {
        return Err(wgsl_val_err(line, col, "unknown pointer address space '" + sp + "'"))
      }
      if acc.length() > 0 && acc != "read" && acc != "write" && acc != "read_write" {
        return Err(wgsl_val_err(line, col, "unknown pointer access mode '" + acc + "'"))
      }
      wgsl_validate_type_refs(elem, known_types, aliases, const_ints, line, col)
    }
  }
}

fn wgsl_collect_type_deps(ty : WgslType, deps : Array[String]) -> Unit {
  match ty {
    WgslType::Named(n) => deps.push(n)
    WgslType::Array(elem, _, _) => wgsl_collect_type_deps(elem, deps)
    WgslType::Ptr(_, elem, _) => wgsl_collect_type_deps(elem, deps)
    _ => ()
  }
}

fn wgsl_check_type_cycle(
  name : String,
  alias_map : Map[String, WgslType],
  struct_map : Map[String, WgslStructDecl],
  state : Map[String, Int],
  line : Int,
  col : Int,
) -> Result[Unit, WgslError] {
  match state.get(name) {
    Some(1) => return Err(wgsl_val_err(line, col, "recursive type definition involving '" + name + "'"))
    Some(2) => return Ok(())
    _ => ()
  }
  state.set(name, 1)
  let deps : Array[String] = []
  match alias_map.get(name) {
    Some(t) => wgsl_collect_type_deps(t, deps)
    None =>
    match struct_map.get(name) {
      Some(st) => {
        let mut fi = 0
        while fi < st.fields.length() {
          wgsl_collect_type_deps(st.fields[fi].ty, deps)
          fi = fi + 1
        }
      }
      None => ()
    }
  }
  let mut i = 0
  while i < deps.length() {
    match wgsl_check_type_cycle(deps[i], alias_map, struct_map, state, line, col) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  state.set(name, 2)
  Ok(())
}

// --- Swizzle & Builtin Type Checker ---

fn wgsl_check_swizzle(dim : Int, elem : String, fld : String, line : Int, col : Int) -> Result[SemType, WgslError] {
  let n = fld.length()
  if n < 1 || n > 4 {
    return Err(wgsl_val_err(line, col, "invalid vector swizzle '." + fld + "'"))
  }
  let mut is_xyzw = true
  let mut is_rgba = true
  let mut i = 0
  while i < n {
    let c = fld.code_unit_at(i)
    let idx_xyzw = if c == 120 { 0 } else if c == 121 { 1 } else if c == 122 { 2 } else if c == 119 { 3 } else { -1 }
    let idx_rgba = if c == 114 { 0 } else if c == 103 { 1 } else if c == 98 { 2 } else if c == 97 { 3 } else { -1 }
    if idx_xyzw < 0 || idx_xyzw >= dim {
      is_xyzw = false
    }
    if idx_rgba < 0 || idx_rgba >= dim {
      is_rgba = false
    }
    i = i + 1
  }
  if !is_xyzw && !is_rgba {
    return Err(wgsl_val_err(line, col, "invalid vector swizzle '." + fld + "' for vec" + dim.to_string()))
  }
  if n == 1 {
    Ok(SemType::Scalar(elem))
  } else {
    Ok(SemType::Vec(n, elem))
  }
}

struct SemCtx {
  aliases : Map[String, WgslType]
  structs : Map[String, WgslStructDecl]
  funcs : Map[String, WgslFuncDecl]
  const_vals : Map[String, ConstVal]
  const_ints : Map[String, Int64]
  scopes : Array[Map[String, VarSymbol]]
  called_funcs : Array[String]
  mut has_discard : Bool
}

fn SemCtx::lookup(self : SemCtx, name : String) -> Option[VarSymbol] {
  let mut i = self.scopes.length() - 1
  while i >= 0 {
    match self.scopes[i].get(name) {
      Some(s) => return Some(s)
      None => ()
    }
    i = i - 1
  }
  None
}

fn SemCtx::define(self : SemCtx, name : String, sym : VarSymbol) -> Unit {
  if self.scopes.length() > 0 {
    self.scopes[self.scopes.length() - 1].set(name, sym)
  }
}

fn SemCtx::push_scope(self : SemCtx) -> Unit {
  self.scopes.push(Map::new())
}

fn SemCtx::pop_scope(self : SemCtx) -> Unit {
  if self.scopes.length() > 1 {
    let _ = self.scopes.pop()
  }
}

fn SemCtx::check_writable_lvalue(self : SemCtx, expr : WgslExpr) -> Result[Unit, WgslError] {
  match expr {
    WgslExpr::Ident(name, line, col) =>
    match self.lookup(name) {
      Some(sym) =>
      if sym.mutable {
        Ok(())
      } else {
        Err(wgsl_val_err(line, col, "cannot assign to immutable binding '" + name + "'"))
      }
      None => Err(wgsl_val_err(line, col, "undeclared identifier '" + name + "'"))
    }
    WgslExpr::Index(base, _, _, _) => self.check_writable_lvalue(base)
    WgslExpr::Field(base, _, _, _) => self.check_writable_lvalue(base)
    WgslExpr::Paren(inner, _, _) => self.check_writable_lvalue(inner)
    WgslExpr::Unary(op, inner, line, col) =>
    if op == "*" {
      match self.check_expr(inner) {
        Ok(SemType::Ptr(sp, _, acc)) =>
        if sp == "uniform" || acc == "read" {
          Err(wgsl_val_err(line, col, "cannot write through read-only pointer"))
        } else {
          Ok(())
        }
        Ok(_) => Err(wgsl_val_err(line, col, "cannot dereference non-pointer expression"))
        Err(e) => Err(e)
      }
    } else {
      Err(wgsl_val_err(line, col, "expression is not assignable"))
    }
    _ => Err(wgsl_val_err(0, 0, "expression is not assignable"))
  }
}

fn SemCtx::check_builtin_call(
  self : SemCtx,
  name : String,
  targs : Array[WgslType],
  arr_len : Int,
  len_ident : String,
  arg_types : Array[SemType],
  line : Int,
  col : Int,
) -> Result[Option[SemType], WgslError] {
  let argc = arg_types.length()
  // Scalar constructors
  if name == "f32" || name == "f16" || name == "i32" || name == "u32" || name == "bool" {
    if argc > 1 {
      return Err(wgsl_val_err(line, col, "'" + name + "' constructor expects 0 or 1 argument, got " + argc.to_string()))
    }
    return Ok(Some(SemType::Scalar(name)))
  }
  // Vector constructors
  if name == "vec2" || name == "vec3" || name == "vec4" {
    let dim = name.code_unit_at(3) - 48
    let elem = if targs.length() == 1 {
      match wgsl_type_to_sem(targs[0], self.aliases, self.const_ints) {
        SemType::Scalar(s) => s
        _ => return Err(wgsl_val_err(line, col, "invalid vector element type"))
      }
    } else if argc > 0 {
      let s = sem_scalar_name(sem_concretize(arg_types[0]))
      if s.length() > 0 { s } else { "f32" }
    } else {
      "f32"
    }
    return Ok(Some(SemType::Vec(dim, elem)))
  }
  // Vector/matrix short aliases (vec2f, mat4x4f, ...)
  match wgsl_resolve_vec_alias(name) {
    Some(vt) => return Ok(Some(wgsl_type_to_sem(vt, self.aliases, self.const_ints)))
    None => ()
  }
  // Matrix constructors
  if name == "mat2x2" || name == "mat3x3" || name == "mat4x4" ||
  name == "mat2x3" || name == "mat2x4" || name == "mat3x2" ||
  name == "mat3x4" || name == "mat4x2" || name == "mat4x3" {
    let cols = name.code_unit_at(3) - 48
    let rows = name.code_unit_at(5) - 48
    let elem = if targs.length() == 1 {
      match wgsl_type_to_sem(targs[0], self.aliases, self.const_ints) {
        SemType::Scalar(s) => s
        _ => return Err(wgsl_val_err(line, col, "invalid matrix element type"))
      }
    } else {
      "f32"
    }
    return Ok(Some(SemType::Mat(cols, rows, elem)))
  }
  // Array constructor
  if name == "array" {
    let elem_ty = if targs.length() == 1 {
      wgsl_type_to_sem(targs[0], self.aliases, self.const_ints)
    } else if argc > 0 {
      sem_concretize(arg_types[0])
    } else {
      SemType::Scalar("f32")
    }
    let n = if arr_len > 0 {
      arr_len
    } else if len_ident.length() > 0 {
      match self.const_ints.get(len_ident) {
        Some(v) => v.to_int()
        None => argc
      }
    } else {
      argc
    }
    return Ok(Some(SemType::Array(elem_ty, n)))
  }
  // bitcast<T>(x)
  if name == "bitcast" {
    if targs.length() != 1 || argc != 1 {
      return Err(wgsl_val_err(line, col, "bitcast requires 1 type argument and 1 value argument"))
    }
    return Ok(Some(wgsl_type_to_sem(targs[0], self.aliases, self.const_ints)))
  }
  // Barriers
  if name == "workgroupBarrier" || name == "storageBarrier" || name == "textureBarrier" {
    if argc != 0 {
      return Err(wgsl_val_err(line, col, "'" + name + "' takes 0 arguments"))
    }
    return Ok(Some(SemType::Void))
  }
  // arrayLength
  if name == "arrayLength" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'arrayLength' takes 1 argument"))
    }
    return Ok(Some(SemType::Scalar("u32")))
  }
  // 1-arg math & bit builtins (T -> T)
  if name == "abs" || name == "acos" || name == "acosh" || name == "asin" || name == "asinh" ||
  name == "atan" || name == "atanh" || name == "ceil" || name == "cos" || name == "cosh" ||
  name == "degrees" || name == "exp" || name == "exp2" || name == "floor" || name == "fract" ||
  name == "inverseSqrt" || name == "log" || name == "log2" || name == "quantizeToF16" ||
  name == "radians" || name == "round" || name == "saturate" || name == "sign" ||
  name == "sin" || name == "sinh" || name == "sqrt" || name == "tan" || name == "tanh" ||
  name == "trunc" || name == "dpdx" || name == "dpdxCoarse" || name == "dpdxFine" ||
  name == "dpdy" || name == "dpdyCoarse" || name == "dpdyFine" ||
  name == "fwidth" || name == "fwidthCoarse" || name == "fwidthFine" ||
  name == "countLeadingZeros" || name == "countOneBits" || name == "countTrailingZeros" ||
  name == "firstLeadingBit" || name == "firstTrailingBit" || name == "reverseBits" ||
  name == "normalize" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'" + name + "' expects 1 argument, got " + argc.to_string()))
    }
    return Ok(Some(sem_concretize(arg_types[0])))
  }
  // modf / frexp
  if name == "modf" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'modf' expects 1 argument"))
    }
    return Ok(Some(SemType::ModfRes(sem_concretize(arg_types[0]))))
  }
  if name == "frexp" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'frexp' expects 1 argument"))
    }
    return Ok(Some(SemType::FrexpRes(sem_concretize(arg_types[0]))))
  }
  // 2-arg math builtins
  if name == "atan2" || name == "max" || name == "min" || name == "pow" || name == "step" ||
  name == "ldexp" || name == "reflect" {
    if argc != 2 {
      return Err(wgsl_val_err(line, col, "'" + name + "' expects 2 arguments, got " + argc.to_string()))
    }
    return Ok(Some(sem_concretize(arg_types[0])))
  }
  if name == "dot" {
    if argc != 2 {
      return Err(wgsl_val_err(line, col, "'dot' expects 2 arguments, got " + argc.to_string()))
    }
    let sc = sem_scalar_name(sem_concretize(arg_types[0]))
    return Ok(Some(SemType::Scalar(if sc.length() > 0 { sc } else { "f32" })))
  }
  if name == "cross" {
    if argc != 2 {
      return Err(wgsl_val_err(line, col, "'cross' expects 2 arguments, got " + argc.to_string()))
    }
    return Ok(Some(sem_concretize(arg_types[0])))
  }
  if name == "length" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'length' expects 1 argument, got " + argc.to_string()))
    }
    let sc = sem_scalar_name(sem_concretize(arg_types[0]))
    return Ok(Some(SemType::Scalar(if sc == "f16" { "f16" } else { "f32" })))
  }
  if name == "distance" {
    if argc != 2 {
      return Err(wgsl_val_err(line, col, "'distance' expects 2 arguments, got " + argc.to_string()))
    }
    let sc = sem_scalar_name(sem_concretize(arg_types[0]))
    return Ok(Some(SemType::Scalar(if sc == "f16" { "f16" } else { "f32" })))
  }
  if name == "determinant" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'determinant' expects 1 argument"))
    }
    let sc = sem_scalar_name(sem_concretize(arg_types[0]))
    return Ok(Some(SemType::Scalar(if sc == "f16" { "f16" } else { "f32" })))
  }
  if name == "transpose" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'transpose' expects 1 argument"))
    }
    match arg_types[0] {
      SemType::Mat(c, r, e) => return Ok(Some(SemType::Mat(r, c, e)))
      _ => return Ok(Some(arg_types[0]))
    }
  }
  if name == "all" || name == "any" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'" + name + "' expects 1 argument"))
    }
    return Ok(Some(SemType::Scalar("bool")))
  }
  // 3-arg math / select / extractBits
  if name == "clamp" || name == "fma" || name == "mix" || name == "smoothstep" ||
  name == "faceForward" || name == "refract" || name == "extractBits" || name == "select" {
    if argc != 3 {
      return Err(wgsl_val_err(line, col, "'" + name + "' expects 3 arguments, got " + argc.to_string()))
    }
    return Ok(Some(sem_concretize(arg_types[0])))
  }
  if name == "insertBits" {
    if argc != 4 {
      return Err(wgsl_val_err(line, col, "'insertBits' expects 4 arguments, got " + argc.to_string()))
    }
    return Ok(Some(sem_concretize(arg_types[0])))
  }
  // Pack / unpack
  if name == "pack4x8snorm" || name == "pack4x8unorm" || name == "pack2x16snorm" ||
  name == "pack2x16unorm" || name == "pack2x16float" || name == "pack4xI8" ||
  name == "pack4xU8" || name == "pack4xI8Clamp" || name == "pack4xU8Clamp" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'" + name + "' expects 1 argument"))
    }
    return Ok(Some(SemType::Scalar("u32")))
  }
  if name == "unpack4x8snorm" || name == "unpack4x8unorm" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'" + name + "' expects 1 argument"))
    }
    return Ok(Some(SemType::Vec(4, "f32")))
  }
  if name == "unpack2x16snorm" || name == "unpack2x16unorm" || name == "unpack2x16float" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'" + name + "' expects 1 argument"))
    }
    return Ok(Some(SemType::Vec(2, "f32")))
  }
  if name == "unpack4xI8" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'unpack4xI8' expects 1 argument"))
    }
    return Ok(Some(SemType::Vec(4, "i32")))
  }
  if name == "unpack4xU8" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'unpack4xU8' expects 1 argument"))
    }
    return Ok(Some(SemType::Vec(4, "u32")))
  }
  // Atomics
  if name == "atomicLoad" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'atomicLoad' expects 1 argument"))
    }
    let elem = match arg_types[0] {
      SemType::Ptr(_, SemType::Atomic(e), _) => e
      _ => "u32"
    }
    return Ok(Some(SemType::Scalar(elem)))
  }
  if name == "atomicStore" {
    if argc != 2 {
      return Err(wgsl_val_err(line, col, "'atomicStore' expects 2 arguments"))
    }
    return Ok(Some(SemType::Void))
  }
  if name == "atomicAdd" || name == "atomicSub" || name == "atomicMax" || name == "atomicMin" ||
  name == "atomicAnd" || name == "atomicOr" || name == "atomicXor" || name == "atomicExchange" {
    if argc != 2 {
      return Err(wgsl_val_err(line, col, "'" + name + "' expects 2 arguments"))
    }
    let elem = match arg_types[0] {
      SemType::Ptr(_, SemType::Atomic(e), _) => e
      _ => "u32"
    }
    return Ok(Some(SemType::Scalar(elem)))
  }
  if name == "atomicCompareExchangeWeak" {
    if argc != 3 {
      return Err(wgsl_val_err(line, col, "'atomicCompareExchangeWeak' expects 3 arguments"))
    }
    let elem = match arg_types[0] {
      SemType::Ptr(_, SemType::Atomic(e), _) => e
      _ => "u32"
    }
    return Ok(Some(SemType::AtomicCmpExchRes(elem)))
  }
  // Textures
  if name == "textureDimensions" {
    if argc < 1 || argc > 2 {
      return Err(wgsl_val_err(line, col, "'textureDimensions' expects 1 or 2 arguments"))
    }
    match arg_types[0] {
      SemType::Texture(tk, _, _) =>
      if tk == "texture_1d" || tk == "texture_storage_1d" {
        return Ok(Some(SemType::Scalar("u32")))
      } else if tk == "texture_3d" || tk == "texture_storage_3d" {
        return Ok(Some(SemType::Vec(3, "u32")))
      } else {
        return Ok(Some(SemType::Vec(2, "u32")))
      }
      _ => return Ok(Some(SemType::Vec(2, "u32")))
    }
  }
  if name == "textureNumLayers" || name == "textureNumLevels" || name == "textureNumSamples" {
    if argc != 1 {
      return Err(wgsl_val_err(line, col, "'" + name + "' expects 1 argument"))
    }
    return Ok(Some(SemType::Scalar("u32")))
  }
  if name == "textureLoad" {
    if argc < 2 || argc > 4 {
      return Err(wgsl_val_err(line, col, "'textureLoad' expects 2 to 4 arguments"))
    }
    match arg_types[0] {
      SemType::Texture(tk, elem, _) =>
      if tk == "texture_depth_2d" || tk == "texture_depth_2d_array" || tk == "texture_depth_multisampled_2d" {
        return Ok(Some(SemType::Scalar("f32")))
      } else if tk == "texture_storage_1d" || tk == "texture_storage_2d" ||
      tk == "texture_storage_2d_array" || tk == "texture_storage_3d" {
        return Ok(Some(SemType::Vec(4, wgsl_storage_format_scalar(elem))))
      } else {
        return Ok(Some(SemType::Vec(4, if elem.length() > 0 { elem } else { "f32" })))
      }
      _ => return Ok(Some(SemType::Vec(4, "f32")))
    }
  }
  if name == "textureStore" {
    if argc < 3 || argc > 4 {
      return Err(wgsl_val_err(line, col, "'textureStore' expects 3 or 4 arguments"))
    }
    return Ok(Some(SemType::Void))
  }
  if name == "textureSample" {
    if argc < 3 || argc > 5 {
      return Err(wgsl_val_err(line, col, "'textureSample' expects 3 to 5 arguments"))
    }
    match arg_types[0] {
      SemType::Texture(tk, _, _) =>
      if tk == "texture_depth_2d" || tk == "texture_depth_2d_array" ||
      tk == "texture_depth_cube" || tk == "texture_depth_cube_array" {
        return Ok(Some(SemType::Scalar("f32")))
      } else {
        return Ok(Some(SemType::Vec(4, "f32")))
      }
      _ => return Ok(Some(SemType::Vec(4, "f32")))
    }
  }
  if name == "textureSampleBias" || name == "textureSampleLevel" {
    if argc < 4 || argc > 6 {
      return Err(wgsl_val_err(line, col, "'" + name + "' expects 4 to 6 arguments"))
    }
    match arg_types[0] {
      SemType::Texture(tk, _, _) =>
      if tk == "texture_depth_2d" || tk == "texture_depth_2d_array" ||
      tk == "texture_depth_cube" || tk == "texture_depth_cube_array" {
        return Ok(Some(SemType::Scalar("f32")))
      } else {
        return Ok(Some(SemType::Vec(4, "f32")))
      }
      _ => return Ok(Some(SemType::Vec(4, "f32")))
    }
  }
  if name == "textureSampleGrad" {
    if argc < 5 || argc > 7 {
      return Err(wgsl_val_err(line, col, "'textureSampleGrad' expects 5 to 7 arguments"))
    }
    return Ok(Some(SemType::Vec(4, "f32")))
  }
  if name == "textureSampleCompare" || name == "textureSampleCompareLevel" {
    if argc < 4 || argc > 6 {
      return Err(wgsl_val_err(line, col, "'" + name + "' expects 4 to 6 arguments"))
    }
    return Ok(Some(SemType::Scalar("f32")))
  }
  if name == "textureGather" {
    if argc < 3 || argc > 6 {
      return Err(wgsl_val_err(line, col, "'textureGather' expects 3 to 6 arguments"))
    }
    let tex_arg = match arg_types[0] {
      SemType::Texture(_, _, _) => arg_types[0]
      _ => if argc >= 2 { arg_types[1] } else { arg_types[0] }
    }
    match tex_arg {
      SemType::Texture(_, elem, _) =>
      return Ok(Some(SemType::Vec(4, if elem.length() > 0 { elem } else { "f32" })))
      _ => return Ok(Some(SemType::Vec(4, "f32")))
    }
  }
  if name == "textureGatherCompare" {
    if argc < 4 || argc > 6 {
      return Err(wgsl_val_err(line, col, "'textureGatherCompare' expects 4 to 6 arguments"))
    }
    return Ok(Some(SemType::Vec(4, "f32")))
  }
  Ok(None)
}

fn SemCtx::check_expr(self : SemCtx, expr : WgslExpr) -> Result[SemType, WgslError] {
  match expr {
    WgslExpr::Ident(name, line, col) =>
    match self.lookup(name) {
      Some(sym) => Ok(sym.ty)
      None => Err(wgsl_val_err(line, col, "undeclared identifier '" + name + "'"))
    }
    WgslExpr::IntLit(s, _, _) => {
      let n = s.length()
      if n > 0 && s.code_unit_at(n - 1) == 117 {
        Ok(SemType::Scalar("u32"))
      } else if n > 0 && s.code_unit_at(n - 1) == 105 {
        Ok(SemType::Scalar("i32"))
      } else {
        Ok(SemType::AbstractInt)
      }
    }
    WgslExpr::FloatLit(s, _, _) => {
      let n = s.length()
      if n > 0 && s.code_unit_at(n - 1) == 102 {
        Ok(SemType::Scalar("f32"))
      } else if n > 0 && s.code_unit_at(n - 1) == 104 {
        Ok(SemType::Scalar("f16"))
      } else {
        Ok(SemType::AbstractFloat)
      }
    }
    WgslExpr::BoolLit(_, _, _) => Ok(SemType::Scalar("bool"))
    WgslExpr::Paren(inner, _, _) => self.check_expr(inner)
    WgslExpr::Unary(op, inner, line, col) => {
      let it = match self.check_expr(inner) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if op == "&" {
        let (sp, acc) = self.expr_addr_space(inner)
        return Ok(SemType::Ptr(sp, it, acc))
      }
      if op == "*" {
        match it {
          SemType::Ptr(_, elem, _) => return Ok(elem)
          _ => return Err(wgsl_val_err(line, col, "cannot dereference non-pointer value"))
        }
      }
      if op == "!" {
        return Ok(it)
      }
      Ok(it)
    }
    WgslExpr::Binary(op, l, r, _, _) => {
      let lt = match self.check_expr(l) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let rt = match self.check_expr(r) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        match (lt, rt) {
          (SemType::Vec(d, _), _) | (_, SemType::Vec(d, _)) => return Ok(SemType::Vec(d, "bool"))
          _ => return Ok(SemType::Scalar("bool"))
        }
      }
      if op == "&&" || op == "||" {
        return Ok(SemType::Scalar("bool"))
      }
      // Matrix * Vector, Vector * Matrix, Matrix * Matrix
      match (lt, rt) {
        (SemType::Mat(_, rows, e), SemType::Vec(_, _)) => return Ok(SemType::Vec(rows, e))
        (SemType::Vec(_, _), SemType::Mat(cols, _, e)) => return Ok(SemType::Vec(cols, e))
        (SemType::Mat(_, r1, e), SemType::Mat(c2, _, _)) => return Ok(SemType::Mat(c2, r1, e))
        (SemType::Vec(d, e1), SemType::Vec(_, e2)) => return Ok(SemType::Vec(d, sem_promote_scalar(e1, e2)))
        (SemType::Vec(d, e1), _) => return Ok(SemType::Vec(d, sem_promote_scalar(e1, sem_scalar_name(rt))))
        (_, SemType::Vec(d, e2)) => return Ok(SemType::Vec(d, sem_promote_scalar(sem_scalar_name(lt), e2)))
        (SemType::AbstractInt, SemType::AbstractInt) => return Ok(SemType::AbstractInt)
        (SemType::AbstractFloat, SemType::AbstractFloat) => return Ok(SemType::AbstractFloat)
        (SemType::AbstractInt, SemType::AbstractFloat) | (SemType::AbstractFloat, SemType::AbstractInt) =>
        return Ok(SemType::AbstractFloat)
        (SemType::AbstractInt, _) => return Ok(rt)
        (_, SemType::AbstractInt) => return Ok(lt)
        (SemType::AbstractFloat, _) => return Ok(rt)
        (_, SemType::AbstractFloat) => return Ok(lt)
        _ => return Ok(lt)
      }
    }
    WgslExpr::Index(base, idx, line, col) => {
      let bt = match self.check_expr(base) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let _ = match self.check_expr(idx) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let unptr = match bt {
        SemType::Ptr(_, elem, _) => elem
        _ => bt
      }
      match unptr {
        SemType::Array(elem, _) => Ok(elem)
        SemType::Vec(_, e) => Ok(SemType::Scalar(e))
        SemType::Mat(_, r, e) => Ok(SemType::Vec(r, e))
        _ => Err(wgsl_val_err(line, col, "cannot index into non-array/vector/matrix expression"))
      }
    }
    WgslExpr::Field(base, fld, line, col) => {
      let bt = match self.check_expr(base) {
        Ok(t) => t
        Err(e) => return Err(e)
      }
      let unptr = match bt {
        SemType::Ptr(_, elem, _) => elem
        _ => bt
      }
      match unptr {
        SemType::Struct(sn) =>
        match self.structs.get(sn) {
          Some(st) => {
            let mut fi = 0
            while fi < st.fields.length() {
              if st.fields[fi].name == fld {
                return Ok(wgsl_type_to_sem(st.fields[fi].ty, self.aliases, self.const_ints))
              }
              fi = fi + 1
            }
            Err(wgsl_val_err(line, col, "struct '" + sn + "' has no field '" + fld + "'"))
          }
          None => Err(wgsl_val_err(line, col, "unknown struct '" + sn + "'"))
        }
        SemType::Vec(dim, elem) => wgsl_check_swizzle(dim, elem, fld, line, col)
        SemType::ModfRes(t) =>
        if fld == "fract" || fld == "whole" {
          Ok(t)
        } else {
          Err(wgsl_val_err(line, col, "modf result has no field '" + fld + "'"))
        }
        SemType::FrexpRes(t) =>
        if fld == "fract" {
          Ok(t)
        } else if fld == "exp" {
          match t {
            SemType::Vec(d, _) => Ok(SemType::Vec(d, "i32"))
            _ => Ok(SemType::Scalar("i32"))
          }
        } else {
          Err(wgsl_val_err(line, col, "frexp result has no field '" + fld + "'"))
        }
        SemType::AtomicCmpExchRes(e) =>
        if fld == "old_value" {
          Ok(SemType::Scalar(e))
        } else if fld == "exchanged" {
          Ok(SemType::Scalar("bool"))
        } else {
          Err(wgsl_val_err(line, col, "atomicCompareExchangeWeak result has no field '" + fld + "'"))
        }
        _ => Err(wgsl_val_err(line, col, "cannot access field '." + fld + "' on this type"))
      }
    }
    WgslExpr::Call(name, targs, arr_len, len_ident, args, line, col) => {
      let arg_types : Array[SemType] = []
      let mut i = 0
      while i < args.length() {
        let at = match self.check_expr(args[i]) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        arg_types.push(at)
        i = i + 1
      }
      // 1. User-defined function
      match self.funcs.get(name) {
        Some(f) => {
          if args.length() != f.params.length() {
            return Err(
              wgsl_val_err(
                line,
                col,
                "function '" + name + "' expects " + f.params.length().to_string() + " arguments, got " + args.length().to_string(),
              ),
            )
          }
          self.called_funcs.push(name)
          match f.ret_ty {
            Some(rt) => return Ok(wgsl_type_to_sem(rt, self.aliases, self.const_ints))
            None => return Ok(SemType::Void)
          }
        }
        None => ()
      }
      // 2. User-defined struct constructor
      match self.structs.get(name) {
        Some(st) => {
          if args.length() != 0 && args.length() != st.fields.length() {
            return Err(
              wgsl_val_err(
                line,
                col,
                "struct '" + name + "' constructor expects 0 or " + st.fields.length().to_string() + " arguments, got " + args.length().to_string(),
              ),
            )
          }
          return Ok(SemType::Struct(name))
        }
        None => ()
      }
      // 3. Type alias constructor
      match self.aliases.get(name) {
        Some(at) => return Ok(wgsl_type_to_sem(at, self.aliases, self.const_ints))
        None => ()
      }
      // 4. Builtins & built-in type constructors
      match self.check_builtin_call(name, targs, arr_len, len_ident, arg_types, line, col) {
        Ok(Some(rt)) => Ok(rt)
        Ok(None) => Err(wgsl_val_err(line, col, "undeclared function '" + name + "'"))
        Err(e) => Err(e)
      }
    }
  }
}

fn SemCtx::expr_addr_space(self : SemCtx, expr : WgslExpr) -> (String, String) {
  match expr {
    WgslExpr::Ident(name, _, _) =>
    match self.lookup(name) {
      Some(sym) => (sym.addr_space, sym.access)
      None => ("function", "read_write")
    }
    WgslExpr::Index(base, _, _, _) => self.expr_addr_space(base)
    WgslExpr::Field(base, _, _, _) => self.expr_addr_space(base)
    WgslExpr::Paren(inner, _, _) => self.expr_addr_space(inner)
    WgslExpr::Unary("*", inner, _, _) =>
    match self.check_expr(inner) {
      Ok(SemType::Ptr(sp, _, acc)) => (sp, acc)
      _ => ("function", "read_write")
    }
    _ => ("function", "read_write")
  }
}

fn SemCtx::check_stmts(
  self : SemCtx,
  stmts : Array[WgslStmt],
  loop_depth : Int,
  switch_depth : Int,
  in_continuing : Bool,
  ret_ty : Option[SemType],
  known_types : Map[String, Bool],
) -> Result[Unit, WgslError] {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      WgslStmt::VarDecl(name, kind_s, opt_ty, opt_init, line, col) => {
        match wgsl_check_ident_name(name, line, col, "local variable") {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let mut decl_sem : Option[SemType] = None
        match opt_ty {
          Some(t) => {
            match wgsl_validate_type_refs(t, known_types, self.aliases, self.const_ints, line, col) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            let st = wgsl_type_to_sem(t, self.aliases, self.const_ints)
            if sem_is_handle_type(st) {
              return Err(wgsl_val_err(line, col, "handle type cannot be declared in function scope"))
            }
            decl_sem = Some(st)
          }
          None => ()
        }
        let mut init_sem : Option[SemType] = None
        match opt_init {
          Some(ex) => {
            let it = match self.check_expr(ex) {
              Ok(t) => t
              Err(e) => return Err(e)
            }
            init_sem = Some(it)
            if kind_s == "const" {
              match wgsl_eval_const(ex, self.const_vals) {
                Some(cv) => self.const_vals.set(name, cv)
                None => ()
              }
            }
          }
          None => ()
        }
        let final_ty = match (decl_sem, init_sem) {
          (Some(dt), Some(it)) => {
            if !sem_types_compatible(dt, it) {
              return Err(wgsl_val_err(line, col, "type mismatch in initialization of '" + name + "'"))
            }
            dt
          }
          (Some(dt), None) => dt
          (None, Some(it)) => sem_concretize(it)
          _ =>
          return Err(wgsl_val_err(line, col, "variable '" + name + "' requires a type annotation or initializer"))
        }
        let is_mut = kind_s == "var"
        self.define(
          name,
          VarSymbol::{
            ty: final_ty,
            mutable: is_mut,
            addr_space: "function",
            access: if is_mut { "read_write" } else { "read" },
          },
        )
      }
      WgslStmt::Assign(lhs, _, rhs, _, _) => {
        match self.check_writable_lvalue(lhs) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let _ = match self.check_expr(lhs) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        let _ = match self.check_expr(rhs) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
      }
      WgslStmt::PhonyAssign(rhs, _, _) => {
        let _ = match self.check_expr(rhs) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
      }
      WgslStmt::IncDec(lhs, _, _, _) => {
        match self.check_writable_lvalue(lhs) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let _ = match self.check_expr(lhs) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
      }
      WgslStmt::ExprStmt(ex, _, _) => {
        let _ = match self.check_expr(ex) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
      }
      WgslStmt::Return(opt_ex, line, col) => {
        if in_continuing {
          return Err(wgsl_val_err(line, col, "'return' is not allowed inside a continuing block"))
        }
        match (opt_ex, ret_ty) {
          (Some(ex), Some(rt)) => {
            let et = match self.check_expr(ex) {
              Ok(t) => t
              Err(e) => return Err(e)
            }
            if !sem_types_compatible(rt, et) {
              return Err(wgsl_val_err(line, col, "return type mismatch"))
            }
          }
          (Some(_), None) =>
          return Err(wgsl_val_err(line, col, "cannot return a value from a void function"))
          (None, Some(_)) =>
          return Err(wgsl_val_err(line, col, "missing return value"))
          _ => ()
        }
      }
      WgslStmt::If(cond, then_b, else_b, line, col) => {
        let ct = match self.check_expr(cond) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        if !sem_is_bool_type(ct) {
          return Err(wgsl_val_err(line, col, "if condition must be bool"))
        }
        self.push_scope()
        let r1 = self.check_stmts(then_b, loop_depth, switch_depth, in_continuing, ret_ty, known_types)
        self.pop_scope()
        match r1 {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        self.push_scope()
        let r2 = self.check_stmts(else_b, loop_depth, switch_depth, in_continuing, ret_ty, known_types)
        self.pop_scope()
        match r2 {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      WgslStmt::Switch(sel, cases, _, _) => {
        let _ = match self.check_expr(sel) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        let mut ci = 0
        while ci < cases.length() {
          let mut si = 0
          while si < cases[ci].selectors.length() {
            let _ = match self.check_expr(cases[ci].selectors[si]) {
              Ok(t) => t
              Err(e) => return Err(e)
            }
            si = si + 1
          }
          self.push_scope()
          let rc = self.check_stmts(cases[ci].body, loop_depth, switch_depth + 1, in_continuing, ret_ty, known_types)
          self.pop_scope()
          match rc {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          ci = ci + 1
        }
      }
      WgslStmt::For(init, cond, update, body, line, col) => {
        self.push_scope()
        match init {
          Some(st) => {
            let tmp : Array[WgslStmt] = [st]
            match self.check_stmts(tmp, loop_depth, switch_depth, in_continuing, ret_ty, known_types) {
              Ok(_) => ()
              Err(e) => {
                self.pop_scope()
                return Err(e)
              }
            }
          }
          None => ()
        }
        match cond {
          Some(ce) =>
          match self.check_expr(ce) {
            Ok(ct) =>
            if !sem_is_bool_type(ct) {
              self.pop_scope()
              return Err(wgsl_val_err(line, col, "for condition must be bool"))
            }
            Err(e) => {
              self.pop_scope()
              return Err(e)
            }
          }
          None => ()
        }
        match update {
          Some(st) => {
            let tmp : Array[WgslStmt] = [st]
            match self.check_stmts(tmp, loop_depth, switch_depth, in_continuing, ret_ty, known_types) {
              Ok(_) => ()
              Err(e) => {
                self.pop_scope()
                return Err(e)
              }
            }
          }
          None => ()
        }
        let rb = self.check_stmts(body, loop_depth + 1, switch_depth, false, ret_ty, known_types)
        self.pop_scope()
        match rb {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      WgslStmt::While(cond, body, line, col) => {
        let ct = match self.check_expr(cond) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        if !sem_is_bool_type(ct) {
          return Err(wgsl_val_err(line, col, "while condition must be bool"))
        }
        self.push_scope()
        let rb = self.check_stmts(body, loop_depth + 1, switch_depth, false, ret_ty, known_types)
        self.pop_scope()
        match rb {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      WgslStmt::Loop(body, cont, break_if, line, col) => {
        self.push_scope()
        match self.check_stmts(body, loop_depth + 1, switch_depth, false, ret_ty, known_types) {
          Ok(_) => ()
          Err(e) => {
            self.pop_scope()
            return Err(e)
          }
        }
        match self.check_stmts(cont, loop_depth + 1, switch_depth, true, ret_ty, known_types) {
          Ok(_) => ()
          Err(e) => {
            self.pop_scope()
            return Err(e)
          }
        }
        match break_if {
          Some(ce) =>
          match self.check_expr(ce) {
            Ok(ct) =>
            if !sem_is_bool_type(ct) {
              self.pop_scope()
              return Err(wgsl_val_err(line, col, "break if condition must be bool"))
            }
            Err(e) => {
              self.pop_scope()
              return Err(e)
            }
          }
          None => ()
        }
        self.pop_scope()
      }
      WgslStmt::Break(line, col) =>
      if loop_depth == 0 && switch_depth == 0 {
        return Err(wgsl_val_err(line, col, "'break' is only valid inside a loop or switch"))
      }
      WgslStmt::Continue(line, col) =>
      if in_continuing {
        return Err(wgsl_val_err(line, col, "'continue' is not allowed inside a continuing block"))
      } else if loop_depth == 0 {
        return Err(wgsl_val_err(line, col, "'continue' is only valid inside a loop"))
      }
      WgslStmt::Discard(_, _) => self.has_discard = true
      WgslStmt::Block(body, _, _) => {
        self.push_scope()
        let rb = self.check_stmts(body, loop_depth, switch_depth, in_continuing, ret_ty, known_types)
        self.pop_scope()
        match rb {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      WgslStmt::ConstAssert(ex, line, col) => {
        let ct = match self.check_expr(ex) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        if !sem_is_bool_type(ct) {
          return Err(wgsl_val_err(line, col, "const_assert condition must be bool"))
        }
        match wgsl_eval_const(ex, self.const_vals) {
          Some(ConstVal::CBool(true)) => ()
          Some(ConstVal::CBool(false)) => return Err(wgsl_val_err(line, col, "const_assert failed"))
          _ => return Err(wgsl_val_err(line, col, "const_assert expression is not a constant boolean"))
        }
      }
    }
    i = i + 1
  }
  Ok(())
}

fn wgsl_stmts_always_return(stmts : Array[WgslStmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      WgslStmt::Return(_, _, _) => return true
      WgslStmt::If(_, then_b, else_b, _, _) =>
      if else_b.length() > 0 && wgsl_stmts_always_return(then_b) && wgsl_stmts_always_return(else_b) {
        return true
      }
      WgslStmt::Block(body, _, _) =>
      if wgsl_stmts_always_return(body) {
        return true
      }
      WgslStmt::Switch(_, cases, _, _) => {
        let mut has_default = false
        let mut all_ret = true
        let mut ci = 0
        while ci < cases.length() {
          if cases[ci].is_default {
            has_default = true
          }
          if !wgsl_stmts_always_return(cases[ci].body) {
            all_ret = false
          }
          ci = ci + 1
        }
        if has_default && all_ret && cases.length() > 0 {
          return true
        }
      }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn wgsl_check_call_cycle(
  fn_name : String,
  call_graph : Map[String, Array[String]],
  state : Map[String, Int],
  line : Int,
  col : Int,
) -> Result[Unit, WgslError] {
  match state.get(fn_name) {
    Some(1) => return Err(wgsl_val_err(line, col, "recursion is not allowed in WGSL ('" + fn_name + "')"))
    Some(2) => return Ok(())
    _ => ()
  }
  state.set(fn_name, 1)
  match call_graph.get(fn_name) {
    Some(callees) => {
      let mut i = 0
      while i < callees.length() {
        match wgsl_check_call_cycle(callees[i], call_graph, state, line, col) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        i = i + 1
      }
    }
    None => ()
  }
  state.set(fn_name, 2)
  Ok(())
}

fn wgsl_reaches_discard(
  fn_name : String,
  call_graph : Map[String, Array[String]],
  direct_discard : Map[String, Bool],
  memo : Map[String, Bool],
) -> Bool {
  match memo.get(fn_name) {
    Some(v) => return v
    None => ()
  }
  let mut reaches = match direct_discard.get(fn_name) {
    Some(b) => b
    None => false
  }
  if !reaches {
    match call_graph.get(fn_name) {
      Some(callees) => {
        let mut i = 0
        while i < callees.length() {
          if wgsl_reaches_discard(callees[i], call_graph, direct_discard, memo) {
            reaches = true
            break
          }
          i = i + 1
        }
      }
      None => ()
    }
  }
  memo.set(fn_name, reaches)
  reaches
}

fn wgsl_extract_io_meta(attrs : Array[WgslAttr]) -> (Int, String, String) {
  let mut loc = -1
  let mut builtin = ""
  let mut interp = ""
  match wgsl_find_attr(attrs, "location") {
    Some(la) =>
    if la.args.length() == 1 {
      match wgsl_parse_int_str(la.args[0]) {
        Some(v) => loc = v
        None => ()
      }
    }
    None => ()
  }
  match wgsl_find_attr(attrs, "builtin") {
    Some(ba) =>
    if ba.args.length() == 1 {
      builtin = ba.args[0]
    }
    None => ()
  }
  match wgsl_find_attr(attrs, "interpolate") {
    Some(ia) =>
    if ia.args.length() == 1 {
      interp = ia.args[0]
    } else if ia.args.length() >= 2 {
      interp = ia.args[0] + ", " + ia.args[1]
    }
    None => ()
  }
  (loc, builtin, interp)
}

fn wgsl_classify_texture_binding(kind : String) -> BindingKind {
  if kind == "texture_1d" {
    BindingKind::Texture1d
  } else if kind == "texture_2d" {
    BindingKind::Texture2d
  } else if kind == "texture_2d_array" {
    BindingKind::Texture2dArray
  } else if kind == "texture_cube" {
    BindingKind::TextureCube
  } else if kind == "texture_cube_array" {
    BindingKind::TextureCubeArray
  } else if kind == "texture_3d" {
    BindingKind::Texture3d
  } else if kind == "texture_depth_2d" {
    BindingKind::TextureDepth2d
  } else if kind == "texture_depth_2d_array" {
    BindingKind::TextureDepth2dArray
  } else if kind == "texture_depth_cube" || kind == "texture_depth_cube_array" {
    BindingKind::TextureDepthCube
  } else if kind == "texture_multisampled_2d" || kind == "texture_depth_multisampled_2d" {
    BindingKind::TextureMultisampled2d
  } else if kind == "texture_storage_1d" {
    BindingKind::TextureStorage1d
  } else if kind == "texture_storage_2d" {
    BindingKind::TextureStorage2d
  } else if kind == "texture_storage_2d_array" {
    BindingKind::TextureStorage2dArray
  } else {
    BindingKind::TextureStorage3d
  }
}

fn wgsl_alloc_msl_slot(
  grp : Int,
  bnd : Int,
  limit : Int,
  used : Map[Int, Bool],
  line : Int,
  col : Int,
) -> Result[Int, WgslError] {
  let pref64 : Int64 = grp.to_int64() * 8L + bnd.to_int64()
  if pref64 >= 0L && pref64 <= limit.to_int64() {
    let pref = pref64.to_int()
    match used.get(pref) {
      Some(_) => ()
      None => {
        used.set(pref, true)
        return Ok(pref)
      }
    }
  }
  let mut s = 0
  while s <= limit {
    match used.get(s) {
      Some(_) => ()
      None => {
        used.set(s, true)
        return Ok(s)
      }
    }
    s = s + 1
  }
  Err(wgsl_val_err(line, col, "exceeded Metal resource slot limit (" + limit.to_string() + ")"))
}

fn wgsl_validate_module(m : WgslModule) -> Result[ModuleReflection, WgslError] {
  // 1. Collect module-scope unified namespace (aliases, structs, globals, funcs)
  let module_names : Map[String, String] = Map::new()
  let known_types : Map[String, Bool] = Map::new()
  let alias_map : Map[String, WgslType] = Map::new()
  let struct_map : Map[String, WgslStructDecl] = Map::new()
  let func_map : Map[String, WgslFuncDecl] = Map::new()

  let alias_infos : Array[AliasInfo] = []
  let mut i = 0
  while i < m.aliases.length() {
    let a = m.aliases[i]
    match wgsl_check_ident_name(a.name, a.line, a.col, "alias name") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match module_names.get(a.name) {
      Some(_) => return Err(wgsl_val_err(a.line, a.col, "duplicate type alias '" + a.name + "'"))
      None => {
        module_names.set(a.name, "alias")
        known_types.set(a.name, true)
        alias_map.set(a.name, a.ty)
      }
    }
    alias_infos.push(AliasInfo::{ name: a.name, target_type: wgsl_type_to_str(a.ty) })
    i = i + 1
  }

  i = 0
  while i < m.structs.length() {
    let s = m.structs[i]
    match wgsl_check_ident_name(s.name, s.line, s.col, "struct name") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match module_names.get(s.name) {
      Some(_) => return Err(wgsl_val_err(s.line, s.col, "duplicate struct '" + s.name + "'"))
      None => {
        module_names.set(s.name, "struct")
        known_types.set(s.name, true)
        struct_map.set(s.name, s)
      }
    }
    i = i + 1
  }

  i = 0
  while i < m.globals.length() {
    let g = m.globals[i]
    match wgsl_check_ident_name(g.name, g.line, g.col, "global name") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match module_names.get(g.name) {
      Some(_) => return Err(wgsl_val_err(g.line, g.col, "duplicate global variable '" + g.name + "'"))
      None => module_names.set(g.name, "global")
    }
    i = i + 1
  }

  i = 0
  while i < m.funcs.length() {
    let f = m.funcs[i]
    match wgsl_check_ident_name(f.name, f.line, f.col, "function name") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match module_names.get(f.name) {
      Some(_) => return Err(wgsl_val_err(f.line, f.col, "duplicate function '" + f.name + "'"))
      None => {
        module_names.set(f.name, "func")
        func_map.set(f.name, f)
      }
    }
    i = i + 1
  }

  // 2. Evaluate module-level consts (multi-pass for out-of-order const references)
  let const_vals : Map[String, ConstVal] = Map::new()
  let const_ints : Map[String, Int64] = Map::new()
  let mut pass = 0
  while pass < 4 {
    let mut progress = false
    i = 0
    while i < m.globals.length() {
      let g = m.globals[i]
      if g.decl_kind == "const" {
        match const_vals.get(g.name) {
          Some(_) => ()
          None =>
          match g.init {
            Some(ex) =>
            match wgsl_eval_const(ex, const_vals) {
              Some(cv) => {
                const_vals.set(g.name, cv)
                match cv {
                  ConstVal::CInt(v) => const_ints.set(g.name, v)
                  _ => ()
                }
                progress = true
              }
              None => ()
            }
            None => ()
          }
        }
      }
      i = i + 1
    }
    if !progress {
      break
    }
    pass = pass + 1
  }

  // 3. Validate alias targets, struct fields, and detect type recursion cycles
  let type_state : Map[String, Int] = Map::new()
  i = 0
  while i < m.aliases.length() {
    let a = m.aliases[i]
    match wgsl_validate_type_refs(a.ty, known_types, alias_map, const_ints, a.line, a.col) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match wgsl_check_type_cycle(a.name, alias_map, struct_map, type_state, a.line, a.col) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }

  let struct_infos : Array[StructInfo] = []
  i = 0
  while i < m.structs.length() {
    let s = m.structs[i]
    match wgsl_check_type_cycle(s.name, alias_map, struct_map, type_state, s.line, s.col) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let seen_fields : Map[String, Bool] = Map::new()
    let field_infos : Array[StructFieldInfo] = []
    let mut fi = 0
    while fi < s.fields.length() {
      let f = s.fields[fi]
      match wgsl_check_ident_name(f.name, f.line, f.col, "field name") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match wgsl_check_attrs(f.attrs) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match seen_fields.get(f.name) {
        Some(_) =>
        return Err(wgsl_val_err(f.line, f.col, "duplicate field '" + f.name + "' in struct '" + s.name + "'"))
        None => seen_fields.set(f.name, true)
      }
      match wgsl_validate_type_refs(f.ty, known_types, alias_map, const_ints, f.line, f.col) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let (loc, builtin, interp) = wgsl_extract_io_meta(f.attrs)
      let mut align_v = 0
      let mut size_v = 0
      match wgsl_find_attr(f.attrs, "align") {
        Some(aa) =>
        if aa.args.length() == 1 {
          match wgsl_parse_int_str(aa.args[0]) {
            Some(v) => align_v = v
            None => ()
          }
        }
        None => ()
      }
      match wgsl_find_attr(f.attrs, "size") {
        Some(sa) =>
        if sa.args.length() == 1 {
          match wgsl_parse_int_str(sa.args[0]) {
            Some(v) => size_v = v
            None => ()
          }
        }
        None => ()
      }
      field_infos.push(
        StructFieldInfo::{
          name: f.name,
          wgsl_type: wgsl_type_to_str(f.ty),
          location: loc,
          builtin: builtin,
          interpolate: interp,
          align: align_v,
          size: size_v,
        },
      )
      fi = fi + 1
    }
    struct_infos.push(StructInfo::{ name: s.name, fields: field_infos })
    i = i + 1
  }

  // 4. Validate globals, bindings, overrides, address spaces, and populate global scope
  let bindings : Array[BindingInfo] = []
  let overrides : Array[OverrideInfo] = []
  let seen_bindings : Map[String, Int] = Map::new()
  let seen_override_ids : Map[Int, Bool] = Map::new()
  let used_buf_slots : Map[Int, Bool] = Map::new()
  let used_tex_slots : Map[Int, Bool] = Map::new()
  let used_smp_slots : Map[Int, Bool] = Map::new()
  let global_scope : Map[String, VarSymbol] = Map::new()

  i = 0
  while i < m.globals.length() {
    let g = m.globals[i]
    match wgsl_check_attrs(g.attrs) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if g.decl_kind == "var" {
      if g.addr_space.length() > 0 &&
      g.addr_space != "uniform" &&
      g.addr_space != "storage" &&
      g.addr_space != "private" &&
      g.addr_space != "workgroup" {
        return Err(wgsl_val_err(g.line, g.col, "unknown address space '" + g.addr_space + "'"))
      }
      if g.access.length() > 0 {
        if g.addr_space != "storage" {
          return Err(wgsl_val_err(g.line, g.col, "access mode is only allowed on storage address space"))
        }
        if g.access != "read" && g.access != "read_write" {
          return Err(wgsl_val_err(g.line, g.col, "invalid storage access mode '" + g.access + "'"))
        }
      }
    }
    match g.ty {
      Some(t) => {
        match wgsl_validate_type_refs(t, known_types, alias_map, const_ints, g.line, g.col) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        let st = wgsl_type_to_sem(t, alias_map, const_ints)
        if g.decl_kind == "var" {
          if sem_is_handle_type(st) && g.addr_space.length() > 0 {
            return Err(
              wgsl_val_err(
                g.line,
                g.col,
                "texture/sampler variable '" + g.name + "' cannot use address space '" + g.addr_space + "'",
              ),
            )
          }
          if g.addr_space == "uniform" && sem_contains_runtime_array(st, struct_map, alias_map) {
            return Err(
              wgsl_val_err(g.line, g.col, "uniform buffer '" + g.name + "' cannot contain a runtime-sized array"),
            )
          }
          if (g.addr_space == "private" || g.addr_space == "workgroup") &&
          sem_contains_runtime_array(st, struct_map, alias_map) {
            return Err(
              wgsl_val_err(g.line, g.col, "'" + g.addr_space + "' variable cannot contain a runtime-sized array"),
            )
          }
        }
      }
      None => ()
    }
    if g.decl_kind == "override" {
      let mut ov_id = -1
      match wgsl_find_attr(g.attrs, "id") {
        Some(ia) =>
        if ia.args.length() == 1 {
          match wgsl_parse_int_str(ia.args[0]) {
            Some(v) =>
            if v >= 0 {
              match seen_override_ids.get(v) {
                Some(_) =>
                return Err(wgsl_val_err(ia.line, ia.col, "duplicate override @id(" + v.to_string() + ")"))
                None => {
                  seen_override_ids.set(v, true)
                  ov_id = v
                }
              }
            } else {
              return Err(wgsl_val_err(ia.line, ia.col, "@id must be non-negative"))
            }
            None => return Err(wgsl_val_err(ia.line, ia.col, "@id requires integer argument"))
          }
        }
        None => ()
      }
      let ty_s = match g.ty {
        Some(t) => wgsl_type_to_str(t)
        None => "inferred"
      }
      let has_def = match g.init {
        Some(_) => true
        None => false
      }
      overrides.push(OverrideInfo::{ name: g.name, wgsl_type: ty_s, id: ov_id, has_default: has_def })
    }

    let grp_attr = wgsl_find_attr(g.attrs, "group")
    let bnd_attr = wgsl_find_attr(g.attrs, "binding")
    match (grp_attr, bnd_attr) {
      (Some(ga), Some(ba)) => {
        if ga.args.length() != 1 || ba.args.length() != 1 {
          return Err(wgsl_val_err(g.line, g.col, "@group and @binding each require 1 integer argument"))
        }
        let grp = match wgsl_parse_int_str(ga.args[0]) {
          Some(v) =>
          if v >= 0 {
            v
          } else {
            return Err(wgsl_val_err(ga.line, ga.col, "@group must be non-negative"))
          }
          None => return Err(wgsl_val_err(ga.line, ga.col, "@group requires valid 32-bit non-negative integer"))
        }
        let bnd = match wgsl_parse_int_str(ba.args[0]) {
          Some(v) =>
          if v >= 0 {
            v
          } else {
            return Err(wgsl_val_err(ba.line, ba.col, "@binding must be non-negative"))
          }
          None => return Err(wgsl_val_err(ba.line, ba.col, "@binding requires valid 32-bit non-negative integer"))
        }
        let bkey = grp.to_string() + ":" + bnd.to_string()
        match seen_bindings.get(bkey) {
          Some(_) =>
          return Err(
            wgsl_val_err(
              g.line,
              g.col,
              "duplicate @group(" + grp.to_string() + ") @binding(" + bnd.to_string() + ")",
            ),
          )
          None => seen_bindings.set(bkey, g.line)
        }
        let ty = match g.ty {
          Some(t) => t
          None =>
          return Err(wgsl_val_err(g.line, g.col, "bound resource '" + g.name + "' requires explicit type"))
        }
        let resolved_ty = wgsl_resolve_alias_depth(ty, alias_map, 0)
        let kind = match resolved_ty {
          WgslType::Texture(tk, _, _) => wgsl_classify_texture_binding(tk)
          WgslType::Sampler(is_comp) =>
          if is_comp {
            BindingKind::SamplerComparison
          } else {
            BindingKind::Sampler
          }
          _ =>
          if g.addr_space == "uniform" {
            BindingKind::Uniform
          } else if g.addr_space == "storage" {
            if g.access == "read_write" {
              BindingKind::StorageReadWrite
            } else {
              BindingKind::StorageRead
            }
          } else {
            return Err(
              wgsl_val_err(
                g.line,
                g.col,
                "resource '" + g.name + "' must use var<uniform>, var<storage, ...>, texture, or sampler",
              ),
            )
          }
        }
        let msl_slot = match kind {
          BindingKind::Uniform | BindingKind::StorageRead | BindingKind::StorageReadWrite =>
          match wgsl_alloc_msl_slot(grp, bnd, 29, used_buf_slots, g.line, g.col) {
            Ok(s) => s
            Err(e) => return Err(e)
          }
          BindingKind::Sampler | BindingKind::SamplerComparison =>
          match wgsl_alloc_msl_slot(grp, bnd, 15, used_smp_slots, g.line, g.col) {
            Ok(s) => s
            Err(e) => return Err(e)
          }
          _ =>
          match wgsl_alloc_msl_slot(grp, bnd, 127, used_tex_slots, g.line, g.col) {
            Ok(s) => s
            Err(e) => return Err(e)
          }
        }
        let addr_s = if g.addr_space.length() > 0 { g.addr_space } else { "handle" }
        bindings.push(
          BindingInfo::{
            name: g.name,
            group: grp,
            binding: bnd,
            address_space: addr_s,
            access: g.access,
            wgsl_type: wgsl_type_to_str(ty),
            kind: kind,
            msl_slot: msl_slot,
          },
        )
      }
      (Some(_), None) | (None, Some(_)) =>
      return Err(wgsl_val_err(g.line, g.col, "@group and @binding must both be specified"))
      _ => ()
    }

    // Register global symbol in global scope
    let g_sem = match g.ty {
      Some(t) => wgsl_type_to_sem(t, alias_map, const_ints)
      None =>
      match g.init {
        Some(ex) => {
          let tmp_ctx = SemCtx::{
            aliases: alias_map,
            structs: struct_map,
            funcs: func_map,
            const_vals: const_vals,
            const_ints: const_ints,
            scopes: [global_scope],
            called_funcs: [],
            has_discard: false,
          }
          match tmp_ctx.check_expr(ex) {
            Ok(t) => sem_concretize(t)
            Err(_) => SemType::Scalar("f32")
          }
        }
        None => SemType::Scalar("f32")
      }
    }
    let g_mut = g.decl_kind == "var" &&
    (g.addr_space == "private" || g.addr_space == "workgroup" || (g.addr_space == "storage" && g.access == "read_write"))
    let g_acc = if g.access.length() > 0 {
      g.access
    } else if g_mut {
      "read_write"
    } else {
      "read"
    }
    let g_sp = if g.addr_space.length() > 0 { g.addr_space } else { "handle" }
    global_scope.set(g.name, VarSymbol::{ ty: g_sem, mutable: g_mut, addr_space: g_sp, access: g_acc })
    i = i + 1
  }

  // Validate global initializers and module-level const_asserts
  let mod_ctx = SemCtx::{
    aliases: alias_map,
    structs: struct_map,
    funcs: func_map,
    const_vals: const_vals,
    const_ints: const_ints,
    scopes: [global_scope],
    called_funcs: [],
    has_discard: false,
  }
  i = 0
  while i < m.globals.length() {
    let g = m.globals[i]
    match g.init {
      Some(ex) => {
        let it = match mod_ctx.check_expr(ex) {
          Ok(t) => t
          Err(e) => return Err(e)
        }
        match g.ty {
          Some(dt) => {
            let ds = wgsl_type_to_sem(dt, alias_map, const_ints)
            if !sem_types_compatible(ds, it) {
              return Err(wgsl_val_err(g.line, g.col, "type mismatch in initializer of '" + g.name + "'"))
            }
          }
          None => ()
        }
      }
      None => ()
    }
    i = i + 1
  }
  i = 0
  while i < m.const_asserts.length() {
    let ca = m.const_asserts[i]
    let ct = match mod_ctx.check_expr(ca.expr) {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    if !sem_is_bool_type(ct) {
      return Err(wgsl_val_err(ca.line, ca.col, "const_assert condition must be bool"))
    }
    match wgsl_eval_const(ca.expr, const_vals) {
      Some(ConstVal::CBool(true)) => ()
      Some(ConstVal::CBool(false)) => return Err(wgsl_val_err(ca.line, ca.col, "const_assert failed"))
      _ => return Err(wgsl_val_err(ca.line, ca.col, "const_assert expression is not a constant boolean"))
    }
    i = i + 1
  }

  // 5. Validate functions, bodies, types, entry I/O, call graph, and transitive discard
  let entries : Array[EntryPointInfo] = []
  let call_graph : Map[String, Array[String]] = Map::new()
  let direct_discard : Map[String, Bool] = Map::new()

  i = 0
  while i < m.funcs.length() {
    let f = m.funcs[i]
    match wgsl_check_attrs(f.attrs) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match wgsl_check_attrs(f.ret_attrs) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let fn_scope : Map[String, VarSymbol] = Map::new()
    let mut pi = 0
    while pi < f.params.length() {
      let p = f.params[pi]
      match wgsl_check_ident_name(p.name, p.line, p.col, "parameter name") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match wgsl_check_attrs(p.attrs) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match wgsl_validate_type_refs(p.ty, known_types, alias_map, const_ints, p.line, p.col) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match fn_scope.get(p.name) {
        Some(_) => return Err(wgsl_val_err(p.line, p.col, "duplicate parameter '" + p.name + "'"))
        None => {
          let ps = wgsl_type_to_sem(p.ty, alias_map, const_ints)
          fn_scope.set(p.name, VarSymbol::{ ty: ps, mutable: false, addr_space: "function", access: "read" })
        }
      }
      pi = pi + 1
    }
    let ret_sem : Option[SemType] = match f.ret_ty {
      Some(rt) => {
        match wgsl_validate_type_refs(rt, known_types, alias_map, const_ints, f.line, f.col) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        Some(wgsl_type_to_sem(rt, alias_map, const_ints))
      }
      None => None
    }

    let is_vs = wgsl_has_attr(f.attrs, "vertex")
    let is_fs = wgsl_has_attr(f.attrs, "fragment")
    let is_cs = wgsl_has_attr(f.attrs, "compute")
    let stage_count = (if is_vs { 1 } else { 0 }) +
    (if is_fs { 1 } else { 0 }) +
    (if is_cs { 1 } else { 0 })
    if stage_count > 1 {
      return Err(wgsl_val_err(f.line, f.col, "function '" + f.name + "' has multiple stage attributes"))
    }

    // Type-check function body
    let fn_const_vals : Map[String, ConstVal] = Map::new()
    // Copy module const_vals
    let mut gi = 0
    while gi < m.globals.length() {
      match const_vals.get(m.globals[gi].name) {
        Some(cv) => fn_const_vals.set(m.globals[gi].name, cv)
        None => ()
      }
      gi = gi + 1
    }
    let fctx = SemCtx::{
      aliases: alias_map,
      structs: struct_map,
      funcs: func_map,
      const_vals: fn_const_vals,
      const_ints: const_ints,
      scopes: [global_scope, fn_scope],
      called_funcs: [],
      has_discard: false,
    }
    match fctx.check_stmts(f.body, 0, 0, false, ret_sem, known_types) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    call_graph.set(f.name, fctx.called_funcs)
    direct_discard.set(f.name, fctx.has_discard)

    // Missing return check for non-void functions
    match f.ret_ty {
      Some(_) =>
      if !wgsl_stmts_always_return(f.body) {
        return Err(wgsl_val_err(f.line, f.col, "function '" + f.name + "' does not return on all control-flow paths"))
      }
      None => ()
    }

    if is_vs || is_fs || is_cs {
      let inputs : Array[IoVarInfo] = []
      let seen_in_locs : Map[Int, Bool] = Map::new()
      pi = 0
      while pi < f.params.length() {
        let p = f.params[pi]
        let (loc, builtin, interp) = wgsl_extract_io_meta(p.attrs)
        if loc >= 0 || builtin.length() > 0 {
          if loc >= 0 {
            match seen_in_locs.get(loc) {
              Some(_) => return Err(wgsl_val_err(p.line, p.col, "duplicate input @location(" + loc.to_string() + ")"))
              None => seen_in_locs.set(loc, true)
            }
          }
          inputs.push(
            IoVarInfo::{
              name: p.name,
              wgsl_type: wgsl_type_to_str(p.ty),
              location: loc,
              builtin: builtin,
              interpolate: interp,
            },
          )
        } else {
          let resolved_pt = wgsl_resolve_alias_depth(p.ty, alias_map, 0)
          match resolved_pt {
            WgslType::Named(sn) =>
            match struct_map.get(sn) {
              Some(st) => {
                let mut sfi = 0
                while sfi < st.fields.length() {
                  let sf = st.fields[sfi]
                  let (floc, fbi, fint) = wgsl_extract_io_meta(sf.attrs)
                  if floc < 0 && fbi.length() == 0 {
                    return Err(
                      wgsl_val_err(
                        sf.line,
                        sf.col,
                        "entry point input struct field '" + sf.name + "' requires @location or @builtin",
                      ),
                    )
                  }
                  if floc >= 0 {
                    match seen_in_locs.get(floc) {
                      Some(_) =>
                      return Err(wgsl_val_err(sf.line, sf.col, "duplicate input @location(" + floc.to_string() + ")"))
                      None => seen_in_locs.set(floc, true)
                    }
                  }
                  inputs.push(
                    IoVarInfo::{
                      name: sf.name,
                      wgsl_type: wgsl_type_to_str(sf.ty),
                      location: floc,
                      builtin: fbi,
                      interpolate: fint,
                    },
                  )
                  sfi = sfi + 1
                }
              }
              None =>
              return Err(wgsl_val_err(p.line, p.col, "entry point parameter '" + p.name + "' requires @location or @builtin"))
            }
            _ =>
            return Err(wgsl_val_err(p.line, p.col, "entry point parameter '" + p.name + "' requires @location or @builtin"))
          }
        }
        pi = pi + 1
      }

      let outputs : Array[IoVarInfo] = []
      let seen_out_locs : Map[Int, Bool] = Map::new()
      let mut vs_has_pos = false
      match f.ret_ty {
        Some(rt) => {
          let (rloc, rbi, rint) = wgsl_extract_io_meta(f.ret_attrs)
          if rloc >= 0 || rbi.length() > 0 {
            if rloc >= 0 {
              seen_out_locs.set(rloc, true)
            }
            if rbi == "position" {
              vs_has_pos = true
            }
            outputs.push(
              IoVarInfo::{
                name: "",
                wgsl_type: wgsl_type_to_str(rt),
                location: rloc,
                builtin: rbi,
                interpolate: rint,
              },
            )
          } else {
            let resolved_rt = wgsl_resolve_alias_depth(rt, alias_map, 0)
            match resolved_rt {
              WgslType::Named(sn) =>
              match struct_map.get(sn) {
                Some(st) => {
                  let mut sfi = 0
                  while sfi < st.fields.length() {
                    let sf = st.fields[sfi]
                    let (floc, fbi, fint) = wgsl_extract_io_meta(sf.attrs)
                    if floc < 0 && fbi.length() == 0 {
                      return Err(
                        wgsl_val_err(
                          sf.line,
                          sf.col,
                          "entry point output struct field '" + sf.name + "' requires @location or @builtin",
                        ),
                      )
                    }
                    if floc >= 0 {
                      match seen_out_locs.get(floc) {
                        Some(_) =>
                        return Err(wgsl_val_err(sf.line, sf.col, "duplicate output @location(" + floc.to_string() + ")"))
                        None => seen_out_locs.set(floc, true)
                      }
                    }
                    if fbi == "position" {
                      vs_has_pos = true
                    }
                    outputs.push(
                      IoVarInfo::{
                        name: sf.name,
                        wgsl_type: wgsl_type_to_str(sf.ty),
                        location: floc,
                        builtin: fbi,
                        interpolate: fint,
                      },
                    )
                    sfi = sfi + 1
                  }
                }
                None =>
                return Err(wgsl_val_err(f.line, f.col, "entry point return type requires @location or @builtin"))
              }
              _ =>
              return Err(wgsl_val_err(f.line, f.col, "entry point return type requires @location or @builtin"))
            }
          }
        }
        None => ()
      }

      if is_vs && !vs_has_pos {
        return Err(wgsl_val_err(f.line, f.col, "@vertex entry '" + f.name + "' must output @builtin(position)"))
      }

      if is_cs {
        let wg_attr = match wgsl_find_attr(f.attrs, "workgroup_size") {
          Some(a) => a
          None =>
          return Err(wgsl_val_err(f.line, f.col, "@compute entry '" + f.name + "' requires @workgroup_size"))
        }
        if wg_attr.args.length() < 1 || wg_attr.args.length() > 3 {
          return Err(
            wgsl_val_err(wg_attr.line, wg_attr.col, "@workgroup_size requires 1 to 3 positive integer arguments"),
          )
        }
        let wgx = match wgsl_resolve_wg_dim(wg_attr.args[0], const_ints) {
          Some(v) =>
          if v > 0 && v <= 1024 {
            v
          } else {
            return Err(
              wgsl_val_err(wg_attr.line, wg_attr.col, "@workgroup_size x must be in 1..1024, got " + v.to_string()),
            )
          }
          None => return Err(wgsl_val_err(wg_attr.line, wg_attr.col, "invalid @workgroup_size x"))
        }
        let wgy = if wg_attr.args.length() >= 2 {
          match wgsl_resolve_wg_dim(wg_attr.args[1], const_ints) {
            Some(v) =>
            if v > 0 && v <= 1024 {
              v
            } else {
              return Err(
                wgsl_val_err(wg_attr.line, wg_attr.col, "@workgroup_size y must be in 1..1024, got " + v.to_string()),
              )
            }
            None => return Err(wgsl_val_err(wg_attr.line, wg_attr.col, "invalid @workgroup_size y"))
          }
        } else {
          1
        }
        let wgz = if wg_attr.args.length() >= 3 {
          match wgsl_resolve_wg_dim(wg_attr.args[2], const_ints) {
            Some(v) =>
            if v > 0 && v <= 64 {
              v
            } else {
              return Err(
                wgsl_val_err(wg_attr.line, wg_attr.col, "@workgroup_size z must be in 1..64, got " + v.to_string()),
              )
            }
            None => return Err(wgsl_val_err(wg_attr.line, wg_attr.col, "invalid @workgroup_size z"))
          }
        } else {
          1
        }
        if wgx * wgy * wgz > 1024 {
          return Err(wgsl_val_err(wg_attr.line, wg_attr.col, "@workgroup_size total invocations exceeds 1024"))
        }
        entries.push(
          EntryPointInfo::{
            name: f.name,
            stage: EntryStage::Compute,
            msl_name: msl_entry_name(f.name),
            glsl_name: "main",
            workgroup_size_x: wgx,
            workgroup_size_y: wgy,
            workgroup_size_z: wgz,
            inputs: inputs,
            outputs: outputs,
          },
        )
      } else if is_vs {
        entries.push(
          EntryPointInfo::{
            name: f.name,
            stage: EntryStage::Vertex,
            msl_name: msl_entry_name(f.name),
            glsl_name: "main",
            workgroup_size_x: 0,
            workgroup_size_y: 0,
            workgroup_size_z: 0,
            inputs: inputs,
            outputs: outputs,
          },
        )
      } else {
        entries.push(
          EntryPointInfo::{
            name: f.name,
            stage: EntryStage::Fragment,
            msl_name: msl_entry_name(f.name),
            glsl_name: "main",
            workgroup_size_x: 0,
            workgroup_size_y: 0,
            workgroup_size_z: 0,
            inputs: inputs,
            outputs: outputs,
          },
        )
      }
    }
    i = i + 1
  }

  // 6. Call-graph recursion check & transitive discard check
  let call_state : Map[String, Int] = Map::new()
  let discard_memo : Map[String, Bool] = Map::new()
  i = 0
  while i < m.funcs.length() {
    let f = m.funcs[i]
    match wgsl_check_call_cycle(f.name, call_graph, call_state, f.line, f.col) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let is_vs = wgsl_has_attr(f.attrs, "vertex")
    let is_cs = wgsl_has_attr(f.attrs, "compute")
    if (is_vs || is_cs) && wgsl_reaches_discard(f.name, call_graph, direct_discard, discard_memo) {
      return Err(wgsl_val_err(f.line, f.col, "'discard' is only valid in fragment shaders"))
    }
    i = i + 1
  }

  Ok(
    ModuleReflection::{
      entries: entries,
      bindings: bindings,
      structs: struct_infos,
      aliases: alias_infos,
      overrides: overrides,
    },
  )
}

fn wgsl_resolve_wg_dim(arg : String, const_ints : Map[String, Int64]) -> Option[Int] {
  match wgsl_parse_int_str(arg) {
    Some(v) => Some(v)
    None =>
    match const_ints.get(arg) {
      Some(v64) =>
      if v64 >= -2147483648L && v64 <= 2147483647L {
        Some(v64.to_int())
      } else {
        None
      }
      None => None
    }
  }
}
