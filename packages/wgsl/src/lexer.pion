///| Zero-string-allocation flat-token W3C WGSL lexer.
///| Supports line comments (`//`), nested block comments (`/* /* ... */ */`),
///| decimal/hex integer & float literals with suffixes (`u`/`i`/`f`/`h`),
///| full punctuation/operator set, accurate 1-based `(line, col)`, and DoS limits.

let tk_eof : Int = 0
let tk_ident : Int = 1
let tk_int : Int = 2
let tk_float : Int = 3

// 1-char punctuation
let tk_at : Int = 10 // @
let tk_lparen : Int = 11 // (
let tk_rparen : Int = 12 // )
let tk_lbrace : Int = 13 // {
let tk_rbrace : Int = 14 // }
let tk_lbracket : Int = 15 // [
let tk_rbracket : Int = 16 // ]
let tk_lt : Int = 17 // <
let tk_gt : Int = 18 // >
let tk_comma : Int = 19 // ,
let tk_dot : Int = 20 // .
let tk_colon : Int = 21 // :
let tk_semi : Int = 22 // ;
let tk_plus : Int = 23 // +
let tk_minus : Int = 24 // -
let tk_star : Int = 25 // *
let tk_slash : Int = 26 // /
let tk_percent : Int = 27 // %
let tk_eq : Int = 28 // =
let tk_bang : Int = 29 // !
let tk_tilde : Int = 30 // ~
let tk_amp : Int = 31 // &
let tk_pipe : Int = 32 // |
let tk_caret : Int = 33 // ^

// 2-char operators
let tk_arrow : Int = 40 // ->
let tk_eqeq : Int = 41 // ==
let tk_neq : Int = 42 // !=
let tk_le : Int = 43 // <=
let tk_ge : Int = 44 // >=
let tk_andand : Int = 45 // &&
let tk_oror : Int = 46 // ||
let tk_plusplus : Int = 47 // ++
let tk_minusminus : Int = 48 // --
let tk_pluseq : Int = 49 // +=
let tk_minuseq : Int = 50 // -=
let tk_stareq : Int = 51 // *=
let tk_slasheq : Int = 52 // /=
let tk_percenteq : Int = 53 // %=
let tk_ampeq : Int = 54 // &=
let tk_pipeeq : Int = 55 // |=
let tk_careteq : Int = 56 // ^=
let tk_shl : Int = 57 // <<
let tk_shr : Int = 58 // >>

// 3-char operators
let tk_shleq : Int = 60 // <<=
let tk_shreq : Int = 61 // >>=

///| Flat value-type token storing byte offsets into source (zero String alloc during lexing).
val struct WgslToken {
  kind : Int
  start : Int
  end : Int
  line : Int
  col : Int
}

fn tok_text(src : String, tok : WgslToken) -> String {
  if tok.end > tok.start {
    src.slice(tok.start, tok.end)
  } else {
    ""
  }
}

///| Zero-allocation comparison of a token's slice against a constant ASCII string.
fn tok_eq(src : String, tok : WgslToken, lit : String) -> Bool {
  let n = lit.length()
  if tok.end - tok.start != n {
    return false
  }
  let s = tok.start
  let mut i = 0
  while i < n {
    if src.code_unit_at(s + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn wgsl_is_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn wgsl_is_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn wgsl_is_hex(c : Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

fn wgsl_is_ident_start(c : Int) -> Bool {
  wgsl_is_alpha(c) || c == 95
}

fn wgsl_is_ident_cont(c : Int) -> Bool {
  wgsl_is_alpha(c) || wgsl_is_digit(c) || c == 95
}

fn wgsl_lex(source : String, limits : ParseLimits) -> Result[Array[WgslToken], WgslError] {
  let n = source.length()
  if n == 0 {
    return Err(
      WgslError::{
        kind: WgslErrorKind::EmptySource,
        line: 0,
        col: 0,
        message: "empty WGSL source",
      },
    )
  }
  if limits.max_source_bytes > 0 && n > limits.max_source_bytes {
    return Err(
      WgslError::{
        kind: WgslErrorKind::LimitExceeded,
        line: 1,
        col: 1,
        message: "source size " + n.to_string() + " exceeds limit " + limits.max_source_bytes.to_string(),
      },
    )
  }

  let tokens : Array[WgslToken] = []
  let mut i = 0
  let mut line = 1
  let mut line_start = 0

  while i < n {
    let c = source.code_unit_at(i)
    if c == 0 {
      return Err(
        WgslError::{
          kind: WgslErrorKind::LexError,
          line: line,
          col: i - line_start + 1,
          message: "unexpected NUL byte",
        },
      )
    }
    // Horizontal whitespace
    if c == 32 || c == 9 || c == 11 || c == 12 {
      i = i + 1
      continue
    }
    // Newlines
    if c == 13 {
      if i + 1 < n && source.code_unit_at(i + 1) == 10 {
        i = i + 2
      } else {
        i = i + 1
      }
      line = line + 1
      line_start = i
      continue
    }
    if c == 10 {
      i = i + 1
      line = line + 1
      line_start = i
      continue
    }
    // Single-line comment //
    if c == 47 && i + 1 < n && source.code_unit_at(i + 1) == 47 {
      i = i + 2
      while i < n {
        let cc = source.code_unit_at(i)
        if cc == 10 || cc == 13 {
          break
        }
        i = i + 1
      }
      continue
    }
    // Nested block comment /* ... */
    if c == 47 && i + 1 < n && source.code_unit_at(i + 1) == 42 {
      let start_line = line
      let start_col = i - line_start + 1
      i = i + 2
      let mut depth = 1
      while i < n && depth > 0 {
        let cc = source.code_unit_at(i)
        if cc == 10 {
          line = line + 1
          i = i + 1
          line_start = i
          continue
        }
        if cc == 13 {
          if i + 1 < n && source.code_unit_at(i + 1) == 10 {
            i = i + 2
          } else {
            i = i + 1
          }
          line = line + 1
          line_start = i
          continue
        }
        if cc == 47 && i + 1 < n && source.code_unit_at(i + 1) == 42 {
          depth = depth + 1
          i = i + 2
          continue
        }
        if cc == 42 && i + 1 < n && source.code_unit_at(i + 1) == 47 {
          depth = depth - 1
          i = i + 2
          continue
        }
        i = i + 1
      }
      if depth > 0 {
        return Err(
          WgslError::{
            kind: WgslErrorKind::LexError,
            line: start_line,
            col: start_col,
            message: "unterminated block comment",
          },
        )
      }
      continue
    }

    let col = i - line_start + 1
    if limits.max_tokens > 0 && tokens.length() >= limits.max_tokens {
      return Err(
        WgslError::{
          kind: WgslErrorKind::LimitExceeded,
          line: line,
          col: col,
          message: "token count exceeds limit " + limits.max_tokens.to_string(),
        },
      )
    }

    // Identifier / keyword
    if wgsl_is_ident_start(c) {
      let start = i
      i = i + 1
      while i < n && wgsl_is_ident_cont(source.code_unit_at(i)) {
        i = i + 1
      }
      tokens.push(WgslToken::{ kind: tk_ident, start: start, end: i, line: line, col: col })
      continue
    }

    // Number literal (int, hex, decimal float, hex float)
    if wgsl_is_digit(c) || (c == 46 && i + 1 < n && wgsl_is_digit(source.code_unit_at(i + 1))) {
      let start = i
      let mut is_float = false
      if c == 48 && i + 1 < n && (source.code_unit_at(i + 1) == 120 || source.code_unit_at(i + 1) == 88) {
        i = i + 2
        let mut has_digits = false
        while i < n && wgsl_is_hex(source.code_unit_at(i)) {
          has_digits = true
          i = i + 1
        }
        if i < n && source.code_unit_at(i) == 46 {
          is_float = true
          i = i + 1
          while i < n && wgsl_is_hex(source.code_unit_at(i)) {
            has_digits = true
            i = i + 1
          }
        }
        if !has_digits {
          return Err(
            WgslError::{
              kind: WgslErrorKind::LexError,
              line: line,
              col: col,
              message: "invalid hex literal",
            },
          )
        }
        if i < n && (source.code_unit_at(i) == 112 || source.code_unit_at(i) == 80) {
          is_float = true
          i = i + 1
          if i < n && (source.code_unit_at(i) == 43 || source.code_unit_at(i) == 45) {
            i = i + 1
          }
          if i >= n || !wgsl_is_digit(source.code_unit_at(i)) {
            return Err(
              WgslError::{
                kind: WgslErrorKind::LexError,
                line: line,
                col: col,
                message: "invalid hex float exponent",
              },
            )
          }
          while i < n && wgsl_is_digit(source.code_unit_at(i)) {
            i = i + 1
          }
        }
        if i < n {
          let sc = source.code_unit_at(i)
          if is_float && (sc == 102 || sc == 104) {
            i = i + 1
          } else if !is_float && (sc == 117 || sc == 105) {
            i = i + 1
          }
        }
      } else {
        while i < n && wgsl_is_digit(source.code_unit_at(i)) {
          i = i + 1
        }
        if i < n && source.code_unit_at(i) == 46 {
          is_float = true
          i = i + 1
          while i < n && wgsl_is_digit(source.code_unit_at(i)) {
            i = i + 1
          }
        }
        if i < n && (source.code_unit_at(i) == 101 || source.code_unit_at(i) == 69) {
          is_float = true
          i = i + 1
          if i < n && (source.code_unit_at(i) == 43 || source.code_unit_at(i) == 45) {
            i = i + 1
          }
          if i >= n || !wgsl_is_digit(source.code_unit_at(i)) {
            return Err(
              WgslError::{
                kind: WgslErrorKind::LexError,
                line: line,
                col: col,
                message: "invalid float exponent",
              },
            )
          }
          while i < n && wgsl_is_digit(source.code_unit_at(i)) {
            i = i + 1
          }
        }
        if i < n {
          let sc = source.code_unit_at(i)
          if sc == 102 || sc == 104 {
            is_float = true
            i = i + 1
          } else if !is_float && (sc == 117 || sc == 105) {
            i = i + 1
          }
        }
      }
      tokens.push(
        WgslToken::{
          kind: if is_float { tk_float } else { tk_int },
          start: start,
          end: i,
          line: line,
          col: col,
        },
      )
      continue
    }

    // 3-char operators: <<=, >>=
    if i + 2 < n {
      let c1 = source.code_unit_at(i + 1)
      let c2 = source.code_unit_at(i + 2)
      if c == 60 && c1 == 60 && c2 == 61 {
        tokens.push(WgslToken::{ kind: tk_shleq, start: i, end: i + 3, line: line, col: col })
        i = i + 3
        continue
      }
      if c == 62 && c1 == 62 && c2 == 61 {
        tokens.push(WgslToken::{ kind: tk_shreq, start: i, end: i + 3, line: line, col: col })
        i = i + 3
        continue
      }
    }

    // 2-char operators
    if i + 1 < n {
      let c1 = source.code_unit_at(i + 1)
      let k2 = if c == 45 && c1 == 62 {
        tk_arrow
      } else if c == 61 && c1 == 61 {
        tk_eqeq
      } else if c == 33 && c1 == 61 {
        tk_neq
      } else if c == 60 && c1 == 61 {
        tk_le
      } else if c == 62 && c1 == 61 {
        tk_ge
      } else if c == 38 && c1 == 38 {
        tk_andand
      } else if c == 124 && c1 == 124 {
        tk_oror
      } else if c == 43 && c1 == 43 {
        tk_plusplus
      } else if c == 45 && c1 == 45 {
        tk_minusminus
      } else if c == 43 && c1 == 61 {
        tk_pluseq
      } else if c == 45 && c1 == 61 {
        tk_minuseq
      } else if c == 42 && c1 == 61 {
        tk_stareq
      } else if c == 47 && c1 == 61 {
        tk_slasheq
      } else if c == 37 && c1 == 61 {
        tk_percenteq
      } else if c == 38 && c1 == 61 {
        tk_ampeq
      } else if c == 124 && c1 == 61 {
        tk_pipeeq
      } else if c == 94 && c1 == 61 {
        tk_careteq
      } else if c == 60 && c1 == 60 {
        tk_shl
      } else if c == 62 && c1 == 62 {
        tk_shr
      } else {
        -1
      }
      if k2 >= 0 {
        tokens.push(WgslToken::{ kind: k2, start: i, end: i + 2, line: line, col: col })
        i = i + 2
        continue
      }
    }

    // 1-char punctuation
    let k1 = if c == 64 {
      tk_at
    } else if c == 40 {
      tk_lparen
    } else if c == 41 {
      tk_rparen
    } else if c == 123 {
      tk_lbrace
    } else if c == 125 {
      tk_rbrace
    } else if c == 91 {
      tk_lbracket
    } else if c == 93 {
      tk_rbracket
    } else if c == 60 {
      tk_lt
    } else if c == 62 {
      tk_gt
    } else if c == 44 {
      tk_comma
    } else if c == 46 {
      tk_dot
    } else if c == 58 {
      tk_colon
    } else if c == 59 {
      tk_semi
    } else if c == 43 {
      tk_plus
    } else if c == 45 {
      tk_minus
    } else if c == 42 {
      tk_star
    } else if c == 47 {
      tk_slash
    } else if c == 37 {
      tk_percent
    } else if c == 61 {
      tk_eq
    } else if c == 33 {
      tk_bang
    } else if c == 126 {
      tk_tilde
    } else if c == 38 {
      tk_amp
    } else if c == 124 {
      tk_pipe
    } else if c == 94 {
      tk_caret
    } else {
      -1
    }
    if k1 >= 0 {
      tokens.push(WgslToken::{ kind: k1, start: i, end: i + 1, line: line, col: col })
      i = i + 1
      continue
    }

    return Err(
      WgslError::{
        kind: WgslErrorKind::LexError,
        line: line,
        col: col,
        message: "unexpected character code " + c.to_string(),
      },
    )
  }

  if tokens.length() == 0 {
    return Err(
      WgslError::{
        kind: WgslErrorKind::EmptySource,
        line: 0,
        col: 0,
        message: "empty WGSL source",
      },
    )
  }
  tokens.push(WgslToken::{ kind: tk_eof, start: n, end: n, line: line, col: n - line_start + 1 })
  Ok(tokens)
}
