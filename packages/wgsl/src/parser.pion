///| Pure-Pion W3C WGSL recursive-descent parser with nesting-depth enforcement
///| and zero-allocation keyword matching.

struct WgslParser {
  src : String
  tokens : Array[WgslToken]
  mut pos : Int
  mut depth : Int
  max_depth : Int
  mut pending_gt : Bool
}

fn WgslParser::new(src : String, tokens : Array[WgslToken], limits : ParseLimits) -> WgslParser {
  WgslParser::{
    src: src,
    tokens: tokens,
    pos: 0,
    depth: 0,
    max_depth: if limits.max_nesting_depth > 0 { limits.max_nesting_depth } else { 64 },
    pending_gt: false,
  }
}

fn WgslParser::peek(self : WgslParser) -> WgslToken {
  if self.pos < self.tokens.length() {
    self.tokens[self.pos]
  } else {
    self.tokens[self.tokens.length() - 1]
  }
}

fn WgslParser::is_eof(self : WgslParser) -> Bool {
  !self.pending_gt && self.peek().kind == tk_eof
}

fn WgslParser::advance(self : WgslParser) -> WgslToken {
  let t = self.peek()
  if self.pos < self.tokens.length() - 1 {
    self.pos = self.pos + 1
  }
  t
}

fn WgslParser::check_kind(self : WgslParser, k : Int) -> Bool {
  !self.pending_gt && self.peek().kind == k
}

fn WgslParser::match_kind(self : WgslParser, k : Int) -> Bool {
  if self.check_kind(k) {
    let _ = self.advance()
    true
  } else {
    false
  }
}

fn WgslParser::check_kw(self : WgslParser, kw : String) -> Bool {
  if self.pending_gt {
    return false
  }
  let t = self.peek()
  t.kind == tk_ident && tok_eq(self.src, t, kw)
}

fn WgslParser::match_kw(self : WgslParser, kw : String) -> Bool {
  if self.check_kw(kw) {
    let _ = self.advance()
    true
  } else {
    false
  }
}

fn WgslParser::parse_err(self : WgslParser, tok : WgslToken, msg : String) -> WgslError {
  let _ = self
  WgslError::{
    kind: WgslErrorKind::ParseError,
    line: tok.line,
    col: tok.col,
    message: msg,
  }
}

fn WgslParser::expect_kind(self : WgslParser, k : Int, label : String) -> Result[Unit, WgslError] {
  if self.check_kind(k) {
    let _ = self.advance()
    Ok(())
  } else {
    let t = self.peek()
    Err(self.parse_err(t, "expected '" + label + "', got '" + tok_text(self.src, t) + "'"))
  }
}

///| Match closing `>` of a template argument list, splitting `>>` when nested.
fn WgslParser::expect_gt(self : WgslParser) -> Result[Unit, WgslError] {
  if self.pending_gt {
    self.pending_gt = false
    return Ok(())
  }
  let t = self.peek()
  if t.kind == tk_gt {
    let _ = self.advance()
    return Ok(())
  }
  if t.kind == tk_shr {
    let _ = self.advance()
    self.pending_gt = true
    return Ok(())
  }
  Err(self.parse_err(t, "expected '>', got '" + tok_text(self.src, t) + "'"))
}

fn WgslParser::expect_ident(self : WgslParser) -> Result[String, WgslError] {
  let t = self.peek()
  if !self.pending_gt && t.kind == tk_ident {
    let _ = self.advance()
    Ok(tok_text(self.src, t))
  } else {
    Err(self.parse_err(t, "expected identifier, got '" + tok_text(self.src, t) + "'"))
  }
}

fn WgslParser::enter_depth(self : WgslParser, tok : WgslToken) -> Result[Unit, WgslError] {
  self.depth = self.depth + 1
  if self.depth > self.max_depth {
    return Err(
      WgslError::{
        kind: WgslErrorKind::LimitExceeded,
        line: tok.line,
        col: tok.col,
        message: "nesting depth exceeded " + self.max_depth.to_string(),
      },
    )
  }
  Ok(())
}

fn WgslParser::leave_depth(self : WgslParser) -> Unit {
  if self.depth > 0 {
    self.depth = self.depth - 1
  }
}

fn wgsl_parse_int_str(s : String) -> Option[Int] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut end = n
  let last = s.code_unit_at(n - 1)
  if last == 117 || last == 105 {
    end = n - 1
  }
  if end == 0 {
    return None
  }
  let mut neg = false
  let mut i = 0
  if s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  }
  if i >= end {
    return None
  }
  let mut acc = 0
  if i + 2 <= end && s.code_unit_at(i) == 48 && (s.code_unit_at(i + 1) == 120 || s.code_unit_at(i + 1) == 88) {
    i = i + 2
    if i >= end {
      return None
    }
    while i < end {
      let c = s.code_unit_at(i)
      let d = if c >= 48 && c <= 57 {
        c - 48
      } else if c >= 65 && c <= 70 {
        c - 55
      } else if c >= 97 && c <= 102 {
        c - 87
      } else {
        return None
      }
      acc = acc * 16 + d
      i = i + 1
    }
  } else {
    while i < end {
      let c = s.code_unit_at(i)
      if c < 48 || c > 57 {
        return None
      }
      acc = acc * 10 + (c - 48)
      i = i + 1
    }
  }
  Some(if neg { -acc } else { acc })
}

fn WgslParser::parse_attrs(self : WgslParser) -> Result[Array[WgslAttr], WgslError] {
  let attrs : Array[WgslAttr] = []
  while self.check_kind(tk_at) {
    let at_tok = self.advance()
    let name = match self.expect_ident() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let args : Array[String] = []
    if self.match_kind(tk_lparen) {
      while !self.check_kind(tk_rparen) && !self.is_eof() {
        let mut prefix = ""
        if self.match_kind(tk_minus) {
          prefix = "-"
        }
        let tok = self.advance()
        if tok.kind == tk_ident || tok.kind == tk_int {
          let mut arg_s = prefix + tok_text(self.src, tok)
          // Support dotted rule names like `@diagnostic(off, chromium.unreachable_code)`
          while self.match_kind(tk_dot) {
            let sub = match self.expect_ident() {
              Ok(s) => s
              Err(e) => return Err(e)
            }
            arg_s = arg_s + "." + sub
          }
          args.push(arg_s)
        } else {
          return Err(self.parse_err(tok, "invalid attribute argument '" + tok_text(self.src, tok) + "'"))
        }
        if !self.match_kind(tk_comma) {
          break
        }
      }
      match self.expect_kind(tk_rparen, ")") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    attrs.push(WgslAttr::{ name: name, args: args, line: at_tok.line, col: at_tok.col })
  }
  Ok(attrs)
}

fn wgsl_resolve_vec_alias(name : String) -> Option[WgslType] {
  let n = name.length()
  if n == 5 {
    // vec[234][fiuh]
    if name == "vec2f" {
      Some(WgslType::Vec(2, "f32"))
    } else if name == "vec3f" {
      Some(WgslType::Vec(3, "f32"))
    } else if name == "vec4f" {
      Some(WgslType::Vec(4, "f32"))
    } else if name == "vec2i" {
      Some(WgslType::Vec(2, "i32"))
    } else if name == "vec3i" {
      Some(WgslType::Vec(3, "i32"))
    } else if name == "vec4i" {
      Some(WgslType::Vec(4, "i32"))
    } else if name == "vec2u" {
      Some(WgslType::Vec(2, "u32"))
    } else if name == "vec3u" {
      Some(WgslType::Vec(3, "u32"))
    } else if name == "vec4u" {
      Some(WgslType::Vec(4, "u32"))
    } else if name == "vec2h" {
      Some(WgslType::Vec(2, "f16"))
    } else if name == "vec3h" {
      Some(WgslType::Vec(3, "f16"))
    } else if name == "vec4h" {
      Some(WgslType::Vec(4, "f16"))
    } else {
      None
    }
  } else if n == 7 {
    // mat[234]x[234][fh]
    if name == "mat2x2f" {
      Some(WgslType::Mat(2, 2, "f32"))
    } else if name == "mat3x3f" {
      Some(WgslType::Mat(3, 3, "f32"))
    } else if name == "mat4x4f" {
      Some(WgslType::Mat(4, 4, "f32"))
    } else if name == "mat2x3f" {
      Some(WgslType::Mat(2, 3, "f32"))
    } else if name == "mat2x4f" {
      Some(WgslType::Mat(2, 4, "f32"))
    } else if name == "mat3x2f" {
      Some(WgslType::Mat(3, 2, "f32"))
    } else if name == "mat3x4f" {
      Some(WgslType::Mat(3, 4, "f32"))
    } else if name == "mat4x2f" {
      Some(WgslType::Mat(4, 2, "f32"))
    } else if name == "mat4x3f" {
      Some(WgslType::Mat(4, 3, "f32"))
    } else if name == "mat2x2h" {
      Some(WgslType::Mat(2, 2, "f16"))
    } else if name == "mat3x3h" {
      Some(WgslType::Mat(3, 3, "f16"))
    } else if name == "mat4x4h" {
      Some(WgslType::Mat(4, 4, "f16"))
    } else if name == "mat2x3h" {
      Some(WgslType::Mat(2, 3, "f16"))
    } else if name == "mat2x4h" {
      Some(WgslType::Mat(2, 4, "f16"))
    } else if name == "mat3x2h" {
      Some(WgslType::Mat(3, 2, "f16"))
    } else if name == "mat3x4h" {
      Some(WgslType::Mat(3, 4, "f16"))
    } else if name == "mat4x2h" {
      Some(WgslType::Mat(4, 2, "f16"))
    } else if name == "mat4x3h" {
      Some(WgslType::Mat(4, 3, "f16"))
    } else {
      None
    }
  } else {
    None
  }
}

fn wgsl_is_generic_ctor(name : String) -> Bool {
  name == "vec2" ||
  name == "vec3" ||
  name == "vec4" ||
  name == "mat2x2" ||
  name == "mat3x3" ||
  name == "mat4x4" ||
  name == "mat2x3" ||
  name == "mat2x4" ||
  name == "mat3x2" ||
  name == "mat3x4" ||
  name == "mat4x2" ||
  name == "mat4x3" ||
  name == "array" ||
  name == "bitcast"
}

fn WgslParser::parse_type(self : WgslParser) -> Result[WgslType, WgslError] {
  let start_tok = self.peek()
  match self.enter_depth(start_tok) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let name = match self.expect_ident() {
    Ok(n) => n
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  if name == "f32" || name == "i32" || name == "u32" || name == "bool" || name == "f16" {
    self.leave_depth()
    return Ok(WgslType::Scalar(name))
  }
  if name == "sampler" {
    self.leave_depth()
    return Ok(WgslType::Sampler(false))
  }
  if name == "sampler_comparison" {
    self.leave_depth()
    return Ok(WgslType::Sampler(true))
  }
  if name == "texture_depth_2d" ||
  name == "texture_depth_2d_array" ||
  name == "texture_depth_cube" ||
  name == "texture_depth_cube_array" ||
  name == "texture_depth_multisampled_2d" {
    self.leave_depth()
    return Ok(WgslType::Texture(name, "", ""))
  }
  match wgsl_resolve_vec_alias(name) {
    Some(t) => {
      self.leave_depth()
      return Ok(t)
    }
    None => ()
  }
  if name == "vec2" || name == "vec3" || name == "vec4" {
    let dim = name.code_unit_at(3) - 48
    match self.expect_kind(tk_lt, "<") {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let elem = match self.expect_ident() {
      Ok(s) => s
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    match self.expect_gt() {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    self.leave_depth()
    return Ok(WgslType::Vec(dim, elem))
  }
  if name == "mat2x2" || name == "mat3x3" || name == "mat4x4" ||
  name == "mat2x3" || name == "mat2x4" || name == "mat3x2" ||
  name == "mat3x4" || name == "mat4x2" || name == "mat4x3" {
    let cols = name.code_unit_at(3) - 48
    let rows = name.code_unit_at(5) - 48
    match self.expect_kind(tk_lt, "<") {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let elem = match self.expect_ident() {
      Ok(s) => s
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    match self.expect_gt() {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    self.leave_depth()
    return Ok(WgslType::Mat(cols, rows, elem))
  }
  if name == "texture_1d" ||
  name == "texture_2d" ||
  name == "texture_2d_array" ||
  name == "texture_3d" ||
  name == "texture_cube" ||
  name == "texture_cube_array" ||
  name == "texture_multisampled_2d" {
    match self.expect_kind(tk_lt, "<") {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let elem = match self.expect_ident() {
      Ok(s) => s
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    match self.expect_gt() {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    self.leave_depth()
    return Ok(WgslType::Texture(name, elem, ""))
  }
  if name == "texture_storage_1d" ||
  name == "texture_storage_2d" ||
  name == "texture_storage_2d_array" ||
  name == "texture_storage_3d" {
    match self.expect_kind(tk_lt, "<") {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let fmt = match self.expect_ident() {
      Ok(s) => s
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    match self.expect_kind(tk_comma, ",") {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let acc = match self.expect_ident() {
      Ok(s) => s
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    match self.expect_gt() {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    self.leave_depth()
    return Ok(WgslType::Texture(name, fmt, acc))
  }
  if name == "atomic" {
    match self.expect_kind(tk_lt, "<") {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let elem = match self.expect_ident() {
      Ok(s) => s
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    match self.expect_gt() {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    self.leave_depth()
    return Ok(WgslType::Atomic(elem))
  }
  if name == "array" {
    match self.expect_kind(tk_lt, "<") {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let elem_ty = match self.parse_type() {
      Ok(t) => t
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let mut arr_len = 0
    let mut len_ident = ""
    if self.match_kind(tk_comma) {
      let tok = self.advance()
      if tok.kind == tk_int {
        match wgsl_parse_int_str(tok_text(self.src, tok)) {
          Some(v) =>
          if v > 0 {
            arr_len = v
          } else {
            self.leave_depth()
            return Err(self.parse_err(tok, "array length must be positive"))
          }
          None => {
            self.leave_depth()
            return Err(self.parse_err(tok, "invalid array length"))
          }
        }
      } else if tok.kind == tk_ident {
        len_ident = tok_text(self.src, tok)
      } else {
        self.leave_depth()
        return Err(self.parse_err(tok, "expected integer or const array length"))
      }
    }
    match self.expect_gt() {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    self.leave_depth()
    return Ok(WgslType::Array(elem_ty, arr_len, len_ident))
  }
  if name == "ptr" {
    match self.expect_kind(tk_lt, "<") {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let space = match self.expect_ident() {
      Ok(s) => s
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    match self.expect_kind(tk_comma, ",") {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let elem_ty = match self.parse_type() {
      Ok(t) => t
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    let mut acc = ""
    if self.match_kind(tk_comma) {
      acc = match self.expect_ident() {
        Ok(s) => s
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
    }
    match self.expect_gt() {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    self.leave_depth()
    return Ok(WgslType::Ptr(space, elem_ty, acc))
  }
  self.leave_depth()
  Ok(WgslType::Named(name))
}

fn WgslParser::parse_module(self : WgslParser) -> Result[WgslModule, WgslError] {
  let enables : Array[String] = []
  let aliases : Array[WgslAliasDecl] = []
  let structs : Array[WgslStructDecl] = []
  let globals : Array[WgslGlobalVar] = []
  let funcs : Array[WgslFuncDecl] = []

  while !self.is_eof() {
    if self.match_kind(tk_semi) {
      continue
    }
    let attrs = match self.parse_attrs() {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    if self.check_kw("struct") {
      let st = match self.parse_struct() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
      structs.push(st)
    } else if self.check_kw("alias") {
      let al = match self.parse_alias() {
        Ok(a) => a
        Err(e) => return Err(e)
      }
      aliases.push(al)
    } else if self.check_kw("var") || self.check_kw("const") || self.check_kw("override") {
      let gv = match self.parse_global_var(attrs) {
        Ok(g) => g
        Err(e) => return Err(e)
      }
      globals.push(gv)
    } else if self.check_kw("fn") {
      let f = match self.parse_func(attrs) {
        Ok(fn_decl) => fn_decl
        Err(e) => return Err(e)
      }
      funcs.push(f)
    } else if self.check_kw("enable") || self.check_kw("requires") {
      let _ = self.advance()
      while !self.is_eof() && !self.check_kind(tk_semi) {
        if self.peek().kind == tk_ident {
          enables.push(tok_text(self.src, self.advance()))
        } else {
          let _ = self.advance()
        }
        let _ = self.match_kind(tk_comma)
      }
      match self.expect_kind(tk_semi, ";") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    } else if self.check_kw("diagnostic") || self.check_kw("const_assert") {
      let _ = self.advance()
      while !self.is_eof() && !self.check_kind(tk_semi) {
        let _ = self.advance()
      }
      let _ = self.match_kind(tk_semi)
    } else {
      let tok = self.peek()
      return Err(
        self.parse_err(tok, "unexpected top-level token '" + tok_text(self.src, tok) + "'"),
      )
    }
  }
  Ok(
    WgslModule::{
      enables: enables,
      aliases: aliases,
      structs: structs,
      globals: globals,
      funcs: funcs,
    },
  )
}

fn WgslParser::parse_alias(self : WgslParser) -> Result[WgslAliasDecl, WgslError] {
  let kw = self.advance()
  let name = match self.expect_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  match self.expect_kind(tk_eq, "=") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let ty = match self.parse_type() {
    Ok(t) => t
    Err(e) => return Err(e)
  }
  match self.expect_kind(tk_semi, ";") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(WgslAliasDecl::{ name: name, ty: ty, line: kw.line, col: kw.col })
}

fn WgslParser::parse_struct(self : WgslParser) -> Result[WgslStructDecl, WgslError] {
  let kw = self.advance()
  let name = match self.expect_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  match self.expect_kind(tk_lbrace, "{") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let fields : Array[WgslStructField] = []
  while !self.check_kind(tk_rbrace) && !self.is_eof() {
    let fattrs = match self.parse_attrs() {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let ftok = self.peek()
    let fname = match self.expect_ident() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    match self.expect_kind(tk_colon, ":") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let fty = match self.parse_type() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    fields.push(
      WgslStructField::{ name: fname, ty: fty, attrs: fattrs, line: ftok.line, col: ftok.col },
    )
    if !self.match_kind(tk_comma) {
      break
    }
  }
  match self.expect_kind(tk_rbrace, "}") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let _ = self.match_kind(tk_semi)
  Ok(WgslStructDecl::{ name: name, fields: fields, line: kw.line, col: kw.col })
}

fn WgslParser::parse_global_var(
  self : WgslParser,
  attrs : Array[WgslAttr],
) -> Result[WgslGlobalVar, WgslError] {
  let kw = self.advance()
  let decl_kind = tok_text(self.src, kw)
  let mut addr_space = ""
  let mut access = ""
  if decl_kind == "var" && self.match_kind(tk_lt) {
    addr_space = match self.expect_ident() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    if self.match_kind(tk_comma) {
      access = match self.expect_ident() {
        Ok(s) => s
        Err(e) => return Err(e)
      }
    }
    match self.expect_gt() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let name = match self.expect_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  let ty : Option[WgslType] = if self.match_kind(tk_colon) {
    match self.parse_type() {
      Ok(t) => Some(t)
      Err(e) => return Err(e)
    }
  } else {
    None
  }
  let init : Option[WgslExpr] = if self.match_kind(tk_eq) {
    match self.parse_expr() {
      Ok(ex) => Some(ex)
      Err(e) => return Err(e)
    }
  } else {
    None
  }
  match self.expect_kind(tk_semi, ";") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(
    WgslGlobalVar::{
      name: name,
      decl_kind: decl_kind,
      addr_space: addr_space,
      access: access,
      ty: ty,
      init: init,
      attrs: attrs,
      line: kw.line,
      col: kw.col,
    },
  )
}

fn WgslParser::parse_func(
  self : WgslParser,
  attrs : Array[WgslAttr],
) -> Result[WgslFuncDecl, WgslError] {
  let kw = self.advance()
  let name = match self.expect_ident() {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  match self.expect_kind(tk_lparen, "(") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let params : Array[WgslParam] = []
  while !self.check_kind(tk_rparen) && !self.is_eof() {
    let pattrs = match self.parse_attrs() {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let ptok = self.peek()
    let pname = match self.expect_ident() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    match self.expect_kind(tk_colon, ":") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let pty = match self.parse_type() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    params.push(WgslParam::{ name: pname, ty: pty, attrs: pattrs, line: ptok.line, col: ptok.col })
    if !self.match_kind(tk_comma) {
      break
    }
  }
  match self.expect_kind(tk_rparen, ")") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut ret_attrs : Array[WgslAttr] = []
  let mut ret_ty : Option[WgslType] = None
  if self.match_kind(tk_arrow) {
    ret_attrs = match self.parse_attrs() {
      Ok(a) => a
      Err(e) => return Err(e)
    }
    let rt = match self.parse_type() {
      Ok(t) => t
      Err(e) => return Err(e)
    }
    ret_ty = Some(rt)
  }
  let body = match self.parse_block() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  Ok(
    WgslFuncDecl::{
      name: name,
      params: params,
      ret_ty: ret_ty,
      ret_attrs: ret_attrs,
      attrs: attrs,
      body: body,
      line: kw.line,
      col: kw.col,
    },
  )
}

fn WgslParser::parse_block(self : WgslParser) -> Result[Array[WgslStmt], WgslError] {
  let start_tok = self.peek()
  match self.enter_depth(start_tok) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.expect_kind(tk_lbrace, "{") {
    Ok(_) => ()
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  let stmts : Array[WgslStmt] = []
  while !self.check_kind(tk_rbrace) && !self.is_eof() {
    if self.match_kind(tk_semi) {
      continue
    }
    match self.parse_stmt() {
      Ok(s) => stmts.push(s)
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
  }
  match self.expect_kind(tk_rbrace, "}") {
    Ok(_) => ()
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  self.leave_depth()
  Ok(stmts)
}

fn wgsl_assign_op_str(k : Int) -> String {
  if k == tk_eq {
    "="
  } else if k == tk_pluseq {
    "+="
  } else if k == tk_minuseq {
    "-="
  } else if k == tk_stareq {
    "*="
  } else if k == tk_slasheq {
    "/="
  } else if k == tk_percenteq {
    "%="
  } else if k == tk_ampeq {
    "&="
  } else if k == tk_pipeeq {
    "|="
  } else if k == tk_careteq {
    "^="
  } else if k == tk_shleq {
    "<<="
  } else if k == tk_shreq {
    ">>="
  } else {
    ""
  }
}

fn WgslParser::parse_simple_stmt(self : WgslParser) -> Result[WgslStmt, WgslError] {
  if self.check_kw("var") || self.check_kw("let") || self.check_kw("const") {
    let kw = self.advance()
    let kind_s = tok_text(self.src, kw)
    if kind_s == "var" && self.match_kind(tk_lt) {
      let _ = self.expect_ident()
      if self.match_kind(tk_comma) {
        let _ = self.expect_ident()
      }
      match self.expect_gt() {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    let name = match self.expect_ident() {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let ty : Option[WgslType] = if self.match_kind(tk_colon) {
      match self.parse_type() {
        Ok(t) => Some(t)
        Err(e) => return Err(e)
      }
    } else {
      None
    }
    let init : Option[WgslExpr] = if self.match_kind(tk_eq) {
      match self.parse_expr() {
        Ok(ex) => Some(ex)
        Err(e) => return Err(e)
      }
    } else {
      None
    }
    return Ok(WgslStmt::VarDecl(name, kind_s, ty, init, kw.line, kw.col))
  }
  // Phony assignment `_ = expr`
  if self.check_kw("_") {
    let utok = self.advance()
    match self.expect_kind(tk_eq, "=") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let rhs = match self.parse_expr() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    return Ok(WgslStmt::PhonyAssign(rhs, utok.line, utok.col))
  }
  let start_tok = self.peek()
  let lhs = match self.parse_expr() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  let next = self.peek()
  if next.kind == tk_plusplus {
    let _ = self.advance()
    return Ok(WgslStmt::IncDec(lhs, true, next.line, next.col))
  }
  if next.kind == tk_minusminus {
    let _ = self.advance()
    return Ok(WgslStmt::IncDec(lhs, false, next.line, next.col))
  }
  let aop = wgsl_assign_op_str(next.kind)
  if aop.length() > 0 {
    let _ = self.advance()
    let rhs = match self.parse_expr() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    return Ok(WgslStmt::Assign(lhs, aop, rhs, next.line, next.col))
  }
  Ok(WgslStmt::ExprStmt(lhs, start_tok.line, start_tok.col))
}

fn WgslParser::parse_stmt(self : WgslParser) -> Result[WgslStmt, WgslError] {
  if self.check_kw("return") {
    let kw = self.advance()
    if self.match_kind(tk_semi) {
      return Ok(WgslStmt::Return(None, kw.line, kw.col))
    }
    let ex = match self.parse_expr() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    match self.expect_kind(tk_semi, ";") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(WgslStmt::Return(Some(ex), kw.line, kw.col))
  }
  if self.check_kw("if") {
    return self.parse_if()
  }
  if self.check_kw("switch") {
    return self.parse_switch()
  }
  if self.check_kw("for") {
    return self.parse_for()
  }
  if self.check_kw("while") {
    let kw = self.advance()
    let cond = match self.parse_expr() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    let body = match self.parse_block() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    return Ok(WgslStmt::While(cond, body, kw.line, kw.col))
  }
  if self.check_kw("loop") {
    return self.parse_loop()
  }
  if self.check_kw("break") {
    let kw = self.advance()
    match self.expect_kind(tk_semi, ";") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(WgslStmt::Break(kw.line, kw.col))
  }
  if self.check_kw("continue") {
    let kw = self.advance()
    match self.expect_kind(tk_semi, ";") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(WgslStmt::Continue(kw.line, kw.col))
  }
  if self.check_kw("discard") {
    let kw = self.advance()
    match self.expect_kind(tk_semi, ";") {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return Ok(WgslStmt::Discard(kw.line, kw.col))
  }
  if self.check_kind(tk_lbrace) {
    let tok = self.peek()
    let body = match self.parse_block() {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    return Ok(WgslStmt::Block(body, tok.line, tok.col))
  }
  let s = match self.parse_simple_stmt() {
    Ok(st) => st
    Err(e) => return Err(e)
  }
  match self.expect_kind(tk_semi, ";") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(s)
}

fn WgslParser::parse_if(self : WgslParser) -> Result[WgslStmt, WgslError] {
  let kw = self.advance()
  match self.enter_depth(kw) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let cond = match self.parse_expr() {
    Ok(e) => e
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  let then_body = match self.parse_block() {
    Ok(b) => b
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  let mut else_body : Array[WgslStmt] = []
  if self.match_kw("else") {
    if self.check_kw("if") {
      match self.parse_if() {
        Ok(sub) => else_body.push(sub)
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
    } else {
      else_body = match self.parse_block() {
        Ok(b) => b
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
    }
  }
  self.leave_depth()
  Ok(WgslStmt::If(cond, then_body, else_body, kw.line, kw.col))
}

fn WgslParser::parse_switch(self : WgslParser) -> Result[WgslStmt, WgslError] {
  let kw = self.advance()
  match self.enter_depth(kw) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let selector = match self.parse_expr() {
    Ok(e) => e
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  match self.expect_kind(tk_lbrace, "{") {
    Ok(_) => ()
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  let cases : Array[WgslSwitchCase] = []
  while !self.check_kind(tk_rbrace) && !self.is_eof() {
    let ctok = self.peek()
    let selectors : Array[WgslExpr] = []
    let mut is_default = false
    if self.match_kw("default") {
      is_default = true
      let _ = self.match_kind(tk_colon)
    } else if self.match_kw("case") {
      while !self.check_kind(tk_colon) && !self.check_kind(tk_lbrace) && !self.is_eof() {
        if self.match_kw("default") {
          is_default = true
        } else {
          let ex = match self.parse_expr() {
            Ok(e) => e
            Err(e) => {
              self.leave_depth()
              return Err(e)
            }
          }
          selectors.push(ex)
        }
        if !self.match_kind(tk_comma) {
          break
        }
      }
      let _ = self.match_kind(tk_colon)
    } else {
      self.leave_depth()
      return Err(
        self.parse_err(
          ctok,
          "expected 'case' or 'default' in switch, got '" + tok_text(self.src, ctok) + "'",
        ),
      )
    }
    let body = match self.parse_block() {
      Ok(b) => b
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    cases.push(
      WgslSwitchCase::{
        selectors: selectors,
        is_default: is_default,
        body: body,
        line: ctok.line,
        col: ctok.col,
      },
    )
  }
  match self.expect_kind(tk_rbrace, "}") {
    Ok(_) => ()
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  self.leave_depth()
  Ok(WgslStmt::Switch(selector, cases, kw.line, kw.col))
}

fn WgslParser::parse_loop(self : WgslParser) -> Result[WgslStmt, WgslError] {
  let kw = self.advance()
  match self.enter_depth(kw) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.expect_kind(tk_lbrace, "{") {
    Ok(_) => ()
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  let body : Array[WgslStmt] = []
  let mut cont_body : Array[WgslStmt] = []
  let mut break_if : Option[WgslExpr] = None
  while !self.check_kind(tk_rbrace) && !self.is_eof() {
    if self.match_kind(tk_semi) {
      continue
    }
    if self.match_kw("continuing") {
      match self.expect_kind(tk_lbrace, "{") {
        Ok(_) => ()
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
      while !self.check_kind(tk_rbrace) && !self.is_eof() {
        if self.match_kind(tk_semi) {
          continue
        }
        if self.check_kw("break") {
          let _ = self.advance()
          if self.match_kw("if") {
            let cond = match self.parse_expr() {
              Ok(e) => e
              Err(e) => {
                self.leave_depth()
                return Err(e)
              }
            }
            match self.expect_kind(tk_semi, ";") {
              Ok(_) => ()
              Err(e) => {
                self.leave_depth()
                return Err(e)
              }
            }
            break_if = Some(cond)
            continue
          }
          match self.expect_kind(tk_semi, ";") {
            Ok(_) => ()
            Err(e) => {
              self.leave_depth()
              return Err(e)
            }
          }
          cont_body.push(WgslStmt::Break(kw.line, kw.col))
          continue
        }
        match self.parse_stmt() {
          Ok(s) => cont_body.push(s)
          Err(e) => {
            self.leave_depth()
            return Err(e)
          }
        }
      }
      match self.expect_kind(tk_rbrace, "}") {
        Ok(_) => ()
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
      break
    }
    match self.parse_stmt() {
      Ok(s) => body.push(s)
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
  }
  match self.expect_kind(tk_rbrace, "}") {
    Ok(_) => ()
    Err(e) => {
      self.leave_depth()
      return Err(e)
    }
  }
  self.leave_depth()
  Ok(WgslStmt::Loop(body, cont_body, break_if, kw.line, kw.col))
}

fn WgslParser::parse_for(self : WgslParser) -> Result[WgslStmt, WgslError] {
  let kw = self.advance()
  match self.expect_kind(tk_lparen, "(") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let init : Option[WgslStmt] = if self.check_kind(tk_semi) {
    None
  } else {
    match self.parse_simple_stmt() {
      Ok(s) => Some(s)
      Err(e) => return Err(e)
    }
  }
  match self.expect_kind(tk_semi, ";") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let cond : Option[WgslExpr] = if self.check_kind(tk_semi) {
    None
  } else {
    match self.parse_expr() {
      Ok(e) => Some(e)
      Err(e) => return Err(e)
    }
  }
  match self.expect_kind(tk_semi, ";") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let update : Option[WgslStmt] = if self.check_kind(tk_rparen) {
    None
  } else {
    match self.parse_simple_stmt() {
      Ok(s) => Some(s)
      Err(e) => return Err(e)
    }
  }
  match self.expect_kind(tk_rparen, ")") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let body = match self.parse_block() {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  Ok(WgslStmt::For(init, cond, update, body, kw.line, kw.col))
}

// --- Expression Parser (Precedence Climbing) ---

fn WgslParser::parse_expr(self : WgslParser) -> Result[WgslExpr, WgslError] {
  self.parse_or()
}

fn WgslParser::parse_or(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let mut left = match self.parse_and() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while self.check_kind(tk_oror) {
    let op = self.advance()
    let right = match self.parse_and() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = WgslExpr::Binary("||", left, right, op.line, op.col)
  }
  Ok(left)
}

fn WgslParser::parse_and(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let mut left = match self.parse_bitor() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while self.check_kind(tk_andand) {
    let op = self.advance()
    let right = match self.parse_bitor() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = WgslExpr::Binary("&&", left, right, op.line, op.col)
  }
  Ok(left)
}

fn WgslParser::parse_bitor(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let mut left = match self.parse_bitxor() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while self.check_kind(tk_pipe) {
    let op = self.advance()
    let right = match self.parse_bitxor() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = WgslExpr::Binary("|", left, right, op.line, op.col)
  }
  Ok(left)
}

fn WgslParser::parse_bitxor(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let mut left = match self.parse_bitand() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while self.check_kind(tk_caret) {
    let op = self.advance()
    let right = match self.parse_bitand() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = WgslExpr::Binary("^", left, right, op.line, op.col)
  }
  Ok(left)
}

fn WgslParser::parse_bitand(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let mut left = match self.parse_equality() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while self.check_kind(tk_amp) {
    let op = self.advance()
    let right = match self.parse_equality() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = WgslExpr::Binary("&", left, right, op.line, op.col)
  }
  Ok(left)
}

fn WgslParser::parse_equality(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let mut left = match self.parse_relational() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while self.check_kind(tk_eqeq) || self.check_kind(tk_neq) {
    let op = self.advance()
    let op_s = if op.kind == tk_eqeq { "==" } else { "!=" }
    let right = match self.parse_relational() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = WgslExpr::Binary(op_s, left, right, op.line, op.col)
  }
  Ok(left)
}

fn WgslParser::parse_relational(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let mut left = match self.parse_shift() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while self.check_kind(tk_lt) || self.check_kind(tk_le) || self.check_kind(tk_gt) || self.check_kind(tk_ge) {
    let op = self.advance()
    let op_s = if op.kind == tk_lt {
      "<"
    } else if op.kind == tk_le {
      "<="
    } else if op.kind == tk_gt {
      ">"
    } else {
      ">="
    }
    let right = match self.parse_shift() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = WgslExpr::Binary(op_s, left, right, op.line, op.col)
  }
  Ok(left)
}

fn WgslParser::parse_shift(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let mut left = match self.parse_additive() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while self.check_kind(tk_shl) || self.check_kind(tk_shr) {
    let op = self.advance()
    let op_s = if op.kind == tk_shl { "<<" } else { ">>" }
    let right = match self.parse_additive() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = WgslExpr::Binary(op_s, left, right, op.line, op.col)
  }
  Ok(left)
}

fn WgslParser::parse_additive(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let mut left = match self.parse_multiplicative() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while self.check_kind(tk_plus) || self.check_kind(tk_minus) {
    let op = self.advance()
    let op_s = if op.kind == tk_plus { "+" } else { "-" }
    let right = match self.parse_multiplicative() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = WgslExpr::Binary(op_s, left, right, op.line, op.col)
  }
  Ok(left)
}

fn WgslParser::parse_multiplicative(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let mut left = match self.parse_unary() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while self.check_kind(tk_star) || self.check_kind(tk_slash) || self.check_kind(tk_percent) {
    let op = self.advance()
    let op_s = if op.kind == tk_star { "*" } else if op.kind == tk_slash { "/" } else { "%" }
    let right = match self.parse_unary() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    left = WgslExpr::Binary(op_s, left, right, op.line, op.col)
  }
  Ok(left)
}

fn WgslParser::parse_unary(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let tok = self.peek()
  let op_s = if tok.kind == tk_minus {
    "-"
  } else if tok.kind == tk_bang {
    "!"
  } else if tok.kind == tk_tilde {
    "~"
  } else if tok.kind == tk_amp {
    "&"
  } else if tok.kind == tk_star {
    "*"
  } else {
    ""
  }
  if op_s.length() > 0 {
    let op = self.advance()
    match self.enter_depth(op) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let operand = match self.parse_unary() {
      Ok(e) => e
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    self.leave_depth()
    return Ok(WgslExpr::Unary(op_s, operand, op.line, op.col))
  }
  self.parse_postfix()
}

fn WgslParser::parse_call_args(self : WgslParser) -> Result[Array[WgslExpr], WgslError] {
  match self.expect_kind(tk_lparen, "(") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let args : Array[WgslExpr] = []
  while !self.check_kind(tk_rparen) && !self.is_eof() {
    let arg = match self.parse_expr() {
      Ok(e) => e
      Err(e) => return Err(e)
    }
    args.push(arg)
    if !self.match_kind(tk_comma) {
      break
    }
  }
  match self.expect_kind(tk_rparen, ")") {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  Ok(args)
}

fn WgslParser::parse_postfix(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let mut expr = match self.parse_primary() {
    Ok(e) => e
    Err(e) => return Err(e)
  }
  while true {
    if self.match_kind(tk_dot) {
      let ftok = self.peek()
      let field = match self.expect_ident() {
        Ok(n) => n
        Err(e) => return Err(e)
      }
      expr = WgslExpr::Field(expr, field, ftok.line, ftok.col)
    } else if self.match_kind(tk_lbracket) {
      let btok = self.peek()
      let idx = match self.parse_expr() {
        Ok(e) => e
        Err(e) => return Err(e)
      }
      match self.expect_kind(tk_rbracket, "]") {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      expr = WgslExpr::Index(expr, idx, btok.line, btok.col)
    } else {
      break
    }
  }
  Ok(expr)
}

fn WgslParser::parse_primary(self : WgslParser) -> Result[WgslExpr, WgslError] {
  let tok = self.peek()
  if tok.kind == tk_int {
    let _ = self.advance()
    return Ok(WgslExpr::IntLit(tok_text(self.src, tok), tok.line, tok.col))
  }
  if tok.kind == tk_float {
    let _ = self.advance()
    return Ok(WgslExpr::FloatLit(tok_text(self.src, tok), tok.line, tok.col))
  }
  if tok.kind == tk_ident {
    let _ = self.advance()
    if tok_eq(self.src, tok, "true") {
      return Ok(WgslExpr::BoolLit(true, tok.line, tok.col))
    }
    if tok_eq(self.src, tok, "false") {
      return Ok(WgslExpr::BoolLit(false, tok.line, tok.col))
    }
    let name = tok_text(self.src, tok)
    // Generic constructor call: vec4<f32>(...), array<vec2<f32>, 3>(...), bitcast<u32>(...)
    if wgsl_is_generic_ctor(name) && self.check_kind(tk_lt) {
      match self.enter_depth(tok) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let _ = self.advance()
      let type_args : Array[WgslType] = []
      let t0 = match self.parse_type() {
        Ok(t) => t
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
      type_args.push(t0)
      let mut arr_len = 0
      let mut len_ident = ""
      if self.match_kind(tk_comma) {
        let ltok = self.advance()
        if ltok.kind == tk_int {
          match wgsl_parse_int_str(tok_text(self.src, ltok)) {
            Some(v) => arr_len = v
            None => {
              self.leave_depth()
              return Err(self.parse_err(ltok, "expected integer template length"))
            }
          }
        } else if ltok.kind == tk_ident {
          len_ident = tok_text(self.src, ltok)
        } else {
          self.leave_depth()
          return Err(self.parse_err(ltok, "expected integer or const template length"))
        }
      }
      match self.expect_gt() {
        Ok(_) => ()
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
      let args = match self.parse_call_args() {
        Ok(a) => a
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
      self.leave_depth()
      return Ok(WgslExpr::Call(name, type_args, arr_len, len_ident, args, tok.line, tok.col))
    }
    if self.check_kind(tk_lparen) {
      match self.enter_depth(tok) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let args = match self.parse_call_args() {
        Ok(a) => a
        Err(e) => {
          self.leave_depth()
          return Err(e)
        }
      }
      self.leave_depth()
      return Ok(WgslExpr::Call(name, [], 0, "", args, tok.line, tok.col))
    }
    return Ok(WgslExpr::Ident(name, tok.line, tok.col))
  }
  if tok.kind == tk_lparen {
    let _ = self.advance()
    match self.enter_depth(tok) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let inner = match self.parse_expr() {
      Ok(e) => e
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    match self.expect_kind(tk_rparen, ")") {
      Ok(_) => ()
      Err(e) => {
        self.leave_depth()
        return Err(e)
      }
    }
    self.leave_depth()
    return Ok(WgslExpr::Paren(inner, tok.line, tok.col))
  }
  if tok.kind == tk_eof {
    return Err(self.parse_err(tok, "unexpected end of file in expression"))
  }
  Err(
    self.parse_err(tok, "unexpected token '" + tok_text(self.src, tok) + "' in expression"),
  )
}
