///| Additional W3C WGSL edge-case, nested generics, atomics, bitcast, pack/unpack, and reflection tests.

test "nested_generic_types_shr_splitting" {
  let src =
  #|struct Boxed {
    #| items : array<vec4<f32>>,
    #|}
  #|fn mutate(p : ptr<function, vec4<f32>>) {
    #| *p = vec4<f32>(1.0, 2.0, 3.0, 4.0);
    #|}
  #|@compute @workgroup_size(1)
  #|fn cs() {
    #| var v = vec4<f32>(0.0);
    #| mutate(&v);
    #| _ = v;
    #|}
  match compile_to_msl(src, CompileOptions::default()) {
    Ok(m) => {
      debug_assert(test_contains(m.source, "thread float4* p"), "ptr emitted")
      debug_assert(test_contains(m.source, "(void)(v);"), "phony assign emitted")
    }
    Err(e) => debug_assert(false, "nested generics failed: " + e.to_string())
  }
}

test "atomics_bitcast_pack_unpack_and_hex_floats" {
  let src =
  #|const HALF_HEX : f32 = 0x1.8p+1f;
  #|@group(0) @binding(0) var<storage, read_write> counter : atomic<u32>;
  #|@group(0) @binding(1) var<storage, read_write> out_buf : array<u32>;
  #|
  #|@compute @workgroup_size(16)
  #|fn cs_bits(@builtin(global_invocation_id) gid : vec3u) {
    #| let prev = atomicAdd(&counter, 1u);
    #| let bits = bitcast<u32>(HALF_HEX);
    #| let packed = pack2x16float(vec2f(1.0, 2.0));
    #| let unpacked = unpack2x16float(packed);
    #| out_buf[gid.x] = prev + bits + u32(unpacked.x);
    #|}
  match compile_to_msl(src, CompileOptions::default()) {
    Ok(m) => {
      debug_assert(test_contains(m.source, "atomic_fetch_add_explicit("), "atomicAdd")
      debug_assert(test_contains(m.source, "as_type<uint>("), "bitcast")
      debug_assert(test_contains(m.source, "half2("), "pack2x16float")
    }
    Err(e) => debug_assert(false, "msl failed: " + e.to_string())
  }
  match compile_to_glsl(src, CompileOptions::with_entry_point("cs_bits")) {
    Ok(g) => {
      debug_assert(test_contains(g.source, "floatBitsToUint("), "glsl bitcast")
      debug_assert(test_contains(g.source, "packHalf2x16("), "glsl packHalf2x16")
      debug_assert(test_contains(g.source, "unpackHalf2x16("), "glsl unpackHalf2x16")
    }
    Err(e) => debug_assert(false, "glsl failed: " + e.to_string())
  }
}

test "validate_rejects_discard_in_vertex_and_duplicate_override_id_and_struct_field" {
  let bad_discard =
  #|@vertex fn vs() -> @builtin(position) vec4f {
    #| discard;
    #| return vec4f(0.0);
    #|}
  match reflect(bad_discard) {
    Ok(_) => debug_assert(false, "expected discard error in vertex")
    Err(e) => debug_assert(test_contains(e.message, "discard"), "msg: " + e.message)
  }

  let dup_id =
  #|@id(3) override A : f32 = 1.0;
  #|@id(3) override B : f32 = 2.0;
  #|@compute @workgroup_size(1) fn cs() {}
  match reflect(dup_id) {
    Ok(_) => debug_assert(false, "expected duplicate @id error")
    Err(e) => debug_assert(test_contains(e.message, "duplicate override"), "msg: " + e.message)
  }

  let dup_field =
  #|struct S { a : f32, a : i32 }
  #|@compute @workgroup_size(1) fn cs() {}
  match reflect(dup_field) {
    Ok(_) => debug_assert(false, "expected duplicate field error")
    Err(e) => debug_assert(test_contains(e.message, "duplicate field"), "msg: " + e.message)
  }
}

test "workgroup_size_from_const_and_all_builtins_reflection" {
  let src =
  #|const WG_X : u32 = 32u;
  #|@compute @workgroup_size(WG_X, 2, 1)
  #|fn cs_const(
    #| @builtin(global_invocation_id) gid : vec3u,
    #| @builtin(workgroup_id) wid : vec3u,
    #| @builtin(num_workgroups) nwg : vec3u,
    #|) {
    #| _ = gid.x + wid.x + nwg.x;
    #|}
  match reflect(src) {
    Ok(r) => {
      debug_assert(r.entries.length() == 1, "1 entry")
      debug_assert(r.entries[0].workgroup_size_x == 32, "wgx=32 from const")
      debug_assert(r.entries[0].workgroup_size_y == 2, "wgy=2")
      debug_assert(r.entries[0].workgroup_size_z == 1, "wgz=1")
    }
    Err(e) => debug_assert(false, "const workgroup_size failed: " + e.to_string())
  }
}
