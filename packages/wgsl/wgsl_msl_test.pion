///| WGSL -> Metal Shading Language (MSL 2.x) backend & reflection tests.

test "msl_vertex_and_fragment_pipeline_with_main_rename" {
  let src =
  #|struct Uniforms {
  #| mvp : mat4x4f,
  #| tint : vec4f,
  #|}
  #|struct VsIn {
  #| @location(0) pos : vec3f,
  #| @location(1) uv : vec2f,
  #|}
  #|struct VsOut {
  #| @builtin(position) clip_pos : vec4f,
  #| @location(0) uv : vec2f,
  #|}
  #|@group(0) @binding(0) var<uniform> u : Uniforms;
  #|@group(1) @binding(2) var albedo : texture_2d<f32>;
  #|@group(1) @binding(3) var samp : sampler;
  #|
  #|@vertex
  #|fn main(in : VsIn, @builtin(vertex_index) vid : u32) -> VsOut {
  #| var out : VsOut;
  #| out.clip_pos = u.mvp * vec4f(in.pos, 1.0);
  #| out.uv = in.uv + vec2f(f32(vid) * 0.0, 0.0);
  #| return out;
  #|}
  #|
  #|@fragment
  #|fn fs_main(in : VsOut, @builtin(front_facing) ff : bool) -> @location(0) vec4f {
  #| let c = textureSample(albedo, samp, in.uv);
  #| return select(c * 0.5, c * u.tint, ff);
  #|}
  match compile_to_msl(src, CompileOptions::default()) {
    Ok(compiled) => {
      debug_assert(test_contains(compiled.source, "#include <metal_stdlib>"), "metal_stdlib header")
      debug_assert(test_contains(compiled.source, "using namespace metal;"), "using namespace metal")
      debug_assert(test_contains(compiled.source, "vertex VsOut main0("), "main renamed to main0")
      debug_assert(test_contains(compiled.source, "[[stage_in]]"), "stage_in")
      debug_assert(test_contains(compiled.source, "[[vertex_id]]"), "vertex_id")
      debug_assert(test_contains(compiled.source, "[[position]]"), "position")
      debug_assert(test_contains(compiled.source, "[[attribute(0)]]"), "attribute(0)")
      debug_assert(test_contains(compiled.source, "[[user(loc0)]]"), "user(loc0)")
      debug_assert(test_contains(compiled.source, "[[buffer(0)]]"), "buffer(0)")
      debug_assert(test_contains(compiled.source, "[[texture(10)]]"), "texture(10)")
      debug_assert(test_contains(compiled.source, "[[sampler(11)]]"), "sampler(11)")
      debug_assert(test_contains(compiled.source, "albedo.sample(samp, in.uv)"), "texture sample")
      debug_assert(test_contains(compiled.source, "[[front_facing]]"), "front_facing")
      debug_assert(compiled.reflection.entries.length() == 2, "2 entries")
      match find_entry_point(compiled.reflection, "main") {
        Ok(ep) => debug_assert(ep.msl_name == "main0", "ep msl_name main0")
        Err(e) => debug_assert(false, "find_entry_point failed: " + e.to_string())
      }
    }
    Err(e) => debug_assert(false, "compile_to_msl failed: " + e.to_string())
  }
}

test "msl_compute_workgroup_and_builtins" {
  let src =
  #|@group(0) @binding(0) var<storage, read> src_buf : array<f32>;
  #|@group(0) @binding(1) var<storage, read_write> dst_buf : array<f32>;
  #|var<workgroup> tile : array<f32, 64>;
  #|
  #|@compute @workgroup_size(64, 1, 1)
  #|fn reduce_kernel(
  #| @builtin(global_invocation_id) gid : vec3u,
  #| @builtin(local_invocation_index) lidx : u32,
  #|) {
  #| let v = src_buf[gid.x];
  #| tile[lidx] = inverseSqrt(max(v, 0.0001));
  #| workgroupBarrier();
  #| dst_buf[gid.x] = clamp(tile[lidx], 0.0, 1.0);
  #|}
  match compile_to_msl(src, CompileOptions::default()) {
    Ok(compiled) => {
      debug_assert(test_contains(compiled.source, "kernel void reduce_kernel("), "kernel decl")
      debug_assert(test_contains(compiled.source, "[[thread_position_in_grid]]"), "gid")
      debug_assert(test_contains(compiled.source, "[[thread_index_in_threadgroup]]"), "lidx")
      debug_assert(test_contains(compiled.source, "threadgroup array<float, 64> tile"), "workgroup var")
      debug_assert(
        test_contains(compiled.source, "threadgroup_barrier(mem_flags::mem_threadgroup)"),
        "workgroupBarrier",
      )
      debug_assert(test_contains(compiled.source, "rsqrt("), "rsqrt remap")
      debug_assert(compiled.reflection.entries[0].workgroup_size_x == 64, "wgx=64")
    }
    Err(e) => debug_assert(false, "compile_to_msl failed: " + e.to_string())
  }
}

test "msl_switch_loop_continuing_and_builtins" {
  let src =
  #|@fragment
  #|fn fs_fx(@location(0) uv : vec2f, @location(1) @interpolate(flat) mode : u32) -> @location(0) vec4f {
  #| var acc = vec3f(0.0);
  #| let dx = dpdx(uv.x);
  #| let dy = dpdy(uv.y);
  #| let fw = fwidth(uv.x);
  #| switch mode {
  #| case 0u: {
  #| acc = vec3f(dx, dy, fw);
  #| }
  #| default: {
  #| acc = normalize(cross(vec3f(1.0, 0.0, 0.0), vec3f(0.0, 1.0, 0.0)));
  #| }
  #| }
  #| var i : i32 = 0;
  #| loop {
  #| if i >= 2 { break; }
  #| acc += vec3f(0.1);
  #| continuing {
  #| i++;
  #| break if i == 2;
  #| }
  #| }
  #| return vec4f(acc, 1.0);
  #|}
  match compile_to_msl(src, CompileOptions::default()) {
    Ok(compiled) => {
      debug_assert(test_contains(compiled.source, "dfdx("), "dfdx")
      debug_assert(test_contains(compiled.source, "dfdy("), "dfdy")
      debug_assert(test_contains(compiled.source, "fwidth("), "fwidth")
      debug_assert(test_contains(compiled.source, "switch (mode)"), "switch")
      debug_assert(test_contains(compiled.source, "[[flat]]"), "flat interp")
    }
    Err(e) => debug_assert(false, "compile_to_msl failed: " + e.to_string())
  }
}
