///| 4-mode (native_dbg / native_rel / wasm_dbg / wasm_rel) deterministic smoke & MSL/GLSL emitter.

import "wgsl"

fn pbr_shader() -> String {
  #|struct Camera {
  #| view_proj : mat4x4f,
  #| eye_pos : vec4f,
  #|}
  #|struct VsIn {
  #| @location(0) pos : vec3f,
  #| @location(1) normal : vec3f,
  #| @location(2) uv : vec2f,
  #|}
  #|struct VsOut {
  #| @builtin(position) clip_pos : vec4f,
  #| @location(0) world_pos : vec3f,
  #| @location(1) normal : vec3f,
  #| @location(2) uv : vec2f,
  #|}
  #|@group(0) @binding(0) var<uniform> cam : Camera;
  #|@group(1) @binding(0) var albedo_tex : texture_2d<f32>;
  #|@group(1) @binding(1) var linear_samp : sampler;
  #|
  #|@vertex
  #|fn vs_main(in : VsIn) -> VsOut {
  #| var out : VsOut;
  #| out.clip_pos = cam.view_proj * vec4f(in.pos, 1.0);
  #| out.world_pos = in.pos;
  #| out.normal = normalize(in.normal);
  #| out.uv = in.uv;
  #| return out;
  #|}
  #|
  #|@fragment
  #|fn fs_main(in : VsOut) -> @location(0) vec4f {
  #| let base = textureSample(albedo_tex, linear_samp, in.uv);
  #| let n = normalize(in.normal);
  #| let l = normalize(vec3f(0.5, 0.8, 0.3));
  #| let ndotl = max(dot(n, l), 0.0);
  #| let v = normalize(cam.eye_pos.xyz - in.world_pos);
  #| let h = normalize(l + v);
  #| let spec = pow(max(dot(n, h), 0.0), 32.0);
  #| let col = base.rgb * (0.15 + 0.85 * ndotl) + vec3f(spec * 0.4);
  #| return vec4f(col, base.a);
  #|}
}

fn particle_shader() -> String {
  #|struct SimParams {
  #| dt : f32,
  #| count : u32,
  #|}
  #|struct Particle {
  #| pos : vec4f,
  #| vel : vec4f,
  #|}
  #|@group(0) @binding(0) var<uniform> params : SimParams;
  #|@group(0) @binding(1) var<storage, read_write> particles : array<Particle>;
  #|var<workgroup> scratch : array<f32, 64>;
  #|
  #|@compute @workgroup_size(64, 1, 1)
  #|fn step_particles(
  #| @builtin(global_invocation_id) gid : vec3u,
  #| @builtin(local_invocation_index) lidx : u32,
  #|) {
  #| let idx = gid.x;
  #| if idx >= params.count {
  #| return;
  #| }
  #| var p = particles[idx];
  #| p.vel.y = p.vel.y - 9.81 * params.dt;
  #| p.pos = p.pos + p.vel * params.dt;
  #| scratch[lidx] = length(p.vel.xyz);
  #| workgroupBarrier();
  #| if p.pos.y < 0.0 {
  #| p.pos.y = 0.0;
  #| p.vel.y = abs(p.vel.y) * 0.8;
  #| }
  #| particles[idx] = p;
  #|}
}

///|
pub fn smoke_digest() -> String {
  let sb = StringBuilder::new()
  let opts = wgsl::CompileOptions::default()
  match wgsl::compile_to_msl(pbr_shader(), opts) {
    Ok(m) => {
      sb.write_string("PBR_MSL_LEN=")
      sb.write_string(m.source.length().to_string())
      sb.write_string("\n")
      sb.write_string(m.source)
    }
    Err(e) => {
      sb.write_string("ERR_PBR_MSL=")
      sb.write_string(e.to_string())
      sb.write_string("\n")
    }
  }
  match wgsl::compile_to_glsl(pbr_shader(), wgsl::CompileOptions::with_entry_point("vs_main")) {
    Ok(g) => {
      sb.write_string("PBR_GLSL_VS_LEN=")
      sb.write_string(g.source.length().to_string())
      sb.write_string("\n")
      sb.write_string(g.source)
    }
    Err(e) => {
      sb.write_string("ERR_PBR_GLSL_VS=")
      sb.write_string(e.to_string())
      sb.write_string("\n")
    }
  }
  match wgsl::compile_to_glsl(pbr_shader(), wgsl::CompileOptions::with_entry_point("fs_main")) {
    Ok(g) => {
      sb.write_string("PBR_GLSL_FS_LEN=")
      sb.write_string(g.source.length().to_string())
      sb.write_string("\n")
      sb.write_string(g.source)
    }
    Err(e) => {
      sb.write_string("ERR_PBR_GLSL_FS=")
      sb.write_string(e.to_string())
      sb.write_string("\n")
    }
  }
  match wgsl::compile_to_msl(particle_shader(), opts) {
    Ok(m) => {
      sb.write_string("PARTICLE_MSL_LEN=")
      sb.write_string(m.source.length().to_string())
      sb.write_string("\n")
      sb.write_string(m.source)
    }
    Err(e) => {
      sb.write_string("ERR_PARTICLE_MSL=")
      sb.write_string(e.to_string())
      sb.write_string("\n")
    }
  }
  match wgsl::compile_to_glsl(particle_shader(), wgsl::CompileOptions::with_entry_point("step_particles")) {
    Ok(g) => {
      sb.write_string("PARTICLE_GLSL_LEN=")
      sb.write_string(g.source.length().to_string())
      sb.write_string("\n")
      sb.write_string(g.source)
    }
    Err(e) => {
      sb.write_string("ERR_PARTICLE_GLSL=")
      sb.write_string(e.to_string())
      sb.write_string("\n")
    }
  }
  sb.to_string()
}

///|
pub fn main(world : World) -> Int {
  let out = smoke_digest()
  io_println(world, out)
  if out.length() > 100 { 0 } else { 1 }
}
