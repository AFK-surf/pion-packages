///| W3C WGSL frontend tests: lexer, parser, AST, static validator, reflection, and DoS limits.

fn test_contains(haystack : String, needle : String) -> Bool {
  let hn = haystack.length()
  let nn = needle.length()
  if nn == 0 {
    return true
  }
  if nn > hn {
    return false
  }
  let mut i = 0
  while i <= hn - nn {
    let mut j = 0
    let mut ok = true
    while j < nn {
      if haystack.code_unit_at(i + j) != needle.code_unit_at(j) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return true
    }
    i = i + 1
  }
  false
}

test "lex_nested_block_comments_and_line_comments" {
  let src =
  #|// leading line comment
  #|/* outer /* nested /* deep */ still outer */ done */
  #|const PI : f32 = 3.1415926f;
  #|const HEX : u32 = 0xdeadBEEFu;
  #|const EXP : f32 = 1.5e-5;
  #|const NEG : i32 = -42i;
  #|@compute @workgroup_size(1)
  #|fn cs() {}
  match reflect(src) {
    Ok(r) => {
      debug_assert(r.entries.length() == 1, "expected 1 entry")
      debug_assert(r.entries[0].name == "cs", "expected entry cs")
    }
    Err(e) => debug_assert(false, "unexpected err: " + e.to_string())
  }
}

test "lex_unterminated_nested_block_comment_error_with_line_col" {
  let src = "/* outer /* inner */\n@compute @workgroup_size(1) fn cs() {}"
  match reflect(src) {
    Ok(_) => debug_assert(false, "expected lex error")
    Err(e) => {
      debug_assert(e.line == 1, "expected line 1, got " + e.line.to_string())
      debug_assert(e.col == 1, "expected col 1, got " + e.col.to_string())
      debug_assert(test_contains(e.to_string(), "lex error"), "expected lex error message: " + e.to_string())
    }
  }
}

test "lex_empty_source_and_whitespace_only" {
  match reflect("") {
    Ok(_) => debug_assert(false, "expected EmptySource")
    Err(e) => {
      let ok = match e.kind {
        WgslErrorKind::EmptySource => true
        _ => false
      }
      debug_assert(ok, "expected EmptySource, got " + e.to_string())
    }
  }
  match reflect("   \n\t /* comment */ \n") {
    Ok(_) => debug_assert(false, "expected EmptySource for comment-only")
    Err(e) => {
      let ok = match e.kind {
        WgslErrorKind::EmptySource => true
        _ => false
      }
      debug_assert(ok, "expected EmptySource, got " + e.to_string())
    }
  }
}

test "parse_full_type_system_and_attributes" {
  let src =
  #|enable f16;
  #|alias Color4 = vec4f;
  #|alias Mat4 = mat4x4f;
  #|
  #|@id(0) override SCALE : f32 = 1.0;
  #|@id(1) override ENABLED : bool = true;
  #|
  #|struct Material {
    #| @align(16) @size(64) mvp : Mat4,
    #| base_color : Color4,
    #| weights : array<f32, 4>,
    #| counter : atomic<u32>,
    #|}
  #|
  #|struct VsOut {
    #| @builtin(position) pos : vec4<f32>,
    #| @location(0) @interpolate(flat) id : u32,
    #| @location(1) @interpolate(perspective, centroid) uv : vec2f,
    #|}
  #|
  #|@group(0) @binding(0) var<uniform> mat : Material;
  #|@group(0) @binding(1) var<storage, read_write> buf : array<vec4f>;
  #|@group(0) @binding(2) var tex2d : texture_2d<f32>;
  #|@group(0) @binding(3) var samp : sampler;
  #|@group(0) @binding(4) var depth_tex : texture_depth_2d;
  #|@group(0) @binding(5) var comp_samp : sampler_comparison;
  #|@group(1) @binding(0) var stor_tex : texture_storage_2d<rgba8unorm, write>;
  #|@group(1) @binding(1) var tex_cube : texture_cube<f32>;
  #|@group(1) @binding(2) var tex_3d : texture_3d<f32>;
  #|@group(1) @binding(3) var tex_arr : texture_2d_array<f32>;
  #|@group(1) @binding(4) var tex_1d : texture_1d<f32>;
  #|var<private> g_tmp : f32 = 0.0;
  #|var<workgroup> wg_shared : array<f32, 64>;
  #|
  #|fn helper(p : ptr<function, f32>) -> f32 {
    #| *p += 1.0;
    #| return *p;
    #|}
  #|
  #|@compute @workgroup_size(8, 8, 1)
  #|fn cs_main(
    #| @builtin(global_invocation_id) gid : vec3u,
    #| @builtin(local_invocation_id) lid : vec3u,
    #| @builtin(local_invocation_index) lidx : u32,
    #| @builtin(workgroup_id) wid : vec3u,
    #| @builtin(num_workgroups) nwg : vec3u,
    #|) {
    #| var acc : f32 = 0.0;
    #| acc = helper(&acc);
    #| wg_shared[lidx] = acc;
    #| workgroupBarrier();
    #| storageBarrier();
    #| let len = arrayLength(&buf);
    #| if gid.x < len {
      #| buf[gid.x] = vec4f(acc * SCALE, 0.0, 0.0, 1.0);
      #| }
    #|}
  match reflect(src) {
    Ok(r) => {
      debug_assert(r.entries.length() == 1, "expected 1 entry")
      debug_assert(r.entries[0].name == "cs_main", "expected cs_main")
      debug_assert(r.entries[0].workgroup_size_x == 8, "wgx=8")
      debug_assert(r.entries[0].workgroup_size_y == 8, "wgy=8")
      debug_assert(r.entries[0].workgroup_size_z == 1, "wgz=1")
      debug_assert(r.entries[0].inputs.length() == 5, "5 inputs")
      debug_assert(r.bindings.length() == 11, "11 bindings")
      debug_assert(r.structs.length() == 2, "2 structs")
      debug_assert(r.aliases.length() == 2, "2 aliases")
      debug_assert(r.overrides.length() == 2, "2 overrides")
      debug_assert(r.overrides[0].id == 0, "override 0 id")
      debug_assert(r.overrides[1].id == 1, "override 1 id")
      debug_assert(r.bindings[6].group == 1, "group 1")
      debug_assert(r.bindings[6].binding == 0, "binding 0")
      debug_assert(r.bindings[6].msl_slot == 8, "msl_slot 8")
    }
    Err(e) => debug_assert(false, "unexpected err: " + e.to_string())
  }
}

test "parse_control_flow_switch_loop_continuing_for_while" {
  let src =
  #|@fragment
  #|fn fs_main(@location(0) mode : u32) -> @location(0) vec4f {
    #| var out = vec4f(0.0);
    #| switch mode {
      #| case 0u, 1u: {
        #| out = vec4f(1.0, 0.0, 0.0, 1.0);
        #| }
      #| case 2u {
        #| out = vec4f(0.0, 1.0, 0.0, 1.0);
        #| }
      #| default: {
        #| out = vec4f(0.0, 0.0, 1.0, 1.0);
        #| }
      #| }
    #| var i : u32 = 0u;
    #| loop {
      #| if i >= 4u { break; }
      #| out.x += 0.1;
      #| continuing {
        #| i++;
        #| break if i == 4u;
        #| }
      #| }
    #| for (var k : i32 = 0; k < 3; k++) {
      #| if k == 1 { continue; }
      #| out.y += 0.1;
      #| }
    #| while i > 0u {
      #| i--;
      #| }
    #| if out.x < 0.0 {
      #| discard;
      #| }
    #| return out;
    #|}
  match reflect(src) {
    Ok(r) => {
      debug_assert(r.entries.length() == 1, "expected 1 entry")
      debug_assert(r.entries[0].name == "fs_main", "expected fs_main")
    }
    Err(e) => debug_assert(false, "unexpected err: " + e.to_string())
  }
}

test "validate_rejects_duplicate_entry_and_duplicate_binding" {
  let dup_fn =
  #|@vertex fn main() -> @builtin(position) vec4f { return vec4f(0.0); }
  #|@fragment fn main() -> @location(0) vec4f { return vec4f(1.0); }
  match reflect(dup_fn) {
    Ok(_) => debug_assert(false, "expected duplicate function error")
    Err(e) => debug_assert(test_contains(e.message, "duplicate"), "expected duplicate msg: " + e.message)
  }

  let dup_bind =
  #|@group(0) @binding(1) var<uniform> a : vec4f;
  #|@group(0) @binding(1) var<uniform> b : vec4f;
  #|@compute @workgroup_size(1) fn cs() {}
  match reflect(dup_bind) {
    Ok(_) => debug_assert(false, "expected duplicate binding error")
    Err(e) => debug_assert(test_contains(e.message, "duplicate"), "expected duplicate msg: " + e.message)
  }
}

test "validate_rejects_bad_workgroup_size_and_missing_workgroup_size" {
  let zero_wg = "@compute @workgroup_size(0) fn cs() {}"
  match reflect(zero_wg) {
    Ok(_) => debug_assert(false, "expected workgroup_size error")
    Err(e) => debug_assert(test_contains(e.message, "workgroup_size"), "msg: " + e.message)
  }

  let missing_wg = "@compute fn cs() {}"
  match reflect(missing_wg) {
    Ok(_) => debug_assert(false, "expected missing workgroup_size error")
    Err(e) => debug_assert(test_contains(e.message, "workgroup_size"), "msg: " + e.message)
  }
}

test "validate_rejects_undeclared_struct_and_duplicate_struct" {
  let undeclared =
  #|struct A { x : MissingType }
  #|@compute @workgroup_size(1) fn cs() {}
  match reflect(undeclared) {
    Ok(_) => debug_assert(false, "expected undeclared type error")
    Err(e) => debug_assert(test_contains(e.message, "MissingType"), "msg: " + e.message)
  }

  let dup_struct =
  #|struct S { a : f32 }
  #|struct S { b : f32 }
  #|@compute @workgroup_size(1) fn cs() {}
  match reflect(dup_struct) {
    Ok(_) => debug_assert(false, "expected duplicate struct error")
    Err(e) => debug_assert(test_contains(e.message, "duplicate struct"), "msg: " + e.message)
  }
}

test "validate_rejects_reserved_keyword_and_break_continue_outside_loop" {
  let reserved = "struct class { x : f32 }"
  match reflect(reserved) {
    Ok(_) => debug_assert(false, "expected reserved keyword error")
    Err(e) => debug_assert(test_contains(e.message, "reserved"), "msg: " + e.message)
  }

  let bad_break = "@compute @workgroup_size(1) fn cs() { break; }"
  match reflect(bad_break) {
    Ok(_) => debug_assert(false, "expected break outside loop error")
    Err(e) => debug_assert(test_contains(e.message, "break"), "msg: " + e.message)
  }

  let bad_continue = "@compute @workgroup_size(1) fn cs() { continue; }"
  match reflect(bad_continue) {
    Ok(_) => debug_assert(false, "expected continue outside loop error")
    Err(e) => debug_assert(test_contains(e.message, "continue"), "msg: " + e.message)
  }

  let continue_in_switch =
  #|@compute @workgroup_size(1) fn cs() {
    #| var x : u32 = 0u;
    #| switch x {
      #| default: { continue; }
      #| }
    #|}
  match reflect(continue_in_switch) {
    Ok(_) => debug_assert(false, "expected continue in switch error")
    Err(e) => debug_assert(test_contains(e.message, "continue"), "msg: " + e.message)
  }
}

test "dos_limits_reject_oversized_source_tokens_and_deep_nesting" {
  let small_lim = ParseLimits::new(32, 250000, 64)
  let src = "@compute @workgroup_size(1) fn cs_very_long_name() { var x = 1.0; }"
  match validate(src, small_lim) {
    Ok(_) => debug_assert(false, "expected LimitExceeded for source bytes")
    Err(e) => {
      let ok = match e.kind {
        WgslErrorKind::LimitExceeded => true
        _ => false
      }
      debug_assert(ok, "expected LimitExceeded, got " + e.to_string())
    }
  }

  let tok_lim = ParseLimits::new(2097152, 5, 64)
  match validate(src, tok_lim) {
    Ok(_) => debug_assert(false, "expected LimitExceeded for tokens")
    Err(e) => {
      let ok = match e.kind {
        WgslErrorKind::LimitExceeded => true
        _ => false
      }
      debug_assert(ok, "expected LimitExceeded, got " + e.to_string())
    }
  }

  let sb = StringBuilder::new()
  sb.write_string("@compute @workgroup_size(1) fn cs() { var x = ")
  let mut i = 0
  while i < 80 {
    sb.write_string("(")
    i = i + 1
  }
  sb.write_string("1")
  i = 0
  while i < 80 {
    sb.write_string(")")
    i = i + 1
  }
  sb.write_string("; }")
  let depth_lim = ParseLimits::new(2097152, 250000, 32)
  match validate(sb.to_string(), depth_lim) {
    Ok(_) => debug_assert(false, "expected LimitExceeded for nesting depth")
    Err(e) => {
      let ok = match e.kind {
        WgslErrorKind::LimitExceeded => true
        _ => false
      }
      debug_assert(ok, "expected LimitExceeded, got " + e.to_string())
    }
  }
}
