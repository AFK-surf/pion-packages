///| WebAssembly 1.0/2.0 specification validation & adversarial tests,
///| cross-verified against Node v24 V8 `WebAssembly.validate`.

fn assert_valid_hex(name : String, hex : String) -> Unit {
  match validate_bytes(hex_to_bytes(hex)) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "expected VALID (" + name + "), got: " + wasm_error_message(e))
  }
}

fn assert_invalid_hex(name : String, hex : String) -> Unit {
  match validate_bytes(hex_to_bytes(hex)) {
    Ok(_) => debug_assert(false, "expected INVALID (" + name + "), but validated OK")
    Err(_) => ()
  }
}

test "validate_node_v8_cross_verified_valid_vectors" {
  // Every vector below was verified to return `true` in Node v24 WebAssembly.validate
  assert_valid_hex("empty", "0061736d01000000")
  assert_valid_hex(
    "add",
    "0061736d0100000001070160027f7f017f030201000707010361646400000a09010700200020016a0b",
  )
  assert_valid_hex(
    "poly_unreachable_ok",
    "0061736d010000000105016000017e030201000a06010400007c0b",
  )
  assert_valid_hex(
    "br_table_valid",
    "0061736d010000000105016000017f030201000a12011000027f027f412a41000e0100010b0b0b",
  )
  assert_valid_hex(
    "good_align",
    "0061736d010000000105016000017f0302010005030100010a0901070041002802000b",
  )
  assert_valid_hex(
    "mut_global_set",
    "0061736d01000000010401600000030201000606017f0141010b0a08010600410224000b",
  )
  assert_valid_hex("non_minimal_leb", "0061736d0100000001840001600000")
  assert_valid_hex(
    "simd_valid",
    "0061736d010000000105016000017f030201000a2e012c00fd0c01000000020000000300000004000000fd0c05000000060000000700000008000000fdae01fd1b000b",
  )
  assert_valid_hex(
    "multi_value",
    "0061736d0100000001080160027f7e027e7f030201000a08010600200120000b",
  )
  assert_valid_hex(
    "ref_types",
    "0061736d010000000105016000017f030201000a07010500d070d10b",
  )
  assert_valid_hex(
    "signext_truncsat",
    "0061736d0100000001060160017d017f030201000a090107002000fc00c00b",
  )
  assert_valid_hex(
    "bulk_memory",
    "0061736d010000000104016000000302010005030100010c01010a24012200410041004104fc080000fc0900410041004104fc0a00004100412a4104fc0b000b0b0701010461626364",
  )
}

test "validate_node_v8_cross_verified_invalid_vectors" {
  // Every vector below was verified to return `false` in Node v24 WebAssembly.validate
  assert_invalid_hex("bad_magic", "0061736e01000000")
  assert_invalid_hex("bad_version", "0061736d02000000")
  assert_invalid_hex(
    "poly_unreachable_result_mismatch",
    "0061736d010000000105016000017f030201000a06010400007c0b",
  )
  assert_invalid_hex(
    "poly_unreachable_op_mismatch",
    "0061736d010000000105016000017f030201000a080106000041017c0b",
  )
  assert_invalid_hex(
    "if_else_mismatch",
    "0061736d0100000001060160017f017f030201000a0e010c002000047f41010542020b0b",
  )
  assert_invalid_hex(
    "if_no_else_result",
    "0061736d0100000001060160017f017f030201000a0b0109002000047f41010b0b",
  )
  assert_invalid_hex(
    "br_table_mismatch",
    "0061736d010000000105016000017e030201000a15011300027e027f412a41000e0100010b1a42000b0b",
  )
  assert_invalid_hex(
    "bad_align",
    "0061736d010000000105016000017f0302010005030100010a0901070041002803000b",
  )
  assert_invalid_hex(
    "immut_global_set",
    "0061736d01000000010401600000030201000606017f0041010b0a08010600410224000b",
  )
  assert_invalid_hex("out_of_order", "0061736d0100000003020100010401600000")
  assert_invalid_hex("dup_section", "0061736d01000000010401600000010401600000")
  assert_invalid_hex("overlong_leb", "0061736d010000000184808080800001600000")
  assert_invalid_hex(
    "bulk_memory_no_datacount",
    "0061736d010000000104016000000302010005030100010a0e010c00410041004104fc0800000b0b0701010461626364",
  )
  assert_invalid_hex("oob_local", "0061736d010000000105016000017f030201000a0601040020000b")
  assert_invalid_hex("oob_global", "0061736d010000000105016000017f030201000a0601040023000b")
  assert_invalid_hex("oob_func", "0061736d01000000010401600000030201000a0601040010050b")
  assert_invalid_hex("oob_type", "0061736d01000000010401600000030201010a040102000b")
  assert_invalid_hex("oob_label", "0061736d01000000010401600000030201000a060104000c010b")
  assert_invalid_hex(
    "stack_height_extra",
    "0061736d010000000105016000017f030201000a08010600410141020b",
  )
  assert_invalid_hex(
    "dup_export",
    "0061736d010000000104016000000302010007090201610000016100000a040102000b",
  )
  assert_invalid_hex(
    "bad_start_sig",
    "0061736d010000000105016000017f030201000801000a0601040041000b",
  )
  // Invalid const expr: nop in global init
  assert_invalid_hex("bad_const_expr_nop", "0061736d010000000607017f000141010b")
  // Memory pages > 65536 (min = 65536, max = 81920)
  assert_invalid_hex("mem_limit_exceeded", "0061736d0100000005070101808004808005")
  // Memory min > max (min = 5, max = 3)
  assert_invalid_hex("mem_min_gt_max", "0061736d01000000050401010503")
}

test "validate_complex_control_flow_and_polymorphism" {
  // Complex realistic module: recursive fib + loop memory sum + call_indirect
  let b = ModuleBuilder::new()
  let t_i32_to_i32 = b.add_type([ValType::I32], [ValType::I32])
  let t_i32_i32_to_i32 = b.add_type([ValType::I32, ValType::I32], [ValType::I32])
  let _ = b.add_memory(MemType::{ limits: Limits::new(1L, Some(4L)) })
  let _ = b.add_table(TableType::{
    elem_type: RefType::FuncRef,
    limits: Limits::new(2L, Some(2L)),
  })

  // Func 0: fib(n)
  let f_fib = b.add_func(
    t_i32_to_i32,
    [],
    [
      Instr::LocalGet(0),
      Instr::I32Const(2),
      Instr::I32LtS,
      Instr::If(BlockType::Value(ValType::I32)),
      Instr::LocalGet(0),
      Instr::Else,
      Instr::LocalGet(0),
      Instr::I32Const(1),
      Instr::I32Sub,
      Instr::Call(0),
      Instr::LocalGet(0),
      Instr::I32Const(2),
      Instr::I32Sub,
      Instr::Call(0),
      Instr::I32Add,
      Instr::End,
      Instr::End,
    ],
  )

  // Func 1: sum_mem(ptr, count) -> i32 using block+loop+br_if+br
  let f_sum = b.add_func(
    t_i32_i32_to_i32,
    [LocalGroup::{ count: 2, val_type: ValType::I32 }],
    [
      Instr::Block(BlockType::Empty),
      Instr::Loop(BlockType::Empty),
      Instr::LocalGet(2), // i
      Instr::LocalGet(1), // count
      Instr::I32GeU,
      Instr::BrIf(1), // break block
      Instr::LocalGet(3), // acc
      Instr::LocalGet(0), // ptr
      Instr::LocalGet(2),
      Instr::I32Const(2),
      Instr::I32Shl,
      Instr::I32Add,
      Instr::I32Load(MemArg::new(2, 0L)),
      Instr::I32Add,
      Instr::LocalSet(3),
      Instr::LocalGet(2),
      Instr::I32Const(1),
      Instr::I32Add,
      Instr::LocalSet(2),
      Instr::Br(0), // continue loop
      Instr::End,
      Instr::End,
      Instr::LocalGet(3),
      Instr::End,
    ],
  )

  // Func 2: dispatch(idx, x) -> call_indirect
  let f_disp = b.add_func(
    t_i32_i32_to_i32,
    [],
    [
      Instr::LocalGet(1),
      Instr::LocalGet(0),
      Instr::CallIndirect(t_i32_to_i32, 0),
      Instr::End,
    ],
  )

  b.add_export("fib", ExportKind::Func, f_fib)
  b.add_export("sum_mem", ExportKind::Func, f_sum)
  b.add_export("dispatch", ExportKind::Func, f_disp)
  let _ = b.add_element(ElemSegment::{
    mode: ElemMode::Active(0, [Instr::I32Const(0), Instr::End]),
    elem_type: RefType::FuncRef,
    items: ElemItems::FuncIndices([f_fib]),
    flags: 0,
  })

  let raw = match b.encode() {
    Ok(bs) => bs
    Err(e) => {
      debug_assert(false, wasm_error_message(e))
      Bytes::new(0)
    }
  }
  match validate_bytes(raw) {
    Ok(_) => ()
    Err(e) => debug_assert(false, wasm_error_message(e))
  }
}

test "validate_limits_dos_bombs" {
  // 1. Control depth bomb: 200 nested blocks with max_control_depth = 32
  let body : Array[Instr] = []
  let mut i = 0
  while i < 200 {
    body.push(Instr::Block(BlockType::Empty))
    i = i + 1
  }
  i = 0
  while i < 200 {
    body.push(Instr::End)
    i = i + 1
  }
  body.push(Instr::End)

  let b = ModuleBuilder::new()
  let t0 = b.add_type([], [])
  let _ = b.add_func(t0, [], body)
  let m = b.build()

  let strict_limits = ValidateLimits::{
    max_types: 100,
    max_functions: 100,
    max_tables: 10,
    max_memories: 1,
    max_globals: 100,
    max_exports: 100,
    max_elements: 100,
    max_data_segments: 100,
    max_locals_per_func: 100,
    max_control_depth: 32,
    max_stack_height: 1024,
    max_memory_pages: 65536L,
    allow_multi_memory: false,
  }
  match validate_module_with_limits(m, strict_limits) {
    Ok(_) => debug_assert(false, "control depth 200 > 32 must be rejected")
    Err(WasmError::LimitExceeded(_)) => ()
    Err(e) => debug_assert(false, "expected LimitExceeded, got: " + wasm_error_message(e))
  }

  // 2. Locals count overflow bomb (1,000,000 locals)
  let b2 = ModuleBuilder::new()
  let t2 = b2.add_type([], [])
  let _ = b2.add_func(
    t2,
    [LocalGroup::{ count: 1000000, val_type: ValType::I32 }],
    [Instr::End],
  )
  match validate_module_with_limits(b2.build(), strict_limits) {
    Ok(_) => debug_assert(false, "1M locals > 100 must be rejected")
    Err(WasmError::LimitExceeded(_)) => ()
    Err(e) => debug_assert(false, "expected LimitExceeded, got: " + wasm_error_message(e))
  }
}
