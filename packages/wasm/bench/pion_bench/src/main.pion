///| Head-to-head benchmark for `packages/wasm` (Pion Native):
///|   1. decode <file.wasm> <rounds>        : Full binary decode + instruction traversal
///|   2. validate <file.wasm> <rounds>      : Full WebAssembly 1.0/2.0 spec validation
///|   3. roundtrip_wat <file.wasm> <rounds> : Decode -> Re-encode -> WAT disassembly

import "wasm"

fn parse_pos_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  if acc <= 0 {
    1
  } else {
    acc
  }
}

fn run_decode(world : World, raw : Bytes, rounds : Int) -> Int {
  let mut types : Int64 = 0L
  let mut imports : Int64 = 0L
  let mut funcs : Int64 = 0L
  let mut globals : Int64 = 0L
  let mut exports : Int64 = 0L
  let mut data_segs : Int64 = 0L
  let mut total_locals : Int64 = 0L
  let mut total_instrs : Int64 = 0L

  let mut r = 0
  while r < rounds {
    let m = match wasm::decode_module(raw) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "decode failed: " + wasm::wasm_error_message(e))
        return 2
      }
    }
    types = types + m.types.length().to_int64()
    imports = imports + m.imports.length().to_int64()
    funcs = funcs + m.codes.length().to_int64()
    globals = globals + m.globals.length().to_int64()
    exports = exports + m.exports.length().to_int64()
    data_segs = data_segs + m.data.length().to_int64()
    let mut fi = 0
    while fi < m.codes.length() {
      let fb = m.codes[fi]
      let mut li = 0
      while li < fb.locals.length() {
        total_locals = total_locals + fb.locals[li].count.to_int64()
        li = li + 1
      }
      total_instrs = total_instrs + fb.body.length().to_int64()
      fi = fi + 1
    }
    r = r + 1
  }

  io_println(world, "mode=decode")
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "types=" + types.to_string())
  io_println(world, "imports=" + imports.to_string())
  io_println(world, "funcs=" + funcs.to_string())
  io_println(world, "globals=" + globals.to_string())
  io_println(world, "exports=" + exports.to_string())
  io_println(world, "data_segs=" + data_segs.to_string())
  io_println(world, "total_locals=" + total_locals.to_string())
  io_println(world, "total_instrs=" + total_instrs.to_string())
  0
}

fn run_validate(world : World, raw : Bytes, rounds : Int) -> Int {
  let mut valid_count = 0
  let mut r = 0
  while r < rounds {
    match wasm::validate_bytes(raw) {
      Ok(_) => valid_count = valid_count + 1
      Err(e) => {
        io_println(world, "validate failed: " + wasm::wasm_error_message(e))
        return 2
      }
    }
    r = r + 1
  }
  io_println(world, "mode=validate")
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "bytes=" + raw.length().to_string())
  io_println(world, "valid_count=" + valid_count.to_string())
  0
}

fn run_roundtrip_wat(world : World, raw : Bytes, rounds : Int) -> Int {
  let mut reencoded_ok = 0
  let mut wat_ok = 0
  let mut r = 0
  while r < rounds {
    let m = match wasm::decode_module(raw) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "decode failed: " + wasm::wasm_error_message(e))
        return 2
      }
    }
    let reenc = match wasm::encode_module(m) {
      Ok(bs) => bs
      Err(e) => {
        io_println(world, "encode failed: " + wasm::wasm_error_message(e))
        return 3
      }
    }
    if reenc.length() >= 8 && reenc[0].to_int() == 0 && reenc[1].to_int() == 97 {
      reencoded_ok = reencoded_ok + 1
    }
    let wat = wasm::print_wat(m)
    if wat.length() > 7 && wat.code_unit_at(0) == 40 && wat.code_unit_at(1) == 109 {
      wat_ok = wat_ok + 1
    }
    r = r + 1
  }
  io_println(world, "mode=roundtrip_wat")
  io_println(world, "rounds=" + rounds.to_string())
  io_println(world, "orig_bytes=" + raw.length().to_string())
  io_println(world, "reencoded_ok=" + reencoded_ok.to_string())
  io_println(world, "wat_ok=" + wat_ok.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 4 {
    io_println(world, "usage: wasm_bench_pion <decode|validate|roundtrip_wat> <file.wasm> <rounds>")
    return 1
  }
  let mode = args[1]
  let path = args[2]
  let rounds = parse_pos_int(args[3])
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "failed to read wasm corpus: " + path)
      return 1
    }
  }
  if mode == "decode" {
    run_decode(world, raw, rounds)
  } else if mode == "validate" {
    run_validate(world, raw, rounds)
  } else if mode == "roundtrip_wat" {
    run_roundtrip_wat(world, raw, rounds)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
