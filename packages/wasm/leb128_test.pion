///| Compliance and adversarial tests for WebAssembly LEB128 (u32, u64, i32, i64, s33).

fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    debug_assert(false, "invalid hex char")
    0
  }
}

fn hex_to_bytes(hex : String) -> Bytes {
  let n = hex.length()
  debug_assert(n % 2 == 0, "hex length must be even")
  let out = Bytes::new(n / 2)
  let mut i = 0
  while i < n / 2 {
    let hi = hex_nibble(hex.code_unit_at(i * 2))
    let lo = hex_nibble(hex.code_unit_at(i * 2 + 1))
    out[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  out
}

fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

test "leb128_u32_roundtrip_and_vectors" {
  let vals : Array[Int64] = [
    0L,
    1L,
    127L,
    128L,
    16383L,
    16384L,
    624485L,
    2147483647L,
    4294967295L,
  ]
  let mut i = 0
  while i < vals.length() {
    let w = ByteWriter::new()
    w.write_varuint32(vals[i])
    let b = w.to_bytes()
    let r = ByteReader::new(b)
    match r.read_varuint32() {
      Ok(v) => debug_assert(v == vals[i], "u32 roundtrip mismatch")
      Err(e) => debug_assert(false, wasm_error_message(e))
    }
    debug_assert(r.is_eof(), "u32 should consume all bytes")
    i = i + 1
  }

  // Canonical encoding of 624485 = 0xE5 0x8E 0x26
  let w = ByteWriter::new()
  w.write_varuint32(624485L)
  debug_assert(bytes_eq(w.to_bytes(), hex_to_bytes("e58e26")), "624485 canonical u32")

  // Non-minimal 5-byte encoding of 0 is valid in WebAssembly
  let r_nm = ByteReader::new(hex_to_bytes("8080808000"))
  match r_nm.read_varuint32() {
    Ok(v) => debug_assert(v == 0L, "non-minimal 5-byte 0 should decode to 0")
    Err(e) => debug_assert(false, wasm_error_message(e))
  }
}

test "leb128_u32_reject_overlong_and_overflow" {
  // 6-byte overlong u32
  let r1 = ByteReader::new(hex_to_bytes("808080808000"))
  match r1.read_varuint32() {
    Ok(_) => debug_assert(false, "6-byte u32 must fail")
    Err(_) => ()
  }
  // 5th byte has unused high bits set (0x10)
  let r2 = ByteReader::new(hex_to_bytes("8080808010"))
  match r2.read_varuint32() {
    Ok(_) => debug_assert(false, "5th byte >= 0x10 must fail for u32")
    Err(_) => ()
  }
  // Truncated EOF
  let r3 = ByteReader::new(hex_to_bytes("8080"))
  match r3.read_varuint32() {
    Ok(_) => debug_assert(false, "truncated u32 must fail")
    Err(_) => ()
  }
}

test "leb128_u64_roundtrip_and_reject_invalid" {
  let vals : Array[UInt64] = [
    0UL,
    1UL,
    127UL,
    128UL,
    4294967295UL,
    9223372036854775807UL,
    18446744073709551615UL,
  ]
  let mut i = 0
  while i < vals.length() {
    let w = ByteWriter::new()
    w.write_varuint64(vals[i])
    let r = ByteReader::new(w.to_bytes())
    match r.read_varuint64() {
      Ok(v) => debug_assert(v == vals[i], "u64 roundtrip mismatch")
      Err(e) => debug_assert(false, wasm_error_message(e))
    }
    debug_assert(r.is_eof(), "u64 eof")
    i = i + 1
  }
  // 10th byte = 0x02 overflows u64
  let r_ovf = ByteReader::new(hex_to_bytes("80808080808080808002"))
  match r_ovf.read_varuint64() {
    Ok(_) => debug_assert(false, "u64 10th byte 0x02 must fail")
    Err(_) => ()
  }
  // 11-byte overlong u64
  let r_long = ByteReader::new(hex_to_bytes("8080808080808080808000"))
  match r_long.read_varuint64() {
    Ok(_) => debug_assert(false, "11-byte u64 must fail")
    Err(_) => ()
  }
}

test "leb128_i32_roundtrip_and_reject_invalid" {
  let vals : Array[Int] = [
    0,
    1,
    -1,
    63,
    -64,
    64,
    -65,
    -123456,
    2147483647,
    -2147483647 - 1,
  ]
  let mut i = 0
  while i < vals.length() {
    let w = ByteWriter::new()
    w.write_varint32(vals[i])
    let r = ByteReader::new(w.to_bytes())
    match r.read_varint32() {
      Ok(v) => debug_assert(v == vals[i], "i32 roundtrip mismatch")
      Err(e) => debug_assert(false, wasm_error_message(e))
    }
    debug_assert(r.is_eof(), "i32 eof")
    i = i + 1
  }
  // Canonical -123456 = 0xC0 0xBB 0x78
  let w = ByteWriter::new()
  w.write_varint32(-123456)
  debug_assert(bytes_eq(w.to_bytes(), hex_to_bytes("c0bb78")), "-123456 canonical i32")

  // 5th byte bad sign-extension bits for positive (bit 3=0, bit 4=1 -> 0x10)
  let r_bad1 = ByteReader::new(hex_to_bytes("8080808010"))
  match r_bad1.read_varint32() {
    Ok(_) => debug_assert(false, "i32 bad positive sign ext must fail")
    Err(_) => ()
  }
  // 5th byte bad sign-extension bits for negative (bit 3=1, bits 4..6=0 -> 0x08)
  let r_bad2 = ByteReader::new(hex_to_bytes("8080808008"))
  match r_bad2.read_varint32() {
    Ok(_) => debug_assert(false, "i32 bad negative sign ext must fail")
    Err(_) => ()
  }
  // Valid negative 5-byte -1 = ff ff ff ff 7f
  let r_ok = ByteReader::new(hex_to_bytes("ffffffff7f"))
  match r_ok.read_varint32() {
    Ok(v) => debug_assert(v == -1, "5-byte -1")
    Err(e) => debug_assert(false, wasm_error_message(e))
  }
}

test "leb128_i64_and_s33_roundtrip_and_reject_invalid" {
  let i64_vals : Array[Int64] = [
    0L,
    1L,
    -1L,
    63L,
    -64L,
    2147483647L,
    -2147483648L,
    9223372036854775807L,
    -9223372036854775807L - 1L,
  ]
  let mut i = 0
  while i < i64_vals.length() {
    let w = ByteWriter::new()
    w.write_varint64(i64_vals[i])
    let r = ByteReader::new(w.to_bytes())
    match r.read_varint64() {
      Ok(v) => debug_assert(v == i64_vals[i], "i64 roundtrip mismatch")
      Err(e) => debug_assert(false, wasm_error_message(e))
    }
    debug_assert(r.is_eof(), "i64 eof")
    i = i + 1
  }
  // 10th byte bad sign bits for i64 (0x02)
  let r_bad64 = ByteReader::new(hex_to_bytes("80808080808080808002"))
  match r_bad64.read_varint64() {
    Ok(_) => debug_assert(false, "i64 bad 10th byte must fail")
    Err(_) => ()
  }

  // s33 blocktype values: -64 (0x40 empty), -1 (0x7F i32), 0, 1, 4294967295L
  let s33_vals : Array[Int64] = [-64L, -1L, 0L, 1L, 128L, 4294967295L]
  let mut j = 0
  while j < s33_vals.length() {
    let w = ByteWriter::new()
    w.write_varint33(s33_vals[j])
    let r = ByteReader::new(w.to_bytes())
    match r.read_varint33() {
      Ok(v) => debug_assert(v == s33_vals[j], "s33 roundtrip mismatch")
      Err(e) => debug_assert(false, wasm_error_message(e))
    }
    debug_assert(r.is_eof(), "s33 eof")
    j = j + 1
  }
  // s33 5th byte overflow (0x20: bit 4=0, bit 5=1)
  let r_bads33 = ByteReader::new(hex_to_bytes("8080808020"))
  match r_bads33.read_varint33() {
    Ok(_) => debug_assert(false, "s33 bad 5th byte must fail")
    Err(_) => ()
  }
}
