///| Red-team differential harness for `packages/wasm`.
///|   harness check <dir> <start> <end>
///|     For each `<dir>/<i>.wasm` (start <= i < end) prints one line:
///|       `<i>\t<OK|ERR:<msg>>\t<RE:OK|RE:ERR|RE:NA>\t<WAT:OK|WAT:NA>`
///|     and writes `<dir>/<i>.pion.re.wasm` (decode -> encode) and
///|     `<dir>/<i>.pion.wat` (print_wat) whenever the module decodes.
///|   harness time <file.wasm> <rounds> <validate|decode|roundtrip_wat|encode_only|wat_only>
///|     Prints elapsed milliseconds for `rounds` iterations (DoS probes).
///|   harness time <file.wasm> <rounds> <encode_only|wat_only>
///|     Decodes once, then times only `encode_module` / only `print_wat` (W3 phase split).

import "wasm"

fn parse_int(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    }
    i = i + 1
  }
  acc
}

fn one_line(s : String) -> String {
  let bs = s.to_bytes()
  let n = if bs.length() > 160 { 160 } else { bs.length() }
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = bs[i].to_int()
    out[i] = if c == 10 || c == 9 || c == 13 || c >= 128 { (32).to_byte() } else { bs[i] }
    i = i + 1
  }
  out.to_string()
}

fn fnv1a(bs : Bytes) -> String {
  let mut h : Int64 = 2166136261L
  let mut i = 0
  while i < bs.length() {
    h = (h ^ bs[i].to_int().to_int64()) * 16777619L
    h = h & 4294967295L
    i = i + 1
  }
  h.to_string()
}

fn run_check(world : World, dir : String, start : Int, end : Int) -> Int {
  let mut i = start
  while i < end {
    let path = dir + "/" + i.to_string() + ".wasm"
    match fs_read_bytes(world, path) {
      Err(_) => ()
      Ok(raw) => {
        let verdict = match wasm::validate_bytes(raw) {
          Ok(_) => "OK"
          Err(e) => "ERR:" + one_line(wasm::wasm_error_message(e))
        }
        let mut re = "RE:NA"
        let mut wat = "WAT:NA"
        match wasm::decode_module(raw) {
          Err(_) => ()
          Ok(m) => {
            match wasm::encode_module(m) {
              Ok(bs) => {
                let _ = fs_write_bytes(world, dir + "/" + i.to_string() + ".pion.re.wasm", bs)
                re = "RE:OK:" + fnv1a(bs)
              }
              Err(_) => re = "RE:ERR"
            }
            let text = wasm::print_wat(m)
            let tb = text.to_bytes()
            let _ = fs_write_bytes(world, dir + "/" + i.to_string() + ".pion.wat", tb)
            wat = "WAT:OK:" + fnv1a(tb)
          }
        }
        io_println(world, i.to_string() + "\t" + verdict + "\t" + re + "\t" + wat)
      }
    }
    i = i + 1
  }
  0
}

fn run_time(world : World, path : String, rounds : Int, mode : String) -> Int {
  let raw = match fs_read_bytes(world, path) {
    Ok(b) => b
    Err(_) => {
      io_println(world, "read failed: " + path)
      return 1
    }
  }
  if mode == "encode_only" || mode == "wat_only" {
    let m = match wasm::decode_module(raw) {
      Ok(v) => v
      Err(e) => {
        io_println(world, "decode failed: " + wasm::wasm_error_message(e))
        return 1
      }
    }
    let ta = clock_now_ms(world)
    let mut total = 0
    let mut k = 0
    while k < rounds {
      if mode == "encode_only" {
        match wasm::encode_module(m) {
          Ok(bs) => total = total + bs.length()
          Err(_) => ()
        }
      } else {
        total = total + wasm::print_wat(m).length()
      }
      k = k + 1
    }
    let tb = clock_now_ms(world)
    io_println(world, "mode=" + mode + " rounds=" + rounds.to_string() + " ms=" + (tb - ta).to_string() + " result=OK out_len=" + total.to_string())
    return 0
  }
  let t0 = clock_now_ms(world)
  let mut last = ""
  let mut r = 0
  while r < rounds {
    if mode == "validate" {
      last = match wasm::validate_bytes(raw) {
        Ok(_) => "OK"
        Err(e) => "ERR:" + one_line(wasm::wasm_error_message(e))
      }
    } else if mode == "decode" {
      last = match wasm::decode_module(raw) {
        Ok(_) => "OK"
        Err(e) => "ERR:" + one_line(wasm::wasm_error_message(e))
      }
    } else {
      last = match wasm::decode_module(raw) {
        Ok(m) => {
          let _ = wasm::encode_module(m)
          let w = wasm::print_wat(m)
          "OK wat_len=" + w.length().to_string()
        }
        Err(e) => "ERR:" + one_line(wasm::wasm_error_message(e))
      }
    }
    r = r + 1
  }
  let t1 = clock_now_ms(world)
  io_println(world, "mode=" + mode + " rounds=" + rounds.to_string() + " ms=" + (t1 - t0).to_string() + " result=" + last)
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() >= 5 && args[1] == "check" {
    return run_check(world, args[2], parse_int(args[3]), parse_int(args[4]))
  }
  if args.length() >= 5 && args[1] == "time" {
    return run_time(world, args[2], parse_int(args[3]), args[4])
  }
  io_println(world, "usage: harness check <dir> <start> <end> | harness time <file> <rounds> <mode>")
  2
}
