///| Complete WebAssembly 1.0/2.0 abstract stack validator.

let vt_unknown : Int = -1
let vt_i32 : Int = 0
let vt_i64 : Int = 1
let vt_f32 : Int = 2
let vt_f64 : Int = 3
let vt_v128 : Int = 4
let vt_funcref : Int = 5
let vt_externref : Int = 6

let ctrl_func : Int = 0
let ctrl_block : Int = 1
let ctrl_loop : Int = 2
let ctrl_if : Int = 3
let ctrl_else : Int = 4

fn val_type_to_id(vt : ValType) -> Int {
  match vt {
    ValType::I32 => vt_i32
    ValType::I64 => vt_i64
    ValType::F32 => vt_f32
    ValType::F64 => vt_f64
    ValType::V128 => vt_v128
    ValType::FuncRef => vt_funcref
    ValType::ExternRef => vt_externref
  }
}

fn ref_type_to_id(rt : RefType) -> Int {
  match rt {
    RefType::FuncRef => vt_funcref
    RefType::ExternRef => vt_externref
  }
}

fn val_types_to_ids(vts : Array[ValType]) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < vts.length() {
    out.push(val_type_to_id(vts[i]))
    i = i + 1
  }
  out
}

fn is_ref_id(id : Int) -> Bool {
  id == vt_funcref || id == vt_externref
}

struct CtrlFrame {
  mut opcode : Int
  start_types : Array[Int]
  end_types : Array[Int]
  height : Int
  mut unreachable : Bool
}

struct ValState {
  val_stack : Array[Int]
  mut val_len : Int
  ctrl_stack : Array[CtrlFrame]
  mut ctrl_len : Int
  limits : ValidateLimits
}

fn ValState::new(limits : ValidateLimits) -> ValState {
  ValState::{ val_stack: [], val_len: 0, ctrl_stack: [], ctrl_len: 0, limits: limits }
}

fn ValState::push_val(self : ValState, vt : Int) -> Result[Unit, WasmError] {
  if self.val_len >= self.limits.max_stack_height {
    return Err(WasmError::LimitExceeded("max_stack_height exceeded"))
  }
  if self.val_len < self.val_stack.length() {
    self.val_stack[self.val_len] = vt
  } else {
    self.val_stack.push(vt)
  }
  self.val_len = self.val_len + 1
  Ok(())
}

fn ValState::pop_val(self : ValState) -> Result[Int, WasmError] {
  if self.ctrl_len == 0 {
    return Err(WasmError::ValidationError("control stack underflow"))
  }
  let top = self.ctrl_stack[self.ctrl_len - 1]
  if self.val_len == top.height {
    if top.unreachable {
      return Ok(vt_unknown)
    }
    return Err(WasmError::ValidationError("type mismatch: operand stack underflow"))
  }
  self.val_len = self.val_len - 1
  Ok(self.val_stack[self.val_len])
}

fn ValState::pop_val_expect(self : ValState, expect : Int) -> Result[Int, WasmError] {
  let actual = match self.pop_val() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if actual != expect && actual != vt_unknown && expect != vt_unknown {
    return Err(
      WasmError::ValidationError(
        "type mismatch: expected " + expect.to_string() + ", got " + actual.to_string(),
      ),
    )
  }
  if actual == vt_unknown {
    Ok(expect)
  } else {
    Ok(actual)
  }
}

fn ValState::pop1_push1(self : ValState, p : Int, r : Int) -> Result[Unit, WasmError] {
  match self.pop_val_expect(p) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.push_val(r)
}

fn ValState::pop2_push1(self : ValState, p1 : Int, p2 : Int, r : Int) -> Result[Unit, WasmError] {
  match self.pop_val_expect(p2) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.pop_val_expect(p1) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  self.push_val(r)
}

fn ValState::pop2(self : ValState, p1 : Int, p2 : Int) -> Result[Unit, WasmError] {
  match self.pop_val_expect(p2) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.pop_val_expect(p1) {
    Ok(_) => Ok(())
    Err(e) => Err(e)
  }
}

fn ValState::pop3_i32(self : ValState) -> Result[Unit, WasmError] {
  match self.pop_val_expect(vt_i32) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.pop_val_expect(vt_i32) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  match self.pop_val_expect(vt_i32) {
    Ok(_) => Ok(())
    Err(e) => Err(e)
  }
}

fn ValState::push_vals(self : ValState, ts : Array[Int]) -> Result[Unit, WasmError] {
  let mut i = 0
  while i < ts.length() {
    match self.push_val(ts[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }
  Ok(())
}

fn ValState::pop_vals(self : ValState, ts : Array[Int]) -> Result[Unit, WasmError] {
  let mut i = ts.length() - 1
  while i >= 0 {
    match self.pop_val_expect(ts[i]) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i - 1
  }
  Ok(())
}

fn ValState::push_ctrl(
  self : ValState,
  opcode : Int,
  start_types : Array[Int],
  end_types : Array[Int],
) -> Result[Unit, WasmError] {
  if self.ctrl_len >= self.limits.max_control_depth {
    return Err(WasmError::LimitExceeded("max_control_depth exceeded"))
  }
  let frame = CtrlFrame::{
    opcode: opcode,
    start_types: start_types,
    end_types: end_types,
    height: self.val_len,
    unreachable: false,
  }
  if self.ctrl_len < self.ctrl_stack.length() {
    self.ctrl_stack[self.ctrl_len] = frame
  } else {
    self.ctrl_stack.push(frame)
  }
  self.ctrl_len = self.ctrl_len + 1
  self.push_vals(start_types)
}

fn ValState::pop_ctrl(self : ValState) -> Result[CtrlFrame, WasmError] {
  if self.ctrl_len == 0 {
    return Err(WasmError::ValidationError("control stack underflow at end"))
  }
  let frame = self.ctrl_stack[self.ctrl_len - 1]
  match self.pop_vals(frame.end_types) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if self.val_len != frame.height {
    return Err(WasmError::ValidationError("type mismatch: unexpected values remaining on stack"))
  }
  self.ctrl_len = self.ctrl_len - 1
  Ok(frame)
}

fn ValState::mark_unreachable(self : ValState) -> Unit {
  if self.ctrl_len > 0 {
    let top = self.ctrl_stack[self.ctrl_len - 1]
    self.val_len = top.height
    top.unreachable = true
  }
}

fn label_types(frame : CtrlFrame) -> Array[Int] {
  if frame.opcode == ctrl_loop {
    frame.start_types
  } else {
    frame.end_types
  }
}

struct ModuleContext {
  types : Array[FuncType]
  func_types : Array[Int]
  tables : Array[TableType]
  memories : Array[MemType]
  globals : Array[GlobalType]
  imported_globals : Int
  num_elems : Int
  num_data : Int
  has_data_count : Bool
}

fn validate_limits_obj(lim : Limits, max_allowed : Int64, is_memory : Bool) -> Result[Unit, WasmError] {
  if lim.min < 0L {
    return Err(WasmError::ValidationError("negative limit min"))
  }
  if is_memory && !lim.is_memory64 && lim.min > max_allowed {
    return Err(WasmError::ValidationError("memory min pages exceeds limit"))
  }
  match lim.max {
    Some(mx) => {
      if mx < lim.min {
        return Err(WasmError::ValidationError("limits min > max"))
      }
      if is_memory && !lim.is_memory64 && mx > max_allowed {
        return Err(WasmError::ValidationError("memory max pages exceeds limit"))
      }
    }
    None => ()
  }
  Ok(())
}

fn validate_const_expr(
  ctx : ModuleContext,
  expr : Array[Instr],
  expect_vt : Int,
  max_global_idx : Int,
) -> Result[Unit, WasmError] {
  if expr.length() == 0 {
    return Err(WasmError::ValidationError("empty const expression"))
  }
  let stack : Array[Int] = []
  let mut ended = false
  let mut i = 0
  while i < expr.length() {
    if ended {
      return Err(WasmError::ValidationError("trailing instructions after end in const expr"))
    }
    match expr[i] {
      Instr::I32Const(_) => stack.push(vt_i32)
      Instr::I64Const(_) => stack.push(vt_i64)
      Instr::F32Const(_) => stack.push(vt_f32)
      Instr::F64Const(_) => stack.push(vt_f64)
      Instr::V128Const(_) => stack.push(vt_v128)
      Instr::RefNull(rt) => stack.push(ref_type_to_id(rt))
      Instr::RefFunc(fidx) => {
        if fidx < 0 || fidx >= ctx.func_types.length() {
          return Err(WasmError::ValidationError("ref.func index out of bounds in const expr"))
        }
        stack.push(vt_funcref)
      }
      Instr::GlobalGet(gidx) => {
        if gidx < 0 || gidx >= max_global_idx {
          return Err(WasmError::ValidationError("global.get index out of bounds in const expr"))
        }
        let gt = ctx.globals[gidx]
        if gt.mutable {
          return Err(WasmError::ValidationError("global.get in const expr must reference immutable global"))
        }
        stack.push(val_type_to_id(gt.val_type))
      }
      Instr::End => ended = true
      _ => return Err(WasmError::ValidationError("non-constant instruction in constant expression"))
    }
    i = i + 1
  }
  if !ended {
    return Err(WasmError::ValidationError("const expression missing end"))
  }
  if stack.length() != 1 || stack[0] != expect_vt {
    return Err(WasmError::ValidationError("const expression result type mismatch"))
  }
  Ok(())
}

fn resolve_block_type(
  ctx : ModuleContext,
  bt : BlockType,
) -> Result[(Array[Int], Array[Int]), WasmError] {
  match bt {
    BlockType::Empty => Ok(([], []))
    BlockType::Value(vt) => Ok(([], [val_type_to_id(vt)]))
    BlockType::FuncType(idx) => {
      if idx < 0 || idx >= ctx.types.length() {
        return Err(WasmError::ValidationError("block type index out of bounds"))
      }
      let ft = ctx.types[idx]
      Ok((val_types_to_ids(ft.params), val_types_to_ids(ft.results)))
    }
  }
}

fn check_memarg(ctx : ModuleContext, ma : MemArg, natural_align : Int) -> Result[Unit, WasmError] {
  if ma.mem_idx < 0 || ma.mem_idx >= ctx.memories.length() {
    return Err(WasmError::ValidationError("memory index out of bounds"))
  }
  if ma.align > natural_align {
    return Err(
      WasmError::ValidationError(
        "alignment " + ma.align.to_string() + " exceeds natural alignment " + natural_align.to_string(),
      ),
    )
  }
  Ok(())
}

fn validate_simd_op(st : ValState, sub : Int) -> Result[Unit, WasmError] {
  if sub == 15 || sub == 16 || sub == 17 {
    return st.pop1_push1(vt_i32, vt_v128)
  }
  if sub == 18 {
    return st.pop1_push1(vt_i64, vt_v128)
  }
  if sub == 19 {
    return st.pop1_push1(vt_f32, vt_v128)
  }
  if sub == 20 {
    return st.pop1_push1(vt_f64, vt_v128)
  }
  if sub == 82 {
    match st.pop_val_expect(vt_v128) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    return st.pop2_push1(vt_v128, vt_v128, vt_v128)
  }
  if sub == 83 ||
  sub == 99 ||
  sub == 100 ||
  sub == 131 ||
  sub == 132 ||
  sub == 163 ||
  sub == 164 ||
  sub == 195 ||
  sub == 196 {
    return st.pop1_push1(vt_v128, vt_i32)
  }
  if (sub >= 107 && sub <= 109) ||
  (sub >= 139 && sub <= 141) ||
  (sub >= 171 && sub <= 173) ||
  (sub >= 203 && sub <= 205) {
    return st.pop2_push1(vt_v128, vt_i32, vt_v128)
  }
  if sub == 77 ||
  sub == 94 ||
  sub == 95 ||
  sub == 96 ||
  sub == 97 ||
  sub == 98 ||
  sub == 103 ||
  sub == 104 ||
  sub == 105 ||
  sub == 106 ||
  sub == 116 ||
  sub == 117 ||
  sub == 122 ||
  sub == 123 ||
  (sub >= 124 && sub <= 129) ||
  (sub >= 135 && sub <= 138) ||
  sub == 160 ||
  sub == 161 ||
  (sub >= 167 && sub <= 170) ||
  sub == 192 ||
  sub == 193 ||
  (sub >= 199 && sub <= 202) ||
  sub == 224 ||
  sub == 225 ||
  sub == 227 ||
  sub == 236 ||
  sub == 237 ||
  sub == 239 ||
  sub >= 248 {
    return st.pop1_push1(vt_v128, vt_v128)
  }
  st.pop2_push1(vt_v128, vt_v128, vt_v128)
}

fn validate_mem_instr(ctx : ModuleContext, st : ValState, ins : Instr) -> Result[Bool, WasmError] {
  match ins {
    Instr::I32Load(ma) => {
      match check_memarg(ctx, ma, 2) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop1_push1(vt_i32, vt_i32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I64Load(ma) => {
      match check_memarg(ctx, ma, 3) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop1_push1(vt_i32, vt_i64) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::F32Load(ma) => {
      match check_memarg(ctx, ma, 2) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop1_push1(vt_i32, vt_f32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::F64Load(ma) => {
      match check_memarg(ctx, ma, 3) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop1_push1(vt_i32, vt_f64) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I32Load8S(ma) | Instr::I32Load8U(ma) => {
      match check_memarg(ctx, ma, 0) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop1_push1(vt_i32, vt_i32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I32Load16S(ma) | Instr::I32Load16U(ma) => {
      match check_memarg(ctx, ma, 1) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop1_push1(vt_i32, vt_i32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I64Load8S(ma) | Instr::I64Load8U(ma) => {
      match check_memarg(ctx, ma, 0) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop1_push1(vt_i32, vt_i64) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I64Load16S(ma) | Instr::I64Load16U(ma) => {
      match check_memarg(ctx, ma, 1) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop1_push1(vt_i32, vt_i64) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I64Load32S(ma) | Instr::I64Load32U(ma) => {
      match check_memarg(ctx, ma, 2) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop1_push1(vt_i32, vt_i64) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I32Store(ma) => {
      match check_memarg(ctx, ma, 2) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop2(vt_i32, vt_i32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I64Store(ma) => {
      match check_memarg(ctx, ma, 3) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop2(vt_i32, vt_i64) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::F32Store(ma) => {
      match check_memarg(ctx, ma, 2) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop2(vt_i32, vt_f32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::F64Store(ma) => {
      match check_memarg(ctx, ma, 3) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop2(vt_i32, vt_f64) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I32Store8(ma) => {
      match check_memarg(ctx, ma, 0) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop2(vt_i32, vt_i32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I32Store16(ma) => {
      match check_memarg(ctx, ma, 1) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop2(vt_i32, vt_i32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I64Store8(ma) => {
      match check_memarg(ctx, ma, 0) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop2(vt_i32, vt_i64) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I64Store16(ma) => {
      match check_memarg(ctx, ma, 1) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop2(vt_i32, vt_i64) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I64Store32(ma) => {
      match check_memarg(ctx, ma, 2) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop2(vt_i32, vt_i64) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::MemorySize(midx) => {
      if midx < 0 || midx >= ctx.memories.length() {
        return Err(WasmError::ValidationError("memory.size index out of bounds"))
      }
      match st.push_val(vt_i32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::MemoryGrow(midx) => {
      if midx < 0 || midx >= ctx.memories.length() {
        return Err(WasmError::ValidationError("memory.grow index out of bounds"))
      }
      match st.pop1_push1(vt_i32, vt_i32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    _ => Ok(false)
  }
}

fn validate_int_instr(st : ValState, ins : Instr) -> Result[Bool, WasmError] {
  match ins {
    Instr::I32Const(_) =>
    match st.push_val(vt_i32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I64Const(_) =>
    match st.push_val(vt_i64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F32Const(_) =>
    match st.push_val(vt_f32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F64Const(_) =>
    match st.push_val(vt_f64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I32Eqz
    | Instr::I32Clz
    | Instr::I32Ctz
    | Instr::I32Popcnt
    | Instr::I32Extend8S
    | Instr::I32Extend16S =>
    match st.pop1_push1(vt_i32, vt_i32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I32Eq
    | Instr::I32Ne
    | Instr::I32LtS
    | Instr::I32LtU
    | Instr::I32GtS
    | Instr::I32GtU
    | Instr::I32LeS
    | Instr::I32LeU
    | Instr::I32GeS
    | Instr::I32GeU
    | Instr::I32Add
    | Instr::I32Sub
    | Instr::I32Mul
    | Instr::I32DivS
    | Instr::I32DivU
    | Instr::I32RemS
    | Instr::I32RemU
    | Instr::I32And
    | Instr::I32Or
    | Instr::I32Xor
    | Instr::I32Shl
    | Instr::I32ShrS
    | Instr::I32ShrU
    | Instr::I32Rotl
    | Instr::I32Rotr =>
    match st.pop2_push1(vt_i32, vt_i32, vt_i32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I64Eqz | Instr::I32WrapI64 =>
    match st.pop1_push1(vt_i64, vt_i32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I64Eq
    | Instr::I64Ne
    | Instr::I64LtS
    | Instr::I64LtU
    | Instr::I64GtS
    | Instr::I64GtU
    | Instr::I64LeS
    | Instr::I64LeU
    | Instr::I64GeS
    | Instr::I64GeU =>
    match st.pop2_push1(vt_i64, vt_i64, vt_i32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I64Clz
    | Instr::I64Ctz
    | Instr::I64Popcnt
    | Instr::I64Extend8S
    | Instr::I64Extend16S
    | Instr::I64Extend32S =>
    match st.pop1_push1(vt_i64, vt_i64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I64Add
    | Instr::I64Sub
    | Instr::I64Mul
    | Instr::I64DivS
    | Instr::I64DivU
    | Instr::I64RemS
    | Instr::I64RemU
    | Instr::I64And
    | Instr::I64Or
    | Instr::I64Xor
    | Instr::I64Shl
    | Instr::I64ShrS
    | Instr::I64ShrU
    | Instr::I64Rotl
    | Instr::I64Rotr =>
    match st.pop2_push1(vt_i64, vt_i64, vt_i64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    _ => Ok(false)
  }
}

fn validate_float_conv_instr(st : ValState, ins : Instr) -> Result[Bool, WasmError] {
  match ins {
    Instr::F32Eq | Instr::F32Ne | Instr::F32Lt | Instr::F32Gt | Instr::F32Le | Instr::F32Ge =>
    match st.pop2_push1(vt_f32, vt_f32, vt_i32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F64Eq | Instr::F64Ne | Instr::F64Lt | Instr::F64Gt | Instr::F64Le | Instr::F64Ge =>
    match st.pop2_push1(vt_f64, vt_f64, vt_i32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F32Abs
    | Instr::F32Neg
    | Instr::F32Ceil
    | Instr::F32Floor
    | Instr::F32Trunc
    | Instr::F32Nearest
    | Instr::F32Sqrt =>
    match st.pop1_push1(vt_f32, vt_f32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F32Add
    | Instr::F32Sub
    | Instr::F32Mul
    | Instr::F32Div
    | Instr::F32Min
    | Instr::F32Max
    | Instr::F32Copysign =>
    match st.pop2_push1(vt_f32, vt_f32, vt_f32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F64Abs
    | Instr::F64Neg
    | Instr::F64Ceil
    | Instr::F64Floor
    | Instr::F64Trunc
    | Instr::F64Nearest
    | Instr::F64Sqrt =>
    match st.pop1_push1(vt_f64, vt_f64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F64Add
    | Instr::F64Sub
    | Instr::F64Mul
    | Instr::F64Div
    | Instr::F64Min
    | Instr::F64Max
    | Instr::F64Copysign =>
    match st.pop2_push1(vt_f64, vt_f64, vt_f64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I32TruncF32S
    | Instr::I32TruncF32U
    | Instr::I32ReinterpretF32
    | Instr::I32TruncSatF32S
    | Instr::I32TruncSatF32U =>
    match st.pop1_push1(vt_f32, vt_i32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I32TruncF64S
    | Instr::I32TruncF64U
    | Instr::I32TruncSatF64S
    | Instr::I32TruncSatF64U =>
    match st.pop1_push1(vt_f64, vt_i32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I64ExtendI32S | Instr::I64ExtendI32U =>
    match st.pop1_push1(vt_i32, vt_i64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I64TruncF32S
    | Instr::I64TruncF32U
    | Instr::I64TruncSatF32S
    | Instr::I64TruncSatF32U =>
    match st.pop1_push1(vt_f32, vt_i64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::I64TruncF64S
    | Instr::I64TruncF64U
    | Instr::I64ReinterpretF64
    | Instr::I64TruncSatF64S
    | Instr::I64TruncSatF64U =>
    match st.pop1_push1(vt_f64, vt_i64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F32ConvertI32S | Instr::F32ConvertI32U | Instr::F32ReinterpretI32 =>
    match st.pop1_push1(vt_i32, vt_f32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F32ConvertI64S | Instr::F32ConvertI64U =>
    match st.pop1_push1(vt_i64, vt_f32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F32DemoteF64 =>
    match st.pop1_push1(vt_f64, vt_f32) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F64ConvertI32S | Instr::F64ConvertI32U =>
    match st.pop1_push1(vt_i32, vt_f64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F64ConvertI64S | Instr::F64ConvertI64U | Instr::F64ReinterpretI64 =>
    match st.pop1_push1(vt_i64, vt_f64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::F64PromoteF32 =>
    match st.pop1_push1(vt_f32, vt_f64) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    _ => Ok(false)
  }
}

fn validate_ext_instr(ctx : ModuleContext, st : ValState, ins : Instr) -> Result[Bool, WasmError] {
  match ins {
    Instr::RefNull(rt) =>
    match st.push_val(ref_type_to_id(rt)) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    Instr::RefIsNull => {
      let t = match st.pop_val() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if t != vt_unknown && !is_ref_id(t) {
        return Err(WasmError::ValidationError("ref.is_null requires reference type"))
      }
      match st.push_val(vt_i32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::RefFunc(fidx) => {
      if fidx < 0 || fidx >= ctx.func_types.length() {
        return Err(WasmError::ValidationError("ref.func index out of bounds"))
      }
      match st.push_val(vt_funcref) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::MemoryInit(didx, midx) => {
      if !ctx.has_data_count {
        return Err(WasmError::ValidationError("memory.init requires DataCount section"))
      }
      if didx < 0 || didx >= ctx.num_data || midx < 0 || midx >= ctx.memories.length() {
        return Err(WasmError::ValidationError("memory.init index out of bounds"))
      }
      match st.pop3_i32() {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::DataDrop(didx) => {
      if !ctx.has_data_count {
        return Err(WasmError::ValidationError("data.drop requires DataCount section"))
      }
      if didx < 0 || didx >= ctx.num_data {
        return Err(WasmError::ValidationError("data.drop index out of bounds"))
      }
      Ok(true)
    }
    Instr::MemoryCopy(dst, src) => {
      if dst < 0 || dst >= ctx.memories.length() || src < 0 || src >= ctx.memories.length() {
        return Err(WasmError::ValidationError("memory.copy index out of bounds"))
      }
      match st.pop3_i32() {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::MemoryFill(midx) => {
      if midx < 0 || midx >= ctx.memories.length() {
        return Err(WasmError::ValidationError("memory.fill index out of bounds"))
      }
      match st.pop3_i32() {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::TableInit(eidx, tidx) => {
      if eidx < 0 || eidx >= ctx.num_elems || tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.init index out of bounds"))
      }
      match st.pop3_i32() {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::ElemDrop(eidx) => {
      if eidx < 0 || eidx >= ctx.num_elems {
        return Err(WasmError::ValidationError("elem.drop index out of bounds"))
      }
      Ok(true)
    }
    Instr::TableCopy(dst, src) => {
      if dst < 0 || dst >= ctx.tables.length() || src < 0 || src >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.copy index out of bounds"))
      }
      if ref_type_to_id(ctx.tables[dst].elem_type) != ref_type_to_id(ctx.tables[src].elem_type) {
        return Err(WasmError::ValidationError("table.copy element type mismatch"))
      }
      match st.pop3_i32() {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::TableGrow(tidx) => {
      if tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.grow index out of bounds"))
      }
      match st.pop2_push1(ref_type_to_id(ctx.tables[tidx].elem_type), vt_i32, vt_i32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::TableSize(tidx) => {
      if tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.size index out of bounds"))
      }
      match st.push_val(vt_i32) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::TableFill(tidx) => {
      if tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.fill index out of bounds"))
      }
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop2(vt_i32, ref_type_to_id(ctx.tables[tidx].elem_type)) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::V128Const(bs) => {
      if bs.length() != 16 {
        return Err(WasmError::ValidationError("v128.const must be 16 bytes"))
      }
      match st.push_val(vt_v128) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::I8x16Shuffle(lanes) => {
      if lanes.length() != 16 {
        return Err(WasmError::ValidationError("i8x16.shuffle must have 16 lanes"))
      }
      let mut k = 0
      while k < 16 {
        if lanes[k].to_int() >= 32 {
          return Err(WasmError::ValidationError("i8x16.shuffle lane index >= 32"))
        }
        k = k + 1
      }
      match st.pop2_push1(vt_v128, vt_v128, vt_v128) {
        Ok(_) => Ok(true)
        Err(e) => Err(e)
      }
    }
    Instr::SimdMem(sub, ma) => {
      let nat = match sub {
        0 | 11 => 4
        1 | 2 | 3 | 4 | 5 | 6 | 10 | 93 => 3
        7 => 0
        8 => 1
        9 | 92 => 2
        _ => 4
      }
      match check_memarg(ctx, ma, nat) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if sub == 11 {
        match st.pop2(vt_i32, vt_v128) {
          Ok(_) => Ok(true)
          Err(e) => Err(e)
        }
      } else {
        match st.pop1_push1(vt_i32, vt_v128) {
          Ok(_) => Ok(true)
          Err(e) => Err(e)
        }
      }
    }
    Instr::SimdMemLane(sub, ma, lane) => {
      let (nat, max_lane, is_store) = match sub {
        84 => (0, 16, false)
        85 => (1, 8, false)
        86 => (2, 4, false)
        87 => (3, 2, false)
        88 => (0, 16, true)
        89 => (1, 8, true)
        90 => (2, 4, true)
        91 => (3, 2, true)
        _ => return Err(WasmError::ValidationError("invalid SIMD mem lane op"))
      }
      if lane < 0 || lane >= max_lane {
        return Err(WasmError::ValidationError("SIMD lane index out of bounds"))
      }
      match check_memarg(ctx, ma, nat) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if is_store {
        match st.pop2(vt_i32, vt_v128) {
          Ok(_) => Ok(true)
          Err(e) => Err(e)
        }
      } else {
        match st.pop2_push1(vt_i32, vt_v128, vt_v128) {
          Ok(_) => Ok(true)
          Err(e) => Err(e)
        }
      }
    }
    Instr::SimdLane(sub, lane) => {
      let (max_lane, is_replace, lane_vt) = match sub {
        21 | 22 => (16, false, vt_i32)
        23 => (16, true, vt_i32)
        24 | 25 => (8, false, vt_i32)
        26 => (8, true, vt_i32)
        27 => (4, false, vt_i32)
        28 => (4, true, vt_i32)
        29 => (2, false, vt_i64)
        30 => (2, true, vt_i64)
        31 => (4, false, vt_f32)
        32 => (4, true, vt_f32)
        33 => (2, false, vt_f64)
        34 => (2, true, vt_f64)
        _ => return Err(WasmError::ValidationError("invalid SIMD lane op"))
      }
      if lane < 0 || lane >= max_lane {
        return Err(WasmError::ValidationError("SIMD lane index out of bounds"))
      }
      if is_replace {
        match st.pop2_push1(vt_v128, lane_vt, vt_v128) {
          Ok(_) => Ok(true)
          Err(e) => Err(e)
        }
      } else {
        match st.pop1_push1(vt_v128, lane_vt) {
          Ok(_) => Ok(true)
          Err(e) => Err(e)
        }
      }
    }
    Instr::SimdOp(sub) =>
    match validate_simd_op(st, sub) {
      Ok(_) => Ok(true)
      Err(e) => Err(e)
    }
    _ => Ok(false)
  }
}

fn validate_ctrl_var_instr(
  ctx : ModuleContext,
  st : ValState,
  locals : Array[Int],
  func_results : Array[Int],
  ins : Instr,
  is_last : Bool,
) -> Result[Unit, WasmError] {
  match ins {
    Instr::Unreachable => st.mark_unreachable()
    Instr::Nop => ()
    Instr::Block(bt) => {
      let (in_t, out_t) = match resolve_block_type(ctx, bt) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      match st.pop_vals(in_t) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      return st.push_ctrl(ctrl_block, in_t, out_t)
    }
    Instr::Loop(bt) => {
      let (in_t, out_t) = match resolve_block_type(ctx, bt) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      match st.pop_vals(in_t) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      return st.push_ctrl(ctrl_loop, in_t, out_t)
    }
    Instr::If(bt) => {
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let (in_t, out_t) = match resolve_block_type(ctx, bt) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      match st.pop_vals(in_t) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      return st.push_ctrl(ctrl_if, in_t, out_t)
    }
    Instr::Else => {
      let frame = match st.pop_ctrl() {
        Ok(f) => f
        Err(e) => return Err(e)
      }
      if frame.opcode != ctrl_if {
        return Err(WasmError::ValidationError("else without matching if"))
      }
      return st.push_ctrl(ctrl_else, frame.start_types, frame.end_types)
    }
    Instr::End => {
      let frame = match st.pop_ctrl() {
        Ok(f) => f
        Err(e) => return Err(e)
      }
      if frame.opcode == ctrl_if {
        if frame.start_types.length() != frame.end_types.length() {
          return Err(WasmError::ValidationError("if without else has mismatched block type"))
        }
        let mut k = 0
        while k < frame.start_types.length() {
          if frame.start_types[k] != frame.end_types[k] {
            return Err(WasmError::ValidationError("if without else has mismatched block type"))
          }
          k = k + 1
        }
      }
      if st.ctrl_len > 0 {
        return st.push_vals(frame.end_types)
      } else if !is_last {
        return Err(WasmError::ValidationError("trailing instructions after function end"))
      }
    }
    Instr::Br(l) => {
      if l < 0 || l >= st.ctrl_len {
        return Err(WasmError::ValidationError("br label out of bounds"))
      }
      let target = st.ctrl_stack[st.ctrl_len - 1 - l]
      match st.pop_vals(label_types(target)) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.mark_unreachable()
    }
    Instr::BrIf(l) => {
      if l < 0 || l >= st.ctrl_len {
        return Err(WasmError::ValidationError("br_if label out of bounds"))
      }
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let lt = label_types(st.ctrl_stack[st.ctrl_len - 1 - l])
      match st.pop_vals(lt) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      return st.push_vals(lt)
    }
    Instr::BrTable(targets, def_t) => {
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if def_t < 0 || def_t >= st.ctrl_len {
        return Err(WasmError::ValidationError("br_table default label out of bounds"))
      }
      let def_types = label_types(st.ctrl_stack[st.ctrl_len - 1 - def_t])
      let arity = def_types.length()
      let mut ti = 0
      while ti < targets.length() {
        let l = targets[ti]
        if l < 0 || l >= st.ctrl_len {
          return Err(WasmError::ValidationError("br_table target label out of bounds"))
        }
        let lt = label_types(st.ctrl_stack[st.ctrl_len - 1 - l])
        if lt.length() != arity {
          return Err(WasmError::ValidationError("br_table target arity mismatch"))
        }
        let popped : Array[Int] = []
        let mut k = arity - 1
        while k >= 0 {
          match st.pop_val_expect(lt[k]) {
            Ok(v) => popped.push(v)
            Err(e) => return Err(e)
          }
          k = k - 1
        }
        let mut p = popped.length() - 1
        while p >= 0 {
          match st.push_val(popped[p]) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          p = p - 1
        }
        ti = ti + 1
      }
      match st.pop_vals(def_types) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.mark_unreachable()
    }
    Instr::Return => {
      match st.pop_vals(func_results) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.mark_unreachable()
    }
    Instr::Call(fidx) => {
      if fidx < 0 || fidx >= ctx.func_types.length() {
        return Err(WasmError::ValidationError("call function index out of bounds"))
      }
      let callee_ft = ctx.types[ctx.func_types[fidx]]
      match st.pop_vals(val_types_to_ids(callee_ft.params)) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      return st.push_vals(val_types_to_ids(callee_ft.results))
    }
    Instr::CallIndirect(tidx, tbl_idx) => {
      if tbl_idx < 0 || tbl_idx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("call_indirect table index out of bounds"))
      }
      if ref_type_to_id(ctx.tables[tbl_idx].elem_type) != vt_funcref {
        return Err(WasmError::ValidationError("call_indirect table must have funcref type"))
      }
      if tidx < 0 || tidx >= ctx.types.length() {
        return Err(WasmError::ValidationError("call_indirect type index out of bounds"))
      }
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let callee_ft = ctx.types[tidx]
      match st.pop_vals(val_types_to_ids(callee_ft.params)) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      return st.push_vals(val_types_to_ids(callee_ft.results))
    }
    Instr::Drop =>
    match st.pop_val() {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    Instr::Select => {
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let t1 = match st.pop_val() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let t2 = match st.pop_val() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if is_ref_id(t1) || is_ref_id(t2) {
        return Err(WasmError::ValidationError("untyped select cannot operate on reference types"))
      }
      if t1 != t2 && t1 != vt_unknown && t2 != vt_unknown {
        return Err(WasmError::ValidationError("select operand types mismatch"))
      }
      let res = if t1 == vt_unknown { t2 } else { t1 }
      return st.push_val(res)
    }
    Instr::TypedSelect(ts) => {
      if ts.length() != 1 {
        return Err(WasmError::ValidationError("typed select must have exactly 1 type"))
      }
      let tid = val_type_to_id(ts[0])
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      return st.pop2_push1(tid, tid, tid)
    }
    Instr::LocalGet(lidx) => {
      if lidx < 0 || lidx >= locals.length() {
        return Err(WasmError::ValidationError("local.get index out of bounds"))
      }
      return st.push_val(locals[lidx])
    }
    Instr::LocalSet(lidx) => {
      if lidx < 0 || lidx >= locals.length() {
        return Err(WasmError::ValidationError("local.set index out of bounds"))
      }
      match st.pop_val_expect(locals[lidx]) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    Instr::LocalTee(lidx) => {
      if lidx < 0 || lidx >= locals.length() {
        return Err(WasmError::ValidationError("local.tee index out of bounds"))
      }
      return st.pop1_push1(locals[lidx], locals[lidx])
    }
    Instr::GlobalGet(gidx) => {
      if gidx < 0 || gidx >= ctx.globals.length() {
        return Err(WasmError::ValidationError("global.get index out of bounds"))
      }
      return st.push_val(val_type_to_id(ctx.globals[gidx].val_type))
    }
    Instr::GlobalSet(gidx) => {
      if gidx < 0 || gidx >= ctx.globals.length() {
        return Err(WasmError::ValidationError("global.set index out of bounds"))
      }
      let gt = ctx.globals[gidx]
      if !gt.mutable {
        return Err(WasmError::ValidationError("cannot global.set immutable global"))
      }
      match st.pop_val_expect(val_type_to_id(gt.val_type)) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }
    Instr::TableGet(tidx) => {
      if tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.get index out of bounds"))
      }
      return st.pop1_push1(vt_i32, ref_type_to_id(ctx.tables[tidx].elem_type))
    }
    Instr::TableSet(tidx) => {
      if tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.set index out of bounds"))
      }
      return st.pop2(vt_i32, ref_type_to_id(ctx.tables[tidx].elem_type))
    }
    _ => ()
  }
  Ok(())
}

fn validate_func_body(
  ctx : ModuleContext,
  ft : FuncType,
  fb : FuncBody,
  limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let locals : Array[Int] = val_types_to_ids(ft.params)
  let mut total_declared : Int64 = 0L
  let mut li = 0
  while li < fb.locals.length() {
    let grp = fb.locals[li]
    if grp.count < 0 {
      return Err(WasmError::ValidationError("negative local group count"))
    }
    total_declared = total_declared + grp.count.to_int64()
    if total_declared > limits.max_locals_per_func.to_int64() {
      return Err(WasmError::LimitExceeded("max_locals_per_func exceeded"))
    }
    let tid = val_type_to_id(grp.val_type)
    let mut k = 0
    while k < grp.count {
      locals.push(tid)
      k = k + 1
    }
    li = li + 1
  }

  let st = ValState::new(limits)
  let func_results = val_types_to_ids(ft.results)
  match st.push_ctrl(ctrl_func, [], func_results) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  let body = fb.body
  let mut idx = 0
  while idx < body.length() {
    let ins = body[idx]
    match validate_int_instr(st, ins) {
      Ok(true) => {
        idx = idx + 1
        continue
      }
      Ok(false) => ()
      Err(e) => return Err(e)
    }
    match validate_float_conv_instr(st, ins) {
      Ok(true) => {
        idx = idx + 1
        continue
      }
      Ok(false) => ()
      Err(e) => return Err(e)
    }
    match validate_mem_instr(ctx, st, ins) {
      Ok(true) => {
        idx = idx + 1
        continue
      }
      Ok(false) => ()
      Err(e) => return Err(e)
    }
    match validate_ext_instr(ctx, st, ins) {
      Ok(true) => {
        idx = idx + 1
        continue
      }
      Ok(false) => ()
      Err(e) => return Err(e)
    }
    match validate_ctrl_var_instr(ctx, st, locals, func_results, ins, idx + 1 == body.length()) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    idx = idx + 1
  }

  if st.ctrl_len != 0 {
    return Err(WasmError::ValidationError("unclosed control block in function body"))
  }
  Ok(())
}

///| Validate a decoded `Module` using default limits.
pub fn validate_module(m : Module) -> Result[Unit, WasmError] {
  validate_module_with_limits(m, ValidateLimits::default())
}

///| Validate a decoded `Module` using custom limits.
pub fn validate_module_with_limits(m : Module, limits : ValidateLimits) -> Result[Unit, WasmError] {
  if m.version != 1 {
    return Err(WasmError::UnsupportedVersion(m.version))
  }
  if m.types.length() > limits.max_types {
    return Err(WasmError::LimitExceeded("max_types exceeded"))
  }
  if m.functions.length() != m.codes.length() {
    return Err(WasmError::ValidationError("function and code section counts do not match"))
  }
  match m.data_count {
    Some(dc) =>
    if dc != m.data.length() {
      return Err(WasmError::ValidationError("DataCount does not match Data section length"))
    }
    None => ()
  }

  let func_types : Array[Int] = []
  let tables : Array[TableType] = []
  let memories : Array[MemType] = []
  let globals : Array[GlobalType] = []

  let mut i = 0
  while i < m.imports.length() {
    match m.imports[i].desc {
      ImportDesc::Func(tidx) => {
        if tidx < 0 || tidx >= m.types.length() {
          return Err(WasmError::ValidationError("import func type index out of bounds"))
        }
        func_types.push(tidx)
      }
      ImportDesc::Table(tt) => {
        match validate_limits_obj(tt.limits, 4294967295L, false) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        tables.push(tt)
      }
      ImportDesc::Memory(mt) => {
        match validate_limits_obj(mt.limits, limits.max_memory_pages, true) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        memories.push(mt)
      }
      ImportDesc::Global(gt) => globals.push(gt)
    }
    i = i + 1
  }
  let imported_globals = globals.length()

  i = 0
  while i < m.functions.length() {
    let tidx = m.functions[i]
    if tidx < 0 || tidx >= m.types.length() {
      return Err(WasmError::ValidationError("function type index out of bounds"))
    }
    func_types.push(tidx)
    i = i + 1
  }
  if func_types.length() > limits.max_functions {
    return Err(WasmError::LimitExceeded("max_functions exceeded"))
  }

  i = 0
  while i < m.tables.length() {
    match validate_limits_obj(m.tables[i].limits, 4294967295L, false) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    tables.push(m.tables[i])
    i = i + 1
  }
  if tables.length() > limits.max_tables {
    return Err(WasmError::LimitExceeded("max_tables exceeded"))
  }

  i = 0
  while i < m.memories.length() {
    match validate_limits_obj(m.memories[i].limits, limits.max_memory_pages, true) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    memories.push(m.memories[i])
    i = i + 1
  }
  if !limits.allow_multi_memory && memories.length() > 1 {
    return Err(WasmError::ValidationError("multiple memories not allowed"))
  }
  if memories.length() > limits.max_memories {
    return Err(WasmError::LimitExceeded("max_memories exceeded"))
  }

  i = 0
  while i < m.globals.length() {
    globals.push(m.globals[i].global_type)
    i = i + 1
  }
  if globals.length() > limits.max_globals {
    return Err(WasmError::LimitExceeded("max_globals exceeded"))
  }
  if m.exports.length() > limits.max_exports {
    return Err(WasmError::LimitExceeded("max_exports exceeded"))
  }
  if m.elements.length() > limits.max_elements {
    return Err(WasmError::LimitExceeded("max_elements exceeded"))
  }
  if m.data.length() > limits.max_data_segments {
    return Err(WasmError::LimitExceeded("max_data_segments exceeded"))
  }

  let has_dc = match m.data_count {
    Some(_) => true
    None => false
  }
  let ctx = ModuleContext::{
    types: m.types,
    func_types: func_types,
    tables: tables,
    memories: memories,
    globals: globals,
    imported_globals: imported_globals,
    num_elems: m.elements.length(),
    num_data: m.data.length(),
    has_data_count: has_dc,
  }

  i = 0
  while i < m.globals.length() {
    let g = m.globals[i]
    match validate_const_expr(ctx, g.init, val_type_to_id(g.global_type.val_type), imported_globals) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }

  let export_names : Array[String] = []
  i = 0
  while i < m.exports.length() {
    let ex = m.exports[i]
    let mut j = 0
    while j < export_names.length() {
      if export_names[j] == ex.name {
        return Err(WasmError::ValidationError("duplicate export name: " + ex.name))
      }
      j = j + 1
    }
    export_names.push(ex.name)
    let ok = match ex.kind {
      ExportKind::Func => ex.index >= 0 && ex.index < func_types.length()
      ExportKind::Table => ex.index >= 0 && ex.index < tables.length()
      ExportKind::Memory => ex.index >= 0 && ex.index < memories.length()
      ExportKind::Global => ex.index >= 0 && ex.index < globals.length()
    }
    if !ok {
      return Err(WasmError::ValidationError("export index out of bounds: " + ex.name))
    }
    i = i + 1
  }

  match m.start {
    Some(fidx) => {
      if fidx < 0 || fidx >= func_types.length() {
        return Err(WasmError::ValidationError("start function index out of bounds"))
      }
      let ft = m.types[func_types[fidx]]
      if ft.params.length() != 0 || ft.results.length() != 0 {
        return Err(WasmError::ValidationError("start function must have type () -> ()"))
      }
    }
    None => ()
  }

  i = 0
  while i < m.elements.length() {
    let seg = m.elements[i]
    match seg.mode {
      ElemMode::Active(tidx, offset_expr) => {
        if tidx < 0 || tidx >= tables.length() {
          return Err(WasmError::ValidationError("element segment table index out of bounds"))
        }
        if ref_type_to_id(tables[tidx].elem_type) != ref_type_to_id(seg.elem_type) {
          return Err(WasmError::ValidationError("element segment type does not match table type"))
        }
        match validate_const_expr(ctx, offset_expr, vt_i32, imported_globals) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      _ => ()
    }
    match seg.items {
      ElemItems::FuncIndices(idxs) => {
        let mut j = 0
        while j < idxs.length() {
          if idxs[j] < 0 || idxs[j] >= func_types.length() {
            return Err(WasmError::ValidationError("element func index out of bounds"))
          }
          j = j + 1
        }
      }
      ElemItems::Exprs(exprs) => {
        let et_id = ref_type_to_id(seg.elem_type)
        let mut j = 0
        while j < exprs.length() {
          match validate_const_expr(ctx, exprs[j], et_id, imported_globals) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          j = j + 1
        }
      }
    }
    i = i + 1
  }

  i = 0
  while i < m.data.length() {
    match m.data[i].mode {
      DataMode::Active(midx, offset_expr) => {
        if midx < 0 || midx >= memories.length() {
          return Err(WasmError::ValidationError("data segment memory index out of bounds"))
        }
        match validate_const_expr(ctx, offset_expr, vt_i32, imported_globals) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      DataMode::Passive => ()
    }
    i = i + 1
  }

  i = 0
  while i < m.codes.length() {
    let ft = m.types[m.functions[i]]
    match validate_func_body(ctx, ft, m.codes[i], limits) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    i = i + 1
  }

  Ok(())
}

///| Decode and validate raw WebAssembly binary bytes using default limits.
pub fn validate_bytes(data : Bytes) -> Result[Unit, WasmError] {
  validate_bytes_with_limits(data, DecodeLimits::default(), ValidateLimits::default())
}

///| Decode and validate raw WebAssembly binary bytes using custom limits.
pub fn validate_bytes_with_limits(
  data : Bytes,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let m = match decode_module_with_limits(data, decode_limits) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  validate_module_with_limits(m, validate_limits)
}
