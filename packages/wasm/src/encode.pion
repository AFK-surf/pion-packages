///| WebAssembly binary encoder and `ModuleBuilder` (Red-phase stubs).

///| Encode a `Module` into canonical `.wasm` binary bytes.
pub fn encode_module(m : Module) -> Result[Bytes, WasmError] {
  let _ = m
  Err(WasmError::Unimplemented("encode_module"))
}

///| Programmatic WebAssembly module builder.
pub struct ModuleBuilder {
  m : Module
}

///| Create a new `ModuleBuilder`.
pub fn ModuleBuilder::new() -> ModuleBuilder {
  ModuleBuilder::{ m: Module::empty() }
}

///| Add a function type and return its type index.
pub fn ModuleBuilder::add_type(
  self : ModuleBuilder,
  params : Array[ValType],
  results : Array[ValType],
) -> Int {
  let _ = self
  let _ = params
  let _ = results
  0
}

///| Add an import entry.
pub fn ModuleBuilder::add_import(
  self : ModuleBuilder,
  module_name : String,
  name : String,
  desc : ImportDesc,
) -> Unit {
  let _ = self
  let _ = module_name
  let _ = name
  let _ = desc
  ()
}

///| Add a defined function with its type index, locals, and instruction body.
pub fn ModuleBuilder::add_func(
  self : ModuleBuilder,
  type_idx : Int,
  locals : Array[LocalGroup],
  body : Array[Instr],
) -> Int {
  let _ = self
  let _ = type_idx
  let _ = locals
  let _ = body
  0
}

///| Add a table definition.
pub fn ModuleBuilder::add_table(self : ModuleBuilder, t : TableType) -> Int {
  let _ = self
  let _ = t
  0
}

///| Add a memory definition.
pub fn ModuleBuilder::add_memory(self : ModuleBuilder, mem : MemType) -> Int {
  let _ = self
  let _ = mem
  0
}

///| Add a global definition.
pub fn ModuleBuilder::add_global(
  self : ModuleBuilder,
  gt : GlobalType,
  init : Array[Instr],
) -> Int {
  let _ = self
  let _ = gt
  let _ = init
  0
}

///| Add an export entry.
pub fn ModuleBuilder::add_export(
  self : ModuleBuilder,
  name : String,
  kind : ExportKind,
  index : Int,
) -> Unit {
  let _ = self
  let _ = name
  let _ = kind
  let _ = index
  ()
}

///| Set the start function index.
pub fn ModuleBuilder::set_start(self : ModuleBuilder, func_idx : Int) -> Unit {
  let _ = self
  let _ = func_idx
  ()
}

///| Add an element segment.
pub fn ModuleBuilder::add_element(self : ModuleBuilder, seg : ElemSegment) -> Int {
  let _ = self
  let _ = seg
  0
}

///| Add a data segment.
pub fn ModuleBuilder::add_data(self : ModuleBuilder, seg : DataSegment) -> Int {
  let _ = self
  let _ = seg
  0
}

///| Add a custom section.
pub fn ModuleBuilder::add_custom(self : ModuleBuilder, name : String, data : Bytes) -> Unit {
  let _ = self
  let _ = name
  let _ = data
  ()
}

///| Finish building and return the `Module`.
pub fn ModuleBuilder::build(self : ModuleBuilder) -> Module {
  self.m
}

///| Finish building and encode directly to `.wasm` bytes.
pub fn ModuleBuilder::encode(self : ModuleBuilder) -> Result[Bytes, WasmError] {
  encode_module(self.m)
}
