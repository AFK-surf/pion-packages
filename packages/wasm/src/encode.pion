///| WebAssembly 1.0/2.0 binary encoder and programmatic `ModuleBuilder`.

fn encode_limits(w : ByteWriter, lim : Limits) -> Unit {
  let mut flags = 0
  match lim.max {
    Some(_) => flags = flags | 0x01
    None => ()
  }
  if lim.shared {
    flags = flags | 0x02
  }
  if lim.is_memory64 {
    flags = flags | 0x04
  }
  w.push_byte(flags)
  if lim.is_memory64 {
    w.write_varuint64(lim.min.to_uint64())
    match lim.max {
      Some(mx) => w.write_varuint64(mx.to_uint64())
      None => ()
    }
  } else {
    w.write_varuint32(lim.min)
    match lim.max {
      Some(mx) => w.write_varuint32(mx)
      None => ()
    }
  }
}

fn encode_block_type(w : ByteWriter, bt : BlockType) -> Unit {
  match bt {
    BlockType::Empty => w.push_byte(0x40)
    BlockType::Value(vt) => w.push_byte(val_type_code(vt))
    BlockType::FuncType(idx) => w.write_varint33(idx.to_int64())
  }
}

fn encode_memarg(w : ByteWriter, ma : MemArg) -> Unit {
  if ma.mem_idx != 0 {
    w.write_varuint32((ma.align | 0x40).to_int64())
    w.write_varuint32(ma.mem_idx.to_int64())
  } else {
    w.write_varuint32(ma.align.to_int64())
  }
  w.write_varuint32(ma.offset)
}

fn encode_mem_instr(w : ByteWriter, ins : Instr) -> Bool {
  match ins {
    Instr::I32Load(ma) => {
      w.push_byte(0x28)
      encode_memarg(w, ma)
      true
    }
    Instr::I64Load(ma) => {
      w.push_byte(0x29)
      encode_memarg(w, ma)
      true
    }
    Instr::F32Load(ma) => {
      w.push_byte(0x2A)
      encode_memarg(w, ma)
      true
    }
    Instr::F64Load(ma) => {
      w.push_byte(0x2B)
      encode_memarg(w, ma)
      true
    }
    Instr::I32Load8S(ma) => {
      w.push_byte(0x2C)
      encode_memarg(w, ma)
      true
    }
    Instr::I32Load8U(ma) => {
      w.push_byte(0x2D)
      encode_memarg(w, ma)
      true
    }
    Instr::I32Load16S(ma) => {
      w.push_byte(0x2E)
      encode_memarg(w, ma)
      true
    }
    Instr::I32Load16U(ma) => {
      w.push_byte(0x2F)
      encode_memarg(w, ma)
      true
    }
    Instr::I64Load8S(ma) => {
      w.push_byte(0x30)
      encode_memarg(w, ma)
      true
    }
    Instr::I64Load8U(ma) => {
      w.push_byte(0x31)
      encode_memarg(w, ma)
      true
    }
    Instr::I64Load16S(ma) => {
      w.push_byte(0x32)
      encode_memarg(w, ma)
      true
    }
    Instr::I64Load16U(ma) => {
      w.push_byte(0x33)
      encode_memarg(w, ma)
      true
    }
    Instr::I64Load32S(ma) => {
      w.push_byte(0x34)
      encode_memarg(w, ma)
      true
    }
    Instr::I64Load32U(ma) => {
      w.push_byte(0x35)
      encode_memarg(w, ma)
      true
    }
    Instr::I32Store(ma) => {
      w.push_byte(0x36)
      encode_memarg(w, ma)
      true
    }
    Instr::I64Store(ma) => {
      w.push_byte(0x37)
      encode_memarg(w, ma)
      true
    }
    Instr::F32Store(ma) => {
      w.push_byte(0x38)
      encode_memarg(w, ma)
      true
    }
    Instr::F64Store(ma) => {
      w.push_byte(0x39)
      encode_memarg(w, ma)
      true
    }
    Instr::I32Store8(ma) => {
      w.push_byte(0x3A)
      encode_memarg(w, ma)
      true
    }
    Instr::I32Store16(ma) => {
      w.push_byte(0x3B)
      encode_memarg(w, ma)
      true
    }
    Instr::I64Store8(ma) => {
      w.push_byte(0x3C)
      encode_memarg(w, ma)
      true
    }
    Instr::I64Store16(ma) => {
      w.push_byte(0x3D)
      encode_memarg(w, ma)
      true
    }
    Instr::I64Store32(ma) => {
      w.push_byte(0x3E)
      encode_memarg(w, ma)
      true
    }
    Instr::MemorySize(m) => {
      w.push_byte(0x3F)
      w.write_varuint32(m.to_int64())
      true
    }
    Instr::MemoryGrow(m) => {
      w.push_byte(0x40)
      w.write_varuint32(m.to_int64())
      true
    }
    _ => false
  }
}

fn encode_num_opcode(ins : Instr) -> Int {
  match ins {
    Instr::I32Eqz => 0x45
    Instr::I32Eq => 0x46
    Instr::I32Ne => 0x47
    Instr::I32LtS => 0x48
    Instr::I32LtU => 0x49
    Instr::I32GtS => 0x4A
    Instr::I32GtU => 0x4B
    Instr::I32LeS => 0x4C
    Instr::I32LeU => 0x4D
    Instr::I32GeS => 0x4E
    Instr::I32GeU => 0x4F
    Instr::I64Eqz => 0x50
    Instr::I64Eq => 0x51
    Instr::I64Ne => 0x52
    Instr::I64LtS => 0x53
    Instr::I64LtU => 0x54
    Instr::I64GtS => 0x55
    Instr::I64GtU => 0x56
    Instr::I64LeS => 0x57
    Instr::I64LeU => 0x58
    Instr::I64GeS => 0x59
    Instr::I64GeU => 0x5A
    Instr::F32Eq => 0x5B
    Instr::F32Ne => 0x5C
    Instr::F32Lt => 0x5D
    Instr::F32Gt => 0x5E
    Instr::F32Le => 0x5F
    Instr::F32Ge => 0x60
    Instr::F64Eq => 0x61
    Instr::F64Ne => 0x62
    Instr::F64Lt => 0x63
    Instr::F64Gt => 0x64
    Instr::F64Le => 0x65
    Instr::F64Ge => 0x66
    Instr::I32Clz => 0x67
    Instr::I32Ctz => 0x68
    Instr::I32Popcnt => 0x69
    Instr::I32Add => 0x6A
    Instr::I32Sub => 0x6B
    Instr::I32Mul => 0x6C
    Instr::I32DivS => 0x6D
    Instr::I32DivU => 0x6E
    Instr::I32RemS => 0x6F
    Instr::I32RemU => 0x70
    Instr::I32And => 0x71
    Instr::I32Or => 0x72
    Instr::I32Xor => 0x73
    Instr::I32Shl => 0x74
    Instr::I32ShrS => 0x75
    Instr::I32ShrU => 0x76
    Instr::I32Rotl => 0x77
    Instr::I32Rotr => 0x78
    Instr::I64Clz => 0x79
    Instr::I64Ctz => 0x7A
    Instr::I64Popcnt => 0x7B
    Instr::I64Add => 0x7C
    Instr::I64Sub => 0x7D
    Instr::I64Mul => 0x7E
    Instr::I64DivS => 0x7F
    Instr::I64DivU => 0x80
    Instr::I64RemS => 0x81
    Instr::I64RemU => 0x82
    Instr::I64And => 0x83
    Instr::I64Or => 0x84
    Instr::I64Xor => 0x85
    Instr::I64Shl => 0x86
    Instr::I64ShrS => 0x87
    Instr::I64ShrU => 0x88
    Instr::I64Rotl => 0x89
    Instr::I64Rotr => 0x8A
    _ => encode_num_opcode_hi(ins)
  }
}

fn encode_num_opcode_hi(ins : Instr) -> Int {
  match ins {
    Instr::F32Abs => 0x8B
    Instr::F32Neg => 0x8C
    Instr::F32Ceil => 0x8D
    Instr::F32Floor => 0x8E
    Instr::F32Trunc => 0x8F
    Instr::F32Nearest => 0x90
    Instr::F32Sqrt => 0x91
    Instr::F32Add => 0x92
    Instr::F32Sub => 0x93
    Instr::F32Mul => 0x94
    Instr::F32Div => 0x95
    Instr::F32Min => 0x96
    Instr::F32Max => 0x97
    Instr::F32Copysign => 0x98
    Instr::F64Abs => 0x99
    Instr::F64Neg => 0x9A
    Instr::F64Ceil => 0x9B
    Instr::F64Floor => 0x9C
    Instr::F64Trunc => 0x9D
    Instr::F64Nearest => 0x9E
    Instr::F64Sqrt => 0x9F
    Instr::F64Add => 0xA0
    Instr::F64Sub => 0xA1
    Instr::F64Mul => 0xA2
    Instr::F64Div => 0xA3
    Instr::F64Min => 0xA4
    Instr::F64Max => 0xA5
    Instr::F64Copysign => 0xA6
    Instr::I32WrapI64 => 0xA7
    Instr::I32TruncF32S => 0xA8
    Instr::I32TruncF32U => 0xA9
    Instr::I32TruncF64S => 0xAA
    Instr::I32TruncF64U => 0xAB
    Instr::I64ExtendI32S => 0xAC
    Instr::I64ExtendI32U => 0xAD
    Instr::I64TruncF32S => 0xAE
    Instr::I64TruncF32U => 0xAF
    Instr::I64TruncF64S => 0xB0
    Instr::I64TruncF64U => 0xB1
    Instr::F32ConvertI32S => 0xB2
    Instr::F32ConvertI32U => 0xB3
    Instr::F32ConvertI64S => 0xB4
    Instr::F32ConvertI64U => 0xB5
    Instr::F32DemoteF64 => 0xB6
    Instr::F64ConvertI32S => 0xB7
    Instr::F64ConvertI32U => 0xB8
    Instr::F64ConvertI64S => 0xB9
    Instr::F64ConvertI64U => 0xBA
    Instr::F64PromoteF32 => 0xBB
    Instr::I32ReinterpretF32 => 0xBC
    Instr::I64ReinterpretF64 => 0xBD
    Instr::F32ReinterpretI32 => 0xBE
    Instr::F64ReinterpretI64 => 0xBF
    Instr::I32Extend8S => 0xC0
    Instr::I32Extend16S => 0xC1
    Instr::I64Extend8S => 0xC2
    Instr::I64Extend16S => 0xC3
    Instr::I64Extend32S => 0xC4
    _ => -1
  }
}

fn encode_ext_instr(w : ByteWriter, ins : Instr) -> Int {
  match ins {
    Instr::RefNull(rt) => {
      w.push_byte(0xD0)
      w.push_byte(ref_type_code(rt))
    }
    Instr::RefIsNull => w.push_byte(0xD1)
    Instr::RefFunc(idx) => {
      w.push_byte(0xD2)
      w.write_varuint32(idx.to_int64())
    }
    Instr::I32TruncSatF32S => {
      w.push_byte(0xFC)
      w.write_varuint32(0L)
    }
    Instr::I32TruncSatF32U => {
      w.push_byte(0xFC)
      w.write_varuint32(1L)
    }
    Instr::I32TruncSatF64S => {
      w.push_byte(0xFC)
      w.write_varuint32(2L)
    }
    Instr::I32TruncSatF64U => {
      w.push_byte(0xFC)
      w.write_varuint32(3L)
    }
    Instr::I64TruncSatF32S => {
      w.push_byte(0xFC)
      w.write_varuint32(4L)
    }
    Instr::I64TruncSatF32U => {
      w.push_byte(0xFC)
      w.write_varuint32(5L)
    }
    Instr::I64TruncSatF64S => {
      w.push_byte(0xFC)
      w.write_varuint32(6L)
    }
    Instr::I64TruncSatF64U => {
      w.push_byte(0xFC)
      w.write_varuint32(7L)
    }
    Instr::MemoryInit(didx, midx) => {
      w.push_byte(0xFC)
      w.write_varuint32(8L)
      w.write_varuint32(didx.to_int64())
      w.write_varuint32(midx.to_int64())
    }
    Instr::DataDrop(didx) => {
      w.push_byte(0xFC)
      w.write_varuint32(9L)
      w.write_varuint32(didx.to_int64())
    }
    Instr::MemoryCopy(dst, src) => {
      w.push_byte(0xFC)
      w.write_varuint32(10L)
      w.write_varuint32(dst.to_int64())
      w.write_varuint32(src.to_int64())
    }
    Instr::MemoryFill(midx) => {
      w.push_byte(0xFC)
      w.write_varuint32(11L)
      w.write_varuint32(midx.to_int64())
    }
    Instr::TableInit(eidx, tidx) => {
      w.push_byte(0xFC)
      w.write_varuint32(12L)
      w.write_varuint32(eidx.to_int64())
      w.write_varuint32(tidx.to_int64())
    }
    Instr::ElemDrop(eidx) => {
      w.push_byte(0xFC)
      w.write_varuint32(13L)
      w.write_varuint32(eidx.to_int64())
    }
    Instr::TableCopy(dst, src) => {
      w.push_byte(0xFC)
      w.write_varuint32(14L)
      w.write_varuint32(dst.to_int64())
      w.write_varuint32(src.to_int64())
    }
    Instr::TableGrow(tidx) => {
      w.push_byte(0xFC)
      w.write_varuint32(15L)
      w.write_varuint32(tidx.to_int64())
    }
    Instr::TableSize(tidx) => {
      w.push_byte(0xFC)
      w.write_varuint32(16L)
      w.write_varuint32(tidx.to_int64())
    }
    Instr::TableFill(tidx) => {
      w.push_byte(0xFC)
      w.write_varuint32(17L)
      w.write_varuint32(tidx.to_int64())
    }
    Instr::V128Const(bs) => {
      if bs.length() != 16 {
        return 1
      }
      w.push_byte(0xFD)
      w.write_varuint32(12L)
      w.push_bytes(bs)
    }
    Instr::I8x16Shuffle(lanes) => {
      if lanes.length() != 16 {
        return 2
      }
      w.push_byte(0xFD)
      w.write_varuint32(13L)
      w.push_bytes(lanes)
    }
    Instr::SimdMem(sub, ma) => {
      w.push_byte(0xFD)
      w.write_varuint32(sub.to_int64())
      encode_memarg(w, ma)
    }
    Instr::SimdMemLane(sub, ma, lane) => {
      w.push_byte(0xFD)
      w.write_varuint32(sub.to_int64())
      encode_memarg(w, ma)
      w.push_byte(lane)
    }
    Instr::SimdLane(sub, lane) => {
      w.push_byte(0xFD)
      w.write_varuint32(sub.to_int64())
      w.push_byte(lane)
    }
    Instr::SimdOp(sub) => {
      w.push_byte(0xFD)
      w.write_varuint32(sub.to_int64())
    }
    _ => ()
  }
  0
}

fn encode_instr_raw(w : ByteWriter, ins : Instr) -> Int {
  match ins {
    Instr::LocalGet(idx) => {
      w.push_byte(0x20)
      w.write_varuint32(idx.to_int64())
      return 0
    }
    Instr::LocalSet(idx) => {
      w.push_byte(0x21)
      w.write_varuint32(idx.to_int64())
      return 0
    }
    Instr::LocalTee(idx) => {
      w.push_byte(0x22)
      w.write_varuint32(idx.to_int64())
      return 0
    }
    Instr::I32Const(v) => {
      w.push_byte(0x41)
      w.write_varint32(v)
      return 0
    }
    Instr::I64Const(v) => {
      w.push_byte(0x42)
      w.write_varint64(v)
      return 0
    }
    Instr::F32Const(bits) => {
      w.push_byte(0x43)
      w.write_u32_le(bits)
      return 0
    }
    Instr::F64Const(bits) => {
      w.push_byte(0x44)
      w.write_u64_le(bits)
      return 0
    }
    Instr::End => {
      w.push_byte(0x0B)
      return 0
    }
    Instr::Call(idx) => {
      w.push_byte(0x10)
      w.write_varuint32(idx.to_int64())
      return 0
    }
    Instr::Br(l) => {
      w.push_byte(0x0C)
      w.write_varuint32(l.to_int64())
      return 0
    }
    Instr::BrIf(l) => {
      w.push_byte(0x0D)
      w.write_varuint32(l.to_int64())
      return 0
    }
    Instr::Drop => {
      w.push_byte(0x1A)
      return 0
    }
    Instr::Block(bt) => {
      w.push_byte(0x02)
      encode_block_type(w, bt)
      return 0
    }
    Instr::Loop(bt) => {
      w.push_byte(0x03)
      encode_block_type(w, bt)
      return 0
    }
    Instr::If(bt) => {
      w.push_byte(0x04)
      encode_block_type(w, bt)
      return 0
    }
    Instr::Else => {
      w.push_byte(0x05)
      return 0
    }
    Instr::Return => {
      w.push_byte(0x0F)
      return 0
    }
    Instr::Unreachable => {
      w.push_byte(0x00)
      return 0
    }
    Instr::Nop => {
      w.push_byte(0x01)
      return 0
    }
    Instr::BrTable(targets, def_t) => {
      w.push_byte(0x0E)
      w.write_varuint32(targets.length().to_int64())
      let mut i = 0
      while i < targets.length() {
        w.write_varuint32(targets[i].to_int64())
        i = i + 1
      }
      w.write_varuint32(def_t.to_int64())
      return 0
    }
    Instr::CallIndirect(tidx, tbl) => {
      w.push_byte(0x11)
      w.write_varuint32(tidx.to_int64())
      w.write_varuint32(tbl.to_int64())
      return 0
    }
    Instr::Select => {
      w.push_byte(0x1B)
      return 0
    }
    Instr::TypedSelect(ts) => {
      w.push_byte(0x1C)
      w.write_varuint32(ts.length().to_int64())
      let mut i = 0
      while i < ts.length() {
        w.push_byte(val_type_code(ts[i]))
        i = i + 1
      }
      return 0
    }
    Instr::GlobalGet(idx) => {
      w.push_byte(0x23)
      w.write_varuint32(idx.to_int64())
      return 0
    }
    Instr::GlobalSet(idx) => {
      w.push_byte(0x24)
      w.write_varuint32(idx.to_int64())
      return 0
    }
    Instr::TableGet(idx) => {
      w.push_byte(0x25)
      w.write_varuint32(idx.to_int64())
      return 0
    }
    Instr::TableSet(idx) => {
      w.push_byte(0x26)
      w.write_varuint32(idx.to_int64())
      return 0
    }
    _ => ()
  }
  let num_op = encode_num_opcode(ins)
  if num_op >= 0 {
    w.push_byte(num_op)
    return 0
  }
  if encode_mem_instr(w, ins) {
    return 0
  }
  encode_ext_instr(w, ins)
}

fn encode_expr(w : ByteWriter, instrs : Array[Instr]) -> Result[Unit, WasmError] {
  let n = instrs.length()
  let mut i = 0
  while i < n {
    let rc = encode_instr_raw(w, instrs[i])
    if rc != 0 {
      if rc == 1 {
        return Err(WasmError::EncodeError("v128.const requires 16 bytes"))
      }
      return Err(WasmError::EncodeError("i8x16.shuffle requires 16 lane bytes"))
    }
    i = i + 1
  }
  Ok(())
}

fn module_needs_data_count(m : Module) -> Bool {
  match m.data_count {
    Some(_) => return true
    None => ()
  }
  let mut i = 0
  while i < m.codes.length() {
    let body = m.codes[i].body
    let mut j = 0
    while j < body.length() {
      match body[j] {
        Instr::MemoryInit(_, _) => return true
        Instr::DataDrop(_) => return true
        _ => ()
      }
      j = j + 1
    }
    i = i + 1
  }
  false
}

fn emit_custom_sections_at(
  out : ByteWriter,
  customs : Array[CustomSection],
  rank : Int,
) -> Unit {
  let n = customs.length()
  if n == 0 {
    return ()
  }
  let mut ci = 0
  while ci < n {
    let cs = customs[ci]
    let matches = if rank == 0 {
      cs.order_after <= 0
    } else if rank == 12 {
      cs.order_after >= 12
    } else {
      cs.order_after == rank
    }
    if matches {
      let s = ByteWriter::new()
      s.write_name(cs.name)
      s.push_bytes(cs.data)
      out.write_section(0, s.to_bytes())
    }
    ci = ci + 1
  }
}

///| Encode a `Module` into canonical `.wasm` binary bytes.
pub fn encode_module(m : Module) -> Result[Bytes, WasmError] {
  let out = ByteWriter::with_capacity(512)
  // Header: \0asm + version
  out.push_byte(0x00)
  out.push_byte(0x61)
  out.push_byte(0x73)
  out.push_byte(0x6D)
  out.write_u32_le(m.version)

  emit_custom_sections_at(out, m.custom_sections, 0)

  // 1. Type section
  if m.types.length() > 0 {
    let s = ByteWriter::new()
    s.write_varuint32(m.types.length().to_int64())
    let mut i = 0
    while i < m.types.length() {
      let ft = m.types[i]
      s.push_byte(0x60)
      s.write_varuint32(ft.params.length().to_int64())
      let mut j = 0
      while j < ft.params.length() {
        s.push_byte(val_type_code(ft.params[j]))
        j = j + 1
      }
      s.write_varuint32(ft.results.length().to_int64())
      let mut k = 0
      while k < ft.results.length() {
        s.push_byte(val_type_code(ft.results[k]))
        k = k + 1
      }
      i = i + 1
    }
    out.write_section(1, s.to_bytes())
  }
  emit_custom_sections_at(out, m.custom_sections, 1)

  // 2. Import section
  if m.imports.length() > 0 {
    let s = ByteWriter::new()
    s.write_varuint32(m.imports.length().to_int64())
    let mut i = 0
    while i < m.imports.length() {
      let imp = m.imports[i]
      s.write_name(imp.module_name)
      s.write_name(imp.name)
      match imp.desc {
        ImportDesc::Func(idx) => {
          s.push_byte(0x00)
          s.write_varuint32(idx.to_int64())
        }
        ImportDesc::Table(tt) => {
          s.push_byte(0x01)
          s.push_byte(ref_type_code(tt.elem_type))
          encode_limits(s, tt.limits)
        }
        ImportDesc::Memory(mt) => {
          s.push_byte(0x02)
          encode_limits(s, mt.limits)
        }
        ImportDesc::Global(gt) => {
          s.push_byte(0x03)
          s.push_byte(val_type_code(gt.val_type))
          s.push_byte(if gt.mutable { 1 } else { 0 })
        }
      }
      i = i + 1
    }
    out.write_section(2, s.to_bytes())
  }
  emit_custom_sections_at(out, m.custom_sections, 2)

  // 3. Function section
  if m.functions.length() > 0 {
    let s = ByteWriter::new()
    s.write_varuint32(m.functions.length().to_int64())
    let mut i = 0
    while i < m.functions.length() {
      s.write_varuint32(m.functions[i].to_int64())
      i = i + 1
    }
    out.write_section(3, s.to_bytes())
  }
  emit_custom_sections_at(out, m.custom_sections, 3)

  // 4. Table section
  if m.tables.length() > 0 {
    let s = ByteWriter::new()
    s.write_varuint32(m.tables.length().to_int64())
    let mut i = 0
    while i < m.tables.length() {
      let tt = m.tables[i]
      s.push_byte(ref_type_code(tt.elem_type))
      encode_limits(s, tt.limits)
      i = i + 1
    }
    out.write_section(4, s.to_bytes())
  }
  emit_custom_sections_at(out, m.custom_sections, 4)

  // 5. Memory section
  if m.memories.length() > 0 {
    let s = ByteWriter::new()
    s.write_varuint32(m.memories.length().to_int64())
    let mut i = 0
    while i < m.memories.length() {
      encode_limits(s, m.memories[i].limits)
      i = i + 1
    }
    out.write_section(5, s.to_bytes())
  }
  emit_custom_sections_at(out, m.custom_sections, 5)

  // 6. Global section
  if m.globals.length() > 0 {
    let s = ByteWriter::new()
    s.write_varuint32(m.globals.length().to_int64())
    let mut i = 0
    while i < m.globals.length() {
      let g = m.globals[i]
      s.push_byte(val_type_code(g.global_type.val_type))
      s.push_byte(if g.global_type.mutable { 1 } else { 0 })
      match encode_expr(s, g.init) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      i = i + 1
    }
    out.write_section(6, s.to_bytes())
  }
  emit_custom_sections_at(out, m.custom_sections, 6)

  // 7. Export section
  if m.exports.length() > 0 {
    let s = ByteWriter::new()
    s.write_varuint32(m.exports.length().to_int64())
    let mut i = 0
    while i < m.exports.length() {
      let ex = m.exports[i]
      s.write_name(ex.name)
      s.push_byte(export_kind_code(ex.kind))
      s.write_varuint32(ex.index.to_int64())
      i = i + 1
    }
    out.write_section(7, s.to_bytes())
  }
  emit_custom_sections_at(out, m.custom_sections, 7)

  // 8. Start section
  match m.start {
    Some(fidx) => {
      let s = ByteWriter::new()
      s.write_varuint32(fidx.to_int64())
      out.write_section(8, s.to_bytes())
    }
    None => ()
  }
  emit_custom_sections_at(out, m.custom_sections, 8)

  // 9. Element section
  if m.elements.length() > 0 {
    let s = ByteWriter::new()
    s.write_varuint32(m.elements.length().to_int64())
    let mut i = 0
    while i < m.elements.length() {
      let seg = m.elements[i]
      let uses_exprs = match seg.items {
        ElemItems::FuncIndices(_) => false
        ElemItems::Exprs(_) => true
      }
      let flags = match seg.mode {
        ElemMode::Active(tidx, _) =>
        if tidx == 0 && !uses_exprs {
          0
        } else if tidx == 0 && uses_exprs && ref_type_code(seg.elem_type) == 0x70 {
          4
        } else if !uses_exprs {
          2
        } else {
          6
        }
        ElemMode::Passive => if uses_exprs { 5 } else { 1 }
        ElemMode::Declarative => if uses_exprs { 7 } else { 3 }
      }
      s.write_varuint32(flags.to_int64())
      match seg.mode {
        ElemMode::Active(tidx, offset_expr) => {
          if (flags & 2) != 0 {
            s.write_varuint32(tidx.to_int64())
          }
          match encode_expr(s, offset_expr) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        _ => ()
      }
      if flags != 0 && flags != 4 {
        if !uses_exprs {
          s.push_byte(0x00)
        } else {
          s.push_byte(ref_type_code(seg.elem_type))
        }
      }
      match seg.items {
        ElemItems::FuncIndices(idxs) => {
          s.write_varuint32(idxs.length().to_int64())
          let mut j = 0
          while j < idxs.length() {
            s.write_varuint32(idxs[j].to_int64())
            j = j + 1
          }
        }
        ElemItems::Exprs(exprs) => {
          s.write_varuint32(exprs.length().to_int64())
          let mut j = 0
          while j < exprs.length() {
            match encode_expr(s, exprs[j]) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            j = j + 1
          }
        }
      }
      i = i + 1
    }
    out.write_section(9, s.to_bytes())
  }
  emit_custom_sections_at(out, m.custom_sections, 9)

  // 12. DataCount section (must precede Code section)
  if module_needs_data_count(m) {
    let dc = match m.data_count {
      Some(v) => v
      None => m.data.length()
    }
    let s = ByteWriter::new()
    s.write_varuint32(dc.to_int64())
    out.write_section(12, s.to_bytes())
  }
  emit_custom_sections_at(out, m.custom_sections, 10)

  // 10. Code section
  if m.codes.length() > 0 {
    let s = ByteWriter::with_capacity(4096)
    s.write_varuint32(m.codes.length().to_int64())
    let bw = ByteWriter::with_capacity(1024)
    let mut i = 0
    while i < m.codes.length() {
      let fb = m.codes[i]
      bw.len = 0
      bw.write_varuint32(fb.locals.length().to_int64())
      let mut j = 0
      while j < fb.locals.length() {
        bw.write_varuint32(fb.locals[j].count.to_int64())
        bw.push_byte(val_type_code(fb.locals[j].val_type))
        j = j + 1
      }
      match encode_expr(bw, fb.body) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      s.write_varuint32(bw.len.to_int64())
      s.push_bytes_range(bw.buf, 0, bw.len)
      i = i + 1
    }
    out.write_section(10, s.to_bytes())
  }
  emit_custom_sections_at(out, m.custom_sections, 11)

  // 11. Data section
  if m.data.length() > 0 {
    let s = ByteWriter::new()
    s.write_varuint32(m.data.length().to_int64())
    let mut i = 0
    while i < m.data.length() {
      let seg = m.data[i]
      match seg.mode {
        DataMode::Active(midx, expr) => {
          if midx == 0 {
            s.write_varuint32(0L)
          } else {
            s.write_varuint32(2L)
            s.write_varuint32(midx.to_int64())
          }
          match encode_expr(s, expr) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
        }
        DataMode::Passive => s.write_varuint32(1L)
      }
      s.write_varuint32(seg.data.length().to_int64())
      s.push_bytes(seg.data)
      i = i + 1
    }
    out.write_section(11, s.to_bytes())
  }
  emit_custom_sections_at(out, m.custom_sections, 12)

  Ok(out.to_bytes())
}

///| Programmatic WebAssembly module builder.
pub struct ModuleBuilder {
  m : Module
  mut imported_funcs : Int
  mut imported_tables : Int
  mut imported_memories : Int
  mut imported_globals : Int
  mut start_opt : Option[Int]
}

///| Create a new `ModuleBuilder`.
pub fn ModuleBuilder::new() -> ModuleBuilder {
  ModuleBuilder::{
    m: Module::empty(),
    imported_funcs: 0,
    imported_tables: 0,
    imported_memories: 0,
    imported_globals: 0,
    start_opt: None,
  }
}

///| Add a function type and return its type index.
pub fn ModuleBuilder::add_type(
  self : ModuleBuilder,
  params : Array[ValType],
  results : Array[ValType],
) -> Int {
  let idx = self.m.types.length()
  self.m.types.push(FuncType::{ params: params, results: results })
  idx
}

///| Add an import entry.
pub fn ModuleBuilder::add_import(
  self : ModuleBuilder,
  module_name : String,
  name : String,
  desc : ImportDesc,
) -> Unit {
  match desc {
    ImportDesc::Func(_) => self.imported_funcs = self.imported_funcs + 1
    ImportDesc::Table(_) => self.imported_tables = self.imported_tables + 1
    ImportDesc::Memory(_) => self.imported_memories = self.imported_memories + 1
    ImportDesc::Global(_) => self.imported_globals = self.imported_globals + 1
  }
  self.m.imports.push(Import::{ module_name: module_name, name: name, desc: desc })
}

///| Add a defined function with its type index, locals, and instruction body. Returns its function index.
pub fn ModuleBuilder::add_func(
  self : ModuleBuilder,
  type_idx : Int,
  locals : Array[LocalGroup],
  body : Array[Instr],
) -> Int {
  let idx = self.imported_funcs + self.m.functions.length()
  self.m.functions.push(type_idx)
  self.m.codes.push(FuncBody::{ locals: locals, body: body })
  idx
}

///| Add a table definition. Returns its table index.
pub fn ModuleBuilder::add_table(self : ModuleBuilder, t : TableType) -> Int {
  let idx = self.imported_tables + self.m.tables.length()
  self.m.tables.push(t)
  idx
}

///| Add a memory definition. Returns its memory index.
pub fn ModuleBuilder::add_memory(self : ModuleBuilder, mem : MemType) -> Int {
  let idx = self.imported_memories + self.m.memories.length()
  self.m.memories.push(mem)
  idx
}

///| Add a global definition. Returns its global index.
pub fn ModuleBuilder::add_global(
  self : ModuleBuilder,
  gt : GlobalType,
  init : Array[Instr],
) -> Int {
  let idx = self.imported_globals + self.m.globals.length()
  self.m.globals.push(Global::{ global_type: gt, init: init })
  idx
}

///| Add an export entry.
pub fn ModuleBuilder::add_export(
  self : ModuleBuilder,
  name : String,
  kind : ExportKind,
  index : Int,
) -> Unit {
  self.m.exports.push(Export::{ name: name, kind: kind, index: index })
}

///| Set the start function index.
pub fn ModuleBuilder::set_start(self : ModuleBuilder, func_idx : Int) -> Unit {
  self.start_opt = Some(func_idx)
}

///| Add an element segment.
pub fn ModuleBuilder::add_element(self : ModuleBuilder, seg : ElemSegment) -> Int {
  let idx = self.m.elements.length()
  self.m.elements.push(seg)
  idx
}

///| Add a data segment.
pub fn ModuleBuilder::add_data(self : ModuleBuilder, seg : DataSegment) -> Int {
  let idx = self.m.data.length()
  self.m.data.push(seg)
  idx
}

///| Add a custom section.
pub fn ModuleBuilder::add_custom(self : ModuleBuilder, name : String, data : Bytes) -> Unit {
  self.m.custom_sections.push(CustomSection::{ name: name, data: data, order_after: 12 })
}

///| Finish building and return the `Module`.
pub fn ModuleBuilder::build(self : ModuleBuilder) -> Module {
  Module::{
    version: self.m.version,
    types: self.m.types,
    imports: self.m.imports,
    functions: self.m.functions,
    tables: self.m.tables,
    memories: self.m.memories,
    globals: self.m.globals,
    exports: self.m.exports,
    start: self.start_opt,
    elements: self.m.elements,
    data_count: self.m.data_count,
    codes: self.m.codes,
    data: self.m.data,
    custom_sections: self.m.custom_sections,
    section_order: self.m.section_order,
  }
}

///| Finish building and encode directly to `.wasm` bytes.
pub fn ModuleBuilder::encode(self : ModuleBuilder) -> Result[Bytes, WasmError] {
  encode_module(self.build())
}
