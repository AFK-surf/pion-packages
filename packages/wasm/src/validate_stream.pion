///| Single-pass streaming WebAssembly 1.0/2.0 binary validator (zero AST allocation).

let empty_type_ids : Array[Int] = []
let single_vt_i32 : Array[Int] = [0]
let single_vt_i64 : Array[Int] = [1]
let single_vt_f32 : Array[Int] = [2]
let single_vt_f64 : Array[Int] = [3]
let single_vt_v128 : Array[Int] = [4]
let single_vt_funcref : Array[Int] = [5]
let single_vt_externref : Array[Int] = [6]

// Encodes (is_store << 8) | (natural_align << 4) | val_type for 0x28..0x3E.
let mem_op_table : Array[Int] = [
  0x020, 0x031, 0x022, 0x033, // 0x28..0x2B
  0x000, 0x000, 0x010, 0x010, // 0x2C..0x2F
  0x001, 0x001, 0x011, 0x011, 0x021, 0x021, // 0x30..0x35
  0x120, 0x131, 0x122, 0x133, // 0x36..0x39
  0x100, 0x110, 0x101, 0x111, 0x121, // 0x3A..0x3E
]

// Encodes (is_bin << 8) | (param_vt << 4) | result_vt for 0x45..0xC4 (128 ops).
let num_op_table : Array[Int] = [
  0x000, // 0x45 i32.eqz
  0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, // 0x46..0x4F
  0x010, // 0x50 i64.eqz
  0x110, 0x110, 0x110, 0x110, 0x110, 0x110, 0x110, 0x110, 0x110, 0x110, // 0x51..0x5A
  0x120, 0x120, 0x120, 0x120, 0x120, 0x120, // 0x5B..0x60
  0x130, 0x130, 0x130, 0x130, 0x130, 0x130, // 0x61..0x66
  0x000, 0x000, 0x000, // 0x67..0x69
  0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, 0x100, // 0x6A..0x78
  0x011, 0x011, 0x011, // 0x79..0x7B
  0x111, 0x111, 0x111, 0x111, 0x111, 0x111, 0x111, 0x111, 0x111, 0x111, 0x111, 0x111, 0x111, 0x111, 0x111, // 0x7C..0x8A
  0x022, 0x022, 0x022, 0x022, 0x022, 0x022, 0x022, // 0x8B..0x91
  0x122, 0x122, 0x122, 0x122, 0x122, 0x122, 0x122, // 0x92..0x98
  0x033, 0x033, 0x033, 0x033, 0x033, 0x033, 0x033, // 0x99..0x9F
  0x133, 0x133, 0x133, 0x133, 0x133, 0x133, 0x133, // 0xA0..0xA6
  0x010, // 0xA7 i32.wrap_i64
  0x020, 0x020, 0x030, 0x030, // 0xA8..0xAB
  0x001, 0x001, 0x021, 0x021, 0x031, 0x031, // 0xAC..0xB1
  0x002, 0x002, 0x012, 0x012, 0x032, // 0xB2..0xB6
  0x003, 0x003, 0x013, 0x013, 0x023, // 0xB7..0xBB
  0x020, 0x031, 0x002, 0x013, // 0xBC..0xBF
  0x000, 0x000, // 0xC0..0xC1
  0x011, 0x011, 0x011, // 0xC2..0xC4
]

fn skip_name(r : ByteReader) -> Result[Unit, WasmError] {
  let n = r.read_u32_as_int_raw()
  if n < 0 {
    return Err(r.take_err())
  }
  let start = r.pos
  if n > r.end - start {
    return Err(WasmError::UnexpectedEof(start))
  }
  if !validate_utf8_range(r.data, start, start + n) {
    return Err(WasmError::InvalidUtf8(start))
  }
  r.pos = start + n
  Ok(())
}

fn stream_check_memarg_raw_slow(
  ctx : ModuleContext,
  st : ValState,
  r : ByteReader,
  natural_align : Int,
) -> Bool {
  let off = r.pos
  let raw_align = r.read_varuint32_raw()
  if raw_align < 0L {
    st.fail(r.take_err())
    return false
  }
  if raw_align >= 64L {
    st.fail(WasmError::InvalidImmediate(off, "alignment too large"))
    return false
  }
  let align = raw_align.to_int()
  if r.read_varuint32_raw() < 0L {
    st.fail(r.take_err())
    return false
  }
  if ctx.memories.length() == 0 {
    st.fail(WasmError::ValidationError("memory index out of bounds"))
    return false
  }
  if align > natural_align {
    st.fail(
      WasmError::ValidationError(
        "alignment " + align.to_string() + " exceeds natural alignment " + natural_align.to_string(),
      ),
    )
    return false
  }
  true
}

fn stream_check_memarg_raw(
  ctx : ModuleContext,
  st : ValState,
  r : ByteReader,
  natural_align : Int,
) -> Bool {
  let p = r.pos
  if p + 1 < r.end {
    let b0 = r.data[p].to_int()
    let b1 = r.data[p + 1].to_int()
    if b0 <= natural_align && b1 < 0x80 && ctx.memories.length() > 0 {
      r.pos = p + 2
      return true
    }
  }
  stream_check_memarg_raw_slow(ctx, st, r, natural_align)
}

fn stream_check_memarg(
  ctx : ModuleContext,
  r : ByteReader,
  natural_align : Int,
) -> Result[Unit, WasmError] {
  let off = r.pos
  let raw_align = r.read_varuint32_raw()
  if raw_align < 0L {
    return Err(r.take_err())
  }
  if raw_align >= 64L {
    return Err(WasmError::InvalidImmediate(off, "alignment too large"))
  }
  let align = raw_align.to_int()
  if r.read_varuint32_raw() < 0L {
    return Err(r.take_err())
  }
  if ctx.memories.length() == 0 {
    return Err(WasmError::ValidationError("memory index out of bounds"))
  }
  if align > natural_align {
    return Err(
      WasmError::ValidationError(
        "alignment " + align.to_string() + " exceeds natural alignment " + natural_align.to_string(),
      ),
    )
  }
  Ok(())
}

fn stream_push_block_raw(
  ctx : ModuleContext,
  st : ValState,
  r : ByteReader,
  opcode : Int,
  max_ctrl : Int,
) -> Bool {
  if st.ctrl_len >= max_ctrl {
    st.fail(WasmError::LimitExceeded("max_control_depth exceeded"))
    return false
  }
  let off = r.pos
  if off >= r.end {
    st.fail(WasmError::UnexpectedEof(off))
    return false
  }
  let b = r.data[off].to_int()
  if b == 0x40 {
    r.pos = off + 1
    return st.push_ctrl_raw(opcode, empty_type_ids, empty_type_ids)
  }
  if b == 0x7F {
    r.pos = off + 1
    return st.push_ctrl_raw(opcode, empty_type_ids, single_vt_i32)
  }
  if b == 0x7E {
    r.pos = off + 1
    return st.push_ctrl_raw(opcode, empty_type_ids, single_vt_i64)
  }
  if b == 0x7D {
    r.pos = off + 1
    return st.push_ctrl_raw(opcode, empty_type_ids, single_vt_f32)
  }
  if b == 0x7C {
    r.pos = off + 1
    return st.push_ctrl_raw(opcode, empty_type_ids, single_vt_f64)
  }
  if b == 0x7B {
    r.pos = off + 1
    return st.push_ctrl_raw(opcode, empty_type_ids, single_vt_v128)
  }
  if b == 0x70 {
    r.pos = off + 1
    return st.push_ctrl_raw(opcode, empty_type_ids, single_vt_funcref)
  }
  if b == 0x6F {
    r.pos = off + 1
    return st.push_ctrl_raw(opcode, empty_type_ids, single_vt_externref)
  }
  let idx = r.read_varint33_raw()
  if r.failed {
    st.fail(r.take_err())
    return false
  }
  if idx < 0L || idx > 2147483647L {
    st.fail(WasmError::InvalidType(off, "invalid block type s33: " + idx.to_string()))
    return false
  }
  let ti = idx.to_int()
  if ti < 0 || ti >= ctx.types.length() {
    st.fail(WasmError::ValidationError("block type index out of bounds"))
    return false
  }
  let in_t = ctx.type_params[ti]
  if !st.pop_vals_raw(in_t) {
    return false
  }
  st.push_ctrl_raw(opcode, in_t, ctx.type_results[ti])
}

fn validate_const_expr_stream(
  r : ByteReader,
  func_count : Int,
  globals : Array[GlobalType],
  max_global_idx : Int,
  declared_funcs : Array[Bool],
  expect_vt : Int,
) -> Result[Unit, WasmError] {
  let mut count = 0
  let mut top_vt = vt_unknown
  while true {
    let off = r.pos
    let op = match r.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match op {
      0x0B => break
      0x41 => {
        match r.read_varint32() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        top_vt = vt_i32
        count = count + 1
      }
      0x42 => {
        match r.read_varint64() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        top_vt = vt_i64
        count = count + 1
      }
      0x43 => {
        match r.read_u32_le() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        top_vt = vt_f32
        count = count + 1
      }
      0x44 => {
        match r.read_u64_le() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        top_vt = vt_f64
        count = count + 1
      }
      0xD0 => {
        let rt = match decode_ref_type(r) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        top_vt = ref_type_to_id(rt)
        count = count + 1
      }
      0xD2 => {
        let fidx = match r.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if fidx < 0 || fidx >= func_count {
          return Err(WasmError::ValidationError("ref.func index out of bounds in const expr"))
        }
        declared_funcs[fidx] = true
        top_vt = vt_funcref
        count = count + 1
      }
      0x23 => {
        let gidx = match r.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if gidx < 0 || gidx >= max_global_idx {
          return Err(WasmError::ValidationError("global.get index out of bounds in const expr"))
        }
        let gt = globals[gidx]
        if gt.mutable {
          return Err(WasmError::ValidationError("global.get in const expr must reference immutable global"))
        }
        top_vt = val_type_to_id(gt.val_type)
        count = count + 1
      }
      0xFD => {
        let sub = match r.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if sub != 12 {
          return Err(WasmError::ValidationError("non-constant SIMD instruction in constant expression"))
        }
        if 16 > r.end - r.pos {
          return Err(WasmError::UnexpectedEof(r.pos))
        }
        r.pos = r.pos + 16
        top_vt = vt_v128
        count = count + 1
      }
      _ => return Err(WasmError::ValidationError("non-constant instruction in constant expression at " + off.to_string()))
    }
  }
  if count != 1 || top_vt != expect_vt {
    return Err(WasmError::ValidationError("const expression result type mismatch"))
  }
  Ok(())
}

fn validate_fc_stream(
  ctx : ModuleContext,
  st : ValState,
  r : ByteReader,
  off : Int,
) -> Result[Unit, WasmError] {
  let sub = match r.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match sub {
    0 | 1 => st.pop1_push1(vt_f32, vt_i32)
    2 | 3 => st.pop1_push1(vt_f64, vt_i32)
    4 | 5 => st.pop1_push1(vt_f32, vt_i64)
    6 | 7 => st.pop1_push1(vt_f64, vt_i64)
    8 => {
      let didx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let midx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if !ctx.has_data_count {
        return Err(WasmError::ValidationError("memory.init requires DataCount section"))
      }
      if didx < 0 || didx >= ctx.num_data || midx < 0 || midx >= ctx.memories.length() {
        return Err(WasmError::ValidationError("memory.init index out of bounds"))
      }
      st.pop3_i32()
    }
    9 => {
      let didx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if !ctx.has_data_count {
        return Err(WasmError::ValidationError("data.drop requires DataCount section"))
      }
      if didx < 0 || didx >= ctx.num_data {
        return Err(WasmError::ValidationError("data.drop index out of bounds"))
      }
      Ok(())
    }
    10 => {
      let dst = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let src = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if dst < 0 || dst >= ctx.memories.length() || src < 0 || src >= ctx.memories.length() {
        return Err(WasmError::ValidationError("memory.copy index out of bounds"))
      }
      st.pop3_i32()
    }
    11 => {
      let midx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if midx < 0 || midx >= ctx.memories.length() {
        return Err(WasmError::ValidationError("memory.fill index out of bounds"))
      }
      st.pop3_i32()
    }
    12 => {
      let eidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let tidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if eidx < 0 || eidx >= ctx.elem_types.length() || tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.init index out of bounds"))
      }
      if ctx.elem_types[eidx] != ref_type_to_id(ctx.tables[tidx].elem_type) {
        return Err(WasmError::ValidationError("table.init element type mismatch"))
      }
      st.pop3_i32()
    }
    13 => {
      let eidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if eidx < 0 || eidx >= ctx.elem_types.length() {
        return Err(WasmError::ValidationError("elem.drop index out of bounds"))
      }
      Ok(())
    }
    14 => {
      let dst = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let src = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if dst < 0 || dst >= ctx.tables.length() || src < 0 || src >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.copy index out of bounds"))
      }
      if ref_type_to_id(ctx.tables[dst].elem_type) != ref_type_to_id(ctx.tables[src].elem_type) {
        return Err(WasmError::ValidationError("table.copy element type mismatch"))
      }
      st.pop3_i32()
    }
    15 => {
      let tidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.grow index out of bounds"))
      }
      st.pop2_push1(ref_type_to_id(ctx.tables[tidx].elem_type), vt_i32, vt_i32)
    }
    16 => {
      let tidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.size index out of bounds"))
      }
      st.push_val(vt_i32)
    }
    17 => {
      let tidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.fill index out of bounds"))
      }
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.pop2(vt_i32, ref_type_to_id(ctx.tables[tidx].elem_type))
    }
    _ => Err(WasmError::InvalidOpcode(off, 0xFC00 + sub))
  }
}

fn validate_fd_stream(
  ctx : ModuleContext,
  st : ValState,
  r : ByteReader,
  off : Int,
) -> Result[Unit, WasmError] {
  let sub = match r.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if (sub >= 0 && sub <= 11) || sub == 92 || sub == 93 {
    let nat = match sub {
      0 | 11 => 4
      1 | 2 | 3 | 4 | 5 | 6 | 10 | 93 => 3
      7 => 0
      8 => 1
      9 | 92 => 2
      _ => 4
    }
    match stream_check_memarg(ctx, r, nat) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if sub == 11 {
      return st.pop2(vt_i32, vt_v128)
    }
    return st.pop1_push1(vt_i32, vt_v128)
  }
  if sub == 12 {
    if 16 > r.end - r.pos {
      return Err(WasmError::UnexpectedEof(r.pos))
    }
    r.pos = r.pos + 16
    return st.push_val(vt_v128)
  }
  if sub == 13 {
    if 16 > r.end - r.pos {
      return Err(WasmError::UnexpectedEof(r.pos))
    }
    let base = r.pos
    let mut k = 0
    while k < 16 {
      if r.data[base + k].to_int() >= 32 {
        return Err(WasmError::ValidationError("i8x16.shuffle lane index >= 32"))
      }
      k = k + 1
    }
    r.pos = base + 16
    return st.pop2_push1(vt_v128, vt_v128, vt_v128)
  }
  if sub >= 21 && sub <= 34 {
    let lane = match r.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (max_lane, is_replace, lane_vt) = match sub {
      21 | 22 => (16, false, vt_i32)
      23 => (16, true, vt_i32)
      24 | 25 => (8, false, vt_i32)
      26 => (8, true, vt_i32)
      27 => (4, false, vt_i32)
      28 => (4, true, vt_i32)
      29 => (2, false, vt_i64)
      30 => (2, true, vt_i64)
      31 => (4, false, vt_f32)
      32 => (4, true, vt_f32)
      33 => (2, false, vt_f64)
      34 => (2, true, vt_f64)
      _ => return Err(WasmError::ValidationError("invalid SIMD lane op"))
    }
    if lane < 0 || lane >= max_lane {
      return Err(WasmError::ValidationError("SIMD lane index out of bounds"))
    }
    if is_replace {
      return st.pop2_push1(vt_v128, lane_vt, vt_v128)
    }
    return st.pop1_push1(vt_v128, lane_vt)
  }
  if sub >= 84 && sub <= 91 {
    let (nat, max_lane, is_store) = match sub {
      84 => (0, 16, false)
      85 => (1, 8, false)
      86 => (2, 4, false)
      87 => (3, 2, false)
      88 => (0, 16, true)
      89 => (1, 8, true)
      90 => (2, 4, true)
      91 => (3, 2, true)
      _ => return Err(WasmError::ValidationError("invalid SIMD mem lane op"))
    }
    match stream_check_memarg(ctx, r, nat) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let lane = match r.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if lane < 0 || lane >= max_lane {
      return Err(WasmError::ValidationError("SIMD lane index out of bounds"))
    }
    if is_store {
      return st.pop2(vt_i32, vt_v128)
    }
    return st.pop2_push1(vt_i32, vt_v128, vt_v128)
  }
  if !is_valid_simd_plain_op(sub) {
    return Err(WasmError::InvalidOpcode(off, 0xFD00 + sub))
  }
  validate_simd_op(st, sub)
}

fn validate_stream_mem_op_raw(
  ctx : ModuleContext,
  st : ValState,
  br : ByteReader,
  op : Int,
) -> Bool {
  if op <= 0x3E {
    let code = mem_op_table[op - 0x28]
    let nat_align = (code >> 4) & 0xF
    if !stream_check_memarg_raw(ctx, st, br, nat_align) {
      return false
    }
    let vt = code & 0xF
    if (code & 0x100) != 0 {
      return st.pop2_raw(vt_i32, vt)
    }
    return st.pop1_push1_raw(vt_i32, vt)
  }
  let zoff = br.pos
  let zb = br.read_byte_raw()
  if zb < 0 {
    st.fail(br.take_err())
    return false
  }
  if zb != 0 {
    st.fail(WasmError::InvalidImmediate(zoff, "zero byte expected"))
    return false
  }
  if ctx.memories.length() == 0 {
    if op == 0x3F {
      st.fail(WasmError::ValidationError("memory.size index out of bounds"))
    } else {
      st.fail(WasmError::ValidationError("memory.grow index out of bounds"))
    }
    return false
  }
  if op == 0x3F {
    return st.push_val_raw(vt_i32)
  }
  st.pop1_push1_raw(vt_i32, vt_i32)
}

fn validate_stream_num_op_raw(st : ValState, op : Int) -> Bool {
  let code = num_op_table[op - 0x45]
  let p = (code >> 4) & 0xF
  let r = code & 0xF
  if (code & 0x100) != 0 {
    st.pop2_push1_raw(p, p, r)
  } else {
    st.pop1_push1_raw(p, r)
  }
}

fn validate_stream_br_table_raw(
  st : ValState,
  br : ByteReader,
  max_br_table : Int,
) -> Bool {
  let count = br.read_u32_as_int_raw()
  if count < 0 {
    st.fail(br.take_err())
    return false
  }
  if count > max_br_table {
    st.fail(WasmError::LimitExceeded("max br_table targets exceeded"))
    return false
  }
  let targets : Array[Int] = Array::with_capacity(count)
  let mut ti = 0
  while ti < count {
    let v = br.read_u32_as_int_raw()
    if v < 0 {
      st.fail(br.take_err())
      return false
    }
    targets.push(v)
    ti = ti + 1
  }
  let def_t = br.read_u32_as_int_raw()
  if def_t < 0 {
    st.fail(br.take_err())
    return false
  }
  if !st.pop_val_expect_raw(vt_i32) {
    return false
  }
  if def_t >= st.ctrl_len {
    st.fail(WasmError::ValidationError("br_table default label out of bounds"))
    return false
  }
  let def_types = label_types(st.ctrl_stack[st.ctrl_len - 1 - def_t])
  let arity = def_types.length()
  ti = 0
  while ti < count {
    let l = targets[ti]
    if l < 0 || l >= st.ctrl_len {
      st.fail(WasmError::ValidationError("br_table target label out of bounds"))
      return false
    }
    let lt = label_types(st.ctrl_stack[st.ctrl_len - 1 - l])
    if lt.length() != arity {
      st.fail(WasmError::ValidationError("br_table target arity mismatch"))
      return false
    }
    if arity > 0 {
      let popped : Array[Int] = Array::with_capacity(arity)
      let mut k = arity - 1
      while k >= 0 {
        let actual = st.pop_val_raw()
        if actual == -2 {
          return false
        }
        if !stack_type_compat(actual, lt[k]) {
          st.fail(
            WasmError::ValidationError(
              "type mismatch: expected " + lt[k].to_string() + ", got " + actual.to_string(),
            ),
          )
          return false
        }
        popped.push(actual)
        k = k - 1
      }
      let mut p = popped.length() - 1
      while p >= 0 {
        if !st.push_val_raw(popped[p]) {
          return false
        }
        p = p - 1
      }
    }
    ti = ti + 1
  }
  if !st.pop_vals_raw(def_types) {
    return false
  }
  st.mark_unreachable()
  true
}

fn validate_stream_call_op_raw(
  ctx : ModuleContext,
  st : ValState,
  br : ByteReader,
  op : Int,
) -> Bool {
  if op == 0x10 {
    let fidx = br.read_u32_as_int_raw()
    if fidx < 0 {
      st.fail(br.take_err())
      return false
    }
    if fidx >= ctx.func_types.length() {
      st.fail(WasmError::ValidationError("call function index out of bounds"))
      return false
    }
    let ct = ctx.func_types[fidx]
    if !st.pop_vals_raw(ctx.type_params[ct]) {
      return false
    }
    return st.push_vals_raw(ctx.type_results[ct])
  }
  let ct = br.read_u32_as_int_raw()
  if ct < 0 {
    st.fail(br.take_err())
    return false
  }
  let tbl_idx = br.read_u32_as_int_raw()
  if tbl_idx < 0 {
    st.fail(br.take_err())
    return false
  }
  if tbl_idx >= ctx.tables.length() {
    st.fail(WasmError::ValidationError("call_indirect table index out of bounds"))
    return false
  }
  if ref_type_to_id(ctx.tables[tbl_idx].elem_type) != vt_funcref {
    st.fail(WasmError::ValidationError("call_indirect table must have funcref type"))
    return false
  }
  if ct >= ctx.types.length() {
    st.fail(WasmError::ValidationError("call_indirect type index out of bounds"))
    return false
  }
  if !st.pop_val_expect_raw(vt_i32) {
    return false
  }
  if !st.pop_vals_raw(ctx.type_params[ct]) {
    return false
  }
  st.push_vals_raw(ctx.type_results[ct])
}

fn validate_stream_end_raw(st : ValState) -> Bool {
  if !st.pop_ctrl_raw() {
    return false
  }
  let frame = st.ctrl_stack[st.ctrl_len]
  if frame.opcode == ctrl_if {
    let sl = frame.start_types.length()
    if sl != frame.end_types.length() {
      st.fail(WasmError::ValidationError("if without else has mismatched block type"))
      return false
    }
    let mut k = 0
    while k < sl {
      if frame.start_types[k] != frame.end_types[k] {
        st.fail(WasmError::ValidationError("if without else has mismatched block type"))
        return false
      }
      k = k + 1
    }
  }
  if st.ctrl_len > 0 {
    return st.push_vals_raw(frame.end_types)
  }
  true
}

fn validate_stream_branch_raw(
  st : ValState,
  br : ByteReader,
  func_results : Array[Int],
  max_br_table : Int,
  op : Int,
) -> Bool {
  if op == 0x0C {
    let l = br.read_u32_as_int_raw()
    if l < 0 {
      st.fail(br.take_err())
      return false
    }
    if l >= st.ctrl_len {
      st.fail(WasmError::ValidationError("br label out of bounds"))
      return false
    }
    let target = st.ctrl_stack[st.ctrl_len - 1 - l]
    if !st.pop_vals_raw(label_types(target)) {
      return false
    }
    st.mark_unreachable()
    return true
  }
  if op == 0x0D {
    let l = br.read_u32_as_int_raw()
    if l < 0 {
      st.fail(br.take_err())
      return false
    }
    if l >= st.ctrl_len {
      st.fail(WasmError::ValidationError("br_if label out of bounds"))
      return false
    }
    if !st.pop_val_expect_raw(vt_i32) {
      return false
    }
    let lt = label_types(st.ctrl_stack[st.ctrl_len - 1 - l])
    if !st.pop_vals_raw(lt) {
      return false
    }
    return st.push_vals_raw(lt)
  }
  if op == 0x0F {
    if !st.pop_vals_raw(func_results) {
      return false
    }
    st.mark_unreachable()
    return true
  }
  validate_stream_br_table_raw(st, br, max_br_table)
}

fn validate_stream_ctrl_op_raw(
  ctx : ModuleContext,
  st : ValState,
  br : ByteReader,
  func_results : Array[Int],
  max_ctrl : Int,
  max_br_table : Int,
  op : Int,
  off : Int,
) -> Bool {
  if op == 0x0B {
    return validate_stream_end_raw(st)
  }
  if op == 0x10 || op == 0x11 {
    return validate_stream_call_op_raw(ctx, st, br, op)
  }
  if op == 0x0C || op == 0x0D || op == 0x0E || op == 0x0F {
    return validate_stream_branch_raw(st, br, func_results, max_br_table, op)
  }
  if op == 0x02 {
    return stream_push_block_raw(ctx, st, br, ctrl_block, max_ctrl)
  }
  if op == 0x03 {
    return stream_push_block_raw(ctx, st, br, ctrl_loop, max_ctrl)
  }
  if op == 0x04 {
    if st.ctrl_len >= max_ctrl {
      st.fail(WasmError::LimitExceeded("max_control_depth exceeded"))
      return false
    }
    if !st.pop_val_expect_raw(vt_i32) {
      return false
    }
    return stream_push_block_raw(ctx, st, br, ctrl_if, max_ctrl)
  }
  if op == 0x05 {
    if !st.pop_ctrl_raw() {
      return false
    }
    let frame = st.ctrl_stack[st.ctrl_len]
    if frame.opcode != ctrl_if {
      st.fail(WasmError::ValidationError("else without matching if"))
      return false
    }
    return st.push_ctrl_raw(ctrl_else, frame.start_types, frame.end_types)
  }
  if op == 0x00 {
    st.mark_unreachable()
    return true
  }
  if op == 0x01 {
    return true
  }
  st.fail(WasmError::InvalidOpcode(off, op))
  false
}

fn validate_stream_var_param_op_raw(
  ctx : ModuleContext,
  st : ValState,
  locals : LocalTable,
  br : ByteReader,
  max_results : Int,
  op : Int,
  off : Int,
) -> Bool {
  if op == 0x20 {
    let lidx = br.read_u32_as_int_raw()
    if lidx < 0 {
      st.fail(br.take_err())
      return false
    }
    let lt = locals.get(lidx)
    if lt < 0 {
      st.fail(WasmError::ValidationError("local.get index out of bounds"))
      return false
    }
    return st.push_val_raw(lt)
  }
  if op == 0x21 {
    let lidx = br.read_u32_as_int_raw()
    if lidx < 0 {
      st.fail(br.take_err())
      return false
    }
    let lt = locals.get(lidx)
    if lt < 0 {
      st.fail(WasmError::ValidationError("local.set index out of bounds"))
      return false
    }
    return st.pop_val_expect_raw(lt)
  }
  if op == 0x22 {
    let lidx = br.read_u32_as_int_raw()
    if lidx < 0 {
      st.fail(br.take_err())
      return false
    }
    let lt = locals.get(lidx)
    if lt < 0 {
      st.fail(WasmError::ValidationError("local.tee index out of bounds"))
      return false
    }
    return st.pop1_push1_raw(lt, lt)
  }
  if op == 0x1A {
    return st.pop_val_raw() != -2
  }
  if op == 0x23 {
    let gidx = br.read_u32_as_int_raw()
    if gidx < 0 {
      st.fail(br.take_err())
      return false
    }
    if gidx >= ctx.globals.length() {
      st.fail(WasmError::ValidationError("global.get index out of bounds"))
      return false
    }
    return st.push_val_raw(val_type_to_id(ctx.globals[gidx].val_type))
  }
  if op == 0x24 {
    let gidx = br.read_u32_as_int_raw()
    if gidx < 0 {
      st.fail(br.take_err())
      return false
    }
    if gidx >= ctx.globals.length() {
      st.fail(WasmError::ValidationError("global.set index out of bounds"))
      return false
    }
    let gt = ctx.globals[gidx]
    if !gt.mutable {
      st.fail(WasmError::ValidationError("cannot global.set immutable global"))
      return false
    }
    return st.pop_val_expect_raw(val_type_to_id(gt.val_type))
  }
  if op == 0x1B {
    if !st.pop_val_expect_raw(vt_i32) {
      return false
    }
    let t1 = st.pop_val_raw()
    if t1 == -2 {
      return false
    }
    let t2 = st.pop_val_raw()
    if t2 == -2 {
      return false
    }
    if is_ref_id(t1) || is_ref_id(t2) {
      st.fail(WasmError::ValidationError("untyped select cannot operate on reference types"))
      return false
    }
    if t1 != t2 && t1 != vt_unknown && t2 != vt_unknown {
      st.fail(WasmError::ValidationError("select operand types mismatch"))
      return false
    }
    let res = if t1 == vt_unknown { t2 } else { t1 }
    return st.push_val_raw(res)
  }
  if op == 0x1C {
    let count = br.read_u32_as_int_raw()
    if count < 0 {
      st.fail(br.take_err())
      return false
    }
    if count > max_results {
      st.fail(WasmError::LimitExceeded("typed select too many types"))
      return false
    }
    let mut first_tid = vt_unknown
    let mut i = 0
    while i < count {
      let vt_off = br.pos
      let b = br.read_byte_raw()
      if b < 0 {
        st.fail(br.take_err())
        return false
      }
      let vt = match val_type_from_code(b) {
        Some(v) => v
        None => {
          st.fail(WasmError::InvalidType(vt_off, "unknown valtype byte " + b.to_string()))
          return false
        }
      }
      if i == 0 {
        first_tid = val_type_to_id(vt)
      }
      i = i + 1
    }
    if count != 1 {
      st.fail(WasmError::ValidationError("typed select must have exactly 1 type"))
      return false
    }
    if !st.pop_val_expect_raw(vt_i32) {
      return false
    }
    return st.pop2_push1_raw(first_tid, first_tid, first_tid)
  }
  if op == 0x25 {
    let tbl = br.read_u32_as_int_raw()
    if tbl < 0 {
      st.fail(br.take_err())
      return false
    }
    if tbl >= ctx.tables.length() {
      st.fail(WasmError::ValidationError("table.get index out of bounds"))
      return false
    }
    return st.pop1_push1_raw(vt_i32, ref_type_to_id(ctx.tables[tbl].elem_type))
  }
  if op == 0x26 {
    let tbl = br.read_u32_as_int_raw()
    if tbl < 0 {
      st.fail(br.take_err())
      return false
    }
    if tbl >= ctx.tables.length() {
      st.fail(WasmError::ValidationError("table.set index out of bounds"))
      return false
    }
    return st.pop2_raw(vt_i32, ref_type_to_id(ctx.tables[tbl].elem_type))
  }
  st.fail(WasmError::InvalidOpcode(off, op))
  false
}

fn validate_stream_ext_op_raw(
  ctx : ModuleContext,
  st : ValState,
  br : ByteReader,
  op : Int,
  off : Int,
) -> Bool {
  if op == 0xD0 {
    let roff = br.pos
    let b = br.read_byte_raw()
    if b < 0 {
      st.fail(br.take_err())
      return false
    }
    let tid = if b == 0x70 {
      vt_funcref
    } else if b == 0x6F {
      vt_externref
    } else {
      st.fail(WasmError::InvalidType(roff, "unknown reftype byte " + b.to_string()))
      return false
    }
    return st.push_val_raw(tid)
  }
  if op == 0xD1 {
    let t = st.pop_val_raw()
    if t == -2 {
      return false
    }
    if t != vt_unknown && !is_ref_id(t) {
      st.fail(WasmError::ValidationError("ref.is_null requires reference type"))
      return false
    }
    return st.push_val_raw(vt_i32)
  }
  if op == 0xD2 {
    let fidx = br.read_u32_as_int_raw()
    if fidx < 0 {
      st.fail(br.take_err())
      return false
    }
    if fidx >= ctx.func_types.length() {
      st.fail(WasmError::ValidationError("ref.func index out of bounds"))
      return false
    }
    if !ctx.declared_funcs[fidx] {
      st.fail(WasmError::ValidationError("undeclared function reference"))
      return false
    }
    return st.push_val_raw(vt_funcref)
  }
  if op == 0xFC {
    match validate_fc_stream(ctx, st, br, off) {
      Ok(_) => return true
      Err(e) => {
        st.fail(e)
        return false
      }
    }
  }
  if op == 0xFD {
    match validate_fd_stream(ctx, st, br, off) {
      Ok(_) => return true
      Err(e) => {
        st.fail(e)
        return false
      }
    }
  }
  st.fail(WasmError::InvalidOpcode(off, op))
  false
}

fn validate_func_body_loop(
  ctx : ModuleContext,
  st : ValState,
  locals : LocalTable,
  br : ByteReader,
  func_results : Array[Int],
  decode_limits : DecodeLimits,
  max_ctrl : Int,
) -> Bool {
  let data = br.data
  let end_pos = br.end
  let vstack = st.val_stack
  let num_tbl = num_op_table
  let mem_tbl = mem_op_table
  let flat_loc = st.local_types
  let flat_len = st.local_flat_len
  let max_instrs = decode_limits.max_instructions_per_func
  let has_mem = ctx.memories.length() > 0

  let mut p = br.pos
  let mut instr_count = 0
  let mut ok = true
  while st.ctrl_len > 0 {
    if instr_count >= max_instrs {
      st.fail(WasmError::LimitExceeded("max instructions per function exceeded"))
      ok = false
      break
    }
    instr_count = instr_count + 1
    if p >= end_pos {
      st.fail(WasmError::UnexpectedEof(p))
      ok = false
      break
    }
    let off = p
    let op = data[off].to_int()
    p = off + 1

    if op >= 0x45 && op <= 0xC4 {
      let code = num_tbl[op - 0x45]
      let pt = (code >> 4) & 0xF
      let rt = code & 0xF
      let vlen = st.val_len
      if (code & 0x100) != 0 {
        if vlen >= st.top_height + 2 {
          let a2 = vstack[vlen - 1]
          let a1 = vstack[vlen - 2]
          if (a2 == pt || a2 == -1) && (a1 == pt || a1 == -1) {
            vstack[vlen - 2] = rt
            st.val_len = vlen - 1
            continue
          }
        }
        if !st.pop2_push1_raw(pt, pt, rt) {
          ok = false
          break
        }
        continue
      }
      if vlen > st.top_height {
        let idx = vlen - 1
        let a1 = vstack[idx]
        if a1 == pt || a1 == -1 {
          vstack[idx] = rt
          continue
        }
      }
      if !st.pop1_push1_raw(pt, rt) {
        ok = false
        break
      }
      continue
    }

    if op == 0x20 {
      if p < end_pos {
        let b0 = data[p].to_int()
        if b0 < 0x80 {
          p = p + 1
          let lt = if b0 < flat_len { flat_loc[b0] } else { locals.get(b0) }
          if lt < 0 {
            st.fail(WasmError::ValidationError("local.get index out of bounds"))
            ok = false
            break
          }
          let vlen = st.val_len
          if vlen < vstack.length() {
            vstack[vlen] = lt
            st.val_len = vlen + 1
            continue
          }
          if !st.push_val_grow(lt) {
            ok = false
            break
          }
          continue
        }
      }
      br.pos = p
      if !validate_stream_var_param_op_raw(ctx, st, locals, br, decode_limits.max_results, op, off) {
        ok = false
        break
      }
      p = br.pos
      continue
    }

    if op == 0x41 {
      if p < end_pos && data[p].to_int() < 0x80 {
        p = p + 1
        let vlen = st.val_len
        if vlen < vstack.length() {
          vstack[vlen] = vt_i32
          st.val_len = vlen + 1
          continue
        }
        if !st.push_val_grow(vt_i32) {
          ok = false
          break
        }
        continue
      }
      br.pos = p
      if !br.skip_varint32_raw() {
        st.fail(br.take_err())
        ok = false
        break
      }
      p = br.pos
      if !st.push_val_raw(vt_i32) {
        ok = false
        break
      }
      continue
    }

    if op == 0x21 {
      if p < end_pos {
        let b0 = data[p].to_int()
        if b0 < 0x80 {
          p = p + 1
          let lt = if b0 < flat_len { flat_loc[b0] } else { locals.get(b0) }
          if lt < 0 {
            st.fail(WasmError::ValidationError("local.set index out of bounds"))
            ok = false
            break
          }
          let vlen = st.val_len
          if vlen > st.top_height {
            let nlen = vlen - 1
            let a1 = vstack[nlen]
            if a1 == lt || a1 == -1 {
              st.val_len = nlen
              continue
            }
          }
          if !st.pop_val_expect_raw(lt) {
            ok = false
            break
          }
          continue
        }
      }
      br.pos = p
      if !validate_stream_var_param_op_raw(ctx, st, locals, br, decode_limits.max_results, op, off) {
        ok = false
        break
      }
      p = br.pos
      continue
    }

    if op == 0x22 {
      if p < end_pos {
        let b0 = data[p].to_int()
        if b0 < 0x80 {
          p = p + 1
          let lt = if b0 < flat_len { flat_loc[b0] } else { locals.get(b0) }
          if lt < 0 {
            st.fail(WasmError::ValidationError("local.tee index out of bounds"))
            ok = false
            break
          }
          let vlen = st.val_len
          if vlen > st.top_height {
            let idx = vlen - 1
            let a1 = vstack[idx]
            if a1 == lt || a1 == -1 {
              vstack[idx] = lt
              continue
            }
          }
          if !st.pop1_push1_raw(lt, lt) {
            ok = false
            break
          }
          continue
        }
      }
      br.pos = p
      if !validate_stream_var_param_op_raw(ctx, st, locals, br, decode_limits.max_results, op, off) {
        ok = false
        break
      }
      p = br.pos
      continue
    }

    if op == 0x1A {
      let vlen = st.val_len
      if vlen > st.top_height {
        st.val_len = vlen - 1
        continue
      }
      if st.pop_val_raw() == -2 {
        ok = false
        break
      }
      continue
    }

    if op >= 0x28 && op <= 0x3E {
      let code = mem_tbl[op - 0x28]
      let nat_align = (code >> 4) & 0xF
      if p + 1 < end_pos && has_mem {
        let b0 = data[p].to_int()
        let b1 = data[p + 1].to_int()
        if b0 <= nat_align && b1 < 0x80 {
          p = p + 2
          let vt = code & 0xF
          let vlen = st.val_len
          if (code & 0x100) != 0 {
            if vlen >= st.top_height + 2 {
              let a2 = vstack[vlen - 1]
              let a1 = vstack[vlen - 2]
              if (a2 == vt || a2 == -1) && (a1 == vt_i32 || a1 == -1) {
                st.val_len = vlen - 2
                continue
              }
            }
            if !st.pop2_raw(vt_i32, vt) {
              ok = false
              break
            }
            continue
          }
          if vlen > st.top_height {
            let idx = vlen - 1
            let a1 = vstack[idx]
            if a1 == vt_i32 || a1 == -1 {
              vstack[idx] = vt
              continue
            }
          }
          if !st.pop1_push1_raw(vt_i32, vt) {
            ok = false
            break
          }
          continue
        }
      }
      br.pos = p
      if !validate_stream_mem_op_raw(ctx, st, br, op) {
        ok = false
        break
      }
      p = br.pos
      continue
    }

    br.pos = p
    let step_ok = if op <= 0x11 {
      validate_stream_ctrl_op_raw(
        ctx,
        st,
        br,
        func_results,
        max_ctrl,
        decode_limits.max_br_table_targets,
        op,
        off,
      )
    } else if op >= 0x1A && op <= 0x26 {
      validate_stream_var_param_op_raw(ctx, st, locals, br, decode_limits.max_results, op, off)
    } else if op == 0x3F || op == 0x40 {
      validate_stream_mem_op_raw(ctx, st, br, op)
    } else if op == 0x42 {
      if br.skip_varint64_raw() {
        st.push_val_raw(vt_i64)
      } else {
        st.fail(br.take_err())
        false
      }
    } else if op == 0x43 {
      if 4 > end_pos - br.pos {
        st.fail(WasmError::UnexpectedEof(br.pos))
        false
      } else {
        br.pos = br.pos + 4
        st.push_val_raw(vt_f32)
      }
    } else if op == 0x44 {
      if 8 > end_pos - br.pos {
        st.fail(WasmError::UnexpectedEof(br.pos))
        false
      } else {
        br.pos = br.pos + 8
        st.push_val_raw(vt_f64)
      }
    } else {
      validate_stream_ext_op_raw(ctx, st, br, op, off)
    }
    if !step_ok {
      ok = false
      break
    }
    p = br.pos
  }
  br.pos = p
  ok
}

fn validate_func_body_stream(
  ctx : ModuleContext,
  st : ValState,
  tidx : Int,
  br : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let params = ctx.type_params[tidx]
  let func_results = ctx.type_results[tidx]
  let max_locals = if decode_limits.max_locals_per_func < validate_limits.max_locals_per_func {
    decode_limits.max_locals_per_func
  } else {
    validate_limits.max_locals_per_func
  }
  let mut total_locals : Int64 = params.length().to_int64()
  if total_locals > max_locals.to_int64() {
    return Err(WasmError::LimitExceeded("max_locals_per_func exceeded"))
  }

  let local_group_count = br.read_u32_as_int_raw()
  if local_group_count < 0 {
    return Err(br.take_err())
  }
  let run_ends = if local_group_count == 0 {
    empty_type_ids
  } else {
    Array::with_capacity(local_group_count)
  }
  let run_types = if local_group_count == 0 {
    empty_type_ids
  } else {
    Array::with_capacity(local_group_count)
  }
  let mut j = 0
  while j < local_group_count {
    let lc = br.read_varuint32_raw()
    if lc < 0L {
      return Err(br.take_err())
    }
    total_locals = total_locals + lc
    if total_locals > max_locals.to_int64() {
      return Err(WasmError::LimitExceeded("max_locals_per_func exceeded"))
    }
    let vtoff = br.pos
    let vb = br.read_byte_raw()
    if vb < 0 {
      return Err(br.take_err())
    }
    let vt = match val_type_from_code(vb) {
      Some(v) => v
      None => return Err(WasmError::InvalidType(vtoff, "unknown valtype byte " + vb.to_string()))
    }
    if lc > 0L {
      run_ends.push(total_locals.to_int())
      run_types.push(val_type_to_id(vt))
    }
    j = j + 1
  }
  let total_int = total_locals.to_int()
  let locals = LocalTable::{
    params: params,
    run_ends: run_ends,
    run_types: run_types,
    total: total_int,
  }
  if total_int <= 256 {
    let flat = st.local_types
    let mut flen = flat.length()
    let mut idx = 0
    let plen = params.length()
    while idx < plen {
      let t = params[idx]
      if idx < flen {
        flat[idx] = t
      } else {
        flat.push(t)
        flen = flen + 1
      }
      idx = idx + 1
    }
    let mut r = 0
    while r < run_ends.length() {
      let rend = run_ends[r]
      let rt = run_types[r]
      while idx < rend {
        if idx < flen {
          flat[idx] = rt
        } else {
          flat.push(rt)
          flen = flen + 1
        }
        idx = idx + 1
      }
      r = r + 1
    }
    st.local_flat_len = total_int
  } else {
    st.local_flat_len = -1
  }

  let max_ctrl = if decode_limits.max_control_depth < validate_limits.max_control_depth {
    decode_limits.max_control_depth
  } else {
    validate_limits.max_control_depth
  }

  st.reset()
  if !st.push_ctrl_raw(ctrl_func, empty_type_ids, func_results) {
    return Err(st.take_err())
  }

  if !validate_func_body_loop(ctx, st, locals, br, func_results, decode_limits, max_ctrl) {
    return Err(st.take_err())
  }

  if br.pos != br.end {
    return Err(
      WasmError::SectionSizeMismatch(
        br.pos,
        "function body has trailing bytes: expected " +
        br.end.to_string() +
        ", got " +
        br.pos.to_string(),
      ),
    )
  }
  Ok(())
}

fn ensure_declared_funcs(declared_funcs : Array[Bool], count : Int) -> Unit {
  while declared_funcs.length() < count {
    declared_funcs.push(false)
  }
}

struct StreamState {
  types : Array[FuncType]
  type_params : Array[Array[Int]]
  type_results : Array[Array[Int]]
  func_types : Array[Int]
  defined_func_types : Array[Int]
  tables : Array[TableType]
  memories : Array[MemType]
  globals : Array[GlobalType]
  elem_types : Array[Int]
  declared_funcs : Array[Bool]
  mut imported_globals : Int
  mut has_data_count : Bool
  mut declared_data_count : Int
  mut actual_data_count : Int
  mut code_count : Int
}

fn stream_sec_type(
  ss : StreamState,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_types || count > validate_limits.max_types {
    return Err(WasmError::LimitExceeded("max_types exceeded"))
  }
  let mut i = 0
  while i < count {
    let off = sr.pos
    let form = match sr.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if form != 0x60 {
      return Err(WasmError::InvalidType(off, "expected 0x60 func type, got " + form.to_string()))
    }
    let pc = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if pc > decode_limits.max_params {
      return Err(WasmError::LimitExceeded("max_params exceeded"))
    }
    let params : Array[ValType] = []
    let param_ids : Array[Int] = []
    let mut j = 0
    while j < pc {
      match decode_val_type(sr) {
        Ok(vt) => {
          params.push(vt)
          param_ids.push(val_type_to_id(vt))
        }
        Err(e) => return Err(e)
      }
      j = j + 1
    }
    let rc = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if rc > decode_limits.max_results {
      return Err(WasmError::LimitExceeded("max_results exceeded"))
    }
    let results : Array[ValType] = []
    let result_ids : Array[Int] = []
    let mut k = 0
    while k < rc {
      match decode_val_type(sr) {
        Ok(vt) => {
          results.push(vt)
          result_ids.push(val_type_to_id(vt))
        }
        Err(e) => return Err(e)
      }
      k = k + 1
    }
    ss.types.push(FuncType::{ params: params, results: results })
    ss.type_params.push(param_ids)
    ss.type_results.push(result_ids)
    i = i + 1
  }
  Ok(())
}

fn stream_sec_import(
  ss : StreamState,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_imports {
    return Err(WasmError::LimitExceeded("max_imports exceeded"))
  }
  let mut i = 0
  while i < count {
    match skip_name(sr) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match skip_name(sr) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let off = sr.pos
    let kind = match sr.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match kind {
      0x00 => {
        let tidx = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if tidx < 0 || tidx >= ss.types.length() {
          return Err(WasmError::ValidationError("import func type index out of bounds"))
        }
        ss.func_types.push(tidx)
      }
      0x01 => {
        let tt = match decode_table_type(sr) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        match validate_limits_obj(tt.limits, 4294967295L, false) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        ss.tables.push(tt)
      }
      0x02 => {
        let mt = match decode_mem_type(sr) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        match validate_limits_obj(mt.limits, validate_limits.max_memory_pages, true) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        ss.memories.push(mt)
      }
      0x03 => {
        let gt = match decode_global_type(sr) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        ss.globals.push(gt)
      }
      _ => return Err(WasmError::InvalidType(off, "unknown import kind " + kind.to_string()))
    }
    i = i + 1
  }
  ss.imported_globals = ss.globals.length()
  if ss.func_types.length() > validate_limits.max_functions {
    return Err(WasmError::LimitExceeded("max_functions exceeded"))
  }
  if ss.tables.length() > validate_limits.max_tables {
    return Err(WasmError::LimitExceeded("max_tables exceeded"))
  }
  if !validate_limits.allow_multi_memory && ss.memories.length() > 1 {
    return Err(WasmError::ValidationError("multiple memories not allowed"))
  }
  if ss.memories.length() > validate_limits.max_memories {
    return Err(WasmError::LimitExceeded("max_memories exceeded"))
  }
  if ss.globals.length() > validate_limits.max_globals {
    return Err(WasmError::LimitExceeded("max_globals exceeded"))
  }
  Ok(())
}

fn stream_sec_element(
  ss : StreamState,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_elements || count > validate_limits.max_elements {
    return Err(WasmError::LimitExceeded("max_elements exceeded"))
  }
  ensure_declared_funcs(ss.declared_funcs, ss.func_types.length())
  let mut i = 0
  while i < count {
    let off = sr.pos
    let flags = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if flags < 0 || flags > 7 {
      return Err(WasmError::InvalidImmediate(off, "invalid element segment flags " + flags.to_string()))
    }
    let is_passive_or_decl = (flags & 1) != 0
    let has_table_idx = (flags & 2) != 0 && !is_passive_or_decl
    let uses_exprs = (flags & 4) != 0

    let mut active_tidx = -1
    if !is_passive_or_decl {
      let tidx = if has_table_idx {
        match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
      } else {
        0
      }
      active_tidx = tidx
      match validate_const_expr_stream(
        sr,
        ss.func_types.length(),
        ss.globals,
        ss.imported_globals,
        ss.declared_funcs,
        vt_i32,
      ) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }

    let elem_type = if flags == 0 || flags == 4 {
      RefType::FuncRef
    } else if !uses_exprs {
      let ek_off = sr.pos
      let ek = match sr.read_byte() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if ek != 0x00 {
        return Err(WasmError::InvalidType(ek_off, "expected elemkind 0x00, got " + ek.to_string()))
      }
      RefType::FuncRef
    } else {
      match decode_ref_type(sr) {
        Ok(rt) => rt
        Err(e) => return Err(e)
      }
    }
    let et_id = ref_type_to_id(elem_type)
    if active_tidx >= 0 {
      if active_tidx >= ss.tables.length() {
        return Err(WasmError::ValidationError("element segment table index out of bounds"))
      }
      if ref_type_to_id(ss.tables[active_tidx].elem_type) != et_id {
        return Err(WasmError::ValidationError("element segment type does not match table type"))
      }
    }

    let item_count = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if item_count > decode_limits.max_functions {
      return Err(WasmError::LimitExceeded("element item count exceeded"))
    }
    if !uses_exprs {
      let mut j = 0
      while j < item_count {
        let fidx = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if fidx < 0 || fidx >= ss.func_types.length() {
          return Err(WasmError::ValidationError("element func index out of bounds"))
        }
        ss.declared_funcs[fidx] = true
        j = j + 1
      }
    } else {
      let mut j = 0
      while j < item_count {
        match validate_const_expr_stream(
          sr,
          ss.func_types.length(),
          ss.globals,
          ss.imported_globals,
          ss.declared_funcs,
          et_id,
        ) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        j = j + 1
      }
    }
    ss.elem_types.push(et_id)
    i = i + 1
  }
  Ok(())
}

fn stream_sec_code(
  ss : StreamState,
  data : Bytes,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_functions {
    return Err(WasmError::LimitExceeded("max_functions exceeded in code section"))
  }
  if count != ss.defined_func_types.length() {
    return Err(WasmError::ValidationError("function and code section counts do not match"))
  }
  ss.code_count = count
  ensure_declared_funcs(ss.declared_funcs, ss.func_types.length())
  let ctx = ModuleContext::{
    types: ss.types,
    type_params: ss.type_params,
    type_results: ss.type_results,
    func_types: ss.func_types,
    tables: ss.tables,
    memories: ss.memories,
    globals: ss.globals,
    imported_globals: ss.imported_globals,
    elem_types: ss.elem_types,
    declared_funcs: ss.declared_funcs,
    num_data: ss.declared_data_count,
    has_data_count: ss.has_data_count,
  }
  let st = ValState::new(validate_limits)
  let mut i = 0
  while i < count {
    let body_size = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let body_start = sr.pos
    if body_size < 0 || body_size > sr.end - body_start {
      return Err(WasmError::UnexpectedEof(body_start))
    }
    let body_end = body_start + body_size
    let br = ByteReader::subrange(data, body_start, body_end)
    match validate_func_body_stream(
      ctx,
      st,
      ss.defined_func_types[i],
      br,
      decode_limits,
      validate_limits,
    ) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sr.pos = body_end
    i = i + 1
  }
  Ok(())
}

fn stream_sec_data(
  ss : StreamState,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_data_segments || count > validate_limits.max_data_segments {
    return Err(WasmError::LimitExceeded("max_data_segments exceeded"))
  }
  ss.actual_data_count = count
  ensure_declared_funcs(ss.declared_funcs, ss.func_types.length())
  let mut i = 0
  while i < count {
    let off = sr.pos
    let mode_tag = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match mode_tag {
      0 => {
        if ss.memories.length() == 0 {
          return Err(WasmError::ValidationError("data segment memory index out of bounds"))
        }
        match validate_const_expr_stream(
          sr,
          ss.func_types.length(),
          ss.globals,
          ss.imported_globals,
          ss.declared_funcs,
          vt_i32,
        ) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      1 => ()
      2 => {
        let midx = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if midx < 0 || midx >= ss.memories.length() {
          return Err(WasmError::ValidationError("data segment memory index out of bounds"))
        }
        match validate_const_expr_stream(
          sr,
          ss.func_types.length(),
          ss.globals,
          ss.imported_globals,
          ss.declared_funcs,
          vt_i32,
        ) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      _ => return Err(WasmError::InvalidImmediate(off, "invalid data mode " + mode_tag.to_string()))
    }
    let dlen = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if dlen < 0 || dlen > sr.end - sr.pos {
      return Err(WasmError::UnexpectedEof(sr.pos))
    }
    sr.pos = sr.pos + dlen
    i = i + 1
  }
  Ok(())
}

fn stream_sec_export(
  ss : StreamState,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_exports || count > validate_limits.max_exports {
    return Err(WasmError::LimitExceeded("max_exports exceeded"))
  }
  ensure_declared_funcs(ss.declared_funcs, ss.func_types.length())
  let export_names : Map[String, Bool] = Map::new()
  let mut i = 0
  while i < count {
    let name = match sr.read_name() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    match export_names.get(name) {
      Some(_) => return Err(WasmError::ValidationError("duplicate export name: " + name))
      None => export_names.set(name, true)
    }
    let off = sr.pos
    let k = match sr.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let idx = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let ok = match k {
      0x00 => {
        if idx >= 0 && idx < ss.func_types.length() {
          ss.declared_funcs[idx] = true
          true
        } else {
          false
        }
      }
      0x01 => idx >= 0 && idx < ss.tables.length()
      0x02 => idx >= 0 && idx < ss.memories.length()
      0x03 => idx >= 0 && idx < ss.globals.length()
      _ => return Err(WasmError::InvalidType(off, "unknown export kind " + k.to_string()))
    }
    if !ok {
      return Err(WasmError::ValidationError("export index out of bounds: " + name))
    }
    i = i + 1
  }
  Ok(())
}

fn validate_bytes_streaming(
  data : Bytes,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let total = data.length()
  if total < 8 {
    return Err(WasmError::UnexpectedEof(total))
  }
  if data[0].to_int() != 0x00 ||
  data[1].to_int() != 0x61 ||
  data[2].to_int() != 0x73 ||
  data[3].to_int() != 0x6D {
    return Err(WasmError::InvalidMagic(0))
  }
  let ver = data[4].to_int() |
  (data[5].to_int() << 8) |
  (data[6].to_int() << 16) |
  (data[7].to_int() << 24)
  if ver != 1 {
    return Err(WasmError::UnsupportedVersion(ver))
  }

  let ss = StreamState::{
    types: [],
    type_params: [],
    type_results: [],
    func_types: [],
    defined_func_types: [],
    tables: [],
    memories: [],
    globals: [],
    elem_types: [],
    declared_funcs: [],
    imported_globals: 0,
    has_data_count: false,
    declared_data_count: 0,
    actual_data_count: 0,
    code_count: 0,
  }

  let mut pos = 8
  let mut last_std_section = 0
  let mut section_count = 0

  while pos < total {
    if section_count >= decode_limits.max_sections {
      return Err(WasmError::LimitExceeded("max_sections exceeded"))
    }
    let r = ByteReader::subrange(data, pos, total)
    let id_off = r.pos
    let sec_id = match r.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let sec_size = match r.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let sec_start = r.pos
    if sec_size < 0 || sec_size > total - sec_start {
      return Err(WasmError::UnexpectedEof(sec_start))
    }
    let sec_end = sec_start + sec_size
    let sr = ByteReader::subrange(data, sec_start, sec_end)

    if sec_id != 0 {
      let rank = section_order_rank(sec_id)
      if rank < 0 {
        return Err(WasmError::InvalidSectionId(id_off, sec_id))
      }
      if rank == last_std_section {
        return Err(WasmError::DuplicateSection(id_off, sec_id))
      }
      if rank < last_std_section {
        return Err(WasmError::InvalidSectionOrder(id_off, sec_id))
      }
      last_std_section = rank
    }

    let sec_res = match sec_id {
      0 => {
        match skip_name(sr) {
          Ok(_) => {
            sr.pos = sec_end
            Ok(())
          }
          Err(e) => Err(e)
        }
      }
      1 => stream_sec_type(ss, sr, decode_limits, validate_limits)
      2 => stream_sec_import(ss, sr, decode_limits, validate_limits)
      3 => {
        let count = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if count > decode_limits.max_functions {
          return Err(WasmError::LimitExceeded("max_functions exceeded"))
        }
        let mut i = 0
        while i < count {
          let tidx = match sr.read_u32_as_int() {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if tidx < 0 || tidx >= ss.types.length() {
            return Err(WasmError::ValidationError("function type index out of bounds"))
          }
          ss.func_types.push(tidx)
          ss.defined_func_types.push(tidx)
          i = i + 1
        }
        if ss.func_types.length() > validate_limits.max_functions {
          Err(WasmError::LimitExceeded("max_functions exceeded"))
        } else {
          Ok(())
        }
      }
      4 => {
        let count = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if count > decode_limits.max_tables {
          return Err(WasmError::LimitExceeded("max_tables exceeded"))
        }
        let mut i = 0
        while i < count {
          let tt = match decode_table_type(sr) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match validate_limits_obj(tt.limits, 4294967295L, false) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          ss.tables.push(tt)
          i = i + 1
        }
        if ss.tables.length() > validate_limits.max_tables {
          Err(WasmError::LimitExceeded("max_tables exceeded"))
        } else {
          Ok(())
        }
      }
      5 => {
        let count = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if count > decode_limits.max_memories {
          return Err(WasmError::LimitExceeded("max_memories exceeded"))
        }
        let mut i = 0
        while i < count {
          let mt = match decode_mem_type(sr) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match validate_limits_obj(mt.limits, validate_limits.max_memory_pages, true) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          ss.memories.push(mt)
          i = i + 1
        }
        if !validate_limits.allow_multi_memory && ss.memories.length() > 1 {
          Err(WasmError::ValidationError("multiple memories not allowed"))
        } else if ss.memories.length() > validate_limits.max_memories {
          Err(WasmError::LimitExceeded("max_memories exceeded"))
        } else {
          Ok(())
        }
      }
      6 => {
        let count = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if count > decode_limits.max_globals || ss.globals.length() + count > validate_limits.max_globals {
          return Err(WasmError::LimitExceeded("max_globals exceeded"))
        }
        ensure_declared_funcs(ss.declared_funcs, ss.func_types.length())
        let mut i = 0
        while i < count {
          let gt = match decode_global_type(sr) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match validate_const_expr_stream(
            sr,
            ss.func_types.length(),
            ss.globals,
            ss.imported_globals,
            ss.declared_funcs,
            val_type_to_id(gt.val_type),
          ) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          ss.globals.push(gt)
          i = i + 1
        }
        Ok(())
      }
      7 => stream_sec_export(ss, sr, decode_limits, validate_limits)
      8 => {
        let fidx = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if fidx < 0 || fidx >= ss.func_types.length() {
          Err(WasmError::ValidationError("start function index out of bounds"))
        } else {
          let ft = ss.types[ss.func_types[fidx]]
          if ft.params.length() != 0 || ft.results.length() != 0 {
            Err(WasmError::ValidationError("start function must have type () -> ()"))
          } else {
            Ok(())
          }
        }
      }
      9 => stream_sec_element(ss, sr, decode_limits, validate_limits)
      12 =>
      match sr.read_u32_as_int() {
        Ok(dc) => {
          ss.has_data_count = true
          ss.declared_data_count = dc
          Ok(())
        }
        Err(e) => Err(e)
      }
      10 => stream_sec_code(ss, data, sr, decode_limits, validate_limits)
      11 => stream_sec_data(ss, sr, decode_limits, validate_limits)
      _ => Err(WasmError::InvalidSectionId(id_off, sec_id))
    }

    match sec_res {
      Ok(_) => ()
      Err(e) => return Err(e)
    }

    if sr.pos != sec_end {
      return Err(
        WasmError::SectionSizeMismatch(
          sr.pos,
          "section " + sec_id.to_string() + " did not consume all bytes",
        ),
      )
    }
    pos = sec_end
    section_count = section_count + 1
  }

  if ss.defined_func_types.length() != ss.code_count {
    return Err(WasmError::ValidationError("function and code section counts do not match"))
  }
  if ss.has_data_count && ss.declared_data_count != ss.actual_data_count {
    return Err(WasmError::ValidationError("DataCount does not match Data section length"))
  }
  Ok(())
}
