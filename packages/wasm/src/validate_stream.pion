///| Single-pass streaming WebAssembly 1.0/2.0 binary validator (zero AST allocation).

fn skip_name(r : ByteReader) -> Result[Unit, WasmError] {
  let n = match r.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let start = r.pos
  if n < 0 || n > r.end - start {
    return Err(WasmError::UnexpectedEof(start))
  }
  if !validate_utf8_range(r.data, start, start + n) {
    return Err(WasmError::InvalidUtf8(start))
  }
  r.pos = start + n
  Ok(())
}

fn stream_check_memarg(
  ctx : ModuleContext,
  r : ByteReader,
  natural_align : Int,
) -> Result[Unit, WasmError] {
  let off = r.pos
  let raw_align = match r.read_varuint32() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if raw_align >= 64L {
    return Err(WasmError::InvalidImmediate(off, "alignment too large"))
  }
  let align = raw_align.to_int()
  match r.read_varuint32() {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  if ctx.memories.length() == 0 {
    return Err(WasmError::ValidationError("memory index out of bounds"))
  }
  if align > natural_align {
    return Err(
      WasmError::ValidationError(
        "alignment " + align.to_string() + " exceeds natural alignment " + natural_align.to_string(),
      ),
    )
  }
  Ok(())
}

fn stream_resolve_block_type(
  ctx : ModuleContext,
  r : ByteReader,
) -> Result[(Array[Int], Array[Int]), WasmError] {
  let off = r.pos
  if r.pos >= r.end {
    return Err(WasmError::UnexpectedEof(off))
  }
  let b = r.data[r.pos].to_int()
  if b == 0x40 {
    r.pos = r.pos + 1
    return Ok(([], []))
  }
  if b == 0x7F {
    r.pos = r.pos + 1
    return Ok(([], [vt_i32]))
  }
  if b == 0x7E {
    r.pos = r.pos + 1
    return Ok(([], [vt_i64]))
  }
  if b == 0x7D {
    r.pos = r.pos + 1
    return Ok(([], [vt_f32]))
  }
  if b == 0x7C {
    r.pos = r.pos + 1
    return Ok(([], [vt_f64]))
  }
  if b == 0x7B {
    r.pos = r.pos + 1
    return Ok(([], [vt_v128]))
  }
  if b == 0x70 {
    r.pos = r.pos + 1
    return Ok(([], [vt_funcref]))
  }
  if b == 0x6F {
    r.pos = r.pos + 1
    return Ok(([], [vt_externref]))
  }
  let idx = match r.read_varint33() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if idx < 0L || idx > 2147483647L {
    return Err(WasmError::InvalidType(off, "invalid block type s33: " + idx.to_string()))
  }
  let ti = idx.to_int()
  if ti < 0 || ti >= ctx.types.length() {
    return Err(WasmError::ValidationError("block type index out of bounds"))
  }
  Ok((ctx.type_params[ti], ctx.type_results[ti]))
}

fn validate_const_expr_stream(
  r : ByteReader,
  func_count : Int,
  globals : Array[GlobalType],
  max_global_idx : Int,
  declared_funcs : Array[Bool],
  expect_vt : Int,
) -> Result[Unit, WasmError] {
  let mut count = 0
  let mut top_vt = vt_unknown
  while true {
    let off = r.pos
    let op = match r.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match op {
      0x0B => break
      0x41 => {
        match r.read_varint32() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        top_vt = vt_i32
        count = count + 1
      }
      0x42 => {
        match r.read_varint64() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        top_vt = vt_i64
        count = count + 1
      }
      0x43 => {
        match r.read_u32_le() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        top_vt = vt_f32
        count = count + 1
      }
      0x44 => {
        match r.read_u64_le() {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        top_vt = vt_f64
        count = count + 1
      }
      0xD0 => {
        let rt = match decode_ref_type(r) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        top_vt = ref_type_to_id(rt)
        count = count + 1
      }
      0xD2 => {
        let fidx = match r.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if fidx < 0 || fidx >= func_count {
          return Err(WasmError::ValidationError("ref.func index out of bounds in const expr"))
        }
        declared_funcs[fidx] = true
        top_vt = vt_funcref
        count = count + 1
      }
      0x23 => {
        let gidx = match r.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if gidx < 0 || gidx >= max_global_idx {
          return Err(WasmError::ValidationError("global.get index out of bounds in const expr"))
        }
        let gt = globals[gidx]
        if gt.mutable {
          return Err(WasmError::ValidationError("global.get in const expr must reference immutable global"))
        }
        top_vt = val_type_to_id(gt.val_type)
        count = count + 1
      }
      0xFD => {
        let sub = match r.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if sub != 12 {
          return Err(WasmError::ValidationError("non-constant SIMD instruction in constant expression"))
        }
        if 16 > r.end - r.pos {
          return Err(WasmError::UnexpectedEof(r.pos))
        }
        r.pos = r.pos + 16
        top_vt = vt_v128
        count = count + 1
      }
      _ => return Err(WasmError::ValidationError("non-constant instruction in constant expression at " + off.to_string()))
    }
  }
  if count != 1 || top_vt != expect_vt {
    return Err(WasmError::ValidationError("const expression result type mismatch"))
  }
  Ok(())
}

fn validate_fc_stream(
  ctx : ModuleContext,
  st : ValState,
  r : ByteReader,
  off : Int,
) -> Result[Unit, WasmError] {
  let sub = match r.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  match sub {
    0 | 1 => st.pop1_push1(vt_f32, vt_i32)
    2 | 3 => st.pop1_push1(vt_f64, vt_i32)
    4 | 5 => st.pop1_push1(vt_f32, vt_i64)
    6 | 7 => st.pop1_push1(vt_f64, vt_i64)
    8 => {
      let didx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let midx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if !ctx.has_data_count {
        return Err(WasmError::ValidationError("memory.init requires DataCount section"))
      }
      if didx < 0 || didx >= ctx.num_data || midx < 0 || midx >= ctx.memories.length() {
        return Err(WasmError::ValidationError("memory.init index out of bounds"))
      }
      st.pop3_i32()
    }
    9 => {
      let didx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if !ctx.has_data_count {
        return Err(WasmError::ValidationError("data.drop requires DataCount section"))
      }
      if didx < 0 || didx >= ctx.num_data {
        return Err(WasmError::ValidationError("data.drop index out of bounds"))
      }
      Ok(())
    }
    10 => {
      let dst = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let src = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if dst < 0 || dst >= ctx.memories.length() || src < 0 || src >= ctx.memories.length() {
        return Err(WasmError::ValidationError("memory.copy index out of bounds"))
      }
      st.pop3_i32()
    }
    11 => {
      let midx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if midx < 0 || midx >= ctx.memories.length() {
        return Err(WasmError::ValidationError("memory.fill index out of bounds"))
      }
      st.pop3_i32()
    }
    12 => {
      let eidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let tidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if eidx < 0 || eidx >= ctx.elem_types.length() || tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.init index out of bounds"))
      }
      if ctx.elem_types[eidx] != ref_type_to_id(ctx.tables[tidx].elem_type) {
        return Err(WasmError::ValidationError("table.init element type mismatch"))
      }
      st.pop3_i32()
    }
    13 => {
      let eidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if eidx < 0 || eidx >= ctx.elem_types.length() {
        return Err(WasmError::ValidationError("elem.drop index out of bounds"))
      }
      Ok(())
    }
    14 => {
      let dst = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let src = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if dst < 0 || dst >= ctx.tables.length() || src < 0 || src >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.copy index out of bounds"))
      }
      if ref_type_to_id(ctx.tables[dst].elem_type) != ref_type_to_id(ctx.tables[src].elem_type) {
        return Err(WasmError::ValidationError("table.copy element type mismatch"))
      }
      st.pop3_i32()
    }
    15 => {
      let tidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.grow index out of bounds"))
      }
      st.pop2_push1(ref_type_to_id(ctx.tables[tidx].elem_type), vt_i32, vt_i32)
    }
    16 => {
      let tidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.size index out of bounds"))
      }
      st.push_val(vt_i32)
    }
    17 => {
      let tidx = match r.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if tidx < 0 || tidx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.fill index out of bounds"))
      }
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.pop2(vt_i32, ref_type_to_id(ctx.tables[tidx].elem_type))
    }
    _ => Err(WasmError::InvalidOpcode(off, 0xFC00 + sub))
  }
}

fn validate_fd_stream(
  ctx : ModuleContext,
  st : ValState,
  r : ByteReader,
  off : Int,
) -> Result[Unit, WasmError] {
  let sub = match r.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if (sub >= 0 && sub <= 11) || sub == 92 || sub == 93 {
    let nat = match sub {
      0 | 11 => 4
      1 | 2 | 3 | 4 | 5 | 6 | 10 | 93 => 3
      7 => 0
      8 => 1
      9 | 92 => 2
      _ => 4
    }
    match stream_check_memarg(ctx, r, nat) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if sub == 11 {
      return st.pop2(vt_i32, vt_v128)
    }
    return st.pop1_push1(vt_i32, vt_v128)
  }
  if sub == 12 {
    if 16 > r.end - r.pos {
      return Err(WasmError::UnexpectedEof(r.pos))
    }
    r.pos = r.pos + 16
    return st.push_val(vt_v128)
  }
  if sub == 13 {
    if 16 > r.end - r.pos {
      return Err(WasmError::UnexpectedEof(r.pos))
    }
    let base = r.pos
    let mut k = 0
    while k < 16 {
      if r.data[base + k].to_int() >= 32 {
        return Err(WasmError::ValidationError("i8x16.shuffle lane index >= 32"))
      }
      k = k + 1
    }
    r.pos = base + 16
    return st.pop2_push1(vt_v128, vt_v128, vt_v128)
  }
  if sub >= 21 && sub <= 34 {
    let lane = match r.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let (max_lane, is_replace, lane_vt) = match sub {
      21 | 22 => (16, false, vt_i32)
      23 => (16, true, vt_i32)
      24 | 25 => (8, false, vt_i32)
      26 => (8, true, vt_i32)
      27 => (4, false, vt_i32)
      28 => (4, true, vt_i32)
      29 => (2, false, vt_i64)
      30 => (2, true, vt_i64)
      31 => (4, false, vt_f32)
      32 => (4, true, vt_f32)
      33 => (2, false, vt_f64)
      34 => (2, true, vt_f64)
      _ => return Err(WasmError::ValidationError("invalid SIMD lane op"))
    }
    if lane < 0 || lane >= max_lane {
      return Err(WasmError::ValidationError("SIMD lane index out of bounds"))
    }
    if is_replace {
      return st.pop2_push1(vt_v128, lane_vt, vt_v128)
    }
    return st.pop1_push1(vt_v128, lane_vt)
  }
  if sub >= 84 && sub <= 91 {
    let (nat, max_lane, is_store) = match sub {
      84 => (0, 16, false)
      85 => (1, 8, false)
      86 => (2, 4, false)
      87 => (3, 2, false)
      88 => (0, 16, true)
      89 => (1, 8, true)
      90 => (2, 4, true)
      91 => (3, 2, true)
      _ => return Err(WasmError::ValidationError("invalid SIMD mem lane op"))
    }
    match stream_check_memarg(ctx, r, nat) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let lane = match r.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if lane < 0 || lane >= max_lane {
      return Err(WasmError::ValidationError("SIMD lane index out of bounds"))
    }
    if is_store {
      return st.pop2(vt_i32, vt_v128)
    }
    return st.pop2_push1(vt_i32, vt_v128, vt_v128)
  }
  if !is_valid_simd_plain_op(sub) {
    return Err(WasmError::InvalidOpcode(off, 0xFD00 + sub))
  }
  validate_simd_op(st, sub)
}

fn validate_stream_mem_op(
  ctx : ModuleContext,
  st : ValState,
  br : ByteReader,
  op : Int,
) -> Result[Unit, WasmError] {
  match op {
    0x28 => {
      match stream_check_memarg(ctx, br, 2) {
        Ok(_) => st.pop1_push1(vt_i32, vt_i32)
        Err(e) => Err(e)
      }
    }
    0x29 => {
      match stream_check_memarg(ctx, br, 3) {
        Ok(_) => st.pop1_push1(vt_i32, vt_i64)
        Err(e) => Err(e)
      }
    }
    0x2A => {
      match stream_check_memarg(ctx, br, 2) {
        Ok(_) => st.pop1_push1(vt_i32, vt_f32)
        Err(e) => Err(e)
      }
    }
    0x2B => {
      match stream_check_memarg(ctx, br, 3) {
        Ok(_) => st.pop1_push1(vt_i32, vt_f64)
        Err(e) => Err(e)
      }
    }
    0x2C | 0x2D => {
      match stream_check_memarg(ctx, br, 0) {
        Ok(_) => st.pop1_push1(vt_i32, vt_i32)
        Err(e) => Err(e)
      }
    }
    0x2E | 0x2F => {
      match stream_check_memarg(ctx, br, 1) {
        Ok(_) => st.pop1_push1(vt_i32, vt_i32)
        Err(e) => Err(e)
      }
    }
    0x30 | 0x31 => {
      match stream_check_memarg(ctx, br, 0) {
        Ok(_) => st.pop1_push1(vt_i32, vt_i64)
        Err(e) => Err(e)
      }
    }
    0x32 | 0x33 => {
      match stream_check_memarg(ctx, br, 1) {
        Ok(_) => st.pop1_push1(vt_i32, vt_i64)
        Err(e) => Err(e)
      }
    }
    0x34 | 0x35 => {
      match stream_check_memarg(ctx, br, 2) {
        Ok(_) => st.pop1_push1(vt_i32, vt_i64)
        Err(e) => Err(e)
      }
    }
    0x36 => {
      match stream_check_memarg(ctx, br, 2) {
        Ok(_) => st.pop2(vt_i32, vt_i32)
        Err(e) => Err(e)
      }
    }
    0x37 => {
      match stream_check_memarg(ctx, br, 3) {
        Ok(_) => st.pop2(vt_i32, vt_i64)
        Err(e) => Err(e)
      }
    }
    0x38 => {
      match stream_check_memarg(ctx, br, 2) {
        Ok(_) => st.pop2(vt_i32, vt_f32)
        Err(e) => Err(e)
      }
    }
    0x39 => {
      match stream_check_memarg(ctx, br, 3) {
        Ok(_) => st.pop2(vt_i32, vt_f64)
        Err(e) => Err(e)
      }
    }
    0x3A => {
      match stream_check_memarg(ctx, br, 0) {
        Ok(_) => st.pop2(vt_i32, vt_i32)
        Err(e) => Err(e)
      }
    }
    0x3B => {
      match stream_check_memarg(ctx, br, 1) {
        Ok(_) => st.pop2(vt_i32, vt_i32)
        Err(e) => Err(e)
      }
    }
    0x3C => {
      match stream_check_memarg(ctx, br, 0) {
        Ok(_) => st.pop2(vt_i32, vt_i64)
        Err(e) => Err(e)
      }
    }
    0x3D => {
      match stream_check_memarg(ctx, br, 1) {
        Ok(_) => st.pop2(vt_i32, vt_i64)
        Err(e) => Err(e)
      }
    }
    0x3E => {
      match stream_check_memarg(ctx, br, 2) {
        Ok(_) => st.pop2(vt_i32, vt_i64)
        Err(e) => Err(e)
      }
    }
    0x3F => {
      let zoff = br.pos
      match br.read_byte() {
        Ok(0) => ()
        Ok(_) => return Err(WasmError::InvalidImmediate(zoff, "zero byte expected"))
        Err(e) => return Err(e)
      }
      if ctx.memories.length() == 0 {
        return Err(WasmError::ValidationError("memory.size index out of bounds"))
      }
      st.push_val(vt_i32)
    }
    0x40 => {
      let zoff = br.pos
      match br.read_byte() {
        Ok(0) => ()
        Ok(_) => return Err(WasmError::InvalidImmediate(zoff, "zero byte expected"))
        Err(e) => return Err(e)
      }
      if ctx.memories.length() == 0 {
        return Err(WasmError::ValidationError("memory.grow index out of bounds"))
      }
      st.pop1_push1(vt_i32, vt_i32)
    }
    _ => Err(WasmError::InvalidOpcode(br.pos - 1, op))
  }
}

fn validate_stream_num_op(st : ValState, op : Int, off : Int) -> Result[Unit, WasmError] {
  if op == 0x45 || (op >= 0x67 && op <= 0x69) || op == 0xC0 || op == 0xC1 {
    return st.pop1_push1(vt_i32, vt_i32)
  }
  if (op >= 0x46 && op <= 0x4F) || (op >= 0x6A && op <= 0x78) {
    return st.pop2_push1(vt_i32, vt_i32, vt_i32)
  }
  if op == 0x50 || op == 0xA7 {
    return st.pop1_push1(vt_i64, vt_i32)
  }
  if op >= 0x51 && op <= 0x5A {
    return st.pop2_push1(vt_i64, vt_i64, vt_i32)
  }
  if op >= 0x5B && op <= 0x60 {
    return st.pop2_push1(vt_f32, vt_f32, vt_i32)
  }
  if op >= 0x61 && op <= 0x66 {
    return st.pop2_push1(vt_f64, vt_f64, vt_i32)
  }
  if (op >= 0x79 && op <= 0x7B) || (op >= 0xC2 && op <= 0xC4) {
    return st.pop1_push1(vt_i64, vt_i64)
  }
  if op >= 0x7C && op <= 0x8A {
    return st.pop2_push1(vt_i64, vt_i64, vt_i64)
  }
  if op >= 0x8B && op <= 0x91 {
    return st.pop1_push1(vt_f32, vt_f32)
  }
  if op >= 0x92 && op <= 0x98 {
    return st.pop2_push1(vt_f32, vt_f32, vt_f32)
  }
  if op >= 0x99 && op <= 0x9F {
    return st.pop1_push1(vt_f64, vt_f64)
  }
  if op >= 0xA0 && op <= 0xA6 {
    return st.pop2_push1(vt_f64, vt_f64, vt_f64)
  }
  if op == 0xA8 || op == 0xA9 || op == 0xBC {
    return st.pop1_push1(vt_f32, vt_i32)
  }
  if op == 0xAA || op == 0xAB {
    return st.pop1_push1(vt_f64, vt_i32)
  }
  if op == 0xAC || op == 0xAD {
    return st.pop1_push1(vt_i32, vt_i64)
  }
  if op == 0xAE || op == 0xAF {
    return st.pop1_push1(vt_f32, vt_i64)
  }
  if op == 0xB0 || op == 0xB1 || op == 0xBD {
    return st.pop1_push1(vt_f64, vt_i64)
  }
  if op == 0xB2 || op == 0xB3 || op == 0xBE {
    return st.pop1_push1(vt_i32, vt_f32)
  }
  if op == 0xB4 || op == 0xB5 {
    return st.pop1_push1(vt_i64, vt_f32)
  }
  if op == 0xB6 {
    return st.pop1_push1(vt_f64, vt_f32)
  }
  if op == 0xB7 || op == 0xB8 {
    return st.pop1_push1(vt_i32, vt_f64)
  }
  if op == 0xB9 || op == 0xBA || op == 0xBF {
    return st.pop1_push1(vt_i64, vt_f64)
  }
  if op == 0xBB {
    return st.pop1_push1(vt_f32, vt_f64)
  }
  Err(WasmError::InvalidOpcode(off, op))
}

fn validate_stream_ctrl_op(
  ctx : ModuleContext,
  st : ValState,
  br : ByteReader,
  func_results : Array[Int],
  max_ctrl : Int,
  max_br_table : Int,
  op : Int,
  off : Int,
) -> Result[Unit, WasmError] {
  match op {
    0x00 => {
      st.mark_unreachable()
      Ok(())
    }
    0x01 => Ok(())
    0x02 => {
      if st.ctrl_len >= max_ctrl {
        return Err(WasmError::LimitExceeded("max_control_depth exceeded"))
      }
      let (in_t, out_t) = match stream_resolve_block_type(ctx, br) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      match st.pop_vals(in_t) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.push_ctrl(ctrl_block, in_t, out_t)
    }
    0x03 => {
      if st.ctrl_len >= max_ctrl {
        return Err(WasmError::LimitExceeded("max_control_depth exceeded"))
      }
      let (in_t, out_t) = match stream_resolve_block_type(ctx, br) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      match st.pop_vals(in_t) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.push_ctrl(ctrl_loop, in_t, out_t)
    }
    0x04 => {
      if st.ctrl_len >= max_ctrl {
        return Err(WasmError::LimitExceeded("max_control_depth exceeded"))
      }
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let (in_t, out_t) = match stream_resolve_block_type(ctx, br) {
        Ok(p) => p
        Err(e) => return Err(e)
      }
      match st.pop_vals(in_t) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.push_ctrl(ctrl_if, in_t, out_t)
    }
    0x05 => {
      let frame = match st.pop_ctrl() {
        Ok(f) => f
        Err(e) => return Err(e)
      }
      if frame.opcode != ctrl_if {
        return Err(WasmError::ValidationError("else without matching if"))
      }
      st.push_ctrl(ctrl_else, frame.start_types, frame.end_types)
    }
    0x0B => {
      let frame = match st.pop_ctrl() {
        Ok(f) => f
        Err(e) => return Err(e)
      }
      if frame.opcode == ctrl_if {
        if frame.start_types.length() != frame.end_types.length() {
          return Err(WasmError::ValidationError("if without else has mismatched block type"))
        }
        let mut k = 0
        while k < frame.start_types.length() {
          if frame.start_types[k] != frame.end_types[k] {
            return Err(WasmError::ValidationError("if without else has mismatched block type"))
          }
          k = k + 1
        }
      }
      if st.ctrl_len > 0 {
        return st.push_vals(frame.end_types)
      }
      Ok(())
    }
    0x0C => {
      let l = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if l < 0 || l >= st.ctrl_len {
        return Err(WasmError::ValidationError("br label out of bounds"))
      }
      let target = st.ctrl_stack[st.ctrl_len - 1 - l]
      match st.pop_vals(label_types(target)) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.mark_unreachable()
      Ok(())
    }
    0x0D => {
      let l = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if l < 0 || l >= st.ctrl_len {
        return Err(WasmError::ValidationError("br_if label out of bounds"))
      }
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let lt = label_types(st.ctrl_stack[st.ctrl_len - 1 - l])
      match st.pop_vals(lt) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.push_vals(lt)
    }
    0x0E => {
      let count = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if count > max_br_table {
        return Err(WasmError::LimitExceeded("max br_table targets exceeded"))
      }
      let targets : Array[Int] = []
      let mut ti = 0
      while ti < count {
        match br.read_u32_as_int() {
          Ok(v) => targets.push(v)
          Err(e) => return Err(e)
        }
        ti = ti + 1
      }
      let def_t = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      if def_t < 0 || def_t >= st.ctrl_len {
        return Err(WasmError::ValidationError("br_table default label out of bounds"))
      }
      let def_types = label_types(st.ctrl_stack[st.ctrl_len - 1 - def_t])
      let arity = def_types.length()
      ti = 0
      while ti < count {
        let l = targets[ti]
        if l < 0 || l >= st.ctrl_len {
          return Err(WasmError::ValidationError("br_table target label out of bounds"))
        }
        let lt = label_types(st.ctrl_stack[st.ctrl_len - 1 - l])
        if lt.length() != arity {
          return Err(WasmError::ValidationError("br_table target arity mismatch"))
        }
        if arity > 0 {
          let popped : Array[Int] = []
          let mut k = arity - 1
          while k >= 0 {
            match st.pop_val_expect(lt[k]) {
              Ok(v) => popped.push(v)
              Err(e) => return Err(e)
            }
            k = k - 1
          }
          let mut p = popped.length() - 1
          while p >= 0 {
            match st.push_val(popped[p]) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            p = p - 1
          }
        }
        ti = ti + 1
      }
      match st.pop_vals(def_types) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.mark_unreachable()
      Ok(())
    }
    0x0F => {
      match st.pop_vals(func_results) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.mark_unreachable()
      Ok(())
    }
    0x10 => {
      let fidx = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if fidx < 0 || fidx >= ctx.func_types.length() {
        return Err(WasmError::ValidationError("call function index out of bounds"))
      }
      let ct = ctx.func_types[fidx]
      match st.pop_vals(ctx.type_params[ct]) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.push_vals(ctx.type_results[ct])
    }
    0x11 => {
      let ct = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let tbl_idx = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if tbl_idx < 0 || tbl_idx >= ctx.tables.length() {
        return Err(WasmError::ValidationError("call_indirect table index out of bounds"))
      }
      if ref_type_to_id(ctx.tables[tbl_idx].elem_type) != vt_funcref {
        return Err(WasmError::ValidationError("call_indirect table must have funcref type"))
      }
      if ct < 0 || ct >= ctx.types.length() {
        return Err(WasmError::ValidationError("call_indirect type index out of bounds"))
      }
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      match st.pop_vals(ctx.type_params[ct]) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.push_vals(ctx.type_results[ct])
    }
    _ => Err(WasmError::InvalidOpcode(off, op))
  }
}

fn validate_stream_var_param_op(
  ctx : ModuleContext,
  st : ValState,
  locals : LocalTable,
  br : ByteReader,
  max_results : Int,
  op : Int,
  off : Int,
) -> Result[Unit, WasmError] {
  match op {
    0x1A =>
    match st.pop_val() {
      Ok(_) => Ok(())
      Err(e) => Err(e)
    }
    0x1B => {
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      let t1 = match st.pop_val() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let t2 = match st.pop_val() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if is_ref_id(t1) || is_ref_id(t2) {
        return Err(WasmError::ValidationError("untyped select cannot operate on reference types"))
      }
      if t1 != t2 && t1 != vt_unknown && t2 != vt_unknown {
        return Err(WasmError::ValidationError("select operand types mismatch"))
      }
      let res = if t1 == vt_unknown { t2 } else { t1 }
      st.push_val(res)
    }
    0x1C => {
      let count = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if count > max_results {
        return Err(WasmError::LimitExceeded("typed select too many types"))
      }
      let mut first_tid = vt_unknown
      let mut i = 0
      while i < count {
        let vt = match decode_val_type(br) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if i == 0 {
          first_tid = val_type_to_id(vt)
        }
        i = i + 1
      }
      if count != 1 {
        return Err(WasmError::ValidationError("typed select must have exactly 1 type"))
      }
      match st.pop_val_expect(vt_i32) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      st.pop2_push1(first_tid, first_tid, first_tid)
    }
    0x20 => {
      let lidx = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let lt = locals.get(lidx)
      if lt < 0 {
        return Err(WasmError::ValidationError("local.get index out of bounds"))
      }
      st.push_val(lt)
    }
    0x21 => {
      let lidx = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let lt = locals.get(lidx)
      if lt < 0 {
        return Err(WasmError::ValidationError("local.set index out of bounds"))
      }
      match st.pop_val_expect(lt) {
        Ok(_) => Ok(())
        Err(e) => Err(e)
      }
    }
    0x22 => {
      let lidx = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      let lt = locals.get(lidx)
      if lt < 0 {
        return Err(WasmError::ValidationError("local.tee index out of bounds"))
      }
      st.pop1_push1(lt, lt)
    }
    0x23 => {
      let gidx = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if gidx < 0 || gidx >= ctx.globals.length() {
        return Err(WasmError::ValidationError("global.get index out of bounds"))
      }
      st.push_val(val_type_to_id(ctx.globals[gidx].val_type))
    }
    0x24 => {
      let gidx = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if gidx < 0 || gidx >= ctx.globals.length() {
        return Err(WasmError::ValidationError("global.set index out of bounds"))
      }
      let gt = ctx.globals[gidx]
      if !gt.mutable {
        return Err(WasmError::ValidationError("cannot global.set immutable global"))
      }
      match st.pop_val_expect(val_type_to_id(gt.val_type)) {
        Ok(_) => Ok(())
        Err(e) => Err(e)
      }
    }
    0x25 => {
      let tbl = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if tbl < 0 || tbl >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.get index out of bounds"))
      }
      st.pop1_push1(vt_i32, ref_type_to_id(ctx.tables[tbl].elem_type))
    }
    0x26 => {
      let tbl = match br.read_u32_as_int() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if tbl < 0 || tbl >= ctx.tables.length() {
        return Err(WasmError::ValidationError("table.set index out of bounds"))
      }
      st.pop2(vt_i32, ref_type_to_id(ctx.tables[tbl].elem_type))
    }
    _ => Err(WasmError::InvalidOpcode(off, op))
  }
}

fn validate_func_body_stream(
  ctx : ModuleContext,
  st : ValState,
  tidx : Int,
  br : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let params = ctx.type_params[tidx]
  let func_results = ctx.type_results[tidx]
  let max_locals = if decode_limits.max_locals_per_func < validate_limits.max_locals_per_func {
    decode_limits.max_locals_per_func
  } else {
    validate_limits.max_locals_per_func
  }
  let mut total_locals : Int64 = params.length().to_int64()
  if total_locals > max_locals.to_int64() {
    return Err(WasmError::LimitExceeded("max_locals_per_func exceeded"))
  }

  let local_group_count = match br.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let run_ends : Array[Int] = []
  let run_types : Array[Int] = []
  let mut j = 0
  while j < local_group_count {
    let lc = match br.read_varuint32() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    total_locals = total_locals + lc
    if total_locals > max_locals.to_int64() {
      return Err(WasmError::LimitExceeded("max_locals_per_func exceeded"))
    }
    let vt = match decode_val_type(br) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if lc > 0L {
      run_ends.push(total_locals.to_int())
      run_types.push(val_type_to_id(vt))
    }
    j = j + 1
  }
  let locals = LocalTable::{
    params: params,
    run_ends: run_ends,
    run_types: run_types,
    total: total_locals.to_int(),
  }

  let max_ctrl = if decode_limits.max_control_depth < validate_limits.max_control_depth {
    decode_limits.max_control_depth
  } else {
    validate_limits.max_control_depth
  }
  let max_instrs = decode_limits.max_instructions_per_func

  st.val_len = 0
  st.ctrl_len = 0
  match st.push_ctrl(ctrl_func, [], func_results) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }

  let mut instr_count = 0
  while st.ctrl_len > 0 {
    if instr_count >= max_instrs {
      return Err(WasmError::LimitExceeded("max instructions per function exceeded"))
    }
    instr_count = instr_count + 1
    let off = br.pos
    if off >= br.end {
      return Err(WasmError::UnexpectedEof(off))
    }
    let op = br.data[off].to_int()
    br.pos = off + 1

    let res = if op <= 0x11 {
      validate_stream_ctrl_op(
        ctx,
        st,
        br,
        func_results,
        max_ctrl,
        decode_limits.max_br_table_targets,
        op,
        off,
      )
    } else if op >= 0x1A && op <= 0x26 {
      validate_stream_var_param_op(ctx, st, locals, br, decode_limits.max_results, op, off)
    } else if op >= 0x28 && op <= 0x40 {
      validate_stream_mem_op(ctx, st, br, op)
    } else if op == 0x41 {
      match br.read_varint32() {
        Ok(_) => st.push_val(vt_i32)
        Err(e) => Err(e)
      }
    } else if op == 0x42 {
      match br.read_varint64() {
        Ok(_) => st.push_val(vt_i64)
        Err(e) => Err(e)
      }
    } else if op == 0x43 {
      if 4 > br.end - br.pos {
        Err(WasmError::UnexpectedEof(br.pos))
      } else {
        br.pos = br.pos + 4
        st.push_val(vt_f32)
      }
    } else if op == 0x44 {
      if 8 > br.end - br.pos {
        Err(WasmError::UnexpectedEof(br.pos))
      } else {
        br.pos = br.pos + 8
        st.push_val(vt_f64)
      }
    } else if op >= 0x45 && op <= 0xC4 {
      validate_stream_num_op(st, op, off)
    } else if op == 0xD0 {
      match decode_ref_type(br) {
        Ok(rt) => st.push_val(ref_type_to_id(rt))
        Err(e) => Err(e)
      }
    } else if op == 0xD1 {
      match st.pop_val() {
        Ok(t) =>
        if t != vt_unknown && !is_ref_id(t) {
          Err(WasmError::ValidationError("ref.is_null requires reference type"))
        } else {
          st.push_val(vt_i32)
        }
        Err(e) => Err(e)
      }
    } else if op == 0xD2 {
      match br.read_u32_as_int() {
        Ok(fidx) =>
        if fidx < 0 || fidx >= ctx.func_types.length() {
          Err(WasmError::ValidationError("ref.func index out of bounds"))
        } else if !ctx.declared_funcs[fidx] {
          Err(WasmError::ValidationError("undeclared function reference"))
        } else {
          st.push_val(vt_funcref)
        }
        Err(e) => Err(e)
      }
    } else if op == 0xFC {
      validate_fc_stream(ctx, st, br, off)
    } else if op == 0xFD {
      validate_fd_stream(ctx, st, br, off)
    } else {
      Err(WasmError::InvalidOpcode(off, op))
    }

    match res {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }

  if br.pos != br.end {
    return Err(
      WasmError::SectionSizeMismatch(
        br.pos,
        "function body has trailing bytes: expected " +
        br.end.to_string() +
        ", got " +
        br.pos.to_string(),
      ),
    )
  }
  Ok(())
}

fn ensure_declared_funcs(declared_funcs : Array[Bool], count : Int) -> Unit {
  while declared_funcs.length() < count {
    declared_funcs.push(false)
  }
}

struct StreamState {
  types : Array[FuncType]
  type_params : Array[Array[Int]]
  type_results : Array[Array[Int]]
  func_types : Array[Int]
  defined_func_types : Array[Int]
  tables : Array[TableType]
  memories : Array[MemType]
  globals : Array[GlobalType]
  elem_types : Array[Int]
  declared_funcs : Array[Bool]
  mut imported_globals : Int
  mut has_data_count : Bool
  mut declared_data_count : Int
  mut actual_data_count : Int
  mut code_count : Int
}

fn stream_sec_type(
  ss : StreamState,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_types || count > validate_limits.max_types {
    return Err(WasmError::LimitExceeded("max_types exceeded"))
  }
  let mut i = 0
  while i < count {
    let off = sr.pos
    let form = match sr.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if form != 0x60 {
      return Err(WasmError::InvalidType(off, "expected 0x60 func type, got " + form.to_string()))
    }
    let pc = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if pc > decode_limits.max_params {
      return Err(WasmError::LimitExceeded("max_params exceeded"))
    }
    let params : Array[ValType] = []
    let param_ids : Array[Int] = []
    let mut j = 0
    while j < pc {
      match decode_val_type(sr) {
        Ok(vt) => {
          params.push(vt)
          param_ids.push(val_type_to_id(vt))
        }
        Err(e) => return Err(e)
      }
      j = j + 1
    }
    let rc = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if rc > decode_limits.max_results {
      return Err(WasmError::LimitExceeded("max_results exceeded"))
    }
    let results : Array[ValType] = []
    let result_ids : Array[Int] = []
    let mut k = 0
    while k < rc {
      match decode_val_type(sr) {
        Ok(vt) => {
          results.push(vt)
          result_ids.push(val_type_to_id(vt))
        }
        Err(e) => return Err(e)
      }
      k = k + 1
    }
    ss.types.push(FuncType::{ params: params, results: results })
    ss.type_params.push(param_ids)
    ss.type_results.push(result_ids)
    i = i + 1
  }
  Ok(())
}

fn stream_sec_import(
  ss : StreamState,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_imports {
    return Err(WasmError::LimitExceeded("max_imports exceeded"))
  }
  let mut i = 0
  while i < count {
    match skip_name(sr) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    match skip_name(sr) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let off = sr.pos
    let kind = match sr.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match kind {
      0x00 => {
        let tidx = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if tidx < 0 || tidx >= ss.types.length() {
          return Err(WasmError::ValidationError("import func type index out of bounds"))
        }
        ss.func_types.push(tidx)
      }
      0x01 => {
        let tt = match decode_table_type(sr) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        match validate_limits_obj(tt.limits, 4294967295L, false) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        ss.tables.push(tt)
      }
      0x02 => {
        let mt = match decode_mem_type(sr) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        match validate_limits_obj(mt.limits, validate_limits.max_memory_pages, true) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        ss.memories.push(mt)
      }
      0x03 => {
        let gt = match decode_global_type(sr) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        ss.globals.push(gt)
      }
      _ => return Err(WasmError::InvalidType(off, "unknown import kind " + kind.to_string()))
    }
    i = i + 1
  }
  ss.imported_globals = ss.globals.length()
  if ss.func_types.length() > validate_limits.max_functions {
    return Err(WasmError::LimitExceeded("max_functions exceeded"))
  }
  if ss.tables.length() > validate_limits.max_tables {
    return Err(WasmError::LimitExceeded("max_tables exceeded"))
  }
  if !validate_limits.allow_multi_memory && ss.memories.length() > 1 {
    return Err(WasmError::ValidationError("multiple memories not allowed"))
  }
  if ss.memories.length() > validate_limits.max_memories {
    return Err(WasmError::LimitExceeded("max_memories exceeded"))
  }
  if ss.globals.length() > validate_limits.max_globals {
    return Err(WasmError::LimitExceeded("max_globals exceeded"))
  }
  Ok(())
}

fn stream_sec_element(
  ss : StreamState,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_elements || count > validate_limits.max_elements {
    return Err(WasmError::LimitExceeded("max_elements exceeded"))
  }
  ensure_declared_funcs(ss.declared_funcs, ss.func_types.length())
  let mut i = 0
  while i < count {
    let off = sr.pos
    let flags = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if flags < 0 || flags > 7 {
      return Err(WasmError::InvalidImmediate(off, "invalid element segment flags " + flags.to_string()))
    }
    let is_passive_or_decl = (flags & 1) != 0
    let has_table_idx = (flags & 2) != 0 && !is_passive_or_decl
    let uses_exprs = (flags & 4) != 0

    let mut active_tidx = -1
    if !is_passive_or_decl {
      let tidx = if has_table_idx {
        match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
      } else {
        0
      }
      active_tidx = tidx
      match validate_const_expr_stream(
        sr,
        ss.func_types.length(),
        ss.globals,
        ss.imported_globals,
        ss.declared_funcs,
        vt_i32,
      ) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
    }

    let elem_type = if flags == 0 || flags == 4 {
      RefType::FuncRef
    } else if !uses_exprs {
      let ek_off = sr.pos
      let ek = match sr.read_byte() {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if ek != 0x00 {
        return Err(WasmError::InvalidType(ek_off, "expected elemkind 0x00, got " + ek.to_string()))
      }
      RefType::FuncRef
    } else {
      match decode_ref_type(sr) {
        Ok(rt) => rt
        Err(e) => return Err(e)
      }
    }
    let et_id = ref_type_to_id(elem_type)
    if active_tidx >= 0 {
      if active_tidx >= ss.tables.length() {
        return Err(WasmError::ValidationError("element segment table index out of bounds"))
      }
      if ref_type_to_id(ss.tables[active_tidx].elem_type) != et_id {
        return Err(WasmError::ValidationError("element segment type does not match table type"))
      }
    }

    let item_count = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if item_count > decode_limits.max_functions {
      return Err(WasmError::LimitExceeded("element item count exceeded"))
    }
    if !uses_exprs {
      let mut j = 0
      while j < item_count {
        let fidx = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if fidx < 0 || fidx >= ss.func_types.length() {
          return Err(WasmError::ValidationError("element func index out of bounds"))
        }
        ss.declared_funcs[fidx] = true
        j = j + 1
      }
    } else {
      let mut j = 0
      while j < item_count {
        match validate_const_expr_stream(
          sr,
          ss.func_types.length(),
          ss.globals,
          ss.imported_globals,
          ss.declared_funcs,
          et_id,
        ) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        j = j + 1
      }
    }
    ss.elem_types.push(et_id)
    i = i + 1
  }
  Ok(())
}

fn stream_sec_code(
  ss : StreamState,
  data : Bytes,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_functions {
    return Err(WasmError::LimitExceeded("max_functions exceeded in code section"))
  }
  if count != ss.defined_func_types.length() {
    return Err(WasmError::ValidationError("function and code section counts do not match"))
  }
  ss.code_count = count
  ensure_declared_funcs(ss.declared_funcs, ss.func_types.length())
  let ctx = ModuleContext::{
    types: ss.types,
    type_params: ss.type_params,
    type_results: ss.type_results,
    func_types: ss.func_types,
    tables: ss.tables,
    memories: ss.memories,
    globals: ss.globals,
    imported_globals: ss.imported_globals,
    elem_types: ss.elem_types,
    declared_funcs: ss.declared_funcs,
    num_data: ss.declared_data_count,
    has_data_count: ss.has_data_count,
  }
  let st = ValState::new(validate_limits)
  let mut i = 0
  while i < count {
    let body_size = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let body_start = sr.pos
    if body_size < 0 || body_size > sr.end - body_start {
      return Err(WasmError::UnexpectedEof(body_start))
    }
    let body_end = body_start + body_size
    let br = ByteReader::subrange(data, body_start, body_end)
    match validate_func_body_stream(
      ctx,
      st,
      ss.defined_func_types[i],
      br,
      decode_limits,
      validate_limits,
    ) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    sr.pos = body_end
    i = i + 1
  }
  Ok(())
}

fn stream_sec_data(
  ss : StreamState,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_data_segments || count > validate_limits.max_data_segments {
    return Err(WasmError::LimitExceeded("max_data_segments exceeded"))
  }
  ss.actual_data_count = count
  ensure_declared_funcs(ss.declared_funcs, ss.func_types.length())
  let mut i = 0
  while i < count {
    let off = sr.pos
    let mode_tag = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    match mode_tag {
      0 => {
        if ss.memories.length() == 0 {
          return Err(WasmError::ValidationError("data segment memory index out of bounds"))
        }
        match validate_const_expr_stream(
          sr,
          ss.func_types.length(),
          ss.globals,
          ss.imported_globals,
          ss.declared_funcs,
          vt_i32,
        ) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      1 => ()
      2 => {
        let midx = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if midx < 0 || midx >= ss.memories.length() {
          return Err(WasmError::ValidationError("data segment memory index out of bounds"))
        }
        match validate_const_expr_stream(
          sr,
          ss.func_types.length(),
          ss.globals,
          ss.imported_globals,
          ss.declared_funcs,
          vt_i32,
        ) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
      }
      _ => return Err(WasmError::InvalidImmediate(off, "invalid data mode " + mode_tag.to_string()))
    }
    let dlen = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if dlen < 0 || dlen > sr.end - sr.pos {
      return Err(WasmError::UnexpectedEof(sr.pos))
    }
    sr.pos = sr.pos + dlen
    i = i + 1
  }
  Ok(())
}

fn stream_sec_export(
  ss : StreamState,
  sr : ByteReader,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let count = match sr.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if count > decode_limits.max_exports || count > validate_limits.max_exports {
    return Err(WasmError::LimitExceeded("max_exports exceeded"))
  }
  ensure_declared_funcs(ss.declared_funcs, ss.func_types.length())
  let export_names : Map[String, Bool] = Map::new()
  let mut i = 0
  while i < count {
    let name = match sr.read_name() {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    match export_names.get(name) {
      Some(_) => return Err(WasmError::ValidationError("duplicate export name: " + name))
      None => export_names.set(name, true)
    }
    let off = sr.pos
    let k = match sr.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let idx = match sr.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let ok = match k {
      0x00 => {
        if idx >= 0 && idx < ss.func_types.length() {
          ss.declared_funcs[idx] = true
          true
        } else {
          false
        }
      }
      0x01 => idx >= 0 && idx < ss.tables.length()
      0x02 => idx >= 0 && idx < ss.memories.length()
      0x03 => idx >= 0 && idx < ss.globals.length()
      _ => return Err(WasmError::InvalidType(off, "unknown export kind " + k.to_string()))
    }
    if !ok {
      return Err(WasmError::ValidationError("export index out of bounds: " + name))
    }
    i = i + 1
  }
  Ok(())
}

fn validate_bytes_streaming(
  data : Bytes,
  decode_limits : DecodeLimits,
  validate_limits : ValidateLimits,
) -> Result[Unit, WasmError] {
  let total = data.length()
  if total < 8 {
    return Err(WasmError::UnexpectedEof(total))
  }
  if data[0].to_int() != 0x00 ||
  data[1].to_int() != 0x61 ||
  data[2].to_int() != 0x73 ||
  data[3].to_int() != 0x6D {
    return Err(WasmError::InvalidMagic(0))
  }
  let ver = data[4].to_int() |
  (data[5].to_int() << 8) |
  (data[6].to_int() << 16) |
  (data[7].to_int() << 24)
  if ver != 1 {
    return Err(WasmError::UnsupportedVersion(ver))
  }

  let ss = StreamState::{
    types: [],
    type_params: [],
    type_results: [],
    func_types: [],
    defined_func_types: [],
    tables: [],
    memories: [],
    globals: [],
    elem_types: [],
    declared_funcs: [],
    imported_globals: 0,
    has_data_count: false,
    declared_data_count: 0,
    actual_data_count: 0,
    code_count: 0,
  }

  let mut pos = 8
  let mut last_std_section = 0
  let mut section_count = 0

  while pos < total {
    if section_count >= decode_limits.max_sections {
      return Err(WasmError::LimitExceeded("max_sections exceeded"))
    }
    let r = ByteReader::subrange(data, pos, total)
    let id_off = r.pos
    let sec_id = match r.read_byte() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let sec_size = match r.read_u32_as_int() {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let sec_start = r.pos
    if sec_size < 0 || sec_size > total - sec_start {
      return Err(WasmError::UnexpectedEof(sec_start))
    }
    let sec_end = sec_start + sec_size
    let sr = ByteReader::subrange(data, sec_start, sec_end)

    if sec_id != 0 {
      let rank = section_order_rank(sec_id)
      if rank < 0 {
        return Err(WasmError::InvalidSectionId(id_off, sec_id))
      }
      if rank == last_std_section {
        return Err(WasmError::DuplicateSection(id_off, sec_id))
      }
      if rank < last_std_section {
        return Err(WasmError::InvalidSectionOrder(id_off, sec_id))
      }
      last_std_section = rank
    }

    let sec_res = match sec_id {
      0 => {
        match skip_name(sr) {
          Ok(_) => {
            sr.pos = sec_end
            Ok(())
          }
          Err(e) => Err(e)
        }
      }
      1 => stream_sec_type(ss, sr, decode_limits, validate_limits)
      2 => stream_sec_import(ss, sr, decode_limits, validate_limits)
      3 => {
        let count = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if count > decode_limits.max_functions {
          return Err(WasmError::LimitExceeded("max_functions exceeded"))
        }
        let mut i = 0
        while i < count {
          let tidx = match sr.read_u32_as_int() {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if tidx < 0 || tidx >= ss.types.length() {
            return Err(WasmError::ValidationError("function type index out of bounds"))
          }
          ss.func_types.push(tidx)
          ss.defined_func_types.push(tidx)
          i = i + 1
        }
        if ss.func_types.length() > validate_limits.max_functions {
          Err(WasmError::LimitExceeded("max_functions exceeded"))
        } else {
          Ok(())
        }
      }
      4 => {
        let count = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if count > decode_limits.max_tables {
          return Err(WasmError::LimitExceeded("max_tables exceeded"))
        }
        let mut i = 0
        while i < count {
          let tt = match decode_table_type(sr) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match validate_limits_obj(tt.limits, 4294967295L, false) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          ss.tables.push(tt)
          i = i + 1
        }
        if ss.tables.length() > validate_limits.max_tables {
          Err(WasmError::LimitExceeded("max_tables exceeded"))
        } else {
          Ok(())
        }
      }
      5 => {
        let count = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if count > decode_limits.max_memories {
          return Err(WasmError::LimitExceeded("max_memories exceeded"))
        }
        let mut i = 0
        while i < count {
          let mt = match decode_mem_type(sr) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match validate_limits_obj(mt.limits, validate_limits.max_memory_pages, true) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          ss.memories.push(mt)
          i = i + 1
        }
        if !validate_limits.allow_multi_memory && ss.memories.length() > 1 {
          Err(WasmError::ValidationError("multiple memories not allowed"))
        } else if ss.memories.length() > validate_limits.max_memories {
          Err(WasmError::LimitExceeded("max_memories exceeded"))
        } else {
          Ok(())
        }
      }
      6 => {
        let count = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if count > decode_limits.max_globals || ss.globals.length() + count > validate_limits.max_globals {
          return Err(WasmError::LimitExceeded("max_globals exceeded"))
        }
        ensure_declared_funcs(ss.declared_funcs, ss.func_types.length())
        let mut i = 0
        while i < count {
          let gt = match decode_global_type(sr) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          match validate_const_expr_stream(
            sr,
            ss.func_types.length(),
            ss.globals,
            ss.imported_globals,
            ss.declared_funcs,
            val_type_to_id(gt.val_type),
          ) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          ss.globals.push(gt)
          i = i + 1
        }
        Ok(())
      }
      7 => stream_sec_export(ss, sr, decode_limits, validate_limits)
      8 => {
        let fidx = match sr.read_u32_as_int() {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if fidx < 0 || fidx >= ss.func_types.length() {
          Err(WasmError::ValidationError("start function index out of bounds"))
        } else {
          let ft = ss.types[ss.func_types[fidx]]
          if ft.params.length() != 0 || ft.results.length() != 0 {
            Err(WasmError::ValidationError("start function must have type () -> ()"))
          } else {
            Ok(())
          }
        }
      }
      9 => stream_sec_element(ss, sr, decode_limits, validate_limits)
      12 =>
      match sr.read_u32_as_int() {
        Ok(dc) => {
          ss.has_data_count = true
          ss.declared_data_count = dc
          Ok(())
        }
        Err(e) => Err(e)
      }
      10 => stream_sec_code(ss, data, sr, decode_limits, validate_limits)
      11 => stream_sec_data(ss, sr, decode_limits, validate_limits)
      _ => Err(WasmError::InvalidSectionId(id_off, sec_id))
    }

    match sec_res {
      Ok(_) => ()
      Err(e) => return Err(e)
    }

    if sr.pos != sec_end {
      return Err(
        WasmError::SectionSizeMismatch(
          sr.pos,
          "section " + sec_id.to_string() + " did not consume all bytes",
        ),
      )
    }
    pos = sec_end
    section_count = section_count + 1
  }

  if ss.defined_func_types.length() != ss.code_count {
    return Err(WasmError::ValidationError("function and code section counts do not match"))
  }
  if ss.has_data_count && ss.declared_data_count != ss.actual_data_count {
    return Err(WasmError::ValidationError("DataCount does not match Data section length"))
  }
  Ok(())
}
