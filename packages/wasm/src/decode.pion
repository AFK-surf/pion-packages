///| Streaming WebAssembly binary parser and module decoder (Red-phase stubs).

///| Streaming section-by-section WebAssembly binary parser.
pub struct Parser {
  data : Bytes
  limits : DecodeLimits
  mut pos : Int
  mut header_parsed : Bool
  mut version : Int
  mut last_std_section : Int
  mut section_count : Int
}

///| Create a streaming `Parser` with default limits.
pub fn Parser::new(data : Bytes) -> Parser {
  Parser::with_limits(data, DecodeLimits::default())
}

///| Create a streaming `Parser` with custom limits.
pub fn Parser::with_limits(data : Bytes, limits : DecodeLimits) -> Parser {
  Parser::{
    data: data,
    limits: limits,
    pos: 0,
    header_parsed: false,
    version: 0,
    last_std_section: 0,
    section_count: 0,
  }
}

///| Parse and validate the 8-byte WebAssembly header (`\0asm` + version 1).
pub fn Parser::parse_header(self : Parser) -> Result[Int, WasmError] {
  let _ = self
  Err(WasmError::Unimplemented("Parser::parse_header"))
}

///| Parse the next section from the binary stream. Returns `Ok(None)` at EOF.
pub fn Parser::next_section(self : Parser) -> Result[Option[Section], WasmError] {
  let _ = self
  Err(WasmError::Unimplemented("Parser::next_section"))
}

///| Decode a complete WebAssembly binary module using default limits.
pub fn decode_module(data : Bytes) -> Result[Module, WasmError] {
  decode_module_with_limits(data, DecodeLimits::default())
}

///| Decode a complete WebAssembly binary module using custom limits.
pub fn decode_module_with_limits(data : Bytes, limits : DecodeLimits) -> Result[Module, WasmError] {
  let _ = data
  let _ = limits
  Err(WasmError::Unimplemented("decode_module_with_limits"))
}

///| Parse a `name` custom section payload.
pub fn decode_name_section(data : Bytes) -> Result[NameSection, WasmError] {
  let _ = data
  Err(WasmError::Unimplemented("decode_name_section"))
}
