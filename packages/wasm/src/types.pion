///| Core WebAssembly 1.0/2.0 types, AST, errors, and limits for `packages/wasm`.

///| Error returned by WebAssembly decoding, validation, encoding, or disassembly.
pub enum WasmError {
  UnexpectedEof(Int)
  InvalidMagic(Int)
  UnsupportedVersion(Int)
  InvalidLeb128(Int, String)
  InvalidUtf8(Int)
  InvalidSectionId(Int, Int)
  InvalidSectionOrder(Int, Int)
  DuplicateSection(Int, Int)
  SectionSizeMismatch(Int, String)
  InvalidType(Int, String)
  InvalidOpcode(Int, Int)
  InvalidImmediate(Int, String)
  ValidationError(String)
  LimitExceeded(String)
  EncodeError(String)
  Unimplemented(String)
}

///| Format a `WasmError` as a human-readable string.
pub fn wasm_error_message(e : WasmError) -> String {
  match e {
    WasmError::UnexpectedEof(off) => "unexpected EOF at offset " + off.to_string()
    WasmError::InvalidMagic(off) => "invalid wasm magic header at offset " + off.to_string()
    WasmError::UnsupportedVersion(ver) => "unsupported wasm binary version: " + ver.to_string()
    WasmError::InvalidLeb128(off, msg) => "invalid LEB128 at " + off.to_string() + ": " + msg
    WasmError::InvalidUtf8(off) => "invalid UTF-8 string at offset " + off.to_string()
    WasmError::InvalidSectionId(off, id) =>
    "invalid section id " + id.to_string() + " at offset " + off.to_string()
    WasmError::InvalidSectionOrder(off, id) =>
    "out-of-order section id " + id.to_string() + " at offset " + off.to_string()
    WasmError::DuplicateSection(off, id) =>
    "duplicate section id " + id.to_string() + " at offset " + off.to_string()
    WasmError::SectionSizeMismatch(off, msg) =>
    "section size mismatch at " + off.to_string() + ": " + msg
    WasmError::InvalidType(off, msg) => "invalid type at " + off.to_string() + ": " + msg
    WasmError::InvalidOpcode(off, op) =>
    "invalid opcode 0x" + op.to_string() + " at offset " + off.to_string()
    WasmError::InvalidImmediate(off, msg) =>
    "invalid immediate at " + off.to_string() + ": " + msg
    WasmError::ValidationError(msg) => "validation error: " + msg
    WasmError::LimitExceeded(msg) => "limit exceeded: " + msg
    WasmError::EncodeError(msg) => "encode error: " + msg
    WasmError::Unimplemented(msg) => "unimplemented: " + msg
  }
}

///| WebAssembly value types (MVP + Reference Types + SIMD).
pub enum ValType {
  I32
  I64
  F32
  F64
  V128
  FuncRef
  ExternRef
}

///| Return the binary encoding byte of a `ValType`.
pub fn val_type_code(vt : ValType) -> Int {
  match vt {
    ValType::I32 => 0x7F
    ValType::I64 => 0x7E
    ValType::F32 => 0x7D
    ValType::F64 => 0x7C
    ValType::V128 => 0x7B
    ValType::FuncRef => 0x70
    ValType::ExternRef => 0x6F
  }
}

///| Compare two `ValType` values for equality.
pub fn val_type_equals(a : ValType, b : ValType) -> Bool {
  val_type_code(a) == val_type_code(b)
}

///| Format a `ValType` in WAT syntax.
pub fn val_type_name(vt : ValType) -> String {
  match vt {
    ValType::I32 => "i32"
    ValType::I64 => "i64"
    ValType::F32 => "f32"
    ValType::F64 => "f64"
    ValType::V128 => "v128"
    ValType::FuncRef => "funcref"
    ValType::ExternRef => "externref"
  }
}

///| WebAssembly reference types.
pub enum RefType {
  FuncRef
  ExternRef
}

///| Return the binary encoding byte of a `RefType`.
pub fn ref_type_code(rt : RefType) -> Int {
  match rt {
    RefType::FuncRef => 0x70
    RefType::ExternRef => 0x6F
  }
}

///| Convert a `RefType` to a `ValType`.
pub fn ref_type_to_val_type(rt : RefType) -> ValType {
  match rt {
    RefType::FuncRef => ValType::FuncRef
    RefType::ExternRef => ValType::ExternRef
  }
}

///| Block type immediate for `block`, `loop`, and `if`.
pub enum BlockType {
  Empty
  Value(ValType)
  FuncType(Int)
}

///| Function type `(param ...) (result ...)`.
pub struct FuncType {
  pub params : Array[ValType]
  pub results : Array[ValType]
}

///| Construct a `FuncType`.
pub fn FuncType::new(params : Array[ValType], results : Array[ValType]) -> FuncType {
  FuncType::{ params: params, results: results }
}

///| Limits for tables and memories.
pub val struct Limits {
  pub min : Int64
  pub max : Option[Int64]
  pub is_memory64 : Bool
  pub shared : Bool
}

///| Construct a 32-bit `Limits`.
pub fn Limits::new(min : Int64, max : Option[Int64]) -> Limits {
  Limits::{ min: min, max: max, is_memory64: false, shared: false }
}

///| Table type.
pub val struct TableType {
  pub elem_type : RefType
  pub limits : Limits
}

///| Memory type.
pub val struct MemType {
  pub limits : Limits
}

///| Global type.
pub val struct GlobalType {
  pub val_type : ValType
  pub mutable : Bool
}

///| Import descriptor.
pub enum ImportDesc {
  Func(Int)
  Table(TableType)
  Memory(MemType)
  Global(GlobalType)
}

///| Module import entry.
pub struct Import {
  pub module_name : String
  pub name : String
  pub desc : ImportDesc
}

///| Export kind.
pub enum ExportKind {
  Func
  Table
  Memory
  Global
}

///| Export kind binary byte.
pub fn export_kind_code(k : ExportKind) -> Int {
  match k {
    ExportKind::Func => 0x00
    ExportKind::Table => 0x01
    ExportKind::Memory => 0x02
    ExportKind::Global => 0x03
  }
}

///| Module export entry.
pub struct Export {
  pub name : String
  pub kind : ExportKind
  pub index : Int
}

///| Memory argument (alignment as log2 and byte offset).
pub val struct MemArg {
  pub align : Int
  pub offset : Int64
  pub mem_idx : Int
}

///| Construct a `MemArg` for memory 0.
pub fn MemArg::new(align : Int, offset : Int64) -> MemArg {
  MemArg::{ align: align, offset: offset, mem_idx: 0 }
}

///| WebAssembly instruction (MVP + Sign-Ext + Non-Trapping Float-to-Int + Bulk-Memory + Multi-Value + Reference-Types + SIMD 0xFD).
pub enum Instr {
  // Control instructions
  Unreachable
  Nop
  Block(BlockType)
  Loop(BlockType)
  If(BlockType)
  Else
  End
  Br(Int)
  BrIf(Int)
  BrTable(Array[Int], Int)
  Return
  Call(Int)
  CallIndirect(Int, Int)

  // Parametric instructions
  Drop
  Select
  TypedSelect(Array[ValType])

  // Variable instructions
  LocalGet(Int)
  LocalSet(Int)
  LocalTee(Int)
  GlobalGet(Int)
  GlobalSet(Int)

  // Table instructions
  TableGet(Int)
  TableSet(Int)

  // Memory instructions
  I32Load(MemArg)
  I64Load(MemArg)
  F32Load(MemArg)
  F64Load(MemArg)
  I32Load8S(MemArg)
  I32Load8U(MemArg)
  I32Load16S(MemArg)
  I32Load16U(MemArg)
  I64Load8S(MemArg)
  I64Load8U(MemArg)
  I64Load16S(MemArg)
  I64Load16U(MemArg)
  I64Load32S(MemArg)
  I64Load32U(MemArg)
  I32Store(MemArg)
  I64Store(MemArg)
  F32Store(MemArg)
  F64Store(MemArg)
  I32Store8(MemArg)
  I32Store16(MemArg)
  I64Store8(MemArg)
  I64Store16(MemArg)
  I64Store32(MemArg)
  MemorySize(Int)
  MemoryGrow(Int)

  // Constants (f32/f64 stored as raw IEEE 754 bit patterns for lossless roundtrip)
  I32Const(Int)
  I64Const(Int64)
  F32Const(Int)
  F64Const(Int64)

  // Numeric comparisons & arithmetic (0x45..0xBF)
  I32Eqz
  I32Eq
  I32Ne
  I32LtS
  I32LtU
  I32GtS
  I32GtU
  I32LeS
  I32LeU
  I32GeS
  I32GeU

  I64Eqz
  I64Eq
  I64Ne
  I64LtS
  I64LtU
  I64GtS
  I64GtU
  I64LeS
  I64LeU
  I64GeS
  I64GeU

  F32Eq
  F32Ne
  F32Lt
  F32Gt
  F32Le
  F32Ge

  F64Eq
  F64Ne
  F64Lt
  F64Gt
  F64Le
  F64Ge

  I32Clz
  I32Ctz
  I32Popcnt
  I32Add
  I32Sub
  I32Mul
  I32DivS
  I32DivU
  I32RemS
  I32RemU
  I32And
  I32Or
  I32Xor
  I32Shl
  I32ShrS
  I32ShrU
  I32Rotl
  I32Rotr

  I64Clz
  I64Ctz
  I64Popcnt
  I64Add
  I64Sub
  I64Mul
  I64DivS
  I64DivU
  I64RemS
  I64RemU
  I64And
  I64Or
  I64Xor
  I64Shl
  I64ShrS
  I64ShrU
  I64Rotl
  I64Rotr

  F32Abs
  F32Neg
  F32Ceil
  F32Floor
  F32Trunc
  F32Nearest
  F32Sqrt
  F32Add
  F32Sub
  F32Mul
  F32Div
  F32Min
  F32Max
  F32Copysign

  F64Abs
  F64Neg
  F64Ceil
  F64Floor
  F64Trunc
  F64Nearest
  F64Sqrt
  F64Add
  F64Sub
  F64Mul
  F64Div
  F64Min
  F64Max
  F64Copysign

  I32WrapI64
  I32TruncF32S
  I32TruncF32U
  I32TruncF64S
  I32TruncF64U
  I64ExtendI32S
  I64ExtendI32U
  I64TruncF32S
  I64TruncF32U
  I64TruncF64S
  I64TruncF64U
  F32ConvertI32S
  F32ConvertI32U
  F32ConvertI64S
  F32ConvertI64U
  F32DemoteF64
  F64ConvertI32S
  F64ConvertI32U
  F64ConvertI64S
  F64ConvertI64U
  F64PromoteF32
  I32ReinterpretF32
  I64ReinterpretF64
  F32ReinterpretI32
  F64ReinterpretI64

  // Sign-extension operators (0xC0..0xC4)
  I32Extend8S
  I32Extend16S
  I64Extend8S
  I64Extend16S
  I64Extend32S

  // Reference instructions (0xD0..0xD2)
  RefNull(RefType)
  RefIsNull
  RefFunc(Int)

  // Non-trapping float-to-int conversions (0xFC 0..7)
  I32TruncSatF32S
  I32TruncSatF32U
  I32TruncSatF64S
  I32TruncSatF64U
  I64TruncSatF32S
  I64TruncSatF32U
  I64TruncSatF64S
  I64TruncSatF64U

  // Bulk memory & table instructions (0xFC 8..17)
  MemoryInit(Int, Int)
  DataDrop(Int)
  MemoryCopy(Int, Int)
  MemoryFill(Int)
  TableInit(Int, Int)
  ElemDrop(Int)
  TableCopy(Int, Int)
  TableGrow(Int)
  TableSize(Int)
  TableFill(Int)

  // SIMD 0xFD instructions
  V128Const(Bytes)
  I8x16Shuffle(Bytes)
  SimdMem(Int, MemArg)
  SimdMemLane(Int, MemArg, Int)
  SimdLane(Int, Int)
  SimdOp(Int)
}

///| Global definition.
pub struct Global {
  pub global_type : GlobalType
  pub init : Array[Instr]
}

///| Local variable declaration group (count, type).
pub val struct LocalGroup {
  pub count : Int
  pub val_type : ValType
}

///| Function body in the Code section.
pub struct FuncBody {
  pub locals : Array[LocalGroup]
  pub body : Array[Instr]
}

///| Element segment mode.
pub enum ElemMode {
  Passive
  Active(Int, Array[Instr])
  Declarative
}

///| Element segment items.
pub enum ElemItems {
  FuncIndices(Array[Int])
  Exprs(Array[Array[Instr]])
}

///| Element segment.
pub struct ElemSegment {
  pub mode : ElemMode
  pub elem_type : RefType
  pub items : ElemItems
  pub flags : Int
}

///| Data segment mode.
pub enum DataMode {
  Passive
  Active(Int, Array[Instr])
}

///| Data segment.
pub struct DataSegment {
  pub mode : DataMode
  pub data : Bytes
}

///| Custom section.
pub struct CustomSection {
  pub name : String
  pub data : Bytes
  pub order_after : Int
}

///| Name entry mapping an index to a name.
pub struct NameAssoc {
  pub index : Int
  pub name : String
}

///| Indirect name map (e.g., locals per function).
pub struct IndirectNameAssoc {
  pub index : Int
  pub names : Array[NameAssoc]
}

///| Parsed `name` custom section.
pub struct NameSection {
  pub module_name : Option[String]
  pub func_names : Array[NameAssoc]
  pub local_names : Array[IndirectNameAssoc]
  pub type_names : Array[NameAssoc]
  pub table_names : Array[NameAssoc]
  pub memory_names : Array[NameAssoc]
  pub global_names : Array[NameAssoc]
  pub elem_names : Array[NameAssoc]
  pub data_names : Array[NameAssoc]
}

///| Decoded WebAssembly module.
pub struct Module {
  pub version : Int
  pub types : Array[FuncType]
  pub imports : Array[Import]
  pub functions : Array[Int]
  pub tables : Array[TableType]
  pub memories : Array[MemType]
  pub globals : Array[Global]
  pub exports : Array[Export]
  pub start : Option[Int]
  pub elements : Array[ElemSegment]
  pub data_count : Option[Int]
  pub codes : Array[FuncBody]
  pub data : Array[DataSegment]
  pub custom_sections : Array[CustomSection]
  pub section_order : Array[Int]
}

///| Create an empty `Module` (version 1).
pub fn Module::empty() -> Module {
  Module::{
    version: 1,
    types: [],
    imports: [],
    functions: [],
    tables: [],
    memories: [],
    globals: [],
    exports: [],
    start: None,
    elements: [],
    data_count: None,
    codes: [],
    data: [],
    custom_sections: [],
    section_order: [],
  }
}

///| Streaming section yielded by `Parser::next`.
pub enum Section {
  Custom(CustomSection)
  Type(Array[FuncType])
  Import(Array[Import])
  Function(Array[Int])
  Table(Array[TableType])
  Memory(Array[MemType])
  Global(Array[Global])
  Export(Array[Export])
  Start(Int)
  Element(Array[ElemSegment])
  DataCount(Int)
  Code(Array[FuncBody])
  Data(Array[DataSegment])
}

///| Decoding resource limits to defend against malicious binaries.
pub val struct DecodeLimits {
  pub max_sections : Int
  pub max_types : Int
  pub max_imports : Int
  pub max_functions : Int
  pub max_tables : Int
  pub max_memories : Int
  pub max_globals : Int
  pub max_exports : Int
  pub max_elements : Int
  pub max_data_segments : Int
  pub max_locals_per_func : Int
  pub max_params : Int
  pub max_results : Int
  pub max_br_table_targets : Int
  pub max_control_depth : Int
  pub max_instructions_per_func : Int
}

///| Default `DecodeLimits`.
pub fn DecodeLimits::default() -> DecodeLimits {
  DecodeLimits::{
    max_sections: 100000,
    max_types: 1000000,
    max_imports: 100000,
    max_functions: 1000000,
    max_tables: 100000,
    max_memories: 100,
    max_globals: 1000000,
    max_exports: 100000,
    max_elements: 100000,
    max_data_segments: 100000,
    max_locals_per_func: 50000,
    max_params: 1000,
    max_results: 1000,
    max_br_table_targets: 100000,
    max_control_depth: 1024,
    max_instructions_per_func: 1000000,
  }
}

///| Validation limits & feature flags.
pub val struct ValidateLimits {
  pub max_types : Int
  pub max_functions : Int
  pub max_tables : Int
  pub max_memories : Int
  pub max_globals : Int
  pub max_exports : Int
  pub max_elements : Int
  pub max_data_segments : Int
  pub max_locals_per_func : Int
  pub max_control_depth : Int
  pub max_stack_height : Int
  pub max_memory_pages : Int64
  pub allow_multi_memory : Bool
}

///| Default `ValidateLimits` (WebAssembly 1.0/2.0 core).
pub fn ValidateLimits::default() -> ValidateLimits {
  ValidateLimits::{
    max_types: 1000000,
    max_functions: 1000000,
    max_tables: 100000,
    max_memories: 1,
    max_globals: 1000000,
    max_exports: 100000,
    max_elements: 100000,
    max_data_segments: 100000,
    max_locals_per_func: 50000,
    max_control_depth: 1024,
    max_stack_height: 65536,
    max_memory_pages: 65536L,
    allow_multi_memory: false,
  }
}
