///| Strict WebAssembly LEB128 reader/writer and UTF-8 validation.

///| Decode a single-byte signed LEB128 (`0x00..0x7F`) to its signed 7-bit value in `[-64, 63]`.
#verify
pub fn leb128_i32_single_byte(b : Int) -> Int {
  if (b & 0x40) != 0 {
    b - 128
  } else {
    b
  }
}

///| Validate the 5th (terminal) byte of an unsigned 32-bit LEB128 encoding (Wasm 2.0 §5.2.2).
#verify
pub fn leb128_u32_5th_valid(b : Int) -> Bool {
  b >= 0 && b < 0x10
}

///| Validate the 10th (terminal) byte of an unsigned 64-bit LEB128 encoding (Wasm 2.0 §5.2.2).
pub fn leb128_u64_10th_valid(b : Int) -> Bool {
  b >= 0 && b < 0x02
}

///| Validate the 5th (terminal) byte of a signed 32-bit LEB128 encoding (bit 7 == 0, bits 4..6 == sign bit 3).
#verify
pub fn leb128_i32_5th_valid(b : Int) -> Bool {
  if (b & 0x80) != 0 {
    return false
  }
  let sign_bit = (b & 0x08) != 0
  let high = b & 0x70
  (!sign_bit && high == 0) || (sign_bit && high == 0x70)
}

///| Validate the 10th (terminal) byte of a signed 64-bit LEB128 encoding (must be 0x00 or 0x7F).
pub fn leb128_i64_10th_valid(b : Int) -> Bool {
  b == 0x00 || b == 0x7F
}

///| Validate the 5th (terminal) byte of a signed 33-bit LEB128 encoding (bit 7 == 0, bits 5..6 == sign bit 4).
pub fn leb128_s33_5th_valid(b : Int) -> Bool {
  if (b & 0x80) != 0 {
    return false
  }
  let sign_bit = (b & 0x10) != 0
  let high = b & 0x60
  (!sign_bit && high == 0) || (sign_bit && high == 0x60)
}

///| Binary byte cursor.
pub struct ByteReader {
  pub data : Bytes
  pub mut pos : Int
  pub end : Int
  mut err : Option[WasmError]
  mut failed : Bool
}

///| Create a `ByteReader` over `data`.
pub fn ByteReader::new(data : Bytes) -> ByteReader {
  ByteReader::{ data: data, pos: 0, end: data.length(), err: None, failed: false }
}

///| Create a `ByteReader` over a sub-range `[start, end)`.
pub fn ByteReader::subrange(data : Bytes, start : Int, end : Int) -> ByteReader {
  ByteReader::{ data: data, pos: start, end: end, err: None, failed: false }
}

fn ByteReader::fail(self : ByteReader, e : WasmError) -> Unit {
  self.failed = true
  self.err = Some(e)
}

fn ByteReader::take_err(self : ByteReader) -> WasmError {
  match self.err {
    Some(e) => e
    None => WasmError::UnexpectedEof(self.pos)
  }
}

fn ByteReader::read_byte_raw(self : ByteReader) -> Int {
  let p = self.pos
  if p < self.end {
    let b = self.data[p].to_int()
    self.pos = p + 1
    return b
  }
  self.fail(WasmError::UnexpectedEof(p))
  -1
}

fn ByteReader::read_bytes_raw(self : ByteReader, n : Int) -> Bytes {
  let p = self.pos
  if n < 0 || n > self.end - p {
    self.fail(WasmError::UnexpectedEof(p))
    return Bytes::new(0)
  }
  let out = self.data.slice(p, p + n)
  self.pos = p + n
  out
}

fn ByteReader::read_u32_le_raw(self : ByteReader) -> Int {
  let p = self.pos
  if 4 > self.end - p {
    self.fail(WasmError::UnexpectedEof(p))
    return 0
  }
  let d = self.data
  let v = d[p].to_int() |
  (d[p + 1].to_int() << 8) |
  (d[p + 2].to_int() << 16) |
  (d[p + 3].to_int() << 24)
  self.pos = p + 4
  v
}

fn ByteReader::read_u64_le_raw(self : ByteReader) -> Int64 {
  let p = self.pos
  if 8 > self.end - p {
    self.fail(WasmError::UnexpectedEof(p))
    return 0L
  }
  let d = self.data
  let v = d[p].to_int().to_int64() |
  (d[p + 1].to_int().to_int64() << 8) |
  (d[p + 2].to_int().to_int64() << 16) |
  (d[p + 3].to_int().to_int64() << 24) |
  (d[p + 4].to_int().to_int64() << 32) |
  (d[p + 5].to_int().to_int64() << 40) |
  (d[p + 6].to_int().to_int64() << 48) |
  (d[p + 7].to_int().to_int64() << 56)
  self.pos = p + 8
  v
}

fn ByteReader::read_varuint32_raw_slow(self : ByteReader, start : Int, b0 : Int) -> Int64 {
  let mut result : Int64 = (b0 & 0x7F).to_int64()
  let mut shift = 7
  let mut p = start + 1
  while true {
    if p >= self.end {
      self.pos = p
      self.fail(WasmError::UnexpectedEof(p))
      return -1L
    }
    let b = self.data[p].to_int()
    p = p + 1
    if shift == 28 {
      if !leb128_u32_5th_valid(b) {
        self.pos = p
        self.fail(WasmError::InvalidLeb128(start, "u32 overflow or overlong"))
        return -1L
      }
      result = result | (b.to_int64() << 28)
      self.pos = p
      return result
    }
    result = result | ((b & 0x7F).to_int64() << shift)
    if (b & 0x80) == 0 {
      self.pos = p
      return result
    }
    shift = shift + 7
  }
  self.fail(WasmError::InvalidLeb128(start, "u32 unreachable"))
  -1L
}

fn ByteReader::read_varuint32_raw(self : ByteReader) -> Int64 {
  let start = self.pos
  if start < self.end {
    let b0 = self.data[start].to_int()
    if b0 < 0x80 {
      self.pos = start + 1
      return b0.to_int64()
    }
    return self.read_varuint32_raw_slow(start, b0)
  }
  self.fail(WasmError::UnexpectedEof(start))
  -1L
}

fn ByteReader::read_u32_as_int_raw_slow(self : ByteReader, start : Int, b0 : Int) -> Int {
  let v = self.read_varuint32_raw_slow(start, b0)
  if v < 0L {
    return -1
  }
  if v > 2147483647L {
    self.fail(WasmError::LimitExceeded("u32 value exceeds Int max at " + start.to_string()))
    return -1
  }
  v.to_int()
}

fn ByteReader::read_u32_as_int_raw(self : ByteReader) -> Int {
  let start = self.pos
  if start < self.end {
    let b0 = self.data[start].to_int()
    if b0 < 0x80 {
      self.pos = start + 1
      return b0
    }
    return self.read_u32_as_int_raw_slow(start, b0)
  }
  self.fail(WasmError::UnexpectedEof(start))
  -1
}

fn ByteReader::read_varint32_raw_slow(self : ByteReader, start : Int, b0 : Int) -> Int64 {
  let mut result : Int64 = (b0 & 0x7F).to_int64()
  let mut shift = 7
  let mut p = start + 1
  while true {
    if p >= self.end {
      self.pos = p
      self.fail(WasmError::UnexpectedEof(p))
      return 2147483648L
    }
    let b = self.data[p].to_int()
    p = p + 1
    if shift == 28 {
      if !leb128_i32_5th_valid(b) {
        self.pos = p
        if (b & 0x80) != 0 {
          self.fail(WasmError::InvalidLeb128(start, "i32 overlong"))
        } else {
          self.fail(WasmError::InvalidLeb128(start, "i32 bad sign extension"))
        }
        return 2147483648L
      }
      let sign_bit = (b & 0x08) != 0
      result = result | ((b & 0x0F).to_int64() << 28)
      if sign_bit {
        result = result | (-4294967296L)
      }
      self.pos = p
      return result
    }
    result = result | ((b & 0x7F).to_int64() << shift)
    shift = shift + 7
    if (b & 0x80) == 0 {
      if (b & 0x40) != 0 {
        result = result | ((-1L) << shift)
      }
      self.pos = p
      return result
    }
  }
  self.fail(WasmError::InvalidLeb128(start, "i32 unreachable"))
  2147483648L
}

fn ByteReader::read_varint32_raw(self : ByteReader) -> Int64 {
  let start = self.pos
  if start < self.end {
    let b0 = self.data[start].to_int()
    if b0 < 0x80 {
      self.pos = start + 1
      if (b0 & 0x40) != 0 {
        return (b0 - 128).to_int64()
      }
      return b0.to_int64()
    }
    return self.read_varint32_raw_slow(start, b0)
  }
  self.fail(WasmError::UnexpectedEof(start))
  2147483648L
}

fn ByteReader::skip_varint32_raw_slow(self : ByteReader, start : Int) -> Bool {
  let mut shift = 7
  let mut p = start + 1
  while true {
    if p >= self.end {
      self.pos = p
      self.fail(WasmError::UnexpectedEof(p))
      return false
    }
    let b = self.data[p].to_int()
    p = p + 1
    if shift == 28 {
      if !leb128_i32_5th_valid(b) {
        self.pos = p
        if (b & 0x80) != 0 {
          self.fail(WasmError::InvalidLeb128(start, "i32 overlong"))
        } else {
          self.fail(WasmError::InvalidLeb128(start, "i32 bad sign extension"))
        }
        return false
      }
      self.pos = p
      return true
    }
    if (b & 0x80) == 0 {
      self.pos = p
      return true
    }
    shift = shift + 7
  }
  false
}

fn ByteReader::skip_varint32_raw(self : ByteReader) -> Bool {
  let start = self.pos
  if start < self.end {
    let b0 = self.data[start].to_int()
    if b0 < 0x80 {
      self.pos = start + 1
      return true
    }
    return self.skip_varint32_raw_slow(start)
  }
  self.fail(WasmError::UnexpectedEof(start))
  false
}

fn ByteReader::read_varint64_raw_slow(self : ByteReader, start : Int, b0 : Int) -> Int64 {
  let mut result : Int64 = (b0 & 0x7F).to_int64()
  let mut shift = 7
  let mut p = start + 1
  while true {
    if p >= self.end {
      self.pos = p
      self.fail(WasmError::UnexpectedEof(p))
      return 0L
    }
    let b = self.data[p].to_int()
    p = p + 1
    if shift == 63 {
      if !leb128_i64_10th_valid(b) {
        self.pos = p
        if (b & 0x80) != 0 {
          self.fail(WasmError::InvalidLeb128(start, "i64 overlong"))
        } else {
          self.fail(WasmError::InvalidLeb128(start, "i64 bad sign extension"))
        }
        return 0L
      }
      result = result | ((b & 0x01).to_int64() << 63)
      self.pos = p
      return result
    }
    result = result | ((b & 0x7F).to_int64() << shift)
    shift = shift + 7
    if (b & 0x80) == 0 {
      if (b & 0x40) != 0 {
        result = result | ((-1L) << shift)
      }
      self.pos = p
      return result
    }
  }
  self.fail(WasmError::InvalidLeb128(start, "i64 unreachable"))
  0L
}

fn ByteReader::read_varint64_raw(self : ByteReader) -> Int64 {
  let start = self.pos
  if start < self.end {
    let b0 = self.data[start].to_int()
    if b0 < 0x80 {
      self.pos = start + 1
      if (b0 & 0x40) != 0 {
        return (b0 - 128).to_int64()
      }
      return b0.to_int64()
    }
    return self.read_varint64_raw_slow(start, b0)
  }
  self.fail(WasmError::UnexpectedEof(start))
  0L
}

fn ByteReader::skip_varint64_raw_slow(self : ByteReader, start : Int) -> Bool {
  let mut shift = 7
  let mut p = start + 1
  while true {
    if p >= self.end {
      self.pos = p
      self.fail(WasmError::UnexpectedEof(p))
      return false
    }
    let b = self.data[p].to_int()
    p = p + 1
    if shift == 63 {
      if !leb128_i64_10th_valid(b) {
        self.pos = p
        if (b & 0x80) != 0 {
          self.fail(WasmError::InvalidLeb128(start, "i64 overlong"))
        } else {
          self.fail(WasmError::InvalidLeb128(start, "i64 bad sign extension"))
        }
        return false
      }
      self.pos = p
      return true
    }
    if (b & 0x80) == 0 {
      self.pos = p
      return true
    }
    shift = shift + 7
  }
  false
}

fn ByteReader::skip_varint64_raw(self : ByteReader) -> Bool {
  let start = self.pos
  if start < self.end {
    let b0 = self.data[start].to_int()
    if b0 < 0x80 {
      self.pos = start + 1
      return true
    }
    return self.skip_varint64_raw_slow(start)
  }
  self.fail(WasmError::UnexpectedEof(start))
  false
}

fn ByteReader::read_varint33_raw(self : ByteReader) -> Int64 {
  let start = self.pos
  if start >= self.end {
    self.fail(WasmError::UnexpectedEof(start))
    return 0L
  }
  let b0 = self.data[start].to_int()
  if b0 < 0x80 {
    self.pos = start + 1
    if (b0 & 0x40) != 0 {
      return (b0 - 128).to_int64()
    }
    return b0.to_int64()
  }
  let mut result : Int64 = (b0 & 0x7F).to_int64()
  let mut shift = 7
  let mut p = start + 1
  while true {
    if p >= self.end {
      self.pos = p
      self.fail(WasmError::UnexpectedEof(p))
      return 0L
    }
    let b = self.data[p].to_int()
    p = p + 1
    if shift == 28 {
      if !leb128_s33_5th_valid(b) {
        self.pos = p
        if (b & 0x80) != 0 {
          self.fail(WasmError::InvalidLeb128(start, "s33 overlong"))
        } else {
          self.fail(WasmError::InvalidLeb128(start, "s33 bad sign extension"))
        }
        return 0L
      }
      let sign_bit = (b & 0x10) != 0
      result = result | ((b & 0x1F).to_int64() << 28)
      if sign_bit {
        result = result | ((-1L) << 33)
      }
      self.pos = p
      return result
    }
    result = result | ((b & 0x7F).to_int64() << shift)
    shift = shift + 7
    if (b & 0x80) == 0 {
      if (b & 0x40) != 0 {
        result = result | ((-1L) << shift)
      }
      self.pos = p
      return result
    }
  }
  self.fail(WasmError::InvalidLeb128(start, "s33 unreachable"))
  0L
}

///| Remaining unread bytes.
pub fn ByteReader::remaining(self : ByteReader) -> Int {
  self.end - self.pos
}

///| Whether cursor reached end.
pub fn ByteReader::is_eof(self : ByteReader) -> Bool {
  self.pos >= self.end
}

///| Read a single byte as `Int` (0..255).
pub fn ByteReader::read_byte(self : ByteReader) -> Result[Int, WasmError] {
  self.failed = false
  let b = self.read_byte_raw()
  if b < 0 {
    Err(self.take_err())
  } else {
    Ok(b)
  }
}

///| Read `n` raw bytes as a `Bytes` slice.
pub fn ByteReader::read_bytes(self : ByteReader, n : Int) -> Result[Bytes, WasmError] {
  self.failed = false
  let out = self.read_bytes_raw(n)
  if self.failed {
    Err(self.take_err())
  } else {
    Ok(out)
  }
}

///| Read little-endian 32-bit integer (raw bits in `Int`).
pub fn ByteReader::read_u32_le(self : ByteReader) -> Result[Int, WasmError] {
  self.failed = false
  let v = self.read_u32_le_raw()
  if self.failed {
    Err(self.take_err())
  } else {
    Ok(v)
  }
}

///| Read little-endian 64-bit integer (raw bits in `Int64`).
pub fn ByteReader::read_u64_le(self : ByteReader) -> Result[Int64, WasmError] {
  self.failed = false
  let v = self.read_u64_le_raw()
  if self.failed {
    Err(self.take_err())
  } else {
    Ok(v)
  }
}

///| Read an unsigned 32-bit LEB128 integer (returned as `Int64` in `0..4294967295`).
pub fn ByteReader::read_varuint32(self : ByteReader) -> Result[Int64, WasmError] {
  self.failed = false
  let v = self.read_varuint32_raw()
  if v < 0L {
    Err(self.take_err())
  } else {
    Ok(v)
  }
}

///| Read an unsigned 32-bit LEB128 as `Int` (rejects values > 2^31-1 for safe indexing).
pub fn ByteReader::read_u32_as_int(self : ByteReader) -> Result[Int, WasmError] {
  self.failed = false
  let v = self.read_u32_as_int_raw()
  if v < 0 {
    Err(self.take_err())
  } else {
    Ok(v)
  }
}

///| Read an unsigned 64-bit LEB128 integer.
pub fn ByteReader::read_varuint64(self : ByteReader) -> Result[UInt64, WasmError] {
  let start = self.pos
  if start >= self.end {
    return Err(WasmError::UnexpectedEof(start))
  }
  let b0 = self.data[start].to_int()
  if b0 < 0x80 {
    self.pos = start + 1
    return Ok(b0.to_int64().to_uint64())
  }
  let mut result : UInt64 = (b0 & 0x7F).to_int64().to_uint64()
  let mut shift = 7
  let mut p = start + 1
  while true {
    if p >= self.end {
      self.pos = p
      return Err(WasmError::UnexpectedEof(p))
    }
    let b = self.data[p].to_int()
    p = p + 1
    if shift == 63 {
      // 10th byte: only bit 0 allowed (0x00 or 0x01)
      if !leb128_u64_10th_valid(b) {
        self.pos = p
        return Err(WasmError::InvalidLeb128(start, "u64 overflow or overlong"))
      }
      result = result | (b.to_int64().to_uint64() << 63)
      self.pos = p
      return Ok(result)
    }
    result = result | ((b & 0x7F).to_int64().to_uint64() << shift)
    if (b & 0x80) == 0 {
      self.pos = p
      return Ok(result)
    }
    shift = shift + 7
  }
  Err(WasmError::InvalidLeb128(start, "u64 unreachable"))
}

///| Read a signed 32-bit LEB128 integer.
pub fn ByteReader::read_varint32(self : ByteReader) -> Result[Int, WasmError] {
  self.failed = false
  let v = self.read_varint32_raw()
  if v == 2147483648L {
    Err(self.take_err())
  } else {
    Ok(v.to_int())
  }
}

///| Read a signed 64-bit LEB128 integer.
pub fn ByteReader::read_varint64(self : ByteReader) -> Result[Int64, WasmError] {
  self.failed = false
  let v = self.read_varint64_raw()
  if self.failed {
    Err(self.take_err())
  } else {
    Ok(v)
  }
}

///| Read a signed 33-bit LEB128 integer (for WebAssembly `BlockType`).
pub fn ByteReader::read_varint33(self : ByteReader) -> Result[Int64, WasmError] {
  self.failed = false
  let v = self.read_varint33_raw()
  if self.failed {
    Err(self.take_err())
  } else {
    Ok(v)
  }
}

///| Validate strict UTF-8 over `data[start..end)`.
pub fn validate_utf8_range(data : Bytes, start : Int, end : Int) -> Bool {
  let mut i = start
  while i < end {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xE0 && b1 < 0xA0 {
        return false
      }
      if b0 == 0xED && b1 >= 0xA0 {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= end {
        return false
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if b0 == 0xF0 && b1 < 0x90 {
        return false
      }
      if b0 == 0xF4 && b1 >= 0x90 {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

///| Read a length-prefixed UTF-8 WebAssembly name.
pub fn ByteReader::read_name(self : ByteReader) -> Result[String, WasmError] {
  let n = match self.read_u32_as_int() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let start = self.pos
  if n < 0 || n > self.end - start {
    return Err(WasmError::UnexpectedEof(start))
  }
  if !validate_utf8_range(self.data, start, start + n) {
    return Err(WasmError::InvalidUtf8(start))
  }
  let s = self.data.slice(start, start + n).to_string()
  self.pos = start + n
  Ok(s)
}

///| Growable binary writer.
pub struct ByteWriter {
  mut buf : Bytes
  mut len : Int
}

///| Create a `ByteWriter`.
pub fn ByteWriter::new() -> ByteWriter {
  ByteWriter::{ buf: Bytes::new(256), len: 0 }
}

///| Create a `ByteWriter` with initial capacity.
pub fn ByteWriter::with_capacity(cap : Int) -> ByteWriter {
  let c = if cap < 16 { 16 } else { cap }
  ByteWriter::{ buf: Bytes::new(c), len: 0 }
}

fn ByteWriter::ensure(self : ByteWriter, extra : Int) -> Unit {
  let need = self.len + extra
  if need <= self.buf.length() {
    return ()
  }
  let mut new_cap = self.buf.length() * 2
  while new_cap < need {
    new_cap = new_cap * 2
  }
  let nb = Bytes::new(new_cap)
  let mut i = 0
  while i < self.len {
    nb[i] = self.buf[i]
    i = i + 1
  }
  self.buf = nb
}

///| Append a single byte.
pub fn ByteWriter::push_byte(self : ByteWriter, b : Int) -> Unit {
  let l = self.len
  if l < self.buf.length() {
    self.buf[l] = b.to_byte()
    self.len = l + 1
    return ()
  }
  self.ensure(1)
  self.buf[l] = b.to_byte()
  self.len = l + 1
}

fn ByteWriter::push_bytes_range(self : ByteWriter, data : Bytes, start : Int, n : Int) -> Unit {
  if n <= 0 {
    return ()
  }
  self.ensure(n)
  let base = self.len
  let mut i = 0
  while i < n {
    self.buf[base + i] = data[start + i]
    i = i + 1
  }
  self.len = base + n
}

///| Append raw `Bytes`.
pub fn ByteWriter::push_bytes(self : ByteWriter, data : Bytes) -> Unit {
  self.push_bytes_range(data, 0, data.length())
}

///| Write little-endian 32-bit integer.
pub fn ByteWriter::write_u32_le(self : ByteWriter, v : Int) -> Unit {
  self.ensure(4)
  let p = self.len
  self.buf[p] = (v & 0xFF).to_byte()
  self.buf[p + 1] = ((v >> 8) & 0xFF).to_byte()
  self.buf[p + 2] = ((v >> 16) & 0xFF).to_byte()
  self.buf[p + 3] = ((v >> 24) & 0xFF).to_byte()
  self.len = p + 4
}

///| Write little-endian 64-bit integer.
pub fn ByteWriter::write_u64_le(self : ByteWriter, v : Int64) -> Unit {
  self.ensure(8)
  let p = self.len
  self.buf[p] = (v & 0xFFL).to_int().to_byte()
  self.buf[p + 1] = ((v >> 8) & 0xFFL).to_int().to_byte()
  self.buf[p + 2] = ((v >> 16) & 0xFFL).to_int().to_byte()
  self.buf[p + 3] = ((v >> 24) & 0xFFL).to_int().to_byte()
  self.buf[p + 4] = ((v >> 32) & 0xFFL).to_int().to_byte()
  self.buf[p + 5] = ((v >> 40) & 0xFFL).to_int().to_byte()
  self.buf[p + 6] = ((v >> 48) & 0xFFL).to_int().to_byte()
  self.buf[p + 7] = ((v >> 56) & 0xFFL).to_int().to_byte()
  self.len = p + 8
}

///| Write unsigned 32-bit LEB128.
pub fn ByteWriter::write_varuint32(self : ByteWriter, v : Int64) -> Unit {
  if v >= 0L && v < 128L {
    self.push_byte(v.to_int())
    return ()
  }
  let mut x : UInt64 = (v & 0xFFFFFFFFL).to_uint64()
  while true {
    let mut b = (x & 0x7FUL).to_int64().to_int()
    x = x >> 7
    if x != 0UL {
      b = b | 0x80
    }
    self.push_byte(b)
    if x == 0UL {
      break
    }
  }
}

///| Write unsigned 64-bit LEB128.
pub fn ByteWriter::write_varuint64(self : ByteWriter, v : UInt64) -> Unit {
  let mut x = v
  while true {
    let mut b = (x & 0x7FUL).to_int64().to_int()
    x = x >> 7
    if x != 0UL {
      b = b | 0x80
    }
    self.push_byte(b)
    if x == 0UL {
      break
    }
  }
}

///| Write signed 32-bit LEB128.
pub fn ByteWriter::write_varint32(self : ByteWriter, v : Int) -> Unit {
  if v >= -64 && v < 64 {
    self.push_byte(v & 0x7F)
    return ()
  }
  let mut x : Int64 = v.to_int64()
  while true {
    let b = (x & 0x7FL).to_int()
    x = x >> 7
    let done = (x == 0L && (b & 0x40) == 0) || (x == -1L && (b & 0x40) != 0)
    if done {
      self.push_byte(b)
      break
    } else {
      self.push_byte(b | 0x80)
    }
  }
}

///| Write signed 64-bit LEB128.
pub fn ByteWriter::write_varint64(self : ByteWriter, v : Int64) -> Unit {
  let mut x = v
  while true {
    let b = (x & 0x7FL).to_int()
    x = x >> 7
    let done = (x == 0L && (b & 0x40) == 0) || (x == -1L && (b & 0x40) != 0)
    if done {
      self.push_byte(b)
      break
    } else {
      self.push_byte(b | 0x80)
    }
  }
}

///| Write signed 33-bit LEB128.
pub fn ByteWriter::write_varint33(self : ByteWriter, v : Int64) -> Unit {
  self.write_varint64(v)
}

///| Write a length-prefixed UTF-8 WebAssembly name.
pub fn ByteWriter::write_name(self : ByteWriter, s : String) -> Unit {
  let bs = s.to_bytes()
  self.write_varuint32(bs.length().to_int64())
  self.push_bytes(bs)
}

///| Write a WebAssembly section (id + byte length + payload).
pub fn ByteWriter::write_section(self : ByteWriter, id : Int, payload : Bytes) -> Unit {
  self.push_byte(id)
  self.write_varuint32(payload.length().to_int64())
  self.push_bytes(payload)
}

///| Extract written bytes.
pub fn ByteWriter::to_bytes(self : ByteWriter) -> Bytes {
  self.buf.slice(0, self.len)
}
