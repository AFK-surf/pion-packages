        80 => "v128.or"
        81 => "v128.xor"
        82 => "v128.bitselect"
        83 => "v128.any_true"
        94 => "f32x4.demote_f64x2_zero"
        95 => "f64x2.promote_low_f32x4"
        96 => "i8x16.abs"
