///| WebAssembly Text Format (WAT) disassembler.

fn hex_byte(n : Int) -> Byte {
  let d = n & 0xF
  if d < 10 {
    (48 + d).to_byte()
  } else {
    (87 + d).to_byte()
  }
}

fn write_hex_nibble(sb : StringBuilder, n : Int) -> Unit {
  sb.write_byte(hex_byte(n))
}

fn write_byte_hex(sb : StringBuilder, b : Int) -> Unit {
  sb.write_byte(hex_byte(b >> 4))
  sb.write_byte(hex_byte(b & 0xF))
}

fn write_uint64_digits(sb : StringBuilder, v : Int64) -> Unit {
  if v >= 10L {
    write_uint64_digits(sb, v / 10L)
  }
  sb.write_byte((48 + (v % 10L).to_int()).to_byte())
}

fn write_int64(sb : StringBuilder, v : Int64) -> Unit {
  if v == 0L {
    sb.write_byte((48).to_byte())
    return ()
  }
  if v == -9223372036854775807L - 1L {
    sb.write_string("-9223372036854775808")
    return ()
  }
  if v < 0L {
    sb.write_byte((45).to_byte())
    write_uint64_digits(sb, 0L - v)
  } else {
    write_uint64_digits(sb, v)
  }
}

fn write_int(sb : StringBuilder, v : Int) -> Unit {
  if v >= 0 && v < 10 {
    sb.write_byte((48 + v).to_byte())
    return ()
  }
  write_int64(sb, v.to_int64())
}

fn write_wat_string(sb : StringBuilder, s : String) -> Unit {
  sb.write_byte((0x22).to_byte())
  let bs = s.to_bytes()
  let mut i = 0
  while i < bs.length() {
    let b = bs[i].to_int()
    if b == 0x22 {
      sb.write_string("\\\"")
    } else if b == 0x5C {
      sb.write_string("\\\\")
    } else if b == 0x0A {
      sb.write_string("\\n")
    } else if b == 0x0D {
      sb.write_string("\\r")
    } else if b == 0x09 {
      sb.write_string("\\t")
    } else if b >= 0x20 && b <= 0x7E {
      sb.write_byte(bs[i])
    } else {
      sb.write_byte((0x5C).to_byte())
      write_byte_hex(sb, b)
    }
    i = i + 1
  }
  sb.write_byte((0x22).to_byte())
}

fn write_wat_bytes(sb : StringBuilder, bs : Bytes) -> Unit {
  sb.write_byte((0x22).to_byte())
  let mut i = 0
  while i < bs.length() {
    let b = bs[i].to_int()
    if b == 0x22 {
      sb.write_string("\\\"")
    } else if b == 0x5C {
      sb.write_string("\\\\")
    } else if b >= 0x20 && b <= 0x7E {
      sb.write_byte(bs[i])
    } else {
      sb.write_byte((0x5C).to_byte())
      write_byte_hex(sb, b)
    }
    i = i + 1
  }
  sb.write_byte((0x22).to_byte())
}

fn write_indent(sb : StringBuilder, depth : Int) -> Unit {
  let mut rem = if depth > 50 { 50 } else { depth }
  while rem >= 8 {
    sb.write_string("                ")
    rem = rem - 8
  }
  while rem >= 4 {
    sb.write_string("        ")
    rem = rem - 4
  }
  while rem > 0 {
    sb.write_string("  ")
    rem = rem - 1
  }
}

fn write_limits(sb : StringBuilder, lim : Limits) -> Unit {
  if lim.is_memory64 {
    sb.write_string("i64 ")
  }
  write_int64(sb, lim.min)
  match lim.max {
    Some(mx) => {
      sb.write_string(" ")
      write_int64(sb, mx)
    }
    None => ()
  }
  if lim.shared {
    sb.write_string(" shared")
  }
}

fn write_block_type(sb : StringBuilder, bt : BlockType) -> Unit {
  match bt {
    BlockType::Empty => ()
    BlockType::Value(vt) => {
      sb.write_string(" (result ")
      sb.write_string(val_type_name(vt))
      sb.write_string(")")
    }
    BlockType::FuncType(idx) => {
      sb.write_string(" (type ")
      write_int(sb, idx)
      sb.write_string(")")
    }
  }
}

fn write_memarg(sb : StringBuilder, ma : MemArg, natural_align : Int) -> Unit {
  if ma.mem_idx != 0 {
    sb.write_string(" ")
    write_int(sb, ma.mem_idx)
  }
  if ma.offset != 0L {
    sb.write_string(" offset=")
    write_int64(sb, ma.offset)
  }
  if ma.align != natural_align {
    sb.write_string(" align=")
    write_int(sb, 1 << ma.align)
  }
}

fn write_f32_bits(sb : StringBuilder, bits : Int) -> Unit {
  let sign = (bits >> 31) & 1
  let exp = (bits >> 23) & 0xFF
  let mant = bits & 0x7FFFFF
  if exp == 0xFF {
    if sign != 0 {
      sb.write_string("-")
    }
    if mant == 0 {
      sb.write_string("inf")
    } else if mant == 0x400000 {
      sb.write_string("nan")
    } else {
      sb.write_string("nan:0x")
      write_byte_hex(sb, (mant >> 16) & 0xFF)
      write_byte_hex(sb, (mant >> 8) & 0xFF)
      write_byte_hex(sb, mant & 0xFF)
    }
    return ()
  }
  if sign != 0 {
    sb.write_string("-")
  }
  if exp == 0 && mant == 0 {
    sb.write_string("0x0p+0")
  } else {
    let e = if exp == 0 { -126 } else { exp - 127 }
    let prefix = if exp == 0 { "0x0." } else { "0x1." }
    sb.write_string(prefix)
    let m24 = mant << 1
    write_byte_hex(sb, (m24 >> 16) & 0xFF)
    write_byte_hex(sb, (m24 >> 8) & 0xFF)
    write_byte_hex(sb, m24 & 0xFF)
    sb.write_string("p")
    if e >= 0 {
      sb.write_string("+")
    }
    write_int(sb, e)
  }
}

fn write_f64_bits(sb : StringBuilder, bits : Int64) -> Unit {
  let sign = ((bits >> 63) & 1L).to_int()
  let exp = ((bits >> 52) & 0x7FFL).to_int()
  let mant = bits & 0x000FFFFFFFFFFFFFL
  if exp == 0x7FF {
    if sign != 0 {
      sb.write_string("-")
    }
    if mant == 0L {
      sb.write_string("inf")
    } else if mant == 0x0008000000000000L {
      sb.write_string("nan")
    } else {
      sb.write_string("nan:0x")
      write_hex_nibble(sb, ((mant >> 48) & 0xFL).to_int())
      write_byte_hex(sb, ((mant >> 40) & 0xFFL).to_int())
      write_byte_hex(sb, ((mant >> 32) & 0xFFL).to_int())
      write_byte_hex(sb, ((mant >> 24) & 0xFFL).to_int())
      write_byte_hex(sb, ((mant >> 16) & 0xFFL).to_int())
      write_byte_hex(sb, ((mant >> 8) & 0xFFL).to_int())
      write_byte_hex(sb, (mant & 0xFFL).to_int())
    }
    return ()
  }
  if sign != 0 {
    sb.write_string("-")
  }
  if exp == 0 && mant == 0L {
    sb.write_string("0x0p+0")
  } else {
    let e = if exp == 0 { -1022 } else { exp - 1023 }
    let prefix = if exp == 0 { "0x0." } else { "0x1." }
    sb.write_string(prefix)
    write_hex_nibble(sb, ((mant >> 48) & 0xFL).to_int())
    write_byte_hex(sb, ((mant >> 40) & 0xFFL).to_int())
    write_byte_hex(sb, ((mant >> 32) & 0xFFL).to_int())
    write_byte_hex(sb, ((mant >> 24) & 0xFFL).to_int())
    write_byte_hex(sb, ((mant >> 16) & 0xFFL).to_int())
    write_byte_hex(sb, ((mant >> 8) & 0xFFL).to_int())
    write_byte_hex(sb, (mant & 0xFFL).to_int())
    sb.write_string("p")
    if e >= 0 {
      sb.write_string("+")
    }
    write_int(sb, e)
  }
}

fn write_instr(sb : StringBuilder, ins : Instr) -> Unit {
  match ins {
    Instr::Unreachable => sb.write_string("unreachable")
    Instr::Nop => sb.write_string("nop")
    Instr::Block(bt) => {
      sb.write_string("block")
      write_block_type(sb, bt)
    }
    Instr::Loop(bt) => {
      sb.write_string("loop")
      write_block_type(sb, bt)
    }
    Instr::If(bt) => {
      sb.write_string("if")
      write_block_type(sb, bt)
    }
    Instr::Else => sb.write_string("else")
    Instr::End => sb.write_string("end")
    Instr::Br(l) => {
      sb.write_string("br ")
      write_int(sb, l)
    }
    Instr::BrIf(l) => {
      sb.write_string("br_if ")
      write_int(sb, l)
    }
    Instr::BrTable(targets, def_t) => {
      sb.write_string("br_table")
      let mut i = 0
      while i < targets.length() {
        sb.write_string(" ")
        write_int(sb, targets[i])
        i = i + 1
      }
      sb.write_string(" ")
      write_int(sb, def_t)
    }
    Instr::Return => sb.write_string("return")
    Instr::Call(idx) => {
      sb.write_string("call ")
      write_int(sb, idx)
    }
    Instr::CallIndirect(tidx, tbl) => {
      sb.write_string("call_indirect ")
      if tbl != 0 {
        write_int(sb, tbl)
        sb.write_string(" ")
      }
      sb.write_string("(type ")
      write_int(sb, tidx)
      sb.write_string(")")
    }
    Instr::Drop => sb.write_string("drop")
    Instr::Select => sb.write_string("select")
    Instr::TypedSelect(ts) => {
      sb.write_string("select")
      let mut i = 0
      while i < ts.length() {
        sb.write_string(" (result ")
        sb.write_string(val_type_name(ts[i]))
        sb.write_string(")")
        i = i + 1
      }
    }
    Instr::LocalGet(idx) => {
      sb.write_string("local.get ")
      write_int(sb, idx)
    }
    Instr::LocalSet(idx) => {
      sb.write_string("local.set ")
      write_int(sb, idx)
    }
    Instr::LocalTee(idx) => {
      sb.write_string("local.tee ")
      write_int(sb, idx)
    }
    Instr::GlobalGet(idx) => {
      sb.write_string("global.get ")
      write_int(sb, idx)
    }
    Instr::GlobalSet(idx) => {
      sb.write_string("global.set ")
      write_int(sb, idx)
    }
    Instr::TableGet(idx) => {
      sb.write_string("table.get ")
      write_int(sb, idx)
    }
    Instr::TableSet(idx) => {
      sb.write_string("table.set ")
      write_int(sb, idx)
    }
    Instr::I32Load(ma) => {
      sb.write_string("i32.load")
      write_memarg(sb, ma, 2)
    }
    Instr::I64Load(ma) => {
      sb.write_string("i64.load")
      write_memarg(sb, ma, 3)
    }
    Instr::F32Load(ma) => {
      sb.write_string("f32.load")
      write_memarg(sb, ma, 2)
    }
    Instr::F64Load(ma) => {
      sb.write_string("f64.load")
      write_memarg(sb, ma, 3)
    }
    Instr::I32Load8S(ma) => {
      sb.write_string("i32.load8_s")
      write_memarg(sb, ma, 0)
    }
    Instr::I32Load8U(ma) => {
      sb.write_string("i32.load8_u")
      write_memarg(sb, ma, 0)
    }
    Instr::I32Load16S(ma) => {
      sb.write_string("i32.load16_s")
      write_memarg(sb, ma, 1)
    }
    Instr::I32Load16U(ma) => {
      sb.write_string("i32.load16_u")
      write_memarg(sb, ma, 1)
    }
    Instr::I64Load8S(ma) => {
      sb.write_string("i64.load8_s")
      write_memarg(sb, ma, 0)
    }
    Instr::I64Load8U(ma) => {
      sb.write_string("i64.load8_u")
      write_memarg(sb, ma, 0)
    }
    Instr::I64Load16S(ma) => {
      sb.write_string("i64.load16_s")
      write_memarg(sb, ma, 1)
    }
    Instr::I64Load16U(ma) => {
      sb.write_string("i64.load16_u")
      write_memarg(sb, ma, 1)
    }
    Instr::I64Load32S(ma) => {
      sb.write_string("i64.load32_s")
      write_memarg(sb, ma, 2)
    }
    Instr::I64Load32U(ma) => {
      sb.write_string("i64.load32_u")
      write_memarg(sb, ma, 2)
    }
    Instr::I32Store(ma) => {
      sb.write_string("i32.store")
      write_memarg(sb, ma, 2)
    }
    Instr::I64Store(ma) => {
      sb.write_string("i64.store")
      write_memarg(sb, ma, 3)
    }
    Instr::F32Store(ma) => {
      sb.write_string("f32.store")
      write_memarg(sb, ma, 2)
    }
    Instr::F64Store(ma) => {
      sb.write_string("f64.store")
      write_memarg(sb, ma, 3)
    }
    Instr::I32Store8(ma) => {
      sb.write_string("i32.store8")
      write_memarg(sb, ma, 0)
    }
    Instr::I32Store16(ma) => {
      sb.write_string("i32.store16")
      write_memarg(sb, ma, 1)
    }
    Instr::I64Store8(ma) => {
      sb.write_string("i64.store8")
      write_memarg(sb, ma, 0)
    }
    Instr::I64Store16(ma) => {
      sb.write_string("i64.store16")
      write_memarg(sb, ma, 1)
    }
    Instr::I64Store32(ma) => {
      sb.write_string("i64.store32")
      write_memarg(sb, ma, 2)
    }
    Instr::MemorySize(m) => {
      sb.write_string("memory.size")
      if m != 0 {
        sb.write_string(" ")
        write_int(sb, m)
      }
    }
    Instr::MemoryGrow(m) => {
      sb.write_string("memory.grow")
      if m != 0 {
        sb.write_string(" ")
        write_int(sb, m)
      }
    }
    Instr::I32Const(v) => {
      sb.write_string("i32.const ")
      write_int(sb, v)
    }
    Instr::I64Const(v) => {
      sb.write_string("i64.const ")
      write_int64(sb, v)
    }
    Instr::F32Const(bits) => {
      sb.write_string("f32.const ")
      write_f32_bits(sb, bits)
    }
    Instr::F64Const(bits) => {
      sb.write_string("f64.const ")
      write_f64_bits(sb, bits)
    }
    Instr::I32Eqz => sb.write_string("i32.eqz")
    Instr::I32Eq => sb.write_string("i32.eq")
    Instr::I32Ne => sb.write_string("i32.ne")
    Instr::I32LtS => sb.write_string("i32.lt_s")
    Instr::I32LtU => sb.write_string("i32.lt_u")
    Instr::I32GtS => sb.write_string("i32.gt_s")
    Instr::I32GtU => sb.write_string("i32.gt_u")
    Instr::I32LeS => sb.write_string("i32.le_s")
    Instr::I32LeU => sb.write_string("i32.le_u")
    Instr::I32GeS => sb.write_string("i32.ge_s")
    Instr::I32GeU => sb.write_string("i32.ge_u")
    Instr::I64Eqz => sb.write_string("i64.eqz")
    Instr::I64Eq => sb.write_string("i64.eq")
    Instr::I64Ne => sb.write_string("i64.ne")
    Instr::I64LtS => sb.write_string("i64.lt_s")
    Instr::I64LtU => sb.write_string("i64.lt_u")
    Instr::I64GtS => sb.write_string("i64.gt_s")
    Instr::I64GtU => sb.write_string("i64.gt_u")
    Instr::I64LeS => sb.write_string("i64.le_s")
    Instr::I64LeU => sb.write_string("i64.le_u")
    Instr::I64GeS => sb.write_string("i64.ge_s")
    Instr::I64GeU => sb.write_string("i64.ge_u")
    Instr::F32Eq => sb.write_string("f32.eq")
    Instr::F32Ne => sb.write_string("f32.ne")
    Instr::F32Lt => sb.write_string("f32.lt")
    Instr::F32Gt => sb.write_string("f32.gt")
    Instr::F32Le => sb.write_string("f32.le")
    Instr::F32Ge => sb.write_string("f32.ge")
    Instr::F64Eq => sb.write_string("f64.eq")
    Instr::F64Ne => sb.write_string("f64.ne")
    Instr::F64Lt => sb.write_string("f64.lt")
    Instr::F64Gt => sb.write_string("f64.gt")
    Instr::F64Le => sb.write_string("f64.le")
    Instr::F64Ge => sb.write_string("f64.ge")
    Instr::I32Clz => sb.write_string("i32.clz")
    Instr::I32Ctz => sb.write_string("i32.ctz")
    Instr::I32Popcnt => sb.write_string("i32.popcnt")
    Instr::I32Add => sb.write_string("i32.add")
    Instr::I32Sub => sb.write_string("i32.sub")
    Instr::I32Mul => sb.write_string("i32.mul")
    Instr::I32DivS => sb.write_string("i32.div_s")
    Instr::I32DivU => sb.write_string("i32.div_u")
    Instr::I32RemS => sb.write_string("i32.rem_s")
    Instr::I32RemU => sb.write_string("i32.rem_u")
    Instr::I32And => sb.write_string("i32.and")
    Instr::I32Or => sb.write_string("i32.or")
    Instr::I32Xor => sb.write_string("i32.xor")
    Instr::I32Shl => sb.write_string("i32.shl")
    Instr::I32ShrS => sb.write_string("i32.shr_s")
    Instr::I32ShrU => sb.write_string("i32.shr_u")
    Instr::I32Rotl => sb.write_string("i32.rotl")
    Instr::I32Rotr => sb.write_string("i32.rotr")
    Instr::I64Clz => sb.write_string("i64.clz")
    Instr::I64Ctz => sb.write_string("i64.ctz")
    Instr::I64Popcnt => sb.write_string("i64.popcnt")
    Instr::I64Add => sb.write_string("i64.add")
    Instr::I64Sub => sb.write_string("i64.sub")
    Instr::I64Mul => sb.write_string("i64.mul")
    Instr::I64DivS => sb.write_string("i64.div_s")
    Instr::I64DivU => sb.write_string("i64.div_u")
    Instr::I64RemS => sb.write_string("i64.rem_s")
    Instr::I64RemU => sb.write_string("i64.rem_u")
    Instr::I64And => sb.write_string("i64.and")
    Instr::I64Or => sb.write_string("i64.or")
    Instr::I64Xor => sb.write_string("i64.xor")
    Instr::I64Shl => sb.write_string("i64.shl")
    Instr::I64ShrS => sb.write_string("i64.shr_s")
    Instr::I64ShrU => sb.write_string("i64.shr_u")
    Instr::I64Rotl => sb.write_string("i64.rotl")
    Instr::I64Rotr => sb.write_string("i64.rotr")
    Instr::F32Abs => sb.write_string("f32.abs")
    Instr::F32Neg => sb.write_string("f32.neg")
    Instr::F32Ceil => sb.write_string("f32.ceil")
    Instr::F32Floor => sb.write_string("f32.floor")
    Instr::F32Trunc => sb.write_string("f32.trunc")
    Instr::F32Nearest => sb.write_string("f32.nearest")
    Instr::F32Sqrt => sb.write_string("f32.sqrt")
    Instr::F32Add => sb.write_string("f32.add")
    Instr::F32Sub => sb.write_string("f32.sub")
    Instr::F32Mul => sb.write_string("f32.mul")
    Instr::F32Div => sb.write_string("f32.div")
    Instr::F32Min => sb.write_string("f32.min")
    Instr::F32Max => sb.write_string("f32.max")
    Instr::F32Copysign => sb.write_string("f32.copysign")
    Instr::F64Abs => sb.write_string("f64.abs")
    Instr::F64Neg => sb.write_string("f64.neg")
    Instr::F64Ceil => sb.write_string("f64.ceil")
    Instr::F64Floor => sb.write_string("f64.floor")
    Instr::F64Trunc => sb.write_string("f64.trunc")
    Instr::F64Nearest => sb.write_string("f64.nearest")
    Instr::F64Sqrt => sb.write_string("f64.sqrt")
    Instr::F64Add => sb.write_string("f64.add")
    Instr::F64Sub => sb.write_string("f64.sub")
    Instr::F64Mul => sb.write_string("f64.mul")
    Instr::F64Div => sb.write_string("f64.div")
    Instr::F64Min => sb.write_string("f64.min")
    Instr::F64Max => sb.write_string("f64.max")
    Instr::F64Copysign => sb.write_string("f64.copysign")
    Instr::I32WrapI64 => sb.write_string("i32.wrap_i64")
    Instr::I32TruncF32S => sb.write_string("i32.trunc_f32_s")
    Instr::I32TruncF32U => sb.write_string("i32.trunc_f32_u")
    Instr::I32TruncF64S => sb.write_string("i32.trunc_f64_s")
    Instr::I32TruncF64U => sb.write_string("i32.trunc_f64_u")
    Instr::I64ExtendI32S => sb.write_string("i64.extend_i32_s")
    Instr::I64ExtendI32U => sb.write_string("i64.extend_i32_u")
    Instr::I64TruncF32S => sb.write_string("i64.trunc_f32_s")
    Instr::I64TruncF32U => sb.write_string("i64.trunc_f32_u")
    Instr::I64TruncF64S => sb.write_string("i64.trunc_f64_s")
    Instr::I64TruncF64U => sb.write_string("i64.trunc_f64_u")
    Instr::F32ConvertI32S => sb.write_string("f32.convert_i32_s")
    Instr::F32ConvertI32U => sb.write_string("f32.convert_i32_u")
    Instr::F32ConvertI64S => sb.write_string("f32.convert_i64_s")
    Instr::F32ConvertI64U => sb.write_string("f32.convert_i64_u")
    Instr::F32DemoteF64 => sb.write_string("f32.demote_f64")
    Instr::F64ConvertI32S => sb.write_string("f64.convert_i32_s")
    Instr::F64ConvertI32U => sb.write_string("f64.convert_i32_u")
    Instr::F64ConvertI64S => sb.write_string("f64.convert_i64_s")
    Instr::F64ConvertI64U => sb.write_string("f64.convert_i64_u")
    Instr::F64PromoteF32 => sb.write_string("f64.promote_f32")
    Instr::I32ReinterpretF32 => sb.write_string("i32.reinterpret_f32")
    Instr::I64ReinterpretF64 => sb.write_string("i64.reinterpret_f64")
    Instr::F32ReinterpretI32 => sb.write_string("f32.reinterpret_i32")
    Instr::F64ReinterpretI64 => sb.write_string("f64.reinterpret_i64")
    Instr::I32Extend8S => sb.write_string("i32.extend8_s")
    Instr::I32Extend16S => sb.write_string("i32.extend16_s")
    Instr::I64Extend8S => sb.write_string("i64.extend8_s")
    Instr::I64Extend16S => sb.write_string("i64.extend16_s")
    Instr::I64Extend32S => sb.write_string("i64.extend32_s")
    Instr::RefNull(rt) => {
      sb.write_string("ref.null ")
      sb.write_string(match rt {
        RefType::FuncRef => "func"
        RefType::ExternRef => "extern"
      })
    }
    Instr::RefIsNull => sb.write_string("ref.is_null")
    Instr::RefFunc(idx) => {
      sb.write_string("ref.func ")
      sb.write_string(idx.to_string())
    }
    Instr::I32TruncSatF32S => sb.write_string("i32.trunc_sat_f32_s")
    Instr::I32TruncSatF32U => sb.write_string("i32.trunc_sat_f32_u")
    Instr::I32TruncSatF64S => sb.write_string("i32.trunc_sat_f64_s")
    Instr::I32TruncSatF64U => sb.write_string("i32.trunc_sat_f64_u")
    Instr::I64TruncSatF32S => sb.write_string("i64.trunc_sat_f32_s")
    Instr::I64TruncSatF32U => sb.write_string("i64.trunc_sat_f32_u")
    Instr::I64TruncSatF64S => sb.write_string("i64.trunc_sat_f64_s")
    Instr::I64TruncSatF64U => sb.write_string("i64.trunc_sat_f64_u")
    Instr::MemoryInit(didx, midx) => {
      sb.write_string("memory.init ")
      if midx != 0 {
        sb.write_string(midx.to_string())
        sb.write_string(" ")
      }
      sb.write_string(didx.to_string())
    }
    Instr::DataDrop(didx) => {
      sb.write_string("data.drop ")
      sb.write_string(didx.to_string())
    }
    Instr::MemoryCopy(dst, src) => {
      sb.write_string("memory.copy")
      if dst != 0 || src != 0 {
        sb.write_string(" ")
        sb.write_string(dst.to_string())
        sb.write_string(" ")
        sb.write_string(src.to_string())
      }
    }
    Instr::MemoryFill(midx) => {
      sb.write_string("memory.fill")
      if midx != 0 {
        sb.write_string(" ")
        sb.write_string(midx.to_string())
      }
    }
    Instr::TableInit(eidx, tidx) => {
      sb.write_string("table.init ")
      if tidx != 0 {
        sb.write_string(tidx.to_string())
        sb.write_string(" ")
      }
      sb.write_string(eidx.to_string())
    }
    Instr::ElemDrop(eidx) => {
      sb.write_string("elem.drop ")
      sb.write_string(eidx.to_string())
    }
    Instr::TableCopy(dst, src) => {
      sb.write_string("table.copy")
      if dst != 0 || src != 0 {
        sb.write_string(" ")
        sb.write_string(dst.to_string())
        sb.write_string(" ")
        sb.write_string(src.to_string())
      }
    }
    Instr::TableGrow(tidx) => {
      sb.write_string("table.grow ")
      sb.write_string(tidx.to_string())
    }
    Instr::TableSize(tidx) => {
      sb.write_string("table.size ")
      sb.write_string(tidx.to_string())
    }
    Instr::TableFill(tidx) => {
      sb.write_string("table.fill ")
      sb.write_string(tidx.to_string())
    }
    Instr::V128Const(bs) => {
      sb.write_string("v128.const i8x16")
      let mut i = 0
      while i < bs.length() {
        sb.write_string(" 0x")
        write_byte_hex(sb, bs[i].to_int())
        i = i + 1
      }
    }
    Instr::I8x16Shuffle(lanes) => {
      sb.write_string("i8x16.shuffle")
      let mut i = 0
      while i < lanes.length() {
        sb.write_string(" ")
        write_int(sb, lanes[i].to_int())
        i = i + 1
      }
    }
    Instr::SimdMem(sub, ma) => {
      let (name, nat) = match sub {
        0 => ("v128.load", 4)
        1 => ("v128.load8x8_s", 3)
        2 => ("v128.load8x8_u", 3)
        3 => ("v128.load16x4_s", 3)
        4 => ("v128.load16x4_u", 3)
        5 => ("v128.load32x2_s", 3)
        6 => ("v128.load32x2_u", 3)
        7 => ("v128.load8_splat", 0)
        8 => ("v128.load16_splat", 1)
        9 => ("v128.load32_splat", 2)
        10 => ("v128.load64_splat", 3)
        11 => ("v128.store", 4)
        92 => ("v128.load32_zero", 2)
        93 => ("v128.load64_zero", 3)
        _ => ("simd.mem_" + sub.to_string(), 4)
      }
      sb.write_string(name)
      write_memarg(sb, ma, nat)
    }
    Instr::SimdMemLane(sub, ma, lane) => {
      let (name, nat) = match sub {
        84 => ("v128.load8_lane", 0)
        85 => ("v128.load16_lane", 1)
        86 => ("v128.load32_lane", 2)
        87 => ("v128.load64_lane", 3)
        88 => ("v128.store8_lane", 0)
        89 => ("v128.store16_lane", 1)
        90 => ("v128.store32_lane", 2)
        91 => ("v128.store64_lane", 3)
        _ => ("simd.mem_lane_" + sub.to_string(), 0)
      }
      sb.write_string(name)
      write_memarg(sb, ma, nat)
      sb.write_string(" ")
      write_int(sb, lane)
    }
    Instr::SimdLane(sub, lane) => {
      let name = match sub {
        21 => "i8x16.extract_lane_s"
        22 => "i8x16.extract_lane_u"
        23 => "i8x16.replace_lane"
        24 => "i16x8.extract_lane_s"
        25 => "i16x8.extract_lane_u"
        26 => "i16x8.replace_lane"
        27 => "i32x4.extract_lane"
        28 => "i32x4.replace_lane"
        29 => "i64x2.extract_lane"
        30 => "i64x2.replace_lane"
        31 => "f32x4.extract_lane"
        32 => "f32x4.replace_lane"
        33 => "f64x2.extract_lane"
        34 => "f64x2.replace_lane"
        _ => "simd.lane_" + sub.to_string()
      }
      sb.write_string(name)
      sb.write_string(" ")
      write_int(sb, lane)
    }
    Instr::SimdOp(sub) => {
      let name = match sub {
        14 => "i8x16.swizzle"
        15 => "i8x16.splat"
        16 => "i16x8.splat"
        17 => "i32x4.splat"
        18 => "i64x2.splat"
        19 => "f32x4.splat"
        20 => "f64x2.splat"
        35 => "i8x16.eq"
        36 => "i8x16.ne"
        37 => "i8x16.lt_s"
        38 => "i8x16.lt_u"
        39 => "i8x16.gt_s"
        40 => "i8x16.gt_u"
        41 => "i8x16.le_s"
        42 => "i8x16.le_u"
        43 => "i8x16.ge_s"
        44 => "i8x16.ge_u"
        45 => "i16x8.eq"
        46 => "i16x8.ne"
        47 => "i16x8.lt_s"
        48 => "i16x8.lt_u"
        49 => "i16x8.gt_s"
        50 => "i16x8.gt_u"
        51 => "i16x8.le_s"
        52 => "i16x8.le_u"
        53 => "i16x8.ge_s"
        54 => "i16x8.ge_u"
        55 => "i32x4.eq"
