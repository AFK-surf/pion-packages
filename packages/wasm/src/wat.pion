      }
      sb.write_string(name)
    }
  }
}

fn write_inline_expr(sb : StringBuilder, expr : Array[Instr]) -> Unit {
  let mut i = 0
  while i < expr.length() {
    match expr[i] {
      Instr::End => break
      ins => {
        if i > 0 {
          sb.write_string(" ")
        }
        sb.write_string("(")
        write_instr(sb, ins)
        sb.write_string(")")
      }
    }
    i = i + 1
  }
}

///| Disassemble a `Module` to human-readable, valid WAT text.
pub fn print_wat(m : Module) -> String {
  let sb = StringBuilder::new()
  sb.write_string("(module\n")

  // Types
  let mut i = 0
  while i < m.types.length() {
    let ft = m.types[i]
    sb.write_string("  (type (;")
    sb.write_string(i.to_string())
    sb.write_string(";) (func")
    if ft.params.length() > 0 {
      sb.write_string(" (param")
      let mut j = 0
      while j < ft.params.length() {
        sb.write_string(" ")
        sb.write_string(val_type_name(ft.params[j]))
        j = j + 1
      }
      sb.write_string(")")
    }
    if ft.results.length() > 0 {
      sb.write_string(" (result")
      let mut j = 0
      while j < ft.results.length() {
        sb.write_string(" ")
        sb.write_string(val_type_name(ft.results[j]))
        j = j + 1
      }
      sb.write_string(")")
    }
    sb.write_string("))\n")
    i = i + 1
  }

  // Imports
  let mut func_idx = 0
  let mut table_idx = 0
  let mut mem_idx = 0
  let mut global_idx = 0
  i = 0
  while i < m.imports.length() {
    let imp = m.imports[i]
    sb.write_string("  (import ")
    write_wat_string(sb, imp.module_name)
    sb.write_string(" ")
    write_wat_string(sb, imp.name)
    sb.write_string(" ")
    match imp.desc {
      ImportDesc::Func(tidx) => {
        sb.write_string("(func (;")
        sb.write_string(func_idx.to_string())
        sb.write_string(";) (type ")
        sb.write_string(tidx.to_string())
        sb.write_string("))")
        func_idx = func_idx + 1
      }
      ImportDesc::Table(tt) => {
        sb.write_string("(table (;")
        sb.write_string(table_idx.to_string())
        sb.write_string(";) ")
        write_limits(sb, tt.limits)
        sb.write_string(" ")
        sb.write_string(val_type_name(ref_type_to_val_type(tt.elem_type)))
        sb.write_string(")")
        table_idx = table_idx + 1
      }
      ImportDesc::Memory(mt) => {
        sb.write_string("(memory (;")
        sb.write_string(mem_idx.to_string())
        sb.write_string(";) ")
        write_limits(sb, mt.limits)
        sb.write_string(")")
        mem_idx = mem_idx + 1
      }
      ImportDesc::Global(gt) => {
        sb.write_string("(global (;")
        sb.write_string(global_idx.to_string())
        sb.write_string(";) ")
        if gt.mutable {
          sb.write_string("(mut ")
          sb.write_string(val_type_name(gt.val_type))
          sb.write_string(")")
        } else {
          sb.write_string(val_type_name(gt.val_type))
        }
        sb.write_string(")")
        global_idx = global_idx + 1
      }
    }
    sb.write_string(")\n")
    i = i + 1
  }

  // Defined functions
  i = 0
  while i < m.codes.length() {
    let tidx = if i < m.functions.length() { m.functions[i] } else { 0 }
    sb.write_string("  (func (;")
    sb.write_string(func_idx.to_string())
    sb.write_string(";) (type ")
    sb.write_string(tidx.to_string())
    sb.write_string(")")
    if tidx >= 0 && tidx < m.types.length() {
      let ft = m.types[tidx]
      if ft.params.length() > 0 {
        sb.write_string(" (param")
        let mut j = 0
        while j < ft.params.length() {
          sb.write_string(" ")
          sb.write_string(val_type_name(ft.params[j]))
          j = j + 1
        }
        sb.write_string(")")
      }
      if ft.results.length() > 0 {
        sb.write_string(" (result")
        let mut j = 0
        while j < ft.results.length() {
          sb.write_string(" ")
          sb.write_string(val_type_name(ft.results[j]))
          j = j + 1
        }
        sb.write_string(")")
      }
    }
    sb.write_string("\n")
    let fb = m.codes[i]
    if fb.locals.length() > 0 {
      sb.write_string("    (local")
      let mut j = 0
      while j < fb.locals.length() {
        let mut k = 0
        while k < fb.locals[j].count {
          sb.write_string(" ")
          sb.write_string(val_type_name(fb.locals[j].val_type))
          k = k + 1
        }
        j = j + 1
      }
      sb.write_string(")\n")
    }
    let mut depth = 2
    let mut bi = 0
    while bi < fb.body.length() {
      let ins = fb.body[bi]
      let is_last_end = bi + 1 == fb.body.length()
      match ins {
        Instr::End => {
          if is_last_end {
            break
          }
          if depth > 2 {
            depth = depth - 1
          }
          write_indent(sb, depth)
          sb.write_string("end\n")
        }
        Instr::Else => {
          let d = if depth > 2 { depth - 1 } else { 2 }
          write_indent(sb, d)
          sb.write_string("else\n")
        }
        Instr::Block(_) | Instr::Loop(_) | Instr::If(_) => {
          write_indent(sb, depth)
          write_instr(sb, ins)
          sb.write_string("\n")
          depth = depth + 1
        }
        _ => {
          write_indent(sb, depth)
          write_instr(sb, ins)
          sb.write_string("\n")
        }
      }
      bi = bi + 1
    }
    sb.write_string("  )\n")
    func_idx = func_idx + 1
    i = i + 1
  }

  // Tables
  i = 0
  while i < m.tables.length() {
    let tt = m.tables[i]
    sb.write_string("  (table (;")
    sb.write_string(table_idx.to_string())
    sb.write_string(";) ")
    write_limits(sb, tt.limits)
    sb.write_string(" ")
    sb.write_string(val_type_name(ref_type_to_val_type(tt.elem_type)))
    sb.write_string(")\n")
    table_idx = table_idx + 1
    i = i + 1
  }

  // Memories
  i = 0
  while i < m.memories.length() {
    sb.write_string("  (memory (;")
    sb.write_string(mem_idx.to_string())
    sb.write_string(";) ")
    write_limits(sb, m.memories[i].limits)
    sb.write_string(")\n")
    mem_idx = mem_idx + 1
    i = i + 1
  }

  // Globals
  i = 0
  while i < m.globals.length() {
    let g = m.globals[i]
    sb.write_string("  (global (;")
    sb.write_string(global_idx.to_string())
    sb.write_string(";) ")
    if g.global_type.mutable {
      sb.write_string("(mut ")
      sb.write_string(val_type_name(g.global_type.val_type))
      sb.write_string(")")
    } else {
      sb.write_string(val_type_name(g.global_type.val_type))
    }
    sb.write_string(" ")
    write_inline_expr(sb, g.init)
    sb.write_string(")\n")
    global_idx = global_idx + 1
    i = i + 1
  }

  // Exports
  i = 0
  while i < m.exports.length() {
    let ex = m.exports[i]
    sb.write_string("  (export ")
    write_wat_string(sb, ex.name)
    sb.write_string(" (")
    sb.write_string(match ex.kind {
      ExportKind::Func => "func"
      ExportKind::Table => "table"
      ExportKind::Memory => "memory"
      ExportKind::Global => "global"
    })
    sb.write_string(" ")
    sb.write_string(ex.index.to_string())
    sb.write_string("))\n")
    i = i + 1
  }

  // Start
  match m.start {
    Some(fidx) => {
      sb.write_string("  (start ")
      sb.write_string(fidx.to_string())
      sb.write_string(")\n")
    }
    None => ()
  }

  // Elements
  i = 0
  while i < m.elements.length() {
    let seg = m.elements[i]
    sb.write_string("  (elem (;")
    sb.write_string(i.to_string())
    sb.write_string(";)")
    match seg.mode {
      ElemMode::Active(tidx, offset_expr) => {
        if tidx != 0 {
          sb.write_string(" (table ")
          sb.write_string(tidx.to_string())
          sb.write_string(")")
        }
        sb.write_string(" ")
        write_inline_expr(sb, offset_expr)
      }
      ElemMode::Declarative => sb.write_string(" declare")
      ElemMode::Passive => ()
    }
    match seg.items {
      ElemItems::FuncIndices(idxs) => {
        sb.write_string(" func")
        let mut j = 0
        while j < idxs.length() {
          sb.write_string(" ")
          sb.write_string(idxs[j].to_string())
          j = j + 1
        }
      }
      ElemItems::Exprs(exprs) => {
        sb.write_string(" ")
        sb.write_string(val_type_name(ref_type_to_val_type(seg.elem_type)))
        let mut j = 0
        while j < exprs.length() {
          sb.write_string(" (item ")
          write_inline_expr(sb, exprs[j])
          sb.write_string(")")
          j = j + 1
        }
      }
    }
    sb.write_string(")\n")
    i = i + 1
  }

  // Data
  i = 0
  while i < m.data.length() {
    let seg = m.data[i]
    sb.write_string("  (data (;")
    sb.write_string(i.to_string())
    sb.write_string(";)")
    match seg.mode {
      DataMode::Active(midx, offset_expr) => {
        if midx != 0 {
          sb.write_string(" (memory ")
          sb.write_string(midx.to_string())
          sb.write_string(")")
        }
        sb.write_string(" ")
        write_inline_expr(sb, offset_expr)
      }
      DataMode::Passive => ()
    }
    sb.write_string(" ")
    write_wat_bytes(sb, seg.data)
    sb.write_string(")\n")
    i = i + 1
  }

  // Custom sections
  i = 0
  while i < m.custom_sections.length() {
    let cs = m.custom_sections[i]
    sb.write_string("  (@custom ")
    write_wat_string(sb, cs.name)
    sb.write_string(" ")
    write_wat_bytes(sb, cs.data)
    sb.write_string(")\n")
    i = i + 1
  }

  sb.write_string(")\n")
  sb.to_string()
}
