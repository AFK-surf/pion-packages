///| WebAssembly binary decode, streaming Parser, ModuleBuilder, encode roundtrip, and WAT disassembly tests.

fn str_contains(haystack : String, needle : String) -> Bool {
  let hlen = haystack.length()
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  if nlen > hlen {
    return false
  }
  let mut i = 0
  while i <= hlen - nlen {
    let mut j = 0
    let mut ok = true
    while j < nlen {
      if haystack.code_unit_at(i + j) != needle.code_unit_at(j) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return true
    }
    i = i + 1
  }
  false
}

test "decode_empty_and_bad_headers" {
  // Valid empty module
  let empty = hex_to_bytes("0061736d01000000")
  match decode_module(empty) {
    Ok(m) => {
      debug_assert(m.version == 1, "version 1")
      debug_assert(m.types.length() == 0, "no types")
      debug_assert(m.functions.length() == 0, "no funcs")
    }
    Err(e) => debug_assert(false, wasm_error_message(e))
  }
  // Bad magic
  match decode_module(hex_to_bytes("0061736e01000000")) {
    Ok(_) => debug_assert(false, "bad magic must fail")
    Err(WasmError::InvalidMagic(_)) => ()
    Err(e) => debug_assert(false, "expected InvalidMagic, got: " + wasm_error_message(e))
  }
  // Unsupported version
  match decode_module(hex_to_bytes("0061736d02000000")) {
    Ok(_) => debug_assert(false, "bad version must fail")
    Err(WasmError::UnsupportedVersion(2)) => ()
    Err(e) => debug_assert(false, "expected UnsupportedVersion(2), got: " + wasm_error_message(e))
  }
  // Truncated header
  match decode_module(hex_to_bytes("006173")) {
    Ok(_) => debug_assert(false, "truncated header must fail")
    Err(WasmError::UnexpectedEof(_)) => ()
    Err(_) => ()
  }
}

test "builder_all_sections_streaming_parser_and_roundtrip" {
  let b = ModuleBuilder::new()
  // Type 0: (i32, i32) -> (i32)
  let t0 = b.add_type([ValType::I32, ValType::I32], [ValType::I32])
  // Type 1: () -> ()
  let t1 = b.add_type([], [])
  // Import func 0: env.log (type 1)
  b.add_import("env", "log", ImportDesc::Func(t1))
  // Defined func 1: add (type 0)
  let f_add = b.add_func(
    t0,
    [LocalGroup::{ count: 1, val_type: ValType::I32 }],
    [
      Instr::LocalGet(0),
      Instr::LocalGet(1),
      Instr::I32Add,
      Instr::LocalTee(2),
      Instr::End,
    ],
  )
  // Defined func 2: start_fn (type 1)
  let f_start = b.add_func(t1, [], [Instr::Call(0), Instr::End])
  // Table 0: funcref min 2 max 4
  let _ = b.add_table(TableType::{
    elem_type: RefType::FuncRef,
    limits: Limits::new(2L, Some(4L)),
  })
  // Memory 0: min 1 max 2
  let _ = b.add_memory(MemType::{ limits: Limits::new(1L, Some(2L)) })
  // Global 0: mut i32 = 42
  let _ = b.add_global(
    GlobalType::{ val_type: ValType::I32, mutable: true },
    [Instr::I32Const(42), Instr::End],
  )
  // Exports
  b.add_export("add", ExportKind::Func, f_add)
  b.add_export("mem", ExportKind::Memory, 0)
  b.add_export("g", ExportKind::Global, 0)
  // Start
  b.set_start(f_start)
  // Active element segment at table 0 offset 0
  let _ = b.add_element(ElemSegment::{
    mode: ElemMode::Active(0, [Instr::I32Const(0), Instr::End]),
    elem_type: RefType::FuncRef,
    items: ElemItems::FuncIndices([f_add, f_start]),
    flags: 0,
  })
  // Active data segment at memory 0 offset 0
  let hello = Bytes::new(5)
  hello[0] = (104).to_byte()
  hello[1] = (101).to_byte()
  hello[2] = (108).to_byte()
  hello[3] = (108).to_byte()
  hello[4] = (111).to_byte()
  let _ = b.add_data(DataSegment::{
    mode: DataMode::Active(0, [Instr::I32Const(0), Instr::End]),
    data: hello,
  })
  // Custom section
  let cdata = hex_to_bytes("01020304")
  b.add_custom("pion.meta", cdata)

  let encoded = match b.encode() {
    Ok(bs) => bs
    Err(e) => {
      debug_assert(false, wasm_error_message(e))
      Bytes::new(0)
    }
  }

  // Decode and validate
  let decoded = match decode_module(encoded) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, wasm_error_message(e))
      Module::empty()
    }
  }
  match validate_module(decoded) {
    Ok(_) => ()
    Err(e) => debug_assert(false, wasm_error_message(e))
  }
  debug_assert(decoded.types.length() == 2, "2 types")
  debug_assert(decoded.imports.length() == 1, "1 import")
  debug_assert(decoded.functions.length() == 2, "2 defined funcs")
  debug_assert(decoded.tables.length() == 1, "1 table")
  debug_assert(decoded.memories.length() == 1, "1 memory")
  debug_assert(decoded.globals.length() == 1, "1 global")
  debug_assert(decoded.exports.length() == 3, "3 exports")
  debug_assert(decoded.elements.length() == 1, "1 elem")
  debug_assert(decoded.codes.length() == 2, "2 codes")
  debug_assert(decoded.data.length() == 1, "1 data")
  debug_assert(decoded.custom_sections.length() == 1, "1 custom")

  // Re-encode must be byte-identical
  let reencoded = match encode_module(decoded) {
    Ok(bs) => bs
    Err(e) => {
      debug_assert(false, wasm_error_message(e))
      Bytes::new(0)
    }
  }
  debug_assert(bytes_eq(encoded, reencoded), "encode->decode->encode must be byte-identical")

  // Streaming Parser must visit every section
  let parser = Parser::new(encoded)
  match parser.parse_header() {
    Ok(v) => debug_assert(v == 1, "streaming header version 1")
    Err(e) => debug_assert(false, wasm_error_message(e))
  }
  let mut sec_count = 0
  while true {
    match parser.next_section() {
      Ok(Some(_)) => sec_count = sec_count + 1
      Ok(None) => break
      Err(e) => {
        debug_assert(false, wasm_error_message(e))
        break
      }
    }
  }
  debug_assert(sec_count == 12, "expected 12 sections streamed (11 std + 1 custom)")

  // WAT disassembly check
  let wat = print_wat(decoded)
  debug_assert(str_contains(wat, "(module"), "wat has (module")
  debug_assert(str_contains(wat, "(import \"env\" \"log\""), "wat has import")
  debug_assert(str_contains(wat, "(export \"add\" (func 1))"), "wat has export")
  debug_assert(str_contains(wat, "i32.add"), "wat has i32.add")
  debug_assert(str_contains(wat, "(start 2)"), "wat has start")
}

test "instruction_families_roundtrip_and_float_bits" {
  let b = ModuleBuilder::new()
  // () -> ()
  let t0 = b.add_type([], [])
  // (f32, f64) -> (i32)
  let t1 = b.add_type([ValType::F32, ValType::F64], [ValType::I32])
  // () -> (v128)
  let t2 = b.add_type([], [ValType::V128])
  let _ = b.add_memory(MemType::{ limits: Limits::new(1L, None) })
  let _ = b.add_table(TableType::{
    elem_type: RefType::FuncRef,
    limits: Limits::new(4L, None),
  })

  // Passive data & elem for bulk memory/table ops
  let _ = b.add_data(DataSegment::{ mode: DataMode::Passive, data: hex_to_bytes("deadbeef") })
  let _ = b.add_element(ElemSegment::{
    mode: ElemMode::Passive,
    elem_type: RefType::FuncRef,
    items: ElemItems::FuncIndices([0]),
    flags: 1,
  })

  // Func 0: sign-ext + trunc_sat + float constants (exact NaN / -0.0 bits) + ref ops
  let _ = b.add_func(
    t1,
    [],
    [
      Instr::LocalGet(0),
      Instr::I32TruncSatF32S,
      Instr::I32Extend8S,
      Instr::I32Extend16S,
      Instr::LocalGet(1),
      Instr::I32TruncSatF64U,
      Instr::I32Xor,
      // Push exact f32 NaN with payload 0x7FC01234 and reinterpret
      Instr::F32Const(0x7FC01234),
      Instr::I32ReinterpretF32,
      Instr::I32Add,
      // Push exact f64 -0.0 (0x8000000000000000) and drop
      Instr::F64Const(-9223372036854775807L - 1L),
      Instr::Drop,
      // Reference ops
      Instr::RefNull(RefType::ExternRef),
      Instr::RefIsNull,
      Instr::I32Add,
      Instr::End,
    ],
  )

  // Func 1: bulk memory & table ops
  let _ = b.add_func(
    t0,
    [],
    [
      Instr::I32Const(0),
      Instr::I32Const(0),
      Instr::I32Const(4),
      Instr::MemoryInit(0, 0),
      Instr::DataDrop(0),
      Instr::I32Const(0),
      Instr::I32Const(0),
      Instr::I32Const(4),
      Instr::MemoryCopy(0, 0),
      Instr::I32Const(0),
      Instr::I32Const(0xAA),
      Instr::I32Const(4),
      Instr::MemoryFill(0),
      Instr::I32Const(0),
      Instr::I32Const(0),
      Instr::I32Const(1),
      Instr::TableInit(0, 0),
      Instr::ElemDrop(0),
      Instr::TableSize(0),
      Instr::Drop,
      Instr::End,
    ],
  )

  // Func 2: SIMD v128.const + i8x16.shuffle + i32x4.add + v128.load
  let v1 = hex_to_bytes("01000000020000000300000004000000")
  let v2 = hex_to_bytes("05000000060000000700000008000000")
  let lanes = hex_to_bytes("00010203040506071011121314151617")
  let _ = b.add_func(
    t2,
    [],
    [
      Instr::V128Const(v1),
      Instr::V128Const(v2),
      Instr::I8x16Shuffle(lanes),
      Instr::I32Const(0),
      Instr::SimdMem(0, MemArg::new(4, 0L)),
      Instr::SimdOp(174), // i32x4.add (0xAE)
      Instr::End,
    ],
  )

  let bytes = match b.encode() {
    Ok(bs) => bs
    Err(e) => {
      debug_assert(false, wasm_error_message(e))
      Bytes::new(0)
    }
  }
  let m = match decode_module(bytes) {
    Ok(mod_) => mod_
    Err(e) => {
      debug_assert(false, wasm_error_message(e))
      Module::empty()
    }
  }
  match validate_module(m) {
    Ok(_) => ()
    Err(e) => debug_assert(false, wasm_error_message(e))
  }
  let bytes2 = match encode_module(m) {
    Ok(bs) => bs
    Err(e) => {
      debug_assert(false, wasm_error_message(e))
      Bytes::new(0)
    }
  }
  debug_assert(bytes_eq(bytes, bytes2), "all-families roundtrip byte-identical")
}

test "decode_name_custom_section" {
  // Build a name section payload:
  // subsection 0 (module name): "demo"
  // subsection 1 (func names): 0 -> "main", 1 -> "helper"
  // subsection 2 (local names): func 0 -> [0 -> "arg0", 1 -> "tmp"]
  let payload = hex_to_bytes(
    "00050464656d6f" +
    "010f0200046d61696e010668656c706572" +
    "020e0100020004617267300103746d70",
  )
  match decode_name_section(payload) {
    Ok(ns) => {
      match ns.module_name {
        Some(s) => debug_assert(s == "demo", "module name demo")
        None => debug_assert(false, "expected module name")
      }
      debug_assert(ns.func_names.length() == 2, "2 func names")
      debug_assert(ns.func_names[0].name == "main", "func 0 main")
      debug_assert(ns.func_names[1].name == "helper", "func 1 helper")
      debug_assert(ns.local_names.length() == 1, "1 func local map")
      debug_assert(ns.local_names[0].names.length() == 2, "2 locals")
      debug_assert(ns.local_names[0].names[0].name == "arg0", "local 0 arg0")
    }
    Err(e) => debug_assert(false, wasm_error_message(e))
  }
}

test "c1_migrated_wasm_constants" {
  let vts = [ValType::I32, ValType::I64, ValType::F32, ValType::F64, ValType::V128, ValType::FuncRef, ValType::ExternRef]
  for i = 0; i < vts.length(); i = i + 1 {
    match val_type_from_code(val_type_code(vts[i])) {
      Some(v) => debug_assert(val_type_equals(v, vts[i]), "val_type roundtrip")
      None => debug_assert(false, "expected Some")
    }
    for j = 0; j < vts.length(); j = j + 1 {
      debug_assert(val_type_equals(vts[i], vts[j]) == (i == j), "val_type_equals iff")
      debug_assert((val_type_to_id(vts[i]) == val_type_to_id(vts[j])) == (i == j), "val_type_to_id injective")
    }
  }
  debug_assert(ref_type_code(RefType::FuncRef) == 112 && ref_type_code(RefType::ExternRef) == 111, "ref_type_code")
  debug_assert(is_ref_id(5) && is_ref_id(6) && !is_ref_id(0), "is_ref_id")
}
