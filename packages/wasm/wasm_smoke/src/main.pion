///| Wasm32 + Native smoke entry for `packages/wasm`.

import "wasm"

///|
pub fn smoke() -> String {
  // 1. Build a multi-function WebAssembly module with fib + memory + global + export + SIMD
  let b = wasm::ModuleBuilder::new()
  let t0 = b.add_type([wasm::ValType::I32], [wasm::ValType::I32])
  let t1 = b.add_type([], [wasm::ValType::V128])
  let _ = b.add_memory(wasm::MemType::{ limits: wasm::Limits::new(1L, Some(2L)) })
  let _ = b.add_global(
    wasm::GlobalType::{ val_type: wasm::ValType::I32, mutable: true },
    [wasm::Instr::I32Const(100), wasm::Instr::End],
  )
  let f_fib = b.add_func(
    t0,
    [],
    [
      wasm::Instr::LocalGet(0),
      wasm::Instr::I32Const(2),
      wasm::Instr::I32LtS,
      wasm::Instr::If(wasm::BlockType::Value(wasm::ValType::I32)),
      wasm::Instr::LocalGet(0),
      wasm::Instr::Else,
      wasm::Instr::LocalGet(0),
      wasm::Instr::I32Const(1),
      wasm::Instr::I32Sub,
      wasm::Instr::Call(0),
      wasm::Instr::LocalGet(0),
      wasm::Instr::I32Const(2),
      wasm::Instr::I32Sub,
      wasm::Instr::Call(0),
      wasm::Instr::I32Add,
      wasm::Instr::End,
      wasm::Instr::End,
    ],
  )
  let v1 = Bytes::new(16)
  v1[0] = (1).to_byte()
  v1[4] = (2).to_byte()
  let v2 = Bytes::new(16)
  v2[0] = (3).to_byte()
  v2[4] = (4).to_byte()
  let f_simd = b.add_func(
    t1,
    [],
    [
      wasm::Instr::V128Const(v1),
      wasm::Instr::V128Const(v2),
      wasm::Instr::SimdOp(174),
      wasm::Instr::End,
    ],
  )
  b.add_export("fib", wasm::ExportKind::Func, f_fib)
  b.add_export("simd", wasm::ExportKind::Func, f_simd)
  b.add_export("mem", wasm::ExportKind::Memory, 0)

  let encoded = match b.encode() {
    Ok(bs) => bs
    Err(e) => return "FAIL:encode:" + wasm::wasm_error_message(e)
  }

  // 2. Decode and validate
  let decoded = match wasm::decode_module(encoded) {
    Ok(m) => m
    Err(e) => return "FAIL:decode:" + wasm::wasm_error_message(e)
  }
  match wasm::validate_module(decoded) {
    Ok(_) => ()
    Err(e) => return "FAIL:validate:" + wasm::wasm_error_message(e)
  }

  // 3. Re-encode byte-exact check
  let reencoded = match wasm::encode_module(decoded) {
    Ok(bs) => bs
    Err(e) => return "FAIL:reencode:" + wasm::wasm_error_message(e)
  }
  if reencoded.length() != encoded.length() {
    return "FAIL:reencode_len"
  }
  let mut i = 0
  while i < encoded.length() {
    if reencoded[i] != encoded[i] {
      return "FAIL:reencode_byte"
    }
    i = i + 1
  }

  // 4. Streaming parser count
  let p = wasm::Parser::new(encoded)
  let mut secs = 0
  while true {
    match p.next_section() {
      Ok(Some(_)) => secs = secs + 1
      Ok(None) => break
      Err(e) => return "FAIL:parser:" + wasm::wasm_error_message(e)
    }
  }

  // 5. Reject invalid magic without trap
  let bad = Bytes::new(8)
  match wasm::validate_bytes(bad) {
    Err(wasm::WasmError::InvalidMagic(_)) => ()
    _ => return "FAIL:bad_magic"
  }

  // 6. Disassemble to WAT
  let wat = wasm::print_wat(decoded)

  "wasm_wasm_smoke: OK bytes=" +
  encoded.length().to_string() +
  " secs=" +
  secs.to_string() +
  " funcs=" +
  decoded.codes.length().to_string() +
  " wat_len=" +
  wat.length().to_string()
}

///|
pub fn main(world : World) -> Int {
  let msg = smoke()
  io_println(world, msg)
  if msg.length() >= 19 && msg.code_unit_at(17) == 79 && msg.code_unit_at(18) == 75 {
    0
  } else {
    1
  }
}
