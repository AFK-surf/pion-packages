///| Shell completion script generator for Bash, Zsh, and Fish with injection-safe escaping.

///| Sanitize an identifier for shell function names (alphanumeric and underscore only).
fn sanitize_shell_ident(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
      sb.write_char(c.unsafe_to_char())
    } else {
      sb.write_char('_')
    }
    i = i + 1
  }
  sb.to_string()
}

///| Replace CR, LF, TAB with single space so generated lines cannot be broken by descriptions.
fn sanitize_single_line(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 10 || c == 13 || c == 9 {
      sb.write_char(' ')
    } else {
      sb.write_char(c.unsafe_to_char())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Escape a string for safe embedding inside POSIX/Bash/Zsh single quotes `'...'`.
fn escape_posix_sq(s : String) -> String {
  let clean = sanitize_single_line(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < clean.length() {
    let c = clean.code_unit_at(i)
    if c == 39 {
      // ' -> '\''
      sb.write_string("'\\''")
    } else {
      sb.write_char(c.unsafe_to_char())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Escape a word list token for Bash compgen (no newlines, quotes, $, backticks, or whitespace).
fn escape_bash_token(s : String) -> String {
  let clean = sanitize_single_line(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < clean.length() {
    let c = clean.code_unit_at(i)
    if c == 39 || c == 34 || c == 92 || c == 36 || c == 96 || c == 32 {
      sb.write_char('_')
    } else {
      sb.write_char(c.unsafe_to_char())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Escape a description for Zsh `_arguments` / `_describe` inside single quotes.
fn escape_zsh_desc(s : String) -> String {
  let clean = sanitize_single_line(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < clean.length() {
    let c = clean.code_unit_at(i)
    if c == 39 {
      sb.write_string("'\\''")
    } else if c == 92 || c == 58 || c == 91 || c == 93 {
      // \, :, [, ]
      sb.write_char('\\')
      sb.write_char(c.unsafe_to_char())
    } else {
      sb.write_char(c.unsafe_to_char())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Escape a string for Fish single quotes (`\` -> `\\`, `'` -> `\'`, newlines -> space).
fn escape_fish_sq(s : String) -> String {
  let clean = sanitize_single_line(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < clean.length() {
    let c = clean.code_unit_at(i)
    if c == 92 {
      sb.write_string("\\\\")
    } else if c == 39 {
      sb.write_string("\\'")
    } else {
      sb.write_char(c.unsafe_to_char())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Collect visible option tokens for a command (used by Bash generator).
fn bash_collect_opts(cmd : Command) -> String {
  let sb = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < cmd.args_list.length() {
    let a = cmd.args_list[i]
    if !a.hide_flag && !a.is_positional() {
      match a.short_name {
        Some(ch) => {
          if !first {
            sb.write_char(' ')
          }
          sb.write_char('-')
          sb.write_char(ch)
          first = false
        }
        None => ()
      }
      match a.long_name {
        Some(ln) => {
          if !first {
            sb.write_char(' ')
          }
          sb.write_string("--")
          sb.write_string(escape_bash_token(ln))
          first = false
        }
        None => ()
      }
      match a.negative_long {
        Some(nl) => {
          if !first {
            sb.write_char(' ')
          }
          sb.write_string("--")
          sb.write_string(escape_bash_token(nl))
          first = false
        }
        None => ()
      }
    }
    i = i + 1
  }
  if !cmd.disable_help_flag {
    if !first {
      sb.write_char(' ')
    }
    sb.write_string("-h --help")
    first = false
  }
  if !cmd.disable_version_flag && cmd.version_str is Some(_) {
    if !first {
      sb.write_char(' ')
    }
    sb.write_string("-V --version")
  }
  sb.to_string()
}

///| Collect visible subcommand names for Bash.
fn bash_collect_subs(cmd : Command) -> String {
  let sb = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < cmd.subcommands_list.length() {
    let sub = cmd.subcommands_list[i]
    if !sub.hide_flag {
      if !first {
        sb.write_char(' ')
      }
      sb.write_string(escape_bash_token(sub.name))
      first = false
    }
    i = i + 1
  }
  sb.to_string()
}

///| Emit Bash case branch for a command and its descendants.
fn emit_bash_cases(sb : StringBuilder, cmd : Command, path_key : String) -> Unit {
  sb.write_string("    ")
  sb.write_string(path_key)
  sb.write_string(")\n")
  let opts = bash_collect_opts(cmd)
  let subs = bash_collect_subs(cmd)

  // Handle prev-flag possible_values
  let mut has_val_cases = false
  let mut i = 0
  while i < cmd.args_list.length() {
    let a = cmd.args_list[i]
    if !a.hide_flag && !a.is_positional() && a.possible_vals.length() > 0 {
      if !has_val_cases {
        sb.write_string("      case \"$prev\" in\n")
        has_val_cases = true
      }
      sb.write_string("        ")
      let mut pat_first = true
      match a.short_name {
        Some(ch) => {
          sb.write_char('-')
          sb.write_char(ch)
          pat_first = false
        }
        None => ()
      }
      match a.long_name {
        Some(ln) => {
          if !pat_first {
            sb.write_char('|')
          }
          sb.write_string("--")
          sb.write_string(escape_bash_token(ln))
        }
        None => ()
      }
      sb.write_string(")\n          COMPREPLY=( $(compgen -W '")
      let mut vi = 0
      while vi < a.possible_vals.length() {
        if vi > 0 {
          sb.write_char(' ')
        }
        sb.write_string(escape_posix_sq(a.possible_vals[vi]))
        vi = vi + 1
      }
      sb.write_string("' -- \"$cur\") )\n          return 0\n          ;;\n")
    }
    i = i + 1
  }
  if has_val_cases {
    sb.write_string("      esac\n")
  }

  let words = if opts.length() > 0 && subs.length() > 0 {
    opts + " " + subs
  } else if opts.length() > 0 {
    opts
  } else {
    subs
  }
  sb.write_string("      COMPREPLY=( $(compgen -W '")
  sb.write_string(escape_posix_sq(words))
  sb.write_string("' -- \"$cur\") )\n")
  sb.write_string("      return 0\n")
  sb.write_string("      ;;\n")

  let mut si = 0
  while si < cmd.subcommands_list.length() {
    let sub = cmd.subcommands_list[si]
    if !sub.hide_flag {
      emit_bash_cases(sb, sub, path_key + "__" + sanitize_shell_ident(sub.name))
    }
    si = si + 1
  }
}

///| Generate Bash completion script.
fn generate_bash(cmd : Command) -> String {
  let fn_name = "_" + sanitize_shell_ident(cmd.name)
  let root_key = sanitize_shell_ident(cmd.name)
  let sb = StringBuilder::new()
  sb.write_string("# Bash completion for ")
  sb.write_string(sanitize_single_line(cmd.name))
  sb.write_string("\n")
  sb.write_string(fn_name)
  sb.write_string("() {\n")
  sb.write_string("  local i cur prev cmd\n")
  sb.write_string("  COMPREPLY=()\n")
  sb.write_string("  cur=\"${COMP_WORDS[COMP_CWORD]}\"\n")
  sb.write_string("  prev=\"${COMP_WORDS[COMP_CWORD-1]}\"\n")
  sb.write_string("  cmd=\"")
  sb.write_string(root_key)
  sb.write_string("\"\n")
  sb.write_string("  for ((i=1; i < COMP_CWORD; i++)); do\n")
  sb.write_string("    case \"${COMP_WORDS[i]}\" in\n")
  sb.write_string("      -*) ;;\n")
  sb.write_string("      *) cmd=\"${cmd}__${COMP_WORDS[i]//[^a-zA-Z0-9_]/_}\" ;;\n")
  sb.write_string("    esac\n")
  sb.write_string("  done\n")
  sb.write_string("  case \"$cmd\" in\n")
  emit_bash_cases(sb, cmd, root_key)
  sb.write_string("  esac\n")
  sb.write_string("}\n")
  sb.write_string("complete -F ")
  sb.write_string(fn_name)
  sb.write_string(" ")
  sb.write_string(escape_bash_token(cmd.name))
  sb.write_string("\n")
  sb.to_string()
}

///| Emit Zsh completion function for a command and its subcommands.
fn emit_zsh_fn(sb : StringBuilder, cmd : Command, fn_name : String) -> Unit {
  sb.write_string(fn_name)
  sb.write_string("() {\n")
  sb.write_string("  local -a commands\n")
  sb.write_string("  _arguments -s -S \\\n")

  let mut i = 0
  while i < cmd.args_list.length() {
    let a = cmd.args_list[i]
    if !a.hide_flag && !a.is_positional() {
      let desc = escape_zsh_desc(a.help_text)
      let val_spec = if a.possible_vals.length() > 0 {
        let vsb = StringBuilder::new()
        vsb.write_string(":")
        vsb.write_string(escape_zsh_desc(arg_value_placeholder(a)))
        vsb.write_string(":(")
        let mut vi = 0
        while vi < a.possible_vals.length() {
          if vi > 0 {
            vsb.write_char(' ')
          }
          vsb.write_string(escape_zsh_desc(a.possible_vals[vi]))
          vi = vi + 1
        }
        vsb.write_char(')')
        vsb.to_string()
      } else if help_arg_takes_value(a) {
        ":" + escape_zsh_desc(arg_value_placeholder(a)) + ": "
      } else {
        ""
      }

      match a.short_name {
        Some(ch) => {
          sb.write_string("    '-")
          sb.write_char(ch)
          sb.write_string("[")
          sb.write_string(desc)
          sb.write_string("]")
          sb.write_string(val_spec)
          sb.write_string("' \\\n")
        }
        None => ()
      }
      match a.long_name {
        Some(ln) => {
          sb.write_string("    '--")
          sb.write_string(escape_zsh_desc(ln))
          sb.write_string("[")
          sb.write_string(desc)
          sb.write_string("]")
          sb.write_string(val_spec)
          sb.write_string("' \\\n")
        }
        None => ()
      }
      match a.negative_long {
        Some(nl) => {
          sb.write_string("    '--")
          sb.write_string(escape_zsh_desc(nl))
          sb.write_string("[Disable ")
          sb.write_string(desc)
          sb.write_string("]' \\\n")
        }
        None => ()
      }
    }
    i = i + 1
  }

  if !cmd.disable_help_flag {
    sb.write_string("    '-h[Print help]' \\\n")
    sb.write_string("    '--help[Print help]' \\\n")
  }
  if !cmd.disable_version_flag && cmd.version_str is Some(_) {
    sb.write_string("    '-V[Print version]' \\\n")
    sb.write_string("    '--version[Print version]' \\\n")
  }

  let mut has_subs = false
  let mut si = 0
  while si < cmd.subcommands_list.length() {
    if !cmd.subcommands_list[si].hide_flag {
      has_subs = true
    }
    si = si + 1
  }

  if has_subs {
    sb.write_string("    '1: :->cmds' \\\n")
    sb.write_string("    '*::arg:->args'\n")
    sb.write_string("  case \"$state\" in\n")
    sb.write_string("    cmds)\n")
    sb.write_string("      commands=(\n")
    let mut sj = 0
    while sj < cmd.subcommands_list.length() {
      let sub = cmd.subcommands_list[sj]
      if !sub.hide_flag {
        sb.write_string("        '")
        sb.write_string(escape_zsh_desc(sub.name))
        sb.write_string(":")
        sb.write_string(escape_zsh_desc(sub.about_str))
        sb.write_string("'\n")
      }
      sj = sj + 1
    }
    sb.write_string("      )\n")
    sb.write_string("      _describe 'command' commands\n")
    sb.write_string("      ;;\n")
    sb.write_string("    args)\n")
    sb.write_string("      case \"$line[1]\" in\n")
    let mut sk = 0
    while sk < cmd.subcommands_list.length() {
      let sub = cmd.subcommands_list[sk]
      if !sub.hide_flag {
        sb.write_string("        ")
        sb.write_string(escape_bash_token(sub.name))
        sb.write_string(") ")
        sb.write_string(fn_name)
        sb.write_string("__")
        sb.write_string(sanitize_shell_ident(sub.name))
        sb.write_string(" ;;\n")
      }
      sk = sk + 1
    }
    sb.write_string("      esac\n")
    sb.write_string("      ;;\n")
    sb.write_string("  esac\n")
  } else {
    sb.write_string("    '*:file:_files'\n")
  }
  sb.write_string("}\n")

  let mut sm = 0
  while sm < cmd.subcommands_list.length() {
    let sub = cmd.subcommands_list[sm]
    if !sub.hide_flag {
      emit_zsh_fn(sb, sub, fn_name + "__" + sanitize_shell_ident(sub.name))
    }
    sm = sm + 1
  }
}

///| Generate Zsh completion script.
fn generate_zsh(cmd : Command) -> String {
  let sb = StringBuilder::new()
  sb.write_string("#compdef ")
  sb.write_string(escape_bash_token(cmd.name))
  sb.write_string("\n")
  let root_fn = "_" + sanitize_shell_ident(cmd.name)
  emit_zsh_fn(sb, cmd, root_fn)
  sb.write_string(root_fn)
  sb.write_string(" \"$@\"\n")
  sb.to_string()
}

///| Emit Fish completion lines for a command and its descendants.
fn emit_fish_cmd(
  sb : StringBuilder,
  root_name : String,
  cmd : Command,
  cond : String,
) -> Unit {
  let mut i = 0
  while i < cmd.args_list.length() {
    let a = cmd.args_list[i]
    if !a.hide_flag && !a.is_positional() {
      sb.write_string("complete -c ")
      sb.write_string(root_name)
      if cond.length() > 0 {
        sb.write_string(" -n '")
        sb.write_string(cond)
        sb.write_char('\'')
      }
      match a.short_name {
        Some(ch) => {
          sb.write_string(" -s ")
          sb.write_char(ch)
        }
        None => ()
      }
      match a.long_name {
        Some(ln) => {
          sb.write_string(" -l ")
          sb.write_string(escape_bash_token(ln))
        }
        None => ()
      }
      if help_arg_takes_value(a) {
        sb.write_string(" -r")
      }
      if a.possible_vals.length() > 0 {
        sb.write_string(" -f -a '")
        let mut vi = 0
        while vi < a.possible_vals.length() {
          if vi > 0 {
            sb.write_char(' ')
          }
          sb.write_string(escape_fish_sq(a.possible_vals[vi]))
          vi = vi + 1
        }
        sb.write_char('\'')
      }
      if a.help_text.length() > 0 {
        sb.write_string(" -d '")
        sb.write_string(escape_fish_sq(a.help_text))
        sb.write_char('\'')
      }
      sb.write_char('\n')

      match a.negative_long {
        Some(nl) => {
          sb.write_string("complete -c ")
          sb.write_string(root_name)
          if cond.length() > 0 {
            sb.write_string(" -n '")
            sb.write_string(cond)
            sb.write_char('\'')
          }
          sb.write_string(" -l ")
          sb.write_string(escape_bash_token(nl))
          sb.write_string(" -d 'Disable ")
          sb.write_string(escape_fish_sq(a.help_text))
          sb.write_string("'\n")
        }
        None => ()
      }
    }
    i = i + 1
  }

  let mut si = 0
  while si < cmd.subcommands_list.length() {
    let sub = cmd.subcommands_list[si]
    if !sub.hide_flag {
      let sub_tok = escape_bash_token(sub.name)
      sb.write_string("complete -c ")
      sb.write_string(root_name)
      sb.write_string(" -f -n '")
      if cond.length() > 0 {
        sb.write_string(cond)
      } else {
        sb.write_string("__fish_use_subcommand")
      }
      sb.write_string("' -a '")
      sb.write_string(escape_fish_sq(sub.name))
      sb.write_char('\'')
      if sub.about_str.length() > 0 {
        sb.write_string(" -d '")
        sb.write_string(escape_fish_sq(sub.about_str))
        sb.write_char('\'')
      }
      sb.write_char('\n')
      let sub_cond = "__fish_seen_subcommand_from " + sub_tok
      emit_fish_cmd(sb, root_name, sub, sub_cond)
    }
    si = si + 1
  }
}

///| Generate Fish completion script.
fn generate_fish(cmd : Command) -> String {
  let sb = StringBuilder::new()
  sb.write_string("# Fish completion for ")
  sb.write_string(sanitize_single_line(cmd.name))
  sb.write_string("\n")
  emit_fish_cmd(sb, escape_bash_token(cmd.name), cmd, "")
  sb.to_string()
}

///| Generate a shell completion script for `cmd`.
pub fn generate_completions(cmd : Command, shell : Shell) -> Result[String, CliError] {
  match cmd.validate() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  match shell {
    Shell::Bash => Ok(generate_bash(cmd))
    Shell::Zsh => Ok(generate_zsh(cmd))
    Shell::Fish => Ok(generate_fish(cmd))
  }
}
