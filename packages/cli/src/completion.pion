///| Shell completion script generator for Bash, Zsh, and Fish with injection-safe escaping.

///| Hex digit byte for lowercase hex encoding.
fn hex_digit_byte(n : Int) -> Byte {
  if n < 10 {
    (48 + n).to_byte()
  } else {
    (87 + n).to_byte()
  }
}

///| Collision-free reversible identifier encoding for shell function names and case keys.
///| Pure `[a-zA-Z0-9]` bytes are kept verbatim; every other byte (including `_` and `-`)
///| is encoded as `_xHH_` so distinct names like `a-b` and `a_b` never collide.
fn sanitize_shell_ident(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
      sb.write_byte(c.to_byte())
    } else {
      sb.write_string("_x")
      sb.write_byte(hex_digit_byte((c >> 4) & 15))
      sb.write_byte(hex_digit_byte(c & 15))
      sb.write_byte(95.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Replace CR, LF, TAB with single space while preserving UTF-8 bytes verbatim.
fn sanitize_single_line(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 10 || c == 13 || c == 9 {
      sb.write_byte(32.to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Return true if `s` consists solely of safe plain ASCII word characters `[a-zA-Z0-9._+-]`.
fn is_plain_word(s : String) -> Bool {
  if s.length() == 0 {
    return false
  }
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    let ok = (c >= 65 && c <= 90) ||
    (c >= 97 && c <= 122) ||
    (c >= 48 && c <= 57) ||
    c == 46 ||
    c == 95 ||
    c == 43 ||
    c == 45
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

///| Return true if every element of `arr` is a plain safe word.
fn all_plain_words(arr : Array[String]) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if !is_plain_word(arr[i]) {
      return false
    }
    i = i + 1
  }
  true
}

///| Return true if `s` contains any `$`, backtick, or control character needing ANSI-C quoting.
fn needs_ansic_quote(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 36 || c == 96 || c == 10 || c == 13 || c == 9 || c == 0 {
      return true
    }
    i = i + 1
  }
  false
}

///| Quote a string as a Bash/Zsh single-quoted literal `'...'` or ANSI-C literal `$'...'`.
///| Never contains raw `$(` or backticks, never triggers expansion, preserves UTF-8 verbatim.
fn quote_posix_literal(s : String) -> String {
  let clean = sanitize_single_line(s)
  let sb = StringBuilder::new()
  if needs_ansic_quote(clean) {
    sb.write_string("$'")
    let mut i = 0
    while i < clean.length() {
      let c = clean.code_unit_at(i)
      if c == 39 {
        sb.write_string("\\'")
      } else if c == 92 {
        sb.write_string("\\\\")
      } else if c == 36 {
        sb.write_string("\\x24")
      } else if c == 96 {
        sb.write_string("\\x60")
      } else {
        sb.write_byte(c.to_byte())
      }
      i = i + 1
    }
    sb.write_byte(39.to_byte())
  } else {
    sb.write_byte(39.to_byte())
    let mut i = 0
    while i < clean.length() {
      let c = clean.code_unit_at(i)
      if c == 39 {
        sb.write_string("'\\''")
      } else {
        sb.write_byte(c.to_byte())
      }
      i = i + 1
    }
    sb.write_byte(39.to_byte())
  }
  sb.to_string()
}

///| Quote a string for Bash/Zsh only if it is not already a plain safe word.
fn quote_posix_if_needed(s : String) -> String {
  if is_plain_word(s) {
    s
  } else {
    quote_posix_literal(s)
  }
}

///| Escape a description for Zsh `_arguments` / `_describe` inside single quotes `'...'`.
///| Preserves UTF-8 bytes verbatim.
fn escape_zsh_desc(s : String) -> String {
  let clean = sanitize_single_line(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < clean.length() {
    let c = clean.code_unit_at(i)
    if c == 39 {
      sb.write_string("'\\''")
    } else if c == 92 || c == 58 || c == 91 || c == 93 {
      // \, :, [, ]
      sb.write_byte(92.to_byte())
      sb.write_byte(c.to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Escape a short or long flag name inside Zsh `_arguments` single-quoted optspec.
fn escape_zsh_opt_name(s : String) -> String {
  let clean = sanitize_single_line(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < clean.length() {
    let c = clean.code_unit_at(i)
    if c == 39 {
      sb.write_string("'\\''")
    } else if c == 92 || c == 58 || c == 91 || c == 93 || c == 43 || c == 61 {
      sb.write_byte(92.to_byte())
      sb.write_byte(c.to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Escape a string for Fish single quotes (`\` -> `\\`, `'` -> `\'`, newlines -> space).
///| Preserves UTF-8 bytes verbatim.
fn escape_fish_sq(s : String) -> String {
  let clean = sanitize_single_line(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < clean.length() {
    let c = clean.code_unit_at(i)
    if c == 92 {
      sb.write_string("\\\\")
    } else if c == 39 {
      sb.write_string("\\'")
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Quote a Fish token with single quotes if not a plain safe word.
fn quote_fish_if_needed(s : String) -> String {
  if is_plain_word(s) {
    s
  } else {
    "'" + escape_fish_sq(s) + "'"
  }
}

///| Escape a single Fish `complete -a '...'` value so Fish neither expands `$(...)`/`(...)` nor splits spaces.
fn escape_fish_arg_value(s : String) -> String {
  let clean = sanitize_single_line(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < clean.length() {
    let c = clean.code_unit_at(i)
    if c == 92 {
      sb.write_string("\\\\\\\\")
    } else if c == 39 {
      sb.write_string("\\'")
    } else if c == 36 ||
    c == 96 ||
    c == 40 ||
    c == 41 ||
    c == 32 ||
    c == 59 ||
    c == 38 ||
    c == 124 ||
    c == 60 ||
    c == 62 ||
    c == 34 ||
    c == 42 ||
    c == 63 ||
    c == 123 ||
    c == 125 {
      // Emit \\<char> inside Fish single quotes -> Fish sees \<char> when expanding -a
      sb.write_string("\\\\")
      sb.write_byte(c.to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Merge local command args with inherited global args (local shadows global by id).
fn effective_cmd_args(cmd : Command, inherited_globals : Array[Arg]) -> Array[Arg] {
  let out : Array[Arg] = []
  let seen : Map[String, Bool] = Map::new()
  let mut i = 0
  while i < cmd.args_list.length() {
    let a = cmd.args_list[i]
    out.push(a)
    seen.set(a.id, true)
    i = i + 1
  }
  let mut gi = 0
  while gi < inherited_globals.length() {
    let g = inherited_globals[gi]
    match seen.get(g.id) {
      Some(_) => ()
      None => {
        out.push(g)
        seen.set(g.id, true)
      }
    }
    gi = gi + 1
  }
  out
}

///| Collect global args to pass down to child subcommands.
fn next_inherited_globals(effective_args : Array[Arg]) -> Array[Arg] {
  let out : Array[Arg] = []
  let mut i = 0
  while i < effective_args.length() {
    if effective_args[i].global_flag {
      out.push(effective_args[i])
    }
    i = i + 1
  }
  out
}

///| Collect visible option tokens for a command (including inherited globals).
fn collect_visible_opts(cmd : Command, effective_args : Array[Arg]) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < effective_args.length() {
    let a = effective_args[i]
    if !a.hide_flag && !a.is_positional() {
      match a.short_name {
        Some(ch) => out.push("-" + ch.to_string())
        None => ()
      }
      match a.long_name {
        Some(ln) => out.push("--" + ln)
        None => ()
      }
      match a.negative_long {
        Some(nl) => out.push("--" + nl)
        None => ()
      }
    }
    i = i + 1
  }
  if !cmd.disable_help_flag {
    if !args_have_short(effective_args, 'h') {
      out.push("-h")
    }
    if !args_have_long(effective_args, "help") {
      out.push("--help")
    }
  }
  if !cmd.disable_version_flag && cmd.version_str is Some(_) {
    if !args_have_short(effective_args, 'V') {
      out.push("-V")
    }
    if !args_have_long(effective_args, "version") {
      out.push("--version")
    }
  }
  out
}

///| Collect visible subcommand names.
fn collect_visible_subs(cmd : Command) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < cmd.subcommands_list.length() {
    let sub = cmd.subcommands_list[i]
    if !sub.hide_flag {
      out.push(sub.name)
    }
    i = i + 1
  }
  out
}

///| Emit Bash completion reply for a list of candidate strings.
///| Uses `compgen -W '...'` only when every candidate is a plain safe word;
///| otherwise uses a single-quoted/ANSI-C array + prefix filter (zero expansion, preserves spaces).
fn emit_bash_reply(sb : StringBuilder, indent : String, vals : Array[String]) -> Unit {
  if vals.length() == 0 {
    return
  }
  if all_plain_words(vals) {
    sb.write_string(indent)
    sb.write_string("COMPREPLY=( $(compgen -W '")
    let mut i = 0
    while i < vals.length() {
      if i > 0 {
        sb.write_char(' ')
      }
      sb.write_string(vals[i])
      i = i + 1
    }
    sb.write_string("' -- \"$cur\") )\n")
  } else {
    sb.write_string(indent)
    sb.write_string("local -a _vals=(")
    let mut i = 0
    while i < vals.length() {
      if i > 0 {
        sb.write_char(' ')
      }
      sb.write_string(quote_posix_literal(vals[i]))
      i = i + 1
    }
    sb.write_string(")\n")
    sb.write_string(indent)
    sb.write_string("local _v\n")
    sb.write_string(indent)
    sb.write_string("for _v in \"${_vals[@]}\"; do\n")
    sb.write_string(indent)
    sb.write_string("  [[ \"$_v\" == \"$cur\"* ]] && COMPREPLY+=(\"$_v\")\n")
    sb.write_string(indent)
    sb.write_string("done\n")
  }
}

///| Emit Bash subcommand-walker state transitions (skipping option values, advancing only on known subcommands).
fn emit_bash_walker(
  sb : StringBuilder,
  cmd : Command,
  inherited_globals : Array[Arg],
  path_key : String,
) -> Unit {
  let eff_args = effective_cmd_args(cmd, inherited_globals)
  let next_globals = next_inherited_globals(eff_args)

  // Collect value-taking flags for this command level
  let val_flags : Array[String] = []
  let mut i = 0
  while i < eff_args.length() {
    let a = eff_args[i]
    if !a.hide_flag && !a.is_positional() && help_arg_takes_value(a) {
      match a.short_name {
        Some(ch) => val_flags.push("-" + ch.to_string())
        None => ()
      }
      match a.long_name {
        Some(ln) => val_flags.push("--" + ln)
        None => ()
      }
    }
    i = i + 1
  }

  let mut has_subs = false
  let mut si = 0
  while si < cmd.subcommands_list.length() {
    if !cmd.subcommands_list[si].hide_flag {
      has_subs = true
    }
    si = si + 1
  }

  if val_flags.length() > 0 || has_subs {
    sb.write_string("      ")
    sb.write_string(path_key)
    sb.write_string(")\n")
    sb.write_string("        case \"${COMP_WORDS[i]}\" in\n")
    if val_flags.length() > 0 {
      sb.write_string("          ")
      let mut vi = 0
      while vi < val_flags.length() {
        if vi > 0 {
          sb.write_char('|')
        }
        sb.write_string(quote_posix_literal(val_flags[vi]))
        vi = vi + 1
      }
      sb.write_string(") ((i++)) ;;\n")
    }
    let mut sj = 0
    while sj < cmd.subcommands_list.length() {
      let sub = cmd.subcommands_list[sj]
      if !sub.hide_flag {
        let child_key = path_key + "__" + sanitize_shell_ident(sub.name)
        sb.write_string("          ")
        sb.write_string(quote_posix_literal(sub.name))
        let mut ak = 0
        while ak < sub.aliases_list.length() {
          sb.write_char('|')
          sb.write_string(quote_posix_literal(sub.aliases_list[ak]))
          ak = ak + 1
        }
        sb.write_string(") cmd=\"")
        sb.write_string(child_key)
        sb.write_string("\" ;;\n")
      }
      sj = sj + 1
    }
    sb.write_string("        esac\n")
    sb.write_string("        ;;\n")
  }

  let mut sk = 0
  while sk < cmd.subcommands_list.length() {
    let sub = cmd.subcommands_list[sk]
    if !sub.hide_flag {
      let child_key = path_key + "__" + sanitize_shell_ident(sub.name)
      emit_bash_walker(sb, sub, next_globals, child_key)
    }
    sk = sk + 1
  }
}

///| Emit Bash case branch for a command and its descendants.
fn emit_bash_cases(
  sb : StringBuilder,
  cmd : Command,
  inherited_globals : Array[Arg],
  path_key : String,
) -> Unit {
  let eff_args = effective_cmd_args(cmd, inherited_globals)
  let next_globals = next_inherited_globals(eff_args)

  sb.write_string("    ")
  sb.write_string(path_key)
  sb.write_string(")\n")

  // Handle prev-flag possible_values
  let mut has_val_cases = false
  let mut i = 0
  while i < eff_args.length() {
    let a = eff_args[i]
    if !a.hide_flag && !a.is_positional() && a.possible_vals.length() > 0 {
      if !has_val_cases {
        sb.write_string("      case \"$prev\" in\n")
        has_val_cases = true
      }
      sb.write_string("        ")
      let mut pat_first = true
      match a.short_name {
        Some(ch) => {
          sb.write_string(quote_posix_literal("-" + ch.to_string()))
          pat_first = false
        }
        None => ()
      }
      match a.long_name {
        Some(ln) => {
          if !pat_first {
            sb.write_char('|')
          }
          sb.write_string(quote_posix_literal("--" + ln))
        }
        None => ()
      }
      sb.write_string(")\n")
      emit_bash_reply(sb, "          ", a.possible_vals)
      sb.write_string("          return 0\n")
      sb.write_string("          ;;\n")
    }
    i = i + 1
  }
  if has_val_cases {
    sb.write_string("      esac\n")
  }

  let opts = collect_visible_opts(cmd, eff_args)
  let subs = collect_visible_subs(cmd)
  let all_words : Array[String] = []
  let mut oi = 0
  while oi < opts.length() {
    all_words.push(opts[oi])
    oi = oi + 1
  }
  let mut si = 0
  while si < subs.length() {
    all_words.push(subs[si])
    si = si + 1
  }
  emit_bash_reply(sb, "      ", all_words)
  sb.write_string("      return 0\n")
  sb.write_string("      ;;\n")

  let mut sk = 0
  while sk < cmd.subcommands_list.length() {
    let sub = cmd.subcommands_list[sk]
    if !sub.hide_flag {
      emit_bash_cases(sb, sub, next_globals, path_key + "__" + sanitize_shell_ident(sub.name))
    }
    sk = sk + 1
  }
}

///| Generate Bash completion script.
fn generate_bash(cmd : Command) -> String {
  let root_key = sanitize_shell_ident(cmd.name)
  let fn_name = "_" + root_key
  let sb = StringBuilder::new()
  sb.write_string("# Bash completion for ")
  sb.write_string(quote_posix_if_needed(cmd.name))
  sb.write_string("\n")
  sb.write_string(fn_name)
  sb.write_string("() {\n")
  sb.write_string("  local i cur prev cmd\n")
  sb.write_string("  COMPREPLY=()\n")
  sb.write_string("  cur=\"${COMP_WORDS[COMP_CWORD]}\"\n")
  sb.write_string("  prev=\"${COMP_WORDS[COMP_CWORD-1]}\"\n")
  sb.write_string("  cmd=\"")
  sb.write_string(root_key)
  sb.write_string("\"\n")
  sb.write_string("  for ((i=1; i < COMP_CWORD; i++)); do\n")
  sb.write_string("    case \"$cmd\" in\n")
  emit_bash_walker(sb, cmd, [], root_key)
  sb.write_string("    esac\n")
  sb.write_string("  done\n")
  sb.write_string("  case \"$cmd\" in\n")
  emit_bash_cases(sb, cmd, [], root_key)
  sb.write_string("  esac\n")
  sb.write_string("}\n")
  sb.write_string("complete -F ")
  sb.write_string(fn_name)
  sb.write_string(" ")
  sb.write_string(quote_posix_if_needed(cmd.name))
  sb.write_string("\n")
  sb.to_string()
}

///| Emit Zsh completion function for a command and its subcommands.
///| Uses helper functions with `compadd --` whenever `possible_values` contain spaces or metacharacters
///| so Zsh `_arguments` never `eval`s untrusted values.
fn emit_zsh_fn(
  sb : StringBuilder,
  cmd : Command,
  inherited_globals : Array[Arg],
  fn_name : String,
) -> Unit {
  let eff_args = effective_cmd_args(cmd, inherited_globals)
  let next_globals = next_inherited_globals(eff_args)

  // First emit safe `compadd` helper functions for any non-plain possible_values
  let pv_helpers : Map[Int, String] = Map::new()
  let mut hi = 0
  while hi < eff_args.length() {
    let a = eff_args[hi]
    if !a.hide_flag && !a.is_positional() && a.possible_vals.length() > 0 && !all_plain_words(a.possible_vals) {
      let hname = fn_name + "__pv_" + hi.to_string()
      pv_helpers.set(hi, hname)
      sb.write_string(hname)
      sb.write_string("() {\n")
      sb.write_string("  local -a _vals\n")
      sb.write_string("  _vals=(\n")
      let mut vi = 0
      while vi < a.possible_vals.length() {
        sb.write_string("    ")
        sb.write_string(quote_posix_literal(a.possible_vals[vi]))
        sb.write_char('\n')
        vi = vi + 1
      }
      sb.write_string("  )\n")
      sb.write_string("  compadd -- \"${_vals[@]}\"\n")
      sb.write_string("}\n")
    }
    hi = hi + 1
  }

  sb.write_string(fn_name)
  sb.write_string("() {\n")
  sb.write_string("  local -a commands\n")
  sb.write_string("  _arguments -s -S \\\n")

  let mut i = 0
  while i < eff_args.length() {
    let a = eff_args[i]
    if !a.hide_flag && !a.is_positional() {
      let desc = escape_zsh_desc(a.help_text)
      let val_spec = if a.possible_vals.length() > 0 {
        match pv_helpers.get(i) {
          Some(hname) => ":" + escape_zsh_desc(arg_value_placeholder(a)) + ":" + hname
          None => {
            let vsb = StringBuilder::new()
            vsb.write_string(":")
            vsb.write_string(escape_zsh_desc(arg_value_placeholder(a)))
            vsb.write_string(":(")
            let mut vi = 0
            while vi < a.possible_vals.length() {
              if vi > 0 {
                vsb.write_char(' ')
              }
              vsb.write_string(a.possible_vals[vi])
              vi = vi + 1
            }
            vsb.write_char(')')
            vsb.to_string()
          }
        }
      } else if help_arg_takes_value(a) {
        ":" + escape_zsh_desc(arg_value_placeholder(a)) + ": "
      } else {
        ""
      }

      match a.short_name {
        Some(ch) => {
          sb.write_string("    '-")
          sb.write_string(escape_zsh_opt_name(ch.to_string()))
          sb.write_string("[")
          sb.write_string(desc)
          sb.write_string("]")
          sb.write_string(val_spec)
          sb.write_string("' \\\n")
        }
        None => ()
      }
      match a.long_name {
        Some(ln) => {
          sb.write_string("    '--")
          sb.write_string(escape_zsh_opt_name(ln))
          sb.write_string("[")
          sb.write_string(desc)
          sb.write_string("]")
          sb.write_string(val_spec)
          sb.write_string("' \\\n")
        }
        None => ()
      }
      match a.negative_long {
        Some(nl) => {
          sb.write_string("    '--")
          sb.write_string(escape_zsh_opt_name(nl))
          sb.write_string("[Disable ")
          sb.write_string(desc)
          sb.write_string("]' \\\n")
        }
        None => ()
      }
    }
    i = i + 1
  }

  if !cmd.disable_help_flag {
    if !args_have_short(eff_args, 'h') {
      sb.write_string("    '-h[Print help]' \\\n")
    }
    if !args_have_long(eff_args, "help") {
      sb.write_string("    '--help[Print help]' \\\n")
    }
  }
  if !cmd.disable_version_flag && cmd.version_str is Some(_) {
    if !args_have_short(eff_args, 'V') {
      sb.write_string("    '-V[Print version]' \\\n")
    }
    if !args_have_long(eff_args, "version") {
      sb.write_string("    '--version[Print version]' \\\n")
    }
  }

  let mut has_subs = false
  let mut si = 0
  while si < cmd.subcommands_list.length() {
    if !cmd.subcommands_list[si].hide_flag {
      has_subs = true
    }
    si = si + 1
  }

  if has_subs {
    sb.write_string("    '1: :->cmds' \\\n")
    sb.write_string("    '*::arg:->args'\n")
    sb.write_string("  case \"$state\" in\n")
    sb.write_string("    cmds)\n")
    sb.write_string("      commands=(\n")
    let mut sj = 0
    while sj < cmd.subcommands_list.length() {
      let sub = cmd.subcommands_list[sj]
      if !sub.hide_flag {
        sb.write_string("        '")
        sb.write_string(escape_zsh_desc(sub.name))
        sb.write_string(":")
        sb.write_string(escape_zsh_desc(sub.about_str))
        sb.write_string("'\n")
      }
      sj = sj + 1
    }
    sb.write_string("      )\n")
    sb.write_string("      _describe 'command' commands\n")
    sb.write_string("      ;;\n")
    sb.write_string("    args)\n")
    sb.write_string("      case \"$line[1]\" in\n")
    let mut sk = 0
    while sk < cmd.subcommands_list.length() {
      let sub = cmd.subcommands_list[sk]
      if !sub.hide_flag {
        let child_fn = fn_name + "__" + sanitize_shell_ident(sub.name)
        sb.write_string("        ")
        sb.write_string(quote_posix_literal(sub.name))
        let mut ak = 0
        while ak < sub.aliases_list.length() {
          sb.write_char('|')
          sb.write_string(quote_posix_literal(sub.aliases_list[ak]))
          ak = ak + 1
        }
        sb.write_string(") ")
        sb.write_string(child_fn)
        sb.write_string(" ;;\n")
      }
      sk = sk + 1
    }
    sb.write_string("      esac\n")
    sb.write_string("      ;;\n")
    sb.write_string("  esac\n")
  } else {
    sb.write_string("    '*:file:_files'\n")
  }
  sb.write_string("}\n")

  let mut sm = 0
  while sm < cmd.subcommands_list.length() {
    let sub = cmd.subcommands_list[sm]
    if !sub.hide_flag {
      emit_zsh_fn(sb, sub, next_globals, fn_name + "__" + sanitize_shell_ident(sub.name))
    }
    sm = sm + 1
  }
}

///| Generate Zsh completion script.
fn generate_zsh(cmd : Command) -> String {
  let sb = StringBuilder::new()
  sb.write_string("#compdef ")
  sb.write_string(quote_posix_if_needed(cmd.name))
  sb.write_string("\n")
  let root_fn = "_" + sanitize_shell_ident(cmd.name)
  emit_zsh_fn(sb, cmd, [], root_fn)
  sb.write_string(root_fn)
  sb.write_string(" \"$@\"\n")
  sb.to_string()
}

///| Emit Fish completion lines for a command and its descendants.
fn emit_fish_cmd(
  sb : StringBuilder,
  root_name_quoted : String,
  cmd : Command,
  inherited_globals : Array[Arg],
  cond : String,
) -> Unit {
  let eff_args = effective_cmd_args(cmd, inherited_globals)
  let next_globals = next_inherited_globals(eff_args)

  let mut i = 0
  while i < eff_args.length() {
    let a = eff_args[i]
    if !a.hide_flag && !a.is_positional() {
      sb.write_string("complete -c ")
      sb.write_string(root_name_quoted)
      if cond.length() > 0 {
        sb.write_string(" -n '")
        sb.write_string(cond)
        sb.write_char('\'')
      }
      match a.short_name {
        Some(ch) => {
          sb.write_string(" -s ")
          sb.write_string(quote_fish_if_needed(ch.to_string()))
        }
        None => ()
      }
      match a.long_name {
        Some(ln) => {
          sb.write_string(" -l ")
          sb.write_string(quote_fish_if_needed(ln))
        }
        None => ()
      }
      if help_arg_takes_value(a) {
        sb.write_string(" -r")
      }
      if a.possible_vals.length() > 0 {
        sb.write_string(" -f -a '")
        let plain = all_plain_words(a.possible_vals)
        let mut vi = 0
        while vi < a.possible_vals.length() {
          if vi > 0 {
            sb.write_char(' ')
          }
          if plain {
            sb.write_string(a.possible_vals[vi])
          } else {
            sb.write_string(escape_fish_arg_value(a.possible_vals[vi]))
          }
          vi = vi + 1
        }
        sb.write_char('\'')
      }
      if a.help_text.length() > 0 {
        sb.write_string(" -d '")
        sb.write_string(escape_fish_sq(a.help_text))
        sb.write_char('\'')
      }
      sb.write_char('\n')

      match a.negative_long {
        Some(nl) => {
          sb.write_string("complete -c ")
          sb.write_string(root_name_quoted)
          if cond.length() > 0 {
            sb.write_string(" -n '")
            sb.write_string(cond)
            sb.write_char('\'')
          }
          sb.write_string(" -l ")
          sb.write_string(quote_fish_if_needed(nl))
          sb.write_string(" -d 'Disable ")
          sb.write_string(escape_fish_sq(a.help_text))
          sb.write_string("'\n")
        }
        None => ()
      }
    }
    i = i + 1
  }

  let mut si = 0
  while si < cmd.subcommands_list.length() {
    let sub = cmd.subcommands_list[si]
    if !sub.hide_flag {
      sb.write_string("complete -c ")
      sb.write_string(root_name_quoted)
      sb.write_string(" -f -n '")
      if cond.length() > 0 {
        sb.write_string(cond)
      } else {
        sb.write_string("__fish_use_subcommand")
      }
      sb.write_string("' -a '")
      if is_plain_word(sub.name) {
        sb.write_string(sub.name)
      } else {
        sb.write_string(escape_fish_arg_value(sub.name))
      }
      sb.write_char('\'')
      if sub.about_str.length() > 0 {
        sb.write_string(" -d '")
        sb.write_string(escape_fish_sq(sub.about_str))
        sb.write_char('\'')
      }
      sb.write_char('\n')
      let sub_cond = "__fish_seen_subcommand_from " + escape_fish_arg_value(sub.name)
      emit_fish_cmd(sb, root_name_quoted, sub, next_globals, sub_cond)
    }
    si = si + 1
  }
}

///| Generate Fish completion script.
fn generate_fish(cmd : Command) -> String {
  let sb = StringBuilder::new()
  sb.write_string("# Fish completion for ")
  sb.write_string(quote_fish_if_needed(cmd.name))
  sb.write_string("\n")
  emit_fish_cmd(sb, quote_fish_if_needed(cmd.name), cmd, [], "")
  sb.to_string()
}

///| Generate a shell completion script for `cmd`.
pub fn generate_completions(cmd : Command, shell : Shell) -> Result[String, CliError] {
  match cmd.validate() {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  match shell {
    Shell::Bash => Ok(generate_bash(cmd))
    Shell::Zsh => Ok(generate_zsh(cmd))
    Shell::Fish => Ok(generate_fish(cmd))
  }
}
