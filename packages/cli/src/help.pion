///| Help and version formatter for `Command`.

///| Convert ASCII lowercase string to uppercase for default value placeholders.
fn to_ascii_upper(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 97 && c <= 122 {
      sb.write_char((c - 32).unsafe_to_char())
    } else if c == 45 {
      sb.write_char('_')
    } else {
      sb.write_char(c.unsafe_to_char())
    }
    i = i + 1
  }
  sb.to_string()
}

///| Return whether an argument takes a value on the command line.
fn help_arg_takes_value(a : Arg) -> Bool {
  match a.action {
    ArgAction::Set => true
    ArgAction::Append => true
    _ => false
  }
}

///| Return the display placeholder for a value-taking argument.
fn arg_value_placeholder(a : Arg) -> String {
  match a.value_name {
    Some(vn) => vn
    None => to_ascii_upper(a.id)
  }
}

///| Format the left column specification for an option/flag.
fn format_option_spec(a : Arg) -> String {
  let sb = StringBuilder::new()
  match a.short_name {
    Some(ch) => {
      sb.write_char('-')
      sb.write_char(ch)
      match a.long_name {
        Some(_) => sb.write_string(", ")
        None => ()
      }
    }
    None => sb.write_string("    ")
  }
  match a.long_name {
    Some(ln) => {
      sb.write_string("--")
      sb.write_string(ln)
    }
    None => ()
  }
  match a.negative_long {
    Some(nl) => {
      if a.long_name is Some(_) || a.short_name is Some(_) {
        sb.write_string("/--")
      } else {
        sb.write_string("--")
      }
      sb.write_string(nl)
    }
    None => ()
  }
  if help_arg_takes_value(a) {
    sb.write_string(" <")
    sb.write_string(arg_value_placeholder(a))
    sb.write_char('>')
  }
  sb.to_string()
}

///| Format the right-hand description for an argument (short or long help).
fn format_arg_desc(a : Arg, is_long : Bool) -> String {
  let sb = StringBuilder::new()
  let base = if is_long {
    match a.long_help_text {
      Some(lh) => lh
      None => a.help_text
    }
  } else {
    a.help_text
  }
  sb.write_string(base)
  if is_long {
    match a.env_name {
      Some(ev) => {
        if sb.to_string().length() > 0 {
          sb.write_char(' ')
        }
        sb.write_string("[env: ")
        sb.write_string(ev)
        sb.write_char(']')
      }
      None => ()
    }
    match a.default_val {
      Some(dv) => {
        if sb.to_string().length() > 0 {
          sb.write_char(' ')
        }
        sb.write_string("[default: ")
        sb.write_string(dv)
        sb.write_char(']')
      }
      None => ()
    }
    if a.possible_vals.length() > 0 {
      if sb.to_string().length() > 0 {
        sb.write_char(' ')
      }
      sb.write_string("[possible values: ")
      let mut i = 0
      while i < a.possible_vals.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        sb.write_string(a.possible_vals[i])
        i = i + 1
      }
      sb.write_char(']')
    }
  }
  sb.to_string()
}

///| Write `n` spaces to `sb`.
fn write_spaces(sb : StringBuilder, n : Int) -> Unit {
  let mut i = 0
  while i < n {
    sb.write_char(' ')
    i = i + 1
  }
}

///| Check whether user already claimed short flag `ch` or long flag `ln`.
fn cmd_has_short(cmd : Command, ch : Char) -> Bool {
  let mut i = 0
  while i < cmd.args_list.length() {
    match cmd.args_list[i].short_name {
      Some(c) => if c == ch { return true }
      None => ()
    }
    i = i + 1
  }
  false
}

///|
fn cmd_has_long(cmd : Command, ln : String) -> Bool {
  let mut i = 0
  while i < cmd.args_list.length() {
    match cmd.args_list[i].long_name {
      Some(s) => if s == ln { return true }
      None => ()
    }
    match cmd.args_list[i].negative_long {
      Some(s) => if s == ln { return true }
      None => ()
    }
    i = i + 1
  }
  false
}

///| Shared short/long help renderer.
fn render_help_inner(cmd : Command, is_long : Bool) -> String {
  let sb = StringBuilder::new()

  // Description
  let about = if is_long {
    match cmd.long_about_str {
      Some(la) => la
      None => cmd.about_str
    }
  } else {
    cmd.about_str
  }
  if about.length() > 0 {
    sb.write_string(about)
    sb.write_string("\n\n")
  }

  // Collect visible positionals, options, and subcommands
  let pos_rows : Array[(String, String)] = []
  let opt_rows : Array[(String, String)] = []
  let sub_rows : Array[(String, String)] = []
  let mut max_left = 0

  let mut i = 0
  while i < cmd.args_list.length() {
    let a = cmd.args_list[i]
    if !a.hide_flag {
      if a.is_positional() {
        let ph = arg_value_placeholder(a)
        let left = if a.required_flag {
          if a.multiple_values {
            "<" + ph + ">..."
          } else {
            "<" + ph + ">"
          }
        } else if a.multiple_values {
          "[" + ph + "]..."
        } else {
          "[" + ph + "]"
        }
        if left.length() > max_left {
          max_left = left.length()
        }
        pos_rows.push((left, format_arg_desc(a, is_long)))
      } else {
        let left = format_option_spec(a)
        if left.length() > max_left {
          max_left = left.length()
        }
        opt_rows.push((left, format_arg_desc(a, is_long)))
      }
    }
    i = i + 1
  }

  // Built-in help & version rows
  if !cmd.disable_help_flag {
    let has_h = cmd_has_short(cmd, 'h')
    let has_help = cmd_has_long(cmd, "help")
    if !has_h || !has_help {
      let left = if !has_h && !has_help {
        "-h, --help"
      } else if !has_h {
        "-h"
      } else {
        "    --help"
      }
      if left.length() > max_left {
        max_left = left.length()
      }
      let desc = if is_long {
        "Print help (see a summary with '-h')"
      } else {
        "Print help (see more with '--help')"
      }
      opt_rows.push((left, desc))
    }
  }
  if !cmd.disable_version_flag {
    match cmd.version_str {
      Some(_) => {
        let has_v = cmd_has_short(cmd, 'V')
        let has_ver = cmd_has_long(cmd, "version")
        if !has_v || !has_ver {
          let left = if !has_v && !has_ver {
            "-V, --version"
          } else if !has_v {
            "-V"
          } else {
            "    --version"
          }
          if left.length() > max_left {
            max_left = left.length()
          }
          opt_rows.push((left, "Print version"))
        }
      }
      None => ()
    }
  }

  let mut si = 0
  while si < cmd.subcommands_list.length() {
    let sub = cmd.subcommands_list[si]
    if !sub.hide_flag {
      let left = sub.name
      if left.length() > max_left {
        max_left = left.length()
      }
      sub_rows.push((left, sub.about_str))
    }
    si = si + 1
  }

  // Usage line
  sb.write_string("Usage: ")
  sb.write_string(cmd.name)
  if opt_rows.length() > 0 {
    sb.write_string(" [OPTIONS]")
  }
  let mut pi = 0
  while pi < pos_rows.length() {
    sb.write_char(' ')
    sb.write_string(pos_rows[pi].0)
    pi = pi + 1
  }
  if sub_rows.length() > 0 {
    if cmd.subcommand_required_flag {
      sb.write_string(" <COMMAND>")
    } else {
      sb.write_string(" [COMMAND]")
    }
  }
  sb.write_char('\n')

  let pad_col = max_left + 2

  if pos_rows.length() > 0 {
    sb.write_string("\nArguments:\n")
    let mut k = 0
    while k < pos_rows.length() {
      let (left, right) = pos_rows[k]
      sb.write_string("  ")
      sb.write_string(left)
      if right.length() > 0 {
        write_spaces(sb, pad_col - left.length())
        sb.write_string(right)
      }
      sb.write_char('\n')
      k = k + 1
    }
  }

  if opt_rows.length() > 0 {
    sb.write_string("\nOptions:\n")
    let mut k = 0
    while k < opt_rows.length() {
      let (left, right) = opt_rows[k]
      sb.write_string("  ")
      sb.write_string(left)
      if right.length() > 0 {
        write_spaces(sb, pad_col - left.length())
        sb.write_string(right)
      }
      sb.write_char('\n')
      k = k + 1
    }
  }

  if sub_rows.length() > 0 {
    sb.write_string("\nCommands:\n")
    let mut k = 0
    while k < sub_rows.length() {
      let (left, right) = sub_rows[k]
      sb.write_string("  ")
      sb.write_string(left)
      if right.length() > 0 {
        write_spaces(sb, pad_col - left.length())
        sb.write_string(right)
      }
      sb.write_char('\n')
      k = k + 1
    }
  }

  sb.to_string()
}

///| Render compact help text (triggered by `-h`).
pub fn Command::render_help(self : Command) -> String {
  render_help_inner(self, false)
}

///| Render detailed help text (triggered by `--help`).
pub fn Command::render_long_help(self : Command) -> String {
  render_help_inner(self, true)
}

///| Render version line (triggered by `-V`/`--version`).
pub fn Command::render_version(self : Command) -> String {
  match self.version_str {
    Some(v) => self.name + " " + v + "\n"
    None => self.name + "\n"
  }
}
