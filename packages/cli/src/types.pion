///| Core types, errors, builders, and match structures for `cli`.

///| Maximum allowed subcommand nesting depth to prevent stack overflow.
pub let MAX_SUBCOMMAND_DEPTH : Int = 64

///| Action taken when an argument is encountered on the command line.
pub enum ArgAction {
  Set
  Append
  SetTrue
  SetFalse
  Count
  Help
  Version
}

///| Origin of a matched argument value.
pub enum ValueSource {
  CommandLine
  EnvVariable
  DefaultValue
}

///| Target shell for completion script generation.
pub enum Shell {
  Bash
  Zsh
  Fish
}

///| Structured CLI error (never calls exit).
pub enum CliError {
  DisplayHelp(String)
  DisplayVersion(String)
  UnknownArgument(String, Option[String])
  UnknownSubcommand(String, Option[String])
  MissingValue(String)
  MissingRequired(String)
  InvalidValue(String, String, String)
  Conflict(String, String)
  MissingDependency(String, String)
  UnexpectedArgument(String)
  InvalidDefinition(String)
}

///| Format a `CliError` into a human-readable message.
pub fn cli_error_to_string(err : CliError) -> String {
  match err {
    CliError::DisplayHelp(s) => s
    CliError::DisplayVersion(s) => s
    CliError::UnknownArgument(arg, suggestion) =>
    match suggestion {
      Some(s) => "error: unexpected argument '" + arg + "' found\n\n  tip: did you mean '" + s + "'?"
      None => "error: unexpected argument '" + arg + "' found"
    }
    CliError::UnknownSubcommand(sub, suggestion) =>
    match suggestion {
      Some(s) => "error: unrecognized subcommand '" + sub + "'\n\n  tip: did you mean '" + s + "'?"
      None => "error: unrecognized subcommand '" + sub + "'"
    }
    CliError::MissingValue(arg) => "error: a value is required for '" + arg + "' but none was supplied"
    CliError::MissingRequired(id) => "error: the following required argument was not provided: '" + id + "'"
    CliError::InvalidValue(id, v, detail) =>
    "error: invalid value '" + v + "' for '" + id + "': " + detail
    CliError::Conflict(a, b) =>
    "error: the argument '" + a + "' cannot be used with '" + b + "'"
    CliError::MissingDependency(a, b) =>
    "error: the argument '" + a + "' requires '" + b + "' to be present"
    CliError::UnexpectedArgument(arg) => "error: unexpected positional argument '" + arg + "'"
    CliError::InvalidDefinition(msg) => "error: invalid command definition: " + msg
  }
}

///| Check `ArgAction` equality.
pub fn arg_action_eq(a : ArgAction, b : ArgAction) -> Bool {
  match (a, b) {
    (ArgAction::Set, ArgAction::Set) => true
    (ArgAction::Append, ArgAction::Append) => true
    (ArgAction::SetTrue, ArgAction::SetTrue) => true
    (ArgAction::SetFalse, ArgAction::SetFalse) => true
    (ArgAction::Count, ArgAction::Count) => true
    (ArgAction::Help, ArgAction::Help) => true
    (ArgAction::Version, ArgAction::Version) => true
    _ => false
  }
}

///| Check `ValueSource` equality.
pub fn value_source_eq(a : ValueSource, b : ValueSource) -> Bool {
  match (a, b) {
    (ValueSource::CommandLine, ValueSource::CommandLine) => true
    (ValueSource::EnvVariable, ValueSource::EnvVariable) => true
    (ValueSource::DefaultValue, ValueSource::DefaultValue) => true
    _ => false
  }
}

///| Declarative CLI argument specification (option, flag, or positional).
pub struct Arg {
  pub id : String
  pub short_name : Option[Char]
  pub long_name : Option[String]
  pub negative_long : Option[String]
  pub action : ArgAction
  pub help_text : String
  pub long_help_text : Option[String]
  pub value_name : Option[String]
  pub default_val : Option[String]
  pub env_name : Option[String]
  pub required_flag : Bool
  pub global_flag : Bool
  pub hide_flag : Bool
  pub multiple_values : Bool
  pub allow_hyphen_values_flag : Bool
  pub value_delimiter_char : Option[Char]
  pub possible_vals : Array[String]
  pub conflicts : Array[String]
  pub requires_ids : Array[String]
  pub index_opt : Option[Int]
}

///| Create a new `Arg` with the given identifier.
pub fn Arg::new(id : String) -> Arg {
  Arg::{
    id: id,
    short_name: None,
    long_name: None,
    negative_long: None,
    action: ArgAction::Set,
    help_text: "",
    long_help_text: None,
    value_name: None,
    default_val: None,
    env_name: None,
    required_flag: false,
    global_flag: false,
    hide_flag: false,
    multiple_values: false,
    allow_hyphen_values_flag: false,
    value_delimiter_char: None,
    possible_vals: [],
    conflicts: [],
    requires_ids: [],
    index_opt: None,
  }
}

///| Set short single-character flag (e.g. `'o'` for `-o`).
pub fn Arg::short(self : Arg, c : Char) -> Arg {
  Arg::{ ..self, short_name: Some(c) }
}

///| Set long flag name without leading `--` (e.g. `"output"` for `--output`).
pub fn Arg::long(self : Arg, name : String) -> Arg {
  Arg::{ ..self, long_name: Some(name) }
}

///| Set negative boolean long flag name without leading `--` (e.g. `"no-color"`).
pub fn Arg::negative(self : Arg, name : String) -> Arg {
  Arg::{ ..self, negative_long: Some(name) }
}

///| Set the `ArgAction`.
pub fn Arg::action(self : Arg, a : ArgAction) -> Arg {
  Arg::{ ..self, action: a }
}

///| Set short help description.
pub fn Arg::help(self : Arg, h : String) -> Arg {
  Arg::{ ..self, help_text: h }
}

///| Set extended help description shown for `--help`.
pub fn Arg::long_help(self : Arg, h : String) -> Arg {
  Arg::{ ..self, long_help_text: Some(h) }
}

///| Set placeholder value name in help text (e.g. `"FILE"`).
pub fn Arg::value_name(self : Arg, name : String) -> Arg {
  Arg::{ ..self, value_name: Some(name) }
}

///| Set default value used when neither CLI nor env provides a value.
pub fn Arg::default_value(self : Arg, v : String) -> Arg {
  Arg::{ ..self, default_val: Some(v) }
}

///| Set environment variable fallback name.
pub fn Arg::env(self : Arg, name : String) -> Arg {
  Arg::{ ..self, env_name: Some(name) }
}

///| Mark whether this argument is required.
pub fn Arg::required(self : Arg, r : Bool) -> Arg {
  Arg::{ ..self, required_flag: r }
}

///| Mark whether this argument is global across all descendant subcommands.
pub fn Arg::global(self : Arg, g : Bool) -> Arg {
  Arg::{ ..self, global_flag: g }
}

///| Hide this argument from help, suggestions, and shell completions.
pub fn Arg::hide(self : Arg, h : Bool) -> Arg {
  Arg::{ ..self, hide_flag: h }
}

///| Allow a positional argument to capture multiple remaining values.
pub fn Arg::multiple(self : Arg, m : Bool) -> Arg {
  Arg::{ ..self, multiple_values: m }
}

///| Allow option values starting with `-` even if not numeric.
pub fn Arg::allow_hyphen_values(self : Arg, a : Bool) -> Arg {
  Arg::{ ..self, allow_hyphen_values_flag: a }
}

///| Split supplied values by delimiter character (e.g. `','`).
pub fn Arg::value_delimiter(self : Arg, c : Char) -> Arg {
  Arg::{ ..self, value_delimiter_char: Some(c) }
}

///| Restrict accepted values to an explicit allowlist.
pub fn Arg::possible_values(self : Arg, vals : Array[String]) -> Arg {
  Arg::{ ..self, possible_vals: vals }
}

///| Add a conflicting argument id (amortized O(1)).
pub fn Arg::conflicts_with(self : Arg, other_id : String) -> Arg {
  self.conflicts.push(other_id)
  self
}

///| Add multiple conflicting argument ids.
pub fn Arg::conflicts_with_all(self : Arg, ids : Array[String]) -> Arg {
  let mut j = 0
  while j < ids.length() {
    self.conflicts.push(ids[j])
    j = j + 1
  }
  self
}

///| Add a required dependency argument id (amortized O(1)).
pub fn Arg::requires(self : Arg, other_id : String) -> Arg {
  self.requires_ids.push(other_id)
  self
}

///| Add multiple required dependency argument ids.
pub fn Arg::requires_all(self : Arg, ids : Array[String]) -> Arg {
  let mut j = 0
  while j < ids.length() {
    self.requires_ids.push(ids[j])
    j = j + 1
  }
  self
}

///| Set explicit 1-based positional index.
pub fn Arg::index(self : Arg, idx : Int) -> Arg {
  Arg::{ ..self, index_opt: Some(idx) }
}

///| Return true if this `Arg` is a positional argument (no short/long/negative flag).
pub fn Arg::is_positional(self : Arg) -> Bool {
  match (self.short_name, self.long_name, self.negative_long) {
    (None, None, None) => true
    _ => false
  }
}

///| Declarative CLI command / subcommand specification.
pub struct Command {
  pub name : String
  pub version_str : Option[String]
  pub about_str : String
  pub long_about_str : Option[String]
  pub args_list : Array[Arg]
  pub subcommands_list : Array[Command]
  pub aliases_list : Array[String]
  pub subcommand_required_flag : Bool
  pub default_subcommand_name : Option[String]
  pub disable_help_flag : Bool
  pub disable_version_flag : Bool
  pub hide_flag : Bool
}

///| Create a new `Command`.
pub fn Command::new(name : String) -> Command {
  Command::{
    name: name,
    version_str: None,
    about_str: "",
    long_about_str: None,
    args_list: [],
    subcommands_list: [],
    aliases_list: [],
    subcommand_required_flag: false,
    default_subcommand_name: None,
    disable_help_flag: false,
    disable_version_flag: false,
    hide_flag: false,
  }
}

///| Set version string (enables built-in `-V`/`--version`).
pub fn Command::version(self : Command, v : String) -> Command {
  Command::{ ..self, version_str: Some(v) }
}

///| Set short command description.
pub fn Command::about(self : Command, a : String) -> Command {
  Command::{ ..self, about_str: a }
}

///| Set extended command description shown for `--help`.
pub fn Command::long_about(self : Command, a : String) -> Command {
  Command::{ ..self, long_about_str: Some(a) }
}

///| Add an `Arg` to this command (amortized O(1)).
pub fn Command::arg(self : Command, a : Arg) -> Command {
  self.args_list.push(a)
  self
}

///| Add multiple `Arg`s to this command.
pub fn Command::args(self : Command, list : Array[Arg]) -> Command {
  let mut j = 0
  while j < list.length() {
    self.args_list.push(list[j])
    j = j + 1
  }
  self
}

///| Add a child subcommand (amortized O(1)).
pub fn Command::subcommand(self : Command, sub : Command) -> Command {
  self.subcommands_list.push(sub)
  self
}

///| Add multiple child subcommands.
pub fn Command::subcommands(self : Command, list : Array[Command]) -> Command {
  let mut j = 0
  while j < list.length() {
    self.subcommands_list.push(list[j])
    j = j + 1
  }
  self
}

///| Add a subcommand alias (amortized O(1)).
pub fn Command::alias(self : Command, a : String) -> Command {
  self.aliases_list.push(a)
  self
}

///| Add multiple subcommand aliases.
pub fn Command::aliases(self : Command, list : Array[String]) -> Command {
  let mut j = 0
  while j < list.length() {
    self.aliases_list.push(list[j])
    j = j + 1
  }
  self
}

///| Require a subcommand to be selected.
pub fn Command::subcommand_required(self : Command, r : Bool) -> Command {
  Command::{ ..self, subcommand_required_flag: r }
}

///| Set default subcommand used when none is explicitly provided.
pub fn Command::default_subcommand(self : Command, name : String) -> Command {
  Command::{ ..self, default_subcommand_name: Some(name) }
}

///| Disable built-in `-h`/`--help` handling.
pub fn Command::disable_help(self : Command, d : Bool) -> Command {
  Command::{ ..self, disable_help_flag: d }
}

///| Disable built-in `-V`/`--version` handling.
pub fn Command::disable_version(self : Command, d : Bool) -> Command {
  Command::{ ..self, disable_version_flag: d }
}

///| Hide this command from parent help, suggestions, and completions.
pub fn Command::hide(self : Command, h : Bool) -> Command {
  Command::{ ..self, hide_flag: h }
}

///| Stored matched entry for a single argument id.
pub struct MatchedArg {
  pub id : String
  pub values : Array[String]
  pub count : Int
  pub source : ValueSource
}

///| Parsed match result for a command and its active subcommand chain.
pub struct ArgMatches {
  pub entries : Map[String, MatchedArg]
  pub sub_name : Option[String]
  pub sub_matches : Array[ArgMatches]
}

///| Create an empty `ArgMatches`.
pub fn ArgMatches::empty() -> ArgMatches {
  let m : Map[String, MatchedArg] = Map::new()
  ArgMatches::{ entries: m, sub_name: None, sub_matches: [] }
}

///| Return true if an argument id has a matched value or flag occurrence.
pub fn ArgMatches::contains_id(self : ArgMatches, id : String) -> Bool {
  match self.entries.get(id) {
    Some(_) => true
    None => false
  }
}

///| Return the origin (`CommandLine`, `EnvVariable`, `DefaultValue`) of a matched argument.
pub fn ArgMatches::value_source(self : ArgMatches, id : String) -> Option[ValueSource] {
  match self.entries.get(id) {
    Some(e) => Some(e.source)
    None => None
  }
}

///| Return the last string value for an argument id, if present.
pub fn ArgMatches::get_string(self : ArgMatches, id : String) -> Option[String] {
  match self.entries.get(id) {
    Some(e) =>
    if e.values.length() == 0 {
      None
    } else {
      Some(e.values[e.values.length() - 1])
    }
    None => None
  }
}

///| Return all string values for an argument id, if present.
pub fn ArgMatches::get_many(self : ArgMatches, id : String) -> Option[Array[String]] {
  match self.entries.get(id) {
    Some(e) => Some(e.values)
    None => None
  }
}

///| Return occurrence count for `ArgAction::Count` (0 if absent).
pub fn ArgMatches::get_count(self : ArgMatches, id : String) -> Int {
  match self.entries.get(id) {
    Some(e) => e.count
    None => 0
  }
}

///| Return boolean flag value (`false` if absent).
pub fn ArgMatches::get_flag(self : ArgMatches, id : String) -> Bool {
  match self.get_string(id) {
    Some(v) => v == "true" || v == "1" || v == "yes" || v == "on"
    None => false
  }
}

///| Return matched subcommand canonical name, if any.
pub fn ArgMatches::subcommand_name(self : ArgMatches) -> Option[String] {
  self.sub_name
}

///| Return matched subcommand `ArgMatches` if its canonical name equals `name`.
pub fn ArgMatches::subcommand_matches(self : ArgMatches, name : String) -> Option[ArgMatches] {
  match self.sub_name {
    Some(n) =>
    if n == name && self.sub_matches.length() > 0 {
      Some(self.sub_matches[0])
    } else {
      None
    }
    None => None
  }
}

///| Return `(name, sub_matches)` for the matched subcommand, if any.
pub fn ArgMatches::subcommand(self : ArgMatches) -> Option[(String, ArgMatches)] {
  match self.sub_name {
    Some(n) =>
    if self.sub_matches.length() > 0 {
      Some((n, self.sub_matches[0]))
    } else {
      None
    }
    None => None
  }
}

///| Precompiled command representation for fast O(1) flag lookup across repeated parses.
pub struct CompiledCommand {
  pub cmd : Command
  pub full_name : String
  pub all_args : Array[Arg]
  pub id_to_idx : Map[String, Int]
  pub long_to_idx : Map[String, Int]
  pub neg_to_idx : Map[String, Int]
  pub short_ascii : FixedArray[Int]
  pub short_unicode : Map[Int, Int]
  pub positionals : Array[Int]
  pub sub_index : Map[String, Int]
  pub compiled_subs : Array[CompiledCommand]
  pub global_indices : Array[Int]
  pub help_short_enabled : Bool
  pub help_long_enabled : Bool
  pub version_short_enabled : Bool
  pub version_long_enabled : Bool
}
