///| Damerau-Levenshtein (Optimal String Alignment) edit distance and typo suggestion.

///| Return minimum of two integers.
fn min2(a : Int, b : Int) -> Int {
  if a < b {
    a
  } else {
    b
  }
}

///| Return minimum of three integers.
fn min3(a : Int, b : Int, c : Int) -> Int {
  min2(min2(a, b), c)
}

///| Compute optimal string alignment (restricted Damerau-Levenshtein) distance.
///| Counts insertions, deletions, substitutions, and adjacent transpositions each as cost 1.
pub fn damerau_levenshtein(a : String, b : String) -> Int {
  let n = a.length()
  let m = b.length()
  if n == 0 {
    return m
  }
  if m == 0 {
    return n
  }
  if a == b {
    return 0
  }

  let cols = m + 1
  let mut prev2 : FixedArray[Int] = FixedArray::make(cols, 0)
  let mut prev1 : FixedArray[Int] = FixedArray::make(cols, 0)
  let mut curr : FixedArray[Int] = FixedArray::make(cols, 0)

  let mut j = 0
  while j <= m {
    prev1[j] = j
    j = j + 1
  }

  let mut i = 1
  while i <= n {
    curr[0] = i
    let ai = a.code_unit_at(i - 1)
    let mut jj = 1
    while jj <= m {
      let bj = b.code_unit_at(jj - 1)
      let cost = if ai == bj { 0 } else { 1 }
      let del_cost = prev1[jj] + 1
      let ins_cost = curr[jj - 1] + 1
      let sub_cost = prev1[jj - 1] + cost
      let mut best = min3(del_cost, ins_cost, sub_cost)
      if i > 1 && jj > 1 {
        let ai_prev = a.code_unit_at(i - 2)
        let bj_prev = b.code_unit_at(jj - 2)
        if ai == bj_prev && ai_prev == bj {
          let trans_cost = prev2[jj - 2] + 1
          if trans_cost < best {
            best = trans_cost
          }
        }
      }
      curr[jj] = best
      jj = jj + 1
    }
    // Rotate rows without allocating
    let tmp = prev2
    prev2 = prev1
    prev1 = curr
    curr = tmp
    i = i + 1
  }
  prev1[m]
}

///| Suggest the closest candidate string within `max_distance`, or `None`.
///| Uses O(1) length-difference pruning to avoid quadratic work on overlong inputs.
pub fn suggest_closest(
  input : String,
  candidates : Array[String],
  max_distance : Int,
) -> Option[String] {
  if max_distance < 0 || input.length() == 0 {
    return None
  }
  let in_len = input.length()
  let mut best_dist = max_distance + 1
  let mut best_cand : Option[String] = None
  let mut i = 0
  while i < candidates.length() {
    let cand = candidates[i]
    let c_len = cand.length()
    if c_len > 0 {
      let diff = if in_len >= c_len { in_len - c_len } else { c_len - in_len }
      if diff <= max_distance && diff < best_dist {
        let d = damerau_levenshtein(input, cand)
        if d < best_dist {
          best_dist = d
          best_cand = Some(cand)
          if d == 0 {
            return best_cand
          }
        }
      }
    }
    i = i + 1
  }
  best_cand
}
