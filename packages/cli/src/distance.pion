///| Damerau-Levenshtein (Optimal String Alignment) edit distance and typo suggestion.

///| Return minimum of two integers.
fn min2(a : Int, b : Int) -> Int {
  if a < b {
    a
  } else {
    b
  }
}

///| Return maximum of two integers.
fn max2(a : Int, b : Int) -> Int {
  if a > b {
    a
  } else {
    b
  }
}

///| Return minimum of three integers.
fn min3(a : Int, b : Int, c : Int) -> Int {
  min2(min2(a, b), c)
}

///| Compute optimal string alignment (restricted Damerau-Levenshtein) distance.
///| Counts insertions, deletions, substitutions, and adjacent transpositions each as cost 1.
pub fn damerau_levenshtein(a : String, b : String) -> Int {
  let n = a.length()
  let m = b.length()
  if n == 0 {
    return m
  }
  if m == 0 {
    return n
  }
  if a == b {
    return 0
  }

  let cols = m + 1
  let mut prev2 : FixedArray[Int] = FixedArray::make(cols, 0)
  let mut prev1 : FixedArray[Int] = FixedArray::make(cols, 0)
  let mut curr : FixedArray[Int] = FixedArray::make(cols, 0)

  let mut j = 0
  while j <= m {
    prev1[j] = j
    j = j + 1
  }

  let mut i = 1
  while i <= n {
    curr[0] = i
    let ai = a.code_unit_at(i - 1)
    let mut jj = 1
    while jj <= m {
      let bj = b.code_unit_at(jj - 1)
      let cost = if ai == bj { 0 } else { 1 }
      let del_cost = prev1[jj] + 1
      let ins_cost = curr[jj - 1] + 1
      let sub_cost = prev1[jj - 1] + cost
      let mut best = min3(del_cost, ins_cost, sub_cost)
      if i > 1 && jj > 1 {
        let ai_prev = a.code_unit_at(i - 2)
        let bj_prev = b.code_unit_at(jj - 2)
        if ai == bj_prev && ai_prev == bj {
          let trans_cost = prev2[jj - 2] + 1
          if trans_cost < best {
            best = trans_cost
          }
        }
      }
      curr[jj] = best
      jj = jj + 1
    }
    // Rotate rows without allocating
    let tmp = prev2
    prev2 = prev1
    prev1 = curr
    curr = tmp
    i = i + 1
  }
  prev1[m]
}

///| Banded optimal string alignment distance capped at `max_dist`.
///| Runs in O(min(n, m) * max_dist) time with early exit when row minimum exceeds `max_dist`.
fn damerau_levenshtein_bounded(a : String, b : String, max_dist : Int) -> Int {
  let inf = max_dist + 1
  if max_dist < 0 {
    return inf
  }
  let n = a.length()
  let m = b.length()
  let diff = if n >= m { n - m } else { m - n }
  if diff > max_dist {
    return inf
  }
  if n == 0 {
    return m
  }
  if m == 0 {
    return n
  }
  if a == b {
    return 0
  }

  let cols = m + 1
  let mut prev2 : FixedArray[Int] = FixedArray::make(cols, inf)
  let mut prev1 : FixedArray[Int] = FixedArray::make(cols, inf)
  let mut curr : FixedArray[Int] = FixedArray::make(cols, inf)

  let init_hi = min2(m, max_dist)
  let mut j = 0
  while j <= init_hi {
    prev1[j] = j
    j = j + 1
  }

  let mut i = 1
  while i <= n {
    let lo = max2(1, i - max_dist)
    let hi = min2(m, i + max_dist)
    if lo == 1 {
      curr[0] = i
    } else {
      curr[lo - 1] = inf
    }
    if hi < m {
      curr[hi + 1] = inf
    }
    let ai = a.code_unit_at(i - 1)
    let mut row_min = inf
    let mut jj = lo
    while jj <= hi {
      let bj = b.code_unit_at(jj - 1)
      let cost = if ai == bj { 0 } else { 1 }
      let del_cost = prev1[jj] + 1
      let ins_cost = curr[jj - 1] + 1
      let sub_cost = prev1[jj - 1] + cost
      let mut best = min3(del_cost, ins_cost, sub_cost)
      if i > 1 && jj > 1 {
        let ai_prev = a.code_unit_at(i - 2)
        let bj_prev = b.code_unit_at(jj - 2)
        if ai == bj_prev && ai_prev == bj {
          let trans_cost = prev2[jj - 2] + 1
          if trans_cost < best {
            best = trans_cost
          }
        }
      }
      if best > inf {
        best = inf
      }
      curr[jj] = best
      if best < row_min {
        row_min = best
      }
      jj = jj + 1
    }
    if row_min > max_dist {
      return inf
    }
    let tmp = prev2
    prev2 = prev1
    prev1 = curr
    curr = tmp
    i = i + 1
  }
  prev1[m]
}

///| Suggest the closest candidate string within `max_distance`, or `None`.
///| Uses O(1) length-difference pruning and banded DP to avoid quadratic work on long names.
///| Never suggests `input` itself and filters noisy matches on very short tokens.
pub fn suggest_closest(
  input : String,
  candidates : Array[String],
  max_distance : Int,
) -> Option[String] {
  if max_distance < 0 || input.length() == 0 {
    return None
  }
  let in_len = input.length()
  let mut best_dist = max_distance + 1
  let mut best_cand : Option[String] = None
  let mut i = 0
  while i < candidates.length() {
    let cand = candidates[i]
    let c_len = cand.length()
    if c_len > 0 && cand != input {
      let diff = if in_len >= c_len { in_len - c_len } else { c_len - in_len }
      if diff <= max_distance && diff < best_dist {
        let d = damerau_levenshtein_bounded(input, cand, best_dist - 1)
        let max_len = max2(in_len, c_len)
        // Guard against noisy suggestions for very short names (e.g. `zz` -> `a`)
        let acceptable = d < best_dist &&
        d * 2 <= max_len &&
        !(in_len <= 2 && c_len == 1)
        if acceptable {
          best_dist = d
          best_cand = Some(cand)
          if d == 1 {
            // Cannot beat 1 since cand != input
            ()
          }
        }
      }
    }
    i = i + 1
  }
  best_cand
}
