///| Damerau-Levenshtein edit distance and typo suggestion helpers (stub for Red phase).

///| Compute optimal string alignment (Damerau-Levenshtein) distance between two strings.
pub fn damerau_levenshtein(a : String, b : String) -> Int {
  let _ = a
  let _ = b
  -1
}

///| Suggest the closest candidate string within `max_distance`, or `None`.
pub fn suggest_closest(
  input : String,
  candidates : Array[String],
  max_distance : Int,
) -> Option[String] {
  let _ = input
  let _ = candidates
  let _ = max_distance
  None
}
