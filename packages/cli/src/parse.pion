///| POSIX/GNU CLI validator, precompiler, O(N) linear parser, and typed value getters.

///| Return true if `s` looks like a negative numeric literal (e.g. `-5`, `-10`, `-3.14`, `-.5`, `-1e5`).
fn is_negative_number(s : String) -> Bool {
  let len = s.length()
  if len < 2 || s.code_unit_at(0) != 45 {
    return false
  }
  let c1 = s.code_unit_at(1)
  if !((c1 >= 48 && c1 <= 57) || c1 == 46) {
    return false
  }
  let mut i = 1
  let mut has_digit = false
  let mut has_dot = false
  let mut has_exp = false
  while i < len {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      has_digit = true
    } else if c == 46 && !has_dot && !has_exp {
      has_dot = true
    } else if (c == 101 || c == 69) && has_digit && !has_exp {
      has_exp = true
      has_digit = false
      if i + 1 < len {
        let nxt = s.code_unit_at(i + 1)
        if nxt == 43 || nxt == 45 {
          i = i + 1
        }
      }
    } else {
      return false
    }
    i = i + 1
  }
  has_digit
}

///| Find index of first ASCII `=` in `s` starting at `start`, or -1.
fn find_eq(s : String, start : Int) -> Int {
  let len = s.length()
  let mut i = start
  while i < len {
    if s.code_unit_at(i) == 61 {
      return i
    }
    i = i + 1
  }
  -1
}

///| Split `s` by single ASCII/char delimiter into `out`.
fn split_into(s : String, delim : Char, out : Array[String]) -> Unit {
  let d = delim.to_int()
  let len = s.length()
  let mut start = 0
  let mut i = 0
  while i < len {
    if s.code_unit_at(i) == d {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(start, len))
}

///| Check whether `s` is in `allowed` array.
fn in_string_list(s : String, allowed : Array[String]) -> Bool {
  let mut i = 0
  while i < allowed.length() {
    if allowed[i] == s {
      return true
    }
    i = i + 1
  }
  false
}

///| Parse boolean string (strict `true`/`false` for env flags, matching clap).
fn parse_bool_strict(s : String) -> Option[Bool] {
  if s == "true" {
    Some(true)
  } else if s == "false" {
    Some(false)
  } else {
    None
  }
}

///| Parse boolean string (case-insensitive true/false/1/0/yes/no/on/off) for `get_bool`.
fn parse_bool_str(s : String) -> Option[Bool] {
  if s == "true" || s == "TRUE" || s == "True" || s == "1" || s == "yes" || s == "YES" || s == "on" || s == "ON" {
    Some(true)
  } else if s == "false" || s == "FALSE" || s == "False" || s == "0" || s == "no" || s == "NO" || s == "off" || s == "OFF" {
    Some(false)
  } else {
    None
  }
}

///| Decode a single UTF-8 codepoint at byte offset `pos` in `s`, returning `(codepoint, byte_len)`.
fn decode_utf8_at(s : String, pos : Int) -> (Int, Int) {
  let len = s.length()
  let b0 = s.code_unit_at(pos)
  if b0 < 0x80 {
    return (b0, 1)
  }
  if (b0 & 0xE0) == 0xC0 && pos + 1 < len {
    let b1 = s.code_unit_at(pos + 1)
    if (b1 & 0xC0) == 0x80 {
      return (((b0 & 0x1F) << 6) | (b1 & 0x3F), 2)
    }
  }
  if (b0 & 0xF0) == 0xE0 && pos + 2 < len {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      return (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), 3)
    }
  }
  if (b0 & 0xF8) == 0xF0 && pos + 3 < len {
    let b1 = s.code_unit_at(pos + 1)
    let b2 = s.code_unit_at(pos + 2)
    let b3 = s.code_unit_at(pos + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      return (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F), 4)
    }
  }
  (b0, 1)
}

///| ASCII case-insensitive equality against a lowercase literal.
fn eq_ascii_lower(s : String, lower_target : String) -> Bool {
  let len = s.length()
  if len != lower_target.length() {
    return false
  }
  let mut i = 0
  while i < len {
    let mut c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      c = c + 32
    }
    if c != lower_target.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

///| Parse signed 64-bit integer with exact overflow checking.
fn parse_int64_str(s : String) -> Option[Int64] {
  let len = s.length()
  if len == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  let first = s.code_unit_at(0)
  if first == 45 {
    neg = true
    i = 1
  } else if first == 43 {
    i = 1
  }
  if i >= len {
    return None
  }
  // Accumulate as negative Int64 so Int64::MIN (-9223372036854775808) is handled cleanly.
  let min_div10 : Int64 = -922337203685477580L
  let min_rem : Int64 = -8L
  let max_neg_rem : Int64 = -7L
  let mut acc : Int64 = 0L
  while i < len {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    let digit = (c - 48).to_int64()
    if acc < min_div10 {
      return None
    }
    if acc == min_div10 {
      let limit = if neg { min_rem } else { max_neg_rem }
      if -digit < limit {
        return None
      }
    }
    acc = acc * 10L - digit
    i = i + 1
  }
  if neg {
    Some(acc)
  } else {
    Some(-acc)
  }
}

///| Parse signed 32-bit integer with exact overflow checking.
fn parse_int_str(s : String) -> Option[Int] {
  match parse_int64_str(s) {
    Some(v) =>
    if v >= -2147483648L && v <= 2147483647L {
      Some(v.to_int())
    } else {
      None
    }
    None => None
  }
}

///| Parse floating-point number into `Double` with exact IEEE-754 round-to-nearest-even semantics.
///| Matches Rust `f64::from_str` (strict decimal syntax + case-insensitive inf/infinity/nan, no whitespace/hex).
fn parse_double_str(s : String) -> Option[Double] {
  let len = s.length()
  if len == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  let first = s.code_unit_at(0)
  if first == 45 {
    neg = true
    i = 1
  } else if first == 43 {
    i = 1
  }
  if i >= len {
    return None
  }

  // Handle special IEEE-754 words (inf, infinity, nan) identically across Native and Wasm32
  let body = s.slice(i, len)
  if eq_ascii_lower(body, "inf") || eq_ascii_lower(body, "infinity") {
    let bits : UInt64 = if neg { 0xfff0000000000000UL } else { 0x7ff0000000000000UL }
    return Some(bits.reinterpret_as_double())
  }
  if eq_ascii_lower(body, "nan") {
    let bits : UInt64 = 0x7ff8000000000000UL
    return Some(bits.reinterpret_as_double())
  }

  // Strictly validate decimal syntax before delegating to exact IEEE-754 `String::to_double()`
  let mut has_digits = false
  while i < len {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      has_digits = true
      i = i + 1
    } else {
      break
    }
  }
  if i < len && s.code_unit_at(i) == 46 {
    i = i + 1
    while i < len {
      let c = s.code_unit_at(i)
      if c >= 48 && c <= 57 {
        has_digits = true
        i = i + 1
      } else {
        break
      }
    }
  }
  if !has_digits {
    return None
  }
  if i < len && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    i = i + 1
    if i < len {
      let ec = s.code_unit_at(i)
      if ec == 45 || ec == 43 {
        i = i + 1
      }
    }
    if i >= len {
      return None
    }
    while i < len {
      let c = s.code_unit_at(i)
      if c < 48 || c > 57 {
        return None
      }
      i = i + 1
    }
  }
  if i != len {
    return None
  }
  s.to_double()
}

///| Detect cycles in `requires_ids` graph using 3-color DFS (0=unvisited, 1=visiting, 2=done).
fn check_requires_cycles(
  all_args : Array[Arg],
  id_to_idx : Map[String, Int],
) -> Result[Unit, CliError] {
  let n = all_args.length()
  let color : FixedArray[Int] = FixedArray::make(n, 0)

  let mut start = 0
  while start < n {
    if color[start] == 0 {
      // Iterative DFS stack: (node_idx, next_edge_idx)
      let stack_node : Array[Int] = [start]
      let stack_edge : Array[Int] = [0]
      color[start] = 1
      while stack_node.length() > 0 {
        let top = stack_node.length() - 1
        let u = stack_node[top]
        let e = stack_edge[top]
        let reqs = all_args[u].requires_ids
        if e < reqs.length() {
          stack_edge[top] = e + 1
          let target_id = reqs[e]
          match id_to_idx.get(target_id) {
            Some(v) =>
            if color[v] == 1 {
              return Err(
                CliError::InvalidDefinition(
                  "cyclic requires dependency involving '" + all_args[u].id + "' and '" + target_id + "'",
                ),
              )
            } else if color[v] == 0 {
              color[v] = 1
              stack_node.push(v)
              stack_edge.push(0)
            }
            None => ()
          }
        } else {
          color[u] = 2
          let _ = stack_node.pop()
          let _ = stack_edge.pop()
        }
      }
    }
    start = start + 1
  }
  Ok(())
}

///| Compile a `Command` recursively with inherited global args, full command path, and depth limit.
fn compile_inner(
  cmd : Command,
  full_name : String,
  inherited_globals : Array[Arg],
  depth : Int,
) -> Result[CompiledCommand, CliError] {
  if depth > MAX_SUBCOMMAND_DEPTH {
    return Err(
      CliError::InvalidDefinition(
        "subcommand nesting depth exceeds limit of " + MAX_SUBCOMMAND_DEPTH.to_string(),
      ),
    )
  }
  if cmd.name.length() == 0 {
    return Err(CliError::InvalidDefinition("command name must not be empty"))
  }

  let all_args : Array[Arg] = []
  let id_to_idx : Map[String, Int] = Map::new()
  let long_to_idx : Map[String, Int] = Map::new()
  let neg_to_idx : Map[String, Int] = Map::new()
  let short_ascii : FixedArray[Int] = FixedArray::make(128, -1)
  let short_unicode : Map[Int, Int] = Map::new()
  let positionals : Array[Int] = []
  let global_indices : Array[Int] = []

  // First add this command's own args (strict duplicate checks)
  let mut i = 0
  while i < cmd.args_list.length() {
    let a = cmd.args_list[i]
    if a.id.length() == 0 {
      return Err(CliError::InvalidDefinition("argument id must not be empty"))
    }
    match id_to_idx.get(a.id) {
      Some(_) =>
      return Err(CliError::InvalidDefinition("duplicate argument id '" + a.id + "'"))
      None => ()
    }
    let idx = all_args.length()
    all_args.push(a)
    id_to_idx.set(a.id, idx)
    if a.global_flag {
      global_indices.push(idx)
    }

    if a.is_positional() {
      positionals.push(idx)
    } else {
      match a.short_name {
        Some(ch) => {
          let code = ch.to_int()
          if code >= 0 && code < 128 {
            if short_ascii[code] != -1 {
              return Err(
                CliError::InvalidDefinition("duplicate short flag '-" + ch.to_string() + "'"),
              )
            }
            short_ascii[code] = idx
          } else {
            match short_unicode.get(code) {
              Some(_) =>
              return Err(
                CliError::InvalidDefinition("duplicate short flag '-" + ch.to_string() + "'"),
              )
              None => short_unicode.set(code, idx)
            }
          }
        }
        None => ()
      }
      match a.long_name {
        Some(ln) => {
          if ln.length() == 0 {
            return Err(CliError::InvalidDefinition("long flag name must not be empty"))
          }
          match long_to_idx.get(ln) {
            Some(_) =>
            return Err(CliError::InvalidDefinition("duplicate long flag '--" + ln + "'"))
            None => ()
          }
          match neg_to_idx.get(ln) {
            Some(_) =>
            return Err(
              CliError::InvalidDefinition("long flag '--" + ln + "' collides with negative flag"),
            )
            None => ()
          }
          long_to_idx.set(ln, idx)
        }
        None => ()
      }
      match a.negative_long {
        Some(nl) => {
          if nl.length() == 0 {
            return Err(CliError::InvalidDefinition("negative long flag name must not be empty"))
          }
          match long_to_idx.get(nl) {
            Some(_) =>
            return Err(
              CliError::InvalidDefinition("negative flag '--" + nl + "' collides with long flag"),
            )
            None => ()
          }
          match neg_to_idx.get(nl) {
            Some(_) =>
            return Err(
              CliError::InvalidDefinition("duplicate negative flag '--" + nl + "'"),
            )
            None => ()
          }
          neg_to_idx.set(nl, idx)
        }
        None => ()
      }
    }
    i = i + 1
  }

  // Merge inherited global args if not shadowed by local arg id
  let mut gi = 0
  while gi < inherited_globals.length() {
    let g = inherited_globals[gi]
    match id_to_idx.get(g.id) {
      Some(_) => ()
      None => {
        let idx = all_args.length()
        all_args.push(g)
        id_to_idx.set(g.id, idx)
        global_indices.push(idx)
        match g.short_name {
          Some(ch) => {
            let code = ch.to_int()
            if code >= 0 && code < 128 {
              if short_ascii[code] == -1 {
                short_ascii[code] = idx
              }
            } else {
              match short_unicode.get(code) {
                None => short_unicode.set(code, idx)
                Some(_) => ()
              }
            }
          }
          None => ()
        }
        match g.long_name {
          Some(ln) =>
          match long_to_idx.get(ln) {
            None => long_to_idx.set(ln, idx)
            Some(_) => ()
          }
          None => ()
        }
        match g.negative_long {
          Some(nl) =>
          match neg_to_idx.get(nl) {
            None => neg_to_idx.set(nl, idx)
            Some(_) => ()
          }
          None => ()
        }
      }
    }
    gi = gi + 1
  }

  // Validate variadic positional only at the end
  let mut pi = 0
  while pi < positionals.length() {
    if all_args[positionals[pi]].multiple_values && pi + 1 < positionals.length() {
      return Err(
        CliError::InvalidDefinition(
          "multiple-value positional '" + all_args[positionals[pi]].id + "' must be the last positional argument",
        ),
      )
    }
    pi = pi + 1
  }

  // Reject self-conflict at definition time
  let mut sc = 0
  while sc < all_args.length() {
    let a = all_args[sc]
    let mut ci = 0
    while ci < a.conflicts.length() {
      if a.conflicts[ci] == a.id {
        return Err(
          CliError::InvalidDefinition("argument '" + a.id + "' cannot conflict with itself"),
        )
      }
      ci = ci + 1
    }
    sc = sc + 1
  }

  // Detect cyclic requires dependencies
  match check_requires_cycles(all_args, id_to_idx) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }

  // Build next globals list for child subcommands
  let next_globals : Array[Arg] = []
  let mut ng = 0
  while ng < global_indices.length() {
    next_globals.push(all_args[global_indices[ng]])
    ng = ng + 1
  }

  // Compile subcommands and index names + aliases
  let sub_index : Map[String, Int] = Map::new()
  let compiled_subs : Array[CompiledCommand] = []
  let mut si = 0
  while si < cmd.subcommands_list.length() {
    let sub = cmd.subcommands_list[si]
    match sub_index.get(sub.name) {
      Some(_) =>
      return Err(CliError::InvalidDefinition("duplicate subcommand name '" + sub.name + "'"))
      None => sub_index.set(sub.name, si)
    }
    let mut ai = 0
    while ai < sub.aliases_list.length() {
      let al = sub.aliases_list[ai]
      match sub_index.get(al) {
        Some(_) =>
        return Err(CliError::InvalidDefinition("duplicate subcommand alias '" + al + "'"))
        None => sub_index.set(al, si)
      }
      ai = ai + 1
    }
    match compile_inner(sub, full_name + " " + sub.name, next_globals, depth + 1) {
      Ok(cs) => compiled_subs.push(cs)
      Err(e) => return Err(e)
    }
    si = si + 1
  }

  // Validate default_subcommand if configured
  match cmd.default_subcommand_name {
    Some(ds) =>
    match sub_index.get(ds) {
      Some(_) => ()
      None =>
      return Err(
        CliError::InvalidDefinition("default_subcommand '" + ds + "' does not exist"),
      )
    }
    None => ()
  }

  let help_short_enabled = !cmd.disable_help_flag && short_ascii[104] == -1
  let help_long_enabled = !cmd.disable_help_flag &&
  long_to_idx.get("help") is None &&
  neg_to_idx.get("help") is None
  let has_ver = cmd.version_str is Some(_)
  let version_short_enabled = !cmd.disable_version_flag && has_ver && short_ascii[86] == -1
  let version_long_enabled = !cmd.disable_version_flag &&
  has_ver &&
  long_to_idx.get("version") is None &&
  neg_to_idx.get("version") is None

  Ok(
    CompiledCommand::{
      cmd: cmd,
      full_name: full_name,
      all_args: all_args,
      id_to_idx: id_to_idx,
      long_to_idx: long_to_idx,
      neg_to_idx: neg_to_idx,
      short_ascii: short_ascii,
      short_unicode: short_unicode,
      positionals: positionals,
      sub_index: sub_index,
      compiled_subs: compiled_subs,
      global_indices: global_indices,
      help_short_enabled: help_short_enabled,
      help_long_enabled: help_long_enabled,
      version_short_enabled: version_short_enabled,
      version_long_enabled: version_long_enabled,
    },
  )
}

///| Validate a `Command` definition tree (duplicates, cycles, depth limits).
pub fn Command::validate(self : Command) -> Result[Unit, CliError] {
  match compile_inner(self, self.name, [], 0) {
    Ok(_) => Ok(())
    Err(e) => Err(e)
  }
}

///| Precompile a `Command` into O(1) lookup tables for repeated parsing.
pub fn Command::compile(self : Command) -> Result[CompiledCommand, CliError] {
  compile_inner(self, self.name, [], 0)
}

///| Lookup short flag index by code unit.
fn lookup_short(cc : CompiledCommand, code : Int) -> Int {
  if code >= 0 && code < 128 {
    cc.short_ascii[code]
  } else {
    match cc.short_unicode.get(code) {
      Some(idx) => idx
      None => -1
    }
  }
}

///| Collect visible long flag candidates for typo suggestion.
fn visible_long_candidates(cc : CompiledCommand) -> Array[String] {
  let cands : Array[String] = []
  let mut i = 0
  while i < cc.all_args.length() {
    let a = cc.all_args[i]
    if !a.hide_flag {
      match a.long_name {
        Some(ln) => cands.push("--" + ln)
        None => ()
      }
      match a.negative_long {
        Some(nl) => cands.push("--" + nl)
        None => ()
      }
    }
    i = i + 1
  }
  if cc.help_long_enabled {
    cands.push("--help")
  }
  if cc.version_long_enabled {
    cands.push("--version")
  }
  cands
}

///| Collect visible subcommand candidates for typo suggestion.
fn visible_subcommand_candidates(cc : CompiledCommand) -> Array[String] {
  let cands : Array[String] = []
  let mut i = 0
  while i < cc.cmd.subcommands_list.length() {
    let sub = cc.cmd.subcommands_list[i]
    if !sub.hide_flag {
      cands.push(sub.name)
    }
    i = i + 1
  }
  cands
}

///| Record a value for argument `idx` into the flat parse state arrays.
fn record_arg_value(
  a : Arg,
  idx : Int,
  raw_val : String,
  src_code : Int,
  seen_source : FixedArray[Int],
  single_vals : FixedArray[String],
  multi_vals : FixedArray[Array[String]],
  counts : FixedArray[Int],
) -> Unit {
  seen_source[idx] = src_code
  match a.action {
    ArgAction::Append => {
      let arr = multi_vals[idx]
      match a.value_delimiter_char {
        Some(delim) => split_into(raw_val, delim, arr)
        None => arr.push(raw_val)
      }
      counts[idx] = arr.length()
    }
    ArgAction::Set => {
      if a.multiple_values {
        let arr = multi_vals[idx]
        match a.value_delimiter_char {
          Some(delim) => split_into(raw_val, delim, arr)
          None => arr.push(raw_val)
        }
        counts[idx] = arr.length()
      } else {
        single_vals[idx] = raw_val
        counts[idx] = 1
      }
    }
    _ => {
      single_vals[idx] = raw_val
      counts[idx] = counts[idx] + 1
    }
  }
}

///| Check whether `next_tok` may be consumed as a separate value token for option `a`.
fn can_consume_value_token(a : Arg, next_tok : String) -> Bool {
  if a.allow_hyphen_values_flag {
    return true
  }
  if next_tok.length() >= 2 && next_tok.code_unit_at(0) == 45 {
    if is_negative_number(next_tok) {
      return true
    }
    let rest = next_tok.slice(1, next_tok.length())
    return eq_ascii_lower(rest, "inf") || eq_ascii_lower(rest, "infinity")
  }
  true
}

///| Core recursive parser on a `CompiledCommand` from `args[start..]`.
fn parse_compiled_slice(
  cc : CompiledCommand,
  args : Array[String],
  start : Int,
  env : Map[String, String],
  parent_globals : Map[String, MatchedArg],
) -> Result[ArgMatches, CliError] {
  let n_args = cc.all_args.length()
  let seen_source : FixedArray[Int] = FixedArray::make(n_args, 0)
  let counts : FixedArray[Int] = FixedArray::make(n_args, 0)
  let single_vals : FixedArray[String] = FixedArray::make(n_args, "")
  let multi_vals : FixedArray[Array[String]] = FixedArray::make(n_args, [])

  // Pre-allocate distinct arrays only for Append or variadic positional args
  let mut init_i = 0
  while init_i < n_args {
    let a = cc.all_args[init_i]
    if arg_action_eq(a.action, ArgAction::Append) || a.multiple_values {
      multi_vals[init_i] = []
    }
    init_i = init_i + 1
  }

  // Seed inherited global values from parent command
  let mut gi = 0
  while gi < cc.global_indices.length() {
    let idx = cc.global_indices[gi]
    let g = cc.all_args[idx]
    match parent_globals.get(g.id) {
      Some(pm) => {
        seen_source[idx] = match pm.source {
          ValueSource::CommandLine => 1
          ValueSource::EnvVariable => 2
          ValueSource::DefaultValue => 3
        }
        counts[idx] = pm.count
        if arg_action_eq(g.action, ArgAction::Append) || g.multiple_values {
          let arr = multi_vals[idx]
          let mut k = 0
          while k < pm.values.length() {
            arr.push(pm.values[k])
            k = k + 1
          }
        } else if pm.values.length() > 0 {
          single_vals[idx] = pm.values[pm.values.length() - 1]
        }
      }
      None => ()
    }
    gi = gi + 1
  }

  let mut after_double_dash = false
  let mut pos_cursor = 0
  let mut matched_sub_idx = -1
  let mut sub_start = args.length()

  let mut i = start
  while i < args.length() {
    let tok = args[i]
    let tlen = tok.length()

    if after_double_dash {
      // Pure positional mode
      if pos_cursor < cc.positionals.length() {
        let p_idx = cc.positionals[pos_cursor]
        let pa = cc.all_args[p_idx]
        record_arg_value(pa, p_idx, tok, 1, seen_source, single_vals, multi_vals, counts)
        if !pa.multiple_values {
          pos_cursor = pos_cursor + 1
        }
      } else {
        return Err(CliError::UnexpectedArgument(tok))
      }
      i = i + 1
      continue
    }

    if tlen == 2 && tok.code_unit_at(0) == 45 && tok.code_unit_at(1) == 45 {
      // `--` terminator
      after_double_dash = true
      i = i + 1
      continue
    }

    if tlen > 2 && tok.code_unit_at(0) == 45 && tok.code_unit_at(1) == 45 {
      // Long flag: `--name` or `--name=value`
      let eq_pos = find_eq(tok, 2)
      let has_eq = eq_pos != -1
      let flag_name = if has_eq { tok.slice(2, eq_pos) } else { tok.slice(2, tlen) }

      if flag_name == "help" && cc.help_long_enabled {
        if has_eq {
          return Err(
            CliError::InvalidValue("help", tok.slice(eq_pos + 1, tlen), "unexpected value for '--help'"),
          )
        }
        return Err(
          CliError::DisplayHelp(render_help_with_context(cc.cmd, cc.full_name, cc.all_args, true)),
        )
      }
      if flag_name == "version" && cc.version_long_enabled {
        if has_eq {
          return Err(
            CliError::InvalidValue(
              "version",
              tok.slice(eq_pos + 1, tlen),
              "unexpected value for '--version'",
            ),
          )
        }
        return Err(CliError::DisplayVersion(cc.cmd.render_version()))
      }

      match cc.long_to_idx.get(flag_name) {
        Some(idx) => {
          let a = cc.all_args[idx]
          match a.action {
            ArgAction::Help => {
              if has_eq {
                return Err(
                  CliError::InvalidValue(a.id, tok.slice(eq_pos + 1, tlen), "unexpected value for flag"),
                )
              }
              return Err(
                CliError::DisplayHelp(
                  render_help_with_context(cc.cmd, cc.full_name, cc.all_args, true),
                ),
              )
            }
            ArgAction::Version => {
              if has_eq {
                return Err(
                  CliError::InvalidValue(a.id, tok.slice(eq_pos + 1, tlen), "unexpected value for flag"),
                )
              }
              return Err(CliError::DisplayVersion(cc.cmd.render_version()))
            }
            ArgAction::SetTrue => {
              if has_eq {
                return Err(
                  CliError::InvalidValue(a.id, tok.slice(eq_pos + 1, tlen), "unexpected value for flag"),
                )
              }
              seen_source[idx] = 1
              single_vals[idx] = "true"
              counts[idx] = counts[idx] + 1
            }
            ArgAction::SetFalse => {
              if has_eq {
                return Err(
                  CliError::InvalidValue(a.id, tok.slice(eq_pos + 1, tlen), "unexpected value for flag"),
                )
              }
              seen_source[idx] = 1
              single_vals[idx] = "false"
              counts[idx] = counts[idx] + 1
            }
            ArgAction::Count => {
              if has_eq {
                return Err(
                  CliError::InvalidValue(a.id, tok.slice(eq_pos + 1, tlen), "unexpected value for flag"),
                )
              }
              seen_source[idx] = 1
              counts[idx] = counts[idx] + 1
              single_vals[idx] = counts[idx].to_string()
            }
            ArgAction::Set | ArgAction::Append => {
              let v = if has_eq {
                tok.slice(eq_pos + 1, tlen)
              } else {
                if i + 1 >= args.length() || !can_consume_value_token(a, args[i + 1]) {
                  return Err(CliError::MissingValue("--" + flag_name))
                }
                i = i + 1
                args[i]
              }
              record_arg_value(a, idx, v, 1, seen_source, single_vals, multi_vals, counts)
            }
          }
        }
        None =>
        match cc.neg_to_idx.get(flag_name) {
          Some(idx) => {
            if has_eq {
              return Err(
                CliError::InvalidValue(
                  cc.all_args[idx].id,
                  tok.slice(eq_pos + 1, tlen),
                  "unexpected value for flag",
                ),
              )
            }
            seen_source[idx] = 1
            single_vals[idx] = "false"
            counts[idx] = counts[idx] + 1
          }
          None => {
            let full = "--" + flag_name
            let nlen = flag_name.length()
            let max_d = if nlen <= 2 { 1 } else if nlen <= 5 { 2 } else { 3 }
            let sug = suggest_closest(full, visible_long_candidates(cc), max_d)
            return Err(CliError::UnknownArgument(full, sug))
          }
        }
      }
      i = i + 1
      continue
    }

    if tlen >= 2 && tok.code_unit_at(0) == 45 {
      // Short flag(s) or negative number positional
      let (first_ch, _) = decode_utf8_at(tok, 1)
      if is_negative_number(tok) && lookup_short(cc, first_ch) == -1 {
        // Treat as positional argument (e.g. -42, -3.14)
        if pos_cursor < cc.positionals.length() {
          let p_idx = cc.positionals[pos_cursor]
          let pa = cc.all_args[p_idx]
          record_arg_value(pa, p_idx, tok, 1, seen_source, single_vals, multi_vals, counts)
          if !pa.multiple_values {
            pos_cursor = pos_cursor + 1
          }
          i = i + 1
          continue
        } else {
          return Err(CliError::UnexpectedArgument(tok))
        }
      }

      // Parse short flag cluster (UTF-8 codepoint aware)
      let mut j = 1
      while j < tlen {
        let (ch_code, ch_len) = decode_utf8_at(tok, j)
        let ch_str = tok.slice(j, j + ch_len)
        if ch_code == 104 && cc.help_short_enabled {
          return Err(
            CliError::DisplayHelp(render_help_with_context(cc.cmd, cc.full_name, cc.all_args, false)),
          )
        }
        if ch_code == 86 && cc.version_short_enabled {
          return Err(CliError::DisplayVersion(cc.cmd.render_version()))
        }
        let idx = lookup_short(cc, ch_code)
        if idx == -1 {
          return Err(CliError::UnknownArgument("-" + ch_str, None))
        }
        let a = cc.all_args[idx]
        match a.action {
          ArgAction::Help =>
          return Err(
            CliError::DisplayHelp(render_help_with_context(cc.cmd, cc.full_name, cc.all_args, false)),
          )
          ArgAction::Version => return Err(CliError::DisplayVersion(cc.cmd.render_version()))
          ArgAction::SetTrue => {
            seen_source[idx] = 1
            single_vals[idx] = "true"
            counts[idx] = counts[idx] + 1
            j = j + ch_len
          }
          ArgAction::SetFalse => {
            seen_source[idx] = 1
            single_vals[idx] = "false"
            counts[idx] = counts[idx] + 1
            j = j + ch_len
          }
          ArgAction::Count => {
            seen_source[idx] = 1
            counts[idx] = counts[idx] + 1
            single_vals[idx] = counts[idx].to_string()
            j = j + ch_len
          }
          ArgAction::Set | ArgAction::Append => {
            let v = if j + ch_len < tlen {
              if tok.code_unit_at(j + ch_len) == 61 {
                tok.slice(j + ch_len + 1, tlen)
              } else {
                tok.slice(j + ch_len, tlen)
              }
            } else {
              if i + 1 >= args.length() || !can_consume_value_token(a, args[i + 1]) {
                return Err(CliError::MissingValue("-" + ch_str))
              }
              i = i + 1
              args[i]
            }
            record_arg_value(a, idx, v, 1, seen_source, single_vals, multi_vals, counts)
            // Rest of cluster was consumed as value
            break
          }
        }
      }
      i = i + 1
      continue
    }

    // Built-in `help` subcommand when command has subcommands and help is not disabled/overridden
    if cc.compiled_subs.length() > 0 &&
    !cc.cmd.disable_help_flag &&
    tok == "help" &&
    cc.sub_index.get("help") is None {
      let mut target_cc = cc
      let mut hk = i + 1
      while hk < args.length() {
        let sub_tok = args[hk]
        match target_cc.sub_index.get(sub_tok) {
          Some(s_idx) => {
            target_cc = target_cc.compiled_subs[s_idx]
            hk = hk + 1
          }
          None => {
            let max_d = if sub_tok.length() <= 2 { 1 } else if sub_tok.length() <= 5 { 2 } else { 3 }
            let sug = suggest_closest(sub_tok, visible_subcommand_candidates(target_cc), max_d)
            return Err(CliError::UnknownSubcommand(sub_tok, sug))
          }
        }
      }
      return Err(
        CliError::DisplayHelp(
          render_help_with_context(target_cc.cmd, target_cc.full_name, target_cc.all_args, true),
        ),
      )
    }

    // Non-flag token (or single `-`): check subcommand first if applicable
    if cc.compiled_subs.length() > 0 && pos_cursor >= cc.positionals.length() {
      match cc.sub_index.get(tok) {
        Some(s_idx) => {
          matched_sub_idx = s_idx
          sub_start = i + 1
          break
        }
        None => {
          let max_d = if tok.length() <= 2 { 1 } else if tok.length() <= 5 { 2 } else { 3 }
          let sug = suggest_closest(tok, visible_subcommand_candidates(cc), max_d)
          return Err(CliError::UnknownSubcommand(tok, sug))
        }
      }
    }

    // Also allow matching subcommand before optional positionals if exact match
    if cc.compiled_subs.length() > 0 {
      match cc.sub_index.get(tok) {
        Some(s_idx) => {
          matched_sub_idx = s_idx
          sub_start = i + 1
          break
        }
        None => ()
      }
    }

    if pos_cursor < cc.positionals.length() {
      let p_idx = cc.positionals[pos_cursor]
      let pa = cc.all_args[p_idx]
      record_arg_value(pa, p_idx, tok, 1, seen_source, single_vals, multi_vals, counts)
      if !pa.multiple_values {
        pos_cursor = pos_cursor + 1
      }
      i = i + 1
      continue
    }

    return Err(CliError::UnexpectedArgument(tok))
  }

  // Handle default_subcommand / subcommand_required
  if matched_sub_idx == -1 {
    match cc.cmd.default_subcommand_name {
      Some(ds) =>
      match cc.sub_index.get(ds) {
        Some(s_idx) => {
          matched_sub_idx = s_idx
          sub_start = args.length()
        }
        None => ()
      }
      None =>
      if cc.cmd.subcommand_required_flag {
        return Err(CliError::MissingRequired("subcommand"))
      }
    }
  }

  // Apply env & default fallbacks (priority: CLI > env > default)
  let mut ei = 0
  while ei < n_args {
    let a = cc.all_args[ei]
    if seen_source[ei] == 0 {
      let mut applied_env = false
      match a.env_name {
        Some(en) =>
        match env.get(en) {
          Some(ev) => {
            applied_env = true
            match a.action {
              ArgAction::SetTrue =>
              match parse_bool_strict(ev) {
                Some(b) => {
                  seen_source[ei] = 2
                  single_vals[ei] = if b { "true" } else { "false" }
                  counts[ei] = if b { 1 } else { 0 }
                }
                None =>
                return Err(CliError::InvalidValue(a.id, ev, "expected boolean value from env " + en))
              }
              ArgAction::SetFalse =>
              match parse_bool_strict(ev) {
                Some(b) => {
                  seen_source[ei] = 2
                  single_vals[ei] = if b { "true" } else { "false" }
                  counts[ei] = 1
                }
                None =>
                return Err(CliError::InvalidValue(a.id, ev, "expected boolean value from env " + en))
              }
              _ => record_arg_value(a, ei, ev, 2, seen_source, single_vals, multi_vals, counts)
            }
          }
          None => ()
        }
        None => ()
      }
      if !applied_env {
        match a.default_val {
          Some(dv) => record_arg_value(a, ei, dv, 3, seen_source, single_vals, multi_vals, counts)
          None =>
          if arg_action_eq(a.action, ArgAction::SetFalse) {
            seen_source[ei] = 3
            single_vals[ei] = "true"
            counts[ei] = 0
          }
        }
      }
    }
    ei = ei + 1
  }

  // Parse matched subcommand (if any) and propagate global args bidirectionally
  let sub_matches_arr : Array[ArgMatches] = []
  let mut sub_canonical_name : Option[String] = None

  if matched_sub_idx != -1 {
    let sub_cc = cc.compiled_subs[matched_sub_idx]
    sub_canonical_name = Some(sub_cc.cmd.name)

    // Pass current global values down to child
    let globals_down : Map[String, MatchedArg] = Map::new()
    let mut g = 0
    while g < cc.global_indices.length() {
      let g_idx = cc.global_indices[g]
      if seen_source[g_idx] != 0 {
        let ga = cc.all_args[g_idx]
        let src = match seen_source[g_idx] {
          1 => ValueSource::CommandLine
          2 => ValueSource::EnvVariable
          _ => ValueSource::DefaultValue
        }
        let vals = if arg_action_eq(ga.action, ArgAction::Append) || ga.multiple_values {
          multi_vals[g_idx]
        } else {
          [single_vals[g_idx]]
        }
        globals_down.set(
          ga.id,
          MatchedArg::{ id: ga.id, values: vals, count: counts[g_idx], source: src },
        )
      }
      g = g + 1
    }

    let child_m = match parse_compiled_slice(sub_cc, args, sub_start, env, globals_down) {
      Ok(cm) => cm
      Err(e) => return Err(e)
    }

    // Propagate updated global values back up to parent state
    let mut gu = 0
    while gu < cc.global_indices.length() {
      let g_idx = cc.global_indices[gu]
      let ga = cc.all_args[g_idx]
      match child_m.entries.get(ga.id) {
        Some(cm_entry) => {
          seen_source[g_idx] = match cm_entry.source {
            ValueSource::CommandLine => 1
            ValueSource::EnvVariable => 2
            ValueSource::DefaultValue => 3
          }
          counts[g_idx] = cm_entry.count
          if arg_action_eq(ga.action, ArgAction::Append) || ga.multiple_values {
            multi_vals[g_idx] = cm_entry.values
          } else if cm_entry.values.length() > 0 {
            single_vals[g_idx] = cm_entry.values[cm_entry.values.length() - 1]
          }
        }
        None => ()
      }
      gu = gu + 1
    }
    sub_matches_arr.push(child_m)
  }

  // Validate possible_values, conflicts_with, requires, and required
  let mut vi = 0
  while vi < n_args {
    let a = cc.all_args[vi]
    let src = seen_source[vi]

    // possible_values check
    if src != 0 && a.possible_vals.length() > 0 {
      if arg_action_eq(a.action, ArgAction::Append) || a.multiple_values {
        let arr = multi_vals[vi]
        let mut k = 0
        while k < arr.length() {
          if !in_string_list(arr[k], a.possible_vals) {
            return Err(CliError::InvalidValue(a.id, arr[k], "not in possible values"))
          }
          k = k + 1
        }
      } else if !in_string_list(single_vals[vi], a.possible_vals) {
        return Err(CliError::InvalidValue(a.id, single_vals[vi], "not in possible values"))
      }
    }

    // conflicts_with check (only explicit CLI=1 or Env=2 trigger conflicts)
    if src == 1 || src == 2 {
      let mut ci = 0
      while ci < a.conflicts.length() {
        let other_id = a.conflicts[ci]
        match cc.id_to_idx.get(other_id) {
          Some(o_idx) =>
          if seen_source[o_idx] == 1 || seen_source[o_idx] == 2 {
            return Err(CliError::Conflict(a.id, other_id))
          }
          None => ()
        }
        ci = ci + 1
      }

      // requires check (only explicit CLI=1 or Env=2 satisfy requires; defaults do not)
      let mut ri = 0
      while ri < a.requires_ids.length() {
        let req_id = a.requires_ids[ri]
        match cc.id_to_idx.get(req_id) {
          Some(r_idx) =>
          if seen_source[r_idx] != 1 && seen_source[r_idx] != 2 {
            return Err(CliError::MissingDependency(a.id, req_id))
          }
          None => return Err(CliError::MissingDependency(a.id, req_id))
        }
        ri = ri + 1
      }
    }

    // required check
    if a.required_flag && src == 0 {
      return Err(CliError::MissingRequired(a.id))
    }

    vi = vi + 1
  }

  // Materialize ArgMatches entries map (only matched args)
  let entries : Map[String, MatchedArg] = Map::new()
  let mut mi = 0
  while mi < n_args {
    if seen_source[mi] != 0 {
      let a = cc.all_args[mi]
      let src = match seen_source[mi] {
        1 => ValueSource::CommandLine
        2 => ValueSource::EnvVariable
        _ => ValueSource::DefaultValue
      }
      let vals = if arg_action_eq(a.action, ArgAction::Append) || a.multiple_values {
        multi_vals[mi]
      } else {
        [single_vals[mi]]
      }
      entries.set(a.id, MatchedArg::{ id: a.id, values: vals, count: counts[mi], source: src })
    }
    mi = mi + 1
  }

  Ok(ArgMatches::{ entries: entries, sub_name: sub_canonical_name, sub_matches: sub_matches_arr })
}

///| Parse argument slice using a precompiled `CompiledCommand`.
pub fn CompiledCommand::parse(
  self : CompiledCommand,
  args : Array[String],
) -> Result[ArgMatches, CliError] {
  let empty_env : Map[String, String] = Map::new()
  let empty_globals : Map[String, MatchedArg] = Map::new()
  parse_compiled_slice(self, args, 0, empty_env, empty_globals)
}

///| Parse argument slice with environment map using a precompiled `CompiledCommand`.
pub fn CompiledCommand::parse_with_env(
  self : CompiledCommand,
  args : Array[String],
  env : Map[String, String],
) -> Result[ArgMatches, CliError] {
  let empty_globals : Map[String, MatchedArg] = Map::new()
  parse_compiled_slice(self, args, 0, env, empty_globals)
}

///| Parse argument slice without environment variables.
pub fn Command::parse(self : Command, args : Array[String]) -> Result[ArgMatches, CliError] {
  let empty_env : Map[String, String] = Map::new()
  self.parse_with_env(args, empty_env)
}

///| Parse argument slice with environment variable fallback map.
pub fn Command::parse_with_env(
  self : Command,
  args : Array[String],
  env : Map[String, String],
) -> Result[ArgMatches, CliError] {
  let cc = match self.compile() {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  cc.parse_with_env(args, env)
}

///| Parse full argv (skipping `argv[0]` program name if non-empty).
pub fn Command::parse_from_argv(self : Command, argv : Array[String]) -> Result[ArgMatches, CliError] {
  let empty_env : Map[String, String] = Map::new()
  self.parse_from_argv_with_env(argv, empty_env)
}

///| Parse full argv with environment variables (skipping `argv[0]` if non-empty).
pub fn Command::parse_from_argv_with_env(
  self : Command,
  argv : Array[String],
  env : Map[String, String],
) -> Result[ArgMatches, CliError] {
  let cc = match self.compile() {
    Ok(c) => c
    Err(e) => return Err(e)
  }
  let empty_globals : Map[String, MatchedArg] = Map::new()
  let start = if argv.length() > 0 { 1 } else { 0 }
  parse_compiled_slice(cc, argv, start, env, empty_globals)
}

///| Parse matched value for `id` as `Int`.
pub fn ArgMatches::get_int(self : ArgMatches, id : String) -> Result[Option[Int], CliError] {
  match self.get_string(id) {
    None => Ok(None)
    Some(s) =>
    match parse_int_str(s) {
      Some(v) => Ok(Some(v))
      None => Err(CliError::InvalidValue(id, s, "expected 32-bit signed integer"))
    }
  }
}

///| Parse matched value for `id` as `Int64`.
pub fn ArgMatches::get_int64(self : ArgMatches, id : String) -> Result[Option[Int64], CliError] {
  match self.get_string(id) {
    None => Ok(None)
    Some(s) =>
    match parse_int64_str(s) {
      Some(v) => Ok(Some(v))
      None => Err(CliError::InvalidValue(id, s, "expected 64-bit signed integer"))
    }
  }
}

///| Parse matched value for `id` as `Double`.
pub fn ArgMatches::get_double(self : ArgMatches, id : String) -> Result[Option[Double], CliError] {
  match self.get_string(id) {
    None => Ok(None)
    Some(s) =>
    match parse_double_str(s) {
      Some(v) => Ok(Some(v))
      None => Err(CliError::InvalidValue(id, s, "expected floating-point number"))
    }
  }
}

///| Parse matched value for `id` as `Bool`.
pub fn ArgMatches::get_bool(self : ArgMatches, id : String) -> Result[Option[Bool], CliError] {
  match self.get_string(id) {
    None => Ok(None)
    Some(s) =>
    match parse_bool_str(s) {
      Some(v) => Ok(Some(v))
      None => Err(CliError::InvalidValue(id, s, "expected boolean value"))
    }
  }
}
