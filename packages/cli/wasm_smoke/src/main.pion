///| Wasm32 + Native smoke entry for the `cli` package.

import "cli"

///|
pub fn smoke() -> Int {
  let app = cli::Command::new("demo")
  .version("1.2.3")
  .about("Demo CLI")
  .arg(cli::Arg::new("verbose").short('v').long("verbose").action(cli::ArgAction::Count).global(true))
  .arg(cli::Arg::new("output").short('o').long("output").default_value("out.txt"))
  .arg(cli::Arg::new("color").long("color").negative("no-color").action(cli::ArgAction::SetTrue))
  .subcommand(
    cli::Command::new("run")
    .about("Run job")
    .arg(cli::Arg::new("count").short('n').long("count").default_value("1"))
    .arg(cli::Arg::new("files").multiple(true)),
  )

  let m = match app.parse(["-vv", "--no-color", "run", "-n", "-5", "--", "--help", "-"]) {
    Ok(v) => v
    Err(_) => return -1
  }
  if m.get_count("verbose") != 2 {
    return -2
  }
  if m.get_flag("color") {
    return -3
  }
  let sub = match m.subcommand_matches("run") {
    Some(s) => s
    None => return -4
  }
  match sub.get_int("count") {
    Ok(Some(-5)) => ()
    _ => return -5
  }
  match sub.get_many("files") {
    Some(fs) => if fs.length() != 2 || fs[0] != "--help" || fs[1] != "-" { return -6 }
    None => return -7
  }
  let bash = match cli::generate_completions(app, cli::Shell::Bash) {
    Ok(s) => s
    Err(_) => return -8
  }
  if bash.length() == 0 {
    return -9
  }
  app.render_help().length() + bash.length()
}

///|
pub fn main(world : World) -> Int {
  let _ = world
  let r = smoke()
  if r > 0 {
    0
  } else {
    1
  }
}
