///| Day-1 Red-Team security, robustness, and DoS defense test suite for `packages/cli`.

///|
fn rt_contains(haystack : String, needle : String) -> Bool {
  let hlen = haystack.length()
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  if nlen > hlen {
    return false
  }
  let mut i = 0
  while i <= hlen - nlen {
    let mut j = 0
    while j < nlen && haystack.code_unit_at(i + j) == needle.code_unit_at(j) {
      j = j + 1
    }
    if j == nlen {
      return true
    }
    i = i + 1
  }
  false
}

///|
test "rt_duplicate_flag_and_id_definition_checks" {
  // Duplicate long flag
  let dup_long = Command::new("app")
  .arg(Arg::new("a").long("out"))
  .arg(Arg::new("b").long("out"))
  match dup_long.validate() {
    Err(CliError::InvalidDefinition(_)) => ()
    _ => debug_assert(false, "expected InvalidDefinition for duplicate --out")
  }

  // Duplicate short flag
  let dup_short = Command::new("app")
  .arg(Arg::new("a").short('o'))
  .arg(Arg::new("b").short('o'))
  match dup_short.validate() {
    Err(CliError::InvalidDefinition(_)) => ()
    _ => debug_assert(false, "expected InvalidDefinition for duplicate -o")
  }

  // Duplicate arg id
  let dup_id = Command::new("app")
  .arg(Arg::new("same").long("one"))
  .arg(Arg::new("same").long("two"))
  match dup_id.validate() {
    Err(CliError::InvalidDefinition(_)) => ()
    _ => debug_assert(false, "expected InvalidDefinition for duplicate arg id")
  }

  // Negative long collides with another long
  let dup_neg = Command::new("app")
  .arg(Arg::new("color").long("color").negative("no-color").action(ArgAction::SetTrue))
  .arg(Arg::new("other").long("no-color").action(ArgAction::SetTrue))
  match dup_neg.validate() {
    Err(CliError::InvalidDefinition(_)) => ()
    _ => debug_assert(false, "expected InvalidDefinition for negative flag collision")
  }

  // Duplicate subcommand name / alias
  let dup_sub = Command::new("app")
  .subcommand(Command::new("run").alias("r"))
  .subcommand(Command::new("remove").alias("r"))
  match dup_sub.validate() {
    Err(CliError::InvalidDefinition(_)) => ()
    _ => debug_assert(false, "expected InvalidDefinition for duplicate subcommand alias")
  }
}

///|
test "rt_50k_args_linear_parse" {
  // 50,000 arguments must parse in O(N) linear time without quadratic blowup.
  let cmd = Command::new("bulk")
  .arg(Arg::new("verbose").short('v').action(ArgAction::Count))
  .arg(Arg::new("item").short('i').long("item").action(ArgAction::Append))
  .arg(Arg::new("pos").multiple(true))

  let argv : Array[String] = []
  let mut i = 0
  while i < 20000 {
    argv.push("-v")
    i = i + 1
  }
  let mut j = 0
  while j < 10000 {
    argv.push("-i")
    argv.push("val")
    j = j + 1
  }
  let mut k = 0
  while k < 10000 {
    argv.push("file")
    k = k + 1
  }
  // Total = 20000 + 20000 + 10000 = 50000 args
  debug_assert(argv.length() == 50000, "50k args constructed")

  let m = match cmd.parse(argv) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "50k parse failed: " + cli_error_to_string(e))
      return
    }
  }
  debug_assert(m.get_count("verbose") == 20000, "20k verbose count")
  match m.get_many("item") {
    Some(arr) => debug_assert(arr.length() == 10000, "10k append items")
    None => debug_assert(false, "missing items")
  }
  match m.get_many("pos") {
    Some(arr) => debug_assert(arr.length() == 10000, "10k positionals")
    None => debug_assert(false, "missing positionals")
  }
}

///|
test "rt_overlong_flag_and_unicode_values" {
  let cmd = Command::new("uni")
  .arg(Arg::new("output").short('o').long("output"))
  .arg(Arg::new("msg").short('m').long("message"))

  // 4KB unknown flag must reject quickly without O(N*M) edit-distance blowup
  let sb = StringBuilder::new()
  sb.write_string("--")
  let mut i = 0
  while i < 4096 {
    sb.write_char('a')
    i = i + 1
  }
  let huge_flag = sb.to_string()
  match cmd.parse([huge_flag]) {
    Err(CliError::UnknownArgument(_, None)) => ()
    _ => debug_assert(false, "expected UnknownArgument(_, None) for 4KB unknown flag")
  }

  // Unicode (CJK + emoji) values preserved verbatim
  let m = match cmd.parse(["--output", "报告_2026.txt", "-m=你好世界🚀"]) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "unicode parse failed: " + cli_error_to_string(e))
      return
    }
  }
  match m.get_string("output") {
    Some(v) => debug_assert(v == "报告_2026.txt", "cjk filename preserved")
    None => debug_assert(false, "missing output")
  }
  match m.get_string("msg") {
    Some(v) => debug_assert(v == "你好世界🚀", "unicode emoji preserved")
    None => debug_assert(false, "missing msg")
  }
}

///|
test "rt_shell_completion_injection_escaping" {
  let evil_help = "desc with 'single' \"double\" `id` $(whoami)\nline2: [brackets]"
  let cmd = Command::new("safe")
  .about("app 'about' $(rm -rf /)\nsecond line")
  .arg(
    Arg::new("opt")
    .short('x')
    .long("opt")
    .help(evil_help)
    .possible_values(["ok", "a'b", "c\"d", "e\nf"]),
  )

  // Bash: must not contain raw unescaped newlines inside single-line entries or raw $(whoami) inside double quotes
  let bash = match generate_completions(cmd, Shell::Bash) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "bash gen failed: " + cli_error_to_string(e))
      return
    }
  }
  debug_assert(!rt_contains(bash, "\nline2"), "bash must sanitize newlines in help/values")

  // Zsh: single-quoted descriptions must escape single quotes, brackets, colons, and newlines
  let zsh = match generate_completions(cmd, Shell::Zsh) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "zsh gen failed: " + cli_error_to_string(e))
      return
    }
  }
  debug_assert(!rt_contains(zsh, "\nline2"), "zsh must sanitize newlines in help")
  debug_assert(!rt_contains(zsh, "\nsecond line"), "zsh must sanitize newlines in about")

  // Fish: single-quoted -d '...' must escape single quotes and backslashes and strip newlines
  let fish = match generate_completions(cmd, Shell::Fish) {
    Ok(s) => s
    Err(e) => {
      debug_assert(false, "fish gen failed: " + cli_error_to_string(e))
      return
    }
  }
  debug_assert(!rt_contains(fish, "\nline2"), "fish must sanitize newlines in help")
  debug_assert(rt_contains(fish, "\\'single\\'"), "fish escapes single quotes")
}

///|
test "rt_deep_subcommands_and_cyclic_constraints" {
  // Exceeding MAX_SUBCOMMAND_DEPTH (64) must fail validation cleanly without stack overflow
  let mut deep = Command::new("leaf")
  let mut d = 0
  while d <= MAX_SUBCOMMAND_DEPTH + 2 {
    deep = Command::new("lvl" + d.to_string()).subcommand(deep)
    d = d + 1
  }
  match deep.validate() {
    Err(CliError::InvalidDefinition(_)) => ()
    _ => debug_assert(false, "expected InvalidDefinition for overly deep subcommand tree")
  }

  // Direct self-requires cycle: a -> a
  let self_cycle = Command::new("app")
  .arg(Arg::new("a").long("a").action(ArgAction::SetTrue).requires("a"))
  match self_cycle.validate() {
    Err(CliError::InvalidDefinition(_)) => ()
    _ => debug_assert(false, "expected InvalidDefinition for self-requires cycle")
  }

  // Mutual requires cycle: a -> b -> c -> a
  let mutual_cycle = Command::new("app")
  .arg(Arg::new("a").long("a").action(ArgAction::SetTrue).requires("b"))
  .arg(Arg::new("b").long("b").action(ArgAction::SetTrue).requires("c"))
  .arg(Arg::new("c").long("c").action(ArgAction::SetTrue).requires("a"))
  match mutual_cycle.validate() {
    Err(CliError::InvalidDefinition(_)) => ()
    _ => debug_assert(false, "expected InvalidDefinition for cyclic requires")
  }
}
