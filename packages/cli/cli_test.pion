///| Upstream `clap` + `pflag` POSIX/GNU compliance test suite (Red -> Green).

///|
fn str_contains(haystack : String, needle : String) -> Bool {
  let hlen = haystack.length()
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  if nlen > hlen {
    return false
  }
  let mut i = 0
  while i <= hlen - nlen {
    let mut j = 0
    while j < nlen && haystack.code_unit_at(i + j) == needle.code_unit_at(j) {
      j = j + 1
    }
    if j == nlen {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn must_parse(cmd : Command, args : Array[String], label : String) -> ArgMatches {
  match cmd.parse(args) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, label + ": expected Ok, got Err: " + cli_error_to_string(e))
      ArgMatches::empty()
    }
  }
}

///|
fn must_parse_env(
  cmd : Command,
  args : Array[String],
  env : Map[String, String],
  label : String,
) -> ArgMatches {
  match cmd.parse_with_env(args, env) {
    Ok(m) => m
    Err(e) => {
      debug_assert(false, label + ": expected Ok, got Err: " + cli_error_to_string(e))
      ArgMatches::empty()
    }
  }
}

///|
fn assert_str_opt(got : Option[String], expected : String, label : String) -> Unit {
  match got {
    Some(v) => debug_assert(v == expected, label + ": expected '" + expected + "', got '" + v + "'")
    None => debug_assert(false, label + ": expected Some('" + expected + "'), got None")
  }
}

///|
fn assert_str_arr(got : Option[Array[String]], expected : Array[String], label : String) -> Unit {
  match got {
    Some(arr) => {
      debug_assert(
        arr.length() == expected.length(),
        label + ": length mismatch: expected " + expected.length().to_string() + ", got " + arr.length().to_string(),
      )
      let mut i = 0
      while i < expected.length() && i < arr.length() {
        debug_assert(
          arr[i] == expected[i],
          label + "[" + i.to_string() + "]: expected '" + expected[i] + "', got '" + arr[i] + "'",
        )
        i = i + 1
      }
    }
    None => debug_assert(false, label + ": expected Some array, got None")
  }
}

///|
test "posix_gnu_long_and_short_flags" {
  let cmd = Command::new("app")
  .arg(Arg::new("output").short('o').long("output").help("Output file"))
  .arg(Arg::new("format").short('f').long("format").help("Output format"))
  .arg(Arg::new("quiet").short('q').long("quiet").action(ArgAction::SetTrue))

  // --output file
  let m1 = must_parse(cmd, ["--output", "out.txt"], "long separate")
  assert_str_opt(m1.get_string("output"), "out.txt", "long separate value")

  // --output=file
  let m2 = must_parse(cmd, ["--output=out2.txt"], "long equals")
  assert_str_opt(m2.get_string("output"), "out2.txt", "long equals value")

  // --output= (empty string is valid)
  let m3 = must_parse(cmd, ["--output="], "long equals empty")
  assert_str_opt(m3.get_string("output"), "", "long equals empty value")

  // -o file
  let m4 = must_parse(cmd, ["-o", "short.txt"], "short separate")
  assert_str_opt(m4.get_string("output"), "short.txt", "short separate value")

  // -ofile (attached value)
  let m5 = must_parse(cmd, ["-oattached.txt"], "short attached")
  assert_str_opt(m5.get_string("output"), "attached.txt", "short attached value")

  // -o=file (pflag/GNU style equals)
  let m6 = must_parse(cmd, ["-o=eqshort.txt"], "short equals")
  assert_str_opt(m6.get_string("output"), "eqshort.txt", "short equals value")

  // Last value wins for ArgAction::Set
  let m7 = must_parse(cmd, ["-o", "first.txt", "--output=second.txt"], "last wins")
  assert_str_opt(m7.get_string("output"), "second.txt", "last wins value")

  // Missing value returns MissingValue
  match cmd.parse(["--output"]) {
    Err(CliError::MissingValue(_)) => ()
    _ => debug_assert(false, "expected MissingValue for dangling --output")
  }
  match cmd.parse(["-o"]) {
    Err(CliError::MissingValue(_)) => ()
    _ => debug_assert(false, "expected MissingValue for dangling -o")
  }
}

///|
test "short_flag_clustering_and_count" {
  let cmd = Command::new("app")
  .arg(Arg::new("a").short('a').action(ArgAction::SetTrue))
  .arg(Arg::new("b").short('b').action(ArgAction::SetTrue))
  .arg(Arg::new("c").short('c').action(ArgAction::SetTrue))
  .arg(Arg::new("verbose").short('v').long("verbose").action(ArgAction::Count))
  .arg(Arg::new("output").short('o').long("output"))

  // -abc boolean clustering
  let m1 = must_parse(cmd, ["-abc"], "cluster -abc")
  debug_assert(m1.get_flag("a"), "a set")
  debug_assert(m1.get_flag("b"), "b set")
  debug_assert(m1.get_flag("c"), "c set")

  // -vvv count clustering
  let m2 = must_parse(cmd, ["-vvv"], "count -vvv")
  debug_assert(m2.get_count("verbose") == 3, "verbose count 3")

  // mixed -v --verbose -vv
  let m3 = must_parse(cmd, ["-v", "--verbose", "-vv"], "count mixed")
  debug_assert(m3.get_count("verbose") == 4, "verbose count 4")

  // clustered booleans ending in value-taking short flag: -abofoo and -abo foo and -abo=bar
  let m4 = must_parse(cmd, ["-abofoo.txt"], "cluster with attached value")
  debug_assert(m4.get_flag("a") && m4.get_flag("b"), "a and b set")
  assert_str_opt(m4.get_string("output"), "foo.txt", "attached cluster output")

  let m5 = must_parse(cmd, ["-abo", "next.txt"], "cluster with next value")
  debug_assert(m5.get_flag("a") && m5.get_flag("b"), "a and b set")
  assert_str_opt(m5.get_string("output"), "next.txt", "next cluster output")

  let m6 = must_parse(cmd, ["-abo=eq.txt"], "cluster with equals value")
  debug_assert(m6.get_flag("a") && m6.get_flag("b"), "a and b set")
  assert_str_opt(m6.get_string("output"), "eq.txt", "equals cluster output")
}

///|
test "negative_boolean_flags_and_set_false" {
  let cmd = Command::new("app")
  .arg(Arg::new("color").long("color").negative("no-color").action(ArgAction::SetTrue))
  .arg(Arg::new("cache").long("no-cache").action(ArgAction::SetFalse))

  let m1 = must_parse(cmd, ["--color"], "color true")
  debug_assert(m1.get_flag("color"), "color should be true")
  debug_assert(m1.get_flag("cache"), "cache SetFalse defaults to true when absent")

  let m2 = must_parse(cmd, ["--color", "--no-color"], "color overridden to false")
  debug_assert(!m2.get_flag("color"), "color should be false after --no-color")

  let m3 = must_parse(cmd, ["--no-color", "--color"], "no-color overridden to true")
  debug_assert(m3.get_flag("color"), "color should be true after --color")

  let m4 = must_parse(cmd, ["--no-cache"], "set_false triggered")
  debug_assert(!m4.get_flag("cache"), "cache should be false after --no-cache")
}

///|
test "append_and_value_delimiter" {
  let cmd = Command::new("cc")
  .arg(Arg::new("include").short('I').long("include").action(ArgAction::Append))
  .arg(
    Arg::new("tags")
    .short('t')
    .long("tags")
    .action(ArgAction::Append)
    .value_delimiter(','),
  )

  let m1 = must_parse(cmd, ["-I", "/usr/include", "-I/opt/inc", "--include=local"], "append")
  assert_str_arr(m1.get_many("include"), ["/usr/include", "/opt/inc", "local"], "include paths")

  let m2 = must_parse(cmd, ["-t", "a,b,c", "--tags=d,e"], "delimiter")
  assert_str_arr(m2.get_many("tags"), ["a", "b", "c", "d", "e"], "delimited tags")
}

///|
test "single_dash_double_dash_and_negative_numbers" {
  let cmd = Command::new("tool")
  .arg(Arg::new("num").short('n').long("num"))
  .arg(Arg::new("offset").long("offset"))
  .arg(Arg::new("flag_x").short('x').action(ArgAction::SetTrue))
  .arg(Arg::new("items").multiple(true))

  // Single dash `-` as stdin positional argument and as option value
  let m1 = must_parse(cmd, ["-"], "single dash positional")
  assert_str_arr(m1.get_many("items"), ["-"], "stdin positional")

  let m2 = must_parse(cmd, ["-n", "-"], "single dash as option value")
  assert_str_opt(m2.get_string("num"), "-", "num is -")

  // Double dash `--` terminates option parsing completely (including --help, -x, -h, --)
  let m3 = must_parse(cmd, ["-x", "--", "--help", "-h", "-V", "-x", "--", "-5"], "double dash")
  debug_assert(m3.get_flag("flag_x"), "flag_x before --")
  assert_str_arr(
    m3.get_many("items"),
    ["--help", "-h", "-V", "-x", "--", "-5"],
    "everything after -- is positional",
  )

  // Negative numbers as option values and positional arguments (must NOT be misparsed as unknown short flag -5)
  let m4 = must_parse(cmd, ["-n", "-5", "--offset=-10", "-42", "-3.14"], "negative numbers")
  match m4.get_int("num") {
    Ok(Some(-5)) => ()
    _ => debug_assert(false, "expected num == -5")
  }
  match m4.get_int("offset") {
    Ok(Some(-10)) => ()
    _ => debug_assert(false, "expected offset == -10")
  }
  assert_str_arr(m4.get_many("items"), ["-42", "-3.14"], "negative positionals")
}

///|
test "positionals_required_optional_variadic" {
  let cmd = Command::new("cp")
  .arg(Arg::new("src").required(true))
  .arg(Arg::new("dst").required(false))
  .arg(Arg::new("extra").multiple(true))

  let m1 = must_parse(cmd, ["a.txt"], "only required positional")
  assert_str_opt(m1.get_string("src"), "a.txt", "src")
  match m1.get_string("dst") {
    None => ()
    Some(v) => debug_assert(false, "expected dst None, got " + v)
  }

  let m2 = must_parse(cmd, ["a.txt", "b.txt", "c.txt", "d.txt"], "variadic positionals")
  assert_str_opt(m2.get_string("src"), "a.txt", "src")
  assert_str_opt(m2.get_string("dst"), "b.txt", "dst")
  assert_str_arr(m2.get_many("extra"), ["c.txt", "d.txt"], "extra variadic")

  match cmd.parse([]) {
    Err(CliError::MissingRequired(id)) => debug_assert(id == "src", "missing src")
    _ => debug_assert(false, "expected MissingRequired(src)")
  }

  // Extra positional when no variadic arg exists
  let strict = Command::new("one").arg(Arg::new("only"))
  match strict.parse(["a", "b"]) {
    Err(CliError::UnexpectedArgument(arg)) => debug_assert(arg == "b", "unexpected b")
    _ => debug_assert(false, "expected UnexpectedArgument(b)")
  }
}

///|
test "nested_subcommands_aliases_global_flags_and_defaults" {
  let git = Command::new("git")
  .version("2.45.0")
  .arg(Arg::new("verbose").short('v').long("verbose").action(ArgAction::Count).global(true))
  .arg(Arg::new("config").short('C').long("config").global(true))
  .subcommand(
    Command::new("remote")
    .alias("rem")
    .subcommand_required(true)
    .subcommand(
      Command::new("add")
      .aliases(["new", "a"])
      .arg(Arg::new("name").required(true))
      .arg(Arg::new("url").required(true)),
    ),
  )

  // Deep nested subcommand with global flags placed at multiple levels
  let m = must_parse(
    git,
    ["-v", "rem", "--config", "/etc/git", "new", "origin", "https://example.com/repo.git", "-vv"],
    "nested git remote add",
  )
  debug_assert(m.get_count("verbose") == 3, "global verbose propagated to root (1+2=3)")
  assert_str_opt(m.get_string("config"), "/etc/git", "global config propagated to root")
  assert_str_opt(m.subcommand_name(), "remote", "canonical subcommand name from alias 'rem'")

  let rem = match m.subcommand_matches("remote") {
    Some(s) => s
    None => {
      debug_assert(false, "missing remote sub_matches")
      ArgMatches::empty()
    }
  }
  debug_assert(rem.get_count("verbose") == 3, "global verbose visible in remote")
  assert_str_opt(rem.subcommand_name(), "add", "canonical subcommand name from alias 'new'")

  let add = match rem.subcommand_matches("add") {
    Some(s) => s
    None => {
      debug_assert(false, "missing add sub_matches")
      ArgMatches::empty()
    }
  }
  debug_assert(add.get_count("verbose") == 3, "global verbose visible in add")
  assert_str_opt(add.get_string("config"), "/etc/git", "global config visible in add")
  assert_str_opt(add.get_string("name"), "origin", "add name")
  assert_str_opt(add.get_string("url"), "https://example.com/repo.git", "add url")

  // subcommand_required enforced
  match git.parse(["remote"]) {
    Err(CliError::MissingRequired(_)) => ()
    _ => debug_assert(false, "expected MissingRequired for remote without subcommand")
  }

  // default_subcommand
  let runner = Command::new("runner")
  .default_subcommand("serve")
  .subcommand(
    Command::new("serve").arg(Arg::new("port").long("port").default_value("8080")),
  )
  .subcommand(Command::new("check"))

  let mr = must_parse(runner, [], "default subcommand")
  assert_str_opt(mr.subcommand_name(), "serve", "default subcommand selected")
  let srv = match mr.subcommand_matches("serve") {
    Some(s) => s
    None => {
      debug_assert(false, "expected serve matches")
      ArgMatches::empty()
    }
  }
  assert_str_opt(srv.get_string("port"), "8080", "default subcommand arg default")
}

///|
test "env_default_priority_and_typed_getters" {
  let cmd = Command::new("srv")
  .arg(Arg::new("port").short('p').long("port").env("PORT").default_value("8080"))
  .arg(Arg::new("limit").long("limit").default_value("9000000000"))
  .arg(Arg::new("ratio").long("ratio").default_value("0.75"))
  .arg(Arg::new("debug").long("debug").env("DEBUG").action(ArgAction::SetTrue))
  .arg(Arg::new("mode").long("mode").possible_values(["dev", "staging", "prod"]).default_value("dev"))

  // 1. Default only
  let empty_env : Map[String, String] = Map::new()
  let m1 = must_parse_env(cmd, [], empty_env, "default only")
  match m1.get_int("port") {
    Ok(Some(8080)) => ()
    _ => debug_assert(false, "port default 8080")
  }
  match m1.value_source("port") {
    Some(ValueSource::DefaultValue) => ()
    _ => debug_assert(false, "port source DefaultValue")
  }
  match m1.get_int64("limit") {
    Ok(Some(v)) => debug_assert(v == 9000000000L, "limit 9000000000L")
    _ => debug_assert(false, "limit 9000000000L")
  }
  match m1.get_double("ratio") {
    Ok(Some(v)) => debug_assert(v > 0.749 && v < 0.751, "ratio ~0.75")
    _ => debug_assert(false, "ratio double")
  }

  // 2. Env overrides default
  let env2 : Map[String, String] = Map::new()
  env2.set("PORT", "9090")
  env2.set("DEBUG", "true")
  let m2 = must_parse_env(cmd, [], env2, "env overrides default")
  match m2.get_int("port") {
    Ok(Some(9090)) => ()
    _ => debug_assert(false, "port from env 9090")
  }
  match m2.value_source("port") {
    Some(ValueSource::EnvVariable) => ()
    _ => debug_assert(false, "port source EnvVariable")
  }
  match m2.get_bool("debug") {
    Ok(Some(true)) => ()
    _ => debug_assert(false, "debug from env true")
  }

  // 3. CLI overrides env and default
  let m3 = must_parse_env(cmd, ["--port", "3000", "--mode", "prod"], env2, "cli overrides env")
  match m3.get_int("port") {
    Ok(Some(3000)) => ()
    _ => debug_assert(false, "port from cli 3000")
  }
  match m3.value_source("port") {
    Some(ValueSource::CommandLine) => ()
    _ => debug_assert(false, "port source CommandLine")
  }
  assert_str_opt(m3.get_string("mode"), "prod", "mode prod")

  // 4. Invalid possible_values rejected
  match cmd.parse(["--mode", "invalid"]) {
    Err(CliError::InvalidValue(id, v, _)) => {
      debug_assert(id == "mode" && v == "invalid", "invalid mode")
    }
    _ => debug_assert(false, "expected InvalidValue for --mode invalid")
  }

  // 5. Invalid typed getter returns Err(InvalidValue)
  let m_bad = must_parse(cmd, ["--port", "not_a_number", "--ratio", "abc"], "raw string ok")
  match m_bad.get_int("port") {
    Err(CliError::InvalidValue(_, _, _)) => ()
    _ => debug_assert(false, "expected InvalidValue from get_int")
  }
  match m_bad.get_double("ratio") {
    Err(CliError::InvalidValue(_, _, _)) => ()
    _ => debug_assert(false, "expected InvalidValue from get_double")
  }
}

///|
test "conflicts_with_and_requires_constraints" {
  let cmd = Command::new("app")
  .arg(Arg::new("json").long("json").action(ArgAction::SetTrue).conflicts_with("yaml"))
  .arg(Arg::new("yaml").long("yaml").action(ArgAction::SetTrue))
  .arg(Arg::new("tls").long("tls").action(ArgAction::SetTrue).requires("cert"))
  .arg(Arg::new("cert").long("cert"))
  .arg(Arg::new("format").long("format").default_value("text").conflicts_with("json"))

  // Symmetric conflict check
  match cmd.parse(["--json", "--yaml"]) {
    Err(CliError::Conflict(_, _)) => ()
    _ => debug_assert(false, "expected Conflict between --json and --yaml")
  }

  // Default value does NOT spuriously conflict with --json
  let m_ok = must_parse(cmd, ["--json"], "json with default format ok")
  debug_assert(m_ok.get_flag("json"), "json set")

  // Explicit --format conflicts with --json
  match cmd.parse(["--json", "--format", "plain"]) {
    Err(CliError::Conflict(_, _)) => ()
    _ => debug_assert(false, "expected Conflict between --json and explicit --format")
  }

  // requires unmet
  match cmd.parse(["--tls"]) {
    Err(CliError::MissingDependency(a, b)) => {
      debug_assert(a == "tls" && b == "cert", "tls requires cert")
    }
    _ => debug_assert(false, "expected MissingDependency(tls, cert)")
  }

  // requires satisfied
  let m_tls = must_parse(cmd, ["--tls", "--cert", "a.pem"], "tls with cert ok")
  debug_assert(m_tls.get_flag("tls"), "tls set")
  assert_str_opt(m_tls.get_string("cert"), "a.pem", "cert value")
}

///|
test "help_version_hidden_and_typo_suggestions" {
  let cmd = Command::new("mytool")
  .version("2.1.0")
  .about("Short description")
  .long_about("Detailed long description for mytool.")
  .arg(
    Arg::new("output")
    .short('o')
    .long("output")
    .help("Short output help")
    .long_help("Long output help with details")
    .default_value("out.bin")
    .env("MYTOOL_OUT"),
  )
  .arg(Arg::new("secret").long("secret").hide(true).help("Hidden flag"))
  .subcommand(Command::new("build").about("Build project"))
  .subcommand(Command::new("internal").hide(true).about("Hidden subcommand"))

  // -h returns DisplayHelp (short)
  match cmd.parse(["-h"]) {
    Err(CliError::DisplayHelp(txt)) => {
      debug_assert(str_contains(txt, "Usage: mytool"), "short help has usage")
      debug_assert(str_contains(txt, "Short output help"), "short help has short arg help")
      debug_assert(!str_contains(txt, "--secret"), "hidden arg omitted from help")
      debug_assert(!str_contains(txt, "internal"), "hidden subcommand omitted from help")
    }
    _ => debug_assert(false, "expected DisplayHelp for -h")
  }

  // --help returns DisplayHelp (long)
  match cmd.parse(["--help"]) {
    Err(CliError::DisplayHelp(txt)) => {
      debug_assert(str_contains(txt, "Detailed long description"), "long help has long_about")
      debug_assert(str_contains(txt, "Long output help"), "long help has long_help")
      debug_assert(str_contains(txt, "MYTOOL_OUT"), "long help shows env")
      debug_assert(str_contains(txt, "out.bin"), "long help shows default")
    }
    _ => debug_assert(false, "expected DisplayHelp for --help")
  }

  // -V / --version returns DisplayVersion
  match cmd.parse(["-V"]) {
    Err(CliError::DisplayVersion(v)) => debug_assert(str_contains(v, "mytool 2.1.0"), "version line")
    _ => debug_assert(false, "expected DisplayVersion for -V")
  }
  match cmd.parse(["--version"]) {
    Err(CliError::DisplayVersion(v)) => debug_assert(str_contains(v, "2.1.0"), "version line")
    _ => debug_assert(false, "expected DisplayVersion for --version")
  }

  // Damerau-Levenshtein transposition distance
  debug_assert(damerau_levenshtein("output", "outptu") == 1, "transposition distance is 1")
  debug_assert(damerau_levenshtein("kitten", "sitting") == 3, "kitten->sitting is 3")

  // Typo suggestion for unknown flag
  match cmd.parse(["--outptu", "a.bin"]) {
    Err(CliError::UnknownArgument(arg, Some(sug))) => {
      debug_assert(arg == "--outptu", "unknown arg")
      debug_assert(sug == "--output", "suggested --output, got " + sug)
    }
    _ => debug_assert(false, "expected UnknownArgument with suggestion --output")
  }

  // Typo suggestion for unknown subcommand
  match cmd.parse(["biuld"]) {
    Err(CliError::UnknownSubcommand(sub, Some(sug))) => {
      debug_assert(sub == "biuld", "unknown subcommand")
      debug_assert(sug == "build", "suggested build, got " + sug)
    }
    _ => debug_assert(false, "expected UnknownSubcommand with suggestion build")
  }

  // Hidden flag must not be suggested
  match cmd.parse(["--secert"]) {
    Err(CliError::UnknownArgument(_, None)) => ()
    _ => debug_assert(false, "hidden flag should not be suggested")
  }
}

///|
test "shell_completions_bash_zsh_fish" {
  let cmd = Command::new("pcli")
  .about("Example CLI")
  .arg(Arg::new("verbose").short('v').long("verbose").action(ArgAction::Count).help("Verbose output"))
  .arg(
    Arg::new("format")
    .short('f')
    .long("format")
    .possible_values(["json", "yaml", "toml"])
    .help("Output format"),
  )
  .subcommand(
    Command::new("deploy")
    .about("Deploy service")
    .arg(Arg::new("env").long("env").possible_values(["dev", "prod"]).help("Target environment")),
  )

  match generate_completions(cmd, Shell::Bash) {
    Ok(s) => {
      debug_assert(str_contains(s, "complete -F _pcli"), "bash complete registration")
      debug_assert(str_contains(s, "--verbose"), "bash has --verbose")
      debug_assert(str_contains(s, "deploy"), "bash has deploy subcommand")
      debug_assert(str_contains(s, "json yaml toml"), "bash has possible_values")
    }
    Err(e) => debug_assert(false, "bash completion failed: " + cli_error_to_string(e))
  }

  match generate_completions(cmd, Shell::Zsh) {
    Ok(s) => {
      debug_assert(str_contains(s, "#compdef pcli"), "zsh compdef header")
      debug_assert(str_contains(s, "--verbose"), "zsh has --verbose")
      debug_assert(str_contains(s, "deploy"), "zsh has deploy")
      debug_assert(str_contains(s, "(json yaml toml)"), "zsh has possible_values")
    }
    Err(e) => debug_assert(false, "zsh completion failed: " + cli_error_to_string(e))
  }

  match generate_completions(cmd, Shell::Fish) {
    Ok(s) => {
      debug_assert(str_contains(s, "complete -c pcli"), "fish complete command")
      debug_assert(str_contains(s, "-l verbose"), "fish has -l verbose")
      debug_assert(str_contains(s, "-s v"), "fish has -s v")
      debug_assert(str_contains(s, "deploy"), "fish has deploy")
      debug_assert(str_contains(s, "json yaml toml"), "fish has possible_values")
    }
    Err(e) => debug_assert(false, "fish completion failed: " + cli_error_to_string(e))
  }
}

///|
test "parse_from_argv_and_compiled_command_reuse" {
  let cmd = Command::new("app")
  .arg(Arg::new("count").short('c').long("count").default_value("0"))
  .arg(Arg::new("flag").short('f').action(ArgAction::SetTrue))

  let m = match cmd.parse_from_argv(["/usr/bin/app", "-f", "-c", "42"]) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "parse_from_argv failed: " + cli_error_to_string(e))
      ArgMatches::empty()
    }
  }
  debug_assert(m.get_flag("flag"), "flag set")
  match m.get_int("count") {
    Ok(Some(42)) => ()
    _ => debug_assert(false, "count 42")
  }

  // CompiledCommand reuse across multiple parses
  let compiled = match cmd.compile() {
    Ok(c) => c
    Err(e) => {
      debug_assert(false, "compile failed: " + cli_error_to_string(e))
      return
    }
  }
  let mut i = 0
  while i < 10 {
    let r = match compiled.parse(["-c", i.to_string()]) {
      Ok(v) => v
      Err(e) => {
        debug_assert(false, "compiled parse failed: " + cli_error_to_string(e))
        return
      }
    }
    match r.get_int("count") {
      Ok(Some(n)) => debug_assert(n == i, "compiled count mismatch")
      _ => debug_assert(false, "compiled get_int failed")
    }
    i = i + 1
  }
}
