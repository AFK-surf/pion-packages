///| Red-team tests for `packages/cli` (audit of `feat/pkg-cli` d65ed21 against Rust `clap =4.5.32`,
///| Go `spf13/pflag v1.0.6`, and real `bash 5.3` / `zsh 5.9` completion runtimes).
///|
///| Naming:
///| - `p0_*` / `p1_*` / `p2_*`: assert the EXPECTED correct behaviour; they FAIL while the defect exists.
///| - `div_*`: assert clap 4.5.32's behaviour where Pion diverges (FAIL = divergence present). These are
///|   semantic differences to decide on, not necessarily bugs; REPORT.md says which side is better.
///| - `ctl_*`: control probes of suspected weak spots that are expected to PASS (Pion is correct there).
///|
///| Shell-level evidence (bash -n / zsh -n, sourcing the script, real zle+compsys TAB via zsh/zpty)
///| is produced by `run_audit.sh shell`; these unit tests pin the generator output that causes it.

import "cli"

///|
fn has(haystack : String, needle : String) -> Bool {
  let hlen = haystack.length()
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  if nlen > hlen {
    return false
  }
  let mut i = 0
  while i <= hlen - nlen {
    let mut j = 0
    while j < nlen && haystack.code_unit_at(i + j) == needle.code_unit_at(j) {
      j = j + 1
    }
    if j == nlen {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn count_of(haystack : String, needle : String) -> Int {
  let hlen = haystack.length()
  let nlen = needle.length()
  let mut n = 0
  let mut i = 0
  while i + nlen <= hlen {
    let mut j = 0
    while j < nlen && haystack.code_unit_at(i + j) == needle.code_unit_at(j) {
      j = j + 1
    }
    if j == nlen {
      n = n + 1
      i = i + nlen
    } else {
      i = i + 1
    }
  }
  n
}

///| Completion script, or "" when the generator rejects the definition (rejecting is an acceptable fix).
fn script(cmd : cli::Command, sh : cli::Shell) -> String {
  match cli::generate_completions(cmd, sh) {
    Ok(s) => s
    Err(_) => ""
  }
}

///|
fn parse(cmd : cli::Command, args : Array[String]) -> Result[cli::ArgMatches, cli::CliError] {
  cmd.parse(args)
}

///|
fn is_ok(r : Result[cli::ArgMatches, cli::CliError]) -> Bool {
  match r {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn err_text(r : Result[cli::ArgMatches, cli::CliError]) -> String {
  match r {
    Ok(_) => "<ok>"
    Err(e) => cli::cli_error_to_string(e)
  }
}

///|
fn sub_spec() -> cli::Command {
  cli::Command::new("app")
  .version("1.0")
  .arg(cli::Arg::new("verbose").short('v').long("verbose").action(cli::ArgAction::Count).global(true))
  .arg(cli::Arg::new("cfg").long("cfg").global(true))
  .arg(cli::Arg::new("pos"))
  .subcommand(
    cli::Command::new("run")
    .about("Run")
    .arg(cli::Arg::new("x").long("x").action(cli::ArgAction::SetTrue).requires("cfg")),
  )
  .subcommand(
    cli::Command::new("deep").subcommand(
      cli::Command::new("a").subcommand(cli::Command::new("b")),
    ),
  )
}

///|
fn dbl_bits(s : String) -> Int64 {
  match cli::Command::new("t").arg(cli::Arg::new("x").long("x")).parse(["--x", s]) {
    Ok(m) =>
    match m.get_double("x") {
      Ok(Some(d)) => d.reinterpret_as_uint64().reinterpret_as_int64()
      _ => -1L
    }
    Err(_) => -1L
  }
}

// ---------------------------------------------------------------------------
// P0: shell completion scripts execute attacker-controlled text / are syntactically broken
// ---------------------------------------------------------------------------

///| `possible_values` go into `compgen -W '...'` with only `'` escaped. `compgen -W` expands its word
///| list (parameter/command substitution), so `$(...)` / backticks run when the user presses TAB.
///| Verified: `run_audit.sh shell` sources the script and calls `_app` -> PWNED_pv_dollar/PWNED_pv_tick.
test "p0_bash_possible_values_command_substitution" {
  let s = script(
    cli::Command::new("app").arg(
      cli::Arg::new("mode").long("mode").possible_values(["$(touch PWNED_pv_dollar)", "`touch PWNED_pv_tick`"]),
    ),
    cli::Shell::Bash,
  )
  debug_assert(!has(s, "$(touch PWNED"), "bash: possible value `$(...)` emitted unescaped into compgen -W:\n" + s)
  debug_assert(!has(s, "`touch PWNED"), "bash: possible value backticks emitted unescaped into compgen -W")
}

///| Zsh `_arguments` evaluates `(v1 v2)` actions with `eval ws\=\( "${action[2,-2]}" \)`
///| (/usr/share/zsh/5.9/functions/_arguments:435). Verified with a real zle TAB under zsh/zpty.
test "p0_zsh_possible_values_eval" {
  let s = script(
    cli::Command::new("app").arg(
      cli::Arg::new("mode").long("mode").possible_values(["$(touch PWNED_pv_dollar)", "`touch PWNED_pv_tick`"]),
    ),
    cli::Shell::Zsh,
  )
  debug_assert(!has(s, "$(touch PWNED"), "zsh: possible value `$(...)` reaches _arguments eval unescaped:\n" + s)
  debug_assert(!has(s, "`touch PWNED"), "zsh: possible value backticks reach _arguments eval unescaped")
}

///| Fish expands `complete -a` arguments at completion time (command substitution `$(...)`, fish >= 3.4).
///| Static evidence only (fish is not installed on the audit host).
test "p0_fish_possible_values_command_substitution" {
  let s = script(
    cli::Command::new("app").arg(cli::Arg::new("mode").long("mode").possible_values(["$(touch PWNED_pv_dollar)"])),
    cli::Shell::Fish,
  )
  debug_assert(!has(s, "$(touch PWNED"), "fish: possible value `$(...)` emitted into `complete -a`:\n" + s)
}

///| `escape_bash_token` keeps `;` `>` `<` `|` `&` `(` `)`: a binary name becomes shell code on `source`.
///| bash: `complete -F _app__PWNED_cmdname app;>PWNED_cmdname` creates PWNED_cmdname when sourced.
test "p0_bash_command_name_injection_on_source" {
  let s = script(
    cli::Command::new("app;>PWNED_cmdname").arg(cli::Arg::new("v").long("verbose").action(cli::ArgAction::SetTrue)),
    cli::Shell::Bash,
  )
  debug_assert(!has(s, "app;>PWNED_cmdname\n"), "bash: command name emitted unquoted after `complete -F`:\n" + s)
}

///|
test "p0_fish_command_name_and_long_flag_injection_on_source" {
  let s1 = script(
    cli::Command::new("app;>PWNED_cmdname").arg(cli::Arg::new("v").long("verbose").action(cli::ArgAction::SetTrue)),
    cli::Shell::Fish,
  )
  debug_assert(!has(s1, "complete -c app;>PWNED_cmdname"), "fish: command name emitted unquoted:\n" + s1)
  let s2 = script(
    cli::Command::new("app").arg(cli::Arg::new("m").long("x;>PWNED_fishlong").action(cli::ArgAction::SetTrue)),
    cli::Shell::Fish,
  )
  debug_assert(!has(s2, "-l x;>PWNED_fishlong"), "fish: long flag emitted unquoted after -l:\n" + s2)
}

///| A long flag name is spliced raw into a Bash `case "$prev" in` pattern: `)` closes the pattern and
///| the rest runs as a command when the user completes the value of that flag.
test "p0_bash_long_flag_case_pattern_injection" {
  let s = script(
    cli::Command::new("app").arg(cli::Arg::new("m").long("x)>PWNED_longcase;;y").possible_values(["a"])),
    cli::Shell::Bash,
  )
  debug_assert(!has(s, "--x)>PWNED_longcase;;y)"), "bash: long flag closes the case pattern:\n" + s)
}

///| Subcommand names go raw into Zsh `case "$line[1]" in NAME) ...`: `a)>PWNED;;b` runs on TAB after `a`.
test "p0_zsh_subcommand_case_pattern_injection" {
  let s = script(
    cli::Command::new("app").subcommand(cli::Command::new("a)>PWNED_subcase;;b").about("x")),
    cli::Shell::Zsh,
  )
  debug_assert(!has(s, "a)>PWNED_subcase;;b) "), "zsh: subcommand name closes the case pattern:\n" + s)
}

///| Short flags are written with `write_char(ch)` and no escaping at all.
///| `.short('\'')` -> zsh `'-'[...]'` (zsh -n: unmatched '); fish `-s '` (unterminated quote).
test "p0_short_flag_quote_breaks_zsh_and_fish_syntax" {
  let c = cli::Command::new("app").arg(cli::Arg::new("q").short('\'').action(cli::ArgAction::SetTrue))
  let z = script(c, cli::Shell::Zsh)
  debug_assert(!has(z, "'-'["), "zsh: raw quote short flag breaks quoting:\n" + z)
  let f = script(c, cli::Shell::Fish)
  debug_assert(!has(f, "-s '\n"), "fish: raw quote short flag breaks quoting:\n" + f)
}

///| `.short(')')` + possible values -> bash `        -))` (bash -n: syntax error near `)`).
test "p0_short_flag_paren_breaks_bash_syntax" {
  let s = script(
    cli::Command::new("app").arg(cli::Arg::new("q").short(')').possible_values(["a"])),
    cli::Shell::Bash,
  )
  debug_assert(!has(s, "        -))"), "bash: raw `)` short flag breaks the case statement:\n" + s)
}

// ---------------------------------------------------------------------------
// P1: correctness defects
// ---------------------------------------------------------------------------

///| Short flags are matched per UTF-8 byte (`code_unit_at`) against a table keyed by code point, so any
///| non-ASCII short flag can be defined and shown in help but never parsed. clap: `-é` -> uni=true.
test "p1_non_ascii_short_flag_unreachable" {
  let c = cli::Command::new("app")
  .arg(cli::Arg::new("uni").short('é').action(cli::ArgAction::SetTrue))
  .arg(cli::Arg::new("v").short('v').action(cli::ArgAction::Count))
  let r = parse(c, ["-é"])
  debug_assert(is_ok(r), "`-é` must match .short('é') (clap: ok); got " + err_text(r))
  let r2 = parse(c, ["-vé"])
  debug_assert(is_ok(r2), "`-vé` cluster must parse (clap: ok); got " + err_text(r2))
}

///| The unknown-short error is built from a single UTF-8 byte: `-ü` is reported as `-Ã`.
test "p1_unknown_non_ascii_short_error_is_mojibake" {
  let r = parse(cli::Command::new("app"), ["-ü"])
  let t = err_text(r)
  debug_assert(has(t, "'-ü'"), "error must name the real argument '-ü' (clap: unexpected argument '-ü'); got: " + t)
}

///| Every completion escaper re-encodes each UTF-8 byte as a code point (`c.unsafe_to_char()`):
///| all non-ASCII help/about text is double-encoded ("héllo" -> "hÃ©llo") in bash/zsh/fish scripts.
test "p1_completion_double_encodes_utf8" {
  let c = cli::Command::new("app")
  .arg(cli::Arg::new("o").long("out").help("héllo 😀 世界"))
  .subcommand(cli::Command::new("run").about("运行"))
  let z = script(c, cli::Shell::Zsh)
  debug_assert(has(z, "héllo 😀 世界"), "zsh script must keep UTF-8 help text:\n" + z)
  debug_assert(has(z, "运行"), "zsh script must keep UTF-8 about text")
  let f = script(c, cli::Shell::Fish)
  debug_assert(has(f, "héllo 😀 世界"), "fish script must keep UTF-8 help text:\n" + f)
}

///| Help placeholders (`to_ascii_upper` per byte) double-encode non-ASCII ids too.
test "p1_help_placeholder_double_encodes_utf8" {
  let h = cli::Command::new("app").arg(cli::Arg::new("fichier_é").long("fichier")).render_help()
  debug_assert(!has(h, "Ã"), "help placeholder must not contain mojibake:\n" + h)
}

///| `requires` is satisfied by a DEFAULT value (`seen_source != 0`). clap only counts explicit
///| (CLI/env) presence: `--a` with `a.requires("b")`, b has default -> MissingRequiredArgument.
test "p1_requires_satisfied_by_default_value" {
  let c = cli::Command::new("app")
  .arg(cli::Arg::new("a").long("a").action(cli::ArgAction::SetTrue).requires("b"))
  .arg(cli::Arg::new("b").long("b").default_value("x"))
  match parse(c, ["--a"]) {
    Err(cli::CliError::MissingDependency(_, _)) => ()
    r => debug_assert(false, "`--a` without explicit --b must fail like clap; got " + err_text(r))
  }
}

///| `Arg::allow_hyphen_values` is stored but never read: every option swallows the next token, even a
///| defined flag, `--help` or `--`. clap: `--num --flag` / `-o --help` / `--output --` -> "a value is required".
test "p1_allow_hyphen_values_is_a_noop_options_swallow_flags" {
  let c = cli::Command::new("app")
  .arg(cli::Arg::new("num").short('n').long("num"))
  .arg(cli::Arg::new("pattern").long("pattern").allow_hyphen_values(true))
  .arg(cli::Arg::new("flag").long("flag").action(cli::ArgAction::SetTrue))
  debug_assert(!is_ok(parse(c, ["--num", "--flag"])), "--num must not swallow the defined flag --flag")
  debug_assert(!is_ok(parse(c, ["-n", "--help"])), "-n must not swallow --help")
  debug_assert(!is_ok(parse(c, ["--num", "--"])), "--num must not swallow the `--` terminator")
  debug_assert(is_ok(parse(c, ["--pattern", "-x"])), "allow_hyphen_values(true) must still accept -x")
}

///| `--count=VALUE` on Count / SetFalse / negative flags silently ignores VALUE (clap: error).
test "p1_inline_value_on_count_and_negative_flags_silently_ignored" {
  let c = cli::Command::new("app")
  .arg(cli::Arg::new("verbose").long("verbose").action(cli::ArgAction::Count))
  .arg(cli::Arg::new("color").long("color").negative("no-color").action(cli::ArgAction::SetTrue))
  .arg(cli::Arg::new("cache").long("no-cache").action(cli::ArgAction::SetFalse))
  debug_assert(!is_ok(parse(c, ["--verbose=garbage"])), "--verbose=garbage must be rejected")
  debug_assert(!is_ok(parse(c, ["--no-color=garbage"])), "--no-color=garbage must be rejected")
  debug_assert(!is_ok(parse(c, ["--no-cache=garbage"])), "--no-cache=garbage must be rejected")
}

///| No built-in `help` subcommand: `app help run` RUNS `run` (help lands in the positional). clap: prints
///| `app run` help (DisplayHelp). A user asking for help executes the command instead.
test "p1_help_subcommand_executes_target" {
  match parse(sub_spec(), ["help", "run"]) {
    Err(cli::CliError::DisplayHelp(_)) => ()
    r =>
    debug_assert(
      false,
      "`app help run` must display help (clap), not select `run`; got " +
      (match r {
        Ok(m) => "Ok(subcommand=" + m.subcommand_name().unwrap_or("-") + ")"
        Err(e) => cli::cli_error_to_string(e)
      }),
    )
  }
}

///| `get_double` sums digits in doubles and scales by repeated *10 / /10: not correctly rounded.
///| Rust `str::parse::<f64>` / Go `strconv.ParseFloat` are exact (IEEE round-to-nearest).
test "p1_get_double_not_correctly_rounded" {
  // 0x7fefffffffffffff (f64::MAX); Pion: 0x7feffffffffffff9
  debug_assert(dbl_bits("1.7976931348623157e308") == 9218868437227405311L, "f64::MAX misparsed")
  // 0x0010000000000000 (f64::MIN_POSITIVE); Pion: 0x0010000000000003
  debug_assert(dbl_bits("2.2250738585072014e-308") == 4503599627370496L, "MIN_POSITIVE misparsed")
  // 0x43e0000000000000 (2^63); Pion: 0x43e0000000000001
  debug_assert(dbl_bits("9223372036854775807") == 4890909195324358656L, "2^63-1 must round to 2^63")
  // 0x3e5ad7f29abcaf48; Pion: 0x3e5ad7f29abcaf4a
  debug_assert(dbl_bits("2.5e-8") == 4493456761410498376L, "2.5e-8 misparsed")
}

// ---------------------------------------------------------------------------
// P2: lesser defects
// ---------------------------------------------------------------------------

///| Subcommand help is rendered from the child `Command` alone: usage loses the parent path and the
///| inherited global options are not listed. clap: `Usage: app run [OPTIONS]` + `-v, --verbose`.
test "p2_subcommand_help_loses_parent_path_and_globals" {
  match parse(sub_spec(), ["run", "--help"]) {
    Err(cli::CliError::DisplayHelp(h)) => {
      debug_assert(has(h, "Usage: app run"), "usage must include the parent path:\n" + h)
      debug_assert(has(h, "--verbose"), "global --verbose must be listed in subcommand help:\n" + h)
    }
    r => debug_assert(false, "expected DisplayHelp, got " + err_text(r))
  }
}

///| `--help=foo` -> "unexpected argument '--help' ... did you mean '--help'?" (self-suggestion).
test "p2_help_with_inline_value_suggests_itself" {
  match parse(cli::Command::new("app"), ["--help=foo"]) {
    Err(cli::CliError::UnknownArgument(a, Some(s))) =>
    debug_assert(a != s, "suggests the very flag it rejects: '" + a + "' -> '" + s + "'")
    _ => ()
  }
}

///| Distance threshold 2 for tokens <= 5 bytes: any 1-2 char typo "suggests" any short subcommand.
test "p2_suggestion_noise_for_short_names" {
  match parse(sub_spec(), ["deep", "zz"]) {
    Err(cli::CliError::UnknownSubcommand(_, Some(s))) =>
    debug_assert(false, "`zz` should not suggest unrelated subcommand '" + s + "' (clap: no tip)")
    _ => ()
  }
}

///| Global args are not offered by completions inside subcommands (clap_complete propagates them).
test "p2_completion_omits_global_args_in_subcommands" {
  let c = cli::Command::new("app")
  .arg(cli::Arg::new("g").long("global-opt").action(cli::ArgAction::SetTrue).global(true))
  .subcommand(cli::Command::new("run").arg(cli::Arg::new("l").long("local").action(cli::ArgAction::SetTrue)))
  let s = script(c, cli::Shell::Bash)
  debug_assert(has(s, "'--local --global-opt"), "bash: `app run <TAB>` must offer --global-opt:\n" + s)
}

///| `a-b` and `a_b` sanitize to the same function/case key: zsh defines `_app__a_b` twice (the second
///| silently replaces the first) and bash has two identical `app__a_b)` arms (the second is dead).
test "p2_completion_identifier_collision" {
  let c = cli::Command::new("app")
  .subcommand(cli::Command::new("a-b").arg(cli::Arg::new("one").long("only-ab").action(cli::ArgAction::SetTrue)))
  .subcommand(cli::Command::new("a_b").arg(cli::Arg::new("two").long("only-a_b").action(cli::ArgAction::SetTrue)))
  let z = script(c, cli::Shell::Zsh)
  debug_assert(z == "" || count_of(z, "_app__a_b() {") <= 1, "zsh: duplicate function _app__a_b:\n" + z)
  let b = script(c, cli::Shell::Bash)
  debug_assert(b == "" || count_of(b, "    app__a_b)\n") <= 1, "bash: duplicate case arm app__a_b:\n" + b)
}

///| A possible value containing a space or parentheses is split / dropped in all three shells
///| (zsh `(two words (x))` -> candidates `two`, `words`, `(x)` silently lost).
test "p2_completion_possible_value_with_space_is_split" {
  let c = cli::Command::new("app").arg(cli::Arg::new("m").long("mode").possible_values(["two words", "(x)"]))
  let z = script(c, cli::Shell::Zsh)
  debug_assert(!has(z, ":(two words (x))"), "zsh: values must be escaped as single words:\n" + z)
}

///| A self-conflicting arg is accepted at definition time and then makes every use fail at runtime.
///| (clap: debug-assert "Argument 'a' cannot conflict with itself".)
test "p2_self_conflict_not_rejected_at_definition" {
  let c = cli::Command::new("app").arg(cli::Arg::new("a").long("a").action(cli::ArgAction::SetTrue).conflicts_with("a"))
  match c.validate() {
    Err(_) => ()
    Ok(_) => debug_assert(false, "self conflicts_with must be rejected; runtime: " + err_text(parse(c, ["--a"])))
  }
}

// ---------------------------------------------------------------------------
// div_: clap 4.5.32 semantics where Pion differs (see REPORT.md for which side is preferable)
// ---------------------------------------------------------------------------

///| Pion accepts `-3`, `-3.14`, `-1e5`, `-.5` as positionals by default; clap and pflag reject them
///| (clap needs `allow_negative_numbers(true)`).
test "div_negative_numbers_are_positionals_by_default" {
  let c = cli::Command::new("app").arg(cli::Arg::new("files").multiple(true))
  debug_assert(!is_ok(parse(c, ["-3"])), "clap: unexpected argument '-3'")
}

///| Repeated single-value option / SetTrue: Pion last-wins (= pflag); clap 4.5 errors
///| "the argument '--output <OUTPUT>' cannot be used multiple times".
test "div_repeated_single_value_option_last_wins" {
  let c = cli::Command::new("app").arg(cli::Arg::new("o").long("output"))
  debug_assert(!is_ok(parse(c, ["--output", "a", "--output", "b"])), "clap: cannot be used multiple times")
}

///| `--flag=true|1|yes` and env `1|0|yes|no|on|off|TRUE` are accepted; clap's SetTrue takes no inline
///| value and its env parser accepts only `true`/`false`.
test "div_bool_values_lenient" {
  let c = cli::Command::new("app").arg(
    cli::Arg::new("f").long("flag").action(cli::ArgAction::SetTrue).env("APP_F"),
  )
  debug_assert(!is_ok(parse(c, ["--flag=yes"])), "clap: unexpected value 'yes' for '--flag'")
  let env : Map[String, String] = Map::new()
  env.set("APP_F", "1")
  debug_assert(!is_ok(c.parse_with_env([], env)), "clap: invalid value '1' for '--flag'")
}

///| Global Count accumulates across levels in Pion (`-v run -v` = 2); clap reports 1 at every level.
test "div_global_count_accumulates_across_levels" {
  match parse(sub_spec(), ["-v", "run", "-v"]) {
    Ok(m) => debug_assert(m.get_count("verbose") == 1, "clap: verbose=1; pion=" + m.get_count("verbose").to_string())
    Err(e) => debug_assert(false, cli::cli_error_to_string(e))
  }
}

///| Depth > 64 is an InvalidDefinition (stack-safety by design); clap parses 1,000 levels.
test "div_subcommand_depth_limit_64" {
  let mut c = cli::Command::new("l65")
  let mut d = 64
  while d >= 0 {
    c = cli::Command::new("l" + d.to_string()).subcommand(c)
    d = d - 1
  }
  debug_assert(c.validate() is Ok(_), "clap accepts 65-level trees")
}

///| `inf`, `NaN`, `infinity` are rejected by get_double; Rust f64::from_str and Go ParseFloat accept them.
test "div_get_double_rejects_inf_nan" {
  debug_assert(dbl_bits("inf") == 9218868437227405312L, "Rust: \"inf\".parse::<f64>() == +inf")
}

// ---------------------------------------------------------------------------
// ctl_: probes where Pion is correct / matches clap (expected PASS)
// ---------------------------------------------------------------------------

///| Metacharacters confined to help/about/value_name text are escaped correctly in all three shells
///| (shell-verified by run_audit.sh: bash -n / zsh -n OK, no PWNED_desc file after source + TAB).
test "ctl_description_metacharacters_escaped" {
  let evil = "q' d\" $(touch PWNED_desc) `touch PWNED_desc2` ; rm -rf / \\ \n \r [x] a:b 100% \t end"
  let c = cli::Command::new("app")
  .about(evil)
  .arg(cli::Arg::new("o").short('o').long("out").help(evil).value_name(evil))
  .subcommand(cli::Command::new("run").about(evil))
  let b = script(c, cli::Shell::Bash)
  let z = script(c, cli::Shell::Zsh)
  let f = script(c, cli::Shell::Fish)
  debug_assert(!has(b, "PWNED_desc"), "bash never emits help text")
  debug_assert(has(z, "q'\\'' d\""), "zsh: single quote escaped as '\\''")
  debug_assert(has(f, "q\\' d"), "fish: single quote escaped as \\'")
  debug_assert(!has(z, "\n \r") && !has(f, "\n \r"), "newlines/CR flattened")
}

///| Empty env value is a value (clap 4.5.32 agrees: APP_NAME="" -> name="" from env).
test "ctl_empty_env_value_overrides_default_like_clap" {
  let c = cli::Command::new("app").arg(cli::Arg::new("name").long("name").env("APP_NAME").default_value("dflt"))
  let env : Map[String, String] = Map::new()
  env.set("APP_NAME", "")
  match c.parse_with_env([], env) {
    Ok(m) => debug_assert(m.get_string("name").unwrap_or("<none>") == "", "env empty string wins over default (clap too)")
    Err(e) => debug_assert(false, cli::cli_error_to_string(e))
  }
}

///| `-o=` / `-o ""` / `-oé` / `-o😀` / `--list a,,b` / `--list ""` match clap byte-for-byte.
test "ctl_short_values_and_delimiters_match_clap" {
  let c = cli::Command::new("app")
  .arg(cli::Arg::new("o").short('o'))
  .arg(cli::Arg::new("l").long("list").action(cli::ArgAction::Append).value_delimiter(','))
  match parse(c, ["-o="]) {
    Ok(m) => debug_assert(m.get_string("o").unwrap_or("<none>") == "", "-o= -> empty")
    Err(e) => debug_assert(false, cli::cli_error_to_string(e))
  }
  match parse(c, ["-o😀"]) {
    Ok(m) => debug_assert(m.get_string("o").unwrap_or("<none>") == "😀", "-o😀 keeps 4-byte char intact")
    Err(e) => debug_assert(false, cli::cli_error_to_string(e))
  }
  match parse(c, ["--list", "a,,b", "--list", "c,"]) {
    Ok(m) =>
    match m.get_many("l") {
      Some(v) => debug_assert(v.length() == 5 && v[1] == "" && v[4] == "", "a,,b + c, -> [a,,b,c,]")
      None => debug_assert(false, "no list")
    }
    Err(e) => debug_assert(false, cli::cli_error_to_string(e))
  }
}

///| Hidden args stay parseable but are never suggested (clap 4.5.32 DOES suggest hidden `--secret`).
test "ctl_hidden_arg_not_suggested" {
  let c = cli::Command::new("app").arg(cli::Arg::new("s").long("secret").action(cli::ArgAction::SetTrue).hide(true))
  debug_assert(is_ok(parse(c, ["--secret"])), "hidden still parses")
  match parse(c, ["--secre"]) {
    Err(cli::CliError::UnknownArgument(_, None)) => ()
    r => debug_assert(false, "hidden must not be suggested: " + err_text(r))
  }
}

///| `requires` on a global given at the parent level is satisfied in the child (clap 4.5.32 wrongly
///| reports MissingRequiredArgument for `--cfg c run --x`).
test "ctl_requires_global_from_parent_level" {
  debug_assert(is_ok(parse(sub_spec(), ["--cfg", "c", "run", "--x"])), "global set before subcommand satisfies requires")
}

///| Cyclic / self `requires` are rejected at definition time (no hang, no stack overflow).
test "ctl_cyclic_and_self_requires_rejected" {
  let cyc = cli::Command::new("app")
  .arg(cli::Arg::new("a").long("a").requires("b"))
  .arg(cli::Arg::new("b").long("b").requires("a"))
  debug_assert(!(cyc.validate() is Ok(_)), "A<->B cycle rejected")
  let selfreq = cli::Command::new("app").arg(cli::Arg::new("a").long("a").requires("a"))
  debug_assert(!(selfreq.validate() is Ok(_)), "self requires rejected")
}

///| Overlong unknown flag (1 MB) is pruned by length before Damerau-Levenshtein (no quadratic blowup).
test "ctl_overlong_unknown_flag_pruned" {
  let sb = StringBuilder::new()
  sb.write_string("--")
  let mut i = 0
  while i < 1000000 {
    sb.write_string("x")
    i = i + 1
  }
  match parse(cli::Command::new("app").arg(cli::Arg::new("o").long("output")), [sb.to_string()]) {
    Err(cli::CliError::UnknownArgument(_, None)) => ()
    r => debug_assert(false, "expected UnknownArgument without suggestion: " + err_text(r))
  }
}

///| 65-level trees / 1,000-level trees return InvalidDefinition instead of overflowing the stack.
test "ctl_deep_tree_is_an_error_not_a_crash" {
  let mut c = cli::Command::new("leaf")
  let mut d = 0
  while d < 1000 {
    c = cli::Command::new("n" + d.to_string()).subcommand(c)
    d = d + 1
  }
  match c.validate() {
    Err(cli::CliError::InvalidDefinition(_)) => ()
    _ => debug_assert(false, "1000-level tree must be rejected")
  }
  match cli::generate_completions(c, cli::Shell::Zsh) {
    Err(_) => ()
    Ok(_) => debug_assert(false, "completions for a 1000-level tree must be rejected")
  }
}

///| Int / Int64 boundaries and signs match Rust `str::parse` exactly.
test "ctl_int_boundaries_match_rust" {
  let c = cli::Command::new("t").arg(cli::Arg::new("x").long("x"))
  let cases : Array[(String, Bool, Bool)] = [
    ("2147483647", true, true),
    ("2147483648", false, true),
    ("-2147483648", true, true),
    ("-2147483649", false, true),
    ("9223372036854775807", false, true),
    ("9223372036854775808", false, false),
    ("-9223372036854775808", false, true),
    ("-9223372036854775809", false, false),
    ("+1", true, true),
    ("01", true, true),
    (" 1", false, false),
    ("0x10", false, false),
    ("1_000", false, false),
  ]
  let mut i = 0
  while i < cases.length() {
    let (s, ok32, ok64) = cases[i]
    match c.parse(["--x", s]) {
      Ok(m) => {
        debug_assert((m.get_int("x") is Ok(_)) == ok32, "get_int(" + s + ")")
        debug_assert((m.get_int64("x") is Ok(_)) == ok64, "get_int64(" + s + ")")
      }
      Err(e) => debug_assert(false, cli::cli_error_to_string(e))
    }
    i = i + 1
  }
}
