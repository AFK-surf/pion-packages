///| Red-team probe for `packages/cli`.
///|
///| Modes (stdout is the evidence; identical line format to `oracle/rust` and `oracle/go`):
///| - `diff <cases.tsv>`: each line `spec<TAB>envhex<TAB>arghex...`, prints `<n><TAB><canonical result>`.
///| - `typed <values.txt>`: each line is a hex string; prints Int / Int64 / Double getter results.
///| - `compl <bash|zsh|fish> <spec>`: prints the generated completion script for a hostile spec.
///| - `help <spec>`: prints `render_help` + `render_long_help` for a spec.
///| - `dos <workload> <n>`: adversarial workloads (timed externally), prints a stable digest.

import "cli"

///|
fn hexval(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    0
  }
}

///|
fn unhex(h : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i + 1 < h.length() {
    sb.write_byte(((hexval(h.code_unit_at(i)) << 4) | hexval(h.code_unit_at(i + 1))).to_byte())
    i = i + 2
  }
  sb.to_string()
}

///|
fn hexdig(d : Int) -> Byte {
  if d < 10 {
    (48 + d).to_byte()
  } else {
    (87 + d).to_byte()
  }
}

///| Escape for canonical output: bytes outside 0x21..0x7e and `\ , [ ] =` become `\xHH`.
fn esc(sb : StringBuilder, s : String) -> Unit {
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i)
    if b < 0x21 || b > 0x7e || b == 92 || b == 44 || b == 91 || b == 93 || b == 61 {
      sb.write_string("\\x")
      sb.write_byte(hexdig((b >> 4) & 15))
      sb.write_byte(hexdig(b & 15))
    } else {
      sb.write_byte(b.to_byte())
    }
    i = i + 1
  }
}

///|
fn split_on(s : String, sep : Int) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == sep {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(start, s.length()))
  out
}

///| Spec table shared with the Rust/Go oracles: `<id>:<C|F|V>` per command.
fn spec_basic() -> cli::Command {
  cli::Command::new("app")
  .arg(cli::Arg::new("verbose").short('v').long("verbose").action(cli::ArgAction::Count))
  .arg(cli::Arg::new("output").short('o').long("output"))
  .arg(cli::Arg::new("pattern").short('p').long("pattern").allow_hyphen_values(true))
  .arg(cli::Arg::new("num").short('n').long("num"))
  .arg(cli::Arg::new("flag").short('f').long("flag").action(cli::ArgAction::SetTrue))
  .arg(cli::Arg::new("five").short('5').action(cli::ArgAction::SetTrue))
  .arg(cli::Arg::new("list").short('l').long("list").action(cli::ArgAction::Append).value_delimiter(','))
  .arg(cli::Arg::new("mode").short('m').long("mode").possible_values(["fast", "slow"]))
  .arg(cli::Arg::new("uni").short('é').action(cli::ArgAction::SetTrue))
  .arg(cli::Arg::new("secret").long("secret").action(cli::ArgAction::SetTrue).hide(true))
  .arg(cli::Arg::new("files").multiple(true))
}

///|
fn ids_basic() -> Array[String] {
  [
    "verbose:C", "output:V", "pattern:V", "num:V", "flag:F", "five:F", "list:V", "mode:V", "uni:F",
    "secret:F", "files:V",
  ]
}

///|
fn spec_env() -> cli::Command {
  cli::Command::new("app")
  .arg(cli::Arg::new("color").long("color").action(cli::ArgAction::SetTrue).env("APP_COLOR"))
  .arg(cli::Arg::new("name").long("name").env("APP_NAME").default_value("dflt"))
  .arg(cli::Arg::new("tags").long("tags").action(cli::ArgAction::Append).value_delimiter(',').env("APP_TAGS"))
  .arg(cli::Arg::new("a").long("a").action(cli::ArgAction::SetTrue).requires("b"))
  .arg(cli::Arg::new("b").long("b").default_value("x"))
  .arg(cli::Arg::new("c").long("c").action(cli::ArgAction::SetTrue).conflicts_with("d"))
  .arg(cli::Arg::new("d").long("d").action(cli::ArgAction::SetTrue).env("APP_D"))
  .arg(cli::Arg::new("e").long("e").requires("name"))
}

///|
fn ids_env() -> Array[String] {
  ["color:F", "name:V", "tags:V", "a:F", "b:V", "c:F", "d:F", "e:V"]
}

///|
fn spec_sub() -> cli::Command {
  cli::Command::new("app")
  .version("1.0")
  .about("Root")
  .arg(cli::Arg::new("verbose").short('v').long("verbose").action(cli::ArgAction::Count).global(true))
  .arg(cli::Arg::new("cfg").long("cfg").global(true))
  .arg(cli::Arg::new("pos"))
  .subcommand(
    cli::Command::new("run")
    .about("Run")
    .arg(cli::Arg::new("x").long("x").action(cli::ArgAction::SetTrue).requires("cfg"))
    .arg(cli::Arg::new("out").short('o').long("out")),
  )
  .subcommand(
    cli::Command::new("deep")
    .about("Deep")
    .subcommand(
      cli::Command::new("a").subcommand(
        cli::Command::new("b").arg(cli::Arg::new("z").long("z").action(cli::ArgAction::SetTrue)),
      ),
    ),
  )
}

///|
fn ids_for(spec : String, sub : String) -> Array[String] {
  if spec == "basic" {
    ids_basic()
  } else if spec == "env" {
    ids_env()
  } else if sub == "" {
    ["verbose:C", "cfg:V", "pos:V"]
  } else if sub == "run" {
    ["verbose:C", "cfg:V", "x:F", "out:V"]
  } else if sub == "b" {
    ["verbose:C", "cfg:V", "z:F"]
  } else {
    ["verbose:C", "cfg:V"]
  }
}

///|
fn spec_for(spec : String) -> cli::Command {
  if spec == "basic" {
    spec_basic()
  } else if spec == "env" {
    spec_env()
  } else {
    spec_sub()
  }
}

///|
fn write_matches(sb : StringBuilder, spec : String, sub : String, m : cli::ArgMatches) -> Unit {
  let ids = ids_for(spec, sub)
  let mut i = 0
  while i < ids.length() {
    let parts = split_on(ids[i], 58)
    let id = parts[0]
    let kind = parts[1]
    if kind == "C" {
      sb.write_string(" " + id + "=" + m.get_count(id).to_string())
    } else if kind == "F" {
      sb.write_string(" " + id + "=" + (if m.get_flag(id) { "true" } else { "false" }))
    } else {
      match m.get_many(id) {
        Some(vs) => {
          sb.write_string(" " + id + "=[")
          let mut k = 0
          while k < vs.length() {
            if k > 0 {
              sb.write_string(",")
            }
            esc(sb, vs[k])
            k = k + 1
          }
          sb.write_string("]@")
          sb.write_string(
            match m.value_source(id) {
              Some(cli::ValueSource::CommandLine) => "cli"
              Some(cli::ValueSource::EnvVariable) => "env"
              Some(cli::ValueSource::DefaultValue) => "default"
              None => "?"
            },
          )
        }
        None => ()
      }
    }
    i = i + 1
  }
  match m.subcommand() {
    Some((name, sm)) => {
      sb.write_string(" sub=" + name + " {")
      write_matches(sb, spec, name, sm)
      sb.write_string(" }")
    }
    None => ()
  }
}

///|
fn usage_line(s : String) -> String {
  let lines = split_on(s, 10)
  let mut i = 0
  while i < lines.length() {
    if lines[i].length() >= 6 && lines[i].slice(0, 6) == "Usage:" {
      return lines[i]
    }
    i = i + 1
  }
  "<no usage>"
}

///|
fn write_err(sb : StringBuilder, e : cli::CliError) -> Unit {
  match e {
    cli::CliError::DisplayHelp(s) => {
      sb.write_string("HELP ")
      esc(sb, usage_line(s))
    }
    cli::CliError::DisplayVersion(s) => {
      sb.write_string("VERSION ")
      esc(sb, s)
    }
    cli::CliError::UnknownArgument(_, sug) => {
      sb.write_string("ERR unknown_argument sug=")
      match sug {
        Some(x) => esc(sb, x)
        None => sb.write_string("-")
      }
    }
    cli::CliError::UnexpectedArgument(_) => sb.write_string("ERR unknown_argument sug=-")
    cli::CliError::UnknownSubcommand(_, sug) => {
      sb.write_string("ERR invalid_subcommand sug=")
      match sug {
        Some(x) => esc(sb, x)
        None => sb.write_string("-")
      }
    }
    cli::CliError::MissingValue(_) => sb.write_string("ERR invalid_value")
    cli::CliError::InvalidValue(_, _, _) => sb.write_string("ERR invalid_value")
    cli::CliError::MissingRequired(id) =>
    if id == "subcommand" {
      sb.write_string("ERR missing_subcommand")
    } else {
      sb.write_string("ERR missing_required")
    }
    cli::CliError::MissingDependency(_, _) => sb.write_string("ERR missing_required")
    cli::CliError::Conflict(_, _) => sb.write_string("ERR argument_conflict")
    cli::CliError::InvalidDefinition(_) => sb.write_string("ERR invalid_definition")
  }
}

///|
fn run_diff(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 2
  }
  let lines = split_on(content, 10)
  let sb = StringBuilder::new()
  let mut n = 0
  while n < lines.length() {
    let line = lines[n]
    if line.length() > 0 {
      let f = split_on(line, 9)
      let spec = f[0]
      let env : Map[String, String] = Map::new()
      if f[1].length() > 0 {
        let kvs = split_on(unhex(f[1]), 31)
        let mut k = 0
        while k < kvs.length() {
          let kv = kvs[k]
          let mut eq = 0
          while eq < kv.length() && kv.code_unit_at(eq) != 61 {
            eq = eq + 1
          }
          env.set(kv.slice(0, eq), kv.slice(eq + 1, kv.length()))
          k = k + 1
        }
      }
      let args : Array[String] = []
      let mut a = 2
      while a < f.length() {
        args.push(unhex(f[a]))
        a = a + 1
      }
      sb.write_string(n.to_string())
      sb.write_string("\t")
      match spec_for(spec).parse_with_env(args, env) {
        Ok(m) => {
          sb.write_string("OK")
          write_matches(sb, spec, "", m)
        }
        Err(e) => write_err(sb, e)
      }
      sb.write_string("\n")
    }
    n = n + 1
  }
  io_print(world, sb.to_string())
  0
}

///|
fn write_hex64(sb : StringBuilder, x : Int64) -> Unit {
  let mut sh = 60
  while sh >= 0 {
    sb.write_byte(hexdig(((x >> sh) & 15L).to_int()))
    sh = sh - 4
  }
}

///|
fn run_typed(world : World, path : String) -> Int {
  let content = match fs_read(world, path) {
    Ok(s) => s
    Err(_) => return 2
  }
  let lines = split_on(content, 10)
  let sb = StringBuilder::new()
  let mut n = 0
  while n < lines.length() {
    if lines[n].length() > 0 {
      let v = unhex(lines[n])
      let m = match cli::Command::new("t").arg(cli::Arg::new("x").long("x")).parse(["--x", v]) {
        Ok(m) => m
        Err(_) => return 3
      }
      sb.write_string("[")
      esc(sb, v)
      sb.write_string("] i32=")
      match m.get_int("x") {
        Ok(Some(i)) => sb.write_string(i.to_string())
        _ => sb.write_string("ERR")
      }
      sb.write_string(" i64=")
      match m.get_int64("x") {
        Ok(Some(i)) => sb.write_string(i.to_string())
        _ => sb.write_string("ERR")
      }
      sb.write_string(" f64=")
      match m.get_double("x") {
        Ok(Some(d)) =>
        if d != d {
          sb.write_string("NaN")
        } else {
          write_hex64(sb, d.reinterpret_as_uint64().reinterpret_as_int64())
        }
        _ => sb.write_string("ERR")
      }
      sb.write_string("\n")
    }
    n = n + 1
  }
  io_print(world, sb.to_string())
  0
}

///| Hostile command definitions for completion-script attacks.
fn evil_spec(name : String) -> cli::Command {
  if name == "pv_cmdsub" {
    // possible_values carrying command substitutions
    cli::Command::new("app").arg(
      cli::Arg::new("mode")
      .long("mode")
      .possible_values(["$(touch PWNED_pv_dollar)", "`touch PWNED_pv_tick`", "safe"]),
    )
  } else if name == "cmdname" {
    // binary name with a shell metacharacter
    cli::Command::new("app;>PWNED_cmdname").arg(cli::Arg::new("v").long("verbose").action(cli::ArgAction::SetTrue))
  } else if name == "longcase" {
    // long flag name that closes the `case` pattern in Bash
    cli::Command::new("app").arg(cli::Arg::new("m").long("x)>PWNED_longcase;;y").possible_values(["a"]))
  } else if name == "fishlong" {
    // long flag name with `;` (unquoted in Bash words list / Fish `-l`)
    cli::Command::new("app").arg(cli::Arg::new("m").long("x;>PWNED_fishlong").action(cli::ArgAction::SetTrue))
  } else if name == "short_quote" {
    cli::Command::new("app").arg(cli::Arg::new("q").short('\'').action(cli::ArgAction::SetTrue))
  } else if name == "short_paren" {
    cli::Command::new("app").arg(cli::Arg::new("q").short(')').possible_values(["a"]))
  } else if name == "subcase" {
    // subcommand name that closes the Zsh `case "$line[1]"` pattern
    cli::Command::new("app").subcommand(cli::Command::new("a)>PWNED_subcase;;b").about("x"))
  } else if name == "pv_space" {
    // possible value with a space / parens: one value must stay one candidate
    cli::Command::new("app").arg(
      cli::Arg::new("mode").long("mode").possible_values(["two words", "(x)", "a:b"]),
    )
  } else if name == "desc_safe" {
    // CONTROL: every metacharacter only in help/about/value_name text
    let evil = "q' d\" $(touch PWNED_desc) `touch PWNED_desc2` ; rm -rf / \\ \n \r [x] a:b 100% \t end"
    cli::Command::new("app")
    .about(evil)
    .arg(cli::Arg::new("o").short('o').long("out").help(evil).value_name(evil))
    .arg(cli::Arg::new("f").long("flag").negative("no-flag").action(cli::ArgAction::SetTrue).help(evil))
    .subcommand(cli::Command::new("run").about(evil).arg(cli::Arg::new("z").long("zz").help(evil)))
  } else if name == "utf8" {
    cli::Command::new("app")
    .about("Ünïcödé 😀")
    .arg(cli::Arg::new("o").long("out").help("héllo 😀 世界"))
    .subcommand(cli::Command::new("run").about("运行 😀"))
  } else if name == "global" {
    // global flag must be completable after a subcommand (clap_complete does this)
    cli::Command::new("app")
    .arg(cli::Arg::new("g").long("global-opt").action(cli::ArgAction::SetTrue).global(true))
    .subcommand(cli::Command::new("run").arg(cli::Arg::new("l").long("local").action(cli::ArgAction::SetTrue)))
  } else if name == "collide" {
    // two distinct subcommands sanitized to the same shell identifier
    cli::Command::new("app")
    .subcommand(cli::Command::new("a-b").arg(cli::Arg::new("one").long("only-ab").action(cli::ArgAction::SetTrue)))
    .subcommand(cli::Command::new("a_b").arg(cli::Arg::new("two").long("only-a_b").action(cli::ArgAction::SetTrue)))
  } else {
    cli::Command::new("app")
  }
}

///|
fn run_compl(world : World, shell : String, spec : String) -> Int {
  let sh = if shell == "bash" {
    cli::Shell::Bash
  } else if shell == "zsh" {
    cli::Shell::Zsh
  } else {
    cli::Shell::Fish
  }
  match cli::generate_completions(evil_spec(spec), sh) {
    Ok(s) => {
      io_print(world, s)
      0
    }
    Err(e) => {
      io_println(world, "ERR " + cli::cli_error_to_string(e))
      1
    }
  }
}

///|
fn run_help(world : World, spec : String) -> Int {
  let c = if spec == "utf8" || spec == "desc_safe" { evil_spec(spec) } else { spec_for(spec) }
  io_print(world, c.render_help())
  io_print(world, "----\n")
  io_print(world, c.render_long_help())
  match spec_for(spec).parse(["run", "--help"]) {
    Err(cli::CliError::DisplayHelp(s)) => {
      io_print(world, "---- run --help\n")
      io_print(world, s)
    }
    _ => ()
  }
  0
}

///|
fn rep(c : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(c)
    i = i + 1
  }
  sb.to_string()
}

///| Adversarial workloads; argument `n` scales the input.
fn run_dos(world : World, w : String, n : Int) -> Int {
  if w == "build_args" {
    // Build (only) a command with n options through the public builder.
    let mut c = cli::Command::new("big")
    let mut i = 0
    while i < n {
      c = c.arg(cli::Arg::new("o" + i.to_string()).long("opt-" + i.to_string()))
      i = i + 1
    }
    io_println(world, "args=" + c.args_list.length().to_string())
  } else if w == "build_subs" {
    let mut c = cli::Command::new("big")
    let mut i = 0
    while i < n {
      c = c.subcommand(cli::Command::new("s" + i.to_string()))
      i = i + 1
    }
    io_println(world, "subs=" + c.subcommands_list.length().to_string())
  } else if w == "build_parse" {
    // Cold start: build n options + compile + one parse (clap: build + try_get_matches_from).
    let list : Array[cli::Arg] = []
    let mut i = 0
    while i < n {
      list.push(cli::Arg::new("o" + i.to_string()).long("opt-" + i.to_string()))
      i = i + 1
    }
    let c = cli::Command::new("big").args(list)
    match c.parse(["--opt-" + (n - 1).to_string(), "v"]) {
      Ok(m) => io_println(world, "ok=" + m.get_string("o" + (n - 1).to_string()).unwrap_or("?"))
      Err(_) => io_println(world, "err")
    }
  } else if w == "typo_many" {
    // n options, 1,000 mistyped lookups (suggestion against every candidate).
    let list : Array[cli::Arg] = []
    let mut i = 0
    while i < n {
      list.push(cli::Arg::new("o" + i.to_string()).long("option-name-" + i.to_string()))
      i = i + 1
    }
    let cc = match cli::Command::new("big").args(list).compile() {
      Ok(c) => c
      Err(_) => return 3
    }
    let mut hits = 0
    let mut r = 0
    while r < 1000 {
      match cc.parse(["--optoin-name-" + (r % n).to_string()]) {
        Err(cli::CliError::UnknownArgument(_, Some(_))) => hits = hits + 1
        _ => ()
      }
      r = r + 1
    }
    io_println(world, "hits=" + hits.to_string())
  } else if w == "typo_long" {
    // One unknown flag of n bytes against 30 normal options (O(1) pruning claim).
    let list : Array[cli::Arg] = []
    let mut i = 0
    while i < 30 {
      list.push(cli::Arg::new("o" + i.to_string()).long("opt-" + i.to_string()))
      i = i + 1
    }
    let cc = match cli::Command::new("big").args(list).compile() {
      Ok(c) => c
      Err(_) => return 3
    }
    match cc.parse(["--" + rep("x", n)]) {
      Err(cli::CliError::UnknownArgument(a, _)) => io_println(world, "len=" + a.length().to_string())
      _ => io_println(world, "?")
    }
  } else if w == "typo_longcand" {
    // Candidates with n-byte long names and an n-byte typo: DL is O(n^2) per candidate.
    let list : Array[cli::Arg] = []
    let mut i = 0
    while i < 20 {
      list.push(cli::Arg::new("o" + i.to_string()).long(rep("a", n) + i.to_string()))
      i = i + 1
    }
    let cc = match cli::Command::new("big").args(list).compile() {
      Ok(c) => c
      Err(_) => return 3
    }
    match cc.parse(["--" + rep("b", n) + "0"]) {
      Err(cli::CliError::UnknownArgument(_, s)) => io_println(world, "sug=" + s.unwrap_or("-").length().to_string())
      _ => io_println(world, "?")
    }
  } else if w == "deep" {
    // n-level nested subcommands: compile + parse full path.
    let mut c = cli::Command::new("l" + n.to_string())
    let mut d = n - 1
    while d >= 0 {
      c = cli::Command::new("l" + d.to_string()).subcommand(c)
      d = d - 1
    }
    let path : Array[String] = []
    let mut k = 1
    while k <= n {
      path.push("l" + k.to_string())
      k = k + 1
    }
    match c.parse(path) {
      Ok(_) => io_println(world, "ok")
      Err(e) => io_println(world, cli::cli_error_to_string(e))
    }
  } else if w == "many_args" {
    // n positional tokens + n/2 flags in one parse.
    let cc = match
    cli::Command::new("bulk")
    .arg(cli::Arg::new("v").short('v').action(cli::ArgAction::Count))
    .arg(cli::Arg::new("files").multiple(true))
    .compile() {
      Ok(c) => c
      Err(_) => return 3
    }
    let argv : Array[String] = []
    let mut i = 0
    while i < n {
      argv.push(if i % 2 == 0 { "-v" } else { "f" + i.to_string() })
      i = i + 1
    }
    match cc.parse(argv) {
      Ok(m) => io_println(world, "v=" + m.get_count("v").to_string())
      Err(_) => io_println(world, "err")
    }
  } else if w == "compl" {
    // Completion generation for a command with n options x 3 shells.
    let list : Array[cli::Arg] = []
    let mut i = 0
    while i < n {
      list.push(cli::Arg::new("o" + i.to_string()).long("opt-" + i.to_string()).help("Option number " + i.to_string()))
      i = i + 1
    }
    let c = cli::Command::new("big").args(list)
    let mut total = 0
    match cli::generate_completions(c, cli::Shell::Bash) {
      Ok(s) => total = total + s.length()
      Err(_) => ()
    }
    match cli::generate_completions(c, cli::Shell::Zsh) {
      Ok(s) => total = total + s.length()
      Err(_) => ()
    }
    match cli::generate_completions(c, cli::Shell::Fish) {
      Ok(s) => total = total + s.length()
      Err(_) => ()
    }
    io_println(world, "bytes=" + total.to_string())
  } else if w == "help_long" {
    // Help rendering with n options with env/default/possible values (long help).
    let list : Array[cli::Arg] = []
    let mut i = 0
    while i < n {
      list.push(
        cli::Arg::new("o" + i.to_string())
        .long("opt-" + i.to_string())
        .help("Option " + i.to_string())
        .env("ENV_" + i.to_string())
        .default_value("d")
        .possible_values(["d", "e", "f"]),
      )
      i = i + 1
    }
    io_println(world, "len=" + cli::Command::new("big").args(list).render_long_help().length().to_string())
  } else {
    return 2
  }
  0
}

///|
fn parse_pos_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  v
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 3 {
    io_println(world, "usage: probe <diff|typed|compl|help|dos> ...")
    return 1
  }
  let mode = args[1]
  if mode == "diff" {
    run_diff(world, args[2])
  } else if mode == "typed" {
    run_typed(world, args[2])
  } else if mode == "compl" && args.length() >= 4 {
    run_compl(world, args[2], args[3])
  } else if mode == "help" {
    run_help(world, args[2])
  } else if mode == "dos" && args.length() >= 4 {
    run_dos(world, args[2], parse_pos_int(args[3]))
  } else {
    1
  }
}
