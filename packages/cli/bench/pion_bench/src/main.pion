///| Head-to-head benchmark harness for `packages/cli` (W1 complex 50k, W2 100k batch, W3 typo+help 20k).

import "cli"

///|
fn build_complex_cli() -> cli::Command {
  let mut root = cli::Command::new("cloudctl")
  .version("1.0.0")
  .about("Cloud cluster management CLI")
  .arg(cli::Arg::new("verbose").short('v').long("verbose").action(cli::ArgAction::Count).global(true).help("Increase verbosity"))
  .arg(cli::Arg::new("region").short('r').long("region").default_value("us-east-1").global(true).help("Cloud region"))
  .arg(cli::Arg::new("output").short('o').long("output").default_value("text").help("Output format"))
  .arg(cli::Arg::new("config").short('c').long("config").default_value("config.toml").help("Config path"))
  .arg(cli::Arg::new("format").short('f').long("format").default_value("json").help("Payload format"))

  // Add 25 more options to reach 30 total options on root
  let mut i = 0
  while i < 10 {
    root = root.arg(
      cli::Arg::new("str" + i.to_string())
      .long("str-" + i.to_string())
      .default_value("def" + i.to_string())
      .help("String option " + i.to_string()),
    )
    i = i + 1
  }
  let mut j = 0
  while j < 10 {
    root = root.arg(
      cli::Arg::new("flag" + j.to_string())
      .long("flag-" + j.to_string())
      .action(cli::ArgAction::SetTrue)
      .help("Boolean flag " + j.to_string()),
    )
    j = j + 1
  }
  let mut k = 0
  while k < 5 {
    root = root.arg(
      cli::Arg::new("num" + k.to_string())
      .long("num-" + k.to_string())
      .default_value("10")
      .help("Numeric option " + k.to_string()),
    )
    k = k + 1
  }

  let scale = cli::Command::new("scale")
  .about("Scale node pool")
  .arg(cli::Arg::new("replicas").short('n').long("replicas").default_value("3").help("Desired replicas"))
  .arg(cli::Arg::new("dry_run").long("dry-run").action(cli::ArgAction::SetTrue).help("Dry run"))
  .arg(cli::Arg::new("target").required(true).help("Target pool name"))

  let pool = cli::Command::new("pool").about("Manage node pools").subcommand(scale)
  let node = cli::Command::new("node").about("Manage nodes").subcommand(pool)
  let cluster = cli::Command::new("cluster").about("Manage clusters").subcommand(node)
  let cloud = cli::Command::new("cloud").about("Manage cloud resources").subcommand(cluster)

  root
  .subcommand(cloud)
  .subcommand(cli::Command::new("status").about("Show status"))
  .subcommand(cli::Command::new("login").about("Authenticate"))
  .subcommand(cli::Command::new("deploy").about("Deploy workload"))
  .subcommand(cli::Command::new("logs").about("Stream logs"))
}

///|
fn bench_w1(world : World) -> Int {
  let cmd = build_complex_cli()
  let compiled = match cmd.compile() {
    Ok(c) => c
    Err(_) => return 1
  }

  let samples : Array[Array[String]] = [
    ["-vv", "--region", "ap-northeast-1", "--str-0=alpha", "--flag-2", "cloud", "cluster", "node", "pool", "scale", "-n", "12", "--dry-run", "pool-a"],
    ["--region=eu-west-1", "-v", "--str-0", "beta", "--flag-0", "--flag-5", "cloud", "cluster", "node", "pool", "scale", "--replicas=8", "pool-b"],
    ["--str-0=gamma", "cloud", "cluster", "node", "pool", "scale", "-vvv", "-n", "5", "pool-c"],
    ["-r", "us-west-2", "--flag-2", "--num-0=42", "cloud", "cluster", "node", "pool", "scale", "-n", "1", "pool-d"],
    ["-v", "--str-0=delta", "cloud", "cluster", "node", "pool", "scale", "--replicas", "16", "--region=cn-shanghai", "pool-e"],
  ]

  let rounds = 10000
  let mut ops : Int64 = 0L
  let mut sum_replicas : Int64 = 0L
  let mut sum_verbose : Int64 = 0L
  let mut sum_str_len : Int64 = 0L

  let mut r = 0
  while r < rounds {
    let mut s = 0
    while s < samples.length() {
      let m = match compiled.parse(samples[s]) {
        Ok(v) => v
        Err(_) => return 2
      }
      sum_verbose = sum_verbose + m.get_count("verbose").to_int64()
      match m.get_string("region") {
        Some(v) => sum_str_len = sum_str_len + v.length().to_int64()
        None => return 3
      }
      match m.get_string("str0") {
        Some(v) => sum_str_len = sum_str_len + v.length().to_int64()
        None => return 4
      }
      if m.get_flag("flag2") {
        sum_str_len = sum_str_len + 1L
      }
      let m1 = match m.subcommand_matches("cloud") {
        Some(v) => v
        None => return 5
      }
      let m2 = match m1.subcommand_matches("cluster") {
        Some(v) => v
        None => return 6
      }
      let m3 = match m2.subcommand_matches("node") {
        Some(v) => v
        None => return 7
      }
      let m4 = match m3.subcommand_matches("pool") {
        Some(v) => v
        None => return 8
      }
      let m5 = match m4.subcommand_matches("scale") {
        Some(v) => v
        None => return 9
      }
      match m5.get_int("replicas") {
        Ok(Some(n)) => sum_replicas = sum_replicas + n.to_int64()
        _ => return 10
      }
      match m5.get_string("target") {
        Some(t) => sum_str_len = sum_str_len + t.length().to_int64()
        None => return 11
      }
      ops = ops + 1L
      s = s + 1
    }
    r = r + 1
  }

  io_println(world, "mode=w1")
  io_println(world, "ops=" + ops.to_string())
  io_println(world, "sum_replicas=" + sum_replicas.to_string())
  io_println(world, "sum_verbose=" + sum_verbose.to_string())
  io_println(world, "sum_str_len=" + sum_str_len.to_string())
  0
}

///|
fn bench_w2(world : World) -> Int {
  let cmd = cli::Command::new("batch")
  .arg(cli::Arg::new("a").short('a').action(cli::ArgAction::SetTrue))
  .arg(cli::Arg::new("b").short('b').action(cli::ArgAction::SetTrue))
  .arg(cli::Arg::new("c").short('c').action(cli::ArgAction::SetTrue))
  .arg(cli::Arg::new("verbose").short('v').action(cli::ArgAction::Count))
  .arg(cli::Arg::new("include").short('I').long("include").action(cli::ArgAction::Append))
  .arg(cli::Arg::new("files").multiple(true))

  let compiled = match cmd.compile() {
    Ok(c) => c
    Err(_) => return 1
  }

  // Build 100,000-argument batch
  let argv : Array[String] = []
  let mut i = 0
  while i < 10000 {
    argv.push("-abc")
    i = i + 1
  }
  let mut j = 0
  while j < 10000 {
    argv.push("-vvv")
    j = j + 1
  }
  let mut k = 0
  while k < 15000 {
    argv.push("-I")
    argv.push("dir_" + k.to_string())
    k = k + 1
  }
  argv.push("--")
  let mut p = 0
  while p < 49999 {
    let rem = p % 3
    if rem == 0 {
      argv.push("--help")
    } else if rem == 1 {
      argv.push("-x")
    } else {
      argv.push("file_" + p.to_string())
    }
    p = p + 1
  }

  let m = match compiled.parse(argv) {
    Ok(v) => v
    Err(_) => return 2
  }
  let a_bit = if m.get_flag("a") { 1 } else { 0 }
  let b_bit = if m.get_flag("b") { 1 } else { 0 }
  let c_bit = if m.get_flag("c") { 1 } else { 0 }
  let v_cnt = m.get_count("verbose")
  let inc_len = match m.get_many("include") {
    Some(arr) => arr.length()
    None => 0
  }
  let pos_len = match m.get_many("files") {
    Some(arr) => arr.length()
    None => 0
  }

  io_println(world, "mode=w2")
  io_println(world, "tokens=" + argv.length().to_string())
  io_println(world, "a=" + a_bit.to_string() + " b=" + b_bit.to_string() + " c=" + c_bit.to_string())
  io_println(world, "verbose=" + v_cnt.to_string())
  io_println(world, "includes=" + inc_len.to_string())
  io_println(world, "positionals=" + pos_len.to_string())
  0
}

///|
fn str_has(haystack : String, needle : String) -> Bool {
  let hlen = haystack.length()
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  if nlen > hlen {
    return false
  }
  let mut i = 0
  while i <= hlen - nlen {
    let mut j = 0
    while j < nlen && haystack.code_unit_at(i + j) == needle.code_unit_at(j) {
      j = j + 1
    }
    if j == nlen {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn bench_w3(world : World) -> Int {
  let cmd = build_complex_cli()
  let compiled = match cmd.compile() {
    Ok(c) => c
    Err(_) => return 1
  }

  let typos : Array[(Array[String], String)] = [
    (["--outptu"], "--output"),
    (["--confgi"], "--config"),
    (["--verbsoe"], "--verbose"),
    (["--fromat"], "--format"),
    (["--regino"], "--region"),
  ]

  let mut typo_hits = 0
  let mut r = 0
  while r < 2000 {
    let mut t = 0
    while t < typos.length() {
      let (args, expected) = typos[t]
      match compiled.parse(args) {
        Err(cli::CliError::UnknownArgument(_, Some(sug))) =>
        if sug == expected {
          typo_hits = typo_hits + 1
        }
        _ => ()
      }
      t = t + 1
    }
    r = r + 1
  }

  let mut help_ok = 0
  let mut h = 0
  while h < 10000 {
    let txt = cmd.render_help()
    if str_has(txt, "Usage:") {
      help_ok = help_ok + 1
    }
    h = h + 1
  }

  io_println(world, "mode=w3")
  io_println(world, "ops=20000")
  io_println(world, "typo_hits=" + typo_hits.to_string())
  io_println(world, "help_ok=" + help_ok.to_string())
  0
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    io_println(world, "usage: cli_bench <w1|w2|w3>")
    return 1
  }
  let mode = args[1]
  if mode == "w1" {
    bench_w1(world)
  } else if mode == "w2" {
    bench_w2(world)
  } else if mode == "w3" {
    bench_w3(world)
  } else {
    io_println(world, "unknown mode: " + mode)
    1
  }
}
