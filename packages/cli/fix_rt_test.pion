///| Regression test suite for Wave 8 Red-Team fixes (all P0/P1/P2 defects & O(N) builders).

///|
fn fix_has(haystack : String, needle : String) -> Bool {
  let hlen = haystack.length()
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  if nlen > hlen {
    return false
  }
  let mut i = 0
  while i <= hlen - nlen {
    let mut j = 0
    while j < nlen && haystack.code_unit_at(i + j) == needle.code_unit_at(j) {
      j = j + 1
    }
    if j == nlen {
      return true
    }
    i = i + 1
  }
  false
}

///|
test "fix_p0_shell_completion_injection_hardening" {
  // P0-1, P0-2, P0-3: possible_values command substitution
  let pv_cmd = Command::new("app").arg(
    Arg::new("mode").long("mode").possible_values(["$(touch PWNED_1)", "`touch PWNED_2`", "two words", "(x)"]),
  )
  match generate_completions(pv_cmd, Shell::Bash) {
    Ok(s) => {
      debug_assert(!fix_has(s, "$(touch PWNED"), "bash must not emit raw $(...)")
      debug_assert(!fix_has(s, "`touch PWNED"), "bash must not emit raw backticks")
      debug_assert(fix_has(s, "'two words'"), "bash preserves spaces in single-quoted array")
    }
    Err(e) => debug_assert(false, cli_error_to_string(e))
  }
  match generate_completions(pv_cmd, Shell::Zsh) {
    Ok(s) => {
      debug_assert(!fix_has(s, "$(touch PWNED"), "zsh must not emit raw $(...)")
      debug_assert(!fix_has(s, "`touch PWNED"), "zsh must not emit raw backticks")
      debug_assert(fix_has(s, "compadd --"), "zsh uses compadd helper for unsafe/spaced values")
    }
    Err(e) => debug_assert(false, cli_error_to_string(e))
  }
  match generate_completions(pv_cmd, Shell::Fish) {
    Ok(s) => {
      debug_assert(!fix_has(s, "$(touch PWNED"), "fish must escape $(...)")
      debug_assert(!fix_has(s, "`touch PWNED"), "fish must escape backticks")
    }
    Err(e) => debug_assert(false, cli_error_to_string(e))
  }

  // P0-4, P0-5, P0-6, P0-7, P0-8, P0-9: hostile command/flag/subcommand names
  let hostile = Command::new("app;>PWNED")
  .arg(Arg::new("q").short('\'').action(ArgAction::SetTrue))
  .arg(Arg::new("p").short(')').possible_values(["a"]))
  .arg(Arg::new("m").long("x)>PWNED;;y").possible_values(["a"]))
  .subcommand(Command::new("a)>PWNED;;b").about("sub"))
  match generate_completions(hostile, Shell::Bash) {
    Ok(s) => {
      debug_assert(!fix_has(s, "app;>PWNED\n"), "bash quotes command name")
      debug_assert(!fix_has(s, "        -))"), "bash quotes short ')' case arm")
      debug_assert(!fix_has(s, "--x)>PWNED;;y)"), "bash quotes long flag case arm")
    }
    Err(e) => debug_assert(false, cli_error_to_string(e))
  }
  match generate_completions(hostile, Shell::Zsh) {
    Ok(s) => {
      debug_assert(!fix_has(s, "'-'["), "zsh escapes short quote")
      debug_assert(!fix_has(s, "a)>PWNED;;b) "), "zsh quotes subcommand case arm")
    }
    Err(e) => debug_assert(false, cli_error_to_string(e))
  }
  match generate_completions(hostile, Shell::Fish) {
    Ok(s) => {
      debug_assert(!fix_has(s, "complete -c app;>PWNED"), "fish quotes command name")
      debug_assert(!fix_has(s, "-s '\n"), "fish quotes short quote")
    }
    Err(e) => debug_assert(false, cli_error_to_string(e))
  }
}

///|
test "fix_p1_unicode_short_flags_utf8_and_exact_double" {
  // P1-1 & P1-2: non-ASCII short flags and error reporting
  let c = Command::new("app")
  .arg(Arg::new("uni").short('é').action(ArgAction::SetTrue))
  .arg(Arg::new("v").short('v').action(ArgAction::Count))
  match c.parse(["-vé"]) {
    Ok(m) => {
      debug_assert(m.get_flag("uni"), "-é matched")
      debug_assert(m.get_count("v") == 1, "-v matched")
    }
    Err(e) => debug_assert(false, cli_error_to_string(e))
  }
  match c.parse(["-ü"]) {
    Err(CliError::UnknownArgument(a, None)) => debug_assert(a == "-ü", "unknown short is -ü, got " + a)
    _ => debug_assert(false, "expected UnknownArgument(-ü)")
  }

  // P1-3 & P1-4: UTF-8 preserved without double encoding
  let uh = Command::new("app").arg(Arg::new("fichier_é").long("fichier").help("héllo 😀 世界"))
  let h = uh.render_help()
  debug_assert(fix_has(h, "FICHIER_é") && !fix_has(h, "Ã"), "help placeholder preserves UTF-8")
  match generate_completions(uh, Shell::Zsh) {
    Ok(z) => debug_assert(fix_has(z, "héllo 😀 世界"), "zsh preserves UTF-8")
    Err(e) => debug_assert(false, cli_error_to_string(e))
  }

  // P1-9: exact IEEE-754 double rounding
  let tc = Command::new("t").arg(Arg::new("x").long("x"))
  let check_bits = fn(s : String, expected : Int64) {
    match tc.parse(["--x", s]) {
      Ok(m) =>
      match m.get_double("x") {
        Ok(Some(d)) => {
          let bits = d.reinterpret_as_uint64().reinterpret_as_int64()
          debug_assert(bits == expected, s + ": expected " + expected.to_string() + ", got " + bits.to_string())
        }
        _ => debug_assert(false, s + ": expected Some(Double)")
      }
      Err(e) => debug_assert(false, cli_error_to_string(e))
    }
  }
  check_bits("1.7976931348623157e308", 9218868437227405311L) // 0x7fefffffffffffff
  check_bits("2.2250738585072014e-308", 4503599627370496L) // 0x0010000000000000
  check_bits("9223372036854775807", 4890909195324358656L) // 0x43e0000000000000
  check_bits("2.5e-8", 4493141015233605448L) // 0x3e5ad7f29abcaf48
  check_bits("inf", 9218868437227405312L) // 0x7ff0000000000000
  check_bits("-inf", -4503599627370496L) // 0xfff0000000000000
}

///|
test "fix_p1_requires_allow_hyphen_inline_eq_and_help_subcommand" {
  // P1-5: default value does not satisfy requires
  let c_req = Command::new("app")
  .arg(Arg::new("a").long("a").action(ArgAction::SetTrue).requires("b"))
  .arg(Arg::new("b").long("b").default_value("x"))
  match c_req.parse(["--a"]) {
    Err(CliError::MissingDependency("a", "b")) => ()
    _ => debug_assert(false, "default value must not satisfy requires")
  }

  // P1-6: allow_hyphen_values enforced
  let c_hy = Command::new("app")
  .arg(Arg::new("num").short('n').long("num"))
  .arg(Arg::new("pat").long("pat").allow_hyphen_values(true))
  .arg(Arg::new("flag").long("flag").action(ArgAction::SetTrue))
  match c_hy.parse(["--num", "--flag"]) {
    Err(CliError::MissingValue("--num")) => ()
    _ => debug_assert(false, "--num must reject --flag")
  }
  match c_hy.parse(["-n", "--help"]) {
    Err(CliError::MissingValue("-n")) => ()
    _ => debug_assert(false, "-n must reject --help")
  }
  match c_hy.parse(["--num", "--"]) {
    Err(CliError::MissingValue("--num")) => ()
    _ => debug_assert(false, "--num must reject --")
  }
  match c_hy.parse(["--pat", "-x"]) {
    Ok(m) => debug_assert(m.get_string("pat").unwrap_or("") == "-x", "allow_hyphen_values accepts -x")
    Err(e) => debug_assert(false, cli_error_to_string(e))
  }

  // P1-7: inline =VALUE rejected on Count / SetFalse / SetTrue / negative flags
  let c_eq = Command::new("app")
  .arg(Arg::new("v").long("verbose").action(ArgAction::Count))
  .arg(Arg::new("color").long("color").negative("no-color").action(ArgAction::SetTrue))
  .arg(Arg::new("cache").long("no-cache").action(ArgAction::SetFalse))
  debug_assert(c_eq.parse(["--verbose=garbage"]) is Err(_), "--verbose=garbage rejected")
  debug_assert(c_eq.parse(["--no-color=x"]) is Err(_), "--no-color=x rejected")
  debug_assert(c_eq.parse(["--no-cache=x"]) is Err(_), "--no-cache=x rejected")
  debug_assert(c_eq.parse(["--color=yes"]) is Err(_), "--color=yes rejected")

  // P1-8 & P2-1: built-in help subcommand + full parent path & globals
  let c_sub = Command::new("app")
  .arg(Arg::new("v").short('v').long("verbose").action(ArgAction::Count).global(true))
  .subcommand(Command::new("run").about("Run task"))
  match c_sub.parse(["help", "run"]) {
    Err(CliError::DisplayHelp(h)) => {
      debug_assert(fix_has(h, "Usage: app run"), "help run has full path")
      debug_assert(fix_has(h, "--verbose"), "help run includes global --verbose")
    }
    _ => debug_assert(false, "expected DisplayHelp for `app help run`")
  }
}

///|
test "fix_p2_self_conflict_collisions_and_linear_builder" {
  // P2-8: self conflict rejected in validate()
  let sc = Command::new("app").arg(Arg::new("a").long("a").conflicts_with("a"))
  match sc.validate() {
    Err(CliError::InvalidDefinition(_)) => ()
    _ => debug_assert(false, "self conflict must be rejected at validate()")
  }

  // P2-5: collision-free identifiers for a-b vs a_b
  let col = Command::new("app")
  .subcommand(Command::new("a-b").arg(Arg::new("x").long("only-ab").action(ArgAction::SetTrue)))
  .subcommand(Command::new("a_b").arg(Arg::new("y").long("only-a_b").action(ArgAction::SetTrue)))
  match generate_completions(col, Shell::Bash) {
    Ok(b) => {
      debug_assert(fix_has(b, "a_x2d_b"), "a-b encoded uniquely")
      debug_assert(fix_has(b, "a_x5f_b"), "a_b encoded uniquely")
    }
    Err(e) => debug_assert(false, cli_error_to_string(e))
  }

  // P2-9: linear builder (4000 chained .arg() calls)
  let mut big = Command::new("big")
  let mut i = 0
  while i < 4000 {
    big = big.arg(Arg::new("o" + i.to_string()).long("opt-" + i.to_string()))
    i = i + 1
  }
  debug_assert(big.args_list.length() == 4000, "4000 args built linearly")
}
