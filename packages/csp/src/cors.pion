///| WHATWG Fetch Standard CORS policy engine.
///| Zero external dependencies; 100% pure Pion; zero `World` dependency.

// ============================================================================
// Internal Helpers
// ============================================================================

fn cors_is_http_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

fn cors_trim(s : String) -> String {
  let n = s.length()
  let mut a = 0
  let mut b = n
  while a < b && cors_is_http_ws(s.code_unit_at(a)) {
    a = a + 1
  }
  while b > a && cors_is_http_ws(s.code_unit_at(b - 1)) {
    b = b - 1
  }
  if a == 0 && b == n {
    s
  } else if a >= b {
    ""
  } else {
    s.slice(a, b)
  }
}

fn cors_is_unsafe_request_header_byte(c : Int) -> Bool {
  if (c < 0x20 && c != 0x09) || c == 0x7F {
    return true
  }
  // " ( ) : < > ? @ [ \ ] { }
  c == 34 ||
  c == 40 ||
  c == 41 ||
  c == 58 ||
  c == 60 ||
  c == 62 ||
  c == 63 ||
  c == 64 ||
  c == 91 ||
  c == 92 ||
  c == 93 ||
  c == 123 ||
  c == 125
}

fn cors_has_unsafe_header_byte(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if cors_is_unsafe_request_header_byte(s.code_unit_at(i)) {
      return true
    }
    i = i + 1
  }
  false
}

fn cors_is_language_byte(c : Int) -> Bool {
  (c >= 48 && c <= 57) ||
  (c >= 65 && c <= 90) ||
  (c >= 97 && c <= 122) ||
  c == 32 ||
  c == 42 ||
  c == 44 ||
  c == 45 ||
  c == 46 ||
  c == 59 ||
  c == 61
}

fn cors_is_include(mode : CredentialsMode) -> Bool {
  match mode {
    CredentialsMode::Include => true
    _ => false
  }
}

fn cors_split_csv(csv : String, lowercase : Bool) -> Array[String] {
  let out : Array[String] = []
  let n = csv.length()
  let mut pos = 0
  while pos <= n {
    let comma = csp_find_byte(csv, 44, pos, n)
    let end = if comma >= 0 { comma } else { n }
    let item = cors_trim(csv.slice(pos, end))
    if item.length() > 0 {
      out.push(if lowercase { csp_ascii_lower(item) } else { item })
    }
    if comma < 0 {
      break
    }
    pos = comma + 1
  }
  out
}

fn cors_parse_nonneg_int(s : String) -> Int {
  let n = s.length()
  if n == 0 || n > 9 {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return -1
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  acc
}

// ============================================================================
// Public WHATWG Fetch CORS API
// ============================================================================

///| Fetch §2.2.1: Returns true iff `method` is a CORS-safelisted method (`GET`, `HEAD`, `POST`).
pub fn is_cors_safelisted_method(method : String) -> Bool {
  method == "GET" || method == "HEAD" || method == "POST"
}

///| Fetch §2.2.2: Returns true iff `(name, value)` is a CORS-safelisted request-header.
///| Enforces total value length <= 128 bytes, CORS-unsafe byte restrictions, and
///| `Content-Type` MIME type essence (`application/x-www-form-urlencoded`,
///| `multipart/form-data`, `text/plain`).
pub fn is_cors_safelisted_request_header(name : String, value : String) -> Bool {
  if value.length() > 128 {
    return false
  }
  let lower_name = csp_ascii_lower(cors_trim(name))
  if lower_name == "accept" {
    return !cors_has_unsafe_header_byte(value)
  }
  if lower_name == "accept-language" || lower_name == "content-language" {
    let n = value.length()
    let mut i = 0
    while i < n {
      if !cors_is_language_byte(value.code_unit_at(i)) {
        return false
      }
      i = i + 1
    }
    return true
  }
  if lower_name == "content-type" {
    if cors_has_unsafe_header_byte(value) {
      return false
    }
    let semi = csp_find_byte(value, 59, 0, value.length())
    let raw_essence = if semi >= 0 { value.slice(0, semi) } else { value }
    let essence = csp_ascii_lower(cors_trim(raw_essence))
    return essence == "application/x-www-form-urlencoded" ||
    essence == "multipart/form-data" ||
    essence == "text/plain"
  }
  false
}

///| Parse a URL string into a normalized WHATWG `Origin` (scheme, lowercased host, default-normalized port).
///| Returns `Origin::Opaque` for `"null"`, non-tuple schemes (`data:`, `blob:`, `file:`, etc.), or malformed URLs.
pub fn parse_origin(url : String) -> Origin {
  let s = cors_trim(url)
  let n = s.length()
  if n == 0 {
    return Origin::Opaque
  }
  if csp_ascii_lower(s) == "null" {
    return Origin::Opaque
  }
  let sep = csp_find_scheme_sep(s)
  if sep <= 0 {
    return Origin::Opaque
  }
  let scheme = csp_ascii_lower(s.slice(0, sep))
  let def_port = csp_default_port(scheme)
  if def_port < 0 {
    return Origin::Opaque
  }

  let auth_start = sep + 3
  let mut auth_end = n
  let mut i = auth_start
  while i < n {
    let c = s.code_unit_at(i)
    if c == 47 || c == 63 || c == 35 {
      auth_end = i
      break
    }
    if c <= 32 || c == 127 {
      return Origin::Opaque
    }
    i = i + 1
  }
  if auth_start >= auth_end {
    return Origin::Opaque
  }

  // Strip optional userinfo@
  let at = csp_find_byte(s, 64, auth_start, auth_end)
  let hp_start = if at >= 0 { at + 1 } else { auth_start }
  if hp_start >= auth_end {
    return Origin::Opaque
  }

  let mut host = ""
  let mut port = def_port
  if s.code_unit_at(hp_start) == 91 {
    let rb = csp_find_byte(s, 93, hp_start + 1, auth_end)
    if rb < 0 {
      return Origin::Opaque
    }
    host = csp_ascii_lower(s.slice(hp_start, rb + 1))
    if rb + 1 < auth_end {
      if s.code_unit_at(rb + 1) != 58 {
        return Origin::Opaque
      }
      let p = csp_parse_port_slice(s, rb + 2, auth_end)
      if p <= 0 {
        return Origin::Opaque
      }
      port = p
    }
  } else {
    let colon = csp_find_byte(s, 58, hp_start, auth_end)
    if colon >= 0 {
      host = csp_ascii_lower(s.slice(hp_start, colon))
      let p = csp_parse_port_slice(s, colon + 1, auth_end)
      if p <= 0 {
        return Origin::Opaque
      }
      port = p
    } else {
      host = csp_ascii_lower(s.slice(hp_start, auth_end))
    }
  }

  if host.length() == 0 {
    return Origin::Opaque
  }
  Origin::Tuple(scheme, host, port)
}

///| WHATWG HTML Same-Origin check.
///| Per spec, `Origin::Opaque` (`null`) NEVER equals any origin, including itself.
pub fn origin_equals(a : Origin, b : Origin) -> Bool {
  match a {
    Origin::Opaque => false
    Origin::Tuple(sa, ha, pa) =>
    match b {
      Origin::Opaque => false
      Origin::Tuple(sb, hb, pb) => sa == sb && ha == hb && pa == pb
    }
  }
}

///| Serialize an `Origin` per WHATWG HTML (omitting default port for scheme; `"null"` for opaque).
pub fn format_origin(origin : Origin) -> String {
  match origin {
    Origin::Opaque => "null"
    Origin::Tuple(sch, host, port) => {
      if port == csp_default_port(sch) {
        sch + "://" + host
      } else {
        sch + "://" + host + ":" + port.to_string()
      }
    }
  }
}

fn cors_validate_origin_and_creds(
  request_origin : String,
  credentials_mode : CredentialsMode,
  allow_origin : Option[String],
  allow_credentials : Option[String],
) -> Result[Unit, String] {
  let req_orig = cors_trim(request_origin)
  if req_orig.length() == 0 {
    return Result::Err("empty request origin")
  }
  let acao = match allow_origin {
    Option::Some(raw) => cors_trim(raw)
    Option::None => return Result::Err("missing Access-Control-Allow-Origin")
  }
  if acao.length() == 0 {
    return Result::Err("empty Access-Control-Allow-Origin")
  }
  // Fetch §4.9: multiple values in Access-Control-Allow-Origin are invalid.
  if csp_find_byte(acao, 44, 0, acao.length()) >= 0 {
    return Result::Err("multiple values in Access-Control-Allow-Origin")
  }

  let include_creds = cors_is_include(credentials_mode)
  if include_creds {
    if acao == "*" {
      return Result::Err("Access-Control-Allow-Origin '*' is forbidden with credentials: include")
    }
    if acao != req_orig {
      return Result::Err(
        "Access-Control-Allow-Origin mismatch: got '" + acao + "', expected '" + req_orig + "'",
      )
    }
    match allow_credentials {
      Option::Some(v) => {
        if cors_trim(v) != "true" {
          return Result::Err("Access-Control-Allow-Credentials must be exact 'true'")
        }
      }
      Option::None => return Result::Err("missing Access-Control-Allow-Credentials")
    }
  } else {
    if acao != "*" && acao != req_orig {
      return Result::Err(
        "Access-Control-Allow-Origin mismatch: got '" + acao + "', expected '" + req_orig + "'",
      )
    }
  }
  Result::Ok(())
}

///| Fetch §4.9: Validate a CORS response (`Access-Control-Allow-Origin`,
///| `Access-Control-Allow-Credentials`, `Access-Control-Expose-Headers`).
pub fn check_cors_response(
  request_origin : String,
  credentials_mode : CredentialsMode,
  allow_origin : Option[String],
  allow_credentials : Option[String],
  expose_headers : Option[String],
) -> CorsResponseDecision {
  match cors_validate_origin_and_creds(
    request_origin,
    credentials_mode,
    allow_origin,
    allow_credentials,
  ) {
    Result::Err(reason) =>
    return CorsResponseDecision::{
      allowed: false,
      exposed_headers: [],
      wildcard_exposed: false,
      reason: reason,
    }
    Result::Ok(_) => ()
  }

  let include_creds = cors_is_include(credentials_mode)
  let exposed : Array[String] = []
  let mut wildcard_exposed = false
  match expose_headers {
    Option::Some(raw) => {
      let items = cors_split_csv(raw, true)
      let mut i = 0
      while i < items.length() {
        let item = items[i]
        if item == "*" {
          if !include_creds {
            wildcard_exposed = true
          }
        } else {
          exposed.push(item)
        }
        i = i + 1
      }
    }
    Option::None => ()
  }

  CorsResponseDecision::{
    allowed: true,
    exposed_headers: exposed,
    wildcard_exposed: wildcard_exposed,
    reason: "",
  }
}

///| Fetch §4.9: Validate a CORS `OPTIONS` preflight response.
///| Enforces origin/credentials, `Access-Control-Allow-Methods`, `Access-Control-Allow-Headers`
///| (where `*` NEVER covers `Authorization`), and `Access-Control-Max-Age`.
pub fn check_cors_preflight(
  request_origin : String,
  credentials_mode : CredentialsMode,
  request_method : String,
  request_headers : Array[String],
  allow_origin : Option[String],
  allow_credentials : Option[String],
  allow_methods : Option[String],
  allow_headers : Option[String],
  max_age : Option[String],
) -> CorsPreflightDecision {
  match cors_validate_origin_and_creds(
    request_origin,
    credentials_mode,
    allow_origin,
    allow_credentials,
  ) {
    Result::Err(reason) =>
    return CorsPreflightDecision::{
      allowed: false,
      max_age: 0,
      reason: reason,
    }
    Result::Ok(_) => ()
  }

  let include_creds = cors_is_include(credentials_mode)

  // 1. Validate Access-Control-Allow-Methods
  let mut method_ok = is_cors_safelisted_method(request_method)
  if !method_ok {
    match allow_methods {
      Option::Some(raw) => {
        let methods = cors_split_csv(raw, false)
        let mut i = 0
        while i < methods.length() {
          let m = methods[i]
          if m == request_method || (m == "*" && !include_creds) {
            method_ok = true
            break
          }
          i = i + 1
        }
      }
      Option::None => ()
    }
  }
  if !method_ok {
    return CorsPreflightDecision::{
      allowed: false,
      max_age: 0,
      reason: "preflight method not allowed: " + request_method,
    }
  }

  // 2. Validate Access-Control-Allow-Headers
  if request_headers.length() > 0 {
    let allowed_hdrs = match allow_headers {
      Option::Some(raw) => cors_split_csv(raw, true)
      Option::None => []
    }
    let mut has_wildcard = false
    if !include_creds {
      let mut i = 0
      while i < allowed_hdrs.length() {
        if allowed_hdrs[i] == "*" {
          has_wildcard = true
          break
        }
        i = i + 1
      }
    }
    let mut ri = 0
    while ri < request_headers.length() {
      let rh = csp_ascii_lower(cors_trim(request_headers[ri]))
      if rh.length() > 0 {
        let mut ok = false
        let mut ai = 0
        while ai < allowed_hdrs.length() {
          if allowed_hdrs[ai] == rh {
            ok = true
            break
          }
          ai = ai + 1
        }
        // Fetch §4.9: '*' covers non-Authorization headers when credentials != include.
        if !ok && has_wildcard && rh != "authorization" {
          ok = true
        }
        if !ok {
          return CorsPreflightDecision::{
            allowed: false,
            max_age: 0,
            reason: "preflight header not allowed: " + rh,
          }
        }
      }
      ri = ri + 1
    }
  }

  // 3. Parse Access-Control-Max-Age (default 0 if absent or invalid)
  let mut parsed_max_age = 0
  match max_age {
    Option::Some(raw) => {
      let v = cors_parse_nonneg_int(cors_trim(raw))
      if v >= 0 {
        parsed_max_age = v
      }
    }
    Option::None => ()
  }

  CorsPreflightDecision::{
    allowed: true,
    max_age: parsed_max_age,
    reason: "",
  }
}
