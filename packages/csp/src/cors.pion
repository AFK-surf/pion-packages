///| WHATWG Fetch Standard CORS policy engine.
///| Built on `packages/url` (pure-Pion WHATWG URL Standard) for spec-compliant origin
///| extraction (including `blob:` inner origin and port `0`). Zero `extern "C"`, zero `World`.

import "url"

// ============================================================================
// Internal Helpers
// ============================================================================

pub fn cors_is_http_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

fn cors_trim(s : String) -> String {
  let n = s.length()
  let mut a = 0
  let mut b = n
  while a < b && cors_is_http_ws(s.code_unit_at(a)) {
    a = a + 1
  }
  while b > a && cors_is_http_ws(s.code_unit_at(b - 1)) {
    b = b - 1
  }
  if a == 0 && b == n {
    s
  } else if a >= b {
    ""
  } else {
    s.slice(a, b)
  }
}

#verify
pub fn cors_is_unsafe_request_header_byte(c : Int) -> Bool {
  if (c < 0x20 && c != 0x09) || c == 0x7F {
    return true
  }
  // " ( ) : < > ? @ [ \ ] { }
  c == 34 ||
  c == 40 ||
  c == 41 ||
  c == 58 ||
  c == 60 ||
  c == 62 ||
  c == 63 ||
  c == 64 ||
  c == 91 ||
  c == 92 ||
  c == 93 ||
  c == 123 ||
  c == 125
}

fn cors_has_unsafe_header_byte(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if cors_is_unsafe_request_header_byte(s.code_unit_at(i)) {
      return true
    }
    i = i + 1
  }
  false
}

#verify
pub fn cors_is_language_byte(c : Int) -> Bool {
  (c >= 48 && c <= 57) ||
  (c >= 65 && c <= 90) ||
  (c >= 97 && c <= 122) ||
  c == 32 ||
  c == 42 ||
  c == 44 ||
  c == 45 ||
  c == 46 ||
  c == 59 ||
  c == 61
}

pub fn cors_is_include(mode : CredentialsMode) -> Bool {
  match mode {
    CredentialsMode::Include => true
    _ => false
  }
}

#verify
pub fn cors_clamp_max_age(v : Int) -> Int {
  if v > 86400 {
    86400
  } else if v >= 0 {
    v
  } else {
    0
  }
}

fn cors_slice_eq_ascii_ci(
  a : String,
  a0 : Int,
  a1 : Int,
  b : String,
  b0 : Int,
  b1 : Int,
) -> Bool {
  let len = a1 - a0
  if len != b1 - b0 {
    return false
  }
  let mut i = 0
  while i < len {
    let mut ca = a.code_unit_at(a0 + i)
    let mut cb = b.code_unit_at(b0 + i)
    if ca >= 65 && ca <= 90 {
      ca = ca + 32
    }
    if cb >= 65 && cb <= 90 {
      cb = cb + 32
    }
    if ca != cb {
      return false
    }
    i = i + 1
  }
  true
}

fn cors_parse_nonneg_int_slice(s : String, start : Int, end : Int) -> Int {
  let len = end - start
  if len <= 0 || len > 9 {
    return -1
  }
  let mut acc = 0
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return -1
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  acc
}

fn cors_parse_special_origin_fast(
  s : String,
  start : Int,
  end : Int,
  only_http_https : Bool,
) -> Option[Origin] {
  let len = end - start
  if len < 7 {
    return Option::None
  }
  let mut sch = ""
  let mut def_port = -1
  let mut host_start = 0
  let c0 = s.code_unit_at(start)
  let l0 = if c0 >= 65 && c0 <= 90 { c0 + 32 } else { c0 }
  if l0 == 104 {
    if len >= 8 && csp_eq_ascii_ci(s, start, start + 8, "https://") {
      sch = "https"
      def_port = 443
      host_start = start + 8
    } else if csp_eq_ascii_ci(s, start, start + 7, "http://") {
      sch = "http"
      def_port = 80
      host_start = start + 7
    }
  } else if !only_http_https {
    if l0 == 119 {
      if len >= 6 && csp_eq_ascii_ci(s, start, start + 6, "wss://") {
        sch = "wss"
        def_port = 443
        host_start = start + 6
      } else if len >= 5 && csp_eq_ascii_ci(s, start, start + 5, "ws://") {
        sch = "ws"
        def_port = 80
        host_start = start + 5
      }
    } else if l0 == 102 && len >= 6 && csp_eq_ascii_ci(s, start, start + 6, "ftp://") {
      sch = "ftp"
      def_port = 21
      host_start = start + 6
    }
  }
  if host_start == 0 {
    return Option::None
  }

  let mut i = host_start
  let mut last_label_start = host_start
  let mut prev_dash = false
  let mut has_upper = false
  while i < end {
    let c = s.code_unit_at(i)
    if c == 58 || c == 47 || c == 92 || c == 63 || c == 35 {
      break
    }
    if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
      prev_dash = false
    } else if c >= 65 && c <= 90 {
      has_upper = true
      prev_dash = false
    } else if c == 46 {
      last_label_start = i + 1
      prev_dash = false
    } else if c == 45 {
      if prev_dash {
        return Option::None
      }
      prev_dash = true
    } else {
      return Option::None
    }
    i = i + 1
  }
  if i <= host_start || i <= last_label_start {
    return Option::None
  }
  let lc = s.code_unit_at(last_label_start)
  if !((lc >= 97 && lc <= 122) || (lc >= 65 && lc <= 90)) {
    return Option::None
  }
  let host_end = i
  let mut port = def_port
  if i < end && s.code_unit_at(i) == 58 {
    let pstart = i + 1
    let mut pi = pstart
    let mut acc = 0
    while pi < end {
      let pc = s.code_unit_at(pi)
      if pc == 47 || pc == 92 || pc == 63 || pc == 35 {
        break
      }
      let next = csp_port_step(acc, pc)
      if next < 0 {
        return Option::None
      }
      acc = next
      pi = pi + 1
    }
    if pi > pstart {
      port = acc
    }
  }
  let host = if has_upper {
    csp_ascii_lower_slice(s, host_start, host_end)
  } else {
    s.slice(host_start, host_end)
  }
  Option::Some(Origin::Tuple(sch, host, port))
}

// ============================================================================
// Public WHATWG Fetch CORS API
// ============================================================================

///| Fetch §2.2.1: Returns true iff `method` is a CORS-safelisted method (`GET`, `HEAD`, `POST`).
pub fn is_cors_safelisted_method(method : String) -> Bool {
  method == "GET" || method == "HEAD" || method == "POST"
}

///| Fetch §2.2.2: Returns true iff `(name, value)` is a CORS-safelisted request-header.
///| Enforces total value length <= 128 bytes, CORS-unsafe byte restrictions, and
///| `Content-Type` MIME type essence (`application/x-www-form-urlencoded`,
///| `multipart/form-data`, `text/plain`).
pub fn is_cors_safelisted_request_header(name : String, value : String) -> Bool {
  if value.length() > 128 {
    return false
  }
  let mut na = 0
  let mut nb = name.length()
  while na < nb && cors_is_http_ws(name.code_unit_at(na)) {
    na = na + 1
  }
  while nb > na && cors_is_http_ws(name.code_unit_at(nb - 1)) {
    nb = nb - 1
  }
  let nlen = nb - na
  if nlen == 12 && csp_eq_ascii_ci(name, na, nb, "content-type") {
    if cors_has_unsafe_header_byte(value) {
      return false
    }
    let vlen = value.length()
    let semi = csp_find_byte(value, 59, 0, vlen)
    let mut va = 0
    let mut vb = if semi >= 0 { semi } else { vlen }
    while va < vb && cors_is_http_ws(value.code_unit_at(va)) {
      va = va + 1
    }
    while vb > va && cors_is_http_ws(value.code_unit_at(vb - 1)) {
      vb = vb - 1
    }
    let elen = vb - va
    if elen == 10 {
      return csp_eq_ascii_ci(value, va, vb, "text/plain")
    }
    if elen == 19 {
      return csp_eq_ascii_ci(value, va, vb, "multipart/form-data")
    }
    if elen == 33 {
      return csp_eq_ascii_ci(value, va, vb, "application/x-www-form-urlencoded")
    }
    return false
  }
  if nlen == 6 && csp_eq_ascii_ci(name, na, nb, "accept") {
    return !cors_has_unsafe_header_byte(value)
  }
  if (nlen == 15 && csp_eq_ascii_ci(name, na, nb, "accept-language")) ||
  (nlen == 16 && csp_eq_ascii_ci(name, na, nb, "content-language")) {
    let n = value.length()
    let mut i = 0
    while i < n {
      if !cors_is_language_byte(value.code_unit_at(i)) {
        return false
      }
      i = i + 1
    }
    return true
  }
  false
}

///| Parse a URL string into a normalized WHATWG `Origin` using `packages/url`.
///| Properly resolves `blob:` inner origins, port `0`, IPv6, IDNA/lowercase hosts,
///| backslash authority rules, and last-`@` userinfo per WHATWG URL Standard §6.
///| Returns `Origin::Opaque` for `"null"`, non-tuple schemes, or malformed URLs.
pub fn parse_origin(raw_url : String) -> Origin {
  let n = raw_url.length()
  if n >= 5 {
    let c0 = raw_url.code_unit_at(0)
    if c0 == 98 || c0 == 66 {
      if n >= 12 && csp_eq_ascii_ci(raw_url, 0, 5, "blob:") {
        match cors_parse_special_origin_fast(raw_url, 5, n, true) {
          Option::Some(o) => return o
          Option::None => ()
        }
      }
    } else if c0 == 104 || c0 == 72 || c0 == 119 || c0 == 87 || c0 == 102 || c0 == 70 {
      match cors_parse_special_origin_fast(raw_url, 0, n, false) {
        Option::Some(o) => return o
        Option::None => ()
      }
    }
  }
  match url::Url::parse(raw_url) {
    Result::Ok(u) =>
    match u.origin() {
      url::Origin::Tuple(sch, host, port) =>
      Origin::Tuple(sch, url::host_to_string(host), port)
      url::Origin::Opaque => Origin::Opaque
    }
    Result::Err(_) => Origin::Opaque
  }
}

///| WHATWG HTML Same-Origin check.
///| Per spec, `Origin::Opaque` (`null`) NEVER equals any origin, including itself.
pub fn origin_equals(a : Origin, b : Origin) -> Bool {
  match a {
    Origin::Opaque => false
    Origin::Tuple(sa, ha, pa) =>
    match b {
      Origin::Opaque => false
      Origin::Tuple(sb, hb, pb) => pa == pb && sa == sb && ha == hb
    }
  }
}

///| Serialize an `Origin` per WHATWG HTML (omitting default port for scheme; `"null"` for opaque).
pub fn format_origin(origin : Origin) -> String {
  match origin {
    Origin::Opaque => "null"
    Origin::Tuple(sch, host, port) => {
      if port == csp_default_port(sch) {
        if sch == "https" {
          "https://" + host
        } else if sch == "http" {
          "http://" + host
        } else {
          sch + "://" + host
        }
      } else {
        let prefix = if sch == "https" {
          "https://"
        } else if sch == "http" {
          "http://"
        } else {
          sch + "://"
        }
        prefix + host + ":" + port.to_string()
      }
    }
  }
}

fn cors_validate_origin_and_creds_reason(
  request_origin : String,
  credentials_mode : CredentialsMode,
  allow_origin : Option[String],
  allow_credentials : Option[String],
) -> String {
  let mut ra = 0
  let mut rb = request_origin.length()
  while ra < rb && cors_is_http_ws(request_origin.code_unit_at(ra)) {
    ra = ra + 1
  }
  while rb > ra && cors_is_http_ws(request_origin.code_unit_at(rb - 1)) {
    rb = rb - 1
  }
  if ra >= rb {
    return "empty request origin"
  }
  let raw_acao = match allow_origin {
    Option::Some(raw) => raw
    Option::None => return "missing Access-Control-Allow-Origin"
  }
  let mut aa = 0
  let mut ab = raw_acao.length()
  while aa < ab && cors_is_http_ws(raw_acao.code_unit_at(aa)) {
    aa = aa + 1
  }
  while ab > aa && cors_is_http_ws(raw_acao.code_unit_at(ab - 1)) {
    ab = ab - 1
  }
  if aa >= ab {
    return "empty Access-Control-Allow-Origin"
  }
  // Fetch §4.9: multiple values in Access-Control-Allow-Origin are invalid.
  if csp_find_byte(raw_acao, 44, aa, ab) >= 0 {
    return "multiple values in Access-Control-Allow-Origin"
  }

  let is_star = ab - aa == 1 && raw_acao.code_unit_at(aa) == 42
  let include_creds = cors_is_include(credentials_mode)
  if include_creds {
    if is_star {
      return "Access-Control-Allow-Origin '*' is forbidden with credentials: include"
    }
    if !csp_slice_eq(raw_acao, aa, ab, request_origin, ra, rb) {
      return "Access-Control-Allow-Origin mismatch: got '" +
      raw_acao.slice(aa, ab) + "', expected '" + request_origin.slice(ra, rb) + "'"
    }
    match allow_credentials {
      Option::Some(v) => {
        let mut ca = 0
        let mut cb = v.length()
        while ca < cb && cors_is_http_ws(v.code_unit_at(ca)) {
          ca = ca + 1
        }
        while cb > ca && cors_is_http_ws(v.code_unit_at(cb - 1)) {
          cb = cb - 1
        }
        if !csp_slice_eq(v, ca, cb, "true", 0, 4) {
          return "Access-Control-Allow-Credentials must be exact 'true'"
        }
      }
      Option::None => return "missing Access-Control-Allow-Credentials"
    }
  } else {
    if !is_star && !csp_slice_eq(raw_acao, aa, ab, request_origin, ra, rb) {
      return "Access-Control-Allow-Origin mismatch: got '" +
      raw_acao.slice(aa, ab) + "', expected '" + request_origin.slice(ra, rb) + "'"
    }
  }
  ""
}

///| Fetch §4.9: Validate a CORS response (`Access-Control-Allow-Origin`,
///| `Access-Control-Allow-Credentials`, `Access-Control-Expose-Headers`).
pub fn check_cors_response(
  request_origin : String,
  credentials_mode : CredentialsMode,
  allow_origin : Option[String],
  allow_credentials : Option[String],
  expose_headers : Option[String],
) -> CorsResponseDecision {
  let err_reason = cors_validate_origin_and_creds_reason(
    request_origin,
    credentials_mode,
    allow_origin,
    allow_credentials,
  )
  if err_reason.length() > 0 {
    return CorsResponseDecision::{
      allowed: false,
      exposed_headers: [],
      wildcard_exposed: false,
      reason: err_reason,
    }
  }

  let include_creds = cors_is_include(credentials_mode)
  let exposed : Array[String] = []
  let mut wildcard_exposed = false
  match expose_headers {
    Option::Some(raw) => {
      let n = raw.length()
      let mut pos = 0
      while pos <= n {
        let comma = csp_find_byte(raw, 44, pos, n)
        let end = if comma >= 0 { comma } else { n }
        let mut a = pos
        let mut b = end
        while a < b && cors_is_http_ws(raw.code_unit_at(a)) {
          a = a + 1
        }
        while b > a && cors_is_http_ws(raw.code_unit_at(b - 1)) {
          b = b - 1
        }
        if a < b {
          if b - a == 1 && raw.code_unit_at(a) == 42 {
            if !include_creds {
              wildcard_exposed = true
            }
          } else {
            exposed.push(csp_ascii_lower_slice(raw, a, b))
          }
        }
        if comma < 0 {
          break
        }
        pos = comma + 1
      }
    }
    Option::None => ()
  }

  CorsResponseDecision::{
    allowed: true,
    exposed_headers: exposed,
    wildcard_exposed: wildcard_exposed,
    reason: "",
  }
}

///| Fetch §4.9: Validate a CORS `OPTIONS` preflight response.
///| Enforces origin/credentials, `Access-Control-Allow-Methods`, `Access-Control-Allow-Headers`
///| (where `*` NEVER covers `Authorization`), and `Access-Control-Max-Age` (capped at 86400 s).
pub fn check_cors_preflight(
  request_origin : String,
  credentials_mode : CredentialsMode,
  request_method : String,
  request_headers : Array[String],
  allow_origin : Option[String],
  allow_credentials : Option[String],
  allow_methods : Option[String],
  allow_headers : Option[String],
  max_age : Option[String],
) -> CorsPreflightDecision {
  let err_reason = cors_validate_origin_and_creds_reason(
    request_origin,
    credentials_mode,
    allow_origin,
    allow_credentials,
  )
  if err_reason.length() > 0 {
    return CorsPreflightDecision::{
      allowed: false,
      max_age: 0,
      reason: err_reason,
    }
  }

  let include_creds = cors_is_include(credentials_mode)

  // 1. Validate Access-Control-Allow-Methods (zero-allocation CSV scan)
  let mut method_ok = is_cors_safelisted_method(request_method)
  if !method_ok {
    match allow_methods {
      Option::Some(raw) => {
        let n = raw.length()
        let mlen = request_method.length()
        let mut pos = 0
        while pos <= n {
          let comma = csp_find_byte(raw, 44, pos, n)
          let end = if comma >= 0 { comma } else { n }
          let mut a = pos
          let mut b = end
          while a < b && cors_is_http_ws(raw.code_unit_at(a)) {
            a = a + 1
          }
          while b > a && cors_is_http_ws(raw.code_unit_at(b - 1)) {
            b = b - 1
          }
          if a < b {
            if csp_slice_eq(raw, a, b, request_method, 0, mlen) ||
            (!include_creds && b - a == 1 && raw.code_unit_at(a) == 42) {
              method_ok = true
              break
            }
          }
          if comma < 0 {
            break
          }
          pos = comma + 1
        }
      }
      Option::None => ()
    }
  }
  if !method_ok {
    return CorsPreflightDecision::{
      allowed: false,
      max_age: 0,
      reason: "preflight method not allowed: " + request_method,
    }
  }

  // 2. Validate Access-Control-Allow-Headers (zero-allocation CSV scan)
  let rhn = request_headers.length()
  if rhn > 0 {
    let raw_ah = match allow_headers {
      Option::Some(raw) => raw
      Option::None => ""
    }
    let ah_len = raw_ah.length()
    let mut has_wildcard = false
    if !include_creds && ah_len > 0 {
      let mut pos = 0
      while pos <= ah_len {
        let comma = csp_find_byte(raw_ah, 44, pos, ah_len)
        let end = if comma >= 0 { comma } else { ah_len }
        let mut a = pos
        let mut b = end
        while a < b && cors_is_http_ws(raw_ah.code_unit_at(a)) {
          a = a + 1
        }
        while b > a && cors_is_http_ws(raw_ah.code_unit_at(b - 1)) {
          b = b - 1
        }
        if b - a == 1 && raw_ah.code_unit_at(a) == 42 {
          has_wildcard = true
          break
        }
        if comma < 0 {
          break
        }
        pos = comma + 1
      }
    }
    let mut ri = 0
    while ri < rhn {
      let rh_raw = request_headers[ri]
      let mut ra = 0
      let mut rb = rh_raw.length()
      while ra < rb && cors_is_http_ws(rh_raw.code_unit_at(ra)) {
        ra = ra + 1
      }
      while rb > ra && cors_is_http_ws(rh_raw.code_unit_at(rb - 1)) {
        rb = rb - 1
      }
      if ra < rb {
        // Fetch §4.9: '*' covers non-Authorization headers when credentials != include.
        let mut ok = has_wildcard && !csp_eq_ascii_ci(rh_raw, ra, rb, "authorization")
        if !ok && ah_len > 0 {
          let mut pos = 0
          while pos <= ah_len {
            let comma = csp_find_byte(raw_ah, 44, pos, ah_len)
            let end = if comma >= 0 { comma } else { ah_len }
            let mut a = pos
            let mut b = end
            while a < b && cors_is_http_ws(raw_ah.code_unit_at(a)) {
              a = a + 1
            }
            while b > a && cors_is_http_ws(raw_ah.code_unit_at(b - 1)) {
              b = b - 1
            }
            if a < b && cors_slice_eq_ascii_ci(raw_ah, a, b, rh_raw, ra, rb) {
              ok = true
              break
            }
            if comma < 0 {
              break
            }
            pos = comma + 1
          }
        }
        if !ok {
          return CorsPreflightDecision::{
            allowed: false,
            max_age: 0,
            reason: "preflight header not allowed: " + csp_ascii_lower_slice(rh_raw, ra, rb),
          }
        }
      }
      ri = ri + 1
    }
  }

  // 3. Parse Access-Control-Max-Age (capped at 86400 s per browser engine cap; invalid/absent -> 0)
  let mut parsed_max_age = 0
  match max_age {
    Option::Some(raw) => {
      let mut a = 0
      let mut b = raw.length()
      while a < b && cors_is_http_ws(raw.code_unit_at(a)) {
        a = a + 1
      }
      while b > a && cors_is_http_ws(raw.code_unit_at(b - 1)) {
        b = b - 1
      }
      parsed_max_age = cors_clamp_max_age(cors_parse_nonneg_int_slice(raw, a, b))
    }
    Option::None => ()
  }

  CorsPreflightDecision::{
    allowed: true,
    max_age: parsed_max_age,
    reason: "",
  }
}
