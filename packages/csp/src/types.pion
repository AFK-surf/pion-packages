///| Core W3C Content Security Policy Level 3 (CSP3) and WHATWG Fetch CORS types,
///| defensive parse limits, and error definitions.
///| Zero external dependencies; 100% pure Pion; no `World` dependency.

///| Defensive resource limits enforced during CSP header parsing to prevent DoS
///| (oversized headers, directive floods, and source-list allocation bombs).
///|
///| Semantics:
///| - Any negative field is immediately rejected with `CspError::InvalidLimits`.
///| - A value of `0` strictly means 0 items/bytes are allowed (never unlimited).
pub val struct ParseLimits {
  pub max_header_bytes : Int
  pub max_policies : Int
  pub max_directives_per_policy : Int
  pub max_sources_per_directive : Int
}

///| Default parse limits suitable for large real-world web applications
///| (Twitter/X, YouTube, GitHub, Google Meet, Figma, and large ad-tech allowlists).
pub fn ParseLimits::default() -> ParseLimits {
  ParseLimits::{
    max_header_bytes: 65536,
    max_policies: 32,
    max_directives_per_policy: 64,
    max_sources_per_directive: 1024,
  }
}

///| Construct custom parse limits.
pub fn ParseLimits::new(
  max_header_bytes : Int,
  max_policies : Int,
  max_directives_per_policy : Int,
  max_sources_per_directive : Int,
) -> ParseLimits {
  ParseLimits::{
    max_header_bytes: max_header_bytes,
    max_policies: max_policies,
    max_directives_per_policy: max_directives_per_policy,
    max_sources_per_directive: max_sources_per_directive,
  }
}

///| Explicit CSP parsing errors.
pub enum CspError {
  InvalidLimits(String)
  LimitExceeded(String)
  InvalidHeader(String)
}

///| Human-readable message for a `CspError`.
pub fn csp_error_message(err : CspError) -> String {
  match err {
    CspError::InvalidLimits(msg) => "invalid limits: " + msg
    CspError::LimitExceeded(msg) => "limit exceeded: " + msg
    CspError::InvalidHeader(msg) => "invalid header: " + msg
  }
}

///| Strongly-typed W3C CSP Level 3 source expression.
///|
///| `Host(scheme, host, port, port_wildcard, path)`:
///| - `scheme`: optional lowercased scheme without `://` (e.g. `Some("https")`).
///| - `host`: lowercased host pattern (`"*"`, `"*.example.com"`, `"example.com"`, `"[::1]"`).
///| - `port`: optional explicit numeric port (e.g. `Some(8443)`).
///| - `port_wildcard`: `true` when `:*` was specified.
///| - `path`: `""` when omitted; trailing `/` denotes prefix match, otherwise exact file match.
pub enum SourceExpression {
  NoneExpr
  SelfExpr
  UnsafeInline
  UnsafeEval
  StrictDynamic
  UnsafeHashes
  WasmUnsafeEval
  ReportSample
  Nonce(String)
  Hash(String, String)
  Scheme(String)
  Host(Option[String], String, Option[Int], Bool, String)
}

///| A single parsed CSP directive (name lowercased, preserving source order).
pub struct CspDirective {
  pub name : String
  pub sources : Array[SourceExpression]
  pub raw_values : Array[String]
}

///| A single parsed Content-Security-Policy header.
pub struct CspPolicy {
  pub directives : Array[CspDirective]
  pub upgrade_insecure_requests : Bool
  pub block_all_mixed_content : Bool
  pub sandbox_tokens : Option[Array[String]]
  pub report_uri : Array[String]
  pub report_to : Option[String]
}

///| Structured result of evaluating a CSP directive.
pub val struct CspDecision {
  pub allowed : Bool
  pub violated_directive : String
  pub effective_directive : String
  pub matched_source : Option[String]
}

///| WHATWG Fetch credentials mode.
pub enum CredentialsMode {
  Omit
  SameOrigin
  Include
}

///| WHATWG URL / HTML Origin.
///| Per spec, `Opaque` (`null`) NEVER equals any origin, including itself.
pub enum Origin {
  Opaque
  Tuple(String, String, Int)
}

///| Result of validating a CORS response (Fetch §4.9).
pub struct CorsResponseDecision {
  pub allowed : Bool
  pub exposed_headers : Array[String]
  pub wildcard_exposed : Bool
  pub reason : String
}

///| Result of validating a CORS preflight response (Fetch §4.9).
pub val struct CorsPreflightDecision {
  pub allowed : Bool
  pub max_age : Int
  pub reason : String
}
